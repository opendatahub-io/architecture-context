{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jctanner/odh.architecture-context/benchmark/consumer-v1/calibration_schema.json",
  "title": "Semantic-Judge Calibration Set Template",
  "description": "Schema for the stratified calibration question template used to validate LLM-as-judge semantic equivalence scoring. Version 0.1.0 — template only; human labels are null until a reviewer fills them.",
  "type": "object",
  "required": [
    "template_version",
    "corpus_version",
    "judge_schema_version",
    "generated",
    "selection",
    "human_review_instructions",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "template_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Calibration template schema version."
    },
    "corpus_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the benchmark corpus the questions are drawn from."
    },
    "judge_schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the judge result schema this template targets."
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the template was generated."
    },
    "selection": {
      "type": "object",
      "required": ["algorithm", "description", "total", "by_tier", "by_answerability", "deterministic", "rationale"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the selection algorithm."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of the selection strategy."
        },
        "total": {
          "type": "integer",
          "minimum": 20,
          "maximum": 30,
          "description": "Total questions selected (must be 20-30)."
        },
        "by_tier": {
          "type": "object",
          "required": ["1", "2", "3", "4"],
          "additionalProperties": false,
          "properties": {
            "1": { "type": "integer", "minimum": 1 },
            "2": { "type": "integer", "minimum": 1 },
            "3": { "type": "integer", "minimum": 1 },
            "4": { "type": "integer", "minimum": 1 }
          },
          "description": "Questions selected per tier. All tiers must have at least 1."
        },
        "by_answerability": {
          "type": "object",
          "required": ["answerable", "answerable-as-gap"],
          "additionalProperties": false,
          "properties": {
            "answerable": { "type": "integer", "minimum": 0 },
            "answerable-as-gap": { "type": "integer", "minimum": 1 }
          },
          "description": "Questions by answerability status. Must include at least 1 gap question."
        },
        "deterministic": {
          "type": "boolean",
          "const": true,
          "description": "Selection must be deterministic and reproducible."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Justification for the selection strategy."
        }
      }
    },
    "human_review_instructions": {
      "type": "object",
      "required": ["task", "label_values", "gap_handling", "notes"],
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "label_values": {
          "type": "object",
          "required": ["true", "false", "null"],
          "additionalProperties": false,
          "properties": {
            "true": { "type": "string", "minLength": 1 },
            "false": { "type": "string", "minLength": 1 },
            "null": { "type": "string", "minLength": 1 }
          }
        },
        "gap_handling": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/calibration_question" }
    }
  },
  "$defs": {
    "calibration_question": {
      "type": "object",
      "required": [
        "question_id",
        "tier",
        "consumer",
        "question",
        "expected_answer",
        "source_file",
        "source_line",
        "answerability",
        "not_documented_expected",
        "human_label",
        "selection_rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Z]+-\\d{3}$",
          "description": "Question identifier from the corpus."
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "expected_answer": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "source_line": {
          "type": ["integer", "string"],
          "description": "Line number or range in the source file."
        },
        "answerability": {
          "type": "string",
          "enum": ["answerable", "answerable-as-gap"]
        },
        "not_documented_expected": {
          "type": "boolean"
        },
        "human_label": {
          "type": "null",
          "description": "Must be null in the template. Set to true/false by a human reviewer."
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this question was selected for the calibration set."
        }
      }
    }
  }
}
