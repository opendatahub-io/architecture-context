{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjudication_schema.json",
  "title": "Failure Adjudication Template",
  "description": "Schema for a human-review template of failure-classification proposals. All human_category values must be null in the template; non-null values are set only after human review.",
  "type": "object",
  "required": [
    "schema_version",
    "template_version",
    "source_experiment",
    "source_artifact",
    "generated_at",
    "total_corpus_questions",
    "instructions",
    "valid_human_categories",
    "proposals",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "template_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_experiment": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "total_corpus_questions": {
      "type": "integer",
      "minimum": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "valid_human_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adjudication_entry"
      },
      "minItems": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "adjudication_entry": {
      "type": "object",
      "required": [
        "question_id",
        "result_id",
        "tier",
        "category",
        "question",
        "expected_answer",
        "not_documented_expected",
        "proposed_category",
        "reasoning",
        "suggested_action",
        "evidence",
        "human_category"
      ],
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Z]+-\\d{3}$"
        },
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "expected_answer": {
          "type": "string",
          "minLength": 1
        },
        "not_documented_expected": {
          "type": "boolean"
        },
        "proposed_category": {
          "type": "string",
          "enum": [
            "infrastructure-failure",
            "stale-context",
            "missing-context",
            "unsupported-inference",
            "unresolved"
          ]
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "suggested_action": {
          "type": "string",
          "enum": ["accept", "investigate", "manual-classify", "no-action"]
        },
        "evidence": {
          "type": "object",
          "required": ["signals", "recorded_classifications", "score_context"],
          "additionalProperties": false,
          "properties": {
            "signals": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "recorded_classifications": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "score_context": {
              "type": "object",
              "required": ["tree_a", "tree_b"],
              "additionalProperties": false,
              "properties": {
                "tree_a": { "$ref": "#/$defs/tree_score" },
                "tree_b": { "$ref": "#/$defs/tree_score" }
              }
            }
          }
        },
        "human_category": {
          "type": "null",
          "description": "Must be null in the template. Set by a human reviewer during adjudication."
        }
      }
    },
    "tree_score": {
      "type": "object",
      "required": ["score", "exact_match", "source_citation", "gap_acknowledgment", "checks_passed", "checks_total"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": ["number", "null"] },
        "exact_match": { "type": ["boolean", "null"] },
        "source_citation": { "type": ["boolean", "null"] },
        "gap_acknowledgment": { "type": ["boolean", "null"] },
        "checks_passed": { "type": ["integer", "null"] },
        "checks_total": { "type": ["integer", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_proposals",
        "questions_with_perfect_score",
        "by_proposed_category",
        "by_tier",
        "unresolved_count"
      ],
      "additionalProperties": false,
      "properties": {
        "total_proposals": {
          "type": "integer",
          "minimum": 0
        },
        "questions_with_perfect_score": {
          "type": "integer",
          "minimum": 0
        },
        "by_proposed_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_tier": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
