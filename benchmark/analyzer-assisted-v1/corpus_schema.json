{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jctanner/odh.architecture-context/benchmark/analyzer-assisted-v1/corpus_schema.json",
  "title": "Analyzer-Assisted Corpus Manifest",
  "description": "Schema for the canonical corpus manifest that reconciles active, retired, missing, and unverified question entries across evaluation artifacts.",
  "type": "object",
  "required": ["manifest_version", "corpus_id", "created", "description", "source_artifacts", "questions", "gaps", "aggregates"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["verification_status", "description"],
        "properties": {
          "path": { "type": "string" },
          "corpus_version": { "type": "string" },
          "architecture_context_version": { "type": "string" },
          "total_questions_evaluated": { "type": "integer", "minimum": 0 },
          "source_line": { "type": "integer", "minimum": 1 },
          "claim": { "type": "string" },
          "verification_status": {
            "type": "string",
            "enum": ["audited", "evaluated-then-audited", "unverified", "design-only"]
          },
          "description": { "type": "string" }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "tier", "category", "difficulty", "scope", "source_corpus", "answerability_status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-\\d{3}$"
          },
          "status": {
            "type": "string",
            "enum": ["active", "retired", "missing", "unverified"]
          },
          "tier": {
            "type": "integer",
            "enum": [1, 2, 3, 4]
          },
          "category": {
            "type": "string",
            "enum": [
              "inventory", "routing", "deployment", "crd-api-surface",
              "component-facts", "authentication", "integration", "navigation",
              "team-ownership", "unknown"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": ["basic", "intermediate", "advanced", "unknown"]
          },
          "scope": {
            "type": "string",
            "enum": ["rhoai", "rhoai.next", "cross-product", "platform-meta", "unknown"]
          },
          "source_corpus": {
            "type": "string",
            "minLength": 1
          },
          "retirement_reason": {
            "type": "string"
          },
          "answerability_status": {
            "type": "string",
            "enum": ["answerable", "answerable-as-gap", "undetermined"]
          },
          "source_evidence": {
            "type": "object",
            "required": ["source_file", "source_line", "not_documented_expected"],
            "additionalProperties": false,
            "properties": {
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "source_line": {
                "oneOf": [
                  { "type": "integer", "minimum": 1 },
                  { "type": "string", "pattern": "^\\d+(-\\d+)?$" }
                ]
              },
              "not_documented_expected": {
                "type": "boolean"
              }
            }
          }
        },
        "if": {
          "properties": { "status": { "const": "active" } }
        },
        "then": {
          "required": ["answerability_status", "source_evidence"]
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "description"],
        "additionalProperties": true,
        "properties": {
          "gap_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "claimed_total": { "type": "integer", "minimum": 0 },
          "claimed_correct": { "type": "integer", "minimum": 0 },
          "claimed_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "verification_status": { "type": "string" },
          "evidence_searched": { "type": "array", "items": { "type": "string" } },
          "recovery_path": { "type": "string" },
          "bug_ref": { "type": "string" },
          "missing_ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" },
          "design_ref": { "type": "string" },
          "estimated_total": { "type": "string" },
          "authored_total": { "type": "integer", "minimum": 0 },
          "surviving_total": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "aggregates": {
      "type": "object",
      "required": ["by_status", "by_tier", "by_category", "by_difficulty", "by_scope", "by_answerability_status", "total_entries", "total_active", "total_retired"],
      "additionalProperties": false,
      "properties": {
        "by_status": {
          "type": "object",
          "required": ["active", "retired"],
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "properties": {
            "active": { "type": "integer", "minimum": 0 },
            "retired": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "unverified": { "type": "integer", "minimum": 0 }
          }
        },
        "by_tier": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["active", "total"],
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "by_difficulty": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "by_scope": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "by_answerability_status": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "total_entries": { "type": "integer", "minimum": 0 },
        "total_active": { "type": "integer", "minimum": 0 },
        "total_retired": { "type": "integer", "minimum": 0 }
      }
    },
    "baseline_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["verification_status"],
        "additionalProperties": true,
        "properties": {
          "verification_status": {
            "type": "string",
            "enum": ["verified", "evaluated", "unverified"]
          }
        }
      }
    }
  }
}
