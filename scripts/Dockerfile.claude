FROM python:3.13-slim

ARG GO_VERSION=1.25.5

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xzf -

# The repository runner uses uv for its Python entry points. Install it in the
# system environment so the unprivileged task user can invoke `uv run`.
RUN pip install --no-cache-dir uv

RUN useradd -m -d /home/evaluator -s /bin/bash evaluator

ENV HOME=/home/evaluator
ENV PATH="/usr/local/go/bin:/home/evaluator/go/bin:/home/evaluator/.local/bin:/home/evaluator/.claude/local:${PATH}"
ENV GOTOOLCHAIN=local

USER evaluator
WORKDIR /home/evaluator

RUN curl -fsSL https://claude.ai/install.sh | bash

RUN pip install --no-cache-dir --user claude-agent-sdk jsonschema mlflow==2.22.0

COPY --chown=evaluator:evaluator lib/ /home/evaluator/app/lib/
COPY --chown=evaluator:evaluator benchmark/consumer-v1/*.py /home/evaluator/app/benchmark/consumer-v1/
COPY --chown=evaluator:evaluator benchmark/consumer-v1/*.json /home/evaluator/app/benchmark/consumer-v1/

RUN rm -rf /home/evaluator/.claude \
    && find /home/evaluator -name "CLAUDE.md" -delete 2>/dev/null; true

WORKDIR /home/evaluator/app

ENTRYPOINT ["python3", "benchmark/consumer-v1/run_evaluation.py"]
