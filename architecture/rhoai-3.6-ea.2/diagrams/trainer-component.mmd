graph TB
    subgraph TrainerOperator["Kubeflow Trainer Operator"]
        direction TB
        Controller["trainer-controller-manager<br/>Go controller-runtime<br/>Ports: 8081, 8443, 9443, 10443"]
        Webhook["Webhook Server<br/>9443/TCP HTTPS"]
        MetricsSrv["Metrics Server<br/>8443/TCP HTTPS"]
        StatusSrv["Status Server<br/>10443/TCP HTTPS<br/>(feature-gated, alpha)"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP"]

        subgraph Plugins["Runtime Plugin Framework"]
            direction LR
            PyTorch["PyTorch Plugin"]
            MPI["MPI Plugin"]
            DeepSpeed["DeepSpeed Plugin"]
            Flux["Flux Plugin"]
            JAX["JAX Plugin"]
            XGBoost["XGBoost Plugin"]
        end

        subgraph RHAIFeatures["RHOAI-Specific Features"]
            direction LR
            Progression["Progression Tracking<br/>polls pod metrics"]
            NetPolicy["NetworkPolicy Creator<br/>per-TrainJob isolation"]
            TLSProfile["TLS Profile Adherence<br/>watches APIServer"]
        end

        Controller --> Webhook
        Controller --> MetricsSrv
        Controller --> StatusSrv
        Controller --> HealthProbes
        Controller --> Plugins
        Controller --> RHAIFeatures
    end

    subgraph InitContainers["Init Containers"]
        DatasetInit["Dataset Initializer<br/>Python<br/>HuggingFace / OpenDAL"]
        ModelInit["Model Initializer<br/>Python<br/>HuggingFace Hub"]
    end

    subgraph DataCacheSvc["Data Cache"]
        DataCache["Data Cache<br/>Rust<br/>Distributed in-memory cache"]
    end

    User["Data Scientist / User"] -->|"kubectl create"| TrainJobCR["TrainJob CR"]
    TrainJobCR -->|"watched by"| Controller
    Controller -->|"references"| TrainingRuntimeCR["TrainingRuntime CR<br/>(namespace-scoped)"]
    Controller -->|"references"| ClusterRuntimeCR["ClusterTrainingRuntime CR<br/>(cluster-scoped)"]
    Controller -->|"creates"| JobSetCR["JobSet CR"]
    Controller -->|"creates"| PodGroupCR["PodGroup CR<br/>(gang scheduling)"]
    Controller -->|"creates"| NetworkPolicyCR["NetworkPolicy"]
    JobSetCR -->|"creates"| TrainingPods["Training Pods"]
    DatasetInit -.->|"init container in"| TrainingPods
    ModelInit -.->|"init container in"| TrainingPods
    DataCache -.->|"streams data to"| TrainingPods
    TrainingPods -->|"push status"| StatusSrv

    Prometheus["Prometheus<br/>prometheus-k8s SA"] -->|"scrapes"| MetricsSrv

    Controller -->|"CRD ops"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    Controller -->|"reads TLS profile"| APIServer["OpenShift APIServer<br/>config.openshift.io"]

    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px
    style Webhook fill:#4a90e2,stroke:#333
    style MetricsSrv fill:#4a90e2,stroke:#333
    style StatusSrv fill:#4a90e2,stroke:#333
    style HealthProbes fill:#4a90e2,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style TrainingRuntimeCR fill:#f5a623,stroke:#333
    style ClusterRuntimeCR fill:#f5a623,stroke:#333
    style JobSetCR fill:#f5a623,stroke:#333
    style PodGroupCR fill:#f5a623,stroke:#333
    style NetworkPolicyCR fill:#f5a623,stroke:#333
    style PyTorch fill:#7ed321,stroke:#333
    style MPI fill:#7ed321,stroke:#333
    style DeepSpeed fill:#7ed321,stroke:#333
    style Flux fill:#7ed321,stroke:#333
    style JAX fill:#7ed321,stroke:#333
    style XGBoost fill:#7ed321,stroke:#333
    style Progression fill:#d0021b,stroke:#333,color:#fff
    style NetPolicy fill:#d0021b,stroke:#333,color:#fff
    style TLSProfile fill:#d0021b,stroke:#333,color:#fff
    style DatasetInit fill:#9013fe,stroke:#333,color:#fff
    style ModelInit fill:#9013fe,stroke:#333,color:#fff
    style DataCache fill:#bd10e0,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
