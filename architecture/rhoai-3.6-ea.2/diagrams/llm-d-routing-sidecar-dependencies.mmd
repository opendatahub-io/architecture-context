graph LR
    Sidecar["llm-d-routing-sidecar<br/>Go HTTP Reverse Proxy"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>decode requests"| Decoder["vLLM Decoder<br/>(co-located, 8001/TCP)"]
    Sidecar -->|"reverse proxy<br/>prefill requests"| Prefiller["vLLM Prefiller<br/>(remote pods)"]
    Sidecar -->|"watch CRDs + pods"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% CRD Dependency
    Sidecar -.->|"watches"| InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]

    %% External ingress
    Router["OpenShift Router"] -->|"edge TLS<br/>443 → 8080"| Sidecar

    %% Go Module Dependencies
    Sidecar -->|"dynamic client<br/>informers"| ClientGo["k8s.io/client-go<br/>v0.31.3"]
    Sidecar -->|"API types"| APIMachinery["k8s.io/apimachinery<br/>v0.31.3"]
    Sidecar -->|"proxy handler cache"| LRU["golang-lru/v2<br/>v2.0.7"]
    Sidecar -->|"request correlation"| UUID["google/uuid<br/>v1.6.0"]
    Sidecar -->|"structured logging"| Logr["go-logr/logr<br/>v1.4.2"]

    %% Successor
    Successor["llm-d-inference-scheduler<br/>(successor repo)"] -.->|"code migrated to<br/>cmd/pd_sidecar"| Sidecar

    style Sidecar fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Decoder fill:#7ed321,stroke:#333
    style Prefiller fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style InferencePool fill:#f5a623,stroke:#333
    style Router fill:#ffe6cc,stroke:#d79b00
    style ClientGo fill:#999,stroke:#333,color:#fff
    style APIMachinery fill:#999,stroke:#333,color:#fff
    style LRU fill:#999,stroke:#333,color:#fff
    style UUID fill:#999,stroke:#333,color:#fff
    style Logr fill:#999,stroke:#333,color:#fff
    style Successor fill:#ddd,stroke:#999,stroke-dasharray: 5 5
