    style CR_Tempo fill:#f5a623,color:#fff
    style CR_MetricsView fill:#f5a623,color:#fff
    style CR_Korrel8r fill:#f5a623,color:#fff
    style Monitoring fill:#7ed321,color:#fff
    style MonStack fill:#7ed321,color:#fff
    style TempoRes fill:#7ed321,color:#fff
    style OTelRes fill:#7ed321,color:#fff
    style PersesRes fill:#7ed321,color:#fff
    style LokiRes fill:#7ed321,color:#fff
    style CoreRes fill:#7ed321,color:#fff
