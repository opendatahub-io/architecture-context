graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["odh-observability<br/>-controller-manager"]
        SA_ClusterProxy["data-science-prometheus<br/>-cluster-proxy"]
        SA_NSProxy["data-science-prometheus<br/>-namespace-proxy"]
        SA_Korrel8r["korrel8r"]
        SA_Collector["data-science-collector<br/>-collector"]
        SA_AlertMgr["data-science-monitoringstack<br/>-alertmanager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_ClusterProxy["cluster-proxy-rolebinding"]
        CRB_ClusterProxyAuth["cluster-proxy<br/>-auth-delegator"]
        CRB_NSProxy["namespace-proxy-rolebinding"]
        CRB_NSProxyAuth["namespace-proxy<br/>-auth-delegator"]
        CRB_Korrel8r["korrel8r-query-binding"]
        CRB_Korrel8rAuth["korrel8r<br/>-auth-delegator"]
        CRB_GenProc["generate-processors<br/>-rolebinding"]
        CRB_MLflow["mlflow-trace-export<br/>-binding"]
        CRB_Tempo["tempo-trace-export<br/>-binding"]
        CRB_AlertMgr["alertmanager<br/>-metrics-reader"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["{operator}-manager<br/>(full CRUD on all<br/>observability CRDs)"]
        CR_MonView["cluster-monitoring-view<br/>(read cluster metrics)"]
        CR_AuthDeleg["system:auth-delegator<br/>(SAR delegation)"]
        CR_GenProc["generate-processors-role<br/>(read pods, services,<br/>monitors, probes)"]
        CR_MLflow["mlflow-trace-export<br/>(update experiments)"]
        CR_Tempo["tempo-trace-export<br/>(create tempo traces)"]
        CR_MetricsView["data-science-metrics-view<br/>(create pod metrics)"]
        CR_Korrel8r["korrel8r-query<br/>(read pods, logs, services,<br/>events, workloads)"]
    end

    subgraph APIResources["API Resources Managed"]
        Monitoring["services.platform.opendatahub.io<br/>Monitoring"]
        MonStack["monitoring.rhobs<br/>MonitoringStack, ThanosQuerier,<br/>ServiceMonitor, PrometheusRule"]
        TempoRes["tempo.grafana.com<br/>TempoMonolithic, TempoStack"]
        OTelRes["opentelemetry.io<br/>OpenTelemetryCollector,<br/>Instrumentation"]
        PersesRes["perses.dev<br/>Perses, PersesDatasource,<br/>PersesDashboard"]
        LokiRes["loki.grafana.com<br/>LokiStack"]
        CoreRes["core<br/>ConfigMaps, Secrets,<br/>Services, ServiceAccounts"]
        AppsRes["apps<br/>Deployments"]
        RBACRes["rbac.authorization.k8s.io<br/>Roles, RoleBindings,<br/>ClusterRoles, ClusterRoleBindings"]
        AdmissionRes["admissionregistration.k8s.io<br/>ValidatingAdmissionPolicies,<br/>MutatingWebhookConfigurations"]
        CertRes["cert-manager.io<br/>Issuers, Certificates"]
    end

    %% Controller SA bindings
    SA_Controller -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager
    CR_Manager -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| Monitoring
    CR_Manager -->|"full CRUD"| MonStack
    CR_Manager -->|"full CRUD"| TempoRes
    CR_Manager -->|"full CRUD"| OTelRes
    CR_Manager -->|"full CRUD"| PersesRes
    CR_Manager -->|"full CRUD"| LokiRes
    CR_Manager -->|"full CRUD"| CoreRes
    CR_Manager -->|"full CRUD"| AppsRes
    CR_Manager -->|"full CRUD"| RBACRes
    CR_Manager -->|"full CRUD"| AdmissionRes
    CR_Manager -->|"full CRUD"| CertRes

    %% Cluster proxy bindings
    SA_ClusterProxy -->|bound via| CRB_ClusterProxy
    SA_ClusterProxy -->|bound via| CRB_ClusterProxyAuth
    CRB_ClusterProxy -->|grants| CR_MonView
    CRB_ClusterProxyAuth -->|grants| CR_AuthDeleg

    %% Namespace proxy bindings
    SA_NSProxy -->|bound via| CRB_NSProxy
    SA_NSProxy -->|bound via| CRB_NSProxyAuth
    CRB_NSProxy -->|grants| CR_MonView
    CRB_NSProxyAuth -->|grants| CR_AuthDeleg

    %% Korrel8r bindings
    SA_Korrel8r -->|bound via| CRB_Korrel8r
    SA_Korrel8r -->|bound via| CRB_Korrel8rAuth
    CRB_Korrel8r -->|grants| CR_Korrel8r
    CRB_Korrel8rAuth -->|grants| CR_AuthDeleg

    %% Collector bindings
    SA_Collector -->|bound via| CRB_GenProc
    SA_Collector -->|bound via| CRB_MLflow
    SA_Collector -->|bound via| CRB_Tempo
    CRB_GenProc -->|grants| CR_GenProc
    CRB_MLflow -->|grants| CR_MLflow
    CRB_Tempo -->|grants| CR_Tempo

    %% Alertmanager binding
    SA_AlertMgr -->|bound via| CRB_AlertMgr
    CRB_AlertMgr -->|grants| CR_MonView

    style SA_Controller fill:#4a90e2,color:#fff
    style SA_ClusterProxy fill:#4a90e2,color:#fff
    style SA_NSProxy fill:#4a90e2,color:#fff
    style SA_Korrel8r fill:#4a90e2,color:#fff
    style SA_Collector fill:#4a90e2,color:#fff
    style SA_AlertMgr fill:#4a90e2,color:#fff
