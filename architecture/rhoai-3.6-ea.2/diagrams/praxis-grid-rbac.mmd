graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["grid-operator<br/>Namespace: grid-system"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_CRD["grid-operator-crd<br/>(ClusterRoleBinding)"]
        CRB_RES["grid-operator-resources<br/>(RoleBinding, grid-system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_CRD["grid-operator-crd<br/>(ClusterRole)"]
        CR_RES["grid-operator-resources<br/>(ClusterRole)"]
    end

    subgraph CRDResources["CRD API Resources (grid.praxis.fast)"]
        AGN_ATP["AgentToolProviders<br/>get, list, watch, patch"]
        AGN_GN["GridNetworks<br/>get, list, watch, patch"]
        AGN_IP["InferenceProviders<br/>get, list, watch, patch"]
        AGN_GS["GridSites<br/>get, list, watch, patch,<br/>create, update, delete"]
        AGN_Status["*/status<br/>get, patch"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["Secrets<br/>get, create, patch"]
        Services["Services<br/>get<br/>(provider-gateway,<br/>grid-operator-swim,<br/>grid-operator-signals)"]
        ConfigMaps["ConfigMaps<br/>get, create, patch, update"]
        Events["Events (events.k8s.io)<br/>create, patch"]
    end

    %% Bindings
    SA -->|"bound via"| CRB_CRD
    SA -->|"bound via"| CRB_RES
    CRB_CRD -->|"grants"| CR_CRD
    CRB_RES -->|"grants"| CR_RES

    %% CRD Role permissions
    CR_CRD -->|"read + patch"| AGN_ATP
    CR_CRD -->|"read + patch"| AGN_GN
    CR_CRD -->|"read + patch"| AGN_IP
    CR_CRD -->|"full CRUD"| AGN_GS
    CR_CRD -->|"status update"| AGN_Status

    %% Resources Role permissions
    CR_RES -->|"read + create + patch"| Secrets
    CR_RES -->|"read only"| Services
    CR_RES -->|"read + create + patch + update"| ConfigMaps
    CR_RES -->|"create + patch"| Events

    %% Styles
    style SA fill:#4a90e2,color:#fff
    style CRB_CRD fill:#6c8ebf,color:#fff
    style CRB_RES fill:#6c8ebf,color:#fff
    style CR_CRD fill:#f5a623,color:#fff
    style CR_RES fill:#f5a623,color:#fff
    style AGN_ATP fill:#7ed321,color:#fff
    style AGN_GN fill:#7ed321,color:#fff
    style AGN_IP fill:#7ed321,color:#fff
    style AGN_GS fill:#7ed321,color:#fff
    style AGN_Status fill:#7ed321,color:#fff
    style Secrets fill:#e8e8e8,stroke:#333
    style Services fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Events fill:#e8e8e8,stroke:#333
