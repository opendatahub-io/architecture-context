    OpenShell -.->|"optional ingress"| GatewayAPI["Kubernetes<br/>Gateway API"]
    OpenShell -.->|"optional ingress"| OCPRoutes["OpenShift Routes"]

    %% External Services
    OpenShell -->|"model inference"| ModelAPIs["Model Provider APIs<br/>(Anthropic, GCP, NVIDIA)<br/>443/TCP HTTPS"]
    OpenShell -.->|"multi-replica DB"| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    OpenShell -.->|"trace export"| OTLP["OTLP Collector<br/>4317/TCP gRPC"]

    %% Compute Backends
    OpenShell -->|"container driver"| Docker["Docker"]
    OpenShell -->|"container driver"| Podman["Podman"]
    OpenShell -->|"MicroVM driver"| Libkrun["libkrun"]
    OpenShell -->|"Windows driver"| MXC["Windows MXC<br/>AppContainer"]

