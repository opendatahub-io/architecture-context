    OpenShell -->|"primary runtime"| Rust["Rust 1.94+"]
    OpenShell -->|"async runtime"| Tokio["tokio 1.43"]
    OpenShell -->|"HTTP server"| Axum["axum 0.8"]
    OpenShell -->|"gRPC framework"| Tonic["tonic 0.14"]
    OpenShell -->|"TLS"| Rustls["rustls 0.23<br/>(aws-lc-rs)"]
    OpenShell -->|"K8s client"| Kube["kube 0.99"]
    OpenShell -->|"policy engine"| Regorus["regorus 0.9<br/>(OPA)"]
    OpenShell -->|"formal verify"| Z3["z3 0.20<br/>(SMT Solver)"]
    OpenShell -->|"database"| SQLx["sqlx 0.9<br/>(SQLite + PG)"]
    OpenShell -->|"SSH protocol"| Russh["russh 0.62"]

    %% SDK runtimes
    OpenShell -.->|"Go SDK"| Go["Go 1.25"]
    OpenShell -.->|"Python SDK"| Python["Python 3.11+"]

