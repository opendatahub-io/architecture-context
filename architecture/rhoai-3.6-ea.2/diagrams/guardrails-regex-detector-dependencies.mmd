graph LR
    RegexDetector["guardrails-regex-detector<br/>(Rust Service)"]

    %% Internal Platform Dependencies (upstream caller)
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"REST inbound<br/>HTTP 8080/TCP"| RegexDetector

    %% Rust Crate Dependencies
    RegexDetector -->|"HTTP framework"| Axum["axum 0.7.9"]
    RegexDetector -->|"pattern matching"| Regex["regex 1.11.1"]
    RegexDetector -->|"JSON serde"| Serde["serde 1.0.215"]
    RegexDetector -->|"JSON support"| SerdeJSON["serde_json 1.0.133"]
    RegexDetector -->|"async runtime"| Tokio["tokio 1.41.1"]
    RegexDetector -->|"HTTP tracing"| TowerHTTP["tower-http 0.6.2"]
    RegexDetector -->|"logging"| Tracing["tracing 0.1.41"]
    RegexDetector -->|"log subscriber"| TracingSub["tracing-subscriber 0.3.19"]

    %% Platform Dependencies (expected, not in source)
    RegexDetector -.->|"expected: mTLS"| ServiceMesh["Service Mesh"]
    RegexDetector -.->|"expected: isolation"| NetworkPolicy["NetworkPolicy"]

