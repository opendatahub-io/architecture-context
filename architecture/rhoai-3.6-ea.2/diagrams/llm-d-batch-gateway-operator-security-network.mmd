graph TB
    subgraph OperatorPod["OPERATOR POD<br/>(redhat-ods-applications)"]
        direction TB

        subgraph HealthProbes["Health Probes (8081/TCP, HTTP, No Auth)"]
            Healthz["/healthz - Liveness"]
            Readyz["/readyz - Readiness"]
        end

        subgraph MetricsServer["Metrics Server (8443/TCP, HTTPS)"]
            Metrics["/metrics<br/>TLS: service-ca cert<br/>Auth: TokenReview + SAR"]
        end

        Operator["llm-d-batch-gateway-operator<br/>SA: llm-d-batch-gateway-operator<br/>FIPS: strictfipsruntime + UBI9-pqc"]
    end

    subgraph K8sAPIServer["KUBERNETES API (6443/TCP, HTTPS, TLS 1.2+)"]
        direction TB
        CRDWatch["LLMBatchGateway CR<br/>Watch/Update/Patch"]
        ResourceCRUD["Deployments, StatefulSets,<br/>Services, ConfigMaps,<br/>ServiceAccounts, RBAC"]
        SecretOps["Secrets<br/>get, list, watch, create, patch"]
        MonitoringCRDs["ServiceMonitor, PodMonitor,<br/>PrometheusRule"]
        GatewayAPICRDs["HTTPRoute, ReferenceGrant,<br/>Certificate"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus"]
    end

    subgraph PlatformServices["OPENSHIFT PLATFORM SERVICES"]
        OSAPIServer["OpenShift APIServer Config<br/>TLS Profile (read-only watch)"]
        ServiceCA["service-ca Operator<br/>Provisions metrics TLS cert"]
        ParentOp["opendatahub-operator /<br/>ai-gateway-operator<br/>Injects images via env vars"]
    end

    subgraph RenderedWorkloads["RENDERED WORKLOADS (CR Namespace)"]
        APIServer["Batch Gateway API Server"]
        Processor["Batch Gateway Processor"]
        GC["Garbage Collector"]
        AsyncProc["Async Processor (optional)"]
    end

    %% Flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPIServer
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer + SAR"| Metrics
    ServiceCA -->|"provisions cert"| MetricsServer
    OSAPIServer -->|"TLS profile<br/>triggers restart"| Operator
    ParentOp -->|"env vars<br/>(params.env)"| OperatorPod
    Operator -->|"SSA apply<br/>rendered resources"| RenderedWorkloads

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef k8sapi fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef workload fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef health fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Operator operator
    class CRDWatch,ResourceCRUD,SecretOps,MonitoringCRDs,GatewayAPICRDs k8sapi
    class Prometheus monitoring
    class OSAPIServer,ServiceCA,ParentOp platform
    class APIServer,Processor,GC,AsyncProc workload
    class Healthz,Readyz health
