graph TD
    subgraph JobExecution["lmes-job Execution Context"]
        Pod["lmes-job Pod<br/>UID: 65532 (non-root)<br/>Image: odh-ta-lmes-job-rhel9"]
    end

    subgraph OperatorManaged["Managed by TrustyAI LMES Operator"]
        OperatorRBAC["Operator RBAC<br/>(not defined in this component)"]
        LMEvalJobCRD["LMEvalJob CRD<br/>(defined by operator)"]
    end

    subgraph Secrets["Environment Variable Secrets"]
        direction TB
        OPENAI["OPENAI_API_KEY<br/>Model endpoint auth"]
        HF["HF_TOKEN<br/>HuggingFace access (optional)"]
        AWS["AWS_SECRET_ACCESS_KEY<br/>S3 storage auth"]
        REG["REGISTRY_PASSWORD<br/>OCI registry auth"]
        ANTHROPIC["ANTHROPIC_API_KEY<br/>Anthropic API (optional)"]
        WATSONX["WATSONX_API_KEY<br/>WatsonX AI (optional)"]
    end

    subgraph SecurityControls["Application-Level Security Controls"]
        direction TB
        CredRedact["Credential Redaction<br/>_sanitize_error_message"]
        PathValidation["Path Traversal Protection<br/>Resolved path constrained to /meta<br/>(CWE-22 mitigation)"]
        SymlinkCheck["Symlink Validation<br/>CA certificate path checks"]
    end

    OperatorRBAC -->|"creates"| Pod
    LMEvalJobCRD -->|"defines job spec"| Pod

    Pod -->|"reads"| OPENAI
    Pod -->|"reads"| HF
    Pod -->|"reads"| AWS
    Pod -->|"reads"| REG
    Pod -.->|"reads"| ANTHROPIC
    Pod -.->|"reads"| WATSONX

    Pod -->|"enforces"| CredRedact
    Pod -->|"enforces"| PathValidation
    Pod -->|"enforces"| SymlinkCheck

    Note["Note: This component defines no RBAC resources.<br/>All Kubernetes RBAC is managed by the<br/>TrustyAI LMES Operator."]

    style Pod fill:#4a90e2,color:#fff
    style OperatorRBAC fill:#f5a623,color:#fff
    style LMEvalJobCRD fill:#f5a623,color:#fff
    style OPENAI fill:#e74c3c,color:#fff
    style HF fill:#e74c3c,color:#fff
    style AWS fill:#e74c3c,color:#fff
    style REG fill:#e74c3c,color:#fff
    style ANTHROPIC fill:#e74c3c,color:#fff
    style WATSONX fill:#e74c3c,color:#fff
    style CredRedact fill:#7ed321,color:#fff
    style PathValidation fill:#7ed321,color:#fff
    style SymlinkCheck fill:#7ed321,color:#fff
    style Note fill:#fff,stroke:#999,stroke-dasharray: 5 5
