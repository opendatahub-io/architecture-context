graph TD
    subgraph "RBAC Configuration"
        direction TB
        Note["No RBAC manifests defined in repository"]
    end

    subgraph "Authentication Model"
        direction TB
        Client["Client"] -->|"Authorization header"| Gateway["vllm-orchestrator-gateway"]
        Gateway -->|"Forwarded Authorization<br/>+ x-forwarded-* headers"| Orchestrator["FMS Guardrails Orchestrator"]
    end

    subgraph "Secrets & Certificates"
        direction TB
        TlsCert["/etc/tls/private/tls.crt<br/>Type: TLS client cert<br/>Provisioned by: Service mesh / cert-manager"]
        TlsKey["/etc/tls/private/tls.key<br/>Type: TLS private key<br/>Provisioned by: Service mesh / cert-manager"]
        CaCert["/etc/tls/ca/service-ca.crt<br/>Type: CA certificate<br/>Provisioned by: OpenShift service CA"]
    end

    TlsCert -.->|"client identity"| Gateway
    TlsKey -.->|"client identity"| Gateway
    CaCert -.->|"CA trust"| Gateway

    subgraph "Auth Enforcement"
        direction TB
        NoLocal["No local auth enforcement"]
        PassThrough["Authorization header pass-through only"]
        Upstream["All auth delegated to upstream orchestrator"]
        NoLocal --- PassThrough
        PassThrough --- Upstream
    end

    style Note fill:#ffe6cc,stroke:#d79b00,color:#333
    style Client fill:#f9f9f9,stroke:#999
    style Gateway fill:#4a90e2,stroke:#333,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style TlsCert fill:#f5a623,stroke:#333,color:#fff
    style TlsKey fill:#f5a623,stroke:#333,color:#fff
    style CaCert fill:#f5a623,stroke:#333,color:#fff
    style NoLocal fill:#ff6b6b,stroke:#333,color:#fff
    style PassThrough fill:#ff6b6b,stroke:#333,color:#fff
    style Upstream fill:#ff6b6b,stroke:#333,color:#fff
