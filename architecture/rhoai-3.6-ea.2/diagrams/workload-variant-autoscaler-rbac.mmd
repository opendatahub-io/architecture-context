graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_Prom["kube-prometheus-stack-prometheus"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Auth["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph NamespacedBindings["Namespaced Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(namespace-scoped)"]
        RB_Metrics["metrics-reader-rolebinding<br/>(ns: wva-monitoring)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_Auth["metrics-auth-role"]
        CR_Metrics["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph NamespacedRoles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph ManagerResources["manager-role Resources"]
        Core_RO["core: configmaps, namespaces,<br/>nodes, pods, resourcequotas,<br/>services<br/>→ get, list, watch"]
        Core_Events["core: events<br/>→ create, patch"]
        Apps_Deploy["apps: deployments<br/>→ get, list, patch, update, watch"]
        Apps_Scale["apps: deployments/scale<br/>→ get, update"]
        Apps_RO["apps: replicasets, statefulsets<br/>→ get, list, watch"]
        Autoscaling["autoscaling: HPAs<br/>→ get, list, patch, update, watch"]
        InfPool["inference.networking.k8s.io:<br/>inferencepools<br/>→ get, list, watch"]
        KedaSO["keda.sh: scaledobjects<br/>→ get, list, patch, update, watch"]
        LWSRes["leaderworkerset.x-k8s.io:<br/>leaderworkersets + /scale<br/>→ get, list, patch, update, watch"]
        MonSM["monitoring.coreos.com:<br/>servicemonitors<br/>→ get, list, watch"]
    end

    subgraph AuthResources["metrics-auth-role Resources"]
        TokenReview["authentication.k8s.io:<br/>tokenreviews → create"]
        SAR["authorization.k8s.io:<br/>subjectaccessreviews → create"]
    end

    subgraph MetricsURLs["metrics-reader Non-Resource URLs"]
        MetricsURL["/metrics → get"]
    end

    subgraph LeaderResources["leader-election-role Resources"]
        Leases["coordination.k8s.io: leases<br/>→ CRUD + watch"]
        LeaderEvents["core: events<br/>→ create, patch"]
    end

