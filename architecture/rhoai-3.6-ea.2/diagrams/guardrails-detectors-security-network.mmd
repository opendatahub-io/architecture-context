graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Orc["FMS Guardrails Orchestrator<br/>(upstream consumer)"]
    end

    subgraph IstioMesh["ISTIO SERVICE MESH (mTLS STRICT)"]
        direction TB
        subgraph Sidecar["Istio Sidecar Proxy"]
            IstioProxy["Envoy Proxy<br/>TLS Termination<br/>Platform Auth Enforcement<br/>security.opendatahub.io/enable-auth"]
        end

        subgraph NS_Detectors["Namespace: (per-tenant)"]
            direction TB
            BuiltIn["built-in Detector Pod<br/>SA: default<br/>Image: odh-built-in-detector-rhel9<br/>Port: 8080/TCP<br/>Auth: None (app-level)"]
            HFDetector["huggingface Detector Pod<br/>SA: user-one<br/>Image: odh-guardrails-detector-huggingface-runtime-rhel9<br/>Port: 8000/TCP<br/>Auth: None (app-level)"]
            JudgeDetector["llm_judge Detector Pod<br/>SA: default<br/>Image: guardrails-detector-llm-judge<br/>Port: 8000/TCP<br/>Auth: None (app-level)"]
        end
    end

    subgraph InternalServices["INTERNAL SERVICES"]
        MinIO["MinIO<br/>minio-guardrails-guardian<br/>ClusterIP 9000/TCP<br/>No Encryption<br/>AWS S3 Credentials"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        VLLM["vLLM Inference Server<br/>Configurable URL<br/>HTTP<br/>No Auth"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        KServe["KServe Controller<br/>ServingRuntime / InferenceService"]
        Prometheus["Prometheus<br/>Metrics Scraper"]
    end

    %% Flows
    Orc -->|"HTTP 8080/8000<br/>TLS (Istio mesh)<br/>Platform Auth"| IstioProxy
    IstioProxy -->|"HTTP/8080<br/>mTLS<br/>Service Identity"| BuiltIn
    IstioProxy -->|"HTTP/8000<br/>mTLS<br/>Service Identity"| HFDetector
    IstioProxy -->|"HTTP/8000<br/>mTLS<br/>Service Identity"| JudgeDetector

    HFDetector -->|"HTTP/9000<br/>No Encryption<br/>AWS S3 Creds"| MinIO
    JudgeDetector -->|"HTTP/configurable<br/>Configurable encryption<br/>No Auth"| VLLM

    Prometheus -->|"HTTP/8080<br/>GET /metrics"| BuiltIn
    Prometheus -->|"HTTP/8000<br/>GET /metrics"| HFDetector
    KServe -.->|"manages lifecycle"| HFDetector
    KServe -.->|"manages lifecycle"| JudgeDetector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef mesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Orc external
    class IstioProxy,BuiltIn,HFDetector,JudgeDetector mesh
    class MinIO internal
    class VLLM extservice
    class KServe,Prometheus platform
