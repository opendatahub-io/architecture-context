graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["dc-controller-manager<br/>Namespace: dc-controller-system"]
        SA_Rest["rest-service-sa<br/>Namespace: {dch-namespace}"]
        SA_Flight["flight-service-sa<br/>Namespace: {dch-namespace}"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["dc-controller-manager-rolebinding"]
        CRB_MetricsAuth["dc-controller-metrics-auth-rolebinding"]
        CRB_KubeRBAC["kube-rbac-proxy-auth-review"]
        CRB_FlightAuth["flight-auth-delegator"]
        CRB_RestData["rest-service-data-access"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Leader["dc-controller-leader-election-rolebinding<br/>Namespace: dc-controller-system"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["dc-controller-manager-role"]
        CR_MetricsAuth["dc-controller-metrics-auth-role"]
        CR_MetricsReader["dc-controller-metrics-reader"]
        CR_KubeRBAC["kube-rbac-proxy-auth-review"]
        CR_Read["dch-read"]
        CR_ReadWrite["dch-read-write"]
        CR_Admin["dch-admin"]
        CR_RestData["rest-service-data-access"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_DCHAdmin["dc-controller-dataconnecthub-admin-role"]
        CR_DCHEditor["dc-controller-dataconnecthub-editor-role"]
        CR_DCHViewer["dc-controller-dataconnecthub-viewer-role"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_Leader["dc-controller-leader-election-role"]
    end

    subgraph ControllerResources["Controller Manager Resources"]
        Res_Core["core<br/>configmaps, serviceaccounts,<br/>services, secrets"]
        Res_Apps["apps<br/>deployments"]
        Res_Auth["authentication.k8s.io<br/>tokenreviews"]
        Res_Authz["authorization.k8s.io<br/>subjectaccessreviews"]
        Res_OS["config.openshift.io<br/>apiservers, ingresses"]
        Res_DCH["dataconnecthub.opendatahub.io<br/>dataconnectservices,<br/>data-connection-types,<br/>data-connections"]
        Res_GW["gateway.networking.k8s.io<br/>gateways, httproutes"]
        Res_Net["networking.k8s.io<br/>networkpolicies"]
        Res_RBAC["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings"]
    end

    subgraph TenantResources["Tenant-Scoped Resources"]
        Res_TenantDCH["dataconnecthub.opendatahub.io<br/>data-connections,<br/>data-connection-types,<br/>data-store"]
        Res_Metrics["/metrics<br/>(non-resource URL)"]
    end

    %% SA → CRB → CR bindings
    SA_Controller -->|"bound via"| CRB_Manager
    SA_Controller -->|"bound via"| CRB_MetricsAuth
    SA_Rest -->|"bound via"| CRB_KubeRBAC
    SA_Rest -->|"bound via"| CRB_RestData
    SA_Flight -->|"bound via"| CRB_FlightAuth
    SA_Controller -->|"bound via"| RB_Leader

    CRB_Manager -->|"grants"| CR_Manager
    CRB_MetricsAuth -->|"grants"| CR_MetricsAuth
    CRB_KubeRBAC -->|"grants"| CR_KubeRBAC
    CRB_FlightAuth -->|"grants"| CR_AuthDelegator
    CRB_RestData -->|"grants"| CR_RestData
    RB_Leader -->|"grants"| R_Leader

    %% CR → Resources
    CR_Manager -->|"CRUD + watch"| Res_Core
    CR_Manager -->|"CRUD + watch"| Res_Apps
    CR_Manager -->|"create"| Res_Auth
    CR_Manager -->|"create"| Res_Authz
    CR_Manager -->|"get, list, watch"| Res_OS
    CR_Manager -->|"CRUD + watch"| Res_DCH
    CR_Manager -->|"CRUD + watch"| Res_GW
    CR_Manager -->|"CRUD + watch"| Res_Net
    CR_Manager -->|"CRUD + watch"| Res_RBAC

    CR_MetricsAuth -->|"create"| Res_Auth
    CR_MetricsAuth -->|"create"| Res_Authz
    CR_MetricsReader -->|"get"| Res_Metrics

    CR_KubeRBAC -->|"create"| Res_Auth
    CR_KubeRBAC -->|"create"| Res_Authz
    CR_AuthDelegator -->|"create"| Res_Auth
    CR_AuthDelegator -->|"create"| Res_Authz

    CR_Read -->|"get, list, watch"| Res_TenantDCH
    CR_ReadWrite -->|"full CRUD"| Res_TenantDCH
    CR_Admin -->|"full CRUD"| Res_TenantDCH
    CR_RestData -->|"get, list, create, update"| Res_TenantDCH

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_Rest fill:#4a90e2,color:#fff
    style SA_Flight fill:#4a90e2,color:#fff

    style CR_Manager fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_KubeRBAC fill:#f5a623,color:#fff
    style CR_Read fill:#f5a623,color:#fff
    style CR_ReadWrite fill:#f5a623,color:#fff
    style CR_Admin fill:#f5a623,color:#fff
    style CR_RestData fill:#f5a623,color:#fff
    style CR_AuthDelegator fill:#f5a623,color:#fff
    style CR_DCHAdmin fill:#f5a623,color:#fff
    style CR_DCHEditor fill:#f5a623,color:#fff
    style CR_DCHViewer fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff

    style Res_Core fill:#7ed321,color:#fff
    style Res_Apps fill:#7ed321,color:#fff
    style Res_Auth fill:#7ed321,color:#fff
    style Res_Authz fill:#7ed321,color:#fff
    style Res_OS fill:#7ed321,color:#fff
    style Res_DCH fill:#7ed321,color:#fff
    style Res_GW fill:#7ed321,color:#fff
    style Res_Net fill:#7ed321,color:#fff
    style Res_RBAC fill:#7ed321,color:#fff
    style Res_TenantDCH fill:#7ed321,color:#fff
    style Res_Metrics fill:#7ed321,color:#fff
