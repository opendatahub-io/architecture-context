graph TB
    subgraph AGC["ai-gateway-controller"]
        direction TB
        Manager["manager<br/>(controller-runtime)"]

        subgraph Reconcilers["Reconcilers"]
            TenantReconciler["tenant.Reconciler<br/>Watches MaasTenantConfig / AITenant"]
            ControllerReconciler["controller.Reconciler<br/>Watches ExternalModel / ExternalProvider"]
        end

        subgraph Libraries["Internal Libraries"]
            Render["pkg/render<br/>Kustomize build + SSA apply"]
            Envelope["pkg/envelope<br/>RFC 8785 JCS + SHA-256<br/>content-addressed overlay"]
            Resolver["pkg/resolver<br/>Model/Provider route resolver"]
            Publisher["pkg/publisher<br/>ConfigMap publish + tamper detect"]
            TenantPkg["pkg/tenant<br/>Naming, handshake, finalizers"]
        end

        Manager --> TenantReconciler
        Manager --> ControllerReconciler
        TenantReconciler --> Render
        TenantReconciler --> TenantPkg
        ControllerReconciler --> Resolver
        ControllerReconciler --> Publisher
        ControllerReconciler --> Envelope
        Publisher --> Envelope
    end

    %% CRDs
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io/v1alpha1)"]
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io/v1alpha1)"]
    MaasTenantConfigCR["MaasTenantConfig CR"]

    ExternalModelCR -->|watched by| ControllerReconciler
    ExternalProviderCR -->|watched by| ControllerReconciler
    MaasTenantConfigCR -->|watched by| TenantReconciler

    %% Created resources
    TenantReconciler -->|SSA applies| PraxisDeployment["Praxis-ExtProc<br/>Deployment + Service"]
    TenantReconciler -->|SSA applies| EnvoyFilter["EnvoyFilter"]
    TenantReconciler -->|SSA applies| NetworkPolicy["NetworkPolicy"]

    ControllerReconciler -->|creates| HTTPRoute["HTTPRoute<br/>(per model)"]
    ControllerReconciler -->|creates| ServiceEntry["ServiceEntry<br/>(per provider)"]
    ControllerReconciler -->|creates| DestRule["DestinationRule<br/>(per provider)"]
    ControllerReconciler -->|creates| ExtNameSvc["ExternalName Service<br/>(per provider)"]
    ControllerReconciler -->|publishes| OverlayCM["Routing Overlay<br/>ConfigMap"]

    %% External dependencies
    Manager -->|depends on| K8sAPI["Kubernetes API"]
    ControllerReconciler -->|depends on| GatewayAPI["Gateway API"]
    ControllerReconciler -->|depends on| Istio["Istio"]

    %% Internal platform integrations
    Operator["ai-gateway-operator"] -->|deploys| Manager
    MaasCtrl["maas-controller"] -.->|annotation handshake| MaasTenantConfigCR
    PraxisExtProc["praxis-extproc"] -->|reads| OverlayCM

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style TenantReconciler fill:#4a90e2,color:#fff
    style ControllerReconciler fill:#4a90e2,color:#fff
    style Render fill:#5ba3d9,color:#fff
    style Envelope fill:#5ba3d9,color:#fff
    style Resolver fill:#5ba3d9,color:#fff
    style Publisher fill:#5ba3d9,color:#fff
    style TenantPkg fill:#5ba3d9,color:#fff
    style ExternalModelCR fill:#f5a623
    style ExternalProviderCR fill:#f5a623
    style MaasTenantConfigCR fill:#f5a623
    style HTTPRoute fill:#7ed321
    style ServiceEntry fill:#7ed321
    style DestRule fill:#7ed321
    style ExtNameSvc fill:#7ed321
    style OverlayCM fill:#7ed321
    style PraxisDeployment fill:#7ed321
    style EnvoyFilter fill:#7ed321
    style NetworkPolicy fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style Istio fill:#e8e8e8
    style Operator fill:#d5e8d4
    style MaasCtrl fill:#d5e8d4
    style PraxisExtProc fill:#d5e8d4
