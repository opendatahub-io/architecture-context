graph LR
    KVCache["llm-d-kv-cache"]

    %% Internal Platform Dependencies
    KVCache -->|"library embedding<br/>(primary consumer)"| LLMDRouter["llm-d-router"]
    KVCache -->|"ZMQ event stream<br/>5557/TCP"| vLLM["vLLM / SGLang"]

    %% External Infrastructure Dependencies
    KVCache -->|"block index<br/>6379/TCP"| Redis["Redis / Valkey"]
    KVCache -->|"OTLP traces<br/>4317/TCP"| OTel["OpenTelemetry Collector"]
    KVCache -->|"pod discovery<br/>6443/TCP"| K8sAPI["Kubernetes API"]

    %% UDS Tokenizer Dependencies
    KVCache -->|"model download<br/>443/TCP HTTPS"| HFHub["HuggingFace Hub"]

    %% Build Dependencies
    KVCache -->|"controller framework"| CtrlRuntime["controller-runtime v0.21"]
    KVCache -->|"Redis client"| GoRedis["go-redis v9.20"]
    KVCache -->|"ZMQ subscriber"| ZMQ4["go-zeromq/zmq4 v0.17"]
    KVCache -->|"metrics"| PromClient["prometheus/client_golang v1.23"]
    KVCache -->|"tracing"| OTelSDK["opentelemetry/otel v1.44"]
    KVCache -->|"gRPC transport"| GRPC["grpc v1.81"]
    KVCache -->|"block key hashing"| CBOR["fxamacker/cbor v2.9"]
    KVCache -->|"event wire format"| Msgpack["vmihailenco/msgpack v5.4"]
    KVCache -->|"memory cache"| Ristretto["dgraph-io/ristretto v2.4"]

    %% Python Dependencies
    KVCache -->|"tokenizer engine"| vLLMPy["vllm 0.19.1+cpu"]
    KVCache -->|"CUDA tensor ops"| PyTorch["torch 2.11.0"]

