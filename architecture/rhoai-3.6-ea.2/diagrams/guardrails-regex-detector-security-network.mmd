graph TB
    subgraph Upstream["UPSTREAM (Expected: Trusted Internal)"]
        Orchestrator["FMS Guardrails Orchestrator<br/>Dispatches detection requests"]
    end

    subgraph ExpectedMesh["EXPECTED: SERVICE MESH (mTLS)"]
        direction TB

        subgraph DetectorService["guardrails-regex-detector"]
            direction TB
            API["POST /api/v1/text/contents<br/>8080/TCP HTTP<br/>No TLS | No Auth"]
            Health["GET /health<br/>8080/TCP HTTP<br/>No TLS | No Auth"]
        end
    end

    subgraph Platform["PLATFORM"]
        Probe["Kubernetes Liveness Probe"]
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>No Encryption<br/>No Auth<br/>(expected: mTLS via mesh)"| API
    Probe -->|"HTTP GET /health<br/>8080/TCP<br/>No Encryption"| Health
    API -->|"HTTP Response<br/>JSON detections"| Orchestrator

    %% Security warnings
    Warning1["⚠️ Plain HTTP - No TLS termination in app"]
    Warning2["⚠️ No Auth - Relies on network isolation"]
    Warning3["⚠️ PII logged at info level"]

    %% Styling
    classDef upstream fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef warning fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#856404

    class Orchestrator upstream
    class API,Health service
    class Probe platform
    class Warning1,Warning2,Warning3 warning
