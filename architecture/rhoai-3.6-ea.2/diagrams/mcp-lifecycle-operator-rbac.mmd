graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["mcp-lifecycle-operator-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["mcp-lifecycle-operator-manager-rolebinding"]
        CRB2["mcp-lifecycle-operator-metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB1["mcp-lifecycle-operator-leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["mcp-lifecycle-operator-manager-role"]
        CR2["mcp-lifecycle-operator-metrics-auth-role"]
        CR3["mcp-lifecycle-operator-metrics-reader"]
    end

    subgraph AggregationRoles["RBAC Aggregation Roles"]
        AdminRole["mcpserver-admin-role<br/>(aggregate-to-admin)"]
        EditorRole["mcpserver-editor-role<br/>(aggregate-to-edit)"]
        ViewerRole["mcpserver-viewer-role<br/>(aggregate-to-view)"]
    end

    subgraph LeaderElectionRole["Role (namespace-scoped)"]
        LER["leader-election-role"]
    end

    subgraph APIResources["API Resources"]
        MCPServers["mcp.x-k8s.io<br/>MCPServer"]
        MCPStatus["mcp.x-k8s.io<br/>MCPServer/status"]
        MCPFinalizers["mcp.x-k8s.io<br/>MCPServer/finalizers"]
        Deployments["apps<br/>Deployments"]
        Services["core<br/>Services"]
        NetPolicies["networking.k8s.io<br/>NetworkPolicies"]
        ConfigMaps["core<br/>ConfigMaps"]
        Secrets["core<br/>Secrets"]
        Pods["core<br/>Pods"]
        Events["core, events.k8s.io<br/>Events"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
        Leases["coordination.k8s.io<br/>Leases"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% SA to Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| RB1

    %% Bindings to Roles
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2
    RB1 -->|grants| LER

    %% Manager Role Permissions
    CR1 -->|"get, list, watch"| ConfigMaps
    CR1 -->|"get, list, watch"| Secrets
    CR1 -->|"get, list"| Pods
    CR1 -->|"create, get, list, update, watch"| Services
    CR1 -->|"create, patch"| Events
    CR1 -->|"create, get, list, update, watch"| Deployments
    CR1 -->|"get, list, patch, update, watch"| MCPServers
    CR1 -->|"update"| MCPFinalizers
    CR1 -->|"get, patch, update"| MCPStatus
    CR1 -->|"create, get, list, update, watch"| NetPolicies

    %% Metrics Auth Role
    CR2 -->|"create"| TokenReviews
    CR2 -->|"create"| SAR

    %% Metrics Reader
    CR3 -->|"get"| MetricsURL

    %% Leader Election Role
    LER -->|"create, delete, get, list, patch, update, watch"| ConfigMaps
    LER -->|"create, delete, get, list, patch, update, watch"| Leases
    LER -->|"create, patch"| Events

    %% Aggregation Roles
    AdminRole -->|"create, delete, deletecollection, get, list, patch, update, watch"| MCPServers
    AdminRole -->|"get"| MCPStatus
    EditorRole -->|"create, delete, get, list, patch, update, watch"| MCPServers
    EditorRole -->|"get"| MCPStatus
    ViewerRole -->|"get, list, watch"| MCPServers
    ViewerRole -->|"get"| MCPStatus

