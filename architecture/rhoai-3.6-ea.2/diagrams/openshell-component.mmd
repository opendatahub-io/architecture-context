graph TB
    subgraph "OpenShell Platform"
        direction TB

        subgraph "Control Plane"
            Gateway["openshell-gateway<br/>(axum + tonic)<br/>8080/TCP gRPC+HTTP"]
            Server["openshell-server<br/>(Protocol Mux, TLS, Auth)"]
            Core["openshell-core<br/>(Types, Config, Proto)"]
            Providers["openshell-providers<br/>(Credential Resolution)"]
            Gateway --> Server
            Gateway --> Core
            Gateway --> Providers
        end

        subgraph "Policy Engine"
            Policy["openshell-policy<br/>(Filesystem/Network/Process)"]
            Prover["openshell-prover<br/>(Z3 SMT Verification)"]
            Prover -->|"proves boundaries"| Policy
        end

        subgraph "Supervisor Layer"
            Supervisor["openshell-supervisor<br/>5500/TCP TLS"]
            SupervisorNet["openshell-supervisor-network<br/>(L7 Proxy, OPA, SigV4)"]
            SupervisorProc["openshell-supervisor-process<br/>(Process Lifecycle)"]
            Supervisor --> SupervisorNet
            Supervisor --> SupervisorProc
            Supervisor --> Policy
        end

        subgraph "Sandbox Runtime"
            Sandbox["openshell-sandbox<br/>(Static glibc Binary)"]
        end

        subgraph "Compute Drivers"
            DriverK8s["openshell-driver-kubernetes<br/>(agents.x-k8s.io CRD)"]
            DriverDocker["openshell-driver-docker"]
            DriverPodman["openshell-driver-podman"]
            DriverVM["openshell-driver-vm<br/>(libkrun MicroVM)"]
            DriverMXC["openshell-driver-mxc<br/>(Windows AppContainer)"]
        end

        subgraph "Client Tools"
            CLI["openshell-cli"]
            TUI["openshell-tui<br/>(Ratatui Dashboard)"]
            SDK["openshell-sdk<br/>(Rust gRPC Client)"]
            PythonSDK["openshell Python SDK<br/>(PyPI)"]
        end

        Gateway -->|"lifecycle mgmt"| DriverK8s
        Gateway -->|"lifecycle mgmt"| DriverDocker
        Gateway -->|"lifecycle mgmt"| DriverPodman
        Gateway -->|"lifecycle mgmt"| DriverVM
        Gateway -->|"lifecycle mgmt"| DriverMXC

        Gateway -->|"SSH 2222/TCP mTLS"| Sandbox
        Supervisor -->|"isolation protocol"| Sandbox

        CLI -->|"gRPC"| Gateway
        TUI -->|"gRPC"| Gateway
        SDK -->|"gRPC"| Gateway
        PythonSDK -->|"gRPC"| Gateway
    end

    SandboxCRD["agents.x-k8s.io<br/>Sandbox CRD"]
    K8sAPI["Kubernetes API<br/>443/TCP"]
    ModelAPIs["Model Provider APIs<br/>443/TCP HTTPS"]

    DriverK8s -->|"CRUD"| SandboxCRD
    Gateway -->|"REST/Watch"| K8sAPI
    SupervisorNet -->|"policy-admitted egress"| ModelAPIs

    style Gateway fill:#4a90e2,stroke:#333,stroke-width:3px
    style Supervisor fill:#4a90e2,stroke:#333,stroke-width:2px
    style Sandbox fill:#e8744f,stroke:#333,stroke-width:2px
    style CLI fill:#7ed321,stroke:#333
    style TUI fill:#7ed321,stroke:#333
    style SDK fill:#7ed321,stroke:#333
    style PythonSDK fill:#7ed321,stroke:#333
    style Policy fill:#f5a623,stroke:#333
    style Prover fill:#f5a623,stroke:#333
    style DriverK8s fill:#9b59b6,stroke:#333
    style DriverDocker fill:#9b59b6,stroke:#333
    style DriverPodman fill:#9b59b6,stroke:#333
    style DriverVM fill:#9b59b6,stroke:#333
    style DriverMXC fill:#9b59b6,stroke:#333
    style SandboxCRD fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ModelAPIs fill:#e8e8e8,stroke:#333
