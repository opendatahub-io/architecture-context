graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mlflow-operator-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["mlflow-operator-manager-rolebinding"]
        CRB2["mlflow-operator-metrics-auth-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["mlflow-operator-manager-role"]
        CR_MetricsAuth["mlflow-operator-metrics-auth-role"]
        CR_MetricsReader["mlflow-operator-metrics-reader"]
        CR_View["mlflow-operator-mlflow-view<br/>(aggregate)"]
        CR_Edit["mlflow-operator-mlflow-edit<br/>(aggregate)"]
        CR_Integration["mlflow-operator-mlflow-integration<br/>(aggregate)"]
        CR_TLS["mlflow-operator-openshift-tls-profile-reader"]
    end

    subgraph APIResources["API Resources"]
        MLflows["mlflow.opendatahub.io<br/>MLflow, MLflow/finalizers, MLflow/status"]
        MLflowOperators["components.platform.opendatahub.io<br/>MLflowOperator (+finalizers,status)"]
        KubeflowRes["mlflow.kubeflow.org<br/>experiments, mlflowconfigs"]
        HTTPRoutes["gateway.networking.k8s.io<br/>HTTPRoutes"]
        ConsoleLinks["console.openshift.io<br/>ConsoleLinks"]
        ServiceMonitors["monitoring.coreos.com<br/>ServiceMonitors"]
        RBACRes["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings,<br/>RoleBindings"]
        AuthRes["services.platform.opendatahub.io<br/>Auths"]
        CoreRes["core<br/>Namespaces, Secrets<br/>(resourceName: mlflow-artifact-connection)"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SARs["authorization.k8s.io<br/>SubjectAccessReviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
        APIServers["config.openshift.io<br/>APIServers"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    CRB1 -->|"grants"| CR_Manager
    CRB2 -->|"grants"| CR_MetricsAuth

    %% Manager role permissions
    CR_Manager -->|"create,delete,get,list,<br/>patch,update,watch"| MLflows
    CR_Manager -->|"get,list,patch,<br/>update,watch"| MLflowOperators
    CR_Manager -->|"get,list,update,watch"| KubeflowRes
    CR_Manager -->|"full CRUD"| HTTPRoutes
    CR_Manager -->|"full CRUD"| ConsoleLinks
    CR_Manager -->|"full CRUD"| ServiceMonitors
    CR_Manager -->|"full CRUD"| RBACRes
    CR_Manager -->|"get,list,watch"| AuthRes
    CR_Manager -->|"get,list,watch"| CoreRes

    %% Metrics auth permissions
    CR_MetricsAuth -->|"create"| TokenReviews
    CR_MetricsAuth -->|"create"| SARs

    %% Metrics reader
    CR_MetricsReader -->|"get"| MetricsURL

    %% TLS profile reader
    CR_TLS -->|"get,list,watch"| APIServers

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style CR_View fill:#f5a623,stroke:#333
    style CR_Edit fill:#f5a623,stroke:#333
    style CR_Integration fill:#f5a623,stroke:#333
    style CR_TLS fill:#f5a623,stroke:#333
    style MLflows fill:#7ed321,stroke:#333
    style MLflowOperators fill:#7ed321,stroke:#333
    style KubeflowRes fill:#7ed321,stroke:#333
    style HTTPRoutes fill:#7ed321,stroke:#333
    style ConsoleLinks fill:#7ed321,stroke:#333
    style ServiceMonitors fill:#7ed321,stroke:#333
    style RBACRes fill:#7ed321,stroke:#333
    style AuthRes fill:#7ed321,stroke:#333
    style CoreRes fill:#7ed321,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SARs fill:#7ed321,stroke:#333
    style MetricsURL fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
