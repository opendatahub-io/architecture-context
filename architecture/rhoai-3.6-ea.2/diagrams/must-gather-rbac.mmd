graph TD
    subgraph OCPPath["OpenShift Path"]
        direction TB
        OCPAdmin["Cluster Admin<br/>(oc adm must-gather)"]
        OCPFramework["must-gather Framework<br/>(inherits cluster-admin)"]
        OCPPriv["cluster-admin<br/>(full cluster read access)"]

        OCPAdmin -->|invokes| OCPFramework
        OCPFramework -->|grants| OCPPriv
    end

    subgraph XKSPath["xKS Path (AKS / EKS / CKS)"]
        direction TB

        subgraph ServiceAccounts["Service Account"]
            XKSSA["must-gather-sa<br/>Namespace: must-gather"]
        end

        subgraph Bindings["ClusterRole Binding"]
            XKSCRB["must-gather-reader-binding<br/>(cluster-scoped)"]
        end

        subgraph Roles["ClusterRole"]
            XKSCR["must-gather-reader"]
        end

        XKSSA -->|bound via| XKSCRB
        XKSCRB -->|grants| XKSCR
    end

    subgraph Resources["API Resources Accessed (read-only)"]
        direction TB
        AllGroups["API Groups: *"]
        AllResources["Resources: *"]
        ReadVerbs["Verbs: get, list, watch"]

        AllGroups --- AllResources
        AllResources --- ReadVerbs
    end

    subgraph Secrets["Secrets"]
        PullSecret["redhat-pull-secret<br/>Type: dockerconfigjson<br/>Purpose: Pull image from<br/>registry.redhat.io<br/>Auto-rotate: No"]
    end

    OCPPriv -->|accesses| Resources
    XKSCR -->|"get, list, watch on * / *"| Resources

    style OCPAdmin fill:#4a90e2,color:#fff
    style OCPFramework fill:#4a90e2,color:#fff
    style OCPPriv fill:#f5a623,color:#fff
    style XKSSA fill:#4a90e2,color:#fff
    style XKSCR fill:#f5a623,color:#fff
    style XKSCRB fill:#e8e8e8,stroke:#333
    style AllGroups fill:#7ed321
    style AllResources fill:#7ed321
    style ReadVerbs fill:#7ed321
    style PullSecret fill:#f8d7da,stroke:#721c24
