graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Cluster Admin"]
        User["External User"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Router["OpenShift Router<br/>443/TCP<br/>TLS edge/reencrypt"]
        EnvoyGW["Envoy Gateway<br/>data-science-gateway<br/>443/TCP HTTPS<br/>EnvoyFilter: auth headers, CORS"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        direction TB

        subgraph AuthLayer["Authentication Layer"]
            AuthProxy["kube-auth-proxy<br/>(per-component)<br/>OIDC Authentication<br/>TLS (service-ca/cert-manager)"]
        end

        subgraph BackendSvcs["Backend Services"]
            Dashboard["Dashboard"]
            OtherSvc["Other Platform Services"]
        end
    end

    subgraph OperatorPlane["OPERATOR CONTROL PLANE"]
        direction TB

        subgraph OperatorPod["opendatahub-operator-controller-manager"]
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (service-ca)<br/>13 webhook endpoints"]
            MetricsSrv["Metrics Server<br/>8443/TCP HTTPS<br/>TLS (service-ca)<br/>WithAuthenticationAndAuthorization"]
            HealthSrv["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            Controllers["Controllers<br/>DSC, DSCI, Gateway,<br/>Auth, Monitoring,<br/>Module, Component"]
            TLSWatcher["TLS Profile Watcher<br/>Reads cluster APIServer<br/>TLS security profile"]
        end
    end

    subgraph K8sPlane["KUBERNETES / OPENSHIFT API"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount tokens"]
        OpenShiftExt["OpenShift Extensions<br/>Routes, OAuth, Console,<br/>ImageStreams, Users/Groups"]
    end

    %% External flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI
    User -->|"HTTPS/443<br/>TLS 1.2+"| Router

    %% Ingress flows
    Router -->|"HTTPS/443<br/>TLS reencrypt"| EnvoyGW
    EnvoyGW -->|"HTTPS/(templated)<br/>TLS (DestinationRule)<br/>OIDC token"| AuthProxy

    %% Auth proxy flows
    AuthProxy -->|"HTTP(S)/(templated)<br/>Forwarded auth headers"| Dashboard
    AuthProxy -->|"HTTP(S)/(templated)<br/>Forwarded auth headers"| OtherSvc

    %% Operator to API flows
    Controllers -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Controllers -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OpenShiftExt
    TLSWatcher -->|"HTTPS/6443<br/>Reads APIServer config"| K8sAPI

    %% API server to operator
    K8sAPI -->|"HTTPS/9443<br/>TLS (service-ca)<br/>Admission webhook"| WebhookSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Admin,User external
    class Router,EnvoyGW ingress
    class AuthProxy,Dashboard,OtherSvc platform
    class WebhookSrv,MetricsSrv,HealthSrv,Controllers,TLSWatcher operator
    class K8sAPI,OpenShiftExt k8s
