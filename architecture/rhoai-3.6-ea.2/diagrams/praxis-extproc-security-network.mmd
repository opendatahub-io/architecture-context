graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Gateway["GATEWAY (Envoy / Istio — openshift-ingress)"]
        direction TB
        EnvoyGW["Envoy Gateway<br/>MaaS Default Gateway<br/>TLS Termination"]

        subgraph FilterChain["EnvoyFilter Chain (priority 10)"]
            PreFilter["Pre-Auth ExtProc (ipp-pre)<br/>INSERT_BEFORE auth<br/>failure_mode_allow: true<br/>Request body: BUFFERED"]
            AuthFilter["Kuadrant / RHCL Auth<br/>(priority 0)"]
            PostFilter["Post-Auth ExtProc (ipp)<br/>INSERT_AFTER auth<br/>failure_mode_allow: false<br/>Request+Response: BUFFERED"]
        end

        EnvoyGW --> PreFilter
        PreFilter --> AuthFilter
        AuthFilter --> PostFilter
    end

    subgraph Services["SERVICES (openshift-ingress — NetworkPolicy)"]
        direction TB

        subgraph PreProcPod["payload-pre-processing"]
            PreProc["Praxis ExtProc<br/>BBR Pipeline<br/>SA: payload-processing<br/>32Mi/25m → 128Mi/200m"]
            PreHealth["Health: 50052/TCP"]
            PreMetrics["Metrics: 9090/TCP"]
        end

        subgraph PostProcPod["payload-processing"]
            PostProc["Praxis ExtProc<br/>IPP Pipeline<br/>SA: payload-processing<br/>64Mi/50m → 256Mi/500m"]
            PostHealth["Health: 50052/TCP"]
            PostMetrics["Metrics: 9090/TCP"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        KubeAPI["Kubernetes API Server<br/>443/TCP, 6443/TCP<br/>TLS"]
        DNS["kube-dns<br/>53/UDP, 53/TCP"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>openshift-monitoring"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer / API Key"| EnvoyGW

    %% Gateway to services
    PreFilter -->|"gRPC H2/9004<br/>TLS (self-signed)<br/>ACCEPT_UNTRUSTED<br/>STRICT_DNS"| PreProc
    PostFilter -->|"gRPC H2/9004<br/>TLS (self-signed)<br/>ACCEPT_UNTRUSTED<br/>STRICT_DNS"| PostProc

    %% Service to cluster
    PostProc -->|"HTTPS/6443<br/>TLS<br/>SA token"| KubeAPI
    PreProc -->|"HTTPS/6443<br/>TLS<br/>SA token"| KubeAPI
    PostProc -->|"DNS/53"| DNS
    PreProc -->|"DNS/53"| DNS

    %% Monitoring
    Prometheus -->|"HTTP/9090<br/>No TLS<br/>NetworkPolicy"| PreMetrics
    Prometheus -->|"HTTP/9090<br/>No TLS<br/>NetworkPolicy"| PostMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef filter fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class EnvoyGW gateway
    class PreFilter,AuthFilter,PostFilter filter
    class PreProc,PostProc,PreHealth,PreMetrics,PostHealth,PostMetrics service
    class KubeAPI,DNS cluster
    class Prometheus monitoring
