graph TB
    subgraph BuildTime["Build-Time Pipeline (CI)"]
        direction TB
        Extractor["model-extractor<br/>(Go CLI)"]
        Reporter["metadata-report<br/>(Go CLI)"]
        Extractor -->|generates| CatalogFiles["YAML Catalog Files<br/>(data/*.yaml)"]
        CatalogFiles -->|analyzed by| Reporter
    end

    subgraph RuntimeContainer["Runtime: odh-model-metadata-collection"]
        direction TB
        SleepProcess["sleep infinity<br/>(UBI 9 minimal-pqc)"]
        DataVolume["/app/data<br/>Read-only YAML catalogs"]
        SleepProcess -.->|hosts| DataVolume
    end

    subgraph CatalogTypes["Generated Catalogs"]
        direction TB
        ModelsCatalog["models-catalog.yaml"]
        ValidatedCatalog["validated-models-catalog.yaml"]
        OtherCatalog["other-models-catalog.yaml"]
        MCPCatalog["*-mcp-servers-catalog.yaml"]
        AgentsCatalog["redhat-agents-catalog.yaml"]
    end

    subgraph ExternalAPIs["External APIs (Build-Time Only)"]
        HuggingFace["HuggingFace API<br/>443/TCP HTTPS"]
        Registries["Container Registries<br/>(registry.redhat.io, quay.io)<br/>443/TCP HTTPS"]
        GitHub["GitHub API<br/>443/TCP HTTPS"]
    end

    HuggingFace -->|model collections<br/>& metadata| Extractor
    Registries -->|OCI manifests<br/>& layers| Extractor
    GitHub -->|agent metadata<br/>& READMEs| Extractor

    CatalogFiles -->|COPY instruction<br/>Konflux build| DataVolume

    subgraph Consumers["Runtime Consumers"]
        Dashboard["RHOAI Dashboard"]
        KServe["KServe<br/>(serving.kserve.io)"]
    end

    DataVolume -->|volume mount<br/>/app/data| Dashboard
    DataVolume -.->|data references<br/>serving.kserve.io| KServe

    style Extractor fill:#4a90e2,color:#fff
    style Reporter fill:#4a90e2,color:#fff
    style SleepProcess fill:#7ed321,color:#fff
    style DataVolume fill:#7ed321,color:#fff
    style Dashboard fill:#f5a623,color:#fff
    style KServe fill:#f5a623,color:#fff
    style HuggingFace fill:#e8e8e8,stroke:#999
    style Registries fill:#e8e8e8,stroke:#999
    style GitHub fill:#e8e8e8,stroke:#999
