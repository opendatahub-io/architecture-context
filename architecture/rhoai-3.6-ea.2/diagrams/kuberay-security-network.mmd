graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User[User / Client]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Platform Gateway<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth/OIDC"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph OperatorNS["Namespace: redhat-ods-applications"]
        direction TB

        Operator["KubeRay Operator<br/>SA: kuberay-operator"]

        MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>OpenShift serving cert<br/>SA Token + RBAC"]

        WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP HTTPS<br/>cert-manager self-signed<br/>Admission Review"]
    end

    subgraph UserNS["Namespace: user-namespace"]
        direction TB

        subgraph RayCluster["Ray Cluster (per-tenant)"]
            RBACProxy["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>OAuth/OIDC proxy"]
            RayHead["Ray Head Pod<br/>8265/TCP HTTP<br/>SA: ray-head-sa"]
            RayWorker["Ray Worker Pods<br/>10001/TCP gRPC<br/>mTLS (cert-manager CA)"]
        end

        NetPol["NetworkPolicy<br/>(annotation-activated)"]
        MTLSCerts["mTLS Certificates<br/>cert-manager per-cluster CA"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRDs<br/>TLS 1.2+"]
        Prometheus["Prometheus<br/>Scrapes 8443/TCP HTTPS<br/>SA Token"]
        OSAPIServer["OpenShift APIServer<br/>TLS Profile Config"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth/OIDC"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>OAuth Token"| RBACProxy
    RBACProxy -->|"HTTP/8265<br/>None (localhost)<br/>None"| RayHead

    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    K8sAPI -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>Admission Review"| WebhookSvc

    RayHead -->|"gRPC/10001<br/>mTLS<br/>Client Certificate"| RayWorker

    Operator -.->|"CRD CRUD<br/>TLS 1.2+"| CertManager
    Prometheus -.->|"HTTPS/8443<br/>SA Token"| MetricsSvc
    Operator -.->|"Read + Watch<br/>TLS 1.2+"| OSAPIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorms fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Gateway ingress
    class K8sAPI controlplane
    class Operator,MetricsSvc,WebhookSvc operatorms
    class RBACProxy,RayHead,RayWorker,NetPol,MTLSCerts userns
    class CertManager,Prometheus,OSAPIServer platform
