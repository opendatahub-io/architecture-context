graph TD
    subgraph "llm-d-pd-utils RBAC Model"
        direction TB

        Note["⚠ No RBAC Resources Defined<br/>This is a diagnostics toolkit,<br/>not a controller or operator"]

        subgraph "Benchmark Pods"
            ServerSA["ServiceAccount: default<br/>(nixl-server pod)"]
            ClientSA["ServiceAccount: default<br/>(nixl-client pod)"]
        end

        subgraph "Preflight Pod"
            PreflightSA["ServiceAccount: default<br/>(model server pod)"]
        end

        subgraph "Operator Access (External)"
            OperatorKC["Operator kubeconfig<br/>Required for networking tests"]
        end

        subgraph "Kubernetes API Permissions Needed"
            PodList["pods: get, list, watch<br/>(pod discovery by label)"]
            PodExec["pods/exec: create<br/>(kubectl exec into target pods)"]
        end

        OperatorKC -->|"kubeconfig grants"| PodList
        OperatorKC -->|"kubeconfig grants"| PodExec
    end

    subgraph "RoCE Pod Capabilities"
        IPCLock["IPC_LOCK Capability<br/>Required for RDMA memory pinning"]
        RoCERes["nvidia.com/roce_gdr<br/>RoCE GPU-Direct resource"]
        SHM["/dev/shm mount<br/>Shared memory for NCCL"]
    end

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px,color:#333
    style ServerSA fill:#f8cecc,stroke:#b85450
    style ClientSA fill:#f8cecc,stroke:#b85450
    style PreflightSA fill:#f8cecc,stroke:#b85450
    style OperatorKC fill:#d5e8d4,stroke:#82b366
    style PodList fill:#dae8fc,stroke:#6c8ebf
    style PodExec fill:#dae8fc,stroke:#6c8ebf
    style IPCLock fill:#f8cecc,stroke:#b85450
    style RoCERes fill:#fff2cc,stroke:#d6b656
    style SHM fill:#fff2cc,stroke:#d6b656
