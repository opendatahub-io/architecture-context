graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP → 8443/TCP<br/>TLS Re-encrypt<br/>Bearer Token"]
        VirtualService["Istio VirtualService<br/>443/TCP in-mesh<br/>No TLS termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph OperatorPod["Operator Pod"]
            ManagerBin["Manager Binary<br/>SA: trustyai-operator-module-controller-manager"]
            MetricsServer["Metrics Server<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>Bearer + RBAC"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            WebhookServer["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster profile)<br/>K8s Admission"]
        end

        subgraph TASPod["TrustyAIService Pod"]
            RBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
            TASContainer["TrustyAI Service<br/>8081/TCP HTTP<br/>localhost only"]
        end

        subgraph EvalHubPod["EvalHub Pod"]
            EvalHubContainer["EvalHub Service<br/>8081/TCP HTTP<br/>Prometheus metrics"]
        end

        subgraph LMEvalPod["LMEvalJob Pod"]
            EvalRunner["Eval Job Runner"]
            DriverSidecar["LMES Driver Sidecar"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token / User Token"]

        MetricsSvc["Operator Metrics Service<br/>8443/TCP HTTPS<br/>service-ca TLS"]
        EvalHubMetricsSvc["EvalHub Metrics Service<br/>8081/TCP HTTP"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OTelCollector["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Runtime-configured"]
        APIServerConfig["OpenShift APIServer Config<br/>TLS Profile Source"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Route
    Client -->|"HTTPS/443<br/>in-mesh"| VirtualService

    %% Ingress → Internal
    Route -->|"HTTPS/8443<br/>TLS re-encrypt<br/>Proxied auth"| RBACProxy
    VirtualService -->|"HTTP/8443<br/>Service mesh"| RBACProxy

    %% TAS Pod internal
    RBACProxy -->|"HTTP/8081<br/>localhost<br/>No encryption"| TASContainer

    %% Operator → K8s API
    ManagerBin -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Driver → K8s API
    DriverSidecar -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Operator → External
    ManagerBin -->|"OTLP/gRPC<br/>Runtime config"| OTelCollector
    ManagerBin -->|"via K8s API<br/>Read-only"| APIServerConfig

    %% Services
    MetricsSvc -.->|"HTTPS/8443"| MetricsServer
    EvalHubMetricsSvc -.->|"HTTP/8081"| EvalHubContainer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Route,VirtualService ingress
    class ManagerBin,MetricsServer,HealthProbes,WebhookServer operator
    class RBACProxy,TASContainer,EvalHubContainer,EvalRunner,DriverSidecar,K8sAPI,MetricsSvc,EvalHubMetricsSvc internal
    class OTelCollector,APIServerConfig externalservice
