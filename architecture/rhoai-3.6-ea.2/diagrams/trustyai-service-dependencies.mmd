graph LR
    TrustyAI["TrustyAI Service"]

    %% Internal Platform Dependencies
    TrustyAI -->|"auth sidecar<br/>HTTP loopback"| KubeRBACProxy["kube-rbac-proxy"]
    TrustyAI -->|"deployment mgmt"| TrustyAIOp["TrustyAI Operator"]
    TrustyAI -->|"inference data<br/>HTTP/8080"| KServe["KServe / ModelMesh"]
    TrustyAI -->|"metric scrape<br/>HTTP/8081"| Prometheus["Prometheus"]

    %% External Service Dependencies
    TrustyAI -->|"data storage<br/>MySQL/3306"| MariaDB["MariaDB<br/>(optional)"]
    TrustyAI -->|"data storage<br/>filesystem"| PVC["PVC Volume<br/>(HDF5)"]

