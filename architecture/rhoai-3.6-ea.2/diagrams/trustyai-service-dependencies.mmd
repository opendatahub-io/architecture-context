    TrustyAI -.->|"REST framework"| FastAPI["FastAPI >=0.116"]
    TrustyAI -.->|"ASGI server"| Hypercorn["Hypercorn >=0.18"]
    TrustyAI -.->|"fairness metrics"| ScikitLearn["scikit-learn >=1.7"]
    TrustyAI -.->|"statistical tests"| SciPy["scipy >=1.15"]
    TrustyAI -.->|"data processing"| Pandas["pandas >=3.0"]
    TrustyAI -.->|"data processing"| Polars["polars >=1.2"]
    TrustyAI -.->|"metrics export"| PromClient["prometheus-client >=0.22"]
    TrustyAI -.->|"HDF5 I/O"| H5py["h5py >=3.13"]
    TrustyAI -.->|"KServe v2 protocol"| Protobuf["protobuf >=7"]

    %% Integration points (what depends on TrustyAI)
    Dashboard["ODH Dashboard"] -->|"UI management"| TrustyAI

