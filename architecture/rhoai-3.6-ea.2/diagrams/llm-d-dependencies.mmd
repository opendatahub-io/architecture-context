graph LR
    LLM_D["llm-d<br/>Inference Stack"]

    %% External Dependencies (Required)
    LLM_D -->|"model runtime"| vLLM["vLLM v0.30.0"]
    LLM_D -->|"orchestration"| K8s["Kubernetes 1.28+"]
    LLM_D -->|"ingress"| GatewayAPI["Gateway API"]
    LLM_D -->|"model routing CRDs"| GAIE["Gateway API<br/>Inference Extension"]
    LLM_D -->|"router deployment"| Helm["Helm 3.x"]
    LLM_D -->|"guide deployment"| Kustomize["kustomize 5.x"]

    %% External Dependencies (Optional)
    LLM_D -.->|"KV-cache transfer<br/>(CPU, ROCm)"| NIXL["NIXL"]
    LLM_D -.->|"RDMA networking<br/>(CPU, ROCm)"| UCX["UCX"]
    LLM_D -.->|"transport resilience<br/>(ROCm)"| UCCL["UCCL v0.0.1.post6"]
    LLM_D -.->|"AMD optimizer<br/>(ROCm)"| MORI["MORI v1.2.2"]
    LLM_D -.->|"KV-cache sharing<br/>(XPU)"| LMCache["LMCache v0.5.0"]

    %% Internal llm-d Dependencies
    LLM_D -->|"request routing<br/>HTTP :8081"| Router["llm-d-router"]
    LLM_D -->|"PD routing<br/>in-pod sidecar"| RoutingSidecar["llm-d-routing-sidecar"]
    LLM_D -->|"KV scheduling<br/>tiered offload"| KVCache["llm-d-kv-cache"]
    LLM_D -.->|"SLO autoscaling<br/>KEDA"| Autoscaler["llm-d-workload-<br/>variant-autoscaler"]
    LLM_D -.->|"latency scoring<br/>EPP plugin"| LatencyPredictor["llm-d-latency-<br/>predictor"]
    LLM_D -.->|"batch API"| BatchGateway["llm-d-batch-gateway"]
    LLM_D -.->|"async processing"| Async["llm-d-async"]

    %% External Services
    LLM_D -->|"model downloads<br/>HTTPS :443"| HFHub["HuggingFace Hub"]
    LLM_D -->|"images + charts<br/>HTTPS :443"| GHCR["ghcr.io"]

    %% Integration Points (things that integrate WITH llm-d)
    Prometheus["Prometheus"] -->|"metrics scrape<br/>HTTP :8000"| LLM_D
    OTel["OpenTelemetry"] -->|"trace collection<br/>gRPC :4317"| LLM_D

    %% Styling
    style LLM_D fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External required
    style vLLM fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style GAIE fill:#999,stroke:#333,color:#fff
    style Helm fill:#999,stroke:#333,color:#fff
    style Kustomize fill:#999,stroke:#333,color:#fff

    %% External optional (accelerator-specific)
    style NIXL fill:#bbb,stroke:#333,color:#333
    style UCX fill:#bbb,stroke:#333,color:#333
    style UCCL fill:#bbb,stroke:#333,color:#333
    style MORI fill:#bbb,stroke:#333,color:#333
    style LMCache fill:#bbb,stroke:#333,color:#333

    %% Internal llm-d ecosystem
    style Router fill:#7ed321,stroke:#333,color:#fff
    style RoutingSidecar fill:#7ed321,stroke:#333,color:#fff
    style KVCache fill:#7ed321,stroke:#333,color:#fff
    style Autoscaler fill:#7ed321,stroke:#333,color:#fff
    style LatencyPredictor fill:#7ed321,stroke:#333,color:#fff
    style BatchGateway fill:#7ed321,stroke:#333,color:#fff
    style Async fill:#7ed321,stroke:#333,color:#fff

