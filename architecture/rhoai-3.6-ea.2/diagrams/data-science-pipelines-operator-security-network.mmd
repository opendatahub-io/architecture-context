graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard / CI Pipeline"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        APIRoute["Pipeline API Server Route<br/>443/TCP → 8888/TCP<br/>TLS Edge/Reencrypt<br/>OAuth / Bearer token"]
        MinIORoute["MinIO Route (optional)<br/>443/TCP → 9000/TCP<br/>TLS Edge"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        DSPOController["DSPO Controller Manager<br/>SA: controller-manager"]
        MetricsProxy["kube-rbac-proxy<br/>8443/TCP → 8080/TCP<br/>TLS cluster profile<br/>SA token review"]
        WebhookServer["Webhook Server<br/>9443/TCP<br/>TLS cluster profile"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
    end

    subgraph DSPANamespace["DSPA NAMESPACE (per-tenant)"]
        direction TB

        APIServer["Pipeline API Server<br/>8888/TCP"]
        ArgoController["Argo Workflow Controller<br/>SA: argo"]
        PersistenceAgent["Persistence Agent"]
        ScheduledWF["Scheduled Workflow Controller"]
        MLMDEnvoy["MLMD + Envoy<br/>8443/TCP gRPC<br/>mTLS"]

        subgraph OptionalStorage["Optional In-Namespace Storage"]
            MariaDB["MariaDB<br/>3306/TCP MySQL<br/>TLS configurable"]
            MinIOPod["MinIO<br/>9000/TCP<br/>TLS configurable"]
        end

        NetPol["NetworkPolicy<br/>Per-DSPA isolation"]
    end

    subgraph Monitoring["MONITORING (redhat-ods-monitoring)"]
        Prometheus["Prometheus<br/>SA: data-science-monitoringstack-prometheus"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token"]
        ExtDB["External Database<br/>3306/TCP MySQL<br/>TLS configurable"]
        ExtS3["External S3 Store<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>IAM / Access key"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS<br/>OAuth / Bearer"| APIRoute
    APIRoute -->|"HTTP/8888<br/>TLS terminated"| APIServer

    %% Operator flows
    DSPOController -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    DSPOController -->|"MySQL/3306<br/>TLS configurable<br/>DB credentials"| MariaDB
    DSPOController -->|"HTTPS or HTTP/9000<br/>TLS configurable<br/>Access key"| MinIOPod

    %% Deployed component flows
    APIServer -->|"MySQL/3306<br/>TLS<br/>DB credentials"| MariaDB
    APIServer -->|"HTTPS/443<br/>TLS<br/>S3 credentials"| ExtS3
    APIServer -->|"MySQL/3306<br/>TLS<br/>DB credentials"| ExtDB
    ArgoController -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ArgoController -->|"gRPC/8443<br/>mTLS Envoy<br/>Certificate"| MLMDEnvoy

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>SA token review"| MetricsProxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef dspa fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class APIRoute,MinIORoute ingress
    class DSPOController,MetricsProxy,WebhookServer,HealthProbes operator
    class APIServer,ArgoController,PersistenceAgent,ScheduledWF,MLMDEnvoy,NetPol dspa
    class MariaDB,MinIOPod storage
    class Prometheus monitoring
    class K8sAPI,ExtDB,ExtS3 externalservice
