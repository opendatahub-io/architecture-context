graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph JobPod["EVAL-HUB JOB POD (Batch - No Ingress)"]
            direction LR
            Adapter["Garak Adapter<br/>Image: odh-trustyai-garak-lls-provider-dsp-rhel9<br/>SA: eval-hub managed<br/>Ports: None"]
            Sidecar["eval-hub Sidecar<br/>localhost HTTP<br/>No encryption"]
            Adapter -->|"localhost HTTP<br/>No encryption<br/>Result callbacks"| Sidecar
        end

        subgraph ConfigSources["CONFIGURATION (Mounted)"]
            JobSpec["/etc/eval-job/spec.json<br/>(ConfigMap)"]
            ModelAuthSecret["model-auth Secret<br/>(Volume Mount)<br/>API keys per role"]
            DataConnSecret["Data Connection Secret<br/>(Env Injection)<br/>AWS credentials"]
        end

        subgraph KFPNamespace["KUBEFLOW PIPELINES (KFP_NAMESPACE)"]
            KFPAPI["KFP API Server"]
            KFPPods["KFP Pipeline Pods<br/>(6-Step Pipeline)<br/>Secret injection"]
        end

        subgraph K8sServices["KUBERNETES SERVICES"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>SA cert auth"]
            TrustyAICM["trustyai-service-operator-config<br/>(ConfigMap)<br/>Pipeline image resolution"]
        end

        JobSpec -.->|mount| Adapter
        ModelAuthSecret -.->|mount| Adapter
        DataConnSecret -.->|env inject| Adapter

        Adapter -->|"HTTP/HTTPS<br/>Configurable TLS<br/>SA token / sidecar proxy"| KFPAPI
        KFPAPI --> KFPPods
        Adapter -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
        K8sAPI -.-> TrustyAICM
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS TLS<br/>AWS IAM credentials"]
        TargetLLM["Target LLM Endpoint<br/>HTTP/HTTPS<br/>Configurable TLS<br/>Bearer API key<br/>(13-step fallback)"]
        SDGModel["SDG Model Endpoint<br/>HTTP/HTTPS<br/>Configurable TLS<br/>SDG API key"]
        MultiRoleLLM["Judge/Attacker/Evaluator LLMs<br/>HTTP/HTTPS<br/>Configurable TLS<br/>Per-role API keys"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS TLS<br/>Optional HF token"]
    end

    %% Egress flows from adapter
    Adapter -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    Adapter -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Bearer API key"| TargetLLM
    Adapter -->|"HTTP/HTTPS<br/>Configurable TLS<br/>SDG API key"| SDGModel
    Adapter -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Per-role keys"| MultiRoleLLM
    Adapter -->|"HTTPS/443<br/>TLS<br/>Optional HF token"| HFHub

    %% KFP pipeline pods also access external services
    KFPPods -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    KFPPods -->|"HTTP/HTTPS<br/>Bearer API key"| TargetLLM
    KFPPods -->|"HTTP/HTTPS<br/>SDG API key"| SDGModel

    %% Styling
    classDef cluster fill:#f0f7ff,stroke:#4a90e2,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef config fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef kfp fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Adapter,Sidecar pod
    class JobSpec,ModelAuthSecret,DataConnSecret config
    class KFPAPI,KFPPods kfp
    class K8sAPI,TrustyAICM k8s
    class S3,TargetLLM,SDGModel,MultiRoleLLM,HFHub external
