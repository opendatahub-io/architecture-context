graph TD
    subgraph "Benchmark Harness RBAC"
        subgraph "Subjects"
            AuthUsers["Group: system:authenticated<br/>⚠ ALL authenticated users"]
        end

        subgraph "Role Bindings"
            ExecRB["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}"]
        end

        subgraph "Roles"
            ExecRole["${PROJECT_NAME}-exec-role<br/>(namespace-scoped Role)"]
        end

        subgraph "Resources (Namespace)"
            PodsExec["core<br/>pods/exec"]
        end

        AuthUsers -->|bound via| ExecRB
        ExecRB -->|grants| ExecRole
        ExecRole -->|create| PodsExec
    end

    subgraph "Stack Discovery RBAC"
        subgraph "Service Accounts"
            DiscoverySA["llm-d-stack-discovery/default<br/>ServiceAccount"]
        end

        subgraph "Cluster Role Bindings"
            DiscoveryCRB["llm-d-stack-discovery<br/>(cluster-scoped)"]
        end

        subgraph "Cluster Roles"
            DiscoveryCR["llm-d-stack-discovery<br/>(ClusterRole)"]
        end

        subgraph "API Resources (Cluster-wide)"
            CoreRes["core<br/>pods, services, configmaps, nodes"]
            AppsRes["apps<br/>deployments, statefulsets, replicasets"]
            RouteRes["route.openshift.io<br/>routes"]
            SecurityRes["security.openshift.io<br/>securitycontextconstraints"]
            ConfigRes["config.openshift.io<br/>clusterversions"]
            GatewayRes["gateway.networking.k8s.io<br/>gateways, httproutes, gatewayclasses"]
            GAIERes["inference.networking.x-k8s.io<br/>inferencepools, inferencemodels"]
            VersionRes["core<br/>version"]
        end

        DiscoverySA -->|bound via| DiscoveryCRB
        DiscoveryCRB -->|grants| DiscoveryCR
        DiscoveryCR -->|"get, list"| CoreRes
        DiscoveryCR -->|"get, list"| AppsRes
        DiscoveryCR -->|"get, list"| RouteRes
        DiscoveryCR -->|"get, list"| SecurityRes
        DiscoveryCR -->|"get, list"| ConfigRes
        DiscoveryCR -->|"get, list"| GatewayRes
        DiscoveryCR -->|"get, list"| GAIERes
        DiscoveryCR -->|"get, list"| VersionRes
    end

    style AuthUsers fill:#f5a623,stroke:#333
    style DiscoverySA fill:#4a90e2,stroke:#333
    style ExecRole fill:#f8cecc,stroke:#b85450
    style DiscoveryCR fill:#f8cecc,stroke:#b85450
    style PodsExec fill:#7ed321,stroke:#333
    style CoreRes fill:#7ed321,stroke:#333
    style AppsRes fill:#7ed321,stroke:#333
    style RouteRes fill:#7ed321,stroke:#333
    style SecurityRes fill:#7ed321,stroke:#333
    style ConfigRes fill:#7ed321,stroke:#333
    style GatewayRes fill:#7ed321,stroke:#333
    style GAIERes fill:#7ed321,stroke:#333
    style VersionRes fill:#7ed321,stroke:#333
