graph TD
    subgraph HelmChart["Helm Chart Resources"]
        SA["ServiceAccount<br/>llm-d-async"]
    end

    subgraph PodSecurity["Pod Security Context"]
        RunAsNonRoot["runAsNonRoot: true"]
        Seccomp["seccompProfile: RuntimeDefault"]
        DropAll["capabilities: drop ALL"]
    end

    subgraph Endpoints["Endpoint Authentication"]
        Health["/healthz, /readyz<br/>Port: 8081/TCP<br/>Auth: None<br/>(kubelet access only)"]
        MetricsEndpoint["/metrics<br/>Port: 9090/TCP<br/>Auth: Optional<br/>kube-rbac-proxy"]
    end

    subgraph SecretsAccess["Secrets Access"]
        RedisSecret["Redis URL Secret<br/>(Opaque)<br/>Connection URL with credentials"]
        TLSSecret["TLS Certificates<br/>(kubernetes.io/tls)<br/>mTLS to inference gateway"]
    end

    subgraph ExternalAuth["External Service Authentication"]
        RedisAuth["Redis / Valkey<br/>Auth: URL credentials"]
        GCPAuth["GCP Pub/Sub<br/>Auth: GCP IAM (OAuth2)"]
        K8sAuth["Kubernetes API<br/>Auth: ServiceAccount token"]
        GatewayAuth["llm-d-router<br/>Auth: Optional mTLS or Bearer"]
    end

    SA -->|"pod identity"| PodSecurity
    SA -->|"serves"| Endpoints
    SA -->|"mounts"| SecretsAccess
    SA -->|"authenticates to"| ExternalAuth

    RedisSecret -->|"provides creds"| RedisAuth
    TLSSecret -->|"provides certs"| GatewayAuth
    SA -->|"token auth"| K8sAuth

    Note["Note: No ClusterRole, Role,<br/>or RoleBinding defined.<br/>Helm chart creates SA only.<br/>Metrics auth via controller-runtime<br/>kube-rbac-proxy infrastructure."]

    style SA fill:#4a90e2,color:#fff
    style RunAsNonRoot fill:#7ed321,color:#fff
    style Seccomp fill:#7ed321,color:#fff
    style DropAll fill:#7ed321,color:#fff
    style Health fill:#d5e8d4,stroke:#82b366
    style MetricsEndpoint fill:#ffe6cc,stroke:#d79b00
    style RedisSecret fill:#f5a623,color:#fff
    style TLSSecret fill:#f5a623,color:#fff
    style RedisAuth fill:#fff2cc,stroke:#d6b656
    style GCPAuth fill:#fff2cc,stroke:#d6b656
    style K8sAuth fill:#fff2cc,stroke:#d6b656
    style GatewayAuth fill:#fff2cc,stroke:#d6b656
