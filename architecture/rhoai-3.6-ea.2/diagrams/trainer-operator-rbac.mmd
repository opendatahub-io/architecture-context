graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["trainer-operator-controller-manager<br/>(trainer-operator-system)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["trainer-operator-manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        ManagerRole["trainer-operator-manager-role"]
        MetricsReader["trainer-operator-metrics-reader"]
        AdminRole["trainer-operator-trainer-admin-role<br/>(aggregated)"]
        ViewerRole["trainer-operator-trainer-viewer-role<br/>(aggregated)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps, secrets, services"]
        Namespaces["core<br/>namespaces"]
        ServiceAccts["core<br/>serviceaccounts"]
        Deployments["apps<br/>deployments"]
    end

    subgraph AdmissionResources["Admission Resources"]
        Webhooks["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations<br/>validatingwebhookconfigurations"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    subgraph TrainerResources["Trainer API Resources"]
        Trainers["components.platform.opendatahub.io<br/>trainers, trainers/status, trainers/finalizers"]
        KubeflowRes["trainer.kubeflow.org<br/>clustertrainingruntimes<br/>trainingruntimes, trainjobs"]
        JobSets["jobset.x-k8s.io<br/>jobsets"]
    end

    subgraph RBACResources["RBAC Resources"]
        RBACItems["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings<br/>roles, rolebindings"]
    end

    subgraph MonitoringResources["Monitoring & Network Resources"]
        Monitors["monitoring.coreos.com<br/>podmonitors, servicemonitors"]
        NetPolicies["networking.k8s.io<br/>networkpolicies"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        APIServers["config.openshift.io<br/>apiservers"]
        JobSetOps["operator.openshift.io<br/>jobsetoperators"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        Metrics["/metrics"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    CRB -->|"grants"| ManagerRole

    %% Manager role permissions
    ManagerRole -->|"create,delete,get,list,<br/>patch,update,watch"| ConfigMaps
    ManagerRole -->|"create,get,list,<br/>patch,update,watch"| Namespaces
    ManagerRole -->|"create,delete,get,list,<br/>patch,update,watch"| ServiceAccts
    ManagerRole -->|"create,delete,get,list,<br/>patch,update,watch"| Deployments
    ManagerRole -->|"create,delete,get,list,<br/>patch,update,watch"| Webhooks
    ManagerRole -->|"create,get,list,<br/>patch,update,watch"| CRDs
    ManagerRole -->|"get,list,patch,<br/>update,watch"| Trainers
    ManagerRole -->|"full CRUD"| KubeflowRes
    ManagerRole -->|"full CRUD"| JobSets
    ManagerRole -->|"create,list,watch<br/>(+ named get,patch,<br/>update,delete)"| RBACItems
    ManagerRole -->|"full CRUD"| Monitors
    ManagerRole -->|"create,get,list,<br/>patch,update,watch"| NetPolicies
    ManagerRole -->|"get,list,watch"| APIServers
    ManagerRole -->|"get,list,watch"| JobSetOps
    ManagerRole -->|"get"| Metrics

    %% Metrics reader
    MetricsReader -->|"get"| Metrics

    %% Admin/Viewer aggregated roles
    AdminRole -->|"full CRUD"| Trainers
    ViewerRole -->|"get,list,watch"| Trainers

