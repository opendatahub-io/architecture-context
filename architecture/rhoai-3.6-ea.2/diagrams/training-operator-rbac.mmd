graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["training-operator<br/>Namespace: opendatahub"]
    end

    subgraph Bindings["Role Bindings"]
        CRB["training-operator<br/>(ClusterRoleBinding)"]
        RB["training-operator-webhook<br/>(RoleBinding, operator NS)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["training-operator<br/>(ClusterRole)"]
        WebhookRole["training-operator-webhook<br/>(Role, operator NS)"]
    end

    subgraph AggregatedRoles["Aggregated Roles"]
        EditRole["training-edit<br/>(ClusterRole)"]
        ViewRole["training-view<br/>(ClusterRole)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core / configmaps<br/>create, list, update, watch"]
        Events["core / events<br/>full CRUD + patch"]
        Pods["core / pods<br/>full CRUD + patch"]
        PodsExec["core / pods/exec<br/>create"]
        ServiceAcctRes["core / serviceaccounts<br/>create, get, list, watch"]
        ServicesRes["core / services<br/>create, delete, get, list, watch"]
    end

    subgraph KubeflowResources["Kubeflow API Resources"]
        Jobs["kubeflow.org / jaxjobs, mpijobs,<br/>paddlejobs, pytorchjobs,<br/>tfjobs, xgboostjobs<br/>full CRUD + patch"]
        Finalizers["kubeflow.org / */finalizers<br/>update"]
        Status["kubeflow.org / */status<br/>get, patch, update"]
    end

    subgraph K8sResources["Kubernetes Extended Resources"]
        WebhookConfigs["admissionregistration.k8s.io /<br/>validatingwebhookconfigurations<br/>get, list, update, watch"]
        HPA["autoscaling /<br/>horizontalpodautoscalers<br/>full CRUD + patch"]
        RBAC_Res["rbac.authorization.k8s.io /<br/>rolebindings, roles<br/>create, list, update, watch"]
        NetworkPolicies["networking.k8s.io /<br/>networkpolicies<br/>full CRUD + patch"]
    end

    subgraph SchedulingResources["Scheduling Resources"]
        VolcanoPG["scheduling.volcano.sh /<br/>podgroups<br/>full CRUD + patch"]
        SchedulerPG["scheduling.x-k8s.io /<br/>podgroups<br/>full CRUD + patch"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        APIServerConfig["config.openshift.io /<br/>apiservers (cluster)<br/>get"]
    end

    subgraph SecretResources["Secret Resources (Namespace-scoped)"]
        Secrets["core / secrets<br/>get, list, update, watch"]
    end

    %% SA to Bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB

    %% Bindings to Roles
    CRB -->|"grants"| CR
    RB -->|"grants"| WebhookRole

    %% ClusterRole to Resources
    CR -->|"permits"| CoreResources
    CR -->|"permits"| KubeflowResources
    CR -->|"permits"| K8sResources
    CR -->|"permits"| SchedulingResources
    CR -->|"permits"| OpenShiftResources

    %% Webhook Role to Secrets
    WebhookRole -->|"permits"| SecretResources

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style WebhookRole fill:#f5a623,stroke:#333,color:#fff
    style EditRole fill:#d4a574,stroke:#333,color:#fff
    style ViewRole fill:#d4a574,stroke:#333,color:#fff
    style CRB fill:#9ecae1,stroke:#333
    style RB fill:#9ecae1,stroke:#333
    style Jobs fill:#7ed321,stroke:#333
    style Finalizers fill:#7ed321,stroke:#333
    style Status fill:#7ed321,stroke:#333
    style Pods fill:#b3d9ff,stroke:#333
    style ConfigMaps fill:#b3d9ff,stroke:#333
    style Events fill:#b3d9ff,stroke:#333
    style PodsExec fill:#b3d9ff,stroke:#333
    style ServiceAcctRes fill:#b3d9ff,stroke:#333
    style ServicesRes fill:#b3d9ff,stroke:#333
    style WebhookConfigs fill:#e6ccff,stroke:#333
    style HPA fill:#e6ccff,stroke:#333
    style RBAC_Res fill:#e6ccff,stroke:#333
    style NetworkPolicies fill:#e6ccff,stroke:#333
    style VolcanoPG fill:#ffe6cc,stroke:#333
    style SchedulerPG fill:#ffe6cc,stroke:#333
    style APIServerConfig fill:#ffcccc,stroke:#333
    style Secrets fill:#ffcccc,stroke:#333
