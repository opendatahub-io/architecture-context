graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_NbCtrl["notebook-controller-service-account"]
        SA_Manager["manager<br/>(system namespace)"]
        SA_Proxy["service-account<br/>(proxy)"]
        SA_CtrlMgr["controller-manager<br/>(leader election)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_NbCtrl["notebook-controller-role-binding"]
        CRB_Manager["manager-rolebinding"]
        CRB_Proxy["proxy-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>(system namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_NbCtrl["notebook-controller-role"]
        CR_Manager["manager-role"]
        CR_Proxy["proxy-role"]
        CR_Leader["leader-election-role (Role)"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles (User-Facing)"]
        CR_Admin["notebooks-admin<br/>(aggregate-to-admin)"]
        CR_Edit["notebooks-edit"]
        CR_View["notebooks-view"]
    end

    subgraph NbCtrlResources["notebook-controller-role Resources"]
        NB_CRD["kubeflow.org<br/>notebooks, finalizers, status<br/>Verbs: *"]
        STS["apps<br/>statefulsets<br/>Verbs: *"]
        SVC_Core["core<br/>services<br/>Verbs: *"]
        PODS["core<br/>pods<br/>Verbs: delete, get, list, watch"]
        EVENTS["core<br/>events<br/>Verbs: create, get, list, patch, watch"]
        VS["networking.istio.io<br/>virtualservices<br/>Verbs: *"]
    end

    subgraph ManagerResources["manager-role Resources"]
        NB_RW["kubeflow.org<br/>notebooks<br/>Verbs: get, list, patch, update, watch"]
        GW["gateway.networking.k8s.io<br/>gateways<br/>Verbs: get, list, watch"]
        HR_RG["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/>Verbs: CRUD"]
        CORE_RES["core<br/>configmaps, secrets,<br/>serviceaccounts, services<br/>Verbs: create, get, list, patch, update, watch"]
        NETPOL["networking.k8s.io<br/>networkpolicies<br/>Verbs: CRUD"]
        RBAC_RES["rbac.authorization.k8s.io<br/>clusterrolebindings, rolebindings, roles<br/>Verbs: CRUD"]
        OAUTH_RES["oauth.openshift.io<br/>oauthclients<br/>Verbs: delete, get, list, patch, update, watch"]
        IMG["image.openshift.io<br/>imagestreams<br/>Verbs: get, list, watch"]
        ROUTE["route.openshift.io<br/>routes<br/>Verbs: get, list, watch"]
        DSPA_RES["datasciencepipelinesapplications<br/>Verbs: CRUD"]
        AUTH_RES["authentication/authorization<br/>tokenreviews, subjectaccessreviews<br/>Verbs: create"]
    end

    subgraph ProxyResources["proxy-role Resources"]
        PROXY_AUTH["authentication/authorization<br/>tokenreviews, subjectaccessreviews<br/>Verbs: create"]
    end

    %% Bindings
    SA_NbCtrl -->|"bound via"| CRB_NbCtrl
    SA_Manager -->|"bound via"| CRB_Manager
    SA_Proxy -->|"bound via"| CRB_Proxy
    SA_CtrlMgr -->|"bound via"| RB_Leader

    CRB_NbCtrl -->|"grants"| CR_NbCtrl
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Proxy -->|"grants"| CR_Proxy
    RB_Leader -->|"grants"| CR_Leader

    %% Role → Resources
    CR_NbCtrl -->|"permits"| NB_CRD
    CR_NbCtrl -->|"permits"| STS
    CR_NbCtrl -->|"permits"| SVC_Core
    CR_NbCtrl -->|"permits"| PODS
    CR_NbCtrl -->|"permits"| EVENTS
    CR_NbCtrl -->|"permits"| VS

    CR_Manager -->|"permits"| NB_RW
    CR_Manager -->|"permits"| GW
    CR_Manager -->|"permits"| HR_RG
    CR_Manager -->|"permits"| CORE_RES
    CR_Manager -->|"permits"| NETPOL
    CR_Manager -->|"permits"| RBAC_RES
    CR_Manager -->|"permits"| OAUTH_RES
    CR_Manager -->|"permits"| IMG
    CR_Manager -->|"permits"| ROUTE
    CR_Manager -->|"permits"| DSPA_RES
    CR_Manager -->|"permits"| AUTH_RES

    CR_Proxy -->|"permits"| PROXY_AUTH

    %% Aggregate roles
    CR_Edit -->|"notebooks: CRUD"| NB_CRD
    CR_View -->|"notebooks: read-only"| NB_CRD
    CR_Admin -->|"aggregates"| CR_Edit

