graph LR
    ODH["ODH Dashboard<br/>(core-bff + modules + operator)"]

    %% Parent Operator
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates Dashboard CR"| ODH

    %% External Dependencies
    ODH -->|"operator framework"| CR["controller-runtime 0.24.1"]
    ODH -->|"UI framework"| React["React 18.3.x"]
    ODH -->|"UI components"| PF["PatternFly 6.5.x"]
    ODH -->|"micro-frontends"| WMF["Webpack Module Federation<br/>(Rspack)"]
    ODH -->|"monorepo build"| Turbo["Turborepo 2.9.16"]
    ODH -->|"legacy backend"| Fastify["Fastify 5.11.2"]
    ODH -->|"TLS certificates"| CertMgr["cert-manager"]
    ODH -->|"tracing"| OTel["OpenTelemetry 1.46.0"]

    %% Internal Platform Dependencies (CRD Watch)
    ODH -->|"CRD Watch"| DSC["DataScienceCluster CR"]
    ODH -->|"CRD Watch"| DSCI["DSCInitialization CR"]
    ODH -->|"CRD Watch/CRUD"| InfSvc["KServe InferenceService"]
    ODH -->|"CRD CRUD"| MRegCR["ModelRegistry CR"]
    ODH -->|"CRD CRUD"| KfNB["Kubeflow Notebooks"]
    ODH -->|"HTTPRoute CRUD"| GwAPI["Gateway API 1.4.0"]
    ODH -->|"CRD CRUD"| SRT["ServingRuntime CR"]
    ODH -->|"CRD CRUD"| HWP["HardwareProfile CR"]
    ODH -->|"CRD Watch"| TAI["TrustyAI CRs"]
    ODH -->|"CRD Watch"| FeastCR["Feast FeatureStore CR"]
    ODH -->|"CRD Watch"| MLfCR["MLflow CR"]
    ODH -->|"CRD CRUD"| NimCR["NIM Account CR"]
    ODH -->|"CRD CRUD"| PromCR["prometheus-operator"]

    %% Downstream consumers
    IstioC["Istio VirtualService<br/>(istio.io/client-go 1.22.8)"] ---|"VirtualService mgmt"| ODH

    %% Egress to Platform Services
    ODH -->|"REST proxy"| DSP["DataScience Pipelines API"]
    ODH -->|"REST proxy"| MReg["Model Registry API"]
    ODH -->|"REST proxy"| KSrv["KServe Model Serving"]
    ODH -->|"gRPC-web proxy"| MLMD["ML Metadata"]
    ODH -->|"REST"| Trust["TrustyAI Service"]
    ODH -->|"REST"| Llama["Llama Stack Server"]
    ODH -->|"REST"| MaaSSvc["MaaS API Server"]
    ODH -->|"REST"| MLfSvc["MLflow Tracking Server"]
    ODH -->|"REST"| NeMo["NeMo Guardrails"]
    ODH -->|"REST"| Prom["Prometheus / Thanos"]
    ODH -->|"SSE / HTTP"| MCP["MCP Servers"]

    %% Go library deps
    ODH -->|"Go library"| OdhPU["odh-platform-utilities"]
    ODH -->|"Go library"| MLfGo["mlflow-go"]
    ODH -->|"Go client"| AWSS3["AWS SDK v2<br/>(S3 storage)"]
    ODH -->|"Go client"| KServeLib["kserve 0.16.1"]
    ODH -->|"Go client"| MRLib["model-registry 0.3.2"]
    ODH -->|"Go client"| MCPSdk["MCP Go SDK 0.3.1"]
    ODH -->|"Go client"| OAI["openai-go 2.7.1"]
    ODH -->|"Go client"| OGX["ogx-k8s-operator 0.9.0"]

