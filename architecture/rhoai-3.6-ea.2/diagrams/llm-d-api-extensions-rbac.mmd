graph TD
    subgraph Library["llm-d-api-extensions (Python Library)"]
        Note["No RBAC roles or bindings defined.<br/>This is a Python library, not a<br/>Kubernetes operator or workload."]
    end

    subgraph Inherited["Inherited from Host vLLM Deployment"]
        SA["ServiceAccount<br/>(deployment-defined)"]
        Roles["Roles & RoleBindings<br/>(deployment-defined)"]
        NetworkPolicy["NetworkPolicy<br/>(platform-defined)"]
    end

    subgraph AuthModel["Plugin Auth Model"]
        direction TB
        Endpoints["All Endpoints<br/>GET only (read-only)"]
        NoAuth["No plugin-level auth<br/>Auth delegated to platform"]
        Redaction["kv_connector_extra_config<br/>values redacted by default"]
    end

    SA -->|"runs as"| Library
    Roles -->|"grants permissions to"| SA
    NetworkPolicy -->|"controls access to"| Library

    Library -->|"exposes"| Endpoints
    Endpoints -->|"enforcement"| NoAuth
    Endpoints -->|"data protection"| Redaction

    subgraph EnvControls["Environment Variable Controls"]
        VLLMPlugins["VLLM_PLUGINS<br/>Controls plugin activation"]
        ExposeKV["LLM_D_INTROSPECTION_<br/>EXPOSE_KV_EXTRA_CONFIG<br/>Controls redaction"]
    end

    VLLMPlugins -.->|"opt-in"| Library
    ExposeKV -.->|"controls"| Redaction

    style Note fill:#f9f9f9,stroke:#999,stroke-dasharray:5
    style SA fill:#4a90e2,color:#fff
    style Roles fill:#4a90e2,color:#fff
    style NetworkPolicy fill:#4a90e2,color:#fff
    style Endpoints fill:#7ed321,color:#fff
    style NoAuth fill:#f5a623,color:#fff
    style Redaction fill:#7ed321,color:#fff
    style VLLMPlugins fill:#fff2cc,stroke:#d6b656
    style ExposeKV fill:#fff2cc,stroke:#d6b656
