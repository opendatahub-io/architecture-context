graph TB
    subgraph KubeflowComponent["Kubeflow Notebook Controllers"]
        direction TB

        subgraph UpstreamCtrl["notebook-controller (Upstream Kubeflow)"]
            NotebookCtrl["Notebook Controller<br/>Go / controller-runtime"]
            CullingCtrl["CullingReconciler<br/>(conditional: ENABLE_CULLING)"]
            NotebookCtrl --- CullingCtrl
        end

        subgraph ODHCtrl["odh-notebook-controller (ODH/RHOAI Extension)"]
            ODHController["ODH Notebook Controller<br/>Go / controller-runtime"]
            MutatingWH["Mutating Webhook<br/>/mutate-notebook-v1<br/>8443/TCP"]
            ValidatingWH["Validating Webhook<br/>/validate-notebook-v1<br/>8443/TCP"]
            ODHController --- MutatingWH
            ODHController --- ValidatingWH
        end
    end

    User["User / Dashboard"] -->|"creates"| NotebookCR["Notebook CR<br/>kubeflow.org/v1"]

    NotebookCR -->|"intercepted by"| MutatingWH
    MutatingWH -->|"injects kube-rbac-proxy sidecar<br/>resolves ImageStream tags<br/>sets proxy env vars<br/>mounts CA bundles"| NotebookCR

    NotebookCR -->|"validated by"| ValidatingWH

    NotebookCR -->|"watched by"| NotebookCtrl
    NotebookCtrl -->|"creates"| StatefulSet["StatefulSet"]
    NotebookCtrl -->|"creates"| Service["Service"]

    NotebookCR -->|"watched by"| ODHController
    ODHController -->|"creates"| HTTPRoute["HTTPRoute<br/>(per-notebook)"]
    ODHController -->|"creates"| RefGrant["ReferenceGrant<br/>(cross-namespace)"]
    ODHController -->|"creates"| NetPol["NetworkPolicy<br/>(per-notebook)"]
    ODHController -->|"creates"| KRBPResources["kube-rbac-proxy<br/>Service + ConfigMap"]

    CullingCtrl -->|"probes kernel activity"| NotebookPod["Notebook Pod<br/>8888/TCP"]
    CullingCtrl -->|"sets stop annotation"| NotebookCR

    ODHController -->|"depends on"| GatewayAPI["Gateway API<br/>(data-science-gateway)"]
    ODHController -->|"reads"| ImageStreams["OpenShift<br/>Image Streams"]
    ODHController -->|"reads"| DSPA["Data Science<br/>Pipelines Operator"]
    ODHController -->|"reads"| APIServerConfig["OpenShift<br/>APIServer Config"]
    ODHController -->|"manages"| MLflow["MLflow<br/>RoleBindings"]

    style NotebookCtrl fill:#4a90e2,color:#fff
    style CullingCtrl fill:#4a90e2,color:#fff
    style ODHController fill:#4a90e2,color:#fff
    style MutatingWH fill:#e8744f,color:#fff
    style ValidatingWH fill:#e8744f,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style GatewayAPI fill:#e8e8e8,color:#333
    style ImageStreams fill:#e8e8e8,color:#333
    style DSPA fill:#7ed321,color:#fff
    style APIServerConfig fill:#e8e8e8,color:#333
    style MLflow fill:#7ed321,color:#fff
