graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["feast-operator-controller-manager"]
        SA_Instance["feast-{instance}-sa<br/>(per FeatureStore instance)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["feast-operator-manager-rolebinding"]
        CRB_Metrics["feast-operator-metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["feast-operator-leader-election-rolebinding<br/>(ns: feast-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["feast-operator-manager-role"]
        CR_MetricsAuth["feast-operator-metrics-auth-role"]
        CR_MetricsReader["feast-operator-metrics-reader"]
        CR_Editor["feast-operator-featurestore-editor-role<br/>(aggregated to admin, edit)"]
        CR_Viewer["feast-operator-featurestore-viewer-role<br/>(aggregated to view)"]
    end

    subgraph Roles["Roles"]
        R_Leader["feast-operator-leader-election-role<br/>(ns: feast-operator-system)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["configmaps<br/>CRUD + watch"]
        Namespaces["namespaces<br/>get, list, update, watch"]
        PVCs["persistentvolumeclaims<br/>CRUD + watch"]
        Pods["pods<br/>CRUD + watch"]
        PodsExec["pods/exec<br/>create"]
        Secrets["secrets<br/>get"]
        ServiceAccounts_R["serviceaccounts<br/>CRUD + watch"]
        Services_R["services<br/>CRUD + watch"]
    end

    subgraph AppResources["Apps / Autoscaling / Batch"]
        Deployments["apps/deployments<br/>CRUD + watch"]
        HPAs["autoscaling/horizontalpodautoscalers<br/>CRUD + watch"]
        CronJobs["batch/cronjobs<br/>CRUD + watch"]
        PDBs["policy/poddisruptionbudgets<br/>CRUD + watch"]
    end

    subgraph FeastResources["Feast API Resources"]
        FeatureStores["feast.dev/featurestores<br/>CRUD + watch"]
        FeatureStoresFinalizers["feast.dev/featurestores/finalizers<br/>CRUD"]
        FeatureStoresStatus["feast.dev/featurestores/status<br/>CRUD"]
    end

    subgraph WatchedResources["Watched Resources (Read-Only)"]
        NotebookRes["kubeflow.org/notebooks<br/>get, list, watch"]
        MLflowRes["mlflow.opendatahub.io/mlflows<br/>get, list, watch"]
        APIServers["config.openshift.io/apiservers<br/>get, list, watch"]
    end

    subgraph ManagedResources["Managed Resources (CRUD)"]
        RBAC_Resources["rbac.authorization.k8s.io<br/>clusterroles, rolebindings<br/>create, delete, get, list, update"]
        RoutesRes["route.openshift.io/routes<br/>CRUD + watch"]
        ServiceMonitorsRes["monitoring.coreos.com/servicemonitors<br/>CRUD + watch"]
        SparkAppsRes["sparkoperator.k8s.io/sparkapplications<br/>create, delete, get"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io/tokenreviews<br/>create"]
        SARs["authorization.k8s.io/subjectaccessreviews<br/>create"]
        MetricsURL["/metrics (non-resource URL)<br/>get"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        Leases["coordination.k8s.io/leases<br/>CRUD"]
        LE_ConfigMaps["configmaps<br/>CRUD"]
        Events["events<br/>CRUD"]
    end

    %% Operator SA bindings
    SA_Operator -->|"bound via"| CRB_Manager
    SA_Operator -->|"bound via"| CRB_Metrics
    SA_Operator -->|"bound via"| RB_Leader

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_MetricsAuth
    RB_Leader -->|"grants"| R_Leader

    %% Manager role permissions
    CR_Manager -->|"manages"| CoreResources
    CR_Manager -->|"manages"| AppResources
    CR_Manager -->|"manages"| FeastResources
    CR_Manager -->|"watches"| WatchedResources
    CR_Manager -->|"manages"| ManagedResources
    CR_Manager -->|"creates"| TokenReviews

    %% Metrics auth role
    CR_MetricsAuth -->|"creates"| TokenReviews
    CR_MetricsAuth -->|"creates"| SARs

    %% Metrics reader
    CR_MetricsReader -->|"reads"| MetricsURL

    %% Editor/Viewer roles
    CR_Editor -->|"CRUD"| FeatureStores
    CR_Viewer -->|"read-only"| FeatureStores

    %% Leader election role
    R_Leader -->|"manages"| LeaderElectionResources

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style SA_Instance fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style R_Leader fill:#ffe6cc
    style FeatureStores fill:#7ed321,color:#fff
    style PodsExec fill:#f8cecc
    style Secrets fill:#f8cecc
