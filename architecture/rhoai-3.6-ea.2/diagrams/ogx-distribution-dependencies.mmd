graph LR
    OGX["OGX Distribution<br/>(ogx-server)"]

    %% Core Internal Dependencies
    OGX -->|"inference<br/>HTTP/HTTPS"| vLLM["vLLM<br/>(inference + embeddings)"]
    OGX -->|"persistent storage<br/>TCP/5432"| PostgreSQL["PostgreSQL<br/>(kv_postgres + sql_postgres)"]
    OGX -->|"deployment mgmt<br/>K8s API"| OGXOperator["ogx-operator"]

    %% Core Package Dependency
    OGX -->|"core framework<br/>v1.4.0+rhaiv.0"| OGXPkg["ogx<br/>(opendatahub-io fork)"]

    %% External Inference Providers (optional)
    OGX -.->|"HTTPS/443<br/>API key"| OpenAI["OpenAI API"]
    OGX -.->|"HTTPS/443<br/>API key"| Anthropic["Anthropic API"]
    OGX -.->|"HTTPS/443<br/>API key"| AzureOAI["Azure OpenAI"]
    OGX -.->|"HTTPS/443<br/>Bearer/IAM"| Bedrock["AWS Bedrock"]
    OGX -.->|"HTTPS/443<br/>API key"| WatsonX["WatsonX"]
    OGX -.->|"HTTPS/443<br/>OAuth2"| VertexAI["Vertex AI"]
    OGX -.->|"HTTPS/443<br/>API key"| Gemini["Gemini"]

    %% Vector Databases (optional)
    OGX -.->|"HTTP/gRPC<br/>Token + mTLS"| Milvus["Milvus"]
    OGX -.->|"TCP/5432<br/>Password"| pgvector["pgvector"]
    OGX -.->|"HTTP/gRPC<br/>6333-6334<br/>API key"| Qdrant["Qdrant"]

    %% External Storage & Tools (optional)
    OGX -.->|"HTTPS/443<br/>AWS creds"| S3["S3-compatible Storage"]
    OGX -.->|"HTTPS/443<br/>API key"| BraveSearch["Brave Search"]
    OGX -.->|"HTTPS/443<br/>API key"| TavilySearch["Tavily Search"]

    %% Auth & Observability
    OGX -.->|"HTTPS/443<br/>JWKS"| OAuth2["OAuth2 Issuer"]
    OGX -.->|"gRPC/HTTP<br/>OTLP"| OTel["OpenTelemetry Collector"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>/metrics"| OGX

    %% Styling
    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style PostgreSQL fill:#7ed321,stroke:#333,color:#fff
    style OGXOperator fill:#7ed321,stroke:#333,color:#fff
    style OGXPkg fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style OTel fill:#7ed321,stroke:#333,color:#fff

    style OpenAI fill:#999,stroke:#333,color:#fff
    style Anthropic fill:#999,stroke:#333,color:#fff
    style AzureOAI fill:#999,stroke:#333,color:#fff
    style Bedrock fill:#999,stroke:#333,color:#fff
    style WatsonX fill:#999,stroke:#333,color:#fff
    style VertexAI fill:#999,stroke:#333,color:#fff
    style Gemini fill:#999,stroke:#333,color:#fff

    style Milvus fill:#f5a623,stroke:#333,color:#fff
    style pgvector fill:#f5a623,stroke:#333,color:#fff
    style Qdrant fill:#f5a623,stroke:#333,color:#fff
