graph TD
    subgraph "Service Accounts (Managed Externally)"
        SA_EvalHub["eval-hub managed SA<br/>(Job Pod)"]
        SA_KFP["KFP pipeline SA<br/>(Pipeline Pods)"]
    end

    subgraph "RBAC (Not Defined in Repo - Managed by eval-hub / KFP)"
        Note["No ClusterRoles or RoleBindings<br/>defined in this repository.<br/>RBAC is managed by eval-hub<br/>and KFP infrastructure."]
    end

    subgraph "Kubernetes API Access (Required)"
        CM_Read["ConfigMap: GET<br/>trustyai-service-operator-config<br/>(pipeline image resolution)"]
        Secret_Read["Secret: GET, LIST<br/>model-auth, Data Connection<br/>(API keys, AWS credentials)"]
    end

    subgraph "Secrets Consumed"
        ModelAuth["model-auth<br/>(Volume Mount)<br/>Keys: TARGET, JUDGE, ATTACKER,<br/>EVALUATOR, SDG, TRANSLATION"]
        DataConn["Data Connection Secret<br/>(Env Injection)<br/>AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY,<br/>AWS_S3_ENDPOINT,<br/>AWS_S3_BUCKET"]
        GenericAPIKey["API_KEY<br/>(Env Var)<br/>Generic fallback key"]
        KFPToken["KFP_AUTH_TOKEN<br/>(Env Var)<br/>KFP authentication"]
    end

    subgraph "API Key Resolution Chain (13 Steps)"
        Step1["1. {ROLE}_API_KEY env var"]
        Step2["2. KFP volume-mounted secret file"]
        Step3["3. evalhub sidecar secret"]
        Step4["4. Generic API_KEY env var"]
        Step5["5. Fallback: 'DUMMY'"]

        Step1 --> Step2 --> Step3 --> Step4 --> Step5
    end

    SA_EvalHub -->|requires| CM_Read
    SA_EvalHub -->|requires| Secret_Read
    SA_KFP -->|requires| Secret_Read
    SA_EvalHub -.->|consumes| ModelAuth
    SA_EvalHub -.->|consumes| DataConn
    SA_EvalHub -.->|consumes| GenericAPIKey
    SA_EvalHub -.->|consumes| KFPToken
    SA_KFP -.->|injected via KFP| ModelAuth
    SA_KFP -.->|injected via KFP| DataConn

    ModelAuth -->|feeds into| Step1

    style SA_EvalHub fill:#4a90e2,color:#fff
    style SA_KFP fill:#4a90e2,color:#fff
    style Note fill:#fff3cd,stroke:#ffc107,color:#000
    style CM_Read fill:#d5e8d4,stroke:#82b366,color:#000
    style Secret_Read fill:#d5e8d4,stroke:#82b366,color:#000
    style ModelAuth fill:#f5a623,color:#000
    style DataConn fill:#f5a623,color:#000
    style GenericAPIKey fill:#f5a623,color:#000
    style KFPToken fill:#f5a623,color:#000
    style Step1 fill:#e8e8e8,color:#000
    style Step2 fill:#e8e8e8,color:#000
    style Step3 fill:#e8e8e8,color:#000
    style Step4 fill:#e8e8e8,color:#000
