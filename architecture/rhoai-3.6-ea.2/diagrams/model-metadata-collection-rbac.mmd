graph TD
    subgraph RuntimeSecurity["Runtime Security Profile"]
        direction TB
        Container["odh-model-metadata-collection<br/>Container"]
        User["UID: 1001<br/>(non-root)"]
        Process["Process: sleep infinity"]
        Ports["Ports: NONE"]
        Network["Network: NONE"]
    end

    subgraph SecretsBuildTime["Secrets (Build-Time Only)"]
        direction TB
        HFToken["HF_TOKEN<br/>Type: env var (.env)<br/>Purpose: HuggingFace API auth<br/>Provisioned: Manual<br/>Required: No (optional)"]
        GHToken["GITHUB_TOKEN<br/>Type: env var<br/>Purpose: GitHub API auth<br/>Provisioned: Manual / CI<br/>Required: No (optional)"]
        DockerAuth["Docker config<br/>Type: ~/.docker/config.json<br/>Purpose: Registry auth<br/>Provisioned: Manual / CI"]
        GitSecret["git_auth_secret<br/>Type: Kubernetes Secret<br/>Purpose: Tekton Git checkout<br/>Provisioned: Konflux pipeline"]
    end

    subgraph DataAccess["Data Access Control"]
        direction TB
        VolumeMount["/app/data<br/>Volume Mount"]
        KubeRBAC["Kubernetes RBAC<br/>Controls pod-level access"]
        ReadOnly["Access: Read-only<br/>by consuming pods"]
    end

    Container -->|runs as| User
    Container -->|executes| Process
    Container -->|exposes| Ports
    Container -->|uses| Network

    VolumeMount -->|protected by| KubeRBAC
    KubeRBAC -->|grants| ReadOnly

    HFToken -.->|"build-time only<br/>not in runtime image"| Container
    GHToken -.->|"build-time only<br/>not in runtime image"| Container
    DockerAuth -.->|"build-time only<br/>not in runtime image"| Container
    GitSecret -.->|"pipeline only"| Container

    style Container fill:#4a90e2,color:#fff
    style User fill:#7ed321,color:#fff
    style Process fill:#7ed321,color:#fff
    style Ports fill:#d5e8d4,stroke:#82b366
    style Network fill:#d5e8d4,stroke:#82b366
    style HFToken fill:#f5a623,color:#fff
    style GHToken fill:#f5a623,color:#fff
    style DockerAuth fill:#f5a623,color:#fff
    style GitSecret fill:#f5a623,color:#fff
    style VolumeMount fill:#dae8fc,stroke:#6c8ebf
    style KubeRBAC fill:#dae8fc,stroke:#6c8ebf
    style ReadOnly fill:#dae8fc,stroke:#6c8ebf
