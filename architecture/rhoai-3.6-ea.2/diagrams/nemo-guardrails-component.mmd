graph TB
    subgraph NemoGuardrails["NeMo Guardrails Service"]
        direction TB
        Server["FastAPI Server<br/>(api.py)<br/>Port 8000/TCP"]
        ChecksEndpoint["Checks Endpoint<br/>(checks.py)<br/>/v1/checks"]
        HeaderFwd["Header Forwarding<br/>(header_forwarding.py)<br/>contextvars-based"]

        subgraph CoreEngines["Core Engines"]
            GuardrailsEngine["Guardrails Engine<br/>(IORails / LLMRails)"]
            LLMRails["LLMRails Engine<br/>Input → Dialog → Output"]
            ColangRuntime["Colang Runtime<br/>(v1.0 / v2.x)<br/>Event-driven pipeline"]
        end

        subgraph BuiltInModels["Built-in ML Models (Offline)"]
            MiniLM["MiniLM<br/>Embeddings"]
            Arctic["Snowflake Arctic<br/>Embeddings"]
            SpaCy["spaCy<br/>NLP Pipeline"]
            NLTK["NLTK<br/>Text Processing"]
            DeBERTa["DeBERTa<br/>Classification"]
            GraniteHAP["Granite Guardian<br/>HAP Detection"]
        end

        Server -->|delegates| GuardrailsEngine
        Server -->|fork-specific| ChecksEndpoint
        Server -->|auth passthrough| HeaderFwd
        GuardrailsEngine -->|modern path| LLMRails
        LLMRails -->|evaluates rules| ColangRuntime
        LLMRails -->|local inference| BuiltInModels
    end

    Client["Client Application"] -->|POST /v1/chat/completions<br/>Bearer Token| Server
    Client -->|POST /v1/checks| ChecksEndpoint

    subgraph ExternalLLM["External LLM Providers"]
        OpenAI["OpenAI-compatible LLM<br/>443/TCP HTTPS"]
        AzureOpenAI["Azure OpenAI<br/>443/TCP HTTPS"]
    end

    HeaderFwd -->|X-Authorization → Authorization| OpenAI
    HeaderFwd -->|API key| AzureOpenAI

    HFClassifier["Remote HF Classifier<br/>HTTPS (configurable TLS/mTLS)"]
    LLMRails -->|classification| HFClassifier

    OTel["OpenTelemetry Collector<br/>(optional)"]
    Server -.->|traces| OTel

    style Server fill:#4a90e2,color:#fff
    style ChecksEndpoint fill:#4a90e2,color:#fff
    style HeaderFwd fill:#4a90e2,color:#fff
    style GuardrailsEngine fill:#4a90e2,color:#fff
    style LLMRails fill:#4a90e2,color:#fff
    style ColangRuntime fill:#4a90e2,color:#fff
    style MiniLM fill:#7ed321,color:#fff
    style Arctic fill:#7ed321,color:#fff
    style SpaCy fill:#7ed321,color:#fff
    style NLTK fill:#7ed321,color:#fff
    style DeBERTa fill:#7ed321,color:#fff
    style GraniteHAP fill:#7ed321,color:#fff
    style Client fill:#f5a623,color:#fff
    style OpenAI fill:#e8e8e8,stroke:#333
    style AzureOpenAI fill:#e8e8e8,stroke:#333
    style HFClassifier fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
