graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(OpenAI/Anthropic/MCP/A2A SDK)"]
    end

    subgraph Gateway["PRAXIS AI GATEWAY"]
        direction TB

        ProxyListener["Proxy Listener<br/>8080/TCP<br/>TLS (configurable, rustls + OpenSSL)<br/>Auth: Per filter chain"]
        AdminAPI["Admin API<br/>9901/TCP<br/>HTTP, No TLS<br/>Loopback only (127.0.0.1)"]

        subgraph FilterPipeline["Filter Pipeline (classify, route, transform)"]
            direction LR
            HeaderGuard["identity_header_guard<br/>Strip internal headers"]
            CredInject["credential_inject<br/>Upstream auth"]
            PeerIdentity["peer_identity_trust<br/>mTLS cert digest"]
            GuardrailsF["guardrails<br/>NeMo callouts"]
            TokenUsageF["token_usage<br/>metering"]
        end

        ProxyListener --> FilterPipeline
    end

    subgraph InferenceBackends["INFERENCE BACKENDS"]
        vLLM["vLLM / Chat Completions<br/>Configurable port<br/>HTTP/HTTPS, TLS configurable<br/>Bearer / mTLS"]
    end

    subgraph CloudProviders["CLOUD PROVIDER BACKENDS"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS 1.2+, AWS SigV4"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+, Azure AD"]
        VertexAI["Google Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+, GCP ADC"]
    end

    subgraph AgenticServices["AGENTIC & SAFETY SERVICES"]
        MCPServer["MCP Servers<br/>Configurable port<br/>HTTP/HTTPS, TLS configurable<br/>Bearer"]
        A2AAgents["A2A Agents<br/>Configurable port<br/>HTTP/HTTPS, TLS configurable"]
        NeMo["NeMo Guardrails<br/>Configurable port<br/>HTTP, TLS configurable"]
    end

    subgraph DataServices["DATA & STATE SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL wire, TLS configurable<br/>Password / mTLS"]
        Redis["Redis<br/>6379/TCP<br/>Redis protocol, TLS configurable"]
        Metering["External Metering<br/>Configurable port<br/>HTTP/HTTPS, TLS configurable"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        VectorStore["File Search / Vector Store<br/>443/TCP HTTPS<br/>TLS, Bearer"]
        WebSearch["Web Search Providers<br/>443/TCP HTTPS<br/>TLS, Bearer"]
    end

    %% Flows
    Client -->|"HTTPS/8080<br/>TLS (configurable)<br/>Bearer / x-api-key / mTLS"| ProxyListener

    FilterPipeline -->|"HTTP/HTTPS<br/>TLS configurable<br/>Bearer (credential_inject)"| vLLM

    FilterPipeline -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS SigV4"| Bedrock
    FilterPipeline -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure AD"| AzureOAI
    FilterPipeline -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP ADC"| VertexAI

    FilterPipeline -->|"HTTP/HTTPS<br/>TLS configurable<br/>Bearer"| MCPServer
    FilterPipeline -->|"HTTP/HTTPS<br/>TLS configurable"| A2AAgents
    FilterPipeline -->|"HTTP<br/>TLS configurable"| NeMo

    FilterPipeline -->|"PostgreSQL/5432<br/>TLS configurable<br/>Password / mTLS"| PostgreSQL
    FilterPipeline -->|"Redis/6379<br/>TLS configurable"| Redis
    FilterPipeline -->|"HTTP/HTTPS<br/>TLS configurable"| Metering

    FilterPipeline -->|"HTTPS/443<br/>TLS, Bearer"| VectorStore
    FilterPipeline -->|"HTTPS/443<br/>TLS, Bearer"| WebSearch

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef filter fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef inference fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cloud fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef agentic fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef data fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalsvc fill:#e6e6e6,stroke:#666,stroke-width:2px

    class Client external
    class ProxyListener,AdminAPI gateway
    class HeaderGuard,CredInject,PeerIdentity,GuardrailsF,TokenUsageF filter
    class vLLM inference
    class Bedrock,AzureOAI,VertexAI cloud
    class MCPServer,A2AAgents,NeMo agentic
    class PostgreSQL,Redis,Metering data
    class VectorStore,WebSearch externalsvc
