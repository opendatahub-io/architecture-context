graph TB
    subgraph OGX["OGX Distribution (ogx-server)"]
        direction TB
        Server["OGX Server<br/>Python 3.12<br/>Port 8321/TCP"]
        InferenceAPI["/v1/inference/*"]
        ResponsesAPI["/v1/responses/*"]
        MessagesAPI["/v1/messages/*"]
        VectorAPI["/v1/vector_io/*"]
        FilesAPI["/v1/files/*"]
        FileProcessorsAPI["/v1/file_processors/*"]
        ToolRuntimeAPI["/v1/tool_runtime/*"]
        BatchesAPI["/v1/batches/*"]
        MetricsEP["/metrics"]

        Server --> InferenceAPI
        Server --> ResponsesAPI
        Server --> MessagesAPI
        Server --> VectorAPI
        Server --> FilesAPI
        Server --> FileProcessorsAPI
        Server --> ToolRuntimeAPI
        Server --> BatchesAPI
        Server --> MetricsEP
    end

    subgraph BuildPipeline["Build Pipeline"]
        GenConfig["gen_config.py"]
        GenContainerfile["gen_containerfile.py"]
        GenLockfile["gen_lockfile.py"]
        BuildYaml["build.yaml<br/>(source of truth)"]

        BuildYaml --> GenConfig
        BuildYaml --> GenContainerfile
        BuildYaml --> GenLockfile
    end

    subgraph Entrypoint["Container Entrypoint"]
        SecretResolver["Secret File Resolution<br/>(18 env vars with _FILE)"]
        OTelWrap["Optional OTel Wrapping"]
        ConfigSelect["Config Path Selection"]

        SecretResolver --> ConfigSelect
        ConfigSelect --> OTelWrap
    end

    Modelcar["Modelcar OCI Image<br/>(docling, HF, tiktoken)"]

    Client["Client"] -->|"HTTP 8321/TCP<br/>OAuth2 JWT (conditional)"| Server

    %% Inference providers
    InferenceAPI -->|"HTTP/HTTPS<br/>Bearer token"| vLLM["vLLM Endpoint"]
    InferenceAPI -->|"HTTPS/443<br/>API key"| OpenAI["OpenAI API"]
    InferenceAPI -->|"HTTPS/443<br/>API key"| Anthropic["Anthropic API"]
    InferenceAPI -->|"HTTPS/443<br/>API key"| AzureOAI["Azure OpenAI"]
    MessagesAPI -->|"HTTPS/443<br/>API key"| Anthropic

    %% Vector databases
    VectorAPI -->|"HTTP/gRPC<br/>Token + mTLS"| Milvus["Milvus"]
    VectorAPI -->|"TCP 5432<br/>Password"| pgvector["pgvector"]
    VectorAPI -->|"HTTP/gRPC 6333-6334<br/>API key"| Qdrant["Qdrant"]

    %% Storage
    Server -->|"TCP 5432<br/>Username/password"| PostgreSQL["PostgreSQL<br/>(kv_postgres + sql_postgres)"]
    FilesAPI -->|"HTTPS/443<br/>AWS IAM"| S3["S3-compatible Storage"]

    %% Tools
    ToolRuntimeAPI -->|"HTTPS/443<br/>API key"| BraveSearch["Brave Search"]
    ToolRuntimeAPI -->|"HTTPS/443<br/>API key"| TavilySearch["Tavily Search"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"HTTP scrape"| MetricsEP

    %% Operator
    OGXOperator["ogx-operator"] -->|"manages deployment"| OGX

    %% Build artifacts
    Modelcar -->|"multi-stage build"| OGX
    GenConfig -->|"generates config.yaml"| OGX
    Entrypoint -->|"launches"| Server

    %% Styling
    style Server fill:#4a90e2,stroke:#333,stroke-width:2px
    style OGX fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style BuildPipeline fill:#f3e5f5,stroke:#7b1fa2,stroke-width:1px
    style Entrypoint fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px
    style Client fill:#fff3e0,stroke:#e65100
    style PostgreSQL fill:#fff9c4,stroke:#f9a825
    style vLLM fill:#c8e6c9,stroke:#388e3c
    style OGXOperator fill:#c8e6c9,stroke:#388e3c
    style Prometheus fill:#c8e6c9,stroke:#388e3c
    style OpenAI fill:#e0e0e0,stroke:#616161
    style Anthropic fill:#e0e0e0,stroke:#616161
    style AzureOAI fill:#e0e0e0,stroke:#616161
    style Milvus fill:#e0e0e0,stroke:#616161
    style pgvector fill:#e0e0e0,stroke:#616161
    style Qdrant fill:#e0e0e0,stroke:#616161
    style S3 fill:#e0e0e0,stroke:#616161
    style BraveSearch fill:#e0e0e0,stroke:#616161
    style TavilySearch fill:#e0e0e0,stroke:#616161
    style Modelcar fill:#ffccbc,stroke:#bf360c
