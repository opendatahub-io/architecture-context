graph TB
    subgraph WorkbenchesOperator["Workbenches Operator"]
        direction TB
        Controller["WorkbenchesReconciler<br/>(controller-runtime)"]
        ConnectionWH["Connection Webhook<br/>(mutating admission)"]
        HardwareWH["Hardware Profile Webhook<br/>(mutating admission)"]
        ConversionWH["CRD Conversion Webhook"]
        TLSDetect["TLS Provider<br/>Auto-Detection"]
        ManifestRenderer["Manifest Renderer<br/>(Kustomize/SSA)"]

        Controller --> ManifestRenderer
        TLSDetect -->|configures TLS| ConnectionWH
        TLSDetect -->|configures TLS| HardwareWH
        TLSDetect -->|configures TLS| ConversionWH
    end

    %% CRDs
    WorkbenchesCR["Workbenches CR<br/>(cluster-scoped singleton)"]
    NotebookCR["Notebook CR<br/>(kubeflow.org/v1)"]
    HardwareProfileCR["HardwareProfile CR<br/>(infrastructure.opendatahub.io)"]

    %% Flows
    Orchestrator["Platform Orchestrator"] -->|creates/updates| WorkbenchesCR
    WorkbenchesCR -->|watched by| Controller
    Controller -->|renders & applies| OperandResources["Operand Resources<br/>(Deployments, RBAC,<br/>Services, etc.)"]
    Controller -->|watches availability| OperandDeployments["Operand Deployments"]

    User["Data Scientist"] -->|creates| NotebookCR
    NotebookCR -->|intercepted by| ConnectionWH
    NotebookCR -->|intercepted by| HardwareWH
    ConnectionWH -->|injects secrets| NotebookCR
    HardwareWH -->|reads| HardwareProfileCR
    HardwareWH -->|applies resources,<br/>tolerations, nodeSelector| NotebookCR

    ManifestRenderer -->|reads| Manifests["/opt/manifests<br/>(committed kustomize)"]
    ManifestRenderer -->|overlays| RelatedImages["RELATED_IMAGE_*<br/>env vars"]

    %% External dependencies
    Controller -->|depends on| KubeAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|creates| ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]
    Controller -->|manages| ImageStreams["OpenShift ImageStreams"]
    TLSDetect -->|probes| ServiceCA["OpenShift service-CA"]
    TLSDetect -->|fallback| CertManager["cert-manager"]

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style ConnectionWH fill:#4a90e2,color:#fff
    style HardwareWH fill:#4a90e2,color:#fff
    style ConversionWH fill:#4a90e2,color:#fff
    style TLSDetect fill:#4a90e2,color:#fff
    style ManifestRenderer fill:#4a90e2,color:#fff
    style WorkbenchesCR fill:#f5a623,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style HardwareProfileCR fill:#f5a623,color:#fff
    style Orchestrator fill:#7ed321,color:#fff
    style ServiceCA fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style KubeAPI fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#e8e8e8,stroke:#333
    style ImageStreams fill:#e8e8e8,stroke:#333
