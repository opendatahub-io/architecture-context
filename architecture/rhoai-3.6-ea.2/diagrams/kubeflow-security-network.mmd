graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>Namespace: openshift-ingress<br/>443/TCP HTTPS TLS 1.2+<br/>Per-notebook HTTPRoute"]
    end

    subgraph NotebookPod["NOTEBOOK POD (Per-Namespace)"]
        direction TB
        KRBP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS TLS 1.2+<br/>TokenReview + SubjectAccessReview"]
        Notebook["Notebook Container<br/>8888/TCP HTTP<br/>No Auth (localhost)"]
    end

    subgraph ControllerPlane["CONTROLLER PLANE (System Namespace)"]
        direction TB
        NbCtrl["notebook-controller<br/>Health: 8081/TCP HTTP<br/>Metrics: 8443/TCP HTTPS<br/>SA: notebook-controller-service-account"]
        ODHCtrl["odh-notebook-controller<br/>Health: 8081/TCP HTTP<br/>Metrics: 8080/TCP HTTPS<br/>Webhook: 8443/TCP HTTPS<br/>SA: manager"]
        Culler["CullingReconciler<br/>(conditional)"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
        ServiceCA["service-ca-operator<br/>Auto-provision TLS certs"]
        APIServerCfg["OpenShift APIServer Config<br/>TLS security profile"]
        ImageStreams["OpenShift Image Streams<br/>Tag → digest resolution"]
    end

    subgraph PlatformServices["INTERNAL PLATFORM SERVICES"]
        DSPA["Data Science Pipelines<br/>CRD read"]
        MLflow["MLflow Operator<br/>ClusterRole read"]
        Prometheus["Prometheus<br/>Metrics scrape"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway

    %% Ingress → Notebook Pod
    Gateway -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token (forwarded)"| KRBP

    %% kube-rbac-proxy → Notebook
    KRBP -->|"HTTP/8888<br/>No encryption<br/>None (localhost)"| Notebook

    %% kube-rbac-proxy → K8s API (auth check)
    KRBP -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>TokenReview + SAR"| K8sAPI

    %% Controllers → K8s API
    NbCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ODHCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% K8s API → Webhook
    K8sAPI -->|"HTTPS/8443<br/>TLS 1.2+<br/>Admission"| ODHCtrl

    %% Culling → Notebook
    Culler -->|"HTTP/8888<br/>No encryption<br/>Kernel probe"| Notebook

    %% ODH → Platform services
    ODHCtrl -.->|"CRD read"| DSPA
    ODHCtrl -.->|"ClusterRole read"| MLflow
    ODHCtrl -.->|"API read"| ImageStreams
    NbCtrl -.->|"API read"| APIServerCfg
    ODHCtrl -.->|"API read"| APIServerCfg

    %% Prometheus scrape
    Prometheus -.->|"HTTPS/8443<br/>TLS 1.2+"| NbCtrl
    Prometheus -.->|"HTTPS/8080<br/>TLS 1.2+"| ODHCtrl

    %% service-ca
    ServiceCA -.->|"Provision TLS cert"| KRBP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef notebookpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class Gateway ingress
    class KRBP,Notebook notebookpod
    class NbCtrl,ODHCtrl,Culler controller
    class K8sAPI,ServiceCA,APIServerCfg,ImageStreams cluster
    class DSPA,MLflow,Prometheus platform
