graph TB
    subgraph BuildSystem["Notebooks Build System (Container Image Factory)"]
        direction TB

        subgraph JupyterImages["Jupyter Notebook Images"]
            Minimal["jupyter/minimal<br/>JupyterLab 4.5<br/>Python 3.12"]
            DataScience["jupyter/datascience<br/>NumPy, Pandas,<br/>scikit-learn"]
            PyTorch["jupyter/pytorch<br/>PyTorch 2.13.0<br/>CUDA support"]
            PyTorchLLM["jupyter/pytorch+llmcompressor<br/>LLM Compressor 0.13.0<br/>Transformers 5.14.1"]
            TensorFlow["jupyter/tensorflow<br/>TensorFlow 2.21.0"]
            TrustyAI["jupyter/trustyai<br/>TrustyAI 0.6.4"]
            ROCmPT["jupyter/rocm/pytorch<br/>ROCm 7.14"]
            ROCmTF["jupyter/rocm/tensorflow<br/>ROCm 7.14"]
        end

        subgraph CodeServerImages["Code-Server Images"]
            CSBaseline["codeserver-baseline<br/>VS Code in browser"]
            CSFull["codeserver<br/>Data science packages"]
            CSCheCode["codeserver/che-code<br/>Eclipse Che variant"]
        end

        subgraph RuntimeImages["Elyra Pipeline Runtime Images"]
            RTMinimal["runtimes/minimal"]
            RTDataScience["runtimes/datascience"]
            RTPyTorch["runtimes/pytorch"]
            RTLLMComp["runtimes/pytorch+llmcompressor"]
            RTTensorFlow["runtimes/tensorflow"]
            RTRocmPT["runtimes/rocm-pytorch"]
            RTRocmTF["runtimes/rocm-tensorflow"]
        end

        subgraph BuildTools["Build Tools"]
            BuildInputs["scripts/buildinputs<br/>Go CLI"]
            CheckPayload["scripts/check-payload<br/>FIPS validation"]
        end
    end

    subgraph BaseImages["AIPCC Base Images"]
        CPU["CPU Base<br/>quay.io/aipcc/base-images/<br/>cpu-el9.8:3.6.0"]
        CUDA["CUDA 13.0 Base<br/>quay.io/aipcc/base-images/<br/>cuda-13.0-el9.8:3.6.0"]
        ROCm["ROCm 7.14 Base<br/>quay.io/aipcc/base-images/<br/>rocm-7.14-el9.8:3.6.0"]
    end

    subgraph HermeticBuild["Hermetic Build Pipeline"]
        RPMLock["rpms.lock.yaml<br/>OS packages"]
        PyLock["pylock.*.toml<br/>Python deps"]
        Cachi2["Hermeto/Cachi2<br/>Prefetch"]
    end

    subgraph PlatformIntegration["Platform Integration"]
        Operator["ODH Operator"]
        Dashboard["ODH Dashboard"]
        NotebookCtrl["ODH Notebook Controller"]
    end

    subgraph Manifests["Deployment Manifests"]
        ImageStreams["ImageStream definitions<br/>manifests/rhoai/base/"]
        ParamsEnv["params.env<br/>SHA256 digest-pinned refs"]
    end

    %% Base image relationships
    CPU --> Minimal
    CPU --> CSBaseline
    CPU --> RTMinimal
    CUDA --> PyTorch
    CUDA --> TensorFlow
    ROCm --> ROCmPT
    ROCm --> ROCmTF

    %% Hermetic build inputs
    RPMLock --> BuildSystem
    PyLock --> BuildSystem
    Cachi2 --> BuildSystem

    %% Build output to manifests
    BuildSystem -->|publishes to<br/>registry.redhat.io/rhoai/| ImageStreams
    ParamsEnv -->|digest refs| ImageStreams

    %% Platform consumes manifests
    Operator -->|deploys| ImageStreams
    Dashboard -->|discovers via annotations| ImageStreams
    NotebookCtrl -->|injects OAuth proxy,<br/>CA bundles, ConfigMaps| UserPod["Workbench Pod"]

    %% Styling
    style BuildSystem fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style JupyterImages fill:#e8f5e9,stroke:#2e7d32
    style CodeServerImages fill:#fff3e0,stroke:#e65100
    style RuntimeImages fill:#f3e5f5,stroke:#6a1b9a
    style BaseImages fill:#fce4ec,stroke:#b71c1c
    style HermeticBuild fill:#fff8e1,stroke:#f9a825
    style PlatformIntegration fill:#e0f2f1,stroke:#00695c
    style Manifests fill:#f5f5f5,stroke:#616161
    style Operator fill:#4a90e2,color:#fff
    style Dashboard fill:#4a90e2,color:#fff
    style NotebookCtrl fill:#4a90e2,color:#fff
