graph LR
    Trainer["Kubeflow Trainer<br/>Operator"]

    %% Internal Platform Dependencies
    Trainer -->|"CRD CRUD + Watch<br/>workload primitive"| JobSet["JobSet<br/>jobset.x-k8s.io<br/>v0.12.0"]
    Trainer -->|"PodGroup CRD<br/>gang scheduling"| SchedulerPlugins["Scheduler Plugins<br/>scheduling.x-k8s.io<br/>v0.35.4"]
    Trainer -->|"PodGroup CRD<br/>gang scheduling"| Volcano["Volcano<br/>scheduling.volcano.sh<br/>v1.13.1"]
    Trainer -->|"Read + Watch<br/>TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]

    %% External Dependencies (build/runtime)
    Trainer -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    Trainer -->|"K8s API client"| K8sClient["k8s.io/client-go<br/>v0.37.0"]
    Trainer -->|"webhook TLS certs"| CertController["cert-controller<br/>v0.16.0"]
    Trainer -->|"OIDC verification<br/>status server"| GoOIDC["go-oidc<br/>v3.20.0"]
    Trainer -->|"OpenShift TLS"| CtrlRuntimeCommon["controller-runtime-common<br/>(OpenShift)"]

    %% Integration Points (other components calling Trainer)
    Prometheus["Prometheus<br/>monitoring.coreos.com"] -->|"ServiceMonitor<br/>scrape 8443/TCP"| Trainer

    %% Init container dependencies
    subgraph InitDeps["Init Container Dependencies"]
        HFHub["huggingface-hub<br/>Python >=0.27"]
        OpenDAL["opendal<br/>Python >=0.46"]
        K8sPy["kubernetes<br/>Python >=27.2"]
    end
    Trainer -.->|"dataset/model init"| InitDeps

    %% External Services
    Trainer -->|"CRD operations"| K8sAPI["Kubernetes API<br/>6443/TCP"]

