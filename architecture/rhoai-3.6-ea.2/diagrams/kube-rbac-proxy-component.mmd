graph TB
    subgraph "kube-rbac-proxy Sidecar"
        direction TB
        TLSTermination["TLS Termination<br/>8443/TCP, TLS 1.2+<br/>CertReloader hot-reload"]
        AuthnFilter["Authentication Filter"]
        AuthzChain["Authorization Chain"]
        UpstreamProxy["Upstream Reverse Proxy"]
        AuditLogger["Audit Logger<br/>OCSF 1.9.0"]

        TLSTermination --> AuthnFilter
        AuthnFilter --> AuthzChain
        AuthzChain --> UpstreamProxy
        AuthzChain -.->|"log events"| AuditLogger
    end

    subgraph "Authentication Methods"
        TokenReview["TokenReview<br/>(Bearer Token)"]
        OIDC["OIDC JWT<br/>(go-oidc)"]
        ClientTLS["Client TLS<br/>(x509 Cert)"]
    end

    AuthnFilter -->|"validate"| TokenReview
    AuthnFilter -->|"validate"| OIDC
    AuthnFilter -->|"validate"| ClientTLS

    subgraph "Authorization Methods"
        HardcodedAuth["Hardcoded Metrics Authorizer<br/>prometheus-k8s SA → GET /metrics"]
        StaticAuth["Static Authorizer<br/>Format1 + Format2 Rules"]
        SARAuth["SubjectAccessReview<br/>Kubernetes RBAC"]
    end

    AuthzChain -->|"1. check"| HardcodedAuth
    AuthzChain -->|"2. check"| StaticAuth
    AuthzChain -->|"3. delegate"| SARAuth

    Client["Client / Prometheus"] -->|"HTTPS/8443"| TLSTermination
    UpstreamProxy -->|"HTTP localhost"| Upstream["Upstream Service<br/>(metrics, API)"]

    TokenReview -->|"REST API"| K8sAPI["Kubernetes API Server<br/>6443/TCP"]
    SARAuth -->|"REST API"| K8sAPI
    OIDC -->|"HTTPS/443"| OIDCProvider["OIDC Provider"]

    style TLSTermination fill:#4a90e2,color:#fff
    style AuthnFilter fill:#4a90e2,color:#fff
    style AuthzChain fill:#4a90e2,color:#fff
    style UpstreamProxy fill:#4a90e2,color:#fff
    style AuditLogger fill:#4a90e2,color:#fff
    style TokenReview fill:#f5a623,color:#fff
    style OIDC fill:#f5a623,color:#fff
    style ClientTLS fill:#f5a623,color:#fff
    style HardcodedAuth fill:#d0021b,color:#fff
    style StaticAuth fill:#f5a623,color:#fff
    style SARAuth fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8
    style OIDCProvider fill:#e8e8e8
    style Client fill:#7ed321,color:#fff
    style Upstream fill:#7ed321,color:#fff
