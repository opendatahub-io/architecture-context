graph TB
    subgraph Operator["llm-d-batch-gateway-operator"]
        direction TB
        Reconciler["LLMBatchGatewayReconciler<br/>(Primary Controller)"]
        MetricsCtrl["MetricsController<br/>(Self-Monitoring)"]
        SecurityWatcher["SecurityProfileWatcher<br/>(TLS Profile)"]
        HelmRenderer["HelmRenderer<br/>(In-Process Helm v3)"]

        Reconciler -->|renders charts via| HelmRenderer
        SecurityWatcher -->|triggers restart on<br/>profile change| Reconciler
    end

    User[User / Platform Admin] -->|creates| BGCR["LLMBatchGateway CR<br/>(batch.llm-d.ai/v1alpha1)"]
    BGCR -->|watched by| Reconciler

    subgraph RenderedStack["Rendered Batch Gateway Stack"]
        direction TB
        APIServer["API Server<br/>(Batch Job Submissions)"]
        Processor["Processor<br/>(Inference Dispatch)"]
        GC["Garbage Collector<br/>(Job/File Expiry)"]
        AsyncProcessor["Async Processor<br/>(Optional - Redis Bridge)"]
    end

    HelmRenderer -->|renders| RenderedStack

    Reconciler -->|SSA apply| K8sAPI["Kubernetes API<br/>(6443/TCP)"]
    MetricsCtrl -->|ensures| MonResources["ServiceMonitor<br/>PodMonitor<br/>PrometheusRule"]

    Reconciler -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    Reconciler -->|creates| Certificate["Certificate<br/>(cert-manager)"]
    Reconciler -->|checks| RefGrant["ReferenceGrant<br/>(Cross-NS Secrets)"]
    SecurityWatcher -->|watches| OSAPIServer["OpenShift APIServer<br/>(TLS Profile)"]

    ParentOp["opendatahub-operator /<br/>ai-gateway-operator"] -->|injects images via<br/>env vars| Operator

    style Reconciler fill:#4a90e2,color:#fff
    style MetricsCtrl fill:#4a90e2,color:#fff
    style SecurityWatcher fill:#4a90e2,color:#fff
    style HelmRenderer fill:#4a90e2,color:#fff
    style BGCR fill:#f5a623,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style Processor fill:#7ed321,color:#fff
    style GC fill:#7ed321,color:#fff
    style AsyncProcessor fill:#7ed321,color:#fff
    style HTTPRoute fill:#e8e8e8
    style Certificate fill:#e8e8e8
    style RefGrant fill:#e8e8e8
    style OSAPIServer fill:#e8e8e8
    style MonResources fill:#e8e8e8
    style ParentOp fill:#9b59b6,color:#fff
