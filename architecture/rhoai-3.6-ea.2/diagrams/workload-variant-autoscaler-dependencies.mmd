graph LR
    WVA["WVA Controller<br/>workload-variant-autoscaler"]

    %% Internal Platform Dependencies
    WVA -->|"queries metrics<br/>HTTPS/9091"| Prometheus["Prometheus /<br/>Thanos Querier"]
    WVA -->|"watches InferencePools"| GatewayAPIExt["gateway-api-inference-<br/>extension v1.2.1"]
    WVA -.->|"watches ScaledObjects<br/>(conditional)"| KEDA["KEDA v2.18.3"]
    WVA -.->|"scales multi-pod<br/>(conditional)"| LWS["LeaderWorkerSet v0.8.0"]
    WVA -->|"ServiceMonitor CRD"| PromOperator["prometheus-operator"]
    WVA -.->|"GPU inventory<br/>(Node API read)"| GPUOperator["NVIDIA GPU Operator"]

    %% Indirect dependency
    WVA -.->|"reads EPP metrics<br/>(via Prometheus)"| EPP["Endpoint Picker<br/>(EPP)"]

    %% External Infrastructure
    WVA -->|"watch/scale resources<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]

    %% Key Libraries
    WVA -->|framework| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    WVA -->|noise reduction| KalmanFilter["kalman-filter<br/>v0.1.2"]
    WVA -->|config mgmt| Viper["Viper v1.21.0"]

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Prometheus fill:#7ed321,stroke:#333
    style GatewayAPIExt fill:#7ed321,stroke:#333
    style KEDA fill:#7ed321,stroke:#333,stroke-dasharray: 5 5
    style LWS fill:#7ed321,stroke:#333,stroke-dasharray: 5 5
    style PromOperator fill:#7ed321,stroke:#333
    style GPUOperator fill:#7ed321,stroke:#333,stroke-dasharray: 5 5
    style EPP fill:#7ed321,stroke:#333,stroke-dasharray: 5 5
    style K8sAPI fill:#f5a623,stroke:#333
    style ControllerRuntime fill:#999,stroke:#333
    style KalmanFilter fill:#999,stroke:#333
    style Viper fill:#999,stroke:#333
