graph TB
    subgraph MLServerPod["MLServer Pod (KServe InferenceService)"]
        direction TB

        subgraph AuthProxy["Authentication Layer"]
            KubeRBACProxy["kube-rbac-proxy<br/>443/TCP HTTPS<br/>OpenShift OAuth"]
        end

        subgraph Core["MLServer Core"]
            RESTServer["REST Server<br/>(FastAPI/uvicorn)<br/>8080/TCP HTTP"]
            GRPCServer["gRPC Server<br/>(grpcio)<br/>8081/TCP h2c"]
            MetricsServer["Metrics Server<br/>(starlette-exporter)<br/>8082/TCP HTTP"]
            DataPlane["DataPlane Handler<br/>V2 Inference Protocol"]
            ModelManager["Model Manager<br/>Multi-model serving"]
            TrustedRuntimes["Trusted Runtimes<br/>Allowlist Enforcer"]
            AdaptiveBatcher["Adaptive Batcher<br/>(optional)"]
        end

        subgraph Runtimes["Pluggable Runtimes (MLModel interface)"]
            direction LR
            SKLearn["mlserver-sklearn<br/>Scikit-Learn"]
            XGBoost["mlserver-xgboost<br/>XGBoost"]
            LightGBM["mlserver-lightgbm<br/>LightGBM"]
            ONNXCPU["mlserver-onnx<br/>ONNX (CPU)"]
            ONNXCUDA["mlserver-onnx<br/>ONNX (CUDA)"]
        end
    end

    Client["External Client"] -->|"HTTPS/443<br/>Bearer Token"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8080"| RESTServer
    KubeRBACProxy -->|"gRPC/8081"| GRPCServer
    RESTServer --> DataPlane
    GRPCServer --> DataPlane
    DataPlane --> ModelManager
    ModelManager -->|validates| TrustedRuntimes
    ModelManager --> AdaptiveBatcher
    AdaptiveBatcher --> SKLearn
    AdaptiveBatcher --> XGBoost
    AdaptiveBatcher --> LightGBM
    AdaptiveBatcher --> ONNXCPU
    AdaptiveBatcher --> ONNXCUDA

    Prometheus["Prometheus"] -->|"HTTP/8082<br/>scrape /metrics"| MetricsServer

    ModelStorage["/mnt/models<br/>Model Artifacts"] -.->|volume mount| ModelManager

    KServe["KServe Controller"] -.->|manages pod lifecycle| MLServerPod

    style KubeRBACProxy fill:#e67e22,stroke:#333,stroke-width:2px
    style RESTServer fill:#4a90e2,stroke:#333
    style GRPCServer fill:#4a90e2,stroke:#333
    style MetricsServer fill:#4a90e2,stroke:#333
    style DataPlane fill:#4a90e2,stroke:#333
    style ModelManager fill:#4a90e2,stroke:#333
    style TrustedRuntimes fill:#e74c3c,stroke:#333
    style AdaptiveBatcher fill:#4a90e2,stroke:#333
    style SKLearn fill:#7ed321,stroke:#333
    style XGBoost fill:#7ed321,stroke:#333
    style LightGBM fill:#7ed321,stroke:#333
    style ONNXCPU fill:#7ed321,stroke:#333
    style ONNXCUDA fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style Prometheus fill:#f5a623,stroke:#333
    style ModelStorage fill:#ddd,stroke:#333
    style KServe fill:#9b59b6,stroke:#333
