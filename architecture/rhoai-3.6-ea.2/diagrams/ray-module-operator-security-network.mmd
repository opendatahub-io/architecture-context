graph TB
    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Operator["Namespace: ray-module-operator-system"]
            Controller["ray-module-operator<br/>controller-manager<br/>SA: ray-module-operator-controller-manager<br/>Image: odh-ray-module-operator:latest<br/>FIPS: strictfipsruntime + PQC base"]

            HealthProbe["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
            MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TokenReview + SAR"]

            Controller --- HealthProbe
            Controller --- MetricsEndpoint
        end

        subgraph K8sAPI["Kubernetes API Server"]
            APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph NS_Apps["Namespace: applications"]
            KubeRayDeploy["KubeRay Operator<br/>(deployed by SSA)"]
            RayConfig["odh-ray-config<br/>ConfigMap"]
        end

        subgraph ClusterScoped["Cluster-Scoped Resources"]
            RayCR["Ray CR<br/>(default-ray)<br/>Cluster-scoped"]
            KubeRayCRDs["KubeRay CRDs<br/>(RayCluster, RayJob,<br/>RayService, RayCronJob)"]
            Webhooks["Admission Webhooks<br/>(Mutating + Validating)"]
            NotebookRole["ray ClusterRole<br/>(Notebook access)"]
            SCC["SecurityContextConstraints<br/>(OpenShift only)"]
        end
    end

    subgraph External["EXTERNAL DEPENDENCIES (Build-time / CRD)"]
        CertManager["cert-manager<br/>(CRD prerequisite)"]
        GatewayAPI["Gateway API<br/>(CRD CRUD)"]
        PlatformUtils["odh-platform-utilities<br/>(Go library, build-time)"]
    end

    %% Flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| APIServer
    APIServer -->|"Watch events"| Controller

    Controller -->|"SSA deploy"| KubeRayDeploy
    Controller -->|"Watch"| RayConfig
    Controller -->|"Watch/Update"| RayCR
    Controller -->|"Manage"| KubeRayCRDs
    Controller -->|"Manage"| Webhooks
    Controller -->|"Create"| NotebookRole
    Controller -->|"Manage<br/>(OpenShift only)"| SCC

    Controller -.->|"Validates CRDs present"| CertManager
    Controller -.->|"Manages routing resources"| GatewayAPI

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef endpoint fill:#6baed6,stroke:#333,stroke-width:1px,color:#fff
    classDef api fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef resource fill:#f5a623,stroke:#d79b00,stroke-width:1px,color:#fff
    classDef external fill:#e8e8e8,stroke:#999,stroke-width:1px
    classDef deployed fill:#7ed321,stroke:#5cb85c,stroke-width:1px,color:#fff

    class Controller operator
    class HealthProbe,MetricsEndpoint endpoint
    class APIServer api
    class RayCR,KubeRayCRDs,Webhooks,NotebookRole,SCC,RayConfig resource
    class CertManager,GatewayAPI,PlatformUtils external
    class KubeRayDeploy deployed
