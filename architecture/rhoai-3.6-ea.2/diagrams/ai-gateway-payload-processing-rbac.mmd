graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["{name}-{release}"]
    end

    subgraph Bindings["ClusterRole Binding"]
        CRB["{release}-externalmodels-reader<br/>(ClusterRoleBinding or RoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRole"]
        CR["{release}-externalmodels-reader"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["core<br/>secrets"]
        Services["core<br/>services"]
    end

    subgraph LegacyResources["Legacy CRD Resources"]
        LegacyEM["maas.opendatahub.io<br/>externalmodels"]
    end

    subgraph InferenceResources["Inference CRD Resources"]
        ExtProviders["inference.opendatahub.io<br/>externalproviders"]
        ExtModels["inference.opendatahub.io<br/>externalmodels"]
        ExtProvStatus["inference.opendatahub.io<br/>externalproviders/status"]
        ExtModelStatus["inference.opendatahub.io<br/>externalmodels/status"]
        ExtProvFin["inference.opendatahub.io<br/>externalproviders/finalizers"]
        ExtModelFin["inference.opendatahub.io<br/>externalmodels/finalizers"]
    end

    subgraph GatewayResources["Gateway API Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
    end

    subgraph IstioResources["Istio Networking Resources"]
        ServiceEntries["networking.istio.io<br/>serviceentries"]
        DestRules["networking.istio.io<br/>destinationrules"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|"get, list, watch"| Secrets
    CR -->|"get, list, watch,<br/>create, update, delete"| Services
    CR -->|"get, list, watch"| LegacyEM
    CR -->|"get, list, watch,<br/>create, update"| ExtProviders
    CR -->|"get, list, watch,<br/>create, update"| ExtModels
    CR -->|"get, update, patch"| ExtProvStatus
    CR -->|"get, update, patch"| ExtModelStatus
    CR -->|"update"| ExtProvFin
    CR -->|"update"| ExtModelFin
    CR -->|"get, list, watch,<br/>create, update, delete"| HTTPRoutes
    CR -->|"get, list, watch,<br/>create, update, delete"| ServiceEntries
    CR -->|"get, list, watch,<br/>create, update, delete"| DestRules

    style SA fill:#4a90e2,color:#fff
    style CRB fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style Secrets fill:#e6b8af
    style Services fill:#e6b8af
    style LegacyEM fill:#d5a6bd
    style ExtProviders fill:#7ed321,color:#fff
    style ExtModels fill:#7ed321,color:#fff
    style ExtProvStatus fill:#b6d7a8
    style ExtModelStatus fill:#b6d7a8
    style ExtProvFin fill:#b6d7a8
    style ExtModelFin fill:#b6d7a8
    style HTTPRoutes fill:#a4c2f4
    style ServiceEntries fill:#ffe599
    style DestRules fill:#ffe599
