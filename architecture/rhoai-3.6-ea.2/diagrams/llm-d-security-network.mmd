graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        Gateway["llm-d-inference-gateway<br/>80/TCP HTTP<br/>No TLS<br/>allowedRoutes: All"]
        HTTPRoute["HTTPRoute<br/>/v1/* → InferencePool"]
    end

    subgraph Routing["ROUTING LAYER (Cluster Internal)"]
        EPP["llm-d-router EPP<br/>ClusterIP 80→8081/TCP<br/>HTTP, No TLS<br/>Plugin: prefix-cache, load-aware"]
    end

    subgraph ModelServers["MODEL SERVER LAYER (Per-Namespace)"]
        direction TB

        subgraph NS_Guide["Namespace: llm-d-{guide-name}"]
            DecodePod["Decode Pod<br/>SA: sa<br/>8000/TCP HTTP<br/>No TLS, No Auth"]
            PrefillPod["Prefill Pod<br/>SA: sa<br/>8000/TCP HTTP + 5600/TCP NIXL<br/>No TLS, No Auth"]
            RDMASidecar["RDMA Tools Sidecar<br/>Diagnostic only<br/>No ports exposed"]
            RouteSidecar["Routing Sidecar<br/>In-pod communication"]
        end
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes :8000/metrics<br/>HTTP, No Auth"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC OTLP<br/>No TLS, 10% sampling"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer HF_TOKEN"]
        GHCR["ghcr.io<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Public access"]
        PyPI["PyPI / PyTorch Index<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Build-time only"]
    end

    %% Traffic flows
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Gateway
    Gateway --- HTTPRoute
    HTTPRoute -->|"HTTP/8081<br/>No TLS<br/>No Auth"| EPP
    EPP -->|"HTTP/8000<br/>No TLS<br/>No Auth"| DecodePod
    EPP -->|"HTTP/8000<br/>No TLS<br/>No Auth"| PrefillPod
    PrefillPod -->|"TCP/5600<br/>NIXL KV-Cache<br/>No TLS, No Auth"| DecodePod

    %% Observability
    DecodePod -.->|"HTTP/8000<br/>/metrics"| Prometheus
    DecodePod -.->|"gRPC/4317<br/>OTLP traces"| OTel

    %% Egress
    DecodePod -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HFHub
    PrefillPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HFHub

    %% Styling - trust zones
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef routing fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef modelserver fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway,HTTPRoute ingress
    class EPP routing
    class DecodePod,PrefillPod,RDMASidecar,RouteSidecar modelserver
    class Prometheus,OTel observability
    class HFHub,GHCR,PyPI externalservice
