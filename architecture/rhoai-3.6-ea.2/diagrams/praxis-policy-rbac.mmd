graph TD
    subgraph Note["PPE RBAC Model"]
        direction TB
        Info["PPE is an embeddable library, not a Kubernetes operator.<br/>It has NO Kubernetes RBAC (ClusterRoles, RoleBindings).<br/><br/>Instead, PPE implements its own authorization model<br/>using APL (Authorization Policy Language) evaluated<br/>at the enforcement boundary."]
    end

    subgraph IdentityResolution["Identity Resolution (per request)"]
        direction LR
        JWT["JWT Token<br/>(verified via JWKS)"]
        APIKey["API Key<br/>(SHA-256 indexed)"]
        SVID["Workload SVID"]
    end

    subgraph IdentitySlots["Identity Slots"]
        direction LR
        Subject["subject<br/>(end-user)"]
        Client["client<br/>(calling app)"]
        CallerWorkload["caller_workload<br/>(infrastructure)"]
    end

    subgraph PolicyEvaluation["APL Policy Evaluation"]
        direction TB
        RouteMatch["Route Matching<br/>(tool, resource, prompt, llm, http)"]
        PDPEval["PDP Evaluation<br/>(Cedar / CEL / OPA)"]
        RouteMatch --> PDPEval
    end

    subgraph Verdicts["Enforcement Verdicts"]
        direction LR
        Allow["ALLOW<br/>(proceed with effects)"]
        Deny["DENY<br/>(block operation)"]
        Unidentified["DENY<br/>(unidentified_request<br/>— missing route, fail-safe)"]
    end

    subgraph PluginCapabilities["Plugin Capability Gates"]
        direction TB
        PerformHTTP["perform_http<br/>(outbound HTTP calls)"]
        CapAudit["Audit sink access<br/>(capability-gated)"]
        SecretAccess["Secret access<br/>(per declared value only)"]
    end

    JWT --> Subject
    APIKey --> Client
    SVID --> CallerWorkload

    Subject --> RouteMatch
    Client --> RouteMatch
    CallerWorkload --> RouteMatch

    PDPEval --> Allow
    PDPEval --> Deny
    PDPEval --> Unidentified

    %% Styling
    style Note fill:#f5f5f5,stroke:#999,stroke-width:2px
    style Info fill:#fff,stroke:#ddd

    style JWT fill:#dae8fc,stroke:#6c8ebf
    style APIKey fill:#dae8fc,stroke:#6c8ebf
    style SVID fill:#dae8fc,stroke:#6c8ebf

    style Subject fill:#d5e8d4,stroke:#82b366
    style Client fill:#d5e8d4,stroke:#82b366
    style CallerWorkload fill:#d5e8d4,stroke:#82b366

    style RouteMatch fill:#fff2cc,stroke:#d6b656
    style PDPEval fill:#fff2cc,stroke:#d6b656

    style Allow fill:#d5e8d4,stroke:#82b366
    style Deny fill:#f8cecc,stroke:#b85450
    style Unidentified fill:#f8cecc,stroke:#b85450

    style PerformHTTP fill:#e1d5e7,stroke:#9673a6
    style CapAudit fill:#e1d5e7,stroke:#9673a6
    style SecretAccess fill:#e1d5e7,stroke:#9673a6
