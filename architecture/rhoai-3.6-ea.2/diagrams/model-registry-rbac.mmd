graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["controller-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["controller-model-registry-<br/>manager-rolebinding<br/>(cluster-scoped)"]
        CRB_Metrics["controller-metrics-<br/>auth-rolebinding<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["controller-leader-election-<br/>rolebinding<br/>(namespace: kubeflow)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["controller-model-registry-<br/>manager-role"]
        CR_MetricsAuth["controller-metrics-<br/>auth-role"]
        CR_MetricsReader["controller-metrics-<br/>reader"]
    end

    subgraph Roles["Roles"]
        R_Leader["controller-leader-election-role<br/>(namespace: kubeflow)"]
    end

    subgraph APIResources_Manager["Manager Role Resources"]
        Svc["(core)<br/>services<br/>get, list, watch"]
        IS["serving.kserve.io<br/>inferenceservices<br/>get, list, patch, update, watch"]
        ISFin["serving.kserve.io<br/>inferenceservices/finalizers<br/>create, delete, get, list,<br/>patch, update, watch"]
    end

    subgraph APIResources_Auth["Metrics Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph APIResources_Metrics["Metrics Reader Resources"]
        MetricsURL["/metrics<br/>(non-resource URL)<br/>get"]
    end

    subgraph APIResources_Leader["Leader Election Resources"]
        ConfigMaps["(core)<br/>configmaps<br/>create, delete, get, list,<br/>patch, update, watch"]
        Leases["coordination.k8s.io<br/>leases<br/>create, delete, get, list,<br/>patch, update, watch"]
        Events["(core)<br/>events<br/>create, patch"]
    end

    %% SA to bindings
    SA_Controller -->|bound via| CRB_Manager
    SA_Controller -->|bound via| CRB_Metrics
    SA_Controller -->|bound via| RB_Leader

    %% Bindings to roles
    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    CRB_Metrics -.->|also grants| CR_MetricsReader
    RB_Leader -->|grants| R_Leader

    %% Roles to resources
    CR_Manager -->|access| Svc
    CR_Manager -->|access| IS
    CR_Manager -->|access| ISFin
    CR_MetricsAuth -->|access| TokenReview
    CR_MetricsAuth -->|access| SAR
    CR_MetricsReader -->|access| MetricsURL
    R_Leader -->|access| ConfigMaps
    R_Leader -->|access| Leases
    R_Leader -->|access| Events

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style R_Leader fill:#e8a623,stroke:#333
    style IS fill:#7ed321,stroke:#333
    style ISFin fill:#7ed321,stroke:#333
    style Svc fill:#7ed321,stroke:#333
    style TokenReview fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style MetricsURL fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Leases fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
