graph TB
    subgraph FeastModuleOperator["Feast Module Operator"]
        Controller["FeastOperator Controller<br/>Go Operator<br/>8081/TCP health, 8443/TCP metrics"]
        Kustomize["Kustomize Renderer<br/>Renders bundled manifests"]
        GC["Garbage Collector<br/>Cleans stale resources"]
        Finalizer["Finalizer<br/>Cleans ClusterRoles/Bindings"]
        Controller -->|renders manifests| Kustomize
        Controller -->|cleans stale| GC
        Controller -->|on deletion| Finalizer
    end

    subgraph ChartGen["Chartgen CLI"]
        ChartGenCmd["chartgen subcommand<br/>Generates Helm charts"]
    end

    ODHOperator["ODH Operator"] -->|creates| FeastOperatorCR["FeastOperator CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Singleton: default-feastoperator"]
    ODHOperator -->|creates| ConfigMap["odh-feastoperator-config<br/>ConfigMap"]

    FeastOperatorCR -->|watched by| Controller
    ConfigMap -->|watched by| Controller

    Controller -->|deploys| FeastOperatorDeployment["feast-operator-controller-manager<br/>Deployment"]
    Controller -->|deploys| FeatureStoreCRD["FeatureStore CRD<br/>feast.dev"]
    Controller -->|creates| ServiceMonitor["ServiceMonitor"]
    Controller -->|manages| RBAC["RBAC Resources<br/>ClusterRoles, Bindings"]

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|integrates| PrometheusOperator["prometheus-operator"]

    FeastOperatorDeployment -.->|watches| Notebooks["Kubeflow Notebooks"]
    FeastOperatorDeployment -.->|watches| MLflow["MLflow"]
    FeastOperatorDeployment -.->|manages| SparkApps["Spark Applications"]

    style Controller fill:#4a90e2,color:#fff
    style Kustomize fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style Finalizer fill:#4a90e2,color:#fff
    style ChartGenCmd fill:#4a90e2,color:#fff
    style FeastOperatorCR fill:#f5a623,color:#fff
    style ConfigMap fill:#f5a623,color:#fff
    style FeatureStoreCRD fill:#f5a623,color:#fff
    style FeastOperatorDeployment fill:#7ed321
    style ServiceMonitor fill:#7ed321
    style RBAC fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style PrometheusOperator fill:#e8e8e8
    style ODHOperator fill:#7ed321
    style Notebooks fill:#e8e8e8
    style MLflow fill:#e8e8e8
    style SparkApps fill:#e8e8e8
