graph TD
    subgraph "Identity Sources"
        GitHubUser["GitHub User<br/>(OAuth Token)"]
    end

    subgraph "Permission Resolution (highest wins)"
        direction TB

        subgraph "Source 1: GCS Admin Allowlist"
            AdminList["prism-iam/<br/>github-admin-allowlist.txt<br/>(GCS object)"]
        end

        subgraph "Source 2: GCS User Allowlist"
            UserList["prism-iam/<br/>github-user-allowlist.txt<br/>(GCS object)"]
        end

        subgraph "Source 3: GitHub Org Membership"
            OrgAdmin["llm-d org<br/>admin role"]
            OrgMember["llm-d org<br/>member role"]
        end

        subgraph "Source 4: Playground Mode"
            Playground["RESULTS_STORE_PLAYGROUND_MODE<br/>env var (bypasses all auth)"]
        end
    end

    subgraph "Permission Levels"
        AdminPerm["admin"]
        UserPerm["user"]
        NonePerm["none"]
    end

    subgraph "Protected Endpoints"
        ResultsWrite["POST /api/results<br/>(submit benchmarks)"]
        ResultsPromote["POST /api/results/:id/promote<br/>(promote to public)"]
        ResultsReview["POST /api/results/:id/review<br/>(approve/reject)"]
        ResultsDelete["DELETE /api/results/:id<br/>(delete results)"]
        GCSWrite["PUT/POST/DELETE /api/gcs/*<br/>(results-store prefix only)"]
        GCSRead["GET /api/gcs/*<br/>(filtered by ownership/state)"]
        PublicRead["GET /api/regressions<br/>GET /api/config<br/>GET /api/prefix-cache/data<br/>GET /api/pd-disaggregation/data"]
    end

    %% Identity to permission sources
    GitHubUser -->|"username lookup"| AdminList
    GitHubUser -->|"username lookup"| UserList
    GitHubUser -->|"org membership check"| OrgAdmin
    GitHubUser -->|"org membership check"| OrgMember

    %% Permission source to level
    AdminList -->|"grants"| AdminPerm
    UserList -->|"grants"| UserPerm
    OrgAdmin -->|"grants"| AdminPerm
    OrgMember -->|"grants"| UserPerm
    Playground -->|"grants"| UserPerm

    %% Permission level to endpoints
    AdminPerm -->|"full access"| ResultsWrite
    AdminPerm -->|"admin only"| ResultsPromote
    AdminPerm -->|"admin only"| ResultsReview
    AdminPerm -->|"admin only"| ResultsDelete
    AdminPerm -->|"admin only"| GCSWrite
    AdminPerm -->|"unfiltered"| GCSRead
    UserPerm -->|"submit own"| ResultsWrite
    UserPerm -->|"filtered view"| GCSRead
    NonePerm -->|"unauthenticated"| PublicRead
    NonePerm -->|"read public/promoted only"| GCSRead

    style GitHubUser fill:#4a90e2,stroke:#333,color:#fff
    style AdminPerm fill:#e74c3c,stroke:#333,color:#fff
    style UserPerm fill:#f5a623,stroke:#333
    style NonePerm fill:#e8e8e8,stroke:#333
    style ResultsPromote fill:#e74c3c,stroke:#333,color:#fff
    style ResultsReview fill:#e74c3c,stroke:#333,color:#fff
    style ResultsDelete fill:#e74c3c,stroke:#333,color:#fff
    style GCSWrite fill:#e74c3c,stroke:#333,color:#fff
    style ResultsWrite fill:#f5a623,stroke:#333
    style GCSRead fill:#f5a623,stroke:#333
    style PublicRead fill:#7ed321,stroke:#333
