graph TD
    subgraph AuthFlow["Authentication & Authorization Flow"]
        direction TB

        Client["Client / Dashboard"]
        BearerToken["Bearer Token<br/>(ServiceAccount or User)"]
        Client -->|"presents"| BearerToken
    end

    subgraph ProxyLayer["kube-rbac-proxy (Enforcement Point)"]
        direction TB

        TokenReview["TokenReview<br/>Validate Bearer token"]
        SAR["SubjectAccessReview<br/>Check RBAC permissions"]
        HeaderInjection["Header Injection<br/>X-User + X-Tenant"]

        BearerToken -->|"validates via"| TokenReview
        TokenReview -->|"authorizes via"| SAR
        SAR -->|"sets"| HeaderInjection
    end

    subgraph EvalHubAuth["eval-hub Identity Check"]
        direction TB

        CanContinue["canContinueRequest<br/>server.go:458-471"]
        ClusterMode{"Cluster Mode?<br/>(not --local)"}
        CheckHeaders["Require X-User<br/>+ X-Tenant headers"]
        Bypass["Bypass<br/>(local/dev mode)"]

        HeaderInjection -->|"forwards to"| CanContinue
        CanContinue --> ClusterMode
        ClusterMode -->|"Yes"| CheckHeaders
        ClusterMode -->|"No"| Bypass
    end

    subgraph ProtectedRoutes["Protected API Routes"]
        Jobs["/api/v1/evaluations/jobs<br/>POST, GET, DELETE"]
        Collections["/api/v1/evaluations/collections<br/>GET, POST, PUT, PATCH, DELETE"]
        Providers["/api/v1/evaluations/providers<br/>GET, POST, PUT, PATCH, DELETE"]

        CheckHeaders -->|"allows"| Jobs
        CheckHeaders -->|"allows"| Collections
        CheckHeaders -->|"allows"| Providers
        Bypass -->|"allows"| Jobs
        Bypass -->|"allows"| Collections
        Bypass -->|"allows"| Providers
    end

    subgraph UnprotectedRoutes["Unauthenticated Routes"]
        Health["/api/v1/health<br/>GET"]
        Docs["/docs<br/>GET"]
        OpenAPI["/openapi.yaml<br/>GET"]
        Metrics["/metrics<br/>GET (port 8081)"]
    end

    subgraph TenantIsolation["Tenant Data Isolation"]
        direction TB

        TenantCol["Tenant Column<br/>in SQL storage"]
        WithTenant["WithTenant filter<br/>on Storage interface"]
        RowLevel["Row-level filtering<br/>per X-Tenant value"]

        Jobs -->|"scoped by"| TenantCol
        Collections -->|"scoped by"| TenantCol
        Providers -->|"scoped by"| TenantCol
        TenantCol --> WithTenant
        WithTenant --> RowLevel
    end

    subgraph K8sRBAC["Kubernetes RBAC (Job Operations)"]
        direction TB

        SA["eval-hub<br/>ServiceAccount"]
        K8sPerms["Required Permissions:<br/>Jobs: create, get, list, delete<br/>ConfigMaps: create, get, delete<br/>Secrets: get<br/>HardwareProfiles: get, list, delete<br/>Events: create"]

        SA -->|"needs"| K8sPerms
    end

    %% Styling
    style Client fill:#f9f9f9,stroke:#999
    style BearerToken fill:#e17055,stroke:#c0392b,color:#fff
    style TokenReview fill:#e17055,stroke:#c0392b,color:#fff
    style SAR fill:#e17055,stroke:#c0392b,color:#fff
    style HeaderInjection fill:#e17055,stroke:#c0392b,color:#fff
    style CanContinue fill:#4a90e2,stroke:#2c6fbb,color:#fff
    style CheckHeaders fill:#4a90e2,stroke:#2c6fbb,color:#fff
    style Jobs fill:#7ed321,stroke:#333,color:#fff
    style Collections fill:#7ed321,stroke:#333,color:#fff
    style Providers fill:#7ed321,stroke:#333,color:#fff
    style Health fill:#dfe6e9,stroke:#333
    style Docs fill:#dfe6e9,stroke:#333
    style OpenAPI fill:#dfe6e9,stroke:#333
    style Metrics fill:#dfe6e9,stroke:#333
    style TenantCol fill:#f5a623,stroke:#333,color:#fff
    style SA fill:#999,stroke:#333,color:#fff
    style K8sPerms fill:#999,stroke:#333,color:#fff
