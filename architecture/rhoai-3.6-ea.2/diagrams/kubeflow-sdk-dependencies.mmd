graph LR
    SDK["Kubeflow SDK<br/>(kubeflow Python package)"]

    %% Internal RHOAI Dependencies
    SDK -->|"creates TrainJob CRs<br/>443/TCP HTTPS"| TrainerOp["Kubeflow Trainer<br/>Operator"]
    SDK -->|"creates Experiment CRs<br/>443/TCP HTTPS"| KatibOp["Katib / Optimizer<br/>Operator"]
    SDK -->|"creates SparkConnect CRs<br/>443/TCP HTTPS"| SparkOp["Spark Operator"]
    SDK -->|"REST API<br/>443/8080 TCP"| ModelReg["Model Registry"]
    SDK -->|"REST API via kfp<br/>443/TCP HTTPS"| KFPipelines["Kubeflow Pipelines"]
    SDK -.->|"TrainJob annotations<br/>algorithm mode"| TrainingHub["Training Hub<br/>(RHAI)"]

    %% External Dependencies
    SDK -->|"all CR operations<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API<br/>Server"]
    SDK -->|"checkpoint storage<br/>443/TCP HTTPS"| S3["S3-Compatible<br/>Storage"]
    SDK -->|"model config detection<br/>443/TCP HTTPS"| HFHub["HuggingFace Hub"]
    SDK -->|"runtime definitions<br/>443/TCP HTTPS"| PyPI["PyPI / Custom<br/>Index"]

    %% Key Python Dependencies
    SDK -->|"K8s client"| K8sPy["kubernetes<br/>>=27.2.0,<36.0.0"]
    SDK -->|"data validation"| Pydantic["pydantic<br/>>=2.10.0"]
    SDK -->|"Trainer API models"| TrainerAPI["kubeflow-trainer-api<br/>>=2.2.0,<2.3"]
    SDK -->|"Katib API models"| KatibAPI["kubeflow-katib-api<br/>>=0.19.0,<0.20"]
    SDK -->|"S3 filesystem"| FSSpec["fsspec / s3fs<br/>(optional: rhai)"]
    SDK -->|"pipelines SDK"| KFP["kfp<br/>>=2.17.0,<2.18<br/>(optional: pipelines)"]
    SDK -->|"registry client"| MRClient["model-registry<br/>>=0.3.14,<0.4<br/>(optional: hub)"]

    %% Styling
    style SDK fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

