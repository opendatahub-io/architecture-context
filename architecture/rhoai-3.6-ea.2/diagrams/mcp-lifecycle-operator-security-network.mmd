graph TB
    subgraph OperatorPod["OPERATOR POD<br/>(mcp-lifecycle-operator-system)<br/>UBI 9 minimal-pqc, non-root 65532<br/>FIPS: strictfipsruntime, HTTP/2 disabled"]
        direction TB

        HealthProbes["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
        MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TLS (self-signed)<br/>TokenReview + SAR"]
        Reconciler["MCPServerReconciler"]
        TLSConfig["TLS Config<br/>TLS_MIN_VERSION<br/>TLS_CIPHER_SUITES"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
    end

    subgraph ManagedNamespace["MANAGED NAMESPACE (per MCPServer)"]
        direction TB

        MCPPod["MCP Server Pod<br/>User-defined port<br/>HTTP or HTTPS<br/>Configurable TLS 1.2+"]

        subgraph OwnedResources["Operator-Owned Resources"]
            Dep["Deployment"]
            Svc["Service<br/>(ClusterIP, session affinity)"]
            NetPol["NetworkPolicy<br/>(ingress restricted to MCP port)"]
        end

        Dep -->|runs| MCPPod
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>(namespace: metrics=enabled)"]
    end

    %% Flows
    Reconciler -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    K8sAPI -->|"Watch events<br/>TLS 1.2+"| Reconciler

    Reconciler -->|"MCP Handshake<br/>StreamableHTTP<br/>HTTP or HTTPS<br/>Custom CA / None"| MCPPod

    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>TokenReview + SAR"| MetricsEndpoint

    TLSConfig -.->|"PROPAGATE_TLS_ENV_VARS<br/>(optional)"| MCPPod

    %% Network Policy annotations
    NetPol -.->|"restricts ingress"| MCPPod

    %% Styling
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef endpoint fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Reconciler,TLSConfig operator
    class K8sAPI k8s
    class MCPPod,Dep,Svc,NetPol managed
    class Prometheus monitoring
    class HealthProbes,MetricsEndpoint endpoint
