    subgraph "Secrets / Credentials"
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>Type: env var<br/>Purpose: S3 storage auth"]
        HFToken["HF_TOKEN<br/>Type: env var<br/>Purpose: HuggingFace auth"]
        LLMKey["LLM_API_KEY<br/>Type: env var<br/>Purpose: LLM API auth"]
        K8sToken["KUBERNETES_AUTH_TOKEN<br/>Type: env var<br/>Purpose: K8s API auth"]
        OCIPull["OCI_PULL_SECRET_MODEL_DOWNLOAD<br/>Type: env var<br/>Purpose: OCI registry auth"]
    end

