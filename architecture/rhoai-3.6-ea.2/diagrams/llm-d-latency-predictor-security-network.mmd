graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["llm-d Client<br/>or Internal Caller"]
        TraceProducer["Trace Producer"]
    end

    subgraph InternalServices["INTERNAL SERVICES (ClusterIP – No Auth)"]
        direction TB

        subgraph NS_Default["Namespace: default"]
            PredSvc["prediction-service<br/>ClusterIP 80/TCP → 8001/TCP<br/>HTTP plaintext<br/>No auth"]
            TrainSvc["training-service<br/>ClusterIP 8000/TCP → 8000/TCP<br/>HTTP plaintext<br/>No auth"]

            subgraph PredPods["Prediction Pods (10 replicas)"]
                Pred["prediction-server<br/>Port 8001/TCP<br/>UID 1001<br/>SA: default"]
                PredDisk["emptyDir<br/>/local_models"]
            end

            subgraph TrainPod["Training Pod (1 replica)"]
                Train["training-server<br/>Port 8000/TCP<br/>UID 1001<br/>SA: default"]
                TrainDisk["emptyDir or PVC<br/>/models"]
            end
        end
    end

    subgraph GKE_Optional["GKE OVERLAY (Optional External Exposure)"]
        PredLB["prediction-service<br/>LoadBalancer 80/TCP → 8001/TCP<br/>HTTP plaintext<br/>No auth"]
        TrainLB["training-service-external<br/>LoadBalancer 8080/TCP → 8000/TCP<br/>HTTP plaintext<br/>No auth"]
    end

    subgraph BuildTime["BUILD-TIME EGRESS"]
        PyPI["RHEL AI Python Index<br/>443/TCP HTTPS<br/>TLS (pip default)"]
    end

    %% Flows
    Client -->|"HTTP/80<br/>Plaintext<br/>No auth"| PredSvc
    TraceProducer -->|"HTTP/8000<br/>Plaintext<br/>No auth"| TrainSvc

    PredSvc -->|"HTTP/8001<br/>Plaintext"| Pred
    TrainSvc -->|"HTTP/8000<br/>Plaintext"| Train

    Pred -->|"File I/O"| PredDisk
    Train -->|"File I/O"| TrainDisk

    Pred -->|"HTTP/8000<br/>Plaintext<br/>No auth<br/>Model sync poll"| TrainSvc

    %% GKE external
    Client -.->|"HTTP/80<br/>Plaintext<br/>No auth"| PredLB
    TraceProducer -.->|"HTTP/8080<br/>Plaintext<br/>No auth"| TrainLB
    PredLB -.->|"HTTP/8001"| Pred
    TrainLB -.->|"HTTP/8000"| Train

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gke fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef buildtime fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client,TraceProducer external
    class PredSvc,TrainSvc,Pred,Train internal
    class PredDisk,TrainDisk storage
    class PredLB,TrainLB gke
    class PyPI buildtime
