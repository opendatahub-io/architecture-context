graph TB
    subgraph External["EXTERNAL SERVICES (Untrusted)"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>HF_TOKEN bearer"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS credentials"]
        LLMAPI["LLM API / MaaS<br/>HTTPS<br/>TLS<br/>LLM_API_KEY"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph InitPhase["INIT PHASE (Pod Startup)"]
            InitContainer["Init Container<br/>odh-pipelines-components<br/>UBI9 Python 3.12<br/>Crypto: DEFAULT:PQ"]
            SharedVol["Shared Volume<br/>/config/managed-pipelines"]
            KFPServer["KFP API Server"]

            InitContainer -->|"Filesystem<br/>No network"| SharedVol
            SharedVol -->|"Filesystem<br/>No network"| KFPServer
        end

        subgraph RuntimePhase["PIPELINE TASK PODS (Runtime)"]
            direction TB
            DataPod["Data Processing Pod<br/>SA: KFP pipeline runner<br/>Images: odh-automl, odh-autorag"]
            TrainPod["Training / Fine-Tuning Pod<br/>SA: KFP pipeline runner"]
            EvalPod["Eval Hub Evaluator Pod<br/>SA: KFP pipeline runner"]
            RegPod["Model Registration Pod<br/>SA: KFP pipeline runner"]
            RAGPod["RAG Indexing Pod<br/>SA: KFP pipeline runner"]
        end

        subgraph PlatformSvc["PLATFORM SERVICES (In-Cluster)"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS (in-cluster CA)<br/>SA Bearer token"]
            ModelReg["Kubeflow Model Registry<br/>8080/TCP HTTP<br/>No encryption<br/>No auth"]
            EvalHubSvc["Eval Hub<br/>HTTP/HTTPS<br/>verify_tls configurable<br/>Bearer + X-Tenant"]
            MilvusSvc["Milvus<br/>19530/TCP gRPC<br/>No encryption<br/>Token (optional)"]
        end

        subgraph DSPO_Box["DSPO"]
            DSPO["Data Science Pipelines Operator<br/>Injects RELATED_IMAGE_*"]
        end
    end

    %% Init phase connections
    DSPO -->|"Env vars<br/>RELATED_IMAGE_*"| InitContainer

    %% Runtime egress to external
    DataPod -->|"HTTPS/443<br/>TLS<br/>AWS credentials"| S3
    DataPod -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HF
    TrainPod -->|"HTTPS/443<br/>TLS (in-cluster CA)<br/>SA Bearer token"| K8sAPI
    EvalPod -->|"HTTPS/443<br/>TLS (verify_ssl=True)<br/>SA Bearer token"| K8sAPI
    EvalPod -->|"HTTP/HTTPS<br/>verify_tls=False default<br/>Bearer + X-Tenant"| EvalHubSvc
    RegPod -->|"HTTP/8080<br/>No encryption<br/>No auth"| ModelReg
    RAGPod -->|"gRPC/19530<br/>No encryption<br/>Token (optional)"| MilvusSvc
    RAGPod -->|"HTTPS<br/>TLS<br/>LLM_API_KEY"| LLMAPI
    RAGPod -->|"HTTPS/443<br/>TLS<br/>AWS credentials"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef initphase fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef runtime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class HF,S3,LLMAPI external
    class InitContainer,SharedVol,KFPServer initphase
    class DataPod,TrainPod,EvalPod,RegPod,RAGPod runtime
    class K8sAPI platform
    class DSPO operator
    class ModelReg,MilvusSvc,EvalHubSvc warning
