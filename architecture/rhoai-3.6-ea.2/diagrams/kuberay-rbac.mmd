graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA[kuberay-operator]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1[kuberay-operator]
        CRB2[kuberay-operator-configmap]
        CRB3[kuberay-operator-gateway-api]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main[kuberay-operator]
        CR_Edit[kuberay-edit-role<br/>aggregated to admin/edit]
        CR_View[kuberay-view-role<br/>aggregated to view]
        CR_CronEdit[raycronjob-editor-role]
        CR_CronView[raycronjob-viewer-role]
    end

    subgraph RayResources["Ray API Resources"]
        RayClusters[ray.io<br/>RayClusters]
        RayJobs[ray.io<br/>RayJobs]
        RayServices[ray.io<br/>RayServices]
        RayCronJobs[ray.io<br/>RayCronJobs]
    end

    subgraph CoreResources["Core API Resources"]
        CorePods["core<br/>Pods, Pods/status"]
        CoreSvcs["core<br/>Services"]
        CoreSA["core<br/>ServiceAccounts"]
        CoreSecrets["core<br/>Secrets, ConfigMaps"]
        CoreEvents["core<br/>Events"]
    end

    subgraph ExtResources["Extended API Resources"]
        Deployments["apps<br/>Deployments"]
        BatchJobs["batch<br/>Jobs"]
        CertMgrRes["cert-manager.io<br/>Certificates, Issuers"]
        GatewayRes["gateway.networking.k8s.io<br/>Gateways, HTTPRoutes,<br/>ReferenceGrants"]
        NetworkRes["networking.k8s.io<br/>Ingresses, NetworkPolicies"]
        RouteRes["route.openshift.io<br/>Routes"]
        RBACRes["rbac.authorization.k8s.io<br/>Roles, RoleBindings,<br/>ClusterRoles, ClusterRoleBindings"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReview["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    %% Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| CRB3
    CRB1 -->|grants| CR_Main
    CRB2 -->|grants| CR_Main
    CRB3 -->|grants| CR_Main

    %% Main role permissions
    CR_Main -->|Full CRUD + watch| RayClusters
    CR_Main -->|Full CRUD + watch| RayJobs
    CR_Main -->|Full CRUD + watch| RayServices
    CR_Main -->|Full CRUD + watch| RayCronJobs
    CR_Main -->|Full CRUD + watch| CorePods
    CR_Main -->|Full CRUD + watch| CoreSvcs
    CR_Main -->|Full CRUD + watch| CoreSA
    CR_Main -->|Full CRUD + watch| CoreSecrets
    CR_Main -->|Full CRUD + watch| CoreEvents
    CR_Main -->|get,list,patch,update,watch| Deployments
    CR_Main -->|Full CRUD + watch| BatchJobs
    CR_Main -->|Full CRUD + watch| CertMgrRes
    CR_Main -->|Full CRUD + watch| GatewayRes
    CR_Main -->|Full CRUD + watch| NetworkRes
    CR_Main -->|Full CRUD + watch| RouteRes
    CR_Main -->|CRUD + watch| RBACRes
    CR_Main -->|create| TokenReview
    CR_Main -->|create| SAR

    %% Aggregated roles
    CR_Edit -->|Full CRUD| RayClusters
    CR_Edit -->|Full CRUD| RayJobs
    CR_Edit -->|Full CRUD| RayServices
    CR_View -->|get,list,watch| RayClusters
    CR_View -->|get,list,watch| RayJobs
    CR_View -->|get,list,watch| RayServices
    CR_CronEdit -->|Full CRUD| RayCronJobs
    CR_CronView -->|get,list,watch| RayCronJobs

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR_Main fill:#f5a623
    style CR_Edit fill:#f5a623
    style CR_View fill:#f5a623
    style CR_CronEdit fill:#f5a623
    style CR_CronView fill:#f5a623
    style RayClusters fill:#7ed321
    style RayJobs fill:#7ed321
    style RayServices fill:#7ed321
    style RayCronJobs fill:#7ed321
