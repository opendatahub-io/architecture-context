graph TB
    subgraph RhoaiMCP["rhoai-mcp Server"]
        direction TB
        Server["FastMCP Server<br/>stdio / SSE / streamable-http"]
        AuthLayer["Auth Layer<br/>OIDC Middleware + RBAC Filtering"]
        K8sClient["K8sClient<br/>CoreV1Api + DynamicClient"]

        subgraph DomainPlugins["Domain Plugins"]
            Projects["Projects"]
            Notebooks["Notebooks"]
            Inference["Inference"]
            Pipelines["Pipelines"]
            Connections["Connections"]
            Storage["Storage"]
            Training["Training"]
            ModelReg["Model Registry"]
            Prompts["Prompts"]
        end

        subgraph CompositePlugins["Composite Plugins"]
            ClusterComp["Cluster Composites"]
            TrainingComp["Training Composites"]
            MetaComp["Meta Composites"]
            PlannerComp["Planner Composites"]
        end

        Server --> AuthLayer
        AuthLayer --> DomainPlugins
        AuthLayer --> CompositePlugins
        DomainPlugins --> K8sClient
        CompositePlugins --> K8sClient
        PlannerComp -->|model recommendations| LlmDPlanner["llm-d-planner"]
    end

    AIAgent["AI Agent<br/>Claude Desktop / Code"] -->|MCP Tool Calls<br/>SSE or streamable-http| Server

    K8sClient -->|HTTPS/6443| K8sAPI["Kubernetes API Server"]
    K8sClient -->|CRD CRUD| NotebookCR["Notebook CR<br/>kubeflow.org/v1"]
    K8sClient -->|CRD CRUD| InferenceServiceCR["InferenceService CR<br/>serving.kserve.io/v1beta1"]
    K8sClient -->|CRD CRUD| TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org"]
    K8sClient -->|CRD CRUD| DSPACR["DSPA CR<br/>opendatahub.io/v1alpha1"]
    K8sClient -->|CRD Read| DSCCR["DataScienceCluster CR<br/>opendatahub.io/v1"]

    ModelReg -->|REST API| ModelRegSvc["Model Registry Service"]
    PlannerComp -->|REST API| ModelCatalog["Model Catalog Service"]
    AuthLayer -->|JWKS Discovery| OIDCProvider["OIDC Provider"]

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style AuthLayer fill:#e74c3c,stroke:#333,color:#fff
    style K8sClient fill:#4a90e2,stroke:#333,color:#fff
    style AIAgent fill:#9b59b6,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style InferenceServiceCR fill:#f5a623,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style DSPACR fill:#f5a623,stroke:#333
    style DSCCR fill:#f5a623,stroke:#333
    style ModelRegSvc fill:#7ed321,stroke:#333
    style ModelCatalog fill:#7ed321,stroke:#333
    style OIDCProvider fill:#e8e8e8,stroke:#333
    style LlmDPlanner fill:#3498db,stroke:#333,color:#fff
