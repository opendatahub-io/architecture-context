graph TB
    subgraph MLflow["MLflow Component"]
        direction TB
        Server["mlflow-server<br/>(FastAPI/Flask)<br/>Port 5000/TCP"]
        UI["mlflow-ui<br/>(React Frontend)<br/>Module Federation"]
        AuthPlugin["mlflow-kubernetes-plugins<br/>(Auth Plugin v1.6.0)"]
        Skinny["mlflow-skinny<br/>(Lightweight Client)"]
        Tracing["mlflow-tracing<br/>(Tracing SDK)"]
        FS2DB["fs2db<br/>(Go Migration Utility)"]

        Server -->|serves static| UI
        Server -->|loads via entry point| AuthPlugin
        AuthPlugin -->|validates| BearerToken["K8s Bearer Token"]
        AuthPlugin -->|resolves workspace| WorkspaceHeader["X-MLFLOW-WORKSPACE"]
    end

    subgraph Clients["Clients"]
        MLClient["ML Client<br/>(Python SDK)"]
        DashboardEmbed["RHOAI Dashboard<br/>(Embedded UI)"]
        PromScraper["Prometheus<br/>(Metrics Scrape)"]
    end

    MLClient -->|"HTTP/5000<br/>Bearer Token"| Server
    DashboardEmbed -->|"Module Federation<br/>(iframe/micro-frontend)"| UI
    PromScraper -->|"HTTP/5000<br/>/metrics"| Server

    subgraph Backend["Backend Storage"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        ObjStore["S3 / GCS / Azure Blob<br/>443/TCP HTTPS"]
    end

    Server -->|"SQLAlchemy<br/>metadata + registry"| PostgreSQL
    Server -->|"boto3/SDK<br/>artifact storage"| ObjStore

    subgraph Platform["Platform Services"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    end

    Server -->|"workspace store<br/>namespace resolution"| K8sAPI

    subgraph AIGateway["AI Gateway (when enabled)"]
        OpenAI["OpenAI API<br/>443/TCP"]
        Bedrock["AWS Bedrock<br/>443/TCP"]
    end

    Server -.->|"LLM proxy<br/>(disabled by default)"| OpenAI
    Server -.->|"LLM proxy<br/>(disabled by default)"| Bedrock

    style Server fill:#4a90e2,color:#fff
    style UI fill:#4a90e2,color:#fff
    style AuthPlugin fill:#4a90e2,color:#fff
    style Skinny fill:#7bb8f5,color:#fff
    style Tracing fill:#7bb8f5,color:#fff
    style FS2DB fill:#7bb8f5,color:#fff
    style PostgreSQL fill:#f5a623,color:#fff
    style ObjStore fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8,color:#333
    style OpenAI fill:#999,color:#fff
    style Bedrock fill:#999,color:#fff
    style MLClient fill:#7ed321,color:#fff
    style DashboardEmbed fill:#7ed321,color:#fff
    style PromScraper fill:#7ed321,color:#fff
