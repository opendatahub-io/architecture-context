graph TB
    subgraph EvalHubSystem["EvalHub System"]
        direction TB

        subgraph APIServer["eval-hub API Server (8080/TCP)"]
            Router["HTTP Router<br/>net/http.ServeMux"]
            ExecCtx["ExecutionContext<br/>X-User / X-Tenant"]
            JobHandler["Job Handler<br/>/api/v1/evaluations/jobs"]
            CollHandler["Collection Handler<br/>/api/v1/evaluations/collections"]
            ProvHandler["Provider Handler<br/>/api/v1/evaluations/providers"]
            HealthHandler["Health Handler<br/>/api/v1/health"]
            Router --> ExecCtx
            ExecCtx --> JobHandler
            ExecCtx --> CollHandler
            ExecCtx --> ProvHandler
            Router --> HealthHandler
        end

        subgraph Storage["Pluggable Storage Layer"]
            SQLite["SQLite Driver<br/>In-memory / File"]
            PostgreSQL["PostgreSQL Driver<br/>pgx/v5"]
        end

        subgraph Runtime["Runtime Layer"]
            LocalRT["Local Runtime<br/>Subprocess"]
            K8sRT["Kubernetes Runtime<br/>Job Orchestration"]
        end

        subgraph MetricsSrv["Metrics Server (8081/TCP)"]
            PromMetrics["Prometheus /metrics"]
        end

        JobHandler --> Storage
        CollHandler --> Storage
        ProvHandler --> Storage
        JobHandler --> Runtime
    end

    subgraph JobPod["Evaluation Job Pod"]
        InitContainer["eval-runtime-init<br/>S3/Git/HuggingFace download"]
        Sidecar["eval-runtime-sidecar<br/>8082/TCP"]
        EvalAdapter["Evaluation Framework<br/>lm-eval-harness / RAGAS /<br/>Garak / GuideLLM / etc."]
        InitContainer -.->|"shared volume"| EvalAdapter
        EvalAdapter -->|"callbacks"| Sidecar
    end

    subgraph MCPServer["evalhub-mcp (3001/TCP)"]
        MCPService["MCP Server<br/>stdio / HTTP transport"]
    end

    %% External actors
    Client["Client / Dashboard"]
    KubeRBACProxy["kube-rbac-proxy<br/>443/TCP"]
    Prometheus["Prometheus"]
    AIAgent["AI Agent"]

    %% Connections
    Client -->|"HTTPS/443<br/>Bearer Token"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8080<br/>X-User, X-Tenant"| Router
    Prometheus -->|"HTTP/8081"| PromMetrics
    AIAgent -->|"MCP Protocol"| MCPService
    MCPService -->|"REST API"| Router

    K8sRT -->|"creates"| JobPod
    Sidecar -->|"HTTPS/8080<br/>SA token"| Router
    Sidecar -->|"HTTP(S)/5000"| MLflow["MLflow Tracking Server"]
    JobHandler -->|"HTTPS/6443"| K8sAPI["Kubernetes API"]
    JobHandler -->|"HTTP(S)/5000"| MLflow

    %% Operator
    TrustyAIOp["TrustyAI Service Operator"]
    EvalHubCR["EvalHub CR"]
    TrustyAIOp -->|"manages"| EvalHubCR
    EvalHubCR -->|"creates"| APIServer

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Storage fill:#50c878,stroke:#333,color:#fff
    style Runtime fill:#f5a623,stroke:#333,color:#fff
    style MetricsSrv fill:#4a90e2,stroke:#333,color:#fff
    style JobPod fill:#dfe6e9,stroke:#333
    style MCPServer fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACProxy fill:#e17055,stroke:#333,color:#fff
    style TrustyAIOp fill:#a29bfe,stroke:#333,color:#fff
    style EvalHubCR fill:#ffeaa7,stroke:#333
    style MLflow fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
