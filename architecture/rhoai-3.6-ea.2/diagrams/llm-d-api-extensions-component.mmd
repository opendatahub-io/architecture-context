graph TB
    subgraph VLLMServer["vLLM Inference Server (Port 8000/TCP)"]
        direction TB

        subgraph PluginFramework["vLLM Endpoint Plugin Framework"]
            direction LR
            ConfigPlugin["ServerConfigPlugin<br/>required_tasks = None<br/>/config"]
            DevicesPlugin["ServerDevicesPlugin<br/>required_tasks = ENGINE_TASKS<br/>/devices"]
            KVCachePlugin["ServerKVCachePlugin<br/>required_tasks = ENGINE_TASKS<br/>/kv-cache"]
        end

        subgraph AppState["app.state (Cached Responses)"]
            ConfigData["Config Data<br/>(model, scheduler,<br/>parallelism, KV transfer)"]
            DevicesData["Devices Data<br/>(per-rank GPU props)"]
            KVCacheData["KV Cache Data<br/>(capacity, attention groups)"]
        end

        subgraph Engine["vLLM Engine"]
            EngineClient["EngineClient"]
            VllmConfig["VllmConfig"]
        end

        subgraph Workers["vLLM Workers"]
            WorkerExt["DeviceInfoWorkerExtension<br/>(--worker-extension-cls)"]
            Platform["current_platform<br/>(GPU device query)"]
        end

        ConfigPlugin -->|"init_state (once)"| VllmConfig
        ConfigPlugin -->|"serve from"| ConfigData
        DevicesPlugin -->|"init_state (once)"| EngineClient
        DevicesPlugin -->|"serve from"| DevicesData
        KVCachePlugin -->|"init_state (once)"| EngineClient
        KVCachePlugin -->|"serve from"| KVCacheData

        EngineClient -->|"collective_rpc"| WorkerExt
        WorkerExt -->|"get_device_properties"| Platform
    end

    LLMDRouter["llm-d Router<br/>(Routing & Scheduling)"]
    RedactEnv["LLM_D_INTROSPECTION_<br/>EXPOSE_KV_EXTRA_CONFIG"]
    VLLMPluginsEnv["VLLM_PLUGINS env var<br/>(opt-in activation)"]

    LLMDRouter -->|"GET /plugins/llm-d-server-introspection/*<br/>HTTP 8000/TCP"| PluginFramework
    VLLMPluginsEnv -.->|"enables"| PluginFramework
    RedactEnv -.->|"controls redaction"| ConfigPlugin

    style ConfigPlugin fill:#4a90e2,color:#fff
    style DevicesPlugin fill:#4a90e2,color:#fff
    style KVCachePlugin fill:#4a90e2,color:#fff
    style WorkerExt fill:#4a90e2,color:#fff
    style LLMDRouter fill:#7ed321,color:#fff
    style ConfigData fill:#f5a623
    style DevicesData fill:#f5a623
    style KVCacheData fill:#f5a623
    style VllmConfig fill:#e8e8e8
    style EngineClient fill:#e8e8e8
    style Platform fill:#e8e8e8
    style VLLMPluginsEnv fill:#fff2cc,stroke:#d6b656
    style RedactEnv fill:#fff2cc,stroke:#d6b656
