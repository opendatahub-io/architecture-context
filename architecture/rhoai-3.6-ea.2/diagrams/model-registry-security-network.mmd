graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Dashboard UI"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Istio Ingress Gateway<br/>VirtualService: model-registry, model-catalog, model-registry-ui<br/>Host: * Port: 80/TCP<br/>Istio AuthorizationPolicy"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS)"]
        direction TB

        subgraph NS_Registry["model-registry-service (ClusterIP)"]
            MR["model-registry<br/>:8080/TCP HTTP<br/>seccomp: RuntimeDefault<br/>no privilege escalation<br/>capabilities: drop ALL"]
        end

        subgraph NS_BFF["BFF Proxy"]
            BFF["BFF<br/>:4000/TCP HTTP<br/>Auth: Bearer / SA token<br/>SubjectAccessReview"]
        end

        subgraph NS_Controller["InferenceService Controller"]
            Controller["Controller<br/>SA: controller-controller-manager<br/>Health: :8081/TCP (unauth)<br/>Metrics: :8443/TCP HTTPS<br/>HTTP/2 disabled"]
        end

        subgraph NS_Job["Batch Jobs"]
            Job["async-upload Job<br/>AIPCC CPU base<br/>sigstore + cosign signing"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        DB[("PostgreSQL / MySQL<br/>5432 / 3306/TCP<br/>Configurable TLS<br/>DB credentials (Secret)")]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token / User token"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Token"]
        OCIReg["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry creds"]
        Sigstore["Sigstore / RHTAS<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>User JWT"| Gateway

    %% Ingress to Services
    Gateway -->|"HTTP/8080<br/>Istio mTLS<br/>AuthzPolicy: namespace + principal + JWT"| MR
    Gateway -->|"HTTP/4000<br/>Istio mTLS<br/>AuthzPolicy: ingressgateway SA"| BFF

    %% Internal flows
    BFF -->|"HTTP/8080<br/>internal"| MR
    Controller -->|"HTTP/8080<br/>Bearer token"| MR
    Job -->|"HTTP/8080<br/>Bearer token"| MR

    %% Service to external
    MR -->|"TCP/5432 or 3306<br/>Configurable TLS<br/>Username/password"| DB
    BFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>User token (SAR)"| K8sAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / Token"| S3
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>Token"| HFHub
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry creds"| OCIReg
    Job -->|"HTTPS/443<br/>TLS 1.2+"| Sigstore

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef job fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class MR,BFF,Controller servicemesh
    class Job job
    class DB,K8sAPI,S3,HFHub,OCIReg,Sigstore externalservice
