graph LR
    InferSim["llm-d-inference-sim"]

    %% Internal Platform Dependencies
    InferSim -->|"Go library import<br/>kvevents package"| LLMDRouter["llm-d-router"]
    InferSim -->|"ZMQ PUB :5557<br/>KV cache events"| LLMDRouter

    %% Core Go Dependencies
    InferSim -->|HTTP server| FastHTTP["fasthttp v1.74.0"]
    InferSim -->|routing| FastHTTPRouter["fasthttprouter v0.1.1"]
    InferSim -->|"protocol mux"| CMux["cmux v0.1.5"]
    InferSim -->|gRPC server| GRPC["grpc v1.83.2"]
    InferSim -->|protobuf| Protobuf["protobuf v1.36.12"]

    %% Messaging Dependencies
    InferSim -->|ZMQ socket| ZMQ4["go-zeromq/zmq4 v0.17.0"]
    InferSim -->|serialization| Msgpack["msgpack/v5 v5.4.1"]

    %% Observability
    InferSim -->|metrics| PromClient["prometheus/client_golang v1.24.1"]

    %% Storage
    InferSim -->|datasets| SQLite["go-sqlite3 v0.35.5"]

    %% TLS & Security
    InferSim -->|cert reload| FSNotify["fsnotify v1.10.1"]

    %% API Types
    InferSim -->|OpenAI types| OpenAIGo["openai-go/v3 v3.63.1"]

    %% Kubernetes Ecosystem
    InferSim -->|logging| KLog["k8s.io/klog/v2 v2.140.0"]
    InferSim -->|log context| CtrlRuntime["controller-runtime v0.23.3"]

    %% Sidecar Dependencies
    VLLMRender["vllm-render sidecar"] -->|"HTTPS :443<br/>Bearer HF_TOKEN"| HFHub["HuggingFace Hub"]

    %% Integration Points
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>:8000/metrics"| InferSim

