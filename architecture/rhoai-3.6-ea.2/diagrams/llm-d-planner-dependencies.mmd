graph LR
    Planner["llm-d Planner<br/>(FastAPI + Streamlit + Ollama)"]

    %% Internal Platform Dependencies
    Planner -->|"node list<br/>GPU detection"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Planner -->|"kubectl apply/delete<br/>InferenceService lifecycle"| K8sAPI
    Planner -->|"CRD consumer<br/>generates InferenceService"| KServe["KServe"]
    Planner -.->|"benchmark data<br/>REST v1alpha1"| ModelCatalog["RHOAI Model Catalog<br/>8443/TCP"]
    Planner -->|"CA bundle injection"| ServiceCA["OpenShift Service CA"]

    %% LLM Providers (pluggable)
    Planner -->|"intent extraction<br/>default provider"| Ollama["Ollama<br/>(Granite 3.3 2B)<br/>11434/TCP"]
    Planner -.->|"optional provider"| OpenAI["OpenAI API<br/>443/TCP"]
    Planner -.->|"optional provider"| VertexAI["Vertex AI<br/>(Claude)<br/>443/TCP"]

    %% External Data Sources
    Planner -->|"model config lookups"| HFHub["HuggingFace Hub<br/>443/TCP"]
    Planner -->|"human preference<br/>quality data"| Arena["Arena API<br/>(lmarena.ai)<br/>443/TCP"]
    Planner -->|"automated benchmark<br/>quality data"| AA["Artificial Analysis<br/>(artificialanalysis.ai)<br/>443/TCP"]

    %% Runtime Dependencies
    Planner -->|"runtime"| Python["Python >=3.11"]
    Planner -->|"data validation"| Pydantic["pydantic >=2.13"]
    Planner -->|"REST framework"| FastAPI["FastAPI >=0.141"]
    Planner -->|"YAML templating"| Jinja2["Jinja2 >=3.1"]
    Planner -->|"web UI"| Streamlit["Streamlit >=1.61"]

    %% Styling
    style Planner fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style KServe fill:#f5a623,stroke:#333
    style ModelCatalog fill:#7ed321,stroke:#333
    style ServiceCA fill:#7ed321,stroke:#333
    style Ollama fill:#9b59b6,stroke:#333,color:#fff
    style OpenAI fill:#999,stroke:#333
    style VertexAI fill:#999,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style Arena fill:#f5a623,stroke:#333
    style AA fill:#f5a623,stroke:#333
    style Python fill:#e8e8e8,stroke:#333
    style Pydantic fill:#e8e8e8,stroke:#333
    style FastAPI fill:#e8e8e8,stroke:#333
    style Jinja2 fill:#e8e8e8,stroke:#333
    style Streamlit fill:#e8e8e8,stroke:#333
