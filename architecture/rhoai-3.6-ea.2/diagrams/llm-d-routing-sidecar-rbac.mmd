graph TD
    subgraph ServiceAccounts["Service Accounts / Subjects"]
        AuthUsers["Group: system:authenticated<br/>(all authenticated users)"]
        PlaceholderSA["SA: placeholder<br/>(template, replaced at deploy)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace: ${NAMESPACE})"]
        ExecBinding["${PROJECT_NAME}-exec-rolebinding"]
        SSRFBinding["ssrf-allowlist-rolebinding"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        ExecRole["${PROJECT_NAME}-exec-role"]
        SSRFRole["ssrf-allowlist-role"]
    end

    subgraph APIResources["API Resources"]
        PodsExec["core<br/>pods/exec"]
        Pods["core<br/>pods"]
        InferencePools["inference.networking.x-k8s.io<br/>inferencepools"]
    end

    %% Bindings
    AuthUsers -->|bound via| ExecBinding
    ExecBinding -->|grants| ExecRole
    PlaceholderSA -->|bound via| SSRFBinding
    SSRFBinding -->|grants| SSRFRole

    %% Permissions
    ExecRole -->|create| PodsExec
    SSRFRole -->|get, watch, list| Pods
    SSRFRole -->|get, watch, list| InferencePools

    %% Risk annotation
    ExecBinding -.-|"Risk: overly broad<br/>for production"| ExecNote["All authenticated users<br/>can exec into pods"]

    style AuthUsers fill:#4a90e2,stroke:#333,color:#fff
    style PlaceholderSA fill:#4a90e2,stroke:#333,color:#fff
    style ExecRole fill:#f5a623,stroke:#333
    style SSRFRole fill:#f5a623,stroke:#333
    style ExecBinding fill:#ddd,stroke:#333
    style SSRFBinding fill:#ddd,stroke:#333
    style PodsExec fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style InferencePools fill:#7ed321,stroke:#333
    style ExecNote fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
