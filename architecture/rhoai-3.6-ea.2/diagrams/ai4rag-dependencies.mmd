graph LR
    ai4rag["ai4rag<br/>RAG Optimization Engine"]

    %% External Service Dependencies
    ai4rag -->|"LLM inference<br/>& embeddings"| MaaS["OpenAI-compatible MaaS<br/>(HTTPS / API key)"]
    ai4rag -->|"document storage"| S3["AWS S3-compatible<br/>(HTTPS / AWS IAM)"]
    ai4rag -->|"vector search"| Milvus["Milvus 19530/TCP<br/>(gRPC/TLS / Token)"]
    ai4rag -->|"hybrid search"| PGVector["PostgreSQL/pgvector<br/>5432/TCP (TLS / Password)"]
    ai4rag -->|"graph RAG"| Neo4j["Neo4j 7687/TCP<br/>(Bolt+TLS / Password)"]
    ai4rag -->|"embedded vectors"| MilvusLite["Milvus Lite<br/>(local file)"]

    %% Key Python Dependencies
    ai4rag -->|"LLM SDK"| openai["openai ~=2.53"]
    ai4rag -->|"agent framework"| langchain["langchain >=1.4"]
    ai4rag -->|"document processing"| docling["docling-slim ~=2.121"]
    ai4rag -->|"HPO engine"| pygam["pygam ~=0.12"]
    ai4rag -->|"evaluation"| ragas["RAGAS >=0.3"]
    ai4rag -->|"evaluation"| unitxt["unitxt ~=1.26"]
    ai4rag -->|"data validation"| pydantic["pydantic 2.11"]

    %% Starter Kit Dependencies
    StarterKit["Agentic RAG<br/>Starter Kit"] -->|"auth"| K8sAPI["Kubernetes API<br/>443/TCP (HTTPS)"]
    StarterKit -->|"LLM calls"| MaaS
    StarterKit -->|"retrieval"| Milvus
    StarterKit -->|"retrieval"| PGVector
    ai4rag -.->|"generates"| StarterKit

    %% Runtime
    ai4rag -->|"runtime"| Python["Python >=3.12,<3.14"]

    style ai4rag fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style StarterKit fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style MaaS fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style Milvus fill:#999,stroke:#333,color:#fff
    style MilvusLite fill:#999,stroke:#333,color:#fff
    style PGVector fill:#999,stroke:#333,color:#fff
    style Neo4j fill:#999,stroke:#333,color:#fff
    style openai fill:#e8e8e8,stroke:#333
    style langchain fill:#e8e8e8,stroke:#333
    style docling fill:#e8e8e8,stroke:#333
    style pygam fill:#e8e8e8,stroke:#333
    style ragas fill:#e8e8e8,stroke:#333
    style unitxt fill:#e8e8e8,stroke:#333
    style pydantic fill:#e8e8e8,stroke:#333
    style Python fill:#e8e8e8,stroke:#333
