graph TD
    subgraph "Service Account"
        SA["payload-processing<br/>(Namespace: openshift-ingress)"]
    end

    subgraph "ClusterRole Binding"
        CRB["payload-processing-reader<br/>(cluster-scoped)"]
    end

    subgraph "ClusterRole"
        CR["payload-processing-reader"]
    end

    subgraph "Core API Resources"
        ConfigMaps["core (&quot;&quot;)<br/>configmaps"]
        Secrets["core (&quot;&quot;)<br/>secrets"]
    end

    subgraph "inference.opendatahub.io Resources"
        ExternalProviders["inference.opendatahub.io<br/>externalproviders"]
        ExternalModels["inference.opendatahub.io<br/>externalmodels"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR

    CR -->|"get, list, watch"| ConfigMaps
    CR -->|"get"| Secrets
    CR -->|"get, list, watch"| ExternalProviders
    CR -->|"get, list, watch"| ExternalModels

    subgraph "Used By Deployments"
        PreProc["payload-pre-processing<br/>(pre-auth BBR)"]
        PostProc["payload-processing<br/>(post-auth IPP)"]
    end

    SA -.->|"used by"| PreProc
    SA -.->|"used by"| PostProc

    style SA fill:#4a90e2,color:#fff
    style CRB fill:#f5a623,color:#fff
    style CR fill:#f5a623,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style Secrets fill:#7ed321,color:#fff
    style ExternalProviders fill:#7ed321,color:#fff
    style ExternalModels fill:#7ed321,color:#fff
    style PreProc fill:#dae8fc,stroke:#6c8ebf
    style PostProc fill:#dae8fc,stroke:#6c8ebf
