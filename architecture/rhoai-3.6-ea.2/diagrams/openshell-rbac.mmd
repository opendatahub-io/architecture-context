graph TD
    subgraph "Service Account"
        SA["openshell<br/>(gateway SA)"]
    end

    subgraph "Cluster Role Bindings"
        CRB["openshell-node-reader<br/>(ClusterRoleBinding)"]
        RB["openshell-sandbox<br/>(RoleBinding, sandbox namespace)"]
    end

    subgraph "Roles"
        CR["openshell-node-reader-{ns}<br/>(ClusterRole)"]
        Role["openshell-sandbox<br/>(Role)"]
    end

    subgraph "API Resources - Core"
        Nodes["core<br/>nodes"]
        Namespaces["core<br/>namespaces"]
        Pods["core<br/>pods"]
        Secrets["core<br/>secrets"]
    end

    subgraph "API Resources - Authentication"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
    end

    subgraph "API Resources - agents.x-k8s.io"
        Sandboxes["agents.x-k8s.io<br/>sandboxes"]
        SandboxesStatus["agents.x-k8s.io<br/>sandboxes/status"]
    end

    subgraph "API Resources - Networking"
        NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| CR
    RB -->|"grants"| Role

    %% ClusterRole permissions
    CR -->|"create"| TokenReviews
    CR -->|"get, list, watch"| Nodes
    CR -->|"get (+list, watch, create, delete in managed)"| Namespaces
    CR -->|"create, delete, get, list, patch, update, watch"| Sandboxes
    CR -->|"create, delete, get, list, patch, update, watch"| SandboxesStatus
    CR -->|"create, delete, get, list, patch, watch"| Pods
    CR -->|"create, list, delete (+get, patch for TLS)"| Secrets
    CR -->|"create, get (+patch, update in managed)"| NetworkPolicies

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#dae8fc,stroke:#6c8ebf
    style RB fill:#dae8fc,stroke:#6c8ebf
    style CR fill:#f5a623,stroke:#333
    style Role fill:#f5a623,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style Nodes fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style Sandboxes fill:#7ed321,stroke:#333
    style SandboxesStatus fill:#7ed321,stroke:#333
    style NetworkPolicies fill:#7ed321,stroke:#333
