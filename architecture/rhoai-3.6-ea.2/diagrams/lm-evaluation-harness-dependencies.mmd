graph LR
    LMEval["lm-evaluation-harness<br/>(lmes-job)"]

    %% Internal Platform Dependencies
    LMEval -->|"Job lifecycle<br/>LMEvalJob CR"| LMESOp["TrustyAI LMES Operator"]

    %% Runtime Service Dependencies
    LMEval -->|"local-completions<br/>HTTP/HTTPS"| ModelEndpoint["Model Inference Endpoint<br/>(vLLM / OpenAI-compatible)"]
    LMEval -->|"status callbacks<br/>HTTPS"| EvalHub["EvalHub Service"]
    LMEval -.->|"metrics logging<br/>HTTP/HTTPS"| MLflow["MLflow Tracking Server"]

    %% External Service Dependencies
    LMEval -.->|"datasets<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    LMEval -->|"asset download<br/>boto3 HTTPS"| S3["S3-Compatible Storage"]
    LMEval -->|"artifact push<br/>skopeo HTTPS/443"| OCIReg["OCI Registry"]

    %% Key Python Dependencies
    subgraph PythonDeps["Key Python Dependencies"]
        direction TB
        Torch["torch >=2.6.0"]
        Transformers["transformers >=4.48.0"]
        Datasets["datasets >=3.1.0"]
        EvalHubSDK["eval-hub-sdk ~=1.0.0"]
        Boto3["boto3 >=1.42.12"]
        Olot["olot >=0.1.15"]
        Unitxt["unitxt >=1.17.2"]
        Accelerate["accelerate >=1.0.1"]
    end

    LMEval -->|"framework"| Torch
    LMEval -->|"tokenizers"| Transformers
    LMEval -->|"benchmarks"| Datasets
    LMEval -->|"adapter SDK"| EvalHubSDK
    LMEval -->|"S3 client"| Boto3
    LMEval -->|"OCI layout"| Olot
    LMEval -->|"task config"| Unitxt
    LMEval -->|"distributed"| Accelerate

    %% System Dependencies
    LMEval -->|"OCI push"| Skopeo["skopeo (system)"]

    style LMEval fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style LMESOp fill:#7ed321,stroke:#333,color:#fff
    style ModelEndpoint fill:#f5a623,stroke:#333,color:#fff
    style EvalHub fill:#7ed321,stroke:#333,color:#fff
    style MLflow fill:#f5a623,stroke:#333,color:#fff
    style HFHub fill:#999,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style OCIReg fill:#f5a623,stroke:#333,color:#fff
    style Skopeo fill:#999,stroke:#333,color:#fff
    style Torch fill:#e8e8e8,stroke:#333
    style Transformers fill:#e8e8e8,stroke:#333
    style Datasets fill:#e8e8e8,stroke:#333
    style EvalHubSDK fill:#e8e8e8,stroke:#333
    style Boto3 fill:#e8e8e8,stroke:#333
    style Olot fill:#e8e8e8,stroke:#333
    style Unitxt fill:#e8e8e8,stroke:#333
    style Accelerate fill:#e8e8e8,stroke:#333
