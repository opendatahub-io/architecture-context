graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        ClusterRoute["data-science-prometheus<br/>-cluster-proxy Route<br/>443/TCP HTTPS<br/>TLS Reencrypt"]
        PromRoute["data-science-prometheus<br/>-route<br/>443/TCP HTTPS<br/>TLS Reencrypt"]
        ThanosRoute["data-science-thanos<br/>-querier-route<br/>443/TCP HTTPS<br/>TLS Reencrypt"]
    end

    subgraph MonitoringNS["MONITORING NAMESPACE (NetworkPolicy enforced)"]
        direction TB

        subgraph OperatorPod["Operator Pod"]
            Controller["odh-observability Controller<br/>SA: controller-manager<br/>:8080 metrics (HTTP)<br/>:8081 health (HTTP)<br/>:9443 webhook (HTTPS/cert-manager)"]
        end

        subgraph MetricsStack["Metrics Stack"]
            ClusterProxy["cluster-proxy<br/>:8443/TCP HTTPS<br/>kube-rbac-proxy (SAR)<br/>SA: cluster-proxy"]
            NSProxy["namespace-proxy<br/>:8443/TCP HTTPS<br/>kube-rbac-proxy (SAR)<br/>+ prom-label-proxy<br/>SA: namespace-proxy"]
            PromOperated["prometheus-operated<br/>:9090/TCP HTTPS<br/>mTLS"]
        end

        subgraph TelemetryStack["Telemetry Pipeline"]
            OTelCollector["OpenTelemetry Collector<br/>:4317/TCP gRPC (OTLP)<br/>:4318/TCP HTTP (OTLP)<br/>:8889/TCP HTTPS (metrics)<br/>:8890/TCP HTTPS (self-mon)<br/>SA: collector"]
        end

        subgraph CorrelationStack["Correlation"]
            Korrel8r["Korrel8r<br/>:8443/TCP HTTPS<br/>kube-rbac-proxy (SAR)<br/>SA: korrel8r"]
        end
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        KubeAPI["kube-apiserver<br/>:6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS (reencrypt)<br/>OAuth / Bearer"| ClusterRoute
    User -->|"HTTPS/443<br/>TLS (reencrypt)<br/>OAuth / Bearer"| PromRoute
    User -->|"HTTPS/443<br/>TLS (reencrypt)<br/>OAuth / Bearer"| ThanosRoute

    %% Route to proxy flows
    ClusterRoute -->|"HTTPS/8443<br/>TLS (service-CA)<br/>kube-rbac-proxy SAR"| ClusterProxy
    PromRoute -->|"HTTPS/9090<br/>TLS (service-CA)"| PromOperated
    ThanosRoute -->|"HTTPS/9090<br/>TLS (service-CA)"| PromOperated

    %% Internal proxy flows
    ClusterProxy -->|"HTTPS/9090<br/>mTLS (client cert)"| PromOperated
    NSProxy -->|"HTTP/9091 (localhost)<br/>prom-label-proxy<br/>namespace injection"| PromOperated

    %% Telemetry flows
    OTelCollector -->|"HTTPS/9090<br/>TLS (service-CA)<br/>Remote write"| PromOperated

    %% Webhook flow
    KubeAPI -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>Admission call"| Controller

    %% Operator to API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| KubeAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class User external
    class ClusterRoute,PromRoute,ThanosRoute ingress
    class Controller,ClusterProxy,NSProxy,PromOperated,OTelCollector,Korrel8r monitoring
    class KubeAPI controlplane
