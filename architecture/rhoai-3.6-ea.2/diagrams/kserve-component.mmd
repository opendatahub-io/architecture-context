graph TB
    subgraph KServeModule["kserve-module-controller (Meta-Operator)"]
        ModuleCtrl["kserve-module-controller<br/>Watches Kserve CR<br/>Deploys sub-controllers"]
    end

    subgraph KServeControllers["KServe Controllers"]
        direction TB
        CtrlMgr["kserve-controller-manager<br/>InferenceService / InferenceGraph /<br/>TrainedModel reconciler"]
        LLMCtrl["llmisvc-controller<br/>LLMInferenceService /<br/>LLMInferenceServiceConfig reconciler"]
        LocalModelCtrl["localmodel-controller<br/>LocalModelCache /<br/>LocalModelNamespaceCache reconciler"]
        LocalModelAgent["localmodelnode-agent<br/>DaemonSet: per-node<br/>LocalModelNode reconciler"]
    end

    subgraph Webhooks["Admission Webhooks (16+)"]
        MutWebhook["Mutating Webhooks<br/>/mutate-pods<br/>/mutate-inferenceservice<br/>/mutate-llminferenceservice"]
        ValWebhook["Validating Webhooks<br/>/validate-inferenceservice<br/>/validate-clusterservingruntime<br/>/validate-inferencegraph<br/>/validate-localmodelcaches"]
        ConvWebhook["Conversion Webhook<br/>/convert (v1alpha1 to v1alpha2)"]
    end

    subgraph Sidecars["Sidecar / Init Containers"]
        StorageInit["storage-initializer<br/>Init container: model download<br/>S3 / GCS / Azure / HF / OCI"]
        AgentSidecar["agent<br/>Sidecar: continuous model sync"]
        QpExt["qpext<br/>Queue proxy metrics extension"]
        KubeRbac["kube-rbac-proxy<br/>TLS + AuthZ for /metrics"]
    end

    subgraph ModelServers["Model Server Catalog"]
        Router["router<br/>InferenceGraph routing"]
        HFServer["huggingfaceserver"]
        SklearnServer["sklearnserver"]
        PredictiveServer["predictiveserver<br/>sklearn + lgb + xgb"]
        AutoGluon["autogluonserver"]
    end

    subgraph PythonSDK["Python SDK"]
        SDK["kserve SDK<br/>Client library + Model server framework"]
        StorageLib["kserve-storage<br/>Multi-cloud storage handlers"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        ISCR["InferenceService CR"]
        LLMCR["LLMInferenceService CR"]
        IGCR["InferenceGraph CR"]
        SRCR["ClusterServingRuntime CR"]
        LMCR["LocalModelCache CR"]
        TMCR["TrainedModel CR"]
        KserveCR["Kserve CR<br/>(platform lifecycle)"]
    end

    %% Module controller deploys everything
    KserveCR -->|watched by| ModuleCtrl
    ModuleCtrl -->|deploys| CtrlMgr
    ModuleCtrl -->|deploys| LLMCtrl
    ModuleCtrl -->|deploys| LocalModelCtrl
    ModuleCtrl -->|deploys| LocalModelAgent
    ModuleCtrl -->|installs| CRDs
    ModuleCtrl -->|configures| Webhooks

    %% CR to controller mappings
    ISCR -->|reconciled by| CtrlMgr
    IGCR -->|reconciled by| CtrlMgr
    TMCR -->|reconciled by| CtrlMgr
    LLMCR -->|reconciled by| LLMCtrl
    LMCR -->|reconciled by| LocalModelCtrl
    SRCR -->|used by| CtrlMgr

    %% Controller creates workloads
    CtrlMgr -->|injects| StorageInit
    CtrlMgr -->|creates| ModelServers

    %% SDK relationship
    StorageLib -->|used by| StorageInit
    SDK -->|framework for| ModelServers

    %% Styling
    style ModuleCtrl fill:#4a90e2,color:#fff
    style CtrlMgr fill:#4a90e2,color:#fff
    style LLMCtrl fill:#4a90e2,color:#fff
    style LocalModelCtrl fill:#4a90e2,color:#fff
    style LocalModelAgent fill:#4a90e2,color:#fff
    style MutWebhook fill:#9b59b6,color:#fff
    style ValWebhook fill:#9b59b6,color:#fff
    style ConvWebhook fill:#9b59b6,color:#fff
    style StorageInit fill:#e67e22,color:#fff
    style AgentSidecar fill:#e67e22,color:#fff
    style QpExt fill:#e67e22,color:#fff
    style KubeRbac fill:#e67e22,color:#fff
    style ISCR fill:#f5a623
    style LLMCR fill:#f5a623
    style IGCR fill:#f5a623
    style SRCR fill:#f5a623
    style LMCR fill:#f5a623
    style TMCR fill:#f5a623
    style KserveCR fill:#f5a623
    style Router fill:#7ed321
    style HFServer fill:#7ed321
    style SklearnServer fill:#7ed321
    style PredictiveServer fill:#7ed321
    style AutoGluon fill:#7ed321
    style SDK fill:#3498db
    style StorageLib fill:#3498db
