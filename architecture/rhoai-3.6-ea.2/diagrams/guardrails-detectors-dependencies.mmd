graph LR
    GD["guardrails-detectors"]

    %% Internal Platform Dependencies
    GD -->|"InferenceService<br/>ServingRuntime CRDs"| KServe["KServe"]
    GD -->|"inbound HTTP<br/>detection requests"| FMSOrc["FMS Guardrails<br/>Orchestrator"]
    GD -->|"mTLS + auth<br/>enforcement"| Istio["Istio Service Mesh"]

    %% External Service Dependencies
    GD -->|"S3 API<br/>model weights"| MinIO["S3/MinIO<br/>9000/TCP"]
    GD -->|"HTTP<br/>LLM evaluations"| VLLM["vLLM Server"]

    %% Key Python Dependencies (built-in)
    subgraph BuiltInDeps["built-in Dependencies"]
        regex["regex >=2024.0.0"]
        jsonschema["jsonschema 4.24.0"]
        xmlschema["xmlschema 4.1.0"]
    end

    %% Key Python Dependencies (huggingface)
    subgraph HFDeps["huggingface Dependencies"]
        torch["torch >=2.11.0"]
        transformers["transformers >=5.3.0"]
        sentencepiece["sentencepiece 0.2.2"]
        tiktoken["tiktoken 0.13.0"]
    end

    %% Key Python Dependencies (llm_judge)
    subgraph JudgeDeps["llm_judge Dependencies"]
        vllm_judge["vllm-judge 0.1.8"]
    end

    %% Shared Python Dependencies
    subgraph SharedDeps["Shared Dependencies"]
        fastapi["fastapi 0.141.1"]
        uvicorn["uvicorn 0.34.0"]
        prom["prometheus-client >=0.18.0"]
        httpx["httpx 0.28.1"]
    end

    GD --- SharedDeps
    GD --- BuiltInDeps
    GD --- HFDeps
    GD --- JudgeDeps

    %% Integration Points (inbound)
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>/metrics"| GD

    style GD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style FMSOrc fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style MinIO fill:#f5a623,stroke:#333,color:#fff
    style VLLM fill:#f5a623,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style fastapi fill:#e8e8e8,stroke:#333
    style uvicorn fill:#e8e8e8,stroke:#333
    style prom fill:#e8e8e8,stroke:#333
    style httpx fill:#e8e8e8,stroke:#333
    style torch fill:#e8e8e8,stroke:#333
    style transformers fill:#e8e8e8,stroke:#333
    style sentencepiece fill:#e8e8e8,stroke:#333
    style tiktoken fill:#e8e8e8,stroke:#333
    style regex fill:#e8e8e8,stroke:#333
    style jsonschema fill:#e8e8e8,stroke:#333
    style xmlschema fill:#e8e8e8,stroke:#333
    style vllm_judge fill:#e8e8e8,stroke:#333
