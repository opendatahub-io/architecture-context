graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>curl / test harness / llm-d-router"]
    end

    subgraph Pod["POD BOUNDARY"]
        direction TB

        subgraph Main["llm-d-inference-sim (Main Container)"]
            direction TB
            CMux["cmux Listener<br/>8000/TCP<br/>HTTP + gRPC multiplexed"]

            subgraph HTTPEndpoints["HTTP Endpoints"]
                InferenceAPIs["/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/responses<br/>/v1/messages"]
                MgmtAPIs["/v1/models<br/>/v1/load_lora_adapter<br/>/v1/unload_lora_adapter"]
                OpsAPIs["/health<br/>/health/ready<br/>/metrics<br/>/admin/config"]
            end

            subgraph GRPCSvc["gRPC Service"]
                VllmGRPC["VllmEngine<br/>Generate, Embed,<br/>HealthCheck, Abort"]
            end

            ZMQPub["ZMQ Publisher<br/>5557/TCP<br/>KV cache events<br/>msgpack encoded"]
        end

        subgraph SidecarContainer["vllm-render Sidecar"]
            Render["vLLM Render Server<br/>8082/TCP<br/>HuggingFace Tokenization"]
        end

        CMux --> InferenceAPIs
        CMux --> MgmtAPIs
        CMux --> OpsAPIs
        CMux --> VllmGRPC
        Main -->|"HTTP :8082<br/>No encryption<br/>localhost"| SidecarContainer
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLMDRouter["llm-d-router<br/>ZMQ SUB<br/>No encryption"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>TLS, Bearer HF_TOKEN"]
        PromServer["Prometheus<br/>HTTP scrape<br/>Optional TLS"]
    end

    %% External flows
    Client -->|"HTTP+gRPC :8000<br/>Optional TLS 1.2+<br/>AEAD ciphers<br/>No Auth"| CMux
    ZMQPub -->|"ZMQ PUB :5557<br/>No encryption<br/>No auth<br/>msgpack KV events"| LLMDRouter
    Render -->|"HTTPS :443<br/>TLS<br/>Bearer HF_TOKEN"| HFHub
    PromServer -->|"HTTP :8000<br/>/metrics scrape<br/>Optional TLS"| OpsAPIs

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef main fill:#bbdefb,stroke:#1565c0,stroke-width:1px
    classDef sidecar fill:#c8e6c9,stroke:#2e7d32,stroke-width:1px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef endpoint fill:#e8eaf6,stroke:#3949ab,stroke-width:1px
    classDef zmq fill:#ffccbc,stroke:#bf360c,stroke-width:2px

    class Client external
    class LLMDRouter,HFHub,PromServer extsvc
    class ZMQPub zmq
