graph LR
    NemoGuardrails["NeMo Guardrails<br/>(FastAPI Server)"]

    %% Internal Platform Dependencies
    NemoGuardrails -->|"OpenAI-compatible API<br/>REST/HTTPS"| vLLM["vLLM / LLM Inference<br/>(RHOAI internal)"]

    %% External LLM Dependencies
    NemoGuardrails -->|"HTTPS/443<br/>Bearer token"| OpenAI["OpenAI-compatible<br/>LLM Provider"]
    NemoGuardrails -->|"HTTPS/443<br/>API key"| AzureOpenAI["Azure OpenAI"]
    NemoGuardrails -->|"HTTPS<br/>TLS/mTLS"| HFClassifier["Remote HF<br/>Classifier"]

    %% Core Framework Dependencies
    NemoGuardrails -->|"ASGI server"| Uvicorn["uvicorn >=0.23"]
    NemoGuardrails -->|"HTTP framework"| FastAPI["FastAPI >=0.103"]
    NemoGuardrails -->|"LLM client"| OpenAISDK["openai >=1.0,<3.0"]
    NemoGuardrails -->|"data models"| Pydantic["pydantic >=2.5,<3.0"]

    %% ML Model Dependencies
    NemoGuardrails -->|"inference"| PyTorch["torch >=2.0"]
    NemoGuardrails -->|"model loading"| Transformers["transformers >=4.35"]
    NemoGuardrails -->|"embeddings"| SentenceT["sentence-transformers >=2.2"]
    NemoGuardrails -->|"NLP pipeline"| SpaCy["spaCy >=3.4,<4.0"]
    NemoGuardrails -->|"ONNX inference"| ONNX["onnxruntime >=1.17"]

    %% Optional Dependencies
    NemoGuardrails -.->|"tracing (optional)"| OTel["OpenTelemetry<br/>>=1.27"]
    NemoGuardrails -.->|"PII detection (optional)"| Presidio["presidio-analyzer<br/>>=2.2"]
    NemoGuardrails -.->|"jailbreak patterns (optional)"| Yara["yara-python<br/>>=4.5,<5.0"]

    %% Colang Parser
    NemoGuardrails -->|"grammar parser"| Lark["lark >=1.1.7"]

    %% HTTP Clients
    NemoGuardrails -->|"async HTTP"| Aiohttp["aiohttp >=3.10"]
    NemoGuardrails -->|"HTTP client"| Httpx["httpx >=0.24"]

    %% Crypto
    NemoGuardrails -->|"TLS/crypto"| Cryptography["cryptography ==46.0.7"]

    %% Styling
    style NemoGuardrails fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style OpenAI fill:#f5a623,stroke:#333,color:#fff
    style AzureOpenAI fill:#f5a623,stroke:#333,color:#fff
    style HFClassifier fill:#f5a623,stroke:#333,color:#fff
