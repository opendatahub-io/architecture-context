graph LR
    BatchGW["llm-d-batch-gateway<br/>(API Server · Processor · GC)"]

    %% External Dependencies (required)
    BatchGW -->|"metadata storage<br/>pgx v5"| PostgreSQL["PostgreSQL<br/>(pgx/v5)"]
    BatchGW -->|"priority queue<br/>events · status"| Redis["Redis / Valkey<br/>(go-redis/v9)"]
    BatchGW -->|"file storage<br/>AWS SDK v2"| S3["S3-compatible Storage<br/>(aws-sdk-go-v2)"]

    %% Internal Platform Dependencies
    BatchGW -->|"dispatch inference<br/>HTTP/HTTPS · AIMD"| InfGW["llm-d Inference Gateway"]
    BatchGW -.->|"async dispatch mode<br/>Go library"| LLMDAsync["llm-d-async"]

    %% Infrastructure Dependencies
    BatchGW -->|"pod watching<br/>client-go"| K8sAPI["Kubernetes API<br/>(client-go v0.36)"]
    BatchGW -.->|"TLS certificates"| CertManager["cert-manager"]
    BatchGW -.->|"external exposure"| GatewayAPI["Gateway API<br/>(HTTPRoute)"]

    %% Observability Dependencies
    BatchGW -.->|"distributed tracing<br/>OTLP/gRPC"| OTel["OpenTelemetry Collector<br/>(OTel SDK v1.47)"]
    BatchGW -.->|"metrics scraping<br/>/metrics endpoints"| Prometheus["Prometheus<br/>(client_golang v1.24)"]

    %% Consumers
    Dashboard["ODH Dashboard /<br/>RHOAI Console"] -.->|"batch job UI"| BatchGW
    Pipelines["Data Science<br/>Pipelines"] -.->|"batch inference<br/>automation"| BatchGW

