graph TD
    subgraph "Starter Kit Authentication"
        direction TB

        Client["External Client<br/>(sends Bearer token)"]
        AuthMiddleware["auth_wrapper<br/>_BearerAuthMiddleware<br/>(ASGI Middleware)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
        TokenReview["TokenReview API<br/>(authentication.k8s.io/v1)"]

        Client -->|"Bearer token /<br/>X-Api-Key header"| AuthMiddleware
        AuthMiddleware -->|"POST /apis/authentication.k8s.io/v1/tokenreviews<br/>Auth: K8S_REVIEWER_TOKEN"| K8sAPI
        K8sAPI -->|validates| TokenReview
        TokenReview -->|"authenticated: true/false<br/>username, groups"| AuthMiddleware
    end

    subgraph "Access Control"
        direction TB

        SACheck{"ALLOWED_SA_USERNAME<br/>set?"}
        Allow["Access Granted<br/>(request forwarded to FastAPI)"]
        Deny["Access Denied<br/>(401 / 403)"]
        SAMatch{"Username matches<br/>ALLOWED_SA_USERNAME?"}

        AuthMiddleware -->|"token valid"| SACheck
        AuthMiddleware -->|"token invalid"| Deny
        SACheck -->|"not set"| Allow
        SACheck -->|"set"| SAMatch
        SAMatch -->|"yes"| Allow
        SAMatch -->|"no"| Deny
    end

    subgraph "ServiceAccount Requirements"
        direction TB

        ReviewerSA["K8S_REVIEWER_TOKEN<br/>ServiceAccount with<br/>TokenReview permissions"]
        CallerSA["Caller ServiceAccount<br/>(token being validated)"]

        ReviewerSA -.->|"must have permission to<br/>create tokenreviews"| K8sAPI
        CallerSA -.->|"token submitted for<br/>validation"| AuthMiddleware
    end

    subgraph "Core Library (No RBAC)"
        direction TB

        NoRBAC["ai4rag Core Library<br/>No Kubernetes RBAC<br/>(Python library, not an operator)<br/>No ClusterRoles or RoleBindings"]
    end

    style Client fill:#f9f9f9,stroke:#999
    style AuthMiddleware fill:#d0021b,color:#fff
    style K8sAPI fill:#f5a623
    style TokenReview fill:#f5a623
    style Allow fill:#7ed321
    style Deny fill:#d0021b,color:#fff
    style SACheck fill:#4a90e2,color:#fff
    style SAMatch fill:#4a90e2,color:#fff
    style ReviewerSA fill:#e8e8e8
    style CallerSA fill:#e8e8e8
    style NoRBAC fill:#f0f0f0,stroke:#ccc
