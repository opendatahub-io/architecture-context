graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>443/TCP &rarr; 8080/8443/TCP<br/>TLS 1.2+ SIMPLE<br/>HTTPRoute per module"]
    end

    subgraph AppLayer["APPLICATION LAYER"]
        direction TB

        subgraph CoreBFF_NS["Core BFF"]
            CoreBFF["core-bff<br/>SA: odh-core-bff<br/>8080/TCP HTTP<br/>Module Fed Host + Reverse Proxy"]
        end

        subgraph Legacy_NS["Legacy Backend"]
            KRBP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>OpenShift OAuth"]
            NodeBE["Node.js Fastify<br/>8080/TCP HTTP<br/>localhost only"]
            KRBP --> NodeBE
        end
    end

    subgraph ModuleLayer["FEDERATED MODULES (service-serving-cert TLS)"]
        direction TB

        GenAI["gen-ai BFF<br/>8143/TCP HTTPS<br/>Bearer Token"]
        ModelRegBFF["model-registry BFF<br/>8143/TCP HTTPS<br/>Bearer Token"]
        MaaSBFF["maas BFF<br/>8243/TCP HTTPS<br/>Bearer Token"]
        EvalHubBFF["eval-hub BFF<br/>8143/TCP HTTPS<br/>Bearer Token"]
        MLflowBFF["mlflow BFF<br/>8343/TCP HTTPS<br/>Bearer Token"]
        AgentOpsBFF["agent-ops BFF<br/>8143/TCP HTTPS<br/>Bearer + SSAR"]
        NotebooksBFF["notebooks BFF<br/>8143/TCP HTTPS<br/>Bearer Token"]
    end

    subgraph OperatorZone["OPERATOR"]
        Operator["dashboard-operator<br/>SA: odh-dashboard-operator<br/>Webhook: 9443/TCP HTTPS cert-manager<br/>Metrics: 8443/TCP HTTPS cert-manager<br/>Health: 8081/TCP HTTP"]
    end

    subgraph K8sZone["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+<br/>Bearer / SA / Impersonation"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Egress)"]
        DSP["DataScience Pipelines<br/>8443/TCP HTTPS<br/>Bearer Token"]
        MR["Model Registry API<br/>8443/TCP HTTPS<br/>Bearer Token"]
        KServe["KServe<br/>HTTPS varies<br/>Bearer Token"]
        MLMD["MLMD<br/>8443/TCP gRPC-web<br/>Bearer Token"]
        TrustyAI["TrustyAI<br/>443/TCP HTTPS<br/>Bearer Token"]
        LlamaStack["Llama Stack<br/>HTTPS varies<br/>Bearer / API Key"]
        Prometheus["Prometheus/Thanos<br/>9092/TCP HTTPS<br/>Bearer Token"]
        MCPServers["MCP Servers<br/>SSE/HTTP varies"]
    end

    %% External to Ingress
    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway

    %% Ingress to App Layer
    Gateway -->|"HTTP/8080<br/>x-forwarded-access-token"| CoreBFF
    Gateway -->|"HTTPS/8443<br/>OpenShift OAuth"| KRBP

    %% Core BFF to Modules
    CoreBFF -->|"HTTPS/8143<br/>TLS svc-serving-cert<br/>Internal SA Token"| GenAI
    CoreBFF -->|"HTTPS/8143<br/>TLS svc-serving-cert<br/>Internal SA Token"| ModelRegBFF
    CoreBFF -->|"HTTPS/8243<br/>TLS svc-serving-cert<br/>Internal SA Token"| MaaSBFF
    CoreBFF -->|"HTTPS/8143<br/>TLS svc-serving-cert"| NotebooksBFF

    %% App to K8s API
    CoreBFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>Token Impersonation"| K8sAPI
    NodeBE -->|"HTTPS/6443<br/>TLS 1.2+<br/>Token Impersonation"| K8sAPI
    GenAI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Token Impersonation"| K8sAPI
    ModelRegBFF -->|"HTTPS/6443<br/>TLS 1.2+"| K8sAPI
    AgentOpsBFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>Token + SSAR"| K8sAPI

    %% Operator to K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% BFF to Platform Services
    CoreBFF -->|"HTTPS/8443<br/>Bearer Token"| DSP
    CoreBFF -->|"HTTPS/8443<br/>Bearer Token"| MR
    CoreBFF -->|"HTTPS varies<br/>Bearer Token"| KServe
    CoreBFF -->|"gRPC-web/8443<br/>Bearer Token"| MLMD
    GenAI -->|"HTTPS varies<br/>Bearer/API Key"| LlamaStack
    GenAI -->|"SSE/HTTP varies"| MCPServers
    EvalHubBFF -->|"HTTPS/443<br/>Bearer Token"| TrustyAI
    CoreBFF -->|"HTTPS/9092<br/>Bearer Token"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef module fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef k8s fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Gateway ingress
    class CoreBFF,KRBP,NodeBE app
    class GenAI,ModelRegBFF,MaaSBFF,EvalHubBFF,MLflowBFF,AgentOpsBFF,NotebooksBFF module
    class Operator operator
    class K8sAPI k8s
    class DSP,MR,KServe,MLMD,TrustyAI,LlamaStack,Prometheus,MCPServers platform
