graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS Credentials"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN Bearer"]
    end

    subgraph CIEnv["CI ENVIRONMENT (Trusted)"]
        TestBin["Go Test Binary<br/>(e2e-test-image)<br/>SA: cluster-admin"]
    end

    subgraph ClusterControl["CLUSTER CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
    end

    subgraph Monitoring["MONITORING (Cluster-Internal)"]
        Prom["Prometheus API<br/>9090/TCP HTTPS<br/>TLS (InsecureSkipVerify in tests)"]
    end

    subgraph TestNS["TEST NAMESPACE (Ephemeral)"]
        direction TB

        subgraph KFTOWorkloads["KFTO v1 Workloads"]
            PyTorchJob["PyTorchJob Pods"]
        end

        subgraph TrainerWorkloads["Trainer v2 Workloads"]
            TrainJob["TrainJob / JobSet Pods"]
        end

        subgraph RayWorkloads["Ray Workloads"]
            RayHead["Ray Head Node<br/>8265/TCP HTTP(S)"]
            RayWorkers["Ray Worker Nodes"]
            RayHead --- RayWorkers
        end

        subgraph MPICluster["MPI Cluster"]
            Launcher["MPI Launcher Pod"]
            Workers["MPI Worker Pods<br/>2222/TCP SSH"]
        end

        subgraph ExampleServices["Example Services (Non-Production)"]
            MinIO["MinIO<br/>9000/TCP HTTP<br/>9090/TCP HTTP<br/>Auth: MinIO credentials"]
            NFS["NFS Server<br/>2049/TCP NFS<br/>111/UDP RPC"]
        end
    end

    subgraph ExampleIngress["EXAMPLE INGRESS (Non-Production)"]
        MinIORoute["MinIO Routes<br/>HTTPS Edge TLS"]
    end

    %% CI to cluster
    TestBin -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Test binary to monitoring
    TestBin -->|"HTTPS/9090<br/>InsecureSkipVerify"| Prom

    %% Test binary to Ray dashboard
    TestBin -->|"HTTP(S)/8265<br/>InsecureSkipVerify"| RayHead

    %% Test binary to external
    TestBin -->|"HTTPS/443<br/>AWS credentials"| S3

    %% Workloads to external
    PyTorchJob -->|"HTTPS/443<br/>HF_TOKEN"| HF
    TrainJob -->|"HTTPS/443<br/>HF_TOKEN"| HF
    PyTorchJob -->|"HTTPS/443<br/>AWS credentials"| S3
    TrainJob -->|"HTTPS/443<br/>AWS credentials"| S3

    %% MPI internal
    Launcher -->|"SSH/2222<br/>Auto SSH keys"| Workers
    Workers ---|"MPI Dynamic Ports<br/>RDMA/InfiniBand<br/>No Encryption"| Workers

    %% Example services
    MinIORoute -->|"Edge TLS"| MinIO

    %% Styling
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef ci fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef control fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef monitoring fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef workload fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef example fill:#f5f5f5,stroke:#999,stroke-width:1px,stroke-dasharray:5 5
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class S3,HF external
    class TestBin ci
    class K8sAPI control
    class Prom monitoring
    class PyTorchJob,TrainJob,RayHead,RayWorkers,Launcher,Workers workload
    class MinIO,NFS example
    class MinIORoute ingress
