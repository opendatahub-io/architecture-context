graph TB
    subgraph External["EXTERNAL (User / CI)"]
        User["User / CI Pipeline"]
    end

    subgraph CLIHost["CLI HOST"]
        CLI["llmdbenchmark CLI<br/>Python 3.14+<br/>Jinja2 Template Rendering"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS<br/>Auth: kubeconfig / SA"]

        subgraph Namespace["Namespace: hc4ai-operator"]
            direction TB
            Harness["Benchmark Harness StatefulSet<br/>Image: ghcr.io/llm-d/llm-d-benchmark<br/>8080/TCP (ClusterIP, no TLS)<br/>20873/TCP (rsync)"]
            PVC["Local PVC<br/>(Results Storage)"]
        end

        Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>TLS edge termination"]

        subgraph InferenceNS["Target Namespace"]
            LLMEndpoint["vLLM Inference Endpoint<br/>8000-8200/TCP<br/>HTTP/HTTPS (varies)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS TLS<br/>Auth: Google ADC"]
        Prism["Prism Proxy<br/>prism.llm-d.ai<br/>443/TCP HTTPS TLS<br/>Auth: Bearer (optional)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS TLS<br/>Auth: Bearer HF_TOKEN"]
        TelemetryEP["Telemetry Endpoint<br/>HTTPS TLS<br/>Auth: Google Auth / Bearer"]
    end

    %% Flows
    User -->|local invocation| CLI
    CLI -->|"HTTPS/443<br/>TLS<br/>kubeconfig / SA token"| K8sAPI
    K8sAPI -->|deploys / manages| Harness
    CLI -->|"kubectl exec<br/>pods/exec RBAC"| Harness
    Harness -->|"HTTP(S)/8000-8200<br/>Encryption varies<br/>None / Bearer"| LLMEndpoint
    Harness -->|writes results| PVC
    Route -->|"443→8080<br/>TLS edge"| Harness
    CLI -->|"HTTPS/443<br/>TLS<br/>Google ADC"| GCS
    CLI -->|"HTTPS/443 (fallback)<br/>TLS<br/>Bearer token"| Prism
    Prism -->|"HTTPS/443<br/>TLS<br/>Service credentials"| GCS
    CLI -->|"HTTPS/443<br/>TLS<br/>Bearer HF_TOKEN"| HFHub
    CLI -.->|"HTTPS<br/>TLS<br/>Google Auth / Bearer"| TelemetryEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef clihost fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef namespace fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef route fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class CLI clihost
    class K8sAPI cluster
    class Harness,PVC namespace
    class Route route
    class LLMEndpoint namespace
    class GCS,Prism,HFHub,TelemetryEP externalservice
