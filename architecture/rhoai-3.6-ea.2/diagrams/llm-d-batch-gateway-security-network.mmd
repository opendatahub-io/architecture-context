graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>X-MaaS-Username header"]
    end

    subgraph Ingress["INGRESS (Optional)"]
        HTTPRoute["Gateway API HTTPRoute<br/>8000/TCP<br/>TLS: Gateway-dependent"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Namespace: release-namespace)"]
        direction TB

        subgraph APIServerZone["API Server"]
            APIServer["batch-gateway-apiserver<br/>SA: batch-gateway-apiserver<br/>8000/TCP (API) · 8081/TCP (obs)<br/>Optional TLS 1.2+"]
        end

        subgraph ProcessorZone["Processor"]
            Processor["batch-gateway-processor<br/>SA: batch-gateway-processor<br/>9090/TCP (obs)<br/>StatefulSet · AIMD concurrency"]
        end

        subgraph GCZone["Garbage Collector"]
            GCPod["batch-gateway-gc<br/>SA: batch-gateway-gc<br/>9091/TCP (metrics)<br/>Deployment · replicas: 1"]
        end
    end

    subgraph DataServices["DATA SERVICES"]
        PostgreSQL["PostgreSQL<br/>TCP<br/>Connection string auth"]
        Redis["Redis / Valkey<br/>TCP<br/>URL auth"]
        S3["S3-compatible Storage<br/>HTTP/HTTPS<br/>AWS SDK credentials"]
    end

    subgraph InferenceServices["INFERENCE SERVICES"]
        InfGW["llm-d Inference Gateway<br/>HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>Optional API key"]
    end

    subgraph Infrastructure["INFRASTRUCTURE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable encryption"]
    end

    %% External flows
    Client -->|"HTTP/HTTPS 8000<br/>Optional TLS 1.2+<br/>No built-in auth"| HTTPRoute
    HTTPRoute -->|"HTTP/HTTPS 8000"| APIServer

    %% API Server egress
    APIServer -->|"TCP<br/>Connection string"| PostgreSQL
    APIServer -->|"TCP<br/>URL auth"| Redis
    APIServer -->|"HTTP/HTTPS<br/>AWS creds"| S3

    %% Processor egress
    Processor -->|"TCP<br/>URL auth"| Redis
    Processor -->|"TCP<br/>Connection string"| PostgreSQL
    Processor -->|"HTTP/HTTPS<br/>AWS creds"| S3
    Processor -->|"HTTP/HTTPS<br/>Optional TLS/mTLS<br/>Optional API key"| InfGW

    %% GC egress
    GCPod -->|"TCP<br/>Connection string"| PostgreSQL
    GCPod -->|"HTTP/HTTPS<br/>AWS creds"| S3
    GCPod -->|"HTTPS 6443<br/>SA token<br/>pods,statefulsets: get,list,watch"| K8sAPI

    %% Observability
    APIServer -.->|"OTLP/gRPC<br/>traces"| OTel
    Processor -.->|"OTLP/gRPC<br/>traces"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef dataservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef infra fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class HTTPRoute ingress
    class APIServer,Processor,GCPod internal
    class PostgreSQL,Redis,S3 dataservice
    class InfGW inference
    class K8sAPI,OTel infra
