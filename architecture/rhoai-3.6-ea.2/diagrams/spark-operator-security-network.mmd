graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443→9443/TCP"]

        subgraph WebhookDeploy["Webhook Deployment"]
            Webhook["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>9443/TCP TLS<br/>Self-provisioned cert<br/>FailurePolicy: Fail"]
        end

        subgraph ControllerDeploy["Controller Deployment"]
            Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>8080/TCP metrics (HTTP)<br/>8081/TCP health (HTTP)"]
        end

        subgraph ModuleDeploy["Module Controller Deployment"]
            ModuleCtrl["spark-operator-module-controller<br/>SA: spark-operator-module-controller-manager<br/>8081/TCP health (HTTP)"]
        end

        WebhookCert["Secret: spark-operator-webhook-certs<br/>kubernetes.io/tls<br/>Self-provisioned, auto-rotate"]
    end

    subgraph TenantNS["TENANT NAMESPACES (per-user)"]
        direction TB

        subgraph SparkPods["Spark Workload Pods"]
            Driver["Spark Driver Pod<br/>SA: spark-operator-spark<br/>7078/TCP driver-rpc<br/>4040/TCP Spark UI"]
            Executors["Spark Executor Pods<br/>7079/TCP blockmanager"]
            ConnectPod["SparkConnect Pod<br/>15002/TCP gRPC"]
        end

        NetPol["NetworkPolicy<br/>Allows: 7078, 7079, 4040, 15002<br/>Spark pod selector"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        CertMgr["cert-manager<br/>Certificate & Issuer CRs"]
        PromOp["prometheus-operator<br/>PodMonitor CRs"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer token"| K8sAPI

    %% Admission flow
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (self-provisioned)<br/>Admission review"| WebhookSvc
    WebhookSvc --> Webhook
    Webhook -.->|reads| WebhookCert

    %% Controller flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Webhook -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Module controller flows
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ModuleCtrl -.->|manages| CertMgr
    ModuleCtrl -.->|manages| PromOp

    %% Spark pod flows
    K8sAPI -->|"creates"| Driver
    K8sAPI -->|"creates"| Executors
    Driver -->|"TCP/7079<br/>blockmanager"| Executors
    Executors -->|"TCP/7078<br/>driver-rpc"| Driver
    User -->|"gRPC/15002"| ConnectPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class User external
    class K8sAPI controlplane
    class Controller,Webhook,ModuleCtrl,WebhookSvc operator
    class Driver,Executors,ConnectPod,NetPol tenant
    class CertMgr,PromOp platform
    class WebhookCert secret
