graph LR
    MLMD["ML Metadata<br/>(metadata_store_server)"]

    %% Build-Time Dependencies
    MLMD -.->|build system| Bazel["Bazel 6.3.2"]
    MLMD -.->|serialization| Protobuf["Protobuf<br/>(bundled via Bazel)"]
    MLMD -.->|SQL parsing| ZetaSQL["ZetaSQL<br/>(bundled via Bazel)"]

    %% Runtime Dependencies - Database Backends
    MLMD -->|"3306/TCP<br/>MySQL protocol"| MySQL["MySQL / MariaDB"]
    MLMD -->|"5432/TCP<br/>PostgreSQL protocol"| PostgreSQL["PostgreSQL"]
    MLMD -->|local file| SQLite["SQLite"]

    %% Runtime Dependencies - Libraries
    MLMD -->|RPC framework| gRPC["gRPC C++<br/>(bundled via Bazel)"]
    MLMD -->|MySQL client| MariaDBConn["MariaDB Connector/C<br/>(bundled via Bazel)"]
    MLMD -->|PG client| libpq["libpq<br/>(bundled via Bazel)"]

    %% Internal RHOAI Integrations (consumers of MLMD)
    DSP["Data Science Pipelines"] -->|"gRPC/8080<br/>metadata recording"| MLMD

    %% Python Client Dependencies
    subgraph PythonClient["ml_metadata Python Library"]
        grpcio["grpcio >=1.8.6,<2"]
        protobufPy["protobuf >=3.13,<4"]
        abslpy["absl-py >=0.9,<2.0.0"]
        attrs["attrs >=20.3,<24"]
    end

    PythonClient -->|"gRPC or SWIG"| MLMD

    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Bazel fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style ZetaSQL fill:#999,stroke:#333
    style gRPC fill:#999,stroke:#333
    style MariaDBConn fill:#999,stroke:#333
    style libpq fill:#999,stroke:#333
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style grpcio fill:#9ecae1,stroke:#333
    style protobufPy fill:#9ecae1,stroke:#333
    style abslpy fill:#9ecae1,stroke:#333
    style attrs fill:#9ecae1,stroke:#333
