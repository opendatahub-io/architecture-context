graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        Route["OpenShift Route<br/>443/TCP edge TLS<br/>Target: Service 8080/TCP"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Namespace: ${NAMESPACE})"]
        direction TB

        subgraph SidecarPod["StatefulSet: llm-d-routing-sidecar (replicas: 1)"]
            Proxy["Routing Sidecar<br/>Port: 8000/TCP HTTPS<br/>TLS 1.2+ AEAD ciphers<br/>UID: 65532"]
            Allowlist["AllowlistValidator<br/>SSRF Protection<br/>(optional, off by default)"]
        end

        Service["Service: ClusterIP<br/>8080/TCP HTTPS"]

        subgraph DecoderPod["Co-located Pod"]
            Decoder["vLLM Decoder<br/>8001/TCP HTTP/HTTPS<br/>TLS 1.2+ (optional)"]
        end
    end

    subgraph RemoteNamespace["Remote Namespace"]
        Prefiller["Remote Prefiller Pod<br/>vLLM Prefiller<br/>configurable port HTTP/HTTPS<br/>TLS 1.2+ (optional)"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS (edge)<br/>Auth: None"| Route

    %% Ingress to Service
    Route -->|"HTTPS/8080<br/>TLS 1.2+<br/>Auth: None"| Service
    Service --> Proxy

    %% Sidecar to Prefiller (Phase 1)
    Proxy -->|"HTTP(S)/configurable<br/>TLS 1.2+ (optional)<br/>Auth: None<br/>Payload: max_tokens=1"| Prefiller

    %% Sidecar to Decoder (Phase 2)
    Proxy -->|"HTTP(S)/8001<br/>TLS 1.2+ (optional)<br/>Auth: None<br/>Payload: body + kv_transfer_params"| Decoder

    %% Allowlist to K8s API
    Allowlist -->|"HTTPS/6443<br/>TLS 1.2+<br/>Auth: ServiceAccount token<br/>Watch: InferencePool + Pods"| K8sAPI
    K8sAPI --- InferencePool

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef clusterinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Proxy,Decoder,Service clusterinternal
    class Allowlist security
    class Prefiller clusterinternal
    class K8sAPI,InferencePool controlplane
