graph TB
    subgraph "odh-gitops GitOps Configuration"
        direction TB

        subgraph KustomizePath["Kustomize Path (OpenShift)"]
            Components["Kustomize Components<br/>(components/operators/)"]
            Dependencies["Dependencies Overlay<br/>(dependencies/operators/)"]
            Configurations["Post-Install Configs<br/>(configurations/)"]
            Components -->|composed into| Dependencies
            Dependencies -->|applied before| Configurations
        end

        subgraph OCPChart["rhai-on-openshift-chart (v3.4.0)"]
            Helpers["_helpers.tpl<br/>shouldInstall / profiles"]
            OperatorTpl["_operator.tpl<br/>OLM Templates"]
            DSC["DataScienceCluster CR"]
            DSCI["DSCInitialization CR"]
            DepTemplates["Dependency Templates<br/>(per-operator)"]
            Helpers -->|gates| DepTemplates
            Helpers -->|configures| DSC
            OperatorTpl -->|renders| DepTemplates
        end

        subgraph XKSChart["rhai-on-xks-chart (v3.5.0)"]
            CRDefs["_crs-definitions.tpl<br/>Provider & CR Registries"]
            HelmHooks["Helm Post-Install Hooks"]
            GatewayScript["create-gateway.sh"]
            MaaSScript["create-maas-gateway.sh"]
            CloudMgr["Cloud Manager Operator<br/>(AWS/Azure/CoreWeave)"]
            RHAIOp["RHAI Operator<br/>(Direct Deploy)"]
            HelmHooks -->|executes| GatewayScript
            HelmHooks -->|executes| MaaSScript
            CRDefs -->|defines| HelmHooks
        end

        subgraph Subcharts["Bundled Subcharts (XKS)"]
            CertMgr["cert-manager-operator"]
            GatewayAPI["gateway-api"]
            SailOp["sail-operator"]
            LWSOp["lws-operator"]
            RHCLOp["rhcl-operator"]
        end

        ValidationScripts["Validation Scripts<br/>(Kustomize/Helm/Lint)"]
    end

    Admin["Administrator"] -->|kubectl apply -k| KustomizePath
    Admin -->|helm install| OCPChart
    Admin -->|helm install| XKSChart

    XKSChart -->|includes| Subcharts

    %% External targets
    OCPChart -->|OLM Subscription| OLM["OLM<br/>(Operator Lifecycle Manager)"]
    KustomizePath -->|OLM Subscription| OLM
    XKSChart -->|direct deploy| K8sAPI["Kubernetes API"]

    %% Profiles
    Profiles["Profiles<br/>default / rhaii / maas"] -.->|selects defaults| Helpers

    %% Styling
    style KustomizePath fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style OCPChart fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style XKSChart fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Subcharts fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style Admin fill:#f9f9f9,stroke:#999
    style OLM fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style Profiles fill:#ffe6cc,stroke:#d79b00
