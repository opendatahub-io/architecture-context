graph TD
    subgraph Note["RBAC Management"]
        direction TB
        Info["Note: No RBAC manifests in the<br/>trustyai-service repository.<br/>RBAC is managed externally by<br/>the TrustyAI Operator."]
    end

    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB

        subgraph Port8081["Port 8081 — Main API"]
            Auth8081["Auth: Bearer Token<br/>Enforcement: kube-rbac-proxy sidecar<br/>Policy: Kubernetes RBAC<br/>(SubjectAccessReview)"]
        end

        subgraph Port4443["Port 4443 — Optional HTTPS"]
            Auth4443["Auth: TLS Client Certificates (optional)<br/>Enforcement: Hypercorn TLS<br/>Policy: System crypto policy<br/>(PolicyAwareConfig)"]
        end

        subgraph Port8080["Port 8080 — Health & Consumer"]
            Auth8080["Auth: None<br/>Enforcement: None<br/>Policy: Open to cluster network<br/>Risk: Relies on NetworkPolicy"]
        end
    end

    subgraph Secrets["Secrets & Credentials"]
        direction TB
        DBPass["DATABASE_PASSWORD<br/>Type: env var<br/>Purpose: MariaDB auth<br/>Provisioned by: Operator<br/>Auto-rotate: No"]
        LegacyDBPass["QUARKUS_DATASOURCE_PASSWORD<br/>Type: env var<br/>Purpose: Legacy MariaDB auth<br/>Provisioned by: Operator<br/>Auto-rotate: No"]
        TLSCert["TLS cert/key<br/>Path: /etc/tls/internal/<br/>Purpose: HTTPS endpoint<br/>Provisioned by: cert-manager<br/>Auto-rotate: Yes"]
        DBCACert["DATABASE_TLS_CA_CERT<br/>Path: /etc/tls/db/ca.crt<br/>Purpose: MariaDB TLS CA<br/>Provisioned by: Platform<br/>Auto-rotate: No"]
    end

    %% Styling
    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style AuthModel fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Port8081 fill:#d5e8d4,stroke:#82b366
    style Port4443 fill:#d5e8d4,stroke:#82b366
    style Port8080 fill:#f8cecc,stroke:#b85450
    style Secrets fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
