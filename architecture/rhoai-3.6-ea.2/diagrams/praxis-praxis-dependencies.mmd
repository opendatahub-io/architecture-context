graph LR
    Praxis["Praxis Proxy<br/>v0.7.3"]

    %% Core Engine Dependencies
    Praxis -->|"proxy engine"| Pingora["Pingora 0.10.0<br/>(quixotic-plecostomus fork)<br/>core, http, proxy"]

    %% Crypto Dependencies
    Praxis -->|"TLS protocol"| Rustls["rustls 0.23.45<br/>No built-in crypto provider"]
    Praxis -->|"crypto provider"| RustlsOpenSSL["rustls-openssl 0.4.1<br/>OpenSSL-backed provider"]
    Praxis -->|"system crypto"| OpenSSL["OpenSSL 0.10.81<br/>Never vendored"]

    %% Runtime Dependencies
    Praxis -->|"async runtime"| Tokio["tokio 1.53.1"]
    Praxis -->|"allocator (Unix)"| Jemalloc["tikv-jemallocator 0.7.0"]

    %% Config Dependencies
    Praxis -->|"config parsing"| Serde["serde / serde_yaml<br/>1.0.229 / 0.10.7"]
    Praxis -->|"CLI parsing"| Clap["clap 4.6.7"]

    %% Observability Dependencies
    Praxis -->|"metrics"| Metrics["metrics 0.24.6<br/>metrics-exporter-prometheus 0.18.3"]
    Praxis -->|"tracing"| Tracing["tracing 0.1.44"]
    Praxis -.->|"distributed tracing<br/>(optional)"| OTel["opentelemetry 0.33.0"]

    %% Optional Dependencies
    Praxis -.->|"config hot-reload<br/>(optional)"| Notify["notify 8.2.0"]
    Praxis -.->|"AI policy engine<br/>(optional, not in FIPS)"| PolicyEngine["praxis-policy 0.4.0<br/>(ppe)"]
    Praxis -.->|"SPIFFE identity<br/>(experimental)"| SPIFFE["spiffe 0.16.1"]

    %% Integration Points
    UpstreamServices["Upstream Services"] -->|"proxied traffic"| Praxis
    Prometheus["Prometheus"] -->|"scrape /metrics"| Praxis
    OTelCollector["OTel Collector"] -.->|"OTLP export"| Praxis
    PraxisAI["praxis-proxy/ai<br/>AI Gateway Extension"] -.->|"compile-time<br/>extension"| Praxis

    %% Styling
    style Praxis fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Pingora fill:#999,stroke:#333,color:#fff
    style Rustls fill:#999,stroke:#333,color:#fff
    style RustlsOpenSSL fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#e74c3c,stroke:#333,color:#fff
