graph TB
    subgraph Internal["INTERNAL (llm-d Platform)"]
        Router["llm-d Router / Scheduler<br/>Queries server metadata<br/>for routing decisions"]
    end

    subgraph VLLMServer["vLLM INFERENCE SERVER (Port 8000/TCP)"]
        direction TB

        subgraph Plugins["llm-d-api-extensions Plugins<br/>(opt-in via VLLM_PLUGINS env)"]
            ConfigPlugin["ServerConfigPlugin<br/>GET /config<br/>required_tasks = None<br/>Redacts kv_connector_extra_config"]
            DevicesPlugin["ServerDevicesPlugin<br/>GET /devices<br/>required_tasks = ENGINE_TASKS<br/>503 if no engine"]
            KVCachePlugin["ServerKVCachePlugin<br/>GET /kv-cache<br/>required_tasks = ENGINE_TASKS<br/>503 if no engine"]
        end

        subgraph VLLMInternal["vLLM Internals (In-Process)"]
            VllmConfig["VllmConfig"]
            EngineClient["EngineClient"]
            Workers["Workers<br/>(DeviceInfoWorkerExtension)"]
        end

        ConfigPlugin -->|"In-process read"| VllmConfig
        DevicesPlugin -->|"In-process API"| EngineClient
        KVCachePlugin -->|"In-process API"| EngineClient
        EngineClient -->|"collective_rpc<br/>In-process"| Workers
    end

    %% Network flows
    Router -->|"HTTP/8000<br/>Platform-dependent encryption<br/>No plugin-level auth<br/>GET only (read-only)"| Plugins

    %% Notes
    NoEgress["No outbound network<br/>connections from this library"]

    Plugins -.->|"All data from<br/>in-process state"| NoEgress

    %% Styling
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef plugin fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef vllminternal fill:#f5f5f5,stroke:#999,stroke-width:1px
    classDef noegress fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5

    class Router internal
    class ConfigPlugin,DevicesPlugin,KVCachePlugin plugin
    class VllmConfig,EngineClient,Workers vllminternal
    class NoEgress noegress
