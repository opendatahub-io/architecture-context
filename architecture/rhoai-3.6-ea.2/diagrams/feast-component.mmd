graph TB
    subgraph FeastOperator["Feast Operator (Go, controller-runtime)"]
        Controller["FeatureStore Reconciler<br/>Go 1.25"]
        NotebookReconciler["NotebookConfigMap Reconciler"]
        TLSBootstrap["TLS Bootstrap<br/>(OpenShift TLS Profile)"]
        LeaderElect["Leader Election"]
        MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS"]
        HealthProbe["Health Probes<br/>8081/TCP"]
    end

    subgraph FeatureServerPython["Feature Server - Python (FastAPI/Starlette)"]
        OnlineServing["Online Serving API<br/>POST /get-online-features"]
        RegistryAPI["Registry REST API<br/>100+ endpoints"]
        LineageAPI["OpenLineage Integration<br/>GET /lineage/registry"]
        VectorSearch["Vector Search<br/>POST /v1/vector_stores/.../search"]
        MonitoringAPI["Monitoring API<br/>POST /monitoring/compute"]
        GRPCServer["gRPC Services<br/>ServingService, RegistryServer"]
    end

    subgraph FeatureServerGo["Feature Server - Go (High Performance)"]
        GoOnlineServing["GET /get-online-features"]
        GoHealth["GET /health"]
        GoMetrics["GET /metrics"]
        GoGRPC["gRPC ServingService"]
    end

    User["Data Scientist / ML Engineer"] -->|"kubectl apply"| FeatureStoreCR["FeatureStore CR<br/>(feast.dev/v1)"]
    FeatureStoreCR -->|"watched by"| Controller

    Controller -->|"creates/manages"| FeatureServerPython
    Controller -->|"creates/manages"| FeatureServerGo
    Controller -->|"creates"| CronJob["Materialization CronJob<br/>(ose-cli)"]
    Controller -->|"creates"| RBAC["RBAC Roles & Bindings"]
    Controller -->|"creates"| Services["Services & Routes"]
    Controller -->|"creates"| HPA["HPA & PDB"]
    Controller -->|"creates"| PVC["PersistentVolumeClaims"]

    NotebookReconciler -->|"watches"| NotebookCR["Kubeflow Notebook CR"]
    NotebookReconciler -->|"injects config"| NotebookCM["Client ConfigMap"]

    Controller -->|"watches"| MLflowCR["MLflow CR"]
    Controller -->|"manages"| ServiceMonitor["ServiceMonitor"]
    Controller -->|"creates"| Route["OpenShift Route"]
    Controller -->|"creates"| SparkApp["SparkApplication"]

    OnlineServing -->|"reads/writes"| OnlineStore["Online Store<br/>(Redis/PostgreSQL/DynamoDB)"]
    CronJob -->|"triggers"| FeatureServerPython
    FeatureServerPython -->|"queries"| OfflineStore["Offline Store<br/>(BigQuery/Snowflake/Spark)"]
    FeatureServerPython -->|"reads/writes"| RegistryBackend["Registry Backend<br/>(S3/GCS/SQL)"]

    GoOnlineServing -->|"reads"| OnlineStore

