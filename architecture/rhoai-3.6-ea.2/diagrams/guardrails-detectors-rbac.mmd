graph TD
    subgraph "Service Accounts"
        SA_user["user-one<br/>(example manifest)"]
        SA_default["default<br/>(built-in detector)"]
    end

    subgraph "RoleBindings"
        RB["user-one-view<br/>(Namespace-scoped)<br/>Note: Example only"]
    end

    subgraph "ClusterRoles"
        CR_view["view<br/>(built-in ClusterRole)"]
    end

    subgraph "Platform Auth"
        PlatformAuth["KServe Auth Enforcement<br/>security.opendatahub.io/enable-auth: true"]
        IstioAuth["Istio Sidecar<br/>sidecar.istio.io/inject: true<br/>mTLS STRICT"]
    end

    subgraph "Application Auth"
        NoAuth["No Application Auth Middleware<br/>All HTTP endpoints unauthenticated<br/>at application level"]
    end

    subgraph "Secrets"
        S3Secret["aws-connection-minio-data-connection-<br/>guardrails-guardian<br/>Type: Opaque<br/>Keys: AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY<br/>WARNING: Example creds only"]
    end

    SA_user -->|"bound via"| RB
    RB -->|"grants"| CR_view

    CR_view -->|"get, list, watch"| Resources["Standard K8s Resources<br/>(view-only access)"]

    PlatformAuth -.->|"enforces auth on"| Endpoints["All HTTP Endpoints<br/>/api/v1/text/contents<br/>/api/v1/text/generation<br/>/metrics, /health"]
    IstioAuth -.->|"enforces mTLS on"| Endpoints

    S3Secret -.->|"mounted in"| HFPod["huggingface Detector Pod"]

