graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["KServe Gateway / Istio Ingress<br/>TLS Termination<br/>Auth: Platform-managed"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        subgraph OptionalSidecar["Optional: nginx-mtls-auth Sidecar"]
            Nginx["nginx-mtls-auth<br/>mTLS Termination<br/>Client cert validation"]
        end

        subgraph OVMSPod["OVMS Pod (UID 5000, non-root)"]
            HTTPServer["OVMS HTTP Server<br/>Service: ovms-rest (ClusterIP)<br/>Port: 8888/TCP<br/>Protocol: HTTP (NO TLS)<br/>Auth: Bearer token (optional)"]
            GRPCServer["OVMS gRPC Server<br/>Service: ovms-grpc (ClusterIP)<br/>Port: 8001/TCP<br/>Protocol: gRPC<br/>Encryption: None (InsecureServerCredentials)<br/>Auth: None"]
        end

        Prometheus["Prometheus<br/>Scrapes /metrics<br/>No auth required"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS (system CAs)<br/>Auth: HF token (optional)"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS (system CAs)<br/>Auth: Azure credentials"]
        S3["S3/GCS Endpoints<br/>443/TCP HTTPS<br/>TLS (system CAs)<br/>Auth: Cloud IAM"]
    end

    %% External flows
    Client -->|"HTTPS<br/>TLS (platform-managed)<br/>Bearer token (optional)"| Gateway
    Gateway -->|"HTTP/8888<br/>No encryption<br/>Bearer token passthrough"| HTTPServer
    Client -->|"gRPC<br/>No encryption<br/>No auth"| GRPCServer

    %% Optional mTLS path
    Client -.->|"HTTPS (mTLS)<br/>Client certificate"| Nginx
    Nginx -.->|"HTTP (plaintext)<br/>Forwarded"| HTTPServer

    %% Internal
    Prometheus -->|"HTTP/8888<br/>GET /metrics<br/>No auth"| HTTPServer

    %% Egress
    HTTPServer -->|"HTTPS/443<br/>TLS (system CAs)<br/>HF token"| HF
    HTTPServer -->|"HTTPS/443<br/>TLS (system CAs)<br/>Azure creds"| Azure
    HTTPServer -->|"HTTPS/443<br/>TLS (system CAs)<br/>Cloud IAM"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitor fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Gateway ingress
    class HTTPServer,Nginx cluster
    class GRPCServer warning
    class HF,Azure,S3 externalservice
    class Prometheus monitor
