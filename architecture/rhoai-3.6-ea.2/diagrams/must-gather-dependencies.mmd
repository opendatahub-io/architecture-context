graph LR
    MustGather["must-gather<br/>(Diagnostic Tool)"]

    %% External Dependencies
    MustGather -->|base image| OSEMustGather["ose-must-gather-rhel9<br/>v4.22 (digest-pinned)"]
    MustGather -->|kubectl binary| OSECLI["ose-cli-rhel9<br/>v4.22 (digest-pinned)"]
    MustGather -->|"resource inspection (xKS)"| Kubectl["kubectl<br/>v1.33.3 / v1.34.7"]
    MustGather -->|"helm get values/manifest"| Helm["Helm<br/>v4.1.4"]
    MustGather -->|crypto policy| CryptoPolicies["crypto-policies-scripts<br/>DEFAULT:PQ"]

    %% Core Infrastructure
    MustGather -->|"all resource queries<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]

    %% Internal Platform Dependencies (read-only CRD queries)
    MustGather -.->|CRD query| RHODSOp["rhods-operator<br/>(DSCInit, DSC, module CRs)"]
    MustGather -.->|CRD query| KServe["KServe<br/>(InferenceServices, ServingRuntimes)"]
    MustGather -.->|CRD query| DSP["Data Science Pipelines<br/>(DSPApplications, Argo)"]
    MustGather -.->|CRD query| KubeRay["KubeRay<br/>(RayClusters, RayJobs)"]
    MustGather -.->|CRD query| Kueue["Kueue<br/>(ClusterQueues, Workloads)"]
    MustGather -.->|CRD query| KFTO["Training Operator<br/>(PyTorchJobs, TrainJobs)"]
    MustGather -.->|CRD query| ModelReg["Model Registry"]
    MustGather -.->|CRD query| TrustyAI["TrustyAI<br/>(LMEvalJobs, Guardrails)"]
    MustGather -.->|CRD query| Dashboard["Dashboard<br/>(Configs, Profiles)"]
    MustGather -.->|CRD query| Feast["Feast Operator<br/>(FeatureStores)"]
    MustGather -.->|CRD query| MLflow["MLflow"]
    MustGather -.->|CRD query| SparkOp["Spark Operator<br/>(SparkApplications)"]
    MustGather -.->|CRD query| AIGateway["AI Gateway / MaaS<br/>(AITenants, ExternalModels)"]
    MustGather -.->|CRD query| MCPOp["MCP Lifecycle Operator<br/>(MCPServers)"]
    MustGather -.->|CRD query| OGX["OGX<br/>(OGXServers)"]

    %% LLM-D Dependencies
    MustGather -.->|CRD query| CertManager["cert-manager<br/>(Issuers, Certificates)"]
    MustGather -.->|CRD query| Istio["Sail / Istio<br/>(VirtualServices, AuthzPolicies)"]
    MustGather -.->|CRD query| LWS["LeaderWorkerSet"]
    MustGather -.->|CRD query| Authorino["Authorino / Kuadrant<br/>(AuthConfigs, RateLimits)"]
    MustGather -.->|CRD query| GatewayAPI["Gateway API<br/>(Gateways, HTTPRoutes)"]
    MustGather -.->|CRD query| PromOp["Prometheus Operator<br/>(ServiceMonitors, Rules)"]

    %% Optional
    MustGather -.->|"CRD query (optional)"| KEDA["KEDA<br/>(ScaledObjects, WVA)"]

