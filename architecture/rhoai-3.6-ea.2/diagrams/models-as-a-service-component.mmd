graph TB
    subgraph MaaS["Models-as-a-Service Platform"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            Controller["maas-controller<br/>(Go Operator)<br/>:8081 health, :8443 metrics"]
            Webhook["Validating Webhook<br/>(failurePolicy: Fail)"]
            Controller -->|"serves"| Webhook
        end

        subgraph DataPlane["Data Plane (per-tenant)"]
            API["maas-api<br/>(Go/Gin HTTP)<br/>:8080 API, :9090 metrics"]
            CleanupJob["API Key Cleanup<br/>(CronJob)"]
            CleanupJob -->|"POST /internal/v1/api-keys/cleanup"| API
        end

        subgraph DiscoveryTier["Discovery Tier"]
            Discovery["maas-discovery<br/>(Go/Gin HTTPS)<br/>:8443"]
        end

        Controller -->|"deploys via<br/>Tenant reconciler"| API
    end

    %% CRDs
    subgraph CRDs["Custom Resource Definitions"]
        AITenant["AITenant CR"]
        MaaSModelRef["MaaSModelRef CR"]
        MaaSSubscription["MaaSSubscription CR"]
        MaaSAuthPolicy["MaaSAuthPolicy CR"]
        ExternalModel["ExternalModel CR"]
        Config["Config CR<br/>(Cluster-scoped)"]
        MaasTenantConfig["MaasTenantConfig CR"]
        TenantCR["Tenant CR"]
    end

    AITenant -->|"watched by"| Controller
    MaaSModelRef -->|"watched by"| Controller
    MaaSSubscription -->|"watched by"| Controller
    MaaSAuthPolicy -->|"watched by"| Controller
    ExternalModel -->|"watched by"| Controller
    Config -->|"watched by"| Controller
    MaasTenantConfig -->|"created by"| Controller
    TenantCR -->|"managed by"| Controller

    AITenant -->|"cached by informer"| Discovery
    MaaSModelRef -->|"read by"| API
    MaaSSubscription -->|"read by"| API
    MaaSAuthPolicy -->|"read by"| API

    %% Webhook validations
    Webhook -->|"validates"| AITenant
    Webhook -->|"validates"| MaaSModelRef
    Webhook -->|"validates"| MaaSSubscription
    Webhook -->|"validates"| MaaSAuthPolicy

    %% Controller creates
    Controller -->|"creates HTTPRoute"| GatewayAPI["Gateway API<br/>(data-science-gateway)"]
    Controller -->|"creates AuthPolicy"| Kuadrant["Kuadrant/Authorino"]
    Controller -->|"creates TokenRateLimitPolicy"| Limitador["Kuadrant/Limitador"]

    %% External dependencies
    Controller -->|"conditional watch"| KServe["KServe<br/>LLMInferenceService"]
    API -->|"API key storage<br/>:5432/TCP"| PostgreSQL["PostgreSQL"]
    API -->|"trace export<br/>gRPC OTLP"| OTel["OpenTelemetry<br/>Collector"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style API fill:#4a90e2,stroke:#333,color:#fff
    style Discovery fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style CleanupJob fill:#4a90e2,stroke:#333,color:#fff

    style AITenant fill:#f5a623,stroke:#333
    style MaaSModelRef fill:#f5a623,stroke:#333
    style MaaSSubscription fill:#f5a623,stroke:#333
    style MaaSAuthPolicy fill:#f5a623,stroke:#333
    style ExternalModel fill:#f5a623,stroke:#333
    style Config fill:#f5a623,stroke:#333
    style MaasTenantConfig fill:#f5a623,stroke:#333
    style TenantCR fill:#f5a623,stroke:#333

    style GatewayAPI fill:#7ed321,stroke:#333
    style Kuadrant fill:#7ed321,stroke:#333
    style Limitador fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
