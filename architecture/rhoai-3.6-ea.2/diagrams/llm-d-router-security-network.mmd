graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph GatewayZone["GATEWAY ZONE (Envoy / Gateway API)"]
        Envoy["Envoy Proxy<br/>443/TCP external<br/>TLS 1.2+<br/>Gateway-dependent Auth"]
    end

    subgraph Internal["INTERNAL CLUSTER (ClusterIP Services)"]
        direction TB

        subgraph EPPZone["EPP Namespace"]
            EPP["Endpoint Picker (EPP)<br/>SA: {name}<br/>gRPC 9002/TCP<br/>Optional TLS (min TLS 1.2)"]
            EPPHealth["EPP Health<br/>9003/TCP<br/>Optional TLS"]
            EPPMetrics["EPP Metrics<br/>9090/TCP<br/>Configurable TLS"]
        end

        subgraph CoordZone["Coordinator Namespace"]
            Coord["Coordinator<br/>8080/TCP HTTP<br/>Configurable TLS (min TLS 1.2)"]
            CoordMetrics["Coord Metrics<br/>9090/TCP<br/>Configurable TLS"]
        end

        subgraph SidecarZone["Decode Worker Pod"]
            Sidecar["Disaggregation Sidecar<br/>8000/TCP HTTP<br/>Configurable TLS"]
            DecodeServer["Local Decode Server<br/>8200/TCP HTTP<br/>No TLS"]
        end

        subgraph WorkerZone["Worker Pods"]
            PrefillWorker["Prefill Workers<br/>Configurable Port<br/>HTTP/HTTPS<br/>Configurable TLS"]
            EncoderWorker["Encoder Workers<br/>Configurable Port<br/>HTTP/HTTPS<br/>Configurable TLS"]
        end

        InfGW["Inference Gateway<br/>80/TCP HTTP<br/>Configurable TLS"]
        RenderSvc["Rendering Service<br/>8080/TCP HTTP<br/>No TLS"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable TLS"]
        Prometheus["Prometheus<br/>Scrape HTTP"]
    end

    subgraph ExternalData["EXTERNAL DATA SERVICES"]
        Redis["Redis<br/>6379/TCP<br/>No Encryption<br/>No Auth"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Gateway Auth"| Envoy
    Envoy -->|"gRPC/9002<br/>Optional TLS<br/>No App Auth"| EPP
    EPP -->|"gRPC/9002<br/>Optional TLS<br/>Routing Decision"| Envoy
    Envoy -->|"HTTP(S)<br/>Configurable<br/>No Auth"| InfGW

    Client -->|"HTTP/8080<br/>Configurable TLS<br/>No Auth"| Coord
    Coord -->|"HTTP/80<br/>Configurable<br/>No Auth"| InfGW
    Coord -->|"HTTP/8080<br/>No TLS<br/>No Auth"| RenderSvc
    Coord -->|"TCP/6379<br/>No Encryption<br/>No Auth"| Redis

    InfGW -->|"HTTP/8000<br/>Configurable TLS<br/>No Auth"| Sidecar
    Sidecar -->|"HTTP/8200<br/>No TLS<br/>No Auth"| DecodeServer
    Sidecar -->|"HTTP(S)<br/>Configurable TLS<br/>No Auth"| PrefillWorker
    Sidecar -->|"HTTP(S)<br/>Configurable TLS<br/>No Auth"| EncoderWorker

    EPP -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    Sidecar -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    EPP -->|"OTLP/gRPC<br/>Configurable"| OTel
    Coord -->|"OTLP/gRPC<br/>Configurable"| OTel
    Sidecar -->|"OTLP/gRPC<br/>Configurable"| OTel

    Prometheus -->|"HTTP scrape<br/>Configurable TLS"| EPPMetrics
    Prometheus -->|"HTTP scrape<br/>Configurable TLS"| CoordMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externaldata fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef worker fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy gateway
    class EPP,EPPHealth,EPPMetrics,Coord,CoordMetrics,Sidecar,DecodeServer,InfGW,RenderSvc internal
    class K8sAPI,OTel,Prometheus platform
    class Redis externaldata
    class PrefillWorker,EncoderWorker worker
