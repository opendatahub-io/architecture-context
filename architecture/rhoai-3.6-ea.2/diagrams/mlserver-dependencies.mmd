graph LR
    MLServer["MLServer<br/>Inference Server"]

    %% Internal Platform Dependencies
    MLServer -->|"inference container<br/>in pod"| KServe["KServe<br/>InferenceService"]
    MLServer -->|"auth sidecar<br/>443/TCP"| KubeRBACProxy["kube-rbac-proxy<br/>OAuth validation"]
    MLServer -->|"mTLS transport"| Istio["OpenShift Service Mesh<br/>(Istio)"]

    %% Core Framework Dependencies
    MLServer -->|"REST API"| FastAPI["FastAPI + uvicorn<br/>>=0.134.0"]
    MLServer -->|"gRPC API"| GRPCIO["grpcio<br/>>=1.67.1"]
    MLServer -->|"data validation"| Pydantic["pydantic<br/>^2.7.1"]
    MLServer -->|"serialization"| Protobuf["protobuf<br/>>=5.27.2"]

    %% Runtime Dependencies
    MLServer -->|"ML runtime"| SKLearn["scikit-learn"]
    MLServer -->|"ML runtime"| XGBoost["xgboost"]
    MLServer -->|"ML runtime"| LightGBM["lightgbm"]
    MLServer -->|"ML runtime (CPU)"| ONNXCPU["onnxruntime<br/>>=1.20.0"]
    MLServer -->|"ML runtime (CUDA)"| ONNXGPU["onnxruntime-gpu<br/>>=1.20.0"]

    %% Observability Dependencies
    MLServer -.->|"metrics"| Prometheus["Prometheus<br/>8082/TCP scrape"]
    MLServer -.->|"tracing (optional)"| OTel["OpenTelemetry SDK<br/>+ OTLP exporter"]
    OTel -.->|"gRPC (insecure)"| OTLPCollector["OTLP Collector"]

    %% Optional Dependencies
    MLServer -.->|"async inference<br/>(disabled by default)"| Kafka["Kafka<br/>9092/TCP"]

    %% Data Dependencies
    MLServer -->|"tensor handling"| NumPy["numpy"]
    MLServer -->|"DataFrame I/O"| Pandas["pandas"]
    MLServer -->|"Triton protocol"| Triton["tritonclient<br/>>=2.42"]

    style MLServer fill:#4a90e2,stroke:#333,stroke-width:4px
