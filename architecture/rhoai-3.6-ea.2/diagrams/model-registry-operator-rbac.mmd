graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator-<br/>controller-manager"]
        SA_Registry["{registry-name}"]
        SA_Catalog["model-catalog"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator-<br/>manager-rolebinding"]
        CRB_Metrics["model-registry-operator-<br/>metrics-auth-rolebinding"]
        CRB_RegAuth["{registry-name}-<br/>auth-delegator"]
        CRB_CatAuth["model-catalog-<br/>auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-<br/>manager-role"]
        CR_MetricsAuth["model-registry-operator-<br/>metrics-auth-role"]
        CR_MetricsReader["model-registry-operator-<br/>metrics-reader"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(operator namespace)"]
        RB_RegUsers["{registry-name}-users<br/>(registry namespace)"]
        RB_CatAuth2["model-catalog-authenticated<br/>(target namespace)"]
        RB_CatAdmin["model-catalog-admin-binding<br/>(target namespace)"]
    end

    subgraph Roles["Namespace Roles"]
        R_Leader["leader-election-role"]
        R_RegUser["registry-user-{registry-name}"]
        R_CatRole["model-catalog"]
        R_CatAdmin["model-catalog-admin"]
    end

    subgraph Groups["OpenShift Groups"]
        G_RegUsers["{registry-name}-users<br/>Group"]
        G_Authenticated["system:authenticated<br/>Group"]
        G_Admin["{admin-group}<br/>Group"]
    end

    subgraph APIResources["API Resources"]
        Res_Core["Core API<br/>configmaps, PVCs, secrets,<br/>serviceaccounts, services,<br/>endpoints, pods, pods/log"]
        Res_Apps["apps<br/>deployments"]
        Res_MR["modelregistry.opendatahub.io<br/>modelregistries,<br/>modelregistries/finalizers,<br/>modelregistries/status"]
        Res_Gateway["gateway.networking.k8s.io<br/>httproutes, referencegrants"]
        Res_Route["route.openshift.io<br/>routes, routes/custom-host"]
        Res_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>rolebindings, roles"]
        Res_Network["networking.k8s.io<br/>networkpolicies"]
        Res_Users["user.openshift.io<br/>groups"]
        Res_Platform["services.platform, components.platform<br/>auths, modelregistries"]
        Res_Migration["migration.k8s.io<br/>storageversionmigrations"]
        Res_AuthN["authentication.k8s.io<br/>tokenreviews"]
        Res_AuthZ["authorization.k8s.io<br/>subjectaccessreviews"]
        Res_Metrics["/metrics<br/>(non-resource URL)"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    SA_Operator -->|bound via| CRB_Metrics
    SA_Operator -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    RB_Leader -->|grants| R_Leader

    %% Manager role permissions
    CR_Manager -->|"CRUD"| Res_Core
    CR_Manager -->|"CRUD"| Res_Apps
    CR_Manager -->|"CRUD"| Res_MR
    CR_Manager -->|"CRUD"| Res_Gateway
    CR_Manager -->|"CRUD"| Res_Route
    CR_Manager -->|"CRUD"| Res_RBAC
    CR_Manager -->|"CRUD"| Res_Network
    CR_Manager -->|"CRUD"| Res_Users
    CR_Manager -->|"get,list,watch"| Res_Platform
    CR_Manager -->|"CRUD"| Res_Migration
    CR_Manager -->|"create"| Res_AuthN
    CR_Manager -->|"create"| Res_AuthZ

    %% Metrics roles
    CR_MetricsAuth -->|"create"| Res_AuthN
    CR_MetricsAuth -->|"create"| Res_AuthZ
    CR_MetricsReader -->|"get"| Res_Metrics

    %% Registry SA bindings
    SA_Registry -->|bound via| CRB_RegAuth
    CRB_RegAuth -->|grants| CR_AuthDelegator
    G_RegUsers -->|bound via| RB_RegUsers
    RB_RegUsers -->|grants| R_RegUser

    %% Catalog SA bindings
    SA_Catalog -->|bound via| CRB_CatAuth
    CRB_CatAuth -->|grants| CR_AuthDelegator
    G_Authenticated -->|bound via| RB_CatAuth2
    RB_CatAuth2 -->|grants| R_CatRole
    G_Admin -->|bound via| RB_CatAdmin
    RB_CatAdmin -->|grants| R_CatAdmin

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Registry fill:#4a90e2,stroke:#333,color:#fff
    style SA_Catalog fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_Admin fill:#f5a623,stroke:#333
    style CR_Editor fill:#f5a623,stroke:#333
    style CR_Viewer fill:#f5a623,stroke:#333
    style G_RegUsers fill:#9b59b6,stroke:#333,color:#fff
    style G_Authenticated fill:#9b59b6,stroke:#333,color:#fff
    style G_Admin fill:#9b59b6,stroke:#333,color:#fff
    style Res_MR fill:#7ed321,stroke:#333
    style Res_Core fill:#7ed321,stroke:#333
    style Res_Apps fill:#7ed321,stroke:#333
    style Res_Gateway fill:#7ed321,stroke:#333
    style Res_Route fill:#7ed321,stroke:#333
    style Res_RBAC fill:#7ed321,stroke:#333
    style Res_Network fill:#7ed321,stroke:#333
    style Res_Users fill:#7ed321,stroke:#333
    style Res_Platform fill:#7ed321,stroke:#333
    style Res_Migration fill:#7ed321,stroke:#333
    style Res_AuthN fill:#7ed321,stroke:#333
    style Res_AuthZ fill:#7ed321,stroke:#333
    style Res_Metrics fill:#7ed321,stroke:#333
