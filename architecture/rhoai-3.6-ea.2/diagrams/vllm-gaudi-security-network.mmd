graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["OpenShift Route / Istio Gateway<br/>443/TCP → 8000/TCP<br/>TLS Termination<br/>Platform AuthN"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT)"]
        direction TB

        subgraph NS_User["Namespace: user-namespace"]
            IstioSidecar["Istio Sidecar Proxy<br/>mTLS enforcement"]
            VllmServer["vLLM OpenAI API Server<br/>odh-vllm-gaudi-rhel9<br/>UID 2000 (non-root)<br/>Port 8000/TCP<br/>⚠ No FIPS provider"]
            HPU["Intel Gaudi HPU<br/>SynapseAI 1.23.0<br/>Exclusive to container"]
        end
    end

    subgraph NIXLZone["DISAGGREGATED INFERENCE (Optional)"]
        PrefillWorker["Prefill Worker HPU"]
        NIXLTransport["NIXL Transport<br/>UCX/RDMA<br/>⚠ No encryption"]
        DecodeWorker["Decode Worker HPU"]
    end

    subgraph ExternalServices["EGRESS (External Services)"]
        ModelStorage["Model Storage<br/>S3/PVC/HF Hub<br/>443/TCP HTTPS<br/>Auth: IAM/token"]
        HabanaRepo["vault.habana.ai<br/>443/TCP HTTPS<br/>BUILD-TIME ONLY<br/>⚠ External supply chain"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS<br/>Platform Auth"| Gateway
    Gateway -->|"HTTP/8000<br/>mTLS STRICT<br/>Service Identity"| IstioSidecar
    IstioSidecar -->|"HTTP/8000<br/>mTLS"| VllmServer
    VllmServer -->|"SynapseAI driver<br/>In-process"| HPU

    VllmServer -->|"HTTPS/443<br/>TLS<br/>IAM/token"| ModelStorage

    PrefillWorker -->|"UCX/RDMA<br/>No encryption"| NIXLTransport
    NIXLTransport -->|"UCX/RDMA<br/>No auth"| DecodeWorker

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hpu fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef nixl fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class IstioSidecar,VllmServer servicemesh
    class HPU hpu
    class ModelStorage,HabanaRepo externalservice
    class PrefillWorker,NIXLTransport,DecodeWorker nixl
