    CR_Manager -->|"CRUD + watch"| R_MSF
    CR_Manager -->|"CRUD + watch"| R_MSS
    CR_Manager -->|"CRUD + watch"| R_RB

    %% EPP path
    SA_EPP -->|bound via| CRB_EPP
    CRB_EPP -->|grants| CR_EPP
    CR_EPP -->|"get, watch, list"| R_EPP_IP
    CR_EPP -->|"get, watch, list"| R_EPP_IM
    CR_EPP -->|"get, watch, list"| R_EPP_Pods
    CR_EPP -->|"get, watch, list"| R_EPP_ES
    CR_EPP -->|"create"| R_EPP_TR
    CR_EPP -->|"create"| R_EPP_SAR

    %% User roles path
    CR_Admin -->|"* (full access)"| R_User_MS
    CR_Admin -->|"get"| R_User_MSS
    CR_Editor -->|"CRUD + watch"| R_User_MS
    CR_Editor -->|"get"| R_User_MSS
    CR_Viewer -->|"get, list, watch"| R_User_MS
    CR_Viewer -->|"get"| R_User_MSS

    %% Metrics path
    SA_EPP -->|bound via| CRB_Metrics
    CRB_Metrics -->|grants| CR_EPPMetrics

    %% Grafana quickstart path
    SA_Grafana -->|bound via| CRB_GrafView
    SA_Grafana -->|bound via| CRB_GrafMon
    SA_Grafana -->|bound via| CRB_GrafProm
    CRB_GrafProm -->|grants| CR_GrafProm

