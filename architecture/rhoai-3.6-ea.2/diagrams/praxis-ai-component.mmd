graph TB
    subgraph PraxisAI["Praxis AI Gateway"]
        direction TB

        subgraph Server["praxis-ai-proxy (server)"]
            Binary["praxis-ai Binary<br/>8080/TCP proxy, 9901/TCP admin"]
            FilterRegistry["Filter Registry<br/>Auto-discovered + builtin"]
            TLSProvider["TLS Provider<br/>OpenSSL-backed rustls"]
        end

        subgraph Filters["praxis-ai-filters"]
            AgenticFilters["Agentic Protocols<br/>A2A, MCP"]
            GuardrailsFilter["Guardrails Filter<br/>NeMo integration"]
            InferenceRouting["Inference Routing<br/>classify, route, transform"]
            CredentialInject["Credential Injection<br/>Bearer, mTLS, SigV4, Azure AD, GCP ADC"]
            TokenUsage["Token Usage &<br/>Metering"]
            ProtocolTranslation["Protocol Translation<br/>OpenAI, Anthropic, Bedrock, Vertex"]
        end

        subgraph APIs["praxis-ai-apis"]
            Classifier["Request Classifier<br/>Provider, Model, Protocol"]
            ProviderTypes["Provider Types<br/>OpenAI, Anthropic, Azure, Bedrock, Vertex"]
            SSEParser["SSE Parser"]
        end

        subgraph Store["Response Store"]
            StoreTrait["praxis-ai-store<br/>Persistence Traits & Registry"]
            StoreBackends["praxis-ai-store-backends<br/>PostgreSQL, SQLite"]
            StoreLifecycle["praxis-ai-store-lifecycle<br/>Pool Provisioning"]
        end

        ExtProc["praxis-ai-llmd-ext-proc<br/>gRPC ext_proc Compatibility"]
        BuildSupport["praxis-ai-build-support<br/>Filter Auto-Discovery"]
    end

    %% Internal relationships
    Binary --> FilterRegistry
    Binary --> TLSProvider
    FilterRegistry --> AgenticFilters
    FilterRegistry --> GuardrailsFilter
    FilterRegistry --> InferenceRouting
    FilterRegistry --> CredentialInject
    FilterRegistry --> TokenUsage
    FilterRegistry --> ProtocolTranslation
    FilterRegistry --> ExtProc

    InferenceRouting --> Classifier
    ProtocolTranslation --> ProviderTypes
    ProtocolTranslation --> SSEParser

    ProtocolTranslation --> StoreTrait
    StoreTrait --> StoreBackends
    StoreTrait --> StoreLifecycle

    BuildSupport -.->|build-time| FilterRegistry

    %% External dependencies
    PraxisCore["Praxis Core<br/>(praxis-proxy 0.7.3)"]
    Pingora["Quixotic-Plecostomus<br/>(Pingora fork 0.10.0)"]

    Binary -->|runtime framework| PraxisCore
    PraxisCore -->|HTTP proxy engine| Pingora

