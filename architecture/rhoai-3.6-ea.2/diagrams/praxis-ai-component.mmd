    style Binary fill:#4a90e2,color:#fff
    style FilterRegistry fill:#4a90e2,color:#fff
    style TLSProvider fill:#4a90e2,color:#fff
    style Classifier fill:#7ed321,color:#fff
    style ProviderTypes fill:#7ed321,color:#fff
    style SSEParser fill:#7ed321,color:#fff
    style AgenticFilters fill:#f5a623,color:#fff
    style GuardrailsFilter fill:#f5a623,color:#fff
    style InferenceRouting fill:#f5a623,color:#fff
    style CredentialInject fill:#f5a623,color:#fff
    style TokenUsage fill:#f5a623,color:#fff
    style ProtocolTranslation fill:#f5a623,color:#fff
    style StoreTrait fill:#9b59b6,color:#fff
    style StoreBackends fill:#9b59b6,color:#fff
    style StoreLifecycle fill:#9b59b6,color:#fff
    style ExtProc fill:#e74c3c,color:#fff
    style BuildSupport fill:#95a5a6,color:#fff
    style PraxisCore fill:#e8e8e8,stroke:#333
    style Pingora fill:#e8e8e8,stroke:#333
