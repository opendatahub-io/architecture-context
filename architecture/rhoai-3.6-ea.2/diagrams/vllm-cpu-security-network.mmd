graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Application["APPLICATION (vLLM CPU Inference Server)"]
        direction TB

        subgraph HTTPLayer["HTTP Layer — Port 8000/TCP"]
            APIServer["OpenAI API Server<br/>(FastAPI + Uvicorn)<br/>TLS: Optional<br/>ssl_cert_reqs: CERT_NONE"]
            AuthMW["Auth Middleware<br/>SHA-256 + constant-time compare<br/>Scope: /v1/*, /v2/*, /inference/*<br/>Active only when VLLM_API_KEY set"]
            SSLRefresh["SSL Cert Refresher<br/>watchfiles hot-reload"]
        end

        subgraph GRPCLayer["gRPC Layer — Port 50051/TCP"]
            GRPCServer["gRPC Server<br/>add_insecure_port<br/>NO TLS / NO Auth"]
        end

        subgraph DPLayer["DP Supervisor — Port 9256/TCP"]
            DPSupervisor["Data-Parallel Supervisor<br/>Health Aggregation<br/>No Auth"]
        end

        subgraph EngineLayer["Engine (In-Process)"]
            AsyncLLM["AsyncLLM Engine<br/>Scheduler + KV Cache"]
            Workers["Worker Processes<br/>Fork / ZMQ IPC"]
            CPUKernels["C/C++ CPU Kernels"]
            RustLib["Rust Library"]
        end

        APIServer --> AuthMW
        APIServer --> SSLRefresh
        APIServer --> AsyncLLM
        GRPCServer --> AsyncLLM
        AsyncLLM --> Workers
        Workers --> CPUKernels
        Workers --> RustLib
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: HF_TOKEN"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM"]
        Stats["stats.vllm.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
    end

    subgraph Platform["PLATFORM INTEGRATION"]
        KServe["KServe / ModelMesh<br/>Deploys vLLM pods<br/>Manages ingress + TLS"]
        Prometheus["Prometheus<br/>Scrapes /metrics<br/>8000/TCP HTTP"]
        OTel["OpenTelemetry Collector<br/>OTLP export<br/>Configurable"]
    end

    %% Inbound flows
    Client -->|"HTTP(S)/8000<br/>TLS Optional<br/>Bearer Token (optional)"| APIServer
    Client -->|"gRPC/50051<br/>NO TLS<br/>No Auth"| GRPCServer
    KServe -->|"HTTP/8000<br/>Platform TLS"| APIServer
    Prometheus -->|"HTTP/8000<br/>No Auth"| APIServer

    %% Outbound flows
    AsyncLLM -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN Bearer"| HFHub
    AsyncLLM -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    APIServer -->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth"| Stats
    AsyncLLM -->|"OTLP<br/>Configurable"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef app fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef grpc fill:#fde68a,stroke:#d97706,stroke-width:2px
    classDef engine fill:#d1fae5,stroke:#059669,stroke-width:2px
    classDef extsvc fill:#fff7ed,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#ede9fe,stroke:#7c3aed,stroke-width:2px
    classDef warning fill:#fef2f2,stroke:#dc2626,stroke-width:2px

    class Client external
    class APIServer,AuthMW,SSLRefresh app
    class GRPCServer warning
    class DPSupervisor app
    class AsyncLLM,Workers,CPUKernels,RustLib engine
    class HFHub,S3,Stats extsvc
    class KServe,Prometheus,OTel platform
