graph TB
    subgraph Clients["INTERNAL CLIENTS (Platform Services)"]
        DSP["Data Science Pipelines<br/>(gRPC Client)"]
        PipelineUI["Pipeline UI / Client"]
    end

    subgraph MLMDService["MLMD SERVICE (Cluster-Internal)"]
        Server["metadata_store_server<br/>Image: odh-mlmd-grpc-server-rhel9<br/>Base: ubi9-minimal-pqc<br/>Port: 8080/TCP gRPC<br/>User: 65534:65534 (non-root)<br/>Stateless per-request"]
    end

    subgraph Databases["DATABASE BACKENDS (Persistent Storage)"]
        MySQL["MySQL / MariaDB<br/>3306/TCP<br/>Optional SSL"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Configurable sslmode"]
        SQLite["SQLite<br/>Local filesystem<br/>No encryption"]
    end

    %% Client to MLMD flows
    DSP -->|"gRPC/HTTP-2 on 8080<br/>Insecure default; optional TLS<br/>Auth: None default; optional mTLS"| Server
    PipelineUI -->|"gRPC/HTTP-2 on 8080<br/>Insecure default; optional TLS<br/>Auth: None default; optional mTLS"| Server

    %% MLMD to Database flows
    Server -->|"MySQL protocol/3306<br/>Optional SSL (cert, key, CA)<br/>Auth: Username/password"| MySQL
    Server -->|"PostgreSQL protocol/5432<br/>sslmode: disable→verify-full<br/>Auth: Username/password"| PostgreSQL
    Server -->|"Local file access<br/>Filesystem permissions"| SQLite

    %% Styling
    classDef client fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class DSP,PipelineUI client
    class Server service
    class MySQL,PostgreSQL,SQLite database
