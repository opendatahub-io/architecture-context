graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator"]
        OrcClient["Orchestrator Client<br/>Dispatches detection requests"]
    end

    subgraph RegexDetector["guardrails-regex-detector (Rust Service)"]
        direction TB
        Router["Axum Router<br/>HTTP request routing"]
        Handler["Detection Handler<br/>src/detectors.rs"]

        subgraph BuiltIn["Built-in PII Detectors"]
            Email["Email Detector<br/>regex pattern"]
            SSN["SSN Detector<br/>regex pattern"]
            CreditCard["Credit Card Detector<br/>regex pattern"]
        end

        CustomRegex["Custom Regex Engine<br/>User-supplied patterns"]
        HealthEP["Health Endpoint<br/>GET /health"]

        Router -->|"POST /api/v1/text/contents"| Handler
        Router -->|"GET /health"| HealthEP
        Handler --> BuiltIn
        Handler --> CustomRegex
    end

    subgraph Platform["Platform Infrastructure"]
        Probe["Kubernetes Probe<br/>Liveness check"]
        ServiceMesh["Service Mesh<br/>Expected: mTLS"]
    end

    OrcClient -->|"HTTP 8080/TCP<br/>JSON request"| ServiceMesh
    ServiceMesh -->|"HTTP 8080/TCP<br/>Plain TCP"| Router
    Probe -->|"HTTP GET /health<br/>8080/TCP"| HealthEP
    Handler -->|"JSON response<br/>Detections with offsets"| OrcClient

    style Router fill:#4a90e2,color:#fff
    style Handler fill:#4a90e2,color:#fff
    style Email fill:#f5a623,color:#fff
    style SSN fill:#f5a623,color:#fff
    style CreditCard fill:#f5a623,color:#fff
    style CustomRegex fill:#f5a623,color:#fff
    style HealthEP fill:#7ed321,color:#fff
    style OrcClient fill:#e8e8e8,stroke:#333
    style Probe fill:#e8e8e8,stroke:#333
    style ServiceMesh fill:#e8e8e8,stroke:#333
