graph TD
    subgraph Note["Praxis Authentication & Authorization Model"]
        direction TB
        NoteText["Praxis is a standalone proxy service, not a Kubernetes operator.<br/>No ClusterRoles or RoleBindings are defined.<br/>Authorization is enforced at the application level<br/>through filter pipeline and listener configuration."]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB
        mTLS["mTLS<br/>Per-listener client CA verification<br/>Optional"]
        BasicAuth["Basic Auth<br/>(htpasswd)<br/>Filter-based"]
        PolicyEngine["Policy Engine<br/>AI workload policies<br/>Optional, not in FIPS"]
        IPACL["IP ACL Filter<br/>Allow/deny by source IP"]
        SPIFFE["SPIFFE Identity<br/>X.509-SVID parsing<br/>Experimental"]
    end

    subgraph Endpoints["Protected Endpoints"]
        direction TB
        ProxyListener["Proxy Listeners<br/>8080/TCP (configurable)<br/>All methods"]
        AdminAPI["Admin API<br/>Loopback-restricted<br/>GET, PUT, DELETE"]
        HealthMetrics["Health/Metrics<br/>9902/TCP<br/>GET only"]
    end

    subgraph EnforcementPoints["Enforcement Points"]
        direction TB
        TLSLayer["praxis-tls<br/>mTLS enforcement"]
        FilterPipeline["Filter Pipeline<br/>Chain-based auth"]
        AdminHost["admin_host module<br/>DNS rebinding check"]
        ReservedHeaders["Reserved Headers<br/>x-praxis-*, x-ext-protocol-*,<br/>x-ext-agent-*<br/>Rejected with 400"]
    end

    subgraph SecurityFilters["Security Filter Chain"]
        direction TB
        CORS["CORS Filter"]
        CSRF["CSRF Filter"]
        Guardrails["Guardrails Filter"]
        CredInjection["Credential Injection<br/>Header-based upstream auth"]
        PeerIdentity["Peer Identity Trust<br/>mTLS peer verification"]
    end

    %% Authentication flows
    mTLS -->|"enforced by"| TLSLayer
    BasicAuth -->|"enforced by"| FilterPipeline
    PolicyEngine -->|"enforced by"| FilterPipeline
    IPACL -->|"enforced by"| FilterPipeline

    %% Endpoint protection
    TLSLayer -->|"protects"| ProxyListener
    FilterPipeline -->|"protects"| ProxyListener
    AdminHost -->|"protects"| AdminAPI
    AdminHost -->|"protects"| HealthMetrics
    ReservedHeaders -->|"protects"| ProxyListener

    %% Security filters in chain
    FilterPipeline --> CORS
    FilterPipeline --> CSRF
    FilterPipeline --> Guardrails
    FilterPipeline --> CredInjection
    FilterPipeline --> PeerIdentity

    %% Styling
    style NoteText fill:#fff3cd,stroke:#856404,color:#856404
    style mTLS fill:#d4edda,stroke:#155724
    style BasicAuth fill:#d4edda,stroke:#155724
    style PolicyEngine fill:#fff3cd,stroke:#856404
    style IPACL fill:#d4edda,stroke:#155724
    style SPIFFE fill:#fff3cd,stroke:#856404
    style ProxyListener fill:#cce5ff,stroke:#004085
    style AdminAPI fill:#f8d7da,stroke:#721c24
    style HealthMetrics fill:#cce5ff,stroke:#004085
    style TLSLayer fill:#e2e3e5,stroke:#383d41
    style FilterPipeline fill:#e2e3e5,stroke:#383d41
    style AdminHost fill:#e2e3e5,stroke:#383d41
    style ReservedHeaders fill:#e2e3e5,stroke:#383d41
