graph LR
    Garak["llama-stack-provider-trustyai-garak<br/>(Garak Adapter)"]

    %% Internal RHOAI Dependencies
    Garak -->|"FrameworkAdapter SDK<br/>job lifecycle"| EvalHub["eval-hub SDK ~=1.0.4"]
    Garak -->|"pipeline submission<br/>status polling"| KFP["Kubeflow Pipelines"]
    Garak -->|"ConfigMap lookup<br/>image resolution"| TrustyAI["TrustyAI Service Operator"]

    %% Core External Dependencies
    Garak -->|"red-teaming framework<br/>vulnerability scanning"| GarakLib["garak ==0.17.0+rhaiv.4"]
    Garak -->|"pipeline SDK<br/>DAG definition"| KFPLib["kfp >=2.14.6"]
    Garak -->|"K8s extensions<br/>secret injection"| KFPKube["kfp-kubernetes >=2.14.6"]
    Garak -->|"S3 operations<br/>artifact transfer"| Boto3["boto3 >=1.35.88"]
    Garak -->|"data processing<br/>taxonomy, SDG"| Pandas["pandas >=2.3.3"]
    Garak -->|"HTML reports<br/>chart specs"| Jinja2["Jinja2 >=3.1.6"]

    %% Conditional Dependencies
    Garak -.->|"synthetic data gen<br/>(intents mode)"| SDGHub["sdg-hub ~=0.9.4"]

    %% Heavy Transitive Dependencies (via garak [inline])
    GarakLib -.->|transitive| Torch["torch ==2.13.0"]
    GarakLib -.->|transitive| Transformers["transformers ==5.17.0"]
    GarakLib -.->|transitive| LiteLLM["litellm"]
    GarakLib -.->|transitive| LangChain["langchain"]

    %% Infrastructure Dependencies
    Garak -->|"K8s client<br/>ConfigMap/Secret"| K8sClient["kubernetes ==36.0.3"]
    Garak -->|"HTTP client"| HTTPX["httpx ==0.28.1"]
    Garak -->|"observability"| OTel["opentelemetry-sdk ==1.44.0"]
    Garak -->|"TLS/crypto"| Cryptography["cryptography ==50.0.1"]

    %% External Services
    Garak -->|"model storage"| S3["S3-Compatible Storage"]
    Garak -->|"model downloads"| HFHub["HuggingFace Hub"]

    %% Integration points
    Dashboard["eval-hub Service"] -->|"launches job"| Garak
    KFP -->|"runs pipeline pods"| Garak

