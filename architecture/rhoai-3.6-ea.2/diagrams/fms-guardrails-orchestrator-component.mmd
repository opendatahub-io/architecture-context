graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator"]
        direction TB
        Main["fms-guardrails-orchestr8<br/>(Rust / axum + tonic)"]

        subgraph Servers["Dual Server Architecture"]
            GuardrailsServer["Guardrails Server<br/>Port 8033/TCP<br/>HTTP/HTTPS<br/>Optional TLS/mTLS"]
            HealthServer["Health Server<br/>Port 8034/TCP<br/>HTTP only<br/>No Auth"]
        end

        subgraph Handlers["Task Handlers"]
            ClassGen["ClassificationWithGenTask"]
            CompDet["CompletionsDetectionTask"]
            ContentDet["ContentDetectionTask"]
            ChatDet["ChatDetectionTask"]
            ContextDet["ContextDetectionTask"]
            GenDet["GeneratedDetectionTask"]
            StreamDet["StreamContentDetectionTask"]
        end

        subgraph Middleware["Middleware"]
            HeaderFilter["Header Passthrough<br/>& Token Rewriting"]
            TLSLayer["TLS Layer<br/>(rustls + ring)"]
            Tracing["OpenTelemetry<br/>Tracing Layer"]
        end

        Main --> GuardrailsServer
        Main --> HealthServer
        GuardrailsServer --> HeaderFilter
        HeaderFilter --> Handlers
        GuardrailsServer --> TLSLayer
        GuardrailsServer --> Tracing
    end

    Client[Client] -->|"POST /api/v1/* /api/v2/*<br/>8033/TCP"| GuardrailsServer
    Probes["K8s Probes"] -->|"GET /health /info<br/>8034/TCP"| HealthServer

    subgraph Downstream["Downstream Services"]
        TGIS["TGIS Generation<br/>gRPC :8033"]
        CaikitNLP["Caikit-NLP<br/>gRPC"]
        OpenAI["OpenAI-Compatible<br/>REST"]
        Detectors["Detector Services<br/>REST :8080"]
        Chunkers["Chunker Services<br/>gRPC :8085"]
    end

    Handlers -->|gRPC| TGIS
    Handlers -->|gRPC| CaikitNLP
    Handlers -->|HTTP/HTTPS| OpenAI
    Handlers -->|HTTP/HTTPS| Detectors
    Handlers -->|gRPC| Chunkers

    subgraph Observability["Observability"]
        OTLP["OTLP Collector<br/>gRPC or HTTP"]
    end

    Tracing -->|traces & metrics| OTLP

    style Main fill:#4a90e2,color:#fff
    style GuardrailsServer fill:#4a90e2,color:#fff
    style HealthServer fill:#4a90e2,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Probes fill:#f9f9f9,stroke:#999
    style TGIS fill:#7ed321,color:#fff
    style CaikitNLP fill:#7ed321,color:#fff
    style OpenAI fill:#7ed321,color:#fff
    style Detectors fill:#7ed321,color:#fff
    style Chunkers fill:#7ed321,color:#fff
    style OTLP fill:#f5a623,color:#fff
