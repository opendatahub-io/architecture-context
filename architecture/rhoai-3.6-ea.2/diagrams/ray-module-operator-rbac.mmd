graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["ray-module-operator<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["ray-module-operator<br/>manager-rolebinding"]
        CRB2["ray-module-operator<br/>metrics-auth-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ray-module-operator<br/>manager-role"]
        CR_MetricsAuth["ray-module-operator<br/>metrics-auth-role"]
        CR_MetricsReader["ray-module-operator<br/>metrics-reader"]
        CR_Notebook["ray<br/>(notebook ClusterRole)"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        CR_Admin["ray-module-operator<br/>ray-admin-role"]
        CR_Editor["ray-module-operator<br/>ray-editor-role"]
        CR_Viewer["ray-module-operator<br/>ray-viewer-role"]
    end

    subgraph PlatformResources["Platform API Resources"]
        RayCR["components.platform.opendatahub.io<br/>rays, rays/status, rays/finalizers"]
    end

    subgraph RayIOResources["Ray API Resources"]
        RayClusters["ray.io<br/>rayclusters"]
        RayJobs["ray.io<br/>rayjobs"]
        RayServices["ray.io<br/>rayservices"]
        RayCronJobs["ray.io<br/>raycronjobs"]
    end

    subgraph K8sCoreResources["Kubernetes Core Resources"]
        Deployments["apps<br/>deployments"]
        CoreResources["core<br/>configmaps, events,<br/>serviceaccounts, services,<br/>pods, secrets"]
        RBACResources["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        Webhooks["admissionregistration.k8s.io<br/>mutating/validating<br/>webhookconfigurations"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    subgraph ExternalResources["External API Resources"]
        CertManagerRes["cert-manager.io<br/>certificates, issuers"]
        GatewayRes["gateway.networking.k8s.io<br/>gateways, httproutes,<br/>referencegrants"]
        NetworkRes["networking.k8s.io<br/>ingresses, ingressclasses,<br/>networkpolicies"]
        OSRoutes["route.openshift.io<br/>routes"]
        OSScc["security.openshift.io<br/>securitycontextconstraints"]
        BatchRes["batch<br/>jobs"]
        LeaseRes["coordination.k8s.io<br/>leases"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        Metrics["/metrics"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    CRB1 -->|"grants"| CR_Manager
    CRB2 -->|"grants"| CR_MetricsAuth

    %% Manager Role Permissions
    CR_Manager -->|"CRUD + watch"| RayCR
    CR_Manager -->|"CRUD + deletecollection"| RayClusters
    CR_Manager -->|"CRUD + deletecollection"| RayJobs
    CR_Manager -->|"CRUD + deletecollection"| RayServices
    CR_Manager -->|"CRUD + deletecollection"| RayCronJobs
    CR_Manager -->|"CRUD"| Deployments
    CR_Manager -->|"CRUD"| CoreResources
    CR_Manager -->|"CRUD"| RBACResources
    CR_Manager -->|"CRUD"| Webhooks
    CR_Manager -->|"create,get,list,<br/>patch,update,watch"| CRDs
    CR_Manager -->|"CRUD"| CertManagerRes
    CR_Manager -->|"CRUD"| GatewayRes
    CR_Manager -->|"CRUD"| NetworkRes
    CR_Manager -->|"CRUD"| OSRoutes
    CR_Manager -->|"CRUD"| OSScc
    CR_Manager -->|"CRUD"| BatchRes
    CR_Manager -->|"CRUD"| LeaseRes

    %% Metrics Auth Role
    CR_MetricsAuth -->|"create"| TokenReview
    CR_MetricsAuth -->|"create"| SAR

    %% Metrics Reader
    CR_MetricsReader -->|"get"| Metrics

    %% Notebook ClusterRole
    CR_Notebook -->|"get,list,create,<br/>patch,delete"| RayJobs
    CR_Notebook -->|"get,list,create,<br/>patch,delete"| RayClusters
    CR_Notebook -->|"create"| CoreResources

    %% Aggregate roles
    CR_Admin -->|"CRUD"| RayCR
    CR_Editor -->|"CRUD"| RayCR
    CR_Viewer -->|"get,list,watch"| RayCR

