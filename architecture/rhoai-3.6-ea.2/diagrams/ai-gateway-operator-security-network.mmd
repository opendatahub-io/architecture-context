graph TB
    subgraph ClusterInternal["CLUSTER-INTERNAL (All communication via Kubernetes API)"]
        direction TB

        subgraph PlatformNS["Namespace: platform"]
            PlatformOp["opendatahub-operator<br/>SA: platform operator"]
        end

        subgraph AppNS["Namespace: redhat-ods-applications"]
            direction TB
            Operator["ai-gateway-operator<br/>SA: ai-gateway-operator/system<br/>Health: 8081/TCP HTTP<br/>Metrics: 8443/TCP HTTPS<br/>TLS: cluster profile<br/>FIPS: strictfipsruntime<br/>Base: ubi9-pqc:9.8"]
            MetricsSvc["ai-gateway-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS / TLS (cluster profile)<br/>Auth: TokenReview + SAR"]

            subgraph VendoredSubs["Vendored Sub-Components"]
                MaaS["maas-controller<br/>Models as a Service<br/>Teardown: annotation handshake"]
                AIGWCtrl["ai-gateway-controller<br/>praxis-extproc routing"]
                BatchGW["batch-gateway-operator<br/>LLM-d batch inference"]
            end

            Operator --> MetricsSvc
        end

        subgraph InfraNS["Namespace: redhat-ai-gateway-infra"]
            InfraSecrets["Infrastructure Secrets<br/>(maas-db-config)"]
        end

        subgraph PlatformIntegrations["Platform Integrations"]
            CertMgr["cert-manager<br/>TLS certificates"]
            GatewayAPI["Gateway API<br/>HTTPRoute/Gateway"]
            KuadrantSvc["Kuadrant<br/>AuthPolicy/RateLimit"]
            AuthorinoSvc["Authorino<br/>AuthN backend"]
            PromOp["prometheus-operator<br/>ServiceMonitor"]
            IstioSvc["Istio<br/>DestinationRule/EnvoyFilter"]
            OTelSvc["OpenTelemetry<br/>Collectors"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        AIGatewayCR["AIGateway CR<br/>(cluster-scoped singleton)<br/>default-aigateway"]
        OSAPIServer["OpenShift APIServer<br/>config.openshift.io<br/>TLS Profile + Adherence"]
    end

    %% Flows
    PlatformOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| AIGatewayCR
    AIGatewayCR -->|"Watch trigger"| Operator
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    Operator -->|"kustomize deploy"| MaaS
    Operator -->|"kustomize deploy"| AIGWCtrl
    Operator -->|"kustomize deploy"| BatchGW
    Operator -->|"Watch TLS profile"| OSAPIServer
    Operator -->|"cross-NS RBAC"| InfraSecrets

    MaaS -->|"CRD CRUD"| K8sAPI
    AIGWCtrl -->|"CRD CRUD"| K8sAPI
    BatchGW -->|"CRD CRUD"| K8sAPI

    K8sAPI ---|"integration"| CertMgr
    K8sAPI ---|"integration"| GatewayAPI
    K8sAPI ---|"integration"| KuadrantSvc
    K8sAPI ---|"integration"| AuthorinoSvc
    K8sAPI ---|"integration"| PromOp
    K8sAPI ---|"integration"| IstioSvc
    K8sAPI ---|"integration"| OTelSvc

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef subcomp fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cr fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef integration fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef infra fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Operator operator
    class MaaS,AIGWCtrl,BatchGW subcomp
    class PlatformOp platform
    class K8sAPI apiserver
    class AIGatewayCR,OSAPIServer cr
    class MetricsSvc operator
    class CertMgr,GatewayAPI,KuadrantSvc,AuthorinoSvc,PromOp,IstioSvc,OTelSvc integration
    class InfraSecrets infra
