graph TB
    subgraph DataSource["DATA SOURCE (Repository — no runtime)"]
        Manifest["rhoai-disconnected-images.yaml<br/>47 digest-pinned images<br/>SHA256 content integrity"]
    end

    subgraph MirroringLayer["MIRRORING TOOLING (Consumer-operated)"]
        MirrorTool["oc mirror / Quay Mirror<br/>Consumer-supplied credentials<br/>No credentials in this repo"]
    end

    subgraph SourceRegistries["SOURCE REGISTRIES (External)"]
        Quay["quay.io/modh<br/>7 community images<br/>FMS HF Tuning + Ray<br/>CUDA + ROCm variants"]
        RHIO["registry.redhat.io/rhoai<br/>40 productized images<br/>Notebooks + Pipelines + Training<br/>py311/py312, CPU/CUDA/ROCm"]
    end

    subgraph Destination["DESTINATION (Consumer-operated)"]
        DisReg["Disconnected Mirror Registry<br/>Air-gapped RHOAI installation"]
    end

    %% Flows
    Manifest -->|File read<br/>No network| MirrorTool
    MirrorTool -->|HTTPS/443<br/>TLS 1.2+<br/>Registry credentials| Quay
    MirrorTool -->|HTTPS/443<br/>TLS 1.2+<br/>Registry credentials| RHIO
    MirrorTool -->|HTTPS/443<br/>TLS consumer-configured<br/>Registry credentials| DisReg

    %% Styling
    classDef datasource fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef mirroring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
