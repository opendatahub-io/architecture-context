graph TB
    subgraph OperatorPod["mlflow-operator-controller-manager"]
        direction TB
        MLflowReconciler["MLflowReconciler<br/>(Helm-rendering controller)"]
        MLflowOperatorReconciler["MLflowOperatorReconciler<br/>(conditionally enabled)"]
        NamespaceRBACReconciler["NamespaceRBACReconciler<br/>(conditionally enabled)"]
        SecurityProfileWatcher["SecurityProfileWatcher<br/>(TLS profile reload)"]
        HelmChart["Helm Chart<br/>(charts/mlflow)"]

        MLflowReconciler -->|renders| HelmChart
    end

    %% CRDs
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)"]
    MLflowOperatorCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)"]
    MLflowConfigCR["MLflowConfig CR<br/>(mlflow.kubeflow.org/v1)"]

    %% CRD watches
    MLflowCR -->|watched by| MLflowReconciler
    MLflowOperatorCR -->|watched by| MLflowOperatorReconciler
    MLflowConfigCR -->|watched by| MLflowReconciler

    %% Child resources created by MLflowReconciler
    subgraph ChildResources["Managed Child Resources"]
        Deployment["MLflow Deployment"]
        Service["MLflow Service"]
        PVC["PersistentVolumeClaim"]
        HTTPRoute["HTTPRoute"]
        ConsoleLink["ConsoleLink"]
        ServiceMonitor["ServiceMonitor"]
        CronJob["GC / Trace Archival<br/>CronJobs"]
        RoleBindings["Workspace<br/>RoleBindings"]
    end

    HelmChart -->|creates| Deployment
    HelmChart -->|creates| Service
    HelmChart -->|creates| PVC
    MLflowReconciler -->|creates| HTTPRoute
    MLflowReconciler -->|creates| ConsoleLink
    MLflowReconciler -->|creates| ServiceMonitor
    HelmChart -->|creates| CronJob
    NamespaceRBACReconciler -->|manages| RoleBindings

    %% Namespace watching
    Namespaces["Namespaces<br/>(with workspace label)"] -->|watched by| NamespaceRBACReconciler

    %% Platform dependencies
    Gateway["Platform Gateway<br/>(data-science-gateway)"]
    OpenShiftConsole["OpenShift Console"]
    Prometheus["Prometheus"]
    AuthCR["ODH Auth CR"]
    APIServer["OpenShift APIServer<br/>TLS Profile"]

    HTTPRoute -->|routes via| Gateway
    ConsoleLink -->|registers in| OpenShiftConsole
    ServiceMonitor -->|scraped by| Prometheus
    NamespaceRBACReconciler -->|reads| AuthCR
    SecurityProfileWatcher -->|watches| APIServer

    %% Styling
    style OperatorPod fill:#4a90e2,stroke:#333,color:#fff
    style MLflowReconciler fill:#357abd,stroke:#333,color:#fff
    style MLflowOperatorReconciler fill:#357abd,stroke:#333,color:#fff
    style NamespaceRBACReconciler fill:#357abd,stroke:#333,color:#fff
    style SecurityProfileWatcher fill:#357abd,stroke:#333,color:#fff
    style HelmChart fill:#5a9fd4,stroke:#333,color:#fff
    style MLflowCR fill:#f5a623,stroke:#333
    style MLflowOperatorCR fill:#f5a623,stroke:#333
    style MLflowConfigCR fill:#f5a623,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style OpenShiftConsole fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style AuthCR fill:#7ed321,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
