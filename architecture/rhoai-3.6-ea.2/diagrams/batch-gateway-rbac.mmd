graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["{release}-batch-gateway-apiserver"]
        SA_Proc["{release}-batch-gateway-processor"]
        SA_GC["{release}-batch-gateway-gc"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_GC["{release}-batch-gateway-gc-pod-watcher<br/>(RoleBinding)"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        Role_GC["{release}-batch-gateway-gc-pod-watcher<br/>(Role)"]
    end

    subgraph APIResources["API Resources"]
        Pods["core<br/>pods"]
        StatefulSets["apps<br/>statefulsets"]
    end

    subgraph Secrets["Secrets"]
        SecretMain["batch-gateway-secrets<br/>(Opaque)<br/>Redis URL, PostgreSQL URL,<br/>inference API key, S3 key"]
        SecretTLS["{release}-batch-gateway-apiserver-tls<br/>(kubernetes.io/tls)<br/>TLS cert + key"]
    end

    subgraph AuthModel["Authentication Model"]
        ExtAuth["External Auth<br/>(Kuadrant/Authorino)<br/>API Key / Token"]
        TenantHeader["Tenant Identity<br/>X-MaaS-Username header"]
        K8sAuth["In-cluster Auth<br/>ServiceAccount Token"]
    end

    %% RBAC bindings
    SA_GC -->|"bound via"| RB_GC
    RB_GC -->|"grants"| Role_GC
    Role_GC -->|"get, list, watch"| Pods
    Role_GC -->|"get, list, watch"| StatefulSets

    %% No RBAC for apiserver/processor (no K8s API access)
    SA_API -.->|"no K8s RBAC<br/>(no API access)"| APIResources
    SA_Proc -.->|"no K8s RBAC<br/>(no API access)"| APIResources

    %% Secret access
    SA_API -->|"mounts"| SecretMain
    SA_API -->|"mounts (optional)"| SecretTLS
    SA_Proc -->|"mounts"| SecretMain
    SA_GC -->|"mounts"| SecretMain

    %% Auth model
    ExtAuth -->|"enforces before<br/>traffic reaches API"| SA_API
    TenantHeader -->|"extracted by<br/>middleware"| SA_API
    K8sAuth -->|"automatic<br/>in-cluster"| SA_GC

    style SA_API fill:#4a90e2,color:#fff
    style SA_Proc fill:#4a90e2,color:#fff
    style SA_GC fill:#4a90e2,color:#fff
    style Role_GC fill:#f5a623,color:#000
    style RB_GC fill:#f5a623,color:#000
    style Pods fill:#7ed321,color:#000
    style StatefulSets fill:#7ed321,color:#000
    style SecretMain fill:#e8e8e8,stroke:#333
    style SecretTLS fill:#e8e8e8,stroke:#333
    style ExtAuth fill:#ffe6cc,stroke:#d79b00
    style TenantHeader fill:#ffe6cc,stroke:#d79b00
    style K8sAuth fill:#d5e8d4,stroke:#82b366
