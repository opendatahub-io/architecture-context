graph TB
    subgraph "llama-stack-provider-trustyai-garak"
        subgraph "Entry Points"
            SimpleMode["evalhub<br/>(Simple Mode)"]
            KFPMode["evalhub.kfp_adapter<br/>(KFP Mode)"]
        end

        subgraph "Core Modules"
            Adapter["GarakAdapter<br/>(FrameworkAdapter)"]
            PipelineSteps["core/pipeline_steps<br/>(Business Logic)"]
            KFPPipeline["evalhub/kfp_pipeline<br/>(6-Step Pipeline Def)"]
            S3Utils["evalhub/s3_utils<br/>(S3 Client Factory)"]
        end

        SimpleMode -->|initializes| Adapter
        KFPMode -->|initializes| Adapter
        Adapter -->|delegates| PipelineSteps
        Adapter -->|builds pipeline| KFPPipeline
        KFPPipeline -->|artifact transfer| S3Utils
        PipelineSteps -->|artifact transfer| S3Utils
    end

    subgraph "Job Configuration"
        ConfigMap["/etc/eval-job/spec.json<br/>(ConfigMap Mount)"]
        ModelAuth["model-auth Secret<br/>(Volume Mount)"]
        DataConn["Data Connection Secret<br/>(Env Injection)"]
    end

    ConfigMap -->|read JobSpec| Adapter
    ModelAuth -->|API keys| PipelineSteps
    DataConn -->|AWS creds| S3Utils

    subgraph "Simple Mode Execution"
        GarakSubprocess["Garak Subprocess<br/>(Red-Team Scan)"]
    end

    subgraph "KFP Mode Execution"
        KFPValidate["1. Validate"]
        KFPTaxonomy["2. Resolve Taxonomy"]
        KFPSDG["3. SDG Generate"]
        KFPPrompts["4. Prepare Prompts"]
        KFPScan["5. Garak Scan"]
        KFPOutputs["6. Write Outputs"]

        KFPValidate --> KFPTaxonomy --> KFPSDG --> KFPPrompts --> KFPScan --> KFPOutputs
    end

    Adapter -->|simple mode| GarakSubprocess
    KFPPipeline -->|submits| KFPValidate

    %% External dependencies
    GarakSubprocess -->|probes| TargetLLM["Target LLM Endpoint"]
    KFPScan -->|probes| TargetLLM
    KFPSDG -->|generates data| SDGEndpoint["SDG Model Endpoint"]

    Adapter -->|callbacks| EvalHubSidecar["eval-hub Sidecar"]
    KFPPipeline -->|submits to| KFPAPI["Kubeflow Pipelines API"]
    S3Utils -->|reads/writes| S3["S3-Compatible Storage"]

    %% Styling
    style SimpleMode fill:#4a90e2,color:#fff
    style KFPMode fill:#4a90e2,color:#fff
    style Adapter fill:#4a90e2,color:#fff
    style PipelineSteps fill:#4a90e2,color:#fff
    style KFPPipeline fill:#4a90e2,color:#fff
    style S3Utils fill:#4a90e2,color:#fff
    style GarakSubprocess fill:#9b59b6,color:#fff
    style KFPValidate fill:#e67e22,color:#fff
    style KFPTaxonomy fill:#e67e22,color:#fff
    style KFPSDG fill:#e67e22,color:#fff
    style KFPPrompts fill:#e67e22,color:#fff
    style KFPScan fill:#e67e22,color:#fff
    style KFPOutputs fill:#e67e22,color:#fff
    style ConfigMap fill:#f5a623,color:#000
    style ModelAuth fill:#f5a623,color:#000
    style DataConn fill:#f5a623,color:#000
    style TargetLLM fill:#e8e8e8,color:#000
    style SDGEndpoint fill:#e8e8e8,color:#000
    style EvalHubSidecar fill:#7ed321,color:#000
    style KFPAPI fill:#7ed321,color:#000
    style S3 fill:#e8e8e8,color:#000
