graph TB
    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_WVA["Namespace: wva-system"]
            Controller["WVA Controller Manager<br/>SA: controller-manager<br/>nonRoot, drop ALL capabilities<br/>Ports: 8081 (health), 8443 (metrics)"]
        end

        subgraph Monitoring["Monitoring"]
            PromScraper["Prometheus<br/>SA: kube-prometheus-stack-prometheus<br/>ServiceMonitor discovery"]
        end

        subgraph K8sControl["Kubernetes Control Plane"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph ObsStack["Observability Stack"]
            Thanos["Prometheus / Thanos Querier<br/>9091/TCP or 443/TCP<br/>HTTPS TLS 1.2+"]
        end
    end

    subgraph WatchedResources["Watched Resources (Kubernetes API)"]
        HPAs["HorizontalPodAutoscalers"]
        ScaledObjects["KEDA ScaledObjects"]
        InferencePools["InferencePools<br/>inference.networking.k8s.io"]
        ConfigMaps["ConfigMaps<br/>labeled: wva"]
        Nodes["Nodes<br/>GPU labels"]
    end

    subgraph ScaleTargets["Scale Targets (Kubernetes API)"]
        Deployments["Deployments<br/>Scale subresource"]
        LWS["LeaderWorkerSets<br/>Scale subresource"]
    end

    %% Metrics scraping
    PromScraper -->|"HTTPS/8443<br/>TLS (self-signed or service-ca)<br/>Bearer Token +<br/>TokenReview/SubjectAccessReview"| Controller

    %% Egress to K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token (in-cluster)<br/>Watch resources"| K8sAPI

    %% Egress to Prometheus
    Controller -->|"HTTPS/9091 or 443<br/>TLS 1.2+ (min enforced)<br/>Bearer Token (SA)<br/>Supports custom CA + mTLS"| Thanos

    %% K8s API to resources
    K8sAPI ---|watches| HPAs
    K8sAPI ---|watches| ScaledObjects
    K8sAPI ---|watches| InferencePools
    K8sAPI ---|watches| ConfigMaps
    K8sAPI ---|reads| Nodes
    K8sAPI ---|scales| Deployments
    K8sAPI ---|scales| LWS

    %% Styling
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef resources fill:#f5f5f5,stroke:#666,stroke-width:1px
    classDef targets fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Controller controller
    class PromScraper monitoring
    class Thanos monitoring
    class K8sAPI controlplane
    class HPAs,ScaledObjects,InferencePools,ConfigMaps,Nodes resources
    class Deployments,LWS targets
