graph LR
    Feast["Feast Operator<br/>+ Feature Server"]

    %% External Dependencies (Required frameworks)
    Feast -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    Feast -->|"HTTP framework"| FastAPI["FastAPI >=0.68.0"]
    Feast -->|"Go gRPC transport"| GRPCGo["gRPC (Go) 1.81.1"]
    Feast -->|"Python gRPC"| GRPCPy["gRPC (Python) >=1.56.2"]
    Feast -->|"OpenShift types"| OSApi["openshift/api"]
    Feast -->|"TLS profile config"| OSControllerCommon["openshift/controller-runtime-common"]

    %% Online Store Backends
    Feast -->|"online store"| Redis["Redis (Python >=4.2.2)"]
    Feast -->|"online store"| GoRedis["go-redis v9.20.0"]
    Feast -->|"online store"| Pgx["pgx v5.8.0 (Go)"]
    Feast -->|"online store"| Psycopg["psycopg >=3.2.5 (Python)"]

    %% Offline Store Backends
    Feast -->|"offline store"| BigQuery["google-cloud-bigquery >=2"]
    Feast -->|"offline store"| Snowflake["snowflake-connector >=3.7"]
    Feast -->|"offline store"| Boto3["boto3 >=1.38.27 (S3)"]

    %% Security / Crypto
    Feast -->|"TLS/crypto"| Cryptography["cryptography 50.0.0"]
    Feast -->|"JWT tokens"| PyJWT["PyJWT >=2.13.0"]

    %% Observability
    Feast -->|"Python metrics"| PromClient["prometheus-client"]
    Feast -->|"Go metrics"| PromGo["prometheus/client_golang 1.23.2"]
    Feast -->|"tracing"| OTel["OpenTelemetry 1.44.0"]

    %% Internal ODH/RHOAI Dependencies
    Feast -->|"CRD watch/reconcile"| FeatureStoreCRD["FeatureStore CR<br/>(feast.dev/v1)"]
    Feast -->|"notebook config injection"| Notebooks["Kubeflow Notebooks"]
    Feast -->|"feature-model tracking"| MLflow["MLflow"]
    Feast -->|"metrics monitoring"| PromOperator["prometheus-operator<br/>(ServiceMonitor)"]
    Feast -->|"external access"| Routes["OpenShift Routes"]
    Feast -->|"batch materialization"| SparkOp["Spark Operator"]

    %% Integration consumers
    Dashboard["ODH Dashboard"] -.->|"manages via UI"| Feast
    DSPipelines["Data Science Pipelines"] -.->|"auto deploy models"| Feast

    %% External Services
    Feast -->|"resource CRUD"| K8sAPI["Kubernetes API"]
    Feast -->|"registry/offline storage"| S3["S3 Storage"]
    Feast -->|"registry/offline storage"| GCS["Google Cloud Storage"]

