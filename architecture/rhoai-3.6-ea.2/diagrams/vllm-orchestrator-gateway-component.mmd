graph TB
    subgraph "vllm-orchestrator-gateway"
        direction TB
        Main["main()"]
        RouteReg["Route Registration"]
        HttpListener["HTTP Listener<br/>8090/TCP"]
        ReqForward["Request Forwarder"]
        StreamHandler["SSE Stream Handler"]
        NonStreamHandler["Non-Stream Handler"]
        ConfigLoader["Config Loader<br/>YAML"]
        ConfigValidator["Config Validator"]
        TlsClient["mTLS Client Builder"]

        Main --> ConfigLoader
        ConfigLoader --> ConfigValidator
        Main --> RouteReg
        RouteReg --> HttpListener
        HttpListener --> ReqForward
        ReqForward --> StreamHandler
        ReqForward --> NonStreamHandler
        Main --> TlsClient
    end

    Client[Client] -->|"POST /{route}/v1/chat/completions<br/>8090/TCP HTTP"| HttpListener
    ConfigFile["config.yaml"] -->|"read at startup"| ConfigLoader
    TlsCert["/etc/tls/private/<br/>tls.crt + tls.key"] -.->|"optional mTLS certs"| TlsClient
    CACert["/etc/tls/ca/<br/>service-ca.crt"] -.->|"optional CA cert"| TlsClient

    StreamHandler -->|"POST /api/v2/chat/completions-detection<br/>SSE stream"| Orchestrator["FMS Guardrails<br/>Orchestrator<br/>8085/TCP"]
    NonStreamHandler -->|"POST /api/v2/chat/completions-detection<br/>JSON"| Orchestrator

    style Main fill:#4a90e2,color:#fff
    style RouteReg fill:#4a90e2,color:#fff
    style HttpListener fill:#4a90e2,color:#fff
    style ReqForward fill:#4a90e2,color:#fff
    style StreamHandler fill:#4a90e2,color:#fff
    style NonStreamHandler fill:#4a90e2,color:#fff
    style ConfigLoader fill:#4a90e2,color:#fff
    style ConfigValidator fill:#4a90e2,color:#fff
    style TlsClient fill:#4a90e2,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style ConfigFile fill:#f5a623,color:#fff
    style TlsCert fill:#f5a623,color:#fff
    style CACert fill:#f5a623,color:#fff
    style Orchestrator fill:#7ed321,color:#fff
