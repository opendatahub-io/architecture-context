graph TB
    subgraph Operator["model-registry-operator-controller-manager"]
        direction TB
        MRReconciler["ModelRegistryReconciler<br/>Reconciles ModelRegistry CRs"]
        CatReconciler["CatalogReconciler<br/>Reconciles Catalog CRs"]
        AIHubReconciler["AIHubReconciler<br/>Reconciles AIHub CRs"]
        WebhookServer["Webhook Server<br/>9443/TCP"]
        MetricsServer["Metrics Server<br/>8443/TCP"]
        HealthProbes["Health Probes<br/>8081/TCP"]
        TLSWatcher["SecurityProfileWatcher<br/>Monitors TLS profile changes"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        MR_CR["ModelRegistry CR<br/>v1beta1 (storage)<br/>v1alpha1 (spoke)"]
        Catalog_CR["Catalog CR<br/>v1alpha1"]
        AIHub_CR["AIHub CR<br/>v1alpha1 (Cluster)"]
    end

    subgraph RegistryStack["Per-Registry Deployment Stack"]
        RegistryDeploy["{registry-name}<br/>REST API + kube-rbac-proxy<br/>8080/8443 TCP"]
        RegistryDB["{registry-name}-postgres<br/>PostgreSQL 16<br/>5432/TCP"]
        RegistryNP["NetworkPolicy<br/>Per-registry traffic rules"]
        RegistryRBAC["Per-registry RBAC<br/>ServiceAccount, Role,<br/>Group, RoleBinding"]
    end

    subgraph CatalogStack["Catalog Deployment Stack"]
        CatalogDeploy["model-catalog<br/>Catalog API + kube-rbac-proxy<br/>8080/8443 TCP"]
        CatalogDB["model-catalog-postgres<br/>PostgreSQL 16<br/>5432/TCP"]
    end

    subgraph IngressLayer["Ingress"]
        HTTPRoutes["HTTPRoutes<br/>(via data-science-gateway)"]
        OSRoutes["OpenShift Routes<br/>(legacy)"]
    end

    %% CR to Controller mappings
    MR_CR -->|watched by| MRReconciler
    Catalog_CR -->|watched by| CatReconciler
    AIHub_CR -->|watched by| AIHubReconciler

    %% Controller creates resources
    MRReconciler -->|creates| RegistryDeploy
    MRReconciler -->|creates| RegistryDB
    MRReconciler -->|creates| RegistryNP
    MRReconciler -->|creates| RegistryRBAC
    MRReconciler -->|creates| HTTPRoutes
    MRReconciler -->|creates| OSRoutes

    CatReconciler -->|creates| CatalogDeploy
    CatReconciler -->|creates| CatalogDB

    AIHubReconciler -->|orchestrates| Catalog_CR
    AIHubReconciler -->|manages| PlatformRBAC["Platform RBAC<br/>& Webhooks"]

    %% Webhook connections
    WebhookServer -->|mutates/validates| MR_CR
    WebhookServer -->|converts v1alpha1 to v1beta1| MR_CR

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OSConfig["OpenShift Config API"]
    OSUsers["OpenShift User/Group API"]

    MRReconciler -->|reconciles via| K8sAPI
    CatReconciler -->|reconciles via| K8sAPI
    Operator -->|reads TLS profile| OSConfig
    MRReconciler -->|manages groups| OSUsers

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style MRReconciler fill:#357abd,stroke:#333,color:#fff
    style CatReconciler fill:#357abd,stroke:#333,color:#fff
    style AIHubReconciler fill:#357abd,stroke:#333,color:#fff
    style WebhookServer fill:#357abd,stroke:#333,color:#fff
    style MetricsServer fill:#357abd,stroke:#333,color:#fff
    style HealthProbes fill:#357abd,stroke:#333,color:#fff
    style TLSWatcher fill:#357abd,stroke:#333,color:#fff
    style MR_CR fill:#f5a623,stroke:#333
    style Catalog_CR fill:#f5a623,stroke:#333
    style AIHub_CR fill:#f5a623,stroke:#333
    style RegistryDeploy fill:#7ed321,stroke:#333
    style RegistryDB fill:#7ed321,stroke:#333
    style CatalogDeploy fill:#7ed321,stroke:#333
    style CatalogDB fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSConfig fill:#e8e8e8,stroke:#333
    style OSUsers fill:#e8e8e8,stroke:#333
