graph TB
    subgraph External["EXTERNAL (Untrusted) - Build-Time Only"]
        HF["HuggingFace API<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS (Go default)"]
        RedHatReg["registry.redhat.io<br/>443/TCP HTTPS<br/>TLS (library default)"]
        QuayReg["quay.io<br/>443/TCP HTTPS<br/>TLS (library default)"]
        GitHubAPI["GitHub API<br/>api.github.com<br/>raw.githubusercontent.com<br/>443/TCP HTTPS<br/>TLS (Go default)"]
    end

    subgraph CIEnvironment["CI ENVIRONMENT (Build-Time)"]
        Extractor["model-extractor<br/>(Go CLI)<br/>No listening ports<br/>30s HTTP timeout"]
    end

    subgraph KonfluxBuild["KONFLUX BUILD PIPELINE"]
        Pipeline["Tekton Pipeline<br/>hermetic: true<br/>Go module prefetch (Hermeto)<br/>Multi-arch: x86_64, ppc64le, s390x, arm64"]
    end

    subgraph RuntimeCluster["RUNTIME CLUSTER (No Network Surface)"]
        subgraph SidecarPod["Sidecar Pod"]
            Container["odh-model-metadata-collection<br/>UBI 9 minimal-pqc<br/>User: 1001 (non-root)<br/>No ports exposed<br/>No network code<br/>sleep infinity"]
            Volume["/app/data<br/>Read-only YAML catalogs"]
        end

        subgraph ConsumerPod["Consumer Pod"]
            Dashboard["RHOAI Dashboard<br/>Mounts /app/data"]
        end
    end

    %% Build-time flows
    HF -->|"HTTPS/443<br/>Bearer HF_TOKEN (optional)"| Extractor
    RedHatReg -->|"HTTPS/443<br/>Docker auth (config.json)"| Extractor
    QuayReg -->|"HTTPS/443<br/>Docker auth (config.json)"| Extractor
    GitHubAPI -->|"HTTPS/443<br/>Bearer GITHUB_TOKEN (optional)"| Extractor

    Extractor -->|"File I/O<br/>YAML catalogs"| Pipeline
    Pipeline -->|"COPY data/<br/>Container image"| Container

    %% Runtime flow
    Volume -->|"Volume mount<br/>Kubernetes RBAC"| Dashboard

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ci fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef build fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef consumer fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class HF,RedHatReg,QuayReg,GitHubAPI external
    class Extractor ci
    class Pipeline build
    class Container,Volume runtime
    class Dashboard consumer
