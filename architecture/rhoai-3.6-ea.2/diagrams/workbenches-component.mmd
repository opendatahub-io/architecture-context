graph TB
    subgraph Workbenches["Workbenches (Kubeflow Notebooks v2)"]
        direction TB

        subgraph ControllerSub["workspaces-controller"]
            Controller["Controller Manager<br/>Go Operator<br/>:8081 health, :8080 metrics"]
            Webhook["Webhook Server<br/>:9443/TCP HTTPS"]
            TLSWatcher["TLS Profile Watcher"]
            Controller -->|"validates via"| Webhook
            TLSWatcher -->|"restarts on<br/>policy change"| Controller
        end

        subgraph BackendSub["workspaces-backend"]
            Backend["REST API Server<br/>:4000/TCP HTTP<br/>Go + httprouter"]
            AuthMiddleware["Auth Middleware<br/>TokenReview / Internal Headers"]
            AuthzMiddleware["Authz Middleware<br/>SubjectAccessReview"]
            Backend -->|"per-request"| AuthMiddleware
            AuthMiddleware -->|"delegates"| AuthzMiddleware
        end

        subgraph FrontendSub["workspaces-frontend"]
            Frontend["React SPA<br/>:8080/TCP nginx"]
        end
    end

    User["User / Data Scientist"] -->|"browser"| Frontend
    Frontend -->|"REST calls"| Backend

    WorkspaceCR["Workspace CR<br/>kubeflow.org/v1beta1<br/>Namespaced"]
    WorkspaceKindCR["WorkspaceKind CR<br/>kubeflow.org/v1beta1<br/>Cluster-scoped"]

    Backend -->|"creates/manages"| WorkspaceCR
    WorkspaceCR -->|"watched by"| Controller
    WorkspaceKindCR -->|"referenced by"| Controller
    Webhook -->|"validates"| WorkspaceCR
    Webhook -->|"validates"| WorkspaceKindCR

    Controller -->|"creates"| StatefulSet["StatefulSet<br/>(per workspace)"]
    Controller -->|"creates"| SvcSA["Service + SA<br/>+ RoleBinding"]
    Controller -->|"creates"| HTTPRoute["HTTPRoute<br/>(Gateway API mode)"]
    Controller -->|"creates"| RefGrant["ReferenceGrant<br/>(cross-namespace)"]
    Controller -->|"injects"| KubeRBACProxy["kube-rbac-proxy<br/>sidecar"]
    Controller -->|"creates"| VirtualService["VirtualService<br/>(Istio mode)"]

    Controller -->|"reads TLS profile"| OpenShiftAPI["OpenShift API<br/>config.openshift.io"]
    Backend -->|"TokenReview / SAR"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|"CRUD resources"| K8sAPI

    HTTPRoute -->|"references"| Gateway["data-science-gateway<br/>(platform Gateway)"]

    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style Backend fill:#4a90e2,color:#fff
    style AuthMiddleware fill:#4a90e2,color:#fff
    style AuthzMiddleware fill:#4a90e2,color:#fff
    style Frontend fill:#4a90e2,color:#fff
    style WorkspaceCR fill:#f5a623,color:#fff
    style WorkspaceKindCR fill:#f5a623,color:#fff
    style StatefulSet fill:#7ed321,color:#fff
    style SvcSA fill:#7ed321,color:#fff
    style HTTPRoute fill:#7ed321,color:#fff
    style RefGrant fill:#7ed321,color:#fff
    style KubeRBACProxy fill:#7ed321,color:#fff
    style VirtualService fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8
    style OpenShiftAPI fill:#e8e8e8
    style Gateway fill:#e8e8e8
