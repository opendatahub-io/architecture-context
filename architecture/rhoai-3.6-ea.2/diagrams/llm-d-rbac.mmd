graph TD
    subgraph "llm-d RBAC (Minimal - This Repository)"
        direction TB

        subgraph SA["Service Accounts"]
            ModelServerSA["sa<br/>(model-server pods)<br/>automountServiceAccountToken: false"]
        end

        subgraph Secrets_Section["Secrets"]
            HFToken["llm-d-hf-token<br/>Type: Opaque<br/>HuggingFace API token<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        end

        subgraph Auth["Authentication & Authorization"]
            NoAuth["Model Server Endpoints<br/>/v1/*, /health, /metrics<br/>Auth: None<br/>Enforcement: N/A"]
            GatewayAuth["Gateway-Level Auth<br/>Deferred to gateway<br/>implementation"]
        end
    end

    ModelServerSA -->|"uses"| HFToken
    NoAuth -.->|"auth delegated to"| GatewayAuth

    subgraph ExternalRBAC["RBAC Defined in Other Repos"]
        direction TB
        RouterRBAC["llm-d-router RBAC<br/>(separate repo)"]
        KVCacheRBAC["llm-d-kv-cache RBAC<br/>(separate repo)"]
        AutoscalerRBAC["llm-d-autoscaler RBAC<br/>(separate repo)"]
    end

    subgraph MultiTenancy["Multi-Tenancy Model"]
        direction TB
        TenantBoundary["Tenant Boundary: per-namespace"]
        SharedGateway["Shared Gateway<br/>allowedRoutes: from: All"]
        NSIsolation["Namespace Isolation<br/>No NetworkPolicy defined"]
    end

    Note["NOTE: No ClusterRoles or RoleBindings<br/>are defined in the llm-d repository.<br/>RBAC for router and ecosystem components<br/>is defined in their respective repos."]

    style ModelServerSA fill:#4a90e2,stroke:#333,color:#fff
    style HFToken fill:#f5a623,stroke:#333,color:#fff
    style NoAuth fill:#ff6b6b,stroke:#333,color:#fff
    style GatewayAuth fill:#ffe6cc,stroke:#d79b00
    style RouterRBAC fill:#7ed321,stroke:#333,color:#fff
    style KVCacheRBAC fill:#7ed321,stroke:#333,color:#fff
    style AutoscalerRBAC fill:#7ed321,stroke:#333,color:#fff
    style TenantBoundary fill:#dae8fc,stroke:#6c8ebf
    style SharedGateway fill:#ffe6cc,stroke:#d79b00
    style NSIsolation fill:#ff6b6b,stroke:#333,color:#fff
    style Note fill:#fff,stroke:#999,stroke-dasharray:5 5
