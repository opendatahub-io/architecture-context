graph TB
    subgraph "pipelines-components"
        direction TB

        subgraph BuildTime["Build-Time"]
            GenScript["generate-managed-pipelines<br/>Discovers managed: true pipelines<br/>Compiles pipeline.py → KFP YAML"]
        end

        subgraph InitContainer["Init Container (odh-pipelines-components)"]
            InitScript["init-managed-pipelines<br/>Python 3.12 / UBI9"]
            InitScript -->|"copies YAMLs to"| SharedVol["/config/managed-pipelines<br/>(shared volume)"]
            InitScript -->|"if RELATED_IMAGE_* set"| Recompile["Recompile with<br/>operator-supplied images"]
            Recompile -->|"writes"| SharedVol
        end

        subgraph PythonPackage["kfp-components v1.11.0"]
            direction LR
            DataProc["Data Processing<br/>tabular_data_loader<br/>timeseries_data_loader<br/>documents_discovery<br/>text_extraction"]
            Training["Training<br/>SFT / LoRA / OSFT<br/>LoRA-GRPO<br/>AutoGluon"]
            Evaluation["Evaluation<br/>lm-eval harness<br/>Eval Hub + KServe"]
            Deployment["Deployment<br/>model_deployment<br/>deploy_embedding_model<br/>model_registry"]
        end

        subgraph RuntimeImages["Runtime Container Images"]
            AutoML["odh-automl<br/>AIPCC CPU base"]
            AutoRAG["odh-autorag<br/>AIPCC CPU base<br/>+ Docling models"]
            AutoRAGInf["odh-autorag-inference<br/>AIPCC CPU base"]
        end
    end

    GenScript -->|"produces YAMLs for"| InitScript

    %% External consumers
    KFPServer["KFP API Server"] -->|"reads from"| SharedVol
    PipelineAuthor["Pipeline Author"] -->|"imports"| PythonPackage

    %% CRD interactions from Deployment components
    Deployment -->|"creates"| ServingRuntime["ServingRuntime CR<br/>(serving.kserve.io/v1alpha1)"]
    Deployment -->|"creates"| InferenceService["InferenceService CR<br/>(serving.kserve.io/v1beta1)"]
    Deployment -->|"reads"| HWProfile["HardwareProfile CR<br/>(infrastructure.opendatahub.io/v1)"]

    %% DSPO interaction
    DSPO["DSPO<br/>Data Science Pipelines Operator"] -->|"injects RELATED_IMAGE_*"| InitScript

    %% Styling
    style InitScript fill:#4a90e2,stroke:#333,color:#fff
    style GenScript fill:#4a90e2,stroke:#333,color:#fff
    style DataProc fill:#7ed321,stroke:#333
    style Training fill:#7ed321,stroke:#333
    style Evaluation fill:#7ed321,stroke:#333
    style Deployment fill:#7ed321,stroke:#333
    style AutoML fill:#f5a623,stroke:#333
    style AutoRAG fill:#f5a623,stroke:#333
    style AutoRAGInf fill:#f5a623,stroke:#333
    style ServingRuntime fill:#e8e8e8,stroke:#333
    style InferenceService fill:#e8e8e8,stroke:#333
    style HWProfile fill:#e8e8e8,stroke:#333
    style KFPServer fill:#e8e8e8,stroke:#333
    style DSPO fill:#e8e8e8,stroke:#333
    style SharedVol fill:#fff2cc,stroke:#d6b656
