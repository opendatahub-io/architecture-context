graph TB
    subgraph Operator["OPERATOR WORKSTATION (Trusted)"]
        SRE["Operator / SRE"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>443/TCP HTTPS<br/>Auth: kubeconfig"]
    end

    subgraph Cluster["CLUSTER INTERNAL (No service mesh, no mTLS)"]
        direction TB

        subgraph NS_Deploy["Namespace: {deployment-namespace}"]
            PreflightPod["Model Server Pod<br/>Preflight Mode<br/>SA: default"]
            PreflightHTTP["Preflight HTTP Server<br/>8000/TCP HTTP<br/>⚠ No TLS, No Auth<br/>/health /info /exit"]
            PreflightPod --- PreflightHTTP
        end

        subgraph NS_Bench["Namespace: {benchmark-namespace}"]
            ServerPod["NIXL Server Pod<br/>SA: default<br/>GPU: A100-SXM4-80GB"]
            ClientPod["NIXL Client Pod<br/>SA: default<br/>GPU: A100-SXM4-80GB"]
        end
    end

    subgraph NodePortExposure["EXTERNAL EXPOSURE (NodePort)"]
        NodePort["nixl-server Service<br/>NodePort 30002 → 5555/TCP<br/>⚠ No Auth, No Encryption"]
    end

    subgraph BuildDeps["BUILD-TIME EGRESS"]
        GitHub["github.com<br/>443/TCP HTTPS TLS 1.2+"]
        Mellanox["content.mellanox.com<br/>443/TCP HTTPS TLS 1.2+"]
        NVIDIA["developer.nvidia.com<br/>443/TCP HTTPS TLS 1.2+"]
    end

    %% Flows
    SRE -->|"HTTPS/443<br/>TLS<br/>kubeconfig"| APIServer
    APIServer -->|"kubectl exec<br/>WebSocket"| PreflightPod
    APIServer -->|"kubectl exec<br/>WebSocket"| ServerPod
    APIServer -->|"kubectl exec<br/>WebSocket"| ClientPod

    SRE -->|"HTTP/8000<br/>⚠ No TLS<br/>⚠ No Auth"| PreflightHTTP

    ServerPod -->|"ZMQ PAIR/5555<br/>⚠ No Encryption<br/>⚠ No Auth"| ClientPod
    ServerPod <-->|"UCX RDMA/TCP<br/>dynamic port<br/>⚠ No Encryption"| ClientPod

    ServerPod --- NodePort

    %% Styling
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class SRE operator
    class APIServer k8s
    class PreflightPod,PreflightHTTP,ServerPod,ClientPod internal
    class NodePort warning
    class GitHub,Mellanox,NVIDIA external
