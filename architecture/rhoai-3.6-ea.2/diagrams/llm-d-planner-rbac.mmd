graph TD
    subgraph "Service Account"
        SA["planner-backend<br/>Namespace: planner"]
    end

    subgraph "ClusterRole Binding"
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)<br/>Namespace: planner"]
    end

    subgraph "ClusterRole"
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph "API Resources"
        Nodes["core (v1)<br/>nodes"]
    end

    subgraph "Application-Level Auth"
        DBReset["/api/v1/db/reset<br/>DB_ADMIN_PASSWORD check<br/>(route handler, not middleware)"]
        AllOther["All other /api/v1/* endpoints<br/>No authentication<br/>(31 endpoints unauthenticated)"]
    end

    subgraph "Secrets"
        PlannerSecrets["planner-secrets (Opaque)<br/>Manual provisioning<br/>No auto-rotation"]
        HFToken["HF_TOKEN"]
        MCToken["MODEL_CATALOG_TOKEN"]
        OAIKey["OPENAI_API_KEY"]
        AAKey["AA_API_KEY"]
        DBPass["DB_ADMIN_PASSWORD"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes

    PlannerSecrets --- HFToken
    PlannerSecrets --- MCToken
    PlannerSecrets --- OAIKey
    PlannerSecrets --- AAKey
    PlannerSecrets --- DBPass
    DBPass -->|"verified by"| DBReset

