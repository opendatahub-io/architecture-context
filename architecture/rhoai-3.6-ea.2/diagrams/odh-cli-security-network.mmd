graph TB
    subgraph Client["CLIENT ENVIRONMENT"]
        RHAICLI["rhai-cli<br/>Go 1.26 | FIPS: strictfipsruntime<br/>Crypto Policy: DEFAULT:PQ<br/>Auth: kubeconfig credentials"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>AuthN: Bearer/ClientCert/OIDC<br/>AuthZ: RBAC"]
        OLM["Operator Lifecycle Manager<br/>(via Kubernetes API)"]
    end

    subgraph InCluster["IN-CLUSTER SERVICES"]
        TrustYAI["TrustYAI Service Routes<br/>443/TCP HTTPS<br/>TLS 1.2<br/>⚠ InsecureSkipVerify=true"]
        Routes["OpenShift Routes<br/>(discovered via K8s API)"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        GitHub["raw.githubusercontent.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: None (public)"]
    end

    subgraph MCPTransport["MCP TRANSPORT (Local Only)"]
        MCPStdio["MCP Server - stdio<br/>JSON-RPC over stdin/stdout<br/>No encryption<br/>No auth"]
        MCPSSE["MCP Server - SSE<br/>8080/TCP HTTP<br/>No encryption<br/>No auth<br/>⚠ Localhost only"]
    end

    subgraph Agents["AI AGENTS"]
        AIAgent["Claude / GPT / Cursor"]
    end

    %% Flows
    RHAICLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig credentials<br/>(bearer/cert/OIDC)"| K8sAPI
    K8sAPI ---|"OLM typed clientset"| OLM
    RHAICLI -->|"HTTPS/443<br/>TLS 1.2<br/>InsecureSkipVerify<br/>Bearer token"| TrustYAI
    RHAICLI -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth"| GitHub
    AIAgent -->|"JSON-RPC<br/>(stdio)"| MCPStdio
    AIAgent -->|"HTTP SSE<br/>8080/TCP"| MCPSSE
    MCPStdio --> RHAICLI
    MCPSSE --> RHAICLI

    %% Styling
    classDef client fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef incluster fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef mcp fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef agent fill:#f9f9f9,stroke:#999,stroke-width:2px

    class RHAICLI client
    class K8sAPI,OLM controlplane
    class TrustYAI,Routes incluster
    class GitHub external
    class MCPStdio,MCPSSE mcp
    class AIAgent agent
