graph TB
    subgraph CLI["rhai-cli (odh-cli)"]
        direction TB
        Root["Root Cobra Command<br/>13 subcommands"]

        subgraph Commands["CLI Subcommands"]
            direction LR
            Status["status"]
            Lint["lint"]
            Migrate["migrate"]
            Diagnose["diagnose"]
            Get["get"]
            Deps["deps"]
            Backup["backup"]
            Logs["logs"]
            Events["events"]
            Components["components"]
            API["api"]
            Version["version"]
            Completion["completion"]
        end

        subgraph MCPLayer["MCP Server Layer"]
            MCPServer["MCP Server<br/>stdio / SSE transport"]
            MCPTools["12 MCP Tool Definitions"]
            DiagTools["Diagnostic MCP Tools<br/>(from opendatahub-operator)"]
        end

        subgraph CorePkgs["Core Packages"]
            direction LR
            ClientPkg["pkg/util/client<br/>Reader / Writer / Client"]
            ErrorPkg["pkg/util/errors<br/>Structured Error Classification"]
            RBACPkg["pkg/util/kube/rbac<br/>RBAC Pre-flight Checks"]
        end

        subgraph LintEngine["Lint Engine"]
            direction LR
            CompChecks["Component Checks<br/>(KServe, Ray, Kueue, etc.)"]
            DepChecks["Dependency Checks"]
            PlatChecks["Platform Checks<br/>(DSC/DSCI)"]
            WLChecks["Workload Checks"]
        end

        subgraph MigrateEngine["Migration Engine"]
            direction LR
            ActionRegistry["Action Registry"]
            PreUpgrade["Pre-upgrade Actions"]
            PostUpgrade["Post-upgrade Actions"]
            PreEnable["Pre-enablement Actions"]
        end

        GenSchemas["gen-schemas<br/>JSON Schema Generator"]
    end

    Root --> Commands
    Root --> MCPLayer
    MCPServer --> MCPTools
    MCPServer --> DiagTools
    MCPTools -->|"reuses cmd.Command"| Commands
    Commands --> CorePkgs
    Lint --> LintEngine
    Migrate --> MigrateEngine

    subgraph External["External Systems"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
        OLM["Operator Lifecycle Manager"]
        TrustYAI["TrustYAI Service<br/>443/TCP HTTPS"]
        GitHubRaw["raw.githubusercontent.com<br/>443/TCP HTTPS"]
    end

    ClientPkg -->|"6 client types"| K8sAPI
    Deps -->|"OLM typed clientset"| OLM
    Migrate -->|"metric backup/restore"| TrustYAI
    Deps -->|"manifest fetch"| GitHubRaw

    subgraph Agents["AI Agents"]
        Claude["Claude / GPT / Cursor"]
    end

    Claude -->|"JSON-RPC (stdio)<br/>or SSE (HTTP/8080)"| MCPServer

    style CLI fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style MCPServer fill:#4a90e2,stroke:#333,color:#fff
    style MCPTools fill:#4a90e2,stroke:#333,color:#fff
    style DiagTools fill:#4a90e2,stroke:#333,color:#fff
    style Root fill:#4a90e2,stroke:#333,color:#fff
    style ClientPkg fill:#7ed321,stroke:#333
    style ErrorPkg fill:#7ed321,stroke:#333
    style RBACPkg fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style OLM fill:#f5a623,stroke:#333
    style TrustYAI fill:#f5a623,stroke:#333
    style GitHubRaw fill:#f5a623,stroke:#333
    style Claude fill:#e8e8e8,stroke:#333
    style GenSchemas fill:#999,stroke:#333,color:#fff
