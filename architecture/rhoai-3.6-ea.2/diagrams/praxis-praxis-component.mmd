graph TB
    subgraph PraxisProxy["Praxis Proxy Server"]
        direction TB

        subgraph ServerBin["praxis-proxy (server binary)"]
            Main["main.rs<br/>CLI parsing, config loading,<br/>tracing init, crypto provider install"]
        end

        subgraph Protocol["praxis-proxy-protocol"]
            HTTPAdapter["HTTP Protocol Adapter<br/>Pingora callbacks → pipeline"]
            TCPAdapter["TCP Protocol Adapter<br/>Pingora callbacks → pipeline"]
            HealthService["Health/Metrics Service<br/>/healthy, /ready, /metrics"]
            AdminAPI["Admin API<br/>/api/stats, /api/pipelines,<br/>/api/log-level, /api/kv/*"]
        end

        subgraph Filter["praxis-proxy-filter"]
            FilterEngine["Pipeline Engine<br/>Chain resolution, condition eval"]

            subgraph BuiltinFilters["Built-in Filters"]
                Security["Security<br/>basic_auth, cors, csrf,<br/>ip_acl, policy, guardrails"]
                Traffic["Traffic Management<br/>router, load_balancer,<br/>rate_limit, circuit_breaker"]
                Transform["Transformation<br/>header, path_rewrite,<br/>url_rewrite, grpc_status"]
                Observability["Observability<br/>access_log, request_id,<br/>trace_context"]
                Payload["Payload Processing<br/>compression, json_body,<br/>json_rpc, grpc_web"]
            end
        end

        subgraph Core["praxis-proxy-core"]
            Config["YAML Config<br/>serde deserialization, validation"]
            KVStore["KV Store Registry<br/>Filter state management"]
            HealthState["Health State<br/>Upstream health tracking"]
            ReservedHeaders["Reserved Headers<br/>x-praxis-*, x-ext-protocol-*,<br/>x-ext-agent-*"]
        end

        subgraph TLS["praxis-proxy-tls"]
            CryptoProvider["OpenSSL Crypto Provider<br/>Single process-wide, no fallback"]
            SNI["SNI Resolution<br/>Wildcard support"]
            CertLoader["Certificate Loader<br/>Hot-reload with 500ms debounce"]
            FIPSCheck["FIPS Runtime Check<br/>/proc/sys/crypto/fips_enabled"]
        end
    end

    %% Internal dependency flow
    Main --> HTTPAdapter
    Main --> TCPAdapter
    Main --> Config
    Main --> CryptoProvider
    HTTPAdapter --> FilterEngine
    TCPAdapter --> FilterEngine
    FilterEngine --> Security
    FilterEngine --> Traffic
    FilterEngine --> Transform
    FilterEngine --> Observability
    FilterEngine --> Payload
    Config --> KVStore
    Config --> HealthState
    CryptoProvider --> FIPSCheck
    CryptoProvider --> SNI
    CryptoProvider --> CertLoader

    %% External connections
    Client[External Client] -->|HTTP/HTTPS<br/>8080/TCP| HTTPAdapter
    TCPClient[TCP Client] -->|TCP<br/>configurable| TCPAdapter
    Monitor[Monitoring System] -->|HTTP<br/>9902/TCP| HealthService
    AdminUser["Admin (loopback)"] -->|HTTP<br/>admin port| AdminAPI

    Traffic -->|routes to| Upstream[Upstream Clusters]

    %% Styling
    style Main fill:#4a90e2,color:#fff
    style FilterEngine fill:#4a90e2,color:#fff
    style CryptoProvider fill:#e74c3c,color:#fff
    style FIPSCheck fill:#e74c3c,color:#fff
    style Client fill:#f5a623,color:#fff
    style TCPClient fill:#f5a623,color:#fff
    style Monitor fill:#7ed321,color:#fff
    style AdminUser fill:#7ed321,color:#fff
    style Upstream fill:#999,color:#fff
