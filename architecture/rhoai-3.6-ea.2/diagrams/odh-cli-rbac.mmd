graph TD
    subgraph AuthSource["Authentication Source"]
        Kubeconfig["kubeconfig<br/>(user-provided)"]
    end

    subgraph AuthMethods["Credential Chain"]
        Bearer["Bearer Token<br/>(oc login)"]
        ClientCert["Client Certificate"]
        OIDC["OIDC Token"]
    end

    subgraph PreFlight["RBAC Pre-flight Checks"]
        SSAR["SelfSubjectAccessReview<br/>(pkg/util/kube/rbac/check.go)"]
    end

    subgraph CLICommands["CLI Commands & Required Permissions"]
        direction TB
        LintCmd["lint<br/>Read-only"]
        DiagnoseCmd["diagnose<br/>Read-only"]
        StatusCmd["status<br/>Read-only"]
        GetCmd["get<br/>Read-only"]
        BackupCmd["backup<br/>Read-only"]
        LogsCmd["logs<br/>Read-only"]
        EventsCmd["events<br/>Read-only"]
        MigrateCmd["migrate<br/>Read + Write"]
        DepsCmd["deps install<br/>Write"]
    end

    subgraph ReadOnlyResources["Read-Only Resources"]
        DSC["DataScienceCluster"]
        DSCI["DSCInitialization"]
        CRDs["CustomResourceDefinitions"]
        Deployments["Deployments"]
        Pods["Pods"]
        PodLogs["Pods/log"]
        K8sEvents["Events"]
        Subscriptions["OLM Subscriptions"]
        CSVs["ClusterServiceVersions"]
        Services["Services"]
        Routes["Routes"]
    end

    subgraph WriteResources["Write Resources"]
        Patches["Resource Patches<br/>(migrate actions)"]
        Creates["Resource Creates<br/>(deps install)"]
        Deletes["Resource Deletes<br/>(migrate cleanup)"]
    end

    Kubeconfig --> Bearer
    Kubeconfig --> ClientCert
    Kubeconfig --> OIDC

    Bearer --> SSAR
    ClientCert --> SSAR
    OIDC --> SSAR

    SSAR -->|"verifies access<br/>before privileged ops"| MigrateCmd
    SSAR -->|"verifies access"| DepsCmd

    LintCmd -->|"get, list, watch"| ReadOnlyResources
    DiagnoseCmd -->|"get, list, watch"| ReadOnlyResources
    StatusCmd -->|"get, list"| ReadOnlyResources
    GetCmd -->|"get, list"| ReadOnlyResources
    BackupCmd -->|"get, list"| ReadOnlyResources
    LogsCmd -->|"get"| PodLogs
    EventsCmd -->|"list, watch"| K8sEvents

    MigrateCmd -->|"patch, update, delete"| WriteResources
    DepsCmd -->|"create"| WriteResources

    style Kubeconfig fill:#4a90e2,stroke:#333,color:#fff
    style SSAR fill:#f5a623,stroke:#333
    style LintCmd fill:#d5e8d4,stroke:#82b366
    style DiagnoseCmd fill:#d5e8d4,stroke:#82b366
    style StatusCmd fill:#d5e8d4,stroke:#82b366
    style GetCmd fill:#d5e8d4,stroke:#82b366
