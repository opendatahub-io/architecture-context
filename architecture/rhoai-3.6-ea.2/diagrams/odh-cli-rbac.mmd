    style LogsCmd fill:#d5e8d4,stroke:#82b366
    style EventsCmd fill:#d5e8d4,stroke:#82b366
    style MigrateCmd fill:#f8cecc,stroke:#b85450
    style DepsCmd fill:#f8cecc,stroke:#b85450
    style Bearer fill:#e8e8e8,stroke:#333
    style ClientCert fill:#e8e8e8,stroke:#333
    style OIDC fill:#e8e8e8,stroke:#333
