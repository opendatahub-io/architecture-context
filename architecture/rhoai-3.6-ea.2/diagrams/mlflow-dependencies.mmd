graph LR
    MLflow["MLflow Server<br/>(v3.15.2)"]

    %% Runtime Dependencies (Required)
    MLflow -->|"metadata store<br/>5432/TCP"| PostgreSQL["PostgreSQL<br/>(psycopg2 + SQLAlchemy)"]
    MLflow -->|"token validation<br/>workspace store<br/>443/TCP"| K8sAPI["Kubernetes API"]
    MLflow -->|"auth middleware<br/>entry point"| K8sPlugins["mlflow-kubernetes-plugins<br/>v1.6.0"]

    %% Artifact Storage (one of)
    MLflow -->|"artifact storage<br/>443/TCP"| S3["S3-compatible Storage<br/>(boto3)"]
    MLflow -->|"artifact storage<br/>443/TCP"| GCS["Google Cloud Storage<br/>(google-cloud-storage)"]
    MLflow -->|"artifact storage<br/>443/TCP"| Azure["Azure Blob Storage<br/>(azure-storage-blob)"]

    %% Framework Dependencies
    MLflow -->|"ASGI framework"| FastAPI["FastAPI + Starlette"]
    MLflow -->|"WSGI framework"| Flask["Flask"]
    MLflow -->|"production server"| Gunicorn["gunicorn + uvicorn"]
    MLflow -->|"DB migrations"| Alembic["alembic"]
    MLflow -->|"serialization"| Protobuf["protobuf"]

    %% Observability
    MLflow -->|"tracing"| OTel["OpenTelemetry SDK"]
    MLflow -.->|"metrics export"| PromExporter["prometheus-flask-exporter"]

    %% AI Gateway Dependencies (optional)
    MLflow -.->|"LLM proxy<br/>(when enabled)"| OpenAI["OpenAI API"]
    MLflow -.->|"LLM proxy<br/>(when enabled)"| Bedrock["AWS Bedrock"]

    %% Optional Integrations
    MLflow -.->|"MCP server"| FastMCP["fastmcp"]
    MLflow -.->|"LLM chain integration"| LangChain["LangChain"]

    %% Internal RHOAI integrations
    RHOAIDashboard["RHOAI Dashboard"] -->|"embedded UI<br/>module federation"| MLflow

