graph TB
    subgraph ModuleLayer["Module Controller Layer"]
        ModuleCtrl["spark-operator-module controller<br/>(Go Controller)<br/>Port: 8081/TCP health"]
    end

    subgraph WorkloadLayer["Workload Operator Layer"]
        Controller["spark-operator controller<br/>(Go Controller)<br/>Ports: 8080/TCP metrics, 8081/TCP health"]
        Webhook["spark-operator webhook<br/>(Go Webhook Server)<br/>Port: 9443/TCP TLS"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        SparkOpCR["SparkOperator CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]
        SparkAppCR["SparkApplication CR<br/>(Namespaced)<br/>sparkoperator.k8s.io/v1beta2"]
        SchedCR["ScheduledSparkApplication CR<br/>(Namespaced)<br/>sparkoperator.k8s.io/v1beta2"]
        SparkConnCR["SparkConnect CR<br/>(Namespaced)<br/>sparkoperator.k8s.io/v1alpha1"]
    end

    subgraph SparkWorkloads["Spark Workloads"]
        Driver["Spark Driver Pod"]
        Executor["Spark Executor Pods"]
        ConnectServer["SparkConnect gRPC Server<br/>Port: 15002/TCP"]
    end

    %% Module controller manages workload operator
    ODHOperator["ODH / RHOAI Operator"] -->|creates| SparkOpCR
    SparkOpCR -->|watched by| ModuleCtrl
    ModuleCtrl -->|deploys & manages| Controller
    ModuleCtrl -->|deploys & manages| Webhook
    ModuleCtrl -->|manages| CertMgr["cert-manager<br/>Certificates & Issuers"]
    ModuleCtrl -->|manages| PodMon["PodMonitor<br/>Prometheus scraping"]

    %% User interaction
    User["User / CI"] -->|creates| SparkAppCR
    User -->|creates| SchedCR
    User -->|creates| SparkConnCR

    %% Webhook validates/mutates
    SparkAppCR -->|admission| Webhook
    SchedCR -->|admission| Webhook
    SparkConnCR -->|admission| Webhook

    %% Controller watches CRs
    SparkAppCR -->|watched by| Controller
    SchedCR -->|watched by| Controller
    SparkConnCR -->|watched by| Controller

    %% Controller creates workloads
    Controller -->|creates| Driver
    Controller -->|creates| Executor
    Controller -->|creates| ConnectServer
    Driver -->|manages| Executor

    %% Webhook mutates pods
    Webhook -->|injects config into| Driver
    Webhook -->|injects config into| Executor

    %% Scheduling integrations
    Controller -.->|optional| Volcano["Volcano Scheduler"]
    Controller -.->|optional| SchedPlugins["K8s Scheduler Plugins"]

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style ModuleCtrl fill:#6c5ce7,color:#fff
    style SparkAppCR fill:#f5a623
    style SchedCR fill:#f5a623
    style SparkConnCR fill:#f5a623
    style SparkOpCR fill:#f5a623
    style Driver fill:#7ed321
    style Executor fill:#7ed321
    style ConnectServer fill:#7ed321
    style ODHOperator fill:#e8e8e8
    style CertMgr fill:#e8e8e8
    style PodMon fill:#e8e8e8
    style Volcano fill:#e8e8e8
    style SchedPlugins fill:#e8e8e8
