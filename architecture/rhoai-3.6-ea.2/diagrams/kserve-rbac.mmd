graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CtrlMgr["kserve-controller-manager"]
        SA_LLMISVC["llmisvc service account"]
        SA_LocalModel["kserve-localmodel-controller-manager"]
        SA_LocalNode["kserve-localmodelnode-agent"]
        SA_Module["kserve-module-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Mgr["kserve-manager-rolebinding"]
        CRB_Proxy["kserve-proxy-rolebinding"]
        CRB_LLM["llmisvc-manager-rolebinding"]
        CRB_LM["kserve-localmodel-manager-rolebinding"]
        CRB_LNA["kserve-localmodelnode-agent-rolebinding"]
        CRB_Mod["kserve-module-manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLM["kserve-llmisvc-manager-role"]
        CR_LM["kserve-localmodel-manager-role"]
        CR_LNA["kserve-localmodelnode-agent-role"]
        CR_Mod["kserve-module-manager-role"]
    end

    subgraph ManagerResources["kserve-manager-role Resources"]
        R_IS["serving.kserve.io<br/>InferenceService<br/>+ finalizers + status"]
        R_IG["serving.kserve.io<br/>InferenceGraph<br/>+ finalizers + status"]
        R_SR["serving.kserve.io<br/>ServingRuntime<br/>ClusterServingRuntime"]
        R_TM["serving.kserve.io<br/>TrainedModel<br/>+ status"]
        R_LMC["serving.kserve.io<br/>LocalModelCache"]
        R_Deploy["apps<br/>Deployments"]
        R_KnSvc["serving.knative.dev<br/>Services"]
        R_VS["networking.istio.io<br/>VirtualServices"]
        R_HR["gateway.networking.k8s.io<br/>HTTPRoutes"]
        R_Route["route.openshift.io<br/>Routes"]
    end

    subgraph LLMResources["kserve-llmisvc-manager-role Resources"]
        R_LLMIS["serving.kserve.io<br/>LLMInferenceService<br/>+ finalizers + status"]
        R_LLMISC["serving.kserve.io<br/>LLMInferenceServiceConfig<br/>+ finalizers + status"]
        R_GW["gateway.networking.k8s.io<br/>GatewayClasses, Gateways<br/>HTTPRoutes"]
        R_InfExt["inference.networking.k8s.io<br/>InferenceModels<br/>InferencePools"]
        R_LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSets"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        R_LMCache["serving.kserve.io<br/>LocalModelCache<br/>LocalModelNamespaceCache<br/>LocalModelNode(Group)"]
        R_PV["core<br/>PersistentVolumes<br/>PersistentVolumeClaims"]
    end

    subgraph LocalNodeResources["kserve-localmodelnode-agent-role Resources"]
        R_LMN["serving.kserve.io<br/>LocalModelNodes<br/>+ finalizers + status"]
        R_Jobs["batch<br/>Jobs + status"]
    end

    subgraph ModuleResources["kserve-module-manager-role Resources"]
        R_Kserve["components.platform.opendatahub.io<br/>Kserves<br/>+ finalizers + status"]
        R_Webhook["admissionregistration.k8s.io<br/>MutatingWebhookConfigurations<br/>ValidatingWebhookConfigurations"]
        R_CRD["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        R_Cert["cert-manager.io<br/>Certificates, Issuers"]
        R_SCC["security.openshift.io<br/>SecurityContextConstraints"]
    end

    subgraph ProxyResources["kserve-proxy-role Resources"]
        R_TR["authentication.k8s.io<br/>TokenReviews"]
        R_SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    %% Service Account → Binding → Role → Resources
    SA_CtrlMgr -->|bound via| CRB_Mgr
    SA_CtrlMgr -->|bound via| CRB_Proxy
    SA_LLMISVC -->|bound via| CRB_LLM
    SA_LocalModel -->|bound via| CRB_LM
    SA_LocalNode -->|bound via| CRB_LNA
    SA_Module -->|bound via| CRB_Mod

    CRB_Mgr -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_LLM -->|grants| CR_LLM
    CRB_LM -->|grants| CR_LM
    CRB_LNA -->|grants| CR_LNA
    CRB_Mod -->|grants| CR_Mod

    CR_Manager -->|"CRUD + watch"| R_IS
    CR_Manager -->|"CRUD + watch"| R_IG
    CR_Manager -->|"CRUD + watch"| R_SR
    CR_Manager -->|"CRUD + watch"| R_TM
    CR_Manager -->|"CRUD + watch"| R_LMC
    CR_Manager -->|"CRUD + watch"| R_Deploy
    CR_Manager -->|"CRUD + watch"| R_KnSvc
    CR_Manager -->|"CRUD + watch"| R_VS
    CR_Manager -->|"CRUD + watch"| R_HR
    CR_Manager -->|"CRUD + watch"| R_Route

    CR_LLM -->|"CRUD + watch"| R_LLMIS
    CR_LLM -->|"CRUD + watch"| R_LLMISC
    CR_LLM -->|"CRUD + watch"| R_GW
    CR_LLM -->|"CRUD + watch"| R_InfExt
    CR_LLM -->|"CRUD + watch"| R_LWS

    CR_LM -->|"CRUD + watch"| R_LMCache
    CR_LM -->|"CRUD + watch"| R_PV

    CR_LNA -->|"CRUD + watch"| R_LMN
    CR_LNA -->|"CRUD + watch"| R_Jobs

    CR_Mod -->|"get, list, patch, update, watch"| R_Kserve
    CR_Mod -->|"CRUD + watch"| R_Webhook
    CR_Mod -->|"CRUD + watch"| R_CRD
    CR_Mod -->|"CRUD + watch"| R_Cert
    CR_Mod -->|"CRUD + watch"| R_SCC

    CR_Proxy -->|"create"| R_TR
    CR_Proxy -->|"create"| R_SAR

