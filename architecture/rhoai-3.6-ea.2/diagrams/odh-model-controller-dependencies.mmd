graph LR
    OMC["odh-model-controller<br/>(Controller Manager)"]
    MSA["model-serving-api<br/>(REST Server)"]

    %% Core Platform Dependencies
    OMC -->|"CRD Watch + CRUD"| KServeIS["KServe InferenceService"]
    OMC -->|"CRD Watch + CRUD"| KServeLLM["KServe LLMInferenceService"]
    OMC -->|"CRD Watch + CRUD"| KServeSR["KServe ServingRuntime"]
    OMC -->|"CRD Watch"| KServeIG["KServe InferenceGraph"]

    %% Gateway and Traffic
    OMC -->|"CRD CRUD + Watch"| GatewayAPI["Gateway API<br/>v1.5.1"]
    OMC -->|"CRD CRUD"| IstioEF["Istio EnvoyFilter<br/>v1.27.8"]
    OMC -->|"CRD CRUD"| OSRoute["OpenShift Route"]

    %% Auth and Scaling
    OMC -->|"CRD CRUD"| Kuadrant["Kuadrant AuthPolicy<br/>v1.4.2"]
    OMC -->|"CRD CRUD"| KEDA["KEDA TriggerAuth<br/>v2.20.2"]

    %% Monitoring
    OMC -->|"CRD CRUD"| PromOp["prometheus-operator<br/>ServiceMonitor / PodMonitor"]

    %% Platform Config
    OMC -->|"CRD Watch"| DSC["DataScienceCluster CR"]
    OMC -->|"CRD Watch"| DSCI["DSCInitialization CR"]
    OMC -->|"Resource Watch"| OSTLS["OpenShift APIServer<br/>TLS Profile"]
    OMC -->|"CRD Watch"| HWProf["HardwareProfile CR"]

    %% NIM
    OMC -->|"CRD CRUD"| NIM["NIM Account CR"]
    OMC -->|"CRD CRUD"| OSTemplate["OpenShift Template"]

    %% model-serving-api dependencies
    MSA -->|"list Gateways"| GatewayAPI
    MSA -->|"SSAR auth checks"| K8sAPI["Kubernetes API"]
    MSA -.->|"OTLP/gRPC traces"| OTEL["OpenTelemetry Collector"]

    %% Controller runtime
    OMC -->|"framework"| CtrlRT["controller-runtime<br/>v0.24.1"]
    OMC -->|"HTTPS/6443"| K8sAPI

    %% Build Dependencies
    OMC -.->|"build"| Go["Go 1.26.7<br/>FIPS: strictfipsruntime"]

    %% Styling
    style OMC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MSA fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff

    style KServeIS fill:#7ed321,stroke:#333
    style KServeLLM fill:#7ed321,stroke:#333
    style KServeSR fill:#7ed321,stroke:#333
    style KServeIG fill:#7ed321,stroke:#333
    style DSC fill:#7ed321,stroke:#333
    style DSCI fill:#7ed321,stroke:#333
    style HWProf fill:#7ed321,stroke:#333
    style NIM fill:#7ed321,stroke:#333

    style GatewayAPI fill:#999,stroke:#333
    style IstioEF fill:#999,stroke:#333
    style Kuadrant fill:#999,stroke:#333
    style KEDA fill:#999,stroke:#333
    style PromOp fill:#999,stroke:#333
    style CtrlRT fill:#999,stroke:#333

    style OSRoute fill:#cc0000,stroke:#333,color:#fff
    style OSTLS fill:#cc0000,stroke:#333,color:#fff
    style OSTemplate fill:#cc0000,stroke:#333,color:#fff

    style K8sAPI fill:#f5a623,stroke:#333
    style OTEL fill:#f5a623,stroke:#333
    style Go fill:#e8e8e8,stroke:#333
