graph TB
    subgraph EPP["Endpoint Picker (EPP)"]
        direction TB
        ExtProcServer["ExtProc gRPC Server<br/>9002/TCP"]
        HealthServer["Health Server<br/>9003/TCP"]
        EPPMetrics["Metrics<br/>9090/TCP"]
        ZMQSub["ZMQ Subscriber<br/>5557/TCP"]

        subgraph Controllers["Controllers"]
            IOCtrl["InferenceObjective<br/>Controller"]
            IMRCtrl["InferenceModelRewrite<br/>Controller"]
            IPCtrl["InferencePool<br/>Controller"]
            PodCtrl["Pod Controller"]
        end

        subgraph Scheduling["Plugin Scheduling Framework"]
            Filters["Filters"]
            Scorers["Scorers"]
            DataStore["In-Memory DataStore"]
        end

        Controllers --> DataStore
        ZMQSub -->|KV-cache events| DataStore
        ExtProcServer -->|queries| Scheduling
        Filters --> DataStore
        Scorers --> DataStore
    end

    subgraph Coordinator["Coordinator"]
        direction TB
        CoordHTTP["HTTP Server<br/>8080/TCP"]
        CoordMetrics["Coord Metrics<br/>9090/TCP"]

        subgraph Pipeline["Pipeline Steps"]
            ReplaceMedia["replace-media-urls"]
            Render["render"]
            Encode["encode"]
            Prefill["prefill"]
            Decode["decode"]
            AsyncBroker["async-broker"]
        end

        CoordHTTP --> ReplaceMedia
        ReplaceMedia --> Render
        Render --> Encode
        Encode --> Prefill
        Prefill --> Decode
        Decode --> AsyncBroker
    end

    subgraph Sidecar["Disaggregation Sidecar"]
        direction TB
        SidecarProxy["HTTP Proxy<br/>8000/TCP"]
        KVTransfer["KV-Transfer<br/>NIXL / Shared Storage / SGLang"]
        ECTransfer["EC-Transfer<br/>NIXL / Shared Storage"]
        LRUCache["LRU Proxy Cache"]

        SidecarProxy --> KVTransfer
        SidecarProxy --> ECTransfer
        SidecarProxy --> LRUCache
    end

    %% CRDs
    InfObj["InferenceObjective CR"]
    InfMR["InferenceModelRewrite CR"]
    InfPool["InferencePool CR"]
    EPConfig["EndpointPickerConfig CR"]

    InfObj -->|watched by| IOCtrl
    InfMR -->|watched by| IMRCtrl
    InfPool -->|watched by| IPCtrl
    EPConfig -->|configures| Scheduling

    %% External integrations
    Envoy["Envoy Proxy"] -->|ext-proc callout| ExtProcServer
    ExtProcServer -->|routing decision| Envoy

    Coordinator -->|route via| InfGW["Inference Gateway<br/>80/TCP"]
    InfGW -->|forward| Sidecar

    AsyncBroker -->|enqueue/dequeue| Redis["Redis<br/>6379/TCP"]

    Controllers -->|watch| K8sAPI["Kubernetes API<br/>6443/TCP"]
    SidecarProxy -->|discovery| K8sAPI

    SidecarProxy -->|forward| ModelServer["Model Server<br/>8200/TCP"]
    SidecarProxy -->|coordinate| PrefillWorkers["Prefill Workers"]
    SidecarProxy -->|coordinate| EncoderWorkers["Encoder Workers"]

    EPP -->|traces| OTel["OpenTelemetry Collector"]
    Coordinator -->|traces| OTel
    Sidecar -->|traces| OTel

    Prometheus["Prometheus"] -->|scrape| EPPMetrics
    Prometheus -->|scrape| CoordMetrics

    Render -->|tokenize| RenderSvc["Rendering Service<br/>8080/TCP"]

    %% Styling
    style ExtProcServer fill:#4a90e2,color:#fff
    style CoordHTTP fill:#4a90e2,color:#fff
    style SidecarProxy fill:#4a90e2,color:#fff
    style InfObj fill:#f5a623
    style InfMR fill:#f5a623
    style InfPool fill:#f5a623
    style EPConfig fill:#f5a623
    style Envoy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style InfGW fill:#7ed321
    style ModelServer fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style RenderSvc fill:#e8e8e8,stroke:#333
    style PrefillWorkers fill:#e8e8e8,stroke:#333
    style EncoderWorkers fill:#e8e8e8,stroke:#333
