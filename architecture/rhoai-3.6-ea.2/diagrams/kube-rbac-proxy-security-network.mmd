graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Prometheus / Client<br/>Bearer Token or Client TLS Cert"]
    end

    subgraph Sidecar["SIDECAR PROXY (kube-rbac-proxy)"]
        direction TB
        TLS["TLS Termination<br/>8443/TCP<br/>TLS 1.2+ configurable<br/>CertReloader hot-reload"]

        subgraph AuthN["Authentication"]
            TokenReview["TokenReview<br/>(Bearer → K8s API)"]
            OIDCAuth["OIDC JWT Validation<br/>(local, go-oidc)"]
            ClientCert["Client TLS Certificate<br/>(x509 validation)"]
        end

        subgraph AuthZ["Authorization Chain"]
            Hardcoded["Hardcoded Authorizer<br/>prometheus-k8s SA<br/>→ GET /metrics ALWAYS"]
            Static["Static Authorizer<br/>Format1: global rewrites<br/>Format2: path-scoped rules"]
            SAR["SubjectAccessReview<br/>(→ K8s API)"]
        end

        Proxy["Upstream Proxy<br/>Forwards to localhost"]
        Audit["Audit Logger<br/>OCSF 1.9.0<br/>Bounded queue"]

        TLS --> AuthN
        AuthN --> AuthZ
        AuthZ --> Proxy
        AuthZ -.-> Audit
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph Localhost["LOCALHOST (Trusted - same Pod)"]
        Upstream["Upstream Service<br/>configurable/TCP HTTP<br/>Receives x-remote-user<br/>x-remote-groups headers"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES (Optional)"]
        OIDCProvider["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Custom CA supported"]
    end

    %% Flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token / Client Cert"| TLS
    TokenReview -->|"HTTPS/6443<br/>SA Token<br/>TokenReview API"| K8sAPI
    SAR -->|"HTTPS/6443<br/>SA Token<br/>SubjectAccessReview API"| K8sAPI
    Proxy -->|"HTTP localhost<br/>No encryption<br/>No auth"| Upstream
    OIDCAuth -.->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC discovery"| OIDCProvider

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sidecar fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef localhost fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef danger fill:#f8d7da,stroke:#d0021b,stroke-width:2px

    class Client external
    class TLS,TokenReview,OIDCAuth,ClientCert,Static,SAR,Proxy,Audit sidecar
    class Hardcoded danger
    class K8sAPI controlplane
    class Upstream localhost
    class OIDCProvider externalsvc
