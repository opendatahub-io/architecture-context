graph TB
    subgraph External["Cluster Admin"]
        Admin["Cluster Admin<br/>(oc adm must-gather)"]
    end

    subgraph MustGather["must-gather Container"]
        direction TB
        Gather["gather.sh<br/>(Entrypoint / Orchestrator)"]
        Common["common.sh<br/>(Shared Library)"]
        XKSUtil["xks_util.sh<br/>(xKS Platform Support)"]

        Gather -->|sources| Common
        Gather -->|sources on xKS| XKSUtil

        subgraph Collectors["Component Collectors (parallel)"]
            direction LR
            Serving["gather_serving.sh<br/>(KServe)"]
            DSP["gather_data_science_pipelines.sh<br/>(DSP)"]
            Notebooks["gather_notebooks.sh<br/>(Workbenches)"]
            KubeRay["gather_kuberay.sh<br/>(KubeRay)"]
            Kueue["gather_kueue.sh<br/>(Kueue)"]
            KFTO["gather_kfto.sh<br/>(Training Operator)"]
            MR["gather_mr.sh<br/>(Model Registry)"]
            TrustyAI["gather_trustyai.sh<br/>(TrustyAI)"]
            Dashboard["gather_dashboard.sh<br/>(Dashboard)"]
            Feast["gather_feastoperator.sh<br/>(Feast)"]
            MLflow["gather_mlflow.sh<br/>(MLflow)"]
            Spark["gather_sparkoperator.sh<br/>(Spark)"]
            AIGateway["gather_aigateway.sh<br/>(AI Gateway)"]
            MCP["gather_mcp_lifecycle_operator.sh<br/>(MCP)"]
            OGX["gather_ogx.sh<br/>(OGX)"]
        end

        subgraph LLMDCollectors["LLM-D Collection (xKS path)"]
            direction LR
            LLMD["gather_llmd.sh<br/>(LLM-D)"]
            CertMgr["cert-manager.sh"]
            Sail["sail.sh<br/>(Istio)"]
            LWS["lws.sh<br/>(LeaderWorkerSet)"]
            O11y["gather_o11y.sh<br/>(Observability)"]
            Cluster["gather_cluster.sh<br/>(Cluster Info)"]
            LLMD -->|parallel deps| CertMgr
            LLMD -->|parallel deps| Sail
            LLMD -->|parallel deps| LWS
        end

        subgraph Optional["Optional Collectors"]
            WVA["gather_wva.sh<br/>(WVA / KEDA)"]
            BatchGW["gather_batch_gateway.sh<br/>(Batch Gateway)"]
        end

        Gather -->|"OpenShift: dispatches all"| Collectors
        Gather -->|"xKS: dispatches"| LLMDCollectors
        Gather -->|"ENABLE_WVA=true"| WVA
        Gather -->|"ENABLE_BATCH_GATEWAY=true"| BatchGW
    end

    Admin -->|invokes| Gather

    subgraph Target["Kubernetes API Server"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS DEFAULT:PQ"]
    end

    subgraph Output["Output"]
        Bundle["must-gather bundle<br/>(/must-gather/)"]
    end

    Collectors -->|"oc adm inspect<br/>(read-only)"| K8sAPI
    LLMDCollectors -->|"kubectl inspect<br/>(read-only)"| K8sAPI
    Optional -->|"oc/kubectl<br/>(read-only)"| K8sAPI
    Gather -->|writes| Bundle

    style Gather fill:#4a90e2,color:#fff
    style Common fill:#4a90e2,color:#fff
    style XKSUtil fill:#4a90e2,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Admin fill:#f5a623,color:#fff
    style Bundle fill:#7ed321,color:#fff
    style LLMD fill:#6c5ce7,color:#fff
