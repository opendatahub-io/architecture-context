graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        SDK["Python SDK Client"]
        Browser["Web Browser User"]
    end

    subgraph AppServices["APPLICATION SERVICES (Cluster-Internal)"]
        direction TB

        subgraph NS_Kubeflow["Namespace: kubeflow"]
            APIServer["API Server<br/>SA: ml-pipeline<br/>8888/TCP HTTP, 8887/TCP gRPC, 8443/TCP Webhooks<br/>FIPS: GOFIPS140 + CGO_ENABLED=1"]
            UI["ML Pipeline UI<br/>SA: ml-pipeline-ui<br/>80/TCP → 3000"]
            PA["Persistence Agent<br/>SA: ml-pipeline-persistenceagent"]
            SWC["Scheduled Workflow Controller<br/>SA: ml-pipeline-scheduledworkflow<br/>9090/TCP metrics"]
            CacheSrv["Cache Server<br/>SA: kubeflow-pipelines-cache<br/>443/TCP → 8443 webhook"]
            ViewerCtrl["Viewer Controller<br/>SA: ml-pipeline-viewer-crd-service-account"]
        end
    end

    subgraph MetaSvc["METADATA SERVICES"]
        direction TB
        subgraph NS_Meta["Namespace: kubeflow"]
            MLMD["ML Metadata gRPC<br/>8080/TCP gRPC<br/>No encryption"]
            Envoy["Metadata Envoy Proxy<br/>9090/TCP gRPC proxied"]
            MetaWriter["Metadata Writer<br/>SA: kubeflow-pipelines-metadata-writer<br/>Python"]
        end
    end

    subgraph V2Engine["V2 ENGINE (In-Pod)"]
        DriverSidecar["Driver Sidecar<br/>CGO_ENABLED=0, static<br/>FIPS: GOFIPS140"]
        LauncherInit["Launcher v2 Init<br/>CGO_ENABLED=0, static<br/>FIPS: GOFIPS140"]
    end

    subgraph DataStores["DATA STORES"]
        MySQL["MySQL 8.4<br/>3306/TCP<br/>Istio AuthorizationPolicy<br/>7 allowed SAs"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>AWS credentials"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        Argo["Argo Workflows v3.7.14<br/>Workflow CRD Engine"]
    end

    %% External flows
    SDK -->|"HTTP 8888 or gRPC 8887<br/>Configurable TLS<br/>TokenReview + SAR"| APIServer
    Browser -->|"HTTP 80<br/>No encryption<br/>No auth"| UI

    %% API Server connections
    UI -->|"HTTP 8888<br/>REST API"| APIServer
    APIServer -->|"MySQL 3306<br/>No encryption<br/>Secret auth<br/>Istio AuthZ"| MySQL
    APIServer -->|"HTTP/HTTPS<br/>Configurable<br/>AWS credentials"| S3
    APIServer -->|"HTTPS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Controller connections
    PA -->|"HTTPS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    PA -->|"HTTP 8888<br/>Configurable TLS<br/>Projected SA token"| APIServer
    SWC -->|"HTTPS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Cache
    CacheSrv -->|"MySQL 3306<br/>Secret auth<br/>Istio AuthZ"| MySQL

    %% V2 Engine
    DriverSidecar -->|"HTTPS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    LauncherInit -->|"HTTP/HTTPS<br/>AWS credentials"| S3
    LauncherInit -->|"gRPC 8080<br/>No encryption<br/>No auth"| MLMD

    %% Metadata
    Envoy -->|"gRPC 8080<br/>Proxied"| MLMD
    MetaWriter -->|"gRPC 8080<br/>No encryption"| MLMD
    MetaWriter -->|"HTTPS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    MLMD -->|"MySQL 3306<br/>No encryption<br/>Secret auth"| MySQL

    %% Argo
    Argo -->|"Creates pods with<br/>driver + launcher"| V2Engine

    %% K8s admission
    K8sAPI -->|"HTTPS 443<br/>TLS<br/>Admission webhook"| CacheSrv
    K8sAPI -->|"HTTPS 8443<br/>TLS<br/>Admission webhook"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef metadata fill:#e1d5f0,stroke:#9673a6,stroke-width:2px
    classDef v2engine fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class SDK,Browser external
    class APIServer,UI,PA,SWC,CacheSrv,ViewerCtrl appservice
    class MLMD,Envoy,MetaWriter metadata
    class DriverSidecar,LauncherInit v2engine
    class MySQL datastore
    class S3,K8sAPI,Argo externalsvc
