graph TD
    subgraph SA["Service Account"]
        PayloadSA["payload-processor<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph CRB["ClusterRole Binding"]
        Binding["payload-processor-auth-reviewer-binding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph CR["ClusterRole"]
        Role["payload-processor-auth-reviewer"]
    end

    subgraph Resources["API Resources"]
        ConfigMaps["core (v1)<br/>ConfigMaps"]
    end

    subgraph Endpoints["Service Endpoints"]
        ExtProc["ExternalProcessor gRPC<br/>9004/TCP<br/>Auth: None"]
        Health["Health gRPC<br/>9005/TCP<br/>Auth: None"]
        Metrics["Metrics HTTP<br/>9090/TCP<br/>Auth: Optional<br/>(controller-runtime)"]
    end

    PayloadSA -->|"bound via"| Binding
    Binding -->|"grants"| Role
    Role -->|"get, list, watch"| ConfigMaps

    PayloadSA -->|"runs"| ExtProc
    PayloadSA -->|"runs"| Health
    PayloadSA -->|"runs"| Metrics

    style PayloadSA fill:#4a90e2,stroke:#333,color:#fff
    style Binding fill:#6bb5f0,stroke:#333
    style Role fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style ExtProc fill:#e8e8e8,stroke:#333
    style Health fill:#e8e8e8,stroke:#333
    style Metrics fill:#e8e8e8,stroke:#333
