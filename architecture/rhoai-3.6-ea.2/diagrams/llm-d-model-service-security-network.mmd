graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / GitOps"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC: modelservice-manager-role"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (modelservice-system)"]
        direction TB
        Controller["modelservice-controller-manager<br/>SA: modelservice-controller-manager<br/>runAsNonRoot, seccomp RuntimeDefault<br/>drop ALL capabilities"]

        subgraph Ports["Exposed Ports"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP plaintext<br/>/healthz, /readyz<br/>Auth: None"]
            MetricsPort["Metrics Endpoint<br/>8443/TCP HTTPS TLS<br/>/metrics<br/>Auth: TokenReview + SAR<br/>HTTP/2 disabled"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS TLS"]
    end

    subgraph ManagedResources["MANAGED CHILD RESOURCES (per-namespace)"]
        direction TB
        Prefill["Prefill Deployment<br/>per-ModelService SA"]
        Decode["Decode Deployment<br/>per-ModelService SA"]
        EPP["EPP Deployment + Service<br/>SA bound to EPP ClusterRole"]
        InfResources["InferencePool + InferenceModel<br/>Gateway API Inference Extension"]
        HTTPRouteRes["HTTPRoute<br/>Gateway API"]
        RBAC["ServiceAccounts +<br/>RoleBindings + ConfigMaps"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>NetworkPolicy: namespaces<br/>labeled metrics: enabled"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User kubeconfig"| K8sAPI
    K8sAPI -->|"Watch stream<br/>TLS 1.2+<br/>SA token"| Controller
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CRUD all child resources"| K8sAPI
    K8sAPI -->|"Provisions"| Prefill
    K8sAPI -->|"Provisions"| Decode
    K8sAPI -->|"Provisions"| EPP
    K8sAPI -->|"Provisions"| InfResources
    K8sAPI -->|"Provisions"| HTTPRouteRes
    K8sAPI -->|"Provisions"| RBAC
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview + SAR"| MetricsSvc
    MetricsSvc --> MetricsPort

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Controller,HealthProbe,MetricsPort,MetricsSvc controller
    class Prefill,Decode,EPP,InfResources,HTTPRouteRes,RBAC managed
    class Prometheus monitoring
