graph LR
    Router["llm-d-router<br/>(EPP + Coordinator + Sidecar)"]

    %% External Dependencies
    Router -->|"gRPC ext-proc<br/>9002/TCP"| Envoy["Envoy Proxy"]
    Router -->|"controller framework"| CR["controller-runtime<br/>v0.24.1"]
    Router -->|"Gateway API types"| GWAPI["gateway-api<br/>v1.6.2"]
    Router -->|"InferencePool API"| GWAIE["gateway-api-inference-extension<br/>v1.6.2"]
    Router -->|"ext-proc protocol"| GOCP["go-control-plane<br/>v1.37.0"]
    Router -->|"gRPC framework"| GRPC["google.golang.org/grpc<br/>v1.83.2"]
    Router -->|"tracing"| OTelLib["OpenTelemetry SDK<br/>v1.45.0"]
    Router -->|"metrics"| PromLib["prometheus/client_golang<br/>v1.23.2"]
    Router -->|"CEL expressions"| CEL["cel-go<br/>v0.29.2"]

    %% Internal Platform Dependencies
    Router -->|"InferencePool CRD<br/>watch + library"| GWAIE
    Router -->|"async enqueue/dequeue<br/>Go library"| LLMDAsync["llm-d-async<br/>v0.9.1"]

    %% Runtime Dependencies
    Router -->|"KV-cache events<br/>5557/TCP"| ZMQ["ZeroMQ<br/>zmq4 v0.17.0"]
    Router -->|"async broker<br/>6379/TCP"| Redis["Redis<br/>go-redis v9.22.0"]
    Router -->|"HTTP routing"| Chi["go-chi/chi<br/>v5.3.2"]
    Router -->|"config mgmt"| Viper["spf13/viper<br/>v1.21.0"]
    Router -->|"caching"| Ristretto["ristretto<br/>v2.4.2"]
    Router -->|"LRU cache"| LRU["golang-lru<br/>v2.0.7"]
    Router -->|"TTL cache"| TTLCache["ttlcache<br/>v3.4.1"]

    %% Integration Points (runtime services)
    Router -->|"watch CRDs & Pods<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    Router -->|"trace export<br/>OTLP/gRPC"| OTelCol["OpenTelemetry Collector"]
    Router -->|"route E/P/D requests<br/>80/TCP HTTP"| InfGW["Inference Gateway"]
    Router -->|"tokenize requests<br/>8080/TCP HTTP"| RenderSvc["Rendering Service"]
    Router -->|"forward decode<br/>8200/TCP HTTP"| ModelServer["Model Server"]

    %% Consumers
    Prometheus["Prometheus"] -->|"scrape metrics<br/>9090/TCP"| Router

