graph TD
    subgraph NoK8sRBAC["No Kubernetes RBAC"]
        Note["Praxis AI is a standalone service<br/>No CRDs, no Kubernetes operator roles"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms (per filter chain)"]
        direction TB
        Bearer["Bearer Token Injection<br/>(credential_inject filter)"]
        mTLS["mTLS Peer Identity Trust<br/>(peer_identity_trust filter)"]
        BasicAuth["Basic Auth<br/>(basic_auth filter)"]
        AzureAD["Azure AD Token<br/>(azure_ad filter)"]
        GCPADC["GCP Application Default Credentials<br/>(gcp_adc filter)"]
        AWSSigV4["AWS SigV4 Signing<br/>(aws_sigv4_sign filter)"]
    end

    subgraph HeaderSecurity["Header Security"]
        HeaderGuard["identity_header_guard<br/>Strips client-supplied internal headers<br/>(x-praxis-ai-* prefix)"]
    end

    subgraph TenantIsolation["Multi-Tenant Isolation"]
        StateOwner["state_owner filter<br/>Per-user tenant identity"]
        NamespaceScoping["Namespace-scoped rows<br/>in PostgreSQL"]
        ChainRouting["Per-chain backend routing<br/>Separate listeners per tenant"]
    end

    subgraph AdminAccess["Admin API Access Control"]
        AdminBind["Admin API bound to 127.0.0.1:9901<br/>Network-level isolation only"]
    end

    subgraph Secrets["Credential Management"]
        ProviderKeys["Provider API Keys<br/>(Opaque secret)<br/>Operator-managed"]
        TLSCerts["TLS Certificates<br/>(kubernetes.io/tls)<br/>cert-manager, hot-reload"]
        PGCreds["PostgreSQL Credentials<br/>(Opaque secret)<br/>Manual"]
    end

    %% Relationships
    Bearer --> StateOwner
    mTLS --> StateOwner
    HeaderGuard -->|"protects"| StateOwner
    StateOwner --> NamespaceScoping

    ProviderKeys -->|"injected by"| Bearer
    TLSCerts -->|"used by"| mTLS

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style Bearer fill:#4a90e2,color:#fff
    style mTLS fill:#4a90e2,color:#fff
    style BasicAuth fill:#4a90e2,color:#fff
    style AzureAD fill:#4a90e2,color:#fff
    style GCPADC fill:#4a90e2,color:#fff
    style AWSSigV4 fill:#4a90e2,color:#fff
    style HeaderGuard fill:#e74c3c,color:#fff
    style StateOwner fill:#9b59b6,color:#fff
    style NamespaceScoping fill:#9b59b6,color:#fff
    style ChainRouting fill:#9b59b6,color:#fff
    style AdminBind fill:#f5a623,color:#fff
    style ProviderKeys fill:#7ed321,color:#fff
    style TLSCerts fill:#7ed321,color:#fff
    style PGCreds fill:#7ed321,color:#fff
