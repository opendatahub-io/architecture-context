graph LR
    THub["Training Hub<br/>(Python Library + thub CLI)"]

    %% Required External Dependencies
    subgraph Required["Required Dependencies"]
        PyTorch["PyTorch >=2.6.0"]
        Transformers["transformers >=4.57.6"]
        Datasets["datasets >=4.0.0"]
        Accelerate["accelerate >=0.34.2"]
        PEFT["peft >=0.15"]
        Pydantic["pydantic >=2.7.0"]
        ILabTrain["instructlab-training >=0.16.2"]
        MiniTrainer["mini-trainer >=0.8.3"]
        fsspec["fsspec >=2025.0"]
        Rich["rich >=14.1.0"]
    end

    THub -->|"deep learning framework"| PyTorch
    THub -->|"model loading, tokenization"| Transformers
    THub -->|"dataset loading"| Datasets
    THub -->|"distributed training"| Accelerate
    THub -->|"LoRA adapters"| PEFT
    THub -->|"config validation"| Pydantic
    THub -->|"SFT backend"| ILabTrain
    THub -->|"OSFT backend"| MiniTrainer
    THub -->|"remote checkpoint storage"| fsspec
    THub -->|"terminal UI"| Rich

    %% Optional Dependencies
    subgraph Optional["Optional Dependencies"]
        Unsloth["unsloth >=2026.1.1<br/>[lora]"]
        ART["openpipe-art >=0.5.17<br/>[grpo]"]
        Verl["verl >=0.7<br/>[grpo-verl]"]
        GEPALib["gepa >=0.1.1<br/>[gepa]"]
        MLflow["mlflow >=3.5.0<br/>[gepa]"]
        LiteLLM["litellm >=1.71.1<br/>[grpo, gepa]"]
        SentTrans["sentence-transformers >=5.0<br/>[embedding]"]
        S3FS["s3fs >=2025.0<br/>[s3]"]
        FlashAttn["flash-attn >=2.8<br/>[cuda]"]
        BNB["bitsandbytes >=0.47.0<br/>[cuda]"]
        LigerKernel["liger-kernel >=0.5.10<br/>[cuda]"]
    end

    THub -.->|"LoRA backend"| Unsloth
    THub -.->|"single-GPU GRPO"| ART
    THub -.->|"multi-GPU GRPO"| Verl
    THub -.->|"prompt optimization"| GEPALib
    THub -.->|"experiment tracking"| MLflow
    THub -.->|"LLM API abstraction"| LiteLLM
    THub -.->|"embedding fine-tuning"| SentTrans
    THub -.->|"S3 checkpoint storage"| S3FS
    THub -.->|"Flash Attention"| FlashAttn
    THub -.->|"quantization (QLoRA)"| BNB
    THub -.->|"optimized CUDA kernels"| LigerKernel

    %% Internal Platform Dependencies
    subgraph Platform["RHOAI Platform (Runtime)"]
        Kubeflow["Kubeflow / Training Operator"]
        Volcano["Volcano Job Scheduler"]
    end

    Kubeflow -->|"manages training pods"| THub
    Verl -.->|"job scheduling"| Volcano

    %% External Services
    subgraph Services["External Services"]
        HFHub["HuggingFace Hub"]
        S3Service["S3-Compatible Storage"]
        WandBService["Weights & Biases"]
        OpenAIAPI["OpenAI-Compatible API"]
    end

    THub -->|"model/dataset downloads"| HFHub
    THub -.->|"checkpoint storage"| S3Service
    THub -.->|"experiment tracking"| WandBService
    THub -.->|"GEPA LLM calls"| OpenAIAPI

    %% Styling
    style THub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PyTorch fill:#ee4c2c,stroke:#333,color:#fff
    style Transformers fill:#ff9d00,stroke:#333,color:#fff
    style ILabTrain fill:#7ed321,stroke:#333,color:#fff
    style MiniTrainer fill:#7ed321,stroke:#333,color:#fff
    style Kubeflow fill:#326ce5,stroke:#333,color:#fff
    style Volcano fill:#326ce5,stroke:#333,color:#fff
    style Unsloth fill:#999,stroke:#333,color:#fff
    style ART fill:#999,stroke:#333,color:#fff
    style Verl fill:#999,stroke:#333,color:#fff
    style GEPALib fill:#999,stroke:#333,color:#fff
    style MLflow fill:#999,stroke:#333,color:#fff
    style LiteLLM fill:#999,stroke:#333,color:#fff
    style SentTrans fill:#999,stroke:#333,color:#fff
    style HFHub fill:#f5a623,stroke:#333,color:#fff
    style S3Service fill:#f5a623,stroke:#333,color:#fff
    style WandBService fill:#f5a623,stroke:#333,color:#fff
