graph TB
    subgraph ArgoWorkflows["Argo Workflows"]
        direction TB
        Controller["workflow-controller<br/>Go Controller<br/>9090/TCP metrics, 6060/TCP healthz"]
        ArgoExec["argoexec<br/>Go Sidecar Executable"]
        ArgoServer["argo-server<br/>Go API Server<br/>2746/TCP gRPC+HTTP<br/>(not deployed in RHOAI DSP)"]
        ArgoCLI["argo CLI<br/>Go Command-Line Client"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        WorkflowCR["Workflow<br/>(argoproj.io/v1alpha1)"]
        WorkflowTemplateCR["WorkflowTemplate<br/>(argoproj.io/v1alpha1)"]
        ClusterWFTemplateCR["ClusterWorkflowTemplate<br/>(argoproj.io/v1alpha1)"]
        CronWorkflowCR["CronWorkflow<br/>(argoproj.io/v1alpha1)"]
        WFEventBindingCR["WorkflowEventBinding<br/>(argoproj.io/v1alpha1)"]
        WFTaskSetCR["WorkflowTaskSet<br/>(argoproj.io/v1alpha1)"]
        WFTaskResultCR["WorkflowTaskResult<br/>(argoproj.io/v1alpha1)"]
        WFArtifactGCCR["WorkflowArtifactGCTask<br/>(argoproj.io/v1alpha1)"]
    end

    User["User / DSP Server"] -->|creates| WorkflowCR
    WorkflowCR -->|watched by| Controller
    CronWorkflowCR -->|scheduled by| Controller
    Controller -->|creates| WorkflowPod["Workflow Pod"]
    ArgoExec -->|injected into| WorkflowPod
    Controller -->|manages| WFTaskSetCR
    Controller -->|reads| WFTaskResultCR
    Controller -->|manages| WFArtifactGCCR

    ArgoServer -->|reads/writes| WorkflowCR
    ArgoServer -->|reads/writes| WorkflowTemplateCR
    ArgoServer -->|reads/writes| ClusterWFTemplateCR
    ArgoServer -->|reads/writes| CronWorkflowCR
    ArgoCLI -->|communicates| ArgoServer

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    ArgoExec -->|depends on| ArtifactStorage["Artifact Storage<br/>S3/GCS/Azure"]
    Controller -.->|optional| Archive["PostgreSQL/MySQL<br/>Workflow Archive"]

    DSPOperator["data-science-pipelines-operator"] -->|deploys| Controller
    DSPOperator -->|deploys| ArgoExec

    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px
    style ArgoExec fill:#4a90e2,stroke:#333,stroke-width:2px
    style ArgoServer fill:#999,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5
    style ArgoCLI fill:#999,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5
    style WorkflowCR fill:#f5a623,stroke:#333
    style WorkflowTemplateCR fill:#f5a623,stroke:#333
    style ClusterWFTemplateCR fill:#f5a623,stroke:#333
    style CronWorkflowCR fill:#f5a623,stroke:#333
    style WFEventBindingCR fill:#f5a623,stroke:#333
    style WFTaskSetCR fill:#f5a623,stroke:#333
    style WFTaskResultCR fill:#f5a623,stroke:#333
    style WFArtifactGCCR fill:#f5a623,stroke:#333
    style DSPOperator fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ArtifactStorage fill:#e8e8e8,stroke:#333
    style Archive fill:#e8e8e8,stroke:#333
