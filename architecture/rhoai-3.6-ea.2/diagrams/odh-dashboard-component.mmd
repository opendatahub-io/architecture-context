graph TB
    subgraph Operator["Dashboard Operator"]
        DashOp["dashboard-operator<br/>(Go controller-runtime)"]
        Webhook["Webhook Server<br/>9443/TCP"]
        WsCtrl["Workspace Controller"]
        WsKindCtrl["WorkspaceKind Controller"]
        DashOp --> Webhook
        DashOp --> WsCtrl
        DashOp --> WsKindCtrl
    end

    subgraph CoreBFF["Core BFF Distribution"]
        BFF["core-bff<br/>(Go BFF + React SPA Host)<br/>8080/TCP"]
        FE["Frontend Host App<br/>(React 18 / PatternFly v6)<br/>Module Federation Host"]
        BFF --> FE
    end

    subgraph LegacyBackend["Legacy Backend"]
        KRBP["kube-rbac-proxy<br/>8443/TCP"]
        NodeJS["Node.js Fastify<br/>8080/TCP"]
        KRBP --> NodeJS
    end

    subgraph Modules["Federated BFF Modules (8143/TCP each)"]
        GenAI["gen-ai BFF"]
        ModelReg["model-registry BFF"]
        MaaS["maas BFF"]
        EvalHub["eval-hub BFF"]
        MLflow["mlflow BFF"]
        AgentOps["agent-ops BFF"]
        AutoML["automl BFF"]
        AutoRAG["autorag BFF"]
        DataConnect["data-connect-hub BFF"]
        DataReg["data-registry BFF"]
        Notebooks["notebooks BFF"]
    end

    subgraph CRDs["Custom Resources"]
        DashCR["Dashboard CR<br/>(cluster-scoped)"]
        WsCR["Workspace CR<br/>(namespaced)"]
        WsKindCR["WorkspaceKind CR<br/>(cluster-scoped)"]
    end

    %% Operator watches CRDs
    DashCR -->|watched by| DashOp
    WsCR -->|watched by| WsCtrl
    WsKindCR -->|watched by| WsKindCtrl

    %% Operator manages deployments
    DashOp -->|deploys & manages| CoreBFF
    DashOp -->|deploys & manages| Modules
    DashOp -->|deploys & manages| LegacyBackend

    %% Core BFF proxies to modules
    BFF -->|"/_mf/:name/* proxy<br/>HTTPS/8143"| GenAI
    BFF -->|"/_mf/:name/* proxy<br/>HTTPS/8143"| ModelReg
    BFF -->|"/_mf/:name/* proxy<br/>HTTPS/8143"| MaaS
    BFF -->|"/_mf/:name/* proxy<br/>HTTPS/8143"| Notebooks

    %% External dependencies
    Browser["Browser"] -->|"HTTPS/443<br/>Bearer Token"| Gateway["data-science-gateway<br/>(Gateway API)"]
    Gateway -->|"HTTP/8080"| BFF
    Gateway -->|"HTTPS/8443"| KRBP

    %% Platform dependencies
    DashOp -->|"HTTPS/6443"| K8sAPI["Kubernetes API"]
    BFF -->|"HTTPS/6443<br/>Token Impersonation"| K8sAPI
    NodeJS -->|"HTTPS/6443<br/>Token Impersonation"| K8sAPI

    %% Parent operator
    RhodsOp["rhods-operator"] -->|creates| DashCR

    %% Styling
    style DashOp fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style WsCtrl fill:#4a90e2,color:#fff
    style WsKindCtrl fill:#4a90e2,color:#fff
    style BFF fill:#50c878,color:#fff
    style FE fill:#50c878,color:#fff
    style KRBP fill:#f5a623,color:#fff
    style NodeJS fill:#f5a623,color:#fff
    style GenAI fill:#9b59b6,color:#fff
    style ModelReg fill:#9b59b6,color:#fff
    style MaaS fill:#9b59b6,color:#fff
    style EvalHub fill:#9b59b6,color:#fff
    style MLflow fill:#9b59b6,color:#fff
    style AgentOps fill:#9b59b6,color:#fff
    style AutoML fill:#9b59b6,color:#fff
    style AutoRAG fill:#9b59b6,color:#fff
    style DataConnect fill:#9b59b6,color:#fff
    style DataReg fill:#9b59b6,color:#fff
    style Notebooks fill:#9b59b6,color:#fff
