graph TB
    subgraph GridOperator["Grid Operator (grid-operator)"]
        direction TB
        Controller["Kubernetes Controllers<br/>GridNetwork, GridSite,<br/>InferenceProvider, AgentToolProvider"]
        SwimRuntime["SWIM Runtime<br/>foca / AES-256-GCM"]
        OverlayRenderer["Overlay Renderer<br/>ConfigMap writer"]
        ScoringEngine["Scoring Engine<br/>noMetrics / queueDepth /<br/>kvCachePressure"]
        MetricsServer["Metrics & Health Server<br/>:9090/TCP"]

        Controller -->|provider state| ScoringEngine
        ScoringEngine -->|scored providers| OverlayRenderer
        SwimRuntime -->|peer state| Controller
    end

    subgraph Libraries["Supporting Crates"]
        direction TB
        CertsCrate["certs<br/>mTLS / SPIFFE / CA"]
        CRDTCrate["crdt<br/>LWW / OR-Set / G-Counter"]
        SwimCrate["swim<br/>SWIM + AES-256-GCM"]
        SignalsCrate["signals<br/>Cross-site metrics"]
        SignalsClient["signals-client<br/>mTLS scrape transport"]
    end

    subgraph Sidecars["Sidecar"]
        OverlaySync["overlay-sync<br/>ConfigMap watcher"]
    end

    subgraph Services["Optional Services"]
        EnrollmentSrv["enrollment<br/>Site registration + cert rotation"]
        FleetDash["fleet-dashboard<br/>Axum + React UI"]
    end

    %% CRDs
    GridNetworkCR["GridNetwork CR<br/>(Cluster-scoped)"]
    GridSiteCR["GridSite CR<br/>(Cluster-scoped)"]
    InferenceProviderCR["InferenceProvider CR<br/>(Cluster-scoped)"]
    AgentToolProviderCR["AgentToolProvider CR<br/>(Cluster-scoped)"]

    %% External
    PraxisGW["Praxis AI Gateway"]
    PeerOperator["Peer Site Operator"]
    K8sAPI["Kubernetes API"]
    PostgreSQL["PostgreSQL"]
    Prometheus["Prometheus"]

    %% CRD watches
    GridNetworkCR -->|watched by| Controller
    GridSiteCR -->|watched by| Controller
    InferenceProviderCR -->|watched by| Controller
    AgentToolProviderCR -->|watched by| Controller

    %% Library usage
    SwimRuntime --- SwimCrate
    SwimRuntime --- CRDTCrate
    Controller --- CertsCrate
    Controller --- SignalsCrate

    %% Overlay flow
    OverlayRenderer -->|writes| ConfigMap["Routing Overlay<br/>ConfigMap"]
    OverlaySync -->|watches| ConfigMap
    OverlaySync -->|writes to filesystem| PraxisGW

    %% Cross-site
    SwimRuntime -->|gossip 7946/UDP| PeerOperator
    SignalsClient -->|poll 9091/TCP| PeerOperator
    Controller -->|auto-creates| GridSiteCR

    %% Enrollment
    EnrollmentSrv -->|persists| PostgreSQL
    EnrollmentSrv -->|issues certs| CertsCrate

    %% Monitoring
    MetricsServer -->|scraped by| Prometheus

    %% Fleet dashboard
    FleetDash -->|queries| Prometheus

    %% Styles
    style Controller fill:#4a90e2,color:#fff
    style SwimRuntime fill:#4a90e2,color:#fff
    style OverlayRenderer fill:#4a90e2,color:#fff
    style ScoringEngine fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style CertsCrate fill:#6c8ebf,color:#fff
    style CRDTCrate fill:#6c8ebf,color:#fff
    style SwimCrate fill:#6c8ebf,color:#fff
    style SignalsCrate fill:#6c8ebf,color:#fff
    style SignalsClient fill:#6c8ebf,color:#fff
    style OverlaySync fill:#9673a6,color:#fff
    style EnrollmentSrv fill:#82b366,color:#fff
    style FleetDash fill:#82b366,color:#fff
    style GridNetworkCR fill:#f5a623,color:#fff
    style GridSiteCR fill:#f5a623,color:#fff
    style InferenceProviderCR fill:#f5a623,color:#fff
    style AgentToolProviderCR fill:#f5a623,color:#fff
    style PraxisGW fill:#e8e8e8,stroke:#333
    style PeerOperator fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#d5e8d4,stroke:#82b366
