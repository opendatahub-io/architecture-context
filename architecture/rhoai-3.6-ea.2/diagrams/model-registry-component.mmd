graph TB
    subgraph ModelRegistry["Model Registry (Kubeflow Hub)"]
        direction TB

        subgraph CoreService["Core Registry Service"]
            Server["model-registry<br/>(Go Service)<br/>:8080/TCP"]
            ServerHealth["Health Probes<br/>/readyz/isDirty<br/>/readyz/health"]
            Server --- ServerHealth
        end

        subgraph ControllerLayer["Controller Layer"]
            Controller["InferenceService Controller<br/>(controller-runtime)<br/>:8081/TCP health, :8443/TCP metrics"]
            LeaderElect["Leader Election<br/>(ConfigMaps + Leases)"]
            Controller --- LeaderElect
        end

        subgraph UILayer["UI Layer"]
            BFF["BFF Proxy<br/>(Go Service)<br/>:4000/TCP"]
            ReactUI["React Frontend<br/>(static assets)"]
            BFF -->|serves| ReactUI
        end

        subgraph CatalogLayer["Catalog Service"]
            Catalog["Federated Catalog<br/>(Go Service)<br/>Plugin-based discovery"]
            MCPSupport["MCP Server Support"]
            Catalog --- MCPSupport
        end

        subgraph JobLayer["Batch Jobs"]
            AsyncUpload["async-upload Job<br/>(Python)<br/>sigstore signing"]
        end

        subgraph StorageInit["Storage Initializer"]
            CSI["mr-storage-initializer<br/>(Go CLI)<br/>KServe CSI compatible"]
        end
    end

    %% External actors
    User["Data Scientist / Client"] -->|REST API| Server
    User -->|UI| BFF
    Dashboard["ODH Dashboard"] -->|proxy| BFF

    %% Internal flows
    BFF -->|proxy API calls| Server
    BFF -->|creates| AsyncUpload
    Controller -->|reads metadata| Server
    CSI -->|downloads artifacts| Server

    %% CRDs
    InferenceServiceCR["InferenceService CR<br/>(KServe)"]
    Controller -->|watches + patches| InferenceServiceCR
    CSI -->|init container in| InferenceServiceCR

    %% External dependencies
    subgraph ExternalDeps["External Dependencies"]
        DB[("PostgreSQL / MySQL")]
        Istio["Istio Service Mesh"]
        K8sAPI["Kubernetes API<br/>:6443/TCP"]
        S3["S3-compatible Storage"]
        HFHub["HuggingFace Hub"]
        OCIReg["OCI Registry"]
    end

    Server -->|GORM| DB
    Controller -->|watch, patch| K8sAPI
    BFF -->|SubjectAccessReview| K8sAPI
    AsyncUpload -->|upload/download| S3
    AsyncUpload -->|download| HFHub
    AsyncUpload -->|push/pull| OCIReg
    Server -.->|mTLS| Istio

    %% Styling
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style BFF fill:#4a90e2,stroke:#333,color:#fff
    style Catalog fill:#4a90e2,stroke:#333,color:#fff
    style AsyncUpload fill:#9b59b6,stroke:#333,color:#fff
    style CSI fill:#4a90e2,stroke:#333,color:#fff
    style InferenceServiceCR fill:#f5a623,stroke:#333
    style DB fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style OCIReg fill:#e8e8e8,stroke:#333
    style User fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
