    style VLLMPrefill fill:#50c878,color:#fff
    style RoutingProxy fill:#9b59b6,color:#fff
    style Redis fill:#e74c3c,color:#fff
    style Gateway fill:#f5a623,color:#fff
    style ModelServiceCR fill:#f5a623
    style InferencePool fill:#f5a623
    style InferenceModel fill:#f5a623
