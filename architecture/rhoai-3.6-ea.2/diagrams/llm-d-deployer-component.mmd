graph TB
    subgraph HelmChart["llm-d Helm Chart (v1.0.23)"]
        direction TB
        Controller["ModelService Controller<br/>(Go, ghcr.io/llm-d/llm-d-model-service:v0.0.15)"]
        EPP["Endpoint Picker (EPP)<br/>(Go gRPC, ghcr.io/llm-d/llm-d-inference-scheduler:v0.1.0)"]
        Presets["ConfigMap Presets<br/>(Deployment Templates)"]
    end

    subgraph InferencePods["Inference Pods (per ModelService)"]
        direction TB
        subgraph DecodePod["Decode Pod"]
            RoutingProxy["Routing Proxy Sidecar<br/>(:8000 → :8001)"]
            VLLMDecode["vLLM Decode<br/>(:8001)"]
            RoutingProxy -->|proxy| VLLMDecode
        end
        subgraph PrefillPod["Prefill Pod"]
            VLLMPrefill["vLLM Prefill<br/>(:8000)"]
        end
    end

    Redis["Redis<br/>(Bitnami subchart)<br/>:8100/TCP"]
    InferenceSim["Inference Simulator<br/>(testing only)"]
    Quickstart["Quickstart Installer<br/>(Bash)"]

    User["User / Client"] -->|kubectl apply| ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
    ModelServiceCR -->|watched by| Controller
    Controller -->|reads| Presets
    Controller -->|creates| DecodePod
    Controller -->|creates| PrefillPod
    Controller -->|creates| InferencePool["InferencePool CR"]
    Controller -->|creates| InferenceModel["InferenceModel CR"]

    Gateway["Gateway<br/>(Istio/kGateway/GKE L7)<br/>:80/TCP"] -->|ext_proc :9002| EPP
    EPP -->|KV-cache lookup :8100| Redis
    Gateway -->|route| RoutingProxy

    VLLMDecode <-->|NixL KV transfer :5557| VLLMPrefill

    Quickstart -.->|wraps install| HelmChart

    subgraph ExternalDeps["External Dependencies"]
        K8s["Kubernetes >= 1.30"]
        GatewayAPI["Gateway API CRDs v1"]
        GPU["NVIDIA GPU"]
        HF["Hugging Face Hub"]
        Prometheus["Prometheus Operator"]
    end

    Controller -->|API calls| K8s
    Gateway -->|implements| GatewayAPI
    VLLMDecode -->|requires| GPU
    VLLMPrefill -->|requires| GPU
    VLLMPrefill -->|model download :443| HF

