graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Browser / API Client"]
    end

    subgraph Ingress["INGRESS (Edge TLS Termination)"]
        Route["OpenShift Route<br/>443/TCP HTTPS<br/>TLS Edge Termination<br/>Host: *.apps.cluster"]
    end

    subgraph Application["APPLICATION (kube-auth-proxy)"]
        direction TB

        subgraph ProxyPod["kube-auth-proxy Pod"]
            direction TB
            KAP["kube-auth-proxy<br/>4180/TCP HTTP<br/>FIPS: strictfipsruntime<br/>Image: ubi9/ubi-minimal-pqc"]

            subgraph AuthChain["Authentication Chain"]
                direction LR
                K8sAuth["1. K8s TokenReview"]
                BearerAuth["2. Bearer Token<br/>(JWT/OAuth)"]
                BasicAuthN["3. htpasswd<br/>Basic Auth"]
                SessionAuth["4. Cookie Session"]
            end

            ExtAuthzEP["/oauth2/auth<br/>ext_authz endpoint<br/>Returns: 200/401/403"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+ (cluster CA)<br/>Auth: ServiceAccount Token"]
        OSAUTH["OpenShift OAuth Server<br/>443/TCP HTTPS<br/>TLS 1.2+ (custom/cluster CA)<br/>Auth: Client Credentials"]
    end

    subgraph ExternalServices["EXTERNAL IDENTITY SERVICES"]
        OIDCIdP["OIDC Identity Provider<br/>443/TCP HTTPS<br/>TLS 1.2+ (system/custom CA)<br/>Auth: Client Credentials<br/>PKCE Support"]
    end

    subgraph SessionBackend["SESSION STORAGE (Optional)"]
        Redis["Redis / Valkey<br/>Configurable Port TCP<br/>Optional TLS<br/>Auth: Password (optional)<br/>Distributed Locking"]
    end

    subgraph UpstreamZone["UPSTREAM (Protected)"]
        Upstream["Upstream Application(s)<br/>Configurable Port<br/>HTTP/HTTPS<br/>Receives: X-Forwarded-User,<br/>X-Forwarded-Email,<br/>X-Forwarded-Groups"]
    end

    subgraph EnvoyZone["ENVOY INTEGRATION"]
        Envoy["Envoy Proxy<br/>(ext_authz client)"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS Edge"| Route

    %% Ingress to Application
    Route -->|"HTTP/4180<br/>No TLS by default"| KAP

    %% Auth chain flow
    KAP --> AuthChain
    KAP --> ExtAuthzEP

    %% Application to Platform Services
    KAP -->|"HTTPS/6443<br/>TLS 1.2+ (cluster CA)<br/>SA Token Auth<br/>TokenReview API"| K8sAPI
    KAP -->|"HTTPS/443<br/>TLS 1.2+<br/>Client Credentials<br/>OAuth2 Flow"| OSAUTH

    %% Application to External Identity
    KAP -->|"HTTPS/443<br/>TLS 1.2+<br/>Client Credentials<br/>OIDC Flow + PKCE"| OIDCIdP

    %% Application to Session Backend
    KAP -->|"TCP (configurable)<br/>Optional TLS<br/>Password Auth"| Redis

    %% Application to Upstream
    KAP -->|"HTTP(S) configurable<br/>Forwarded Identity Headers"| Upstream

    %% Envoy integration
    Envoy -->|"HTTP/4180<br/>/oauth2/auth<br/>Forwards Bearer/Cookie"| ExtAuthzEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef session fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef upstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class Route ingress
    class KAP,ExtAuthzEP,K8sAuth,BearerAuth,BasicAuthN,SessionAuth application
    class K8sAPI,OSAUTH platform
    class OIDCIdP externalservice
    class Redis session
    class Upstream upstream
    class Envoy ingress
