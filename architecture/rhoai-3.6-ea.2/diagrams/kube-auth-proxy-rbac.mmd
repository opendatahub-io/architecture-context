graph TD
    subgraph DeploymentTime["Deployment-Time RBAC (not shipped in repo)"]
        SA["ServiceAccount<br/>{deployment-specific}"]

        subgraph Bindings["Required Role Bindings"]
            CRB["ClusterRoleBinding<br/>(deployment-specific)"]
        end

        subgraph Roles["Required ClusterRole"]
            CR["ClusterRole<br/>(deployment-specific)<br/>For K8s TokenReview"]
        end

        subgraph Resources["API Resources"]
            TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        end
    end

    subgraph AuthMechanisms["Application-Level Auth Mechanisms"]
        direction TB

        subgraph K8sTokenAuth["K8s Token Validation"]
            TokenReviewAPI["TokenReview API<br/>Validates SA bearer tokens<br/>SHA-256 cached, TTL 10s"]
        end

        subgraph ProviderAuth["Provider Authentication"]
            OIDCAuth["OIDC Provider<br/>JWT bearer tokens<br/>PKCE + RP-Initiated Logout"]
            OSAuth["OpenShift OAuth<br/>OAuth bearer tokens<br/>(sha256~ format)"]
        end

        subgraph LocalAuth["Local Authentication"]
            htpasswd["htpasswd Basic Auth<br/>Local password file"]
        end

        subgraph SessionAuth["Session Management"]
            CookieAuth["Cookie Sessions<br/>Encrypted, signed"]
            RedisAuth["Redis Sessions<br/>Distributed locking"]
        end
    end

    subgraph Secrets["Secrets"]
        ProxySecret["kube-auth-proxy-secret<br/>Type: Opaque<br/>Contains: client-id, client-secret,<br/>cookie-secret<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    %% RBAC flow
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"create"| TokenReviews

    %% Auth mechanism usage
    SA -->|"uses in-cluster token"| TokenReviewAPI
    TokenReviewAPI -->|"validates against"| TokenReviews
    ProxySecret -->|"configures"| OIDCAuth
    ProxySecret -->|"configures"| OSAuth
    ProxySecret -->|"encrypts"| CookieAuth

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style TokenReviewAPI fill:#dae8fc,stroke:#6c8ebf
    style OIDCAuth fill:#dae8fc,stroke:#6c8ebf
    style OSAuth fill:#dae8fc,stroke:#6c8ebf
    style htpasswd fill:#dae8fc,stroke:#6c8ebf
    style CookieAuth fill:#e1d5e7,stroke:#9673a6
    style RedisAuth fill:#e1d5e7,stroke:#9673a6
    style ProxySecret fill:#f8cecc,stroke:#b85450
