graph TB
    subgraph OVMS["OpenVINO Model Server"]
        direction TB

        subgraph Core["Core Server"]
            Server["Server<br/>(Orchestrator)"]
            ServableManager["ServableManagerModule<br/>(Model Lifecycle)"]
            MetricMod["MetricModule<br/>(Prometheus Metrics)"]
            PythonInterp["PythonInterpreterModule<br/>(Optional)"]
        end

        subgraph APIs["API Layer"]
            HTTPMod["HTTPServerModule<br/>(Drogon Framework)"]
            GRPCMod["GRPCServerModule<br/>(gRPC C++)"]
        end

        subgraph MediaPipeCalcs["MediaPipe Calculators"]
            LLMCalc["LLM Servable<br/>(Continuous Batching)"]
            EmbedCalc["Embeddings Servable"]
            ImageCalc["Image Generation Calculator"]
            STTCalc["Speech-to-Text Calculator"]
            TTSCalc["Text-to-Speech Calculator"]
        end

        subgraph Engine["Inference Engine"]
            OVRuntime["OpenVINO Runtime"]
            OVGenAI["OpenVINO GenAI"]
            OVTokenizers["OpenVINO Tokenizers"]
        end
    end

    subgraph Sidecar["Optional Sidecar"]
        Nginx["nginx-mtls-auth<br/>(mTLS Termination)"]
    end

    Client["Client"] -->|"REST /v1,/v2,/v3"| HTTPMod
    Client -->|"gRPC"| GRPCMod
    Client -->|"HTTPS (mTLS)"| Nginx
    Nginx -->|"HTTP (plaintext)"| HTTPMod

    Server --> ServableManager
    Server --> MetricMod
    Server --> PythonInterp

    HTTPMod -->|"TFS/KServe requests"| ServableManager
    HTTPMod -->|"OpenAI-compatible requests"| LLMCalc
    HTTPMod -->|"Embeddings"| EmbedCalc
    HTTPMod -->|"Image gen"| ImageCalc
    HTTPMod -->|"Audio"| STTCalc
    HTTPMod -->|"Speech"| TTSCalc
    GRPCMod -->|"TFS/KServe gRPC"| ServableManager

    LLMCalc --> OVGenAI
    EmbedCalc --> OVGenAI
    ImageCalc --> OVRuntime
    STTCalc --> OVRuntime
    TTSCalc --> OVRuntime
    ServableManager --> OVRuntime
    OVGenAI --> OVRuntime
    OVGenAI --> OVTokenizers

    KServe["KServe<br/>(ServingRuntime CRD)"] -->|"manages"| OVMS

    ServableManager -->|"load models"| S3["S3/GCS/Azure Storage"]
    ServableManager -->|"download models"| HF["HuggingFace Hub"]

    Prometheus["Prometheus"] -->|"scrape /metrics"| MetricMod

    style Server fill:#4a90e2,color:#fff
    style HTTPMod fill:#4a90e2,color:#fff
    style GRPCMod fill:#4a90e2,color:#fff
    style ServableManager fill:#4a90e2,color:#fff
    style MetricMod fill:#4a90e2,color:#fff
    style LLMCalc fill:#7ed321,color:#fff
    style EmbedCalc fill:#7ed321,color:#fff
    style ImageCalc fill:#7ed321,color:#fff
    style STTCalc fill:#7ed321,color:#fff
    style TTSCalc fill:#7ed321,color:#fff
    style OVRuntime fill:#f5a623,color:#fff
    style OVGenAI fill:#f5a623,color:#fff
    style OVTokenizers fill:#f5a623,color:#fff
    style Nginx fill:#e8e8e8
    style KServe fill:#e8e8e8
    style S3 fill:#e8e8e8
    style HF fill:#e8e8e8
    style Prometheus fill:#e8e8e8
