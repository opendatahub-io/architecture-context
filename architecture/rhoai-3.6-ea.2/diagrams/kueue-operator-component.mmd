graph TB
    subgraph OperatorPlane["Kueue Operator Control Plane"]
        Operator["openshift-kueue-operator<br/>Go Operator<br/>Port: 60000/TCP (metrics)"]
    end

    subgraph OperandPlane["Kueue Operand Data Plane"]
        Controller["kueue-controller-manager<br/>Queueing & Admission Controller"]
        Webhook["Webhook Server<br/>9443/TCP (mutating/validating)"]
        MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS"]
        VisibilityAPI["Visibility API<br/>8082/TCP HTTPS"]
        HealthProbe["Health Probes<br/>8081/TCP"]
        Controller --> Webhook
        Controller --> MetricsEndpoint
        Controller --> VisibilityAPI
        Controller --> HealthProbe
    end

    subgraph CRDs["Custom Resources"]
        KueueCR["Kueue CR<br/>(kueue.openshift.io/v1)"]
        ClusterQueue["ClusterQueue"]
        LocalQueue["LocalQueue"]
        WorkloadCR["Workload"]
        ResourceFlavor["ResourceFlavor"]
        AdmissionCheck["AdmissionCheck"]
        Cohort["Cohort"]
    end

    Admin["Cluster Admin"] -->|creates| KueueCR
    KueueCR -->|watched by| Operator
    Operator -->|deploys & manages| Controller

    User["Data Scientist / User"] -->|submits jobs| LocalQueue
    LocalQueue -->|references| ClusterQueue
    ClusterQueue -->|uses| ResourceFlavor
    Controller -->|watches & admits| WorkloadCR
    Controller -->|evaluates| AdmissionCheck
    Controller -->|fair-share via| Cohort

    Operator -->|depends on| CertManager["cert-manager"]
    Operator -->|creates| ServiceMonitor["ServiceMonitor"]
    Controller -->|depends on| K8sAPI["Kubernetes API"]

    subgraph WorkloadIntegrations["Workload Integrations"]
        Jobs["Kubernetes Jobs"]
        PyTorchJob["PyTorchJob"]
        RayJob["RayJob"]
        AppWrapper["AppWrapper"]
        JobSet["JobSet"]
    end

    Webhook -->|mutates/validates| WorkloadIntegrations

    style Operator fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style KueueCR fill:#f5a623,color:#fff
    style ClusterQueue fill:#f5a623
    style LocalQueue fill:#f5a623
    style WorkloadCR fill:#f5a623
    style CertManager fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style ServiceMonitor fill:#7ed321
