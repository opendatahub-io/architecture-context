graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS 1.2+ termination<br/>OAuth redirect"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (Per-User Isolation)"]
        direction TB

        OAuthProxy["kube-rbac-proxy Sidecar<br/>8443/TCP HTTPS<br/>OAuth token validation<br/>Owner-only access"]

        subgraph Backends["Application Backends"]
            JupyterLab["JupyterLab Server<br/>8888/TCP HTTP<br/>JupyterLab 4.5"]
            CodeServer["Code-Server Stack<br/>80/TCP HTTP<br/>nginx → httpd → CGI"]
        end

        OAuthProxy -->|"HTTP 8888/TCP<br/>or 80/TCP<br/>pod-local (no TLS)<br/>post-auth trusted"| JupyterLab
        OAuthProxy -->|"HTTP 80/TCP<br/>pod-local (no TLS)<br/>post-auth trusted"| CodeServer
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        DSPA["Kubeflow Pipelines API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Token"]
    end

    subgraph ControlPlane["CONTROL PLANE (Platform)"]
        NotebookCtrl["ODH Notebook Controller<br/>Mutating Webhook"]
        Operator["ODH Operator"]
        Dashboard["ODH Dashboard"]
        ImageStream["ImageStreams<br/>registry.redhat.io/rhoai/"]
    end

    %% External to ingress
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OpenShift OAuth"| Route

    %% Ingress to pod
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth token"| OAuthProxy

    %% Workbench egress
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| DSPA
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM / Access Key"| S3
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>API Token"| HF

    %% Control plane
    NotebookCtrl -.->|"injects OAuth proxy,<br/>CA bundles, ConfigMaps"| WorkbenchPod
    Operator -.->|deploys| ImageStream
    Dashboard -.->|discovers via<br/>annotations| ImageStream

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy auth
    class JupyterLab,CodeServer workbench
    class DSPA,S3,HF externalservice
    class NotebookCtrl,Operator,Dashboard,ImageStream controlplane
