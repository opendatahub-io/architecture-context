graph TB
    subgraph TrainingPod["TRAINING POD (Managed by Kubeflow / Trainer Operator)"]
        direction TB

        subgraph MainProcess["Main Process"]
            THub["Training Hub Library<br/>Python 3.11+<br/>No inbound services"]
            CLI["thub CLI"]
            Registry["Algorithm Registry"]
            JIT["JIT Preemption Checkpoint<br/>SIGTERM handler"]
            CkptMgr["Checkpoint Manager<br/>Background LIFO uploader"]
        end

        subgraph Workers["Worker Processes"]
            TorchRunW["torchrun Workers<br/>(SFT, OSFT)"]
            MPSpawn["mp.spawn Workers<br/>(GRPO/ART)"]
            VerlSub["verl Subprocess<br/>(verl.trainer.main_ppo)"]
        end

        MainProcess -->|"torchrun / mp.spawn<br/>Callbacks: getsource + base64"| Workers
        JIT -->|"all_reduce(MAX)<br/>rank coordination"| Workers
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP"]
        LLMAPI["OpenAI-Compatible API<br/>443/TCP"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP"]
        MLflowSrv["MLflow Server<br/>Configurable port"]
        S3["S3-Compatible Storage<br/>443/TCP"]
        PyPI["PyPI<br/>pypi.org<br/>443/TCP"]
    end

    subgraph LocalStorage["LOCAL FILESYSTEM / PVC"]
        Checkpoints["Checkpoints<br/>checkpoint-{step}<br/>full_state_checkpoints<br/>full_state/epoch_{n}"]
        Metrics["training_metrics.jsonl<br/>(Kubeflow progress)"]
    end

    subgraph Secrets["SECRETS (Environment Variables)"]
        direction LR
        HFToken["HF_TOKEN"]
        OAIKey["OPENAI_API_KEY"]
        WANDBKey["WANDB_API_KEY"]
        AWSCreds["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
    end

    %% Egress flows
    THub -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token (optional)"| HF
    THub -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (OPENAI_API_KEY)"| LLMAPI
    THub -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (WANDB_API_KEY)"| WandB
    THub -->|"HTTP or HTTPS<br/>Configurable auth"| MLflowSrv
    CkptMgr -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM credentials"| S3

    %% Local storage
    Workers -->|"Filesystem"| Checkpoints
    THub -->|"Filesystem"| Metrics

    %% Secret usage
    HFToken -.->|used by| HF
    OAIKey -.->|used by| LLMAPI
    WANDBKey -.->|used by| WandB
    AWSCreds -.->|used by| S3

    %% Styling
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef process fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class THub,CLI,Registry,JIT,CkptMgr pod
    class TorchRunW,MPSpawn,VerlSub process
    class HF,LLMAPI,WandB,MLflowSrv,S3,PyPI external
    class Checkpoints,Metrics storage
    class HFToken,OAIKey,WANDBKey,AWSCreds secret
