graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client"]
    end

    subgraph Internal["INTERNAL (Cluster Network)"]
        direction TB

        subgraph GatewayPod["vllm-orchestrator-gateway Pod"]
            Gateway["vllm-orchestrator-gateway<br/>8090/TCP HTTP<br/>No local auth enforcement"]
            TlsMount["/etc/tls/private/<br/>tls.crt + tls.key"]
            CaMount["/etc/tls/ca/<br/>service-ca.crt"]
        end

        subgraph OrchestratorPod["FMS Guardrails Orchestrator"]
            Orchestrator["Orchestrator API<br/>/api/v2/chat/completions-detection<br/>Default 8085/TCP"]
        end
    end

    %% Flows
    Client -->|"HTTP/8090<br/>Plain HTTP<br/>Authorization header pass-through"| Gateway
    Gateway -->|"HTTP or HTTPS/8085<br/>Optional mTLS<br/>(auto-detected from cert presence)<br/>Forwarded Authorization header"| Orchestrator
    TlsMount -.->|"client identity<br/>PEM → PKCS#12"| Gateway
    CaMount -.->|"CA trust anchor"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef orchestrator fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef secret fill:#f5a623,stroke:#333,stroke-width:1px,color:#fff

    class Client external
    class Gateway gateway
    class Orchestrator orchestrator
    class TlsMount,CaMount secret
