graph TD
    subgraph ServiceIdentity["Service Identity"]
        SA["orchestr8<br/>UID 1001 (non-root)"]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB
        NoK8sRBAC["No Kubernetes RBAC<br/>(no API server access)"]
        HeaderPassthrough["Header Passthrough<br/>(configured headers forwarded)"]
        TokenRewrite["X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
    end

    subgraph InboundAuth["Inbound Authentication"]
        direction TB
        OptionalTLS["Optional Server TLS<br/>rustls + ring<br/>Port 8033"]
        OptionalMTLS["Optional mTLS<br/>WebPkiClientVerifier"]
        NoAuthHealth["No Auth<br/>Health Port 8034"]
    end

    subgraph OutboundAuth["Outbound Authentication"]
        direction TB
        DetectorBearer["Detector Services<br/>Optional Bearer Token"]
        OpenAIToken["OpenAI Service<br/>API Token (env var)"]
        NoAuthGRPC["TGIS / Chunker<br/>No App-Level Auth"]
    end

    subgraph Secrets["Secrets"]
        TLSCert["TLS server cert/key<br/>(kubernetes.io/tls)<br/>No auto-rotate"]
        ClientCA["TLS client CA cert<br/>(Opaque)<br/>No auto-rotate"]
        APITokens["API tokens<br/>(Opaque, env var)<br/>No auto-rotate"]
        DownstreamTLS["Downstream TLS certs<br/>(Opaque)<br/>No auto-rotate"]
    end

    SA -->|"runs as"| NoK8sRBAC
    SA --> HeaderPassthrough
    HeaderPassthrough --> TokenRewrite

    OptionalTLS -->|"uses"| TLSCert
    OptionalMTLS -->|"verifies with"| ClientCA
    DetectorBearer -->|"reads from"| APITokens
    OpenAIToken -->|"reads from"| APITokens
    NoAuthGRPC -.->|"optional TLS"| DownstreamTLS

    style SA fill:#4a90e2,color:#fff
    style NoK8sRBAC fill:#e8e8e8,stroke:#999
    style HeaderPassthrough fill:#f5a623,color:#fff
    style TokenRewrite fill:#f5a623,color:#fff
    style OptionalTLS fill:#ffe6cc,stroke:#d79b00
    style OptionalMTLS fill:#ffe6cc,stroke:#d79b00
    style NoAuthHealth fill:#d5e8d4,stroke:#82b366
    style DetectorBearer fill:#ffe6cc,stroke:#d79b00
    style OpenAIToken fill:#ffe6cc,stroke:#d79b00
    style NoAuthGRPC fill:#d5e8d4,stroke:#82b366
    style TLSCert fill:#fff2cc,stroke:#d6b656
    style ClientCA fill:#fff2cc,stroke:#d6b656
    style APITokens fill:#fff2cc,stroke:#d6b656
    style DownstreamTLS fill:#fff2cc,stroke:#d6b656
