graph TB
    subgraph AIGatewayOperator["ai-gateway-operator (Module Operator)"]
        Controller["Reconciler<br/>Go / controller-runtime"]
        TLSWatcher["SecurityProfileWatcher<br/>TLS Profile Resolution"]
        ActionChain["Action Chain<br/>initialize -> RBAC -> upgrade<br/>-> render -> deploy -> status -> GC"]
        MetricsServer["Metrics Server<br/>8443/TCP HTTPS"]
        HealthServer["Health Server<br/>8081/TCP HTTP"]
        Controller --> ActionChain
        Controller --> TLSWatcher
        Controller --> MetricsServer
        Controller --> HealthServer
    end

    subgraph SubComponents["Vendored Sub-Components"]
        MaaS["maas-controller<br/>(Models as a Service)"]
        BatchGW["batch-gateway-operator<br/>(LLM-d Batch Inference)"]
        AIGWCtrl["ai-gateway-controller<br/>(praxis-extproc Routing)"]
    end

    PlatformOp["opendatahub-operator"] -->|deploys via module handler| Controller
    AIGatewayCR["AIGateway CR<br/>(cluster-scoped, singleton)"] -->|watched by| Controller

    ActionChain -->|"kustomize render<br/>+ deploy (Managed)"| MaaS
    ActionChain -->|"kustomize render<br/>+ deploy (Managed)"| BatchGW
    ActionChain -->|"kustomize render<br/>+ deploy (Managed)"| AIGWCtrl

    Controller -->|reads platformVersion| ConfigMap["ConfigMap<br/>odh-aigateway-config"]
    Controller -->|reads TLS profile| APIServer["OpenShift APIServer<br/>config.openshift.io"]

    subgraph PlatformDeps["Platform Dependencies"]
        Istio["Istio"]
        GatewayAPI["Gateway API"]
        Kuadrant["Kuadrant"]
        CertManager["cert-manager"]
        Prometheus["prometheus-operator"]
    end

    MaaS -->|HTTPRoute mgmt| GatewayAPI
    MaaS -->|AuthPolicy| Kuadrant
    AIGWCtrl -->|routing| GatewayAPI
    Controller -->|certificates| CertManager
    Controller -->|ServiceMonitor| Prometheus
    Controller -->|mesh config| Istio

    KServe["KServe<br/>LLMInferenceService"] -.->|watched by MaaS| MaaS
    DSCI["DSCInitialization CR"] -.->|platform state| Controller

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style TLSWatcher fill:#4a90e2,stroke:#333,color:#fff
    style ActionChain fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style MaaS fill:#7ed321,stroke:#333
    style BatchGW fill:#7ed321,stroke:#333
    style AIGWCtrl fill:#7ed321,stroke:#333
    style AIGatewayCR fill:#f5a623,stroke:#333
    style PlatformOp fill:#e8e8e8,stroke:#333
    style Istio fill:#999,stroke:#333
    style GatewayAPI fill:#999,stroke:#333
    style Kuadrant fill:#999,stroke:#333
    style CertManager fill:#999,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style DSCI fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
