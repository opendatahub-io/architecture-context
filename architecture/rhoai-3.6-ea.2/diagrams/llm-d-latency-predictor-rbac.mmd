graph TD
    subgraph "Workload Identity"
        PredSA["Prediction Pods<br/>ServiceAccount: default<br/>(namespace default SA)"]
        TrainSA["Training Pod<br/>ServiceAccount: default<br/>(namespace default SA)"]
    end

    subgraph "RBAC Configuration"
        NoRBAC["No ClusterRole defined<br/>No RoleBinding defined<br/>No custom ServiceAccount"]
    end

    subgraph "Effective Permissions"
        direction TB
        PredPerms["Prediction Server Permissions"]
        PredFS["Filesystem: /local_models<br/>UID 1001 read/write<br/>emptyDir per pod"]
        PredNet["Network: HTTP client<br/>to training-service:8000<br/>No auth required"]

        TrainPerms["Training Server Permissions"]
        TrainFS["Filesystem: /models<br/>UID 1001 read/write<br/>emptyDir or PVC"]
        TrainNet["Network: HTTP server<br/>on port 8000<br/>No auth enforced"]
    end

    subgraph "Security Gaps"
        Gap1["⚠ No application authentication<br/>on any API endpoint"]
        Gap2["⚠ No NetworkPolicy defined<br/>default network posture"]
        Gap3["⚠ Default SA used<br/>no least-privilege binding"]
        Gap4["⚠ GKE overlay exposes<br/>unauthenticated HTTP via LB"]
    end

    PredSA -->|"uses"| NoRBAC
    TrainSA -->|"uses"| NoRBAC

    PredSA --> PredPerms
    PredPerms --> PredFS
    PredPerms --> PredNet

    TrainSA --> TrainPerms
    TrainPerms --> TrainFS
    TrainPerms --> TrainNet

    NoRBAC -.->|"results in"| Gap1
    NoRBAC -.->|"results in"| Gap2
    NoRBAC -.->|"results in"| Gap3
    NoRBAC -.->|"results in"| Gap4

    style PredSA fill:#4a90e2,color:#fff
    style TrainSA fill:#4a90e2,color:#fff
    style NoRBAC fill:#f5a623,color:#fff
    style PredPerms fill:#7ed321
    style TrainPerms fill:#7ed321
    style PredFS fill:#d5e8d4
    style PredNet fill:#d5e8d4
    style TrainFS fill:#d5e8d4
    style TrainNet fill:#d5e8d4
    style Gap1 fill:#ff6b6b,color:#fff
    style Gap2 fill:#ff6b6b,color:#fff
    style Gap3 fill:#ff6b6b,color:#fff
    style Gap4 fill:#ff6b6b,color:#fff
