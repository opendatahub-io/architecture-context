graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformIngress["INGRESS (Platform Layer)"]
        Gateway["Platform Ingress<br/>Istio/Gateway API<br/>443/TCP<br/>TLS 1.2+<br/>Bearer/mTLS"]
    end

    subgraph InferencePods["MODEL SERVING (Inference Pods)"]
        direction TB
        AGServer["autogluonserver Pod<br/>Image: odh-kserve-autogluon-server<br/>Base: rhai/base-image-cpu-rhel9<br/>8080/TCP HTTP REST<br/>8081/TCP gRPC<br/>No app-level auth"]
    end

    subgraph ControlPlane["CONTROL PLANE (kserve namespace)"]
        direction TB

        subgraph ManagerPod["kserve-controller-manager Pod"]
            Controller["kserve-controller-manager<br/>SA: kserve-controller-manager<br/>8081/TCP Health (no auth)<br/>9443/TCP Webhooks (TLS)"]
            RBACProxy["kube-rbac-proxy<br/>8443→8080/TCP<br/>TLS + TokenReview"]
        end

        WebhookSvc["Webhook Service<br/>443/TCP HTTPS<br/>cert-manager TLS<br/>FailurePolicy: Fail"]
        MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>kube-rbac-proxy"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3/GCS/Azure Blob<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>IAM/SAS Auth"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph K8sPlane["KUBERNETES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        Prometheus["Prometheus<br/>Scrape Metrics"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer/mTLS"| Gateway

    %% Ingress → Model Server
    Gateway -->|"HTTP/8080<br/>No encryption<br/>No auth (pod-internal)"| AGServer

    %% Model Server → Storage
    AGServer -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM/SAS/Bearer"| S3
    AGServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token"| HuggingFace

    %% Control Plane → K8s
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"HTTPS/443<br/>TLS (cert-manager)<br/>Admission"| WebhookSvc

    %% Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview"| MetricsSvc
    MetricsSvc --> RBACProxy
    RBACProxy -->|"HTTP/8080<br/>localhost"| Controller

    %% Webhook
    WebhookSvc --> Controller

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef serving fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class AGServer serving
    class Controller,RBACProxy,WebhookSvc,MetricsSvc controlplane
    class S3,HuggingFace externalservice
    class K8sAPI,Prometheus k8s
