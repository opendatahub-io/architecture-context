graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["ML Client<br/>(Python SDK)<br/>Bearer Token Auth"]
        Dashboard["RHOAI Dashboard<br/>(Embedded UI)"]
    end

    subgraph Ingress["INGRESS (Optional - disabled by default)"]
        IngressGW["Kubernetes Ingress<br/>443/TCP → 5000/TCP<br/>TLS Termination<br/>(configurable)"]
    end

    subgraph Application["APPLICATION (ClusterIP)"]
        direction TB

        subgraph ServerPod["MLflow Server Pod"]
            Server["MLflow Server<br/>5000/TCP HTTP<br/>FastAPI + Flask<br/>gunicorn + uvicorn"]
            AuthPlugin["kubernetes-auth Plugin<br/>(mlflow-kubernetes-plugins v1.6.0)<br/>Token validation via K8s API"]
            Server -->|loads| AuthPlugin
        end

        PromEndpoint["Prometheus Scrape<br/>5000/TCP /metrics"]
    end

    subgraph BackendStorage["BACKEND STORAGE"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (configurable)<br/>Password Auth"]
    end

    subgraph ArtifactStorage["ARTIFACT STORAGE"]
        S3["S3-compatible<br/>443/TCP HTTPS<br/>TLS<br/>AWS SigV4"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS<br/>GCP OAuth"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS<br/>Azure Identity"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>ServiceAccount Bearer"]
    end

    subgraph AIGateway["AI GATEWAY (disabled by default)"]
        OpenAI["OpenAI API<br/>443/TCP HTTPS<br/>TLS<br/>API Key"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS<br/>AWS SigV4"]
    end

    %% Ingress flows
    Client -->|"HTTP/5000 or HTTPS/443<br/>K8s Bearer Token<br/>+ X-MLFLOW-WORKSPACE"| IngressGW
    Dashboard -->|"Module Federation<br/>HTTP"| IngressGW
    IngressGW -->|"HTTP/5000<br/>Forwarded Auth"| Server

    %% Direct access (no ingress)
    Client -.->|"HTTP/5000<br/>K8s Bearer Token<br/>(direct ClusterIP)"| Server

    %% Backend flows
    Server -->|"TCP/5432<br/>TLS (configurable)<br/>Password"| PostgreSQL
    Server -->|"HTTPS/443<br/>AWS SigV4"| S3
    Server -->|"HTTPS/443<br/>GCP OAuth"| GCS
    Server -->|"HTTPS/443<br/>Azure Identity"| Azure

    %% Platform flows
    AuthPlugin -->|"HTTPS/443<br/>TokenReview API<br/>SA Bearer Token"| K8sAPI
    Server -->|"HTTPS/443<br/>Workspace Store<br/>SA Bearer Token"| K8sAPI

    %% AI Gateway flows (optional)
    Server -.->|"HTTPS/443<br/>API Key<br/>(when enabled)"| OpenAI
    Server -.->|"HTTPS/443<br/>AWS SigV4<br/>(when enabled)"| Bedrock

    %% Monitoring
    PromEndpoint -.->|"scraped by Prometheus"| Server

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef artifact fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef gateway fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5

    class Client,Dashboard external
    class IngressGW ingress
    class Server,AuthPlugin,PromEndpoint application
    class PostgreSQL backend
    class S3,GCS,Azure artifact
    class K8sAPI platform
    class OpenAI,Bedrock gateway
