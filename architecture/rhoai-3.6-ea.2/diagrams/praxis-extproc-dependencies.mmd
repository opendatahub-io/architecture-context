graph LR
    PraxisExtproc["praxis-extproc<br/>(Envoy ExtProc Server)"]

    %% Core Praxis Dependencies
    PraxisExtproc -->|"filter pipeline<br/>framework"| PraxisCore["praxis-core 0.5.4"]
    PraxisExtproc -->|"filter trait<br/>pipeline builder"| PraxisFilter["praxis-filter 0.5.4"]
    PraxisExtproc -->|"AI API types<br/>ResponseStoreRegistry"| PraxisAIAPIs["praxis-ai-apis<br/>git@da29eb4"]
    PraxisExtproc -->|"AI filters<br/>model_to_header"| PraxisAIFilters["praxis-ai-filters<br/>git@da29eb4"]
    PraxisExtproc -->|"ExtProc protobuf<br/>types"| PraxisProto["praxis-proto<br/>(local path)"]

    %% gRPC / Networking
    PraxisExtproc -->|"gRPC framework"| Tonic["tonic 0.14.6"]
    PraxisExtproc -->|"health check<br/>protocol"| TonicHealth["tonic-health 0.14.6"]
    PraxisExtproc -->|"protobuf runtime"| Prost["prost 0.14.3"]
    PraxisExtproc -->|"async runtime"| Tokio["tokio 1.52.2"]
    PraxisExtproc -->|"metrics HTTP"| Hyper["hyper 1.9.0"]

    %% TLS / Crypto
    PraxisExtproc -->|"TLS termination<br/>FIPS detection"| OpenSSL["openssl 0.10.81<br/>(system OpenSSL)"]
    PraxisExtproc -->|"async TLS"| TokioOpenSSL["tokio-openssl 0.6.5"]

    %% Observability
    PraxisExtproc -->|"Prometheus<br/>metrics"| MetricsProm["metrics-exporter-prometheus<br/>0.16.2"]
    PraxisExtproc -->|"structured<br/>logging"| Tracing["tracing 0.1.44 /<br/>tracing-subscriber 0.3.23"]

    %% Config
    PraxisExtproc -->|"CLI args"| Clap["clap 4.6.1"]
    PraxisExtproc -->|"YAML config"| Serde["serde 1.0.228 /<br/>serde_yaml 0.10.4"]

    %% Internal Platform Dependencies
    EnvoyGW["Istio / Envoy Gateway"] -->|"EnvoyFilter<br/>gRPC ExtProc"| PraxisExtproc
    Kuadrant["Kuadrant / RHCL"] -.->|"filter chain<br/>ordering anchor"| PraxisExtproc
    PraxisExtproc -->|"get/list/watch"| InferenceCRDs["inference.opendatahub.io<br/>ExternalProviders<br/>ExternalModels"]
    PraxisExtproc -->|"volume mount"| ConfigMap["Kubernetes ConfigMap"]

    %% Integration Points
    Prometheus["Prometheus / OCP Monitoring"] -->|"scrape 9090/TCP"| PraxisExtproc

