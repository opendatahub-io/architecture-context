graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Administrator<br/>(kubectl/helm)"]
        Catalog["OLM Catalog Sources<br/>redhat-operators<br/>certified-operators"]
        ContainerReg["Container Registries<br/>443/TCP HTTPS"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        InferenceGW["inference-gateway<br/>443/TCP HTTPS<br/>TLS Terminate<br/>Authorino AuthPolicy"]
        InferenceGW80["inference-gateway<br/>80/TCP HTTP<br/>(XKS only)"]
        OCPGW["openshift-ai-inference<br/>443/TCP HTTPS<br/>TLS Terminate"]
        MaaSGW["maas-default-gateway<br/>443/TCP HTTPS<br/>TLS Terminate<br/>Authorino AuthPolicy"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (TLS)"]
        direction TB

        subgraph OperatorNS["Namespace: redhat-ods-operator"]
            RHAIOp["RHAI Operator<br/>SA: redhat-ods-operator-controller-manager"]
            Webhook["Webhook Service<br/>443/TCP → 9443<br/>HTTPS TLS"]
            Metrics["Metrics Service<br/>8080/TCP HTTP<br/>ClusterIP Internal"]
        end

        subgraph DependencyOps["Dependency Operators (OLM-managed)"]
            CertMgr["cert-manager"]
            Kueue["Kueue"]
            LWS["Leader Worker Set"]
            RHCL["RHCL / Kuadrant"]
            COO["Cluster Observability"]
            OTEL["OpenTelemetry"]
            KEDA["Custom Metrics Autoscaler"]
        end

        subgraph CloudMgrNS["Cloud Manager (XKS only)"]
            CloudMgr["Cloud Manager Operator<br/>SA: provider-cloud-manager-operator"]
        end

        subgraph AuthNS["Namespace: redhat-ods-applications"]
            AuthorinoSvc["Authorino<br/>TLS: authorino-server-cert<br/>CA: rhai-ca"]
        end
    end

    %% Admin flows
    Admin -->|kubeconfig TLS<br/>RBAC| RHAIOp
    Admin -->|kubeconfig TLS<br/>RBAC| Webhook

    %% OLM flows
    RHAIOp -->|OLM Subscription<br/>Kubernetes API TLS| DependencyOps
    DependencyOps -->|HTTPS/443<br/>TLS| Catalog
    DependencyOps -->|HTTPS/443<br/>TLS, Pull Secret| ContainerReg

    %% Gateway auth
    InferenceGW -->|AuthPolicy| AuthorinoSvc
    MaaSGW -->|AuthPolicy| AuthorinoSvc

    %% TLS provisioning
    CertMgr -.->|Issues certs| InferenceGW
    CertMgr -.->|Issues certs| MaaSGW
    CertMgr -.->|Issues cert| AuthorinoSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef auth fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Admin,Catalog,ContainerReg external
    class InferenceGW,InferenceGW80,OCPGW,MaaSGW ingress
    class RHAIOp,Webhook,Metrics,CloudMgr internal
    class CertMgr,Kueue,LWS,RHCL,COO,OTEL,KEDA operator
    class AuthorinoSvc auth
