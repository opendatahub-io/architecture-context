graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["batch-gateway-apiserver<br/>(ServiceAccount)"]
        SA_PROC["batch-gateway-processor<br/>(ServiceAccount)"]
        SA_GC["batch-gateway-gc<br/>(ServiceAccount)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_GC["batch-gateway-gc-pod-watcher<br/>(RoleBinding)<br/>Namespace: release-namespace"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        ROLE_GC["batch-gateway-gc-pod-watcher<br/>(Role)<br/>Condition: reconciler.enabled=true"]
    end

    subgraph APIResources["API Resources"]
        Pods["core<br/>pods"]
        StatefulSets["apps<br/>statefulsets"]
    end

    %% GC RBAC chain
    SA_GC -->|"bound via"| RB_GC
    RB_GC -->|"grants"| ROLE_GC
    ROLE_GC -->|"get, list, watch"| Pods
    ROLE_GC -->|"get, list, watch"| StatefulSets

    %% No explicit RBAC for API server and processor
    SA_API -.->|"no explicit RBAC<br/>(no K8s API access)"| NoRBAC1["N/A"]
    SA_PROC -.->|"no explicit RBAC<br/>(no K8s API access)"| NoRBAC2["N/A"]

    subgraph Secrets["Secrets"]
        SharedSecret["batch-gateway-secrets<br/>(Opaque)<br/>postgresql-url<br/>redis-url<br/>inference-api-key<br/>s3-secret-access-key"]
        TLSSecret["apiserver-tls<br/>(kubernetes.io/tls)<br/>cert-manager or manual"]
    end

    SA_API -.->|"mounts"| SharedSecret
    SA_API -.->|"mounts (optional)"| TLSSecret
    SA_PROC -.->|"mounts"| SharedSecret
    SA_GC -.->|"mounts"| SharedSecret

    style SA_GC fill:#4a90e2,color:#fff
    style SA_API fill:#4a90e2,color:#fff
    style SA_PROC fill:#4a90e2,color:#fff
    style ROLE_GC fill:#f5a623
    style RB_GC fill:#f5a623
    style Pods fill:#7ed321
    style StatefulSets fill:#7ed321
    style SharedSecret fill:#e8e8e8,stroke:#999
    style TLSSecret fill:#e8e8e8,stroke:#999
    style NoRBAC1 fill:#f9f9f9,stroke:#ccc
    style NoRBAC2 fill:#f9f9f9,stroke:#ccc
