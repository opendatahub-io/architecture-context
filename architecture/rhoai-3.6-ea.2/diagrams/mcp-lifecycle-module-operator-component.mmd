graph TB
    subgraph ODHPlatform["ODH Platform Layer"]
        PlatformOp["ODH Platform Operator"]
    end

    subgraph ModuleOperator["mcp-lifecycle-module-operator"]
        Reconciler["Reconciler<br/>(controller-runtime)"]
        TLSResolver["TLS Profile Resolver<br/>(library-go)"]
        ManifestRenderer["Manifest Renderer<br/>(manifestival)"]
        SSADeployer["SSA Deployer<br/>(odh-platform-utilities)"]
        GC["Garbage Collector"]
        HealthProbe["Health Probes<br/>:8081/TCP"]
    end

    subgraph Operand["mcp-lifecycle-operator (operand)"]
        OperandController["MCP Lifecycle Controller"]
        OperandMetrics["Metrics Server<br/>:8443/TCP HTTPS"]
    end

    subgraph CRDs["Custom Resources"]
        MLCR["MCPLifecycleOperator CR<br/>(Cluster-scoped, singleton)"]
        MCPServerCR["MCPServer CR<br/>(Namespaced)"]
    end

    PlatformOp -->|creates| MLCR
    MLCR -->|watched by| Reconciler
    Reconciler -->|reads TLS profile| TLSResolver
    TLSResolver -->|OpenShift APIServer| OpenShiftAPI["OpenShift APIServer CR"]
    Reconciler -->|triggers| ManifestRenderer
    ManifestRenderer -->|"namespace, image,<br/>TLS env injection"| SSADeployer
    SSADeployer -->|"Server-Side Apply"| Operand
    Reconciler -->|removes stale| GC
    Reconciler -->|checks readiness| Operand

    OperandController -->|manages| MCPServerCR
    OperandMetrics -->|scraped via| ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]

    K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"] --- Reconciler

    style Reconciler fill:#4a90e2,color:#fff
    style TLSResolver fill:#4a90e2,color:#fff
    style ManifestRenderer fill:#4a90e2,color:#fff
    style SSADeployer fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style HealthProbe fill:#4a90e2,color:#fff
    style OperandController fill:#7ed321,color:#fff
    style OperandMetrics fill:#7ed321,color:#fff
    style MLCR fill:#f5a623,color:#fff
    style MCPServerCR fill:#f5a623,color:#fff
    style PlatformOp fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#e8e8e8,stroke:#333
