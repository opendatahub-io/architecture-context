graph TD
    subgraph PlatformRBAC["Platform-Managed RBAC (Not MLServer-defined)"]
        direction TB

        subgraph AuthFlow["Authentication Flow"]
            Client["External Client<br/>with Bearer Token"]
            KRBAC["kube-rbac-proxy Sidecar<br/>(per InferenceService pod)"]
            OAuth["OpenShift OAuth Server"]
        end

        subgraph Endpoints["Protected Endpoints"]
            REST["REST API Endpoints<br/>/v2/* on 8080/TCP"]
            GRPC["gRPC Services<br/>inference.* on 8081/TCP"]
        end

        subgraph Unprotected["Unprotected Endpoints"]
            Metrics["/metrics on 8082/TCP<br/>Prometheus scraping<br/>No auth required"]
        end
    end

    subgraph AppSecurity["Application-Level Security Controls"]
        direction TB

        subgraph TrustedRuntimes["Trusted Runtimes Allowlist"]
            AllowlistFile["/etc/mlserver/trusted-runtimes.json<br/>(baked into image at build time)"]

            subgraph CPUAllowed["CPU Image Allowed Runtimes"]
                SKLearn["mlserver_sklearn.SKLearnModel"]
                XGBoost["mlserver_xgboost.XGBoostModel"]
                LightGBM["mlserver_lightgbm.LightGBMModel"]
                ONNX["mlserver_onnx.OnnxModel"]
            end

            subgraph CUDAAllowed["CUDA Image Allowed Runtimes"]
                ONNXOnly["mlserver_onnx.OnnxModel"]
            end
        end

        subgraph ProductionBlocks["Production Mode Restrictions"]
            NoCustomEnv["Block custom environments<br/>(environment_tarball, environment_path)"]
            NoWildcardCORS["Block wildcard CORS origins"]
            NoSysPath["Block sys.path injection"]
        end
    end

    Client -->|"Bearer Token<br/>(OpenShift OAuth)"| KRBAC
    KRBAC -->|"validates against"| OAuth
    KRBAC -->|"forwards if valid"| REST
    KRBAC -->|"forwards if valid"| GRPC

    AllowlistFile -->|"enforces at<br/>settings validation"| CPUAllowed
    AllowlistFile -->|"enforces at<br/>settings validation"| CUDAAllowed

    subgraph ContainerSecurity["Container Security"]
        NonRoot["Runs as USER 1000<br/>(non-root)"]
        ReadOnlyConfig["Allowlist is read-only<br/>(baked into image)"]
    end

    style Client fill:#f9f9f9,stroke:#999
    style KRBAC fill:#e67e22,stroke:#333,stroke-width:2px
    style OAuth fill:#e67e22,stroke:#333
    style REST fill:#4a90e2,stroke:#333
    style GRPC fill:#4a90e2,stroke:#333
    style Metrics fill:#f5a623,stroke:#333
    style AllowlistFile fill:#e74c3c,stroke:#333,stroke-width:2px
    style SKLearn fill:#7ed321,stroke:#333
    style XGBoost fill:#7ed321,stroke:#333
    style LightGBM fill:#7ed321,stroke:#333
    style ONNX fill:#7ed321,stroke:#333
    style ONNXOnly fill:#7ed321,stroke:#333
    style NoCustomEnv fill:#f8cecc,stroke:#b85450
    style NoWildcardCORS fill:#f8cecc,stroke:#b85450
    style NoSysPath fill:#f8cecc,stroke:#b85450
    style NonRoot fill:#dae8fc,stroke:#6c8ebf
    style ReadOnlyConfig fill:#dae8fc,stroke:#6c8ebf
