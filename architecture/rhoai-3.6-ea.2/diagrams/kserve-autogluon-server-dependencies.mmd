graph LR
    AG["kserve-autogluon-server<br/>(AutoGluon Model Server)"]

    %% Python Dependencies (Direct)
    AG -->|"tabular inference"| AutoGluonTab["autogluon.tabular<br/>1.5.0+rhaiv.3"]
    AG -->|"time-series inference"| AutoGluonTS["autogluon.timeseries<br/>1.5.0+rhaiv.3"]
    AG -->|"serving framework"| KServeSDK["kserve Python SDK<br/>>=0.16.0"]
    AG -->|"model download"| KServeStorage["kserve-storage<br/>0.19.0"]

    %% ML Backend Dependencies
    AutoGluonTab -->|"backend"| Torch["torch<br/>2.11.0+cpu"]
    AutoGluonTab -->|"backend"| ScikitLearn["scikit-learn<br/>~=1.5.1"]
    AutoGluonTab -->|"backend"| LightGBM["lightgbm<br/>~=4.6.0"]
    AutoGluonTab -->|"backend"| XGBoost["xgboost<br/>~=2.1.1"]
    AutoGluonTab -->|"backend"| Transformers["transformers<br/>>=4.53.2"]

    %% KServe SDK Dependencies
    KServeSDK -->|"REST API"| FastAPI["FastAPI<br/>>=0.115.3"]
    KServeSDK -->|"ASGI server"| Uvicorn["uvicorn<br/>>=0.30.6"]
    KServeSDK -->|"gRPC transport"| GRPCIO["grpcio<br/>>=1.73.0"]
    KServeSDK -->|"TLS/crypto"| Cryptography["cryptography<br/>>=46.0.5"]
    KServeSDK -->|"JWT handling"| PyJWT["pyjwt<br/>>=2.12.0"]

    %% Internal Platform Dependencies
    AG -.->|"metrics scrape<br/>8080/TCP"| Prometheus["Prometheus"]
    AG -.->|"model storage<br/>443/TCP HTTPS"| S3["S3/GCS/Azure Blob"]
    AG -.->|"model download<br/>443/TCP HTTPS"| HuggingFace["HuggingFace Hub"]

    %% Go Controller Dependencies (broader repo)
    subgraph GoControllerDeps["Go Controller Dependencies (repo-level)"]
        ControllerRuntime["controller-runtime<br/>0.22.5"]
        GoRuntime["Go 1.25.8"]
    end

    %% Platform Integration Dependencies
    subgraph PlatformDeps["Platform Integration"]
        Istio["Istio<br/>VirtualService"]
        Knative["Knative Serving"]
        KEDA["KEDA<br/>ScaledObject"]
        CertManager["cert-manager"]
        GatewayAPI["Gateway API<br/>HTTPRoute"]
        KubeRBACProxy["kube-rbac-proxy<br/>v0.18.0"]
        GatewayInfExt["gateway-api-inference-extension"]
        LLMDWVA["llm-d-workload-variant-autoscaler"]
    end

