graph TB
    subgraph External["EXTERNAL (Users / Clients)"]
        User["User / SDK / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC + SA tokens"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB
        Operator["Training Operator Pod<br/>SA: training-operator<br/>Image: training-operator:v1.9.0-odh-3<br/>Non-root UID 65532<br/>FIPS: strictfipsruntime"]

        subgraph Ports["Exposed Ports"]
            Metrics["8080/TCP Metrics<br/>HTTP/TLS (cluster profile)<br/>Auth: None"]
            Health["8081/TCP Health Probes<br/>HTTP, No TLS<br/>Auth: None"]
            WebhookPort["9443/TCP Webhooks<br/>HTTPS, TLS (cluster profile)<br/>Auth: K8s Admission<br/>Cert: OPA cert-controller"]
        end

        WebhookCert["Secret: webhook-cert<br/>Type: Opaque/TLS<br/>Auto-rotate: Yes"]

        Operator --- Ports
        WebhookCert -.->|"mounted at<br/>/tmp/k8s-webhook-server/serving-certs"| WebhookPort
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACES (per-tenant)"]
        direction TB
        Workers["Worker / Master Pods<br/>Label: training.kubeflow.org/operator-name"]
        HeadlessSvc["Headless Services<br/>(peer discovery)"]
        MPIResources["MPI Resources<br/>ConfigMap + SA + Role + RoleBinding"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>PodMonitor scrape"]
    end

    subgraph Optional["OPTIONAL INTEGRATIONS"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS profile discovery"]
        Volcano["Volcano Scheduler<br/>PodGroup CRD"]
        SchedulerPlugins["Scheduler Plugins<br/>PodGroup CRD"]
    end

    %% External to Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% Control Plane to Operator (webhook)
    K8sAPI -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>K8s Admission"| WebhookPort

    %% Operator to Control Plane (CRUD)
    Operator -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Operator reads OpenShift config
    Operator -.->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OpenShiftAPI

    %% Operator creates workload resources (via K8s API)
    Operator -->|"Creates via K8s API"| Workers
    Operator -->|"Creates via K8s API"| HeadlessSvc
    Operator -.->|"Creates via K8s API<br/>(MPIJob only)"| MPIResources

    %% Gang scheduling
    Operator -.->|"Creates PodGroups<br/>via K8s API"| Volcano
    Operator -.->|"Creates PodGroups<br/>via K8s API"| SchedulerPlugins

    %% Monitoring
    Prometheus -->|"HTTP(S)/8080<br/>TLS (cluster profile)<br/>No auth"| Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5

    class User external
    class K8sAPI controlplane
    class Operator,Metrics,Health,WebhookPort,WebhookCert operator
    class Workers,HeadlessSvc,MPIResources workload
    class Prometheus monitoring
    class OpenShiftAPI,Volcano,SchedulerPlugins optional
