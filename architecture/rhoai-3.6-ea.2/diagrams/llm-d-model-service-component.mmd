graph TB
    subgraph ModelServiceController["llm-d-model-service Controller"]
        Manager["modelservice-controller-manager<br/>(Go Operator)"]
        Reconciler["ModelServiceReconciler<br/>watches 9 resource types"]
        BaseConfigMerge["BaseConfig Merger<br/>(mergo deep merge +<br/>text/template interpolation)"]
        Manager --> Reconciler
        Reconciler --> BaseConfigMerge
    end

    subgraph GenerateCLI["Offline CLI"]
        Generate["generate subcommand<br/>(offline manifest generation)"]
    end

    User["User / GitOps"] -->|"creates"| ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
    ModelServiceCR -->|"watched by"| Reconciler

    BaseConfigCM["BaseConfig ConfigMap<br/>(platform presets)"] -->|"read + merged"| BaseConfigMerge

    subgraph ChildResources["Managed Child Resources"]
        PrefillDeploy["Prefill Deployment"]
        DecodeDeploy["Decode Deployment"]
        EPPDeploy["EPP Deployment"]
        EPPService["EPP Service"]
        InfPool["InferencePool"]
        InfModel["InferenceModel"]
        HTTPRouteRes["HTTPRoute"]
        SA["ServiceAccounts"]
        RB["RoleBindings"]
        CM["ConfigMaps"]
    end

    BaseConfigMerge -->|"CreateOrUpdate"| PrefillDeploy
    BaseConfigMerge -->|"CreateOrUpdate"| DecodeDeploy
    BaseConfigMerge -->|"CreateOrUpdate"| EPPDeploy
    BaseConfigMerge -->|"CreateOrUpdate"| EPPService
    BaseConfigMerge -->|"CreateOrUpdate"| InfPool
    BaseConfigMerge -->|"CreateOrUpdate"| InfModel
    BaseConfigMerge -->|"CreateOrUpdate"| HTTPRouteRes
    BaseConfigMerge -->|"CreateOrUpdate"| SA
    BaseConfigMerge -->|"CreateOrUpdate"| RB
    BaseConfigMerge -->|"CreateOrUpdate"| CM

    Reconciler -->|"CRUD via"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]

    ModelServiceCR -.->|"YAML input"| Generate
    BaseConfigCM -.->|"YAML input"| Generate

    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style BaseConfigMerge fill:#4a90e2,color:#fff
    style Generate fill:#6c8ebf,color:#fff
    style ModelServiceCR fill:#f5a623,color:#fff
    style BaseConfigCM fill:#f5a623,color:#fff
    style PrefillDeploy fill:#7ed321,color:#fff
    style DecodeDeploy fill:#7ed321,color:#fff
    style EPPDeploy fill:#7ed321,color:#fff
    style EPPService fill:#7ed321,color:#fff
    style InfPool fill:#7ed321,color:#fff
    style InfModel fill:#7ed321,color:#fff
    style HTTPRouteRes fill:#7ed321,color:#fff
    style SA fill:#7ed321,color:#fff
    style RB fill:#7ed321,color:#fff
    style CM fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
