graph TB
    subgraph KEDABlueprints["KEDA Blueprint Scenarios (Production)"]
        PDDisagg["P/D Disaggregation<br/>Blueprint"]
        StagingStrats["Staging Strategies<br/>(baseline, queue-aggressive,<br/>kv-early, token-aware)"]
        ClusterOverlays["Cluster Config Overlays<br/>(k8s inference-sim,<br/>OCP vLLM, OCP model-sim)"]
    end

    subgraph BenchmarkTestBed["Benchmark Evaluation Test Bed"]
        BenchHarness["llm-d-benchmark<br/>Harness"]
        BenchScenarios["Scenario Specs<br/>(Jinja2 Templates)"]
        GrafanaDash["Grafana Dashboard<br/>(JSON)"]
    end

    subgraph LegacyWVA["WVA Controller (Legacy, Deprecated)"]
        WVAController["WVA Controller<br/>(Go controller-runtime)"]
        ConfigMapCtrl["ConfigMap Controller"]
        HPACtrl["HPA Controller"]
        InferPoolCtrl["InferencePool Controller"]
        ScaledObjCtrl["ScaledObject Controller"]
        WVAController --> ConfigMapCtrl
        WVAController --> HPACtrl
        WVAController --> InferPoolCtrl
        WVAController --> ScaledObjCtrl
    end

    %% External dependencies
    KEDA["KEDA<br/>(ScaledObject CRDs)"]
    Prometheus["Prometheus /<br/>Thanos Querier"]
    K8sAPI["Kubernetes API"]
    InferenceServers["vLLM / EPP<br/>Inference Servers"]

    %% Production path
    InferenceServers -->|expose metrics| Prometheus
    KEDA -->|reads metrics via<br/>Prometheus triggers| Prometheus
    KEDA -->|manages HPA scaling| K8sAPI
    PDDisagg -->|defines ScaledObject| KEDA
    StagingStrats -->|defines ScaledObject| KEDA
    ClusterOverlays -->|layers onto| PDDisagg

    %% Benchmark path
    BenchHarness -->|drives load &<br/>collects metrics| InferenceServers
    BenchHarness -->|captures scaling data| Prometheus
    BenchScenarios -->|configures| BenchHarness
    GrafanaDash -->|visualizes| Prometheus

    %% Legacy path
    WVAController -->|queries metrics| Prometheus
    WVAController -->|watches & scales| K8sAPI
    InferPoolCtrl -->|watches InferencePool| K8sAPI
    HPACtrl -->|watches HPA| K8sAPI
    ScaledObjCtrl -->|watches ScaledObject| K8sAPI

    %% Styling
    style PDDisagg fill:#4a90e2,stroke:#333
    style StagingStrats fill:#4a90e2,stroke:#333
    style ClusterOverlays fill:#4a90e2,stroke:#333
    style BenchHarness fill:#7ed321,stroke:#333
    style BenchScenarios fill:#7ed321,stroke:#333
    style GrafanaDash fill:#7ed321,stroke:#333
    style WVAController fill:#999,stroke:#333
    style ConfigMapCtrl fill:#999,stroke:#333
    style HPACtrl fill:#999,stroke:#333
    style InferPoolCtrl fill:#999,stroke:#333
    style ScaledObjCtrl fill:#999,stroke:#333
    style KEDA fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style InferenceServers fill:#f5a623,stroke:#333
