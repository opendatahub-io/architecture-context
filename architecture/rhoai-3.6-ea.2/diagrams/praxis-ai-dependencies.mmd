graph LR
    PraxisAI["Praxis AI Gateway<br/>v0.5.1"]

    %% Core Runtime Dependencies
    PraxisAI -->|"proxy runtime<br/>filter framework"| PraxisCore["Praxis Core<br/>(praxis-proxy 0.7.3)"]
    PraxisCore -->|"HTTP proxy engine"| Pingora["Quixotic-Plecostomus<br/>(Pingora fork 0.10.0)"]

    %% Required Dependencies
    PraxisAI -->|"async runtime"| Tokio["tokio 1.53.1"]
    PraxisAI -->|"TLS protocol"| Rustls["rustls 0.23.45"]
    PraxisAI -->|"crypto ops"| OpenSSL["openssl 0.10.81"]
    PraxisAI -->|"token counting"| Tiktoken["tiktoken-rs 0.12.0"]
    PraxisAI -->|"allocator"| Jemalloc["tikv-jemallocator 0.7.0"]

    %% Optional Dependencies
    PraxisAI -.->|"gRPC ext_proc"| Tonic["tonic 0.14.6"]
    PraxisAI -.->|"SQL (PG/SQLite)"| Sqlx["sqlx 0.9.0"]
    PraxisAI -.->|"rate limiting"| RedisClient["redis 1.7.0"]
    PraxisAI -.->|"MCP client"| RMCP["rmcp 3.4.0"]

    %% Integration Points (downstream)
    PraxisAI -->|"inference routing"| vLLM["vLLM / Inference<br/>Backends"]
    PraxisAI -->|"guardrails"| NeMo["NeMo Guardrails"]
    PraxisAI -->|"tool dispatch"| MCPServers["MCP Servers"]
    PraxisAI -->|"agent routing"| A2A["A2A Agents"]
    PraxisAI -->|"state persistence"| PostgreSQL["PostgreSQL"]
    PraxisAI -.->|"rate limiting"| Redis["Redis"]

    %% Cloud Provider Integrations
    PraxisAI -->|"Bedrock Converse"| AWS["AWS Bedrock<br/>443/TCP"]
    PraxisAI -->|"Azure AI"| Azure["Azure OpenAI<br/>443/TCP"]
    PraxisAI -->|"Vertex Gemini"| GCP["Google Vertex AI<br/>443/TCP"]

    %% Upstream Consumers
    PraxisAI -->|"metering data"| MeteringEP["External Metering"]

    %% Styling
    style PraxisAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PraxisCore fill:#999,stroke:#333,color:#fff
    style Pingora fill:#999,stroke:#333,color:#fff
    style Tokio fill:#bbb,stroke:#333
    style Rustls fill:#bbb,stroke:#333
    style OpenSSL fill:#bbb,stroke:#333
    style Tiktoken fill:#bbb,stroke:#333
    style Jemalloc fill:#bbb,stroke:#333
