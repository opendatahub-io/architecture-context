graph LR
    LLMDApiExt["llm-d-api-extensions<br/>(vLLM Plugin Library)"]

    %% Required External Dependencies
    LLMDApiExt -->|"plugin host<br/>(required)"| VLLM["vLLM<br/>(unconstrained)"]
    LLMDApiExt -->|"HTTP routes<br/>(required)"| FastAPI["FastAPI<br/>(unconstrained)"]
    LLMDApiExt -->|"response models<br/>(required)"| Pydantic["Pydantic<br/>(>=2)"]
    LLMDApiExt -->|"build backend"| Setuptools["setuptools<br/>(>=68.0)"]

    %% Internal Platform Dependencies
    LLMDRouter["llm-d Router"] -->|"HTTP consumer<br/>8000/TCP"| LLMDApiExt
    VLLM -->|"plugin framework<br/>worker extensions<br/>collective_rpc"| LLMDApiExt

    %% Test Dependencies
    LLMDApiExt -.->|"test"| Pytest["pytest"]
    LLMDApiExt -.->|"async test"| PytestAsyncio["pytest-asyncio"]
    LLMDApiExt -.->|"e2e test"| HTTPX["httpx"]

    %% vLLM Mechanisms
    subgraph VLLMIntegration["vLLM Integration Points"]
        EntryPoints["vllm.endpoint_plugins<br/>(entry points)"]
        WorkerExtCls["--worker-extension-cls<br/>(CLI flag)"]
        VLLMPluginsEnv["VLLM_PLUGINS<br/>(env var activation)"]
    end

    LLMDApiExt -->|"registered via"| EntryPoints
    LLMDApiExt -->|"installs worker via"| WorkerExtCls
    VLLMPluginsEnv -->|"activates"| EntryPoints

    style LLMDApiExt fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style VLLM fill:#999,stroke:#333,color:#fff
    style FastAPI fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style Setuptools fill:#999,stroke:#333,color:#fff
    style LLMDRouter fill:#7ed321,stroke:#333,color:#fff
    style Pytest fill:#e8e8e8,stroke:#999
    style PytestAsyncio fill:#e8e8e8,stroke:#999
    style HTTPX fill:#e8e8e8,stroke:#999
    style EntryPoints fill:#fff2cc,stroke:#d6b656
    style WorkerExtCls fill:#fff2cc,stroke:#d6b656
    style VLLMPluginsEnv fill:#fff2cc,stroke:#d6b656
