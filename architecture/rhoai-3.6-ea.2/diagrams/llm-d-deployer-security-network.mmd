graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway — No TLS by Default)"]
        Gateway["Gateway<br/>(Istio / kGateway / GKE L7)<br/>80/TCP HTTP<br/>No Auth"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No NetworkPolicy)"]
        direction TB

        subgraph EPPZone["EPP Service"]
            EPP["Endpoint Picker<br/>SA: per-model EPP SA<br/>9002/TCP gRPC (ext_proc)<br/>9003/TCP gRPC (health)<br/>9090/TCP HTTP (metrics)"]
        end

        subgraph RedisZone["Redis"]
            Redis["Redis Master<br/>8100/TCP<br/>Auth: Disabled"]
        end

        subgraph ControllerZone["ModelService Controller"]
            Controller["ModelService Controller<br/>SA: modelservice-sa<br/>8443/TCP (webhook)<br/>8081/TCP (health)<br/>runAsNonRoot, drop ALL"]
        end

        subgraph DecodePod["Decode Pod"]
            RoutingProxy["Routing Proxy Sidecar<br/>8000/TCP HTTP"]
            VLLMDecode["vLLM Decode<br/>8001/TCP HTTP<br/>nvidia.com/gpu"]
        end

        subgraph PrefillPod["Prefill Pod"]
            VLLMPrefill["vLLM Prefill<br/>8000/TCP HTTP<br/>5557/TCP NixL<br/>nvidia.com/gpu"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["Hugging Face Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: Bearer HF_TOKEN"]
        GHCR["ghcr.io<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: imagePullSecrets"]
        Quay["quay.io<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: imagePullSecrets"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS TLS<br/>Auth: ServiceAccount"]
    end

    %% Flows
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Gateway
    Gateway -->|"gRPC/9002<br/>No TLS<br/>ext_proc"| EPP
    EPP -->|"TCP/8100<br/>No TLS<br/>No Auth"| Redis
    Gateway -->|"HTTP/8000<br/>No TLS"| RoutingProxy
    RoutingProxy -->|"HTTP/8001<br/>No TLS"| VLLMDecode
    VLLMDecode -->|"NixL/5557<br/>No TLS<br/>KV transfer"| VLLMPrefill

    Controller -->|"HTTPS/443<br/>TLS<br/>ServiceAccount"| K8sAPI
    VLLMPrefill -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HF
    VLLMDecode -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HF

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px

    class Client external
    class Gateway warning
    class EPP,Controller,RoutingProxy,VLLMDecode,VLLMPrefill internal
    class Redis warning
    class HF,GHCR,Quay,K8sAPI externalservice
