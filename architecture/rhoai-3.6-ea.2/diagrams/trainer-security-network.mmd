graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / User"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (opendatahub)"]
        direction TB

        subgraph ControllerPod["trainer-controller-manager Pod<br/>SA: kubeflow-trainer-controller-manager"]
            direction TB
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster profile)<br/>HTTP/2: DISABLED<br/>Auth: mTLS (K8s API)"]
            MetricsSrv["Metrics Server<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>HTTP/2: DISABLED<br/>Auth: Bearer + SAR"]
            StatusSrv["Status Server<br/>10443/TCP HTTPS<br/>TLS (cluster profile)<br/>HTTP/2: DISABLED<br/>Auth: OIDC SA token<br/>Body: 64kB max<br/>(feature-gated)"]
            HealthSrv["Health Probes<br/>8081/TCP HTTP<br/>No auth"]
        end
    end

    subgraph TrainingNS["TRAINING NAMESPACE ({user-namespace})<br/>NetworkPolicy: per-TrainJob isolation"]
        direction TB
        TrainingPod["Training Pod<br/>Framework: PyTorch/MPI/DeepSpeed/...<br/>Inter-pod: NCCL/MPI/gRPC"]
        InitDataset["Dataset Init Container<br/>Python / OpenDAL"]
        InitModel["Model Init Container<br/>Python / HuggingFace"]
    end

    subgraph MonitoringNS["MONITORING (openshift-monitoring)"]
        Prometheus["Prometheus<br/>SA: prometheus-k8s"]
    end

    subgraph OpenShiftPlatform["OPENSHIFT PLATFORM"]
        APIServerCfg["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile source"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HuggingFace["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS"]
        CloudStorage["Cloud Object Storage<br/>S3 / GCS / Azure<br/>443/TCP HTTPS"]
    end

    %% User flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User RBAC"| K8sAPI

    %% API Server to controller
    K8sAPI -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>mTLS"| WebhookSrv
    K8sAPI -.->|"WSS/6443<br/>Watch events<br/>ServiceAccount"| ControllerPod

    %% Controller to API
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>JobSet, PodGroup,<br/>NetworkPolicy CRUD"| K8sAPI

    %% Training pod to status server
    TrainingPod -->|"HTTPS/10443<br/>TLS (cluster profile)<br/>OIDC projected SA token"| StatusSrv

    %% Prometheus to metrics
    Prometheus -->|"HTTPS/8443<br/>TLS (cluster profile)<br/>Bearer + SAR"| MetricsSrv

    %% Controller reads TLS profile
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA (trainer-tls-profile)"| APIServerCfg

    %% Init containers to external
    InitDataset -->|"HTTPS/443<br/>TLS<br/>API token / cloud creds"| HuggingFace
    InitDataset -->|"HTTPS/443<br/>TLS<br/>Cloud provider creds"| CloudStorage
    InitModel -->|"HTTPS/443<br/>TLS<br/>API token"| HuggingFace

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8scontrol fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef training fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class K8sAPI k8scontrol
    class WebhookSrv,MetricsSrv,StatusSrv,HealthSrv controller
    class TrainingPod,InitDataset,InitModel training
    class Prometheus monitoring
    class APIServerCfg platform
    class HuggingFace,CloudStorage extsvc
