graph TD
    subgraph TestExecution["Test Execution RBAC"]
        TestSA["ServiceAccount<br/>(CI test runner)"]
        ClusterAdmin["ClusterRole: cluster-admin"]
        TestSA -->|"bound as"| ClusterAdmin
        ClusterAdmin -->|"full access"| AllResources["All API Resources<br/>(CRDs, Pods, Namespaces, etc.)"]
    end

    subgraph ExampleRBAC["Example/Workshop RBAC (Non-Production)"]
        direction TB

        subgraph SDExample["Stable Diffusion Example"]
            SDSA["ServiceAccount<br/>stable-diffusion-nb<br/>Namespace: distributed"]
            EditCR["ClusterRole: edit"]
            EditBinding["RoleBinding: edit"]
            SDSA -->|"bound via"| EditBinding
            EditBinding -->|"grants"| EditCR
            EditCR -->|"standard edit permissions"| SDResources["Pods, Services,<br/>Deployments, ConfigMaps, etc."]
        end

        subgraph NFSExample["NFS Server Example"]
            NFSSA["ServiceAccount<br/>nfs-server-sa<br/>Namespace: nfs"]

            AnyuidCR["ClusterRole<br/>system:openshift:scc:anyuid"]
            PrivilegedCR["ClusterRole<br/>system:openshift:scc:privileged"]

            AnyuidBinding["RoleBinding<br/>nfs-server-sa-anyuid"]
            PrivBinding["RoleBinding<br/>nfs-server-sa-privileged"]

            NFSSA -->|"bound via"| AnyuidBinding
            AnyuidBinding -->|"grants"| AnyuidCR
            AnyuidCR -->|"allows running<br/>as any UID"| NFSPod["NFS Server Pod"]

            NFSSA -->|"bound via"| PrivBinding
            PrivBinding -->|"grants"| PrivilegedCR
            PrivilegedCR -->|"allows privileged<br/>containers"| NFSPod
        end
    end

    subgraph Secrets["Secrets"]
        MinIOSecret["minio<br/>Type: Opaque<br/>MinIO credentials<br/>Auto-Rotate: No"]
        MinIOHPOSecret["minio-secret<br/>Type: Opaque<br/>MinIO HPO credentials<br/>Auto-Rotate: No"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        K8sAuth["Kubernetes API<br/>ServiceAccount Token"]
        S3Auth["S3 Storage<br/>AWS_ACCESS_KEY_ID /<br/>AWS_SECRET_ACCESS_KEY"]
        HFAuth["HuggingFace Hub<br/>HF_TOKEN Bearer"]
        SSHAuth["MPI SSH<br/>Auto-generated Keys"]
    end

    %% Note styling
    style TestExecution fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style ExampleRBAC fill:#f5f5f5,stroke:#999,stroke-width:1px,stroke-dasharray:5 5
    style Secrets fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style AuthMechanisms fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    style TestSA fill:#4a90e2,color:#fff
    style ClusterAdmin fill:#f44336,color:#fff
    style SDSA fill:#64b5f6
    style NFSSA fill:#64b5f6
    style EditCR fill:#f5a623
    style AnyuidCR fill:#f5a623
    style PrivilegedCR fill:#f5a623
    style MinIOSecret fill:#ff9800,color:#fff
    style MinIOHPOSecret fill:#ff9800,color:#fff
