graph TB
    subgraph ControlPlane["Control Plane (dc-controller-system namespace)"]
        Controller["dc-controller<br/>Go Operator<br/>controller-runtime v0.25.1"]
        ProfileWatcher["ProfileWatcher<br/>TLS Profile Monitor"]
        Controller --- ProfileWatcher
    end

    subgraph DataPlane["Data Plane (tenant namespace)"]
        subgraph RestPod["REST Service Pod"]
            KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>SAR Enforcement"]
            RestService["rest-service<br/>actix-web<br/>8080/TCP HTTP"]
            KubeRBACProxy -->|"localhost<br/>X-Remote-User<br/>X-Tenant-Id"| RestService
        end

        subgraph FlightPod["Flight Service Pod"]
            FlightService["flight-service<br/>tonic/Arrow Flight<br/>8443/TCP gRPC+TLS"]
            AuthLayer["AuthLayer<br/>Tower Middleware<br/>TokenReview + SAR"]
            AuthLayer --> FlightService
        end

        subgraph Connectors["Connector Registry (feature-gated)"]
            PGConn["postgres-connector<br/>SQLx"]
            S3Conn["s3-connector<br/>OpenDAL"]
            ESConn["elasticsearch-connector<br/>reqwest"]
            MilvusConn["milvus-connector<br/>reqwest"]
            Neo4jConn["neo4j-connector<br/>neo4rs"]
            SQLiteConn["sqlite-connector<br/>SQLx"]
            URIConn["uri-connector<br/>reqwest"]
        end

        FlightService --> Connectors
    end

    %% CRDs
    DataConnectServiceCR["DataConnectService CR<br/>dataconnecthub.opendatahub.io/v1alpha1"]
    InitDataConnectionCR["InitDataConnection CR"]
    InitDataConnectionTypeCR["InitDataConnectionType CR"]

    DataConnectServiceCR -->|"watched by"| Controller
    InitDataConnectionCR -->|"watched by"| Controller
    InitDataConnectionTypeCR -->|"watched by"| Controller
    Controller -->|"creates/manages"| RestPod
    Controller -->|"creates/manages"| FlightPod
    Controller -->|"creates"| HTTPRoute["HTTPRoute<br/>Gateway API"]
    Controller -->|"creates"| NetPol["NetworkPolicies"]
    Controller -->|"creates"| RBAC["ClusterRoles &<br/>Bindings"]

    %% Internal communication
    RestService -->|"gRPC/8443<br/>TLS + SA token"| FlightService

    %% External dependencies
    RestService -->|"5432/TCP"| PostgreSQL["PostgreSQL<br/>Metadata Store"]
    FlightService -->|"5432/TCP"| PostgreSQL

    KubeRBACProxy -->|"SAR/6443"| KubeAPI["kube-apiserver"]
    AuthLayer -->|"TokenReview+SAR/6443"| KubeAPI
    Controller -->|"Watch+CRUD/6443"| KubeAPI

    %% Platform dependencies
    HTTPRoute -->|"parentRef"| Gateway["odh-gateway<br/>Platform Gateway"]
    ProfileWatcher -->|"watches"| APIServer["OpenShift APIServer<br/>TLS Profile"]

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style ProfileWatcher fill:#4a90e2,color:#fff
    style RestService fill:#7ed321,color:#fff
    style KubeRBACProxy fill:#f5a623,color:#fff
    style FlightService fill:#7ed321,color:#fff
    style AuthLayer fill:#f5a623,color:#fff
    style DataConnectServiceCR fill:#e8e8e8
    style InitDataConnectionCR fill:#e8e8e8
    style InitDataConnectionTypeCR fill:#e8e8e8
    style PostgreSQL fill:#999,color:#fff
    style KubeAPI fill:#999,color:#fff
    style Gateway fill:#999,color:#fff
    style APIServer fill:#999,color:#fff
