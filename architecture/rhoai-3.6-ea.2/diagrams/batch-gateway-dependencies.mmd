graph LR
    BatchGW["Batch Gateway<br/>(apiserver + processor + gc)"]

    %% External Dependencies (required infrastructure)
    BatchGW -->|"metadata storage<br/>TCP"| PostgreSQL["PostgreSQL<br/>(pgx v5)"]
    BatchGW -->|"priority queue<br/>events, status<br/>TCP"| Redis["Redis/Valkey<br/>(go-redis v9)"]
    BatchGW -->|"file storage<br/>HTTP(S)"| S3["S3-compatible<br/>Storage<br/>(AWS SDK v2)"]

    %% Internal Platform Dependencies
    BatchGW -->|"inference dispatch<br/>HTTP(S), mTLS"| LLMdRouter["llm-d Router<br/>(inference gateway)"]
    BatchGW -.->|"async dispatch<br/>Go library"| LLMdAsync["llm-d-async<br/>(producer v0.9.1)"]

    %% Kubernetes Infrastructure
    BatchGW -->|"pod/sts watching<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]

    %% Observability
    BatchGW -.->|"traces<br/>OTLP/gRPC"| OTel["OpenTelemetry<br/>Collector"]
    BatchGW -.->|"metrics<br/>scrape"| Prometheus["Prometheus<br/>(via ServiceMonitor)"]

    %% Optional Infrastructure
    BatchGW -.->|"TLS certs"| CertManager["cert-manager"]
    BatchGW -.->|"external routing"| GatewayAPI["Gateway API<br/>(HTTPRoute)"]

    %% Authentication Gateway
    Kuadrant["Kuadrant/Authorino<br/>(auth gateway)"] -->|"authn/authz<br/>then forward"| BatchGW

    %% Integrating Components
    Client["API Client"] -->|"OpenAI-compatible<br/>batch API"| Kuadrant

    style BatchGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff
    style LLMdRouter fill:#7ed321,stroke:#333,color:#000
    style LLMdAsync fill:#7ed321,stroke:#333,color:#000
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#f5a623,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#333
