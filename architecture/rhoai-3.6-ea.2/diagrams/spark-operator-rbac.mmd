graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Ctrl["spark-operator-controller"]
        SA_Webhook["spark-operator-webhook"]
        SA_Module["spark-operator-module-<br/>controller-manager"]
        SA_Spark["spark-operator-spark<br/>(driver pods)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Ctrl["spark-operator-controller<br/>(ClusterRoleBinding)"]
        CRB_Webhook["spark-operator-webhook<br/>(ClusterRoleBinding)"]
        CRB_TLS["spark-operator-tls-profile<br/>(ClusterRoleBinding)"]
        CRB_Module["spark-operator-module-<br/>manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Ctrl["spark-operator-controller"]
        CR_Webhook["spark-operator-webhook"]
        CR_TLS["spark-operator-tls-profile"]
        CR_Module["spark-operator-module-<br/>manager-role"]
        CR_Editor["sparkapplication-editor-role"]
        CR_Viewer["sparkapplication-viewer-role"]
        CR_SchedEditor["scheduledsparkapplication-<br/>editor-role"]
        CR_SchedViewer["scheduledsparkapplication-<br/>viewer-role"]
    end

    subgraph ControllerResources["Controller Resources"]
        R_Pods["core: pods"]
        R_Services["core: services"]
        R_ConfigMaps["core: configmaps"]
        R_Events["core: events"]
        R_SparkApps["sparkoperator.k8s.io:<br/>sparkapplications"]
        R_SchedApps["sparkoperator.k8s.io:<br/>scheduledsparkapplications"]
        R_SparkConn["sparkoperator.k8s.io:<br/>sparkconnects"]
        R_CRDs["apiextensions.k8s.io:<br/>customresourcedefinitions"]
        R_Ingress["networking.k8s.io:<br/>ingresses"]
        R_PDB["policy:<br/>poddisruptionbudgets"]
    end

    subgraph WebhookResources["Webhook Resources"]
        R_Quotas["core: resourcequotas"]
        R_MWC["admissionregistration.k8s.io:<br/>mutatingwebhookconfigurations"]
        R_VWC["admissionregistration.k8s.io:<br/>validatingwebhookconfigurations"]
    end

    subgraph TLSResources["TLS Resources"]
        R_APIServer["config.openshift.io:<br/>apiservers"]
    end

    subgraph ModuleResources["Module Controller Resources"]
        R_SA["core: serviceaccounts"]
        R_NS["core: namespaces"]
        R_Deploy["apps: deployments"]
        R_Certs["cert-manager.io:<br/>certificates, issuers"]
        R_SparkOpCR["components.platform.opendatahub.io:<br/>sparkoperators"]
        R_RBAC["rbac.authorization.k8s.io:<br/>clusterroles, rolebindings"]
        R_NetPol["networking.k8s.io:<br/>networkpolicies"]
        R_PodMon["monitoring.coreos.com:<br/>podmonitors"]
    end

    %% Bindings
    SA_Ctrl -->|bound via| CRB_Ctrl
    SA_Ctrl -->|bound via| CRB_TLS
    SA_Webhook -->|bound via| CRB_Webhook
    SA_Webhook -->|bound via| CRB_TLS
    SA_Module -->|bound via| CRB_Module

    %% Role grants
    CRB_Ctrl -->|grants| CR_Ctrl
    CRB_Webhook -->|grants| CR_Webhook
    CRB_TLS -->|grants| CR_TLS
    CRB_Module -->|grants| CR_Module

    %% Controller permissions
    CR_Ctrl -->|"CRUD"| R_Pods
    CR_Ctrl -->|"CRUD"| R_Services
    CR_Ctrl -->|"CRUD"| R_ConfigMaps
    CR_Ctrl -->|"CRUD"| R_Events
    CR_Ctrl -->|"CRUD + watch"| R_SparkApps
    CR_Ctrl -->|"CRUD + watch"| R_SchedApps
    CR_Ctrl -->|"CRUD + watch"| R_SparkConn
    CR_Ctrl -->|"get"| R_CRDs
    CR_Ctrl -->|"CRUD"| R_Ingress
    CR_Ctrl -->|"CRUD + watch"| R_PDB

    %% Webhook permissions
    CR_Webhook -->|"list, watch"| R_Quotas
    CR_Webhook -->|"list, watch"| R_Pods
    CR_Webhook -->|"get, list, watch, update"| R_MWC
    CR_Webhook -->|"get, list, watch, update"| R_VWC
    CR_Webhook -->|"get, list, watch"| R_SparkApps

    %% TLS permissions
    CR_TLS -->|"get, list, watch"| R_APIServer

    %% Module permissions
    CR_Module -->|"full CRUD"| R_SA
    CR_Module -->|"full CRUD"| R_NS
    CR_Module -->|"full CRUD"| R_Deploy
    CR_Module -->|"full CRUD"| R_Certs
    CR_Module -->|"get, list, watch, patch, update"| R_SparkOpCR
    CR_Module -->|"full CRUD + bind, escalate"| R_RBAC
    CR_Module -->|"full CRUD"| R_NetPol
    CR_Module -->|"full CRUD"| R_PodMon
    CR_Module -->|"full CRUD"| R_MWC
    CR_Module -->|"full CRUD"| R_VWC

    %% Styling
    style SA_Ctrl fill:#4a90e2,color:#fff
    style SA_Webhook fill:#4a90e2,color:#fff
    style SA_Module fill:#6c5ce7,color:#fff
    style SA_Spark fill:#7ed321
    style CR_Ctrl fill:#f5a623
    style CR_Webhook fill:#f5a623
    style CR_TLS fill:#f5a623
    style CR_Module fill:#f5a623
    style CR_Editor fill:#f5a623
    style CR_Viewer fill:#f5a623
    style CR_SchedEditor fill:#f5a623
    style CR_SchedViewer fill:#f5a623
