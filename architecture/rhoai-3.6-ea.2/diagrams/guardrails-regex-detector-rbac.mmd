graph TD
    subgraph "RBAC Status"
        NoRBAC["No Kubernetes RBAC Resources<br/>Defined by This Component"]
    end

    subgraph "Access Control Model"
        direction TB
        NetworkIsolation["Network-Level Isolation<br/>(Expected: NetworkPolicy / Service Mesh)"]
        UpstreamAuth["Upstream Auth Delegation<br/>(FMS Guardrails Orchestrator)"]
    end

    subgraph "Component Endpoints"
        API["POST /api/v1/text/contents<br/>Auth: None"]
        Health["GET /health<br/>Auth: None"]
    end

    NetworkIsolation -->|"restricts access to"| API
    NetworkIsolation -->|"restricts access to"| Health
    UpstreamAuth -->|"enforces policy before<br/>calling"| API

    subgraph "Notes"
        Note1["No ServiceAccount defined in component"]
        Note2["No ClusterRoles or RoleBindings"]
        Note3["All RBAC delegated to platform"]
    end

    style NoRBAC fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#856404
    style NetworkIsolation fill:#d5e8d4,stroke:#82b366,color:#333
    style UpstreamAuth fill:#d5e8d4,stroke:#82b366,color:#333
    style API fill:#4a90e2,color:#fff
    style Health fill:#4a90e2,color:#fff
    style Note1 fill:#f9f9f9,stroke:#ccc,color:#666
    style Note2 fill:#f9f9f9,stroke:#ccc,color:#666
    style Note3 fill:#f9f9f9,stroke:#ccc,color:#666
