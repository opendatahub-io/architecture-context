graph TB
    subgraph CLI["thub CLI"]
        CLIMain["CLI Entry Point<br/>(training_hub.cli:main)"]
        YAMLConfig["YAML Config Loader"]
        DottedResolver["Dotted-Path Resolver<br/>(importlib)"]
        CLIMain --> YAMLConfig
        CLIMain --> DottedResolver
    end

    subgraph Core["Algorithm Registry (Strategy + Registry Pattern)"]
        Registry["AlgorithmRegistry"]
        AlgorithmABC["Algorithm ABC"]
        BackendABC["Backend ABC"]
        Registry -->|maps names to| AlgorithmABC
        Registry -->|maps backends to| BackendABC
    end

    subgraph Algorithms["Training Algorithms"]
        SFT["SFT<br/>(Supervised Fine-Tuning)"]
        OSFT["OSFT<br/>(Orthogonal Subspace FT)"]
        LoRASFT["LoRA + SFT"]
        LoRAGRPO["LoRA + GRPO"]
        GRPO["Full GRPO"]
        GEPA["GEPA<br/>(Gradient-Free Prompt Opt)"]
        EmbeddingSFT["Embedding SFT<br/>(Contrastive)"]
    end

    subgraph Backends["Backend Implementations"]
        ILab["InstructLab-Training<br/>(torchrun, multi-node)"]
        MiniTrainer["Mini-Trainer<br/>(FSDP)"]
        Unsloth["Unsloth<br/>(QLoRA)"]
        ART["ART / OpenPipe<br/>(single-GPU RLVR)"]
        Verl["verl / Volcano Engine RL<br/>(FSDP + vLLM)"]
        GEPALib["GEPA Library"]
        MLflowBackend["MLflow Backend"]
        SentenceT["SentenceTransformers"]
    end

    subgraph Adapters["Adapter Bridge Layer"]
        CallbackAdapter["TrainingHubCallback"]
        Serialize["Callback Serializer<br/>(inspect.getsource + base64)"]
        CallbackAdapter --> Serialize
    end

    subgraph Infrastructure["Infrastructure"]
        JIT["JIT Preemption Checkpoint<br/>(SIGTERM + all_reduce)"]
        CkptMgr["Checkpoint Manager<br/>(Remote Sync via fsspec)"]
        MemEstimator["GPU Memory Estimator"]
        LossViz["Loss Visualization"]
        JIT --> CkptMgr
    end

    %% CLI to Registry
    CLIMain -->|subcommand dispatch| Registry

    %% Registry to Algorithms
    Registry --> SFT
    Registry --> OSFT
    Registry --> LoRASFT
    Registry --> LoRAGRPO
    Registry --> GRPO
    Registry --> GEPA
    Registry --> EmbeddingSFT

    %% Algorithm to Backend mappings
    SFT -->|backend| ILab
    OSFT -->|backend| MiniTrainer
    LoRASFT -->|backend| Unsloth
    LoRAGRPO -->|backend| ART
    GRPO -->|backend| Verl
    GEPA -->|backend| GEPALib
    GEPA -->|backend| MLflowBackend
    EmbeddingSFT -->|backend| SentenceT

    %% Adapters connect to backends
    CallbackAdapter -.->|hooks| ILab
    CallbackAdapter -.->|hooks| MiniTrainer
    CallbackAdapter -.->|hooks| Unsloth
    CallbackAdapter -.->|hooks| ART

    %% Infrastructure connects to training
    JIT -.->|checkpoint on preemption| SFT
    JIT -.->|checkpoint on preemption| OSFT
    CkptMgr -.->|remote mirror| SFT
    CkptMgr -.->|remote mirror| OSFT

    %% Styling
    style Registry fill:#4a90e2,color:#fff
    style AlgorithmABC fill:#4a90e2,color:#fff
    style BackendABC fill:#4a90e2,color:#fff
    style CLIMain fill:#9b59b6,color:#fff
    style SFT fill:#27ae60,color:#fff
    style OSFT fill:#27ae60,color:#fff
    style LoRASFT fill:#27ae60,color:#fff
    style LoRAGRPO fill:#27ae60,color:#fff
    style GRPO fill:#27ae60,color:#fff
    style GEPA fill:#27ae60,color:#fff
    style EmbeddingSFT fill:#27ae60,color:#fff
    style ILab fill:#e67e22,color:#fff
    style MiniTrainer fill:#e67e22,color:#fff
    style Unsloth fill:#e67e22,color:#fff
    style ART fill:#e67e22,color:#fff
    style Verl fill:#e67e22,color:#fff
    style GEPALib fill:#e67e22,color:#fff
    style MLflowBackend fill:#e67e22,color:#fff
    style SentenceT fill:#e67e22,color:#fff
    style JIT fill:#e74c3c,color:#fff
    style CkptMgr fill:#e74c3c,color:#fff
    style CallbackAdapter fill:#f39c12,color:#fff
    style Serialize fill:#f39c12,color:#fff
