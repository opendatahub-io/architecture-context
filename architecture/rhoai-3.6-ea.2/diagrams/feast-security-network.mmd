graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(Notebook / ML Service)"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route<br/>443/TCP external<br/>TLS edge/passthrough<br/>Auth: K8s RBAC / OIDC / None"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Namespace-scoped)"]
        direction TB

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["Feast Operator<br/>SA: feast-operator-controller-manager<br/>Metrics: 8443/TCP HTTPS (self-signed)<br/>Health: 8081/TCP HTTP (unauth)"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            FS_Python["Feature Server (Python)<br/>SA: feast-{instance}-sa<br/>6566/TCP HTTP+gRPC<br/>Auth: TokenReview / OIDC / noAuth"]
            FS_Go["Feature Server (Go)<br/>6566/TCP HTTP+gRPC<br/>Auth: None (no middleware)"]
            CronJob["Materialization CronJob<br/>Image: ose-cli"]
        end

        subgraph DataStores["Data Stores (Configurable)"]
            Redis["Redis / Valkey<br/>TCP, Configurable TLS<br/>Password/TLS auth"]
            PostgreSQL["PostgreSQL<br/>TCP, Configurable TLS<br/>Username/password"]
        end
    end

    subgraph K8s["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        BigQuery["BigQuery API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Google credentials"]
        Snowflake["Snowflake<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth/key-pair"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Google credentials"]
    end

    %% External access
    Client -->|"HTTPS/443<br/>TLS configurable<br/>K8s RBAC / OIDC / None"| Route
    Route -->|"HTTP-gRPC/6566<br/>Configurable TLS"| FS_Python

    %% Internal data flows
    FS_Python -->|"TCP/Configured<br/>Configurable TLS<br/>Password"| Redis
    FS_Python -->|"TCP/Configured<br/>Configurable TLS<br/>Username/password"| PostgreSQL
    FS_Go -->|"TCP/Configured<br/>Backend creds"| Redis

    %% Materialization
    CronJob -->|"HTTP/6566<br/>ServiceAccount"| FS_Python

    %% Operator flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% External service flows
    FS_Python -->|"HTTPS/443<br/>TLS 1.2+<br/>Google creds"| BigQuery
    FS_Python -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth"| Snowflake
    FS_Python -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    FS_Python -->|"HTTPS/443<br/>TLS 1.2+<br/>Google creds"| GCS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Operator,FS_Python,CronJob internal
    class FS_Go warning
    class Redis,PostgreSQL datastore
    class K8sAPI k8s
    class BigQuery,Snowflake,S3,GCS extservice
