graph TD
    subgraph "Service Account"
        SA["kube-rbac-proxy<br/>(namespace: varies by deploying operator)"]
    end

    subgraph "ClusterRole Bindings"
        CRB["kube-rbac-proxy<br/>ClusterRoleBinding"]
    end

    subgraph "ClusterRoles"
        CR_Proxy["kube-rbac-proxy<br/>(ClusterRole)"]
        CR_Metrics["metrics<br/>(ClusterRole)"]
    end

    subgraph "API Resources"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Non-Resource URLs"
        MetricsURL["/metrics"]
    end

    subgraph "Hardcoded Authorization Bypass"
        HardcodedSA["system:serviceaccount:<br/>openshift-monitoring:<br/>prometheus-k8s"]
        HardcodedRule["GET /metrics<br/>ALWAYS ALLOWED<br/>(bypasses SAR)"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR_Proxy

    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR

    CR_Metrics -->|"get"| MetricsURL

    HardcodedSA -->|"hardcoded allow"| HardcodedRule

    style SA fill:#4a90e2,color:#fff
    style CRB fill:#b8d4f0
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style MetricsURL fill:#7ed321,color:#fff
    style HardcodedSA fill:#d0021b,color:#fff
    style HardcodedRule fill:#d0021b,color:#fff
