graph TD
    subgraph Container["vllm-gaudi Container"]
        User["Non-root User<br/>UID 2000"]
        Process["vLLM API Server Process"]
        User -->|runs as| Process
    end

    subgraph PlatformRBAC["Platform-Managed RBAC"]
        direction TB
        KServeSA["KServe ServiceAccount"]
        ODHModelSA["odh-model-controller<br/>ServiceAccount"]
    end

    subgraph PlatformRoles["Platform-Managed Roles"]
        KServeRole["KServe ClusterRole<br/>(manages ServingRuntimes)"]
        ODHModelRole["odh-model-controller Role<br/>(manages deployments)"]
    end

    subgraph AuthEnforcement["Authentication Enforcement"]
        IstioAuth["Istio AuthorizationPolicy<br/>(Platform-managed)"]
        KubeRBACProxy["kube-rbac-proxy<br/>(Optional sidecar)"]
        OAuthProxy["OpenShift OAuth Proxy<br/>(Optional)"]
    end

    subgraph Resources["Kubernetes Resources"]
        ServingRuntime["ServingRuntime CR"]
        Deployment["Deployment"]
        Service["Service"]
        ConfigMap["ConfigMap"]
    end

    KServeSA -->|bound to| KServeRole
    ODHModelSA -->|bound to| ODHModelRole
    KServeRole -->|"get,list,watch,create,<br/>update,patch,delete"| ServingRuntime
    ODHModelRole -->|"get,list,watch,create,<br/>update,patch,delete"| Deployment
    ODHModelRole -->|"get,list,watch,create,<br/>update,patch,delete"| Service

    IstioAuth -->|"enforces auth on"| Process
    KubeRBACProxy -.->|"optional auth proxy"| Process
    OAuthProxy -.->|"optional auth proxy"| Process

    Note["⚠ No RBAC definitions in this repository<br/>All RBAC is managed by<br/>KServe and odh-model-controller"]

    style User fill:#4a90e2,color:#fff
    style Process fill:#4a90e2,color:#fff
    style KServeSA fill:#7ed321,color:#fff
    style ODHModelSA fill:#7ed321,color:#fff
    style KServeRole fill:#f5a623,color:#fff
    style ODHModelRole fill:#f5a623,color:#fff
    style IstioAuth fill:#e74c3c,color:#fff
    style KubeRBACProxy fill:#e74c3c,color:#fff
    style OAuthProxy fill:#e74c3c,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
