graph TD
    subgraph "Container Identity"
        Container["vLLM Container<br/>UID: 2000<br/>GID: 0 (root group)<br/>Non-root, OpenShift compatible"]
    end

    subgraph "Application-Level Auth"
        direction TB
        AuthMW["Auth Middleware<br/>(ASGI AuthenticationMiddleware)"]
        TokenCheck["Token Validation<br/>SHA-256 hash + secrets.compare_digest"]
    end

    subgraph "Guarded Paths (Bearer Token Required)"
        V1["All /v1/* endpoints<br/>(chat, completions, embeddings,<br/>models, responses, messages,<br/>score, rerank, audio, lora)"]
        V2["All /v2/* endpoints<br/>(embed, rerank)"]
        Inference["All /inference/* endpoints<br/>(disaggregated inference)"]
    end

    subgraph "Unguarded Paths (Always Open)"
        Health["/health, /ready, /readyz"]
        Ops["/load, /version, /docs"]
        Legacy["/generate, /score, /rerank,<br/>/classify, /pooling"]
        Tokenizer["/tokenize, /detokenize,<br/>/tokenizer_info"]
        SageMaker["/ping, /invocations"]
        Admin["/abort_requests,<br/>/start_profile, /stop_profile"]
        Elastic["/scale_elastic_ep,<br/>/is_scaling_elastic_ep"]
    end

    subgraph "Secrets (Environment Variables)"
        VLLM_API_KEY["VLLM_API_KEY<br/>Bearer token for API auth<br/>No auto-rotation"]
        S3_KEY["S3_SECRET_ACCESS_KEY<br/>S3 storage access"]
        HF_TOKEN["HF_TOKEN<br/>HuggingFace Hub auth"]
        OTHER_KEYS["OPENAI_API_KEY<br/>MODELSCOPE_API_TOKEN<br/>EXA_API_KEY<br/>GH_TOKEN"]
    end

    Container -->|"runs"| AuthMW
    AuthMW -->|"validates"| TokenCheck
    TokenCheck -->|"guards"| V1
    TokenCheck -->|"guards"| V2
    TokenCheck -->|"guards"| Inference

    VLLM_API_KEY -->|"provides token"| TokenCheck
    S3_KEY -->|"S3 access"| Container
    HF_TOKEN -->|"model download"| Container
    OTHER_KEYS -->|"various integrations"| Container

    style Container fill:#4a90e2,color:#fff
    style AuthMW fill:#f5a623,color:#fff
    style TokenCheck fill:#f5a623,color:#fff
    style VLLM_API_KEY fill:#e74c3c,color:#fff
    style S3_KEY fill:#e74c3c,color:#fff
    style HF_TOKEN fill:#e74c3c,color:#fff
    style OTHER_KEYS fill:#e74c3c,color:#fff
    style V1 fill:#7ed321,color:#fff
    style V2 fill:#7ed321,color:#fff
    style Inference fill:#7ed321,color:#fff
    style Health fill:#ddd,stroke:#999
    style Ops fill:#ddd,stroke:#999
    style Legacy fill:#ddd,stroke:#999
    style Tokenizer fill:#ddd,stroke:#999
    style SageMaker fill:#ddd,stroke:#999
    style Admin fill:#ddd,stroke:#999
    style Elastic fill:#ddd,stroke:#999
