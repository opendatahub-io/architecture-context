graph TB
    subgraph ODHObservability["odh-observability Operator"]
        Controller["odh-observability Controller<br/>(Go controller-runtime)<br/>Reconciles Monitoring CR"]
        Webhook["Mutating Admission Webhook<br/>9443/TCP HTTPS<br/>Label injection on<br/>ServiceMonitor/PodMonitor"]
        Templates["Embedded Go Templates<br/>(45 tmpl.yaml files)<br/>SSA Deploy via odh-platform-utilities"]
        GC["Label-based Garbage Collector<br/>platform.opendatahub.io/part-of=monitoring"]
        Controller --> Templates
        Controller --> GC
    end

    User[Platform Admin] -->|creates| MonitoringCR["Monitoring CR<br/>(Cluster-scoped, singleton)<br/>services.platform.opendatahub.io/v1alpha1"]
    MonitoringCR -->|watched by| Controller

    subgraph ManagedMetrics["Managed: Metrics Subsystem"]
        MonitoringStack["MonitoringStack<br/>(Prometheus)"]
        ThanosQuerier["ThanosQuerier"]
        ClusterProxy["data-science-prometheus<br/>-cluster-proxy<br/>(kube-rbac-proxy)<br/>8443/TCP HTTPS"]
        NSProxy["data-science-prometheus<br/>-namespace-proxy<br/>(kube-rbac-proxy +<br/>prom-label-proxy)<br/>8443/TCP HTTPS"]
    end

    subgraph ManagedTracing["Managed: Tracing Subsystem"]
        Tempo["TempoMonolithic /<br/>TempoStack"]
    end

    subgraph ManagedTelemetry["Managed: Telemetry Pipeline"]
        OTelCollector["OpenTelemetryCollector<br/>OTLP: 4317/4318<br/>Metrics: 8889/8890"]
    end

    subgraph ManagedDashboards["Managed: Dashboards"]
        Perses["Perses + Datasource<br/>+ Dashboards"]
    end

    subgraph ManagedLogs["Managed: Logs Subsystem"]
        LokiStack["LokiStack"]
        CLF["ClusterLogForwarder"]
    end

    subgraph ManagedCorrelation["Managed: Correlation"]
        Korrel8r["Korrel8r<br/>8443/TCP HTTPS<br/>Cross-signal correlation"]
    end

    Controller -->|creates/manages| MonitoringStack
    Controller -->|creates/manages| ThanosQuerier
    Controller -->|creates/manages| ClusterProxy
    Controller -->|creates/manages| NSProxy
    Controller -->|creates/manages| Tempo
    Controller -->|creates/manages| OTelCollector
    Controller -->|creates/manages| Perses
    Controller -->|creates/manages| LokiStack
    Controller -->|creates/manages| CLF
    Controller -->|creates/manages| Korrel8r

    KubeAPI[kube-apiserver] -->|admission call| Webhook

    Controller -->|reads TLS profile| APIServer["OpenShift APIServer Config"]
    Controller -->|checks CRD presence| Discovery["API Discovery<br/>(graceful degradation)"]

    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style Templates fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style MonitoringCR fill:#f5a623,color:#fff
    style MonitoringStack fill:#7ed321,color:#fff
