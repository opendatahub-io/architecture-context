graph TB
    subgraph Manager["Manager Binary (cmd/main.go)"]
        direction TB
        Registry["Service Registry<br/>(Dynamic Controller Registration)"]

        subgraph Controllers["Controller Domains"]
            direction LR
            TASCtrl["TrustyAIService<br/>Controller"]
            EvalHubCtrl["EvalHub<br/>Controller"]
            LMEvalCtrl["LMEvalJob<br/>Controller"]
            GOrchCtrl["GuardrailsOrchestrator<br/>Controller"]
            NemoCtrl["NemoGuardrails<br/>Controller"]
        end

        subgraph Support["Support Controllers"]
            direction LR
            ProfileWatcher["ProfileWatcher<br/>(TLS Profile)"]
            JobFailure["Job Failure<br/>Reconciler"]
            KueueReconciler["Kueue Workload<br/>Reconciler"]
        end

        subgraph Servers["Server Infrastructure"]
            direction LR
            Metrics["Metrics Server<br/>8443/TCP HTTPS"]
            Health["Health Probes<br/>8081/TCP HTTP"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS"]
        end

        Registry --> Controllers
        Registry --> Support
    end

    subgraph Module["trustyai-operator-module"]
        ModuleCtrl["TrustyAI Module<br/>Controller"]
    end

    subgraph Driver["lmes-driver"]
        DriverBin["LMES Driver<br/>(Job Coordinator)"]
    end

    %% CRDs
    TrustyAIServiceCR["TrustyAIService CR"]
    EvalHubCR["EvalHub CR"]
    LMEvalJobCR["LMEvalJob CR"]
    GOrchCR["GuardrailsOrchestrator CR"]
    NemoCR["NemoGuardrails CR"]
    TrustyAICR["TrustyAI CR<br/>(Cluster-scoped)"]

    %% CRD → Controller relationships
    TrustyAIServiceCR -->|watched by| TASCtrl
    EvalHubCR -->|watched by| EvalHubCtrl
    LMEvalJobCR -->|watched by| LMEvalCtrl
    GOrchCR -->|watched by| GOrchCtrl
    NemoCR -->|watched by| NemoCtrl
    TrustyAICR -->|watched by| ModuleCtrl

    %% Controller outputs
    TASCtrl -->|creates| TASDeployment["Deployment +<br/>kube-rbac-proxy sidecar"]
    TASCtrl -->|creates| TASRoute["Route / VirtualService"]
    EvalHubCtrl -->|creates| EvalHubDeploy["EvalHub Deployment"]
    EvalHubCtrl -->|propagates| TenantRBAC["Tenant RBAC +<br/>ConfigMaps"]
    LMEvalCtrl -->|creates| EvalJob["Evaluation Job +<br/>Driver Sidecar"]
    GOrchCtrl -->|creates| GOrchDeploy["Guardrails Deployment"]
    NemoCtrl -->|creates| NemoDeploy["NeMo Deployment"]

    %% Driver relationship
    EvalJob -->|runs| DriverBin

    %% External dependencies
    TASCtrl -->|watches| KServeIS["KServe<br/>InferenceService"]
    GOrchCtrl -->|watches| KServeIS
    LMEvalCtrl -->|integrates| Kueue["Kueue"]
    EvalHubCtrl -->|creates| MLflow["MLflow Experiments"]
    TASCtrl -->|creates| IstioVS["Istio VirtualService"]
    ProfileWatcher -->|watches| APIServer["OpenShift<br/>APIServer Config"]

    %% Styling
    style Manager fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Module fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Driver fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style TASCtrl fill:#4a90e2,color:#fff
    style EvalHubCtrl fill:#4a90e2,color:#fff
    style LMEvalCtrl fill:#4a90e2,color:#fff
    style GOrchCtrl fill:#4a90e2,color:#fff
    style NemoCtrl fill:#4a90e2,color:#fff
    style ModuleCtrl fill:#7ed321,color:#fff
    style DriverBin fill:#f5a623,color:#fff
    style TrustyAIServiceCR fill:#f5a623
    style EvalHubCR fill:#f5a623
    style LMEvalJobCR fill:#f5a623
    style GOrchCR fill:#f5a623
    style NemoCR fill:#f5a623
    style TrustyAICR fill:#f5a623
    style KServeIS fill:#e8e8e8
    style Kueue fill:#e8e8e8
    style MLflow fill:#e8e8e8
    style IstioVS fill:#e8e8e8
    style APIServer fill:#e8e8e8
