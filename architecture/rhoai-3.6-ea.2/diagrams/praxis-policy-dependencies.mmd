graph LR
    PPE["Praxis Policy Engine<br/>(praxis-policy v0.4.1)"]

    %% Host (embeds PPE)
    PraxisProxy["Praxis Proxy"] -->|"embeds as library<br/>(in-process)"| PPE

    %% Core Runtime Dependencies (required)
    PPE -->|"async runtime"| Tokio["tokio 1.x"]
    PPE -->|"serialization"| Serde["serde / serde_json /<br/>serde_yaml"]
    PPE -->|"observability"| Tracing["tracing 0.1.x"]
    PPE -->|"error handling"| Thiserror["thiserror 2.x"]
    PPE -->|"credential zeroing"| Zeroize["zeroize 1.9.x"]

    %% Crypto Dependencies
    PPE -->|"content digests"| SHA2["sha2 0.11.x"]
    PPE -->|"keyed digests"| HMAC["hmac 0.13.x"]

    %% Feature-gated: PDP Backends
    PPE -.->|"feature: cedar"| CedarPolicy["cedar-policy 4.x"]
    PPE -.->|"feature: cel"| CEL["cel 0.14.5"]
    PPE -.->|"feature: opa"| Regorus["regorus 0.12.x<br/>(embedded OPA)"]

    %% Feature-gated: Identity
    PPE -.->|"feature: jwt"| JSONWebToken["jsonwebtoken 11.x<br/>(aws-lc-rs backend)"]

    %% Feature-gated: TLS / HTTP
    PPE -.->|"feature: http-hyper"| Rustls["rustls 0.23.x<br/>(ring backend)"]
    PPE -.->|"feature: http-hyper"| HyperUtil["hyper-util 0.1"]
    PPE -.->|"feature: http-hyper"| WebPKI["webpki-roots 1.x"]

    %% Feature-gated: Storage
    PPE -.->|"feature: valkey"| Redis["redis 1.7.x<br/>(rustls TLS)"]
    PPE -.->|"feature: valkey"| Deadpool["deadpool-redis 0.23.x"]
    PPE -.->|"feature: oauth"| Moka["moka 0.12.x<br/>(bounded cache)"]

    %% Feature-gated: Safety
    PPE -.->|"PDP features"| Stacker["stacker 0.1.x<br/>(stack-growth guard)"]

    %% External Services (runtime)
    PPE -->|"JWKS fetch<br/>HTTPS/443"| IdP["Identity Provider"]
    PPE -->|"token exchange<br/>HTTPS/443"| IdPToken["IdP Token Endpoint"]
    PPE -.->|"session store<br/>Redis/6379"| Valkey["Valkey / Redis"]
    PPE -.->|"secrets<br/>HTTPS/8200"| Vault["HashiCorp Vault"]
    PPE -.->|"quota<br/>HTTP"| Limitador["Limitador"]

    %% Styling
    style PPE fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PraxisProxy fill:#7ed321,stroke:#333

    %% Required dependencies
    style Tokio fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style Tracing fill:#999,stroke:#333
    style Thiserror fill:#999,stroke:#333
    style Zeroize fill:#999,stroke:#333
    style SHA2 fill:#999,stroke:#333
    style HMAC fill:#999,stroke:#333

    %% Feature-gated dependencies
    style CedarPolicy fill:#f5a623,stroke:#333
    style CEL fill:#f5a623,stroke:#333
    style Regorus fill:#f5a623,stroke:#333
    style JSONWebToken fill:#f5a623,stroke:#333
    style Rustls fill:#f5a623,stroke:#333
    style HyperUtil fill:#f5a623,stroke:#333
    style WebPKI fill:#f5a623,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style Deadpool fill:#f5a623,stroke:#333
    style Moka fill:#f5a623,stroke:#333
    style Stacker fill:#f5a623,stroke:#333

    %% External services
    style IdP fill:#e8e8e8,stroke:#333
    style IdPToken fill:#e8e8e8,stroke:#333
    style Valkey fill:#e8e8e8,stroke:#333
    style Vault fill:#e8e8e8,stroke:#333
    style Limitador fill:#e8e8e8,stroke:#333
