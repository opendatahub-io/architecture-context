graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Application["APPLICATION (Agentic RAG Starter Kit)"]
        direction TB

        AuthWrapper["auth_wrapper<br/>ASGI Middleware<br/>8080/TCP<br/>Bearer / X-Api-Key"]
        FastAPI["FastAPI Service<br/>POST /v1/responses<br/>GET /health<br/>Non-root UID 1001"]
        Agent["LangChain Agent<br/>rewrite_query + retriever<br/>Per-invocation isolation"]

        AuthWrapper --> FastAPI
        FastAPI --> Agent
    end

    subgraph CoreLib["ai4rag CORE LIBRARY (in-process)"]
        direction TB

        Experiment["AI4RAGExperiment<br/>HPO Orchestrator"]
        URLPolicy["URL Trust Policy<br/>ensure_safe_url&#40;&#41;<br/>No unverified-TLS fallback"]
        Docling["Docling Chunker"]
        Evaluator["RAGAS / Unitxt<br/>Evaluator"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MaaS["OpenAI-compatible MaaS<br/>HTTPS / TLS verified<br/>Auth: API key"]
        S3["AWS S3-compatible<br/>HTTPS / TLS verified<br/>Auth: AWS IAM"]
        Milvus["Milvus<br/>19530/TCP gRPC<br/>TLS verified<br/>Auth: Token"]
        PGVector["PostgreSQL/pgvector<br/>5432/TCP<br/>TLS via ssl.create_default_context<br/>Auth: Password"]
        Neo4j["Neo4j<br/>7687/TCP Bolt+TLS<br/>Auth: Password"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS CA verified<br/>Auth: Bearer"]
    end

    %% External to Application
    Client -->|"HTTP/8080<br/>Bearer token<br/>(K8s SA)"| AuthWrapper

    %% Auth to K8s
    AuthWrapper -->|"HTTPS/443<br/>TLS CA verified<br/>TokenReview"| K8sAPI

    %% Agent egress
    Agent -->|"HTTPS<br/>TLS verified<br/>API key"| MaaS
    Agent -->|"TLS<br/>Token/Password"| Milvus
    Agent -->|"TLS<br/>Password"| PGVector

    %% Core library egress
    Experiment -->|"HTTPS<br/>TLS verified<br/>API key"| MaaS
    Experiment -->|"HTTPS<br/>TLS verified<br/>AWS IAM"| S3
    Experiment -->|"gRPC/TLS<br/>Token"| Milvus
    Experiment -->|"TLS<br/>Password"| PGVector
    Experiment -->|"Bolt+TLS<br/>Password"| Neo4j

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef corelib fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class AuthWrapper,FastAPI,Agent application
    class Experiment,Docling,Evaluator corelib
    class URLPolicy security
    class MaaS,S3,Milvus,PGVector,Neo4j,K8sAPI externalservice
