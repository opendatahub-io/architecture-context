graph TD
    subgraph "Authentication Flow (No In-Repo RBAC)"
        direction TB

        User["Data Scientist<br/>(User Browser)"]

        subgraph OAuthFlow["OpenShift OAuth Flow"]
            OAuthServer["OpenShift OAuth Server<br/>Identity Provider"]
            OAuthToken["OAuth Token<br/>user identity"]
        end

        subgraph PodSecurity["Workbench Pod Security (Injected by Notebook Controller)"]
            direction TB

            KubeRBAC["kube-rbac-proxy Sidecar<br/>Port: 8443/TCP<br/>Injected by: ODH Notebook Controller<br/>Mutating Webhook"]

            subgraph Checks["Authorization Checks"]
                TokenValidation["Token Validation<br/>Verify OAuth token<br/>with OpenShift API"]
                OwnerCheck["Owner Check<br/>Only workbench creator<br/>can access"]
            end

            KubeRBAC --> TokenValidation
            KubeRBAC --> OwnerCheck
        end

        subgraph Backends["Protected Backends (No Internal Auth)"]
            Jupyter["JupyterLab<br/>8888/TCP HTTP<br/>No auth enforcement"]
            CodeSrv["Code-Server<br/>80/TCP HTTP<br/>No auth enforcement"]
        end

        subgraph InjectedConfig["Security Config (Injected at Pod Creation)"]
            CABundle["CA Certificate Bundle<br/>/etc/pki/tls/custom-certs/<br/>ca-bundle.crt"]
            ElyraConfig["Elyra Runtime ConfigMaps<br/>Pipeline connection config"]
            DSPASecret["DSPA Secrets<br/>/opt/app-root/runtimes/<br/>Bearer tokens for pipelines"]
        end
    end

    %% Flow
    User -->|"1. Login via<br/>OpenShift OAuth"| OAuthServer
    OAuthServer -->|"2. Issue token"| OAuthToken
    User -->|"3. Request with<br/>OAuth token"| KubeRBAC
    KubeRBAC -->|"4. Authorized<br/>HTTP (pod-local)"| Jupyter
    KubeRBAC -->|"4. Authorized<br/>HTTP (pod-local)"| CodeSrv

    %% Injected config
    CABundle -.->|mounted into| Backends
    ElyraConfig -.->|mounted into| Backends
    DSPASecret -.->|mounted into| Backends

    subgraph NotebookController["ODH Notebook Controller"]
        Webhook["Mutating Admission Webhook<br/>Injects all security components"]
    end

    Webhook -.->|"injects sidecar"| KubeRBAC
    Webhook -.->|"injects config"| InjectedConfig

    %% Styling
    style User fill:#08427b,color:#fff
    style KubeRBAC fill:#f8cecc,stroke:#b85450,stroke-width:3px
    style TokenValidation fill:#f8cecc,stroke:#b85450
    style OwnerCheck fill:#f8cecc,stroke:#b85450
    style Jupyter fill:#d5e8d4,stroke:#82b366
    style CodeSrv fill:#d5e8d4,stroke:#82b366
    style OAuthServer fill:#dae8fc,stroke:#6c8ebf
    style OAuthToken fill:#dae8fc,stroke:#6c8ebf
    style CABundle fill:#fff2cc,stroke:#d6b656
    style ElyraConfig fill:#fff2cc,stroke:#d6b656
    style DSPASecret fill:#fff2cc,stroke:#d6b656
    style Webhook fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
