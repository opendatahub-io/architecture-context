graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["kubeflow-trainer-controller-manager<br/>Namespace: opendatahub"]
        SA_Prometheus["prometheus-k8s<br/>Namespace: openshift-monitoring"]
        SA_Auth["system:authenticated<br/>(Group)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Main["kubeflow-trainer-controller-manager<br/>(ClusterRoleBinding)"]
        CRB_TLS["trainer-tls-profile<br/>(ClusterRoleBinding)"]
        CRB_Metrics["trainer-metrics-reader<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Public["kubeflow-trainer-public<br/>(RoleBinding, ns: opendatahub)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Main["kubeflow-trainer-controller-manager<br/>(ClusterRole, 14 rules)"]
        CR_TLS["trainer-tls-profile<br/>(ClusterRole)"]
        CR_MetricsReader["trainer-metrics-reader<br/>(ClusterRole)"]
        CR_View["training-view<br/>(aggregate ClusterRole)"]
        CR_Edit["training-edit<br/>(aggregate ClusterRole)"]
        CR_Admin["training-admin<br/>(aggregate ClusterRole)"]
    end

    subgraph Roles["Roles"]
        R_Public["kubeflow-trainer-public<br/>(Role, ns: opendatahub)"]
    end

    subgraph APIResources["API Resources"]
        direction TB
        TrainJob["trainer.kubeflow.org<br/>TrainJob<br/>+ finalizers, status"]
        TrainingRuntime["trainer.kubeflow.org<br/>TrainingRuntime<br/>+ finalizers, status"]
        ClusterTrainingRuntime["trainer.kubeflow.org<br/>ClusterTrainingRuntime<br/>+ finalizers, status"]
        JobSets["jobset.x-k8s.io<br/>JobSet"]
        PodGroups["scheduling.volcano.sh<br/>scheduling.x-k8s.io<br/>PodGroup"]
        NetworkPolicies["networking.k8s.io<br/>NetworkPolicy"]
        CoreResources["core<br/>ConfigMaps, Secrets,<br/>Events, Pods, LimitRanges"]
        WebhookConfigs["admissionregistration.k8s.io<br/>Webhook Configurations"]
        AuthResources["authentication/authorization<br/>TokenReview, SAR"]
        Leases["coordination.k8s.io<br/>Leases"]
        RuntimeClasses["node.k8s.io<br/>RuntimeClasses"]
        APIServers["config.openshift.io<br/>APIServers"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
        PublicCM["core<br/>ConfigMap: kubeflow-trainer-public"]
    end

    %% Controller SA bindings
    SA_Controller -->|"bound via"| CRB_Main
    CRB_Main -->|"grants"| CR_Main
    SA_Controller -->|"bound via"| CRB_TLS
    CRB_TLS -->|"grants"| CR_TLS

    %% Prometheus SA bindings
    SA_Prometheus -->|"bound via"| CRB_Metrics
    CRB_Metrics -->|"grants"| CR_MetricsReader

    %% Authenticated users
    SA_Auth -->|"bound via"| RB_Public
    RB_Public -->|"grants"| R_Public

    %% Controller ClusterRole permissions
    CR_Main -->|"get,list,watch,<br/>create,update,patch"| TrainJob
    CR_Main -->|"get,list,watch,<br/>update,patch"| TrainingRuntime
    CR_Main -->|"get,list,watch,<br/>update,patch"| ClusterTrainingRuntime
    CR_Main -->|"full CRUD"| JobSets
    CR_Main -->|"create,get,list,<br/>patch,update,watch"| PodGroups
    CR_Main -->|"create,get,list,<br/>patch,update,watch"| NetworkPolicies
    CR_Main -->|"create,get,list,<br/>patch,update,watch"| CoreResources
    CR_Main -->|"get,list,<br/>update,watch"| WebhookConfigs
    CR_Main -->|"create"| AuthResources
    CR_Main -->|"create,get,<br/>list,update"| Leases
    CR_Main -->|"get,list,watch"| RuntimeClasses

    %% TLS profile role
    CR_TLS -->|"get,list,watch"| APIServers

    %% Metrics reader role
    CR_MetricsReader -->|"get"| MetricsURL

    %% Public role
    R_Public -->|"get,list,watch"| PublicCM

    %% Aggregate roles (user-facing)
    CR_View -->|"get,list,watch"| TrainJob
    CR_View -->|"get,list,watch"| TrainingRuntime
    CR_View -->|"get,list,watch"| ClusterTrainingRuntime
    CR_Edit -->|"CRUD trainjobs<br/>read runtimes"| TrainJob
    CR_Admin -->|"full CRUD"| TrainJob
    CR_Admin -->|"full CRUD"| TrainingRuntime
    CR_Admin -->|"full CRUD"| ClusterTrainingRuntime

    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Prometheus fill:#4a90e2,stroke:#333,color:#fff
    style SA_Auth fill:#4a90e2,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333
    style CR_TLS fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style CR_View fill:#50e3c2,stroke:#333
    style CR_Edit fill:#50e3c2,stroke:#333
    style CR_Admin fill:#50e3c2,stroke:#333
    style R_Public fill:#f5a623,stroke:#333
    style TrainJob fill:#7ed321,stroke:#333
    style TrainingRuntime fill:#7ed321,stroke:#333
    style ClusterTrainingRuntime fill:#7ed321,stroke:#333
    style JobSets fill:#7ed321,stroke:#333
    style PodGroups fill:#7ed321,stroke:#333
    style NetworkPolicies fill:#7ed321,stroke:#333
    style CoreResources fill:#7ed321,stroke:#333
    style WebhookConfigs fill:#7ed321,stroke:#333
    style AuthResources fill:#7ed321,stroke:#333
    style Leases fill:#7ed321,stroke:#333
    style RuntimeClasses fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
    style MetricsURL fill:#7ed321,stroke:#333
    style PublicCM fill:#7ed321,stroke:#333
