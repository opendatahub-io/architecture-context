graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Producer["External Producer"]
        Consumer["External Consumer"]
    end

    subgraph Broker["MESSAGE BROKER (Shared Infrastructure)"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>Optional TLS (rediss://)<br/>URL Credentials"]
        GCPPubSub["GCP Pub/Sub<br/>443/TCP gRPC<br/>TLS<br/>GCP IAM"]
    end

    subgraph Cluster["CLUSTER INTERNAL (Pod Network)"]
        direction TB

        subgraph APPod["Async Processor Pod<br/>runAsNonRoot, seccompProfile, drop ALL"]
            AP["async-processor<br/>SA: llm-d-async"]
            Health["Health Server<br/>:8081/TCP HTTP<br/>No Auth (kubelet)"]
            Metrics["Metrics Server<br/>:9090/TCP HTTP<br/>Optional kube-rbac-proxy"]
        end

        Router["llm-d-router<br/>Inference Gateway"]
        Prom["Prometheus"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTLP["OTLP Collector<br/>gRPC<br/>Optional TLS"]
    end

    %% Inbound to broker
    Producer -->|"Redis: 6379/TCP<br/>Optional TLS<br/>URL creds"| Redis
    Producer -->|"gRPC: 443/TCP<br/>TLS<br/>GCP IAM"| GCPPubSub

    %% Broker to AP (pull)
    Redis -->|"Pull: Redis protocol<br/>Optional TLS<br/>URL creds"| AP
    GCPPubSub -->|"Pull: gRPC<br/>TLS<br/>GCP IAM"| AP

    %% AP egress
    AP -->|"HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>Optional Bearer"| Router
    AP -->|"HTTP<br/>No encryption<br/>No auth"| Prom
    AP -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    AP -->|"gRPC<br/>Optional TLS<br/>No auth"| OTLP

    %% Result writes
    AP -->|"Results: 6379/TCP<br/>Optional TLS<br/>URL creds"| Redis
    Consumer -->|"Read results<br/>Optional TLS"| Redis

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef broker fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef processor fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Producer,Consumer external
    class Redis,GCPPubSub broker
    class Router,Prom,K8sAPI cluster
    class AP,Health,Metrics processor
    class OTLP observability
