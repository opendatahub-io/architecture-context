graph LR
    MRO["Model Registry<br/>Operator"]

    %% External Dependencies (build/runtime)
    MRO -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.25.0"]
    MRO -->|"K8s API types"| K8sAPI["k8s.io/api<br/>v0.37.0"]
    MRO -->|"K8s client"| K8sClientGo["k8s.io/client-go<br/>v0.37.0"]
    MRO -->|"HTTPRoute mgmt"| GatewayAPI["gateway-api<br/>v1.6.2"]
    MRO -->|"OpenShift types"| OSApi["openshift/api<br/>Route, Config, User"]
    MRO -->|"TLS profile mgmt"| OSControllerCommon["openshift/controller-<br/>runtime-common"]
    MRO -->|"scheme registration"| IstioClient["istio/client-go<br/>v1.31.0"]
    MRO -->|"object diff/match"| ObjectMatcher["k8s-objectmatcher<br/>v1.8.0"]

    %% Internal Platform Dependencies
    MRO -->|"platform detection,<br/>manifest rendering"| PlatformUtils["odh-platform-<br/>utilities"]
    MRO -->|"HTTPRoute CRUD<br/>8443/TCP"| DSGateway["data-science-<br/>gateway"]
    MRO -->|"Route CRUD<br/>TLS passthrough"| OSRoutes["OpenShift Routes"]
    MRO -->|"user group mgmt<br/>REST API"| OSUsers["OpenShift<br/>Users/Groups"]
    MRO -->|"catalog RBAC config<br/>CRD watch"| PlatformAuth["Platform Auth<br/>Service"]

    %% Deployment dependency
    OdhOperator["ODH/RHOAI<br/>Operator"] -->|"deploys via<br/>kustomize overlay"| MRO

    %% Created component dependencies
    MRO -.->|"deploys"| RegistryServer["model-registry<br/>(server image)"]
    MRO -.->|"deploys"| KubeRBACProxy["kube-rbac-proxy<br/>(sidecar image)"]
    MRO -.->|"deploys"| PostgreSQL["PostgreSQL 16<br/>(database image)"]
    MRO -.->|"deploys"| MetadataCollection["model-metadata-<br/>collection (init)"]

    %% Integration points (downstream consumers)
    Dashboard["ODH Dashboard"] -.->|"UI management"| MRO
    Pipelines["Data Science<br/>Pipelines"] -.->|"model deployment"| RegistryServer

    %% Styling
    style MRO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps - grey
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style K8sClientGo fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style OSApi fill:#999,stroke:#333,color:#fff
    style OSControllerCommon fill:#999,stroke:#333,color:#fff
    style IstioClient fill:#999,stroke:#333,color:#fff
    style ObjectMatcher fill:#999,stroke:#333,color:#fff

    %% Internal platform deps - green
    style PlatformUtils fill:#7ed321,stroke:#333,color:#fff
    style DSGateway fill:#7ed321,stroke:#333,color:#fff
    style OSRoutes fill:#7ed321,stroke:#333,color:#fff
    style OSUsers fill:#7ed321,stroke:#333,color:#fff
    style PlatformAuth fill:#7ed321,stroke:#333,color:#fff
    style OdhOperator fill:#7ed321,stroke:#333,color:#fff

