graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - Edge TLS)"]
        RouteUI["Route: planner<br/>443/TCP → 8501/TCP<br/>TLS edge termination<br/>HTTP→HTTPS redirect"]
        RouteBackend["Route: planner-backend<br/>443/TCP → 8000/TCP<br/>TLS edge termination<br/>HTTP→HTTPS redirect"]
    end

    subgraph PlannerNS["NAMESPACE: planner (No ingress NetworkPolicy)"]
        direction TB

        UI["Streamlit UI<br/>Service: ui (ClusterIP)<br/>8501/TCP HTTP<br/>Auth: None"]
        Backend["FastAPI Backend<br/>Service: backend (ClusterIP)<br/>8000/TCP HTTP<br/>SA: planner-backend<br/>Auth: None (31 endpoints)<br/>CORS: allow_origins=*"]
        OllamaSvc["Ollama Sidecar<br/>Service: ollama (ClusterIP)<br/>11434/TCP HTTP<br/>Model: Granite 3.3 2B"]
        SQLite["SQLite Database<br/>(planner.db on PVC)"]
    end

    subgraph InternalPlatform["INTERNAL PLATFORM (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        ModelCatalog["RHOAI Model Catalog<br/>rhoai-model-registries ns<br/>8443/TCP HTTPS<br/>TLS (service-CA)<br/>Bearer / SA token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer (HF_TOKEN)"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer (OPENAI_API_KEY)"]
        VertexAI["Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP credentials"]
        ArenaAPI["Arena API<br/>lmarena.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No auth"]
        AAAPI["Artificial Analysis<br/>artificialanalysis.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer (AA_API_KEY)"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS (edge)<br/>No auth"| RouteUI
    User -->|"HTTPS/443<br/>TLS (edge)<br/>No auth"| RouteBackend

    %% Ingress to Services
    RouteUI -->|"HTTP/8501<br/>No encryption<br/>No auth"| UI
    RouteBackend -->|"HTTP/8000<br/>No encryption<br/>No auth"| Backend

    %% Internal flows
    UI -->|"HTTP/8000<br/>No encryption<br/>No auth"| Backend
    Backend -->|"HTTP/11434<br/>No encryption<br/>No auth"| OllamaSvc
    Backend -->|"File I/O"| SQLite

    %% To Internal Platform
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Backend -->|"HTTPS/8443<br/>TLS (service-CA)<br/>Bearer / SA token<br/>NetworkPolicy restricted"| ModelCatalog

    %% To External Services
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer"| HFHub
    Backend -.->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (optional)"| OpenAI
    Backend -.->|"HTTPS/443<br/>TLS 1.2+<br/>GCP creds (optional)"| VertexAI
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth"| ArenaAPI
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer"| AAAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef namespace fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f5a623,stroke:#d79b00,stroke-width:2px

    class User external
    class RouteUI,RouteBackend ingress
    class UI,Backend,OllamaSvc namespace
    class SQLite storage
    class K8sAPI,ModelCatalog internal
    class HFHub,OpenAI,VertexAI,ArenaAPI,AAAPI externalservice
