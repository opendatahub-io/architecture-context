graph TD
    subgraph ServiceAccounts["Service Accounts"]
        ControllerSA["modelservice-controller-manager<br/>(modelservice-system)"]
        PerModelSA["Per-ModelService SA<br/>(user namespace, PD pods)"]
        EPPSA["Per-ModelService EPP SA<br/>(user namespace, EPP pods)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        ManagerBinding["modelservice-manager-rolebinding"]
        EPPBinding["modelservice-manager-epp-rolebinding"]
        MetricsAuthBinding["modelservice-metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (modelservice-system)"]
        LeaderElectionBinding["modelservice-leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        ManagerRole["modelservice-manager-role"]
        MetricsAuthRole["modelservice-metrics-auth-role"]
        MetricsReader["modelservice-metrics-reader"]
        AdminRole["modelservice-modelservice-admin-role"]
        EditorRole["modelservice-modelservice-editor-role"]
        ViewerRole["modelservice-modelservice-viewer-role"]
        EPPClusterRole["$EPP_CLUSTER_ROLE<br/>(externally defined)"]
    end

    subgraph Roles["Roles"]
        LeaderElectionRole["modelservice-leader-election-role"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        CoreResources["core API<br/>configmaps, serviceaccounts,<br/>services"]
        AppsResources["apps API<br/>deployments,<br/>deployments/scale"]
        GatewayResources["gateway.networking.k8s.io<br/>httproutes"]
        InferenceResources["inference.networking.x-k8s.io<br/>inferencemodels, inferencepools"]
        LLMDResources["llm-d.ai<br/>modelservices,<br/>modelservices/finalizers,<br/>modelservices/status"]
        RBACResources["rbac.authorization.k8s.io<br/>rolebindings"]
    end

    subgraph MetricsResources["Metrics Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    subgraph LeaderResources["Leader Election Resources"]
        LeaderConfigMaps["core: configmaps, events"]
        Leases["coordination.k8s.io: leases"]
    end

    %% Controller SA bindings
    ControllerSA -->|"bound via"| ManagerBinding
    ControllerSA -->|"bound via"| EPPBinding
    ControllerSA -->|"bound via"| MetricsAuthBinding
    ControllerSA -->|"bound via"| LeaderElectionBinding

    %% EPP SA binding (created by controller)
    EPPSA -.->|"bound at runtime"| EPPClusterRole

    %% ClusterRoleBinding → ClusterRole
    ManagerBinding -->|"grants"| ManagerRole
    EPPBinding -->|"grants"| EPPClusterRole
    MetricsAuthBinding -->|"grants"| MetricsAuthRole

    %% RoleBinding → Role
    LeaderElectionBinding -->|"grants"| LeaderElectionRole

    %% ClusterRole → Resources
    ManagerRole -->|"CRUD + watch"| CoreResources
    ManagerRole -->|"CRUD + watch + scale"| AppsResources
    ManagerRole -->|"CRUD + watch"| GatewayResources
    ManagerRole -->|"CRUD + watch"| InferenceResources
    ManagerRole -->|"CRUD + watch + finalizers"| LLMDResources
    ManagerRole -->|"CRUD + watch"| RBACResources

    MetricsAuthRole -->|"create"| TokenReviews
    MetricsAuthRole -->|"create"| SAR

    MetricsReader -->|"get"| MetricsURL

    LeaderElectionRole -->|"CRUD + watch"| LeaderConfigMaps
    LeaderElectionRole -->|"CRUD + watch"| Leases

