graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Admin / kubectl"]
        ProviderEndpoints["Provider Health Endpoints<br/>HTTP/HTTPS TLS 1.2+<br/>Bearer / API key / mTLS"]
        MCPServers["MCP Servers<br/>Streamable HTTP / TLS"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>ServiceAccount tokens"]
    end

    subgraph GridSystem["OPERATOR NAMESPACE (grid-system)"]
        direction TB

        subgraph OperatorPod["grid-operator Pod<br/>SA: grid-operator<br/>readOnlyRootFilesystem / drop ALL / seccomp<br/>non-root 100:101"]
            Controller["Kubernetes Controllers<br/>GridNetwork, GridSite,<br/>InferenceProvider, AgentToolProvider"]
            SwimRuntime["SWIM Runtime<br/>foca + AES-256-GCM"]
            ScoringEngine["Scoring Engine"]
            OverlayRenderer["Overlay Renderer"]
        end

        MetricsSvc["grid-operator-metrics<br/>ClusterIP 9090/TCP<br/>TLS optional<br/>NetworkPolicy: monitoring NS only"]
        SwimSvc["grid-operator-swim<br/>LoadBalancer 7946/UDP<br/>AES-256-GCM<br/>Shared SWIM key"]
        SignalsSvc["grid-operator-signals<br/>LoadBalancer 9091/TCP<br/>mTLS client cert"]

        subgraph GatewayPod["Gateway Pod"]
            OverlaySyncSidecar["overlay-sync sidecar<br/>ConfigMap watcher"]
            PraxisGW["Praxis AI Gateway<br/>hot-reload overlay"]
        end

        ConfigMap["Routing Overlay<br/>ConfigMap"]
    end

    subgraph EnrollmentZone["ENROLLMENT (Hub Site)"]
        EnrollmentSrv["Enrollment Server<br/>HTTPS mTLS<br/>mTLS + optional SAR"]
        PostgreSQL["PostgreSQL<br/>5432/TCP TLS<br/>Client cert / password"]
    end

    subgraph PeerSites["PEER SITES (Cross-Cluster)"]
        PeerOperator["Peer Site Operator<br/>7946/UDP SWIM<br/>9091/TCP Signals"]
        RemoteGW["Remote Site Gateway<br/>443/TCP HTTPS mTLS"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape"]
    end

    %% Admin flows
    Admin -->|"HTTPS/443<br/>kubeconfig / OIDC"| K8sAPI

    %% Operator to K8s API
    Controller -->|"HTTPS/443<br/>TLS<br/>ServiceAccount"| K8sAPI
    OverlayRenderer -->|"SSA ConfigMap write<br/>HTTPS/443 TLS"| K8sAPI
    OverlaySyncSidecar -->|"ConfigMap watch<br/>HTTPS/443 TLS"| K8sAPI

    %% Internal overlay flow
    K8sAPI -.->|"watch event"| OverlaySyncSidecar
    OverlaySyncSidecar -->|"local file write<br/>pod-level auth"| PraxisGW

    %% SWIM gossip
    SwimRuntime -->|"UDP/7946<br/>AES-256-GCM<br/>shared SWIM key"| PeerOperator
    PeerOperator -->|"UDP/7946<br/>AES-256-GCM<br/>shared SWIM key"| SwimRuntime

    %% Signals
    Controller -->|"TCP/9091<br/>mTLS<br/>grid identity"| PeerOperator

    %% Metrics
    MetricsSvc -->|"HTTP(S)/9090<br/>TLS optional"| Prometheus

    %% Enrollment
    Controller -->|"HTTPS<br/>CA-pinned + one-time token"| EnrollmentSrv
    EnrollmentSrv -->|"TCP/5432<br/>TLS<br/>client cert"| PostgreSQL
    Admin -->|"HTTPS<br/>mTLS client cert"| EnrollmentSrv

    %% Provider probing
    Controller -->|"HTTP(S)<br/>TLS 1.2+<br/>Bearer / API key"| ProviderEndpoints
    Controller -->|"Streamable HTTP<br/>TLS<br/>rmcp"| MCPServers

    %% Data plane (context)
    PraxisGW -->|"HTTPS/443<br/>mTLS grid identity"| RemoteGW

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef enrollment fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef peer fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Admin,ProviderEndpoints,MCPServers external
    class K8sAPI controlplane
    class Controller,SwimRuntime,ScoringEngine,OverlayRenderer,MetricsSvc,SwimSvc,SignalsSvc,OverlaySyncSidecar,PraxisGW,ConfigMap operator
    class EnrollmentSrv,PostgreSQL enrollment
    class PeerOperator,RemoteGW peer
    class Prometheus monitoring
