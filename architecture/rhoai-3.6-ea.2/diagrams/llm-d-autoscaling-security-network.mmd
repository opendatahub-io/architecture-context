graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Benchmark["llm-d-benchmark Harness"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token / kubeconfig"]
    end

    subgraph ClusterServices["CLUSTER SERVICES (Internal)"]
        direction TB

        subgraph KEDAZone["KEDA"]
            KEDAOp["KEDA Operator<br/>Reads ScaledObject CRDs<br/>Manages HPA scaling"]
        end

        subgraph MonitoringZone["Monitoring"]
            Prometheus["Prometheus / Thanos Querier<br/>Configurable port<br/>HTTPS TLS 1.2+<br/>Bearer token / mTLS"]
        end

        subgraph LegacyZone["Legacy (Deprecated)"]
            WVA["WVA Controller<br/>NS: wva-system<br/>SA: controller-manager"]
            MetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP<br/>HTTPS TLS<br/>TokenReview + SAR"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No auth"]
        end

        subgraph WorkloadZone["Inference Workloads"]
            InfServers["vLLM / EPP<br/>Inference Servers"]
        end
    end

    %% External flows
    Benchmark -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI
    Benchmark -->|"HTTP/HTTPS<br/>Load generation"| InfServers
    Benchmark -->|"HTTPS<br/>Bearer token<br/>Metrics collection"| Prometheus

    %% Production path
    InfServers -->|"HTTP/HTTPS<br/>SA token<br/>Expose metrics"| Prometheus
    KEDAOp -->|"HTTPS<br/>TLS 1.2+<br/>Bearer token<br/>Query triggers"| Prometheus
    KEDAOp -->|"HTTPS/6443<br/>SA token<br/>HPA scale"| K8sAPI
    K8sAPI -->|"Scale replicas"| InfServers

    %% Legacy path
    WVA -->|"HTTPS<br/>TLS 1.2+<br/>Bearer/mTLS<br/>Query metrics"| Prometheus
    WVA -->|"HTTPS/6443<br/>SA token<br/>Watch & scale"| K8sAPI
    Prometheus -->|"HTTPS/8443<br/>TokenReview+SAR<br/>Scrape /metrics"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef keda fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef legacy fill:#e8e8e8,stroke:#999,stroke-width:2px,stroke-dasharray: 5 5
    classDef workload fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Benchmark external
    class K8sAPI controlplane
    class KEDAOp keda
    class Prometheus monitoring
    class WVA,MetricsSvc,HealthProbes legacy
    class InfServers workload
