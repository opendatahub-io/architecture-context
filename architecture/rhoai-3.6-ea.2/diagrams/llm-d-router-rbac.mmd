graph TD
    subgraph "Service Account"
        SA["{name}<br/>ServiceAccount"]
    end

    subgraph "Role Bindings"
        RB_NonSA["{name}-non-sa<br/>RoleBinding"]
        RB_SA["{name}-sa<br/>RoleBinding"]
        RB_LE["{name}-leader-election-binding<br/>RoleBinding"]
        CRB_Metrics["{name}-metrics-auth<br/>ClusterRoleBinding<br/>(conditional)"]
    end

    subgraph "Roles"
        R_NonSA["{name}-non-sa<br/>Role"]
        R_SA["{name}-sa<br/>Role"]
        R_LE["{name}-leader-election<br/>Role"]
        CR_Metrics["{name}-metrics-auth<br/>ClusterRole<br/>(conditional)"]
    end

    subgraph "llm-d.ai API Resources"
        InfObj["llm-d.ai<br/>InferenceObjective"]
        InfMR["llm-d.ai<br/>InferenceModelRewrite"]
    end

    subgraph "inference.networking.k8s.io Resources"
        InfPool["inference.networking.k8s.io<br/>InferencePool"]
    end

    subgraph "Core Resources"
        Pods["core<br/>Pods"]
        Events["core<br/>Events"]
    end

    subgraph "coordination.k8s.io Resources"
        Leases["coordination.k8s.io<br/>Leases"]
    end

    subgraph "Auth Resources"
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
        MetricsURL["/metrics<br/>Non-Resource URL"]
    end

    %% Bindings
    SA -->|bound via| RB_NonSA
    SA -->|bound via| RB_SA
    SA -->|bound via| RB_LE
    SA -->|bound via| CRB_Metrics

    RB_NonSA -->|grants| R_NonSA
    RB_SA -->|grants| R_SA
    RB_LE -->|grants| R_LE
    CRB_Metrics -->|grants| CR_Metrics

    %% Permissions
    R_NonSA -->|"get, watch, list"| InfObj
    R_NonSA -->|"get, watch, list"| InfMR
    R_NonSA -->|"get, watch, list"| InfPool

    R_SA -->|"get, watch, list"| Pods

    R_LE -->|"get, list, watch,<br/>create, update, patch, delete"| Leases
    R_LE -->|"create, patch"| Events

    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SAR
    CR_Metrics -->|"get"| MetricsURL

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style R_NonSA fill:#f5a623
    style R_SA fill:#f5a623
    style R_LE fill:#f5a623
    style CR_Metrics fill:#f5a623
    style InfObj fill:#7ed321
    style InfMR fill:#7ed321
    style InfPool fill:#7ed321
    style Pods fill:#7ed321
    style Events fill:#7ed321
    style Leases fill:#7ed321
    style TokenReviews fill:#7ed321
    style SAR fill:#7ed321
    style MetricsURL fill:#7ed321
