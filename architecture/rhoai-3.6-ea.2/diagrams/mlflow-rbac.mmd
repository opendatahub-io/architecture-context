graph TD
    subgraph "Authentication Flow"
        Client["ML Client / Dashboard"]
        BearerToken["Authorization: Bearer<br/>(K8s ServiceAccount Token)"]
        WorkspaceHeader["X-MLFLOW-WORKSPACE<br/>(K8s Namespace Name)"]
    end

    subgraph "Auth Plugin (mlflow-kubernetes-plugins v1.6.0)"
        AuthMiddleware["kubernetes-auth Middleware<br/>(loaded via Python entry point)"]
        TokenValidation["Token Validation<br/>(K8s TokenReview API)"]
        WorkspaceResolver["Workspace Resolver<br/>(namespace → workspace mapping)"]
    end

    subgraph "Kubernetes RBAC (Helm-managed, opt-in)"
        SA["ServiceAccount<br/>(created by Helm chart)"]
        NSRole["Namespace Role<br/>(opt-in via namespace_rbac)"]
        ClusterRole["ClusterRole<br/>(opt-in via cluster_rbac)"]
        ExtraRules["Extra Rules<br/>(opt-in via extraRules)"]
    end

    subgraph "Application-Level Authorization"
        WorkspaceScoping["Workspace-Scoped Queries<br/>(SQLAlchemy filter)"]
        ExperimentAccess["Experiments<br/>(workspace-isolated)"]
        RunAccess["Runs & Metrics<br/>(workspace-isolated)"]
        ModelAccess["Model Registry<br/>(workspace-isolated)"]
        ArtifactAccess["Artifacts<br/>(workspace-prefixed paths)"]
    end

    subgraph "Unauthenticated Endpoints"
        Health["/health<br/>(no auth)"]
        Version["/version<br/>(no auth)"]
    end

    %% Authentication flow
    Client -->|sends| BearerToken
    Client -->|sends| WorkspaceHeader
    BearerToken -->|extracted by| AuthMiddleware
    WorkspaceHeader -->|read by| AuthMiddleware
    AuthMiddleware -->|validates token via| TokenValidation
    AuthMiddleware -->|resolves workspace via| WorkspaceResolver
    TokenValidation -->|"HTTPS/443 to K8s API"| SA

    %% Authorization flow
    WorkspaceResolver -->|scopes queries| WorkspaceScoping
    WorkspaceScoping -->|filters| ExperimentAccess
    WorkspaceScoping -->|filters| RunAccess
    WorkspaceScoping -->|filters| ModelAccess
    WorkspaceScoping -->|prefixes paths| ArtifactAccess

    %% Helm RBAC (optional)
    SA -.->|"bound via (opt-in)"| NSRole
    SA -.->|"bound via (opt-in)"| ClusterRole
    ClusterRole -.->|"includes"| ExtraRules

    %% Unauthenticated bypass
    Client -->|"direct access"| Health
    Client -->|"direct access"| Version

    style Client fill:#f9f9f9,stroke:#999
    style AuthMiddleware fill:#4a90e2,color:#fff
    style TokenValidation fill:#4a90e2,color:#fff
    style WorkspaceResolver fill:#4a90e2,color:#fff
    style SA fill:#e8e8e8,stroke:#333
    style NSRole fill:#f5a623,color:#fff
    style ClusterRole fill:#f5a623,color:#fff
    style ExtraRules fill:#f5a623,color:#fff
    style WorkspaceScoping fill:#7ed321,color:#fff
    style ExperimentAccess fill:#7ed321,color:#fff
    style RunAccess fill:#7ed321,color:#fff
    style ModelAccess fill:#7ed321,color:#fff
    style ArtifactAccess fill:#7ed321,color:#fff
    style Health fill:#d5e8d4,stroke:#82b366
    style Version fill:#d5e8d4,stroke:#82b366
