graph TB
    subgraph TrainerOperator["Trainer Operator"]
        Controller["trainer-operator-controller-manager<br/>(Go Operator, controller-runtime)"]
        MetricsServer["Metrics Server<br/>8443/TCP HTTPS"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP"]
        TLSResolver["TLS Profile Resolver<br/>(OpenShift APIServer)"]
        ManifestPipeline["Manifest Pipeline<br/>(kustomize render)"]
        GCCollector["GC Collector<br/>(label-based discovery)"]
    end

    subgraph Framework["odh-platform-utilities/framework"]
        Reconciler["Framework Reconciler"]
        ConditionMgr["Condition Manager"]
        SSAApply["SSA Apply"]
    end

    User[Platform Operator] -->|creates| TrainerCR["Trainer CR<br/>(default-trainer)<br/>components.platform.opendatahub.io/v1alpha1"]
    TrainerCR -->|watched by| Controller

    Controller -->|uses| Reconciler
    Controller -->|chains actions| ManifestPipeline
    Controller -->|runs| GCCollector
    Controller -->|checks| JobSetOp["JobSet Operator<br/>(hard dependency)"]
    Controller -->|resolves TLS| TLSResolver
    Controller -->|serves| MetricsServer
    Controller -->|serves| HealthProbes

    ManifestPipeline -->|renders| TrainerCore["Trainer Core Manifests<br/>(CRDs, controller, RBAC, webhooks)"]
    ManifestPipeline -->|renders| Runtimes["ClusterTrainingRuntimes<br/>(torch-distributed, training-hub)"]
    ManifestPipeline -->|renders| ImageStreams["ImageStreams<br/>(CUDA, ROCm, CPU)"]

    Reconciler -->|applies via| SSAApply
    SSAApply -->|Server-Side Apply| K8sAPI["Kubernetes API"]
    GCCollector -->|removes stale| K8sAPI

    Prometheus["Prometheus"] -->|scrapes via ServiceMonitor| MetricsServer

    Controller -->|reads| PlatformConfig["odh-trainer-config<br/>ConfigMap"]

    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px
    style MetricsServer fill:#4a90e2,stroke:#333
    style HealthProbes fill:#4a90e2,stroke:#333
    style TLSResolver fill:#4a90e2,stroke:#333
    style ManifestPipeline fill:#4a90e2,stroke:#333
    style GCCollector fill:#4a90e2,stroke:#333
    style TrainerCR fill:#f5a623,stroke:#333
    style Reconciler fill:#82b366,stroke:#333
    style ConditionMgr fill:#82b366,stroke:#333
    style SSAApply fill:#82b366,stroke:#333
    style JobSetOp fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style TrainerCore fill:#d5e8d4,stroke:#333
    style Runtimes fill:#d5e8d4,stroke:#333
    style ImageStreams fill:#d5e8d4,stroke:#333
    style PlatformConfig fill:#fff2cc,stroke:#333
