graph TB
    subgraph CorePlatform["Core Platform Services"]
        GatewayAPI[Gateway API<br/>Shared Ingress Abstraction<br/>13 dependents]
        CertManager[cert-manager<br/>TLS Certificate Provisioning<br/>14 dependents]
        PromOperator[prometheus-operator<br/>Observability Substrate<br/>16 dependents]
        KubeRBACProxy[kube-rbac-proxy<br/>Metrics Auth Sidecar<br/>6 dependents]
        PlatformUtils[odh-platform-utilities<br/>Shared Go Library<br/>13 dependents]
        GWAPIInfExt[Gateway API<br/>Inference Extension<br/>6 dependents]
    end

    subgraph MetaOperator["Meta-Operator Tier"]
        RhodsOp[rhods-operator<br/>Platform Lifecycle<br/>OLM + Module System]
    end

    subgraph Serving["Model Serving"]
        KServe[KServe<br/>Core Model Serving<br/>8 dependents]
        ODHModelCtrl[odh-model-controller<br/>Serving Lifecycle<br/>15 forward deps]
        LLMDRouter[llm-d-router<br/>Disaggregated Routing<br/>EPP + Coordinator]
        LLMDModelSvc[llm-d-model-service<br/>Deployment Lifecycle]
        LLMDKVCache[llm-d-kv-cache<br/>Distributed KV-Cache]
        VLLMCpu[vllm-cpu<br/>CPU Inference Runtime]
        MLServer[MLServer<br/>Multi-Framework Runtime]
    end

    subgraph MaaS["Models-as-a-Service"]
        MaaSCtrl[models-as-a-service<br/>Tenant + API Key Mgmt]
        AIGWCtrl[ai-gateway-controller<br/>External Provider Routing]
        PraxisExtProc[praxis-extproc<br/>Payload Processing<br/>BBR + IPP]
    end

    subgraph MLWorkflows["ML Workflows"]
        DSPipelines[Data Science Pipelines<br/>Pipeline Orchestration]
        Kubeflow[kubeflow<br/>Pipeline Components]
        TrainerOp[trainer-operator<br/>Training Lifecycle]
        Feast[Feast<br/>Feature Store]
        MLflowOp[mlflow-operator<br/>Experiment Tracking]
    end

    subgraph UserFacing["User-Facing Components"]
        Dashboard[odh-dashboard<br/>Platform UI<br/>17 forward deps]
        Workbenches[workbenches<br/>Workspace CRDs]
        ModelRegistry[model-registry-operator<br/>Model Metadata]
    end

    subgraph Gateway["Gateway Infrastructure"]
        DSGateway[data-science-gateway<br/>Platform Ingress]
        MaaSGateway[maas-default-gateway<br/>MaaS Ingress]
        KubeAuthProxy[kube-auth-proxy<br/>OIDC/OAuth Auth]
    end

    subgraph DistributedCompute["Distributed Computing"]
        KubeRay[KubeRay<br/>Ray Cluster Mgmt]
        SparkOp[Spark Operator<br/>Spark Applications]
        KueueOp[kueue-operator<br/>Workload Queuing]
    end

    %% Meta-operator manages all modules
    RhodsOp -->|manages module| KServe
    RhodsOp -->|manages module| MaaSCtrl
    RhodsOp -->|manages module| ModelRegistry
    RhodsOp -->|manages module| Feast
    RhodsOp -->|manages module| DSGateway

    %% Serving dependencies
    KServe -->|traffic routing| GatewayAPI
    KServe -->|webhook TLS| CertManager
    KServe -->|metrics auth| KubeRBACProxy
    ODHModelCtrl -->|serving lifecycle| KServe
    ODHModelCtrl -->|auth policy| GatewayAPI
    ODHModelCtrl -->|metrics auth| KubeRBACProxy
    LLMDRouter -->|inference routing| GWAPIInfExt
    LLMDModelSvc -->|model deployment| KServe
    LLMDKVCache -->|KV transfer| LLMDRouter

    %% MaaS dependencies
    MaaSCtrl -->|model serving| KServe
    MaaSCtrl -->|ingress| MaaSGateway
    AIGWCtrl -->|external routing| GatewayAPI
    PraxisExtProc -->|payload processing| MaaSGateway

    %% ML workflow dependencies
    DSPipelines -->|model deploy| KServe
    DSPipelines -->|ray clusters| KubeRay
    DSPipelines -->|mlflow integration| MLflowOp
    Kubeflow -->|pipeline execution| DSPipelines
    Feast -->|feature injection| Kubeflow
    Feast -->|experiment data| MLflowOp
    Feast -->|spark jobs| SparkOp

    %% User-facing dependencies
    Dashboard -->|model management| KServe
    Dashboard -->|model metadata| ModelRegistry
    Dashboard -->|pipeline UI| DSPipelines
    Dashboard -->|workspace UI| Workbenches
    Dashboard -->|MaaS portal| MaaSCtrl

    %% Gateway dependencies
    DSGateway -->|authentication| KubeAuthProxy
    DSGateway -->|TLS certs| CertManager
    MaaSGateway -->|payload processing| PraxisExtProc

    %% Cross-cutting observability
    KServe -->|ServiceMonitor| PromOperator
    ODHModelCtrl -->|ServiceMonitor| PromOperator
    Dashboard -->|ServiceMonitor| PromOperator
    MaaSCtrl -->|ServiceMonitor| PromOperator
    ModelRegistry -->|ServiceMonitor| PromOperator
    DSPipelines -->|ServiceMonitor| PromOperator

    %% Shared library usage
    RhodsOp -->|shared lib| PlatformUtils
    ODHModelCtrl -->|shared lib| PlatformUtils
    MaaSCtrl -->|shared lib| PlatformUtils
    ModelRegistry -->|shared lib| PlatformUtils

