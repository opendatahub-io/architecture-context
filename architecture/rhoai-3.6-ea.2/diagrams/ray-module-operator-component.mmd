graph TB
    subgraph RayModuleOperator["Ray Module Operator"]
        Controller["ray-module-operator<br/>controller-manager<br/>(Go Operator)"]
        Manifests["KubeRay Operand<br/>Manifests<br/>(/opt/manifests)"]

        Controller -->|"reads & renders"| Manifests
    end

    subgraph ReconcilerPipeline["Reconciler Pipeline"]
        MgmtState["Management State<br/>Evaluation"]
        Releases["Release<br/>Tracking"]
        Render["Kustomize<br/>Rendering"]
        ImageParams["Image Parameter<br/>Injection"]
        CertCheck["cert-manager<br/>Prerequisite Check"]
        PlatformFilter["Platform Resource<br/>Filtering"]
        NotebookRBAC["Notebook RBAC<br/>Provisioning"]
        SSA["Server-Side<br/>Apply"]
        HealthMon["Deployment Health<br/>Monitor"]
        DistSync["Distribution Status<br/>Sync"]
        GC["Garbage<br/>Collection"]

        MgmtState --> Releases --> Render --> ImageParams --> CertCheck --> PlatformFilter --> NotebookRBAC --> SSA --> HealthMon --> DistSync --> GC
    end

    PlatformOperator["ODH Platform<br/>Operator"] -->|"creates/manages"| RayCR["Ray CR<br/>(default-ray)<br/>Cluster-scoped"]
    RayCR -->|"watched by"| Controller
    Controller -->|"executes"| MgmtState

    ConfigMap["odh-ray-config<br/>ConfigMap"] -->|"watched by"| Controller
    PlatformOperator -->|"creates/updates"| ConfigMap

    Controller -->|"SSA deploys"| KubeRayOperator["KubeRay Operator<br/>Deployment"]
    Controller -->|"manages"| Webhooks["Admission<br/>Webhooks"]
    Controller -->|"manages"| KubeRayCRDs["KubeRay CRDs<br/>(RayCluster, RayJob,<br/>RayService)"]
    Controller -->|"creates"| NotebookCR["ray ClusterRole<br/>(Notebook access)"]

    Controller -->|"validates presence"| CertManager["cert-manager"]
    Controller -->|"manages"| GatewayAPI["Gateway API<br/>Resources"]
    Controller -->|"manages on OpenShift"| SCC["SecurityContext<br/>Constraints"]

    Workbenches["Workbenches<br/>(Notebooks)"] -->|"binds to"| NotebookCR

    style Controller fill:#4a90e2,color:#fff
    style Manifests fill:#4a90e2,color:#fff
    style RayCR fill:#f5a623,color:#fff
    style ConfigMap fill:#f5a623,color:#fff
    style KubeRayOperator fill:#7ed321,color:#fff
    style PlatformOperator fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Workbenches fill:#e8e8e8,stroke:#333
    style SCC fill:#e8e8e8,stroke:#333
