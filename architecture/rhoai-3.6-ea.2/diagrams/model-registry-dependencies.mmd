graph LR
    MR["Model Registry<br/>(Kubeflow Hub)"]

    %% External Dependencies - Build & Runtime
    MR -->|"ORM persistence"| GORM["gorm.io/gorm v1.31.2"]
    MR -->|"metadata store"| PostgreSQL["PostgreSQL 16+"]
    MR -->|"alt metadata store"| MySQL["MySQL 8.3+"]
    MR -->|"HTTP router"| Chi["go-chi/chi v5.3.2"]
    MR -->|"controller framework"| CR["controller-runtime v0.25.0"]
    MR -->|"config mgmt"| Viper["spf13/viper v1.21.0"]
    MR -->|"K8s client"| ClientGo["k8s.io/client-go v0.37.0"]
    MR -->|"schema migrations"| Migrate["golang-migrate v4.19.1"]
    MR -->|"migration locking"| PGLock["pglock v1.16.2"]

    %% Internal RHOAI Dependencies
    MR -->|"CRD watch + sync"| KServe["KServe v0.19.0<br/>(InferenceService)"]
    MR -->|"traffic + authz"| Istio["Istio Service Mesh<br/>(VirtualService + AuthzPolicy)"]
    MR -->|"lifecycle mgmt"| Operator["model-registry-operator<br/>(separate repo)"]

    %% Integration Points - other RHOAI components use Model Registry
    Dashboard["ODH Dashboard"] -->|"UI proxy"| MR
    Pipelines["Data Science Pipelines"] -.->|"model tracking"| MR

    %% Async Upload Job Dependencies (Python)
    subgraph AsyncDeps["async-upload Job Dependencies"]
        Boto3["boto3 1.43.50"]
        HFHub["huggingface-hub 1.23.0"]
        Sigstore["sigstore 4.4.0"]
        RHSigning["rh-model-signing 1.0.3"]
        Crypto["cryptography 49.0.0"]
    end
    MR -->|"model transfer"| Boto3
    MR -->|"model download"| HFHub
    MR -->|"supply chain signing"| Sigstore
    MR -->|"RH signing"| RHSigning

    %% External Services
    MR -->|"model artifacts"| S3["S3-compatible Storage"]
    MR -->|"model source"| HFHubSvc["HuggingFace Hub"]
    MR -->|"OCI artifacts"| OCIReg["OCI Registry"]
    MR -->|"watches, authz"| K8sAPI["Kubernetes API"]

