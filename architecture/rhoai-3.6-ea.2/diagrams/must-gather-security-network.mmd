graph TB
    subgraph AdminZone["ADMIN WORKSTATION (Trusted)"]
        Admin["Cluster Administrator<br/>Tools: oc / kubectl<br/>Auth: kubeconfig"]
    end

    subgraph ContainerZone["MUST-GATHER CONTAINER (Ephemeral)"]
        direction TB

        subgraph Image["Image: odh-must-gather-rhel9"]
            Gather["gather.sh<br/>Entrypoint / Orchestrator"]
            Distro["xks_util.sh<br/>Distribution Detection"]

            subgraph OCPCollectors["OpenShift Collectors"]
                OCP_C["14 Component Scripts<br/>(parallel background PIDs)"]
            end

            subgraph XKSCollectors["xKS Collectors"]
                XKS_C["gather_llmd.sh +<br/>Dependency Scripts<br/>(cert-mgr, sail, lws)"]
            end

            Gather --> Distro
            Gather -->|OCP path| OCPCollectors
            Gather -->|xKS path| XKSCollectors
        end

        CryptoPolicy["Crypto Policy: DEFAULT:PQ<br/>(post-quantum enabled)"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>Port: 443/TCP<br/>Protocol: HTTPS<br/>Encryption: TLS"]
    end

    subgraph LocalFS["LOCAL FILESYSTEM"]
        Output["must-gather bundle<br/>/must-gather/ (OCP)<br/>/tmp/must-gather/ (xKS)<br/>Contains: YAML, logs,<br/>Helm values, cluster info"]
    end

    %% Flows
    Admin -->|"oc adm must-gather (OCP)<br/>kubectl apply job (xKS)"| Gather
    OCP_C -->|"HTTPS/443<br/>TLS DEFAULT:PQ<br/>SA Token (cluster-admin)<br/>Verbs: GET, LIST, WATCH"| K8sAPI
    XKS_C -->|"HTTPS/443<br/>TLS DEFAULT:PQ<br/>SA Token (must-gather-reader)<br/>Verbs: GET, LIST, WATCH"| K8sAPI
    Gather -->|"HTTPS/443<br/>Platform CRs, Subscriptions"| K8sAPI
    Gather -->|writes| Output
    Output -->|"tar archive (OCP)<br/>kubectl cp (xKS)"| Admin

    %% Styling
    classDef admin fill:#d4edda,stroke:#28a745,stroke-width:2px
    classDef container fill:#cce5ff,stroke:#004085,stroke-width:2px
    classDef controlplane fill:#fff3cd,stroke:#856404,stroke-width:2px
    classDef filesystem fill:#f8d7da,stroke:#721c24,stroke-width:2px
    classDef crypto fill:#e2d5f1,stroke:#6f42c1,stroke-width:2px

    class Admin admin
    class Gather,Distro,OCP_C,XKS_C container
    class K8sAPI controlplane
    class Output filesystem
    class CryptoPolicy crypto
