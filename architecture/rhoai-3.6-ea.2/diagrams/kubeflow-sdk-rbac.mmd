graph TD
    subgraph UserAuth["User Authentication"]
        Kubeconfig["kubeconfig / ServiceAccount Token<br/>(User-provided)"]
    end

    subgraph SDKClients["SDK Client Modules"]
        TrainerClient["TrainerClient"]
        OptimizerClient["OptimizerClient"]
        SparkClient["SparkClient"]
        HubClient["ModelRegistryClient"]
        PipelinesClient["PipelinesClient"]
    end

    subgraph RequiredPerms["Required RBAC Permissions (User Must Have)"]
        direction TB

        subgraph TrainerPerms["Trainer Resources"]
            TrainJob["trainer.kubeflow.org<br/>TrainJob"]
            ClusterTrainingRuntime["trainer.kubeflow.org<br/>ClusterTrainingRuntime"]
        end

        subgraph OptimizerPerms["Optimizer Resources"]
            Experiment["kubeflow.org<br/>Experiment"]
        end

        subgraph SparkPerms["Spark Resources"]
            SparkConnect["sparkoperator.k8s.io<br/>SparkConnect"]
        end

        subgraph CorePerms["Core Resources"]
            Pods["core<br/>Pods"]
            Events["core<br/>Events"]
            Secrets["core<br/>Secrets"]
        end
    end

    subgraph InjectedPodAuth["Injected Pod Authentication"]
        PodSA["Training Pod ServiceAccount<br/>(namespace-scoped)"]
        AWSCreds["AWS Credentials<br/>via data_connection Secret"]
        HFToken["HF_TOKEN<br/>env var (optional)"]
    end

    %% Auth flow
    Kubeconfig -->|"authenticates"| TrainerClient
    Kubeconfig -->|"authenticates"| OptimizerClient
    Kubeconfig -->|"authenticates"| SparkClient

    %% Client → Resource permissions
    TrainerClient -->|"create, get, list,<br/>watch, delete"| TrainJob
    TrainerClient -->|"get, list"| ClusterTrainingRuntime
    OptimizerClient -->|"create, get, list,<br/>watch, delete"| Experiment
    SparkClient -->|"create, get, list,<br/>watch, delete"| SparkConnect

    TrainerClient -->|"get, list, watch"| Pods
    TrainerClient -->|"get, list, watch"| Events
    TrainerClient -->|"get"| Secrets

    %% Hub/Pipelines use separate auth
    HubClient -->|"Bearer Token<br/>(user_token param)"| ModelRegAPI["Model Registry API<br/>No K8s RBAC"]
    PipelinesClient -->|"Bearer Token"| PipelinesAPI["Pipelines API<br/>No K8s RBAC"]

    %% Pod auth
    PodSA -->|"mounted into<br/>training pods"| PodPerms["Pod-level permissions<br/>(minimal, read-only)"]
    AWSCreds -->|"S3 access for<br/>checkpoint storage"| S3Auth["S3 IAM Auth"]
    HFToken -->|"gated model<br/>access"| HFAuth["HuggingFace Auth"]

    %% Styling
    style Kubeconfig fill:#4a90e2,color:#fff
    style TrainerClient fill:#bbdefb,stroke:#1976d2
    style OptimizerClient fill:#bbdefb,stroke:#1976d2
    style SparkClient fill:#bbdefb,stroke:#1976d2
    style HubClient fill:#bbdefb,stroke:#1976d2
    style PipelinesClient fill:#bbdefb,stroke:#1976d2

    style TrainJob fill:#7ed321
    style ClusterTrainingRuntime fill:#7ed321
    style Experiment fill:#7ed321
    style SparkConnect fill:#7ed321
    style Pods fill:#e0e0e0
    style Events fill:#e0e0e0
    style Secrets fill:#e0e0e0

    style PodSA fill:#f5a623
    style AWSCreds fill:#f5a623
    style HFToken fill:#f5a623
    style ModelRegAPI fill:#e8e8e8
    style PipelinesAPI fill:#e8e8e8
