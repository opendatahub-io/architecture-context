graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / Dashboard / Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["Platform Gateway<br/>443/TCP → 8080/TCP<br/>TLS 1.2+<br/>Bearer Token / OIDC"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount / Bearer"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (kserve / opendatahub)"]
        direction TB

        ModuleCtrl["kserve-module-controller<br/>SA: kserve-module-controller-manager<br/>8081/TCP health"]

        subgraph CtrlMgrPod["kserve-controller-manager Pod"]
            CtrlMgr["kserve-controller-manager<br/>9443/TCP webhook"]
            KubeRbac["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
        end

        WebhookSvc["kserve-webhook-server-service<br/>443/TCP HTTPS<br/>TLS (cert-manager / OpenShift CA)<br/>16+ admission webhooks"]

        LLMCtrl["llmisvc-controller<br/>SA: llmisvc<br/>8081/TCP health"]

        LocalModelCtrl["localmodel-controller<br/>SA: kserve-localmodel-controller-manager<br/>8081/TCP health"]
    end

    subgraph UserNS["USER NAMESPACES (Model Serving)"]
        direction TB

        LocalModelAgent["localmodelnode-agent<br/>DaemonSet per node<br/>SA: kserve-localmodelnode-agent"]

        subgraph ModelPod["Model Server Pod"]
            StorageInit["storage-initializer<br/>Init container"]
            ModelServer["Model Server<br/>8080/TCP HTTP<br/>No built-in auth"]
            AgentSidecar["agent sidecar<br/>(optional)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP Service Account"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Azure AD / Access Key"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        OCI["OCI Registries<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry Credentials"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes 8443/TCP<br/>via ServiceMonitor"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token / OIDC"| Gateway
    Client -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token / OIDC"| K8sAPI

    %% Gateway to model
    Gateway -->|"HTTP/8080<br/>mesh internal or mTLS"| ModelServer

    %% API server to webhooks
    K8sAPI -->|"HTTPS/443<br/>TLS (cert-mgr)<br/>Admission"| WebhookSvc

    %% Controller to API
    CtrlMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LLMCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LocalModelCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Model storage
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage creds"| S3
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage creds"| GCS
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage creds"| Azure
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token"| HuggingFace
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry creds"| OCI

    LocalModelAgent -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage creds"| S3

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>kube-rbac-proxy"| KubeRbac

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userworkload fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class K8sAPI controlplane
    class ModuleCtrl,CtrlMgr,KubeRbac,WebhookSvc,LLMCtrl,LocalModelCtrl controller
    class LocalModelAgent,StorageInit,ModelServer,AgentSidecar userworkload
    class S3,GCS,Azure,HuggingFace,OCI externalservice
    class Prometheus monitoring
