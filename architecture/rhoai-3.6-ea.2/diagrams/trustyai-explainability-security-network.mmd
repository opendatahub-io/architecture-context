graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Dashboard / CLI"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route: trustyai<br/>80/TCP → 8080/TCP<br/>TLS: None (tls: null)<br/>Auth: None"]
    end

    subgraph Namespace["NAMESPACE (Per Data Science Project)"]
        direction TB

        subgraph ServicePod["TrustyAI Service Pod"]
            Service["trustyai-service<br/>SA: trustyai-serviceaccount<br/>Image: odh-trustyai-service-rhel8"]
            HTTP["HTTP Port: 8080/TCP<br/>No Auth on API endpoints"]
            HTTPS["HTTPS Port: 4443/TCP<br/>TLS cert mounted at<br/>/etc/tls/internal/"]
            Metrics["/q/metrics<br/>Bearer SA token"]
            PayloadEndpoint["/consumer/kserve/v2<br/>No Auth"]
        end

        subgraph InitPod["Init Container"]
            ConfigOverrider["config-map-overrider<br/>Creates model-serving-config<br/>ConfigMap via oc CLI"]
        end

        PVC["PVC Storage<br/>1Gi RWO<br/>/inputs"]
    end

    subgraph InboundSources["INBOUND SOURCES"]
        ModelMesh["ModelMesh / KServe<br/>Model Servers"]
        Prometheus["Prometheus<br/>(ServiceMonitor)<br/>Filter: trustyai_spd, trustyai_dir"]
    end

    subgraph EgressTargets["EGRESS TARGETS"]
        ModelServers["KServe v1/v2<br/>Model Servers<br/>gRPC + HTTP"]
        MariaDB["MariaDB/MySQL<br/>3306/TCP JDBC<br/>User/Pass Auth<br/>(Optional)"]
        MinIO["MinIO<br/>HTTP/HTTPS<br/>Access Key Auth<br/>(Optional)"]
        K8sAPI["OpenShift API Server<br/>443/TCP HTTPS<br/>SA Token Auth"]
    end

    %% External → Ingress
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Route

    %% Ingress → Service
    Route -->|"HTTP/8080<br/>No Encryption"| HTTP

    %% Inbound connections
    ModelMesh -->|"HTTP/80<br/>POST /consumer/kserve/v2<br/>No Auth"| PayloadEndpoint
    Prometheus -->|"HTTP/80<br/>GET /q/metrics<br/>Bearer SA Token"| Metrics

    %% Egress connections
    Service -->|"gRPC + HTTP<br/>Varies<br/>Explainability queries"| ModelServers
    Service -->|"JDBC/3306<br/>No Encryption<br/>User/Pass"| MariaDB
    Service -->|"HTTP(S)<br/>Access Key/Secret"| MinIO
    ConfigOverrider -->|"HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI

    %% Storage
    Service --> PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef namespace fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef inbound fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Service,HTTP,HTTPS,Metrics,PayloadEndpoint,ConfigOverrider,PVC namespace
    class ModelMesh,Prometheus inbound
    class ModelServers,MariaDB,MinIO,K8sAPI egress
