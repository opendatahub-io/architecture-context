graph TB
    subgraph AP["llm-d-async (Async Processor)"]
        direction TB
        Main["cmd/main.go<br/>Entrypoint"]
        Runner["Server Runner<br/>Transport Selection & Lifecycle"]
        Main --> Runner

        subgraph Transports["Transport Layer (Flow Interface)"]
            RedisPubSub["Redis Pub/Sub<br/>Transport"]
            RedisSortedSet["Redis Sorted Set<br/>Transport"]
            GCPPubSub["GCP Pub/Sub<br/>Transport"]
        end

        subgraph Gates["Dispatch Gate System"]
            BudgetGate["Budget Gates<br/>(capacity fraction 0..1)"]
            AdmissionGate["Admission Gates<br/>(per-message verdict)"]
            CompositeGate["Composite &<br/>Wait-on-Refuse<br/>Combinators"]
            RedisLeasedRate["Redis Leased Rate Gate<br/>(llm-d.ai/v1alpha1)"]
            BudgetGate --> CompositeGate
            AdmissionGate --> CompositeGate
            RedisLeasedRate --> CompositeGate
        end

        subgraph Workers["Worker Pool System"]
            Pool["Named Worker Pools<br/>(fixed concurrency)"]
            RandomRobin["Random-Robin<br/>Merge Policy"]
            TierPriority["Tier-Priority<br/>Merge Policy<br/>(6 priority lanes)"]
            Pool --> RandomRobin
            Pool --> TierPriority
        end

        Runner --> Transports
        Runner --> Gates
        Runner --> Workers

        HealthSrv["Health Server<br/>:8081 /healthz /readyz"]
        MetricsSrv["Metrics Server<br/>:9090 /metrics"]
    end

    subgraph Libraries["Library Modules"]
        APILib["api/<br/>RequestMessage, ResultMessage,<br/>Producer Interface"]
        PipelineLib["pipeline/<br/>Flow, Gate, MergePolicy<br/>Interfaces"]
        ProducerLib["producer/<br/>Producer SDK<br/>Durable Result Delivery"]
    end

    ExternalProducer["External Producer"] -->|submit requests| RedisPubSub
    ExternalProducer -->|submit requests| RedisSortedSet
    ExternalProducer -->|submit requests| GCPPubSub

    Workers -->|dispatch| Router["llm-d-router<br/>Inference Gateway"]
    Gates -->|query capacity| Prometheus["Prometheus"]
    RedisLeasedRate -->|read rate leases| Redis["Redis / Valkey"]

    ExternalConsumer["External Consumer"] -->|read results| Redis
    ProducerLib -.->|uses| APILib
    PipelineLib -.->|defines interfaces for| AP

    style AP fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Main fill:#4a90e2,color:#fff
    style Runner fill:#4a90e2,color:#fff
    style HealthSrv fill:#7ed321,color:#fff
    style MetricsSrv fill:#7ed321,color:#fff
    style Router fill:#f5a623,color:#fff
    style Prometheus fill:#999,color:#fff
    style Redis fill:#999,color:#fff
    style ExternalProducer fill:#f9f9f9,stroke:#333
    style ExternalConsumer fill:#f9f9f9,stroke:#333
    style APILib fill:#d5e8d4,stroke:#82b366
    style PipelineLib fill:#d5e8d4,stroke:#82b366
    style ProducerLib fill:#d5e8d4,stroke:#82b366
