graph TB
    subgraph TestSuite["Distributed Workloads Test Suite"]
        direction TB
        CommonSupport["tests/common/support<br/>Shared Test Infrastructure<br/>(K8s clients, helpers, assertions)"]

        subgraph TestSuites["Test Suites"]
            KFTO["tests/kfto<br/>KFTO v1 PyTorchJob Tests"]
            Trainer["tests/trainer<br/>Kubeflow Trainer v2 Tests<br/>(TrainJob, ClusterTrainingRuntime)"]
            FMS["tests/fms<br/>fms-hf-tuning GPU Tests"]
            ODH["tests/odh<br/>ODH Integration Tests<br/>(Ray, RayTune, Training Hub)"]
        end

        KFTO --> CommonSupport
        Trainer --> CommonSupport
        FMS --> CommonSupport
        ODH --> CommonSupport
    end

    subgraph RuntimeImages["Runtime Training Images"]
        RTCuda["runtime-training-cuda<br/>CUDA 13.0 + PyTorch 2.10<br/>OpenMPI 4.1"]
        RTRocm["runtime-training-rocm<br/>ROCm 6.4 + PyTorch 2.9.1<br/>OpenMPI 4.1"]
    end

    subgraph UniversalImages["Universal Training Images"]
        UTCpu["universal-training-cpu<br/>CPU + PyTorch 2.13<br/>Jupyter + ML Stack"]
        UTCuda["universal-training-cuda<br/>CUDA 13.0.2 + PyTorch 2.13<br/>Jupyter + vLLM + ML Stack"]
        UTRocm["universal-training-rocm<br/>ROCm 7.14 + PyTorch 2.12<br/>Jupyter + ML Stack"]
    end

    subgraph RayImages["Ray Cluster Images"]
        RayCpu["ray-cpu<br/>2.52.1-py311, 2.52.1-py312"]
        RayCuda["ray-cuda<br/>2.52.1-py311-cu121<br/>2.58.0-py312-cu128<br/>2.58.0-py312-cu129-th081"]
        RayRocm["ray-rocm<br/>2.52.1-py311-rocm61<br/>2.58.0-py312-rocm64"]
    end

    subgraph AIPCCBases["AIPCC Base Images"]
        CudaBase["quay.io/aipcc/base-images<br/>cuda-13.0-el9.6"]
        RocmBase["quay.io/aipcc/base-images<br/>rocm-6.4-el9.6"]
    end

    subgraph JupyterBases["Jupyter Workbench Bases"]
        JupCpu["odh-workbench-jupyter<br/>minimal-cpu-py312"]
        JupCuda["odh-workbench-jupyter<br/>minimal-cuda-py312"]
        JupRocm["odh-workbench-jupyter<br/>minimal-rocm-py312"]
    end

    %% Image inheritance
    RTCuda -->|extends| CudaBase
    RTRocm -->|extends| RocmBase
    UTCpu -->|extends| JupCpu
    UTCuda -->|extends| JupCuda
    UTRocm -->|extends| JupRocm

    %% Platform components tested
    KFTO -->|creates| PyTorchJobCR["PyTorchJob CR"]
    Trainer -->|creates| TrainJobCR["TrainJob CR"]
    Trainer -->|creates| ClusterTrainingRuntimeCR["ClusterTrainingRuntime CR"]
    ODH -->|creates| RayClusterCR["RayCluster CR"]
    ODH -->|creates| RayJobCR["RayJob CR"]
    KFTO -->|configures| KueueCR["Kueue CRDs<br/>(ClusterQueue, LocalQueue)"]
    Trainer -->|configures| KueueCR

    %% External integrations
    CommonSupport -->|REST API| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    CommonSupport -->|metrics| Prometheus["Prometheus API<br/>9090/TCP"]
    CommonSupport -->|dashboard| RayDashboard["Ray Dashboard<br/>8265/TCP"]

