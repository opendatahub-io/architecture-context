graph LR
    Gateway["vllm-orchestrator-gateway"]

    %% Internal Platform Dependencies
    Gateway -->|"POST /api/v2/chat/completions-detection<br/>HTTP/HTTPS 8085/TCP"| Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Key Rust Dependencies
    Gateway -->|"HTTP framework"| Axum["axum 0.7.9"]
    Gateway -->|"async runtime"| Tokio["tokio 1.41.1"]
    Gateway -->|"HTTP client<br/>(native-tls, streaming)"| Reqwest["reqwest 0.12.12"]
    Gateway -->|"TLS/mTLS"| OpenSSL["openssl 0.10.73<br/>+ native-tls 0.2.12"]
    Gateway -->|"JSON serde"| Serde["serde 1.0.215<br/>+ serde_json 1.0.133"]
    Gateway -->|"YAML config"| SerdeYml["serde_yml 0.0.12"]
    Gateway -->|"SSE streaming"| Futures["futures 0.3.30"]
    Gateway -->|"observability"| Tracing["tracing 0.1.41<br/>+ tracing-subscriber"]

    %% External Infrastructure
    Gateway -.->|"optional mTLS certs"| ServiceMesh["Service Mesh /<br/>cert-manager"]
    Gateway -.->|"CA trust"| ServiceCA["OpenShift<br/>Service CA"]

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style Axum fill:#999,stroke:#333,color:#fff
    style Tokio fill:#999,stroke:#333,color:#fff
    style Reqwest fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
    style Serde fill:#999,stroke:#333,color:#fff
    style SerdeYml fill:#999,stroke:#333,color:#fff
    style Futures fill:#999,stroke:#333,color:#fff
    style Tracing fill:#999,stroke:#333,color:#fff
    style ServiceMesh fill:#f5a623,stroke:#333,color:#fff
    style ServiceCA fill:#f5a623,stroke:#333,color:#fff
