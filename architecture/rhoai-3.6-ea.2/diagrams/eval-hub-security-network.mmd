graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Dashboard"]
    end

    subgraph AuthProxy["AUTH PROXY"]
        KubeRBAC["kube-rbac-proxy<br/>443/TCP<br/>TLS 1.2+<br/>Bearer Token → X-User/X-Tenant"]
    end

    subgraph Application["APPLICATION (eval-hub namespace)"]
        direction TB

        subgraph APIServer["eval-hub API Server"]
            API["API Server<br/>127.0.0.1:8080/TCP<br/>TLS 1.2-1.3 (when configured)<br/>FIPS: strictfipsruntime"]
        end

        subgraph MetricsSrv["Metrics Server"]
            Metrics["Prometheus Metrics<br/>0.0.0.0:8081/TCP<br/>HTTP (plaintext)<br/>No auth"]
        end
    end

    subgraph JobPods["EVALUATION JOB PODS (ephemeral)"]
        direction TB
        InitC["eval-runtime-init<br/>Init Container"]
        SidecarC["eval-runtime-sidecar<br/>8082/TCP<br/>TLS 1.2-1.3 (outbound)"]
        EvalFW["Evaluation Framework<br/>Adapter Container"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS, TLS 1.2+<br/>ServiceAccount"]
        MLflow["MLflow Tracking<br/>5000/TCP<br/>HTTP/HTTPS, TLS 1.2-1.3<br/>SA token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 / Git / HuggingFace<br/>443/TCP<br/>HTTPS<br/>AWS IAM / token"]
        OCI["OCI Registry<br/>443/TCP<br/>HTTPS, TLS 1.2-1.3<br/>Bearer / Docker config"]
        OTEL["OpenTelemetry Collector<br/>4317/TCP<br/>OTLP/gRPC<br/>TLS (configurable)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus"]
    end

    %% External to Auth Proxy
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| KubeRBAC

    %% Auth Proxy to API
    KubeRBAC -->|"HTTP(S)/8080<br/>TLS 1.2-1.3<br/>X-User + X-Tenant"| API

    %% API to Platform Services
    API -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    API -->|"HTTP(S)/5000<br/>TLS 1.2-1.3<br/>SA token"| MLflow

    %% API to Telemetry
    API -->|"OTLP/gRPC 4317<br/>TLS<br/>No auth"| OTEL

    %% Prometheus scrape
    Prometheus -->|"HTTP/8081<br/>No encryption<br/>No auth"| Metrics

    %% Job Pod flows
    K8sAPI -->|"creates"| JobPods
    InitC -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    EvalFW -->|"localhost:8082"| SidecarC
    SidecarC -->|"HTTPS/8080<br/>TLS 1.2-1.3<br/>SA token"| API
    SidecarC -->|"HTTP(S)/5000<br/>TLS 1.2-1.3<br/>SA token"| MLflow
    SidecarC -->|"HTTPS/443<br/>TLS 1.2-1.3<br/>Bearer token"| OCI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authproxy fill:#e17055,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef application fill:#4a90e2,stroke:#2c6fbb,stroke-width:2px,color:#fff
    classDef jobpod fill:#dfe6e9,stroke:#636e72,stroke-width:2px
    classDef platform fill:#50c878,stroke:#27ae60,stroke-width:2px,color:#fff
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#a29bfe,stroke:#6c5ce7,stroke-width:2px,color:#fff

    class Client external
    class KubeRBAC authproxy
    class API,Metrics application
    class InitC,SidecarC,EvalFW jobpod
    class K8sAPI,MLflow platform
    class S3,OCI,OTEL externalservice
    class Prometheus monitoring
