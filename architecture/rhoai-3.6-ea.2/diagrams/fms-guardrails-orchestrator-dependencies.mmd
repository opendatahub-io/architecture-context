graph LR
    Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies (downstream services)
    Orchestrator -->|"gRPC :8033<br/>text generation"| TGIS["TGIS Generation<br/>Service"]
    Orchestrator -->|"gRPC<br/>text generation"| CaikitNLP["Caikit-NLP<br/>Service"]
    Orchestrator -->|"HTTP/HTTPS<br/>chat/text completions"| OpenAISvc["OpenAI-Compatible<br/>Service"]
    Orchestrator -->|"HTTP/HTTPS :8080<br/>content detection"| Detectors["Detector Services<br/>(HAP, etc.)"]
    Orchestrator -->|"gRPC :8085<br/>text chunking"| Chunkers["Chunker Services"]

    %% Infrastructure Dependencies
    Orchestrator -->|"gRPC or HTTP<br/>traces & metrics"| OTLP["OTLP Collector"]

    %% Key Library Dependencies
    Orchestrator -.->|"HTTP framework"| Axum["axum 0.8.8"]
    Orchestrator -.->|"gRPC client"| Tonic["tonic 0.14.2"]
    Orchestrator -.->|"TLS (ring, NOT FIPS)"| Rustls["rustls 0.23.36"]
    Orchestrator -.->|"async runtime"| Tokio["tokio 1.49.0"]
    Orchestrator -.->|"gRPC load balancing"| Ginepro["ginepro<br/>(DNS-based LB)"]

    %% Upstream consumers (who calls the orchestrator)
    Clients["Client Applications"] -->|"HTTP/HTTPS :8033<br/>generation & detection"| Orchestrator
    K8s["Kubernetes Probes"] -->|"HTTP :8034<br/>health checks"| Orchestrator

    style Orchestrator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TGIS fill:#7ed321,stroke:#333,color:#fff
    style CaikitNLP fill:#7ed321,stroke:#333,color:#fff
    style OpenAISvc fill:#7ed321,stroke:#333,color:#fff
    style Detectors fill:#7ed321,stroke:#333,color:#fff
    style Chunkers fill:#7ed321,stroke:#333,color:#fff
    style OTLP fill:#f5a623,stroke:#333,color:#fff
    style Axum fill:#e8e8e8,stroke:#333
    style Tonic fill:#e8e8e8,stroke:#333
    style Rustls fill:#e8e8e8,stroke:#333
    style Tokio fill:#e8e8e8,stroke:#333
    style Ginepro fill:#e8e8e8,stroke:#333
    style Clients fill:#f9f9f9,stroke:#999
    style K8s fill:#f9f9f9,stroke:#999
