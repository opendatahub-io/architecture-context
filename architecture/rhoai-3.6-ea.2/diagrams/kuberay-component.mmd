graph TB
    subgraph KubeRay["KubeRay Operator"]
        direction TB

        subgraph Controllers["Core Controllers"]
            RCC[RayClusterReconciler]
            RJC[RayJobReconciler]
            RSC[RayServiceReconciler]
            RCJC["RayCronJobReconciler<br/>(feature-gated)"]
        end

        subgraph OpenShiftControllers["OpenShift Controllers"]
            AuthCtrl[AuthenticationController]
            NPCtrl[NetworkPolicyController]
            MTLSCtrl[RayClusterMTLSController]
            TLSWatch[TLS Profile Watcher]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutWH["Mutating Webhook<br/>9443/TCP"]
            ValCluster["Validating Webhook<br/>RayCluster"]
            ValJob["Validating Webhook<br/>RayJob"]
            ValService["Validating Webhook<br/>RayService"]
        end
    end

    %% CRDs
    RayClusterCR[RayCluster CR]
    RayJobCR[RayJob CR]
    RayServiceCR[RayService CR]
    RayCronJobCR[RayCronJob CR]

    %% CRD watches
    RayClusterCR -->|watched by| RCC
    RayJobCR -->|watched by| RJC
    RayServiceCR -->|watched by| RSC
    RayCronJobCR -->|watched by| RCJC
    RayClusterCR -->|watched by| AuthCtrl
    RayClusterCR -->|watched by| NPCtrl
    RayClusterCR -->|watched by| MTLSCtrl

    %% Webhook flow
    User[User] -->|creates/updates| RayClusterCR
    RayClusterCR -.->|admission| MutWH
    RayClusterCR -.->|admission| ValCluster
    RayJobCR -.->|admission| ValJob
    RayServiceCR -.->|admission| ValService

    %% Created resources
    RCC -->|creates| Pods[Pods]
    RCC -->|creates| Services[Services]
    RCC -->|creates| HeadSvc[Head Service]
    RJC -->|creates| ChildCluster[Child RayCluster]
    RJC -->|creates| BatchJob[Kubernetes Job]
    RSC -->|manages| BlueGreen["Blue-Green<br/>RayClusters"]

    %% OpenShift controller outputs
    AuthCtrl -->|injects| RBACProxy["kube-rbac-proxy<br/>sidecar"]
    AuthCtrl -->|creates| HTTPRoute[HTTPRoute]
    AuthCtrl -->|creates| RefGrant[ReferenceGrant]
    NPCtrl -->|creates| NetPol[NetworkPolicy]
    MTLSCtrl -->|creates| Certs["TLS Certificates<br/>(cert-manager)"]

    %% External dependencies
    RCC -->|depends on| K8sAPI[Kubernetes API]
    TLSWatch -->|watches| OSAPIServer["OpenShift APIServer<br/>TLS Profile"]
    AuthCtrl -->|uses| GatewayAPI[Gateway API]
    MTLSCtrl -->|uses| CertManager[cert-manager]

    %% Styling
    style RCC fill:#4a90e2,color:#fff
    style RJC fill:#4a90e2,color:#fff
    style RSC fill:#4a90e2,color:#fff
    style RCJC fill:#4a90e2,color:#fff
    style AuthCtrl fill:#e87040,color:#fff
    style NPCtrl fill:#e87040,color:#fff
    style MTLSCtrl fill:#e87040,color:#fff
    style TLSWatch fill:#e87040,color:#fff
    style MutWH fill:#9b59b6,color:#fff
    style ValCluster fill:#9b59b6,color:#fff
    style ValJob fill:#9b59b6,color:#fff
    style ValService fill:#9b59b6,color:#fff
    style RayClusterCR fill:#f5a623
    style RayJobCR fill:#f5a623
    style RayServiceCR fill:#f5a623
    style RayCronJobCR fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style CertManager fill:#e8e8e8
    style OSAPIServer fill:#e8e8e8
