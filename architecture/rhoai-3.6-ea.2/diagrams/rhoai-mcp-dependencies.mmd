graph LR
    RhoaiMCP["rhoai-mcp<br/>MCP Server"]

    %% External Python Dependencies
    RhoaiMCP -->|"MCP framework"| FastMCP["mcp >=1.26.0<br/>(FastMCP)"]
    RhoaiMCP -->|"K8s client"| K8sPy["kubernetes >=35.0.0"]
    RhoaiMCP -->|"plugin system"| Pluggy["pluggy >=1.6.0"]
    RhoaiMCP -->|"JWT auth"| PyJWT["PyJWT >=2.12.1<br/>(RS256, ES256)"]
    RhoaiMCP -->|"model reco"| LlmDPlanner["llm-d-planner >=0.3.0"]
    RhoaiMCP -->|"ASGI server"| Uvicorn["uvicorn 0.52.4"]

    %% Internal RHOAI Dependencies (via K8s API)
    RhoaiMCP -->|"CRD CRUD"| KubeflowNotebooks["Kubeflow Notebooks<br/>kubeflow.org/v1"]
