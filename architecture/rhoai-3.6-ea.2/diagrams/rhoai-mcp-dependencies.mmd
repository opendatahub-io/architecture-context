    RhoaiMCP -->|"CRD CRUD"| DSPA["Data Science Pipelines<br/>opendatahub.io/v1alpha1"]
    RhoaiMCP -->|"CRD Read"| DSC["DataScienceCluster<br/>opendatahub.io/v1"]

    %% Internal RHOAI Dependencies (REST)
    RhoaiMCP -->|"REST API"| ModelRegistry["Model Registry<br/>8080/8443"]
    RhoaiMCP -->|"REST API"| ModelCatalog["Model Catalog<br/>8080/8443"]

    %% Platform Dependencies
    RhoaiMCP -->|"resource mgmt"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    RhoaiMCP -->|"JWKS discovery"| OIDCProvider["OIDC Provider<br/>443/TCP"]
    RhoaiMCP -->|"project listing"| OSProjects["OpenShift Projects<br/>project.openshift.io"]
    RhoaiMCP -->|"route discovery"| OSRoutes["OpenShift Routes<br/>route.openshift.io"]

    %% Reverse dependencies (who calls rhoai-mcp)
    AIAgents["AI Agents<br/>Claude Desktop / Code"] -->|"MCP tool calls"| RhoaiMCP

