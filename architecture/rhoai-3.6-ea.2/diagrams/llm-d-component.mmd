graph TB
    subgraph LLM_D["llm-d Inference Stack"]
        subgraph Images["Container Images"]
            CPUImage["vLLM CPU Image<br/>ghcr.io/llm-d/llm-d-cpu<br/>Port 8000/TCP"]
            ROCmImage["vLLM ROCm Image<br/>ghcr.io/llm-d/llm-d-rocm<br/>Port 8000/TCP"]
            XPUImage["vLLM XPU Image<br/>ghcr.io/llm-d/llm-d-xpu<br/>Port 8000/TCP"]
            RDMATools["RDMA Tools Image<br/>Diagnostic Sidecar"]
            InteractivePod["Interactive Pod<br/>Developer Debugging"]
        end

        subgraph Orchestration["Deployment Orchestration"]
            GuideSystem["Guide System<br/>Kustomize / Helm<br/>10 accelerator types"]
            PodSnapshot["Pod Snapshot Launcher<br/>GKE Fast Snapshotting"]
        end
    end

    Client[External Client] -->|"HTTP :80"| Gateway["Gateway API<br/>Inference Gateway<br/>Port 80/TCP"]
    Gateway -->|"HTTP :8081"| Router["llm-d-router EPP<br/>Prefix-Cache-Aware<br/>Routing"]
    Router -->|"HTTP :8000"| CPUImage
    Router -->|"HTTP :8000"| ROCmImage
    Router -->|"HTTP :8000"| XPUImage

    RoutingSidecar["llm-d-routing-sidecar"] -.->|"In-pod routing"| CPUImage
    RoutingSidecar -.->|"In-pod routing"| ROCmImage

    CPUImage -->|"TCP :5600<br/>NIXL KV-Cache"| DecodePod["Decode Pod"]
    ROCmImage -->|"TCP :5600<br/>NIXL KV-Cache"| DecodePod

    subgraph ExternalSvc["External Services"]
        HFHub["HuggingFace Hub<br/>HTTPS :443"]
        Prometheus["Prometheus<br/>Metrics Scrape"]
        OTEL["OpenTelemetry Collector<br/>gRPC :4317"]
    end

    CPUImage -->|"HTTPS :443<br/>Bearer HF_TOKEN"| HFHub
    ROCmImage -->|"HTTPS :443<br/>Bearer HF_TOKEN"| HFHub
    XPUImage -->|"HTTPS :443<br/>Bearer HF_TOKEN"| HFHub
    CPUImage -.->|"HTTP :8000<br/>/metrics"| Prometheus
    CPUImage -.->|"gRPC :4317<br/>OTLP traces"| OTEL

    GuideSystem -.->|deploys| CPUImage
    GuideSystem -.->|deploys| ROCmImage
    GuideSystem -.->|deploys| XPUImage
    GuideSystem -.->|configures| Router
    PodSnapshot -.->|"checkpoint/restore"| CPUImage

    subgraph CRDs["Gateway API CRDs"]
        InferencePool["InferencePool CR"]
        InferenceModel["InferenceModel CR"]
        HTTPRoute["HTTPRoute CR"]
    end

    InferencePool -.->|"watched by"| Router
    InferenceModel -.->|"watched by"| Router
    HTTPRoute -.->|"routes to"| Gateway

    style CPUImage fill:#4a90e2,stroke:#333
    style ROCmImage fill:#4a90e2,stroke:#333
    style XPUImage fill:#4a90e2,stroke:#333
    style RDMATools fill:#4a90e2,stroke:#333
    style InteractivePod fill:#4a90e2,stroke:#333
    style GuideSystem fill:#7ed321,stroke:#333
    style PodSnapshot fill:#7ed321,stroke:#333
    style Gateway fill:#f5a623,stroke:#333
    style Router fill:#f5a623,stroke:#333
    style RoutingSidecar fill:#f5a623,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style OTEL fill:#e8e8e8,stroke:#333
    style InferencePool fill:#fff2cc,stroke:#d6b656
    style InferenceModel fill:#fff2cc,stroke:#d6b656
    style HTTPRoute fill:#fff2cc,stroke:#d6b656
    style DecodePod fill:#4a90e2,stroke:#333
