graph LR
    Notebooks["Notebooks<br/>(Container Image Factory)"]

    %% AIPCC Base Images
    Notebooks -->|"CPU base image"| AIPCC_CPU["AIPCC CPU Base<br/>RHEL 9.8 EUS"]
    Notebooks -->|"GPU base image"| AIPCC_CUDA["AIPCC CUDA 13.0 Base<br/>RHEL 9.8 EUS"]
    Notebooks -->|"AMD GPU base image"| AIPCC_ROCm["AIPCC ROCm 7.14 Base<br/>RHEL 9.8 EUS"]

    %% Core Runtime Dependencies
    Notebooks -->|"notebook IDE"| JupyterLab["JupyterLab 4.6.3"]
    Notebooks -->|"runtime"| Python["Python 3.12"]

    %% ML Frameworks
    Notebooks -->|"deep learning"| PyTorch["PyTorch 2.13.0"]
    Notebooks -->|"deep learning"| TensorFlow["TensorFlow 2.21.0"]
    Notebooks -->|"model compression"| LLMCompressor["LLM Compressor 0.13.0"]
    Notebooks -->|"explainability"| TrustyAI["TrustyAI 0.6.4"]

    %% Data Science Libraries
    Notebooks -->|"data science"| NumPy["NumPy 2.5.3"]
    Notebooks -->|"data science"| Pandas["Pandas 2.3.3"]
    Notebooks -->|"ML"| Sklearn["scikit-learn 1.9.1"]
    Notebooks -->|"NLP models"| Transformers["Transformers 5.14.1"]

    %% Pipeline & Tooling
    Notebooks -->|"pipeline editing"| Elyra["odh-elyra 5.0.3"]
    Notebooks -->|"notebook-to-pipeline"| Kale["odh-kale 2.2.0"]
    Notebooks -->|"pipeline SDK"| KFP["kfp 2.17.0"]
    Notebooks -->|"distributed compute"| CodeFlare["codeflare-sdk 0.39.1"]
    Notebooks -->|"experiment tracking"| MLflow["MLflow 3.16.0"]

    %% Storage & Crypto
    Notebooks -->|"S3 access"| Boto3["boto3 1.43.93"]
    Notebooks -->|"TLS/crypto"| Cryptography["cryptography 50.0.1"]

    %% Build Tools
    Notebooks -->|"build tools"| Go["Go 1.26.3"]

    %% Internal RHOAI Platform Dependencies
    ODHOperator["ODH Operator"] -->|"deploys ImageStreams"| Notebooks
    Dashboard["ODH Dashboard"] -->|"discovers workbenches"| Notebooks
    NotebookCtrl["ODH Notebook Controller"] -->|"injects OAuth proxy,<br/>CA bundles, ConfigMaps"| Notebooks
    DSPA["Data Science Pipelines"] -.->|"mounts secrets at<br/>/opt/app-root/runtimes/"| Notebooks

    %% External Services (runtime)
    Notebooks -.->|"pipeline submission"| KFPipelines["Kubeflow Pipelines API"]
    Notebooks -.->|"artifact storage"| S3["S3-Compatible Storage"]
    Notebooks -.->|"model downloads"| HFHub["HuggingFace Hub"]

    %% Build System
    Notebooks -->|"hermetic build"| Konflux["Konflux / Hermeto"]
    Notebooks -->|"image registry"| Registry["registry.redhat.io/rhoai/"]

