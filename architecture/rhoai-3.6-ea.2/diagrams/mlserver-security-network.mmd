graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PodBoundary["POD BOUNDARY (KServe InferenceService Pod)"]
        direction TB

        subgraph AuthLayer["AUTHENTICATION LAYER"]
            KRBAC["kube-rbac-proxy<br/>443/TCP (external)<br/>TLS (platform-managed)<br/>OpenShift OAuth validation"]
        end

        subgraph AppLayer["APPLICATION LAYER (No TLS)"]
            REST["MLServer REST<br/>8080/TCP HTTP<br/>No encryption (localhost)<br/>No auth (pre-validated)"]
            GRPC["MLServer gRPC<br/>8081/TCP h2c<br/>add_insecure_port<br/>No auth (pre-validated)"]
            Metrics["Metrics Server<br/>8082/TCP HTTP<br/>No encryption<br/>No auth"]
            TrustedRT["Trusted Runtimes Enforcer<br/>/etc/mlserver/trusted-runtimes.json<br/>Blocks unauthorized implementations"]
        end
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS STRICT)"]
        IstioSidecar["Istio Sidecar Proxy<br/>mTLS envelope"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        KServe["KServe Controller<br/>Manages InferenceService lifecycle"]
        Prometheus["Prometheus<br/>Metrics collection"]
    end

    subgraph OptionalEgress["OPTIONAL EGRESS (Configurable)"]
        Kafka["Kafka Broker<br/>9092/TCP<br/>Configurable encryption<br/>No auth"]
        OTLP["OTLP Collector<br/>Configurable port<br/>gRPC insecure=True<br/>No auth"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (platform)<br/>Bearer Token<br/>(OpenShift OAuth)"| KRBAC
    KRBAC -->|"HTTP/8080<br/>localhost<br/>No encryption<br/>Token validated"| REST
    KRBAC -->|"gRPC/8081<br/>localhost<br/>No encryption<br/>Token validated"| GRPC
    IstioSidecar -.->|"mTLS envelope<br/>wraps pod traffic"| PodBoundary
    Prometheus -->|"HTTP/8082<br/>No auth<br/>In-cluster"| Metrics
    KServe -.->|"K8s API<br/>pod management"| PodBoundary
    REST -.->|"gRPC (insecure)<br/>Optional"| OTLP
    REST -.->|"TCP/9092<br/>Optional"| Kafka

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef mesh fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class KRBAC auth
    class REST,GRPC,Metrics app
    class TrustedRT security
    class KServe,Prometheus platform
    class IstioSidecar mesh
    class Kafka,OTLP optional
