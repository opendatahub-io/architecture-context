graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Main["trustyai-operator-module-<br/>controller-manager"]
        SA_Proxy["{name}-proxy<br/>(per TrustyAIService)"]
        SA_EvalHub["{name}-service<br/>(per EvalHub)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Main["trustyai-operator-module-<br/>manager-rolebinding"]
        CRB_Proxy["{name}-{ns}-proxy-<br/>rolebinding"]
        CRB_Auth["{name}-{ns}-auth-<br/>reviewer-crb"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Main["trustyai-operator-module-<br/>manager-role"]
        CR_Proxy["trustyai-service-operator-<br/>proxy-role"]
        CR_Auth["trustyai-service-operator-<br/>evalhub-auth-reviewer-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["(core)<br/>ConfigMaps"]
        Pods["(core)<br/>Pods"]
        Secrets["(core)<br/>Secrets"]
        Services["(core)<br/>Services"]
        ServiceAccounts2["(core)<br/>ServiceAccounts"]
        PVCs["(core)<br/>PersistentVolumeClaims"]
        Namespaces["(core)<br/>Namespaces<br/>(read-only)"]
    end

    subgraph TrustyAIResources["TrustyAI API Resources"]
        TASCR["trustyai.opendatahub.io<br/>TrustyAIService"]
        EvalHubCR["trustyai.opendatahub.io<br/>EvalHub"]
        LMEvalCR["trustyai.opendatahub.io<br/>LMEvalJob"]
        GOrchCR["trustyai.opendatahub.io<br/>GuardrailsOrchestrator"]
        NemoCR["trustyai.opendatahub.io<br/>NemoGuardrails"]
    end

    subgraph PlatformResources["Platform API Resources"]
        InferenceServices["serving.kserve.io<br/>InferenceServices"]
        IstioResources["networking.istio.io<br/>VirtualServices,<br/>DestinationRules,<br/>EnvoyFilters"]
        RBACResources["rbac.authorization.k8s.io<br/>ClusterRoles, Roles,<br/>Bindings"]
        MonitoringResources["monitoring.coreos.com<br/>ServiceMonitors,<br/>Prometheuses"]
        Deployments["apps<br/>Deployments"]
        Jobs["batch<br/>Jobs"]
        OSRoutes["route.openshift.io<br/>Routes"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics<br/>(GET)"]
    end

    %% Bindings
    SA_Main -->|bound via| CRB_Main
    SA_Proxy -->|bound via| CRB_Proxy
    SA_EvalHub -->|bound via| CRB_Auth

    CRB_Main -->|grants| CR_Main
    CRB_Proxy -->|grants| CR_Proxy
    CRB_Auth -->|grants| CR_Auth

    %% Main role permissions
    CR_Main -->|"CRUD"| ConfigMaps
    CR_Main -->|"CRUD"| Pods
    CR_Main -->|"CRUD"| Secrets
    CR_Main -->|"CRUD"| Services
    CR_Main -->|"CRUD"| ServiceAccounts2
    CR_Main -->|"CRUD"| PVCs
    CR_Main -->|"read"| Namespaces
    CR_Main -->|"CRUD"| TASCR
    CR_Main -->|"CRUD"| EvalHubCR
    CR_Main -->|"CRUD"| LMEvalCR
    CR_Main -->|"CRUD"| GOrchCR
    CR_Main -->|"CRUD"| NemoCR
    CR_Main -->|"read + patch"| InferenceServices
    CR_Main -->|"CRUD"| IstioResources
    CR_Main -->|"CRUD"| RBACResources
    CR_Main -->|"CRUD"| MonitoringResources
    CR_Main -->|"CRUD"| Deployments
    CR_Main -->|"CRUD"| Jobs
    CR_Main -->|"CRUD"| OSRoutes
    CR_Main -->|"GET"| MetricsURL

    %% Styling
    style SA_Main fill:#4a90e2,color:#fff
    style SA_Proxy fill:#4a90e2,color:#fff
    style SA_EvalHub fill:#4a90e2,color:#fff
    style CR_Main fill:#f5a623
    style CR_Proxy fill:#f5a623
    style CR_Auth fill:#f5a623
    style CRB_Main fill:#b8d4f0
    style CRB_Proxy fill:#b8d4f0
    style CRB_Auth fill:#b8d4f0
    style TASCR fill:#7ed321
    style EvalHubCR fill:#7ed321
    style LMEvalCR fill:#7ed321
    style GOrchCR fill:#7ed321
    style NemoCR fill:#7ed321
    style InferenceServices fill:#7ed321
    style IstioResources fill:#7ed321
    style RBACResources fill:#7ed321
    style MonitoringResources fill:#7ed321
    style Deployments fill:#7ed321
    style Jobs fill:#7ed321
    style OSRoutes fill:#7ed321
    style ConfigMaps fill:#7ed321
    style Pods fill:#7ed321
