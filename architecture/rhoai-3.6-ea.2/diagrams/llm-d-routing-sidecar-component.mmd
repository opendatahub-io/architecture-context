graph TB
    subgraph External["External Clients"]
        Client["Client<br/>(OpenAI-compatible)"]
    end

    subgraph Ingress["OpenShift Ingress"]
        Route["OpenShift Route<br/>443/TCP edge TLS"]
    end

    subgraph SidecarComponent["llm-d-routing-sidecar"]
        direction TB
        ProxyServer["Proxy Server<br/>8000/TCP HTTPS TLS 1.2+"]
        ChatHandler["Chat Completions Handler<br/>/v1/chat/completions"]
        CompletionsHandler["Completions Handler<br/>/v1/completions"]
        HealthHandler["Health Check<br/>/health"]
        ConnectorNIXLv2["NIXL V2 Connector<br/>(default)"]
        ConnectorNIXLv1["NIXL V1 Connector<br/>(deprecated)"]
        ConnectorLMCache["LMCache Connector<br/>(deprecated)"]
        AllowlistValidator["AllowlistValidator<br/>SSRF Protection"]
        LRUCache["LRU Cache<br/>Prefiller Proxy Handlers"]
        TLSManager["TLS Manager<br/>Self-signed fallback"]
        BufferedWriter["bufferedResponseWriter<br/>In-memory response capture"]

        ProxyServer --> ChatHandler
        ProxyServer --> CompletionsHandler
        ProxyServer --> HealthHandler
        ChatHandler --> AllowlistValidator
        ChatHandler --> ConnectorNIXLv2
        ChatHandler --> ConnectorNIXLv1
        ChatHandler --> ConnectorLMCache
        CompletionsHandler --> AllowlistValidator
        CompletionsHandler --> ConnectorNIXLv2
        ConnectorNIXLv2 --> BufferedWriter
        ConnectorNIXLv2 --> LRUCache
        ConnectorNIXLv1 --> BufferedWriter
        ConnectorLMCache --> BufferedWriter
        ProxyServer --> TLSManager
    end

    subgraph KubernetesAPI["Kubernetes API"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS"]
        InferencePoolCR["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
    end

    subgraph LocalPod["Co-located Pod"]
        Decoder["vLLM Decoder<br/>8001/TCP HTTP/HTTPS"]
    end

    subgraph RemotePods["Remote Prefiller Pods"]
        Prefiller["vLLM Prefiller<br/>configurable port HTTP/HTTPS"]
    end

    Client -->|HTTPS/443| Route
    Route -->|HTTPS/8080| ProxyServer
    AllowlistValidator -->|Watch InferencePool + Pods| K8sAPI
    K8sAPI --- InferencePoolCR
    ConnectorNIXLv2 -->|"Prefill request<br/>(max_tokens=1)"| Prefiller
    ConnectorNIXLv2 -->|"Decode request<br/>(with kv_transfer_params)"| Decoder
    ProxyServer -->|Passthrough| Decoder

    style ProxyServer fill:#4a90e2,stroke:#333,color:#fff
    style ChatHandler fill:#4a90e2,stroke:#333,color:#fff
    style CompletionsHandler fill:#4a90e2,stroke:#333,color:#fff
    style HealthHandler fill:#4a90e2,stroke:#333,color:#fff
    style ConnectorNIXLv2 fill:#4a90e2,stroke:#333,color:#fff
    style ConnectorNIXLv1 fill:#999,stroke:#333,color:#fff
    style ConnectorLMCache fill:#999,stroke:#333,color:#fff
    style AllowlistValidator fill:#e74c3c,stroke:#333,color:#fff
    style LRUCache fill:#4a90e2,stroke:#333,color:#fff
    style TLSManager fill:#4a90e2,stroke:#333,color:#fff
    style BufferedWriter fill:#4a90e2,stroke:#333,color:#fff
    style Decoder fill:#7ed321,stroke:#333
    style Prefiller fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style InferencePoolCR fill:#f5a623,stroke:#333
    style Route fill:#ffe6cc,stroke:#d79b00
    style Client fill:#f9f9f9,stroke:#999
