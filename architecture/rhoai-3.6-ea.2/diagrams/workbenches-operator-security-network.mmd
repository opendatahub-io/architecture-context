graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Orchestrator["Platform Orchestrator"]
        User["Data Scientist"]
    end

    subgraph KubeAPI["KUBERNETES API SERVER (Trust Boundary)"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (workbenches-operator-system)"]
        direction TB

        subgraph HealthProbe["Health Probes"]
            Health["8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth"]
        end

        subgraph MetricsSvr["Metrics Server"]
            Metrics["8443/TCP HTTPS<br/>/metrics<br/>TLS 1.2+ (cluster profile)<br/>TokenReview + SAR"]
        end

        subgraph WebhookSvr["Webhook Server"]
            Webhook["9443/TCP HTTPS<br/>/workbenches-connection-notebook<br/>/workbenches-hardware-profile<br/>/convert<br/>TLS (service-CA/cert-manager)<br/>API server auth"]
        end

        ControllerMgr["workbenches-operator<br/>controller-manager<br/>SA: workbenches-operator-controller-manager"]

        ControllerMgr --- Health
        ControllerMgr --- Metrics
        ControllerMgr --- Webhook
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        ServiceCA["OpenShift service-CA<br/>TLS cert provisioning"]
        CertMgr["cert-manager<br/>TLS fallback provider"]
        Prometheus["prometheus-operator<br/>ServiceMonitor"]
        TLSProfile["OpenShift APIServer<br/>TLS security profile"]
        ImageStreams["OpenShift Image Streams<br/>image.openshift.io"]
    end

    %% External to API Server
    Orchestrator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| APIServer
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| APIServer

    %% API Server to Webhooks
    APIServer -->|"HTTPS/443→9443<br/>TLS (service-CA)<br/>TLS client cert"| Webhook

    %% Controller to API Server
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>SSA + watches"| APIServer

    %% Cluster service interactions
    ServiceCA -.->|provisions cert| Webhook
    CertMgr -.->|fallback cert| Webhook
    Prometheus -->|"HTTPS/8443<br/>scrape metrics"| Metrics
    TLSProfile -.->|cipher config| Metrics
    TLSProfile -.->|cipher config| Webhook
    ControllerMgr -->|"manages"| ImageStreams

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef healthstyle fill:#e8f5e9,stroke:#4caf50
    classDef metricsstyle fill:#e3f2fd,stroke:#2196f3
    classDef webhookstyle fill:#fce4ec,stroke:#e91e63

    class Orchestrator,User external
    class APIServer apiserver
    class ControllerMgr operator
    class Health healthstyle
    class Metrics metricsstyle
    class Webhook webhookstyle
    class ServiceCA,CertMgr,Prometheus,TLSProfile,ImageStreams clusterservice
