graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Argo["argo<br/>(workflow-controller)"]
        SA_ArgoServer["argo-server<br/>(API server)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Argo["argo-binding<br/>(cluster-wide)"]
        CRB_ArgoServer["argo-server-binding<br/>(cluster-wide)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Argo["argo-cluster-role"]
        CR_ArgoServer["argo-server-cluster-role"]
    end

    subgraph ArgoClusterRoleResources["argo-cluster-role Resources"]
        direction TB
        Pods_Argo["core<br/>pods, pods/exec"]
        ConfigMaps_Argo["core<br/>configmaps"]
        PVCs["core<br/>persistentvolumeclaims"]
        Workflows_Argo["argoproj.io<br/>workflows, workflows/finalizers"]
        WFTemplates_Argo["argoproj.io<br/>workflowtemplates,<br/>clusterworkflowtemplates"]
        CronWF_Argo["argoproj.io<br/>cronworkflows"]
        WFTaskSets["argoproj.io<br/>workflowtasksets,<br/>workflowtaskresults,<br/>workflowartifactgctasks"]
        Events_Argo["core<br/>events"]
        PDB["policy<br/>poddisruptionbudgets"]
        Secrets_Argo["core<br/>secrets<br/>(named: argo-workflows-agent-ca-certificates)"]
        SAs_Argo["core<br/>serviceaccounts"]
    end

    subgraph ArgoServerRoleResources["argo-server-cluster-role Resources"]
        direction TB
        ConfigMaps_Server["core<br/>configmaps"]
        Secrets_Server["core<br/>secrets"]
        Pods_Server["core<br/>pods, pods/exec, pods/log"]
        Events_Server["core<br/>events"]
        SAs_Server["core<br/>serviceaccounts"]
        ArgoprojAll["argoproj.io<br/>eventsources, sensors,<br/>workflows, workfloweventbindings,<br/>workflowtemplates, cronworkflows,<br/>clusterworkflowtemplates"]
    end

    SA_Argo -->|"bound via"| CRB_Argo
    CRB_Argo -->|"grants"| CR_Argo
    CR_Argo -->|"CRUD + watch"| Pods_Argo
    CR_Argo -->|"get, list, watch"| ConfigMaps_Argo
    CR_Argo -->|"create, update, delete, get"| PVCs
    CR_Argo -->|"full access"| Workflows_Argo
    CR_Argo -->|"get, list, watch"| WFTemplates_Argo
    CR_Argo -->|"full access"| CronWF_Argo
    CR_Argo -->|"full access"| WFTaskSets
    CR_Argo -->|"create, patch"| Events_Argo
    CR_Argo -->|"create, get, delete"| PDB
    CR_Argo -->|"get (named only)"| Secrets_Argo
    CR_Argo -->|"get, list"| SAs_Argo

    SA_ArgoServer -->|"bound via"| CRB_ArgoServer
    CRB_ArgoServer -->|"grants"| CR_ArgoServer
    CR_ArgoServer -->|"get, watch, list"| ConfigMaps_Server
    CR_ArgoServer -->|"get, create"| Secrets_Server
    CR_ArgoServer -->|"get, list, watch, delete"| Pods_Server
    CR_ArgoServer -->|"watch, create, patch"| Events_Server
    CR_ArgoServer -->|"get, list, watch"| SAs_Server
    CR_ArgoServer -->|"full CRUD"| ArgoprojAll

    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style SA_ArgoServer fill:#4a90e2,stroke:#333,color:#fff
    style CR_Argo fill:#f5a623,stroke:#333
    style CR_ArgoServer fill:#f5a623,stroke:#333
    style CRB_Argo fill:#e8e8e8,stroke:#333
    style CRB_ArgoServer fill:#e8e8e8,stroke:#333
    style Pods_Argo fill:#7ed321,stroke:#333
    style ConfigMaps_Argo fill:#7ed321,stroke:#333
    style PVCs fill:#7ed321,stroke:#333
    style Workflows_Argo fill:#7ed321,stroke:#333
    style WFTemplates_Argo fill:#7ed321,stroke:#333
    style CronWF_Argo fill:#7ed321,stroke:#333
    style WFTaskSets fill:#7ed321,stroke:#333
    style Events_Argo fill:#7ed321,stroke:#333
    style PDB fill:#7ed321,stroke:#333
    style Secrets_Argo fill:#f8cecc,stroke:#b85450
    style SAs_Argo fill:#7ed321,stroke:#333
    style ConfigMaps_Server fill:#7ed321,stroke:#333
    style Secrets_Server fill:#f8cecc,stroke:#b85450
    style Pods_Server fill:#7ed321,stroke:#333
    style Events_Server fill:#7ed321,stroke:#333
    style SAs_Server fill:#7ed321,stroke:#333
    style ArgoprojAll fill:#7ed321,stroke:#333
