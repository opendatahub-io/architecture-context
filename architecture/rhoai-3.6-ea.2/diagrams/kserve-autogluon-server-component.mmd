graph TB
    subgraph AutoGluonServer["AutoGluon Model Server (Python)"]
        direction TB
        MainEntry["__main__.py<br/>Server Entrypoint"]
        PredictorFactory["PredictorFactory<br/>Auto-detection Strategy"]
        TabularModel["TabularModel<br/>v1/v2 Protocol"]
        TSModel["TimeSeriesModel<br/>v1 Protocol Only"]
        RuntimePaths["RuntimePaths<br/>Non-root Filesystem"]
        MainEntry --> PredictorFactory
        PredictorFactory -->|"tries TabularPredictor first"| TabularModel
        PredictorFactory -->|"falls back to TimeSeriesPredictor"| TSModel
        MainEntry --> RuntimePaths
    end

    subgraph KServePythonSDK["KServe Python SDK"]
        direction TB
        FastAPIServer["FastAPI/Uvicorn<br/>8080/TCP HTTP"]
        GRPCServer["gRPC Server<br/>8081/TCP"]
        StorageModule["kserve-storage<br/>S3/GCS/Azure/HF"]
        MetricsEndpoint["Prometheus Metrics<br/>8080/TCP /metrics"]
    end

    subgraph GoControllers["Go Controller Plane (not in this build)"]
        direction TB
        Manager["kserve-controller-manager<br/>InferenceService, InferenceGraph,<br/>ServingRuntime, TrainedModel"]
        LLMISVC["llmisvc Controller<br/>LLMInferenceService<br/>Gateway API, KEDA, LWS"]
        LocalModel["localmodel Controller<br/>LocalModelCache"]
        LocalModelNode["localmodelnode Agent<br/>Node-level Model Cache"]
        Router["Router<br/>InferenceGraph Traffic"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        InferenceServiceCR["InferenceService<br/>serving.kserve.io/v1beta1"]
        InferenceGraphCR["InferenceGraph<br/>serving.kserve.io/v1alpha1"]
        LLMISVCR["LLMInferenceService<br/>serving.kserve.io/v1alpha1"]
        ServingRuntimeCR["ClusterServingRuntime<br/>kserve-autogluonserver"]
        LocalModelCacheCR["LocalModelCache<br/>serving.kserve.io/v1alpha1"]
        TrainedModelCR["TrainedModel<br/>serving.kserve.io/v1alpha1"]
    end

    Client["Client"] -->|"POST /v1/models/{name}:predict<br/>POST /v2/models/{name}/infer"| FastAPIServer
    Client -->|"gRPC ModelInfer"| GRPCServer

    FastAPIServer --> MainEntry
    GRPCServer --> MainEntry
    StorageModule -->|"downloads model"| TabularModel
    StorageModule -->|"downloads model"| TSModel

    ServingRuntimeCR -->|"defines runtime for"| AutoGluonServer
    InferenceServiceCR -->|"watched by"| Manager
    InferenceGraphCR -->|"watched by"| Manager
    LLMISVCR -->|"watched by"| LLMISVC
    LocalModelCacheCR -->|"watched by"| LocalModel

    Manager -->|"creates pods running"| AutoGluonServer

    subgraph ExternalDeps["External Dependencies"]
        Istio["Istio<br/>VirtualService"]
        Knative["Knative Serving"]
        KEDA["KEDA<br/>ScaledObject"]
        CertManager["cert-manager"]
        GatewayAPI["Gateway API<br/>HTTPRoute"]
    end

    Manager -->|"traffic routing"| Istio
    Manager -->|"serverless"| Knative
    Manager -->|"autoscaling"| KEDA
    LLMISVC -->|"HTTPRoute"| GatewayAPI
    LLMISVC -->|"autoscaling"| KEDA

    subgraph ModelStorage["Model Storage"]
        S3["S3/GCS/Azure Blob<br/>443/TCP HTTPS"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS"]
    end

    StorageModule -->|"HTTPS/443<br/>IAM/Bearer"| S3
    StorageModule -->|"HTTPS/443<br/>Bearer token"| HuggingFace

    style AutoGluonServer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style KServePythonSDK fill:#50a0d2,stroke:#333,stroke-width:2px,color:#fff
    style GoControllers fill:#999,stroke:#333,stroke-width:1px
    style CRDs fill:#f5a623,stroke:#333,stroke-width:1px
    style ExternalDeps fill:#e8e8e8,stroke:#333,stroke-width:1px
    style ModelStorage fill:#7ed321,stroke:#333,stroke-width:1px
    style Client fill:#f9f9f9,stroke:#333,stroke-width:2px
