graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        PraxisGW["Praxis (MaaS Gateway)<br/>443/TCP HTTPS<br/>TLS, User Auth"]
        IngressRes["Ingress Resource<br/>443/TCP HTTPS<br/>TLS (user-provided secret)<br/>(legacy mode only)"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph OperatorNS["Namespace: redhat-ods-applications"]
            OperatorPod["OGX Operator Pod<br/>SA: ogx-k8s-operator-controller-manager"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>TLS (OpenShift profile)<br/>FilterProvider authn/authz"]
            WebhookSvc["Webhook Service<br/>443→9443/TCP HTTPS<br/>TLS (service-serving-cert)<br/>Admission validation"]
            OperatorPod --- MetricsSvc
            OperatorPod --- WebhookSvc
        end

        subgraph UserNS["Namespace: {user-namespace}"]
            OGXPod["OGX Server Pod<br/>8321/TCP HTTP<br/>NetworkPolicy enforced"]
            OGXSvc["OGX Service<br/>8321/TCP HTTP"]
            OGXPod --- OGXSvc
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ContainerReg["Container Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry Auth"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS<br/>User Auth"| PraxisGW
    Client -->|"HTTPS/443<br/>TLS<br/>(legacy mode)"| IngressRes
    IngressRes -->|"HTTP/8321<br/>cluster-internal"| OGXPod

    %% Praxis to OGX (NetworkPolicy restricted)
    PraxisGW -->|"HTTP/8321<br/>No encryption<br/>x-user-id/x-tenant-id headers<br/>NetworkPolicy: Praxis pods only"| OGXPod

    %% Operator flows
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    OperatorPod -->|"HTTP/8321<br/>No auth<br/>Status polling"| OGXPod
    OperatorPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry auth"| ContainerReg

    %% K8s API to webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS (service-serving-cert)<br/>Admission review"| WebhookSvc

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS (OpenShift profile)<br/>metrics-reader RBAC"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef clusterinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class PraxisGW,IngressRes ingress
    class OperatorPod,MetricsSvc,WebhookSvc operator
    class OGXPod,OGXSvc,K8sAPI,Prometheus clusterinternal
    class ContainerReg externalservice
