graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["openshift-kueue-operator<br/>(Operator SA)"]
        SA_Controller["kueue-controller-manager<br/>(Operand SA)"]
        SA_Prometheus["prometheus-k8s<br/>(Monitoring SA)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Operator["openshift-kueue-operator<br/>binding"]
        CRB_Manager["kueue-manager-rolebinding"]
        CRB_Metrics["kueue-metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_Leader["kueue-leader-election-rolebinding<br/>(openshift-kueue-operator ns)"]
        RB_Prometheus["prometheus-k8s<br/>(openshift-kueue-operator ns)"]
        RB_AuthReader["kueue-visibility-server-auth-reader<br/>(kube-system ns)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Operator["openshift-kueue-operator"]
        CR_Manager["kueue-manager-role"]
        CR_MetricsReader["kueue-metrics-reader"]
        CR_MetricsAuth["kueue-metrics-auth-role"]
    end

    subgraph Roles["Roles (Namespaced)"]
        R_Leader["kueue-leader-election-role"]
        R_Prometheus["prometheus-k8s"]
        R_AuthReader["extension-apiserver-authentication-reader"]
    end

    subgraph OperatorResources["Operator Resources"]
        Kueues["kueue.openshift.io<br/>kueues, kueues/status, kueues/finalizers"]
        Deployments["apps<br/>deployments, replicasets"]
        Webhooks["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations"]
        CRDRes["apiextensions.k8s.io<br/>customresourcedefinitions"]
        CertMgrRes["cert-manager.io<br/>issuers, certificates"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
    end

    subgraph ManagerResources["Manager Resources"]
        KueueCRDs["kueue.x-k8s.io<br/>admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads"]
        BatchJobs["batch<br/>jobs"]
        KubeflowRes["kubeflow.org<br/>mpijobs, paddlejobs,<br/>pytorchjobs, tfjobs, xgboostjobs"]
        RayRes["ray.io<br/>rayclusters, rayjobs"]
        CodeFlareRes["workload.codeflare.dev<br/>appwrappers"]
        JobSetRes["jobset.x-k8s.io<br/>jobsets"]
        CoreRes["core<br/>pods, secrets, events, podtemplates"]
    end

    subgraph MetricsResources["Metrics Resources"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Operator
    CRB_Operator -->|grants| CR_Operator
    CR_Operator -->|"CRUD + bind, escalate"| Kueues
    CR_Operator -->|CRUD| Deployments
    CR_Operator -->|CRUD| Webhooks
    CR_Operator -->|CRUD| CRDRes
    CR_Operator -->|CRUD| CertMgrRes
    CR_Operator -->|"CRUD + bind, escalate"| RBACRes

    %% Controller SA bindings
    SA_Controller -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager
    CR_Manager -->|CRUD| KueueCRDs
    CR_Manager -->|"get, list, patch, update, watch"| BatchJobs
    CR_Manager -->|"get, list, patch, update, watch"| KubeflowRes
    CR_Manager -->|"get, list, patch, update, watch"| RayRes
    CR_Manager -->|"get, list, patch, update, watch"| CodeFlareRes
    CR_Manager -->|"get, list, patch, update, watch"| JobSetRes
    CR_Manager -->|various| CoreRes

    SA_Controller -->|bound via| CRB_Metrics
    CRB_Metrics -->|grants| CR_MetricsAuth

    SA_Controller -->|bound via| RB_Leader
    RB_Leader -->|grants| R_Leader

    SA_Controller -->|bound via| RB_AuthReader
    RB_AuthReader -->|grants| R_AuthReader

    %% Metrics reader
    CR_MetricsReader -->|get| MetricsURL

    %% Prometheus
    SA_Prometheus -->|bound via| RB_Prometheus
    RB_Prometheus -->|grants| R_Prometheus

    style SA_Operator fill:#4a90e2,color:#fff
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_Prometheus fill:#7ed321
    style CR_Operator fill:#f5a623
    style CR_Manager fill:#f5a623
    style CR_MetricsReader fill:#f5a623
    style CR_MetricsAuth fill:#f5a623
    style KueueCRDs fill:#d5e8d4,stroke:#82b366
    style BatchJobs fill:#d5e8d4,stroke:#82b366
    style KubeflowRes fill:#d5e8d4,stroke:#82b366
    style RayRes fill:#d5e8d4,stroke:#82b366
    style CodeFlareRes fill:#d5e8d4,stroke:#82b366
    style JobSetRes fill:#d5e8d4,stroke:#82b366
