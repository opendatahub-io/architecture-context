graph TB
    subgraph KAP["kube-auth-proxy"]
        direction TB

        subgraph Middleware["Middleware Chain (justinas/alice)"]
            direction LR
            Logging["Request Logging"]
            HealthCheck["Health Checks<br/>/ping, /ready"]
            Metrics["Prometheus Metrics"]
            HTTPSRedirect["HTTPS Redirect"]
        end

        subgraph AuthPipeline["Authentication Pipeline"]
            direction TB
            K8sTokenLoader["K8s Token Session Loader<br/>(runs first, independent of provider)"]
            BearerTokenLoader["Bearer Token Loader<br/>(JWT for OIDC / OAuth for OpenShift)"]
            BasicAuth["Basic Auth<br/>(htpasswd)"]
            CookieSession["Cookie Session Loader"]
        end

        subgraph Core["Core Components"]
            OAuthProxy["OAuthProxy Engine"]
            TokenReviewValidator["TokenReviewValidator<br/>SHA-256 cache + singleflight"]
            SessionStore["Session Store<br/>(Cookie or Redis/Valkey)"]
        end

        subgraph Providers["Auth Providers"]
            OIDCProvider["OIDC Provider<br/>PKCE + RP-Initiated Logout"]
            OpenShiftProvider["OpenShift Provider<br/>Auto-discovery via .well-known"]
        end

        subgraph Handlers["Specialized Handlers"]
            ExtAuthz["/oauth2/auth Endpoint<br/>Envoy ext_authz<br/>(200/401/403)"]
            MLflowHandler["MLflow AuthDeny Handler<br/>JSON error responses"]
        end
    end

    Client["Client Browser / API Client"] -->|"HTTP(S) :4180"| Middleware
    Middleware --> AuthPipeline
    K8sTokenLoader -->|"validates SA tokens"| TokenReviewValidator
    TokenReviewValidator -->|"TokenReview API :6443"| K8sAPI["Kubernetes API Server"]
    BearerTokenLoader --> OAuthProxy
    BasicAuth --> OAuthProxy
    CookieSession --> SessionStore
    OAuthProxy --> Providers
    OIDCProvider -->|"OIDC flow :443"| OIDCIdP["OIDC Identity Provider"]
    OpenShiftProvider -->|"OAuth flow :443"| OSoauth["OpenShift OAuth Server"]
    SessionStore -->|"optional"| Redis["Redis / Valkey"]
    OAuthProxy -->|"forward authenticated requests"| Upstream["Upstream Application(s)"]
    OAuthProxy --> ExtAuthz
    OAuthProxy --> MLflowHandler
    ExtAuthz -->|"200 + identity headers"| Envoy["Envoy Proxy"]

    style KAP fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style OAuthProxy fill:#4a90e2,color:#fff
    style TokenReviewValidator fill:#4a90e2,color:#fff
    style OIDCProvider fill:#4a90e2,color:#fff
    style OpenShiftProvider fill:#4a90e2,color:#fff
    style ExtAuthz fill:#f5a623,color:#fff
    style MLflowHandler fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OIDCIdP fill:#e8e8e8,stroke:#333
    style OSoauth fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style Upstream fill:#7ed321,color:#fff
    style Envoy fill:#7ed321,color:#fff
