graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / DSP Server"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer / ServiceAccount tokens"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE"]
        Controller["workflow-controller<br/>SA: argo<br/>9090/TCP metrics (HTTP)<br/>6060/TCP healthz (HTTP)<br/>FIPS: GOFIPS140=v1.0.0"]
    end

    subgraph WorkflowNS["WORKFLOW NAMESPACE(S) (Per-Tenant)"]
        direction TB
        WorkflowPod["Workflow Pod"]
        ArgoExec["argoexec sidecar<br/>FIPS: GOFIPS140=v1.0.0"]
        ArgoExec --- WorkflowPod
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 / Minio<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        GCS["GCS<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Key"]
        Azure["Azure Blob<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Azure Identity"]
    end

    subgraph OptionalServices["OPTIONAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Encryption: Configurable<br/>Auth: Password"]
        MySQL["MySQL<br/>3306/TCP<br/>Encryption: Configurable<br/>Auth: Password"]
    end

    subgraph Monitoring["MONITORING"]
        Kubelet["Kubelet"]
        Prometheus["Prometheus"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"Watch (informer)<br/>TLS 1.2+<br/>ServiceAccount"| Controller
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    Controller -->|"Creates pods in"| WorkflowNS
    ArgoExec -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    ArgoExec -->|"HTTPS/443<br/>TLS 1.2+<br/>Cloud Credentials"| S3
    ArgoExec -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Key"| GCS
    ArgoExec -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure Identity"| Azure
    Controller -.->|"TCP/5432<br/>Configurable<br/>Password"| PostgreSQL
    Controller -.->|"TCP/3306<br/>Configurable<br/>Password"| MySQL

    %% Health & Monitoring
    Kubelet -->|"HTTP/6060<br/>No TLS<br/>No Auth"| Controller
    Prometheus -->|"HTTP/9090<br/>No TLS<br/>No Auth"| Controller

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workflow fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Controller controller
    class WorkflowPod,ArgoExec workflow
    class S3,GCS,Azure externalservice
    class PostgreSQL,MySQL optional
    class Kubelet,Prometheus monitoring
