graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph OrchestratorZone["ORCHESTRATOR (Conditional TLS)"]
        direction TB

        subgraph GuardrailsPort["Port 8033 — Guardrails Server"]
            Orchestrator["fms-guardrails-orchestr8<br/>Rust (axum + tonic)<br/>User: orchestr8 (UID 1001)<br/>TLS: rustls + ring (NOT FIPS)<br/>mTLS: optional"]
        end

        subgraph HealthPort["Port 8034 — Health Server"]
            Health["Health/Info<br/>HTTP plaintext<br/>No Auth"]
        end
    end

    subgraph DownstreamServices["DOWNSTREAM SERVICES"]
        direction TB

        TGIS["TGIS Generation<br/>8033/TCP gRPC<br/>TLS optional"]
        CaikitNLP["Caikit-NLP Generation<br/>gRPC<br/>TLS optional"]
        Chunker["Chunker Services<br/>8085/TCP gRPC<br/>TLS optional"]
        Detector["Detector Services<br/>8080/TCP HTTP/HTTPS<br/>TLS optional<br/>Bearer token optional"]
        DetectorHealth["Detector Health<br/>8081/TCP HTTP<br/>No Auth"]
        OpenAISvc["OpenAI-Compatible<br/>HTTP/HTTPS<br/>TLS optional<br/>API token (env var)"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTLP["OTLP Collector<br/>gRPC or HTTP<br/>Configurable"]
    end

    subgraph K8s["KUBERNETES"]
        Probes["K8s Probes<br/>(liveness/readiness)"]
    end

    %% Inbound flows
    Client -->|"HTTP(S)/8033<br/>TLS 1.2+ optional<br/>Header passthrough<br/>X-Fwd-Access-Token rewrite"| Orchestrator
    Probes -->|"HTTP/8034<br/>Plaintext<br/>No Auth"| Health

    %% Outbound flows
    Orchestrator -->|"gRPC/8033<br/>TLS optional<br/>DNS LB (ginepro)"| TGIS
    Orchestrator -->|"gRPC<br/>TLS optional"| CaikitNLP
    Orchestrator -->|"gRPC/8085<br/>TLS optional"| Chunker
    Orchestrator -->|"HTTP(S)/8080<br/>TLS optional<br/>Bearer token"| Detector
    Orchestrator -->|"HTTP/8081<br/>No Auth"| DetectorHealth
    Orchestrator -->|"HTTP(S)<br/>TLS optional<br/>API token"| OpenAISvc
    Orchestrator -->|"gRPC or HTTP<br/>Traces + Metrics"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef orchestrator fill:#4a90e2,stroke:#2a6bbd,stroke-width:2px,color:#fff
    classDef health fill:#50c878,stroke:#3a9a5c,stroke-width:2px,color:#fff
    classDef downstream fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class Orchestrator orchestrator
    class Health health
    class TGIS,CaikitNLP,Chunker,Detector,DetectorHealth,OpenAISvc downstream
    class OTLP observability
    class Probes k8s
