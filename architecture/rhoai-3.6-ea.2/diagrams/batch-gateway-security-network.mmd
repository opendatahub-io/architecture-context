graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        Gateway["Kuadrant/Authorino Gateway<br/>443/TCP<br/>TLS 1.2+<br/>API Key / Token Auth"]
    end

    subgraph Internal["INTERNAL (Cluster Network)"]
        direction TB

        subgraph NSBatch["Namespace: release namespace"]
            APIServer["batch-gateway-apiserver<br/>SA: batch-gateway-apiserver<br/>Port: 8000/TCP HTTP(S)<br/>Optional TLS 1.2+<br/>Non-root, read-only rootfs<br/>Drop ALL caps, seccomp"]

            APIServerObs["apiserver observability<br/>Port: 8081/TCP HTTP<br/>No auth"]

            Processor["batch-gateway-processor<br/>SA: batch-gateway-processor<br/>StatefulSet<br/>Port: 9090/TCP HTTP<br/>Non-root, read-only rootfs<br/>Drop ALL caps, seccomp"]

            GarbageCollector["batch-gateway-gc<br/>SA: batch-gateway-gc<br/>Port: 9091/TCP HTTP<br/>Non-root, read-only rootfs<br/>Drop ALL caps, seccomp"]
        end
    end

    subgraph DataLayer["DATA LAYER"]
        PostgreSQL["PostgreSQL<br/>TCP<br/>Configured by runtime<br/>Auth: Connection URL from Secret"]
        Redis["Redis/Valkey<br/>TCP<br/>Optional TLS<br/>Auth: Connection URL from Secret"]
        S3["S3-compatible Storage<br/>HTTP(S)<br/>Configured by runtime<br/>Auth: Access Key from Secret"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLMd["llm-d Inference Gateway<br/>HTTP(S)<br/>Optional TLS 1.2+ / mTLS<br/>Optional API Key"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable encryption"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key / Token"| Gateway
    Gateway -->|"HTTP(S)/8000<br/>Optional TLS 1.2+<br/>X-MaaS-Username header"| APIServer

    %% API Server egress
    APIServer -->|"TCP<br/>Configured<br/>Connection URL"| PostgreSQL
    APIServer -->|"TCP<br/>Optional TLS<br/>Connection URL"| Redis
    APIServer -->|"HTTP(S)<br/>Configured<br/>Access Key"| S3
    APIServer -->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Processor egress
    Processor -->|"TCP<br/>Configured<br/>Connection URL"| PostgreSQL
    Processor -->|"TCP<br/>Optional TLS<br/>Connection URL"| Redis
    Processor -->|"HTTP(S)<br/>Configured<br/>Access Key"| S3
    Processor -->|"HTTP(S)<br/>Optional TLS 1.2+ / mTLS<br/>Optional API Key"| LLMd
    Processor -->|"OTLP/gRPC<br/>Configurable"| OTel

    %% GC egress
    GarbageCollector -->|"TCP<br/>Configured<br/>Connection URL"| PostgreSQL
    GarbageCollector -->|"TCP<br/>Optional TLS<br/>Connection URL"| Redis
    GarbageCollector -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datalayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class APIServer,APIServerObs,Processor,GarbageCollector internal
    class PostgreSQL,Redis,S3 datalayer
    class LLMd,OTel,K8sAPI externalservice
