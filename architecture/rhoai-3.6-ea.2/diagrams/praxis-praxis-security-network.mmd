graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Praxis["PRAXIS PROXY (Single Process)"]
        direction TB

        subgraph ListenerZone["Proxy Listener"]
            Listener["Proxy Listener<br/>8080/TCP (configurable)<br/>HTTP/HTTPS<br/>TLS 1.2/1.3 (rustls+OpenSSL)<br/>Optional mTLS"]
        end

        subgraph FilterZone["Filter Pipeline (in-process)"]
            direction LR
            SecurityFilters["Security Filters<br/>basic_auth, cors, csrf,<br/>ip_acl, policy, guardrails"]
            TrafficFilters["Traffic Filters<br/>router, load_balancer,<br/>rate_limit, circuit_breaker"]
        end

        subgraph InternalServices["Internal Endpoints"]
            HealthEndpoint["Health/Metrics<br/>9902/TCP HTTP<br/>DNS rebinding check<br/>/healthy, /ready, /metrics"]
            AdminEndpoint["Admin API<br/>Loopback-restricted<br/>DNS rebinding check<br/>/api/stats, /api/pipelines,<br/>/api/log-level, /api/kv/*"]
        end

        subgraph CryptoZone["Crypto Layer"]
            CryptoProvider["OpenSSL Crypto Provider<br/>Single process-wide<br/>No fallback<br/>FIPS: libcrypto.so.3 on UBI 9"]
        end
    end

    subgraph UpstreamZone["UPSTREAM SERVICES"]
        Upstream["Upstream Clusters<br/>HTTP/HTTPS/TCP<br/>TLS verification on by default<br/>Per-cluster credentials"]
    end

    subgraph ObservabilityZone["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes 9902/TCP<br/>HTTP"]
        OTel["OpenTelemetry Collector<br/>gRPC/HTTP OTLP<br/>Optional TLS"]
    end

    %% External flows
    Client -->|"HTTP/HTTPS 8080/TCP<br/>TLS 1.2/1.3<br/>Optional mTLS<br/>Reserved headers rejected (400)"| Listener
    Listener --> SecurityFilters
    SecurityFilters --> TrafficFilters
    TrafficFilters -->|"HTTP/HTTPS/TCP<br/>Configurable port<br/>TLS verification on<br/>Credential injection"| Upstream

    %% Observability flows
    Prometheus -->|"HTTP 9902/TCP<br/>No encryption<br/>Loopback-host check"| HealthEndpoint
    HealthEndpoint -.->|"OTLP export<br/>Optional TLS"| OTel

    %% Crypto support
    CryptoProvider -.->|"TLS operations"| Listener

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef listener fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef filter fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef crypto fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef upstream fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Listener listener
    class SecurityFilters,TrafficFilters filter
    class HealthEndpoint,AdminEndpoint internal
    class CryptoProvider crypto
    class Upstream upstream
    class Prometheus,OTel observability
