graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["Platform Gateway<br/>(data-science-gateway)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Platform Auth"]
    end

    subgraph OperatorNamespace["NAMESPACE: redhat-ods-applications"]
        direction TB

        subgraph OperatorPod["mlflow-operator-controller-manager"]
            HealthProbe["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
            MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TLS (service-ca)<br/>TokenReview + SAR"]
        end

        subgraph ManagedResources["Managed MLflow Resources"]
            MLflowSvc["MLflow Service<br/>:8080/TCP<br/>HTTP/HTTPS"]
            MLflowDeploy["MLflow Deployment"]
        end

        MetricsCert["Secret: controller-manager-metrics-tls<br/>kubernetes.io/tls<br/>Provisioned by: service-ca-operator<br/>Auto-rotate: Yes"]
        ArtifactSecret["Secret: mlflow-artifact-connection<br/>Opaque (S3 credentials)<br/>User-provisioned<br/>Auto-rotate: No"]
    end

    subgraph Monitoring["NAMESPACE: monitoring"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        ServiceCA["service-ca-operator<br/>Certificate Provisioning"]
        OpenShiftAPIServer["OpenShift APIServer<br/>TLS Profile Config"]
        Console["OpenShift Console<br/>ConsoleLink"]
        AuthCR["ODH Auth CR<br/>CRD Watch"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform Auth"| Gateway
    Gateway -->|"HTTP/8080<br/>HTTPRoute<br/>self_subject_access_review"| MLflowSvc

    %% Monitoring flows
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>TokenReview + SAR"| MetricsEndpoint

    %% Operator to platform flows
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ServiceCA -.->|"cert provisioning"| MetricsCert
    OperatorPod -.->|"reads TLS profile"| OpenShiftAPIServer
    OperatorPod -.->|"creates ConsoleLink"| Console
    OperatorPod -.->|"watches Auth CR"| AuthCR

    %% NetworkPolicy
    NetworkPolicy["NetworkPolicy<br/>Ingress: 8081 (probes)<br/>8443 (monitoring ns only)"]

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gateway ingress
    class HealthProbe,MetricsEndpoint,OperatorPod operator
    class MLflowSvc,MLflowDeploy managed
    class K8sAPI,ServiceCA,OpenShiftAPIServer,Console,AuthCR platform
    class Prometheus monitoring
    class MetricsCert,ArtifactSecret secret
