graph TB
    subgraph OperatorNS["OPERATOR NAMESPACE (trainer-operator-system)"]
        direction TB

        subgraph OperatorPod["trainer-operator-controller-manager Pod"]
            Controller["trainer-operator-controller-manager<br/>SA: trainer-operator-controller-manager<br/>FIPS: strictfipsruntime + ubi9-minimal-pqc"]
            HealthPort["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            MetricsPort["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>TokenReview + SAR"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS (service-ca cert)"]
        NetPol["NetworkPolicy: allow-metrics-traffic<br/>Allows: same-ns, openshift-monitoring,<br/>openshift-user-workload-monitoring,<br/>redhat-ods-monitoring"]
    end

    subgraph Monitoring["MONITORING NAMESPACES"]
        Prometheus["Prometheus<br/>openshift-monitoring /<br/>openshift-user-workload-monitoring"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        APIServer["OpenShift APIServer<br/>TLS Profile Config"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (opendatahub namespace)"]
        TrainerCR["Trainer CR<br/>(default-trainer)<br/>Cluster-scoped singleton"]
        KubeflowCRDs["Kubeflow Trainer CRDs<br/>TrainJob, ClusterTrainingRuntime,<br/>TrainingRuntime"]
        TrainerDeploy["Upstream Trainer Controller<br/>Deployment"]
        Webhooks["Webhook Configurations<br/>(mutating + validating)"]
        Runtimes["ClusterTrainingRuntimes<br/>(torch-distributed, training-hub)"]
        ImgStreams["ImageStreams<br/>(CUDA, ROCm, CPU)"]
    end

    subgraph Dependencies["PLATFORM DEPENDENCIES"]
        JobSetOp["JobSet Operator<br/>(OLM managed)"]
        PromOp["prometheus-operator"]
        PlatformOp["ODH Platform Operator"]
    end

    %% Kubelet probes
    Kubelet["Kubelet"] -->|"HTTP/8081<br/>No Auth"| HealthPort

    %% Metrics flow
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer token"| MetricsSvc
    MetricsSvc -->|"forward"| MetricsPort
    NetPol -.->|"restricts access to"| MetricsSvc

    %% Controller → K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Watches, SSA Apply,<br/>CRD CRUD, GC"| K8sAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>Read TLS profile"| APIServer

    %% Managed resources
    K8sAPI -.->|"manages"| TrainerCR
    K8sAPI -.->|"manages"| KubeflowCRDs
    K8sAPI -.->|"manages"| TrainerDeploy
    K8sAPI -.->|"manages"| Webhooks
    K8sAPI -.->|"manages"| Runtimes
    K8sAPI -.->|"manages"| ImgStreams

    %% Dependencies
    Controller -->|"HTTPS/6443<br/>Health check"| JobSetOp
    Controller -->|"HTTPS/6443<br/>ServiceMonitor CRUD"| PromOp
    Controller -->|"HTTPS/6443<br/>ConfigMap read"| PlatformOp

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef dependency fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Controller,HealthPort,MetricsPort operator
    class MetricsSvc service
    class K8sAPI,APIServer controlplane
    class TrainerCR,KubeflowCRDs,TrainerDeploy,Webhooks,Runtimes,ImgStreams managed
    class Prometheus monitoring
    class JobSetOp,PromOp,PlatformOp dependency
    class NetPol security
