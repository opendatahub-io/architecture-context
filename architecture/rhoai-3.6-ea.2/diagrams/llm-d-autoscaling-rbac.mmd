graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_Prom["kube-prometheus-stack-prometheus"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(cluster-scoped)"]
        CRB_Metrics["metrics-auth-rolebinding<br/>(cluster-scoped)"]
        CRB_Reader["metrics-reader-rolebinding<br/>(ns: wva-monitoring)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(deployment namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_Reader["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph ManagerResources["manager-role Resources"]
        Core_RO["Core API (read-only)<br/>configmaps, namespaces, nodes,<br/>nodes/status, pods,<br/>resourcequotas, services<br/>[get, list, watch]"]
        Core_Events["Core API<br/>events<br/>[create, patch]"]
        Apps_Deploy["apps<br/>deployments<br/>[get, list, patch, update, watch]"]
        Apps_Scale["apps<br/>deployments/scale<br/>[get, update]"]
        Apps_RO["apps<br/>replicasets, statefulsets<br/>[get, list, watch]"]
        HPA_Res["autoscaling<br/>horizontalpodautoscalers<br/>[get, list, patch, update, watch]"]
        InfPool["inference.networking.k8s.io<br/>inferencepools<br/>[get, list, watch]"]
        ScaledObj["keda.sh<br/>scaledobjects<br/>[get, list, patch, update, watch]"]
        LWSRes["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>[get, list, patch, update, watch]"]
        LWSScale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale<br/>[get, update]"]
        SvcMon["monitoring.coreos.com<br/>servicemonitors<br/>[get, list, watch]"]
    end

    subgraph MetricsAuthResources["metrics-auth-role Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>[create]"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>[create]"]
    end

    subgraph MetricsReaderResources["metrics-reader Resources"]
        MetricsURL["/metrics<br/>[get]"]
    end

    subgraph LeaderResources["leader-election-role Resources"]
        Leases["coordination.k8s.io<br/>leases<br/>[create, delete, get,<br/>list, patch, update, watch]"]
        LeaderEvents["Core API<br/>events<br/>[create, patch]"]
    end

    %% SA → Binding → Role → Resources
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Metrics
    SA_CM -->|bound via| RB_Leader

    SA_Prom -->|bound via| CRB_Reader
    SA_EPP -->|bound via| CRB_EPP

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    CRB_Reader -->|grants| CR_Reader
    CRB_EPP -->|grants| CR_EPP
    RB_Leader -->|grants| R_Leader

    CR_Manager --> Core_RO
    CR_Manager --> Core_Events
    CR_Manager --> Apps_Deploy
    CR_Manager --> Apps_Scale
    CR_Manager --> Apps_RO
    CR_Manager --> HPA_Res
    CR_Manager --> InfPool
    CR_Manager --> ScaledObj
    CR_Manager --> LWSRes
    CR_Manager --> LWSScale
    CR_Manager --> SvcMon

    CR_MetricsAuth --> TokenReview
    CR_MetricsAuth --> SAR

    CR_Reader --> MetricsURL
    CR_EPP --> MetricsURL

    R_Leader --> Leases
    R_Leader --> LeaderEvents

