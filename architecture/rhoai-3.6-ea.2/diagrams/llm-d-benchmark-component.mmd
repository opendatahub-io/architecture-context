graph TB
    subgraph BenchmarkTool["llm-d-benchmark"]
        direction TB

        subgraph CLI["llmdbenchmark CLI"]
            Parser["Spec Parser<br/>(Jinja2 Templates)"]
            StepExecutor["Step Executor"]
            ResultsStore["Results Store<br/>(StorageClient)"]
            Telemetry["Telemetry Module"]
        end

        subgraph HarnessImage["Benchmark Harness Image (StatefulSet)"]
            EntryScript["llm-d-benchmark.sh<br/>(Dispatch + Retry)"]
            InferencePerf["inference-perf v0.7.0"]
            GuideLLM["guidellm v0.7.3"]
            VLLMBench["vllm-benchmark v0.30.0"]
            AiPerf["aiperf v0.12.0"]
            LMEval["lm-eval 0.4.12"]
            InferenceMax["inferencemax"]
            Analysis["Post-Run Analysis<br/>(numpy, pandas, scipy)"]
        end

        subgraph Discovery["llm-d-stack-discovery"]
            DiscoveryCLI["Discovery CLI"]
            K8sTracer["K8s Resource Tracer"]
        end

        subgraph ReportLib["benchmark-report"]
            PydanticSchemas["Benchmark Report v0.2<br/>Pydantic Schemas"]
            Converters["Harness Output Converters"]
        end
    end

    %% CLI flow
    User[User / CI Pipeline] -->|"llmdbenchmark --spec"| Parser
    Parser -->|renders manifests| StepExecutor
    StepExecutor -->|standup / run / teardown| K8sAPI[Kubernetes API<br/>443/TCP HTTPS]
    StepExecutor -->|deploys| HarnessImage
    ResultsStore -->|direct| GCS[Google Cloud Storage<br/>443/TCP HTTPS]
    ResultsStore -->|fallback| Prism["Prism Proxy<br/>prism.llm-d.ai<br/>443/TCP HTTPS"]
    Telemetry -->|reports| TelemetryEndpoint[Telemetry Endpoint]

    %% Harness flow
    EntryScript -->|dispatches| InferencePerf
    EntryScript -->|dispatches| GuideLLM
    EntryScript -->|dispatches| VLLMBench
    EntryScript -->|dispatches| AiPerf
    EntryScript -->|dispatches| LMEval
    EntryScript -->|dispatches| InferenceMax
    InferencePerf & GuideLLM & VLLMBench & AiPerf & LMEval & InferenceMax -->|results| Analysis
    Analysis -->|structured output| PydanticSchemas

    %% Harness targets
    HarnessImage -->|benchmark requests| LLMEndpoint["vLLM Inference Endpoint<br/>8000-8200/TCP"]

    %% Discovery flow
    User -->|"llm-d-stack-discovery URL"| DiscoveryCLI
    DiscoveryCLI --> K8sTracer
    K8sTracer -->|traces Route → Gateway →<br/>HTTPRoute → InferencePool → Pods| K8sAPI

    %% HuggingFace
    CLI -->|model access| HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]

    %% Styling
    style BenchmarkTool fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style CLI fill:#d5e8d4,stroke:#82b366
    style HarnessImage fill:#fff2cc,stroke:#d6b656
    style Discovery fill:#e1d5e7,stroke:#9673a6
    style ReportLib fill:#f8cecc,stroke:#b85450
    style K8sAPI fill:#e8e8e8,stroke:#999
    style GCS fill:#e8e8e8,stroke:#999
    style Prism fill:#e8e8e8,stroke:#999
    style HFHub fill:#e8e8e8,stroke:#999
    style LLMEndpoint fill:#f5a623,stroke:#333
