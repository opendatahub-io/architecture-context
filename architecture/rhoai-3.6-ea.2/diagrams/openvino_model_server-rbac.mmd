graph TD
    subgraph Note["RBAC Note"]
        direction TB
        Info["OVMS does not define its own RBAC resources.<br/>RBAC is managed by KServe and the platform operator."]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB

        subgraph RESTAuth["REST API Authentication"]
            APIKey["API Key File<br/>(--api_key_file / API_KEY env)"]
            Bearer["Bearer Token Validation<br/>(HttpRestApiHandler)"]
            APIKey -->|"configures"| Bearer
        end

        subgraph Endpoints["Endpoint Auth Matrix"]
            V3["'/v3/*' OpenAI-compatible<br/>Auth: Bearer (optional)"]
            V1["'/v1/*' TFS API<br/>Auth: Bearer (optional)"]
            V2Infer["'/v2/models/*/infer' KServe<br/>Auth: Bearer (optional)"]
            V2Health["'/v2/health/*' Probes<br/>Auth: None (bypass)"]
            Metrics["/metrics<br/>Auth: None (always open)"]
            GRPCSvc["gRPC Services<br/>Auth: None<br/>(InsecureServerCredentials)"]
        end

        Bearer -->|"protects"| V3
        Bearer -->|"protects"| V1
        Bearer -->|"protects"| V2Infer
    end

    subgraph Secrets["Secrets Used"]
        S1["API key file (Opaque)<br/>Manual provisioning<br/>No auto-rotate"]
        S2["HF token (Opaque)<br/>Manual provisioning<br/>No auto-rotate"]
        S3["mTLS certificates (kubernetes.io/tls)<br/>Manual / cert-manager<br/>Deployment-dependent"]
    end

    subgraph Runtime["Runtime Security"]
        NonRoot["Runs as non-root<br/>User: ovms (UID 5000)"]
        UBI["Base: UBI 9 minimal PQC"]
    end

    style Info fill:#fff3cd,stroke:#856404,color:#856404
    style APIKey fill:#4a90e2,color:#fff
    style Bearer fill:#4a90e2,color:#fff
    style V3 fill:#d5e8d4,stroke:#82b366
    style V1 fill:#d5e8d4,stroke:#82b366
    style V2Infer fill:#d5e8d4,stroke:#82b366
    style V2Health fill:#fff2cc,stroke:#d6b656
    style Metrics fill:#fff2cc,stroke:#d6b656
    style GRPCSvc fill:#f8cecc,stroke:#b85450
    style S1 fill:#e8e8e8,stroke:#666
    style S2 fill:#e8e8e8,stroke:#666
    style S3 fill:#e8e8e8,stroke:#666
    style NonRoot fill:#d5e8d4,stroke:#82b366
    style UBI fill:#d5e8d4,stroke:#82b366
