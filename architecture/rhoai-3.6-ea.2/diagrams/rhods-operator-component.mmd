graph TB
    subgraph RhodsOperator["rhods-operator Platform Operator"]
        direction TB

        subgraph ManagerBinary["Manager Binary"]
            DSCController["DSC Controller<br/>DataScienceCluster reconciler"]
            DSCIController["DSCI Controller<br/>DSCInitialization reconciler"]
            GatewayService["Gateway Service Controller<br/>Ingress stack orchestration"]
            AuthService["Auth Service Controller<br/>Admin/user group RBAC"]
            MonitoringService["Monitoring Service<br/>Prometheus rules & monitors"]
            ModuleReconciler["Module Reconciler<br/>External operator manifests"]
            ComponentReconciler["Component Reconciler<br/>In-tree components (Kueue)"]
            WebhookServer["Webhook Server<br/>9443/TCP"]
            MetricsServer["Metrics Server<br/>8443/TCP"]
            TLSProfileWatcher["TLS Profile Watcher<br/>Cluster TLS alignment"]
        end

        subgraph CloudMgr["CloudManager Binary"]
            AWSController["AWS EKS Controller"]
            AzureController["Azure AKS Controller"]
            CoreWeaveController["CoreWeave Controller"]
        end
    end

    %% CRDs watched
    DSCCR["DataScienceCluster CR<br/>(Cluster-scoped)"]
    DSCICR["DSCInitialization CR<br/>(Cluster-scoped)"]
    GatewayConfigCR["GatewayConfig CR<br/>(Cluster-scoped)"]
    AuthCR["Auth CR<br/>(Cluster-scoped)"]
    HardwareProfileCR["HardwareProfile CR<br/>(Namespaced)"]
    KueueCR["Kueue CR<br/>(Cluster-scoped)"]

    %% Cloud CRDs
    AWSCR["AWSKubernetesEngine CR"]
    AzureCR["AzureKubernetesEngine CR"]
    CoreWeaveCR["CoreWeaveKubernetesEngine CR"]

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftAPI["OpenShift API<br/>Routes, OAuth, Console"]
    IstioEnvoy["Istio / Envoy<br/>EnvoyFilter, DestinationRule"]
    GatewayAPI["Gateway API<br/>data-science-gateway"]
    PromOperator["prometheus-operator<br/>PodMonitor, PrometheusRule"]
    CertManager["cert-manager<br/>(conditional)"]

    %% Created resources
    KubeAuthProxy["kube-auth-proxy<br/>OIDC Deployment (per-component)"]
    ComponentOps["Component Operator Pods<br/>(via module manifests)"]

    %% CRD watches
    DSCCR -->|watched by| DSCController
    DSCICR -->|watched by| DSCIController
    GatewayConfigCR -->|watched by| GatewayService
    AuthCR -->|watched by| AuthService
    HardwareProfileCR -->|managed by| DSCController
    KueueCR -->|reconciled by| ComponentReconciler

    %% Cloud CRD watches
    AWSCR -->|watched by| AWSController
    AzureCR -->|watched by| AzureController
    CoreWeaveCR -->|watched by| CoreWeaveController

    %% Controller actions
    DSCController -->|enables components via| ModuleReconciler
    ModuleReconciler -->|deploys| ComponentOps
    GatewayService -->|creates| GatewayAPI
    GatewayService -->|creates| IstioEnvoy
    GatewayService -->|deploys| KubeAuthProxy
    AuthService -->|creates RBAC| K8sAPI
    MonitoringService -->|manages| PromOperator
    TLSProfileWatcher -->|reads| OpenShiftAPI
    WebhookServer -->|validates/mutates| K8sAPI
    MetricsServer -->|serves| PromOperator
    DSCIController -->|creates namespace| K8sAPI

    %% Dependencies
    DSCController -->|API calls| K8sAPI
    GatewayService -->|creates Routes| OpenShiftAPI
    ModuleReconciler -->|cert lifecycle| CertManager

    %% Styling
    style DSCController fill:#4a90e2,color:#fff
    style DSCIController fill:#4a90e2,color:#fff
    style GatewayService fill:#4a90e2,color:#fff
    style AuthService fill:#4a90e2,color:#fff
    style MonitoringService fill:#4a90e2,color:#fff
    style ModuleReconciler fill:#4a90e2,color:#fff
    style ComponentReconciler fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style TLSProfileWatcher fill:#4a90e2,color:#fff
    style AWSController fill:#50c878,color:#fff
    style AzureController fill:#50c878,color:#fff
    style CoreWeaveController fill:#50c878,color:#fff
    style DSCCR fill:#f5a623
    style DSCICR fill:#f5a623
    style GatewayConfigCR fill:#f5a623
    style AuthCR fill:#f5a623
    style HardwareProfileCR fill:#f5a623
    style KueueCR fill:#f5a623
    style AWSCR fill:#f5a623
    style AzureCR fill:#f5a623
    style CoreWeaveCR fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style OpenShiftAPI fill:#e8e8e8
    style IstioEnvoy fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style PromOperator fill:#e8e8e8
    style CertManager fill:#e8e8e8
    style KubeAuthProxy fill:#7ed321
    style ComponentOps fill:#7ed321
