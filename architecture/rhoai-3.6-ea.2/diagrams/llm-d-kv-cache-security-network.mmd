graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Scheduler / Client"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Token"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No Auth / No TLS)"]
        direction TB

        subgraph NS_KVCache["Namespace: hc4ai-operator"]
            Manager["kv-cache-manager<br/>ClusterIP 8080/TCP<br/>HTTP (plaintext)<br/>No Auth"]
            UDSTokenizer["UDS Tokenizer Sidecar<br/>UDS: /tmp/tokenizer/tokenizer-uds.socket<br/>TCP: 8082/TCP (health)<br/>gRPC (plaintext)<br/>No Auth"]
            PVCEvictor["PVC Evictor Sidecar<br/>No listener<br/>Multi-process daemon"]
        end

        subgraph NS_vLLM["Namespace: vLLM Workloads"]
            vLLMPod["vLLM / SGLang Pods<br/>5557/TCP ZMQ<br/>Plaintext<br/>No Auth"]
        end

        subgraph NS_Monitoring["Namespace: Monitoring"]
            OTel["OpenTelemetry Collector<br/>4317/TCP gRPC<br/>Plaintext (WithInsecure)<br/>No Auth"]
        end
    end

    subgraph DataStore["DATA STORE"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>TCP: redis:// (plaintext)<br/>or rediss:// (TLS optional)<br/>URL credentials optional"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS / TLS 1.2+<br/>ServiceAccount Token"]
    end

    %% Ingress flows
    Client -->|"HTTP POST /score_*<br/>8080/TCP<br/>Plaintext<br/>No Auth"| Manager

    %% Internal flows
    Manager -->|"gRPC<br/>UDS (plaintext)<br/>No Auth"| UDSTokenizer
    Manager -->|"ZMQ Subscribe<br/>5557/TCP<br/>Plaintext<br/>No Auth"| vLLMPod

    %% Egress flows
    Manager -->|"TCP<br/>6379/TCP<br/>Plaintext or TLS<br/>URL creds optional"| Redis
    Manager -->|"gRPC OTLP<br/>4317/TCP<br/>Plaintext<br/>No Auth"| OTel
    Manager -->|"HTTPS<br/>6443/TCP<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    UDSTokenizer -->|"HTTPS<br/>443/TCP<br/>TLS 1.2+<br/>API Token"| HFHub

    PVCEvictor -->|"ZMQ Publish<br/>5557/TCP<br/>Plaintext<br/>No Auth"| vLLMPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px

    class Client,HFHub external
    class Manager,UDSTokenizer,PVCEvictor,vLLMPod,OTel cluster
    class Redis datastore
    class K8sAPI controlplane
