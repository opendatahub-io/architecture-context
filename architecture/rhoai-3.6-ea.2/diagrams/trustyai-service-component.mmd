graph TB
    subgraph TrustyAI["TrustyAI Service"]
        direction TB
        subgraph MainApp["Main API (Port 8081 - loopback)"]
            FairnessRoutes["Fairness Endpoints<br/>SPD, DIR"]
            DriftRoutes["Drift Endpoints<br/>KS, JS, MMD, Compare Means"]
            ExplainerRoutes["Explainer Endpoints<br/>LIME, SHAP, CF, PDP<br/>(disabled by default)"]
            InfoRoutes["Info / Data Endpoints<br/>metadata, upload, tags"]
            MetricsEndpoint["/q/metrics<br/>Prometheus scrape"]
        end

        subgraph HealthApp["Health App (Port 8080 - all interfaces)"]
            HealthProbes["Health Probes<br/>/q/health/ready, /q/health/live"]
            KServeConsumer["KServe Consumer<br/>POST / (CloudEvent)"]
            ModelMeshConsumer["ModelMesh Consumer<br/>POST /consumer/kserve/v2"]
        end

        subgraph Background["Background Services"]
            PrometheusScheduler["Prometheus Scheduler<br/>(asyncio task, 30s interval)"]
        end

        subgraph Storage["Storage Layer"]
            StorageInterface["StorageInterface<br/>(abstraction)"]
            PVCStorage["PVC Storage<br/>(HDF5 via h5py)"]
            MariaStorage["MariaDB Storage<br/>(optional)"]
            StorageInterface --> PVCStorage
            StorageInterface --> MariaStorage
        end

        PrometheusScheduler -->|reads data| StorageInterface
        FairnessRoutes -->|reads data| StorageInterface
        DriftRoutes -->|reads data| StorageInterface
        ExplainerRoutes -->|reads data| StorageInterface
        KServeConsumer -->|writes data| StorageInterface
        ModelMeshConsumer -->|writes data| StorageInterface
    end

    %% External actors
    User["User / Dashboard"] -->|HTTPS| KubeRBACProxy
    KubeRBACProxy["kube-rbac-proxy<br/>(sidecar)"] -->|HTTP loopback| MainApp

    KServeLogger["KServe Inference Logger"] -->|CloudEvent POST| KServeConsumer
    ModelMeshAgent["ModelMesh Agent"] -->|KServe v2 POST| ModelMeshConsumer

    Prometheus["Prometheus"] -->|scrapes /q/metrics| MetricsEndpoint
    PrometheusScheduler -->|publishes gauges| MetricsEndpoint

    Kubelet["Kubelet"] -->|probes| HealthProbes

    TrustyAIOp["TrustyAI Operator"] -.->|deploys & configures| TrustyAI

    MariaStorage -->|3306/TCP| MariaDB["MariaDB"]
    PVCStorage -->|filesystem| PVC["PVC Volume"]

    %% Styling
    style TrustyAI fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style MainApp fill:#d5e8d4,stroke:#82b366
    style HealthApp fill:#d5e8d4,stroke:#82b366
    style Background fill:#fff2cc,stroke:#d6b656
    style Storage fill:#f8cecc,stroke:#b85450
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00
    style KServeLogger fill:#e8e8e8,stroke:#999
    style ModelMeshAgent fill:#e8e8e8,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#999
    style MariaDB fill:#e8e8e8,stroke:#999
    style PVC fill:#e8e8e8,stroke:#999
    style TrustyAIOp fill:#e8e8e8,stroke:#999
    style Kubelet fill:#e8e8e8,stroke:#999
    style User fill:#f9f9f9,stroke:#333
