graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph PodBoundary["POD BOUNDARY (TrustyAI Pod)"]
        direction TB

        subgraph AuthProxy["AUTHENTICATION LAYER"]
            KubeRBACProxy["kube-rbac-proxy<br/>External Port/TCP → 8081/TCP<br/>TLS termination<br/>Bearer Token / Kubernetes RBAC"]
        end

        subgraph AppLayer["APPLICATION LAYER (loopback only)"]
            MainAPI["trustyai-service (API)<br/>8081/TCP HTTP (127.0.0.1 only)<br/>No auth (delegated to proxy)<br/>Fairness, Drift, Explainability"]
            OptionalHTTPS["trustyai-service (HTTPS)<br/>4443/TCP HTTPS (optional)<br/>TLS: System crypto policy<br/>Optional mTLS"]
        end

        subgraph HealthLayer["HEALTH / CONSUMER LAYER (0.0.0.0)"]
            HealthApp["health-app<br/>8080/TCP HTTP (all interfaces)<br/>No auth, No encryption<br/>Health probes + KServe consumer"]
        end
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        Prometheus["Prometheus<br/>Scrapes /q/metrics"]
        Kubelet["Kubelet<br/>Health probes"]
        KServeLogger["KServe Inference Logger<br/>CloudEvent POST"]
        ModelMeshAgent["ModelMesh Agent<br/>KServe v2 POST"]
        TrustyAIOp["TrustyAI Operator<br/>Deployment management"]
    end

    subgraph DataLayer["DATA LAYER"]
        PVC["PVC Volume<br/>HDF5 filesystem I/O<br/>No encryption"]
        MariaDB["MariaDB<br/>3306/TCP MySQL<br/>TLS optional (CA-verified)<br/>Username/Password auth"]
    end

    %% External flows
    User -->|"HTTPS<br/>TLS<br/>Bearer Token"| KubeRBACProxy

    %% Internal proxy flow
    KubeRBACProxy -->|"HTTP/8081<br/>loopback only<br/>Authenticated"| MainAPI

    %% Cluster internal flows
    KServeLogger -->|"HTTP/8080<br/>No encryption<br/>No auth"| HealthApp
    ModelMeshAgent -->|"HTTP/8080<br/>No encryption<br/>No auth"| HealthApp
    Kubelet -->|"HTTP/8080<br/>No encryption<br/>No auth"| HealthApp
    Prometheus -->|"HTTPS<br/>via kube-rbac-proxy"| KubeRBACProxy
    TrustyAIOp -.->|"K8s API<br/>Deployment mgmt"| PodBoundary

    %% Data flows
    MainAPI -->|"Filesystem I/O"| PVC
    MainAPI -->|"MySQL/3306<br/>TLS optional<br/>Password auth"| MariaDB
    HealthApp -->|"Filesystem I/O"| PVC
    HealthApp -->|"MySQL/3306<br/>TLS optional<br/>Password auth"| MariaDB

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authproxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef health fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef cluster fill:#e8e8e8,stroke:#999,stroke-width:1px
    classDef data fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class KubeRBACProxy authproxy
    class MainAPI,OptionalHTTPS app
    class HealthApp health
    class Prometheus,Kubelet,KServeLogger,ModelMeshAgent,TrustyAIOp cluster
    class PVC,MariaDB data
