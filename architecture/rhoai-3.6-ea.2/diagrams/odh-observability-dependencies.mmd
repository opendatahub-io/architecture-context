graph LR
    ODHObs["odh-observability<br/>Operator"]

    %% Required Platform Dependencies (CRD-based)
    ODHObs -->|"CRD: MonitoringStack,<br/>ThanosQuerier,<br/>ServiceMonitor,<br/>PrometheusRule"| ClusterObs["Cluster Observability<br/>Operator"]
    ODHObs -->|"CRD: TempoMonolithic,<br/>TempoStack"| TempoOp["Tempo Operator"]
    ODHObs -->|"CRD: OpenTelemetryCollector,<br/>Instrumentation"| OTelOp["OpenTelemetry<br/>Operator"]
    ODHObs -->|"CRD: Perses,<br/>PersesDatasource,<br/>PersesDashboard"| PersesOp["Perses Operator"]
    ODHObs -->|"CRD: LokiStack"| LokiOp["Loki Operator"]
    ODHObs -->|"CRD: ClusterLogForwarder"| CLO["Cluster Logging<br/>Operator"]
    ODHObs -->|"CRD: Issuer,<br/>Certificate"| CertMgr["cert-manager"]

    %% Internal Library Dependencies
    ODHObs -->|"Go library:<br/>SSA deploy, GC,<br/>templates"| PlatUtils["odh-platform-utilities<br/>v0.3.0"]

    %% Infrastructure Dependencies
    ODHObs -->|"reads TLS profile"| APIServer["OpenShift APIServer<br/>Config"]
    ODHObs -->|"CRD CRUD,<br/>resource mgmt"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Integration Points (consumers)
    ODHObs -->|"reads ServiceMonitor,<br/>PodMonitor, Probe"| PromOp["prometheus-operator<br/>(monitoring.coreos.com)"]
    ODHObs -->|"reads InferenceService<br/>for log forwarding"| KServe["KServe"]
    ODHObs -->|"updates Experiment<br/>for trace export"| MLflow["MLflow Operator"]

