graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["opendatahub-operator-<br/>controller-manager"]
        SA_AuthProxy["kube-auth-proxy SA<br/>(per-component, dynamic)"]
        SA_Argo["argo<br/>(namespace: argo)"]
        SA_Monitoring["data-science-monitoringstack-<br/>prometheus"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["opendatahub-operator-<br/>controller-manager-rolebinding"]
        CRB_AuthProxy["kube-auth-proxy-tokenreview<br/>(per gateway-namespace)"]
        CRB_Argo["ds-pipeline-argo-binding"]
        CRB_Monitoring["data-science-pipelines-operator-<br/>rhoai-prometheus"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["controller-manager-role<br/>(wide scope)"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_AdminGroup["data-science-admingroupcluster-role"]
        CR_AllowedGroup["data-science-allowedgroupcluster-role"]
        CR_MetricsReader["opendatahub-operator-metrics-reader"]
        CR_Argo["argo-cluster-role"]
        CR_MonitoringReader["data-science-pipelines-operator-<br/>metrics-reader"]
    end

    subgraph APIResources_Manager["API Resources (controller-manager-role)"]
        DSC_Res["datasciencecluster.opendatahub.io<br/>DataScienceCluster"]
        DSCI_Res["dscinitialization.opendatahub.io<br/>DSCInitialization"]
        Deploy_Res["apps<br/>Deployments"]
        Secret_Res["core<br/>Secrets"]
        CM_Res["core<br/>ConfigMaps"]
        CRD_Res["apiextensions.k8s.io<br/>CRDs"]
    end

    subgraph APIResources_Admin["API Resources (admin-group)"]
        Auth_Res["services.platform.opendatahub.io<br/>auths"]
        MR_Res["modelregistry.opendatahub.io<br/>modelregistries"]
        FS_Res["feast.dev<br/>featurestores"]
        SC_Res["storage.k8s.io<br/>storageclasses"]
        User_Res["user.openshift.io<br/>groups/users"]
        MaaS_Res["maas.opendatahub.io<br/>maasmodelrefs"]
    end

    subgraph APIResources_Argo["API Resources (argo)"]
        Workflow_Res["argoproj.io<br/>workflows"]
        Pod_Res["core<br/>pods"]
        PVC_Res["core<br/>PVCs"]
        ArgoSecret_Res["core<br/>secrets<br/>(resourceNames restricted)"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        Metrics_URL["/metrics"]
    end

    %% Service Account → Binding
    SA_Manager -->|"bound via"| CRB_Manager
    SA_AuthProxy -->|"bound via"| CRB_AuthProxy
    SA_Argo -->|"bound via"| CRB_Argo
    SA_Monitoring -->|"bound via"| CRB_Monitoring

    %% Binding → Role
    CRB_Manager -->|"grants"| CR_Manager
    CRB_AuthProxy -->|"grants"| CR_AuthDelegator
    CRB_Argo -->|"grants"| CR_Argo
    CRB_Monitoring -->|"grants"| CR_MonitoringReader

    %% Role → Resources
    CR_Manager -->|"full CRUD"| DSC_Res
    CR_Manager -->|"full CRUD"| DSCI_Res
    CR_Manager -->|"full CRUD"| Deploy_Res
    CR_Manager -->|"full CRUD"| Secret_Res
    CR_Manager -->|"full CRUD"| CM_Res
    CR_Manager -->|"full CRUD"| CRD_Res

    CR_AdminGroup -->|"get,list,watch,create,<br/>update,patch,delete"| Auth_Res
    CR_AdminGroup -->|"get,list,watch,create,<br/>update,patch,delete"| MR_Res
    CR_AdminGroup -->|"get,list,watch"| FS_Res
    CR_AdminGroup -->|"get,list,watch"| SC_Res
    CR_AdminGroup -->|"get,list,watch"| User_Res
    CR_AdminGroup -->|"get,list,watch"| MaaS_Res

    CR_AllowedGroup -->|"get,list,watch"| Auth_Res

    CR_Argo -->|"full CRUD"| Workflow_Res
    CR_Argo -->|"full CRUD"| Pod_Res
    CR_Argo -->|"full CRUD"| PVC_Res
    CR_Argo -->|"get (restricted)"| ArgoSecret_Res

    CR_MetricsReader -->|"get"| Metrics_URL

