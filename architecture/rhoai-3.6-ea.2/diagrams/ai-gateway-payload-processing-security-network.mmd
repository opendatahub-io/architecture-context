graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Gateway["GATEWAY (DMZ)"]
        Envoy["AI Gateway - Envoy Proxy<br/>Gateway: maas-default-gateway<br/>Namespace: openshift-ingress<br/>TLS Termination"]
    end

    subgraph Service["SERVICE (ext-proc — mesh-internal)"]
        direction TB

        subgraph ExtProcSvc["ext-proc gRPC Server"]
            ExtProc["ext-proc<br/>9004/TCP gRPC, 9005/TCP health<br/>Image: odh-ai-gateway-payload-processing-rhel9<br/>FIPS: strictfipsruntime + ubi-minimal-pqc"]
        end

        subgraph CtrlSvc["Kubernetes Controllers"]
            Controllers["ExternalModel Controller<br/>ExternalProvider Controller<br/>Legacy Migration Controller"]
        end
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount auth"]
        NeMo["NeMo Guardrails<br/>configurable port<br/>HTTPS TLS 1.2+<br/>No auth"]
    end

    subgraph ExternalSvcs["EXTERNAL SERVICES (Istio egress)"]
        OpenAI["OpenAI<br/>api.openai.com<br/>443/TCP HTTPS"]
        Anthropic["Anthropic<br/>api.anthropic.com<br/>443/TCP HTTPS"]
        Azure["Azure OpenAI<br/>443/TCP HTTPS"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>SigV4 auth"]
        Vertex["Google Vertex AI<br/>443/TCP HTTPS<br/>OAuth2 auth"]
    end

    %% Flows
    Client -->|"HTTPS<br/>Bearer / API key"| Envoy
    Envoy -->|"gRPC/9004<br/>Optional TLS (self-signed)<br/>No app-level auth"| ExtProc
    ExtProc -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    Controllers -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    ExtProc -.->|"HTTPS<br/>TLS 1.2+<br/>No auth"| NeMo
    Envoy -->|"HTTPS/443<br/>TLS via DestinationRule<br/>API key"| OpenAI
    Envoy -->|"HTTPS/443<br/>TLS via DestinationRule<br/>API key"| Anthropic
    Envoy -->|"HTTPS/443<br/>TLS via DestinationRule<br/>API key"| Azure
    Envoy -->|"HTTPS/443<br/>TLS via DestinationRule<br/>SigV4"| Bedrock
    Envoy -->|"HTTPS/443<br/>TLS via DestinationRule<br/>OAuth2"| Vertex

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Envoy gateway
    class ExtProc,Controllers service
    class K8sAPI,NeMo platform
    class OpenAI,Anthropic,Azure,Bedrock,Vertex externalservice
