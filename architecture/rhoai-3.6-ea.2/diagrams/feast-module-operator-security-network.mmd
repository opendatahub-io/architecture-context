graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        ODHOperator["ODH Operator<br/>Deploys via Helm chart"]
    end

    subgraph K8sAPIZone["KUBERNETES API"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph AppNamespace["APPLICATION NAMESPACE<br/>(redhat-ods-applications)"]
        direction TB

        subgraph FMO["feast-module-operator"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>No auth"]
            MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (controller-runtime)<br/>TokenReview + SAR"]
        end

        subgraph ManagedResources["Managed Resources"]
            FeastOpDeploy["feast-operator-controller-manager<br/>Deployment"]
            FeatureStoreCRD["FeatureStore CRD<br/>feast.dev"]
            RBACRes["RBAC Resources<br/>ClusterRoles, Bindings"]
            SvcMonitor["ServiceMonitor"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>via ServiceMonitor"]
    end

    subgraph NetworkPolicyZone["NETWORK POLICY"]
        NP["allow-metrics-traffic<br/>Ingress: 8443/TCP<br/>From: namespaces labeled<br/>metrics: enabled"]
    end

    %% Flows
    ODHOperator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>Creates FeastOperator CR"| K8sAPI
    K8sAPI -->|"Watch events<br/>FeastOperator CR, CRDs, ConfigMap"| FMO
    FMO -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>Deploy resources"| K8sAPI
    FMO -->|deploys| FeastOpDeploy
    FMO -->|deploys| FeatureStoreCRD
    FMO -->|manages| RBACRes
    FMO -->|creates| SvcMonitor
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview + SAR"| MetricsEndpoint
    NP -.->|enforces| MetricsEndpoint

    %% Styling
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef apiserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef appns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef netpol fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class ODHOperator internal
    class K8sAPI apiserver
    class HealthProbe,MetricsEndpoint appns
    class Prometheus monitoring
    class NP netpol
    class FeastOpDeploy,FeatureStoreCRD,RBACRes,SvcMonitor managed
