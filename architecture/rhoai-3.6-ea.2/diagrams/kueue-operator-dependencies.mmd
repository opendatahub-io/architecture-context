graph LR
    KueueOp["Kueue Operator<br/>(openshift-kueue-operator)"]

    %% Hard Dependencies
    KueueOp -->|"TLS certs (HARD dep)"| CertManager["cert-manager"]
    KueueOp -->|"resource mgmt"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Operand
    KueueOp -->|"deploys & manages"| KueueCtrl["kueue-controller-manager<br/>(operand)"]

    %% Monitoring
    KueueOp -->|"creates ServiceMonitor"| PromOp["prometheus-operator"]
    Prometheus["Prometheus"] -->|"scrapes 8443/TCP"| KueueCtrl

    %% Workload Framework Integrations (via webhooks)
    KueueCtrl -.->|"webhooks 9443/TCP"| K8sJobs["Kubernetes Jobs"]
    KueueCtrl -.->|"webhooks 9443/TCP"| JobSet["JobSet Controller"]
    KueueCtrl -.->|"webhooks 9443/TCP"| Kubeflow["Kubeflow Training Operator<br/>PyTorchJob, TFJob, MPIJob,<br/>PaddleJob, XGBoostJob"]
    KueueCtrl -.->|"webhooks 9443/TCP"| KubeRay["KubeRay<br/>RayCluster, RayJob"]
    KueueCtrl -.->|"webhooks 9443/TCP"| CodeFlare["CodeFlare<br/>AppWrapper"]
    KueueCtrl -.->|"webhooks 9443/TCP"| LWS["LeaderWorkerSet Controller"]

    %% Build Dependencies
    KueueOp -.->|"build"| LibraryGo["openshift/library-go"]
    KueueOp -.->|"build"| KueueUpstream["sigs.k8s.io/kueue v0.10.2"]

    style KueueOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KueueCtrl fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style CertManager fill:#e74c3c,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style PromOp fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style K8sJobs fill:#f5a623,stroke:#333
    style JobSet fill:#f5a623,stroke:#333
    style Kubeflow fill:#f5a623,stroke:#333
    style KubeRay fill:#f5a623,stroke:#333
    style CodeFlare fill:#f5a623,stroke:#333
    style LWS fill:#f5a623,stroke:#333
    style LibraryGo fill:#e8e8e8,stroke:#333
    style KueueUpstream fill:#e8e8e8,stroke:#333
