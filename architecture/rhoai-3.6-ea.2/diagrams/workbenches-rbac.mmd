graph TD
    subgraph ServiceAccounts["Service Accounts"]
        ControllerSA["workspaces-controller<br/>(kubeflow-workspaces)"]
        BackendSA["workspaces-backend<br/>(kubeflow-workspaces)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        ControllerCRB["workspaces-manager-rolebinding"]
        BackendCRB["workspaces-backend"]
    end

    subgraph ControllerPerms["ClusterRole: workspaces-manager-role"]
        direction LR
        CR_Core["core<br/>pods, configmaps,<br/>events, namespaces<br/>→ get, list, watch"]
        CR_Exec["core<br/>pods/exec<br/>→ create"]
        CR_SvcSA["core<br/>serviceaccounts, services<br/>→ full CRUD"]
        CR_Apps["apps<br/>statefulsets<br/>→ full CRUD"]
        CR_Kubeflow["kubeflow.org<br/>workspaces, workspacekinds<br/>→ full CRUD + finalizers + status"]
        CR_Istio["networking.istio.io<br/>virtualservices<br/>→ full CRUD"]
        CR_RBAC["rbac.authorization.k8s.io<br/>clusterroles → bind<br/>rolebindings → full CRUD"]
        CR_Gateway["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/>→ full CRUD"]
        CR_TLS["config.openshift.io<br/>apiservers<br/>→ get, list, watch"]
    end

    subgraph BackendPerms["ClusterRole: workspaces-backend"]
        direction LR
        BE_Kubeflow["kubeflow.org<br/>workspaces, workspacekinds<br/>→ full CRUD"]
        BE_Read["core<br/>namespaces, configmaps<br/>→ get, list, watch"]
        BE_Secrets["core<br/>secrets<br/>→ get, list, watch,<br/>create, update, delete"]
        BE_Pods["core<br/>pods → get, list, watch<br/>pods/log → get"]
        BE_Storage["core + storage.k8s.io<br/>PVCs, PVs, storageclasses<br/>→ get, list, watch, create, delete"]
        BE_Metrics["metrics.k8s.io<br/>pods<br/>→ get, list"]
        BE_AuthZ["authorization.k8s.io<br/>subjectaccessreviews<br/>→ create"]
    end

    subgraph UserRoles["User-Facing Aggregated Roles"]
        AdminRole["kubeflow-workspaces-admin<br/>workspacekinds → full CRUD"]
        EditRole["kubeflow-workspaces-edit<br/>workspaces → create, delete,<br/>patch, update"]
        ViewRole["kubeflow-workspaces-view<br/>workspaces → get, list, watch"]
    end

    ControllerSA -->|"bound via"| ControllerCRB
    ControllerCRB -->|"grants"| CR_Core
    ControllerCRB -->|"grants"| CR_Exec
    ControllerCRB -->|"grants"| CR_SvcSA
    ControllerCRB -->|"grants"| CR_Apps
    ControllerCRB -->|"grants"| CR_Kubeflow
    ControllerCRB -->|"grants"| CR_Istio
    ControllerCRB -->|"grants"| CR_RBAC
    ControllerCRB -->|"grants"| CR_Gateway
    ControllerCRB -->|"grants"| CR_TLS

    BackendSA -->|"bound via"| BackendCRB
    BackendCRB -->|"grants"| BE_Kubeflow
    BackendCRB -->|"grants"| BE_Read
    BackendCRB -->|"grants"| BE_Secrets
    BackendCRB -->|"grants"| BE_Pods
    BackendCRB -->|"grants"| BE_Storage
    BackendCRB -->|"grants"| BE_Metrics
    BackendCRB -->|"grants"| BE_AuthZ

    style ControllerSA fill:#4a90e2,color:#fff
    style BackendSA fill:#4a90e2,color:#fff
    style ControllerCRB fill:#e8e8e8
    style BackendCRB fill:#e8e8e8
    style CR_Core fill:#7ed321,color:#fff
