    style CR_TLS fill:#7ed321,color:#fff
    style BE_Kubeflow fill:#7ed321,color:#fff
    style BE_Read fill:#7ed321,color:#fff
    style BE_Secrets fill:#f5a623,color:#fff
    style BE_Pods fill:#7ed321,color:#fff
    style BE_Storage fill:#7ed321,color:#fff
    style BE_Metrics fill:#7ed321,color:#fff
    style BE_AuthZ fill:#f5a623,color:#fff
