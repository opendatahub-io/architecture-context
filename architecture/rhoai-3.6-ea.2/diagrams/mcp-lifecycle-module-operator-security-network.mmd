graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - ServiceAccount RBAC)"]
        direction TB

        subgraph NS_System["Namespace: system (module operator)"]
            ModuleOp["mcp-lifecycle-module-operator<br/>SA: mcp-lifecycle-module-operator-controller-manager<br/>Image: quay.io/opendatahub/odh-mcp-lifecycle-module-operator<br/>Port: 8081/TCP (health, no auth)"]
        end

        subgraph NS_Operand["Namespace: mcp-lifecycle-operator-system (operand)"]
            OperandDeploy["mcp-lifecycle-operator<br/>SA: mcp-lifecycle-operator-controller-manager<br/>Image: quay.io/opendatahub/odh-mcp-lifecycle-operator"]
            MetricsService["Metrics Service<br/>ClusterIP :8443/TCP<br/>HTTPS (cluster TLS profile)<br/>Auth: TokenReview + SubjectAccessReview"]
        end

        subgraph ControlPlane["Control Plane"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token Auth"]
            OSApiServer["OpenShift APIServer CR<br/>config.openshift.io/apiservers<br/>TLS Profile Source"]
        end

        subgraph Monitoring["Monitoring"]
            Prometheus["Prometheus<br/>(via ServiceMonitor)"]
        end
    end

    %% Flows
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CR watch, SSA, GC, discovery"| K8sAPI
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Read TLS profile"| OSApiServer
    ModuleOp -->|"Deploys via SSA<br/>(no direct network)"| OperandDeploy
    OperandDeploy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>MCPServer management"| K8sAPI
    Prometheus -->|"HTTPS/8443<br/>TLS (cluster profile)<br/>TokenReview auth"| MetricsService

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef moduleop fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operand fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class K8sAPI,OSApiServer controlplane
    class ModuleOp moduleop
    class OperandDeploy,MetricsService operand
    class Prometheus monitoring
