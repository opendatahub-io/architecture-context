graph TB
    subgraph SDK["Kubeflow SDK (kubeflow Python package)"]
        direction TB

        subgraph TrainerModule["kubeflow.trainer"]
            TrainerClient["TrainerClient<br/>TrainJob lifecycle mgmt"]
            K8sBackend["Kubernetes Backend<br/>CR creation via k8s client"]
            ContainerBackend["Container Backend<br/>Docker/Podman local dev"]
            LocalBackend["Local Process Backend<br/>Subprocess prototyping"]
            TrainerClient --> K8sBackend
            TrainerClient --> ContainerBackend
            TrainerClient --> LocalBackend
        end

        subgraph RHAIModule["kubeflow.trainer.rhai (RHOAI Extension)"]
            TransformersTrainer["TransformersTrainer<br/>HuggingFace/TRL training"]
            TrainingHubTrainer["TrainingHubTrainer<br/>Training Hub integration"]
            SpecDecTrainer["SpeculativeDecodingTrainer<br/>Eagle3/DFlash/MTP/PEAGLE"]
            Instrumentation["Code Injection Engine<br/>inspect.getsource()"]
            ProgressionServer["Progression Tracking<br/>HTTP :28080 injected"]
            CheckpointMgr["Checkpoint Manager<br/>PVC / S3 storage"]
            TransformersTrainer --> Instrumentation
            TrainingHubTrainer --> Instrumentation
            SpecDecTrainer --> Instrumentation
            Instrumentation --> ProgressionServer
            Instrumentation --> CheckpointMgr
        end

        subgraph OptimizerModule["kubeflow.optimizer"]
            OptimizerClient["OptimizerClient<br/>Katib Experiments"]
        end

        subgraph SparkModule["kubeflow.spark"]
            SparkClient["SparkClient<br/>Spark Connect sessions"]
        end

        subgraph HubModule["kubeflow.hub"]
            ModelRegistryClient["ModelRegistryClient<br/>Model artifact mgmt"]
        end

        subgraph PipelinesModule["kubeflow.pipelines"]
            PipelinesClient["PipelinesClient<br/>kfp wrapper"]
        end

        subgraph CommonModule["kubeflow.common"]
            KubeConfig["KubernetesBackendConfig<br/>Namespace-scoped config"]
            Logging["Structured Logging<br/>structlog"]
        end

        TrainerClient --> KubeConfig
        OptimizerClient --> KubeConfig
        SparkClient --> KubeConfig
        TransformersTrainer --> TrainerClient
        TrainingHubTrainer --> TrainerClient
        SpecDecTrainer --> TrainerClient
    end

    %% External interactions
    User["Data Scientist / ML Engineer"] -->|Python API calls| SDK

    K8sBackend -->|"creates TrainJob CR"| K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
    OptimizerClient -->|"creates Experiment CR"| K8sAPI
    SparkClient -->|"creates SparkConnect CR"| K8sAPI
    ModelRegistryClient -->|"REST API"| ModelReg["Model Registry<br/>443/8080 TCP"]
    PipelinesClient -->|"REST API"| Pipelines["Kubeflow Pipelines<br/>443/TCP HTTPS"]
    CheckpointMgr -->|"upload checkpoints"| S3["S3 Storage<br/>443/TCP HTTPS"]
    SpecDecTrainer -->|"model config"| HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]

    %% Server-side operators
    K8sAPI -->|reconciles| TrainerOp["Kubeflow Trainer Operator"]
    K8sAPI -->|reconciles| KatibOp["Katib / Optimizer Operator"]
    K8sAPI -->|reconciles| SparkOp["Spark Operator"]

    %% Styling
    style SDK fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style TrainerModule fill:#bbdefb,stroke:#1976d2
    style RHAIModule fill:#c8e6c9,stroke:#388e3c
    style OptimizerModule fill:#bbdefb,stroke:#1976d2
    style SparkModule fill:#bbdefb,stroke:#1976d2
    style HubModule fill:#bbdefb,stroke:#1976d2
    style PipelinesModule fill:#bbdefb,stroke:#1976d2
    style CommonModule fill:#e0e0e0,stroke:#616161
    style User fill:#fff3e0,stroke:#e65100
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ModelReg fill:#e8e8e8,stroke:#333
    style Pipelines fill:#e8e8e8,stroke:#333
    style S3 fill:#fff8e1,stroke:#f9a825
    style HFHub fill:#fff8e1,stroke:#f9a825
    style TrainerOp fill:#f3e5f5,stroke:#7b1fa2
    style KatibOp fill:#f3e5f5,stroke:#7b1fa2
    style SparkOp fill:#f3e5f5,stroke:#7b1fa2
