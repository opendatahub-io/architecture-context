graph TB
    subgraph HostBoundary["HOST PROCESS BOUNDARY"]
        direction TB

        subgraph HostProcess["Host Process (e.g., Praxis Proxy)"]
            HostHTTP["Host HTTP Server<br/>pingora-backed"]
        end

        subgraph PPEEngine["PPE Engine (in-process library)"]
            direction TB
            Engine["PolicyEngine<br/>5-Phase Executor<br/>unsafe_code = forbid"]

            subgraph IdentityPlugins["Identity Resolution"]
                JWTPlugin["JWT Identity<br/>jsonwebtoken v11<br/>aws-lc-rs backend"]
                APIKeyPlugin["API-Key Identity<br/>SHA-256 hash index"]
            end

            subgraph PDPPlugins["Policy Decision Points"]
                CedarPDP["Cedar PDP<br/>cedar-policy 4.x"]
                CELPDP["CEL PDP<br/>cel 0.14.5"]
                OPAPDP["OPA PDP<br/>regorus 0.12.x"]
            end

            subgraph DelegationPlugins["Credential Delegation"]
                OAuthPlugin["OAuth Delegator<br/>RFC 8693"]
                CIBAPlugin["CIBA Elicitation<br/>OIDC CIBA"]
            end

            subgraph AuditSubsystem["Audit Subsystem"]
                EffectLog["Effect Log<br/>fsync before act<br/>crash recovery"]
                AuditRecord["Decision Records<br/>HMAC-SHA256 provenance<br/>W3C trace context"]
            end

            subgraph SecretStore["Secret Store"]
                SecretResolver["Secret Resolver<br/>file / env / vault<br/>Zeroizing memory"]
            end
        end
    end

    subgraph ExternalIdP["IDENTITY PROVIDER (External)"]
        JWKSEndpoint["JWKS Endpoint"]
        TokenEndpoint["OAuth Token Endpoint"]
        CIBAEndpoint["CIBA Endpoint"]
    end

    subgraph ExternalStorage["EXTERNAL STORAGE"]
        ValkeyStore["Valkey / Redis<br/>Session Taint Store"]
        VaultKV["HashiCorp Vault<br/>KV v2 Secrets"]
    end

    subgraph ExternalQuota["EXTERNAL SERVICES (Experimental)"]
        Limitador["Limitador<br/>Token Quota"]
    end

    %% Identity flows
    JWTPlugin -->|"HTTPS/443<br/>TLS 1.2+ (rustls/ring)<br/>No Auth"| JWKSEndpoint

    %% Delegation flows
    OAuthPlugin -->|"HTTPS/443<br/>TLS 1.2+ (rustls/ring)<br/>Client Credentials"| TokenEndpoint
    CIBAPlugin -->|"HTTPS/443<br/>TLS 1.2+ (rustls/ring)<br/>Client Credentials"| CIBAEndpoint

    %% Storage flows
    Engine -->|"Redis/6379<br/>Optional TLS (rustls)<br/>Password Auth"| ValkeyStore
    SecretResolver -->|"HTTPS/8200<br/>TLS (required)<br/>K8s SA / AppRole"| VaultKV

    %% Quota flow
    Engine -.->|"HTTP/configurable<br/>configurable<br/>Experimental"| Limitador

    %% Host to engine
    HostHTTP -->|"In-process<br/>Function Call"| Engine

    %% Styling
    classDef hostzone fill:#f0f0f0,stroke:#666,stroke-width:2px
    classDef engine fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef identity fill:#dae8fc,stroke:#6c8ebf
    classDef pdp fill:#fff2cc,stroke:#d6b656
    classDef delegation fill:#ffe6cc,stroke:#d79b00
    classDef audit fill:#e1d5e7,stroke:#9673a6
    classDef secret fill:#f8cecc,stroke:#b85450
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class HostHTTP hostzone
    class Engine engine
    class JWTPlugin,APIKeyPlugin identity
    class CedarPDP,CELPDP,OPAPDP pdp
    class OAuthPlugin,CIBAPlugin delegation
    class EffectLog,AuditRecord audit
    class SecretResolver secret
    class JWKSEndpoint,TokenEndpoint,CIBAEndpoint external
    class ValkeyStore,VaultKV storage
    class Limitador external
