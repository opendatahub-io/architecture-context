graph LR
    SDK["CodeFlare SDK<br/>Python Client Library"]

    %% External Dependencies (required runtime)
    SDK -->|"distributed compute"| Ray["ray 2.58.0"]
    SDK -->|"K8s API client"| K8sClient["kubernetes >= 27.2.0"]
    SDK -->|"TLS cert generation"| Crypto["cryptography >= 46.0.7"]
    SDK -->|"authentication"| KubeAuth["kube-authkit >= 0.4.0"]
    SDK -->|"OpenShift API"| OSClient["openshift-client 1.0.18"]
    SDK -->|"data validation"| Pydantic["pydantic >= 2.10.6"]
    SDK -->|"terminal output"| Rich["rich >= 12.5"]
    SDK -->|"Jupyter widgets"| IPyWidgets["ipywidgets 8.1.2"]

    %% Internal Platform Dependencies (CRD interactions via K8s API)
    SDK -->|"CRD: ray.io/v1<br/>RayCluster, RayJob"| KubeRay["KubeRay Operator"]
    SDK -->|"CRD: kueue.x-k8s.io/v1beta1<br/>LocalQueue, Priority"| Kueue["Kueue"]
    SDK -->|"CRD: datasciencecluster<br/>(read-only)"| DSCluster["RHOAI Platform<br/>DataScienceCluster"]
    SDK -->|"CRD: GatewayConfig<br/>(read-only)"| GWConfig["RHOAI Gateway"]

    %% Infrastructure Dependencies
    SDK -->|"HTTPRoute lookup"| GatewayAPI["Kubernetes Gateway API"]
    SDK -.->|"Route fallback"| OSRoutes["OpenShift Routes"]

    %% Runtime Targets
    SDK -->|"job submission<br/>mTLS/8265"| RayDash["Ray Dashboard"]
    SDK -->|"CRD ops<br/>HTTPS/6443"| K8sAPI["Kubernetes API Server"]

    %% Styling
    style SDK fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps (gray)
    style Ray fill:#999,stroke:#333,color:#fff
    style K8sClient fill:#999,stroke:#333,color:#fff
    style Crypto fill:#999,stroke:#333,color:#fff
    style KubeAuth fill:#999,stroke:#333,color:#fff
    style OSClient fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style Rich fill:#999,stroke:#333,color:#fff
    style IPyWidgets fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI deps (green)
    style KubeRay fill:#7ed321,stroke:#333,color:#fff
    style Kueue fill:#7ed321,stroke:#333,color:#fff
    style DSCluster fill:#7ed321,stroke:#333,color:#fff
    style GWConfig fill:#7ed321,stroke:#333,color:#fff

    %% Infrastructure (orange)
    style GatewayAPI fill:#f5a623,stroke:#333,color:#fff
    style OSRoutes fill:#f5a623,stroke:#333,color:#fff
    style RayDash fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
