graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_OMC["odh-model-controller"]
        SA_MSA["model-serving-api"]
        SA_CM["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_OMC["odh-model-controller-<br/>rolebinding-opendatahub"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_MSA["model-serving-api"]
        CRB_Metrics["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (opendatahub NS)"]
        RB_Leader["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_OMC["odh-model-controller-role"]
        CR_Proxy["proxy-role"]
        CR_MSA["model-serving-api"]
        CR_Metrics["metrics-auth-role"]
        CR_MetricsR["metrics-reader"]
        CR_Prom["kserve-prometheus-k8s"]
        CR_Editor["account-editor-role"]
        CR_Viewer["account-viewer-role"]
    end

    subgraph Roles["Roles (opendatahub NS)"]
        R_Leader["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        Res_CM["configmaps"]
        Res_Secrets["secrets"]
        Res_SA["serviceaccounts"]
        Res_SVC["services"]
        Res_Pods["pods"]
        Res_Events["events"]
        Res_NS["namespaces"]
        Res_EP["endpoints"]
    end

    subgraph KServeResources["KServe Resources"]
        Res_IS["inferenceservices"]
        Res_LLMIS["llminferenceservices"]
        Res_SR["servingruntimes"]
        Res_IG["inferencegraphs"]
    end

    subgraph GatewayResources["Gateway / Network Resources"]
        Res_GW["gateways"]
        Res_HR["httproutes"]
        Res_NP["networkpolicies"]
        Res_EF["envoyfilters"]
    end

    subgraph AuthResources["Auth / Scaling Resources"]
        Res_AP["authpolicies"]
        Res_TA["triggerauthentications"]
        Res_TR["tokenreviews"]
        Res_SAR["subjectaccessreviews"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        Res_SM["servicemonitors"]
        Res_PM["podmonitors"]
    end

    subgraph NIMResources["NIM Resources"]
        Res_Acct["accounts"]
    end

    subgraph NonResource["Non-Resource URLs"]
        NR_Metrics["/metrics"]
    end

    %% SA to CRB
    SA_OMC -->|bound via| CRB_OMC
    SA_OMC -->|bound via| CRB_Proxy
    SA_MSA -->|bound via| CRB_MSA
    SA_CM -->|bound via| CRB_Metrics
    SA_OMC -->|bound via| RB_Leader

    %% CRB to CR
    CRB_OMC -->|grants| CR_OMC
    CRB_Proxy -->|grants| CR_Proxy
    CRB_MSA -->|grants| CR_MSA
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader -->|grants| R_Leader

    %% CR_OMC permissions (main controller role)
    CR_OMC -->|"CRUD + watch"| CoreResources
    CR_OMC -->|"CRUD + watch"| KServeResources
    CR_OMC -->|"CRUD + watch"| GatewayResources
    CR_OMC -->|"CRUD + watch"| Res_AP
    CR_OMC -->|"CRUD + watch"| Res_TA
    CR_OMC -->|"CRUD + watch"| MonitoringResources
    CR_OMC -->|"CRUD + watch"| Res_Acct

    %% CR_Proxy permissions
    CR_Proxy -->|create| Res_TR
    CR_Proxy -->|create| Res_SAR

    %% CR_MSA permissions
    CR_MSA -->|list| Res_GW
    CR_MSA -->|get| Res_NS

    %% CR_Metrics permissions
    CR_Metrics -->|create| Res_TR
    CR_Metrics -->|create| Res_SAR

    %% CR_MetricsR permissions
    CR_MetricsR -->|get| NR_Metrics

    %% Leader election
    R_Leader -->|"CRUD"| Res_CM
    R_Leader -->|"CRUD"| Res_Events

    %% Styling
    style SA_OMC fill:#4a90e2,stroke:#333,color:#fff
    style SA_MSA fill:#4a90e2,stroke:#333,color:#fff
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style CR_OMC fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style CR_MSA fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_MetricsR fill:#f5a623,stroke:#333
    style CR_Prom fill:#f5a623,stroke:#333
    style CR_Editor fill:#f5a623,stroke:#333
    style CR_Viewer fill:#f5a623,stroke:#333
    style R_Leader fill:#ffcc80,stroke:#333
    style Res_IS fill:#7ed321,stroke:#333
    style Res_LLMIS fill:#7ed321,stroke:#333
    style Res_SR fill:#7ed321,stroke:#333
    style Res_IG fill:#7ed321,stroke:#333
    style Res_Acct fill:#7ed321,stroke:#333
