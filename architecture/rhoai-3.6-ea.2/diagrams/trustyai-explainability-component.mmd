graph TB
    subgraph TrustyAI["TrustyAI Explainability Service"]
        subgraph Core["explainability-core (Java Library)"]
            Fairness["Fairness Metrics<br/>SPD, DIR"]
            Drift["Drift Detection<br/>KS Test, Fourier MMD, Meanshift"]
            XAI["XAI Explainers<br/>LIME, SHAP, Counterfactual"]
        end

        subgraph Connectors["explainability-connectors (Java Library)"]
            KServeV1["KServe v1 HTTP Client"]
            KServeV2["KServe v2 gRPC Client"]
        end

        subgraph Arrow["explainability-arrow (Java Library)"]
            ArrowBridge["Apache Arrow Bridge<br/>Java ↔ Python"]
        end

        subgraph Service["explainability-service (Quarkus 3.8.5)"]
            RestAPI["REST API<br/>8080/TCP HTTP<br/>4443/TCP HTTPS"]
            Consumer["Payload Consumer<br/>/consumer/kserve/v2"]
            MetricsEngine["Metrics Scheduler<br/>5s interval"]
            StorageLayer["Storage Layer"]
            PromExporter["Prometheus Exporter<br/>/q/metrics"]
        end

        RestAPI --> Fairness
        RestAPI --> Drift
        Consumer --> StorageLayer
        MetricsEngine --> Fairness
        MetricsEngine --> Drift
        MetricsEngine --> PromExporter
        Service --> Core
        Service --> Connectors
    end

    subgraph Storage["Storage Backends"]
        PVC["PVC Flat Files<br/>CSV format<br/>1Gi RWO"]
        MinIO["MinIO<br/>S3-compatible"]
        MariaDB["MariaDB/MySQL<br/>3306/TCP JDBC"]
    end

    subgraph InitContainer["Init Container"]
        ConfigOverrider["config-map-overrider<br/>Injects model-serving-config<br/>ConfigMap via oc CLI"]
    end

    ModelMesh["ModelMesh / KServe<br/>Model Servers"] -->|"POST /consumer/kserve/v2<br/>Inference payloads"| Consumer
    Prometheus["Prometheus<br/>ServiceMonitor"] -->|"GET /q/metrics<br/>Bearer SA token"| PromExporter
    Operator["trustyai-service-operator"] -->|"Deploys per namespace"| TrustyAI
    ConfigOverrider -->|"oc apply ConfigMap"| K8sAPI["OpenShift API Server<br/>443/TCP HTTPS"]

    StorageLayer --> PVC
    StorageLayer --> MinIO
    StorageLayer --> MariaDB

    KServeV1 -->|"HTTP"| ModelServersV1["KServe v1 Model Servers"]
    KServeV2 -->|"gRPC"| ModelServersV2["KServe v2 Model Servers"]

    Route["OpenShift Route<br/>80/TCP HTTP"] --> RestAPI

    style TrustyAI fill:#e8f4f8,stroke:#4a90e2,stroke-width:2px
    style Core fill:#dbeafe,stroke:#3b82f6
    style Connectors fill:#dbeafe,stroke:#3b82f6
    style Arrow fill:#dbeafe,stroke:#3b82f6
    style Service fill:#bfdbfe,stroke:#2563eb,stroke-width:2px
    style Storage fill:#fef3c7,stroke:#d97706
    style InitContainer fill:#fce7f3,stroke:#be185d
    style ModelMesh fill:#d1fae5,stroke:#059669
    style Prometheus fill:#d1fae5,stroke:#059669
    style Operator fill:#d1fae5,stroke:#059669
    style Route fill:#e0e7ff,stroke:#4f46e5
    style K8sAPI fill:#f5f5f5,stroke:#737373
