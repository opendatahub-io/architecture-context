graph TB
    subgraph Client["CLIENT ENVIRONMENT (User Workstation / Jupyter Notebook)"]
        SDK["CodeFlare SDK<br/>Python Library<br/>kube-authkit auth"]
        LocalFS["Local Filesystem<br/>~/.local/share/codeflare/tls/<br/>Perms: 0600/0700"]
    end

    subgraph K8sControl["KUBERNETES API (Trusted)"]
        APIServer["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph Operators["PLATFORM OPERATORS"]
        KubeRay["KubeRay Operator<br/>Watches ray.io/v1"]
        KueueCtrl["Kueue Controller<br/>Watches kueue.x-k8s.io"]
    end

    subgraph CRDs["CRD API Groups (via K8s API)"]
        RayCRDs["ray.io/v1<br/>RayCluster, RayJob"]
        KueueCRDs["kueue.x-k8s.io/v1beta1<br/>LocalQueue, WorkloadPriorityClass"]
        DSClusters["datasciencecluster.opendatahub.io/v1<br/>DataScienceCluster (read-only)"]
        GatewayConf["services.platform.opendatahub.io/v1alpha1<br/>GatewayConfig (read-only)"]
        GatewayAPI["gateway.networking.k8s.io<br/>HTTPRoute, Gateway (read-only)"]
        OSRoutes["route.openshift.io/v1<br/>Route (read-only)"]
    end

    subgraph UserNS["RAY CLUSTER (User Namespace)"]
        RayDash["Ray Dashboard<br/>8265/TCP HTTPS<br/>mTLS (RSA-3072, SHA-256)<br/>Auth: Bearer / None"]
    end

    %% Flows
    SDK -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer/OIDC/OAuth"| APIServer
    SDK -->|"Write certs<br/>0600 perms"| LocalFS

    APIServer --> RayCRDs
    APIServer --> KueueCRDs
    APIServer --> DSClusters
    APIServer --> GatewayConf
    APIServer --> GatewayAPI
    APIServer --> OSRoutes

    RayCRDs -->|watch events| KubeRay
    KueueCRDs -->|watch events| KueueCtrl
    KubeRay -->|"creates pods,<br/>services, CA secret"| UserNS

    SDK -->|"HTTPS/8265<br/>mTLS certs<br/>Bearer token (OpenShift)"| RayDash

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef crd fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef ray fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class SDK client
    class LocalFS storage
    class APIServer k8s
    class KubeRay,KueueCtrl operator
    class RayCRDs,KueueCRDs,DSClusters,GatewayConf,GatewayAPI,OSRoutes crd
    class RayDash ray
