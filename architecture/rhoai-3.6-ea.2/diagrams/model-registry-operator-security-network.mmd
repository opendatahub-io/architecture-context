graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS LAYER"]
        Gateway["data-science-gateway<br/>443/TCP<br/>TLS termination<br/>Gateway API"]
        OSRoute["OpenShift Route (legacy)<br/>443/TCP<br/>TLS Reencrypt"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER (kube-rbac-proxy)"]
        direction TB

        subgraph RegistryAuth["Per-Registry Auth"]
            RegProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TokenReview + SAR<br/>Per-registry Group access"]
        end

        subgraph CatalogAuth["Catalog Auth"]
            CatProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TokenReview + SAR<br/>system:authenticated"]
        end
    end

    subgraph AppLayer["APPLICATION LAYER"]
        direction TB

        subgraph RegistryNS["Namespace: {registry-namespace}"]
            RegistryPod["{registry-name}<br/>REST container<br/>8080/TCP HTTP<br/>SA: {registry-name}"]
        end

        subgraph CatalogNS["Namespace: target namespace"]
            CatalogPod["model-catalog<br/>Catalog API<br/>8080/TCP HTTP<br/>SA: model-catalog"]
        end
    end

    subgraph DataLayer["DATA LAYER"]
        direction TB
        RegistryDB["{registry-name}-postgres<br/>5432/TCP PostgreSQL<br/>NetworkPolicy restricted"]
        CatalogDB["model-catalog-postgres<br/>5432/TCP PostgreSQL<br/>NetworkPolicy restricted"]
    end

    subgraph ControlPlane["OPERATOR CONTROL PLANE"]
        Operator["controller-manager<br/>SA: model-registry-operator-<br/>controller-manager"]
        Metrics["Metrics: 8443/TCP HTTPS<br/>TLS cluster profile<br/>TokenReview + SAR"]
        Health["Health: 8081/TCP HTTP<br/>No auth"]
        Webhooks["Webhooks: 9443/TCP HTTPS<br/>TLS, K8s admission"]
    end

    subgraph PlatformAPIs["PLATFORM APIs"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OSConfig["OpenShift Config API<br/>TLS profile, ingress domain"]
        OSUsers["OpenShift User/Group API<br/>Per-registry groups"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Gateway
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| OSRoute

    %% Ingress to Auth
    Gateway -->|"HTTPS/8443<br/>TLS passthrough<br/>Forwarded identity"| RegProxy
    Gateway -->|"HTTPS/8443<br/>TLS passthrough<br/>Forwarded identity"| CatProxy
    OSRoute -->|"HTTPS/8443<br/>TLS reencrypt"| RegProxy

    %% Auth to App (localhost)
    RegProxy -->|"HTTP/8080<br/>None (localhost)<br/>Proxied identity"| RegistryPod
    CatProxy -->|"HTTP/8080<br/>None (localhost)<br/>Proxied identity"| CatalogPod

    %% Auth to K8s API (TokenReview)
    RegProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    CatProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% App to Data
    RegistryPod -->|"PostgreSQL/5432<br/>Password from Secret"| RegistryDB
    CatalogPod -->|"PostgreSQL/5432<br/>Password from Secret"| CatalogDB

    %% Operator to Platform APIs
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OSConfig
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OSUsers

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#e6d0de,stroke:#996699,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#666,stroke-width:2px

    class Client external
    class Gateway,OSRoute ingress
    class RegProxy,CatProxy auth
    class RegistryPod,CatalogPod app
    class RegistryDB,CatalogDB data
    class Operator,Metrics,Health,Webhooks operator
    class K8sAPI,OSConfig,OSUsers platform
