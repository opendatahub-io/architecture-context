graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["workbenches-operator-<br/>controller-manager"]
    end

    subgraph ClusterBindings["ClusterRole Bindings"]
        CRB1["workbenches-operator-<br/>manager-rolebinding"]
        CRB2["workbenches-operator-manager-<br/>rbac-escalate-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB1["leader-election-rolebinding<br/>(workbenches-operator-system)"]
        RB2["webhook-tls-rolebinding<br/>(system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["workbenches-operator-<br/>manager-role"]
        CR2["workbenches-operator-manager-<br/>rbac-escalate-role"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R1["leader-election-role"]
        R2["webhook-tls-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps"]
        Secrets["core<br/>secrets"]
        ServiceAccts["core<br/>serviceaccounts"]
        Services["core<br/>services"]
        Events["core<br/>events"]
        Namespaces["core<br/>namespaces"]
    end

    subgraph AdmissionResources["Admission Resources"]
        MWC["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations"]
        VWC["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
    end

    subgraph PlatformResources["Platform API Resources"]
        Workbenches["components.platform.opendatahub.io<br/>workbenches, /finalizers, /status"]
        Notebooks["kubeflow.org<br/>notebooks"]
        WorkspaceKinds["kubeflow.org<br/>workspacekinds"]
        HWProfiles["infrastructure.opendatahub.io<br/>hardwareprofiles"]
    end

    subgraph InfraResources["Infrastructure Resources"]
        Deployments["apps<br/>deployments"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        RBAC_CR["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        NetPol["networking.k8s.io<br/>networkpolicies"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        ImgStreams["image.openshift.io<br/>imagestreams"]
        APIServers["config.openshift.io<br/>apiservers"]
        ClusterIssuers["cert-manager.io<br/>clusterissuers"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        SvcMonitors["monitoring.coreos.com<br/>servicemonitors"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    %% Service Account → Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| RB1
    SA -->|bound via| RB2

    %% Bindings → Roles
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2
    RB1 -->|grants| R1
    RB2 -->|grants| R2

    %% Manager Role → Resources
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| ConfigMaps
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| Secrets
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| Services
    CR1 -->|"create,patch"| Events
    CR1 -->|"create,get,list,<br/>patch,update,watch"| Namespaces
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| Workbenches
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| Notebooks
    CR1 -->|"get"| HWProfiles
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| Deployments
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| MWC
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| RBAC_CR
    CR1 -->|"create,delete,get,<br/>list,patch,update,watch"| ImgStreams
    CR1 -->|"create"| SAR

    %% Escalate Role → Resources
    CR2 -->|"bind, escalate"| RBAC_CR

