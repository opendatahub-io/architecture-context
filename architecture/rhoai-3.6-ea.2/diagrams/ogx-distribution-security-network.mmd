graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformIngress["PLATFORM INGRESS (managed by ogx-operator)"]
        direction TB
        Note1["Ingress not defined in this repo<br/>Managed by ogx-operator"]
    end

    subgraph ServiceCluster["CLUSTER INTERNAL (ClusterIP)"]
        direction TB

        subgraph OGXNamespace["Namespace: ogx-deployment"]
            OGXServer["OGX Server<br/>8321/TCP HTTP<br/>OAuth2 JWT (conditional on AUTH_ISSUER)<br/>SA: managed by ogx-operator"]
            MetricsPort["/metrics endpoint<br/>metrics/TCP HTTP<br/>No auth"]
        end
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        direction TB
        vLLM["vLLM Inference<br/>configurable port<br/>HTTP/HTTPS<br/>Bearer token (VLLM_API_TOKEN)"]
        vLLMEmbed["vLLM Embedding<br/>configurable port<br/>HTTP/HTTPS<br/>Bearer token (VLLM_EMBEDDING_API_TOKEN)"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>No encryption (in-cluster)<br/>Username/password"]
        pgvector["pgvector<br/>5432/TCP<br/>No encryption<br/>Username/password"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape<br/>HTTP"]
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (Untrusted Network)"]
        direction TB
        OpenAI["OpenAI API<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        AnthropicAPI["Anthropic API<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS<br/>Bearer/IAM"]
        WatsonX["WatsonX<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        VertexAI["Vertex AI<br/>443/TCP HTTPS<br/>TLS<br/>OAuth2"]
        GeminiAPI["Gemini<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        OAuth2Issuer["OAuth2 JWKS Endpoint<br/>443/TCP HTTPS<br/>TLS<br/>AUTH_VERIFY_TLS configurable"]
    end

    subgraph ExternalStorage["EXTERNAL STORAGE"]
        direction TB
        Milvus["Milvus<br/>configurable port<br/>HTTP/gRPC<br/>Optional mTLS (ca_pem_path)<br/>Token auth"]
        Qdrant["Qdrant<br/>6333-6334/TCP<br/>HTTP/gRPC<br/>Optional HTTPS<br/>API key"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS credentials"]
    end

    subgraph ExternalTools["EXTERNAL TOOL SERVICES"]
        direction TB
        BraveAPI["Brave Search API<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        TavilyAPI["Tavily Search API<br/>443/TCP HTTPS<br/>TLS<br/>API key"]
        DoclingServe["Docling Serve<br/>configurable port<br/>HTTP<br/>API key"]
    end

    %% Inbound flows
    Client -->|"HTTP/8321<br/>Platform TLS (external)<br/>OAuth2 JWT (conditional)"| OGXServer
    Prometheus -->|"HTTP scrape<br/>No auth"| MetricsPort

    %% Internal service flows
    OGXServer -->|"HTTP(S)/configurable<br/>TLS (VLLM_TLS_VERIFY)<br/>Bearer token"| vLLM
    OGXServer -->|"HTTP(S)/configurable<br/>TLS<br/>Bearer token"| vLLMEmbed
    OGXServer -->|"TCP/5432<br/>No encryption<br/>Username/password"| PostgreSQL
    OGXServer -->|"TCP/5432<br/>No encryption<br/>Username/password"| pgvector

    %% External API flows
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| OpenAI
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| AnthropicAPI
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| AzureOAI
    OGXServer -->|"HTTPS/443<br/>TLS<br/>Bearer/IAM"| Bedrock
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| WatsonX
    OGXServer -->|"HTTPS/443<br/>TLS<br/>OAuth2"| VertexAI
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| GeminiAPI
    OGXServer -->|"HTTPS/443<br/>TLS"| OAuth2Issuer

    %% External storage flows
    OGXServer -->|"HTTP/gRPC<br/>Optional mTLS<br/>Token"| Milvus
    OGXServer -->|"HTTP/gRPC/6333-6334<br/>Optional HTTPS<br/>API key"| Qdrant
    OGXServer -->|"HTTPS/443<br/>TLS<br/>AWS credentials"| S3

    %% External tool flows
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| BraveAPI
    OGXServer -->|"HTTPS/443<br/>TLS<br/>API key"| TavilyAPI
    OGXServer -->|"HTTP/configurable<br/>API key"| DoclingServe

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externalapi fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tools fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class OGXServer,MetricsPort cluster
    class vLLM,vLLMEmbed,PostgreSQL,pgvector,Prometheus platform
    class OpenAI,AnthropicAPI,AzureOAI,Bedrock,WatsonX,VertexAI,GeminiAPI,OAuth2Issuer externalapi
    class Milvus,Qdrant,S3 storage
    class BraveAPI,TavilyAPI,DoclingServe tools
