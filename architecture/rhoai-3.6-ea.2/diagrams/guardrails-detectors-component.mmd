graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator"]
        OrcClient["Orchestrator Client<br/>(upstream consumer)"]
    end

    subgraph GD["guardrails-detectors"]
        subgraph Base["Shared Framework"]
            DetectorBaseAPI["DetectorBaseAPI<br/>(FastAPI subclass)"]
            InstrumentedDetector["InstrumentedDetector<br/>(Prometheus mixin)"]
            DetectorBaseAPI --- InstrumentedDetector
        end

        subgraph BuiltIn["built-in detector :8080"]
            BIApp["built_in/app.py"]
            RegexDet["Regex Detectors<br/>(PII: email, CC, SSN, phone, IP)"]
            FileTypeDet["File-Type Detectors<br/>(JSON, XML, YAML validation)"]
            CustomDet["Custom Detectors<br/>(user-supplied Python)"]
            BIApp --> RegexDet
            BIApp --> FileTypeDet
            BIApp --> CustomDet
        end

        subgraph HF["huggingface detector :8000"]
            HFApp["huggingface/app.py"]
            HFDetector["HuggingFace Detector"]
            SeqClass["Sequence Classification"]
            TokClass["Token Classification"]
            CausalLM["GraniteForCausalLM"]
            HFApp --> HFDetector
            HFDetector --> SeqClass
            HFDetector --> TokClass
            HFDetector --> CausalLM
        end

        subgraph Judge["llm_judge detector :8000"]
            JApp["llm_judge/app.py"]
            JDetector["LLMJudgeDetector<br/>(vllm_judge.Judge)"]
            JApp --> JDetector
        end

        Base -.->|extends| BIApp
        Base -.->|extends| HFApp
        Base -.->|extends| JApp
    end

    OrcClient -->|"POST /api/v1/text/contents"| BIApp
    OrcClient -->|"POST /api/v1/text/contents"| HFApp
    OrcClient -->|"POST /api/v1/text/contents"| JApp

    HFDetector -->|"load models"| S3["S3/MinIO<br/>Model Storage<br/>9000/TCP"]
    JDetector -->|"evaluation requests"| VLLM["vLLM Server<br/>(OpenAI-compatible)"]

    Prometheus["Prometheus"] -->|"GET /metrics"| BIApp
    Prometheus -->|"GET /metrics"| HFApp

    KServe["KServe<br/>(ServingRuntime)"] -.->|manages| HF
    KServe -.->|manages| Judge
    Istio["Istio Service Mesh"] -.->|"mTLS + auth"| GD

    style DetectorBaseAPI fill:#4a90e2,color:#fff
    style InstrumentedDetector fill:#4a90e2,color:#fff
    style BIApp fill:#7ed321,color:#fff
    style HFApp fill:#7ed321,color:#fff
    style JApp fill:#7ed321,color:#fff
    style S3 fill:#f5a623,color:#fff
    style VLLM fill:#f5a623,color:#fff
    style KServe fill:#999,color:#fff
    style Istio fill:#999,color:#fff
    style Prometheus fill:#999,color:#fff
    style OrcClient fill:#e8e8e8
