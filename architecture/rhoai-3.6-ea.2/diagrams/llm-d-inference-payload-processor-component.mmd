graph TB
    subgraph IPP["Inference Payload Processor (IPP)"]
        direction TB
        Server["ExternalProcessor Server<br/>gRPC 9004/TCP"]
        HealthSrv["Health Server<br/>gRPC 9005/TCP"]
        MetricsSrv["Metrics Server<br/>HTTP 9090/TCP"]

        subgraph PluginFW["Plugin Framework"]
            PreProc["PreProcessors"]
            ProfilePicker["ProfilePicker"]
            ReqPlugins["Request Plugins"]
            RespPlugins["Response Plugins"]
            PostProc["PostProcessors"]
        end

        subgraph ModelSel["ModelSelector"]
            Filter["Filter"]
            Score["Score"]
            Pick["Pick"]
        end

        subgraph DataLayer["Data Layer"]
            Extractors["Event-Driven Extractors"]
            Collectors["Periodic Collectors"]
            Datasources["Watch-Based Datasources"]
        end

        CertReloader["CertReloader<br/>fsnotify TLS hot-reload"]
    end

    Client["Client"] -->|"HTTPS/443<br/>Bearer Token"| Envoy["Envoy Proxy"]
    Envoy -->|"gRPC ext-proc<br/>9004/TCP<br/>Optional TLS"| Server
    Server --> PreProc
    PreProc --> ProfilePicker
    ProfilePicker --> ReqPlugins
    ReqPlugins -->|"model-selector plugin"| ModelSel
    Filter --> Score --> Pick
    ReqPlugins --> RespPlugins
    RespPlugins --> PostProc

    DataLayer -->|"state data"| ReqPlugins
    DataLayer -->|"state data"| ModelSel

    Server -->|"ext-proc response<br/>routing headers"| Envoy
    Envoy -->|"HTTP/8000"| ModelServer["Model Server<br/>(InferencePool)"]

    IPP -->|"REST+WSS/6443<br/>TLS 1.2+"| K8sAPI["Kubernetes API"]
    IPP -->|"gRPC/4317"| OTLP["OTLP Collector"]
    MetricsSrv -->|"HTTP/9090"| Prometheus["Prometheus"]
    CertReloader -->|"filesystem watch"| TLSCerts["TLS Certificates"]

    EPP["llm-d Router<br/>(EPP)"] -.->|"selects pods<br/>within pool"| ModelServer

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style HealthSrv fill:#4a90e2,stroke:#333,color:#fff
    style MetricsSrv fill:#4a90e2,stroke:#333,color:#fff
    style PreProc fill:#6bb5f0,stroke:#333
    style ProfilePicker fill:#6bb5f0,stroke:#333
    style ReqPlugins fill:#6bb5f0,stroke:#333
    style RespPlugins fill:#6bb5f0,stroke:#333
    style PostProc fill:#6bb5f0,stroke:#333
    style Filter fill:#82c8a0,stroke:#333
    style Score fill:#82c8a0,stroke:#333
    style Pick fill:#82c8a0,stroke:#333
    style Extractors fill:#c4a5de,stroke:#333
    style Collectors fill:#c4a5de,stroke:#333
    style Datasources fill:#c4a5de,stroke:#333
    style CertReloader fill:#f5a623,stroke:#333
    style Envoy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OTLP fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style EPP fill:#7ed321,stroke:#333
    style ModelServer fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style TLSCerts fill:#f9f9f9,stroke:#999
