graph LR
    KAP["kube-auth-proxy<br/>Go Service"]

    %% Platform Dependencies
    KAP -->|"TokenReview API<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]
    KAP -->|"OAuth2 flow<br/>443/TCP HTTPS"| OSAUTH["OpenShift OAuth Server"]
    KAP -->|"OIDC flow<br/>443/TCP HTTPS"| OIDCIdP["OIDC Identity Provider"]

    %% Optional Infrastructure
    KAP -->|"session storage<br/>TCP, optional TLS"| Redis["Redis / Valkey"]

    %% Go Library Dependencies
    KAP -->|"OIDC discovery<br/>& token verify"| GoOIDC["go-oidc v3.18"]
    KAP -->|"JWT parsing"| GoJWT["golang-jwt v5.3"]
    KAP -->|"HTTP routing"| GorillaMux["gorilla/mux v1.8"]
    KAP -->|"middleware chains"| Alice["justinas/alice v1.2"]
    KAP -->|"metrics"| Prometheus["prometheus/client_golang v1.23"]
    KAP -->|"config loading"| Viper["spf13/viper v1.21"]
    KAP -->|"OAuth2 client"| OAuth2Lib["golang.org/x/oauth2 v0.36"]
    KAP -->|"crypto"| XCrypto["golang.org/x/crypto v0.57"]
    KAP -->|"K8s client"| ClientGo["k8s.io/client-go v0.35"]

    %% Integration Points (consumers)
    Envoy["Envoy Proxy"] -->|"ext_authz<br/>4180/TCP HTTP"| KAP
    MLflow["MLflow Python SDK"] -->|"API requests<br/>4180/TCP HTTP"| KAP

    %% Upstream (target)
    KAP -->|"reverse proxy<br/>identity headers"| Upstream["Upstream Application(s)"]

