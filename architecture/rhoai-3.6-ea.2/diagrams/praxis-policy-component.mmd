graph TB
    subgraph Host["Host Process (e.g., Praxis Proxy)"]
        HostRuntime["Host Runtime<br/>pingora-backed HTTP"]
    end

    subgraph PPE["Praxis Policy Engine (PPE)"]
        direction TB

        subgraph Facade["praxis-policy (facade)"]
            FacadeCrate["Re-exports runtime +<br/>feature-gated builtins"]
        end

        subgraph Core["praxis-policy-core (runtime)"]
            PolicyEngine["PolicyEngine"]
            Executor["5-Phase Executor"]
            HookRegistry["Hook Registry"]
            ConfigParser["Config Parser"]
            HttpTransport["HttpTransport Seam"]
            PolicyEngine --> Executor
            PolicyEngine --> HookRegistry
            PolicyEngine --> ConfigParser
            PolicyEngine --> HttpTransport
        end

        subgraph APL["Authorization Policy Language"]
            APLCore["praxis-policy-apl-core<br/>Compiler + Evaluator"]
            APLCMF["praxis-policy-apl-cmf<br/>Extension to AttributeBag"]
            APLRuntime["praxis-policy-apl-runtime<br/>PluginInvoker + Routes"]
            APLRuntime --> APLCMF
            APLCMF --> APLCore
        end

        subgraph Orchestration["praxis-policy-orchestration"]
            BranchConcurrency["Async Branch-Concurrency<br/>Primitives"]
        end

        subgraph Builtins["praxis-policy-builtins (9 extensions)"]
            direction LR
            subgraph Identity["Identity Plugins"]
                JWT["JWT Resolver"]
                APIKey["API-Key Resolver"]
            end
            subgraph PDP["Policy Decision Points"]
                Cedar["Cedar PDP"]
                CEL["CEL PDP"]
                OPA["OPA/Rego PDP"]
            end
            subgraph Delegation["Delegation Plugins"]
                OAuth["OAuth Delegator"]
                CIBA["CIBA Elicitation"]
            end
            subgraph Storage["Storage Plugins"]
                Valkey["Valkey Sessions"]
                VaultPlugin["Vault Secrets"]
            end
        end

        FacadeCrate --> Core
        FacadeCrate --> Builtins
        Executor --> APLRuntime
        Executor --> BranchConcurrency
    end

    subgraph TestOnly["Test / Bench (not published)"]
        PDPDiff["praxis-policy-pdp-diff<br/>Differential PDP Tests"]
        Benches["ppe-benches<br/>Criterion Benchmarks"]
    end

    subgraph RefPlugins["Reference Plugins"]
        AuditLogger["Audit Logger Plugin"]
        PIIScanner["PII Scanner Plugin"]
    end

    HostRuntime -->|"embeds (function call)"| FacadeCrate

    %% Styling
    style PPE fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Host fill:#f0f0f0,stroke:#666,stroke-width:2px
    style Core fill:#d5e8d4,stroke:#82b366
    style APL fill:#fff2cc,stroke:#d6b656
    style Builtins fill:#ffe6cc,stroke:#d79b00
    style Orchestration fill:#dae8fc,stroke:#6c8ebf
    style Facade fill:#e1d5e7,stroke:#9673a6
    style TestOnly fill:#f8cecc,stroke:#b85450
    style RefPlugins fill:#f5f5f5,stroke:#999

    style PolicyEngine fill:#4a90e2,color:#fff
    style Executor fill:#4a90e2,color:#fff
    style Cedar fill:#f5a623
    style CEL fill:#f5a623
    style OPA fill:#f5a623
    style JWT fill:#7ed321
    style APIKey fill:#7ed321
