graph TB
    subgraph DSPO["Data Science Pipelines Operator"]
        direction TB
        DSPAReconciler["DSPAReconciler<br/>(Go Controller)"]
        AIPipelinesReconciler["AIPipelinesReconciler<br/>(Go Controller)"]
        AIPipelinesArgoReconciler["AIPipelinesArgoReconciler<br/>(Go Controller)"]
        ManifestTemplates["Manifest Templates<br/>(config/internal/)"]
        Webhook["Webhook Server<br/>(9443/TCP)"]
        Metrics["Metrics Endpoint<br/>(8080/TCP)"]
        HealthProbes["Health Probes<br/>(8081/TCP)"]

        DSPAReconciler -->|renders| ManifestTemplates
        AIPipelinesReconciler -->|manages DSPO deployment| DSPAReconciler
        AIPipelinesArgoReconciler -->|manages Argo CRDs/RBAC| ManifestTemplates
        DSPAReconciler -->|validates| Webhook
    end

    subgraph DeployedStack["Deployed Per-Namespace KFP v2 Stack"]
        direction TB
        APIServer["API Server<br/>(8888/TCP)"]
        PersistenceAgent["Persistence Agent"]
        ScheduledWorkflow["Scheduled Workflow<br/>Controller"]
        WorkflowController["Argo Workflow<br/>Controller"]
        MLMD["MLMD gRPC Server<br/>(8443/TCP + Envoy)"]
        MariaDB["MariaDB<br/>(3306/TCP, optional)"]
        MinIO["MinIO<br/>(optional)"]
    end

    %% CRDs
    DSPACR["DataSciencePipelinesApplication CR<br/>(Namespaced)"]
    AIPipelinesCR["AIPipelines CR<br/>(Cluster-scoped)"]
    PipelineCR["Pipeline / PipelineVersion CRs"]
    ArgoWorkflowCRs["Argo Workflow CRDs<br/>(Workflow, WorkflowTemplate,<br/>CronWorkflow, etc.)"]

    %% External dependencies
    K8sAPI["Kubernetes API<br/>(6443/TCP)"]
    OpenShiftConfig["OpenShift Config API<br/>(TLS Profile)"]

    %% Internal platform dependencies
    KServe["KServe"]
    ModelRegistry["MLflow Operator"]
    PrometheusOp["prometheus-operator"]
    Ray["Ray (ray.io)"]

    %% Flows
    User["User / Admin"] -->|creates| DSPACR
    DSPACR -->|watched by| DSPAReconciler
    AIPipelinesCR -->|watched by| AIPipelinesReconciler
    DSPAReconciler -->|deploys| DeployedStack
    DSPAReconciler -->|CRUD| K8sAPI
    DSPAReconciler -->|health check| MariaDB
    DSPAReconciler -->|health check| MinIO

    OpenShiftConfig -->|TLS profile| DSPO
    DSPAReconciler -->|creates Routes| OpenShiftRoutes["OpenShift Routes"]
    DSPAReconciler -->|creates| PrometheusOp
    DSPAReconciler -->|reads| ModelRegistry
    DeployedStack -->|creates| KServe
    DeployedStack -->|creates| Ray

    %% Styling
    style DSPAReconciler fill:#4a90e2,color:#fff
    style AIPipelinesReconciler fill:#4a90e2,color:#fff
    style AIPipelinesArgoReconciler fill:#4a90e2,color:#fff
    style ManifestTemplates fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style HealthProbes fill:#4a90e2,color:#fff
    style DSPACR fill:#f5a623,color:#fff
    style AIPipelinesCR fill:#f5a623,color:#fff
    style PipelineCR fill:#f5a623,color:#fff
    style ArgoWorkflowCRs fill:#f5a623,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style PersistenceAgent fill:#7ed321,color:#fff
    style ScheduledWorkflow fill:#7ed321,color:#fff
    style WorkflowController fill:#7ed321,color:#fff
    style MLMD fill:#7ed321,color:#fff
    style MariaDB fill:#7ed321,color:#fff
    style MinIO fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8
    style OpenShiftConfig fill:#e8e8e8
    style KServe fill:#d5e8d4
    style ModelRegistry fill:#d5e8d4
    style PrometheusOp fill:#d5e8d4
    style Ray fill:#d5e8d4
    style OpenShiftRoutes fill:#d5e8d4
