graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(datasciencepipelinesapplications-controller)"]
        SA_Argo["argo<br/>(argo namespace)"]
        SA_Prometheus["data-science-monitoringstack-prometheus<br/>(redhat-ods-monitoring)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_ManagerArgo["manager-argo-rolebinding"]
        CRB_ArgoCluster["ds-pipeline-argo-binding"]
        CRB_Prometheus["data-science-pipelines-operator-<br/>rhoai-prometheus"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(ns: datasciencepipelinesapplications-controller)"]
        RB_ArgoNS["argo-binding<br/>(ns: argo)"]
        RB_PromRule["prometheusrule-manager-rolebinding<br/>(ns: datasciencepipelinesapplications-controller)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role<br/>(39 rules, 30+ API groups)"]
        CR_ManagerArgo["manager-argo-role<br/>(13 rules)"]
        CR_ArgoCluster["argo-cluster-role<br/>(11 rules)"]
        CR_MetricsReader["data-science-pipelines-operator-<br/>metrics-reader"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        CR_ArgoAdmin["argo-aggregate-to-admin<br/>(Full CRUD on Argo resources)"]
        CR_ArgoEdit["argo-aggregate-to-edit<br/>(Full CRUD, excl. WorkflowTaskSets)"]
        CR_ArgoView["argo-aggregate-to-view<br/>(get, list, watch)"]
        CR_DSPAAdminEdit["aggregate-dspa-admin-edit<br/>(Full CRUD on DSPA, pipelines)"]
        CR_DSPAView["aggregate-dspa-admin-view<br/>(get, list, watch)"]
    end

    subgraph ManagerResources["manager-role Resources"]
        R_DSPA["datasciencepipelinesapplications.opendatahub.io<br/>DataSciencePipelinesApplication"]
        R_AIPipelines["components.platform.opendatahub.io<br/>AIPipelines"]
        R_Deployments["apps<br/>Deployments"]
        R_Services["core<br/>Services"]
        R_Secrets["core<br/>Secrets, ConfigMaps"]
        R_RBAC["rbac.authorization.k8s.io<br/>Roles, RoleBindings, ClusterRoles"]
        R_Routes["route.openshift.io<br/>Routes"]
        R_NetPol["networking.k8s.io<br/>NetworkPolicies"]
        R_Webhooks["admissionregistration.k8s.io<br/>ValidatingWebhookConfiguration"]
        R_CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
    end

    subgraph ArgoResources["Argo Resources"]
        R_Workflows["argoproj.io<br/>Workflows, WorkflowTemplates"]
        R_CronWF["argoproj.io<br/>CronWorkflows"]
        R_ClusterWFT["argoproj.io<br/>ClusterWorkflowTemplates"]
        R_TaskSets["argoproj.io<br/>WorkflowTaskSets, WorkflowTaskResults"]
        R_Pods["core<br/>Pods, ConfigMaps, PVCs"]
    end

    %% Service Account → ClusterRoleBinding flows
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_ManagerArgo
    SA_Argo -->|bound via| CRB_ArgoCluster
    SA_Prometheus -->|bound via| CRB_Prometheus

    %% Service Account → Namespace RoleBinding flows
    SA_CM -->|bound via| RB_Leader
    SA_Argo -->|bound via| RB_ArgoNS
    SA_CM -->|bound via| RB_PromRule

    %% ClusterRoleBinding → ClusterRole flows
    CRB_Manager -->|grants| CR_Manager
    CRB_ManagerArgo -->|grants| CR_ManagerArgo
    CRB_ArgoCluster -->|grants| CR_ArgoCluster
    CRB_Prometheus -->|grants| CR_MetricsReader

    %% ClusterRole → Resources
    CR_Manager -->|"Full CRUD"| R_DSPA
    CR_Manager -->|"Full CRUD"| R_AIPipelines
    CR_Manager -->|"Full CRUD"| R_Deployments
    CR_Manager -->|"Full CRUD"| R_Services
    CR_Manager -->|"Full CRUD"| R_Secrets
    CR_Manager -->|"Full CRUD"| R_RBAC
    CR_Manager -->|"Full CRUD"| R_Routes
    CR_Manager -->|"Full CRUD"| R_NetPol
    CR_Manager -->|"Full CRUD"| R_Webhooks
    CR_Manager -->|"Full CRUD"| R_CRDs

    CR_ManagerArgo -->|"Full CRUD"| R_Workflows
    CR_ManagerArgo -->|"Full CRUD"| R_CronWF
    CR_ArgoCluster -->|"Full CRUD"| R_Workflows
    CR_ArgoCluster -->|"Full CRUD"| R_Pods
    CR_ArgoCluster -->|"Full CRUD"| R_TaskSets

    %% Aggregate roles → built-in roles
    CR_ArgoAdmin -.->|"aggregated to admin"| AdminRole["admin (built-in)"]
    CR_ArgoEdit -.->|"aggregated to edit"| EditRole["edit (built-in)"]
    CR_ArgoView -.->|"aggregated to view"| ViewRole["view (built-in)"]
    CR_DSPAAdminEdit -.->|"aggregated to admin, edit"| AdminRole
    CR_DSPAView -.->|"aggregated to view"| ViewRole

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_Argo fill:#4a90e2,color:#fff
    style SA_Prometheus fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_ManagerArgo fill:#f5a623,color:#fff
    style CR_ArgoCluster fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_ArgoAdmin fill:#e8c6a0
    style CR_ArgoEdit fill:#e8c6a0
    style CR_ArgoView fill:#e8c6a0
    style CR_DSPAAdminEdit fill:#e8c6a0
    style CR_DSPAView fill:#e8c6a0
    style R_DSPA fill:#7ed321,color:#fff
    style R_AIPipelines fill:#7ed321,color:#fff
    style R_Deployments fill:#7ed321,color:#fff
    style R_Services fill:#7ed321,color:#fff
    style R_Secrets fill:#7ed321,color:#fff
    style R_RBAC fill:#7ed321,color:#fff
    style R_Routes fill:#7ed321,color:#fff
    style R_NetPol fill:#7ed321,color:#fff
    style R_Webhooks fill:#7ed321,color:#fff
    style R_CRDs fill:#7ed321,color:#fff
    style R_Workflows fill:#7ed321,color:#fff
    style R_CronWF fill:#7ed321,color:#fff
    style R_ClusterWFT fill:#7ed321,color:#fff
    style R_TaskSets fill:#7ed321,color:#fff
    style R_Pods fill:#7ed321,color:#fff
    style AdminRole fill:#e8e8e8
    style EditRole fill:#e8e8e8
    style ViewRole fill:#e8e8e8
