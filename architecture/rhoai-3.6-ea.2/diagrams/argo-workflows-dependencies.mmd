graph LR
    ArgoWorkflows["Argo Workflows<br/>workflow-controller + argoexec"]

    %% Internal RHOAI Dependencies
    ArgoWorkflows -->|"deployed by"| DSPOperator["data-science-pipelines-operator"]

    %% Core Infrastructure Dependencies
    ArgoWorkflows -->|"CRD watch, pod mgmt<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API<br/>v0.32.2"]

    %% Artifact Storage Dependencies
    ArgoWorkflows -->|"artifact I/O<br/>443/TCP HTTPS"| S3["S3 / Minio"]
    ArgoWorkflows -->|"artifact I/O<br/>443/TCP HTTPS"| GCS["Google Cloud Storage"]
    ArgoWorkflows -->|"artifact I/O<br/>443/TCP HTTPS"| AzureBlob["Azure Blob Storage"]
    ArgoWorkflows -.->|"artifact I/O"| HDFS["HDFS"]
    ArgoWorkflows -.->|"artifact I/O"| AliOSS["Alibaba OSS"]

    %% Optional Database Dependencies
    ArgoWorkflows -.->|"workflow archive<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    ArgoWorkflows -.->|"workflow archive<br/>3306/TCP"| MySQL["MySQL"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrape metrics<br/>9090/TCP HTTP"| ArgoWorkflows

    %% Build Dependencies
    ArgoWorkflows -->|"gRPC framework"| gRPC["google.golang.org/grpc<br/>v1.82.1"]
    ArgoWorkflows -->|"REST-to-gRPC"| GRPCGateway["grpc-gateway<br/>v1.16.0"]
    ArgoWorkflows -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.21.1"]
    ArgoWorkflows -->|"observability"| OTel["OpenTelemetry<br/>v1.43.0"]
    ArgoWorkflows -->|"OIDC auth"| OIDC["go-oidc/v3<br/>v3.9.0"]
    ArgoWorkflows -->|"cron parsing"| Cron["robfig/cron/v3<br/>v3.0.1"]
    ArgoWorkflows -->|"rate limiting"| Limiter["go-limiter<br/>v0.7.2"]

    %% Integration Points (downstream consumers)
    DSPServer["DSP Server"] -->|"replaces argo-server<br/>pipeline API"| ArgoWorkflows

