graph TB
    subgraph vLLM["vLLM CPU Inference Engine"]
        direction TB

        subgraph Entrypoints["Entrypoints"]
            APIServer["OpenAI API Server<br/>(FastAPI + Uvicorn)<br/>Port 8000/TCP"]
            GRPCServer["gRPC Server<br/>(smg-grpc-servicer)<br/>Port 50051/TCP"]
            CLI["CLI Tool<br/>(vllm serve/chat/bench)"]
            DPSupervisor["DP Supervisor<br/>Port 9256/TCP"]
        end

        subgraph Middleware["Middleware"]
            AuthMW["Auth Middleware<br/>Bearer Token<br/>(SHA-256 + constant-time)"]
            CORS["CORS Middleware"]
            SSLRefresh["SSL Cert Refresher<br/>(watchfiles hot-reload)"]
        end

        subgraph Engine["Engine Core"]
            AsyncLLM["AsyncLLM (V1 Engine)<br/>Scheduler + KV Cache"]
            Workers["Worker Processes<br/>(fork-based / ZMQ IPC)"]
        end

        subgraph Native["Native Extensions"]
            CPUKernels["C/C++ CPU Kernels<br/>Attention, Quantization, GEMM"]
            RustLib["Rust Library<br/>Chat Templates, Tool Parsing"]
        end

        APIServer --> AuthMW
        APIServer --> CORS
        APIServer --> SSLRefresh
        APIServer --> AsyncLLM
        GRPCServer --> AsyncLLM
        CLI --> APIServer
        DPSupervisor -->|health aggregation| APIServer
        AsyncLLM --> Workers
        Workers --> CPUKernels
        Workers --> RustLib
    end

    subgraph APIRouters["API Router Modules"]
        OpenAIChat["/v1/chat/completions"]
        OpenAICompletions["/v1/completions"]
        Embeddings["/v1/embeddings"]
        Responses["/v1/responses"]
        AnthropicMsgs["/v1/messages"]
        ScoreRerank["/v1/score, /v1/rerank"]
        Audio["/v1/audio/*"]
        LoRA["/v1/load_lora_adapter"]
    end

    Client[External Client] -->|HTTP/8000| APIServer
    Client -->|gRPC/50051| GRPCServer
    APIServer --> OpenAIChat
    APIServer --> OpenAICompletions
    APIServer --> Embeddings
    APIServer --> Responses
    APIServer --> AnthropicMsgs
    APIServer --> ScoreRerank
    APIServer --> Audio
    APIServer --> LoRA

    Workers -->|read-only| ModelWeights[Model Weights<br/>Filesystem]

    style APIServer fill:#4a90e2,color:#fff
    style GRPCServer fill:#4a90e2,color:#fff
    style AsyncLLM fill:#4a90e2,color:#fff
    style DPSupervisor fill:#4a90e2,color:#fff
    style CPUKernels fill:#e8744f,color:#fff
    style RustLib fill:#e8744f,color:#fff
    style AuthMW fill:#f5a623,color:#fff
    style Client fill:#999,color:#fff
    style ModelWeights fill:#7ed321,color:#fff
