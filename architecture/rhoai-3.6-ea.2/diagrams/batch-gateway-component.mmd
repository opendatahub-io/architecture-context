graph TB
    subgraph BatchGateway["Batch Gateway"]
        direction TB

        subgraph APIServer["API Server (Deployment)"]
            APIHandler["REST API Handler<br/>8000/TCP"]
            ObsAPI["Observability<br/>8081/TCP<br/>/health, /ready, /metrics"]
            TenantMiddleware["Tenant Middleware<br/>X-MaaS-Username"]
            SecurityHeaders["Security Headers<br/>Middleware"]
            APIHandler --> TenantMiddleware
            TenantMiddleware --> SecurityHeaders
        end

        subgraph Processor["Processor (StatefulSet)"]
            Workers["Job Workers<br/>numWorkers=5"]
            AIMD["AIMD Concurrency<br/>Controller"]
            SyncDispatch["Sync Dispatch<br/>HTTP to llm-d"]
            AsyncDispatch["Async Dispatch<br/>via llm-d-async"]
            ObsProc["Observability<br/>9090/TCP"]
            Workers --> AIMD
            AIMD --> SyncDispatch
            AIMD --> AsyncDispatch
        end

        subgraph GC["Garbage Collector (Deployment)"]
            ExpiredScanner["Expired Job Scanner"]
            OrphanReconciler["Orphan Reconciler"]
            ObsGC["Observability<br/>9091/TCP"]
        end
    end

    Client[External Client] -->|"HTTPS/443<br/>API Key / Token"| Gateway["Kuadrant/Authorino<br/>Gateway"]
    Gateway -->|"HTTP(S)/8000<br/>X-MaaS-Username"| APIHandler

    APIHandler -->|"create job"| PostgreSQL["PostgreSQL"]
    APIHandler -->|"enqueue job"| Redis["Redis/Valkey"]
    APIHandler -->|"upload/download"| S3["S3-compatible<br/>Storage"]

    Workers -->|"pull jobs"| Redis
    Workers -->|"read/update"| PostgreSQL
    Workers -->|"get input"| S3
    SyncDispatch -->|"HTTP(S)<br/>Optional mTLS"| LLMd["llm-d Inference<br/>Gateway"]
    AsyncDispatch -->|"Redis queues"| LLMdAsync["llm-d-async"]
    Workers -->|"upload output"| S3

    ExpiredScanner -->|"delete expired"| PostgreSQL
    ExpiredScanner -->|"cleanup"| Redis
    OrphanReconciler -->|"HTTPS/6443<br/>SA Token"| K8sAPI["Kubernetes API"]

    APIHandler -->|"traces"| OTel["OpenTelemetry<br/>Collector"]
    Workers -->|"traces"| OTel

    style APIHandler fill:#4a90e2,color:#fff
    style Workers fill:#4a90e2,color:#fff
    style ExpiredScanner fill:#4a90e2,color:#fff
    style OrphanReconciler fill:#4a90e2,color:#fff
    style Gateway fill:#f5a623,color:#fff
    style PostgreSQL fill:#336791,color:#fff
    style Redis fill:#dc382d,color:#fff
    style S3 fill:#569a31,color:#fff
    style LLMd fill:#7ed321,color:#000
    style LLMdAsync fill:#7ed321,color:#000
    style K8sAPI fill:#326ce5,color:#fff
    style OTel fill:#999,color:#fff
    style Client fill:#f9f9f9,stroke:#333
