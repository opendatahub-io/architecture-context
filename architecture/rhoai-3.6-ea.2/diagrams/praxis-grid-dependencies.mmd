graph LR
    GridOperator["Grid Operator<br/>(praxis-grid)"]

    %% Internal Platform Dependencies
    GridOperator -->|"ConfigMap overlay write"| PraxisGW["Praxis AI Gateway"]
    GridOperator -.->|"optional integration"| CertManager["cert-manager"]
    GridOperator -.->|"ServiceMonitor CRD"| PrometheusOp["Prometheus Operator"]
    GridOperator -.->|"optional Helm template"| OSRoutes["OpenShift Routes"]

    %% Cross-Site Dependencies
    GridOperator -->|"SWIM gossip 7946/UDP"| PeerOperators["Peer Site Operators"]
    GridOperator -->|"signals poll 9091/TCP"| PeerOperators
    GridOperator -->|"mTLS enrollment"| EnrollmentSrv["Enrollment Server"]
    EnrollmentSrv -->|"SQL 5432/TCP"| PostgreSQL["PostgreSQL"]

    %% External Service Dependencies
    GridOperator -->|"health probes"| ProviderBackends["Provider Backends<br/>(OpenAI, Anthropic, etc.)"]
    GridOperator -->|"MCP probing (rmcp)"| MCPServers["MCP Tool Servers"]
    GridOperator -->|"CRD watches, SSA"| K8sAPI["Kubernetes API Server"]

    %% Downstream Consumers
    OverlaySync["overlay-sync sidecar"] -->|"ConfigMap watch"| GridOperator
    FleetDash["fleet-dashboard"] -->|"Prometheus queries"| PrometheusOp

    %% Integration Points (other components using Grid)
    PraxisGW -->|"hot-reloads"| OverlaySync

    %% Key Rust Crate Dependencies
    subgraph KeyCrates["Key Rust Dependencies"]
        direction TB
        Foca["foca 1.0.0<br/>SWIM protocol"]
        Kube["kube 4.2.0<br/>K8s controller runtime"]
        Axum["axum 0.8.9<br/>HTTP framework"]
        Rustls["rustls 0.23<br/>TLS (default)"]
        OpenSSL["openssl 0.10<br/>TLS (FIPS)"]
        RMCP["rmcp 3.1.4<br/>MCP client"]
        SQLx["sqlx 0.9<br/>PostgreSQL driver"]
    end

    GridOperator --- Foca
    GridOperator --- Kube
    GridOperator --- Axum
    GridOperator --- Rustls
    GridOperator --- RMCP
    EnrollmentSrv --- SQLx

    %% Styles
    style GridOperator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PraxisGW fill:#7ed321,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style PrometheusOp fill:#999,stroke:#333,color:#fff
    style OSRoutes fill:#999,stroke:#333,color:#fff
    style PeerOperators fill:#9673a6,stroke:#333,color:#fff
    style EnrollmentSrv fill:#82b366,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style ProviderBackends fill:#f5a623,stroke:#333,color:#fff
    style MCPServers fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style OverlaySync fill:#9673a6,stroke:#333,color:#fff
    style FleetDash fill:#82b366,stroke:#333,color:#fff
    style Foca fill:#dae8fc,stroke:#6c8ebf
    style Kube fill:#dae8fc,stroke:#6c8ebf
    style Axum fill:#dae8fc,stroke:#6c8ebf
    style Rustls fill:#dae8fc,stroke:#6c8ebf
    style OpenSSL fill:#dae8fc,stroke:#6c8ebf
    style RMCP fill:#dae8fc,stroke:#6c8ebf
    style SQLx fill:#dae8fc,stroke:#6c8ebf
