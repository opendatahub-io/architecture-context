graph TB
    subgraph SimPod["llm-d-inference-sim Pod"]
        direction TB

        subgraph MainContainer["llm-d-inference-sim (Go, :8000)"]
            direction TB
            CMux["cmux Listener<br/>Connection Multiplexer"]

            subgraph HTTPLayer["HTTP Layer (fasthttp)"]
                Router["fasthttprouter<br/>Route Dispatcher"]
                ChatAPI["/v1/chat/completions"]
                CompAPI["/v1/completions"]
                EmbedAPI["/v1/embeddings"]
                ModelsAPI["/v1/models"]
                HealthAPI["/health + /health/ready"]
                MetricsAPI["/metrics"]
                AdminAPI["/admin/config"]
                LoRAAPI["/v1/load_lora_adapter<br/>/v1/unload_lora_adapter"]
            end

            subgraph GRPCLayer["gRPC Layer"]
                VllmGRPC["VllmEngine gRPC Service<br/>Generate, Embed, HealthCheck,<br/>Abort, GetModelInfo"]
            end

            subgraph EngineLayer["Engine Abstraction"]
                EngineIface["Engine Interface"]
                VllmEngine["vLLM Engine Backend"]
                SGLangEngine["SGLang Engine Backend"]
                EngineIface --- VllmEngine
                EngineIface --- SGLangEngine
            end

            subgraph CoreSim["Simulation Core"]
                Processor["Processor<br/>Request Handler"]
                WorkerQueue["Worker Queue<br/>Concurrency Control"]
                ResponseGen["Response Generator<br/>Echo / Random Mode"]
                LatencyModel["Latency Model<br/>TTFT, Inter-token,<br/>Load-dependent"]
            end

            subgraph KVCache["KV Cache Subsystem"]
                BlockCache["Block Cache<br/>Simulated Memory"]
                KVSender["KV Event Sender<br/>Batched"]
                EventEncoder["Engine Event Encoder<br/>msgpack"]
                ZMQPub["ZMQ Publisher<br/>PUB Socket"]
            end

            CMux -->|HTTP| Router
            CMux -->|gRPC| VllmGRPC
            Router --> ChatAPI
            Router --> CompAPI
            Router --> EmbedAPI
            Router --> ModelsAPI
            Router --> HealthAPI
            Router --> MetricsAPI
            Router --> AdminAPI
            Router --> LoRAAPI
            ChatAPI --> Processor
            CompAPI --> Processor
            EmbedAPI --> Processor
            VllmGRPC --> Processor
            Processor --> WorkerQueue
            WorkerQueue --> ResponseGen
            WorkerQueue --> LatencyModel
            ResponseGen -->|tokens| BlockCache
            BlockCache -->|events| KVSender
            KVSender --> EventEncoder
            EventEncoder --> ZMQPub
        end

        subgraph Sidecar["vllm-render Sidecar (:8082)"]
            RenderServer["vLLM Render Server<br/>HuggingFace Tokenization"]
        end

        MainContainer -->|"HTTP :8082<br/>tokenize requests"| Sidecar
    end

    Client["Client<br/>curl / test harness / router"] -->|"HTTP/gRPC :8000<br/>Optional TLS 1.2+"| CMux
    ZMQPub -->|"ZMQ PUB :5557<br/>KV cache events"| LLMDRouter["llm-d-router<br/>Cache-Aware Scheduler"]
    RenderServer -->|"HTTPS :443<br/>Bearer HF_TOKEN"| HFHub["HuggingFace Hub"]
    Prometheus["Prometheus"] -->|"HTTP :8000<br/>scrape /metrics"| MetricsAPI

    DatasetTool["dataset-tool CLI"] -.->|creates| SQLiteDB["SQLite Dataset"]
    SQLiteDB -.->|loaded by| ResponseGen

    style CMux fill:#4a90e2,color:#fff
    style Processor fill:#4a90e2,color:#fff
    style ZMQPub fill:#4a90e2,color:#fff
    style RenderServer fill:#4a90e2,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style LLMDRouter fill:#7ed321,color:#fff
    style HFHub fill:#f5a623,color:#fff
    style Prometheus fill:#f5a623,color:#fff
    style DatasetTool fill:#e8e8e8,stroke:#999
    style SQLiteDB fill:#e8e8e8,stroke:#999
