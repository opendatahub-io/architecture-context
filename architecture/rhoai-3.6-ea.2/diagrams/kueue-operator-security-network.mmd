graph TB
    subgraph External["EXTERNAL (User Interaction)"]
        Admin["Cluster Admin"]
        User["Data Scientist / User"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC Enforced"]
    end

    subgraph OperatorNS["NAMESPACE: openshift-kueue-operator<br/>NetworkPolicy: deny-all + explicit allows"]
        direction TB

        Operator["openshift-kueue-operator<br/>SA: openshift-kueue-operator<br/>Priority: system-cluster-critical<br/>2 replicas, UID 1001<br/>FIPS: strictfipsruntime"]

        subgraph OperandServices["Operand Services"]
            WebhookSvc["kueue-webhook-service<br/>ClusterIP 443 -> 9443/TCP<br/>TLS (cert-manager)<br/>FailurePolicy: Fail"]
            MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS (cert-manager)<br/>Bearer + mTLS"]
            VisibilitySvc["kueue-visibility-server<br/>ClusterIP 443 -> 8082/TCP<br/>TLS<br/>API Aggregation"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
        end

        KueueCtrl["kueue-controller-manager<br/>SA: kueue-controller-manager<br/>1 replica"]
        KueueCtrl --- WebhookSvc
        KueueCtrl --- MetricsSvc
        KueueCtrl --- VisibilitySvc
        KueueCtrl --- HealthProbe
    end

    subgraph OptedIn["OPTED-IN NAMESPACES<br/>Label: kueue.openshift.io/managed=true"]
        Workloads["User Workloads<br/>Jobs, PyTorchJobs, RayJobs,<br/>AppWrappers, JobSets"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>Hard Dependency<br/>TLS Provisioning"]
        PromOperator["prometheus-operator<br/>ServiceMonitor"]
        Prometheus["Prometheus<br/>Metrics Scraping"]
    end

    subgraph WorkloadFrameworks["WORKLOAD FRAMEWORKS"]
        Kubeflow["Kubeflow Training Operator<br/>PyTorchJob, TFJob, MPIJob"]
        KubeRay["KubeRay<br/>RayCluster, RayJob"]
        CodeFlare["CodeFlare<br/>AppWrapper"]
        JobSetCtrl["JobSet Controller<br/>JobSet"]
    end

    %% User flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Token"| APIServer
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Token"| APIServer

    %% API to webhooks
    APIServer -->|"HTTPS/443<br/>TLS (cert-manager)<br/>K8s Admission"| WebhookSvc

    %% Operator flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token (CRD CRUD)"| CertManager

    %% Controller flows
    KueueCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    %% Monitoring
    Operator -->|"creates"| PromOperator
    Prometheus -->|"HTTPS/8443<br/>TLS (cert-manager)<br/>Bearer + mTLS"| MetricsSvc

    %% Workload interception
    WebhookSvc -.->|"mutates/validates"| Workloads
    WebhookSvc -.->|"intercepts CRDs"| Kubeflow
    WebhookSvc -.->|"intercepts CRDs"| KubeRay
    WebhookSvc -.->|"intercepts CRDs"| CodeFlare
    WebhookSvc -.->|"intercepts CRDs"| JobSetCtrl

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef optedIn fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef framework fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Admin,User external
    class APIServer controlplane
    class Operator,KueueCtrl,WebhookSvc,MetricsSvc,VisibilitySvc,HealthProbe operatorns
    class Workloads optedIn
    class CertManager,PromOperator,Prometheus platform
    class Kubeflow,KubeRay,CodeFlare,JobSetCtrl framework
