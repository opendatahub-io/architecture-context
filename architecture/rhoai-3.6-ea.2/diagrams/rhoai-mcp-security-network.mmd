graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Agent["AI Agent<br/>(Claude Desktop / Code)"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP → 8000/TCP<br/>TLS edge termination"]
    end

    subgraph Application["APPLICATION (redhat-ods-applications)"]
        direction TB
        MCP["rhoai-mcp Pod<br/>SA: rhoai-mcp<br/>runAsNonRoot, readOnlyRootFS<br/>drop ALL caps, seccomp: RuntimeDefault<br/>100m-500m CPU, 256Mi-1Gi memory"]

        subgraph Endpoints["Endpoints"]
            Health["/health GET 8000<br/>No auth"]
            SSE["/sse GET 8000<br/>Bearer OIDC"]
            Messages["/messages POST 8000<br/>Bearer OIDC"]
            WellKnown["/.well-known/oauth-protected-resource<br/>GET 8000 No auth"]
        end

        subgraph AuthFlow["Auth Pipeline"]
            OIDCMiddleware["OIDCAuthMiddleware<br/>JWT Validation<br/>RS256 / ES256 only"]
            UserCtx["UserContext<br/>contextvars"]
            RBACFilter["RBAC Tool Filtering<br/>SubjectAccessReview"]
        end

        MCP --> Endpoints
        MCP --> OIDCMiddleware
        OIDCMiddleware --> UserCtx
        UserCtx --> RBACFilter
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OIDCProv["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>JWKS rate-limited 30s"]
    end

    subgraph InternalServices["INTERNAL SERVICES"]
        ModelReg["Model Registry<br/>8080/TCP HTTP or 8443/TCP HTTPS<br/>OAuth / Bearer token"]
        ModelCat["Model Catalog<br/>8080/TCP HTTPS<br/>TLS service-serving CA<br/>SA token auth<br/>NetworkPolicy controlled"]
    end

    %% Flows
    Agent -->|"HTTPS/443<br/>TLS edge<br/>Bearer (OIDC JWT / OCP OAuth)"| Route
    Route -->|"HTTP/8000<br/>Token passed through"| MCP
    MCP -->|"HTTPS/6443<br/>TLS 1.2+<br/>User token forwarded<br/>or Impersonation headers"| K8sAPI
    OIDCMiddleware -->|"HTTPS/443<br/>TLS 1.2+<br/>Public JWKS endpoint"| OIDCProv
    MCP -->|"HTTP or HTTPS<br/>8080 or 8443<br/>OAuth / Bearer"| ModelReg
    MCP -->|"HTTPS<br/>8080 or 8443<br/>SA token"| ModelCat

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Agent external
    class Route ingress
    class MCP app
    class Health,SSE,Messages,WellKnown app
    class OIDCMiddleware,UserCtx,RBACFilter auth
    class K8sAPI,OIDCProv cluster
    class ModelReg,ModelCat internal
