graph TB
    subgraph ai4rag_lib["ai4rag Core Library"]
        Experiment["AI4RAGExperiment<br/>Orchestrator"]
        HPO["GAM Optimizer<br/>(pygam)"]
        Chunking["Docling Chunker<br/>(structure-aware)"]
        Retriever["Retriever<br/>(similarity search)"]
        Evaluator["Evaluator<br/>(RAGAS / Unitxt)"]
        URLPolicy["URL Trust Policy<br/>(ensure_safe_url)"]

        Experiment -->|drives| HPO
        Experiment -->|configures| Chunking
        Experiment -->|configures| Retriever
        Experiment -->|scores via| Evaluator
        HPO -->|next trial| Experiment
    end

    subgraph vector_stores["Vector Store Backends"]
        Milvus["Milvus<br/>19530/TCP gRPC"]
        MilvusLite["Milvus Lite<br/>(embedded local)"]
        PGVector["PostgreSQL/pgvector<br/>5432/TCP"]
        Neo4j["Neo4j<br/>7687/TCP Bolt+TLS"]
    end

    subgraph starter_kit["Agentic RAG Starter Kit"]
        AuthWrapper["auth_wrapper<br/>(K8s TokenReview)"]
        FastAPI["FastAPI Service<br/>8080/TCP"]
        LCAgent["LangChain Agent<br/>(query rewrite + retrieval)"]

        AuthWrapper -->|authenticates| FastAPI
        FastAPI -->|delegates| LCAgent
    end

    User["User / Notebook"] -->|runs experiment| Experiment
    Client["External Client"] -->|"POST /v1/responses<br/>Bearer token"| AuthWrapper

    Retriever -->|queries| Milvus
    Retriever -->|queries| MilvusLite
    Retriever -->|queries| PGVector
    Retriever -->|queries| Neo4j
    LCAgent -->|queries| Milvus
    LCAgent -->|queries| PGVector

    Experiment -->|"HTTPS<br/>API key"| MaaS["OpenAI-compatible<br/>MaaS Endpoint"]
    LCAgent -->|"HTTPS<br/>API key"| MaaS
    Experiment -->|"HTTPS<br/>AWS IAM"| S3["S3 Storage"]

    URLPolicy -.->|enforces HTTPS| MaaS
    URLPolicy -.->|enforces HTTPS| S3
    URLPolicy -.->|enforces TLS| Milvus
    URLPolicy -.->|enforces TLS| PGVector
    URLPolicy -.->|enforces TLS| Neo4j

    style Experiment fill:#4a90e2,color:#fff
    style HPO fill:#4a90e2,color:#fff
    style Chunking fill:#4a90e2,color:#fff
    style Retriever fill:#4a90e2,color:#fff
    style Evaluator fill:#4a90e2,color:#fff
    style URLPolicy fill:#d0021b,color:#fff
    style AuthWrapper fill:#d0021b,color:#fff
    style FastAPI fill:#7ed321
    style LCAgent fill:#7ed321
    style MaaS fill:#f5a623
    style S3 fill:#f5a623
    style Milvus fill:#e8e8e8
    style MilvusLite fill:#e8e8e8
    style PGVector fill:#e8e8e8
    style Neo4j fill:#e8e8e8
