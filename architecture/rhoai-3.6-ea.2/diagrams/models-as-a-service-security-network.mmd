graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        direction TB
        Gateway["data-science-gateway<br/>443/TCP → 8443/TCP<br/>TLS 1.2+ (SIMPLE)<br/>HTTPRoute with 5 rules"]
        Authorino["Kuadrant/Authorino<br/>Dual Auth Path:<br/>1. API key callback<br/>2. TokenReview<br/>Header strip + injection"]
        Gateway --> Authorino
    end

    subgraph AppServices["APPLICATION SERVICES (Cluster-Internal)"]
        direction TB

        subgraph InfraNS["Namespace: infrastructure"]
            API["maas-api<br/>SA: maas-api<br/>:8080/TCP HTTP (API)<br/>:9090/TCP HTTPS (metrics)<br/>FIPS: strictfipsruntime"]
        end

        subgraph ControllerNS["Namespace: controller"]
            Controller["maas-controller<br/>SA: maas-controller<br/>:8081/TCP (health)<br/>:8443/TCP HTTPS (metrics)<br/>FIPS: strictfipsruntime"]
            DiscoverySvc["maas-discovery<br/>SA: maas-discovery<br/>:8443/TCP HTTPS<br/>FIPS: strictfipsruntime"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        Limitador["Kuadrant/Limitador<br/>TokenRateLimitPolicy"]
        KServe["KServe<br/>LLMInferenceService<br/>(conditional watch)"]
        ServiceCA["OpenShift service-ca<br/>Certificate provisioning"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Secret: maas-db-config"]
        OTel["OpenTelemetry Collector<br/>gRPC OTLP<br/>Runtime-configured"]
        GatewayInternal["Gateway Internal Host<br/>8443/TCP HTTPS<br/>Model access probes"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer: sk-oai-* or OCP token"| Gateway

    %% Authorino callbacks
    Authorino -->|"HTTPS/8443<br/>TLS<br/>Internal callback<br/>NetworkPolicy-protected"| API
    Authorino -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview"| K8sAPI

    %% Gateway → App
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Stripped auth + identity headers"| API

    %% App → Platform
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    API -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    DiscoverySvc -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    Controller -->|"creates policies"| Limitador
    Controller -.->|"conditional watch"| KServe

    %% App → External
    API -->|"TCP/5432<br/>Secret credential"| PostgreSQL
    API -->|"gRPC OTLP<br/>Runtime-configured"| OTel
    API -->|"HTTPS/8443<br/>TLS"| GatewayInternal

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway,Authorino ingress
    class API,Controller,DiscoverySvc app
    class K8sAPI,Limitador,KServe,ServiceCA platform
    class PostgreSQL,OTel,GatewayInternal extsvc
