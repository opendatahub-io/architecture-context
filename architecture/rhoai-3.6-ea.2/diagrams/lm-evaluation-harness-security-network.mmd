graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph ControlPlane["OPERATOR (Control Plane)"]
            Operator["TrustyAI LMES Operator<br/>Manages LMEvalJob CRDs"]
        end

        subgraph JobNS["JOB NAMESPACE (Batch Workload)"]
            direction TB
            Job["lmes-job Pod<br/>Image: odh-ta-lmes-job-rhel9<br/>UID: 65532 (non-root)<br/>No listening ports"]
            ConfigMount["/meta/job.json<br/>(ConfigMap mount)"]
            TestDataMount["/test_data<br/>(optional, air-gapped)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB
        Model["Model Inference Endpoint<br/>HTTP/HTTPS<br/>Configurable TLS<br/>Bearer: OPENAI_API_KEY"]
        EvalHub["EvalHub Callback<br/>HTTPS<br/>TLS<br/>Service credentials"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>HF_TOKEN (optional)"]
        S3["S3-Compatible Storage<br/>HTTPS<br/>TLS (S3_VERIFY_SSL)<br/>AWS IAM"]
        OCIReg["OCI Registry<br/>443/TCP HTTPS<br/>TLS<br/>Registry credentials"]
        MLflow["MLflow Server<br/>HTTP/HTTPS<br/>Optional TLS<br/>Optional auth"]
    end

    %% Internal flows
    Operator -->|"Kubernetes API<br/>Job creation<br/>RBAC"| Job
    ConfigMount -->|"Filesystem<br/>mount"| Job
    TestDataMount -.->|"Filesystem<br/>mount (optional)"| Job

    %% Egress flows
    Job -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Bearer: OPENAI_API_KEY"| Model
    Job -->|"HTTPS<br/>TLS<br/>Service credentials"| EvalHub
    Job -.->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub
    Job -->|"HTTPS<br/>TLS (S3_VERIFY_SSL)<br/>AWS IAM"| S3
    Job -->|"HTTPS/443<br/>TLS<br/>Registry creds"| OCIReg
    Job -.->|"HTTP/HTTPS<br/>Optional"| MLflow

    %% Styling
    classDef cluster fill:#f0f0f0,stroke:#666,stroke-width:2px
    classDef operator fill:#dce6f5,stroke:#4a6fa5,stroke-width:2px
    classDef job fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef config fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class Operator operator
    class Job job
    class ConfigMount,TestDataMount config
    class Model,EvalHub,HFHub,S3,OCIReg,MLflow external
