graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph Platform["PLATFORM INGRESS (Platform-Managed)"]
        Ingress["Platform Ingress / Istio<br/>TLS termination at platform level<br/>No ingress resources in repo"]
    end

    subgraph Application["APPLICATION (NeMo Guardrails Pod)"]
        direction TB
        Server["NeMo Guardrails Server<br/>Port: 8000/TCP HTTP<br/>Image: odh-nemo-guardrails-rhel9<br/>UID: 1001 (non-root)<br/>Offline mode enforced"]

        subgraph Endpoints["API Endpoints (No App-Level Auth)"]
            ChatAPI["POST /v1/chat/completions<br/>(Bearer forwarded to LLM)"]
            ChecksAPI["POST /v1/checks<br/>(local evaluation)"]
            HealthAPI["GET /v1/health<br/>GET /healthz"]
        end

        subgraph HeaderFwd["Header Forwarding (Security Boundary)"]
            FwdRule["X-Authorization → Authorization<br/>Inbound Authorization NEVER forwarded"]
        end

        Server --- Endpoints
        Server --- HeaderFwd
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLMProvider["OpenAI-compatible LLM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        HFClassifier["Remote HF Classifier<br/>Configurable port HTTPS<br/>TLS (mTLS supported)<br/>Configurable auth"]
        OTel["OpenTelemetry Collector<br/>Configurable port<br/>gRPC/HTTP<br/>(optional)"]
    end

    %% Flows
    Client -->|"HTTP/8000<br/>Platform-managed TLS<br/>Bearer Token (optional)"| Ingress
    Ingress -->|"HTTP/8000<br/>Platform-managed"| Server
    Server -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (X-Auth → Auth)"| LLMProvider
    Server -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| AzureOAI
    Server -->|"HTTPS<br/>TLS (configurable mTLS)"| HFClassifier
    Server -.->|"gRPC/HTTP<br/>Configurable"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#e6d5f7,stroke:#7b5ea7,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Ingress platform
    class Server,ChatAPI,ChecksAPI,HealthAPI,FwdRule application
    class LLMProvider,AzureOAI,HFClassifier,OTel externalservice
