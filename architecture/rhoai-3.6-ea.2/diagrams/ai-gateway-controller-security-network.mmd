graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client"]
    end

    subgraph Ingress["INGRESS (Gateway-scoped)"]
        Gateway["Gateway<br/>(maas-default-gateway)<br/>Namespace: openshift-ingress<br/>443/TCP"]
        ExtProc["Praxis-ExtProc Pod<br/>SA: praxis-extproc<br/>Reads routing-overlay ConfigMap<br/>Verifies JCS SHA-256 digest"]
    end

    subgraph ControlPlane["CONTROL PLANE (opendatahub namespace)"]
        Controller["ai-gateway-controller<br/>SA: ai-gateway-controller<br/>runAsNonRoot, readOnlyRootFilesystem<br/>drop ALL caps, seccomp RuntimeDefault<br/>500m/256Mi limits"]
        HealthProbe[":8081/healthz, /readyz<br/>HTTP, unauthenticated"]
        Metrics[":8080/metrics<br/>HTTP, unauthenticated"]
    end

    subgraph K8sPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLMProvider["External LLM Provider<br/>(e.g., api.openai.com)<br/>443/TCP HTTPS<br/>API key auth"]
    end

    subgraph PeerControllers["PEER CONTROLLERS"]
        MaasCtrl["maas-controller<br/>annotation handshake"]
        AGOperator["ai-gateway-operator<br/>deployment lifecycle"]
    end

    %% Data plane flows
    Client -->|"HTTPS/443<br/>TLS"| Gateway
    Gateway -->|"ExtProc filter<br/>gRPC, mTLS"| ExtProc
    ExtProc -->|"HTTPS/443<br/>TLS SIMPLE (Istio DestinationRule)<br/>Bearer API key"| LLMProvider

    %% Control plane flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    K8sAPI -->|"Watch events"| Controller

    %% ConfigMap distribution
    Controller -.->|"SSA apply<br/>routing-overlay ConfigMap"| K8sAPI
    K8sAPI -.->|"Projected volume<br/>content-addressed envelope"| ExtProc

    %% Peer coordination
    MaasCtrl -->|"Annotation handshake<br/>on MaasTenantConfig"| K8sAPI
    AGOperator -->|"Deploys controller<br/>injects RELATED_IMAGE env"| Controller

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef peer fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef probe fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Client external
    class Gateway,ExtProc ingress
    class Controller controlplane
    class HealthProbe,Metrics probe
    class K8sAPI k8s
    class LLMProvider externalservice
    class MaasCtrl,AGOperator peer
