graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["maas-controller<br/>(controller namespace)"]
        SA_API["maas-api<br/>(opendatahub)"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB_Controller["maas-controller-rolebinding<br/>(cluster-scoped)"]
        CRB_API["maas-api<br/>(cluster-scoped)"]
        CRB_API_Supp["maas-api-supplemental<br/>(cluster-scoped)"]
    end

    subgraph ControllerRole["ClusterRole: maas-controller-role"]
        direction TB
        CR_MaasCRDs["maas.opendatahub.io<br/>aitenants, configs, externalmodels,<br/>maasauthpolicies, maasmodelrefs,<br/>maassubscriptions, maastenantconfigs,<br/>tenants<br/><b>Full CRUD</b>"]
        CR_GatewayAPI["gateway.networking.k8s.io<br/>gateways, httproutes<br/><b>create, delete, get, list,<br/>patch, update, watch</b>"]
        CR_Kuadrant["kuadrant.io<br/>authpolicies,<br/>tokenratelimitpolicies<br/><b>create, get</b>"]
        CR_Core["core (&quot;&quot;)<br/>configmaps, services<br/><b>create, delete, get,<br/>list, patch, update, watch</b>"]
        CR_CoreRO["core (&quot;&quot;)<br/>endpoints, pods, secrets<br/><b>get, list, watch</b>"]
        CR_NS["core (&quot;&quot;)<br/>namespaces<br/><b>create, get, list,<br/>patch, watch</b>"]
        CR_SA["core (&quot;&quot;)<br/>serviceaccounts<br/><b>create, delete, get</b>"]
        CR_Events["core (&quot;&quot;)<br/>events<br/><b>create, patch</b>"]
    end

    subgraph APIRole["ClusterRole: maas-api"]
        direction TB
        API_Secrets["core (&quot;&quot;)<br/>secrets (maas-db-config only)<br/><b>get</b>"]
        API_CoreRO["core (&quot;&quot;)<br/>namespaces, serviceaccounts,<br/>services<br/><b>get, list, watch</b>"]
        API_TokenReview["authentication.k8s.io<br/>tokenreviews<br/><b>create</b>"]
        API_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/><b>create</b>"]
        API_MaasCRDs["maas.opendatahub.io<br/>maasauthpolicies, maasmodelrefs,<br/>maassubscriptions<br/><b>get, list, watch</b>"]
        API_Gateway["gateway.networking.k8s.io<br/>gateways<br/><b>get</b>"]
        API_OCP["config.openshift.io<br/>apiservers<br/><b>get, list, watch</b>"]
    end

    subgraph APISuppRole["ClusterRole: maas-api-supplemental"]
        direction TB
        Supp_Secrets["core (&quot;&quot;)<br/>secrets (maas-db-config only)<br/><b>get</b>"]
        Supp_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/><b>create</b>"]
        Supp_MaasCRDs["maas.opendatahub.io<br/>maasmodelrefs, maassubscriptions<br/><b>get, list, watch</b>"]
        Supp_Gateway["gateway.networking.k8s.io<br/>gateways<br/><b>get</b>"]
    end

    %% Bindings
    SA_Controller -->|"bound via"| CRB_Controller
    SA_API -->|"bound via"| CRB_API
    SA_API -->|"bound via"| CRB_API_Supp

    CRB_Controller -->|"grants"| CR_MaasCRDs
    CRB_Controller -->|"grants"| CR_GatewayAPI
    CRB_Controller -->|"grants"| CR_Kuadrant
    CRB_Controller -->|"grants"| CR_Core
    CRB_Controller -->|"grants"| CR_CoreRO
    CRB_Controller -->|"grants"| CR_NS
    CRB_Controller -->|"grants"| CR_SA
    CRB_Controller -->|"grants"| CR_Events

    CRB_API -->|"grants"| API_Secrets
    CRB_API -->|"grants"| API_CoreRO
    CRB_API -->|"grants"| API_TokenReview
    CRB_API -->|"grants"| API_SAR
    CRB_API -->|"grants"| API_MaasCRDs
    CRB_API -->|"grants"| API_Gateway
    CRB_API -->|"grants"| API_OCP

    CRB_API_Supp -->|"grants"| Supp_Secrets
    CRB_API_Supp -->|"grants"| Supp_SAR
    CRB_API_Supp -->|"grants"| Supp_MaasCRDs
    CRB_API_Supp -->|"grants"| Supp_Gateway

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff

    style CRB_Controller fill:#e8e8e8,stroke:#333
    style CRB_API fill:#e8e8e8,stroke:#333
    style CRB_API_Supp fill:#e8e8e8,stroke:#333

    style CR_MaasCRDs fill:#f5a623,stroke:#333
    style CR_GatewayAPI fill:#f5a623,stroke:#333
    style CR_Kuadrant fill:#f5a623,stroke:#333
    style CR_Core fill:#f5a623,stroke:#333
    style CR_CoreRO fill:#f5a623,stroke:#333
    style CR_NS fill:#f5a623,stroke:#333
    style CR_SA fill:#f5a623,stroke:#333
    style CR_Events fill:#f5a623,stroke:#333

    style API_Secrets fill:#7ed321,stroke:#333
    style API_CoreRO fill:#7ed321,stroke:#333
    style API_TokenReview fill:#7ed321,stroke:#333
    style API_SAR fill:#7ed321,stroke:#333
    style API_MaasCRDs fill:#7ed321,stroke:#333
    style API_Gateway fill:#7ed321,stroke:#333
    style API_OCP fill:#7ed321,stroke:#333

    style Supp_Secrets fill:#d5e8d4,stroke:#333
    style Supp_SAR fill:#d5e8d4,stroke:#333
    style Supp_MaasCRDs fill:#d5e8d4,stroke:#333
    style Supp_Gateway fill:#d5e8d4,stroke:#333
