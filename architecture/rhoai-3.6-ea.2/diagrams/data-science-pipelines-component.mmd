graph TB
    subgraph External["External Clients"]
        SDK["Python SDK Client"]
        WebUser["Web Browser User"]
    end

    subgraph DSP["Data Science Pipelines"]
        subgraph APILayer["API Layer"]
            APIServer["API Server<br/>8888/TCP HTTP<br/>8887/TCP gRPC<br/>8443/TCP Webhooks"]
        end

        subgraph V2Engine["V2 Engine (Sidecar/Init Containers)"]
            Driver["Driver<br/>Resolves inputs,<br/>computes pod specs"]
            Launcher["Launcher v2<br/>Artifact I/O,<br/>executor invocation"]
        end

        subgraph Controllers["Controllers"]
            PersistenceAgent["Persistence Agent<br/>Workflow state sync"]
            ScheduledWorkflow["Scheduled Workflow<br/>Controller<br/>9090/TCP metrics"]
            Viewer["Viewer Controller<br/>TensorBoard deployments"]
        end

        subgraph CacheSubsystem["Cache Subsystem"]
            CacheServer["Cache Server<br/>443/TCP Webhook<br/>Mutating Admission"]
            CacheDeployer["Cache Deployer<br/>Bootstrap Job"]
        end

        subgraph MetadataSubsystem["Metadata Services"]
            MetadataGRPC["ML Metadata gRPC<br/>8080/TCP"]
            MetadataEnvoy["Metadata Envoy Proxy<br/>9090/TCP"]
            MetadataWriter["Metadata Writer<br/>Python"]
        end

        subgraph Frontend["Frontend"]
            UI["ML Pipeline UI<br/>React 19<br/>80/TCP → 3000"]
            VizServer["Visualization Server<br/>8888/TCP Python"]
        end
    end

    subgraph CRDs["Custom Resources"]
        PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
        PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]
        ScheduledWorkflowCR["ScheduledWorkflow CR<br/>kubeflow.org"]
        WorkflowCR["Workflow CR<br/>argoproj.io"]
    end

    subgraph ExternalDeps["External Dependencies"]
        MySQL["MySQL 8.4<br/>3306/TCP"]
        S3["S3-Compatible Storage"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        Argo["Argo Workflows v3.7.14"]
    end

    %% Client flows
    SDK -->|"REST/gRPC<br/>Bearer Token"| APIServer
    WebUser -->|HTTP| UI
    UI -->|"REST API"| APIServer

    %% API Server connections
    APIServer -->|"MySQL protocol"| MySQL
    APIServer -->|"HTTP/HTTPS"| S3
    APIServer -->|"HTTPS"| K8sAPI
    APIServer -->|"validates/mutates"| PipelineVersionCR

    %% V2 Engine
    Driver -->|"HTTPS"| K8sAPI
    Launcher -->|"HTTP/HTTPS"| S3
    Launcher -->|"gRPC"| MetadataGRPC

    %% Controllers
    PersistenceAgent -->|"watches"| WorkflowCR
    PersistenceAgent -->|"reports status"| APIServer
    ScheduledWorkflow -->|"manages"| ScheduledWorkflowCR
    ScheduledWorkflow -->|"creates"| WorkflowCR
    Viewer -->|"manages"| K8sAPI

    %% Cache
    CacheDeployer -->|"creates TLS secrets"| CacheServer
    CacheServer -->|"MySQL protocol"| MySQL

    %% Metadata
    MetadataWriter -->|"watches"| WorkflowCR
    MetadataWriter -->|"writes"| MetadataGRPC
    MetadataEnvoy -->|"proxies"| MetadataGRPC
    MetadataGRPC -->|"MySQL protocol"| MySQL

    %% Argo
    Argo -->|"creates pods with"| Driver
    Argo -->|"creates pods with"| Launcher

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Driver fill:#5ba5e6,stroke:#333,color:#fff
    style Launcher fill:#5ba5e6,stroke:#333,color:#fff
    style PersistenceAgent fill:#6bb5a0,stroke:#333,color:#fff
    style ScheduledWorkflow fill:#6bb5a0,stroke:#333,color:#fff
    style Viewer fill:#6bb5a0,stroke:#333,color:#fff
    style CacheServer fill:#e8a838,stroke:#333,color:#fff
    style CacheDeployer fill:#e8a838,stroke:#333,color:#fff
    style MetadataGRPC fill:#9b59b6,stroke:#333,color:#fff
    style MetadataEnvoy fill:#9b59b6,stroke:#333,color:#fff
    style MetadataWriter fill:#9b59b6,stroke:#333,color:#fff
    style UI fill:#27ae60,stroke:#333,color:#fff
    style VizServer fill:#27ae60,stroke:#333,color:#fff
    style MySQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Argo fill:#e8e8e8,stroke:#333
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style ScheduledWorkflowCR fill:#f5a623,stroke:#333
    style WorkflowCR fill:#f5a623,stroke:#333
