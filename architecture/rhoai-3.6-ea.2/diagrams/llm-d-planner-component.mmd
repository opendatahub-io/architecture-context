graph TB
    subgraph "llm-d Planner Platform"
        subgraph "Backend Service (FastAPI :8000)"
            IntentExtraction["Intent Extraction<br/>Engine"]
            Specification["Specification<br/>Generator"]
            Recommendation["Recommendation<br/>Engine"]
            Configuration["Configuration<br/>Generator"]
            ClusterMgr["Cluster Manager<br/>(kubectl + Python SDK)"]
            QualitySync["Quality Data<br/>Sync"]
            DB["SQLite Database<br/>(planner.db)"]

            IntentExtraction --> Specification
            Specification --> Recommendation
            Recommendation --> Configuration
            Configuration --> ClusterMgr
            Recommendation --> DB
            QualitySync --> DB
        end

        subgraph "UI Service (Streamlit :8501)"
            ChatUI["Conversational<br/>Chat Interface"]
            RecommendationView["Recommendation<br/>Views (4 ranked)"]
            SpecEditor["Specification<br/>Editor"]
            DeployPreview["Deployment YAML<br/>Preview"]
            MonitorDash["Monitoring<br/>Dashboard"]
        end

        subgraph "Ollama Sidecar (:11434)"
            Granite["Granite 3.3 2B<br/>LLM Model"]
        end
    end

    User["User / Data Scientist"] -->|"HTTPS/443<br/>(edge TLS)"| ChatUI
    ChatUI -->|"HTTP/8000"| IntentExtraction
    ChatUI -->|"HTTP/8000"| Specification
    ChatUI -->|"HTTP/8000"| Recommendation
    ChatUI -->|"HTTP/8000"| Configuration
    IntentExtraction -->|"HTTP/11434"| Granite

    ClusterMgr -->|"HTTPS/6443<br/>SA token"| K8sAPI["Kubernetes API"]
    ClusterMgr -->|"kubectl apply"| KServe["KServe<br/>InferenceService"]
    Recommendation -->|"HTTPS/443"| HFHub["HuggingFace Hub"]
    QualitySync -->|"HTTPS/443"| Arena["Arena API<br/>(lmarena.ai)"]
    QualitySync -->|"HTTPS/443"| AA["Artificial Analysis<br/>API"]
    IntentExtraction -.->|"HTTPS/443<br/>(optional)"| OpenAI["OpenAI API"]
    IntentExtraction -.->|"HTTPS/443<br/>(optional)"| VertexAI["Vertex AI"]
    Recommendation -.->|"HTTPS/8443<br/>(optional)"| ModelCatalog["RHOAI Model<br/>Catalog"]

