graph TB
    subgraph PlatformLayer["OGX Platform Layer"]
        direction TB
        ODHPlatform["ODH/RHOAI Platform Operator"]
        OGXModuleCtrl["OGX Module Controller<br/>(ogx-module)"]
        ODHPlatform -->|"creates OGX CR"| OGXModuleCtrl
        OGXModuleCtrl -->|"deploys via<br/>odh-platform-utilities"| OperatorDeploy["Root Operator<br/>Deployment + CRDs + RBAC"]
    end

    subgraph RootOperator["OGX Root Operator"]
        direction TB
        OGXServerCtrl["OGXServer Controller<br/>(OGXServerReconciler)"]
        Webhook["OGXServer Validating Webhook<br/>9443/TCP HTTPS"]
        ConfigGen["ConfigGen<br/>(kustomize config)"]
        KustomizeRenderer["Kustomize Renderer<br/>(in-process)"]
        DistRegistry["distributions.json<br/>(embedded registry)"]
        TLSWatcher["SecurityProfileWatcher<br/>(TLS auto-reload)"]

        OGXServerCtrl -->|"validates"| Webhook
        OGXServerCtrl -->|"renders manifests"| KustomizeRenderer
        OGXServerCtrl -->|"resolves images"| DistRegistry
        TLSWatcher -->|"triggers restart<br/>on profile change"| OGXServerCtrl
    end

    User["User / Admin"] -->|"kubectl create"| OGXServerCR["OGXServer CR<br/>(ogx.io/v1beta1)"]
    OGXServerCR -->|"watched by"| OGXServerCtrl
    LegacyCR["LlamaStackDistribution CR<br/>(legacy, llamastack.io/v1alpha1)"] -.->|"adoption via<br/>annotation migration"| OGXServerCtrl

    OGXCR["OGX CR<br/>(components.platform.opendatahub.io/v1alpha1)"] -->|"watched by"| OGXModuleCtrl

    subgraph ManagedResources["Managed Resources (per OGXServer)"]
        Deployment["Deployment"]
        Service["Service"]
        PVC["PersistentVolumeClaim"]
        NetPol["NetworkPolicy"]
        PDB["PodDisruptionBudget"]
        HPA["HorizontalPodAutoscaler"]
        Ingress["Ingress<br/>(legacy mode)"]
        ServiceMonitor["ServiceMonitor"]
        PrometheusRule["PrometheusRule"]
    end

    OGXServerCtrl -->|"SSA apply<br/>(field owner: ogx-operator)"| ManagedResources

    OGXServerCtrl -->|"status poll<br/>8321/TCP HTTP"| OGXPod["OGX Server Pod"]
    OGXServerCtrl -->|"HTTPS 6443"| K8sAPI["Kubernetes API"]

    Praxis["Praxis<br/>(MaaS Gateway)"] -->|"8321/TCP HTTP<br/>(NetworkPolicy restricted)"| OGXPod

    OGXServerCtrl -->|"OCI label inspect<br/>443/TCP HTTPS"| Registry["Container Registry"]

    style PlatformLayer fill:#e8e8ff,stroke:#666,stroke-width:2px
    style RootOperator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ManagedResources fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style OGXServerCtrl fill:#4a90e2,color:#fff
    style OGXModuleCtrl fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style OGXServerCR fill:#f5a623
    style OGXCR fill:#f5a623
    style LegacyCR fill:#f5a623,stroke-dasharray:5 5
    style OGXPod fill:#7ed321
    style Praxis fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style Registry fill:#e8e8e8
