graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph ProxyLayer["PROXY LAYER (Gateway)"]
        Envoy["Envoy Proxy<br/>443/TCP → 8000/TCP<br/>TLS 1.2+<br/>Bearer Token passthrough"]
    end

    subgraph ServiceLayer["SERVICE LAYER (Cluster Internal)"]
        direction TB

        subgraph NS_IPP["Namespace: ${NAMESPACE}"]
            IPP["Inference Payload Processor<br/>SA: payload-processor<br/>Image: ghcr.io/llm-d/payload-processor"]
            ExtProc["ExternalProcessor<br/>9004/TCP gRPC<br/>Optional TLS"]
            HealthPort["Health<br/>9005/TCP gRPC<br/>Plaintext"]
            MetricsPort["Metrics<br/>9090/TCP HTTP<br/>Optional authn/authz"]
        end
    end

    subgraph Backend["BACKEND (Model Serving)"]
        ModelServer["Model Server<br/>(InferencePool)<br/>8000/TCP HTTP<br/>No TLS / No Auth"]
        EPP["llm-d Router (EPP)<br/>Pod selection<br/>within pool"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>Configurable encryption"]
        Prometheus["Prometheus<br/>HTTP scrape"]
    end

    %% External → Proxy
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Envoy

    %% Proxy → IPP (ext-proc)
    Envoy -->|"gRPC/9004<br/>Optional TLS<br/>No app-level auth"| ExtProc

    %% IPP → Proxy (response)
    ExtProc -->|"gRPC stream<br/>HeaderMutation<br/>routing headers"| Envoy

    %% Proxy → Backend
    Envoy -->|"HTTP/8000<br/>No TLS<br/>No auth"| ModelServer

    %% EPP relationship
    EPP -.->|"selects pods"| ModelServer

    %% IPP → Cluster Services
    IPP -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% IPP → Observability
    IPP -->|"gRPC/4317<br/>Configurable"| OTLP
    Prometheus -->|"HTTP/9090<br/>Optional auth"| MetricsPort

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy proxy
    class IPP,ExtProc,HealthPort,MetricsPort service
    class ModelServer,EPP backend
    class K8sAPI cluster
    class OTLP,Prometheus observability
