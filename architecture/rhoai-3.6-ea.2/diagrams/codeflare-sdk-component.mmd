graph TB
    subgraph SDK["CodeFlare SDK (Python Library)"]
        direction TB

        subgraph Facade["Entrypoint Layer"]
            CF["Codeflare<br/>Single entrypoint facade"]
            SDKConfig["SDKConfig<br/>Wraps kube-authkit AuthConfig"]
        end

        subgraph Handlers["Handler Layer"]
            ClusterHandler["ClusterHandler<br/>cf.clusters accessor"]
            JobHandler["JobHandler<br/>cf.jobs accessor"]
        end

        subgraph Core["Core Layer"]
            Cluster["Cluster<br/>RayCluster lifecycle"]
            RayJob["RayJob<br/>RayJob lifecycle"]
            ClusterConfig["ClusterConfiguration<br/>Shared dataclass"]
        end

        subgraph Utils["Utilities"]
            GenCert["generate_cert<br/>RSA-3072, SHA-256<br/>mTLS certificates"]
            KueueUtils["kueue.py<br/>Queue resolution<br/>Priority validation"]
            Auth["auth.py<br/>ContextVar client isolation"]
            BuildCluster["build_ray_cluster.py<br/>RayCluster manifest builder"]
        end

        subgraph Vendored["Vendored (import-guarded)"]
            KubeRayClient["python-client<br/>KubeRay Python client"]
        end
    end

    CF --> SDKConfig
    CF --> ClusterHandler
    CF --> JobHandler
    ClusterHandler --> Cluster
    JobHandler --> RayJob
    Cluster --> ClusterConfig
    RayJob --> ClusterConfig
    Cluster --> GenCert
    Cluster --> KueueUtils
    Cluster --> BuildCluster
    RayJob --> KubeRayClient
    CF --> Auth
    Auth -.->|ContextVar scoping| Cluster
    Auth -.->|ContextVar scoping| RayJob

    subgraph Platform["Platform Services"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        KubeRayOp["KubeRay Operator"]
        KueueOp["Kueue"]
        RayDash["Ray Dashboard<br/>8265/TCP"]
    end

    subgraph Discovery["Dashboard URL Discovery"]
        HTTPRoute["HTTPRoute<br/>Gateway API"]
        OSRoute["OpenShift Route<br/>Fallback"]
        GWConfig["GatewayConfig CR<br/>Final fallback"]
    end

    Auth -->|HTTPS/TLS| K8sAPI
    K8sAPI -->|CRD watch| KubeRayOp
    K8sAPI -->|CRD watch| KueueOp
    Cluster -->|mTLS| RayDash
    Cluster --> HTTPRoute
    Cluster --> OSRoute
    Cluster --> GWConfig

    style CF fill:#4a90e2,stroke:#333,color:#fff
    style ClusterHandler fill:#4a90e2,stroke:#333,color:#fff
    style JobHandler fill:#4a90e2,stroke:#333,color:#fff
    style Cluster fill:#5ba0d9,stroke:#333,color:#fff
    style RayJob fill:#5ba0d9,stroke:#333,color:#fff
    style GenCert fill:#e8744f,stroke:#333,color:#fff
    style Auth fill:#e8744f,stroke:#333,color:#fff
    style KubeRayClient fill:#9b59b6,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style KubeRayOp fill:#7ed321,stroke:#333,color:#fff
    style KueueOp fill:#7ed321,stroke:#333,color:#fff
    style RayDash fill:#7ed321,stroke:#333,color:#fff
    style HTTPRoute fill:#f5a623,stroke:#333,color:#fff
    style OSRoute fill:#f5a623,stroke:#333,color:#fff
    style GWConfig fill:#f5a623,stroke:#333,color:#fff
