graph TB
    subgraph "llm-d-pd-utils Toolkit"
        subgraph "Preflight Checks"
            Preflight["llm-d-preflight-checks.py<br/>Python HTTP Server"]
            HealthEP["/health endpoint<br/>8000/TCP"]
            InfoEP["/info endpoint<br/>8000/TCP"]
            ExitEP["/exit endpoint<br/>8000/TCP"]
            Preflight --> HealthEP
            Preflight --> InfoEP
            Preflight --> ExitEP
        end

        subgraph "Networking Tests Suite"
            RunTests["run-tests.py<br/>Test Orchestrator"]
            Discovery["run-tests-discovery.py<br/>GPU Topology Analysis"]
            Perftest["run-tests-perftest.py<br/>RDMA Bandwidth/Latency"]
            Iperf3["run-tests-iperf3.py<br/>TCP/UDP Throughput"]
            NCCL["run-tests-nccl-rccl.py<br/>Collective Comms"]
            Nixlbench["run-tests-nixlbench.py<br/>NIXL GPU Transfer"]
            RunTests --> Discovery
            RunTests --> Perftest
            RunTests --> Iperf3
            RunTests --> NCCL
            RunTests --> Nixlbench
        end

        subgraph "NIXL Benchmark"
            Benchmark["benchmark.py<br/>GPU VRAM Transfer"]
            BenchDeploy["benchmark_deployment.sh<br/>Orchestration"]
            BenchDeploy --> Benchmark
        end

        subgraph "Installers"
            NixlInstaller["install_nixl_nonroot.sh<br/>NIXL + UCX + gdrcopy"]
        end
    end

    %% External interactions
    Operator["Operator / SRE"] -->|"kubectl exec curl /exit"| ExitEP
    K8sProbe["K8s Health Probe"] -->|"GET /health"| HealthEP

    Preflight -->|"gates startup via &&"| vLLM["vLLM Model Server<br/>llm-d"]

    RunTests -->|"kubectl exec"| TargetPods["llm-d Target Pods"]
    RunTests -->|"pod discovery"| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]

    Benchmark -->|"ZMQ control plane<br/>5555/TCP"| PeerPod["Peer Benchmark Pod"]
    Benchmark -->|"GPU VRAM transfer<br/>UCX RDMA/TCP"| PeerPod

    Benchmark -->|"allocates tensors"| GPU["NVIDIA GPU<br/>A100 SXM4"]
    Discovery -->|"nvidia-smi"| GPU

    NixlInstaller -->|"downloads source"| GitHub["github.com<br/>NIXL/UCX/gdrcopy"]

