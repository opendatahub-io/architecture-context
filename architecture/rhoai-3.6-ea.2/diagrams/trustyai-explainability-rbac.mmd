graph TD
    subgraph "Service Account"
        SA["trustyai-serviceaccount"]
    end

    subgraph "ClusterRole Bindings"
        CRB["trustyai-clusterrolebinding<br/>(Cluster-scoped)"]
    end

    subgraph "ClusterRole Permissions"
        CR["trustyai-role<br/>(ClusterRole)"]
    end

    subgraph "API Resources"
        ConfigMaps["core (v1)<br/>ConfigMaps"]
    end

    subgraph "Permitted Verbs"
        Verbs["create, delete, get,<br/>list, patch, update, watch"]
    end

    subgraph "Auth Endpoints"
        MetricsEndpoint["/q/metrics<br/>Auth: Bearer SA Token<br/>via ServiceMonitor"]
        AllOtherEndpoints["All other endpoints<br/>Auth: None<br/>Relies on network isolation"]
    end

    subgraph "TLS Configuration"
        TLSCert["/etc/tls/internal/tls.crt<br/>/etc/tls/internal/tls.key<br/>HTTPS on port 4443<br/>Provisioned by operator"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"permits"| Verbs
    Verbs -->|"on"| ConfigMaps

    SA -->|"token used by"| MetricsEndpoint

    style SA fill:#4a90e2,color:#fff
    style CRB fill:#e8e8e8
    style CR fill:#f5a623
    style ConfigMaps fill:#7ed321
    style Verbs fill:#fef3c7,stroke:#d97706
    style MetricsEndpoint fill:#d5e8d4,stroke:#82b366
    style AllOtherEndpoints fill:#f8cecc,stroke:#b85450
    style TLSCert fill:#dbeafe,stroke:#3b82f6
