graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Browser / API Client"]
    end

    subgraph CloudRun["INGRESS (Cloud Run Managed TLS)"]
        Service["Cloud Run Service: prism<br/>prism.llm-d.ai<br/>443/TCP → 8080/TCP<br/>TLS managed by Cloud Run"]
    end

    subgraph Application["APPLICATION (Express BFF)"]
        direction TB

        RateLimit["Rate Limiter<br/>50,000 req/min"]
        OAuth["OAuth/IAM Module<br/>GitHub OAuth + GCS allowlists<br/>Permission: none < user < admin"]
        GCSProxy["GCS Proxy<br/>/api/gcs/*<br/>Read: filtered by ownership<br/>Write: admin-only"]
        ResultsStore["Results Store<br/>/api/results<br/>Zod validation<br/>Server-generated UUIDs"]
        GIQProxy["GIQ Proxy<br/>/api/giq/*"]
        PublicAPIs["Public APIs<br/>/api/regressions<br/>/api/prefix-cache/data<br/>/api/pd-disaggregation/data<br/>/api/config"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        GCS["Google Cloud Storage<br/>storage.googleapis.com<br/>443/TCP, TLS 1.2+<br/>Auth: Bearer ADC"]
        GIQ["GKE Recommender API<br/>gkerecommender.googleapis.com<br/>443/TCP, TLS 1.2+<br/>Auth: Bearer ADC/user"]
        GitHubAPI["GitHub API<br/>api.github.com<br/>443/TCP, TLS 1.2+<br/>Auth: Bearer OAuth"]
        GitHubOAuth["GitHub OAuth<br/>github.com<br/>443/TCP, TLS 1.2+<br/>Auth: Client credentials"]
        S3["AWS S3 (public)<br/>443/TCP, TLS 1.2+<br/>Auth: None"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (Cloud Run)<br/>X-Prism-Github-Token"| Service
    Service -->|"HTTP/8080<br/>(post-TLS termination)"| RateLimit
    RateLimit --> OAuth
    OAuth --> GCSProxy
    OAuth --> ResultsStore
    OAuth --> GIQProxy
    OAuth --> PublicAPIs

    GCSProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer ADC"| GCS
    ResultsStore -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer ADC"| GCS
    GIQProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer ADC/user"| GIQ
    OAuth -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer OAuth"| GitHubAPI
    OAuth -->|"HTTPS/443<br/>TLS 1.2+<br/>Client creds"| GitHubOAuth
    PublicAPIs -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer ADC"| GCS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Service ingress
    class RateLimit,OAuth,GCSProxy,ResultsStore,GIQProxy,PublicAPIs application
    class GCS,GIQ,GitHubAPI,GitHubOAuth,S3 externalservice
