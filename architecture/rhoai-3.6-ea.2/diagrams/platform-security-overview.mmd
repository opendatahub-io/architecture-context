graph TD
    subgraph AuthMechanisms["Authentication Mechanisms"]
        AuthExtAuthz["Gateway ext_authz<br/>kube-auth-proxy<br/>OIDC/OAuth"]
        AuthKuadrant["Kuadrant AuthPolicy<br/>Authorino<br/>API key + OAuth"]
        AuthKubeRBAC["kube-rbac-proxy sidecar<br/>TokenReview + SAR<br/>Metrics endpoints"]
        AuthSATokens["ServiceAccount Tokens<br/>In-cluster config<br/>All operators"]
        AuthCtrlRuntime["controller-runtime<br/>WithAuthenticationAndAuthorization<br/>Built-in metrics filter"]
        AuthOCPOAuth["OpenShift OAuth<br/>Direct integration<br/>Legacy callback routes"]
        AuthTokenReview["Kubernetes TokenReview<br/>Application-level<br/>Bearer token validation"]
    end

    subgraph GatewayAuthChains["Gateway Authentication Chains"]
        DSGWChain["data-science-gateway<br/>ext_authz → kube-auth-proxy<br/>→ Lua token forwarding<br/>→ cookie stripping"]
        MaaSGWChain["maas-default-gateway<br/>praxis-extproc BBR (fail-open)<br/>→ Authorino (API key/OAuth)<br/>→ praxis-extproc IPP (fail-closed)<br/>→ credential stripping"]
        LLMGWChain["LLM serving Gateway<br/>Kuadrant AuthPolicy<br/>per LLMInferenceService<br/>EnvoyFilter TLS bootstrap"]
    end

    subgraph KeyServiceAccounts["Key ServiceAccounts"]
        SA1["rhods-operator<br/>NS: redhat-ods-operator<br/>Cluster-scoped CRD lifecycle"]
        SA2["kserve-controller-manager<br/>NS: redhat-ods-applications<br/>Model serving lifecycle"]
        SA3["odh-model-controller<br/>NS: redhat-ods-applications<br/>Serving + gateway lifecycle"]
        SA4["odh-dashboard<br/>NS: redhat-ods-applications<br/>Platform UI + BFF"]
        SA5["maas-controller<br/>NS: redhat-ods-applications<br/>Tenant + API key mgmt"]
        SA6["model-registry<br/>NS: redhat-ods-applications<br/>Model metadata"]
    end

    subgraph WebhookSecurity["Webhook Attack Surface"]
        WH1["kueue-operator<br/>34 mutating + 36 validating<br/>Failure: Fail"]
        WH2["kserve<br/>8M + 21V + 1 conversion<br/>Failure: Fail"]
        WH3["odh-model-controller<br/>10M + 6V<br/>Cross-component pod mutation<br/>Failure: Fail"]
        WH4["spark-operator<br/>8M + 6V + 1C<br/>Failure: Fail"]
        WH5["Total: 213 webhooks<br/>83 mutating, 121 validating<br/>9 conversion"]
    end

    subgraph CrossCompWebhooks["Cross-Component Webhook Targets"]
        XWH1["odh-model-controller<br/>→ mutates KServe Pods<br/>predictor pod injection"]
        XWH2["odh-model-controller<br/>→ mutates InferenceService<br/>platform labels + RBAC"]
        XWH3["odh-model-controller<br/>→ mutates LLMInferenceService<br/>auth policies"]
        XWH4["odh-observability<br/>→ mutates PodMonitor/ServiceMonitor<br/>platform monitoring labels"]
        XWH5["rhods-operator<br/>→ validates HardwareProfile<br/>Dashboard hardware config"]
    end

    subgraph TLSConfig["TLS Configuration"]
        TLS1["Webhook TLS<br/>:9443/TCP Server TLS<br/>cert-manager or service-CA"]
        TLS2["Metrics TLS<br/>:8443/TCP Server TLS<br/>kube-rbac-proxy sidecar"]
        TLS3["Gateway TLS<br/>:443/TCP Termination<br/>Envoy/OpenShift Router"]
        TLS4["Cluster TLS Profile<br/>Derived from APIServer<br/>Dynamic cipher suite config"]
        TLS5["Self-signed TLS<br/>kube-auth-proxy, praxis-extproc<br/>DestinationRule validation"]
    end

    subgraph ContainerSecurity["Container Security Patterns"]
        CS1["UBI 9 minimal-pqc base<br/>Post-quantum cryptography<br/>OpenSSL 3 FIPS provider<br/>All major components"]
        CS2["GOEXPERIMENT=strictfipsruntime<br/>FIPS-compliant Go binaries<br/>Dynamic OpenSSL linking<br/>rhods-op, kserve, omc, maas, mr"]
        CS3["Rust OpenSSL FIPS probe<br/>OPENSSL_NO_VENDOR=1<br/>Runtime FIPS provider check<br/>praxis-extproc, guardrails"]
        CS4["Non-root execution<br/>Dropped capabilities<br/>kserve pods, vllm-cpu, llm-d,<br/>kube-auth-proxy, praxis-extproc"]
        CS5["Digest-pinned images<br/>RELATED_IMAGE_* env vars<br/>OLM relatedImages in CSV<br/>rhods-operator, kserve CSR"]
        CS6["RPM lockfiles<br/>rpms.lock.yaml<br/>OS-level dependency pinning<br/>rhods-operator"]
    end

    subgraph ServiceMeshSecurity["Service Mesh Security"]
        SMS1["Istio revision labeling<br/>openshift-gateway on OCP<br/>default on XKS"]
        SMS2["DestinationRule TLS<br/>Self-signed cert validation<br/>kube-auth-proxy, praxis-extproc"]
        SMS3["EnvoyFilter ext_authz<br/>HTTP auth filter<br/>data-science-gateway"]
        SMS4["EnvoyFilter ExtProc<br/>Pre-auth + post-auth<br/>maas-default-gateway"]
        SMS5["VirtualService (legacy)<br/>data-science-pipelines<br/>model-registry, trustyai"]
    end

