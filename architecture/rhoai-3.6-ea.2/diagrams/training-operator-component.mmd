graph TB
    subgraph TrainingOperator["Training Operator"]
        direction TB
        Controller["Controller Manager<br/>controller-runtime"]
        CertManager["OPA Cert Controller<br/>Self-managed TLS rotation"]

        subgraph Reconcilers["Framework Reconcilers"]
            PyTorchReconciler["PyTorch Reconciler"]
            TFReconciler["TensorFlow Reconciler"]
            JAXReconciler["JAX Reconciler"]
            MPIReconciler["MPI Reconciler"]
            XGBoostReconciler["XGBoost Reconciler"]
            PaddleReconciler["PaddlePaddle Reconciler"]
        end

        subgraph Webhooks["Validating Webhooks (9443/TCP)"]
            PyTorchWH["PyTorchJob Webhook"]
            TFWH["TFJob Webhook"]
            JAXWH["JAXJob Webhook"]
            MPIWH["MPIJob Webhook"]
            XGBoostWH["XGBoostJob Webhook"]
            PaddleWH["PaddleJob Webhook"]
        end

        Controller --> Reconcilers
        CertManager -->|"rotates TLS certs"| Webhooks
    end

    subgraph CRDs["Custom Resource Definitions (kubeflow.org/v1)"]
        PyTorchJob["PyTorchJob"]
        TFJob["TFJob"]
        JAXJob["JAXJob"]
        MPIJob["MPIJob"]
        XGBoostJob["XGBoostJob"]
        PaddleJob["PaddleJob"]
    end

    User["User / SDK"] -->|"kubectl apply"| CRDs
    CRDs -->|"watched by"| Reconcilers
    CRDs -->|"validated by"| Webhooks

    PyTorchReconciler -->|"creates"| WorkerPods["Worker / Master Pods"]
    PyTorchReconciler -->|"creates"| Services["Headless Services"]
    PyTorchReconciler -->|"manages"| HPA["HorizontalPodAutoscaler<br/>(elastic training)"]
    MPIReconciler -->|"creates"| MPIResources["ConfigMaps + RBAC<br/>(hostfile, kubectl-delivery)"]
    MPIReconciler -->|"uses"| KubectlDelivery["kubectl-delivery<br/>Init Container"]

    Controller -->|"REST/Watch"| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    Controller -->|"reads TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1"]
    Controller -->|"creates PodGroups"| GangScheduler["Volcano / Scheduler Plugins<br/>(optional gang scheduling)"]

    Prometheus["Prometheus"] -->|"scrapes 8080/TCP"| Controller

