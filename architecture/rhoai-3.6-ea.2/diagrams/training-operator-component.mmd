    style TFReconciler fill:#6baed6,stroke:#333
    style JAXReconciler fill:#6baed6,stroke:#333
    style MPIReconciler fill:#6baed6,stroke:#333
    style XGBoostReconciler fill:#6baed6,stroke:#333
    style PaddleReconciler fill:#6baed6,stroke:#333
    style PyTorchWH fill:#9ecae1,stroke:#333
    style TFWH fill:#9ecae1,stroke:#333
    style JAXWH fill:#9ecae1,stroke:#333
    style MPIWH fill:#9ecae1,stroke:#333
    style XGBoostWH fill:#9ecae1,stroke:#333
    style PaddleWH fill:#9ecae1,stroke:#333
