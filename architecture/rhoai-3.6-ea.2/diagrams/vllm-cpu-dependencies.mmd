graph LR
    vLLM["vLLM CPU<br/>Inference Engine"]

    %% Runtime Dependencies
    vLLM -->|"runtime"| Python["Python >=3.10,<3.15"]
    vLLM -->|"tensor computation"| PyTorch["PyTorch 2.11.0+cpu"]
    vLLM -->|"HTTP framework"| FastAPI["FastAPI >=0.133.0,<0.137.0"]
    vLLM -->|"ASGI framework"| Starlette["Starlette >=1.0.1<br/>(CVE-2026-48710 fix)"]
    vLLM -->|"ASGI server"| Uvicorn["Uvicorn"]
    vLLM -->|"model loading"| Transformers["transformers >=5.6.0"]
    vLLM -->|"fast tokenization"| Tokenizers["tokenizers >=0.21.1"]
    vLLM -->|"serialization"| Protobuf["protobuf >=5.29.6"]
    vLLM -->|"gRPC runtime"| gRPC["grpcio >=1.76.0"]
    vLLM -->|"API types"| OpenAI["openai >=2.0.0"]
    vLLM -->|"API types"| Anthropic["anthropic >=0.71.0"]
    vLLM -->|"content hashing"| Blake3["blake3"]

    %% Conditional Dependencies
    vLLM -.->|"x86_64 only"| IPEX["Intel Extension<br/>for PyTorch 2.7.0"]
    vLLM -.->|"conditional"| OTel["OpenTelemetry >=1.27.0<br/>(disabled on s390x)"]

    %% Internal Platform Dependencies
    vLLM -->|"SageMaker compat"| MHCS["model-hosting-<br/>container-standards"]

    %% Platform Integration
    KServe["KServe / ModelMesh"] -->|"deploys as container"| vLLM
    Prometheus["Prometheus"] -->|"scrapes metrics"| vLLM
    OTelCollector["OpenTelemetry<br/>Collector"] -.->|"receives traces"| vLLM

    %% External Services
    vLLM -->|"model download"| HFHub["HuggingFace Hub"]
    vLLM -.->|"model storage"| S3["S3 Storage"]
    vLLM -.->|"usage stats"| StatsVLLM["stats.vllm.ai"]

