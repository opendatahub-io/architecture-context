graph TD
    subgraph TrainingHub["Training Hub (Library)"]
        THub["Training Hub<br/>Python Package"]
        Note["Training Hub does NOT define<br/>any RBAC roles or bindings.<br/>It is a library, not an operator."]
    end

    subgraph Platform["Platform-Managed RBAC"]
        direction TB

        subgraph Kubeflow["Kubeflow / Trainer Operator"]
            KFRole["Platform-Defined Roles"]
            KFSA["Training Pod<br/>ServiceAccount"]
        end

        subgraph K8s["Kubernetes"]
            NS["Namespace Isolation"]
            RQ["ResourceQuota /<br/>LimitRange"]
            NP["NetworkPolicy"]
        end
    end

    subgraph Secrets["Secrets (Environment Variables in Pod Spec)"]
        OAIKEY["OPENAI_API_KEY<br/>(GEPA LLM calls)"]
        WANDBKEY["WANDB_API_KEY<br/>(Experiment tracking)"]
        AWSKEYS["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>(S3 checkpoint storage)"]
        HFTOKEN["HF_TOKEN<br/>(HuggingFace access)"]
    end

    %% Platform manages Training Hub's pod
    KFRole -->|"grants permissions to"| KFSA
    KFSA -->|"runs"| THub
    NS -->|"isolates"| THub
    RQ -->|"limits resources for"| THub
    NP -->|"controls egress for"| THub

    %% Secrets injected by platform
    Secrets -->|"injected via Pod spec<br/>by platform"| THub

    %% Styling
    style THub fill:#4a90e2,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style KFRole fill:#7ed321,color:#fff
    style KFSA fill:#7ed321,color:#fff
    style NS fill:#326ce5,color:#fff
    style RQ fill:#326ce5,color:#fff
    style NP fill:#326ce5,color:#fff
    style OAIKEY fill:#f8cecc,stroke:#b85450
    style WANDBKEY fill:#f8cecc,stroke:#b85450
    style AWSKEYS fill:#f8cecc,stroke:#b85450
    style HFTOKEN fill:#f8cecc,stroke:#b85450
