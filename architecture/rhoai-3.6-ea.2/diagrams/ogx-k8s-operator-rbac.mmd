graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Root["ogx-k8s-operator-controller-manager<br/>(root operator)"]
        SA_Module["operator<br/>(ogx-module)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["ogx-k8s-operator-manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-proxy-rolebinding"]
        CRB_Module["manager-cluster-rolebinding<br/>(ogx-module)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Leader["ogx-k8s-operator-leader-election-rolebinding<br/>NS: ogx-k8s-operator-system"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ogx-k8s-operator-manager-role"]
        CR_Proxy["ogx-k8s-operator-proxy-role"]
        CR_Metrics["ogx-k8s-operator-metrics-reader"]
        CR_Editor["ogx-k8s-operator-ogxserver-editor-role<br/>(aggregated to admin, edit)"]
        CR_Viewer["ogx-k8s-operator-ogxserver-viewer-role<br/>(aggregated to view)"]
        CR_Module["manager-cluster-role<br/>(ogx-module)"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_Leader["ogx-k8s-operator-leader-election-role"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        OGXServers["ogx.io<br/>ogxservers, finalizers, status"]
        Deployments["apps<br/>deployments"]
        CoreResources["core<br/>configmaps, pvcs, sas,<br/>services, secrets, events, pods"]
        NetworkResources["networking.k8s.io<br/>ingresses, networkpolicies"]
        Autoscaling["autoscaling<br/>horizontalpodautoscalers"]
        BatchResources["batch<br/>jobs, jobs/status"]
        MonitoringResources["monitoring.coreos.com<br/>prometheusrules, servicemonitors"]
        PolicyResources["policy<br/>poddisruptionbudgets"]
        SCCResources["security.openshift.io<br/>securitycontextconstraints<br/>(nonroot-v2, verb: use)"]
    end

    subgraph ProxyResources["Proxy Role Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph ModuleResources["Module Role Resources"]
        OGXs["components.platform.opendatahub.io<br/>ogxs, finalizers, status"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        VWCs["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
    end

    subgraph MetricsAccess["Metrics Access"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% Root operator bindings
    SA_Root -->|"bound via"| CRB_Manager
    SA_Root -->|"bound via"| CRB_Proxy
    SA_Root -->|"bound via"| RB_Leader

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Proxy -->|"grants"| CR_Proxy
    RB_Leader -->|"grants"| R_Leader

    %% Module bindings
    SA_Module -->|"bound via"| CRB_Module
    CRB_Module -->|"grants"| CR_Module

    %% Manager role permissions
    CR_Manager -->|"CRUD + watch"| OGXServers
    CR_Manager -->|"CRUD + watch"| Deployments
    CR_Manager -->|"varies"| CoreResources
    CR_Manager -->|"CRUD + watch"| NetworkResources
    CR_Manager -->|"CRUD + watch"| Autoscaling
    CR_Manager -->|"CRUD + watch"| BatchResources
    CR_Manager -->|"CRUD + watch"| MonitoringResources
    CR_Manager -->|"CRUD + watch"| PolicyResources
    CR_Manager -->|"use"| SCCResources

    %% Proxy role permissions
    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR

    %% Metrics reader
    CR_Metrics -->|"get"| MetricsURL

    %% Aggregated roles
    CR_Editor -->|"CRUD + watch"| OGXServers
    CR_Viewer -->|"get, list, watch"| OGXServers

    %% Module role permissions
    CR_Module -->|"CRUD + watch"| OGXs
    CR_Module -->|"CRUD + watch"| CRDs
    CR_Module -->|"CRUD + watch"| VWCs

    %% Styling
    style SA_Root fill:#4a90e2,color:#fff
    style SA_Module fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623
    style CR_Proxy fill:#f5a623
    style CR_Metrics fill:#f5a623
    style CR_Editor fill:#f5a623
    style CR_Viewer fill:#f5a623
    style CR_Module fill:#f5a623
    style R_Leader fill:#f5a623
    style OGXServers fill:#7ed321
    style Deployments fill:#7ed321
    style CoreResources fill:#7ed321
    style NetworkResources fill:#7ed321
    style Autoscaling fill:#7ed321
    style BatchResources fill:#7ed321
    style MonitoringResources fill:#7ed321
    style PolicyResources fill:#7ed321
    style SCCResources fill:#7ed321
    style TokenReviews fill:#7ed321
    style SAR fill:#7ed321
    style OGXs fill:#7ed321
    style CRDs fill:#7ed321
    style VWCs fill:#7ed321
    style MetricsURL fill:#7ed321
