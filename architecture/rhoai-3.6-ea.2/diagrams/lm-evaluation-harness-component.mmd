graph TB
    subgraph Operator["TrustyAI LMES Operator"]
        LMEvalJob["LMEvalJob CR"]
    end

    subgraph LMESJob["lm-evaluation-harness (lmes-job)"]
        direction TB
        Adapter["EvalHub Adapter<br/>(main.py)"]
        LMEval["lm_eval Library<br/>(60+ benchmarks)"]
        S3Down["S3 Downloader"]
        OCIPush["OCI Artifact Pusher<br/>(skopeo + olot)"]

        Adapter -->|"orchestrates"| LMEval
        Adapter -->|"downloads assets"| S3Down
        Adapter -->|"persists results"| OCIPush
    end

    subgraph Config["Job Configuration"]
        JobSpec["/meta/job.json<br/>(ConfigMap mount)"]
        TestData["/test_data<br/>(offline datasets)"]
    end

    LMEvalJob -->|"creates Job"| Adapter
    JobSpec -->|"read by"| Adapter
    TestData -.->|"optional<br/>air-gapped mode"| LMEval

    subgraph ExternalServices["External Services"]
        ModelEndpoint["Model Inference Endpoint<br/>(vLLM / OpenAI-compatible)"]
        EvalHub["EvalHub Callback Service"]
        HFHub["HuggingFace Hub"]
        S3["S3-Compatible Storage"]
        OCIReg["OCI Registry"]
        MLflow["MLflow Tracking Server"]
    end

    LMEval -->|"local-completions<br/>HTTP/HTTPS"| ModelEndpoint
    Adapter -->|"status + results<br/>HTTPS"| EvalHub
    LMEval -.->|"datasets<br/>HTTPS/443"| HFHub
    S3Down -->|"boto3<br/>HTTPS"| S3
    OCIPush -->|"skopeo push<br/>HTTPS/443"| OCIReg
    Adapter -.->|"metrics<br/>HTTP/HTTPS"| MLflow

    style Adapter fill:#4a90e2,color:#fff
    style LMEval fill:#4a90e2,color:#fff
    style S3Down fill:#4a90e2,color:#fff
    style OCIPush fill:#4a90e2,color:#fff
    style LMEvalJob fill:#f5a623,color:#fff
    style ModelEndpoint fill:#e8e8e8,stroke:#333
    style EvalHub fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OCIReg fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style JobSpec fill:#7ed321,color:#fff
    style TestData fill:#7ed321,color:#fff
