graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client (CLI/SDK/Agent)"]
    end

    subgraph Ingress["INGRESS (DMZ - Optional)"]
        GRPCRoute["GRPCRoute / OpenShift Route<br/>443/TCP HTTPS<br/>TLS 1.2+ terminate/passthrough"]
    end

    subgraph GatewayZone["CONTROL PLANE (TLS + Auth)"]
        Gateway["OpenShell Gateway<br/>8080/TCP gRPC+HTTP<br/>TLS 1.2+ (rustls/aws-lc-rs)<br/>OIDC Bearer + optional mTLS<br/>Post-Quantum: DEFAULT:PQ"]
        HealthPort["Health Endpoint<br/>8081/TCP HTTP<br/>No TLS, No Auth"]
        MetricsPort["Metrics Endpoint<br/>9090/TCP HTTP<br/>TLS 1.2+ (optional)"]
    end

    subgraph SupervisorZone["SUPERVISOR BOUNDARY (Policy Enforcement)"]
        direction TB
        Supervisor["OpenShell Supervisor<br/>5500/TCP gRPC TLS<br/>Post-Quantum: DEFAULT:PQ"]
        L7Proxy["L7 Proxy<br/>HTTP/CONNECT interception<br/>OPA policy evaluation (regorus)"]
        CredInjector["Credential Injector<br/>Runtime-only, never on filesystem<br/>AWS SigV4 signing"]
        Supervisor --> L7Proxy
        Supervisor --> CredInjector
    end

    subgraph SandboxZone["SANDBOX (Isolated Workload)"]
        SandboxBin["Sandbox Binary<br/>Static glibc<br/>seccomp + drop ALL caps<br/>runAsNonRoot UID 1000"]
        AgentProcess["Agent Process<br/>(Claude Code, Codex, etc.)"]
        SandboxBin -->|"isolation protocol"| AgentProcess
    end

    subgraph K8sServices["KUBERNETES SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS<br/>ServiceAccount Token"]
        SandboxCRD["agents.x-k8s.io Sandbox CRD<br/>443/TCP HTTPS TLS"]
        CertManager["cert-manager<br/>443/TCP HTTPS TLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelAPIs["Model Provider APIs<br/>(Anthropic, GCP, NVIDIA)<br/>443/TCP HTTPS TLS 1.2+<br/>Provider Credentials"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (optional)"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>TLS (optional)"]
    end

    %% External → Ingress → Gateway
    Client -->|"HTTPS/443<br/>TLS 1.2+"| GRPCRoute
    GRPCRoute -->|"gRPC/8080<br/>TLS"| Gateway
    Client -->|"gRPC/8080<br/>TLS 1.2+<br/>OIDC Bearer"| Gateway

    %% Gateway → Sandbox
    Gateway -->|"SSH/2222<br/>mTLS<br/>Client Certificate"| SandboxBin

    %% Supervisor ↔ Gateway
    Supervisor -->|"gRPC/8080<br/>TLS mTLS<br/>Projected SA Token"| Gateway

    %% Supervisor ↔ Sandbox
    Supervisor -->|"gRPC/5500<br/>TLS<br/>Isolation Protocol"| SandboxBin

    %% Agent Egress (policy-enforced)
    AgentProcess -->|"HTTP/CONNECT<br/>Loopback<br/>No Auth"| L7Proxy
    L7Proxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Injected Creds"| ModelAPIs

    %% Gateway → K8s
    Gateway -->|"HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI
    Gateway -->|"HTTPS/443<br/>TLS"| SandboxCRD
    Gateway -->|"HTTPS/443<br/>TLS"| CertManager

    %% Gateway → External
    Gateway -->|"TCP/5432<br/>TLS"| PostgreSQL
    Gateway -->|"gRPC/4317<br/>TLS"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef supervisor fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef sandbox fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef k8sservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class GRPCRoute ingress
    class Gateway,HealthPort,MetricsPort controlplane
    class Supervisor,L7Proxy,CredInjector supervisor
    class SandboxBin,AgentProcess sandbox
    class K8sAPI,SandboxCRD,CertManager k8sservice
    class ModelAPIs,PostgreSQL,OTLP externalservice
