graph TB
    subgraph BatchGateway["llm-d-batch-gateway"]
        subgraph APIServer["batch-gateway-apiserver<br/>(Deployment)"]
            APIMux["API Mux<br/>:8000/TCP"]
            ObsMux["Observability Mux<br/>:8081/TCP"]
            Middleware["Middleware Chain<br/>Recovery · RequestID<br/>OTel Tracing · Security Headers"]
            BatchHandler["Batch Handler<br/>/v1/batches"]
            FileHandler["File Handler<br/>/v1/files"]
            APIMux --> Middleware
            Middleware --> BatchHandler
            Middleware --> FileHandler
        end

        subgraph Processor["batch-gateway-processor<br/>(StatefulSet)"]
            QueuePoller["Queue Poller<br/>pollInterval: 5s"]
            ExecutionPlanner["Execution Planner<br/>per-model plans<br/>prefix-cache ordering"]
            Dispatcher["Dispatcher<br/>sync-global · sync-per-model · async"]
            AIMDControl["AIMD Concurrency Control<br/>backoff: 0.5x on 429/5xx<br/>additive increase: +1/window"]
            ProcObs["Observability<br/>:9090/TCP"]
            QueuePoller --> ExecutionPlanner
            ExecutionPlanner --> Dispatcher
            Dispatcher --> AIMDControl
        end

        subgraph GC["batch-gateway-gc<br/>(Deployment, replicas: 1)"]
            Collector["Collector<br/>interval: 30m<br/>maxConcurrency: 10"]
            Reconciler["Reconciler<br/>interval: 60m<br/>watches processor pods"]
            GCObs["Metrics<br/>:9091/TCP"]
        end
    end

    Client["Client"] -->|"POST/GET /v1/batches<br/>POST/GET/DELETE /v1/files"| APIMux
    BatchHandler -->|"enqueue job"| Redis["Redis / Valkey<br/>(Priority Queue)"]
    BatchHandler -->|"store metadata"| PostgreSQL["PostgreSQL"]
    FileHandler -->|"upload/download"| S3["S3-compatible Storage"]

    QueuePoller -->|"dequeue jobs"| Redis
    Dispatcher -->|"inference requests<br/>HTTP/HTTPS"| InferenceGW["llm-d Inference Gateway"]
    Dispatcher -->|"read input files"| S3
    Dispatcher -->|"write output files"| S3
    Dispatcher -->|"update status"| PostgreSQL

    Collector -->|"delete expired"| PostgreSQL
    Collector -->|"delete expired files"| S3
    Reconciler -->|"watch pods<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]

    APIMux -.->|"traces (OTLP/gRPC)"| OTelCollector["OpenTelemetry Collector"]

    style APIServer fill:#4a90e2,color:#fff
    style Processor fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style Redis fill:#e8e8e8,stroke:#999
    style PostgreSQL fill:#e8e8e8,stroke:#999
    style S3 fill:#e8e8e8,stroke:#999
    style InferenceGW fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#999
    style OTelCollector fill:#e8e8e8,stroke:#999
    style Client fill:#f9f9f9,stroke:#999
