graph TB
    subgraph "llm-d-latency-predictor"
        subgraph PredictionStack["Prediction Stack (10 replicas)"]
            PredServer["prediction-server<br/>FastAPI / Uvicorn<br/>Port 8001/TCP"]
            LocalModels["Local Models<br/>/local_models<br/>emptyDir per pod"]
            PredServer -->|"file I/O"| LocalModels
        end

        subgraph TrainingStack["Training Stack (1 replica)"]
            TrainServer["training-server<br/>FastAPI / Uvicorn<br/>Port 8000/TCP"]
            ModelStore["Model Artifacts<br/>/models<br/>emptyDir or PVC"]
            TrainServer -->|"persist artifacts"| ModelStore
        end

        Common["common<br/>Shared Python types<br/>enums, models"]
        PredServer -.->|"imports"| Common
        TrainServer -.->|"imports"| Common
    end

    subgraph KubernetesServices["Kubernetes Services"]
        PredSvc["prediction-service<br/>ClusterIP 80 → 8001"]
        TrainSvc["training-service<br/>ClusterIP 8000 → 8000"]
    end

    subgraph Configuration["Configuration"]
        PredCM["prediction ConfigMap<br/>sync interval, model paths"]
        TrainCM["training ConfigMap<br/>retraining interval, model type"]
    end

    Client["llm-d Client<br/>or Internal Caller"] -->|"POST /predict"| PredSvc
    PredSvc -->|"routes to"| PredServer
    TrainSvc -->|"routes to"| TrainServer

    PredServer -->|"HTTP poll & download<br/>model artifacts"| TrainSvc
    TraceProducer["Trace Producer"] -->|"POST /add_training_data_bulk"| TrainSvc

    PredCM -.->|"env/volume"| PredServer
    TrainCM -.->|"env/volume"| TrainServer

    style PredServer fill:#4a90e2,color:#fff
    style TrainServer fill:#4a90e2,color:#fff
    style Common fill:#b8d4f0
    style PredSvc fill:#f5a623,color:#fff
    style TrainSvc fill:#f5a623,color:#fff
    style LocalModels fill:#d5e8d4
    style ModelStore fill:#d5e8d4
    style PredCM fill:#fff2cc
    style TrainCM fill:#fff2cc
    style Client fill:#e8e8e8
    style TraceProducer fill:#e8e8e8
