graph LR
    TrustyAI["TrustyAI<br/>Explainability Service"]

    %% External Dependencies (Frameworks & Libraries)
    TrustyAI -->|"app framework"| Quarkus["Quarkus 3.8.5"]
    TrustyAI -->|"optional ORM"| Hibernate["Hibernate ORM 6.2.13"]
    TrustyAI -->|"JSON"| Jackson["Jackson 2.15.0"]
    TrustyAI -->|"network transport"| Netty["Netty 4.1.125"]
    TrustyAI -->|"gRPC protocol"| Protobuf["protobuf-java 3.25.5"]
    TrustyAI -->|"gRPC client"| gRPC["io-grpc"]
    TrustyAI -->|"metrics export"| Micrometer["Micrometer /<br/>Prometheus"]
    TrustyAI -->|"optional S3 storage"| MinIOClient["MinIO Client 3.3.1"]
    TrustyAI -->|"optimization"| OptaPlanner["OptaPlanner 8.30.0"]
    TrustyAI -->|"data bridge"| ApacheArrow["Apache Arrow"]

    %% Internal Platform Dependencies
    Prometheus["Prometheus<br/>(ServiceMonitor)"] -->|"scrapes /q/metrics<br/>trustyai_spd, trustyai_dir"| TrustyAI
    ModelMesh["ModelMesh / KServe"] -->|"payload callback<br/>POST /consumer/kserve/v2"| TrustyAI
    Operator["trustyai-service-operator"] -->|"deploys & manages<br/>per namespace"| TrustyAI
    Route["OpenShift Route"] -->|"external ingress"| TrustyAI

    %% Integration Points (Outbound)
    TrustyAI -->|"gRPC inference"| KServeV2["KServe v2<br/>Model Servers"]
    TrustyAI -->|"HTTP inference"| KServeV1["KServe v1<br/>Model Servers"]
    TrustyAI -->|"ConfigMap CRUD<br/>443/TCP HTTPS"| K8sAPI["OpenShift API Server"]

    %% External Service Dependencies
    TrustyAI -->|"optional JDBC<br/>3306/TCP"| MariaDB["MariaDB / MySQL"]
    TrustyAI -->|"optional S3<br/>HTTP(S)"| MinIOSvc["MinIO Storage"]

