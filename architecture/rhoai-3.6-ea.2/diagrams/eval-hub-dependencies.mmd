graph LR
    EvalHub["EvalHub<br/>Go REST API"]

    %% Internal RHOAI Dependencies
    EvalHub -->|"managed by<br/>EvalHub CR"| TrustyAIOp["TrustyAI Service<br/>Operator"]
    EvalHub -->|"reads profiles"| HWProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1"]
    EvalHub -->|"auth proxy<br/>Bearer → X-User/X-Tenant"| KubeRBAC["kube-rbac-proxy"]
    EvalHub -->|"experiment tracking<br/>HTTP(S)/5000"| MLflow["MLflow Tracking<br/>Server"]

    %% Infrastructure Dependencies
    EvalHub -->|"Job orchestration<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]
    EvalHub -->|"telemetry export<br/>OTLP/gRPC 4317"| OTEL["OpenTelemetry<br/>Collector"]

    %% External Service Dependencies
    EvalHub -->|"test data download<br/>HTTPS/443"| S3["S3-compatible<br/>Storage"]
    EvalHub -->|"evalcard publish<br/>HTTPS/443"| OCI["OCI Registry"]
    EvalHub -.->|"test data download"| Git["Git Repositories"]
    EvalHub -.->|"dataset download"| HFHub["HuggingFace Hub"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>HTTP/8081"| EvalHub

    %% Evaluation Backends (via job pods)
    EvalHub -.->|"orchestrates"| LMEval["lm-evaluation-harness"]
    EvalHub -.->|"orchestrates"| RAGAS["RAGAS"]
    EvalHub -.->|"orchestrates"| Garak["Garak"]
    EvalHub -.->|"orchestrates"| GuideLLM["GuideLLM"]
    EvalHub -.->|"orchestrates"| LightEval["LightEval"]
    EvalHub -.->|"orchestrates"| MTEB["MTEB"]

    %% Storage backends
    EvalHub -->|"persistence"| SQLite["SQLite"]
    EvalHub -->|"persistence"| PostgreSQL["PostgreSQL"]

    %% Styling
    style EvalHub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TrustyAIOp fill:#7ed321,stroke:#333,color:#fff
    style HWProfile fill:#7ed321,stroke:#333,color:#fff
    style KubeRBAC fill:#7ed321,stroke:#333,color:#fff
    style MLflow fill:#7ed321,stroke:#333,color:#fff
