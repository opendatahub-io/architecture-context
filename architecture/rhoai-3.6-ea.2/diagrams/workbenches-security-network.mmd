graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["data-science-gateway<br/>443/TCP → HTTPRoute<br/>TLS SIMPLE"]
    end

    subgraph WorkspacePods["WORKSPACE PODS (per-namespace)"]
        direction TB
        KubeRBACProxy["kube-rbac-proxy sidecar<br/>:8443/TCP HTTPS<br/>TokenReview + SAR"]
        WorkspacePod["Workspace Pod<br/>StatefulSet<br/>SA: per-workspace"]
        KubeRBACProxy -->|"localhost<br/>HTTP<br/>No Auth"| WorkspacePod
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (kubeflow-workspaces)"]
        direction TB

        Backend["workspaces-backend<br/>:4000/TCP HTTP<br/>SA: workspaces-backend<br/>TokenReview + SAR"]

        Controller["workspaces-controller<br/>:8081/TCP health<br/>:8080/TCP metrics HTTPS<br/>SA: workspaces-controller"]

        WebhookSvc["Webhook Server<br/>:9443/TCP HTTPS<br/>TLS (cluster profile)<br/>Admission certs"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]

        OpenShiftCfg["OpenShift API Config<br/>config.openshift.io<br/>TLS profile"]

        Prometheus["Prometheus<br/>ServiceMonitor scrape<br/>:8443/TCP HTTPS"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Gateway

    %% Gateway to workspace
    Gateway -->|"HTTPS/8443<br/>TLS<br/>TokenReview"| KubeRBACProxy

    %% Gateway to backend
    Gateway -->|"HTTP/4000<br/>Behind platform TLS<br/>Bearer Token"| Backend

    %% Backend to K8s
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: TokenReview + SAR"| K8sAPI

    %% Controller to K8s
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: CRUD resources"| K8sAPI

    %% Webhook flows
    K8sAPI -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>Admission certs"| WebhookSvc
    WebhookSvc -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: read context"| K8sAPI

    %% Controller reads TLS profile
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>Read TLS profile"| OpenShiftCfg

    %% Prometheus scrape
    Prometheus -->|"HTTPS/8443<br/>TLS (serving cert)<br/>authn/authz"| Controller

    %% K8s watch to controller
    K8sAPI -.->|"Watch events<br/>TLS 1.2+"| Controller

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workspace fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Gateway ingress
    class KubeRBACProxy,WorkspacePod workspace
    class Backend,Controller,WebhookSvc internal
    class K8sAPI,OpenShiftCfg,Prometheus controlplane
