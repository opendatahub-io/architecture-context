graph TB
    subgraph WVA["Workload-Variant-Autoscaler Controller"]
        direction TB

        subgraph Engines["Optimization Engines"]
            SatEngine["Saturation Engine<br/>Go optimization loop"]
            SFZEngine["Scale-from-Zero Engine<br/>Go optimization loop"]
            Coordinator["Coordinator<br/>GPU rebalance<br/>(experimental)"]
        end

        subgraph Controllers["Reconcilers"]
            ConfigMapR["ConfigMapReconciler<br/>Live config reload"]
            HPAR["HPAReconciler<br/>HPA discovery"]
            InferencePoolR["InferencePoolReconciler<br/>GA + alpha pools"]
            ScaledObjectR["ScaledObjectReconciler<br/>(conditional on KEDA CRD)"]
        end

        subgraph Actuator["Actuator"]
            DirectActuator["DirectActuator<br/>Scale subresource"]
        end

        SatEngine -->|computes replicas| DirectActuator
        SFZEngine -->|scales from zero| DirectActuator
        Coordinator -.->|GPU rebalance| DirectActuator
        ConfigMapR -->|updates config| SatEngine

        HPAR -->|discovers workloads| SatEngine
        InferencePoolR -->|pool config| SatEngine
        ScaledObjectR -->|discovers targets| SatEngine
    end

    %% External watches
    HPACR["HorizontalPodAutoscaler"] -->|watched by| HPAR
    InferencePoolCR["InferencePool CR<br/>inference.networking.k8s.io"] -->|watched by| InferencePoolR
    ScaledObjectCR["KEDA ScaledObject"] -.->|watched by| ScaledObjectR
    ConfigMapCR["ConfigMap<br/>app.kubernetes.io/name:<br/>workload-variant-autoscaler"] -->|watched by| ConfigMapR

    %% Egress
    SatEngine -->|queries metrics| Prometheus["Prometheus / Thanos Querier<br/>9091/TCP HTTPS"]
    DirectActuator -->|scales| Deployment["Deployments"]
    DirectActuator -->|scales| LWS["LeaderWorkerSets"]

    %% Metrics endpoint
    PromScrape["Prometheus Scraper<br/>(ServiceMonitor)"] -->|scrapes :8443/metrics| WVA

    %% GPU discovery
    SatEngine -.->|GPU inventory| Nodes["Kubernetes Nodes<br/>NVIDIA GPU labels"]

    %% Styling
    style WVA fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style SatEngine fill:#4a90e2,color:#fff
    style SFZEngine fill:#4a90e2,color:#fff
    style Coordinator fill:#4a90e2,color:#fff,stroke-dasharray: 5 5
    style ConfigMapR fill:#5b9bd5,color:#fff
    style HPAR fill:#5b9bd5,color:#fff
    style InferencePoolR fill:#5b9bd5,color:#fff
    style ScaledObjectR fill:#5b9bd5,color:#fff,stroke-dasharray: 5 5
    style DirectActuator fill:#2e75b6,color:#fff
    style HPACR fill:#f5a623
    style InferencePoolCR fill:#f5a623
    style ScaledObjectCR fill:#f5a623,stroke-dasharray: 5 5
    style ConfigMapCR fill:#f5a623
    style Prometheus fill:#e8e8e8,stroke:#333
    style Deployment fill:#7ed321
    style LWS fill:#7ed321
    style PromScrape fill:#e8e8e8,stroke:#333
    style Nodes fill:#e8e8e8,stroke:#333
