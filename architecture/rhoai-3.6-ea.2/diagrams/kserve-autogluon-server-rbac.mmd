        PVC["core<br/>PersistentVolumeClaims"]
        PV["core<br/>PersistentVolumes"]
        Nodes["core<br/>Nodes"]
    end

    subgraph LMNResources["kserve-localmodelnode-agent-role Resources"]
        LMN_R2["serving.kserve.io<br/>LocalModelNodes"]
        CSC2["serving.kserve.io<br/>ClusterStorageContainers"]
        LMNG["serving.kserve.io<br/>LocalModelNodeGroups"]
        Jobs["batch<br/>Jobs"]
    end

