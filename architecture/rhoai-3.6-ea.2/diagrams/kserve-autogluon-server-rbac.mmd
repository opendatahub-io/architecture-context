        ScaledObj["keda.sh<br/>ScaledObjects"]
        LLMMetrics["/metrics<br/>(non-resource URL)"]
    end

    subgraph LMResources["kserve-localmodel-manager-role Resources"]
        LMC["serving.kserve.io<br/>LocalModelCaches"]
        LMNC["serving.kserve.io<br/>LocalModelNamespaceCaches"]
