    CR_LM -->|"CRUD + watch"| LMC
    CR_LM -->|"CRUD + watch"| LMNC
    CR_LM -->|"CRUD + watch"| LMN_R
    CR_LM -->|"CRUD + watch"| PVC
    CR_LM -->|"CRUD + watch"| PV
    CR_LM -->|"CRUD + watch"| Nodes

    CR_LMN -->|"CRUD + watch"| LMN_R2
    CR_LMN -->|"CRUD + watch"| CSC2
