graph LR
    Workbenches["Workbenches<br/>(Kubeflow Notebooks v2)"]

    %% Internal RHOAI Dependencies
    Workbenches -->|"HTTPRoute CRUD<br/>(per-workspace ingress)"| Gateway["data-science-gateway<br/>(Platform Gateway)"]
    Workbenches -->|"sidecar injection<br/>(workspace auth)"| KubeRBACProxy["kube-rbac-proxy<br/>(odh-kube-auth-proxy)"]
    Workbenches -.->|"VirtualService CRUD<br/>(Istio mode)"| Istio["Istio<br/>(optional)"]

    %% Kubernetes Dependencies
    Workbenches -->|"CRUD resources<br/>TokenReview / SAR"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Workbenches -->|"read TLS profile"| OpenShiftAPI["OpenShift API Config<br/>(config.openshift.io)"]

    %% External Go Dependencies
    Workbenches -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.22.1"]
    Workbenches -->|"API client"| ClientGo["client-go<br/>v0.34.1"]
    Workbenches -->|"Gateway API types"| GatewayAPI["gateway-api<br/>v1.4.1"]
    Workbenches -->|"Istio types"| IstioClient["istio/client-go<br/>v1.22.8"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"ServiceMonitor<br/>scrapes :8443"| Workbenches

    %% Integration Points (consumers)
    Dashboard["ODH Dashboard<br/>(frontend)"] -.->|"workspace UI"| Workbenches

