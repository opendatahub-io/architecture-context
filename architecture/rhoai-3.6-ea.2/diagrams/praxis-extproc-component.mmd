graph TB
    subgraph "praxis-extproc Service"
        direction TB
        Main["praxis_extproc<br/>(main binary)"]
        Server["ExternalProcessor<br/>(gRPC service)"]
        Adapter["Adapter Module<br/>(Envoy ↔ Praxis)"]
        Response["Response Builder<br/>(chunk splitting)"]
        Config["Config Loader<br/>(YAML, deny_unknown_fields)"]
        TLS["TLS Module<br/>(OpenSSL, P-256)"]
        FIPS["FIPS Detection<br/>(MD5 probe + provider)"]
        Health["Health Service<br/>(gRPC health.v1)"]
        Metrics["Metrics Endpoint<br/>(Prometheus)"]

        Main -->|loads| Config
        Main -->|initializes| TLS
        Main -->|probes| FIPS
        Main -->|spawns| Server
        Main -->|spawns| Health
        Main -->|spawns| Metrics

        Server -->|translates via| Adapter
        Server -->|builds via| Response
        Server -->|uses| TLS
    end

    subgraph "StreamState (per gRPC stream)"
        PhaseTracker["PhaseOrderTracker<br/>(Headers → Body → Trailers)"]
        EosTracker["EosTracker<br/>(end-of-stream per direction)"]
        BodyAccum["Body Accumulator<br/>(10 MiB limit)"]
        FilterMeta["Filter Metadata<br/>(request → response carry)"]
    end

    Server -->|manages| PhaseTracker
    Server -->|tracks| EosTracker
    Server -->|accumulates| BodyAccum
    Server -->|preserves| FilterMeta

    subgraph "Deployment: payload-pre-processing (pre-auth)"
        PreBBR["BBR Pipeline<br/>model_to_header +<br/>llmisvc_model_provider_resolver"]
    end

    subgraph "Deployment: payload-processing (post-auth)"
        PostIPP["IPP Pipeline<br/>(full request/response processing)"]
    end

    ConfigMap["payload-processing-plugins<br/>(ConfigMap)"]
    ConfigMap -->|pre-extproc.yaml| PreBBR
    ConfigMap -->|extproc.yaml| PostIPP

    EnvoyGW["Envoy Gateway<br/>(MaaS)"]
    EnvoyGW -->|gRPC ExtProc<br/>9004/TCP| PreBBR
    EnvoyGW -->|gRPC ExtProc<br/>9004/TCP| PostIPP

    KubeAPI["Kubernetes API"]
    Server -->|get/list/watch<br/>ExternalProviders,<br/>ExternalModels| KubeAPI

    K8sProbes["Kubernetes Probes"]
    K8sProbes -->|readiness gRPC<br/>50052/TCP| Health

    Prometheus["Prometheus"]
    Prometheus -->|scrape<br/>9090/TCP| Metrics

    style Main fill:#4a90e2,color:#fff
    style Server fill:#4a90e2,color:#fff
    style Adapter fill:#4a90e2,color:#fff
    style Response fill:#4a90e2,color:#fff
    style Config fill:#4a90e2,color:#fff
    style TLS fill:#4a90e2,color:#fff
    style FIPS fill:#4a90e2,color:#fff
    style Health fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style PreBBR fill:#7ed321,color:#fff
    style PostIPP fill:#7ed321,color:#fff
    style ConfigMap fill:#f5a623,color:#fff
    style EnvoyGW fill:#e8e8e8
    style KubeAPI fill:#e8e8e8
    style K8sProbes fill:#e8e8e8
    style Prometheus fill:#e8e8e8
