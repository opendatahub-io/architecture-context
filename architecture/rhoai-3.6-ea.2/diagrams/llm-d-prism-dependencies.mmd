graph LR
    Prism["Prism BFF<br/>(Node.js/Express)"]

    %% External Dependencies - Runtime
    Prism -->|"runtime"| Node["Node.js 26<br/>(Alpine)"]
    Prism -->|"HTTP server"| Express["Express ^4.18.2"]
    Prism -->|"UI framework"| React["React ^19.2.0"]
    Prism -->|"build tool"| Vite["Vite ^7.2.4"]
    Prism -->|"CSS"| Tailwind["Tailwind CSS ^4.1.17"]
    Prism -->|"charts"| Recharts["Recharts ^3.4.1"]
    Prism -->|"GCS SDK"| GCSLib["@google-cloud/storage ^7.21.0"]
    Prism -->|"Google auth"| GoogleAuth["google-auth-library ^9.4.1"]
    Prism -->|"validation"| Zod["Zod ^4.4.3"]
    Prism -->|"TS execution"| TSX["tsx ^4.19.0"]
    Prism -->|"rate limiting"| RateLimit["express-rate-limit ^7.1.5"]
    Prism -->|"YAML parsing"| JSYAML["js-yaml ^4.1.1"]
    Prism -->|"compression"| Fflate["fflate ^0.8.3"]

    %% External Cloud Services
    Prism -->|"data store<br/>HTTPS/443"| GCS["Google Cloud Storage"]
    Prism -->|"inference quality<br/>HTTPS/443"| GIQ["GKE Recommender API"]
    Prism -->|"authentication<br/>HTTPS/443"| GitHub["GitHub OAuth + API"]
    Prism -->|"deployment platform"| CloudRun["Google Cloud Run"]
    Prism -.->|"public reads<br/>HTTPS/443"| S3["AWS S3 (public)"]

    %% Dev Dependencies
    Prism -.->|"testing (dev)"| Vitest["Vitest ^4.1.11"]
    Prism -.->|"avatars (playground)"| Avatars["boring-avatars ^2.0.4"]

    %% Integration Points
    Browser["Browser Client"] -->|"HTTPS/443"| Prism
    Browser -.->|"direct reads<br/>HTTPS/443"| S3

