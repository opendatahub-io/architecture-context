    MustGather -->|"Helm values/manifests"| Helm["helm<br/>v4.1.4"]
    MustGather -->|"OCP only"| OC["oc CLI<br/>(OpenShift)"]

    %% Internal RHOAI Platform Dependencies (CRD reads)
    MustGather -->|"CRD read"| RHODSOp["rhods-operator<br/>DSCInitialization<br/>DataScienceCluster"]
    MustGather -->|"CRD read"| KServe["KServe<br/>InferenceService<br/>ServingRuntime"]
    MustGather -->|"CRD read"| DSP["Data Science Pipelines<br/>DSPApplication<br/>Workflow"]
