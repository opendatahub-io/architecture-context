    MustGather -->|"CRD read"| TrainOp["Training Operator<br/>PyTorchJob<br/>TrainJob"]
    MustGather -->|"CRD read"| ModelReg["Model Registry"]
    MustGather -->|"CRD read"| TrustyAI["TrustyAI<br/>LMEvalJob<br/>GuardrailsOrchestrator"]
    MustGather -->|"CRD read"| Feast["Feast Operator<br/>FeatureStore"]
    MustGather -->|"CRD read"| LlamaStack["LlamaStack<br/>LlamaStackDistribution"]
    MustGather -->|"CRD read"| MLflow["MLflow"]
    MustGather -->|"CRD read"| Spark["Spark Operator<br/>SparkApplication"]
    MustGather -->|"CRD read"| AIGateway["AI Gateway / MaaS<br/>AITenant, ExternalModel<br/>MaaSAuthPolicy"]
    MustGather -->|"CRD read"| MCPOp["MCP Lifecycle Operator<br/>MCPServer"]

    %% External Infrastructure Dependencies (CRD reads)
    MustGather -->|"CRD read"| Istio["Istio / Sail<br/>VirtualService<br/>DestinationRule<br/>AuthorizationPolicy"]
    MustGather -->|"CRD read"| CertMgr["cert-manager<br/>Certificate<br/>Issuer"]
