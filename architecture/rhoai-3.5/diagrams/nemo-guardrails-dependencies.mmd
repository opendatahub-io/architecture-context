graph LR
    NemoGuardrails["NeMo Guardrails Server<br/>(FastAPI + Uvicorn)"]

    %% Core Framework Dependencies
    NemoGuardrails -->|HTTP framework| FastAPI["FastAPI >=0.103.0"]
    NemoGuardrails -->|ASGI server| Uvicorn["Uvicorn >=0.23"]
    NemoGuardrails -->|schema validation| Pydantic["Pydantic >=2.5,<3.0"]
    NemoGuardrails -->|async HTTP client| aiohttp["aiohttp >=3.10.11"]
    NemoGuardrails -->|HTTP client| httpx["httpx >=0.24.1"]
    NemoGuardrails -->|API types| OpenAISDK["OpenAI SDK >=1.0,<3.0"]
    NemoGuardrails -->|dialog language| Lark["lark >=1.1.7"]
    NemoGuardrails -->|CLI| Typer["typer >=0.8"]

    %% ML / Embedding Dependencies
    NemoGuardrails -->|embeddings| fastembed["fastembed >=0.2.2"]
    NemoGuardrails -->|ONNX inference| onnxruntime["onnxruntime >=1.17.0"]

    %% Optional ML Dependencies
    NemoGuardrails -.->|sentence embeddings| SentenceTransformers["sentence-transformers >=2.2.0"]
    NemoGuardrails -.->|NLP processing| spaCy["spaCy >=3.4.4,<4.0"]
    NemoGuardrails -.->|tokenization| nltk["nltk >=3.8"]
    NemoGuardrails -.->|deep learning| PyTorch["torch >=2.0.0"]
    NemoGuardrails -.->|transformers| HFTransformers["transformers >=4.35.0"]

    %% Optional Security Dependencies
    NemoGuardrails -.->|PII detection| Presidio["presidio-analyzer >=2.2"]
    NemoGuardrails -.->|jailbreak detection| YARA["yara-python >=4.5.1,<5.0"]

    %% Optional Infrastructure Dependencies
    NemoGuardrails -.->|tracing| OTel["opentelemetry-distro >=0.48b0"]
    NemoGuardrails -.->|thread persistence| aioredis["aioredis"]

    %% Runtime / Platform Dependencies
    NemoGuardrails -->|chat completions| UpstreamLLM["Upstream LLM Server<br/>(vLLM / NIM / OpenAI)"]
    NemoGuardrails -.->|telemetry| NVIDIATelemetry["NVIDIA Telemetry<br/>(events.telemetry.data.nvidia.com)"]
    NemoGuardrails -.->|model downloads| HFHub["HuggingFace Hub<br/>(huggingface.co)"]
    NemoGuardrails -.->|conversation store| Redis["Redis Server"]

    %% Platform Integration
    PlatformAuth["kube-rbac-proxy<br/>(Platform Auth)"] -->|auth + TLS| NemoGuardrails

