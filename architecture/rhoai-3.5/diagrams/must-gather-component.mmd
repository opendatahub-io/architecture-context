            Notebooks["gather_notebooks.sh<br/>Workbenches"]
            Dashboard["gather_dashboard.sh<br/>Dashboard Config"]
            KubeRay["gather_kuberay.sh<br/>Ray Clusters"]
            Kueue["gather_kueue.sh<br/>Job Scheduling"]
            KFTO["gather_kfto.sh<br/>Training Operator"]
            MR["gather_mr.sh<br/>Model Registry"]
            TrustyAI["gather_trustyai.sh<br/>TrustyAI / LMEval"]
            Feast["gather_feastoperator.sh<br/>Feature Stores"]
            LlamaStack["gather_lls.sh<br/>LlamaStack"]
            MLflow["gather_mlflow.sh<br/>MLflow"]
            Spark["gather_sparkoperator.sh<br/>Spark"]
            AIGateway["gather_aigateway.sh<br/>AI Gateway / MaaS"]
            MCP["gather_mcp_lifecycle_operator.sh<br/>MCP Servers"]
        end

        subgraph "xKS / LLM-D Collectors"
            direction TB
            LLMDGather["gather_llmd.sh<br/>LLM-D Orchestrator"]
            O11y["gather_o11y.sh<br/>Observability"]
            WVA["gather_wva.sh<br/>WVA / KEDA"]
            BatchGW["gather_batch_gateway.sh<br/>Batch Gateway"]

