    subgraph "External Tools"
        OC["oc CLI<br/>(OpenShift)"]
        Kubectl["kubectl CLI<br/>(xKS)"]
        Helm["helm CLI<br/>(v4.1.4)"]
    end

    CommonSH -->|"oc adm inspect"| OC
    XksUtilSH -->|"kubectl_inspect"| Kubectl
    GatherSH -->|"helm get values"| Helm

    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
