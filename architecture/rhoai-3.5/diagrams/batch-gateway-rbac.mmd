graph TD
    subgraph ServiceAccounts["Service Accounts (No Kubernetes RBAC Bound)"]
        SA_API["batch-gateway-apiserver<br/>ServiceAccount"]
        SA_Proc["batch-gateway-processor<br/>ServiceAccount"]
        SA_GC["batch-gateway-gc<br/>ServiceAccount"]
    end

    subgraph GatewayAuth["Gateway-Level Auth (Delegated)"]
        direction TB
        Kuadrant["Kuadrant / Authorino<br/>Gateway API AuthPolicy"]
        AuthMethods["Supported Auth Methods:<br/>• API Key<br/>• ServiceAccount Token<br/>• OpenShift User Token"]
        Kuadrant --> AuthMethods
    end

    subgraph AppAuth["Application-Level Auth"]
        direction TB
        TenantMiddleware["Request Middleware<br/>Extracts X-MaaS-Username header"]
        TenantIsolation["Tenant Isolation<br/>• DB queries scoped by TenantID<br/>• File storage: SHA256 folder hash<br/>• Cross-tenant access → HTTP 404"]
        TenantMiddleware --> TenantIsolation
    end

    subgraph InferenceAuth["Inference Endpoint Auth"]
        direction TB
        APIKeyAuth["API Key Auth<br/>Bearer header from secret mount<br/>Per-model or global key"]
        mTLSAuth["mTLS Client Cert<br/>Per-model TLS cert/key<br/>Optional"]
    end

    subgraph SecretMounts["Projected Secrets"]
        GlobalSecret["global.secretName (Opaque)<br/>• redis-url<br/>• postgresql-url<br/>• inference-api-key<br/>• s3-secret-access-key"]
        TLSSecret["apiserver TLS (kubernetes.io/tls)<br/>• ssl_cert_file<br/>• ssl_key_file"]
        ModelKeys["Per-model API keys (Opaque)<br/>• Individual inference keys"]
        ModelCerts["Per-model TLS certs (kubernetes.io/tls)<br/>• mTLS client certificates"]
    end

    subgraph Observability["Unauthenticated Endpoints"]
        HealthReady["/health, /ready<br/>No auth required<br/>Ports: 8081, 9090"]
        Metrics["/metrics<br/>No auth required<br/>Ports: 8081, 9090, 9091"]
    end

    %% Auth flow
    AuthMethods -->|"validated request<br/>+ tenant header"| TenantMiddleware

    %% Secret usage
    GlobalSecret -->|mounted| SA_API
    GlobalSecret -->|mounted| SA_Proc
    GlobalSecret -->|mounted| SA_GC
    TLSSecret -.->|optional| SA_API
    ModelKeys -.->|optional| SA_Proc
    ModelCerts -.->|optional| SA_Proc

    %% Inference auth
    SA_Proc -->|uses| APIKeyAuth
    SA_Proc -->|uses| mTLSAuth

    %% Note about no K8s RBAC
    NoRBAC["⚠ No Kubernetes Roles or ClusterRoles<br/>Service does not interact with K8s API<br/>All authorization delegated to gateway layer"]

    %% Styling
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proc fill:#4a90e2,stroke:#333,color:#fff
    style SA_GC fill:#4a90e2,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style TenantMiddleware fill:#f5a623,stroke:#333,color:#fff
    style TenantIsolation fill:#f5a623,stroke:#333
    style GlobalSecret fill:#e8e8e8,stroke:#333
    style TLSSecret fill:#e8e8e8,stroke:#333
    style ModelKeys fill:#e8e8e8,stroke:#333
    style ModelCerts fill:#e8e8e8,stroke:#333
    style NoRBAC fill:#fff3cd,stroke:#856404,color:#856404
    style APIKeyAuth fill:#dae8fc,stroke:#6c8ebf
    style mTLSAuth fill:#dae8fc,stroke:#6c8ebf
