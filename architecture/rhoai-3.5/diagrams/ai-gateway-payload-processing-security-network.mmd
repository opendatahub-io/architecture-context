graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["Platform Gateway (Envoy)<br/>maas-default-gateway<br/>NS: openshift-ingress<br/>443/TCP → HTTPRoute routing<br/>TLS 1.2+ (SIMPLE)"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS STRICT)"]
        direction TB

        ExtProc["ai-gateway-payload-processing<br/>SA: {name}-{release}<br/>9004/TCP gRPC (ext_proc)<br/>9005/TCP HTTP (health)<br/>FIPS: strictfipsruntime"]

        subgraph PluginPipeline["Plugin Pipeline (in-process)"]
            direction LR
            P1["maas-headers-guard"]
            P2["model-provider-resolver"]
            P3["stream-usage-enforcer"]
            P4["api-translation"]
            P5["apikey-injection"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>ServiceAccount Token"]

        subgraph InCluster["IN-CLUSTER SERVICES (plaintext)"]
            MeteringSvc["Metering Service<br/>configurable port<br/>HTTP plaintext<br/>No auth"]
            NeMoSvc["NeMo Guardrails Service<br/>configurable port<br/>HTTP plaintext<br/>No auth"]
        end
    end

    subgraph ExternalServices["EXTERNAL LLM PROVIDERS (Egress via Istio)"]
        OpenAI["api.openai.com<br/>443/TCP HTTPS<br/>TLS 1.2+ (SIMPLE)<br/>API Key (Bearer)"]
        Anthropic["api.anthropic.com<br/>443/TCP HTTPS<br/>TLS 1.2+ (SIMPLE)<br/>API Key (x-api-key)"]
        Bedrock["bedrock-runtime.*.amazonaws.com<br/>443/TCP HTTPS<br/>TLS 1.2+ (SIMPLE)<br/>AWS SigV4"]
        VertexAI["{region}-aiplatform.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+ (SIMPLE)<br/>GCP OAuth2 (Bearer)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Client credential (passthrough)"| Gateway
    Gateway -->|"gRPC ext_proc/9004<br/>Istio mTLS STRICT<br/>Peer auth"| ExtProc

    ExtProc -->|"HTTPS/6443<br/>TLS<br/>ServiceAccount token"| K8sAPI

    ExtProc -->|"HTTP/configurable<br/>plaintext<br/>No auth"| MeteringSvc
    ExtProc -->|"HTTP/configurable<br/>plaintext<br/>No auth"| NeMoSvc

    ExtProc -->|"HTTPS/443<br/>TLS 1.2+ (DestinationRule SIMPLE)<br/>API Key (Bearer)"| OpenAI
    ExtProc -->|"HTTPS/443<br/>TLS 1.2+ (DestinationRule SIMPLE)<br/>API Key (x-api-key)"| Anthropic
    ExtProc -->|"HTTPS/443<br/>TLS 1.2+ (DestinationRule SIMPLE)<br/>AWS SigV4"| Bedrock
    ExtProc -->|"HTTPS/443<br/>TLS 1.2+ (DestinationRule SIMPLE)<br/>GCP OAuth2"| VertexAI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef incluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef plugin fill:#dae8fc,stroke:#6c8ebf

    class Client external
    class Gateway ingress
    class ExtProc servicemesh
    class K8sAPI servicemesh
    class MeteringSvc,NeMoSvc incluster
    class OpenAI,Anthropic,Bedrock,VertexAI externalservice
    class P1,P2,P3,P4,P5 plugin
