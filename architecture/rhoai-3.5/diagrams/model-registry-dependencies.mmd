graph LR
    MR["Model Registry<br/>(proxy + controller + CSI + async-upload)"]

    %% External Dependencies
    MR -->|"metadata storage<br/>(default)"| MySQL["MySQL 8.3+"]
    MR -->|"metadata storage<br/>(alternative)"| PostgreSQL["PostgreSQL 16+"]
    MR -->|"CR watch + CSI"| KServe["KServe v1beta1"]
    MR -->|"mTLS + AuthZ"| Istio["Istio v1alpha3"]
    MR -->|"image signing"| cosign["cosign<br/>(bundled)"]
    MR -->|"image push/pull"| skopeo["skopeo<br/>(bundled)"]
    MR -->|"model signing"| Sigstore["Sigstore 4.3.0<br/>(Fulcio / Rekor)"]

    %% Internal Platform Dependencies
    KServeInt["KServe<br/>(InferenceService CR)"] -->|"CRD Watch"| MR
    KServeCSC["KServe<br/>(ClusterStorageContainer)"] -->|"CR Registration"| MR
    Dashboard["Model Registry UI<br/>(BFF)"] -->|"REST API client"| MR
    Operator["RHOAI Platform<br/>Operator"] -->|"deployment mgmt"| MR

    %% External Services (async-upload)
    MR -->|"model storage"| S3["S3-compatible<br/>Storage"]
    MR -->|"model images"| OCI["OCI Container<br/>Registry"]
    MR -->|"model download"| HF["HuggingFace Hub"]
    MR -->|"cluster API"| K8sAPI["Kubernetes API"]

    %% Styling
    style MR fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MySQL fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style KServe fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style cosign fill:#999,stroke:#333,color:#fff
    style skopeo fill:#999,stroke:#333,color:#fff
    style Sigstore fill:#999,stroke:#333,color:#fff
    style KServeInt fill:#7ed321,stroke:#333
    style KServeCSC fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style Operator fill:#7ed321,stroke:#333
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style OCI fill:#f5a623,stroke:#333,color:#fff
    style HF fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
