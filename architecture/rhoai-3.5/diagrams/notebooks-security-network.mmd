graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
        KRP["kube-rbac-proxy Sidecar<br/>8443/TCP<br/>TLS 1.2+<br/>OpenShift OAuth + K8s RBAC<br/>(injected by notebook controller)"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (Single-Tenant, User 1001)"]
        direction TB

        subgraph JupyterVariant["Jupyter Variant"]
            JL["JupyterLab Server<br/>8888/TCP HTTP<br/>Endpoints: /lab, /api/kernels/, /api/status<br/>No TLS, No Auth (trusts sidecar)"]
        end

        subgraph CodeServerVariant["Code-Server Variant"]
            Nginx["nginx Reverse Proxy<br/>8888/TCP HTTP"]
            CSIDE["code-server IDE<br/>8787/TCP HTTP<br/>v4.112.0"]
            CGI["httpd CGI Gateway<br/>8080/TCP HTTP<br/>access.cgi (Jupyter API emulation)"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        DSPA["DSPA Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        MLflow["MLflow Tracking<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Configurable Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        MongoDB["MongoDB<br/>27017/TCP<br/>Configurable Encryption<br/>Credentials"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Configurable Encryption<br/>Credentials"]
        Kafka["Kafka<br/>9092/TCP<br/>Configurable"]
        Registry["Container Registry<br/>quay.io / registry.redhat.io<br/>443/TCP HTTPS"]
    end

    %% Inbound flows
    User -->|"HTTPS/8443<br/>TLS 1.2+<br/>OpenShift OAuth"| KRP
    KRP -->|"HTTP/8888<br/>No encryption<br/>Pod-internal (trusted)"| JL
    KRP -->|"HTTP/8888<br/>No encryption<br/>Pod-internal (trusted)"| Nginx

    %% Code-Server internal flows
    Nginx -->|"HTTP/8787<br/>localhost"| CSIDE
    Nginx -->|"HTTP/8080<br/>localhost"| CGI
    CGI -->|"HTTP/8787<br/>GET /healthz<br/>localhost"| CSIDE

    %% Outbound from workbench
    JL -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    JL -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| DSPA
    JL -->|"HTTPS/443<br/>TLS 1.2+<br/>Configurable"| MLflow
    JL -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    JL -->|"TCP/27017<br/>Credentials"| MongoDB
    JL -->|"TCP/5432<br/>Credentials"| PostgreSQL
    JL -->|"TCP/9092<br/>Configurable"| Kafka

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class KRP authboundary
    class JL,Nginx,CSIDE,CGI workbench
    class K8sAPI,DSPA,MLflow clusterservice
    class S3,MongoDB,PostgreSQL,Kafka,Registry externalservice
