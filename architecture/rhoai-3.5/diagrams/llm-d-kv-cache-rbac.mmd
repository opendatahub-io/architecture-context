graph TD
    subgraph "Service Accounts"
        SA["operator-controller-manager<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole Bindings"
        CRB["exec-rbac-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole Permissions"
        CR["exec-rbac-role"]
    end

    subgraph "API Resources"
        PodsExec["Core API Group (\"\")<br/>pods/exec"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"create"| PodsExec

    subgraph "Authentication Summary"
        direction LR
        Auth1["TokenizationService<br/>gRPC/UDS<br/>Auth: None<br/>Isolation: UDS kernel"]
        Auth2["ZMQ Event Stream<br/>5557/TCP<br/>Auth: None<br/>Isolation: Pod network"]
        Auth3["Redis / Valkey<br/>6379/TCP<br/>Auth: URL credentials<br/>TLS: Optional (rediss://)"]
        Auth4["/healthz<br/>8082/TCP<br/>Auth: None"]
        Auth5["Kubernetes API<br/>443/TCP<br/>Auth: ServiceAccount token<br/>TLS: TLS 1.2+"]
    end

    subgraph "Secrets"
        Secret1["hf-token<br/>Type: Opaque<br/>Purpose: HF Hub auth<br/>Provisioned: Manual<br/>Auto-rotate: No"]
    end

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e67e22,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style PodsExec fill:#7ed321,stroke:#333,color:#fff
    style Auth1 fill:#d5e8d4,stroke:#82b366
    style Auth2 fill:#f8cecc,stroke:#b85450
    style Auth3 fill:#fff2cc,stroke:#d6b656
    style Auth4 fill:#d5e8d4,stroke:#82b366
    style Auth5 fill:#d5e8d4,stroke:#82b366
    style Secret1 fill:#e8d4f5,stroke:#9b59b6
