graph TB
    subgraph External["EXTERNAL (Admin Workstation)"]
        Admin["Cluster Admin<br/>kubeconfig authenticated"]
    end

    subgraph Cluster["CLUSTER (Ephemeral Pod)"]
        direction TB

        subgraph MustGather["must-gather Pod (one-shot)"]
            direction TB
            Gather["gather.sh<br/>Orchestrator"]
            Common["common.sh<br/>Shared Library"]
            XksUtil["xks_util.sh<br/>xKS Support"]

            subgraph OCPPath["OCP Path (parallel)"]
                direction LR
                Serving["gather_serving.sh"]
                DSP["gather_dsp.sh"]
                Others["... 12 more collectors"]
            end

            subgraph XKSPath["xKS Path (LLM-D)"]
                direction LR
                LLMD["gather_llmd.sh"]
                Deps["cert-manager / sail / lws"]
            end

            Gather --> Common
            Gather --> XksUtil
            Gather -->|OCP| OCPPath
            Gather -->|xKS| XKSPath
        end

        subgraph Tools["CLI Tools in Image"]
            OC["oc CLI<br/>(OpenShift)"]
            Kubectl["kubectl v1.34.7<br/>(xKS)"]
            Helm["helm v4.1.4"]
        end

        MustGather -->|"oc adm inspect"| OC
        MustGather -->|"kubectl_inspect"| Kubectl
        MustGather -->|"helm get values"| Helm
    end

    subgraph APIServer["KUBERNETES API SERVER"]
        K8sAPI["kube-apiserver<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]

        subgraph Resources["Resources Read (GET/LIST/WATCH only)"]
            Platform["Platform CRDs<br/>DSCInitialization<br/>DataScienceCluster<br/>Gateway API / Istio"]
            Components["Component CRDs<br/>InferenceService, DSPApplication<br/>Notebook, RayCluster, Workload<br/>PyTorchJob, ModelRegistry<br/>+ 10 more component types"]
            NSResources["Namespace Resources<br/>Pods, Logs, Events<br/>Deployments, Services"]
            HelmSecrets["Helm Secrets<br/>Release values & manifests"]
        end
    end

    subgraph Output["DATA OUTPUT"]
        FS["/must-gather/<br/>Local Filesystem<br/>YAML/JSON + Pod Logs<br/>Packaged as tar archive"]
    end

    %% Flows
    Admin -->|"oc adm must-gather --image=...<br/>or kubectl apply Job"| MustGather
    OC -->|"HTTPS/443<br/>TLS 1.2+<br/>cluster-admin SA token"| K8sAPI
    Kubectl -->|"HTTPS/443<br/>TLS 1.2+<br/>must-gather-reader SA token"| K8sAPI
    Helm -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    MustGather -->|"write"| FS
    FS -->|"tar archive<br/>(oc rsync / kubectl cp)"| Admin

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef output fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tools fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Admin external
    class MustGather,Gather,Common,XksUtil cluster
    class K8sAPI apiserver
    class FS output
    class OC,Kubectl,Helm tools
    class Platform,Components,NSResources,HelmSecrets apiserver
