graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
        SAClient["K8s SA Client<br/>(Machine-to-Machine)"]
        EnvoyExt["Envoy Proxy<br/>(ext_authz caller)"]
    end

    subgraph PodBoundary["SIDECAR (Pod-Local Trust Boundary)"]
        direction TB

        KAP["kube-auth-proxy<br/>Ports: 4180/TCP (HTTP), 443/TCP (HTTPS)<br/>FIPS: strictfipsruntime + CGO<br/>Image: UBI9 ubi-minimal (SHA256-pinned)"]

        UpstreamApp["Upstream Application<br/>Receives: X-Forwarded-User,<br/>X-Forwarded-Email, X-Forwarded-Groups"]
    end

    subgraph ClusterInternal["CLUSTER-INTERNAL (Kubernetes)"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]

        OSAuth["OpenShift OAuth Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Client Credentials"]

        OSAPI["OpenShift API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]

        Redis["Redis (Optional)<br/>6379/TCP<br/>TCP/TLS<br/>Password / mTLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OIDCIdP["OIDC Identity Provider<br/>(Keycloak, Azure AD, etc.)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Client Credentials + PKCE"]
    end

    %% Inbound flows
    Browser -->|"HTTPS/443 or HTTP/4180<br/>TLS 1.2+<br/>Session Cookie"| KAP
    SAClient -->|"HTTPS/443 or HTTP/4180<br/>TLS 1.2+<br/>Bearer SA Token"| KAP
    EnvoyExt -->|"HTTP(S)/4180 or 443<br/>TLS 1.2+<br/>Cookie/Bearer (forwarded)"| KAP

    %% Pod-internal
    KAP -->|"HTTP/HTTPS/Unix<br/>Configurable<br/>No Auth (pod-local)"| UpstreamApp

    %% Cluster-internal egress
    KAP -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>POST tokenreviews"| K8sAPI
    KAP -->|"HTTPS/443<br/>TLS 1.2+<br/>Client Credentials<br/>OAuth code flow"| OSAuth
    KAP -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>User/Token APIs"| OSAPI
    KAP -->|"TCP(TLS)/6379<br/>Optional TLS<br/>Password/mTLS<br/>Session storage"| Redis

    %% External egress
    KAP -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC Discovery + PKCE<br/>Token exchange"| OIDCIdP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef podBoundary fill:#e3f2fd,stroke:#1565c0,stroke-width:3px
    classDef proxy fill:#42a5f5,stroke:#1565c0,stroke-width:2px,color:#fff
    classDef upstream fill:#c8e6c9,stroke:#388e3c,stroke-width:2px
    classDef clusterInternal fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef externalService fill:#fff8e1,stroke:#f9a825,stroke-width:2px

    class Browser,SAClient,EnvoyExt external
    class KAP proxy
    class UpstreamApp upstream
    class K8sAPI,OSAuth,OSAPI,Redis clusterInternal
    class OIDCIdP externalService
