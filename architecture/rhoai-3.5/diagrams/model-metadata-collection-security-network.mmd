graph TB
    subgraph BuildEnv["BUILD ENVIRONMENT (CI/CD Pipeline)"]
        direction TB
        CLI["model-extractor CLI<br/>Go (CGO_ENABLED=0)<br/>5 concurrent goroutines<br/>Exponential backoff retry"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (All 443/TCP HTTPS TLS 1.2+)"]
        direction TB

        subgraph HF_Zone["HuggingFace"]
            HF["huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        end

        subgraph GH_Zone["GitHub"]
            GH_API["api.github.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
            GH_Raw["raw.githubusercontent.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        end

        subgraph Registry_Zone["OCI Registry"]
            Registry["registry.redhat.io<br/>443/TCP HTTPS<br/>Docker Registry v2<br/>TLS 1.2+<br/>Docker credentials (required)"]
        end
    end

    subgraph ShippedArtifact["SHIPPED ARTIFACT (Zero Network Exposure)"]
        direction TB
        DataContainer["Data Container<br/>ubi9-minimal<br/>CMD: sleep infinity<br/>No Go binaries<br/>No listening ports"]

        subgraph Catalogs["Static YAML Catalogs"]
            MC["models-catalog.yaml"]
            VMC["validated-models-catalog.yaml"]
            MCP["mcp-servers-catalog.yaml"]
            AC["agents-catalog.yaml"]
            BD["sample-data/ (benchmarks)"]
        end
    end

    subgraph Consumers["INTERNAL CONSUMERS (File-Based)"]
        Dashboard["RHOAI Dashboard<br/>Volume mount"]
        ModelReg["Model Registry<br/>MetadataStringValue format"]
    end

    %% Build-time egress flows
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN (opt)<br/>Collections + Models + README"| HF
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer GITHUB_TOKEN (opt)<br/>Branch validation"| GH_API
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer GITHUB_TOKEN (opt)<br/>agent.yaml + README"| GH_Raw
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>Docker creds (required)<br/>Manifests + Blobs + Layers"| Registry

    %% Pipeline output
    CLI -->|"generates"| Catalogs

    %% Packaging
    Catalogs -->|"COPY into image"| DataContainer

    %% Consumer access (file-based, no network)
    DataContainer -->|"volume mount<br/>(no network)"| Dashboard
    DataContainer -->|"catalog data<br/>(no network)"| ModelReg

    %% Styling
    classDef buildenv fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef registry fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef shipped fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef catalog fill:#e8f5e9,stroke:#82b366,stroke-width:1px
    classDef consumer fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class CLI buildenv
    class HF,GH_API,GH_Raw external
    class Registry registry
    class DataContainer shipped
    class MC,VMC,MCP,AC,BD catalog
    class Dashboard,ModelReg consumer
