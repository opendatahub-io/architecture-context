graph LR
    KubeRBACProxy["kube-rbac-proxy<br/>(Sidecar Proxy)"]

    %% External Dependencies (required)
    KubeRBACProxy -->|"TokenReview +<br/>SubjectAccessReview<br/>HTTPS/443"| K8sAPI["Kubernetes API Server<br/>v1.35+"]
    KubeRBACProxy -->|"authn/authz framework"| K8sAPIServer["k8s.io/apiserver<br/>v0.35.2"]
    KubeRBACProxy -->|"API client"| K8sClientGo["k8s.io/client-go<br/>v0.35.2"]
    KubeRBACProxy -->|"HTTP/2 support"| GoNet["golang.org/x/net<br/>v0.52.0"]
    KubeRBACProxy -->|"OIDC validation"| GoOIDC["go-oidc<br/>v2.3.0"]
    KubeRBACProxy -->|"CLI framework"| Cobra["spf13/cobra<br/>v1.10.2"]
    KubeRBACProxy -->|"goroutine lifecycle"| OklogRun["oklog/run<br/>v1.2.0"]

    %% Internal Platform Dependencies
    RhodsOperator["rhods-operator"] -->|"injects sidecar<br/>+ TLS certs<br/>+ auth config"| KubeRBACProxy
    KubeRBACProxy -->|"reverse proxy<br/>HTTP/HTTPS/h2c"| UpstreamService["Component Upstream<br/>(TrustyAI, Model Registry,<br/>notebook controller, etc.)"]
    Prometheus["OpenShift Monitoring<br/>(prometheus-k8s)"] -->|"scrapes /metrics<br/>HTTPS/8443<br/>hardcoded allow"| KubeRBACProxy

    %% Conditional External
    KubeRBACProxy -.->|"OIDC discovery<br/>+ JWKS<br/>HTTPS/443<br/>(when --oidc-issuer set)"| OIDCProvider["OIDC Identity Provider"]
    CertManager["cert-manager /<br/>Platform TLS"] -.->|"provisions TLS<br/>serving certs"| KubeRBACProxy

