graph TB
    subgraph ClientSide["CLIENT-SIDE (User Environment)"]
        SDK["CodeFlare SDK<br/>Python Client Library<br/>Auth: kube-authkit<br/>(OIDC / OAuth / kubeconfig)"]
        LocalTLS["Local TLS Store<br/>~/.local/share/codeflare/tls/<br/>RSA 3072 + SHA-256<br/>Permissions: 0600"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC AuthZ"]

        subgraph CRDs["CRD Operations"]
            RayClusterCR["ray.io/v1<br/>RayCluster<br/>get,list,create,delete,patch"]
            RayJobCR["ray.io/v1<br/>RayJob<br/>get,list,create,delete,patch"]
            KueueCRs["kueue.x-k8s.io/v1beta1<br/>LocalQueue, Workload,<br/>WorkloadPriorityClass<br/>list, get"]
            GatewayCRs["gateway.networking.k8s.io/v1<br/>HTTPRoute, Gateway<br/>list, get"]
            Secrets["core/v1 Secrets<br/>list, get, create, replace"]
        end
    end

    subgraph ClusterNetwork["SERVICE MESH / CLUSTER NETWORK"]
        subgraph UserNS["Namespace: {user-namespace}"]
            RayHead["Ray Head Service<br/>{cluster}-head-svc<br/>ClusterIP"]
            GCS["GCS Port 6379/TCP<br/>mTLS<br/>TLS client cert"]
            Dashboard["Dashboard Port 8265/TCP<br/>mTLS<br/>Bearer Token"]
            ClientPort["Client Port 10001/TCP<br/>mTLS<br/>TLS client cert"]
        end
    end

    subgraph IngressLayer["INGRESS (Dashboard Access)"]
        direction TB
        HTTPRoute["HTTPRoute<br/>(RHOAI v3.0+ Gateway API)<br/>ray.io/cluster-name label"]
        OSRoute["OpenShift Route<br/>(Legacy RHOAI 2.x)<br/>ray-dashboard-{cluster}"]
        DashEndpoint["Dashboard Endpoint<br/>https://{hostname}/ray/{ns}/{name}<br/>443/TCP TLS 1.2+<br/>Bearer Token"]
    end

    subgraph Operators["PLATFORM OPERATORS"]
        KubeRay["KubeRay Operator<br/>Reconciles RayCluster/RayJob CRs"]
        Kueue["Kueue Controller<br/>Batch job queuing<br/>& resource quotas"]
    end

    %% SDK connections
    SDK -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer/OIDC/mTLS"| K8sAPI
    SDK ---|"cert gen"| LocalTLS
    SDK -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| DashEndpoint
    SDK -->|"Ray gRPC/10001<br/>mTLS<br/>TLS client cert"| ClientPort
    SDK -->|"HTTP/8265<br/>mTLS<br/>Bearer Token"| Dashboard
    SDK -->|"TCP/6379<br/>mTLS<br/>TLS client cert"| GCS

    %% API Server to CRDs
    K8sAPI --- RayClusterCR
    K8sAPI --- RayJobCR
    K8sAPI --- KueueCRs
    K8sAPI --- GatewayCRs
    K8sAPI --- Secrets

    %% Operator reconciliation
    KubeRay -->|"reconciles"| RayClusterCR
    KubeRay -->|"reconciles"| RayJobCR
    KubeRay -->|"deploys"| RayHead
    Kueue -->|"manages quotas"| RayClusterCR

    %% Ray Head ports
    RayHead --- GCS
    RayHead --- Dashboard
    RayHead --- ClientPort

    %% Ingress resolution
    HTTPRoute -->|"resolves to"| DashEndpoint
    OSRoute -->|"resolves to"| DashEndpoint

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef controlplane fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef servicemesh fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef ingress fill:#fce4ec,stroke:#c62828,stroke-width:2px
    classDef operator fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef crd fill:#fff8e1,stroke:#f9a825,stroke-width:1px

    class SDK,LocalTLS client
    class K8sAPI controlplane
    class RayHead,GCS,Dashboard,ClientPort servicemesh
    class HTTPRoute,OSRoute,DashEndpoint ingress
    class KubeRay,Kueue operator
    class RayClusterCR,RayJobCR,KueueCRs,GatewayCRs,Secrets crd
