graph LR
    LMEval["LMEval Job<br/>(lm-evaluation-harness)"]

    %% Core ML Dependencies
    LMEval -->|"tensor computation<br/>inference"| PyTorch["PyTorch 2.6.0"]
    LMEval -->|"model loading<br/>tokenization"| Transformers["HF Transformers 4.48.0"]
    LMEval -->|"multi-GPU<br/>parallelism"| Accelerate["HF Accelerate 1.0.1"]
    LMEval -->|"dataset loading<br/>& caching"| Datasets["HF Datasets 3.1.0"]
    LMEval -->|"metric<br/>computation"| Evaluate["HF Evaluate 0.4.3"]
    LMEval -->|"adapter<br/>loading"| PEFT["PEFT 0.13.2"]

    %% Evaluation Framework Dependencies
    LMEval -->|"custom task/<br/>metric defs"| Unitxt["Unitxt 1.17.2"]

    %% Platform Integration Dependencies
    LMEval -->|"job spec parsing<br/>lifecycle callbacks"| EvalHubSDK["eval-hub-sdk 0.4.4"]
    LMEval -->|"OCI artifact<br/>creation"| olot["olot 0.1.15"]
    LMEval -->|"artifact transport<br/>to registries"| skopeo["skopeo (system)"]

    %% Cloud/Storage Dependencies
    LMEval -->|"S3/COS<br/>access"| boto3["boto3 1.42.12"]
    LMEval -.->|"watsonx.ai<br/>(optional)"| watsonx["ibm-watsonx-ai 1.4.11"]

    %% Internal RHOAI Platform Dependencies
    TrustyAI["TrustyAI Operator"] -->|"creates Job from<br/>LMEvalJob CR"| LMEval
    LMEval -->|"status callbacks<br/>& results"| EvalHub["EvalHub Service"]
    LMEval -->|"prompts →<br/>completions"| ModelEndpoint["Model Serving<br/>Endpoint"]

    %% External Service Dependencies
    LMEval -->|"tokenizers &<br/>datasets"| HFHub["HuggingFace Hub"]
    LMEval -->|"result artifacts"| OCIRegistry["OCI Registry"]
    LMEval -.->|"experiment<br/>tracking"| MLflow["MLflow (optional)"]

    %% Styling
    style LMEval fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core ML - blue tones
    style PyTorch fill:#5b9bd5,stroke:#333,color:#fff
    style Transformers fill:#5b9bd5,stroke:#333,color:#fff
    style Accelerate fill:#5b9bd5,stroke:#333,color:#fff
    style Datasets fill:#5b9bd5,stroke:#333,color:#fff
    style Evaluate fill:#5b9bd5,stroke:#333,color:#fff
    style PEFT fill:#5b9bd5,stroke:#333,color:#fff
    style Unitxt fill:#5b9bd5,stroke:#333,color:#fff

    %% Platform SDK
    style EvalHubSDK fill:#7ed321,stroke:#333,color:#fff
    style olot fill:#7ed321,stroke:#333,color:#fff
    style skopeo fill:#7ed321,stroke:#333,color:#fff

    %% Cloud/optional
    style boto3 fill:#999,stroke:#333,color:#fff
    style watsonx fill:#999,stroke:#333,color:#fff,stroke-dasharray: 5 5

    %% Internal RHOAI
    style TrustyAI fill:#7ed321,stroke:#333,color:#fff
    style EvalHub fill:#7ed321,stroke:#333,color:#fff
    style ModelEndpoint fill:#f5a623,stroke:#333,color:#fff

    %% External services
    style HFHub fill:#f5a623,stroke:#333,color:#fff
    style OCIRegistry fill:#f5a623,stroke:#333,color:#fff
    style MLflow fill:#999,stroke:#333,color:#fff,stroke-dasharray: 5 5
