graph TB
    subgraph SDK["Kubeflow SDK (Python Client Library)"]
        direction TB

        subgraph Trainer["kubeflow.trainer"]
            TrainerClient[TrainerClient<br/>Training job lifecycle]
            KubeBackend[KubernetesBackend<br/>TrainJob CR management]
            ContainerBackend[ContainerBackend<br/>Docker/Podman local]
            LocalBackend[LocalProcessBackend<br/>Subprocess prototyping]
            TrainerClient --> KubeBackend
            TrainerClient --> ContainerBackend
            TrainerClient --> LocalBackend
        end

        subgraph RHAI["kubeflow.trainer.rhai"]
            THTrainer[TrainingHubTrainer<br/>SFT / OSFT / LoRA SFT / LoRA GRPO]
            TransTrainer[TransformersTrainer<br/>HuggingFace integration<br/>JIT checkpointing]
            Algorithms[Algorithm Registry<br/>Metrics schemas & validation]
            THTrainer --> Algorithms
            TransTrainer --> Algorithms
        end

        subgraph Optimizer["kubeflow.optimizer"]
            OptimizerClient[OptimizerClient<br/>Katib Experiment management]
        end

        subgraph Spark["kubeflow.spark"]
            SparkClient[SparkClient<br/>SparkConnectServer management]
        end

        subgraph Hub["kubeflow.hub"]
            HubClient[ModelRegistryClient<br/>Model artifact CRUD]
        end

        subgraph Common["kubeflow.common"]
            Utils[Utils<br/>Namespace detection]
            Logging[Structured Logging<br/>structlog JSON]
        end

        THTrainer -->|extends| TrainerClient
        TransTrainer -->|extends| TrainerClient
    end

    User[Data Scientist / ML Engineer] -->|Python API calls| TrainerClient
    User -->|Python API calls| OptimizerClient
    User -->|Python API calls| SparkClient
    User -->|Python API calls| HubClient

    KubeBackend -->|creates| TrainJobCR[TrainJob CR<br/>trainer.kubeflow.org/v1alpha1]
    KubeBackend -->|reads| RuntimeCR[TrainingRuntime /<br/>ClusterTrainingRuntime CR]
    OptimizerClient -->|creates| ExperimentCR[Experiment CR<br/>Katib]
    SparkClient -->|creates| SparkCR[SparkConnectServer CR]

    TrainJobCR -->|reconciled by| TrainerOperator[Kubeflow Trainer Operator]
    ExperimentCR -->|reconciled by| KatibController[Katib Controller]
    SparkCR -->|reconciled by| SparkOperator[Spark Operator]
    HubClient -->|REST API| ModelRegistry[Model Registry Server]

    TransTrainer -->|checkpoint upload| S3[S3 Storage]
    THTrainer -->|injects metrics server<br/>port 28080| TrainingPod[Training Pod]

