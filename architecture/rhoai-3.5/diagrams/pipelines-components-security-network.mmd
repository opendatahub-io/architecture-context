graph TB
    subgraph ClusterInternal["CLUSTER-INTERNAL (Kubernetes RBAC)"]
        direction TB

        subgraph OperatorNS["Namespace: {operator-namespace}"]
            DSPOperator["data-science-pipelines-operator<br/>Deploys DSPA pods"]
        end

        subgraph DSPANS["Namespace: {dspa-namespace}"]
            InitContainer["odh-pipelines-components<br/>Init Container<br/>UBI9 Python 3.12<br/>No network services"]
            SharedPVC["Shared PVC<br/>/config/managed-pipelines/"]
            KFPServer["KFP API Server<br/>Reads pipeline manifests"]
            InitContainer -->|"Filesystem<br/>write YAML"| SharedPVC
            SharedPVC -->|"Filesystem<br/>read manifests"| KFPServer
        end

        subgraph PipelineNS["Namespace: {pipeline-namespace} — KFP Batch Tasks"]
            AutoML["odh-automl<br/>AIPCC CPU Base<br/>AutoGluon 1.5.0+rhaiv.5<br/>Batch job (terminates)"]
            AutoRAG["odh-autorag<br/>AIPCC CPU Base<br/>ai4rag + docling<br/>Embedded ML models<br/>Batch job (terminates)"]
            KFPTasks["KFP Pipeline Tasks<br/>SA: KFP pipeline SA"]
        end
    end

    subgraph InternalSvcs["CLUSTER-INTERNAL SERVICES"]
        Milvus["Milvus<br/>19530/TCP gRPC<br/>Plaintext<br/>Token (optional)"]
        KServe["KServe InferenceService<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        ModelReg["Model Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        EvalHub["EvalHub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Bearer Token"]
        ConnectionsAPI["RHOAI Connections API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph ExternalSvcs["EXTERNAL SERVICES"]
        S3["S3 / MinIO<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS Signature V4"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        OGXAPI["OGX API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        LiteLLM["LiteLLM / LLM API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        RHAIPyPI["RHEL AI PyPI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>None (build-time)"]
    end

    %% Operator flow
    DSPOperator -->|"RELATED_IMAGE_*<br/>init container ref"| InitContainer

    %% Pipeline task egress to internal services
    KFPTasks -->|"gRPC/19530<br/>Plaintext"| Milvus
    KFPTasks -->|"HTTPS/443<br/>Bearer Token"| KServe
    KFPTasks -->|"HTTPS/443<br/>Bearer Token"| ModelReg
    KFPTasks -->|"HTTPS/443<br/>Bearer Token"| EvalHub
    KFPTasks -->|"HTTPS/6443<br/>SA Token"| K8sAPI
    KFPTasks -->|"HTTPS/443<br/>Bearer Token"| ConnectionsAPI

    %% Pipeline task egress to external services
    AutoML -->|"HTTPS/443<br/>AWS IAM"| S3
    AutoRAG -->|"HTTPS/443<br/>AWS IAM"| S3
    AutoRAG -->|"HTTPS/443<br/>API Key"| OGXAPI
    KFPTasks -->|"HTTPS/443<br/>Bearer Token"| HFHub
    KFPTasks -->|"HTTPS/443<br/>API Key"| LiteLLM

    %% Styling
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internalsvc fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef storage fill:#f5a623,stroke:#d79b00,stroke-width:2px

    class DSPOperator operator
    class InitContainer,AutoML,AutoRAG,KFPTasks cluster
    class KFPServer cluster
    class Milvus,KServe,ModelReg,EvalHub,K8sAPI,ConnectionsAPI internalsvc
    class S3,HFHub,OGXAPI,LiteLLM,RHAIPyPI externalsvc
    class SharedPVC storage
