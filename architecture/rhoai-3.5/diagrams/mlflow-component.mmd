graph TB
    subgraph MLflow["MLflow Server (rhoai-3.5)"]
        direction TB

        subgraph ASGI["ASGI Layer (FastAPI + uvicorn)"]
            FastAPI["FastAPI App<br/>uvicorn 0.46.0"]
            AIGateway["AI Gateway Router<br/>LLM proxy, rate limiting,<br/>budget policies, guardrails"]
            MCPRegistry["MCP Server Registry<br/>Model Context Protocol<br/>server management"]
            JobsRouter["Jobs Router<br/>Background job execution"]
            AssistantRouter["Assistant Router"]
        end

        subgraph WSGI["WSGI Layer (Flask via EfficientWSGIMiddleware)"]
            FlaskApp["Flask App<br/>3.1.3"]
            TrackingAPI["Tracking API<br/>/ajax-api/2.0/mlflow/experiments/*<br/>/ajax-api/2.0/mlflow/runs/*"]
            RegistryAPI["Model Registry API<br/>/ajax-api/2.0/mlflow/registered-models/*<br/>/ajax-api/2.0/mlflow/model-versions/*"]
            WorkspaceAPI["Workspace API<br/>/api/3.0/mlflow/workspaces"]
            GraphQL["GraphQL Endpoint<br/>/graphql"]
        end

        subgraph Auth["Authentication Middleware"]
            AuthMiddleware["Auth Middleware<br/>(Flask before_request)"]
            BasicAuth["basic-auth plugin<br/>Username/Password"]
            K8sAuth["kubernetes-auth plugin<br/>SA Token + Namespace Header"]
        end

        subgraph Storage["Storage Layer"]
            SQLAlchemy["SQLAlchemy 2.0.49<br/>ORM + Query Filters"]
            ArtifactProxy["Artifact Proxy<br/>Upload/Download"]
            CryptoEngine["Crypto Engine<br/>AESGCM Envelope Encryption<br/>PBKDF2 (600k iterations)"]
        end

        subgraph UI["Frontend"]
            ReactUI["MLflow UI<br/>React + TypeScript<br/>PatternFly CSS"]
            ModFed["Module Federation<br/>Embedded in RHOAI Dashboard"]
        end
    end

    %% External Users
    Client["ML Client SDK<br/>(in-cluster pod)"] -->|"HTTP 5000/TCP<br/>kubernetes-auth"| FastAPI
    DataScientist["Data Scientist"] -->|"Browser HTTPS"| ReactUI

    %% Internal routing
    FastAPI -->|wraps| FlaskApp
    FastAPI --> AIGateway
    FastAPI --> MCPRegistry
    FastAPI --> JobsRouter
    FlaskApp --> TrackingAPI
    FlaskApp --> RegistryAPI
    FlaskApp --> WorkspaceAPI
    FlaskApp --> GraphQL
    AuthMiddleware -->|selects| BasicAuth
    AuthMiddleware -->|selects| K8sAuth
    TrackingAPI --> AuthMiddleware
    RegistryAPI --> AuthMiddleware
    WorkspaceAPI --> AuthMiddleware
    TrackingAPI --> SQLAlchemy
    RegistryAPI --> SQLAlchemy
    AIGateway --> CryptoEngine

    %% External dependencies
    SQLAlchemy -->|"5432/TCP<br/>PostgreSQL"| PostgreSQL[(PostgreSQL 13+)]
    ArtifactProxy -->|"443/TCP HTTPS<br/>AWS IAM"| S3["S3 / MinIO"]
    K8sAuth -->|"6443/TCP HTTPS<br/>SA Token"| K8sAPI["Kubernetes API"]
    AIGateway -->|"443/TCP HTTPS<br/>API Key"| LLMProviders["LLM Providers<br/>(OpenAI, Anthropic,<br/>Bedrock, Gemini)"]

    %% Platform integration
    Operator["rhods-operator"] -->|"Helm deploy"| MLflow
    Dashboard["RHOAI Dashboard"] -->|"Module Federation"| ModFed
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>5000/TCP"| FastAPI

    %% Styling
    style FastAPI fill:#4a90e2,stroke:#333,color:#fff
    style FlaskApp fill:#4a90e2,stroke:#333,color:#fff
    style AIGateway fill:#4a90e2,stroke:#333,color:#fff
    style MCPRegistry fill:#4a90e2,stroke:#333,color:#fff
    style AuthMiddleware fill:#f5a623,stroke:#333,color:#fff
    style K8sAuth fill:#f5a623,stroke:#333
    style BasicAuth fill:#f5a623,stroke:#333
    style SQLAlchemy fill:#7ed321,stroke:#333
    style CryptoEngine fill:#d0021b,stroke:#333,color:#fff
    style ReactUI fill:#9013fe,stroke:#333,color:#fff
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style LLMProviders fill:#e8e8e8,stroke:#333
    style Operator fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
