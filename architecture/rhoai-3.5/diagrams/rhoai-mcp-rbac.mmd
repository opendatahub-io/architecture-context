graph TD
    subgraph SA["Service Account"]
        ServiceAccount["rhoai-mcp<br/>Namespace: redhat-ods-applications"]
    end

    subgraph CRB["ClusterRoleBinding"]
        Binding["rhoai-mcp"]
    end

    subgraph CR["ClusterRole: rhoai-mcp"]
        direction TB
        BaseRole["Base Permissions"]
        OSPatch["OpenShift Patch"]
    end

    subgraph CoreResources["Core API Resources ('')"]
        Pods["pods, pods/log<br/>get, list, watch, create"]
        Services_R["services<br/>get, list, watch"]
        Events["events<br/>get, list, watch"]
        Nodes["nodes<br/>get, list, watch"]
        Namespaces["namespaces<br/>get, list, watch, create, patch, delete"]
        Secrets["secrets<br/>get, list, watch, create, delete"]
        PVCs["persistentvolumeclaims<br/>get, list, watch, create, delete"]
        PVs["persistentvolumes<br/>create"]
    end

    subgraph KubeflowResources["Kubeflow Resources"]
        Notebooks["kubeflow.org<br/>notebooks<br/>get, list, watch, create, patch, delete"]
        TrainJobs["trainer.kubeflow.org<br/>trainjobs<br/>get, list, watch, create, update, patch, delete"]
        TrainingRuntimes["trainer.kubeflow.org<br/>trainingruntimes<br/>get, list, watch"]
        ClusterTrainingRuntimes["trainer.kubeflow.org<br/>clustertrainingruntimes<br/>get, list, watch, create, delete"]
    end

    subgraph ServingResources["Serving Resources"]
        InferenceServices["serving.kserve.io<br/>inferenceservices<br/>get, list, watch, create, delete"]
        ServingRuntimes["serving.kserve.io<br/>servingruntimes<br/>get, list, watch, create"]
    end

    subgraph PipelineResources["Pipeline Resources"]
        DSPA["datasciencepipelinesapplications<br/>.opendatahub.io<br/>datasciencepipelinesapplications<br/>get, list, watch, create, delete"]
    end

    subgraph AppsResources["Apps Resources"]
        Deployments["apps<br/>deployments<br/>create"]
    end

    subgraph StorageResources["Storage Resources"]
        StorageClasses["storage.k8s.io<br/>storageclasses<br/>list"]
    end

    subgraph OpenShiftResources["OpenShift Resources (Patch)"]
        DSClusters["datasciencecluster.opendatahub.io<br/>datascienceclusters<br/>get, list, watch"]
        ModelRegistries["components.platform.opendatahub.io<br/>modelregistries<br/>get, list, watch"]
        Templates["template.openshift.io<br/>templates<br/>get, list, watch"]
        Routes["route.openshift.io<br/>routes<br/>get, list, watch"]
        Projects["project.openshift.io<br/>projects<br/>get, list, watch, patch"]
        ImageStreams["image.openshift.io<br/>imagestreams<br/>list"]
    end

    subgraph MultiUser["Multi-User (OIDC Enabled)"]
        Impersonation["K8s User Impersonation<br/>Impersonate-User / Impersonate-Group"]
        SAR["SubjectAccessReview<br/>per-tool permission check"]
        ToolFiltering["MCP Tool Filtering<br/>hide unauthorized tools"]
    end

    %% Bindings
    ServiceAccount -->|"bound via"| Binding
    Binding -->|"grants"| CR

    %% Base role grants
    BaseRole -->|"core"| CoreResources
    BaseRole -->|"kubeflow"| KubeflowResources
    BaseRole -->|"serving"| ServingResources
    BaseRole -->|"pipelines"| PipelineResources
    BaseRole -->|"apps"| AppsResources
    BaseRole -->|"storage"| StorageResources

    %% OpenShift patch grants
    OSPatch -->|"openshift"| OpenShiftResources

    %% Multi-user flow
    ServiceAccount -.->|"OIDC enabled"| Impersonation
    Impersonation -->|"checks"| SAR
    SAR -->|"filters"| ToolFiltering

    %% Styling
    style ServiceAccount fill:#4a90e2,color:#fff
    style Binding fill:#6c8ebf,color:#fff
    style BaseRole fill:#f5a623,color:#fff
    style OSPatch fill:#e8a020,color:#fff

    style Pods fill:#d5e8d4,stroke:#82b366
    style Services_R fill:#d5e8d4,stroke:#82b366
    style Events fill:#d5e8d4,stroke:#82b366
    style Nodes fill:#d5e8d4,stroke:#82b366
    style Namespaces fill:#d5e8d4,stroke:#82b366
    style Secrets fill:#d5e8d4,stroke:#82b366
    style PVCs fill:#d5e8d4,stroke:#82b366
    style PVs fill:#d5e8d4,stroke:#82b366

    style Notebooks fill:#dae8fc,stroke:#6c8ebf
    style TrainJobs fill:#dae8fc,stroke:#6c8ebf
    style TrainingRuntimes fill:#dae8fc,stroke:#6c8ebf
    style ClusterTrainingRuntimes fill:#dae8fc,stroke:#6c8ebf

    style InferenceServices fill:#e1d5e7,stroke:#9673a6
    style ServingRuntimes fill:#e1d5e7,stroke:#9673a6

    style DSPA fill:#fff2cc,stroke:#d6b656

    style Deployments fill:#f8cecc,stroke:#b85450

    style StorageClasses fill:#f5f5f5,stroke:#999

    style DSClusters fill:#ffe6cc,stroke:#d79b00
    style ModelRegistries fill:#ffe6cc,stroke:#d79b00
    style Templates fill:#ffe6cc,stroke:#d79b00
    style Routes fill:#ffe6cc,stroke:#d79b00
    style Projects fill:#ffe6cc,stroke:#d79b00
    style ImageStreams fill:#ffe6cc,stroke:#d79b00

    style Impersonation fill:#4a90e2,color:#fff
    style SAR fill:#4a90e2,color:#fff
    style ToolFiltering fill:#4a90e2,color:#fff
