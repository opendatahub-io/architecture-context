graph TB
    subgraph "rhods-operator (Platform Operator)"
        direction TB

        subgraph "Core Controllers"
            DSCCtrl["DSC Controller<br/>DAG-based runlevel<br/>component orchestration"]
            DSCICtrl["DSCI Controller<br/>Platform initialization:<br/>namespaces, auth, gateway,<br/>hardware profiles"]
        end

        subgraph "Service Controllers"
            GatewayCtrl["Gateway Controller<br/>Deploys ingress stack:<br/>Gateway API, kube-auth-proxy,<br/>EnvoyFilter, Routes"]
            AuthCtrl["Auth Controller<br/>RBAC roles/bindings<br/>for admin/allowed groups"]
            MonitoringCtrl["Monitoring Controller<br/>MonitoringStack, OTEL,<br/>Perses, Tempo, Thanos"]
            ModulesCtrl["Modules Controller<br/>Plugin framework for<br/>out-of-tree operators"]
        end

        subgraph "Component Controllers (x18)"
            DashboardCC["Dashboard"]
            KServeCC["KServe"]
            KueueCC["Kueue"]
            DSPCC["DataSciencePipelines"]
            ModelRegCC["ModelRegistry"]
            WorkbenchCC["Workbenches"]
            RayCC["Ray"]
            TrustyCC["TrustyAI"]
            TrainOpCC["TrainingOperator"]
            TrainerCC["Trainer"]
            FeastCC["FeastOperator"]
            OGXCC["OGX"]
            SparkCC["SparkOperator"]
            ModelCtrlCC["ModelController"]
            MaaSCC["ModelsAsService"]
        end

        subgraph "Webhooks (x8)"
            MutWebhook["Mutating Webhooks<br/>DSC defaults, HardwareProfile<br/>injection, Monitoring labels"]
            ValWebhook["Validating Webhooks<br/>Singleton enforcement,<br/>Notebook connections,<br/>DSC/DSCI validation"]
            ConvWebhook["Conversion Webhooks<br/>v1 ↔ v2 for DSC,<br/>DSCI, HardwareProfile"]
        end
    end

    subgraph "CloudManager (Separate Binary)"
        CMCtrl["CloudManager Controllers<br/>(AWS, Azure, CoreWeave)"]
    end

    %% CRDs
    DSCCR["DataScienceCluster CR<br/>(v1/v2, Cluster-scoped)"]
    DSCICR["DSCInitialization CR<br/>(v1/v2, Cluster-scoped)"]
    ComponentCRs["Component CRs<br/>(18 types, v1alpha1)"]
    ServiceCRs["Service CRs<br/>(Auth, GatewayConfig,<br/>Monitoring)"]
    HwProfile["HardwareProfile CR<br/>(v1, Namespaced)"]
    PlatformCR["Platform CR<br/>(xKS deployments)"]

    %% External
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OSApi["OpenShift API<br/>Routes, OAuth, Config"]

    %% Flows
    DSCCR -->|"watched by"| DSCCtrl
    DSCICR -->|"watched by"| DSCICtrl
    DSCCtrl -->|"creates"| ComponentCRs
    ComponentCRs -->|"watched by"| DashboardCC
    ComponentCRs -->|"watched by"| KServeCC
    ComponentCRs -->|"watched by"| KueueCC
    ComponentCRs -->|"watched by"| DSPCC
    ComponentCRs -->|"watched by"| ModelRegCC

    DSCICtrl -->|"creates"| ServiceCRs
    ServiceCRs -->|"watched by"| GatewayCtrl
    ServiceCRs -->|"watched by"| AuthCtrl
    ServiceCRs -->|"watched by"| MonitoringCtrl

    ModulesCtrl -->|"deploys"| AIGatewayMod["AIGateway<br/>(Helm)"]
    ModulesCtrl -->|"deploys"| KServeMod["KServe Module<br/>(Helm)"]
    ModulesCtrl -->|"deploys"| MLflowMod["MLflow<br/>(Helm)"]
    ModulesCtrl -->|"deploys"| MCPMod["MCPLifecycle<br/>(Kustomize)"]

    PlatformCR -->|"watched by (xKS)"| CMCtrl

    DSCCtrl -->|"SSA apply"| K8sAPI
    GatewayCtrl -->|"creates Routes, EnvoyFilters"| OSApi

    %% Styling
    style DSCCtrl fill:#4a90e2,color:#fff
    style DSCICtrl fill:#4a90e2,color:#fff
    style GatewayCtrl fill:#e67e22,color:#fff
    style AuthCtrl fill:#e67e22,color:#fff
    style MonitoringCtrl fill:#e67e22,color:#fff
    style ModulesCtrl fill:#e67e22,color:#fff
    style MutWebhook fill:#9b59b6,color:#fff
    style ValWebhook fill:#9b59b6,color:#fff
    style ConvWebhook fill:#9b59b6,color:#fff
    style CMCtrl fill:#2ecc71,color:#fff
    style DSCCR fill:#f5a623
    style DSCICR fill:#f5a623
    style ComponentCRs fill:#f5a623
    style ServiceCRs fill:#f5a623
    style HwProfile fill:#f5a623
    style PlatformCR fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style OSApi fill:#e8e8e8
