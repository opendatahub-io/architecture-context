graph LR
    GD["Guardrails<br/>Detectors"]

    %% Internal Platform Dependencies
    GD -->|"consumer API<br/>8080/8000 TCP"| Orchestrator["FMS Guardrails<br/>Orchestrator"]
    GD -->|"deployed as<br/>InferenceService"| KServe["KServe"]
    GD -->|"sidecar injection<br/>mTLS STRICT"| Istio["Istio Service Mesh"]
    GD -->|"model storage<br/>9000/TCP"| S3["S3/MinIO<br/>Object Storage"]

    %% External Service Dependencies
    GD -->|"LLM evaluation<br/>HTTP"| vLLM["vLLM Inference<br/>Server"]

    %% Integration Points (consumers of GD)
    Dashboard["RHOAI Dashboard"] -.->|"label integration<br/>opendatahub.io/dashboard"| GD
    Prometheus["Prometheus"] -.->|"scrapes /metrics<br/>8080/8000 TCP"| GD

    %% Core Python Dependencies
    subgraph CoreDeps["Core Dependencies (all detectors)"]
        FastAPI["fastapi 0.136.3"]
        Uvicorn["uvicorn 0.34.0"]
        PromClient["prometheus-client<br/>>=0.18.0"]
        HTTPX["httpx 0.28.1"]
        PyYAML["PyYAML 6.0.3"]
    end

    subgraph BuiltInDeps["Built-in Detector Dependencies"]
        JSONSchema["jsonschema 4.24.0"]
        XMLSchema["xmlschema 4.1.0"]
    end

    subgraph HFDeps["HuggingFace Detector Dependencies"]
        Transformers["transformers 4.57.3"]
        Torch["torch 2.11.0"]
        Sentencepiece["sentencepiece 0.2.1"]
        Tiktoken["tiktoken 0.12.0"]
    end

    subgraph JudgeDeps["LLM Judge Dependencies"]
        VLLMJudge["vllm-judge 0.1.8"]
    end

    GD -.->|"all detectors"| CoreDeps
    GD -.->|"builtIn only"| BuiltInDeps
    GD -.->|"HF only"| HFDeps
    GD -.->|"judge only"| JudgeDeps

    style GD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style vLLM fill:#f5a623,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style FastAPI fill:#e8e8e8,stroke:#333
    style Uvicorn fill:#e8e8e8,stroke:#333
    style PromClient fill:#e8e8e8,stroke:#333
    style HTTPX fill:#e8e8e8,stroke:#333
    style PyYAML fill:#e8e8e8,stroke:#333
    style JSONSchema fill:#e8e8e8,stroke:#333
    style XMLSchema fill:#e8e8e8,stroke:#333
    style Transformers fill:#e8e8e8,stroke:#333
    style Torch fill:#e8e8e8,stroke:#333
    style Sentencepiece fill:#e8e8e8,stroke:#333
    style Tiktoken fill:#e8e8e8,stroke:#333
    style VLLMJudge fill:#e8e8e8,stroke:#333
