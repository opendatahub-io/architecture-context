graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["KServe-Managed"]
        L2["Application-Level"]
        L3["Platform-Level"]
        style L1 fill:#7ed321,stroke:#333,color:#fff
        style L2 fill:#4a90e2,stroke:#333,color:#fff
        style L3 fill:#f5a623,stroke:#333,color:#fff
    end

    subgraph KServeManaged["KServe-Managed RBAC (Pod Identity)"]
        direction TB
        SA["ServiceAccount<br/>(KServe-managed)<br/>Namespace: {user-namespace}"]
        ISA["InferenceService SA<br/>Created per InferenceService"]
        SA --- ISA
    end

    subgraph AppAuth["Application-Level Authentication"]
        direction TB

        subgraph AuthEnabled["When --api-key / VLLM_API_KEY set"]
            AuthMW["AuthenticationMiddleware<br/>(FastAPI)"]
            BearerToken["Bearer Token<br/>SHA256 hashed<br/>Timing-safe comparison"]
            AuthMW -->|validates| BearerToken
        end

        subgraph AuthEndpoints["Endpoint Authorization"]
            Authenticated["/v1/chat/completions<br/>/v1/completions<br/>/v1/models<br/>/v1/responses<br/>/v1/embeddings<br/>/v1/messages<br/>/v1/audio/transcriptions"]
            Unauthenticated["/health<br/>/metrics<br/>/ping<br/>/version<br/>/load<br/>/tokenize<br/>/detokenize"]
        end

        AuthMW -->|"protects"| Authenticated
    end

    subgraph Secrets["Secrets"]
        HFToken["HuggingFace Token<br/>Type: Opaque<br/>Purpose: Model download<br/>Provisioned: User/KServe<br/>Auto-Rotate: No"]
        SSLCerts["SSL Certificates<br/>Type: kubernetes.io/tls<br/>Purpose: HTTPS (optional)<br/>Provisioned: cert-manager<br/>Auto-Rotate: Yes<br/>(--enable-ssl-refresh)"]
    end

    %% Connections
    SA -->|"pod identity for"| AuthEndpoints
    HFToken -->|"used by vLLM<br/>at startup"| SA
    SSLCerts -->|"optional TLS for<br/>--ssl-keyfile"| SA

    %% Note
    Note["NOTE: vLLM CPU defines no<br/>ClusterRoles or RoleBindings.<br/>It is an inference service,<br/>not a Kubernetes operator.<br/>All RBAC is managed by KServe."]

    style SA fill:#7ed321,stroke:#333,color:#fff
    style ISA fill:#7ed321,stroke:#333,color:#fff
    style AuthMW fill:#4a90e2,stroke:#333,color:#fff
    style BearerToken fill:#4a90e2,stroke:#333,color:#fff
    style Authenticated fill:#dae8fc,stroke:#6c8ebf
    style Unauthenticated fill:#d5e8d4,stroke:#82b366
    style HFToken fill:#f5a623,stroke:#333,color:#fff
    style SSLCerts fill:#f5a623,stroke:#333,color:#fff
    style Note fill:#fff2cc,stroke:#d6b656
