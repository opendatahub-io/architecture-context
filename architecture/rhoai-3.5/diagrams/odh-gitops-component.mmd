graph TB
    subgraph ODHGitOps["odh-gitops (GitOps Configuration)"]
        direction TB

        subgraph HelmCharts["Helm Charts"]
            OpenShiftChart["rhai-on-openshift-chart<br/>OLM-based OpenShift deployment"]
            xKSChart["rhai-on-xks-chart<br/>Non-OpenShift K8s deployment<br/>(AWS EKS, Azure AKS, CoreWeave)"]
        end

        subgraph DepCharts["Dependency Sub-Charts (xKS)"]
            CertMgrChart["cert-manager chart"]
            GatewayAPIChart["gateway-api chart"]
            LWSChart["lws chart"]
            RHCLChart["rhcl chart"]
            SailChart["sail chart"]
        end

        subgraph KustomizeLayer["Kustomize Layer"]
            KustomizeComponents["Kustomize Components<br/>(Operator Subscriptions)"]
            KustomizeConfigs["Kustomize Configurations<br/>(Post-install CRs)"]
        end

        subgraph ContractSchemas["Contracts"]
            JSONSchemas["75+ JSON Schemas<br/>(CRD validation)"]
        end
    end

    %% CRDs created/managed
    subgraph CRDs["Custom Resources Created"]
        DSC["DataScienceCluster CR"]
        DSCI["DSCInitialization CR"]
        PlatformCR["Platform CR"]
        KServeCR["Kserve CR"]
        AIGatewayCR["AIGateway CR"]
        KE_AWS["AWSKubernetesEngine CR"]
        KE_Azure["AzureKubernetesEngine CR"]
        KE_CW["CoreWeaveKubernetesEngine CR"]
        GWClass["GatewayClass"]
        GW["Gateway (inference + MaaS)"]
        TLSCert["Certificate CRs (TLS)"]
    end

    %% OpenShift chart creates OLM resources + DSC/DSCI
    OpenShiftChart -->|"creates via OLM"| KustomizeComponents
    OpenShiftChart -->|"creates"| DSC
    OpenShiftChart -->|"creates"| DSCI
    OpenShiftChart -->|"creates"| GWClass
    OpenShiftChart -->|"creates"| GW

    %% xKS chart deploys operator directly + post-install hooks
    xKSChart -->|"includes"| DepCharts
    xKSChart -->|"post-install hook"| KE_AWS
    xKSChart -->|"post-install hook"| KE_Azure
    xKSChart -->|"post-install hook"| KE_CW
    xKSChart -->|"post-install hook"| PlatformCR
    xKSChart -->|"post-install hook"| KServeCR
    xKSChart -->|"post-install hook"| AIGatewayCR
    xKSChart -->|"gateway hook"| GW
    xKSChart -->|"gateway hook"| TLSCert

    %% Kustomize layer
    KustomizeComponents -->|"configures"| KustomizeConfigs

    %% JSON schemas validate CRDs
    JSONSchemas -.->|"validates"| CRDs

    %% Platform operator reconciles
    Operator["rhods-operator /<br/>opendatahub-operator"] -->|"reconciles"| DSC
    Operator -->|"reconciles"| DSCI
    Operator -->|"reconciles"| PlatformCR

    %% External dependencies
    CertManager["cert-manager"] -.->|"provisions TLS"| TLSCert
    Istio["Sail / Istio"] -.->|"implements"| GWClass
    OLM["OLM"] -.->|"manages subscriptions"| KustomizeComponents

    %% Styling
    style ODHGitOps fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style HelmCharts fill:#bbdefb,stroke:#1976d2
    style DepCharts fill:#c8e6c9,stroke:#388e3c
    style KustomizeLayer fill:#fff3e0,stroke:#ef6c00
    style ContractSchemas fill:#f3e5f5,stroke:#7b1fa2
    style CRDs fill:#fff9c4,stroke:#f9a825
    style OpenShiftChart fill:#4a90e2,color:#fff
    style xKSChart fill:#4a90e2,color:#fff
    style Operator fill:#7ed321,stroke:#333
    style CertManager fill:#999,stroke:#333
    style Istio fill:#999,stroke:#333
    style OLM fill:#999,stroke:#333
