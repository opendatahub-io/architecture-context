graph TD
    subgraph "RBAC Model (Delegated)"
        Note["No RBAC resources defined in<br/>pipelines-components repository.<br/>All RBAC is managed by the<br/>data-science-pipelines-operator<br/>and KFP infrastructure."]
    end

    subgraph "Runtime Service Account"
        KFPSA["KFP Pipeline Service Account<br/>(provisioned by DSP operator)"]
    end

    subgraph "Kubernetes API Resources Accessed by Pipeline Tasks"
        Secrets["core<br/>Secrets"]
        ConfigMaps["core<br/>ConfigMaps"]
        InferenceService["serving.kserve.io<br/>InferenceService"]
        RayJob["ray.io<br/>RayJob"]
        RayCluster["ray.io<br/>RayCluster"]
        Pods["core<br/>Pods"]
        PVCs["core<br/>PersistentVolumeClaims"]
    end

    subgraph "Secret Access Patterns"
        S3Secret["s3-secret<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>AWS_S3_ENDPOINT"]
        HFToken["hf-token<br/>HuggingFace Token"]
        OGXSecret["ogx-secret<br/>OGX_CLIENT_BASE_URL<br/>OGX_CLIENT_API_KEY"]
        MinIOSecret["minio-secret<br/>access_key, secret_key"]
        LLMCreds["llm-credentials<br/>LLM_API_KEY"]
        K8sCreds["kubernetes-credentials<br/>K8s API credentials"]
        OCIPull["oci-pull-secret<br/>dockerconfigjson"]
    end

    %% SA accesses resources
    KFPSA -->|"get, list"| Secrets
    KFPSA -->|"get, list"| ConfigMaps
    KFPSA -->|"create, patch"| InferenceService
    KFPSA -->|"create"| RayJob
    KFPSA -->|"create"| RayCluster
    KFPSA -->|"get, list, watch"| Pods
    KFPSA -->|"get, list, create"| PVCs

    %% Secret access via kfp-kubernetes use_secret_as_env
    KFPSA -.->|"use_secret_as_env"| S3Secret
    KFPSA -.->|"use_secret_as_env"| HFToken
    KFPSA -.->|"use_secret_as_env"| OGXSecret
    KFPSA -.->|"use_secret_as_env"| MinIOSecret
    KFPSA -.->|"use_secret_as_env"| LLMCreds
    KFPSA -.->|"use_secret_as_env"| K8sCreds
    KFPSA -.->|"imagePullSecret"| OCIPull

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style KFPSA fill:#4a90e2,stroke:#333,color:#fff
    style Secrets fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style InferenceService fill:#7ed321,stroke:#333
    style RayJob fill:#7ed321,stroke:#333
    style RayCluster fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style PVCs fill:#7ed321,stroke:#333
    style S3Secret fill:#f5a623,stroke:#333
    style HFToken fill:#f5a623,stroke:#333
    style OGXSecret fill:#f5a623,stroke:#333
    style MinIOSecret fill:#f5a623,stroke:#333
    style LLMCreds fill:#f5a623,stroke:#333
    style K8sCreds fill:#f5a623,stroke:#333
    style OCIPull fill:#f5a623,stroke:#333
