graph LR
    MLMD["MLMD gRPC Server<br/>(ml-metadata)"]

    %% Database Backends (Required)
    MLMD -->|"metadata storage<br/>3306/TCP"| MySQL["MySQL / MariaDB"]
    MLMD -->|"metadata storage<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    MLMD -.->|"embedded<br/>(testing/dev)"| SQLite["SQLite"]

    %% Build Dependencies
    MLMD -->|"build system"| Bazel["Bazel 5.3.0+"]
    MLMD -->|"gRPC framework"| gRPC["gRPC C++ 1.46.3"]
    MLMD -->|"serialization"| Protobuf["Protobuf 3.21.12"]
    MLMD -->|"TLS"| BoringSSL["BoringSSL"]
    MLMD -->|"SQL parsing"| ZetaSQL["ZetaSQL"]
    MLMD -->|"C++ utilities"| Abseil["Abseil C++"]

    %% Internal Platform Consumers (gRPC clients)
    KFP["Kubeflow Pipelines<br/>(ml-pipeline)"] -->|"gRPC client<br/>8080/TCP"| MLMD
    DSP["Data Science Pipelines<br/>(DSP)"] -->|"gRPC client<br/>8080/TCP"| MLMD
    KFPUI["KFP UI"] -->|"gRPC client<br/>(indirect) 8080/TCP"| MLMD

    %% Python ecosystem
    MLMD -.->|"Python bindings"| pybind11["pybind11 2.10.1"]
    MLMD -.->|"Python gRPC"| grpcio["grpcio >=1.8.6"]
    MLMD -.->|"Python protobuf"| protobuf_py["protobuf >=3.13"]

    %% Container base
    MLMD -.->|"runtime base"| UBI9["UBI9 Minimal"]

    %% Styling
    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style KFPUI fill:#7ed321,stroke:#333
    style Bazel fill:#999,stroke:#333
    style gRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style BoringSSL fill:#999,stroke:#333
    style ZetaSQL fill:#999,stroke:#333
    style Abseil fill:#999,stroke:#333
    style pybind11 fill:#999,stroke:#333
    style grpcio fill:#999,stroke:#333
    style protobuf_py fill:#999,stroke:#333
    style UBI9 fill:#999,stroke:#333
