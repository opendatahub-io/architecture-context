graph TD
    subgraph Component["vllm-orchestrator-gateway"]
        GW["Standalone HTTP Service<br/>(Not a Kubernetes Operator)"]
    end

    subgraph RBACStatus["RBAC Status"]
        NoRBAC["No RBAC Definitions<br/>━━━━━━━━━━━━━━━━━━━━<br/>No ClusterRoles<br/>No Roles<br/>No RoleBindings<br/>No ServiceAccount requirements"]
    end

    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB

        Endpoint["POST /{route_name}/v1/chat/completions"]
        AuthMech["Auth Mechanism:<br/>PASSTHROUGH ONLY<br/>Forwards Authorization header<br/>to orchestrator"]
        Enforcement["Enforcement Point:<br/>NONE at gateway layer"]
        Expected["Expected External Enforcement:<br/>• kube-rbac-proxy sidecar<br/>• Gateway API<br/>• Istio AuthorizationPolicy"]

        Endpoint --> AuthMech
        AuthMech --> Enforcement
        Enforcement --> Expected
    end

    subgraph Secrets["Secrets (Optional TLS)"]
        direction TB
        ClientCert["/etc/tls/private/tls.crt<br/>Type: kubernetes.io/tls<br/>Purpose: Client cert for mTLS<br/>Provisioned: cert-manager or<br/>service-serving-cert-signer"]
        ClientKey["/etc/tls/private/tls.key<br/>Type: kubernetes.io/tls<br/>Purpose: Private key for mTLS<br/>Provisioned: cert-manager or<br/>service-serving-cert-signer"]
        CACert["/etc/tls/ca/service-ca.crt<br/>Type: Opaque<br/>Purpose: CA for orchestrator TLS<br/>Provisioned: service-ca-operator"]
    end

    subgraph Risks["Security Risks"]
        Risk1["⚠ No token validation at gateway<br/>Misconfigured platform = open access"]
        Risk2["⚠ danger_accept_invalid_hostnames(true)<br/>when orchestrator host = localhost<br/>(present in production binary)"]
        Risk3["⚠ No NetworkPolicy shipped<br/>Network isolation = external concern"]
    end

    GW --> NoRBAC
    GW --> AuthModel
    GW --> Secrets
    GW --> Risks

    style GW fill:#4a90e2,color:#fff
    style NoRBAC fill:#e8e8e8,stroke:#999
    style Endpoint fill:#5b9bd5,color:#fff
    style AuthMech fill:#f5a623,stroke:#333
    style Enforcement fill:#f8cecc,stroke:#b85450
    style Expected fill:#d5e8d4,stroke:#82b366
    style ClientCert fill:#fff2cc,stroke:#d6b656
    style ClientKey fill:#fff2cc,stroke:#d6b656
    style CACert fill:#fff2cc,stroke:#d6b656
    style Risk1 fill:#f8cecc,stroke:#b85450
    style Risk2 fill:#f8cecc,stroke:#b85450
    style Risk3 fill:#f8cecc,stroke:#b85450
