graph TB
    subgraph PlatformLayer["ODH/RHOAI Platform Layer"]
        PlatformOp["ODH Platform Operator<br/>(rhods-operator)"]
    end

    subgraph ModuleOperator["MCP Lifecycle Module Operator"]
        Controller["Module Operator Controller<br/>(controller-runtime)"]
        KustomizeProvider["KustomizeProvider<br/>(manifestival)"]
        TLSConfig["TLS Config Reader"]
        GC["Garbage Collector<br/>(label-based)"]

        Controller -->|"renders manifests"| KustomizeProvider
        Controller -->|"reads TLS profile"| TLSConfig
        Controller -->|"cleans stale resources"| GC
    end

    subgraph Operand["MCP Lifecycle Operator (Operand)"]
        OperandDeploy["MCP Lifecycle Operator<br/>Deployment"]
        OperandSA["ServiceAccount"]
        OperandSvc["Metrics Service<br/>8443/TCP HTTPS"]
        OperandNP["NetworkPolicy"]
        OperandSM["ServiceMonitor"]
        MCPServerCRD["MCPServer CRD<br/>(mcp.x-k8s.io)"]

        OperandDeploy --- OperandSA
        OperandDeploy --- OperandSvc
        OperandDeploy --- OperandNP
        OperandDeploy --- OperandSM
        OperandDeploy -->|"manages"| MCPServerCRD
    end

    %% CR Flow
    MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped, name=default"]

    PlatformOp -->|"creates"| MCPLifecycleOpCR
    MCPLifecycleOpCR -->|"watched by"| Controller

    %% Module operator deploys operand
    KustomizeProvider -->|"SSA apply"| OperandDeploy
    KustomizeProvider -->|"SSA apply"| OperandSA
    KustomizeProvider -->|"SSA apply"| OperandSvc
    KustomizeProvider -->|"SSA apply"| OperandNP
    KustomizeProvider -->|"SSA apply"| OperandSM
    KustomizeProvider -->|"SSA apply"| MCPServerCRD

    %% External dependencies
    TLSConfig -->|"reads TLS profile"| OSAPIServer["OpenShift APIServer<br/>(config.openshift.io)"]
    TLSConfig -->|"injects TLS env vars"| OperandDeploy

    Controller -->|"reads platformVersion"| PlatformCM["ConfigMap<br/>odh-mcplifecycleoperator-config"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes via ServiceMonitor"| OperandSvc

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeProvider fill:#4a90e2,stroke:#333,color:#fff
    style TLSConfig fill:#4a90e2,stroke:#333,color:#fff
    style GC fill:#4a90e2,stroke:#333,color:#fff
    style PlatformOp fill:#7ed321,stroke:#333,color:#fff
    style MCPLifecycleOpCR fill:#f5a623,stroke:#333,color:#fff
    style OperandDeploy fill:#9b59b6,stroke:#333,color:#fff
    style OperandSA fill:#9b59b6,stroke:#333,color:#fff
    style OperandSvc fill:#9b59b6,stroke:#333,color:#fff
    style OperandNP fill:#9b59b6,stroke:#333,color:#fff
    style OperandSM fill:#9b59b6,stroke:#333,color:#fff
    style MCPServerCRD fill:#9b59b6,stroke:#333,color:#fff
    style OSAPIServer fill:#e8e8e8,stroke:#333
    style PlatformCM fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
