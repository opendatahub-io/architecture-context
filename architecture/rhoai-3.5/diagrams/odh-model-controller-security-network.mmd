graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client /<br/>Data Scientist"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes / Gateway API)"]
        Route["OpenShift Route (dynamic)<br/>443/TCP<br/>TLS Reencrypt or Edge"]
        GWAuthPolicy["Gateway AuthPolicy<br/>KubernetesTokenReview<br/>+ SubjectAccessReview"]
        HRAuthPolicy["HTTPRoute AuthPolicy<br/>Anonymous or UserDefined"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (ServiceAccount Auth)"]
        direction TB

        subgraph NS_ODH["Namespace: opendatahub"]
            ControllerDeploy["odh-model-controller<br/>SA: odh-model-controller<br/>Single-replica, leader election"]
            ControllerWebhook["Webhook Server<br/>9443/TCP HTTPS<br/>TLS: service-ca signed"]
            ControllerMetrics["Metrics<br/>8080/TCP HTTP/HTTPS<br/>Auth: TokenReview"]
            ControllerHealth["Health Probes<br/>8081/TCP HTTP"]

            APIServerDeploy["model-serving-api<br/>SA: model-serving-api"]
            APIServerHTTPS["API Server<br/>8443/TCP HTTPS<br/>TLS 1.2+ FIPS<br/>Ciphers: ECDHE+AES-GCM<br/>Curves: P-256, P-384"]
            APIServerMetrics["API Metrics<br/>8080/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph NS_Dashboard["RHOAI Dashboard"]
            Dashboard["Dashboard UI"]
        end

        subgraph NS_Kuadrant["Namespace: kuadrant-system"]
            Authorino["Authorino gRPC<br/>50051/TCP gRPC<br/>TLS: service-ca<br/>Auth: mTLS (SA CA)"]
        end
    end

    subgraph ExternalServices["EGRESS (External Services)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Token"]
        NGCAPI["NVIDIA NGC API<br/>api.ngc.nvidia.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: API Key / Bearer"]
        NVCReg["NVIDIA Registry<br/>nvcr.io<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer (OAuth)"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS (Reencrypt/Edge)<br/>Bearer Token (optional)"| Route
    Client -->|"HTTPS<br/>via Gateway API"| GWAuthPolicy
    GWAuthPolicy -->|"Auth decision"| HRAuthPolicy

    %% Internal webhook flow
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (service-ca)<br/>AdmissionReview"| ControllerWebhook

    %% Dashboard to API
    Dashboard -->|"HTTPS/8443<br/>TLS 1.2+ FIPS<br/>Bearer Token"| APIServerHTTPS

    %% Controller egress
    ControllerDeploy -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ControllerDeploy -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| NGCAPI
    ControllerDeploy -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| NVCReg

    %% API server egress
    APIServerDeploy -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token + User Token"| K8sAPI

    %% Authorino integration (via EnvoyFilter)
    ControllerDeploy -.->|"gRPC/50051<br/>TLS (service-ca)<br/>mTLS"| Authorino

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef fips fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Route,GWAuthPolicy,HRAuthPolicy ingress
    class ControllerDeploy,ControllerWebhook,ControllerMetrics,ControllerHealth internal
    class APIServerDeploy,APIServerHTTPS,APIServerMetrics fips
    class Dashboard internal
    class Authorino internal
    class K8sAPI,NGCAPI,NVCReg externalservice
