        Benchmark["llm-d-benchmark<br/>Performance validation"]
        InfSim["llm-d-inference-sim<br/>GPU-free simulator"]
    end

    %% External Runtime Dependencies
    subgraph ExternalRuntime["External Runtime Dependencies"]
        GatewayAPI["Gateway API CRDs v1.5.x"]
        Istio["Istio"]
        AgentGW["AgentGateway"]
        EnvoyAI["Envoy AI Gateway"]
    end

    %% External Services
    subgraph ExternalServices["External Services"]
        HF["HuggingFace Hub"]
        GHCR["ghcr.io"]
        NVCR["NVIDIA NGC (nvcr.io)"]
        PyPI["PyPI / Wheel Indexes"]
    end

    %% Integration Points (consume llm-d)
    subgraph Consumers["Observability / Monitoring"]
        Prometheus["Prometheus"]
        OTEL["OpenTelemetry"]
    end

