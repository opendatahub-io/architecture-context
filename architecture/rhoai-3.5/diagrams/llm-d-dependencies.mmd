graph LR
    LLMD["llm-d<br/>Meta-Repository"]

    %% Build Dependencies (compiled into images)
    subgraph BuildDeps["Build Dependencies"]
        vLLM["vLLM v0.23.0<br/>(neuralmagic fork)"]
        PyTorch["PyTorch 2.11.0"]
        CUDA["NVIDIA CUDA 13.0.2"]
        NIXL["NIXL v1.2.0"]
        UCX["UCX v1.20.0"]
        UCCL["UCCL v0.1.1"]
        NVSHMEM["NVSHMEM v3.4.5"]
