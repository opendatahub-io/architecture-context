graph LR
    MMC["model-metadata-collection<br/>(Go CLI + Data Container)"]

    %% External Service Dependencies
    MMC -->|"collections &<br/>model details<br/>HTTPS/443"| HF["HuggingFace API v1<br/>huggingface.co"]
    MMC -->|"branch validation &<br/>agent metadata<br/>HTTPS/443"| GitHub["GitHub API v3<br/>api.github.com"]
    MMC -->|"raw file content<br/>HTTPS/443"| GitHubRaw["GitHub Raw Content<br/>raw.githubusercontent.com"]
    MMC -->|"OCI manifests &<br/>model card layers<br/>Docker v2 HTTPS/443"| Registry["OCI Registry<br/>registry.redhat.io"]

    %% Go Library Dependencies
    MMC -->|"OCI image parsing"| ContainersImage["containers/image<br/>v5.36.1"]
    MMC -->|"Unicode text processing"| GolangText["golang.org/x/text<br/>v0.28.0"]
    MMC -->|"YAML parsing"| YAML["gopkg.in/yaml.v3<br/>v3.0.1"]

    %% Internal Platform Consumers (reverse dependency)
    Dashboard["RHOAI Dashboard"] -->|"consumes catalogs<br/>(volume mount)"| MMC
    ModelReg["Model Registry"] -->|"consumes metadata<br/>(CatalogMetadata)"| MMC

    %% Input Data Dependencies
    Supplemental["supplemental-catalog.yaml<br/>(manual entries)"] -->|"merged into<br/>final catalog"| MMC
    MCPInput["input/mcp_servers/*.yaml<br/>(curated MCP defs)"] -->|"MCP catalog<br/>source data"| MMC
    VLLMConfig["input/models/vllm-config/*.yaml<br/>(serving config)"] -->|"serving runtime<br/>configuration"| MMC
    SampleData["sample-data/<br/>(benchmark JSON)"] -->|"packaged into<br/>data container"| MMC

