graph TB
    subgraph Operator["LLM-D Batch Gateway Operator"]
        direction TB
        Reconciler["LLMBatchGatewayReconciler<br/>Main reconcile loop"]
        MetricsCtrl["MetricsController<br/>Self-monitoring infrastructure"]
        HelmRenderer["HelmRenderer<br/>In-memory Helm chart rendering"]
        Reconciler -->|renders charts via| HelmRenderer
        Reconciler -->|validates spec| Reconciler
        MetricsCtrl -->|ensures monitoring| MonitoringResources["Service + ServiceMonitor<br/>+ PrometheusRule"]
    end

    subgraph ManagedWorkloads["Managed Workloads (Helm-rendered)"]
        direction TB
        APIServer["API Server<br/>8000/TCP HTTP/HTTPS<br/>Batch job submission & files"]
        Processor["Processor<br/>AIMD concurrency control<br/>Sync dispatch"]
        GC["Garbage Collector<br/>Expires jobs & orphaned files"]
        AsyncProcessor["Async-Processor (optional)<br/>Redis MQ dispatch"]
    end

    User[Platform Admin] -->|creates| LLMBatchGatewayCR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1"]
    LLMBatchGatewayCR -->|watched by| Reconciler

    Reconciler -->|"CRD→Helm values"| BatchChart["batch-gateway<br/>Helm Chart (embedded)"]
    Reconciler -->|"CRD→Helm values"| AsyncChart["async-processor<br/>Helm Chart (embedded)"]
    BatchChart -->|renders| APIServer
    BatchChart -->|renders| Processor
    BatchChart -->|renders| GC
    AsyncChart -->|renders| AsyncProcessor

    Reconciler -->|server-side apply| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    Reconciler -->|orphan cleanup| K8sAPI
    Reconciler -->|ReferenceGrant check| SecretSync["Cross-NS Secret Sync"]

    subgraph OptionalCRDs["Optional CRD Integrations"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        Certificate["Certificate<br/>(cert-manager)"]
        ServiceMonitor["ServiceMonitor<br/>(Prometheus Operator)"]
        PodMonitor["PodMonitor<br/>(Prometheus Operator)"]
        PrometheusRule["PrometheusRule<br/>(Prometheus Operator)"]
    end

    Reconciler -->|creates| HTTPRoute
    Reconciler -->|creates| Certificate
    Reconciler -->|creates| ServiceMonitor
    Reconciler -->|creates| PodMonitor
    Reconciler -->|creates| PrometheusRule

    %% Platform integration
    PlatformOp["opendatahub-operator /<br/>rhods-operator"] -->|deploys via kustomize| Operator
    PlatformOp -->|sets images via params.env| Operator

    %% Styling
    style Reconciler fill:#4a90e2,stroke:#333,color:#fff
    style MetricsCtrl fill:#4a90e2,stroke:#333,color:#fff
    style HelmRenderer fill:#4a90e2,stroke:#333,color:#fff
    style LLMBatchGatewayCR fill:#f5a623,stroke:#333,color:#fff
    style APIServer fill:#7ed321,stroke:#333,color:#fff
    style Processor fill:#7ed321,stroke:#333,color:#fff
    style GC fill:#7ed321,stroke:#333,color:#fff
    style AsyncProcessor fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#9b59b6,stroke:#333,color:#fff
    style HTTPRoute fill:#ddd,stroke:#999
    style Certificate fill:#ddd,stroke:#999
    style ServiceMonitor fill:#ddd,stroke:#999
    style PodMonitor fill:#ddd,stroke:#999
    style PrometheusRule fill:#ddd,stroke:#999
