graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-manager-rolebinding<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(namespace: system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-manager-role"]
        CR_Metrics["metrics-auth-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph API_KServe["API Group: serving.kserve.io"]
        ISVC["inferenceservices<br/>get, list, watch,<br/>update, patch"]
        ISVCFinalizers["inferenceservices/finalizers<br/>get, list, watch, update,<br/>create, patch, delete"]
    end

    subgraph API_Core["API Group: core ('')"]
        Services["services<br/>get, list, watch"]
        ConfigMaps["configmaps<br/>get, list, watch, create,<br/>update, patch, delete"]
        Events["events<br/>create, patch"]
    end

    subgraph API_Coordination["API Group: coordination.k8s.io"]
        Leases["leases<br/>get, list, watch, create,<br/>update, patch, delete"]
    end

    subgraph API_Auth["API Group: authentication / authorization"]
        TokenReviews["tokenreviews<br/>create"]
        SAR["subjectaccessreviews<br/>create"]
    end

    %% Service Account → Bindings
    SA_Controller -->|"bound via"| CRB_Manager
    SA_Controller -->|"bound via"| RB_Leader

    %% Bindings → Roles
    CRB_Manager -->|"grants"| CR_Manager
    RB_Leader -->|"grants"| R_Leader

    %% ClusterRole: model-registry-manager-role → Resources
    CR_Manager -->|"serving.kserve.io"| ISVC
    CR_Manager -->|"serving.kserve.io"| ISVCFinalizers
    CR_Manager -->|"core"| Services

    %% Role: leader-election-role → Resources
    R_Leader -->|"core"| ConfigMaps
    R_Leader -->|"coordination.k8s.io"| Leases
    R_Leader -->|"core"| Events

    %% ClusterRole: metrics-auth-role → Resources
    CR_Metrics -->|"authentication.k8s.io"| TokenReviews
    CR_Metrics -->|"authorization.k8s.io"| SAR

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_Metrics fill:#f5a623,stroke:#333,color:#fff
    style R_Leader fill:#f5a623,stroke:#333,color:#fff
    style ISVC fill:#7ed321,stroke:#333
    style ISVCFinalizers fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
    style Leases fill:#7ed321,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style CRB_Manager fill:#dae8fc,stroke:#6c8ebf
    style RB_Leader fill:#dae8fc,stroke:#6c8ebf
