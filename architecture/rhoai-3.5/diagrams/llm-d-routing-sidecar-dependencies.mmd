graph LR
    Sidecar["llm-d-routing-sidecar<br/>(Reverse Proxy Sidecar)"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>localhost:8001"| Decoder["vLLM Decoder<br/>(co-located)"]
    Sidecar -->|"reverse proxy<br/>HTTP(S), LRU-cached"| Prefillers["vLLM Prefiller Workers<br/>(remote pods)"]
    Sidecar -->|"K8s API watch<br/>SharedInformer"| InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]

    %% External Dependencies (Go modules)
    Sidecar -->|"K8s API client"| ClientGo["k8s.io/client-go<br/>v0.31.3"]
    Sidecar -->|"K8s types"| APIMachinery["k8s.io/apimachinery<br/>v0.31.3"]
    Sidecar -->|"proxy caching"| LRU["golang-lru/v2<br/>v2.0.7"]
    Sidecar -->|"request correlation"| UUID["google/uuid<br/>v1.6.0"]
    Sidecar -->|"structured logging"| Logr["go-logr/logr<br/>v1.4.2"]
    Sidecar -->|"logging backend"| Klog["k8s.io/klog/v2<br/>v2.130.1"]

    %% Upstream Integration
    InferenceScheduler["llm-d-inference-scheduler<br/>(upstream)"] -->|"sets headers:<br/>x-prefiller-host-port<br/>x-request-id"| Sidecar

    %% Successor
    Sidecar -.->|"DEPRECATED:<br/>code moved to"| Successor["llm-d-inference-scheduler<br/>cmd/pd_sidecar<br/>pkg/sidecar"]

