graph TD
    subgraph "NeMo Guardrails — No Kubernetes RBAC"
        Note["This is a standalone containerized service,<br/>not a Kubernetes operator.<br/><br/>No ClusterRoles, Roles, or RoleBindings<br/>are defined within this component."]
    end

    subgraph "Authentication Model"
        direction TB
        InboundAuth["Inbound Authentication<br/>(Delegated to Platform)"]
        PlatformProxy["kube-rbac-proxy / Gateway API<br/>Enforces: Bearer Token validation<br/>TLS Termination"]
        InboundAuth -->|"enforced by"| PlatformProxy
    end

    subgraph "Credential Management"
        direction TB

        subgraph "Environment Variables"
            OPENAI_KEY["OPENAI_API_KEY<br/>OpenAI-compatible LLM auth"]
            MODEL_URL["MAIN_MODEL_BASE_URL<br/>Upstream LLM server URL"]
            MODEL_ENGINE["MAIN_MODEL_ENGINE<br/>Provider engine type"]
            ANTHROPIC_KEY["ANTHROPIC_API_KEY<br/>Anthropic provider auth"]
            AZURE_KEY["AZURE_OPENAI_API_KEY<br/>Azure OpenAI auth"]
            COHERE_KEY["COHERE_API_KEY<br/>Cohere provider auth"]
        end

        subgraph "Runtime Headers"
            XAuth["X-Authorization Header<br/>Client → Server → Upstream LLM<br/>(mapped to Authorization)"]
        end
    end

    subgraph "Header Forwarding Security"
        direction TB
        HeaderFwd["header_forwarding.py"]
        Allowed["Forwarded:<br/>X-Authorization → Authorization"]
        Blocked["Blocked:<br/>X-Forwarded-*<br/>X-Real-IP<br/>X-Request-Id"]
        HeaderFwd --> Allowed
        HeaderFwd --> Blocked
    end

    PlatformProxy -->|"X-Authorization header<br/>HTTP/8000 plaintext"| HeaderFwd

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style PlatformProxy fill:#f5a623,stroke:#333
    style InboundAuth fill:#ffe6cc,stroke:#d79b00
    style HeaderFwd fill:#4a90e2,stroke:#333,color:#fff
    style Allowed fill:#d5e8d4,stroke:#82b366
    style Blocked fill:#f8d7da,stroke:#dc3545
    style OPENAI_KEY fill:#e1d5e7,stroke:#9673a6
    style MODEL_URL fill:#e1d5e7,stroke:#9673a6
    style MODEL_ENGINE fill:#e1d5e7,stroke:#9673a6
    style ANTHROPIC_KEY fill:#e1d5e7,stroke:#9673a6
    style AZURE_KEY fill:#e1d5e7,stroke:#9673a6
    style COHERE_KEY fill:#e1d5e7,stroke:#9673a6
    style XAuth fill:#dae8fc,stroke:#6c8ebf
