graph TB
    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Operator["Namespace: mcp-lifecycle-operator-system"]
            Operator["MCP Lifecycle Operator<br/>SA: controller-manager<br/>Pod Security: restricted<br/>FIPS: strictfipsruntime"]
            MetricsSvc["Metrics Service (ClusterIP)<br/>8443/TCP HTTPS<br/>TLS (self-signed/cert-manager)<br/>HTTP/2 disabled"]
            HealthEndpoint["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            MCPPod["MCP Server Pod<br/>Image: user-specified<br/>Pod Security: restricted"]
            MCPService["ClusterIP Service<br/>{port}/TCP HTTP<br/>No Encryption"]
            MCPNetPol["NetworkPolicy<br/>Ingress: any source<br/>Port: {mcp-port} only"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS<br/>SA Token Auth"]

        Prometheus["Prometheus<br/>(ns: metrics=enabled label)"]
    end

    %% Operator to K8s API
    Operator -->|"HTTPS/443<br/>TLS<br/>SA Token<br/>CRUD: Deployments, Services,<br/>NetworkPolicies, ConfigMaps,<br/>Secrets, MCPServers"| K8sAPI

    %% K8s API watch events to Operator
    K8sAPI -->|"HTTPS (Watch)<br/>TLS<br/>SA Token<br/>MCPServer, ConfigMap,<br/>Secret events"| Operator

    %% Operator MCP handshake
    Operator -->|"HTTP/{port}<br/>No TLS<br/>No Auth<br/>MCP Streamable HTTP<br/>initialize handshake"| MCPPod

    %% Prometheus scraping
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>TokenReview+SAR"| MetricsSvc

    %% Network Policy enforcement
    MCPNetPol -.->|"restricts ingress to<br/>{mcp-port}/TCP only"| MCPPod

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef managed fill:#7ed321,stroke:#333,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#333,stroke-width:2px
    classDef security fill:#f5a623,stroke:#333,stroke-width:2px
    classDef monitoring fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff

    class Operator,MetricsSvc,HealthEndpoint operator
    class MCPPod,MCPService managed
    class K8sAPI platform
    class MCPNetPol security
    class Prometheus monitoring
