graph TB
    subgraph Platform["RHOAI / ODH Platform"]
        PlatformOp["rhods-operator /<br/>opendatahub-operator"]
        PlatformOp -->|creates| OGXCR["OGX CR<br/>(cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]
    end

    subgraph OGXModule["OGX Module (ogx-module)"]
        ModuleCtrl["OGX Module Controller<br/>odh-ogx-module-rhel9<br/>8080/TCP metrics, 8081/TCP health"]
        OGXCR -->|watched by| ModuleCtrl
        ModuleCtrl -->|deploys via kustomize| OGXOperator
    end

    subgraph OGXOperatorGroup["OGX Operator (ogx-operator)"]
        OGXOperator["OGX Operator Controller<br/>odh-ogx-operator-rhel9<br/>8080/TCP metrics, 8081/TCP health"]
        Webhook["Validating Webhook<br/>9443/TCP HTTPS<br/>vogxserver.kb.io"]
        ConfigGen["Config Generator<br/>(configgen CLI)"]
        OGXOperator --- Webhook
        OGXOperator --- ConfigGen
    end

    User["User / Data Scientist"] -->|creates| OGXServerCR["OGXServer CR<br/>(namespaced)<br/>ogx.io/v1beta1"]
    OGXServerCR -->|validated by| Webhook
    OGXServerCR -->|watched by| OGXOperator

    subgraph ManagedResources["Per-OGXServer Instance Resources"]
        Deploy["Deployment"]
        Svc["ClusterIP Service<br/>8321/TCP + 9464/TCP"]
        NP["NetworkPolicy"]
        HPA["HorizontalPodAutoscaler"]
        PDB["PodDisruptionBudget"]
        PVC["PersistentVolumeClaim"]
        SM["ServiceMonitor"]
        PR["PrometheusRule"]
        Ing["Ingress (optional)<br/>External access"]
    end

    OGXOperator -->|creates/manages| Deploy
    OGXOperator -->|creates/manages| Svc
    OGXOperator -->|creates/manages| NP
    OGXOperator -->|creates/manages| HPA
    OGXOperator -->|creates/manages| PDB
    OGXOperator -->|creates/manages| PVC
    OGXOperator -->|creates/manages| SM
    OGXOperator -->|creates/manages| PR
    OGXOperator -->|creates/manages| Ing

    OGXOperator -->|fetches base config| OCIRegistry["OCI Container Registry"]
    OGXOperator -->|health checks| OGXPod["OGX Server Pod<br/>/v1/providers, /v1/version"]

    LegacyCR["LlamaStackDistribution CR<br/>(legacy, deprecated)<br/>llamastack.io/v1alpha1"] -.->|adoption migration| OGXOperator

    style PlatformOp fill:#7ed321,stroke:#333
    style ModuleCtrl fill:#4a90e2,stroke:#333
    style OGXOperator fill:#4a90e2,stroke:#333,stroke-width:3px
    style Webhook fill:#4a90e2,stroke:#333
    style ConfigGen fill:#4a90e2,stroke:#333
