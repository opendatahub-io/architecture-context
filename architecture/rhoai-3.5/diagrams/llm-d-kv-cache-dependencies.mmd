graph LR
    KVCache["llm-d-kv-cache<br/>KV-Cache Library & Services"]

    %% External Dependencies (Required)
    KVCache -->|"event transport<br/>(required)"| ZeroMQ["ZeroMQ (libzmq) >=4.x"]
    KVCache -->|"tokenizer infra<br/>(required)"| vLLM["vLLM 0.18.0+rhaiv.4"]
    KVCache -->|"model downloads<br/>(required)"| HFHub["Hugging Face Hub >=0.36.0"]

    %% External Dependencies (Optional)
    KVCache -.->|"persistent index<br/>(optional)"| Redis["Redis / Valkey >=6.x"]
    KVCache -.->|"pod discovery<br/>(optional)"| K8s["Kubernetes >=1.28"]
    KVCache -.->|"distributed tracing<br/>(optional)"| OTEL["OpenTelemetry Collector"]

    %% Internal Platform Dependencies
    EPP["llm-d-router (EPP)"] -->|"Go module import<br/>primary consumer"| KVCache
    vLLMPods["vLLM Pods"] -->|"ZMQ 5557/TCP<br/>KV-cache events"| KVCache

    %% Integration Points (consumers of KV-cache)
    KVCache -->|"metrics scrape<br/>HTTP"| Prometheus["Prometheus"]
    KVCache -->|"POSIX I/O<br/>block storage"| SharedPVC["Shared PVC"]

    %% Optional integration
    SGLang["SGLang Pods"] -.->|"ZMQ 5557/TCP<br/>alternative engine"| KVCache

