graph TB
    subgraph External["External Clients"]
        Scheduler["llm-d-inference-scheduler<br/>(sets x-prefiller-host-port header)"]
        DirectClient["Direct Client<br/>(no prefiller header)"]
    end

    subgraph SidecarPod["Pod: vLLM Decoder + Sidecar"]
        subgraph Sidecar["llm-d-routing-sidecar (port 8000)"]
            ReverseProxy["Reverse Proxy<br/>httputil.ReverseProxy"]
            ConnectorNIXLv2["NIXL v2 Connector<br/>(active, default)"]
            ConnectorNIXLv1["NIXL v1 Connector<br/>(deprecated)"]
            ConnectorLMCache["LMCache Connector<br/>(deprecated)"]
            LRUCache["Prefiller Proxy LRU Cache<br/>(16-entry)"]
            AllowlistValidator["AllowlistValidator<br/>(SSRF Protection)"]
            TLSConfig["TLS Config<br/>TLS 1.2+ / AEAD Ciphers"]
        end

        Decoder["vLLM Decoder<br/>(localhost, port 8001)"]
    end

    subgraph RemoteWorkers["Remote Prefill Workers"]
        Prefiller1["Prefiller Pod 1"]
        Prefiller2["Prefiller Pod 2"]
        PrefillerN["Prefiller Pod N"]
    end

    subgraph K8sAPI["Kubernetes API"]
        InferencePoolCR["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
        PodResources["Pod Resources<br/>(matching pool selector)"]
    end

    %% Request flows
    Scheduler -->|"HTTPS/8000<br/>x-prefiller-host-port"| ReverseProxy
    DirectClient -->|"HTTPS/8000<br/>passthrough"| ReverseProxy

    ReverseProxy --> ConnectorNIXLv2
    ConnectorNIXLv2 -->|"prefill request<br/>max_tokens=1"| LRUCache
    LRUCache -->|"cached proxy"| Prefiller1
    LRUCache -->|"cached proxy"| Prefiller2
    LRUCache -->|"cached proxy"| PrefillerN
    ConnectorNIXLv2 -->|"decode request<br/>kv_transfer_params"| Decoder

    ReverseProxy -->|"passthrough"| Decoder

    %% SSRF protection
    AllowlistValidator -->|"validates prefiller host"| ReverseProxy
    AllowlistValidator -->|"watch (SharedInformer)"| InferencePoolCR
    AllowlistValidator -->|"watch (SharedInformer)"| PodResources

    %% TLS
    TLSConfig -.->|"secures"| ReverseProxy

    %% Styles
    style ReverseProxy fill:#4a90e2,stroke:#333,color:#fff
    style ConnectorNIXLv2 fill:#4a90e2,stroke:#333,color:#fff
    style ConnectorNIXLv1 fill:#999,stroke:#333,color:#fff
    style ConnectorLMCache fill:#999,stroke:#333,color:#fff
    style LRUCache fill:#4a90e2,stroke:#333,color:#fff
    style AllowlistValidator fill:#e8744f,stroke:#333,color:#fff
    style TLSConfig fill:#7ed321,stroke:#333,color:#fff
    style Decoder fill:#f5a623,stroke:#333
    style Prefiller1 fill:#f5a623,stroke:#333
    style Prefiller2 fill:#f5a623,stroke:#333
    style PrefillerN fill:#f5a623,stroke:#333
    style Scheduler fill:#e8e8e8,stroke:#333
    style DirectClient fill:#e8e8e8,stroke:#333
    style InferencePoolCR fill:#d4a5f5,stroke:#333
    style PodResources fill:#d4a5f5,stroke:#333
