graph LR
    MLServer["MLServer<br/>ML Inference Server"]

    %% Core Runtime Dependencies
    MLServer -->|"REST API framework"| FastAPI["FastAPI >=0.134.0"]
    MLServer -->|"ASGI server"| Uvicorn["uvicorn"]
    MLServer -->|"gRPC server"| GRPCIO["grpcio >=1.67.1"]
    MLServer -->|"serialization"| Protobuf["protobuf >=5.27.2"]
    MLServer -->|"settings/models"| Pydantic["pydantic ^2.7.1"]
    MLServer -->|"fast JSON"| Orjson["orjson"]
    MLServer -->|"event loop"| Uvloop["uvloop"]

    %% ML Framework Dependencies (CPU image)
    MLServer -->|"sklearn runtime"| Sklearn["scikit-learn"]
    MLServer -->|"xgboost runtime"| XGBoost["xgboost"]
    MLServer -->|"lightgbm runtime"| LightGBM["lightgbm"]
    MLServer -->|"onnx format"| ONNX["onnx >=1.21.0"]
    MLServer -->|"CPU inference"| ONNXRuntime["onnxruntime >=1.20.0"]
    MLServer -->|"GPU inference"| ONNXRuntimeGPU["onnxruntime-gpu >=1.20.0<br/>(CUDA image only)"]

    %% Data Handling
    MLServer -->|"tensor data"| NumPy["numpy"]
    MLServer -->|"DataFrame codec"| Pandas["pandas"]

    %% Observability Dependencies
    MLServer -->|"REST metrics"| StarletteExporter["starlette-exporter"]
    MLServer -->|"gRPC metrics"| GRPCPrometheus["py-grpc-prometheus"]
    MLServer -.->|"tracing (optional)"| OTelSDK["opentelemetry-sdk ^1.22.0"]
    MLServer -.->|"trace export (optional)"| OTelOTLP["opentelemetry-exporter-otlp"]

    %% Optional Dependencies
    MLServer -.->|"streaming (optional)"| Aiokafka["aiokafka"]
    MLServer -->|"batch processing"| TritonClient["tritonclient[http] >=2.42"]

    %% Internal Platform Dependencies
    KServe["KServe InferenceService"] -->|"container runtime"| MLServer
    KubeRBACProxy["kube-rbac-proxy<br/>sidecar"] -->|"auth proxy"| MLServer
    ModelStorage["Model Storage<br/>(PVC / S3)"] -.->|"/mnt/models"| MLServer

    %% Monitoring Integration
    Prometheus["Prometheus"] -->|"scrape 8082/TCP"| MLServer

    %% Styling
    style MLServer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core dependencies
    style FastAPI fill:#82b366,stroke:#333,color:#fff
    style Uvicorn fill:#82b366,stroke:#333,color:#fff
    style GRPCIO fill:#82b366,stroke:#333,color:#fff
    style Protobuf fill:#82b366,stroke:#333,color:#fff
    style Pydantic fill:#82b366,stroke:#333,color:#fff
    style Orjson fill:#82b366,stroke:#333,color:#fff
    style Uvloop fill:#82b366,stroke:#333,color:#fff

    %% ML frameworks
    style Sklearn fill:#f5a623,stroke:#333,color:#fff
    style XGBoost fill:#f5a623,stroke:#333,color:#fff
