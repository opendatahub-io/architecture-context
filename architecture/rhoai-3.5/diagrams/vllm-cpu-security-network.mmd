graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["Platform Gateway<br/>(rhods-operator)<br/>HTTPRoute / Route<br/>TLS Termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (User Namespace)"]
        direction TB

        subgraph KServeLayer["KServe InferenceService"]
            KServe["KServe Controller<br/>Pod lifecycle + scaling"]
        end

        subgraph VLLMPod["vLLM CPU Pod"]
            direction TB
            HTTPService["vllm-openai<br/>ClusterIP 8000/TCP<br/>HTTP (TLS optional)<br/>Bearer Token (optional)"]
            GRPCService["vllm-grpc<br/>ClusterIP 50051/TCP<br/>gRPC (insecure)<br/>No Auth"]
            ModelFS["Model Weights<br/>PVC / Local FS"]
        end

        Prometheus["Prometheus<br/>Metrics Scrape"]
    end

    subgraph EgressServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (HF_TOKEN)"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC (OTLP)<br/>Insecure default"]
    end

    subgraph BuildTimeEgress["BUILD-TIME EGRESS (Konflux)"]
        PyTorchHub["PyTorch Hub<br/>download.pytorch.org<br/>443/TCP HTTPS"]
        IBMDevPI["IBM DevPI<br/>wheels.developerfirst.ibm.com<br/>443/TCP HTTPS<br/>ppc64le wheels"]
    end

    %% Inbound flows
    Client -->|"HTTPS/443<br/>TLS (platform-managed)<br/>Bearer Token"| Gateway
    Gateway -->|"HTTP/8000<br/>No encryption (internal)<br/>Auth forwarded"| HTTPService
    KServe -->|"Pod lifecycle<br/>scaling, routing"| VLLMPod
    Prometheus -->|"GET /metrics<br/>HTTP/8000<br/>No auth"| HTTPService

    %% Internal flows
    HTTPService -->|"File I/O"| ModelFS
    GRPCService -->|"File I/O"| ModelFS

    %% Egress flows
    HTTPService -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (HF_TOKEN)"| HFHub
    HTTPService -->|"gRPC/4317<br/>OTLP (insecure)"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef buildtime fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gateway ingress
    class KServe,Prometheus internal
    class HTTPService,GRPCService,ModelFS service
    class HFHub,OTel externalservice
    class PyTorchHub,IBMDevPI buildtime
