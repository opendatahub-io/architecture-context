graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_AGO["ai-gateway-operator<br/>(ai-gateway-system)"]
        SA_MaaS["maas-controller<br/>(applications namespace)"]
    end

    subgraph ClusterBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(ai-gateway-system)"]
        RB_SecretMigrate["maas-controller-secret-migrate<br/>(redhat-ai-gateway-infra)"]
    end

    subgraph ClusterRoles["ClusterRole: manager-role"]
        direction TB

        subgraph CoreAPIs["Core API Resources"]
            Core_NS["namespaces<br/>create,get,list,patch,update,watch"]
            Core_Svc["services, serviceaccounts,<br/>configmaps<br/>full CRUD"]
            Core_Secrets["secrets<br/>create,get,list,patch,watch"]
            Core_SAToken["serviceaccounts/token<br/>create"]
            Core_ReadOnly["endpoints, pods<br/>get,list,watch"]
        end

        subgraph ODHAPIs["ODH / AI Gateway APIs"]
            ODH_AIGateway["components.platform.opendatahub.io<br/>aigateways, aigateways/status,<br/>aigateways/finalizers<br/>full CRUD"]
            ODH_MaaS["maas.opendatahub.io<br/>aitenants, configs, tenants,<br/>maassubscriptions, maasmodelrefs,<br/>maasauthpolicies, maastenantconfigs,<br/>externalmodels<br/>full CRUD"]
            ODH_Inference["inference.opendatahub.io<br/>externalmodels, externalproviders<br/>full CRUD"]
            ODH_Batch["batch.llm-d.ai<br/>llmbatchgateways (+status,finalizers)<br/>full CRUD + deletecollection"]
            ODH_MaSvc["components.platform.opendatahub.io<br/>modelsasservices, modelsasservices/status<br/>get,list,patch,update,watch"]
        end

        subgraph NetworkAPIs["Network & Gateway APIs"]
            GW_HTTPRoutes["gateway.networking.k8s.io<br/>httproutes (+finalizers)<br/>full CRUD"]
            GW_ReadOnly["gateway.networking.k8s.io<br/>gateways, referencegrants<br/>get,list,watch"]
            Istio_Net["networking.istio.io<br/>destinationrules, envoyfilters,<br/>serviceentries<br/>full CRUD"]
            K8s_NetPol["networking.k8s.io<br/>networkpolicies<br/>create,delete,get,list,patch,watch"]
        end

        subgraph SecurityAPIs["Security & Auth APIs"]
            RBAC_All["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>full CRUD"]
            CRD_Mgmt["apiextensions.k8s.io<br/>customresourcedefinitions<br/>full CRUD"]
            Webhook_Mgmt["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>full CRUD"]
            Auth_Token["authentication.k8s.io<br/>tokenreviews<br/>create"]
            Auth_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
            Kuadrant_Policies["kuadrant.io<br/>authpolicies, tokenratelimitpolicies,<br/>ratelimitpolicies<br/>full CRUD"]
            Kuadrant_Ext["extensions.kuadrant.io<br/>telemetrypolicies<br/>create,delete,get,list,patch,watch"]
        end

        subgraph ObservabilityAPIs["Observability APIs"]
            Monitoring["monitoring.coreos.com<br/>podmonitors, prometheusrules,<br/>servicemonitors<br/>full CRUD"]
            OTel["opentelemetry.io<br/>opentelemetrycollectors<br/>create,delete,get,list,patch,watch"]
            Perses_API["perses.dev<br/>persesdashboards, persesdatasources<br/>create,delete,get,list,patch,watch"]
            Istio_Tel["telemetry.istio.io<br/>telemetries<br/>create,delete,get,list,patch,watch"]
        end

        subgraph ExternalAPIs["External Read APIs"]
            KServe_RO["serving.kserve.io<br/>llminferenceservices<br/>get,list,watch"]
            DSCI_RO["dscinitialization.opendatahub.io<br/>dscinitializations<br/>get,list,watch"]
            Authorino_RO["operator.authorino.kuadrant.io<br/>authorinos<br/>get,list,watch"]
            OCP_Auth["config.openshift.io<br/>authentications<br/>get,list,watch"]
        end

        subgraph WorkloadAPIs["Workload APIs"]
            Apps_Deploy["apps<br/>deployments (+finalizers)<br/>full CRUD"]
            Batch_Jobs["batch<br/>cronjobs, jobs<br/>create,delete,get,list,patch,watch"]
            Coord_Leases["coordination.k8s.io<br/>leases<br/>full CRUD"]
            Disc_ES["discovery.k8s.io<br/>endpointslices<br/>list,watch"]
        end
    end

    subgraph InfraRole["Role: maas-controller-secret-migrate<br/>(redhat-ai-gateway-infra)"]
        Infra_Secrets["secrets<br/>create (general)<br/>get (maas-db-config only)"]
    end

    %% Bindings
    SA_AGO -->|bound via| CRB_Manager
    CRB_Manager -->|grants| ClusterRoles
    SA_AGO -->|bound via| RB_Leader
    SA_MaaS -->|bound via| RB_SecretMigrate
    RB_SecretMigrate -->|grants| InfraRole

