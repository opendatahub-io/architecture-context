graph LR
    RHOAIMCP["RHOAI MCP Server<br/>(Python / FastMCP)"]

    %% External Dependencies (Libraries)
    subgraph ExtLibs["External Libraries"]
        MCP["mcp SDK >=1.0.0"]
        K8sSDK["kubernetes >=28.1.0"]
        Pydantic["pydantic >=2.0.0"]
        HTTPX["httpx >=0.27.0"]
        Pluggy["pluggy >=1.4.0"]
        PyJWT["PyJWT[crypto] >=2.12.0"]
        Uvicorn["uvicorn"]
    end

    %% Internal Platform Dependencies (RHOAI Components)
    subgraph InternalDeps["Internal RHOAI Components"]
        KubeflowNotebook["Kubeflow Notebook Controller<br/>(kubeflow.org/v1 Notebook)"]
        KServe["KServe<br/>(serving.kserve.io/v1beta1<br/>InferenceService, ServingRuntime)"]
        DSPOperator["Data Science Pipelines Operator<br/>(DSPA CR)"]
        TrainingOp["Kubeflow Training Operator<br/>(trainer.kubeflow.org/v1<br/>TrainJob, ClusterTrainingRuntime)"]
        ModelReg["Model Registry / Model Catalog<br/>(REST API)"]
        Planner["Planner Backend<br/>(REST API)"]
        RHODSOp["rhods-operator<br/>(DataScienceCluster,<br/>AcceleratorProfile)"]
    end

    %% External Platform Dependencies
    subgraph ExtPlatform["External Platform Services"]
        K8sAPI["Kubernetes API Server"]
        OIDCProvider["OIDC Identity Provider<br/>(OpenShift OAuth)"]
        OCPRouter["OpenShift Router<br/>(Route CR)"]
        OCPUserAPI["OCP User API"]
    end

    %% Integration points (who calls RHOAI MCP)
    subgraph Consumers["Consumers"]
        AIAgents["AI Agents<br/>(Claude, ChatGPT, etc.)"]
    end

    %% Library dependencies
    RHOAIMCP -->|"MCP protocol"| MCP
    RHOAIMCP -->|"K8s API access"| K8sSDK
    RHOAIMCP -->|"config/validation"| Pydantic
    RHOAIMCP -->|"HTTP client"| HTTPX
    RHOAIMCP -->|"plugin framework"| Pluggy
    RHOAIMCP -->|"JWT validation"| PyJWT
    RHOAIMCP -->|"ASGI server"| Uvicorn

    %% Internal platform dependencies
    RHOAIMCP -->|"Notebook CRDs"| KubeflowNotebook
    RHOAIMCP -->|"InferenceService CRDs"| KServe
    RHOAIMCP -->|"DSPA CRDs"| DSPOperator
    RHOAIMCP -->|"TrainJob CRDs"| TrainingOp
    RHOAIMCP -->|"REST 8080/TCP"| ModelReg
    RHOAIMCP -->|"REST 8000/TCP"| Planner
    RHOAIMCP -->|"DSC/AcceleratorProfile CRDs"| RHODSOp

    %% External platform dependencies
    RHOAIMCP -->|"HTTPS 443/TCP<br/>CRUD, RBAC, impersonation"| K8sAPI
    RHOAIMCP -->|"HTTPS 443/TCP<br/>JWKS/TokenReview"| OIDCProvider
    RHOAIMCP -.->|"Route ingress"| OCPRouter
    RHOAIMCP -->|"HTTPS 443/TCP<br/>user groups"| OCPUserAPI

    %% Consumers
    AIAgents -->|"MCP (SSE/HTTP)<br/>8000/TCP"| RHOAIMCP

    %% Styling
    style RHOAIMCP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style MCP fill:#e8e8e8,stroke:#999
    style K8sSDK fill:#e8e8e8,stroke:#999
    style Pydantic fill:#e8e8e8,stroke:#999
    style HTTPX fill:#e8e8e8,stroke:#999
    style Pluggy fill:#e8e8e8,stroke:#999
    style PyJWT fill:#e8e8e8,stroke:#999
    style Uvicorn fill:#e8e8e8,stroke:#999

    style KubeflowNotebook fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style DSPOperator fill:#7ed321,stroke:#333,color:#fff
    style TrainingOp fill:#7ed321,stroke:#333,color:#fff
    style ModelReg fill:#7ed321,stroke:#333,color:#fff
    style Planner fill:#7ed321,stroke:#333,color:#fff
    style RHODSOp fill:#7ed321,stroke:#333,color:#fff

    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style OIDCProvider fill:#f5a623,stroke:#333,color:#fff
    style OCPRouter fill:#f5a623,stroke:#333,color:#fff
    style OCPUserAPI fill:#f5a623,stroke:#333,color:#fff

    style AIAgents fill:#f9f9f9,stroke:#333,stroke-width:2px
