graph LR
    AGO["AI Gateway Operator<br/>(Module Operator)"]

    %% Platform Operator (parent)
    ODHOperator["opendatahub-operator<br/>(creates AIGateway CR)"] -->|CRD Watch / Module Handler| AGO

    %% Sub-Components (deployed by AGO)
    AGO -->|"SSA deploy<br/>(batchGateway=Managed)"| BatchGW["batch-gateway-operator"]
    AGO -->|"SSA deploy<br/>(modelsAsAService=Managed)"| MaaSCtrl["maas-controller"]

    %% Internal Platform Dependencies (via maas-controller)
    MaaSCtrl -->|watches LLMInferenceService| KServe["KServe"]
    MaaSCtrl -->|creates AuthPolicy, TRLP, RLP| Kuadrant["Kuadrant"]
    MaaSCtrl -->|reads Authorino CR| Authorino["Authorino"]
    MaaSCtrl -->|creates DestinationRules,<br/>EnvoyFilters, ServiceEntries| Istio["Istio / Service Mesh"]
    MaaSCtrl -->|creates HTTPRoutes| GatewayAPI["Gateway API<br/>(maas-default-gateway)"]
    MaaSCtrl -->|creates Collectors| OTel["OpenTelemetry"]
    MaaSCtrl -->|creates Dashboards| Perses["Perses"]
    MaaSCtrl -->|watches/updates status| MaaSCRD["ModelsAsServices CR"]
    MaaSCtrl -->|creates Telemetries| IstioTelemetry["Istio Telemetry"]

    %% Internal Platform Dependencies (via batch-gateway-operator)
    BatchGW -->|creates Certificates| CertMgr["cert-manager"]

    %% Internal Platform Dependencies (via ai-gateway-operator)
    AGO -->|reads DSCI| DSCI["DSCInitialization"]
    AGO -->|creates namespace + RBAC| InfraNS["Infrastructure NS<br/>(redhat-ai-gateway-infra)"]

    %% External Dependencies (libraries)
    AGO -.->|v0.24.1| CR["controller-runtime"]
    AGO -.->|v2.8.1| ODHSDK["opendatahub-operator SDK"]
    AGO -.->|v1.3.0| GWAPI["gateway-api types"]

    %% Consumers (components that integrate with AGO's sub-components)
    Dashboard["ODH Dashboard"] -.->|manages models| MaaSCtrl
    Pipelines["Data Science Pipelines"] -.->|auto-deploy models| MaaSCtrl

    %% Styling
    style AGO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style BatchGW fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    style MaaSCtrl fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    style ODHOperator fill:#9b59b6,stroke:#333,color:#fff

    style KServe fill:#7ed321,stroke:#333
    style Kuadrant fill:#7ed321,stroke:#333
    style Authorino fill:#7ed321,stroke:#333
    style MaaSCRD fill:#7ed321,stroke:#333
    style DSCI fill:#7ed321,stroke:#333

    style Istio fill:#999,stroke:#333
    style GatewayAPI fill:#999,stroke:#333
    style CertMgr fill:#999,stroke:#333
    style OTel fill:#999,stroke:#333
    style Perses fill:#999,stroke:#333
    style IstioTelemetry fill:#999,stroke:#333

    style CR fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style ODHSDK fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style GWAPI fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5

    style InfraNS fill:#f5a623,stroke:#333
    style Dashboard fill:#ddd,stroke:#999,stroke-dasharray: 5 5
    style Pipelines fill:#ddd,stroke:#999,stroke-dasharray: 5 5
