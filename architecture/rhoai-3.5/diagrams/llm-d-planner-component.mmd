graph TB
    subgraph External["External Users & Services"]
        User[User / Data Scientist]
        HFHub["HuggingFace Hub API<br/>443/TCP HTTPS"]
        OpenAIAPI["OpenAI API<br/>443/TCP HTTPS"]
        VertexAI["Vertex AI<br/>443/TCP HTTPS"]
    end

    subgraph PlannerNamespace["Namespace: planner"]
        subgraph UITier["UI Tier"]
            StreamlitUI["Streamlit UI<br/>8501/TCP"]
        end

        subgraph APITier["API Tier"]
            Backend["Backend API (FastAPI)<br/>8000/TCP"]
            subgraph BackendModules["Backend Internal Modules"]
                CapacityPlanner["Capacity Planner<br/>GPU memory estimation"]
                GPURecommender["GPU Recommender<br/>Roofline model (BentoML)"]
                IntentExtractor["Intent Extractor<br/>LLM-powered NL parsing"]
                ConfigGenerator["Config Generator<br/>KServe / llm-d YAML"]
                RecommendationEngine["Recommendation Engine<br/>Multi-criteria scoring"]
                ClusterManager["Cluster Manager<br/>kubectl subprocess"]
                ModelCatalogSync["Model Catalog Sync<br/>Background daemon thread"]
            end
        end

        subgraph DataTier["Data Tier"]
            PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Benchmark storage"]
            Ollama["Ollama LLM<br/>11434/TCP<br/>qwen2.5:7b"]
        end

        DBInit["db-init Job<br/>Schema + benchmark loading"]
    end

    subgraph PlatformServices["Platform Services"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
        ModelCatalog["RHOAI Model Catalog<br/>8443/TCP HTTPS"]
        OpenShiftRouter["OpenShift Router<br/>443/TCP TLS edge"]
    end

    subgraph GeneratedTargets["Generated Deployment Targets"]
        KServe["KServe InferenceService CRs"]
        LLMdStack["llm-d Stack<br/>kustomize/Helm"]
    end

    %% User flows
    User -->|"HTTPS/443<br/>TLS edge"| OpenShiftRouter
    OpenShiftRouter -->|"HTTP/8501"| StreamlitUI
    OpenShiftRouter -->|"HTTP/8000"| Backend

    %% UI to Backend
    StreamlitUI -->|"HTTP/8000"| Backend

    %% Backend internal wiring
    Backend --- CapacityPlanner
    Backend --- GPURecommender
    Backend --- IntentExtractor
    Backend --- ConfigGenerator
    Backend --- RecommendationEngine
    Backend --- ClusterManager
    Backend --- ModelCatalogSync

    %% Backend to Data Tier
    Backend -->|"PostgreSQL/5432<br/>Password"| PostgreSQL
    IntentExtractor -->|"HTTP/11434"| Ollama

    %% Backend to External LLM providers
    IntentExtractor -.->|"HTTPS/443<br/>API Key"| OpenAIAPI
    IntentExtractor -.->|"HTTPS/443<br/>GCP creds"| VertexAI

    %% Backend to External Services
    CapacityPlanner -->|"HTTPS/443<br/>HF_TOKEN"| HFHub
    ModelCatalogSync -->|"HTTPS/8443<br/>SA token"| ModelCatalog
    ClusterManager -->|"HTTPS/6443<br/>SA token"| K8sAPI

    %% Config generation
    ConfigGenerator -.->|generates| KServe
    ConfigGenerator -.->|generates| LLMdStack

    %% DB init
    DBInit -->|"schema + data"| PostgreSQL

    %% Styles
    style Backend fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style StreamlitUI fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,stroke-width:2px,color:#fff
    style Ollama fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    style OpenShiftRouter fill:#ee0000,stroke:#333,stroke-width:2px,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,stroke-width:2px,color:#fff
    style ModelCatalog fill:#7ed321,stroke:#333,stroke-width:2px
    style HFHub fill:#ff9d00,stroke:#333,stroke-width:2px
    style OpenAIAPI fill:#74aa9c,stroke:#333,stroke-width:2px
    style VertexAI fill:#4285f4,stroke:#333,stroke-width:2px,color:#fff
    style KServe fill:#e8e8e8,stroke:#666
    style LLMdStack fill:#e8e8e8,stroke:#666
    style DBInit fill:#f5a623,stroke:#333,stroke-width:2px
    style CapacityPlanner fill:#d5e8ff,stroke:#4a90e2
    style GPURecommender fill:#d5e8ff,stroke:#4a90e2
    style IntentExtractor fill:#d5e8ff,stroke:#4a90e2
    style ConfigGenerator fill:#d5e8ff,stroke:#4a90e2
    style RecommendationEngine fill:#d5e8ff,stroke:#4a90e2
    style ClusterManager fill:#d5e8ff,stroke:#4a90e2
    style ModelCatalogSync fill:#d5e8ff,stroke:#4a90e2
