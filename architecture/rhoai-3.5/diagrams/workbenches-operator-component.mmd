graph TB
    subgraph WorkbenchesOperator["Workbenches Operator"]
        direction TB
        Controller["Workbenches Controller<br/>(controller-runtime)"]
        KustomizeRenderer["Kustomize Renderer<br/>(in-memory SSA)"]
        TLSConfig["TLS Config Manager<br/>(SecurityProfileWatcher)"]
        Controller -->|renders manifests| KustomizeRenderer
        Controller -->|uses| TLSConfig
    end

    subgraph Webhooks["Admission Webhooks (9443/TCP TLS)"]
        HWProfileWH["HardwareProfile Webhook<br/>/workbenches-hardware-profile<br/>(mutating)"]
        ConnectionWH["Connection Notebook Webhook<br/>/workbenches-connection-notebook<br/>(mutating + SAR)"]
    end

    subgraph ManagedComponents["Deployed Sub-Components (via SSA)"]
        KFNotebookCtrl["kf-notebook-controller<br/>(Kubeflow Notebook Controller)"]
        ODHNotebookCtrl["odh-notebook-controller<br/>(ODH Notebook Controller)"]
        ImageStreams["Notebook ImageStreams<br/>(11 workbenches + 14 runtimes)"]
    end

    %% CRDs
    WorkbenchesCR["Workbenches CR<br/>(cluster-scoped singleton)<br/>components.platform.opendatahub.io/v1alpha1"]
    NotebookCR["Notebook CR<br/>kubeflow.org"]
    HardwareProfileCR["HardwareProfile CR<br/>infrastructure.opendatahub.io"]

    %% External
    PlatformOperator["rhods-operator /<br/>opendatahub-operator"]
    K8sAPI["Kubernetes API Server"]
    OSAPIServer["OpenShift APIServer CR"]
    ConfigMap["odh-workbenches-config<br/>ConfigMap"]
    Prometheus["Prometheus<br/>8443/TCP"]

    %% Flows
    PlatformOperator -->|creates & manages| WorkbenchesCR
    PlatformOperator -->|writes| ConfigMap
    WorkbenchesCR -->|watched by| Controller
    ConfigMap -->|read by| Controller
    OSAPIServer -->|watched by| TLSConfig
    Controller -->|SSA patches| K8sAPI
    Controller -->|deploys| KFNotebookCtrl
    Controller -->|deploys| ODHNotebookCtrl
    Controller -->|deploys| ImageStreams

    K8sAPI -->|webhook call| HWProfileWH
    K8sAPI -->|webhook call| ConnectionWH
    HWProfileWH -->|reads| HardwareProfileCR
    HWProfileWH -->|mutates| NotebookCR
    ConnectionWH -->|validates secrets + SAR| K8sAPI
    ConnectionWH -->|mutates| NotebookCR

    Prometheus -->|scrapes /metrics| WorkbenchesOperator

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeRenderer fill:#4a90e2,stroke:#333,color:#fff
    style TLSConfig fill:#4a90e2,stroke:#333,color:#fff
    style HWProfileWH fill:#9b59b6,stroke:#333,color:#fff
    style ConnectionWH fill:#9b59b6,stroke:#333,color:#fff
    style KFNotebookCtrl fill:#27ae60,stroke:#333,color:#fff
    style ODHNotebookCtrl fill:#27ae60,stroke:#333,color:#fff
    style ImageStreams fill:#27ae60,stroke:#333,color:#fff
    style WorkbenchesCR fill:#f5a623,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style HardwareProfileCR fill:#f5a623,stroke:#333
    style PlatformOperator fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSAPIServer fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
