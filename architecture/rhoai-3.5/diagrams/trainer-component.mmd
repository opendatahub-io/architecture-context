graph TB
    subgraph "Kubeflow Trainer Operator"
        Controller["trainer-controller-manager<br/>(Go Operator)"]
        Webhook["Webhook Server<br/>9443/TCP HTTPS"]
        TLSMgr["TLS Profile Manager<br/>(pkg/tls)"]
        CertCtrl["cert-controller<br/>(OPA self-signed CA)"]

        subgraph "Plugin Framework"
            TorchPlugin["Torch Plugin<br/>(torchrun config)"]
            TorchTunePlugin["TorchTune Plugin<br/>(fine-tuning)"]
            MPIPlugin["MPI Plugin<br/>(SSH keys, hostfiles)"]
            DeepSpeedPlugin["DeepSpeed Plugin"]
            MLXPlugin["MLX Plugin"]
            CoSchedPlugin["CoScheduling Plugin<br/>(PodGroup)"]
            VolcanoPlugin["Volcano Plugin<br/>(PodGroup)"]
            JobSetPlugin["JobSet Plugin<br/>(resource builder)"]
        end

        subgraph "RHAI Extensions"
            Progression["Progression Tracker<br/>(metrics polling)"]
            NetPolicy["NetworkPolicy Module<br/>(pod isolation)"]
        end

        Controller --> Webhook
        Controller --> TLSMgr
        CertCtrl -->|rotates certs| Webhook
        Controller --> TorchPlugin
        Controller --> TorchTunePlugin
        Controller --> MPIPlugin
        Controller --> DeepSpeedPlugin
        Controller --> MLXPlugin
        Controller --> CoSchedPlugin
        Controller --> VolcanoPlugin
        Controller --> JobSetPlugin
        Controller --> Progression
        Controller --> NetPolicy
    end

    subgraph "Init Containers"
        DatasetInit["dataset-initializer<br/>(Python)"]
        ModelInit["model-initializer<br/>(Python)"]
    end

    subgraph "Experimental"
        DataCacheHead["data-cache (head)<br/>(Rust / Arrow Flight)"]
        DataCacheWorker["data-cache (worker)<br/>(Rust / DataFusion)"]
        DataCacheHead --> DataCacheWorker
    end

    User[User / SDK] -->|creates| TrainJobCR["TrainJob CR<br/>(trainer.kubeflow.org/v1alpha1)"]
    TrainJobCR -->|watched by| Controller

    Controller -->|resolves| TrainingRuntimeCR["TrainingRuntime CR"]
    Controller -->|resolves| ClusterTrainingRuntimeCR["ClusterTrainingRuntime CR"]

    Controller -->|creates| JobSetObj["JobSet<br/>(jobset.x-k8s.io/v1alpha2)"]
    JobSetObj -->|creates| TrainingPods["Training Pods<br/>(PyTorch/MPI/DeepSpeed)"]
    TrainingPods -->|use| DatasetInit
    TrainingPods -->|use| ModelInit

    Progression -->|polls /metrics<br/>28080/TCP HTTP| TrainingPods

    Controller -->|depends on| K8sAPI["Kubernetes API Server"]
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer CR"]
    NetPolicy -->|creates| NetworkPolicyCR["NetworkPolicy<br/>(per-TrainJob)"]

    CoSchedPlugin -->|creates| PodGroupSched["PodGroup<br/>(scheduler-plugins)"]
    VolcanoPlugin -->|creates| PodGroupVolcano["PodGroup<br/>(Volcano)"]

    Prometheus["Prometheus"] -->|scrapes 8443/TCP HTTPS| Controller

    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px
    style Webhook fill:#4a90e2,stroke:#333
    style TorchPlugin fill:#6cb4ee,stroke:#333
    style TorchTunePlugin fill:#6cb4ee,stroke:#333
    style MPIPlugin fill:#6cb4ee,stroke:#333
    style DeepSpeedPlugin fill:#6cb4ee,stroke:#333
    style MLXPlugin fill:#6cb4ee,stroke:#333
    style CoSchedPlugin fill:#6cb4ee,stroke:#333
    style VolcanoPlugin fill:#6cb4ee,stroke:#333
    style JobSetPlugin fill:#6cb4ee,stroke:#333
    style Progression fill:#f5a623,stroke:#333
    style NetPolicy fill:#f5a623,stroke:#333
    style TrainJobCR fill:#7ed321,stroke:#333
    style TrainingRuntimeCR fill:#7ed321,stroke:#333
    style ClusterTrainingRuntimeCR fill:#7ed321,stroke:#333
    style JobSetObj fill:#e8e8e8,stroke:#333
    style DataCacheHead fill:#d5d5d5,stroke:#999,stroke-dasharray: 5 5
    style DataCacheWorker fill:#d5d5d5,stroke:#999,stroke-dasharray: 5 5
    style DatasetInit fill:#b8d4e3,stroke:#333
    style ModelInit fill:#b8d4e3,stroke:#333
