    style S3 fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style DSPAOp fill:#7ed321,stroke:#333,color:#fff
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style DSPDB fill:#7ed321,stroke:#333,color:#fff
    style DSPS3 fill:#7ed321,stroke:#333,color:#fff
