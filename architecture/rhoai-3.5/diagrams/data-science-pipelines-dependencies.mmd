graph LR
    DSP["Data Science Pipelines<br/>(KFP v2 Backend)"]

    %% External Dependencies (Required)
    DSP -->|"workflow orchestration"| Argo["Argo Workflows<br/>v3.5 / v3.7 / v4.0"]
    DSP -->|"metadata storage<br/>3306/5432/TCP"| DB["MySQL v8 /<br/>PostgreSQL"]
    DSP -->|"execution lineage<br/>8080/TCP gRPC"| MLMD["ML Metadata<br/>(MLMD) 1.14.0"]
    DSP -->|"artifact storage<br/>9000/TCP S3 API"| S3["S3-compatible<br/>Object Store"]
    DSP -->|"cluster orchestration<br/>443/TCP HTTPS"| K8s["Kubernetes 1.29+"]

    %% Internal Platform Dependencies
    DSPAOp["DSPA Operator"] -->|"deploys & configures"| DSP
    RhodsOp["rhods-operator"] -->|"manages lifecycle"| DSPAOp
    DSPAOp -->|"deploys per-instance"| DSPDB["MariaDB / PostgreSQL<br/>(per-DSPA instance)"]
    DSPAOp -->|"deploys or references"| DSPS3["MinIO / S3<br/>(per-DSPA instance)"]

    %% Optional Dependencies
    DSP -.->|"experiment tracking<br/>HTTPS (plugin)"| MLflow["MLflow<br/>Tracking Server"]
    DSP -.->|"gRPC-to-HTTP proxy<br/>9090/TCP"| Envoy["Metadata Envoy<br/>Proxy"]

    %% Integration Points (components that consume DSP)
    DSP -->|"model deployment<br/>443/TCP HTTPS"| Seldon["Seldon Core<br/>(SeldonDeployment)"]

