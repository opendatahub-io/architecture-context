graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / SDK / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph ControllerPod["trainer-controller-manager"]
            Controller["Controller<br/>SA: kubeflow-trainer-controller-manager<br/>FIPS: strictfipsruntime"]
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>TLS 1.2+ (cluster profile)<br/>cert-controller CA"]
            MetricsSrv["Metrics Server<br/>8443/TCP HTTPS<br/>TLS 1.2+ (cluster profile)"]
            HealthSrv["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz"]
        end
    end

    subgraph TrainingNS["TRAINING NAMESPACE (per-tenant, NetworkPolicy enforced)"]
        direction TB

        subgraph TrainingPods["Training Pods (created by JobSet)"]
            TorchPeer["PyTorch Rendezvous<br/>29500/TCP TCP<br/>No encryption<br/>NetworkPolicy: same-JobSet only"]
            MPIPeer["MPI SSH<br/>22/TCP SSH<br/>ECDSA key pair<br/>Secret: per-TrainJob immutable"]
            MetricsEP["Metrics Endpoint<br/>28080/TCP HTTP<br/>No encryption<br/>NetworkPolicy: controller only"]
        end
    end

    subgraph ExternalServices["PLATFORM SERVICES"]
        OpenShiftAPI["OpenShift APIServer CR<br/>config.openshift.io/v1<br/>443/TCP HTTPS TLS 1.2+"]
        Prometheus["Prometheus<br/>(PodMonitor scrape)"]
    end

    %% External → Control Plane
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Control Plane → Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS 1.2+ (cluster profile)<br/>API Server TLS client cert<br/>Fail-closed"| WebhookSrv

    %% Controller → API Server
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>CRD CRUD, leader election"| K8sAPI

    %% Controller → OpenShift API
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Read TLS profile"| OpenShiftAPI

    %% Controller → Training Pods (metrics)
    Controller -->|"HTTP/28080<br/>No encryption<br/>NetworkPolicy enforced<br/>Progression tracking"| MetricsEP

    %% Prometheus → Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>PodMonitor"| MetricsSrv

    %% Training pod peer communication
    TorchPeer <-->|"TCP/29500<br/>No encryption<br/>NetworkPolicy"| TorchPeer
    MPIPeer <-->|"SSH/22<br/>ECDSA keys<br/>Immutable Secret"| MPIPeer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef training fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Controller,WebhookSrv,MetricsSrv,HealthSrv operator
    class TorchPeer,MPIPeer,MetricsEP training
    class OpenShiftAPI,Prometheus platform
