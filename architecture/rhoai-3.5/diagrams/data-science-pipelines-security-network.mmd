graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client (SDK / UI / CLI)"]
    end

    subgraph ControlPlane["CONTROL PLANE (Internal ClusterIP)"]
        direction TB

        APIServer["API Server (ml-pipeline)<br/>8888/TCP HTTP | 8887/TCP gRPC | 8443/TCP Webhooks<br/>SA: ml-pipeline<br/>AuthN: TokenReview (multi-user)<br/>AuthZ: SubjectAccessReview"]

        CacheServer["Cache Server<br/>443→8443/TCP HTTPS<br/>SA: kubeflow-pipelines-cache<br/>MutatingAdmissionWebhook<br/>TLS: webhook-server-tls Secret"]

        subgraph MetadataSvcs["Metadata Services"]
            MLMD["MLMD<br/>8080/TCP gRPC<br/>TLS optional<br/>Auth: None"]
            Envoy["Metadata Envoy<br/>9090/TCP HTTP<br/>gRPC-to-HTTP proxy"]
        end
    end

    subgraph ControllerZone["CONTROLLERS (Internal)"]
        direction TB
        PA["Persistence Agent<br/>SA: ml-pipeline-persistenceagent<br/>Projected SA token<br/>(audience: pipelines.kubeflow.org, 3600s)"]
        SWF["SWF Controller<br/>SA: ml-pipeline-scheduledworkflow<br/>Projected SA token<br/>9090/TCP metrics"]
        Viewer["Viewer Controller<br/>SA: ml-pipeline-viewer-crd-sa"]
    end

    subgraph WorkflowPods["ARGO WORKFLOW PODS (Ephemeral)"]
        direction TB
        DriverPod["Driver Pod<br/>SA: pipeline-runner<br/>DAG orchestration, CEL, caching"]
        LauncherPod["Launcher Pod<br/>SA: pipeline-runner<br/>User container execution"]
    end

    subgraph DataStores["DATA STORES"]
        DB["MySQL / PostgreSQL<br/>3306/5432/TCP<br/>DB wire protocol<br/>plaintext (configurable)<br/>Auth: username/password"]
        ObjectStore["S3 Object Store<br/>9000/TCP HTTP/HTTPS<br/>TLS optional<br/>Auth: Access Key / IRSA"]
    end

    subgraph Platform["PLATFORM DEPENDENCIES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>Auth: SA token"]
        ArgoAPI["Argo Workflows<br/>443/TCP HTTPS<br/>TLS<br/>Auth: SA token"]
        MLflow["MLflow (Optional)<br/>HTTPS<br/>TLS (CA bundle)<br/>Auth: Bearer Token"]
    end

    %% External → Control Plane
    Client -->|"HTTP/8888<br/>TLS optional<br/>Bearer Token / Header"| APIServer
    Client -->|"gRPC/8887<br/>TLS optional<br/>Bearer Token"| APIServer

    %% Control Plane → Data Stores
    APIServer -->|"DB/3306-5432<br/>plaintext<br/>username/password"| DB
    APIServer -->|"S3/9000<br/>TLS optional<br/>Access Key"| ObjectStore

    %% Control Plane → Platform
    APIServer -->|"HTTPS/443<br/>TLS<br/>SA token"| ArgoAPI
    APIServer -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    APIServer -->|"HTTPS<br/>TLS (CA bundle)<br/>Bearer Token"| MLflow

    %% Controllers → Control Plane
    PA -->|"gRPC/8887<br/>TLS optional<br/>Projected SA token"| APIServer
    SWF -->|"gRPC/8887<br/>TLS optional<br/>Projected SA token"| APIServer

    %% Controllers → Platform
    PA -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    SWF -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI

    %% Workflow Pods → Services
    DriverPod -->|"gRPC/8887<br/>TLS optional<br/>None"| APIServer
    DriverPod -->|"gRPC/8080<br/>TLS optional<br/>None"| MLMD
    LauncherPod -->|"S3/9000<br/>TLS optional<br/>K8s Secret"| ObjectStore
    LauncherPod -->|"gRPC/8080<br/>TLS optional<br/>None"| MLMD
    LauncherPod -->|"gRPC/8887<br/>TLS optional<br/>None"| APIServer

    %% Envoy → MLMD
    Envoy -->|"gRPC/8080"| MLMD

    %% Cache → K8s
    CacheServer -->|"HTTPS/443<br/>TLS<br/>K8s API cert"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workflow fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class APIServer,CacheServer,MLMD,Envoy controlplane
    class PA,SWF,Viewer controller
    class DriverPod,LauncherPod workflow
    class DB,ObjectStore datastore
    class K8sAPI,ArgoAPI,MLflow platform
