graph TB
    subgraph "ML Metadata (MLMD) Component"
        direction TB
        subgraph "gRPC Server (C++)"
            Server["metadata_store_server<br/>C++ Binary<br/>Port 8080/TCP"]
            ServiceImpl["MetadataStoreServiceImpl<br/>~45 gRPC RPCs"]
            MetadataStore["MetadataStore<br/>Core Business Logic"]
            Server --> ServiceImpl
            ServiceImpl --> MetadataStore
        end

        subgraph "Storage Abstraction"
            MetadataSource["MetadataSource<br/>(Abstract)"]
            MySQLSource["MySQLMetadataSource"]
            PostgreSQLSource["PostgreSQLMetadataSource"]
            SQLiteSource["SqliteMetadataSource"]
            MetadataStore --> MetadataSource
            MetadataSource --> MySQLSource
            MetadataSource --> PostgreSQLSource
            MetadataSource --> SQLiteSource
        end

        subgraph "Python Client Library"
            PyClient["ml_metadata Python Package<br/>(MetadataStore API)"]
            PyWrap["metadata_store_extension<br/>(pybind11 C++ Extension)"]
            PyClient -->|"gRPC mode"| Server
            PyClient -->|"embedded mode"| PyWrap
        end
    end

    %% External Clients
    KFP["Kubeflow Pipelines<br/>(ml-pipeline)"] -->|"gRPC/8080"| Server
    DSP["Data Science Pipelines<br/>(DSP)"] -->|"gRPC/8080"| Server
    KFPUI["KFP UI"] -->|"gRPC/8080<br/>(indirect)"| Server

    %% Database Backends
    MySQLSource -->|"TCP/3306<br/>MySQL protocol"| MySQL["MySQL / MariaDB"]
    PostgreSQLSource -->|"TCP/5432<br/>PostgreSQL protocol"| PostgreSQL["PostgreSQL"]
    SQLiteSource -->|"embedded"| SQLite["SQLite (file/memory)"]

    %% TLS
    BoringSSL["BoringSSL<br/>(Optional TLS/mTLS)"] -.->|"SSLConfig"| Server

    %% Styling
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style ServiceImpl fill:#4a90e2,stroke:#333,color:#fff
    style MetadataStore fill:#4a90e2,stroke:#333,color:#fff
    style MetadataSource fill:#6baed6,stroke:#333
    style MySQLSource fill:#6baed6,stroke:#333
    style PostgreSQLSource fill:#6baed6,stroke:#333
    style SQLiteSource fill:#6baed6,stroke:#333
    style PyClient fill:#9ecae1,stroke:#333
    style PyWrap fill:#9ecae1,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style KFPUI fill:#7ed321,stroke:#333
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style BoringSSL fill:#e8e8e8,stroke:#333
