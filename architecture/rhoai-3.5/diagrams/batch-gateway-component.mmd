graph TB
    subgraph BatchGateway["Batch Gateway System"]
        direction TB

        subgraph APIServer["API Server (batch-gateway-apiserver)"]
            APIHandler[REST API Handler<br/>8080/TCP]
            ObsServer[Observability Server<br/>8081/TCP]
            ReqMiddleware[Request Middleware<br/>Tenant Extraction]
            SecurityMiddleware[Security Headers<br/>Recovery Middleware]
            BatchHandler[Batch Handler<br/>/v1/batches]
            FileHandler[File Handler<br/>/v1/files]
            APIHandler --> ReqMiddleware
            ReqMiddleware --> SecurityMiddleware
            SecurityMiddleware --> BatchHandler
            SecurityMiddleware --> FileHandler
        end

        subgraph Processor["Batch Processor (batch-gateway-processor)"]
            Worker[Worker Pool<br/>Configurable goroutines]
            Poller[Job Poller<br/>Queue dequeue]
            Preprocessor[Preprocessor<br/>Per-model plan builder]
            Dispatcher[Dispatcher Chain<br/>PreDispatcher → AIMD → Direct/Async]
            Collector[Result Collector<br/>Output file assembly]
            Finalizer[Finalizer<br/>Status + file upload]
            Recovery[Crash Recovery<br/>Work dir scanner]
            ProcObs[Observability<br/>9090/TCP]
            Worker --> Poller
            Poller --> Preprocessor
            Preprocessor --> Dispatcher
            Dispatcher --> Collector
            Collector --> Finalizer
            Worker --> Recovery
        end

        subgraph GC["Garbage Collector (batch-gateway-gc)"]
            GCCollector[TTL Collector<br/>Expired job/file cleanup]
            Reconciler[Orphan Reconciler<br/>Stale job detection]
            GCMetrics[Metrics Server<br/>9091/TCP]
        end
    end

    %% External Client
    Client[External Client] -->|POST /v1/batches<br/>POST /v1/files| APIHandler

    %% Shared Data Layer
    subgraph DataLayer["Shared Data Layer"]
        PostgreSQL[(PostgreSQL<br/>5432/TCP)]
        Redis[(Redis / Valkey<br/>6379/TCP)]
        S3[(S3 Storage<br/>443/TCP)]
    end

    %% API Server connections to data layer
    BatchHandler -->|metadata CRUD| PostgreSQL
    BatchHandler -->|enqueue job| Redis
    FileHandler -->|file metadata| PostgreSQL
    FileHandler -->|upload/download| S3

    %% Processor connections to data layer
    Poller -->|dequeue jobs| Redis
    Preprocessor -->|read metadata| PostgreSQL
    Dispatcher -->|inference requests| InferenceRouter
    Collector -->|upload results| S3
    Finalizer -->|update status| PostgreSQL
    Finalizer -->|publish status| Redis

    %% GC connections to data layer
    GCCollector -->|query expired| PostgreSQL
    GCCollector -->|delete files| S3
    Reconciler -->|check in-flight| Redis
    Reconciler -->|update stale jobs| PostgreSQL

    %% External inference
    InferenceRouter[llm-d Router<br/>Inference Endpoint]

    %% Gateway
    Gateway[Gateway API<br/>HTTPRoute] -->|route /v1/*| APIHandler
    AuthPolicy[Kuadrant / Authorino<br/>Auth Enforcement] -->|validate| Gateway

    %% Monitoring
    Prometheus[Prometheus] -->|scrape| ObsServer
    Prometheus -->|scrape| ProcObs
    Prometheus -->|scrape| GCMetrics
    OTLPCollector[OTLP Collector] -.->|traces| APIServer
    OTLPCollector -.->|traces| Processor

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Processor fill:#7ed321,stroke:#333,color:#fff
    style GC fill:#f5a623,stroke:#333,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff
    style InferenceRouter fill:#9b59b6,stroke:#333,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style AuthPolicy fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#333
    style OTLPCollector fill:#e8e8e8,stroke:#333
