    AGPP -->|"labeled Secrets<br/>(ipp-managed)"| K8sSecrets["Kubernetes Secrets<br/>(provider credentials)"]
    AGPP -.->|"reads status<br/>httpRouteName"| MaasCtrl["maas-controller"]

    %% Integration Points (consumed by)
    MaasCtrl -->|"policy attachment"| AGPP

    %% Optional Dependencies
    AGPP -.->|"balance checks<br/>usage events"| Metering["Metering Service"]
    AGPP -.->|"input/output rails"| NeMo["NeMo Guardrails<br/>Service"]

    %% External LLM Providers
    AGPP -->|"inference<br/>API Key"| OpenAI["OpenAI<br/>api.openai.com"]
    AGPP -->|"inference<br/>API Key"| Anthropic["Anthropic<br/>api.anthropic.com"]
    AGPP -->|"inference<br/>SigV4"| Bedrock["AWS Bedrock<br/>bedrock-runtime.*.amazonaws.com"]
    AGPP -->|"inference<br/>OAuth2"| VertexAI["Google Vertex AI<br/>*-aiplatform.googleapis.com"]

    %% Helm dependency
    AGPP -->|"base chart"| HelmChart["llm-d payload-processor<br/>Helm chart v0.1.0-rc.3"]

