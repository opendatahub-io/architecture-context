graph LR
    AGPP["AI Gateway<br/>Payload Processing"]

    %% External Dependencies (frameworks/libraries)
    AGPP -->|"ext_proc framework<br/>plugin registry"| LLMD["llm-d IPP<br/>v0.1.0-rc.4"]
    AGPP -->|"CRD controllers"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    AGPP -->|"HTTPRoute types"| GatewayAPI["gateway-api<br/>v1.5.1"]
    AGPP -->|"SigV4 signing"| AWSSDK["aws-sdk-go-v2<br/>v1.42.1"]
    AGPP -->|"OAuth2 tokens"| GCPOAuth["golang.org/x/oauth2<br/>+ google"]

    %% Platform Dependencies (runtime)
    AGPP -->|"ext_proc filter<br/>data plane"| Envoy["Envoy Proxy<br/>(platform-managed)"]
    AGPP -->|"ServiceEntry<br/>DestinationRule<br/>TLS origination"| Istio["Istio Service Mesh<br/>v1"]
    AGPP -->|"CRD watches<br/>Secret reads<br/>resource CRUD"| K8sAPI["Kubernetes API<br/>Server"]
    AGPP -->|"HTTPRoute<br/>parent ref"| PlatformGW["Platform Gateway<br/>(maas-default-gateway)"]

