graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["ML Model / Application"]
        DataScientist["Data Scientist"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>feast-{name}-ui<br/>443/TCP HTTPS<br/>TLS Passthrough"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (ClusterIP Services)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace} (per-FeatureStore)"]
            direction TB
            OnlineService["feast-{name}-online<br/>6566/TCP HTTP | 6567/TCP HTTPS<br/>SA: feast-{name}<br/>Auth: OIDC/K8s RBAC + SecurityManager"]
            OfflineService["feast-{name}-offline<br/>8815/TCP HTTP | 8816/TCP HTTPS<br/>SA: feast-{name}<br/>Auth: OIDC/K8s RBAC"]
            RegistryGRPC["feast-{name}-registry-grpc<br/>6570/TCP gRPC | 6571/TCP gRPC+TLS<br/>SA: feast-{name}<br/>Auth: OIDC/K8s RBAC + SecurityManager"]
            RegistryREST["feast-{name}-registry-rest<br/>6572/TCP HTTP | 6573/TCP HTTPS<br/>SA: feast-{name}<br/>Auth: OIDC/K8s RBAC + SecurityManager"]
            UIService["feast-{name}-ui<br/>8888/TCP HTTP | 8443/TCP HTTPS<br/>Auth: None"]
            MetricsService["feast-{name}-metrics<br/>8000/TCP HTTP<br/>Auth: None"]
            CronJob["Materialization CronJob<br/>SA: feast-{name}"]
        end

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["feast-operator<br/>8081/TCP health | 8080/TCP metrics<br/>SA: feast-operator-controller-manager"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        Redis["Redis<br/>6379/TCP<br/>Optional TLS<br/>Password auth"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (require)<br/>Username/password"]
        DynamoDB["DynamoDB<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        BigTable["Google BigTable<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP SA"]
        CloudStorage["S3 / GCS / Azure Blob<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Cloud creds"]
        OIDCProvider["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        GitRepos["Git Repositories<br/>443/TCP HTTPS or 22/TCP SSH"]
    end

    subgraph K8sServices["KUBERNETES SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>SA Token"]
        OpenShiftAPI["OpenShift API<br/>443/TCP HTTPS<br/>TLS<br/>SA Token"]
    end

    %% External → Ingress
    DataScientist -->|"HTTPS/443<br/>TLS Passthrough"| Route
    Route -->|"HTTPS/8443<br/>TLS (service certs)"| UIService

    %% Client → Feature Server
    Client -->|"HTTP/6566 or HTTPS/6567<br/>OIDC/K8s Bearer Token"| OnlineService

    %% Internal flows
    OnlineService -->|"gRPC/6570 or HTTP/6572<br/>Intra-comm JWT (HMAC-SHA256)"| RegistryGRPC
    OnlineService -->|"Store-specific protocol<br/>Store credentials"| Redis
    OnlineService -->|"Store-specific protocol<br/>Store credentials"| PostgreSQL
    OnlineService -->|"HTTPS/443<br/>AWS IAM"| DynamoDB

    CronJob -->|"gRPC/6570<br/>Intra-comm JWT"| RegistryGRPC
    CronJob -->|"Store-specific<br/>Store credentials"| PostgreSQL
    CronJob -->|"Store-specific<br/>Store credentials"| Redis

    %% Operator flows
    Operator -->|"HTTPS/443<br/>TLS, SA Token"| K8sAPI
    Operator -->|"HTTPS/443<br/>TLS, SA Token"| OpenShiftAPI
    Operator -->|"HTTP/6572 or HTTPS/6573<br/>Intra-comm JWT<br/>⚠️ InsecureSkipVerify=true"| RegistryREST

    %% Feature server → external
    OnlineService -->|"HTTPS/443<br/>TLS 1.2+"| OIDCProvider
    OnlineService -->|"HTTPS/443<br/>TLS 1.2+, GCP SA"| BigTable
    OnlineService -->|"HTTPS/443<br/>TLS 1.2+"| CloudStorage

    UIService -->|"HTTP/6572<br/>Intra-comm JWT"| RegistryREST

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8sservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client,DataScientist external
    class Route ingress
    class OnlineService,OfflineService,RegistryGRPC,RegistryREST,UIService,MetricsService,CronJob internal
    class Operator operator
    class Redis,PostgreSQL,DynamoDB,BigTable,CloudStorage,OIDCProvider,GitRepos externalservice
    class K8sAPI,OpenShiftAPI k8sservice
