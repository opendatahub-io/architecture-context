graph TD
    subgraph PodIdentity["Pod Security Context"]
        UID["Container runs as<br/>UID: 1001 (non-root)"]
        NoSA["No ServiceAccount<br/>token automount<br/>(disabled by KServe defaulter)"]
    end

    subgraph AuthProxy["Authentication Layer (kube-rbac-proxy Sidecar)"]
        KRBP["kube-rbac-proxy<br/>Injected by KServe Controller"]
        TLS["TLS Termination<br/>8443/TCP HTTPS"]
        RBAC["RHOAI Platform RBAC<br/>Bearer Token Validation"]
        KRBP --> TLS
        TLS --> RBAC
    end

    subgraph KServeRBAC["KServe Controller RBAC (manages this component's lifecycle)"]
        KServeSA["ServiceAccount:<br/>kserve-controller-manager"]
        KServeCR["ClusterRole:<br/>kserve-manager-role"]
        KServeCRB["ClusterRoleBinding:<br/>kserve-manager-rolebinding"]

        KServeSA -->|"bound via"| KServeCRB
        KServeCRB -->|"grants"| KServeCR
    end

    subgraph KServeResources["Resources Managed by KServe Controller"]
        ISVC["serving.kserve.io<br/>InferenceService<br/>get, list, watch,<br/>create, update, patch, delete"]
        SR["serving.kserve.io<br/>ServingRuntime<br/>get, list, watch"]
        CSR["serving.kserve.io<br/>ClusterServingRuntime<br/>get, list, watch"]
        Pods["core<br/>Pods<br/>get, list, watch, create, delete"]
        Services["core<br/>Services<br/>get, list, watch, create,<br/>update, patch, delete"]
    end

    KServeCR -->|"manages"| ISVC
    KServeCR -->|"reads"| SR
    KServeCR -->|"reads"| CSR
    KServeCR -->|"manages"| Pods
    KServeCR -->|"manages"| Services

    subgraph StorageCreds["Storage Credentials (Injected by KServe)"]
        S3Creds["S3: AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>(env vars or ServiceAccount)"]
        GCSCreds["GCS: GCP Service Account<br/>(mounted credentials)"]
        AzureCreds["Azure: Azure credentials<br/>(env vars)"]
        HFCreds["HuggingFace: HF_TOKEN<br/>(env var, optional)"]
    end

    subgraph Webhooks["Admission Webhooks (External - KServe)"]
        MutWebhook["Mutating:<br/>inferenceservice.kserve-webhook-server.defaulter<br/>inferenceservice.kserve-webhook-server.pod-mutator"]
        ValWebhook["Validating:<br/>inferenceservice.kserve-webhook-server.validator<br/>servingruntime.kserve-webhook-server.validator"]
    end

    ISVC -->|"intercepted by"| MutWebhook
    ISVC -->|"intercepted by"| ValWebhook

    subgraph HealthProbes["Unauthenticated Endpoints"]
        Ready["/v2/health/ready<br/>8080/TCP HTTP<br/>No auth required"]
        Live["/v2/health/live<br/>8080/TCP HTTP<br/>No auth required"]
    end

    %% Connections
    RBAC -->|"proxies authed requests<br/>HTTP/8080 localhost"| UID
    KServeCR -->|"creates pods with<br/>sidecar + credentials"| PodIdentity

    %% Styling
    style UID fill:#4a90e2,color:#fff
    style NoSA fill:#4a90e2,color:#fff
    style KRBP fill:#e8744f,color:#fff
    style KServeSA fill:#9b59b6,color:#fff
    style KServeCR fill:#f5a623,color:#fff
    style ISVC fill:#7ed321,color:#fff
    style SR fill:#7ed321,color:#fff
    style CSR fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style Ready fill:#d5e8d4,stroke:#82b366
    style Live fill:#d5e8d4,stroke:#82b366
