graph TB
    subgraph ModelRegistry["Model Registry Component"]
        direction TB
        Proxy["model-registry proxy<br/>(Go REST Service)<br/>Port: 8080/TCP"]
        Controller["InferenceService Controller<br/>(Go controller-runtime)"]
        CSI["mr-storage-initializer<br/>(Go CLI / Init Container)"]
        AsyncUpload["async-upload Job<br/>(Python Job)"]
    end

    subgraph Clients["Clients"]
        UIBFF["Model Registry UI (BFF)"]
        CLI["CLI / SDK"]
    end

    subgraph KServeSystem["KServe"]
        ISVC["InferenceService CR<br/>(serving.kserve.io/v1beta1)"]
        KServeRuntime["KServe Runtime"]
    end

    subgraph Storage["Data Storage"]
        MySQL["MySQL 8.3+<br/>Port: 3306/TCP"]
        PostgreSQL["PostgreSQL 16+<br/>Port: 5432/TCP"]
    end

    subgraph ExternalStorage["External Storage"]
        S3["S3-compatible Storage"]
        OCI["OCI Container Registry"]
        HuggingFace["HuggingFace Hub"]
    end

    subgraph Security["Security Infrastructure"]
        Istio["Istio Service Mesh<br/>(mTLS + AuthorizationPolicy)"]
        Sigstore["Sigstore<br/>(Fulcio / Rekor)"]
    end

    %% Client flows
    UIBFF -->|REST API| Proxy
    CLI -->|REST API| Proxy

    %% Proxy to database
    Proxy -->|MySQL protocol| MySQL
    Proxy -->|PostgreSQL protocol| PostgreSQL

    %% Controller interactions
    Controller -->|watches| ISVC
    Controller -->|REST API| Proxy
    Controller -->|updates labels| ISVC

    %% CSI interactions
    KServeRuntime -->|init container| CSI
    CSI -->|resolves model-registry:// URIs| Proxy
    CSI -->|downloads artifacts| S3

    %% Async upload interactions
    AsyncUpload -->|downloads models| S3
    AsyncUpload -->|downloads models| OCI
    AsyncUpload -->|downloads models| HuggingFace
    AsyncUpload -->|uploads models| S3
    AsyncUpload -->|uploads models| OCI
    AsyncUpload -->|signs models| Sigstore
    AsyncUpload -->|registers metadata| Proxy

    %% Istio integration
    Istio -.->|mTLS + AuthZ| Proxy

    %% Styles
    style Proxy fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style CSI fill:#4a90e2,stroke:#333,color:#fff
    style AsyncUpload fill:#4a90e2,stroke:#333,color:#fff
    style ISVC fill:#f5a623,stroke:#333,color:#fff
    style MySQL fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style OCI fill:#f5a623,stroke:#333,color:#fff
    style HuggingFace fill:#f5a623,stroke:#333,color:#fff
    style Sigstore fill:#999,stroke:#333,color:#fff
