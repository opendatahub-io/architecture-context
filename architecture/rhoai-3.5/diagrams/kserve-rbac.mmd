graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["kserve-controller-manager"]
        SA_LLMCM["kserve-llmisvc-controller-manager"]
        SA_LM["kserve-localmodel-controller-manager"]
        SA_LMNA["kserve-localmodelnode-agent"]
        SA_NS["default (per namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_CM["kserve-manager-rolebinding<br/><i>cluster-wide</i>"]
        CRB_LLMCM["kserve-llmisvc-manager-rolebinding<br/><i>cluster-wide</i>"]
        CRB_LM["kserve-localmodel-rolebinding<br/><i>cluster-wide</i>"]
        CRB_LMNA["kserve-localmodelnode-rolebinding<br/><i>cluster-wide</i>"]
        CRB_ISVC["isvc-image-volume-scc<br/><i>per-namespace</i>"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_MGR["kserve-manager-role"]
        CR_LLMMGR["kserve-llmisvc-manager-role"]
        CR_LLMDISTRO["kserve-llmisvc-distro-role"]
        CR_LM["kserve-localmodel-role"]
        CR_LMNA["kserve-localmodelnode-role"]
        CR_ISVCDISTRO["kserve-inferenceservice-distro-role"]
    end

    %% SA to CRB
    SA_CM -->|bound via| CRB_CM
    SA_LLMCM -->|bound via| CRB_LLMCM
    SA_LM -->|bound via| CRB_LM
    SA_LMNA -->|bound via| CRB_LMNA
    SA_NS -->|bound via| CRB_ISVC

    %% CRB to CR
    CRB_CM -->|grants| CR_MGR
    CRB_LLMCM -->|grants| CR_LLMMGR
    CRB_LLMCM -->|grants| CR_LLMDISTRO
    CRB_LM -->|grants| CR_LM
    CRB_LMNA -->|grants| CR_LMNA
    CRB_ISVC -->|grants| CR_ISVCDISTRO

    subgraph Resources_MGR["kserve-manager-role Resources"]
        direction LR
        R_ISVC["serving.kserve.io<br/>InferenceService<br/>ServingRuntime<br/>ClusterServingRuntime<br/>ClusterStorageContainer<br/>LocalModelCache*<br/><i>get,list,watch,create,<br/>update,patch,delete</i>"]
        R_K8S["core / apps<br/>Deployments, Services,<br/>ConfigMaps, Secrets,<br/>Namespaces, Events,<br/>Pods, ServiceAccounts<br/><i>get,list,watch,create,<br/>update,patch,delete</i>"]
        R_NET["networking.k8s.io<br/>Ingresses<br/>gateway.networking.k8s.io<br/>HTTPRoutes, Gateways<br/>networking.istio.io<br/>VirtualServices<br/><i>get,list,watch,create,<br/>update,patch,delete</i>"]
        R_AUTO["autoscaling<br/>HPAs<br/>keda.sh<br/>ScaledObjects<br/>opentelemetry.io<br/>OTel Collectors<br/>serving.knative.dev<br/>Knative Services<br/><i>full CRUD</i>"]
        R_ADMIN["admissionregistration<br/>MutatingWebhookConfigs<br/>ValidatingWebhookConfigs<br/>route.openshift.io<br/>Routes (get,list,watch)<br/><i>full CRUD (webhooks)</i>"]
    end

    subgraph Resources_LLMMGR["kserve-llmisvc-manager-role Resources"]
        direction LR
        R_LLM["serving.kserve.io<br/>LLMInferenceService<br/>LLMInferenceServiceConfig<br/><i>full CRUD</i>"]
        R_LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSets<br/><i>full CRUD</i>"]
        R_POOL["inference.networking<br/>.x-k8s.io<br/>InferencePools<br/><i>full CRUD</i>"]
        R_DRA["resource.k8s.io<br/>ResourceClaims<br/>ResourceClaimTemplates<br/><i>full CRUD</i>"]
        R_MON["monitoring.coreos.com<br/>PodMonitors<br/>ServiceMonitors<br/><i>full CRUD</i>"]
        R_LLMD["llm-d.ai<br/>InferenceObjectives<br/>InferenceModelRewrites<br/><i>get,list,watch</i>"]
    end

    subgraph Resources_LLMDISTRO["kserve-llmisvc-distro-role Resources"]
        R_ISTIO_DR["networking.istio.io<br/>DestinationRules<br/><i>full CRUD</i>"]
        R_OS_ROUTE["route.openshift.io<br/>Routes<br/><i>get,list,watch</i>"]
        R_SCC["security.openshift.io<br/>SCCs<br/><i>use</i>"]
    end

    subgraph Resources_LM["kserve-localmodel-role Resources"]
        R_LMC["serving.kserve.io<br/>LocalModelCaches<br/>LocalModelNodes<br/>LocalModelNodeGroups<br/><i>full CRUD</i>"]
        R_STORAGE["core<br/>Nodes, PVs, PVCs<br/><i>full CRUD</i>"]
    end

    subgraph Resources_LMNA["kserve-localmodelnode-role Resources"]
        R_LMN["serving.kserve.io<br/>LocalModelNodes<br/>LocalModelNodeGroups<br/>ClusterStorageContainers<br/><i>full CRUD</i>"]
        R_BATCH["batch<br/>Jobs<br/><i>full CRUD</i>"]
    end

    subgraph Resources_ISVCDISTRO["kserve-inferenceservice-distro-role Resources"]
        R_RBAC["rbac.authorization.k8s.io<br/>RoleBindings<br/><i>full CRUD</i>"]
        R_ISVCSCC["security.openshift.io<br/>openshift-ai-inferenceservice-<br/>image-volume-scc<br/><i>use</i>"]
    end

    %% CR to Resources
    CR_MGR --> R_ISVC
    CR_MGR --> R_K8S
    CR_MGR --> R_NET
    CR_MGR --> R_AUTO
    CR_MGR --> R_ADMIN
    CR_LLMMGR --> R_LLM
    CR_LLMMGR --> R_LWS
    CR_LLMMGR --> R_POOL
    CR_LLMMGR --> R_DRA
    CR_LLMMGR --> R_MON
    CR_LLMMGR --> R_LLMD
    CR_LLMDISTRO --> R_ISTIO_DR
    CR_LLMDISTRO --> R_OS_ROUTE
    CR_LLMDISTRO --> R_SCC
    CR_LM --> R_LMC
    CR_LM --> R_STORAGE
    CR_LMNA --> R_LMN
    CR_LMNA --> R_BATCH
    CR_ISVCDISTRO --> R_RBAC
    CR_ISVCDISTRO --> R_ISVCSCC

