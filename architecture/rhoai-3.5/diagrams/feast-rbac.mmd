graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["feast-operator-<br/>controller-manager<br/>(redhat-ods-applications)"]
        SA_FeatureStore["feast-{name}<br/>(per-FeatureStore namespace)"]
        SA_Users["Groups / Users<br/>(from registry permissions)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["feast-operator-<br/>manager-rolebinding<br/>(cluster-scoped)"]
        CRB_FS["feast-{name}<br/>(cluster-scoped)"]
        CRB_Discover["feast-{ns}--{name}-discover<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_FS["feast-{name}<br/>(FeatureStore namespace)"]
        RB_Viewer["feast-{name}-viewer<br/>(FeatureStore namespace)"]
        RB_CronJob["feast-{name}-cronjob<br/>(FeatureStore namespace)"]
        RB_BatchEngine["feast-{name}-batch-engine<br/>(FeatureStore namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["feast-operator-manager-role"]
        CR_FS["feast-{name}<br/>(per-FeatureStore)"]
        CR_Discover["feast-discover-namespaces"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        R_FS["feast-{name}<br/>(namespace-scoped)"]
        R_Viewer["feast-{name}-viewer"]
        R_CronJob["feast-{name}-cronjob"]
        R_BatchEngine["feast-{name}-batch-engine"]
    end

    subgraph OperatorResources["feast-operator-manager-role Resources"]
        Res_Feast["feast.dev<br/>featurestores<br/>featurestores/status<br/>featurestores/finalizers"]
        Res_Apps["apps<br/>deployments"]
        Res_Core["core ('')<br/>services, configmaps,<br/>pvcs, serviceaccounts,<br/>namespaces, secrets,<br/>pods, pods/exec, pods/log"]
        Res_RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles,<br/>clusterrolebindings"]
        Res_Auth["authentication.k8s.io<br/>tokenreviews"]
        Res_Batch["batch<br/>cronjobs"]
        Res_Scaling["autoscaling<br/>horizontalpodautoscalers"]
        Res_Policy["policy<br/>poddisruptionbudgets"]
        Res_Monitoring["monitoring.coreos.com<br/>servicemonitors"]
        Res_Route["route.openshift.io<br/>routes"]
        Res_Config["config.openshift.io<br/>apiservers"]
        Res_Spark["sparkoperator.k8s.io<br/>sparkapplications"]
    end

    subgraph FSResources["feast-{name} ClusterRole Resources"]
        Res_TokenReview["authentication.k8s.io<br/>tokenreviews"]
        Res_SAR["rbac.authorization.k8s.io<br/>subjectaccessreviews"]
        Res_RBBindings["rbac.authorization.k8s.io<br/>rolebindings"]
        Res_Namespaces["core ('')<br/>namespaces"]
        Res_CRoles["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings"]
    end

    subgraph DiscoverResources["feast-discover-namespaces Resources"]
        Res_NS["core ('')<br/>namespaces"]
    end

    %% Operator SA bindings
    SA_Operator -->|"bound via"| CRB_Operator
    CRB_Operator -->|"grants"| CR_Manager

    %% Operator ClusterRole → Resources
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Res_Feast
    CR_Manager -->|"get,list,create,update,<br/>watch,delete"| Res_Apps
    CR_Manager -->|"get,list,watch,create,<br/>update,delete,<br/>deletecollection"| Res_Core
    CR_Manager -->|"get,list,watch,create,<br/>update,delete"| Res_RBAC
    CR_Manager -->|"create"| Res_Auth
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Res_Batch
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Res_Scaling
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Res_Policy
    CR_Manager -->|"get,list,watch,create,<br/>patch,delete"| Res_Monitoring
    CR_Manager -->|"get,list,create,update,<br/>watch,delete"| Res_Route
    CR_Manager -->|"get,list,watch"| Res_Config
    CR_Manager -->|"create,get,delete"| Res_Spark

    %% Per-FeatureStore SA bindings
    SA_FeatureStore -->|"bound via"| CRB_FS
    SA_FeatureStore -->|"bound via"| RB_FS
    SA_FeatureStore -->|"bound via"| RB_CronJob
    SA_FeatureStore -->|"bound via"| RB_BatchEngine
    CRB_FS -->|"grants"| CR_FS
    RB_FS -->|"grants"| R_FS
    RB_CronJob -->|"grants"| R_CronJob
    RB_BatchEngine -->|"grants"| R_BatchEngine

    %% Per-FeatureStore ClusterRole → Resources
    CR_FS -->|"create"| Res_TokenReview
    CR_FS -->|"create"| Res_SAR
    CR_FS -->|"list"| Res_RBBindings
    CR_FS -->|"get,list,watch"| Res_Namespaces
    CR_FS -->|"get,list"| Res_CRoles

    %% Viewer / Discover bindings
    SA_Users -->|"bound via"| RB_Viewer
    SA_Users -->|"bound via"| CRB_Discover
    RB_Viewer -->|"grants"| R_Viewer
    CRB_Discover -->|"grants"| CR_Discover
    CR_Discover -->|"get,list,watch"| Res_NS

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_FeatureStore fill:#4a90e2,stroke:#333,color:#fff
    style SA_Users fill:#4a90e2,stroke:#333,color:#fff

    style CR_Manager fill:#f5a623,stroke:#333
    style CR_FS fill:#f5a623,stroke:#333
    style CR_Discover fill:#f5a623,stroke:#333
    style R_FS fill:#e5a00d,stroke:#333
    style R_Viewer fill:#e5a00d,stroke:#333
    style R_CronJob fill:#e5a00d,stroke:#333
    style R_BatchEngine fill:#e5a00d,stroke:#333

    style Res_Feast fill:#7ed321,stroke:#333
    style Res_Apps fill:#7ed321,stroke:#333
    style Res_Core fill:#7ed321,stroke:#333
    style Res_RBAC fill:#7ed321,stroke:#333
    style Res_Auth fill:#7ed321,stroke:#333
    style Res_Batch fill:#7ed321,stroke:#333
    style Res_Scaling fill:#7ed321,stroke:#333
    style Res_Policy fill:#7ed321,stroke:#333
    style Res_Monitoring fill:#7ed321,stroke:#333
    style Res_Route fill:#7ed321,stroke:#333
    style Res_Config fill:#7ed321,stroke:#333
    style Res_Spark fill:#7ed321,stroke:#333
    style Res_TokenReview fill:#7ed321,stroke:#333
    style Res_SAR fill:#7ed321,stroke:#333
    style Res_RBBindings fill:#7ed321,stroke:#333
    style Res_Namespaces fill:#7ed321,stroke:#333
    style Res_CRoles fill:#7ed321,stroke:#333
    style Res_NS fill:#7ed321,stroke:#333
