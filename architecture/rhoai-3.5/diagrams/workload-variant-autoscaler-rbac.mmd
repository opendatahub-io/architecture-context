graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(wva-system)"]
        SA_EPP["epp-metrics-reader<br/>(wva-system)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_MGR["manager-rolebinding<br/>(Cluster)"]
        CRB_AUTH["metrics-auth-rolebinding<br/>(Cluster)"]
        CRB_READER["metrics-reader-rolebinding<br/>(Cluster, OpenShift)"]
        CRB_EPP["epp-metrics-reader-rolebinding<br/>(Cluster)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace)"]
        RB_LEADER["leader-election-rolebinding<br/>(wva-system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_MGR["manager-role"]
        CR_AUTH["metrics-auth-role"]
        CR_READER["metrics-reader-role"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles (Namespace)"]
        R_LEADER["leader-election-role<br/>(wva-system)"]
    end

    %% SA → Binding → Role connections
    SA_CM -->|bound via| CRB_MGR
    SA_CM -->|bound via| CRB_AUTH
    SA_CM -->|bound via| CRB_READER
    SA_CM -->|bound via| RB_LEADER
    SA_EPP -->|bound via| CRB_EPP

    CRB_MGR -->|grants| CR_MGR
    CRB_AUTH -->|grants| CR_AUTH
    CRB_READER -->|grants| CR_READER
    CRB_EPP -->|grants| CR_EPP
    RB_LEADER -->|grants| R_LEADER

    %% manager-role resources
    subgraph ManagerResources["manager-role Resources"]
        direction TB
        CoreRead["core: configmaps, namespaces,<br/>nodes, nodes/status, pods,<br/>resourcequotas, services<br/>▸ get, list, watch"]
        CoreEvents["core: events<br/>▸ create, patch"]
        AppsRW["apps: deployments<br/>▸ get, list, patch, update, watch<br/>apps: deployments/scale<br/>▸ get, update"]
        AppsRead["apps: replicasets, statefulsets<br/>▸ get, list, watch"]
        Autoscaling["autoscaling:<br/>horizontalpodautoscalers<br/>▸ get, list, patch, update, watch"]
        InferenceRead["inference.networking.k8s.io,<br/>inference.networking.x-k8s.io:<br/>inferencepools<br/>▸ get, list, watch"]
        KEDA["keda.sh: scaledobjects<br/>▸ get, list, patch, update, watch"]
        LWS["leaderworkerset.x-k8s.io:<br/>leaderworkersets<br/>▸ get, list, patch, update, watch<br/>leaderworkersets/scale<br/>▸ get, update"]
        Monitoring["monitoring.coreos.com:<br/>servicemonitors<br/>▸ get, list, watch"]
    end

    CR_MGR -->|permissions| CoreRead
    CR_MGR -->|permissions| CoreEvents
    CR_MGR -->|permissions| AppsRW
    CR_MGR -->|permissions| AppsRead
    CR_MGR -->|permissions| Autoscaling
    CR_MGR -->|permissions| InferenceRead
    CR_MGR -->|permissions| KEDA
    CR_MGR -->|permissions| LWS
    CR_MGR -->|permissions| Monitoring

    %% leader-election-role resources
    subgraph LeaderResources["leader-election-role Resources"]
        LeaderConfigMaps["core: configmaps<br/>▸ get, list, watch, create,<br/>update, patch, delete"]
        LeaderLeases["coordination.k8s.io: leases<br/>▸ get, list, watch, create,<br/>update, patch, delete"]
        LeaderEvents["core: events<br/>▸ create, patch"]
    end

    R_LEADER -->|permissions| LeaderConfigMaps
    R_LEADER -->|permissions| LeaderLeases
    R_LEADER -->|permissions| LeaderEvents

    %% metrics-auth-role resources
    subgraph AuthResources["metrics-auth-role Resources"]
        TokenReviews["authentication.k8s.io:<br/>tokenreviews<br/>▸ create"]
        SAR["authorization.k8s.io:<br/>subjectaccessreviews<br/>▸ create"]
    end

    CR_AUTH -->|permissions| TokenReviews
    CR_AUTH -->|permissions| SAR

    %% metrics-reader-role resources
    subgraph ReaderResources["metrics-reader-role Resources"]
        MetricsURL["/metrics (nonResourceURL)<br/>▸ get"]
    end

    CR_READER -->|permissions| MetricsURL

    %% epp-metrics-reader-role resources
    subgraph EPPReaderResources["epp-metrics-reader-role Resources"]
        EPPMetricsURL["/metrics (nonResourceURL)<br/>▸ get"]
    end

    CR_EPP -->|permissions| EPPMetricsURL

