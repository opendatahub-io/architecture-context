graph TD
    subgraph OperatorSA["Operator Service Account"]
        SA_DSPO["data-science-pipelines-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_AuthDeleg["ds-pipeline-ui-auth-delegator-<br/>{ns}-{name}"]
        CRB_Webhook["{webhook-name}<br/>(cluster-scoped)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_Webhook["{webhook-name}"]
    end

    subgraph ManagerPermissions["manager-role Permissions"]
        direction LR

        subgraph CoreAPI["Core API ('')"]
            Core_RW["configmaps, secrets,<br/>serviceaccounts<br/>create,delete,get,list,<br/>patch,update,watch"]
            Core_All["pvcs, pvs, services<br/>* (all verbs)"]
            Core_Pods["pods, pods/exec,<br/>pods/log<br/>* (all verbs)"]
        end

        subgraph AppsAPI["Apps API"]
            Apps_All["deployments,<br/>deployments/finalizers,<br/>replicasets<br/>* (all verbs)"]
        end

        subgraph DSPAApi["DSPA API<br/>(datasciencepipelinesapplications<br/>.opendatahub.io)"]
            DSPA_RW["datasciencepipelines-<br/>applications<br/>get,list,watch,create,<br/>update,patch,delete"]
            DSPA_Status["datasciencepipelines-<br/>applications/status<br/>get,update,patch"]
        end

        subgraph NetworkAPI["Network & Route API"]
            Route_RW["routes<br/>(route.openshift.io)<br/>get,list,watch,create,<br/>update,patch,delete"]
            NetPol_RW["networkpolicies<br/>(networking.k8s.io)<br/>get,list,watch,create,<br/>update,patch,delete"]
        end

        subgraph RBACAPI["RBAC API"]
            RBAC_RW["roles, rolebindings<br/>clusterroles, clusterrolebindings<br/>get,list,watch,create,<br/>update,patch,delete"]
        end

        subgraph WorkflowAPI["Workflow & Pipeline API"]
            Argo_All["workflows<br/>(argoproj.io)<br/>* (all verbs)"]
            KF_All["* (kubeflow.org)<br/>* (all verbs)"]
            Pipeline_RW["pipelines, pipelineversions<br/>(pipelines.kubeflow.org)<br/>create,get,list,watch,<br/>update,patch,delete"]
        end

        subgraph MLPlatformAPI["ML Platform API"]
            KServe_RW["inferenceservices<br/>(serving.kserve.io)<br/>create,get,list,<br/>patch,delete"]
            Ray_RW["rayclusters, rayjobs,<br/>rayservices (ray.io)<br/>create,get,list,<br/>patch,delete"]
            CF_RW["appwrappers<br/>(workload.codeflare.dev)<br/>create,delete,get,list,<br/>patch,update,watch"]
            Seldon_All["seldondeployments<br/>(machinelearning.seldon.io)<br/>* (all verbs)"]
            MLflow_R["mlflows<br/>(mlflow.opendatahub.io)<br/>get,list,watch"]
        end

        subgraph AuthAPI["Auth API"]
            SAR["subjectaccessreviews<br/>(authorization.k8s.io)<br/>create"]
            TR["tokenreviews<br/>(authentication.k8s.io)<br/>create"]
        end

        subgraph WebhookAPI["Webhook API"]
            MWC["mutatingwebhook-<br/>configurations<br/>create,get,update,list,<br/>watch,patch,delete"]
            VWC["validatingwebhook-<br/>configurations<br/>create,get,update,list,<br/>watch,patch,delete"]
        end
    end

    subgraph PerDSPARoles["Per-DSPA Namespace Roles"]
        direction TB
        Role_Pipeline["ds-pipeline-{name}<br/>API server SA role"]
        Role_Runner["pipeline-runner-{name}<br/>Pipeline execution role<br/>(workflows, pods, secrets,<br/>CRDs: KServe, Ray, etc.)"]
        Role_PA["ds-pipeline-persistenceagent-{name}<br/>Persistence agent role"]
        Role_SW["ds-pipeline-scheduledworkflow-{name}<br/>Scheduled workflow role"]
        Role_WC["ds-pipeline-workflow-controller-<br/>role-{name}<br/>Argo controller role"]
        Role_UserAccess["ds-pipeline-user-access-{name}<br/>End-user API access<br/>(DSPA API subresource)"]
    end

    subgraph PerDSPASAs["Per-DSPA Service Accounts"]
        SA_Pipeline["ds-pipeline-{name}"]
        SA_Runner["pipeline-runner-{name}"]
        SA_PA["ds-pipeline-persistenceagent-{name}"]
        SA_SW["ds-pipeline-scheduledworkflow-{name}"]
        SA_WC["ds-pipeline-workflow-controller-{name}"]
        SA_Webhook["{webhook-name}"]
    end

    %% Operator bindings
    SA_DSPO -->|"bound via"| CRB_Manager
    CRB_Manager -->|"grants"| CR_Manager
    CR_Manager --> ManagerPermissions

    %% Auth delegator
    SA_Pipeline -->|"bound via"| CRB_AuthDeleg
    CRB_AuthDeleg -->|"grants"| CR_AuthDeleg

    %% Webhook
    SA_Webhook -->|"bound via"| CRB_Webhook
    CRB_Webhook -->|"grants"| CR_Webhook

    %% Per-DSPA bindings
    SA_Pipeline -->|"bound to"| Role_Pipeline
    SA_Runner -->|"bound to"| Role_Runner
    SA_PA -->|"bound to"| Role_PA
    SA_SW -->|"bound to"| Role_SW
    SA_WC -->|"bound to"| Role_WC

    %% Styling
    style SA_DSPO fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_AuthDeleg fill:#f5a623,color:#fff
    style CR_Webhook fill:#f5a623,color:#fff
    style CRB_Manager fill:#b8e986
    style CRB_AuthDeleg fill:#b8e986
    style CRB_Webhook fill:#b8e986
    style SA_Pipeline fill:#4a90e2,color:#fff
    style SA_Runner fill:#4a90e2,color:#fff
    style SA_PA fill:#4a90e2,color:#fff
    style SA_SW fill:#4a90e2,color:#fff
    style SA_WC fill:#4a90e2,color:#fff
    style SA_Webhook fill:#4a90e2,color:#fff
    style Role_Pipeline fill:#7ed321,color:#fff
    style Role_Runner fill:#7ed321,color:#fff
    style Role_PA fill:#7ed321,color:#fff
    style Role_SW fill:#7ed321,color:#fff
    style Role_WC fill:#7ed321,color:#fff
    style Role_UserAccess fill:#7ed321,color:#fff
