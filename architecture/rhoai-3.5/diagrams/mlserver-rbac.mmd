graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["MLServer does not define Kubernetes RBAC.<br/>Authentication is delegated to platform infrastructure."]
    end

    subgraph PlatformAuth["Platform Authentication (External to MLServer)"]
        direction TB

        subgraph KServeLayer["KServe Layer"]
            KServeController["KServe Controller<br/>SA: kserve-controller-manager"]
            InferenceService["InferenceService CR<br/>Defines inference pod spec"]
        end

        subgraph PodLayer["Pod Layer (per InferenceService)"]
            KubeRBACProxy["kube-rbac-proxy Sidecar<br/>Injected by RHOAI operator"]
        end
    end

    subgraph MLServerAuth["MLServer Application-Level Security"]
        direction TB

        TrustedRuntimes["Trusted Runtimes Allowlist<br/>/etc/mlserver/trusted-runtimes.json<br/>Baked at build time"]
        ProductionMode["Production Mode Enforcement<br/>Blocks wildcard CORS origins<br/>Blocks env-path/tarball injection"]
        SecurityEndpoint["/v2/runtimes Endpoint<br/>Reports security mode<br/>(PRODUCTION/DEVELOPMENT)"]

        subgraph CPUAllowlist["CPU Image Trusted Runtimes"]
            RT1["mlserver_sklearn.SKLearnModel"]
            RT2["mlserver_xgboost.XGBoostModel"]
            RT3["mlserver_lightgbm.LightGBMModel"]
            RT4["mlserver_onnx.OnnxModel"]
        end

        subgraph CUDAAllowlist["CUDA Image Trusted Runtimes"]
            RT5["mlserver_onnx.OnnxModel"]
        end
    end

    subgraph Endpoints["Unauthenticated Endpoints (App-Level)"]
        REST["REST /v2/* endpoints<br/>8080/TCP - No auth"]
        GRPC["gRPC InferenceService<br/>8081/TCP - No auth"]
        Metrics["/metrics endpoint<br/>8082/TCP - No auth"]
    end

    %% Flows
    KServeController -->|"creates"| InferenceService
    InferenceService -->|"deploys pod with"| KubeRBACProxy
    KubeRBACProxy -->|"validates Bearer Token<br/>then forwards to"| REST
    KubeRBACProxy -->|"validates Bearer Token<br/>then forwards to"| GRPC
    TrustedRuntimes -->|"restricts loadable<br/>runtime classes"| CPUAllowlist
    TrustedRuntimes -->|"restricts loadable<br/>runtime classes"| CUDAAllowlist
    ProductionMode -->|"enforces"| SecurityEndpoint

    %% Styling
    style Legend fill:#f0f0f0,stroke:#ccc
    style L1 fill:#f0f0f0,stroke:none
    style KServeController fill:#4a90e2,color:#fff
    style InferenceService fill:#f5a623,color:#fff
    style KubeRBACProxy fill:#e74c3c,color:#fff
    style TrustedRuntimes fill:#82b366,color:#fff
    style ProductionMode fill:#82b366,color:#fff
    style SecurityEndpoint fill:#82b366,color:#fff
    style REST fill:#4a90e2,color:#fff
    style GRPC fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style RT1 fill:#fff2cc,stroke:#d6b656
    style RT2 fill:#fff2cc,stroke:#d6b656
    style RT3 fill:#fff2cc,stroke:#d6b656
    style RT4 fill:#fff2cc,stroke:#d6b656
    style RT5 fill:#fff2cc,stroke:#d6b656
