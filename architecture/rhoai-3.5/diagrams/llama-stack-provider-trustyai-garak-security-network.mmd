graph TB
    subgraph Cluster["KUBERNETES CLUSTER (OpenShift AI)"]
        direction TB

        subgraph JobNS["JOB NAMESPACE (per-scan ephemeral)"]
            direction LR
            Adapter["GarakAdapter Pod<br/>(K8s Job)<br/>SA: eval-hub managed<br/>Image: aipcc/cpu:3.5.0"]
            Sidecar["eval-hub Sidecar<br/>localhost / HTTP<br/>No encryption"]
            Adapter -->|"localhost/HTTP<br/>No encryption<br/>No auth"| Sidecar
        end

        subgraph KFPns["KFP NAMESPACE (KFP mode only)"]
            KFPPods["KFP Pipeline Pods<br/>6 steps: validate, resolve_taxonomy,<br/>sdg_generate, prepare_prompts,<br/>garak_scan, write_kfp_outputs<br/>Secrets via use_secret_as_env"]
        end

        subgraph ClusterSvc["CLUSTER SERVICES"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>mTLS (SA token)"]
            KFPAPI["KFP API Server<br/>8080 or 443/TCP HTTPS<br/>TLS (KFP_VERIFY_SSL)"]
        end

        Adapter -->|"443/TCP HTTPS<br/>mTLS / SA token<br/>Read Secrets, ConfigMaps"| K8sAPI
        Adapter -->|"8080 or 443/TCP HTTPS<br/>TLS / SA token or sidecar proxy<br/>Pipeline submit & poll"| KFPAPI
        KFPAPI -->|orchestrates| KFPPods
    end

    subgraph Models["MODEL ENDPOINTS (up to 7)"]
        direction TB
        Target["Target Model<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        Judge["Judge Model<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        Attacker["Attacker Model<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        Evaluator["Evaluator Model<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        SDGModel["SDG Model<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        Translation["Translation Model<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph Storage["EXTERNAL STORAGE"]
        direction TB
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
        OCI["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry credentials"]
        MLflow["MLflow Tracking<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph ExtSvc["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Optional token"]
    end

    %% Egress flows from Adapter/KFP
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token<br/>7-step key resolution"| Target
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| Judge
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| Attacker
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| Evaluator
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| SDGModel
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| Translation

    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / AWS IAM<br/>5-step cred resolution"| S3
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Registry creds"| OCI
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| MLflow
    Adapter -->|"443/TCP HTTPS<br/>TLS 1.2+ / Optional token"| HF

    KFPPods -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| Target
    KFPPods -->|"443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"| SDGModel
    KFPPods -->|"443/TCP HTTPS<br/>TLS 1.2+ / AWS IAM"| S3

    %% Styling
    classDef cluster fill:#f0f0f0,stroke:#666,stroke-width:2px
    classDef jobns fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef kfpns fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef clustersvc fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef model fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef extsvc fill:#f9f9f9,stroke:#999,stroke-width:2px

    class Adapter,Sidecar jobns
    class KFPPods kfpns
    class K8sAPI,KFPAPI clustersvc
    class Target,Judge,Attacker,Evaluator,SDGModel,Translation model
    class S3,OCI,MLflow storage
    class HF extsvc
