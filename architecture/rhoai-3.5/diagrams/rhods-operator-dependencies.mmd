graph LR
    RhodsOp["rhods-operator<br/>(Platform Operator)"]

    %% External Dependencies (Required)
    RhodsOp -->|"controller framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]
    RhodsOp -->|"ingress CRDs"| GatewayAPI["gateway-api<br/>v1.3.0"]
    RhodsOp -->|"Route, OAuth, Config"| OSApi["openshift/api<br/>v0.0.0-20260317"]
    RhodsOp -->|"OLM lifecycle"| OFApi["operator-framework/api<br/>v0.42.0"]
    RhodsOp -->|"manifest rendering"| ManifestKit["k8s-manifest-kit<br/>engine v0.2.1<br/>renderer-helm v0.3.1"]
    RhodsOp -->|"manifest processing"| Kustomize["kustomize/api<br/>v0.21.1"]
    RhodsOp -->|"monitoring CRDs"| PromOp["prometheus-operator<br/>v0.74.0"]
    RhodsOp -->|"chart orchestration"| Helm["helm/v4<br/>v4.1.1"]

    %% External Dependencies (Conditional)
    RhodsOp -.->|"MonitoringStack<br/>(if monitoring)"| COO["cluster-observability-<br/>operator"]
    RhodsOp -.->|"Tempo CRDs<br/>(if traces)"| TempoOp["tempo-operator"]
    RhodsOp -.->|"OTEL CRDs<br/>(if monitoring)"| OTELOp["opentelemetry-<br/>operator"]
    RhodsOp -.->|"PKI<br/>(CloudManager)"| CertMgr["cert-manager"]
    RhodsOp -.->|"EnvoyFilter, mTLS<br/>(Gateway auth)"| Istio["Sail operator<br/>(Istio)"]

    %% Internal RHOAI Components (Managed)
    RhodsOp -->|"kustomize deploy"| Dashboard["Dashboard"]
    RhodsOp -->|"kustomize + module"| KServe["KServe"]
    RhodsOp -->|"dynamic resources"| Kueue["Kueue"]
    RhodsOp -->|"kustomize deploy"| ModelReg["ModelRegistry"]
    RhodsOp -->|"kustomize deploy"| Workbenches["Workbenches"]
    RhodsOp -->|"kustomize deploy"| DSP["DataScience<br/>Pipelines"]
    RhodsOp -->|"kustomize deploy"| TrustyAI["TrustyAI"]
    RhodsOp -->|"kustomize deploy"| Ray["Ray"]
    RhodsOp -->|"kustomize deploy"| TrainingOp["TrainingOperator"]
    RhodsOp -->|"kustomize deploy"| Trainer["Trainer"]
    RhodsOp -->|"kustomize deploy"| Feast["FeastOperator"]
    RhodsOp -->|"kustomize deploy"| Spark["SparkOperator"]
    RhodsOp -->|"kustomize deploy"| ModelCtrl["ModelController"]

    %% Module-based Components
    RhodsOp -->|"Helm module"| AIGateway["AIGateway"]
    RhodsOp -->|"Helm module"| MLflow["MLflowOperator"]
    RhodsOp -->|"Kustomize module"| MCP["MCPLifecycle<br/>Operator"]

    %% Integration Points (External)
    RhodsOp -->|"CRD CRUD"| K8sAPI["Kubernetes API"]
    RhodsOp -->|"Routes, OAuth"| OSAPI["OpenShift API"]
    RhodsOp -->|"operator detection"| OLM["OLM"]
    RhodsOp -.->|"telemetry<br/>(self-managed)"| Segment["Segment.IO"]

    %% CloudManager Dependencies
    subgraph CloudDeps["CloudManager Dependencies (xKS only)"]
        CertMgrHelm["cert-manager<br/>(Helm)"]
        SailHelm["Sail/Istio<br/>(Helm)"]
        LWSHelm["LeaderWorkerSet<br/>(Helm)"]
        GatewayAPIHelm["Gateway API<br/>(Helm)"]
    end
    RhodsOp -.->|"cloud deploy"| CloudDeps

