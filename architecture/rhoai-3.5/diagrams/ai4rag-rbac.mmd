graph TD
    subgraph LibraryContext["ai4rag — RBAC Context"]
        direction TB

        Note["ai4rag is a Python library.<br/>It defines no Kubernetes RBAC resources<br/>(no ClusterRoles, Roles, or RoleBindings).<br/><br/>RBAC is inherited from the caller's<br/>ServiceAccount and execution environment."]
    end

    subgraph CallerRBAC["Caller's RBAC (Inherited)"]
        direction TB

        SA["Caller ServiceAccount<br/><i>e.g., pipeline-runner</i>"]
        RB["RoleBinding<br/><i>Inherited from KFP / user pod</i>"]
        Role["Role / ClusterRole<br/><i>Defined by platform</i>"]
    end

    subgraph RequiredAccess["Access Required by ai4rag at Runtime"]
        direction TB

        OGXAccess["OGX Server Access<br/><i>API Key authentication</i><br/><i>Not Kubernetes RBAC</i>"]
        S3Access["S3 Storage Access<br/><i>AWS IAM credentials</i><br/><i>Not Kubernetes RBAC</i>"]
        HFAccess["HuggingFace Hub Access<br/><i>Public — no auth required</i>"]
    end

    subgraph Secrets["Secrets ai4rag Needs to Read"]
        direction LR

        OGXKey["OGX API Key<br/><i>Opaque secret or env var</i>"]
        AWSCreds["AWS Credentials<br/><i>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY</i>"]
    end

    SA -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -.->|"must allow reading"| Secrets

    OGXKey -->|"used by"| OGXAccess
    AWSCreds -->|"used by"| S3Access

    %% Styling
    style LibraryContext fill:#f0f0f0,stroke:#999,stroke-width:1px
    style Note fill:#fff,stroke:#ccc
    style CallerRBAC fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style RequiredAccess fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    style Secrets fill:#f8cecc,stroke:#b85450,stroke-width:1px

    style SA fill:#4a90e2,color:#fff
    style OGXKey fill:#f5a623
    style AWSCreds fill:#f5a623
