graph LR
    DSPO["Data Science Pipelines<br/>Operator (DSPO)"]

    %% External Dependencies (required)
    DSPO -->|"operator framework"| CR["controller-runtime<br/>v0.23.3"]
    DSPO -->|"routes, TLS profile"| OSAPI["OpenShift API<br/>(route, config)"]
    DSPO -->|"template deployment"| Manifestival["manifestival<br/>v0.7.2"]
    DSPO -->|"S3 health checks"| MinioGo["minio-go<br/>v7.0.99"]
    DSPO -->|"DB health checks"| MySQL["go-sql-driver/mysql<br/>v1.9.3"]
    DSPO -->|"OCI manifest fetch"| ContainerReg["go-containerregistry<br/>v0.21.3"]
    DSPO -->|"configuration"| Viper["viper<br/>v1.21.0"]
    DSPO -->|"TLS security profile"| CRCommon["openshift/controller-<br/>runtime-common"]

    %% Internal Platform Dependencies
    DSPO -.->|"kustomize deployment"| RHODSOp["rhods-operator /<br/>opendatahub-operator"]
    DSPO -.->|"CA certificates"| TrustedCA["odh-trusted-ca-bundle<br/>ConfigMap"]
    DSPO -.->|"pod-to-pod TLS certs"| ServiceCA["OpenShift service-ca<br/>controller"]
    DSPO -.->|"Workflow CR execution"| Argo["Argo Workflows<br/>(argoproj.io)"]
    DSPO -.->|"pipeline CRDs"| Kubeflow["Kubeflow Pipelines CRDs<br/>(kubeflow.org)"]
    DSPO -.->|"tracking plugin"| MLflow["MLflow Operator<br/>(mlflow.opendatahub.io)"]

    %% Integration Points (downstream consumers)
    Dashboard["Data Science<br/>Dashboard"] -->|"UI: API + MLMD"| DSPO
    Workbenches["Workbenches<br/>(notebook pods)"] -->|"pipeline submission"| DSPO

    %% Pipeline Runner CRD integrations
    DSPO -.->|"InferenceService"| KServe["KServe<br/>(serving.kserve.io)"]
    DSPO -.->|"RayCluster/RayJob"| Ray["Ray<br/>(ray.io)"]
    DSPO -.->|"AppWrapper"| CodeFlare["CodeFlare<br/>(workload.codeflare.dev)"]
    DSPO -.->|"SeldonDeployment"| Seldon["Seldon<br/>(machinelearning.seldon.io)"]
    DSPO -.->|"ServiceMonitor"| Prometheus["Prometheus<br/>(monitoring.coreos.com)"]

    %% External Services
    DSPO -->|"artifact storage<br/>9000/TCP or 443/TCP"| S3["S3 Storage<br/>(MinIO / External)"]
    DSPO -->|"metadata storage<br/>3306/TCP"| MariaDB["MariaDB<br/>(Internal / External)"]
    DSPO -->|"managed pipelines<br/>443/TCP"| OCI["OCI Registry"]
    DSPO -->|"resource management<br/>6443/TCP"| K8sAPI["Kubernetes API"]

    %% Styling
    style DSPO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps (required libraries)
    style CR fill:#999,stroke:#333,color:#fff
    style OSAPI fill:#999,stroke:#333,color:#fff
