graph TB
    subgraph Operator["Model Registry Operator"]
        direction TB
        subgraph Controllers["Controllers"]
            MRReconciler["ModelRegistryReconciler<br/>Reconciles per-instance<br/>model registry deployments"]
            MCReconciler["ModelCatalogReconciler<br/>Manages singleton model catalog<br/>with PostgreSQL + catalog data"]
            SPWatcher["SecurityProfileWatcher<br/>Watches OpenShift TLS<br/>security profile changes"]
        end

        subgraph Background["Background Processes"]
            SVM["StorageMigrationManager<br/>v1alpha1→v1beta1 migration<br/>via StorageVersionMigration API"]
        end

        subgraph Webhooks["Admission Webhooks (9443/TCP)"]
            MutatingWH["Mutating Webhook<br/>Defaults CR fields:<br/>auth proxy, ports, images"]
            ValidatingWH["Validating Webhook<br/>Namespace constraint,<br/>DB config, unique names"]
            ConversionWH["Conversion Webhook<br/>v1alpha1 ↔ v1beta1"]
        end
    end

    %% CRDs
    MR_CR["ModelRegistry CR<br/>(v1beta1 - storage version)<br/>modelregistry.opendatahub.io"]
    MR_CR_Legacy["ModelRegistry CR<br/>(v1alpha1 - deprecated)<br/>modelregistry.opendatahub.io"]

    %% Owned Resources per ModelRegistry
    subgraph PerRegistry["Per-Registry Resources (owned)"]
        Deploy["Deployment<br/>model-registry REST +<br/>kube-rbac-proxy sidecar"]
        Svc["Service<br/>8443/TCP (HTTPS)<br/>8080/TCP (HTTP)"]
        SA["ServiceAccount"]
        Role["Role + RoleBinding"]
        NP["NetworkPolicy"]
        Route["Route (OpenShift)<br/>TLS reencrypt"]
        HTTPRoute["HTTPRoute (Gateway API)<br/>path-based routing"]
        PGDeploy["PostgreSQL Deployment<br/>(auto-provisioned, optional)"]
    end

    %% Catalog Resources
    subgraph CatalogResources["Model Catalog Resources (owned)"]
        CatalogDeploy["Catalog Deployment<br/>REST + kube-rbac-proxy"]
        CatalogPG["Catalog PostgreSQL"]
        CatalogCM["Catalog Data ConfigMaps"]
        CatalogRBAC["Admin Roles +<br/>RoleBindings"]
    end

    %% External Dependencies
    K8sAPI["Kubernetes API Server<br/>6443/TCP"]
    Gateway["Data Science Gateway<br/>(shared platform gateway)"]
    ServiceCA["OpenShift service-ca<br/>TLS cert provisioning"]
    AuthCR["Auth CR<br/>services.platform.opendatahub.io<br/>Admin groups"]
    PlatformMR["ModelRegistries CR<br/>components.platform.opendatahub.io<br/>Platform operator"]

    %% Relationships
    MR_CR -->|watched by| MRReconciler
    MR_CR_Legacy -->|converted by| ConversionWH
    MRReconciler -->|creates/updates| Deploy
    MRReconciler -->|creates/updates| Svc
    MRReconciler -->|creates/updates| SA
    MRReconciler -->|creates/updates| Role
    MRReconciler -->|creates/updates| NP
    MRReconciler -->|creates/updates| Route
    MRReconciler -->|creates/updates| HTTPRoute
    MRReconciler -->|provisions| PGDeploy

    MCReconciler -->|creates/updates| CatalogDeploy
    MCReconciler -->|creates/updates| CatalogPG
    MCReconciler -->|manages| CatalogCM
    MCReconciler -->|creates/updates| CatalogRBAC
    AuthCR -->|watched by| MCReconciler
    PlatformMR -->|referenced by| MCReconciler

    HTTPRoute -->|references| Gateway
    ServiceCA -->|provisions TLS for| Deploy
    SPWatcher -->|triggers restart on change| Operator

    MRReconciler -->|CRUD via| K8sAPI
    MCReconciler -->|CRUD via| K8sAPI
    SVM -->|creates migrations via| K8sAPI

    MutatingWH -->|defaults| MR_CR
    ValidatingWH -->|validates| MR_CR

    %% Styling
    style Operator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Controllers fill:#bbdefb,stroke:#1976d2
    style Webhooks fill:#c8e6c9,stroke:#388e3c
    style Background fill:#fff3e0,stroke:#ef6c00
    style PerRegistry fill:#f3e5f5,stroke:#7b1fa2
    style CatalogResources fill:#fce4ec,stroke:#c62828
    style MR_CR fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    style MR_CR_Legacy fill:#fff9c4,stroke:#f9a825,stroke-dasharray: 5 5
    style K8sAPI fill:#e0e0e0,stroke:#616161
    style Gateway fill:#e0e0e0,stroke:#616161
    style ServiceCA fill:#e0e0e0,stroke:#616161
    style AuthCR fill:#fff9c4,stroke:#f9a825
    style PlatformMR fill:#fff9c4,stroke:#f9a825
