graph LR
    WO[Workbenches Operator]

    %% External Dependencies (libraries/frameworks)
    WO -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    WO -->|"manifest rendering"| KustomizeAPI["kustomize/api<br/>v0.21.1"]
    WO -->|"TLS profile types"| OpenshiftAPI["openshift/api<br/>v0.0.0-20260317"]
    WO -->|"TLS profile watcher"| OpenshiftCRC["openshift/controller-<br/>runtime-common<br/>v0.0.0-20260428"]
    WO -->|"JSON patch generation"| JSONPatch["gomodules.xyz/<br/>jsonpatch/v2<br/>v2.4.0"]

    %% Internal Platform Dependencies
    WO -->|"CRD orchestration"| PlatformOperator["rhods-operator /<br/>opendatahub-operator"]
    WO -->|"deploys (SSA)"| KFNotebookCtrl["kf-notebook-controller"]
    WO -->|"deploys (SSA)"| ODHNotebookCtrl["odh-notebook-controller"]
    WO -->|"deploys (SSA)"| NotebookImages["Notebook ImageStreams<br/>(11 workbenches +<br/>14 runtimes)"]

    %% CRD Dependencies
    WO -->|"webhook intercept"| NotebookCR["kubeflow.org<br/>Notebook CR"]
    WO -->|"webhook reads"| HardwareProfileCR["infrastructure.opendatahub.io<br/>HardwareProfile CR"]

    %% Infrastructure Dependencies
    WO -->|"API server"| K8sAPI["Kubernetes API<br/>Server"]
    WO -->|"TLS profile"| OSAPIServer["OpenShift<br/>APIServer CR"]
    WO -->|"TLS certs"| CertManager["cert-manager"]

    %% Integration Points (consumers of this operator)
    PlatformOperator -->|"creates CR"| WO
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>8443/TCP"| WO

    %% Version handshake
    WO -->|"reads/writes"| ConfigMap["odh-workbenches-<br/>config ConfigMap"]
    PlatformOperator -->|"writes"| ConfigMap

    %% Styling
    style WO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External libraries
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style KustomizeAPI fill:#999,stroke:#333,color:#fff
    style OpenshiftAPI fill:#999,stroke:#333,color:#fff
    style OpenshiftCRC fill:#999,stroke:#333,color:#fff
    style JSONPatch fill:#999,stroke:#333,color:#fff

    %% Internal platform
    style PlatformOperator fill:#7ed321,stroke:#333,color:#fff
    style KFNotebookCtrl fill:#27ae60,stroke:#333,color:#fff
    style ODHNotebookCtrl fill:#27ae60,stroke:#333,color:#fff
    style NotebookImages fill:#27ae60,stroke:#333,color:#fff

    %% CRDs
    style NotebookCR fill:#f5a623,stroke:#333
    style HardwareProfileCR fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333

    %% Infrastructure
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSAPIServer fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
