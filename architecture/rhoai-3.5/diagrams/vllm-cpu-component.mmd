graph TB
    subgraph vLLMCPU["vLLM CPU Inference Service"]
        direction TB

        subgraph PythonLayer["Python Layer"]
            APIServer["vllm-openai<br/>FastAPI + Uvicorn<br/>Port 8000/TCP"]
            AuthMiddleware["AuthenticationMiddleware<br/>Bearer Token (SHA256)"]
            Scheduler["Continuous Batching<br/>Scheduler"]
            Engine["vLLM Engine Core<br/>PyTorch 2.11.0+cpu"]
            KVCache["KV Cache Manager<br/>Blocked Memory Allocation"]
            GRPCServer["gRPC Server<br/>Port 50051/TCP"]
        end

        subgraph RustLayer["Rust Frontend (vllm-rs via PyO3)"]
            Tokenizer["Tokenizer<br/>(High-perf)"]
            ChatTemplate["Chat Template<br/>Renderer (minijinja)"]
            ToolParser["Tool Call<br/>Parser"]
            ReasoningParser["Reasoning<br/>Parser"]
        end

        subgraph NativeLayer["C/C++ Extensions (CMake)"]
            AttentionKernels["CPU Attention Kernels<br/>AVX2 / AVX512"]
            CustomOps["Custom Ops<br/>(x86_64 optimized)"]
        end
    end

    %% Internal flows
    APIServer -->|validates| AuthMiddleware
    APIServer -->|tokenizes via| Tokenizer
    APIServer -->|renders| ChatTemplate
    APIServer -->|parses| ToolParser
    APIServer -->|schedules| Scheduler
    Scheduler -->|batches| Engine
    Engine -->|manages| KVCache
    Engine -->|calls| AttentionKernels
    Engine -->|calls| CustomOps
    GRPCServer -->|schedules| Scheduler

    %% External actors
    Client["Client<br/>(via KServe HTTPRoute)"] -->|POST /v1/chat/completions<br/>HTTP 8000/TCP| APIServer
    GRPCClient["gRPC Client"] -->|Inference Request<br/>gRPC 50051/TCP| GRPCServer
    Prometheus["Prometheus"] -->|GET /metrics<br/>HTTP 8000/TCP| APIServer
    Engine -->|reads| ModelWeights["Model Weights<br/>(PVC / Local FS)"]
    APIServer -->|OTLP traces| OTelCollector["OpenTelemetry<br/>Collector"]

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style GRPCServer fill:#4a90e2,stroke:#333,color:#fff
    style AuthMiddleware fill:#e8744f,stroke:#333,color:#fff
    style Scheduler fill:#4a90e2,stroke:#333,color:#fff
    style Engine fill:#4a90e2,stroke:#333,color:#fff
    style KVCache fill:#4a90e2,stroke:#333,color:#fff
    style Tokenizer fill:#d4762c,stroke:#333,color:#fff
    style ChatTemplate fill:#d4762c,stroke:#333,color:#fff
    style ToolParser fill:#d4762c,stroke:#333,color:#fff
    style ReasoningParser fill:#d4762c,stroke:#333,color:#fff
    style AttentionKernels fill:#7b5ea7,stroke:#333,color:#fff
    style CustomOps fill:#7b5ea7,stroke:#333,color:#fff
    style Client fill:#f5f5f5,stroke:#999
    style GRPCClient fill:#f5f5f5,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#999
    style ModelWeights fill:#f5a623,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#999
