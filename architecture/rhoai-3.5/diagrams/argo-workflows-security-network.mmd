graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User[User / DSP API]
        Webhooks[Webhook Providers<br/>GitHub, GitLab, Bitbucket]
    end

    subgraph Cluster["CLUSTER SERVICES (Internal)"]
        direction TB

        K8sAPI[Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token]

        subgraph ControllerNS["Controller Namespace"]
            WC["workflow-controller<br/>SA: argo<br/>9090/TCP metrics (HTTP/HTTPS)<br/>6060/TCP healthz (HTTP)"]
            ArgoServer["argo-server<br/>SA: argo-server<br/>2746/TCP HTTPS<br/>TLS 1.2+ (ECDSA P-256)<br/>Bearer / SSO / Server SA"]
        end

        subgraph WorkflowNS["Workflow Pod Namespaces"]
            AE["argoexec (emissary)<br/>SA: workflow-specified<br/>No network listeners<br/>Filesystem IPC via /var/run/argo/"]
        end

        Prometheus["Prometheus<br/>Scrapes 9090/TCP"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>(MinIO, AWS S3)<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM / Secret"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS TLS 1.2+<br/>GCP IAM / SA Key"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS TLS 1.2+<br/>Azure AD / Secret"]
        PG["PostgreSQL<br/>5432/TCP SSL<br/>Secret credentials"]
        MySQL["MySQL<br/>3306/TCP<br/>Secret credentials"]
        OIDC["OIDC Provider<br/>443/TCP HTTPS TLS 1.2+<br/>OAuth2 client credentials"]
    end

    %% External → Cluster flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    Webhooks -->|"HTTPS/2746<br/>TLS 1.2+<br/>Webhook Signature"| ArgoServer

    %% Internal flows
    K8sAPI -->|"HTTPS/443<br/>Informer watches<br/>SA Token"| WC
    WC -->|"HTTPS/443<br/>Create/Update CRDs, Pods<br/>SA Token"| K8sAPI
    WC -->|"Creates pods with"| AE
    AE -->|"HTTPS/443<br/>Patch TaskResult CRs<br/>SA Token"| K8sAPI
    Prometheus -->|"HTTP(S)/9090<br/>Optional Bearer Token"| WC
    ArgoServer -->|"HTTPS/443<br/>SA Token"| K8sAPI

    %% Egress flows
    AE -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM / Secret"| S3
    WC -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM / Secret"| S3
    AE -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP IAM"| GCS
    AE -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure AD"| Azure
    WC -->|"TCP/5432<br/>SSL<br/>Secret creds"| PG
    WC -->|"TCP/3306<br/>Secret creds"| MySQL
    ArgoServer -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2"| OIDC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef executor fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User,Webhooks external
    class K8sAPI k8s
    class WC,ArgoServer controller
    class AE executor
    class S3,GCS,Azure,PG,MySQL,OIDC externalservice
    class Prometheus cluster
