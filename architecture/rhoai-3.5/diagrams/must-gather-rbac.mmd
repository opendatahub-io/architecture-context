graph TD
    subgraph "OpenShift (OCP) Path"
        direction TB

        subgraph OCPInvocation["Invocation"]
            OCPAdmin["Cluster Admin<br/>(oc adm must-gather)"]
        end

        subgraph OCPFramework["oc adm must-gather Framework"]
            OCPSA["Temporary ServiceAccount<br/>(auto-provisioned)"]
            OCPCRB["ClusterRoleBinding<br/>(auto-provisioned)"]
            OCPCR["cluster-admin<br/>(built-in ClusterRole)"]
        end

        subgraph OCPResources["API Resources (full access)"]
            direction LR
            OCPAll["All API Groups<br/>All Resources<br/>All Verbs"]
        end

        OCPAdmin -->|"provisions"| OCPSA
        OCPSA -->|"bound via"| OCPCRB
        OCPCRB -->|"grants"| OCPCR
        OCPCR -->|"full cluster access"| OCPAll
    end

    subgraph "Non-OpenShift (xKS) Path"
        direction TB

        subgraph XKSSetup["Manual Setup (user-created)"]
            XKSAdmin["Cluster Admin<br/>(kubectl apply Job)"]
        end

        subgraph XKSServiceAccount["Service Account"]
            XKSSA["must-gather-sa<br/>(user-created)"]
        end

        subgraph XKSBinding["ClusterRole Binding"]
            XKSCRB["must-gather-reader-binding<br/>(cluster-scoped)"]
        end

        subgraph XKSRole["ClusterRole Permissions"]
            XKSCR["must-gather-reader<br/>(user-created)"]
        end

        subgraph XKSResources["API Resources"]
            direction LR
            XKSAllGroups["API Groups: *"]
            XKSAllResources["Resources: *"]
            XKSVerbs["Verbs: get, list, watch<br/>(read-only)"]
        end

        XKSAdmin -->|"creates"| XKSSA
        XKSSA -->|"bound via"| XKSCRB
        XKSCRB -->|"grants"| XKSCR
        XKSCR -->|"read access"| XKSAllGroups
        XKSCR -->|"read access"| XKSAllResources
        XKSCR -->|"limited to"| XKSVerbs
    end

    subgraph "Image Pull Secret (xKS only)"
        direction TB
        PullSecret["redhat-pull-secret<br/>Type: kubernetes.io/dockerconfigjson<br/>Purpose: Pull image from registry.redhat.io<br/>Provisioned: Manual (user)<br/>Auto-Rotate: No"]
    end

    subgraph "Security Notes"
        direction TB
        Note1["No persistent RBAC on OCP<br/>(SA deleted after collection)"]
        Note2["xKS RBAC persists until<br/>user manually deletes"]
        Note3["Collected data may contain<br/>multi-tenant PII in logs"]
    end

    style OCPAdmin fill:#4a90e2,stroke:#333,color:#fff
    style OCPSA fill:#4a90e2,stroke:#333,color:#fff
    style OCPCR fill:#f5a623,stroke:#333
    style OCPAll fill:#7ed321,stroke:#333

    style XKSAdmin fill:#4a90e2,stroke:#333,color:#fff
    style XKSSA fill:#4a90e2,stroke:#333,color:#fff
    style XKSCR fill:#f5a623,stroke:#333
    style XKSAllGroups fill:#7ed321,stroke:#333
    style XKSAllResources fill:#7ed321,stroke:#333
    style XKSVerbs fill:#7ed321,stroke:#333

    style PullSecret fill:#fff2cc,stroke:#d6b656
    style Note1 fill:#f9f9f9,stroke:#999
    style Note2 fill:#f9f9f9,stroke:#999
    style Note3 fill:#f8cecc,stroke:#b85450
