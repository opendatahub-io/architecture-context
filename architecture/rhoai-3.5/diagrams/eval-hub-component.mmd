graph TB
    subgraph EvalHubSystem["EvalHub System"]
        subgraph MainPod["EvalHub Pod"]
            RBAC["kube-rbac-proxy<br/>8443/TCP → 8080/TCP<br/>TLS termination"]
            API["eval-hub API<br/>8080/TCP REST<br/>Go Service"]
            Metrics["Metrics Server<br/>8081/TCP<br/>Prometheus"]
            API --- Metrics
        end

        subgraph MCPPod["MCP Pod (Optional)"]
            MCP["evalhub-mcp<br/>3001/TCP<br/>MCP Server"]
        end

        subgraph EvalJobPod["Evaluation Job Pod"]
            Init["eval-runtime-init<br/>Init Container"]
            Sidecar["eval-runtime-sidecar<br/>8080/TCP Reverse Proxy"]
            Adapter["Evaluation Adapter<br/>(lm-eval-harness, RAGAS,<br/>Garak, GuideLLM, etc.)"]
            Init -->|"downloads test data<br/>to /test_data volume"| Adapter
            Adapter -->|"http://localhost:8080"| Sidecar
        end
    end

    %% External actors
    Client["Client / Dashboard"]
    Agent["AI Agent / IDE"]
    Operator["TrustyAI Service Operator"]

    %% CRDs
    EvalHubCR["EvalHub CR<br/>trustyai.opendatahub.io/v1alpha1"]

    %% External services
    K8sAPI["Kubernetes API<br/>443/TCP"]
    MLflow["MLflow Tracking<br/>5000/TCP"]
    S3["S3 Storage<br/>443/TCP"]
    OCI["OCI Registry<br/>443/TCP"]
    ModelEndpoint["Model Inference<br/>Endpoint"]
    OTEL["OpenTelemetry<br/>Collector"]

    %% Flows
    Operator -->|"watches/manages"| EvalHubCR
    EvalHubCR -->|"deploys"| MainPod

    Client -->|"HTTPS/8443<br/>Bearer/RBAC"| RBAC
    RBAC -->|"HTTP/8080<br/>X-Tenant, X-User"| API

    Agent -->|"HTTP/3001<br/>MCP JSON-RPC"| MCP
    MCP -->|"HTTP/8080<br/>Bearer token"| API

    API -->|"HTTPS/443<br/>SA token"| K8sAPI
    API -->|"HTTPS/5000<br/>Bearer token"| MLflow
    API -->|"creates Jobs"| EvalJobPod

    Sidecar -->|"HTTPS/8443<br/>SA token"| API
    Sidecar -->|"HTTPS/5000<br/>Bearer token"| MLflow
    Sidecar -->|"HTTPS/443<br/>Bearer token"| OCI
    Sidecar -->|"HTTPS<br/>API key/SA token"| ModelEndpoint

    Init -->|"HTTPS/443<br/>AWS creds"| S3

    API -->|"OTLP/4317"| OTEL

    %% Styling
    style API fill:#4a90e2,stroke:#333,color:#fff
    style Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style Init fill:#4a90e2,stroke:#333,color:#fff
    style MCP fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style RBAC fill:#9b59b6,stroke:#333,color:#fff
    style EvalHubCR fill:#f5a623,stroke:#333
    style Adapter fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OCI fill:#e8e8e8,stroke:#333
    style ModelEndpoint fill:#e8e8e8,stroke:#333
    style OTEL fill:#e8e8e8,stroke:#333
    style Operator fill:#e67e22,stroke:#333,color:#fff
