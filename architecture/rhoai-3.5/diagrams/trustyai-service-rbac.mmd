graph TD
    subgraph OperatorManaged["RBAC Managed by TrustyAI Operator"]
        direction TB

        subgraph ServiceAccounts["Service Accounts (per-namespace)"]
            TrustyAISA["trustyai-service SA<br/>(created by operator)"]
            KubeRBACSA["kube-rbac-proxy SA<br/>(sidecar identity)"]
        end

        subgraph AuthFlow["Authentication Flow"]
            ExternalClient["External Client<br/>(Dashboard, KServe, Prometheus)"]
            BearerToken["Bearer Token<br/>(Kubernetes SA Token)"]
            KubeRBACProxy["kube-rbac-proxy Sidecar<br/>Port 8443/TCP"]
            SAR["SubjectAccessReview<br/>(Kubernetes API)"]
            TrustyAIService["TrustyAI Service<br/>Port 8080/TCP (loopback)"]
        end

        subgraph TLSAuth["TLS Authentication (4443)"]
            DirectClient["Direct Client<br/>(Operator)"]
            TLSCert["TLS Client Certificate<br/>(optional)"]
            TrustyAIHTTPS["TrustyAI Service<br/>Port 4443/TCP (HTTPS)"]
        end

        subgraph Secrets["Secrets (per-namespace)"]
            TLSSecret["TLS Certificates<br/>Type: kubernetes.io/tls<br/>Mount: /etc/tls/internal/<br/>Provisioned by: Operator/cert-manager<br/>Auto-rotate: Yes"]
            DBCreds["Database Credentials<br/>Type: Opaque<br/>Env: DATABASE_USERNAME,<br/>DATABASE_PASSWORD<br/>Provisioned by: Operator<br/>Auto-rotate: No"]
            DBCA["Database TLS CA<br/>Type: Opaque<br/>Mount: /etc/tls/db/ca.crt<br/>Provisioned by: Cluster admin<br/>Auto-rotate: No"]
        end
    end

    %% Auth flow
    ExternalClient -->|"presents"| BearerToken
    BearerToken -->|"sent to"| KubeRBACProxy
    KubeRBACProxy -->|"validates via"| SAR
    SAR -->|"authorized"| KubeRBACProxy
    KubeRBACProxy -->|"forwards<br/>pre-authenticated"| TrustyAIService

    %% TLS auth flow
    DirectClient -->|"presents"| TLSCert
    TLSCert -->|"validated by"| TrustyAIHTTPS

    %% Secret usage
    TLSSecret -.->|"used by"| KubeRBACProxy
    TLSSecret -.->|"used by"| TrustyAIHTTPS
    DBCreds -.->|"used by"| TrustyAIService
    DBCA -.->|"used by"| TrustyAIService

    %% Styling
    style OperatorManaged fill:#f0f0f0,stroke:#666,stroke-width:2px
    style TrustyAISA fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACSA fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACProxy fill:#f5a623,stroke:#333,color:#fff
    style SAR fill:#f5a623,stroke:#333,color:#fff
    style TrustyAIService fill:#7ed321,stroke:#333,color:#fff
    style TrustyAIHTTPS fill:#7ed321,stroke:#333,color:#fff
    style ExternalClient fill:#e8e8e8,stroke:#999
    style DirectClient fill:#e8e8e8,stroke:#999
    style BearerToken fill:#ddd6fe,stroke:#7c3aed
    style TLSCert fill:#ddd6fe,stroke:#7c3aed
    style TLSSecret fill:#fecaca,stroke:#dc2626
    style DBCreds fill:#fecaca,stroke:#dc2626
    style DBCA fill:#fecaca,stroke:#dc2626
