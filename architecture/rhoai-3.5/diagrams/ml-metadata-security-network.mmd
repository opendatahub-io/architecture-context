graph TB
    subgraph Clients["PLATFORM CLIENTS (Internal)"]
        KFP["Kubeflow Pipelines<br/>(ml-pipeline)"]
        DSP["Data Science Pipelines<br/>(DSP)"]
        KFPUI["KFP UI<br/>(indirect)"]
    end

    subgraph MLMDService["MLMD SERVICE"]
        direction TB
        Server["MLMD gRPC Server<br/>metadata_store_server<br/>Port: 8080/TCP<br/>Protocol: gRPC/HTTP2<br/>TLS: Optional (SSLConfig/BoringSSL)<br/>Auth: Optional mTLS (client_verify)<br/>Default: InsecureServerCredentials<br/>User: 65534:65534 (non-root)<br/>Image: odh-mlmd-grpc-server"]
    end

    subgraph DatabaseBackend["DATABASE BACKEND"]
        direction TB
        MySQL["MySQL / MariaDB<br/>Port: 3306/TCP<br/>Protocol: MySQL<br/>SSL: Optional (cert, key, ca, verify)<br/>Auth: Username/Password"]
        PostgreSQL["PostgreSQL<br/>Port: 5432/TCP<br/>Protocol: PostgreSQL<br/>SSL: Optional (sslmode, sslcert)<br/>Auth: Username/Password"]
    end

    %% Client Flows
    KFP -->|"gRPC/HTTP2 8080/TCP<br/>Optional TLS<br/>Optional mTLS"| Server
    DSP -->|"gRPC/HTTP2 8080/TCP<br/>Optional TLS<br/>Optional mTLS"| Server
    KFPUI -->|"gRPC/HTTP2 8080/TCP<br/>Optional TLS<br/>(indirect)"| Server

    %% Database Flows
    Server -->|"MySQL/3306<br/>Optional SSL<br/>Username/Password"| MySQL
    Server -->|"PostgreSQL/5432<br/>Optional SSL<br/>Username/Password"| PostgreSQL

    %% Styling
    classDef client fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class KFP,DSP,KFPUI client
    class Server service
    class MySQL,PostgreSQL database
