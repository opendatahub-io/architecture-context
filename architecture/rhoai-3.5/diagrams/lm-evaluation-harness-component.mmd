graph TB
    subgraph "LMEval Job Pod"
        direction TB
        Adapter["EvalHub Adapter<br/>(main.py — LMEvalAdapter)"]
        Framework["lm_eval Framework<br/>(EleutherAI upstream)"]
        LocalCompletions["local-completions Backend<br/>(OpenAI-compatible client)"]
        TaskEngine["Task Engine<br/>(157+ benchmarks, 6500+ YAML configs)"]
        MetricModules["Metric Modules<br/>(56 offline metrics)"]
        OCIPublisher["OCI Artifact Publisher<br/>(scripts/oci.py)"]

        Adapter -->|configures & runs| Framework
        Framework -->|loads tasks| TaskEngine
        Framework -->|uses backend| LocalCompletions
        Framework -->|computes| MetricModules
        Adapter -->|publishes results| OCIPublisher
    end

    %% External orchestration
    TrustyAI["TrustyAI Operator"] -->|creates Job from<br/>LMEvalJob CR| LMEvalPod["LMEval Job Pod"]
    TrustyAI -->|mounts| ConfigMap["/meta/job.json<br/>ConfigMap"]
    TrustyAI -->|mounts| AuthSecret["Model Auth Secret<br/>(api-key, hf-token)"]
    ConfigMap -->|read by| Adapter
    AuthSecret -->|env vars| Adapter

    %% Outbound connections
    LocalCompletions -->|POST /v1/completions<br/>Bearer Token| ModelEndpoint["Model Serving Endpoint<br/>(vLLM / TGI / etc.)"]
    Adapter -->|status callbacks| EvalHub["EvalHub Service"]
    Framework -->|downloads tokenizers<br/>& datasets| HFHub["HuggingFace Hub"]
    OCIPublisher -->|skopeo push| OCIRegistry["OCI Registry"]

    %% Styling
    style Adapter fill:#4a90e2,color:#fff
    style Framework fill:#4a90e2,color:#fff
    style LocalCompletions fill:#4a90e2,color:#fff
    style TaskEngine fill:#4a90e2,color:#fff
    style MetricModules fill:#4a90e2,color:#fff
    style OCIPublisher fill:#4a90e2,color:#fff
    style TrustyAI fill:#7ed321,color:#fff
    style EvalHub fill:#7ed321,color:#fff
    style ModelEndpoint fill:#f5a623,color:#fff
    style HFHub fill:#e8e8e8,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#f5a623,color:#fff
    style AuthSecret fill:#d0021b,color:#fff
