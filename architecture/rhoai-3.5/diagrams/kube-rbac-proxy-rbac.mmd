graph TD
    subgraph "Service Account (pod-level, injected by rhods-operator)"
        SA["Component ServiceAccount<br/>(e.g., trustyai-service-sa,<br/>model-registry-sa)"]
    end

    subgraph "Required RBAC Permissions"
        direction TB
        CR_TokenReview["ClusterRole Permission:<br/>Create TokenReviews"]
        CR_SAR["ClusterRole Permission:<br/>Create SubjectAccessReviews"]
    end

    subgraph "Kubernetes API Groups"
        AuthnAPI["authentication.k8s.io/v1<br/>TokenReview"]
        AuthzAPI["authorization.k8s.io/v1<br/>SubjectAccessReview"]
    end

    subgraph "Authorization Config (per-component)"
        direction TB
        Format1["Format1 Config<br/>Top-level resourceAttributes<br/>+ optional rewrites<br/>(single SAR check for all paths)"]
        Format2["Format2 Config<br/>Per-path endpoint rules<br/>+ template variables<br/>(fine-grained per-path SAR)"]
    end

    subgraph "Hardcoded Authorization"
        HardcodedAllow["Hardcoded Metrics Allow<br/>SA: system:serviceaccount:<br/>openshift-monitoring:prometheus-k8s<br/>Resource: GET /metrics<br/>→ No SAR required"]
    end

    subgraph "Per-Request Authorization (caller identity)"
        direction TB
        CallerIdentity["Authenticated Caller<br/>(user / group from TokenReview or OIDC)"]
        SARCheck["SubjectAccessReview<br/>resource: {from config}<br/>verb: {from config/method}<br/>namespace: {from config/header/query}"]
    end

    %% SA needs permissions to call TokenReview and SAR
    SA -->|"bound via ClusterRoleBinding<br/>(created by rhods-operator)"| CR_TokenReview
    SA -->|"bound via ClusterRoleBinding<br/>(created by rhods-operator)"| CR_SAR
    CR_TokenReview -->|"create"| AuthnAPI
    CR_SAR -->|"create"| AuthzAPI

    %% Auth config determines SAR parameters
    Format1 -->|"defines resource/verb<br/>for all requests"| SARCheck
    Format2 -->|"defines per-path<br/>resource/verb mapping"| SARCheck

    %% Per-request flow
    CallerIdentity -->|"identity extracted<br/>from TokenReview/OIDC"| SARCheck
    SARCheck -->|"checks caller's RBAC<br/>permissions"| AuthzAPI

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_TokenReview fill:#f5a623,stroke:#333
    style CR_SAR fill:#f5a623,stroke:#333
    style AuthnAPI fill:#7ed321,stroke:#333
    style AuthzAPI fill:#7ed321,stroke:#333
    style Format1 fill:#b8e986,stroke:#333
    style Format2 fill:#b8e986,stroke:#333
    style HardcodedAllow fill:#ff6b6b,stroke:#333,color:#fff
    style CallerIdentity fill:#50e3c2,stroke:#333
    style SARCheck fill:#50e3c2,stroke:#333
