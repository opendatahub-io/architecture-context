graph TB
    subgraph External["External Client"]
        Client[ML Client / Application]
    end

    subgraph Platform["Platform Ingress Layer"]
        KRBP["kube-rbac-proxy Sidecar<br/>8443/TCP TLS<br/>Bearer Token Auth"]
    end

    subgraph Pod["InferenceService Pod"]
        subgraph AutoGluonServer["autogluonserver (Python)"]
            Main["__main__.py<br/>Entry Point"]
            Factory["predictor_factory.py<br/>Model Type Detection"]
            Detect["predictor_detect.py<br/>Auto-detect TabularPredictor<br/>vs TimeSeriesPredictor"]
            VersionCompat["version_compat.py<br/>Version Tolerance<br/>(major.minor only)"]
            RuntimePaths["runtime_paths.py<br/>Writable Dir Probe<br/>(/tmp, $HOME, /home/kserve)"]

            subgraph Models["Model Handlers"]
                TabularModel["AutoGluonTabularModel<br/>v1 + v2 Protocol<br/>Classification / Regression / Quantile"]
                TimeSeriesModel["AutoGluonTimeSeriesModel<br/>v1 Protocol Only<br/>Forecasting"]
            end

            Main --> Factory
            Factory --> Detect
            Detect --> VersionCompat
            Detect --> TabularModel
            Detect --> TimeSeriesModel
            Main --> RuntimePaths
        end

        subgraph KServeSDK["kserve SDK (0.19.0)"]
            ModelServer["ModelServer<br/>REST/gRPC Transport"]
            HealthCheck["Health Checks<br/>/v2/health/ready<br/>/v2/health/live"]
            Metrics["Prometheus Metrics<br/>Latency, Request Count"]
        end

        subgraph KServeStorage["kserve-storage (0.19.0)"]
            StorageModule["Storage Download Module<br/>S3 / GCS / Azure / HuggingFace"]
        end

        Main --> ModelServer
        ModelServer --> HealthCheck
        ModelServer --> Metrics
        TabularModel --> ModelServer
        TimeSeriesModel --> ModelServer
        StorageModule --> TabularModel
        StorageModule --> TimeSeriesModel
    end

    subgraph KServeController["KServe Controller"]
        Controller["KServe Operator<br/>Watches InferenceService CRs"]
    end

    subgraph CloudStorage["Cloud Storage"]
        S3["S3-compatible<br/>443/TCP HTTPS"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>Bearer Token"| KRBP
    KRBP -->|"HTTP/8080<br/>localhost"| ModelServer
    Controller -->|"Creates Pod<br/>from InferenceService CR"| Pod
    StorageModule -->|"HTTPS/443<br/>IAM/SA/Token"| S3
    StorageModule -->|"HTTPS/443<br/>GCP SA"| GCS
    StorageModule -->|"HTTPS/443<br/>Azure Creds"| Azure
    StorageModule -->|"HTTPS/443<br/>HF Token"| HF

    %% Styling
    style Main fill:#4a90e2,color:#fff
    style Factory fill:#4a90e2,color:#fff
    style Detect fill:#4a90e2,color:#fff
    style TabularModel fill:#7ed321,color:#fff
    style TimeSeriesModel fill:#7ed321,color:#fff
    style ModelServer fill:#f5a623,color:#fff
    style StorageModule fill:#f5a623,color:#fff
    style KRBP fill:#e8744f,color:#fff
    style Controller fill:#9b59b6,color:#fff
    style S3 fill:#e8e8e8,stroke:#333
    style GCS fill:#e8e8e8,stroke:#333
    style Azure fill:#e8e8e8,stroke:#333
    style HF fill:#e8e8e8,stroke:#333
