graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS reencrypt/edge)"]
        TASRoute["TAS Route<br/>443/TCP → 8443/TCP<br/>TLS reencrypt"]
        EHRoute["EvalHub Route<br/>443/TCP → 8443/TCP<br/>TLS reencrypt"]
        EHMCPRoute["EvalHub MCP Route<br/>443/TCP → 8443/TCP<br/>TLS reencrypt"]
        GORCHRoute["GORCH Routes<br/>443/TCP → 8432,8490,8480/TCP<br/>TLS reencrypt/edge"]
        NEMORoute["NemoGuardrails Route<br/>443/TCP → 8443/TCP<br/>TLS reencrypt/edge"]
    end

    subgraph AuthProxy["AUTH PROXY LAYER (kube-rbac-proxy sidecars)"]
        direction TB
        TASProxy["kube-rbac-proxy (TAS)<br/>8443/TCP TLS 1.2+ FIPS<br/>SAR: token review"]
        EHProxy["kube-rbac-proxy (EvalHub)<br/>8443/TCP TLS 1.2+ FIPS<br/>SAR: evalhubs/proxy"]
        EHMCPProxy["kube-rbac-proxy (EH MCP)<br/>8443/TCP TLS 1.2+ FIPS<br/>SAR: evalhubs/proxy"]
        GORCHProxy["kube-rbac-proxy (GORCH)<br/>8432,8490,8480/TCP TLS 1.2+<br/>SAR: RBAC config"]
        NEMOProxy["kube-rbac-proxy (NemoGR)<br/>8443/TCP TLS 1.2+ FIPS<br/>SAR: RBAC config"]
    end

    subgraph Services["SERVICE LAYER (Application Pods)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            TASPod["TrustyAI Service<br/>SA: {tas-instance}-proxy<br/>8080/TCP HTTP"]
            LMESPod["LMEvalJob Pod<br/>ta-lmes-driver<br/>18080/TCP HTTP (localhost)"]
        end

        subgraph NS_EvalHub["Namespace: {evalhub-namespace}"]
            EHPod["EvalHub API Server<br/>SA: {evalhub-instance}-service<br/>8444/TCP HTTP"]
            EHMCPPod["EvalHub MCP Server<br/>8443/TCP HTTPS"]
        end

        subgraph NS_GORCH["Namespace: {gorch-namespace}"]
            GORCHPod["Guardrails Orchestrator<br/>SA: {gorch-instance}-sa<br/>8032,8034,8080/TCP"]
        end

        subgraph NS_NEMO["Namespace: {nemo-namespace}"]
            NEMOPod["NeMo Guardrails Server<br/>SA: {nemo-instance}-sa<br/>8000/TCP HTTP"]
        end
    end

    subgraph ControlPlane["OPERATOR CONTROL PLANE"]
        Operator["trustyai-service-operator<br/>SA: controller-manager<br/>8080/TCP metrics, 8081/TCP health<br/>9443/TCP webhooks<br/>FIPS: strictfipsruntime"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA Token"]
        KServe["KServe InferenceServices<br/>443/TCP HTTPS TLS"]
        S3["S3 Storage<br/>443/TCP HTTPS TLS 1.2+<br/>AWS Credentials"]
        OCI["OCI Registries<br/>443/TCP HTTPS TLS 1.2+<br/>DockerConfig"]
        Git["Git Repos<br/>443/TCP HTTPS TLS 1.2+"]
        DB["PostgreSQL<br/>configurable TCP<br/>TLS optional<br/>User/Pass Secret"]
        OTLP["OTLP Endpoints<br/>gRPC/HTTP configurable"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS"| TASRoute
    Client -->|"HTTPS/443<br/>TLS"| EHRoute
    Client -->|"HTTPS/443<br/>TLS"| EHMCPRoute
    Client -->|"HTTPS/443<br/>TLS"| GORCHRoute
    Client -->|"HTTPS/443<br/>TLS"| NEMORoute

    %% Ingress to Auth Proxy
    TASRoute -->|"HTTPS/8443<br/>TLS reencrypt"| TASProxy
    EHRoute -->|"HTTPS/8443<br/>TLS reencrypt"| EHProxy
    EHMCPRoute -->|"HTTPS/8443<br/>TLS reencrypt"| EHMCPProxy
    GORCHRoute -->|"HTTPS/8432<br/>TLS"| GORCHProxy
    NEMORoute -->|"HTTPS/8443<br/>TLS"| NEMOProxy

    %% Auth Proxy to Services (localhost, no TLS)
    TASProxy -->|"HTTP/8080<br/>localhost"| TASPod
    EHProxy -->|"HTTP/8444<br/>localhost"| EHPod
    EHMCPProxy -->|"HTTPS/8443<br/>localhost"| EHMCPPod
    GORCHProxy -->|"HTTP/various<br/>localhost"| GORCHPod
    NEMOProxy -->|"HTTP/8000<br/>localhost"| NEMOPod

    %% Operator to K8s API
    Operator -->|"HTTPS/443<br/>TLS SA Token"| K8sAPI

    %% Service egress
    TASPod -->|"HTTPS/443 TLS"| KServe
    TASPod -->|"TCP TLS optional"| DB
    LMESPod -->|"HTTPS/443 TLS 1.2+"| S3
    LMESPod -->|"HTTPS/443 TLS 1.2+"| OCI
    LMESPod -->|"HTTPS/443 TLS 1.2+"| Git
    EHPod -->|"TCP TLS optional"| DB
    EHPod -->|"gRPC/HTTP"| OTLP
    GORCHPod -->|"gRPC/HTTP"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class TASRoute,EHRoute,EHMCPRoute,GORCHRoute,NEMORoute ingress
    class TASProxy,EHProxy,EHMCPProxy,GORCHProxy,NEMOProxy authproxy
    class TASPod,LMESPod,EHPod,EHMCPPod,GORCHPod,NEMOPod service
    class Operator controlplane
    class K8sAPI,KServe,S3,OCI,Git,DB,OTLP externalservice
