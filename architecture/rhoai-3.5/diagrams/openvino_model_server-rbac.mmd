graph TD
    subgraph DeploymentContext["Deployment Context (KServe-Managed)"]
        direction TB

        Note["OVMS does not define its own RBAC resources.<br/>All RBAC is managed by the deploying operator (KServe)."]
    end

    subgraph PlatformRBAC["Platform-Level Access Control"]
        direction TB

        subgraph AuthMechanisms["Authentication Mechanisms"]
            KRBAC["kube-rbac-proxy Sidecar<br/>(Platform-injected)<br/>Bearer Token / K8s RBAC"]
            APIKey["Application API Key<br/>(Optional)<br/>--api_key_file / API_KEY env"]
        end

        subgraph ProtectedEndpoints["Endpoint Protection Matrix"]
            direction LR

            subgraph AppAuth["App-Level Auth (Bearer Token)"]
                ChatAPI["/v1/chat/completions"]
                CompletionsAPI["/v1/completions"]
                TokenizeAPI["/v1/tokenize"]
                V3API["/v3/*"]
            end

            subgraph NoAppAuth["No App-Level Auth (Platform Only)"]
                V1API["/v1/* (TFS)"]
                V2API["/v2/* (KServe)"]
                gRPCAll["gRPC (all services)<br/>InsecureServerCredentials"]
                MetricsAPI["/metrics"]
            end
        end
    end

    subgraph NetworkIsolation["Network-Level Isolation"]
        direction TB
        K8sNP["Kubernetes NetworkPolicy"]
        IstioAP["Istio AuthorizationPolicy<br/>(if service mesh enabled)"]
        PodIso["Pod-Level Isolation<br/>(one OVMS per InferenceService)"]
    end

    subgraph CloudCredentials["Cloud Storage Credentials (Env Vars)"]
        direction LR
        AWSCreds["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
        AzureCreds["Azure Storage<br/>Account Keys"]
        GCPCreds["GCP Service<br/>Account JSON"]
        HFToken["HF_TOKEN<br/>(optional)"]
    end

    %% Connections
    KRBAC -->|"enforces auth on"| NoAppAuth
    APIKey -.->|"optional auth on"| AppAuth
    K8sNP -->|"restricts network"| DeploymentContext
    IstioAP -->|"restricts access"| DeploymentContext
    PodIso -->|"isolates tenant"| DeploymentContext

    %% Styling
    style Note fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style KRBAC fill:#4a90e2,color:#fff
    style APIKey fill:#f5a623
    style ChatAPI fill:#d5e8d4,stroke:#82b366
    style CompletionsAPI fill:#d5e8d4,stroke:#82b366
    style TokenizeAPI fill:#d5e8d4,stroke:#82b366
    style V3API fill:#d5e8d4,stroke:#82b366
    style V1API fill:#f8cecc,stroke:#b85450
    style V2API fill:#f8cecc,stroke:#b85450
    style gRPCAll fill:#f8cecc,stroke:#b85450
    style MetricsAPI fill:#f8cecc,stroke:#b85450
    style K8sNP fill:#dae8fc,stroke:#6c8ebf
    style IstioAP fill:#dae8fc,stroke:#6c8ebf
    style PodIso fill:#dae8fc,stroke:#6c8ebf
    style AWSCreds fill:#fff2cc,stroke:#d6b656
    style AzureCreds fill:#fff2cc,stroke:#d6b656
    style GCPCreds fill:#fff2cc,stroke:#d6b656
    style HFToken fill:#fff2cc,stroke:#d6b656
