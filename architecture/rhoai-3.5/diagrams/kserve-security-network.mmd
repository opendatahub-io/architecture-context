graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist /<br/>External Client"]
    end

    subgraph Ingress["INGRESS (Gateway / DMZ)"]
        Gateway["Gateway API / Istio Gateway<br/>443/TCP → backend<br/>TLS 1.2+ (SIMPLE)<br/>Optional AuthN"]
        OSRoute["OpenShift Route<br/>443/TCP edge/reencrypt<br/>(InferenceGraph only)"]
    end

    subgraph AuthProxy["AUTH PROXY LAYER"]
        KRBAC["kube-rbac-proxy sidecar<br/>8443/TCP → 8080/TCP<br/>TLS (OpenShift serving cert)<br/>SubjectAccessReview"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACE (per-tenant)"]
        direction TB

        subgraph ISVCPod["InferenceService Pod"]
            ModelServer["Model Server<br/>8080/TCP HTTP<br/>8081/TCP gRPC<br/>No encryption (behind proxy)"]
            AgentSidecar["kserve-agent sidecar<br/>9081/TCP proxy<br/>(optional)"]
            StorageInit["storage-initializer<br/>(init container)"]
        end

        subgraph LLMPod["LLMInferenceService Workload"]
            LLMServer["LLM Model Server<br/>9000/TCP HTTP/gRPC<br/>Optional self-signed TLS<br/>Optional bearer token"]
            Scheduler["Scheduler<br/>9002/TCP HTTP<br/>Optional TLS<br/>Bearer token (K8s auth)"]
        end

        InfPool["InferencePool<br/>(GIE routing)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (kserve / opendatahub)"]
        direction TB
        Controller["kserve-controller-manager<br/>SA: kserve-controller-manager<br/>Metrics: 8443/TCP (HTTPS)<br/>Webhook: 9443/TCP (TLS)"]
        LLMController["llmisvc-controller-manager<br/>SA: kserve-llmisvc-controller-manager<br/>Metrics: 8080/TCP<br/>Webhook: 9443/TCP"]
        LMController["kserve-localmodel-controller<br/>SA: kserve-localmodel-controller-manager<br/>Health: 8081/TCP"]
        ModController["kserve-module-controller<br/>SA: kserve-module-controller<br/>Health: 8081/TCP"]
        WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP<br/>TLS (cert-manager)"]
    end

    subgraph NodeLevel["NODE-LEVEL (DaemonSet)"]
        LMAgent["localmodelnode-agent<br/>SA: kserve-localmodelnode-agent<br/>Label: kserve/localmodel=worker<br/>Health: 8081/TCP"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES (Cluster-Internal)"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA tokens"]
        KnativeSrv["Knative Serving<br/>443/TCP HTTPS<br/>(optional)"]
        IstioMesh["Istio / Service Mesh<br/>443/TCP HTTPS / mTLS<br/>(optional)"]
        CertMgr["cert-manager<br/>443/TCP HTTPS"]
        PromOp["Prometheus Operator<br/>443/TCP HTTPS"]
        KEDAExt["KEDA<br/>443/TCP HTTPS<br/>(optional)"]
        LWSvc["LeaderWorkerSet<br/>443/TCP HTTPS<br/>(optional)"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        S3["S3 / GCS / Azure Blob<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / GCP SA / Azure SAS"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF token (optional)"]
        LogCollector["Log Collector<br/>configurable port<br/>HTTP/HTTPS (optional)"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Client -->|"HTTPS/443<br/>TLS edge/reencrypt"| OSRoute

    %% Ingress to Auth/Workload
    Gateway -->|"HTTPS/8443<br/>TLS (serving cert)<br/>Bearer Token"| KRBAC
    Gateway -->|"HTTP or gRPC/9000<br/>Optional self-signed TLS<br/>→ InferencePool"| InfPool
    OSRoute -->|"HTTP/8080<br/>to router pod"| ModelServer

    %% Auth to workload
    KRBAC -->|"HTTP/8080<br/>No encryption (localhost)<br/>SAR passed"| ModelServer

    %% InferencePool to LLM
    InfPool -->|"HTTP or gRPC/9000"| LLMServer

    %% Controllers to K8s API
    Controller -->|"HTTPS/443<br/>SA token"| K8sAPI
    LLMController -->|"HTTPS/443<br/>SA token"| K8sAPI
    LMController -->|"HTTPS/443<br/>SA token"| K8sAPI
    ModController -->|"HTTPS/443<br/>SA token"| K8sAPI

    %% Controllers to platform services
    Controller -.->|"optional"| KnativeSrv
    Controller -.->|"optional"| IstioMesh
    ModController -->|"TLS cert mgmt"| CertMgr
    LLMController -->|"PodMonitor/ServiceMonitor"| PromOp
    LLMController -.->|"optional"| KEDAExt
    LLMController -.->|"optional"| LWSvc

    %% Webhook
    K8sAPI -->|"Webhook admission<br/>TLS client cert"| WebhookSvc

    %% Storage downloads
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage creds"| S3
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>HF token"| HFHub
    LMAgent -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage creds"| S3

    %% Agent to log collector
    AgentSidecar -.->|"HTTP/HTTPS<br/>configurable"| LogCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef nodelevel fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway,OSRoute ingress
    class KRBAC authproxy
    class ModelServer,AgentSidecar,StorageInit,LLMServer,Scheduler,InfPool workload
    class Controller,LLMController,LMController,ModController,WebhookSvc operator
    class K8sAPI,KnativeSrv,IstioMesh,CertMgr,PromOp,KEDAExt,LWSvc platform
    class S3,HFHub,LogCollector externalservice
    class LMAgent nodelevel
