graph LR
    Dashboard["ODH Dashboard<br/>(React SPA + Node.js + Go BFFs)"]

    %% Build/Runtime Dependencies
    subgraph BuildDeps["Build & Runtime"]
        NodeJS["Node.js 22+"]
        GoLang["Go 1.25-1.26"]
        React["React ^18.3.1"]
        PatternFly["PatternFly 6.4.x"]
        PluginSDK["@openshift/dynamic-plugin-sdk ^5.0.1"]
        ModFed["@module-federation/enhanced"]
        Fastify["Fastify 4.x"]
        ControllerRT["controller-runtime"]
        Turbo["Turbo ^2.9.16"]
    end

    %% Platform Infrastructure
    subgraph PlatformInfra["Platform Infrastructure"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
        Thanos["Thanos Querier<br/>9091/TCP HTTPS"]
        KRBP["kube-rbac-proxy<br/>(sidecar)"]
        GatewayAPI["Gateway API<br/>HTTPRoute"]
    end

    %% Internal ODH/RHOAI Dependencies
    subgraph InternalDeps["Internal ODH/RHOAI Components"]
        RhodsOp["rhods-operator<br/>(Dashboard CR)"]
        DSPipelines["DataSciencePipelines"]
        ModelReg["Model Registry<br/>8085/TCP"]
        KServe["KServe<br/>(InferenceService watch)"]
        TrustyAI["TrustyAI<br/>9443/TCP"]
        MLMD["ML Metadata"]
        Perses["Perses<br/>8080/TCP"]
        Kueue["Kueue<br/>(CRD Watch)"]
        AuthCR["Auth CR<br/>(admin groups)"]
    end

    %% AI/ML Service Dependencies
    subgraph AIServices["AI/ML Services"]
        LlamaStack["LlamaStack / OGX"]
        NeMo["NeMo Guardrails"]
        MLflowSvc["MLflow Tracking Server"]
        MaaSAPI["MaaS API"]
        EvalHubAPI["EvalHub API"]
        KFPipeline["Kubeflow Pipeline Server"]
    end

    %% External Service Dependencies
    subgraph ExternalSvc["External Services"]
        S3["S3 Storage<br/>443/TCP HTTPS"]
        PGVector["pgvector (PostgreSQL)<br/>5432/TCP"]
    end

    %% Integration Partners (consume Dashboard)
    subgraph Consumers["Consumers"]
        OSConsole["OpenShift Console<br/>(ConsoleLink)"]
        OLM["OLM Subscriptions<br/>(CRD Watch)"]
        Feast["Feast FeatureStores<br/>(CRD Watch)"]
    end

    %% Build/Runtime connections
    Dashboard -->|runtime| NodeJS
    Dashboard -->|compilation| GoLang
    Dashboard -->|UI framework| React
    Dashboard -->|UI components| PatternFly
    Dashboard -->|plugins| PluginSDK
