graph TD
    subgraph "Service Account"
        SA["{name}-{release}"]
    end

    subgraph "ClusterRole Binding"
        CRB["{release}-externalmodels-reader<br/>(ClusterRoleBinding)<br/>Scope: cluster-wide<br/>(multiNamespace=true)"]
    end

    subgraph "ClusterRole"
        CR["{release}-externalmodels-reader"]
    end

    subgraph "Core API Resources"
        Secrets["core<br/>secrets"]
        Services["core<br/>services"]
    end

    subgraph "inference.opendatahub.io Resources"
        ExtProviders["inference.opendatahub.io<br/>externalproviders"]
        ExtModels["inference.opendatahub.io<br/>externalmodels"]
        ExtProvidersStatus["inference.opendatahub.io<br/>externalproviders/status"]
        ExtModelsStatus["inference.opendatahub.io<br/>externalmodels/status"]
        ExtProvidersFinalizers["inference.opendatahub.io<br/>externalproviders/finalizers"]
        ExtModelsFinalizers["inference.opendatahub.io<br/>externalmodels/finalizers"]
    end

    subgraph "Legacy API Resources"
        LegacyModels["maas.opendatahub.io<br/>externalmodels"]
    end

    subgraph "Gateway API Resources"
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
    end

    subgraph "Istio Networking Resources"
        ServiceEntries["networking.istio.io<br/>serviceentries"]
        DestRules["networking.istio.io<br/>destinationrules"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR

    CR -->|"get, list, watch"| Secrets
    CR -->|"get, list, watch,<br/>create, update, delete"| Services

    CR -->|"get, list, watch"| LegacyModels

    CR -->|"get, list, watch,<br/>create, update"| ExtProviders
    CR -->|"get, list, watch,<br/>create, update"| ExtModels
    CR -->|"get, update, patch"| ExtProvidersStatus
    CR -->|"get, update, patch"| ExtModelsStatus
    CR -->|"update"| ExtProvidersFinalizers
    CR -->|"update"| ExtModelsFinalizers

    CR -->|"get, list, watch,<br/>create, update, delete"| HTTPRoutes

    CR -->|"get, list, watch,<br/>create, update, delete"| ServiceEntries
    CR -->|"get, list, watch,<br/>create, update, delete"| DestRules

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CRB fill:#dae8fc,stroke:#6c8ebf
    style CR fill:#f5a623,color:#fff

    style Secrets fill:#d5e8d4,stroke:#82b366
    style Services fill:#d5e8d4,stroke:#82b366

    style ExtProviders fill:#7ed321,color:#fff
    style ExtModels fill:#7ed321,color:#fff
    style ExtProvidersStatus fill:#7ed321,color:#fff
    style ExtModelsStatus fill:#7ed321,color:#fff
    style ExtProvidersFinalizers fill:#7ed321,color:#fff
    style ExtModelsFinalizers fill:#7ed321,color:#fff

    style LegacyModels fill:#e8e8e8,stroke:#999

    style HTTPRoutes fill:#fff2cc,stroke:#d6b656
    style ServiceEntries fill:#fff2cc,stroke:#d6b656
    style DestRules fill:#fff2cc,stroke:#d6b656
