graph TD
    subgraph "LMEval RBAC Model"
        direction TB

        Note["Note: LMEval does not define its own RBAC resources.<br/>All RBAC is managed by the TrustyAI Operator."]

        subgraph TrustyAIManaged["TrustyAI Operator-Managed RBAC"]
            direction TB

            SA["ServiceAccount<br/>(created by TrustyAI Operator<br/>for each LMEvalJob)"]

            subgraph JobPodPermissions["Job Pod Permissions (Inferred)"]
                ConfigMapRead["core/v1<br/>ConfigMaps<br/>get"]
                SecretRead["core/v1<br/>Secrets<br/>get"]
            end
        end

        subgraph Credentials["Credential Flow"]
            direction TB
            ModelSecret["Model Auth Secret<br/>(Opaque)"]
            APIKey["api-key<br/>→ OPENAI_API_KEY"]
            HFToken["hf-token<br/>→ HF_TOKEN"]

            ModelSecret -->|"resolve_model_credentials()"| APIKey
            ModelSecret -->|"read_model_auth_key('hf-token')"| HFToken
        end

        subgraph AuthEndpoints["Authentication at Endpoints"]
            direction TB
            ModelAuth["Model Serving Endpoint<br/>Auth: Bearer Token (OPENAI_API_KEY)"]
            EvalHubAuth["EvalHub Callback<br/>Auth: Bearer Token (eval-hub-sdk managed)"]
            HFAuth["HuggingFace Hub<br/>Auth: Bearer Token (HF_TOKEN, optional)"]
            OCIAuth["OCI Registry<br/>Auth: Docker config (/tmp/.docker/config.json)<br/>or username/password env vars"]
        end

        SA -->|"bound to"| ConfigMapRead
        SA -->|"bound to"| SecretRead
        APIKey -->|"authenticates"| ModelAuth
        HFToken -->|"authenticates"| HFAuth
    end

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style SA fill:#4a90e2,color:#fff
    style ModelSecret fill:#d0021b,color:#fff
    style APIKey fill:#f5a623,color:#fff
    style HFToken fill:#f5a623,color:#fff
    style ConfigMapRead fill:#7ed321,color:#fff
    style SecretRead fill:#7ed321,color:#fff
    style ModelAuth fill:#e8e8e8,stroke:#333
    style EvalHubAuth fill:#e8e8e8,stroke:#333
    style HFAuth fill:#e8e8e8,stroke:#333
    style OCIAuth fill:#e8e8e8,stroke:#333
