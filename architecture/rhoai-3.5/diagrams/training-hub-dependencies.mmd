graph LR
    TrainingHub["Training Hub<br/>(PyPI: training-hub)"]

    %% Required Dependencies
    TrainingHub -->|"SFT backend"| ILT["instructlab-training<br/>>=0.9.1"]
    TrainingHub -->|"OSFT backend"| MiniTrainer["rhai-innovation-<br/>mini-trainer<br/>>=0.4.0"]
    TrainingHub -->|"deep learning framework"| PyTorch["torch<br/>>=2.6.0"]
    TrainingHub -->|"model loading"| Transformers["transformers<br/>>=4.51.0"]
    TrainingHub -->|"dataset processing"| Datasets["datasets<br/>>=3.3.2"]
    TrainingHub -->|"LoRA adapters"| PEFT["peft<br/>>=0.15.1"]
    TrainingHub -->|"distributed training"| Accelerate["accelerate<br/>>=1.6.0"]
    TrainingHub -->|"data processing"| Pandas["pandas<br/>>=2.2.3"]
    TrainingHub -->|"visualization"| Matplotlib["matplotlib<br/>>=3.10.1"]

    %% Optional: cuda extra
    TrainingHub -.->|"cuda extra"| FlashAttn["flash-attn<br/>(Flash Attention 2)"]
    TrainingHub -.->|"cuda extra"| BitsAndBytes["bitsandbytes<br/>(QLoRA quantization)"]
    TrainingHub -.->|"cuda extra"| LigerKernel["liger-kernel<br/>(fused GPU kernels)"]

    %% Optional: lora extra
    TrainingHub -.->|"lora extra"| Unsloth["unsloth<br/>(optimized LoRA)"]
    TrainingHub -.->|"lora extra"| TRL["trl<br/>(SFTTrainer/GRPOTrainer)"]

    %% Optional: grpo extra
    TrainingHub -.->|"grpo extra"| ART["openpipe-art<br/>(ART GRPO backend)"]
    TrainingHub -.->|"grpo/gepa extra"| LiteLLM["litellm<br/>>=1.71.1, !=1.82.0<br/>(supply chain exclude)"]

    %% Optional: grpo-verl extra
    TrainingHub -.->|"grpo-verl extra"| VeRL["verl<br/>(Volcano Engine RL)"]

    %% Optional: gepa extra
    TrainingHub -.->|"gepa extra"| GEPA["gepa<br/>(Genetic-Pareto)"]
    TrainingHub -.->|"gepa extra"| MLflow["mlflow<br/>(experiment tracking)"]

    %% Optional: runtime
    TrainingHub -.->|"runtime"| WandB["wandb<br/>(experiment tracking)"]

    %% Internal RHOAI Dependencies
    TrainingHub ==>|"rollout generation"| vLLM["vLLM<br/>(inference server)"]
    TrainingHub ==>|"rollout adapter"| ITSHub["ITS Hub<br/>(generation algorithms)"]

    %% Styling
    style TrainingHub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required deps - green
    style ILT fill:#7ed321,stroke:#333
    style MiniTrainer fill:#7ed321,stroke:#333
    style PyTorch fill:#7ed321,stroke:#333
    style Transformers fill:#7ed321,stroke:#333
    style Datasets fill:#7ed321,stroke:#333
    style PEFT fill:#7ed321,stroke:#333
    style Accelerate fill:#7ed321,stroke:#333
    style Pandas fill:#7ed321,stroke:#333
    style Matplotlib fill:#7ed321,stroke:#333

    %% Optional deps - orange
    style FlashAttn fill:#f5a623,stroke:#333
    style BitsAndBytes fill:#f5a623,stroke:#333
    style LigerKernel fill:#f5a623,stroke:#333
    style Unsloth fill:#f5a623,stroke:#333
    style TRL fill:#f5a623,stroke:#333
    style ART fill:#f5a623,stroke:#333
    style LiteLLM fill:#f5a623,stroke:#333
    style VeRL fill:#f5a623,stroke:#333
    style GEPA fill:#f5a623,stroke:#333
    style MLflow fill:#f5a623,stroke:#333
    style WandB fill:#f5a623,stroke:#333

    %% Internal RHOAI deps - blue
    style vLLM fill:#4a90e2,stroke:#333,color:#fff
    style ITSHub fill:#4a90e2,stroke:#333,color:#fff
