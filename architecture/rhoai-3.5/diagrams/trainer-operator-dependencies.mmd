graph LR
    TrainerOp["Trainer Operator<br/>(odh-trainer-operator)"]

    %% External Dependencies (required)
    TrainerOp -->|"API types<br/>v2.2.0"| KubeflowTrainer["Kubeflow Trainer<br/>v2.2.0"]
    TrainerOp -->|"cluster detection<br/>kustomize rendering<br/>label mgmt, GC"| ODHPlatformUtils["odh-platform-utilities<br/>v0.1.0"]
    TrainerOp -->|"controller framework<br/>v0.23.3"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    TrainerOp -->|"distributed job<br/>orchestration"| JobSetCRD["JobSet CRD<br/>v0.10.1+"]
    TrainerOp -->|"provides JobSet CRD<br/>(OpenShift only)"| JobSetOperator["JobSet Operator<br/>(OLM-managed)"]

    %% Internal Platform Dependencies
    PlatformOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates Trainer CR"| TrainerOp
    TrainerOp -->|"reads platform version"| TrainerConfig["odh-trainer-config<br/>ConfigMap"]
    TrainerOp -->|"validates health<br/>OLM + CRD + CR"| JobSetOperator

    %% Integration Points (downstream consumers)
    KFController["Kubeflow Trainer<br/>Controller (deployed)"] -->|"creates JobSet CRs"| JobSetCtrl["JobSet Controller"]
    TrainerOp -->|"deploys"| KFController

    %% Monitoring
    Prometheus["Prometheus"] -->|"PodMonitor scrape<br/>8443/TCP HTTPS"| KFController
    Prometheus -->|"metrics scrape<br/>8080/TCP HTTP"| TrainerOp

    %% OpenShift integration
    TrainerOp -->|"provisions ImageStreams"| OSImageRegistry["OpenShift<br/>Image Registry"]

    %% Optional scheduling integrations
    KFController -.->|"gang scheduling<br/>PodGroups"| Volcano["Volcano Scheduler"]
    KFController -.->|"pod scheduling<br/>PodGroups"| Kueue["Kueue"]

    %% K8s API (central)
    TrainerOp -->|"CR watches<br/>resource CRUD"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    KFController -->|"TrainJob reconciliation<br/>JobSet CRUD"| K8sAPI

