graph TB
    subgraph MaaS["Models as a Service (MaaS) Platform"]
        direction TB

        subgraph ControlPlane["Control Plane (opendatahub namespace)"]
            Controller["maas-controller<br/>Go Operator<br/>8080/TCP metrics<br/>8081/TCP health<br/>443/TCP webhook"]
            Webhook["Admission Webhooks<br/>AITenant validation<br/>MaaSAuthPolicy validation<br/>MaaSSubscription validation"]
            Controller -->|registers| Webhook
        end

        subgraph DataPlane["Data Plane (per-tenant namespace)"]
            MaaSAPI["maas-api<br/>Go HTTP Service (Gin)<br/>8443/TCP HTTPS<br/>9090/TCP metrics"]
        end

        subgraph IngressPlane["Ingress Processing (openshift-ingress)"]
            PayloadProc["payload-processing<br/>gRPC ext_proc<br/>9004/TCP gRPC<br/>9005/TCP metrics"]
        end
    end

    %% CRDs
    subgraph CRDs["MaaS Custom Resources"]
        AITenant["AITenant<br/>maas.opendatahub.io/v1alpha1"]
        MaasTenantConfig["MaasTenantConfig<br/>maas.opendatahub.io/v1alpha1"]
        MaaSModelRef["MaaSModelRef<br/>maas.opendatahub.io/v1alpha1"]
        MaaSAuthPolicy["MaaSAuthPolicy<br/>maas.opendatahub.io/v1alpha1"]
        MaaSSubscription["MaaSSubscription<br/>maas.opendatahub.io/v1alpha1"]
        ExternalModel["ExternalModel<br/>maas.opendatahub.io/v1alpha1"]
        Config["Config<br/>maas.opendatahub.io/v1alpha1"]
    end

    %% Generated Resources
    subgraph Generated["Generated Kubernetes Resources"]
        HTTPRoute["HTTPRoute<br/>Gateway API"]
        AuthPolicy["AuthPolicy<br/>Kuadrant"]
        TokenRateLimit["TokenRateLimitPolicy<br/>Kuadrant"]
        NetworkPolicy["NetworkPolicy"]
        ServiceEntry["ServiceEntry<br/>Istio"]
        DestinationRule["DestinationRule<br/>Istio"]
        EnvoyFilter["EnvoyFilter<br/>Istio"]
    end

    %% External Dependencies
    Gateway["Gateway API Gateway<br/>maas-default-gateway<br/>443/TCP HTTPS"]
    Authorino["Authorino<br/>AuthN/AuthZ"]
    Limitador["Limitador<br/>Rate Limiting"]
    PostgreSQL["PostgreSQL<br/>5432/TCP"]

    %% Flows
    Admin["Platform Admin"] -->|creates| AITenant
    User["Data Scientist"] -->|creates| MaaSModelRef
    User -->|creates| MaaSSubscription

    AITenant -->|watched by| Controller
    MaasTenantConfig -->|watched by| Controller
    MaaSModelRef -->|watched by| Controller
    MaaSAuthPolicy -->|watched by| Controller
    MaaSSubscription -->|watched by| Controller
    ExternalModel -->|watched by| Controller

    Controller -->|creates| HTTPRoute
    Controller -->|creates| AuthPolicy
    Controller -->|creates| TokenRateLimit
    Controller -->|creates| NetworkPolicy
    Controller -->|creates| ServiceEntry
    Controller -->|creates| DestinationRule
    Controller -->|creates| EnvoyFilter
    Controller -->|deploys per-tenant| MaaSAPI

    MaaSAPI -->|queries| PostgreSQL
    Authorino -->|validates keys via| MaaSAPI
    Gateway -->|ext_proc| PayloadProc

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style MaaSAPI fill:#4a90e2,stroke:#333,color:#fff
    style PayloadProc fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style AITenant fill:#f5a623,stroke:#333
    style MaasTenantConfig fill:#f5a623,stroke:#333
    style MaaSModelRef fill:#f5a623,stroke:#333
    style MaaSAuthPolicy fill:#f5a623,stroke:#333
    style MaaSSubscription fill:#f5a623,stroke:#333
    style ExternalModel fill:#f5a623,stroke:#333
    style Config fill:#f5a623,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style AuthPolicy fill:#7ed321,stroke:#333
    style TokenRateLimit fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style ServiceEntry fill:#7ed321,stroke:#333
    style DestinationRule fill:#7ed321,stroke:#333
    style EnvoyFilter fill:#7ed321,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style Authorino fill:#e8e8e8,stroke:#333
    style Limitador fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
