graph TB
    subgraph WVA["Workload Variant Autoscaler (WVA)"]
        direction TB
        ControllerMgr["WVA Controller Manager<br/>(controller-runtime / kubebuilder)"]

        subgraph Engines["Optimization Engines"]
            SatEngine["Saturation Engine<br/>(15-60s loop)"]
            SFZEngine["Scale-From-Zero Engine<br/>(100ms polling)"]
        end

        subgraph Pipeline["Analyzer Pipeline"]
            V2Analyzer["V2 Token/Capacity<br/>Analyzer"]
            QueueAnalyzer["Queueing Model<br/>Analyzer (M/M/1)"]
            ThroughputAnalyzer["Throughput<br/>Analyzer (ITL)"]
            CostOptimizer["Cost-Aware<br/>Optimizer"]
            GreedyOptimizer["Greedy-By-Score<br/>Optimizer"]
            Enforcer["Enforcer<br/>(Limiter + Actuator)"]
        end

        subgraph Coordinator["Coordinator (Experimental)"]
            CoordLoop["Leader-Elected Loop"]
            GPURebalance["GPU Rebalance<br/>Plugin"]
            CoordLoop -->|dispatches| GPURebalance
        end

        subgraph Infrastructure["Infrastructure"]
            MetricsCollector["Metrics Collector<br/>(Prometheus + Pod Scraping)"]
            GPUDiscovery["GPU Discovery<br/>(Node Labels)"]
            Datastore["In-Memory<br/>Datastore"]
        end

        ControllerMgr -->|runs| SatEngine
        ControllerMgr -->|runs| SFZEngine
        ControllerMgr -->|runs| CoordLoop

        SatEngine -->|invokes| V2Analyzer
        SatEngine -->|invokes| QueueAnalyzer
        SatEngine -->|invokes| ThroughputAnalyzer
        V2Analyzer -->|VariantCapacity| CostOptimizer
        QueueAnalyzer -->|VariantCapacity| CostOptimizer
        ThroughputAnalyzer -->|VariantCapacity| CostOptimizer
        V2Analyzer -->|VariantCapacity| GreedyOptimizer
        QueueAnalyzer -->|VariantCapacity| GreedyOptimizer
        CostOptimizer -->|decisions| Enforcer
        GreedyOptimizer -->|decisions| Enforcer

        MetricsCollector -->|replica metrics| SatEngine
        MetricsCollector -->|EPP queue metrics| SFZEngine
        GPUDiscovery -->|GPU inventory| Enforcer
    end

    %% External Inputs
    HPACR["HPA<br/>(autoscaling/v2)"]
    ScaledObjectCR["KEDA ScaledObject"]
    InferencePoolCR["InferencePool CR"]
    ConfigMapCR["ConfigMap<br/>(per-namespace overrides)"]
    VariantAutoscalingCR["VariantAutoscaling<br/>(llmd.ai/v1alpha1)<br/>⚠ In-memory only"]

    HPACR -->|"watched by<br/>(llm-d.ai/managed: true)"| ControllerMgr
    ScaledObjectCR -->|"watched by<br/>(llm-d.ai/managed: true)"| ControllerMgr
    InferencePoolCR -->|watched by| ControllerMgr
    ConfigMapCR -->|watched by| ControllerMgr
    ControllerMgr -->|synthesizes| VariantAutoscalingCR

    %% External Dependencies
    Prometheus["Prometheus<br/>9090/9091 TCP"]
    EPP["EPP Pods<br/>(Endpoint Picker Proxy)"]
    K8sAPI["Kubernetes API<br/>443/TCP"]
    Nodes["Cluster Nodes<br/>(GPU labels)"]

    MetricsCollector -->|PromQL queries| Prometheus
    MetricsCollector -->|direct scraping| EPP
    ControllerMgr -->|watch/patch| K8sAPI
    GPUDiscovery -->|read labels| Nodes

    %% Outputs
    PrometheusMetrics["/metrics Endpoint<br/>8443/TCP HTTPS<br/>(wva_desired_replicas + 25 metrics)"]
    Enforcer -->|emits| PrometheusMetrics

    HPARead["HPA / KEDA<br/>(reads wva_desired_replicas)"]
    PrometheusMetrics -->|scraped by| Prometheus
    Prometheus -->|external metrics| HPARead
    HPARead -->|scales| Deployments["Model Server<br/>Deployments"]

    SFZEngine -->|"direct scale patch<br/>(0→1)"| Deployments

    %% Styling
    style ControllerMgr fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style SatEngine fill:#7ed321,stroke:#333
    style SFZEngine fill:#7ed321,stroke:#333
    style V2Analyzer fill:#b8e6b8,stroke:#333
    style QueueAnalyzer fill:#b8e6b8,stroke:#333
    style ThroughputAnalyzer fill:#b8e6b8,stroke:#333
    style CostOptimizer fill:#f5a623,stroke:#333
    style GreedyOptimizer fill:#f5a623,stroke:#333
    style Enforcer fill:#e8744f,stroke:#333,color:#fff
    style CoordLoop fill:#9b59b6,stroke:#333,color:#fff
    style GPURebalance fill:#9b59b6,stroke:#333,color:#fff
    style MetricsCollector fill:#5bc0de,stroke:#333
    style GPUDiscovery fill:#5bc0de,stroke:#333
    style Datastore fill:#5bc0de,stroke:#333
    style VariantAutoscalingCR fill:#f5a623,stroke:#333
    style HPACR fill:#f5a623,stroke:#333
    style ScaledObjectCR fill:#f5a623,stroke:#333
    style InferencePoolCR fill:#f5a623,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style EPP fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PrometheusMetrics fill:#d4edda,stroke:#333
