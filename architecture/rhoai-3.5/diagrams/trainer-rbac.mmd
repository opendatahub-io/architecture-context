    style CRB fill:#6cb4ee,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style AdminRole fill:#e06666,stroke:#333,color:#fff
    style EditRole fill:#f6b26b,stroke:#333
    style ViewRole fill:#93c47d,stroke:#333

    style TrainJobs fill:#7ed321,stroke:#333
    style TrainingRuntimes fill:#7ed321,stroke:#333
    style ClusterTrainingRuntimes fill:#7ed321,stroke:#333
