graph TD
    subgraph "Service Accounts"
        SA["kubeflow-trainer-controller-manager<br/>(Namespace: opendatahub)"]
    end

    subgraph "ClusterRole Bindings"
        CRB["kubeflow-trainer-controller-manager<br/>(ClusterRoleBinding)"]
    end

    subgraph "ClusterRoles"
        CR["kubeflow-trainer-controller-manager<br/>(ClusterRole)"]
        AdminRole["training-admin<br/>(Aggregated ClusterRole)"]
        EditRole["training-edit<br/>(Aggregated ClusterRole)"]
        ViewRole["training-view<br/>(Aggregated ClusterRole)"]
    end

    subgraph "Core API Resources"
        ConfigMaps["core<br/>ConfigMaps, Secrets<br/>create,get,list,patch,update,watch"]
        Events["core<br/>Events<br/>create,patch,update,watch"]
        LimitRanges["core<br/>LimitRanges<br/>get,list,watch"]
        Pods["core<br/>Pods<br/>get,list"]
    end

    subgraph "Kubernetes API Resources"
        WebhookConfigs["admissionregistration.k8s.io<br/>ValidatingWebhookConfigurations<br/>get,list,update,watch"]
        Leases["coordination.k8s.io<br/>Leases<br/>create,get,list,update"]
        NetworkPolicies["networking.k8s.io<br/>NetworkPolicies<br/>get,list,watch,create,update,patch"]
        RuntimeClasses["node.k8s.io<br/>RuntimeClasses<br/>get,list,watch"]
    end

    subgraph "OpenShift Resources"
        APIServers["config.openshift.io<br/>APIServers<br/>get"]
    end

    subgraph "Workload Resources"
        JobSets["jobset.x-k8s.io<br/>JobSets<br/>create,get,list,patch,update,watch"]
        SchedPodGroups["scheduling.x-k8s.io<br/>PodGroups<br/>create,get,list,patch,update,watch"]
        VolcanoPodGroups["scheduling.volcano.sh<br/>PodGroups<br/>create,get,list,patch,update,watch"]
    end

    subgraph "Trainer CRD Resources"
        TrainJobs["trainer.kubeflow.org<br/>TrainJobs (+status,+finalizers)<br/>get,list,patch,update,watch"]
        TrainingRuntimes["trainer.kubeflow.org<br/>TrainingRuntimes (+finalizers)<br/>get,list,patch,update,watch"]
        ClusterTrainingRuntimes["trainer.kubeflow.org<br/>ClusterTrainingRuntimes (+finalizers)<br/>get,list,patch,update,watch"]
    end

    subgraph "User-Facing Roles"
        AdminResources["trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>full CRUD"]
        EditResources["trainjobs: full CRUD<br/>runtimes: read-only"]
        ViewResources["all trainer resources<br/>read-only"]
    end

    %% Operator RBAC chain
    SA -->|bound via| CRB
    CRB -->|grants| CR

    CR --> ConfigMaps
    CR --> Events
    CR --> LimitRanges
    CR --> Pods
    CR --> WebhookConfigs
    CR --> Leases
    CR --> NetworkPolicies
    CR --> RuntimeClasses
    CR --> APIServers
    CR --> JobSets
    CR --> SchedPodGroups
    CR --> VolcanoPodGroups
    CR --> TrainJobs
    CR --> TrainingRuntimes
    CR --> ClusterTrainingRuntimes

    %% User-facing roles
    AdminRole --> AdminResources
    EditRole --> EditResources
    ViewRole --> ViewResources

