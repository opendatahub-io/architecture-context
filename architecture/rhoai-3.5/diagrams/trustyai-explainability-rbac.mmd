graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["trustyai-serviceaccount"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["trustyai-clusterrolebinding<br/>(cluster-wide)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["trustyai-role"]
    end

    subgraph APIResources["API Resources"]
        ConfigMaps["core (v1)<br/>configmaps"]
    end

    subgraph Verbs["Permitted Operations"]
        ConfigMapVerbs["create, delete, get,<br/>list, patch, update, watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"permits"| ConfigMapVerbs
    ConfigMapVerbs -->|"on resource"| ConfigMaps

    subgraph AuthEnforcement["Authentication & Authorization Enforcement"]
        direction TB
        KubeRBACProxy["kube-rbac-proxy sidecar<br/>(injected by TrustyAI Service Operator)"]
        TokenReview["AuthN: Kubernetes TokenReview<br/>Validates bearer tokens"]
        SAR["AuthZ: SubjectAccessReview<br/>Checks RBAC permissions"]
        KubeRBACProxy --> TokenReview
        TokenReview --> SAR
    end

    subgraph ProtectedEndpoints["Protected Endpoints (via kube-rbac-proxy)"]
        FairnessAPIs["/metrics/group/fairness/*<br/>SPD, DIR"]
        DriftAPIs["/metrics/drift/*<br/>KSTest, FourierMMD, Meanshift"]
        DataAPIs["/data/upload, /data/download"]
        InfoAPIs["/info, /info/tags, /info/names"]
        ExplainerAPIs["/explainers/local/*<br/>(disabled in RHOAI)"]
    end

    subgraph MetricsAuth["Metrics Authentication"]
        PrometheusAuth["Prometheus scrape<br/>/q/metrics<br/>Auth: Bearer Token (SA)<br/>via ServiceMonitor bearerTokenFile"]
    end

    SAR -->|"authorizes access to"| ProtectedEndpoints

    subgraph SecretsManaged["Secrets"]
        TLSCert["TLS cert<br/>/etc/tls/internal/tls.crt<br/>Provisioned by: cert-manager/operator<br/>Rotation: Unknown"]
        DBCreds["Database credentials<br/>QUARKUS_DATASOURCE_USERNAME<br/>QUARKUS_DATASOURCE_PASSWORD<br/>Provisioned by: Manual/operator<br/>Rotation: No"]
        MinIOCreds["MinIO credentials<br/>minio.access-key<br/>minio.secret-key<br/>Provisioned by: Manual/operator<br/>Rotation: No"]
    end

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e67e22,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style ConfigMapVerbs fill:#9b59b6,stroke:#333,color:#fff
    style KubeRBACProxy fill:#e74c3c,stroke:#333,color:#fff
    style TokenReview fill:#c0392b,stroke:#333,color:#fff
    style SAR fill:#c0392b,stroke:#333,color:#fff
    style TLSCert fill:#f39c12,stroke:#333,color:#fff
    style DBCreds fill:#f39c12,stroke:#333,color:#fff
    style MinIOCreds fill:#f39c12,stroke:#333,color:#fff
