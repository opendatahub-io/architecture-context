graph LR
    OGXOp["OGX K8s Operator<br/>(ogx-operator + ogx-module)"]

    %% External Dependencies (required libraries/frameworks)
    OGXOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    OGXOp -->|"OpenShift APIs"| OSApi["openshift/api<br/>v0.0.0-20260610"]
    OGXOp -->|"TLS profile mgmt"| OSCtrlCommon["openshift/controller-runtime-common<br/>v0.0.0-20260428"]
    OGXOp -->|"OCI image labels"| GoContainerReg["google/go-containerregistry<br/>v0.21.7"]
    OGXOp -->|"manifest rendering"| Kustomize["kustomize<br/>v0.21.0"]

    %% Optional External Dependencies
    OGXOp -.->|"monitoring CRDs<br/>(detected at runtime)"| PrometheusOp["prometheus-operator<br/>v0.82.0"]

    %% Internal Platform Dependencies
    OGXOp -->|"CRD: OGX platform CR"| PlatformOp["rhods-operator /<br/>opendatahub-operator"]
    OGXOp -->|"Go library:<br/>Deployer, GarbageCollector,<br/>status management"| ODHPlatUtils["odh-platform-utilities"]
    OGXOp -.->|"ConfigMap watch:<br/>custom CA bundle"| ODHTrustedCA["odh-trusted-ca-bundle<br/>ConfigMap"]

    %% Integration Points (other components that interact with OGX)
    PlatformOp -->|"creates OGX CR<br/>to enable component"| OGXOp

    %% External Services (runtime dependencies)
    OGXOp -->|"resource CRUD<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]
    OGXOp -->|"image label fetch<br/>443/TCP HTTPS"| OCIReg["OCI Container Registry"]
    OGXOp -->|"TLS cert issuance"| CertMgr["cert-manager"]
    OGXOp -->|"TLS config profile<br/>6443/TCP HTTPS"| OSAPIServer["OpenShift API Server<br/>config"]

    %% OGX Server Pod dependencies (downstream of operator)
    OGXPod["OGX Server Pods<br/>(managed instances)"]
    OGXOp -->|"creates & manages"| OGXPod
    OGXPod -->|"inference<br/>443/TCP HTTPS"| InferenceProv["Inference Providers<br/>(vLLM, OpenAI, Azure,<br/>Bedrock, VertexAI, Watsonx)"]
    OGXPod -->|"vector I/O<br/>TCP configurable"| VectorDB["Vector Databases<br/>(PGVector, Milvus, Qdrant)"]
    OGXPod -->|"tool runtime<br/>443/TCP HTTPS"| SearchAPIs["Search APIs<br/>(Brave, Tavily)"]
    OGXPod -->|"file storage<br/>443/TCP HTTPS"| S3["AWS S3 / S3-compatible"]
    OGXPod -.->|"SQL storage<br/>5432/TCP"| Postgres["PostgreSQL"]
    OGXPod -.->|"KV storage<br/>6379/TCP"| Redis["Redis"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"metrics scrape<br/>9464/TCP HTTP"| OGXPod
    Prometheus -->|"metrics scrape<br/>8080/TCP TLS"| OGXOp

    %% Styling
    style OGXOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OGXPod fill:#4a90e2,stroke:#333,color:#fff

    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style OSApi fill:#999,stroke:#333,color:#fff
    style OSCtrlCommon fill:#999,stroke:#333,color:#fff
    style GoContainerReg fill:#999,stroke:#333,color:#fff
    style Kustomize fill:#999,stroke:#333,color:#fff
    style PrometheusOp fill:#999,stroke:#333,stroke-dasharray: 5 5,color:#fff

    style PlatformOp fill:#7ed321,stroke:#333,color:#fff
    style ODHPlatUtils fill:#7ed321,stroke:#333,color:#fff
    style ODHTrustedCA fill:#7ed321,stroke:#333,stroke-dasharray: 5 5,color:#fff

    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style OCIReg fill:#f5a623,stroke:#333,color:#fff
    style CertMgr fill:#f5a623,stroke:#333,color:#fff
    style OSAPIServer fill:#f5a623,stroke:#333,color:#fff

    style InferenceProv fill:#f5a623,stroke:#333,color:#fff
    style VectorDB fill:#f5a623,stroke:#333,color:#fff
    style SearchAPIs fill:#f5a623,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style Postgres fill:#f5a623,stroke:#333,stroke-dasharray: 5 5,color:#fff
    style Redis fill:#f5a623,stroke:#333,stroke-dasharray: 5 5,color:#fff
    style Prometheus fill:#e1d5e7,stroke:#9673a6,color:#333
