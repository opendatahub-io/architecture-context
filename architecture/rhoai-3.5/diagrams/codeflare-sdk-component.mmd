graph TB
    subgraph UserEnv["User Environment"]
        Notebook["Jupyter Notebook<br/>or Local Python"]
    end

    subgraph SDK["CodeFlare SDK"]
        direction TB

        subgraph RayLayer["Feature Layer: ray/"]
            ClusterMod["ray.cluster<br/>RayCluster lifecycle<br/>(create, apply, delete, monitor)"]
            RayJobsMod["ray.rayjobs<br/>RayJob lifecycle<br/>(submit, stop, resubmit, delete)"]
            ClientMod["ray.client<br/>Ray JobSubmissionClient<br/>(direct dashboard API)"]
        end

        subgraph CommonLayer["Foundation Layer: common/"]
            K8sCluster["kubernetes_cluster<br/>Auth & API client<br/>(kube-authkit, TokenAuth)"]
            KueueMod["kueue<br/>LocalQueue discovery<br/>& priority validation"]
            GenCert["generate_cert<br/>mTLS cert generation<br/>(RSA 3072 + SHA-256)"]
            Widgets["widgets<br/>Jupyter ipywidgets<br/>(apply/delete/viewer)"]
        end

        subgraph Vendored["Vendored"]
            KubeRayClient["vendored.python_client<br/>KubeRay API wrapper<br/>(RayJob/RayCluster CRUD)"]
        end
    end

    %% User interaction
    Notebook -->|"Python API"| ClusterMod
    Notebook -->|"Python API"| RayJobsMod
    Notebook -->|"Python API"| ClientMod
    Widgets -->|"interactive UI"| ClusterMod

    %% Internal dependencies
    ClusterMod -->|"auth"| K8sCluster
    ClusterMod -->|"queue labels"| KueueMod
    ClusterMod -->|"mTLS certs"| GenCert
    RayJobsMod -->|"auth"| K8sCluster
    RayJobsMod -->|"queue labels"| KueueMod
    RayJobsMod -->|"CRUD ops"| KubeRayClient

    %% External CRDs consumed
    ClusterMod -->|"creates/manages"| RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobsMod -->|"creates/manages"| RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    KueueMod -->|"queries"| LocalQueueCR["LocalQueue CR<br/>(kueue.x-k8s.io/v1beta1)"]
    ClusterMod -->|"queries"| HTTPRouteCR["HTTPRoute CR<br/>(gateway.networking.k8s.io/v1)"]

    %% External systems
    K8sCluster -->|"6443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]
    ClientMod -->|"8265/TCP mTLS"| RayDashboard["Ray Dashboard"]
    GenCert -->|"reads CA"| CASecret["KubeRay CA Secret"]

    %% Styling
    style SDK fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style RayLayer fill:#d5e8f8,stroke:#4a90e2,stroke-width:1px
    style CommonLayer fill:#dcedc8,stroke:#82b366,stroke-width:1px
    style Vendored fill:#fff3e0,stroke:#f5a623,stroke-width:1px
    style UserEnv fill:#f9f9f9,stroke:#999,stroke-width:1px

    style ClusterMod fill:#4a90e2,color:#fff
    style RayJobsMod fill:#4a90e2,color:#fff
    style ClientMod fill:#4a90e2,color:#fff
    style K8sCluster fill:#7ed321,color:#fff
    style KueueMod fill:#7ed321,color:#fff
    style GenCert fill:#7ed321,color:#fff
    style Widgets fill:#7ed321,color:#fff
    style KubeRayClient fill:#f5a623,color:#fff

    style RayClusterCR fill:#fff2cc,stroke:#d6b656
    style RayJobCR fill:#fff2cc,stroke:#d6b656
    style LocalQueueCR fill:#fff2cc,stroke:#d6b656
    style HTTPRouteCR fill:#fff2cc,stroke:#d6b656
    style K8sAPI fill:#e8e8e8,stroke:#666
    style RayDashboard fill:#e8e8e8,stroke:#666
    style CASecret fill:#e8e8e8,stroke:#666
