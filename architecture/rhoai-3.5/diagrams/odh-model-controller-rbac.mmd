graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["odh-model-controller<br/>(ns: opendatahub)"]
        SA_API["model-serving-api<br/>(ns: opendatahub)"]
        SA_Metrics["controller-manager<br/>(ns: opendatahub)"]
        SA_Dynamic["{isvc-sa} (dynamic)<br/>(ns: user namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["odh-model-controller-rolebinding-opendatahub"]
        CRB_Leader["leader-election-rolebinding"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_Metrics["metrics-auth-rolebinding"]
        CRB_API["model-serving-api"]
        CRB_Dynamic["{ns}-{sa}-auth-delegator<br/>(dynamic, per ISVC)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["odh-model-controller-role"]
        CR_Leader["leader-election-role"]
        CR_Proxy["proxy-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_API["model-serving-api"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_AcctEditor["account-editor-role"]
        CR_AcctViewer["account-viewer-role"]
        CR_KServeProm["kserve-prometheus-k8s"]
    end

    subgraph MainRoleResources["odh-model-controller-role Resources"]
        direction LR

        subgraph Core["core ("")"]
            CoreRes["configmaps, secrets,<br/>serviceaccounts, services,<br/>endpoints, namespaces,<br/>pods, events"]
        end

        subgraph KServeCRDs["serving.kserve.io"]
            KServeRes["inferenceservices,<br/>llminferenceservices,<br/>llminferenceserviceconfigs,<br/>servingruntimes,<br/>inferencegraphs"]
        end

        subgraph NIMCRDs["nim.opendatahub.io"]
            NIMRes["accounts"]
        end

        subgraph GatewayCRDs["gateway.networking.k8s.io"]
            GWRes["gateways, httproutes"]
        end

        subgraph KuadrantCRDs["kuadrant.io"]
            KuadrantRes["authpolicies, kuadrants"]
        end

        subgraph IstioCRDs["networking.istio.io"]
            IstioRes["envoyfilters"]
        end

        subgraph OpenShiftCRDs["route.openshift.io /<br/>template.openshift.io"]
            OSRes["routes,<br/>routes/custom-host,<br/>templates"]
        end

        subgraph MonitoringCRDs["monitoring.coreos.com"]
            MonRes["servicemonitors,<br/>podmonitors"]
        end

        subgraph OtherCRDs["Other API Groups"]
            OtherRes["networkpolicies (networking.k8s.io)<br/>triggerauthentications (keda.sh)<br/>clusterrolebindings, roles (rbac)<br/>datascienceclusters (dsc)<br/>dscinitializations (dsci)<br/>hardwareprofiles (infra)<br/>authentications (config.openshift.io)"]
        end
    end

    subgraph APIRoleResources["model-serving-api Role Resources"]
        APIRes["gateways (list)<br/>namespaces (get)"]
    end

    subgraph ProxyResources["proxy-role / metrics-auth-role Resources"]
        ProxyRes["tokenreviews (create)<br/>subjectaccessreviews (create)"]
    end

    %% Service Account → Binding
    SA_Controller -->|bound via| CRB_Main
    SA_Controller -->|bound via| CRB_Leader
    SA_Controller -->|bound via| CRB_Proxy
    SA_Metrics -->|bound via| CRB_Metrics
    SA_API -->|bound via| CRB_API
    SA_Dynamic -->|bound via| CRB_Dynamic

    %% Binding → Role
    CRB_Main -->|grants| CR_Main
    CRB_Leader -->|grants| CR_Leader
    CRB_Proxy -->|grants| CR_Proxy
    CRB_Metrics -->|grants| CR_MetricsAuth
    CRB_API -->|grants| CR_API
    CRB_Dynamic -->|grants| CR_AuthDelegator

    %% Role → Resources
    CR_Main -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| CoreRes
    CR_Main -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| KServeRes
    CR_Main -->|"get, list, watch,<br/>update, patch"| NIMRes
    CR_Main -->|"get, list, watch,<br/>update, patch"| GWRes
    CR_Main -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| KuadrantRes
    CR_Main -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| IstioRes
    CR_Main -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| OSRes
    CR_Main -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| MonRes
    CR_Main -->|"varies per resource"| OtherRes
    CR_API -->|"list, get"| APIRes
    CR_Proxy -->|"create"| ProxyRes
    CR_MetricsAuth -->|"create"| ProxyRes

