    style SA_Controller fill:#4a90e2,color:#fff
    style SA_API fill:#4a90e2,color:#fff
    style SA_Metrics fill:#4a90e2,color:#fff
    style SA_Dynamic fill:#4a90e2,color:#fff,stroke-dasharray: 5 5
    style CR_Main fill:#f5a623,color:#fff
    style CR_Leader fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_API fill:#f5a623,color:#fff
    style CR_AuthDelegator fill:#f5a623,color:#fff
    style CR_AcctEditor fill:#f5a623,color:#fff
    style CR_AcctViewer fill:#f5a623,color:#fff
    style CR_KServeProm fill:#f5a623,color:#fff
    style CoreRes fill:#7ed321,color:#fff
    style KServeRes fill:#7ed321,color:#fff
    style NIMRes fill:#7ed321,color:#fff
    style GWRes fill:#7ed321,color:#fff
    style KuadrantRes fill:#7ed321,color:#fff
    style IstioRes fill:#7ed321,color:#fff
    style OSRes fill:#7ed321,color:#fff
    style MonRes fill:#7ed321,color:#fff
    style OtherRes fill:#7ed321,color:#fff
