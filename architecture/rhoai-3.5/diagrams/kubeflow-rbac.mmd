graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_KF["notebook-controller-<br/>service-account"]
        SA_ODH["odh-notebook-controller-<br/>manager"]
        SA_NB["{notebook-name}<br/>(per notebook)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_KF["notebook-controller-<br/>role-binding"]
        CRB_ODH["odh-notebook-controller-<br/>manager-rolebinding"]
        CRB_AUTH["{notebook-name}-rbac-<br/>{namespace}-auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_KF["notebook-controller-role"]
        CR_ODH["odh-notebook-controller-<br/>manager-role"]
        CR_AUTH["system:auth-delegator"]
        CR_ADMIN["kubeflow-notebooks-admin<br/>(aggregated to admin)"]
        CR_EDIT["kubeflow-notebooks-edit"]
        CR_VIEW["kubeflow-notebooks-view"]
    end

    subgraph KF_Resources["notebook-controller-role Resources"]
        KF_Pods["core<br/>pods"]
        KF_Events["core<br/>events"]
        KF_Services["core<br/>services"]
        KF_StatefulSets["apps<br/>statefulsets"]
        KF_Notebooks["kubeflow.org<br/>notebooks, notebooks/status,<br/>notebooks/finalizers"]
        KF_VirtualServices["networking.istio.io<br/>virtualservices"]
    end

    subgraph ODH_Resources["odh-notebook-controller-manager-role Resources"]
        ODH_AuthN["authentication.k8s.io<br/>tokenreviews"]
        ODH_AuthZ["authorization.k8s.io<br/>subjectaccessreviews"]
        ODH_Notebooks["kubeflow.org<br/>notebooks, status, finalizers"]
        ODH_GatewayAPI["gateway.networking.k8s.io<br/>httproutes, referencegrants,<br/>gateways"]
        ODH_Core["core<br/>services, serviceaccounts,<br/>secrets, configmaps, events"]
        ODH_OpenShift["config.openshift.io<br/>proxies, apiservers"]
        ODH_NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
        ODH_OAuth["oauth.openshift.io<br/>oauthclients"]
        ODH_RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterrolebindings, clusterroles"]
        ODH_Routes["route.openshift.io<br/>routes"]
        ODH_ImageStreams["image.openshift.io<br/>imagestreams"]
        ODH_DSPA["datasciencepipelinesapplications<br/>.opendatahub.io<br/>datasciencepipelinesapplications"]
    end

    subgraph AggregatedResources["Aggregated Role Resources"]
        AGG_NB["kubeflow.org<br/>notebooks"]
    end

    subgraph NamespacedBindings["Per-Notebook Namespace Bindings"]
        RB_ELYRA["elyra-pipelines-{name}<br/>→ ds-pipeline-user-access-dspa"]
        RB_MLFLOW["{name}-mlflow<br/>→ mlflow-operator-mlflow-integration"]
    end

    %% SA → CRB
    SA_KF -->|"bound via"| CRB_KF
    SA_ODH -->|"bound via"| CRB_ODH
    SA_NB -->|"bound via"| CRB_AUTH

    %% CRB → CR
    CRB_KF -->|"grants"| CR_KF
    CRB_ODH -->|"grants"| CR_ODH
    CRB_AUTH -->|"grants"| CR_AUTH

    %% CR → Resources (notebook-controller)
    CR_KF -->|"get,list,watch,delete"| KF_Pods
    CR_KF -->|"get,list,watch,create,patch"| KF_Events
    CR_KF -->|"*"| KF_Services
    CR_KF -->|"*"| KF_StatefulSets
    CR_KF -->|"*"| KF_Notebooks
    CR_KF -->|"*"| KF_VirtualServices

    %% CR → Resources (odh-notebook-controller)
    CR_ODH -->|"create"| ODH_AuthN
    CR_ODH -->|"create"| ODH_AuthZ
    CR_ODH -->|"get,list,watch,patch,update"| ODH_Notebooks
    CR_ODH -->|"full CRUD"| ODH_GatewayAPI
    CR_ODH -->|"get,list,watch,create,update,patch"| ODH_Core
    CR_ODH -->|"get,list,watch"| ODH_OpenShift
    CR_ODH -->|"get,list,watch,create,update,patch"| ODH_NetworkPolicies
    CR_ODH -->|"get,list,watch,update,patch,delete"| ODH_OAuth
    CR_ODH -->|"full CRUD"| ODH_RBAC
    CR_ODH -->|"get,list,watch"| ODH_Routes
    CR_ODH -->|"list,get,watch"| ODH_ImageStreams
    CR_ODH -->|"get,list,watch + API CRUD"| ODH_DSPA

    %% Aggregated roles
    CR_ADMIN -->|"*"| AGG_NB
    CR_EDIT -->|"get,list,watch,create,delete,<br/>deletecollection,patch,update"| AGG_NB
    CR_VIEW -->|"get,list,watch"| AGG_NB

    %% Per-notebook bindings
    SA_NB -->|"namespace scoped"| RB_ELYRA
    SA_NB -->|"namespace scoped"| RB_MLFLOW

    %% Styling
    style SA_KF fill:#4a90e2,color:#fff
    style SA_ODH fill:#4a90e2,color:#fff
    style SA_NB fill:#4a90e2,color:#fff
    style CR_KF fill:#f5a623,color:#fff
    style CR_ODH fill:#f5a623,color:#fff
    style CR_AUTH fill:#f5a623,color:#fff
    style CR_ADMIN fill:#e8742c,color:#fff
    style CR_EDIT fill:#e8742c,color:#fff
    style CR_VIEW fill:#e8742c,color:#fff
    style CRB_KF fill:#9013fe,color:#fff
    style CRB_ODH fill:#9013fe,color:#fff
    style CRB_AUTH fill:#9013fe,color:#fff
    style KF_Notebooks fill:#7ed321,color:#fff
    style ODH_Notebooks fill:#7ed321,color:#fff
    style AGG_NB fill:#7ed321,color:#fff
    style ODH_GatewayAPI fill:#7ed321,color:#fff
    style ODH_RBAC fill:#7ed321,color:#fff
    style RB_ELYRA fill:#d0021b,color:#fff
    style RB_MLFLOW fill:#d0021b,color:#fff
