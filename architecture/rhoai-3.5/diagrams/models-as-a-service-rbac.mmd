graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["maas-controller<br/>(opendatahub)"]
        SA_API["maas-api<br/>(opendatahub)"]
        SA_PayloadProc["payload-processing<br/>(openshift-ingress)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Controller["maas-controller-rolebinding<br/>(cluster-scoped)"]
        CRB_ControllerConfig["maas-controller-cluster-config-rolebinding<br/>(cluster-scoped)"]
        CRB_API["maas-api<br/>(cluster-scoped)"]
        CRB_APISupplemental["maas-api-supplemental<br/>(cluster-scoped)"]
        CRB_PayloadProc["payload-processing-reader<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_LeaderElection["maas-controller-leader-election-rolebinding<br/>(opendatahub)"]
        RB_SecretMigrate["maas-controller-secret-migrate<br/>(opendatahub)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Controller["maas-controller-role"]
        CR_ControllerConfig["maas-controller-cluster-config-role"]
        CR_API["maas-api"]
        CR_Owner["maas-owner-role"]
        CR_Viewer["maas-viewer-role"]
        CR_PayloadProc["payload-processing-reader"]
    end

    subgraph Roles["Namespace Roles"]
        R_LeaderElection["maas-controller-leader-election-role<br/>(opendatahub)"]
        R_SecretMigrate["maas-controller-secret-migrate<br/>(opendatahub)"]
    end

    %% Controller bindings
    SA_Controller -->|bound via| CRB_Controller
    CRB_Controller -->|grants| CR_Controller
    SA_Controller -->|bound via| CRB_ControllerConfig
    CRB_ControllerConfig -->|grants| CR_ControllerConfig
    SA_Controller -->|bound via| RB_LeaderElection
    RB_LeaderElection -->|grants| R_LeaderElection
    SA_Controller -->|bound via| RB_SecretMigrate
    RB_SecretMigrate -->|grants| R_SecretMigrate

    %% API bindings
    SA_API -->|bound via| CRB_API
    CRB_API -->|grants| CR_API
    SA_API -->|bound via| CRB_APISupplemental

    %% Payload processing bindings
    SA_PayloadProc -->|bound via| CRB_PayloadProc
    CRB_PayloadProc -->|grants| CR_PayloadProc

    %% Controller role resources
    subgraph ControllerResources["maas-controller-role Resources"]
        MaasCRDs["maas.opendatahub.io<br/>aitenants, configs,<br/>externalmodels, maasauthpolicies,<br/>maasmodelrefs, maassubscriptions,<br/>maastenantconfigs, tenants<br/>→ full CRUD"]
        GatewayResources["gateway.networking.k8s.io<br/>gateways, httproutes<br/>→ full CRUD"]
        KuadrantResources["kuadrant.io<br/>authpolicies,<br/>tokenratelimitpolicies,<br/>ratelimitpolicies<br/>→ full CRUD"]
        IstioResources["networking.istio.io<br/>destinationrules,<br/>envoyfilters,<br/>serviceentries<br/>→ full CRUD"]
        KServeResources["serving.kserve.io<br/>llminferenceservices<br/>→ get, list, watch"]
        CoreResources["core<br/>namespaces, configmaps,<br/>services, serviceaccounts,<br/>secrets, events<br/>→ full CRUD"]
        RBACResources["rbac.authorization.k8s.io<br/>clusterroles, rolebindings,<br/>clusterrolebindings, roles<br/>→ full CRUD"]
        MonitoringResources["monitoring.coreos.com<br/>podmonitors, servicemonitors<br/>→ get, list, watch, create, patch, delete"]
        OSResources["config.openshift.io<br/>authentications<br/>→ get, list, watch"]
    end

    CR_Controller -->|"full CRUD"| MaasCRDs
    CR_Controller -->|"full CRUD"| GatewayResources
    CR_Controller -->|"full CRUD"| KuadrantResources
    CR_Controller -->|"full CRUD"| IstioResources
    CR_Controller -->|"read-only"| KServeResources
    CR_Controller -->|"full CRUD"| CoreResources
    CR_Controller -->|"full CRUD"| RBACResources
    CR_Controller -->|"create/patch/delete"| MonitoringResources
    CR_Controller -->|"read-only"| OSResources

    %% API role resources
    subgraph APIResources["maas-api Resources"]
        APIMaasCRDs["maas.opendatahub.io<br/>maasauthpolicies,<br/>maasmodelrefs,<br/>maassubscriptions<br/>→ get, list, watch"]
        APIGateway["gateway.networking.k8s.io<br/>httproutes, gateways<br/>→ get, list, watch"]
        APIAuth["authentication.k8s.io<br/>tokenreviews → create<br/>authorization.k8s.io<br/>subjectaccessreviews → create"]
        APICore["core<br/>secrets, namespaces,<br/>serviceaccounts, pods,<br/>services, endpoints<br/>→ get, list, watch, create"]
    end

    CR_API -->|"read-only"| APIMaasCRDs
    CR_API -->|"read-only"| APIGateway
    CR_API -->|"create"| APIAuth
    CR_API -->|"read + create"| APICore

    %% Payload processing resources
    subgraph PayloadResources["payload-processing-reader Resources"]
        PPModels["maas + inference.opendatahub.io<br/>externalmodels,<br/>externalproviders<br/>→ get, list, watch, create, update"]
        PPRoutes["gateway.networking.k8s.io<br/>httproutes<br/>→ full CRUD"]
        PPIstio["networking.istio.io<br/>serviceentries,<br/>destinationrules<br/>→ full CRUD"]
    end

    CR_PayloadProc -->|"read + update"| PPModels
    CR_PayloadProc -->|"full CRUD"| PPRoutes
    CR_PayloadProc -->|"full CRUD"| PPIstio

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_PayloadProc fill:#4a90e2,stroke:#333,color:#fff
    style CR_Controller fill:#f5a623,stroke:#333
    style CR_ControllerConfig fill:#f5a623,stroke:#333
    style CR_API fill:#f5a623,stroke:#333
    style CR_Owner fill:#f5a623,stroke:#333
    style CR_Viewer fill:#f5a623,stroke:#333
    style CR_PayloadProc fill:#f5a623,stroke:#333
    style R_LeaderElection fill:#e8c170,stroke:#333
    style R_SecretMigrate fill:#e8c170,stroke:#333
    style MaasCRDs fill:#7ed321,stroke:#333
    style GatewayResources fill:#7ed321,stroke:#333
    style KuadrantResources fill:#7ed321,stroke:#333
    style IstioResources fill:#7ed321,stroke:#333
    style KServeResources fill:#7ed321,stroke:#333
    style CoreResources fill:#7ed321,stroke:#333
    style RBACResources fill:#7ed321,stroke:#333
    style MonitoringResources fill:#7ed321,stroke:#333
    style OSResources fill:#7ed321,stroke:#333
    style APIMaasCRDs fill:#7ed321,stroke:#333
    style APIGateway fill:#7ed321,stroke:#333
    style APIAuth fill:#7ed321,stroke:#333
    style APICore fill:#7ed321,stroke:#333
    style PPModels fill:#7ed321,stroke:#333
    style PPRoutes fill:#7ed321,stroke:#333
    style PPIstio fill:#7ed321,stroke:#333
