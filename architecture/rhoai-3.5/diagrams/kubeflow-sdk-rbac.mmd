graph TD
    subgraph UserAuth["User Authentication"]
        Kubeconfig["kubeconfig / ServiceAccount Token<br/>(Bearer Token)"]
    end

    subgraph RequiredPerms["Required Kubernetes Permissions (Assumed)"]
        direction TB

        subgraph TrainerCRDs["trainer.kubeflow.org API Group"]
            TrainJob["TrainJob<br/>create, get, list, watch"]
            ClusterRuntime["ClusterTrainingRuntime<br/>get, list<br/>(cluster-scoped)"]
            NSRuntime["TrainingRuntime<br/>get, list<br/>(namespace-scoped)"]
        end

        subgraph CoreAPI["Core API Group"]
            Pods["Pods<br/>get, list"]
            PodLog["Pods/log<br/>get"]
            Events["Events<br/>list"]
            Secrets["Secrets<br/>get<br/>(data connection credentials)"]
            ConfigMaps["ConfigMaps<br/>get<br/>(kubeflow-trainer-public)"]
        end

        subgraph KatibCRDs["kubeflow.org API Group (Katib)"]
            Experiment["Experiment<br/>create, get, list, watch"]
        end

        subgraph SparkCRDs["spark.kubeflow.org API Group"]
            SparkServer["SparkConnectServer<br/>create, get, list, watch"]
        end
    end

    subgraph TenantScope["Tenant Scoping"]
        Namespace["Namespace Boundary<br/>All operations scoped to<br/>configured namespace<br/>(except ClusterTrainingRuntime)"]
    end

    subgraph ExternalAuth["External Service Auth"]
        ModelRegAuth["Model Registry<br/>User Token (optional PEM)"]
        S3Auth["S3 Storage<br/>AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY<br/>(from data connection Secret)"]
        HFAuth["HuggingFace Hub<br/>Access Token (optional)"]
    end

    Kubeconfig -->|authenticates to| TrainerCRDs
    Kubeconfig -->|authenticates to| CoreAPI
    Kubeconfig -->|authenticates to| KatibCRDs
    Kubeconfig -->|authenticates to| SparkCRDs

    Namespace -.->|scopes| TrainJob
    Namespace -.->|scopes| NSRuntime
    Namespace -.->|scopes| Pods
    Namespace -.->|scopes| PodLog
    Namespace -.->|scopes| Events
    Namespace -.->|scopes| Secrets
    Namespace -.->|scopes| ConfigMaps
    Namespace -.->|scopes| Experiment
    Namespace -.->|scopes| SparkServer

    %% Note: SDK defines no RBAC resources
    Note["NOTE: SDK defines no RBAC resources<br/>(no ClusterRoles, Roles, or Bindings).<br/>Permissions must be granted externally<br/>to the user's ServiceAccount."]

    style Kubeconfig fill:#4a90e2,stroke:#333,color:#fff
    style TrainJob fill:#c8e6c9,stroke:#2e7d32
    style ClusterRuntime fill:#fff9c4,stroke:#f9a825
    style NSRuntime fill:#c8e6c9,stroke:#2e7d32
    style Pods fill:#bbdefb,stroke:#1565c0
    style PodLog fill:#bbdefb,stroke:#1565c0
    style Events fill:#bbdefb,stroke:#1565c0
    style Secrets fill:#ffcdd2,stroke:#c62828
    style ConfigMaps fill:#bbdefb,stroke:#1565c0
    style Experiment fill:#c8e6c9,stroke:#2e7d32
    style SparkServer fill:#c8e6c9,stroke:#2e7d32
    style Namespace fill:#e1bee7,stroke:#7b1fa2
    style ModelRegAuth fill:#fff3e0,stroke:#e65100
    style S3Auth fill:#fff3e0,stroke:#e65100
    style HFAuth fill:#fff3e0,stroke:#e65100
    style Note fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray: 5 5
