graph TB
    subgraph ClusterNetwork["INTERNAL CLUSTER NETWORK (No External Exposure)"]
        direction TB

        subgraph OrchestratorZone["Orchestrator Zone"]
            Orchestrator["FMS Guardrails Orchestrator<br/>Routes detection requests<br/>to downstream detectors"]
        end

        subgraph DetectorZone["Detector Service (ClusterIP)"]
            Detector["Guardrails Regex Detector<br/>8080/TCP HTTP (plaintext)<br/>Rust / axum<br/>Container: runs as root"]

            subgraph Endpoints["Exposed Endpoints"]
                DetectEndpoint["POST /api/v1/text/contents<br/>No Auth | No TLS"]
                HealthEndpoint["GET /health<br/>No Auth | No TLS"]
            end

            Detector --- DetectEndpoint
            Detector --- HealthEndpoint
        end
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>Plaintext<br/>No Auth<br/>No TLS"| DetectEndpoint
    DetectEndpoint -->|"JSON Response<br/>Detection Results"| Orchestrator

    %% Security annotations
    SecurityNote["Security Notes:<br/>- No TLS (plaintext HTTP only)<br/>- No authentication/authorization<br/>- No NetworkPolicy defined<br/>- Container runs as root<br/>- No egress connections<br/>- No secrets consumed<br/>- Relies on platform for mTLS"]

    %% Styling
    classDef cluster fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef orchestrator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef detector fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef endpoint fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5

    class Orchestrator orchestrator
    class Detector detector
    class DetectEndpoint,HealthEndpoint endpoint
    class SecurityNote warning
