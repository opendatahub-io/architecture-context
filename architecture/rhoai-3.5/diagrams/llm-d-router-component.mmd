graph TB
    subgraph LLMDRouter["llm-d Router"]
        subgraph EPP["Endpoint Picker (EPP)"]
            ExtProc["ext-proc Server<br/>9002/TCP gRPC"]
            HealthSvc["Health Service<br/>9003/TCP gRPC"]
            MetricsSvc["Metrics Server<br/>9090/TCP HTTP"]
            PluginFramework["Plugin Framework<br/>(Schedulers, Filters,<br/>Scorers, Flow Control)"]
            KVIndex["KV-Cache Block Index"]
            ZMQSub["ZMQ Subscriber<br/>5557/TCP"]
            ExtProc --> PluginFramework
            PluginFramework --> KVIndex
            ZMQSub -->|cache state updates| KVIndex
        end

        subgraph Sidecar["PD-Sidecar"]
            SidecarProxy["HTTP Reverse Proxy<br/>8000/TCP HTTPS"]
            KVConnectors["KV Connectors<br/>(NIXLv2, SharedStorage,<br/>SGLang, Mooncake, P2P)"]
            SSRFProtection["SSRF Allowlist<br/>(InferencePool-based)"]
            SidecarProxy --> KVConnectors
            SidecarProxy --> SSRFProtection
        end

        subgraph Coord["Coordinator"]
            CoordServer["HTTP Pipeline Server<br/>8080/TCP HTTP"]
            Pipeline["Pipeline Engine"]
            ReplaceMedia["Replace Media URLs"]
            Render["Render / Tokenize"]
            Encode["Encode (Multimodal)"]
            Prefill["Prefill"]
            Decode["Decode"]
            CoordServer --> Pipeline
            Pipeline --> ReplaceMedia
            Pipeline --> Render
            Pipeline --> Encode
            Pipeline --> Prefill
            Pipeline --> Decode
        end
    end

    %% External entities
    Client["External Client"]
    EnvoyProxy["Envoy Proxy"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% CRDs
    InferencePoolCR["InferencePool CR<br/>(GIE)"]
    InferenceObjectiveCR["InferenceObjective CR<br/>(llm-d.ai)"]
    InferenceModelRewriteCR["InferenceModelRewrite CR<br/>(llm-d.ai)"]

    %% Model Servers
    ModelServers["vLLM Model Servers"]
    PrefillWorkers["Prefill Workers"]
    EncoderWorkers["Encoder Workers"]
    LocalDecoder["Local Decoder<br/>(vLLM 8200/TCP)"]
    DCGMExporter["DCGM Exporter"]

    %% External Services
    OTelCollector["OpenTelemetry<br/>Collector"]
    RenderingSvc["Rendering Service"]
    InferenceGW["Inference Gateway"]

    %% Client flows
    Client -->|HTTPS/443| EnvoyProxy
    EnvoyProxy -->|gRPC ext-proc<br/>9002/TCP TLS| ExtProc
    ExtProc -->|routing decision| EnvoyProxy
    EnvoyProxy -->|routed request| ModelServers

    %% EPP watches
    K8sAPI -.->|watch| InferencePoolCR
    K8sAPI -.->|watch| InferenceObjectiveCR
    K8sAPI -.->|watch| InferenceModelRewriteCR
    ExtProc -->|watches via| K8sAPI

    %% EPP metrics scraping
    ExtProc -->|scrape metrics| ModelServers
    ExtProc -->|scrape GPU metrics| DCGMExporter

    %% Sidecar flows
    EnvoyProxy -->|HTTPS/8000| SidecarProxy
    SidecarProxy -->|prefill request| PrefillWorkers
    SidecarProxy -->|encode request| EncoderWorkers
    SidecarProxy -->|decode request| LocalDecoder

    %% Coordinator flows
    Client -->|HTTP/8080| CoordServer
    Coord -->|encode/prefill/decode| InferenceGW
    Coord -->|tokenize| RenderingSvc

    %% Tracing
    EPP -.->|traces| OTelCollector
    Sidecar -.->|traces| OTelCollector

    %% ZMQ events from model servers
    ModelServers -->|ZMQ 5557| ZMQSub

    %% Styling
    style EPP fill:#4a90e2,stroke:#2c5f8f,color:#fff
    style Sidecar fill:#7ed321,stroke:#5a9e18,color:#fff
    style Coord fill:#f5a623,stroke:#c48518,color:#fff
    style ExtProc fill:#3a7bd5,stroke:#2c5f8f,color:#fff
    style SidecarProxy fill:#6bc11a,stroke:#5a9e18,color:#fff
    style CoordServer fill:#e09520,stroke:#c48518,color:#fff
    style EnvoyProxy fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style ModelServers fill:#e8e8e8,stroke:#999
    style InferencePoolCR fill:#f5a623,stroke:#c48518
    style InferenceObjectiveCR fill:#f5a623,stroke:#c48518
    style InferenceModelRewriteCR fill:#f5a623,stroke:#c48518
