graph TD
    subgraph UserIdentity["User Identity (kubeconfig)"]
        User["kubeconfig identity<br/>(Bearer Token / Client Cert / OIDC)"]
    end

    subgraph PreflightChecks["RBAC Preflight (Runtime)"]
        SSAR["SelfSubjectAccessReview<br/>Checked before each operation<br/>Graceful degradation on denial"]
    end

    subgraph ReadOperations["Read Operations (lint, status, events, components, deps)"]
        direction LR
        ReadCRDs["CRDs (Read)<br/>DSC, DSCI, InferenceService,<br/>Notebook, RayCluster, DSPA,<br/>GuardrailsOrchestrator, etc."]
        ReadOLM["OLM (Read)<br/>Subscription, CSV,<br/>PackageManifest"]
        ReadCore["Core (Read)<br/>ConfigMap, Secret,<br/>Deployment, Namespace,<br/>ServiceAccount"]
        ReadOpenShift["OpenShift (Read)<br/>ImageStream,<br/>ImageStreamTag,<br/>Route"]
    end

    subgraph WriteOperations["Write Operations (migrate only)"]
        direction LR
        PatchOps["PATCH<br/>Notebook, InferenceService,<br/>DSPA, ConfigMap,<br/>GuardrailsOrchestrator"]
        CreateOps["CREATE (temporary)<br/>ServiceAccount<br/>Role<br/>RoleBinding"]
        DeleteOps["DELETE<br/>CRD (RHBOK mgmt only)"]
        ExecOps["EXEC<br/>Pod exec<br/>(LlamaStack backup)"]
    end

    subgraph TempRBAC["Temporary RBAC (Migration)"]
        TempSA["Temp ServiceAccount<br/>(owner-referenced)"]
        TempRole["Temp Role<br/>(namespace-scoped)"]
        TempRB["Temp RoleBinding"]
        TempSA -->|"bound via"| TempRB
        TempRB -->|"grants"| TempRole
    end

    subgraph SecurityControls["Security Controls"]
        direction LR
        CatalogValidation["Catalog Source<br/>Allowlist Validation<br/>(CWE-829)"]
        NSRejection["System Namespace<br/>Rejection<br/>(CWE-269)"]
        EscapeSanitize["Terminal Escape<br/>Sanitization<br/>(CWE-150)"]
        PathTraversal["Directory Traversal<br/>Prevention<br/>(MCP backup)"]
    end

    User -->|"authenticates"| SSAR
    SSAR -->|"authorized"| ReadOperations
    SSAR -->|"authorized"| WriteOperations
    CreateOps -->|"creates with<br/>owner references"| TempRBAC

    style UserIdentity fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style PreflightChecks fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    style ReadOperations fill:#e8f5e9,stroke:#2e7d32
    style WriteOperations fill:#ffcdd2,stroke:#c62828
    style TempRBAC fill:#f3e5f5,stroke:#6a1b9a
    style SecurityControls fill:#e0f2f1,stroke:#00695c
    style User fill:#4a90e2,color:#fff
    style SSAR fill:#f5a623,color:#fff
