graph LR
    AI4RAG["ai4rag<br/><i>RAG Optimization Library</i>"]

    %% External Service Dependencies
    AI4RAG -->|"chat, embeddings,<br/>vector store CRUD"| OGX["OGX Server<br/><i>443/TCP HTTPS</i>"]
    AI4RAG -->|"document discovery<br/>& download"| S3["S3 Storage<br/><i>443/TCP HTTPS</i>"]
    AI4RAG -.->|"model artifacts<br/>(optional)"| HFHub["HuggingFace Hub<br/><i>443/TCP HTTPS</i>"]

    %% Python Library Dependencies (Required)
    AI4RAG -->|"LLM/embedding client"| OGXClient["ogx-client ~1.1.0"]
    AI4RAG -->|"doc conversion"| Docling["docling ~2.107.0"]
    AI4RAG -->|"hybrid chunking"| DoclingCore["docling-core ~2.84.0"]
    AI4RAG -->|"ChromaDB integration"| LCChroma["langchain-chroma ~1.1.0"]
    AI4RAG -->|"text splitting"| LCSplitters["langchain-text-splitters ~1.1.0"]
    AI4RAG -->|"RAG eval metrics"| Unitxt["unitxt ~1.26.1"]
    AI4RAG -->|"GAM surrogate model"| PyGAM["pygam ~0.12.0"]
    AI4RAG -->|"label encoding"| SKLearn["scikit-learn 1.8.*"]
    AI4RAG -->|"data manipulation"| Pandas["pandas 2.2.*"]
    AI4RAG -->|"validation"| Pydantic["pydantic 2.11.*"]
    AI4RAG -->|"S3 client"| Boto3["boto3 >=1.28"]
    AI4RAG -->|"parallel extraction"| Multiprocess["multiprocess >=0.70"]

    %% Internal Platform Dependencies
    AI4RAG ==>|"KFP integration"| KFP["Kubeflow Pipelines"]

