graph TD
    subgraph Deployment["Deployment Context"]
        RhodsOp["rhods-operator<br/>(configures RBAC)"]
    end

    subgraph ServiceAccount["Service Account"]
        SA["Pod ServiceAccount<br/>(name configured by rhods-operator)"]
    end

    subgraph RequiredPermissions["Required API Permissions"]
        direction TB
        TokenReview["authentication.k8s.io/v1<br/>tokenreviews"]
        UserAPI["user.openshift.io/v1<br/>users"]
        OAuthTokenAPI["oauth.openshift.io/v1<br/>oauthaccesstokens"]
    end

    subgraph Verbs["Required Verbs"]
        direction TB
        CreateVerb["create"]
        GetVerb["get"]
        DeleteVerb["delete"]
    end

    subgraph MountedCredentials["Mounted Credentials"]
        direction TB
        SAToken["ServiceAccount Token<br/>/var/run/secrets/kubernetes.io/<br/>serviceaccount/token<br/>(auto-rotated)"]
        SACA["ServiceAccount CA<br/>/var/run/secrets/kubernetes.io/<br/>serviceaccount/ca.crt"]
        Namespace["Namespace File<br/>/var/run/secrets/kubernetes.io/<br/>serviceaccount/namespace"]
    end

    subgraph Secrets["Configured Secrets"]
        direction TB
        OAuthCreds["OAuth Client Credentials<br/>(Opaque)<br/>client_id + client_secret<br/>No auto-rotate"]
        TLSCert["TLS Certificate/Key<br/>(kubernetes.io/tls)<br/>--tls-cert-file, --tls-key-file<br/>Auto-rotate: cert-manager"]
        CookieSecret["Cookie Secret<br/>(Opaque)<br/>AES encryption key<br/>No auto-rotate"]
        RedisPassword["Redis Password<br/>(Opaque, optional)<br/>--redis-password<br/>No auto-rotate"]
    end

    %% Operator configures RBAC
    RhodsOp -->|"creates ClusterRole/<br/>ClusterRoleBinding"| SA

    %% SA has permissions
    SA -->|"create"| TokenReview
    SA -->|"get"| UserAPI
    SA -->|"delete"| OAuthTokenAPI

    %% Mounted into pod
    SA -->|"projected volume"| SAToken
    SA -->|"projected volume"| SACA
    SA -->|"projected volume"| Namespace

    %% OpenShift OAuth auto-detection
    SAToken -.->|"Auto-detected as OAuth<br/>client credentials by<br/>OpenShift provider"| OAuthCreds

    %% Permission purposes
    TokenReview -->|"POST tokenreviews<br/>K8s SA token validation"| CreateVerb
    UserAPI -->|"GET /users/~<br/>User identity lookup"| GetVerb
    OAuthTokenAPI -->|"DELETE oauthaccesstokens<br/>Sign-out cleanup (async)"| DeleteVerb

    %% Styling
    style RhodsOp fill:#ab47bc,stroke:#7b1fa2,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style TokenReview fill:#f5a623,stroke:#333
    style UserAPI fill:#f5a623,stroke:#333
    style OAuthTokenAPI fill:#f5a623,stroke:#333
    style CreateVerb fill:#7ed321,stroke:#333
    style GetVerb fill:#7ed321,stroke:#333
    style DeleteVerb fill:#ef5350,stroke:#333,color:#fff
    style SAToken fill:#e3f2fd,stroke:#1565c0
    style SACA fill:#e3f2fd,stroke:#1565c0
    style Namespace fill:#e3f2fd,stroke:#1565c0
    style OAuthCreds fill:#fff3e0,stroke:#f57c00
    style TLSCert fill:#fff3e0,stroke:#f57c00
    style CookieSecret fill:#fff3e0,stroke:#f57c00
    style RedisPassword fill:#fff3e0,stroke:#f57c00

    Note1["Note: No RBAC manifests in this repository.<br/>All RBAC is configured by rhods-operator.<br/>Permissions listed are inferred from code analysis."]
    style Note1 fill:#fff9c4,stroke:#f9a825
