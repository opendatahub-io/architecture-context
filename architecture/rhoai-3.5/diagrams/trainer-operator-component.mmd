graph TB
    subgraph TrainerOperator["Trainer Operator (odh-trainer-operator)"]
        Reconciler[Trainer Controller<br/>Reconciler]
        DepCheck[Dependency Checker<br/>JobSet validation]
        ManifestRenderer[Manifest Renderer<br/>Kustomize + params.env]
        CacheManager[Cache Manager<br/>Label-scoped informers]
    end

    subgraph DeployedController["Deployed: Kubeflow Trainer Controller"]
        KFController[kubeflow-trainer-<br/>controller-manager]
        Webhook[Validating Webhook<br/>9443/TCP TLS]
    end

    subgraph CRDs["Custom Resource Definitions"]
        TrainerCR["Trainer CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]
        TrainJobCR["TrainJob CR<br/>(Namespaced)<br/>trainer.kubeflow.org/v1alpha1"]
        ClusterRuntimeCR["ClusterTrainingRuntime CR<br/>(Cluster-scoped)<br/>trainer.kubeflow.org/v1alpha1"]
        TrainingRuntimeCR["TrainingRuntime CR<br/>(Namespaced)<br/>trainer.kubeflow.org/v1alpha1"]
    end

    subgraph Runtimes["Pre-configured ClusterTrainingRuntimes"]
        TorchCUDA[torch-distributed-cuda]
        TorchROCm[torch-distributed-rocm]
        TorchCPU[torch-distributed-cpu]
        DeepSpeed[deepspeed-distributed]
        MLX[mlx-distributed]
        TorchTune[torchtune variants]
        TrainingHub[training-hub variants]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        ImageStreams["ImageStreams<br/>training-hub-universal<br/>(CPU, CUDA, ROCm)"]
    end

    %% Platform operator triggers
    PlatformOp[rhods-operator /<br/>opendatahub-operator] -->|creates| TrainerCR
    TrainerCR -->|watched by| Reconciler

    %% Operator flow
    Reconciler --> DepCheck
    DepCheck -->|validates JobSet| JobSetOp[JobSet Operator]
    Reconciler --> ManifestRenderer
    ManifestRenderer -->|deploys| KFController
    ManifestRenderer -->|deploys| Webhook
    ManifestRenderer -->|provisions| ClusterRuntimeCR
    ManifestRenderer -->|provisions| ImageStreams
    CacheManager -->|scopes informers| Reconciler

    %% Deployed controller flow
    User[Data Scientist / User] -->|creates| TrainJobCR
    TrainJobCR -->|validated by| Webhook
    TrainJobCR -->|reconciled by| KFController
    KFController -->|creates| JobSet["JobSet CR<br/>jobset.x-k8s.io"]

    %% Runtimes
    ClusterRuntimeCR --- TorchCUDA
    ClusterRuntimeCR --- TorchROCm
    ClusterRuntimeCR --- TorchCPU
    ClusterRuntimeCR --- DeepSpeed
    ClusterRuntimeCR --- MLX
    ClusterRuntimeCR --- TorchTune
    ClusterRuntimeCR --- TrainingHub

    %% Styling
    style Reconciler fill:#4a90e2,color:#fff
    style DepCheck fill:#4a90e2,color:#fff
    style ManifestRenderer fill:#4a90e2,color:#fff
    style CacheManager fill:#4a90e2,color:#fff
    style KFController fill:#50c878,color:#fff
    style Webhook fill:#50c878,color:#fff
    style TrainerCR fill:#f5a623,color:#fff
    style TrainJobCR fill:#f5a623,color:#fff
    style ClusterRuntimeCR fill:#f5a623,color:#fff
    style TrainingRuntimeCR fill:#f5a623,color:#fff
    style PlatformOp fill:#e8e8e8,stroke:#333
    style User fill:#e8e8e8,stroke:#333
    style JobSetOp fill:#e8e8e8,stroke:#333
    style JobSet fill:#f5a623,color:#fff
    style ImageStreams fill:#d4a5f5,color:#333
