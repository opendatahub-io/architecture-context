graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["ML Client / Application"]
    end

    subgraph IngressAuth["INGRESS / AUTH SIDECAR (Trust Boundary)"]
        KRBP["kube-rbac-proxy Sidecar<br/>8443/TCP TLS termination<br/>RHOAI Platform RBAC<br/>Bearer Token validation"]
    end

    subgraph Pod["APPLICATION (InferenceService Pod)"]
        direction TB

        subgraph AppContainer["Container: autogluon-server<br/>UID: 1001 (non-root)<br/>Base: AIPCC CPU RHEL 9.6 UBI"]
            REST["REST Server (FastAPI/uvicorn)<br/>8080/TCP HTTP<br/>POST /v1/models/{name}:predict<br/>POST /v2/models/{name}/infer<br/>GET /v2/health/ready<br/>GET /v2/health/live"]
            GRPC["gRPC Server<br/>8081/TCP gRPC<br/>GRPCInferenceService"]
        end

        subgraph StorageLib["Library: kserve-storage 0.19.0"]
            StorageDL["Model Download<br/>(S3, GCS, Azure, HF)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS TLS 1.2+<br/>GCP Service Account"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS TLS 1.2+<br/>Azure credentials"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS TLS 1.2+<br/>HF Token (optional)"]
    end

    subgraph PlatformControl["PLATFORM CONTROL PLANE"]
        KServeCtrl["KServe Controller<br/>Creates pods + injects<br/>kube-rbac-proxy sidecar"]
        K8sAPI["Kubernetes API<br/>Health probes<br/>8080/TCP HTTP"]
        Prometheus["Prometheus<br/>Metrics scrape<br/>8080/TCP HTTP"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| KRBP

    %% Ingress to Application
    KRBP -->|"HTTP/8080<br/>No encryption (localhost)<br/>Post-auth proxy"| REST

    %% Application to External Services (Egress)
    StorageDL -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM/SA"| S3
    StorageDL -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP SA"| GCS
    StorageDL -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure Creds"| Azure
    StorageDL -->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token"| HF

    %% Platform Control
    KServeCtrl -.->|"Pod lifecycle<br/>Sidecar injection"| Pod
    K8sAPI -.->|"HTTP/8080<br/>Health probes<br/>(unauthenticated)"| REST
    Prometheus -.->|"HTTP/8080<br/>Metrics scrape"| REST

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class KRBP ingress
    class REST,GRPC,StorageDL app
    class S3,GCS,Azure,HF externalservice
    class KServeCtrl,K8sAPI,Prometheus platform
