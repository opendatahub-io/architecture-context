graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Optional, opt-in)"]
        IngCtrl["{instance}-ingress<br/>80/TCP → 8321/TCP<br/>TLS depends on controller"]
    end

    subgraph Cluster["CLUSTER NETWORK (NetworkPolicy enforced)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            OGXSvc["{instance}-service<br/>ClusterIP<br/>8321/TCP (API) + 9464/TCP (metrics)"]
            OGXPod["OGX Server Pod<br/>SA: {instance}-sa<br/>SCC: anyuid<br/>Image: OGX distribution"]
            PVC["PVC: {instance}<br/>Persistent storage"]
            NetPol["NetworkPolicy<br/>Ingress: same-ns + operator-ns<br/>Egress: unrestricted"]
        end

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["OGX Operator<br/>SA: ogx-k8s-operator-controller-manager<br/>8080/TCP metrics, 8081/TCP health"]
            Module["OGX Module<br/>8080/TCP metrics, 8081/TCP health"]
            WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP<br/>HTTPS (cert-manager TLS)<br/>Auth: AdmissionReview"]
        end
    end

    subgraph K8s["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>ServiceMonitor (60s)<br/>PrometheusRule"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OCI["OCI Container Registry<br/>443/TCP HTTPS<br/>TLS 1.2+, Anonymous"]
        InferenceProv["Inference Providers<br/>(vLLM, OpenAI, Azure,<br/>Bedrock, VertexAI, Watsonx)<br/>443/TCP HTTPS<br/>API Key / Bearer"]
        VectorDB["Vector Databases<br/>(PGVector, Milvus, Qdrant)<br/>configurable/TCP<br/>TLS configurable"]
        SearchAPI["Search APIs<br/>(Brave, Tavily)<br/>443/TCP HTTPS<br/>API Key"]
        S3["AWS S3 / S3-compatible<br/>443/TCP HTTPS<br/>TLS 1.2+, IAM"]
        Postgres["PostgreSQL<br/>5432/TCP<br/>None/TLS"]
        Redis["Redis<br/>6379/TCP<br/>None/TLS"]
        CertMgr["cert-manager<br/>TLS cert issuance<br/>Auto-rotate"]
    end

    %% External flows
    Client -->|"HTTP/80<br/>TLS varies"| IngCtrl
    IngCtrl -->|"HTTP/8321<br/>None/TLS"| OGXSvc

    %% Internal flows
    OGXSvc --> OGXPod
    OGXPod --> PVC

    Operator -->|"HTTP/configurable<br/>Health: /v1/providers"| OGXPod
    Operator -->|"HTTPS/6443<br/>TLS 1.2+, SA Token"| APIServer
    Module -->|"HTTPS/6443<br/>TLS 1.2+, SA Token"| APIServer

    APIServer -->|"HTTPS/443→9443<br/>TLS (cert-manager)"| WebhookSvc

    %% Monitoring
    Prometheus -->|"HTTP/9464<br/>ServiceMonitor"| OGXSvc
    Prometheus -->|"HTTP/8080<br/>TLS (OpenShift profile)"| Operator

    %% External service flows (from operator)
    Operator -->|"HTTPS/443<br/>Anonymous"| OCI

    %% External service flows (from OGX server pods)
    OGXPod -->|"HTTPS/443<br/>API Key"| InferenceProv
    OGXPod -->|"TCP/configurable<br/>Credentials"| VectorDB
    OGXPod -->|"HTTPS/443<br/>API Key"| SearchAPI
    OGXPod -->|"HTTPS/443<br/>IAM"| S3
    OGXPod -->|"TCP/5432<br/>Credentials"| Postgres
    OGXPod -->|"TCP/6379<br/>Credentials"| Redis

    CertMgr -.->|"TLS cert"| WebhookSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class IngCtrl ingress
    class OGXSvc,OGXPod,PVC,NetPol,Operator,Module,WebhookSvc cluster
    class APIServer controlplane
    class OCI,InferenceProv,VectorDB,SearchAPI,S3,Postgres,Redis,CertMgr externalservice
    class Prometheus monitoring
