graph TB
    subgraph SparkOperatorSystem["Spark Operator System"]
        subgraph ModuleController["spark-operator-module controller"]
            ModCtrl["Module Reconciler<br/>Go controller-runtime"]
        end

        subgraph MainOperator["spark-operator (primary)"]
            Controller["Controller<br/>8080/TCP metrics<br/>8081/TCP health"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS<br/>TLS 1.2+"]
        end
    end

    %% CRDs
    SparkOperatorCR["SparkOperator CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster-scoped"]
    SparkAppCR["SparkApplication CR<br/>sparkoperator.k8s.io/v1beta2<br/>Namespaced"]
    ScheduledSparkAppCR["ScheduledSparkApplication CR<br/>sparkoperator.k8s.io/v1beta2<br/>Namespaced"]
    SparkConnectCR["SparkConnect CR<br/>sparkoperator.k8s.io/v1alpha1<br/>Namespaced"]

    %% Managed Resources
    DriverPod["Driver Pod"]
    ExecutorPods["Executor Pods"]
    WebUIService["Web UI Service<br/>4040/TCP"]
    SparkConnectSvc["SparkConnect Service<br/>15002/TCP gRPC<br/>7078/TCP RPC<br/>7079/TCP Block Mgr"]
    WebhookSvc["Webhook Service<br/>443→9443/TCP"]
    NetworkPolicy["NetworkPolicy"]
    PDB["PodDisruptionBudget"]
    Ingress["Ingress<br/>(optional)"]

    %% External Systems
    User["User / Data Scientist"]
    PlatformOperator["rhods-operator /<br/>opendatahub-operator"]
    K8sAPI["Kubernetes API Server"]

    %% Flows
    PlatformOperator -->|creates| SparkOperatorCR
    SparkOperatorCR -->|watched by| ModCtrl
    ModCtrl -->|deploys & manages| Controller
    ModCtrl -->|deploys & manages| Webhook

    User -->|creates| SparkAppCR
    User -->|creates| ScheduledSparkAppCR
    User -->|creates| SparkConnectCR

    SparkAppCR -->|mutated/validated by| Webhook
    ScheduledSparkAppCR -->|mutated/validated by| Webhook
    SparkConnectCR -->|mutated/validated by| Webhook

    SparkAppCR -->|reconciled by| Controller
    ScheduledSparkAppCR -->|reconciled by| Controller
    SparkConnectCR -->|reconciled by| Controller

    Controller -->|creates| DriverPod
    Controller -->|creates| WebUIService
    Controller -->|creates| SparkConnectSvc
    Controller -->|creates| NetworkPolicy
    Controller -->|creates| PDB
    Controller -->|creates| Ingress
    DriverPod -->|creates| ExecutorPods

    Controller -->|CRUD ops| K8sAPI
    Webhook -->|admission| K8sAPI
    WebhookSvc -->|routes to| Webhook

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style ModCtrl fill:#4a90e2,stroke:#333,color:#fff
    style SparkAppCR fill:#f5a623,stroke:#333
    style ScheduledSparkAppCR fill:#f5a623,stroke:#333
    style SparkConnectCR fill:#f5a623,stroke:#333
    style SparkOperatorCR fill:#f5a623,stroke:#333
    style DriverPod fill:#7ed321,stroke:#333
    style ExecutorPods fill:#7ed321,stroke:#333
    style PlatformOperator fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#333
