graph TB
    subgraph ArgoWorkflows["Argo Workflows"]
        direction TB

        subgraph Controller["workflow-controller"]
            WC[Workflow Controller<br/>Go Service<br/>9090/TCP metrics, 6060/TCP healthz]
            LeaderElection[Leader Election<br/>via Kubernetes Leases]
            WorkflowWorkers[Workflow Workers<br/>32 concurrent]
            CronWorkers[CronWorkflow Workers<br/>8 concurrent]
            ArchiveWorkers[Archive Workers<br/>8 concurrent]
            TTLWorkers[TTL/GC Workers<br/>4 concurrent]
            PodCleanup[Pod Cleanup Workers<br/>4 concurrent]

            WC --> LeaderElection
            WC --> WorkflowWorkers
            WC --> CronWorkers
            WC --> ArchiveWorkers
            WC --> TTLWorkers
            WC --> PodCleanup
        end

        subgraph Executor["argoexec (per workflow pod)"]
            AE[Argoexec<br/>Emissary Executor<br/>Go Sidecar]
            ArtifactIO[Artifact I/O<br/>Upload/Download]
            ResultReporter[Result Reporter<br/>via WorkflowTaskResult CR]

            AE --> ArtifactIO
            AE --> ResultReporter
        end
    end

    %% CRDs
    WorkflowCR[Workflow CR]
    WorkflowTemplateCR[WorkflowTemplate CR]
    ClusterWFTemplate[ClusterWorkflowTemplate CR]
    CronWorkflowCR[CronWorkflow CR]
    WFEventBinding[WorkflowEventBinding CR]
    WFTaskSet[WorkflowTaskSet CR]
    WFTaskResult[WorkflowTaskResult CR]
    ArtifactGCTask[WorkflowArtifactGCTask CR]

    %% User interaction
    User[User / DSP API] -->|creates| WorkflowCR
    User -->|creates| WorkflowTemplateCR
    User -->|creates| CronWorkflowCR

    %% Controller watches
    WorkflowCR -->|watched by| WC
    WorkflowTemplateCR -->|referenced by| WC
    ClusterWFTemplate -->|referenced by| WC
    CronWorkflowCR -->|watched by| CronWorkers
    WFEventBinding -->|watched by| WC
    WFTaskResult -->|watched by| WC

    %% Controller creates
    WC -->|creates| WFTaskSet
    WC -->|creates| ArtifactGCTask
    WC -->|creates pods with| AE

    %% Executor reports back
    AE -->|creates/patches| WFTaskResult

    %% External dependencies
    K8sAPI[Kubernetes API Server]
    WC -->|watches/creates| K8sAPI
    AE -->|patches results| K8sAPI

    ArtifactStore[S3 / GCS / Azure Blob<br/>Artifact Storage]
    ArtifactIO -->|upload/download| ArtifactStore

    DB[(PostgreSQL / MySQL<br/>Workflow Archival)]
    ArchiveWorkers -->|archive workflows| DB

    %% Styling
    style WC fill:#4a90e2,stroke:#333,color:#fff
    style AE fill:#4a90e2,stroke:#333,color:#fff
    style WorkflowCR fill:#f5a623,stroke:#333
    style WorkflowTemplateCR fill:#f5a623,stroke:#333
    style ClusterWFTemplate fill:#f5a623,stroke:#333
    style CronWorkflowCR fill:#f5a623,stroke:#333
    style WFEventBinding fill:#f5a623,stroke:#333
    style WFTaskSet fill:#f5a623,stroke:#333
    style WFTaskResult fill:#f5a623,stroke:#333
    style ArtifactGCTask fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ArtifactStore fill:#e8e8e8,stroke:#333
    style DB fill:#e8e8e8,stroke:#333
    style User fill:#7ed321,stroke:#333
