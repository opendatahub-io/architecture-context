graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["planner-backend<br/>Namespace: planner"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)<br/>Scope: cluster-wide"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        Nodes["core (v1)<br/>nodes"]
    end

    subgraph Verbs["Allowed Verbs"]
        List["list"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes

    %% Application-Level Auth
    subgraph AppAuth["Application-Level Authentication"]
        AdminEndpoints["DB Admin Endpoints<br/>/api/v1/db/upload-benchmarks<br/>/api/v1/db/reset<br/>/api/v1/db/verify-admin"]
        AdminMechanism["X-Admin-Password Header<br/>HMAC comparison<br/>OPTIONAL (bypassed if unset)"]
        PublicEndpoints["All Other API Endpoints<br/>/api/v1/calculate<br/>/api/v1/extract<br/>/api/v1/recommend<br/>/api/v1/deploy<br/>/api/v1/deploy-to-cluster<br/>... (20+ endpoints)"]
        NoAuth["NO AUTHENTICATION<br/>Any network access = full API"]
    end

    AdminEndpoints -->|"protected by"| AdminMechanism
    PublicEndpoints -->|"protected by"| NoAuth

    %% Network Policies
    subgraph NetworkPolicies["Network Policies"]
        NP["networkpolicy-model-catalog<br/>Cross-namespace ingress<br/>planner → rhoai-model-registries"]
    end

    subgraph Secrets["Secrets"]
        PlannerSecrets["planner-secrets (Opaque)<br/>- PostgreSQL password<br/>- HF_TOKEN<br/>- Model Catalog token<br/>- Vertex AI credentials<br/>- OpenAI API key<br/>- DB admin password<br/>Rotation: Manual (No auto-rotate)"]
        ServiceCA["planner-service-ca (ConfigMap)<br/>- OpenShift service-ca bundle<br/>Rotation: Auto (service-ca operator)"]
    end

    %% Styles
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style Nodes fill:#7ed321,stroke:#333
    style AdminEndpoints fill:#e74c3c,stroke:#333,color:#fff
    style AdminMechanism fill:#ffe6cc,stroke:#d79b00
    style PublicEndpoints fill:#e74c3c,stroke:#333,color:#fff
    style NoAuth fill:#ff6b6b,stroke:#333,color:#fff
    style NP fill:#dae8fc,stroke:#6c8ebf
    style PlannerSecrets fill:#e1d5e7,stroke:#9673a6
    style ServiceCA fill:#d5e8d4,stroke:#82b366
