graph LR
    KServe["KServe<br/>(Multi-Controller Platform)"]

    %% External Dependencies (Required)
    KServe -->|"CRD CRUD,<br/>resource mgmt"| K8sAPI["Kubernetes API<br/>Server"]
    KServe -->|"webhook TLS<br/>(XKS required)"| CertManager["cert-manager"]

    %% External Dependencies (Optional)
    KServe -.->|"serverless<br/>deployment mode"| Knative["Knative Serving"]
    KServe -.->|"VirtualService routing,<br/>mTLS, EnvoyFilter"| Istio["Istio /<br/>Service Mesh"]
    KServe -->|"HTTPRoute ingress<br/>for model endpoints"| GatewayAPI["Gateway API v1"]
    KServe -.->|"custom metric<br/>autoscaling"| KEDA["KEDA"]
    KServe -.->|"multi-node<br/>distributed inference"| LWS["LeaderWorkerSet"]
    KServe -.->|"metrics collection<br/>OTel collectors"| OTel["OpenTelemetry<br/>Operator"]
    KServe -.->|"PodMonitor,<br/>ServiceMonitor"| PromOp["Prometheus<br/>Operator"]
    KServe -.->|"GPU/accelerator<br/>provisioning"| DRA["DRA (Dynamic<br/>Resource Allocation)"]

    %% Internal RHOAI Dependencies
    RHOAIOp["rhods-operator /<br/>opendatahub-operator"] -->|"deploys via<br/>Kserve CR"| KServe
    KServe -->|"model serving API,<br/>webhook mgmt"| ODHModel["odh-model-controller"]
    KServe -->|"external ingress<br/>for model services"| PlatformGW["Platform Gateway<br/>(Gateway API)"]
    KServe -->|"variant-aware<br/>autoscaling"| WVA["Workload Variant<br/>Autoscaler (WVA)"]
    KServe -->|"model-based routing<br/>via InferencePool"| GIE["GIE InferencePool"]

    %% Serving Runtimes
    KServe -->|"LLM serving<br/>containers"| vLLM["vLLM Runtimes<br/>(CUDA/ROCm/Gaudi/<br/>Spyre/CPU)"]

    %% External Services
    KServe -->|"model download<br/>HTTPS/443"| S3["S3 / GCS /<br/>Azure Blob"]
    KServe -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    KServe -->|"model download<br/>OCI pull"| OCI["OCI Registry"]

    %% Components consuming KServe
    Dashboard["ODH Dashboard"] -.->|"UI management<br/>of InferenceServices"| KServe
    Pipelines["Data Science<br/>Pipelines"] -.->|"auto-deploy<br/>models"| KServe

    %% Styling
    style KServe fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style K8sAPI fill:#666,stroke:#333,color:#fff
    style CertManager fill:#666,stroke:#333,color:#fff
    style GatewayAPI fill:#666,stroke:#333,color:#fff

    %% Optional external
    style Knative fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style KEDA fill:#999,stroke:#333,color:#fff
    style LWS fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style PromOp fill:#999,stroke:#333,color:#fff
    style DRA fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI
    style RHOAIOp fill:#7ed321,stroke:#333,color:#fff
    style ODHModel fill:#7ed321,stroke:#333,color:#fff
    style PlatformGW fill:#7ed321,stroke:#333,color:#fff
    style WVA fill:#7ed321,stroke:#333,color:#fff
    style GIE fill:#7ed321,stroke:#333,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style HFHub fill:#f5a623,stroke:#333,color:#fff
    style OCI fill:#f5a623,stroke:#333,color:#fff

    %% Consumers
    style Dashboard fill:#50c878,stroke:#333,color:#fff
    style Pipelines fill:#50c878,stroke:#333,color:#fff
