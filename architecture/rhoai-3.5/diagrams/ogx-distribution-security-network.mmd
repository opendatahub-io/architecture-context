graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["Gateway API HTTPRoute<br/>443/TCP<br/>TLS 1.2+ (SIMPLE)<br/>Managed by rhods-operator"]
        KRBACProxy["kube-rbac-proxy<br/>(sidecar)<br/>Auth enforcement"]
        Gateway -->|TLS terminated| KRBACProxy
    end

    subgraph Application["APPLICATION (OGX Distribution)"]
        OGX["OGX Server<br/>8321/TCP HTTP (plaintext)<br/>--insecure flag always set<br/>OAuth2 JWT validation (conditional)<br/>Python 3.12 on AIPCC CPU base"]
    end

    subgraph PersistentStorage["PERSISTENT STORAGE"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL protocol<br/>Plaintext (configurable)<br/>Password auth"]
    end

    subgraph InferenceProviders["INFERENCE PROVIDERS"]
        vLLM_Inf["vLLM Inference<br/>Variable port<br/>HTTP/HTTPS<br/>TLS (configurable)<br/>Bearer token"]
        vLLM_Emb["vLLM Embedding<br/>Variable port<br/>HTTP/HTTPS<br/>TLS (configurable)<br/>Bearer token"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        WatsonX["IBM WatsonX<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
        VertexAI["Google Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP credentials"]
        OpenAI["OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
        Gemini["Google Gemini<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
        Anthropic["Anthropic<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
    end

    subgraph VectorProviders["VECTOR STORAGE"]
        Milvus["Milvus<br/>Variable port<br/>HTTP/HTTPS<br/>TLS + mTLS (configurable)<br/>Token"]
        pgvector["pgvector<br/>5432/TCP<br/>PostgreSQL<br/>Plaintext (configurable)<br/>Password"]
        Qdrant["Qdrant<br/>6333/TCP HTTP, 6334/TCP gRPC<br/>TLS (configurable)<br/>API key"]
    end

    subgraph ToolServices["TOOL RUNTIME & FILE STORAGE"]
        BraveSearch["Brave Search<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
        TavilySearch["Tavily Search<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key"]
        S3["AWS S3<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        DoclingServe["Docling Serve<br/>Variable port<br/>HTTP/HTTPS<br/>API key"]
        MCP["MCP Server<br/>Variable port<br/>HTTP/SSE<br/>Configurable"]
    end

    subgraph Observability["OBSERVABILITY & AUTH"]
        OTel["OpenTelemetry Collector<br/>Variable port<br/>OTLP HTTP/gRPC<br/>Configurable"]
        JWKS["OAuth2 JWKS Endpoint<br/>443/TCP HTTPS<br/>TLS (configurable)<br/>JWT key discovery"]
    end

    %% Ingress flow
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (conditional)"| Gateway
    KRBACProxy -->|"HTTP/8321<br/>Plaintext (in-pod)"| OGX

    %% Persistent storage
    OGX -->|"PostgreSQL/5432<br/>Plaintext<br/>Password"| PostgreSQL

    %% Inference egress
    OGX -->|"HTTP(S)/var<br/>TLS (configurable)<br/>Bearer token"| vLLM_Inf
    OGX -->|"HTTP(S)/var<br/>TLS (configurable)<br/>Bearer token"| vLLM_Emb
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| Bedrock
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| WatsonX
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| AzureOAI
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP creds"| VertexAI
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| OpenAI
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Gemini
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Anthropic

    %% Vector storage egress
    OGX -->|"HTTP(S)/var<br/>TLS+mTLS<br/>Token"| Milvus
    OGX -->|"PostgreSQL/5432<br/>Plaintext<br/>Password"| pgvector
    OGX -->|"HTTP+gRPC/6333-6334<br/>TLS (configurable)<br/>API key"| Qdrant

    %% Tool & file egress
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| BraveSearch
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| TavilySearch
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    OGX -->|"HTTP(S)/var<br/>API key"| DoclingServe
    OGX -->|"HTTP(S)/var<br/>Configurable"| MCP

    %% Observability & Auth egress
    OGX -->|"OTLP/var<br/>Configurable"| OTel
    OGX -->|"HTTPS/443<br/>TLS (configurable)"| JWKS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef vector fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef tools fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef observability fill:#e6e6e6,stroke:#666,stroke-width:2px

    class Client external
    class Gateway,KRBACProxy ingress
    class OGX application
    class PostgreSQL storage
    class vLLM_Inf,vLLM_Emb,Bedrock,WatsonX,AzureOAI,VertexAI,OpenAI,Gemini,Anthropic inference
    class Milvus,pgvector,Qdrant vector
    class BraveSearch,TavilySearch,S3,DoclingServe,MCP tools
    class OTel,JWKS observability
