graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        S3["S3 Storage (AWS)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
    end

    subgraph BuildDeps["BUILD-TIME EXTERNAL"]
        NVIDIARepo["NVIDIA CUDA Repos<br/>443/TCP HTTPS"]
        AMDRepo["AMD ROCm Repos<br/>443/TCP HTTPS"]
        MellanoxRepo["Mellanox OFED Repos<br/>443/TCP HTTPS"]
        PyPIRepo["PyPI / AIPCC PyPI<br/>443/TCP HTTPS"]
        AIPCCBase["AIPCC Base Images<br/>443/TCP HTTPS<br/>Registry auth"]
    end

    subgraph Cluster["OPENSHIFT CLUSTER"]
        direction TB

        subgraph TestInfra["TEST INFRASTRUCTURE"]
            TestRunner["Test Runner Pod<br/>SA: test-specific<br/>Image: dw-tests:latest"]
        end

        subgraph K8sControl["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (SA)"]
        end

        subgraph Operators["OPERATOR NAMESPACE<br/>(redhat-ods-applications)"]
            KFTO["Kubeflow Training Operator<br/>Watches: PyTorchJob"]
            TrainerV2["Kubeflow Trainer v2<br/>Watches: TrainJob"]
            KubeRayOp["KubeRay Operator<br/>Watches: RayJob, RayCluster"]
            KueueCtrl["Kueue Controller<br/>Watches: Workload, ClusterQueue"]
            RhodsOp["rhods-operator<br/>RELATED_IMAGE_* env vars"]
        end

        subgraph UserNS["USER NAMESPACE (per-test)"]
            direction TB
            Worker1["Worker Pod 1<br/>Training Image<br/>No service port"]
            WorkerN["Worker Pod N<br/>Training Image<br/>No service port"]
            RayHead["Ray Head Pod<br/>6379/TCP GCS<br/>8265/TCP Dashboard<br/>10001/TCP Client"]
            RayWorker["Ray Worker Pod"]
        end

        subgraph Monitoring["MONITORING"]
            Prometheus["OpenShift Prometheus<br/>9091/TCP HTTPS<br/>TLS 1.2+<br/>kube-rbac-proxy"]
        end
    end

    %% Test Runner to K8s API
    TestRunner -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Bearer Token"| K8sAPI

    %% K8s API to Operators (watch/reconcile)
    K8sAPI -.->|"Watch events"| KFTO
    K8sAPI -.->|"Watch events"| TrainerV2
    K8sAPI -.->|"Watch events"| KubeRayOp
    K8sAPI -.->|"Watch events"| KueueCtrl

    %% Operators create pods
    KFTO -->|"Create pods"| Worker1
    KFTO -->|"Create pods"| WorkerN
    TrainerV2 -->|"Create pods"| Worker1
    KubeRayOp -->|"Create pods"| RayHead
    KubeRayOp -->|"Create pods"| RayWorker

    %% Worker egress
    Worker1 -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HFHub
    Worker1 -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3

    %% Inter-worker communication
    Worker1 <-->|"NCCL/RCCL AllReduce<br/>Dynamic/TCP+RDMA<br/>NO ENCRYPTION"| WorkerN
    Worker1 <-->|"SSH/2222<br/>SSH encryption<br/>SSH keys (MPI)"| WorkerN

    %% Ray communication
    RayHead -->|"gRPC/10001<br/>NO ENCRYPTION"| RayWorker
    TestRunner -->|"HTTP/8265<br/>NO ENCRYPTION<br/>NO AUTH"| RayHead

    %% Monitoring
    TestRunner -->|"HTTPS/9091<br/>TLS 1.2+<br/>Bearer Token"| Prometheus

    %% Build-time dependencies (dashed)
    Worker1 -.->|"Build-time only"| NVIDIARepo
    Worker1 -.->|"Build-time only"| AMDRepo
    Worker1 -.->|"Build-time only"| PyPIRepo
    Worker1 -.->|"Build-time only"| AIPCCBase

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef buildext fill:#fff9c4,stroke:#f9a825,stroke-width:1px,stroke-dasharray: 5 5
    classDef control fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef operator fill:#fff3e0,stroke:#e65100,stroke-width:1px
    classDef userns fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef monitoring fill:#f3e5f5,stroke:#7b1fa2,stroke-width:1px
    classDef testinfra fill:#fce4ec,stroke:#c62828,stroke-width:1px
    classDef danger fill:#ffcdd2,stroke:#b71c1c,stroke-width:2px

    class HFHub,S3 external
    class NVIDIARepo,AMDRepo,MellanoxRepo,PyPIRepo,AIPCCBase buildext
    class K8sAPI control
    class KFTO,TrainerV2,KubeRayOp,KueueCtrl,RhodsOp operator
    class Worker1,WorkerN userns
    class RayHead,RayWorker userns
    class Prometheus monitoring
    class TestRunner testinfra
