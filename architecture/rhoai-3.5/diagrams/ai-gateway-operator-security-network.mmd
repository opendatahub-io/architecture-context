graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (ai-gateway-system)"]
        direction TB
        AGO["ai-gateway-operator<br/>SA: ai-gateway-operator<br/>Probes: 8081/TCP HTTP"]
        MetricsSvc["ai-gateway-metrics-service<br/>ClusterIP 8443/TCP HTTPS<br/>Auth: Bearer Token (SA)"]
        AGO --- MetricsSvc
    end

    subgraph AppNS["APPLICATION NAMESPACE"]
        direction TB

        subgraph BatchGWSub["Batch Gateway"]
            BGO["batch-gateway-operator<br/>100m-500m CPU, 128-256Mi"]
            BGWorkloads["API Server | Processor<br/>GC | Async Processor"]
            BGO -->|manages| BGWorkloads
        end

        subgraph MaaSSub["MaaS Controller"]
            MaaSCtrl["maas-controller<br/>SA: maas-controller<br/>10m-500m CPU, 64-512Mi"]
            WebhookSvc["maas-controller-webhook-service<br/>ClusterIP 443/TCP → 9443<br/>TLS (serving-cert)<br/>Auth: Webhook Admission"]
            MaaSCtrl --- WebhookSvc
        end
    end

    subgraph InfraNS["INFRASTRUCTURE NAMESPACE<br/>(redhat-ai-gateway-infra)"]
        InfraRBAC["Role: maas-controller-secret-migrate<br/>Secrets: create, get(maas-db-config)"]
        DBSecret["maas-db-config<br/>Opaque - DB connection"]
        InfraRBAC -.->|scoped access| DBSecret
    end

    subgraph IngressNS["INGRESS (openshift-ingress)"]
        Gateway["maas-default-gateway<br/>Gateway CR<br/>Kuadrant AuthPolicy per route<br/>Default-deny TRLP"]
    end

    subgraph PlatformIntegrations["PLATFORM INTEGRATIONS"]
        KServe["KServe<br/>LLMInferenceService"]
        Kuadrant["Kuadrant<br/>AuthPolicy, TRLP, RLP"]
        Authorino["Authorino<br/>Auth config"]
        Istio["Istio/Service Mesh<br/>DestinationRules<br/>EnvoyFilters<br/>ServiceEntries"]
        OTel["OpenTelemetry<br/>Collectors"]
        Perses["Perses<br/>Dashboards"]
        CertMgr["cert-manager<br/>Certificates"]
    end

    %% Control plane flows
    K8sAPI -->|"Watch AIGateway CR<br/>443/TCP HTTPS<br/>SA token"| AGO
    AGO -->|"SSA Deploy<br/>443/TCP HTTPS<br/>SA token"| K8sAPI
    K8sAPI -->|"Webhook call<br/>443/TCP HTTPS<br/>TLS (serving-cert)"| WebhookSvc

    %% Operator deploys sub-components
    AGO -->|"SSA deploy<br/>(batchGateway=Managed)"| BGO
    AGO -->|"SSA deploy<br/>(modelsAsAService=Managed)"| MaaSCtrl
    AGO -->|"Create namespace + RBAC"| InfraNS

    %% MaaS controller integrations
    MaaSCtrl -->|"Watch/Create<br/>443/TCP HTTPS"| KServe
    MaaSCtrl -->|"Create policies<br/>443/TCP HTTPS"| Kuadrant
    MaaSCtrl -->|"Read config<br/>443/TCP HTTPS"| Authorino
    MaaSCtrl -->|"Create networking<br/>443/TCP HTTPS"| Istio
    MaaSCtrl -->|"Create collectors<br/>443/TCP HTTPS"| OTel
    MaaSCtrl -->|"Create dashboards<br/>443/TCP HTTPS"| Perses
    MaaSCtrl -->|"HTTPRoutes → Gateway"| Gateway
    MaaSCtrl -.->|"Secret migration<br/>(scoped RBAC)"| InfraNS

    %% Batch gateway integrations
    BGO -->|"Create certs<br/>443/TCP HTTPS"| CertMgr

    %% Styling
    classDef controlplane fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef subcomponent fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef webhook fill:#f5a623,stroke:#333,stroke-width:2px,color:#fff
    classDef infra fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f9d4d4,stroke:#c0392b,stroke-width:1px

    class K8sAPI controlplane
    class AGO operator
    class MetricsSvc operator
    class BGO,MaaSCtrl,BGWorkloads subcomponent
    class WebhookSvc webhook
    class InfraRBAC infra
    class DBSecret secret
    class Gateway ingress
    class KServe,Kuadrant,Authorino,Istio,OTel,Perses,CertMgr platform
