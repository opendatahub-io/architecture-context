graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Platform Gateway (Envoy)<br/>443/TCP → internal<br/>TLS 1.3 Termination<br/>Platform Auth"]
    end

    subgraph SidecarLayer["SIDECAR (Auth Enforcement)"]
        KRBAC["kube-rbac-proxy<br/>8443/TCP HTTPS/TLS<br/>Bearer Token / RBAC<br/>Injected by Platform Operator"]
    end

    subgraph AppLayer["APPLICATION (OVMS Pod)"]
        direction TB

        gRPCFE["gRPC Frontend<br/>configurable/TCP<br/>gRPC Plaintext<br/>InsecureServerCredentials<br/>No Auth"]
        HTTPFE["HTTP/REST Frontend (Drogon)<br/>configurable/TCP<br/>HTTP Plaintext<br/>No SSL Config"]
        MetricsEP["Metrics Endpoint<br/>/metrics<br/>HTTP Plaintext<br/>No Auth"]

        AuthNote["Auth: Bearer Token on<br/>/v1/chat/completions,<br/>/v1/completions, /v3/*<br/>(optional, needs API_KEY)"]
        NoAuthNote["No Auth on /v1/*, /v2/*<br/>(non-OpenAI endpoints)<br/>Relies on kube-rbac-proxy"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["Amazon S3<br/>s3.amazonaws.com<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM Credentials"]
        Azure["Azure Blob Storage<br/>*.blob.core.windows.net<br/>443/TCP HTTPS TLS 1.2+<br/>Storage Account Keys"]
        GCS["Google Cloud Storage<br/>storage.googleapis.com<br/>443/TCP HTTPS TLS 1.2+<br/>GCP Service Account"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>HF Token (optional)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>HTTP Scrape<br/>No Auth"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Platform Auth"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Bearer Token / RBAC"| KRBAC
    KRBAC -->|"HTTP/configurable<br/>Plaintext<br/>No Auth (trusted)"| gRPCFE
    KRBAC -->|"HTTP/configurable<br/>Plaintext<br/>No Auth (trusted)"| HTTPFE

    %% Egress flows
    HTTPFE -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    HTTPFE -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage Keys"| Azure
    HTTPFE -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP SA"| GCS
    HTTPFE -->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token"| HFHub

    %% Monitoring
    Prometheus -->|"HTTP/configurable<br/>Plaintext"| MetricsEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef sidecar fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray:5

    class Client external
    class Gateway ingress
    class KRBAC sidecar
    class gRPCFE,HTTPFE,MetricsEP app
    class S3,Azure,GCS,HFHub externalservice
    class Prometheus monitoring
    class AuthNote,NoAuthNote warning
