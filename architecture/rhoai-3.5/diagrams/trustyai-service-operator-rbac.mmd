graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_TAS["{ tas-instance }-proxy<br/>(user namespace)"]
        SA_EH["{ evalhub-instance }-service<br/>(evalhub namespace)"]
        SA_GORCH["{ gorch-instance }-serviceaccount<br/>(gorch namespace)"]
        SA_NEMO["{ nemo-instance }-serviceaccount<br/>(nemo namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_MGR["manager-rolebinding"]
        CRB_TAS_AUTH["{ tas }-proxy-rolebinding<br/>→ system:auth-delegator"]
        CRB_EH_AUTH["{ evalhub }-auth-reviewer-crb<br/>→ auth-reviewer-role"]
        CRB_GORCH_AUTH["{ gorch }-auth-delegator<br/>→ system:auth-delegator"]
        CRB_NEMO_AUTH["{ nemo }-auth-delegator<br/>→ system:auth-delegator"]
        CRB_MGR_AUTH["manager-auth-delegator<br/>→ system:auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_TAS["manager-role (TAS)"]
        CR_LMES["manager-role (LMES)"]
        CR_EH["manager-role (EvalHub)"]
        CR_GORCH["manager-role (GORCH)"]
        CR_NEMO["manager-role (NemoGuardrails)"]
        CR_MOD["manager-role (Module)"]
        CR_JOBMGR["manager-role (JobMgr)"]
        CR_AUTH["system:auth-delegator"]
    end

    subgraph TAS_Resources["TAS API Resources"]
        TAS_R1["trustyai.opendatahub.io<br/>trustyaiservices<br/>trustyaiservices/status<br/>trustyaiservices/finalizers"]
        TAS_R2["serving.kserve.io<br/>inferenceservices<br/>inferenceservices/finalizers"]
        TAS_R3["networking.istio.io<br/>destinationrules<br/>virtualservices"]
    end

    subgraph LMES_Resources["LMES API Resources"]
        LMES_R1["trustyai.opendatahub.io<br/>lmevaljobs<br/>lmevaljobs/status<br/>lmevaljobs/finalizers"]
        LMES_R2["core<br/>pods, pods/exec"]
    end

    subgraph EH_Resources["EvalHub API Resources"]
        EH_R1["trustyai.opendatahub.io<br/>evalhubs, evalhubs/proxy<br/>evalhubs/status, evalhubs/finalizers"]
        EH_R2["trustyai.opendatahub.io<br/>evaluations, collections<br/>providers, status-events"]
        EH_R3["kueue.x-k8s.io<br/>workloads"]
        EH_R4["mlflow.kubeflow.org<br/>experiments"]
        EH_R5["infrastructure.opendatahub.io<br/>hardwareprofiles"]
    end

    subgraph GORCH_Resources["GORCH API Resources"]
        GORCH_R1["trustyai.opendatahub.io<br/>guardrailsorchestrators<br/>guardrailsorchestrators/status<br/>guardrailsorchestrators/finalizers"]
        GORCH_R2["serving.kserve.io<br/>servingruntimes<br/>inferenceservices"]
    end

    subgraph NEMO_Resources["NemoGuardrails API Resources"]
        NEMO_R1["trustyai.opendatahub.io<br/>nemoguardrails<br/>nemoguardrails/status<br/>nemoguardrails/finalizers"]
        NEMO_R2["networking.istio.io<br/>envoyfilters"]
        NEMO_R3["mcp.kuadrant.io<br/>mcpgatewayextensions"]
        NEMO_R4["gateway.networking.k8s.io<br/>gateways"]
    end

    subgraph MOD_Resources["Module API Resources"]
        MOD_R1["components.platform.opendatahub.io<br/>trustyais, trustyais/status<br/>trustyais/finalizers"]
    end

    subgraph JOBMGR_Resources["JobMgr API Resources"]
        JOBMGR_R1["kueue.x-k8s.io<br/>workloads, workloads/status<br/>workloads/finalizers<br/>resourceflavors<br/>workloadpriorityclasses"]
    end

    %% SA to CRB
    SA_CM -->|bound via| CRB_MGR
    SA_CM -->|bound via| CRB_MGR_AUTH
    SA_TAS -->|bound via| CRB_TAS_AUTH
    SA_EH -->|bound via| CRB_EH_AUTH
    SA_GORCH -->|bound via| CRB_GORCH_AUTH
    SA_NEMO -->|bound via| CRB_NEMO_AUTH

    %% CRB to CR
    CRB_MGR -->|grants| CR_TAS
    CRB_MGR -->|grants| CR_LMES
    CRB_MGR -->|grants| CR_EH
    CRB_MGR -->|grants| CR_GORCH
    CRB_MGR -->|grants| CR_NEMO
    CRB_MGR -->|grants| CR_MOD
    CRB_MGR -->|grants| CR_JOBMGR
    CRB_TAS_AUTH -->|grants| CR_AUTH
    CRB_EH_AUTH -->|grants| CR_AUTH
    CRB_GORCH_AUTH -->|grants| CR_AUTH
    CRB_NEMO_AUTH -->|grants| CR_AUTH
    CRB_MGR_AUTH -->|grants| CR_AUTH

    %% CR to Resources
    CR_TAS -->|"get,list,watch,create,<br/>update,patch,delete"| TAS_R1
    CR_TAS -->|"list,watch,get,<br/>update,patch,delete"| TAS_R2
    CR_TAS -->|"create,list,watch,get,<br/>update,patch,delete"| TAS_R3

    CR_LMES -->|"get,list,watch,create,<br/>update,patch,delete"| LMES_R1
    CR_LMES -->|"get,list,watch,<br/>create,delete"| LMES_R2

    CR_EH -->|"get,list,watch,create,<br/>update,patch,delete"| EH_R1
    CR_EH -->|"get,list,watch,create,<br/>update,patch,delete"| EH_R2
    CR_EH -->|"get,list,watch,patch"| EH_R3
    CR_EH -->|"get,list,create"| EH_R4
    CR_EH -->|"get,list"| EH_R5

    CR_GORCH -->|"get,list,watch,create,<br/>update,patch,delete"| GORCH_R1
    CR_GORCH -->|"get,list,watch"| GORCH_R2

    CR_NEMO -->|"get,list,watch,create,<br/>update,patch,delete"| NEMO_R1
    CR_NEMO -->|"get,list,watch,create,<br/>update,patch,delete"| NEMO_R2
    CR_NEMO -->|"get,list,watch"| NEMO_R3
    CR_NEMO -->|"get,list,watch"| NEMO_R4

    CR_MOD -->|"get,list,watch,<br/>update,patch"| MOD_R1

    CR_JOBMGR -->|"get,list,watch,create,<br/>update,patch,delete"| JOBMGR_R1

