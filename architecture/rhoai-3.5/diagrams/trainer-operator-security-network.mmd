graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / User"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph OperatorPod["odh-trainer-operator"]
            OpController["Trainer Controller<br/>SA: odh-trainer-operator-controller-manager"]
            OpHealth["Health Probes<br/>8081/TCP HTTP"]
            OpMetrics["Metrics<br/>8080/TCP HTTP"]
        end

        subgraph DeployedPod["kubeflow-trainer-controller-manager"]
            KFController["Kubeflow Trainer Controller<br/>SA: kubeflow-trainer-controller-manager"]
            KFWebhook["Validating Webhook<br/>9443/TCP HTTPS TLS<br/>Self-signed cert"]
            KFMetrics["Metrics<br/>8443/TCP HTTPS TLS"]
        end

        subgraph Services["ClusterIP Services"]
            WebhookSvc["kubeflow-trainer-controller-manager<br/>443/TCP → 9443"]
            MetricsSvc["kubeflow-trainer-controller-manager<br/>8080/TCP → 8080"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>PodMonitor scrape"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        PlatformOp["rhods-operator<br/>Creates Trainer CR"]
        JobSetOp["JobSet Operator<br/>OLM-managed<br/>Provides JobSet CRD"]
    end

    subgraph NetworkPolicies["NETWORK POLICIES"]
        NP["allow-metrics-traffic<br/>From: ns with metrics=enabled<br/>Port: 8080/TCP"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer / client cert"| K8sAPI

    %% API server to webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS (self-signed)<br/>K8s API TLS client cert"| KFWebhook

    %% Operator to API server
    OpController -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Deployed controller to API server
    KFController -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Platform operator to API
    PlatformOp -->|"HTTPS/6443<br/>SA token"| K8sAPI

    %% Prometheus scraping
    Prometheus -->|"HTTPS/8443<br/>TLS insecureSkipVerify"| KFMetrics
    Prometheus -->|"HTTP/8080<br/>No auth"| OpMetrics

    %% NetworkPolicy enforcement
    NP -.->|controls| OpMetrics

    %% Service routing
    WebhookSvc -.->|routes to| KFWebhook
    MetricsSvc -.->|routes to| KFMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dce6f5,stroke:#4a6fa5,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef deployed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#999,stroke-width:2px
    classDef networkpolicy fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class OpController,OpHealth,OpMetrics operator
    class KFController,KFWebhook,KFMetrics deployed
    class Prometheus monitoring
    class PlatformOp,JobSetOp platform
    class NP networkpolicy
