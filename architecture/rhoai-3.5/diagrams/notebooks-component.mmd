graph TB
    subgraph "Notebooks Component (Workbench Images)"
        direction TB

        subgraph JupyterImages["Jupyter Workbench Images"]
            direction LR
            MinCPU["Jupyter Minimal<br/>CPU"]
            MinCUDA["Jupyter Minimal<br/>CUDA 13.0"]
            MinROCm["Jupyter Minimal<br/>ROCm 7.14"]
            DS["Jupyter Data Science<br/>CPU"]
            PyTorch["Jupyter PyTorch<br/>CUDA 13.0"]
            PyTorchLLM["Jupyter PyTorch<br/>+LLMCompressor<br/>CUDA 13.0"]
            TF["Jupyter TensorFlow<br/>CUDA 12.9"]
            TrustyAI["Jupyter TrustyAI<br/>CPU"]
            ROCmPT["Jupyter ROCm<br/>PyTorch"]
            ROCmTF["Jupyter ROCm<br/>TensorFlow"]
        end

        subgraph RuntimeImages["Elyra Pipeline Runtime Images"]
            direction LR
            RTMin["Runtime Minimal<br/>CPU"]
            RTDS["Runtime Data Science<br/>CPU"]
            RTPyTorch["Runtime PyTorch<br/>CUDA 13.0"]
            RTPyTorchLLM["Runtime PyTorch<br/>+LLMCompressor<br/>CUDA 13.0"]
            RTTF["Runtime TensorFlow<br/>CUDA 12.9"]
            RTROCmPT["Runtime ROCm<br/>PyTorch"]
            RTROCmTF["Runtime ROCm<br/>TensorFlow"]
        end

        subgraph CodeServerImage["Code-Server Image"]
            direction LR
            CS["Code-Server<br/>CPU<br/>v4.112.0"]
            CSNginx["nginx<br/>:8888"]
            CSIDE["code-server<br/>:8787"]
            CSCGI["httpd CGI<br/>:8080"]
            CSNginx -->|"proxy"| CSIDE
            CSNginx -->|"idle culling"| CSCGI
            CSCGI -->|"healthz"| CSIDE
        end
    end

    subgraph BaseImages["AIPCC Base Images"]
        direction LR
        BaseCPU["cpu<br/>aarch64, ppc64le,<br/>s390x, x86_64"]
        BaseCUDA13["cuda-13.0-el9.6<br/>aarch64, x86_64"]
        BaseCUDA12["cuda-12.9-el9.6<br/>aarch64, x86_64"]
        BaseROCm["rocm-7.14-el9.6<br/>x86_64"]
    end

    subgraph Manifests["Kustomize Manifests"]
        direction LR
        ImageStreams["ImageStream<br/>Definitions"]
        Params["params.env<br/>Image Digests"]
        Commits["commit.env<br/>Provenance"]
    end

    User[Data Scientist] -->|"selects workbench"| Dashboard[ODH Dashboard]
    Dashboard -->|"reads annotations"| ImageStreams
    Dashboard -->|"creates Notebook CR"| Controller[ODH Notebook Controller]
    Controller -->|"launches pod"| JupyterImages
    Controller -->|"injects sidecar"| KubeRBACProxy[kube-rbac-proxy<br/>:8443/TCP TLS]
    KubeRBACProxy -->|"proxies to"| MinCPU

    Operator["rhods-operator"] -->|"deploys via kustomize"| Manifests

    %% Base image relationships
    MinCPU -.->|"FROM"| BaseCPU
    MinCUDA -.->|"FROM"| BaseCUDA13
    MinROCm -.->|"FROM"| BaseROCm
    TF -.->|"FROM"| BaseCUDA12
    CS -.->|"FROM"| BaseCPU

    %% Elyra pipeline flow
    DS -->|"submits pipeline"| DSPA[DSPA Endpoint]
    DSPA -->|"launches"| RuntimeImages

