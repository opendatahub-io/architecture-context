    style KuadrantAPI fill:#ce93d8,color:#333
    style WebhookAPI fill:#ce93d8,color:#333
    style CoreAPI fill:#e0e0e0,color:#333
    style AppsAPI fill:#e0e0e0,color:#333
    style CRDsAPI fill:#e0e0e0,color:#333
