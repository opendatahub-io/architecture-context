graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["rhai-operator-controller-manager<br/>(redhat-ods-operator namespace)"]
        SA_Hook["rhai-post-install-hook<br/>(redhat-ods-operator namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["rhai-operator-rolebinding<br/>(cluster-wide)"]
        CRB_Hook["rhai-post-install-hook-binding<br/>(cluster-wide)"]
    end

    subgraph OperatorRole["ClusterRole: rhai-operator-role"]
        direction TB

        subgraph ODH_APIs["ODH Platform APIs"]
            Components["components.platform.opendatahub.io<br/>aigateways, kserves, dashboards,<br/>datasciencepipelines, kueues,<br/>modelregistries, rays, trainers, etc.<br/>Verbs: CRUD + watch"]
            DSC["datasciencecluster.opendatahub.io<br/>datascienceclusters + finalizers + status<br/>Verbs: CRUD + watch"]
            DSCI["dscinitialization.opendatahub.io<br/>dscinitializations + finalizers + status<br/>Verbs: CRUD + watch"]
            Platform["config.opendatahub.io<br/>platforms + finalizers + status<br/>Verbs: get, list, watch, update, patch"]
            HWProfiles["infrastructure.opendatahub.io<br/>hardwareprofiles<br/>Verbs: CRUD + watch"]
        end

        subgraph Gateway_APIs["Gateway & Networking APIs"]
            GatewayAPI["gateway.networking.k8s.io<br/>gatewayclasses, gateways, httproutes<br/>Verbs: CRUD + watch"]
            KServeAPI["serving.kserve.io<br/>inferenceservices, servingruntimes,<br/>clusterservingruntimes, etc.<br/>Verbs: CRUD + watch"]
            IstioAPI["networking.istio.io<br/>destinationrules, envoyfilters<br/>Verbs: CRUD + watch"]
        end

        subgraph Security_APIs["Security & Auth APIs"]
            CertMgrAPI["cert-manager.io<br/>certificates, issuers<br/>Verbs: CRUD + watch"]
            KuadrantAPI["kuadrant.io<br/>authpolicies, ratelimitpolicies,<br/>telemetrypolicies, tokenratelimitpolicies<br/>Verbs: CRUD + watch"]
            RBAC_API["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>Verbs: * (WILDCARD)"]
            WebhookAPI["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigs<br/>Verbs: CRUD + watch"]
        end

        subgraph Core_APIs["Core Kubernetes APIs"]
            CoreAPI["core (v1)<br/>configmaps, deployments, events,<br/>namespaces, pods, secrets,<br/>serviceaccounts, services<br/>Verbs: CRUD + watch"]
            AppsAPI["apps<br/>daemonsets, deployments, statefulsets<br/>Verbs: CRUD + watch"]
            CRDsAPI["apiextensions.k8s.io<br/>customresourcedefinitions<br/>Verbs: CRUD + watch"]
        end

        subgraph Monitoring_APIs["Monitoring APIs"]
            MonitoringAPI["monitoring.coreos.com<br/>prometheusrules, servicemonitors,<br/>podmonitors<br/>Verbs: CRUD + watch"]
            RHOBSMonAPI["monitoring.rhobs<br/>monitoringstacks, prometheusrules,<br/>servicemonitors, thanosqueriers<br/>Verbs: CRUD + watch"]
        end
    end

    subgraph HookRole["ClusterRole: rhai-post-install-hook"]
        direction TB
        HookGateway["gateway.networking.k8s.io<br/>gatewayclasses, gateways<br/>Verbs: create, get, list, watch"]
        HookInfra["infrastructure.opendatahub.io<br/>awskubernetesengines,<br/>azurekubernetesengines,<br/>coreweavekubernetesengines<br/>Verbs: create, get, list, watch"]
        HookConfig["config.opendatahub.io<br/>platforms<br/>Verbs: create, get, list, watch"]
        HookCerts["cert-manager.io<br/>certificates<br/>Verbs: create, get, list, watch"]
    end

    %% Bindings
    SA_Operator -->|"bound via"| CRB_Operator
    CRB_Operator -->|"grants"| OperatorRole

    SA_Hook -->|"bound via"| CRB_Hook
    CRB_Hook -->|"grants"| HookRole

