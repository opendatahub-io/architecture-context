graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        TrustyAI["TrustyAI Operator<br/>Watches LMEvalJob CRDs"]
        K8sAPI["Kubernetes API Server"]
    end

    subgraph JobPod["JOB POD (Single-use, CPU-only)"]
        direction TB
        Adapter["LMEval Adapter<br/>Image: odh-ta-lmes-job<br/>Device: CPU"]

        subgraph Mounts["Mounted Resources"]
            JobSpec["/meta/job.json<br/>(ConfigMap)"]
            AuthSecret["Model Auth Secret<br/>(api-key, hf-token)"]
            TestData["/test_data<br/>(optional, air-gapped)"]
        end

        subgraph SecurityControls["Security Controls"]
            PathValidation["Path Traversal Mitigation<br/>(CWE-22: validates /meta)"]
            CredRedaction["Credential Redaction<br/>(strips tokens from errors)"]
            TLSVerify["TLS Verification<br/>(configurable, default: True)"]
        end
    end

    subgraph EgressTargets["EGRESS DESTINATIONS"]
        direction TB

        subgraph InternalServices["Internal Platform Services"]
            EvalHub["EvalHub Service<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        end

        subgraph ModelServing["Model Serving"]
            ModelEndpoint["Model Serving Endpoint<br/>configurable/TCP<br/>HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token (OPENAI_API_KEY)"]
        end

        subgraph ExternalServices["External Services"]
            HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (HF_TOKEN)"]
            S3["AWS S3 / IBM COS<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / IBM Cloud"]
        end

        subgraph ArtifactStorage["Artifact Storage"]
            OCIRegistry["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Docker auth config"]
        end
    end

    %% Control plane flows
    TrustyAI -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>Creates Job + ConfigMap + Secret"| K8sAPI
    K8sAPI -->|"Schedules Pod"| Adapter

    %% Egress flows
    Adapter -->|"HTTP(S)/configurable<br/>TLS configurable<br/>Bearer Token<br/>Prompts → Completions"| ModelEndpoint
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>Status callbacks + results"| EvalHub
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (optional)<br/>Tokenizers + datasets"| HFHub
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Docker auth<br/>Result artifacts (skopeo)"| OCIRegistry
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM credentials<br/>Model weights + datasets"| S3

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef jobpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef model fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef artifact fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef security fill:#f5f5f5,stroke:#666,stroke-width:1px,stroke-dasharray: 5 5

    class TrustyAI,K8sAPI controlplane
    class Adapter,JobSpec,AuthSecret,TestData jobpod
    class EvalHub internal
    class ModelEndpoint model
    class HFHub,S3 external
    class OCIRegistry artifact
    class PathValidation,CredRedaction,TLSVerify security
