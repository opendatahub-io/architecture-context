graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Dashboard["odh-dashboard<br/>(SA)"]
        SA_Modules["odh-dashboard-modules<br/>(SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Dashboard["odh-dashboard<br/>(ClusterRoleBinding)"]
        CRB_Modules["odh-dashboard-modules<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Dashboard["odh-dashboard<br/>(ClusterRole)"]
        CR_Modules["odh-dashboard-modules<br/>(ClusterRole)"]
    end

    subgraph DashboardResources["odh-dashboard Resources"]
        direction LR

        subgraph StorageOps["Storage"]
            StorageClasses["storage.k8s.io<br/>storageclasses<br/>update, patch"]
        end

        subgraph NodeOps["Cluster Info"]
            Nodes["core<br/>nodes<br/>get, list"]
            MachineAutoScalers["machine.openshift.io<br/>machineautoscalers,<br/>machinesets<br/>get, list"]
            ClusterVersions["config.openshift.io<br/>clusterversions,<br/>ingresses<br/>get, list, watch"]
        end

        subgraph CoreResources["Core K8s Resources"]
            ConfigMaps["core<br/>configmaps, secrets,<br/>persistentvolumeclaims<br/>create, delete, get,<br/>list, patch, update, watch"]
        end

        subgraph MLResources["ML Resources"]
            Notebooks["kubeflow.org<br/>notebooks<br/>FULL CRUD"]
            InferenceServices["serving.kserve.io<br/>inferenceservices<br/>get, list, watch"]
            ModelRegistries["modelregistry.opendatahub.io<br/>modelregistries<br/>FULL CRUD"]
            FeatureStores["feast.dev<br/>featurestores<br/>get, list, watch"]
            MLflows["mlflow.opendatahub.io<br/>mlflows<br/>get, list, watch"]
        end

        subgraph PlatformResources["Platform Resources"]
            DSClusters["datasciencecluster.opendatahub.io<br/>datascienceclusters<br/>list, watch, get"]
            DSCInit["dscinitialization.opendatahub.io<br/>dscinitializations<br/>list, watch, get"]
            OLMSubs["operators.coreos.com<br/>clusterserviceversions,<br/>subscriptions<br/>get, list, watch"]
            AuthSvc["services.platform.opendatahub.io<br/>auths<br/>get"]
        end

        subgraph AuthZResources["AuthN/AuthZ"]
            TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
            SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
            RBAC["rbac.authorization.k8s.io<br/>rolebindings, roles,<br/>clusterrolebindings<br/>list, get, create,<br/>patch, delete"]
            Users["user.openshift.io<br/>groups, users<br/>get, list, watch"]
        end

        subgraph NetworkResources["Network"]
            Routes["route.openshift.io<br/>routes<br/>get, list, watch"]
        end
    end

    subgraph ModuleResources["odh-dashboard-modules Resources"]
        direction LR

        subgraph ModMLResources["ML Resources"]
            ModMLflows["mlflow.opendatahub.io<br/>mlflows<br/>get, list, watch"]
        end

        subgraph ModPlatformResources["Platform Resources"]
            ModIngresses["config.openshift.io<br/>ingresses<br/>get, list, watch"]
            ModOTel["opentelemetry.io<br/>opentelemetrycollectors<br/>FULL CRUD"]
        end

        subgraph ModAuthResources["AuthZ & Impersonation"]
            ModSAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
            Impersonation["core<br/>users, groups,<br/>serviceaccounts<br/>impersonate"]
        end

        subgraph ModNetResources["Network"]
            ModRoutes["route.openshift.io<br/>routes<br/>get, list"]
        end
    end

    %% Bindings
    SA_Dashboard -->|bound via| CRB_Dashboard
    CRB_Dashboard -->|grants| CR_Dashboard

    SA_Modules -->|bound via| CRB_Modules
    CRB_Modules -->|grants| CR_Modules

    %% Dashboard role grants
    CR_Dashboard -->|grants access to| StorageClasses
    CR_Dashboard -->|grants access to| Nodes
    CR_Dashboard -->|grants access to| MachineAutoScalers
    CR_Dashboard -->|grants access to| ClusterVersions
    CR_Dashboard -->|grants access to| ConfigMaps
    CR_Dashboard -->|grants access to| Notebooks
    CR_Dashboard -->|grants access to| InferenceServices
    CR_Dashboard -->|grants access to| ModelRegistries
    CR_Dashboard -->|grants access to| FeatureStores
    CR_Dashboard -->|grants access to| MLflows
    CR_Dashboard -->|grants access to| DSClusters
    CR_Dashboard -->|grants access to| DSCInit
    CR_Dashboard -->|grants access to| OLMSubs
    CR_Dashboard -->|grants access to| AuthSvc
    CR_Dashboard -->|grants access to| TokenReviews
    CR_Dashboard -->|grants access to| SAR
    CR_Dashboard -->|grants access to| RBAC
    CR_Dashboard -->|grants access to| Users
    CR_Dashboard -->|grants access to| Routes

    %% Modules role grants
    CR_Modules -->|grants access to| ModMLflows
    CR_Modules -->|grants access to| ModIngresses
    CR_Modules -->|grants access to| ModOTel
    CR_Modules -->|grants access to| ModSAR
    CR_Modules -->|grants access to| Impersonation
    CR_Modules -->|grants access to| ModRoutes

    %% Styling
    style SA_Dashboard fill:#4a90e2,stroke:#333,color:#fff
    style SA_Modules fill:#4a90e2,stroke:#333,color:#fff
    style CRB_Dashboard fill:#dae8fc,stroke:#6c8ebf
    style CRB_Modules fill:#dae8fc,stroke:#6c8ebf
    style CR_Dashboard fill:#f5a623,stroke:#333,color:#fff
    style CR_Modules fill:#f5a623,stroke:#333,color:#fff
    style Notebooks fill:#7ed321,stroke:#333,color:#fff
    style ModelRegistries fill:#7ed321,stroke:#333,color:#fff
    style InferenceServices fill:#7ed321,stroke:#333,color:#fff
    style Impersonation fill:#f8cecc,stroke:#b85450
    style TokenReviews fill:#f8cecc,stroke:#b85450
    style SAR fill:#f8cecc,stroke:#b85450
    style ModSAR fill:#f8cecc,stroke:#b85450
    style RBAC fill:#f8cecc,stroke:#b85450
