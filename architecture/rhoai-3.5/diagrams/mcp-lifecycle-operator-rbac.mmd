graph TD
    subgraph "Service Account"
        SA["controller-manager<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["manager-rolebinding<br/>(cluster-scoped)"]
        CRB_Metrics["metrics-auth-rolebinding<br/>(cluster-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph "Roles"
        CR_Manager["manager-role<br/>(ClusterRole)"]
        CR_Metrics["metrics-auth-role<br/>(ClusterRole)"]
        R_Leader["leader-election-role<br/>(Role)"]
    end

    subgraph "Core API Resources"
        ConfigMaps["core<br/>ConfigMaps"]
        Secrets_R["core<br/>Secrets"]
        Pods["core<br/>Pods"]
        Services["core<br/>Services"]
        Events["core, events.k8s.io<br/>Events"]
    end

    subgraph "Apps API Resources"
        Deployments["apps<br/>Deployments"]
    end

    subgraph "MCP API Resources"
        MCPServers["mcp.x-k8s.io<br/>MCPServers"]
        MCPServersFin["mcp.x-k8s.io<br/>MCPServers/finalizers"]
        MCPServersStatus["mcp.x-k8s.io<br/>MCPServers/status"]
    end

    subgraph "Networking API Resources"
        NetworkPolicies["networking.k8s.io<br/>NetworkPolicies"]
    end

    subgraph "Auth API Resources"
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    %% Bindings
    SA -->|bound via| CRB_Manager
    SA -->|bound via| CRB_Metrics
    SA -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader -->|grants| R_Leader

    %% manager-role permissions
    CR_Manager -->|"get, list, watch"| ConfigMaps
    CR_Manager -->|"get, list, watch"| Secrets_R
    CR_Manager -->|"get, list"| Pods
    CR_Manager -->|"create, get, list,<br/>update, watch"| Services
    CR_Manager -->|"create, patch"| Events
    CR_Manager -->|"create, get, list,<br/>update, watch"| Deployments
    CR_Manager -->|"get, list, patch,<br/>update, watch"| MCPServers
    CR_Manager -->|"update"| MCPServersFin
    CR_Manager -->|"get, patch, update"| MCPServersStatus
    CR_Manager -->|"create, get, list,<br/>update, watch"| NetworkPolicies

    %% metrics-auth-role permissions
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SAR

    %% User-facing RBAC Roles (not bound by default)
    subgraph "User-Facing ClusterRoles (unbound)"
        CR_Admin["mcpserver-admin-role<br/>mcpservers: *<br/>mcpservers/status: get"]
        CR_Editor["mcpserver-editor-role<br/>mcpservers: CRUD+watch<br/>mcpservers/status: get"]
        CR_Viewer["mcpserver-viewer-role<br/>mcpservers: get, list, watch<br/>mcpservers/status: get"]
    end

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style CRB_Manager fill:#ddd,stroke:#333
    style CRB_Metrics fill:#ddd,stroke:#333
    style RB_Leader fill:#ddd,stroke:#333
    style CR_Admin fill:#7ed321,stroke:#333
    style CR_Editor fill:#7ed321,stroke:#333
    style CR_Viewer fill:#7ed321,stroke:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets_R fill:#e8e8e8,stroke:#333
    style Pods fill:#e8e8e8,stroke:#333
    style Services fill:#e8e8e8,stroke:#333
    style Events fill:#e8e8e8,stroke:#333
    style Deployments fill:#e8e8e8,stroke:#333
    style MCPServers fill:#e8e8e8,stroke:#333
    style MCPServersFin fill:#e8e8e8,stroke:#333
    style MCPServersStatus fill:#e8e8e8,stroke:#333
    style NetworkPolicies fill:#e8e8e8,stroke:#333
    style TokenReviews fill:#e8e8e8,stroke:#333
    style SAR fill:#e8e8e8,stroke:#333
