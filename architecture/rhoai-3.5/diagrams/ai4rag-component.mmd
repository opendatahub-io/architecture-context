graph TB
    subgraph AI4RAG["ai4rag Library"]
        direction TB

        subgraph Core["core/"]
            direction LR
            Experiment["AI4RAGExperiment<br/><i>Orchestrates search space<br/>exploration & evaluation</i>"]
            MPS["ModelsPreSelector<br/><i>Quick model screening<br/>via in-memory ChromaDB</i>"]
            GAM["GAMOptimizer<br/><i>GAM-based surrogate<br/>model optimization</i>"]
            Random["RandomOptimizer<br/><i>Random search<br/>baseline</i>"]
        end

        subgraph RAG["rag/"]
            direction LR
            Template["SimpleRAGTemplate<br/><i>RAG pipeline orchestration</i>"]
            FM["FoundationModels<br/><i>OGX chat completions</i>"]
            Embed["EmbeddingModels<br/><i>OGX embeddings</i>"]
            VS["VectorStores<br/><i>OGX / ChromaDB</i>"]
            Chunker["Chunkers<br/><i>LangChain / Docling</i>"]
            Retriever["Retriever<br/><i>Query & retrieve</i>"]
        end

        subgraph Eval["evaluator/"]
            direction LR
            Unitxt["UnitxtEvaluator<br/><i>Answer correctness,<br/>faithfulness, context</i>"]
            LLMaJ["LLMaJEvaluator<br/><i>LLM-as-a-Judge<br/>answer relevance</i>"]
            JudgeSel["JudgeSelection<br/><i>Calibrate & select<br/>best judge model</i>"]
        end

        subgraph SearchSpace["search_space/"]
            SSP["SearchSpace<br/><i>Parameter definitions<br/>& constraint validation</i>"]
            Prepare["PrepareSearchSpace<br/><i>OGX model discovery</i>"]
        end

        subgraph Components["components/"]
            direction LR
            DocDisc["DocumentsDiscovery<br/><i>S3 object listing</i>"]
            TextExt["TextExtraction<br/><i>Docling multi-process</i>"]
            OptComp["RagOptimization<br/><i>KFP orchestration</i>"]
            Assets["AssetsGenerator<br/><i>Pattern JSON &<br/>Jupyter notebooks</i>"]
        end

        subgraph Utils["utils/"]
            LocalEH["LocalEventHandler<br/><i>File-based output</i>"]
            KFPEH["KFPEventHandler<br/><i>KFP aggregation</i>"]
        end
    end

    %% Internal flows
    Experiment -->|"selects params"| GAM
    Experiment -->|"fallback"| Random
    Experiment -->|"pre-selects models"| MPS
    Experiment -->|"builds pipeline"| Template
    Experiment -->|"evaluates"| Unitxt
    Experiment -->|"evaluates"| LLMaJ
    LLMaJ -->|"calibrates"| JudgeSel
    Template -->|"generates text"| FM
    Template -->|"embeds"| Embed
    Template -->|"stores/queries"| VS
    Template -->|"chunks docs"| Chunker
    Template -->|"retrieves"| Retriever
    Retriever -->|"queries"| VS
    SSP -->|"constrains"| Experiment
    Prepare -->|"discovers models"| SSP
    OptComp -->|"orchestrates"| Experiment
    OptComp -->|"emits events"| KFPEH
    Experiment -->|"emits events"| LocalEH
    DocDisc -->|"feeds"| TextExt

    %% External dependencies
    OGX["OGX Server<br/><i>443/TCP HTTPS</i>"]
    S3["S3 Storage<br/><i>443/TCP HTTPS</i>"]
    HFHub["HuggingFace Hub<br/><i>443/TCP HTTPS</i>"]
    KFP["Kubeflow Pipelines"]

    FM -->|"chat completions"| OGX
    Embed -->|"embeddings"| OGX
    VS -->|"vector CRUD"| OGX
    Prepare -->|"list models"| OGX
    DocDisc -->|"list objects"| S3
    TextExt -->|"download files"| S3
    TextExt -.->|"model artifacts"| HFHub
    KFPEH -->|"status & results"| KFP

    %% Styling
    style AI4RAG fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Core fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style RAG fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style Eval fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style SearchSpace fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style Components fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style Utils fill:#dbeafe,stroke:#3b82f6,stroke-width:1px

    style Experiment fill:#4a90e2,color:#fff
    style GAM fill:#4a90e2,color:#fff
    style Template fill:#4a90e2,color:#fff

    style OGX fill:#e8e8e8,stroke:#999
    style S3 fill:#e8e8e8,stroke:#999
    style HFHub fill:#e8e8e8,stroke:#999
    style KFP fill:#7ed321,stroke:#333
