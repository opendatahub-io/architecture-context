graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator<br/>controller-manager"]
        SA_Registry["{name}<br/>(per-registry SA)"]
        SA_Catalog["model-catalog<br/>SA"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_AuthDelegator_Reg["{name}-auth-delegator<br/>(per-registry, cluster-scoped)"]
        CRB_AuthDelegator_Cat["model-catalog-<br/>auth-delegator<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_LeaderElection["leader-election-<br/>rolebinding<br/>(operator namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_LeaderElection["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps"]
        PVCs["core<br/>persistentvolumeclaims"]
        Secrets["core<br/>secrets"]
        SvcAccts["core<br/>serviceaccounts"]
        Services["core<br/>services"]
        Endpoints["core<br/>endpoints"]
        Pods["core<br/>pods, pods/log"]
        Events["core<br/>events"]
    end

    subgraph ModelRegistryResources["ModelRegistry API Resources"]
        MR["modelregistry.opendatahub.io<br/>modelregistries"]
        MR_Status["modelregistry.opendatahub.io<br/>modelregistries/status"]
        MR_Finalizers["modelregistry.opendatahub.io<br/>modelregistries/finalizers"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps<br/>deployments"]
    end

    subgraph RBACResources["RBAC API Resources"]
        Roles["rbac.authorization.k8s.io<br/>roles"]
        RoleBindingsRes["rbac.authorization.k8s.io<br/>rolebindings"]
        CRBRes["rbac.authorization.k8s.io<br/>clusterrolebindings"]
    end

    subgraph NetworkResources["Network API Resources"]
        NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        RefGrants["gateway.networking.k8s.io<br/>referencegrants"]
    end

    subgraph OpenShiftResources["OpenShift API Resources"]
        Routes["route.openshift.io<br/>routes, routes/custom-host"]
        Groups["user.openshift.io<br/>groups"]
        Ingresses["config.openshift.io<br/>ingresses"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph PlatformResources["Platform API Resources"]
        PlatformMR["components.platform.opendatahub.io<br/>modelregistries"]
        PlatformAuth["services.platform.opendatahub.io<br/>auths"]
        SVM["migration.k8s.io<br/>storageversionmigrations"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    SA_Operator -->|bound via| RB_LeaderElection
    CRB_Manager -->|grants| CR_Manager
    RB_LeaderElection -->|grants| CR_LeaderElection

    %% Per-registry SA bindings
    SA_Registry -->|bound via| CRB_AuthDelegator_Reg
    CRB_AuthDelegator_Reg -->|grants| CR_AuthDelegator

    %% Catalog SA bindings
    SA_Catalog -->|bound via| CRB_AuthDelegator_Cat
    CRB_AuthDelegator_Cat -->|grants| CR_AuthDelegator

    %% manager-role permissions
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| MR
    CR_Manager -->|"get,update,patch"| MR_Status
    CR_Manager -->|"update"| MR_Finalizers
    CR_Manager -->|"create,delete,get,<br/>list,patch,update,watch"| ConfigMaps
    CR_Manager -->|"create,delete,get,<br/>list,patch,update,watch"| PVCs
    CR_Manager -->|"create,delete,get,<br/>list,patch,update,watch"| Secrets
    CR_Manager -->|"create,delete,get,<br/>list,patch,update,watch"| SvcAccts
    CR_Manager -->|"create,delete,get,<br/>list,patch,update,watch"| Services
    CR_Manager -->|"get,list,watch"| Endpoints
    CR_Manager -->|"get,list,watch"| Pods
    CR_Manager -->|"create,patch"| Events
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Deployments
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Roles
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| RoleBindingsRes
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| CRBRes
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Routes
    CR_Manager -->|"get,list,watch,<br/>create,update,delete"| Groups
    CR_Manager -->|"get,list,watch"| Ingresses
    CR_Manager -->|"get,list,watch"| APIServers
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| NetworkPolicies
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| HTTPRoutes
    CR_Manager -->|"get,list,watch,create"| RefGrants
    CR_Manager -->|"create"| TokenReviews
    CR_Manager -->|"create"| SAR
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| SVM
    CR_Manager -->|"get,list,watch"| CRDs
    CR_Manager -->|"get,list,watch"| PlatformMR
    CR_Manager -->|"get,list,watch"| PlatformAuth

    %% auth-delegator permissions
    CR_AuthDelegator -->|"create"| TokenReviews
    CR_AuthDelegator -->|"create"| SAR

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Registry fill:#4a90e2,stroke:#333,color:#fff
    style SA_Catalog fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_AuthDelegator fill:#f5a623,stroke:#333,color:#fff
    style CR_LeaderElection fill:#f5a623,stroke:#333,color:#fff
    style CRB_Manager fill:#e8e8e8,stroke:#616161
    style CRB_AuthDelegator_Reg fill:#e8e8e8,stroke:#616161
    style CRB_AuthDelegator_Cat fill:#e8e8e8,stroke:#616161
    style RB_LeaderElection fill:#e8e8e8,stroke:#616161
    style MR fill:#7ed321,stroke:#333,color:#fff
    style MR_Status fill:#7ed321,stroke:#333,color:#fff
    style MR_Finalizers fill:#7ed321,stroke:#333,color:#fff
