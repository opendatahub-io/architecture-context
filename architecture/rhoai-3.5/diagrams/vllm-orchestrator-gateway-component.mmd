graph TB
    subgraph External["External Clients"]
        Client[Client Application]
    end

    subgraph Gateway["vllm-orchestrator-gateway (Rust/axum)"]
        direction TB
        Router["axum Router<br/>Dynamic Route Registration"]
        HeaderFwd["Header Forwarding<br/>(Authorization, X-Forwarded-*)"]
        ConfigLoader["Config Loader<br/>(YAML → Routes + Detectors)"]
        ConfigValidator["Config Validator<br/>(validate_registered_detectors)"]
        TLSBuilder["TLS Client Builder<br/>(build_orchestrator_client)"]

        subgraph Routes["Per-Route Endpoints (POST)"]
            Route1["/{route_name}/v1/chat/completions"]
        end

        subgraph Handlers["Request Handlers"]
            NonStream["Non-Streaming Handler<br/>(handle_generation)"]
            Stream["Streaming Handler<br/>(handle_streaming_generation)"]
        end

        subgraph Detection["Detection Logic"]
            DetectorInjection["Detector Config Injection<br/>(input + output detectors)"]
            FallbackCheck["Fallback Message Check<br/>(replace on detection)"]
        end

        ConfigLoader --> ConfigValidator
        ConfigValidator --> Router
        Router --> Routes
        Routes --> HeaderFwd
        HeaderFwd --> NonStream
        HeaderFwd --> Stream
        NonStream --> DetectorInjection
        Stream --> DetectorInjection
        DetectorInjection -->|POST /api/v2/chat/completions-detection| TLSBuilder
        TLSBuilder -->|Response| FallbackCheck
    end

    subgraph Platform["Platform Services"]
        Orchestrator["FMS Guardrails Orchestrator<br/>8085/TCP"]
        vLLM["vLLM Inference Server<br/>(indirect via orchestrator)"]
        Detectors["Guardrails Detectors<br/>(e.g., regex-detector)<br/>(indirect via orchestrator)"]
    end

    subgraph CertProviders["Certificate Provisioning"]
        ServiceCA["OpenShift service-ca<br/>/etc/tls/ca/service-ca.crt"]
        ServingCert["service-serving-cert-signer<br/>/etc/tls/private/tls.{crt,key}"]
    end

    subgraph ConfigSource["Configuration"]
        ConfigMap["Kubernetes ConfigMap<br/>(config.yaml)"]
    end

    Client -->|"POST /{route}/v1/chat/completions<br/>8090/TCP HTTP"| Router
    FallbackCheck -->|"JSON / SSE Response"| Client
    TLSBuilder -->|"HTTP or HTTPS<br/>Optional mTLS"| Orchestrator
    Orchestrator --> vLLM
    Orchestrator --> Detectors
    ServiceCA -.->|CA cert| TLSBuilder
    ServingCert -.->|Client cert + key| TLSBuilder
    ConfigMap -.->|GATEWAY_CONFIG| ConfigLoader

    style Gateway fill:#4a90e2,color:#fff
    style Router fill:#3a7bc8,color:#fff
    style NonStream fill:#3a7bc8,color:#fff
    style Stream fill:#3a7bc8,color:#fff
    style DetectorInjection fill:#3a7bc8,color:#fff
    style FallbackCheck fill:#3a7bc8,color:#fff
    style ConfigLoader fill:#3a7bc8,color:#fff
    style ConfigValidator fill:#3a7bc8,color:#fff
    style TLSBuilder fill:#3a7bc8,color:#fff
    style HeaderFwd fill:#3a7bc8,color:#fff
    style Route1 fill:#5b9bd5,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style Detectors fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style ServiceCA fill:#f5a623,stroke:#333
    style ServingCert fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
