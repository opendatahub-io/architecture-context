graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        KServe["KServe InferenceService"]
        ModelMesh["ModelMesh PayloadProcessor"]
        Dashboard["OpenShift AI Dashboard"]
        Prometheus["Prometheus / OCP Monitoring"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
        KubeRBACProxy["kube-rbac-proxy Sidecar<br/>8443/TCP → 8080/TCP (loopback)<br/>TLS 1.2+<br/>AuthN: Bearer Token (SA token)<br/>AuthZ: SubjectAccessReview"]
    end

    subgraph Application["APPLICATION POD (per-namespace)"]
        direction TB

        subgraph HTTPBinding["HTTP Binding (127.0.0.1:8080)"]
            TrustyHTTP["TrustyAI Service<br/>Loopback only<br/>No external access<br/>No auth (pre-authenticated)"]
        end

        subgraph HTTPSBinding["HTTPS Binding (0.0.0.0:4443)"]
            TrustyHTTPS["TrustyAI Service<br/>TLS 1.2+<br/>Cert: /etc/tls/internal/tls.crt<br/>Optional client cert auth"]
        end

        subgraph Background["Background Tasks"]
            Scheduler["Prometheus Scheduler<br/>asyncio 30s interval"]
            LMEval["lm-eval subprocess<br/>Sanitized env<br/>No server secrets<br/>CWE-426/427 hardened"]
        end
    end

    subgraph StorageBackends["STORAGE BACKENDS"]
        PVC["PVC / HDF5<br/>Filesystem<br/>JSON+gzip serialization<br/>No pickle (CWE-502)"]
        MariaDB["MariaDB<br/>3306/TCP MySQL<br/>TLS optional (ssl_ca)<br/>Username/password auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLMEndpoints["LLM Inference Endpoints<br/>HTTP/HTTPS (varies)<br/>API key auth"]
    end

    %% External → Auth Boundary
    KServe -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KubeRBACProxy
    ModelMesh -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KubeRBACProxy
    Dashboard -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KubeRBACProxy
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KubeRBACProxy

    %% Auth Boundary → Application
    KubeRBACProxy -->|"HTTP/8080<br/>Loopback (127.0.0.1)<br/>No encryption<br/>Pre-authenticated"| TrustyHTTP

    %% Application → Storage
    TrustyHTTP -->|"Filesystem I/O<br/>HDF5 format"| PVC
    TrustyHTTP -->|"MySQL/3306<br/>TLS optional<br/>DB credentials"| MariaDB

    %% Background → External
    LMEval -->|"HTTP/HTTPS (varies)<br/>API key (env var)"| LLMEndpoints

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:3px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class KServe,ModelMesh,Dashboard,Prometheus external
    class KubeRBACProxy authboundary
    class TrustyHTTP,TrustyHTTPS,Scheduler,LMEval application
    class PVC,MariaDB storage
    class LLMEndpoints externalservice
