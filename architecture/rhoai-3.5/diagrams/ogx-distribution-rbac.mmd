graph TD
    subgraph PlatformRBAC["Platform-Managed RBAC (rhods-operator)"]
        direction TB
        Note1["No RBAC manifests in this repository.<br/>All Kubernetes RBAC is managed by the<br/>platform operator (rhods-operator)."]
    end

    subgraph SidecarAuth["Pod-Level Authentication"]
        KRBAC["kube-rbac-proxy<br/>(sidecar injected by platform)"]
        KRBAC_Desc["Enforces authentication at pod boundary<br/>before requests reach OGX server"]
    end

    subgraph AppLevelAuth["Application-Level Authorization (OGX Server)"]
        direction TB

        subgraph AuthConfig["Authentication Configuration"]
            AuthEnabled["AUTH_ISSUER set?"]
            AuthYes["Yes: JWT validation via JWKS"]
            AuthNo["No: --insecure (no auth)"]
            AuthEnabled -->|Yes| AuthYes
            AuthEnabled -->|No| AuthNo
        end

        subgraph AccessPolicy["Owner-Based Access Policy"]
            direction TB
            SystemResources["System Resources<br/>(unowned, e.g. models)"]
            UserResources["User-Created Resources"]

            ReadSystem["GET: All authenticated users"]
            CreateResource["POST: All authenticated users"]
            ReadOwn["GET: Owner only"]
            UpdateOwn["PUT: Owner only"]
            DeleteOwn["DELETE: Owner only"]

            SystemResources --> ReadSystem
            UserResources --> CreateResource
            UserResources --> ReadOwn
            UserResources --> UpdateOwn
            UserResources --> DeleteOwn
        end

        AuthYes --> AccessPolicy
    end

    subgraph SecretManagement["Secret Management"]
        direction TB
        SecretVars["18 Provider Secret Variables"]
        FileVariants["_FILE Variant Support<br/>(avoids /proc/1/environ exposure)"]
        SecretVars --> FileVariants

        subgraph Secrets["Secret Variables"]
            VLLM_TOKEN["VLLM_API_TOKEN"]
            VLLM_EMB_TOKEN["VLLM_EMBEDDING_API_TOKEN"]
            OPENAI_KEY["OPENAI_API_KEY"]
            ANTHROPIC_KEY["ANTHROPIC_API_KEY"]
            AZURE_KEY["AZURE_API_KEY"]
            WATSONX_KEY["WATSONX_API_KEY"]
            BRAVE_KEY["BRAVE_SEARCH_API_KEY"]
            TAVILY_KEY["TAVILY_SEARCH_API_KEY"]
            POSTGRES_PW["POSTGRES_PASSWORD"]
            OtherKeys["+ 9 more provider keys"]
        end
    end

    subgraph MultiTenancy["Multi-Tenancy Model"]
        TenantID["Tenant Identity: JWT subject"]
        SharedDB["Shared PostgreSQL<br/>(no schema isolation)"]
        SharedCreds["Shared Provider Credentials<br/>(no per-user API keys)"]
        AppIsolation["Application-Level Isolation Only<br/>(owner-based filtering)"]
    end

    Client["External Client"] -->|"HTTPS/443"| KRBAC
    KRBAC -->|"HTTP/8321"| AuthEnabled

    %% Styling
    style PlatformRBAC fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style Note1 fill:#fff,stroke:#d79b00
    style SidecarAuth fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style KRBAC fill:#4a90e2,stroke:#333,color:#fff
    style AppLevelAuth fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style AuthConfig fill:#e8f5e9,stroke:#82b366
    style AccessPolicy fill:#e8f5e9,stroke:#82b366
    style SecretManagement fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Secrets fill:#fce4ec,stroke:#b85450
    style MultiTenancy fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    style AuthEnabled fill:#f5a623,stroke:#333,color:#fff
    style AuthYes fill:#7ed321,stroke:#333,color:#fff
    style AuthNo fill:#e74c3c,stroke:#333,color:#fff

    style SystemResources fill:#fff2cc,stroke:#d6b656
    style UserResources fill:#fff2cc,stroke:#d6b656
    style ReadSystem fill:#c8e6c9,stroke:#388e3c
    style CreateResource fill:#c8e6c9,stroke:#388e3c
    style ReadOwn fill:#c8e6c9,stroke:#388e3c
    style UpdateOwn fill:#c8e6c9,stroke:#388e3c
    style DeleteOwn fill:#c8e6c9,stroke:#388e3c

    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
