graph TB
    subgraph External["EXTERNAL (No Ingress)"]
        NoIngress["No external ingress<br/>Cluster-internal only"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes Network)"]
        direction TB

        subgraph NS_Platform["Platform Operator Namespace"]
            PlatformOp["Platform Operator<br/>(opendatahub-operator /<br/>rhods-operator)<br/>SA: platform operator SA"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            ModuleOp["feast-module-operator<br/>SA: operator<br/>Replicas: 1<br/>CPU: 500m / Mem: 512Mi"]
            MetricsSvc["opendatahub-feast-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS TLS<br/>Bearer Token Auth"]
            FeastOp["feast-operator<br/>(managed Deployment)<br/>Manages FeatureStore CRs"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus /<br/>OpenShift Monitoring<br/>ServiceMonitor"]
    end

    subgraph HealthProbes["HEALTH PROBES"]
        Kubelet["Kubelet"]
    end

    %% Flows
    PlatformOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Creates FeastOperator CR +<br/>Writes ConfigMap"| K8sAPI

    K8sAPI -->|"Watch stream<br/>HTTPS/443<br/>TLS 1.2+<br/>FeastOperator CR events"| ModuleOp

    ModuleOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Read ConfigMap +<br/>Apply kustomize manifests"| K8sAPI

    K8sAPI -->|"Creates/Updates<br/>Deployment, CRDs,<br/>RBAC, ServiceMonitor"| FeastOp

    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>ServiceMonitor scrape"| MetricsSvc
    MetricsSvc -->|"/metrics"| ModuleOp

    Kubelet -->|"HTTP/8081<br/>No TLS, No Auth<br/>/healthz, /readyz"| ModuleOp

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sapi fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef probes fill:#f9f9f9,stroke:#999,stroke-width:1px
    classDef managed fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class NoIngress external
    class K8sAPI k8sapi
    class PlatformOp,ModuleOp operator
    class MetricsSvc,Prometheus monitoring
    class Kubelet probes
    class FeastOp managed
