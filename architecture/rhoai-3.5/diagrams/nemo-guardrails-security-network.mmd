graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph PlatformAuth["PLATFORM AUTH BOUNDARY"]
        AuthProxy["kube-rbac-proxy / Gateway API<br/>TLS Termination<br/>Bearer Token Validation"]
    end

    subgraph Application["APPLICATION (NeMo Guardrails Server)"]
        direction TB

        subgraph Server["FastAPI + Uvicorn (Port 8000)"]
            API["API Endpoints<br/>/v1/chat/completions (POST)<br/>/v1/guardrail/checks (POST)<br/>/v1/checks (POST)<br/>/v1/rails/configs (GET)<br/>/v1/models (GET)<br/>/v1/health (GET)"]
            HeaderFwd["Header Forwarding<br/>X-Authorization → Authorization<br/>Filters: X-Forwarded-*, X-Real-IP"]
        end

        subgraph InProcess["In-Process Components"]
            Colang["Colang Runtime<br/>(v1.0 + v2.x)"]
            Rails["Guardrails Library<br/>(30+ integrations)"]
            Embeddings["Embeddings Engine<br/>ONNX/fastembed<br/>all-MiniLM-L6-v2"]
        end

        API --> Colang
        Colang --> Rails
        Rails --> Embeddings
        API --> HeaderFwd
    end

    subgraph EgressServices["EGRESS (External Services)"]
        LLM["Upstream LLM Server<br/>(vLLM / NIM / OpenAI)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        Telemetry["NVIDIA Telemetry<br/>events.telemetry.data.nvidia.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth (opt-out: DO_NOT_TRACK=1)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>(only if models not pre-cached)"]
        AltProviders["Alternative LLM Providers<br/>Azure OpenAI / Anthropic / Cohere<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
    end

    subgraph OptionalServices["OPTIONAL SERVICES"]
        Redis["Redis<br/>6379/TCP<br/>Redis Protocol<br/>Optional TLS<br/>Thread Persistence"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+ (platform)<br/>Platform Token"| AuthProxy
    AuthProxy -->|"HTTP/8000<br/>Plaintext (in-pod)<br/>X-Authorization header"| API
    HeaderFwd -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (forwarded)"| LLM
    Server -.->|"HTTPS/443<br/>TLS 1.2+<br/>Anonymous"| Telemetry
    Server -.->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth"| HFHub
    HeaderFwd -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| AltProviders
    Server -.->|"TCP/6379<br/>Optional TLS<br/>Redis Auth"| Redis

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class AuthProxy authboundary
    class API,HeaderFwd,Colang,Rails,Embeddings application
    class LLM,Telemetry,HFHub,AltProviders egress
    class Redis optional
