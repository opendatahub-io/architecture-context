graph TB
    subgraph MCPServer["RHOAI MCP Server (FastMCP)"]
        direction TB

        subgraph Core["Core Services"]
            Server["MCP Server<br/>(server.py)"]
            PluginMgr["Plugin Manager<br/>(pluggy)"]
            K8sClient["K8s Client<br/>(kubernetes SDK)"]
        end

        subgraph Auth["Authentication & Authorization"]
            OIDCMiddleware["OIDC Auth Middleware<br/>(ASGI)"]
            RBACChecker["RBAC Checker<br/>(SubjectAccessReview)"]
        end

        subgraph Utils["Utilities"]
            PortFwd["Port-Forward Manager<br/>(oc port-forward)"]
        end

        subgraph DomainPlugins["Domain Plugins (10)"]
            Notebooks["notebooks<br/>(8 tools)"]
            Inference["inference<br/>(12 tools)"]
            Pipelines["pipelines<br/>(3 tools)"]
            Training["training<br/>(13 tools)"]
            Connections["connections<br/>(4 tools)"]
            Storage["storage<br/>(3 tools)"]
            Projects["projects<br/>(5 tools)"]
            ModelReg["model_registry<br/>(10 tools)"]
            Prompts["prompts"]
            Quickstarts["quickstarts"]
        end

        subgraph CompositePlugins["Composite Plugins (4)"]
            ClusterComposite["cluster composites<br/>(10 tools)"]
            TrainingComposite["training composites<br/>(9 tools)"]
            MetaComposite["meta composites<br/>(2 tools)"]
            PlannerComposite["planner composites<br/>(2 tools)"]
        end
    end

    %% External actors
    AIAgent["AI Agent<br/>(MCP Client)"]
    OIDCProvider["OIDC Provider<br/>(OpenShift OAuth)"]

    %% External platform dependencies
    K8sAPI["Kubernetes API Server"]
    KubeflowNotebook["Kubeflow Notebook Controller"]
    KServe["KServe Controller"]
    DSPOperator["Data Science Pipelines Operator"]
    TrainingOp["Kubeflow Training Operator"]
    ModelRegSvc["Model Registry / Model Catalog"]
    PlannerBackend["Planner Backend"]
    RHODSOp["rhods-operator"]

    %% Flows
    AIAgent -->|"SSE/HTTP<br/>8000/TCP"| Server
    Server -->|"validates tokens"| OIDCMiddleware
    OIDCMiddleware -->|"JWKS/TokenReview"| OIDCProvider
    OIDCMiddleware -->|"checks permissions"| RBACChecker
    RBACChecker -->|"SubjectAccessReview"| K8sAPI

    Server -->|"loads/manages"| PluginMgr
    PluginMgr -->|"registers"| DomainPlugins
    PluginMgr -->|"registers"| CompositePlugins

    %% Domain plugin to K8s interactions
    Notebooks -->|"Notebook CR"| K8sClient
    Inference -->|"InferenceService CR"| K8sClient
    Pipelines -->|"DSPA CR"| K8sClient
    Training -->|"TrainJob CR"| K8sClient
    Connections -->|"Secrets"| K8sClient
    Storage -->|"PVCs"| K8sClient
    Projects -->|"Namespaces"| K8sClient

    K8sClient -->|"REST API<br/>443/TCP"| K8sAPI

    %% CRD controllers
    K8sAPI -.->|"watches"| KubeflowNotebook
    K8sAPI -.->|"watches"| KServe
    K8sAPI -.->|"watches"| DSPOperator
    K8sAPI -.->|"watches"| TrainingOp
    K8sAPI -.->|"watches"| RHODSOp

    %% Direct service calls
    ModelReg -->|"REST API<br/>8080/TCP"| ModelRegSvc
    ModelReg -->|"port-forward"| PortFwd
    PlannerComposite -->|"REST API<br/>8000/TCP"| PlannerBackend

    %% Composite dependencies on domain plugins
    ClusterComposite -.->|"aggregates"| DomainPlugins
    TrainingComposite -.->|"orchestrates"| Training

    %% Styling
    style MCPServer fill:#e8f0fe,stroke:#1a73e8,stroke-width:2px
    style Core fill:#d5e8d4,stroke:#82b366
    style Auth fill:#ffe6cc,stroke:#d79b00
    style Utils fill:#f5f5f5,stroke:#999
    style DomainPlugins fill:#dae8fc,stroke:#6c8ebf
    style CompositePlugins fill:#e1d5e7,stroke:#9673a6

    style AIAgent fill:#f9f9f9,stroke:#333,stroke-width:2px
    style OIDCProvider fill:#fff2cc,stroke:#d6b656
    style K8sAPI fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style KubeflowNotebook fill:#e8e8e8,stroke:#999
    style KServe fill:#e8e8e8,stroke:#999
    style DSPOperator fill:#e8e8e8,stroke:#999
    style TrainingOp fill:#e8e8e8,stroke:#999
    style ModelRegSvc fill:#e8e8e8,stroke:#999
    style PlannerBackend fill:#e8e8e8,stroke:#999
    style RHODSOp fill:#e8e8e8,stroke:#999
