graph LR
    OVMS["OpenVINO Model Server<br/>(OVMS)"]

    %% Core Runtime Dependencies (Required)
    OVMS -->|"core inference engine"| OVRuntime["OpenVINO Runtime<br/>2026.2"]
    OVMS -->|"LLM/image/audio gen"| OVGenAI["OpenVINO GenAI<br/>2026.2"]
    OVMS -->|"tokenization"| OVTokenizers["OpenVINO Tokenizers<br/>2026.2"]
    OVMS -->|"image preprocessing"| OpenCV["OpenCV<br/>4.13.0"]
    OVMS -->|"C++ utilities"| Boost["Boost<br/>1.68.0"]

    %% Embedded Framework Dependencies (Required)
    OVMS -->|"pipeline composition"| MediaPipe["MediaPipe<br/>(embedded)"]
    OVMS -->|"HTTP server"| Drogon["Drogon<br/>(embedded)"]
    OVMS -->|"gRPC server"| gRPC["gRPC<br/>(embedded)"]
    OVMS -->|"metrics"| PromCpp["Prometheus C++<br/>(embedded)"]
    OVMS -->|"JSON parsing"| RapidJSON["RapidJSON<br/>(embedded)"]
    OVMS -->|"XML parsing"| pugixml["pugixml<br/>1.13"]

    %% Optional Dependencies
    OVMS -.->|"Azure storage"| AzureSDK["Azure Storage C++ SDK<br/>7.5.0"]
    OVMS -.->|"chat templates"| Python["Python 3.12<br/>+ Jinja2 3.1.6"]
    OVMS -.->|"GPU acceleration"| IntelGPU["Intel GPU Drivers<br/>25.05.32567"]

    %% Internal RHOAI Platform Dependencies
    KServe["KServe<br/>InferenceService"] -->|"manages container"| OVMS
    KRBAC["kube-rbac-proxy"] -->|"auth sidecar"| OVMS
    Gateway["Platform Ingress<br/>(Gateway API / Envoy)"] -->|"routes traffic"| OVMS

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes /metrics"| OVMS

    %% External Cloud Services
    OVMS -->|"model storage<br/>HTTPS/443"| S3["Amazon S3"]
    OVMS -->|"model storage<br/>HTTPS/443"| Azure["Azure Blob Storage"]
    OVMS -->|"model storage<br/>HTTPS/443"| GCS["Google Cloud Storage"]
    OVMS -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]

    %% Build Dependencies
    OVMS -.->|"build system"| Bazel["Bazel<br/>6.1.1"]

    %% Styling
    style OVMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core runtime (purple)
    style OVRuntime fill:#9013fe,stroke:#333,color:#fff
    style OVGenAI fill:#9013fe,stroke:#333,color:#fff
    style OVTokenizers fill:#9013fe,stroke:#333,color:#fff
    style OpenCV fill:#9013fe,stroke:#333,color:#fff
    style Boost fill:#9013fe,stroke:#333,color:#fff

    %% Embedded frameworks (dark blue)
    style MediaPipe fill:#2c3e50,stroke:#333,color:#fff
    style Drogon fill:#2c3e50,stroke:#333,color:#fff
    style gRPC fill:#2c3e50,stroke:#333,color:#fff
    style PromCpp fill:#2c3e50,stroke:#333,color:#fff
    style RapidJSON fill:#2c3e50,stroke:#333,color:#fff
    style pugixml fill:#2c3e50,stroke:#333,color:#fff

    %% Optional (light gray)
    style AzureSDK fill:#bdc3c7,stroke:#333
    style Python fill:#bdc3c7,stroke:#333
    style IntelGPU fill:#bdc3c7,stroke:#333
    style Bazel fill:#bdc3c7,stroke:#333

    %% Internal RHOAI (green)
    style KServe fill:#7ed321,stroke:#333
    style KRBAC fill:#7ed321,stroke:#333
    style Gateway fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333

    %% External cloud (orange)
    style S3 fill:#f5a623,stroke:#333
    style Azure fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
