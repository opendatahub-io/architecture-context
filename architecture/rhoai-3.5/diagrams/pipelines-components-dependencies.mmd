graph LR
    PC["pipelines-components<br/>(KFP Component Library)"]

    %% External Dependencies (Python/ML)
    PC -->|"pipeline SDK"| KFP["KFP SDK >= 2.16.1"]
    PC -->|"K8s extensions"| KFPKube["kfp-kubernetes >= 2.16.1"]
    PC -->|"AutoML training"| AutoGluon["AutoGluon 1.5.0+rhaiv.5"]
    PC -->|"RAG optimization"| ai4rag["ai4rag ~= 0.10.1"]
    PC -->|"doc extraction"| Docling["docling >= 2.72.0"]
    PC -->|"LLM evaluation"| LMEval["lm-evaluation-harness >= 0.4.0"]
    PC -->|"fine-tuning"| ILab["instructlab-training >= 0.1.0"]
    PC -->|"S3 client"| Boto3["boto3 >= 1.42.34"]
    PC -->|"deep learning"| Torch["torch >= 2.11.0"]
    PC -->|"model loading"| Transformers["transformers >= 5.14.1"]
    PC -->|"synthetic data"| SDGHub["sdg-hub >= 0.7.0"]
    PC -->|"serialization"| Protobuf["protobuf < 6.32"]
    PC -->|"TLS/crypto"| Crypto["cryptography >= 49.0.0"]

    %% Internal RHOAI Dependencies
    PC -->|"init container mount"| DSPOperator["data-science-pipelines-<br/>operator"]
    PC -->|"shared volume"| KFPServer["KFP API Server"]
    PC -->|"InferenceService CR"| KServe["KServe / vLLM"]
    PC -->|"REST API"| ModelReg["Kubeflow Model Registry"]
    PC -->|"gRPC/19530"| Milvus["Milvus"]
    PC -->|"RayJob CR"| KubeRay["KubeRay"]
    PC -->|"LocalQueue annotation"| Kueue["Kueue"]
    PC -->|"REST API"| EvalHub["EvalHub"]
    PC -->|"REST API"| OGXAPI["OGX API"]
    PC -->|"REST API"| Connections["RHOAI Connections API"]

    %% Integration points (other components depending on pipelines-components)
    DSPOperator -->|"deploys init container"| PC

    %% External Services
    PC -->|"model storage"| S3["S3 / MinIO"]
    PC -->|"model downloads"| HFHub["HuggingFace Hub"]
    PC -->|"LLM inference"| LiteLLM["LiteLLM"]
    PC -->|"API server"| K8sAPI["Kubernetes API"]
    PC -->|"training backend"| CTR["ClusterTrainingRuntime"]

    %% Styling
    style PC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External Python/ML dependencies
    style KFP fill:#999,stroke:#333
    style KFPKube fill:#999,stroke:#333
    style AutoGluon fill:#999,stroke:#333
    style ai4rag fill:#999,stroke:#333
    style Docling fill:#999,stroke:#333
