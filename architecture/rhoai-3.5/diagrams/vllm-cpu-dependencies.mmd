graph LR
    vLLM["vLLM CPU<br/>Inference Service"]

    %% Core Runtime Dependencies
    vLLM -->|"model execution"| PyTorch["PyTorch 2.11.0+cpu"]
    vLLM -->|"model loading<br/>tokenization"| Transformers["transformers >= 5.6.0"]
    vLLM -->|"weight serialization<br/>MXFP4/MXFP6"| Safetensors["safetensors >= 0.6.2"]
    vLLM -->|"quantized weights"| CompressedTensors["compressed-tensors 0.17.1"]

    %% Server Framework
    vLLM -->|"HTTP API"| FastAPI["FastAPI >= 0.133.0"]
    vLLM -->|"ASGI server"| Uvicorn["Uvicorn"]
    vLLM -->|"event loop"| Uvloop["uvloop"]

    %% gRPC
    vLLM -->|"gRPC server"| gRPCio["grpcio >= 1.76.0"]
    vLLM -->|"serialization"| Protobuf["protobuf >= 5.29.6"]

    %% Rust Frontend
    vLLM -->|"tokenizer, chat<br/>templates, parsers"| RustToolchain["Rust 1.95 stable"]

    %% Observability
    vLLM -->|"metrics"| PromClient["prometheus_client >= 0.18.0"]
    vLLM -.->|"tracing (optional)"| OTelSDK["OpenTelemetry SDK >= 1.27.0"]

    %% System
    vLLM -->|"TLS"| OpenSSL["OpenSSL (UBI 9)"]
    vLLM -->|"hashing (default)"| Blake3["blake3"]

    %% Optional/Platform-specific
    vLLM -.->|"CPU optimizations<br/>(x86_64 only)"| IPEX["Intel Extension<br/>for PyTorch 2.7.0"]

    %% Internal RHOAI Platform Dependencies
    KServe["KServe"] -->|"deploys as<br/>InferenceService"| vLLM
    Dashboard["ODH Dashboard"] -->|"UI management"| KServe
    PlatformGW["Platform Gateway<br/>(rhods-operator)"] -->|"routes traffic<br/>HTTPRoute/Route"| vLLM

    %% Integration Points
    vLLM -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>HTTP/8000"| vLLM
    vLLM -.->|"OTLP traces<br/>gRPC/4317"| OTelCollector["OpenTelemetry<br/>Collector"]
    vLLM -->|"API standards"| ModelHosting["model-hosting-<br/>container-standards"]

    %% Styling
    style vLLM fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps (grey)
    style PyTorch fill:#999,stroke:#333,color:#fff
    style Transformers fill:#999,stroke:#333,color:#fff
    style Safetensors fill:#999,stroke:#333,color:#fff
    style CompressedTensors fill:#999,stroke:#333,color:#fff
    style FastAPI fill:#999,stroke:#333,color:#fff
