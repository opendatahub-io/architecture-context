graph LR
    TrustyAI["TrustyAI<br/>Explainability"]

    %% External Dependencies (Required)
    TrustyAI -->|"app framework"| Quarkus["Quarkus 3.8.5"]
    TrustyAI -->|"metrics publishing"| Micrometer["Micrometer<br/>(Quarkus managed)"]
    TrustyAI -->|"gRPC transport"| gRPC["gRPC Netty 1.75.0"]
    TrustyAI -->|"serialization"| Protobuf["Protocol Buffers 3.25.5"]
    TrustyAI -->|"constraint solver"| OptaPlanner["OptaPlanner 8.30.0"]
    TrustyAI -->|"JSON"| Jackson["Jackson 2.15.0"]
    TrustyAI -->|"network transport"| Netty["Netty 4.1.125"]

    %% External Dependencies (Optional)
    TrustyAI -.->|"ORM (optional)"| Hibernate["Hibernate ORM 6.2.13"]
    TrustyAI -.->|"Arrow IPC (optional)"| Arrow["Apache Arrow 15.0.2"]
    TrustyAI -.->|"NLP (optional)"| OpenNLP["Apache OpenNLP 1.9.2"]
    TrustyAI -.->|"S3 client (optional)"| MinIOClient["Quarkus MinIO 3.3.1"]

    %% Internal Platform Dependencies
    TrustyAI -->|"inference payloads<br/>REST + CloudEvents"| KServeModelMesh["KServe / ModelMesh"]
    TrustyAI -->|"model queries<br/>gRPC/HTTP"| KServeServers["KServe Inference<br/>Servers"]
    TrustyAI -->|"trustyai_* gauges<br/>scraped"| Prometheus["Prometheus"]

    %% Operator manages TrustyAI
    Operator["TrustyAI Service<br/>Operator"] -->|"deploys & manages"| TrustyAI

    %% Integration Points (inbound)
    Dashboard["ODH Dashboard /<br/>User"] -->|"REST API"| TrustyAI

    %% Storage backends
    TrustyAI -->|"default storage"| PVC["PVC (/inputs)"]
    TrustyAI -.->|"optional storage"| Database["MariaDB / MySQL<br/>PostgreSQL"]
    TrustyAI -.->|"optional storage"| MinIO["MinIO"]

    %% Kubernetes
    TrustyAI -->|"ConfigMap CRUD<br/>HTTPS/443"| K8sAPI["Kubernetes API"]

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external deps
    style Quarkus fill:#999,stroke:#333,color:#fff
    style Micrometer fill:#999,stroke:#333,color:#fff
    style gRPC fill:#999,stroke:#333,color:#fff
    style Protobuf fill:#999,stroke:#333,color:#fff
    style OptaPlanner fill:#999,stroke:#333,color:#fff
    style Jackson fill:#999,stroke:#333,color:#fff
    style Netty fill:#999,stroke:#333,color:#fff

    %% Optional external deps
    style Hibernate fill:#bbb,stroke:#333,color:#fff
    style Arrow fill:#bbb,stroke:#333,color:#fff
    style OpenNLP fill:#bbb,stroke:#333,color:#fff
    style MinIOClient fill:#bbb,stroke:#333,color:#fff

    %% Internal platform
    style KServeModelMesh fill:#7ed321,stroke:#333,color:#fff
    style KServeServers fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style Operator fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% Storage
    style PVC fill:#f5a623,stroke:#333,color:#fff
    style Database fill:#f5a623,stroke:#333,color:#fff
    style MinIO fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
