graph TB
    subgraph MLflowOperator["MLflow Operator"]
        direction TB

        subgraph Controllers["Controllers"]
            MLflowCtrl["MLflow Controller<br/><i>Watches MLflow CRs</i><br/><i>Renders Helm chart</i><br/><i>Applies resources via SSA</i>"]
            ModuleCtrl["MLflowOperator Controller<br/><i>Platform module handoff</i><br/><i>Gateway config projection</i><br/><i>Release status tracking</i>"]
            NSRBACCtrl["Namespace RBAC Controller<br/><i>Watches labeled Namespaces</i><br/><i>Reconciles view/edit RoleBindings</i>"]
        end

        HelmRenderer["Helm Renderer<br/><i>CR spec → Helm values</i><br/><i>Template rendering</i><br/><i>Unstructured K8s objects</i>"]

        MLflowCtrl -->|renders via| HelmRenderer
    end

    %% CRDs
    MLflowCR["MLflow CR<br/><i>mlflow.opendatahub.io/v1</i><br/>(Cluster-scoped)"]
    MLflowOpCR["MLflowOperator CR<br/><i>components.platform.opendatahub.io/v1alpha1</i><br/>(Cluster-scoped)"]
    MLflowConfigCR["MLflowConfig CR<br/><i>mlflow.kubeflow.org/v1</i><br/>(Namespaced)"]
    AuthCR["Auth CR<br/><i>services.platform.opendatahub.io</i>"]

    %% Watches
    MLflowCR -->|watched by| MLflowCtrl
    MLflowOpCR -->|watched by| ModuleCtrl
    MLflowConfigCR -->|watched by| MLflowCtrl
    AuthCR -->|watched by| NSRBACCtrl

    %% Created resources
    MLflowCtrl -->|creates via SSA| Deployment["MLflow Deployment"]
    MLflowCtrl -->|creates| Service["MLflow Service<br/>8443/TCP HTTPS"]
    MLflowCtrl -->|creates| HTTPRoute["HTTPRoute<br/><i>Gateway API</i>"]
    MLflowCtrl -->|creates| ConsoleLink["ConsoleLink<br/><i>OpenShift Console</i>"]
    MLflowCtrl -->|creates| NetworkPolicy["NetworkPolicy"]
    MLflowCtrl -->|creates| MigrationJob["Migration Jobs<br/><i>Alembic DB migration</i>"]
    MLflowCtrl -->|creates| CronJobs["CronJobs<br/><i>GC + Trace Archival</i>"]
    NSRBACCtrl -->|creates| RoleBindings["RoleBindings<br/><i>view/edit per workspace</i>"]

    %% External dependencies
    HTTPRoute -->|parent ref| Gateway["data-science-gateway<br/><i>openshift-ingress</i>"]
    Service -.->|TLS cert| ServiceCA["service-ca-operator"]
    MLflowCtrl -->|reads TLS profile| APIServer["OpenShift APIServer CR"]

    %% Probes and metrics
    Probes["Health Probes<br/>8081/TCP"] -.-> MLflowOperator
    Metrics["Metrics<br/>8443/TCP HTTPS"] -.-> MLflowOperator

    %% Styling
    style MLflowOperator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Controllers fill:#bbdefb,stroke:#1565c0,stroke-width:1px
    style MLflowCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ModuleCtrl fill:#4a90e2,stroke:#333,color:#fff
    style NSRBACCtrl fill:#4a90e2,stroke:#333,color:#fff
    style HelmRenderer fill:#64b5f6,stroke:#333,color:#fff
    style MLflowCR fill:#f5a623,stroke:#333
    style MLflowOpCR fill:#f5a623,stroke:#333
    style MLflowConfigCR fill:#f5a623,stroke:#333
    style AuthCR fill:#f5a623,stroke:#333
    style Deployment fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style ConsoleLink fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style MigrationJob fill:#7ed321,stroke:#333
    style CronJobs fill:#7ed321,stroke:#333
    style RoleBindings fill:#7ed321,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style ServiceCA fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style Probes fill:#f0f0f0,stroke:#999
    style Metrics fill:#f0f0f0,stroke:#999
