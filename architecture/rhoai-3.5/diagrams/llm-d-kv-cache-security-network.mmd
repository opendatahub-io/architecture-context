graph TB
    subgraph External["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>TLS 1.2+<br/>Bearer Token (optional)"]
    end

    subgraph PodBoundary["POD BOUNDARY (llm-d-router / EPP Pod)"]
        direction TB

        subgraph TokenizerSidecar["UDS Tokenizer Sidecar"]
            Tokenizer["TokenizationService<br/>gRPC over UDS<br/>/tmp/tokenizer/tokenizer-uds.socket<br/>No encryption, No auth"]
            Health["/healthz<br/>8082/TCP HTTP<br/>No auth"]
        end

        subgraph GoLibrary["Go Library (embedded)"]
            Indexer["kvcache.Indexer"]
            Pool["kvevents.Pool<br/>Sharded ZMQ consumer"]
            Index["kvblock.Index<br/>In-memory LRU / Ristretto"]
        end

        Indexer -->|"gRPC (UDS)<br/>No encryption"| Tokenizer
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Pod Network)"]
        direction TB

        subgraph InferencePods["Inference Engine Pods"]
            vLLM["vLLM / SGLang Pods<br/>KV-cache event source"]
        end

        subgraph DataServices["Data Services"]
            Redis["Redis / Valkey<br/>6379/TCP<br/>TLS optional (rediss://)<br/>URL credentials"]
        end

        subgraph Observability["Observability"]
            OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>No encryption<br/>No auth"]
            Prometheus["Prometheus<br/>HTTP scrape<br/>No auth"]
        end

        subgraph Storage["Persistent Storage"]
            subgraph vLLMPod["vLLM Pod"]
                FSBackend["llmd-fs-backend<br/>GPU ↔ Storage"]
                Evictor["PVC Evictor<br/>Disk manager"]
            end
            PVC["Shared PVC<br/>/kv-cache<br/>POSIX I/O<br/>No per-tenant quotas"]
        end

        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
    end

    %% External flows
    Tokenizer -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HFHub

    %% Cluster internal flows
    vLLM -->|"ZMQ/5557<br/>msgpack<br/>NO ENCRYPTION<br/>No auth"| Pool
    Index -.->|"TCP/6379<br/>TLS optional<br/>URL credentials"| Redis
    Indexer -.->|"gRPC/4317<br/>No encryption"| OTLP
    Pool -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Storage flows
    FSBackend -->|"POSIX I/O<br/>No encryption"| PVC
    Evictor -->|"xargs rm -f<br/>POSIX"| PVC
    FSBackend -->|"ZMQ/5557<br/>No encryption"| Pool

    %% Styling
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef podboundary fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tokenizer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef golib fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef internal fill:#f5f5f5,stroke:#666,stroke-width:1px
    classDef danger fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef storage fill:#f5a623,stroke:#333,stroke-width:2px,color:#fff

    class HFHub external
    class Tokenizer,Health tokenizer
    class Indexer,Pool,Index golib
    class vLLM,Redis,OTLP,Prometheus,K8sAPI internal
    class PVC,FSBackend,Evictor storage
