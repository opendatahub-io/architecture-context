graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Platform Admin<br/>(Helm Client)"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-operator)"]
        direction TB
        Operator["rhai-operator<br/>SA: rhai-operator-controller-manager<br/>CR: rhai-operator-role"]
        Metrics["Metrics Service<br/>8443/TCP HTTPS<br/>kube-rbac-proxy"]
        Webhook["Webhook Service<br/>443→9443/TCP HTTPS<br/>cert-manager TLS"]
    end

    subgraph HookJobs["POST-INSTALL HOOKS (xKS)"]
        CRsJob["post-install-crs Job<br/>SA: rhai-post-install-hook<br/>Image: ose-cli"]
        GatewayJob["post-install-gateway Job<br/>SA: rhai-post-install-hook<br/>Image: ose-cli"]
    end

    subgraph GatewayLayer["INFERENCE GATEWAY LAYER"]
        InferenceGW["Inference Gateway<br/>openshift-ai-inference<br/>80,443/TCP HTTP/HTTPS<br/>TLS Terminate<br/>cert-manager Certificate"]
        MaaSGW["MaaS Gateway<br/>maas-gateway-class<br/>80,443/TCP HTTP/HTTPS<br/>TLS Terminate<br/>Authorino AuthPolicy"]
    end

    subgraph Dependencies["DEPENDENCY OPERATORS"]
        direction TB
        CertMgr["cert-manager<br/>(TLS provisioning)"]
        Kueue["Kueue<br/>(Job queue)"]
        RHCL["RHCL / Kuadrant<br/>(API mgmt + auth)"]
        Authorino["Authorino<br/>(AuthN/AuthZ)"]
        Sail["Sail / Istio<br/>(Service mesh + Gateway API)"]
        LWS["Leader Worker Set<br/>(Distributed inference)"]
        JobSet["JobSet<br/>(Job management)"]
        NFD["NFD<br/>(Hardware discovery)"]
        NVIDIA["NVIDIA GPU Operator<br/>(GPU enablement)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OLMCatalog["OLM Catalog Sources<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No auth"]
        BuildConfig["RHOAI-Build-Config<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GitHub App token"]
        ODHBuild["ODH-Build-Config<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GitHub App token"]
    end

    %% Flows
    Admin -->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig creds"| K8sAPI

    K8sAPI -->|"CR creation<br/>RBAC auth"| Operator
    K8sAPI -->|"Job launch<br/>SA token"| CRsJob
    K8sAPI -->|"Job launch<br/>SA token"| GatewayJob

    Operator -->|"HTTPS/443<br/>TLS<br/>Webhook cert"| Webhook
    Operator -->|"HTTPS/8443<br/>TLS<br/>SA Bearer token"| Metrics

    CRsJob -->|"HTTPS<br/>TLS 1.2+<br/>SA token"| K8sAPI
    GatewayJob -->|"HTTPS<br/>TLS 1.2+<br/>SA token"| K8sAPI
    GatewayJob -->|"Secret read<br/>RBAC"| CertMgr

    Operator -.->|"reconciles"| InferenceGW
    Operator -.->|"reconciles"| MaaSGW

    CertMgr -.->|"provisions TLS"| InferenceGW
    CertMgr -.->|"provisions TLS"| MaaSGW
    Sail -.->|"implements GatewayClass"| InferenceGW
    Sail -.->|"implements GatewayClass"| MaaSGW
    RHCL -.->|"AuthPolicy"| MaaSGW

    K8sAPI -->|"OLM Subscriptions<br/>OpenShift only"| OLMCatalog
    Operator -->|"helm-sync.yml<br/>GitHub App token"| BuildConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    classDef operatorns fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    classDef hooks fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    classDef gateway fill:#fce4ec,stroke:#e91e63,stroke-width:2px
    classDef deps fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
    classDef extservice fill:#fff9c4,stroke:#f9a825,stroke-width:2px

    class Admin external
    class K8sAPI controlplane
    class Operator,Metrics,Webhook operatorns
    class CRsJob,GatewayJob hooks
    class InferenceGW,MaaSGW gateway
    class CertMgr,Kueue,RHCL,Authorino,Sail,LWS,JobSet,NFD,NVIDIA deps
    class OLMCatalog,BuildConfig,ODHBuild extservice
