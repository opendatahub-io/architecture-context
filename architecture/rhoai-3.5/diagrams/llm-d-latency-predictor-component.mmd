graph TB
    subgraph LLP["llm-d-latency-predictor"]
        direction TB

        subgraph TrainingServer["Training Server (port 8000)"]
            TrainAPI["FastAPI<br/>Training API"]
            DataIngestion["Data Ingestion<br/>/add_training_data_bulk"]
            Trainer["Background Trainer<br/>Retraining every 1800s"]
            ModelStore["Model Store<br/>PVC /models/"]
            MetricsEndpoint["Metrics Endpoint<br/>/metrics"]

            TrainAPI --> DataIngestion
            DataIngestion -->|accumulates samples| Trainer
            Trainer -->|writes joblib files| ModelStore
            TrainAPI -->|serves model downloads| ModelStore
        end

        subgraph PredictionServer["Prediction Server (port 8001)"]
            PredictAPI["FastAPI<br/>Prediction API"]
            ModelSync["Model Sync Thread<br/>every 10s"]
            LocalModels["Local Models<br/>emptyDir /local_models/"]
            Ensemble["Gated Ensemble<br/>noqueue / queued<br/>sub-models"]

            ModelSync -->|downloads joblib| LocalModels
            PredictAPI -->|loads| LocalModels
            PredictAPI --> Ensemble
        end

        ModelSync -->|HTTP GET /model/.../download| TrainAPI
    end

    subgraph External["External Callers"]
        InferencePods["llm-d Inference Pods"]
        Router["llm-d Inference Router"]
        Prometheus["Prometheus"]
    end

    InferencePods -->|"POST /add_training_data_bulk<br/>8000/TCP HTTP"| DataIngestion
    Router -->|"POST /predict, /predict/bulk/strict<br/>80/TCP HTTP"| PredictAPI
    Prometheus -->|"GET /metrics<br/>8000/TCP HTTP"| MetricsEndpoint

    style TrainingServer fill:#4a90e2,stroke:#333,color:#fff
    style PredictionServer fill:#50c878,stroke:#333,color:#fff
    style TrainAPI fill:#6baed6,stroke:#333,color:#fff
    style PredictAPI fill:#74d49e,stroke:#333,color:#fff
    style DataIngestion fill:#6baed6,stroke:#333,color:#fff
    style Trainer fill:#6baed6,stroke:#333,color:#fff
    style ModelStore fill:#f5a623,stroke:#333,color:#000
    style MetricsEndpoint fill:#6baed6,stroke:#333,color:#fff
    style ModelSync fill:#74d49e,stroke:#333,color:#fff
    style LocalModels fill:#f5a623,stroke:#333,color:#000
    style Ensemble fill:#74d49e,stroke:#333,color:#fff
    style InferencePods fill:#e8e8e8,stroke:#333,color:#000
    style Router fill:#e8e8e8,stroke:#333,color:#000
    style Prometheus fill:#e8e8e8,stroke:#333,color:#000
