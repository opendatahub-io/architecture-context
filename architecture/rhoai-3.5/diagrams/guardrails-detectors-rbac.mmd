graph TD
    subgraph Note["RBAC Model"]
        direction TB
        Info["Note: No RBAC manifests in repository.<br/>RBAC is fully managed by KServe and the<br/>RHOAI platform operator for InferenceService deployments."]
    end

    subgraph KServeManaged["KServe-Managed RBAC"]
        direction TB

        subgraph AuthConfig["Authentication Configuration"]
            AuthAnnotation["InferenceService Annotation<br/>security.opendatahub.io/enable-auth: true"]
            IstioSidecar["Istio Sidecar Injection<br/>sidecar.istio.io/inject: true"]
        end

        subgraph Enforcement["Enforcement Points"]
            IstioMTLS["Istio mTLS STRICT<br/>(Service Mesh PeerAuthentication)"]
            KServeAuth["KServe Auth Policy<br/>(InferenceService-level)"]
        end

        AuthAnnotation -->|enables| KServeAuth
        IstioSidecar -->|enables| IstioMTLS
    end

    subgraph Secrets["Secrets"]
        direction TB
        AWSSecret["aws-connection-*<br/>Type: Opaque<br/>Keys: AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY"]
        SecretSource["Provisioned By:<br/>User via RHOAI Dashboard<br/>Data Connection"]
        AWSSecret ---|provisioned by| SecretSource
    end

    subgraph Endpoints["Endpoint Access Matrix"]
        direction TB
        DetectorAPI["/api/v1/text/contents<br/>POST<br/>Auth: Istio mTLS + KServe"]
        GenerationAPI["/api/v1/text/generation<br/>POST (Judge only)<br/>Auth: Istio mTLS + KServe"]
        HealthAPI["/health<br/>GET<br/>Auth: None (open)"]
        MetricsAPI["/metrics<br/>GET<br/>Auth: None (Prometheus)"]
        RegistryAPI["/registry<br/>GET (builtIn only)<br/>Auth: None (open)"]
    end

    IstioMTLS -->|protects| DetectorAPI
    IstioMTLS -->|protects| GenerationAPI
    KServeAuth -->|enforces| DetectorAPI
    KServeAuth -->|enforces| GenerationAPI

    AWSSecret -->|used by| HFDetector["HuggingFace Detector<br/>(S3 model access)"]

    style Info fill:#fff3cd,stroke:#856404,color:#856404
    style AuthAnnotation fill:#d4edda,stroke:#155724
    style IstioSidecar fill:#d4edda,stroke:#155724
    style IstioMTLS fill:#f5a623,color:#fff
    style KServeAuth fill:#f5a623,color:#fff
    style AWSSecret fill:#cce5ff,stroke:#004085
    style DetectorAPI fill:#d5e8d4,stroke:#82b366
    style GenerationAPI fill:#d5e8d4,stroke:#82b366
    style HealthAPI fill:#e8e8e8,stroke:#999
    style MetricsAPI fill:#e8e8e8,stroke:#999
    style RegistryAPI fill:#e8e8e8,stroke:#999
    style HFDetector fill:#4a90e2,color:#fff
