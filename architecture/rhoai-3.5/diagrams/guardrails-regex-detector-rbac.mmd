graph TD
    subgraph "Guardrails Regex Detector - RBAC"
        direction TB

        Note["No RBAC Configuration Defined"]

        subgraph "Service Identity"
            SA["ServiceAccount<br/>(default or assigned)<br/>No specific permissions"]
        end

        subgraph "Security Posture"
            NoRoles["No ClusterRoles"]
            NoBindings["No RoleBindings"]
            NoSecrets["No Secrets consumed"]
        end

        subgraph "Access Control"
            NoAuth["No Authentication<br/>at application level"]
            NoAuthZ["No Authorization<br/>at application level"]
            NetworkIsolation["Relies on:<br/>- Kubernetes NetworkPolicy<br/>- Service mesh mTLS<br/>- Orchestrator-mediated access"]
        end

        SA --- NoRoles
        SA --- NoBindings
        SA --- NoSecrets
        NoAuth --- NetworkIsolation
        NoAuthZ --- NetworkIsolation
    end

    subgraph "Authentication Flow"
        Client["FMS Guardrails<br/>Orchestrator"]
        Endpoint["POST /api/v1/text/contents<br/>No Auth Required"]
        Health["GET /health<br/>No Auth Required"]

        Client -->|"Unauthenticated<br/>HTTP Request"| Endpoint
        Client -->|"Unauthenticated<br/>HTTP Request"| Health
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style NoRoles fill:#f8cecc,stroke:#b85450
    style NoBindings fill:#f8cecc,stroke:#b85450
    style NoSecrets fill:#d5e8d4,stroke:#82b366
    style NoAuth fill:#f8cecc,stroke:#b85450
    style NoAuthZ fill:#f8cecc,stroke:#b85450
    style NetworkIsolation fill:#fff2cc,stroke:#d6b656
    style Client fill:#7ed321,stroke:#333
    style Endpoint fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
