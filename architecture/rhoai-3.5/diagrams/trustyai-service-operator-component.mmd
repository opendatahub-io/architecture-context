graph TB
    subgraph Operator["TrustyAI Service Operator"]
        direction TB
        Main["main.go<br/>--enable-services flag"]
        Registry["Service Registry<br/>controllers/controllers.go"]
        Main -->|registers| Registry

        subgraph TAS_Controller["TAS Controller"]
            TASCtrl["TrustyAIService Controller"]
            TASDeployment["Deployment Builder"]
            TASRoute["Route Builder"]
            TASIstio["Istio Resource Builder"]
            TASCtrl --> TASDeployment
            TASCtrl --> TASRoute
            TASCtrl --> TASIstio
        end

        subgraph LMES_Controller["LMES Controller"]
            LMESCtrl["LMEvalJob Controller"]
            LMESPod["Pod Builder"]
            LMESKueue["Kueue Integration"]
            LMESCtrl --> LMESPod
            LMESCtrl --> LMESKueue
        end

        subgraph EvalHub_Controller["EvalHub Controller"]
            EHCtrl["EvalHub Controller"]
            EHTenant["Tenant Manager"]
            EHMCP["MCP Server"]
            EHFailure["Job Failure Reconciler"]
            EHKueue["Kueue Workload Watcher"]
            EHCtrl --> EHTenant
            EHCtrl --> EHMCP
            EHCtrl --> EHFailure
            EHCtrl --> EHKueue
        end

        subgraph GORCH_Controller["GORCH Controller"]
            GORCHCtrl["GuardrailsOrchestrator Controller"]
            GORCHConfig["Auto-Config Generator"]
            GORCHCtrl --> GORCHConfig
        end

        subgraph NEMO_Controller["NemoGuardrails Controller"]
            NEMOCtrl["NemoGuardrails Controller"]
            NEMOEnvoy["EnvoyFilter Manager"]
            NEMOMCP["MCP Gateway Discovery"]
            NEMOCtrl --> NEMOEnvoy
            NEMOCtrl --> NEMOMCP
        end

        subgraph Module_Controller["Module Controller"]
            ModCtrl["TrustyAI Module Controller"]
        end

        Registry --> TASCtrl
        Registry --> LMESCtrl
        Registry --> EHCtrl
        Registry --> GORCHCtrl
        Registry --> NEMOCtrl
        Registry --> ModCtrl
    end

    %% CRDs
    TrustyAIServiceCR["TrustyAIService CR<br/>trustyai.opendatahub.io/v1"]
    LMEvalJobCR["LMEvalJob CR<br/>trustyai.opendatahub.io/v1alpha1"]
    EvalHubCR["EvalHub CR<br/>trustyai.opendatahub.io/v1"]
    GORCHCR["GuardrailsOrchestrator CR<br/>trustyai.opendatahub.io/v1alpha1"]
    NEMOCR["NemoGuardrails CR<br/>trustyai.opendatahub.io/v1alpha1"]
    TrustyAICR["TrustyAI CR<br/>components.platform.opendatahub.io/v1alpha1"]

    TrustyAIServiceCR -->|watched by| TASCtrl
    LMEvalJobCR -->|watched by| LMESCtrl
    EvalHubCR -->|watched by| EHCtrl
    GORCHCR -->|watched by| GORCHCtrl
    NEMOCR -->|watched by| NEMOCtrl
    TrustyAICR -->|watched by| ModCtrl

    %% Deployed Workloads
    TASCtrl -->|creates| TASPod["TrustyAI Service Pod<br/>+ kube-rbac-proxy sidecar"]
    LMESCtrl -->|creates| LMESPodW["LMEvalJob Pod<br/>ta-lmes-driver init container"]
    EHCtrl -->|creates| EHPod["EvalHub Pod<br/>API + MCP servers"]
    GORCHCtrl -->|creates| GORCHPod["Guardrails Orchestrator Pod<br/>+ gateway + detectors"]
    NEMOCtrl -->|creates| NEMOPod["NeMo Guardrails Pod<br/>+ kube-rbac-proxy sidecar"]

    %% External dependencies
    KServe["KServe<br/>InferenceServices"]
    Kueue["Kueue<br/>Workload Scheduling"]
    Istio["Istio/Service Mesh<br/>DestinationRules, EnvoyFilters"]
    OSRouter["OpenShift Router<br/>Routes"]
    ConfigMap["Operator ConfigMap<br/>Image Resolution"]

    TASCtrl -->|patches| KServe
    GORCHConfig -->|reads| KServe
    LMESKueue -->|creates| Kueue
    EHKueue -->|watches| Kueue
    TASIstio -->|creates| Istio
    NEMOEnvoy -->|manages| Istio
    TASRoute -->|creates| OSRouter
    Main -->|reads| ConfigMap

    %% Styling
    style Operator fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style TAS_Controller fill:#d5e8d4,stroke:#82b366
    style LMES_Controller fill:#d5e8d4,stroke:#82b366
    style EvalHub_Controller fill:#d5e8d4,stroke:#82b366
    style GORCH_Controller fill:#d5e8d4,stroke:#82b366
    style NEMO_Controller fill:#d5e8d4,stroke:#82b366
    style Module_Controller fill:#d5e8d4,stroke:#82b366
    style TrustyAIServiceCR fill:#f5a623,stroke:#d79b00
    style LMEvalJobCR fill:#f5a623,stroke:#d79b00
    style EvalHubCR fill:#f5a623,stroke:#d79b00
    style GORCHCR fill:#f5a623,stroke:#d79b00
    style NEMOCR fill:#f5a623,stroke:#d79b00
    style TrustyAICR fill:#f5a623,stroke:#d79b00
    style KServe fill:#e8e8e8,stroke:#999
    style Kueue fill:#e8e8e8,stroke:#999
    style Istio fill:#e8e8e8,stroke:#999
    style OSRouter fill:#e8e8e8,stroke:#999
    style ConfigMap fill:#fff2cc,stroke:#d6b656
