graph TD
    subgraph "Authentication Mechanisms (5 Layers)"
        OAuth["OAuth2/OIDC<br/>kube-auth-proxy at Gateway<br/>OpenShift OAuth + external OIDC"]
        KuadrantAuth["Kuadrant AuthPolicy<br/>Authorino-backed per-HTTPRoute<br/>anonymous / user-defined / API key"]
        SubjAccessReview["SubjectAccessReview<br/>kube-rbac-proxy sidecar<br/>RBAC enforcement"]
        mTLSAuth["mTLS Certificates<br/>Istio sidecar-to-sidecar<br/>Auto-rotated by Istiod"]
        BearerAuth["Bearer Tokens<br/>MaaS API keys, MLflow, KubeRay,<br/>LMEval, OGX, RHOAI MCP Server"]
        SATokenAuth["ServiceAccount Tokens<br/>Bound tokens, projected volumes<br/>K8s API access"]
    end

    subgraph "Gateway Authentication Stack"
        GWExtAuthz["Gateway ext_authz<br/>EnvoyFilter calling kube-auth-proxy<br/>All Gateway-routed services"]
        GWAuthPolicy["Kuadrant AuthPolicy<br/>Per-HTTPRoute authorization<br/>KServe, MaaS, odh-model-controller"]
        GWExtProc["Gateway ext_proc<br/>llm-d Router endpoint selection<br/>gRPC/9002"]
    end

    subgraph "kube-rbac-proxy Sidecar Deployments (11+ components)"
        KRBP1["KubeRay Operator<br/>Port: 8443/TCP"]
        KRBP2["Kubeflow Notebook Controller<br/>Port: 8443/TCP"]
        KRBP3["odh-dashboard<br/>Port: 8443/TCP"]
        KRBP4["TrustyAI Service Operator<br/>Port: 8443/TCP"]
        KRBP5["EvalHub<br/>Port: 8443/TCP"]
        KRBP6["DSPO API Server<br/>Port: 8443/TCP"]
        KRBP7["DSPO MLMD Envoy<br/>Port: 8443/TCP"]
        KRBP8["odh-model-controller<br/>Port: 8443/TCP"]
        KRBP9["Model Registry Operator<br/>Port: 8443/TCP"]
        KRBP10["MLflow Operator<br/>Port: 8443/TCP"]
        KRBP11["rhods-operator<br/>Port: 8443/TCP"]
    end

    subgraph "FIPS 140 Compliance"
        FIPS1["Go GOFIPS140=v1.0.0<br/>rhods-operator, KServe, AI Gateway Op,<br/>odh-model-controller, MLflow Op, MaaS"]
        FIPS2["Go strictfipsruntime<br/>DSPO, kube-rbac-proxy,<br/>TrustyAI Service Operator"]
        FIPS3["TLS Profile Integration<br/>Derived from OpenShift APIServer<br/>FIPS-compliant cipher suites"]
        FIPSGap["POTENTIAL GAP: llm-d Router EPP<br/>CGO_ENABLED=1 but missing<br/>strictfipsruntime build tag"]
    end

    subgraph "Container Security Patterns"
        CS1["UBI Base Images<br/>177 of 442 Dockerfiles<br/>Certified, vulnerability-scanned"]
        CS2["Distroless / Scratch Images<br/>23 distroless + 7 scratch<br/>KubeRay, Spark, Trainer, kube-rbac-proxy"]
        CS3["Non-root Execution<br/>All operator and service containers<br/>OpenShift SCC enforcement"]
        CS4["Konflux Build Pipeline<br/>Hermetic builds, rpms.lock.yaml,<br/>go.sum/uv.lock reproducibility"]
        CS5["Digest-pinned Images<br/>All 162 shipped images use<br/>SHA256 digest references"]
    end

    subgraph "TLS Configuration"
        TLS1["Webhook TLS<br/>9443/TCP server TLS<br/>cert-manager or self-signed"]
        TLS2["Metrics TLS<br/>8443/TCP via kube-rbac-proxy<br/>Serving certs from service-ca"]
        TLS3["Service-ca TLS<br/>Auto-generated certificates<br/>DSPO, Model Registry, MLflow,<br/>odh-model-controller"]
        TLS4["Istio mTLS<br/>Sidecar-to-sidecar<br/>KServe pods, TrustyAI, GORCH"]
        TLS5["External TLS<br/>443/TCP to S3, registries<br/>TLS 1.2+"]
    end

    subgraph "TLS Bypass Patterns (Risk)"
        TLSSkip1["rhods-operator Gateway<br/>DestinationRule to kube-auth-proxy<br/>InsecureSkipVerify=true"]
        TLSSkip2["DSPO Database Connections<br/>tls=skip-verify<br/>Mitigated by mesh mTLS"]
        TLSSkip3["llm-d Router Data Sources<br/>InsecureSkipVerify=true<br/>Mitigated by mesh mTLS"]
    end

    subgraph "Service Mesh Security (Istio)"
        MeshEnroll["Mesh-enrolled Components<br/>KServe inference pods, TrustyAI,<br/>GORCH, NeMo Guardrails,<br/>odh-model-controller"]
        MeshMTLS["mTLS Mode: Configurable<br/>STRICT or PERMISSIVE per namespace"]
        MeshPolicy["Authorization Policies<br/>Component-specific access controls"]
    end

    subgraph "Disconnected (Air-Gapped) Security"
        Disc1["RELATED_IMAGE_* Pattern<br/>OLM-injected digest-pinned refs<br/>3-tier precedence resolution"]
        Disc2["ImageDigestMirrorSet<br/>Registry mirroring via oc-mirror<br/>No tag-based pulls"]
        Disc3["CA Bundle Aggregation<br/>Platform + user-provided +<br/>service-ca certificates"]
        Disc4["NVIDIA NIM airGapped Mode<br/>Disables all NGC API calls"]
    end

    %% Auth mechanism relationships
    OAuth -->|"enforces at"| GWExtAuthz
    KuadrantAuth -->|"enforces at"| GWAuthPolicy
    SubjAccessReview -->|"enforces via"| KRBP1
    SubjAccessReview -->|"enforces via"| KRBP2
    SubjAccessReview -->|"enforces via"| KRBP3
    SubjAccessReview -->|"enforces via"| KRBP4
    SubjAccessReview -->|"enforces via"| KRBP5
    SubjAccessReview -->|"enforces via"| KRBP6
    SubjAccessReview -->|"enforces via"| KRBP8

    mTLSAuth -->|"enforces via"| MeshMTLS
    MeshMTLS -->|"protects"| MeshEnroll
    MeshPolicy -->|"restricts"| MeshEnroll

    %% TLS relationships
    TLS2 -->|"terminates at"| KRBP1
    TLS2 -->|"terminates at"| KRBP3
    TLS3 -->|"provides certs"| KRBP6
    TLS3 -->|"provides certs"| KRBP8
    TLS4 -->|"via"| MeshMTLS

    %% FIPS
    FIPS3 -->|"configures"| TLS2
    FIPS3 -->|"configures"| TLS1

