graph TB
    subgraph DW["Distributed Workloads Repository"]
        direction TB

        subgraph TestInfra["E2E Test Infrastructure"]
            TestSuite["E2E Test Suite<br/>(Go Test Framework)"]
            SupportLib["Test Support Library<br/>(13 K8s API clients)"]
            TestRunner["Test Runner Image<br/>(Go + oc CLI)"]
            TestSuite --> SupportLib
            TestSuite --> TestRunner
        end

        subgraph RuntimeImages["Runtime Training Images (10 variants)"]
            direction LR
            CUDA121["CUDA 12.1<br/>PyTorch 2.4.1"]
            CUDA124["CUDA 12.4<br/>PyTorch 2.5.1"]
            CUDA128a["CUDA 12.8<br/>PyTorch 2.8.0"]
            CUDA128b["CUDA 12.8<br/>PyTorch 2.9.0"]
            CUDA130["CUDA 13.0<br/>OpenMPI 4.1"]
            ROCm62a["ROCm 6.2<br/>PyTorch 2.4.1"]
            ROCm62b["ROCm 6.2<br/>PyTorch 2.5.1"]
            ROCm64a["ROCm 6.4<br/>PyTorch 2.8.0"]
            ROCm64b["ROCm 6.4<br/>PyTorch 2.9.0"]
            ROCm64MPI["ROCm 6.4<br/>OpenMPI 4.1"]
        end

        subgraph UniversalImages["Universal Training Images (3 variants)"]
            direction LR
            UniCPU["CPU<br/>Training Hub 0.6"]
            UniCUDA["CUDA 13.0<br/>Training Hub 0.6"]
            UniROCm["ROCm 6.4<br/>Training Hub 0.6"]
        end

        subgraph RayImages["Ray Runtime Images (6 variants)"]
            direction LR
            RayCPU["Ray CPU"]
            RayCUDA["Ray CUDA<br/>(4 variants)"]
            RayROCm["Ray ROCm"]
        end

        subgraph Benchmarks["Benchmark Suite"]
            OSU["OSU MPI<br/>Benchmarks"]
            DDPSFT["MPI DDP SFT<br/>Benchmark"]
        end

        subgraph Utilities["Utilities"]
            MinIO["MinIO CLI Image"]
            Notebooks["Example Notebooks"]
        end
    end

    %% External Platform Consumers
    RhodsOp["rhods-operator<br/>(RELATED_IMAGE_* env vars)"]
    RhodsOp -->|resolves images| RuntimeImages
    RhodsOp -->|resolves images| UniversalImages

    %% Test Suite validates all image types
    TestSuite -->|validates| RuntimeImages
    TestSuite -->|validates| UniversalImages
    TestSuite -->|validates| RayImages
    TestSuite -->|validates| Benchmarks

    %% External CRD Operators consumed
    KFTO["Kubeflow Training<br/>Operator"]
    TrainerV2["Kubeflow Trainer v2"]
    KubeRay["KubeRay Operator"]
    KueueOp["Kueue"]

    TestSuite -->|creates PyTorchJob| KFTO
    TestSuite -->|creates TrainJob| TrainerV2
    TestSuite -->|creates RayJob| KubeRay
    TestSuite -->|creates ClusterQueue| KueueOp

    %% Build systems
    Konflux["Konflux<br/>(Tekton Pipelines)"]
    Konflux -->|builds| RuntimeImages
    Konflux -->|builds| UniversalImages

    %% Styling
    style DW fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style TestInfra fill:#fff3e0,stroke:#f5a623,stroke-width:1px
    style RuntimeImages fill:#e8f5e9,stroke:#4caf50,stroke-width:1px
    style UniversalImages fill:#f3e5f5,stroke:#9c27b0,stroke-width:1px
    style RayImages fill:#e0f7fa,stroke:#00bcd4,stroke-width:1px
    style Benchmarks fill:#fce4ec,stroke:#e91e63,stroke-width:1px
    style Utilities fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px

    style TestSuite fill:#ff9800,color:#fff
    style SupportLib fill:#ff9800,color:#fff
    style RhodsOp fill:#4a90e2,color:#fff
    style KFTO fill:#999,color:#fff
    style TrainerV2 fill:#999,color:#fff
    style KubeRay fill:#999,color:#fff
    style KueueOp fill:#999,color:#fff
    style Konflux fill:#7ed321,color:#fff
