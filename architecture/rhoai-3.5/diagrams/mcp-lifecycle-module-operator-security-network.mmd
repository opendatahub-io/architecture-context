graph TB
    subgraph ControlPlane["OPENSHIFT CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token Auth"]
        OSAPI["OpenShift APIServer<br/>(config.openshift.io)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ClusterInternal["CLUSTER-INTERNAL (RBAC Enforced)"]
        direction TB

        subgraph PlatformNS["Platform Operator Namespace"]
            PlatformOp["ODH Platform Operator<br/>(rhods-operator)<br/>SA: rhods-operator"]
        end

        subgraph SystemNS["SYSTEM_NAMESPACE"]
            direction TB

            subgraph ModuleOp["Module Operator"]
                ModCtrl["MCP Lifecycle Module Operator<br/>SA: mcp-lifecycle-module-operator-controller-manager<br/>500m CPU / 512Mi memory<br/>Ports: 8081/TCP (health, HTTP, no auth)"]
            end

            subgraph OperandBlock["Operand (deployed by Module Operator)"]
                OperandCtrl["MCP Lifecycle Operator<br/>SA: mcp-lifecycle-operator-controller-manager<br/>460MiB GOMEMLIMIT<br/>TLS: injected from cluster profile"]
                MetricsSvc["Metrics Service (ClusterIP)<br/>8443/TCP HTTPS TLS<br/>Auth: Bearer Token"]
                HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
                NetPol["NetworkPolicy: allow-metrics-traffic<br/>Ingress 8443: ns with metrics=enabled<br/>Ingress 8081: kubelet probes"]
            end

            PlatformCM["ConfigMap<br/>odh-mcplifecycleoperator-config<br/>Key: platformVersion"]
        end

        subgraph MonitoringNS["Monitoring Namespace (metrics=enabled)"]
            Prometheus["Prometheus<br/>(via ServiceMonitor)"]
        end
    end

    %% Platform Operator creates CR
    PlatformOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Creates MCPLifecycleOperator CR"| K8sAPI

    %% Module Operator watches and acts
    K8sAPI -->|"Watch events<br/>CR created/updated"| ModCtrl
    ModCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>SSA Apply operand resources"| K8sAPI
    ModCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Read TLS profile"| OSAPI
    ModCtrl -->|"Reads platformVersion"| PlatformCM

    %% Prometheus scrapes operand
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>NetworkPolicy: metrics=enabled"| MetricsSvc

    %% Operand connections
    OperandCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Manage MCPServer CRs"| K8sAPI

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef moduleop fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef operand fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef config fill:#e8e8e8,stroke:#999,stroke-width:1px
    classDef netpol fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class K8sAPI,OSAPI controlplane
    class PlatformOp platform
    class ModCtrl moduleop
    class OperandCtrl,MetricsSvc,HealthProbe operand
    class Prometheus monitoring
    class PlatformCM config
    class NetPol netpol
