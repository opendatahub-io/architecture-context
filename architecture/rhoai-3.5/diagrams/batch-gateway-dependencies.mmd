graph LR
    BatchGW["Batch Gateway<br/>(API Server + Processor + GC)"]

    %% External Dependencies (Required)
    BatchGW -->|"metadata storage<br/>pgx/5432 Optional TLS"| PostgreSQL["PostgreSQL 12+"]
    BatchGW -->|"queue, events, status<br/>RESP/6379 Optional TLS/mTLS"| Redis["Redis 6+ / Valkey 8+"]
    BatchGW -->|"file storage<br/>HTTPS/443 TLS"| S3["S3-Compatible Storage"]

    %% External Dependencies (Optional)
    BatchGW -.->|"trace export<br/>gRPC Optional TLS"| OTLP["OTLP Collector"]
    BatchGW -.->|"metrics scrape<br/>HTTP 8081/9090/9091"| Prometheus["Prometheus"]

    %% Internal Platform Dependencies
    BatchGW -->|"inference dispatch<br/>HTTP(S) API Key/mTLS"| LLMdRouter["llm-d Router"]
    BatchGW -.->|"async dispatch<br/>Redis queue"| LLMdAsync["llm-d-async"]

    %% Platform Integration (Inbound)
    Kuadrant["Kuadrant / Authorino"] -->|"AuthN/AuthZ enforcement<br/>Gateway API AuthPolicy"| BatchGW
    GatewayAPI["Gateway API<br/>HTTPRoute"] -->|"ingress routing<br/>/v1/batches, /v1/files"| BatchGW

    %% Monitoring Integration (Inbound)
    Grafana["Grafana"] -.->|"dashboards<br/>ConfigMap sidecar"| BatchGW

    %% Styling
    style BatchGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external (dark gray)
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff

    %% Optional external (light gray)
    style OTLP fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style Grafana fill:#999,stroke:#333,color:#fff

    %% Internal platform (green)
    style LLMdRouter fill:#7ed321,stroke:#333,color:#fff
    style LLMdAsync fill:#7ed321,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff
