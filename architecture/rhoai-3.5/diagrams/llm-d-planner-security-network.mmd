graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph Ingress["INGRESS (OpenShift Router - Edge TLS)"]
        RouteUI["Route: planner<br/>443/TCP → 8501/TCP<br/>TLS edge termination<br/>No auth"]
        RouteBackend["Route: planner-backend<br/>443/TCP → 8000/TCP<br/>TLS edge termination<br/>No auth"]
    end

    subgraph PlannerNS["NAMESPACE: planner"]
        direction TB

        UI["Streamlit UI<br/>Service: ui (ClusterIP)<br/>8501/TCP HTTP<br/>No auth"]
        Backend["Backend API (FastAPI)<br/>Service: backend (ClusterIP)<br/>8000/TCP HTTP<br/>SA: planner-backend<br/>runAsNonRoot, drop ALL"]

        subgraph DataServices["Data Services"]
            PG["PostgreSQL<br/>Service: postgres (ClusterIP)<br/>5432/TCP<br/>Auth: Password<br/>PVC: 5Gi"]
            OllamaLLM["Ollama LLM<br/>Service: ollama (ClusterIP)<br/>11434/TCP HTTP<br/>No auth<br/>Model: qwen2.5:7b"]
        end
    end

    subgraph PlatformSvc["PLATFORM SERVICES (In-Cluster)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        ModelCatalog["RHOAI Model Catalog<br/>Namespace: rhoai-model-registries<br/>8443/TCP HTTPS<br/>TLS (service-ca)<br/>SA token / Bearer"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN (optional)"]
        OpenAIAPI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key (Bearer)"]
        VertexAI["Vertex AI (Google Cloud)<br/>443/TCP HTTPS/gRPC<br/>TLS 1.2+<br/>GCP credentials"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS edge"| RouteUI
    User -->|"HTTPS/443<br/>TLS edge"| RouteBackend

    %% Ingress to Services
    RouteUI -->|"HTTP/8501<br/>No encryption<br/>No auth"| UI
    RouteBackend -->|"HTTP/8000<br/>No encryption<br/>No auth"| Backend

    %% Internal flows
    UI -->|"HTTP/8000<br/>No encryption<br/>No auth"| Backend
    Backend -->|"PostgreSQL/5432<br/>No encryption<br/>Password auth"| PG
    Backend -->|"HTTP/11434<br/>No encryption<br/>No auth"| OllamaLLM

    %% Platform services
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Backend -->|"HTTPS/8443<br/>TLS (service-ca)<br/>SA token<br/>NetworkPolicy"| ModelCatalog

    %% External services
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN (optional)"| HFHub
    Backend -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| OpenAIAPI
    Backend -.->|"HTTPS/443<br/>TLS 1.2+<br/>GCP creds"| VertexAI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef datastore fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class RouteUI,RouteBackend ingress
    class UI,Backend internal
    class PG,OllamaLLM datastore
    class K8sAPI,ModelCatalog platform
    class HFHub,OpenAIAPI,VertexAI externalservice
