graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["ogx-k8s-operator-<br/>controller-manager"]
        SA_Instance["{instance}-sa<br/>(per OGXServer)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["ogx-operator-manager-<br/>rolebinding"]
        CRB_LeaderElect["ogx-k8s-operator-<br/>leader-election"]
    end

    subgraph RoleBindings["Role Bindings (per namespace)"]
        RB_Anyuid["{instance}-anyuid"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ogx-operator-manager"]
        CR_LeaderElect["leader-election-role"]
    end

    subgraph SCCs["SecurityContextConstraints"]
        SCC_Anyuid["system:openshift:scc:anyuid"]
    end

    subgraph OGXResources["ogx.io API Group"]
        OGXServers["ogxservers"]
        OGXServersStatus["ogxservers/status"]
        OGXServersFinalizers["ogxservers/finalizers"]
    end

    subgraph CoreResources["Core API Group ('')"]
        Services["services"]
        ConfigMaps["configmaps"]
        Secrets["secrets"]
        PVCs["persistentvolumeclaims"]
        ServiceAccts["serviceaccounts"]
        Pods["pods"]
    end

    subgraph AppsResources["apps API Group"]
        Deployments["deployments"]
        ReplicaSets["replicasets"]
    end

    subgraph NetworkResources["networking.k8s.io"]
        NetworkPolicies["networkpolicies"]
        Ingresses["ingresses"]
    end

    subgraph PolicyResources["policy API Group"]
        PDBs["poddisruptionbudgets"]
    end

    subgraph AutoscalingResources["autoscaling API Group"]
        HPAs["horizontalpodautoscalers"]
    end

    subgraph RBACResources["rbac.authorization.k8s.io"]
        CRBs["clusterrolebindings"]
        CRs["clusterroles"]
        RBs["rolebindings"]
    end

    subgraph MonitoringResources["monitoring.coreos.com"]
        ServiceMonitors["servicemonitors"]
        PrometheusRules["prometheusrules"]
    end

    subgraph OpenShiftResources["OpenShift API Groups"]
        SCCResource["securitycontextconstraints<br/>(security.openshift.io)"]
        APIServers["apiservers<br/>(config.openshift.io)"]
        CRDs["customresourcedefinitions<br/>(apiextensions.k8s.io)"]
    end

    %% Operator SA bindings
    SA_Operator -->|"bound via"| CRB_Manager
    SA_Operator -->|"bound via"| CRB_LeaderElect

    CRB_Manager -->|"grants"| CR_Manager
    CRB_LeaderElect -->|"grants"| CR_LeaderElect

    %% Instance SA bindings
    SA_Instance -->|"bound via"| RB_Anyuid
    RB_Anyuid -->|"grants"| SCC_Anyuid

    %% ClusterRole permissions - OGX resources
    CR_Manager -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| OGXServers
    CR_Manager -->|"get, update, patch"| OGXServersStatus
    CR_Manager -->|"update"| OGXServersFinalizers

    %% ClusterRole permissions - Core resources
    CR_Manager -->|"full CRUD"| Services
    CR_Manager -->|"get, list, watch,<br/>create, update, patch"| ConfigMaps
    CR_Manager -->|"get, list, watch"| Secrets
    CR_Manager -->|"get, list, watch,<br/>create, update, patch"| PVCs
    CR_Manager -->|"full CRUD"| ServiceAccts
    CR_Manager -->|"list"| Pods

    %% ClusterRole permissions - Apps resources
    CR_Manager -->|"full CRUD"| Deployments
    CR_Manager -->|"get, list, watch"| ReplicaSets

    %% ClusterRole permissions - Networking
    CR_Manager -->|"full CRUD"| NetworkPolicies
    CR_Manager -->|"full CRUD"| Ingresses

    %% ClusterRole permissions - Policy & Autoscaling
    CR_Manager -->|"full CRUD"| PDBs
    CR_Manager -->|"full CRUD"| HPAs

    %% ClusterRole permissions - RBAC
    CR_Manager -->|"get, list, delete"| CRBs
    CR_Manager -->|"get, list, watch"| CRs
    CR_Manager -->|"full CRUD"| RBs

    %% ClusterRole permissions - Monitoring
    CR_Manager -->|"full CRUD"| ServiceMonitors
    CR_Manager -->|"full CRUD"| PrometheusRules

    %% ClusterRole permissions - OpenShift
    CR_Manager -->|"use"| SCCResource
    CR_Manager -->|"get, list, watch"| APIServers
    CR_Manager -->|"get, list, watch"| CRDs

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Instance fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_LeaderElect fill:#f5a623,stroke:#333,color:#fff
    style SCC_Anyuid fill:#e74c3c,stroke:#333,color:#fff
    style OGXServers fill:#7ed321,stroke:#333,color:#fff
    style OGXServersStatus fill:#7ed321,stroke:#333,color:#fff
    style OGXServersFinalizers fill:#7ed321,stroke:#333,color:#fff
