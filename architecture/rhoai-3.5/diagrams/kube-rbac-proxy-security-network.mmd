graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(browser / kubectl / component)"]
        Prom["prometheus-k8s<br/>SA: prometheus-k8s<br/>NS: openshift-monitoring"]
    end

    subgraph ComponentPod["COMPONENT POD (Trust Boundary)"]
        direction TB

        subgraph ProxySidecar["kube-rbac-proxy Sidecar"]
            direction TB
            TLS["TLS Listener<br/>8443/TCP<br/>TLS 1.2+ (configurable)<br/>Cert hot-reload: 1m"]
            Health["Health Endpoint<br/>/healthz<br/>configurable port"]

            subgraph AuthNLayer["Authentication"]
                Delegating["Delegating AuthN<br/>(Bearer → TokenReview)"]
                OIDC["OIDC AuthN<br/>(JWT validation)"]
                X509["X.509 AuthN<br/>(client cert CA)"]
            end

            subgraph AuthZLayer["Authorization"]
                HardcodedMetrics["Hardcoded Metrics AuthZ<br/>(prometheus-k8s → /metrics)"]
                Static["Static AuthZ<br/>(allow-list)"]
                SARAuthz["SAR AuthZ<br/>(SubjectAccessReview)"]
            end
        end

        UpstreamApp["Upstream Application<br/>(TrustyAI / Model Registry / etc.)<br/>configurable port"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (conditional)"]
        OIDCProvider["OIDC Identity Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>(only when --oidc-issuer set)"]
    end

    %% Inbound flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token / OIDC JWT / X.509"| TLS
    Prom -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token<br/>Hardcoded allow → /metrics"| TLS

    %% Auth chain
    TLS --> Delegating
    TLS --> OIDC
    TLS --> X509
    Delegating --> HardcodedMetrics
    OIDC --> HardcodedMetrics
    X509 --> HardcodedMetrics
    HardcodedMetrics --> Static
    Static --> SARAuthz

    %% Proxy to upstream
    SARAuthz -->|"HTTP/HTTPS/h2c<br/>configurable port<br/>Pre-authenticated<br/>X-Forwarded-User headers"| UpstreamApp

    %% Egress to K8s API
    Delegating -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token (in-cluster)<br/>TokenReview API"| K8sAPI
    SARAuthz -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token (in-cluster)<br/>SubjectAccessReview API"| K8sAPI

    %% OIDC discovery
    OIDC -->|"HTTPS/443<br/>TLS 1.2+<br/>Discovery + JWKS"| OIDCProvider

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#4a90e2,stroke:#2a6cb0,stroke-width:2px,color:#fff
    classDef authn fill:#7ed321,stroke:#5ba018,stroke-width:2px
    classDef authz fill:#f5a623,stroke:#c07e10,stroke-width:2px
    classDef upstream fill:#50e3c2,stroke:#30b39e,stroke-width:2px
    classDef clusterinternal fill:#e8e8e8,stroke:#999,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,Prom external
    class TLS,Health ingress
    class Delegating,OIDC,X509 authn
    class HardcodedMetrics,Static,SARAuthz authz
    class UpstreamApp upstream
    class K8sAPI clusterinternal
    class OIDCProvider externalservice
