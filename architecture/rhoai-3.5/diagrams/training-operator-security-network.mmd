graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist<br/>User credentials"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: opendatahub"]
        direction TB

        subgraph OperatorPod["Training Operator Pod<br/>SA: training-operator"]
            WebhookSvr["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (auto-rotated)<br/>failurePolicy: Fail"]
            MetricsSvr["Metrics Server<br/>8080/TCP HTTP<br/>TLS (cluster profile)<br/>No auth"]
            HealthSvr["Health Probes<br/>8081/TCP HTTP<br/>No encryption"]
        end

        WebhookCert["kubeflow-training-operator-webhook-cert<br/>OPA cert-controller<br/>Auto-rotate: Yes"]
    end

    subgraph UserNS["USER NAMESPACES (Per-Tenant)"]
        direction TB

        subgraph TrainingJob["Training Job Resources"]
            MasterPod["Master Pod<br/>Framework port/TCP"]
            WorkerPods["Worker Pods<br/>Framework port/TCP"]
            HeadlessSvc["Headless Services<br/>ClusterIP: None<br/>DNS discovery"]
        end

        subgraph PyTorchSpecific["PyTorch-Specific"]
            Rendezvous["c10d Rendezvous<br/>23456/TCP<br/>Plaintext"]
            NetPol["NetworkPolicy<br/>Intra-job + monitoring"]
        end

        subgraph MPISpecific["MPI-Specific"]
            MPISvcAcct["Per-job ServiceAccount<br/>pods/exec RBAC"]
            MPIConfigMap["Hostfile ConfigMap<br/>kubexec.sh scripts"]
        end
    end

    subgraph PlatformSvcs["PLATFORM SERVICES"]
        Prometheus["Prometheus<br/>PodMonitor scrape<br/>8080/TCP"]
        OpenShiftAPI["OpenShift APIServer CR<br/>config.openshift.io/v1<br/>TLS profile config"]
        RhodsOp["rhods-operator<br/>Kustomize deploy<br/>ConfigMap image injection"]
    end

    subgraph OptionalSchedulers["OPTIONAL SCHEDULERS"]
        Volcano["Volcano Scheduler<br/>PodGroup CRD<br/>443/TCP HTTPS"]
        SchedPlugins["Scheduler-Plugins<br/>PodGroup CRD<br/>443/TCP HTTPS"]
    end

    %% External → Control Plane
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% Control Plane → Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS (auto-rotated)<br/>API server client cert"| WebhookSvr

    %% Operator → Control Plane (reconciliation)
    OperatorPod -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Operator creates training resources
    K8sAPI -.->|"Creates"| MasterPod
    K8sAPI -.->|"Creates"| WorkerPods
    K8sAPI -.->|"Creates"| HeadlessSvc

    %% Pod-to-pod (plaintext)
    WorkerPods -->|"Framework port/TCP<br/>Plaintext<br/>No auth"| MasterPod

    %% PyTorch specific
    WorkerPods -->|"23456/TCP<br/>Plaintext"| Rendezvous

    %% MPI specific
    MasterPod -->|"HTTPS/443 via K8s API<br/>pods/exec<br/>Per-job SA token"| WorkerPods

    %% Platform services
    Prometheus -->|"HTTP/8080<br/>TLS (cluster profile)<br/>PodMonitor"| MetricsSvr
    OperatorPod -->|"HTTPS/443<br/>Read TLS profile"| OpenShiftAPI
    RhodsOp -.->|"Deploys"| OperatorPod

    %% Optional schedulers
    OperatorPod -->|"HTTPS/443<br/>PodGroup CRUD"| Volcano
    OperatorPod -->|"HTTPS/443<br/>PodGroup CRUD"| SchedPlugins

    %% Cert management
    WebhookCert -.->|"TLS certs"| WebhookSvr

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5

    class User external
    class K8sAPI controlplane
    class WebhookSvr,MetricsSvr,HealthSvr,WebhookCert operatorns
    class MasterPod,WorkerPods,HeadlessSvc,Rendezvous,NetPol,MPISvcAcct,MPIConfigMap userns
    class Prometheus,OpenShiftAPI,RhodsOp platform
    class Volcano,SchedPlugins optional
