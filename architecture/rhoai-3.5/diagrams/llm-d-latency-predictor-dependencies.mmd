graph LR
    LLP["llm-d-latency-predictor"]

    %% ML Framework Dependencies
    LLP -->|"quantile regression<br/>tree models"| XGBoost["XGBoost 3.3.0"]
    LLP -->|"alternative ML backend"| LightGBM["LightGBM 4.6.0"]
    LLP -->|"Bayesian Ridge, scaler,<br/>ML utilities"| ScikitLearn["scikit-learn 1.9.0"]

    %% Runtime Dependencies
    LLP -->|"HTTP API framework"| FastAPI["FastAPI 0.138.1"]
    LLP -->|"ASGI server"| Uvicorn["uvicorn 0.49.0"]
    LLP -->|"data validation"| Pydantic["Pydantic 2.13.4"]

    %% Data Processing Dependencies
    LLP -->|"feature engineering"| Pandas["pandas 3.0.3"]
    LLP -->|"numerical ops"| NumPy["numpy 2.5.0"]
    LLP -->|"model serialization"| Joblib["joblib 1.5.3"]
    LLP -->|"quantile stats"| SciPy["scipy 1.18.0"]

    %% Optional Performance
    LLP -.->|"fast JSON serialization"| Orjson["orjson 3.11.9"]
    LLP -->|"HTTP client<br/>model download"| Requests["requests 2.34.2"]

    %% Internal Platform Dependencies
    GatewayExt["Gateway API<br/>Inference Extension"] -->|"consumes predictions<br/>for routing"| LLP

    %% Integration Points
    InferencePods["llm-d Inference Pods"] -->|"submits request traces<br/>HTTP/8000"| LLP
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>HTTP/8000"| LLP

    %% Platform
    LLP -->|"container orchestration"| K8s["Kubernetes API"]

    %% Styling
    style LLP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% ML frameworks
    style XGBoost fill:#e8d44d,stroke:#333,color:#000
    style LightGBM fill:#e8d44d,stroke:#333,color:#000
    style ScikitLearn fill:#e8d44d,stroke:#333,color:#000

    %% Runtime
    style FastAPI fill:#009688,stroke:#333,color:#fff
    style Uvicorn fill:#009688,stroke:#333,color:#fff
    style Pydantic fill:#009688,stroke:#333,color:#fff

    %% Data
    style Pandas fill:#999,stroke:#333,color:#fff
    style NumPy fill:#999,stroke:#333,color:#fff
    style Joblib fill:#999,stroke:#333,color:#fff
    style SciPy fill:#999,stroke:#333,color:#fff
    style Orjson fill:#999,stroke:#333,color:#fff
    style Requests fill:#999,stroke:#333,color:#fff

    %% Internal
    style GatewayExt fill:#7ed321,stroke:#333,color:#fff
    style InferencePods fill:#7ed321,stroke:#333,color:#fff
