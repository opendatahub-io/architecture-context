graph TD
    subgraph TrainingHub["Training Hub - RBAC Summary"]
        direction TB

        Note["Training Hub is a Python library,<br/>NOT a Kubernetes operator or service.<br/><br/>It defines NO RBAC resources:<br/>- No ClusterRoles<br/>- No Roles<br/>- No RoleBindings<br/>- No ServiceAccounts<br/>- No CRDs<br/><br/>RBAC requirements are INHERITED<br/>from the consuming environment."]
    end

    subgraph InheritedRBAC["Inherited RBAC (Platform Responsibility)"]
        direction TB

        subgraph NotebookContext["Notebook Context (typical)"]
            SA["ServiceAccount<br/>{notebook-sa}"]
            NS["Namespace<br/>{data-science-project}"]
            SA -->|"scoped to"| NS
        end

        subgraph PipelineContext["Pipeline Context (typical)"]
            PipelineSA["ServiceAccount<br/>{pipeline-sa}"]
            PipelineNS["Namespace<br/>{pipeline-namespace}"]
            PipelineSA -->|"scoped to"| PipelineNS
        end
    end

    subgraph Credentials["Runtime Credentials (User-Provided)"]
        direction TB
        WandBKey["WANDB_API_KEY<br/>(env var, optional)"]
        MLflowToken["MLFLOW_TRACKING_TOKEN<br/>(env var, optional)"]
        HFToken["HF_TOKEN<br/>(env var, optional)"]
        LLMKeys["LLM Provider API Keys<br/>(env var, optional)"]
    end

    TrainingHub -.->|"runs within"| InheritedRBAC
    TrainingHub -.->|"uses at runtime"| Credentials

    %% Styling
    style TrainingHub fill:#f0f0f0,stroke:#999,stroke-width:2px
    style Note fill:#fff3cd,stroke:#d6a800,stroke-width:1px
    style InheritedRBAC fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Credentials fill:#f8d7da,stroke:#dc3545,stroke-width:2px
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style PipelineSA fill:#4a90e2,stroke:#333,color:#fff
    style NS fill:#d5e8d4,stroke:#82b366
    style PipelineNS fill:#d5e8d4,stroke:#82b366
    style WandBKey fill:#fce4ec,stroke:#c62828
    style MLflowToken fill:#fce4ec,stroke:#c62828
    style HFToken fill:#fce4ec,stroke:#c62828
    style LLMKeys fill:#fce4ec,stroke:#c62828
