graph LR
    ArgoWF[Argo Workflows<br/>workflow-controller + argoexec]

    %% External Dependencies (Required)
    ArgoWF -->|"CRD CRUD, Pod lifecycle<br/>443/TCP HTTPS"| K8s[Kubernetes 1.32+]

    %% External Dependencies (Optional)
    ArgoWF -->|"workflow archival<br/>5432/TCP SSL"| PG[PostgreSQL 10+]
    ArgoWF -->|"workflow archival<br/>3306/TCP"| MySQL[MySQL 5.7+]
    ArgoWF -->|"artifact storage<br/>443/TCP HTTPS"| S3[S3-compatible<br/>Storage]
    ArgoWF -->|"artifact storage<br/>443/TCP HTTPS"| GCS[Google Cloud<br/>Storage]
    ArgoWF -->|"artifact storage<br/>443/TCP HTTPS"| Azure[Azure Blob<br/>Storage]
    ArgoWF -.->|"artifact storage<br/>443/TCP"| HDFS[HDFS]

    %% Internal RHOAI Dependencies
    DSPOperator[Data Science Pipelines<br/>Operator] -->|"deploys & configures"| ArgoWF
    ArgoWF -->|"default artifact repo<br/>443/TCP HTTPS"| MinIO[MinIO / S3<br/>via DSP config]

    %% Integration Points (inbound)
    ArgoEvents[Argo Events] -->|"event-driven triggers<br/>CRD Watch"| ArgoWF
    WebhookProviders[Webhook Providers<br/>GitHub / GitLab / Bitbucket] -->|"event-driven workflows<br/>2746/TCP HTTPS"| ArgoWF

    %% Integration Points (outbound)
    ArgoWF -.->|"SSO auth<br/>443/TCP HTTPS"| OIDC[OIDC Provider]
    ArgoWF -.->|"metrics export<br/>gRPC OTLP"| OTel[OpenTelemetry<br/>Collector]

    %% Styling
    style ArgoWF fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style K8s fill:#999,stroke:#333,color:#fff
    style PG fill:#999,stroke:#333,color:#fff
    style MySQL fill:#999,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style Azure fill:#f5a623,stroke:#333
    style HDFS fill:#f5a623,stroke:#333

    style DSPOperator fill:#7ed321,stroke:#333,color:#fff
    style MinIO fill:#7ed321,stroke:#333,color:#fff

    style ArgoEvents fill:#e8e8e8,stroke:#333
    style WebhookProviders fill:#e8e8e8,stroke:#333
    style OIDC fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
