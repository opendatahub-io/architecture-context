graph TB
    subgraph GuardrailsDetectors["Guardrails Detectors"]
        direction TB

        subgraph CommonLib["Common Library"]
            BaseAPI["DetectorBaseAPI<br/>(FastAPI Base Class)"]
            Schemas["Pydantic Schemas<br/>(Request/Response)"]
            Prometheus["Prometheus<br/>Instrumentation"]
            HealthEP["Health Endpoint<br/>/health"]
        end

        subgraph BuiltIn["Built-in Detector<br/>Port: 8080/TCP"]
            BuiltInApp["built_in/app.py"]
            RegexRegistry["Regex Registry<br/>(PII: email, CC, SSN,<br/>phone, IP)"]
            FileTypeRegistry["File Type Registry<br/>(JSON/XML/YAML<br/>schema validation)"]
            CustomRegistry["Custom Registry<br/>(User-defined detectors<br/>with AST sandboxing)"]
            BuiltInApp --> RegexRegistry
            BuiltInApp --> FileTypeRegistry
            BuiltInApp --> CustomRegistry
        end

        subgraph HFDetector["HuggingFace Detector<br/>Port: 8000/TCP"]
            HFApp["huggingface/app.py"]
            SeqClassifier["Sequence<br/>Classification"]
            TokenClassifier["Token<br/>Classification"]
            GraniteCausal["GraniteForCausalLM<br/>(Multi-risk)"]
            ResolvedParams["_ResolvedParams<br/>(threshold, labels,<br/>max_length)"]
            HFApp --> SeqClassifier
            HFApp --> TokenClassifier
            HFApp --> GraniteCausal
            HFApp --> ResolvedParams
        end

        subgraph JudgeDetector["LLM Judge Detector<br/>Port: 8000/TCP"]
            JudgeApp["llm_judge/app.py"]
            VLLMJudge["vllm_judge Library<br/>(safety, toxicity,<br/>accuracy, helpfulness)"]
            JudgeApp --> VLLMJudge
        end

        BuiltInApp -.->|extends| BaseAPI
        HFApp -.->|extends| BaseAPI
        JudgeApp -.->|extends| BaseAPI
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|POST /api/v1/text/contents<br/>8080/TCP| BuiltInApp
    Orchestrator -->|POST /api/v1/text/contents<br/>8000/TCP| HFApp
    Orchestrator -->|POST /api/v1/text/contents<br/>8000/TCP| JudgeApp

    KServe["KServe"] -.->|deploys as<br/>InferenceService| HFDetector
    KServe -.->|deploys as<br/>InferenceService| JudgeDetector

    S3["S3/MinIO<br/>Model Storage"] -->|model files<br/>9000/TCP| HFDetector
    vLLM["vLLM Inference<br/>Server"] <-->|OpenAI-compatible API| JudgeApp

    PrometheusServer["Prometheus"] -->|scrapes /metrics| Prometheus

    Istio["Istio Service Mesh"] -.->|sidecar injection<br/>mTLS| BuiltIn
    Istio -.->|sidecar injection<br/>mTLS| HFDetector
    Istio -.->|sidecar injection<br/>mTLS| JudgeDetector

    style BaseAPI fill:#4a90e2,color:#fff
    style Schemas fill:#4a90e2,color:#fff
    style Prometheus fill:#4a90e2,color:#fff
