graph TB
    subgraph TrainingOperator["Training Operator (opendatahub namespace)"]
        direction TB

        subgraph CommonLayer["Common Job Controller"]
            JobController["Job Controller<br/>Pod/Service reconciliation<br/>Gang scheduling<br/>Status tracking<br/>TTL cleanup"]
        end

        subgraph FrameworkControllers["Framework Controllers"]
            PyTorchCtrl["PyTorch Controller<br/>Elastic training<br/>HPA autoscaling<br/>Init containers<br/>NetworkPolicy"]
            TFCtrl["TensorFlow Controller<br/>TF_CONFIG injection<br/>PS/Worker pattern"]
            MPICtrl["MPI Controller<br/>Per-job RBAC<br/>Hostfile ConfigMaps<br/>Launcher/Worker"]
            JAXCtrl["JAX Controller<br/>Coordinator pattern"]
            XGBoostCtrl["XGBoost Controller<br/>Rabit tracker<br/>Master/Worker"]
            PaddleCtrl["PaddlePaddle Controller<br/>PS/Collective modes"]
        end

        subgraph Webhooks["Admission Webhooks (9443/TCP)"]
            WebhookServer["Webhook Server<br/>TLS (auto-rotated)"]
        end

        CertRotator["Cert Rotator<br/>OPA cert-controller<br/>Auto-rotates webhook certs"]
    end

    %% CRDs
    PyTorchJob["PyTorchJob CR<br/>kubeflow.org/v1"]
    TFJob["TFJob CR<br/>kubeflow.org/v1"]
    MPIJob["MPIJob CR<br/>kubeflow.org/v1"]
    JAXJob["JAXJob CR<br/>kubeflow.org/v1"]
    XGBoostJob["XGBoostJob CR<br/>kubeflow.org/v1"]
    PaddleJob["PaddleJob CR<br/>kubeflow.org/v1"]

    %% User interaction
    User["Data Scientist / Platform User"]

    %% Created resources
    TrainingPods["Training Pods<br/>(Master + Workers)"]
    HeadlessServices["Headless Services<br/>(Pod discovery)"]

    %% CRD watches
    PyTorchJob -->|watched by| PyTorchCtrl
    TFJob -->|watched by| TFCtrl
    MPIJob -->|watched by| MPICtrl
    JAXJob -->|watched by| JAXCtrl
    XGBoostJob -->|watched by| XGBoostCtrl
    PaddleJob -->|watched by| PaddleCtrl

    %% User creates CRDs
    User -->|creates| PyTorchJob
    User -->|creates| TFJob
    User -->|creates| MPIJob
    User -->|creates| JAXJob
    User -->|creates| XGBoostJob
    User -->|creates| PaddleJob

    %% Framework controllers extend common
    PyTorchCtrl -->|extends| JobController
    TFCtrl -->|extends| JobController
    MPICtrl -->|extends| JobController
    JAXCtrl -->|extends| JobController
    XGBoostCtrl -->|extends| JobController
    PaddleCtrl -->|extends| JobController

    %% Resource creation
    JobController -->|creates| TrainingPods
    JobController -->|creates| HeadlessServices

    %% Webhook validation
    WebhookServer -->|validates| PyTorchJob
    WebhookServer -->|validates| TFJob
    WebhookServer -->|validates| XGBoostJob
    WebhookServer -->|validates| JAXJob
    WebhookServer -->|validates| PaddleJob

    %% Cert management
    CertRotator -->|manages certs for| WebhookServer

    %% External dependencies
    K8sAPI["Kubernetes API Server"]
    JobController -->|reconciles via| K8sAPI

    %% Styling
    style TrainingOperator fill:#e8f4fd,stroke:#2196F3,stroke-width:2px
    style JobController fill:#4a90e2,color:#fff
    style PyTorchCtrl fill:#4a90e2,color:#fff
    style TFCtrl fill:#4a90e2,color:#fff
    style MPICtrl fill:#4a90e2,color:#fff
    style JAXCtrl fill:#4a90e2,color:#fff
    style XGBoostCtrl fill:#4a90e2,color:#fff
    style PaddleCtrl fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style CertRotator fill:#4a90e2,color:#fff
    style PyTorchJob fill:#f5a623
    style TFJob fill:#f5a623
    style MPIJob fill:#f5a623
    style JAXJob fill:#f5a623
    style XGBoostJob fill:#f5a623
    style PaddleJob fill:#f5a623
    style TrainingPods fill:#7ed321
    style HeadlessServices fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style User fill:#fff,stroke:#333
