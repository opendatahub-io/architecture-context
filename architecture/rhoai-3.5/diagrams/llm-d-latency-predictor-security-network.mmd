graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Router["llm-d Inference Router"]
        InferencePods["llm-d Inference Pods"]
        Prometheus["Prometheus"]
    end

    subgraph OptionalExternal["OPTIONAL EXTERNAL ACCESS"]
        TrainExtLB["training-service-external<br/>LoadBalancer<br/>8080/TCP → 8000/TCP<br/>HTTP Plaintext<br/>No Auth<br/>⚠️ Exposes sensitive endpoints"]
    end

    subgraph Services["CLUSTER SERVICES (No mTLS, No NetworkPolicies)"]
        direction TB

        subgraph PredictionZone["prediction-service (LoadBalancer)"]
            PredLB["LoadBalancer<br/>80/TCP → 8001/TCP<br/>HTTP Plaintext<br/>No Auth"]
            PredPods["Prediction Pods<br/>10 replicas × 8 workers<br/>Port 8001/TCP<br/>FastAPI + uvicorn"]
            PredLB --> PredPods
        end

        subgraph TrainingZone["training-service (ClusterIP)"]
            TrainSvc["ClusterIP<br/>8000/TCP<br/>HTTP Plaintext<br/>No Auth"]
            TrainPod["Training Pod<br/>1 replica (singleton)<br/>Port 8000/TCP<br/>FastAPI + uvicorn"]
            TrainSvc --> TrainPod
        end

        subgraph Storage["Persistent Storage"]
            PVC["PVC /models/<br/>joblib model files<br/>hyperdisk-balanced"]
        end
    end

    %% External flows
    Router -->|"POST /predict, /predict/bulk/strict<br/>HTTP 80/TCP<br/>Plaintext, No Auth"| PredLB
    InferencePods -->|"POST /add_training_data_bulk<br/>HTTP 8000/TCP<br/>Plaintext, No Auth"| TrainSvc
    Prometheus -->|"GET /metrics<br/>HTTP 8000/TCP<br/>Plaintext, No Auth"| TrainSvc

    %% Optional external access
    TrainExtLB -->|"HTTP 8080/TCP<br/>Plaintext, No Auth"| TrainPod

    %% Internal flows
    PredPods -->|"GET /model/.../info, /download<br/>HTTP 8000/TCP<br/>Plaintext, No Auth<br/>Every 10s model sync"| TrainSvc
    TrainPod -->|"Write *.joblib<br/>File I/O"| PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef lb fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Router,InferencePods,Prometheus external
    class TrainExtLB warning
    class PredLB,TrainSvc lb
    class PredPods,TrainPod pod
    class PVC storage
