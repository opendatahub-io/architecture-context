graph LR
    Trainer["Kubeflow Trainer<br/>Operator"]

    %% Required External Dependencies
    Trainer -->|"creates JobSets<br/>(required)"| JobSet["JobSet v0.10.1"]
    Trainer -->|"controller framework<br/>(required)"| CtrlRuntime["controller-runtime v0.22.3"]
    Trainer -->|"webhook cert rotation<br/>(required)"| CertCtrl["cert-controller v0.14.0<br/>(OPA)"]

    %% Optional External Dependencies
    Trainer -.->|"data cache workloads<br/>(optional)"| LWS["LeaderWorkerSet v0.7.0"]
    Trainer -.->|"gang-scheduling<br/>(optional)"| SchedPlugins["scheduler-plugins v0.34.1<br/>(CoScheduling)"]
    Trainer -.->|"gang-scheduling<br/>(optional)"| Volcano["Volcano v1.13.1"]

    %% Internal Platform Dependencies
    Trainer -->|"operator deployment<br/>via kustomize"| RhodsOp["rhods-operator"]
    Trainer -->|"TLS security profile"| OpenShiftAPI["OpenShift APIServer<br/>(config.openshift.io/v1)"]
    Trainer -->|"training images<br/>(ClusterTrainingRuntimes)"| TrainingHub["Training Hub<br/>Universal Images"]

    %% Integration Points - Consumers
    Prometheus["Prometheus"] -->|"PodMonitor<br/>8443/TCP"| Trainer
    K8sAPI["Kubernetes API Server"] -->|"webhook calls<br/>9443/TCP"| Trainer

    %% Integration Points - Watched Resources
    Trainer -->|"watches"| RuntimeClass["RuntimeClass<br/>(node.k8s.io/v1)"]
    Trainer -->|"watches"| LimitRange["LimitRange<br/>(core/v1)"]
    Trainer -->|"creates per-TrainJob"| NetworkPolicy["NetworkPolicy<br/>(networking.k8s.io/v1)"]
    Trainer -->|"creates/watches"| Secrets["Secrets<br/>(webhook cert, MPI SSH)"]
    Trainer -->|"creates/watches"| ConfigMaps["ConfigMaps<br/>(MPI hostfile, config)"]

    style Trainer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required dependencies
    style JobSet fill:#e8e8e8,stroke:#333
    style CtrlRuntime fill:#e8e8e8,stroke:#333
    style CertCtrl fill:#e8e8e8,stroke:#333

    %% Optional dependencies
    style LWS fill:#f0f0f0,stroke:#999,stroke-dasharray: 5 5
    style SchedPlugins fill:#f0f0f0,stroke:#999,stroke-dasharray: 5 5
    style Volcano fill:#f0f0f0,stroke:#999,stroke-dasharray: 5 5

    %% Internal platform
    style RhodsOp fill:#7ed321,stroke:#333
    style OpenShiftAPI fill:#7ed321,stroke:#333
    style TrainingHub fill:#7ed321,stroke:#333

    %% Kubernetes resources
    style RuntimeClass fill:#fff2cc,stroke:#d6b656
    style LimitRange fill:#fff2cc,stroke:#d6b656
    style NetworkPolicy fill:#fff2cc,stroke:#d6b656
    style Secrets fill:#fff2cc,stroke:#d6b656
    style ConfigMaps fill:#fff2cc,stroke:#d6b656

    %% Consumers
    style Prometheus fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
