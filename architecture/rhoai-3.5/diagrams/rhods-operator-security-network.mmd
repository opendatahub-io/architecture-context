graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Router["OpenShift Router / LB<br/>443/TCP<br/>TLS 1.2+"]
        Gateway["data-science-gateway<br/>Gateway API<br/>443/TCP → TLS TERMINATE<br/>TLS 1.2+ (APIServer profile)"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER"]
        EnvoyFilter["EnvoyFilter ext_authz<br/>L7 auth injection"]
        AuthProxy["kube-auth-proxy<br/>8443/TCP HTTPS (service-ca)<br/>9000/TCP metrics (HTTP)<br/>SA: kube-auth-proxy<br/>OAuth2-Proxy"]
        LuaFilter["Lua Filter<br/>Token forwarding<br/>Cookie stripping"]
    end

    subgraph ExternalAuth["IDENTITY PROVIDER"]
        OAuth["OAuth/OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuthClient/OIDC creds"]
    end

    subgraph ComponentLayer["COMPONENT BACKENDS (redhat-ods-applications)"]
        direction TB

        subgraph CompPod["Component Pod (per HTTPRoute)"]
            RBACProxy["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>SubjectAccessReview"]
            AppContainer["Application Container<br/>8080/TCP HTTP<br/>localhost only"]
        end
    end

    subgraph OperatorPlane["OPERATOR CONTROL PLANE"]
        Manager["rhods-operator manager<br/>8443/TCP webhook (TLS cert-manager)<br/>8080/TCP metrics (HTTP)<br/>8081/TCP health (HTTP)<br/>SA: rhods-operator"]
        WebhookSvc["webhook-service<br/>443/TCP → 9443/TCP<br/>TLS (cert-manager)"]
    end

    subgraph CloudMgr["CLOUD MANAGER (xKS only)"]
        CloudManager["cloudmanager<br/>8080/TCP metrics<br/>8081/TCP health<br/>AWS / Azure / CoreWeave"]
    end

    subgraph ClusterSvcs["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token"]
        OSAPI["OpenShift API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Routes, OAuth, Config"]
    end

    subgraph LegacyRedirect["LEGACY REDIRECT"]
        LegacyRoute["Route: rhods-dashboard<br/>443/TCP HTTPS (edge)"]
        NginxRedirect["dashboard-redirect<br/>8080/TCP HTTP<br/>nginx 301 redirect"]
    end

    subgraph ExternalEgress["EXTERNAL EGRESS"]
        Segment["Segment.IO<br/>443/TCP HTTPS<br/>API key<br/>(RHOAI self-managed)"]
    end

    %% Main request flow
    Client -->|"HTTPS/443<br/>TLS 1.2+"| Router
    Router -->|"HTTPS/443<br/>TLS passthrough/reencrypt"| Gateway
    Gateway -->|"Envoy pipeline"| EnvoyFilter
    EnvoyFilter -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Auth header check"| AuthProxy
    AuthProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuthClient creds"| OAuth
    EnvoyFilter -->|"after auth"| LuaFilter
    LuaFilter -->|"HTTP(S)/varies<br/>Bearer token"| RBACProxy
    RBACProxy -->|"HTTP/8080<br/>localhost<br/>after SAR check"| AppContainer

    %% Operator flows
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OSAPI
    CloudManager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Manager -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Segment

    %% Legacy redirect
    Client -.->|"HTTPS/443<br/>edge TLS"| LegacyRoute
    LegacyRoute -.->|"HTTP/8080"| NginxRedirect
    NginxRedirect -.->|"301 redirect"| Client

    %% Webhook
    K8sAPI -->|"HTTPS/443<br/>TLS (cert-manager)"| WebhookSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef component fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef legacy fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5 5
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Router,Gateway ingress
    class EnvoyFilter,AuthProxy,LuaFilter,OAuth auth
    class RBACProxy,AppContainer component
    class Manager,WebhookSvc,CloudManager operator
    class K8sAPI,OSAPI cluster
    class LegacyRoute,NginxRedirect legacy
    class Segment egress
