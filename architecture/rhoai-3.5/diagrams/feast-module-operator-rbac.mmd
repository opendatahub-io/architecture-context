graph TD
    subgraph "Service Accounts"
        SA["operator<br/>(in operator namespace)"]
    end

    subgraph "Bindings"
        CRB["manager-rolebinding<br/>(ClusterRoleBinding)"]
        RB["leader-election-rolebinding<br/>(RoleBinding, namespace-scoped)"]
    end

    subgraph "Roles"
        CR["manager-role<br/>(ClusterRole)"]
        LER["leader-election-role<br/>(Role, namespace-scoped)"]
    end

    subgraph "Platform CRD Resources"
        FeastOperator["components.platform.opendatahub.io<br/>feastoperators,<br/>feastoperators/status,<br/>feastoperators/finalizers"]
    end

    subgraph "Feast CRD Resources"
        FeatureStores["feast.dev<br/>featurestores,<br/>featurestores/status,<br/>featurestores/finalizers"]
    end

    subgraph "Core Kubernetes Resources"
        Deployments["apps<br/>Deployments"]
        CoreRW["core<br/>services, serviceaccounts,<br/>configmaps"]
        CoreRestricted["core<br/>secrets, namespaces"]
        PVCs["core<br/>persistentvolumeclaims"]
        Pods["core<br/>pods, pods/exec"]
        Events["core<br/>events"]
    end

    subgraph "RBAC Resources"
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        SAR["rbac.authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Extension Resources"
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Jobs["batch<br/>jobs, cronjobs"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
        HPA["autoscaling<br/>horizontalpodautoscalers"]
        PDB["policy<br/>poddisruptionbudgets"]
        Leases["coordination.k8s.io<br/>leases"]
        Routes["route.openshift.io<br/>routes"]
        Notebooks["kubeflow.org<br/>notebooks"]
    end

    subgraph "Auth Resources"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SubjectReviews["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Non-Resource URLs"
        Metrics["/metrics"]
    end

    subgraph "Leader Election Resources"
        LEConfigMaps["core<br/>configmaps"]
        LELeases["coordination.k8s.io<br/>leases"]
        LEEvents["core<br/>events"]
    end

    %% Binding relationships
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| CR
    RB -->|"grants"| LER

    %% ClusterRole permissions
    CR -->|"full CRUD"| FeastOperator
    CR -->|"full CRUD"| FeatureStores
    CR -->|"full CRUD"| Deployments
    CR -->|"full CRUD"| CoreRW
    CR -->|"get,list,watch,patch,update"| CoreRestricted
    CR -->|"get,list,watch,create,delete,update"| PVCs
    CR -->|"get,list,watch,create"| Pods
    CR -->|"create,patch"| Events
    CR -->|"full CRUD"| RBACRes
    CR -->|"get,list,watch,create,update,delete"| SAR
    CR -->|"full CRUD"| CRDs
    CR -->|"full CRUD"| Jobs
    CR -->|"full CRUD"| ServiceMonitors
    CR -->|"full CRUD"| HPA
    CR -->|"full CRUD"| PDB
    CR -->|"full CRUD"| Leases
    CR -->|"get,list,watch,create,delete,update"| Routes
    CR -->|"get,list,watch"| Notebooks
    CR -->|"create"| TokenReviews
    CR -->|"create"| SubjectReviews
    CR -->|"get"| Metrics

    %% Leader election permissions
    LER -->|"full CRUD"| LEConfigMaps
    LER -->|"full CRUD"| LELeases
    LER -->|"create,patch"| LEEvents

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style LER fill:#f5a623,stroke:#333,color:#fff
    style CRB fill:#e8e8e8,stroke:#333
    style RB fill:#e8e8e8,stroke:#333
    style FeastOperator fill:#7ed321,stroke:#333
    style FeatureStores fill:#7ed321,stroke:#333
    style Notebooks fill:#7ed321,stroke:#333
