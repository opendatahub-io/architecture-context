graph LR
    AP["llm-d-async<br/>Async Processor"]

    %% External Dependencies (Required)
    AP -->|"logging, metrics,<br/>signal handling"| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    AP -->|"structured logging<br/>(logutil)"| GAIE["gateway-api-inference-<br/>extension v1.2.1"]

    %% External Dependencies (Conditional - Queue Backends)
    AP -->|"message queue<br/>(redis-pubsub,<br/>redis-sortedset)"| Redis["Redis / Valkey<br/>(RESP2/RESP3)"]
    AP -->|"message queue<br/>(gcp-pubsub,<br/>gcp-pubsub-gated)"| GCPPubSub["GCP Pub/Sub<br/>v2 SDK"]

    %% External Dependencies (Conditional - Observability)
    AP -->|"dispatch gate<br/>metric queries"| Prometheus["Prometheus<br/>v1 API"]
    AP -.->|"distributed<br/>tracing"| OTELCollector["OpenTelemetry<br/>Collector (OTLP)"]

    %% External Dependencies (Optional)
    AP -.->|"backlog metrics"| GCPMon["GCP Cloud<br/>Monitoring v1"]

    %% Internal Platform Dependencies
    AP -->|"forwards inference<br/>requests (HTTP)"| Router["llm-d-router<br/>(Inference Gateway)"]
    AP -->|"flow control metrics<br/>(via Prometheus)"| EPP["llm-d-inference-<br/>scheduler (EPP)"]
    AP -.->|"fallback budget<br/>metrics (via<br/>Prometheus relabel)"| vLLM["vLLM Model<br/>Servers"]

    %% Kubernetes
    AP -->|"signal handling,<br/>optional RBAC"| K8sAPI["Kubernetes API"]

    %% Go Module Dependencies (importable)
    ProducerSDK["producer/ SDK<br/>(Go module)"] -->|"client for<br/>request submission"| Redis
    ProducerSDK -->|"imports"| APIModule["api/ module<br/>(message types)"]

    %% Styling
    style AP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style GAIE fill:#999,stroke:#333,color:#fff
    style Redis fill:#dc382c,stroke:#333,color:#fff
    style GCPPubSub fill:#4285f4,stroke:#333,color:#fff
    style GCPMon fill:#4285f4,stroke:#333,color:#fff
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style OTELCollector fill:#425cc7,stroke:#333,color:#fff
    style Router fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style ProducerSDK fill:#e1d5e7,stroke:#9673a6
    style APIModule fill:#e1d5e7,stroke:#9673a6
