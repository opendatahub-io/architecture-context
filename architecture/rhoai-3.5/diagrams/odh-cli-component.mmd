graph TB
    subgraph CLI["odh-cli (rhai-cli / kubectl-odh)"]
        direction TB

        subgraph Commands["Command Layer (cmd/)"]
            LintCmd[lint<br/>Upgrade Readiness]
            MigrateCmd[migrate<br/>Pre/Post Upgrade]
            StatusCmd[status<br/>Cluster Health]
            BackupCmd[backup<br/>Workload Backup]
            DepsCmd[deps<br/>Dependency Mgmt]
            EventsCmd[events<br/>Event Streaming]
            LogsCmd[logs<br/>Log Aggregation]
            ComponentsCmd[components<br/>Component Listing]
        end

        subgraph Frameworks["Core Frameworks (pkg/)"]
            LintFramework["Lint Check Framework<br/>50+ checks<br/>Groups: Dependency → Service →<br/>Platform → Component → Workload"]
            MigrationFramework["Migration Action Framework<br/>Prepare/Run lifecycle<br/>Dry-run support<br/>Phase: pre-upgrade / post-upgrade"]
            BackupPipeline["Backup Pipeline<br/>Discovery → Dep Resolution → Writing<br/>Parallel workers"]
            DepManager["Dependency Manager<br/>odh-gitops manifest parsing<br/>OLM catalog validation"]
        end

        subgraph MCP["MCP Server (embedded)"]
            MCPStdio["stdio transport"]
            MCPSSE["SSE transport<br/>8080/TCP"]
            MCPTools["12 MCP Tools<br/>All CLI commands exposed"]
        end

        LintCmd --> LintFramework
        MigrateCmd --> MigrationFramework
        BackupCmd --> BackupPipeline
        DepsCmd --> DepManager
        MCPTools --> Commands
    end

    User[User / kubectl] -->|"kubectl odh lint<br/>kubectl odh migrate"| Commands
    AIAgent[AI Agent] -->|"JSON-RPC<br/>stdio or SSE"| MCP

    subgraph KubeAPI["Kubernetes API Server (6443/TCP)"]
        CRDs["CRDs<br/>DSC, DSCI, InferenceService,<br/>Notebook, RayCluster, ..."]
        CoreAPI["Core API<br/>ConfigMaps, Secrets,<br/>Deployments, Namespaces"]
        OLM["OLM API<br/>Subscriptions, CSVs,<br/>PackageManifests"]
    end

    CLI -->|"client-go<br/>HTTPS / TLS 1.2+"| KubeAPI

    TrustyAI["TrustyAI Service<br/>(OpenShift Route)"]
    MigrationFramework -->|"HTTPS/443<br/>Metrics backup/restore"| TrustyAI

    GitOps["odh-gitops<br/>(GitHub)"]
    DepManager -->|"HTTPS/443<br/>Manifest refresh"| GitOps

    style CLI fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Commands fill:#bbdefb,stroke:#1565c0
    style Frameworks fill:#c8e6c9,stroke:#2e7d32
    style MCP fill:#fff9c4,stroke:#f9a825
    style KubeAPI fill:#f5f5f5,stroke:#616161
    style User fill:#4a90e2,color:#fff
    style AIAgent fill:#7c4dff,color:#fff
    style TrustyAI fill:#ffcc80,stroke:#e65100
    style GitOps fill:#ffcc80,stroke:#e65100
