graph TD
    subgraph Deployment["llm-d-async Deployment"]
        SA["ServiceAccount<br/>{release}-llm-d-async<br/>(created by Helm chart)"]
    end

    subgraph MetricsRBAC["Optional Metrics RBAC<br/>(--metrics-endpoint-auth)"]
        direction TB
        MetricsEndpoint["/metrics Endpoint<br/>9090/TCP"]
        SAR["SubjectAccessReview<br/>(controller-runtime)"]
        MetricsEndpoint -->|"validates access via"| SAR
        SAR -->|"checks against"| K8sAPI["Kubernetes API<br/>443/TCP mTLS"]
    end

    subgraph Secrets["Secrets"]
        direction TB
        RedisSecret["Secret: {release}-redis<br/>or user-provided<br/>Type: Opaque<br/>Key: url<br/>Purpose: Redis/Valkey connection URL<br/>Provisioned: Helm / manual<br/>Auto-rotate: No"]
        TLSSecret["Secret: user-provided<br/>(ap.tls.secretName)<br/>Type: kubernetes.io/tls<br/>Keys: ca.crt, tls.crt, tls.key<br/>Purpose: mTLS to inference gateway<br/>Provisioned: Manual / cert-manager<br/>Auto-rotate: No"]
    end

    subgraph ExternalAuth["External Auth Delegation"]
        direction TB
        RedisACL["Redis ACLs<br/>Queue-level access control"]
        GCPIAM["GCP IAM<br/>Subscription-level isolation<br/>Workload identity"]
    end

    subgraph SecurityHardening["Security Hardening"]
        direction TB
        NonRoot["Non-root: UID 1001"]
        ReadOnlyFS["Read-only root filesystem"]
        DroppedCaps["Dropped capabilities"]
        FIPS["FIPS: GOEXPERIMENT=<br/>strictfipsruntime<br/>CGO_ENABLED=1"]
        TLSMin["TLS min: 1.2<br/>(crypto/tls)"]
        RedactedLogs["--redis.url redacted<br/>in startup logs"]
    end

    SA -->|"mounts"| RedisSecret
    SA -->|"mounts"| TLSSecret
    SA -->|"optional auth"| MetricsEndpoint

    %% Note: No ClusterRoles or RoleBindings defined
    NoRBAC["Note: No ClusterRoles or<br/>RoleBindings defined by<br/>this component.<br/>Network isolation must be<br/>configured externally<br/>(no NetworkPolicy in Helm chart)."]

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style MetricsEndpoint fill:#f5a623,stroke:#333
    style SAR fill:#f5a623,stroke:#333
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style RedisSecret fill:#f8cecc,stroke:#b85450
    style TLSSecret fill:#f8cecc,stroke:#b85450
    style RedisACL fill:#dae8fc,stroke:#6c8ebf
    style GCPIAM fill:#dae8fc,stroke:#6c8ebf
    style NonRoot fill:#d5e8d4,stroke:#82b366
    style ReadOnlyFS fill:#d5e8d4,stroke:#82b366
    style DroppedCaps fill:#d5e8d4,stroke:#82b366
    style FIPS fill:#d5e8d4,stroke:#82b366
    style TLSMin fill:#d5e8d4,stroke:#82b366
    style RedactedLogs fill:#d5e8d4,stroke:#82b366
    style NoRBAC fill:#fff2cc,stroke:#d6b656,stroke-dasharray:5 5
