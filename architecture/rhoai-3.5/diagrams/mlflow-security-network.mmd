graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["ML Client SDK<br/>(in-cluster pod)"]
        Browser["Data Scientist<br/>Browser"]
    end

    subgraph Ingress["INGRESS (Optional)"]
        IngressCtrl["Kubernetes Ingress<br/>Host: configurable<br/>TLS Mode: SIMPLE"]
    end

    subgraph Application["APPLICATION (MLflow Server)"]
        direction TB

        subgraph Service["Service: mlflow (ClusterIP)"]
            direction TB
            MLflowServer["MLflow Tracking Server<br/>Port: 5000/TCP<br/>SA: mlflow<br/>runAsNonRoot, readOnlyRootFS<br/>drop ALL caps, seccomp RuntimeDefault"]
        end

        subgraph AuthLayer["Auth Middleware"]
            K8sAuthPlugin["kubernetes-auth<br/>SA Token + Namespace"]
            BasicAuthPlugin["basic-auth<br/>Username/Password"]
        end

        subgraph CryptoLayer["Crypto"]
            Envelope["AESGCM Envelope Encryption<br/>PBKDF2 600k iterations<br/>cryptography 46.0.7"]
        end

        MLflowServer --> AuthLayer
        MLflowServer --> CryptoLayer
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL wire protocol<br/>TLS optional<br/>Password auth"]
        MySQL["MySQL (alternative)<br/>3306/TCP<br/>TLS optional<br/>Password auth"]
    end

    subgraph ObjectStorage["OBJECT STORAGE"]
        S3["S3 / MinIO<br/>443/TCP or 9000/TCP<br/>HTTPS/HTTP<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS, TLS 1.2+<br/>ServiceAccount token"]
        Prometheus["Prometheus<br/>HTTP scrape 5000/TCP"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLM["LLM Providers<br/>(OpenAI, Anthropic,<br/>Bedrock, Gemini)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer / API Key"]
        DNS["DNS<br/>53/UDP, 53/TCP<br/>5353/UDP"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 5000/TCP<br/>Optional TLS<br/>kubernetes-auth (SA token)"| MLflowServer
    Browser -->|"HTTPS 443/TCP<br/>TLS (Ingress)"| IngressCtrl
    IngressCtrl -->|"HTTP 5000/TCP<br/>cluster-internal"| MLflowServer

    MLflowServer -->|"PostgreSQL 5432/TCP<br/>TLS optional<br/>Password"| PostgreSQL
    MLflowServer -->|"MySQL 3306/TCP<br/>TLS optional<br/>Password"| MySQL
    MLflowServer -->|"HTTPS 443/9000/TCP<br/>TLS 1.2+<br/>AWS IAM"| S3
    K8sAuthPlugin -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    MLflowServer -->|"HTTPS 443/TCP<br/>TLS 1.2+<br/>API Key"| LLM
    MLflowServer -->|"UDP/TCP 53<br/>No encryption"| DNS
    Prometheus -->|"HTTP 5000/TCP<br/>metrics scrape"| MLflowServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client,Browser external
    class IngressCtrl ingress
    class MLflowServer,K8sAuthPlugin,BasicAuthPlugin,Envelope application
    class PostgreSQL,MySQL,S3 datastore
    class LLM,DNS externalservice
    class K8sAPI,Prometheus platform
