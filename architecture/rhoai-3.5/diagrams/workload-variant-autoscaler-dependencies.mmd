graph LR
    WVA["Workload Variant<br/>Autoscaler"]

    %% External Dependencies (Required)
    WVA -->|"PromQL queries<br/>HTTPS/9090 or 9091"| Prometheus["Prometheus<br/>(Required)"]

    %% External Dependencies (Optional)
    WVA -.->|"CRD Watch + Patch<br/>ScaledObject mgmt"| KEDA["KEDA v2.18+<br/>(Optional)"]
    WVA -.->|"CRD Watch + Scale<br/>multi-replica inference"| LWS["LeaderWorkerSet v0.8+<br/>(Optional)"]
    WVA -.->|"Node label discovery<br/>nvidia.com/gpu.*"| NVIDIAOp["NVIDIA GPU Operator<br/>(Optional)"]
    WVA -.->|"Node label discovery<br/>amd.com/gpu.*"| AMDOp["AMD GPU Operator<br/>(Optional)"]
    WVA -.->|"Node label discovery<br/>gpu.intel.com/*"| IntelOp["Intel GPU Plugin<br/>(Optional)"]

    %% Internal Platform Dependencies
    WVA -->|"CRD Watch<br/>endpoint pool discovery"| InferencePool["InferencePool<br/>(Gateway API<br/>Inference Extension)"]
    WVA -->|"CRD Watch + Patch<br/>llm-d.ai/managed: true"| HPA["HPA<br/>(autoscaling/v2)"]
    WVA -->|"CRD Read<br/>monitoring config"| ServiceMonitor["Prometheus Operator<br/>(ServiceMonitor)"]
    WVA -->|"Direct pod scraping<br/>Bearer Token auth"| EPP["EPP<br/>(Endpoint Picker Proxy)"]

    %% Integration Points (consumers of WVA)
    HPA -->|"reads wva_desired_replicas<br/>via Prometheus"| WVA
    KEDA -.->|"reads wva_desired_replicas<br/>via Prometheus"| WVA

    %% Kubernetes Resources
    WVA -->|"Watch + Scale<br/>HTTPS/443 mTLS"| Deployments["Deployments<br/>(apps/v1)"]
    WVA -->|"Read labels<br/>GPU inventory"| Nodes["Nodes<br/>(v1)"]
    WVA -->|"Read<br/>GPU quota caps"| ResourceQuota["ResourceQuota<br/>(v1)"]
    WVA -->|"Watch + Bootstrap<br/>runtime config"| ConfigMaps["ConfigMaps<br/>(v1)"]

    %% Cross-repo sync
    WVA -.->|"manifest sync<br/>GitHub Actions"| KServe["KServe<br/>(cross-repo sync)"]

    %% Library dependency
    WVA -->|"In-process<br/>Go library"| KalmanFilter["Kalman Filter<br/>(llm-inferno)"]

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External required
    style Prometheus fill:#e74c3c,stroke:#333,color:#fff

    %% External optional
    style KEDA fill:#999,stroke:#333,color:#fff
    style LWS fill:#999,stroke:#333,color:#fff
    style NVIDIAOp fill:#999,stroke:#333,color:#fff
    style AMDOp fill:#999,stroke:#333,color:#fff
    style IntelOp fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI
    style InferencePool fill:#7ed321,stroke:#333
    style HPA fill:#7ed321,stroke:#333
    style ServiceMonitor fill:#7ed321,stroke:#333
    style EPP fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333

    %% K8s resources
    style Deployments fill:#f5a623,stroke:#333
    style Nodes fill:#f5a623,stroke:#333
    style ResourceQuota fill:#f5a623,stroke:#333
    style ConfigMaps fill:#f5a623,stroke:#333

    %% Library
    style KalmanFilter fill:#9b59b6,stroke:#333,color:#fff
