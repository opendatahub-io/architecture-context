graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mcp-lifecycle-module-operator-<br/>controller-manager"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB["mcp-lifecycle-module-operator-<br/>manager-rolebinding<br/>(Cluster-wide)"]
    end

    subgraph ClusterRole["ClusterRole: manager-role"]
        CR["mcp-lifecycle-module-operator-<br/>manager-role"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR

    subgraph PlatformCRDs["Platform CRDs (components.platform.opendatahub.io)"]
        MCPLifecycleOpRes["mcplifecycleoperators<br/>+ /status + /finalizers"]
    end

    subgraph MCPResources["MCP Resources (mcp.x-k8s.io)"]
        MCPServers["mcpservers<br/>+ /status + /finalizers"]
    end

    subgraph K8sExtensions["API Extensions (apiextensions.k8s.io)"]
        CRDs["customresourcedefinitions"]
    end

    subgraph AppsAPI["Apps API (apps)"]
        Deployments["deployments"]
    end

    subgraph CoreAPI["Core API"]
        Services["services"]
        ServiceAcctsRes["serviceaccounts"]
        Namespaces["namespaces"]
        ConfigMaps["configmaps"]
        Secrets["secrets<br/>(read-only)"]
        Pods["pods<br/>(read-only)"]
        Events["events<br/>(create, patch)"]
    end

    subgraph RBACAPI["RBAC API (rbac.authorization.k8s.io)"]
        Roles["roles"]
        RoleBindings["rolebindings"]
        ClusterRoles["clusterroles"]
        ClusterRoleBindings["clusterrolebindings"]
    end

    subgraph AuthAPI["Auth APIs"]
        TokenReviews["tokenreviews<br/>(authentication.k8s.io)<br/>(create only)"]
        SAR["subjectaccessreviews<br/>(authorization.k8s.io)<br/>(create only)"]
    end

    subgraph InfraAPI["Infrastructure APIs"]
        APIServers["apiservers<br/>(config.openshift.io)<br/>(read-only)"]
        NetworkPolicies["networkpolicies<br/>(networking.k8s.io)"]
        Leases["leases<br/>(coordination.k8s.io)"]
        ServiceMonitors["servicemonitors<br/>(monitoring.coreos.com)"]
    end

    %% Full CRUD permissions
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| MCPLifecycleOpRes
    CR -->|"get,list,watch,create,update,<br/>patch,delete,deletecollection"| MCPServers
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| CRDs
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| Deployments
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| Services
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| ServiceAcctsRes
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| Namespaces
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| ConfigMaps
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| Roles
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| RoleBindings
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| ClusterRoles
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| ClusterRoleBindings
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| Leases
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| NetworkPolicies
    CR -->|"get,list,watch,create,<br/>update,patch,delete"| ServiceMonitors

    %% Read-only permissions
    CR -->|"get,list,watch"| Secrets
    CR -->|"get,list"| Pods
    CR -->|"get,list,watch"| APIServers

    %% Create-only permissions
    CR -->|"create,patch"| Events
    CR -->|"create"| TokenReviews
    CR -->|"create"| SAR

