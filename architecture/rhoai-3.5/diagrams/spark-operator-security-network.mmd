graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph K8sLayer["KUBERNETES API LAYER"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: redhat-ods-applications<br/>NetworkPolicy enforced"]
        direction TB

        WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP<br/>TLS 1.2+ (self-signed or cert-manager)"]

        subgraph OperatorPods["Operator Deployments"]
            Webhook["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>9443/TCP webhook<br/>8080/TCP metrics<br/>8081/TCP health<br/>failurePolicy: Fail"]
            Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>8080/TCP metrics<br/>8081/TCP health"]
        end

        ModuleCtrl["spark-operator-module controller<br/>8081/TCP health"]
    end

    subgraph TenantNS["TENANT NAMESPACES (per-namespace isolation)"]
        direction TB

        subgraph SparkPods["Spark Workload Pods"]
            Driver["Spark Driver Pod<br/>SA: spark-operator-spark<br/>7078/TCP RPC<br/>7079/TCP Block Mgr<br/>No encryption"]
            Executors["Spark Executor Pods<br/>7078/TCP RPC<br/>7079/TCP Block Mgr<br/>No encryption"]
            ConnectSvr["SparkConnect Server<br/>15002/TCP gRPC<br/>7078/TCP, 7079/TCP<br/>4040/TCP Web UI<br/>No encryption"]
        end

        Workbench["Dashboard Workbench<br/>(gRPC client)"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        direction TB
        Prometheus["Prometheus<br/>Scrapes 8080/TCP, 8090/TCP<br/>HTTP, No encryption"]
        OpenShiftAPI["OpenShift API Server<br/>443/TCP HTTPS TLS 1.2+<br/>TLS profile detection"]
        CertManager["cert-manager<br/>(optional)<br/>Certificate/Issuer CRDs"]
        PlatformOp["rhods-operator<br/>Creates SparkOperator CR"]
    end

    subgraph OptionalExternal["OPTIONAL EXTERNAL"]
        RESTSubmitter["REST Submitter<br/>HTTPS TLS 1.2+<br/>Optional mTLS"]
        SparkIngress["Spark Web UI Ingress<br/>80/TCP HTTP<br/>TLS configurable"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token / client cert"| K8sAPI

    %% API Server to Webhook
    K8sAPI -->|"HTTPS/443→9443<br/>TLS 1.2+<br/>API server client cert"| WebhookSvc
    WebhookSvc --> Webhook

    %% Controller to API
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Webhook -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Controller creates workloads
    Controller -.->|"creates via API"| Driver
    Controller -.->|"creates via API"| ConnectSvr
    Driver -.->|"creates via API<br/>SA: spark-operator-spark"| Executors

    %% Internal Spark comms
    Driver <-->|"TCP/7078,7079<br/>No encryption"| Executors

    %% SparkConnect
    Workbench -->|"gRPC/15002<br/>No encryption<br/>No auth"| ConnectSvr
    ConnectSvr -.->|"creates via API"| Executors

    %% Platform services
    Prometheus -->|"HTTP/8080<br/>No encryption"| Controller
    Prometheus -->|"HTTP/8080<br/>No encryption"| Webhook
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| OpenShiftAPI
    CertManager -.->|"manages certs"| Webhook
    PlatformOp -->|"creates SparkOperator CR"| ModuleCtrl
    ModuleCtrl -.->|"deploys"| Controller
    ModuleCtrl -.->|"deploys"| Webhook

    %% Optional
    Controller -.->|"HTTPS<br/>TLS 1.2+<br/>Optional mTLS"| RESTSubmitter
    Controller -.->|"creates"| SparkIngress

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8s fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef optional fill:#fce4ec,stroke:#c62828,stroke-width:1px,stroke-dasharray: 5

    class User external
    class K8sAPI k8s
    class WebhookSvc,Webhook,Controller,ModuleCtrl operator
    class Driver,Executors,ConnectSvr,Workbench tenant
    class Prometheus,OpenShiftAPI,CertManager,PlatformOp platform
    class RESTSubmitter,SparkIngress optional
