graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["manager-rolebinding<br/>(cluster-scoped)"]
        CRB2["rbac-escalate-rolebinding<br/>(cluster-scoped)"]
        RB1["leader-election-rolebinding<br/>(system namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["manager-role"]
        CR2["manager-rbac-escalate-role"]
        CR3["leader-election-role"]
    end

    subgraph APIResources_Platform["Platform Resources"]
        Workbenches["components.platform.opendatahub.io<br/>workbenches, /status, /finalizers"]
        HardwareProfiles["infrastructure.opendatahub.io<br/>hardwareprofiles"]
    end

    subgraph APIResources_Core["Core Resources"]
        Namespaces["core<br/>namespaces"]
        ConfigMaps["core<br/>configmaps"]
        Secrets["core<br/>secrets"]
        ServiceAccts["core<br/>serviceaccounts"]
        Services["core<br/>services"]
        Events["core<br/>events"]
    end

    subgraph APIResources_Apps["Apps Resources"]
        Deployments["apps<br/>deployments"]
    end

    subgraph APIResources_RBAC["RBAC Resources"]
        Roles["rbac.authorization.k8s.io<br/>roles, rolebindings"]
        ClusterRolesRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings"]
    end

    subgraph APIResources_Admission["Admission Resources"]
        WebhookConfigs["admissionregistration.k8s.io<br/>mutating/validating<br/>webhookconfigurations"]
    end

    subgraph APIResources_CRDs["CRD Resources"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Notebooks["kubeflow.org<br/>notebooks"]
        ImageStreamsRes["image.openshift.io<br/>imagestreams"]
    end

    subgraph APIResources_Auth["Auth Resources"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    %% Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| RB1
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2
    RB1 -->|grants| CR3

    %% manager-role permissions
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Workbenches
    CR1 -->|"get"| HardwareProfiles
    CR1 -->|"get,list,watch,<br/>create,update,patch"| Namespaces
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ConfigMaps
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Secrets
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ServiceAccts
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Services
    CR1 -->|"create,patch"| Events
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Deployments
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Roles
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ClusterRolesRes
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| WebhookConfigs
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| CRDs
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Notebooks
    CR1 -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ImageStreamsRes
    CR1 -->|"create"| SAR
    CR1 -->|"get,list,watch"| APIServers

    %% escalate role
    CR2 -->|"bind,escalate<br/>(scoped resourceNames)"| ClusterRolesRes

