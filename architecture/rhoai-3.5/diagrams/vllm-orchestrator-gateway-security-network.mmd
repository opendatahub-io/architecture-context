graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph GatewayZone["GATEWAY SERVICE"]
        direction TB
        Gateway["vllm-orchestrator-gateway<br/>Rust/axum 0.7.9<br/>Listen: 0.0.0.0:8090/TCP<br/>Auth: NONE (passthrough only)"]

        subgraph RouteEndpoints["Dynamic Route Endpoints"]
            RouteN["POST /{route_name}/v1/chat/completions<br/>Headers forwarded: Authorization, X-Forwarded-*<br/>Other headers: DROPPED"]
        end

        subgraph TLSConfig["TLS Client Configuration"]
            TLS["native-tls + openssl crate<br/>Client cert: /etc/tls/private/tls.{crt,key}<br/>CA cert: /etc/tls/ca/service-ca.crt<br/>PEM → PKCS#12 conversion"]
        end

        Gateway --- RouteEndpoints
        Gateway --- TLSConfig
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        direction TB
        Orchestrator["FMS Guardrails Orchestrator<br/>8085/TCP (configurable)<br/>POST /api/v2/chat/completions-detection<br/>HTTP or HTTPS"]

        subgraph OrchestratorBackends["Orchestrator Backends (indirect)"]
            vLLM["vLLM Inference Server<br/>(gateway does not call directly)"]
            Detectors["Guardrails Detectors<br/>(e.g., regex-detector)<br/>(gateway does not call directly)"]
        end

        Orchestrator --> vLLM
        Orchestrator --> Detectors
    end

    subgraph CertProviders["CERTIFICATE PROVISIONING"]
        ServiceCA["OpenShift service-ca-operator<br/>Provides: /etc/tls/ca/service-ca.crt"]
        ServingCert["service-serving-cert-signer<br/>Provides: /etc/tls/private/tls.{crt,key}<br/>Auto-Rotate: Unknown"]
    end

    subgraph ConfigSources["CONFIGURATION"]
        ConfigMap["Kubernetes ConfigMap<br/>GATEWAY_CONFIG env<br/>/app/config/config.yaml"]
    end

    %% Network Flows
    Client -->|"HTTP/8090<br/>Plaintext (no TLS)<br/>Auth: passthrough only<br/>⚠ No token validation"| Gateway
    Gateway -->|"HTTP or HTTPS/8085<br/>Optional mTLS<br/>Auth header forwarded<br/>⚠ danger_accept_invalid_hostnames<br/>when host=localhost"| Orchestrator

    %% Certificate provisioning
    ServiceCA -.->|"CA cert"| TLSConfig
    ServingCert -.->|"Client cert + key"| TLSConfig
    ConfigMap -.->|"Route + detector config"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef certprov fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef config fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway,RouteN,TLS gateway
    class Orchestrator,vLLM,Detectors internal
    class ServiceCA,ServingCert certprov
    class ConfigMap config
