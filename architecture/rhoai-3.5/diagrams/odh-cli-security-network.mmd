graph TB
    subgraph Client["CLIENT SIDE (User Workstation / Container)"]
        CLI["odh-cli (rhai-cli / kubectl-odh)<br/>FIPS: strictfipsruntime + CGO<br/>Auth: kubeconfig identity<br/>Throttle: QPS=50, Burst=100"]
    end

    subgraph MCPLayer["MCP SERVER (Optional, Embedded)"]
        direction LR
        MCPStdio["MCP stdio Transport<br/>stdin/stdout<br/>JSON-RPC<br/>No encryption (local)"]
        MCPSSE["MCP SSE Transport<br/>8080/TCP localhost<br/>HTTP + SSE<br/>No encryption (localhost)"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (Trusted)"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforcement"]

        subgraph ReadResources["Resources Accessed (READ)"]
            direction LR
            DSC["DSC, DSCI<br/>(opendatahub.io)"]
            ISVC["InferenceService<br/>ServingRuntime<br/>(serving.kserve.io)"]
            NB["Notebook<br/>(kubeflow.org)"]
            OLMRes["Subscription, CSV<br/>PackageManifest<br/>(OLM)"]
            MeshRes["SMCP, SMMR, SMM<br/>(maistra.io)"]
            KnativeRes["KnativeServing<br/>KnativeEventing<br/>(knative.dev)"]
            WorkloadRes["RayCluster, RayJob<br/>PyTorchJob, DSPA<br/>LlamaStack, Kueue"]
        end

        subgraph WriteResources["Resources Modified (MIGRATION ONLY)"]
            direction LR
            PatchRes["PATCH: Notebooks,<br/>InferenceServices,<br/>DSPAs, ConfigMaps"]
            TempRBAC["CREATE: temp SA,<br/>Role, RoleBinding<br/>(owner-referenced)"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        direction TB
        TrustyAI["TrustyAI Service<br/>OpenShift Route<br/>443/TCP HTTPS<br/>TLS 1.2 ⚠ InsecureSkipVerify<br/>Auth: Bearer Token"]
        GitHub["odh-gitops (GitHub)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: None (public)"]
    end

    %% AI Agent connection
    AIAgent["AI Agent"] -->|"JSON-RPC<br/>Inherited kubeconfig"| MCPStdio
    AIAgent -->|"JSON-RPC<br/>Inherited kubeconfig"| MCPSSE
    MCPLayer -->|"Cloned ConfigFlags<br/>per invocation"| CLI

    %% Main flows
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig<br/>(Bearer/Cert/OIDC)<br/>SelfSubjectAccessReview"| K8sAPI
    K8sAPI --- ReadResources
    K8sAPI --- WriteResources

    CLI -->|"HTTPS/443<br/>TLS 1.2 ⚠ InsecureSkipVerify<br/>Bearer Token<br/>Migration only"| TrustyAI
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>--refresh flag only"| GitHub

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef cluster fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef external fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef mcp fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef warning fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef agent fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px

    class CLI client
    class K8sAPI,DSC,ISVC,NB,OLMRes,MeshRes,KnativeRes,WorkloadRes,PatchRes,TempRBAC cluster
    class GitHub external
    class TrustyAI warning
    class MCPStdio,MCPSSE mcp
    class AIAgent agent
