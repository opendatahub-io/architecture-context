graph TB
    subgraph Client["CLIENT ENVIRONMENT (User Notebook / CI Pipeline)"]
        SDK["Kubeflow SDK v0.3.0+rhai0<br/>Python Client Library<br/>Auth: kubeconfig / SA token"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token Auth"]
    end

    subgraph DataPlane["KUBERNETES DATA PLANE (Ephemeral Pods)"]
        direction TB

        subgraph TrainingPod["Training Pod (Namespace: {user-namespace})"]
            TrainProcess["Training Process<br/>Injected via inspect.getsource()"]
            MetricsServer["HTTP Metrics Server<br/>28080/TCP HTTP<br/>No Encryption<br/>No Auth<br/>(pod network only)"]
            CheckpointMgr["JIT Checkpoint Manager<br/>SIGTERM handler<br/>Background LIFO upload"]
            TermLog["/dev/termination-log<br/>Final metrics capture"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM Credentials"]
        ModelReg["Model Registry Server<br/>443 or 8080/TCP<br/>HTTPS or HTTP<br/>User Token (optional)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Access Token (optional)"]
        PyPI["PyPI / Custom Index<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
    end

    %% Client to Control Plane
    SDK -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>CRD: TrainJob, Experiment,<br/>SparkConnectServer CRUD"| K8sAPI
    SDK -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>Core: Pods, Logs,<br/>Events, Secrets"| K8sAPI

    %% Control Plane creates pods
    K8sAPI -.->|"Operator reconciles<br/>TrainJob → JobSet → Pods"| TrainingPod

    %% Training Pod egress
    CheckpointMgr -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS credentials (envFrom)<br/>⚠ ssl_verify=False option"| S3

    %% SDK direct to external
    SDK -->|"HTTPS or HTTP<br/>443 or 8080/TCP<br/>TLS optional<br/>User Token"| ModelReg
    TrainProcess -->|"HTTPS/443<br/>TLS 1.2+<br/>Access Token"| HFHub
    TrainProcess -->|"HTTPS/443<br/>TLS 1.2+<br/>pip install"| PyPI

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef controlplane fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef dataplane fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef external fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef warning fill:#ffebee,stroke:#c62828,stroke-width:2px

    class SDK client
    class K8sAPI controlplane
    class TrainProcess,MetricsServer,CheckpointMgr,TermLog dataplane
    class S3,ModelReg,HFHub,PyPI external
