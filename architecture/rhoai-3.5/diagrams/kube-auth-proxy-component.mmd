graph TB
    subgraph KAP["kube-auth-proxy (Go Service)"]
        direction TB
        Router["gorilla/mux Router<br/>4180/TCP or 443/TCP"]

        subgraph Middleware["Middleware Chain (alice)"]
            direction TB
            K8sTokenMW["K8s Token Validator<br/>pkg/middleware/k8s_token_session.go"]
            JWTSessionMW["JWT Session Loader<br/>pkg/middleware/jwt_session.go"]
            OAuthSessionMW["OAuth Session Loader<br/>pkg/middleware/oauth_session.go"]
            StoredSessionMW["Stored Session Loader<br/>pkg/middleware/stored_session.go"]
            HeadersMW["Headers Injector<br/>pkg/middleware/headers.go"]
            K8sTokenMW --> JWTSessionMW
            JWTSessionMW --> OAuthSessionMW
            OAuthSessionMW --> StoredSessionMW
            StoredSessionMW --> HeadersMW
        end

        subgraph Providers["Auth Providers"]
            direction LR
            OIDCProvider["OIDC Provider<br/>providers/oidc.go"]
            OpenShiftProvider["OpenShift OAuth Provider<br/>providers/openshift.go"]
        end

        subgraph Endpoints["Endpoints"]
            direction LR
            SignIn["/oauth2/sign_in"]
            Start["/oauth2/start"]
            Callback["/oauth2/callback"]
            SignOut["/oauth2/sign_out"]
            AuthEP["/oauth2/auth<br/>(ext_authz)"]
            UserInfo["/oauth2/userinfo"]
            Proxy["/* (catch-all proxy)"]
            Health["/ping, /ready"]
            Metrics["/metrics"]
        end

        subgraph SessionStores["Session Stores"]
            direction LR
            CookieStore["Cookie Store<br/>AES-GCM / AES-CFB"]
            RedisStore["Redis Store<br/>(optional)"]
        end

        subgraph Special["Specialized Handlers"]
            MLflowDeny["MLflow Auth Deny<br/>pkg/authdeny/mlflow.go"]
        end

        Router --> Middleware
        Middleware --> Endpoints
        Endpoints --> Providers
        Endpoints --> SessionStores
        SignIn --> MLflowDeny
    end

    %% External actors
    User["User Browser"] -->|"HTTPS/443 or HTTP/4180<br/>TLS 1.2+"| Router
    Envoy["Envoy Proxy"] -->|"ext_authz request<br/>HTTP/HTTPS"| AuthEP
    SAClient["K8s Service Account<br/>Client"] -->|"Bearer SA token<br/>HTTP/HTTPS"| Router

    %% External services
    OIDCProvider -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC Discovery + PKCE"| OIDCIdP["OIDC Identity Provider"]
    OpenShiftProvider -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth flow"| OSAuth["OpenShift OAuth Server"]
    K8sTokenMW -->|"HTTPS/443<br/>TokenReview API"| K8sAPI["Kubernetes API Server"]
    OpenShiftProvider -->|"HTTPS/443<br/>User/Token APIs"| OSAPI["OpenShift API"]
    RedisStore -->|"TCP/6379<br/>Optional TLS"| Redis["Redis"]
    Proxy -->|"HTTP/HTTPS<br/>X-Forwarded-* headers"| Upstream["Upstream Application"]

    %% Styling
    style KAP fill:#e8f4fd,stroke:#4a90e2,stroke-width:3px
    style Router fill:#4a90e2,color:#fff
    style Middleware fill:#fff3e0,stroke:#f5a623
    style Providers fill:#e8f5e9,stroke:#66bb6a
    style Endpoints fill:#f3e5f5,stroke:#ab47bc
    style SessionStores fill:#fff8e1,stroke:#ffa726
    style Special fill:#fce4ec,stroke:#ef5350
    style User fill:#f9f9f9,stroke:#999
    style Envoy fill:#f9f9f9,stroke:#999
    style SAClient fill:#f9f9f9,stroke:#999
    style OIDCIdP fill:#e0e0e0,stroke:#666
    style OSAuth fill:#e0e0e0,stroke:#666
    style K8sAPI fill:#e0e0e0,stroke:#666
    style OSAPI fill:#e0e0e0,stroke:#666
    style Redis fill:#e0e0e0,stroke:#666
    style Upstream fill:#c8e6c9,stroke:#388e3c
