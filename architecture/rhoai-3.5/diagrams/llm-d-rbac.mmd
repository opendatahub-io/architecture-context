graph TD
    subgraph Note["RBAC Note"]
        direction TB
        Info["No RBAC resources defined in llm-d meta-repository.<br/>RBAC is defined in component repositories."]
    end

    subgraph ComponentRBAC["RBAC Defined Elsewhere"]
        direction TB

        subgraph EPP_RBAC["llm-d-inference-scheduler"]
            EPP_SA["ServiceAccount<br/>epp-controller"]
            EPP_CR["ClusterRole<br/>EPP routing permissions"]
            EPP_SA -->|"bound via ClusterRoleBinding"| EPP_CR
            EPP_CR -->|"watch, list"| InferencePool["inference.networking.x-k8s.io<br/>InferencePool"]
            EPP_CR -->|"watch, list"| InferenceObjective["inference.networking.x-k8s.io<br/>InferenceObjective"]
            EPP_CR -->|"get, list, watch"| Pods["core<br/>Pods"]
            EPP_CR -->|"get, list, watch"| Endpoints["core<br/>Endpoints"]
        end

        subgraph KV_RBAC["llm-d-kv-cache"]
            KV_SA["ServiceAccount<br/>kv-cache-indexer"]
            KV_CR["ClusterRole<br/>KV cache permissions"]
            KV_SA -->|"bound via ClusterRoleBinding"| KV_CR
        end

        subgraph GAIE_RBAC["Gateway API Inference Extension"]
            GAIE_CR["ClusterRole<br/>GAIE controller"]
            GAIE_CR -->|"CRUD"| InferencePool2["InferencePool"]
            GAIE_CR -->|"CRUD"| InferenceModelRewrite["InferenceModelRewrite"]
        end
    end

    subgraph Secrets["Secrets Referenced"]
        HFToken["hf-token<br/>Type: Opaque<br/>Purpose: HuggingFace Hub auth<br/>Provisioned: Manual<br/>Auto-rotate: No"]
    end

    subgraph ModelServerSecurity["Model Server Security Posture"]
        NonRoot["Runs as non-root<br/>UID: 2000, GID: 0"]
        RestrictedSCC["Compatible with<br/>OpenShift restricted SCC"]
        NoAuth["No pod-level auth<br/>Auth delegated to Gateway"]
        NonRoot --- RestrictedSCC
        RestrictedSCC --- NoAuth
    end

    %% Styling
    style Info fill:#fff3cd,stroke:#856404,color:#856404
    style EPP_SA fill:#4a90e2,stroke:#333,color:#fff
    style EPP_CR fill:#f5a623,stroke:#333,color:#fff
    style KV_SA fill:#4a90e2,stroke:#333,color:#fff
    style KV_CR fill:#f5a623,stroke:#333,color:#fff
    style GAIE_CR fill:#f5a623,stroke:#333,color:#fff
    style InferencePool fill:#7ed321,stroke:#333,color:#fff
    style InferenceObjective fill:#7ed321,stroke:#333,color:#fff
    style InferencePool2 fill:#7ed321,stroke:#333,color:#fff
    style InferenceModelRewrite fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style Endpoints fill:#7ed321,stroke:#333,color:#fff
    style HFToken fill:#f8cecc,stroke:#b85450
    style NonRoot fill:#d5e8d4,stroke:#82b366
    style RestrictedSCC fill:#d5e8d4,stroke:#82b366
    style NoAuth fill:#f8cecc,stroke:#b85450
