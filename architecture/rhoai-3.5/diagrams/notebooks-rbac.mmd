graph TD
    subgraph "Workbench Pod Security Model"
        direction TB

        subgraph "Authentication Layer (External)"
            UserToken["User OAuth Token<br/>(OpenShift)"]
        end

        subgraph "Authorization Enforcement (Sidecar)"
            KRP["kube-rbac-proxy Sidecar<br/>(injected by notebook controller)"]
            KRP_Check["Validates:<br/>1. OAuth token authenticity<br/>2. User RBAC access to<br/>Notebook CR namespace"]
        end

        subgraph "Workbench Container (No Auth)"
            WorkbenchUser["Runs as: UID 1001<br/>(unprivileged)"]
            SAToken["ServiceAccount Token<br/>(mounted by controller)"]
        end

        subgraph "Kubernetes RBAC Dependencies"
            direction LR
            NS_RBAC["Namespace RBAC<br/>User must have access<br/>to Notebook CR namespace"]
            SA_RBAC["ServiceAccount Permissions<br/>Inherited from namespace<br/>default SA or custom SA"]
        end
    end

    subgraph "Platform RBAC (External to Component)"
        direction TB

        subgraph "Notebook Controller Permissions"
            NC_SA["SA: notebook-controller-manager"]
            NC_CR["ClusterRole:<br/>notebook-controller-role"]
            NC_Res["Resources:<br/>- notebooks.kubeflow.org (CRUD)<br/>- pods, services (CRUD)<br/>- mutatingwebhookconfigurations"]
        end

        subgraph "rhods-operator Permissions"
            OP_SA["SA: rhods-operator"]
            OP_CR["ClusterRole:<br/>rhods-operator-role"]
            OP_Res["Resources:<br/>- imagestreams (CRUD)<br/>- configmaps (CRUD)<br/>- kustomize deployment"]
        end
    end

    %% Flows
    UserToken -->|"presented to"| KRP
    KRP -->|"validates via"| KRP_Check
    KRP_Check -->|"checks"| NS_RBAC
    KRP_Check -->|"if valid, proxies to"| WorkbenchUser
    WorkbenchUser -->|"uses"| SAToken
    SAToken -->|"scoped by"| SA_RBAC

    NC_SA -->|"bound via"| NC_CR
    NC_CR -->|"grants access to"| NC_Res

    OP_SA -->|"bound via"| OP_CR
    OP_CR -->|"grants access to"| OP_Res

    %% Styling
    style UserToken fill:#e1f5fe,stroke:#01579b
    style KRP fill:#ffe6cc,stroke:#d79b00
    style KRP_Check fill:#ffe6cc,stroke:#d79b00
    style WorkbenchUser fill:#d5e8d4,stroke:#82b366
    style SAToken fill:#d5e8d4,stroke:#82b366
    style NS_RBAC fill:#f5a623,stroke:#333,color:#fff
    style SA_RBAC fill:#f5a623,stroke:#333,color:#fff
    style NC_SA fill:#4a90e2,stroke:#333,color:#fff
    style NC_CR fill:#4a90e2,stroke:#333,color:#fff
    style NC_Res fill:#dae8fc,stroke:#6c8ebf
    style OP_SA fill:#9c27b0,stroke:#333,color:#fff
    style OP_CR fill:#9c27b0,stroke:#333,color:#fff
    style OP_Res fill:#e1bee7,stroke:#9c27b0
