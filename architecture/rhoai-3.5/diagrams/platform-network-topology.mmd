graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Clients["External Clients<br/>Data Scientists, API Consumers"]
    end

    subgraph Ingress["INGRESS (Gateway API + OpenShift Routes)"]
        direction TB
        DashboardGW["ODH Dashboard<br/>OpenShift Route 443/TCP to 8080/TCP<br/>HTTPS TLS 1.3<br/>OAuth2/OIDC via kube-auth-proxy"]
        KServeGW["KServe Inference Gateway<br/>Gateway API HTTPRoute<br/>443/TCP to 8012/TCP<br/>HTTPS TLS 1.3<br/>Kuadrant AuthPolicy (bearer/anon/apikey)"]
        NotebookGW["Notebook Gateway<br/>Gateway API HTTPRoute<br/>443/TCP to 8888/TCP<br/>HTTPS TLS 1.3<br/>OAuth2/OIDC via kube-auth-proxy"]
        KubeRayGW["KubeRay Dashboard Gateway<br/>Gateway API HTTPRoute<br/>443/TCP to 8265/TCP<br/>HTTPS TLS 1.3<br/>OAuth2/OIDC"]
        BatchGWIngress["Batch Gateway<br/>Gateway API HTTPRoute<br/>443/TCP to 8080/TCP<br/>HTTPS TLS 1.3<br/>Bearer token"]
    end

    subgraph PlatformGW["PLATFORM GATEWAY (Envoy Data Plane)"]
        EnvoyGW["Envoy Gateway<br/>ext_authz to kube-auth-proxy<br/>ext_proc to llm-d Router"]
        KubeAuthProxySvc["kube-auth-proxy<br/>OAuth2/OIDC validation<br/>Token introspection"]
    end

    subgraph NS_Operator["Namespace: redhat-ods-operator"]
        RhodsOp["rhods-operator<br/>SA: rhods-operator<br/>Leader election, webhook 9443/TCP"]
    end

    subgraph NS_Apps["Namespace: redhat-ods-applications"]
        direction TB
        Dashboard["odh-dashboard<br/>SA: odh-dashboard<br/>8080/TCP HTTP + 8443/TCP kube-rbac-proxy"]
        KServCtrl["KServe Controller<br/>SA: kserve-controller-manager<br/>8443/TCP metrics, 9443/TCP webhook"]
        LLMISCtrl["LLMInferenceService Controller<br/>SA: kserve-controller-manager<br/>8443/TCP metrics, 9443/TCP webhook"]
        ODHModelCtrl2["odh-model-controller<br/>SA: odh-model-controller<br/>8443/TCP kube-rbac-proxy"]
        ModelRegOp["Model Registry Operator<br/>SA: model-registry-operator<br/>8443/TCP kube-rbac-proxy"]
        AIGatewayOp2["AI Gateway Operator<br/>SA: ai-gateway-operator"]
        MCPLifecycleOp["MCP Lifecycle Operator<br/>SA: mcp-lifecycle-operator"]
        PlatformGWPod["Platform Gateway Pod<br/>Envoy + kube-auth-proxy<br/>8443/TCP HTTPS"]
    end

    subgraph NS_Monitoring["Namespace: redhat-ods-monitoring"]
        Prometheus["Prometheus<br/>9090/TCP"]
        AlertManager["AlertManager<br/>9093/TCP"]
    end

    subgraph NS_Istio["Namespace: istio-system / redhat-ods-istio"]
        Istiod["Istiod Control Plane<br/>15012/TCP xDS, 15014/TCP metrics"]
        IstioIngress["Istio Ingress Gateway<br/>(when mesh enabled)"]
    end

    subgraph NS_User["User Namespaces (per-project)"]
        direction TB
        DSPA["DSPA Instance<br/>SA: ds-pipeline<br/>8888/TCP API, 8887/TCP gRPC<br/>kube-rbac-proxy 8443/TCP"]
        Notebooks["Notebook Servers<br/>8888/TCP Jupyter"]
        InferSvc["KServe InferenceServices<br/>8080/TCP HTTP, 8033/TCP gRPC<br/>8000/TCP model server"]
        LLMDRouterPod["llm-d Router (EPP)<br/>ext_proc gRPC 9002/TCP<br/>Metrics 9090/TCP"]
        MLflowInst["MLflow Instance<br/>SA: mlflow<br/>5000/TCP HTTP<br/>kube-rbac-proxy 8443/TCP"]
        ModelRegInst["Model Registry Instance<br/>SA: model-registry<br/>8080/TCP REST, 9090/TCP gRPC"]
        TrustyAISvc["TrustyAI Service<br/>SA: trustyai-service<br/>8080/TCP HTTP<br/>kube-rbac-proxy 8443/TCP"]
        RayClusters["Ray Clusters<br/>SA: ray-worker<br/>6379/TCP head, 8265/TCP dashboard"]
        ArgoCtrl["Argo Workflows Controller<br/>SA: argo"]
        EvalHubSvc["EvalHub<br/>SA: evalhub<br/>8080/TCP REST<br/>kube-rbac-proxy 8443/TCP"]
        GORCHSvc["GORCH Orchestrator<br/>8000/TCP HTTP, 8034/TCP health"]
    end

    subgraph NS_AIGWInfra["Namespace: redhat-ai-gateway-infra"]
        MaaSDBConfig["MaaS DB Configuration<br/>Cross-namespace secret migration"]
    end

    subgraph Egress["EGRESS (External Services)"]
        S3Svc["S3 / Object Storage<br/>443/TCP HTTPS<br/>AWS IAM / static credentials"]
        ContainerReg2["Container Registry<br/>quay.io, registry.redhat.io<br/>443/TCP HTTPS<br/>Pull secrets"]
        K8sAPISvc["Kubernetes API Server<br/>6443/TCP HTTPS<br/>ServiceAccount tokens"]
        NVIDIANgc["NVIDIA NGC API<br/>443/TCP HTTPS<br/>(disabled in air-gapped mode)"]
    end

    %% External to Ingress
    Clients -->|"HTTPS 443"| DashboardGW
    Clients -->|"HTTPS 443"| KServeGW
    Clients -->|"HTTPS 443"| NotebookGW
    Clients -->|"HTTPS 443"| KubeRayGW
    Clients -->|"HTTPS 443"| BatchGWIngress

    %% Ingress to Platform Gateway
    DashboardGW -->|"HTTP 8080"| PlatformGWPod
    KServeGW -->|"HTTPRoute"| PlatformGWPod
    NotebookGW -->|"HTTPRoute"| PlatformGWPod
    KubeRayGW -->|"HTTPRoute"| PlatformGWPod
    BatchGWIngress -->|"HTTPRoute"| PlatformGWPod

    %% Platform Gateway to services
    PlatformGWPod -->|"ext_authz"| KubeAuthProxySvc
    PlatformGWPod -->|"HTTP 8080"| Dashboard
    PlatformGWPod -->|"HTTP 8012"| InferSvc
    PlatformGWPod -->|"HTTP 8888"| Notebooks
    PlatformGWPod -->|"HTTP 8265"| RayClusters
    PlatformGWPod -->|"ext_proc gRPC 9002"| LLMDRouterPod

    %% Internal service-to-service
    Dashboard -->|"REST 8080, service-ca TLS"| DSPA
    Dashboard -->|"REST 8080"| ModelRegInst
    Dashboard -->|"REST 8080"| EvalHubSvc
    Dashboard -->|"REST 5000"| MLflowInst
    Dashboard -->|"HTTPS 6443, SA token"| K8sAPISvc

    KServCtrl -->|"HTTPS 6443, SA token"| K8sAPISvc
    LLMISCtrl -->|"creates resources"| InferSvc
    LLMISCtrl -->|"creates resources"| LLMDRouterPod
    ODHModelCtrl2 -->|"REST 8080"| ModelRegInst
    ODHModelCtrl2 -->|"HTTPS 6443, SA token"| K8sAPISvc

    DSPA -->|"gRPC 8887"| ArgoCtrl
    DSPA -->|"HTTPS 443, IAM"| S3Svc

    InferSvc -->|"mTLS via Istio"| TrustyAISvc
    InferSvc -->|"HTTPS 443, IAM"| S3Svc
    InferSvc -->|"HTTPS 443, pull secret"| ContainerReg2

    ModelRegInst -->|"HTTPS 443, IAM"| S3Svc
    MLflowInst -->|"HTTPS 443, IAM"| S3Svc

    TrustyAISvc -->|"HTTP 8080"| InferSvc
    GORCHSvc -->|"HTTP 8000"| InferSvc

    RhodsOp -->|"HTTPS 6443, SA token"| K8sAPISvc

    %% Monitoring
    Prometheus -->|"scrape 8443, 8080, 9090"| Dashboard
    Prometheus -->|"scrape 8443"| KServCtrl
    Prometheus -->|"scrape 8443"| DSPA
    Prometheus -->|"scrape 9090"| LLMDRouterPod

    %% Istio mesh
    Istiod -.->|"xDS config push"| InferSvc
    Istiod -.->|"xDS config push"| TrustyAISvc
    Istiod -.->|"xDS config push"| GORCHSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef gateway fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef apps fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef mesh fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef user fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Clients external
    class DashboardGW,KServeGW,NotebookGW,KubeRayGW,BatchGWIngress ingress
    class EnvoyGW,KubeAuthProxySvc,PlatformGWPod gateway
    class RhodsOp operator
    class Dashboard,KServCtrl,LLMISCtrl,ODHModelCtrl2,ModelRegOp,AIGatewayOp2,MCPLifecycleOp apps
    class Prometheus,AlertManager monitoring
    class Istiod,IstioIngress mesh
    class DSPA,Notebooks,InferSvc,LLMDRouterPod,MLflowInst,ModelRegInst,TrustyAISvc,RayClusters,ArgoCtrl,EvalHubSvc,GORCHSvc user
    class S3Svc,ContainerReg2,K8sAPISvc,NVIDIANgc egress
    class MaaSDBConfig gateway
