graph TB
    subgraph External["External Access"]
        Browser[Browser / User]
    end

    subgraph Gateway["Gateway API"]
        GW["data-science-gateway<br/>443/TCP HTTPS"]
    end

    subgraph DashboardPod["odh-dashboard Pod"]
        direction TB

        subgraph AuthProxy["Auth Proxy"]
            KRBP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS termination + RBAC"]
        end

        subgraph Core["Core Services"]
            Backend["Dashboard Backend<br/>(Node.js/Fastify)<br/>8080/TCP HTTP"]
            Frontend["React SPA<br/>(PatternFly 6.4)"]
            CoreBFF["core-bff<br/>(Go)<br/>4000/TCP"]
        end

        subgraph ModuleFederation["Module Federation (Sidecar BFFs)"]
            direction LR
            GenAI["gen-ai BFF<br/>8143/TCP"]
            ModelReg["model-registry BFF<br/>8043/TCP"]
            MaaS["maas BFF<br/>8243/TCP"]
            MLflow["mlflow BFF<br/>8343/TCP"]
            EvalHub["eval-hub BFF<br/>8543/TCP"]
            AutoML["automl BFF<br/>8643/TCP"]
            AutoRAG["autorag BFF<br/>8743/TCP"]
            AgentOps["agent-ops BFF<br/>8843/TCP"]
        end
    end

    subgraph Operator["Dashboard Operator"]
        DashOp["dashboard-operator<br/>(Go controller-runtime)<br/>Webhook: 9443/TCP<br/>Metrics: 8443/TCP<br/>Health: 8081/TCP"]
    end

    subgraph CRDs["Custom Resources"]
        DashboardCR["Dashboard CR<br/>(components.platform.opendatahub.io)"]
        OdhConfig["OdhDashboardConfig CR"]
        OdhApp["OdhApplication CR"]
    end

    %% External access flow
    Browser -->|HTTPS/443| GW
    GW -->|HTTPS/8443| KRBP
    KRBP -->|HTTP/8080<br/>x-forwarded-access-token| Backend
    Backend -->|serves| Frontend

    %% Module federation routing
    Backend -->|/_mf/gen-ai/*| GenAI
    Backend -->|/_mf/model-registry/*| ModelReg
    Backend -->|/_mf/maas/*| MaaS
    Backend -->|/_mf/mlflow/*| MLflow
    Backend -->|/_mf/eval-hub/*| EvalHub
    Backend -->|/_mf/automl/*| AutoML
    Backend -->|/_mf/autorag/*| AutoRAG
    Backend -->|/_mf/agent-ops/*| AgentOps

    %% Inter-BFF communication
    GenAI -.->|inter-BFF| MaaS
    GenAI -.->|inter-BFF| MLflow

    %% Operator manages Dashboard CR
    DashOp -->|reconciles| DashboardCR
    DashOp -->|manages| DashboardPod

    %% CRD relationships
    Backend -->|watches| OdhConfig
    Backend -->|watches| OdhApp

    %% Styling
    style Browser fill:#f9f9f9,stroke:#333
    style GW fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style KRBP fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Backend fill:#4a90e2,stroke:#333,color:#fff
    style Frontend fill:#4a90e2,stroke:#333,color:#fff
    style CoreBFF fill:#4a90e2,stroke:#333,color:#fff
    style DashOp fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style GenAI fill:#dae8fc,stroke:#6c8ebf
    style ModelReg fill:#dae8fc,stroke:#6c8ebf
    style MaaS fill:#dae8fc,stroke:#6c8ebf
    style MLflow fill:#dae8fc,stroke:#6c8ebf
    style EvalHub fill:#dae8fc,stroke:#6c8ebf
    style AutoML fill:#dae8fc,stroke:#6c8ebf
    style AutoRAG fill:#dae8fc,stroke:#6c8ebf
    style AgentOps fill:#dae8fc,stroke:#6c8ebf
    style DashboardCR fill:#f5a623,stroke:#333
    style OdhConfig fill:#f5a623,stroke:#333
    style OdhApp fill:#f5a623,stroke:#333
