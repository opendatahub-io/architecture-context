graph TB
    subgraph "Platform Operator"
        rhods["rhods-operator<br/>(24 reverse deps)<br/>Platform lifecycle manager"]
    end

    subgraph "Core Platform Services"
        KubeRBACProxy["kube-rbac-proxy<br/>Auth enforcement sidecar"]
        KubeAuthProxy["kube-auth-proxy<br/>OAuth2/OIDC Gateway auth"]
        Kueue["Kueue<br/>Workload scheduling"]
        Gateway["Platform Gateway<br/>Gateway API + Envoy"]
    end

    subgraph "Model Serving Stack"
        KServe["KServe<br/>(16 reverse deps)<br/>Model serving foundation"]
        ODHModelCtrl["odh-model-controller<br/>Serving extensions"]
        ModelRegistry["Model Registry<br/>(5 reverse deps)<br/>Metadata catalog"]
        WVA["Workload Variant Autoscaler<br/>GPU-aware scaling"]
    end

    subgraph "LLM Inference Stack (llm-d)"
        LLMDRouter["llm-d Router (EPP)<br/>Load-aware routing"]
        LLMDRoutingSidecar["llm-d Routing Sidecar"]
        BatchGW["Batch Gateway<br/>Batch inference API"]
        AIGatewayOp["AI Gateway Operator<br/>MaaS controller"]
        AIGatewayPayload["AI Gateway Payload Processing<br/>API translation + metering"]
    end

    subgraph "ML Pipeline & Training"
        DSPO["Data Science Pipelines<br/>Operator (DSPO)"]
        ArgoWF["Argo Workflows<br/>Pipeline execution"]
        TrainerOp["Trainer Operator<br/>Distributed training"]
        KubeRayOp["KubeRay Operator<br/>Ray cluster management"]
        CodeFlareSDK["CodeFlare SDK<br/>Pipeline runner"]
        MLMD["ML Metadata (MLMD)<br/>gRPC Server"]
    end

    subgraph "Experiment & Evaluation"
        MLflowOp["MLflow Operator"]
        MLflow["MLflow<br/>Experiment tracking"]
        TrustyAIOp["TrustyAI Service Operator<br/>Fairness + evaluation"]
        EvalHub["EvalHub<br/>Model evaluation backend"]
        NeMoGuardrails["NeMo Guardrails<br/>Content moderation"]
        GORCH["FMS Guardrails Orchestrator"]
    end

    subgraph "User Interface & MCP"
        Dashboard["odh-dashboard<br/>Dashboard web UI + BFF"]
        NotebookCtrl["Kubeflow Notebook Controller<br/>Workbench management"]
        MCPLifecycle["MCP Lifecycle Operator"]
        MCPServer["RHOAI MCP Server"]
        OGXOp["OGX K8s Operator"]
    end

    subgraph "External Services"
        S3["S3 / Object Storage"]
        ContainerReg["Container Registry<br/>quay.io / registry.redhat.io"]
        K8sAPI["Kubernetes API"]
    end

    %% rhods-operator deploys everything
    rhods -->|deploys| KServe
    rhods -->|deploys| DSPO
    rhods -->|deploys| Dashboard
    rhods -->|deploys| TrustyAIOp
    rhods -->|deploys| ModelRegistry
    rhods -->|deploys| MLflowOp
    rhods -->|deploys| AIGatewayOp
    rhods -->|deploys| MCPLifecycle
    rhods -->|deploys| NotebookCtrl
    rhods -->|deploys| KubeRayOp
    rhods -->|deploys| TrainerOp
    rhods -->|deploys| Gateway
    rhods -->|deploys| OGXOp

    %% KServe dependencies
    KServe -->|orchestrates| LLMDRouter
    KServe -->|orchestrates| WVA
    KServe -->|metadata| ModelRegistry
    KServe -->|routes via| Gateway
    ODHModelCtrl -->|extends| KServe
    ODHModelCtrl -->|AuthPolicy| Gateway
    ODHModelCtrl -->|labels| ModelRegistry

    %% AI Gateway / MaaS
    AIGatewayOp -->|manages| KServe
    AIGatewayPayload -->|ext_proc| Gateway
    BatchGW -->|routes via| Gateway

    %% Pipeline dependencies
    DSPO -->|deploys| ArgoWF
    DSPO -->|creates InferenceService| KServe
    DSPO -->|metadata| MLMD
    DSPO -->|stores models| ModelRegistry
    CodeFlareSDK -->|creates RayCluster| KubeRayOp

    %% Training
    TrainerOp -->|workload admission| Kueue
    KubeRayOp -->|workload admission| Kueue

    %% Experiment & Evaluation
    MLflowOp -->|deploys| MLflow
    TrustyAIOp -->|monitors| KServe
    TrustyAIOp -->|deploys| EvalHub
    TrustyAIOp -->|deploys| GORCH
    EvalHub -->|evaluates models| KServe
    GORCH -->|intercepts| NeMoGuardrails

    %% Dashboard integrations
    Dashboard -->|serving UI| KServe
    Dashboard -->|model catalog| ModelRegistry
    Dashboard -->|pipeline UI| DSPO
    Dashboard -->|experiment UI| MLflow
    Dashboard -->|evaluation UI| EvalHub
    Dashboard -->|workbench UI| NotebookCtrl

    %% MCP Server
    MCPServer -->|serving| KServe
    MCPServer -->|pipelines| DSPO
    MCPServer -->|notebooks| NotebookCtrl
    MCPServer -->|models| ModelRegistry

    %% Notebook Controller
    NotebookCtrl -->|pipeline execution| DSPO
    NotebookCtrl -->|experiment tracking| MLflow

    %% kube-rbac-proxy sidecar injection
    KubeRBACProxy -.->|sidecar| KubeRayOp
    KubeRBACProxy -.->|sidecar| NotebookCtrl
    KubeRBACProxy -.->|sidecar| Dashboard
    KubeRBACProxy -.->|sidecar| TrustyAIOp
    KubeRBACProxy -.->|sidecar| EvalHub
    KubeRBACProxy -.->|sidecar| DSPO
    KubeRBACProxy -.->|sidecar| ODHModelCtrl

    %% Gateway auth
    KubeAuthProxy -.->|ext_authz| Gateway

    %% External dependencies
    KServe -->|model artifacts| S3
    ModelRegistry -->|artifact storage| S3
    DSPO -->|pipeline artifacts| S3
    MLflow -->|experiment artifacts| S3
    KServe -->|pull images| ContainerReg
    rhods -->|API calls| K8sAPI

