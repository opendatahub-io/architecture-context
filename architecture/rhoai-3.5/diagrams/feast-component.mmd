graph TB
    subgraph FeastOperator["feast-operator (Go Operator)"]
        Controller["FeatureStore Controller<br/>controller-runtime<br/>8081/TCP health, 8080/TCP metrics"]
        NotebookReconciler["NotebookConfigMap<br/>Reconciler"]
        AccessController["Auto-Access<br/>RBAC Controller"]
        MetricsExporter["Prometheus<br/>Metrics Exporter"]
    end

    subgraph FeatureServer["feature-server (Python)"]
        FastAPIServer["FastAPI / Gunicorn / Uvicorn<br/>6566/TCP HTTP, 6567/TCP HTTPS"]
        SecurityManager["Feast SecurityManager<br/>OIDC / K8s RBAC"]
        MCPServer["MCP Server<br/>(Model Context Protocol)"]
    end

    subgraph Registry["Feast Registry"]
        RegistryREST["Registry REST API<br/>6572/TCP HTTP, 6573/TCP HTTPS"]
        RegistryGRPC["Registry gRPC<br/>6570/TCP, 6571/TCP TLS"]
    end

    subgraph UI["feast-ui (React)"]
        FeastUI["Web UI<br/>8888/TCP HTTP, 8443/TCP HTTPS"]
    end

    %% CRDs
    User[Data Scientist / ML Engineer] -->|creates| FeatureStoreCR["FeatureStore CR<br/>(feast.dev/v1)"]
    FeatureStoreCR -->|watched by| Controller

    %% Operator creates resources
    Controller -->|creates| FeatureServer
    Controller -->|creates| Registry
    Controller -->|creates| UI
    Controller -->|creates| CronJob["Materialization<br/>CronJob"]
    Controller -->|creates| HPA["HorizontalPodAutoscaler"]
    Controller -->|creates| PDB["PodDisruptionBudget"]
    Controller -->|creates| ServiceMonitor["ServiceMonitor"]

    %% Access controller
    Controller -->|triggers| AccessController
    AccessController -->|reads permissions| RegistryREST
    AccessController -->|creates| RBACBindings["RBAC Roles &<br/>RoleBindings"]

    %% Notebook integration
    NotebookReconciler -->|watches| Notebooks["ODH Notebooks<br/>(kubeflow.org)"]
    NotebookReconciler -->|creates| ConfigMaps["Feast Client<br/>ConfigMaps"]

    %% Feature serving flow
    MLApp["ML Model / Application"] -->|/get-online-features| FastAPIServer
    FastAPIServer -->|auth check| SecurityManager
    FastAPIServer -->|feature lookup| RegistryGRPC
    FastAPIServer -->|feature data| OnlineStore["Online Store<br/>(Redis/PostgreSQL/etc.)"]

    %% CronJob flow
    CronJob -->|materializes| RegistryGRPC
    CronJob -->|reads| OfflineStore["Offline Store<br/>(DuckDB/PostgreSQL/etc.)"]
    CronJob -->|writes| OnlineStore

    %% External dependencies
    Controller -->|API calls| K8sAPI["Kubernetes API<br/>443/TCP"]
    Controller -->|TLS profile| OpenShiftAPI["OpenShift API<br/>443/TCP"]
    SecurityManager -->|token validation| OIDCProvider["OIDC Provider<br/>443/TCP"]

    %% UI route
    FeastUI -->|browsing| RegistryREST
    Route["OpenShift Route<br/>443/TCP HTTPS"] -->|passthrough| FeastUI

    %% Styles
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style NotebookReconciler fill:#4a90e2,stroke:#333,color:#fff
    style AccessController fill:#4a90e2,stroke:#333,color:#fff
    style MetricsExporter fill:#4a90e2,stroke:#333,color:#fff
    style FastAPIServer fill:#50a14f,stroke:#333,color:#fff
    style SecurityManager fill:#50a14f,stroke:#333,color:#fff
    style MCPServer fill:#50a14f,stroke:#333,color:#fff
    style RegistryREST fill:#e5a00d,stroke:#333,color:#fff
    style RegistryGRPC fill:#e5a00d,stroke:#333,color:#fff
    style FeastUI fill:#9b59b6,stroke:#333,color:#fff
    style FeatureStoreCR fill:#f5a623,stroke:#333
    style OnlineStore fill:#e8e8e8,stroke:#333
    style OfflineStore fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style OIDCProvider fill:#e8e8e8,stroke:#333
