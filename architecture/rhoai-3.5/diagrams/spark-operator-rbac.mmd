graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["spark-operator-controller"]
        SA_Webhook["spark-operator-webhook"]
        SA_Spark["spark-operator-spark<br/>(driver pods)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Controller["spark-operator-controller<br/>(cluster-wide)"]
        CRB_Webhook["spark-operator-webhook<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Spark["spark-role-binding<br/>(deployment namespace)"]
        RB_Leader["leader-election-rolebinding<br/>(deployment namespace)"]
    end

    subgraph CR_Controller["ClusterRole: spark-operator-controller"]
        direction LR
        subgraph CoreAPI_C["Core API ('')"]
            Pods_C["pods<br/>get, list, watch,<br/>create, update, delete"]
            ConfigMaps_C["configmaps<br/>get, list, watch,<br/>create, update, patch"]
            Services_C["services<br/>get, list, watch, create,<br/>update, patch, delete"]
            Events_C["events<br/>create, update, patch"]
        end

        subgraph NetworkAPI_C["extensions / networking.k8s.io"]
            Ingresses_C["ingresses<br/>get, create,<br/>update, delete"]
            NetPol_C["networkpolicies<br/>create, delete, update"]
        end

        subgraph SparkAPI_C["sparkoperator.k8s.io"]
            SparkApps_C["sparkapplications<br/>+ /status, /finalizers<br/>get, list, watch,<br/>create, delete, update"]
            SchedApps_C["scheduledsparkapplications<br/>+ /status, /finalizers<br/>get, list, watch,<br/>update, patch"]
            SparkConn_C["sparkconnects<br/>+ /status, /finalizers<br/>get, list, watch, update"]
        end

        subgraph OtherAPI_C["Other APIs"]
            CRDs_C["apiextensions.k8s.io<br/>customresourcedefinitions<br/>get"]
            APIServers_C["config.openshift.io<br/>apiservers (cluster)<br/>get"]
            PDBs_C["policy<br/>poddisruptionbudgets<br/>get, list, watch,<br/>create, delete"]
        end
    end

    subgraph CR_Webhook["ClusterRole: spark-operator-webhook"]
        direction LR
        subgraph CoreAPI_W["Core API ('')"]
            Quotas_W["resourcequotas<br/>list"]
            Pods_W["pods<br/>list, watch"]
        end

        subgraph AdmissionAPI_W["admissionregistration.k8s.io"]
            MWC_W["mutatingwebhookconfigurations<br/>list, watch, get, update"]
            VWC_W["validatingwebhookconfigurations<br/>list, watch, get, update"]
        end

        subgraph SparkAPI_W["sparkoperator.k8s.io"]
            SparkApps_W["sparkapplications<br/>get, list, watch"]
            SchedApps_W["scheduledsparkapplications<br/>get, list, watch"]
        end
    end

    subgraph Role_Spark["Role: spark-role (driver pods)"]
        direction LR
        SparkResources["pods, configmaps,<br/>persistentvolumeclaims, services<br/>get, list, watch, create,<br/>update, patch, delete,<br/>deletecollection"]
    end

    %% Bindings
    SA_Controller -->|bound via| CRB_Controller
    CRB_Controller -->|grants| CR_Controller

    SA_Webhook -->|bound via| CRB_Webhook
    CRB_Webhook -->|grants| CR_Webhook

    SA_Spark -->|bound via| RB_Spark
    RB_Spark -->|grants| Role_Spark

    SA_Controller -->|bound via| RB_Leader

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Webhook fill:#4a90e2,stroke:#333,color:#fff
    style SA_Spark fill:#4a90e2,stroke:#333,color:#fff
    style CRB_Controller fill:#f5a623,stroke:#333
    style CRB_Webhook fill:#f5a623,stroke:#333
    style RB_Spark fill:#f5a623,stroke:#333
    style RB_Leader fill:#f5a623,stroke:#333
