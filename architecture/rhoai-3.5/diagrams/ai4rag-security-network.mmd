graph TB
    subgraph CallerProcess["CALLER PROCESS (KFP Pod / User Script)"]
        direction TB

        subgraph Library["ai4rag Library (in-process)"]
            direction LR
            Experiment["AI4RAGExperiment<br/>No listening ports<br/>SHA-256 chunk IDs (FIPS-safe)"]
            DocPipeline["Document Pipeline<br/>Multi-process text extraction<br/>SSL fallback: verify=False"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB

        OGX["OGX Server<br/>443/TCP HTTPS<br/>TLS (configurable)<br/>API Key (Bearer)"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS (SSL fallback)<br/>AWS SigV4 IAM"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>Public (no auth)"]
    end

    %% Egress flows
    Experiment -->|"HTTPS/443<br/>TLS<br/>API Key (Bearer)<br/>chat completions,<br/>embeddings, vector I/O"| OGX
    DocPipeline -->|"HTTPS/443<br/>TLS (SSL fallback)<br/>AWS SigV4<br/>list_objects, download"| S3
    DocPipeline -.->|"HTTPS/443<br/>TLS<br/>Public<br/>model artifacts<br/>(optional)"| HFHub

    %% Secrets
    subgraph Secrets["SECRETS (User-Provided)"]
        direction LR
        OGXKey["OGX API Key<br/>(Opaque)<br/>No auto-rotate"]
        AWSKey["AWS_ACCESS_KEY_ID<br/>(Opaque)<br/>No auto-rotate"]
        AWSSecret["AWS_SECRET_ACCESS_KEY<br/>(Opaque)<br/>No auto-rotate"]
    end

    OGXKey -.->|"authenticates"| Experiment
    AWSKey -.->|"authenticates"| DocPipeline
    AWSSecret -.->|"authenticates"| DocPipeline

    %% Security warnings
    Warning["WARNING: SSL fallback<br/>verify=False on SSL errors<br/>in ogx_client.py,<br/>documents_discovery.py,<br/>text_extraction.py"]

    %% Styling
    classDef caller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5

    class CallerProcess caller
    class Experiment,DocPipeline library
    class OGX,S3,HFHub external
    class OGXKey,AWSKey,AWSSecret secret
    class Warning warning
