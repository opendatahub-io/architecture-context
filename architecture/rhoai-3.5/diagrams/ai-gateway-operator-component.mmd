graph TB
    subgraph Platform["OpenDataHub / RHOAI Platform"]
        ODHOperator["opendatahub-operator<br/>(rhods-operator)"]
    end

    ODHOperator -->|creates| AIGatewayCR["AIGateway CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]

    subgraph AGO["AI Gateway Operator"]
        direction TB
        Controller["ai-gateway-operator<br/>Go controller-runtime"]
        InitContainer["copy-manifests<br/>(init container)"]
        KustomizeRender["Kustomize Renderer<br/>(in-memory)"]

        InitContainer -->|copies vendored manifests| KustomizeRender
        Controller -->|renders| KustomizeRender
    end

    AIGatewayCR -->|watched by| Controller

    subgraph BatchGW["Batch Gateway Sub-Component"]
        BGOperator["batch-gateway-operator"]
        BGAPIServer["Batch Gateway API Server"]
        BGProcessor["Batch Gateway Processor"]
        BGGC["Batch Gateway GC"]
        BGAsync["Async Processor"]

        BGOperator -->|manages| BGAPIServer
        BGOperator -->|manages| BGProcessor
        BGOperator -->|manages| BGGC
        BGOperator -->|manages| BGAsync
    end

    subgraph MaaS["MaaS Controller Sub-Component"]
        MaaSCtrl["maas-controller"]
        MaaSAPI["maas-api"]
        MaaSWebhook["Webhook Server<br/>443/TCP TLS"]

        MaaSCtrl -->|manages| MaaSAPI
        MaaSCtrl -->|serves| MaaSWebhook
    end

    Controller -->|"SSA deploy<br/>(batchGateway=Managed)"| BGOperator
    Controller -->|"SSA deploy<br/>(modelsAsAService=Managed)"| MaaSCtrl

    %% CRDs
    LLMBatchGatewayCR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1"]
    AITenantCR["AITenant CR<br/>maas.opendatahub.io/v1alpha1"]
    MaaSSubCR["MaaSSubscription CR"]
    ConfigCR["Config CR<br/>(Cluster-scoped)"]

    LLMBatchGatewayCR -->|watched by| BGOperator
    AITenantCR -->|watched by| MaaSCtrl
    MaaSSubCR -->|watched by| MaaSCtrl
    ConfigCR -->|watched by| MaaSCtrl

    %% Infrastructure
    Controller -->|creates| InfraNS["redhat-ai-gateway-infra<br/>(Infrastructure Namespace)"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style BGOperator fill:#7ed321,stroke:#333,color:#fff
    style MaaSCtrl fill:#7ed321,stroke:#333,color:#fff
    style MaaSWebhook fill:#f5a623,stroke:#333,color:#fff
    style AIGatewayCR fill:#f5a623,stroke:#333
    style LLMBatchGatewayCR fill:#f5a623,stroke:#333
    style AITenantCR fill:#f5a623,stroke:#333
    style MaaSSubCR fill:#f5a623,stroke:#333
    style ConfigCR fill:#f5a623,stroke:#333
    style ODHOperator fill:#9b59b6,stroke:#333,color:#fff
    style InfraNS fill:#e8e8e8,stroke:#333
