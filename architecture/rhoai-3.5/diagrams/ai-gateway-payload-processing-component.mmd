graph TB
    subgraph "AI Gateway Payload Processing"
        direction TB

        subgraph "CRD Controllers"
            EPController["ExternalProvider<br/>Controller"]
            EMController["ExternalModel<br/>Controller"]
            LegacyController["Legacy Migration<br/>Controller"]
        end

        subgraph "Plugin Pipeline (ext_proc)"
            direction LR
            HeadersGuard["maas-headers-guard"]
            ModelExtractor["model-extractor"]
            Resolver["model-provider-<br/>resolver"]
            StreamEnforcer["stream-usage-<br/>enforcer"]
            Translation["api-translation"]
            AuthInjection["apikey-injection"]

            HeadersGuard --> ModelExtractor --> Resolver --> StreamEnforcer --> Translation --> AuthInjection
        end

        subgraph "Optional Guardrails"
            NemoRequest["nemo-request-guard"]
            NemoResponse["nemo-response-guard"]
        end

        subgraph "Metering"
            Metering["external-metering<br/>(balance check + usage)"]
        end

        subgraph "Shared In-Memory Stores"
            InfoStore["infoStore<br/>(model→provider)"]
            SecretStore["secretStore<br/>(credentials)"]
        end

        EPController -->|populates| InfoStore
        EPController -->|populates| SecretStore
        EMController -->|populates| InfoStore
        Resolver -->|reads| InfoStore
        AuthInjection -->|reads| SecretStore
    end

    %% External inputs
    Client["Client"] -->|HTTPS/443| Gateway["Platform Gateway<br/>(Envoy)"]
    Gateway -->|gRPC ext_proc<br/>9004/TCP| HeadersGuard

    %% CRDs
    ExternalModelCR["ExternalModel CR<br/>inference.opendatahub.io/v1alpha1"] -->|watched by| EMController
    ExternalProviderCR["ExternalProvider CR<br/>inference.opendatahub.io/v1alpha1"] -->|watched by| EPController
    LegacyCR["Legacy ExternalModel CR<br/>maas.opendatahub.io"] -->|watched by| LegacyController
    LegacyController -->|creates| ExternalModelCR
    LegacyController -->|creates| ExternalProviderCR

    %% Controller outputs
    EMController -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    EPController -->|creates| Service["ExternalName Service"]
    EPController -->|creates| ServiceEntry["Istio ServiceEntry"]
    EPController -->|creates| DestRule["Istio DestinationRule"]

    %% External LLM providers
    AuthInjection -->|routed via Envoy| LLMProviders["External LLM Providers<br/>(OpenAI, Anthropic,<br/>Azure, Bedrock, Vertex AI)"]

    %% Guardrails
    NemoRequest -->|POST /v1/guardrail/checks| NemoService["NeMo Guardrails<br/>Service"]
    NemoResponse -->|POST /v1/guardrail/checks| NemoService

    %% Metering
    Metering -->|balance check / usage events| MeteringService["Metering Service"]

    %% K8s API
    EPController -->|Secret reads| K8sAPI["Kubernetes API<br/>6443/TCP"]
    EMController -->|resource CRUD| K8sAPI

    %% Styling
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style Gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style HeadersGuard fill:#4a90e2,color:#fff
    style ModelExtractor fill:#4a90e2,color:#fff
    style Resolver fill:#4a90e2,color:#fff
    style StreamEnforcer fill:#4a90e2,color:#fff
    style Translation fill:#4a90e2,color:#fff
    style AuthInjection fill:#4a90e2,color:#fff
    style NemoRequest fill:#9b59b6,color:#fff
    style NemoResponse fill:#9b59b6,color:#fff
    style Metering fill:#e67e22,color:#fff
    style EPController fill:#2ecc71,color:#fff
    style EMController fill:#2ecc71,color:#fff
    style LegacyController fill:#2ecc71,color:#fff
    style ExternalModelCR fill:#f5a623
    style ExternalProviderCR fill:#f5a623
    style LegacyCR fill:#f5a623,stroke-dasharray: 5 5
    style LLMProviders fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style NemoService fill:#e8e8e8,stroke:#333
    style MeteringService fill:#e8e8e8,stroke:#333
    style InfoStore fill:#d5e8d4,stroke:#82b366
    style SecretStore fill:#d5e8d4,stroke:#82b366
    style HTTPRoute fill:#dae8fc,stroke:#6c8ebf
    style Service fill:#dae8fc,stroke:#6c8ebf
    style ServiceEntry fill:#dae8fc,stroke:#6c8ebf
    style DestRule fill:#dae8fc,stroke:#6c8ebf
