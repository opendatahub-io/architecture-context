graph TB
    subgraph "MCP Lifecycle Operator"
        Controller["MCP Lifecycle Operator<br/>(controller-runtime)"]
        ConfigHash["Config Hash Computer<br/>(SHA-256)"]
        Handshake["MCP Protocol Handshake<br/>(go-sdk client)"]
        Ownership["Ownership Validator"]
        Metrics["Metrics Exporter<br/>8443/TCP HTTPS"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP"]
    end

    User["Platform User / Data Scientist"] -->|creates/updates| MCPServerCR["MCPServer CR<br/>(mcp.x-k8s.io/v1alpha1)"]
    MCPServerCR -->|watched by| Controller

    Controller -->|creates/updates| Deployment["Deployment<br/>(MCP Server Pod)"]
    Controller -->|creates/updates| Service["ClusterIP Service<br/>(MCP port)"]
    Controller -->|creates/updates| NetworkPolicy["NetworkPolicy<br/>(ingress-only)"]

    Controller --> ConfigHash
    ConfigHash -->|reads| ConfigMaps["ConfigMaps"]
    ConfigHash -->|reads| Secrets["Secrets"]
    ConfigHash -->|annotates config-hash| Deployment

    Controller --> Handshake
    Handshake -->|MCP Streamable HTTP| MCPServerPod["MCP Server Pod"]
    Handshake -->|updates capabilities| MCPServerCR

    Controller --> Ownership
    Ownership -->|validates SetControllerReference| Deployment
    Ownership -->|validates SetControllerReference| Service
    Ownership -->|validates SetControllerReference| NetworkPolicy

    Prometheus["Prometheus"] -->|scrapes /metrics| Metrics

    Controller -->|CRUD via HTTPS| K8sAPI["Kubernetes API Server<br/>443/TCP"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style ConfigHash fill:#4a90e2,stroke:#333,color:#fff
    style Handshake fill:#4a90e2,stroke:#333,color:#fff
    style Ownership fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbes fill:#4a90e2,stroke:#333,color:#fff
    style MCPServerCR fill:#f5a623,stroke:#333
    style Deployment fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style MCPServerPod fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets fill:#e8e8e8,stroke:#333
