graph TB
    subgraph KubeRayOperator["KubeRay Operator"]
        direction TB
        subgraph Controllers["Controllers"]
            RCCtrl["RayCluster Controller"]
            RJCtrl["RayJob Controller"]
            RSCtrl["RayService Controller"]
            RCJCtrl["RayCronJob Controller"]
            NPCtrl["NetworkPolicy Controller"]
            MTLSCtrl["mTLS Controller"]
            AuthCtrl["Authentication Controller"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutWH["Mutating Webhook<br/>(OpenShift defaults)"]
            ValRC["Validating: RayCluster"]
            ValRJ["Validating: RayJob"]
            ValRS["Validating: RayService"]
        end
    end

    %% CRDs
    RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    RayServiceCR["RayService CR<br/>(ray.io/v1)"]
    RayCronJobCR["RayCronJob CR<br/>(ray.io/v1)"]

    %% User interactions
    User["User / Data Scientist"]
    User -->|creates| RayClusterCR
    User -->|creates| RayJobCR
    User -->|creates| RayServiceCR
    User -->|creates| RayCronJobCR

    %% Webhook intercepts
    RayClusterCR -->|intercepted by| MutWH
    RayClusterCR -->|validated by| ValRC
    RayJobCR -->|validated by| ValRJ
    RayServiceCR -->|validated by| ValRS

    %% Controller watches
    RayClusterCR -->|watched by| RCCtrl
    RayJobCR -->|watched by| RJCtrl
    RayServiceCR -->|watched by| RSCtrl
    RayCronJobCR -->|watched by| RCJCtrl

    %% Controller creates resources
    RCCtrl -->|creates| HeadPod["Head Pod"]
    RCCtrl -->|creates| WorkerPods["Worker Pods"]
    RCCtrl -->|creates| HeadSvc["{cluster}-head-svc<br/>Headless Service"]
    RCCtrl -->|creates| ServeSvc["{cluster}-serve-svc<br/>ClusterIP Service"]
    RJCtrl -->|creates| SubmitterJob["Submitter Job Pod"]
    RSCtrl -->|manages| ServeConfig["Ray Serve Config"]
    RCJCtrl -->|creates on schedule| RayJobCR

    %% Satellite controllers
    RayClusterCR -->|annotation-gated| NPCtrl
    RayClusterCR -->|annotation-gated| MTLSCtrl
    RayClusterCR -->|annotation-gated| AuthCtrl

    NPCtrl -->|creates| NetworkPolicies["NetworkPolicies"]
    MTLSCtrl -->|creates| Certs["Certificates<br/>(cert-manager)"]
    AuthCtrl -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    AuthCtrl -->|injects| RBACProxy["kube-rbac-proxy<br/>sidecar"]

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    RCCtrl -->|manages resources| K8sAPI
    RJCtrl -->|submits jobs| RayDashboard["Ray Dashboard<br/>8265/TCP"]

    %% Styling
    style KubeRayOperator fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Controllers fill:#d5e8d4,stroke:#82b366
    style Webhooks fill:#fff2cc,stroke:#d6b656
    style RayClusterCR fill:#f5a623,stroke:#333
    style RayJobCR fill:#f5a623,stroke:#333
    style RayServiceCR fill:#f5a623,stroke:#333
    style RayCronJobCR fill:#f5a623,stroke:#333
    style RCCtrl fill:#4a90e2,color:#fff
    style RJCtrl fill:#4a90e2,color:#fff
    style RSCtrl fill:#4a90e2,color:#fff
    style RCJCtrl fill:#4a90e2,color:#fff
    style NPCtrl fill:#4a90e2,color:#fff
    style MTLSCtrl fill:#4a90e2,color:#fff
    style AuthCtrl fill:#4a90e2,color:#fff
    style MutWH fill:#e8e8e8,stroke:#333
    style ValRC fill:#e8e8e8,stroke:#333
    style ValRJ fill:#e8e8e8,stroke:#333
    style ValRS fill:#e8e8e8,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style RBACProxy fill:#7ed321,stroke:#333
    style NetworkPolicies fill:#7ed321,stroke:#333
    style Certs fill:#7ed321,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style RayDashboard fill:#999,stroke:#333,color:#fff
