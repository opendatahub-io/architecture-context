graph LR
    KAP["kube-auth-proxy<br/>(Auth Reverse Proxy)"]

    %% Internal Platform Dependencies
    KAP -->|"OIDC auth flow<br/>HTTPS/443"| OIDCIdP["OIDC Identity Provider<br/>(Keycloak, Azure AD)"]
    KAP -->|"OAuth code flow<br/>HTTPS/443"| OSAuth["OpenShift OAuth Server"]
    KAP -->|"User/Token APIs<br/>HTTPS/443"| OSAPI["OpenShift API"]
    KAP -->|"TokenReview API<br/>HTTPS/443"| K8sAPI["Kubernetes API Server"]
    KAP -->|"Session storage<br/>TCP(TLS)/6379"| Redis["Redis<br/>(optional)"]

    %% Upstream
    KAP -->|"Proxy requests<br/>X-Forwarded-* headers"| Upstream["Upstream Application"]

    %% Consumers / Callers
    Envoy["Envoy Proxy"] -->|"ext_authz<br/>HTTP(S)/4180"| KAP
    MLflow["MLflow Python Client"] -->|"HTTP requests<br/>JSON error responses"| KAP
    Prometheus["Prometheus"] -->|"/metrics scrape<br/>HTTP(S)"| KAP

    %% Deployment relationship
    RhodsOp["rhods-operator"] -.->|"Deploys as sidecar"| KAP

    %% Build-time Go Dependencies
    subgraph GoDeps["Key Go Dependencies"]
        direction TB
        OIDC["go-oidc/v3 v3.18.0"]
        OAuth2["golang.org/x/oauth2 v0.36.0"]
        ClientGo["k8s.io/client-go v0.35.3"]
        GoRedis["go-redis/v9 v9.17.0"]
        Mux["gorilla/mux v1.8.1"]
        Alice["justinas/alice v1.2.0"]
        PromClient["prometheus/client_golang v1.23.2"]
        JWT["golang-jwt/jwt/v5 v5.3.0"]
        Viper["spf13/viper v1.21.0"]
        XCrypto["golang.org/x/crypto v0.51.0"]
    end

    KAP -.->|"build deps"| GoDeps

    %% Styling
    style KAP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OIDCIdP fill:#f5a623,stroke:#333
    style OSAuth fill:#7ed321,stroke:#333
    style OSAPI fill:#7ed321,stroke:#333
    style K8sAPI fill:#7ed321,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style Upstream fill:#7ed321,stroke:#333
    style Envoy fill:#999,stroke:#333
    style MLflow fill:#999,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style RhodsOp fill:#7ed321,stroke:#333
    style GoDeps fill:#f0f0f0,stroke:#999,stroke-dasharray: 5 5
