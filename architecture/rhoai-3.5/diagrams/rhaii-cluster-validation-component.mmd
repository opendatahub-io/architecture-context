graph TB
    subgraph UserContext["User Context"]
        Admin["Cluster Admin<br/>(kubectl rhaii-validate)"]
    end

    subgraph ControllerBinary["RHAII Cluster Validation Controller"]
        CLI["rhaii-validator<br/>Go CLI / kubectl plugin"]
        ImageResolver["Image Resolver<br/>embed → env → flag"]
        PlatformDetect["Platform Detector<br/>AKS / EKS / CoreWeave / OCP"]
        TopologyEngine["GPU-NIC Topology Engine<br/>PCIe → NUMA → Bandwidth probe"]
        ReportAgg["Report Aggregator<br/>JSON → ConfigMap"]
    end

    subgraph EphemeralJobs["Ephemeral Validation Jobs (per GPU node)"]
        subgraph ValidatorPod["odh-rhaii-cluster-validator"]
            GPUCheck["GPU Check<br/>nvidia-smi / rocm-smi"]
            RDMACheck["RDMA Check<br/>ibstat / ibv_devices"]
            NUMACheck["NUMA Topology<br/>/sys/class/nvidia<br/>/sys/bus/pci"]
        end

        subgraph ToolsPod["odh-rhaii-validator-tools"]
            Iperf3["iperf3<br/>TCP bandwidth"]
            IBWriteBW["ib_write_bw<br/>RDMA bandwidth<br/>(CUDA GPUDirect)"]
            IBVPingpong["ibv_rc_pingpong<br/>RDMA connectivity"]
            TCPLat["tcp-lat<br/>TCP latency"]
        end
    end

    subgraph ClusterResources["Cluster Resources"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
        ConfigMap["ConfigMap<br/>(rhaii-validation namespace)<br/>Report storage"]
        SCC["OpenShift SCC<br/>privileged"]
    end

    subgraph HostResources["Host Node Resources"]
        GPUDriver["NVIDIA/AMD GPU Driver<br/>chroot /host"]
        SysFS["Host sysfs<br/>/sys/class/infiniband<br/>/sys/class/nvidia<br/>/sys/bus/pci"]
        RDMANIC["InfiniBand/RoCE NICs<br/>kernel bypass"]
    end

    subgraph CRDDeps["CRD Dependencies Validated"]
        GatewayAPI["Gateway API CRDs"]
        InferencePool["InferencePool CRD"]
        LWS["LeaderWorkerSet CRD"]
        CertMgrCRD["cert-manager CRD"]
    end

    %% Controller flows
    Admin -->|kubeconfig| CLI
    CLI --> ImageResolver
    CLI --> PlatformDetect
    CLI --> TopologyEngine
    CLI --> ReportAgg

    CLI -->|creates Jobs| K8sAPI
    CLI -->|reads pod logs| K8sAPI
    CLI -->|stores report| ConfigMap
    CLI -->|discovers CRDs| K8sAPI

    %% Job pod interactions
    K8sAPI -->|schedules| ValidatorPod
    K8sAPI -->|schedules| ToolsPod

    ValidatorPod -->|chroot /host| GPUDriver
    ValidatorPod -->|reads| SysFS
    ToolsPod -->|kernel bypass| RDMANIC

    %% CRD validation
    K8sAPI -.->|validates| GatewayAPI
    K8sAPI -.->|validates| InferencePool
    K8sAPI -.->|validates| LWS
    K8sAPI -.->|validates| CertMgrCRD

    %% SCC
    SCC -->|grants privileged| ValidatorPod
    SCC -->|grants privileged| ToolsPod

