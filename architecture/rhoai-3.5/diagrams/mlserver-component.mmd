    style AdaptiveBatch fill:#82b366,color:#fff
    style ParallelWorkers fill:#82b366,color:#fff
    style SKLearn fill:#f5a623,color:#fff
    style XGBoost fill:#f5a623,color:#fff
    style LightGBM fill:#f5a623,color:#fff
    style ONNX fill:#f5a623,color:#fff
    style CLI fill:#9b59b6,color:#fff
