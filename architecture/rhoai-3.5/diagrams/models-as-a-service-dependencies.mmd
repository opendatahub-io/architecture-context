graph LR
    MaaS["MaaS Platform<br/>(maas-controller +<br/>maas-api +<br/>payload-processing)"]

    %% External Dependencies (Required)
    MaaS -->|"AuthPolicy, TokenRateLimitPolicy<br/>AuthN/AuthZ + rate limiting"| Kuadrant["Kuadrant / RHCL<br/>1.3+"]
    MaaS -->|"LLMInferenceService CRD<br/>internal model backends"| KServe["KServe<br/>v0.19.0-rc0+"]
    MaaS -->|"HTTPRoute, Gateway<br/>model + API routing"| GatewayAPI["Gateway API<br/>v1.5.1"]
    MaaS -->|"ServiceEntry, DestinationRule<br/>EnvoyFilter, Telemetry"| Istio["Istio / OSSM"]
    MaaS -->|"API key storage<br/>validation + lifecycle"| PostgreSQL["PostgreSQL"]

    %% External Dependencies (Optional)
    MaaS -.->|"OpenTelemetryCollector<br/>usage logging"| OTel["OpenTelemetry<br/>Operator"]
    MaaS -.->|"Dashboards<br/>datasources"| Perses["Perses"]
    MaaS -.->|"PrometheusRules<br/>ServiceMonitors"| Prometheus["Prometheus<br/>Operator"]

    %% Internal Platform Dependencies
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"deploys controller<br/>DSCInitialization"| MaaS
    Authorino["Authorino"] -->|"REST callback<br/>API key validation<br/>subscription selection"| MaaS
    Limitador["Limitador"] -->|"rate limit enforcement<br/>TokenRateLimitPolicy"| MaaS
    Envoy["Envoy gateway<br/>(istio-proxy)"] -->|"EnvoyFilter ext_proc<br/>payload processing"| MaaS
    OSAuth["OpenShift<br/>Authentication"] -->|"OIDC issuer<br/>auto-detection"| MaaS

    %% External Services (Egress)
    MaaS -->|"model inference<br/>TLS origination"| ExtModels["External Model<br/>Providers<br/>(OpenAI, Azure, etc.)"]
    MaaS -->|"CRD watches, SSA<br/>TokenReview, SAR"| K8sAPI["Kubernetes API<br/>Server"]
    MaaS -.->|"distributed traces<br/>gRPC/4317"| OTLPCol["OTLP Collector"]
    MaaS -.->|"usage logs<br/>HTTPS/3100"| Loki["Loki"]

    %% Styling
    style MaaS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style KServe fill:#999,stroke:#333,color:#fff
