graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Data Science Gateway<br/>(Envoy)<br/>443/TCP → HTTPRoute<br/>TLS SIMPLE"]
        Router["OpenShift Router<br/>443/TCP → Route<br/>TLS reencrypt"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (NetworkPolicy Enforced)"]
        direction TB

        subgraph NS_Registry["Namespace: {registry-namespace}"]
            direction TB
            SvcReg["Service: {name}<br/>8443/TCP HTTPS + 8080/TCP HTTP"]
            subgraph RegPod["Model Registry Pod"]
                KRBP_Reg["kube-rbac-proxy sidecar<br/>8443/TCP TLS<br/>SA: {name}<br/>AuthZ: SubjectAccessReview<br/>(get services in NS)"]
                REST_Reg["model-registry REST<br/>8080/TCP HTTP<br/>ML model metadata API"]
            end
            NP_Reg["NetworkPolicy<br/>Ingress: router +<br/>odh namespaces only"]
            PG_Auto["Auto-provisioned PostgreSQL<br/>5432/TCP<br/>Password auth<br/>16-byte random creds"]
        end

        subgraph NS_Catalog["Namespace: operator namespace"]
            direction TB
            SvcCat["Service: model-catalog<br/>8443/TCP HTTPS"]
            subgraph CatPod["Model Catalog Pod"]
                KRBP_Cat["kube-rbac-proxy sidecar<br/>8443/TCP TLS<br/>SA: model-catalog<br/>AuthZ: SubjectAccessReview"]
                REST_Cat["model-catalog REST<br/>8080/TCP HTTP"]
            end
            PG_Cat["Catalog PostgreSQL<br/>5432/TCP<br/>Password auth, no SSL"]
        end

        subgraph NS_Operator["Namespace: operator namespace"]
            direction TB
            OperatorMgr["Operator Controller Manager<br/>SA: controller-manager"]
            Metrics["Metrics: 8443/TCP HTTPS<br/>kube-rbac-proxy auth"]
            Probes["Health: 8081/TCP HTTP<br/>/readyz/health, /healthz"]
            WebhookSvc["Webhooks: 9443/TCP HTTPS<br/>mutate + validate + convert"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        ServiceCA["OpenShift service-ca<br/>TLS cert provisioning<br/>Auto-rotate"]
        AuthCR["Auth CR<br/>Admin groups<br/>for catalog RBAC"]
    end

    subgraph ExternalDB["EXTERNAL DATABASES (User-Provided)"]
        UserPG["PostgreSQL<br/>5432/TCP<br/>Configurable SSL<br/>Password auth"]
        UserMySQL["MySQL<br/>3306/TCP<br/>Configurable SSL<br/>Password auth"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Router

    %% Ingress → Services
    Gateway -->|"HTTPS/8443<br/>TLS (serving cert)<br/>Passthrough"| SvcReg
    Gateway -->|"HTTPS/8443<br/>TLS (serving cert)"| SvcCat
    Router -->|"HTTPS/8443<br/>TLS reencrypt<br/>Passthrough"| SvcReg
    Router -->|"HTTPS/8443<br/>TLS reencrypt"| SvcCat

    %% Service → Pods
    SvcReg --> KRBP_Reg
    KRBP_Reg -->|"HTTP/8080<br/>localhost<br/>No auth"| REST_Reg
    SvcCat --> KRBP_Cat
    KRBP_Cat -->|"HTTP/8080<br/>localhost<br/>No auth"| REST_Cat

    %% App → DB
    REST_Reg -->|"PostgreSQL/5432<br/>Configurable SSL<br/>Password"| PG_Auto
    REST_Reg -->|"PostgreSQL/5432<br/>Configurable SSL"| UserPG
    REST_Reg -->|"MySQL/3306<br/>Configurable SSL"| UserMySQL
    REST_Cat -->|"PostgreSQL/5432<br/>No SSL<br/>Password"| PG_Cat

    %% Operator → K8s API
    OperatorMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ServiceCA -->|"TLS certs"| KRBP_Reg
    ServiceCA -->|"TLS certs"| KRBP_Cat
    AuthCR -.->|"watched by"| OperatorMgr

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externaldb fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authproxy fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef networkpolicy fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gateway,Router ingress
    class SvcReg,SvcCat,REST_Reg,REST_Cat,OperatorMgr,Metrics,Probes,WebhookSvc internal
    class KRBP_Reg,KRBP_Cat authproxy
    class K8sAPI,ServiceCA,AuthCR platform
    class UserPG,UserMySQL,PG_Auto,PG_Cat externaldb
    class NP_Reg networkpolicy
