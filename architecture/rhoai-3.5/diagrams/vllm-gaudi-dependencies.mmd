graph LR
    vllmGaudi["vllm-gaudi Plugin<br/>(odh-vllm-gaudi-rhel9)"]

    %% Core Required Dependencies
    vllmGaudi -->|"inference engine<br/>v0.16.0"| vLLM["vLLM<br/>v0.16.0"]
    vllmGaudi -->|"device drivers<br/>graph compiler"| SynapseAI["Intel Gaudi<br/>Synapse AI 1.23.0"]
    vllmGaudi -->|"tensor ops<br/>HPU support"| PyTorch["PyTorch<br/>2.9.0 (Habana)"]
    vllmGaudi -->|"model loading<br/>tokenization"| Transformers["transformers<br/>>= 4.56.0"]
    vllmGaudi -->|"media processing"| MediaLoader["habana-media-loader<br/>1.23.0.x"]
    vllmGaudi -->|"numerical"| NumPy["NumPy<br/>>= 1.26.0"]
    vllmGaudi -->|"data processing"| Pandas["pandas<br/>>= 2.2.3"]

    %% Optional Dependencies
    vllmGaudi -.->|"FP8 calibration<br/>(optional)"| INC["Intel Neural<br/>Compressor"]
    vllmGaudi -.->|"KV cache transfer<br/>(optional)"| NIXL["NIXL / UCX<br/>0.7.0"]
    vllmGaudi -.->|"multi-node<br/>(optional)"| Ray["Ray<br/>>= 2.48.0"]

    %% Internal Platform Dependencies
    KServe["KServe<br/>ServingRuntime"] -->|"deploys image"| vllmGaudi
    PlatformGW["Platform Gateway<br/>kube-rbac-proxy"] -->|"TLS + auth<br/>sidecar"| vllmGaudi
    PVC["HuggingFace Cache<br/>(PVC)"] -->|"model weights<br/>volume mount"| vllmGaudi

    %% External Services
    vllmGaudi -.->|"model download<br/>443/HTTPS"| HFHub["HuggingFace Hub"]

    %% CI/CD
    Konflux["konflux-central"] -.->|"Tekton pipelines"| vllmGaudi
    Renovate["Renovate"] -.->|"dep updates"| vllmGaudi

    %% Styling
    style vllmGaudi fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external deps
    style vLLM fill:#f5a623,stroke:#333,color:#fff
    style SynapseAI fill:#f5a623,stroke:#333,color:#fff
    style PyTorch fill:#f5a623,stroke:#333,color:#fff
    style Transformers fill:#999,stroke:#333,color:#fff
    style MediaLoader fill:#999,stroke:#333,color:#fff
    style NumPy fill:#999,stroke:#333,color:#fff
    style Pandas fill:#999,stroke:#333,color:#fff

    %% Optional deps
    style INC fill:#ccc,stroke:#666,stroke-dasharray:5 5
    style NIXL fill:#ccc,stroke:#666,stroke-dasharray:5 5
    style Ray fill:#ccc,stroke:#666,stroke-dasharray:5 5

    %% Internal RHOAI platform
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style PlatformGW fill:#7ed321,stroke:#333,color:#fff
    style PVC fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style HFHub fill:#f5a623,stroke:#333,color:#fff

    %% CI/CD
    style Konflux fill:#cc0000,stroke:#333,color:#fff
    style Renovate fill:#cc0000,stroke:#333,color:#fff
