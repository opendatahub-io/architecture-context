graph TB
    subgraph External["EXTERNAL CLIENTS (Untrusted)"]
        Producer["Producer Client"]
        Consumer["Consumer Client"]
    end

    subgraph MessageQueue["MESSAGE QUEUE LAYER"]
        direction LR
        Redis["Redis / Valkey<br/>6379/TCP RESP2/RESP3<br/>Optional TLS (rediss://)<br/>URL-embedded credentials"]
        GCPPubSub["GCP Pub/Sub<br/>443/TCP gRPC<br/>TLS<br/>GCP workload identity"]
        GCPMon["GCP Cloud Monitoring<br/>443/TCP gRPC<br/>TLS<br/>GCP workload identity"]
    end

    subgraph Processor["ASYNC PROCESSOR (llm-d-async)"]
        direction TB
        AP["async-processor<br/>UID: 1001 (non-root)<br/>Read-only rootfs<br/>FIPS: strictfipsruntime"]

        subgraph Ports["Exposed Ports"]
            Health["Health: 8081/TCP<br/>/healthz, /readyz<br/>HTTP, No auth"]
            Metrics["Metrics: 9090/TCP<br/>/metrics<br/>HTTP, Optional RBAC<br/>(SubjectAccessReview)"]
        end
    end

    subgraph Inference["INFERENCE LAYER"]
        Router["llm-d-router<br/>(Inference Gateway)<br/>Configurable port<br/>HTTP/1.1<br/>Optional TLS 1.2+<br/>No app-level auth"]
    end

    subgraph Observability["OBSERVABILITY LAYER"]
        direction LR
        Prometheus["Prometheus<br/>Configurable port<br/>HTTP<br/>No auth"]
        OTELCollector["OpenTelemetry Collector<br/>Configurable port<br/>gRPC OTLP<br/>Optional TLS"]
        PromEndpoints["Prometheus /metrics<br/>endpoints (scrape)<br/>Configurable port<br/>HTTP, No auth"]
        GMP["Google Managed<br/>Prometheus<br/>443/TCP HTTPS<br/>OAuth2"]
    end

    subgraph K8s["KUBERNETES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>mTLS<br/>ServiceAccount token"]
    end

    subgraph MetricsSources["METRICS SOURCES (Indirect)"]
        direction LR
        EPP["llm-d-inference-scheduler<br/>(EPP)<br/>pool_saturation metrics"]
        vLLM["vLLM Model Servers<br/>num_requests_running<br/>(fallback metrics)"]
    end

    %% External to Queue
    Producer -->|"RESP 6379/TCP<br/>Optional TLS<br/>URL credentials"| Redis
    Producer -->|"gRPC 443/TCP<br/>TLS<br/>GCP IAM"| GCPPubSub
    Consumer -->|"RESP 6379/TCP<br/>Optional TLS<br/>URL credentials"| Redis

    %% Queue to Processor
    Redis -->|"RESP 6379/TCP<br/>Optional TLS<br/>URL credentials"| AP
    GCPPubSub -->|"gRPC 443/TCP<br/>TLS<br/>GCP workload identity"| AP
    GCPMon -->|"gRPC 443/TCP<br/>TLS<br/>GCP workload identity"| AP

    %% Processor to Inference
    AP -->|"HTTP/1.1<br/>Optional TLS 1.2+<br/>--tls-ca-cert/cert/key"| Router

    %% Processor to Observability
    AP -->|"HTTP<br/>PromQL queries"| Prometheus
    AP -->|"gRPC OTLP<br/>Optional TLS"| OTELCollector
    AP -->|"HTTP scrape<br/>No auth"| PromEndpoints
    AP -->|"HTTPS 443/TCP<br/>OAuth2"| GMP
    AP -->|"HTTPS 443/TCP<br/>mTLS"| K8sAPI

    %% Indirect metric sources
    EPP -.->|"metrics via<br/>Prometheus"| Prometheus
    vLLM -.->|"metrics via<br/>Prometheus relabeling"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef queue fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef processor fill:#d5e8d4,stroke:#82b366,stroke-width:3px
    classDef inference fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef indirect fill:#f5f5f5,stroke:#999,stroke-dasharray:5 5

    class Producer,Consumer external
    class Redis,GCPPubSub,GCPMon queue
    class AP,Health,Metrics processor
    class Router inference
    class Prometheus,OTELCollector,PromEndpoints,GMP observability
    class K8sAPI k8s
    class EPP,vLLM indirect
