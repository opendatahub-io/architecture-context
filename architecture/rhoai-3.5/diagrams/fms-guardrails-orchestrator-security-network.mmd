graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformGW["PLATFORM GATEWAY (DMZ)"]
        Proxy["kube-rbac-proxy / OAuth Proxy<br/>443/TCP → 8033/TCP<br/>TLS 1.2+<br/>Token Validation + RBAC"]
    end

    subgraph OrchestratorZone["ORCHESTRATOR SERVICE (Internal)"]
        direction TB
        Orch["FMS Guardrails Orchestrator<br/>API: 8033/TCP (ClusterIP)<br/>Health: 8034/TCP (ClusterIP)<br/>TLS: rustls+ring (configurable)<br/>mTLS Server: Optional (WebPkiClientVerifier)"]
    end

    subgraph DownstreamHTTP["DOWNSTREAM HTTP SERVICES (Internal)"]
        direction TB
        Detectors["Detector Services<br/>8080/TCP HTTP/HTTPS<br/>TLS/mTLS configurable<br/>Auth: Optional Bearer"]
        OpenAI["OpenAI-Compatible Service<br/>8080/TCP HTTP/HTTPS<br/>TLS configurable<br/>Auth: Optional Bearer"]
    end

    subgraph DownstreamGRPC["DOWNSTREAM gRPC SERVICES (Internal)"]
        direction TB
        Chunkers["Chunker Services (Caikit)<br/>8085/TCP gRPC<br/>TLS/mTLS configurable<br/>Auth: mTLS client cert"]
        TGIS["TGIS Generation<br/>8033/TCP gRPC<br/>TLS/mTLS configurable<br/>Auth: mTLS client cert"]
        NLP["Caikit NLP Service<br/>8085/TCP gRPC<br/>TLS/mTLS configurable<br/>Auth: mTLS client cert"]
    end

    subgraph Observability["OBSERVABILITY (Internal)"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC or 4318/TCP HTTP<br/>W3C traceparent propagation"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token / OAuth"| Proxy
    Proxy -->|"HTTP(S)/8033<br/>Configurable TLS/mTLS/plaintext<br/>X-Forwarded-Access-Token → Bearer"| Orch

    Orch -->|"HTTP(S)/8080<br/>Configurable TLS/mTLS<br/>Optional Bearer token"| Detectors
    Orch -->|"HTTP(S)/8080<br/>Configurable TLS<br/>Optional Bearer token"| OpenAI

    Orch -->|"gRPC/8085<br/>Configurable TLS/mTLS<br/>mTLS client cert"| Chunkers
    Orch -->|"gRPC/8033<br/>Configurable TLS/mTLS<br/>mTLS client cert"| TGIS
    Orch -->|"gRPC/8085<br/>Configurable TLS/mTLS<br/>mTLS client cert"| NLP

    Orch -.->|"gRPC/4317 or HTTP/4318<br/>Traces + Metrics"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef orchestrator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef downstream fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Proxy gateway
    class Orch orchestrator
    class Detectors,OpenAI,Chunkers,TGIS,NLP downstream
    class OTLP observability
