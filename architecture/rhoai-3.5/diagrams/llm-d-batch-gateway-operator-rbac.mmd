graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["llm-d-batch-gateway-operator"]
    end

    subgraph ClusterBindings["ClusterRoleBindings"]
        CRB["operator<br/>(ClusterRoleBinding)"]
    end

    subgraph NamespacedBindings["RoleBindings (operator namespace)"]
        RB["leader-election-role-binding"]
    end

    subgraph OperatorClusterRole["ClusterRole: operator"]
        direction TB
        CR_LBG["batch.llm-d.ai<br/>LLMBatchGateway"]
        CR_LBG_Status["batch.llm-d.ai<br/>LLMBatchGateway/status"]
        CR_LBG_Finalizers["batch.llm-d.ai<br/>LLMBatchGateway/finalizers"]
        CR_Deployments["apps<br/>Deployments"]
        CR_Core["core<br/>ConfigMaps, ServiceAccounts,<br/>Services"]
        CR_Secrets["core<br/>Secrets"]
        CR_Events["core<br/>Events"]
        CR_HTTPRoutes["gateway.networking.k8s.io<br/>HTTPRoutes"]
        CR_RefGrants["gateway.networking.k8s.io<br/>ReferenceGrants"]
        CR_Certs["cert-manager.io<br/>Certificates"]
        CR_Monitoring["monitoring.coreos.com<br/>ServiceMonitors, PodMonitors,<br/>PrometheusRules"]
    end

    subgraph LeaderElectionRole["Role: leader-election-role"]
        LE_Leases["coordination.k8s.io<br/>Leases"]
        LE_Events["core<br/>Events"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles"]
        AdminRole["admin / edit<br/>(aggregate-to-admin,<br/>aggregate-to-edit)"]
        ViewRole["view<br/>(aggregate-to-view)"]

        AdminResources["batch.llm-d.ai<br/>LLMBatchGateway<br/>+ status"]
        ViewResources["batch.llm-d.ai<br/>LLMBatchGateway<br/>+ status"]
    end

    %% Bindings
    SA -->|bound via| CRB
    SA -->|bound via| RB
    CRB -->|grants| OperatorClusterRole
    RB -->|grants| LeaderElectionRole

    %% Operator ClusterRole permissions
    OperatorClusterRole -->|"get, list, watch,<br/>update, patch"| CR_LBG
    OperatorClusterRole -->|"get, update, patch"| CR_LBG_Status
    OperatorClusterRole -->|"update"| CR_LBG_Finalizers
    OperatorClusterRole -->|"get, list, watch, create,<br/>update, patch, delete"| CR_Deployments
    OperatorClusterRole -->|"get, list, watch, create,<br/>update, patch, delete"| CR_Core
    OperatorClusterRole -->|"get, list, watch,<br/>create, patch"| CR_Secrets
    OperatorClusterRole -->|"create, patch"| CR_Events
    OperatorClusterRole -->|"get, list, watch, create,<br/>update, patch, delete"| CR_HTTPRoutes
    OperatorClusterRole -->|"get, list, watch"| CR_RefGrants
    OperatorClusterRole -->|"get, list, watch, create,<br/>update, patch, delete"| CR_Certs
    OperatorClusterRole -->|"get, list, watch, create,<br/>update, patch, delete"| CR_Monitoring

    %% Leader Election Role permissions
    LeaderElectionRole -->|"get, list, watch, create,<br/>update, patch, delete"| LE_Leases
    LeaderElectionRole -->|"create, patch"| LE_Events

    %% Aggregated Roles
    AdminRole -->|"full CRUD"| AdminResources
    ViewRole -->|"get, list, watch"| ViewResources

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e8e8e8,stroke:#333
    style RB fill:#e8e8e8,stroke:#333
    style CR_LBG fill:#7ed321,stroke:#333,color:#fff
    style CR_LBG_Status fill:#7ed321,stroke:#333,color:#fff
    style CR_LBG_Finalizers fill:#7ed321,stroke:#333,color:#fff
    style CR_Deployments fill:#7ed321,stroke:#333,color:#fff
    style CR_Core fill:#7ed321,stroke:#333,color:#fff
    style CR_Secrets fill:#f5a623,stroke:#333,color:#fff
    style CR_Events fill:#7ed321,stroke:#333,color:#fff
    style CR_HTTPRoutes fill:#7ed321,stroke:#333,color:#fff
    style CR_RefGrants fill:#7ed321,stroke:#333,color:#fff
    style CR_Certs fill:#7ed321,stroke:#333,color:#fff
    style CR_Monitoring fill:#7ed321,stroke:#333,color:#fff
    style LE_Leases fill:#ddd,stroke:#999
    style LE_Events fill:#ddd,stroke:#999
    style AdminRole fill:#f5a623,stroke:#333,color:#fff
    style ViewRole fill:#9b59b6,stroke:#333,color:#fff
    style AdminResources fill:#ffe6cc,stroke:#d79b00
    style ViewResources fill:#e1d5e7,stroke:#9673a6
