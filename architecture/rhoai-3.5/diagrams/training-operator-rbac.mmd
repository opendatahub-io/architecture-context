graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["training-operator<br/>Namespace: opendatahub"]
        MPIJobSA["Per-job SA<br/>Namespace: {user-namespace}<br/>(MPI jobs only)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["training-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Webhook["training-operator-webhook<br/>(RoleBinding)<br/>Namespace: opendatahub"]
        RB_MPIJob["Per-job RoleBinding<br/>Namespace: {user-namespace}"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["training-operator<br/>(ClusterRole)"]
        CR_Edit["training-edit<br/>(Aggregated)<br/>aggregate-to-admin: true<br/>aggregate-to-edit: true"]
        CR_View["training-view<br/>(Aggregated)<br/>aggregate-to-view: true"]
    end

    subgraph Roles["Roles"]
        R_Webhook["training-operator-webhook<br/>(Role)<br/>Namespace: opendatahub"]
        R_MPIJob["Per-job Role<br/>Namespace: {user-namespace}"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["core<br/>pods<br/>get,list,watch,create,<br/>update,patch,delete"]
        PodsExec["core<br/>pods/exec<br/>create"]
        Services["core<br/>services<br/>get,list,watch,<br/>create,delete"]
        ConfigMaps["core<br/>configmaps<br/>create,list,<br/>update,watch"]
        Events["core<br/>events<br/>get,list,watch,create,<br/>update,patch,delete"]
        SvcAccounts["core<br/>serviceaccounts<br/>create,get,<br/>list,watch"]
    end

    subgraph KubeflowResources["kubeflow.org Resources"]
        PyTorchJobs["pytorchjobs<br/>+ status + finalizers<br/>full CRUD"]
        TFJobs["tfjobs<br/>+ status + finalizers<br/>full CRUD"]
        XGBoostJobs["xgboostjobs<br/>+ status + finalizers<br/>full CRUD"]
        JAXJobs["jaxjobs<br/>+ status + finalizers<br/>full CRUD"]
        MPIJobs["mpijobs<br/>+ status + finalizers<br/>full CRUD"]
        PaddleJobs["paddlejobs<br/>+ status + finalizers<br/>full CRUD"]
    end

    subgraph OtherResources["Other API Resources"]
        RBAC_Res["rbac.authorization.k8s.io<br/>roles, rolebindings<br/>create,list,update,watch"]
        HPAs["autoscaling<br/>horizontalpodautoscalers<br/>full CRUD"]
        VolcanoPG["scheduling.volcano.sh<br/>podgroups<br/>full CRUD"]
        SchedPG["scheduling.x-k8s.io<br/>podgroups<br/>full CRUD"]
        NetPolicies["networking.k8s.io<br/>networkpolicies<br/>full CRUD"]
        WebhookCfg["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>get,list,update,watch"]
        APIServers["config.openshift.io<br/>apiservers[cluster]<br/>get"]
    end

    subgraph EditViewResources["Edit/View Resources (kubeflow.org)"]
        EditRes["pytorchjobs, tfjobs,<br/>xgboostjobs, mpijobs,<br/>paddlejobs, mxjobs"]
    end

    %% Bindings
    SA -->|bound via| CRB
    CRB -->|grants| CR_Main
    SA -->|bound via| RB_Webhook
    RB_Webhook -->|grants| R_Webhook

    MPIJobSA -->|bound via| RB_MPIJob
    RB_MPIJob -->|grants| R_MPIJob

    %% Main ClusterRole permissions
    CR_Main -->|manages| Pods
    CR_Main -->|manages| PodsExec
    CR_Main -->|manages| Services
    CR_Main -->|manages| ConfigMaps
    CR_Main -->|manages| Events
    CR_Main -->|manages| SvcAccounts
    CR_Main -->|manages| PyTorchJobs
    CR_Main -->|manages| TFJobs
    CR_Main -->|manages| XGBoostJobs
    CR_Main -->|manages| JAXJobs
    CR_Main -->|manages| MPIJobs
    CR_Main -->|manages| PaddleJobs
    CR_Main -->|manages| RBAC_Res
    CR_Main -->|manages| HPAs
    CR_Main -->|manages| VolcanoPG
    CR_Main -->|manages| SchedPG
    CR_Main -->|manages| NetPolicies
    CR_Main -->|manages| WebhookCfg
    CR_Main -->|manages| APIServers

    %% Aggregated roles
    CR_Edit -->|"full CRUD +<br/>deletecollection"| EditRes
    CR_View -->|"get,list,watch"| EditRes

    %% MPI per-job role
    R_MPIJob -->|"pods/exec, configmaps"| PodsExec

