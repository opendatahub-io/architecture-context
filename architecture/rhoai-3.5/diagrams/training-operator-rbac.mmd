    style SA fill:#4a90e2,color:#fff
    style MPIJobSA fill:#4a90e2,color:#fff
    style CR_Main fill:#f5a623
    style CR_Edit fill:#f5a623
    style CR_View fill:#f5a623
    style R_Webhook fill:#f5a623
    style R_MPIJob fill:#f5a623
    style CRB fill:#e8e8e8
    style RB_Webhook fill:#e8e8e8
    style RB_MPIJob fill:#e8e8e8
    style PyTorchJobs fill:#7ed321
    style TFJobs fill:#7ed321
