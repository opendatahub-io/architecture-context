graph TB
    subgraph "pipelines-components"
        subgraph "SDK Layer"
            SDK["kfp-components SDK<br/>Python Library<br/>27+ KFP v2 Components<br/>18+ Pipeline Definitions"]
        end

        subgraph "Init Container"
            GenManaged["generate_managed_pipelines<br/>Build Script<br/>Compiles managed pipeline YAML"]
            InitManaged["init_managed_pipelines<br/>Runtime Script<br/>Copies/recompiles YAML to PVC"]
            InitContainer["odh-pipelines-components<br/>Init Container<br/>UBI9 Python 3.12"]
            GenManaged --> InitContainer
            InitManaged --> InitContainer
        end

        subgraph "Runtime Containers"
            AutoML["odh-automl<br/>Runtime Container<br/>AIPCC CPU Base<br/>AutoGluon 1.5.0+rhaiv.5"]
            AutoRAG["odh-autorag<br/>Runtime Container<br/>AIPCC CPU Base<br/>ai4rag + docling"]
        end

        subgraph "Dev Tooling"
            RefreshReqs["refresh_pipeline_requirements<br/>Dev Script<br/>pip-compile in container"]
        end
    end

    %% SDK provides components used by containers
    SDK -->|"component definitions"| AutoML
    SDK -->|"component definitions"| AutoRAG
    SDK -->|"pipeline definitions"| InitContainer

    %% Init container writes to shared volume
    InitContainer -->|"writes managed YAML"| SharedPVC["Shared PVC<br/>/config/managed-pipelines/"]
    SharedPVC -->|"reads pipeline manifests"| KFPServer["KFP API Server"]

    %% DSPA operator deploys the init container
    DSPOperator["data-science-pipelines-operator"] -->|"RELATED_IMAGE_*<br/>init container ref"| InitContainer

    %% Runtime containers interact with external services
    AutoML -->|"HTTPS/443<br/>AWS IAM"| S3["S3 / MinIO"]
    AutoRAG -->|"HTTPS/443<br/>AWS IAM"| S3
    AutoRAG -->|"HTTPS/443<br/>API key"| OGX["OGX API"]

    %% Pipeline tasks interact with platform services
    SDK -->|"creates InferenceService CR"| KServe["KServe / vLLM"]
    SDK -->|"REST API"| ModelRegistry["Kubeflow Model Registry"]
    SDK -->|"gRPC/19530"| Milvus["Milvus"]
    SDK -->|"creates RayJob CR"| KubeRay["KubeRay Operator"]

    %% Styling
    style SDK fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style AutoML fill:#4a90e2,stroke:#333,color:#fff
    style AutoRAG fill:#4a90e2,stroke:#333,color:#fff
    style GenManaged fill:#7ec8e3,stroke:#333
    style InitManaged fill:#7ec8e3,stroke:#333
    style RefreshReqs fill:#7ec8e3,stroke:#333
    style SharedPVC fill:#f5a623,stroke:#333
    style KFPServer fill:#7ed321,stroke:#333
    style DSPOperator fill:#7ed321,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OGX fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ModelRegistry fill:#7ed321,stroke:#333
    style Milvus fill:#7ed321,stroke:#333
    style KubeRay fill:#7ed321,stroke:#333
