graph LR
    LLMDRouter["llm-d Router<br/>(EPP + PD-Sidecar + Coordinator)"]

    %% External Dependencies (Libraries)
    LLMDRouter -->|"reconciliation framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    LLMDRouter -->|"Gateway/HTTPRoute types"| GatewayAPI["gateway-api<br/>v1.5.1"]
    LLMDRouter -->|"InferencePool CRD + EPP protocol"| GIE["gateway-api-inference-extension<br/>v1.5.0"]
    LLMDRouter -->|"ext-proc protobuf types"| EnvoyCP["envoy go-control-plane<br/>v1.37.0"]
    LLMDRouter -->|"request/response parsing"| OpenAIGo["openai-go<br/>v1.12.0"]
    LLMDRouter -->|"prefix cache scoring"| KVCache["llm-d-kv-cache<br/>v0.9.0"]
    LLMDRouter -->|"KV-Events subscriber"| ZMQ["go-zeromq/zmq4<br/>v0.17.0"]
    LLMDRouter -->|"Coordinator HTTP router"| Chi["go-chi/chi<br/>v5.3.1"]
    LLMDRouter -.->|"optional KV index backend"| Redis["redis/go-redis<br/>v9.20.1"]
    LLMDRouter -.->|"optional tracing"| OTel["opentelemetry<br/>v1.44.0"]

    %% Internal Platform Dependencies
    LLMDRouter -->|"ext-proc gRPC stream<br/>9002/TCP TLS"| Envoy["Envoy Proxy"]
    LLMDRouter -->|"CRD watch + pod discovery<br/>6443/TCP HTTPS"| InferencePool["InferencePool<br/>(GIE CRD)"]
    LLMDRouter -->|"metrics scrape + request forward<br/>HTTP/HTTPS"| vLLM["vLLM Model Servers"]
    LLMDRouter -->|"L7 routing infra<br/>Gateway/HTTPRoute"| GatewayAPIInfra["Gateway API<br/>(Infrastructure)"]

    %% Integration Partners (consume llm-d Router)
    %% None explicitly defined -- EPP is consumed via Envoy ext-proc

    %% External Services
    LLMDRouter -->|"GPU utilization<br/>HTTP/HTTPS"| DCGM["DCGM Exporter"]
    LLMDRouter -->|"distributed traces<br/>gRPC"| OTelCollector["OpenTelemetry<br/>Collector"]
    LLMDRouter -->|"KV-Events<br/>ZMQ 5557/TCP"| ZMQPub["ZMQ Publisher<br/>(Model Server)"]
    LLMDRouter -->|"leader election<br/>Lease CRD"| K8sAPI["Kubernetes API"]

    %% Coordinator-specific
    LLMDRouter -->|"E/P/D routing<br/>HTTP"| InferenceGW["Inference Gateway"]
    LLMDRouter -->|"tokenization<br/>HTTP"| RenderSvc["Rendering Service"]

