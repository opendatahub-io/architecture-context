graph TB
    subgraph K8sAPIServer["KUBERNETES API SERVER (Trust Anchor)"]
        APIServer["Kubernetes API Server<br/>443/TCP HTTPS TLS 1.2+<br/>ServiceAccount Token Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        direction TB

        subgraph OperatorPod["workbenches-operator Pod<br/>SA: controller-manager"]
            Controller["Workbenches Controller"]
        end

        subgraph WebhookSvc["webhook-service (ClusterIP)<br/>443/TCP → 9443/TCP<br/>TLS 1.2+ (cluster profile)<br/>cert: webhook-server-cert"]
            HWWebhook["POST /workbenches-hardware-profile<br/>(mutating, fail-closed, 5s timeout)"]
            ConnWebhook["POST /workbenches-connection-notebook<br/>(mutating + SAR, fail-closed, 5s timeout)"]
        end

        subgraph MetricsSvc["metrics-service (ClusterIP)<br/>8443/TCP HTTPS<br/>TLS 1.2+ (cluster profile)<br/>Bearer Token authn/authz"]
            Metrics["GET /metrics"]
        end

        subgraph HealthProbes["Health Probes (pod-direct)<br/>8081/TCP HTTP (plaintext)<br/>No Auth"]
            Healthz["GET /healthz"]
            Readyz["GET /readyz"]
        end
    end

    subgraph EgressTargets["EGRESS DESTINATIONS (via K8s API 443/TCP)"]
        direction TB
        WorkbenchesCR["Workbenches CR Watch<br/>components.platform.opendatahub.io"]
        SSA["Server-Side Apply Patches<br/>(Deployments, Services, RBAC, CRDs)"]
        OSAPI["OpenShift APIServer CR<br/>(TLS profile watch)"]
        HWPCR["HardwareProfile CRs<br/>(read, no SAR gate)"]
        SecretCheck["Secrets<br/>(existence + SAR check)"]
        SAR["SubjectAccessReviews<br/>(user permission verification)"]
        ConfigMapRead["odh-workbenches-config<br/>(distribution + version handshake)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus"]
    end

    %% Webhook ingress (from API server)
    APIServer -->|"AdmissionReview<br/>9443/TCP HTTPS<br/>API server webhook auth"| HWWebhook
    APIServer -->|"AdmissionReview<br/>9443/TCP HTTPS<br/>API server webhook auth"| ConnWebhook

    %% Operator egress
    Controller -->|"443/TCP HTTPS<br/>SA Token"| WorkbenchesCR
    Controller -->|"443/TCP HTTPS<br/>SA Token"| SSA
    Controller -->|"443/TCP HTTPS<br/>SA Token"| OSAPI
    Controller -->|"443/TCP HTTPS<br/>SA Token"| ConfigMapRead
    HWWebhook -->|"443/TCP HTTPS<br/>SA Token"| HWPCR
    ConnWebhook -->|"443/TCP HTTPS<br/>SA Token"| SecretCheck
    ConnWebhook -->|"443/TCP HTTPS<br/>SA Token"| SAR

    %% Monitoring
    Prometheus -->|"8443/TCP HTTPS<br/>Bearer Token"| Metrics

    %% Styling
    classDef apiserver fill:#dce6f2,stroke:#4472c4,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef health fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class APIServer apiserver
    class Controller operator
    class HWWebhook,ConnWebhook webhook
    class Metrics operator
    class Healthz,Readyz health
    class WorkbenchesCR,SSA,OSAPI,HWPCR,SecretCheck,SAR,ConfigMapRead egress
    class Prometheus monitoring
