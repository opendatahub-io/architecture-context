graph TD
    subgraph "MLflow Application-Level RBAC"
        direction TB

        subgraph "Service Account"
            SA["mlflow ServiceAccount<br/>(Helm chart, configurable name)"]
        end

        subgraph "Kubernetes RBAC (Optional - via Helm values)"
            direction TB
            NSRole["Namespace Role<br/>(namespace_rbac.extraRules)"]
            ClusterRole["ClusterRole<br/>(cluster_rbac.extraRules)"]
            NSRB["RoleBinding<br/>(chart-created)"]
            CRB["ClusterRoleBinding<br/>(chart-created)"]
        end

        subgraph "MLflow Auth Plugin System"
            direction TB
            AuthPlugin["Auth Plugin<br/>(pluggable: kubernetes-auth / basic-auth)"]

            subgraph "kubernetes-auth Plugin"
                K8sAuth["Kubernetes Auth Provider<br/>mlflow-kubernetes-plugins 1.5.0"]
                SAToken["SA Token Validation<br/>via K8s TokenReview API"]
                NSHeader["X-MLFLOW-WORKSPACE Header<br/>Namespace → Workspace mapping"]
            end

            subgraph "basic-auth Plugin"
                BasicAuth["Username/Password Auth<br/>+ CSRF protection"]
                AdminCheck["Admin Role Check<br/>/ajax-api/2.0/mlflow/users/*"]
            end
        end

        subgraph "Permission Levels (per resource type)"
            direction LR
            NONE["NO_PERMISSIONS"]
            READ["READ"]
            USE["USE"]
            EDIT["EDIT"]
            MANAGE["MANAGE"]
            NONE --> READ --> USE --> EDIT --> MANAGE
        end

        subgraph "Protected Resources"
            Experiments["Experiments<br/>/ajax-api/2.0/mlflow/experiments/*"]
            Runs["Runs<br/>/ajax-api/2.0/mlflow/runs/*"]
            Models["Registered Models<br/>/ajax-api/2.0/mlflow/registered-models/*"]
            ModelVersions["Model Versions<br/>/ajax-api/2.0/mlflow/model-versions/*"]
            Workspaces["Workspaces<br/>/api/3.0/mlflow/workspaces"]
            Gateway["AI Gateway<br/>/mlflow/gateway/*"]
        end

        subgraph "Public Endpoints (No Auth)"
            Health["/health"]
            Version["/version"]
        end
    end

    %% Kubernetes RBAC flow
    SA -->|bound via| NSRB
    SA -->|bound via| CRB
    NSRB -->|grants| NSRole
    CRB -->|grants| ClusterRole
    NSRole -->|"user-defined rules<br/>(no defaults)"| K8sResources["Kubernetes API Resources<br/>(configurable via extraRules)"]
    ClusterRole -->|"user-defined rules<br/>(no defaults)"| K8sResources

    %% MLflow auth flow
    AuthPlugin --> K8sAuth
    AuthPlugin --> BasicAuth
    K8sAuth --> SAToken
    K8sAuth --> NSHeader
    BasicAuth --> AdminCheck

    %% Permission assignments
    AuthPlugin -->|"resolves permission level"| NONE
    EDIT -->|"required for write ops"| Experiments
    EDIT -->|"required for write ops"| Runs
    EDIT -->|"required for write ops"| Models
    EDIT -->|"required for write ops"| ModelVersions
    READ -->|"required for read ops"| Experiments
    READ -->|"required for read ops"| Runs
    MANAGE -->|"required for admin ops"| Workspaces
    MANAGE -->|"required for admin ops"| Gateway

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style AuthPlugin fill:#f5a623,stroke:#333,color:#fff
    style K8sAuth fill:#f5a623,stroke:#333
    style BasicAuth fill:#f5a623,stroke:#333
    style NONE fill:#d0021b,stroke:#333,color:#fff
    style READ fill:#f5a623,stroke:#333
    style USE fill:#f8e71c,stroke:#333
    style EDIT fill:#7ed321,stroke:#333
    style MANAGE fill:#4a90e2,stroke:#333,color:#fff
    style Experiments fill:#dae8fc,stroke:#6c8ebf
    style Runs fill:#dae8fc,stroke:#6c8ebf
    style Models fill:#dae8fc,stroke:#6c8ebf
    style ModelVersions fill:#dae8fc,stroke:#6c8ebf
    style Workspaces fill:#dae8fc,stroke:#6c8ebf
    style Gateway fill:#dae8fc,stroke:#6c8ebf
    style Health fill:#d5e8d4,stroke:#82b366
    style Version fill:#d5e8d4,stroke:#82b366
    style NSRole fill:#e1d5e7,stroke:#9673a6
    style ClusterRole fill:#e1d5e7,stroke:#9673a6
