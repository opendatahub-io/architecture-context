    MLflow -->|"WSGI framework"| Flask["Flask 3.1.3"]
    MLflow -->|"ASGI framework"| FastAPI["FastAPI 0.136.1"]
    MLflow -->|"ASGI server"| Uvicorn["uvicorn 0.46.0"]
    MLflow -->|"encryption"| Cryptography["cryptography 46.0.7"]
    MLflow -->|"tracing"| OTel["OpenTelemetry 1.41.1"]

