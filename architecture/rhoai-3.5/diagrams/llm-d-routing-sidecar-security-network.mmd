graph TB
    subgraph External["EXTERNAL (Upstream Clients)"]
        Client["llm-d-inference-scheduler / Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Route - optional)"]
        Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>TLS Edge Termination"]
    end

    subgraph PodBoundary["POD BOUNDARY (shared network namespace)"]
        direction TB

        subgraph SidecarContainer["Container: llm-d-routing-sidecar"]
            Sidecar["Routing Sidecar<br/>Port: 8000/TCP HTTPS<br/>TLS 1.2+ (AEAD ciphers)<br/>SA: operator-controller-manager"]
            SSRF["AllowlistValidator<br/>(SSRF Protection - optional)"]
        end

        subgraph DecoderContainer["Container: vLLM Decoder"]
            Decoder["vLLM Decoder<br/>Port: 8001/TCP (default)<br/>HTTP or HTTPS"]
        end
    end

    subgraph RemotePods["REMOTE PODS (Prefill Workers)"]
        Prefiller1["Prefiller Pod 1<br/>HTTP(S)"]
        Prefiller2["Prefiller Pod 2<br/>HTTP(S)"]
        PrefillerN["Prefiller Pod N<br/>HTTP(S)"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>ServiceAccount Token Auth"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS Edge"| Route

    %% Ingress to Sidecar
    Route -->|"HTTP/8080<br/>In-cluster (post-TLS)"| Sidecar

    %% Direct access (in-cluster)
    Client -.->|"HTTPS/8000<br/>TLS 1.2+<br/>No auth (network isolation)"| Sidecar

    %% Sidecar to Decoder (localhost)
    Sidecar -->|"HTTP(S)/8001<br/>localhost<br/>Configurable TLS"| Decoder

    %% Sidecar to Prefillers (remote)
    Sidecar -->|"HTTP(S)/varies<br/>TLS 1.2+ (configurable)<br/>SSRF allowlist (host-only)"| Prefiller1
    Sidecar -->|"HTTP(S)/varies"| Prefiller2
    Sidecar -->|"HTTP(S)/varies"| PrefillerN

    %% SSRF protection watches
    SSRF -->|"HTTPS/443<br/>TLS<br/>SA Token<br/>Watch: InferencePool + Pods"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef sidecar fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef decoder fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef remote fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef ssrf fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Sidecar sidecar
    class SSRF ssrf
    class Decoder decoder
    class Prefiller1,Prefiller2,PrefillerN remote
    class K8sAPI controlplane
