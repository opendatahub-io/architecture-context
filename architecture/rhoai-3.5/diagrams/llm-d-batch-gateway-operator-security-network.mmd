graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>Batch job submission"]
    end

    subgraph Ingress["INGRESS (Optional - Gateway API)"]
        HTTPRoute["HTTPRoute → Gateway<br/>8000/TCP<br/>Encryption: Gateway-dependent"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB
        Operator["llm-d-batch-gateway-operator<br/>SA: llm-d-batch-gateway-operator<br/>Probes: 8081/TCP HTTP<br/>Metrics: 8443/TCP HTTP<br/>FIPS: strictfipsruntime"]
    end

    subgraph ManagedNS["MANAGED WORKLOADS (CR namespace)"]
        direction TB

        APIServer["API Server<br/>8000/TCP HTTP/HTTPS<br/>8081/TCP metrics<br/>Optional TLS (cert-manager)"]

        Processor["Processor<br/>AIMD concurrency<br/>Sync dispatch mode"]

        AsyncProc["Async-Processor (optional)<br/>Redis MQ polling<br/>Async dispatch mode"]

        GarbageCol["Garbage Collector<br/>Job expiry & file cleanup"]
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Optional TLS<br/>Credentials from Secret"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>Optional TLS<br/>Credentials from Secret"]
        S3["S3 / MinIO<br/>443/TCP HTTPS<br/>TLS<br/>S3 access key from Secret"]
    end

    subgraph InferenceLayer["INFERENCE LAYER"]
        InfGW["Inference Gateway<br/>Configurable port<br/>HTTP/HTTPS<br/>Optional TLS/mTLS<br/>Optional API key"]
        EPP["Inference Gateway EPP<br/>EndpointPicker<br/>HTTP/HTTPS"]
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>Optional TLS"]
        Prometheus["Prometheus<br/>9090/TCP HTTP<br/>Gate metrics queries"]
    end

    K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]

    %% External flows
    Client -->|"HTTP/HTTPS 8000<br/>Optional TLS<br/>API key + tenant header"| HTTPRoute
    Client -->|"Direct (no Gateway)"| APIServer
    HTTPRoute -->|"8000/TCP"| APIServer

    %% Operator flows
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -.->|"SSA: creates/manages"| APIServer
    Operator -.->|"SSA: creates/manages"| Processor
    Operator -.->|"SSA: creates/manages"| AsyncProc
    Operator -.->|"SSA: creates/manages"| GarbageCol

    %% API Server flows
    APIServer -->|"5432/TCP<br/>Optional TLS<br/>Secret creds"| PostgreSQL
    APIServer -->|"6379/TCP<br/>Optional TLS<br/>Secret creds"| Redis
    APIServer -->|"443/TCP HTTPS<br/>TLS<br/>S3 key"| S3

    %% Processor flows
    Processor -->|"5432 or 6379/TCP<br/>Optional TLS"| PostgreSQL
    Processor -->|"Configurable/TCP<br/>Optional TLS/mTLS<br/>API key"| InfGW
    Processor -->|"443/TCP HTTPS<br/>S3 key"| S3

    %% Async-Processor flows
    AsyncProc -->|"6379/TCP<br/>Optional TLS<br/>Redis MQ"| Redis
    AsyncProc -->|"Configurable/TCP<br/>Optional TLS/mTLS"| EPP
    AsyncProc -->|"9090/TCP HTTP<br/>No auth"| Prometheus

    %% GC flows
    GarbageCol -->|"5432 or 6379/TCP"| PostgreSQL
    GarbageCol -->|"443/TCP HTTPS"| S3

    %% Observability
    APIServer -.->|"4317/TCP gRPC"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef inference fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef observability fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef k8s fill:#e8e8e8,stroke:#666,stroke-width:2px

    class Client external
    class HTTPRoute ingress
    class Operator operator
    class APIServer,Processor,AsyncProc,GarbageCol managed
    class PostgreSQL,Redis,S3 datastore
    class InfGW,EPP inference
    class OTLP,Prometheus observability
    class K8sAPI k8s
