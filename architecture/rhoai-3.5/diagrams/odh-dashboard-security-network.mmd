graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / User"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>HTTPRoute<br/>443/TCP → 8443/TCP<br/>TLS SIMPLE"]
    end

    subgraph AuthBoundary["AUTH PROXY (Trust Boundary)"]
        KRBP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS: proxy-tls cert<br/>AuthN: Bearer validation<br/>AuthZ: SubjectAccessReview"]
    end

    subgraph AppPod["APPLICATION POD (redhat-ods-applications)"]
        direction TB

        Backend["Dashboard Backend<br/>Node.js/Fastify<br/>8080/TCP HTTP<br/>SA: odh-dashboard<br/>Auth: x-forwarded-access-token"]

        subgraph Modules["MODULE BFFs (SA: odh-dashboard-modules)"]
            direction LR
            CoreBFF["core-bff<br/>4000/TCP"]
            GenAIBFF["gen-ai<br/>8143/TCP"]
            MRegBFF["model-registry<br/>8043/TCP"]
            MaaSBFF["maas<br/>8243/TCP"]
            MLfBFF["mlflow<br/>8343/TCP"]
            EvBFF["eval-hub<br/>8543/TCP"]
            AmlBFF["automl<br/>8643/TCP"]
            ArgBFF["autorag<br/>8743/TCP"]
            AgBFF["agent-ops<br/>8843/TCP"]
        end
    end

    subgraph Platform["PLATFORM SERVICES (Cluster Internal)"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS<br/>SA + User Token"]
        Thanos["Thanos Querier<br/>9091/TCP HTTPS<br/>TLS<br/>Bearer Token"]
        DSPipelines["DSPipelines API<br/>HTTPS<br/>TLS<br/>user_token"]
        ModelReg["Model Registry<br/>8085/TCP<br/>HTTP/HTTPS<br/>user_token + SA"]
        TrustyAI["TrustyAI<br/>9443/TCP HTTPS<br/>TLS<br/>user_token"]
        Perses["Perses<br/>8080/TCP HTTP<br/>No TLS<br/>user_token proxy"]
    end

    subgraph AIServices["AI/ML SERVICES (Cluster Internal)"]
        LlamaStack["LlamaStack / OGX<br/>HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token"]
        NeMo["NeMo Guardrails<br/>HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token"]
        MLflowSvc["MLflow Server<br/>HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token"]
        MaaSAPI["MaaS API<br/>HTTPS<br/>TLS<br/>ServiceAccount"]
        EvalHubAPI["EvalHub API<br/>HTTP/HTTPS<br/>TLS configurable<br/>ServiceAccount"]
        KFPipeline["Kubeflow Pipelines<br/>HTTPS<br/>TLS<br/>ServiceAccount"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
        PGVector["pgvector<br/>5432/TCP PostgreSQL<br/>TLS configurable<br/>Secret (password)"]
    end

    %% Flows - External to App
    Browser -->|"HTTPS/443<br/>OAuth Token"| Gateway
    Gateway -->|"HTTPS/8443<br/>Bearer Token"| KRBP
    KRBP -->|"HTTP/8080<br/>x-forwarded-access-token<br/>(pod-internal, no TLS)"| Backend

    %% Backend to BFFs
    Backend -->|"HTTPS /_mf/*<br/>user_token"| Modules

    %% Inter-BFF
    GenAIBFF -.->|"HTTPS/8243<br/>inter-BFF"| MaaSBFF
    GenAIBFF -.->|"HTTPS/8343<br/>inter-BFF"| MLfBFF

    %% App to Platform
    Backend -->|"HTTPS/6443<br/>User Bearer Token"| K8sAPI
    Backend -->|"HTTPS/9091<br/>Bearer Token"| Thanos
    Backend -->|"HTTPS<br/>user_token proxy"| DSPipelines
    Backend -->|"HTTPS/8085<br/>user_token proxy"| ModelReg
    Backend -->|"HTTPS/9443<br/>user_token proxy"| TrustyAI
    Backend -->|"HTTP/8080<br/>user_token proxy"| Perses

    %% BFFs to AI/ML Services
    GenAIBFF -->|"HTTP/HTTPS<br/>Bearer Token"| LlamaStack
    GenAIBFF -->|"HTTP/HTTPS<br/>Bearer Token"| NeMo
    MLfBFF -->|"HTTP/HTTPS<br/>Bearer Token"| MLflowSvc
    MaaSBFF -->|"HTTPS<br/>ServiceAccount"| MaaSAPI
    EvBFF -->|"HTTP/HTTPS<br/>ServiceAccount"| EvalHubAPI
    AmlBFF -->|"HTTPS<br/>ServiceAccount"| KFPipeline
    ArgBFF -->|"HTTPS<br/>ServiceAccount"| KFPipeline

    %% BFFs to External
    AmlBFF -->|"HTTPS/443<br/>AWS IAM"| S3
    ArgBFF -->|"HTTPS/443<br/>AWS IAM"| S3
    GenAIBFF -->|"TCP/5432<br/>Secret auth"| PGVector

    %% Modules to K8s API
    Modules -->|"HTTPS/6443<br/>SA impersonation"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef aiservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Gateway ingress
    class KRBP authproxy
    class Backend,CoreBFF,GenAIBFF,MRegBFF,MaaSBFF,MLfBFF,EvBFF,AmlBFF,ArgBFF,AgBFF app
    class K8sAPI,Thanos,DSPipelines,ModelReg,TrustyAI,Perses platform
    class LlamaStack,NeMo,MLflowSvc,MaaSAPI,EvalHubAPI,KFPipeline aiservice
    class S3,PGVector extsvc
