graph TB
    subgraph ConsumerProcess["CONSUMER PROCESS (Notebook / Script / Pipeline)"]
        direction TB

        subgraph Library["Training Hub Library (PyPI)"]
            direction TB

            subgraph InProcess["In-Process Backends"]
                SFTBackend["InstructLabTraining<br/>SFTBackend"]
                OSFTBackend["MiniTrainerOSFT<br/>Backend"]
                LoRABackend["UnslothLoRA<br/>Backend"]
                GEPABe["GEPA / MLflow<br/>GEPA Backend"]
            end

            subgraph SubProcess["Subprocess-Isolated Backends"]
                ARTBackend["ARTLoRAGRPO<br/>Backend"]
                VeRLBackend["VeRLLoRAGRPO<br/>Backend"]
                vLLMSub["vLLM Inference<br/>(subprocess)<br/>local HTTP, no TLS"]
            end

            subgraph Distributed["Distributed Training"]
                Torchrun["torchrun<br/>NCCL/Gloo<br/>No encryption"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Optional Egress)"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS TLS<br/>Auth: WANDB_API_KEY"]
        MLflow["MLflow Tracking<br/>443/TCP HTTPS TLS<br/>Auth: MLFLOW_TRACKING_TOKEN"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS<br/>Auth: HF_TOKEN (optional)"]
        LLMProviders["LLM API Providers<br/>(via litellm)<br/>HTTPS TLS<br/>Auth: Provider API keys"]
    end

    subgraph LocalIO["LOCAL I/O"]
        TrainingData["Training Data<br/>JSONL / Parquet<br/>Local filesystem"]
        Checkpoints["Model Checkpoints<br/>& LoRA Adapters<br/>Local filesystem"]
    end

    %% Internal flows
    ARTBackend -->|HTTP local<br/>No encryption<br/>No auth| vLLMSub
    SFTBackend --> Torchrun
    OSFTBackend --> Torchrun
    VeRLBackend -->|NCCL<br/>No encryption| Torchrun

    %% Egress flows (all optional)
    SFTBackend -.->|HTTPS/443<br/>TLS<br/>API key| WandB
    OSFTBackend -.->|HTTPS/443<br/>TLS<br/>API key| WandB
    VeRLBackend -.->|HTTPS/443<br/>TLS<br/>API key| WandB
    GEPABe -.->|HTTPS/443<br/>TLS<br/>API key| MLflow
    Library -.->|HTTPS/443<br/>TLS<br/>HF_TOKEN| HFHub
    GEPABe -.->|HTTPS<br/>TLS<br/>API key| LLMProviders
    ARTBackend -.->|HTTPS<br/>TLS<br/>API key| LLMProviders

    %% Local I/O
    SFTBackend -->|File I/O| TrainingData
    SFTBackend -->|File I/O| Checkpoints
    ARTBackend -->|File I/O| Checkpoints
    VeRLBackend -->|File I/O| TrainingData
    VeRLBackend -->|File I/O| Checkpoints

    %% Styling
    classDef consumer fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    classDef library fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef subprocess fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef localio fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class SFTBackend,OSFTBackend,LoRABackend,GEPABe library
    class ARTBackend,VeRLBackend,vLLMSub subprocess
    class WandB,MLflow,HFHub,LLMProviders external
    class TrainingData,Checkpoints localio
    class Torchrun consumer
