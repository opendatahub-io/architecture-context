graph TB
    subgraph ODH["odh-model-controller"]
        direction TB

        subgraph Controller["Controller Manager"]
            ISVCCtrl["InferenceService<br/>Controller"]
            LLMCtrl["LLMInferenceService<br/>Controller"]
            GWCtrl["Gateway<br/>Controller"]
            IGCtrl["InferenceGraph<br/>Controller"]
            SRCtrl["ServingRuntime<br/>Controller"]
            NIMCtrl["NIM Account<br/>Controller"]
            SecretCtrl["Secret Controller"]
            ConfigMapCtrl["ConfigMap Controller"]
            PodCtrl["Pod Controller"]
        end

        subgraph Reconcilers["Sub-Reconcilers"]
            RouteRecon["Route<br/>Reconciler"]
            CRBRecon["ClusterRoleBinding<br/>Reconciler"]
            KEDARecon["KEDA<br/>Reconciler"]
            MetricsSvcRecon["Metrics Service<br/>Reconciler"]
            SMRecon["ServiceMonitor<br/>Reconciler"]
            DashRecon["Dashboard<br/>Reconciler"]
            SARecon["ServiceAccount<br/>Reconciler"]
            MRRecon["Model Registry<br/>Reconciler"]
            AuthPolicyRecon["AuthPolicy<br/>Reconciler"]
        end

        subgraph Webhooks["Admission Webhooks"]
            ISVCWebhook["InferenceService<br/>Mutating + Validating"]
            LLMWebhook["LLMInferenceService<br/>Mutating (v1alpha1/v1alpha2)"]
            IGWebhook["InferenceGraph<br/>Mutating + Validating"]
            PodWebhook["Pod Mutating<br/>(Ray TLS Injection)"]
            NIMWebhook["NIM Account<br/>Validating (Singleton)"]
        end

        subgraph APIServer["model-serving-api"]
            GWHandler["Gateway<br/>Discovery Handler"]
            SampleHandler["Sample Config<br/>Handler"]
            AuthMiddleware["Bearer Token<br/>Auth Middleware"]
        end

        ISVCCtrl --> RouteRecon
        ISVCCtrl --> CRBRecon
        ISVCCtrl --> KEDARecon
        ISVCCtrl --> MetricsSvcRecon
        ISVCCtrl --> SMRecon
        ISVCCtrl --> DashRecon
        ISVCCtrl --> SARecon
        ISVCCtrl --> MRRecon
        LLMCtrl --> AuthPolicyRecon
    end

    %% CRDs Watched
    ISVC["InferenceService CR"]
    LLMISVC["LLMInferenceService CR"]
    LLMISVCFG["LLMInferenceServiceConfig CR"]
    IG["InferenceGraph CR"]
    SR["ServingRuntime CR"]
    NIMAcct["NIM Account CR"]
    GW["Gateway CR"]

    ISVC -->|watched by| ISVCCtrl
    LLMISVC -->|watched by| LLMCtrl
    LLMISVCFG -->|read by| LLMCtrl
    IG -->|watched by| IGCtrl
    SR -->|watched by| SRCtrl
    NIMAcct -->|watched by| NIMCtrl
    GW -->|watched by| GWCtrl

    %% Resources Created
    RouteRecon -->|creates| Route["OpenShift Route"]
    CRBRecon -->|creates| CRB["ClusterRoleBinding"]
    KEDARecon -->|creates| TrigAuth["KEDA TriggerAuth"]
    MetricsSvcRecon -->|creates| MetricsSvc["Metrics Service"]
    SMRecon -->|creates| SM["ServiceMonitor"]
    DashRecon -->|creates| DashCM["Dashboard ConfigMap"]
    AuthPolicyRecon -->|creates| AP["Kuadrant AuthPolicy"]
    GWCtrl -->|creates| EF["Istio EnvoyFilter"]
    GWCtrl -->|creates| PM["PodMonitor"]
    NIMCtrl -->|creates| PullSecret["Pull Secret"]
    NIMCtrl -->|creates| Template["OCP Template"]
    PodWebhook -->|injects| RayTLS["Ray TLS Volumes"]

    %% External Dependencies
    Controller -->|API calls| K8sAPI["Kubernetes API"]
    NIMCtrl -->|HTTP| NGCAPI["NVIDIA NGC API"]
    NIMCtrl -->|Registry API| NVCR["nvcr.io Registry"]
    GWCtrl -->|gRPC/50051| Authorino["Authorino<br/>(via EnvoyFilter)"]
    GWHandler -->|RBAC check| K8sAPI
    AuthMiddleware -->|SSAR| K8sAPI

    %% Dashboard Integration
    Dashboard["RHOAI Dashboard"] -->|HTTPS/8443| GWHandler

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style Reconcilers fill:#6db3f2,color:#fff
    style Webhooks fill:#e8744f,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style ISVC fill:#f5a623
    style LLMISVC fill:#f5a623
    style LLMISVCFG fill:#f5a623
    style IG fill:#f5a623
    style SR fill:#f5a623
    style NIMAcct fill:#f5a623
    style GW fill:#f5a623
    style Route fill:#d4edda
    style CRB fill:#d4edda
    style TrigAuth fill:#d4edda
    style MetricsSvc fill:#d4edda
    style SM fill:#d4edda
    style DashCM fill:#d4edda
    style AP fill:#d4edda
    style EF fill:#d4edda
    style PM fill:#d4edda
    style PullSecret fill:#d4edda
    style Template fill:#d4edda
    style RayTLS fill:#d4edda
    style K8sAPI fill:#e8e8e8,stroke:#333
    style NGCAPI fill:#e8e8e8,stroke:#333
    style NVCR fill:#e8e8e8,stroke:#333
    style Authorino fill:#e8e8e8,stroke:#333
    style Dashboard fill:#c9e8ff,stroke:#333
