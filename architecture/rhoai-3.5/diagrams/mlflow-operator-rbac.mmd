graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-manager<br/>(operator SA)"]
        WorkspaceGroups["Workspace Groups<br/>(from Auth CR)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Manager["manager-rolebinding<br/>(target namespace)"]
        RB_Leader["leader-election-rolebinding<br/>(target namespace)"]
        RB_View["odh-group-mlflow-view<br/>(per workspace namespace)"]
        RB_Edit["odh-group-mlflow-edit<br/>(per workspace namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role<br/>(ClusterRole)"]
        CR_View["mlflow-view<br/>(aggregate ClusterRole)"]
        CR_Edit["mlflow-edit<br/>(aggregate ClusterRole)"]
        CR_Integration["mlflow-integration<br/>(ClusterRole)"]
    end

    subgraph NamespacedRoles["Roles (namespace-scoped)"]
        R_Manager["manager-role<br/>(Role)"]
        R_Leader["leader-election-role<br/>(Role)"]
    end

    subgraph CR_Manager_Resources["ClusterRole: manager-role Resources"]
        direction LR
        MLflowCRD["mlflow.opendatahub.io<br/>mlflows, mlflows/status,<br/>mlflows/finalizers<br/><b>full CRUD</b>"]
        MLflowOpCRD["components.platform.<br/>opendatahub.io<br/>mlflowoperators,<br/>mlflowoperators/status<br/><b>get,list,watch,update,patch</b>"]
        Namespaces["core<br/>namespaces<br/><b>get,list,watch</b>"]
        Secrets["core<br/>secrets<br/>(mlflow-artifact-connection)<br/><b>get,list,watch</b>"]
        MLflowConfigs["mlflow.kubeflow.org<br/>mlflowconfigs<br/><b>get,list,watch</b>"]
        APIServers["config.openshift.io<br/>apiservers<br/><b>get,list,watch</b>"]
        ConsoleLinks["console.openshift.io<br/>consolelinks<br/><b>full CRUD</b>"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes<br/><b>full CRUD</b>"]
        RBAC_CR["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings,<br/>rolebindings<br/><b>create + manage named</b>"]
        AuthCRs["services.platform.<br/>opendatahub.io<br/>auths (auth)<br/><b>get,list,watch</b>"]
    end

    subgraph R_Manager_Resources["Role: manager-role Resources (namespace-scoped)"]
        direction LR
        CoreResources["core<br/>configmaps, pvcs, secrets,<br/>serviceaccounts, services<br/><b>full CRUD</b>"]
        Pods["core<br/>pods<br/><b>get,list,watch</b>"]
        Deployments["apps<br/>deployments<br/><b>full CRUD</b>"]
        BatchResources["batch<br/>jobs, cronjobs<br/><b>full CRUD</b>"]
        NetPolicies["networking.k8s.io<br/>networkpolicies<br/><b>full CRUD</b>"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors<br/><b>full CRUD</b>"]
    end

    subgraph ViewResources["ClusterRole: mlflow-view Resources"]
        ViewMLflow["mlflow.opendatahub.io<br/>mlflows, mlflows/status<br/><b>get,list,watch</b>"]
        ViewKF["mlflow.kubeflow.org<br/>mlflowconfigs, datasets,<br/>experiments, registeredmodels,<br/>gatewayendpoints, mcpservers<br/><b>get,list</b>"]
    end

    subgraph EditResources["ClusterRole: mlflow-edit Resources"]
        EditMLflow["mlflow.opendatahub.io<br/>mlflows, mlflows/finalizers<br/><b>full CRUD</b>"]
        EditKF["mlflow.kubeflow.org<br/>mlflowconfigs, datasets,<br/>experiments, registeredmodels,<br/>gatewaysecrets, mcpservers<br/><b>full CRUD</b>"]
    end

    %% SA → Bindings
    SA -->|bound via| CRB_Manager
    SA -->|bound via| RB_Manager
    SA -->|bound via| RB_Leader

    %% Workspace Groups → Bindings
    WorkspaceGroups -->|"allowedGroups +<br/>adminGroups"| RB_View
    WorkspaceGroups -->|"adminGroups"| RB_Edit

    %% Bindings → Roles
    CRB_Manager -->|grants| CR_Manager
    RB_Manager -->|grants| R_Manager
    RB_Leader -->|grants| R_Leader
    RB_View -->|grants| CR_View
    RB_Edit -->|grants| CR_Edit

    %% Roles → Resources
    CR_Manager -->|accesses| CR_Manager_Resources
    R_Manager -->|accesses| R_Manager_Resources
    CR_View -->|accesses| ViewResources
    CR_Edit -->|accesses| EditResources

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style WorkspaceGroups fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_View fill:#f5a623,stroke:#333
    style CR_Edit fill:#f5a623,stroke:#333
    style CR_Integration fill:#f5a623,stroke:#333
    style R_Manager fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style CRB_Manager fill:#e8e8e8,stroke:#333
    style RB_Manager fill:#e8e8e8,stroke:#333
    style RB_Leader fill:#e8e8e8,stroke:#333
    style RB_View fill:#e8e8e8,stroke:#333
    style RB_Edit fill:#e8e8e8,stroke:#333

    style MLflowCRD fill:#7ed321,stroke:#333
    style MLflowOpCRD fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style MLflowConfigs fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
    style ConsoleLinks fill:#7ed321,stroke:#333
    style HTTPRoutes fill:#7ed321,stroke:#333
    style RBAC_CR fill:#7ed321,stroke:#333
    style AuthCRs fill:#7ed321,stroke:#333
    style CoreResources fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Deployments fill:#7ed321,stroke:#333
    style BatchResources fill:#7ed321,stroke:#333
    style NetPolicies fill:#7ed321,stroke:#333
    style ServiceMonitors fill:#7ed321,stroke:#333
    style ViewMLflow fill:#7ed321,stroke:#333
    style ViewKF fill:#7ed321,stroke:#333
    style EditMLflow fill:#7ed321,stroke:#333
    style EditKF fill:#7ed321,stroke:#333
