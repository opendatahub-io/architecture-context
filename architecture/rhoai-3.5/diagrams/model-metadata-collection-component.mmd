graph TB
    subgraph "model-metadata-collection"
        subgraph "CLI Tools (Build-Time Only)"
            Extractor["model-extractor<br/>(Go CLI)<br/>Main pipeline"]
            Reporter["metadata-report<br/>(Go CLI)<br/>Completeness analysis"]
        end

        subgraph "Pipeline Stages"
            Discover["Stage 1: Discover<br/>HuggingFace Collections"]
            Extract["Stage 2: Extract<br/>OCI Model Cards"]
            Enrich["Stage 3: Enrich<br/>HuggingFace + Frontmatter"]
            Catalog["Stage 4: Catalog<br/>Generate YAML"]
        end

        subgraph "Shipped Artifact"
            DataContainer["Data Container<br/>(ubi9-minimal)<br/>sleep infinity"]
            ModelCatalog["models-catalog.yaml"]
            ValidatedCatalog["validated-models-catalog.yaml"]
            MCPCatalog["mcp-servers-catalog.yaml"]
            AgentCatalog["agents-catalog.yaml"]
            BenchmarkData["sample-data/<br/>Benchmark JSON"]
        end
    end

    %% Pipeline flow
    Extractor --> Discover
    Discover --> Extract
    Extract --> Enrich
    Enrich --> Catalog

    %% Catalog outputs
    Catalog --> ModelCatalog
    Catalog --> ValidatedCatalog
    Catalog --> MCPCatalog
    Catalog --> AgentCatalog

    %% Data container packaging
    ModelCatalog --> DataContainer
    ValidatedCatalog --> DataContainer
    MCPCatalog --> DataContainer
    AgentCatalog --> DataContainer
    BenchmarkData --> DataContainer

    %% Reporter
    Reporter -.->|analyzes| ModelCatalog

    %% External data sources
    HF["HuggingFace API<br/>huggingface.co"]
    GitHub["GitHub API<br/>api.github.com"]
    Registry["OCI Registry<br/>registry.redhat.io"]

    HF -->|collections & models| Discover
    HF -->|README & frontmatter| Enrich
    Registry -->|manifests & layers| Extract
    GitHub -->|agent.yaml & README| Catalog

    %% Consumers
    Dashboard["RHOAI Dashboard"]
    ModelReg["Model Registry"]

    DataContainer -->|mounts catalogs| Dashboard
    DataContainer -->|catalog metadata| ModelReg

    %% Input files
    SupplementalInput["input/supplemental-catalog.yaml"]
    MCPInput["input/mcp_servers/*.yaml"]
    VLLMInput["input/models/vllm-config/*.yaml"]

    SupplementalInput -->|manual entries| Catalog
    MCPInput -->|MCP definitions| Catalog
    VLLMInput -->|serving config| Enrich

    %% Styling
    style Extractor fill:#4a90e2,stroke:#333,color:#fff
    style Reporter fill:#4a90e2,stroke:#333,color:#fff
    style DataContainer fill:#7ed321,stroke:#333,color:#fff
    style ModelCatalog fill:#b8e986,stroke:#333
    style ValidatedCatalog fill:#b8e986,stroke:#333
    style MCPCatalog fill:#b8e986,stroke:#333
    style AgentCatalog fill:#b8e986,stroke:#333
    style BenchmarkData fill:#b8e986,stroke:#333
    style HF fill:#e8e8e8,stroke:#333
    style GitHub fill:#e8e8e8,stroke:#333
    style Registry fill:#e8e8e8,stroke:#333
    style Dashboard fill:#f5a623,stroke:#333
    style ModelReg fill:#f5a623,stroke:#333
    style SupplementalInput fill:#fff2cc,stroke:#d6b656
    style MCPInput fill:#fff2cc,stroke:#d6b656
    style VLLMInput fill:#fff2cc,stroke:#d6b656
    style Discover fill:#dae8fc,stroke:#6c8ebf
    style Extract fill:#dae8fc,stroke:#6c8ebf
    style Enrich fill:#dae8fc,stroke:#6c8ebf
