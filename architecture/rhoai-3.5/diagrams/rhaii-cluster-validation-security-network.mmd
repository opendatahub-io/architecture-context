graph TB
    subgraph UserContext["USER CONTEXT (Trusted - Admin)"]
        Admin["Cluster Admin<br/>kubectl rhaii-validate<br/>kubeconfig credentials"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token Auth"]
    end

    subgraph PrivilegedPods["GPU NODE - PRIVILEGED PODS (SCC Gated)"]
        direction TB

        subgraph NS_Validation["Namespace: rhaii-validation"]
            ValidatorPod["odh-rhaii-cluster-validator<br/>SA: rhaii-validator<br/>automountSAToken: false<br/>SecurityContext: privileged<br/>FIPS: strictfipsruntime"]
            ToolsServer["odh-rhaii-validator-tools<br/>(Server)<br/>SA: rhaii-validator<br/>SecurityContext: privileged"]
            ToolsClient["odh-rhaii-validator-tools<br/>(Client)<br/>SA: rhaii-validator<br/>SecurityContext: privileged"]
        end
    end

    subgraph HostResources["HOST NODE RESOURCES (Privileged Access)"]
        GPUDriver["GPU Driver<br/>nvidia-smi / rocm-smi<br/>chroot /host"]
        SysFS["Host sysfs<br/>/sys/class/infiniband<br/>/sys/class/nvidia<br/>/sys/bus/pci"]
        RDMA["InfiniBand/RoCE NICs<br/>Kernel bypass<br/>libibverbs"]
    end

    subgraph CRDValidation["CRD DEPENDENCIES (Validated)"]
        GatewayAPI["Gateway API CRDs<br/>gateways, httproutes"]
        InferencePool["InferencePool CRD"]
        LWS["LeaderWorkerSet CRD"]
        CertMgr["cert-manager CRD"]
    end

    subgraph OperatorDeps["OPERATOR DEPENDENCIES (Health Checked)"]
        CertMgrOp["cert-manager Operator<br/>Namespace: cert-manager"]
        IstioOp["Istio Operator<br/>Namespace: istio-system"]
        LWSOp["LWS Operator<br/>Namespace: openshift-lws-operator"]
    end

    %% Admin to API
    Admin -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>cluster-admin required"| K8sAPI

    %% API to pods
    K8sAPI -->|"Job scheduling<br/>pod log streaming<br/>TLS 1.2+"| ValidatorPod
    K8sAPI -->|"Job scheduling<br/>TLS 1.2+"| ToolsServer
    K8sAPI -->|"Job scheduling<br/>TLS 1.2+"| ToolsClient

    %% Validator to host
    ValidatorPod -->|"chroot /host<br/>Local exec<br/>root (privileged)"| GPUDriver
    ValidatorPod -->|"Filesystem read<br/>chroot /host"| SysFS

    %% Cross-node data plane (plaintext)
    ToolsClient -->|"TCP/5201<br/>Plaintext<br/>No auth<br/>(iperf3 bandwidth)"| ToolsServer
    ToolsClient -->|"TCP/12865<br/>Plaintext<br/>No auth<br/>(tcp-lat latency)"| ToolsServer
    ToolsClient -->|"RDMA/dynamic<br/>Kernel bypass<br/>No auth<br/>(ib_write_bw)"| ToolsServer
    ToolsClient -->|"RDMA/dynamic<br/>Kernel bypass<br/>No auth<br/>(ibv_rc_pingpong)"| ToolsServer

    %% RDMA hardware
    ToolsServer -->|"Kernel bypass"| RDMA
    ToolsClient -->|"Kernel bypass"| RDMA

    %% CRD and operator validation
    K8sAPI -.->|"CRD discovery<br/>HTTPS/443"| GatewayAPI
    K8sAPI -.->|"CRD discovery<br/>HTTPS/443"| InferencePool
    K8sAPI -.->|"CRD discovery<br/>HTTPS/443"| LWS
    K8sAPI -.->|"CRD discovery<br/>HTTPS/443"| CertMgr
    K8sAPI -.->|"Pod health check<br/>HTTPS/443"| CertMgrOp
    K8sAPI -.->|"Pod health check<br/>HTTPS/443"| IstioOp
    K8sAPI -.->|"Pod health check<br/>HTTPS/443"| LWSOp

    %% Styling
    classDef userContext fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlPlane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef privileged fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef host fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef crdDep fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef operatorDep fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Admin userContext
    class K8sAPI controlPlane
    class ValidatorPod,ToolsServer,ToolsClient privileged
    class GPUDriver,SysFS,RDMA host
    class GatewayAPI,InferencePool,LWS,CertMgr crdDep
    class CertMgrOp,IstioOp,LWSOp operatorDep
