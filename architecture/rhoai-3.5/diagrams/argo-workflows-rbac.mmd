graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Argo[argo<br/>workflow-controller SA]
        SA_ArgoServer[argo-server<br/>argo-server SA]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Argo[argo-cluster-role-binding<br/>cluster-wide]
        CRB_ArgoServer[argo-server-cluster-role-binding<br/>cluster-wide]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Argo[argo-role<br/>installation namespace]
        RB_ArgoServer[argo-server-role-binding<br/>installation namespace]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Argo[argo-cluster-role]
        CR_ArgoServer[argo-server-cluster-role]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        AGG_View[argo-aggregate-to-view]
        AGG_Edit[argo-aggregate-to-edit]
        AGG_Admin[argo-aggregate-to-admin]
    end

    subgraph Resources_Core["Core API Resources"]
        Pods["core<br/>pods, pods/exec"]
        ConfigMaps["core<br/>configmaps"]
        PVCs["core<br/>persistentvolumeclaims"]
        ServiceAccounts_R["core<br/>serviceaccounts"]
        Events["core<br/>events"]
        Secrets["core<br/>secrets"]
        PodsLog["core<br/>pods/log"]
    end

    subgraph Resources_Argo["argoproj.io Resources"]
        Workflows["argoproj.io<br/>workflows"]
        WFTemplates["argoproj.io<br/>workflowtemplates"]
        ClusterWFTemplates["argoproj.io<br/>clusterworkflowtemplates"]
        CronWorkflows["argoproj.io<br/>cronworkflows"]
        WFTaskSets["argoproj.io<br/>workflowtasksets"]
        WFTaskResults["argoproj.io<br/>workflowtaskresults"]
        WFArtifactGC["argoproj.io<br/>workflowartifactgctasks"]
        WFEventBindings["argoproj.io<br/>workfloweventbindings"]
        EventSources["argoproj.io<br/>eventsources"]
        Sensors["argoproj.io<br/>sensors"]
    end

    subgraph Resources_Policy["Policy Resources"]
        PDBs["policy<br/>poddisruptionbudgets"]
    end

    %% SA → Bindings
    SA_Argo -->|bound via| CRB_Argo
    SA_Argo -->|bound via| RB_Argo
    SA_ArgoServer -->|bound via| CRB_ArgoServer
    SA_ArgoServer -->|bound via| RB_ArgoServer

    %% Bindings → Roles
    CRB_Argo -->|grants| CR_Argo
    CRB_ArgoServer -->|grants| CR_ArgoServer

    %% argo-cluster-role permissions
    CR_Argo -->|"create,get,list,watch,<br/>update,patch,delete"| Pods
    CR_Argo -->|"get,watch,list"| ConfigMaps
    CR_Argo -->|"create,update,delete,get"| PVCs
    CR_Argo -->|"get,list"| ServiceAccounts_R
    CR_Argo -->|"create,patch"| Events
    CR_Argo -->|"get (named)"| Secrets
    CR_Argo -->|"full CRUD"| Workflows
    CR_Argo -->|"get,list,watch"| WFTemplates
    CR_Argo -->|"get,list,watch"| ClusterWFTemplates
    CR_Argo -->|"full CRUD"| CronWorkflows
    CR_Argo -->|"full CRUD"| WFTaskSets
    CR_Argo -->|"list,watch,<br/>deletecollection"| WFTaskResults
    CR_Argo -->|"full CRUD"| WFArtifactGC
    CR_Argo -->|"create,get,delete"| PDBs

    %% argo-server-cluster-role permissions
    CR_ArgoServer -->|"get,watch,list"| ConfigMaps
    CR_ArgoServer -->|"get,create"| Secrets
    CR_ArgoServer -->|"get,list,watch,delete"| Pods
    CR_ArgoServer -->|"get,list,watch,delete"| PodsLog
    CR_ArgoServer -->|"watch,create,patch"| Events
    CR_ArgoServer -->|"get,list,watch"| ServiceAccounts_R
    CR_ArgoServer -->|"full CRUD"| Workflows
    CR_ArgoServer -->|"full CRUD"| WFTemplates
    CR_ArgoServer -->|"full CRUD"| ClusterWFTemplates
    CR_ArgoServer -->|"full CRUD"| CronWorkflows
    CR_ArgoServer -->|"full CRUD"| WFEventBindings
    CR_ArgoServer -->|"full CRUD"| EventSources
    CR_ArgoServer -->|"full CRUD"| Sensors

    %% Aggregate roles
    AGG_View -->|"get,list,watch"| Workflows
    AGG_View -->|"get,list,watch"| WFTemplates
    AGG_View -->|"get,list,watch"| CronWorkflows
    AGG_Edit -->|"+ create,delete,<br/>patch,update"| Workflows
    AGG_Admin -->|"+ workflowtasksets"| WFTaskSets

    %% Styling
    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style SA_ArgoServer fill:#4a90e2,stroke:#333,color:#fff
    style CR_Argo fill:#f5a623,stroke:#333
    style CR_ArgoServer fill:#f5a623,stroke:#333
    style AGG_View fill:#b8d4e3,stroke:#333
    style AGG_Edit fill:#b8d4e3,stroke:#333
    style AGG_Admin fill:#b8d4e3,stroke:#333
    style Workflows fill:#7ed321,stroke:#333
    style WFTemplates fill:#7ed321,stroke:#333
    style ClusterWFTemplates fill:#7ed321,stroke:#333
    style CronWorkflows fill:#7ed321,stroke:#333
    style WFTaskSets fill:#7ed321,stroke:#333
    style WFTaskResults fill:#7ed321,stroke:#333
    style WFArtifactGC fill:#7ed321,stroke:#333
    style WFEventBindings fill:#7ed321,stroke:#333
    style EventSources fill:#7ed321,stroke:#333
    style Sensors fill:#7ed321,stroke:#333
