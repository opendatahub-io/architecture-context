graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (KServe-Managed)"]
        Gateway["KServe Ingress Gateway<br/>443/TCP<br/>TLS 1.2+<br/>Bearer Token Auth"]
    end

    subgraph Pod["POD BOUNDARY (InferenceService Pod)"]
        direction TB

        RBAC["kube-rbac-proxy Sidecar<br/>AuthN: Bearer Token<br/>Injected by RHOAI operator"]

        subgraph MLServerContainer["MLServer Container"]
            direction TB
            REST["REST Server<br/>0.0.0.0:8080/TCP<br/>HTTP plaintext<br/>No auth (delegated)"]
            GRPC["gRPC Server<br/>0.0.0.0:8081/TCP<br/>gRPC/HTTP2 plaintext<br/>add_insecure_port()"]
            Metrics["Metrics Server<br/>0.0.0.0:8082/TCP<br/>HTTP plaintext<br/>/metrics endpoint"]

            subgraph RuntimePlugins["Runtime Plugins (Trusted Allowlist)"]
                SKLearn["SKLearnModel"]
                XGBoost["XGBoostModel"]
                LightGBM["LightGBMModel"]
                ONNX["OnnxModel<br/>(CPU or CUDA)"]
            end
        end

        ModelStorage["Model Storage<br/>/mnt/models (PVC)<br/>Filesystem mount"]
    end

    subgraph OptionalEgress["OPTIONAL EGRESS"]
        OTel["OpenTelemetry Collector<br/>gRPC (configurable port)<br/>plaintext (insecure=True)<br/>No auth"]
        Kafka["Kafka Brokers<br/>9092/TCP<br/>TCP plaintext<br/>No auth"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes 8082/TCP<br/>HTTP plaintext"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Gateway -->|"pod-local<br/>forwarding"| RBAC
    RBAC -->|"HTTP/8080<br/>plaintext<br/>pod-local"| REST
    RBAC -->|"gRPC/8081<br/>plaintext<br/>pod-local"| GRPC
    REST -->|"in-process"| RuntimePlugins
    GRPC -->|"in-process"| RuntimePlugins
    RuntimePlugins -->|"filesystem<br/>read"| ModelStorage
    REST -.->|"gRPC<br/>plaintext<br/>OTLP spans"| OTel
    REST -.->|"TCP/9092<br/>plaintext<br/>inference streams"| Kafka
    Prometheus -->|"HTTP/8082<br/>plaintext<br/>scrape"| Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef server fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef runtime fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef authproxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class Gateway ingress
    class RBAC authproxy
    class REST,GRPC,Metrics server
    class SKLearn,XGBoost,LightGBM,ONNX runtime
    class OTel,Kafka egress
    class Prometheus monitoring
    class ModelStorage storage
