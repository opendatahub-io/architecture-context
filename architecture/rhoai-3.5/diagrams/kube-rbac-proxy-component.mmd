graph TB
    subgraph External["External Clients"]
        Client[Client<br/>browser / kubectl / component]
        Prometheus["prometheus-k8s<br/>(openshift-monitoring)"]
    end

    subgraph Pod["Component Pod (injected by rhods-operator)"]
        direction TB

        subgraph KubeRBACProxy["kube-rbac-proxy Sidecar (8443/TCP TLS)"]
            direction TB
            TLSListener["TLS Listener<br/>8443/TCP, TLS 1.2+"]
            HealthEndpoint["Health Endpoint<br/>/healthz (separate port)"]

            subgraph AuthN["Authentication Layer"]
                DelegatingAuthn["Delegating Authenticator<br/>(Bearer → TokenReview)"]
                OIDCAuthn["OIDC Authenticator<br/>(JWT validation)"]
                X509Authn["X.509 Client Cert<br/>(CA verification)"]
            end

            subgraph AuthZ["Authorization Layer"]
                HardcodedMetrics["Hardcoded Metrics Authorizer<br/>(prometheus-k8s → /metrics)"]
                StaticAuthz["Static Authorizer<br/>(allow-list rules)"]
                SARAuthz["SAR Authorizer<br/>(SubjectAccessReview)"]
            end

            subgraph Support["Support Components"]
                CertReloader["TLS Certificate Reloader<br/>(hot-reload, 1m interval)"]
                TokenSanitizer["Token Sanitizing Filter<br/>(masks bearer tokens in logs)"]
            end
        end

        Upstream["Upstream Application Container<br/>(e.g., TrustyAI, Model Registry)"]
    end

    subgraph K8sAPI["Kubernetes API Server"]
        TokenReview["TokenReview API"]
        SAR["SubjectAccessReview API"]
    end

    subgraph OIDCProvider["OIDC Identity Provider"]
        Discovery["OIDC Discovery + JWKS"]
    end

    %% Request flow
    Client -->|"HTTPS/8443<br/>Bearer Token / JWT / X.509"| TLSListener
    Prometheus -->|"HTTPS/8443<br/>Bearer Token"| TLSListener

    TLSListener --> DelegatingAuthn
    TLSListener --> OIDCAuthn
    TLSListener --> X509Authn

    DelegatingAuthn -->|"TokenReview"| TokenReview
    OIDCAuthn -->|"JWKS fetch"| Discovery

    DelegatingAuthn --> HardcodedMetrics
    DelegatingAuthn --> StaticAuthz
    OIDCAuthn --> StaticAuthz
    X509Authn --> StaticAuthz
    HardcodedMetrics --> SARAuthz
    StaticAuthz --> SARAuthz

    SARAuthz -->|"SubjectAccessReview"| SAR
    SARAuthz -->|"Authorized request"| Upstream

    %% Styling
    style TLSListener fill:#4a90e2,stroke:#333,color:#fff
    style DelegatingAuthn fill:#7ed321,stroke:#333
    style OIDCAuthn fill:#7ed321,stroke:#333
    style X509Authn fill:#7ed321,stroke:#333
    style HardcodedMetrics fill:#f5a623,stroke:#333
    style StaticAuthz fill:#f5a623,stroke:#333
    style SARAuthz fill:#f5a623,stroke:#333
    style CertReloader fill:#b8e986,stroke:#333
    style TokenSanitizer fill:#b8e986,stroke:#333
    style Upstream fill:#50e3c2,stroke:#333
    style TokenReview fill:#e8e8e8,stroke:#333
    style SAR fill:#e8e8e8,stroke:#333
    style Discovery fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style Prometheus fill:#f9f9f9,stroke:#999
