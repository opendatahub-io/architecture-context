graph LR
    Notebooks["Notebooks<br/>(Workbench Images)"]

    %% External Dependencies - Core Runtime
    Notebooks -->|"runtime"| Python["Python 3.12"]
    Notebooks -->|"IDE"| JupyterLab["JupyterLab 4.6"]
    Notebooks -->|"IDE"| CodeServer["code-server 4.112.0"]
    Notebooks -->|"build-time"| NodeJS["Node.js 22.22.0"]
    Notebooks -->|"proxy"| Nginx["nginx 1.24"]
    Notebooks -->|"CGI gateway"| Httpd["httpd (Apache)"]

    %% External Dependencies - ML Frameworks
    Notebooks -->|"deep learning"| PyTorch["PyTorch"]
    Notebooks -->|"deep learning"| TensorFlow["TensorFlow"]
    Notebooks -->|"LLM optimization"| LLMCompressor["LLMCompressor"]

    %% External Dependencies - Accelerators
    Notebooks -->|"GPU accel"| CUDA13["NVIDIA CUDA 13.0"]
    Notebooks -->|"GPU accel"| CUDA12["NVIDIA CUDA 12.9"]
    Notebooks -->|"GPU accel"| ROCm["AMD ROCm 7.14"]

    %% External Dependencies - Tools
    Notebooks -->|"pipelines"| Elyra["Elyra 4.3.1"]
    Notebooks -->|"tracking"| MLflowLib["MLflow >=3.10.0"]
    Notebooks -->|"explainability"| TrustyAI["TrustyAI + Java 17"]
    Notebooks -->|"packaging"| UV["uv 0.11.18"]

    %% Internal RHOAI Dependencies
    Notebooks ===|"pod lifecycle,<br/>sidecar injection"| Controller["ODH Notebook<br/>Controller"]
    Notebooks ===|"ImageStream<br/>annotations"| Dashboard["ODH Dashboard"]
    Notebooks ===|"kustomize<br/>deployment"| Operator["rhods-operator"]
    Notebooks ===|"pipeline<br/>execution"| DSPA["DSPA<br/>443/TCP HTTPS"]
    Notebooks ===|"base layer"| AIPCC["AIPCC Base Images<br/>quay.io/aipcc/base-images/"]
    Notebooks ===|"hermetic builds"| Konflux["Konflux / Tekton"]

    %% Integration Points (other components connecting TO notebooks)
    SecuritySync["security-config-sync"] -.->|"git file sync"| Notebooks
    ElyraBS["Elyra Bootstrapper"] -.->|"embedded in<br/>runtime images"| Notebooks
    OSRegistry["OpenShift Image<br/>Registry"] -.->|"ImageStream import<br/>443/TCP HTTPS"| Notebooks

    %% Outbound Service Dependencies
    Notebooks -->|"model storage<br/>443/TCP HTTPS"| S3["S3 Storage"]
    Notebooks -->|"API server<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    Notebooks -->|"database<br/>27017/TCP"| MongoDB["MongoDB"]
    Notebooks -->|"database<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    Notebooks -->|"streaming<br/>9092/TCP"| Kafka["Kafka"]

