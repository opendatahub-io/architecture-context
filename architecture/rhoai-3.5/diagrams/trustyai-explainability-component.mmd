graph TB
    subgraph TrustyAI["TrustyAI Explainability"]
        direction TB

        subgraph Service["explainability-service (Quarkus 3.8.5)"]
            direction TB
            ConsumerEndpoint["ConsumerEndpoint<br/>/consumer/kserve/v2"]
            CloudEventConsumer["CloudEventConsumer<br/>(Funqy CloudEvents)"]
            FairnessEndpoints["Fairness Endpoints<br/>/metrics/group/fairness/spd<br/>/metrics/group/fairness/dir"]
            DriftEndpoints["Drift Endpoints<br/>/metrics/drift/kstest<br/>/metrics/drift/fouriermmd<br/>/metrics/drift/meanshift"]
            ExplainerEndpoints["Explainer Endpoints<br/>/explainers/local/lime<br/>/explainers/local/shap<br/>(disabled in RHOAI)"]
            DataEndpoints["Data Endpoints<br/>/data/upload<br/>/data/download"]
            InfoEndpoint["Info Endpoint<br/>/info, /info/tags, /info/names"]
            Reconciler["InferencePayloadReconciler<br/>(stateful join buffer)"]
            PrometheusScheduler["PrometheusScheduler<br/>(cron-based metric calc)"]
            PrometheusPublisher["PrometheusPublisher<br/>(Micrometer gauges)"]
            GzipFilter["GzipRequestFilter"]
            HealthEndpoints["Health & Metrics<br/>/q/health/live<br/>/q/health/ready<br/>/q/metrics"]
        end

        subgraph Core["explainability-core (Library)"]
            direction TB
            LIME["LIME Explainer"]
            SHAP["SHAP Explainer"]
            Counterfactual["Counterfactual Explainer<br/>(OptaPlanner)"]
            FairnessMetrics["Fairness Metrics<br/>SPD, DIR"]
            DriftMetrics["Drift Detection<br/>KS Test, Fourier MMD<br/>Meanshift, ApproxKS"]
            NLPMetrics["NLP Metrics<br/>BLEU, ROUGE, WER"]
        end

        subgraph Connectors["explainability-connectors (Library)"]
            direction TB
            KServeV1HTTP["KServe V1 HTTP<br/>Connector"]
            KServeV2HTTP["KServe V2 HTTP<br/>Connector"]
            KServeV2gRPC["KServe V2 gRPC<br/>Connector (Netty)"]
        end

        subgraph Arrow["explainability-arrow (Library)"]
            ArrowConverters["ArrowConverters<br/>(Apache Arrow IPC)"]
        end
    end

    %% Internal relationships
    ConsumerEndpoint -->|inference payloads| Reconciler
    CloudEventConsumer -->|CloudEvent payloads| Reconciler
    FairnessEndpoints -->|compute| FairnessMetrics
    DriftEndpoints -->|compute| DriftMetrics
    ExplainerEndpoints -->|explain| LIME
    ExplainerEndpoints -->|explain| SHAP
    ExplainerEndpoints -->|explain| Counterfactual
    ExplainerEndpoints -->|query model| Connectors
    PrometheusScheduler -->|calculate| FairnessMetrics
    PrometheusScheduler -->|calculate| DriftMetrics
    PrometheusScheduler -->|publish| PrometheusPublisher

    %% External interactions
    ModelMesh["ModelMesh / KServe<br/>(inference payloads)"] -->|REST POST| ConsumerEndpoint
    KServeIS["KServe InferenceService<br/>(CloudEvents)"] -->|CloudEvent| CloudEventConsumer
    User["User / Dashboard"] -->|REST API| FairnessEndpoints
    User -->|REST API| DriftEndpoints
    User -->|REST API| DataEndpoints

    %% Storage
    Reconciler -->|persist| Storage["DataSource<br/>(PVC / DB / MinIO)"]
    PrometheusScheduler -->|read data| Storage

    %% Outbound
    KServeV2gRPC -->|gRPC plaintext| InferenceServer["KServe Inference<br/>Servers"]
    KServeV1HTTP -->|HTTP| InferenceServer
    KServeV2HTTP -->|HTTP| InferenceServer
    PrometheusPublisher -.->|scrape /q/metrics| Prometheus["Prometheus"]

    %% Operator
    Operator["TrustyAI Service<br/>Operator"] -.->|deploys & manages| Service

    %% Styling
    style Service fill:#4a90e2,stroke:#333,color:#fff
    style Core fill:#7ed321,stroke:#333,color:#fff
    style Connectors fill:#f5a623,stroke:#333,color:#fff
    style Arrow fill:#9b59b6,stroke:#333,color:#fff
    style ModelMesh fill:#e8e8e8,stroke:#333
    style KServeIS fill:#e8e8e8,stroke:#333
    style InferenceServer fill:#e8e8e8,stroke:#333
    style Storage fill:#f39c12,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style Operator fill:#e8e8e8,stroke:#333
    style User fill:#3498db,stroke:#333,color:#fff
