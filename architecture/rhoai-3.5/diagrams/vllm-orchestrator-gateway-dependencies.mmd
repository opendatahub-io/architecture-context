graph LR
    GW["vllm-orchestrator-gateway<br/>(Rust 1.86.0)"]

    %% Internal Platform Dependencies (direct)
    GW -->|"POST /api/v2/chat/completions-detection<br/>HTTP or HTTPS/8085<br/>Optional mTLS"| Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies (indirect via orchestrator)
    Orchestrator -->|inference| vLLM["vLLM Inference Server"]
    Orchestrator -->|detection| Detectors["Guardrails Detectors<br/>(e.g., regex-detector)"]

    %% Platform Infrastructure
    GW -.->|"CA cert<br/>/etc/tls/ca/service-ca.crt"| ServiceCA["OpenShift<br/>service-ca"]
    GW -.->|"Client cert+key<br/>/etc/tls/private/"| CertSigner["service-serving-<br/>cert-signer"]
    GW -.->|"config.yaml<br/>GATEWAY_CONFIG env"| ConfigMap["Kubernetes<br/>ConfigMap"]

    %% Key Rust Dependencies
    subgraph RustDeps["Key Rust Crate Dependencies"]
        axum["axum 0.7.9<br/>(HTTP framework)"]
        reqwest["reqwest 0.12.12<br/>(HTTP client)"]
        tokio["tokio 1.41.1<br/>(async runtime)"]
        openssl["openssl 0.10.73<br/>(TLS/mTLS)"]
        nativetls["native-tls 0.2.12<br/>(TLS backend)"]
        serde["serde 1.0.215<br/>(serialization)"]
        serde_yml["serde_yml 0.0.12<br/>(YAML config)"]
        futures["futures 0.3.30<br/>(SSE streaming)"]
        tracing["tracing 0.1.41<br/>(structured logging)"]
    end

    GW --- axum
    GW --- reqwest
    GW --- tokio
    GW --- openssl
    GW --- nativetls
    GW --- serde
    GW --- serde_yml
    GW --- futures
    GW --- tracing

