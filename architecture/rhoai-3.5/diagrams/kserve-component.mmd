graph TB
    subgraph KServe["KServe Platform Component"]
        direction TB

        subgraph Controllers["Controllers"]
            CM["kserve-controller-manager<br/><i>Go Operator</i><br/>8080/TCP metrics, 9443/TCP webhook"]
            LLMCM["llmisvc-controller-manager<br/><i>Go Operator</i><br/>8080/TCP metrics, 9443/TCP webhook"]
            LMCM["kserve-localmodel-controller<br/><i>Go Operator</i><br/>8081/TCP health"]
            ModCtrl["kserve-module-controller<br/><i>Platform Module</i><br/>8081/TCP health"]
        end

        subgraph NodeAgents["Node-Level Agents"]
            LMAgent["kserve-localmodelnode-agent<br/><i>DaemonSet</i><br/>8081/TCP health"]
        end

        subgraph Sidecars["Pod Injected Components"]
            Agent["kserve-agent<br/><i>Sidecar</i><br/>9081/TCP proxy"]
            StorageInit["kserve-storage-initializer<br/><i>Init Container (Python)</i>"]
            Webhooks["Pod Mutation Webhooks<br/><i>Admission Controller</i>"]
        end

        subgraph Routing["Inference Routing"]
            Router["kserve-router<br/><i>HTTP Router</i><br/>8080/TCP, 8443/TCP"]
        end

        subgraph ServingRuntimes["Serving Runtimes"]
            AutoGluon["autogluon-server<br/><i>Python Service</i><br/>8080/TCP"]
        end
    end

    subgraph CRDs["Custom Resource Definitions"]
        ISVC["InferenceService<br/><i>v1beta1</i>"]
        LLMISVC["LLMInferenceService<br/><i>v1alpha2</i>"]
        SR["ServingRuntime<br/><i>v1alpha1</i>"]
        IG["InferenceGraph<br/><i>v1alpha1</i>"]
        LMC["LocalModelCache<br/><i>v1alpha1</i>"]
        TM["TrainedModel<br/><i>v1alpha1</i>"]
        KserveCR["Kserve CR<br/><i>Platform Module</i>"]
    end

    User["Data Scientist / User"] -->|creates| ISVC
    User -->|creates| LLMISVC
    User -->|creates| IG
    User -->|creates| LMC

    ISVC -->|watched by| CM
    LLMISVC -->|watched by| LLMCM
    LMC -->|watched by| LMCM
    IG -->|watched by| CM
    TM -->|watched by| CM
    KserveCR -->|watched by| ModCtrl

    CM -->|creates| Deployments["Deployments<br/>Services<br/>HTTPRoutes"]
    CM -->|triggers| Webhooks
    Webhooks -->|injects| Agent
    Webhooks -->|injects| StorageInit
    LLMCM -->|creates| LWS["LeaderWorkerSets<br/>InferencePools<br/>PodMonitors"]
    LMCM -->|creates PV/PVC<br/>LocalModelNode| LMAgent
    LMAgent -->|creates download Jobs| BatchJobs["Batch Jobs"]

    Router -->|routes requests<br/>through DAG| ISVC

    ModCtrl -->|deploys entire<br/>KServe stack| Controllers

    %% External dependencies
    CM -->|depends on| Istio["Istio"]
    CM -->|depends on| Knative["Knative Serving"]
    CM -->|depends on| GatewayAPI["Gateway API"]
    LLMCM -->|depends on| KEDA["KEDA"]
    LLMCM -->|depends on| LWSExt["LeaderWorkerSet"]
    LLMCM -->|depends on| DRA["DRA"]
    ModCtrl -->|depends on| CertManager["cert-manager"]

    StorageInit -->|downloads from| CloudStorage["S3 / GCS / Azure<br/>HuggingFace / OCI"]

