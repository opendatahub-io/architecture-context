graph TD
    subgraph AuthMethods["Authentication Methods (kube-authkit)"]
        OIDC["OIDC Token"]
        OAuth["OpenShift OAuth"]
        Kubeconfig["kubeconfig"]
        InCluster["In-Cluster SA"]
    end

    subgraph UserIdentity["Authenticated User"]
        User["User / ServiceAccount<br/>(SDK operates with user's permissions)"]
    end

    OIDC -->|"authenticates"| User
    OAuth -->|"authenticates"| User
    Kubeconfig -->|"authenticates"| User
    InCluster -->|"authenticates"| User

    subgraph RayIOGroup["API Group: ray.io"]
        RayClusters["rayclusters<br/>get, list, create, delete, patch"]
        RayJobs["rayjobs<br/>get, list, create, delete, patch"]
    end

    subgraph KueueGroup["API Group: kueue.x-k8s.io"]
        LocalQueues["localqueues<br/>list"]
        Workloads["workloads<br/>list"]
        WPC["workloadpriorityclasses<br/>get"]
    end

    subgraph GatewayGroup["API Group: gateway.networking.k8s.io"]
        HTTPRoutes["httproutes<br/>list, get"]
        Gateways["gateways<br/>list, get"]
    end

    subgraph OpenShiftGroup["API Group: route.openshift.io"]
        Routes["routes<br/>list"]
    end

    subgraph PlatformGroup["API Group: services.platform.opendatahub.io"]
        GatewayConfigs["gatewayconfigs<br/>get"]
    end

    subgraph CoreGroup["API Group: core (v1)"]
        SecretsRes["secrets<br/>list, get, create, replace"]
        Namespaces["namespaces<br/>get"]
    end

    subgraph AuthGroup["API Group: authentication.k8s.io"]
        APIDiscovery["API group discovery<br/>get"]
    end

    %% User to API groups
    User -->|"namespace-scoped"| RayClusters
    User -->|"namespace-scoped"| RayJobs
    User -->|"namespace-scoped"| LocalQueues
    User -->|"namespace-scoped"| Workloads
    User -->|"cluster-scoped"| WPC
    User -->|"namespace-scoped*"| HTTPRoutes
    User -->|"namespace-scoped"| Gateways
    User -->|"namespace-scoped"| Routes
    User -->|"cluster-scoped"| GatewayConfigs
    User -->|"namespace-scoped"| SecretsRes
    User -->|"namespace-scoped"| Namespaces
    User -->|"cluster-scoped"| APIDiscovery

    %% Note about HTTPRoutes
    Note["* HTTPRoute: cluster-wide search<br/>attempted first, falls back to<br/>namespace-scoped on permission error"]

