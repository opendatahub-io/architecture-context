graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator (Rust)"]
        direction TB
        subgraph Server["HTTP Server (axum + hyper)"]
            HealthAPI["Health API<br/>:8034/TCP<br/>/health, /info"]
            V1API["V1 API<br/>:8033/TCP<br/>Classification + Text Gen"]
            V2API["V2 API<br/>:8033/TCP<br/>Detection, Chat, Context"]
        end

        subgraph Core["Orchestration Engine"]
            Router["Request Router"]
            HeaderPassthrough["Header Passthrough<br/>X-Forwarded-Access-Token → Bearer"]
            DetectionBatcher["Detection Batcher Manager<br/>(tokio::select! actor)"]
            CompletionBatcher["Completion Batcher<br/>(multi-choice batching)"]
            MaxIdxBatcher["Max Processed Index Batcher<br/>(ordered detection)"]
        end

        subgraph TLS["TLS Layer (rustls + ring)"]
            ServerTLS["Server TLS<br/>TLS/mTLS/plaintext"]
            ClientTLS["Client TLS Config<br/>Per-service TLS"]
        end

        subgraph Clients["Downstream Clients"]
            HTTPClient["HTTP Client (reqwest)<br/>Detectors, OpenAI"]
            GRPCClient["gRPC Client (tonic)<br/>TGIS, NLP, Chunkers"]
        end

        subgraph Observability["Observability"]
            OTel["OpenTelemetry<br/>Traces + Metrics"]
            TraceLayer["TraceLayer (HTTP)<br/>OtelGrpcLayer (gRPC)"]
        end
    end

    Client[External Client] -->|"HTTP/HTTPS :8033"| V1API
    Client -->|"HTTP/HTTPS :8033"| V2API
    Probes[K8s Probes] -->|"HTTP :8034"| HealthAPI

    V1API --> Router
    V2API --> Router
    Router --> HeaderPassthrough
    HeaderPassthrough --> DetectionBatcher
    DetectionBatcher --> CompletionBatcher
    DetectionBatcher --> MaxIdxBatcher

    Router --> HTTPClient
    Router --> GRPCClient

    HTTPClient -->|"HTTP/HTTPS :8080"| Detectors["Detector Services<br/>(HAP, PII, toxicity)"]
    HTTPClient -->|"HTTP/HTTPS :8080"| OpenAIGen["OpenAI-compatible<br/>Generation Service"]
    GRPCClient -->|"gRPC :8033"| TGIS["TGIS Generation<br/>Service"]
    GRPCClient -->|"gRPC :8085"| NLP["Caikit NLP<br/>Service"]
    GRPCClient -->|"gRPC :8085"| Chunkers["Chunker Services<br/>(Caikit)"]
    OTel -->|"gRPC :4317 / HTTP :4318"| OTLPCollector["OTLP Collector"]

    style Orchestrator fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Server fill:#d5e8d4,stroke:#82b366
    style Core fill:#fff2cc,stroke:#d6b656
    style TLS fill:#f8cecc,stroke:#b85450
    style Clients fill:#dae8fc,stroke:#6c8ebf
    style Observability fill:#e1d5e7,stroke:#9673a6
    style Client fill:#f9f9f9,stroke:#999
    style Probes fill:#f9f9f9,stroke:#999
    style Detectors fill:#ffe6cc,stroke:#d79b00
    style OpenAIGen fill:#ffe6cc,stroke:#d79b00
    style TGIS fill:#ffe6cc,stroke:#d79b00
    style NLP fill:#ffe6cc,stroke:#d79b00
    style Chunkers fill:#ffe6cc,stroke:#d79b00
    style OTLPCollector fill:#e8e8e8,stroke:#999
