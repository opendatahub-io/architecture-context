graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["Platform Gateway (Envoy)<br/>443/TCP<br/>TLS 1.3<br/>Bearer Token Auth"]
        KRBAC["kube-rbac-proxy Sidecar<br/>8443/TCP<br/>TLS<br/>SubjectAccessReview"]
    end

    subgraph Pod["APPLICATION POD (Plaintext Interior)"]
        direction TB
        vLLMServer["vLLM OpenAI API Server<br/>8000/TCP HTTP (plaintext)<br/>No app-level auth<br/>FIPS provider REMOVED"]

        subgraph HPUStack["Gaudi Execution Stack"]
            ModelRunner["HPUModelRunner<br/>Graph compilation<br/>Forward passes"]
            GaudiHPU["Gaudi HPU Device<br/>PCIe / Fabric"]
        end
    end

    subgraph Distributed["INTER-POD (Distributed, No Encryption)"]
        direction TB
        HCCLPeers["HCCL Peers<br/>Dynamic/TCP<br/>Fabric-level only<br/>No auth"]
        NIXLPeers["NIXL/UCX Peers<br/>Dynamic/TCP<br/>RDMA or TCP<br/>No encryption, No auth"]
    end

    subgraph ExternalServices["EGRESS (External Services)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (HF_TOKEN)"]
        HabanaVault["vault.habana.ai<br/>(build-time only)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        KServe["KServe ServingRuntime<br/>Deploys container image"]
        PVC["Model Weights PVC<br/>Volume mount"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Bearer Token"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>SAR check"| KRBAC
    KRBAC -->|"HTTP/8000<br/>Plaintext<br/>No auth (pod-local)"| vLLMServer
    vLLMServer -->|"In-process"| ModelRunner
    ModelRunner -->|"PCIe/Fabric"| GaudiHPU

    %% Distributed
    ModelRunner -.->|"HCCL<br/>Dynamic/TCP<br/>No encryption"| HCCLPeers
    ModelRunner -.->|"UCX/RDMA<br/>Dynamic/TCP<br/>No encryption"| NIXLPeers

    %% Egress
    vLLMServer -.->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub

    %% Platform
    KServe -->|"Deploys"| Pod
    PVC -->|"Volume mount"| Pod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef distributed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef warning fill:#ff6b6b,stroke:#c0392b,stroke-width:3px,color:#fff

    class Client external
    class Gateway,KRBAC ingress
    class vLLMServer warning
    class ModelRunner,GaudiHPU application
    class HCCLPeers,NIXLPeers distributed
    class HFHub,HabanaVault externalservice
    class KServe,PVC platform
