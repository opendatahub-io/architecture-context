graph LR
    SDK[Kubeflow SDK<br/>v0.3.0+rhai0]

    %% Required Python Dependencies
    subgraph RequiredDeps["Required Python Dependencies"]
        kubernetes["kubernetes<br/>>=27.2.0"]
        pydantic["pydantic<br/>>=2.10.0"]
        trainerAPI["kubeflow-trainer-api<br/>>=2.0.0"]
        katibAPI["kubeflow-katib-api<br/>>=0.19.0"]
        structlog["structlog<br/>>=24.1.0"]
    end

    SDK -->|K8s API client| kubernetes
    SDK -->|config validation| pydantic
    SDK -->|TrainJob models| trainerAPI
    SDK -->|Experiment models| katibAPI
    SDK -->|JSON logging| structlog

    %% Optional Python Dependencies
    subgraph OptionalDeps["Optional Python Dependencies"]
        pyspark["pyspark-connect<br/>==4.0.1<br/>[spark]"]
        sparkAPI["kubeflow-spark-api<br/>>=2.4.0<br/>[spark]"]
        modelReg["model-registry<br/>>=0.3.6<br/>[hub]"]
        fsspec["fsspec<br/>>=2025.3.0<br/>[rhai]"]
        s3fs["s3fs<br/>>=2025.3.0<br/>[rhai]"]
        docker["docker<br/>>=6.1.3<br/>[docker]"]
        podman["podman<br/>>=5.6.0<br/>[podman]"]
    end

    SDK -.->|Spark Connect| pyspark
    SDK -.->|SparkConnectServer models| sparkAPI
    SDK -.->|model registry client| modelReg
    SDK -.->|checkpoint filesystem| fsspec
    SDK -.->|S3 backend| s3fs
    SDK -.->|container runtime| docker
    SDK -.->|container runtime| podman

    %% Internal Platform Dependencies (Kubernetes Operators)
    subgraph PlatformDeps["Internal RHOAI Platform Dependencies"]
        TrainerOp["Kubeflow Trainer Operator"]
        KatibCtrl["Kubeflow Katib Controller"]
        SparkOp["Kubeflow Spark Operator"]
        ModelRegServer["Model Registry Server"]
    end

    SDK -->|"CRD: TrainJob<br/>TrainingRuntime"| TrainerOp
    SDK -->|"CRD: Experiment"| KatibCtrl
    SDK -->|"CRD: SparkConnectServer"| SparkOp
    SDK -->|"REST API"| ModelRegServer

    %% Runtime Dependencies (in training pods)
    subgraph RuntimeDeps["Runtime Dependencies (In Training Pods)"]
        TrainingHub["Training Hub backends<br/>(sft, osft, lora_sft, lora_grpo)"]
        HFTransformers["HuggingFace Transformers<br/>(monkey-patched)"]
    end

    SDK -.->|"Python import<br/>(in-container)"| TrainingHub
    SDK -.->|"monkey-patch<br/>Trainer.__init__"| HFTransformers

    %% External Services
    subgraph ExternalSvc["External Services"]
        K8sAPI["Kubernetes API Server"]
        S3["S3-Compatible Storage"]
        HFHub["HuggingFace Hub"]
        PyPI["PyPI / Package Index"]
    end

    SDK -->|"HTTPS/443<br/>Bearer Token"| K8sAPI
    SDK -->|"HTTPS/443<br/>AWS credentials"| S3
    SDK -->|"HTTPS/443<br/>Access Token"| HFHub
    SDK -->|"HTTPS/443<br/>pip install"| PyPI

