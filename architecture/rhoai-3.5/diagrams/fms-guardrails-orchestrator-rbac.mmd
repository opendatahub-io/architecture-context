graph TD
    subgraph PlatformManaged["Platform-Managed RBAC (rhods-operator)"]
        direction TB
        Note["No RBAC resources defined<br/>in this repository.<br/><br/>All RBAC is managed by<br/>the platform operator<br/>(rhods-operator)."]
    end

    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB

        subgraph ExternalAuth["External Auth (Platform Gateway)"]
            GW["kube-rbac-proxy /<br/>OAuth Proxy Sidecar"]
            GW -->|"validates"| Token["Bearer Token / OAuth"]
            GW -->|"enforces"| RBAC["Kubernetes RBAC"]
        end

        subgraph InternalAuth["Internal Auth (Orchestrator)"]
            NoAuth["No per-request auth<br/>enforcement within<br/>orchestrator"]
            HeaderRewrite["Header Passthrough:<br/>X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
        end

        subgraph DownstreamAuth["Downstream Service Auth"]
            mTLS["mTLS Client Certs<br/>(gRPC services:<br/>TGIS, NLP, Chunkers)"]
            BearerToken["Optional Bearer Token<br/>(HTTP services:<br/>Detectors, OpenAI)"]
        end
    end

    subgraph Secrets["Secret Management"]
        direction TB
        TLSCert["TLS Server Cert/Key<br/>Type: kubernetes.io/tls<br/>Via: TLS_CERT_PATH, TLS_KEY_PATH<br/>Provisioned: Platform / cert-manager"]
        ClientCA["TLS Client CA Cert<br/>Type: Opaque<br/>Via: TLS_CLIENT_CA_CERT_PATH<br/>Provisioned: Platform operator"]
        SvcCerts["Per-Service TLS Certs<br/>Type: Opaque<br/>Via: Per-service tls_certs config<br/>Provisioned: Platform operator"]
        APITokens["API Tokens<br/>Type: Opaque<br/>Via: api_token config (env vars)<br/>Provisioned: Platform operator"]
    end

    GW -->|"forwards to"| NoAuth
    NoAuth -->|"passes headers"| HeaderRewrite
    HeaderRewrite -->|"propagates credentials"| mTLS
    HeaderRewrite -->|"propagates credentials"| BearerToken

    style PlatformManaged fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ExternalAuth fill:#d5e8d4,stroke:#82b366
    style InternalAuth fill:#f8cecc,stroke:#b85450
    style DownstreamAuth fill:#dae8fc,stroke:#6c8ebf
    style Secrets fill:#e1d5e7,stroke:#9673a6
    style Note fill:#fff2cc,stroke:#d6b656
    style NoAuth fill:#f8cecc,stroke:#b85450
    style GW fill:#d5e8d4,stroke:#82b366
    style mTLS fill:#dae8fc,stroke:#6c8ebf
    style BearerToken fill:#dae8fc,stroke:#6c8ebf
