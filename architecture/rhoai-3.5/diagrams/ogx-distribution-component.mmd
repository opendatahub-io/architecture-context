graph TB
    subgraph OGX["OGX Distribution Image"]
        direction TB
        Server["OGX Server<br/>(ogx v1.2.1+rhaiv.0)<br/>Port 8321/TCP"]
        Entrypoint["entrypoint.sh<br/>Secret resolution, provider activation"]

        subgraph APIs["HTTP API Endpoints"]
            Health["/v1/health"]
            Chat["/v1/chat/completions"]
            Messages["/v1/messages"]
            Responses["/v1/responses"]
            Files["/v1/files"]
            VectorStores["/v1/vector_stores"]
            Batches["/v1/batches"]
            FileProc["/v1alpha/file-processors/process"]
        end

        subgraph Providers["Configurable Providers"]
            InferenceProviders["Inference<br/>vLLM, Bedrock, WatsonX,<br/>Azure, Vertex AI, OpenAI,<br/>Gemini, Anthropic"]
            VectorProviders["Vector Storage<br/>Milvus, pgvector,<br/>Qdrant, FAISS"]
            FileProviders["File Processing<br/>docling, pypdf,<br/>markitdown"]
            ToolProviders["Tool Runtime<br/>Brave Search, Tavily,<br/>file-search, MCP"]
        end

        subgraph EmbeddedModels["Pre-fetched Models"]
            Granite["granite-embedding-125m-english"]
            Docling["docling layout models"]
            OCR["RapidOCR models"]
            Tiktoken["tiktoken tokenizer"]
        end

        Entrypoint -->|starts| Server
        Server --> APIs
        Server --> Providers
        Server --> EmbeddedModels
    end

    subgraph BuildPipeline["Build Pipeline"]
        BuildYAML["build.yaml<br/>(source of truth)"]
        GenConfig["gen_config.py"]
        GenContainerfile["gen_containerfile.py"]
        GenLockfile["gen_lockfile.py"]
        VerifySecrets["verify_secrets.py"]
        BuildYAML --> GenConfig
        GenConfig -->|generates| ConfigYAML["config.yaml"]
        BuildYAML --> GenContainerfile
        GenContainerfile -->|generates| Containerfile["Dockerfile.konflux"]
        BuildYAML --> GenLockfile
        GenLockfile -->|generates| LockFile["requirements-lock-konflux.txt"]
        BuildYAML --> VerifySecrets
    end

    Client[Client] -->|HTTP requests| Server
    Server -->|auth validation| JWKS["OAuth2/OIDC JWKS"]
    Server -->|persistent storage| PostgreSQL["PostgreSQL<br/>5432/TCP"]

    subgraph Platform["RHOAI Platform"]
        Operator["rhods-operator"]
        KRBAC["kube-rbac-proxy<br/>(sidecar)"]
        Gateway["Gateway API<br/>HTTPRoute<br/>443/TCP TLS"]
    end

    Operator -->|deploys & manages| OGX
    KRBAC -->|auth enforcement| Server
    Client -->|HTTPS| Gateway
    Gateway -->|HTTP| Server

    %% Base Image
    BaseImage["AIPCC CPU Base Image<br/>quay.io/aipcc/base-images/cpu:3.5.0<br/>RHEL 9.6 UBI"] -.->|base| OGX

    style OGX fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Server fill:#2c6cb0,stroke:#333,color:#fff
    style BuildPipeline fill:#f5a623,stroke:#333,stroke-width:2px
    style Platform fill:#7ed321,stroke:#333,stroke-width:2px
    style APIs fill:#6bb5e8,stroke:#333
    style Providers fill:#6bb5e8,stroke:#333
    style EmbeddedModels fill:#6bb5e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style JWKS fill:#e8e8e8,stroke:#333
    style BaseImage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Gateway fill:#82b366,stroke:#333
    style Operator fill:#82b366,stroke:#333
    style KRBAC fill:#82b366,stroke:#333
