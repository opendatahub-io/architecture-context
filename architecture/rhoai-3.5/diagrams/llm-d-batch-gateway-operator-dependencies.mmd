graph LR
    Operator["LLM-D Batch Gateway<br/>Operator"]

    %% External Dependencies (Required)
    Operator -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    Operator -->|"chart rendering"| Helm["helm.sh/helm/v3<br/>v3.20.2"]
    Operator -->|"chart source (pinned)"| BatchChart["batch-gateway<br/>Helm Chart<br/>0fa9baf"]
    Operator -->|"chart source (pinned)"| AsyncChart["async-processor<br/>Helm Chart<br/>dc30b7b"]

    %% External Dependencies (Optional)
    Operator -.->|"HTTPRoute, ReferenceGrant"| GatewayAPI["Gateway API<br/>v1.5.1"]
    Operator -.->|"TLS certificates"| CertManager["cert-manager<br/>v1.20.2"]
    Operator -.->|"monitoring CRDs"| PromOperator["Prometheus Operator<br/>v0.91.0"]

    %% Internal Platform Dependencies
    PlatformOp["opendatahub-operator /<br/>rhods-operator"] -->|"deploys via kustomize<br/>sets images"| Operator

    %% Managed Workload Images (set via env vars)
    Operator -->|"LLM_D_BATCH_GATEWAY_<br/>APISERVER_IMAGE"| APIServerImg["batch-gateway-apiserver<br/>Container Image"]
    Operator -->|"LLM_D_BATCH_GATEWAY_<br/>PROCESSOR_IMAGE"| ProcessorImg["batch-gateway-processor<br/>Container Image"]
    Operator -->|"LLM_D_BATCH_GATEWAY_<br/>GC_IMAGE"| GCImg["batch-gateway-gc<br/>Container Image"]
    Operator -->|"LLM_D_ASYNC_IMAGE"| AsyncImg["llm-d-async<br/>Container Image"]

    %% Runtime Dependencies (from managed workloads)
    subgraph RuntimeDeps["Runtime Dependencies (managed workloads)"]
        InfGW["Inference Gateway / EPP"]
        PostgreSQL["PostgreSQL"]
        Redis["Redis / Valkey"]
        S3["S3 / MinIO"]
    end

    Operator -.->|"managed workloads connect to"| InfGW
    Operator -.->|"managed workloads connect to"| PostgreSQL
    Operator -.->|"managed workloads connect to"| Redis
    Operator -.->|"managed workloads connect to"| S3

    %% Integration Points (other ODH/RHOAI components)
    K8sAPI["Kubernetes API<br/>Server"] -->|"resource mgmt<br/>443/TCP HTTPS"| Operator

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style Helm fill:#999,stroke:#333,color:#fff
    style BatchChart fill:#999,stroke:#333,color:#fff
    style AsyncChart fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#bbb,stroke:#666,stroke-dasharray:5 5
    style CertManager fill:#bbb,stroke:#666,stroke-dasharray:5 5
    style PromOperator fill:#bbb,stroke:#666,stroke-dasharray:5 5
    style PlatformOp fill:#9b59b6,stroke:#333,color:#fff
    style APIServerImg fill:#7ed321,stroke:#333,color:#fff
    style ProcessorImg fill:#7ed321,stroke:#333,color:#fff
    style GCImg fill:#7ed321,stroke:#333,color:#fff
    style AsyncImg fill:#7ed321,stroke:#333,color:#fff
    style InfGW fill:#f5a623,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style Redis fill:#f5a623,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
