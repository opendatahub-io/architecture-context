graph TD
    subgraph UserAuth["User Authentication"]
        Admin["Cluster Admin<br/>(kubeconfig Bearer Token)"]
    end

    subgraph ServiceAccounts["Service Accounts"]
        SA["rhaii-validator<br/>Namespace: rhaii-validation"]
    end

    subgraph ClusterRoleBindings["ClusterRoleBindings"]
        CRB["rhaii-validator<br/>(cluster-scoped)"]
        SCCCRB["rhaii-validator-scc-{namespace}<br/>(cluster-scoped)<br/>Dynamically created/cleaned"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR["rhaii-validator<br/>(ClusterRole)"]
        SCCROLE["system:openshift:scc:privileged<br/>(OpenShift built-in)"]
    end

    subgraph Permissions["Effective Permissions"]
        EMPTY["ClusterRole: EMPTY<br/>(zero API rules)<br/>Pods never call K8s API"]
        PRIVILEGED["SCC: privileged<br/>chroot /host<br/>GPU driver access<br/>sysfs filesystem read"]
    end

    subgraph PodSecurity["Pod Security Configuration"]
        NOTOKEN["automountServiceAccountToken: false<br/>Pods cannot call K8s API"]
        PRIVSEC["SecurityContext:<br/>privileged: true<br/>Required for host access"]
    end

    subgraph ControllerAuth["Controller Authentication"]
        KUBECONFIG["Invoking user's kubeconfig<br/>All API calls use admin credentials<br/>NOT the ServiceAccount token"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| SCCCRB
    CRB -->|"grants"| CR
    SCCCRB -->|"grants"| SCCROLE

    CR -->|"rules: none"| EMPTY
    SCCROLE -->|"enables"| PRIVILEGED

    %% Pod security
    SA -.->|"used by pods"| NOTOKEN
    SA -.->|"used by pods"| PRIVSEC

    %% Controller uses admin creds
    Admin -->|"All API operations<br/>use admin kubeconfig"| KUBECONFIG

    %% Notes
    CLEANUP["Deferred Cleanup<br/>RBAC resources auto-deleted<br/>on exit (survives SIGINT)"]

    SCCCRB -.->|"lifecycle"| CLEANUP

    %% Styling
    style Admin fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333
    style SCCCRB fill:#f5a623,stroke:#333
    style CR fill:#fff2cc,stroke:#d6b656
    style SCCROLE fill:#fff2cc,stroke:#d6b656
    style EMPTY fill:#d5e8d4,stroke:#82b366
    style PRIVILEGED fill:#f8cecc,stroke:#b85450
    style NOTOKEN fill:#d5e8d4,stroke:#82b366
    style PRIVSEC fill:#f8cecc,stroke:#b85450
    style KUBECONFIG fill:#dae8fc,stroke:#6c8ebf
    style CLEANUP fill:#e1d5e7,stroke:#9673a6
