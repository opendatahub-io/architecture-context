    ODMC -->|"CRD Watch/Update"| Gateway["Gateway API<br/>(Gateway CRs)"]
    ODMC -->|"API Integration"| ModelReg["Model Registry<br/>(metadata labels)"]
    ODMC -->|"CRD Read"| HWProfile["HardwareProfile<br/>(scheduling injection)"]
    ODMC -->|"CRD Create/Delete"| PromOp["Prometheus<br/>(ServiceMonitor,<br/>PodMonitor)"]

    %% Components that integrate with ODMC
    Dashboard["RHOAI Dashboard"] -->|"REST API /api/v1/gateways"| ODMC

    %% External Services
    ODMC -->|"NIM metadata"| NGCAPI["NVIDIA NGC API<br/>api.ngc.nvidia.com"]
    ODMC -->|"image validation"| NVCR["NVIDIA Registry<br/>nvcr.io"]
    ODMC -->|"all resource CRUD"| K8sAPI["Kubernetes API"]

