    ODMC -->|"Gateway CRD types"| GWAPI["gateway-api<br/>v1.2.1"]
    ODMC -->|"inference extensions"| GWInfer["gateway-api-inference-extension<br/>v1.3.1"]
    ODMC -->|"AuthPolicy CRD"| AuthorinoLib["kuadrant/authorino<br/>v0.22.0"]
