    ODMC -->|"Kuadrant discovery"| KuadrantLib["kuadrant/kuadrant-operator<br/>v1.4.2"]
    ODMC -->|"EnvoyFilter CRD"| IstioLib["istio client-go<br/>v1.27.8"]
    ODMC -->|"Route, Template CRDs"| OSAPILib["openshift/api<br/>v0.0.0-20260306"]
    ODMC -->|"TriggerAuth CRD"| KEDALib["kedacore/keda<br/>v2.18.3"]
    ODMC -->|"ServiceMonitor CRD"| PromLib["prometheus-operator<br/>v0.89.0"]

