    ODMC -->|"CRD Watch/Reconcile"| KServe["KServe<br/>(InferenceService,<br/>ServingRuntime,<br/>LLMInferenceService,<br/>InferenceGraph)"]
    ODMC -->|"CRD Read"| DSC["DataScienceCluster<br/>(NIM air-gapped,<br/>component config)"]
    ODMC -->|"CRD Read"| DSCI["DSCInitialization<br/>(platform state)"]
