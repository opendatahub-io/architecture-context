graph TB
    subgraph Internal["INTERNAL PLATFORM (Trusted)"]
        Orchestrator["FMS Guardrails Orchestrator<br/>Calls detector APIs for<br/>text analysis on input/output"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS STRICT)"]
        direction TB

        subgraph NS_BuiltIn["Namespace: {user-namespace}"]
            BuiltIn["Built-in Detector<br/>Port: 8080/TCP<br/>Image: odh-built-in-detector-rhel9<br/>Istio sidecar: injected"]
        end

        subgraph NS_HF["Namespace: {user-namespace}"]
            HF["HuggingFace Detector<br/>Port: 8000/TCP<br/>Image: odh-guardrails-detector-hf-runtime-rhel9<br/>KServe InferenceService<br/>Resources: 18-20Gi memory"]
        end

        subgraph NS_Judge["Namespace: {user-namespace}"]
            Judge["LLM Judge Detector<br/>Port: 8000/TCP<br/>Image: guardrails-detector-llm-judge<br/>KServe InferenceService<br/>Resources: 5-10Gi memory"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3/MinIO Storage<br/>9000/TCP HTTP<br/>Auth: AWS IAM<br/>(aws-connection-* Secret)"]
        vLLM["vLLM Inference Server<br/>configurable port HTTP<br/>Auth: None<br/>OpenAI-compatible API"]
        PromServer["Prometheus<br/>Scrapes /metrics"]
    end

    %% Orchestrator to detectors
    Orchestrator -->|"HTTP/8080<br/>mTLS STRICT<br/>KServe auth"| BuiltIn
    Orchestrator -->|"HTTP/8000<br/>mTLS STRICT<br/>KServe auth"| HF
    Orchestrator -->|"HTTP/8000<br/>mTLS STRICT<br/>KServe auth"| Judge

    %% HF to S3
    HF -->|"HTTP/9000<br/>No encryption (internal)<br/>AWS IAM credentials"| S3

    %% Judge to vLLM
    Judge -->|"HTTP/configurable<br/>Encryption: deployment-dependent<br/>No auth"| vLLM

    %% Prometheus scraping
    PromServer -.->|"HTTP/8080<br/>No auth"| BuiltIn
    PromServer -.->|"HTTP/8000<br/>No auth"| HF
    PromServer -.->|"HTTP/8000<br/>No auth"| Judge

    %% Styling
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef detector fill:#e1f5e1,stroke:#82b366,stroke-width:2px

    class Orchestrator internal
    class BuiltIn,HF,Judge detector
    class S3,vLLM,PromServer externalservice
