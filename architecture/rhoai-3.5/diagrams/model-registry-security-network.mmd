graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(UI BFF / CLI / SDK)"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Istio IngressGateway<br/>443/TCP → 8080/TCP<br/>TLS 1.2+<br/>RequestAuthentication"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS ISTIO_MUTUAL)"]
        direction TB

        subgraph NS_MR["Namespace: {model-registry-namespace}"]
            Proxy["model-registry proxy<br/>SA: model-registry<br/>Port: 8080/TCP HTTP<br/>sidecar.istio.io/inject: true<br/>FIPS: strictfipsruntime"]
            DB["MySQL 8.3+ / PostgreSQL 16+<br/>Port: 3306/5432 TCP<br/>PVC-backed"]
        end

        subgraph NS_Controller["Controller (cluster-scoped)"]
            Controller["InferenceService Controller<br/>SA: controller-manager<br/>Metrics: 8443/TCP HTTPS<br/>Health: 8081/TCP HTTP"]
        end

        subgraph NS_KServe["KServe Init Container"]
            CSI["mr-storage-initializer<br/>model-registry:// URI resolver"]
        end
    end

    subgraph Jobs["JOBS (One-shot)"]
        AsyncJob["async-upload Job<br/>Image: cpu:3.5 (AIPCC)<br/>Python"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA Token Auth"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+, AWS IAM"]
        OCI["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+, Docker Auth"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+, API Key"]
        Sigstore["Sigstore (Fulcio/Rekor)<br/>443/TCP HTTPS<br/>TLS 1.2+, OIDC"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2/OIDC"| Gateway

    %% Ingress to Service Mesh
    Gateway -->|"HTTP/8080<br/>mTLS ISTIO_MUTUAL<br/>AuthorizationPolicy"| Proxy

    %% Proxy to Database
    Proxy -->|"MySQL/3306 or PG/5432<br/>Optional TLS<br/>Username/Password"| DB

    %% Controller flows
    Controller -->|"HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI
    Controller -->|"HTTP/8080<br/>mTLS via mesh<br/>Bearer Token"| Proxy

    %% CSI flows
    CSI -->|"HTTP/8080<br/>mTLS via mesh<br/>No App Auth"| Proxy
    CSI -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage Creds"| S3

    %% Async upload flows
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>Docker Auth"| OCI
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| HF
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC Token"| Sigstore
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Proxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef jobs fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class Proxy,DB,Controller,CSI servicemesh
    class AsyncJob jobs
    class K8sAPI,S3,OCI,HF,Sigstore externalservice
