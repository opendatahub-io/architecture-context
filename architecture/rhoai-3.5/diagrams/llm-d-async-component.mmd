graph TB
    subgraph AsyncProcessor["llm-d-async (Async Processor)"]
        direction TB

        subgraph Server["Server Layer"]
            Runner["Runner<br/>(pkg/server/runner.go)"]
            HealthServer["Health Server<br/>:8081/TCP"]
            MetricsServer["Metrics Server<br/>:9090/TCP"]
        end

        subgraph Workers["Worker Layer"]
            WorkerPool["Worker Pool<br/>(pkg/asyncworker/worker.go)"]
            RetryWorker["Retry Worker<br/>(pkg/asyncworker/cancellation.go)"]
            HTTPClient["HTTP Client<br/>MaxIdleConns=100<br/>IdleTimeout=90s"]
        end

        subgraph FlowControl["Flow Control (Gate Factory)"]
            direction LR
            GateFactory["Gate Factory<br/>(601 lines)"]
            PromSatGate["Prometheus<br/>Saturation Gate"]
            PromBudgetGate["Prometheus<br/>Budget Gate"]
            RedisDispatchGate["Redis<br/>Dispatch Gate"]
            RedisQuotaGate["Redis<br/>Quota Gate"]
            LocalConcGate["Local<br/>Concurrency Gate"]
            EndpointScrapeGate["Endpoint<br/>Scrape Gate"]
            CompositeGate["Composite Gate<br/>(min-budget chain)"]
            WaitOnRefuse["Wait-on-Refuse<br/>Decorator"]
        end

        subgraph MergePolicy["Merge Policy"]
            direction LR
            RandomRobin["Random Robin<br/>(reflect.Select)"]
            TierPriority["Tier Priority<br/>(6-level scheduler)"]
        end

        subgraph QueueBackends["Queue Backends"]
            direction LR
            RedisImpl["Redis Pub/Sub<br/>(pkg/redis/redisimpl.go)"]
            SortedSetImpl["Redis Sorted Set<br/>(pkg/redis/sortedset_impl.go)"]
            PubSubImpl["GCP Pub/Sub<br/>(pkg/pubsub/pubsubimpl.go)"]
        end

        subgraph Transform["Request Transform"]
            TransformChain["Transform Chain"]
            GCSMultipart["GCS Multipart<br/>Transform"]
        end

        subgraph Plugins["Plugin System"]
            PluginRegistry["Plugin Registry<br/>(pkg/plugins/registry.go)"]
        end
    end

    subgraph GoModules["Go Modules (importable)"]
        direction LR
        PipelineModule["pipeline/<br/>Flow, Gate, WorkerPool"]
        APIModule["api/<br/>RequestMessage, ResultMessage"]
        ProducerModule["producer/<br/>Client SDK"]
    end

    %% Internal connections
    Runner -->|manages| WorkerPool
    Runner -->|starts| HealthServer
    Runner -->|starts| MetricsServer
    WorkerPool -->|uses| GateFactory
    GateFactory -->|creates| PromSatGate
    GateFactory -->|creates| PromBudgetGate
    GateFactory -->|creates| RedisDispatchGate
    GateFactory -->|creates| RedisQuotaGate
    GateFactory -->|creates| LocalConcGate
    GateFactory -->|creates| EndpointScrapeGate
    GateFactory -->|chains| CompositeGate
    GateFactory -->|decorates| WaitOnRefuse
    WorkerPool -->|dispatches via| HTTPClient
    WorkerPool -->|failures to| RetryWorker
    WorkerPool -->|uses| TransformChain
    TransformChain -->|includes| GCSMultipart
    Runner -->|selects| RandomRobin
    Runner -->|selects| TierPriority
    Runner -->|connects| RedisImpl
    Runner -->|connects| SortedSetImpl
    Runner -->|connects| PubSubImpl

    %% External connections
    Producer["Producer Client"] -->|submits requests| QueueBackends
    Consumer["Consumer Client"] -->|retrieves results| QueueBackends

    %% Module relationships
    PipelineModule -.->|interfaces for| FlowControl
    APIModule -.->|types for| Workers
    ProducerModule -.->|uses| APIModule

    %% Styling
    style AsyncProcessor fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Server fill:#d5e8d4,stroke:#82b366
    style Workers fill:#fff2cc,stroke:#d6b656
    style FlowControl fill:#f8cecc,stroke:#b85450
    style MergePolicy fill:#e1d5e7,stroke:#9673a6
    style QueueBackends fill:#dae8fc,stroke:#6c8ebf
    style Transform fill:#d5e8d4,stroke:#82b366
    style Plugins fill:#f5f5f5,stroke:#666
    style GoModules fill:#f9f9f9,stroke:#999,stroke-dasharray:5 5
    style Producer fill:#e8e8e8,stroke:#666
    style Consumer fill:#e8e8e8,stroke:#666
