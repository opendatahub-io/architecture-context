graph TB
    subgraph TrainingHub["Training Hub Library (PyPI: training-hub)"]
        direction TB

        subgraph Registry["Algorithm-Backend Registry"]
            Factory["create_algorithm()<br/>Factory Function"]
        end

        subgraph Algorithms["Algorithms Layer"]
            SFT["sft()<br/>Supervised Fine-Tuning"]
            OSFT["osft()<br/>Orthogonal Subspace FT"]
            LoRASFT["lora_sft()<br/>LoRA/QLoRA/DoRA"]
            LoRAGRPO["lora_grpo()<br/>LoRA + GRPO (RLVR)"]
            GRPO["grpo()<br/>Full-param GRPO<br/>(alias: lora_r=0)"]
            GEPA["gepa()<br/>Genetic-Pareto<br/>Prompt Optimization"]
        end

        subgraph Backends["Backends Layer"]
            ILTBackend["InstructLabTraining<br/>SFTBackend"]
            MiniTrainer["MiniTrainerOSFT<br/>Backend"]
            UnslothBackend["UnslothLoRA<br/>Backend"]
            ARTBackend["ARTLoRAGRPO<br/>Backend<br/>(subprocess)"]
            VeRLBackend["VeRLLoRAGRPO<br/>Backend<br/>(subprocess)"]
            GEPABackend["GEPABackend"]
            MLflowGEPA["MLflowGEPA<br/>Backend"]
        end

        subgraph Utilities["Support Modules"]
            MemEstimator["estimate()<br/>GPU Memory Estimator"]
            PlotLoss["plot_loss()<br/>Loss Visualization"]
            Rewards["Reward Functions<br/>tool_call_reward()<br/>binary_reward()"]
            ITSRollout["ITSRollout<br/>Adapter"]
        end
    end

    %% Algorithm → Backend connections via Registry
    Factory -.->|resolves| SFT
    Factory -.->|resolves| OSFT
    Factory -.->|resolves| LoRASFT
    Factory -.->|resolves| LoRAGRPO
    Factory -.->|resolves| GRPO
    Factory -.->|resolves| GEPA

    SFT -->|delegates to| ILTBackend
    OSFT -->|delegates to| MiniTrainer
    LoRASFT -->|delegates to| UnslothBackend
    LoRAGRPO -->|delegates to| ARTBackend
    GRPO -->|delegates to| VeRLBackend
    GEPA -->|delegates to| GEPABackend
    GEPA -->|delegates to| MLflowGEPA

    %% Reward integration
    LoRAGRPO -.->|uses| Rewards
    GRPO -.->|uses| Rewards
    LoRAGRPO -.->|optional| ITSRollout

    %% External consumers
    UserCode["User Code<br/>(Notebooks / Scripts / Pipelines)"]
    UserCode -->|Python API| Factory

    %% Styling
    style TrainingHub fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Registry fill:#fff3cd,stroke:#d6a800,stroke-width:2px
    style Algorithms fill:#d4edda,stroke:#28a745,stroke-width:1px
    style Backends fill:#f8d7da,stroke:#dc3545,stroke-width:1px
    style Utilities fill:#e2e3e5,stroke:#6c757d,stroke-width:1px
    style Factory fill:#f5a623,stroke:#d6a800
    style UserCode fill:#4a90e2,stroke:#333,color:#fff
    style SFT fill:#7ed321,stroke:#333
    style OSFT fill:#7ed321,stroke:#333
    style LoRASFT fill:#7ed321,stroke:#333
    style LoRAGRPO fill:#7ed321,stroke:#333
    style GRPO fill:#7ed321,stroke:#333
    style GEPA fill:#7ed321,stroke:#333
    style ARTBackend fill:#ff6b6b,stroke:#333
    style VeRLBackend fill:#ff6b6b,stroke:#333
