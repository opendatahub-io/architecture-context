graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["odh-trainer-operator-<br/>controller-manager"]
        SA_KF["kubeflow-trainer-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Op["manager-rolebinding<br/>(operator)"]
        CRB_KF["kubeflow-trainer-<br/>controller-manager-binding"]
    end

    subgraph OperatorRole["ClusterRole: manager-role (operator)"]
        direction LR
        subgraph OpPlatform["Platform Resources"]
            OpTrainers["components.platform.opendatahub.io<br/>trainers, trainers/status, trainers/finalizers<br/>get, list, watch, patch, update"]
        end
        subgraph OpCore["Core Resources"]
            OpNS["core: namespaces, secrets<br/>create, get, list, patch, update, watch"]
            OpCM["core: configmaps, sa, services<br/>create, delete, get, list, patch, update, watch"]
            OpEvents["core: events<br/>create, patch, update, watch"]
            OpPods["core: pods<br/>get, list"]
        end
        subgraph OpApps["Apps / Admission"]
            OpDeploy["apps: deployments<br/>full CRUD"]
            OpWebhook["admissionregistration: validatingwebhookconfigs<br/>full CRUD"]
            OpCRDs["apiextensions: customresourcedefinitions<br/>create, get, list, patch, update, watch"]
        end
        subgraph OpRBAC["RBAC / Monitoring"]
            OpRoles["rbac: clusterroles, clusterrolebindings, rolebindings<br/>full CRUD"]
            OpMonitor["monitoring: podmonitors<br/>full CRUD"]
            OpNetPol["networking: networkpolicies<br/>create, get, list, patch, update, watch"]
        end
        subgraph OpOpenShift["OpenShift Resources"]
            OpIS["image.openshift.io: imagestreams<br/>full CRUD"]
            OpConfig["config.openshift.io: apiservers, clusterversions<br/>get"]
            OpOLM["operator.openshift.io: jobsetoperators<br/>get, list"]
        end
        subgraph OpTraining["Training Resources"]
            OpTrainCRDs["trainer.kubeflow.org: clustertrainingruntimes,<br/>trainingruntimes, trainjobs<br/>full CRUD"]
            OpJobSets["jobset.x-k8s.io: jobsets<br/>create, get, list, patch, update, watch"]
            OpPodGroups["scheduling.volcano.sh + scheduling.x-k8s.io:<br/>podgroups<br/>create, get, list, patch, update, watch"]
        end
    end

    subgraph DeployedRole["ClusterRole: kubeflow-trainer-controller-manager"]
        direction LR
        subgraph KFTraining["Training Resources"]
            KFTrainCRDs["trainer.kubeflow.org: clustertrainingruntimes,<br/>trainingruntimes, trainjobs<br/>get, list, patch, update, watch"]
            KFJobSets["jobset.x-k8s.io: jobsets<br/>create, get, list, patch, update, watch"]
        end
        subgraph KFCore["Core Resources"]
            KFCM["core: configmaps, secrets<br/>create, get, list, patch, update, watch"]
            KFEvents["core: events<br/>create, patch, update, watch"]
            KFWebhook["admissionregistration:<br/>validatingwebhookconfigs<br/>get, list, update, watch"]
        end
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles (User-facing)"]
        direction LR
        TrainingAdmin["training-admin<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>full CRUD"]
        TrainingEdit["training-edit<br/>trainjobs: full CRUD<br/>runtimes: read-only"]
        TrainingView["training-view<br/>trainjobs, runtimes:<br/>read-only (get, list, watch)"]
    end

    %% Bindings
    SA_Op -->|bound via| CRB_Op
    CRB_Op -->|grants| OperatorRole

    SA_KF -->|bound via| CRB_KF
    CRB_KF -->|grants| DeployedRole

    %% Aggregation labels
    TrainingAdmin -.->|"aggregates into<br/>admin ClusterRole"| AggLabel1["rbac.authorization.k8s.io/<br/>aggregate-to-admin: true"]
    TrainingEdit -.->|"aggregates into<br/>edit ClusterRole"| AggLabel2["rbac.authorization.k8s.io/<br/>aggregate-to-edit: true"]
    TrainingView -.->|"aggregates into<br/>view ClusterRole"| AggLabel3["rbac.authorization.k8s.io/<br/>aggregate-to-view: true"]

    %% Styling
    style SA_Op fill:#4a90e2,color:#fff
    style SA_KF fill:#50c878,color:#fff
    style CRB_Op fill:#ddd,stroke:#333
    style CRB_KF fill:#ddd,stroke:#333
    style TrainingAdmin fill:#f5a623,color:#fff
    style TrainingEdit fill:#f5a623,color:#fff
    style TrainingView fill:#f5a623,color:#fff
