graph LR
    Orch["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies (gRPC)
    Orch -->|"gRPC :8033<br/>Generate, GenerateStream<br/>Tokenize, ModelInfo"| TGIS["TGIS Generation<br/>Service"]
    Orch -->|"gRPC :8085<br/>TextGenerationTaskPredict<br/>ServerStreamingTextGen<br/>TokenizationTaskPredict"| NLP["Caikit NLP<br/>Service"]
    Orch -->|"gRPC :8085<br/>ChunkerTokenizationTaskPredict<br/>BidiStreamingChunkerTokenization"| Chunkers["Chunker Services<br/>(Caikit)"]

    %% Internal Platform Dependencies (HTTP)
    Orch -->|"HTTP(S) :8080<br/>POST /api/v1/text/*<br/>contents, chat, context/doc, generation"| Detectors["Detector Services<br/>(HAP, PII, toxicity)"]
    Orch -->|"HTTP(S) :8080<br/>POST /v1/chat/completions<br/>POST /v1/completions<br/>POST /tokenize"| OpenAI["OpenAI-Compatible<br/>Generation Service"]

    %% Observability
    Orch -.->|"gRPC :4317 or HTTP :4318<br/>Traces + Metrics"| OTLP["OTLP Collector"]

    %% Platform Dependencies
    PlatformOp["rhods-operator"] -->|"manages deployment<br/>certs, RBAC, routes"| Orch
    Gateway["kube-rbac-proxy /<br/>OAuth Proxy"] -->|"forwards auth'd<br/>requests :8033"| Orch

    %% Runtime Dependencies
    Orch -->|"runtime"| Tokio["tokio 1.49.0<br/>(async runtime)"]
    Orch -->|"HTTP server"| Axum["axum 0.8.8"]
    Orch -->|"gRPC client"| Tonic["tonic 0.14.2"]
    Orch -->|"TLS"| Rustls["rustls 0.23.36<br/>(ring backend)"]
    Orch -->|"HTTP client"| Reqwest["reqwest 0.12.28"]
    Orch -->|"tracing"| OTelSDK["opentelemetry 0.31.0"]

    style Orch fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TGIS fill:#7ed321,stroke:#333,color:#fff
    style NLP fill:#7ed321,stroke:#333,color:#fff
    style Chunkers fill:#7ed321,stroke:#333,color:#fff
    style Detectors fill:#7ed321,stroke:#333,color:#fff
    style OpenAI fill:#7ed321,stroke:#333,color:#fff
    style OTLP fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#f5a623,stroke:#333,color:#fff
    style Gateway fill:#f5a623,stroke:#333,color:#fff
    style Tokio fill:#dae8fc,stroke:#6c8ebf
    style Axum fill:#dae8fc,stroke:#6c8ebf
    style Tonic fill:#dae8fc,stroke:#6c8ebf
    style Rustls fill:#f8cecc,stroke:#b85450
    style Reqwest fill:#dae8fc,stroke:#6c8ebf
    style OTelSDK fill:#e1d5e7,stroke:#9673a6
