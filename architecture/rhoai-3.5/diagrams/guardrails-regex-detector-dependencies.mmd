graph LR
    RegexDetector["Guardrails Regex<br/>Detector"]

    %% Internal Platform Dependencies
    RegexDetector -->|"inbound HTTP<br/>8080/TCP"| Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Rust Crate Dependencies
    subgraph "Rust Runtime Dependencies"
        Axum["axum 0.7.9<br/>HTTP Framework"]
        Tokio["tokio 1.41.1<br/>Async Runtime"]
        Regex["regex 1.11.1<br/>Pattern Engine"]
        Serde["serde 1.0.215<br/>Serialization"]
        SerdeJson["serde_json 1.0.133<br/>JSON Handling"]
        TowerHTTP["tower-http 0.6.2<br/>HTTP Middleware"]
        Tracing["tracing 0.1.41<br/>Diagnostics"]
        TracingSub["tracing-subscriber 0.3.19<br/>Log Formatting"]
    end

    RegexDetector -->|"HTTP framework"| Axum
    RegexDetector -->|"async runtime"| Tokio
    RegexDetector -->|"regex engine"| Regex
    RegexDetector -->|"serialization"| Serde
    RegexDetector -->|"JSON parsing"| SerdeJson
    RegexDetector -->|"request tracing"| TowerHTTP
    RegexDetector -->|"structured logging"| Tracing
    RegexDetector -->|"log output"| TracingSub

    %% Container Base
    subgraph "Container Infrastructure"
        UBI["ubi9/ubi-minimal<br/>Base Image"]
        OpenSSL["compat-openssl11<br/>OpenSSL Libraries"]
    end

    RegexDetector -.->|"runtime base"| UBI
    UBI -.->|"installed package"| OpenSSL

    %% Kubernetes Infrastructure
    subgraph "Platform Infrastructure"
        K8s["Kubernetes<br/>Container Orchestration"]
    end

    RegexDetector -.->|"deployed on"| K8s

    style RegexDetector fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Axum fill:#e8e8e8,stroke:#333
    style Tokio fill:#e8e8e8,stroke:#333
    style Regex fill:#e8e8e8,stroke:#333
    style Serde fill:#e8e8e8,stroke:#333
    style SerdeJson fill:#e8e8e8,stroke:#333
    style TowerHTTP fill:#e8e8e8,stroke:#333
    style Tracing fill:#e8e8e8,stroke:#333
    style TracingSub fill:#e8e8e8,stroke:#333
    style UBI fill:#f5a623,stroke:#333
    style OpenSSL fill:#f5a623,stroke:#333
    style K8s fill:#f5a623,stroke:#333
