graph TB
    subgraph "llm-d Meta-Repository"
        direction TB

        subgraph ContainerImages["Container Image Builds"]
            CUDA["llm-d-cuda<br/>NVIDIA CUDA<br/>Port 8000/TCP"]
            GB200["llm-d-cuda-gb200<br/>Blackwell Variant<br/>Port 8000/TCP"]
            CPU["llm-d-cpu<br/>CPU-only<br/>Port 8000/TCP"]
            ROCm["llm-d-rocm<br/>AMD ROCm<br/>Port 8000/TCP"]
            XPU["llm-d-xpu<br/>Intel XPU<br/>Port 8000/TCP"]
            RDMA["llm-d-rdma-tools<br/>Network Debug"]
        end

        subgraph DeploymentGuides["Well-Lit Path Deployment Guides"]
            OptBaseline["Optimized Baseline"]
            PrefixCache["Prefix-Cache Routing"]
            PrefillDecode["Prefill/Decode Disagg"]
            WideEP["Wide Expert Parallelism"]
            TieredKV["Tiered KV-Cache"]
            PredLatency["Predicted Latency"]
            Autoscale["Workload Autoscaling"]
            BatchInf["Batch Inference"]
            MultiModel["Multi-Model Routing"]
        end
    end

    subgraph BuildDeps["Build Dependencies (Compiled into Images)"]
        vLLM["vLLM v0.23.0<br/>Inference Engine"]
        NIXL["NIXL v1.2.0<br/>GPU-to-GPU KV Transfer"]
        UCX["UCX v1.20.0<br/>Communication Framework"]
        UCCL["UCCL v0.1.1<br/>Transport Resilience"]
        NVSHMEM["NVSHMEM v3.4.5<br/>GPU Shared Memory"]
        FlashInfer["FlashInfer v0.6.12<br/>Attention Kernels"]
        LMCache["LMCache v0.4.6<br/>KV-Cache Offloading"]
        DeepEP["DeepEP<br/>Expert Parallelism"]
        DeepGEMM["DeepGEMM<br/>GEMM Kernels"]
    end

    subgraph RuntimePeers["Runtime Peer Components"]
        EPP["llm-d-inference-scheduler<br/>EPP Routing Engine"]
        KVCache["llm-d-kv-cache<br/>KV Block Indexer"]
        LatPred["llm-d-latency-predictor<br/>XGBoost Predictions"]
        WVA["llm-d-workload-variant-autoscaler<br/>SLO-Aware Autoscaler"]
        Async["llm-d-async<br/>Async Request Processor"]
        BatchGW["llm-d-batch-gateway<br/>Batch API Gateway"]
    end

    subgraph GatewayLayer["Gateway / Proxy Layer"]
        Istio["Istio Gateway"]
        AgentGW["AgentGateway"]
        EnvoyAI["Envoy AI Gateway"]
    end

    subgraph K8sInfra["Kubernetes Infrastructure"]
        GAIE["Gateway API CRDs<br/>InferencePool / InferenceObjective"]
        Prometheus["Prometheus<br/>Metrics Scraping"]
        OTEL["OpenTelemetry<br/>Distributed Tracing"]
    end

    %% Build dependencies flow into images
    vLLM --> CUDA
    vLLM --> GB200
    vLLM --> CPU
    vLLM --> ROCm
    vLLM --> XPU
    NIXL --> CUDA
    NIXL --> GB200
    NIXL --> CPU
    NIXL --> ROCm
    UCX --> CUDA
    UCX --> GB200
    UCX --> CPU
    UCX --> ROCm
    UCCL --> CUDA
    UCCL --> GB200
    UCCL --> ROCm
    NVSHMEM --> CUDA
    NVSHMEM --> GB200
    FlashInfer --> CUDA
    FlashInfer --> GB200
    LMCache --> CUDA
    LMCache --> XPU
    DeepEP --> CUDA
    DeepEP --> GB200
    DeepGEMM --> CUDA
    DeepGEMM --> GB200

    %% Runtime interactions
    CUDA -->|ext-proc 9002/gRPC| EPP
    CUDA -->|ZeroMQ| KVCache
    EPP -->|sidecar| LatPred
    WVA -->|K8s API| CUDA
    Async -->|Redis| CUDA
    BatchGW -->|HTTP| Async

    %% Gateway routing
    GatewayLayer -->|HTTP 8000| CUDA
    GatewayLayer -->|ext-proc 9002/gRPC| EPP
    GAIE -->|CRD watches| EPP

    %% Observability
    Prometheus -->|scrape /metrics 8000| CUDA
    CUDA -->|OTLP| OTEL

    %% Deployment guides reference images
    DeploymentGuides -.->|deploys| ContainerImages

