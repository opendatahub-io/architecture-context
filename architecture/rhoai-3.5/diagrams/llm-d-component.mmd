    style NIXL fill:#e67e22,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style KVCache fill:#7ed321,stroke:#333,color:#fff
    style LatPred fill:#7ed321,stroke:#333,color:#fff
    style WVA fill:#7ed321,stroke:#333,color:#fff
    style Async fill:#7ed321,stroke:#333,color:#fff
    style BatchGW fill:#7ed321,stroke:#333,color:#fff
