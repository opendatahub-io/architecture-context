graph TB
    subgraph Container["odh-vllm-gaudi-rhel9 Container Image"]
        direction TB

        subgraph Plugin["vllm-gaudi Plugin (OOT Platform)"]
            direction TB
            HpuPlatform["HpuPlatform<br/>334 lines<br/>20+ override methods<br/>Device mgmt, config,<br/>attention selection"]
            HPUWorker["HPUWorker<br/>HCCL distributed init<br/>KV cache mgmt<br/>Memory profiling"]
            HPUModelRunner["HPUModelRunner<br/>6,597 lines<br/>Forward passes<br/>Graph compilation<br/>Quantization"]
            UnifiedAttn["Unified Attention<br/>3-path algorithm<br/>(causal + shared + unique)<br/>Flash-attention merge"]
            Bucketing["HPUBucketingManager<br/>Exponential / Linear /<br/>Vision strategies<br/>Static shape compilation"]
            Calibration["Calibration Pipeline<br/>6-step FP8 quantization<br/>Intel Neural Compressor"]
        end

        subgraph vLLM["vLLM v0.16.0 (Upstream)"]
            APIServer["OpenAI API Server<br/>Port 8000/TCP"]
            PluginRegistry["Plugin Registry<br/>entry_points"]
        end

        subgraph Stack["Habana Synapse AI Stack"]
            SynapseRT["Synapse Runtime 1.23.0<br/>Graph Compiler"]
            PyTorchHPU["PyTorch 2.9.0<br/>(Habana fork)"]
            HCCL["HCCL<br/>Collective Communication"]
        end
    end

    %% Plugin registration
    HpuPlatform -->|registers via| PluginRegistry
    HPUModelRunner -->|executes on| PyTorchHPU
    HPUWorker -->|communicates via| HCCL
    UnifiedAttn -->|used by| HPUModelRunner
    Bucketing -->|shapes for| HPUModelRunner
    Calibration -.->|optional FP8| HPUModelRunner

    %% External interactions
    Client[Client] -->|POST /v1/*| APIServer
    APIServer -->|dispatches to| HPUModelRunner
    PyTorchHPU -->|compiles via| SynapseRT
    SynapseRT -->|executes on| GaudiHPU["Gaudi HPU<br/>(Gaudi2 / Gaudi3)"]

    %% KServe integration
    KServe["KServe ServingRuntime"] -->|deploys| Container
    PVC["Model Weights PVC"] -->|mounts to| Container

    %% Styling
    style Container fill:#e8f4f8,stroke:#2196F3,stroke-width:2px
    style Plugin fill:#dcedc8,stroke:#689f38,stroke-width:2px
    style vLLM fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style Stack fill:#fce4ec,stroke:#e91e63,stroke-width:2px
    style HpuPlatform fill:#4a90e2,color:#fff
    style HPUWorker fill:#4a90e2,color:#fff
    style HPUModelRunner fill:#4a90e2,color:#fff
    style UnifiedAttn fill:#7ed321,color:#fff
    style Bucketing fill:#7ed321,color:#fff
    style Calibration fill:#7ed321,color:#fff
    style APIServer fill:#f5a623,color:#fff
    style GaudiHPU fill:#9c27b0,color:#fff
    style KServe fill:#e8e8e8,stroke:#333
    style PVC fill:#e8e8e8,stroke:#333
