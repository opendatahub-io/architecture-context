graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_EPP["EPP ServiceAccount<br/>(Helm-managed)"]
        SA_Sidecar["PD-Sidecar ServiceAccount<br/>(optional SSRF mode)"]
        SA_Coord["llm-d-coordinator<br/>(no K8s API access)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_EPP["EPP ClusterRoleBinding<br/>(Helm-managed)"]
        CRB_Sidecar["PD-Sidecar ClusterRoleBinding<br/>(SSRF allowlist mode)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_EPP["EPP ClusterRole<br/>(controller-runtime)"]
        CR_Sidecar["PD-Sidecar SSRF<br/>Allowlist ClusterRole"]
    end

    subgraph APIResources_GIE["inference.networking.k8s.io"]
        InferencePool["InferencePool"]
    end

    subgraph APIResources_Core["core ('')"]
        Pods["Pods"]
    end

    subgraph APIResources_LLMD["llm-d.ai"]
        InferenceObjective["InferenceObjective"]
        InferenceModelRewrite["InferenceModelRewrite"]
    end

    subgraph APIResources_Coord["coordination.k8s.io"]
        Leases["Leases"]
    end

    %% EPP bindings
    SA_EPP -->|"bound via"| CRB_EPP
    CRB_EPP -->|"grants"| CR_EPP

    %% EPP permissions
    CR_EPP -->|"get, list, watch"| InferencePool
    CR_EPP -->|"get, list, watch"| Pods
    CR_EPP -->|"get, list, watch,<br/>update (status)"| InferenceObjective
    CR_EPP -->|"get, list, watch,<br/>update (status)"| InferenceModelRewrite
    CR_EPP -->|"get, list, watch,<br/>create, update"| Leases

    %% Sidecar bindings
    SA_Sidecar -->|"bound via"| CRB_Sidecar
    CRB_Sidecar -->|"grants"| CR_Sidecar

    %% Sidecar permissions (SSRF allowlist)
    CR_Sidecar -->|"get, list, watch"| InferencePool
    CR_Sidecar -->|"get, list, watch"| Pods

    %% Coordinator (no RBAC)
    SA_Coord -.-|"no K8s API access"| SA_Coord

    %% Styling
    style SA_EPP fill:#4a90e2,color:#fff
    style SA_Sidecar fill:#7ed321,color:#fff
    style SA_Coord fill:#999,color:#fff
    style CRB_EPP fill:#dae8fc,stroke:#6c8ebf
    style CRB_Sidecar fill:#d5e8d4,stroke:#82b366
    style CR_EPP fill:#f5a623,color:#fff
    style CR_Sidecar fill:#f5a623,color:#fff
    style InferencePool fill:#7ed321
    style Pods fill:#7ed321
    style InferenceObjective fill:#7ed321
    style InferenceModelRewrite fill:#7ed321
    style Leases fill:#7ed321
