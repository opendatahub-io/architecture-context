graph LR
    RHAII["RHAII Cluster Validation<br/>(kubectl plugin)"]

    %% External Dependencies (Required)
    RHAII -->|"Node listing, Job CRUD<br/>ConfigMap, CRD discovery<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API Server<br/>1.28+"]
    RHAII -->|"nvidia-smi<br/>chroot /host"| NVIDIADriver["NVIDIA GPU Driver<br/>>= 535.0"]

    %% External Dependencies (Optional)
    RHAII -.->|"rocm-smi<br/>chroot /host"| AMDDriver["AMD GPU Driver"]
    RHAII -.->|"RDMA device discovery<br/>bandwidth testing"| RDMA["InfiniBand/RoCE NICs"]
    RHAII -.->|"Exposes RDMA<br/>resources to pods"| RDMAPlugin["RDMA Device Plugin"]

    %% CRD Dependencies (Required for deps check)
    RHAII -->|"CRD existence +<br/>version validation"| GatewayAPI["Gateway API CRDs<br/>v1beta1+"]
    RHAII -->|"CRD existence check<br/>(with fallback API group)"| InferencePool["InferencePool CRD"]
    RHAII -->|"CRD existence check"| LWSCRD["LeaderWorkerSet CRD"]
    RHAII -->|"CRD existence check"| CertMgrCRD["cert-manager CRD"]

    %% Internal Platform Dependencies
    RHAII -->|"Operator health<br/>pod readiness"| CertMgr["cert-manager Operator<br/>Namespace: cert-manager"]
    RHAII -->|"Operator health<br/>pod readiness"| Istio["Istio / Service Mesh<br/>Namespace: istio-system"]
    RHAII -->|"Operator health<br/>pod readiness"| LWSOp["LeaderWorkerSet Operator<br/>Namespace: openshift-lws-operator"]

    %% Tools Dependencies (runtime)
    RHAII -->|"TCP bandwidth<br/>5201/TCP"| Iperf3["iperf3<br/>(tools image)"]
    RHAII -->|"RDMA bandwidth<br/>GPUDirect CUDA"| IBWriteBW["ib_write_bw<br/>(tools image)"]
    RHAII -->|"RDMA connectivity<br/>mesh testing"| IBVPingpong["ibv_rc_pingpong<br/>(tools image)"]

    %% Platform Detection
    RHAII -.->|"Auto-detect"| AKS["Azure AKS"]
    RHAII -.->|"Auto-detect"| EKS["AWS EKS"]
    RHAII -.->|"Auto-detect"| CoreWeave["CoreWeave"]
    RHAII -.->|"Auto-detect"| OCP["OpenShift<br/>(SCC required)"]

    %% Styling
    style RHAII fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style K8sAPI fill:#999,stroke:#333,color:#fff
    style NVIDIADriver fill:#999,stroke:#333,color:#fff
    style AMDDriver fill:#ccc,stroke:#333
    style RDMA fill:#ccc,stroke:#333
    style RDMAPlugin fill:#ccc,stroke:#333

    style GatewayAPI fill:#fff2cc,stroke:#d6b656
    style InferencePool fill:#fff2cc,stroke:#d6b656
    style LWSCRD fill:#fff2cc,stroke:#d6b656
    style CertMgrCRD fill:#fff2cc,stroke:#d6b656

    style CertMgr fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style LWSOp fill:#7ed321,stroke:#333,color:#fff

    style Iperf3 fill:#f5a623,stroke:#333
    style IBWriteBW fill:#f5a623,stroke:#333
    style IBVPingpong fill:#f5a623,stroke:#333

    style AKS fill:#e8e8e8,stroke:#999
    style EKS fill:#e8e8e8,stroke:#999
    style CoreWeave fill:#e8e8e8,stroke:#999
    style OCP fill:#e8e8e8,stroke:#999
