graph LR
    EvalHub["EvalHub<br/>(eval-hub API)"]

    %% Internal RHOAI Dependencies
    EvalHub ---|"CRD Watch<br/>(EvalHub CR)"| TrustyAI["TrustyAI Service<br/>Operator"]
    EvalHub ---|"HTTP reverse proxy<br/>8443→8080"| KubeRBACProxy["kube-rbac-proxy"]
    EvalHubSDK["eval-hub-sdk<br/>(Python)"] -->|"HTTP client<br/>8080/TCP"| EvalHub

    %% Infrastructure Dependencies
    EvalHub -->|"HTTPS/443<br/>SA token"| K8sAPI["Kubernetes API<br/>1.29+"]
    EvalHub -->|"OTLP/4317<br/>gRPC"| OTEL["OpenTelemetry<br/>Collector"]
    Prometheus["Prometheus"] -->|"HTTP/8081<br/>scrape"| EvalHub

    %% External Dependencies
    EvalHub -->|"HTTPS/5000<br/>Bearer token"| MLflow["MLflow<br/>2.x / 3.x"]
    EvalHub -->|"HTTPS/443<br/>AWS IAM"| S3["S3-compatible<br/>Storage"]
    EvalHub -->|"HTTPS/443<br/>Bearer token"| OCI["OCI Registry<br/>(Distribution v2)"]
    EvalHub -->|"HTTP/HTTPS<br/>API key"| ModelEP["Model Inference<br/>Endpoints"]

    %% Database Dependencies
    EvalHub -->|"SQL"| PostgreSQL["PostgreSQL 15+<br/>(production)"]
    EvalHub -.->|"embedded"| SQLite["SQLite<br/>(development)"]

    %% Optional Dependencies
    EvalHub -.->|"Job labels"| Kueue["Kueue<br/>(optional)"]
    EvalHub -->|"K8s API read"| HWProfile["HardwareProfile<br/>CRD"]

    %% MCP Integration
    MCPServer["evalhub-mcp<br/>(MCP Server)"] -->|"HTTP/8080<br/>Bearer token"| EvalHub
    AIAgent["AI Agent / IDE"] -->|"MCP JSON-RPC<br/>3001/TCP"| MCPServer

    %% Styling
    style EvalHub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TrustyAI fill:#7ed321,stroke:#333,color:#fff
    style KubeRBACProxy fill:#7ed321,stroke:#333,color:#fff
    style EvalHubSDK fill:#7ed321,stroke:#333,color:#fff
    style MCPServer fill:#4a90e2,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OTEL fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style MLflow fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style OCI fill:#f5a623,stroke:#333
    style ModelEP fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#333
    style Kueue fill:#e8e8e8,stroke:#333
    style HWProfile fill:#e8e8e8,stroke:#333
    style AIAgent fill:#f9f9f9,stroke:#333
