graph LR
    KubeRay["KubeRay Operator<br/>v1.6.2"]

    %% External Dependencies (Required)
    KubeRay -->|"controller framework"| CtrlRuntime["controller-runtime<br/>v0.22.4"]
    KubeRay -->|"HTTPRoute, ReferenceGrant"| GatewayAPI["Gateway API<br/>v1.4.1"]

    %% External Dependencies (Optional)
    KubeRay -.->|"mTLS certificates<br/>(annotation-gated)"| CertManager["cert-manager<br/>v1.18.2"]
    KubeRay -.->|"OpenShift Routes,<br/>TLS profile, auth config"| OpenShiftAPI["openshift/api"]
    KubeRay -.->|"gang scheduling"| Volcano["Volcano<br/>v1.13.0"]
    KubeRay -.->|"gang scheduling"| SchedPlugins["scheduler-plugins<br/>v0.33.5"]
    KubeRay -.->|"cron parsing<br/>(RayCronJob)"| RobfigCron["robfig/cron<br/>v3.0.1"]

    %% Internal Platform Dependencies
    KubeRay -->|"deployed by<br/>(kustomize manifests)"| RHODSOp["rhods-operator /<br/>opendatahub-operator"]
    KubeRay -->|"parent gateway<br/>for HTTPRoutes"| PlatformGW["Platform Gateway"]
    KubeRay -->|"sidecar image<br/>(injected into head pods)"| KRBP["kube-rbac-proxy"]
    KubeRay -->|"certificate lifecycle<br/>(Issuer, Certificate)"| CertManagerInt["cert-manager"]

    %% Integration Points (Inbound)
    Dashboard["ODH Dashboard"] -.->|"UI management"| KubeRay
    Pipelines["Data Science<br/>Pipelines"] -.->|"auto deploy"| KubeRay
    Kueue["Kueue"] -.->|"managedBy field<br/>lifecycle delegation"| KubeRay

    %% Runtime Dependencies
    KubeRay -->|"CRD watches,<br/>pod/service CRUD"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    KubeRay -->|"job submission,<br/>serve config"| RayDashboard["Ray Dashboard<br/>8265/TCP"]

    %% Batch Scheduler Integrations
    KubeRay -.->|"GPU-aware scheduling"| Kai["Kai Scheduler"]
    KubeRay -.->|"task group annotations"| Yunikorn["Yunikorn"]

