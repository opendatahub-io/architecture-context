graph TD
    subgraph "MLMD Server Authentication"
        Server["MLMD gRPC Server<br/>metadata_store_server"]
        SSLConfig["SSLConfig (Optional)"]
        InsecureCreds["InsecureServerCredentials<br/>(Default - No TLS)"]
        SecureCreds["SslServerCredentials<br/>(When SSLConfig provided)"]

        Server -->|"default"| InsecureCreds
        Server -->|"with SSLConfig"| SecureCreds
    end

    subgraph "TLS Configuration (SSLConfig protobuf)"
        ServerKey["server_key<br/>(PEM private key)"]
        ServerCert["server_cert<br/>(PEM certificate)"]
        CustomCA["custom_ca<br/>(PEM CA bundle)"]
        ClientVerify["client_verify<br/>(boolean)"]

        SecureCreds --> ServerKey
        SecureCreds --> ServerCert
        SecureCreds --> CustomCA
        SecureCreds --> ClientVerify
    end

    subgraph "Client Access"
        AnyClient["Any gRPC Client<br/>(No app-level AuthZ)"]
    end

    subgraph "Kubernetes RBAC (External)"
        Operator["rhods-operator /<br/>opendatahub-operator"]
        Note["RBAC managed by<br/>deploying operator<br/>(not in this repo)"]
        Operator --> Note
    end

    subgraph "Database Credentials"
        DBCreds["Database Credentials<br/>(Opaque Secret)"]
        DBUser["Username"]
        DBPass["Password"]
        DBCreds --> DBUser
        DBCreds --> DBPass
    end

    subgraph "Optional SSL Certs"
        TLSSecret["SSL Certificates<br/>(kubernetes.io/tls)"]
        GRPCCert["gRPC Server TLS"]
        DBSSLCert["Database Connection SSL"]
        TLSSecret --> GRPCCert
        TLSSecret --> DBSSLCert
    end

    AnyClient -->|"gRPC/8080<br/>Full read/write access<br/>to ALL metadata"| Server
    ClientVerify -->|"true: require<br/>client certificate"| AnyClient

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style InsecureCreds fill:#e74c3c,stroke:#333,color:#fff
    style SecureCreds fill:#27ae60,stroke:#333,color:#fff
    style AnyClient fill:#f39c12,stroke:#333,color:#fff
    style ClientVerify fill:#f5a623,stroke:#333
    style Note fill:#e8e8e8,stroke:#333
    style DBCreds fill:#fff2cc,stroke:#d6b656
    style TLSSecret fill:#fff2cc,stroke:#d6b656
