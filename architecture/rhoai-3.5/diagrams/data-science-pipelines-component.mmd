graph TB
    subgraph DSP["Data Science Pipelines"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            APIServer["API Server<br/>8888/TCP HTTP | 8887/TCP gRPC<br/>8443/TCP Webhooks"]
            CacheServer["Cache Server<br/>443→8443/TCP HTTPS<br/>MutatingAdmissionWebhook"]
        end

        subgraph Controllers["Controllers"]
            PersistenceAgent["Persistence Agent<br/>Watches Workflows & SWFs<br/>Syncs status to API Server"]
            SWFController["Scheduled Workflow Controller<br/>9090/TCP Metrics<br/>Reconciles ScheduledWorkflow CRs"]
            ViewerController["Viewer Controller<br/>Reconciles Viewer CRs<br/>Manages Tensorboard"]
        end

        subgraph ArgoSidecars["Argo Workflow Sidecars"]
            Driver["Driver<br/>DAG orchestration<br/>Input resolution, CEL, caching"]
            Launcher["Launcher<br/>User container execution<br/>Artifact I/O, MLMD publish"]
        end
    end

    subgraph ExternalServices["External Services"]
        MLMD["ML Metadata (MLMD)<br/>8080/TCP gRPC"]
        MetadataEnvoy["Metadata Envoy<br/>9090/TCP HTTP<br/>gRPC-to-HTTP proxy"]
    end

    %% CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]
    SWFCR["ScheduledWorkflow CR<br/>kubeflow.org/v1beta1"]
    ViewerCR["Viewer CR<br/>kubeflow.org/v1beta1"]

    %% External Dependencies
    ArgoWF["Argo Workflows"]
    DB["MySQL / PostgreSQL<br/>3306/5432/TCP"]
    ObjectStore["S3-compatible Store<br/>9000/TCP"]
    K8sAPI["Kubernetes API<br/>443/TCP"]

    %% Client
    Client["Client<br/>(SDK / UI / CLI)"]

    %% Flows
    Client -->|"REST/gRPC"| APIServer
    APIServer -->|"SQL"| DB
    APIServer -->|"S3 API"| ObjectStore
    APIServer -->|"HTTPS"| ArgoWF
    APIServer -->|"gRPC"| MLMD
    APIServer -->|"validates/mutates"| PipelineVersionCR

    PipelineCR -->|"managed by"| APIServer
    PipelineVersionCR -->|"owned by"| PipelineCR

    SWFCR -->|"reconciled by"| SWFController
    SWFController -->|"gRPC CreateRun"| APIServer
    SWFController -->|"creates Workflows"| ArgoWF

    ViewerCR -->|"reconciled by"| ViewerController

    PersistenceAgent -->|"watches"| ArgoWF
    PersistenceAgent -->|"gRPC ReportWorkflow"| APIServer

    ArgoWF -->|"spawns"| Driver
    ArgoWF -->|"spawns"| Launcher
    Driver -->|"gRPC cache"| APIServer
    Driver -->|"gRPC metadata"| MLMD
    Launcher -->|"artifact I/O"| ObjectStore
    Launcher -->|"gRPC metadata"| MLMD

    CacheServer -->|"mutates pods"| K8sAPI
    MetadataEnvoy -->|"proxies"| MLMD

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style CacheServer fill:#4a90e2,stroke:#333,color:#fff
    style PersistenceAgent fill:#5b9bd5,stroke:#333,color:#fff
    style SWFController fill:#5b9bd5,stroke:#333,color:#fff
    style ViewerController fill:#5b9bd5,stroke:#333,color:#fff
    style Driver fill:#9b59b6,stroke:#333,color:#fff
    style Launcher fill:#9b59b6,stroke:#333,color:#fff
    style MLMD fill:#e67e22,stroke:#333,color:#fff
    style MetadataEnvoy fill:#e67e22,stroke:#333,color:#fff
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style SWFCR fill:#f5a623,stroke:#333
    style ViewerCR fill:#f5a623,stroke:#333
    style ArgoWF fill:#999,stroke:#333,color:#fff
    style DB fill:#999,stroke:#333,color:#fff
    style ObjectStore fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Client fill:#d5e8d4,stroke:#82b366
