graph TB
    subgraph "Guardrails Regex Detector"
        direction TB
        Service["regex-detector<br/>(Rust / axum)<br/>Port 8080/TCP"]

        subgraph "Built-in Detectors"
            Email["Email Detector<br/>PII Type"]
            SSN["SSN Detector<br/>PII Type"]
            CreditCard["Credit Card Detector<br/>PII Type"]
        end

        subgraph "Custom Detectors"
            CustomRegex["Custom Regex Engine<br/>User-supplied patterns"]
        end

        subgraph "Endpoints"
            DetectAPI["POST /api/v1/text/contents<br/>Detection API"]
            HealthAPI["GET /health<br/>Health Check"]
        end

        Service --> DetectAPI
        Service --> HealthAPI
        DetectAPI --> Email
        DetectAPI --> SSN
        DetectAPI --> CreditCard
        DetectAPI --> CustomRegex
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>HTTP 8080/TCP"| DetectAPI
    DetectAPI -->|"JSON Response<br/>Detection Results"| Orchestrator

    subgraph "Runtime Dependencies"
        Tokio["tokio<br/>Async Runtime"]
        Regex["regex crate<br/>Pattern Engine"]
        Serde["serde / serde_json<br/>Serialization"]
    end

    Service -.->|uses| Tokio
    Service -.->|uses| Regex
    Service -.->|uses| Serde

    style Service fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style DetectAPI fill:#4a90e2,stroke:#333,color:#fff
    style HealthAPI fill:#4a90e2,stroke:#333,color:#fff
    style Email fill:#f5a623,stroke:#333
    style SSN fill:#f5a623,stroke:#333
    style CreditCard fill:#f5a623,stroke:#333
    style CustomRegex fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style Tokio fill:#e8e8e8,stroke:#333
    style Regex fill:#e8e8e8,stroke:#333
    style Serde fill:#e8e8e8,stroke:#333
