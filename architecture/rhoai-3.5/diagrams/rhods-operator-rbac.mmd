graph TD
    subgraph "Service Accounts"
        SA_Operator["rhods-operator<br/>(operator namespace)"]
        SA_AuthProxy["kube-auth-proxy<br/>(openshift-ingress)"]
        SA_AdminGroups["Admin Groups<br/>(from Auth CR)"]
        SA_AllowedGroups["Allowed Groups<br/>(from Auth CR)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Operator["rhods-operator<br/>ClusterRoleBinding"]
        CRB_TokenReview["kube-auth-proxy-tokenreview<br/>ClusterRoleBinding"]
        CRB_Admin["data-science-admingroup-<br/>clusterrolebinding"]
        CRB_Allowed["data-science-allowedgroup-<br/>clusterrolebinding"]
    end

    subgraph "Role Bindings (Namespaced)"
        RB_AdminNS["data-science-admingroup-<br/>rolebinding<br/>(redhat-ods-applications)"]
        RB_AdminMaaS["data-science-admingroup-<br/>maas-rolebinding<br/>(models-as-a-service)"]
        RB_AdminKuadrant["data-science-admingroup-<br/>kuadrant-rolebinding<br/>(kuadrant-system)"]
    end

    subgraph "ClusterRoles"
        CR_Operator["rhods-operator"]
        CR_TokenReview["system:auth-delegator"]
        CR_Admin["data-science-admingroup-<br/>clusterrole"]
        CR_Allowed["data-science-allowedgroup-<br/>clusterrole"]
        CR_AdminRole["data-science-admingroup-role<br/>(namespaced Role)"]
        CR_AdminMaaS["data-science-admingroup-<br/>maas-role<br/>(namespaced Role)"]
        CR_AdminKuadrant["data-science-admingroup-<br/>kuadrant-role<br/>(namespaced Role)"]
    end

    subgraph "Platform CRDs"
        DSC["datasciencecluster.opendatahub.io<br/>DataScienceCluster<br/>(v1, v2)"]
        DSCI["dscinitialization.opendatahub.io<br/>DSCInitialization<br/>(v1, v2)"]
    end

    subgraph "Component CRDs (18 types)"
        CompCRDs["components.platform.opendatahub.io<br/>Dashboard, Kserve, Kueue,<br/>DataSciencePipelines, ModelRegistry,<br/>Workbenches, Ray, TrustyAI,<br/>TrainingOperator, Trainer,<br/>FeastOperator, OGX, SparkOperator,<br/>AIGateway, MCPLifecycleOperator,<br/>MLflowOperator, ModelsAsService,<br/>ModelController"]
    end

    subgraph "Service CRDs"
        SvcCRDs["services.platform.opendatahub.io<br/>Auth, GatewayConfig, Monitoring"]
    end

    subgraph "Infrastructure CRDs"
        InfraCRDs["infrastructure.opendatahub.io<br/>HardwareProfile"]
    end

    subgraph "Network & Ingress Resources"
        NetRes["gateway.networking.k8s.io<br/>Gateways, GatewayClasses, HTTPRoutes<br/><br/>networking.istio.io<br/>DestinationRules, EnvoyFilters<br/><br/>route.openshift.io<br/>Routes<br/><br/>networking.k8s.io<br/>NetworkPolicies"]
    end

    subgraph "Core Kubernetes Resources"
        CoreRes["core: Namespaces, Secrets, ConfigMaps,<br/>Services, ServiceAccounts, Pods, PVCs, Events<br/><br/>apps: Deployments, StatefulSets, ReplicaSets<br/><br/>rbac: ClusterRoles, ClusterRoleBindings,<br/>Roles, RoleBindings<br/><br/>apiextensions: CRDs"]
    end

    subgraph "Monitoring Resources"
        MonRes["monitoring.coreos.com<br/>ServiceMonitors, PrometheusRules<br/><br/>monitoring.rhobs<br/>MonitoringStacks, ThanosQueriers<br/><br/>opentelemetry.io<br/>OpenTelemetryCollectors, Instrumentations<br/><br/>perses.dev<br/>Perses, PersesDatasources, PersesDashboards<br/><br/>tempo.grafana.com<br/>TempoMonolithics, TempoStacks"]
    end

    subgraph "OpenShift Resources"
        OSRes["oauth.openshift.io<br/>OAuthClients<br/><br/>config.openshift.io<br/>APIServers, Authentications,<br/>Infrastructures, Ingresses"]
    end

    %% Operator SA bindings
    SA_Operator -->|"bound via"| CRB_Operator
    CRB_Operator -->|"grants"| CR_Operator
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| DSC
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete,<br/>deletecollection"| DSCI
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| CompCRDs
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| SvcCRDs
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| InfraCRDs
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| NetRes
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| CoreRes
    CR_Operator -->|"get,list,watch,create,<br/>update,patch,delete"| MonRes
    CR_Operator -->|"get,list,watch / full"| OSRes

    %% Auth proxy SA
    SA_AuthProxy -->|"bound via"| CRB_TokenReview
    CRB_TokenReview -->|"grants"| CR_TokenReview

    %% Admin groups
    SA_AdminGroups -->|"bound via"| CRB_Admin
    CRB_Admin -->|"grants"| CR_Admin
    SA_AdminGroups -->|"bound via"| RB_AdminNS
    RB_AdminNS -->|"grants"| CR_AdminRole
    SA_AdminGroups -.->|"bound via (conditional)"| RB_AdminMaaS
    RB_AdminMaaS -.->|"grants"| CR_AdminMaaS
    SA_AdminGroups -.->|"bound via (conditional)"| RB_AdminKuadrant
    RB_AdminKuadrant -.->|"grants"| CR_AdminKuadrant

    %% Allowed groups
    SA_AllowedGroups -->|"bound via"| CRB_Allowed
    CRB_Allowed -->|"grants"| CR_Allowed

