graph LR
    OGX["OGX Distribution<br/>(ogx v1.2.1+rhaiv.0)"]

    %% Core Required Dependencies
    OGX -->|"persistent storage<br/>5432/TCP PostgreSQL"| PostgreSQL["PostgreSQL 9.6+"]

    %% Inference Providers (conditional)
    subgraph InferenceProviders["Inference Providers (conditional activation)"]
        vLLM["vLLM<br/>(VLLM_URL)"]
        vLLM_Emb["vLLM Embedding<br/>(VLLM_EMBEDDING_URL)"]
        Bedrock["AWS Bedrock<br/>(ENABLE_BEDROCK)"]
        WatsonX["IBM WatsonX<br/>(WATSONX_API_KEY)"]
        AzureOAI["Azure OpenAI<br/>(AZURE_API_KEY)"]
        VertexAI["Google Vertex AI<br/>(VERTEX_AI_PROJECT)"]
        OpenAI["OpenAI<br/>(OPENAI_API_KEY)"]
        Gemini["Google Gemini<br/>(ENABLE_GEMINI)"]
        Anthropic["Anthropic<br/>(ANTHROPIC_API_KEY)"]
    end

    OGX -.->|"inference<br/>HTTP(S)"| vLLM
    OGX -.->|"embeddings<br/>HTTP(S)"| vLLM_Emb
    OGX -.->|"inference<br/>HTTPS/443"| Bedrock
    OGX -.->|"inference<br/>HTTPS/443"| WatsonX
    OGX -.->|"inference<br/>HTTPS/443"| AzureOAI
    OGX -.->|"inference<br/>HTTPS/443"| VertexAI
    OGX -.->|"inference<br/>HTTPS/443"| OpenAI
    OGX -.->|"inference<br/>HTTPS/443"| Gemini
    OGX -.->|"inference<br/>HTTPS/443"| Anthropic

    %% Vector Storage Providers (conditional)
    subgraph VectorStores["Vector Storage (conditional activation)"]
        Milvus["Milvus<br/>(MILVUS_ENDPOINT)"]
        pgvector["pgvector<br/>(ENABLE_PGVECTOR)"]
        Qdrant["Qdrant<br/>(ENABLE_QDRANT)"]
    end

    OGX -.->|"vector storage<br/>HTTP(S)+mTLS"| Milvus
    OGX -.->|"vector storage<br/>5432/TCP"| pgvector
    OGX -.->|"vector storage<br/>6333-6334/TCP"| Qdrant

    %% Tool Runtime (conditional)
    subgraph ToolRuntime["Tool Runtime (conditional activation)"]
        BraveSearch["Brave Search<br/>(BRAVE_SEARCH_API_KEY)"]
        TavilySearch["Tavily Search<br/>(TAVILY_SEARCH_API_KEY)"]
        MCP["MCP Server<br/>(configured)"]
    end

    OGX -.->|"web search<br/>HTTPS/443"| BraveSearch
    OGX -.->|"web search<br/>HTTPS/443"| TavilySearch
    OGX -.->|"tool execution<br/>HTTP(S)/SSE"| MCP

    %% File & Document Services (conditional)
    subgraph FileServices["File & Document Services (conditional)"]
        S3["AWS S3<br/>(ENABLE_S3)"]
        DoclingServe["Docling Serve<br/>(DOCLING_SERVE_URL)"]
    end

    OGX -.->|"file storage<br/>HTTPS/443"| S3
    OGX -.->|"doc processing<br/>HTTP(S)"| DoclingServe

    %% Internal Platform Dependencies
    subgraph PlatformDeps["RHOAI Platform (internal)"]
        Operator["rhods-operator"]
        KRBAC["kube-rbac-proxy<br/>(sidecar)"]
        OAuth["OAuth/OIDC Provider"]
    end

    Operator -->|"deploys & manages"| OGX
    KRBAC -->|"auth enforcement"| OGX
    OGX -.->|"JWT validation<br/>HTTPS/443"| OAuth

    %% Observability
    OTel["OpenTelemetry Collector<br/>(OTEL_SERVICE_NAME)"]
    OGX -.->|"traces & metrics<br/>OTLP"| OTel

    %% Build Dependencies
    subgraph BuildDeps["Build Dependencies"]
        AIPCCBase["AIPCC CPU Base Image<br/>cpu:3.5.0 (RHEL 9.6)"]
        OGXPkg["ogx package<br/>v1.2.1+rhaiv.0"]
        GraniteModel["granite-embedding-125m-english"]
        DoclingModels["docling layout models"]
        RapidOCR["RapidOCR models"]
    end

    AIPCCBase -.->|"base image"| OGX
    OGXPkg -.->|"pip install"| OGX
    GraniteModel -.->|"pre-fetched artifact"| OGX
    DoclingModels -.->|"pre-fetched artifact"| OGX
    RapidOCR -.->|"pre-fetched artifact"| OGX

    %% Styling
    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    style vLLM fill:#999,stroke:#333
    style vLLM_Emb fill:#999,stroke:#333
    style Bedrock fill:#999,stroke:#333
    style WatsonX fill:#999,stroke:#333
    style AzureOAI fill:#999,stroke:#333
    style VertexAI fill:#999,stroke:#333
    style OpenAI fill:#999,stroke:#333
    style Gemini fill:#999,stroke:#333
    style Anthropic fill:#999,stroke:#333

    style Milvus fill:#e1d5e7,stroke:#9673a6
    style pgvector fill:#e1d5e7,stroke:#9673a6
    style Qdrant fill:#e1d5e7,stroke:#9673a6

    style BraveSearch fill:#f8cecc,stroke:#b85450
    style TavilySearch fill:#f8cecc,stroke:#b85450
    style MCP fill:#f8cecc,stroke:#b85450

    style S3 fill:#fff2cc,stroke:#d6b656
    style DoclingServe fill:#fff2cc,stroke:#d6b656

    style Operator fill:#7ed321,stroke:#333
    style KRBAC fill:#7ed321,stroke:#333
    style OAuth fill:#7ed321,stroke:#333

    style OTel fill:#e6e6e6,stroke:#666

    style AIPCCBase fill:#f5a623,stroke:#333,color:#fff
    style OGXPkg fill:#f5a623,stroke:#333,color:#fff
    style GraniteModel fill:#f5a623,stroke:#333,color:#fff
    style DoclingModels fill:#f5a623,stroke:#333,color:#fff
    style RapidOCR fill:#f5a623,stroke:#333,color:#fff
