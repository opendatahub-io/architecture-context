graph TD
    subgraph Component["vllm-gaudi (Container Image)"]
        Note["No RBAC defined by this component.<br/>This is a container image, not an operator.<br/>RBAC is defined by KServe and<br/>the platform operator (rhods-operator)."]
    end

    subgraph PlatformRBAC["Platform-Provided RBAC"]
        direction TB

        subgraph KServeRBAC["KServe RBAC (manages this container)"]
            KServeSA["ServiceAccount:<br/>kserve-controller-manager"]
            KServeCRB["ClusterRoleBinding:<br/>kserve-manager-rolebinding"]
            KServeCR["ClusterRole:<br/>kserve-manager-role"]
        end

        subgraph AuthSidecar["Auth Sidecar (per-pod)"]
            KRBAC["kube-rbac-proxy<br/>SubjectAccessReview"]
            KRBACSA["ServiceAccount:<br/>(per InferenceService)"]
        end
    end

    subgraph AuthFlow["Authentication Flow"]
        direction TB
        Client["Client Request<br/>Bearer Token"]
        Gateway["Platform Gateway<br/>TLS 1.3"]
        SAR["SubjectAccessReview<br/>(Kubernetes API)"]
        vLLM["vLLM API Server<br/>Port 8000<br/>NO AUTH"]
    end

    %% KServe RBAC chain
    KServeSA -->|"bound via"| KServeCRB
    KServeCRB -->|"grants"| KServeCR
    KServeCR -->|"manages"| InferenceService["serving.kserve.io<br/>InferenceService"]
    KServeCR -->|"manages"| ServingRuntime["serving.kserve.io<br/>ServingRuntime"]

    %% Auth flow
    Client -->|"Bearer Token"| Gateway
    Gateway -->|"HTTPS/8443"| KRBAC
    KRBAC -->|"SAR check"| SAR
    SAR -->|"authorized"| KRBAC
    KRBAC -->|"HTTP/8000<br/>no auth"| vLLM

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px,color:#856404
    style Component fill:#f8f9fa,stroke:#999
    style KServeSA fill:#4a90e2,color:#fff
    style KServeCR fill:#f5a623,color:#fff
    style KRBAC fill:#e91e63,color:#fff
    style vLLM fill:#ff6b6b,color:#fff
    style InferenceService fill:#7ed321,color:#fff
    style ServingRuntime fill:#7ed321,color:#fff
