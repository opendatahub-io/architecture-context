graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["Blue = Test Infrastructure"]
        L2["Orange = Authentication"]
        L3["Green = Resources"]
        L4["Gray = Ephemeral / Temporary"]
    end

    subgraph TestRuntime["Test Runtime Authentication"]
        direction TB

        subgraph SAs["Service Accounts (per-test, ephemeral)"]
            TestSA["test-specific SA<br/>(auto-generated per namespace)"]
        end

        subgraph TempRBAC["Temporary RBAC (created by tests/common/support/rbac.go)"]
            TempRole["Temporary Role<br/>(namespace-scoped)"]
            TempRB["Temporary RoleBinding<br/>(namespace-scoped)"]
        end

        subgraph Cleanup["Lifecycle"]
            CleanupNote["t.Cleanup() removes all<br/>temporary RBAC at test end"]
        end

        TestSA -->|"bound via"| TempRB
        TempRB -->|"grants"| TempRole
        TempRB -.->|"cleaned up by"| CleanupNote
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        direction TB

        subgraph K8sAuth["Kubernetes API (6443/TCP)"]
            K8sMethods["Methods: All"]
            K8sAuthType["Auth: Bearer Token<br/>(ServiceAccount)"]
            K8sEnforce["Enforcement: RBAC"]
        end

        subgraph HFAuth["HuggingFace Hub (443/TCP)"]
            HFMethods["Methods: GET"]
            HFAuthType["Auth: Bearer Token<br/>(HF_TOKEN env var)"]
            HFEnforce["Enforcement: Per-model<br/>access control"]
        end

        subgraph S3Auth["S3 Storage (443/TCP)"]
            S3Methods["Methods: GET, PUT"]
            S3AuthType["Auth: AWS IAM credentials<br/>(env vars)"]
            S3Enforce["Enforcement: Bucket policy"]
        end

        subgraph PromAuth["OpenShift Prometheus (9091/TCP)"]
            PromMethods["Methods: GET"]
            PromAuthType["Auth: Bearer Token"]
            PromEnforce["Enforcement: kube-rbac-proxy<br/>+ cluster-monitoring-view"]
        end
    end

    subgraph APIResources["Kubernetes API Resources Accessed"]
        direction TB

        subgraph KubeflowCRDs["Kubeflow CRDs"]
            PyTorchJob["training.kubeflow.org<br/>PyTorchJob"]
            TrainJob["kubeflow.org<br/>TrainJob"]
            CTRuntime["kubeflow.org<br/>ClusterTrainingRuntime"]
        end

        subgraph RayCRDs["Ray CRDs"]
            RayJob["ray.io<br/>RayJob"]
            RayCluster["ray.io<br/>RayCluster"]
        end

        subgraph KueueCRDs["Kueue CRDs"]
            ClusterQueue["kueue.x-k8s.io<br/>ClusterQueue"]
            LocalQueue["kueue.x-k8s.io<br/>LocalQueue"]
            ResourceFlavor["kueue.x-k8s.io<br/>ResourceFlavor"]
            Workload["kueue.x-k8s.io<br/>Workload"]
        end

        subgraph CoreResources["Core Kubernetes"]
            Pods["core<br/>Pods"]
            Services["core<br/>Services"]
            ConfigMaps["core<br/>ConfigMaps"]
            Namespaces["core<br/>Namespaces"]
        end

        subgraph OpenShiftAPIs["OpenShift APIs"]
            Routes["route.openshift.io<br/>Routes"]
            MachineSets["machine.openshift.io<br/>MachineSets"]
            CSVs["operators.coreos.com<br/>ClusterServiceVersion"]
        end
    end

    %% Connections
    TestSA -->|"get,list,watch,<br/>create,update,delete"| KubeflowCRDs
    TestSA -->|"get,list,watch,<br/>create,update,delete"| RayCRDs
    TestSA -->|"get,list,watch,<br/>create,delete"| KueueCRDs
    TestSA -->|"get,list,watch,<br/>create,delete"| CoreResources
    TestSA -->|"get,list,create"| OpenShiftAPIs

    %% Note: cluster-scoped operations
    ClusterQueue -.->|"cluster-scoped<br/>(not namespace-bound)"| TestSA
    CSVs -.->|"cluster-scoped<br/>(read-only)"| TestSA

    %% Styling
    style TestSA fill:#4a90e2,color:#fff
    style TempRole fill:#bdbdbd,color:#333
    style TempRB fill:#bdbdbd,color:#333
    style CleanupNote fill:#e0e0e0,color:#333

    style K8sAuthType fill:#f5a623,color:#fff
    style HFAuthType fill:#f5a623,color:#fff
    style S3AuthType fill:#f5a623,color:#fff
    style PromAuthType fill:#f5a623,color:#fff

    style PyTorchJob fill:#7ed321,color:#fff
    style TrainJob fill:#7ed321,color:#fff
    style CTRuntime fill:#7ed321,color:#fff
    style RayJob fill:#7ed321,color:#fff
    style RayCluster fill:#7ed321,color:#fff
    style ClusterQueue fill:#7ed321,color:#fff
    style LocalQueue fill:#7ed321,color:#fff
    style ResourceFlavor fill:#7ed321,color:#fff
    style Workload fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style Namespaces fill:#7ed321,color:#fff
    style Routes fill:#7ed321,color:#fff
    style MachineSets fill:#7ed321,color:#fff
    style CSVs fill:#7ed321,color:#fff
