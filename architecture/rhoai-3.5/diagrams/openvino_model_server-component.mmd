graph TB
    subgraph OVMS["OpenVINO Model Server (OVMS)"]
        direction TB

        subgraph Frontends["API Frontends"]
            gRPCFE["gRPC Frontend<br/>(KServe v2 + TFS v1)"]
            HTTPFE["HTTP/REST Frontend<br/>(Drogon)<br/>(KServe v2 + TFS v1 + OpenAI v3)"]
        end

        subgraph AIModules["AI Modules (MediaPipe Calculators)"]
            LLM["LLM Module<br/>Continuous Batching<br/>Streaming + Tool Calling"]
            Embeddings["Embeddings Module<br/>CLS/LAST/MEAN Pooling"]
            Rerank["Rerank Module<br/>Cross-Encoder (Cohere)"]
            ImageGen["Image Generation<br/>SD/FLUX + LoRA"]
            Audio["Audio Module<br/>Whisper STT + TTS"]
        end

        subgraph Core["Core Infrastructure"]
            MediaPipe["MediaPipe Integration<br/>Graph Pipeline Composition"]
            PythonBE["Python Backend<br/>(PyBind11)"]
            Metrics["Metrics Module<br/>(Prometheus)"]
            FSBackends["Filesystem Backends<br/>Local | S3 | Azure | GCS"]
        end

        subgraph Runtime["Inference Runtime"]
            OVRuntime["OpenVINO Runtime 2026.2"]
            OVGenAI["OpenVINO GenAI"]
            OVTokenizers["OpenVINO Tokenizers"]
        end

        CAPI["libovms_shared.so<br/>C API Library"]
    end

    %% Frontend connections
    gRPCFE -->|routes to| MediaPipe
    HTTPFE -->|routes to| MediaPipe

    %% MediaPipe orchestrates AI modules
    MediaPipe --> LLM
    MediaPipe --> Embeddings
    MediaPipe --> Rerank
    MediaPipe --> ImageGen
    MediaPipe --> Audio
    MediaPipe --> PythonBE

    %% AI modules use runtime
    LLM --> OVGenAI
    Embeddings --> OVRuntime
    Rerank --> OVRuntime
    ImageGen --> OVGenAI
    Audio --> OVGenAI
    OVGenAI --> OVRuntime
    OVGenAI --> OVTokenizers

    %% Model loading
    OVRuntime -->|loads models| FSBackends

    %% Metrics
    HTTPFE -->|exposes /metrics| Metrics

    %% External actors
    Client[Client] -->|gRPC| gRPCFE
    Client -->|REST/HTTP| HTTPFE
    EmbedApp[Embedded App] -->|C API| CAPI

    %% External dependencies
    FSBackends -->|HTTPS/443| S3["S3 Storage"]
    FSBackends -->|HTTPS/443| Azure["Azure Blob"]
    FSBackends -->|HTTPS/443| GCS["Google Cloud Storage"]
    FSBackends -->|HTTPS/443| HFHub["HuggingFace Hub"]

    KServe["KServe InferenceService"] -->|manages| OVMS

    %% Styling
    style OVMS fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style gRPCFE fill:#4a90e2,color:#fff
    style HTTPFE fill:#4a90e2,color:#fff
    style LLM fill:#7ed321
    style Embeddings fill:#7ed321
    style Rerank fill:#7ed321
    style ImageGen fill:#7ed321
    style Audio fill:#7ed321
    style MediaPipe fill:#f5a623
    style OVRuntime fill:#9013fe,color:#fff
    style OVGenAI fill:#9013fe,color:#fff
    style OVTokenizers fill:#9013fe,color:#fff
    style CAPI fill:#50e3c2
    style Client fill:#f9f9f9,stroke:#999
    style EmbedApp fill:#f9f9f9,stroke:#999
    style KServe fill:#e8e8e8,stroke:#333
    style S3 fill:#fff2cc,stroke:#d6b656
    style Azure fill:#fff2cc,stroke:#d6b656
    style GCS fill:#fff2cc,stroke:#d6b656
    style HFHub fill:#fff2cc,stroke:#d6b656
