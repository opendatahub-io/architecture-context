graph LR
    Feast["Feast<br/>(feast-operator +<br/>feature-server)"]

    %% External Dependencies (Libraries/Frameworks)
    subgraph ExtDeps["External Dependencies"]
        ControllerRuntime["controller-runtime<br/>v0.23.3"]
        FastAPI["FastAPI<br/>>=0.68.0"]
        Gunicorn["Gunicorn"]
        Uvicorn["Uvicorn<br/>>=0.30.6"]
        GRPC["gRPC<br/>>=1.56.2"]
        PyArrow["PyArrow<br/>>=16.1.0"]
        PrometheusClient["Prometheus client<br/>>=0.20.0"]
        OpenTelemetry["OpenTelemetry<br/>v1.44.0"]
        PyJWT["PyJWT"]
    end

    Feast -->|"operator framework"| ControllerRuntime
    Feast -->|"REST API"| FastAPI
    Feast -->|"WSGI server"| Gunicorn
    Feast -->|"ASGI server"| Uvicorn
    Feast -->|"gRPC serving"| GRPC
    Feast -->|"data processing"| PyArrow
    Feast -->|"metrics"| PrometheusClient
    Feast -.->|"tracing (optional)"| OpenTelemetry
    Feast -->|"JWT auth"| PyJWT

    %% Internal Platform Dependencies
    subgraph InternalDeps["Internal Platform Dependencies"]
        RHODSOperator["rhods-operator /<br/>opendatahub-operator"]
        ServiceCerts["OpenShift Service<br/>Serving Certificates"]
        ODHNotebooks["ODH Notebooks<br/>(kubeflow.org)"]
        SparkOp["Spark Operator<br/>(sparkoperator.k8s.io)"]
        PrometheusOp["Prometheus Operator<br/>(monitoring.coreos.com)"]
        OIDCProvider["OpenShift OAuth /<br/>OIDC Provider"]
    end

    RHODSOperator -->|"deploys via manifests"| Feast
    Feast -->|"TLS auto-provisioning"| ServiceCerts
    Feast -->|"ConfigMap injection"| ODHNotebooks
    Feast -.->|"batch materialization"| SparkOp
    Feast -->|"ServiceMonitor CRDs"| PrometheusOp
    Feast -->|"user authentication"| OIDCProvider

    %% External Store Dependencies
    subgraph StoreDeps["External Store Backends"]
        Redis["Redis<br/>6379/TCP"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        DynamoDB["DynamoDB<br/>443/TCP HTTPS"]
        BigTable["Google BigTable<br/>443/TCP HTTPS"]
        Snowflake["Snowflake<br/>443/TCP HTTPS"]
        CloudStorage["S3 / GCS /<br/>Azure Blob<br/>443/TCP HTTPS"]
    end

    Feast -.->|"online store"| Redis
    Feast -.->|"online/offline store"| PostgreSQL
    Feast -.->|"online store"| DynamoDB
    Feast -.->|"online store"| BigTable
    Feast -.->|"offline store"| Snowflake
    Feast -->|"registry persistence"| CloudStorage

    %% Kubernetes Dependencies
    subgraph K8sDeps["Kubernetes / OpenShift"]
        K8sAPI["Kubernetes API<br/>443/TCP"]
        OpenShiftAPI["OpenShift API<br/>(apiservers.config)"]
        GitRepos["Git Repositories<br/>443/TCP or 22/TCP"]
    end

    Feast -->|"resource management"| K8sAPI
    Feast -->|"TLS profile, cluster type"| OpenShiftAPI
    Feast -.->|"feature definitions"| GitRepos

    %% Consumers (components that depend on Feast)
    subgraph Consumers["Consumers"]
        MLModels["ML Models /<br/>Applications"]
        Notebooks["ODH Notebook<br/>Users"]
    end

    MLModels -->|"/get-online-features<br/>HTTP/gRPC"| Feast
    Notebooks -->|"Feast SDK<br/>(auto-configured)"| Feast

    %% Styling
    style Feast fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style ControllerRuntime fill:#999,stroke:#333
    style FastAPI fill:#999,stroke:#333
    style Gunicorn fill:#999,stroke:#333
    style Uvicorn fill:#999,stroke:#333
    style GRPC fill:#999,stroke:#333
    style PyArrow fill:#999,stroke:#333
    style PrometheusClient fill:#999,stroke:#333
    style OpenTelemetry fill:#999,stroke:#333
    style PyJWT fill:#999,stroke:#333

    style RHODSOperator fill:#7ed321,stroke:#333
    style ServiceCerts fill:#7ed321,stroke:#333
    style ODHNotebooks fill:#7ed321,stroke:#333
    style SparkOp fill:#7ed321,stroke:#333
    style PrometheusOp fill:#7ed321,stroke:#333
    style OIDCProvider fill:#7ed321,stroke:#333

    style Redis fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style DynamoDB fill:#f5a623,stroke:#333
    style BigTable fill:#f5a623,stroke:#333
    style Snowflake fill:#f5a623,stroke:#333
    style CloudStorage fill:#f5a623,stroke:#333

    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style GitRepos fill:#e8e8e8,stroke:#333

    style MLModels fill:#dae8fc,stroke:#6c8ebf
    style Notebooks fill:#dae8fc,stroke:#6c8ebf
