graph LR
    TrainingOp["Training Operator<br/>(opendatahub namespace)"]

    %% External Dependencies (Required)
    TrainingOp -->|"operator framework<br/>v0.19.1"| ControllerRuntime["controller-runtime<br/>v0.19.1"]
    TrainingOp -->|"webhook certs<br/>v0.12.0"| CertController["OPA cert-controller<br/>v0.12.0"]
    TrainingOp -->|"metrics<br/>v1.20.2"| PromClient["prometheus/client_golang<br/>v1.20.2"]

    %% External Dependencies (Optional)
    TrainingOp -.->|"gang scheduling<br/>(optional)"| Volcano["Volcano<br/>v1.9.0"]
    TrainingOp -.->|"gang scheduling<br/>(optional)"| SchedPlugins["scheduler-plugins<br/>v0.28.9"]

    %% Internal Platform Dependencies
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"deploys via<br/>Kustomize"| TrainingOp
    TrainingOp -->|"reads TLS profile<br/>config.openshift.io/v1"| OpenShiftAPI["OpenShift APIServer"]
    PromOp["Prometheus Operator"] -->|"scrapes via<br/>PodMonitor"| TrainingOp

    %% Core Kubernetes
    TrainingOp -->|"CRD reconciliation<br/>Pod/Service CRUD"| K8sAPI["Kubernetes API<br/>Server"]
    TrainingOp -->|"elastic scaling<br/>(PyTorch)"| HPA["HPA Controller"]
    TrainingOp -->|"network isolation<br/>(PyTorch)"| NetPol["NetworkPolicy<br/>Controller"]

    %% Integration Points (consumers)
    Kueue["Kueue<br/>(MultiKueue)"] -.->|"external job mgmt<br/>via ManagedBy field"| TrainingOp

    %% CRDs managed
    subgraph CRDs["Managed CRDs (kubeflow.org/v1)"]
        PyTorchJob["PyTorchJob"]
        TFJob["TFJob"]
        MPIJob["MPIJob"]
        JAXJob["JAXJob"]
        XGBoostJob["XGBoostJob"]
        PaddleJob["PaddleJob"]
    end

    TrainingOp -->|"reconciles"| CRDs

    %% Styling
    style TrainingOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style CertController fill:#999,stroke:#333,color:#fff
    style PromClient fill:#999,stroke:#333,color:#fff
    style Volcano fill:#ccc,stroke:#333,stroke-dasharray:5
    style SchedPlugins fill:#ccc,stroke:#333,stroke-dasharray:5
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style OpenShiftAPI fill:#7ed321,stroke:#333,color:#fff
    style PromOp fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style HPA fill:#f5a623,stroke:#333
    style NetPol fill:#f5a623,stroke:#333
    style Kueue fill:#ccc,stroke:#333,stroke-dasharray:5
    style PyTorchJob fill:#f5a623,stroke:#333
    style TFJob fill:#f5a623,stroke:#333
    style MPIJob fill:#f5a623,stroke:#333
    style JAXJob fill:#f5a623,stroke:#333
    style XGBoostJob fill:#f5a623,stroke:#333
    style PaddleJob fill:#f5a623,stroke:#333
