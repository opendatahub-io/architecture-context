graph TB
    subgraph DSPO["DSPO Controller Manager"]
        Controller["DSPO Controller<br/>(controller-runtime)"]
        SecurityProfileWatcher["SecurityProfile<br/>Watcher"]
        ManagedPipelinesFetcher["Managed Pipelines<br/>Fetcher"]
        Controller --> SecurityProfileWatcher
        Controller --> ManagedPipelinesFetcher
    end

    User["User / Dashboard"] -->|"creates"| DSPACR["DataSciencePipelinesApplication CR"]
    DSPACR -->|"watched by"| Controller

    subgraph ManagedStack["Per-DSPA Managed Stack (namespace-scoped)"]
        direction TB

        subgraph APILayer["API Layer"]
            APIServer["DS Pipelines API Server<br/>REST 8888/TCP | gRPC 8887/TCP"]
            KubeRBACProxy1["kube-rbac-proxy<br/>8443/TCP HTTPS"]
            KubeRBACProxy1 -->|"proxies"| APIServer
        end

        subgraph MetadataLayer["Metadata Layer"]
            MLMDgRPC["MLMD gRPC Server<br/>8080/TCP"]
            EnvoyProxy["MLMD Envoy Proxy<br/>9090/TCP gRPC-web"]
            KubeRBACProxy2["kube-rbac-proxy<br/>8443/TCP HTTPS"]
            KubeRBACProxy2 -->|"proxies"| EnvoyProxy
            EnvoyProxy -->|"gRPC-web to gRPC"| MLMDgRPC
        end

        subgraph WorkflowLayer["Workflow Layer"]
            PersistenceAgent["Persistence Agent"]
            ScheduledWorkflow["Scheduled Workflow<br/>Controller"]
            ArgoController["Argo Workflow<br/>Controller"]
        end

        subgraph StorageLayer["Storage Layer (optional)"]
            MariaDB["MariaDB<br/>3306/TCP"]
            MinIO["MinIO<br/>9000/TCP"]
        end
    end

    Controller -->|"deploys & reconciles"| ManagedStack

    PersistenceAgent -->|"gRPC 8887"| APIServer
    APIServer -->|"MySQL 3306"| MariaDB
    MLMDgRPC -->|"MySQL 3306"| MariaDB
    ArgoController -->|"artifacts"| MinIO
    APIServer -->|"artifacts"| MinIO

    subgraph Webhook["PipelineVersion Webhook (conditional)"]
        WebhookServer["Webhook Server<br/>8443/TCP HTTPS"]
    end

    Controller -->|"deploys when<br/>K8s pipeline store enabled"| Webhook

    ManagedPipelinesFetcher -->|"OCI pull"| OCIRegistry["OCI Registry"]

    style Controller fill:#4a90e2,color:#fff
    style SecurityProfileWatcher fill:#4a90e2,color:#fff
    style ManagedPipelinesFetcher fill:#4a90e2,color:#fff
    style DSPACR fill:#f5a623,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style MLMDgRPC fill:#7ed321,color:#fff
    style EnvoyProxy fill:#7ed321,color:#fff
    style PersistenceAgent fill:#7ed321,color:#fff
    style ScheduledWorkflow fill:#7ed321,color:#fff
    style ArgoController fill:#7ed321,color:#fff
    style MariaDB fill:#d0021b,color:#fff
    style MinIO fill:#d0021b,color:#fff
    style KubeRBACProxy1 fill:#9013fe,color:#fff
    style KubeRBACProxy2 fill:#9013fe,color:#fff
    style WebhookServer fill:#f8e71c,color:#333
    style OCIRegistry fill:#e8e8e8,color:#333
