graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Agent["AI Agent / MCP Client"]
    end

    subgraph Ingress["INGRESS (DMZ - OpenShift Router)"]
        Route["OpenShift Route<br/>rhoai-mcp<br/>443/TCP → 8000/TCP<br/>TLS Edge Termination<br/>insecureEdgeTerminationPolicy: Redirect"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph NS_MCP["Namespace: redhat-ods-applications"]
            MCPServer["RHOAI MCP Server<br/>SA: rhoai-mcp<br/>Port: 8000/TCP HTTP<br/>ClusterIP Service"]
            OIDCAuth["OIDC Auth Middleware<br/>JWT / TokenReview validation"]
            RBACCheck["RBAC Checker<br/>SubjectAccessReview"]
        end

        subgraph NS_KubeSystem["Namespace: kube-system / openshift-apiserver"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph NS_ModelReg["Namespace: model-registry"]
            ModelRegSvc["Model Registry Service<br/>8080/TCP HTTP (direct)<br/>8443/TCP HTTPS (kube-rbac-proxy)"]
        end

        subgraph NS_Planner["Namespace: varies"]
            PlannerSvc["Planner Backend<br/>8000/TCP HTTP"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OIDCIssuer["OIDC Issuer<br/>(OpenShift OAuth / external IDP)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        OCPUserAPI["OCP User API<br/>user.openshift.io/v1<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Flows with security details
    Agent -->|"HTTPS/443<br/>TLS Edge<br/>Bearer Token<br/>(OIDC JWT or OCP OAuth)"| Route

    Route -->|"HTTP/8000<br/>Plaintext (internal)<br/>Bearer Token forwarded"| MCPServer

    MCPServer -->|"validates"| OIDCAuth
    OIDCAuth -->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth"| OIDCIssuer
    OIDCAuth -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    MCPServer -->|"checks"| RBACCheck
    RBACCheck -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token +<br/>Impersonate-User/Group"| K8sAPI

    MCPServer -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token +<br/>Impersonate-User/Group"| K8sAPI

    MCPServer -->|"HTTP/8080<br/>Plaintext (in-cluster)<br/>None / Bearer (OAuth/SA)"| ModelRegSvc

    MCPServer -->|"HTTP/8000<br/>Plaintext (in-cluster)<br/>No Auth"| PlannerSvc

    OIDCAuth -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| OCPUserAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef clusterinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef mcpcore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Agent external
    class Route ingress
    class MCPServer,OIDCAuth,RBACCheck mcpcore
    class K8sAPI,ModelRegSvc,PlannerSvc clusterinternal
    class OIDCIssuer,OCPUserAPI externalservice
