graph TB
    subgraph MonStack["Monitoring Stack (redhat-ods-monitoring)"]
        Prometheus["Prometheus<br/>9090/TCP<br/>Platform metrics aggregation"]
        AlertManager["AlertManager<br/>9093/TCP<br/>Alert routing + notification"]
        Perses["Perses Dashboards<br/>Platform observability UI"]
    end

    subgraph PrometheusTargets["Prometheus Scrape Targets (ServiceMonitor / PodMonitor)"]
        direction TB

        subgraph KRBPMetrics["kube-rbac-proxy HTTPS Metrics (8443/TCP)"]
            PM1["rhods-operator<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM2["KServe Controller<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM3["odh-dashboard<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM4["odh-model-controller<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM5["DSPO API Server<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM6["KubeRay Operator<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM7["Kubeflow Notebook Controller<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM8["TrustyAI Service Operator<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM9["EvalHub<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM10["Model Registry Operator<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            PM11["MLflow Operator<br/>8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
        end

        subgraph AppMetrics["Application HTTP Metrics"]
            PM12["llm-d Router (EPP)<br/>9090/TCP metrics<br/>Auth: None"]
            PM13["vLLM / Model Servers<br/>8000/TCP metrics<br/>Auth: None"]
            PM14["TrustyAI Service<br/>8080/TCP metrics<br/>Auth: None (fairness metrics)"]
            PM15["Argo Workflows<br/>9090/TCP metrics<br/>Auth: None"]
            PM16["GORCH Orchestrator<br/>8034/TCP health+metrics<br/>Auth: None"]
        end

        subgraph MeshMetrics["Service Mesh Metrics"]
            PM17["Istio Envoy sidecars<br/>15090/TCP metrics<br/>Auth: None"]
            PM18["Istiod Control Plane<br/>15014/TCP metrics<br/>Auth: None"]
            PM19["Platform Gateway Envoy<br/>PodMonitor for Istio metrics<br/>Auth: None"]
        end
    end

    subgraph HealthProbes["Health Probes"]
        direction TB

        subgraph OperatorProbes["Operator Health Probes"]
            HP1["rhods-operator<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP2["KServe Controller<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP3["LLMInferenceService Controller<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP4["DSPO<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP5["odh-model-controller<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP6["KubeRay Operator<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP7["TrustyAI Service Operator<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP8["AI Gateway Operator<br/>L: 8081 healthz<br/>R: 8081 readyz"]
            HP9["Model Registry Operator<br/>L: 8081 healthz<br/>R: 8081 readyz"]
        end

        subgraph ServiceProbes["Service Health Probes"]
            HP10["odh-dashboard<br/>L: 8080 healthz<br/>R: 8080 readyz"]
            HP11["llm-d Router (EPP)<br/>L: 9090 healthz<br/>R: 9090 readyz"]
            HP12["Model Registry Instance<br/>L: 8080 healthz<br/>R: 8080 readyz"]
            HP13["MLflow Instance<br/>L: 5000 healthz<br/>R: 5000 healthz"]
            HP14["TrustyAI Service<br/>L: 8080 healthz<br/>R: 8080 readyz"]
            HP15["GORCH Orchestrator<br/>L: 8034 healthz<br/>R: 8034 readyz"]
            HP16["Batch Gateway API Server<br/>L: 8080 healthz<br/>R: 8080 readyz"]
        end

        subgraph InferenceProbes["Inference Server Probes"]
            HP17["vLLM<br/>L: 8000 health<br/>R: 8000 health"]
            HP18["OVMS<br/>L: 8000 ready<br/>R: 8000 ready"]
            HP19["KServe Agent Sidecar<br/>L: 8080 healthz<br/>R: 8080 readyz"]
        end
    end

    subgraph Alerting["Alerting Configuration"]
        direction TB
        AL1["Platform Alerts<br/>Component health, pod restarts,<br/>resource exhaustion"]
        AL2["Inference Alerts<br/>Model latency, error rates,<br/>GPU utilization"]
        AL3["Pipeline Alerts<br/>Failed runs, stuck workflows,<br/>storage capacity"]
        AL4["Security Alerts<br/>Auth failures, certificate expiry,<br/>RBAC violations"]
    end

    %% Prometheus scraping
    Prometheus -->|"scrape"| PM1
    Prometheus -->|"scrape"| PM2
    Prometheus -->|"scrape"| PM3
    Prometheus -->|"scrape"| PM4
    Prometheus -->|"scrape"| PM5
    Prometheus -->|"scrape"| PM12
    Prometheus -->|"scrape"| PM13
    Prometheus -->|"scrape"| PM14
    Prometheus -->|"scrape"| PM17
    Prometheus -->|"scrape"| PM19

    %% Alerting
    Prometheus -->|"alert rules"| AlertManager
    AlertManager -->|"routes"| AL1
    AlertManager -->|"routes"| AL2
    AlertManager -->|"routes"| AL3
    AlertManager -->|"routes"| AL4

    %% Perses
    Prometheus -->|"data source"| Perses

    %% Styling
    classDef prom fill:#e8d5b7,stroke:#b8860b,stroke-width:2px
    classDef probe fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef mesh fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef alert fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef stack fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class PM1,PM2,PM3,PM4,PM5,PM6,PM7,PM8,PM9,PM10,PM11 prom
    class PM12,PM13,PM14,PM15,PM16 prom
    class PM17,PM18,PM19 mesh
    class HP1,HP2,HP3,HP4,HP5,HP6,HP7,HP8,HP9 probe
    class HP10,HP11,HP12,HP13,HP14,HP15,HP16 probe
    class HP17,HP18,HP19 probe
    class AL1,AL2,AL3,AL4 alert
    class Prometheus,AlertManager,Perses stack
