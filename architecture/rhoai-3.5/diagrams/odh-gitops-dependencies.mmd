    %% Transitive Dependencies
    Kueue -.->|"transitive"| CertManager
    RHCL -.->|"includes"| Authorino["Authorino"]

    %% Integration Points - consumers of odh-gitops
    Dashboard["ODH Dashboard"] -.->|"UI management"| RhodsOp
    Pipelines["Data Science Pipelines"] -.->|"auto deploy"| RhodsOp

