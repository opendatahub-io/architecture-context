    ODHGitOps -->|"TLS provisioning"| CertManager["cert-manager<br/>stable-v1"]
    ODHGitOps -->|"job queue"| Kueue["Kueue<br/>stable-v1.4"]
    ODHGitOps -->|"API mgmt + auth"| RHCL["RHCL / Kuadrant"]
    ODHGitOps -->|"service mesh +<br/>Gateway API"| Sail["Sail / Istio"]
    ODHGitOps -->|"distributed inference"| LWS["Leader Worker Set<br/>stable-v1.0"]
    ODHGitOps -->|"job management"| JobSet["JobSet<br/>stable-v1.0"]
    ODHGitOps -->|"monitoring"| ClusterObs["Cluster Observability"]
    ODHGitOps -->|"tracing"| OpenTelemetry["OpenTelemetry"]
    ODHGitOps -->|"tracing backend"| Tempo["Tempo"]
    ODHGitOps -->|"event-driven<br/>autoscaling"| KEDA["KEDA"]
    ODHGitOps -->|"hardware discovery"| NFD["NFD"]
    ODHGitOps -->|"GPU enablement"| NVIDIA["NVIDIA GPU Operator<br/>v25.10"]
    ODHGitOps -.->|"optional<br/>TrustyAI DB"| MariaDB["MariaDB Operator<br/>v0.29"]

    %% Internal Platform Dependencies
    ODHGitOps -->|"OLM Subscription /<br/>Direct Deployment"| RhodsOp["rhods-operator /<br/>opendatahub-operator"]
    ODHGitOps -->|"helm-sync.yml<br/>chart updates"| BuildConfig["RHOAI-Build-Config"]
