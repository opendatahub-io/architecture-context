graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        direction TB
        AuthPolicy["Kuadrant / Authorino<br/>AuthN/AuthZ Enforcement<br/>API Key / SA Token / OpenShift Token"]
        GatewayAPI["Gateway API — HTTPRoute<br/>Routes: /v1/batches, /v1/files"]
        AuthPolicy --> GatewayAPI
    end

    subgraph AppLayer["APPLICATION LAYER (Cluster Internal)"]
        direction TB

        subgraph APIServerZone["batch-gateway-apiserver"]
            APIServer["API Server<br/>SA: batch-gateway-apiserver<br/>API: 8080/TCP | Obs: 8081/TCP<br/>Optional TLS 1.2+<br/>FIPS: strictfipsruntime + UBI 9"]
        end

        subgraph ProcessorZone["batch-gateway-processor"]
            Processor["Batch Processor<br/>SA: batch-gateway-processor<br/>Obs: 9090/TCP<br/>Workers: configurable<br/>AIMD Concurrency Control<br/>FIPS: strictfipsruntime + UBI 9"]
        end

        subgraph GCZone["batch-gateway-gc"]
            GarbageCollector["Garbage Collector<br/>SA: batch-gateway-gc<br/>Metrics: 9091/TCP<br/>Single Replica<br/>FIPS: strictfipsruntime + UBI 9"]
        end
    end

    subgraph DataLayer["DATA LAYER"]
        PostgreSQL["PostgreSQL<br/>5432/TCP pgx<br/>Optional TLS<br/>Auth: Connection String<br/>Tenant: Row-level filtering"]
        Redis["Redis / Valkey<br/>6379/TCP RESP<br/>Optional TLS 1.2+ / mTLS<br/>Auth: Connection String<br/>Lua scripts for atomicity"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>Auth: AWS IAM / Static Creds<br/>Tenant: SHA256 folder hash"]
        LLMRouter["llm-d Router<br/>configurable/TCP<br/>HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>Auth: API Key or Client Cert"]
        OTLP["OTLP Collector<br/>configurable/TCP gRPC<br/>Optional TLS<br/>Auth: None"]
        Prometheus["Prometheus<br/>Scrape: 8081, 9090, 9091/TCP<br/>HTTP, No Auth"]
    end

    %% External → Ingress
    Client -->|"HTTP/HTTPS<br/>Optional TLS 1.2+<br/>Bearer Token / API Key"| AuthPolicy

    %% Ingress → Application
    GatewayAPI -->|"HTTP/HTTPS<br/>X-MaaS-Username header<br/>Auth: Delegated (validated)"| APIServer

    %% Application → Data Layer
    APIServer -->|"pgx/5432<br/>Optional TLS<br/>Conn String"| PostgreSQL
    APIServer -->|"RESP/6379<br/>Optional TLS/mTLS<br/>Conn String"| Redis

    Processor -->|"pgx/5432<br/>Optional TLS<br/>Conn String"| PostgreSQL
    Processor -->|"RESP/6379<br/>Optional TLS/mTLS<br/>Conn String"| Redis

    GarbageCollector -->|"pgx/5432<br/>Optional TLS<br/>Conn String"| PostgreSQL
    GarbageCollector -->|"RESP/6379<br/>Optional TLS/mTLS<br/>Conn String"| Redis

    %% Application → External Services
    APIServer -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    Processor -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    Processor -->|"HTTP(S)/configurable<br/>Optional TLS 1.2+/mTLS<br/>API Key / Client Cert"| LLMRouter
    GarbageCollector -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3

    %% Tracing
    APIServer -.->|"gRPC/configurable<br/>Optional TLS"| OTLP
    Processor -.->|"gRPC/configurable<br/>Optional TLS"| OTLP

    %% Monitoring
    Prometheus -.->|"HTTP/8081<br/>No Auth"| APIServer
    Prometheus -.->|"HTTP/9090<br/>No Auth"| Processor
    Prometheus -.->|"HTTP/9091<br/>No Auth"| GarbageCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datalayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class AuthPolicy,GatewayAPI ingress
    class APIServer,Processor,GarbageCollector application
    class PostgreSQL,Redis datalayer
    class S3,LLMRouter,OTLP,Prometheus externalservice
