graph TB
    subgraph "llm-d-kv-cache"
        direction TB

        subgraph "Go Library (embedded in EPP)"
            Indexer["kvcache.Indexer<br/>Orchestrates scoring"]
            Pool["kvevents.Pool<br/>Sharded ZMQ consumer"]
            Index["kvblock.Index<br/>Block index backend"]
            TokenProcessor["kvblock.TokenProcessor<br/>FNV-1a hash computation"]
            Scorer["kvblock.Scorer<br/>Pod cache-hit scoring"]

            Pool -->|"sharded events"| Index
            Indexer -->|"hash tokens"| TokenProcessor
            Indexer -->|"lookup blocks"| Index
            Indexer -->|"rank pods"| Scorer
        end

        subgraph "UDS Tokenizer Sidecar"
            TokenizerService["TokenizationService<br/>gRPC over UDS<br/>Python 3.12"]
            HealthProbe["/healthz<br/>8082/TCP"]
        end

        subgraph "vLLM Plugins"
            FSBackend["llmd-fs-backend<br/>KV-cache offloading<br/>(upstreamed to vLLM)"]
            NIXLBackend["llmd-nixl<br/>S3 object storage<br/>backend"]
        end

        subgraph "Utilities"
            PVCEvictor["PVC Evictor<br/>Disk space manager<br/>Multi-process"]
        end
    end

    %% External Inputs
    EPP["llm-d-router (EPP)<br/>Host Process"] -->|"Go module import"| Indexer
    EPP -->|"gRPC (UDS)"| TokenizerService

    vLLMPods["vLLM / SGLang Pods"] -->|"ZMQ 5557/TCP<br/>KV-cache events"| Pool
    vLLMPods -->|"CUDA/DMA"| FSBackend

    %% External Dependencies
    TokenizerService -->|"HTTPS 443/TCP"| HFHub["Hugging Face Hub"]
    Index -.->|"6379/TCP (optional)"| Redis["Redis / Valkey"]
    Indexer -.->|"gRPC 4317/TCP"| OTLP["OTLP Collector"]
    Pool -->|"HTTPS 443/TCP"| K8sAPI["Kubernetes API<br/>Pod Discovery"]

    %% Storage
    FSBackend -->|"POSIX I/O"| PVC["Shared PVC<br/>/kv-cache"]
    PVCEvictor -->|"xargs rm -f"| PVC
    FSBackend -->|"ZMQ 5557/TCP<br/>block events"| Pool

    %% Styling
    style Indexer fill:#4a90e2,stroke:#333,color:#fff
    style Pool fill:#4a90e2,stroke:#333,color:#fff
    style Index fill:#4a90e2,stroke:#333,color:#fff
    style TokenProcessor fill:#4a90e2,stroke:#333,color:#fff
    style Scorer fill:#4a90e2,stroke:#333,color:#fff
    style TokenizerService fill:#7ed321,stroke:#333,color:#fff
    style HealthProbe fill:#7ed321,stroke:#333,color:#fff
    style FSBackend fill:#9b59b6,stroke:#333,color:#fff
    style NIXLBackend fill:#9b59b6,stroke:#333,color:#fff
    style PVCEvictor fill:#e67e22,stroke:#333,color:#fff
    style EPP fill:#2c3e50,stroke:#333,color:#fff
    style vLLMPods fill:#2c3e50,stroke:#333,color:#fff
    style HFHub fill:#e8e8e8,stroke:#999
    style Redis fill:#e8e8e8,stroke:#999
    style OTLP fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style PVC fill:#f5a623,stroke:#333,color:#fff
