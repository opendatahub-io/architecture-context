graph TB
    subgraph KubeflowNotebook["Kubeflow Notebook Controller Component"]
        direction TB

        subgraph UpstreamController["odh-kf-notebook-controller (Upstream)"]
            NotebookReconciler["Notebook Reconciler<br/>StatefulSet + Service lifecycle"]
            CullingReconciler["Culling Reconciler<br/>Idle notebook detection"]
            VirtualServiceMgr["VirtualService Manager<br/>(Istio, disabled on OpenShift)"]
        end

        subgraph ODHController["odh-notebook-controller (RHOAI Extension)"]
            ODHReconciler["ODH Notebook Reconciler<br/>OpenShift enhancements"]
            MutatingWebhook["Mutating Webhook<br/>:8443 /mutate-notebook-v1"]
            ValidatingWebhook["Validating Webhook<br/>:8443 /validate-notebook-v1"]
            KRBPInjector["kube-rbac-proxy Injector<br/>Sidecar injection"]
            HTTPRouteMgr["HTTPRoute Manager<br/>Gateway API ingress"]
            NetworkPolicyMgr["NetworkPolicy Manager<br/>Per-notebook policies"]
            DSPAIntegration["DSPA Integration<br/>Elyra pipeline secrets"]
            MLflowIntegration["MLflow Integration<br/>Tracking env + RBAC"]
            FeastIntegration["Feast Integration<br/>Feature store config"]
            ImageStreamResolver["ImageStream Resolver<br/>Container image lookup"]
        end

        subgraph SharedLib["common/reconcilehelper"]
            ReconcileHelper["Reconciliation Utilities<br/>Deployment, Service, StatefulSet"]
        end
    end

    %% External CRDs
    User[Data Scientist] -->|creates| NotebookCR["Notebook CR<br/>kubeflow.org/v1"]
    NotebookCR -->|watched by| NotebookReconciler
    NotebookCR -->|watched by| ODHReconciler

    %% Upstream controller outputs
    NotebookReconciler -->|creates| StatefulSet["StatefulSet<br/>(per notebook)"]
    NotebookReconciler -->|creates| Service["Service<br/>:80 → :8888"]
    CullingReconciler -->|polls| JupyterAPI["Jupyter API<br/>/api/kernels, /api/terminals"]

    %% ODH controller outputs
    KRBPInjector -->|injects| KRBPSidecar["kube-rbac-proxy<br/>Sidecar :8443"]
    HTTPRouteMgr -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    HTTPRouteMgr -->|creates| ReferenceGrant["ReferenceGrant<br/>(cross-namespace)"]
    NetworkPolicyMgr -->|creates| NetworkPolicy["NetworkPolicy<br/>(per notebook)"]
    DSPAIntegration -->|creates| PipelineSecret["ds-pipeline-config<br/>Secret"]

    %% Shared library usage
    NotebookReconciler -.->|uses| ReconcileHelper
    ODHReconciler -.->|uses| ReconcileHelper

    %% External dependencies
    HTTPRoute -->|parent ref| Gateway["data-science-gateway<br/>(Gateway API)"]
    KRBPSidecar -->|SubjectAccessReview| K8sAPI["Kubernetes API<br/>:6443"]
    DSPAIntegration -->|reads| DSPACR["DSPA CR<br/>(pipeline config)"]
    ImageStreamResolver -->|resolves| ImageStream["OpenShift<br/>ImageStream"]

    %% Styling
    style NotebookReconciler fill:#4a90e2,color:#fff
    style CullingReconciler fill:#4a90e2,color:#fff
    style ODHReconciler fill:#4a90e2,color:#fff
    style MutatingWebhook fill:#e8742c,color:#fff
    style ValidatingWebhook fill:#e8742c,color:#fff
    style KRBPInjector fill:#d0021b,color:#fff
    style HTTPRouteMgr fill:#7ed321,color:#fff
    style NetworkPolicyMgr fill:#7ed321,color:#fff
    style DSPAIntegration fill:#9013fe,color:#fff
    style MLflowIntegration fill:#9013fe,color:#fff
    style FeastIntegration fill:#9013fe,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style DSPACR fill:#e8e8e8,stroke:#333
    style ImageStream fill:#e8e8e8,stroke:#333
