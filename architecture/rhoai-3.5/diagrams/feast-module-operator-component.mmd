graph TB
    subgraph "Feast Module Operator"
        direction TB
        Controller["feast-module-operator<br/>Go Operator (controller-runtime)<br/>Manages upstream Feast operator lifecycle"]
        InitContainer["copy-manifests<br/>Init Container<br/>Copies kustomize manifests to emptyDir"]
        ChartGen["chartgen<br/>Go CLI subcommand<br/>Generates Helm chart from kustomize"]
    end

    subgraph "CRDs Watched"
        FeastOperatorCR["FeastOperator CR<br/>components.platform.opendatahub.io/v1<br/>Cluster-scoped singleton"]
    end

    subgraph "Managed Resources"
        FeastOperatorDeploy["feast-operator Deployment<br/>(upstream feast-dev/feast)"]
        FeatureStoreCRD["FeatureStore CRD<br/>feast.dev/v1<br/>Namespaced"]
        FeastRBAC["feast-operator RBAC<br/>ClusterRole + Bindings + SA"]
        FeastServiceMonitor["ServiceMonitor<br/>Prometheus metrics"]
        MigrationJob["selector-migration Job<br/>(RHOAI overlay)"]
    end

    subgraph "Platform Integration"
        PlatformOperator["opendatahub-operator /<br/>rhods-operator"]
        ConfigMap["odh-feastoperator-config<br/>ConfigMap<br/>Platform version handshake"]
    end

    %% Platform operator creates FeastOperator CR
    PlatformOperator -->|creates| FeastOperatorCR
    PlatformOperator -->|writes platformVersion| ConfigMap

    %% Controller watches and reconciles
    FeastOperatorCR -->|watched by| Controller
    Controller -->|reads| ConfigMap
    InitContainer -->|copies manifests to| Controller

    %% Controller deploys managed resources
    Controller -->|deploys via kustomize| FeastOperatorDeploy
    Controller -->|deploys| FeatureStoreCRD
    Controller -->|deploys| FeastRBAC
    Controller -->|creates| FeastServiceMonitor
    Controller -->|creates (RHOAI)| MigrationJob

    %% Upstream feast-operator reconciles FeatureStores
    FeastOperatorDeploy -->|reconciles| FeatureStoreCRD

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style ChartGen fill:#4a90e2,stroke:#333,color:#fff
    style FeastOperatorCR fill:#f5a623,stroke:#333,color:#fff
    style FeastOperatorDeploy fill:#7ed321,stroke:#333,color:#fff
    style FeatureStoreCRD fill:#7ed321,stroke:#333,color:#fff
    style FeastRBAC fill:#7ed321,stroke:#333
    style FeastServiceMonitor fill:#7ed321,stroke:#333
    style MigrationJob fill:#7ed321,stroke:#333
    style PlatformOperator fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
