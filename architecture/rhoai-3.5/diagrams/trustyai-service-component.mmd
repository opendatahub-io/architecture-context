graph TB
    subgraph TrustyAI["TrustyAI Service (FastAPI + Hypercorn)"]
        direction TB

        subgraph Endpoints["Endpoint Layer (src/endpoints/)"]
            ConsumerEP["Consumer Endpoint<br/>POST / (KServe events)<br/>POST /consumer/kserve/v2 (ModelMesh)"]
            MetricsEP["Metrics Endpoints<br/>/metrics/group/fairness/spd<br/>/metrics/group/fairness/dir<br/>/metrics/drift/kstest<br/>/metrics/drift/comparemeans<br/>/metrics/batch/mean"]
            InfoEP["Info Endpoint<br/>GET /info<br/>GET/POST/DELETE /info/names"]
            DataEP["Data Upload Endpoint<br/>POST /data/upload"]
            EvalEP["LM Eval Endpoint<br/>POST /eval/lm-evaluation-harness/job"]
            HealthEP["Health Probes<br/>GET /q/health/ready<br/>GET /q/health/live"]
            PrometheusEP["Metrics Scrape<br/>GET /q/metrics"]
        end

        subgraph ServiceLayer["Service Layer (src/service/)"]
            PromScheduler["Prometheus Scheduler<br/>asyncio background task<br/>every 30s"]
            PromPublisher["Prometheus Publisher<br/>Gauge registry"]
            StorageFactory["Storage Factory<br/>PVC/HDF5 or MariaDB"]
            DataSource["DataSource<br/>Data access layer"]
        end

        subgraph CoreLayer["Core Layer (src/core/)"]
            FairnessMetrics["Fairness Metrics<br/>SPD, DIR, AOD, APV,<br/>Individual Consistency"]
            DriftMetrics["Drift Metrics<br/>KS Test, Jensen-Shannon,<br/>Compare Means, Fourier MMD"]
        end
    end

    %% Internal flows
    ConsumerEP -->|persist| StorageFactory
    MetricsEP -->|query| DataSource
    MetricsEP -->|compute| FairnessMetrics
    MetricsEP -->|compute| DriftMetrics
    DataEP -->|store| StorageFactory
    InfoEP -->|query| DataSource
    PromScheduler -->|read| DataSource
    PromScheduler -->|compute| FairnessMetrics
    PromScheduler -->|compute| DriftMetrics
    PromScheduler -->|publish| PromPublisher
    DataSource -->|reads from| StorageFactory

    %% External interactions
    KubeRBACProxy["kube-rbac-proxy Sidecar<br/>8443/TCP HTTPS<br/>Bearer Token Auth"]
    KubeRBACProxy -->|forwards to 8080| ConsumerEP
    KubeRBACProxy -->|forwards to 8080| MetricsEP
    KubeRBACProxy -->|forwards to 8080| InfoEP
    KubeRBACProxy -->|forwards to 8080| DataEP
    KubeRBACProxy -->|forwards to 8080| EvalEP

    KServe["KServe InferenceService"] -->|cloud events| KubeRBACProxy
    ModelMesh["ModelMesh Serving"] -->|KServe v2 payloads| KubeRBACProxy
    Dashboard["OpenShift AI Dashboard"] -->|REST calls| KubeRBACProxy
    Prometheus["Prometheus / OpenShift Monitoring"] -->|scrapes /q/metrics| KubeRBACProxy

    StorageFactory -->|HDF5 files| PVC["PVC Storage"]
    StorageFactory -->|MySQL protocol| MariaDB["MariaDB<br/>3306/TCP"]

    EvalEP -->|subprocess| LMEval["lm-eval subprocess"]
    LMEval -->|HTTP/HTTPS| LLMEndpoint["LLM Inference Endpoints"]

    TrustyAIOp["TrustyAI Operator"] -.->|deploys & configures| TrustyAI

    %% Styling
    style TrustyAI fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Endpoints fill:#dbeafe,stroke:#3b82f6
    style ServiceLayer fill:#dcfce7,stroke:#22c55e
    style CoreLayer fill:#fef3c7,stroke:#f59e0b
    style KubeRBACProxy fill:#fed7aa,stroke:#ea580c,stroke-width:2px
    style KServe fill:#e8e8e8,stroke:#666
    style ModelMesh fill:#e8e8e8,stroke:#666
    style Dashboard fill:#e8e8e8,stroke:#666
    style Prometheus fill:#e8e8e8,stroke:#666
    style PVC fill:#f5f5f5,stroke:#999
    style MariaDB fill:#f5f5f5,stroke:#999
    style LLMEndpoint fill:#f5f5f5,stroke:#999
    style TrustyAIOp fill:#ddd6fe,stroke:#7c3aed
