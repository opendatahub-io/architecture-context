graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Gateway["GATEWAY / PROXY LAYER (DMZ)"]
        GW["Istio / AgentGateway / Envoy AI GW<br/>443/TCP → 8000/TCP<br/>TLS termination (configurable)<br/>AuthN/AuthZ: Gateway-enforced"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (Internal — Plaintext)"]
        direction TB

        subgraph NS_Pool["Namespace: InferencePool"]
            EPP["EPP (llm-d-inference-scheduler)<br/>SA: epp-sa<br/>9002/TCP gRPC ext-proc<br/>No encryption"]
            LatPred["Latency Predictor (sidecar)<br/>XGBoost predictions"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            ModelServer["Model Server Pods<br/>(llm-d-cuda/cpu/rocm/xpu)<br/>UID: 2000, GID: 0<br/>8000/TCP HTTP plaintext<br/>No auth at pod level"]
            ModelServer2["Decode Server Pod<br/>8000/TCP HTTP plaintext"]
        end

        subgraph NS_Helper["Namespace: helpers"]
            MooncakeMaster["Mooncake Master Store<br/>50051/TCP gRPC<br/>8080/TCP HTTP<br/>9003/TCP metrics"]
            MooncakeClient["Mooncake Client (DaemonSet)<br/>50052/TCP gRPC"]
        end

        subgraph Observability["Observability"]
            Prometheus["Prometheus<br/>Scrapes /metrics"]
            OTEL["OpenTelemetry Collector<br/>OTLP (configurable TLS)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: Bearer Token (HF_TOKEN)"]
        NVCR["NVIDIA NGC (nvcr.io)<br/>443/TCP HTTPS TLS 1.2+<br/>Build-time only"]
        GHCR["GitHub Registry (ghcr.io)<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: GitHub Token"]
    end

    %% External to Gateway
    Client -->|"HTTP/HTTPS 80,443/TCP<br/>TLS (if configured)<br/>Gateway auth"| GW

    %% Gateway to internal
    GW -->|"gRPC 9002/TCP<br/>No encryption<br/>No auth"| EPP
    GW -->|"HTTP 8000/TCP<br/>No encryption<br/>No auth"| ModelServer

    %% EPP interactions
    EPP -->|"HTTP 8000/TCP<br/>GET /metrics<br/>No encryption"| ModelServer
    EPP --- LatPred

    %% Model server interactions
    ModelServer -->|"NIXL RDMA/TCP<br/>KV-cache transfer<br/>No encryption<br/>No auth"| ModelServer2

    %% Mooncake
    ModelServer -.->|"gRPC 50052<br/>No encryption"| MooncakeClient
    MooncakeClient -.->|"gRPC 50051<br/>No encryption"| MooncakeMaster

    %% Observability
    Prometheus -->|"HTTP 8000/TCP<br/>GET /metrics"| ModelServer
    ModelServer -->|"OTLP<br/>TLS configurable"| OTEL

    %% External egress
    ModelServer -->|"HTTPS 443/TCP<br/>TLS 1.2+<br/>Bearer Token"| HF

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef helper fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class GW gateway
    class EPP,LatPred internal
    class ModelServer,ModelServer2 warning
    class MooncakeMaster,MooncakeClient helper
    class Prometheus,OTEL observability
    class HF,NVCR,GHCR externalservice
