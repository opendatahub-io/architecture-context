graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["Platform Gateway (Envoy)<br/>443/TCP<br/>TLS<br/>OIDC Auth"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER"]
        KRBP["kube-rbac-proxy sidecar<br/>8443/TCP → 127.0.0.1:8265<br/>TLS<br/>TokenReview + SubjectAccessReview"]
    end

    subgraph WorkloadNS["RAY CLUSTER (Workload Namespace)"]
        direction TB

        subgraph HeadPod["Ray Head Pod"]
            Dashboard["Ray Dashboard<br/>8265/TCP HTTP"]
            GCS["GCS Server<br/>6379/TCP"]
            RayClient["Ray Client<br/>10001/TCP"]
            Metrics["Metrics<br/>8080/TCP HTTP"]
            Serve["Ray Serve<br/>8000/TCP HTTP"]
        end

        Workers["Ray Worker Pods<br/>Peer communication"]
        ServeSvc["{cluster}-serve-svc<br/>ClusterIP 8000/TCP"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        Operator["KubeRay Operator<br/>SA: kuberay-operator"]
        WebhookSvc["Webhook Service<br/>443→9443/TCP HTTPS<br/>OpenShift serving cert"]
        MetricsEP["Metrics: 8080/TCP<br/>Health: 8082/TCP"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS TLS<br/>ServiceAccount Auth"]
        OSAPI["OpenShift API<br/>(config.openshift.io)<br/>6443/TCP HTTPS TLS"]
    end

    subgraph OptionalIntegrations["OPTIONAL INTEGRATIONS"]
        CertMgr["cert-manager<br/>Issuer + Certificate CRDs<br/>(mTLS when annotated)"]
        BatchSched["Volcano / Yunikorn / Kai<br/>scheduler-plugins<br/>(gang scheduling)"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS<br/>OIDC Token"| Gateway

    %% Ingress → Auth
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KRBP

    %% Auth → K8s API (token validation)
    KRBP -->|"HTTPS/6443<br/>TLS<br/>TokenReview"| K8sAPI
    KRBP -->|"HTTPS/6443<br/>TLS<br/>SubjectAccessReview"| K8sAPI

    %% Auth → Dashboard (loopback)
    KRBP -->|"HTTP/8265<br/>None (loopback)<br/>Pre-authenticated"| Dashboard

    %% Head ↔ Workers
    GCS ---|"TCP/6379, 10001<br/>None or mTLS"| Workers

    %% Operator → Control Plane
    Operator -->|"HTTPS/6443<br/>TLS<br/>ServiceAccount"| K8sAPI
    Operator -->|"HTTPS/6443<br/>TLS<br/>ServiceAccount"| OSAPI

    %% Operator → Ray Dashboard
    Operator -->|"HTTP/8265<br/>None (in-cluster)<br/>Job submission + status"| Dashboard

    %% K8s API → Webhook
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (serving cert)<br/>Webhook Auth"| WebhookSvc

    %% Optional integrations
    Operator -.->|"HTTPS/6443<br/>CRD lifecycle"| CertMgr
    Operator -.->|"HTTPS/6443<br/>PodGroup CRDs"| BatchSched

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#fff2cc,stroke:#d6b656,stroke-width:1px,stroke-dasharray: 5

    class User external
    class Gateway ingress
    class KRBP auth
    class Dashboard,GCS,RayClient,Metrics,Serve,Workers,ServeSvc workload
    class Operator,WebhookSvc,MetricsEP operator
    class K8sAPI,OSAPI controlplane
    class CertMgr,BatchSched optional
