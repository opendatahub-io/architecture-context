graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route: trustyai<br/>80/TCP HTTP<br/>TLS: null (no termination)<br/>Note: Operator may override with TLS"]
    end

    subgraph Pod["POD BOUNDARY (trustyai-service)"]
        direction TB

        KubeRBAC["kube-rbac-proxy sidecar<br/>(injected by Operator)<br/>AuthN: TokenReview<br/>AuthZ: SubjectAccessReview"]

        subgraph Container["TrustyAI Service Container"]
            direction TB
            AppHTTP["HTTP Server<br/>8080/TCP<br/>No in-app auth"]
            AppHTTPS["HTTPS Server<br/>4443/TCP<br/>TLS (cert: /etc/tls/internal/)<br/>When certs mounted"]
            HealthMetrics["/q/health + /q/metrics<br/>8080/TCP"]
        end
    end

    subgraph InboundConsumers["INBOUND CONSUMERS (Cluster Internal)"]
        ModelMesh["ModelMesh / KServe<br/>/consumer/kserve/v2<br/>8080/TCP HTTP<br/>No Auth"]
        KServeIS["KServe InferenceService<br/>CloudEvents<br/>8080/TCP HTTP<br/>No Auth"]
    end

    subgraph MetricsScrape["METRICS"]
        Prometheus["Prometheus<br/>GET /q/metrics<br/>80/TCP HTTP<br/>Bearer Token (SA)"]
    end

    subgraph ClusterEgress["CLUSTER INTERNAL (Egress)"]
        InferenceGRPC["KServe Inference Servers<br/>gRPC (plaintext)<br/>No TLS, No Auth<br/>FIPS Gap: usePlaintext()"]
        InferenceHTTP["KServe Inference Servers<br/>HTTP (V1/V2 REST)<br/>No TLS, No Auth"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS, SA Token<br/>ConfigMap CRUD"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES (Optional)"]
        Database["MariaDB / MySQL / PostgreSQL<br/>3306/TCP JDBC<br/>No TLS (configurable)<br/>Username/Password"]
        MinIO["MinIO<br/>HTTP/HTTPS<br/>Configurable TLS<br/>Access Key / Secret Key"]
    end

    subgraph Storage["LOCAL STORAGE"]
        PVC["PVC at /inputs<br/>CSV format<br/>Default storage mode"]
    end

    %% External → Ingress → Pod
    User -->|"HTTP/80<br/>No TLS"| Route
    Route -->|"HTTP/80 → 8080<br/>No Encryption"| KubeRBAC
    KubeRBAC -->|"HTTP/8080<br/>Pre-authorized<br/>Pod-internal"| AppHTTP

    %% Inbound consumers (bypass Route, direct to service port)
    ModelMesh -->|"HTTP/8080<br/>No Auth"| AppHTTP
    KServeIS -->|"HTTP/8080<br/>CloudEvents<br/>No Auth"| AppHTTP

    %% Metrics
    Prometheus -->|"HTTP/80<br/>Bearer Token"| HealthMetrics

    %% Egress
    AppHTTP -->|"gRPC plaintext<br/>No TLS"| InferenceGRPC
    AppHTTP -->|"HTTP<br/>No TLS"| InferenceHTTP
    AppHTTP -->|"HTTPS/443<br/>TLS, SA Token"| K8sAPI

    %% Optional external services
    AppHTTP -->|"JDBC/3306<br/>Username/Password"| Database
    AppHTTP -->|"HTTP(S)<br/>Access Key"| MinIO

    %% Local storage
    AppHTTP -->|"File I/O<br/>Filesystem"| PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef consumer fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef storage fill:#f5f5f5,stroke:#666,stroke-width:2px

    class User external
    class Route ingress
    class KubeRBAC pod
    class AppHTTP,AppHTTPS,HealthMetrics container
    class ModelMesh,KServeIS consumer
    class Prometheus consumer
    class InferenceGRPC,InferenceHTTP,K8sAPI egress
    class Database,MinIO externalsvc
    class PVC storage
