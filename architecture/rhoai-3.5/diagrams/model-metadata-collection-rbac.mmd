graph TD
    subgraph "model-metadata-collection RBAC"
        direction TB

        Note["This component is a CLI tool / data container.<br/>No Kubernetes RBAC is required.<br/>No ServiceAccounts, ClusterRoles, or RoleBindings are defined."]
    end

    subgraph "Authentication (Build-Time Only)"
        direction TB

        subgraph "HuggingFace Auth"
            HF_Token["HF_TOKEN<br/>(Environment Variable)<br/>Bearer Token"]
            HF_Purpose["Purpose: Gated model access<br/>Required: No (optional)<br/>Provisioned: Manual / .env"]
        end

        subgraph "GitHub Auth"
            GH_Token["GITHUB_TOKEN<br/>(Environment Variable)<br/>Bearer Token"]
            GH_Purpose["Purpose: Higher API rate limits<br/>Required: No (optional)<br/>Provisioned: Manual / CI env"]
        end

        subgraph "OCI Registry Auth"
            Docker_Config["Docker Config<br/>(~/.docker/config.json)<br/>Docker Credential Store"]
            Docker_Purpose["Purpose: registry.redhat.io access<br/>Required: Yes<br/>Provisioned: Manual / CI env"]
        end
    end

    subgraph "Access Control Summary"
        direction TB
        AC1["HuggingFace API → Unauthenticated for public models; token for gated"]
        AC2["GitHub API → Unauthenticated at 60 req/hr; token for 5000 req/hr"]
        AC3["OCI Registry → Docker credentials required (mandatory)"]
    end

    HF_Token --> HF_Purpose
    GH_Token --> GH_Purpose
    Docker_Config --> Docker_Purpose

    %% Styling
    style Note fill:#f0f0f0,stroke:#999,stroke-width:2px
    style HF_Token fill:#4a90e2,stroke:#333,color:#fff
    style GH_Token fill:#4a90e2,stroke:#333,color:#fff
    style Docker_Config fill:#f5a623,stroke:#333,color:#fff
    style HF_Purpose fill:#e8e8e8,stroke:#999
    style GH_Purpose fill:#e8e8e8,stroke:#999
    style Docker_Purpose fill:#e8e8e8,stroke:#999
    style AC1 fill:#f9f9f9,stroke:#999
    style AC2 fill:#f9f9f9,stroke:#999
    style AC3 fill:#fff2cc,stroke:#d6b656
