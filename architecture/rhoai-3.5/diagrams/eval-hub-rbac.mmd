graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["eval-hub<br/>(ServiceAccount)"]
    end

    subgraph AuthProxy["Authentication Layer"]
        RBAC["kube-rbac-proxy<br/>(sidecar)"]
    end

    subgraph RoleBindings["Role Bindings (created by TrustyAI Operator)"]
        RB["eval-hub-rolebinding"]
    end

    subgraph Roles["Roles (created by TrustyAI Operator)"]
        Role["eval-hub-role"]
    end

    subgraph APIResources["API Resources"]
        Jobs["batch<br/>jobs"]
        Pods["core<br/>pods"]
        PodLogs["core<br/>pods/log"]
        Secrets["core<br/>secrets"]
        ConfigMaps["core<br/>configmaps"]
        HWProfiles["dashboard.opendatahub.io<br/>hardwareprofiles"]
    end

    subgraph AuthEndpoints["API Endpoint Authentication"]
        HealthZ["/healthz<br/>Auth: None<br/>(kubelet probe)"]
        APIEndpoints["/api/v1/*<br/>Auth: X-Tenant + X-User<br/>(injected by kube-rbac-proxy)"]
        DocsEndpoints["/openapi.yaml, /docs<br/>Auth: None<br/>(public docs)"]
        MetricsEndpoint["/metrics<br/>Auth: None<br/>(local mode only)"]
        MCPEndpoints["/mcp, /sse<br/>Auth: X-User + X-Tenant<br/>(rbac-proxy mode)"]
    end

    %% Flow: SA → RoleBinding → Role → Resources
    SA -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -->|"get, list, watch,<br/>create, delete"| Jobs
    Role -->|"get, list, watch"| Pods
    Role -->|"get, list, watch"| PodLogs
    Role -->|"get, list,<br/>create, delete"| Secrets
    Role -->|"get, list, watch"| ConfigMaps
    Role -->|"get, list"| HWProfiles

    %% Auth proxy flow
    RBAC -->|"SubjectAccessReview<br/>TLS termination 8443→8080"| SA
    RBAC -->|"injects X-Tenant,<br/>X-User headers"| APIEndpoints

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RBAC fill:#9b59b6,stroke:#333,color:#fff
    style RB fill:#e67e22,stroke:#333,color:#fff
    style Role fill:#f5a623,stroke:#333
    style Jobs fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style PodLogs fill:#7ed321,stroke:#333
    style Secrets fill:#e74c3c,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333
    style HWProfiles fill:#7ed321,stroke:#333
    style HealthZ fill:#95a5a6,stroke:#333,color:#fff
    style APIEndpoints fill:#3498db,stroke:#333,color:#fff
    style DocsEndpoints fill:#95a5a6,stroke:#333,color:#fff
    style MetricsEndpoint fill:#95a5a6,stroke:#333,color:#fff
    style MCPEndpoints fill:#3498db,stroke:#333,color:#fff
