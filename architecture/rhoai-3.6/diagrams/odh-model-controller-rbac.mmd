graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Ctrl["odh-model-controller"]
        SA_API["model-serving-api"]
        SA_Mgr["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["odh-model-controller-rolebinding-opendatahub"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_API["model-serving-api"]
        CRB_Metrics["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>ns: odh-model-controller-system"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["odh-model-controller-role"]
        CR_Proxy["proxy-role"]
        CR_API["model-serving-api"]
        CR_Metrics["metrics-auth-role"]
        CR_MetricsR["metrics-reader"]
        CR_AccEdit["account-editor-role"]
        CR_AccView["account-viewer-role"]
        CR_Prom["kserve-prometheus-k8s"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role"]
    end

    %% SA → CRB → CR bindings
    SA_Ctrl -->|"bound via"| CRB_Main
    CRB_Main -->|"grants"| CR_Main

    SA_Ctrl -->|"bound via"| CRB_Proxy
    CRB_Proxy -->|"grants"| CR_Proxy

    SA_API -->|"bound via"| CRB_API
    CRB_API -->|"grants"| CR_API

    SA_Mgr -->|"bound via"| CRB_Metrics
    CRB_Metrics -->|"grants"| CR_Metrics

    SA_Ctrl -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| R_Leader

    %% CR_Main permissions
    subgraph CoreResources["Core API Resources"]
        CoreRW["configmaps, secrets,<br/>serviceaccounts, services<br/>endpoints, namespaces, pods"]
        Events["events"]
    end

    subgraph KServeResources["serving.kserve.io"]
        KServeRW["inferenceservices<br/>llminferenceservices<br/>servingruntimes<br/>inferencegraphs"]
    end

    subgraph NIMResources["nim.opendatahub.io"]
        NIMAccounts["accounts<br/>accounts/finalizers<br/>accounts/status"]
    end

    subgraph GatewayResources["gateway.networking.k8s.io"]
        GWRes["gateways<br/>gateways/finalizers<br/>httproutes"]
    end

    subgraph SecurityResources["Security & Networking"]
        KuadrantRes["kuadrant.io<br/>authpolicies, kuadrants"]
        IstioRes["networking.istio.io<br/>envoyfilters"]
        NetPolRes["networking.k8s.io<br/>networkpolicies"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterrolebindings<br/>rolebindings, roles"]
    end

    subgraph MonitoringResources["Monitoring"]
        MonRes["monitoring.coreos.com<br/>podmonitors<br/>servicemonitors"]
        KEDARes["keda.sh<br/>triggerauthentications"]
    end

    subgraph PlatformResources["Platform (Read-Only)"]
        DSCRes["datascienceclusters"]
        DSCIRes["dscinitializations"]
        HWRes["hardwareprofiles"]
        AuthorinoRes["authorinos"]
        MetricsRes["metrics.k8s.io<br/>nodes, pods"]
    end

    CR_Main -->|"CRUD"| CoreResources
    CR_Main -->|"create, patch"| Events
    CR_Main -->|"CRUD"| KServeResources
    CR_Main -->|"get, list, patch,<br/>update, watch"| NIMResources
    CR_Main -->|"get, list, patch,<br/>update, watch"| GatewayResources
    CR_Main -->|"CRUD"| SecurityResources
    CR_Main -->|"CRUD"| MonitoringResources
    CR_Main -->|"get, list, watch"| PlatformResources

    %% Other role permissions
    subgraph AuthResources["Auth API Resources"]
        AuthReview["tokenreviews<br/>subjectaccessreviews"]
    end

    subgraph APIResources["API Server Resources"]
        GWList["gateways (list)"]
        NSGet["namespaces (get)"]
    end

    subgraph LeaderResources["Leader Election Resources"]
        LeaderRes["configmaps, leases, events"]
    end

    CR_Proxy -->|"create"| AuthResources
    CR_Metrics -->|"create"| AuthResources
    CR_API -->|"list, get"| APIResources
    R_Leader -->|"CRUD"| LeaderResources
    CR_MetricsR -->|"get /metrics"| MetricsNR["Non-Resource: /metrics"]

