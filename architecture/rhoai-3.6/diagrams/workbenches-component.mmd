graph TB
    subgraph Workbenches["Workbenches Component"]
        direction TB

        subgraph ControllerTier["Controller Tier"]
            Controller["workspaces-controller<br/>(Go, controller-runtime)<br/>Port: 8081/TCP health, 9443/TCP webhook"]
            Webhook["Admission Webhooks<br/>Validating + Conversion<br/>Port: 9443/TCP"]
            Controller --- Webhook
        end

        subgraph BackendTier["Backend Tier"]
            Backend["workspaces-backend<br/>(Go REST API)<br/>Port: 4000/TCP"]
            AuthN["Authentication<br/>Bearer Token / Header-based"]
            AuthZ["Authorization<br/>SubjectAccessReview"]
            Backend --> AuthN
            Backend --> AuthZ
        end

        subgraph FrontendTier["Frontend Tier"]
            Frontend["workspaces-frontend<br/>(React/PatternFly 6)<br/>Port: 8080/TCP"]
        end
    end

    User[User Browser] -->|HTTP/8080| Frontend
    Frontend -->|HTTP/4000<br/>Bearer token| Backend

    Backend -->|HTTPS/6443<br/>TokenReview + SAR| K8sAPI[Kubernetes API]

    K8sAPI -->|Admission<br/>HTTPS/9443| Webhook

    Controller -->|HTTPS/6443<br/>SA token| K8sAPI

    %% CRDs
    WorkspaceCR["Workspace CR<br/>(kubeflow.org/v1beta1)<br/>Namespaced"]
    WorkspaceKindCR["WorkspaceKind CR<br/>(kubeflow.org/v1beta1)<br/>Cluster-scoped"]

    WorkspaceCR -->|watched by| Controller
    WorkspaceKindCR -->|watched by| Controller

    %% Resources created by controller
    Controller -->|creates| StatefulSet["StatefulSet<br/>(workspace pod)"]
    Controller -->|creates| Service["Service<br/>(workspace access)"]
    Controller -->|creates| SA["ServiceAccount +<br/>RoleBinding"]

    %% Network routing (conditional)
    Controller -->|creates<br/>when --use-kube-gateway| HTTPRoute["HTTPRoute +<br/>ReferenceGrant"]
    Controller -->|creates<br/>when --use-istio| VS["VirtualService"]

    %% External dependencies
    Controller -.->|optional| Istio["Istio"]
    Controller -.->|optional| GatewayAPI["Gateway API"]
    Controller -.->|reads TLS profile| OpenShiftAPI["OpenShift APIServer"]

    Backend -->|reads| MetricsAPI["Kubernetes Metrics API"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style Backend fill:#4a90e2,stroke:#333,color:#fff
    style Frontend fill:#4a90e2,stroke:#333,color:#fff
    style WorkspaceCR fill:#f5a623,stroke:#333,color:#fff
    style WorkspaceKindCR fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Istio fill:#999,stroke:#333
    style GatewayAPI fill:#999,stroke:#333
    style OpenShiftAPI fill:#999,stroke:#333
    style MetricsAPI fill:#999,stroke:#333
    style StatefulSet fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
    style SA fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style VS fill:#7ed321,stroke:#333
