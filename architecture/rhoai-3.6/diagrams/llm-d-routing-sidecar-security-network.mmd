graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Inference Gateway"]
    end

    subgraph Ingress["INGRESS (OpenShift Route - Edge TLS)"]
        Route["OpenShift Router<br/>Route: project-route<br/>8080/TCP → 8080/TCP<br/>TLS Edge Termination"]
    end

    subgraph Namespace["NAMESPACE: hc4ai-operator"]
        direction TB

        Service["ClusterIP Service<br/>8080/TCP → 8080/TCP"]

        subgraph SidecarPod["Sidecar Pod (non-root 65532)"]
            Proxy["llm-d-routing-sidecar<br/>8000/TCP TLS 1.2+<br/>ECDHE+AES-GCM ciphers<br/>SSRF protection: optional"]
        end

        subgraph CoLocated["Co-Located Container"]
            Decoder["Local vLLM Decoder<br/>default 8001/TCP<br/>HTTP or HTTPS"]
        end
    end

    subgraph RemotePods["REMOTE PODS"]
        Prefiller["Remote vLLM Prefill Workers<br/>per-request port<br/>HTTP or HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>ServiceAccount token auth"]
    end

    %% Flows
    Client -->|"HTTPS/8080<br/>TLS Edge<br/>No Auth"| Route
    Route -->|"TCP/8080<br/>Post-TLS termination"| Service
    Service -->|"HTTPS/8000<br/>TLS 1.2+<br/>No Auth"| Proxy
    Proxy -->|"HTTP or HTTPS/8001<br/>Configurable TLS<br/>InsecureSkipVerify: configurable"| Decoder
    Proxy -->|"HTTP or HTTPS/per-request<br/>Configurable TLS<br/>SSRF validated (when enabled)"| Prefiller
    Proxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token Auth"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef namespace fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef colocated fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef remote fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Service,Proxy namespace
    class Decoder colocated
    class Prefiller remote
    class K8sAPI externalservice
