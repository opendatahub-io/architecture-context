graph TB
    subgraph ControlPlane["Control Plane"]
        Controller["dc-controller<br/>(Go / controller-runtime)"]
    end

    subgraph DataPlane["Data Plane"]
        direction TB

        subgraph RESTStack["REST Service Stack"]
            KubeRBACProxy["kube-rbac-proxy<br/>(Sidecar)<br/>8443/TCP HTTPS"]
            RESTService["rest-service<br/>(Rust / actix-web)<br/>8080/TCP HTTP"]
            KubeRBACProxy -->|"localhost<br/>passthrough"| RESTService
        end

        subgraph FlightStack["Flight Service Stack"]
            FlightService["flight-service<br/>(Rust / tonic)<br/>8443/TCP gRPC+TLS"]
        end

        subgraph ConnectorLayer["Connector Layer (Rust Crates)"]
            PG["postgres-connector"]
            SQLite["sqlite-connector"]
            S3["s3-connector<br/>(OpenDAL)"]
            Milvus["milvus-connector"]
            ES["elasticsearch-connector"]
            Neo4j["neo4j-connector<br/>(neo4rs)"]
            URI["uri-connector"]
        end

        subgraph SharedLibs["Shared Libraries"]
            Commons["commons<br/>(SQLReader trait)"]
            PGMeta["pg-meta-store"]
            KubeUtils["kube-utils"]
            FormatReaders["format-readers<br/>(CSV, JSON, Parquet)"]
        end

        FlightService --> ConnectorLayer
        RESTService --> PGMeta
        FlightService --> PGMeta
        RESTService --> KubeUtils
        FlightService --> KubeUtils
        ConnectorLayer --> Commons
        ConnectorLayer --> FormatReaders
    end

    %% CRDs
    DCServiceCR["DataConnectService CR"]
    InitConnCR["InitDataConnection CR"]
    InitTypeCR["InitDataConnectionType CR"]

    User["User / Operator"] -->|creates| DCServiceCR
    DCServiceCR -->|watched by| Controller
    InitConnCR -->|watched by| Controller
    InitTypeCR -->|watched by| Controller

    %% Controller deploys data plane
    Controller -->|"deploys &<br/>manages"| RESTStack
    Controller -->|"deploys &<br/>manages"| FlightStack
    Controller -->|"creates HTTPRoutes,<br/>NetworkPolicies,<br/>ServiceMonitors,<br/>RBAC"| K8sAPI["Kubernetes API"]

    %% External integrations
    RESTService -->|"readiness audit"| FlightService
    Gateway["odh-gateway<br/>(Gateway API)"] -->|"HTTPRoute<br/>8443/TCP"| KubeRBACProxy
    Gateway -->|"HTTPRoute<br/>8443/TCP"| FlightService
    Controller -->|"reads TLS profile"| APIServer["OpenShift APIServer"]
    Controller -->|"reads ingress domain"| Ingress["OpenShift Ingress"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACProxy fill:#e8a838,stroke:#333,color:#fff
    style RESTService fill:#4a90e2,stroke:#333,color:#fff
    style FlightService fill:#4a90e2,stroke:#333,color:#fff
    style DCServiceCR fill:#f5a623,stroke:#333,color:#fff
    style InitConnCR fill:#f5a623,stroke:#333,color:#fff
    style InitTypeCR fill:#f5a623,stroke:#333,color:#fff
    style Gateway fill:#7ed321,stroke:#333,color:#fff
    style APIServer fill:#999,stroke:#333,color:#fff
    style Ingress fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
