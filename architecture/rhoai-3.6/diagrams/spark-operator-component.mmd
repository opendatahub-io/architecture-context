graph TB
    subgraph ModuleController["Module Controller Tier"]
        ModCtrl["spark-operator-module-controller<br/>(Go Operator)"]
    end

    subgraph WorkloadOperator["Workload Operator Tier"]
        Controller["spark-operator-controller<br/>(Go Operator)"]
        Webhook["spark-operator-webhook<br/>(Go Webhook Server)<br/>9443/TCP"]
        Controller -->|"validates via"| Webhook
    end

    subgraph CRDs["Custom Resource Definitions"]
        SparkApp["SparkApplication<br/>(v1beta2, Namespaced)"]
        ScheduledApp["ScheduledSparkApplication<br/>(v1beta2, Namespaced)"]
        SparkConn["SparkConnect<br/>(v1alpha1, Namespaced)"]
        SparkOpCR["SparkOperator CR<br/>(v1alpha1, Cluster)"]
    end

    subgraph SparkRuntime["Spark Runtime"]
        Driver["Spark Driver Pod<br/>7078/TCP RPC"]
        Executor["Spark Executor Pods"]
        SparkUI["Spark UI Service<br/>4040/TCP"]
        ConnectGRPC["SparkConnect gRPC<br/>15002/TCP"]
    end

    %% Module controller manages workload operator
    PlatformOp["opendatahub-operator /<br/>rhods-operator"] -->|"creates"| SparkOpCR
    SparkOpCR -->|"watched by"| ModCtrl
    ModCtrl -->|"deploys & manages"| Controller
    ModCtrl -->|"deploys & manages"| Webhook

    %% User interaction
    User["User / CI"] -->|"creates"| SparkApp
    User -->|"creates"| ScheduledApp
    User -->|"creates"| SparkConn

    %% Controller reconciliation
    SparkApp -->|"watched by"| Controller
    ScheduledApp -->|"watched by"| Controller
    SparkConn -->|"watched by"| Controller

    %% Controller creates runtime
    Controller -->|"creates"| Driver
    Controller -->|"creates"| Executor
    Controller -->|"creates"| SparkUI
    Controller -->|"creates"| ConnectGRPC
    Driver -->|"manages"| Executor

    %% External dependencies
    Controller -->|"depends on"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|"depends on"| OpenShiftAPI["OpenShift APIServer<br/>TLS Profile"]
    Webhook -->|"depends on"| CertMgr["cert-manager"]
    Controller -->|"integrates"| Prometheus["prometheus-operator<br/>PodMonitor"]
    ModCtrl -->|"uses"| ODHPlatform["odh-platform-utilities"]

    %% Styling
    style ModCtrl fill:#9b59b6,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style SparkApp fill:#f5a623,stroke:#333
    style ScheduledApp fill:#f5a623,stroke:#333
    style SparkConn fill:#f5a623,stroke:#333
    style SparkOpCR fill:#f5a623,stroke:#333
    style Driver fill:#2ecc71,stroke:#333
    style Executor fill:#2ecc71,stroke:#333
    style SparkUI fill:#2ecc71,stroke:#333
    style ConnectGRPC fill:#2ecc71,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style CertMgr fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style ODHPlatform fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#7ed321,stroke:#333
