graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kube-rbac-proxy<br/>Namespace: default"]
        PrometheusSA["system:serviceaccount:<br/>openshift-monitoring:<br/>prometheus-k8s"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["kube-rbac-proxy<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["kube-rbac-proxy<br/>(ClusterRole)"]
        CR_Metrics["metrics<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    subgraph HardcodedAuth["Hardcoded Authorizer"]
        HardcodedRule["Auto-allow GET /metrics<br/>(no SAR check required)<br/>OpenShift-specific carve-out"]
    end

    %% RBAC Bindings
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR_Main

    %% ClusterRole Permissions
    CR_Main -->|"create"| TokenReviews
    CR_Main -->|"create"| SAR

    CR_Metrics -->|"get"| MetricsURL

    %% Hardcoded Authorization
    PrometheusSA -->|"hardcoded allow"| HardcodedRule
    HardcodedRule -->|"bypasses RBAC for"| MetricsURL

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style PrometheusSA fill:#4a90e2,color:#fff
    style CRB fill:#d0d0d0,stroke:#333
    style CR_Main fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style MetricsURL fill:#7ed321,color:#fff
    style HardcodedRule fill:#f8cecc,stroke:#b85450
