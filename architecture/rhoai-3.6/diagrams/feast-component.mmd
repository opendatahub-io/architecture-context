graph TB
    subgraph FeastOperator["Feast Operator (redhat-ods-applications)"]
        Manager["feast-operator manager<br/>(Go, controller-runtime)"]
        TLSBootstrap["TLS Bootstrap<br/>(reads OpenShift APIServer profile)"]
        NotebookReconciler["NotebookConfigMap<br/>Reconciler"]
        Manager --> TLSBootstrap
        Manager --> NotebookReconciler
    end

    subgraph UserNamespace["User Namespace (per-FeatureStore CR)"]
        FeatureServerPy["Feature Server<br/>(Python, FastAPI/uvicorn)<br/>Port: 6566/TCP"]
        FeatureServerGo["Feature Server<br/>(Go, HTTP+gRPC)<br/>Port: configurable"]
        FeastUI["Feast UI"]
        CronJob["Materialization CronJob<br/>(ose-cli)"]
        PerCRSA["Per-CR ServiceAccount"]
        PerCRRBAC["Per-CR Roles &<br/>RoleBindings"]
    end

    User["Data Scientist / ML App"] -->|creates| FeatureStoreCR["FeatureStore CR<br/>(feast.dev/v1)"]
    FeatureStoreCR -->|watched by| Manager
    Manager -->|creates & reconciles| FeatureServerPy
    Manager -->|creates & reconciles| FeatureServerGo
    Manager -->|creates| FeastUI
    Manager -->|creates| CronJob
    Manager -->|creates| PerCRSA
    Manager -->|creates| PerCRRBAC

    NotebookReconciler -->|watches| NotebookCR["Notebook CR<br/>(kubeflow.org)"]
    NotebookReconciler -->|injects config via| ConfigMap["ConfigMap<br/>(feature_store.yaml)"]

    Manager -->|watches| MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io)"]
    Manager -->|creates| ServiceMonitor["ServiceMonitor<br/>(monitoring.coreos.com)"]
    Manager -->|creates| Route["OpenShift Route<br/>(feast-ui)"]
    Manager -->|creates| SparkApp["SparkApplication<br/>(sparkoperator.k8s.io)"]
    Manager -->|creates| HPA["HorizontalPodAutoscaler"]
    Manager -->|creates| PDB["PodDisruptionBudget"]

    FeatureServerPy -->|reads/writes| Redis["Redis / Valkey<br/>(Online Store)"]
    FeatureServerPy -->|reads/writes| PostgreSQL["PostgreSQL<br/>(Online/Offline Store)"]
    FeatureServerPy -->|reads/writes| S3["S3-compatible Storage<br/>(Registry/Offline Store)"]

    Manager -->|reads TLS profile| APIServer["OpenShift APIServer<br/>(config.openshift.io)"]

    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style TLSBootstrap fill:#4a90e2,stroke:#333,color:#fff
    style NotebookReconciler fill:#4a90e2,stroke:#333,color:#fff
    style FeatureServerPy fill:#7ed321,stroke:#333
    style FeatureServerGo fill:#7ed321,stroke:#333
    style FeastUI fill:#7ed321,stroke:#333
    style CronJob fill:#7ed321,stroke:#333
    style FeatureStoreCR fill:#f5a623,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style MLflowCR fill:#f5a623,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#b8d4e3,stroke:#333
    style Route fill:#b8d4e3,stroke:#333
    style SparkApp fill:#b8d4e3,stroke:#333
