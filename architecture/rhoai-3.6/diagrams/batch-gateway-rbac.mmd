graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["{release}-apiserver<br/>API Server SA"]
        SA_Proc["{release}-processor<br/>Processor SA"]
        SA_GC["{release}-gc<br/>GC SA"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB["RoleBinding:<br/>{release}-gc-pod-watcher<br/>(namespace-scoped)"]
    end

    subgraph Roles["Namespace Roles"]
        Role["Role:<br/>{release}-gc-pod-watcher<br/>(only when reconciler.enabled)"]
    end

    subgraph APIResources["API Resources"]
        Pods["core<br/>pods"]
        StatefulSets["apps<br/>statefulsets"]
    end

    subgraph PodSecurity["Pod Security Context (all components)"]
        RunAsNonRoot["runAsNonRoot: true"]
        Seccomp["seccompProfile: RuntimeDefault"]
        NoPrivEsc["allowPrivilegeEscalation: false"]
        DropCaps["capabilities: drop ALL"]
        ReadOnly["readOnlyRootFilesystem: true"]
    end

    %% GC RBAC chain
    SA_GC -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -->|"get, list, watch"| Pods
    Role -->|"get, list, watch"| StatefulSets

    %% No RBAC for API server and Processor
    SA_API -.-|"no custom RBAC<br/>(default SA permissions)"| NoRBAC["Default ServiceAccount<br/>Permissions Only"]
    SA_Proc -.-|"no custom RBAC<br/>(default SA permissions)"| NoRBAC

    %% Pod security applies to all
    SA_API -.-> PodSecurity
    SA_Proc -.-> PodSecurity
    SA_GC -.-> PodSecurity

    style SA_GC fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proc fill:#4a90e2,stroke:#333,color:#fff
    style Role fill:#f5a623,stroke:#333
    style RB fill:#f5a623,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style StatefulSets fill:#7ed321,stroke:#333
    style NoRBAC fill:#e8e8e8,stroke:#999
    style RunAsNonRoot fill:#d5e8d4,stroke:#82b366
    style Seccomp fill:#d5e8d4,stroke:#82b366
    style NoPrivEsc fill:#d5e8d4,stroke:#82b366
    style DropCaps fill:#d5e8d4,stroke:#82b366
    style ReadOnly fill:#d5e8d4,stroke:#82b366
