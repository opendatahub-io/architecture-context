graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mlflow-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["mlflow-operator-<br/>manager-rolebinding"]
        CRB2["mlflow-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["mlflow-operator-<br/>manager-role"]
        CR_MetricsAuth["mlflow-operator-<br/>metrics-auth-role"]
        CR_MetricsReader["mlflow-operator-<br/>metrics-reader"]
        CR_View["mlflow-operator-<br/>mlflow-view<br/>(aggregate)"]
        CR_Edit["mlflow-operator-<br/>mlflow-edit<br/>(aggregate)"]
        CR_Integration["mlflow-operator-<br/>mlflow-integration"]
    end

    subgraph CoreResources["Core API Resources"]
        MLflows["mlflow.opendatahub.io<br/>mlflows, mlflows/status,<br/>mlflows/finalizers"]
        MLflowOps["components.platform.opendatahub.io<br/>mlflowoperators,<br/>mlflowoperators/status"]
        MLflowConfigs["mlflow.kubeflow.org<br/>mlflowconfigs, experiments"]
    end

    subgraph PlatformResources["Platform Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        ConsoleLinks["console.openshift.io<br/>consolelinks"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
        RBAC_Res["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings"]
    end

    subgraph AuthResources["Auth Resources"]
        AuthCR["services.platform.opendatahub.io<br/>auths<br/>(resourceName: auth)"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NamespacedResources["Namespaced Resources"]
        CoreNS["core: configmaps, pvcs,<br/>secrets, serviceaccounts, services, pods"]
        AppsNS["apps: deployments"]
        BatchNS["batch: jobs, cronjobs"]
        NetNS["networking.k8s.io: networkpolicies"]
    end

    %% Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    CRB1 -->|grants| CR_Manager
    CRB2 -->|grants| CR_MetricsAuth

    %% Manager role permissions
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| MLflows
    CR_Manager -->|"get,list,watch,<br/>patch,update"| MLflowOps
    CR_Manager -->|"get,list,watch,update"| MLflowConfigs
    CR_Manager -->|"CRUD + watch"| HTTPRoutes
    CR_Manager -->|"CRUD + watch"| ConsoleLinks
    CR_Manager -->|"CRUD + watch"| ServiceMonitors
    CR_Manager -->|"CRUD + watch"| RBAC_Res
    CR_Manager -->|"get,list,watch"| AuthCR
    CR_Manager -->|"CRUD + watch"| NamespacedResources

    %% Metrics auth role
    CR_MetricsAuth -->|create| TokenReviews
    CR_MetricsAuth -->|create| SAR

    %% Metrics reader
    CR_MetricsReader -->|"get /metrics"| MetricsURL["/metrics<br/>(non-resource URL)"]

    %% Aggregate roles
    CR_View -->|"get,list,watch"| ViewRes["mlflows, mlflowconfigs,<br/>datasets, experiments,<br/>registeredmodels,<br/>gatewayendpoints, mcpservers"]
    CR_Edit -->|"CRUD + watch"| EditRes["mlflows, mlflowconfigs,<br/>datasets, experiments,<br/>registeredmodels,<br/>gatewaysecrets, mcpservers"]
    CR_Integration -->|"get,list,create,update"| IntRes["datasets, experiments,<br/>registeredmodels,<br/>gatewayendpoints,<br/>mcpservers"]

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#000
    style CR_MetricsAuth fill:#f5a623,color:#000
    style CR_MetricsReader fill:#f5a623,color:#000
    style CR_View fill:#e8d4f0,color:#000
    style CR_Edit fill:#e8d4f0,color:#000
    style CR_Integration fill:#e8d4f0,color:#000
    style MLflows fill:#7ed321,color:#000
    style MLflowOps fill:#7ed321,color:#000
    style MLflowConfigs fill:#7ed321,color:#000
