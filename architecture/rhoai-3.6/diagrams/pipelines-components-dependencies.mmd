    PC["Pipelines Components"]

    %% External Dependencies (Python packages)
    PC -->|pipeline SDK| KFP["kfp >=2.16.1"]
    PC -->|K8s extensions| KFPK8s["kfp-kubernetes >=2.16.1"]
    PC -->|K8s API client| K8sClient["kubernetes ==36.0.3"]
    PC -->|TLS/crypto| Crypto["cryptography ==50.0.1"]
    PC -->|HTTP client| Requests["requests ==2.33.0"]
    PC -->|S3 access| Boto3["boto3 >=1.42.0"]
    PC -->|data generation| SDGHub["sdg-hub >=0.7.0"]
    PC -->|RAG optimization| AI4RAG["ai4rag ==0.21.0"]
    PC -->|serialization| Protobuf["protobuf ==6.33.6"]
    PC -->|doc parsing| Docling["docling"]
    PC -->|model registry SDK| ModelRegSDK["model-registry ==0.3.4"]

    %% Internal Platform Dependencies
    KServe["KServe"] -->|manages CRs created by| PC
    DSPO["DSPO"] -->|injects RELATED_IMAGE_*| PC
    Dashboard["RHOAI Dashboard"] -.->|annotation convention| PC
    HWProfile["HardwareProfile CRD"] -->|GPU config read by| PC
    EvalHub["Eval Hub"] -->|evaluation jobs| PC
    KFPModelReg["Kubeflow Model Registry"] -->|model registration| PC

    %% Integration Points
    HF["HuggingFace Hub"] -->|datasets/models| PC
    S3["S3 / MinIO"] -->|artifact storage| PC
    Milvus["Milvus"] -.->|vector DB| PC
    MLflow["MLflow"] -.->|experiment tracking| PC
    LiteLLM["LiteLLM"] -.->|LLM inference| PC

