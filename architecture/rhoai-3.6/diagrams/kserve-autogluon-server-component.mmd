graph TB
    subgraph AutoGluonServer["KServe AutoGluon Server"]
        direction TB
        Main["__main__.py<br/>Entrypoint"]
        RuntimePaths["runtime_paths<br/>Writable FS Setup"]
        DetectedModel["AutoGluonDetectedModel<br/>Auto-detect Predictor Type"]
        PredictorDetect["predictor_detect<br/>Try-load Detection"]
        VersionCompat["version_compat<br/>Patch-level Tolerance"]

        subgraph Predictors["Model Handlers"]
            TabularModel["AutoGluonTabularModel<br/>v1 + v2 Protocol"]
            TimeSeriesModel["AutoGluonTimeSeriesModel<br/>v1 Protocol Only"]
        end

        subgraph ModelRepo["Multi-Model Serving"]
            Repository["AutoGluonModelRepository<br/>Model Discovery"]
        end

        Main -->|initializes| RuntimePaths
        Main -->|creates| DetectedModel
        DetectedModel -->|uses| PredictorDetect
        PredictorDetect -->|loads| VersionCompat
        PredictorDetect -->|"try TimeSeriesPredictor first"| TimeSeriesModel
        PredictorDetect -->|"fallback to TabularPredictor"| TabularModel
        DetectedModel -->|delegates predict| TabularModel
        DetectedModel -->|delegates predict| TimeSeriesModel
        Repository -->|discovers| DetectedModel
    end

    subgraph KServeSDK["KServe Python SDK"]
        ModelServer["ModelServer<br/>FastAPI + uvicorn"]
        GRPCServer["gRPC Server<br/>v2 Protocol"]
    end

    Main -->|starts| ModelServer
    Main -->|starts| GRPCServer

    Client["Client / Gateway"] -->|"POST /v1/models/:predict<br/>POST /v2/models/infer"| ModelServer
    Client -->|"gRPC Infer"| GRPCServer
    ModelServer -->|routes to| DetectedModel
    GRPCServer -->|routes to| TabularModel

    subgraph MLBackends["ML Backends (in-process)"]
        AutoGluon["AutoGluon 1.5.0"]
        LightGBM["LightGBM 4.6.0"]
        XGBoost["XGBoost 3.1.3"]
        PyTorch["PyTorch 2.11.0"]
        FastAI["fastai 2.8.7"]
    end

    TabularModel -->|uses| AutoGluon
    TimeSeriesModel -->|uses| AutoGluon
    AutoGluon -->|backend| LightGBM
    AutoGluon -->|backend| XGBoost
    AutoGluon -->|backend| PyTorch
    AutoGluon -->|backend| FastAI

    StorageInit["KServe Storage Initializer<br/>Init Container"] -->|"downloads to /mnt/models"| ModelArtifacts["/mnt/models<br/>Model Artifacts"]
    ModelArtifacts -->|loaded by| PredictorDetect

    CSR["ClusterServingRuntime<br/>kserve-autogluonserver"] -.->|registers| AutoGluonServer
    KServeOp["KServe Operator"] -->|"manages lifecycle via"| CSR

    Prometheus["Prometheus"] -->|"scrapes /metrics"| ModelServer

    style AutoGluonServer fill:#4a90e2,stroke:#2c5f9e,color:#fff
    style DetectedModel fill:#5ba3f5,stroke:#2c5f9e,color:#fff
    style TabularModel fill:#5ba3f5,stroke:#2c5f9e,color:#fff
    style TimeSeriesModel fill:#5ba3f5,stroke:#2c5f9e,color:#fff
    style ModelServer fill:#7ed321,stroke:#5a9e18,color:#fff
    style GRPCServer fill:#7ed321,stroke:#5a9e18,color:#fff
    style Client fill:#f5a623,stroke:#c4841b
    style StorageInit fill:#e8e8e8,stroke:#999
    style KServeOp fill:#e8e8e8,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#999
    style CSR fill:#f5a623,stroke:#c4841b
