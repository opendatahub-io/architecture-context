graph TB
    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(ray-module-operator-system)"]
        direction TB

        subgraph RMOPod["ray-module-operator-controller-manager"]
            Controller["Controller Manager<br/>SA: ray-module-operator-controller-manager<br/>Image: odh-ray-module-operator"]
            HealthEndpoint["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS<br/>TokenReview + SAR"]
        end
    end

    subgraph AppsNS["APPLICATIONS NAMESPACE<br/>(spec.applicationsNamespace)"]
        direction TB

        subgraph KubeRayPod["KubeRay Operator Pod"]
            KubeRay["KubeRay Controller<br/>Image: kuberay-operator:v1.6.2<br/>SCC: runAsUser 1000"]
            RBACProxy["kube-rbac-proxy<br/>Image: odh-kube-rbac-proxy"]
        end

        ConfigMap["odh-ray-config<br/>ConfigMap"]
    end

    subgraph ClusterScoped["CLUSTER-SCOPED RESOURCES"]
        RayCR["Ray CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Singleton: default-ray"]
        RayClusterRole["ray ClusterRole<br/>Notebook SA binding"]
        RayCRDs["ray.io CRDs<br/>RayCluster, RayJob,<br/>RayService, RayCronJob"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>CRD: Certificate, Issuer"]
        GatewayAPI["Gateway API<br/>CRD: Gateway, HTTPRoute,<br/>ReferenceGrant"]
        PlatformOp["Platform Operator"]
    end

    %% Flows
    PlatformOp -->|"Creates Ray CR<br/>HTTPS/6443<br/>TLS 1.2+"| RayCR
    Controller -->|"Watches Ray CR<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Controller -->|"SSA Apply Manifests<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Controller -->|"Validates CRDs<br/>HTTPS/6443"| CertManager
    Controller -->|"Reads config<br/>HTTPS/6443"| ConfigMap
    K8sAPI -->|"Watch events"| Controller
    Controller -->|"Deploys operand<br/>SSA"| KubeRayPod
    Controller -->|"Creates"| RayClusterRole
    KubeRay -->|"Manages"| RayCRDs

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef apps fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class K8sAPI controlplane
    class Controller,HealthEndpoint,MetricsEndpoint operator
    class KubeRay,RBACProxy,ConfigMap apps
    class RayCR,RayClusterRole,RayCRDs cluster
    class CertManager,GatewayAPI,PlatformOp platform
