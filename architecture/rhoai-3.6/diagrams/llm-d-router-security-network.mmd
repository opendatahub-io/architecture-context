graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway / Envoy)"]
        Gateway["Envoy Gateway<br/>443/TCP external<br/>TLS 1.2+<br/>Bearer Token Auth"]
    end

    subgraph EPPZone["EPP ZONE (Optional TLS)"]
        direction TB

        subgraph NS_EPP["Namespace: pool-namespace"]
            EPPGrpc["EPP gRPC Server<br/>9002/TCP gRPC<br/>Optional TLS<br/>SA: llm-d-router"]
            EPPHealth["EPP Health<br/>9003/TCP gRPC<br/>Optional TLS"]
            EPPMetrics["EPP Metrics<br/>9090/TCP HTTP<br/>Optional TLS<br/>kube-rbac-proxy"]
        end
    end

    subgraph CoordinatorZone["COORDINATOR ZONE (TLS 1.2+)"]
        direction TB

        subgraph NS_Coord["Namespace: coordinator-namespace"]
            CoordHTTPS["Coordinator<br/>8080/TCP HTTPS<br/>TLS 1.2+<br/>No app-layer auth"]
            CoordMetrics["Coordinator Metrics<br/>9090/TCP HTTP"]
        end
    end

    subgraph SidecarZone["SIDECAR ZONE (Pod-local)"]
        direction TB

        subgraph NS_Sidecar["Pod: model-server"]
            SidecarProxy["Sidecar Proxy<br/>8000/TCP HTTP<br/>Optional TLS<br/>No auth (pod-local)"]
            LocalModel["Local Model Server<br/>8200/TCP HTTP<br/>No encryption"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable TLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Redis["Redis<br/>6379/TCP<br/>No encryption<br/>No auth"]
        RenderSvc["Rendering Service<br/>8080/TCP HTTP<br/>No encryption"]
        InfGW["Inference Gateway<br/>80/TCP HTTP<br/>No encryption"]
        ModelPods["Model Server Pods<br/>HTTP<br/>No encryption"]
        PrefillWorkers["Prefill Workers<br/>HTTP/HTTPS<br/>Optional TLS"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway

    %% Gateway to EPP
    Gateway -->|"gRPC/9002<br/>Optional TLS<br/>No app auth"| EPPGrpc
    EPPGrpc -->|"Routing decision<br/>gRPC response"| Gateway

    %% Gateway to model servers
    Gateway -->|"HTTP<br/>Forward to selected endpoint"| ModelPods

    %% Client to Coordinator
    Client -->|"HTTPS/8080<br/>TLS 1.2+"| CoordHTTPS

    %% Gateway to Sidecar
    Gateway -->|"HTTP/8000<br/>Optional TLS"| SidecarProxy

    %% EPP to platform
    EPPGrpc -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    EPPGrpc -->|"HTTP<br/>Metrics scrape"| ModelPods
    EPPGrpc -.->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Coordinator to dependencies
    CoordHTTPS -->|"HTTP/8080<br/>No encryption"| RenderSvc
    CoordHTTPS -->|"HTTP/80<br/>No encryption"| InfGW
    CoordHTTPS -->|"TCP/6379<br/>No encryption"| Redis
    CoordHTTPS -.->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Sidecar flows
    SidecarProxy -->|"HTTP/HTTPS<br/>Optional TLS"| PrefillWorkers
    SidecarProxy -->|"HTTP/8200<br/>No encryption"| LocalModel
    SidecarProxy -.->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef eppzone fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef coordzone fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef sidecarzone fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class EPPGrpc,EPPHealth,EPPMetrics eppzone
    class CoordHTTPS,CoordMetrics coordzone
    class SidecarProxy,LocalModel sidecarzone
    class K8sAPI,OTel platform
    class Redis,RenderSvc,InfGW,ModelPods,PrefillWorkers externalservice
