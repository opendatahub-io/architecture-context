graph TB
    subgraph LocalExec["LOCAL EXECUTION ENVIRONMENT"]
        direction TB

        User["User / Kubeflow Pipeline"]

        subgraph TrainingHubLib["Training Hub Library"]
            direction TB
            CLI["thub CLI"]
            Registry["AlgorithmRegistry"]
            Callbacks["Callback System"]
            JITCkpt["JIT Checkpoint<br/>SIGTERM handler"]
        end

        subgraph WeightTraining["Weight-Training Path"]
            direction TB
            TorchRun["torchrun Workers<br/>SFT / OSFT / LoRA / verl"]
            GPU["GPU(s)<br/>CUDA / NCCL"]
            vLLMEngine["vLLM Engine<br/>Co-located (GRPO rollouts)"]
        end

        subgraph GEPAPath["GEPA Path (CPU-only)"]
            GEPAOpt["GEPA Optimizer<br/>Evolutionary search"]
        end

        CkptDir["Checkpoint Dir<br/>Local / PVC"]
        CkptMgr["Checkpoint Manager<br/>fsspec"]
    end

    subgraph ExternalServices["EGRESS - EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: HF_TOKEN"]
        LLMAPI["LLM API Endpoints<br/>OpenAI / vLLM compatible<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: OPENAI_API_KEY"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM"]
        MLflow["MLflow Server<br/>HTTP/HTTPS<br/>Auth: varies"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS<br/>Auth: WANDB_API_KEY"]
    end

    %% Internal flows
    User -->|"Python API / CLI<br/>local"| CLI
    CLI --> Registry
    Registry -->|"torchrun spawn"| TorchRun
    Registry -->|"CPU-only"| GEPAOpt
    TorchRun -->|"CUDA driver"| GPU
    TorchRun -->|"in-process"| vLLMEngine
    TorchRun --> CkptDir
    Callbacks -.->|"lifecycle hooks"| TorchRun
    JITCkpt -.->|"SIGTERM save"| CkptDir
    CkptDir -->|"fsspec"| CkptMgr

    %% Egress flows
    TorchRun -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    GEPAOpt -->|"HTTPS/443<br/>TLS 1.2+<br/>OPENAI_API_KEY<br/>via litellm"| LLMAPI
    CkptMgr -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    GEPAOpt -.->|"HTTP/HTTPS<br/>varies"| MLflow
    TorchRun -.->|"HTTPS/443<br/>TLS 1.2+<br/>WANDB_API_KEY"| WandB

    %% Styling
    classDef local fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef compute fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User local
    class CLI,Registry,Callbacks,JITCkpt library
    class TorchRun,GPU,vLLMEngine,GEPAOpt compute
    class HFHub,LLMAPI,MLflow,WandB external
    class S3,CkptDir,CkptMgr storage
