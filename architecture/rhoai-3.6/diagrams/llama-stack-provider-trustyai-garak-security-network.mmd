graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>Optional HF token"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph EvalHubNS["Namespace: eval-hub job namespace"]
            Adapter["Garak Adapter Pod<br/>K8s Job<br/>SA: eval-hub job SA"]
            Sidecar["eval-hub Sidecar<br/>localhost HTTP<br/>No auth"]
            ConfigMap["ConfigMap<br/>/etc/eval-job/spec.json"]
            ModelAuthSecret["Secret: model-auth<br/>/mnt/model-auth<br/>API keys per role"]
        end

        subgraph KFPNamespace["Namespace: KFP namespace"]
            KFPAPI["KFP API Server<br/>Configured/TCP<br/>HTTP/HTTPS<br/>SA token / sidecar proxy"]
            KFPPods["KFP Pipeline Pods<br/>6-step pipeline<br/>S3 secrets injected"]
        end

        subgraph OperatorNS["Namespace: redhat-ods-applications"]
            TrustyAICM["TrustyAI Service Operator<br/>ConfigMap:<br/>trustyai-service-operator-config"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM credentials"]
        ModelEndpoint["Model Inference Endpoint<br/>Configured/TCP HTTPS<br/>TLS<br/>API key (Bearer)"]
        OCIRegistry["OCI Registry<br/>443/TCP HTTPS<br/>TLS<br/>OCI auth"]
    end

    %% Internal flows
    ConfigMap -->|mounted| Adapter
    ModelAuthSecret -->|volume mount<br/>optional=True| Adapter
    Adapter -->|HTTP localhost<br/>No encryption<br/>No auth| Sidecar
    Adapter -->|HTTP/HTTPS<br/>TLS configurable<br/>SA token / sidecar| KFPAPI
    KFPAPI -->|creates| KFPPods
    TrustyAICM -.->|K8s API read<br/>base image resolution| Adapter

    %% External flows
    Adapter -->|HTTPS/443<br/>TLS<br/>AWS credentials| S3
    Adapter -->|HTTPS<br/>TLS<br/>API key Bearer| ModelEndpoint
    Adapter -->|HTTPS/443<br/>TLS<br/>OCI auth| OCIRegistry
    KFPPods -->|HTTPS/443<br/>TLS<br/>AWS credentials| S3
    KFPPods -->|HTTPS<br/>TLS<br/>API key Bearer| ModelEndpoint
    Adapter -->|HTTPS/443<br/>TLS<br/>Optional HF token| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef config fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class HFHub external
    class Adapter,Sidecar,KFPAPI,KFPPods,TrustyAICM cluster
    class S3,ModelEndpoint,OCIRegistry externalservice
    class ConfigMap config
    class ModelAuthSecret secret
