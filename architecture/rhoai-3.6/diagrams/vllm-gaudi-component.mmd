graph TB
    subgraph "vllm-gaudi Plugin"
        direction TB
        VllmGaudi["vllm_gaudi<br/>Python Package"]
        HpuPlatform["HpuPlatform<br/>Platform Plugin"]
        HPUWorker["HPUWorker<br/>Device Worker"]
        HPUModelRunner["HPUModelRunner<br/>Model Runner"]

        VllmGaudi -->|registers| HpuPlatform
        HpuPlatform -->|configures| HPUWorker
        HPUWorker -->|delegates to| HPUModelRunner
    end

    subgraph "Container Image"
        direction TB
        Dockerfile["Dockerfile.konflux.gaudi<br/>UBI 9 / SynapseAI 1.23.0"]
        VllmServer["vLLM OpenAI API Server<br/>Port 8000/TCP"]
        Dockerfile -->|runs| VllmServer
    end

    subgraph "Plugin Entry Points"
        PlatformPlugin["vllm.platform_plugins<br/>hpu"]
        GeneralPlugins["vllm.general_plugins<br/>utils, ops, models"]
    end

    VllmGaudi -->|setuptools entry point| PlatformPlugin
    VllmGaudi -->|setuptools entry point| GeneralPlugins

    Client[Client / KServe Router] -->|POST /v1/completions<br/>POST /v1/chat/completions| VllmServer
    VllmServer -->|inference| HPUWorker
    HPUWorker -->|PCIe / Habana interconnect| GaudiHPU["Intel Gaudi HPU<br/>Gaudi 2 / Gaudi 3"]

    HPUWorker -->|model weights| Storage["Model Storage<br/>S3 / PVC / HuggingFace"]
    HPUWorker -.->|HCCL / NIXL| OtherWorkers["HPUWorker<br/>rank N"]

    subgraph "Supported Quantization"
        FP8[FP8]
        INC[INC]
        AWQ[AWQ]
        GPTQ[GPTQ]
        ModelOpt[ModelOpt]
        CT["compressed-tensors"]
    end

    HpuPlatform -->|configures| FP8
    HpuPlatform -->|configures| INC
    HpuPlatform -->|configures| AWQ
    HpuPlatform -->|configures| GPTQ
    HpuPlatform -->|configures| ModelOpt
    HpuPlatform -->|configures| CT

    style VllmGaudi fill:#4a90e2,stroke:#333,color:#fff
    style HpuPlatform fill:#4a90e2,stroke:#333,color:#fff
    style HPUWorker fill:#4a90e2,stroke:#333,color:#fff
    style HPUModelRunner fill:#4a90e2,stroke:#333,color:#fff
    style VllmServer fill:#4a90e2,stroke:#333,color:#fff
    style GaudiHPU fill:#f5a623,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style Storage fill:#e8e8e8,stroke:#333
    style OtherWorkers fill:#7ed321,stroke:#333
    style Dockerfile fill:#d5e8d4,stroke:#82b366
