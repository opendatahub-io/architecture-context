graph TB
    subgraph Praxis["Praxis Proxy Server"]
        direction TB

        subgraph Server["praxis-proxy (server binary)"]
            CLI["CLI Entry Point<br/>--config, --validate, --dump"]
            ConfigLoader["Config Loader<br/>YAML parsing"]
            HotReload["Hot-Reload Watcher<br/>ArcSwap + notify<br/>500ms debounce"]
            Bootstrap["Server Bootstrap<br/>Pingora server loop"]
        end

        subgraph Protocol["praxis-proxy-protocol"]
            HttpAdapter["HTTP Protocol Adapter<br/>Pingora HTTP callbacks"]
            TcpAdapter["TCP Protocol Adapter<br/>Pingora TCP callbacks"]
            HealthProbe["Health Check Probes<br/>/healthy"]
            AdminEndpoints["Admin Endpoints<br/>/metrics"]
        end

        subgraph Filter["praxis-proxy-filter"]
            direction TB
            FilterRegistry["FilterRegistry"]
            PipelineEngine["Pipeline Engine<br/>HttpFilter + TcpFilter traits"]

            subgraph Observability["Observability Filters"]
                AccessLog["access_log"]
                RequestId["request_id"]
                TraceCtx["trace_context"]
                CloudEvents["cloud_events"]
            end

            subgraph Security["Security Filters"]
                BasicAuth["Basic Auth<br/>(htpasswd)"]
                CORS["cors"]
                CSRF["csrf"]
                CredInjection["credential_injection"]
                IPAcl["ip_acl"]
                PeerIdentity["peer_identity_trust"]
                Policy["policy"]
                Guardrails["guardrails"]
            end

            subgraph TrafficMgmt["Traffic Management Filters"]
                Router["router"]
                LoadBalancer["load_balancer"]
                RateLimit["rate_limit / token_bucket"]
                CircuitBreaker["circuit_breaker"]
                Timeout["timeout"]
                Redirect["redirect"]
            end

            subgraph Transformation["Transformation Filters"]
                HeaderMod["header"]
                PathRewrite["path_rewrite / url_rewrite"]
                GrpcStatus["grpc_status"]
            end

            subgraph Payload["Payload Processing Filters"]
                Compression["compression"]
                JsonBody["json_body / json_body_field"]
                GrpcWeb["grpc_web"]
                BodyParsing["body_parsing"]
            end
        end

        subgraph Core["praxis-proxy-core"]
            ConfigTypes["Config Types<br/>serde YAML"]
            Validation["Validation"]
            ErrorTypes["Error Types"]
            HealthState["Health State"]
            KVStore["KV Store Registry"]
        end

        subgraph TLS["praxis-proxy-tls"]
            CryptoProvider["Crypto Provider Install<br/>rustls-openssl"]
            SNIResolution["SNI Resolution<br/>incl. wildcards"]
            CertLoading["Cert Loading<br/>file-based + hot-reload"]
            FIPSStatus["FIPS Status Check"]
        end
    end

    %% Internal connections
    CLI --> ConfigLoader
    ConfigLoader --> Core
    ConfigLoader --> Bootstrap
    HotReload --> PipelineEngine
    Bootstrap --> Protocol
    HttpAdapter --> PipelineEngine
    TcpAdapter --> PipelineEngine
    PipelineEngine --> FilterRegistry
    FilterRegistry --> Observability
    FilterRegistry --> Security
    FilterRegistry --> TrafficMgmt
    FilterRegistry --> Transformation
    FilterRegistry --> Payload
    Bootstrap --> TLS
    CryptoProvider --> SNIResolution

    %% External
    Client[External Client] -->|8080/TCP<br/>HTTP/HTTPS| HttpAdapter
    HttpAdapter -->|proxy| Upstream[Upstream Clusters]
    ContainerRT[Container Runtime] -->|9902/TCP<br/>HTTP| HealthProbe
    ContainerRT -->|9902/TCP<br/>HTTP| AdminEndpoints

    %% External dependencies
    Bootstrap -->|delegates to| Pingora["Pingora Engine<br/>(quixotic-plecostomus)<br/>0.11.0"]
    CryptoProvider -->|delegates crypto| OpenSSL["System OpenSSL<br/>libcrypto.so"]
    AccessLog -.->|optional| OTLP["OTLP Collector"]

    %% Styling
    style Praxis fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Server fill:#d5e8d4,stroke:#82b366
    style Protocol fill:#dae8fc,stroke:#6c8ebf
    style Filter fill:#fff2cc,stroke:#d6b656
    style Core fill:#f8cecc,stroke:#b85450
    style TLS fill:#e1d5e7,stroke:#9673a6
    style Client fill:#f5f5f5,stroke:#666
    style Upstream fill:#f5f5f5,stroke:#666
    style ContainerRT fill:#f5f5f5,stroke:#666
    style Pingora fill:#d5e8d4,stroke:#82b366
    style OpenSSL fill:#e1d5e7,stroke:#9673a6
    style OTLP fill:#f5f5f5,stroke:#666
