graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        Gateway["data-science-gateway<br/>443/TCP → 8443/TCP<br/>TLS<br/>Kuadrant AuthPolicy"]
        Authorino["Kuadrant/Authorino<br/>API key + TokenReview + OIDC JWT<br/>Strips Authorization header"]
    end

    subgraph TenantNS["PER-TENANT NAMESPACE (Isolated)"]
        direction TB
        MaaSAPI["maas-api<br/>SA: maas-api<br/>8080/TCP HTTP, 9090/TCP HTTPS<br/>NetworkPolicy: default-deny + explicit allows"]
    end

    subgraph InfraNS["INFRASTRUCTURE NAMESPACE"]
        direction TB
        MaaSController["maas-controller<br/>SA: maas-controller-manager<br/>8081/TCP health, 9443/TCP webhook<br/>TLS"]
        MaaSDiscovery["maas-discovery<br/>8443/TCP"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Configurable encryption<br/>Secret: maas-db-config"]
        Limitador["Kuadrant/Limitador<br/>TokenRateLimitPolicy"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        KServe["KServe LLMInferenceService<br/>(conditional)"]
        InferenceProviders["External Inference Providers<br/>443/TCP HTTPS<br/>API key / SigV4 / OAuth2"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS<br/>API key / JWT / Bearer"| Gateway
    Gateway -->|"AuthPolicy evaluation"| Authorino
    Authorino -->|"HTTP/8080<br/>No auth (NetworkPolicy)<br/>/internal/v1/api-keys/validate"| MaaSAPI
    Gateway -->|"HTTP/8080<br/>Header stripped<br/>Via NetworkPolicy"| MaaSAPI
    Gateway -->|"HTTPS<br/>Per-model credentials"| KServe
    Gateway -->|"HTTPS/443<br/>Per-provider auth"| InferenceProviders

    MaaSAPI -->|"TCP/5432<br/>Secret auth"| PostgreSQL
    MaaSAPI -->|"HTTPS/6443<br/>SA token<br/>TokenReview, SAR"| K8sAPI
    MaaSAPI -->|"OTLP/gRPC"| OTel

    MaaSController -->|"HTTPS/6443<br/>SA token<br/>CRD reconciliation"| K8sAPI
    MaaSController -->|"Deploys per-tenant"| MaaSAPI

    MaaSDiscovery -->|"HTTPS/6443<br/>Tenant enumeration"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef infra fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway,Authorino ingress
    class MaaSAPI tenant
    class MaaSController,MaaSDiscovery infra
    class K8sAPI,PostgreSQL,Limitador platform
    class KServe,InferenceProviders,OTel externalservice
