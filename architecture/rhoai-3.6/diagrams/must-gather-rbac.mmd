graph TD
    subgraph Framework["OpenShift Framework (OCP)"]
        direction TB
        OCAdm["oc adm must-gather<br/>(framework-managed RBAC)"]
        OCAdm -->|"provides cluster-wide<br/>read access automatically"| FrameworkRBAC["Framework-Provided<br/>ClusterRole"]
    end

    subgraph ManualSetup["Manual Setup (xKS: AKS/EKS/CKS)"]
        direction TB

        subgraph ServiceAccounts["Service Account"]
            SA["must-gather-sa<br/>Namespace: must-gather"]
        end

        subgraph Bindings["ClusterRole Binding"]
            CRB["must-gather-reader-binding<br/>Scope: cluster-wide"]
        end

        subgraph Roles["ClusterRole"]
            CR["must-gather-reader"]
        end

        subgraph Permissions["API Resources (Read-Only)"]
            direction LR
            AllGroups["API Groups: *<br/>(all groups)"]
            AllResources["Resources: *<br/>(all resources)"]
            ReadVerbs["Verbs:<br/>get, list, watch"]
        end

        SA -->|"bound via"| CRB
        CRB -->|"grants"| CR
        CR -->|"allows"| AllGroups
        CR -->|"allows"| AllResources
        CR -->|"operations"| ReadVerbs
    end

    subgraph SecretsAccess["Secrets"]
        PullSecret["redhat-pull-secret<br/>Type: dockerconfigjson<br/>Purpose: Pull image from<br/>registry.redhat.io<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    subgraph AuthFlow["Authentication Flow"]
        direction LR
        SAToken["ServiceAccount Token<br/>(auto-mounted)"]
        TokenReview["Kubernetes TokenReview<br/>(API server validates)"]
        RBACCheck["RBAC Authorization<br/>(must-gather-reader)"]

        SAToken -->|"presented to"| TokenReview
        TokenReview -->|"authorized via"| RBACCheck
    end

    SA -.->|"uses"| SAToken
    SA -.->|"references"| PullSecret

    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#f5a623,color:#fff
    style AllGroups fill:#7ed321,color:#fff
    style AllResources fill:#7ed321,color:#fff
    style ReadVerbs fill:#7ed321,color:#fff
    style OCAdm fill:#9b59b6,color:#fff
    style FrameworkRBAC fill:#9b59b6,color:#fff
    style PullSecret fill:#e74c3c,color:#fff
    style SAToken fill:#3498db,color:#fff
    style TokenReview fill:#3498db,color:#fff
    style RBACCheck fill:#3498db,color:#fff
