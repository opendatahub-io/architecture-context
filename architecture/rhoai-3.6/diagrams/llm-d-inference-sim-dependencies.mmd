graph LR
    Sim["llm-d-inference-sim<br/>Go Service"]

    %% Internal Platform Dependencies
    Sim -->|"Go library (kvevents)<br/>ZMQ event types"| Router["llm-d-router<br/>v0.11.0"]

    %% Core Runtime Dependencies
    Sim -->|"HTTP server"| FastHTTP["fasthttp<br/>v1.75.0"]
    Sim -->|"HTTP routing"| FastRouter["fasthttprouter<br/>v0.1.1"]
    Sim -->|"TCP multiplexing<br/>HTTP + gRPC"| CMux["cmux<br/>v0.1.5"]
    Sim -->|"gRPC server"| GRPC["grpc-go<br/>v1.83.2"]
    Sim -->|"protobuf"| Protobuf["protobuf<br/>v1.36.12"]

    %% Event & Data Dependencies
    Sim -->|"KV-cache events"| ZMQ["go-zeromq/zmq4<br/>v0.17.0"]
    Sim -->|"event serialization"| MsgPack["msgpack/v5<br/>v5.4.1"]
    Sim -->|"dataset storage"| SQLite["go-sqlite3<br/>v0.35.6"]

    %% Observability Dependencies
    Sim -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.24.1"]
    Sim -->|"structured logging"| Logr["go-logr/logr<br/>v1.4.4"]
    Sim -->|"k8s logging"| Klog["klog/v2<br/>v2.140.0"]

    %% Infrastructure Dependencies
    Sim -->|"TLS cert reload"| FSNotify["fsnotify<br/>v1.10.1"]
    Sim -->|"schema validation"| JSONSchema["jsonschema/v5<br/>v5.3.1"]
    Sim -->|"API types"| OpenAIGo["openai-go/v3<br/>v3.71.1"]

    %% Sidecar Integration
    Sim -.->|"HTTP localhost:8082<br/>(optional)"| VLLMRender["vllm-render<br/>(sidecar)"]

    %% External Service Integration
    Sim -.->|"HTTP scrape :8000/metrics"| Prometheus["Prometheus"]

    %% Consumer Integration
    Router -.->|"ZMQ SUB"| Sim

    %% Styling
    style Sim fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Router fill:#7ed321,stroke:#333
    style FastHTTP fill:#999,stroke:#333
    style FastRouter fill:#999,stroke:#333
    style CMux fill:#999,stroke:#333
    style GRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style ZMQ fill:#999,stroke:#333
    style MsgPack fill:#999,stroke:#333
    style SQLite fill:#999,stroke:#333
    style PromClient fill:#999,stroke:#333
    style Logr fill:#999,stroke:#333
    style Klog fill:#999,stroke:#333
    style FSNotify fill:#999,stroke:#333
    style JSONSchema fill:#999,stroke:#333
    style OpenAIGo fill:#999,stroke:#333
    style VLLMRender fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
