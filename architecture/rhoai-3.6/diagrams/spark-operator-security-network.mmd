graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI Pipeline"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(redhat-ods-applications)"]
        direction TB

        subgraph WebhookDeploy["Webhook Deployment"]
            WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443 → 9443/TCP<br/>HTTPS/TLS<br/>SA: spark-operator-webhook"]
        end

        subgraph ControllerDeploy["Controller Deployment"]
            ControllerPod["spark-operator-controller<br/>8080/TCP metrics, 8081/TCP health<br/>SA: spark-operator-controller"]
        end

        subgraph ModuleDeploy["Module Controller Deployment"]
            ModuleCtrl["spark-operator-module-controller<br/>8081/TCP health<br/>SA: spark-operator-module-controller-manager<br/>Privileges: bind, escalate"]
        end
    end

    subgraph TenantNS["TENANT NAMESPACES (user workloads)"]
        direction TB

        DriverPod["Spark Driver Pod<br/>SA: spark-operator-spark<br/>7078/TCP RPC, 7079/TCP BlockMgr<br/>4040/TCP Spark UI<br/>No encryption"]
        ExecutorPods["Spark Executor Pods<br/>7079/TCP BlockMgr<br/>No encryption"]
        ConnectPod["SparkConnect Session<br/>15002/TCP gRPC<br/>No encryption"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io<br/>6443/TCP HTTPS<br/>TLS Profile Config"]
        CertManager["cert-manager<br/>Certificate + Issuer CRs"]
        Prometheus["prometheus-operator<br/>PodMonitor<br/>Scrapes 8080/TCP"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% Admission webhook flow
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>Kubernetes admission<br/>FailurePolicy: Fail"| WebhookSvc
    WebhookSvc -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>ResourceQuota check"| K8sAPI

    %% Controller flows
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CRD reconciliation"| K8sAPI
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OpenShiftAPI

    %% Module controller flows
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Deploy operator resources"| K8sAPI

    %% Spark runtime
    K8sAPI -->|"Pod scheduling"| DriverPod
    DriverPod -->|"TCP/7078-7079<br/>No encryption"| ExecutorPods

    %% Platform integrations
    ControllerPod -.->|"CRD CRUD"| CertManager
    ControllerPod -.->|"PodMonitor"| Prometheus
    Prometheus -.->|"HTTP/8080<br/>NetworkPolicy:<br/>monitoring NS only"| ControllerPod

    %% Cross-namespace SparkConnect
    ConnectPod -.->|"gRPC/15002<br/>Cross-NS access:<br/>dashboard-labeled NS"| TenantNS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class WebhookSvc,ControllerPod,ModuleCtrl operator
    class DriverPod,ExecutorPods,ConnectPod tenant
    class OpenShiftAPI,CertManager,Prometheus platform
