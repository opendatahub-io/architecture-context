graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph KustomizePath["Kustomize Path"]
            Components["Kustomize Components<br/>(14 operator definitions)"]
            Dependencies["Kustomize Dependencies<br/>(composed overlays)"]
            Configurations["Kustomize Configurations<br/>(post-install CRs)"]
            Components --> Dependencies
            Dependencies --> Configurations
        end

        subgraph HelmPath["Helm Path"]
            OCPChart["rhai-on-openshift-chart<br/>(OLM-based)"]
            XKSChart["rhai-on-xks-chart<br/>(non-OLM)"]
            DepCharts["Dependency Sub-Charts<br/>(cert-manager, Gateway API,<br/>LWS, RHCL, SAIL)"]
            OCPChart --> DepCharts
            XKSChart --> DepCharts
        end

        Scripts["Shell Scripts<br/>(validation, TLS prep)"]
        Tekton["Tekton Pipeline<br/>(cluster validation)"]
    end

    Admin["Administrator"] -->|"kubectl apply / ArgoCD"| KustomizePath
    Admin -->|"helm install"| HelmPath
    Tekton -->|validates| KustomizePath
    Tekton -->|validates| HelmPath

    subgraph TriState["Tri-State Resolution"]
        Auto["auto (default)"]
        True["true (force enable)"]
        False["false (force disable)"]
    end

    OCPChart -->|uses| TriState
    XKSChart -->|uses| TriState

    subgraph Profiles["Deployment Profiles"]
        Default["default<br/>(all Removed)"]
        RHAII["rhaii<br/>(inference-only)"]
        MaaS["maas<br/>(Models-as-a-Service)"]
    end

    OCPChart -->|selects| Profiles

    subgraph Targets["Deployment Targets"]
        OCP["OpenShift (OCP)<br/>OLM Subscriptions"]
        AWS["AWS Kubernetes"]
        Azure["Azure Kubernetes"]
        CoreWeave["CoreWeave"]
    end

    KustomizePath -->|deploys to| OCP
    OCPChart -->|deploys to| OCP
    XKSChart -->|deploys to| AWS
    XKSChart -->|deploys to| Azure
    XKSChart -->|deploys to| CoreWeave

    style Components fill:#4a90e2,color:#fff
    style Dependencies fill:#4a90e2,color:#fff
    style Configurations fill:#4a90e2,color:#fff
    style OCPChart fill:#7ed321,color:#fff
    style XKSChart fill:#7ed321,color:#fff
    style DepCharts fill:#7ed321,color:#fff
    style Scripts fill:#f5a623,color:#fff
    style Tekton fill:#f5a623,color:#fff
    style Admin fill:#e8e8e8,stroke:#333
    style OCP fill:#cc0000,color:#fff
    style AWS fill:#ff9900,color:#fff
    style Azure fill:#0078d4,color:#fff
    style CoreWeave fill:#6b4fbb,color:#fff
