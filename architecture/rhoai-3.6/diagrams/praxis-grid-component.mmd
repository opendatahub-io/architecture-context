graph TB
    subgraph GridOperator["AGN Operator (grid-system)"]
        direction TB
        Controllers["Kubernetes Controllers<br/>GridNetwork, GridSite,<br/>InferenceProvider, AgentToolProvider"]
        SwimRuntime["SWIM Runtime<br/>foca + AES-256-GCM"]
        ScoringEngine["Scoring Engine<br/>noMetrics / queueDepth / kvCachePressure"]
        OverlayWriter["Overlay Writer<br/>Content-addressed ConfigMap"]
        Controllers --> ScoringEngine
        SwimRuntime --> Controllers
        ScoringEngine --> OverlayWriter
    end

    subgraph EnrollmentService["Enrollment Service (optional)"]
        EnrollAPI["Enrollment API<br/>8443/TCP HTTPS"]
        BootstrapJob["Bootstrap Job<br/>CA + Secret provisioning"]
        EnrollDB["PostgreSQL Client<br/>sqlx"]
    end

    subgraph OverlaySyncSidecar["Overlay-Sync Sidecar"]
        ConfigMapWatch["ConfigMap Watcher<br/>Kubernetes API"]
        FileWriter["Atomic File Writer<br/>emptyDir volume"]
    end

    subgraph Libraries["Shared Libraries"]
        CertsLib["certs<br/>rcgen / OpenSSL"]
        SwimLib["swim<br/>foca + AES-256-GCM"]
        CRDTLib["crdt<br/>LWW, OR-Set, G-Counter"]
        SignalsLib["signals + signals-client<br/>mTLS scrape transport"]
        ScoringLib["scoring<br/>Strategy engine"]
    end

    subgraph OptionalComponents["Optional Components"]
        FleetDash["Fleet Dashboard<br/>Axum + React"]
        GridGateway["Grid Gateway<br/>Praxis-based data plane"]
    end

    %% CRD interactions
    User[Platform Admin] -->|creates| GridNetworkCR["GridNetwork CR<br/>(Cluster-scoped)"]
    User -->|creates| InferenceProviderCR["InferenceProvider CR<br/>(Cluster-scoped)"]
    User -->|creates| AgentToolProviderCR["AgentToolProvider CR<br/>(Cluster-scoped)"]
    GridNetworkCR -->|watched by| Controllers
    InferenceProviderCR -->|watched by| Controllers
    AgentToolProviderCR -->|watched by| Controllers

    %% Cross-site
    PeerOperator["Peer Site Operator<br/>7946/UDP"] <-->|SWIM gossip<br/>AES-256-GCM| SwimRuntime
    PeerSignals["Peer Signals<br/>9091/TCP"] <-->|mTLS poll| SignalsLib

    %% Overlay flow
    OverlayWriter -->|writes| OverlayCM["Routing Overlay ConfigMap"]
    OverlayCM -->|watched by| ConfigMapWatch
    ConfigMapWatch --> FileWriter
    FileWriter -->|hot-reload| PraxisGW["Praxis AI Gateway"]

    %% Enrollment
    NewSite["New Site"] -->|enrollment token| EnrollAPI
    EnrollAPI --> EnrollDB
    EnrollAPI -->|writes identity Secret| K8sAPI["Kubernetes API"]

    %% Library usage
    Controllers -.-> CertsLib
    Controllers -.-> CRDTLib
    Controllers -.-> ScoringLib
    SwimRuntime -.-> SwimLib

    %% Styling
    style Controllers fill:#4a90e2,color:#fff
    style SwimRuntime fill:#4a90e2,color:#fff
    style ScoringEngine fill:#4a90e2,color:#fff
    style OverlayWriter fill:#4a90e2,color:#fff
    style EnrollAPI fill:#7ed321,color:#fff
    style ConfigMapWatch fill:#9b59b6,color:#fff
    style FileWriter fill:#9b59b6,color:#fff
    style GridNetworkCR fill:#f5a623,color:#fff
    style InferenceProviderCR fill:#f5a623,color:#fff
    style AgentToolProviderCR fill:#f5a623,color:#fff
    style PeerOperator fill:#e8e8e8
    style PeerSignals fill:#e8e8e8
    style PraxisGW fill:#7ed321,color:#fff
    style FleetDash fill:#ccc
    style GridGateway fill:#ccc
