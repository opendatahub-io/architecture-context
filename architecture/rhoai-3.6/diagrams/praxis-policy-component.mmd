graph TB
    subgraph Host["Host Application (e.g., Praxis Proxy)"]
        direction TB

        subgraph Facade["praxis-policy (Facade Crate)"]
            InstallBuiltins["install_builtins()"]
        end

        subgraph Runtime["PPE Runtime Stack"]
            direction TB
            Core["ppe-core<br/>PolicyEngine / Executor"]
            APLRuntime["ppe-apl-runtime<br/>Per-hook PluginInvokers"]
            APLCMF["ppe-apl-cmf<br/>Extension ↔ AttributeBag Bridge"]
            APLCore["ppe-apl-core<br/>APL Compiler & Evaluator"]
            Orchestration["ppe-orchestration<br/>Async Concurrency Primitives"]

            Core --> APLRuntime
            APLRuntime --> APLCMF
            APLCMF --> APLCore
            Core --> Orchestration
        end

        subgraph Builtins["praxis-policy-builtins (Feature-Gated)"]
            direction TB

            subgraph Identity["Identity Resolution"]
                JWT["JWT Resolver<br/>(RS/ES/EdDSA/HS)"]
                APIKey["API-Key Resolver<br/>(SHA-256 indexed)"]
            end

            subgraph PDPs["Policy Decision Points"]
                Cedar["Cedar v4"]
                CEL["CEL v0.14"]
                OPA["OPA/Rego<br/>(regorus, restricted)"]
            end

            subgraph Delegation["Credential Exchange"]
                OAuth["OAuth Delegation<br/>(RFC 8693)"]
            end

            subgraph Elicitation["Human Approval"]
                CIBA["CIBA Elicitation"]
            end

            subgraph SessionStore["Session State"]
                Valkey["Valkey Session Store"]
            end

            subgraph Secrets["Secret Management"]
                VaultProvider["Vault KV v2 Provider"]
            end
        end

        subgraph Pipeline["Five-Phase Execution Pipeline"]
            P1["1. Sequential"]
            P2["2. Transform"]
            P3["3. Audit"]
            P4["4. Concurrent"]
            P5["5. Fire-and-Forget"]
            P1 --> P2 --> P3 --> P4 --> P5
        end

        subgraph CapFilter["Capability-Based Filtering"]
            Filter["Extension Filter<br/>Plugins see only declared capabilities"]
        end

        subgraph Transport["HTTP Transport"]
            HyperTransport["HyperTransport<br/>rustls + ring<br/>Egress deny table"]
        end

        Facade --> Core
        Facade --> Builtins
        Core --> Pipeline
        Core --> CapFilter
        Core --> Transport
    end

    subgraph RefPlugins["Reference Plugins (Unbundled)"]
        AuditLogger["Audit Logger"]
        PIIScanner["PII Scanner"]
    end

    subgraph TestBench["Test & Bench"]
        PDPDiff["PDP Differential Tests"]
        Benches["Criterion Benchmarks"]
    end

    %% Styling
    style Facade fill:#4a90e2,stroke:#333,color:#fff
    style Core fill:#4a90e2,stroke:#333,color:#fff
    style APLRuntime fill:#5ba3f5,stroke:#333,color:#fff
    style APLCMF fill:#5ba3f5,stroke:#333,color:#fff
    style APLCore fill:#5ba3f5,stroke:#333,color:#fff
    style Orchestration fill:#5ba3f5,stroke:#333,color:#fff
    style JWT fill:#7ed321,stroke:#333
    style APIKey fill:#7ed321,stroke:#333
    style Cedar fill:#f5a623,stroke:#333
    style CEL fill:#f5a623,stroke:#333
    style OPA fill:#f5a623,stroke:#333
    style OAuth fill:#9b59b6,stroke:#333,color:#fff
    style CIBA fill:#9b59b6,stroke:#333,color:#fff
    style Valkey fill:#e74c3c,stroke:#333,color:#fff
    style VaultProvider fill:#e74c3c,stroke:#333,color:#fff
    style Filter fill:#f39c12,stroke:#333
    style HyperTransport fill:#2c3e50,stroke:#333,color:#fff
    style AuditLogger fill:#bdc3c7,stroke:#333
    style PIIScanner fill:#bdc3c7,stroke:#333
    style PDPDiff fill:#bdc3c7,stroke:#333
    style Benches fill:#bdc3c7,stroke:#333
