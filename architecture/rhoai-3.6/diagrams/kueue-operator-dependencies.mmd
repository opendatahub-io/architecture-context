graph LR
    KueueOp["Kueue Operator<br/>(openshift-kueue-operator)"]

    %% Hard External Dependencies
    KueueOp -->|"TLS certs<br/>(hard prerequisite)"| CertManager["cert-manager"]
    KueueOp -->|"resource mgmt<br/>6443/TCP"| K8sAPI["Kubernetes API"]

    %% Build Dependencies
    KueueOp -->|"operator framework"| LibraryGo["library-go<br/>(OpenShift)"]
    KueueOp -->|"controller runtime"| CtrlRuntime["controller-runtime<br/>v0.20.4"]
    KueueOp -->|"upstream types"| KueueUpstream["sigs.k8s.io/kueue<br/>v0.10.2"]

    %% Monitoring (optional)
    KueueOp -.->|"ServiceMonitor<br/>(optional)"| PrometheusOp["prometheus-operator<br/>v0.74.0"]

    %% Workload Framework Integrations (CRD watch)
    subgraph Integrations["Workload Framework Integrations"]
        direction TB
        KubeflowTraining["Kubeflow Training Operator<br/>(PyTorchJob, MPIJob, TFJob,<br/>PaddleJob, XGBoostJob)"]
        KubeRay["KubeRay<br/>(RayCluster, RayJob)"]
        CodeFlare["CodeFlare<br/>(AppWrapper)"]
        JobSet["JobSet Controller<br/>(JobSet)"]
        LWS["LeaderWorkerSet Controller<br/>(LeaderWorkerSet)"]
    end

    KueueOp -->|"webhook intercept<br/>+ CRD watch"| KubeflowTraining
    KueueOp -->|"webhook intercept<br/>+ CRD watch"| KubeRay
    KueueOp -->|"webhook intercept<br/>+ CRD watch"| CodeFlare
    KueueOp -->|"webhook intercept<br/>+ CRD watch"| JobSet
    KueueOp -->|"webhook intercept<br/>+ CRD watch"| LWS

    %% Kubernetes built-in workloads
    KueueOp -->|"webhook intercept"| BatchJobs["Kubernetes Batch Jobs"]
    KueueOp -->|"webhook intercept"| Pods["Pods / Deployments /<br/>StatefulSets"]

    %% Styling
    style KueueOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style CertManager fill:#e74c3c,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style LibraryGo fill:#999,stroke:#333,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style KueueUpstream fill:#999,stroke:#333,color:#fff
    style PrometheusOp fill:#999,stroke:#333,color:#fff
    style KubeflowTraining fill:#7ed321,stroke:#333,color:#fff
    style KubeRay fill:#7ed321,stroke:#333,color:#fff
    style CodeFlare fill:#7ed321,stroke:#333,color:#fff
    style JobSet fill:#7ed321,stroke:#333,color:#fff
    style LWS fill:#7ed321,stroke:#333,color:#fff
    style BatchJobs fill:#f5a623,stroke:#333
    style Pods fill:#f5a623,stroke:#333
