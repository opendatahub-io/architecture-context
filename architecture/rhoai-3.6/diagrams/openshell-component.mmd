graph TB
    subgraph OpenShell["OpenShell Platform"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            Gateway["openshell-gateway<br/>(axum + tonic)<br/>gRPC/HTTP control plane<br/>Port 8080/TCP"]
            Server["openshell-server<br/>(shared framework)<br/>gRPC/HTTP multiplex, auth, metrics"]
            Core["openshell-core<br/>Common types, config, protobuf"]
            Interceptors["openshell-gateway-interceptors<br/>Request interceptor framework"]
            Gateway --> Server
            Gateway --> Core
            Gateway --> Interceptors
        end

        subgraph PolicyEngine["Policy Engine"]
            Policy["openshell-policy<br/>Sandbox policy parsing & defaults"]
            PolicySchema["openshell-policy-schema<br/>Canonical YAML/JSON schema"]
            Prover["openshell-prover<br/>Z3 SMT solver verification"]
            ProverCLI["openshell-prover-cli<br/>Standalone boundary checker"]
            Prover --> Policy
            ProverCLI --> Prover
            Policy --> PolicySchema
        end

        subgraph RuntimeLayer["Sandbox Runtime"]
            Supervisor["openshell-supervisor<br/>Policy evaluation, credential injection<br/>L7 network enforcement<br/>Port 5500/TCP"]
            Sandbox["openshell-sandbox<br/>Static binary, seccomp-mediated I/O<br/>Process monitoring<br/>Port 2222/TCP SSH"]
            SupervisorNet["openshell-supervisor-network<br/>Network proxy, OPA, AWS SigV4"]
            SupervisorProc["openshell-supervisor-process<br/>Process lifecycle, bypass detection"]
            Middleware["openshell-supervisor-middleware<br/>Middleware chain execution"]
            SandboxBackend["openshell-sandbox-backend<br/>OpenShell Sandbox Protocol"]
            IsolationIface["openshell-isolation-interface<br/>IsolationBackend trait"]
            Supervisor --> SupervisorNet
            Supervisor --> SupervisorProc
            Supervisor --> Middleware
            Supervisor --> SandboxBackend
            SandboxBackend --> IsolationIface
            Supervisor -->|"gRPC (mTLS)"| Sandbox
        end

        subgraph Drivers["Compute & Credential Drivers"]
            direction LR
            K8sDriver["openshell-driver-kubernetes<br/>Kubernetes ComputeDriver"]
            DockerDriver["openshell-driver-docker<br/>Docker ComputeDriver"]
            PodmanDriver["openshell-driver-podman<br/>Podman ComputeDriver"]
            VMDriver["openshell-driver-vm<br/>MicroVM (libkrun)"]
            K8sSecrets["openshell-driver-kubernetes-secrets<br/>K8s CredentialDriver"]
            VaultDriver["openshell-driver-vault<br/>Vault CredentialDriver"]
            DBCredStore["openshell-driver-db-credstore<br/>DB CredentialDriver"]
        end

        subgraph ClientTools["Client Tools"]
            CLI["openshell-cli<br/>User-facing CLI"]
            TUI["openshell-tui<br/>Ratatui dashboard"]
            RustSDK["openshell-sdk<br/>Rust async client"]
        end

        Gateway -->|"UDS gRPC"| K8sDriver
        Gateway -->|"UDS gRPC"| DockerDriver
        Gateway -->|"UDS gRPC"| PodmanDriver
        Gateway -->|"UDS gRPC"| VMDriver
        Gateway -->|"UDS gRPC"| K8sSecrets
        Gateway -->|"UDS gRPC"| VaultDriver
        Gateway -->|"UDS gRPC"| DBCredStore
        Gateway --> Policy
        Gateway -->|"gRPC/mTLS"| Supervisor
    end

    %% External SDKs
    PythonSDK["openshell (Python SDK)<br/>gRPC bindings"]
    GoSDK["sdk/go<br/>Go gRPC client"]
    TSSDK["sdk/typescript<br/>TypeScript Connect client"]

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>443/TCP"]
    SandboxCRD["Sandbox CR<br/>agents.x-k8s.io/v1"]
    OIDCProvider["OIDC Provider<br/>443/TCP"]

    %% Client connections
    CLI -->|"gRPC"| Gateway
    TUI -->|"gRPC"| Gateway
    RustSDK -->|"gRPC"| Gateway
    PythonSDK -->|"gRPC"| Gateway
    GoSDK -->|"gRPC"| Gateway
    TSSDK -->|"gRPC"| Gateway

    %% External connections
    K8sDriver -->|"HTTPS"| K8sAPI
    K8sDriver -->|"watches"| SandboxCRD
    Gateway -->|"OIDC"| OIDCProvider

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,color:#fff
    style Supervisor fill:#4a90e2,stroke:#333,color:#fff
    style Sandbox fill:#4a90e2,stroke:#333,color:#fff
    style Prover fill:#9b59b6,stroke:#333,color:#fff
    style CLI fill:#2ecc71,stroke:#333,color:#fff
    style TUI fill:#2ecc71,stroke:#333,color:#fff
    style K8sDriver fill:#e67e22,stroke:#333,color:#fff
    style K8sAPI fill:#95a5a6,stroke:#333,color:#fff
    style SandboxCRD fill:#f5a623,stroke:#333
    style OIDCProvider fill:#95a5a6,stroke:#333,color:#fff
    style PythonSDK fill:#3498db,stroke:#333,color:#fff
    style GoSDK fill:#3498db,stroke:#333,color:#fff
    style TSSDK fill:#3498db,stroke:#333,color:#fff
