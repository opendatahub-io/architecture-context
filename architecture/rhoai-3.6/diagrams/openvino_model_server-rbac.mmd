graph TD
    subgraph Note["RBAC Not Managed by OVMS"]
        direction TB
        Info["OpenVINO Model Server does not define<br/>Kubernetes RBAC resources.<br/>RBAC is managed by KServe and the RHOAI platform."]
    end

    subgraph KServeManaged["KServe-Managed RBAC (External)"]
        direction TB
        KServeCtrl["KServe Controller<br/>ServiceAccount"]
        KServeCRB["ClusterRoleBinding"]
        KServeCR["ClusterRole:<br/>kserve-manager-role"]
    end

    subgraph Resources["Resources Managed"]
        SR["serving.kserve.io<br/>ServingRuntime"]
        CSR["serving.kserve.io<br/>ClusterServingRuntime"]
        IS["serving.kserve.io<br/>InferenceService"]
    end

    subgraph AppLevelAuth["Application-Level Auth (OVMS)"]
        direction TB
        V3Auth["V3 Endpoints (/v3/v1/*)<br/>Bearer API key (optional)<br/>Enforcement: HttpRestApiHandler"]
        V2NoAuth["V2 Endpoints (/v2/*)<br/>No application auth<br/>Relies on network controls"]
        V1NoAuth["V1 Endpoints (/v1/*)<br/>No application auth<br/>Relies on network controls"]
        MetricsNoAuth["/metrics<br/>No auth<br/>Relies on network controls"]
    end

    subgraph NetworkAuth["Network-Level Auth (Istio)"]
        IstioMTLS["Istio mTLS<br/>(service mesh)"]
        IstioAuthZ["Istio AuthorizationPolicy<br/>(platform-managed)"]
    end

    KServeCtrl -->|bound via| KServeCRB
    KServeCRB -->|grants| KServeCR
    KServeCR -->|"get,list,watch,create,<br/>update,patch,delete"| SR
    KServeCR -->|"get,list,watch,create,<br/>update,patch,delete"| CSR
    KServeCR -->|"get,list,watch,create,<br/>update,patch,delete"| IS

    IstioMTLS -->|protects| V2NoAuth
    IstioMTLS -->|protects| V1NoAuth
    IstioAuthZ -->|controls access| V2NoAuth
    IstioAuthZ -->|controls access| V1NoAuth

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style Info fill:#fff3cd,stroke:#ffc107
    style KServeCtrl fill:#4a90e2,color:#fff
    style KServeCR fill:#f5a623
    style KServeCRB fill:#ddd
    style SR fill:#7ed321
    style CSR fill:#7ed321
    style IS fill:#7ed321
    style V3Auth fill:#e74c3c,color:#fff
    style V2NoAuth fill:#f39c12,color:#fff
    style V1NoAuth fill:#f39c12,color:#fff
    style MetricsNoAuth fill:#f39c12,color:#fff
    style IstioMTLS fill:#9b59b6,color:#fff
    style IstioAuthZ fill:#9b59b6,color:#fff
