graph TD
    subgraph "Service Accounts"
        PipelineSA["KFP Pipeline Run SA<br/>(configured by DSPO)"]
    end

    subgraph "Required Permissions (Runtime)"
        direction TB
        Note["No RBAC roles defined in manifests.<br/>Components rely on KFP task pod SA permissions.<br/>Permissions granted by KFP/DSPO at pipeline run time."]
    end

    subgraph "API Resources Accessed"
        direction TB
        ServingRuntime["serving.kserve.io<br/>ServingRuntime"]
        InferenceService["serving.kserve.io<br/>InferenceService"]
        HWProfile["dashboard.opendatahub.io<br/>HardwareProfile"]
        Pods["core<br/>Pods"]
        Secrets["core<br/>Secrets"]
    end

    subgraph "Operations Performed"
        direction TB
        CreatePatch["create, patch, delete<br/>(ServingRuntime, InferenceService)"]
        ReadOps["get, list<br/>(HardwareProfile, Pods)"]
        SecretRead["get<br/>(Secrets for credentials)"]
    end

    subgraph "Secret Access"
        direction TB
        HFToken["HF_TOKEN<br/>(HuggingFace auth)"]
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>(S3/MinIO auth)"]
        S3Key["S3_SECRET_KEY<br/>(S3 auth)"]
        LLMKey["LLM_API_KEY<br/>(LLM service auth)"]
        K8sAuth["KUBERNETES_AUTH_TOKEN<br/>(K8s API auth)"]
        OCIPull["OCI_PULL_SECRET_MODEL_DOWNLOAD<br/>(OCI registry auth)"]
        EvalHubToken["evalhub_auth_token<br/>(Eval Hub API auth)"]
    end

    PipelineSA -->|needs| CreatePatch
    PipelineSA -->|needs| ReadOps
    PipelineSA -->|needs| SecretRead

    CreatePatch -->|on| ServingRuntime
    CreatePatch -->|on| InferenceService
    ReadOps -->|on| HWProfile
    ReadOps -->|on| Pods
    SecretRead -->|mounts| Secrets

    Secrets -->|provides| HFToken
    Secrets -->|provides| AWSKey
    Secrets -->|provides| S3Key
    Secrets -->|provides| LLMKey
    Secrets -->|provides| K8sAuth
    Secrets -->|provides| OCIPull
    Secrets -->|provides| EvalHubToken

    style PipelineSA fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style ServingRuntime fill:#7ed321,stroke:#333,color:#fff
    style InferenceService fill:#7ed321,stroke:#333,color:#fff
    style HWProfile fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style Secrets fill:#f5a623,stroke:#333,color:#fff
    style CreatePatch fill:#dae8fc,stroke:#6c8ebf
    style ReadOps fill:#dae8fc,stroke:#6c8ebf
    style SecretRead fill:#dae8fc,stroke:#6c8ebf
    style HFToken fill:#f8cecc,stroke:#b85450
    style AWSKey fill:#f8cecc,stroke:#b85450
    style S3Key fill:#f8cecc,stroke:#b85450
    style LLMKey fill:#f8cecc,stroke:#b85450
    style K8sAuth fill:#f8cecc,stroke:#b85450
    style OCIPull fill:#f8cecc,stroke:#b85450
    style EvalHubToken fill:#f8cecc,stroke:#b85450
