graph LR
    FMO["feast-module-operator<br/>Go Operator"]

    %% Internal ODH/RHOAI Dependencies (Go Libraries)
    FMO -->|"reconciler framework,<br/>action pipeline"| ODHOperatorLib["opendatahub-operator/v2<br/>(Go library)"]
    FMO -->|"platform detection,<br/>cache optimization"| PlatformUtils["odh-platform-utilities<br/>(Go library)"]

    %% External Go Dependencies
    FMO -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    FMO -->|"CLI framework"| Cobra["cobra v1.10.2"]
    FMO -->|"configuration"| Viper["viper v1.21.0"]
    FMO -->|"version parsing"| Semver["semver v4.0.0"]
    FMO -->|"K8s types"| K8sAPI["k8s.io/api<br/>v0.36.1"]
    FMO -->|"K8s client"| K8sClient["k8s.io/client-go<br/>v0.36.1"]

    %% Platform Integration Points (CRD interactions)
    FMO -->|"deploys & manages"| FeastOperator["feast-operator<br/>(feast.dev)"]
    FMO -->|"creates ServiceMonitor"| PromOperator["prometheus-operator<br/>(monitoring.coreos.com)"]

    %% Delegated RBAC Dependencies
    FeastOperator -->|"CRUD"| FeatureStore["Feast FeatureStore<br/>(feast.dev)"]
    FeastOperator -->|"watch"| Notebooks["Kubeflow Notebooks<br/>(kubeflow.org)"]
    FeastOperator -->|"watch"| MLflow["MLflow<br/>(mlflow.opendatahub.io)"]
    FeastOperator -->|"CRUD"| Routes["OpenShift Routes<br/>(route.openshift.io)"]
    FeastOperator -->|"CRUD"| Spark["Spark Applications<br/>(sparkoperator.k8s.io)"]

    %% Upstream Integration
    ODHOperator["ODH Operator"] -->|"Helm deploy +<br/>FeastOperator CR"| FMO

    %% Infrastructure
    FMO -->|"API server"| K8sAPIServer["Kubernetes API<br/>6443/TCP"]
    FMO -->|"reads cluster config"| OSAPIServer["OpenShift API Server<br/>(config.openshift.io)"]

