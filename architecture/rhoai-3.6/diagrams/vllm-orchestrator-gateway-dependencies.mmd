graph LR
    Gateway["vllm-orchestrator-gateway<br/>(Rust Service)"]

    %% Internal Platform Dependencies
    Gateway -->|"REST POST<br/>/api/v2/chat/completions-detection<br/>HTTP/HTTPS 8085/TCP<br/>Optional mTLS"| Orchestrator["FMS Guardrails<br/>Orchestrator"]
    Gateway -.->|"indirect<br/>(via orchestrator)"| Detectors["Content Detectors<br/>(regex, PII, etc.)"]
    Gateway -.->|"indirect<br/>(via orchestrator)"| vLLM["vLLM / LLM Runtime"]

    %% OpenShift Platform Dependencies
    Gateway -.->|"cert mount<br/>/etc/tls/private/"| CertSigner["OpenShift<br/>service-serving-cert-signer"]
    Gateway -.->|"CA mount<br/>/etc/tls/ca/"| CAOperator["OpenShift<br/>service-ca operator"]

    %% Key Rust Crate Dependencies
    subgraph RustCrates["Core Rust Dependencies"]
        Axum["axum 0.7.9<br/>HTTP Framework"]
        Tokio["tokio 1.41.1<br/>Async Runtime"]
        Reqwest["reqwest 0.12.12<br/>HTTP Client (native-tls)"]
        OpenSSL["openssl 0.10.73<br/>TLS/mTLS Identity"]
        SerdeJSON["serde_json 1.0.133<br/>JSON Payloads"]
        SerdeYML["serde_yml 0.0.12<br/>YAML Config"]
        TowerHTTP["tower-http 0.6.2<br/>HTTP Middleware"]
    end

    Gateway -->|"built with"| RustCrates

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Detectors fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style CertSigner fill:#ee0000,stroke:#333,color:#fff
    style CAOperator fill:#ee0000,stroke:#333,color:#fff
    style Axum fill:#fff2cc,stroke:#d6b656
    style Tokio fill:#fff2cc,stroke:#d6b656
    style Reqwest fill:#fff2cc,stroke:#d6b656
    style OpenSSL fill:#fff2cc,stroke:#d6b656
    style SerdeJSON fill:#fff2cc,stroke:#d6b656
    style SerdeYML fill:#fff2cc,stroke:#d6b656
    style TowerHTTP fill:#fff2cc,stroke:#d6b656
