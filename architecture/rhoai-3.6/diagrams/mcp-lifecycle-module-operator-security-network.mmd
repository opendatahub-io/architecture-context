graph TB
    subgraph ClusterInternal["CLUSTER-INTERNAL (No External Ingress)"]
        direction TB

        subgraph ModuleOpNS["Module Operator Namespace (SYSTEM_NAMESPACE)"]
            ModuleOp["mcp-lifecycle-module-operator<br/>SA: module-operator-controller-manager<br/>Port: 8081/TCP (probes, HTTP)<br/>Metrics: Disabled<br/>FIPS: strictfipsruntime + DEFAULT:PQ<br/>NetworkPolicy: ingress 8081 only"]
        end

        subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount + RBAC"]
            APIServerCR["OpenShift APIServer CR<br/>(TLS Profile Source)"]
        end

        subgraph OperandNS["Operand Namespace (mcp-lifecycle-operator-system)"]
            Operand["mcp-lifecycle-operator<br/>SA: operand-controller-manager<br/>8081/TCP (probes)<br/>8443/TCP (metrics, HTTPS)<br/>9443/TCP (webhook, HTTPS)"]

            MetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP<br/>HTTPS TLS<br/>TokenReview + SAR"]

            WebhookSvc["Webhook Service<br/>ClusterIP 443/TCP → 9443<br/>HTTPS TLS (cert-manager)<br/>K8s Admission"]
        end
    end

    %% Module Operator to K8s API
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>SSA Apply, CRUD, Watches"| K8sAPI
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>Read TLS profile"| APIServerCR

    %% K8s API to Operand Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>K8s Admission<br/>Conversion webhook"| WebhookSvc

    %% Operand to K8s API
    Operand -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>MCPServer CRUD"| K8sAPI

    %% Service links
    MetricsSvc -.->|"8443/TCP"| Operand
    WebhookSvc -.->|"9443/TCP"| Operand

    %% Styling
    classDef moduleop fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,color:#000
    classDef operand fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000
    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000

    class ModuleOp moduleop
    class K8sAPI,APIServerCR controlplane
    class Operand operand
    class MetricsSvc,WebhookSvc service
