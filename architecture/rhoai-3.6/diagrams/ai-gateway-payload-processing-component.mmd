graph TB
    subgraph "AI Gateway Payload Processing"
        subgraph "Data Plane"
            ExtProc["ext-proc gRPC Server<br/>9004/TCP"]
            DynMeta["dynamicmetadata Wrapper<br/>gRPC Interceptor"]
            DynMeta -->|wraps| ExtProc
        end

        subgraph "Control Plane"
            EPCtrl["ExternalProvider Controller"]
            EMCtrl["ExternalModel Controller"]
            LegacyCtrl["Legacy Migration Controller"]
        end
    end

    %% CRDs
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io/v1alpha1)"]
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io/v1alpha1)"]
    LegacyCR["ExternalModel CR<br/>(maas.opendatahub.io)"]

    %% Watched CRDs
    ExternalModelCR -->|watched by| EMCtrl
    ExternalProviderCR -->|watched by| EPCtrl
    LegacyCR -->|watched by| LegacyCtrl
    LegacyCtrl -->|creates| ExternalModelCR
    LegacyCtrl -->|creates| ExternalProviderCR

    %% Created Resources
    EMCtrl -->|creates| HTTPRoute["HTTPRoute<br/>(gateway.networking.k8s.io)"]
    EPCtrl -->|creates| ExtNameSvc["ExternalName Service"]
    EPCtrl -->|creates| ServiceEntry["ServiceEntry<br/>(networking.istio.io)"]
    EPCtrl -->|creates| DestRule["DestinationRule<br/>(networking.istio.io)"]

    %% Envoy Integration
    Envoy["Envoy Proxy<br/>(AI Gateway)"] -->|ext_proc callout| DynMeta
    DynMeta -->|dynamic metadata| Envoy
    HTTPRoute -->|configures| Envoy

    %% External Dependencies
    ExtProc -->|reads| ProviderSecrets["Provider Secrets"]
    ExtProc -->|resolves| ExternalModelCR
    ExtProc -->|resolves| ExternalProviderCR

    %% Optional Integrations
    ExtProc -.->|guardrail checks| NeMo["NeMo Guardrails"]
    ExtProc -.->|usage reporting| Metering["External Metering"]

    %% Styling
    style ExtProc fill:#4a90e2,stroke:#333,color:#fff
    style DynMeta fill:#4a90e2,stroke:#333,color:#fff
    style EPCtrl fill:#4a90e2,stroke:#333,color:#fff
    style EMCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LegacyCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ExternalModelCR fill:#f5a623,stroke:#333
    style ExternalProviderCR fill:#f5a623,stroke:#333
    style LegacyCR fill:#f5a623,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style ExtNameSvc fill:#7ed321,stroke:#333
    style ServiceEntry fill:#7ed321,stroke:#333
    style DestRule fill:#7ed321,stroke:#333
    style Envoy fill:#e8e8e8,stroke:#333
    style NeMo fill:#e8e8e8,stroke:#333
    style Metering fill:#e8e8e8,stroke:#333
    style ProviderSecrets fill:#d5e8d4,stroke:#333
