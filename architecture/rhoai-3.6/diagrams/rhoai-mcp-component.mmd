    style RBAC fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style Server fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style PluginMgr fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
