graph TB
    subgraph External["External Clients"]
        Agent["AI Agent<br/>(MCP Client)"]
    end

    subgraph Route["OpenShift Route"]
        ORoute["Route<br/>443/TCP HTTPS<br/>TLS Edge Termination"]
    end

    subgraph RhoaiMCP["rhoai-mcp Server"]
        direction TB

        subgraph Auth["Authentication Layer"]
            OIDC["OIDC Auth Middleware<br/>(ASGI)"]
            RBAC["RBAC Checker<br/>(SubjectAccessReview)"]
        end

        subgraph Core["FastMCP Core"]
            Server["RHOAIServer<br/>(FastMCP + uvicorn)"]
            PluginMgr["Plugin Manager<br/>(pluggy)"]
        end

        subgraph DomainPlugins["Domain Plugins"]
            Projects["projects plugin<br/>DS Project CRUD"]
            Notebooks["notebooks plugin<br/>Workbench lifecycle"]
            Inference["inference plugin<br/>KServe management"]
            Pipelines["pipelines plugin<br/>DSPA management"]
            Connections["connections plugin<br/>S3 data connections"]
            Storage["storage plugin<br/>PVC management"]
            Training["training plugin<br/>TrainJob/Runtime"]
            ModelReg["model_registry plugin<br/>Model Registry API"]
            Prompts["prompts plugin<br/>18 MCP prompts"]
        end

        subgraph CompositePlugins["Composite Plugins"]
            ClusterComp["cluster-composites<br/>Context-efficient summaries"]
            TrainingComp["training-composites<br/>Training orchestration"]
            MetaComp["meta-composites<br/>Tool discovery"]
            PlannerComp["planner-composites<br/>Model recommendation"]
        end
    end

    subgraph K8sCluster["Kubernetes Cluster"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        KubeflowCRDs["Kubeflow CRDs<br/>(Notebooks, TrainJobs)"]
        KServeCRDs["KServe CRDs<br/>(InferenceService,<br/>ServingRuntime)"]
        DSPCRDs["DSP CRDs<br/>(DSPA)"]
        DSCluster["DataScienceCluster CR"]
    end

    subgraph ExternalSvc["External Services"]
        ModelRegSvc["Model Registry<br/>8080/8443 TCP"]
        ModelCatalog["Model Catalog<br/>8443/TCP"]
        PlannerBE["Planner Backend<br/>8000/TCP"]
        OIDCProvider["OIDC Provider<br/>443/TCP"]
    end

    %% Flows
    Agent -->|MCP protocol| ORoute
    ORoute -->|HTTP/8000| OIDC
    OIDC -->|validates token| OIDCProvider
    OIDC --> Server
    Server --> PluginMgr
    PluginMgr --> RBAC
    RBAC -->|SubjectAccessReview| K8sAPI

    PluginMgr --> DomainPlugins
    PluginMgr --> CompositePlugins

    Projects --> K8sAPI
    Notebooks --> KubeflowCRDs
    Inference --> KServeCRDs
    Pipelines --> DSPCRDs
    Training --> KubeflowCRDs
    ModelReg --> ModelRegSvc
    PlannerComp --> PlannerBE
    PlannerComp --> ModelCatalog
    ClusterComp --> DSCluster

