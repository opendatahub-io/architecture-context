graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph ProxyBoundary["PRAXIS PROXY (Trust Boundary)"]
        direction TB

        subgraph ListenerZone["Proxy Listener"]
            Listener["Praxis Listener<br/>8080/TCP<br/>HTTP/HTTPS<br/>TLS 1.2+ (rustls-openssl)"]
        end

        subgraph FilterZone["Filter Pipeline (per-listener, atomic swap)"]
            direction LR
            ObsFilters["Observability<br/>access_log, request_id<br/>trace_context"]
            SecFilters["Security<br/>basic_auth, cors, csrf<br/>ip_acl, policy<br/>peer_identity_trust"]
            TrafFilters["Traffic Mgmt<br/>router, load_balancer<br/>rate_limit, circuit_breaker"]
            TransFilters["Transform + Payload<br/>header, path_rewrite<br/>compression, json_body"]
        end

        subgraph AdminZone["Admin (Loopback Only)"]
            AdminAPI["Admin API<br/>9902/TCP<br/>HTTP (plaintext)<br/>No Auth"]
        end

        subgraph CryptoZone["Cryptographic Layer"]
            TLSProvider["rustls 0.23.45<br/>+ rustls-openssl 0.4.1<br/>→ System libcrypto.so<br/>FIPS 140-3 on RHEL"]
        end
    end

    subgraph UpstreamServices["UPSTREAM SERVICES"]
        Upstream["Upstream Clusters<br/>Configurable Port<br/>HTTP/HTTPS/TCP<br/>Configurable TLS"]
    end

    subgraph Telemetry["TELEMETRY (Optional)"]
        OTLP["OTLP Collector<br/>Configurable Port<br/>gRPC/HTTP<br/>TLS (native roots)"]
    end

    subgraph ContainerInfra["CONTAINER INFRASTRUCTURE"]
        ContainerRT["Container Runtime<br/>Health Checks"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8080/TCP<br/>TLS 1.2+ (configurable)<br/>Auth: per-filter-chain"| Listener
    Listener --> ObsFilters
    ObsFilters --> SecFilters
    SecFilters --> TrafFilters
    TrafFilters --> TransFilters
    TransFilters -->|"HTTP/HTTPS/TCP<br/>Configurable TLS<br/>credential_injection"| Upstream
    Listener --> TLSProvider

    ContainerRT -->|"HTTP 9902/TCP<br/>No TLS, No Auth"| AdminAPI

    ObsFilters -.->|"gRPC/HTTP<br/>TLS (native roots)"| OTLP

    %% Reserved headers note
    Listener -.-|"Strips reserved headers:<br/>x-praxis-*, x-ext-protocol-*<br/>x-ext-agent-*"| Listener

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef filter fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef admin fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef crypto fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef upstream fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef telemetry fill:#f5f5f5,stroke:#666,stroke-width:1px
    classDef infra fill:#f5f5f5,stroke:#666,stroke-width:1px

    class Client external
    class Listener proxy
    class ObsFilters,SecFilters,TrafFilters,TransFilters filter
    class AdminAPI admin
    class TLSProvider crypto
    class Upstream upstream
    class OTLP telemetry
    class ContainerRT infra
