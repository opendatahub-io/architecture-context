graph TB
    subgraph DSPO["Data Science Pipelines Operator"]
        direction TB
        DSPAReconciler["DSPAReconciler<br/>(Controller)"]
        AIPipelinesReconciler["AIPipelinesReconciler<br/>(Controller)"]
        AIPipelinesArgoReconciler["AIPipelinesArgoReconciler<br/>(Controller)"]
        TLSProfileWatcher["SecurityProfileWatcher"]
        WebhookServer["Webhook Server<br/>9443/TCP"]
        MetricsServer["Metrics Server<br/>8080/TCP"]
        HealthProbes["Health Probes<br/>8081/TCP"]

        DSPAReconciler -->|"validates"| WebhookServer
        AIPipelinesReconciler -->|"coordinates"| AIPipelinesArgoReconciler
        TLSProfileWatcher -->|"triggers restart on<br/>profile change"| DSPAReconciler
    end

    %% CRDs watched
    DSPACR["DataSciencePipelinesApplication CR<br/>(Namespaced)"]
    AIPipelinesCR["AIPipelines CR<br/>(Cluster-scoped)"]
    PipelineVersionCR["PipelineVersion CR<br/>(Namespaced)"]

    DSPACR -->|"watched by"| DSPAReconciler
    AIPipelinesCR -->|"watched by"| AIPipelinesReconciler
    PipelineVersionCR -->|"validated by"| WebhookServer

    %% Resources created per DSPA
    subgraph PerNamespace["Per-Namespace Pipeline Stack"]
        direction TB
        APIServer["API Server<br/>Deployment"]
        PersistenceAgent["Persistence Agent<br/>Deployment"]
        ScheduledWF["Scheduled Workflow<br/>Controller"]
        ArgoWFCtrl["Argo Workflow<br/>Controller"]
        MLMDServer["MLMD Server<br/>+ Envoy Proxy"]
        MariaDBDeploy["MariaDB<br/>(optional)"]
        MinioDeploy["MinIO<br/>(optional)"]
    end

    DSPAReconciler -->|"deploys via<br/>manifestival templates"| PerNamespace

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftAPI["OpenShift APIServer"]
    MariaDB["MariaDB<br/>3306/TCP"]
    S3Store["S3 / MinIO<br/>443/TCP"]

    DSPAReconciler -->|"CRUD operations"| K8sAPI
    DSPAReconciler -->|"health check"| MariaDB
    DSPAReconciler -->|"health check"| S3Store
    TLSProfileWatcher -->|"watches TLS profile"| OpenShiftAPI

    %% Internal platform integrations
    KServe["KServe"]
    MLflow["MLflow"]
    Prometheus["Prometheus"]
    Ray["Ray"]
    CodeFlare["CodeFlare / AppWrapper"]

    DSPAReconciler -->|"creates InferenceService"| KServe
    DSPAReconciler -->|"detects instances"| MLflow
    DSPAReconciler -->|"creates ServiceMonitors"| Prometheus
    DSPAReconciler -->|"creates RayClusters"| Ray
    DSPAReconciler -->|"creates AppWrappers"| CodeFlare

    %% Styling
    style DSPAReconciler fill:#4a90e2,color:#fff
    style AIPipelinesReconciler fill:#4a90e2,color:#fff
    style AIPipelinesArgoReconciler fill:#4a90e2,color:#fff
    style TLSProfileWatcher fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style HealthProbes fill:#4a90e2,color:#fff
    style DSPACR fill:#f5a623,color:#000
    style AIPipelinesCR fill:#f5a623,color:#000
    style PipelineVersionCR fill:#f5a623,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style OpenShiftAPI fill:#e8e8e8,color:#000
    style MariaDB fill:#e8e8e8,color:#000
    style S3Store fill:#e8e8e8,color:#000
    style KServe fill:#7ed321,color:#000
    style MLflow fill:#7ed321,color:#000
    style Prometheus fill:#7ed321,color:#000
    style Ray fill:#7ed321,color:#000
    style CodeFlare fill:#7ed321,color:#000
