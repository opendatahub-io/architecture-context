graph TB
    subgraph KServeModule["KServe Module Controller (Meta-Operator)"]
        ModuleCtrl["kserve-module-controller<br/>Reconciles Kserve CR<br/>Installs sub-components"]
    end

    subgraph CoreControlPlane["Core Control Plane"]
        Manager["kserve-controller-manager<br/>8443/TCP metrics, 9443/TCP webhook"]
        Webhook["Admission Webhooks<br/>443/TCP TLS"]
        Manager -->|runs| Webhook
    end

    subgraph LLMControlPlane["LLM Control Plane"]
        LLMCtrl["llmisvc-controller<br/>8081/TCP health"]
        LLMWebhook["LLM Webhooks<br/>443/TCP TLS"]
        LLMCtrl -->|runs| LLMWebhook
    end

    subgraph LocalModelPlane["Local Model Caching"]
        LocalModelCtrl["localmodel-controller<br/>8081/TCP health"]
        NodeAgent["localmodelnode-agent<br/>8081/TCP health<br/>per-node DaemonSet"]
        LocalModelCtrl -->|coordinates| NodeAgent
    end

    subgraph DataPlane["Data Plane (per Inference Pod)"]
        Router["router<br/>Split/Switch/Ensemble/Sequence"]
        Agent["agent<br/>Model download & batcher"]
        StorageInit["storage-initializer<br/>Init container, Python"]
        QPExt["qpext<br/>Queue proxy metrics"]
    end

    subgraph ModelServers["Serving Runtimes"]
        OVMS["OVMS"]
        vLLM["vLLM<br/>CUDA/ROCm/Gaudi/CPU/Spyre"]
        MLServer["MLServer"]
        HFServer["HuggingFace Server"]
        AutoGluon["AutoGluon Server"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        ISCR["InferenceService<br/>v1beta1"]
        LLMCR["LLMInferenceService<br/>v1alpha1/v1alpha2"]
        IGCR["InferenceGraph<br/>v1alpha1"]
        SRCR["ClusterServingRuntime<br/>/ ServingRuntime"]
        LMCR["LocalModelCache<br/>/ LocalModelNamespaceCache"]
        KCCR["KernelCache<br/>/ KernelCacheCapture"]
    end

    %% Module controller manages everything
    ModuleCtrl -->|installs & configures| CoreControlPlane
    ModuleCtrl -->|installs & configures| LLMControlPlane
    ModuleCtrl -->|installs & configures| LocalModelPlane

    %% Controller watches
    Manager -->|reconciles| ISCR
    Manager -->|reconciles| IGCR
    Manager -->|reconciles| SRCR
    LLMCtrl -->|reconciles| LLMCR
    LocalModelCtrl -->|reconciles| LMCR

    %% Controllers create data plane resources
    Manager -->|creates pods with| StorageInit
    Manager -->|injects| Agent
    Manager -->|creates| Router
    LLMCtrl -->|creates Deployment/LWS| ModelServers

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    CertMgr["cert-manager"]
    GatewayAPI["Gateway API<br/>HTTPRoute"]
    KEDA["KEDA<br/>ScaledObject"]
    LWS["LeaderWorkerSet"]
    Prometheus["Prometheus<br/>8443/TCP scrape"]

    Manager -->|CRUD| K8sAPI
    LLMCtrl -->|CRUD| K8sAPI
    Manager -->|creates HTTPRoute| GatewayAPI
    LLMCtrl -->|creates HTTPRoute| GatewayAPI
    LLMCtrl -->|creates ScaledObject| KEDA
    LLMCtrl -->|creates LWS| LWS
    Webhook -->|TLS certs| CertMgr
    Prometheus -->|scrapes| Manager

    %% Storage egress
    CloudStorage["Cloud Storage<br/>S3/GCS/Azure/HF/OCI"]
    StorageInit -->|downloads models| CloudStorage

    %% Styling
    style ModuleCtrl fill:#9b59b6,color:#fff
    style Manager fill:#4a90e2,color:#fff
    style LLMCtrl fill:#4a90e2,color:#fff
    style LocalModelCtrl fill:#4a90e2,color:#fff
    style NodeAgent fill:#4a90e2,color:#fff
    style Webhook fill:#e67e22,color:#fff
    style LLMWebhook fill:#e67e22,color:#fff
    style Router fill:#27ae60,color:#fff
    style Agent fill:#27ae60,color:#fff
    style StorageInit fill:#27ae60,color:#fff
    style QPExt fill:#27ae60,color:#fff
    style ISCR fill:#f5a623
    style LLMCR fill:#f5a623
    style IGCR fill:#f5a623
    style SRCR fill:#f5a623
    style LMCR fill:#f5a623
    style KCCR fill:#f5a623
    style K8sAPI fill:#999,color:#fff
    style CertMgr fill:#999,color:#fff
    style GatewayAPI fill:#999,color:#fff
    style KEDA fill:#999,color:#fff
    style LWS fill:#999,color:#fff
    style Prometheus fill:#999,color:#fff
    style CloudStorage fill:#999,color:#fff
