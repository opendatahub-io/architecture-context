graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ) - KServe / RHOAI Managed"]
        Gateway["Istio Ingress Gateway<br/>443/TCP<br/>TLS 1.2+<br/>Platform Auth"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS via Istio)"]
        direction TB

        subgraph OVMSPod["OVMS Pod (user-namespace)"]
            IstioSidecar["Istio Sidecar<br/>(mTLS proxy)"]

            subgraph OVMSContainer["OVMS Container (UID 5000)"]
                REST["Drogon REST Server<br/>rest_port/TCP HTTP<br/>/v1/* (TFS) - No auth<br/>/v2/* (KServe) - No auth<br/>/v3/v1/* (OpenAI) - Bearer key<br/>/metrics - No auth"]
                GRPC["gRPC Server<br/>grpc_port/TCP<br/>InsecureServerCredentials<br/>No built-in TLS"]
            end

            NginxMTLS["nginx-mtls-auth<br/>(optional sidecar)<br/>mTLS termination"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS (BoringSSL)<br/>AWS Credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS (system OpenSSL)<br/>GCP Credentials"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS (Azure SDK)<br/>Azure Credentials"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS (CURLSSLOPT_NATIVE_CA)<br/>Bearer HF_TOKEN"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        KServeCtrl["KServe Controller<br/>ServingRuntime CRD"]
        Prometheus["Prometheus<br/>Metrics Scrape"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform Auth"| Gateway
    Gateway -->|"HTTP/8080 + gRPC/9000<br/>mTLS (Istio)"| IstioSidecar
    IstioSidecar -->|"HTTP (pod-local)<br/>No TLS"| REST
    IstioSidecar -->|"gRPC (pod-local)<br/>No TLS"| GRPC
    NginxMTLS -.->|"mTLS termination<br/>(optional)"| REST

    %% Egress flows
    REST -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    REST -->|"HTTPS/443<br/>TLS<br/>GCP creds"| GCS
    REST -->|"HTTPS/443<br/>TLS<br/>Azure creds"| Azure
    REST -->|"HTTPS/443<br/>TLS<br/>Bearer HF_TOKEN"| HFHub

    %% Platform flows
    KServeCtrl -.->|"Manages pod lifecycle"| OVMSPod
    Prometheus -->|"GET /metrics<br/>HTTP"| REST

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef container fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class IstioSidecar,REST,GRPC,NginxMTLS servicemesh
    class S3,GCS,Azure,HFHub externalservice
    class KServeCtrl,Prometheus platform
