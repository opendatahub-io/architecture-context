graph TB
    subgraph AgentAuth["agent-auth (Shared Middleware)"]
        SATokenAuth["SATokenAuthMiddleware<br/>ASGI Middleware"]
        TokenReviewClient["TokenReview Client"]
        SATokenAuth --> TokenReviewClient
    end

    subgraph StandardAgents["Standard Agent Templates"]
        direction TB
        LangGraphReAct["LangGraph ReAct Agent"]
        LangGraphRAG["LangGraph Agentic RAG"]
        LangGraphDBMem["LangGraph ReAct + DB Memory"]
        LangGraphCI["LangGraph CI Failure Summarizer"]
        LangGraphHITL["LangGraph Human-in-the-Loop"]
        LangGraphGuard["LangGraph Guardrailed Agent"]
        CrewAI["CrewAI WebSearch Agent"]
        LlamaIndex["LlamaIndex WebSearch Agent"]
        AutoGenMCP["AutoGen MCP Agent"]
        GoogleADK["Google ADK Agent"]
        VanillaPython["Vanilla Python Agent"]
    end

    subgraph NonStandardAgents["Non-Standard Agents"]
        direction TB
        A2A["A2A LangGraph + CrewAI"]
        Langflow["Langflow Tool Calling"]
        OpenClaw["OpenClaw on OpenShift"]
        ClaudeCode["Claude Code on OpenShift"]
        Codex["Codex on OpenShift"]
        OpenCode["OpenCode on OpenShift"]
    end

    subgraph EvalInfra["Evaluation Infrastructure"]
        EvalHarness["Eval Harness"]
        BehavioralTests["Behavioral Tests"]
        EvalHarness --> BehavioralTests
    end

    Client[Client] -->|HTTPS/443| Route["OpenShift Route<br/>(edge TLS)"]
    Route -->|HTTP/8080| StandardAgents
    Route -->|HTTP/18789| OpenClaw

    StandardAgents -->|opt-in| SATokenAuth
    TokenReviewClient -->|TokenReview| K8sAPI["Kubernetes API<br/>443/TCP mTLS"]

    StandardAgents -->|HTTP| LLM["LLM Inference<br/>(OGX/vLLM/Ollama)"]
    OpenClaw -->|HTTP| LLM

    LangGraphRAG -->|TCP/19530| Milvus["Milvus Vector Store"]
    LangGraphDBMem -->|TCP/5432| PostgreSQL["PostgreSQL"]
    LangGraphCI -->|TCP/5432| PostgreSQL
    LangGraphCI -->|HTTPS/443| GitHubAPI["GitHub API"]
    LangGraphCI -->|HTTPS/443| Slack["Slack Webhook"]
    LangGraphGuard -->|HTTP| NeMo["NeMo Guardrails"]

    StandardAgents -.->|optional HTTPS| MLflow["MLflow Tracking"]
    BehavioralTests -->|HTTP/8080| StandardAgents

    style SATokenAuth fill:#4a90e2,stroke:#333
    style TokenReviewClient fill:#4a90e2,stroke:#333
    style Route fill:#f5a623,stroke:#333
    style LLM fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style Milvus fill:#e8e8e8,stroke:#333
    style GitHubAPI fill:#e8e8e8,stroke:#333
    style Slack fill:#e8e8e8,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style NeMo fill:#e8e8e8,stroke:#333
    style EvalHarness fill:#9b59b6,stroke:#333
    style BehavioralTests fill:#9b59b6,stroke:#333
