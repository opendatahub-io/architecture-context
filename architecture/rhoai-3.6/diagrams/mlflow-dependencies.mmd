graph LR
    MLflow["MLflow Server<br/>(odh-mlflow-rhel9)"]

    %% Runtime Dependencies
    MLflow -->|"ASGI server"| Uvicorn["uvicorn &lt;1"]
    MLflow -->|"web framework"| FastAPI["fastapi &lt;1"]
    MLflow -->|"ASGI toolkit<br/>(pinned 1.3.1, CVE fix)"| Starlette["starlette"]
    MLflow -->|"legacy web framework"| Flask["flask &lt;4"]
    MLflow -->|"ORM"| SQLAlchemy["sqlalchemy &lt;3"]
    MLflow -->|"DB migrations"| Alembic["alembic &lt;2"]
    MLflow -->|"serialization"| Protobuf["protobuf &lt;8"]
    MLflow -->|"TLS/crypto"| Cryptography["cryptography >=43"]
    MLflow -->|"tracing"| OTelAPI["opentelemetry-api &lt;3"]

    %% RHOAI-Specific Dependencies
    MLflow -->|"auth + workspaces"| KubePlugins["mlflow-kubernetes-plugins 1.6.0"]
    MLflow -->|"PostgreSQL driver"| Psycopg2["psycopg2"]
    MLflow -->|"metrics export"| PromExporter["prometheus-flask-exporter"]

    %% Backend Services
    MLflow -->|"metadata store<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    MLflow -->|"artifact storage<br/>443/TCP HTTPS"| S3["S3-Compatible Storage"]
    MLflow -->|"RBAC + namespaces<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API"]

    %% Internal RHOAI Dependencies
    MLflow -->|"deployment lifecycle"| MLflowOperator["MLflow Operator"]
    MLflow -->|"external ingress<br/>/mlflow path"| ODHGateway["ODH Data Science Gateway"]

    %% Optional Dependencies
    MLflow -.->|"S3 SDK (optional)"| Boto3["boto3"]
    MLflow -.->|"GCS SDK (optional)"| GCS["google-cloud-storage"]
    MLflow -.->|"Azure SDK (optional)"| Azure["azure-storage-blob"]
    MLflow -.->|"MCP federation (optional)"| FastMCP["fastmcp &lt;4"]

    %% Consumers
    ODHDashboard["ODH Dashboard"] -->|"UI integration"| MLflow
    SDKClients["MLflow SDK Clients<br/>(mlflow-skinny, mlflow-tracing)"] -->|"experiment tracking<br/>model registry"| MLflow

    %% Styling
    style MLflow fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KubePlugins fill:#e74c3c,stroke:#333,color:#fff
    style Psycopg2 fill:#e74c3c,stroke:#333,color:#fff
    style PromExporter fill:#e74c3c,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style MLflowOperator fill:#7ed321,stroke:#333
    style ODHGateway fill:#7ed321,stroke:#333
    style ODHDashboard fill:#7ed321,stroke:#333
    style SDKClients fill:#7ed321,stroke:#333
    style Uvicorn fill:#ddd,stroke:#333
    style FastAPI fill:#ddd,stroke:#333
    style Starlette fill:#ddd,stroke:#333
    style Flask fill:#ddd,stroke:#333
    style SQLAlchemy fill:#ddd,stroke:#333
    style Alembic fill:#ddd,stroke:#333
    style Protobuf fill:#ddd,stroke:#333
    style Cryptography fill:#ddd,stroke:#333
    style OTelAPI fill:#ddd,stroke:#333
    style Boto3 fill:#eee,stroke:#999,stroke-dasharray:5
    style GCS fill:#eee,stroke:#999,stroke-dasharray:5
    style Azure fill:#eee,stroke:#999,stroke-dasharray:5
    style FastMCP fill:#eee,stroke:#999,stroke-dasharray:5
