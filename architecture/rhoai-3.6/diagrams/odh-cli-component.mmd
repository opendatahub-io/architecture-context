graph TB
    subgraph "odh-cli (kubectl-odh / rhai-cli)"
        direction TB
        Root["Root Command<br/>(cobra.Command)"]

        subgraph Commands["CLI Subcommands"]
            direction LR
            Lint["lint<br/>Upgrade readiness"]
            Migrate["migrate<br/>Version migration"]
            Diagnose["diagnose<br/>Cluster diagnostics"]
            Backup["backup<br/>Workload backup"]
            Deps["deps<br/>Dependency mgmt"]
            Get["get<br/>Resource inspect"]
            Status["status<br/>Platform status"]
            Components["components<br/>Component list"]
            Logs["logs<br/>Log tailing"]
            Events["events<br/>Event tailing"]
            MCP["mcp serve<br/>MCP server"]
            API["api<br/>API operations"]
            Version["version<br/>Version info"]
        end

        subgraph Client["Fat Client Layer"]
            DefaultClient["defaultClient"]
            Dynamic["Dynamic Client"]
            Discovery["Discovery Client"]
            APIExt["API Extensions Client"]
            OLMClient["OLM Client"]
            Typed["Typed K8s Client"]
            CRClient["Controller-Runtime Client"]
        end

        subgraph Migration["Migration Framework"]
            Registry["Action Registry"]
            RayCluster["RayCluster Actions"]
            Kueue["Kueue RHBOK Actions"]
            ModelServing["Model Serving Actions"]
            TrustyAI["TrustyAI Actions"]
            AIPipelines["AI Pipelines Actions"]
            Workbenches["Workbenches Actions"]
            Training["Training Actions"]
            LlamaStack["LlamaStack Actions"]
        end

        subgraph MCPServer["MCP Server"]
            MCPTools["12 CLI Tools"]
            DiagTools["5 Diagnostic Tools<br/>(from opendatahub-operator)"]
        end

        Root --> Commands
        Commands --> Client
        Migrate --> Migration
        MCP --> MCPServer

        DefaultClient --> Dynamic
        DefaultClient --> Discovery
        DefaultClient --> APIExt
        DefaultClient --> OLMClient
        DefaultClient --> Typed
        DefaultClient --> CRClient

        Registry --> RayCluster
        Registry --> Kueue
        Registry --> ModelServing
        Registry --> TrustyAI
        Registry --> AIPipelines
        Registry --> Workbenches
        Registry --> Training
        Registry --> LlamaStack
    end

    User["User / kubectl"] -->|"kubectl odh &lt;cmd&gt;"| Root
    AIAgent["AI Agent<br/>(Claude, GPT, Cursor)"] -->|"JSON-RPC / SSE"| MCPServer

    Client -->|"HTTPS/6443<br/>kubeconfig creds"| K8sAPI["Kubernetes API Server"]
    Deps -->|"HTTPS/443"| GitHub["GitHub<br/>(odh-gitops)"]
    TrustyAI -->|"HTTPS/443<br/>InsecureSkipVerify"| TrustyAISvc["TrustyAI Service"]

    style Root fill:#4a90e2,stroke:#333
    style DefaultClient fill:#4a90e2,stroke:#333
    style Registry fill:#f5a623,stroke:#333
    style MCPTools fill:#7ed321,stroke:#333
    style DiagTools fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style GitHub fill:#e8e8e8,stroke:#333
    style TrustyAISvc fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#333
    style AIAgent fill:#f9f9f9,stroke:#333
