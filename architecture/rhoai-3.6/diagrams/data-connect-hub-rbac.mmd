graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["dc-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["dc-controller-manager-rolebinding"]
        CRB_Metrics["dc-controller-metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (dc-controller-system)"]
        RB_Leader["dc-controller-leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["dc-controller-manager-role"]
        CR_MetricsAuth["dc-controller-metrics-auth-role"]
        CR_MetricsReader["dc-controller-metrics-reader"]
        CR_Admin["dataconnecthub-admin-role"]
        CR_Editor["dataconnecthub-editor-role"]
        CR_Viewer["dataconnecthub-viewer-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["dc-controller-leader-election-role"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        CoreResources["Core API<br/>configmaps, secrets,<br/>serviceaccounts, services"]
        AppsResources["apps<br/>deployments"]
        AuthnResources["authentication.k8s.io<br/>tokenreviews"]
        AuthzResources["authorization.k8s.io<br/>subjectaccessreviews"]
        OSResources["config.openshift.io<br/>apiservers, ingresses"]
        DCHResources["dataconnecthub.opendatahub.io<br/>dataconnectservices,<br/>data-connections,<br/>data-connection-types,<br/>data-store, flight-services"]
        DCHInitResources["dataconnecthub.opendatahub.io<br/>initdataconnections,<br/>initdataconnectiontypes"]
        GatewayResources["gateway.networking.k8s.io<br/>gateways, httproutes"]
        MonitorResources["monitoring.coreos.com<br/>servicemonitors"]
        NetworkResources["networking.k8s.io<br/>networkpolicies"]
        RBACResources["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings"]
    end

    subgraph UserFacingResources["User-Facing CRD Resources"]
        DCServiceCRD["dataconnecthub.opendatahub.io<br/>dataconnectservices,<br/>dataconnectservices/status"]
    end

    subgraph MetricsEndpoint["Metrics Endpoint"]
        Metrics["/metrics"]
    end

    %% Bindings
    SA_Controller -->|bound via| CRB_Manager
    SA_Controller -->|bound via| CRB_Metrics
    SA_Controller -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    RB_Leader -->|grants| R_Leader

    %% Manager role permissions
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| CoreResources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| AppsResources
    CR_Manager -->|create| AuthnResources
    CR_Manager -->|create| AuthzResources
    CR_Manager -->|"get, list, watch"| OSResources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| DCHResources
    CR_Manager -->|"get, list, watch"| DCHInitResources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| GatewayResources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| MonitorResources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| NetworkResources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| RBACResources

    %% Metrics auth role
    CR_MetricsAuth -->|create| AuthnResources
    CR_MetricsAuth -->|create| AuthzResources

    %% Metrics reader
    CR_MetricsReader -->|get| Metrics

    %% User-facing roles
    CR_Admin -->|"create, delete, get,<br/>list, patch, update, watch"| DCServiceCRD
    CR_Editor -->|"create, delete, get,<br/>list, patch, update, watch"| DCServiceCRD
    CR_Viewer -->|"get, list, watch"| DCServiceCRD

