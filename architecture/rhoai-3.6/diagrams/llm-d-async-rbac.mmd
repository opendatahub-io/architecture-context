graph TD
    subgraph HelmChart["Helm Chart Provisioned"]
        SA["ServiceAccount<br/>llm-d-async"]
    end

    subgraph MetricsAuth["Metrics Endpoint RBAC<br/>(controller-runtime)"]
        MetricsServer["Metrics Server<br/>Port 9090/TCP"]
        AuthFilter["WithAuthenticationAndAuthorization<br/>Filter"]
    end

    subgraph K8sAuth["Kubernetes Authentication"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
        TokenReview["TokenReview<br/>SubjectAccessReview"]
    end

    subgraph Endpoints["Endpoint Access Matrix"]
        HealthEndpoints["/healthz — No Auth Required<br/>/readyz — No Auth Required<br/>Port 8081/TCP"]
        MetricsEndpoint["/metrics — RBAC Protected<br/>Port 9090/TCP<br/>Default: auth enabled"]
    end

    subgraph Secrets["Secrets"]
        RedisSecret["Redis/Valkey URL Secret<br/>Type: Opaque<br/>Contains: connection URL<br/>Provisioned: Helm chart"]
        TLSSecret["TLS Secret<br/>Type: kubernetes.io/tls<br/>Contains: client cert + key<br/>For: mTLS to inference gateway"]
    end

    %% Auth flow for metrics
    SA -->|"authenticates via"| K8sAPI
    MetricsServer -->|"delegates auth to"| AuthFilter
    AuthFilter -->|"validates token via"| TokenReview
    K8sAPI -->|"performs"| TokenReview

    %% Endpoint access
    MetricsServer -->|"serves"| MetricsEndpoint
    HealthEndpoints -.->|"no auth required"| SA

    %% Secret usage
    RedisSecret -->|"mounted as env"| SA
    TLSSecret -->|"mounted as volume"| SA

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style MetricsServer fill:#f5a623
    style AuthFilter fill:#f5a623
    style K8sAPI fill:#999,color:#fff
    style TokenReview fill:#999,color:#fff
    style HealthEndpoints fill:#7ed321
    style MetricsEndpoint fill:#ff9800
    style RedisSecret fill:#e57373
    style TLSSecret fill:#e57373
