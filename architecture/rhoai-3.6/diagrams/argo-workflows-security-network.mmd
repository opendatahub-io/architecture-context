graph TB
    subgraph InternalPlatform["INTERNAL PLATFORM (DSP)"]
        DSP["DSP API Server"]
    end

    subgraph K8sLayer["KUBERNETES API"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount RBAC"]
    end

    subgraph ControlPlane["CONTROL PLANE (Argo Workflows)"]
        direction TB
        Controller["Workflow Controller<br/>SA: argo<br/>9090/TCP metrics<br/>6060/TCP healthz<br/>FIPS 140-3 (Go native)"]
        LeaderElection["Leader Election<br/>Kubernetes Lease"]
        Controller ---|acquires| LeaderElection
    end

    subgraph ExecutionPlane["EXECUTION PLANE (Workflow Pods)"]
        direction TB
        ArgoexecPod["Workflow Pod"]
        Argoexec["argoexec sidecar<br/>SA: per-workflow<br/>FIPS 140-3 (Go native)"]
        UserContainer["User Container<br/>(workload)"]
        ArgoexecPod --- Argoexec
        ArgoexecPod --- UserContainer
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3/MinIO<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        GCS["GCS<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP SA"]
        Azure["Azure Blob<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Azure AD"]
        DB["Archive DB<br/>5432 or 3306/TCP<br/>TLS configurable<br/>Username/password"]
    end

    %% Flows
    DSP -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Create Workflow CR"| K8sAPI
    K8sAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Watch events"| Controller
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Create/update pods"| K8sAPI
    Argoexec -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Report TaskResult"| K8sAPI
    Argoexec -->|"HTTPS/443<br/>TLS 1.2+<br/>Cloud creds<br/>Upload artifacts"| S3
    Argoexec -.->|"HTTPS/443<br/>TLS 1.2+<br/>GCP SA"| GCS
    Argoexec -.->|"HTTPS/443<br/>TLS 1.2+<br/>Azure AD"| Azure
    Controller -.->|"TCP/5432 or 3306<br/>TLS configurable<br/>Password auth"| DB

    %% Styling
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef execution fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class DSP platform
    class K8sAPI k8s
    class Controller,LeaderElection controlplane
    class ArgoexecPod,Argoexec,UserContainer execution
    class S3,GCS,Azure,DB external
