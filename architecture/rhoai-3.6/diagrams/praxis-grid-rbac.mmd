graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["grid-operator<br/>(grid-system namespace)"]
        SA_Enroll["grid-enrollment<br/>(grid-system namespace)"]
    end

    subgraph ClusterRoleBindings["Role Bindings"]
        CRB_CRD["grid-operator-crd<br/>(ClusterRoleBinding)"]
        RB_Resources_GS["grid-operator-resources<br/>(RoleBinding: grid-system)"]
        RB_Resources_Def["grid-operator-resources<br/>(RoleBinding: default)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_CRD["grid-operator-crd<br/>(ClusterRole)"]
        CR_Resources["grid-operator-resources<br/>(ClusterRole)"]
    end

    subgraph GridCRDs["Grid CRD Resources (grid.praxis.fast)"]
        AGP["AgentToolProviders<br/>get, list, watch, patch"]
        GN["GridNetworks<br/>get, list, watch, patch"]
        IP["InferenceProviders<br/>get, list, watch, patch"]
        GS["GridSites<br/>get, list, watch, patch,<br/>create, update, delete"]
        StatusSub["*/status subresources<br/>get, patch"]
    end

    subgraph CoreResources["Core Kubernetes Resources"]
        Secrets["Secrets<br/>get, create, patch"]
        Services["Services (named)<br/>get"]
        ConfigMaps["ConfigMaps<br/>get, create, patch, update"]
        Events["Events (events.k8s.io)<br/>create, patch"]
        Deployments["Deployments (apps)<br/>get, patch"]
    end

    %% Bindings
    SA_Op -->|"bound via"| CRB_CRD
    SA_Op -->|"bound via"| RB_Resources_GS
    SA_Op -->|"bound via"| RB_Resources_Def

    CRB_CRD -->|"grants"| CR_CRD
    RB_Resources_GS -->|"grants"| CR_Resources
    RB_Resources_Def -->|"grants"| CR_Resources

    %% CRD permissions
    CR_CRD -->|"manages"| AGP
    CR_CRD -->|"manages"| GN
    CR_CRD -->|"manages"| IP
    CR_CRD -->|"manages (full CRUD)"| GS
    CR_CRD -->|"manages"| StatusSub

    %% Resource permissions
    CR_Resources -->|"manages"| Secrets
    CR_Resources -->|"reads"| Services
    CR_Resources -->|"manages"| ConfigMaps
    CR_Resources -->|"creates"| Events
    CR_Resources -->|"manages"| Deployments

    %% Styling
    style SA_Op fill:#4a90e2,color:#fff
    style SA_Enroll fill:#4a90e2,color:#fff
    style CR_CRD fill:#f5a623,color:#fff
    style CR_Resources fill:#f5a623,color:#fff
    style CRB_CRD fill:#9b59b6,color:#fff
    style RB_Resources_GS fill:#9b59b6,color:#fff
    style RB_Resources_Def fill:#9b59b6,color:#fff
    style AGP fill:#7ed321,color:#fff
    style GN fill:#7ed321,color:#fff
    style IP fill:#7ed321,color:#fff
    style GS fill:#7ed321,color:#fff
    style StatusSub fill:#7ed321,color:#fff
    style Secrets fill:#e74c3c,color:#fff
    style Services fill:#3498db,color:#fff
    style ConfigMaps fill:#3498db,color:#fff
    style Events fill:#3498db,color:#fff
    style Deployments fill:#3498db,color:#fff
