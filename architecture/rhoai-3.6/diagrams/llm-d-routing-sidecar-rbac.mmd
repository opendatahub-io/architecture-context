graph TD
    subgraph ServiceAccounts["Service Accounts / Subjects"]
        AuthUsers["Group: system:authenticated"]
        PlaceholderSA["ServiceAccount: placeholder"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-Scoped)"]
        ExecBinding["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}"]
        SSRFBinding["ssrf-allowlist-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph Roles["Roles (Namespace-Scoped)"]
        ExecRole["${PROJECT_NAME}-exec-role"]
        SSRFRole["ssrf-allowlist-role"]
    end

    subgraph Resources["API Resources"]
        PodExec["Core API<br/>pods/exec"]
        Pods["Core API<br/>pods"]
        InferencePools["inference.networking.x-k8s.io<br/>inferencepools"]
    end

    %% Bindings
    AuthUsers -->|bound via| ExecBinding
    PlaceholderSA -->|bound via| SSRFBinding
    ExecBinding -->|grants| ExecRole
    SSRFBinding -->|grants| SSRFRole

    %% Permissions
    ExecRole -->|create| PodExec
    SSRFRole -->|get, watch, list| Pods
    SSRFRole -->|get, watch, list| InferencePools

    %% Notes
    ExecNote["Note: Grants pod/exec to ALL<br/>authenticated users in namespace"]
    SSRFNote["Note: Used for SSRF protection<br/>allowlist construction"]

    ExecRole -.-> ExecNote
    SSRFRole -.-> SSRFNote

    style AuthUsers fill:#4a90e2,color:#fff
    style PlaceholderSA fill:#4a90e2,color:#fff
    style ExecRole fill:#f5a623,color:#fff
    style SSRFRole fill:#f5a623,color:#fff
    style PodExec fill:#7ed321
    style Pods fill:#7ed321
    style InferencePools fill:#7ed321
    style ExecNote fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style SSRFNote fill:#fff,stroke:#999,stroke-dasharray: 5 5
