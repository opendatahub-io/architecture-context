graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager"]
        SA_LLMISVC["llmisvc-serviceAccountName"]
        SA_LocalModel["kserve-localmodel-controller-manager"]
        SA_NodeAgent["kserve-localmodelnode-agent"]
        SA_Module["kserve-module-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["kserve-manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Proxy["kserve-proxy-rolebinding<br/>(Cluster-scoped)"]
        CRB_LLMISVC["llmisvc-manager-rolebinding<br/>(ns: kserve)"]
        CRB_LocalModel["kserve-localmodel-manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_NodeAgent["kserve-localmodelnode-agent-rolebinding<br/>(ns: kserve)"]
        CRB_Module["kserve-module-manager-rolebinding<br/>(Cluster-scoped)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLMISVC["kserve-llmisvc-manager-role"]
        CR_LocalModel["kserve-localmodel-manager-role"]
        CR_NodeAgent["kserve-localmodelnode-agent-role"]
        CR_Module["kserve-module-manager-role"]
    end

    subgraph ManagerResources["kserve-manager-role Resources"]
        R_IS["serving.kserve.io<br/>InferenceService"]
        R_IG["serving.kserve.io<br/>InferenceGraph"]
        R_SR["serving.kserve.io<br/>ServingRuntime<br/>ClusterServingRuntime"]
        R_TM["serving.kserve.io<br/>TrainedModel"]
        R_Deploy["apps<br/>Deployments"]
        R_HTTPRoute["gateway.networking.k8s.io<br/>HTTPRoutes"]
        R_VS["networking.istio.io<br/>VirtualServices"]
    end

    subgraph LLMResources["kserve-llmisvc-manager-role Resources"]
        R_LLMIS["serving.kserve.io<br/>LLMInferenceService"]
        R_LLMCFG["serving.kserve.io<br/>LLMInferenceServiceConfig"]
        R_GW["gateway.networking.k8s.io<br/>Gateways, GatewayClasses,<br/>HTTPRoutes"]
        R_InfPool["inference.networking.k8s.io<br/>InferenceModels,<br/>InferencePools"]
        R_LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSets"]
        R_KEDA["keda.sh<br/>ScaledObjects"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        R_LMC["serving.kserve.io<br/>LocalModelCaches<br/>LocalModelNamespaceCaches<br/>LocalModelNodes"]
        R_PV["core<br/>PersistentVolumes<br/>PersistentVolumeClaims"]
        R_Jobs["batch<br/>Jobs"]
    end

    subgraph ProxyResources["kserve-proxy-role Resources"]
        R_TR["authentication.k8s.io<br/>TokenReviews"]
        R_SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph ModuleResources["kserve-module-manager-role Resources"]
        R_KserveCR["components.platform.opendatahub.io<br/>Kserves"]
        R_Webhooks["admissionregistration.k8s.io<br/>MutatingWebhookConfigs<br/>ValidatingWebhookConfigs"]
        R_CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        R_Certs["cert-manager.io<br/>Certificates, Issuers"]
        R_SCC["security.openshift.io<br/>SecurityContextConstraints"]
        R_RBAC["rbac.authorization.k8s.io<br/>ClusterRoles, Roles,<br/>Bindings"]
    end

    %% Bindings
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Proxy
    SA_LLMISVC -->|bound via| CRB_LLMISVC
    SA_LocalModel -->|bound via| CRB_LocalModel
    SA_NodeAgent -->|bound via| CRB_NodeAgent
    SA_Module -->|bound via| CRB_Module

    %% Role grants
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_LLMISVC -->|grants| CR_LLMISVC
    CRB_LocalModel -->|grants| CR_LocalModel
    CRB_NodeAgent -->|grants| CR_NodeAgent
    CRB_Module -->|grants| CR_Module

    %% Permissions
    CR_Manager -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ManagerResources
    CR_Proxy -->|create| ProxyResources
    CR_LLMISVC -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| LLMResources
    CR_LocalModel -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| LocalModelResources
    CR_NodeAgent -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| R_LMC
    CR_NodeAgent -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| R_Jobs
    CR_Module -->|"get,list,watch,<br/>create,update,patch,<br/>delete,bind,escalate"| ModuleResources

