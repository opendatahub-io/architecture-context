graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / KServe Route"]
    end

    subgraph AppBoundary["APPLICATION BOUNDARY (Container: UID 2000)"]
        direction TB

        AuthMW["AuthenticationMiddleware<br/>Bearer Token validation<br/>(optional — enabled via VLLM_API_KEY)"]

        subgraph HTTPServer["HTTP Server (:8000/TCP)"]
            APIServer["FastAPI API Server<br/>Uvicorn ASGI<br/>TLS: Configurable<br/>Cipher suite: Configurable"]
            SSLRefresh["SSLCertRefresher<br/>(watchfiles — cert hot-reload)"]
        end

        Engine["AsyncLLM Engine<br/>PagedAttention / Continuous Batching"]

        subgraph OptionalGRPC["gRPC Server (Optional)"]
            GRPC["VllmEngine<br/>:50051/TCP<br/>⚠️ INSECURE (no TLS)<br/>No Auth"]
        end

        subgraph DPSupervisorBlock["DP Supervisor"]
            DPSup["DP Supervisor<br/>:9256/TCP<br/>HTTP / No TLS / No Auth<br/>/ready, /readyz"]
        end
    end

    subgraph EgressServices["EGRESS (External Services)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer (HF_TOKEN)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        Stats["stats.vllm.ai<br/>443/TCP HTTPS<br/>⛔ DISABLED<br/>(VLLM_NO_USAGE_STATS=1)"]
    end

    subgraph Platform["PLATFORM INTEGRATION"]
        KServe["KServe / ModelMesh<br/>ServingRuntime"]
        Prometheus["Prometheus<br/>Scrapes :8000/metrics"]
        OTel["OpenTelemetry Collector<br/>OTLP (optional)"]
    end

    %% Inbound flows
    Client -->|"HTTP/HTTPS :8000<br/>Configurable TLS<br/>Bearer Token (optional)"| AuthMW
    AuthMW --> APIServer

    %% Internal flows
    APIServer -->|"In-process IPC"| Engine

    %% Egress flows
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HFHub
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Engine -.-|"HTTPS/443<br/>DISABLED"| Stats

    %% Platform flows
    KServe -->|"Routes traffic"| Client
    Prometheus -->|"HTTP :8000<br/>/metrics"| APIServer
    APIServer -->|"OTLP"| OTel

    %% GRPC flow
    GRPC -->|"In-process"| Engine

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appboundary fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef auth fill:#fee2e2,stroke:#ef4444,stroke-width:2px
    classDef server fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef engine fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef insecure fill:#fecaca,stroke:#dc2626,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef disabled fill:#e5e7eb,stroke:#9ca3af,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class AuthMW auth
    class APIServer,SSLRefresh server
    class Engine engine
    class GRPC insecure
    class DPSup insecure
    class HFHub,S3 egress
    class Stats disabled
    class KServe,Prometheus,OTel platform
