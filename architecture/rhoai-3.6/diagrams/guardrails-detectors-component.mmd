graph TB
    subgraph "Guardrails Detectors"
        subgraph "Shared Framework"
            BaseAPI["DetectorBaseAPI<br/>(FastAPI base class)"]
            Instrumented["InstrumentedDetector<br/>(Prometheus mixin)"]
        end

        subgraph "Built-in Detector (port 8080)"
            BuiltInApp["built-in detector<br/>FastAPI/uvicorn<br/>4 workers"]
            RegexPII["Regex PII Detectors<br/>(email, CC, SSN, phone, IP)"]
            FileType["File-Type Validators<br/>(JSON, XML, YAML + schema)"]
            CustomDet["Custom Detectors<br/>(importlib loader)"]
            BuiltInApp --> RegexPII
            BuiltInApp --> FileType
            BuiltInApp --> CustomDet
        end

        subgraph "HuggingFace Detector (port 8000)"
            HFApp["huggingface detector<br/>FastAPI/uvicorn"]
            SeqClass["Sequence Classification"]
            TokClass["Token Classification"]
            CausalLM["Causal LM<br/>(Granite Guardian)"]
            HFApp --> SeqClass
            HFApp --> TokClass
            HFApp --> CausalLM
        end

        subgraph "LLM Judge Detector (port 8000)"
            JudgeApp["llm-judge detector<br/>FastAPI/uvicorn"]
            VLLMJudge["vllm_judge Library<br/>(metrics catalog)"]
            JudgeApp --> VLLMJudge
        end

        BaseAPI -.->|extends| BuiltInApp
        BaseAPI -.->|extends| HFApp
        BaseAPI -.->|extends| JudgeApp
        Instrumented -.->|mixes into| BuiltInApp
        Instrumented -.->|mixes into| HFApp
        Instrumented -.->|mixes into| JudgeApp
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|POST /api/v1/text/contents| BuiltInApp
    Orchestrator -->|POST /api/v1/text/contents| HFApp
    Orchestrator -->|POST /api/v1/text/contents| JudgeApp

    HFApp -->|loads model| ModelDir["Local Model<br/>(MODEL_DIR)"]
    JudgeApp -->|async HTTP| VLLMServer["vLLM Server<br/>8080/TCP"]

    KServe["KServe"] -->|deploys| HFApp
    KServe -->|deploys| JudgeApp
    Istio["Istio Sidecar"] -.->|mTLS + auth| HFApp
    Istio -.->|mTLS + auth| JudgeApp

    Prometheus["Prometheus"] -->|scrapes /metrics| BuiltInApp
    Prometheus -->|scrapes /metrics| HFApp

    style BaseAPI fill:#4a90e2,color:#fff
    style Instrumented fill:#4a90e2,color:#fff
    style BuiltInApp fill:#7ed321,color:#fff
    style HFApp fill:#7ed321,color:#fff
    style JudgeApp fill:#7ed321,color:#fff
    style Orchestrator fill:#f5a623,color:#fff
    style KServe fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style VLLMServer fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style ModelDir fill:#e8e8e8,stroke:#333
