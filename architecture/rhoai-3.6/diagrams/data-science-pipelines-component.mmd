graph TB
    subgraph DSP["Data Science Pipelines"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            APIServer["API Server<br/>Go Service<br/>8888/TCP HTTP, 8887/TCP gRPC, 8443/TCP Webhook"]
            PersistenceAgent["Persistence Agent<br/>Go Controller"]
            ScheduledWF["Scheduled Workflow Controller<br/>Go Controller<br/>9090/TCP metrics"]
            CacheServer["Cache Server<br/>Go Webhook Service<br/>443/TCP → 8443/TCP"]
        end

        subgraph ExecutionRuntime["Execution Runtime (per-task pod)"]
            Driver["Driver<br/>Go Init Container"]
            Launcher["Launcher v2<br/>Go Sidecar"]
            UserContainer["User Container"]
        end

        subgraph MetadataLayer["Metadata Layer"]
            MLMDServer["ML Metadata gRPC Server<br/>C++ / 8080/TCP"]
            MetadataEnvoy["Metadata Envoy Proxy<br/>9090/TCP"]
            MetadataWriter["Metadata Writer<br/>Python"]
        end

        subgraph Frontend["Frontend"]
            MLUI["ml-pipeline-ui<br/>React/TypeScript<br/>3000/TCP"]
            ViewerCRD["Viewer CRD Controller<br/>Go"]
        end
    end

    %% External actors
    User["Data Scientist / SDK"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Core flows
    User -->|"REST/gRPC"| APIServer
    User -->|"browse"| MLUI
    MLUI -->|"REST API"| APIServer

    APIServer -->|"creates Argo Workflows"| K8sAPI
    APIServer -->|"CRUD CRDs"| K8sAPI
    ScheduledWF -->|"creates Workflows on cron"| K8sAPI

    K8sAPI -->|"watches Workflows"| PersistenceAgent
    PersistenceAgent -->|"reports status"| APIServer

    %% Execution flow
    K8sAPI -->|"schedules pod"| Driver
    Driver -->|"resolves inputs"| K8sAPI
    Driver -.->|"prepares context"| Launcher
    Launcher -->|"invokes"| UserContainer

    %% Metadata flow
    Launcher -->|"records metadata"| MLMDServer
    MetadataWriter -->|"writes lineage"| MLMDServer
    MetadataEnvoy -->|"gRPC-HTTP proxy"| MLMDServer

    %% Cache flow
    K8sAPI -->|"admission webhook"| CacheServer

    %% Viewer flow
    ViewerCRD -->|"creates Deployments"| K8sAPI

    %% External dependencies
    MySQL["MySQL<br/>3306/TCP"]
    S3["S3-Compatible Storage"]
    ArgoWF["Argo Workflows"]

    APIServer -->|"state persistence"| MySQL
    CacheServer -->|"cache lookup"| MySQL
    APIServer -->|"artifact storage"| S3
    Launcher -->|"artifact I/O"| S3
    K8sAPI -->|"executes via"| ArgoWF

    %% Pipeline CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]

    APIServer -->|"manages"| PipelineCR
    APIServer -->|"validates/mutates"| PipelineVersionCR

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style PersistenceAgent fill:#4a90e2,stroke:#333,color:#fff
    style ScheduledWF fill:#4a90e2,stroke:#333,color:#fff
    style CacheServer fill:#4a90e2,stroke:#333,color:#fff
    style Driver fill:#50c878,stroke:#333,color:#fff
    style Launcher fill:#50c878,stroke:#333,color:#fff
    style UserContainer fill:#87ceeb,stroke:#333
    style MLMDServer fill:#9b59b6,stroke:#333,color:#fff
    style MetadataEnvoy fill:#9b59b6,stroke:#333,color:#fff
    style MetadataWriter fill:#9b59b6,stroke:#333,color:#fff
    style MLUI fill:#f39c12,stroke:#333,color:#fff
    style ViewerCRD fill:#f39c12,stroke:#333,color:#fff
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style ArgoWF fill:#e8e8e8,stroke:#333
