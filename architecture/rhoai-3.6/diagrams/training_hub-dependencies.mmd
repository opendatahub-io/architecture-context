graph LR
    TrainingHub["Training Hub<br/>Python Library"]

    %% Core Dependencies (Required)
    TrainingHub -->|"core ML framework"| torch["torch >=2.6.0"]
    TrainingHub -->|"model loading"| transformers["transformers >=4.57.6"]
    TrainingHub -->|"distributed training"| accelerate["accelerate >=0.34.2"]
    TrainingHub -->|"LoRA"| peft["peft >=0.15"]
    TrainingHub -->|"datasets"| datasets["datasets >=4.0.0"]
    TrainingHub -->|"validation"| pydantic["pydantic >=2.7.0"]
    TrainingHub -->|"filesystem abstraction"| fsspec["fsspec >=2025.0"]

    %% Backend Dependencies (Optional)
    TrainingHub -->|"SFT backend"| instructlab["instructlab-training >=0.16.2"]
    TrainingHub -->|"OSFT backend"| minitrainer["rhai-innovation-mini-trainer >=0.8.3"]
    TrainingHub -->|"LoRA backend"| unsloth["unsloth >=2026.1.1"]
    TrainingHub -->|"ART GRPO backend"| art["openpipe-art >=0.5.17"]
    TrainingHub -->|"verl GRPO backend"| verl["verl >=0.7"]
    TrainingHub -->|"LLM routing"| litellm["litellm >=1.71.1<br/>!=1.82.7,!=1.82.8"]
    TrainingHub -->|"prompt opt"| gepa["gepa >=0.1.1"]
    TrainingHub -->|"experiment tracking"| mlflow["mlflow >=3.5.0"]
    TrainingHub -->|"embedding training"| senttrans["sentence-transformers >=5.0"]

    %% CUDA Dependencies (Optional)
    TrainingHub -.->|"flash attention"| flashattn["flash-attn >=2.8"]
    TrainingHub -.->|"quantization"| bitsandbytes["bitsandbytes >=0.47.0"]
    TrainingHub -.->|"optimized kernels"| liger["liger-kernel >=0.5.10"]

    %% Internal Platform Dependencies
    Kubeflow["Kubeflow Training"] -->|"invokes + reads metrics"| TrainingHub
    TrainingHub -.->|"multi-node scheduling"| Volcano["Volcano"]

    %% External Services
    TrainingHub -->|"model/dataset download"| HFHub["HuggingFace Hub"]
    TrainingHub -->|"checkpoint storage"| S3["S3 / GCS / Azure"]
    TrainingHub -.->|"experiment logging"| WandB["Weights & Biases"]
    TrainingHub -->|"GEPA inference"| LLMAPI["LLM API Endpoints"]

    %% Styling
    style TrainingHub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core deps
    style torch fill:#d5e8d4,stroke:#82b366
    style transformers fill:#d5e8d4,stroke:#82b366
    style accelerate fill:#d5e8d4,stroke:#82b366
    style peft fill:#d5e8d4,stroke:#82b366
    style datasets fill:#d5e8d4,stroke:#82b366
    style pydantic fill:#d5e8d4,stroke:#82b366
    style fsspec fill:#d5e8d4,stroke:#82b366

    %% Backend deps (optional)
    style instructlab fill:#dae8fc,stroke:#6c8ebf
    style minitrainer fill:#dae8fc,stroke:#6c8ebf
    style unsloth fill:#dae8fc,stroke:#6c8ebf
    style art fill:#dae8fc,stroke:#6c8ebf
    style verl fill:#dae8fc,stroke:#6c8ebf
    style litellm fill:#fff2cc,stroke:#d6b656
    style gepa fill:#dae8fc,stroke:#6c8ebf
    style mlflow fill:#dae8fc,stroke:#6c8ebf
    style senttrans fill:#dae8fc,stroke:#6c8ebf

    %% CUDA deps
    style flashattn fill:#e1d5e7,stroke:#9673a6
