graph LR
    PPE["praxis-policy<br/>(Rust Library)"]

    %% Core Runtime Dependencies
    PPE -->|"async runtime"| Tokio["tokio 1.x"]
    PPE -->|"TLS transport"| Rustls["rustls 0.23"]
    PPE -->|"TLS crypto provider"| Ring["ring 0.17"]
    PPE -->|"HTTPS connector"| HyperRustls["hyper-rustls 0.27"]
    PPE -->|"HTTP client"| HyperUtil["hyper-util 0.1"]
    PPE -->|"root certificates"| WebPKI["webpki-roots 1.x"]

    %% Serialization
    PPE -->|"serialization"| Serde["serde / serde_json /<br/>serde_yaml"]

    %% Crypto
    PPE -->|"SHA-256 hashing"| SHA2["sha2 0.11"]
    PPE -->|"HMAC digests"| HMAC["hmac 0.13"]
    PPE -->|"secret erasure"| Zeroize["zeroize 1.9"]
    PPE -->|"JWT crypto backend"| AWSLCRS["aws-lc-rs 1.18"]

    %% Identity & Auth
    PPE -.->|"JWT decode/verify<br/>(feature: jwt)"| JWT["jsonwebtoken 11"]

    %% Policy Decision Points
    PPE -.->|"Cedar evaluation<br/>(feature: cedar)"| Cedar["cedar-policy 4.x"]
    PPE -.->|"CEL evaluation<br/>(feature: cel)"| CEL["cel-rust 0.14.5"]
    PPE -.->|"OPA/Rego evaluation<br/>(feature: opa)"| Regorus["regorus 0.12<br/>(restricted builtins)"]

    %% Delegation & Session
    PPE -.->|"token exchange cache<br/>(feature: oauth)"| Moka["moka 0.12"]
    PPE -.->|"session persistence<br/>(feature: valkey)"| Redis["redis 1.7"]
    PPE -.->|"connection pooling<br/>(feature: valkey)"| Deadpool["deadpool-redis 0.23"]

    %% Utilities
    PPE -->|"structured logging"| Tracing["tracing 0.1"]
    PPE -.->|"stack-growth guard<br/>(feature: cedar/pdps)"| Stacker["stacker 0.1"]

    %% Integration Points (not deps, but systems PPE connects to)
    subgraph IntegrationPoints["Integration Points (External Systems)"]
        Praxis["Praxis Proxy<br/>(host application)"]
        IdP["OIDC Identity Provider<br/>443/TCP HTTPS"]
        ValkeyDB["Valkey / Redis<br/>6379/TCP"]
        VaultSvc["HashiCorp Vault<br/>8200/TCP HTTPS"]
        CIBASvc["CIBA Provider<br/>443/TCP HTTPS"]
    end

    Praxis -->|"embeds as library"| PPE
    PPE -->|"JWKS + token exchange"| IdP
    PPE -.->|"session taint"| ValkeyDB
    PPE -.->|"secret retrieval"| VaultSvc
    PPE -.->|"human approval"| CIBASvc

    %% Styling
    style PPE fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core deps
    style Tokio fill:#999,stroke:#333
    style Rustls fill:#999,stroke:#333
    style Ring fill:#999,stroke:#333
    style HyperRustls fill:#999,stroke:#333
    style HyperUtil fill:#999,stroke:#333
    style WebPKI fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333

    %% Crypto deps
    style SHA2 fill:#e67e22,stroke:#333,color:#fff
    style HMAC fill:#e67e22,stroke:#333,color:#fff
    style Zeroize fill:#e67e22,stroke:#333,color:#fff
    style AWSLCRS fill:#e67e22,stroke:#333,color:#fff

    %% Feature-gated deps
    style JWT fill:#7ed321,stroke:#333
    style Cedar fill:#7ed321,stroke:#333
    style CEL fill:#7ed321,stroke:#333
    style Regorus fill:#7ed321,stroke:#333
    style Moka fill:#7ed321,stroke:#333
    style Redis fill:#7ed321,stroke:#333
    style Deadpool fill:#7ed321,stroke:#333
    style Tracing fill:#999,stroke:#333
    style Stacker fill:#7ed321,stroke:#333

    %% Integration points
    style Praxis fill:#f5a623,stroke:#333
    style IdP fill:#f5a623,stroke:#333
    style ValkeyDB fill:#f5a623,stroke:#333
    style VaultSvc fill:#f5a623,stroke:#333
    style CIBASvc fill:#f5a623,stroke:#333
