graph TB
    subgraph Operator["odh-observability Operator"]
        Controller["odh-observability Controller<br/>(controller-runtime)"]
        Webhook["Mutating Webhook<br/>(label injector)<br/>:9443/TCP"]
        TemplateEngine["Template Engine<br/>(~50 Go templates)"]
        GC["Garbage Collector<br/>(label-based ownership)"]
        TLSResolver["TLS Profile Resolver<br/>(pkg/tls)"]
    end

    subgraph ProxyLayer["Metrics Proxy Layer"]
        ClusterProxy["data-science-prometheus<br/>-cluster-proxy<br/>kube-rbac-proxy :8443"]
        NamespaceProxy["data-science-prometheus<br/>-namespace-proxy<br/>kube-rbac-proxy + prom-label-proxy :8443"]
        ThanosProxy["data-science-thanos<br/>-querier-proxy<br/>kube-rbac-proxy + prom-label-proxy :8443"]
    end

    subgraph Telemetry["Telemetry Stack"]
        OTelCollector["OpenTelemetry Collector<br/>(data-science-collector)<br/>OTLP :4317/:4318"]
        UsageCollector["Usage Logs Collector<br/>(OTel Collector)"]
        Prometheus["MonitoringStack<br/>(Prometheus)<br/>:9090"]
        Thanos["Thanos Querier<br/>:10902"]
        Tempo["Tempo<br/>(distributed tracing)"]
        LokiStack["LokiStack<br/>(usage logs)"]
        Perses["Perses<br/>(dashboards)"]
    end

    subgraph Correlation["Correlation"]
        Korrel8r["korrel8r<br/>cross-signal navigation<br/>:8443"]
    end

    MonitoringCR["Monitoring CR<br/>(singleton: default-monitoring)<br/>Cluster-scoped"]

    %% Controller relationships
    MonitoringCR -->|watched by| Controller
    Controller -->|renders| TemplateEngine
    TemplateEngine -->|SSA deploy| ProxyLayer
    TemplateEngine -->|SSA deploy| Telemetry
    TemplateEngine -->|SSA deploy| Korrel8r
    Controller -->|runs| GC
    Controller -->|reads APIServer| TLSResolver
    TLSResolver -->|configures TLS| ProxyLayer

    %% Proxy to backend
    ClusterProxy -->|forwards| Prometheus
    NamespaceProxy -->|namespace-scoped| Prometheus
    ThanosProxy -->|namespace-scoped| Thanos
    Thanos -->|queries| Prometheus

    %% Telemetry flows
    OTelCollector -->|metrics| Prometheus
    OTelCollector -->|traces| Tempo
    UsageCollector -->|logs| LokiStack

    %% Webhook
    KubeAPI["kube-apiserver"] -->|admission| Webhook
    Webhook -->|injects scrape label| KubeAPI

    %% Correlation
    Korrel8r -.->|reads| Prometheus
    Korrel8r -.->|reads| Tempo
    Korrel8r -.->|reads| LokiStack

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px
    style Webhook fill:#4a90e2,stroke:#333,stroke-width:2px
    style TemplateEngine fill:#4a90e2,stroke:#333
    style GC fill:#4a90e2,stroke:#333
    style TLSResolver fill:#4a90e2,stroke:#333
    style MonitoringCR fill:#f5a623,stroke:#333,stroke-width:2px
    style ClusterProxy fill:#7ed321,stroke:#333
    style NamespaceProxy fill:#7ed321,stroke:#333
    style ThanosProxy fill:#7ed321,stroke:#333
    style OTelCollector fill:#50c878,stroke:#333
    style UsageCollector fill:#50c878,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style Thanos fill:#e8e8e8,stroke:#333
    style Tempo fill:#e8e8e8,stroke:#333
    style LokiStack fill:#e8e8e8,stroke:#333
    style Perses fill:#e8e8e8,stroke:#333
    style Korrel8r fill:#9b59b6,stroke:#333
    style KubeAPI fill:#f5a623,stroke:#333
