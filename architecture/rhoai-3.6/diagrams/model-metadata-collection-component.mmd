graph TB
    subgraph BuildPipeline["Build Pipeline (CI/CD only)"]
        direction TB
        ModelExtractor["model-extractor CLI<br/>(Go, main pipeline)"]
        MetadataReport["metadata-report CLI<br/>(Go, quality reports)"]
        ServingRuntimeCatalog["serving-runtime-catalog CLI<br/>(Go, ServingRuntime catalog)"]

        ModelExtractor -->|"generates catalogs"| CatalogYAML["Catalog YAML Files<br/>(data/)"]
        CatalogYAML -->|"input for"| MetadataReport
        MetadataReport -->|"generates"| QualityReports["Quality Reports<br/>(markdown/YAML)"]

        InputSR["Reviewed ServingRuntime<br/>Input YAML<br/>(input/serving_runtimes/)"] -->|"reads"| ServingRuntimeCatalog
        ServingRuntimeCatalog -->|"generates"| SRCatalog["Serving Runtime<br/>Catalog YAML"]
    end

    subgraph DataContainer["Data Container (Runtime)"]
        direction TB
        Container["odh-model-metadata-collection<br/>UBI9-minimal-pqc<br/>CMD sleep infinity"]
        DataVolume["/app/data/<br/>Pre-generated YAML catalogs"]
        Container --- DataVolume
    end

    subgraph ExternalAPIs["External APIs (Build-time)"]
        HuggingFace["HuggingFace API<br/>huggingface.co"]
        GitHubAPI["GitHub API<br/>api.github.com"]
        OCIRegistries["OCI Registries<br/>registry.redhat.io, quay.io"]
    end

    subgraph Consumers["Runtime Consumers"]
        Dashboard["RHOAI Dashboard"]
        ModelController["odh-model-controller"]
    end

    ModelExtractor -->|"HTTPS/443<br/>Bearer token"| HuggingFace
    ModelExtractor -->|"HTTPS/443<br/>Bearer token"| GitHubAPI
    ModelExtractor -->|"HTTPS/443<br/>Docker config"| OCIRegistries

    CatalogYAML -->|"copied into image"| DataVolume
    SRCatalog -->|"copied into image"| DataVolume

    DataVolume -->|"volume mount"| Dashboard
    DataVolume -->|"data reference"| ModelController

    style ModelExtractor fill:#4a90e2,stroke:#333,color:#fff
    style MetadataReport fill:#4a90e2,stroke:#333,color:#fff
    style ServingRuntimeCatalog fill:#4a90e2,stroke:#333,color:#fff
    style Container fill:#7ed321,stroke:#333
    style DataVolume fill:#7ed321,stroke:#333
    style HuggingFace fill:#e8e8e8,stroke:#333
    style GitHubAPI fill:#e8e8e8,stroke:#333
    style OCIRegistries fill:#e8e8e8,stroke:#333
    style Dashboard fill:#f5a623,stroke:#333
    style ModelController fill:#f5a623,stroke:#333
    style CatalogYAML fill:#d5e8d4,stroke:#82b366
    style SRCatalog fill:#d5e8d4,stroke:#82b366
    style QualityReports fill:#d5e8d4,stroke:#82b366
    style InputSR fill:#d5e8d4,stroke:#82b366
