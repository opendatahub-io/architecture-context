graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["planner-backend<br/>(Namespace: planner)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRole Permissions"]
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph Resources["API Resources"]
        Nodes["Core API<br/>nodes"]
    end

    subgraph AdminAuth["Application-Level Auth"]
        AdminPwd["DB_ADMIN_PASSWORD<br/>(env var, optional)"]
    end

    subgraph AdminEndpoints["Admin-Protected Endpoints"]
        Upload["/api/v1/db/upload-benchmarks<br/>POST"]
        Reset["/api/v1/db/reset<br/>POST"]
        Verify["/api/v1/db/verify-admin<br/>POST"]
    end

    subgraph UnauthEndpoints["Unauthenticated Endpoints"]
        AllAPI["All /api/v1/* endpoints<br/>(No auth middleware)<br/>CORS: allow_origins=*"]
    end

    subgraph Secrets["Secrets (Namespace: planner)"]
        PlannerSecrets["planner-secrets (Opaque)<br/>Manual provisioning<br/>No auto-rotation"]
    end

    subgraph SecretKeys["Secret Contents"]
        HFToken["HF_TOKEN<br/>HuggingFace API"]
        OpenAIKey["OPENAI_API_KEY<br/>OpenAI API"]
        CatalogToken["MODEL_CATALOG_TOKEN<br/>Model Catalog"]
        AAKey["AA_API_KEY<br/>Artificial Analysis"]
        DBPwd["DB_ADMIN_PASSWORD<br/>Admin endpoints"]
    end

    %% RBAC flow
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes

    %% Admin auth
    AdminPwd -->|"hmac.compare_digest<br/>(X-Admin-Password header)"| Upload
    AdminPwd -->|"hmac.compare_digest<br/>(X-Admin-Password header)"| Reset
    AdminPwd -->|"hmac.compare_digest<br/>(X-Admin-Password header)"| Verify

    %% Secrets
    PlannerSecrets --> HFToken
    PlannerSecrets --> OpenAIKey
    PlannerSecrets --> CatalogToken
    PlannerSecrets --> AAKey
    PlannerSecrets --> DBPwd

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style Nodes fill:#7ed321,stroke:#333,color:#fff
    style AdminPwd fill:#e74c3c,stroke:#333,color:#fff
    style Upload fill:#ffe6cc,stroke:#d79b00
    style Reset fill:#ffe6cc,stroke:#d79b00
    style Verify fill:#ffe6cc,stroke:#d79b00
    style AllAPI fill:#ffcccc,stroke:#cc0000
    style PlannerSecrets fill:#e1d5e7,stroke:#9673a6
    style HFToken fill:#f5f5f5,stroke:#999
    style OpenAIKey fill:#f5f5f5,stroke:#999
    style CatalogToken fill:#f5f5f5,stroke:#999
    style AAKey fill:#f5f5f5,stroke:#999
    style DBPwd fill:#f5f5f5,stroke:#999
