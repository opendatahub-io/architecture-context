graph LR
    MR["Model Registry<br/>(Kubeflow Hub)"]

    %% External Dependencies (required)
    MR -->|"ORM / DB abstraction"| GORM["gorm.io/gorm 1.31+"]
    MR -->|"operator framework"| ControllerRuntime["controller-runtime 0.25+"]
    MR -->|"HTTP routing"| Chi["go-chi/chi 5.3+"]
    MR -->|"DB migrations"| Migrate["golang-migrate 4.20+"]
    MR -->|"KServe API types"| KServeAPI["kserve 0.19+"]
    MR -->|"distributed locking"| PGLock["cirello.io/pglock 1.16+"]
    MR -->|"CLI framework"| Cobra["spf13/cobra 1.10+"]
    MR -->|"config management"| Viper["spf13/viper 1.21+"]
    MR -->|"K8s client"| ClientGo["k8s.io/client-go 0.37+"]

    %% Python Dependencies (async-upload job)
    MR -->|"S3 client"| Boto3["boto3 1.43+"]
    MR -->|"HF client"| HFHub["huggingface-hub 1.23+"]
    MR -->|"model signing"| RHModelSigning["rh-model-signing 1.0+"]
    MR -->|"OCI layout"| Olot["olot 0.1+"]
    MR -->|"OCI registry"| Oras["oras 0.2+"]

    %% Internal Platform Dependencies
    KServeISVC["KServe InferenceService"] -->|"controller watches"| MR
    MR -->|"mTLS + AuthZ"| Istio["Istio<br/>sidecar + AuthorizationPolicy"]
    MR -->|"storage init"| KServeCSC["KServe ClusterStorageContainer"]

    %% Integration Points (other components that interact)
    Dashboard["ODH Dashboard"] -.->|"UI management"| MR
    DSPipelines["Data Science Pipelines"] -.->|"model registration"| MR

    %% External Services
    MR -->|"metadata storage<br/>:3306/TCP"| MySQL["MySQL"]
    MR -->|"catalog storage<br/>:5432/TCP"| PostgreSQL["PostgreSQL"]
    MR -->|"model artifacts<br/>:443/TCP HTTPS"| S3["S3-compatible Storage"]
    MR -->|"federated catalog<br/>:443/TCP HTTPS"| HuggingFace["HuggingFace Hub API"]
    MR -->|"OCI artifacts<br/>:443/TCP HTTPS"| OCIRegistry["OCI Registry"]
    MR -->|"signature verify<br/>:443/TCP HTTPS"| Sigstore["Sigstore"]
    MR -->|"API server<br/>:6443/TCP HTTPS"| K8sAPI["Kubernetes API"]

