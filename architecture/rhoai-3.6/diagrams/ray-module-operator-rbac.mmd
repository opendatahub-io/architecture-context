graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["ray-module-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["ray-module-operator-<br/>manager-rolebinding"]
        CRB2["ray-module-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB1["ray-module-operator-<br/>manager-rolebinding<br/>(ns: system)"]
        RB2["ray-module-operator-<br/>leader-election-rolebinding<br/>(ns: ray-module-operator-system)"]
    end

    subgraph ManagerRole["ClusterRole: ray-module-operator-manager-role"]
        direction LR

        subgraph PlatformAPIs["Platform APIs"]
            RayCRD["components.platform.opendatahub.io<br/>rays, rays/status, rays/finalizers<br/>Full CRUD + watch"]
        end

        subgraph RayAPIs["Ray APIs"]
            RayIO["ray.io<br/>rayclusters, rayjobs,<br/>rayservices, raycronjobs<br/>Full CRUD + deletecollection"]
        end

        subgraph CoreAPIs["Core APIs"]
            CoreResources["core<br/>configmaps, services, serviceaccounts,<br/>events, pods, secrets<br/>Full CRUD"]
            AppsResources["apps<br/>deployments<br/>Full CRUD"]
            BatchResources["batch<br/>jobs<br/>Full CRUD"]
        end

        subgraph CertAPIs["Certificate APIs"]
            CertManagerRes["cert-manager.io<br/>certificates, issuers<br/>Full CRUD"]
        end

        subgraph NetworkAPIs["Network APIs"]
            GatewayRes["gateway.networking.k8s.io<br/>gateways, httproutes, referencegrants<br/>Full CRUD"]
            NetworkRes["networking.k8s.io<br/>ingresses, ingressclasses,<br/>networkpolicies<br/>Full CRUD"]
            RouteRes["route.openshift.io<br/>routes<br/>Full CRUD"]
        end

        subgraph SecurityAPIs["Security & RBAC APIs"]
            RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>Full CRUD"]
            WebhookRes["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations,<br/>validatingwebhookconfigurations<br/>Full CRUD"]
            CRDRes["apiextensions.k8s.io<br/>customresourcedefinitions<br/>create, get, list, patch, update, watch"]
            SCCRes["security.openshift.io<br/>securitycontextconstraints<br/>Full CRUD"]
        end
    end

    subgraph MetricsRole["ClusterRole: ray-module-operator-metrics-auth-role"]
        TokenReview["authentication.k8s.io<br/>tokenreviews → create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews → create"]
    end

    subgraph MetricsReader["ClusterRole: ray-module-operator-metrics-reader"]
        MetricsURL["/metrics → get"]
    end

    subgraph AggregateRoles["Aggregate Roles"]
        AdminRole["ray-admin-role<br/>rays: Full CRUD"]
        EditorRole["ray-editor-role<br/>rays: Full CRUD"]
        ViewerRole["ray-viewer-role<br/>rays: get, list, watch"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    SA -->|"bound via"| RB1
    SA -->|"bound via"| RB2
    CRB1 -->|"grants"| ManagerRole
    CRB2 -->|"grants"| MetricsRole

