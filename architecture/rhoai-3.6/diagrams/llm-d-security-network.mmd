graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway Mode)"]
        Gateway["Kubernetes Gateway<br/>80/TCP HTTP or 443/TCP HTTPS<br/>TLS terminated at gateway<br/>Auth: Gateway-configured"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (Internal)"]
        direction TB

        subgraph RouterNS["Namespace: llm-d-*"]
            Proxy["Envoy Proxy / agentgateway<br/>8000/TCP HTTP<br/>No encryption<br/>No auth"]
            EPP["Endpoint Picker<br/>9002/TCP gRPC ext-proc<br/>No encryption<br/>No auth"]
            Proxy -->|"gRPC 9002<br/>localhost or ClusterIP<br/>No encryption"| EPP
        end

        subgraph ModelNS["Namespace: llm-d-* (model servers)"]
            ModelServer["Model Server Pod<br/>vLLM 8000/TCP HTTP<br/>No encryption<br/>No auth"]
            RoutingSidecar["Routing Sidecar<br/>8000/TCP HTTP<br/>No encryption<br/>P/D orchestration"]
            PrefillWorker["Prefill Worker<br/>8000/TCP HTTP<br/>No encryption"]
            DecodeWorker["Decode Worker<br/>8000/TCP HTTP<br/>No encryption"]
        end

        subgraph Monitoring["Observability"]
            Prometheus["Prometheus<br/>Scrapes 8000/TCP<br/>Optional TLS"]
            OTEL["OTEL Collector<br/>4317/TCP gRPC<br/>No encryption"]
        end

        subgraph K8sControl["Kubernetes Control Plane"]
            APIServer["kube-apiserver<br/>mTLS<br/>InferencePool watch"]
            KEDA["KEDA<br/>ScaledObject<br/>Autoscaling"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer HF_TOKEN"]
        PyPI["PyPI / PyTorch Index<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Build-time only"]
    end

    subgraph RDMAFabric["RDMA FABRIC (Hardware-Level)"]
        NIXL["NIXL KV Transfer<br/>InfiniBand / RoCE<br/>GPUDirect bypass<br/>No software encryption"]
    end

    %% External flows
    Client -->|"HTTP 80 or HTTPS 443<br/>TLS at gateway<br/>Auth: configurable"| Gateway
    Client -->|"HTTP 8000<br/>No TLS<br/>No auth<br/>(standalone mode)"| Proxy

    %% Internal flows
    Gateway -->|"gRPC 9002<br/>No encryption"| EPP
    Gateway -->|"HTTP 8000<br/>No encryption"| ModelServer
    Proxy -->|"HTTP 8000<br/>No encryption"| ModelServer
    Proxy -->|"HTTP 8000<br/>No encryption"| RoutingSidecar
    RoutingSidecar -->|"HTTP 8000"| PrefillWorker
    PrefillWorker -.->|"RDMA"| NIXL
    DecodeWorker -.->|"RDMA"| NIXL

    %% Monitoring
    Prometheus -->|"HTTP 8000<br/>metrics scrape"| ModelServer
    ModelServer -->|"gRPC 4317<br/>trace export"| OTEL

    %% Control plane
    EPP -->|"mTLS<br/>Watch InferencePool"| APIServer
    KEDA -->|"mTLS<br/>ScaledObject"| APIServer

    %% External egress
    ModelServer -->|"HTTPS 443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef rdma fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class Proxy,EPP,ModelServer,RoutingSidecar,PrefillWorker,DecodeWorker internal
    class Prometheus,OTEL monitoring
    class APIServer,KEDA controlplane
    class HFHub,PyPI externalservice
    class NIXL rdma
