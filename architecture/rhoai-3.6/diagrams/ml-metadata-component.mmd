graph TB
    subgraph "ML Metadata Component"
        direction TB
        Server["metadata_store_server<br/>(C++ gRPC Server)<br/>Port 8080/TCP"]
        ServiceImpl["MetadataStoreServiceImpl<br/>(~45 RPC methods)"]
        Store["MetadataStore<br/>(C++ Storage Layer)"]
        Server --> ServiceImpl
        ServiceImpl --> Store
    end

    subgraph "Python Client"
        PyLib["ml_metadata<br/>(Python Library)<br/>gRPC + Direct DB"]
    end

    DSP["Data Science Pipelines<br/>(gRPC Client)"] -->|"gRPC/8080<br/>PutArtifacts, PutExecutions,<br/>PutContexts"| Server
    PipelineUI["Pipeline UI<br/>(gRPC Client)"] -->|"gRPC/8080<br/>GetLineageSubgraph,<br/>GetArtifacts"| Server
    PyLib -->|"gRPC/8080"| Server

    Store -->|"PostgreSQL/5432<br/>Username/Password"| PostgreSQL["PostgreSQL<br/>(Metadata Backend)"]
    Store -.->|"MySQL/3306<br/>(Alternative)"| MySQL["MySQL<br/>(Alternative Backend)"]

    PyLib -.->|"Direct DB<br/>(via C++ bindings)"| PostgreSQL

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style ServiceImpl fill:#4a90e2,stroke:#333,color:#fff
    style Store fill:#4a90e2,stroke:#333,color:#fff
    style PyLib fill:#6baed6,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style PipelineUI fill:#7ed321,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
