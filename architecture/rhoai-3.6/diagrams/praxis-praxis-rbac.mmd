graph TD
    subgraph ProxyAuth["Praxis Filter-Based Authorization"]
        direction TB

        subgraph FilterPipeline["Per-Listener Filter Pipeline"]
            direction LR
            BasicAuth["basic_auth<br/>(htpasswd file)"]
            IPAcl["ip_acl<br/>(allow/deny lists)"]
            CORS["cors<br/>(origin validation)"]
            CSRF["csrf<br/>(token validation)"]
            CredInjection["credential_injection<br/>(upstream auth)"]
            PeerIdentity["peer_identity_trust<br/>(SPIFFE X.509-SVID)"]
            Policy["policy<br/>(ppe engine)"]
            Guardrails["guardrails<br/>(AI inference)"]
        end

        subgraph HeaderSecurity["Reserved Header Enforcement"]
            direction LR
            PraxisHeaders["x-praxis-*<br/>(stripped from inbound)"]
            ProtocolHeaders["x-ext-protocol-*<br/>(stripped from inbound)"]
            AgentHeaders["x-ext-agent-*<br/>(stripped from inbound)"]
        end
    end

    subgraph AdminAuth["Admin Endpoint Security"]
        direction LR
        AdminBinding["Loopback Binding<br/>(network isolation)"]
        NoAuth["No Application Auth<br/>(relies on network)"]
    end

    subgraph Crypto["Cryptographic Controls"]
        direction LR
        TLSTermination["TLS Termination<br/>rustls + OpenSSL provider<br/>TLS 1.2+"]
        FIPSMode["FIPS 140-3 Mode<br/>PRAXIS_REQUIRE_FIPS=1<br/>Fail-closed enforcement"]
        CertReload["Certificate Hot-Reload<br/>File watcher + ArcSwap"]
    end

    subgraph ProcessSecurity["Process-Level Security"]
        direction LR
        NonRoot["Non-Root Container User"]
        NoUnsafe["#![deny(unsafe_code)]"]
        NoUnwrap["No unwrap / unchecked ops"]
        CargoAudit["cargo-auditable<br/>cargo-deny"]
    end

    %% Connections
    Client[External Client] -->|"request"| TLSTermination
    TLSTermination --> BasicAuth
    BasicAuth --> IPAcl
    IPAcl --> CORS
    CORS --> CSRF
    CSRF --> PeerIdentity
    PeerIdentity --> Policy
    Policy --> Guardrails
    Guardrails -->|"authorized"| Upstream[Upstream Service]

    CredInjection -->|"injects credentials"| Upstream

    ContainerRT[Container Runtime] --> AdminBinding
    AdminBinding --> NoAuth

    %% Note: No Kubernetes RBAC
    Note["Note: Praxis is a standalone binary.<br/>It does not create or require<br/>Kubernetes RBAC resources.<br/>All authorization is filter-pipeline-based."]

    style ProxyAuth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style AdminAuth fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Crypto fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style ProcessSecurity fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Client fill:#f5f5f5,stroke:#666
    style Upstream fill:#f5f5f5,stroke:#666
    style ContainerRT fill:#f5f5f5,stroke:#666
    style Note fill:#f8cecc,stroke:#b85450,stroke-width:1px
