graph LR
    MLMD["ML Metadata<br/>(metadata_store_server)"]

    %% Internal Platform Dependencies
    MLMD -->|"gRPC client<br/>records metadata"| DSP["Data Science Pipelines"]
    MLMD -->|"gRPC client<br/>records metadata"| KFP["Kubeflow Pipelines"]

    %% Database Backends
    MLMD -->|"5432/TCP<br/>metadata storage"| PostgreSQL["PostgreSQL<br/>(Primary Backend)"]
    MLMD -.->|"3306/TCP<br/>alternative"| MySQL["MySQL<br/>(Alternative Backend)"]

    %% Build Dependencies
    MLMD -->|"server framework"| gRPC["gRPC C++"]
    MLMD -->|"API serialization"| Protobuf["Protocol Buffers"]
    MLMD -->|"C++ utilities"| Abseil["Abseil C++"]
    MLMD -->|"filter parsing"| ZetaSQL["ZetaSQL"]

    %% Integration Points
    PipelineUI["Pipeline UI"] -->|"queries lineage"| MLMD

    %% Python Client Dependencies
    subgraph "Python Client"
        PyClient["ml_metadata<br/>Python Library"]
        PyClient -->|"client"| grpcio["grpcio"]
        PyClient -->|"serialization"| protobuf_py["protobuf"]
        PyClient -->|"utilities"| abslpy["absl-py"]
    end
    PyClient -->|"gRPC/8080"| MLMD

    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style DSP fill:#7ed321,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style PipelineUI fill:#7ed321,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style gRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style Abseil fill:#999,stroke:#333
    style ZetaSQL fill:#999,stroke:#333
    style PyClient fill:#6baed6,stroke:#333
    style grpcio fill:#e8e8e8,stroke:#333
    style protobuf_py fill:#e8e8e8,stroke:#333
    style abslpy fill:#e8e8e8,stroke:#333
