graph TB
    subgraph "llm-d-deployer Helm Chart"
        direction TB
        Controller["ModelService Controller<br/>(llm-d-model-service v0.0.15)"]
        Presets["Preset ConfigMaps<br/>(basic-gpu, nixl, redis-lookup, sim)"]
        RBAC["RBAC<br/>(manager + EPP ClusterRoles)"]
        SampleApp["Sample Application<br/>(Llama-3.2-3B-Instruct)"]
    end

    subgraph "Inference Plane"
        direction TB
        EPP["Endpoint Picker<br/>(llm-d-inference-scheduler v0.1.0)<br/>9002/gRPC ext_proc"]
        PrefillPod["Prefill vLLM Pod<br/>(llm-d:0.0.8)<br/>8000/TCP"]
        DecodePod["Decode vLLM Pod<br/>(llm-d:0.0.8)<br/>8001/TCP"]
        RoutingProxy["Routing Proxy Sidecar<br/>(llm-d-routing-sidecar:0.0.7)<br/>8000/TCP → 8001/TCP"]
    end

    subgraph "Infrastructure Dependencies"
        GatewayAPI["Gateway API CRDs v1"]
        GAIE["GAIE CRDs v1alpha2<br/>(InferencePool, InferenceModel)"]
        GatewayProvider["Gateway Provider<br/>(Istio / kgateway / GKE L7)"]
        Redis["Bitnami Redis 20.13.4<br/>8100/TCP"]
    end

    ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
    Installer["quickstart installer<br/>(llmd-installer.sh)"]

    User[User] -->|"creates"| ModelServiceCR
    Installer -->|"wraps Helm install"| Controller
    ModelServiceCR -->|"watched by"| Controller
    Controller -->|"reads"| Presets
    Controller -->|"creates"| PrefillPod
    Controller -->|"creates"| DecodePod
    Controller -->|"creates"| EPP
    Controller -->|"creates"| GAIE

    EPP -->|"routes requests"| PrefillPod
    EPP -->|"routes requests"| DecodePod
    RoutingProxy -->|"proxies 8000→8001"| DecodePod
    PrefillPod -->|"NixL KV-cache transfer<br/>5557/TCP"| DecodePod
    PrefillPod -->|"KV-cache lookup"| Redis
    DecodePod -->|"KV-cache lookup"| Redis

    GatewayProvider -->|"ext_proc"| EPP

    style Controller fill:#4a90e2,color:#fff
    style EPP fill:#4a90e2,color:#fff
    style PrefillPod fill:#7ed321,color:#fff
    style DecodePod fill:#7ed321,color:#fff
    style RoutingProxy fill:#7ed321,color:#fff
    style ModelServiceCR fill:#f5a623,color:#fff
    style GatewayAPI fill:#e8e8e8
    style GAIE fill:#e8e8e8
    style GatewayProvider fill:#e8e8e8
    style Redis fill:#e8e8e8
    style Installer fill:#b8b8b8
    style Presets fill:#4a90e2,color:#fff
    style RBAC fill:#4a90e2,color:#fff
    style SampleApp fill:#4a90e2,color:#fff
