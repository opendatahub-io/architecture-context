    ASK -->|"CI failure data"| GitHubAPI["GitHub API<br/>443/TCP HTTPS"]
    ASK -->|"triage summaries"| Slack["Slack Webhook<br/>443/TCP HTTPS"]
    ASK -->|"TokenReview auth"| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    ASK -->|"content safety"| NeMo["NeMo Guardrails<br/>HTTP proxy"]

    %% Reverse integrations (who uses this)
    EvalHarness["Eval Harness"] -->|"behavioral tests"| ASK

