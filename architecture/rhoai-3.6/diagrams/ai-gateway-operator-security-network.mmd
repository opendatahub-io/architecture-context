graph TB
    subgraph External["EXTERNAL (No Direct Access)"]
        Note["Operator is internal-only.<br/>Sub-components create their own<br/>ingress when deployed."]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes Network)"]
        direction TB

        Prometheus["Prometheus<br/>Scrapes metrics"]

        subgraph AppNS["Namespace: redhat-ods-applications"]
            direction TB
            Operator["ai-gateway-operator<br/>SA: ai-gateway-operator<br/>8081/TCP health (HTTP, no auth)<br/>8443/TCP metrics (HTTPS, authn/authz)<br/>Resources: 500m CPU / 512Mi<br/>GOMEMLIMIT: 410MiB"]

            subgraph SubComponents["Vendored Sub-Components"]
                BatchGW["batch-gateway-operator<br/>LLM batch inference"]
                MaaS["maas-controller<br/>Models as a Service"]
                AIGWC["ai-gateway-controller<br/>Praxis extproc + Kuadrant"]
            end
        end

        subgraph InfraNS["Namespace: redhat-ai-gateway-infra"]
            PostgreSQL["PostgreSQL<br/>maas-db-config Secret"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertMgr["cert-manager<br/>TLS provisioning"]
        GatewayAPI["Gateway API<br/>HTTPRoute mgmt"]
        Kuadrant["Kuadrant<br/>Auth + Rate Limiting"]
        Istio["Istio<br/>Service Mesh"]
        PrometheusOp["prometheus-operator<br/>Monitoring CRDs"]
        Authorino["Authorino<br/>Auth integration"]
        OTEL["OpenTelemetry<br/>Distributed tracing"]
        ServiceCA["OpenShift service-ca<br/>TLS cert provisioning"]
    end

    %% Flows
    Prometheus -->|"HTTPS/8443<br/>TLS (cluster profile)<br/>TokenReview + SAR"| Operator
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    K8sAPI -->|"deploys via API"| BatchGW
    K8sAPI -->|"deploys via API"| MaaS
    K8sAPI -->|"deploys via API"| AIGWC

    MaaS -.->|"DB connection"| PostgreSQL
    BatchGW -.->|"cert provisioning"| CertMgr
    BatchGW -.->|"HTTPRoutes"| GatewayAPI
    MaaS -.->|"auth policies"| Kuadrant
    MaaS -.->|"auth integration"| Authorino
    AIGWC -.->|"traffic routing"| Istio
    AIGWC -.->|"rate limiting"| Kuadrant
    Operator -.->|"monitoring CRDs"| PrometheusOp
    Operator -.->|"tracing CRDs"| OTEL
    ServiceCA -.->|"metrics TLS cert"| Operator

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef subcomp fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef infra fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef note fill:#f9f9f9,stroke:#999,stroke-dasharray:5 5

    class Note note
    class Operator operator
    class BatchGW,MaaS,AIGWC subcomp
    class PostgreSQL infra
    class K8sAPI,Prometheus k8s
    class CertMgr,GatewayAPI,Kuadrant,Istio,PrometheusOp,Authorino,OTEL,ServiceCA platform
