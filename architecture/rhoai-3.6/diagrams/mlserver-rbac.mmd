graph TD
    subgraph Note["MLServer RBAC Model"]
        direction TB
        Info["MLServer does not define its own RBAC resources.<br/>Authentication and authorization are platform-delegated."]
    end

    subgraph AuthFlow["Authentication Flow"]
        direction TB
        Client["External Client"]
        KRBAC["kube-rbac-proxy Sidecar"]
        MLServer["MLServer Application"]
    end

    subgraph Endpoints["Endpoint Access Control"]
        direction TB
        REST["REST Endpoints<br/>8080/TCP"]
        GRPC["gRPC Endpoints<br/>8081/TCP"]
        Metrics["Metrics Endpoint<br/>8082/TCP"]
    end

    subgraph AuthMech["Authentication Mechanisms"]
        direction TB
        OAuth["OpenShift OAuth<br/>Token Validation"]
        SAToken["ServiceAccount<br/>Token Validation"]
        NoAuth["No Authentication<br/>(Prometheus scraping)"]
    end

    subgraph RuntimeSec["Runtime Security (Application-Level)"]
        direction TB
        ProdMode["PRODUCTION Mode<br/>/etc/mlserver/trusted-runtimes.json"]
        AllowList["Allowlisted Implementations Only"]
        BlockCustom["Custom Environments Blocked"]
        BlockCORS["Wildcard CORS Blocked"]
    end

    %% Auth flow
    Client -->|"OAuth/SA Token"| KRBAC
    KRBAC -->|"validates via"| OAuth
    KRBAC -->|"validates via"| SAToken
    KRBAC -->|"proxies to"| REST
    KRBAC -->|"proxies to"| GRPC
    Client -->|"direct (no auth)"| Metrics
    Metrics -->|"enforcement"| NoAuth

    %% Runtime security
    ProdMode -->|"enforces"| AllowList
    ProdMode -->|"enforces"| BlockCustom
    ProdMode -->|"enforces"| BlockCORS

    %% KServe manages RBAC
    KServeCtrl["KServe Controller<br/>(manages RBAC)"] -->|"deploys"| KRBAC

    %% Styling
    style Info fill:#fff3cd,stroke:#856404,stroke-width:2px
    style KRBAC fill:#e74c3c,color:#fff
    style OAuth fill:#f5a623,color:#fff
    style SAToken fill:#f5a623,color:#fff
    style NoAuth fill:#95a5a6,color:#fff
    style ProdMode fill:#e67e22,color:#fff
    style AllowList fill:#27ae60,color:#fff
    style BlockCustom fill:#27ae60,color:#fff
    style BlockCORS fill:#27ae60,color:#fff
    style KServeCtrl fill:#7ed321,color:#fff
    style REST fill:#4a90e2,color:#fff
    style GRPC fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
