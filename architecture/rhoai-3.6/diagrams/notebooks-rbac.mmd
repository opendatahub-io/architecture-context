graph TD
    subgraph NotebooksComponent["Notebooks Component (No RBAC Defined)"]
        Note["This component produces container images.<br/>No RBAC roles, ClusterRoles, or<br/>RoleBindings are defined."]
    end

    subgraph RuntimeRBAC["Runtime RBAC (Managed by Workbenches Operator)"]
        direction TB

        subgraph PerNotebook["Per-Notebook Pod"]
            SA["ServiceAccount<br/>(per-notebook, created by<br/>workbenches-operator)"]
        end

        subgraph OAuthProxyRBAC["OAuth Proxy Sidecar"]
            OAuthSA["OAuth Proxy<br/>ServiceAccount<br/>(injected by ODH<br/>Notebook Controller)"]
        end

        subgraph K8sPermissions["Kubernetes Permissions (Runtime)"]
            K8sAPI["Kubernetes API<br/>ServiceAccount Token<br/>(automounted)"]
            S3Creds["S3 Credentials<br/>(user-provided secret)"]
            HFToken["HuggingFace Token<br/>(user-provided secret)"]
        end
    end

    subgraph AuthFlow["Authentication Flow"]
        User["User"] -->|"OpenShift OAuth"| Route["OpenShift Route"]
        Route -->|"Token validation"| OAuthProxy["OAuth Proxy"]
        OAuthProxy -->|"Jupyter token"| JupyterServer["Jupyter Server<br/>8888/TCP"]
    end

    SA -->|"bound to"| K8sAPI
    SA -.->|"mounts"| S3Creds
    SA -.->|"mounts"| HFToken

    subgraph CISecrets["CI/Build-Time Secrets (NOT in images)"]
        GHToken["GITHUB_TOKEN<br/>CI reviewer access"]
        GeminiKey["GEMINI_API_KEY<br/>CI summarization"]
        RenovateToken["RENOVATE_TOKEN<br/>Dependency updates"]
        PullSecret["PULL_SECRET<br/>Registry pull auth"]
    end

    %% Styling
    style NotebooksComponent fill:#f9f9f9,stroke:#999,stroke-width:2px
    style Note fill:#fff,stroke:#ccc
    style RuntimeRBAC fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style CISecrets fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style SA fill:#4a90e2,color:#fff
    style OAuthSA fill:#4a90e2,color:#fff
    style User fill:#e8e8e8,stroke:#333
    style Route fill:#ffe6cc,stroke:#d79b00
    style OAuthProxy fill:#d5e8d4,stroke:#82b366
    style JupyterServer fill:#dae8fc,stroke:#6c8ebf
