graph TD
    subgraph ServiceAccounts["Service Accounts"]
        GatewaySA["openshell gateway<br/>ServiceAccount"]
    end

    subgraph ClusterBindings["Cluster-Wide Bindings"]
        CRB["openshell<br/>ClusterRoleBinding"]
    end

    subgraph NamespaceBindings["Namespace Bindings (sandbox namespace)"]
        RB["openshell-sandbox<br/>RoleBinding"]
    end

    subgraph ClusterPermissions["ClusterRole: openshell"]
        direction TB
        RuntimeClasses["node.k8s.io<br/>runtimeclasses<br/>get"]
        PriorityClasses["scheduling.k8s.io<br/>priorityclasses<br/>get"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        Nodes["core<br/>nodes<br/>get, list, watch"]
        Namespaces["core<br/>namespaces<br/>get (shared)<br/>get,list,watch (managed/operator)<br/>+create,delete (managed)"]
        SandboxCRDs["agents.x-k8s.io<br/>sandboxes, sandboxes/status<br/>create,delete,get,list,patch,update,watch<br/>(managed/operator only)"]
        Pods_CR["core<br/>pods<br/>create,delete,get,list,patch,watch<br/>(managed/operator only)"]
        Secrets_CR["core<br/>secrets<br/>create,delete<br/>(managed only)"]
        ServiceAccounts_CR["core<br/>serviceaccounts<br/>create,get<br/>(managed only)"]
    end

    subgraph NamespacePermissions["Role: openshell-sandbox (shared mode)"]
        direction TB
        SandboxCRDs_NS["agents.x-k8s.io<br/>sandboxes, sandboxes/status<br/>create,delete,get,list,patch,update,watch"]
        Pods_NS["core<br/>pods<br/>create,delete,get,list,patch,watch"]
        Secrets_NS["core<br/>secrets<br/>create,delete"]
    end

    %% Bindings
    GatewaySA -->|"bound via"| CRB
    GatewaySA -->|"bound via"| RB
    CRB -->|"grants"| ClusterPermissions
    RB -->|"grants"| NamespacePermissions

    %% Styling
    style GatewaySA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e67e22,stroke:#333,color:#fff
    style RB fill:#e67e22,stroke:#333,color:#fff
    style RuntimeClasses fill:#7ed321,stroke:#333
    style PriorityClasses fill:#7ed321,stroke:#333
    style TokenReviews fill:#e74c3c,stroke:#333,color:#fff
    style Nodes fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style SandboxCRDs fill:#e74c3c,stroke:#333,color:#fff
    style Pods_CR fill:#e74c3c,stroke:#333,color:#fff
    style Secrets_CR fill:#e74c3c,stroke:#333,color:#fff
    style ServiceAccounts_CR fill:#f5a623,stroke:#333
    style SandboxCRDs_NS fill:#e74c3c,stroke:#333,color:#fff
    style Pods_NS fill:#e74c3c,stroke:#333,color:#fff
    style Secrets_NS fill:#e74c3c,stroke:#333,color:#fff
