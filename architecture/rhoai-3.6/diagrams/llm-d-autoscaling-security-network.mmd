graph TB
    subgraph InCluster["IN-CLUSTER (Internal)"]
        direction TB

        subgraph MetricsExporters["METRICS EXPORTERS"]
            vLLM["vLLM Model Servers<br/>8200/TCP HTTP<br/>No Auth"]
        end

        subgraph MonitoringStack["MONITORING STACK"]
            Prometheus["Prometheus<br/>9090/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / mTLS"]
        end

        subgraph ScalingEngine["SCALING ENGINE"]
            KEDA["KEDA<br/>Bearer Token Auth"]
        end

        subgraph ControlPlane["CONTROL PLANE"]
            K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        end

        subgraph LegacyController["LEGACY CONTROLLER (Deprecated)"]
            WVA["WVA Controller<br/>SA: controller-manager"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (self-signed / service-ca)<br/>TokenReview + SAR"]
        end
    end

    %% Current architecture flows
    vLLM -->|HTTP/8200<br/>Plaintext<br/>No Auth| Prometheus
    KEDA -->|HTTPS/9090<br/>TLS 1.2+<br/>Bearer Token| Prometheus
    KEDA -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount| K8sAPI

    %% Legacy controller flows
    WVA -->|HTTPS/9090<br/>TLS 1.2+<br/>Bearer Token / mTLS| Prometheus
    WVA -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount| K8sAPI
    Prometheus -->|HTTPS/8443<br/>TLS<br/>TokenReview + SAR| MetricsEndpoint

    %% Styling
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef scaling fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef legacy fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef exporters fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class vLLM exporters
    class Prometheus monitoring
    class KEDA scaling
    class K8sAPI controlplane
    class WVA,HealthProbe,MetricsEndpoint legacy
