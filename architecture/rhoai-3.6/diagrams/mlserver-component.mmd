graph TB
    subgraph External["External Clients"]
        Client[Client Application]
    end

    subgraph KServePod["KServe Pod"]
        subgraph AuthProxy["Authentication Layer"]
            KRBAC["kube-rbac-proxy<br/>OAuth/SA Token Validation"]
        end

        subgraph MLServerCore["MLServer Core"]
            REST["REST Server<br/>(FastAPI/uvicorn)<br/>8080/TCP"]
            GRPC["gRPC Server<br/>(grpc.aio)<br/>8081/TCP"]
            Metrics["Metrics Server<br/>(starlette-exporter)<br/>8082/TCP"]

            DataPlane["DataPlane Handler<br/>V2 Inference Protocol"]
            ModelRepo["ModelRepositoryHandler<br/>Model Lifecycle"]
            Registry["Model Registry<br/>Runtime Discovery"]
            Batcher["Adaptive Batcher<br/>Request Batching"]
            InferPool["Parallel Inference Pool<br/>Worker Management"]
            RuntimeSec["RuntimeSecurity<br/>Trusted Runtimes Enforcement"]
        end

        subgraph Runtimes["Pluggable ML Runtimes"]
            SKLearn["mlserver-sklearn"]
            XGBoost["mlserver-xgboost"]
            LightGBM["mlserver-lightgbm"]
            ONNX["mlserver-onnx<br/>(CPU / CUDA)"]
            MLflow["mlserver-mlflow"]
            HuggingFace["mlserver-huggingface"]
            AlibiDetect["mlserver-alibi-detect"]
            AlibiExplain["mlserver-alibi-explain"]
            CatBoost["mlserver-catboost"]
            MLlib["mlserver-mllib"]
        end
    end

    subgraph Platform["Platform Services"]
        KServeCtrl["KServe Controller"]
        Prometheus["Prometheus"]
        OTLPCol["OTLP Collector"]
    end

    subgraph Storage["Storage"]
        ModelStorage["Model Storage<br/>/mnt/models<br/>(PVC / S3)"]
    end

    %% Client flows
    Client -->|"REST 8080/TCP"| KRBAC
    Client -->|"gRPC 8081/TCP"| KRBAC
    KRBAC -->|"HTTP (pod-local)"| REST
    KRBAC -->|"gRPC (pod-local)"| GRPC

    %% Internal routing
    REST --> DataPlane
    GRPC --> DataPlane
    DataPlane --> Registry
    DataPlane --> Batcher
    Batcher --> InferPool
    ModelRepo --> Registry
    RuntimeSec -->|"validates"| Registry

    %% Runtime dispatch
    Registry --> SKLearn
    Registry --> XGBoost
    Registry --> LightGBM
    Registry --> ONNX
    Registry --> MLflow
    Registry --> HuggingFace
    Registry --> AlibiDetect
    Registry --> AlibiExplain
    Registry --> CatBoost
    Registry --> MLlib

    %% Platform integrations
    KServeCtrl -->|"manages lifecycle"| KServePod
    Prometheus -->|"scrapes /metrics"| Metrics
    REST -.->|"OTLP/gRPC traces"| OTLPCol

    %% Storage
    KServePod -->|"reads models"| ModelStorage

    %% Styles
    style REST fill:#4a90e2,color:#fff
    style GRPC fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style DataPlane fill:#5ba3f5,color:#fff
    style ModelRepo fill:#5ba3f5,color:#fff
    style Registry fill:#5ba3f5,color:#fff
    style RuntimeSec fill:#e74c3c,color:#fff
    style KRBAC fill:#e74c3c,color:#fff
    style SKLearn fill:#7ed321,color:#fff
    style XGBoost fill:#7ed321,color:#fff
    style LightGBM fill:#7ed321,color:#fff
    style ONNX fill:#7ed321,color:#fff
    style MLflow fill:#7ed321,color:#fff
    style HuggingFace fill:#7ed321,color:#fff
    style AlibiDetect fill:#7ed321,color:#fff
    style AlibiExplain fill:#7ed321,color:#fff
    style CatBoost fill:#7ed321,color:#fff
    style MLlib fill:#7ed321,color:#fff
    style KServeCtrl fill:#999,color:#fff
    style Prometheus fill:#999,color:#fff
    style OTLPCol fill:#999,color:#fff
    style ModelStorage fill:#f5a623,color:#fff
