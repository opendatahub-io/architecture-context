graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Administrator<br/>(kubectl / helm / ArgoCD)"]
        CatalogSources["OLM Catalog Sources<br/>redhat-operators<br/>certified-operators<br/>community-operators"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        InferenceGW["inference-gateway<br/>80/TCP, 443/TCP<br/>TLS Terminate<br/>cert: inference-gateway-cert-secret"]
        MaaSGW["maas-default-gateway<br/>80/TCP, 443/TCP<br/>TLS Terminate<br/>cert: maas-gateway-cert-secret"]
        OCPGW["openshift-ai-inference<br/>443/TCP<br/>TLS Terminate"]
        MaaSRoute["maas-gateway-route<br/>443/TCP Re-encrypt<br/>(OpenShift Route, optional)"]
    end

    subgraph Internal["INTERNAL SERVICES"]
        direction TB

        subgraph OperatorNS["Namespace: redhat-ods-operator"]
            Webhook["rhai-operator-webhook-service<br/>9443/TCP HTTPS<br/>TLS: cert-manager<br/>Auth: mTLS"]
            Metrics["metrics-service<br/>8080/TCP HTTP<br/>No encryption"]
        end

        subgraph CertMgrNS["Namespace: cert-manager"]
            CertMgr["cert-manager<br/>CA Issuer: rhai-ca"]
        end

        subgraph KuadrantNS["Namespace: redhat-connectivity-link"]
            Authorino["Authorino<br/>clusterWide: true<br/>TLS listener enabled<br/>cert: authorino-server-cert"]
        end

        subgraph HookJobNS["Namespace: istio-system / app-ns"]
            HookJobs["Helm Hook Jobs<br/>(XKS only)<br/>Gateway + DSC creation"]
        end
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig / SA token"| APIServer
    CatalogSources -->|"HTTPS/443<br/>TLS 1.2+<br/>OLM pulls"| APIServer

    %% API Server to internal
    APIServer -->|"Webhook call<br/>HTTPS/9443<br/>mTLS"| Webhook
    APIServer -->|"Metrics scrape<br/>HTTP/8080"| Metrics

    %% Hook jobs
    HookJobs -->|"HTTPS/6443<br/>SA token"| APIServer
    HookJobs -->|"kubectl get secret<br/>CA bundle"| CertMgr
    HookJobs -->|"kubectl patch<br/>SSL_CERT_FILE"| Authorino

    %% Cert-manager provisions
    CertMgr -.->|"provisions TLS certs"| InferenceGW
    CertMgr -.->|"provisions TLS certs"| MaaSGW
    CertMgr -.->|"provisions TLS certs"| Webhook
    CertMgr -.->|"provisions TLS certs"| Authorino

    %% Auth enforcement
    Authorino -.->|"AuthPolicy<br/>enforcement"| InferenceGW
    Authorino -.->|"AuthPolicy<br/>enforcement"| MaaSGW

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Admin,CatalogSources external
    class InferenceGW,MaaSGW,OCPGW,MaaSRoute ingress
    class Webhook,Metrics,CertMgr,Authorino,HookJobs internal
    class APIServer control
