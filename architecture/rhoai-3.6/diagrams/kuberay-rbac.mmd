graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kuberay-operator<br/>(redhat-ods-applications)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["kuberay-operator<br/>(cluster-scoped)"]
        CRB_ConfigMap["kuberay-operator-configmap<br/>(ns: redhat-ods-applications)"]
        CRB_Gateway["kuberay-operator-gateway-api<br/>(ns: redhat-ods-applications)"]
        CRB_Leader["kuberay-operator-leader-election<br/>(ns: operator namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["kuberay-operator"]
        CR_TLS["kuberay-tls-profile-role"]
        CR_Edit["kuberay-edit-role<br/>(aggregated to admin/edit)"]
        CR_View["kuberay-view-role<br/>(aggregated to view)"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["(core)<br/>pods, pods/status"]
        Services["(core)<br/>services"]
        ConfigMaps["(core)<br/>configmaps"]
        Events["(core)<br/>events"]
        ServiceAcctRes["(core)<br/>serviceaccounts"]
        Secrets["(core)<br/>secrets"]
    end

    subgraph RayResources["Ray API Resources"]
        RayClusters["ray.io<br/>rayclusters (+finalizers, +status)"]
        RayJobs["ray.io<br/>rayjobs (+finalizers, +status)"]
        RayServices["ray.io<br/>rayservices (+finalizers, +status)"]
        RayCronJobs["ray.io<br/>raycronjobs (+finalizers, +status)"]
    end

    subgraph ExtResources["Extended API Resources"]
        BatchJobs["batch<br/>jobs"]
        Deployments["apps<br/>deployments"]
        CertMgrRes["cert-manager.io<br/>certificates, issuers"]
        GatewayRes["gateway.networking.k8s.io<br/>gateways, httproutes, referencegrants"]
        NetworkRes["networking.k8s.io<br/>ingresses, networkpolicies"]
        RouteRes["route.openshift.io<br/>routes"]
        RBACRes["rbac.authorization.k8s.io<br/>roles, rolebindings"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    %% SA → Bindings
    SA -->|bound via| CRB_Main
    SA -->|bound via| CRB_ConfigMap
    SA -->|bound via| CRB_Gateway
    SA -->|bound via| CRB_Leader

    %% Bindings → Roles
    CRB_Main -->|grants| CR_Main
    CRB_ConfigMap -->|grants| CR_Main
    CRB_Gateway -->|grants| CR_Main

    %% Main role → Resources (CRUD)
    CR_Main -->|"CRUD + watch"| Pods
    CR_Main -->|"CRUD + watch"| Services
    CR_Main -->|"CRUD + watch"| ConfigMaps
    CR_Main -->|"CRUD + watch"| Events
    CR_Main -->|"CRUD + watch"| ServiceAcctRes
    CR_Main -->|"CRUD + watch"| Secrets
    CR_Main -->|"CRUD + watch"| RayClusters
    CR_Main -->|"CRUD + watch"| RayJobs
    CR_Main -->|"CRUD + watch"| RayServices
    CR_Main -->|"CRUD + watch"| RayCronJobs
    CR_Main -->|"CRUD + watch"| BatchJobs
    CR_Main -->|"get, list, patch,<br/>update, watch"| Deployments
    CR_Main -->|"CRUD + watch"| CertMgrRes
    CR_Main -->|"CRUD + watch"| GatewayRes
    CR_Main -->|"CRUD + watch"| NetworkRes
    CR_Main -->|"CRUD + watch"| RouteRes
    CR_Main -->|"CRUD + watch"| RBACRes
    CR_Main -->|"create"| TokenReviews
    CR_Main -->|"create"| SAR

    %% TLS profile role
    CR_TLS -->|"get, list, watch"| APIServers

    %% Aggregate roles
    CR_Edit -->|"full CRUD"| RayClusters
    CR_Edit -->|"full CRUD"| RayJobs
    CR_Edit -->|"full CRUD"| RayServices
    CR_View -->|"get, list, watch"| RayClusters
    CR_View -->|"get, list, watch"| RayJobs
    CR_View -->|"get, list, watch"| RayServices

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333
    style CR_TLS fill:#f5a623,stroke:#333
    style CR_Edit fill:#f5a623,stroke:#333
    style CR_View fill:#f5a623,stroke:#333
    style RayClusters fill:#7ed321,stroke:#333
    style RayJobs fill:#7ed321,stroke:#333
    style RayServices fill:#7ed321,stroke:#333
    style RayCronJobs fill:#7ed321,stroke:#333
