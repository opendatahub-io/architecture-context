graph TB
    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(redhat-ods-applications)"]
        direction TB
        Operator["data-science-pipelines-operator<br/>SA: controller-manager<br/>Ports: 8080 (metrics), 8081 (health),<br/>9443 (webhook)"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OpenShiftAPI["OpenShift APIServer CR<br/>TLS Profile Configuration"]
    end

    subgraph PipelineStack["PER-NAMESPACE PIPELINE STACK<br/>(per DSPA CR)"]
        direction TB
        APIServer["API Server"]
        PersistenceAgent["Persistence Agent"]
        ScheduledWF["Scheduled Workflow Controller"]
        ArgoCtrl["Argo Workflow Controller"]
        MLMDServer["MLMD Server + Envoy"]
        InternalDB["MariaDB (optional)"]
        InternalMinio["MinIO (optional)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB
        MariaDB["MariaDB<br/>3306/TCP MySQL<br/>TLS optional<br/>Username/Password"]
        S3["S3 / MinIO Object Store<br/>443/TCP or 9000/TCP<br/>HTTPS/HTTP<br/>Access Key / IAM"]
    end

    subgraph PlatformIntegrations["INTERNAL PLATFORM (via K8s API)"]
        direction TB
        KServe["KServe<br/>CRD CRUD"]
        MLflow["MLflow<br/>CRD Watch"]
        Prometheus["Prometheus<br/>ServiceMonitor CRUD"]
        CodeFlare["CodeFlare<br/>AppWrapper CRUD"]
        Ray["Ray<br/>RayCluster CRUD"]
    end

    %% Flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>(39 RBAC rules)"| K8sAPI
    Operator -->|"HTTPS/6443<br/>Watch TLS Profile<br/>ServiceAccount"| OpenShiftAPI
    Operator -->|"Deploys via manifestival<br/>templates + owner refs"| PipelineStack
    Operator -->|"MySQL/3306<br/>TLS optional<br/>Username/Password"| MariaDB
    Operator -->|"HTTPS/443<br/>TLS optional<br/>Access Key"| S3
    K8sAPI -->|"CRD operations<br/>TLS 1.2+"| PlatformIntegrations

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px,color:#000
    classDef pipeline fill:#d5e8d4,stroke:#82b366,stroke-width:1px,color:#000
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000
    classDef platform fill:#7ed321,stroke:#333,stroke-width:1px,color:#000

    class Operator operator
    class K8sAPI,OpenShiftAPI controlplane
    class APIServer,PersistenceAgent,ScheduledWF,ArgoCtrl,MLMDServer,InternalDB,InternalMinio pipeline
    class MariaDB,S3 external
    class KServe,MLflow,Prometheus,CodeFlare,Ray platform
