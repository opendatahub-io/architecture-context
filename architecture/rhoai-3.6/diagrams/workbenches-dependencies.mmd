graph LR
    Workbenches["Workbenches<br/>(Kubeflow Notebooks v2)"]

    %% External Dependencies (build/runtime)
    Workbenches -->|"operator framework"| ControllerRuntime["controller-runtime v0.22.1"]
    Workbenches -->|"API client"| ClientGo["client-go v0.34.1"]
    Workbenches -->|"authn/authz framework"| APIServer["k8s.io/apiserver v0.34.1"]
    Workbenches -->|"pod metrics"| MetricsClient["k8s.io/metrics v0.34.1"]

    %% Conditional networking dependencies
    Workbenches -->|"VirtualService client<br/>(when --use-istio)"| IstioClient["istio.io/client-go v1.22.8"]
    Workbenches -->|"HTTPRoute types<br/>(when --use-kube-gateway)"| GatewayAPITypes["gateway-api v1.4.1"]

    %% Backend dependencies
    Workbenches -->|"HTTP routing"| HTTPRouter["httprouter v1.3.0"]
    Workbenches -.->|"optional"| Swagger["http-swagger v2.0.2"]

    %% Frontend dependencies
    Workbenches -->|"UI components"| PatternFly["PatternFly v6.4.0"]
    Workbenches -->|"SPA framework"| React["React 18"]
    Workbenches -->|"HTTP client"| Axios["axios v1.15.0"]

    %% Internal Platform Dependencies
    Workbenches -->|"HTTPRoute CRUD"| GatewayAPI["Gateway API<br/>(gateway.networking.k8s.io)"]
    Workbenches -->|"VirtualService CRUD"| Istio["Istio"]
    Workbenches -->|"TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>(config.openshift.io/v1)"]
    Workbenches -->|"pod metrics"| MetricsAPI["Kubernetes Metrics API<br/>(metrics.k8s.io/v1beta1)"]
    Workbenches -->|"all resource ops"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Integration Points (things that use Workbenches)
    Dashboard["ODH Dashboard"] -.->|"UI integration"| Workbenches
    Operator["RHOAI Operator"] -.->|"deploys"| Workbenches

    %% Webhook cert
    CertManager["cert-manager"] -->|"webhook TLS cert"| Workbenches

