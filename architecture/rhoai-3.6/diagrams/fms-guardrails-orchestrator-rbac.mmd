graph TD
    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB

        subgraph NoRBAC["No Kubernetes RBAC"]
            Note1["No ClusterRoles defined<br/>No RoleBindings defined<br/>User-space application service"]
        end

        subgraph HeaderAuth["Header-Based Auth (Passthrough)"]
            direction TB
            IncomingHeaders["Incoming Request Headers"]
            HeaderFilter["Header Passthrough Filter<br/>Configured header keys"]
            ForwardedToken["X-Forwarded-Access-Token<br/>→ Authorization: Bearer rewrite"]
            DownstreamHeaders["Headers forwarded to<br/>all downstream services"]

            IncomingHeaders --> HeaderFilter
            IncomingHeaders --> ForwardedToken
            HeaderFilter --> DownstreamHeaders
            ForwardedToken --> DownstreamHeaders
        end

        subgraph TLSAuth["TLS / mTLS Authentication"]
            direction TB
            ServerTLS["Server TLS<br/>rustls + ring<br/>Port 8033/TCP"]
            ClientVerify["Client Certificate Verification<br/>WebPkiClientVerifier<br/>(optional mTLS)"]
            OutboundTLS["Outbound Client TLS<br/>Per-service configurable"]
            InsecureMode["NoVerifier Mode<br/>(insecure: true)<br/>⚠ Disables ALL cert verification"]

            ServerTLS --> ClientVerify
            OutboundTLS --> InsecureMode
        end

        subgraph Secrets["Secrets"]
            direction TB
            ServerCert["TLS server cert/key<br/>kubernetes.io/tls<br/>Provisioned by: Platform operator"]
            ClientCA["TLS client CA cert<br/>Opaque<br/>Provisioned by: Platform operator"]
            APITokens["API tokens (env vars)<br/>Opaque<br/>Bearer tokens for detectors/OpenAI"]
            DownstreamCerts["Downstream TLS certs<br/>Opaque<br/>Client certs for mTLS"]
        end
    end

    style Note1 fill:#e8e8e8,stroke:#999
    style IncomingHeaders fill:#4a90e2,color:#fff
    style HeaderFilter fill:#4a90e2,color:#fff
    style ForwardedToken fill:#4a90e2,color:#fff
    style DownstreamHeaders fill:#7ed321,color:#fff
    style ServerTLS fill:#f5a623,color:#fff
    style ClientVerify fill:#f5a623,color:#fff
    style OutboundTLS fill:#f5a623,color:#fff
    style InsecureMode fill:#e74c3c,color:#fff
    style ServerCert fill:#ddd,stroke:#999
    style ClientCA fill:#ddd,stroke:#999
    style APITokens fill:#ddd,stroke:#999
    style DownstreamCerts fill:#ddd,stroke:#999
