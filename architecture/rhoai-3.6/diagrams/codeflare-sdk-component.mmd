graph TB
    subgraph SDK["CodeFlare SDK (Python Library)"]
        direction TB

        subgraph Facade["Codeflare Facade"]
            CF["Codeflare Class<br/>(Single Entrypoint)"]
            ClusterHandler["ClusterHandler"]
            JobHandler["JobHandler"]
            CF --> ClusterHandler
            CF --> JobHandler
        end

        subgraph Auth["Authentication Layer"]
            KubeAuthkit["kube-authkit<br/>(auto-detect, OIDC,<br/>OpenShift OAuth)"]
            ContextVar["ContextVar Binding<br/>(_active_api_client)"]
            BoundDecorator["@_bound_to_api_client<br/>Decorator"]
            KubeAuthkit --> ContextVar
            ContextVar --> BoundDecorator
        end

        subgraph ClusterMgmt["Cluster Management (ray/cluster/)"]
            BuildCluster["build_ray_cluster"]
            ClusterConfig["ClusterConfiguration<br/>(dataclass)"]
            WorkerGroups["WorkerGroup Specs<br/>(heterogeneous)"]
            DashboardURL["Dashboard URL Resolver<br/>(HTTPRoute / Route / Ingress)"]
            ClusterConfig --> BuildCluster
            WorkerGroups --> ClusterConfig
        end

        subgraph JobMgmt["Job Management (ray/rayjobs/)"]
            RayJobClass["RayJob Class"]
            VendoredClient["Vendored KubeRay<br/>Python Client"]
            RayJobClient["RayJobClient<br/>(JobSubmissionClient wrapper)"]
            RayJobClass --> VendoredClient
        end

        subgraph TLS["TLS / Certificate Management"]
            GenCert["generate_cert Module"]
            RSA["RSA-3072 Keys<br/>SHA-256 Signatures"]
            mTLS["mTLS Certificates<br/>(CA + Client)"]
            GenCert --> RSA
            GenCert --> mTLS
        end

        subgraph KueueIntegration["Kueue Integration"]
            KueueModule["kueue.py"]
            QueueLabeling["Queue Labeling<br/>(kueue.x-k8s.io/queue-name)"]
            AutoscaleGating["Autoscaling Gating<br/>(RHOAI-managed check)"]
            KueueModule --> QueueLabeling
            KueueModule --> AutoscaleGating
        end

        CF --> KubeAuthkit
        ClusterHandler --> BuildCluster
        ClusterHandler --> DashboardURL
        ClusterHandler --> GenCert
        ClusterHandler --> KueueModule
        JobHandler --> RayJobClass
        JobHandler --> RayJobClient
    end

    User["Data Scientist<br/>(Jupyter Workbench)"] -->|instantiates| CF

    CF -->|authenticated calls| K8sAPI["Kubernetes API Server<br/>6443/TCP"]
    BuildCluster -->|server-side apply| RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobClass -->|creates| RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    KueueModule -->|queries| LocalQueue["LocalQueue CR<br/>(kueue.x-k8s.io)"]
    RayJobClient -->|submits jobs| RayHead["Ray Head Node<br/>8265/TCP"]

    style CF fill:#4a90e2,color:#fff
    style ClusterHandler fill:#4a90e2,color:#fff
    style JobHandler fill:#4a90e2,color:#fff
    style KubeAuthkit fill:#6c5ce7,color:#fff
    style ContextVar fill:#6c5ce7,color:#fff
    style GenCert fill:#e17055,color:#fff
    style RayClusterCR fill:#f5a623
    style RayJobCR fill:#f5a623
    style LocalQueue fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style RayHead fill:#e8e8e8
    style User fill:#2ecc71,color:#fff
