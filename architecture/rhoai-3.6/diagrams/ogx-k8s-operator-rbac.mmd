graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Main["ogx-k8s-operator-controller-manager<br/>(operator namespace)"]
        SA_Module["operator<br/>(ogx-module)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["ogx-k8s-operator-manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-proxy-rolebinding"]
        CRB_Module["manager-cluster-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["ogx-k8s-operator-leader-election-rolebinding<br/>(ns: ogx-k8s-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ogx-k8s-operator-manager-role"]
        CR_Proxy["ogx-k8s-operator-proxy-role"]
        CR_Metrics["ogx-k8s-operator-metrics-reader"]
        CR_Editor["ogx-k8s-operator-ogxserver-editor-role<br/>(aggregated to admin/edit)"]
        CR_Viewer["ogx-k8s-operator-ogxserver-viewer-role<br/>(aggregated to view)"]
        CR_Module["manager-cluster-role<br/>(ogx-module)"]
    end

    subgraph Roles["Namespace Roles"]
        R_Leader["ogx-k8s-operator-leader-election-role"]
    end

    subgraph Resources_Core["Core API Resources"]
        OGXServers["ogx.io<br/>OGXServers (+finalizers, +status)"]
        Deployments["apps<br/>Deployments"]
        CoreResources["core<br/>ConfigMaps, PVCs,<br/>ServiceAccounts, Services"]
        Secrets["core<br/>Secrets (read-only)"]
    end

    subgraph Resources_Network["Network & Scaling"]
        NetResources["networking.k8s.io<br/>Ingresses, NetworkPolicies"]
        HPAs["autoscaling<br/>HPAs"]
        Jobs["batch<br/>Jobs (+status)"]
        PDBs["policy<br/>PodDisruptionBudgets"]
    end

    subgraph Resources_Platform["Platform Resources"]
        Monitoring["monitoring.coreos.com<br/>PrometheusRules, ServiceMonitors"]
        RBAC_Resources["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings,<br/>RoleBindings"]
        SCC["security.openshift.io<br/>SecurityContextConstraints<br/>(nonroot-v2)"]
        APIServerConfig["config.openshift.io<br/>APIServers"]
    end

    subgraph Resources_Module["Module Resources"]
        OGXComponent["components.platform.opendatahub.io<br/>OGXs (+finalizers, +status)"]
        Webhooks["admissionregistration.k8s.io<br/>ValidatingWebhookConfigs"]
        CRDs["apiextensions.k8s.io<br/>CRDs"]
        ModuleRBAC["rbac.authorization.k8s.io<br/>ClusterRoles, Bindings, Roles"]
    end

    subgraph Resources_Auth["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% SA to CRB
    SA_Main -->|bound via| CRB_Manager
    SA_Main -->|bound via| CRB_Proxy
    SA_Main -->|bound via| RB_Leader
    SA_Module -->|bound via| CRB_Module

    %% CRB to CR
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_Module -->|grants| CR_Module
    RB_Leader -->|grants| R_Leader

    %% CR_Manager permissions
    CR_Manager -->|"CRUD + watch"| OGXServers
    CR_Manager -->|"CRUD + watch"| Deployments
    CR_Manager -->|"CRUD + watch"| CoreResources
    CR_Manager -->|"get, list, watch"| Secrets
    CR_Manager -->|"CRUD + watch"| NetResources
    CR_Manager -->|"CRUD + watch"| HPAs
    CR_Manager -->|"CRUD + watch"| Jobs
    CR_Manager -->|"CRUD + watch"| PDBs
    CR_Manager -->|"CRUD + watch"| Monitoring
    CR_Manager -->|"get, list, watch, delete"| RBAC_Resources
    CR_Manager -->|"use"| SCC
    CR_Manager -->|"get, list, watch"| APIServerConfig

    %% CR_Proxy permissions
    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR

    %% CR_Metrics permissions
    CR_Metrics -->|"get"| MetricsURL

    %% CR_Editor / CR_Viewer
    CR_Editor -->|"CRUD + watch"| OGXServers
    CR_Viewer -->|"get, list, watch"| OGXServers

    %% CR_Module permissions
    CR_Module -->|"CRUD + watch"| OGXComponent
    CR_Module -->|"CRUD + watch"| Webhooks
    CR_Module -->|"CRUD + watch"| CRDs
    CR_Module -->|"CRUD + watch"| ModuleRBAC

    style SA_Main fill:#4a90e2,stroke:#333,color:#fff
    style SA_Module fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_Editor fill:#f5a623,stroke:#333
    style CR_Viewer fill:#f5a623,stroke:#333
    style CR_Module fill:#f5a623,stroke:#333
    style R_Leader fill:#ffe6cc,stroke:#d79b00
    style OGXServers fill:#7ed321,stroke:#333
    style OGXComponent fill:#7ed321,stroke:#333
