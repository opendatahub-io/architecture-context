graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Gateway / Istio)"]
        direction TB
        Gateway["Kubernetes Gateway / Istio Gateway<br/>443/TCP HTTPS<br/>TLS termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Workspaces["Namespace: kubeflow-workspaces"]
            direction TB
            Frontend["workspaces-frontend<br/>8080/TCP HTTP<br/>nginx (static assets)<br/>No auth"]
            Backend["workspaces-backend<br/>4000/TCP HTTP (optional TLS 1.3)<br/>SA: workspaces-backend<br/>Auth: Bearer/header-based"]
            Controller["workspaces-controller<br/>8081/TCP health, 9443/TCP webhook<br/>SA: workspaces-controller<br/>TLS: OpenShift profile / Intermediate"]
            WebhookSvc["workspaces-webhook-service<br/>443/TCP → 9443/TCP<br/>HTTPS, TLS"]
        end

        subgraph NS_User["Namespace: user-namespace"]
            WorkspacePod["Workspace Pod<br/>(StatefulSet)<br/>IDE: JupyterLab / RStudio / VS Code"]
            PVC["PersistentVolumeClaim<br/>User data"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token / TokenReview"]

        MetricsAPI["Metrics API<br/>metrics.k8s.io/v1beta1"]

        subgraph NetworkRouting["Network Routing (conditional)"]
            HTTPRoute["HTTPRoute + ReferenceGrant<br/>(Gateway API mode)"]
            VirtualService["VirtualService<br/>(Istio mode)"]
        end
    end

    subgraph OpenShiftServices["OPENSHIFT SERVICES"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS profile config"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS<br/>Auth: Browser session"| Gateway
    Gateway -->|"HTTP/8080<br/>Internal"| Frontend
    Gateway -->|"HTTP(S)/4000<br/>Optional TLS 1.3<br/>Bearer token"| Backend

    %% Backend to K8s
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview"| K8sAPI
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SubjectAccessReview"| K8sAPI

    %% Controller to K8s
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Admission webhook
    K8sAPI -->|"HTTPS/443→9443<br/>TLS<br/>Admission"| WebhookSvc

    %% Controller to workspace
    Controller -.->|"HTTP/exec<br/>Activity probe"| WorkspacePod

    %% Metrics
    Backend -->|"HTTPS/6443<br/>TLS 1.2+"| MetricsAPI

    %% OpenShift TLS profile
    Controller -.->|"HTTPS/6443<br/>GET/WATCH<br/>TLS profile"| OpenShiftAPI

    %% Network routing
    Gateway -.-> HTTPRoute
    Gateway -.-> VirtualService
    HTTPRoute -.-> WorkspacePod
    VirtualService -.-> WorkspacePod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userspace fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8sapi fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef openshift fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class Gateway ingress
    class Frontend,Backend,Controller,WebhookSvc internal
    class WorkspacePod,PVC userspace
    class K8sAPI,MetricsAPI k8sapi
    class OpenShiftAPI openshift
    class HTTPRoute,VirtualService ingress
