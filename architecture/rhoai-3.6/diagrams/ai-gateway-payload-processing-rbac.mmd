graph TD
    subgraph "Service Account"
        SA["{name}-{release}<br/>in release namespace"]
    end

    subgraph "Binding"
        CRB["{release}-externalmodels-reader<br/>ClusterRoleBinding (multiNamespace=true)<br/>or RoleBinding (multiNamespace=false)"]
    end

    subgraph "ClusterRole"
        CR["{release}-externalmodels-reader"]
    end

    subgraph "Core API Resources"
        Secrets["core<br/>secrets"]
        Services["core<br/>services"]
    end

    subgraph "inference.opendatahub.io Resources"
        ExtProviders["inference.opendatahub.io<br/>externalproviders"]
        ExtModels["inference.opendatahub.io<br/>externalmodels"]
        ExtProvStatus["inference.opendatahub.io<br/>externalproviders/status"]
        ExtModStatus["inference.opendatahub.io<br/>externalmodels/status"]
        ExtProvFin["inference.opendatahub.io<br/>externalproviders/finalizers"]
        ExtModFin["inference.opendatahub.io<br/>externalmodels/finalizers"]
    end

    subgraph "Legacy API Resources"
        LegacyModels["maas.opendatahub.io<br/>externalmodels"]
    end

    subgraph "Gateway API Resources"
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
    end

    subgraph "Istio Resources"
        ServiceEntries["networking.istio.io<br/>serviceentries"]
        DestRules["networking.istio.io<br/>destinationrules"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR

    CR -->|"get, list, watch"| Secrets
    CR -->|"get, list, watch,<br/>create, update, delete"| Services

    CR -->|"get, list, watch"| LegacyModels

    CR -->|"get, list, watch,<br/>create, update"| ExtProviders
    CR -->|"get, list, watch,<br/>create, update"| ExtModels
    CR -->|"get, update, patch"| ExtProvStatus
    CR -->|"get, update, patch"| ExtModStatus
    CR -->|"update"| ExtProvFin
    CR -->|"update"| ExtModFin

    CR -->|"get, list, watch,<br/>create, update, delete"| HTTPRoutes

    CR -->|"get, list, watch,<br/>create, update, delete"| ServiceEntries
    CR -->|"get, list, watch,<br/>create, update, delete"| DestRules

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#b8d4e3,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style Secrets fill:#d5e8d4,stroke:#333
    style Services fill:#d5e8d4,stroke:#333
    style ExtProviders fill:#7ed321,stroke:#333
    style ExtModels fill:#7ed321,stroke:#333
    style ExtProvStatus fill:#7ed321,stroke:#333
    style ExtModStatus fill:#7ed321,stroke:#333
    style ExtProvFin fill:#7ed321,stroke:#333
    style ExtModFin fill:#7ed321,stroke:#333
    style LegacyModels fill:#f5a623,stroke:#333
    style HTTPRoutes fill:#dae8fc,stroke:#333
    style ServiceEntries fill:#e1d5e7,stroke:#333
    style DestRules fill:#e1d5e7,stroke:#333
