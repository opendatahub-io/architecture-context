graph TD
    subgraph "Application-Level Authentication (Starter Kit)"
        Client["Client Request<br/>Bearer token"]
        AuthMiddleware["_BearerAuthMiddleware<br/>(ASGI Middleware)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
        TokenReview["TokenReview API<br/>(authentication.k8s.io/v1)"]
    end

    subgraph "Protected Endpoints"
        Responses["POST /v1/responses<br/>(Auth Required)"]
    end

    subgraph "Unprotected Endpoints"
        Health["GET /health<br/>(No Auth)"]
    end

    subgraph "Authorization Checks"
        ValidateToken["Validate Bearer Token"]
        CheckSA["Check ALLOWED_SA_USERNAME<br/>(Optional)"]
    end

    subgraph "Configuration"
        K8S_API_URL["K8S_API_URL<br/>(K8s API endpoint)"]
        K8S_REVIEWER_TOKEN["K8S_REVIEWER_TOKEN<br/>(ServiceAccount token)"]
        ALLOWED_SA["ALLOWED_SA_USERNAME<br/>(Optional SA restriction)"]
        K8S_CA["K8S_CA_PATH<br/>(/var/run/secrets/.../ca.crt)"]
    end

    %% Auth flow
    Client -->|"sends Bearer token"| AuthMiddleware
    AuthMiddleware -->|"path check"| Responses
    AuthMiddleware -->|"bypass (not protected)"| Health

    AuthMiddleware -->|"POST TokenReview"| K8sAPI
    K8sAPI --> TokenReview
    TokenReview -->|"authenticated: true/false"| ValidateToken
    ValidateToken -->|"if ALLOWED_SA_USERNAME set"| CheckSA
    CheckSA -->|"username matches"| Responses
    ValidateToken -->|"if no SA restriction"| Responses

    %% Config references
    K8S_API_URL -.->|configures| AuthMiddleware
    K8S_REVIEWER_TOKEN -.->|authenticates reviewer| K8sAPI
    ALLOWED_SA -.->|restricts access| CheckSA
    K8S_CA -.->|TLS verification| K8sAPI

    %% Styling
    style Client fill:#f9f9f9,stroke:#999
    style AuthMiddleware fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style TokenReview fill:#e8e8e8,stroke:#333
    style Responses fill:#7ed321,stroke:#333,color:#fff
    style Health fill:#7ed321,stroke:#333,color:#fff
    style ValidateToken fill:#4a90e2,stroke:#333,color:#fff
    style CheckSA fill:#4a90e2,stroke:#333,color:#fff

    %% Note: ai4rag has no Kubernetes RBAC (ClusterRoles/RoleBindings)
    %% Authentication is application-level via K8s TokenReview API
