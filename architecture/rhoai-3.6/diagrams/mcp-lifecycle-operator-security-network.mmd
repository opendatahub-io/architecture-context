graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
        ExtClient["External MCP Client"]
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (mcp-lifecycle-operator-system)"]
        direction TB

        subgraph OperatorPod["Controller Manager Pod"]
            Manager["mcp-lifecycle-operator<br/>controller-manager<br/>SA: mcp-lifecycle-operator-controller-manager"]
        end

        WebhookSvc["webhook-service<br/>ClusterIP 443/TCP → 9443<br/>TLS (cert-manager)<br/>Kubernetes Admission"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS (self-signed / cert-manager)<br/>TokenReview + SAR"]
        HealthPort["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
    end

    subgraph UserNS["USER NAMESPACE (per-tenant)"]
        MCPPod["MCP Server Pod<br/>Deployment + Service + NetworkPolicy<br/>configurable/TCP<br/>HTTP or HTTPS"]
    end

    subgraph GatewayZone["GATEWAY ZONE"]
        GWResource["Gateway API Gateway<br/>TLS Terminated"]
        HTTPRoute["HTTPRoute<br/>(created by operator)"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        CertMgr["cert-manager<br/>Certificate Provisioning"]
        Prometheus["Prometheus<br/>(OpenShift Monitoring)"]
        Kuadrant["Kuadrant<br/>(Optional API Mgmt)"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User RBAC"| APIServer

    %% Control Plane → Operator
    APIServer -->|"HTTPS/443 → 9443<br/>TLS (cert-manager)<br/>Admission"| WebhookSvc
    APIServer -->|"Watch events<br/>HTTPS<br/>ServiceAccount"| Manager

    %% Operator → Control Plane
    Manager -->|"REST/6443<br/>HTTPS TLS 1.2+<br/>ServiceAccount token"| APIServer

    %% Operator → MCP Pod (handshake)
    Manager -->|"MCP Handshake<br/>HTTP or HTTPS<br/>TLS 1.2+ configurable<br/>None / custom CA"| MCPPod

    %% Gateway flow
    Manager -->|"CRUD HTTPRoute<br/>via API server"| HTTPRoute
    HTTPRoute ---|"routes to"| GWResource
    ExtClient -->|"HTTPS<br/>TLS (GW-terminated)"| GWResource
    GWResource -->|"forward to"| MCPPod

    %% Platform services
    CertMgr -.->|"TLS cert provisioning"| WebhookSvc
    CertMgr -.->|"TLS cert provisioning"| MetricsSvc
    Prometheus -->|"GET /metrics<br/>HTTPS/8443<br/>TLS<br/>TokenReview + SAR"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User,ExtClient external
    class APIServer controlplane
    class Manager,WebhookSvc,MetricsSvc,HealthPort operator
    class MCPPod tenant
    class GWResource,HTTPRoute gateway
    class CertMgr,Prometheus,Kuadrant platform
