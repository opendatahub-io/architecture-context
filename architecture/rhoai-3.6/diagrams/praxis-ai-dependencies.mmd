graph LR
    PraxisAI["Praxis AI Gateway"]

    %% Core Runtime Dependency
    PraxisAI -->|"proxy runtime<br/>filter framework<br/>TLS, LB, config"| PraxisCore["Praxis Core<br/>praxis-proxy 0.7.3"]
    PraxisCore -->|"HTTP proxy engine<br/>connection pooling"| Pingora["Pingora<br/>0.10.0"]

    %% Runtime Dependencies
    PraxisAI -->|"async runtime"| Tokio["tokio 1.53.1"]
    PraxisAI -->|"TLS (OpenSSL provider)"| Rustls["rustls 0.23.45"]
    PraxisAI -->|"SHA-256, HMAC, TLS provider"| OpenSSL["openssl 0.10.81"]
    PraxisAI -->|"serialization"| Serde["serde / serde_json<br/>serde_yaml"]
    PraxisAI -->|"token counting"| Tiktoken["tiktoken-rs 0.12.0"]
    PraxisAI -->|"allocator (Unix)"| Jemalloc["tikv-jemallocator 0.7.0"]

    %% Optional Dependencies
    PraxisAI -.->|"DB client (optional)"| SQLx["SQLx 0.9.0<br/>praxis-proxy fork"]
    PraxisAI -.->|"gRPC (optional)"| Tonic["tonic 0.14.6"]
    PraxisAI -.->|"protobuf (optional)"| Prost["prost 0.14.4"]
    PraxisAI -.->|"rate limit (optional)"| Redis["redis 1.7.0"]
    PraxisAI -.->|"MCP client (optional)"| RMCP["rmcp 3.4.0"]

    %% Integration Points - Inference
    PraxisAI -->|"REST inference"| vLLM["vLLM / Inference<br/>Backends"]
    PraxisAI -->|"HTTPS/443<br/>SigV4/Azure AD/GCP ADC"| CloudProviders["Cloud Providers<br/>AWS Bedrock<br/>Azure AI<br/>GCP Vertex"]

    %% Integration Points - Data
    PraxisAI -->|"SQL/5432<br/>TLS/mTLS"| PostgreSQL["PostgreSQL"]
    PraxisAI -.->|"TCP/6379"| Valkey["Valkey / Redis"]

    %% Integration Points - Services
    PraxisAI -.->|"REST guardrails"| NeMo["NeMo Guardrails"]
    PraxisAI -.->|"Streamable HTTP"| MCPServers["MCP Servers"]
    PraxisAI -.->|"gRPC ext_proc"| LLMd["llm-d ext_proc"]
    PraxisAI -.->|"HTTPS/443"| WebSearch["Web Search<br/>Providers"]
    PraxisAI -.->|"HTTPS"| VectorStore["Vector Store"]

