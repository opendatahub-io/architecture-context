graph TD
    subgraph PodSecurity["Pod Security Context"]
        Pod["AutoGluon Server Pod<br/>UID: 1001 (non-root)<br/>Read-only root filesystem"]
    end

    subgraph NoRBAC["No Direct RBAC"]
        Note["No ClusterRoles or RoleBindings<br/>Server does not access Kubernetes API"]
    end

    subgraph DelegatedRBAC["Delegated RBAC (KServe Operator)"]
        OperatorSA["KServe Operator<br/>ServiceAccount"]
        OperatorCRB["ClusterRoleBinding"]
        OperatorCR["KServe Manager Role"]
    end

    subgraph ManagedResources["Resources Managed by Operator"]
        CSR["ClusterServingRuntime<br/>kserve-autogluonserver"]
        IS["InferenceService<br/>(user-created)"]
        SVC["Service<br/>(auto-created per IS)"]
        Deploy["Deployment<br/>(auto-created per IS)"]
    end

    subgraph AuthDelegation["Authentication Delegation"]
        Gateway["Istio Gateway<br/>TLS Termination + JWT"]
        Mesh["Service Mesh<br/>mTLS Between Pods"]
    end

    subgraph Secrets["Secrets Access"]
        StorageCreds["Storage Credentials<br/>kubernetes.io/opaque<br/>S3/GCS/Azure IAM<br/>Mounted per-pod"]
    end

    Pod -->|"no K8s API calls"| NoRBAC
    OperatorSA -->|bound via| OperatorCRB
    OperatorCRB -->|grants| OperatorCR
    OperatorCR -->|"manages"| CSR
    OperatorCR -->|"manages"| IS
    OperatorCR -->|"creates"| SVC
    OperatorCR -->|"creates"| Deploy

    CSR -.->|"references"| Pod
    Deploy -.->|"runs"| Pod
    StorageCreds -.->|"mounted into"| Pod

    Gateway -->|"enforces auth"| Pod
    Mesh -->|"enforces mTLS"| Pod

    style Pod fill:#4a90e2,stroke:#333,color:#fff
    style NoRBAC fill:#f9f9f9,stroke:#ccc
    style Note fill:#fff3cd,stroke:#ffc107
    style OperatorSA fill:#7ed321,stroke:#333,color:#fff
    style OperatorCR fill:#f5a623,stroke:#333
    style CSR fill:#7ed321,stroke:#333,color:#fff
    style IS fill:#7ed321,stroke:#333,color:#fff
    style Gateway fill:#ffe6cc,stroke:#d79b00
    style Mesh fill:#d5e8d4,stroke:#82b366
    style StorageCreds fill:#f8d7da,stroke:#dc3545
