graph TB
    subgraph Operator["rhods-operator (opendatahub-operator-controller-manager)"]
        direction TB
        Manager["manager<br/>Go controller-runtime<br/>8443/TCP metrics<br/>9443/TCP webhook<br/>8081/TCP health"]

        subgraph Controllers["Platform Controllers"]
            DSCController["DSC Reconciler"]
            DSCIController["DSCI Reconciler"]
            GatewayController["Gateway Controller"]
            AuthController["Auth Controller"]
        end

        subgraph ComponentHandlers["Component Handlers (~16 modules)"]
            Dashboard["Dashboard"]
            KServeHandler["KServe"]
            RayHandler["Ray"]
            KueueHandler["Kueue"]
            ModelRegHandler["Model Registry"]
            TrustyAIHandler["TrustyAI"]
            WorkbenchesHandler["Workbenches"]
            PipelinesHandler["AI Pipelines"]
            OtherHandlers["AI Gateway, AI Hub,<br/>Data, ML Flow, MCP Lifecycle,<br/>OGX, Spark, Trainer, Monitoring"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutatingWH["Mutating Webhooks<br/>(DSC defaulting,<br/>PodMonitor mutation)"]
            ValidatingWH["Validating Webhooks<br/>(Singleton enforcement,<br/>HardwareProfile, AcceleratorProfile,<br/>GatewayConfig validation)"]
            ConversionWH["Conversion Webhooks<br/>(DSC v2↔v3, DSCI v1↔v2,<br/>Platform v1alpha1↔v1alpha2)"]
        end

        Manager --> Controllers
        Manager --> ComponentHandlers
        Manager --> Webhooks
    end

    subgraph CloudManager["cloudmanager (RHAII mode)"]
        CloudCtrl["Cloud Infrastructure Controller<br/>8081/TCP health"]
    end

    subgraph IngressStack["Gateway Ingress Stack"]
        KubeAuthProxy["kube-auth-proxy<br/>OIDC Authentication Proxy<br/>HPA-scaled"]
    end

    %% CRDs watched
    DSCCR["DataScienceCluster CR<br/>(Cluster-scoped singleton)"]
    DSCICR["DSCInitialization CR<br/>(Cluster-scoped singleton)"]
    GatewayConfigCR["GatewayConfig CR"]
    AuthCR["Auth CR"]

    %% Cloud CRDs
    AWSCR["AWSKubernetesEngine CR"]
    AzureCR["AzureKubernetesEngine CR"]
    CoreWeaveCR["CoreWeaveKubernetesEngine CR"]

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftAPI["OpenShift APIServer<br/>TLS Profile Config"]
    GatewayAPI["Gateway API<br/>(data-science-gateway)"]
    PrometheusOp["prometheus-operator"]
    OLM["OLM Subscriptions"]
    ServiceCA["OpenShift service-ca"]

    %% Flows
    DSCCR -->|watched by| DSCController
    DSCICR -->|watched by| DSCIController
    GatewayConfigCR -->|watched by| GatewayController
    AuthCR -->|watched by| AuthController

    AWSCR -->|watched by| CloudCtrl
    AzureCR -->|watched by| CloudCtrl
    CoreWeaveCR -->|watched by| CloudCtrl

    DSCController -->|"renders kustomize<br/>manifests"| ComponentHandlers
    GatewayController -->|deploys| IngressStack

    Manager -->|CRUD| K8sAPI
    Manager -->|reads TLS profile| OpenShiftAPI
    Manager -->|manages HTTPRoutes| GatewayAPI
    Manager -->|manages PodMonitors| PrometheusOp
    Manager -->|reads subscriptions| OLM
    ServiceCA -->|provisions certs| Manager

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    style CloudCtrl fill:#4a90e2,stroke:#333,color:#fff
    style KubeAuthProxy fill:#4a90e2,stroke:#333,color:#fff
    style DSCCR fill:#f5a623,stroke:#333
    style DSCICR fill:#f5a623,stroke:#333
    style GatewayConfigCR fill:#f5a623,stroke:#333
    style AuthCR fill:#f5a623,stroke:#333
    style AWSCR fill:#f5a623,stroke:#333
    style AzureCR fill:#f5a623,stroke:#333
    style CoreWeaveCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style PrometheusOp fill:#e8e8e8,stroke:#333
    style OLM fill:#e8e8e8,stroke:#333
    style ServiceCA fill:#e8e8e8,stroke:#333
