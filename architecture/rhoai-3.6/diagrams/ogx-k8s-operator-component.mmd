graph TB
    subgraph Platform["ODH/RHOAI Platform Layer"]
        OGX_CR["OGX CR<br/>(Cluster-scoped)"]
        OGXModule["ogx-module Controller<br/>Go controller-runtime"]
        OGXModule -->|renders manifests via| Kustomize_M["Kustomize<br/>(platform overlays)"]
        OGX_CR -->|watched by| OGXModule
        OGXModule -->|deploys| OperatorDeployment
    end

    subgraph OperatorLayer["ogx-k8s-operator"]
        OperatorDeployment["ogx-k8s-operator-controller-manager<br/>Deployment (single pod)"]

        subgraph Controllers["Controllers"]
            OGXServerReconciler["OGXServerReconciler<br/>Reconciles OGXServer CRs"]
            Webhook["Validating Webhook<br/>9443/TCP TLS"]
        end

        subgraph Runtime["Runtime Components"]
            DistRegistry["Distribution Registry<br/>(starter, remote-vLLM,<br/>meta-reference-gpu, postgres-demo)"]
            Kustomize_W["Kustomize Renderer<br/>(manifest transforms)"]
            TLSWatcher["SecurityProfileWatcher<br/>TLS profile monitor"]
        end

        OperatorDeployment --> Controllers
        OperatorDeployment --> Runtime
        OGXServerReconciler -->|uses| DistRegistry
        OGXServerReconciler -->|renders via| Kustomize_W
    end

    subgraph CRDs["Custom Resource Definitions"]
        OGXServerCR["OGXServer CR<br/>ogx.io/v1beta1<br/>(Namespaced)"]
        LegacyCR["LlamaStackDistribution CR<br/>llamastack.io/v1alpha1<br/>(Legacy adoption)"]
    end

    subgraph ManagedResources["Managed Workload Resources"]
        Deploy["Deployment"]
        Svc["Service"]
        PVC["PVC<br/>(no ownerRef)"]
        NetPol["NetworkPolicy"]
        PDB["PodDisruptionBudget"]
        HPA["HorizontalPodAutoscaler"]
        Ingress["Ingress"]
        SM["ServiceMonitor"]
        PR["PrometheusRule"]
    end

    User["User / GitOps"] -->|creates| OGXServerCR
    OGXServerCR -->|watched by| OGXServerReconciler
    LegacyCR -.->|adopted by| OGXServerReconciler

    OGXServerReconciler -->|creates via SSA| Deploy
    OGXServerReconciler -->|creates via SSA| Svc
    OGXServerReconciler -->|creates via SSA| PVC
    OGXServerReconciler -->|creates via SSA| NetPol
    OGXServerReconciler -->|creates via SSA| PDB
    OGXServerReconciler -->|creates via SSA| HPA
    OGXServerReconciler -->|creates via SSA| Ingress
    OGXServerReconciler -->|creates via SSA| SM
    OGXServerReconciler -->|creates via SSA| PR

    OGXServerReconciler -->|health poll| OGXPod["OGX Server Pod<br/>/v1/providers, /v1/version"]
    Webhook -->|validates| OGXServerCR
    TLSWatcher -->|monitors| OpenShiftAPI["OpenShift APIServer<br/>TLS Profile"]

    OGXServerReconciler -->|reads config| ConfigMap["ogx-operator-config<br/>ConfigMap"]

    style OperatorDeployment fill:#4a90e2,stroke:#333
    style OGXServerReconciler fill:#4a90e2,stroke:#333
    style Webhook fill:#4a90e2,stroke:#333
    style OGXModule fill:#7ed321,stroke:#333
    style OGXServerCR fill:#f5a623,stroke:#333
    style OGX_CR fill:#f5a623,stroke:#333
    style LegacyCR fill:#e8e8e8,stroke:#999
    style DistRegistry fill:#d5e8d4,stroke:#82b366
    style PVC fill:#ffe6cc,stroke:#d79b00
