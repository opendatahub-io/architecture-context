graph LR
    RegexDetector["guardrails-regex-detector<br/>(Rust Service)"]

    %% Runtime Integration (Inbound caller)
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"REST inbound<br/>POST /api/v1/text/contents<br/>HTTP 8080/TCP"| RegexDetector

    %% Rust Crate Dependencies
    subgraph RustDeps["Rust Crate Dependencies"]
        Axum["axum 0.7.9<br/>(HTTP framework)"]
        Regex["regex 1.11.1<br/>(pattern matching)"]
        Serde["serde 1.0.215<br/>(serialization)"]
        SerdeJson["serde_json 1.0.133<br/>(JSON)"]
        Tokio["tokio 1.41.1<br/>(async runtime)"]
        TowerHTTP["tower-http 0.6.2<br/>(HTTP middleware)"]
        Tracing["tracing 0.1.41<br/>(logging)"]
        TracingSub["tracing-subscriber 0.3.19<br/>(log output)"]
    end

    RegexDetector -->|"web framework"| Axum
    RegexDetector -->|"regex engine"| Regex
    RegexDetector -->|"JSON serde"| Serde
    RegexDetector -->|"JSON parsing"| SerdeJson
    RegexDetector -->|"async runtime"| Tokio
    RegexDetector -->|"middleware"| TowerHTTP
    RegexDetector -->|"diagnostics"| Tracing
    RegexDetector -->|"log formatting"| TracingSub

    %% Platform Dependencies (implicit)
    subgraph Platform["Platform Infrastructure"]
        Istio["Istio / Service Mesh<br/>(optional mTLS)"]
        K8s["Kubernetes<br/>(deployment platform)"]
    end

    RegexDetector -.->|"TLS termination<br/>(delegated)"| Istio
    RegexDetector -.->|"deployed on"| K8s

    style RegexDetector fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style Axum fill:#e8e8e8,stroke:#666
    style Regex fill:#e8e8e8,stroke:#666
    style Serde fill:#e8e8e8,stroke:#666
    style SerdeJson fill:#e8e8e8,stroke:#666
    style Tokio fill:#e8e8e8,stroke:#666
    style TowerHTTP fill:#e8e8e8,stroke:#666
    style Tracing fill:#e8e8e8,stroke:#666
    style TracingSub fill:#e8e8e8,stroke:#666
    style Istio fill:#fff2cc,stroke:#d6b656
    style K8s fill:#fff2cc,stroke:#d6b656
