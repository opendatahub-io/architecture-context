graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>OpenAI SDK / Anthropic SDK / MCP Agent"]
    end

    subgraph ProxyBoundary["PRAXIS AI PROXY (Application Boundary)"]
        direction TB

        subgraph Listener["Proxy Listener"]
            ProxyPort["Proxy<br/>8080/TCP<br/>HTTP/HTTPS<br/>TLS optional (system OpenSSL via rustls)"]
        end

        subgraph FilterPipeline["Filter Pipeline (Trust Enforcement)"]
            CredentialInject["credential_inject<br/>Security Filter"]
            PeerIdentity["peer_identity_trust<br/>SPIFFE Cert Digest"]
            StateOwner["state_owner<br/>Identity Scoping"]
            IdentityGuard["identity_header_guard<br/>Header Validation"]
        end

        subgraph AdminPort["Admin Interface"]
            HealthEndpoint["Health Endpoint<br/>9901/TCP<br/>HTTP, No TLS<br/>localhost-only by default"]
        end
    end

    subgraph InferenceBackends["INFERENCE BACKENDS"]
        vLLM["vLLM<br/>Configurable Port<br/>HTTP/HTTPS, TLS<br/>Bearer Token"]
        AWSBedrock["AWS Bedrock<br/>443/TCP<br/>HTTPS, TLS<br/>AWS SigV4 (HMAC-SHA256 via OpenSSL)"]
        AzureAI["Azure AI<br/>443/TCP<br/>HTTPS, TLS<br/>Azure AD Token"]
        GCPVertex["GCP Vertex AI<br/>443/TCP<br/>HTTPS, TLS<br/>GCP ADC"]
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TCP, TLS (mTLS optional)<br/>Password or Certificate Auth"]
        SQLite["SQLite<br/>Local File<br/>No Network"]
        Valkey["Valkey / Redis<br/>6379/TCP<br/>TCP, TLS optional<br/>Password optional"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        NeMo["NeMo Guardrails<br/>Configurable Port<br/>HTTP/HTTPS, TLS optional<br/>No Auth"]
        MCPServer["MCP Servers<br/>Configurable Port<br/>Streamable HTTP, TLS optional<br/>Configurable Auth"]
        ExtProc["llm-d ext_proc Server<br/>Configurable Port<br/>gRPC, TLS optional<br/>No Auth"]
        WebSearch["Web Search Providers<br/>443/TCP<br/>HTTPS, TLS<br/>API Key"]
        VectorStore["Vector Store<br/>Configurable Port<br/>HTTPS, TLS<br/>Bearer Token"]
    end

    %% Inbound flows
    Client -->|"HTTPS/8080<br/>TLS optional<br/>Bearer Token"| ProxyPort

    %% Security pipeline
    ProxyPort --> CredentialInject
    ProxyPort --> PeerIdentity
    ProxyPort --> StateOwner
    ProxyPort --> IdentityGuard

    %% Outbound to inference
    ProxyPort -->|"HTTP/HTTPS<br/>TLS<br/>Bearer / SigV4"| vLLM
    ProxyPort -->|"HTTPS/443<br/>TLS<br/>SigV4"| AWSBedrock
    ProxyPort -->|"HTTPS/443<br/>TLS<br/>Azure AD"| AzureAI
    ProxyPort -->|"HTTPS/443<br/>TLS<br/>GCP ADC"| GCPVertex

    %% Outbound to data stores
    ProxyPort -->|"TCP/5432<br/>TLS/mTLS<br/>Password/Cert"| PostgreSQL
    ProxyPort -->|"TCP/6379<br/>TLS optional<br/>Password optional"| Valkey

    %% Outbound to services
    ProxyPort -->|"HTTP/HTTPS<br/>TLS optional"| NeMo
    ProxyPort -->|"Streamable HTTP<br/>TLS optional"| MCPServer
    ProxyPort -->|"gRPC<br/>TLS optional"| ExtProc
    ProxyPort -->|"HTTPS/443<br/>TLS<br/>API Key"| WebSearch
    ProxyPort -->|"HTTPS<br/>TLS<br/>Bearer"| VectorStore

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef inference fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef admin fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class ProxyPort proxy
    class CredentialInject,PeerIdentity,StateOwner,IdentityGuard security
    class HealthEndpoint admin
    class vLLM,AWSBedrock,AzureAI,GCPVertex inference
    class PostgreSQL,SQLite,Valkey datastore
    class NeMo,MCPServer,ExtProc,WebSearch,VectorStore externalservice
