graph TB
    subgraph ModelRegistry["Model Registry (Kubeflow Hub)"]
        direction TB

        subgraph CoreServer["Core Server (Go)"]
            Server["model-registry<br/>REST API Server<br/>:8080/TCP"]
            GORM["GORM ORM Layer"]
            Migrations["golang-migrate<br/>Schema Migrations"]
            Server --> GORM
            Server --> Migrations
        end

        subgraph ControllerComp["Controller (Go)"]
            Controller["InferenceService Controller<br/>controller-runtime<br/>:8081/TCP probes | :8443/TCP metrics"]
            Finalizer["Finalizer Manager"]
            Controller --> Finalizer
        end

        subgraph BFFComp["BFF (Go)"]
            BFF["Backend-For-Frontend<br/>:8080/TCP"]
            AuthDelegation["Auth Delegation<br/>internal | user_token"]
            SARCheck["SubjectAccessReview<br/>Checker"]
            BFF --> AuthDelegation
            BFF --> SARCheck
        end

        subgraph UIComp["UI (TypeScript/React)"]
            UI["model-registry-ui<br/>React Frontend"]
        end

        subgraph CatalogComp["Catalog (Go)"]
            Catalog["Federated Catalog<br/>:8080/TCP"]
            HFProvider["HuggingFace Provider"]
            MCPProvider["MCP Server Provider"]
            RuntimeProvider["Serving Runtime Provider"]
            SkillProvider["Skill Catalog Provider"]
            Catalog --> HFProvider
            Catalog --> MCPProvider
            Catalog --> RuntimeProvider
            Catalog --> SkillProvider
        end

        subgraph CSIComp["Storage Initializer"]
            CSI["mr-storage-initializer<br/>model-registry:// URI"]
        end

        subgraph JobComp["Async Upload (Python)"]
            AsyncJob["async-upload Job<br/>boto3 + olot + oras"]
            Signing["rh-model-signing<br/>Sigstore"]
            AsyncJob --> Signing
        end
    end

    %% External interactions
    User["User / Data Scientist"] -->|"kubectl / UI"| UI
    UI -->|"API requests"| BFF
    BFF -->|"model metadata"| Server
    BFF -->|"RBAC checks"| K8sAPI["Kubernetes API<br/>:6443/TCP"]

    Controller -->|"watches"| ISVC["InferenceService CR"]
    Controller -->|"sync metadata"| Server
    Controller -->|"leader election"| K8sAPI

    CSI -->|"fetch artifact URI"| Server
    CSI -->|"download model"| StorageBackend["Storage Backend<br/>S3 / GCS"]

    AsyncJob -->|"register model"| Server
    AsyncJob -->|"upload/download"| S3["S3 / HuggingFace Hub"]
    AsyncJob -->|"push artifacts"| OCI["OCI Registry"]

    Catalog -->|"query models"| HFHub["HuggingFace Hub API<br/>:443/TCP"]

    Server -->|"persist metadata"| DB["MySQL :3306 / PostgreSQL :5432"]
    Catalog -->|"persist catalog"| CatalogDB["PostgreSQL :5432<br/>model-catalog-postgres"]

    %% Istio integration
    IstioGW["Istio Ingress Gateway"] -->|"VirtualService"| Server
    IstioGW -->|"VirtualService"| BFF
    IstioGW -->|"VirtualService"| Catalog

    %% Styles
    style Server fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style BFF fill:#4a90e2,color:#fff
    style Catalog fill:#4a90e2,color:#fff
    style CSI fill:#4a90e2,color:#fff
    style AsyncJob fill:#9b59b6,color:#fff
    style UI fill:#3498db,color:#fff
    style ISVC fill:#f5a623,color:#000
    style DB fill:#e67e22,color:#fff
    style CatalogDB fill:#e67e22,color:#fff
    style IstioGW fill:#e8e8e8,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style HFHub fill:#e8e8e8,color:#000
    style S3 fill:#e8e8e8,color:#000
    style OCI fill:#e8e8e8,color:#000
    style StorageBackend fill:#e8e8e8,color:#000
