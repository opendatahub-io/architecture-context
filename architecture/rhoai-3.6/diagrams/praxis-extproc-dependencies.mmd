graph LR
    PraxisExtproc["praxis-extproc<br/>Envoy ExtProc Server"]

    %% Core Praxis Dependencies
    PraxisExtproc -->|"filter pipeline types"| PraxisCore["praxis-core 0.7.1"]
    PraxisExtproc -->|"FilterPipeline, HttpFilter"| PraxisFilter["praxis-filter 0.7.1"]
    PraxisExtproc -->|"OpenSSL CryptoProvider"| PraxisTLS["praxis-tls 0.7.1"]
    PraxisExtproc -->|"AI filter registry"| PraxisAIFilters["praxis-ai-filters v0.4.1"]
    PraxisExtproc -.->|"response store (non-FIPS)"| PraxisAIAPIs["praxis-ai-apis v0.4.1"]

    %% Runtime Dependencies
    PraxisExtproc -->|"gRPC framework"| Tonic["tonic 0.14.6"]
    PraxisExtproc -->|"health checks"| TonicHealth["tonic-health 0.14.6"]
    PraxisExtproc -->|"protobuf"| Prost["prost 0.14.3"]
    PraxisExtproc -->|"async runtime"| Tokio["tokio 1.52.2"]
    PraxisExtproc -->|"TLS termination"| OpenSSL["openssl 0.10.81"]
    PraxisExtproc -->|"metrics HTTP"| Hyper["hyper 1.9.0"]
    PraxisExtproc -->|"metrics export"| PromExporter["metrics-exporter-prometheus 0.16.2"]

    %% Platform Dependencies
    Envoy["Envoy<br/>(Istio Gateway)"] -->|"gRPC ExtProc protocol"| PraxisExtproc
    PraxisExtproc -.->|"EnvoyFilter ordering"| Kuadrant["Kuadrant<br/>Auth WasmPlugin"]
    PraxisExtproc -.->|"EnvoyFilter reposition"| InferencePool["InferencePool / EPP"]
    PraxisExtproc -->|"reads CRDs, configmaps, secrets"| K8sAPI["Kubernetes API"]

    %% Styling
    style PraxisExtproc fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PraxisCore fill:#7ed321,stroke:#333
    style PraxisFilter fill:#7ed321,stroke:#333
    style PraxisTLS fill:#7ed321,stroke:#333
    style PraxisAIFilters fill:#7ed321,stroke:#333
    style PraxisAIAPIs fill:#7ed321,stroke:#333,stroke-dasharray: 5 5
    style Tonic fill:#999,stroke:#333
    style TonicHealth fill:#999,stroke:#333
    style Prost fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style OpenSSL fill:#999,stroke:#333
    style Hyper fill:#999,stroke:#333
    style PromExporter fill:#999,stroke:#333
    style Envoy fill:#f5a623,stroke:#333
    style Kuadrant fill:#f5a623,stroke:#333,stroke-dasharray: 5 5
    style InferencePool fill:#f5a623,stroke:#333,stroke-dasharray: 5 5
    style K8sAPI fill:#f5a623,stroke:#333
