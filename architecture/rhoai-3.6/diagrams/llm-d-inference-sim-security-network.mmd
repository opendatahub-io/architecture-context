graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(e.g., llm-d-router, test harness)"]
    end

    subgraph PodBoundary["POD BOUNDARY"]
        direction TB

        subgraph SimContainer["Container: llm-d-inference-sim"]
            Mux["cmux Multiplexer<br/>8000/TCP<br/>Optional TLS 1.2+<br/>AEAD ciphers only"]
            HTTPServer["HTTP Server (fasthttp)<br/>OpenAI API + vLLM endpoints<br/>No Auth"]
            GRPCService["gRPC Server<br/>VllmEngine service<br/>No Auth"]
            MetricsEndpoint["/metrics<br/>Prometheus metrics<br/>No Auth"]
            ZMQPublisher["ZMQ PUB Socket<br/>Configurable port<br/>No encryption<br/>No Auth"]
        end

        subgraph RenderContainer["Container: vllm-render (optional sidecar)"]
            RenderServer["vLLM Render Server<br/>8082/TCP<br/>HTTP plaintext<br/>No Auth"]
        end
    end

    subgraph InternalConsumers["INTERNAL CONSUMERS"]
        Prometheus["Prometheus<br/>(scrape /metrics)"]
        RouterEPP["llm-d-router EPP<br/>(ZMQ SUB subscriber)"]
        ZMQListenerPod["zmq-listener<br/>(ZMQ SUB, debug)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Ingress flows
    Client -->|"HTTP/1.1 or gRPC (HTTP/2)<br/>8000/TCP<br/>Optional TLS 1.2+ (ECDHE+AEAD)<br/>No Auth"| Mux
    Mux --> HTTPServer
    Mux --> GRPCService

    %% Intra-pod flows
    SimContainer -->|"HTTP plaintext<br/>localhost:8082/TCP<br/>No Auth"| RenderServer

    %% Egress flows
    Prometheus -->|"HTTP scrape<br/>8000/TCP<br/>Optional TLS<br/>No Auth"| MetricsEndpoint
    ZMQPublisher -->|"ZMQ TCP<br/>Configurable port<br/>No encryption<br/>No Auth"| RouterEPP
    ZMQPublisher -->|"ZMQ TCP<br/>No encryption<br/>No Auth"| ZMQListenerPod
    RenderServer -->|"HTTPS<br/>443/TCP<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef internal fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef extservice fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Client external
    class Mux,HTTPServer,GRPCService,MetricsEndpoint,ZMQPublisher container
    class RenderServer container
    class Prometheus,RouterEPP,ZMQListenerPod internal
    class HFHub extservice
