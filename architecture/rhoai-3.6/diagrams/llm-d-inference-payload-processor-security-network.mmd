graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Gateway["GATEWAY (Envoy Proxy)"]
        Envoy["Envoy Proxy<br/>443/TCP → internal<br/>TLS 1.2+<br/>ext-proc filter chain"]
    end

    subgraph ClusterInternal["CLUSTER-INTERNAL (Same Namespace)"]
        direction TB

        subgraph NS["Namespace: ${NAMESPACE}"]
            IPP["Inference Payload Processor<br/>SA: payload-processor<br/>Image: distroless/static:nonroot"]
            ExtProc["ext-proc: 9004/TCP<br/>gRPC, Optional TLS<br/>Self-signed cert<br/>No AuthN"]
            Health["Health: 9005/TCP<br/>gRPC, Plaintext<br/>No AuthN"]
            Metrics["Metrics: 9090/TCP<br/>HTTP, Plaintext<br/>Optional TokenReview"]

            IPP --- ExtProc
            IPP --- Health
            IPP --- Metrics
        end
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>ServiceAccount Token"]
    end

    subgraph Downstream["DOWNSTREAM SERVICES"]
        InferencePool["InferencePool / Model Server<br/>8000/TCP<br/>HTTP<br/>Configurable"]
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        Prometheus["Prometheus<br/>Scrapes 9090/TCP<br/>HTTP"]
        OTLPCollector["OTLP Collector<br/>4317/TCP<br/>gRPC<br/>Configurable TLS"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (optional)"| Envoy
    Envoy -->|"gRPC/9004<br/>Optional TLS (self-signed)<br/>insecureSkipVerify=true<br/>No AppAuth"| ExtProc
    ExtProc -->|"gRPC response<br/>Header/Body mutations<br/>Routing headers"| Envoy
    Envoy -->|"HTTP/8000<br/>Routed request<br/>Configurable"| InferencePool
    IPP -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>ConfigMap watch"| K8sAPI
    Prometheus -.->|"HTTP/9090<br/>Scrape metrics"| Metrics
    IPP -.->|"gRPC/4317<br/>OTLP traces<br/>Configurable TLS"| OTLPCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef downstream fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy gateway
    class IPP,ExtProc,Health,Metrics internal
    class K8sAPI controlplane
    class InferencePool downstream
    class Prometheus,OTLPCollector observability
