graph TB
    subgraph Operator["OPERATOR / SRE (Trusted)"]
        SRE["Operator<br/>kubectl + run-tests.py"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph PodNetwork["POD NETWORK (Cluster-Internal)"]
        direction TB

        subgraph VllmPod["vLLM Model Server Pod"]
            Preflight["Preflight HTTP Server<br/>8000/TCP HTTP<br/>No Encryption, No Auth"]
            VllmServe["vLLM serve<br/>8000/TCP"]
            Preflight -.->|"GET /exit"| VllmServe
        end

        subgraph TestPods["Network Test Pod Pairs"]
            PodA["Pod A (server)<br/>perftest: 18515/TCP RDMA<br/>iperf3: 5201/TCP"]
            PodB["Pod B (client)"]
        end

        subgraph NIXLPods["NIXL Benchmark Pods"]
            NIXLClient["nixl-client<br/>GPU: nvidia.com/gpu=1"]
            NIXLServer["nixl-server<br/>5555/TCP ZMQ<br/>NodePort: 30002<br/>GPU: nvidia.com/gpu=1"]
        end
    end

    subgraph ExtServices["EXTERNAL SERVICES (Build-Time Only)"]
        GitHub["github.com<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        Mellanox["content.mellanox.com<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        NVIDIA["developer.nvidia.com<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Operator flows
    SRE -->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI
    K8sAPI -->|"kubectl exec<br/>SPDY/WebSocket<br/>TLS"| Preflight
    K8sAPI -->|"kubectl exec<br/>SPDY/WebSocket<br/>TLS"| PodA
    K8sAPI -->|"kubectl exec<br/>SPDY/WebSocket<br/>TLS"| PodB

    %% Inter-pod test flows
    PodB -->|"RDMA/18515<br/>ib_write_bw<br/>No Encryption"| PodA
    PodB -->|"TCP/5201<br/>iperf3<br/>No Encryption"| PodA

    %% NIXL flows
    NIXLClient -->|"ZMQ/5555 TCP<br/>No Encryption"| NIXLServer
    NIXLClient -->|"UCX (RC/TCP)<br/>GPU VRAM-to-VRAM<br/>No Encryption"| NIXLServer

    %% Build-time egress (dashed)
    VllmPod -.->|"Build-time only"| GitHub
    VllmPod -.->|"Build-time only"| Mellanox
    VllmPod -.->|"Build-time only"| NVIDIA

    %% Styling
    classDef operator fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class SRE operator
    class K8sAPI controlplane
    class Preflight,VllmServe,PodA,PodB pod
    class NIXLClient,NIXLServer warning
    class GitHub,Mellanox,NVIDIA external
