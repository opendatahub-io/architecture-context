graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        KubeAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB
        Operator["training-operator<br/>SA: training-operator<br/>Image: training-operator:v1.9.0-odh-3"]

        subgraph Ports["Listening Ports"]
            Metrics["Metrics<br/>8080/TCP<br/>TLS (cluster profile)"]
            Health["Health Probes<br/>8081/TCP<br/>HTTP (no auth)"]
            Webhook["Webhooks<br/>9443/TCP<br/>TLS (self-signed CA)"]
        end

        WebhookCert["Secret: training-operator-webhook-cert<br/>OPA cert-controller managed<br/>Auto-rotate: Yes"]
    end

    subgraph UserNS["USER NAMESPACES (Training Workloads)"]
        direction TB
        TrainingPods["Worker/Master Pods<br/>Per-job lifecycle"]
        HeadlessSvc["Headless Services<br/>Inter-pod communication"]
        NetworkPolicy["NetworkPolicy<br/>(PyTorchJob only)<br/>Intra-job + monitoring"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>openshift-monitoring<br/>PodMonitor scrape"]
    end

    subgraph OptionalScheduling["OPTIONAL GANG SCHEDULING"]
        Volcano["Volcano<br/>PodGroup CRD"]
        SchedPlugins["Scheduler-Plugins<br/>PodGroup CRD"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User token"| KubeAPI

    %% Control Plane → Webhook
    KubeAPI -->|"HTTPS/9443<br/>TLS (self-signed CA)<br/>Kubernetes admission"| Webhook

    %% Operator → Control Plane (egress)
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| KubeAPI

    %% Operator → User NS resources
    Operator -->|"via kube-apiserver<br/>Pod/Service CRUD"| TrainingPods
    Operator -->|"via kube-apiserver<br/>Service CRUD"| HeadlessSvc
    Operator -->|"via kube-apiserver<br/>NetworkPolicy CRUD"| NetworkPolicy

    %% Cert management
    WebhookCert -.->|"TLS cert + CA"| Webhook

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>TLS (cluster profile)<br/>No auth"| Metrics

    %% Optional scheduling
    Operator -.->|"via kube-apiserver<br/>PodGroup CRUD"| Volcano
    Operator -.->|"via kube-apiserver<br/>PodGroup CRUD"| SchedPlugins

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class KubeAPI controlplane
    class Operator,Metrics,Health,Webhook,WebhookCert operatorns
    class TrainingPods,HeadlessSvc,NetworkPolicy userns
    class Prometheus monitoring
    class Volcano,SchedPlugins optional
