graph TD
    subgraph "Identity Providers"
        GitHubUser["GitHub User<br/>(OAuth 2.0 Code Flow)"]
    end

    subgraph "Authentication"
        OAuthFlow["GitHub OAuth Module<br/>Token validation"]
        OrgCheck["Org Membership Check<br/>llm-d organization"]
    end

    subgraph "Authorization (Application-Level)"
        IAMModule["IAM Module<br/>(server/iam.ts)"]
        Allowlist["GCS Allowlist<br/>prism-iam/github-admin-allowlist.txt"]
        PlaygroundMode["⚠ Playground Mode<br/>RESULTS_STORE_PLAYGROUND_MODE=1<br/>Bypasses ALL auth"]
    end

    subgraph "Roles"
        AdminRole["Admin Role<br/>- Promote results<br/>- Review submissions<br/>- Write to GCS<br/>- Delete any result"]
        UserRole["User Role<br/>- Submit results<br/>- View own pending results<br/>- Delete own results<br/>- View public results"]
        AnonRole["Anonymous Role<br/>- View public/promoted results<br/>- Read regressions<br/>- Read prefix-cache data<br/>- Read P/D data"]
    end

    subgraph "Protected Resources"
        ResultsWrite["Results Store Write<br/>/api/results (POST)"]
        ResultsPromote["Results Promote<br/>/api/results/:id/promote"]
        ResultsReview["Results Review<br/>/api/results/:id/review"]
        GCSWrite["GCS Write Operations<br/>/api/gcs/* (POST/PUT/DELETE)"]
        ResultsRead["Results Read<br/>/api/results (GET)"]
        PublicData["Public Data<br/>/api/regressions<br/>/api/prefix-cache/data<br/>/api/pd-disaggregation/data"]
    end

    %% Auth flow
    GitHubUser -->|"OAuth token"| OAuthFlow
    OAuthFlow -->|"validate token"| OrgCheck
    OrgCheck -->|"is member"| IAMModule
    IAMModule -->|"check allowlist"| Allowlist

    %% Role assignment
    Allowlist -->|"on allowlist"| AdminRole
    OrgCheck -->|"org member,<br/>not on allowlist"| UserRole
    OAuthFlow -.->|"no token"| AnonRole
    PlaygroundMode -.->|"enabled: all users<br/>become admin"| AdminRole

    %% Resource access
    AdminRole -->|"full access"| ResultsWrite
    AdminRole -->|"admin only"| ResultsPromote
    AdminRole -->|"admin only"| ResultsReview
    AdminRole -->|"admin only"| GCSWrite
    UserRole -->|"own results"| ResultsWrite
    UserRole -->|"own + public"| ResultsRead
    AnonRole -->|"public only"| ResultsRead
    AnonRole -->|"unrestricted"| PublicData

    style GitHubUser fill:#4a90e2,color:#fff
    style AdminRole fill:#e74c3c,color:#fff
    style UserRole fill:#f5a623,color:#fff
    style AnonRole fill:#95a5a6,color:#fff
    style PlaygroundMode fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Allowlist fill:#7ed321
    style IAMModule fill:#f5a623
