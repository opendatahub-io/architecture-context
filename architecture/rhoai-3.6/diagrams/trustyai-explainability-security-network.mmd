graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / API Client"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route: trustyai<br/>80/TCP<br/>TLS: None"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_DSP["Namespace: data-science-project"]
            TrustyAI["TrustyAI Service<br/>SA: trustyai-serviceaccount<br/>HTTP: 8080/TCP (no auth)<br/>HTTPS: 4443/TCP (mounted TLS cert)<br/>Image: registry.redhat.io/rhods/<br/>odh-trustyai-service-rhel8"]
        end
    end

    subgraph InboundSources["INBOUND SOURCES"]
        ModelMesh["ModelMesh Serving Runtime"]
        KServe["KServe Inference Logger"]
        Prometheus["Prometheus"]
    end

    subgraph EgressTargets["EGRESS TARGETS"]
        InfServers["KServe / ModelMesh<br/>Inference Servers<br/>gRPC / HTTP"]
        MariaDB["MariaDB / MySQL<br/>3306/TCP JDBC<br/>Username/Password"]
        MinIOStorage["MinIO<br/>HTTP/HTTPS<br/>Access Key / Secret"]
    end

    %% External inbound
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Route
    Route -->|"HTTP/80→8080<br/>No Encryption<br/>No Auth"| TrustyAI

    %% Platform inbound
    ModelMesh -->|"HTTP/80→8080<br/>POST /consumer/kserve/v2<br/>No Auth"| TrustyAI
    KServe -->|"HTTP/80→8080<br/>CloudEvents<br/>No Auth"| TrustyAI
    Prometheus -->|"HTTP/80→8080<br/>GET /q/metrics<br/>SA Token Auth (4s scrape)"| TrustyAI

    %% Egress
    TrustyAI -->|"gRPC / HTTP<br/>Model Inference<br/>No Auth"| InfServers
    TrustyAI -->|"JDBC/3306<br/>Username/Password"| MariaDB
    TrustyAI -->|"HTTP or HTTPS<br/>Access Key Auth"| MinIOStorage

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef inbound fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route ingress
    class TrustyAI cluster
    class ModelMesh,KServe,Prometheus inbound
    class InfServers,MariaDB,MinIOStorage egress
