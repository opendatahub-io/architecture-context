graph TD
    subgraph Title["PPE Authorization Model (In-Process, Not Kubernetes RBAC)"]
        direction TB

        subgraph CallerIdentity["Caller Identity Resolution"]
            Agent["AI Agent / Client"]
            Agent -->|"Bearer Token"| JWTResolver["JWT Identity Resolver<br/>Validates: RS256/384/512,<br/>ES256/384, EdDSA, HS256/384/512"]
            Agent -->|"API Key"| APIKeyResolver["API-Key Resolver<br/>SHA-256 hash-indexed lookup"]
            JWTResolver -->|"claims mapped via presets"| Identity["Resolved Identity<br/>(subject, roles, attributes)"]
            APIKeyResolver -->|"key → identity mapping"| Identity
        end

        subgraph PolicyEval["APL Policy Evaluation"]
            Identity -->|"identity + operation"| APL["APL Predicates<br/>(Authorization Policy Language)"]
            APL -->|"compiled to"| PDPDispatch{"PDP Dispatch"}
            PDPDispatch -->|"feature: cedar"| CedarPDP["Cedar v4 PDP<br/>Entities + Policies"]
            PDPDispatch -->|"feature: cel"| CELPDB["CEL PDP<br/>Expressions"]
            PDPDispatch -->|"feature: opa"| OPAPDP["OPA PDP<br/>Rego (restricted builtins)"]
        end

        subgraph Decision["Authorization Decision"]
            CedarPDP --> Result{"Allow / Deny"}
            CELPDB --> Result
            OPAPDP --> Result
            Result -->|"Allow"| Assertions["Assertions Applied<br/>(headers, delegated tokens)"]
            Result -->|"Deny"| Rejection["Request Rejected<br/>(audit event emitted)"]
        end

        subgraph CapabilityModel["Plugin Capability Model"]
            direction LR
            PluginConfig["Plugin Configuration<br/>(capabilities declared in config)"]
            PluginConfig -->|"declares"| Caps["Capabilities:<br/>read_subject, read_operation,<br/>read_context, write_assertions"]
            Caps -->|"engine filters context"| FilteredView["Filtered Plugin View<br/>Plugin sees ONLY declared caps"]
            Note1["⚠ Capabilities declared in config,<br/>NOT claimed by plugins.<br/>Compromised plugin cannot<br/>escalate its own access."]
        end

        subgraph SessionTaint["Session Taint (Information Flow Control)"]
            direction LR
            TaintLabel["Taint Labels<br/>(per-session, per-call)"]
            TaintLabel -->|"tracked across calls"| TaintCheck["Taint Propagation Check<br/>Controls where data<br/>is allowed to flow next"]
        end
    end

    %% Styling
    style Agent fill:#4a90e2,stroke:#333,color:#fff
    style JWTResolver fill:#7ed321,stroke:#333
    style APIKeyResolver fill:#7ed321,stroke:#333
    style Identity fill:#f5a623,stroke:#333
    style APL fill:#9b59b6,stroke:#333,color:#fff
    style CedarPDP fill:#e74c3c,stroke:#333,color:#fff
    style CELPDB fill:#e74c3c,stroke:#333,color:#fff
    style OPAPDP fill:#e74c3c,stroke:#333,color:#fff
    style Assertions fill:#27ae60,stroke:#333,color:#fff
    style Rejection fill:#c0392b,stroke:#333,color:#fff
    style PluginConfig fill:#3498db,stroke:#333,color:#fff
    style FilteredView fill:#2ecc71,stroke:#333
    style Note1 fill:#fff3cd,stroke:#ffc107
    style TaintLabel fill:#e67e22,stroke:#333,color:#fff
    style TaintCheck fill:#d35400,stroke:#333,color:#fff
