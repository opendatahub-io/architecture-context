graph TB
    subgraph TaskContainers["PIPELINE TASK CONTAINERS (Ephemeral)"]
        direction TB

        subgraph InitPod["Init Container"]
            Init["pipelines-components<br/>Image: odh-pipelines-components<br/>Base: UBI9/python-312<br/>Crypto: DEFAULT:PQ"]
        end

        subgraph TaskPods["Task Containers"]
            AutoML["odh-automl<br/>AIPCC cpu-el9.8:3.6.0"]
            AutoRAG["odh-autorag<br/>AIPCC cpu-el9.8:3.6.0<br/>+Docling +Whisper"]
            AutoRAGInf["odh-autorag-inference<br/>AIPCC cpu-el9.8:3.6.0"]
        end
    end

    subgraph InCluster["IN-CLUSTER SERVICES"]
        direction TB
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS (in-cluster CA)"]
        KFPServer["KFP API Server<br/>(shared volume)"]
        KServeEP["KServe InferenceService<br/>8080/TCP HTTP<br/>⚠ No encryption"]
        ModelReg["Model Registry<br/>8080/TCP HTTP<br/>⚠ No encryption, no auth"]
        Milvus["Milvus<br/>configurable port<br/>gRPC/REST"]
    end

    subgraph External["EXTERNAL SERVICES"]
        direction TB
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS"]
        S3["S3 / MinIO<br/>443/TCP HTTPS<br/>TLS<br/>⚠ verify=False fallback"]
        EvalHub["Eval Hub API<br/>configurable HTTPS<br/>⚠ verify_tls=False default"]
        PyPI["RHOAI PyPI Index<br/>443/TCP HTTPS<br/>TLS"]
        LiteLLM["LiteLLM<br/>configurable HTTPS<br/>TLS"]
    end

    subgraph Operator["OPERATOR INTEGRATION"]
        DSPO["DSPO<br/>(injects RELATED_IMAGE_*)"]
    end

    %% Init container flows
    DSPO -->|env vars| Init
    Init -->|filesystem| KFPServer

    %% Task container → in-cluster
    TaskPods -->|HTTPS/443<br/>Bearer Token SA| K8sAPI
    TaskPods -->|HTTP/8080<br/>No Auth| KServeEP
    TaskPods -->|HTTP/8080<br/>No Auth| ModelReg
    AutoRAG -->|configurable<br/>configurable auth| Milvus

    %% Task container → external
    TaskPods -->|HTTPS/443<br/>HF_TOKEN| HF
    TaskPods -->|HTTPS/443<br/>AWS Sig V4| S3
    TaskPods -->|HTTPS/configurable<br/>Bearer Token| EvalHub
    TaskPods -->|HTTPS/443<br/>No Auth| PyPI
    TaskPods -->|HTTPS/configurable<br/>LLM_API_KEY| LiteLLM

    %% Styling
    classDef taskcontainer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef incluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Init,AutoML,AutoRAG,AutoRAGInf taskcontainer
    class K8sAPI,KFPServer incluster
    class KServeEP,ModelReg warning
    class Milvus incluster
    class HF,PyPI external
    class S3,EvalHub warning
    class LiteLLM external
    class DSPO operator
