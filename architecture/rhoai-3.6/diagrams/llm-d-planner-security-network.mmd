graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser / CLI Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        PlannerRoute["planner Route<br/>443/TCP → 8501/TCP<br/>TLS Edge Termination<br/>Auth: None"]
        BackendRoute["planner-backend Route<br/>443/TCP → 8000/TCP<br/>TLS Edge Termination<br/>Auth: None"]
    end

    subgraph AppTier["APPLICATION TIER (Namespace: planner)"]
        direction TB

        UI["Streamlit UI<br/>8501/TCP HTTP<br/>SA: default<br/>No Auth"]
        Backend["FastAPI Backend<br/>8000/TCP HTTP<br/>SA: planner-backend<br/>No Auth Middleware<br/>CORS: allow_origins=*"]
        Ollama["Ollama Sidecar<br/>11434/TCP HTTP<br/>Model: granite3.3:2b<br/>Internal Only"]
        SQLite["SQLite DB<br/>data/planner.db<br/>Local Pod FS"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        ModelCatalog["RHOAI Model Catalog<br/>8443/TCP HTTPS<br/>Service-Serving CA<br/>Bearer / SA Token<br/>NS: rhoai-model-registries"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN"]
        OpenAI["OpenAI API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OPENAI_API_KEY"]
        Vertex["Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP Credentials"]
        Arena["LMSYS Arena<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
        AA["Artificial Analysis<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AA_API_KEY"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS Edge<br/>No Auth"| PlannerRoute
    User -->|"HTTPS/443<br/>TLS Edge<br/>No Auth"| BackendRoute

    %% Ingress → App
    PlannerRoute -->|"HTTP/8501<br/>Plaintext<br/>No Auth"| UI
    BackendRoute -->|"HTTP/8000<br/>Plaintext<br/>No Auth"| Backend

    %% App internal
    UI -->|"HTTPS/443 via Route<br/>TLS Edge<br/>No Auth"| Backend
    Backend -->|"HTTP/11434<br/>Plaintext<br/>No Auth"| Ollama
    Backend -->|"File I/O"| SQLite

    %% App → Platform
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Backend -->|"HTTPS/8443<br/>Service-Serving CA<br/>Bearer Token<br/>NetworkPolicy Allowed"| ModelCatalog

    %% App → External
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    Backend -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| OpenAI
    Backend -.->|"HTTPS/443<br/>TLS 1.2+<br/>GCP Creds"| Vertex
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth"| Arena
    Backend -->|"HTTPS/443<br/>TLS 1.2+<br/>AA_API_KEY"| AA

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class PlannerRoute,BackendRoute ingress
    class UI,Backend,Ollama app
    class SQLite storage
    class K8sAPI,ModelCatalog platform
    class HFHub,OpenAI,Vertex,Arena,AA extsvc
