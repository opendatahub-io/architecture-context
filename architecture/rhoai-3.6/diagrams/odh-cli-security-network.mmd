graph TB
    subgraph ClientSide["CLIENT-SIDE (User Workstation / CI Container)"]
        CLI["rhai-cli / kubectl-odh<br/>FIPS: strictfipsruntime<br/>Crypto: DEFAULT:PQ<br/>RBAC: caller credentials"]
    end

    subgraph K8sCluster["KUBERNETES CLUSTER"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC + SSR pre-flight"]

        OLM["OLM API<br/>(via kube-apiserver)<br/>CSV + Subscription"]

        TrustyAI["TrustyAI Service<br/>443/TCP HTTPS<br/>⚠️ InsecureSkipVerify<br/>Bearer token"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        GitHub["GitHub<br/>raw.githubusercontent.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No auth (public)"]
    end

    subgraph MCPLocal["MCP SERVER (Optional, Local)"]
        MCPStdio["stdio Transport<br/>JSON-RPC<br/>stdin/stdout<br/>Process isolation"]
        MCPSSE["SSE Transport<br/>8080/TCP HTTP<br/>⚠️ No TLS<br/>⚠️ No Auth"]
    end

    AIAgent["AI Agent<br/>(Claude, GPT, Cursor)"]

    %% Client to cluster flows
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig creds<br/>(bearer/cert/OIDC)"| K8sAPI
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig creds"| OLM
    CLI -->|"HTTPS/443<br/>⚠️ TLS 1.2 InsecureSkipVerify<br/>Bearer token"| TrustyAI

    %% Client to external
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth"| GitHub

    %% MCP flows
    AIAgent -->|"JSON-RPC<br/>stdin/stdout"| MCPStdio
    AIAgent -->|"HTTP SSE<br/>8080/TCP<br/>No encryption"| MCPSSE
    MCPStdio --> CLI
    MCPSSE --> CLI

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef agent fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef mcp fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class CLI client
    class K8sAPI,OLM cluster
    class TrustyAI warning
    class GitHub external
    class AIAgent agent
    class MCPStdio,MCPSSE mcp
