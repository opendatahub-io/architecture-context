graph TB
    subgraph PlatformOperator["ODH/RHOAI Platform Operator"]
        PO[Platform Operator Controller]
    end

    subgraph RayModuleOperator["ray-module-operator"]
        Controller["ray-module-operator<br/>controller-manager<br/>(Go controller-runtime)"]
        HealthProbe["Health Probes<br/>8081/TCP"]
        MetricsServer["Metrics Server<br/>8443/TCP HTTPS"]

        subgraph ReconciliationPipeline["Reconciliation Pipeline"]
            MgmtState["Management State<br/>Action"]
            Releases["Release Tracking<br/>Action"]
            ManifestInit["Manifest Init<br/>Action"]
            KustomizeRender["Kustomize Render<br/>Action"]
            NotebookRBAC["Notebook RBAC<br/>Action"]
            Deploy["Deploy Action<br/>(SSA)"]
            Status["Status Update<br/>Action"]
            GC["Garbage Collection<br/>Action"]
        end

        Controller --> MgmtState
        MgmtState --> Releases
        Releases --> ManifestInit
        ManifestInit --> KustomizeRender
        KustomizeRender --> NotebookRBAC
        NotebookRBAC --> Deploy
        Deploy --> Status
        Status --> GC
    end

    subgraph VendoredManifests["Vendored KubeRay Manifests"]
        RHOAIManifests["RHOAI Manifests<br/>/opt/manifests/rhoai/kuberay"]
        ODHManifests["ODH Manifests<br/>/opt/manifests/odh/kuberay"]
    end

    subgraph KubeRayOperand["KubeRay Operator (Operand)"]
        KubeRayCtrl["KubeRay Controller"]
        RBACProxy["kube-rbac-proxy<br/>(sidecar)"]
        KubeRayCtrl --- RBACProxy
    end

    %% CR Flow
    PO -->|"creates"| RayCR["Ray CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped, singleton: default-ray"]
    RayCR -->|"watched by"| Controller

    %% Manifest rendering
    KustomizeRender -->|"reads"| VendoredManifests
    Deploy -->|"SSA applies"| KubeRayOperand

    %% External dependencies
    Controller -->|"validates CRDs"| CertManager["cert-manager"]
    Controller -->|"API calls"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    NotebookRBAC -->|"creates ClusterRole"| RayClusterRole["ray ClusterRole<br/>(for Workbenches)"]
    Controller -->|"watches"| ConfigMap["odh-ray-config<br/>ConfigMap"]

    %% KubeRay provides
    KubeRayOperand -->|"provides CRDs"| RayCRDs["ray.io CRDs<br/>RayCluster, RayJob,<br/>RayService, RayCronJob"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style KubeRayCtrl fill:#4a90e2,stroke:#333,color:#fff
    style RayCR fill:#f5a623,stroke:#333,color:#fff
    style RayCRDs fill:#f5a623,stroke:#333,color:#fff
    style RayClusterRole fill:#f5a623,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
    style PO fill:#7ed321,stroke:#333
    style RBACProxy fill:#999,stroke:#333,color:#fff
