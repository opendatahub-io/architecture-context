graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_Argo["argo<br/>(argo namespace)"]
        SA_Prometheus["data-science-monitoringstack-prometheus<br/>(redhat-ods-monitoring)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_Argo["manager-argo-rolebinding"]
        CRB_ArgoCluster["ds-pipeline-argo-binding"]
        CRB_Prometheus["data-science-pipelines-operator-<br/>rhoai-prometheus"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_Leader["leader-election-rolebinding"]
        RB_PromRule["prometheusrule-manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role<br/>(39 rules, 15+ API groups)"]
        CR_ArgoMgr["manager-argo-role"]
        CR_ArgoCluster["argo-cluster-role"]
        CR_MetricsReader["metrics-reader"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        CR_ArgoAdmin["argo-aggregate-to-admin<br/>(Full CRUD)"]
        CR_ArgoEdit["argo-aggregate-to-edit<br/>(Full CRUD)"]
        CR_ArgoView["argo-aggregate-to-view<br/>(Read-only)"]
        CR_DSPAAdminEdit["aggregate-dspa-admin-edit<br/>(Full CRUD)"]
        CR_DSPAView["aggregate-dspa-admin-view<br/>(Read-only)"]
    end

    subgraph NamespacedRoles["Namespaced Roles"]
        R_Leader["leader-election-role"]
        R_PromRule["prometheusrule-manager-role"]
    end

    subgraph APIResources["API Resources Managed"]
        Res_DSPA["datasciencepipelinesapplications.opendatahub.io<br/>DSPA, Pipeline, PipelineVersion"]
        Res_Argo["argoproj.io<br/>Workflow, WorkflowTemplate,<br/>CronWorkflow, ClusterWorkflowTemplate"]
        Res_Core["core / apps / networking<br/>Deployments, Services, Secrets,<br/>ConfigMaps, NetworkPolicies, Pods"]
        Res_KServe["serving.kserve.io<br/>InferenceService"]
        Res_Ray["ray.io<br/>RayCluster, RayJob, RayService"]
        Res_Routes["route.openshift.io<br/>Routes"]
        Res_Monitoring["monitoring.rhobs<br/>ServiceMonitor, PrometheusRule"]
        Res_Leader["coordination.k8s.io<br/>Leases"]
    end

    %% SA → Binding → Role flows
    SA_CM -->|"bound via"| CRB_Manager
    SA_CM -->|"bound via"| CRB_Argo
    SA_CM -->|"bound via"| RB_Leader
    SA_CM -->|"bound via"| RB_PromRule
    SA_Argo -->|"bound via"| CRB_ArgoCluster
    SA_Prometheus -->|"bound via"| CRB_Prometheus

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Argo -->|"grants"| CR_ArgoMgr
    CRB_ArgoCluster -->|"grants"| CR_ArgoCluster
    CRB_Prometheus -->|"grants"| CR_MetricsReader
    RB_Leader -->|"grants"| R_Leader
    RB_PromRule -->|"grants"| R_PromRule

    %% Role → Resource flows
    CR_Manager -->|"full CRUD"| Res_DSPA
    CR_Manager -->|"full CRUD"| Res_Core
    CR_Manager -->|"full CRUD"| Res_KServe
    CR_Manager -->|"full CRUD"| Res_Ray
    CR_Manager -->|"full CRUD"| Res_Routes
    CR_Manager -->|"full CRUD"| Res_Monitoring
    CR_ArgoMgr -->|"full CRUD"| Res_Argo
    CR_ArgoCluster -->|"runtime ops"| Res_Argo
    R_Leader -->|"CRUD"| Res_Leader

    %% Aggregate roles
    CR_ArgoAdmin -.->|"aggregated to admin"| Res_Argo
    CR_ArgoEdit -.->|"aggregated to edit"| Res_Argo
    CR_ArgoView -.->|"aggregated to view<br/>(read-only)"| Res_Argo
    CR_DSPAAdminEdit -.->|"aggregated to admin/edit"| Res_DSPA
    CR_DSPAView -.->|"aggregated to view<br/>(read-only)"| Res_DSPA

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_Argo fill:#4a90e2,color:#fff
    style SA_Prometheus fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#000
    style CR_ArgoMgr fill:#f5a623,color:#000
    style CR_ArgoCluster fill:#f5a623,color:#000
    style CR_MetricsReader fill:#f5a623,color:#000
    style R_Leader fill:#f5a623,color:#000
    style R_PromRule fill:#f5a623,color:#000
    style Res_DSPA fill:#7ed321,color:#000
    style Res_Argo fill:#7ed321,color:#000
    style Res_Core fill:#7ed321,color:#000
    style Res_KServe fill:#7ed321,color:#000
    style Res_Ray fill:#7ed321,color:#000
    style Res_Routes fill:#7ed321,color:#000
    style Res_Monitoring fill:#7ed321,color:#000
    style Res_Leader fill:#7ed321,color:#000
