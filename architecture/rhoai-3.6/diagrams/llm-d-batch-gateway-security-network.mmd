graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        Gateway["External Gateway<br/>Kuadrant/Authorino<br/>443/TCP<br/>TLS Termination<br/>AuthN/AuthZ Enforcement<br/>Injects X-MaaS-Username"]
    end

    subgraph Application["APPLICATION LAYER"]
        direction TB

        subgraph NS_Release["Namespace: release-namespace"]
            direction TB

            APIServer["batch-gateway-apiserver<br/>Deployment<br/>SA: batch-gateway-apiserver<br/>API: 8000/TCP, Obs: 8081/TCP<br/>Security Headers Middleware<br/>Pod Security: runAsNonRoot,<br/>seccomp RuntimeDefault"]

            Processor["batch-gateway-processor<br/>StatefulSet<br/>SA: batch-gateway-processor<br/>Obs: 9090/TCP<br/>Workers: 5, AIMD concurrency<br/>Pod Security: runAsNonRoot,<br/>seccomp RuntimeDefault"]

            GarbageCollector["batch-gateway-gc<br/>Deployment (single replica)<br/>SA: batch-gateway-gc<br/>Obs: 9091/TCP<br/>Role: pod-watcher<br/>Pod Security: runAsNonRoot,<br/>seccomp RuntimeDefault"]
        end
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>TCP<br/>Configurable encryption<br/>Connection URL credentials"]
        Redis["Redis/Valkey<br/>TCP<br/>Configurable encryption<br/>Connection URL credentials"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>Configurable encryption<br/>AWS credentials"]
    end

    subgraph InferenceServices["INFERENCE SERVICES"]
        LLMd["llm-d Inference Gateway<br/>HTTP/HTTPS<br/>Optional TLS + custom CA / mTLS<br/>Optional API key"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable encryption<br/>No auth"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>API key / token"| Gateway

    %% Ingress → Application
    Gateway -->|"HTTP(S)/8000<br/>Optional TLS 1.2+<br/>No auth (delegated)"| APIServer

    %% API Server egress
    APIServer -->|"TCP<br/>Configurable<br/>Conn URL creds"| PostgreSQL
    APIServer -->|"TCP<br/>Configurable<br/>Conn URL creds"| Redis
    APIServer -->|"HTTP(S)<br/>Configurable<br/>AWS credentials"| S3

    %% Processor egress
    Processor -->|"TCP<br/>Configurable<br/>Conn URL creds"| PostgreSQL
    Processor -->|"TCP<br/>Configurable<br/>Conn URL creds"| Redis
    Processor -->|"HTTP(S)<br/>Configurable<br/>AWS credentials"| S3
    Processor -->|"HTTP(S)<br/>Optional TLS/mTLS<br/>Optional API key"| LLMd

    %% GC egress
    GarbageCollector -->|"TCP<br/>Configurable<br/>Conn URL creds"| PostgreSQL
    GarbageCollector -->|"TCP<br/>Configurable<br/>Conn URL creds"| Redis
    GarbageCollector -->|"HTTP(S)<br/>Configurable<br/>AWS credentials"| S3
    GarbageCollector -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Observability (all components)
    APIServer -.->|"OTLP/gRPC<br/>Configurable"| OTel
    Processor -.->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class APIServer,Processor,GarbageCollector application
    class PostgreSQL,Redis,S3 datastore
    class LLMd inference
    class K8sAPI,OTel platform
