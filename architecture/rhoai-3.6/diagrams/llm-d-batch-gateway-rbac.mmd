graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["batch-gateway-apiserver<br/>(Deployment)"]
        SA_Proc["batch-gateway-processor<br/>(StatefulSet)"]
        SA_GC["batch-gateway-gc<br/>(Deployment)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_GC["batch-gateway-gc-pod-watcher<br/>(RoleBinding)<br/>Namespace: release-namespace"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        Role_GC["batch-gateway-gc-pod-watcher<br/>(Role)<br/>Namespace: release-namespace<br/>Condition: gc.config.reconciler.enabled"]
    end

    subgraph APIResources["API Resources"]
        Pods["core<br/>pods"]
        StatefulSets["apps<br/>statefulsets"]
    end

    subgraph Permissions["Granted Verbs"]
        Verbs_Pods["get, list, watch"]
        Verbs_SS["get, list, watch"]
    end

    %% GC RBAC chain
    SA_GC -->|"bound via"| RB_GC
    RB_GC -->|"grants"| Role_GC
    Role_GC -->|"core/pods"| Pods
    Role_GC -->|"apps/statefulsets"| StatefulSets
    Pods --- Verbs_Pods
    StatefulSets --- Verbs_SS

    %% No RBAC for API server and processor
    SA_API -.-|"No Kubernetes RBAC<br/>(no API server access needed)"| NoRBAC1["N/A"]
    SA_Proc -.-|"No Kubernetes RBAC<br/>(no API server access needed)"| NoRBAC2["N/A"]

    subgraph Secrets["Kubernetes Secrets"]
        Secret1["batch-gateway-secrets<br/>(Opaque)<br/>PostgreSQL URL, Redis URL,<br/>Inference API key, S3 secret<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        Secret2["batch-gateway-apiserver-tls<br/>(kubernetes.io/tls)<br/>TLS cert and key<br/>Provisioned: cert-manager or manual<br/>Auto-Rotate: Yes (cert-manager)"]
    end

    %% Secret access
    SA_API -.->|"mounts"| Secret1
    SA_API -.->|"mounts (optional)"| Secret2
    SA_Proc -.->|"mounts"| Secret1
    SA_GC -.->|"mounts"| Secret1

    subgraph AuthDelegation["Authentication Delegation"]
        ExtGW["External Gateway<br/>Kuadrant/Authorino<br/>Enforces AuthN/AuthZ"]
        TenantHeader["X-MaaS-Username Header<br/>Tenant ID Extraction"]
    end

    ExtGW -->|"authenticates requests<br/>before forwarding"| SA_API
    SA_API -->|"extracts tenant from"| TenantHeader

    %% Styling
    style SA_GC fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proc fill:#4a90e2,stroke:#333,color:#fff
    style Role_GC fill:#f5a623,stroke:#333
    style RB_GC fill:#e8e8e8,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style StatefulSets fill:#7ed321,stroke:#333
    style Secret1 fill:#ff6b6b,stroke:#333,color:#fff
    style Secret2 fill:#ff6b6b,stroke:#333,color:#fff
    style ExtGW fill:#ffe6cc,stroke:#d79b00
    style NoRBAC1 fill:#f0f0f0,stroke:#ccc,stroke-dasharray:5 5
    style NoRBAC2 fill:#f0f0f0,stroke:#ccc,stroke-dasharray:5 5
