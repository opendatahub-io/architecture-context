graph TD
    subgraph Clients["Request Sources"]
        SDK["MLflow SDK Client<br/>(Bearer Token)"]
        Browser["Browser<br/>(OAuth via ODH)"]
    end

    subgraph AuthFlow["Authentication Flow (kubernetes-auth plugin)"]
        Middleware["FastAPI Middleware<br/>kubernetes-auth"]
        TokenExtract["1. Extract Bearer Token<br/>from Authorization header"]
        WorkspaceHeader["2. Read X-MLFLOW-WORKSPACE<br/>header (namespace)"]
        SSAR["3. SelfSubjectAccessReview<br/>API Group: mlflow.kubeflow.org"]
        AuthResult{"4. Authorized?"}
    end

    subgraph K8sRBAC["Kubernetes RBAC (managed by MLflow Operator)"]
        K8sAPI["Kubernetes API Server"]
        subgraph RBACRules["RBAC Rules (mlflow.kubeflow.org)"]
            Experiments["mlflow.kubeflow.org<br/>experiments<br/>get, list, create, update, delete"]
            Runs["mlflow.kubeflow.org<br/>runs<br/>get, list, create, update, delete"]
            Models["mlflow.kubeflow.org<br/>registered-models<br/>get, list, create, update, delete"]
        end
    end

    subgraph ServiceAccountPerms["MLflow ServiceAccount Permissions"]
        SA["ServiceAccount: mlflow-sa"]
        NSPerm["v1/namespaces<br/>list, watch"]
        SSARPerm["authorization.k8s.io<br/>SelfSubjectAccessReview<br/>create"]
        CRDPerm["mlflow.kubeflow.org<br/>MLflowConfig<br/>get, list, watch"]
    end

    subgraph WorkspaceIsolation["Workspace-Scoped Data Access"]
        DBQueries["SQLAlchemy Queries<br/>WHERE workspace = namespace"]
        ArtifactPaths["Artifact Paths<br/>scoped to workspace root"]
    end

    SDK --> Middleware
    Browser --> Middleware
    Middleware --> TokenExtract
    TokenExtract --> WorkspaceHeader
    WorkspaceHeader --> SSAR
    SSAR -->|"validates against"| K8sAPI
    K8sAPI --> RBACRules
    SSAR --> AuthResult
    AuthResult -->|"Yes"| DBQueries
    AuthResult -->|"Yes"| ArtifactPaths
    AuthResult -->|"No"| Denied["403 Forbidden"]

    SA -->|"bound via RoleBinding"| NSPerm
    SA -->|"bound via ClusterRoleBinding"| SSARPerm
    SA -->|"bound via RoleBinding"| CRDPerm

    style Middleware fill:#e74c3c,stroke:#333,color:#fff
    style SSAR fill:#e74c3c,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style Experiments fill:#7ed321,stroke:#333
    style Runs fill:#7ed321,stroke:#333
    style Models fill:#7ed321,stroke:#333
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style NSPerm fill:#dae8fc,stroke:#6c8ebf
    style SSARPerm fill:#dae8fc,stroke:#6c8ebf
    style CRDPerm fill:#dae8fc,stroke:#6c8ebf
    style DBQueries fill:#d5e8d4,stroke:#82b366
    style ArtifactPaths fill:#d5e8d4,stroke:#82b366
    style Denied fill:#999,stroke:#333,color:#fff
