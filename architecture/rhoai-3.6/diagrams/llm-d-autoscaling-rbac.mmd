graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_Prom["kube-prometheus-stack-prometheus"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_MetricsAuth["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_MetricsReader["metrics-reader-rolebinding<br/>(NS: workload-variant-autoscaler-monitoring)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(Namespace-scoped)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps"]
        Namespaces["core<br/>namespaces"]
        Nodes["core<br/>nodes, nodes/status"]
        Pods["core<br/>pods"]
        ResourceQuotas["core<br/>resourcequotas"]
        Services["core<br/>services"]
        Events["core<br/>events"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps<br/>deployments"]
        DeploymentsScale["apps<br/>deployments/scale"]
        ReplicaSets["apps<br/>replicasets"]
        StatefulSets["apps<br/>statefulsets"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPAs["autoscaling<br/>horizontalpodautoscalers"]
    end

    subgraph InferenceResources["Inference Resources"]
        InferencePools["inference.networking.k8s.io<br/>inference.networking.x-k8s.io<br/>inferencepools"]
    end

    subgraph KEDAResources["KEDA Resources"]
        ScaledObjects["keda.sh<br/>scaledobjects"]
    end

    subgraph LWSResources["LWS Resources"]
        LeaderWorkerSets["leaderworkerset.x-k8s.io<br/>leaderworkersets"]
        LWSScale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>leases"]
        LEEvents["core<br/>events"]
    end

    %% Service Account → Binding → Role
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_MetricsAuth
    SA_CM -->|bound via| RB_Leader
    SA_Prom -->|bound via| CRB_MetricsReader
    SA_EPP -->|bound via| CRB_EPP

    CRB_Manager -->|grants| CR_Manager
    CRB_MetricsAuth -->|grants| CR_MetricsAuth
    CRB_MetricsReader -->|grants| CR_MetricsReader
    CRB_EPP -->|grants| CR_EPP
    RB_Leader -->|grants| R_Leader

    %% Role → Resources
    CR_Manager -->|get,list,watch| ConfigMaps
    CR_Manager -->|get,list,watch| Namespaces
    CR_Manager -->|get,list,watch| Nodes
    CR_Manager -->|get,list,watch| Pods
    CR_Manager -->|get,list,watch| ResourceQuotas
    CR_Manager -->|get,list,watch| Services
    CR_Manager -->|create,patch| Events
    CR_Manager -->|get,list,patch,update,watch| Deployments
    CR_Manager -->|get,update| DeploymentsScale
    CR_Manager -->|get,list,watch| ReplicaSets
    CR_Manager -->|get,list,watch| StatefulSets
    CR_Manager -->|get,list,patch,update,watch| HPAs
    CR_Manager -->|get,list,watch| InferencePools
    CR_Manager -->|get,list,patch,update,watch| ScaledObjects
    CR_Manager -->|get,list,patch,update,watch| LeaderWorkerSets
    CR_Manager -->|get,update| LWSScale
    CR_Manager -->|get,list,watch| ServiceMonitors

    CR_MetricsAuth -->|create| TokenReviews
    CR_MetricsAuth -->|create| SAR

    CR_MetricsReader -->|get| MetricsURL
    CR_EPP -->|get| MetricsURL

    R_Leader -->|create,delete,get,list,patch,update,watch| Leases
    R_Leader -->|create,patch| LEEvents

