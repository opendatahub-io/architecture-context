graph TB
    subgraph Client["CLIENT ENVIRONMENT"]
        SDK["Kubeflow SDK<br/>kubeflow v0.4.1+rhai0<br/>Python >=3.10"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>Bearer Token / RBAC"]
        TrainerCtrl["Trainer Controller<br/>(watches TrainJob CRs)"]
        KatibCtrl["Katib Controller<br/>(watches Experiment CRs)"]
        SparkOp["Spark Operator<br/>(watches SparkConnect CRs)"]
    end

    subgraph TrainingPod["TRAINING POD (user namespace)"]
        direction TB
        TrainContainer["Training Container<br/>Injected instrumentation<br/>(inspect.getsource)"]
        MetricsServer["Metrics Server<br/>28080/TCP HTTP<br/>NO AUTH<br/>binds 0.0.0.0"]
        vLLMSidecar["vLLM Sidecar<br/>8234/TCP HTTP<br/>localhost only<br/>(Spec. Decoding only)"]
        TrainContainer --- MetricsServer
        TrainContainer -->|localhost:8234| vLLMSidecar
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        ModelReg["Model Registry<br/>443/TCP or 8080/TCP<br/>HTTPS/HTTP<br/>user_token + custom_ca"]
        KFPipelines["Kubeflow Pipelines<br/>443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS TLS<br/>HF_TOKEN (Bearer)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS TLS<br/>AWS IAM Credentials"]
    end

    %% Client to Control Plane
    SDK -->|"HTTPS/443<br/>TLS<br/>Bearer token (kubeconfig)"| K8sAPI

    %% Controller interactions
    TrainerCtrl -->|"HTTP/28080<br/>No encryption<br/>No auth"| MetricsServer
    K8sAPI -.->|"CRD watch"| TrainerCtrl
    K8sAPI -.->|"CRD watch"| KatibCtrl
    K8sAPI -.->|"CRD watch"| SparkOp

    %% Training pod egress
    TrainContainer -->|"HTTPS/443<br/>TLS<br/>Projected SA token"| K8sAPI
    TrainContainer -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub
    TrainContainer -->|"HTTPS/443<br/>TLS<br/>AWS credentials"| S3

    %% SDK to platform services
    SDK -->|"HTTPS/443 or HTTP/8080<br/>TLS (configurable)<br/>user_token"| ModelReg
    SDK -->|"HTTPS/443<br/>TLS"| KFPipelines

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef controlplane fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef pod fill:#fce4ec,stroke:#c62828,stroke-width:2px
    classDef platform fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef external fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px

    class SDK client
    class K8sAPI,TrainerCtrl,KatibCtrl,SparkOp controlplane
    class TrainContainer,MetricsServer,vLLMSidecar pod
    class ModelReg,KFPipelines platform
    class HFHub,S3 external
