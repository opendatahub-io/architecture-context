graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["REST Client"]
        MCPClient["MCP Client / AI Agent"]
    end

    subgraph Ingress["INGRESS (Authentication Boundary)"]
        Proxy["kube-rbac-proxy<br/>443/TCP<br/>TLS 1.2+ termination<br/>Bearer token authn + RBAC authz<br/>Injects X-User, X-Tenant"]
    end

    subgraph AppLayer["APPLICATION LAYER (Behind Proxy)"]
        direction TB

        subgraph APIBlock["eval-hub API"]
            APIServer["eval-hub API Server<br/>127.0.0.1:8080/TCP<br/>TLS 1.2-1.3<br/>FIPS: blocks InsecureSkipVerify"]
            MetricsSrv["Metrics Server<br/>0.0.0.0:8081/TCP<br/>HTTP (no TLS)<br/>No auth"]
        end

        MCPServer["evalhub-mcp<br/>3001/TCP<br/>TLS 1.2+<br/>stdio / HTTP / SSE"]
    end

    subgraph JobPods["EVALUATION JOB PODS (Per-Job NetworkPolicy)"]
        direction TB

        subgraph InitPhase["Init Phase"]
            InitContainer["eval-runtime-init<br/>Downloads test data<br/>Secrets mounted"]
        end

        subgraph RunPhase["Runtime Phase"]
            Adapter["Provider Adapter<br/>lm-eval / RAGAS /<br/>Garak / GuideLLM"]
            SidecarProxy["eval-runtime-sidecar<br/>Reverse Proxy<br/>TLS 1.2+ clients<br/>SA token injection<br/>service-ca.crt"]
        end
    end

    subgraph Persistence["PERSISTENCE"]
        PostgreSQL["PostgreSQL<br/>5432/TCP SQL<br/>Encryption: configurable<br/>Auth: password from secrets<br/>Row-level tenant isolation"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>Jobs, ConfigMaps, Secrets,<br/>NetworkPolicies, CRDs"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>AWS credentials"]
        MLflow["MLflow Server<br/>HTTPS TLS 1.2+<br/>SA token"]
        ModelEP["Model Endpoints<br/>HTTPS TLS 1.2+<br/>SA token"]
        OCI["OCI Registries<br/>443/TCP HTTPS<br/>Token auth"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS"]
    end

    subgraph Telemetry["TELEMETRY"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable encryption"]
        Prometheus["Prometheus<br/>Scrapes 8081/TCP HTTP"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Proxy
    MCPClient -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Proxy

    %% Ingress to App Layer
    Proxy -->|"HTTP/8080<br/>TLS 1.2+<br/>X-User, X-Tenant"| APIServer
    Proxy -->|"HTTP/3001<br/>TLS 1.2+<br/>X-User, X-Tenant"| MCPServer

    %% MCP to API
    MCPServer -->|"HTTPS/8080<br/>Bearer Token"| APIServer

    %% API to infrastructure
    APIServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    APIServer -->|"SQL/5432<br/>Password"| PostgreSQL
    APIServer -->|"HTTPS<br/>SA token"| MLflow
    APIServer -->|"OTLP/gRPC"| OTel

    %% Metrics
    Prometheus -->|"HTTP/8081<br/>No auth"| MetricsSrv

    %% Job pod flows
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS creds / Token"| S3
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+"| HuggingFace
    Adapter -->|"HTTP (pod-local)<br/>No encryption"| SidecarProxy
    SidecarProxy -->|"HTTPS<br/>TLS 1.2+<br/>SA token"| ModelEP
    SidecarProxy -->|"HTTPS<br/>TLS 1.2+<br/>SA token"| MLflow
    SidecarProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Token"| OCI
    SidecarProxy -->|"HTTPS/8080<br/>SA token"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef appLayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef jobPod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef persistence fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalService fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef telemetry fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client,MCPClient external
    class Proxy ingress
    class APIServer,MetricsSrv,MCPServer appLayer
    class InitContainer,Adapter,SidecarProxy jobPod
    class PostgreSQL persistence
    class K8sAPI persistence
    class S3,MLflow,ModelEP,OCI,HuggingFace externalService
    class OTel,Prometheus telemetry
