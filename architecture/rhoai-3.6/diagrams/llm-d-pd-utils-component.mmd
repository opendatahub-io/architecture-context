graph TB
    subgraph PdUtils["llm-d-pd-utils Toolkit"]
        direction TB

        subgraph PreflightSkill["llm-d-preflight-checks (Agentic Skill)"]
            PreflightScript["Preflight Script<br/>(Python)"]
            PauseServer["Pause HTTP Server<br/>8000/TCP"]
            PreflightScript -->|"pause mode"| PauseServer
        end

        subgraph NetworkSkill["llm-d-networking-tests (Agentic Skill)"]
            RunTests["run-tests.py<br/>(Unified Entry Point)"]
            PerfTest["perftest module<br/>(ib_write_bw / ib_read_bw)"]
            Iperf3["iperf3 module"]
            NcclRccl["NCCL/RCCL module"]
            NixlBench["nixlbench module"]
            Discovery["discovery module"]
            RunTests -->|"importlib"| PerfTest
            RunTests -->|"importlib"| Iperf3
            RunTests -->|"importlib"| NcclRccl
            RunTests -->|"importlib"| NixlBench
            RunTests -->|"importlib"| Discovery
        end

        subgraph NIXLBenchmark["NIXL Benchmark Suite"]
            BenchmarkPy["benchmark.py<br/>(PyTorch + ZMQ)"]
            NIXLClient["nixl-client Pod"]
            NIXLServer["nixl-server Pod"]
            BenchmarkPy --> NIXLClient
            BenchmarkPy --> NIXLServer
        end

        subgraph Installers["NIXL Installers"]
            RootInstall["install_nixl.sh<br/>(root)"]
            NonRootInstall["install_nixl_nonroot.sh<br/>(non-root / OpenShift)"]
        end
    end

    Operator["Operator / SRE"] -->|"kubectl exec"| PreflightScript
    Operator -->|"runs"| RunTests
    Operator -->|"kubectl exec curl /exit"| PauseServer

    PreflightScript -->|"collects"| GPUTopology["GPU Topology<br/>NVLink Status"]
    PreflightScript -->|"gates startup"| VllmServe["vLLM serve"]

    RunTests -->|"kubectl exec"| VllmPods["llm-d Model Server Pods"]
    RunTests -->|"generates"| Reports["Tabular + PNG Reports"]

    NIXLClient -->|"VRAM-to-VRAM<br/>5555/TCP ZMQ + UCX"| NIXLServer

    style PreflightSkill fill:#4a90e2,stroke:#333
    style NetworkSkill fill:#4a90e2,stroke:#333
    style NIXLBenchmark fill:#f5a623,stroke:#333
    style Installers fill:#7ed321,stroke:#333
    style Operator fill:#e8e8e8,stroke:#333
    style VllmServe fill:#e8e8e8,stroke:#333
    style VllmPods fill:#e8e8e8,stroke:#333
