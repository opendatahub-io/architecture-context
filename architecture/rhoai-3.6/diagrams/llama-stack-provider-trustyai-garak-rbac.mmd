graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["Component-defined RBAC"]
        L2["Inherited / External RBAC"]
        style L1 fill:#4a90e2,color:#fff
        style L2 fill:#e8e8e8
    end

    subgraph AdapterPod["Garak Adapter Pod (K8s Job)"]
        SA["ServiceAccount<br/>eval-hub job SA<br/>(provisioned by eval-hub)"]
    end

    subgraph SecretAccess["Secret Access"]
        ModelAuth["Secret: model-auth<br/>/mnt/model-auth<br/>(volume mount, optional=True)"]
        S3Secret["Secret: Data Connection<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>(env injection)"]
        KFPAuthToken["Secret/SA Token<br/>KFP_AUTH_TOKEN<br/>(env / SA file)"]
    end

    subgraph ConfigAccess["ConfigMap Access"]
        JobSpec["ConfigMap: eval-job<br/>/etc/eval-job/spec.json<br/>(volume mount)"]
        TrustyAICM["ConfigMap:<br/>trustyai-service-operator-config<br/>(K8s API read, optional)"]
    end

    subgraph KFPPipeline["KFP Pipeline Pods"]
        KFPSA["ServiceAccount<br/>KFP pipeline SA<br/>(provisioned by KFP)"]
        KFPSecrets["Secrets injected via<br/>kubernetes.use_secret_as_env<br/>- S3 credentials<br/>- Model auth (volume mount)"]
    end

    SA -->|reads| ModelAuth
    SA -->|reads| S3Secret
    SA -->|reads| KFPAuthToken
    SA -->|mounts| JobSpec
    SA -.->|optional K8s API read| TrustyAICM
    SA -->|submits pipelines to| KFPSA
    KFPSA -->|uses| KFPSecrets

    Note["Note: This component defines NO<br/>ClusterRoles, Roles, or RoleBindings.<br/>All RBAC is inherited from eval-hub<br/>and KFP service configurations."]

    style SA fill:#e8e8e8
    style KFPSA fill:#e8e8e8
    style ModelAuth fill:#f8cecc,stroke:#b85450
    style S3Secret fill:#f8cecc,stroke:#b85450
    style KFPAuthToken fill:#f8cecc,stroke:#b85450
    style KFPSecrets fill:#f8cecc,stroke:#b85450
    style JobSpec fill:#ffe6cc,stroke:#d79b00
    style TrustyAICM fill:#ffe6cc,stroke:#d79b00
    style Note fill:#fff,stroke:#999,stroke-dasharray:5 5
