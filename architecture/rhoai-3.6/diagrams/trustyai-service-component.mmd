graph TB
    subgraph TrustyAI["TrustyAI Service"]
        direction TB

        subgraph MainApp["Main Application Server<br/>127.0.0.1:8081 HTTP / 0.0.0.0:4443 HTTPS"]
            MetricsAPI["Metrics API<br/>(drift, fairness, explainers)"]
            InfoAPI["Info API<br/>(metadata, names, tags)"]
            DataUpload["Data Upload API"]
            PromEndpoint["/q/metrics Endpoint"]
        end

        subgraph HealthApp["Health / Consumer Server<br/>0.0.0.0:8080 HTTP"]
            HealthProbes["Health Probes<br/>(/q/health, /ready, /live)"]
            KServeConsumer["KServe Consumer<br/>(CloudEvents POST)"]
            ModelMeshConsumer["ModelMesh Consumer<br/>(/consumer/kserve/v2)"]
        end

        subgraph Background["Background Tasks"]
            Scheduler["PrometheusScheduler<br/>(asyncio, 30s interval)"]
        end

        subgraph Storage["Storage Layer"]
            StorageInterface["StorageInterface<br/>(abstract)"]
            PVCStorage["PVCStorage<br/>(HDF5 files)"]
            MariaDBStorage["MariaDBStorage<br/>(relational, TLS)"]
            Migrator["PVCToDBMigrator<br/>(idempotent)"]
            StorageInterface --- PVCStorage
            StorageInterface --- MariaDBStorage
            PVCStorage -.->|migrate| Migrator
            Migrator -.->|migrate| MariaDBStorage
        end

        subgraph FeatureFlags["Feature Flag System"]
            FF["TRUSTYAI_ENABLE_*<br/>env vars"]
        end

        FF -->|gates| MetricsAPI
        Scheduler -->|reads| StorageInterface
        Scheduler -->|publishes| PromEndpoint
        KServeConsumer -->|writes| StorageInterface
        ModelMeshConsumer -->|writes| StorageInterface
        MetricsAPI -->|reads| StorageInterface
        DataUpload -->|writes| StorageInterface
    end

    %% External actors
    Client["Client<br/>(Dashboard, CLI)"]
    KubeRBACProxy["kube-rbac-proxy<br/>(sidecar)"]
    KServeLogger["KServe Inference Logger"]
    ModelMeshAgent["ModelMesh Agent"]
    Prometheus["Prometheus Server"]
    PVC["PersistentVolumeClaim"]
    MariaDB["MariaDB<br/>3306/TCP"]
    Operator["trustyai-service-operator"]
    Kubelet["Kubelet"]

    %% Flows
    Client -->|HTTPS / OAuth| KubeRBACProxy
    KubeRBACProxy -->|HTTP/8081| MainApp
    KServeLogger -->|HTTP/8080<br/>CloudEvents| KServeConsumer
    ModelMeshAgent -->|HTTP/8080<br/>KServe v2| ModelMeshConsumer
    Prometheus -->|scrape HTTP/8081| PromEndpoint
    PVCStorage -->|file I/O| PVC
    MariaDBStorage -->|MySQL/3306<br/>TLS optional| MariaDB
    Kubelet -->|HTTP/8080| HealthProbes
    Operator -.->|manages lifecycle| TrustyAI

    %% Styles
    style TrustyAI fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style MainApp fill:#d5e8f4,stroke:#4a90e2
    style HealthApp fill:#d5e8f4,stroke:#4a90e2
    style Background fill:#f0e6ff,stroke:#9b59b6
    style Storage fill:#e8f5e9,stroke:#4caf50
    style FeatureFlags fill:#fff3e0,stroke:#ff9800
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style Prometheus fill:#fff2cc,stroke:#d6b656
    style MariaDB fill:#fff2cc,stroke:#d6b656
    style Operator fill:#d5e8d4,stroke:#82b366
    style KServeLogger fill:#f9f9f9,stroke:#999
    style ModelMeshAgent fill:#f9f9f9,stroke:#999
