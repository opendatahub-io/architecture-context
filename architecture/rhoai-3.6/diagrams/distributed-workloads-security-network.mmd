graph TB
    subgraph BuildTime["BUILD TIME (Konflux Pipeline)"]
        direction TB
        Konflux["Konflux Pipeline<br/>Hermetic Build"]
        Cachi2["cachi2 Prefetch<br/>Local Cache"]
    end

    subgraph ExternalPackages["EXTERNAL PACKAGE SOURCES"]
        AIPCCIndex["AIPCC PyPI Index<br/>console.redhat.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth (public index)"]
    end

    subgraph TestEnvironment["TEST ENVIRONMENT (E2E Tests - Non-Production)"]
        direction TB
        TestRunner["E2E Test Runner<br/>Go binary<br/>SA: test-specific"]

        subgraph TestTargets["Test Target CRDs"]
            TrainJob["TrainJob CR"]
            PyTorchJob["PyTorchJob CR"]
            RayJob["RayJob CR"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        Prometheus["Prometheus<br/>443/TCP HTTPS<br/>TLS 1.2+ (custom CA)<br/>Bearer Token"]
    end

    subgraph RuntimeEnvironment["RUNTIME (Workbench Mode - User Namespace)"]
        direction TB
        Jupyter["JupyterLab<br/>8888/TCP HTTP<br/>Auth: RHOAI controller"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        S3["S3-Compatible Storage<br/>443/TCP or 9000/TCP<br/>HTTPS/HTTP<br/>TLS (configurable)<br/>AWS IAM / Access Key"]
    end

    %% Build flows
    Konflux -->|HTTPS/443<br/>TLS 1.2+<br/>No Auth| AIPCCIndex
    AIPCCIndex -->|prefetch| Cachi2
    Cachi2 -->|pip install --no-index| Konflux

    %% Test flows
    TestRunner -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount| K8sAPI
    TestRunner -->|HTTPS/443<br/>TLS 1.2+ custom CA<br/>Bearer Token| Prometheus
    TestRunner -.->|InsecureSkipVerify<br/>Test-only| S3

    %% Runtime flows
    Jupyter -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| HFHub
    Jupyter -->|HTTPS/443<br/>TLS 1.2+<br/>Access Key| S3

    %% Styling
    classDef buildtime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef test fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef runtime fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Konflux,Cachi2 buildtime
    class AIPCCIndex,HFHub,S3 external
    class TestRunner,TrainJob,PyTorchJob,RayJob test
    class K8sAPI,Prometheus cluster
    class Jupyter runtime
