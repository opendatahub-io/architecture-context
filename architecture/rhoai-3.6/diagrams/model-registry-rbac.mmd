graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["controller-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["controller-model-registry-<br/>manager-rolebinding<br/>(cluster-scoped)"]
        CRB_MetricsAuth["controller-metrics-<br/>auth-rolebinding<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["controller-leader-<br/>election-rolebinding<br/>(namespace: kubeflow)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["controller-model-registry-<br/>manager-role"]
        CR_MetricsAuth["controller-metrics-<br/>auth-role"]
        CR_MetricsReader["controller-metrics-<br/>reader"]
    end

    subgraph Roles["Roles"]
        R_Leader["controller-leader-<br/>election-role<br/>(namespace: kubeflow)"]
    end

    subgraph APIResources_Manager["API Resources (Manager)"]
        Res_Services["(core)<br/>services"]
        Res_ISVC["serving.kserve.io<br/>inferenceservices"]
        Res_ISVCFinalizers["serving.kserve.io<br/>inferenceservices/finalizers"]
    end

    subgraph APIResources_Auth["API Resources (Auth)"]
        Res_TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        Res_SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        URL_Metrics["/metrics"]
    end

    subgraph APIResources_Leader["API Resources (Leader Election)"]
        Res_ConfigMaps["(core)<br/>configmaps"]
        Res_Leases["coordination.k8s.io<br/>leases"]
        Res_Events["(core)<br/>events"]
    end

    %% SA → Bindings
    SA_Controller -->|"bound via"| CRB_Manager
    SA_Controller -->|"bound via"| CRB_MetricsAuth
    SA_Controller -->|"bound via"| RB_Leader

    %% Bindings → Roles
    CRB_Manager -->|"grants"| CR_Manager
    CRB_MetricsAuth -->|"grants"| CR_MetricsAuth
    RB_Leader -->|"grants"| R_Leader

    %% Manager Role → Resources
    CR_Manager -->|"get, list, watch"| Res_Services
    CR_Manager -->|"get, list, patch,<br/>update, watch"| Res_ISVC
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| Res_ISVCFinalizers

    %% Metrics Auth → Resources
    CR_MetricsAuth -->|"create"| Res_TokenReviews
    CR_MetricsAuth -->|"create"| Res_SAR

    %% Metrics Reader → Non-resource
    CR_MetricsReader -->|"get"| URL_Metrics

    %% Leader Election → Resources
    R_Leader -->|"create, delete, get,<br/>list, patch, update, watch"| Res_ConfigMaps
    R_Leader -->|"create, delete, get,<br/>list, patch, update, watch"| Res_Leases
    R_Leader -->|"create, patch"| Res_Events

    %% Styles
    style SA_Controller fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style R_Leader fill:#e67e22,color:#fff
    style Res_Services fill:#7ed321,color:#fff
    style Res_ISVC fill:#7ed321,color:#fff
    style Res_ISVCFinalizers fill:#7ed321,color:#fff
    style Res_TokenReviews fill:#7ed321,color:#fff
    style Res_SAR fill:#7ed321,color:#fff
    style URL_Metrics fill:#95a5a6,color:#fff
    style Res_ConfigMaps fill:#7ed321,color:#fff
    style Res_Leases fill:#7ed321,color:#fff
    style Res_Events fill:#7ed321,color:#fff
    style CRB_Manager fill:#bdc3c7,color:#333
    style CRB_MetricsAuth fill:#bdc3c7,color:#333
    style RB_Leader fill:#bdc3c7,color:#333
