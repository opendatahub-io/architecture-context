graph TB
    subgraph External["External Users"]
        User["User (Browser)"]
        CLI["CLI User"]
    end

    subgraph Routes["OpenShift Routes (TLS Edge)"]
        PlannerRoute["planner Route<br/>443/TCP HTTPS"]
        BackendRoute["planner-backend Route<br/>443/TCP HTTPS"]
    end

    subgraph PlannerSystem["llm-d-planner System"]
        subgraph Frontend["Frontend"]
            UI["Streamlit UI<br/>8501/TCP"]
        end

        subgraph Backend["Backend"]
            API["FastAPI Backend<br/>8000/TCP"]
            IntentExtractor["Intent Extractor"]
            SpecGenerator["Specification Generator"]
            RecommendationEngine["Recommendation Engine<br/>(Quality/Price/Latency Scoring)"]
            DeploymentGenerator["Deployment Generator<br/>(KServe/vLLM YAML)"]
            GPUDetector["GPU Detector<br/>(ClusterRole: node list)"]
            BenchmarkDB["SQLite Benchmark DB"]
            QualityScoring["Quality Scoring<br/>(Arena + AA Data)"]
        end

        subgraph LLMSidecar["LLM Sidecar"]
            Ollama["Ollama<br/>11434/TCP<br/>granite3.3:2b"]
        end

        subgraph DevTools["Development Tools"]
            Simulator["vLLM Simulator<br/>8080/TCP"]
        end

        PlannerCLI["Planner CLI"]
    end

    subgraph ExternalServices["External Services"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        ModelCatalog["RHOAI Model Catalog<br/>8443/TCP"]
        HFHub["HuggingFace Hub<br/>443/TCP"]
        OpenAIAPI["OpenAI API<br/>443/TCP"]
        VertexAI["Vertex AI<br/>443/TCP"]
        ArenaAPI["LMSYS Arena API<br/>443/TCP"]
        AAAPI["Artificial Analysis API<br/>443/TCP"]
    end

    subgraph Targets["Deployment Targets"]
        KServe["KServe InferenceService"]
    end

    %% User flows
    User -->|HTTPS/443| PlannerRoute
    User -->|HTTPS/443| BackendRoute
    CLI -->|direct| PlannerCLI

    PlannerRoute -->|HTTP/8501| UI
    BackendRoute -->|HTTP/8000| API

    UI -->|HTTPS/443 via Route| API

    %% Internal pipeline
    API --> IntentExtractor
    IntentExtractor --> SpecGenerator
    SpecGenerator --> RecommendationEngine
    RecommendationEngine --> DeploymentGenerator

    %% Backend integrations
    IntentExtractor -->|HTTP/11434| Ollama
    IntentExtractor -.->|HTTPS/443| OpenAIAPI
    IntentExtractor -.->|HTTPS/443| VertexAI
    GPUDetector -->|HTTPS/6443| K8sAPI
    RecommendationEngine --> BenchmarkDB
    RecommendationEngine --> QualityScoring
    QualityScoring -->|HTTPS/443| ArenaAPI
    QualityScoring -->|HTTPS/443| AAAPI
    API -->|HTTPS/8443| ModelCatalog
    API -->|HTTPS/443| HFHub
    DeploymentGenerator -->|kubectl| K8sAPI
    DeploymentGenerator -->|creates| KServe

    PlannerCLI --> API

