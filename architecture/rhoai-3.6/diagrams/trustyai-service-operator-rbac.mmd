    style SA_Manager fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proxy fill:#4a90e2,stroke:#333,color:#fff
    style SA_EHService fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
