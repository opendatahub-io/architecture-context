graph TD
    subgraph "Service Accounts"
        SA_Manager["trustyai-operator-module-<br/>controller-manager"]
        SA_Proxy["{name}-proxy<br/>(per TrustyAIService)"]
        SA_EHService["{name}-service<br/>(per EvalHub)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["trustyai-operator-module-<br/>manager-rolebinding"]
        CRB_Proxy["{name}-{ns}-proxy-<br/>rolebinding"]
        CRB_EHAuth["{name}-{ns}-auth-<br/>reviewer-crb"]
    end

    subgraph "ClusterRoles"
        CR_Manager["trustyai-operator-module-<br/>manager-role<br/>(39 rules, 20+ API groups)"]
        CR_Proxy["trustyai-service-operator-<br/>proxy-role"]
        CR_EHAuth["trustyai-service-operator-<br/>evalhub-auth-reviewer-role"]
    end

    subgraph "Core API Resources"
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
        Pods["Pods, Pods/exec, Pods/log"]
        Services["Services"]
        ServiceAccounts["ServiceAccounts"]
        PVCs["PersistentVolumeClaims"]
        Namespaces["Namespaces"]
        Events["Events"]
    end

    subgraph "Workload Resources"
        Deployments["apps/Deployments"]
        Jobs["batch/Jobs"]
        Leases["coordination/Leases"]
    end

    subgraph "CRD Resources"
        TrustyAICRDs["trustyai.opendatahub.io<br/>trustyaiservices, evalhubs,<br/>lmevaljobs, nemoguardrails,<br/>collections, evaluations,<br/>providers, status-events"]
        TrustyAIComponent["components.platform...<br/>trustyais"]
        CRDMgmt["apiextensions<br/>CRDs"]
    end

    subgraph "OpenShift Resources"
        Routes["route.openshift.io<br/>routes"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    subgraph "Networking Resources"
        IstioResources["networking.istio.io<br/>virtualservices,<br/>destinationrules,<br/>envoyfilters"]
        GatewayResources["gateway.networking.k8s.io<br/>gateways"]
        MCPResources["mcp.kuadrant.io<br/>mcpgatewayextensions"]
    end

    subgraph "External API Resources"
        KServeResources["serving.kserve.io<br/>inferenceservices,<br/>servingruntimes"]
        KueueResources["kueue.x-k8s.io<br/>workloads"]
        MonitoringResources["monitoring.coreos.com<br/>servicemonitors,<br/>prometheuses"]
        MLflowResources["mlflow.kubeflow.org<br/>experiments"]
        HWResources["infrastructure...<br/>hardwareprofiles"]
    end

    subgraph "Auth Resources"
        TokenReview["authentication<br/>tokenreviews"]
        SAR["authorization<br/>subjectaccessreviews"]
        RBACResources["rbac<br/>clusterroles,<br/>clusterrolebindings,<br/>roles, rolebindings"]
        Webhooks["admissionregistration<br/>mutating/validating<br/>webhookconfigs"]
    end

    %% Bindings
    SA_Manager -->|"bound via"| CRB_Manager
    SA_Proxy -->|"bound via"| CRB_Proxy
    SA_EHService -->|"bound via"| CRB_EHAuth

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Proxy -->|"grants"| CR_Proxy
    CRB_EHAuth -->|"grants"| CR_EHAuth

    %% Manager role permissions
    CR_Manager -->|"CRUD"| ConfigMaps
    CR_Manager -->|"CRUD"| Secrets
    CR_Manager -->|"CRUD + exec"| Pods
    CR_Manager -->|"CRUD"| Services
    CR_Manager -->|"CRUD"| ServiceAccounts
    CR_Manager -->|"CRUD"| PVCs
    CR_Manager -->|"read"| Namespaces
    CR_Manager -->|"create, patch"| Events
    CR_Manager -->|"full lifecycle"| Deployments
    CR_Manager -->|"CRUD"| Jobs
    CR_Manager -->|"full lifecycle"| Leases
    CR_Manager -->|"full lifecycle"| TrustyAICRDs
    CR_Manager -->|"full lifecycle"| TrustyAIComponent
    CR_Manager -->|"full lifecycle"| CRDMgmt
    CR_Manager -->|"full lifecycle"| Routes
    CR_Manager -->|"read"| APIServers
    CR_Manager -->|"full lifecycle"| IstioResources
    CR_Manager -->|"read"| GatewayResources
    CR_Manager -->|"read"| MCPResources
    CR_Manager -->|"read, patch"| KServeResources
    CR_Manager -->|"read, patch"| KueueResources
    CR_Manager -->|"full lifecycle"| MonitoringResources
    CR_Manager -->|"CRUD"| MLflowResources
    CR_Manager -->|"read"| HWResources
    CR_Manager -->|"create"| TokenReview
    CR_Manager -->|"create"| SAR
    CR_Manager -->|"full lifecycle"| RBACResources
    CR_Manager -->|"full lifecycle"| Webhooks

