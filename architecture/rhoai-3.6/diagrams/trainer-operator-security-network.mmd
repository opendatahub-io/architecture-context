graph TB
    subgraph External["EXTERNAL (Monitoring)"]
        Prometheus["Prometheus<br/>(openshift-monitoring)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (trainer-operator-system)"]
        direction TB
        Operator["trainer-operator-controller-manager<br/>SA: trainer-operator-controller-manager<br/>Image: quay.io/opendatahub/odh-trainer-operator<br/>Ports: 8443/TCP (metrics), 8081/TCP (probes)"]
        MetricsSecret["trainer-operator-metrics-tls<br/>(kubernetes.io/tls, service-ca)"]
        Operator -.->|loads TLS cert| MetricsSecret
    end

    subgraph AppNS["APPLICATIONS NAMESPACE (opendatahub)"]
        direction TB
        TrainerCtrl["kubeflow-trainer-controller-manager<br/>Ports: 9443/TCP (webhook),<br/>10443/TCP (progression),<br/>8443/TCP (metrics)"]
        WebhookCert["kubeflow-trainer-webhook-cert<br/>(Opaque, bootstrap generated)"]
        TrainerCtrl -.->|loads webhook cert| WebhookCert
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+"]
    end

    subgraph OpenShiftConfig["OPENSHIFT CONFIGURATION"]
        OSAPIServer["OpenShift APIServer<br/>(config.openshift.io)<br/>TLS profile + adherence policy"]
    end

    %% Flows
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer token + RBAC<br/>NetworkPolicy: allow-metrics-traffic"| Operator

    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>CR watch, SSA, discovery, GC"| APIServer

    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>TLS profile read"| OSAPIServer

    Operator -->|"Deploys via SSA<br/>(field owner: trainer-module-controller)"| TrainerCtrl

    TrainerCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>Egress unrestricted"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef appns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef osconfig fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Prometheus external
    class Operator,MetricsSecret operatorns
    class TrainerCtrl,WebhookCert appns
    class APIServer controlplane
    class OSAPIServer osconfig
