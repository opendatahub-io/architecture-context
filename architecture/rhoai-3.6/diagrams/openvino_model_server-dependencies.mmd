graph LR
    OVMS["OpenVINO Model Server<br/>(C++ Inference Service)"]

    %% Core External Dependencies
    OVMS -->|"core inference engine"| OpenVINO["OpenVINO 2026.2.0"]
    OVMS -->|"GenAI pipelines"| GenAI["OpenVINO GenAI<br/>(continuous batching)"]
    OVMS -->|"tokenizer support"| Tokenizers["OpenVINO Tokenizers"]
    OVMS -->|"graph execution"| MediaPipe["MediaPipe<br/>(vendored)"]

    %% Build Dependencies
    OVMS -->|"build system"| Bazel["Bazel 6.1.1"]

    %% Transport Dependencies
    OVMS -->|"REST API"| Drogon["Drogon HTTP<br/>(vendored)"]
    OVMS -->|"gRPC transport"| gRPCLib["gRPC C++<br/>(vendored)"]
    OVMS -->|"TLS/crypto"| BoringSSL["BoringSSL<br/>(vendored via Bazel)"]

    %% Library Dependencies
    OVMS -->|"C++ utilities"| Boost["Boost 1.68.0"]
    OVMS -->|"image processing"| OpenCV["OpenCV 4.13.0"]
    OVMS -->|"Azure storage"| AzureSDK["Azure Storage<br/>C++ SDK 7.5.0"]
    OVMS -->|"HTTP client"| cpprest["cpprestsdk 2.10.16"]
    OVMS -->|"XML parsing"| pugixml["pugixml 1.13"]
    OVMS -->|"JSON parsing"| rapidjson["rapidjson<br/>(vendored)"]
    OVMS -->|"HF model download"| libgit2["libgit2 (system)"]
    OVMS -->|"HTTP downloads"| curl["curl 8.20.0"]

    %% Optional Dependencies
    OVMS -.->|"Python support"| Python["Python 3.12"]
    OVMS -.->|"chat templates"| Jinja2["Jinja2 3.1.6"]

    %% Internal Platform Dependencies
    KServe["KServe"] -->|"manages lifecycle via<br/>ServingRuntime CRD"| OVMS
    Istio["Istio / Service Mesh"] -.->|"TLS termination<br/>traffic mgmt"| OVMS

    %% External Storage Services
    OVMS -->|"model storage"| S3["AWS S3"]
    OVMS -->|"model storage"| GCS["Google Cloud Storage"]
    OVMS -->|"model storage"| AzureBlob["Azure Blob Storage"]
    OVMS -->|"model download"| HFHub["HuggingFace Hub"]

    %% Integration Points
    Prometheus["Prometheus"] -->|"scrapes /metrics"| OVMS

