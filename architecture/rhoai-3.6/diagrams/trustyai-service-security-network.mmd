graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(Dashboard, CLI)"]
        KServeLogger["KServe Inference Logger"]
        ModelMeshAgent["ModelMesh Agent"]
        Kubelet["Kubelet"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
        KubeRBAC["kube-rbac-proxy<br/>(sidecar)<br/>OAuth Bearer validation"]
    end

    subgraph Application["APPLICATION (TrustyAI Service)"]
        direction TB

        subgraph MainServer["Main App Server"]
            MainHTTP["127.0.0.1:8081/TCP<br/>HTTP<br/>Auth: kube-rbac-proxy"]
            MainHTTPS["0.0.0.0:4443/TCP<br/>HTTPS (system crypto)<br/>Auth: NONE"]
        end

        subgraph HealthServer["Health / Consumer Server"]
            Health["0.0.0.0:8080/TCP<br/>HTTP<br/>Auth: NONE"]
        end

        subgraph BackgroundTasks["Background"]
            Scheduler["PrometheusScheduler<br/>(30s interval)"]
        end
    end

    subgraph StorageBackends["STORAGE BACKENDS"]
        PVC["PVC / HDF5<br/>Local filesystem<br/>Namespace-scoped"]
        MariaDB["MariaDB<br/>3306/TCP MySQL<br/>TLS optional<br/>Username/Password"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus Server"]
    end

    %% Authenticated flow
    Client -->|"HTTPS<br/>OAuth Bearer Token"| KubeRBAC
    KubeRBAC -->|"HTTP/8081<br/>No encryption<br/>Forwarded identity"| MainHTTP

    %% Direct HTTPS (no auth)
    Client -.->|"HTTPS/4443<br/>TLS (system crypto)<br/>NO AUTH"| MainHTTPS

    %% Unauthenticated consumer flows
    KServeLogger -->|"HTTP/8080<br/>CloudEvents POST<br/>No encryption, No auth"| Health
    ModelMeshAgent -->|"HTTP/8080<br/>POST /consumer/kserve/v2<br/>No encryption, No auth"| Health
    Kubelet -->|"HTTP/8080<br/>GET /q/health/*<br/>No auth"| Health

    %% Storage flows
    MainHTTP -->|"File I/O"| PVC
    MainHTTP -->|"MySQL/3306<br/>TLS optional"| MariaDB
    Health -->|"File I/O"| PVC
    Health -->|"MySQL/3306<br/>TLS optional"| MariaDB
    Scheduler -->|"File I/O"| PVC
    Scheduler -->|"MySQL/3306<br/>TLS optional"| MariaDB

    %% Prometheus scrape
    Prometheus -->|"HTTP/8081<br/>GET /q/metrics<br/>via kube-rbac-proxy"| KubeRBAC

    %% Styles
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef mainserver fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef healthserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client,KServeLogger,ModelMeshAgent,Kubelet external
    class KubeRBAC authboundary
    class MainHTTP mainserver
    class MainHTTPS warning
    class Health healthserver
    class PVC,MariaDB storage
    class Prometheus observability
