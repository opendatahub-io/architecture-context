graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (AI Gateway)"]
        Envoy["Envoy Proxy<br/>443/TCP → HTTPRoute routing<br/>TLS 1.2+<br/>EnvoyFilter: ext_proc"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS)"]
        direction TB

        subgraph NS_Release["Namespace: {release-namespace}"]
            subgraph Pod["Payload Processing Pod"]
                direction TB
                ExtProc["ext-proc gRPC Server<br/>9004/TCP gRPC<br/>Optional self-signed TLS<br/>SA: {name}-{release}"]
                Health["Health Server<br/>9005/TCP gRPC<br/>Plaintext"]
                Metrics["Metrics Endpoint<br/>8080/TCP HTTP<br/>Auth: optional"]
            end
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph OptionalInteg["OPTIONAL INTEGRATIONS"]
        NeMo["NeMo Guardrails<br/>HTTPS (enforced)<br/>TLS 1.2+<br/>/v1/guardrail/checks"]
        Metering["External Metering<br/>HTTP<br/>No encryption"]
    end

    subgraph ExternalServices["EXTERNAL LLM PROVIDERS (via Envoy)"]
        LLM["OpenAI / Anthropic / Azure /<br/>AWS Bedrock / GCP Vertex<br/>443/TCP HTTPS<br/>TLS (DestinationRule SIMPLE)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token / API Key"| Envoy
    Envoy -->|"gRPC/9004<br/>mTLS (Istio) or self-signed TLS<br/>ext_proc callout"| ExtProc
    ExtProc -->|"gRPC/9004<br/>ProcessingResponse + DynamicMetadata"| Envoy
    ExtProc -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    ExtProc -.->|"HTTPS<br/>TLS 1.2+<br/>Guardrail checks"| NeMo
    ExtProc -.->|"HTTP<br/>Usage reporting"| Metering
    Envoy -->|"HTTPS/443<br/>TLS (SIMPLE)<br/>API key / SigV4 / OAuth2"| LLM

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Envoy ingress
    class ExtProc,Health,Metrics servicemesh
    class K8sAPI k8s
    class NeMo,Metering optional
    class LLM externalservice
