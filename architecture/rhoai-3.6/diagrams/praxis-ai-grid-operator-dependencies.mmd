graph LR
    AGN["Praxis AI Grid Operator<br/>(AGN)"]

    %% Internal Platform Dependencies
    AGN -->|"routing overlay<br/>(ConfigMap)"| PraxisGW["Praxis AI Gateway"]
    AGN -.->|"cert bootstrap<br/>reference"| CertManager["cert-manager"]

    %% Core Infrastructure
    AGN -->|"CRD watch/CRUD<br/>443/TCP"| K8sAPI["Kubernetes API<br/>Server"]
    AGN -->|"gossip protocol<br/>7946/UDP"| SWIMPeers["SWIM Peer Sites"]
    AGN -->|"state persistence<br/>5432/TCP"| Postgres["Postgres"]

    %% Key Rust Dependencies
    AGN -->|"controller runtime"| KubeRS["kube-rs 4.2"]
    AGN -->|"SWIM protocol"| Foca["foca 1.0"]
    AGN -->|"HTTP framework"| Axum["axum 0.8"]
    AGN -->|"async runtime"| Tokio["tokio 1.53"]
    AGN -->|"proxy framework"| Praxis["praxis-proxy 0.7.3"]
    AGN -->|"MCP client"| RMCP["rmcp 3.1.4"]

    %% TLS Dependencies
    AGN -->|"TLS (default)"| Rustls["rustls 0.23 + ring 0.17"]
    AGN -->|"TLS (FIPS)"| OpenSSL["openssl 0.10"]
    AGN -->|"cert generation"| Rcgen["rcgen 0.14.9"]
    AGN -->|"SWIM encryption"| AESGCM["aes-gcm 0.11.1"]

    %% External Services
    AGN -->|"health metrics<br/>mTLS scrape"| RemoteSignals["Remote Signal<br/>Endpoints"]
    AGN -->|"tool probing<br/>Streamable HTTP"| MCPServers["MCP Tool Servers"]
    AGN -->|"metrics scrape<br/>9090/TCP"| Prometheus["Prometheus"]

    %% Inference backends (via gateway)
    PraxisGW -->|"inference routing<br/>HTTPS"| Backends["Inference Backends<br/>vLLM, llm-d, Cloud APIs"]

    %% Styling
    style AGN fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PraxisGW fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style SWIMPeers fill:#f5a623,stroke:#333
    style Postgres fill:#f5a623,stroke:#333
    style RemoteSignals fill:#f5a623,stroke:#333
    style MCPServers fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style Backends fill:#f5a623,stroke:#333
    style KubeRS fill:#999,stroke:#333
    style Foca fill:#999,stroke:#333
    style Axum fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style Praxis fill:#999,stroke:#333
    style RMCP fill:#999,stroke:#333
    style Rustls fill:#999,stroke:#333
    style OpenSSL fill:#999,stroke:#333
    style Rcgen fill:#999,stroke:#333
    style AESGCM fill:#999,stroke:#333
