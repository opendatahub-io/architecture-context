graph TB
    subgraph PlatformOperator["Platform Operator Layer"]
        ODH["opendatahub-operator<br/>Module Handler Contract"]
    end

    subgraph AIGatewayOperator["ai-gateway-operator"]
        direction TB
        InitContainer["copy-manifests<br/>(init container)<br/>Copies vendored kustomize<br/>manifests to emptyDir"]
        Controller["ai-gateway-operator<br/>(controller-runtime)<br/>8081/TCP health<br/>8443/TCP metrics"]
        InitContainer -.->|"populates /opt/manifests"| Controller
    end

    AIGWCR["AIGateway CR<br/>(Cluster-scoped singleton)<br/>default-aigateway"]

    subgraph SubComponents["Vendored Sub-Components"]
        direction TB
        BatchGW["batch-gateway-operator<br/>LLM batch inference<br/>(llm-d)"]
        MaaS["maas-controller<br/>Models as a Service<br/>Multi-tenant model access"]
        AIGWC["ai-gateway-controller<br/>Gateway routing &amp; guardrails<br/>(Praxis extproc + Kuadrant)"]
    end

    subgraph ExternalDeps["External Dependencies"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        CertMgr["cert-manager"]
        GatewayAPI["Gateway API"]
        Istio["Istio"]
        Kuadrant["Kuadrant"]
    end

    ODH -->|"deploys &amp; configures<br/>RELATED_IMAGE env vars"| Controller
    ODH -->|"creates/updates"| AIGWCR
    AIGWCR -->|"watched by"| Controller

    Controller -->|"deploys when<br/>batchGateway=Managed"| BatchGW
    Controller -->|"deploys when<br/>modelsAsAService=Managed"| MaaS
    Controller -->|"co-deploys with MaaS"| AIGWC

    Controller -->|"reconciles via"| K8sAPI
    Controller -->|"RBAC escalation"| K8sAPI
    BatchGW -->|"TLS certs"| CertMgr
    BatchGW -->|"HTTPRoutes"| GatewayAPI
    MaaS -->|"auth policies"| Kuadrant
    AIGWC -->|"traffic routing"| Istio
    AIGWC -->|"rate limiting"| Kuadrant

    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px
    style InitContainer fill:#4a90e2,stroke:#333
    style AIGWCR fill:#f5a623,stroke:#333,stroke-width:2px
    style BatchGW fill:#7ed321,stroke:#333
    style MaaS fill:#7ed321,stroke:#333
    style AIGWC fill:#7ed321,stroke:#333
    style ODH fill:#9b59b6,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style CertMgr fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style Kuadrant fill:#e8e8e8,stroke:#333
