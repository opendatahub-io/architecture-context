graph TB
    subgraph External["External Clients"]
        Browser["Browser<br/>(SPA)"]
    end

    subgraph AuthLayer["Authentication Layer"]
        AuthProxy["Auth Proxy<br/>(oauth2-proxy)<br/>443/TCP HTTPS"]
    end

    subgraph Dashboard["OpenShell Dashboard"]
        subgraph BFF["Go BFF Server (8080/TCP)"]
            Router["chi Router<br/>(86 routes)"]
            AuthMiddleware["Auth Middleware<br/>(relay-only)"]
            StaticServer["Static Asset Server"]
            WSRelay["WebSocket Terminal Relay"]
            FileHandler["File Upload Handler<br/>(256 KiB chunks)"]
        end

        subgraph SDKClients["Gateway Clients"]
            SDKClient["OpenShell Go SDK Client"]
            RawExec["rawexec.go<br/>(binary file uploads)"]
            RawProvider["rawprovider.go<br/>(credential key names)"]
            RawProfile["rawprofile.go<br/>(provider profiles)"]
        end

        subgraph Frontend["React Frontend (npm package)"]
            SPA["PatternFly 6 SPA"]
            Pages["Exportable Pages"]
            Components["Exportable Components"]
            Slots["UI Injection Slots"]
            I18n["i18n Layer"]
            APIClient["API Client"]
        end
    end

    subgraph GatewayService["OpenShell Gateway"]
        Gateway["OpenShell Gateway<br/>50051/TCP gRPC<br/>TLS 1.2+"]
    end

    Browser -->|HTTPS/443| AuthProxy
    AuthProxy -->|"HTTP(S)/8080<br/>x-forwarded-access-token"| Router
    Router --> AuthMiddleware
    AuthMiddleware --> StaticServer
    AuthMiddleware --> WSRelay
    AuthMiddleware --> FileHandler
    StaticServer -->|serves| SPA

    Router --> SDKClient
    Router --> RawExec
    Router --> RawProvider
    Router --> RawProfile

    SDKClient -->|gRPC/50051| Gateway
    RawExec -->|"gRPC bidi-stream<br/>ExecSandboxInteractive"| Gateway
    RawProvider -->|gRPC/50051| Gateway
    RawProfile -->|gRPC/50051| Gateway

    SPA --> Pages
    SPA --> Components
    SPA --> Slots
    SPA --> I18n
    SPA --> APIClient
    APIClient -->|"REST /api/v1/*"| Router

    style Router fill:#4a90e2,color:#fff
    style AuthMiddleware fill:#4a90e2,color:#fff
    style StaticServer fill:#4a90e2,color:#fff
    style WSRelay fill:#4a90e2,color:#fff
    style FileHandler fill:#4a90e2,color:#fff
    style SDKClient fill:#50a0d2,color:#fff
    style RawExec fill:#50a0d2,color:#fff
    style RawProvider fill:#50a0d2,color:#fff
    style RawProfile fill:#50a0d2,color:#fff
    style SPA fill:#7ed321,color:#fff
    style Pages fill:#7ed321,color:#fff
    style Components fill:#7ed321,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style AuthProxy fill:#f5a623,color:#fff
    style Browser fill:#f9f9f9,stroke:#999
