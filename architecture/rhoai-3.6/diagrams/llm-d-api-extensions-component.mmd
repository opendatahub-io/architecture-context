graph TB
    subgraph vLLMServer["vLLM Inference Server (port 8000/TCP)"]
        direction TB

        subgraph PluginFramework["vllm.endpoint_plugins Entry Point"]
            ConfigPlugin["ServerConfigPlugin<br/>GET /plugins/llm-d-server-introspection/config<br/>required_tasks: None"]
            DevicesPlugin["ServerDevicesPlugin<br/>GET /plugins/llm-d-server-introspection/devices<br/>required_tasks: generate, pooling"]
            KVCachePlugin["ServerKVCachePlugin<br/>GET /plugins/llm-d-server-introspection/kv-cache<br/>required_tasks: generate, pooling"]
        end

        subgraph WorkerExtension["--worker-extension-cls"]
            DeviceWorkerExt["DeviceInfoWorkerExtension<br/>Mixin: get_device_properties<br/>via collective_rpc"]
        end

        subgraph InternalState["vLLM Internal State"]
            VllmConfig["VllmConfig<br/>Launch configuration"]
            EngineClient["EngineClient<br/>collective_rpc interface"]
            Platform["vllm.platforms<br/>current_platform"]
            CachedState["Cached Application State<br/>Pre-built Pydantic models"]
        end

        ConfigPlugin -->|"reads config at startup"| VllmConfig
        ConfigPlugin -->|"caches response"| CachedState
        DevicesPlugin -->|"calls collective_rpc"| EngineClient
        EngineClient -->|"dispatches to workers"| DeviceWorkerExt
        DeviceWorkerExt -->|"queries hardware"| Platform
        DevicesPlugin -->|"caches response"| CachedState
        KVCachePlugin -->|"get_kv_cache_group_metadata"| EngineClient
        KVCachePlugin -->|"caches response"| CachedState
    end

    Gateway["llm-d Gateway/Router"] -->|"GET /plugins/llm-d-server-introspection/*<br/>HTTP 8000/TCP"| PluginFramework

    subgraph Schemas["Response Schema"]
        direction LR
        ConfigSchema["ServerConfig<br/>model, scheduler, parallelism,<br/>KV transfer, feature flags"]
        DevicesSchema["ServerDevices<br/>per-rank: GPU name, memory,<br/>compute capability, units"]
        KVCacheSchema["ServerKVCache<br/>capacity + attention groups<br/>10 discriminated union types"]
    end

    CachedState -->|"serves"| Schemas

    style ConfigPlugin fill:#4a90e2,color:#fff
    style DevicesPlugin fill:#4a90e2,color:#fff
    style KVCachePlugin fill:#4a90e2,color:#fff
    style DeviceWorkerExt fill:#9b59b6,color:#fff
    style Gateway fill:#7ed321,color:#fff
    style VllmConfig fill:#f5a623
    style EngineClient fill:#f5a623
    style Platform fill:#f5a623
    style CachedState fill:#f5a623
    style ConfigSchema fill:#e8e8e8
    style DevicesSchema fill:#e8e8e8
    style KVCacheSchema fill:#e8e8e8
