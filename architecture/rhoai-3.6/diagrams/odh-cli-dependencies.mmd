graph LR
    ODHCLI["odh-cli<br/>(rhai-cli / kubectl-odh)"]

    %% Core Go Dependencies
    ODHCLI -->|"CLI framework"| Cobra["spf13/cobra v1.10.2"]
    ODHCLI -->|"K8s API client"| ClientGo["k8s.io/client-go v0.35.3"]
    ODHCLI -->|"kubectl flags"| CLIRuntime["k8s.io/cli-runtime v0.35.2"]
    ODHCLI -->|"CRD client"| CRClient["controller-runtime v0.23.3"]
    ODHCLI -->|"API extensions"| APIExt["apiextensions-apiserver v0.35.3"]
    ODHCLI -->|"MCP server"| MCPGo["mcp-go v0.55.1"]

    %% OLM Dependencies
    ODHCLI -->|"OLM types"| OLMAPI["operator-framework/api v0.39.0"]
    ODHCLI -->|"OLM client"| OLMSDK["operator-lifecycle-manager v0.40.0"]

    %% Utility Dependencies
    ODHCLI -->|"version parsing"| Semver["blang/semver v4.0.0"]
    ODHCLI -->|"JQ filtering"| GoJQ["itchyny/gojq v0.12.18"]
    ODHCLI -->|"JSON schemas"| JSONSchema["invopop/jsonschema v0.14.0"]
    ODHCLI -->|"table output"| TableWriter["tablewriter v1.1.3"]
    ODHCLI -->|"color output"| Color["fatih/color v1.18.0"]

    %% Internal Platform Dependencies
    ODHCLI -->|"health checks<br/>failure classification<br/>MCP diagnostic tools"| Operator["opendatahub-operator"]
    ODHCLI -->|"platform detection<br/>manifest rendering"| PlatformUtils["odh-platform-utilities"]

    %% Runtime Dependencies (API targets)
    ODHCLI -->|"all operations"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    ODHCLI -->|"OLM inspection"| OLM["OLM<br/>(via kube-apiserver)"]
    ODHCLI -->|"dep manifests"| GitOps["odh-gitops<br/>(GitHub)"]
    ODHCLI -.->|"migration only"| TrustyAI["TrustyAI Service"]

