graph TB
    subgraph External["EXTERNAL (Monitoring)"]
        Prometheus["Prometheus<br/>(openshift-monitoring /<br/>redhat-ods-monitoring)"]
        Kubelet["Kubelet<br/>(health probes)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["Operator Pod"]
            MetricsEP["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>Bearer + SAR"]
            HealthEP["Health Probes<br/>8081/TCP HTTP<br/>No auth"]
            Controller["LLMBatchGatewayReconciler<br/>+ MetricsController"]
        end

        MetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP"]
        MetricsTLS["TLS Secret<br/>llm-d-batch-gateway-operator-metrics-tls<br/>Provisioned by service-ca"]
        NetPol["NetworkPolicy<br/>Ingress 8443: monitoring NS only<br/>Ingress 8081: all sources"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACE (per-CR)"]
        direction TB
        APIServer["API Server<br/>Batch job submission"]
        Processor["Request Processor"]
        GCPod["Garbage Collector"]
        AsyncProc["Async Processor<br/>(optional)"]
        CRSecret["Copied Secret<br/>(credentials)"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        ServiceCA["OpenShift service-ca<br/>TLS cert provisioning"]
        OSConfig["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile source"]
    end

    subgraph GatewayAPI["GATEWAY API RESOURCES"]
        RefGrant["ReferenceGrant<br/>(source namespace)"]
        HTTPRoute["HTTPRoute<br/>(workload namespace)"]
    end

    %% Monitoring flows
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca cert)<br/>Bearer token + SAR"| MetricsSvc
    MetricsSvc --> MetricsEP
    Kubelet -->|"HTTP/8081<br/>No encryption<br/>No auth"| HealthEP

    %% Operator to K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CR watches, SSA, status"| K8sAPI

    %% Operator to workloads
    Controller -->|"SSA creates/updates"| APIServer
    Controller -->|"SSA creates/updates"| Processor
    Controller -->|"SSA creates/updates"| GCPod
    Controller -->|"SSA creates/updates"| AsyncProc

    %% Secret resolution
    Controller -->|"reads"| RefGrant
    Controller -->|"copies secrets"| CRSecret

    %% TLS and monitoring
    ServiceCA -->|"provisions cert"| MetricsTLS
    Controller -->|"reads TLS profile"| OSConfig
    Controller -->|"creates"| HTTPRoute

    %% NetworkPolicy
    NetPol -.->|"enforces"| MetricsEP
    NetPol -.->|"enforces"| HealthEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gateway fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Prometheus,Kubelet external
    class MetricsEP,HealthEP,Controller,MetricsSvc,MetricsTLS operator
    class APIServer,Processor,GCPod,AsyncProc,CRSecret workload
    class K8sAPI,ServiceCA,OSConfig cluster
    class RefGrant,HTTPRoute gateway
    class NetPol security
