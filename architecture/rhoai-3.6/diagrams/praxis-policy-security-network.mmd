graph TB
    subgraph HostProcess["HOST PROCESS (Trusted Boundary)"]
        direction TB

        subgraph HostApp["Host Application (e.g., Praxis Proxy)"]
            HostLayer["HTTP Serving Layer<br/>Receives agent/client requests"]
        end

        subgraph PPEEngine["PPE PolicyEngine (In-Process)"]
            direction TB

            subgraph InternalComponents["Internal Components (No Network I/O)"]
                direction LR
                IdentityResolver["Identity Resolver<br/>(JWT / API-Key)"]
                PDPEval["PDP Evaluator<br/>(Cedar v4 / CEL / OPA)"]
                CapFilter["Capability Filter<br/>Declared caps only"]
                SecretMgr["Secret Manager<br/>zeroize on drop"]
            end

            subgraph Pipeline["Five-Phase Pipeline"]
                direction LR
                Seq["Sequential"]
                Xform["Transform"]
                Audit["Audit"]
                Conc["Concurrent"]
                FnF["Fire-and-Forget"]
            end
        end

        subgraph EgressControl["Egress Deny Table"]
            DenyList["BLOCKED: RFC 1918, Link-Local,<br/>CGNAT, Cloud Metadata<br/>Enforced at DNS + Pre-Connect<br/>Error class: Rejected (non-retryable)"]
        end

        subgraph Transport["HyperTransport"]
            TLS["rustls 0.23 + ring 0.17<br/>Explicit crypto provider<br/>webpki-roots, HTTP/2 ALPN"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB

        IdPJWKS["IdP — JWKS Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+ (rustls)<br/>Auth: None"]
        IdPToken["IdP — Token Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+ (rustls)<br/>Auth: Client Credentials"]
        CIBAProvider["CIBA Provider<br/>443/TCP HTTPS<br/>TLS 1.2+ (rustls)<br/>Auth: Client Credentials"]
        ValkeyRedis["Valkey / Redis<br/>6379/TCP Redis Protocol<br/>Optional TLS (rustls)<br/>Auth: Password / ACL"]
        Vault["HashiCorp Vault<br/>8200/TCP HTTPS<br/>TLS 1.2+ (rustls)<br/>Auth: K8s / AppRole Token"]
    end

    %% Flows
    HostLayer -->|"Rust API (in-process)"| PPEEngine
    PPEEngine --> EgressControl
    EgressControl --> Transport

    Transport -->|"HTTPS/443<br/>TLS 1.2+<br/>JWKS fetch"| IdPJWKS
    Transport -->|"HTTPS/443<br/>TLS 1.2+<br/>RFC 8693 token exchange"| IdPToken
    Transport -->|"HTTPS/443<br/>TLS 1.2+<br/>Backchannel auth"| CIBAProvider
    Transport -->|"Redis/6379<br/>Optional TLS<br/>Session Taint"| ValkeyRedis
    Transport -->|"HTTPS/8200<br/>TLS 1.2+<br/>Secret retrieval"| Vault

    %% Styling
    classDef hostprocess fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef engine fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef egress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef transport fill:#2c3e50,stroke:#333,stroke-width:2px,color:#fff
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef deny fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class HostLayer hostprocess
    class PPEEngine,IdentityResolver,PDPEval,CapFilter,SecretMgr engine
    class Seq,Xform,Audit,Conc,FnF internal
    class DenyList deny
    class TLS transport
    class IdPJWKS,IdPToken,CIBAProvider,ValkeyRedis,Vault external
