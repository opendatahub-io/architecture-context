graph LR
    AGC["ai-gateway-controller"]

    %% Internal Platform Dependencies
    AGC -->|"deploys controller"| AGOperator["ai-gateway-operator"]
    AGC -->|"shared MaasTenantConfig<br/>CAS handshake"| MaasCtrl["maas-controller"]
    AGC -->|"vendors and installs<br/>per-tenant"| Praxis["praxis-extproc"]
    AGC -->|"HTTPRoute CRUD"| GatewayAPI["Gateway API"]
    AGC -->|"EnvoyFilter, DestinationRule,<br/>ServiceEntry CRUD"| Istio["Istio"]
    AGC -->|"EnvoyFilter priority<br/>ordering"| Kuadrant["Kuadrant (RHCL)"]
    AGC -->|"AIGuardrail CRD<br/>reference"| TrustyAI["TrustyAI NemoGuardrails"]

    %% Reverse dependencies (components that depend on AGC)
    AGOperator -->|"lifecycle mgmt"| AGC

    %% External Dependencies
    AGC -->|"operator framework"| CtrlRuntime["controller-runtime v0.23.3"]
    AGC -->|"manifest rendering"| Kustomize["kustomize/api v0.21.1"]
    AGC -->|"content-addressed<br/>digests"| JCS["gowebpki/jcs v1.0.1"]
    AGC -->|"API types"| K8sAPI2["k8s.io/api v0.35.3"]

    %% External Services
    AGC -->|"CRD watches,<br/>resource CRUD"| K8sAPIServer["Kubernetes API Server"]
    Praxis -->|"inference traffic<br/>(via Envoy)"| LLMProviders["External LLM Providers"]

    %% Styling
    style AGC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style AGOperator fill:#7ed321,stroke:#333,color:#fff
    style MaasCtrl fill:#7ed321,stroke:#333,color:#fff
    style Praxis fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style TrustyAI fill:#7ed321,stroke:#333,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style Kustomize fill:#999,stroke:#333,color:#fff
    style JCS fill:#999,stroke:#333,color:#fff
    style K8sAPI2 fill:#999,stroke:#333,color:#fff
    style K8sAPIServer fill:#f5a623,stroke:#333,color:#fff
    style LLMProviders fill:#f5a623,stroke:#333,color:#fff
