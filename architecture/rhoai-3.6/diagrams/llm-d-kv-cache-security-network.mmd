graph TB
    subgraph External["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>API Token (optional)"]
    end

    subgraph Internal["INTERNAL (No built-in encryption)"]
        direction TB

        subgraph RouterProcess["llm-d-router Process"]
            direction TB
            Indexer["kvcache.Indexer<br/>Scoring engine"]
            Pool["kvevents.Pool<br/>ZMQ subscriber"]
            BlockIndex["kvblock.Index<br/>Block index"]
        end

        subgraph Sidecars["Sidecar Services"]
            UDSTok["UDS Tokenizer<br/>gRPC over UDS<br/>Health: 8082/TCP<br/>No encryption"]
            PVCEvictor["PVC Evictor<br/>No network listeners<br/>Filesystem access only"]
        end

        subgraph DataStores["Data Stores"]
            Redis["Redis/Valkey<br/>6379/TCP<br/>Plaintext TCP<br/>rediss:// supported<br/>No auth"]
        end

        subgraph EventSources["Event Sources"]
            vLLM["vLLM Pods<br/>ZMQ PUB 5557/TCP<br/>No encryption<br/>No auth"]
        end

        subgraph Observability["Observability"]
            OTEL["OpenTelemetry Collector<br/>gRPC 4317/TCP<br/>No encryption<br/>WithInsecure()"]
        end
    end

    subgraph RefExamples["REFERENCE EXAMPLES (not primary deployment)"]
        OnlineHTTP["online HTTP Service<br/>8080/TCP HTTP<br/>No encryption, No auth<br/>/score_completions<br/>/score_chat_completions<br/>/metrics"]
        IndexerGRPC["IndexerService<br/>gRPC 50051/TCP<br/>No encryption, No auth"]
        PodRecon["pod_reconciler<br/>→ K8s API 6443/TCP<br/>HTTPS TLS 1.2+<br/>ServiceAccount"]
    end

    %% Flows
    UDSTok -->|"HTTPS/443<br/>TLS<br/>API Token"| HFHub
    Indexer -->|"gRPC over UDS<br/>No encryption<br/>Socket permissions"| UDSTok
    Pool -->|"ZMQ SUB<br/>5557/TCP<br/>No encryption"| vLLM
    BlockIndex -->|"TCP/6379<br/>No encryption<br/>No auth"| Redis
    Indexer -->|"in-process"| BlockIndex
    Pool -->|"in-process"| BlockIndex
    OnlineHTTP -->|"gRPC/4317<br/>WithInsecure()"| OTEL

    %% Styling
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef sidecar fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef example fill:#f5f5f5,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class HFHub external
    class Indexer,Pool,BlockIndex internal
    class Redis datastore
    class UDSTok,PVCEvictor sidecar
    class vLLM,OTEL risk
    class OnlineHTTP,IndexerGRPC,PodRecon example
