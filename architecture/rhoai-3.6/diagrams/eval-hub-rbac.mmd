graph TD
    subgraph "Authentication Flow"
        Client["REST / MCP Client"]
        BearerToken["Bearer Token<br/>OpenShift OAuth"]
    end

    subgraph "Authorization Layer"
        KubeRBAC["kube-rbac-proxy<br/>Ingress Sidecar"]
        TokenReview["TokenReview<br/>Validates Bearer Token"]
        SAR["SubjectAccessReview<br/>Checks RBAC permissions"]
    end

    subgraph "Identity Headers"
        XUser["X-User Header<br/>Authenticated user identity"]
        XTenant["X-Tenant Header<br/>Namespace-scoped tenant"]
    end

    subgraph "eval-hub API Server"
        IdentityCheck["canContinueRequest<br/>RequiresIdentityHeaders"]
        TenantScope["Tenant-Scoped Storage<br/>Row-level filtering"]
    end

    subgraph "Kubernetes API Access"
        SA["ServiceAccount<br/>eval-hub controller"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP"]
    end

    subgraph "Kubernetes Resources Managed"
        Jobs["Jobs<br/>create, get, list,<br/>watch, delete"]
        ConfigMaps["ConfigMaps<br/>create, get, delete"]
        Secrets["Secrets<br/>create, get, delete"]
        NetworkPolicies["NetworkPolicies<br/>create, delete"]
        HWProfiles["HardwareProfiles<br/>get, delete"]
        LocalQueues["LocalQueues<br/>list"]
    end

    subgraph "Evaluation Job Pod Auth"
        JobSA["Job Pod ServiceAccount"]
        SAToken["SA Token<br/>Auto-rotated"]
        SidecarAuth["eval-runtime-sidecar<br/>SA token injection +<br/>credential caching"]
    end

    subgraph "Protected Endpoints"
        EvalAPI["/api/v1/evaluations/*<br/>Requires X-User, X-Tenant"]
        InfoAPI["/api/v1/info<br/>Requires X-User, X-Tenant"]
    end

    subgraph "Unprotected Endpoints"
        HealthAPI["/api/v1/health<br/>No auth required"]
        DocsAPI["/docs, /openapi.yaml<br/>No auth required"]
        MetricsAPI["/metrics (port 8081)<br/>No auth, separate port"]
    end

    %% Auth flow
    Client -->|"presents"| BearerToken
    BearerToken -->|"sent to"| KubeRBAC
    KubeRBAC -->|"validates"| TokenReview
    KubeRBAC -->|"authorizes"| SAR
    KubeRBAC -->|"injects"| XUser
    KubeRBAC -->|"injects"| XTenant
    XUser -->|"forwarded to"| IdentityCheck
    XTenant -->|"forwarded to"| IdentityCheck
    IdentityCheck -->|"enforces tenant scope"| TenantScope
    TenantScope -->|"protects"| EvalAPI
    TenantScope -->|"protects"| InfoAPI

    %% K8s API access
    SA -->|"authenticates to"| K8sAPI
    K8sAPI -->|"CRUD"| Jobs
    K8sAPI -->|"CRUD"| ConfigMaps
    K8sAPI -->|"CRUD"| Secrets
    K8sAPI -->|"CRUD"| NetworkPolicies
    K8sAPI -->|"read"| HWProfiles
    K8sAPI -->|"list"| LocalQueues

    %% Job pod auth
    JobSA -->|"mounts"| SAToken
    SAToken -->|"used by"| SidecarAuth

    %% Styling
    style Client fill:#f9f9f9,stroke:#999
    style KubeRBAC fill:#ffe6cc,stroke:#d79b00
    style IdentityCheck fill:#4a90e2,stroke:#333,color:#fff
    style TenantScope fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#dae8fc,stroke:#6c8ebf
    style SidecarAuth fill:#d5e8d4,stroke:#82b366
    style EvalAPI fill:#7ed321,stroke:#333
    style InfoAPI fill:#7ed321,stroke:#333
    style HealthAPI fill:#e8e8e8,stroke:#333
    style DocsAPI fill:#e8e8e8,stroke:#333
    style MetricsAPI fill:#e8e8e8,stroke:#333
