graph LR
    LLMD["llm-d<br/>Meta-Repository"]

    %% Core Internal Dependencies (llm-d org)
    LLMD -->|"Helm chart<br/>Proxy + EPP"| Router["llm-d-router"]
    LLMD -->|"container image<br/>KV indexing"| KVCache["llm-d-kv-cache"]
    LLMD -->|"container image<br/>P/D sidecar"| RoutingSidecar["llm-d-routing-sidecar"]
    LLMD -->|"container image<br/>batch API"| BatchGW["llm-d-batch-gateway"]
    LLMD -->|"container image<br/>async queue"| AsyncProc["llm-d-async"]
    LLMD -->|"container image<br/>latency SLO"| LatencyPred["llm-d-latency-predictor"]
    LLMD -.->|"container image<br/>deprecated"| WVA["llm-d-workload-<br/>variant-autoscaler"]

    %% External Runtime Dependencies
    LLMD -->|"builds from source<br/>v0.30.0"| vLLM["vLLM"]
    LLMD -->|"CRD: InferencePool<br/>ext-proc"| GatewayInf["Gateway API<br/>Inference Extension"]
    LLMD -->|"CRD: Gateway<br/>HTTPRoute"| GatewayAPI["Kubernetes<br/>Gateway API"]
    LLMD -->|"1.29+"| K8s["Kubernetes"]
    LLMD -->|"RDMA transport"| NIXL["NIXL"]
    LLMD -->|"UCX comms"| UCX["UCX"]

    %% Optional Dependencies
    LLMD -.->|"alt engine<br/>v0.5.20"| SGLang["SGLang"]
    LLMD -.->|"ROCm collective"| UCCL["UCCL v0.0.1.post6"]
    LLMD -.->|"AMD memory opt"| Mori["Mori v1.2.2"]
    LLMD -.->|"XPU KV cache"| LMCache["LMCache v0.5.0"]
    LLMD -.->|"autoscaling"| KEDA["KEDA"]
    LLMD -.->|"tracing"| OTEL["OpenTelemetry"]

    %% Deployment Tools
    LLMD -->|"chart install"| Helm["Helm 3.x"]
    LLMD -->|"manifest compose"| Kustomize["Kustomize"]

    %% Styling
    style LLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal llm-d components
    style Router fill:#ab47bc,stroke:#333,color:#fff
    style KVCache fill:#ab47bc,stroke:#333,color:#fff
    style RoutingSidecar fill:#ab47bc,stroke:#333,color:#fff
    style BatchGW fill:#ab47bc,stroke:#333,color:#fff
    style AsyncProc fill:#ab47bc,stroke:#333,color:#fff
    style LatencyPred fill:#ab47bc,stroke:#333,color:#fff
    style WVA fill:#ce93d8,stroke:#333,color:#333

    %% External required
    style vLLM fill:#999,stroke:#333,color:#fff
    style GatewayInf fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style NIXL fill:#999,stroke:#333,color:#fff
    style UCX fill:#999,stroke:#333,color:#fff
    style Helm fill:#999,stroke:#333,color:#fff
    style Kustomize fill:#999,stroke:#333,color:#fff

    %% External optional
    style SGLang fill:#ccc,stroke:#333,color:#333
    style UCCL fill:#ccc,stroke:#333,color:#333
    style Mori fill:#ccc,stroke:#333,color:#333
    style LMCache fill:#ccc,stroke:#333,color:#333
    style KEDA fill:#ccc,stroke:#333,color:#333
    style OTEL fill:#ccc,stroke:#333,color:#333
