graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client"]
    end

    subgraph Application["APPLICATION (OpenShell Sandbox)"]
        direction TB
        subgraph StarterKit["Agentic RAG Starter Kit"]
            AuthWrapper["Auth Wrapper<br/>(ASGI Middleware)<br/>K8s TokenReview"]
            FastAPI["FastAPI App<br/>8080/TCP HTTP"]
            ResponsesAPI["POST /v1/responses<br/>(Protected)"]
            HealthAPI["GET /health<br/>(Unprotected)"]

            FastAPI --> AuthWrapper
            AuthWrapper --> ResponsesAPI
            FastAPI --> HealthAPI
        end

        subgraph URLTrust["URL Trust Policy"]
            SafeURL["ensure_safe_url()<br/>HTTP only for localhost/*.cluster.local<br/>HTTPS required for all others<br/>No unverified-TLS fallback"]
        end
    end

    subgraph EgressServices["EGRESS DESTINATIONS"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS (CA verified)<br/>Bearer token"]
        MaaS["MaaS Endpoint<br/>443/TCP HTTPS<br/>TLS (verified + custom CA)<br/>API key"]
        MilvusDB["Milvus<br/>19530/TCP gRPC<br/>TLS (verified + custom CA)<br/>Token"]
        PgVectorDB["PostgreSQL + pgvector<br/>5432/TCP<br/>TLS (verified for non-local)<br/>Password"]
        Neo4jDB["Neo4j<br/>7687/TCP Bolt<br/>TLS (neo4j+s/bolt+s)<br/>Password"]
        S3Store["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS (verified + custom CA)<br/>AWS credentials"]
    end

    %% Flows
    Client -->|"HTTP/8080<br/>Bearer token<br/>(via ingress/proxy)"| FastAPI
    AuthWrapper -->|"HTTPS/443<br/>TLS (CA verified)<br/>K8S_REVIEWER_TOKEN"| K8sAPI
    ResponsesAPI -->|"HTTPS/443<br/>TLS (verified)<br/>MAAS_API_KEY"| MaaS
    ResponsesAPI -->|"gRPC/19530<br/>TLS (verified)<br/>MILVUS_TOKEN"| MilvusDB
    ResponsesAPI -->|"PostgreSQL/5432<br/>TLS (verified)<br/>PGVECTOR_PASSWORD"| PgVectorDB
    ResponsesAPI -->|"Bolt/7687<br/>TLS (neo4j+s)<br/>NEO4J_PASSWORD"| Neo4jDB
    ResponsesAPI -->|"HTTPS/443<br/>TLS (verified)<br/>AWS creds"| S3Store

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef trust fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class FastAPI,ResponsesAPI,HealthAPI application
    class AuthWrapper auth
    class K8sAPI,MaaS,MilvusDB,PgVectorDB,Neo4jDB,S3Store egress
    class SafeURL trust
