graph TD
    subgraph "ML Metadata RBAC Model"
        direction TB

        Note["NOTE: No RBAC resources defined<br/>in the ml-metadata repository.<br/>RBAC is managed by the<br/>deploying operator."]

        subgraph "Infrastructure-Delegated Security"
            NP["Kubernetes NetworkPolicy<br/>(Restricts pod-to-pod access)"]
            IAP["Istio AuthorizationPolicy<br/>(Service-level access control)"]
            Sidecar["Sidecar Proxies<br/>(mTLS enforcement)"]
        end

        subgraph "ML Metadata Server"
            Server["metadata_store_server<br/>UID: 65534 (non-root)<br/>No app-level auth"]
        end

        subgraph "Access Pattern"
            DSP["Data Science Pipelines<br/>(gRPC Client)"]
            UI["Pipeline UI<br/>(gRPC Client)"]
        end
    end

    DSP -->|"gRPC/8080<br/>No auth required"| Server
    UI -->|"gRPC/8080<br/>No auth required"| Server
    NP -.->|"controls access to"| Server
    IAP -.->|"authorizes calls to"| Server
    Sidecar -.->|"encrypts traffic to"| Server

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style NP fill:#d5e8d4,stroke:#82b366
    style IAP fill:#d5e8d4,stroke:#82b366
    style Sidecar fill:#d5e8d4,stroke:#82b366
    style DSP fill:#7ed321,stroke:#333
    style UI fill:#7ed321,stroke:#333
