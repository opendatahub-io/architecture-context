graph TB
    subgraph External["External Clients"]
        ProducerApp["Producer Application<br/>(Client SDK)"]
    end

    subgraph MessageBroker["Message Broker"]
        Redis["Redis / Valkey<br/>6379/TCP"]
        GCPPubSub["GCP Pub/Sub<br/>443/TCP gRPC"]
    end

    subgraph AsyncProcessor["Async Processor (llm-d-async)"]
        direction TB

        subgraph Modules["Go Modules"]
            API["api module<br/>Request/Result wire format"]
            Pipeline["pipeline module<br/>Flow, Gate, MergePolicy"]
            Producer["producer module<br/>Client SDK for enqueue/dequeue"]
        end

        subgraph Core["Processor Core"]
            Flow["Flow<br/>(Redis SortedSet / Redis PubSub / GCP PubSub)"]
            MergePolicy["RequestMergePolicy<br/>(random-robin / tier-priority)"]
            WorkerPool["Worker Pool<br/>(configurable concurrency)"]
        end

        subgraph Gates["Dispatch Gates"]
            BudgetGate["Budget Gate<br/>(Prometheus saturation/budget)"]
            AdmissionGate["Admission Gate<br/>(concurrency, quota, tier)"]
            ComboGate["Combinator Gates<br/>(wait-on-refuse, all, any)"]
        end

        subgraph Observability["Observability"]
            Metrics["Metrics Server<br/>9090/TCP Prometheus"]
            Health["Health Server<br/>8081/TCP /healthz /readyz"]
            Tracing["OTel Tracing<br/>W3C TraceContext"]
        end
    end

    subgraph InferenceLayer["Inference Layer"]
        Router["llm-d-router<br/>Inference Gateway"]
    end

    subgraph ExternalSvc["External Services"]
        Prometheus["Prometheus<br/>9090/TCP"]
        OTLPCollector["OTLP Collector<br/>gRPC"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
    end

    %% Producer flow
    ProducerApp -->|"submit requests"| Redis
    ProducerApp -->|"submit requests"| GCPPubSub

    %% Message consumption
    Redis -->|"pull messages"| Flow
    GCPPubSub -->|"pull messages"| Flow

    %% Internal processing
    Flow -->|"per-queue channels"| MergePolicy
    MergePolicy -->|"merged channel"| WorkerPool
    WorkerPool -->|"evaluate"| BudgetGate
    WorkerPool -->|"evaluate"| AdmissionGate
    BudgetGate -->|"compose"| ComboGate
    AdmissionGate -->|"compose"| ComboGate

    %% Dispatch
    WorkerPool -->|"HTTP/HTTPS dispatch"| Router

    %% Results back to broker
    WorkerPool -->|"publish results"| Redis

    %% Gate dependencies
    BudgetGate -->|"query metrics"| Prometheus
    AdmissionGate -->|"query quotas"| Redis

    %% Observability
    Tracing -->|"export traces"| OTLPCollector
    Health -->|"RBAC auth"| K8sAPI

    %% Styling
    style AsyncProcessor fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Flow fill:#4a90e2,color:#fff
    style MergePolicy fill:#4a90e2,color:#fff
    style WorkerPool fill:#4a90e2,color:#fff
    style BudgetGate fill:#f5a623
    style AdmissionGate fill:#f5a623
    style ComboGate fill:#f5a623
    style Router fill:#7ed321
    style Redis fill:#d32f2f,color:#fff
    style GCPPubSub fill:#4285f4,color:#fff
    style Prometheus fill:#e8e8e8
    style OTLPCollector fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style API fill:#90caf9
    style Pipeline fill:#90caf9
    style Producer fill:#90caf9
