graph TB
    subgraph NemoGuardrails["NeMo Guardrails"]
        direction TB
        Server["FastAPI Server<br/>uvicorn :8000/TCP"]
        IORails["IORails Dispatcher"]
        LLMRails["LLMRails<br/>(Colang v1.0 pipeline)"]
        ColangV2["Colang v2.x Runtime"]
        ColangV1["Colang v1.0 Runtime"]
        GuardrailsLib["Guardrails Library<br/>(30+ built-in rails)"]
        ActionsServer["Actions Server"]
        CLI["CLI (Typer)"]

        Server -->|dispatches| IORails
        Server -->|legacy path| LLMRails
        IORails -->|input/output rails| GuardrailsLib
        LLMRails -->|event-driven| ColangV1
        IORails -->|declarative| ColangV2
        LLMRails -->|uses| GuardrailsLib
        CLI -->|manages| Server
        ActionsServer -->|executes| GuardrailsLib
    end

    Client[Client] -->|POST /v1/chat/completions<br/>POST /v1/checks| Server
    Server -->|HTTPS :443| LLMProvider["OpenAI-compatible LLM"]
    Server -->|HTTPS :443| AzureOpenAI["Azure OpenAI"]

    subgraph BuiltInRails["Built-in Rail Types"]
        Jailbreak["Jailbreak Detection"]
        ContentSafety["Content Safety"]
        PII["PII Detection<br/>(Presidio)"]
        FactCheck["Fact-Checking<br/>(AlignScore)"]
        Hallucination["Hallucination Detection"]
        PromptInjection["Prompt Injection<br/>(DeBERTa)"]
    end

    GuardrailsLib -->|delegates to| BuiltInRails

    subgraph ThirdParty["Third-Party Integrations (Optional)"]
        ActiveFence["ActiveFence"]
        AIDefense["NVIDIA AI Defense"]
        Pangea["Pangea"]
        Patronus["Patronus AI"]
        CrowdStrike["CrowdStrike"]
        F5["F5"]
    end

    GuardrailsLib -.->|optional HTTPS| ThirdParty

    subgraph BakedModels["Baked-in ML Models"]
        MiniLM["MiniLM"]
        Arctic["Snowflake Arctic"]
        SpaCy["spaCy"]
        NLTK["NLTK punkt"]
        DeBERTa["DeBERTa"]
        GraniteHAP["Granite Guardian HAP"]
    end

    GuardrailsLib -->|inference| BakedModels

