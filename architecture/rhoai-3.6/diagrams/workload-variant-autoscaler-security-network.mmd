graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph ControlPlane["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph ControllerNS["CONTROLLER NAMESPACE<br/>(workload-variant-autoscaler-system)"]
            direction TB
            Controller["WVA Controller Manager<br/>SA: controller-manager<br/>runAsNonRoot, seccompProfile: RuntimeDefault<br/>500m CPU / 512Mi memory"]
            HealthEndpoint[":8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth, No TLS"]
            MetricsEndpoint[":8443/TCP HTTPS<br/>/metrics<br/>TLS (service-ca on OCP)<br/>TokenReview + SAR"]
            MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8443/TCP"]

            Controller --- HealthEndpoint
            Controller --- MetricsEndpoint
            MetricsSvc -->|8443/TCP| MetricsEndpoint
        end

        subgraph MonitoringNS["MONITORING NAMESPACE"]
            Prometheus["Prometheus / Thanos Querier<br/>9090 or 9091/TCP<br/>HTTPS TLS 1.2+<br/>Bearer Token Auth"]
            ServiceMonitor["ServiceMonitor"]
        end

        subgraph UserNS["USER NAMESPACES"]
            HPAs["HorizontalPodAutoscalers"]
            InferencePools["InferencePool CRs"]
            ScaledObjects["ScaledObject CRs<br/>(KEDA - conditional)"]
            Workloads["Deployments /<br/>LeaderWorkerSets"]
        end
    end

    %% Controller to API Server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>watch/list/patch"| K8sAPI

    %% Controller to Prometheus
    Controller -->|"HTTPS/9090-9091<br/>TLS 1.2+ (CA configurable)<br/>Bearer Token"| Prometheus

    %% ServiceMonitor scrapes controller
    ServiceMonitor -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer Token + TokenReview/SAR"| MetricsSvc

    %% Watches from user namespaces (via API server)
    K8sAPI -.->|watch events| HPAs
    K8sAPI -.->|watch events| InferencePools
    K8sAPI -.->|watch events| ScaledObjects

    %% Scaling actions
    Controller -->|"patch scale<br/>HTTPS/6443"| Workloads

    %% Styling
    classDef controlplane fill:#dbeafe,stroke:#2563eb,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef userns fill:#f9f9f9,stroke:#999,stroke-width:1px
    classDef endpoint fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef conditional fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray:5 5

    class K8sAPI controlplane
    class Controller controller
    class HealthEndpoint,MetricsEndpoint,MetricsSvc endpoint
    class Prometheus,ServiceMonitor monitoring
    class HPAs,InferencePools,Workloads userns
    class ScaledObjects conditional
