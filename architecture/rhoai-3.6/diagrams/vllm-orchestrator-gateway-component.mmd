graph TB
    subgraph Gateway["vllm-orchestrator-gateway (Rust Service)"]
        direction TB
        Main["Main Entry Point<br/>HTTP Listener 8090/TCP"]
        ConfigLoader["Config Loader<br/>YAML Parser (serde_yml)"]
        Validator["Startup Validator<br/>Detector/Route Validation"]
        Router["Axum Router<br/>Dynamic Route Registration"]
        Handler["Chat Completions Handler<br/>Stream/Non-Stream Dispatch"]
        NonStream["Non-Streaming Handler<br/>POST + Detection Check"]
        Stream["Streaming Handler<br/>SSE Chunk Processing"]
        TLSBuilder["TLS Client Builder<br/>mTLS Identity + Custom CA"]
        Forwarder["Orchestrator Forwarder<br/>Header Forwarding + Payload Enrichment"]

        ConfigLoader -->|"reads config.yaml"| Main
        Main -->|"validates"| Validator
        Validator -->|"registers routes"| Router
        Main -->|"probes /etc/tls/private/"| TLSBuilder
        Router -->|"/{route}/v1/chat/completions"| Handler
        Handler -->|"stream: false"| NonStream
        Handler -->|"stream: true"| Stream
        NonStream -->|"injects detectors"| Forwarder
        Stream -->|"injects detectors"| Forwarder
    end

    Client["Client<br/>(OpenAI-compatible)"] -->|"POST /{route}/v1/chat/completions<br/>8090/TCP HTTP"| Main

    subgraph Config["Configuration (YAML)"]
        DetectorDefs["Detector Definitions<br/>name, server, input/output, params"]
        RouteDefs["Route Definitions<br/>name, detectors[], fallback_message"]
        OrchestratorCfg["Orchestrator Config<br/>host, port"]
    end

    ConfigLoader -->|"parses"| Config

    Forwarder -->|"POST /api/v2/chat/completions-detection<br/>HTTP/HTTPS, Optional mTLS<br/>Forwarded Auth + X-Forwarded-*"| Orchestrator

    subgraph Backend["Backend Services (Indirect)"]
        Orchestrator["FMS Guardrails Orchestrator<br/>8085/TCP"]
        Detectors["Content Detectors<br/>(e.g., regex, PII)"]
        LLM["vLLM / LLM Runtime"]
        Orchestrator -->|"invokes"| Detectors
        Orchestrator -->|"delegates inference"| LLM
    end

    subgraph TLS["TLS Infrastructure"]
        ServiceCert["Service Cert<br/>/etc/tls/private/tls.crt"]
        ServiceKey["Service Key<br/>/etc/tls/private/tls.key"]
        CACert["CA Cert<br/>/etc/tls/ca/service-ca.crt"]
    end

    TLSBuilder -->|"loads if present"| TLS

    style Gateway fill:#4a90e2,stroke:#333,color:#fff
    style Main fill:#5ba3f5,stroke:#333,color:#fff
    style Handler fill:#5ba3f5,stroke:#333,color:#fff
    style NonStream fill:#5ba3f5,stroke:#333,color:#fff
    style Stream fill:#5ba3f5,stroke:#333,color:#fff
    style Forwarder fill:#5ba3f5,stroke:#333,color:#fff
    style TLSBuilder fill:#5ba3f5,stroke:#333,color:#fff
    style ConfigLoader fill:#5ba3f5,stroke:#333,color:#fff
    style Validator fill:#5ba3f5,stroke:#333,color:#fff
    style Router fill:#5ba3f5,stroke:#333,color:#fff
    style Client fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style Detectors fill:#e8e8e8,stroke:#333
    style LLM fill:#e8e8e8,stroke:#333
    style Config fill:#fff2cc,stroke:#d6b656
    style TLS fill:#ffe6cc,stroke:#d79b00
