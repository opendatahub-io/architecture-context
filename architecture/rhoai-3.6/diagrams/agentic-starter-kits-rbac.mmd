graph TD
    subgraph ServiceAccounts["Service Accounts"]
        AgentSA["{agent} ServiceAccount<br/>(per-deployment)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["{agent}-{ns-hash}-auth-delegator<br/>(conditional: auth.createAuthDelegatorBinding=true)"]
    end

    subgraph ClusterRoles["ClusterRole"]
        CR["system:auth-delegator"]
    end

    subgraph APIResources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
    end

    subgraph AuthMiddleware["Authentication Flow"]
        direction LR
        IncomingReq["Incoming Request<br/>Bearer Token"] --> SATokenMiddleware["SATokenAuthMiddleware"]
        SATokenMiddleware -->|"POST TokenReview"| K8sAPI["Kubernetes API Server"]
        K8sAPI -->|"Authenticated identity"| SATokenMiddleware
        SATokenMiddleware -->|"Check allowlist"| AllowList["AUTH_ALLOWED_SERVICEACCOUNTS<br/>namespace:serviceaccount pairs"]
        AllowList -->|"Authorized"| AgentApp["Agent Application"]
    end

    subgraph ExcludedPaths["Excluded from Auth"]
        HealthCheck["/health"]
        APIHealth["/api/health"]
    end

    AgentSA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"create"| TokenReviews

    style AgentSA fill:#4a90e2,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style CRB fill:#e8e8e8,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SATokenMiddleware fill:#4a90e2,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style AllowList fill:#f5a623,stroke:#333
    style AgentApp fill:#7ed321,stroke:#333
    style HealthCheck fill:#d5e8d4,stroke:#82b366
    style APIHealth fill:#d5e8d4,stroke:#82b366
