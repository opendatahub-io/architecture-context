graph LR
    SparkOp["Spark Operator<br/>(Controller + Webhook)"]

    %% External Dependencies
    SparkOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    SparkOp -->|"K8s API client"| ClientGo["client-go<br/>v0.35.2"]
    SparkOp -->|"cron scheduling"| Cron["robfig/cron<br/>v3.0.1"]
    SparkOp -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.23.2"]
    SparkOp -->|"batch scheduling"| Volcano["volcano.sh/apis<br/>v1.10.0"]
    SparkOp -->|"co-scheduling"| SchedPlugins["scheduler-plugins<br/>v0.34.7"]
    SparkOp -->|"Spark runtime"| PySpark["PySpark 4.0.4 +<br/>Java 17 OpenJDK"]

    %% Internal Platform Dependencies
    SparkOp -->|"TLS certificates"| CertManager["cert-manager"]
    SparkOp -->|"metrics collection"| PromOperator["prometheus-operator<br/>PodMonitor"]
    ModCtrl["Module Controller"] -->|"platform detection"| ODHPlatform["odh-platform-utilities"]

    %% Platform Operator creates SparkOperator CR
    PlatformOp["opendatahub-operator /<br/>rhods-operator"] -->|"creates SparkOperator CR"| ModCtrl

    %% Integration Points (downstream consumers)
    SparkOp -->|"TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]
    SparkOp -->|"CRD reconciliation"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Spark runtime services
    SparkOp -->|"driver/executor mgmt"| SparkPods["Spark Driver Pods<br/>7078, 7079/TCP"]
    SparkOp -->|"UI service creation"| SparkUI["Spark UI<br/>4040/TCP"]
    SparkOp -->|"session endpoint"| SparkConnect["SparkConnect gRPC<br/>15002/TCP"]

