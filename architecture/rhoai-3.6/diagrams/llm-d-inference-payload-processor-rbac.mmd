graph TD
    subgraph SA["Service Account"]
        PayloadProcessorSA["payload-processor<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph Bindings["Role Bindings"]
        CRB["payload-processor-auth-reviewer-binding<br/>(ClusterRoleBinding or RoleBinding)"]
    end

    subgraph Roles["Cluster Role"]
        CR["payload-processor-auth-reviewer"]
    end

    subgraph Resources["API Resources"]
        ConfigMaps["core (v1)<br/>ConfigMaps"]
    end

    subgraph Verbs["Permitted Operations"]
        Get["get"]
        List["list"]
        Watch["watch"]
    end

    PayloadProcessorSA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"get"| ConfigMaps
    CR -->|"list"| ConfigMaps
    CR -->|"watch"| ConfigMaps

    subgraph ScopeNote["Scope Configuration"]
        direction LR
        Default["Default: namespace-scoped<br/>Role + RoleBinding"]
        Multi["multiNamespace=true:<br/>ClusterRole + ClusterRoleBinding"]
    end

    subgraph MetricsAuth["Metrics Endpoint Auth (Optional)"]
        MetricsEndpoint["Metrics Server (9090/TCP)"]
        TokenReview["TokenReview API"]
        SubjectAccessReview["SubjectAccessReview API"]

        MetricsEndpoint -->|"validates token"| TokenReview
        MetricsEndpoint -->|"checks authz"| SubjectAccessReview
    end

    style PayloadProcessorSA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333,color:#333
    style CR fill:#f5a623,stroke:#333,color:#333
    style ConfigMaps fill:#7ed321,stroke:#333,color:#333
    style Get fill:#d5e8d4,stroke:#82b366,color:#333
    style List fill:#d5e8d4,stroke:#82b366,color:#333
    style Watch fill:#d5e8d4,stroke:#82b366,color:#333
    style Default fill:#dae8fc,stroke:#6c8ebf,color:#333
    style Multi fill:#fff2cc,stroke:#d6b656,color:#333
    style MetricsEndpoint fill:#e1d5e7,stroke:#9673a6,color:#333
    style TokenReview fill:#e1d5e7,stroke:#9673a6,color:#333
    style SubjectAccessReview fill:#e1d5e7,stroke:#9673a6,color:#333
