graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["🟦 = Authentication boundary"]
        L2["🟨 = Warning / No auth"]
        L3["🟩 = Authenticated"]
    end

    subgraph AuthModel["TrustyAI Service Authentication Model"]
        direction TB

        subgraph KubeRBACFlow["Authenticated Path (kube-rbac-proxy)"]
            Client["Client<br/>(Dashboard, CLI, Prometheus)"]
            KubeRBAC["kube-rbac-proxy<br/>(sidecar)"]
            K8sAPI["Kubernetes API Server<br/>(token validation)"]
            MainPort["Main App :8081<br/>Protected Endpoints"]

            Client -->|"1. HTTPS request<br/>OAuth Bearer Token"| KubeRBAC
            KubeRBAC -->|"2. Validate token"| K8sAPI
            K8sAPI -->|"3. Token valid +<br/>RBAC authorized"| KubeRBAC
            KubeRBAC -->|"4. Forward request<br/>HTTP/8081"| MainPort
        end

        subgraph UnauthPaths["Unauthenticated Paths"]
            TLSPort["Main App :4443<br/>HTTPS Direct Access<br/>NO AUTH MIDDLEWARE"]
            HealthPort["Health App :8080<br/>Intentionally Open"]

            KServe["KServe Logger"] -->|"POST / (CloudEvents)<br/>HTTP/8080, No Auth"| HealthPort
            ModelMesh["ModelMesh Agent"] -->|"POST /consumer/kserve/v2<br/>HTTP/8080, No Auth"| HealthPort
            Kubelet["Kubelet"] -->|"GET /q/health/*<br/>HTTP/8080, No Auth"| HealthPort
        end

        subgraph RBACNote["RBAC (Managed by trustyai-service-operator)"]
            Note1["No RBAC manifests in this repository"]
            Note2["ClusterRoles, RoleBindings, and<br/>ServiceAccounts are created by<br/>the trustyai-service-operator"]
            Note3["kube-rbac-proxy enforces<br/>Kubernetes RBAC policies"]
        end
    end

    subgraph Secrets["Secrets Used"]
        S1["DATABASE_PASSWORD<br/>env var / Operator"]
        S2["DATABASE_USERNAME<br/>env var / Operator"]
        S3["TLS_CERT_FILE<br/>file mount / cert-manager"]
        S4["TLS_KEY_FILE<br/>file mount / cert-manager"]
        S5["DATABASE_TLS_CA_CERT<br/>file mount / Operator"]
    end

    %% Styles
    style KubeRBAC fill:#4a90e2,stroke:#333,color:#fff
    style K8sAPI fill:#4a90e2,stroke:#333,color:#fff
    style MainPort fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style TLSPort fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style HealthPort fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Client fill:#f9f9f9,stroke:#999
    style KServe fill:#f9f9f9,stroke:#999
    style ModelMesh fill:#f9f9f9,stroke:#999
    style Kubelet fill:#f9f9f9,stroke:#999
    style Note1 fill:#fff,stroke:#ccc
    style Note2 fill:#fff,stroke:#ccc
    style Note3 fill:#fff,stroke:#ccc
    style S1 fill:#e1d5e7,stroke:#9673a6
    style S2 fill:#e1d5e7,stroke:#9673a6
    style S3 fill:#e1d5e7,stroke:#9673a6
    style S4 fill:#e1d5e7,stroke:#9673a6
    style S5 fill:#e1d5e7,stroke:#9673a6
