graph LR
    MCPModOp["MCP Lifecycle<br/>Module Operator"]

    %% Internal Platform Dependencies
    MCPModOp -->|"Go library<br/>(SSA, GC, conditions)"| PlatformUtils["odh-platform-utilities"]
    MCPModOp -->|"CRD watch<br/>(MCPLifecycleOperator)"| PlatformOp["ODH Platform Operator"]
    MCPModOp -->|"SSA deploy<br/>(operand)"| MCPLifecycleOp["mcp-lifecycle-operator<br/>(operand)"]

    %% External Dependencies - Kubernetes
    MCPModOp -->|"resource CRUD"| K8sAPI["Kubernetes API<br/>v0.36.2"]
    MCPModOp -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    MCPModOp -->|"manifest rendering"| Manifestival["manifestival<br/>v0.7.2"]

    %% External Dependencies - OpenShift
    MCPModOp -->|"TLS profile"| OpenShiftAPI["openshift/api"]
    MCPModOp -->|"cipher conversion"| LibraryGo["openshift/library-go"]

    %% CRD Dependencies
    MCPModOp -->|"webhook TLS certs"| CertManager["cert-manager"]
    MCPModOp -->|"Gateway/HTTPRoute"| GatewayAPI["Gateway API<br/>v1.6.2"]
    MCPModOp -->|"MCPGatewayExtension"| Kuadrant["Kuadrant MCP Gateway"]
    MCPModOp -->|"ServiceMonitor"| PrometheusOp["prometheus-operator"]
    MCPModOp -->|"StorageVersionMigration"| StorageMigrator["storage-version-migrator"]

    %% Integration Points (components that interact with this operator)
    PlatformOp -->|"creates CR"| MCPModOp

