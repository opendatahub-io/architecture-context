graph TB
    subgraph DW["Distributed Workloads"]
        subgraph Images["Universal Training Images"]
            CPU["th-torch-cpu-py312<br/>CPU Training Image<br/>PyTorch 2.13.0 / Python 3.12"]
            CUDA["th-torch-cuda-py312<br/>CUDA Training Image<br/>CUDA 13.0.2 / NCCL / DeepSpeed / vLLM"]
            ROCm["th-torch-rocm-py312<br/>ROCm Training Image<br/>ROCm 7.14 / RCCL"]
        end

        subgraph Entrypoint["Dual-Mode Entrypoint"]
            EP["entrypoint-universal.sh"]
            WB["Workbench Mode<br/>NOTEBOOK_ARGS set"]
            RT["Runtime Mode<br/>exec command"]
            EP -->|NOTEBOOK_ARGS?| WB
            EP -->|else| RT
        end

        subgraph Tests["E2E Test Suites"]
            Support["tests/common/support<br/>Shared K8s Client Library"]
            KFTO["tests/kfto<br/>PyTorchJob Tests"]
            Trainer["tests/trainer<br/>TrainJob Tests"]
            ODH["tests/odh<br/>RayCluster/RayJob Tests"]
            FMS["tests/fms<br/>Fine-Tuning Tests"]
            Support --- KFTO
            Support --- Trainer
            Support --- ODH
            Support --- FMS
        end

        subgraph Benchmarks["Benchmarks"]
            OSU["osu-benchmarks<br/>MPI Micro-Benchmarks"]
            MPIDDP["kftv2-mpi-ddp-sft<br/>MPI DDP SFT Benchmark"]
        end
    end

    subgraph BaseImages["Base Images (Midstream)"]
        BaseCPU["odh-workbench-jupyter-minimal<br/>-cpu-py312-rhel9"]
        BaseCUDA["odh-workbench-jupyter-minimal<br/>-cuda-py312-rhel9"]
        BaseROCm["odh-workbench-jupyter-minimal<br/>-rocm-py312-rhel9"]
    end

    BaseCPU -->|base| CPU
    BaseCUDA -->|base| CUDA
    BaseROCm -->|base| ROCm

    AIPCC["AIPCC PyPI Index<br/>rhoai/3.6-EA2 channels"]
    AIPCC -->|pip install<br/>torch, transformers,<br/>training-hub, etc.| Images

    WBController["RHOAI Workbench Controller"]
    WBController -->|consumes| Images

    KFTOOp["Kubeflow Training Operator"]
    TrainerV2["Kubeflow Trainer v2"]
    KubeRay["KubeRay Operator"]
    KueueOp["Kueue"]

    KFTO -->|validates| KFTOOp
    Trainer -->|validates| TrainerV2
    ODH -->|validates| KubeRay
    Tests -->|integrates| KueueOp

    style CPU fill:#4a90e2,color:#fff
    style CUDA fill:#76b900,color:#fff
    style ROCm fill:#ed1c24,color:#fff
    style Support fill:#f5a623
    style KFTO fill:#7ed321
    style Trainer fill:#7ed321
    style ODH fill:#7ed321
    style FMS fill:#7ed321
