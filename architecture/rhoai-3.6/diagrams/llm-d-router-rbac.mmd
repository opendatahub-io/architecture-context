graph TD
    subgraph "Service Account"
        SA["llm-d-router<br/>(release namespace)"]
    end

    subgraph "Role Bindings"
        RB1["llm-d-router-sa<br/>(RoleBinding)"]
        RB2["llm-d-router-non-sa<br/>(RoleBinding)"]
        CRB["llm-d-router<br/>(ClusterRoleBinding)<br/>conditional: metrics auth"]
    end

    subgraph "Roles"
        R1["llm-d-router-sa<br/>(Role, namespace-scoped)"]
        R2["llm-d-router-non-sa<br/>(Role, namespace-scoped)"]
        CR["llm-d-router<br/>(ClusterRole, conditional)"]
    end

    subgraph "API Resources - Pod Access"
        Pods["core<br/>Pods"]
    end

    subgraph "API Resources - CRD Access"
        IObj["llm-d.ai<br/>InferenceObjective"]
        IMR["llm-d.ai<br/>InferenceModelRewrite"]
        IPool["inference.networking.k8s.io<br/>InferencePool"]
    end

    subgraph "API Resources - Auth (conditional)"
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
        MetricsURL["/metrics<br/>(Non-Resource URL)"]
    end

    %% Bindings
    SA -->|bound via| RB1
    SA -->|bound via| RB2
    SA -->|bound via| CRB

    RB1 -->|grants| R1
    RB2 -->|grants| R2
    CRB -->|grants| CR

    %% Permissions
    R1 -->|"get, watch, list"| Pods
    R2 -->|"get, watch, list"| IObj
    R2 -->|"get, watch, list"| IMR
    R2 -->|"get, watch, list"| IPool
    CR -->|"create"| TokenReviews
    CR -->|"create"| SAR
    CR -->|"get"| MetricsURL

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style R1 fill:#f5a623,color:#000
    style R2 fill:#f5a623,color:#000
    style CR fill:#f5a623,color:#000
    style Pods fill:#7ed321,color:#000
    style IObj fill:#7ed321,color:#000
    style IMR fill:#7ed321,color:#000
    style IPool fill:#7ed321,color:#000
    style TokenReviews fill:#e8e8e8,color:#000
    style SAR fill:#e8e8e8,color:#000
    style MetricsURL fill:#e8e8e8,color:#000
