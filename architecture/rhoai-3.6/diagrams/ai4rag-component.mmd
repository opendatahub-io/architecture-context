graph TB
    subgraph Library["ai4rag Library (Python Package)"]
        direction TB
        Experiment["AI4RAGExperiment<br/>Experiment Orchestrator"]
        HPO["HPO Engine<br/>(GAM-based / Random Search)"]

        subgraph Templates["RAG Templates"]
            SimpleRAG["SimpleRAG<br/>Single retrieve-generate"]
            AgenticRAG["AgenticRAG<br/>LangChain agent + query rewriting"]
        end

        subgraph VectorStores["Vector Store Backends"]
            Milvus["Milvus / Milvus Lite"]
            PgVector["PostgreSQL + pgvector"]
            Neo4j["Neo4j Graph DB"]
        end

        subgraph Pipeline["RAG Pipeline"]
            Chunking["Chunking<br/>(docling / LangChain)"]
            Embedding["Embedding Models<br/>(OpenAI SDK)"]
            Retrieval["Retriever<br/>(vector / hybrid / graph)"]
            FoundationModels["Foundation Models<br/>(OpenAI SDK)"]
        end

        subgraph Evaluation["Evaluators"]
            RAGAS["RAGAS"]
            Unitxt["Unitxt"]
            LLMJudge["LLM-as-Judge"]
        end

        subgraph Utils["Utilities"]
            NetworkUtils["URL Trust Policy<br/>(ensure_safe_url)"]
            MaaSClient["MaaS Client<br/>(TLS enforced)"]
            S3Client["S3 Client"]
        end

        AssetGen["Assets Generator<br/>(Starter Kit / Notebooks)"]
    end

    subgraph StarterKit["Agentic RAG Starter Kit (Generated)"]
        direction TB
        FastAPI["FastAPI App<br/>Port 8080/TCP"]
        AuthWrapper["Auth Wrapper<br/>(K8s TokenReview)"]
        ResponsesAPI["/v1/responses<br/>OpenAI Responses API"]
        HealthAPI["/health<br/>Health Check"]
        AgentConfig["Agent Config<br/>(AGENT_CONFIG_B64)"]

        FastAPI --> AuthWrapper
        FastAPI --> ResponsesAPI
        FastAPI --> HealthAPI
        AgentConfig -->|configures| ResponsesAPI
    end

    %% Orchestration flows
    Experiment -->|iterates via| HPO
    HPO -->|configures| Templates
    SimpleRAG -->|uses| Chunking
    SimpleRAG -->|uses| Retrieval
    SimpleRAG -->|uses| FoundationModels
    AgenticRAG -->|uses| Chunking
    AgenticRAG -->|uses| Retrieval
    AgenticRAG -->|uses| FoundationModels
    Retrieval -->|queries| VectorStores
    Embedding -->|indexes into| VectorStores
    Experiment -->|evaluates via| Evaluation
    Experiment -->|generates| AssetGen
    AssetGen -->|produces| StarterKit

    %% External services
    MaaS["MaaS Endpoint<br/>(OpenAI-compatible)<br/>443/TCP HTTPS"]
    S3["S3-Compatible Storage<br/>443/TCP HTTPS"]
    K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]

    FoundationModels -->|chat completions| MaaS
    Embedding -->|embeddings| MaaS
    S3Client -->|document download| S3
    AuthWrapper -->|TokenReview| K8sAPI
    ResponsesAPI -->|inference| MaaS

    %% Styling
    style Experiment fill:#4a90e2,stroke:#333,color:#fff
    style HPO fill:#4a90e2,stroke:#333,color:#fff
    style FastAPI fill:#7ed321,stroke:#333,color:#fff
    style AuthWrapper fill:#f5a623,stroke:#333,color:#fff
    style NetworkUtils fill:#f5a623,stroke:#333,color:#fff
    style MaaS fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
