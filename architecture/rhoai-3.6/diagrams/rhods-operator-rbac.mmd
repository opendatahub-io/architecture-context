graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["opendatahub-operator-<br/>controller-manager"]
        SA_AuthProxy["kube-auth-proxy SA"]
        SA_Argo["argo"]
        SA_Monitoring["data-science-<br/>monitoringstack-prometheus"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["opendatahub-operator-<br/>controller-manager-rolebinding"]
        CRB_Token["{template-value}-tokenreview"]
        CRB_Argo["ds-pipeline-argo-binding"]
        CRB_Monitoring["data-science-pipelines-operator-<br/>rhoai-prometheus"]
    end

    subgraph OperatorRoles["Operator ClusterRoles"]
        CR_Manager["controller-manager-role<br/>(Full CRUD on all managed CRDs)"]
        CR_Metrics["opendatahub-operator-<br/>metrics-reader<br/>(/metrics: get)"]
    end

    subgraph AdminRoles["Admin / User ClusterRoles"]
        CR_Admin["data-science-<br/>admingroupcluster-role"]
        CR_Allowed["data-science-<br/>allowedgroupcluster-role"]
    end

    subgraph EditorRoles["Per-Component Editor ClusterRoles"]
        CR_Dashboard["dashboard-editor-role"]
        CR_KServe["kserve-editor-role"]
        CR_Kueue["kueue-editor-role"]
        CR_ModelReg["modelregistry-editor-role"]
        CR_Ray["ray-editor-role"]
        CR_TrustyAI["trustyai-editor-role"]
        CR_Workbenches["workbenches-editor-role"]
    end

    subgraph ArgoRoles["Argo ClusterRoles"]
        CR_Argo["argo-cluster-role"]
    end

    subgraph AdminResources["Admin Group Resources"]
        R_Auths["services.platform.opendatahub.io<br/>auths"]
        R_DSC["datasciencecluster.opendatahub.io<br/>datascienceclusters"]
        R_MR["modelregistry.opendatahub.io<br/>modelregistries"]
        R_FS["feast.dev<br/>featurestores"]
        R_SC["storage.k8s.io<br/>storageclasses"]
        R_Users["user.openshift.io<br/>groups, users"]
        R_MaaS["maas.opendatahub.io<br/>maasmodelrefs"]
    end

    subgraph EditorResources["Component Editor Resources"]
        R_Dashboards["components.platform.opendatahub.io<br/>dashboards"]
        R_KServes["components.platform.opendatahub.io<br/>kserves"]
        R_Kueues["components.platform.opendatahub.io<br/>kueues"]
        R_ModelRegs["components.platform.opendatahub.io<br/>modelregistries"]
        R_Rays["components.platform.opendatahub.io<br/>rays"]
        R_TrustyAIs["components.platform.opendatahub.io<br/>trustyais"]
        R_WBs["components.platform.opendatahub.io<br/>workbenches"]
    end

    subgraph ArgoResources["Argo Resources"]
        R_Workflows["argoproj.io<br/>workflows, workflowtemplates,<br/>cronworkflows"]
        R_Pods["core<br/>pods, pods/exec,<br/>configmaps, secrets"]
    end

    %% SA → CRB → CR bindings
    SA_Manager -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager

    SA_AuthProxy -->|bound via| CRB_Token
    CRB_Token -->|grants| AuthDelegator["system:auth-delegator"]

    SA_Argo -->|bound via| CRB_Argo
    CRB_Argo -->|grants| CR_Argo

    SA_Monitoring -->|bound via| CRB_Monitoring
    CRB_Monitoring -->|grants| CR_Metrics

    %% Admin role → resources
    CR_Admin -->|"get,list,watch,<br/>patch,update,<br/>create,delete"| R_Auths
    CR_Admin -->|"get,list,watch,<br/>patch,update,<br/>create,delete"| R_DSC
    CR_Admin -->|"get,list,watch,<br/>patch,update,<br/>create,delete"| R_MR
    CR_Admin -->|"get,list,watch,<br/>patch,update,<br/>create,delete"| R_FS
    CR_Admin -->|"get,list,watch"| R_SC
    CR_Admin -->|"get,list,watch"| R_Users
    CR_Admin -->|"get,list,watch,<br/>patch,update,<br/>create,delete"| R_MaaS

    CR_Allowed -->|"get,list,watch"| R_Auths

    %% Editor roles → resources
    CR_Dashboard -->|"CRUD + watch"| R_Dashboards
    CR_KServe -->|"CRUD + watch"| R_KServes
    CR_Kueue -->|"CRUD + watch"| R_Kueues
    CR_ModelReg -->|"CRUD + watch"| R_ModelRegs
    CR_Ray -->|"CRUD + watch"| R_Rays
    CR_TrustyAI -->|"CRUD + watch"| R_TrustyAIs
    CR_Workbenches -->|"CRUD + watch"| R_WBs

    %% Argo role → resources
    CR_Argo -->|"Full CRUD<br/>(scoped per resource)"| R_Workflows
    CR_Argo -->|"Full CRUD<br/>(scoped per resource)"| R_Pods

    %% Styling
    style SA_Manager fill:#4a90e2,stroke:#333,color:#fff
    style SA_AuthProxy fill:#4a90e2,stroke:#333,color:#fff
    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style SA_Monitoring fill:#4a90e2,stroke:#333,color:#fff

    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_Admin fill:#f5a623,stroke:#333
    style CR_Allowed fill:#f5a623,stroke:#333
    style CR_Dashboard fill:#f5a623,stroke:#333
    style CR_KServe fill:#f5a623,stroke:#333
    style CR_Kueue fill:#f5a623,stroke:#333
    style CR_ModelReg fill:#f5a623,stroke:#333
    style CR_Ray fill:#f5a623,stroke:#333
    style CR_TrustyAI fill:#f5a623,stroke:#333
    style CR_Workbenches fill:#f5a623,stroke:#333
    style CR_Argo fill:#f5a623,stroke:#333
    style AuthDelegator fill:#f5a623,stroke:#333

    style R_Auths fill:#7ed321,stroke:#333
    style R_DSC fill:#7ed321,stroke:#333
    style R_MR fill:#7ed321,stroke:#333
    style R_FS fill:#7ed321,stroke:#333
    style R_SC fill:#7ed321,stroke:#333
    style R_Users fill:#7ed321,stroke:#333
    style R_MaaS fill:#7ed321,stroke:#333
    style R_Dashboards fill:#7ed321,stroke:#333
    style R_KServes fill:#7ed321,stroke:#333
    style R_Kueues fill:#7ed321,stroke:#333
    style R_ModelRegs fill:#7ed321,stroke:#333
    style R_Rays fill:#7ed321,stroke:#333
    style R_TrustyAIs fill:#7ed321,stroke:#333
    style R_WBs fill:#7ed321,stroke:#333
    style R_Workflows fill:#7ed321,stroke:#333
    style R_Pods fill:#7ed321,stroke:#333
