graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        Route["{cr-name} Route<br/>443/TCP → 8443/TCP<br/>TLS re-encrypt"]
    end

    subgraph MeshOptional["SERVICE MESH (Optional)"]
        VirtualSvc["{cr-name} VirtualService<br/>80/TCP HTTP<br/>mesh-internal"]
    end

    subgraph OperatorNS["Namespace: redhat-ods-applications"]
        direction TB
        OperatorMgr["TrustyAI Operator Manager<br/>SA: trustyai-operator-module-controller-manager<br/>:8081/TCP Health (HTTP, unauth)<br/>:8443/TCP Metrics (HTTPS, Bearer+RBAC)<br/>:9443/TCP Webhook (HTTPS, API server)"]
    end

    subgraph UserNS["Namespace: {user-namespace}"]
        direction TB
        subgraph TASPod["TrustyAI Service Pod"]
            KRBProxy["kube-rbac-proxy<br/>:8443/TCP HTTPS<br/>SAR per request"]
            TASContainer["TrustyAI Service<br/>:8081/TCP HTTP<br/>localhost only"]
        end
        TASSvc["{cr-name} Service<br/>ClusterIP 443→8443"]
        LMEvalPod["LMEvalJob Pod<br/>lmes-driver + lmes-job<br/>Batch Job (no ports)"]
        NemoPod["NemoGuardrails Server<br/>ConfigMap-based rails"]
    end

    subgraph EvalHubNS["Namespace: EvalHub Control-Plane"]
        EvalHub["EvalHub Deployment<br/>:8081/TCP HTTP<br/>Prometheus scrape"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        ModelEndpoint["Model Inference Endpoint<br/>HTTPS configurable"]
        OTELCollector["OpenTelemetry Collector<br/>OTLP/gRPC configurable"]
    end

    %% External access flows
    Client -->|"HTTPS/443<br/>TLS re-encrypt<br/>SAR auth"| Route
    Route -->|"HTTPS/8443<br/>service-ca TLS"| KRBProxy
    KRBProxy -->|"HTTP/8081<br/>localhost<br/>passthrough"| TASContainer

    %% Mesh path
    Client -.->|"HTTP/80<br/>mesh-internal"| VirtualSvc
    VirtualSvc -.->|"to TAS Service"| TASSvc
    TASSvc -->|"443→8443"| KRBProxy

    %% Operator to K8s API
    OperatorMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% K8s API to Operator (watches)
    K8sAPI -->|"Watch events<br/>CRDs + core resources"| OperatorMgr

    %% K8s API to webhook
    K8sAPI -->|"HTTPS/9443<br/>CRD conversion"| OperatorMgr

    %% Operator creates resources
    OperatorMgr -.->|"creates"| TASPod
    OperatorMgr -.->|"creates"| LMEvalPod
    OperatorMgr -.->|"creates"| NemoPod
    OperatorMgr -.->|"creates"| EvalHub

    %% EvalJob egress
    LMEvalPod -->|"HTTPS<br/>configurable auth"| ModelEndpoint

    %% Observability
    OperatorMgr -->|"OTLP/gRPC<br/>configurable"| OTELCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef mesh fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef operatorns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef userns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class VirtualSvc mesh
    class OperatorMgr operatorns
    class KRBProxy,TASContainer,TASSvc,LMEvalPod,NemoPod userns
    class EvalHub userns
    class K8sAPI control
    class ModelEndpoint,OTELCollector externalsvc
