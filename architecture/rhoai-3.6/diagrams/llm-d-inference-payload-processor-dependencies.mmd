graph LR
    IPP["Inference Payload<br/>Processor (IPP)"]

    %% External Dependencies (Go modules)
    IPP -->|"ext-proc API stubs"| EnvoyCP["go-control-plane<br/>v1.39.0"]
    IPP -->|"plugin types"| LLMDRouter["llm-d-router<br/>v0.11.0"]
    IPP -->|"request/response types"| OpenAI["openai-go<br/>v1.12.0"]
    IPP -->|"controller framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]
    IPP -->|"InferencePool types"| GatewayAPI["gateway-api-inference-ext<br/>v1.5.0"]
    IPP -->|"gRPC server"| GRPC["google.golang.org/grpc<br/>v1.84.0"]
    IPP -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.24.1"]
    IPP -->|"tracing"| OTel["opentelemetry<br/>v1.46.0"]
    IPP -->|"cert hot-reload"| FSNotify["fsnotify<br/>v1.10.1"]
    IPP -->|"adapter cache"| LRU["golang-lru/v2<br/>v2.0.7"]
    IPP -->|"quantile estimation"| TDigest["go-tdigest/v5<br/>v5.0.0"]

    %% Internal Platform Dependencies
    IPP -->|"gRPC ext-proc callout"| Envoy["Envoy Proxy"]
    IPP -->|"ConfigMap watch"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Integration Points (inbound)
    Istio["Istio EnvoyFilter"] -->|"wires ext-proc<br/>into filter chain"| IPP
    GKE["GKE GCPRoutingExtension"] -->|"wires ext-proc<br/>into Gateway"| IPP
    Prometheus["Prometheus"] -->|"scrapes metrics"| IPP
    OTLPCol["OTLP Collector"] -.->|"receives traces<br/>4317/TCP"| IPP

    %% Downstream
    IPP -.->|"routing headers"| InferencePool["InferencePool<br/>/ Model Server"]

