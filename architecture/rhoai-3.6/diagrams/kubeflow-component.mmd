graph TB
    subgraph KubeflowControllers["Kubeflow Notebook Controllers"]
        direction TB

        subgraph UpstreamController["notebook-controller"]
            NotebookCtrl["Notebook Controller<br/>(controller-runtime)"]
            CullingReconciler["Culling Reconciler<br/>(conditional: ENABLE_CULLING)"]
            ConversionWebhook["Conversion Webhook<br/>(/convert, 443/TCP)"]
        end

        subgraph ODHController["odh-notebook-controller"]
            ODHCtrl["ODH Notebook Controller<br/>(controller-runtime)"]
            MutatingWH["Mutating Webhook<br/>(/mutate-notebook-v1, 8443/TCP)<br/>FailurePolicy=Fail"]
            ValidatingWH["Validating Webhook<br/>(/validate-notebook-v1, 8443/TCP)<br/>FailurePolicy=Fail"]
        end
    end

    %% CRD
    NotebookCR["Notebook CR<br/>(kubeflow.org/v1)"]

    %% User
    User["User / Dashboard"]
    User -->|creates| NotebookCR

    %% Admission flow
    NotebookCR -->|admission| MutatingWH
    MutatingWH -->|injects kube-rbac-proxy<br/>resolves ImageStreams| NotebookCR
    NotebookCR -->|admission| ValidatingWH
    ValidatingWH -->|validates PodSpec<br/>MLflow annotation rules| NotebookCR

    %% Upstream controller reconciliation
    NotebookCR -->|watched by| NotebookCtrl
    NotebookCtrl -->|creates| StatefulSet["StatefulSet<br/>(1:1 pod mapping)"]
    NotebookCtrl -->|creates| Service["Service"]

    %% Culling
    CullingReconciler -->|checks activity| NotebookPod["Notebook Pod<br/>(Jupyter 8888/TCP)"]
    CullingReconciler -->|stops idle| NotebookCR

    %% ODH controller reconciliation
    NotebookCR -->|watched by| ODHCtrl
    ODHCtrl -->|creates| HTTPRoute["HTTPRoute<br/>(per-notebook)"]
    ODHCtrl -->|creates| NetworkPolicy["NetworkPolicy<br/>(per-notebook)"]
    ODHCtrl -->|creates| RoleBinding["RoleBinding"]
    ODHCtrl -->|creates| SA["ServiceAccount"]
    ODHCtrl -->|creates| DSPASecret["DSPA Secret<br/>(pipeline connectivity)"]

    %% External dependencies
    ODHCtrl -->|reads| Gateway["Platform Gateway"]
    ODHCtrl -->|reads| ImageStreams["OpenShift<br/>Image Streams"]
    ODHCtrl -->|manages| OAuthClient["OAuthClient<br/>(legacy)"]
    ODHCtrl -->|reads| OSRoutes["OpenShift Routes"]

    %% Conversion
    ConversionWebhook -->|v1 ↔ v1beta1 ↔ v1alpha1| NotebookCR

    %% Styling
    style NotebookCtrl fill:#4a90e2,color:#fff
    style ODHCtrl fill:#4a90e2,color:#fff
    style CullingReconciler fill:#4a90e2,color:#fff
    style MutatingWH fill:#e8742c,color:#fff
    style ValidatingWH fill:#e8742c,color:#fff
    style ConversionWebhook fill:#e8742c,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style StatefulSet fill:#7ed321,color:#fff
    style Service fill:#7ed321,color:#fff
    style HTTPRoute fill:#7ed321,color:#fff
    style NetworkPolicy fill:#7ed321,color:#fff
    style RoleBinding fill:#7ed321,color:#fff
    style SA fill:#7ed321,color:#fff
    style DSPASecret fill:#7ed321,color:#fff
    style Gateway fill:#999,color:#fff
    style ImageStreams fill:#999,color:#fff
    style OAuthClient fill:#999,color:#fff
    style OSRoutes fill:#999,color:#fff
