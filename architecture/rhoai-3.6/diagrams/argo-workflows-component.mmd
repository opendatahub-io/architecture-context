graph TB
    subgraph ArgoWorkflows["Argo Workflows Component"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            Controller["workflow-controller<br/>Go Controller<br/>9090/TCP metrics<br/>6060/TCP healthz"]
            LeaderElection["Leader Election<br/>Kubernetes Lease"]
            Controller -->|acquires| LeaderElection
        end

        subgraph ExecutionPlane["Execution Plane (per Workflow Pod)"]
            Argoexec["argoexec<br/>Go Executor Sidecar<br/>Container lifecycle mgmt"]
            MainContainer["Main Container<br/>(user workload)"]
            Argoexec -->|manages lifecycle| MainContainer
        end

        subgraph NotDeployed["Not Deployed in RHOAI"]
            ArgoServer["argo-server<br/>REST/gRPC API + UI<br/>2746/TCP<br/>(upstream only)"]
        end
    end

    DSP["Data Science Pipelines<br/>API Server"] -->|creates| WorkflowCR["Workflow CR<br/>argoproj.io/v1alpha1"]
    WorkflowCR -->|watched by| Controller
    Controller -->|creates pods with| Argoexec

    CronWorkflowCR["CronWorkflow CR"] -->|watched by| Controller
    Controller -->|creates on schedule| WorkflowCR

    Argoexec -->|reports via| TaskResult["WorkflowTaskResult CR"]
    TaskResult -->|read by| Controller

    Controller -->|updates| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Argoexec -->|uploads artifacts| ArtifactStorage["Artifact Storage<br/>S3/GCS/Azure<br/>443/TCP HTTPS"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Argoexec fill:#4a90e2,stroke:#333,color:#fff
    style ArgoServer fill:#999,stroke:#666,color:#fff,stroke-dasharray: 5 5
    style MainContainer fill:#7ed321,stroke:#333,color:#fff
    style DSP fill:#7ed321,stroke:#333,color:#fff
    style WorkflowCR fill:#f5a623,stroke:#333,color:#fff
    style CronWorkflowCR fill:#f5a623,stroke:#333,color:#fff
    style TaskResult fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ArtifactStorage fill:#e8e8e8,stroke:#333
    style LeaderElection fill:#ddd,stroke:#333
