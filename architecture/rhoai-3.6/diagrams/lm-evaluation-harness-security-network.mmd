graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        Operator["TrustyAI / LMEval Operator<br/>Manages LMEvalJob CRD"]
    end

    subgraph BatchJob["BATCH JOB (Ephemeral Pod - No Inbound Services)"]
        direction TB
        Container["lmes-job Container<br/>Image: rhoai/odh-ta-lmes-job-rhel9<br/>UID: 65532 (non-root)<br/>No exposed ports"]

        subgraph SecurityFeatures["Security Controls"]
            PathProtect["Path Traversal Protection<br/>(CWE-22)"]
            ErrorSanitize["Error Sanitization<br/>(Redacts secrets)"]
            CodeGate["Code Exec Allowlist<br/>(HumanEval gating)"]
        end

        subgraph Mounts["Mounted Volumes"]
            JobSpec["/meta/job.json<br/>(ConfigMap)"]
            TestData["/test_data<br/>(optional, disconnected)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelEndpoint["Model Inference Endpoint<br/>OpenAI-compatible API<br/>TLS"]
        EvalHubSvc["EvalHub Service<br/>443/TCP<br/>TLS"]
        OCIReg["OCI Registry<br/>443/TCP<br/>TLS"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP TLS"]
        S3["AWS S3-Compatible<br/>Storage<br/>TLS"]
        MLflow["MLflow<br/>TLS"]
    end

    %% Control flow
    Operator -->|"Job Creation<br/>K8s RBAC"| Container

    %% Egress flows
    Container -->|"POST /v1/completions<br/>HTTPS / TLS<br/>Auth: Bearer OPENAI_API_KEY"| ModelEndpoint
    Container -->|"POST status + results<br/>HTTPS/443 / TLS<br/>Auth: Provider credentials"| EvalHubSvc
    Container -->|"OCI push artifacts<br/>HTTPS/443 / TLS<br/>Auth: Username/Password"| OCIReg
    Container -->|"GET tokenizers + datasets<br/>HTTPS/443 / TLS<br/>Auth: HF_TOKEN (optional)"| HFHub
    Container -->|"S3 API (boto3)<br/>HTTPS / TLS<br/>Auth: AWS credentials"| S3
    Container -->|"REST / TLS<br/>Log results + metrics"| MLflow

    %% Styling
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef batchjob fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef security fill:#f8d7da,stroke:#dc3545,stroke-width:1px
    classDef mount fill:#fff3cd,stroke:#856404,stroke-width:1px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Operator controlplane
    class Container batchjob
    class PathProtect,ErrorSanitize,CodeGate security
    class JobSpec,TestData mount
    class ModelEndpoint,EvalHubSvc,OCIReg,HFHub,S3,MLflow external
