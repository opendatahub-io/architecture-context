graph TB
    subgraph SimService["llm-d-inference-sim Service"]
        direction TB

        subgraph CommLayer["Communication Layer (cmux)"]
            HTTPServer["HTTP Server<br/>(fasthttp)"]
            GRPCServer["gRPC Server<br/>(VllmEngine)"]
            Mux["cmux Multiplexer<br/>8000/TCP"]
            Mux -->|HTTP/1.1| HTTPServer
            Mux -->|HTTP/2| GRPCServer
        end

        subgraph EngineLayer["Engine Layer"]
            VLLMEngine["vLLM Engine<br/>(primary)"]
            SGLangEngine["SGLang Engine<br/>(experimental)"]
        end

        subgraph SimCore["Simulator Core"]
            WorkerQueue["Worker Queue<br/>(configurable concurrency)"]
            LatencySim["Latency Simulator<br/>(TTFT, decode delays)"]
            ResponseEngine["Response Engine<br/>(random / echo)"]
        end

        subgraph KVCache["KV-Cache Subsystem"]
            BlockCache["Block Cache<br/>(in-memory)"]
            ZMQPub["ZMQ PUB Socket<br/>(msgpack events)"]
            BlockCache -->|BlockStored<br/>BlockRemoved<br/>AllBlocksCleared| ZMQPub
        end

        subgraph TLSLayer["TLS Layer (optional)"]
            CertManager["Certificate Manager<br/>(fsnotify hot-reload)"]
        end

        HTTPServer -->|routes| VLLMEngine
        GRPCServer -->|service| VLLMEngine
        VLLMEngine -->|requests| WorkerQueue
        WorkerQueue --> LatencySim
        LatencySim --> ResponseEngine
        VLLMEngine -->|cache ops| BlockCache
        CertManager -.->|TLS config| Mux
    end

    %% External Actors
    Client["Client<br/>(HTTP/gRPC)"] -->|8000/TCP| Mux

    %% Sidecar
    subgraph Sidecar["vllm-render Sidecar (optional)"]
        RenderServer["vLLM Render Server<br/>8082/TCP<br/>HuggingFace Tokenizer"]
    end
    VLLMEngine -->|/render, /derender<br/>HTTP 8082| RenderServer

    %% External Consumers
    ZMQPub -->|ZMQ TCP| RouterEPP["llm-d-router EPP<br/>(ZMQ SUB)"]
    ZMQPub -->|ZMQ TCP| ZMQListener["zmq-listener<br/>(debug)"]

    %% External Data
    DatasetDB[("SQLite Dataset<br/>(optional)")] -.->|response replay| ResponseEngine

    %% Monitoring
    HTTPServer -->|/metrics| Prometheus["Prometheus<br/>(scrape)"]

    %% Styling
    style SimService fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style CommLayer fill:#d5e8d4,stroke:#82b366
    style EngineLayer fill:#fff2cc,stroke:#d6b656
    style SimCore fill:#f8cecc,stroke:#b85450
    style KVCache fill:#e1d5e7,stroke:#9673a6
    style TLSLayer fill:#dae8fc,stroke:#6c8ebf
    style Sidecar fill:#fff2cc,stroke:#d6b656
    style Client fill:#f5f5f5,stroke:#666
    style RouterEPP fill:#d5e8d4,stroke:#82b366
    style ZMQListener fill:#f5f5f5,stroke:#666
    style Prometheus fill:#f5f5f5,stroke:#666
    style DatasetDB fill:#f5f5f5,stroke:#666
