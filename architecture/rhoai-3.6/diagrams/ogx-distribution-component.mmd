graph TB
    subgraph OGX["OGX Distribution"]
        direction TB
        Entrypoint["entrypoint.sh<br/>Secret Resolution<br/>OTel Wrapping"]
        Server["OGX Server<br/>Port 8321/TCP"]
        Config["config.yaml<br/>Auto-generated"]
        Entrypoint -->|launches| Server
        Config -->|loaded by| Server
    end

    subgraph APIs["Exposed APIs"]
        direction TB
        Responses["/v1/responses<br/>Agentic Responses"]
        Messages["/v1/messages<br/>Anthropic Messages"]
        Inference["/v1/inference/*<br/>LLM Inference"]
        VectorStores["/v1/vector_stores<br/>Vector Store Mgmt"]
        Files["/v1/files<br/>File Management"]
        Batches["/v1/batches<br/>Batch Processing"]
        Health["/health"]
        Metrics["/metrics"]
    end

    Server --> Responses
    Server --> Messages
    Server --> Inference
    Server --> VectorStores
    Server --> Files
    Server --> Batches
    Server --> Health
    Server --> Metrics

    Client["Client"] -->|HTTP 8321/TCP<br/>OAuth2 token| Server

    subgraph InferenceProviders["Inference Providers (conditional)"]
        vLLM["vLLM<br/>HTTP/HTTPS"]
        OpenAI["OpenAI API<br/>HTTPS/443"]
        Anthropic["Anthropic API<br/>HTTPS/443"]
        AzureOAI["Azure OpenAI<br/>HTTPS/443"]
        Bedrock["AWS Bedrock<br/>HTTPS/443"]
        VertexAI["Google Vertex AI<br/>HTTPS/443"]
        Watsonx["IBM watsonx<br/>HTTPS/443"]
        Gemini["Google Gemini<br/>HTTPS/443"]
    end

    subgraph VectorProviders["Vector Store Providers (conditional)"]
        Milvus["Milvus<br/>HTTP/gRPC"]
        PgVector["PgVector<br/>5432/TCP"]
        Qdrant["Qdrant<br/>6333-6334/TCP"]
    end

    subgraph SearchProviders["Search Providers (conditional)"]
        Brave["Brave Search<br/>HTTPS/443"]
        Tavily["Tavily Search<br/>HTTPS/443"]
    end

    Server -->|inference| vLLM
    Server -->|inference| OpenAI
    Server -->|inference| Anthropic
    Server -->|inference| AzureOAI
    Server -->|inference| Bedrock
    Server -->|inference| VertexAI
    Server -->|inference| Watsonx
    Server -->|inference| Gemini

    Server -->|vector ops| Milvus
    Server -->|vector ops| PgVector
    Server -->|vector ops| Qdrant

    Server -->|web search| Brave
    Server -->|web search| Tavily

    PostgreSQL["PostgreSQL<br/>5432/TCP"] -->|state storage| Server
    Server -->|SQL/KV| PostgreSQL

    subgraph Platform["Platform Integration"]
        OGXOperator["ogx-operator<br/>Manages deployment"]
        Prometheus["Prometheus<br/>Metrics scrape"]
        Praxis["Praxis Proxy<br/>Identity headers"]
        OTel["OpenTelemetry Collector"]
    end

    OGXOperator -->|deploys & manages| OGX
    Prometheus -->|scrapes /metrics| Server
    Praxis -->|x-user-id, x-tenant-id| Server
    Server -->|OTLP traces| OTel

    S3["AWS S3<br/>HTTPS/443"] -.->|file storage| Server
    OIDC["OIDC Provider<br/>HTTPS/443"] -.->|JWKS token validation| Server

    style Server fill:#4a90e2,stroke:#333,stroke-width:3px
    style Entrypoint fill:#4a90e2,stroke:#333
    style Config fill:#4a90e2,stroke:#333
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style PostgreSQL fill:#f5a623,stroke:#333,stroke-width:2px
    style vLLM fill:#999,stroke:#333
    style OpenAI fill:#999,stroke:#333
    style Anthropic fill:#999,stroke:#333
    style AzureOAI fill:#999,stroke:#333
    style Bedrock fill:#999,stroke:#333
    style VertexAI fill:#999,stroke:#333
    style Watsonx fill:#999,stroke:#333
    style Gemini fill:#999,stroke:#333
    style Milvus fill:#999,stroke:#333
    style PgVector fill:#999,stroke:#333
    style Qdrant fill:#999,stroke:#333
    style Brave fill:#999,stroke:#333
    style Tavily fill:#999,stroke:#333
    style OGXOperator fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style Praxis fill:#7ed321,stroke:#333
    style OTel fill:#7ed321,stroke:#333
