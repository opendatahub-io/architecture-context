graph LR
    AutoGluonServer["KServe AutoGluon Server<br/>(Serving Runtime)"]

    %% Internal RHOAI Dependencies
    AutoGluonServer -->|"CRD registration<br/>pod lifecycle"| KServeOp["KServe Operator"]
    AutoGluonServer -->|"model deployment<br/>modelFormat: autogluon"| InferenceService["KServe InferenceService<br/>(CRD)"]
    AutoGluonServer -->|"model download<br/>init container"| StorageInit["KServe Storage<br/>Initializer"]

    %% Core Framework Dependencies
    AutoGluonServer -->|"serving framework"| KServeSDK["KServe SDK<br/>>=0.16.0"]
    AutoGluonServer -->|"storage handling"| KServeStorage["kserve-storage<br/>0.19.0"]
    AutoGluonServer -->|"HTTP server"| FastAPI["FastAPI<br/>>=0.115.3"]
    AutoGluonServer -->|"ASGI server"| Uvicorn["uvicorn<br/>>=0.30.6"]
    AutoGluonServer -->|"gRPC server"| GRPCIO["grpcio<br/>>=1.73.0"]

    %% ML Framework Dependencies
    AutoGluonServer -->|"tabular + timeseries ML"| AutoGluon["AutoGluon<br/>1.5.0+rhaiv.3"]
    AutoGluon -->|"gradient boosting"| LightGBM["LightGBM 4.6.0"]
    AutoGluon -->|"gradient boosting"| XGBoost["XGBoost 3.1.3"]
    AutoGluon -->|"neural networks"| PyTorch["PyTorch 2.11.0"]
    AutoGluon -->|"deep learning"| FastAI["fastai 2.8.7"]
    AutoGluon -->|"ML utilities"| ScikitLearn["scikit-learn ~1.5.1"]

    %% Data Dependencies
    AutoGluonServer -->|"data handling"| NumPy["numpy >=1.26.0"]
    AutoGluonServer -->|"DataFrame ops"| Pandas["pandas >=2.2.0"]

    %% Security Dependencies
    AutoGluonServer -->|"TLS/crypto"| Cryptography["cryptography<br/>>=46.0.5"]
    AutoGluonServer -->|"JWT tokens"| PyJWT["pyjwt >=2.12.0"]
    AutoGluonServer -->|"AWS S3 access"| Boto3["boto3 >=1.29.0"]

    %% External Services
    AutoGluonServer -->|"model artifacts<br/>HTTPS/443"| CloudStorage["Cloud Storage<br/>(S3/GCS/Azure)"]
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>HTTP/8080"| AutoGluonServer

    %% Base Image
    AutoGluonServer -->|"container base"| BaseImage["AIPCC CPU Base<br/>base-image-cpu-rhel9"]

