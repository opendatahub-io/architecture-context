graph LR
    GD["Guardrails Detectors<br/>(3 microservices)"]

    %% Internal Platform Dependencies
    GD -->|"deploys as<br/>InferenceService"| KServe["KServe"]
    GD -->|"sidecar mTLS<br/>+ auth"| Istio["Istio"]
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>REST API consumer"| GD

    %% External Service Dependencies
    GD -->|"async HTTP eval<br/>(LLM Judge only)"| VLLM["vLLM Server"]
    GD -->|"model loading<br/>(HuggingFace)"| ModelStore["HuggingFace<br/>Model Store"]
    GD -->|"model storage<br/>(dev/test)"| MinIO["MinIO<br/>9000/TCP"]

    %% Python Framework Dependencies
    GD -->|"HTTP framework"| FastAPI["FastAPI 0.136-0.141"]
    GD -->|"ASGI server"| Uvicorn["uvicorn 0.34"]
    GD -->|"data validation"| Pydantic["pydantic 2.13"]
    GD -->|"metrics"| PromClient["prometheus-client<br/>0.25"]

    %% Detector-Specific Dependencies
    GD -->|"model inference<br/>(HuggingFace)"| Transformers["transformers 5.3+"]
    GD -->|"tensor ops + CUDA<br/>(HuggingFace)"| PyTorch["torch 2.11+"]
    GD -->|"LLM judge framework<br/>(LLM Judge)"| VLLMJudge["vllm-judge 0.1.8"]
    GD -->|"regex with timeout<br/>(built-in)"| Regex["regex 2026.9"]

    %% Observability
    Prometheus["Prometheus"] -->|"scrapes /metrics"| GD

