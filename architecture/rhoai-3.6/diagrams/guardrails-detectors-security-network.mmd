graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Orchestrator["FMS Guardrails Orchestrator<br/>(API Consumer)"]
        VLLMServer["vLLM Server<br/>8080/TCP HTTP<br/>No TLS, No Auth"]
    end

    subgraph PlatformMesh["SERVICE MESH (Istio mTLS STRICT)"]
        direction TB

        subgraph NS_KServeHF["KServe InferenceService: HuggingFace"]
            HFDetector["HuggingFace Detector<br/>SA: default<br/>Port: 8000/TCP HTTP<br/>UID: 1001<br/>security.opendatahub.io/enable-auth: true<br/>sidecar.istio.io/inject: true"]
        end

        subgraph NS_KServeJudge["KServe InferenceService: LLM Judge"]
            JudgeDetector["LLM Judge Detector<br/>SA: default<br/>Port: 8000/TCP HTTP<br/>UID: 1001<br/>security.opendatahub.io/enable-auth: true<br/>sidecar.istio.io/inject: true"]
        end
    end

    subgraph InternalPod["INTERNAL (Pod-level, no mesh)"]
        BuiltInDetector["Built-in Detector<br/>Port: 8080/TCP HTTP<br/>UID: 1001<br/>TLS: Configurable via config.yaml<br/>Auth: None"]
    end

    subgraph ModelStorage["MODEL STORAGE"]
        ModelDir["Local Model Directory<br/>(MODEL_DIR)<br/>Filesystem"]
        MinIO["MinIO<br/>(dev/test only)<br/>9000/TCP<br/>No TLS, No Auth"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>No TLS<br/>No Auth"| BuiltInDetector
    Orchestrator -->|"HTTP/8000<br/>Platform TLS (Istio)<br/>Platform Auth (KServe)"| HFDetector
    Orchestrator -->|"HTTP/8000<br/>Platform TLS (Istio)<br/>Platform Auth (KServe)"| JudgeDetector

    JudgeDetector -->|"HTTP/8080<br/>No TLS<br/>No Auth"| VLLMServer

    HFDetector -->|"Filesystem<br/>N/A"| ModelDir
    ModelDir -.->|"TCP/9000<br/>No TLS (dev)"| MinIO

    Prometheus -->|"HTTP/8080<br/>No Auth"| BuiltInDetector
    Prometheus -->|"HTTP/8000<br/>No Auth"| HFDetector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Orchestrator,VLLMServer external
    class HFDetector,JudgeDetector servicemesh
    class BuiltInDetector internal
    class ModelDir,MinIO storage
    class Prometheus observability
