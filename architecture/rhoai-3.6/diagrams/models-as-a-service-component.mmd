graph TB
    subgraph MaaS["Models as a Service Platform"]
        direction TB

        subgraph Controller["maas-controller (Go Operator)"]
            AITenantR["AITenantReconciler"]
            SubscriptionR["MaaSSubscriptionReconciler"]
            ModelRefR["MaaSModelRefReconciler"]
            AuthPolicyR["MaaSAuthPolicyReconciler"]
            ExternalModelR["ExternalModelReconciler"]
            TenantR["TenantReconciler"]
            LifecycleR["LifecycleReconciler"]
            Webhook["Webhook Server<br/>9443/TCP"]
        end

        subgraph TenantNS["Per-Tenant Namespace"]
            MaaSAPI["maas-api<br/>8080/TCP HTTP<br/>9090/TCP Metrics"]
            NetworkPolicies["NetworkPolicies<br/>(allow-gateway, allow-monitoring,<br/>allow-cleanup, restrict-egress)"]
        end

        Discovery["maas-discovery<br/>8443/TCP"]
    end

    %% CRDs
    AITenantCR["AITenant CR"]
    SubscriptionCR["MaaSSubscription CR"]
    ModelRefCR["MaaSModelRef CR"]
    AuthPolicyCR["MaaSAuthPolicy CR"]
    ExternalModelCR["ExternalModel CR"]
    ConfigCR["Config CR<br/>(Cluster-scoped)"]

    %% CRD Watches
    AITenantCR -->|watched by| AITenantR
    SubscriptionCR -->|watched by| SubscriptionR
    ModelRefCR -->|watched by| ModelRefR
    AuthPolicyCR -->|watched by| AuthPolicyR
    ExternalModelCR -->|watched by| ExternalModelR

    %% Controller Actions
    AITenantR -->|creates namespace| TenantNS
    LifecycleR -->|deploys| MaaSAPI
    AuthPolicyR -->|creates| KuadrantAuthPolicy["Kuadrant AuthPolicy"]
    SubscriptionR -->|creates| HTTPRoute["HTTPRoute"]
    SubscriptionR -->|creates| RateLimit["TokenRateLimitPolicy"]

    %% External Dependencies
    MaaSAPI -->|queries| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    MaaSAPI -->|auth| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|reconciles| K8sAPI

    %% Integrations
    Controller -.->|conditional watch| KServe["KServe<br/>LLMInferenceService"]
    Controller -.->|conditional watch| LlmD["llm-d<br/>InferenceObjective"]
    Gateway["Gateway API<br/>(data-science-gateway)"] -->|routes to| MaaSAPI
    KuadrantAuthPolicy -->|enforced by| Authorino["Kuadrant/Authorino"]

    %% Webhook validations
    Webhook -->|validates| AITenantCR
    Webhook -->|validates| SubscriptionCR
    Webhook -->|validates| ModelRefCR
    Webhook -->|validates| AuthPolicyCR

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style TenantNS fill:#d5e8d4,stroke:#82b366
    style MaaSAPI fill:#4a90e2,color:#fff
    style Discovery fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style AITenantCR fill:#f5a623,color:#fff
    style SubscriptionCR fill:#f5a623,color:#fff
    style ModelRefCR fill:#f5a623,color:#fff
    style AuthPolicyCR fill:#f5a623,color:#fff
    style ExternalModelCR fill:#f5a623,color:#fff
    style ConfigCR fill:#f5a623,color:#fff
    style PostgreSQL fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style KServe fill:#7ed321,color:#fff
    style LlmD fill:#7ed321,color:#fff
    style Gateway fill:#7ed321,color:#fff
    style Authorino fill:#7ed321,color:#fff
    style KuadrantAuthPolicy fill:#ffe6cc,stroke:#d79b00
    style HTTPRoute fill:#ffe6cc,stroke:#d79b00
    style RateLimit fill:#ffe6cc,stroke:#d79b00
