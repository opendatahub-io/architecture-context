graph TB
    subgraph Prism["llm-d-prism (BFF Web Application)"]
        direction TB

        subgraph Backend["Express BFF Server (Node.js/TypeScript)"]
            Server["Express Server<br/>Port: 8080/TCP"]
            GCSProxy["GCS Proxy<br/>/api/gcs/*"]
            GIQProxy["GIQ Proxy<br/>/api/giq/*"]
            ResultsStore["Results Store<br/>/api/results/*"]
            RegressionCache["Regression Cache<br/>5-min TTL"]
            PrefixCache["Prefix Cache Endpoint<br/>/api/prefix-cache/data"]
            PDDisagg["P/D Disaggregation<br/>/api/pd-disaggregation/data"]
            LocalFiles["Local File Server<br/>/api/local/*"]

            subgraph AuthZ["Authentication & Authorization"]
                OAuthModule["OAuth Module<br/>GitHub OAuth Flow"]
                IAMModule["IAM Module<br/>GCS Allowlists + Playground Mode"]
            end

            Server --> GCSProxy
            Server --> GIQProxy
            Server --> ResultsStore
            Server --> RegressionCache
            Server --> PrefixCache
            Server --> PDDisagg
            Server --> LocalFiles
            ResultsStore --> OAuthModule
            ResultsStore --> IAMModule
            GCSProxy --> IAMModule
        end

        subgraph Frontend["React Frontend (SPA)"]
            ReactApp["React 19 App<br/>Vite + Tailwind CSS v4"]
            Dashboards["Benchmark Dashboards<br/>Scatter / Comparison / Regression"]
            ResultsUI["Results Store UI<br/>Submit / Review / Promote"]
            Charts["Recharts Visualizations"]
            ReactApp --> Dashboards
            ReactApp --> ResultsUI
            Dashboards --> Charts
        end

        subgraph Tools["Offline Tools"]
            ArenaUpdater["Arena Score Updater<br/>Python Script"]
        end
    end

    User["Platform / ML Engineer"] -->|browses| ReactApp
    ReactApp -->|/api/*| Server

    GCSProxy -->|HTTPS/443| GCS["Google Cloud Storage"]
    GIQProxy -->|HTTPS/443| GIQ["GKE Recommender API"]
    ResultsStore -->|HTTPS/443| GCS
    RegressionCache -->|HTTPS/443| GCS
    PrefixCache -->|HTTPS/443| GCS
    PDDisagg -->|HTTPS/443| GCS
    OAuthModule -->|HTTPS/443| GitHubOAuth["GitHub OAuth"]
    OAuthModule -->|HTTPS/443| GitHubAPI["GitHub API"]
    IAMModule -->|HTTPS/443| GCS
    ArenaUpdater -->|HTTPS/443| Arena["LMSYS Arena"]

