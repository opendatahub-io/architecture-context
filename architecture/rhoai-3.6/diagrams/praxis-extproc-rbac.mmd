graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["payload-processing<br/>Namespace: openshift-ingress"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB["payload-processing-reader<br/>(ClusterRoleBinding, cluster-scoped)"]
    end

    subgraph ClusterRoles["ClusterRole Permissions"]
        CR["payload-processing-reader<br/>(ClusterRole)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core ('')<br/>configmaps"]
        Secrets["core ('')<br/>secrets"]
    end

    subgraph InferenceResources["inference.opendatahub.io Resources"]
        ExternalProviders["inference.opendatahub.io<br/>externalproviders"]
        ExternalModels["inference.opendatahub.io<br/>externalmodels"]
    end

    subgraph PodSecurity["Pod Security Context"]
        SecurityCtx["runAsNonRoot: true<br/>readOnlyRootFilesystem: true<br/>capabilities: drop ALL<br/>seccompProfile: RuntimeDefault"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"get, list, watch"| ConfigMaps
    CR -->|"get"| Secrets
    CR -->|"get, list, watch"| ExternalProviders
    CR -->|"get, list, watch"| ExternalModels

    SA ---|"enforces"| SecurityCtx

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#dae8fc,stroke:#6c8ebf
    style CR fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Secrets fill:#f8cecc,stroke:#b85450
    style ExternalProviders fill:#7ed321,stroke:#333
    style ExternalModels fill:#7ed321,stroke:#333
    style SecurityCtx fill:#e1d5e7,stroke:#9673a6
