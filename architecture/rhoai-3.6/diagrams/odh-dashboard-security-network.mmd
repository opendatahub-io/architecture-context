graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>HTTPRoute<br/>443/TCP → 8443/TCP<br/>TLS SIMPLE"]
    end

    subgraph CorePod["CORE DASHBOARD POD (3 containers)"]
        direction TB
        Proxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>serving-cert-secret<br/>OpenShift Auth"]
        NodeJS["Node.js/Fastify Backend<br/>8080/TCP HTTP (loopback)<br/>User Token Impersonation"]
        BFF["core-bff<br/>8943/TCP HTTPS<br/>serving-cert-secret<br/>Cluster TLS Profile"]
        Proxy -->|"HTTP/8080<br/>localhost<br/>x-forwarded-access-token"| NodeJS
    end

    subgraph ModulePods["FEDERATED MODULES (per-module NetworkPolicy)"]
        direction TB
        GenAI["gen-ai BFF<br/>8080/TCP<br/>SA: gen-ai-bff"]
        MaaS["maas BFF<br/>8080/TCP<br/>SA: maas-bff"]
        ModelReg["model-registry BFF<br/>8080/TCP<br/>SA: model-registry-bff"]
        AgentOps["agent-ops BFF<br/>8080/TCP<br/>SA: agent-ops-bff"]
        OtherModules["automl, autorag, eval-hub,<br/>mlflow, data-connect-hub,<br/>data-registry, notebooks<br/>8080/TCP each"]
    end

    subgraph OperatorZone["OPERATOR"]
        Operator["dashboard-operator<br/>SA: odh-dashboard-operator<br/>Webhook: 9443/TCP HTTPS<br/>Metrics: 8443/TCP HTTPS<br/>Health: 8081/TCP HTTP"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Egress)"]
        DSPipelines["DS Pipelines API<br/>8443/TCP HTTPS"]
        ModelRegAPI["Model Registry API<br/>8443/TCP HTTPS"]
        KServe["KServe<br/>varies HTTPS"]
        MLMD["MLMD<br/>8443/TCP gRPC-web"]
        TrustyAI["TrustyAI<br/>443/TCP HTTPS"]
        Prometheus["Prometheus/Thanos<br/>9092/TCP HTTPS"]
        LlamaStack["Llama Stack<br/>varies HTTPS"]
        MCPServers["MCP Servers<br/>varies SSE"]
    end

    %% External → Ingress → Core Pod
    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>OpenShift OAuth"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>serving-cert-secret"| Proxy

    %% Core Pod → Modules
    NodeJS -->|"HTTP/8080<br/>Forwarded Token"| GenAI
    NodeJS -->|"HTTP/8080<br/>Forwarded Token"| MaaS
    NodeJS -->|"HTTP/8080<br/>Forwarded Token"| ModelReg
    NodeJS -->|"HTTP/8080<br/>Forwarded Token"| AgentOps
    NodeJS -->|"HTTP/8080<br/>Forwarded Token"| OtherModules

    %% Core Pod → Cluster Services
    NodeJS -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Impersonation"| K8sAPI

    %% Modules → Cluster Services
    GenAI -->|"HTTPS/6443<br/>TLS 1.2+<br/>User/SA Token"| K8sAPI
    MaaS -->|"HTTPS/6443<br/>TLS 1.2+<br/>User/SA Token"| K8sAPI
    ModelReg -->|"HTTPS/6443<br/>TLS 1.2+<br/>User/SA Token"| K8sAPI
    AgentOps -->|"HTTPS/6443<br/>TLS 1.2+<br/>User/SA Token"| K8sAPI

    %% Operator → Cluster Services
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"HTTPS/9443<br/>Admission"| Operator

    %% Core Pod → Platform Services
    NodeJS -->|"HTTPS/8443<br/>Bearer Token"| DSPipelines
    NodeJS -->|"HTTPS/8443<br/>Bearer Token"| ModelRegAPI
    NodeJS -->|"HTTPS<br/>Bearer Token"| KServe
    NodeJS -->|"gRPC-web/8443<br/>Bearer Token"| MLMD
    NodeJS -->|"HTTPS/443<br/>Bearer Token"| TrustyAI
    NodeJS -->|"HTTPS/9092<br/>Bearer Token"| Prometheus

    %% Module → Platform Services
    GenAI -->|"HTTPS<br/>Bearer/API Key"| LlamaStack
    GenAI -->|"SSE<br/>varies"| MCPServers

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef corepod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef module fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Browser external
    class Gateway ingress
    class Proxy,NodeJS,BFF corepod
    class GenAI,MaaS,ModelReg,AgentOps,OtherModules module
    class Operator operator
    class K8sAPI cluster
    class DSPipelines,ModelRegAPI,KServe,MLMD,TrustyAI,Prometheus,LlamaStack,MCPServers platform
