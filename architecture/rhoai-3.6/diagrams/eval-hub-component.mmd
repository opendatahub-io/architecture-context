graph TB
    subgraph EvalHub["eval-hub Service"]
        direction TB
        APIServer["eval-hub API Server<br/>Go HTTP Service<br/>Port 8080/TCP"]
        MetricsSrv["Metrics Server<br/>Port 8081/TCP<br/>Prometheus"]
        APIServer -.->|exposes| MetricsSrv
    end

    subgraph EvalJobPod["Evaluation Job Pod"]
        direction TB
        InitContainer["eval-runtime-init<br/>Init Container<br/>Downloads test data"]
        ProviderAdapter["Provider Adapter<br/>lm-eval-harness / RAGAS<br/>/ Garak / GuideLLM"]
        Sidecar["eval-runtime-sidecar<br/>Reverse Proxy<br/>Credential injection"]
        InitContainer -->|"completes before"| ProviderAdapter
        ProviderAdapter -->|"all external traffic"| Sidecar
    end

    subgraph MCPComponent["MCP Server"]
        MCPServer["evalhub-mcp<br/>Port 3001/TCP<br/>stdio / HTTP / SSE"]
    end

    %% User interactions
    Client["REST Client"] -->|"POST /api/v1/evaluations/jobs<br/>via kube-rbac-proxy"| APIServer
    MCPClient["MCP Client / AI Agent"] -->|"MCP Protocol<br/>via kube-rbac-proxy"| MCPServer
    MCPServer -->|"REST API calls"| APIServer

    %% API Server creates Jobs
    APIServer -->|"creates"| EvalJobPod

    %% Init container data sources
    InitContainer -->|"downloads from"| S3["S3 Storage"]
    InitContainer -->|"clones from"| Git["Git Repos"]
    InitContainer -->|"downloads from"| HuggingFace["HuggingFace Hub"]

    %% Sidecar proxy targets
    Sidecar -->|"proxies inference"| ModelEndpoint["Model Endpoints"]
    Sidecar -->|"proxies tracking"| MLflow["MLflow Server"]
    Sidecar -->|"proxies artifacts"| OCI["OCI Registries"]
    Sidecar -->|"callbacks"| APIServer

    %% API Server dependencies
    APIServer -->|"CRUD Jobs, ConfigMaps,<br/>Secrets, NetworkPolicies"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    APIServer -->|"persistent storage"| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    APIServer -->|"experiment tracking"| MLflow
    APIServer -->|"telemetry export"| OTel["OpenTelemetry<br/>Collector"]

    %% Platform integrations
    APIServer -->|"reads"| HWProfile["HardwareProfile CR"]
    APIServer -->|"lists"| LocalQueue["Kueue LocalQueue"]

    %% Prometheus scrape
    Prometheus["Prometheus"] -->|"scrapes /metrics"| MetricsSrv

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsSrv fill:#4a90e2,stroke:#333,color:#fff
    style Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style MCPServer fill:#4a90e2,stroke:#333,color:#fff
    style ProviderAdapter fill:#50c878,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style Git fill:#f5a623,stroke:#333
    style HuggingFace fill:#f5a623,stroke:#333
    style ModelEndpoint fill:#f5a623,stroke:#333
    style OCI fill:#f5a623,stroke:#333
    style HWProfile fill:#7ed321,stroke:#333
    style LocalQueue fill:#7ed321,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
