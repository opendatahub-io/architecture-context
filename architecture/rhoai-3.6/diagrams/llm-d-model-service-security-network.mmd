graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer token / mTLS"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: modelservice-system"]
        direction TB
        Controller["modelservice-controller-manager<br/>SA: modelservice-controller-manager<br/>runAsNonRoot, seccomp RuntimeDefault<br/>HTTP/2 disabled"]

        subgraph Ports["Exposed Ports"]
            HealthPort["8081/TCP HTTP<br/>healthz + readyz<br/>Unauthenticated"]
            MetricsPort["8443/TCP HTTPS<br/>metrics<br/>TokenReview + SAR"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS"]
    end

    subgraph ChildNS["CHILD RESOURCES (Per-Model Namespace)"]
        direction TB
        PrefillDeploy["Prefill Deployment"]
        DecodeDeploy["Decode Deployment"]
        EPP["EPP Deployment<br/>SA: per-model SA<br/>RoleBinding to EPP ClusterRole"]
        HTTPRouteCR["HTTPRoute"]
        InfPool["InferencePool (v1alpha2)"]
        InfModel["InferenceModel (v1alpha2)"]
    end

    subgraph Monitoring["MONITORING (Internal)"]
        Prometheus["Prometheus"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI
    K8sAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Watch notification<br/>SA token"| Controller
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CRUD: ModelService, Deployments,<br/>Services, HTTPRoutes,<br/>InferencePools, InferenceModels,<br/>RBAC, ConfigMaps"| K8sAPI

    Controller --- HealthPort
    Controller --- MetricsPort
    MetricsPort --- MetricsSvc

    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview + SAR<br/>metrics-reader ClusterRole"| MetricsSvc

    Controller -.->|"owns"| PrefillDeploy
    Controller -.->|"owns"| DecodeDeploy
    Controller -.->|"owns"| EPP
    Controller -.->|"owns"| HTTPRouteCR
    Controller -.->|"owns"| InfPool
    Controller -.->|"owns"| InfModel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef child fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef port fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class User external
    class K8sAPI controlplane
    class Controller operator
    class MetricsSvc operator
    class HealthPort,MetricsPort port
    class PrefillDeploy,DecodeDeploy,EPP,HTTPRouteCR,InfPool,InfModel child
    class Prometheus monitoring
