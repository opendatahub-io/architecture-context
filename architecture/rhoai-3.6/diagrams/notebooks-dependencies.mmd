graph LR
    Notebooks["Notebooks<br/>Container Image Factory"]

    %% AIPCC Base Image Dependencies
    subgraph AIPCCBases["AIPCC Base Images"]
        CPUBase["CPU el9.8:3.6.0"]
        CUDA13["CUDA 13.0 el9.8:3.6.0"]
        CUDA12["CUDA 12.9 el9.8:3.6.0"]
        ROCm714["ROCm 7.14 el9.8:3.6.0"]
    end

    Notebooks -->|"FROM base image"| CPUBase
    Notebooks -->|"FROM base image"| CUDA13
    Notebooks -->|"FROM base image"| CUDA12
    Notebooks -->|"FROM base image"| ROCm714

    %% Key External Dependencies (Frameworks)
    subgraph MLFrameworks["ML Frameworks"]
        PyTorch["PyTorch 2.13.0"]
        TensorFlow["TensorFlow 2.21.0+redhat"]
        ScikitLearn["scikit-learn 1.9.1"]
        Transformers["transformers 5.14.1"]
        LLMCompressor["llmcompressor 0.13.0"]
        TrustyAI["trustyai 0.6.4"]
    end

    Notebooks -->|"GPU variants"| PyTorch
    Notebooks -->|"TF variants"| TensorFlow
    Notebooks -->|"datascience variants"| ScikitLearn
    Notebooks -->|"pytorch variants"| Transformers
    Notebooks -->|"llmcompressor variants"| LLMCompressor
    Notebooks -->|"trustyai variant"| TrustyAI

    %% IDE/Notebook Dependencies
    subgraph IDETools["IDE / Notebook Tools"]
        JupyterLab["JupyterLab 4.6.3"]
        Elyra["odh-elyra 5.0.3"]
        Kale["odh-kale 2.2.0"]
        KFP["kfp 2.17.0"]
        MLflowLib["mlflow 3.16.0"]
        CodeFlareSDK["codeflare-sdk 0.39.1"]
    end

    Notebooks -->|"all Jupyter variants"| JupyterLab
    Notebooks -->|"pipeline support"| Elyra
    Notebooks -->|"pipeline compiler"| Kale
    Notebooks -->|"pipelines SDK"| KFP
    Notebooks -->|"experiment tracking"| MLflowLib
    Notebooks -->|"distributed computing"| CodeFlareSDK

    %% Internal Platform Dependencies
    subgraph InternalRHOAI["Internal RHOAI Platform"]
        WBOperator["Workbenches Operator<br/>(image consumer)"]
        Dashboard["ODH Dashboard<br/>(ImageStream consumer)"]
        DSP["Data Science Pipelines<br/>(runtime consumer)"]
    end

    WBOperator -->|"launches pods from"| Notebooks
    Dashboard -->|"reads ImageStreams from"| Notebooks
    DSP -->|"executes runtimes from"| Notebooks

    %% Build System Dependencies
    subgraph BuildSystem["Build System"]
        Konflux["Konflux Pipelines"]
        Cachi2["Cachi2 / Hermeto<br/>Hermetic Prefetch"]
    end

    Notebooks -->|"built by"| Konflux
    Konflux -->|"prefetches deps via"| Cachi2

    %% External Runtime Services
    subgraph RuntimeServices["Runtime Services (Egress)"]
        S3["S3 Storage"]
        HuggingFace["HuggingFace Hub"]
        GitRemotes["Git Remotes"]
    end

    Notebooks -.->|"runtime: datasets/models"| S3
    Notebooks -.->|"runtime: model downloads"| HuggingFace
    Notebooks -.->|"runtime: source control"| GitRemotes

