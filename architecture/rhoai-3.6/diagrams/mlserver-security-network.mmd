graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AuthLayer["AUTHENTICATION (Pod Sidecar)"]
        KRBAC["kube-rbac-proxy<br/>Validates OAuth/SA Tokens<br/>Fronts 8080 + 8081"]
    end

    subgraph Application["APPLICATION (KServe Pod)"]
        direction TB

        subgraph Servers["Server Layer"]
            REST["REST Server<br/>FastAPI/uvicorn<br/>8080/TCP HTTP<br/>No app-level TLS"]
            GRPC["gRPC Server<br/>grpc.aio<br/>8081/TCP gRPC<br/>add_insecure_port"]
            MetricsSvc["Metrics Server<br/>starlette-exporter<br/>8082/TCP HTTP<br/>No auth"]
        end

        subgraph Security["Security Layer"]
            TrustedRT["Runtime Security<br/>PRODUCTION mode<br/>trusted-runtimes.json<br/>Allowlist enforced"]
        end

        subgraph RuntimeLayer["ML Runtimes"]
            Runtimes["sklearn | xgboost | lightgbm<br/>onnx | mlflow | huggingface<br/>alibi-detect | alibi-explain<br/>catboost | mllib"]
        end
    end

    subgraph EgressSvc["EGRESS (Optional)"]
        OTLP["OTLP Collector<br/>gRPC<br/>insecure=True<br/>No auth"]
        Kafka["Kafka Brokers<br/>9092/TCP<br/>No encryption<br/>No auth"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES"]
        KServe["KServe Controller<br/>Pod lifecycle mgmt"]
        Prometheus["Prometheus<br/>Metrics scraping"]
        ModelStore["Model Storage<br/>PVC/S3<br/>/mnt/models"]
    end

    %% Flows
    Client -->|"REST 8080/TCP<br/>TLS (platform)<br/>OAuth/SA Token"| KRBAC
    Client -->|"gRPC 8081/TCP<br/>TLS (platform)<br/>OAuth/SA Token"| KRBAC
    KRBAC -->|"HTTP 8080<br/>No TLS (pod-local)<br/>Token validated"| REST
    KRBAC -->|"gRPC 8081<br/>No TLS (pod-local)<br/>Token validated"| GRPC

    REST --> TrustedRT
    GRPC --> TrustedRT
    TrustedRT --> Runtimes

    REST -.->|"gRPC<br/>insecure=True"| OTLP
    REST -.->|"TCP/9092<br/>No encryption"| Kafka

    Runtimes -->|"Filesystem<br/>/mnt/models"| ModelStore
    KServe -->|"K8s API"| Application
    Prometheus -->|"HTTP 8082<br/>No auth"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef server fill:#4a90e2,stroke:#357abd,stroke-width:2px,color:#fff
    classDef security fill:#e67e22,stroke:#d35400,stroke-width:2px,color:#fff
    classDef runtime fill:#7ed321,stroke:#5da018,stroke-width:2px,color:#fff
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class KRBAC auth
    class REST,GRPC,MetricsSvc server
    class TrustedRT security
    class Runtimes runtime
    class OTLP,Kafka egress
    class KServe,Prometheus,ModelStore platform
