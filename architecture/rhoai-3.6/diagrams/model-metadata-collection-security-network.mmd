graph TB
    subgraph BuildTime["BUILD-TIME ENVIRONMENT (CI/CD only)"]
        direction TB

        subgraph CLITools["CLI Tools (not deployed)"]
            Extractor["model-extractor<br/>Go CLI<br/>CGO_ENABLED=0"]
        end
    end

    subgraph ExternalAPIs["EXTERNAL APIs (Outbound, Build-time only)"]
        direction TB
        HF["HuggingFace API<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS (Go default)<br/>Auth: Bearer HF_TOKEN (optional)"]
        GH["GitHub API<br/>api.github.com<br/>443/TCP HTTPS<br/>TLS (Go default)<br/>Auth: Bearer GITHUB_TOKEN (optional)"]
        OCI["OCI Registries<br/>registry.redhat.io, quay.io<br/>443/TCP HTTPS<br/>TLS (containers/image default)<br/>Auth: Docker config credentials"]
    end

    subgraph Runtime["RUNTIME ENVIRONMENT (Kubernetes)"]
        direction TB

        subgraph DataPod["Data Container Pod"]
            DataContainer["odh-model-metadata-collection<br/>UBI9-minimal-pqc base<br/>CMD sleep infinity<br/>No ports exposed<br/>No RBAC required<br/>No network listeners"]
            DataVolume["/app/data/<br/>Read-only YAML catalogs"]
            DataContainer --- DataVolume
        end
    end

    subgraph Consumers["CONSUMER PODS (same namespace)"]
        Dashboard["RHOAI Dashboard<br/>Volume mount reader"]
        ModelCtrl["odh-model-controller<br/>Data reference reader"]
    end

    %% Build-time egress flows
    Extractor -->|"HTTPS/443<br/>TLS (Go default)<br/>Bearer token (optional)"| HF
    Extractor -->|"HTTPS/443<br/>TLS (Go default)<br/>Bearer token (optional)"| GH
    Extractor -->|"HTTPS/443<br/>TLS (containers/image)<br/>Docker config auth"| OCI

    %% Runtime data flows (no network)
    DataVolume -->|"Filesystem<br/>Volume mount<br/>No network"| Dashboard
    DataVolume -->|"Filesystem<br/>Data reference<br/>No network"| ModelCtrl

    %% Styling
    classDef buildtime fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef external fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef runtime fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef consumer fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef nonetwork fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,stroke-dasharray: 5 5

    class Extractor buildtime
    class HF,GH,OCI external
    class DataContainer,DataVolume runtime
    class Dashboard,ModelCtrl consumer
