graph LR
    Feast["Feast Operator<br/>(feast-operator)"]

    %% Internal Platform Dependencies (CRD Watch/CRUD)
    Feast -->|"CRD Watch<br/>inject config"| Notebooks["Kubeflow Notebooks<br/>(kubeflow.org)"]
    Feast -->|"CRD Watch<br/>experiment tracking"| MLflow["MLflow<br/>(mlflow.opendatahub.io)"]
    Feast -->|"CRD CRUD<br/>metrics scraping"| PromOperator["prometheus-operator<br/>(monitoring.coreos.com)"]
    Feast -->|"CRD CRUD<br/>external access"| Routes["OpenShift Routes<br/>(route.openshift.io)"]
    Feast -->|"CRD CRUD<br/>distributed materialization"| SparkOp["Spark Operator<br/>(sparkoperator.k8s.io)"]
    Feast -->|"API read<br/>TLS profile"| OSAPIServer["OpenShift APIServer<br/>(config.openshift.io)"]

    %% External Dependencies (runtime)
    Feast -->|"REST + Watch<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]
    Feast -->|"client connection<br/>online store"| Redis["Redis / Valkey"]
    Feast -->|"client connection<br/>online/offline store"| PostgreSQL["PostgreSQL"]
    Feast -->|"SDK client<br/>HTTPS/443"| S3["S3-compatible<br/>Storage"]
    Feast -.->|"SDK client<br/>HTTPS/443"| GCS["Google Cloud<br/>Storage"]

    %% Build / Framework Dependencies
    Feast -->|"operator framework"| CtrlRuntime["controller-runtime<br/>0.23.3"]
    Feast -->|"REST framework"| FastAPI["FastAPI<br/>>=0.68.0"]
    Feast -->|"gRPC transport"| gRPC["grpcio >=1.56.2<br/>google.golang.org/grpc 1.81.1"]

