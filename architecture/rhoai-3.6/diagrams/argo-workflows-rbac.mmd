graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Argo["argo<br/>(workflow-controller)"]
        SA_Server["argo-server<br/>(not deployed in RHOAI)"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB_Argo["argo-binding<br/>(all namespaces)"]
        CRB_Server["argo-server-binding<br/>(all namespaces)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Argo["argo-cluster-role"]
        CR_Server["argo-server-cluster-role"]
    end

    subgraph ArgoResources["argoproj.io Resources"]
        Workflows["Workflows<br/>+ finalizers"]
        CronWorkflows["CronWorkflows<br/>+ finalizers"]
        TaskSets["WorkflowTaskSets<br/>+ finalizers"]
        TaskResults["WorkflowTaskResults"]
        ArtifactGC["WorkflowArtifactGCTasks"]
        Templates["WorkflowTemplates<br/>+ finalizers"]
        ClusterTemplates["ClusterWorkflowTemplates<br/>+ finalizers"]
        EventBindings["WorkflowEventBindings"]
        EventSources["EventSources"]
        Sensors["Sensors"]
    end

    subgraph CoreResources["Core Resources"]
        Pods["Pods / Pods/exec"]
        PodsLog["Pods/log"]
        ConfigMaps["ConfigMaps"]
        PVCs["PersistentVolumeClaims<br/>+ finalizers"]
        ServiceAccts["ServiceAccounts"]
        Events["Events"]
        Secrets["Secrets"]
        PDBs["PodDisruptionBudgets"]
    end

    %% argo SA bindings
    SA_Argo -->|bound via| CRB_Argo
    CRB_Argo -->|grants| CR_Argo

    %% argo-cluster-role permissions
    CR_Argo -->|"get,list,watch,create,<br/>update,patch,delete"| Workflows
    CR_Argo -->|"get,list,watch,create,<br/>update,patch,delete"| TaskSets
    CR_Argo -->|"get,list,watch,create,<br/>update,patch,delete"| ArtifactGC
    CR_Argo -->|"get,list,watch,<br/>update,patch,delete"| CronWorkflows
    CR_Argo -->|"get,list,watch"| Templates
    CR_Argo -->|"get,list,watch"| ClusterTemplates
    CR_Argo -->|"list,watch,deletecollection"| TaskResults
    CR_Argo -->|"create,get,list,watch,<br/>update,patch,delete"| Pods
    CR_Argo -->|"get,watch,list"| ConfigMaps
    CR_Argo -->|"create,update,delete,get"| PVCs
    CR_Argo -->|"get,list"| ServiceAccts
    CR_Argo -->|"create,patch"| Events
    CR_Argo -->|"get<br/>(argo-workflows-agent-ca-certificates only)"| Secrets
    CR_Argo -->|"create,get,delete"| PDBs

    %% argo-server SA bindings
    SA_Server -->|bound via| CRB_Server
    CRB_Server -->|grants| CR_Server

    %% argo-server-cluster-role permissions
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| Workflows
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| CronWorkflows
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| Templates
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| ClusterTemplates
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| EventBindings
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| EventSources
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| Sensors
    CR_Server -->|"get,list,watch,delete"| Pods
    CR_Server -->|"get,list,watch"| PodsLog
    CR_Server -->|"get,watch,list"| ConfigMaps
    CR_Server -->|"get,create"| Secrets
    CR_Server -->|"watch,create,patch"| Events
    CR_Server -->|"get,list,watch"| ServiceAccts

    %% Styling
    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style SA_Server fill:#999,stroke:#666,color:#fff,stroke-dasharray: 5 5
    style CR_Argo fill:#f5a623,stroke:#333,color:#fff
    style CR_Server fill:#f5a623,stroke:#333,color:#fff
    style CRB_Argo fill:#ddd,stroke:#333
    style CRB_Server fill:#ddd,stroke:#333,stroke-dasharray: 5 5
    style Workflows fill:#7ed321,stroke:#333,color:#fff
    style CronWorkflows fill:#7ed321,stroke:#333,color:#fff
    style TaskSets fill:#7ed321,stroke:#333,color:#fff
    style TaskResults fill:#7ed321,stroke:#333,color:#fff
    style ArtifactGC fill:#7ed321,stroke:#333,color:#fff
    style Templates fill:#7ed321,stroke:#333,color:#fff
    style ClusterTemplates fill:#7ed321,stroke:#333,color:#fff
    style EventBindings fill:#7ed321,stroke:#333,color:#fff
    style EventSources fill:#7ed321,stroke:#333,color:#fff
    style Sensors fill:#7ed321,stroke:#333,color:#fff
