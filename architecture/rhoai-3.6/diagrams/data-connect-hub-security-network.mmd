graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["odh-gateway<br/>443/TCP<br/>TLS SIMPLE<br/>HTTPRoute"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph RESTPod["REST Service Pod"]
            KRBP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS (service-CA)<br/>SubjectAccessReview"]
            REST["rest-service<br/>8080/TCP HTTP<br/>actix-web / Rust<br/>rustls + aws-lc-rs"]
        end

        subgraph FlightPod["Flight Service Pod"]
            Flight["flight-service<br/>8443/TCP gRPC+TLS<br/>TLS (service-CA)<br/>TokenReview (configurable)<br/>tonic / Rust<br/>rustls + aws-lc-rs"]
        end

        subgraph ControllerPod["Controller Pod"]
            Controller["dc-controller<br/>8081/TCP health (no auth)<br/>8443/TCP metrics (HTTPS)<br/>Go / controller-runtime<br/>FIPS: strictfipsruntime"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token"]
        OSAPIServer["OpenShift APIServer<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token"]
        Prometheus["Prometheus<br/>9090/TCP HTTP<br/>ServiceMonitor"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (rustls)<br/>Password"]
        DataSources["Data Sources<br/>(Postgres, S3, Milvus,<br/>ES, Neo4j, SQLite, URI)<br/>Per-connector auth"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>TLS (configurable)"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Gateway

    %% Gateway to services
    Gateway -->|"HTTPS/8443<br/>TLS (service-CA)<br/>Bearer Token"| KRBP
    Gateway -->|"gRPC/8443<br/>TLS (service-CA)<br/>Bearer Token"| Flight

    %% kube-rbac-proxy to rest
    KRBP -->|"HTTP/8080<br/>localhost<br/>No encryption"| REST

    %% Auth calls
    KRBP -->|"HTTPS/6443<br/>SubjectAccessReview"| K8sAPI
    Flight -->|"HTTPS/6443<br/>TokenReview"| K8sAPI

    %% Controller calls
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| OSAPIServer
    Controller -->|"HTTPS/8443<br/>TLS (service-CA)"| REST

    %% Service calls
    REST -->|"gRPC/8443<br/>TLS (service-CA)<br/>SA Bearer"| Flight
    REST -->|"TCP/5432<br/>TLS (rustls)<br/>Password"| PostgreSQL
    REST -->|"HTTPS/6443<br/>SA Token"| K8sAPI
    Flight -->|"TCP/5432<br/>TLS (rustls)<br/>Password"| PostgreSQL
    Flight -->|"varies<br/>Per-connector"| DataSources
    Flight -->|"gRPC/4317<br/>TLS"| OTLP

    %% Metrics
    Prometheus -.->|"HTTP/9090<br/>scrape"| REST
    Prometheus -.->|"HTTP/9090<br/>scrape"| Flight

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class KRBP,REST,Flight,Controller internal
    class K8sAPI,OSAPIServer,Prometheus platform
    class PostgreSQL,DataSources,OTLP externalservice
