graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph IngressZone["INGRESS (Gateway)"]
        Gateway["Gateway / HTTPRoute<br/>443/TCP HTTPS<br/>TLS 1.2+ (cluster profile)<br/>Auth: Configurable"]
    end

    subgraph ControlPlane["CONTROL PLANE (Namespace: kserve)"]
        direction TB

        subgraph Controllers["Controllers"]
            Manager["kserve-controller-manager<br/>SA: kserve-controller-manager<br/>9443/TCP webhook"]
            KubeRBAC["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
            LLMCtrl["llmisvc-controller<br/>SA: llmisvc-sa<br/>8081/TCP health"]
            ModuleCtrl["kserve-module-controller<br/>SA: kserve-module-controller-manager<br/>8081/TCP health"]
            LocalCtrl["localmodel-controller<br/>SA: kserve-localmodel-controller-manager<br/>8081/TCP health"]
            NodeAgent["localmodelnode-agent<br/>SA: kserve-localmodelnode-agent<br/>8081/TCP health (per-node)"]
        end

        subgraph WebhookSvc["Webhook Service"]
            WebhookServer["kserve-webhook-server-service<br/>443/TCP HTTPS<br/>TLS: cert-manager<br/>Auth: Kubernetes admission"]
        end
    end

    subgraph DataPlaneZone["DATA PLANE (User Namespaces)"]
        ModelPod["Model Server Pod<br/>vLLM / OVMS / MLServer<br/>No built-in auth"]
        RouterSidecar["router sidecar<br/>TokenReview auth<br/>(InferenceGraph only)"]
        InitContainer["storage-initializer<br/>Init container"]
    end

    subgraph K8sAPIZone["KUBERNETES API"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount tokens"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes 8443/TCP<br/>via kube-rbac-proxy"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS TLS 1.2+<br/>Azure AD"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS TLS 1.2+<br/>Google OAuth"]
        HuggingFace["Hugging Face Hub<br/>443/TCP HTTPS TLS 1.2+<br/>API Token"]
        OCI["OCI Registries<br/>443/TCP HTTPS TLS 1.2+<br/>Registry Credentials"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway

    %% Ingress to Data Plane
    Gateway -->|"HTTP(S)<br/>Self-signed TLS (ODH)<br/>Configurable auth"| ModelPod

    %% Controllers to K8s API
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LLMCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LocalCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    NodeAgent -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% K8s API to Webhook
    K8sAPI -->|"HTTPS/443<br/>TLS (cert-manager)<br/>Admission auth"| WebhookServer

    %% Router auth
    RouterSidecar -->|"HTTPS/6443<br/>TokenReview<br/>SA token"| K8sAPI

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>kube-rbac-proxy"| KubeRBAC

    %% Storage egress
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>Cloud creds"| S3
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure AD"| Azure
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth"| GCS
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>API token"| HuggingFace
    InitContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry creds"| OCI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef dataplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8sapi fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class Manager,KubeRBAC,LLMCtrl,ModuleCtrl,LocalCtrl,NodeAgent,WebhookServer controlplane
    class ModelPod,RouterSidecar,InitContainer dataplane
    class K8sAPI k8sapi
    class Prometheus monitoring
    class S3,Azure,GCS,HuggingFace,OCI externalservice
