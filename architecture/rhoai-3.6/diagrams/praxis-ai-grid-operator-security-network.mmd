graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Admin / Site Operator"]
        Client["Inference Client"]
    end

    subgraph Ingress["INGRESS (Optional)"]
        EnrollRoute["OpenShift Route<br/>443/TCP<br/>TLS Passthrough"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (grid-system namespace)"]
        direction TB

        subgraph OperatorPod["Operator Pod (non-root 65532)"]
            OperatorBin["grid-operator<br/>readOnlyRootFilesystem<br/>seccomp: RuntimeDefault"]
            Metrics["Metrics/Health<br/>9090/TCP HTTP"]
            SWIMPort["SWIM Gossip<br/>7946/UDP<br/>AES-256-GCM"]
        end

        subgraph EnrollmentPod["Enrollment Pod"]
            EnrollBin["grid-enrollment<br/>8443/TCP HTTPS<br/>mTLS Required"]
        end

        subgraph GatewayPod["Gateway Pod"]
            GatewayBin["grid-gateway<br/>Praxis/Pingora<br/>mTLS for inter-site"]
            OverlaySyncBin["overlay-sync sidecar"]
        end

        OverlayCM["Routing Overlay<br/>ConfigMap"]
    end

    subgraph PeerSites["PEER SITES (Remote Clusters)"]
        RemoteOperator["Remote Operator<br/>7946/UDP"]
        RemoteGateway["Remote Gateway<br/>HTTPS mTLS"]
        RemoteSignals["Signal Endpoints<br/>HTTPS mTLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA Token Auth"]
        Postgres["Postgres<br/>5432/TCP<br/>TLS optional"]
        InferenceBackend["Inference Backends<br/>vLLM / llm-d / Cloud APIs<br/>HTTPS TLS 1.2+"]
        Prometheus["Prometheus<br/>9090/TCP HTTP"]
    end

    %% External flows
    Admin -->|"HTTPS/8443<br/>mTLS client cert"| EnrollBin
    Admin -->|"HTTPS/443<br/>TLS Passthrough"| EnrollRoute
    EnrollRoute -->|"HTTPS/8443<br/>mTLS"| EnrollBin
    Client -->|"HTTPS<br/>Bearer token"| GatewayBin

    %% Inter-site flows
    SWIMPort -->|"UDP/7946<br/>AES-256-GCM<br/>Shared key"| RemoteOperator
    GatewayBin -->|"HTTPS<br/>mTLS<br/>Grid certificate"| RemoteGateway
    OperatorBin -->|"HTTPS<br/>mTLS<br/>Grid certificate"| RemoteSignals

    %% Internal flows
    OperatorBin -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    OperatorBin -->|"Write"| OverlayCM
    OverlaySyncBin -->|"Watch"| OverlayCM
    OverlaySyncBin -->|"File write"| GatewayBin
    EnrollBin -->|"PostgreSQL/5432<br/>TLS optional<br/>Client cert/password"| Postgres
    GatewayBin -->|"HTTPS<br/>TLS 1.2+<br/>Injected credential"| InferenceBackend
    Prometheus -->|"HTTP/9090<br/>Scrape"| Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef peersite fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef configmap fill:#f5a623,stroke:#333

    class Admin,Client external
    class EnrollRoute ingress
    class OperatorBin,EnrollBin,GatewayBin,OverlaySyncBin,Metrics,SWIMPort internal
    class RemoteOperator,RemoteGateway,RemoteSignals peersite
    class K8sAPI,Postgres,InferenceBackend,Prometheus externalservice
    class OverlayCM configmap
