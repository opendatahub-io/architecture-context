graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["grid-operator<br/>(grid-system namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_CRD["grid-operator-crd<br/>(ClusterRoleBinding)"]
        RB_Resources_GS["grid-operator-resources<br/>(RoleBinding: grid-system)"]
        RB_Resources_D["grid-operator-resources<br/>(RoleBinding: default)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_CRD["grid-operator-crd"]
        CR_Resources["grid-operator-resources"]
    end

    subgraph CRDResources["grid.praxis.fast API Resources"]
        AGNGridNetworks["GridNetworks"]
        AGNGridSites["GridSites"]
        AGNInferenceProviders["InferenceProviders"]
        AGNAgentToolProviders["AgentToolProviders"]
        AGNStatuses["*/status"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["Secrets"]
        Services["Services<br/>(provider-gateway,<br/>grid-operator-swim,<br/>grid-operator-signals)"]
        ConfigMaps["ConfigMaps"]
        Events["Events<br/>(events.k8s.io)"]
    end

    %% Bindings
    SA -->|bound via| CRB_CRD
    SA -->|bound via| RB_Resources_GS
    SA -->|bound via| RB_Resources_D
    CRB_CRD -->|grants| CR_CRD
    RB_Resources_GS -->|grants| CR_Resources
    RB_Resources_D -->|grants| CR_Resources

    %% CRD permissions
    CR_CRD -->|"get, list, watch, patch"| AGNGridNetworks
    CR_CRD -->|"get, list, watch, patch,<br/>create, update, delete"| AGNGridSites
    CR_CRD -->|"get, list, watch, patch"| AGNInferenceProviders
    CR_CRD -->|"get, list, watch, patch"| AGNAgentToolProviders
    CR_CRD -->|"get, patch"| AGNStatuses

    %% Core resource permissions
    CR_Resources -->|"get, create, patch"| Secrets
    CR_Resources -->|"get"| Services
    CR_Resources -->|"get, create, patch, update"| ConfigMaps
    CR_Resources -->|"create, patch"| Events

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_CRD fill:#f5a623,stroke:#333
    style CR_Resources fill:#f5a623,stroke:#333
    style CRB_CRD fill:#e8e8e8,stroke:#333
    style RB_Resources_GS fill:#e8e8e8,stroke:#333
    style RB_Resources_D fill:#e8e8e8,stroke:#333
    style AGNGridNetworks fill:#7ed321,stroke:#333
    style AGNGridSites fill:#7ed321,stroke:#333
    style AGNInferenceProviders fill:#7ed321,stroke:#333
    style AGNAgentToolProviders fill:#7ed321,stroke:#333
    style AGNStatuses fill:#7ed321,stroke:#333
    style Secrets fill:#e74c3c,stroke:#333,color:#fff
    style Services fill:#3498db,stroke:#333,color:#fff
    style ConfigMaps fill:#3498db,stroke:#333,color:#fff
    style Events fill:#3498db,stroke:#333,color:#fff
