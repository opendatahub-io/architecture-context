graph TD
    subgraph AuthModel["Authentication & Authorization Model (Relay-Only — ADR 0002)"]
        direction TB

        subgraph BrowserLayer["Browser"]
            User["User (Browser)"]
        end

        subgraph ProxyLayer["Auth Proxy (oauth2-proxy)"]
            OIDC["OIDC Login Flow"]
            Session["Session Management"]
            TokenExtract["Token Extraction"]
        end

        subgraph BFFLayer["OpenShell Dashboard BFF"]
            AuthMW["Auth Middleware<br/>(relay-only)"]
            Note1["⛔ Never validates tokens<br/>⛔ Never runs OIDC flows<br/>⛔ Never makes authz decisions"]
        end

        subgraph GatewayLayer["OpenShell Gateway (Enforcement Point)"]
            JWTValidation["JWT Validation<br/>(OIDC JWKS)"]
            WorkspaceRBAC["Workspace RBAC<br/>(admin / user roles)"]
            MembershipCheck["Workspace Membership<br/>Check"]
            PlatformAdmin["Platform Admin Scope<br/>(cross-workspace ops)"]
        end
    end

    User -->|"OIDC session cookie"| OIDC
    OIDC --> Session
    Session --> TokenExtract
    TokenExtract -->|"x-forwarded-access-token: JWT<br/>x-auth-request-user: username"| AuthMW
    AuthMW -->|"Authorization: Bearer {JWT}<br/>(forwarded, not validated)"| JWTValidation
    JWTValidation -->|valid| WorkspaceRBAC
    WorkspaceRBAC --> MembershipCheck
    WorkspaceRBAC --> PlatformAdmin

    subgraph PublicEndpoints["Public Endpoints (No Auth)"]
        Config["/api/v1/auth/config<br/>Frontend bootstrap"]
        Health["/api/v1/healthz<br/>Liveness probe"]
        Ready["/api/v1/readyz<br/>Readiness probe"]
    end

    subgraph ProtectedEndpoints["Protected Endpoints (Bearer Required)"]
        WorkspaceOps["/api/v1/workspaces/**<br/>Workspace-scoped CRUD"]
        AdminOps["/api/v1/sandboxes, providers,<br/>templates, services<br/>Platform admin only"]
        GlobalOps["/api/v1/settings/global<br/>/api/v1/global-policy<br/>Platform admin only"]
    end

    MembershipCheck -->|"workspace member"| WorkspaceOps
    PlatformAdmin -->|"platform admin role"| AdminOps
    PlatformAdmin -->|"platform admin role"| GlobalOps

    style User fill:#4a90e2,color:#fff
    style OIDC fill:#f5a623,color:#fff
    style Session fill:#f5a623,color:#fff
    style TokenExtract fill:#f5a623,color:#fff
    style AuthMW fill:#e8e8e8,stroke:#999
    style Note1 fill:#ffcccc,stroke:#cc0000,color:#333
    style JWTValidation fill:#7ed321,color:#fff
    style WorkspaceRBAC fill:#7ed321,color:#fff
    style MembershipCheck fill:#7ed321,color:#fff
    style PlatformAdmin fill:#7ed321,color:#fff
    style Config fill:#ddd,stroke:#999
    style Health fill:#ddd,stroke:#999
    style Ready fill:#ddd,stroke:#999
    style WorkspaceOps fill:#d5e8d4,stroke:#82b366
    style AdminOps fill:#d5e8d4,stroke:#82b366
    style GlobalOps fill:#d5e8d4,stroke:#82b366
