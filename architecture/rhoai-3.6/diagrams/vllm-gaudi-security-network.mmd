graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Application"]
    end

    subgraph ServingRuntime["SERVING RUNTIME (KServe / ModelMesh)"]
        Gateway["KServe / Istio Gateway<br/>443/TCP → 8000/TCP<br/>TLS Termination<br/>Auth: Bearer / OAuth"]
    end

    subgraph Container["CONTAINER (vllm-gaudi)"]
        direction TB

        subgraph Server["vLLM OpenAI API Server"]
            API["API Endpoints<br/>8000/TCP HTTP<br/>No TLS / No Auth<br/>UID: 2000 (non-root)"]
        end

        subgraph Plugin["vllm-gaudi Plugin"]
            Platform["HpuPlatform"]
            Worker["HPUWorker"]
            Runner["HPUModelRunner"]
            Platform --> Worker
            Worker --> Runner
        end

        API --> Platform
    end

    subgraph Hardware["INTEL GAUDI ACCELERATOR"]
        HPU["Intel Gaudi HPU<br/>Gaudi 2 / Gaudi 3<br/>SynapseAI 1.23.0<br/>PyTorch 2.9.0"]
    end

    subgraph Distributed["INTER-WORKER (Multi-HPU)"]
        WorkerN["HPUWorker rank N<br/>HCCL / NIXL<br/>No encryption"]
    end

    subgraph EgressServices["EGRESS (Outbound)"]
        S3["Model Storage<br/>S3 / PVC<br/>HTTPS 443/TCP<br/>TLS 1.2+<br/>IAM / ServiceAccount"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>HTTPS 443/TCP<br/>TLS 1.2+<br/>Token (optional)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Gateway -->|"HTTP/8000<br/>No encryption<br/>No auth (delegated)"| API
    Runner -->|"PCIe / Habana<br/>Device driver"| HPU
    Worker -.->|"HCCL / NIXL<br/>No encryption<br/>Intra-node"| WorkerN
    Worker -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM"| S3
    Worker -->|"HTTPS/443<br/>TLS 1.2+<br/>Token"| HF

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef container fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef hardware fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef distributed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class API,Platform,Worker,Runner container
    class HPU hardware
    class WorkerN distributed
    class S3,HF egress
