graph TB
    subgraph KubeRBACProxy["kube-rbac-proxy Sidecar"]
        direction TB
        TLSTermination["TLS Termination<br/>TLS 1.2+ / FIPS"]
        PathFilter["Path Allow/Ignore Filter"]
        AuthN["Authentication Layer"]
        AuthZ["Authorization Chain"]
        HeaderInjection["Header Injection<br/>(x-remote-user, x-remote-groups)"]
        ProxyHandler["Reverse Proxy Handler"]
        AuditLog["OCSF 1.9.0 Audit Logger"]
        CertReloader["Certificate Hot-Reloader"]
        HealthCheck["/healthz Endpoint"]

        TLSTermination --> PathFilter
        PathFilter --> AuthN
        AuthN --> AuthZ
        AuthZ --> HeaderInjection
        HeaderInjection --> ProxyHandler
        ProxyHandler --> AuditLog
        CertReloader -.->|hot-reload certs| TLSTermination
    end

    subgraph AuthNMethods["Authentication Methods"]
        BearerToken["Bearer Token<br/>(Delegated TokenReview)"]
        ClientCert["Client TLS Certificate<br/>(CommonName extraction)"]
        OIDCJWT["OIDC JWT<br/>(Issuer validation)"]
    end

    subgraph AuthZChain["Authorization Chain"]
        HardcodedAuth["Hardcoded Authorizer<br/>(prometheus-k8s GET /metrics)"]
        StaticAuth["Static Authorizer<br/>(configured rules)"]
        SARAuth["SAR Authorizer<br/>(SubjectAccessReview)"]
    end

    subgraph Format2["Format2 Endpoint Authorization"]
        PathScoped["Path-Scoped Rules"]
        NamedCaptures["Named Captures ({tenant})"]
        WildcardSegments["Wildcard Segments (*)"]
        PerMethodSAR["Per-HTTP-Method SAR Mappings"]
    end

    Client["Client<br/>(e.g. Prometheus)"] -->|HTTPS 8443/TCP<br/>Bearer/mTLS/OIDC| TLSTermination

    AuthN --> BearerToken
    AuthN --> ClientCert
    AuthN --> OIDCJWT

    AuthZ --> HardcodedAuth
    AuthZ --> StaticAuth
    AuthZ --> SARAuth

    SARAuth -.-> Format2

    BearerToken -->|TokenReview| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    SARAuth -->|SubjectAccessReview| K8sAPI

    ProxyHandler -->|HTTP 8081/TCP<br/>localhost| Upstream["Upstream Service<br/>(e.g. metrics endpoint)"]

    TLSSecret["TLS Certificate Secret<br/>kubernetes.io/tls"] -.->|cert-manager| CertReloader

    style TLSTermination fill:#4a90e2,color:#fff
    style AuthN fill:#4a90e2,color:#fff
    style AuthZ fill:#4a90e2,color:#fff
    style ProxyHandler fill:#4a90e2,color:#fff
    style AuditLog fill:#4a90e2,color:#fff
    style CertReloader fill:#4a90e2,color:#fff
    style HealthCheck fill:#4a90e2,color:#fff
    style PathFilter fill:#4a90e2,color:#fff
    style HeaderInjection fill:#4a90e2,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Upstream fill:#e8e8e8,stroke:#333
    style Client fill:#f5a623,color:#fff
    style BearerToken fill:#7ed321,color:#fff
    style ClientCert fill:#7ed321,color:#fff
    style OIDCJWT fill:#7ed321,color:#fff
    style HardcodedAuth fill:#f5a623,color:#fff
    style StaticAuth fill:#f5a623,color:#fff
    style SARAuth fill:#f5a623,color:#fff
    style TLSSecret fill:#d0d0d0,stroke:#333
