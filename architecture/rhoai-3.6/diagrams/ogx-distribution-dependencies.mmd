graph LR
    OGX["OGX Distribution<br/>AI/ML API Server"]

    %% Required Dependencies
    OGX -->|"state storage<br/>5432/TCP"| PostgreSQL["PostgreSQL<br/>(required)"]
    OGX -->|"core runtime"| OGXCore["ogx v1.4.0+rhaiv.1<br/>(required)"]

    %% Build-Time Dependencies
    OGX -.->|"base image<br/>(build-time)"| AIPCC["AIPCC cpu-el9.8<br/>3.6.0-ea.2"]
    OGX -.->|"model artifacts<br/>(build-time)"| Modelcar["modelcar-redhatai<br/>ogx-distribution 3.0"]

    %% Inference Providers (Conditional)
    OGX -->|"LLM inference"| vLLM["vLLM<br/>HTTP/HTTPS"]
    OGX -->|"LLM inference"| OpenAI["OpenAI API"]
    OGX -->|"LLM inference"| Anthropic["Anthropic API"]
    OGX -->|"LLM inference"| AzureOAI["Azure OpenAI"]
    OGX -->|"LLM inference"| Bedrock["AWS Bedrock"]
    OGX -->|"LLM inference"| VertexAI["Google Vertex AI"]
    OGX -->|"LLM inference"| Watsonx["IBM watsonx"]
    OGX -->|"LLM inference"| Gemini["Google Gemini"]

    %% Vector Stores (Conditional)
    OGX -->|"vector ops"| MilvusDB["Milvus"]
    OGX -->|"vector ops"| PgVectorDB["PgVector"]
    OGX -->|"vector ops"| QdrantDB["Qdrant"]

    %% Search & File (Conditional)
    OGX -->|"web search"| BraveSearch["Brave Search"]
    OGX -->|"web search"| TavilySearch["Tavily Search"]
    OGX -->|"file storage"| S3["AWS S3"]
    OGX -->|"doc processing"| Docling["Docling Serve"]

    %% Auth
    OGX -.->|"token validation"| OIDC["OIDC Provider"]

    %% Internal Platform Dependencies
    OGXOp["ogx-operator"] -->|"deploys & manages"| OGX
    Prom["Prometheus"] -->|"scrapes metrics"| OGX
    PraxisProxy["Praxis Proxy"] -->|"identity headers"| OGX
    OGX -->|"traces"| OTelCol["OpenTelemetry<br/>Collector"]

    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
