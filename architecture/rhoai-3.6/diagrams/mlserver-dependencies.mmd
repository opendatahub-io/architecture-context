graph LR
    MLServer["MLServer<br/>V2 Inference Server"]

    %% Internal Platform Dependencies
    MLServer -->|"container runtime"| KServe["KServe Controller"]
    MLServer -->|"auth sidecar"| KRBAC["kube-rbac-proxy"]

    %% Core Framework Dependencies
    MLServer -->|"REST framework"| FastAPI["FastAPI >=0.134"]
    MLServer -->|"ASGI server"| Uvicorn["uvicorn"]
    MLServer -->|"gRPC framework"| gRPC["grpcio >=1.67"]
    MLServer -->|"serialization"| Protobuf["protobuf >=5.27"]
    MLServer -->|"validation"| Pydantic["pydantic ^2.7"]

    %% Data Dependencies
    MLServer -->|"array data"| NumPy["numpy"]
    MLServer -->|"dataframe data"| Pandas["pandas"]
    MLServer -->|"fast JSON"| Orjson["orjson"]

    %% Observability Dependencies
    MLServer -.->|"tracing"| OTEL["opentelemetry-sdk ^1.22"]
    MLServer -->|"REST metrics"| StarletteExp["starlette-exporter"]
    MLServer -->|"gRPC metrics"| GRPCProm["py-grpc-prometheus"]

    %% Optional Dependencies
    MLServer -.->|"async messaging"| Kafka["aiokafka"]
    MLServer -->|"batch processing"| Triton["tritonclient >=2.42"]
    MLServer -->|"concurrency"| Gevent["gevent"]

    %% Platform Integrations
    Prometheus["Prometheus"] -->|"scrapes metrics"| MLServer
    OTLPCol["OTLP Collector"] -.->|"receives traces"| MLServer

    %% Styling
    style MLServer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style KRBAC fill:#7ed321,stroke:#333,color:#fff
