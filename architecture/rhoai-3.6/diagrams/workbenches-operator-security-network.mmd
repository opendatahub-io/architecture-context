graph TB
    subgraph External["EXTERNAL (Cluster Internal Services)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (workbenches-operator-system)"]
        direction TB

        subgraph OperatorPod["Operator Pod"]
            Controller["workbenches-operator-<br/>controller-manager<br/>SA: workbenches-operator-<br/>controller-manager"]
            MetricsEP["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TLS (cluster profile)<br/>Auth: TokenReview + SAR"]
            HealthEP["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
            WebhookServer["Webhook Server<br/>:9443/TCP HTTPS<br/>TLS (service-CA / cert-manager)"]
        end

        WebhookSvc["workbenches-operator-<br/>webhook-service<br/>ClusterIP 443/TCP -> 9443"]
    end

    subgraph CertProviders["CERTIFICATE PROVIDERS"]
        ServiceCA["OpenShift service-CA<br/>(auto-rotate)"]
        CertMgr["cert-manager<br/>(non-OpenShift fallback)"]
    end

    subgraph Operands["OPERAND NAMESPACE (redhat-ods-applications)"]
        KFCtrl["Kubeflow Notebook<br/>Controller"]
        ODHCtrl["ODH Notebook<br/>Controller"]
        NotebookRes["Notebook Resources<br/>(RBAC, Services,<br/>NetworkPolicies)"]
    end

    subgraph UserNS["USER NAMESPACES"]
        NotebookCR["Notebook CRs<br/>(kubeflow.org/v1)"]
    end

    %% Flows
    Controller -->|"REST + Watch<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token (in-cluster)"| K8sAPI

    K8sAPI -->|"Admission webhook call<br/>443/TCP HTTPS<br/>TLS (service-CA)<br/>TLS client cert"| WebhookSvc
    WebhookSvc -->|"9443/TCP"| WebhookServer

    Prometheus -->|"GET /metrics<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>TokenReview + SAR"| MetricsEP

    ServiceCA -.->|"Provisions TLS cert<br/>(auto-rotation)"| WebhookServer
    CertMgr -.->|"Provisions TLS cert<br/>(fallback)"| WebhookServer

    Controller -->|"SSA apply manifests<br/>6443/TCP HTTPS"| K8sAPI
    K8sAPI -.->|"deploys"| KFCtrl
    K8sAPI -.->|"deploys"| ODHCtrl
    K8sAPI -.->|"deploys"| NotebookRes

    NotebookCR -.->|"CREATE/UPDATE<br/>triggers webhook"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cert fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operand fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef user fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class K8sAPI,Prometheus external
    class Controller,MetricsEP,HealthEP,WebhookServer,WebhookSvc operator
    class ServiceCA,CertMgr cert
    class KFCtrl,ODHCtrl,NotebookRes operand
    class NotebookCR user
