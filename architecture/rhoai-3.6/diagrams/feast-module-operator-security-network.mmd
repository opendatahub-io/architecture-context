graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph AppNS["Namespace: redhat-ods-applications"]
            FMO["feast-module-operator<br/>SA: opendatahub-feast-operator<br/>Image: UBI 9 ubi-minimal-pqc<br/>FIPS: strictfipsruntime + CGO"]

            subgraph Probes["Health Probes"]
                Healthz["/healthz<br/>8081/TCP HTTP<br/>No Auth"]
                Readyz["/readyz<br/>8081/TCP HTTP<br/>No Auth"]
            end

            subgraph MetricsEndpoint["Metrics Endpoint"]
                Metrics["/metrics<br/>8443/TCP HTTPS<br/>kube-rbac-proxy<br/>TokenReview + SAR"]
            end

            FMO --- Probes
            FMO --- MetricsEndpoint
        end

        subgraph DeployedNS["Deployed feast-operator Resources"]
            FeastOp["feast-operator<br/>Controller Manager<br/>0.66.0"]
            FeatureSrv["feature-server<br/>0.66.0"]
            CronJob["cron-job<br/>ose-cli (digest-pinned)"]
        end

        subgraph K8sControl["Control Plane"]
            APIServer["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph Monitoring["Monitoring (metrics-enabled namespaces)"]
            Prometheus["Prometheus<br/>ServiceMonitor"]
        end

        subgraph DelegatedAPIs["Delegated API Resources"]
            FeatureStore["feast.dev<br/>FeatureStore<br/>full CRUD"]
            Notebooks["kubeflow.org<br/>Notebooks<br/>read-only"]
            MLflowRes["mlflow.opendatahub.io<br/>MLflows<br/>read-only"]
            RoutesRes["route.openshift.io<br/>Routes<br/>CRUD"]
            SparkRes["sparkoperator.k8s.io<br/>SparkApplications<br/>get, create, delete"]
        end
    end

    subgraph NetworkPolicy["NetworkPolicy: allow-metrics-traffic"]
        NPRule["Ingress: port 8443<br/>From: namespaces with<br/>label metrics=enabled"]
    end

    %% Flows
    FMO -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>CRD watches, CRUD,<br/>leader election"| APIServer

    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview + SAR"| MetricsEndpoint

    FMO -->|"deploys & manages"| FeastOp
    FMO -->|"configures image"| FeatureSrv
    FMO -->|"configures image"| CronJob

    FeastOp -->|"CRUD via<br/>delegated RBAC"| FeatureStore
    FeastOp -->|"watch via<br/>delegated RBAC"| Notebooks
    FeastOp -->|"watch via<br/>delegated RBAC"| MLflowRes
    FeastOp -->|"CRUD via<br/>delegated RBAC"| RoutesRes
    FeastOp -->|"CRUD via<br/>delegated RBAC"| SparkRes

    NPRule -.->|"enforces"| MetricsEndpoint

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef probe fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef metrics fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef deployed fill:#9b59b6,stroke:#333,stroke-width:1px,color:#fff
    classDef delegated fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef netpol fill:#f5f5f5,stroke:#666,stroke-width:1px,stroke-dasharray:5 5

    class FMO operator
    class Healthz,Readyz probe
    class Metrics metrics
    class APIServer controlplane
    class FeastOp,FeatureSrv,CronJob deployed
    class FeatureStore,Notebooks,MLflowRes,RoutesRes,SparkRes delegated
    class Prometheus monitoring
    class NPRule netpol
