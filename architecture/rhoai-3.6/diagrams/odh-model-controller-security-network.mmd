graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
        DashCLI["Dashboard / CLI"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>Bearer / OIDC / SA token"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE"]
        direction TB

        subgraph ControllerPod["odh-model-controller Pod"]
            Controller["odh-model-controller<br/>SA: odh-model-controller<br/>Image: quay.io/opendatahub/odh-model-controller"]
            WebhookPort["Webhook: 9443/TCP<br/>HTTPS, TLS (service-ca)"]
            MetricsPort["Metrics: 8443/TCP<br/>HTTPS, TokenReview+SSAR"]
            HealthPort["Health: 8081/TCP<br/>HTTP, unauthenticated"]
        end

        subgraph APIPod["model-serving-api Pod"]
            APIServer["model-serving-api<br/>SA: model-serving-api<br/>Image: quay.io/opendatahub/odh-model-serving-api"]
            APIPort["API: 8443/TCP<br/>HTTPS, TLS 1.2+<br/>Bearer + SSAR"]
            APIMetrics["Metrics: 8080/TCP<br/>HTTP"]
        end
    end

    subgraph Services["SERVICES (ClusterIP)"]
        WebhookSvc["webhook-service<br/>443 → 9443<br/>HTTPS"]
        MetricsSvc["metrics-service<br/>8443 → 8443<br/>HTTPS"]
        APISvc["model-serving-api<br/>443 → 8443<br/>HTTPS"]
    end

    subgraph Egress["EGRESS"]
        OTel["OpenTelemetry Collector<br/>gRPC/OTLP<br/>Configured"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer/OIDC"| K8sAPI
    DashCLI -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token"| APISvc

    %% Admission flow
    K8sAPI -->|"HTTPS/443<br/>TLS (service-ca)<br/>Admission"| WebhookSvc
    WebhookSvc --> WebhookPort

    %% Controller to K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% API Server flows
    APISvc --> APIPort
    APIServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA + User token"| K8sAPI
    APIServer -->|"gRPC/OTLP<br/>Configured"| OTel

    %% Service routing
    MetricsSvc --> MetricsPort

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef egress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User,DashCLI external
    class K8sAPI controlplane
    class Controller,WebhookPort,MetricsPort,HealthPort,APIServer,APIPort,APIMetrics controller
    class WebhookSvc,MetricsSvc,APISvc service
    class OTel egress
