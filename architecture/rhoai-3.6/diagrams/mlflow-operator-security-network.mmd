graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph Ingress["INGRESS"]
        Gateway["data-science-gateway<br/>443/TCP → 8443/TCP<br/>TLS 1.2+<br/>Platform auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB
        Operator["mlflow-operator-controller-manager<br/>SA: mlflow-operator-controller-manager<br/>Probes: 8081/TCP HTTP<br/>Metrics: 8443/TCP HTTPS<br/>Auth: TokenReview + SAR"]
    end

    subgraph TargetNS["TARGET NAMESPACE (per MLflow CR)"]
        direction TB
        MLflow["MLflow Tracking Server<br/>8443/TCP HTTPS<br/>Uvicorn PROFILE=SYSTEM"]
        PVC["PVC<br/>(artifact storage)"]
        CronJobs["CronJobs<br/>(GC + Trace Archival)"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Cluster-Internal)"]
        direction TB
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        APIServer["OpenShift APIServer<br/>TLS Profile Config"]
        Prometheus["prometheus-operator<br/>ServiceMonitor"]
        Console["OpenShift Console<br/>ConsoleLink"]
        AuthCR["Auth CR<br/>Workspace Groups"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform auth"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS (service-ca)<br/>K8s auth"| MLflow

    %% Operator to K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% K8s API watches
    K8sAPI -->|"Watch events<br/>(MLflow, MLflowOperator,<br/>Namespace CRs)"| Operator

    %% Platform integrations (all via K8s API)
    Operator -.->|"reads TLS profile"| APIServer
    Operator -.->|"creates ServiceMonitors"| Prometheus
    Operator -.->|"creates ConsoleLinks"| Console
    Operator -.->|"watches Auth CR"| AuthCR

    %% Operator manages target namespace
    Operator -->|"creates/manages<br/>via K8s API"| MLflow
    Operator -->|"creates/manages"| PVC
    Operator -->|"creates/manages"| CronJobs

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef target fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Gateway ingress
    class Operator operator
    class MLflow,PVC,CronJobs target
    class K8sAPI,APIServer,Prometheus,Console,AuthCR platform
