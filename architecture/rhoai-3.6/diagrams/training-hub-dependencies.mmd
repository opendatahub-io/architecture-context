graph LR
    TrainingHub["Training Hub<br/>(Python Library + CLI)"]

    %% Core Dependencies (Required)
    TrainingHub -->|"SFT backend<br/>(torchrun)"| InstructLabTraining["InstructLab Training<br/>>=0.16.2"]
    TrainingHub -->|"OSFT backend<br/>(torchrun)"| MiniTrainer["Mini-Trainer<br/>>=0.8.3"]
    TrainingHub -->|"deep learning<br/>framework"| PyTorch["PyTorch<br/>>=2.6.0"]
    TrainingHub -->|"model loading<br/>tokenization"| Transformers["transformers<br/>>=4.57.6"]
    TrainingHub -->|"LoRA adapters"| PEFT["peft<br/>>=0.15"]
    TrainingHub -->|"distributed<br/>training"| Accelerate["accelerate<br/>>=0.34.2"]
    TrainingHub -->|"dataset loading"| Datasets["datasets<br/>>=4.0.0"]
    TrainingHub -->|"data validation"| Pydantic["pydantic<br/>>=2.7.0"]
    TrainingHub -->|"checkpoint<br/>storage"| Fsspec["fsspec<br/>>=2025.0"]

    %% Optional Dependencies
    TrainingHub -.->|"LoRA training<br/>(optional)"| Unsloth["Unsloth<br/>>=2026.1.1"]
    TrainingHub -.->|"TRL<br/>(optional)"| TRL["trl<br/>>=0.18.0"]
    TrainingHub -.->|"GRPO single-GPU<br/>(optional)"| ART["OpenPipe ART<br/>>=0.5.17"]
    TrainingHub -.->|"GRPO multi-GPU<br/>(optional)"| VeRL["verl<br/>>=0.7"]
    TrainingHub -.->|"LLM proxy<br/>(optional)"| LiteLLM["litellm<br/>>=1.71.1<br/>(excl. 1.82.7-8)"]
    TrainingHub -.->|"prompt optimization<br/>(optional)"| GEPA["gepa<br/>>=0.1.1"]
    TrainingHub -.->|"embedding SFT<br/>(optional)"| SentenceTransformers["sentence-transformers<br/>>=5.0"]
    TrainingHub -.->|"experiment tracking<br/>(optional)"| MLflow["mlflow<br/>>=3.5.0"]
    TrainingHub -.->|"S3 storage<br/>(optional)"| S3fs["s3fs<br/>>=2025.0"]
    TrainingHub -.->|"Flash Attention<br/>(optional, CUDA)"| FlashAttn["flash-attn<br/>>=2.8"]

    %% External Services
    TrainingHub -->|"model downloads<br/>HTTPS/443"| HuggingFace["HuggingFace Hub"]
    TrainingHub -.->|"checkpoint mirror<br/>HTTPS/443"| S3["S3-Compatible<br/>Storage"]
    TrainingHub -.->|"experiment tracking<br/>HTTPS/443"| WandB["Weights & Biases"]

    %% Internal Platform
    VeRL -.->|"multi-node<br/>scheduling"| Volcano["Volcano Scheduler"]

