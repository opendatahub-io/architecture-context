graph TB
    subgraph TrainingPod["TRAINING POD (Single-Tenant, Kubernetes Pod)"]
        direction TB

        subgraph Library["Training Hub Library (No Ingress)"]
            direction TB
            API["Python API / thub CLI"]
            Registry["AlgorithmRegistry"]
            API --> Registry
        end

        subgraph Backends["Algorithm Backends (In-Process / Subprocess)"]
            direction TB
            SFT["InstructLab Training<br/>(SFT, torchrun)"]
            OSFT["Mini-Trainer<br/>(OSFT, torchrun)"]
            LoRA["Unsloth<br/>(LoRA SFT, HF Trainer)"]
            ART["OpenPipe ART<br/>(LoRA GRPO, subprocess)"]
            VeRL["verl<br/>(GRPO, torchrun+Hydra)"]
            GEPA["gepa<br/>(prompt optimization)"]
            Embed["sentence-transformers<br/>(Embedding SFT)"]
        end

        subgraph CrossCutting["Cross-Cutting"]
            JIT["JIT Checkpoint<br/>(SIGTERM handler)"]
            CkptMgr["Checkpoint Manager<br/>(LIFO upload worker)"]
        end

        GPU["GPU Workers<br/>NCCL (GPU-direct)<br/>No encryption"]

        Registry --> SFT
        Registry --> OSFT
        Registry --> LoRA
        Registry --> ART
        Registry --> VeRL
        Registry --> GEPA
        Registry --> Embed

        SFT --> GPU
        OSFT --> GPU
        VeRL --> GPU
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress Only)"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
        OpenAI["OpenAI-Compatible API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (OPENAI_API_KEY)"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key (optional)"]
        MLflow["MLflow Tracking Server<br/>HTTP/HTTPS<br/>configurable port<br/>(optional)"]
    end

    %% Egress flows
    Library -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN (optional)"| HF
    CkptMgr -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS credentials<br/>(background upload)"| S3
    GEPA -->|"HTTPS/443<br/>TLS 1.2+<br/>OPENAI_API_KEY<br/>(via litellm)"| OpenAI
    Backends -.->|"HTTPS/443<br/>WANDB_API_KEY<br/>(optional)"| WandB
    Backends -.->|"HTTP(S)<br/>configurable<br/>(optional)"| MLflow

    %% Styling
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef backend fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef crosscut fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gpu fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class API,Registry library
    class SFT,OSFT,LoRA,ART,VeRL,GEPA,Embed backend
    class JIT,CkptMgr crosscut
    class GPU gpu
    class HF,S3,OpenAI,WandB,MLflow external
