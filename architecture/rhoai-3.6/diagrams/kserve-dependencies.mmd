graph LR
    KServe["KServe<br/>Model Serving Platform"]

    %% External Dependencies (Required)
    KServe -->|"traffic routing<br/>HTTPRoute CRUD"| GatewayAPI["Gateway API 1.5.1"]
    KServe -->|"TLS certificates<br/>CRD CRUD"| CertManager["cert-manager"]
    KServe -->|"event-driven autoscaling<br/>ScaledObject CRUD"| KEDA["KEDA 2.20.2"]
    KServe -->|"distributed inference<br/>LWS CRUD"| LWS["LeaderWorkerSet 0.8.0"]
    KServe -->|"load-balanced routing<br/>InferencePool CRUD"| InferenceExt["Gateway Inference<br/>Extension 1.5.0"]
    KServe -->|"cluster resource CRUD"| K8sAPI["Kubernetes API"]
    KServe -->|"TLS profile resolution"| OpenShiftConfig["OpenShift Config API"]
    KServe -->|"VirtualService CRUD<br/>(upstream path)"| Istio["Istio 1.27.1"]
    KServe -->|"serverless scaling<br/>(upstream path)"| Knative["Knative Serving 0.48.1"]

    %% Internal RHOAI Dependencies
    ODHOperator["ODH Operator"] -->|"creates Kserve CR"| KServe
    KServe -->|"TLS termination<br/>metrics auth"| KubeRBACProxy["kube-rbac-proxy"]
    KServe -->|"accelerator scheduling"| HWProfile["HardwareProfile CR"]
    KServe -->|"NIM account config"| NIMAccount["NIM Account CR"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes 8443/TCP<br/>via kube-rbac-proxy"| KServe
    KServe -->|"ServiceMonitor/PodMonitor<br/>CRD CRUD"| PromOperator["prometheus-operator 0.91.0"]
    KServe -->|"OpenTelemetryCollector<br/>CRD CRUD"| OTel["OpenTelemetry 0.152.0"]

    %% Storage / External Services
    KServe -->|"model download<br/>HTTPS/443"| S3["S3-compatible Storage"]
    KServe -->|"model download<br/>HTTPS/443"| Azure["Azure Blob Storage"]
    KServe -->|"model download<br/>HTTPS/443"| GCS["Google Cloud Storage"]
    KServe -->|"model download<br/>HTTPS/443"| HuggingFace["Hugging Face Hub"]
    KServe -->|"model download<br/>HTTPS/443"| OCI["OCI Registries"]
    KServe -.->|"model download<br/>Kerberos"| HDFS["HDFS"]

    %% Serving Runtimes (downstream)
    KServe -->|"serves models via"| vLLM["vLLM<br/>CUDA/ROCm/Gaudi/CPU/Spyre"]
    KServe -->|"serves models via"| OVMS["OVMS"]
    KServe -->|"serves models via"| MLServer["MLServer"]

