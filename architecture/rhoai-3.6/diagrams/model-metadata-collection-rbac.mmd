graph TD
    subgraph Component["model-metadata-collection"]
        DataContainer["Data Container<br/>(odh-model-metadata-collection)"]
    end

    subgraph NoRBAC["No RBAC Required"]
        direction TB
        Note1["No ClusterRoles defined"]
        Note2["No RoleBindings defined"]
        Note3["No ServiceAccount requirements"]
        Note4["No Kubernetes API interaction"]
        Note1 --- Note2
        Note2 --- Note3
        Note3 --- Note4
    end

    subgraph BuildCredentials["Build-Time Credentials (CI/CD Only)"]
        direction TB
        HFToken["HF_TOKEN<br/>HuggingFace API<br/>(env var, optional)"]
        GHToken["GITHUB_TOKEN<br/>GitHub API<br/>(env var, optional)"]
        DockerConfig["Docker Config<br/>~/.docker/config.json<br/>OCI registry auth"]
    end

    DataContainer -->|"no RBAC needed"| NoRBAC

    subgraph SecurityNotes["Security Notes"]
        S1["Data container has ZERO runtime<br/>network surface"]
        S2["No ports, no listeners,<br/>no Kubernetes Secrets"]
        S3["All auth is build-time only<br/>via CI/CD environment"]
        S1 --- S2
        S2 --- S3
    end

    BuildCredentials -.->|"used only during<br/>CI/CD build"| DataContainer

    style DataContainer fill:#4a90e2,stroke:#333,color:#fff
    style Note1 fill:#e8e8e8,stroke:#999
    style Note2 fill:#e8e8e8,stroke:#999
    style Note3 fill:#e8e8e8,stroke:#999
    style Note4 fill:#e8e8e8,stroke:#999
    style HFToken fill:#fff2cc,stroke:#d6b656
    style GHToken fill:#fff2cc,stroke:#d6b656
    style DockerConfig fill:#fff2cc,stroke:#d6b656
    style S1 fill:#d5e8d4,stroke:#82b366
    style S2 fill:#d5e8d4,stroke:#82b366
    style S3 fill:#d5e8d4,stroke:#82b366
