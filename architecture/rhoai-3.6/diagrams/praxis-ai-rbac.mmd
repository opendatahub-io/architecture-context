graph TD
    subgraph AppLevel["APPLICATION-LEVEL SECURITY (No Kubernetes RBAC)"]
        direction TB

        Note["Praxis AI is a standalone service, not a Kubernetes operator.<br/>Security enforcement is via the filter pipeline, not K8s RBAC."]

        subgraph SecurityFilters["Security Filter Chain"]
            CredInject["credential_inject<br/>(Security Filter)<br/>Injects upstream API keys/tokens"]
            PeerIdentity["peer_identity_trust<br/>(Security Filter)<br/>SPIFFE certificate digest verification"]
            StateOwner["state_owner<br/>(Security Filter)<br/>Scopes Responses API by identity"]
            IdentityGuard["identity_header_guard<br/>(Security Filter)<br/>Validates identity headers"]
            CalloutCreds["callout_credentials<br/>(Security Filter)<br/>Captures per-user credentials"]
            ProjectOwner["project_state_owner_headers<br/>(Security Filter)<br/>Projects ownership to downstream"]
        end

        subgraph Endpoints["Protected Endpoints"]
            AIRoutes["/v1/* AI API Routes<br/>Methods: POST, GET<br/>Auth: Bearer Token passthrough<br/>or credential_inject"]
            ProviderRoutes["Provider Routes<br/>Methods: POST<br/>Auth: peer_identity_trust<br/>SPIFFE cert digest"]
            AdminRoute["/healthy Admin<br/>Methods: GET<br/>Auth: None<br/>Localhost-only bind"]
        end

        subgraph Secrets["Secrets Management"]
            TLSCert["TLS Certificates<br/>Type: kubernetes.io/tls<br/>Purpose: Listener TLS termination<br/>Provisioned: External (cert-manager / manual)"]
            UpstreamCreds["Upstream Credentials<br/>Type: Opaque<br/>Purpose: Backend API keys<br/>Provisioned: Manual / external secret mgmt"]
            PGCerts["PostgreSQL TLS Certs<br/>Type: kubernetes.io/tls<br/>Purpose: mTLS to response store DB<br/>Provisioned: External"]
        end
    end

    %% Filter to endpoint mappings
    CredInject -->|"protects"| AIRoutes
    PeerIdentity -->|"protects"| ProviderRoutes
    StateOwner -->|"scopes access"| AIRoutes
    IdentityGuard -->|"validates"| AIRoutes

    %% Secret usage
    TLSCert -.->|"used by"| AIRoutes
    UpstreamCreds -.->|"injected by"| CredInject
    PGCerts -.->|"used by store"| StateOwner

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style CredInject fill:#f8cecc,stroke:#b85450
    style PeerIdentity fill:#f8cecc,stroke:#b85450
    style StateOwner fill:#f8cecc,stroke:#b85450
    style IdentityGuard fill:#f8cecc,stroke:#b85450
    style CalloutCreds fill:#f8cecc,stroke:#b85450
    style ProjectOwner fill:#f8cecc,stroke:#b85450
    style AIRoutes fill:#dae8fc,stroke:#6c8ebf
    style ProviderRoutes fill:#dae8fc,stroke:#6c8ebf
    style AdminRoute fill:#ffe6cc,stroke:#d79b00
    style TLSCert fill:#d5e8d4,stroke:#82b366
    style UpstreamCreds fill:#d5e8d4,stroke:#82b366
    style PGCerts fill:#d5e8d4,stroke:#82b366
