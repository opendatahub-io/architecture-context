    style Neo4rs fill:#e0e0e0,stroke:#999
    style OpenTelemetry fill:#e0e0e0,stroke:#999
    style GatewayAPI fill:#e0e0e0,stroke:#999
    style OSLibraryGo fill:#e0e0e0,stroke:#999

    %% Internal platform - green
    style ODHGateway fill:#7ed321,stroke:#333,color:#fff
    style PromOperator fill:#7ed321,stroke:#333,color:#fff
