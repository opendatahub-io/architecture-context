graph LR
    DCH["Data Connect Hub"]

    %% External Dependencies (build/runtime)
    DCH -->|"operator framework"| ControllerRuntime["controller-runtime 0.25.1"]
    DCH -->|"gRPC server"| Tonic["tonic 0.14"]
    DCH -->|"HTTP server"| ActixWeb["actix-web 4.14.0"]
    DCH -->|"columnar data"| Arrow["Arrow / Arrow-Flight 59.1.0"]
    DCH -->|"SQL toolkit"| SQLx["sqlx 0.8"]
    DCH -->|"TLS"| Rustls["rustls 0.23<br/>(aws-lc-rs)"]
    DCH -->|"K8s client (Rust)"| KubeCrate["kube 3.1.0"]
    DCH -->|"object storage"| OpenDAL["opendal 0.58"]
    DCH -->|"graph DB"| Neo4rs["neo4rs 0.8"]
    DCH -->|"tracing"| OpenTelemetry["opentelemetry 0.32"]
    DCH -->|"traffic routing"| GatewayAPI["gateway-api 1.3.0"]
    DCH -->|"TLS profiles"| OSLibraryGo["openshift/library-go"]

    %% Internal Platform Dependencies
    DCH -->|"HTTPRoute CRUD"| ODHGateway["odh-gateway<br/>(Gateway API)"]
    DCH -->|"ServiceMonitor CRUD"| PromOperator["prometheus-operator"]
    DCH -->|"TLS profile read"| OSAPIServer["OpenShift APIServer"]
    DCH -->|"ingress domain"| OSIngress["OpenShift Ingress"]
    DCH -->|"TLS certificates"| ServiceCA["OpenShift service-CA"]
    DCH -->|"REST authz sidecar"| KubeRBACProxy["kube-rbac-proxy"]

    %% Runtime Dependencies
    DCH -->|"metadata storage"| PostgreSQL["PostgreSQL 17+"]
    DCH -->|"resource mgmt<br/>auth (TokenReview,<br/>SubjectAccessReview)"| K8sAPI["Kubernetes API"]

    %% Data Source Dependencies
    DCH -->|"data ingestion"| PGSource["PostgreSQL<br/>(data source)"]
    DCH -->|"data ingestion"| S3["S3 Storage"]
    DCH -->|"data ingestion"| Milvus["Milvus"]
    DCH -->|"data ingestion"| ES["Elasticsearch"]
    DCH -->|"data ingestion"| Neo4jDB["Neo4j"]
    DCH -->|"data ingestion"| SQLiteDB["SQLite"]
    DCH -->|"data ingestion"| URIEndpoint["URI Endpoints"]
    DCH -.->|"trace export"| OTLPCollector["OTLP Collector"]

    %% Styling
    style DCH fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Build dependencies - grey
    style ControllerRuntime fill:#e0e0e0,stroke:#999
    style Tonic fill:#e0e0e0,stroke:#999
    style ActixWeb fill:#e0e0e0,stroke:#999
