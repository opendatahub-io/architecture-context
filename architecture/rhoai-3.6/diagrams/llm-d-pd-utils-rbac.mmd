graph TD
    subgraph "llm-d-pd-utils RBAC Model"
        direction TB

        Note["No ClusterRoles or RoleBindings<br/>defined by this component"]

        subgraph "Operator Prerequisites"
            OperatorSA["Operator ServiceAccount<br/>(or user kubeconfig)"]
        end

        subgraph "Required Permissions (Not Provisioned)"
            ExecPerm["pods/exec<br/>(target namespace)"]
            PodList["pods list/get<br/>(target namespace)"]
            ConfigMapPerm["configmaps create/get<br/>(target namespace)"]
        end

        subgraph "Pod Security Context (NIXL Benchmarks)"
            IPCLock["IPC_LOCK capability<br/>(RDMA memory registration)"]
            SysResource["SYS_RESOURCE capability<br/>(memory limits)"]
            GPURequest["nvidia.com/gpu: 1<br/>(GPU resource request)"]
            ShmVolume["shared memory volume<br/>(/dev/shm emptyDir)"]
        end
    end

    OperatorSA -->|"must have"| ExecPerm
    OperatorSA -->|"must have"| PodList
    OperatorSA -->|"must have"| ConfigMapPerm

    ExecPerm -->|"used by"| NetworkTests["llm-d-networking-tests<br/>(kubectl exec into pods)"]
    ExecPerm -->|"used by"| PreflightAccess["Preflight checks<br/>(kubectl exec curl /exit)"]
    ConfigMapPerm -->|"used by"| PreflightInject["Preflight injection<br/>(ConfigMap creation)"]

    IPCLock -->|"required by"| RoCEPods["RoCE benchmark pods<br/>(ibv_reg_mr)"]
    SysResource -->|"required by"| RoCEPods
    GPURequest -->|"required by"| AllBenchPods["All benchmark pods"]
    ShmVolume -->|"required by"| RoCEPods

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px,color:#856404
    style OperatorSA fill:#4a90e2,stroke:#333,color:#fff
    style ExecPerm fill:#f5a623,stroke:#333
    style PodList fill:#f5a623,stroke:#333
    style ConfigMapPerm fill:#f5a623,stroke:#333
    style IPCLock fill:#f8cecc,stroke:#b85450
    style SysResource fill:#f8cecc,stroke:#b85450
    style GPURequest fill:#f8cecc,stroke:#b85450
    style ShmVolume fill:#f8cecc,stroke:#b85450
