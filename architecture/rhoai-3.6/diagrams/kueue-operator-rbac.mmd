graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["openshift-kueue-operator<br/>(NS: openshift-kueue-operator)"]
        SA_Ctrl["kueue-controller-manager<br/>(NS: kueue-system)"]
        SA_Prom["prometheus-k8s<br/>(NS: monitoring)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Op["openshift-kueue-operator<br/>(ClusterRoleBinding)"]
        CRB_Mgr["kueue-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Metrics["kueue-metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Proxy["kueue-proxy-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_Leader["kueue-leader-election-rolebinding<br/>(NS: kueue-system)"]
        RB_Visibility["kueue-visibility-server-auth-reader<br/>(NS: kube-system)"]
        RB_Prom["prometheus-k8s<br/>(NS: system)"]
    end

    subgraph OperatorClusterRole["ClusterRole: openshift-kueue-operator"]
        OP_R1["kueue.openshift.io<br/>kueues, kueues/status, kueues/finalizers<br/>full CRUD"]
        OP_R2["apps<br/>deployments, replicasets<br/>full CRUD"]
        OP_R3["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>full CRUD + bind, escalate"]
        OP_R4["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations<br/>full CRUD"]
        OP_R5["apiextensions.k8s.io<br/>customresourcedefinitions<br/>full CRUD"]
        OP_R6["cert-manager.io<br/>issuers, certificates<br/>full CRUD"]
        OP_R7["core<br/>services, serviceaccounts, events,<br/>pods, secrets, configmaps<br/>full CRUD"]
        OP_R8["monitoring.coreos.com<br/>servicemonitors<br/>CRUD (no deletecollection)"]
        OP_R9["config.openshift.io<br/>infrastructures, apiservers<br/>get, list, watch"]
    end

    subgraph ManagerClusterRole["ClusterRole: kueue-manager-role"]
        MGR_R1["kueue.x-k8s.io<br/>admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads<br/>full CRUD"]
        MGR_R2["batch<br/>jobs<br/>get, list, patch, update, watch"]
        MGR_R3["kubeflow.org<br/>mpijobs, paddlejobs, pytorchjobs,<br/>tfjobs, xgboostjobs<br/>get, list, patch, update, watch"]
        MGR_R4["ray.io<br/>rayclusters, rayjobs<br/>get, list, patch, update, watch"]
        MGR_R5["workload.codeflare.dev<br/>appwrappers<br/>get, list, patch, update, watch"]
        MGR_R6["jobset.x-k8s.io<br/>jobsets<br/>get, list, patch, update, watch"]
        MGR_R7["core<br/>pods, secrets, events, podtemplates<br/>varies"]
    end

    subgraph MetricsRole["ClusterRole: kueue-metrics-reader"]
        MET_R1["/metrics<br/>get"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles"]
        AdminRole["kueue-batch-admin-role<br/>Aggregates editor + viewer roles"]
        UserRole["kueue-batch-user-role<br/>Aggregates viewer roles"]
    end

    subgraph NetworkingRole["ClusterRole: openshift-kueue-operator-networking"]
        NET_R1["networking.k8s.io<br/>networkpolicies<br/>create, delete, get, list,<br/>patch, update, watch"]
    end

    %% Bindings
    SA_Op -->|bound via| CRB_Op
    CRB_Op -->|grants| OperatorClusterRole

    SA_Ctrl -->|bound via| CRB_Mgr
    CRB_Mgr -->|grants| ManagerClusterRole

    SA_Ctrl -->|bound via| CRB_Metrics
    SA_Ctrl -->|bound via| CRB_Proxy
    SA_Ctrl -->|bound via| RB_Leader
    SA_Ctrl -->|bound via| RB_Visibility

    SA_Prom -->|bound via| RB_Prom

    CRB_Metrics -->|grants| MetricsRole

