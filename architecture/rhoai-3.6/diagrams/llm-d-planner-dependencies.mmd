graph LR
    Planner["llm-d-planner<br/>(FastAPI + Streamlit)"]

    %% External Dependencies (Required)
    Planner -->|"runtime"| Python["Python >=3.11"]
    Planner -->|"API framework"| FastAPI["FastAPI >=0.141.1"]
    Planner -->|"ASGI server"| Uvicorn["Uvicorn >=0.52.1"]
    Planner -->|"validation"| Pydantic["Pydantic >=2.13.4"]
    Planner -->|"YAML templates"| Jinja2["Jinja2 >=3.1.6"]
    Planner -->|"UI framework"| Streamlit["Streamlit >=1.61.1"]

    %% External Dependencies (Optional)
    Planner -.->|"LLM client"| OpenAILib["openai >=3.1.0"]
    Planner -.->|"LLM client"| AnthropicLib["anthropic >=0.122.0"]
    Planner -.->|"LLM client"| OllamaLib["ollama >=0.6.2"]
    Planner -.->|"cluster ops"| K8sClient["kubernetes >=36.0.3"]
    Planner -.->|"model lookups"| HFHubLib["huggingface-hub >=1.26.0"]
    Planner -.->|"model analysis"| Transformers["transformers >=5.14.1"]

    %% Internal Platform Dependencies
    Planner -->|"GPU detection<br/>6443/TCP"| K8sAPI["Kubernetes API"]
    Planner -->|"deployment target"| KServe["KServe<br/>(InferenceService CRD)"]
    Planner -->|"benchmarks<br/>8443/TCP"| ModelCatalog["RHOAI Model Catalog"]
    Planner -->|"CA trust"| ServiceCA["OpenShift Service CA"]

    %% External Service Dependencies
    Planner -->|"model configs<br/>443/TCP"| HFHub["HuggingFace Hub"]
    Planner -->|"quality data<br/>443/TCP"| Arena["LMSYS Arena API"]
    Planner -->|"quality data<br/>443/TCP"| AAAPI["Artificial Analysis API"]
    Planner -.->|"LLM inference<br/>443/TCP"| OpenAISvc["OpenAI API"]
    Planner -.->|"LLM inference<br/>443/TCP"| VertexSvc["Vertex AI"]

    %% Local Dependencies
    Planner -->|"intent extraction<br/>11434/TCP"| Ollama["Ollama (Sidecar)"]

    %% Styling
    style Planner fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required libraries
    style Python fill:#7ed321,stroke:#333
    style FastAPI fill:#7ed321,stroke:#333
    style Uvicorn fill:#7ed321,stroke:#333
    style Pydantic fill:#7ed321,stroke:#333
    style Jinja2 fill:#7ed321,stroke:#333
    style Streamlit fill:#7ed321,stroke:#333

    %% Optional libraries
    style OpenAILib fill:#c8e6c9,stroke:#333
    style AnthropicLib fill:#c8e6c9,stroke:#333
    style OllamaLib fill:#c8e6c9,stroke:#333
    style K8sClient fill:#c8e6c9,stroke:#333
    style HFHubLib fill:#c8e6c9,stroke:#333
    style Transformers fill:#c8e6c9,stroke:#333

    %% Platform services
    style K8sAPI fill:#dae8fc,stroke:#6c8ebf
    style KServe fill:#dae8fc,stroke:#6c8ebf
    style ModelCatalog fill:#dae8fc,stroke:#6c8ebf
    style ServiceCA fill:#dae8fc,stroke:#6c8ebf

    %% External services
    style HFHub fill:#f5a623,stroke:#333
    style Arena fill:#f5a623,stroke:#333
    style AAAPI fill:#f5a623,stroke:#333
    style OpenAISvc fill:#fff2cc,stroke:#333
    style VertexSvc fill:#fff2cc,stroke:#333

    %% Local
    style Ollama fill:#4a90e2,stroke:#333,color:#fff
