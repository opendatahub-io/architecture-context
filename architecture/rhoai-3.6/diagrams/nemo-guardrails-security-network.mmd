graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM (Network Policy Enforced)"]
        direction TB
        subgraph ServiceNS["Namespace: guardrails"]
            Server["NeMo Guardrails Server<br/>8000/TCP HTTP<br/>User: 1001<br/>Image: odh-nemo-guardrails-rhel9"]
        end
    end

    subgraph ExternalLLM["EXTERNAL LLM SERVICES"]
        LLM["OpenAI-compatible LLM<br/>443/TCP HTTPS<br/>TLS"]
        AzureLLM["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS"]
    end

    subgraph ExternalSaaS["EXTERNAL GUARDRAIL SERVICES (Optional)"]
        ActiveFence["ActiveFence<br/>443/TCP HTTPS"]
        AIDefense["NVIDIA AI Defense<br/>443/TCP HTTPS"]
        Pangea["Pangea<br/>443/TCP HTTPS"]
        Patronus["Patronus AI<br/>443/TCP HTTPS"]
        CrowdStrike["CrowdStrike<br/>443/TCP HTTPS"]
        F5SaaS["F5<br/>443/TCP HTTPS"]
        Fiddler["Fiddler<br/>443/TCP HTTPS"]
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        OTelCollector["OpenTelemetry Collector<br/>Configurable port<br/>gRPC or HTTP<br/>TLS (configurable)"]
    end

    %% Flows
    Client -->|"HTTP/8000<br/>Platform-provided encryption<br/>Bearer Token (optional)"| Server
    Server -->|"HTTPS/443<br/>TLS (HTTPTLSConfig)<br/>Bearer Token / API Key"| LLM
    Server -->|"HTTPS/443<br/>TLS<br/>AZURE_OPENAI_API_KEY"| AzureLLM
    Server -.->|"HTTPS/443<br/>TLS<br/>ACTIVEFENCE_API_KEY"| ActiveFence
    Server -.->|"HTTPS/443<br/>TLS<br/>AI_DEFENSE_API_KEY"| AIDefense
    Server -.->|"HTTPS/443<br/>TLS<br/>PANGEA_API_TOKEN"| Pangea
    Server -.->|"HTTPS/443<br/>TLS<br/>PATRONUS_API_KEY"| Patronus
    Server -.->|"HTTPS/443<br/>TLS<br/>CS_AIDR_TOKEN"| CrowdStrike
    Server -.->|"HTTPS/443<br/>TLS<br/>F5_GUARDRAILS_API_KEY"| F5SaaS
    Server -.->|"HTTPS/443<br/>TLS<br/>FIDDLER_API_KEY"| Fiddler
    Server -.->|"OTLP<br/>TLS (configurable)<br/>No auth"| OTelCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef saas fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef observability fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Server platform
    class LLM,AzureLLM externalservice
    class ActiveFence,AIDefense,Pangea,Patronus,CrowdStrike,F5SaaS,Fiddler saas
    class OTelCollector observability
