graph LR
    TrustyAI["TrustyAI Explainability"]

    %% External Dependencies
    TrustyAI -->|"app framework"| Quarkus["Quarkus 3.20.6.2"]
    TrustyAI -->|"reactive HTTP"| Vertx["Vert.x 4.5.32"]
    TrustyAI -->|"network transport"| Netty["Netty 4.1.125.Final"]
    TrustyAI -->|"gRPC serialization"| Protobuf["Protobuf 3.25.5"]
    TrustyAI -->|"JSON processing"| Jackson["Jackson 2.15.0"]
    TrustyAI -->|"data exchange"| Arrow["Apache Arrow"]
    TrustyAI -->|"metrics export"| Micrometer["Micrometer /<br/>Prometheus"]
    TrustyAI -->|"constraint solving"| OptaPlanner["OptaPlanner 8.30.0"]

    %% Optional External Dependencies
    TrustyAI -.->|"DB storage"| Hibernate["Hibernate ORM"]
    TrustyAI -.->|"object storage"| MinIOClient["MinIO Client 3.8.6"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"inference payloads"| ModelMesh["ModelMesh"]
    TrustyAI -->|"inference events"| KServe["KServe"]
