    %% External Services
    TrustyAI -->|"model storage"| MinIOSvc["MinIO Storage"]
    TrustyAI -->|"data storage"| MariaDB["MariaDB / MySQL"]
    TrustyAI -->|"API server"| K8sAPI["Kubernetes API<br/>(ConfigMap CRUD)"]

