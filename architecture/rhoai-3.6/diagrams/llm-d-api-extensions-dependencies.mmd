graph LR
    LlmDApiExt["llm-d-api-extensions<br/>(vLLM Plugin Library)"]

    %% External Dependencies (required)
    LlmDApiExt -->|"endpoint_plugins entry point<br/>worker-extension-cls"| vLLM["vLLM<br/>(host inference server)"]
    LlmDApiExt -->|"HTTP route registration"| FastAPI["FastAPI"]
    LlmDApiExt -->|"response schema validation"| Pydantic["Pydantic >=2"]
    LlmDApiExt -->|"build system"| Setuptools["setuptools >=68.0"]

    %% Test Dependencies
    LlmDApiExt -.->|"test"| Pytest["pytest"]
    LlmDApiExt -.->|"test"| PytestAsyncio["pytest-asyncio"]
    LlmDApiExt -.->|"test"| HTTPX["httpx"]

    %% Internal Platform Dependencies
    vLLM -->|"provides VllmConfig,<br/>EngineClient, workers"| LlmDApiExt

    %% Consumers
    Gateway["llm-d Gateway/Router"] -->|"HTTP GET 8000/TCP<br/>routing/scheduling decisions"| LlmDApiExt

    %% Styling
    style LlmDApiExt fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style vLLM fill:#999,stroke:#333,color:#fff
    style FastAPI fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style Setuptools fill:#999,stroke:#333,color:#fff
    style Pytest fill:#ccc,stroke:#999,stroke-dasharray: 5 5
    style PytestAsyncio fill:#ccc,stroke:#999,stroke-dasharray: 5 5
    style HTTPX fill:#ccc,stroke:#999,stroke-dasharray: 5 5
    style Gateway fill:#7ed321,stroke:#333,color:#fff
