graph TB
    subgraph UserZone["USER WORKSTATION"]
        User["oc adm must-gather CLI<br/>or kubectl apply job.yaml"]
    end

    subgraph Registry["CONTAINER REGISTRY"]
        RegRHIO["registry.redhat.io<br/>443/TCP HTTPS TLS<br/>Pull secret auth"]
    end

    subgraph ClusterBoundary["KUBERNETES CLUSTER"]
        direction TB

        subgraph MustGatherPod["MUST-GATHER POD (Ephemeral)"]
            direction TB
            Container["must-gather Container<br/>SA: must-gather-sa (xKS)<br/>Image: odh-must-gather-rhel9:v3.6.0<br/>Crypto: DEFAULT:PQ"]

            subgraph Tools["Bundled Tools"]
                OC["oc CLI"]
                Kubectl["kubectl v1.33.3"]
                Helm["helm v4.1.4"]
            end

            Container --- Tools
        end

        subgraph APIServer["KUBERNETES API SERVER"]
            K8sAPI["kube-apiserver<br/>443/TCP HTTPS TLS<br/>TokenReview auth"]
        end

        subgraph CollectedResources["RESOURCES READ (read-only)"]
            direction TB
            Platform["Platform CRs<br/>DSCI, DSC, Webhooks"]
            ComponentCRDs["Component CRDs<br/>16 RHOAI components"]
            LLMDDeps["LLM-D Dependencies<br/>cert-manager, Sail, LWS"]
            Monitoring["Monitoring<br/>ServiceMonitor, PodMonitor"]
        end
    end

    subgraph OutputZone["OUTPUT"]
        Archive["/must-gather/<br/>YAML, logs, events,<br/>Helm values"]
    end

    %% Flows
    User -->|"Spawn pod / Create job<br/>kubeconfig auth"| MustGatherPod
    RegRHIO -.->|"Image pull<br/>443/TCP HTTPS TLS<br/>Pull secret"| MustGatherPod
    Container -->|"HTTPS/443<br/>TLS (DEFAULT:PQ)<br/>ServiceAccount token<br/>GET, LIST, WATCH"| K8sAPI
    K8sAPI -->|"Read-only responses"| Platform
    K8sAPI -->|"Read-only responses"| ComponentCRDs
    K8sAPI -->|"Read-only responses"| LLMDDeps
    K8sAPI -->|"Read-only responses"| Monitoring
    Container -->|"Write collected data"| Archive
    Archive -->|"oc rsync (OCP)<br/>kubectl cp (xKS)"| User

    %% Styling
    classDef userzone fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef registry fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef resources fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef output fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User userzone
    class RegRHIO registry
    class Container,OC,Kubectl,Helm pod
    class K8sAPI apiserver
    class Platform,ComponentCRDs,LLMDDeps,Monitoring resources
    class Archive output
