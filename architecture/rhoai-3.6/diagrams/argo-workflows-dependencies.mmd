graph LR
    ArgoWF["Argo Workflows<br/>workflow-controller + argoexec"]

    %% Internal RHOAI Dependencies
    DSP["Data Science Pipelines"] -->|creates Workflow CRs| ArgoWF

    %% Infrastructure Dependencies
    ArgoWF -->|"CRD CRUD, Pod lifecycle<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    ArgoWF -->|leader election| K8sLease["Kubernetes Lease"]

    %% Artifact Storage Backends
    ArgoWF -->|"artifact upload/download<br/>443/TCP HTTPS"| S3["S3 / MinIO"]
    ArgoWF -.->|"artifact storage<br/>443/TCP HTTPS"| GCS["Google Cloud Storage"]
    ArgoWF -.->|"artifact storage<br/>443/TCP HTTPS"| AzureBlob["Azure Blob Storage"]
    ArgoWF -.->|"artifact storage"| OSS["Alibaba OSS"]
    ArgoWF -.->|"artifact storage"| HDFS["HDFS"]

    %% Optional Dependencies
    ArgoWF -.->|"workflow archiving<br/>5432 or 3306/TCP"| ArchiveDB["PostgreSQL / MySQL"]
    ArgoWF -.->|"SSO auth<br/>443/TCP HTTPS"| OIDC["OIDC Provider"]
    ArgoWF -.->|"event triggers<br/>CRD integration"| ArgoEvents["Argo Events"]

    %% Build Dependencies
    ArgoWF -.->|"FIPS crypto"| GoFIPS["Go 1.26<br/>FIPS 140-3 v1.0.0"]
    ArgoWF -.->|"base image"| UBI9["UBI 9 minimal-pqc"]

    %% Styling
    style ArgoWF fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style DSP fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style K8sLease fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style GCS fill:#f5a623,stroke:#333,color:#fff
    style AzureBlob fill:#f5a623,stroke:#333,color:#fff
    style OSS fill:#f5a623,stroke:#333,color:#fff
    style HDFS fill:#f5a623,stroke:#333,color:#fff
    style ArchiveDB fill:#f5a623,stroke:#333,color:#fff
    style OIDC fill:#f5a623,stroke:#333,color:#fff
    style ArgoEvents fill:#999,stroke:#333,color:#fff
    style GoFIPS fill:#ddd,stroke:#333
    style UBI9 fill:#ddd,stroke:#333
