graph TB
    subgraph OVMS["OpenVINO Model Server"]
        direction TB

        subgraph Frontends["API Frontends"]
            DrogonHTTP["Drogon HTTP Server<br/>(REST API)"]
            GRPCServer["gRPC Server Module"]
        end

        subgraph APIHandlers["API Handlers"]
            TFSFrontend["TFS Frontend<br/>/v1/* endpoints"]
            KServeFrontend["KServe Frontend<br/>/v2/* endpoints"]
            OpenAIHandler["OpenAI API Handler<br/>/v3/v1/* endpoints"]
        end

        subgraph InferenceEngine["Inference Engine"]
            ModelManager["Model Manager<br/>(versioning, hot-reload)"]
            DAGScheduler["DAG Scheduler<br/>(multi-model pipelines)"]
            MediaPipeExec["MediaPipe Graph Executor<br/>(GenAI: LLM, embeddings, rerank,<br/>image gen, speech)"]
        end

        subgraph Storage["Storage Backends"]
            FSBackends["Filesystem Backends<br/>(local, S3, GCS, Azure)"]
            HFPull["HuggingFace Pull Module<br/>(libgit2 + curl)"]
        end

        MetricModule["Metric Module<br/>(/metrics)"]
        CAPI["C API<br/>(libovms_shared.so)"]
    end

    NginxSidecar["nginx-mtls-auth<br/>(optional sidecar)"]

    %% Frontend routing
    DrogonHTTP --> TFSFrontend
    DrogonHTTP --> KServeFrontend
    DrogonHTTP --> OpenAIHandler
    DrogonHTTP --> MetricModule
    GRPCServer --> TFSFrontend
    GRPCServer --> KServeFrontend

    %% API to inference
    TFSFrontend --> ModelManager
    KServeFrontend --> ModelManager
    OpenAIHandler --> MediaPipeExec
    ModelManager --> DAGScheduler

    %% Model loading
    ModelManager --> FSBackends
    ModelManager --> HFPull

    %% External dependencies
    NginxSidecar -->|mTLS termination| DrogonHTTP

    Client[External Client] -->|REST / gRPC| NginxSidecar
    Client -->|REST / gRPC| DrogonHTTP
    Client -->|gRPC| GRPCServer

    KServeCtrl[KServe Controller] -->|manages lifecycle via<br/>ServingRuntime CRD| OVMS
    Prometheus[Prometheus] -->|scrapes /metrics| MetricModule

    FSBackends -->|HTTPS/443| S3["S3 Storage"]
    FSBackends -->|HTTPS/443| GCS["Google Cloud Storage"]
    FSBackends -->|HTTPS/443| Azure["Azure Blob Storage"]
    HFPull -->|HTTPS/443| HFHub["HuggingFace Hub"]

    %% Styling
    style OVMS fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style DrogonHTTP fill:#4a90e2,color:#fff
    style GRPCServer fill:#4a90e2,color:#fff
    style TFSFrontend fill:#5ba3f5,color:#fff
    style KServeFrontend fill:#5ba3f5,color:#fff
    style OpenAIHandler fill:#5ba3f5,color:#fff
    style ModelManager fill:#7ed321
    style DAGScheduler fill:#7ed321
    style MediaPipeExec fill:#7ed321
    style FSBackends fill:#f5a623
    style HFPull fill:#f5a623
    style MetricModule fill:#9b59b6,color:#fff
    style CAPI fill:#9b59b6,color:#fff
    style NginxSidecar fill:#e67e22,color:#fff
    style KServeCtrl fill:#999,color:#fff
    style Prometheus fill:#999,color:#fff
    style S3 fill:#fff2cc,stroke:#d6b656
    style GCS fill:#fff2cc,stroke:#d6b656
    style Azure fill:#fff2cc,stroke:#d6b656
    style HFHub fill:#fff2cc,stroke:#d6b656
