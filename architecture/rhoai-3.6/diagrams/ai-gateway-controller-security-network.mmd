graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
        LLMProvider["External LLM Provider<br/>(OpenAI, Azure, etc.)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        EnvoyGW["Envoy Gateway<br/>443/TCP → internal<br/>TLS 1.3 termination<br/>Kuadrant auth"]
    end

    subgraph ControlPlane["CONTROL PLANE (opendatahub namespace)"]
        direction TB
        AGController["ai-gateway-controller<br/>SA: ai-gateway-controller<br/>8080/TCP metrics<br/>8081/TCP health probes<br/>Non-root, read-only FS<br/>Seccomp: RuntimeDefault"]
        MaasCtrl["maas-controller<br/>(sibling, shared watches)"]
    end

    subgraph TenantNS["TENANT NAMESPACE (per-tenant gateway namespace)"]
        direction TB
        PreProcessing["payload-pre-processing<br/>9004/TCP gRPC<br/>TLS ACCEPT_UNTRUSTED"]
        PostProcessing["payload-processing<br/>9004/TCP gRPC<br/>TLS ACCEPT_UNTRUSTED"]
        ProviderSvc["provider-{name}<br/>ExternalName Service<br/>443/TCP HTTPS"]
        OverlayCM2["Routing Overlay ConfigMap<br/>SHA-256 content-addressed"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        IstioCP["Istio Control Plane<br/>EnvoyFilter / DestinationRule /<br/>ServiceEntry management"]
        GatewayAPI2["Gateway API<br/>HTTPRoute management"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Kuadrant auth"| EnvoyGW
    EnvoyGW -->|"gRPC/9004<br/>TLS ACCEPT_UNTRUSTED<br/>No auth"| PreProcessing
    EnvoyGW -->|"gRPC/9004<br/>TLS ACCEPT_UNTRUSTED<br/>No auth"| PostProcessing
    EnvoyGW -->|"HTTPS/443<br/>TLS SIMPLE + SNI<br/>API key (ExtProc injected)"| ProviderSvc
    ProviderSvc -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| LLMProvider

    %% Control plane flows
    AGController -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    AGController -->|"CRD CRUD<br/>via K8s API"| IstioCP
    AGController -->|"HTTPRoute CRUD<br/>via K8s API"| GatewayAPI2
    AGController -.->|"payload-processing-status<br/>CAS handshake"| MaasCtrl

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,LLMProvider external
    class EnvoyGW ingress
    class AGController,MaasCtrl controlplane
    class PreProcessing,PostProcessing,ProviderSvc,OverlayCM2 tenant
    class K8sAPI,IstioCP,GatewayAPI2 platform
