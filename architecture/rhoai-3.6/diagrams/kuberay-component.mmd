graph TB
    subgraph KubeRayOperator["KubeRay Operator (ray-operator)"]
        direction TB

        subgraph CoreControllers["Core Controllers"]
            RayClusterCtrl["RayClusterReconciler<br/>Provisions head/worker pods,<br/>services, ingress, RBAC"]
            RayJobCtrl["RayJobReconciler<br/>Creates transient clusters,<br/>submits jobs, lifecycle cleanup"]
            RayServiceCtrl["RayServiceReconciler<br/>Zero-downtime upgrades<br/>via blue/green transitions"]
            RayCronJobCtrl["RayCronJobReconciler<br/>Scheduled RayJob execution<br/>(alpha, feature-gated)"]
        end

        subgraph SecurityControllers["RHOAI Security Controllers"]
            AuthCtrl["AuthenticationController<br/>kube-rbac-proxy injection,<br/>Gateway API HTTPRoutes,<br/>OIDC proxy config"]
            NetPolCtrl["NetworkPolicyController<br/>Per-RayCluster NetworkPolicies<br/>(annotation-gated)"]
            MTLSCtrl["RayClusterMTLSController<br/>cert-manager Certificates<br/>for head/worker mTLS"]
            TLSWatcher["TLS Profile Watcher<br/>Monitors OpenShift APIServer<br/>TLS profile changes"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutatingWH["Mutating Webhook<br/>Enforces secure defaults:<br/>disables ingress, sets<br/>secure network annotation"]
            ValidatingWH["Validating Webhooks<br/>Validates RayCluster,<br/>RayJob, RayService"]
        end
    end

    %% CRDs
    RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    RayServiceCR["RayService CR<br/>(ray.io/v1)"]
    RayCronJobCR["RayCronJob CR<br/>(ray.io/v1)"]

    User[User / Data Scientist]

    %% User creates CRs
    User -->|creates| RayClusterCR
    User -->|creates| RayJobCR
    User -->|creates| RayServiceCR
    User -->|creates| RayCronJobCR

    %% Webhooks intercept
    RayClusterCR -->|intercepted by| MutatingWH
    RayClusterCR -->|validated by| ValidatingWH
    RayJobCR -->|validated by| ValidatingWH
    RayServiceCR -->|validated by| ValidatingWH

    %% Core reconciliation
    RayClusterCR -->|watched by| RayClusterCtrl
    RayJobCR -->|watched by| RayJobCtrl
    RayServiceCR -->|watched by| RayServiceCtrl
    RayCronJobCR -->|watched by| RayCronJobCtrl

    %% Security controllers watch RayClusters
    RayClusterCR -->|watched by| AuthCtrl
    RayClusterCR -->|watched by| NetPolCtrl
    RayClusterCR -->|watched by| MTLSCtrl

    %% Created resources
    RayClusterCtrl -->|creates| HeadPod["Ray Head Pod"]
    RayClusterCtrl -->|creates| WorkerPods["Ray Worker Pods"]
    RayClusterCtrl -->|creates| Services["Services"]
    RayJobCtrl -->|creates| SubmitterJob["Submitter Job"]
    RayJobCtrl -->|creates| RayClusterCR
    RayServiceCtrl -->|manages| RayClusterCR
    RayCronJobCtrl -->|creates| RayJobCR
    AuthCtrl -->|creates| HTTPRoutes["HTTPRoutes"]
    AuthCtrl -->|injects| KubeRBACProxy["kube-rbac-proxy sidecar"]
    NetPolCtrl -->|creates| NetworkPolicies["NetworkPolicies"]
    MTLSCtrl -->|creates| Certs["cert-manager Certificates"]

    %% External dependencies
    CertManager["cert-manager"]
    GatewayAPI["Platform Gateway<br/>(Gateway API)"]
    OpenShiftAPI["OpenShift APIServer Config"]
    Prometheus["Prometheus"]

    MTLSCtrl -->|provisions via| CertManager
    AuthCtrl -->|routes through| GatewayAPI
    TLSWatcher -->|reads profile| OpenShiftAPI
    KubeRayOperator -->|exposes metrics| Prometheus

    %% Styling
    style KubeRayOperator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style CoreControllers fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px
    style SecurityControllers fill:#fff3e0,stroke:#e65100,stroke-width:1px
    style Webhooks fill:#fce4ec,stroke:#c62828,stroke-width:1px
    style RayClusterCR fill:#f5a623,stroke:#333
    style RayJobCR fill:#f5a623,stroke:#333
    style RayServiceCR fill:#f5a623,stroke:#333
    style RayCronJobCR fill:#f5a623,stroke:#333
    style User fill:#e8e8e8,stroke:#333
    style CertManager fill:#999,stroke:#333
    style GatewayAPI fill:#999,stroke:#333
    style OpenShiftAPI fill:#999,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style HeadPod fill:#7ed321,stroke:#333
    style WorkerPods fill:#7ed321,stroke:#333
