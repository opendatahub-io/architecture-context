graph TB
    subgraph External["External Users"]
        User["User / CI"]
    end

    subgraph ControlPlane["Kubernetes Control Plane"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    end

    subgraph ModelServiceOperator["llm-d-model-service Operator"]
        Controller["modelservice-controller-manager<br/>(Go Operator)"]
        RunCmd["run subcommand<br/>(starts manager)"]
        GenCmd["generate subcommand<br/>(dry-run rendering)"]
        RunCmd -->|starts| Controller
    end

    subgraph CRDs["Custom Resources"]
        ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
        BaseConfig["BaseConfig ConfigMap<br/>(platform presets)"]
    end

    subgraph ChildResources["Provisioned Child Resources"]
        PrefillDeploy["Prefill Deployment"]
        DecodeDeploy["Decode Deployment"]
        EPPDeploy["EPP Deployment<br/>(Endpoint Picker)"]
        EPPService["EPP Service"]
        InfPool["InferencePool<br/>(v1alpha2)"]
        InfModel["InferenceModel<br/>(v1alpha2)"]
        HTTPRouteCR["HTTPRoute"]
        SA["ServiceAccount"]
        RB["RoleBinding"]
        CM["ConfigMap"]
    end

    subgraph GatewayAPI["Gateway API"]
        Gateway["Platform Gateway"]
    end

    User -->|creates| ModelServiceCR
    ModelServiceCR -->|watched by| Controller
    Controller -->|reads| BaseConfig
    Controller -->|merges spec + BaseConfig| Controller

    Controller -->|creates/updates| PrefillDeploy
    Controller -->|creates/updates| DecodeDeploy
    Controller -->|creates/updates| EPPDeploy
    Controller -->|creates/updates| EPPService
    Controller -->|creates/updates| InfPool
    Controller -->|creates/updates| InfModel
    Controller -->|creates/updates| HTTPRouteCR
    Controller -->|creates/updates| SA
    Controller -->|creates/updates| RB
    Controller -->|creates/updates| CM

    HTTPRouteCR -->|references| Gateway
    InfModel -->|maps to| InfPool
    EPPDeploy -->|routes within| InfPool

    Controller -->|CRUD via| K8sAPI

    GenCmd -.->|renders manifests<br/>to stdout| ModelServiceCR

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style RunCmd fill:#4a90e2,stroke:#333,color:#fff
    style GenCmd fill:#4a90e2,stroke:#333,color:#fff
    style ModelServiceCR fill:#f5a623,stroke:#333,color:#fff
    style BaseConfig fill:#f5a623,stroke:#333,color:#fff
    style PrefillDeploy fill:#7ed321,stroke:#333,color:#fff
    style DecodeDeploy fill:#7ed321,stroke:#333,color:#fff
    style EPPDeploy fill:#7ed321,stroke:#333,color:#fff
    style EPPService fill:#7ed321,stroke:#333,color:#fff
    style InfPool fill:#7ed321,stroke:#333,color:#fff
    style InfModel fill:#7ed321,stroke:#333,color:#fff
    style HTTPRouteCR fill:#7ed321,stroke:#333,color:#fff
    style SA fill:#7ed321,stroke:#333,color:#fff
    style RB fill:#7ed321,stroke:#333,color:#fff
    style CM fill:#7ed321,stroke:#333,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
