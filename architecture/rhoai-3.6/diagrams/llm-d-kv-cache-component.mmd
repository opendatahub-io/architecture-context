graph TB
    subgraph KVCache["llm-d-kv-cache"]
        direction TB

        subgraph GoLibraries["Go Libraries (consumed by llm-d-router)"]
            Indexer["kvcache.Indexer<br/>Core scoring engine"]
            TokenProcessor["TokenProcessor<br/>Block hash computation"]
            Pool["kvevents.Pool<br/>ZMQ event subscriber pool"]
            EngineAdapter["EngineAdapter<br/>Format-specific event parsing"]
            BlockIndex["kvblock.Index<br/>Pluggable block index"]
            Scorer["KVBlockScorer<br/>Multi-tier scoring<br/>GPU=1.0, CPU=0.8"]
        end

        subgraph UDSTokenizer["UDS Tokenizer Sidecar (Python)"]
            TokenizerService["TokenizationService<br/>gRPC over UDS<br/>vLLM rendering pipeline"]
            HealthProbe["Health Probe<br/>8082/TCP"]
        end

        subgraph PVCEvictor["PVC Evictor Sidecar (Python)"]
            Crawler["Crawler"]
            Activator["Activator"]
            Deleter["Deleter"]
            FolderCleaner["Folder Cleaner"]
        end

        subgraph Examples["Reference Implementations"]
            OnlineService["online HTTP Service<br/>8080/TCP"]
            IndexerGRPC["IndexerService<br/>gRPC 50051/TCP"]
            PodReconciler["pod_reconciler<br/>Controller"]
        end
    end

    %% Internal library flows
    Indexer -->|"computes hashes"| TokenProcessor
    Indexer -->|"queries"| BlockIndex
    Indexer -->|"returns scores"| Scorer
    Pool -->|"parses events"| EngineAdapter
    EngineAdapter -->|"updates"| BlockIndex

    %% PVC Evictor pipeline
    Crawler -->|"scans files"| Activator
    Activator -->|"triggers"| Deleter
    Deleter -->|"cleans"| FolderCleaner

    %% External dependencies
    vLLMPods["vLLM Pods<br/>ZMQ PUB 5557/TCP"]
    Redis["Redis/Valkey<br/>6379/TCP"]
    OTELCollector["OpenTelemetry Collector<br/>gRPC 4317/TCP"]
    HFHub["HuggingFace Hub<br/>HTTPS 443/TCP"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]

    vLLMPods -->|"ZMQ SUB"| Pool
    BlockIndex -->|"read/write"| Redis
    OnlineService -->|"trace export"| OTELCollector
    TokenizerService -->|"model download"| HFHub
    PodReconciler -->|"watch pods"| K8sAPI

    %% Consumer
    Router["llm-d-router<br/>Primary consumer"]
    Router -->|"library import"| Indexer
    Router -->|"library import"| Pool
    Router -->|"gRPC over UDS"| TokenizerService

    %% Example wiring
    OnlineService -->|"uses"| Indexer

