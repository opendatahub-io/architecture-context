graph TB
    subgraph TrainingHub["Training Hub Package"]
        direction TB
        CLI["thub CLI<br/>YAML config / args"]
        Registry["AlgorithmRegistry<br/>Strategy + Registry Pattern"]
        CallbackSys["Callback System<br/>TrainingHubCallback<br/>TrainingHubContext<br/>TrainingHubControl"]
        JIT["JIT Checkpoint<br/>SIGTERM preemption"]
        CkptMgr["Checkpoint Manager<br/>fsspec remote mirror"]
        MemEst["Memory Estimator<br/>GPU VRAM estimation"]
        Viz["Visualization<br/>plot_loss with EMA"]
    end

    subgraph Backends["Training Backends"]
        direction TB
        SFT["SFT Backend<br/>InstructLab Training"]
        OSFT["OSFT Backend<br/>Mini-Trainer"]
        LoRASFT["LoRA SFT Backend<br/>Unsloth + QLoRA"]
        ARTGRPO["ART GRPO Backend<br/>Single-GPU LoRA + GRPO"]
        VerlGRPO["verl GRPO Backend<br/>Multi-GPU FSDP + vLLM"]
        GEPA["GEPA Backend<br/>Gradient-free prompt opt"]
        MLflowGEPA["MLflow GEPA Backend<br/>Prompt registry + tracking"]
        EmbSFT["Embedding SFT Backend<br/>sentence-transformers"]
    end

    subgraph Adapters["Backend Adapters"]
        AdaptUnsloth["adapters/unsloth"]
        AdaptILab["adapters/instructlab"]
        AdaptMini["adapters/mini_trainer"]
        ITSRollout["ITS Rollout Adapter"]
    end

    User["User / Kubeflow Pipeline"] -->|"Python API / CLI"| CLI
    CLI --> Registry
    Registry --> SFT
    Registry --> OSFT
    Registry --> LoRASFT
    Registry --> ARTGRPO
    Registry --> VerlGRPO
    Registry --> GEPA
    Registry --> MLflowGEPA
    Registry --> EmbSFT

    SFT -->|"torchrun subprocess"| AdaptILab
    OSFT -->|"torchrun subprocess"| AdaptMini
    LoRASFT -->|"torchrun subprocess"| AdaptUnsloth
    ARTGRPO -->|"spawned process"| ARTGRPO
    VerlGRPO -->|"torchrun + FSDP"| VerlGRPO

    CallbackSys -.->|"lifecycle hooks"| SFT
    CallbackSys -.->|"lifecycle hooks"| OSFT
    CallbackSys -.->|"lifecycle hooks"| LoRASFT
    CallbackSys -.->|"lifecycle hooks"| ARTGRPO
    CallbackSys -.->|"lifecycle hooks"| VerlGRPO

    JIT -.->|"checkpoint on SIGTERM"| CkptMgr
    CkptMgr -->|"fsspec upload"| S3["S3 / GCS / Azure<br/>Remote Storage"]

    GEPA -->|"litellm"| LLMAPI["LLM API Endpoints<br/>443/TCP HTTPS"]
    MLflowGEPA -->|"tracking"| MLflow["MLflow Server"]
    EmbSFT -->|"in-process"| SentTrans["sentence-transformers"]

    SFT -->|"model download"| HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]
    OSFT -->|"model download"| HFHub
    LoRASFT -->|"model download"| HFHub

    VerlGRPO -->|"inference"| vLLM["vLLM Engine<br/>Co-located"]

