graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Istio Gateway)"]
        Gateway["Envoy Filter Chain<br/>TLS 1.2+ Termination<br/>EnvoyFilter: two-stage ExtProc"]
    end

    subgraph ClusterNetwork["CLUSTER NETWORK (NetworkPolicy enforced)"]
        direction TB

        subgraph NS_Ingress["Namespace: openshift-ingress"]
            PreProc["payload-pre-processing<br/>SA: payload-processing<br/>9004/TCP gRPC, 50052/TCP health, 9090/TCP metrics<br/>FIPS build, runAsNonRoot, drop ALL caps<br/>fail-open (pre-auth)"]
            PostProc["payload-processing<br/>SA: payload-processing<br/>9004/TCP gRPC, 50052/TCP health, 9090/TCP metrics<br/>FIPS build, runAsNonRoot, drop ALL caps<br/>fail-closed (post-auth)"]
        end
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP, 6443/TCP<br/>TLS, ServiceAccount token"]
    end

    subgraph Downstream["DOWNSTREAM"]
        EPP["InferencePool / EPP<br/>gRPC ExtProc, TLS"]
        ModelServer["Upstream Model Server<br/>HTTP/gRPC, TLS<br/>Bearer/mTLS"]
    end

    subgraph Observability["OBSERVABILITY"]
        Kubelet["kubelet<br/>gRPC health probe"]
        Prometheus["Prometheus<br/>HTTP/1.1 metrics scrape"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (Kuadrant)"| Gateway

    %% Ingress → Pre-Processing (pre-auth, fail-open)
    Gateway -->|"gRPC/9004<br/>TLS (ACCEPT_UNTRUSTED)<br/>No Auth (Envoy-internal)<br/>fail-open"| PreProc
    PreProc -->|"ProcessingResponse<br/>X-Gateway-Model-Name"| Gateway

    %% Ingress → Post-Processing (post-auth, fail-closed)
    Gateway -->|"gRPC/9004<br/>TLS (ACCEPT_UNTRUSTED)<br/>No Auth (Envoy-internal)<br/>fail-closed"| PostProc
    PostProc -->|"ProcessingResponse<br/>Header/body mutations"| Gateway

    %% Gateway → Downstream
    Gateway -->|"gRPC ExtProc<br/>TLS"| EPP
    Gateway -->|"HTTP/gRPC<br/>TLS, Bearer/mTLS"| ModelServer

    %% ExtProc → K8s API
    PreProc -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    PostProc -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI

    %% Observability
    Kubelet -->|"gRPC/50052<br/>No TLS<br/>No Auth"| PostProc
    Prometheus -->|"HTTP/9090<br/>No TLS<br/>No Auth<br/>NetworkPolicy: monitoring NS only"| PostProc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef downstream fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class PreProc,PostProc cluster
    class K8sAPI controlplane
    class EPP,ModelServer downstream
    class Kubelet,Prometheus observability
