graph TB
    subgraph TrainingOperator["Training Operator"]
        direction TB
        Manager["Manager<br/>(controller-runtime)"]
        CertRotator["Cert Rotator<br/>(OPA cert-controller)"]

        subgraph Reconcilers["Per-Framework Reconcilers"]
            PyTorchCtrl["PyTorchJob Controller"]
            TFCtrl["TFJob Controller"]
            MPICtrl["MPIJob Controller"]
            XGBoostCtrl["XGBoostJob Controller"]
            PaddleCtrl["PaddleJob Controller"]
            JAXCtrl["JAXJob Controller"]
        end

        subgraph Webhooks["Validating Webhooks (9443/TCP)"]
            PyTorchWH["PyTorchJob Webhook"]
            TFWH["TFJob Webhook"]
            XGBoostWH["XGBoostJob Webhook"]
            PaddleWH["PaddleJob Webhook"]
            JAXWH["JAXJob Webhook"]
        end

        subgraph Servers["Servers"]
            MetricsServer["Metrics Server<br/>8080/TCP TLS"]
            HealthServer["Health Probes<br/>8081/TCP"]
        end

        Manager --> Reconcilers
        Manager --> Webhooks
        Manager --> Servers
        Manager --> CertRotator
    end

    %% CRDs
    PyTorchJobCR["PyTorchJob CR"]
    TFJobCR["TFJob CR"]
    MPIJobCR["MPIJob CR"]
    XGBoostJobCR["XGBoostJob CR"]
    PaddleJobCR["PaddleJob CR"]
    JAXJobCR["JAXJob CR"]

    %% CRD watches
    PyTorchJobCR -->|watched by| PyTorchCtrl
    TFJobCR -->|watched by| TFCtrl
    MPIJobCR -->|watched by| MPICtrl
    XGBoostJobCR -->|watched by| XGBoostCtrl
    PaddleJobCR -->|watched by| PaddleCtrl
    JAXJobCR -->|watched by| JAXCtrl

    %% Created resources
    PyTorchCtrl -->|creates| WorkerPods["Worker/Master Pods"]
    PyTorchCtrl -->|creates| HeadlessSvc["Headless Services"]
    PyTorchCtrl -->|creates| NetPol["NetworkPolicies"]
    PyTorchCtrl -->|creates| HPA["HorizontalPodAutoscaler"]

    TFCtrl -->|creates| WorkerPods
    TFCtrl -->|creates| HeadlessSvc
    MPICtrl -->|creates| WorkerPods
    MPICtrl -->|creates| HeadlessSvc
    MPICtrl -->|uses| KubectlDelivery["kubectl-delivery<br/>(init container)"]

    %% External dependencies
    Manager -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer Config"]
    CertRotator -->|manages| WebhookSecret["training-operator-webhook-cert<br/>(Secret)"]
    CertRotator -->|patches caBundle| WebhookConfig["ValidatingWebhookConfiguration"]

    %% Monitoring
    Prometheus["Prometheus<br/>(openshift-monitoring)"] -->|scrapes 8080/TCP| MetricsServer

    %% Optional gang scheduling
    PyTorchCtrl -.->|optional| Volcano["Volcano PodGroup"]
    PyTorchCtrl -.->|optional| SchedPlugins["Scheduler-Plugins PodGroup"]

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style PyTorchCtrl fill:#4a90e2,color:#fff
    style TFCtrl fill:#4a90e2,color:#fff
    style MPICtrl fill:#4a90e2,color:#fff
    style XGBoostCtrl fill:#4a90e2,color:#fff
    style PaddleCtrl fill:#4a90e2,color:#fff
    style JAXCtrl fill:#4a90e2,color:#fff
    style CertRotator fill:#4a90e2,color:#fff
    style PyTorchJobCR fill:#f5a623,color:#000
    style TFJobCR fill:#f5a623,color:#000
    style MPIJobCR fill:#f5a623,color:#000
    style XGBoostJobCR fill:#f5a623,color:#000
    style PaddleJobCR fill:#f5a623,color:#000
    style JAXJobCR fill:#f5a623,color:#000
    style WorkerPods fill:#7ed321,color:#000
    style HeadlessSvc fill:#7ed321,color:#000
    style NetPol fill:#7ed321,color:#000
    style HPA fill:#7ed321,color:#000
    style KubectlDelivery fill:#7ed321,color:#000
    style OpenShiftAPI fill:#e8e8e8,color:#000
    style Prometheus fill:#e8e8e8,color:#000
    style Volcano fill:#e8e8e8,color:#000,stroke-dasharray: 5 5
    style SchedPlugins fill:#e8e8e8,color:#000,stroke-dasharray: 5 5
