graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph GatewayLayer["INGRESS (Gateway Layer)"]
        Gateway["Kuadrant/Authorino Gateway<br/>443/TCP<br/>TLS 1.2+<br/>API key / SA token / OpenShift token"]
    end

    subgraph AppLayer["APPLICATION LAYER (No in-process auth)"]
        direction TB

        subgraph NS["Namespace: release-namespace"]
            API["API Server<br/>SA: release-apiserver<br/>8000/TCP API, 8081/TCP obs<br/>SecurityHeaders middleware<br/>runAsNonRoot, drop ALL"]

            Proc["Processor (StatefulSet)<br/>SA: release-processor<br/>9090/TCP obs only<br/>AIMD concurrency control<br/>runAsNonRoot, drop ALL"]

            GCPod["GC (single replica)<br/>SA: release-gc<br/>9091/TCP metrics only<br/>runAsNonRoot, drop ALL"]
        end
    end

    subgraph Infra["INFRASTRUCTURE SERVICES"]
        PG["PostgreSQL<br/>Connection URL from secret<br/>Row-level tenant filtering"]
        Redis["Redis/Valkey<br/>URL from secret<br/>Priority queue + events"]
        S3["S3-compatible Storage<br/>Access key from secret<br/>Input/output files"]
    end

    subgraph Downstream["DOWNSTREAM SERVICES"]
        LLMd["llm-d Inference Gateway<br/>TLS 1.2+ (optional mTLS)<br/>API key (optional)<br/>AIMD flow control"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>ServiceAccount token"]
    end

    subgraph OTel["OBSERVABILITY"]
        Collector["OpenTelemetry Collector<br/>OTLP/gRPC<br/>No auth"]
    end

    %% External to Gateway
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>API key / SA token"| Gateway

    %% Gateway to API Server
    Gateway -->|"HTTP(S)/8000<br/>TLS 1.2+ (optional)<br/>X-MaaS-Username injected"| API

    %% API Server to infrastructure
    API -->|"TCP<br/>Connection URL"| PG
    API -->|"TCP<br/>URL from secret"| Redis
    API -->|"HTTP(S)<br/>Access key"| S3

    %% Processor to infrastructure
    Proc -->|"TCP<br/>Connection URL"| PG
    Proc -->|"TCP<br/>URL from secret"| Redis
    Proc -->|"HTTP(S)<br/>Access key"| S3

    %% Processor to downstream
    Proc -->|"HTTP(S)<br/>TLS 1.2+ optional mTLS<br/>API key (optional)"| LLMd

    %% GC to infrastructure
    GCPod -->|"TCP<br/>Connection URL"| PG
    GCPod -->|"TCP<br/>URL from secret"| Redis
    GCPod -->|"HTTP(S)<br/>Access key"| S3

    %% GC to K8s API
    GCPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% All to OTel
    API -.->|"OTLP/gRPC"| Collector
    Proc -.->|"OTLP/gRPC"| Collector
    GCPod -.->|"OTLP/gRPC"| Collector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef infra fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef downstream fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef otel fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway gateway
    class API,Proc,GCPod app
    class PG,Redis,S3 infra
    class LLMd downstream
    class K8sAPI k8s
    class Collector otel
