graph LR
    MaaS["Models as a Service<br/>(maas-controller + maas-api)"]

    %% External Dependencies
    MaaS -->|"HTTP framework"| Gin["gin v1.12.0"]
    MaaS -->|"database driver"| Pgx["pgx/v5 v5.11.0"]
    MaaS -->|"operator framework"| ControllerRuntime["controller-runtime v0.25.1"]
    MaaS -->|"gateway types"| GatewayAPI["gateway-api v1.6.2"]
    MaaS -->|"OpenShift types"| OpenShiftAPI["openshift/api"]
    MaaS -->|"TLS profiles"| LibraryGo["openshift/library-go"]
    MaaS -->|"JWT parsing"| JWT["golang-jwt/jwt/v5"]
    MaaS -->|"DB migrations"| Migrate["golang-migrate/v4"]
    MaaS -->|"metrics"| Prometheus["prometheus/client_golang v1.24.1"]
    MaaS -->|"tracing"| OTel["opentelemetry v1.46.0"]
    MaaS -->|"external model client"| OpenAIGo["openai-go/v2 v2.7.1"]

    %% Internal Platform Dependencies
    MaaS -->|"ingress routing<br/>HTTPRoute CRUD"| GatewayService["Gateway API<br/>(data-science-gateway)"]
    MaaS -->|"model serving state<br/>(conditional)"| KServe["KServe<br/>LLMInferenceService"]
    MaaS -->|"gateway auth<br/>AuthPolicy CRUD"| Authorino["Kuadrant/Authorino"]
    MaaS -->|"rate limiting<br/>TokenRateLimitPolicy"| Limitador["Kuadrant/Limitador"]
    MaaS -->|"inference priority<br/>InferenceObjective"| LlmD["llm-d-router v0.11.0"]
    MaaS -->|"TLS profile<br/>API read"| OpenShiftConfig["OpenShift Config API"]

    %% KServe types dependency
    MaaS -->|"API types"| KServeTypes["kserve v0.19.0-rc0"]

    %% Infrastructure Dependencies
    MaaS -->|"API key storage"| PostgreSQL["PostgreSQL"]
    MaaS -->|"CRD reconciliation"| K8sAPI["Kubernetes API"]

    %% Reverse integrations
    Prometheus2["Prometheus / ServiceMonitor"] -->|"metrics scrape<br/>9090/TCP HTTPS"| MaaS

