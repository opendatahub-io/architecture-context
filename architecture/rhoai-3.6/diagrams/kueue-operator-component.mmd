graph TB
    subgraph Operator["openshift-kueue-operator<br/>(2 replicas, system-cluster-critical)"]
        direction TB
        CLI["kueue-operator CLI<br/>(Cobra)"]
        TRC["TargetConfigReconciler<br/>(1372 lines)"]
        CertHelper["cert-manager Helper<br/>(CA injection)"]
        CLI -->|bootstraps| TRC
        TRC -->|uses| CertHelper
    end

    subgraph Operand["kueue-controller-manager<br/>(operand)"]
        direction TB
        Controller["Kueue Controller<br/>(workload scheduling)"]
        WebhookServer["Webhook Server<br/>17 mutating + 18 validating"]
        VisibilityAPI["Visibility API Server<br/>(aggregated API)"]
        MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS"]
        HealthProbes["Health Probes<br/>8081/TCP"]
    end

    subgraph CRDs["Custom Resources"]
        KueueCR["Kueue CR<br/>(kueue.openshift.io/v1)<br/>singleton 'cluster'"]
        ClusterQueue["ClusterQueue<br/>(kueue.x-k8s.io/v1beta1)"]
        LocalQueue["LocalQueue<br/>(kueue.x-k8s.io/v1beta1)"]
        Workload["Workload<br/>(kueue.x-k8s.io/v1beta1)"]
        ResourceFlavor["ResourceFlavor<br/>(kueue.x-k8s.io/v1beta1)"]
        AdmissionCheck["AdmissionCheck<br/>(kueue.x-k8s.io/v1beta1)"]
        Cohort["Cohort<br/>(kueue.x-k8s.io/v1alpha1)"]
    end

    Admin["Platform Admin"] -->|creates| KueueCR
    KueueCR -->|watched by| TRC
    TRC -->|reconciles & deploys| Operand

    User["Data Scientist"] -->|creates Jobs/Workloads| K8sAPI["Kubernetes API<br/>6443/TCP"]
    K8sAPI -->|admission webhook| WebhookServer
    Controller -->|manages| ClusterQueue
    Controller -->|manages| LocalQueue
    Controller -->|manages| Workload
    Controller -->|uses| ResourceFlavor
    Controller -->|uses| AdmissionCheck
    Controller -->|uses| Cohort

    TRC -->|creates| CertMgr["cert-manager<br/>(Issuer, Certificate)"]
    TRC -->|creates| NetPol["NetworkPolicies<br/>(default-deny + allowances)"]
    TRC -->|creates| SM["ServiceMonitor"]

    Prometheus["Prometheus"] -->|scrapes| MetricsEndpoint

    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style Operand fill:#7ed321,stroke:#333,color:#fff
    style KueueCR fill:#f5a623,stroke:#333
    style ClusterQueue fill:#f5a623,stroke:#333
    style LocalQueue fill:#f5a623,stroke:#333
    style Workload fill:#f5a623,stroke:#333
    style ResourceFlavor fill:#f5a623,stroke:#333
    style AdmissionCheck fill:#f5a623,stroke:#333
    style Cohort fill:#f5a623,stroke:#333
    style CertMgr fill:#e8e8e8,stroke:#333
    style NetPol fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
