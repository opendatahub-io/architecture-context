graph LR
    RMO["ray-module-operator<br/>Go controller-runtime"]

    %% Internal Platform Dependencies
    RMO -->|"reconciler framework,<br/>action pipeline, GC"| PlatformUtils["odh-platform-utilities<br/>v0.2.1-dev"]
    RMO -->|"controller framework<br/>API types"| PlatformFramework["odh-platform-utilities<br/>/framework v0.1.0"]
    RMO -->|"validates CRDs,<br/>operand TLS"| CertManager["cert-manager"]
    RMO -->|"deploys operand"| KubeRay["KubeRay Operator<br/>(vendored manifests)"]
    RMO -->|"metrics protection<br/>sidecar"| RBACProxy["kube-rbac-proxy"]
    RMO -->|"optional networking<br/>resources"| GatewayAPI["Gateway API"]

    %% External Dependencies
    RMO -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    RMO -->|"API types"| K8sAPI["k8s.io/api<br/>v0.35.3"]
    RMO -->|"metadata, runtime"| K8sApimachinery["k8s.io/apimachinery<br/>v0.35.4"]
    RMO -->|"API client"| K8sClient["k8s.io/client-go<br/>v0.35.3"]
    RMO -->|"version parsing"| Semver["semver/v3<br/>v3.5.0"]

    %% Platform Components that depend on this
    PlatformOp["ODH/RHOAI<br/>Platform Operator"] -->|"creates Ray CR"| RMO
    Workbenches["Workbenches<br/>(Notebooks)"] -.->|"uses ray ClusterRole"| RMO

    %% External Services
    RMO -->|"CR reconciliation,<br/>SSA apply"| K8sAPIServer["Kubernetes API<br/>6443/TCP"]
    RMO -.->|"optional routes"| OpenShiftRoutes["OpenShift Routes"]
    RMO -->|"watches config"| ConfigMap["odh-ray-config<br/>ConfigMap"]

