graph TB
    subgraph MustGather["must-gather Diagnostic Tool"]
        direction TB
        GatherSH["gather.sh<br/>(Main Dispatcher)"]
        CommonSH["common.sh<br/>(Shared Library)"]
        XksUtilSH["xks_util.sh<br/>(xKS Abstraction Layer)"]

        GatherSH -->|imports| CommonSH
        GatherSH -->|imports on xKS| XksUtilSH

        subgraph Collectors["Component Collectors (Parallel)"]
            direction LR
            KServe["gather_kserve.sh"]
            AIGateway["gather_aigateway.sh"]
            DSP["gather_data_science_pipelines.sh"]
            Dashboard["gather_dashboard.sh"]
            KubeRay["gather_kuberay.sh"]
            Kueue["gather_kueue.sh"]
            KFTO["gather_kfto.sh"]
            Workbench["gather_workbench.sh"]
            ModelReg["gather_model_registry.sh"]
            TrustyAI["gather_trustyai.sh"]
            Feast["gather_feast.sh"]
            MLflow["gather_mlflow.sh"]
            Spark["gather_spark.sh"]
            MCP["gather_mcp.sh"]
            OGX["gather_ogx.sh"]
        end

        subgraph LLMD["LLM-D Subsystem"]
            direction TB
            GatherLLMD["gather_llmd.sh<br/>(Meta-Collector)"]
            GatherO11y["gather_o11y.sh<br/>(Observability)"]
            GatherCluster["gather_cluster.sh<br/>(Cluster Info)"]
            DepCertMgr["cert-manager deps"]
            DepSail["Sail/Istio deps"]
            DepLWS["LWS deps"]

            GatherLLMD -->|chains| DepCertMgr
            GatherLLMD -->|chains| DepSail
            GatherLLMD -->|chains| DepLWS
            GatherLLMD -->|calls| GatherO11y
            GatherLLMD -->|calls| GatherCluster
        end

        GatherSH -->|dispatches| Collectors
        KServe -->|delegates| GatherLLMD
    end

    subgraph XKS["xKS Entry Point"]
        GatherXKS["gather_xks.sh"]
    end

    GatherSH -->|routes on xKS| GatherXKS
    GatherXKS -->|delegates| KServe
    GatherXKS -->|delegates| AIGateway

    User["oc adm must-gather<br/>or K8s Job"] -->|invokes| GatherSH

    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
    GatherSH -->|queries| K8sAPI
    Collectors -->|read CRDs via| K8sAPI
    GatherLLMD -->|read CRDs via| K8sAPI

    Output["/must-gather/<br/>(Local Filesystem)"]
    GatherSH -->|writes collected data| Output

    style GatherSH fill:#4a90e2,color:#fff
    style CommonSH fill:#4a90e2,color:#fff
    style XksUtilSH fill:#4a90e2,color:#fff
    style GatherLLMD fill:#9b59b6,color:#fff
    style GatherO11y fill:#9b59b6,color:#fff
    style GatherCluster fill:#9b59b6,color:#fff
    style GatherXKS fill:#e67e22,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Output fill:#f5a623,color:#fff
    style User fill:#7ed321,color:#fff
