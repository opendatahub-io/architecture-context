graph TD
    subgraph LibraryScope["llm-d-api-extensions (Python Library)"]
        direction TB
        Note["This is a Python library, not a<br/>Kubernetes-deployed component.<br/>No RBAC resources are defined."]
    end

    subgraph InheritedSecurity["Inherited Security Context"]
        direction TB
        vLLMSA["vLLM Pod ServiceAccount<br/>(defined by deployment)"]
        vLLMRoles["vLLM RBAC Roles<br/>(defined by vLLM operator)"]
    end

    subgraph PluginAuth["Plugin-Level Authorization"]
        direction TB
        ConfigAuth["GET /config<br/>Auth: None (inherited)<br/>Access: Read-only"]
        DevicesAuth["GET /devices<br/>Auth: None (inherited)<br/>Access: Read-only"]
        KVCacheAuth["GET /kv-cache<br/>Auth: None (inherited)<br/>Access: Read-only"]
    end

    subgraph DataRedaction["Data Protection"]
        direction TB
        Redaction["kv_connector_extra_config<br/>Redacted by default<br/>Expose: LLM_D_INTROSPECTION_<br/>EXPOSE_KV_EXTRA_CONFIG=1"]
    end

    vLLMSA -->|"pod identity"| vLLMRoles
    vLLMRoles -->|"inherited by"| LibraryScope
    LibraryScope --> PluginAuth
    ConfigAuth --> Redaction

    style Note fill:#fff2cc,stroke:#d6b656
    style vLLMSA fill:#4a90e2,color:#fff
    style vLLMRoles fill:#f5a623
    style ConfigAuth fill:#d5e8d4,stroke:#82b366
    style DevicesAuth fill:#d5e8d4,stroke:#82b366
    style KVCacheAuth fill:#d5e8d4,stroke:#82b366
    style Redaction fill:#ffcccc,stroke:#cc0000
