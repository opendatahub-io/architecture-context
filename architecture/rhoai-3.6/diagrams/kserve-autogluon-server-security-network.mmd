graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Istio Gateway / Gateway API<br/>443/TCP &rarr; 8080/TCP<br/>TLS 1.3 Termination<br/>RequestAuthentication"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS if enabled)"]
        direction TB

        subgraph NS_User["Namespace: user-namespace"]
            subgraph Pod["AutoGluon Server Pod<br/>UID: 1001 (non-root)"]
                REST["REST Server (FastAPI)<br/>8080/TCP HTTP<br/>v1/v2 Inference + /metrics"]
                GRPC["gRPC Server<br/>8081/TCP gRPC<br/>v2 Inference (tabular only)"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        CloudStorage["Cloud Storage<br/>S3 / GCS / Azure Blob<br/>443/TCP HTTPS TLS 1.2+<br/>Cloud IAM Credentials"]
        PromScraper["Prometheus<br/>Metrics Collection"]
    end

    subgraph InitPhase["INIT CONTAINER PHASE"]
        StorageInit["KServe Storage Initializer<br/>Downloads model to /mnt/models"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Bearer Token (optional)"| Gateway
    Gateway -->|"HTTP/8080<br/>mTLS (mesh)<br/>Service Identity"| REST
    Gateway -->|"gRPC/8081<br/>mTLS (mesh)<br/>Service Identity"| GRPC
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Cloud IAM"| CloudStorage
    PromScraper -->|"HTTP/8080<br/>GET /metrics<br/>No Auth"| REST

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef initcontainer fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class REST,GRPC servicemesh
    class CloudStorage,PromScraper externalservice
    class StorageInit initcontainer
