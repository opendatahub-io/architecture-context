graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator"]
        direction TB
        GuardrailsServer["guardrails-server<br/>Port 8033/TCP<br/>HTTP/HTTPS<br/>Optional TLS/mTLS"]
        HealthServer["health-server<br/>Port 8034/TCP<br/>HTTP<br/>No Auth"]
        TaskRouter["Task Handler Router<br/>(axum)"]
        OrchestratorCore["Orchestrator Core<br/>Fan-out / Aggregation"]
        ClientMap["ClientMap<br/>Dynamic trait-object dispatch"]
        TLSLayer["TLS Layer<br/>(rustls + ring)"]
        HeaderPassthrough["Header Passthrough<br/>X-Forwarded-Access-Token rewrite"]

        GuardrailsServer --> TaskRouter
        TaskRouter --> OrchestratorCore
        OrchestratorCore --> ClientMap
        GuardrailsServer --> TLSLayer
        GuardrailsServer --> HeaderPassthrough
    end

    Client["API Client"] -->|"POST /api/v1/* /api/v2/*<br/>8033/TCP"| GuardrailsServer
    Probes["Health Probes"] -->|"GET /health /info<br/>8034/TCP"| HealthServer

    subgraph Backends["Downstream Services"]
        TGIS["TGIS Generation<br/>gRPC 8033/TCP"]
        CaikitNLP["Caikit NLP<br/>gRPC"]
        OpenAIService["OpenAI-compatible<br/>HTTP/HTTPS"]
        Detectors["Detector Services<br/>HTTP 8080/TCP"]
        Chunkers["Chunker Services<br/>gRPC 8085/TCP"]
    end

    ClientMap -->|"gRPC<br/>tonic"| TGIS
    ClientMap -->|"gRPC<br/>tonic"| CaikitNLP
    ClientMap -->|"HTTP<br/>reqwest"| OpenAIService
    ClientMap -->|"HTTP<br/>hyper"| Detectors
    ClientMap -->|"gRPC<br/>tonic"| Chunkers

    OTLPCollector["OTLP Collector<br/>Traces & Metrics"]
    OrchestratorCore -.->|"gRPC/HTTP"| OTLPCollector

    style GuardrailsServer fill:#4a90e2,color:#fff
    style HealthServer fill:#4a90e2,color:#fff
    style OrchestratorCore fill:#4a90e2,color:#fff
    style ClientMap fill:#4a90e2,color:#fff
    style TaskRouter fill:#4a90e2,color:#fff
    style TLSLayer fill:#e8a838,color:#fff
    style HeaderPassthrough fill:#e8a838,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Probes fill:#f9f9f9,stroke:#999
    style TGIS fill:#7ed321,color:#fff
    style CaikitNLP fill:#7ed321,color:#fff
    style OpenAIService fill:#7ed321,color:#fff
    style Detectors fill:#7ed321,color:#fff
    style Chunkers fill:#7ed321,color:#fff
    style OTLPCollector fill:#999,color:#fff
