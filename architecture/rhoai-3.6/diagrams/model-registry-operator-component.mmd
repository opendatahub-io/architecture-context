graph TB
    subgraph Platform["opendatahub-operator"]
        AIHubCR["AIHub CR<br/>(Cluster-scoped)"]
    end

    subgraph Operator["model-registry-operator"]
        direction TB

        subgraph Controllers["Controllers"]
            AIHubReconciler["AIHubReconciler<br/>Manages Catalog lifecycle"]
            CatalogReconciler["CatalogReconciler<br/>Deploys Catalog + PostgreSQL"]
            MRReconciler["ModelRegistryReconciler<br/>Deploys Registry + kube-rbac-proxy"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutatingWH["Mutating Webhook<br/>:9443/TCP"]
            ValidatingWH["Validating Webhook<br/>:9443/TCP"]
            ConversionWH["Conversion Webhook<br/>v1alpha1 ↔ v1beta1"]
        end

        SVMigration["Storage Version Migration<br/>API version migration"]
        TemplateApplier["TemplateApplier<br/>go:embed YAML templates"]
    end

    subgraph CRDs["Custom Resources"]
        ModelRegistryCR["ModelRegistry CR<br/>(Namespaced)"]
        CatalogCR["Catalog CR<br/>(Namespaced)"]
    end

    subgraph RegistryWorkloads["Per-Registry Workloads"]
        RegistryDeploy["Registry Deployment<br/>Model Registry server<br/>+ kube-rbac-proxy sidecar"]
        RegistryService["Registry Service<br/>:8080/HTTP :8443/HTTPS"]
        RegistryPostgres["Registry PostgreSQL<br/>:5432/TCP"]
        RegistryRBAC["Registry RBAC<br/>Role + Group per instance"]
        RegistryNetPol["NetworkPolicy<br/>Per-registry ingress rules"]
    end

    subgraph CatalogWorkloads["Catalog Workloads"]
        CatalogDeploy["Model Catalog Deployment<br/>Catalog server<br/>+ kube-rbac-proxy sidecar"]
        CatalogService["Catalog Service<br/>:8080/HTTP :8443/HTTPS"]
        CatalogPostgres["Catalog PostgreSQL<br/>:5432/TCP"]
    end

    %% Platform → Operator
    AIHubCR -->|"watched by"| AIHubReconciler
    AIHubReconciler -->|"creates/manages"| CatalogCR
    CatalogCR -->|"watched by"| CatalogReconciler

    %% User → Operator
    User["User / kubectl"] -->|"creates"| ModelRegistryCR
    ModelRegistryCR -->|"validated by"| MutatingWH
    ModelRegistryCR -->|"validated by"| ValidatingWH
    ModelRegistryCR -->|"watched by"| MRReconciler

    %% Controllers → Workloads
    MRReconciler -->|"renders templates"| TemplateApplier
    TemplateApplier -->|"creates"| RegistryDeploy
    TemplateApplier -->|"creates"| RegistryService
    TemplateApplier -->|"creates"| RegistryPostgres
    TemplateApplier -->|"creates"| RegistryRBAC
    TemplateApplier -->|"creates"| RegistryNetPol

    CatalogReconciler -->|"creates"| CatalogDeploy
    CatalogReconciler -->|"creates"| CatalogService
    CatalogReconciler -->|"creates"| CatalogPostgres

    %% External Integrations
    MRReconciler -->|"creates Routes"| OpenShiftRoutes["OpenShift Routes"]
    MRReconciler -->|"creates HTTPRoutes"| GatewayAPI["Gateway API"]
    MRReconciler -->|"manages Groups"| OpenShiftUsers["OpenShift Users/Groups"]

    %% Styling
    style AIHubReconciler fill:#4a90e2,color:#fff
    style CatalogReconciler fill:#4a90e2,color:#fff
    style MRReconciler fill:#4a90e2,color:#fff
    style MutatingWH fill:#9b59b6,color:#fff
    style ValidatingWH fill:#9b59b6,color:#fff
    style ConversionWH fill:#9b59b6,color:#fff
    style ModelRegistryCR fill:#f5a623,color:#fff
    style CatalogCR fill:#f5a623,color:#fff
    style AIHubCR fill:#f5a623,color:#fff
    style RegistryDeploy fill:#7ed321
    style CatalogDeploy fill:#7ed321
    style OpenShiftRoutes fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style OpenShiftUsers fill:#e8e8e8
