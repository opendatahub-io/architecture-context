graph TD
    subgraph ServiceAccount["Service Account"]
        SA["trustyai-serviceaccount"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["trustyai-clusterrolebinding<br/>(Cluster-scoped)"]
    end

    subgraph ClusterRolePerms["ClusterRole Permissions"]
        CR["trustyai-role<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        ConfigMaps["core ('')<br/>ConfigMaps"]
    end

    subgraph Verbs["Granted Verbs"]
        Create["create"]
        Delete["delete"]
        Get["get"]
        List["list"]
        Patch["patch"]
        Update["update"]
        Watch["watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"on resource"| ConfigMaps
    ConfigMaps --> Create
    ConfigMaps --> Delete
    ConfigMaps --> Get
    ConfigMaps --> List
    ConfigMaps --> Patch
    ConfigMaps --> Update
    ConfigMaps --> Watch

    subgraph Warning["Security Note"]
        RiskNote["ClusterRole grants ConfigMap CRUD<br/>across ALL namespaces.<br/>Init container uses oc apply to write<br/>model-serving-config ConfigMap.<br/>Consider scoping to namespace Role."]
    end

    CR -.->|"risk: over-permissioned"| Warning

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#50c8e8,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style Warning fill:#ff6b6b,stroke:#333,color:#fff
    style Create fill:#f0f0f0,stroke:#666
    style Delete fill:#f0f0f0,stroke:#666
    style Get fill:#f0f0f0,stroke:#666
    style List fill:#f0f0f0,stroke:#666
    style Patch fill:#f0f0f0,stroke:#666
    style Update fill:#f0f0f0,stroke:#666
    style Watch fill:#f0f0f0,stroke:#666
