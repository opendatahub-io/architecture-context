graph TB
    subgraph NotebooksRepo["Notebooks Repository (Container Image Factory)"]
        direction TB

        subgraph JupyterImages["Jupyter Workbenches"]
            JupyterMinimal["jupyter/minimal<br/>Minimal JupyterLab<br/>Port: 8888/TCP"]
            JupyterDS["jupyter/datascience<br/>Data Science JupyterLab<br/>pandas, scikit-learn, ONNX"]
            JupyterPyTorch["jupyter/pytorch<br/>PyTorch CUDA JupyterLab"]
            JupyterLLMC["jupyter/pytorch+llmcompressor<br/>LLM Compressor CUDA"]
            JupyterTF["jupyter/tensorflow<br/>TensorFlow CUDA"]
            JupyterTrustyAI["jupyter/trustyai<br/>TrustyAI Explainability"]
            JupyterROCmPT["jupyter/rocm/pytorch<br/>PyTorch ROCm (AMD)"]
            JupyterROCmTF["jupyter/rocm/tensorflow<br/>TensorFlow ROCm (AMD)"]
        end

        subgraph CodeServerImages["Code-Server Workbenches"]
            CodeServerDS["codeserver<br/>VS Code Data Science<br/>Port: 8787/TCP"]
            CodeServerBaseline["codeserver-baseline<br/>VS Code Baseline"]
            CodeServerChe["codeserver/che-code<br/>Eclipse Che Variant"]
        end

        subgraph RuntimeImages["Elyra Pipeline Runtimes"]
            RuntimeMinimal["runtimes/minimal<br/>Minimal Pipeline Runtime"]
            RuntimeDS["runtimes/datascience<br/>Data Science Runtime"]
            RuntimePyTorch["runtimes/pytorch<br/>PyTorch CUDA Runtime"]
            RuntimeLLMC["runtimes/pytorch+llmcompressor<br/>LLM Compressor Runtime"]
            RuntimeTF["runtimes/tensorflow<br/>TensorFlow CUDA Runtime"]
            RuntimeROCmPT["runtimes/rocm-pytorch<br/>ROCm PyTorch Runtime"]
            RuntimeROCmTF["runtimes/rocm-tensorflow<br/>ROCm TensorFlow Runtime"]
        end

        subgraph BuildTools["Build-Time Tools"]
            BuildInputs["scripts/buildinputs<br/>Go - Dockerfile Parser"]
            CheckPayload["scripts/check-payload<br/>Go - FIPS Compliance Scanner"]
        end
    end

    subgraph BaseImages["AIPCC Base Images"]
        CPUBase["cpu-el9.8:3.6.0<br/>CPU Base"]
        CUDABase13["cuda-13.0-el9.8:3.6.0<br/>NVIDIA CUDA 13.0"]
        CUDABase12["cuda-12.9-el9.8:3.6.0<br/>NVIDIA CUDA 12.9"]
        ROCmBase["rocm-7.14-el9.8:3.6.0<br/>AMD ROCm 7.14"]
    end

    subgraph BuildSystem["Konflux Build System"]
        Cachi2["Cachi2 Prefetch<br/>Hermetic Dependencies"]
        Konflux["Konflux Pipelines<br/>Build Orchestration"]
    end

    subgraph Consumers["Image Consumers"]
        WBOperator["Workbenches Operator<br/>Launches Notebook Pods"]
        Dashboard["ODH Dashboard<br/>Notebook Catalog UI"]
        DSP["Data Science Pipelines<br/>Pipeline Step Execution"]
    end

    subgraph Registry["Container Registry"]
        RegistryRHIO["registry.redhat.io/rhoai/<br/>Digest-Pinned Images"]
    end

    %% Build dependencies
    CPUBase --> JupyterMinimal
    CPUBase --> JupyterDS
    CPUBase --> CodeServerDS
    CPUBase --> RuntimeMinimal
    CUDABase13 --> JupyterPyTorch
    CUDABase13 --> JupyterLLMC
    CUDABase13 --> JupyterTF
    CUDABase13 --> RuntimePyTorch
    ROCmBase --> JupyterROCmPT
    ROCmBase --> JupyterROCmTF

    Cachi2 -->|prefetched deps| Konflux
    Konflux -->|builds| NotebooksRepo
    Konflux -->|pushes| RegistryRHIO

    %% Consumer relationships
    RegistryRHIO -->|image pull| WBOperator
    RegistryRHIO -->|ImageStream read| Dashboard
    RegistryRHIO -->|image pull| DSP

    %% Styling
    style NotebooksRepo fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style JupyterImages fill:#d5e8d4,stroke:#82b366
    style CodeServerImages fill:#dae8fc,stroke:#6c8ebf
    style RuntimeImages fill:#fff2cc,stroke:#d6b656
    style BuildTools fill:#f8cecc,stroke:#b85450
    style BaseImages fill:#e1d5e7,stroke:#9673a6
    style BuildSystem fill:#ffe6cc,stroke:#d79b00
    style Consumers fill:#d5e8d4,stroke:#82b366
    style Registry fill:#f5f5f5,stroke:#666666
