graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["API Client"]
    end

    subgraph OrchestratorZone["ORCHESTRATOR SERVICE"]
        direction TB

        subgraph GuardrailsAPI["Guardrails API (Port 8033/TCP)"]
            GS["guardrails-server<br/>HTTP/HTTPS<br/>TLS 1.2+ (rustls/ring)<br/>Optional mTLS (WebPkiClientVerifier)<br/>Header passthrough"]
        end

        subgraph HealthAPI["Health API (Port 8034/TCP)"]
            HS["health-server<br/>HTTP plaintext<br/>No auth"]
        end
    end

    subgraph InternalServices["INTERNAL SERVICES (Platform-managed)"]
        direction TB

        TGIS["TGIS Generation Service<br/>8033/TCP gRPC<br/>TLS (optional)"]
        CaikitNLP["Caikit NLP Service<br/>gRPC<br/>TLS (optional)"]
        OpenAI["OpenAI-compatible Service<br/>HTTP/HTTPS<br/>TLS (optional)<br/>Bearer token (optional)"]
        DetectorSvc["Detector Services<br/>8080/TCP HTTP/HTTPS<br/>TLS (optional)<br/>Bearer token (optional)"]
        DetectorHealth["Detector Health<br/>8081/TCP HTTP<br/>No auth"]
        ChunkerSvc["Chunker Services<br/>8085/TCP gRPC<br/>TLS (optional)"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTLP["OTLP Collector<br/>gRPC/HTTP<br/>Configurable"]
    end

    %% Inbound flows
    Client -->|"HTTPS/8033<br/>TLS 1.2+ (optional)<br/>Passthrough headers<br/>X-Forwarded-Access-Token rewrite"| GS
    Client -.->|"HTTP/8034<br/>Plaintext<br/>No auth"| HS

    %% Outbound flows
    GS -->|"gRPC/8033<br/>TLS (optional)<br/>No auth"| TGIS
    GS -->|"gRPC<br/>TLS (optional)<br/>No auth"| CaikitNLP
    GS -->|"HTTP(S)<br/>TLS (optional)<br/>Bearer token"| OpenAI
    GS -->|"HTTP(S)/8080<br/>TLS (optional)<br/>Bearer token"| DetectorSvc
    GS -.->|"HTTP/8081<br/>No auth"| DetectorHealth
    GS -->|"gRPC/8085<br/>TLS (optional)<br/>No auth"| ChunkerSvc
    GS -.->|"gRPC/HTTP<br/>Configurable"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef orchestrator fill:#4a90e2,stroke:#2a6ab2,stroke-width:2px,color:#fff
    classDef healthsvc fill:#6baed6,stroke:#2a6ab2,stroke-width:2px,color:#fff
    classDef internal fill:#7ed321,stroke:#5aa016,stroke-width:2px,color:#fff
    classDef observability fill:#999,stroke:#666,stroke-width:2px,color:#fff

    class Client external
    class GS orchestrator
    class HS healthsvc
    class TGIS,CaikitNLP,OpenAI,DetectorSvc,DetectorHealth,ChunkerSvc internal
    class OTLP observability
