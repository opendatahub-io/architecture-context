graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["trainer-operator-controller-manager<br/>(trainer-operator-system)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["trainer-operator-manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["trainer-operator-manager-role"]
        CR_MetricsReader["trainer-operator-metrics-reader"]
        CR_Admin["trainer-operator-trainer-admin-role"]
        CR_Viewer["trainer-operator-trainer-viewer-role"]
        CR_TLS["trainer-tls-profile"]
    end

    subgraph APIResources["API Resources"]
        Trainers["components.platform.opendatahub.io<br/>Trainer, Trainer/status, Trainer/finalizers"]
        CoreResources["core<br/>namespaces, configmaps, secrets,<br/>services, serviceaccounts, pods,<br/>limitranges, events"]
        Deployments["apps<br/>Deployments"]
        Webhooks["admissionregistration.k8s.io<br/>MutatingWebhookConfigurations,<br/>ValidatingWebhookConfigurations"]
        CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        TrainerResources["trainer.kubeflow.org<br/>ClusterTrainingRuntimes,<br/>TrainingRuntimes, TrainJobs,<br/>OptimizationJobs"]
        JobSets["jobset.x-k8s.io<br/>JobSets"]
        RBAC_Res["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings,<br/>Roles, RoleBindings"]
        Monitoring["monitoring.coreos.com<br/>PodMonitors, ServiceMonitors"]
        NetPolicies["networking.k8s.io<br/>NetworkPolicies"]
        OSConfig["config.openshift.io<br/>APIServers, ClusterVersions"]
        OSImages["image.openshift.io<br/>ImageStreams"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        Metrics["/metrics"]
    end

