graph LR
    Trainer["Kubeflow Trainer<br/>Operator"]

    %% External Dependencies (required runtime)
    Trainer -->|"creates/watches<br/>JobSet CRDs"| JobSet["JobSet Controller<br/>v0.12.0"]
    Trainer -->|"TLS profile<br/>resolution"| OpenShiftAPI["OpenShift API<br/>(config.openshift.io)"]
    Trainer -->|"webhook certs<br/>lifecycle"| CertController["cert-controller<br/>(OPA) v0.16.0"]
    Trainer -->|"OIDC token<br/>verification"| GoOIDC["go-oidc v3.21.0"]

    %% Gang Scheduling (optional, one of)
    Trainer -.->|"PodGroup CRDs<br/>(gang scheduling)"| CoScheduling["CoScheduling<br/>(scheduler-plugins)<br/>v0.35.4"]
    Trainer -.->|"PodGroup CRDs<br/>(alternative)"| Volcano["Volcano Scheduler<br/>v1.13.1"]

    %% Hyperparameter Search
    Trainer -->|"OptimizationJob<br/>trial mgmt"| Katib["Katib<br/>v0.19.0"]

    %% Build Dependencies
    Trainer -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    Trainer -->|"K8s API types"| K8sAPI["k8s.io/api<br/>v0.37.0"]

    %% Monitoring Integration
    Prometheus["Prometheus<br/>(openshift-monitoring)"] -->|"ServiceMonitor<br/>scrape 8443/TCP"| Trainer

    %% Python Dependencies (init containers)
    subgraph InitContainerDeps["Init Container Dependencies (Python)"]
        HFHub["huggingface-hub<br/>>=0.27.0"]
        OpenDAL["opendal<br/>>=0.46.0"]
        K8sPython["kubernetes (Python)<br/>>=27.2.0"]
    end

    Trainer -->|"dataset/model<br/>downloads"| HFHub
    Trainer -->|"object storage<br/>access"| OpenDAL
    Trainer -->|"K8s client<br/>(initializers)"| K8sPython

