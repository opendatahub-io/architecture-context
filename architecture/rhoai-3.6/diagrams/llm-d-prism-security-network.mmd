graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Browser / API Client"]
    end

    subgraph Ingress["INGRESS (Google Cloud Run)"]
        CloudRunLB["Cloud Run Load Balancer<br/>prism.llm-d.ai<br/>443/TCP → 8080/TCP<br/>TLS: Google-managed"]
    end

    subgraph Application["APPLICATION (Cloud Run Container)"]
        direction TB

        Express["Express BFF Server<br/>8080/TCP HTTP<br/>Node.js 26 Alpine<br/>Rate: 50k req/min/IP"]

        subgraph AuthLayer["Application-Level Auth"]
            OAuth["GitHub OAuth Module<br/>Token validation + org membership"]
            IAM["IAM Module<br/>GCS allowlists + playground mode"]
        end

        subgraph Endpoints["API Endpoints"]
            GCSProxy["/api/gcs/* — GCS Proxy"]
            GIQProxy["/api/giq/* — GIQ Proxy"]
            ResultsAPI["/api/results/* — Results Store"]
            PublicAPIs["/api/regressions, prefix-cache,<br/>pd-disaggregation — Public Read"]
        end

        Express --> AuthLayer
        Express --> Endpoints
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        GCS["Google Cloud Storage<br/>storage.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer ADC"]
        GIQ["GKE Recommender API<br/>gkerecommender.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer ADC/user"]
        GitHub["GitHub<br/>github.com / api.github.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth + Bearer"]
        Arena["LMSYS Arena<br/>arena.ai<br/>443/TCP HTTPS<br/>⚠ SSL verify DISABLED"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (Google-managed)<br/>Optional GitHub token"| CloudRunLB
    CloudRunLB -->|"HTTP/8080<br/>Plaintext (internal)<br/>Headers forwarded"| Express
    GCSProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (ADC)"| GCS
    ResultsAPI -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (ADC)"| GCS
    PublicAPIs -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (ADC)"| GCS
    GIQProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (ADC/user)"| GIQ
    OAuth -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth client creds"| GitHub
    IAM -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (ADC)"| GCS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class CloudRunLB ingress
    class Express,OAuth,IAM,GCSProxy,GIQProxy,ResultsAPI,PublicAPIs application
    class GCS,GIQ,GitHub externalservice
    class Arena warning
