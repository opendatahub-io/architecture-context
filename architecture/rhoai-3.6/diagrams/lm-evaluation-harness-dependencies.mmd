graph LR
    LMEval["lm-evaluation-harness<br/>(Batch Job)"]

    %% Internal RHOAI Dependencies
    LMEval -->|"HTTP callbacks<br/>status + results"| EvalHub["EvalHub Service"]
    LMEval -->|"POST /v1/completions<br/>OpenAI-compatible"| ModelEndpoint["Model Inference<br/>Endpoint"]
    LMEval -->|"Job orchestration<br/>K8s Job creation"| LMEvalOperator["TrustyAI /<br/>LMEval Operator"]

    %% External Service Dependencies
    LMEval -->|"OCI push<br/>artifacts"| OCIRegistry["OCI Registry"]
    LMEval -->|"GET tokenizers<br/>+ datasets"| HFHub["HuggingFace Hub"]
    LMEval -->|"S3 API<br/>data download"| S3["AWS S3-Compatible<br/>Storage"]
    LMEval -->|"REST<br/>log metrics"| MLflow["MLflow"]

    %% Core Python Dependencies
    LMEval -->|"deep learning"| PyTorch["torch >=2.6.0"]
    LMEval -->|"tokenization"| Transformers["transformers >=4.48.0"]
    LMEval -->|"distributed inference"| Accelerate["accelerate >=1.0.1"]
    LMEval -->|"benchmark data"| Datasets["datasets >=3.1.0"]
    LMEval -->|"adapter SDK"| EvalHubSDK["eval-hub-sdk ~=1.0.0"]
    LMEval -->|"metrics"| Sklearn["scikit-learn >=1.5.2"]
    LMEval -->|"OCI artifacts"| Olot["olot >=0.1.15"]
    LMEval -->|"S3 access"| Boto3["boto3 >=1.42.12"]
    LMEval -->|"HTTP client"| Requests["requests ==2.32.5"]
    LMEval -->|"async HTTP"| Aiohttp["aiohttp ==3.13.3"]
    LMEval -.->|"optional"| WatsonX["ibm-watsonx-ai ==1.4.11"]
    LMEval -->|"eval tasks"| Unitxt["unitxt >=1.17.2"]
    LMEval -->|"LoRA adapters"| PEFT["peft >=0.13.2"]
    LMEval -->|"container inspect"| Skopeo["skopeo (system)"]

