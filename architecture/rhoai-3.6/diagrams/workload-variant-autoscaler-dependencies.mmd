graph LR
    WVA["WVA Controller<br/>(workload-variant-autoscaler)"]

    %% Internal Platform Dependencies
    WVA -->|"queries metrics<br/>HTTPS/9090-9091"| Prometheus["Prometheus /<br/>Thanos Querier"]
    WVA -->|"watches InferencePool CRs<br/>+ imports API types"| GAIE["Gateway API<br/>Inference Extension"]
    WVA -->|"watches ScaledObject CRs<br/>(conditional)"| KEDA["KEDA"]
    WVA -->|"scales LWS workloads<br/>(conditional)"| LWS["LeaderWorkerSet"]
    WVA -->|"ServiceMonitor config"| PromOperator["prometheus-operator"]

    %% External Infrastructure Dependencies
    WVA -->|"watch/list/patch resources<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]

    %% Build / Runtime Dependencies
    WVA -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    WVA -->|"API client"| ClientGo["client-go<br/>v0.34.5"]
    WVA -->|"InferencePool types"| GAIELib["gateway-api-inference-ext<br/>v1.2.1"]
    WVA -->|"ScaledObject types"| KEDALib["keda/v2<br/>v2.18.3"]
    WVA -->|"LWS types"| LWSLib["lws<br/>v0.8.0"]
    WVA -->|"Prometheus API client"| PromClient["prometheus client_golang<br/>v1.23.2"]
    WVA -->|"config management"| Viper["viper<br/>v1.21.0"]
    WVA -->|"metrics smoothing"| Kalman["kalman-filter<br/>v0.1.2"]

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal platform
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style GAIE fill:#7ed321,stroke:#333,color:#fff
    style KEDA fill:#7ed321,stroke:#333,color:#fff,stroke-dasharray:5 5
    style LWS fill:#7ed321,stroke:#333,color:#fff,stroke-dasharray:5 5
    style PromOperator fill:#7ed321,stroke:#333,color:#fff

    %% External infra
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff

    %% Libraries
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style ClientGo fill:#999,stroke:#333,color:#fff
    style GAIELib fill:#999,stroke:#333,color:#fff
    style KEDALib fill:#999,stroke:#333,color:#fff
    style LWSLib fill:#999,stroke:#333,color:#fff
    style PromClient fill:#999,stroke:#333,color:#fff
    style Viper fill:#999,stroke:#333,color:#fff
    style Kalman fill:#999,stroke:#333,color:#fff
