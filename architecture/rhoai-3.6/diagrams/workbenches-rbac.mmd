graph TD
    subgraph ServiceAccounts["Service Accounts (kubeflow-workspaces)"]
        SA_Controller["workspaces-controller"]
        SA_Backend["workspaces-backend"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["workspaces-manager-rolebinding"]
        CRB_Backend["workspaces-backend"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["workspaces-manager-role"]
        CR_Backend["workspaces-backend"]
        CR_TLS["workspaces-controller-tls-profile-role"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        direction TB
        MR_Core_RO["core<br/>configmaps, events,<br/>namespaces, pods<br/><i>get, list, watch</i>"]
        MR_PodExec["core<br/>pods/exec<br/><i>create</i>"]
        MR_Core_RW["core<br/>serviceaccounts, services<br/><i>CRUD + watch</i>"]
        MR_Apps["apps<br/>statefulsets<br/><i>CRUD + watch</i>"]
        MR_AuthN["authentication.k8s.io<br/>tokenreviews<br/><i>create</i>"]
        MR_AuthZ["authorization.k8s.io<br/>subjectaccessreviews<br/><i>create</i>"]
        MR_KF["kubeflow.org<br/>workspaces, workspacekinds<br/><i>CRUD + watch</i>"]
        MR_KF_Fin["kubeflow.org<br/>workspaces/finalizers,<br/>workspacekinds/finalizers<br/><i>update</i>"]
        MR_KF_Status["kubeflow.org<br/>workspaces/status,<br/>workspacekinds/status<br/><i>get, patch, update</i>"]
        MR_Istio["networking.istio.io<br/>virtualservices<br/><i>CRUD + watch</i>"]
        MR_RBAC_Bind["rbac.authorization.k8s.io<br/>clusterroles<br/><i>bind</i>"]
        MR_RBAC_RB["rbac.authorization.k8s.io<br/>rolebindings<br/><i>CRUD + watch</i>"]
    end

    subgraph BackendResources["Backend Role Resources"]
        direction TB
        BR_KF["kubeflow.org<br/>workspaces, workspacekinds<br/><i>CRUD + watch</i>"]
        BR_Core_RO["core<br/>namespaces, configmaps<br/><i>get, list, watch</i>"]
        BR_Secrets["core<br/>secrets<br/><i>get, list, watch, create,<br/>update, delete</i>"]
        BR_Pods["core<br/>pods<br/><i>get, list, watch</i>"]
        BR_PodLogs["core<br/>pods/log<br/><i>get</i>"]
        BR_PVC["core<br/>persistentvolumeclaims<br/><i>get, list, watch,<br/>create, delete</i>"]
        BR_PV["core<br/>persistentvolumes<br/><i>get, list, watch</i>"]
        BR_SC["storage.k8s.io<br/>storageclasses<br/><i>get, list, watch</i>"]
        BR_Metrics["metrics.k8s.io<br/>pods<br/><i>get, list</i>"]
        BR_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/><i>create</i>"]
    end

    subgraph TLSResources["TLS Profile Role Resources"]
        TR_APIServers["config.openshift.io<br/>apiservers<br/><i>get, list, watch</i>"]
    end

    %% Bindings
    SA_Controller -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager
    SA_Controller -.->|bound via| CR_TLS

    SA_Backend -->|bound via| CRB_Backend
    CRB_Backend -->|grants| CR_Backend

    %% Manager role to resources
    CR_Manager -->|permits| MR_Core_RO
    CR_Manager -->|permits| MR_PodExec
    CR_Manager -->|permits| MR_Core_RW
    CR_Manager -->|permits| MR_Apps
    CR_Manager -->|permits| MR_AuthN
    CR_Manager -->|permits| MR_AuthZ
    CR_Manager -->|permits| MR_KF
    CR_Manager -->|permits| MR_KF_Fin
    CR_Manager -->|permits| MR_KF_Status
    CR_Manager -->|permits| MR_Istio
    CR_Manager -->|permits| MR_RBAC_Bind
    CR_Manager -->|permits| MR_RBAC_RB

    %% Backend role to resources
    CR_Backend -->|permits| BR_KF
    CR_Backend -->|permits| BR_Core_RO
    CR_Backend -->|permits| BR_Secrets
    CR_Backend -->|permits| BR_Pods
    CR_Backend -->|permits| BR_PodLogs
    CR_Backend -->|permits| BR_PVC
    CR_Backend -->|permits| BR_PV
    CR_Backend -->|permits| BR_SC
    CR_Backend -->|permits| BR_Metrics
    CR_Backend -->|permits| BR_SAR

    %% TLS role to resources
    CR_TLS -->|permits| TR_APIServers

