graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client (CLI / SDK / Agent)"]
    end

    subgraph Ingress["INGRESS (Optional)"]
        Route["OpenShift Route / GRPCRoute<br/>443/TCP<br/>TLS 1.2+ (edge/passthrough)"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        Gateway["OpenShell Gateway<br/>8080/TCP gRPC+HTTP<br/>rustls 0.23 + aws-lc-rs<br/>SA: openshell gateway<br/>Image: odh-openshell-gateway-rhel9<br/>Post-Quantum: DEFAULT:PQ"]
    end

    subgraph SandboxRuntime["SANDBOX RUNTIME (Per-Sandbox Pod)"]
        direction TB

        Supervisor["Supervisor Sidecar<br/>5500/TCP boundary<br/>mTLS (gateway cert)<br/>Image: odh-openshell-supervisor-rhel9<br/>Policy eval + credential injection"]

        SandboxBin["Sandbox Binary<br/>2222/TCP SSH<br/>Static glibc + NSS pin<br/>Image: odh-openshell-sandbox-rhel9<br/>seccomp-mediated I/O"]
    end

    subgraph DriverLayer["DRIVER LAYER (UDS - In-Process)"]
        K8sCompute["Kubernetes ComputeDriver<br/>UDS gRPC<br/>No encryption"]
        K8sCreds["K8s Secrets CredentialDriver<br/>UDS gRPC<br/>No encryption"]
        VaultCreds["Vault CredentialDriver<br/>UDS gRPC<br/>No encryption"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        OIDC["OIDC Providers<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Client Credentials"]
        AIProvider["AI Inference Providers<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Injected Credentials"]
        PostgreSQL["PostgreSQL (optional)<br/>5432/TCP<br/>TLS (optional)<br/>Secret-based Auth"]
        Vault["Vault (optional)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Vault Token"]
    end

    %% External to Ingress
    Client -->|"gRPC/HTTPS 443<br/>TLS 1.2+<br/>Bearer/OIDC"| Route

    %% Ingress to Gateway
    Route -->|"gRPC 8080<br/>TLS 1.2+"| Gateway

    %% Gateway to Sandbox Runtime
    Gateway -->|"gRPC 5500<br/>mTLS<br/>Gateway-issued cert"| Supervisor
    Gateway -->|"SSH 2222<br/>SSH encryption<br/>Sandbox token<br/>(NetworkPolicy restricted)"| SandboxBin

    %% Supervisor to Sandbox
    Supervisor -->|"UDS gRPC<br/>Sandbox Protocol<br/>No encryption (local)"| SandboxBin

    %% Gateway to Drivers
    Gateway -->|"UDS gRPC<br/>No encryption"| K8sCompute
    Gateway -->|"UDS gRPC"| K8sCreds
    Gateway -->|"UDS gRPC"| VaultCreds

    %% Driver to External
    K8sCompute -->|"HTTPS 443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Gateway to External
    Gateway -->|"HTTPS 443<br/>TLS 1.2+<br/>Client Credentials"| OIDC
    Gateway -->|"PostgreSQL 5432<br/>TLS (optional)<br/>Secret-based"| PostgreSQL

    %% Supervisor to External (proxied)
    Supervisor -->|"HTTPS 443<br/>TLS 1.2+<br/>Injected creds / SigV4"| AIProvider

    %% Vault driver to Vault
    VaultCreds -->|"HTTPS 443<br/>TLS 1.2+"| Vault

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef sandbox fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef driver fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route ingress
    class Gateway controlplane
    class Supervisor,SandboxBin sandbox
    class K8sCompute,K8sCreds,VaultCreds driver
    class K8sAPI,OIDC,AIProvider,PostgreSQL,Vault externalservice
