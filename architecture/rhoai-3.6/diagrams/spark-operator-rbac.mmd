graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["spark-operator-controller"]
        SA_Webhook["spark-operator-webhook"]
        SA_Module["spark-operator-module-<br/>controller-manager"]
        SA_Spark["spark-operator-spark<br/>(per-namespace, driver pods)"]
    end

    subgraph ControllerRBAC["Controller ClusterRole"]
        CR_Controller["spark-operator-controller"]
    end

    subgraph WebhookRBAC["Webhook ClusterRole"]
        CR_Webhook["spark-operator-webhook"]
    end

    subgraph TLSProfileRBAC["TLS Profile ClusterRole"]
        CR_TLS["spark-operator-tls-profile"]
    end

    subgraph ModuleRBAC["Module Manager ClusterRole"]
        CR_Module["spark-operator-module-manager-role<br/>(ELEVATED: bind, escalate)"]
    end

    subgraph AggregatedRoles["Aggregated Viewer/Editor Roles"]
        CR_Viewer["sparkapplication-viewer-role<br/>(aggregate-to-view)"]
        CR_Editor["sparkapplication-editor-role<br/>(aggregate-to-edit)"]
        CR_SchedViewer["scheduledsparkapplication-viewer-role"]
        CR_SchedEditor["scheduledsparkapplication-editor-role"]
    end

    subgraph ControllerResources["Controller API Resources"]
        Pods["core<br/>pods"]
        Services["core<br/>services"]
        ConfigMaps["core<br/>configmaps"]
        Events["core<br/>events"]
        Ingresses["networking.k8s.io<br/>ingresses"]
        PDBs["policy<br/>poddisruptionbudgets"]
        SparkApps["sparkoperator.k8s.io<br/>sparkapplications<br/>+/finalizers +/status"]
        ScheduledApps["sparkoperator.k8s.io<br/>scheduledsparkapplications<br/>+/finalizers +/status"]
        SparkConnects["sparkoperator.k8s.io<br/>sparkconnects<br/>+/finalizers +/status"]
        CRDs_Ext["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    subgraph WebhookResources["Webhook API Resources"]
        ResourceQuotas["core<br/>resourcequotas"]
        WebhookConfigs["admissionregistration.k8s.io<br/>mutating/validating<br/>webhookconfigurations"]
    end

    subgraph ModuleResources["Module Manager API Resources"]
        Deployments["apps<br/>deployments"]
        Certificates["cert-manager.io<br/>certificates, issuers"]
        SparkOperatorCR["components.platform.opendatahub.io<br/>sparkoperators +/status +/finalizers"]
        PodMonitors["monitoring.coreos.com<br/>podmonitors"]
        NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
        RBACResources["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings<br/>roles, rolebindings +/finalizers"]
    end

    %% Controller bindings
    SA_Controller -->|"bound via ClusterRoleBinding"| CR_Controller
    SA_Controller -->|"bound via"| CR_TLS
    CR_Controller -->|"create,delete,get,list,<br/>patch,update,watch"| Pods
    CR_Controller -->|"create,delete,get,list,<br/>patch,update,watch"| Services
    CR_Controller -->|"create,delete,get,list,<br/>patch,update,watch"| ConfigMaps
    CR_Controller -->|"create,delete,get,list,<br/>patch,update,watch"| Events
    CR_Controller -->|"create,delete,get,update"| Ingresses
    CR_Controller -->|"create,delete,get,<br/>list,watch"| PDBs
    CR_Controller -->|"full CRUD + watch"| SparkApps
    CR_Controller -->|"full CRUD + watch"| ScheduledApps
    CR_Controller -->|"full CRUD + watch"| SparkConnects
    CR_Controller -->|"get"| CRDs_Ext

    %% Webhook bindings
    SA_Webhook -->|"bound via ClusterRoleBinding"| CR_Webhook
    SA_Webhook -->|"bound via"| CR_TLS
    CR_Webhook -->|"list,watch"| ResourceQuotas
    CR_Webhook -->|"get,list,watch,update"| WebhookConfigs
    CR_Webhook -->|"get,list,watch"| SparkApps

    %% TLS Profile
    CR_TLS -->|"get,list,watch"| OpenShiftAPI["config.openshift.io<br/>apiservers"]

    %% Module controller bindings
    SA_Module -->|"bound via ClusterRoleBinding"| CR_Module
    CR_Module -->|"full CRUD"| Deployments
    CR_Module -->|"full CRUD"| Certificates
    CR_Module -->|"get,list,watch,<br/>patch,update"| SparkOperatorCR
    CR_Module -->|"full CRUD"| PodMonitors
    CR_Module -->|"create,delete,get,<br/>list,patch,watch"| NetworkPolicies
    CR_Module -->|"full CRUD +<br/>bind + escalate"| RBACResources

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Webhook fill:#4a90e2,stroke:#333,color:#fff
    style SA_Module fill:#9b59b6,stroke:#333,color:#fff
    style SA_Spark fill:#2ecc71,stroke:#333
    style CR_Controller fill:#f5a623,stroke:#333
    style CR_Webhook fill:#f5a623,stroke:#333
    style CR_TLS fill:#f5a623,stroke:#333
    style CR_Module fill:#e74c3c,stroke:#333,color:#fff
    style CR_Viewer fill:#bdc3c7,stroke:#333
    style CR_Editor fill:#bdc3c7,stroke:#333
    style CR_SchedViewer fill:#bdc3c7,stroke:#333
    style CR_SchedEditor fill:#bdc3c7,stroke:#333
    style SparkApps fill:#7ed321,stroke:#333
    style ScheduledApps fill:#7ed321,stroke:#333
    style SparkConnects fill:#7ed321,stroke:#333
    style RBACResources fill:#e74c3c,stroke:#333,color:#fff
