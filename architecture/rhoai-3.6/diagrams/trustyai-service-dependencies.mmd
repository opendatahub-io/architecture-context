graph LR
    TrustyAI["TrustyAI Service<br/>(FastAPI + Hypercorn)"]

    %% Runtime Dependencies
    TrustyAI -->|"ASGI server"| Hypercorn["Hypercorn 0.18+"]
    TrustyAI -->|"HTTP framework"| FastAPI["FastAPI 0.116+"]
    TrustyAI -->|"validation"| Pydantic["Pydantic 2.13+"]

    %% Compute Dependencies
    TrustyAI -->|"statistics"| SciPy["SciPy 1.15+"]
    TrustyAI -->|"fairness"| ScikitLearn["scikit-learn 1.7+"]
    TrustyAI -->|"arrays"| NumPy["NumPy 2.0+"]
    TrustyAI -->|"DataFrames"| Pandas["Pandas 3.0+"]
    TrustyAI -->|"DataFrames"| Polars["Polars 1.2+"]

    %% Storage Dependencies
    TrustyAI -->|"HDF5 I/O"| H5py["h5py 3.13+"]
    TrustyAI -.->|"relational storage<br/>(optional)"| MariaDBLib["mariadb 1.1+"]

    %% Observability Dependencies
    TrustyAI -->|"metrics publishing"| PromClient["prometheus-client 0.22+"]

    %% Protocol Dependencies
    TrustyAI -->|"KServe v2 payloads"| Protobuf["protobuf 7+"]
    TrustyAI -->|"schedule parsing"| Isodate["isodate 0.7+"]

    %% Internal RHOAI Platform Dependencies
    TrustyAI -->|"auth sidecar<br/>HTTP/8081"| KubeRBACProxy["kube-rbac-proxy"]
    TrustyAI -->|"inference payloads<br/>HTTP/8080"| KServe["KServe /<br/>ModelMesh"]
    TrustyAI -->|"metrics scrape<br/>HTTP/8081"| Prometheus["Prometheus"]
    TrustyAI -->|"deployment<br/>lifecycle"| Operator["trustyai-service-<br/>operator"]

    %% Integration Points (incoming)
    Dashboard["ODH Dashboard"] -.->|"UI integration"| TrustyAI
    KServe -->|"CloudEvents"| TrustyAI

    %% External Storage
    TrustyAI -->|"MySQL/3306<br/>TLS optional"| MariaDB["MariaDB Server"]
    TrustyAI -->|"file I/O"| PVC["PVC / HDF5"]

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External runtime deps
    style Hypercorn fill:#e8e8e8,stroke:#333
    style FastAPI fill:#e8e8e8,stroke:#333
    style Pydantic fill:#e8e8e8,stroke:#333

    %% Compute deps
    style SciPy fill:#e8e8e8,stroke:#333
    style ScikitLearn fill:#e8e8e8,stroke:#333
    style NumPy fill:#e8e8e8,stroke:#333
    style Pandas fill:#e8e8e8,stroke:#333
    style Polars fill:#e8e8e8,stroke:#333

    %% Storage deps
    style H5py fill:#e8e8e8,stroke:#333
    style MariaDBLib fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5

    %% Protocol deps
    style PromClient fill:#e8e8e8,stroke:#333
    style Protobuf fill:#e8e8e8,stroke:#333
    style Isodate fill:#e8e8e8,stroke:#333

    %% Platform deps
    style KubeRBACProxy fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style Operator fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333

    %% External services
    style MariaDB fill:#f5a623,stroke:#333
    style PVC fill:#f5a623,stroke:#333
