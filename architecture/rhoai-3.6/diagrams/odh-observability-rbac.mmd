graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["odh-observability<br/>(operator)"]
        SA_ClusterProxy["data-science-prometheus<br/>-cluster-proxy"]
        SA_NSProxy["data-science-prometheus<br/>-namespace-proxy"]
        SA_ThanosProxy["data-science-thanos<br/>-querier-proxy"]
        SA_Korrel8r["korrel8r"]
        SA_Collector["data-science-collector<br/>-collector"]
        SA_Alertmanager["data-science-monitoringstack<br/>-alertmanager"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["odh-observability-manager"]
        CR_GenProc["generate-processors-role"]
        CR_MetricsView["data-science-metrics-view"]
        CR_MLflowTrace["data-science-collector<br/>-mlflow-trace-export"]
        CR_TempoTrace["data-science-collector<br/>-tempo-trace-export"]
        CR_Korrel8r["korrel8r-query"]
        CR_MonView["cluster-monitoring-view<br/>(built-in)"]
        CR_AuthDeleg["system:auth-delegator<br/>(built-in)"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        R_Monitoring["services.platform.opendatahub.io<br/>monitorings, monitorings/status"]
        R_COO["monitoring.rhobs<br/>monitoringstacks, thanosqueriers<br/>servicemonitors, prometheusrules"]
        R_Tempo["tempo.grafana.com<br/>tempomonolithics, tempostacks"]
        R_OTel["opentelemetry.io<br/>opentelemetrycollectors<br/>instrumentations"]
        R_Perses["perses.dev<br/>perses, persesdatasources<br/>persesdashboards"]
        R_Loki["loki.grafana.com<br/>lokistacks"]
        R_CertMgr["cert-manager.io<br/>issuers, certificates"]
        R_RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings<br/>clusterroles, clusterrolebindings"]
        R_Core["core<br/>configmaps, secrets<br/>services, serviceaccounts"]
    end

    subgraph QueryResources["Query Role Resources"]
        R_Pods["core<br/>pods, pods/log, services<br/>endpoints, configmaps<br/>events, namespaces"]
        R_Apps["apps<br/>deployments, replicasets<br/>statefulsets, daemonsets"]
        R_Batch["batch<br/>cronjobs, jobs"]
    end

    %% Manager bindings
    SA_Operator -->|"odh-observability-manager<br/>ClusterRoleBinding"| CR_Manager
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_Monitoring
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_COO
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_Tempo
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_OTel
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_Perses
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_Loki
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_CertMgr
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_RBAC
    CR_Manager -->|"get, list, watch<br/>create, update, patch, delete"| R_Core

    %% Proxy bindings
    SA_ClusterProxy -->|ClusterRoleBinding| CR_MonView
    SA_ClusterProxy -->|ClusterRoleBinding| CR_AuthDeleg
    SA_NSProxy -->|ClusterRoleBinding| CR_MonView
    SA_NSProxy -->|ClusterRoleBinding| CR_AuthDeleg
    SA_ThanosProxy -->|ClusterRoleBinding| CR_MonView
    SA_ThanosProxy -->|ClusterRoleBinding| CR_AuthDeleg

    %% Korrel8r bindings
    SA_Korrel8r -->|ClusterRoleBinding| CR_Korrel8r
    SA_Korrel8r -->|ClusterRoleBinding| CR_AuthDeleg
    CR_Korrel8r -->|"get, list, watch"| R_Pods
    CR_Korrel8r -->|"get, list, watch"| R_Apps
    CR_Korrel8r -->|"get, list, watch"| R_Batch

    %% Collector bindings
    SA_Collector -->|ClusterRoleBinding| CR_GenProc
    SA_Collector -->|ClusterRoleBinding| CR_MLflowTrace
    SA_Collector -->|ClusterRoleBinding| CR_TempoTrace

    %% Alertmanager bindings
    SA_Alertmanager -->|ClusterRoleBinding| CR_MonView

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_ClusterProxy fill:#4a90e2,stroke:#333,color:#fff
    style SA_NSProxy fill:#4a90e2,stroke:#333,color:#fff
    style SA_ThanosProxy fill:#4a90e2,stroke:#333,color:#fff
    style SA_Korrel8r fill:#4a90e2,stroke:#333,color:#fff
    style SA_Collector fill:#4a90e2,stroke:#333,color:#fff
    style SA_Alertmanager fill:#4a90e2,stroke:#333,color:#fff

    style CR_Manager fill:#f5a623,stroke:#333
    style CR_GenProc fill:#f5a623,stroke:#333
    style CR_MetricsView fill:#f5a623,stroke:#333
    style CR_MLflowTrace fill:#f5a623,stroke:#333
    style CR_TempoTrace fill:#f5a623,stroke:#333
    style CR_Korrel8r fill:#f5a623,stroke:#333
    style CR_MonView fill:#e8e8e8,stroke:#333
    style CR_AuthDeleg fill:#e8e8e8,stroke:#333

    style R_Monitoring fill:#7ed321,stroke:#333
    style R_COO fill:#7ed321,stroke:#333
    style R_Tempo fill:#7ed321,stroke:#333
    style R_OTel fill:#7ed321,stroke:#333
    style R_Perses fill:#7ed321,stroke:#333
    style R_Loki fill:#7ed321,stroke:#333
    style R_CertMgr fill:#7ed321,stroke:#333
    style R_RBAC fill:#7ed321,stroke:#333
    style R_Core fill:#7ed321,stroke:#333
    style R_Pods fill:#7ed321,stroke:#333
    style R_Apps fill:#7ed321,stroke:#333
    style R_Batch fill:#7ed321,stroke:#333
