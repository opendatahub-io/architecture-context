graph LR
    ODHGitOps["odh-gitops<br/>(GitOps Config Repository)"]

    %% External Tool Dependencies
    ODHGitOps -->|"manifest composition"| Kustomize["Kustomize v5+"]
    ODHGitOps -->|"chart templating"| Helm["Helm v3.18.6+"]
    ODHGitOps -->|"cluster interaction"| Kubectl["kubectl / oc"]
    ODHGitOps -.->|"continuous deployment"| ArgoCD["ArgoCD / Flux<br/>(optional)"]
    ODHGitOps -.->|"YAML patching"| Yq["yq<br/>(optional)"]

    %% Internal Platform Dependencies (Operators Installed)
    ODHGitOps -->|"TLS provisioning"| CertManager["cert-manager"]
    ODHGitOps -->|"job queues"| Kueue["Kueue"]
    ODHGitOps -->|"distributed inference"| LWS["Leader Worker Set"]
    ODHGitOps -->|"API auth"| RHCL["RHCL<br/>(Kuadrant/Authorino)"]
    ODHGitOps -->|"monitoring"| COO["Cluster Observability<br/>Operator"]
    ODHGitOps -->|"tracing"| OTel["OpenTelemetry"]
    ODHGitOps -->|"trace backend"| Tempo["Tempo"]
    ODHGitOps -->|"log storage"| Loki["Loki"]
    ODHGitOps -->|"autoscaling"| KEDA["KEDA<br/>(Custom Metrics Autoscaler)"]
    ODHGitOps -->|"HW detection"| NFD["Node Feature Discovery"]
    ODHGitOps -->|"GPU support"| NVIDIA["NVIDIA GPU Operator"]
    ODHGitOps -->|"job management"| JobSet["JobSet Operator"]
    ODHGitOps -.->|"database"| MariaDB["MariaDB Operator<br/>(optional)"]
    ODHGitOps -->|"agent execution"| AgentSandbox["Agent Sandbox Operator"]
    ODHGitOps -->|"platform lifecycle"| RHAIOp["ODH / RHOAI Operator"]

    %% Integration Points (consumers)
    DSC["DataScienceCluster CR"] -->|"configured by"| ODHGitOps
    DSCI["DSCInitialization CR"] -->|"configured by"| ODHGitOps
    GatewayAPI["Gateway API<br/>(Istio / SAIL)"] -->|"gateways from"| ODHGitOps

    style ODHGitOps fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

