graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_PROM["kube-prometheus-stack-prometheus"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_MGR["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_AUTH["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_READER["metrics-reader-rolebinding<br/>(NS: wva-monitoring)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
        RB_LEADER["leader-election-rolebinding<br/>(Namespace-scoped)"]
    end

    subgraph Roles["Roles"]
        CR_MGR["manager-role<br/>(ClusterRole)"]
        CR_AUTH["metrics-auth-role<br/>(ClusterRole)"]
        CR_READER["metrics-reader<br/>(ClusterRole)"]
        CR_EPP["epp-metrics-reader-role<br/>(ClusterRole)"]
        R_LEADER["leader-election-role<br/>(Role)"]
    end

    subgraph ManagerResources["manager-role Resources"]
        direction LR
        RES_CM["configmaps<br/>get,list,watch"]
        RES_NS["namespaces<br/>get,list,watch"]
        RES_NODES["nodes, nodes/status<br/>get,list,watch"]
        RES_PODS["pods<br/>get,list,watch"]
        RES_DEPLOY["deployments<br/>get,list,watch,patch,update"]
        RES_SCALE["deployments/scale<br/>get,update"]
        RES_HPA["horizontalpodautoscalers<br/>get,list,watch,patch,update"]
        RES_IP["inferencepools<br/>get,list,watch"]
        RES_SO["scaledobjects<br/>get,list,watch,patch,update"]
        RES_LWS["leaderworkersets<br/>get,list,watch,patch,update"]
        RES_LWS_SCALE["leaderworkersets/scale<br/>get,update"]
        RES_EVENTS["events<br/>create,patch"]
    end

    subgraph AuthResources["metrics-auth-role Resources"]
        RES_TR["tokenreviews<br/>create"]
        RES_SAR["subjectaccessreviews<br/>create"]
    end

    subgraph MetricsResources["metrics-reader Resources"]
        RES_METRICS["/metrics<br/>get"]
    end

    subgraph LeaderResources["leader-election-role Resources"]
        RES_LEASES["leases<br/>get,list,watch,create,<br/>update,patch,delete"]
        RES_LE_EVENTS["events<br/>create,patch"]
    end

    %% SA → Binding → Role
    SA_CM -->|bound via| CRB_MGR
    SA_CM -->|bound via| CRB_AUTH
    SA_CM -->|bound via| RB_LEADER
    SA_PROM -->|bound via| CRB_READER
    SA_EPP -->|bound via| CRB_EPP

    CRB_MGR -->|grants| CR_MGR
    CRB_AUTH -->|grants| CR_AUTH
    CRB_READER -->|grants| CR_READER
    CRB_EPP -->|grants| CR_EPP
    RB_LEADER -->|grants| R_LEADER

    %% Role → Resources
    CR_MGR -->|access| RES_CM
    CR_MGR -->|access| RES_NS
    CR_MGR -->|access| RES_NODES
    CR_MGR -->|access| RES_PODS
    CR_MGR -->|access| RES_DEPLOY
    CR_MGR -->|access| RES_SCALE
    CR_MGR -->|access| RES_HPA
    CR_MGR -->|access| RES_IP
    CR_MGR -->|access| RES_SO
    CR_MGR -->|access| RES_LWS
    CR_MGR -->|access| RES_LWS_SCALE
    CR_MGR -->|access| RES_EVENTS
    CR_AUTH -->|access| RES_TR
    CR_AUTH -->|access| RES_SAR
    CR_READER -->|access| RES_METRICS
    CR_EPP -->|access| RES_METRICS
    R_LEADER -->|access| RES_LEASES
    R_LEADER -->|access| RES_LE_EVENTS

