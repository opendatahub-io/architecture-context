graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["kubeflow-trainer-controller-manager<br/>(ns: opendatahub)"]
        SA_Prometheus["prometheus-k8s<br/>(ns: openshift-monitoring)"]
        SA_Users["system:authenticated<br/>(all authenticated users)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["kubeflow-trainer-controller-manager"]
        CRB_TLS["trainer-tls-profile"]
        CRB_Metrics["trainer-metrics-reader"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Public["kubeflow-trainer-public<br/>(ns: opendatahub)"]
    end

    subgraph ControllerRole["ClusterRole: kubeflow-trainer-controller-manager"]
        direction LR
        CR_Trainer["trainer.kubeflow.org<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes,<br/>optimizationjobs<br/>+ finalizers, status"]
        CR_JobSet["jobset.x-k8s.io<br/>jobsets<br/>full CRUD"]
        CR_PodGroups["scheduling.volcano.sh<br/>scheduling.x-k8s.io<br/>podgroups"]
        CR_Core["core<br/>configmaps, secrets,<br/>services, pods,<br/>limitranges"]
        CR_Apps["apps<br/>deployments<br/>full CRUD"]
        CR_NetPol["networking.k8s.io<br/>networkpolicies<br/>full CRUD"]
        CR_Auth["authentication.k8s.io<br/>tokenreviews<br/>authorization.k8s.io<br/>subjectaccessreviews"]
        CR_Admin["admissionregistration.k8s.io<br/>webhookconfigurations"]
        CR_Events["events.k8s.io<br/>events"]
        CR_Sched["node.k8s.io: runtimeclasses<br/>scheduling.k8s.io: priorityclasses<br/>coordination.k8s.io: leases"]
    end

    subgraph UserRoles["User-Facing ClusterRoles (Tiered RBAC)"]
        direction LR
        CR_Admin_User["training-admin<br/>Full CRUD on all<br/>Trainer CRDs"]
        CR_Edit["training-edit<br/>CRUD TrainJobs<br/>Read runtimes"]
        CR_View["training-view<br/>Read-only all CRDs<br/>(aggregated to 'view')"]
    end

    subgraph UtilityRoles["Utility ClusterRoles"]
        CR_TLS["trainer-tls-profile<br/>config.openshift.io: apiservers<br/>get, list, watch"]
        CR_MetricsRead["trainer-metrics-reader<br/>/metrics (non-resource URL)<br/>get"]
        CR_Public["kubeflow-trainer-public<br/>(Role, ns: opendatahub)<br/>configmaps: get, list"]
    end

    %% Bindings
    SA_Controller -->|bound via| CRB_Main
    CRB_Main -->|grants| ControllerRole

    SA_Controller -->|bound via| CRB_TLS
    CRB_TLS -->|grants| CR_TLS

    SA_Prometheus -->|bound via| CRB_Metrics
    CRB_Metrics -->|grants| CR_MetricsRead

    SA_Users -->|bound via| RB_Public
    RB_Public -->|grants| CR_Public

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Prometheus fill:#4a90e2,stroke:#333,color:#fff
    style SA_Users fill:#4a90e2,stroke:#333,color:#fff
    style CR_Trainer fill:#7ed321,stroke:#333
    style CR_JobSet fill:#7ed321,stroke:#333
    style CR_PodGroups fill:#7ed321,stroke:#333
    style CR_Core fill:#7ed321,stroke:#333
    style CR_Apps fill:#7ed321,stroke:#333
    style CR_NetPol fill:#7ed321,stroke:#333
    style CR_Auth fill:#7ed321,stroke:#333
    style CR_Admin fill:#7ed321,stroke:#333
    style CR_Events fill:#7ed321,stroke:#333
    style CR_Sched fill:#7ed321,stroke:#333
    style CR_Admin_User fill:#f5a623,stroke:#333
    style CR_Edit fill:#f5a623,stroke:#333
    style CR_View fill:#f5a623,stroke:#333
    style CR_TLS fill:#e8e8e8,stroke:#333
    style CR_MetricsRead fill:#e8e8e8,stroke:#333
    style CR_Public fill:#e8e8e8,stroke:#333
    style CRB_Main fill:#ddd,stroke:#333
    style CRB_TLS fill:#ddd,stroke:#333
    style CRB_Metrics fill:#ddd,stroke:#333
    style RB_Public fill:#ddd,stroke:#333
