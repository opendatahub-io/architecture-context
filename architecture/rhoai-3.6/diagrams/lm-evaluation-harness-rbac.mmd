graph TD
    subgraph "lm-evaluation-harness RBAC"
        direction TB

        Note["Note: No RBAC resources defined<br/>by this component directly.<br/>All RBAC is managed by the<br/>TrustyAI / LMEval Operator."]

        subgraph "Operator-Managed RBAC (External)"
            OperatorSA["LMEval Operator<br/>ServiceAccount"]
            OperatorCRB["Operator<br/>ClusterRoleBinding"]
            OperatorCR["Operator ClusterRole<br/>Manages LMEvalJob CRD"]
        end

        subgraph "Job Runtime Identity"
            JobSA["Job ServiceAccount<br/>(namespace-scoped,<br/>configured by operator)"]
            JobSecrets["Mounted Secrets"]
        end

        subgraph "Secrets (Environment Variables)"
            HFToken["HF_TOKEN<br/>HuggingFace auth"]
            OpenAIKey["OPENAI_API_KEY<br/>Model endpoint auth"]
            AnthropicKey["ANTHROPIC_API_KEY<br/>Anthropic API auth"]
            WatsonXKey["WATSONX_API_KEY<br/>WatsonX API auth"]
            AWSKey["AWS_SECRET_ACCESS_KEY<br/>S3 auth"]
            RegUser["REGISTRY_USERNAME<br/>OCI registry auth"]
            RegPass["REGISTRY_PASSWORD<br/>OCI registry auth"]
        end

        OperatorSA -->|bound via| OperatorCRB
        OperatorCRB -->|grants| OperatorCR
        OperatorCR -->|"creates Jobs with"| JobSA
        JobSA -->|"mounts"| JobSecrets
        JobSecrets -->|provides| HFToken
        JobSecrets -->|provides| OpenAIKey
        JobSecrets -->|provides| AnthropicKey
        JobSecrets -->|provides| WatsonXKey
        JobSecrets -->|provides| AWSKey
        JobSecrets -->|provides| RegUser
        JobSecrets -->|provides| RegPass
    end

    style Note fill:#fff3cd,stroke:#856404,color:#333
    style OperatorSA fill:#4a90e2,color:#fff
    style OperatorCR fill:#f5a623,color:#fff
    style OperatorCRB fill:#f5a623,color:#fff
    style JobSA fill:#4a90e2,color:#fff
    style JobSecrets fill:#e8744f,color:#fff
    style HFToken fill:#f8d7da,stroke:#dc3545
    style OpenAIKey fill:#f8d7da,stroke:#dc3545
    style AnthropicKey fill:#f8d7da,stroke:#dc3545
    style WatsonXKey fill:#f8d7da,stroke:#dc3545
    style AWSKey fill:#f8d7da,stroke:#dc3545
    style RegUser fill:#f8d7da,stroke:#dc3545
    style RegPass fill:#f8d7da,stroke:#dc3545
