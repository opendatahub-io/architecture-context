graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        RouteStd["OpenShift Route<br/>Standard Agents<br/>443/TCP → 8080/TCP<br/>TLS Edge Termination"]
        RouteClaw["OpenShift Route<br/>OpenClaw<br/>443/TCP → 18789/TCP<br/>TLS Edge, 30m timeout"]
    end

    subgraph Application["APPLICATION (In-Cluster)"]
        direction TB

        subgraph AuthMiddleware["Auth Layer (opt-in)"]
            SATokenAuth["SATokenAuthMiddleware<br/>TokenReview validation<br/>SA allowlist"]
        end

        subgraph AgentPods["Agent Pods"]
            StdAgent["Standard Agent Pod<br/>UBI9 Python 3.12<br/>UID 1001, drop ALL caps<br/>Port: 8080/TCP"]
            OpenClawPod["OpenClaw Pod<br/>ghcr.io/openclaw/openclaw<br/>digest-pinned upstream<br/>Port: 18789/TCP"]
        end
    end

    subgraph BackendServices["BACKEND SERVICES (In-Cluster)"]
        LLM["LLM Inference<br/>(OGX/vLLM/Ollama)<br/>8321/TCP<br/>API_KEY"]
        PG["PostgreSQL<br/>5432/TCP<br/>Password auth<br/>No encryption"]
        MilvusDB["Milvus<br/>19530/TCP<br/>No auth<br/>No encryption"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MLflow["MLflow Tracking<br/>443/TCP HTTPS<br/>Bearer / SA token<br/>TLS configurable"]
        GitHubAPI["GitHub API<br/>443/TCP HTTPS<br/>GITHUB_TOKEN<br/>TLS"]
        SlackWH["Slack Webhook<br/>443/TCP HTTPS<br/>Webhook URL<br/>TLS"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA token<br/>mTLS"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS edge"| RouteStd
    Client -->|"HTTPS/443<br/>TLS edge"| RouteClaw
    RouteStd -->|"HTTP/8080<br/>No encryption"| SATokenAuth
    SATokenAuth -->|"Authenticated"| StdAgent
    RouteClaw -->|"HTTP/18789<br/>OPENCLAW_GATEWAY_TOKEN"| OpenClawPod

    StdAgent -->|"HTTP/8321<br/>API_KEY Bearer"| LLM
    OpenClawPod -->|"HTTP<br/>VLLM_API_KEY"| LLM
    StdAgent -->|"TCP/5432<br/>Password<br/>No encryption"| PG
    StdAgent -->|"TCP/19530<br/>No auth"| MilvusDB
    StdAgent -->|"HTTPS/443<br/>TLS configurable<br/>Bearer token"| MLflow
    StdAgent -->|"HTTPS/443<br/>GITHUB_TOKEN"| GitHubAPI
    StdAgent -->|"HTTPS/443<br/>Webhook"| SlackWH
    SATokenAuth -->|"HTTPS/443<br/>mTLS<br/>TokenReview"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef auth fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class RouteStd,RouteClaw ingress
    class StdAgent,OpenClawPod application
    class SATokenAuth auth
    class LLM,PG,MilvusDB backend
    class MLflow,GitHubAPI,SlackWH,K8sAPI externalservice
