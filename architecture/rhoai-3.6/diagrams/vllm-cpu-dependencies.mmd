graph LR
    vLLM["vLLM CPU<br/>(Inference Server)"]

    %% Core Runtime Dependencies
    vLLM -->|"inference framework"| PyTorch["PyTorch 2.11.0+cpu"]
    vLLM -->|"model loading"| Transformers["HF Transformers ≥5.6.0"]
    vLLM -->|"HTTP framework"| FastAPI["FastAPI ≥0.133.0"]
    vLLM -->|"ASGI server"| Uvicorn["Uvicorn"]
    vLLM -->|"data validation"| Pydantic["Pydantic ≥2.12.0"]

    %% Protocol Dependencies
    vLLM -->|"OpenAI protocol"| OpenAI["openai ≥2.0.0"]
    vLLM -->|"Anthropic protocol"| Anthropic["anthropic ≥0.71.0"]
    vLLM -->|"gRPC support"| gRPC["grpcio ≥1.76.0"]
    vLLM -->|"serialization"| Protobuf["protobuf ≥5.29.6"]

    %% Observability
    vLLM -->|"metrics"| PromClient["prometheus_client ≥0.18.0"]
    vLLM -->|"tracing (optional)"| OTelSDK["OpenTelemetry SDK"]

    %% Security / Compliance
    vLLM -->|"content hashing"| Blake3["blake3<br/>(⚠️ non-FIPS default)"]
    vLLM -->|"cert refresh"| Watchfiles["watchfiles"]
    vLLM -->|"RH compliance"| MHCS["model-hosting-container-standards<br/>≥0.1.14"]

    %% Internal Platform Dependencies
    KServe["KServe / ModelMesh"] -->|"deploys as ServingRuntime"| vLLM
    CaikitAdapter["caikit-tgis-adapter"] -.->|"TGIS compat<br/>(ppc64le/s390x)"| vLLM

    %% External Services (egress)
    vLLM -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    vLLM -->|"tensorizer loading<br/>HTTPS/443"| S3["S3 Storage"]

    %% Integration Points (inbound)
    Prometheus["Prometheus"] -->|"scrapes /metrics"| vLLM
    OTel["OTel Collector"] <-->|"OTLP traces"| vLLM

