graph TB
    subgraph EvalHub["eval-hub Service"]
        Orchestrator["Job Orchestrator"]
    end

    subgraph Adapters["eval-hub-contrib Adapters"]
        direction TB

        subgraph Production["Production Adapters (Konflux)"]
            Inspect["Inspect AI Adapter<br/>75+ benchmarks<br/>Petri/Bloom alignment"]
            LightEval["LightEval Adapter<br/>commonsense, reasoning,<br/>truthfulness"]
        end

        subgraph Community["Community Adapters"]
            GuideLLM["GuideLLM Adapter<br/>inference perf"]
            MTEB["MTEB Adapter<br/>embedding eval"]
            CLEAR["CLEAR Adapter<br/>agentic trace analysis"]
            DeepEval["DeepEval Adapter<br/>LLM-as-judge"]
            RAGAS["RAGAS Adapter<br/>RAG quality"]
            SWEbench["SWE-bench Adapter<br/>code patch eval"]
            RULER["RULER Adapter<br/>long-context"]
            WildGuard["WildGuard Adapter<br/>safety classification"]
            IFBench["IFBench Adapter<br/>instruction-following"]
            NeMo["NeMo Guardrails Adapter<br/>safety rails"]
        end
    end

    subgraph SDK["evalhub-sdk"]
        FrameworkAdapter["FrameworkAdapter Base Class"]
        Callbacks["Callback Mechanism"]
        JobResults["JobResults Format"]
    end

    Orchestrator -->|schedules K8s Job| Inspect
    Orchestrator -->|schedules K8s Job| LightEval
    Orchestrator -->|schedules K8s Job| GuideLLM
    Orchestrator -->|schedules K8s Job| MTEB
    Orchestrator -->|schedules K8s Job| CLEAR
    Orchestrator -->|schedules K8s Job| DeepEval
    Orchestrator -->|schedules K8s Job| RAGAS
    Orchestrator -->|schedules K8s Job| SWEbench
    Orchestrator -->|schedules K8s Job| RULER
    Orchestrator -->|schedules K8s Job| WildGuard
    Orchestrator -->|schedules K8s Job| IFBench
    Orchestrator -->|schedules K8s Job| NeMo

    Inspect -->|implements| FrameworkAdapter
    LightEval -->|implements| FrameworkAdapter
    GuideLLM -->|implements| FrameworkAdapter
    MTEB -->|implements| FrameworkAdapter
    CLEAR -->|implements| FrameworkAdapter
    DeepEval -->|implements| FrameworkAdapter
    RAGAS -->|implements| FrameworkAdapter
    SWEbench -->|implements| FrameworkAdapter
    RULER -->|implements| FrameworkAdapter
    WildGuard -->|implements| FrameworkAdapter
    IFBench -->|implements| FrameworkAdapter
    NeMo -->|implements| FrameworkAdapter

    FrameworkAdapter -->|reports via| Callbacks
    Callbacks -->|produces| JobResults

    SWEbench -->|creates child K8s Jobs| K8sAPI["Kubernetes API"]

