graph TB
    subgraph PipelinesComponents["Pipelines Components"]
        direction TB
        KFPLib["kfp-components<br/>(Python Package v1.11.0)"]
        InitContainer["init_managed_pipelines<br/>(Init Container Entrypoint)"]
        GenPipelines["generate_managed_pipelines<br/>(Build-time CLI)"]
        GenReadme["generate_readme<br/>(CLI Tool)"]
    end

    subgraph Images["Container Images"]
        direction TB
        MainImage["odh-pipelines-components<br/>(UBI9/python-312)"]
        AutoMLImage["odh-automl<br/>(AIPCC CPU base)"]
        AutoRAGImage["odh-autorag<br/>(AIPCC CPU base)"]
        AutoRAGInfImage["odh-autorag-inference<br/>(AIPCC CPU base)"]
    end

    subgraph PipelineCategories["Pipeline Categories"]
        direction TB
        FineTuning["LLM Fine-Tuning<br/>(SFT, LoRA, OSFT)"]
        AutoML["AutoML<br/>(AutoGluon Tabular/TimeSeries)"]
        AutoRAG["AutoRAG<br/>(Document Indexing, RAG Optimization)"]
    end

    subgraph RuntimeCRs["Runtime CR Creation"]
        direction TB
        ServingRuntime["ServingRuntime CR"]
        InferenceService["InferenceService CR"]
    end

    %% Build-time flow
    GenPipelines -->|compiles| ManagedYAMLs["Managed Pipeline YAMLs"]
    ManagedYAMLs -->|bundled into| MainImage

    %% Init container flow
    MainImage -->|runs| InitContainer
    InitContainer -->|stages YAMLs to| SharedVolume["/config/managed-pipelines<br/>(Shared Volume)"]
    SharedVolume -->|read by| KFPServer["KFP API Server"]

    %% DSPO integration
    DSPO["Data Science Pipelines Operator"] -->|injects RELATED_IMAGE_*| InitContainer
    InitContainer -->|recompiles for air-gap| SharedVolume

    %% Pipeline execution
    KFPLib -->|defines| FineTuning
    KFPLib -->|defines| AutoML
    KFPLib -->|defines| AutoRAG

    %% Image usage
    FineTuning -->|runs on| MainImage
    AutoML -->|runs on| AutoMLImage
    AutoRAG -->|runs on| AutoRAGImage
    AutoRAG -.->|inference via| AutoRAGInfImage

    %% CR creation at runtime
    FineTuning -->|creates| ServingRuntime
    FineTuning -->|creates| InferenceService
    AutoRAG -->|creates| InferenceService

    %% External dependencies
    ServingRuntime -->|managed by| KServe["KServe"]
    InferenceService -->|managed by| KServe

    %% Styling
    style KFPLib fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style GenPipelines fill:#4a90e2,stroke:#333,color:#fff
    style GenReadme fill:#4a90e2,stroke:#333,color:#fff
    style MainImage fill:#50c878,stroke:#333,color:#fff
    style AutoMLImage fill:#50c878,stroke:#333,color:#fff
    style AutoRAGImage fill:#50c878,stroke:#333,color:#fff
    style AutoRAGInfImage fill:#50c878,stroke:#333,color:#fff
    style KServe fill:#999,stroke:#333,color:#fff
    style DSPO fill:#7ed321,stroke:#333,color:#fff
    style KFPServer fill:#7ed321,stroke:#333,color:#fff
    style SharedVolume fill:#f5a623,stroke:#333,color:#fff
    style ManagedYAMLs fill:#f5a623,stroke:#333,color:#fff
