graph TD
    subgraph Container["Container Security"]
        User["Runtime User: UID 1001<br/>(non-root)"]
    end

    subgraph AppAuth["Application-Level Authentication"]
        direction TB
        ChatEndpoint["/v1/chat/completions<br/>POST"]
        ModelsEndpoint["/v1/models<br/>GET"]
        ChecksEndpoint["/v1/checks<br/>POST"]
        GuardrailChecks["/v1/guardrail/checks<br/>POST"]
        ConfigsEndpoint["/v1/rails/configs<br/>GET"]
        HealthEndpoint["/v1/health, /healthz<br/>GET"]
        ActionsEndpoint["/v1/actions/run, /v1/actions/list<br/>POST, GET"]
    end

    subgraph AuthMechanisms["Auth Mechanisms"]
        BearerForward["Bearer Token<br/>(forwarded to upstream LLM)"]
        NoAuth["No Application Auth<br/>(platform network policies)"]
    end

    subgraph UpstreamAuth["Upstream Service Auth"]
        LLMAuth["LLM Provider<br/>Bearer Token / API Key"]
        AzureAuth["Azure OpenAI<br/>AZURE_OPENAI_API_KEY"]
    end

    subgraph ThirdPartyAuth["Third-Party API Keys (env vars)"]
        ActiveFenceKey["ACTIVEFENCE_API_KEY"]
        AIDefenseKey["AI_DEFENSE_API_KEY"]
        PangeaKey["PANGEA_API_TOKEN"]
        PatronusKey["PATRONUS_API_KEY"]
        CrowdStrikeKey["CS_AIDR_TOKEN"]
        F5Key["F5_GUARDRAILS_API_KEY"]
        FiddlerKey["FIDDLER_API_KEY"]
        OtherKeys["+ 6 more API keys"]
    end

    ChatEndpoint -->|auth required| BearerForward
    ModelsEndpoint -->|auth required| BearerForward
    ChecksEndpoint -->|no auth| NoAuth
    GuardrailChecks -->|no auth| NoAuth
    ConfigsEndpoint -->|no auth| NoAuth
    HealthEndpoint -->|no auth| NoAuth
    ActionsEndpoint -->|no auth| NoAuth

    BearerForward -->|forwarded to| LLMAuth
    BearerForward -->|forwarded to| AzureAuth

    User -->|runs| ChatEndpoint
    User -->|runs| ChecksEndpoint

    style User fill:#4a90e2,stroke:#333,color:#fff
    style ChatEndpoint fill:#7ed321,stroke:#333
    style ModelsEndpoint fill:#7ed321,stroke:#333
    style ChecksEndpoint fill:#f5a623,stroke:#333
    style GuardrailChecks fill:#f5a623,stroke:#333
    style ConfigsEndpoint fill:#f5a623,stroke:#333
    style HealthEndpoint fill:#f5a623,stroke:#333
    style ActionsEndpoint fill:#f5a623,stroke:#333
    style BearerForward fill:#4a90e2,stroke:#333,color:#fff
    style NoAuth fill:#e8e8e8,stroke:#333
    style LLMAuth fill:#f5a623,stroke:#333
    style AzureAuth fill:#f5a623,stroke:#333
    style ActiveFenceKey fill:#ffe6cc,stroke:#d79b00
    style AIDefenseKey fill:#ffe6cc,stroke:#d79b00
    style PangeaKey fill:#ffe6cc,stroke:#d79b00
    style PatronusKey fill:#ffe6cc,stroke:#d79b00
    style CrowdStrikeKey fill:#ffe6cc,stroke:#d79b00
    style F5Key fill:#ffe6cc,stroke:#d79b00
    style FiddlerKey fill:#ffe6cc,stroke:#d79b00
    style OtherKeys fill:#ffe6cc,stroke:#d79b00
