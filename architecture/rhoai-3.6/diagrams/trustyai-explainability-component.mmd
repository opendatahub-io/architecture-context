graph TB
    subgraph TrustyAI["TrustyAI Explainability"]
        subgraph Service["explainability-service (Quarkus)"]
            direction TB
            FairnessAPI["Fairness Metrics API<br/>SPD, DIR"]
            DriftAPI["Drift Detection API<br/>KS Test, Fourier MMD, Meanshift"]
            ExplainerAPI["Explainers API<br/>LIME, SHAP, CF, TSSaliency<br/>(disabled in RHOAI)"]
            ConsumerEndpoint["Inference Payload Consumer<br/>/consumer/kserve/v2"]
            CloudEventConsumer["CloudEvent Consumer<br/>Knative Eventing"]
            PrometheusScheduler["Prometheus Scheduler<br/>Metric Computation (5s)"]
            PrometheusPublisher["Prometheus Publisher<br/>/q/metrics"]
            InitContainer["Init Container<br/>oc apply ConfigMap"]
        end

        subgraph Core["explainability-core (Library)"]
            FairnessMetrics["Fairness Metrics<br/>SPD, DIR"]
            Explainers["Explainers<br/>LIME, SHAP, Counterfactual"]
            DriftDetectors["Drift Detectors<br/>KS Test, Fourier MMD, Meanshift"]
        end

        subgraph Connectors["explainability-connectors"]
            KServeV1["KServe v1 HTTP Client"]
            KServeV2["KServe v2 HTTP Client"]
            KServeGRPC["KServe v2 gRPC Client"]
        end

        subgraph Arrow["explainability-arrow"]
            ArrowBridge["Apache Arrow Bridge<br/>Java-Python Interop"]
        end
    end

    %% Internal flows
    FairnessAPI --> FairnessMetrics
    DriftAPI --> DriftDetectors
    ExplainerAPI --> Explainers
    PrometheusScheduler --> FairnessMetrics
    PrometheusScheduler --> DriftDetectors
    ExplainerAPI --> KServeV2
    ExplainerAPI --> KServeGRPC

    %% External interactions
    ModelMesh["ModelMesh<br/>Serving Runtime"] -->|inference payloads| ConsumerEndpoint
    KServeLogger["KServe Inference Logger"] -->|CloudEvents| CloudEventConsumer
    Prometheus["Prometheus"] -->|scrape /q/metrics| PrometheusPublisher
    User["User / API Client"] -->|REST API| FairnessAPI
    User -->|REST API| DriftAPI

    %% Storage backends
    subgraph Storage["Storage Backends"]
        PVC["PVC Storage<br/>CSV (default)"]
        MinIO["MinIO<br/>Object Storage"]
        MariaDB["MariaDB/MySQL<br/>Hibernate ORM"]
    end

    ConsumerEndpoint --> PVC
    ConsumerEndpoint --> MinIO
    ConsumerEndpoint --> MariaDB

    %% Inference servers
    InferenceServer["KServe / ModelMesh<br/>Inference Servers"]
    KServeV2 -->|inference calls| InferenceServer
    KServeGRPC -->|inference calls| InferenceServer

    %% Styling
    style Service fill:#4a90e2,stroke:#333,color:#fff
    style Core fill:#7ed321,stroke:#333,color:#fff
    style Connectors fill:#50c8e8,stroke:#333,color:#fff
    style Arrow fill:#9b59b6,stroke:#333,color:#fff
    style Storage fill:#f5f5f5,stroke:#999
    style ModelMesh fill:#e8e8e8,stroke:#333
    style KServeLogger fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style InferenceServer fill:#e8e8e8,stroke:#333
    style User fill:#f5a623,stroke:#333
