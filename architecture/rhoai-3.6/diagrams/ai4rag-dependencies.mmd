graph LR
    AI4RAG["ai4rag<br/>RAG Optimization Engine"]

    %% Core Runtime
    AI4RAG -->|"runtime"| Python["Python 3.12+"]

    %% LLM & Agent Framework
    AI4RAG -->|"LLM/embedding access"| OpenAI["openai ~=2.53"]
    AI4RAG -->|"agent framework"| LangChain["langchain >=1.4"]
    AI4RAG -->|"LLM integration"| LCOpenAI["langchain-openai >=1.6"]
    AI4RAG -->|"text splitting"| LCTextSplitters["langchain-text-splitters ~=1.1"]
    AI4RAG -->|"community integrations"| LCCommunity["langchain-community <0.4.2"]

    %% Document Processing
    AI4RAG -->|"document parsing"| Docling["docling-slim ~=2.121"]
    AI4RAG -->|"S3 access"| Boto3["boto3 >=1.28"]

    %% Vector Store Backends
    AI4RAG -->|"Milvus client"| PyMilvus["pymilvus ~=3.0.1"]
    AI4RAG -->|"pgvector support"| PgVector["pgvector ~=0.5"]
    AI4RAG -->|"async PostgreSQL"| AsyncPG["asyncpg >=0.29"]
    AI4RAG -->|"Neo4j driver"| Neo4jDriver["neo4j ~=6.3"]
    AI4RAG -->|"graph RAG"| Neo4jGraphRAG["neo4j-graphrag >=1.0"]

    %% ML & Evaluation
    AI4RAG -->|"HPO"| PyGAM["pygam ~=0.12"]
    AI4RAG -->|"RAG evaluation"| RAGAS["ragas >=0.3"]
    AI4RAG -->|"NLP evaluation"| Unitxt["unitxt ~=1.26"]
    AI4RAG -->|"ML utilities"| SKLearn["scikit-learn ==1.8.*"]

    %% Data & Validation
    AI4RAG -->|"data validation"| Pydantic["pydantic ==2.11.*"]
    AI4RAG -->|"data manipulation"| Pandas["pandas ==2.2.*"]
    AI4RAG -->|"parallel processing"| Multiprocess["multiprocess >=0.70"]

    %% External Services (runtime)
    AI4RAG ==>|"chat completions<br/>embeddings<br/>443/TCP HTTPS"| MaaS["MaaS Endpoint<br/>(OpenAI-compatible)"]
    AI4RAG ==>|"document download<br/>443/TCP HTTPS"| S3["S3 Storage"]
    AI4RAG ==>|"vector storage<br/>19530/TCP gRPC"| MilvusSvc["Milvus Service"]
    AI4RAG ==>|"vector storage<br/>5432/TCP"| PgVectorSvc["PostgreSQL + pgvector"]
    AI4RAG ==>|"graph storage<br/>7687/TCP Bolt"| Neo4jSvc["Neo4j Service"]
    AI4RAG ==>|"TokenReview auth<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API"]

