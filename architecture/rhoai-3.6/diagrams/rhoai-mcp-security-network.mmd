graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Agent["AI Agent / MCP Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP → 8000/TCP<br/>TLS Edge Termination"]
    end

    subgraph Application["APPLICATION (rhoai-mcp Pod)<br/>NS: redhat-ods-applications<br/>SA: rhoai-mcp<br/>runAsNonRoot, readOnlyRootFilesystem, drop ALL, seccomp RuntimeDefault"]
        direction TB

        subgraph AuthLayer["Authentication Layer"]
            OIDCMiddleware["OIDCAuthMiddleware<br/>(ASGI, fail-closed)<br/>JWT: RS256/ES256"]
            RBACCheck["RBAC Checker<br/>SubjectAccessReview<br/>Tool-level filtering"]
        end

        subgraph Endpoints["Exposed Endpoints"]
            Health["/health GET<br/>No auth (probes)"]
            WellKnown["/.well-known/oauth-protected-resource<br/>GET, No auth"]
            MCPEndpoint["/mcp POST<br/>Bearer (OIDC) / None"]
            SSEEndpoint["/sse GET<br/>Bearer (OIDC) / None"]
        end

        subgraph Plugins["Plugin Engine (pluggy)"]
            DomainPlugins["9 Domain Plugins<br/>projects, notebooks, inference,<br/>pipelines, connections, storage,<br/>training, model_registry, prompts"]
            CompositePlugins["4 Composite Plugins<br/>cluster, training, meta, planner"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA/User token"]
        ModelRegistry["Model Registry<br/>8080/TCP HTTP (no auth)<br/>8443/TCP HTTPS (OAuth)"]
        ModelCatalog["Model Catalog<br/>8443/TCP HTTPS<br/>TLS (service-serving CA)<br/>SA token"]
        Planner["Planner Backend<br/>8000/TCP HTTP<br/>No auth (remote mode)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OIDCProvider["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>JWKS discovery"]
    end

    %% Flows
    Agent -->|"HTTPS/443<br/>TLS Edge<br/>Bearer Token"| Route
    Route -->|"HTTP/8000<br/>Plaintext (in-cluster)<br/>Bearer forwarded"| OIDCMiddleware
    OIDCMiddleware -->|"validates JWT"| OIDCProvider
    OIDCMiddleware --> RBACCheck
    RBACCheck -->|"SubjectAccessReview<br/>HTTPS/6443"| K8sAPI

    RBACCheck --> DomainPlugins
    RBACCheck --> CompositePlugins

    DomainPlugins -->|"HTTPS/6443<br/>TLS 1.2+<br/>User token / SA token"| K8sAPI
    DomainPlugins -->|"HTTP/8080 or HTTPS/8443<br/>Bearer forwarded"| ModelRegistry
    CompositePlugins -->|"HTTPS/8443<br/>TLS (service CA)<br/>SA token"| ModelCatalog
    CompositePlugins -->|"HTTP/8000<br/>No auth"| Planner

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef auth fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Agent external
    class Route ingress
    class OIDCMiddleware,RBACCheck auth
    class Health,WellKnown,MCPEndpoint,SSEEndpoint application
    class DomainPlugins,CompositePlugins application
    class K8sAPI,ModelRegistry,ModelCatalog,Planner cluster
    class OIDCProvider externalservice
