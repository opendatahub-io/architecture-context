graph LR
    Dashboard["ODH Dashboard"]

    %% External Dependencies
    Dashboard -->|"runtime"| NodeJS["Node.js 22.18+"]
    Dashboard -->|"build"| Go["Go 1.26"]
    Dashboard -->|"UI framework"| React["React 18.3"]
    Dashboard -->|"UI components"| PF["PatternFly 6.6"]
    Dashboard -->|"HTTP server"| Fastify["Fastify 5.12"]
    Dashboard -->|"operator SDK"| CR["controller-runtime 0.24"]
    Dashboard -->|"micro-frontends"| ModFed["Module Federation<br/>Rspack 0.24"]
    Dashboard -->|"build orchestration"| Turbo["Turborepo 2.9"]
