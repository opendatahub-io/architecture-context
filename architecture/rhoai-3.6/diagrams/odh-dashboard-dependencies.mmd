    Dashboard -->|"owns Dashboard CR"| RhodsOp["rhods-operator /<br/>opendatahub-operator"]
    Dashboard -->|"reads enabled components"| DSC["DataScienceCluster CR"]
    Dashboard -->|"reads init state"| DSCI["DSCInitialization CR"]
    Dashboard -->|"model serving"| KServe["KServe<br/>InferenceService"]
    Dashboard -->|"notebook mgmt"| KFNotebooks["Kubeflow Notebooks /<br/>Workspaces"]
    Dashboard -->|"model tracking"| ModelReg["ModelRegistry CR"]
    Dashboard -->|"NIM accounts"| NIM["NIM Account CR"]
    Dashboard -->|"experiment tracking"| MLflowCR["MLflow CR"]
    Dashboard -->|"fairness/eval"| TrustyAI["TrustyAI EvalHub CR"]
    Dashboard -->|"feature stores"| Feast["Feast FeatureStore CR"]
    Dashboard -->|"hardware config"| HWProfile["HardwareProfile CR"]
    Dashboard -->|"observability"| Perses["Perses Dashboard CR"]
    Dashboard -->|"telemetry"| OTel["OpenTelemetry Collector"]
    Dashboard -->|"agent sandboxes"| Agents["Agents Sandboxes"]
    Dashboard -->|"tool discovery"| MCP["MCP Server Registrations"]

    %% Integration Points (inbound)
    RhodsOp -->|"creates CR"| Dashboard

    %% Platform Services
    Dashboard -->|"pipeline exec"| DSPipelines["DataScience Pipelines API"]
    Dashboard -->|"artifact tracking"| MLMD["ML Metadata"]
    Dashboard -->|"metrics"| Prometheus["Prometheus / Thanos"]
    Dashboard -->|"LLM inference"| LlamaStack["Llama Stack Server"]
    Dashboard -->|"MaaS"| MaaSAPI["MaaS API Server"]
    Dashboard -->|"content moderation"| NeMo["NeMo Guardrails"]
    Dashboard -->|"TLS certs"| CertMgr["cert-manager 1.13+"]

