graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["MLflow SDK Client / Browser"]
    end

    subgraph Ingress["INGRESS (ODH Data Science Gateway)"]
        Gateway["ODH Gateway<br/>HTTPRoute /mlflow<br/>443/TCP → 5000/TCP<br/>TLS termination"]
    end

    subgraph Application["APPLICATION (MLflow Server)"]
        direction TB

        subgraph MLflowPod["Pod: odh-mlflow-rhel9"]
            Server["MLflow Server<br/>Port: 5000/TCP<br/>uvicorn ASGI<br/>Image: ubi9/ubi-minimal-pqc"]
            KubeAuth["kubernetes-auth Plugin<br/>Bearer token extraction<br/>SelfSubjectAccessReview<br/>Workspace scoping"]
            Server --- KubeAuth
        end
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>Namespace list/watch<br/>SelfSubjectAccessReview<br/>MLflowConfig CRD read"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS configurable<br/>Password auth"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS SigV4 / IAM"]
        LLM["LLM Endpoints<br/>443/TCP HTTPS<br/>TLS<br/>API Key auth<br/>(disabled by default)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token +<br/>X-MLFLOW-WORKSPACE"| Gateway
    Gateway -->|"HTTP or HTTPS/5000<br/>TLS optional<br/>Token forwarded"| Server
    KubeAuth -->|"HTTPS/443<br/>TLS<br/>ServiceAccount token<br/>SelfSubjectAccessReview"| K8sAPI
    Server -->|"TCP/5432<br/>TLS configurable<br/>Password via URI"| PostgreSQL
    Server -->|"HTTPS/443<br/>TLS<br/>AWS SigV4"| S3
    Server -.->|"HTTPS/443<br/>TLS<br/>API Key<br/>(when AI gateway enabled)"| LLM

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authplugin fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class Server application
    class KubeAuth authplugin
    class K8sAPI k8s
    class PostgreSQL,S3,LLM externalservice
