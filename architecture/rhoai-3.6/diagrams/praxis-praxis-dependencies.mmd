graph LR
    Praxis["Praxis Proxy<br/>0.7.3"]

    %% Core External Dependencies (Required)
    Praxis -->|"HTTP/TCP engine"| Pingora["Pingora<br/>(quixotic-plecostomus)<br/>0.11.0"]
    Praxis -->|"TLS protocol"| Rustls["rustls<br/>0.23.45"]
    Praxis -->|"crypto provider"| RustlsOpenSSL["rustls-openssl<br/>0.4.1"]
    RustlsOpenSSL -->|"delegates crypto"| OpenSSL["System OpenSSL<br/>0.10.81<br/>(never vendored)"]
    Praxis -->|"async runtime"| Tokio["tokio<br/>1.53.1"]
    Praxis -->|"config parsing"| Serde["serde / serde_yaml<br/>1.0.229 / 0.10.7"]
    Praxis -->|"allocator"| Jemalloc["tikv-jemallocator<br/>0.7.0"]
    Praxis -->|"metrics"| Metrics["metrics +<br/>prometheus-exporter<br/>0.24.6 / 0.18.3"]
    Praxis -->|"logging"| Tracing["tracing +<br/>tracing-subscriber<br/>0.1.44 / 0.3.23"]

    %% Optional Dependencies
    Praxis -.->|"distributed tracing<br/>(otel feature)"| OTEL["opentelemetry +<br/>opentelemetry-otlp<br/>0.33.0"]
    Praxis -.->|"policy engine<br/>(policy-engine feature)"| PolicyEngine["praxis-policy<br/>(ppe)<br/>0.4.0"]
    Praxis -.->|"mTLS identity<br/>(spiffe feature)"| SPIFFE["spiffe<br/>0.16.1"]

    %% Runtime Dependencies
    Praxis -->|"telemetry export"| OTLPCollector["OTLP Collector"]
    Praxis -->|"proxy traffic"| Upstreams["Upstream Clusters"]
    Praxis -->|"config + certs"| FileSystem["File System<br/>(hot-reload)"]

