graph TD
    subgraph Deployment["Per-Deployment Configuration"]
        SA["ServiceAccount<br/>kube-auth-proxy<br/>(per-deployment)"]
    end

    subgraph RequiredRBAC["Required RBAC (when K8s token validation enabled)"]
        CR["ClusterRole<br/>(must be created per-deployment)"]
    end

    subgraph APIResources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
    end

    subgraph SecretsAccess["Secrets"]
        ProxySecret["kube-auth-proxy-secret<br/>(Opaque)<br/>Cookie secret, client secret"]
    end

    subgraph AuthMethods["Authentication Methods Provided"]
        direction TB
        K8sAuth["K8s SA Token Auth<br/>(TokenReview API)"]
        OAuthAuth["OpenShift OAuth<br/>(OAuth2 flow)"]
        OIDCAuth["OIDC Auth<br/>(JWT verification)"]
        BasicAuthMethod["Basic Auth<br/>(htpasswd)"]
    end

    SA -->|"bound via ClusterRoleBinding<br/>(must be created)"| CR
    CR -->|"create"| TokenReviews

    SA -->|"mounts"| ProxySecret

    SA -->|"uses in-cluster config"| K8sAuth
    K8sAuth -->|"validates via"| TokenReviews

    SA -.->|"configures"| OAuthAuth
    SA -.->|"configures"| OIDCAuth
    SA -.->|"configures"| BasicAuthMethod

    subgraph Note["NOTE"]
        NoteText["No RBAC manifests are shipped.<br/>RBAC must be configured per-deployment.<br/>The proxy requires 'create' on tokenreviews<br/>when K8s token validation is enabled."]
    end

    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623
    style TokenReviews fill:#7ed321
    style ProxySecret fill:#e74c3c,color:#fff
    style K8sAuth fill:#5b9bd5,color:#fff
    style OAuthAuth fill:#5b9bd5,color:#fff
    style OIDCAuth fill:#5b9bd5,color:#fff
    style BasicAuthMethod fill:#5b9bd5,color:#fff
    style NoteText fill:#fff,stroke:#999,stroke-dasharray: 5 5
