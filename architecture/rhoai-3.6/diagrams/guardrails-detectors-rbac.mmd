graph TD
    subgraph "Service Accounts"
        SA_Default["default<br/>(KServe InferenceService SA)"]
        SA_UserOne["user-one<br/>(dev/test only)"]
    end

    subgraph "Role Bindings"
        RB_UserOne["user-one-view<br/>(RoleBinding)<br/>Namespace: deploy manifest ns"]
    end

    subgraph "Cluster Roles"
        CR_View["view<br/>(ClusterRole, built-in)"]
    end

    subgraph "KServe Platform Auth"
        KServeAuth["KServe Auth Annotations<br/>security.opendatahub.io/<br/>enable-auth: true"]
        IstioSidecar["Istio Sidecar<br/>sidecar.istio.io/<br/>inject: true"]
    end

    subgraph "InferenceService Deployments"
        ISVC_HF["HuggingFace Detector<br/>InferenceService"]
        ISVC_Judge["LLM Judge Detector<br/>InferenceService"]
    end

    subgraph "Application Auth"
        NoAuth["No Application-Level Auth<br/>(No middleware registered<br/>on any FastAPI app)"]
    end

    %% RBAC bindings
    SA_UserOne -->|bound via| RB_UserOne
    RB_UserOne -->|grants| CR_View
    CR_View -->|"get, list, watch<br/>(read-only)"| ISVC_HF
    CR_View -->|"get, list, watch<br/>(read-only)"| ISVC_Judge

    %% Platform auth
    KServeAuth -->|enforces auth on| ISVC_HF
    KServeAuth -->|enforces auth on| ISVC_Judge
    IstioSidecar -->|enforces mTLS on| ISVC_HF
    IstioSidecar -->|enforces mTLS on| ISVC_Judge
    SA_Default -->|runs| ISVC_HF
    SA_Default -->|runs| ISVC_Judge

    %% Application layer
    NoAuth -.->|"RISK: no auth if<br/>platform misconfigured"| ISVC_HF
    NoAuth -.->|"RISK: no auth if<br/>platform misconfigured"| ISVC_Judge

    style SA_Default fill:#4a90e2,color:#fff
    style SA_UserOne fill:#4a90e2,color:#fff
    style CR_View fill:#f5a623,color:#fff
    style RB_UserOne fill:#dae8fc,stroke:#6c8ebf
    style KServeAuth fill:#7ed321,color:#fff
    style IstioSidecar fill:#7ed321,color:#fff
    style ISVC_HF fill:#d5e8d4,stroke:#82b366
    style ISVC_Judge fill:#d5e8d4,stroke:#82b366
    style NoAuth fill:#ffcccc,stroke:#cc0000
