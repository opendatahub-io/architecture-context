graph TB
    subgraph PraxisAI["Praxis AI Gateway"]
        direction TB

        subgraph Server["praxis-ai-proxy (server)"]
            ServerBin["Server Binary<br/>Pingora Runtime"]
            FilterRegistry["Filter Registry<br/>~40 AI Filters"]
            ConfigWatcher["Config Watcher<br/>Hot Reload"]
            AdminAPI["Admin API<br/>9901/TCP"]
        end

        subgraph APIs["praxis-ai-apis"]
            Classifier["Request Classifier<br/>OpenAI / Anthropic / MCP / A2A"]
            SSEParser["SSE Parser"]
            TokenCounter["Token Counter<br/>tiktoken-rs"]
            HashModule["Hash Module<br/>SHA-256 / HMAC via OpenSSL EVP"]
        end

        subgraph Filters["praxis-ai-filters"]
            RouteFilter["Routing Filters<br/>classify → route → branch"]
            IntelligentRoute["intelligent_route<br/>Weighted Overlay"]
            TranslationFilter["Translation Filters<br/>Anthropic → Chat Completions"]
            SecurityFilter["Security Filters<br/>credential_inject / peer_identity_trust"]
            GuardrailFilter["Guardrail Filters<br/>NeMo Integration"]
            MeteringFilter["Metering Filters<br/>Token Usage / Rate Limit"]
            AgenticFilter["Agentic Filters<br/>MCP / A2A"]
        end

        subgraph Store["Response Store"]
            StoreRegistry["ResponseStoreRegistry"]
            StoreLifecycle["Store Lifecycle<br/>Hot-Reload Generations"]
            StoreBackends["Store Backends"]
            PostgresBackend["PostgreSQL Backend<br/>Password or Cert-Auth"]
            SQLiteBackend["SQLite Backend"]
            StoreBackends --> PostgresBackend
            StoreBackends --> SQLiteBackend
        end

        subgraph ExtProc["llm-d ext_proc"]
            ExtProcFilter["ext_proc Filter<br/>gRPC / tonic"]
        end
    end

    %% Internal connections
    ServerBin -->|assembles| FilterRegistry
    ServerBin -->|provisions| StoreRegistry
    ConfigWatcher -->|rebuilds| FilterRegistry
    ConfigWatcher -->|swaps| StoreLifecycle
    FilterRegistry -->|includes| RouteFilter
    FilterRegistry -->|includes| TranslationFilter
    FilterRegistry -->|includes| SecurityFilter
    FilterRegistry -->|includes| GuardrailFilter
    FilterRegistry -->|includes| MeteringFilter
    FilterRegistry -->|includes| AgenticFilter
    FilterRegistry -->|optional| ExtProcFilter
    StoreRegistry -->|manages| StoreBackends

    %% External actors
    Client["Client<br/>OpenAI SDK / Anthropic SDK / MCP Agent"] -->|8080/TCP| ServerBin
    ServerBin -->|routes to| Backend["Inference Backend<br/>vLLM / Cloud Provider"]
    PostgresBackend -->|5432/TCP| PostgreSQL["PostgreSQL"]
    GuardrailFilter -->|REST| NeMo["NeMo Guardrails"]
    AgenticFilter -->|Streamable HTTP| MCPServer["MCP Server"]
    ExtProcFilter -->|gRPC| LLMd["llm-d ext_proc Server"]
    MeteringFilter -->|6379/TCP| Valkey["Valkey / Redis"]
    Classifier -->|sets x-praxis-ai-* headers| RouteFilter

    %% Core dependency
    PraxisCore["Praxis Core<br/>praxis-proxy 0.7.3<br/>Runtime / TLS / LB"] -.->|in-process| ServerBin

