graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["maas-api<br/>Namespace: opendatahub"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB1["maas-api<br/>(ClusterRoleBinding)"]
        CRB2["maas-api-supplemental<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["maas-api"]
        CR2["maas-api-supplemental"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["core/v1<br/>secrets<br/>(maas-db-config only)"]
        Namespaces["core/v1<br/>namespaces"]
        ServiceAccountsR["core/v1<br/>serviceaccounts"]
        Services["core/v1<br/>services"]
    end

    subgraph AuthResources["Authentication & Authorization"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph MaaSResources["MaaS CRD Resources"]
        AuthPolicies["maas.opendatahub.io<br/>maasauthpolicies"]
        ModelRefs["maas.opendatahub.io<br/>maasmodelrefs"]
        Subscriptions["maas.opendatahub.io<br/>maassubscriptions"]
    end

    subgraph GatewayResources["Gateway Resources"]
        Gateways["gateway.networking.k8s.io<br/>gateways"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    %% Bindings
    SA_API -->|bound via| CRB1
    SA_API -->|bound via| CRB2
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2

    %% maas-api ClusterRole permissions
    CR1 -->|"get<br/>(resourceNames: maas-db-config)"| Secrets
    CR1 -->|"get, list, watch"| Namespaces
    CR1 -->|"get, list, watch"| ServiceAccountsR
    CR1 -->|"get, list, watch"| Services
    CR1 -->|"create"| TokenReview
    CR1 -->|"create"| SAR
    CR1 -->|"get, list, watch"| AuthPolicies
    CR1 -->|"get, list, watch"| ModelRefs
    CR1 -->|"get, list, watch"| Subscriptions
    CR1 -->|"get"| Gateways
    CR1 -->|"get, list, watch"| APIServers

    %% maas-api-supplemental ClusterRole permissions
    CR2 -->|"get<br/>(resourceNames: maas-db-config)"| Secrets
    CR2 -->|"create"| SAR
    CR2 -->|"get, list, watch"| ModelRefs
    CR2 -->|"get, list, watch"| Subscriptions
    CR2 -->|"get, list, watch"| APIServers
    CR2 -->|"get"| Gateways

    %% Styling
    style SA_API fill:#4a90e2,color:#fff
    style CR1 fill:#f5a623,color:#fff
    style CR2 fill:#f5a623,color:#fff
    style CRB1 fill:#ffe6cc,stroke:#d79b00
    style CRB2 fill:#ffe6cc,stroke:#d79b00
    style Secrets fill:#7ed321,color:#fff
    style Namespaces fill:#7ed321,color:#fff
    style ServiceAccountsR fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style TokenReview fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style AuthPolicies fill:#7ed321,color:#fff
    style ModelRefs fill:#7ed321,color:#fff
    style Subscriptions fill:#7ed321,color:#fff
    style Gateways fill:#7ed321,color:#fff
    style APIServers fill:#7ed321,color:#fff
