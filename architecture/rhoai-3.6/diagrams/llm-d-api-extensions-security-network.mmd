graph TB
    subgraph External["EXTERNAL (Cluster-Internal Clients)"]
        Gateway["llm-d Gateway/Router<br/>Queries introspection endpoints<br/>for routing/scheduling decisions"]
    end

    subgraph vLLMPod["vLLM INFERENCE SERVER POD"]
        direction TB

        subgraph HTTPServer["HTTP Server (port 8000/TCP)"]
            direction TB
            API["FastAPI Application<br/>Protocol: HTTP<br/>Auth: None at plugin level<br/>(inherited from vLLM deployment)"]
        end

        subgraph Plugins["Introspection Plugins (read-only)"]
            direction TB
            ConfigEP["GET /plugins/llm-d-server-introspection/config<br/>Redacts kv_connector_extra_config by default"]
            DevicesEP["GET /plugins/llm-d-server-introspection/devices<br/>503 on collective_rpc failure"]
            KVCacheEP["GET /plugins/llm-d-server-introspection/kv-cache<br/>503 if engine missing or pre-#48121 vLLM"]
        end

        subgraph WorkerLayer["Worker Layer (in-process)"]
            WorkerExt["DeviceInfoWorkerExtension<br/>collective_rpc dispatch<br/>Per-rank device queries"]
        end

        API --> ConfigEP
        API --> DevicesEP
        API --> KVCacheEP
        DevicesEP -->|"collective_rpc<br/>(in-process)"| WorkerExt
    end

    %% Flows
    Gateway -->|"HTTP/8000<br/>Encryption: Inherited from vLLM<br/>Auth: None (plugin level)"| API

    %% Security annotations
    subgraph SecurityNotes["SECURITY NOTES"]
        direction TB
        Note1["No outbound network connections"]
        Note2["No secrets defined by this library"]
        Note3["kv_connector_extra_config redacted<br/>unless LLM_D_INTROSPECTION_<br/>EXPOSE_KV_EXTRA_CONFIG=1"]
        Note4["All endpoints read-only GET<br/>responses cached at startup"]
        Note5["No cryptographic code<br/>TLS inherited from vLLM server"]
    end

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef httpserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef plugin fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef worker fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secnote fill:#fff2cc,stroke:#d6b656,stroke-width:1px

    class Gateway external
    class API httpserver
    class ConfigEP,DevicesEP,KVCacheEP plugin
    class WorkerExt worker
    class Note1,Note2,Note3,Note4,Note5 secnote
