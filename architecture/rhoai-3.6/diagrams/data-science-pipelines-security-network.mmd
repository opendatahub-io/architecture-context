graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["KFP Python SDK / Client"]
    end

    subgraph ControlPlane["CONTROL PLANE (Internal Services)"]
        direction TB

        subgraph NS_Kubeflow["Namespace: kubeflow"]
            APIServer["API Server<br/>SA: ml-pipeline<br/>8888/TCP HTTP, 8887/TCP gRPC<br/>8443/TCP Webhook (TLS)<br/>GOFIPS140=v1.0.0"]
            PersistenceAgent["Persistence Agent<br/>SA: ml-pipeline-persistenceagent<br/>Outbound only"]
            ScheduledWF["Scheduled Workflow Controller<br/>SA: ml-pipeline-scheduledworkflow<br/>9090/TCP metrics"]
            CacheServer["Cache Server<br/>SA: kubeflow-pipelines-cache<br/>443/TCP → 8443/TCP HTTPS"]
            MLUI["ml-pipeline-ui<br/>SA: ml-pipeline-ui<br/>80/TCP → 3000/TCP HTTP"]
        end

        subgraph NS_Metadata["Metadata Services"]
            MLMDServer["ML Metadata gRPC<br/>8080/TCP gRPC<br/>No auth"]
            MetadataEnvoy["Metadata Envoy<br/>9090/TCP HTTP<br/>gRPC-HTTP proxy"]
        end
    end

    subgraph ExecutionPlane["EXECUTION PLANE (Task Pods)"]
        subgraph NS_User["Namespace: user-namespace"]
            Driver["Driver Init Container<br/>SA: pipeline-runner"]
            Launcher["Launcher v2 Sidecar<br/>SA: pipeline-runner"]
        end
    end

    subgraph DataStores["DATA STORES (Internal)"]
        MySQL["MySQL<br/>3306/TCP<br/>Istio AuthzPolicy<br/>Secret credentials"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>Access key/secret"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        ArgoWF["Argo Workflows<br/>Execution engine"]
        CertManager["cert-manager<br/>Webhook TLS certs"]
    end

    %% External flows
    Client -->|"REST 8888/TCP or gRPC 8887/TCP<br/>Configurable TLS<br/>Bearer Token → TokenReview"| APIServer

    %% API Server outbound
    APIServer -->|"MySQL 3306/TCP<br/>No encryption (in-cluster)<br/>Secret credentials"| MySQL
    APIServer -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Access key/secret"| S3
    APIServer -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>SA token"| K8sAPI
    APIServer -->|"gRPC 8080/TCP<br/>No encryption<br/>No auth"| MLMDServer

    %% Persistence Agent
    PersistenceAgent -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>SA token"| K8sAPI
    PersistenceAgent -->|"HTTP/HTTPS 8888/TCP<br/>Configurable TLS"| APIServer

    %% Scheduled Workflow
    ScheduledWF -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Cache Server
    K8sAPI -->|"Admission webhook<br/>HTTPS 443/TCP<br/>TLS cert-manager"| CacheServer
    CacheServer -->|"MySQL 3306/TCP<br/>Secret credentials"| MySQL
    CacheServer -->|"HTTPS 6443/TCP<br/>SA token"| K8sAPI

    %% Webhook
    K8sAPI -->|"PipelineVersion admission<br/>HTTPS 8443/TCP<br/>TLS cert-manager"| APIServer

    %% Execution plane
    Driver -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Launcher -->|"HTTP/HTTPS<br/>Access key/secret"| S3
    Launcher -->|"gRPC 8080/TCP<br/>No auth"| MLMDServer

    %% Metadata
    MetadataEnvoy -->|"gRPC 8080/TCP"| MLMDServer

    %% Cert manager
    CertManager -.->|"provisions TLS certs"| APIServer
    CertManager -.->|"provisions TLS certs"| CacheServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef execution fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class APIServer,PersistenceAgent,ScheduledWF,CacheServer,MLUI,MLMDServer,MetadataEnvoy controlplane
    class Driver,Launcher execution
    class MySQL,S3 datastore
    class K8sAPI,ArgoWF,CertManager platform
