graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application<br/>(OpenAI-compatible)"]
    end

    subgraph GatewayZone["GATEWAY SERVICE (Internal - ClusterIP)"]
        Gateway["vllm-orchestrator-gateway<br/>Image: odh-trustyai-vllm-orchestrator-gateway-rhel9<br/>Rust 1.86.0 / Axum 0.7.9<br/>Listen: 0.0.0.0:8090/TCP<br/>Stateless, no persistent storage"]

        subgraph TLSConfig["TLS Configuration"]
            ClientCert["Client Cert<br/>/etc/tls/private/tls.crt"]
            ClientKey["Client Key<br/>/etc/tls/private/tls.key"]
            CACert["Custom CA<br/>/etc/tls/ca/service-ca.crt"]
        end

        Gateway -.->|"probes at startup"| TLSConfig
    end

    subgraph BackendZone["BACKEND SERVICES (Internal)"]
        direction TB

        Orchestrator["FMS Guardrails Orchestrator<br/>/api/v2/chat/completions-detection<br/>Port: 8085/TCP (default)"]
        Detectors["Content Detectors<br/>(regex, PII, etc.)<br/>Registered with orchestrator"]
        LLM["vLLM / LLM Runtime<br/>Model inference backend"]

        Orchestrator -->|"invokes"| Detectors
        Orchestrator -->|"delegates inference"| LLM
    end

    subgraph CertProviders["CERTIFICATE PROVIDERS (OpenShift)"]
        CertSigner["service-serving-cert-signer<br/>Provisions TLS certs"]
        CAOperator["service-ca operator<br/>Provisions CA cert"]
    end

    %% Data Flows
    Client -->|"HTTP/8090<br/>No TLS (terminated upstream)<br/>Auth: Authorization header<br/>(pass-through, not validated)"| Gateway
    Gateway -->|"HTTP or HTTPS/8085<br/>Optional mTLS<br/>(native-tls / system OpenSSL)<br/>Forwarded: Authorization,<br/>X-Forwarded-*"| Orchestrator

    %% Certificate Provisioning
    CertSigner -.->|"provisions"| ClientCert
    CertSigner -.->|"provisions"| ClientKey
    CAOperator -.->|"provisions"| CACert

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#4a90e2,stroke:#2a6cb8,stroke-width:2px,color:#fff
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tls fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef certprovider fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway gateway
    class Orchestrator,Detectors,LLM backend
    class ClientCert,ClientKey,CACert tls
    class CertSigner,CAOperator certprovider
