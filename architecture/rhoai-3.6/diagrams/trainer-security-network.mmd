graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Pipeline"]
    end

    subgraph Cluster["OPENSHIFT CLUSTER"]
        subgraph APILayer["API LAYER"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph ControlPlane["CONTROL PLANE (Namespace: opendatahub)"]
            direction TB
            Controller["trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>Image: quay.io/opendatahub/trainer"]

            subgraph Endpoints["Service Endpoints"]
                WebhookEP["Webhook<br/>443→9443/TCP HTTPS<br/>TLS (cert-controller)<br/>Auth: K8s Admission"]
                MetricsEP["Metrics<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>Auth: TokenReview + SAR"]
                StatusEP["Status Server<br/>10443/TCP HTTPS<br/>TLS (cluster profile)<br/>Auth: Projected SA Token (OIDC)"]
                HealthEP["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            end

            Controller --- Endpoints
        end

        subgraph NetworkPolicy["NETWORK POLICIES"]
            NPIngress["Ingress Rules:<br/>• 9443 ← API Server (webhooks)<br/>• 10443 ← Training pods (status)<br/>• 8443 ← openshift-monitoring (metrics)"]
            NPEgress["Egress Rules:<br/>• Unrestricted (K8s API access required)"]
        end

        subgraph Monitoring["Namespace: openshift-monitoring"]
            Prometheus["Prometheus<br/>SA: prometheus-k8s"]
        end

        subgraph UserNS["Namespace: {user-namespace}"]
            TrainingPod["Training Pod<br/>SA: projected token<br/>Labels: trainer-workload"]
        end

        subgraph Scheduling["Gang Scheduling"]
            CoSched["CoScheduling<br/>(scheduler-plugins)<br/>PodGroup CRD"]
            Volcano["Volcano<br/>PodGroup CRD"]
        end
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS"]
        ObjStore["Object Storage<br/>(S3-compatible)<br/>443/TCP HTTPS"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI
    K8sAPI -->|"HTTPS/9443<br/>TLS (cert-controller)<br/>Admission"| WebhookEP
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Prometheus -->|"HTTPS/8443<br/>TLS (cluster profile)<br/>Bearer Token"| MetricsEP
    TrainingPod -->|"HTTPS/10443<br/>TLS (cluster profile)<br/>Projected SA Token (OIDC)"| StatusEP
    TrainingPod -->|"HTTPS/443<br/>TLS<br/>API Token"| HFHub
    TrainingPod -->|"HTTPS/443<br/>TLS<br/>Credentials"| ObjStore

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef endpoint fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef userns fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef netpol fill:#e6e6e6,stroke:#666,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class K8sAPI api
    class Controller controlplane
    class WebhookEP,MetricsEP,StatusEP,HealthEP endpoint
    class Prometheus monitoring
    class TrainingPod userns
    class HFHub,ObjStore externalsvc
    class NPIngress,NPEgress netpol
