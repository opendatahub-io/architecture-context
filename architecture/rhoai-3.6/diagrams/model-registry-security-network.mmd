graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User Browser"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        IstioGW["Istio Ingress Gateway<br/>3 VirtualServices<br/>80/TCP → 8080/TCP<br/>Istio mTLS"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS STRICT)"]
        direction TB

        subgraph NS_Registry["Namespace: {registry-namespace}"]
            direction TB
            RegistryServer["model-registry-service<br/>ClusterIP :8080/TCP<br/>Image: odh-model-registry<br/>AuthorizationPolicy: gateway principal + kubeflow JWT"]
            BFF["model-registry-ui-service<br/>ClusterIP :8080/TCP<br/>Auth: internal SA | user_token<br/>TLS 1.3 (when enabled)"]
            CatalogSvc["model-catalog<br/>ClusterIP :8080/TCP<br/>Catalog subcommand"]
        end

        subgraph NS_Kubeflow["Namespace: kubeflow"]
            ControllerMgr["controller-controller-manager<br/>SA: controller-controller-manager<br/>Probes: :8081/TCP (unauthenticated)<br/>Metrics: :8443/TCP HTTPS (TokenReview+SAR)<br/>HTTP/2 disabled"]
        end

        CSI["mr-storage-initializer<br/>Init container in KServe pods<br/>ClusterStorageContainer CR"]

        AsyncJob["async-upload Job<br/>Python batch job<br/>AIPCC base image<br/>rh-model-signing + cosign"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount tokens"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MySQL["MySQL<br/>:3306/TCP<br/>No encryption<br/>Username/Password"]
        PostgreSQL["PostgreSQL<br/>:5432/TCP<br/>No encryption<br/>Username/Password"]
        HFHub["HuggingFace Hub API<br/>:443/TCP HTTPS<br/>TLS 1.2+<br/>API key (optional)"]
        S3["S3 Storage<br/>:443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        OCIReg["OCI Registry<br/>:443/TCP HTTPS<br/>TLS 1.2+<br/>Registry credentials"]
        Sigstore["Sigstore<br/>:443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2/OIDC"| IstioGW

    %% Ingress → Services
    IstioGW -->|"HTTP/8080<br/>Istio mTLS<br/>AuthorizationPolicy"| RegistryServer
    IstioGW -->|"HTTP/8080<br/>Istio mTLS<br/>AuthorizationPolicy"| BFF
    IstioGW -->|"HTTP/8080<br/>Istio mTLS<br/>AuthorizationPolicy"| CatalogSvc

    %% BFF → Registry
    BFF -->|"HTTP/8080<br/>Istio mTLS<br/>Bearer / SA token"| RegistryServer

    %% BFF → K8s
    BFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token / user token"| K8sAPI

    %% Controller flows
    ControllerMgr -->|"HTTP/8080<br/>TLS configurable<br/>Bearer token"| RegistryServer
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% CSI flows
    CSI -->|"HTTP/8080<br/>No encryption (default)<br/>No auth"| RegistryServer
    CSI -->|"HTTPS/443<br/>TLS 1.2+<br/>Per-protocol creds"| S3

    %% Async job flows
    AsyncJob -->|"HTTP/8080<br/>Istio mTLS<br/>Bearer token"| RegistryServer
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / HF key"| S3
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry creds"| OCIReg
    AsyncJob -->|"HTTPS/443<br/>TLS 1.2+"| Sigstore

    %% Database flows
    RegistryServer -->|"TCP/3306<br/>No encryption<br/>Username/Password"| MySQL
    RegistryServer -->|"TCP/5432<br/>No encryption<br/>Username/Password"| PostgreSQL
    CatalogSvc -->|"TCP/5432<br/>No encryption<br/>Username/Password"| PostgreSQL
    CatalogSvc -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class IstioGW ingress
    class RegistryServer,BFF,CatalogSvc,ControllerMgr,CSI,AsyncJob servicemesh
    class K8sAPI controlplane
    class MySQL,PostgreSQL,HFHub,S3,OCIReg,Sigstore externalservice
