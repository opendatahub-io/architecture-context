graph LR
    OpenShell["OpenShell<br/>(Gateway + Supervisor + Sandbox)"]

    %% External Dependencies (Required)
    OpenShell -->|"async runtime"| Tokio["tokio 1.43"]
    OpenShell -->|"gRPC framework"| Tonic["tonic 0.14"]
    OpenShell -->|"HTTP server"| Axum["axum 0.8"]
    OpenShell -->|"TLS"| Rustls["rustls 0.23<br/>(aws-lc-rs provider)"]
    OpenShell -->|"K8s client"| Kube["kube 0.99"]
    OpenShell -->|"database"| SQLx["sqlx 0.9<br/>(PostgreSQL/SQLite)"]
    OpenShell -->|"SMT solver"| Z3["z3 0.21<br/>(policy prover)"]
    OpenShell -->|"OPA engine"| Regorus["regorus 0.9"]
    OpenShell -->|"SSH"| Russh["russh 0.63.1"]

    %% Optional Dependencies
    OpenShell -.->|"workload identity"| SPIFFE["spiffe 0.15<br/>(optional)"]

    %% Internal Platform Dependencies
    OpenShell -->|"pod lifecycle<br/>token reviews<br/>namespace mgmt"| K8sAPI["Kubernetes API"]

    %% External Services (Runtime)
    OpenShell -->|"user auth"| OIDCProviders["OIDC Providers"]
    OpenShell -.->|"credential storage"| Vault["HashiCorp Vault<br/>(optional)"]
    OpenShell -.->|"multi-replica state"| PostgreSQL["PostgreSQL<br/>(optional)"]
    OpenShell -.->|"trace export"| OTel["OpenTelemetry Collector<br/>(optional)"]

    %% SDK Dependencies
    PythonSDK["Python SDK"] -->|"gRPC transport"| GRPCIO["grpcio >=1.60"]
    PythonSDK -->|"runtime"| Python["Python >=3.11"]
    GoSDK["Go SDK"] -->|"gRPC transport"| GoGRPC["google.golang.org/grpc v1.83.2"]
    GoSDK -->|"runtime"| GoLang["Go 1.25.13"]

    OpenShell --- PythonSDK
    OpenShell --- GoSDK

    %% Consumed CRD
    OpenShell -->|"watches/creates"| SandboxCRD["Sandbox CR<br/>(agents.x-k8s.io/v1)<br/>consumed, not defined"]

    %% Proxied egress
    OpenShell -->|"proxied inference<br/>(credential-injected)"| AIProviders["AI Inference Providers"]

