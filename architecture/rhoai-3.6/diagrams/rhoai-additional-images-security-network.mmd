graph TB
    subgraph Metadata["METADATA REPOSITORY (No Runtime Component)"]
        Manifest["rhoai-disconnected-images.yaml<br/>68 digest-pinned image refs<br/>Static YAML manifest"]
    end

    subgraph MirroringLayer["MIRRORING TOOLING (Build/Deploy Time)"]
        Tooling["oc-mirror / skopeo<br/>Parses YAML, pulls and pushes images"]
    end

    subgraph SourceRegistries["SOURCE REGISTRIES (External)"]
        Quay["quay.io/modh<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry Auth"]
        RHIO["registry.redhat.io/rhoai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Red Hat Pull Secret"]
    end

    subgraph AirGapped["DISCONNECTED ENVIRONMENT (Air-Gapped)"]
        Mirror["Local Mirror Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Local Registry Auth"]
    end

    %% Flows
    Manifest -->|File read<br/>No network| Tooling
    Tooling -->|HTTPS/443<br/>TLS 1.2+<br/>Registry credentials| Quay
    Tooling -->|HTTPS/443<br/>TLS 1.2+<br/>Red Hat pull secret| RHIO
    Tooling -->|HTTPS/443<br/>TLS 1.2+<br/>Local registry auth| Mirror

    %% Styling
    classDef metadata fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tooling fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef airgapped fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Manifest metadata
    class Tooling tooling
    class Quay,RHIO external
    class Mirror airgapped
