graph TB
    subgraph Operator["llm-d-batch-gateway-operator"]
        direction TB
        Reconciler["LLMBatchGatewayReconciler<br/>Main reconcile loop"]
        MetricsCtrl["MetricsController<br/>Self-heals monitoring resources"]
        HelmRenderer["HelmRenderer<br/>Embedded chart rendering"]
        SecretSync["Secret Sync<br/>Cross-namespace secret resolution"]
        TLSProfile["TLS Profile Resolver<br/>Cluster TLS config"]
        ProfileWatcher["SecurityProfileWatcher<br/>Restarts on TLS change"]

        Reconciler -->|renders charts via| HelmRenderer
        Reconciler -->|resolves secrets via| SecretSync
        TLSProfile -->|feeds config to| Reconciler
        TLSProfile -->|feeds config to| MetricsCtrl
        ProfileWatcher -->|triggers restart| Reconciler
    end

    subgraph EmbeddedCharts["Embedded Helm Charts"]
        BGChart["batch-gateway chart<br/>API Server + Processor + GC"]
        AsyncChart["async-processor chart<br/>Redis-queue async dispatch"]
    end

    HelmRenderer -->|loads & renders| BGChart
    HelmRenderer -->|loads & renders| AsyncChart

    User["User / Platform Admin"] -->|creates| CR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1"]
    CR -->|watched by| Reconciler

    subgraph RenderedWorkloads["Rendered Workloads (per CR)"]
        APIServer["API Server Deployment<br/>HTTP batch job submission"]
        Processor["Request Processor Deployment<br/>Sync/async inference dispatch"]
        GC["Garbage Collector Deployment<br/>Expired job/file cleanup"]
        AsyncProc["Async Processor Deployment<br/>Redis-queue dispatch (optional)"]
    end

    Reconciler -->|SSA creates| APIServer
    Reconciler -->|SSA creates| Processor
    Reconciler -->|SSA creates| GC
    Reconciler -->|SSA creates| AsyncProc

    SecretSync -->|checks| RefGrant["ReferenceGrant<br/>Gateway API"]
    SecretSync -->|copies| Secret["Secret (cross-namespace)"]

    Reconciler -->|creates| HTTPRoute["HTTPRoute<br/>API server ingress"]
    Reconciler -->|creates| Certificate["Certificate CR<br/>cert-manager TLS"]
    MetricsCtrl -->|self-heals| SvcMon["ServiceMonitor"]
    MetricsCtrl -->|self-heals| PromRule["PrometheusRule"]
    MetricsCtrl -->|self-heals| MetricsSvc["Metrics Service"]

    TLSProfile -->|reads| OSConfig["OpenShift APIServer<br/>config.openshift.io"]

    style Reconciler fill:#4a90e2,color:#fff
    style MetricsCtrl fill:#4a90e2,color:#fff
    style HelmRenderer fill:#4a90e2,color:#fff
    style SecretSync fill:#4a90e2,color:#fff
    style TLSProfile fill:#4a90e2,color:#fff
    style ProfileWatcher fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style Processor fill:#7ed321,color:#fff
    style GC fill:#7ed321,color:#fff
    style AsyncProc fill:#7ed321,color:#fff
    style RefGrant fill:#e8e8e8
    style OSConfig fill:#e8e8e8
    style HTTPRoute fill:#e8e8e8
    style Certificate fill:#e8e8e8
    style SvcMon fill:#e8e8e8
    style PromRule fill:#e8e8e8
