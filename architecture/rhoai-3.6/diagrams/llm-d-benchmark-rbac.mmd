graph TD
    subgraph "Subjects"
        AuthUsers["Group: system:authenticated<br/>⚠️ ALL authenticated cluster users"]
    end

    subgraph "Role Bindings"
        RB["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "Roles (Namespace-Scoped)"
        Role["${PROJECT_NAME}-exec-role<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "API Resources"
        PodsExec["Core API<br/>pods/exec"]
    end

    subgraph "Target Workload"
        StatefulSet["Harness StatefulSet<br/>ghcr.io/llm-d/llm-d-benchmark"]
    end

    subgraph "Sensitive Environment Variables (Not K8s Secrets)"
        HFToken["HF_TOKEN<br/>HuggingFace auth"]
        LLMDBenchHF["LLMDBENCH_HF_TOKEN<br/>Alternative HF token"]
        LegacyHF["HUGGING_FACE_HUB_TOKEN<br/>Legacy HF token"]
        KubeConfig["LLMDBENCH_BASE64_CONTEXT_CONTENTS<br/>Base64 kubeconfig"]
        PrismURL["LLMDBENCH_PRISM_URL<br/>Prism proxy URL"]
    end

    AuthUsers -->|bound via| RB
    RB -->|grants| Role
    Role -->|create| PodsExec
    PodsExec -->|exec into| StatefulSet
    StatefulSet -->|has access to| HFToken
    StatefulSet -->|has access to| LLMDBenchHF
    StatefulSet -->|has access to| LegacyHF
    StatefulSet -->|has access to| KubeConfig
    StatefulSet -->|has access to| PrismURL

    %% Styling
    style AuthUsers fill:#e53935,color:#fff
    style Role fill:#f5a623
    style RB fill:#ff9800
    style PodsExec fill:#7ed321
    style StatefulSet fill:#4a90e2,color:#fff
    style HFToken fill:#ffcdd2
    style LLMDBenchHF fill:#ffcdd2
    style LegacyHF fill:#ffcdd2
    style KubeConfig fill:#ffcdd2
    style PrismURL fill:#fff9c4
