graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External User / Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Router["OpenShift Router<br/>443/TCP<br/>TLS edge termination"]
        GW["Gateway / Envoy<br/>(data-science-gateway)<br/>HTTPRoute routing<br/>EnvoyFilter auth injection"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        direction TB

        subgraph GatewayNS["Namespace: {gateway-namespace}"]
            AuthProxy["kube-auth-proxy<br/>SA: kube-auth-proxy<br/>HPA-scaled<br/>TLS (service-ca / cert-manager)"]
        end

        subgraph OperatorNS["Namespace: opendatahub-operator-system"]
            OperatorPod["controller-manager<br/>SA: opendatahub-operator-controller-manager"]

            MetricsPort["Metrics: 8443/TCP<br/>HTTPS TLS (service-ca)<br/>Bearer + RBAC"]
            WebhookPort["Webhook: 9443/TCP<br/>HTTPS TLS (service-ca)<br/>K8s Admission"]
            HealthPort["Health: 8081/TCP<br/>HTTP (no TLS)<br/>Unauthenticated"]
        end

        subgraph CloudNS["RHAII Mode (conditional)"]
            CloudMgr["cloudmanager<br/>8081/TCP health<br/>FIPS: strictfipsruntime"]
        end
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OSConfig["OpenShift APIServer<br/>TLS Profile Config"]
        ServiceCA["OpenShift service-ca<br/>Cert Provisioning"]
        CertMgr["cert-manager<br/>(conditional)<br/>Gateway TLS"]
        Prometheus["prometheus-operator<br/>PodMonitor / PrometheusRule"]
        OLMSvc["OLM<br/>Subscription Management"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>No Auth (OIDC redirect)"| Router
    Router -->|"HTTPS/443<br/>TLS"| GW

    %% Ingress → Platform
    GW -->|"HTTPS<br/>TLS (self-signed + DestinationRule)<br/>OIDC token"| AuthProxy

    %% Auth Proxy flows
    AuthProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token (TokenReview)"| APIServer
    AuthProxy -->|"HTTP<br/>No TLS (pod-internal)<br/>X-Auth-Request headers"| BackendSvc["Backend Service"]

    %% Operator → K8s API
    OperatorPod -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    CloudMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    %% K8s API → Operator (webhooks)
    APIServer -->|"HTTPS/443→9443<br/>TLS (service-ca cert)<br/>Admission"| WebhookPort

    %% External services
    OperatorPod -.->|reads| OSConfig
    ServiceCA -.->|provisions certs| OperatorPod
    CertMgr -.->|provisions certs| AuthProxy
    OperatorPod -.->|manages| Prometheus
    OperatorPod -.->|reads| OLMSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8scontrol fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Router,GW ingress
    class AuthProxy,OperatorPod,MetricsPort,WebhookPort,HealthPort,CloudMgr,BackendSvc platform
    class APIServer k8scontrol
    class OSConfig,ServiceCA,CertMgr,Prometheus,OLMSvc externalservice
