graph TD
    subgraph Deployment["Deployment Management"]
        OGXOp["ogx-operator<br/>(manages all RBAC)"]
    end

    subgraph AppAuth["Application-Level Access Policy"]
        direction TB
        AuthCheck{"AUTH_ISSUER<br/>set?"}
        AuthEnabled["OAuth2 Token Validation<br/>JWKS-based verification"]
        AuthDisabled["No Authentication<br/>All operations permitted"]
    end

    AuthCheck -->|Yes| AuthEnabled
    AuthCheck -->|No| AuthDisabled

    subgraph AccessTiers["Three-Tier Access Policy"]
        direction TB
        Tier1["Tier 1: Read System Resources<br/>Allowed: All users<br/>Resources: system-level configs"]
        Tier2["Tier 2: Create Resources<br/>Allowed: Authenticated users only<br/>Resources: files, vector stores, conversations"]
        Tier3["Tier 3: Read/Update/Delete Owned<br/>Allowed: Resource owner only<br/>Resources: own files, vector stores, conversations"]
    end

    AuthEnabled --> Tier1
    AuthEnabled --> Tier2
    AuthEnabled --> Tier3

    subgraph APIs["Protected API Endpoints"]
        Responses["/v1/responses"]
        Messages["/v1/messages"]
        InferenceAPI["/v1/inference/*"]
        VectorStoresAPI["/v1/vector_stores"]
        FilesAPI["/v1/files"]
        BatchesAPI["/v1/batches"]
    end

    subgraph PublicAPIs["Public Endpoints (No Auth)"]
        HealthAPI["/health"]
        MetricsAPI["/metrics"]
    end

    Tier1 -->|read| APIs
    Tier2 -->|create| APIs
    Tier3 -->|CRUD owned| APIs
    AuthDisabled -->|all ops| APIs

    subgraph TenantIdentity["Tenant Identity Sources"]
        OAuth2Token["OAuth2 Token<br/>(user identity from JWT)"]
        PraxisHeaders["Praxis Proxy Headers<br/>x-user-id, x-tenant-id"]
    end

    OAuth2Token -->|identity| AuthEnabled
    PraxisHeaders -->|identity| AuthEnabled

    OGXOp -.->|"manages K8s RBAC<br/>(not defined in this repo)"| AppAuth

    subgraph SecretMgmt["Secrets (18 Provider Keys)"]
        EnvVars["Environment Variables<br/>OPENAI_API_KEY, ANTHROPIC_API_KEY, etc."]
        FileMounts["File Mounts via _FILE suffix<br/>OPENAI_API_KEY_FILE, etc."]
    end

    EnvVars -->|resolved by entrypoint.sh| AppAuth
    FileMounts -->|resolved by entrypoint.sh| AppAuth

    style OGXOp fill:#7ed321,stroke:#333
    style AuthEnabled fill:#4a90e2,stroke:#333,color:#fff
    style AuthDisabled fill:#e74c3c,stroke:#333,color:#fff
    style Tier1 fill:#dae8fc,stroke:#6c8ebf
    style Tier2 fill:#d5e8d4,stroke:#82b366
    style Tier3 fill:#ffe6cc,stroke:#d79b00
    style OAuth2Token fill:#e1d5e7,stroke:#9673a6
    style PraxisHeaders fill:#e1d5e7,stroke:#9673a6
