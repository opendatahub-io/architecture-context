graph LR
    KAP["kube-auth-proxy<br/>(FIPS Auth Proxy)"]

    %% External Dependencies (runtime)
    KAP -->|"TokenReview API<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    KAP -->|"OAuth discovery<br/>token redemption<br/>6443/TCP HTTPS"| OAuthServer["OpenShift OAuth<br/>Server"]
    KAP -->|"OIDC discovery<br/>JWK, tokens<br/>443/TCP HTTPS"| OIDCProv["OIDC Provider"]
    KAP -.->|"session storage<br/>TCP, TLS optional"| Redis["Redis / Valkey"]

    %% Build/Library Dependencies
    subgraph GoLibs["Go Libraries"]
        direction TB
        OIDCLIB["go-oidc/v3 3.18.0"]
        GorillaMux["gorilla/mux 1.8.1"]
        Alice["justinas/alice 1.2.0"]
        JWT["golang-jwt/jwt/v5 5.3.0"]
        GoJose["go-jose/v3 3.0.5"]
        GoRedis["go-redis/v9 9.17.0"]
        RedisLock["redislock 0.9.4"]
        PromClient["prometheus/client_golang 1.23.2"]
        Viper["spf13/viper 1.21.0"]
        PFlag["spf13/pflag 1.0.10"]
        HMACAuth["mbland/hmacauth"]
        OAuth2["golang.org/x/oauth2 0.36.0"]
        XCrypto["golang.org/x/crypto 0.57.0"]
        K8sClient["k8s.io/client-go 0.35.3"]
    end

    KAP -->|"middleware"| Alice
    KAP -->|"routing"| GorillaMux
    KAP -->|"OIDC"| OIDCLIB
    KAP -->|"JWT"| JWT
    KAP -->|"JWK"| GoJose
    KAP -->|"OAuth2"| OAuth2
    KAP -->|"K8s client"| K8sClient
    KAP -->|"Redis"| GoRedis
    KAP -->|"metrics"| PromClient
    KAP -->|"config"| Viper
    KAP -->|"crypto"| XCrypto

    %% Integration Points (consumers)
    Envoy["Envoy / Istio<br/>(ext_authz)"] -.->|"subrequest<br/>/oauth2/auth"| KAP
    MLflow["MLflow SDK<br/>(Python client)"] -->|"API requests<br/>custom error handling"| KAP

    %% Upstream
    KAP -->|"proxy<br/>authenticated requests"| Upstream["Upstream App<br/>(protected service)"]

    %% Monitoring
    Prometheus["Prometheus"] -.->|"scrape /metrics"| KAP

