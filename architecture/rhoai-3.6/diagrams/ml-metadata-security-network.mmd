graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        DSP["Data Science Pipelines<br/>(gRPC Client)"]
        PipelineUI["Pipeline UI<br/>(gRPC Client)"]
    end

    subgraph Internal["INTERNAL (Cluster Network)"]
        direction TB

        subgraph MLMDService["ML Metadata Service"]
            Server["metadata_store_server<br/>8080/TCP gRPC<br/>Optional TLS (SSLConfig)<br/>No App-Level Auth<br/>UID: 65534 (non-root)<br/>Image: UBI9-minimal-pqc"]
        end
    end

    subgraph Backend["DATABASE BACKEND"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Optional SSL<br/>Username/Password Auth"]
        MySQL["MySQL (Alternative)<br/>3306/TCP<br/>Optional SSL<br/>Username/Password Auth"]
    end

    %% Flows
    DSP -->|"gRPC/8080<br/>Optional TLS<br/>No App Auth<br/>Infrastructure-delegated"| Server
    PipelineUI -->|"gRPC/8080<br/>Optional TLS<br/>No App Auth<br/>Infrastructure-delegated"| Server
    Server -->|"PostgreSQL/5432<br/>Optional SSL<br/>Username/Password"| PostgreSQL
    Server -.->|"MySQL/3306<br/>Optional SSL<br/>Username/Password"| MySQL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class DSP,PipelineUI external
    class Server internal
    class PostgreSQL,MySQL backend
