graph TB
    subgraph CurrentArch["llm-d-autoscaling (Current Architecture)"]
        direction TB
        Blueprints["KEDA Blueprint Scenarios<br/>(YAML Configuration)"]
        TestBed["Evaluation Test Bed<br/>(Benchmark Harness)"]
    end

    subgraph LegacyArch["WVA Controller (Legacy, Deprecated)"]
        direction TB
        WVAController["WVA Controller<br/>(Go Controller)"]
        ConfigMapReconciler["ConfigMap Reconciler"]
        HPAReconciler["HPA Reconciler"]
        InferencePoolReconciler["InferencePool Reconciler"]
        ScaledObjectReconciler["ScaledObject Reconciler<br/>(conditional)"]

        WVAController --> ConfigMapReconciler
        WVAController --> HPAReconciler
        WVAController --> InferencePoolReconciler
        WVAController --> ScaledObjectReconciler
    end

    %% Current Architecture Interactions
    Blueprints -->|configures| KEDAScaledObject["KEDA ScaledObject"]
    KEDAScaledObject -->|managed by| KEDA["KEDA"]
    KEDA -->|queries metrics| Prometheus["Prometheus"]
    KEDA -->|creates/manages| HPA["HorizontalPodAutoscaler"]
    HPA -->|scales| Deployments["Inference Deployments"]
    TestBed -->|uses| LLMDBenchmark["llm-d-benchmark"]
    TestBed -->|validates| Blueprints

    %% Legacy Controller Interactions
    InferencePoolReconciler -->|watches| InferencePoolCR["InferencePool CR"]
    HPAReconciler -->|watches| HPACR["HPA"]
    ScaledObjectReconciler -->|watches| ScaledObjectCR["ScaledObject CR"]
    ConfigMapReconciler -->|watches| ConfigMapCR["ConfigMap<br/>(WVA-labeled)"]
    WVAController -->|queries| Prometheus
    WVAController -->|scales| Deployments

    %% vLLM metrics
    vLLM["vLLM Model Servers"] -->|exports metrics| Prometheus

    %% Styling
    style Blueprints fill:#4a90e2,stroke:#333,color:#fff
    style TestBed fill:#4a90e2,stroke:#333,color:#fff
    style WVAController fill:#999,stroke:#333,color:#fff
    style ConfigMapReconciler fill:#999,stroke:#333,color:#fff
    style HPAReconciler fill:#999,stroke:#333,color:#fff
    style InferencePoolReconciler fill:#999,stroke:#333,color:#fff
    style ScaledObjectReconciler fill:#999,stroke:#333,color:#fff
    style KEDA fill:#7ed321,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style HPA fill:#7ed321,stroke:#333
    style Deployments fill:#7ed321,stroke:#333
    style LLMDBenchmark fill:#7ed321,stroke:#333
    style vLLM fill:#f5a623,stroke:#333
    style KEDAScaledObject fill:#f5a623,stroke:#333
    style InferencePoolCR fill:#ccc,stroke:#333
    style HPACR fill:#ccc,stroke:#333
    style ScaledObjectCR fill:#ccc,stroke:#333
    style ConfigMapCR fill:#ccc,stroke:#333
