graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["Platform Gateway<br/>443/TCP → 8443/TCP<br/>TLS 1.2+<br/>HTTPRoute per notebook"]
    end

    subgraph NotebookPod["NOTEBOOK POD (Per-Namespace)"]
        direction TB
        KubeRBACProxy["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>TLS: *-kube-rbac-proxy-tls<br/>Auth: TokenReview + SAR"]
        Jupyter["Notebook Container<br/>8888/TCP HTTP<br/>NetworkPolicy isolated"]
    end

    subgraph Controllers["CONTROLLER NAMESPACE"]
        direction TB

        subgraph UpstreamCtrl["notebook-controller"]
            NbCtrl["Notebook Controller<br/>SA: notebook-controller-service-account<br/>Metrics: 8443/TCP HTTPS"]
            Culling["CullingReconciler<br/>Checks idle notebooks"]
        end

        subgraph ODHCtrl["odh-notebook-controller"]
            ODHController["ODH Controller<br/>SA: manager<br/>Metrics: 8080/TCP HTTPS"]
            MutWH["Mutating Webhook<br/>/mutate-notebook-v1<br/>8443/TCP HTTPS TLS 1.2+<br/>FailurePolicy=Fail"]
            ValWH["Validating Webhook<br/>/validate-notebook-v1<br/>8443/TCP HTTPS TLS 1.2+<br/>FailurePolicy=Fail"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        OSConfig["OpenShift APIServer Config<br/>6443/TCP HTTPS<br/>TLS profile read + watch"]
        ImageStreams["OpenShift Image Streams<br/>6443/TCP HTTPS"]
        Prometheus["Prometheus<br/>Scrapes 8443/8080 TCP<br/>HTTPS + authn/authz"]
    end

    %% External → Gateway
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token / OAuth"| Gateway

    %% Gateway → Notebook Pod
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Gateway routing"| KubeRBACProxy

    %% kube-rbac-proxy → Jupyter
    KubeRBACProxy -->|"HTTP/8888<br/>None (localhost)<br/>Authorized by proxy"| Jupyter

    %% kube-rbac-proxy → K8s API for auth
    KubeRBACProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview + SAR"| K8sAPI

    %% Controllers → K8s API
    NbCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ODHController -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Culling → Notebook
    Culling -->|"HTTP/8888<br/>Activity check"| Jupyter

    %% Webhooks ← K8s API
    K8sAPI -->|"HTTPS/8443<br/>TLS 1.2+<br/>Admission"| MutWH
    K8sAPI -->|"HTTPS/8443<br/>TLS 1.2+<br/>Admission"| ValWH

    %% Controllers → OpenShift
    NbCtrl -->|"HTTPS/6443<br/>TLS profile"| OSConfig
    ODHController -->|"HTTPS/6443<br/>TLS profile + watch"| OSConfig
    MutWH -->|"HTTPS/6443<br/>ImageStream resolve"| ImageStreams

    %% Prometheus scraping
    Prometheus -->|"HTTPS/8443<br/>authn/authz"| NbCtrl
    Prometheus -->|"HTTPS/8080<br/>authn/authz"| ODHController

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef notebookpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Gateway ingress
    class KubeRBACProxy,Jupyter notebookpod
    class NbCtrl,Culling,ODHController,MutWH,ValWH controller
    class K8sAPI,OSConfig,ImageStreams,Prometheus clusterservice
