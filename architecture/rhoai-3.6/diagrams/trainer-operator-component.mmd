graph TB
    subgraph TrainerOperator["Trainer Operator"]
        Controller["trainer-operator-controller-manager<br/>(Go Operator)"]
        TLSProfile["TLS Profile Resolver<br/>(OpenShift crypto config)"]
        KustomizeRenderer["Kustomize Renderer<br/>(manifest pipeline)"]
        ActionPipeline["Action Pipeline<br/>(checkDeps → ensureNS → render → SSA → GC)"]
        Controller --> TLSProfile
        Controller --> ActionPipeline
        ActionPipeline --> KustomizeRenderer
    end

    subgraph ManagedStack["Managed Kubeflow Trainer Stack"]
        TrainerController["kubeflow-trainer-controller-manager<br/>(Managed Deployment)"]
        Webhooks["Admission Webhooks<br/>(Mutating + Validating)"]
        Runtimes["ClusterTrainingRuntimes<br/>(torch, training-hub, openmpi,<br/>speculator, vllm-extract)"]
        ImageStreams["OpenShift ImageStreams<br/>(CUDA, ROCm, CPU)"]
        TrainerController --> Webhooks
    end

    Admin["Platform Admin"] -->|creates| TrainerCR["Trainer CR<br/>(default-trainer)<br/>cluster-scoped singleton"]
    TrainerCR -->|watched by| Controller
    Controller -->|deploys via SSA| TrainerController
    Controller -->|creates| Runtimes
    Controller -->|creates| ImageStreams

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>(6443/TCP)"]
    Controller -->|checks| JobSetOp["JobSet Operator"]
    Controller -->|reads TLS profile| OSAPIServer["OpenShift APIServer"]
    Controller -->|reads version| ConfigMap["odh-trainer-config<br/>(ConfigMap)"]
    Controller -->|creates| ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]

    Prometheus["Prometheus<br/>(openshift-monitoring)"] -->|scrapes metrics<br/>8443/TCP HTTPS| Controller

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style TLSProfile fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeRenderer fill:#4a90e2,stroke:#333,color:#fff
    style ActionPipeline fill:#4a90e2,stroke:#333,color:#fff
    style TrainerController fill:#50c878,stroke:#333,color:#fff
    style Webhooks fill:#50c878,stroke:#333,color:#fff
    style Runtimes fill:#50c878,stroke:#333,color:#fff
    style ImageStreams fill:#50c878,stroke:#333,color:#fff
    style TrainerCR fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style JobSetOp fill:#e8e8e8,stroke:#333
    style OSAPIServer fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
