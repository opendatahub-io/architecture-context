graph TB
    subgraph Controller["ai-gateway-controller (opendatahub namespace)"]
        direction TB
        Manager["Controller Manager<br/>controller-runtime"]
        TenantReconciler["Tenant Reconciler<br/>pkg/tenant"]
        ExternalModelReconciler["ExternalModel Reconciler<br/>pkg/controller"]
        KustomizeBuild["Kustomize Build<br/>Manifest Rendering"]
        Envelope["Overlay Envelope<br/>SHA-256 JCS Digest"]
        Manager --> TenantReconciler
        Manager --> ExternalModelReconciler
        TenantReconciler --> KustomizeBuild
        ExternalModelReconciler --> Envelope
    end

    %% CRDs watched
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io/v1alpha1)"]
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io/v1alpha1)"]
    AIGuardrailCR["AIGuardrail CR<br/>(aigateway.opendatahub.io/v1alpha1)"]
    MaasTenantConfigCR["MaasTenantConfig CR<br/>(maas.opendatahub.io, Unstructured)"]
    AITenantCR["AITenant CR<br/>(maas.opendatahub.io, Unstructured)"]

    ExternalModelCR -->|watched by| ExternalModelReconciler
    ExternalProviderCR -->|resolved by| ExternalModelReconciler
    AIGuardrailCR -->|watched by| ExternalModelReconciler
    MaasTenantConfigCR -->|watched by| TenantReconciler
    AITenantCR -->|read by| TenantReconciler

    %% Resources created by Tenant Reconciler
    TenantReconciler -->|SSA applies| PraxisDeployment["Praxis ExtProc Deployment<br/>(per-tenant)"]
    TenantReconciler -->|SSA applies| EnvoyFilter["EnvoyFilter<br/>(per-tenant ExtProc chain)"]
    TenantReconciler -->|SSA applies| NetworkPolicy["NetworkPolicy<br/>(per-tenant)"]
    TenantReconciler -->|SSA applies| TenantRBAC["ClusterRoleBinding<br/>(per-tenant)"]

    %% Resources created by ExternalModel Reconciler
    ExternalModelReconciler -->|creates| ExternalNameSvc["ExternalName Service<br/>(per-provider)"]
    ExternalModelReconciler -->|creates| ServiceEntry["ServiceEntry<br/>(per-provider DNS)"]
    ExternalModelReconciler -->|creates| DestinationRule["DestinationRule<br/>(per-provider TLS/SNI)"]
    ExternalModelReconciler -->|creates| HTTPRoute["HTTPRoute<br/>(per-model weighted routing)"]
    ExternalModelReconciler -->|creates| OverlayCM["Routing Overlay ConfigMap<br/>(content-addressed)"]

    %% External dependencies
    ExternalModelReconciler -->|reads via APIReader| Secrets["Provider Secrets"]
    Controller -->|depends on| GatewayAPI["Gateway API"]
    Controller -->|depends on| Istio["Istio"]
    Controller -->|coordinates with| MaasController["maas-controller"]

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style TenantReconciler fill:#4a90e2,color:#fff
    style ExternalModelReconciler fill:#4a90e2,color:#fff
    style KustomizeBuild fill:#4a90e2,color:#fff
    style Envelope fill:#4a90e2,color:#fff
    style ExternalModelCR fill:#f5a623,color:#fff
    style ExternalProviderCR fill:#f5a623,color:#fff
    style AIGuardrailCR fill:#f5a623,color:#fff
    style MaasTenantConfigCR fill:#f5a623,color:#fff
    style AITenantCR fill:#f5a623,color:#fff
    style PraxisDeployment fill:#7ed321,color:#fff
    style EnvoyFilter fill:#7ed321,color:#fff
    style NetworkPolicy fill:#7ed321,color:#fff
    style TenantRBAC fill:#7ed321,color:#fff
    style ExternalNameSvc fill:#7ed321,color:#fff
    style ServiceEntry fill:#7ed321,color:#fff
    style DestinationRule fill:#7ed321,color:#fff
    style HTTPRoute fill:#7ed321,color:#fff
    style OverlayCM fill:#7ed321,color:#fff
    style Secrets fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style Istio fill:#e8e8e8
    style MaasController fill:#e8e8e8
