graph LR
    GridOperator["AGN Operator<br/>(praxis-grid)"]

    %% Core Runtime Dependencies
    GridOperator -->|"async runtime"| Tokio["tokio 1.53"]
    GridOperator -->|"HTTP framework"| Axum["axum 0.8"]
    GridOperator -->|"K8s controllers"| KubeRS["kube-rs 4.2"]
    GridOperator -->|"K8s API types"| K8sOpenAPI["k8s-openapi 0.28"]

    %% Gossip & State
    GridOperator -->|"SWIM membership"| Foca["foca 1.0"]
    GridOperator -->|"gossip encryption"| AesGcm["aes-gcm 0.11"]

    %% TLS (conditional)
    GridOperator -->|"TLS (default)"| Rustls["rustls 0.23 + ring 0.17"]
    GridOperator -->|"TLS (FIPS)"| OpenSSL["openssl 0.10"]

    %% Certificates (conditional)
    GridOperator -->|"cert gen (default)"| Rcgen["rcgen 0.14"]
    GridOperator -->|"cert gen (FIPS)"| OpenSSLCerts["openssl (certs)"]

    %% Data
    GridOperator -->|"enrollment DB"| Sqlx["sqlx 0.9<br/>(PostgreSQL)"]

    %% Agent tools
    GridOperator -->|"MCP client"| Rmcp["rmcp 3.1"]

    %% Metrics
    GridOperator -->|"metrics"| Prom["prometheus 0.14"]

    %% Internal Platform Dependencies
    PraxisGW["Praxis AI Gateway"] -->|"hot-reloads overlay"| GridOperator
    GridOperator -.->|"writes routing overlay"| PraxisGW
    PromOperator["Prometheus Operator"] -.->|"ServiceMonitor"| GridOperator
    OSRoute["OpenShift Route API"] -.->|"optional Routes"| GridOperator

    %% External Services
    GridOperator -->|"CRD watch<br/>Secret/ConfigMap"| K8sAPI["Kubernetes API"]
    GridOperator -->|"enrollment state"| PostgreSQL["PostgreSQL"]
    GridOperator -->|"health probe"| InferenceBackends["Inference Backends<br/>(vLLM, llm-d, etc.)"]
    GridOperator -->|"tool probe"| MCPServers["MCP Servers"]

    %% Cross-site
    PeerSite["Peer Site Operator"] <-->|"SWIM gossip<br/>7946/UDP"| GridOperator
    PeerSite <-->|"signal poll<br/>9091/TCP mTLS"| GridOperator

    %% Styling
    style GridOperator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Tokio fill:#e8e8e8,stroke:#333
    style Axum fill:#e8e8e8,stroke:#333
    style KubeRS fill:#e8e8e8,stroke:#333
    style K8sOpenAPI fill:#e8e8e8,stroke:#333
    style Foca fill:#e8e8e8,stroke:#333
    style AesGcm fill:#e8e8e8,stroke:#333
    style Rustls fill:#e8e8e8,stroke:#333
    style OpenSSL fill:#e8e8e8,stroke:#333
    style Rcgen fill:#e8e8e8,stroke:#333
    style OpenSSLCerts fill:#e8e8e8,stroke:#333
    style Sqlx fill:#e8e8e8,stroke:#333
    style Rmcp fill:#e8e8e8,stroke:#333
    style Prom fill:#e8e8e8,stroke:#333
    style PraxisGW fill:#7ed321,stroke:#333,color:#fff
    style PromOperator fill:#7ed321,stroke:#333,color:#fff
    style OSRoute fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style InferenceBackends fill:#f5a623,stroke:#333,color:#fff
    style MCPServers fill:#f5a623,stroke:#333,color:#fff
    style PeerSite fill:#9b59b6,stroke:#333,color:#fff
