graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / GitOps Client"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (ogx-k8s-operator-system / redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["ogx-k8s-operator-controller-manager Pod<br/>SA: ogx-k8s-operator-controller-manager"]
            MetricsEP["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>FilterProvider authn/authz"]
            WebhookEP["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (service-serving-cert)<br/>Kubernetes Admission"]
            HealthEP["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            Reconciler["OGXServerReconciler"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS"]
        WebhookSvc["webhook-service<br/>ClusterIP 443/TCP → 9443<br/>HTTPS"]

        WebhookCert["ogx-k8s-operator-webhook-cert<br/>kubernetes.io/tls<br/>service-serving-cert-signer<br/>Auto-rotate"]
    end

    subgraph UserNS["USER NAMESPACE (per-tenant)"]
        OGXPod["OGX Server Pod<br/>HTTP (no TLS)<br/>No Auth"]
        PVC["PVC<br/>(no ownerRef,<br/>persists on deletion)"]
        NetPol["NetworkPolicy<br/>(operator-managed)"]
    end

    subgraph Monitoring["CLUSTER MONITORING"]
        Prometheus["Prometheus<br/>Scrapes via ServiceMonitor"]
    end

    subgraph OpenShiftConfig["OPENSHIFT PLATFORM"]
        TLSProfile["APIServer TLS Profile<br/>config.openshift.io"]
        CertSigner["service-serving-cert-signer"]
    end

    %% External to Control Plane
    User -->|"kubectl apply<br/>HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| APIServer

    %% Control Plane to Operator
    APIServer -->|"Webhook call<br/>HTTPS/443 → 9443<br/>TLS (service-serving-cert)<br/>Admission auth"| WebhookSvc
    WebhookSvc --> WebhookEP

    APIServer -->|"Watch events<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA token"| Reconciler

    %% Operator to Control Plane
    Reconciler -->|"SSA resources<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA token"| APIServer

    %% Operator to User Namespace
    Reconciler -->|"Health poll<br/>HTTP (varies)<br/>No TLS<br/>No Auth"| OGXPod

    %% Monitoring
    Prometheus -->|"Scrape /metrics<br/>HTTPS/8443<br/>TLS (cluster profile)<br/>metrics-reader RBAC"| MetricsSvc
    MetricsSvc --> MetricsEP

    %% OpenShift Integration
    Reconciler -->|"GET TLS profile<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA token"| TLSProfile
    CertSigner -.->|"Provisions TLS cert"| WebhookCert
    WebhookCert -.->|"Mounted"| WebhookEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class APIServer controlplane
    class MetricsEP,WebhookEP,HealthEP,Reconciler,MetricsSvc,WebhookSvc,WebhookCert operator
    class OGXPod,PVC,NetPol userns
    class Prometheus monitoring
    class TLSProfile,CertSigner platform
