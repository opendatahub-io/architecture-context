graph LR
    KRP["kube-rbac-proxy<br/>Go Sidecar Proxy"]

    %% Build Dependencies
    KRP -->|"build toolchain"| Go["Go 1.26.0"]

    %% Core Kubernetes Dependencies
    KRP -->|"authn/authz framework"| K8sApiserver["k8s.io/apiserver<br/>v0.35.2"]
    KRP -->|"API client<br/>(SAR, TokenReview)"| K8sClientGo["k8s.io/client-go<br/>v0.35.2"]
    KRP -->|"API types"| K8sApi["k8s.io/api<br/>v0.35.2"]
    KRP -->|"API machinery"| K8sApimachinery["k8s.io/apimachinery<br/>v0.35.2"]
    KRP -->|"CLI, TLS parsing"| K8sComponentBase["k8s.io/component-base<br/>v0.35.2"]

    %% Library Dependencies
    KRP -->|"CLI framework"| Cobra["spf13/cobra<br/>v1.10.2"]
    KRP -->|"HTTP/2, h2c"| XNet["golang.org/x/net<br/>v0.58.0"]
    KRP -->|"OIDC verification"| GoOIDC["coreos/go-oidc<br/>v2.3.0"]
    KRP -->|"audit metrics"| HTTPSnoop["httpsnoop<br/>v1.1.0"]
    KRP -->|"crypto primitives"| XCrypto["golang.org/x/crypto<br/>v0.57.0"]

    %% Runtime Dependencies (Internal Platform)
    KRP -->|"TokenReview +<br/>SubjectAccessReview"| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    KRP -->|"proxy to upstream<br/>8081/TCP localhost"| UpstreamService["Upstream Service<br/>(metrics endpoint)"]

    %% Integration Points (incoming)
    Prometheus["OpenShift Monitoring<br/>(Prometheus)"] -->|"hardcoded allow<br/>GET /metrics"| KRP
    CertManager["cert-manager /<br/>Operator"] -->|"TLS cert provisioning<br/>hot-reloadable"| KRP
    RHOAIComponents["RHOAI Components<br/>(e.g. TrustyAI)"] -->|"deployed as sidecar"| KRP

