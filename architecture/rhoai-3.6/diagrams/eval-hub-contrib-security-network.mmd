graph TB
    subgraph Cluster["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph NS_Tenant["Namespace: tenant-namespace"]
            EvalHub["eval-hub Service<br/>Job Orchestrator"]
            Adapter["Adapter Container<br/>K8s Job (ephemeral)<br/>SA: evalhub-evalhub-opendatahub-job"]
            Sidecar["eval-hub Sidecar<br/>Status & result reporting"]
        end

        subgraph SWEbenchScope["SWE-bench Only"]
            K8sAPI["Kubernetes API<br/>batch/jobs CRUD<br/>pods, pods/log read"]
            ChildJobs["Child Job Pods<br/>SCC: anyuid"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        OpenAI["OpenAI-compatible Endpoint<br/>vLLM / Ollama / OpenRouter<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key (Bearer)"]
        Anthropic["Anthropic API<br/>api.anthropic.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API key (x-api-key)"]
        HuggingFace["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Token (optional)"]
        MLflow["MLflow Server<br/>8443/TCP HTTPS<br/>TLS INSECURE ⚠<br/>No auth"]
        OCIReg["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry creds"]
    end

    %% Internal flows
    EvalHub -->|ConfigMap mount<br/>K8s RBAC| Adapter
    Adapter -->|HTTP localhost<br/>No encryption<br/>No auth| Sidecar

    %% SWE-bench flows
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>SA token| K8sAPI
    K8sAPI -->|Launch| ChildJobs

    %% External flows
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer token| OpenAI
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>x-api-key| Anthropic
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>Token| HuggingFace
    Adapter -->|HTTPS/8443<br/>TLS INSECURE ⚠| MLflow
    Sidecar -->|HTTPS/443<br/>TLS 1.2+<br/>Registry creds| OCIReg

    %% Styling
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef adapter fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class EvalHub cluster
    class Adapter,Sidecar adapter
    class K8sAPI,ChildJobs cluster
    class OpenAI,Anthropic,HuggingFace,OCIReg external
    class MLflow warning
