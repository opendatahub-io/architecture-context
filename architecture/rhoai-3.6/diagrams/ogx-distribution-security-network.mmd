graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph IdentityLayer["IDENTITY PROXY"]
        Praxis["Praxis Identity Proxy<br/>Injects x-user-id, x-tenant-id"]
    end

    subgraph Application["APPLICATION (OGX Server)"]
        direction TB
        OGX["OGX Server<br/>8321/TCP HTTP<br/>OAuth2 Token Validation<br/>Owner-based Access Policy"]
    end

    subgraph StateStorage["STATE STORAGE"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Password Auth<br/>KV + SQL Store"]
    end

    subgraph InferenceProviders["INFERENCE PROVIDERS (Conditional)"]
        direction LR
        vLLM["vLLM<br/>configurable<br/>HTTP/HTTPS<br/>Bearer Token"]
        OpenAI["OpenAI API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        AnthropicAPI["Anthropic API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>IAM / Bearer"]
        VertexAI["Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth2"]
        Watsonx["IBM watsonx<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        Gemini["Google Gemini<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
    end

    subgraph VectorProviders["VECTOR STORE PROVIDERS (Conditional)"]
        direction LR
        Milvus["Milvus<br/>HTTP/gRPC<br/>TLS + mTLS optional<br/>Token"]
        PgVector["PgVector<br/>5432/TCP<br/>Configurable<br/>Password"]
        Qdrant["Qdrant<br/>6333-6334/TCP<br/>HTTP/gRPC<br/>API Key"]
    end

    subgraph ExternalServices["SEARCH & FILE SERVICES (Conditional)"]
        direction LR
        Brave["Brave Search<br/>443/TCP HTTPS<br/>API Key"]
        Tavily["Tavily Search<br/>443/TCP HTTPS<br/>API Key"]
        S3["AWS S3<br/>443/TCP HTTPS<br/>IAM Credentials"]
    end

    subgraph AuthObservability["AUTH & OBSERVABILITY"]
        direction LR
        OIDC["OIDC/JWKS Provider<br/>443/TCP HTTPS<br/>Public Endpoint"]
        OTel["OpenTelemetry Collector<br/>OTLP"]
        Prometheus["Prometheus<br/>Scrapes /metrics<br/>60s interval"]
    end

    %% Flows
    Client -->|"HTTP/8321<br/>OAuth2 Bearer Token<br/>TLS at ingress"| Praxis
    Praxis -->|"HTTP/8321<br/>+ identity headers<br/>No encryption"| OGX

    OGX -->|"TCP/5432<br/>Password<br/>Encryption configurable"| PostgreSQL

    OGX -->|"HTTP/HTTPS<br/>Bearer Token<br/>TLS configurable"| vLLM
    OGX -->|"HTTPS/443<br/>API Key<br/>TLS 1.2+"| OpenAI
    OGX -->|"HTTPS/443<br/>API Key<br/>TLS 1.2+"| AnthropicAPI
    OGX -->|"HTTPS/443<br/>API Key<br/>TLS 1.2+"| AzureOAI
    OGX -->|"HTTPS/443<br/>IAM/Bearer<br/>TLS 1.2+"| Bedrock
    OGX -->|"HTTPS/443<br/>OAuth2<br/>TLS 1.2+"| VertexAI
    OGX -->|"HTTPS/443<br/>API Key<br/>TLS 1.2+"| Watsonx
    OGX -->|"HTTPS/443<br/>API Key<br/>TLS 1.2+"| Gemini

    OGX -->|"HTTP/gRPC<br/>Token<br/>TLS+mTLS optional"| Milvus
    OGX -->|"TCP/5432<br/>Password"| PgVector
    OGX -->|"HTTP+gRPC/6333-6334<br/>API Key<br/>TLS configurable"| Qdrant

    OGX -->|"HTTPS/443<br/>API Key"| Brave
    OGX -->|"HTTPS/443<br/>API Key"| Tavily
    OGX -->|"HTTPS/443<br/>IAM"| S3

    OGX -->|"HTTPS/443<br/>Token verification"| OIDC
    OGX -->|"OTLP<br/>Traces + metrics"| OTel
    Prometheus -->|"HTTP<br/>Scrape /metrics"| OGX

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef identity fill:#e6d5f7,stroke:#7b4ea3,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:3px
    classDef statestorage fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef inference fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef vectorstore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef authobs fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Praxis identity
    class OGX application
    class PostgreSQL statestorage
    class vLLM,OpenAI,AnthropicAPI,AzureOAI,Bedrock,VertexAI,Watsonx,Gemini inference
    class Milvus,PgVector,Qdrant vectorstore
    class Brave,Tavily,S3 externalservice
    class OIDC,OTel,Prometheus authobs
