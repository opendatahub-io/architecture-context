graph TB
    subgraph CorePlatform["Core Platform Infrastructure"]
        direction TB
        RhodsOp["rhods-operator<br/>Platform Lifecycle Manager"]
        KubeAuthProxy["kube-auth-proxy<br/>Gateway Authentication"]
        OdhGitOps["odh-gitops<br/>Gateway Provisioning"]
    end

    subgraph GatewayLayer["Gateway & Ingress Layer"]
        direction TB
        DSGateway["data-science-gateway<br/>Platform Ingress"]
        MaaSGateway["maas-default-gateway<br/>Multi-Tenant Ingress"]
        InfGateway["inference-gateway<br/>llm-d Distributed Inference"]
        OAIGateway["openshift-ai-inference<br/>KServe Model Serving"]
        PraxisExtProc["praxis-extproc<br/>Envoy ExtProc"]
        AIGatewayCtrl["ai-gateway-controller<br/>External Model Routing"]
    end

    subgraph ModelServing["Model Serving"]
        direction TB
        KServe["KServe<br/>InferenceService +<br/>LLMInferenceService"]
        OdhModelCtrl["odh-model-controller<br/>Platform Bridge"]
        MaaS["models-as-a-service<br/>Multi-Tenant Access"]
        ModelRegistry["model-registry-operator<br/>Model Catalog"]
        LlmdRouter["llm-d-router<br/>EPP ext_proc Routing"]
        LlmdModelSvc["llm-d-model-service<br/>P/D Orchestration"]
        LlmdAsync["llm-d-async<br/>Async Inference"]
        BatchGW["batch-gateway<br/>Batch Inference"]
    end

    subgraph MLPipeline["ML Pipeline & Training"]
        direction TB
        DSPipelines["data-science-pipelines-operator<br/>Kubeflow Pipelines V2"]
        ArgoWF["Argo Workflows<br/>Pipeline Execution"]
        Trainer["trainer<br/>Kubeflow Trainer"]
        KubeRay["kuberay<br/>Ray Clusters"]
        KueueOp["kueue-operator<br/>Job Queuing"]
        SparkOp["spark-operator<br/>Spark Applications"]
    end

    subgraph FeatureExperiment["Feature Store & Experiment Tracking"]
        direction TB
        Feast["feast<br/>Feature Store"]
        FeastModule["feast-module-operator<br/>Feast Lifecycle"]
        MLflow["mlflow<br/>Experiment Tracking"]
        MLflowOp["mlflow-operator<br/>MLflow Lifecycle"]
    end

    subgraph UserWorkloads["User Workloads & UI"]
        direction TB
        Dashboard["odh-dashboard<br/>Federated Micro-Frontend"]
        Workbenches["workbenches<br/>Workspace Controller"]
        WorkbenchesOp["workbenches-operator<br/>Workbench Lifecycle"]
        Kubeflow["kubeflow<br/>Notebook Controllers"]
    end

    subgraph SecurityObservability["Security & Observability"]
        direction TB
        KubeRBACProxy["kube-rbac-proxy<br/>Metrics Auth Sidecar"]
        OdhObserv["odh-observability<br/>Monitoring Stack"]
        TrustyAI["trustyai-service-operator<br/>AI Fairness"]
        Kuadrant["Kuadrant / Authorino<br/>Policy Engine"]
    end

    subgraph AIServices["AI Services"]
        direction TB
        MCPLifecycle["mcp-lifecycle-operator<br/>MCP Server Management"]
        AIGatewayOp["ai-gateway-operator<br/>AI Gateway Lifecycle"]
        PraxisAI["praxis-ai<br/>Guardrails & Metering"]
        DataConnectHub["data-connect-hub<br/>Data Connectivity"]
    end

    subgraph ExternalDeps["External Services"]
        direction TB
        S3["S3 / Object Storage"]
        ContainerReg["Container Registry<br/>quay.io"]
        K8sAPI["Kubernetes API Server"]
        IstioCP["Istio Control Plane"]
    end

    %% rhods-operator orchestrates everything
    RhodsOp -->|deploys all components| KServe
    RhodsOp -->|creates gateway| DSGateway
    RhodsOp -->|deploys| KubeAuthProxy
    RhodsOp -->|manages lifecycle| Dashboard
    RhodsOp -->|manages lifecycle| DSPipelines
    RhodsOp -->|manages lifecycle| MaaS
    RhodsOp -->|manages lifecycle| ModelRegistry
    RhodsOp -->|manages lifecycle| KubeRay
    RhodsOp -->|manages lifecycle| KueueOp
    RhodsOp -->|manages lifecycle| Trainer
    RhodsOp -->|manages lifecycle| Workbenches

    %% Gateway layer relationships
    OdhGitOps -->|provisions| MaaSGateway
    OdhGitOps -->|provisions| OAIGateway
    KubeAuthProxy -->|ext_authz| DSGateway
    PraxisExtProc -->|pre-auth + post-auth ExtProc| MaaSGateway
    AIGatewayCtrl -->|EnvoyExtensionPolicy| MaaSGateway

    %% KServe dependencies
    KServe -->|traffic routing| DSGateway
    KServe -->|model serving| MaaSGateway
    KServe -->|Gateway API| OAIGateway
    OdhModelCtrl -->|Routes, NetworkPolicy, RBAC| KServe
    OdhModelCtrl -->|Kuadrant AuthPolicy| Kuadrant

    %% MaaS dependencies
    MaaS -->|model serving backend| KServe
    MaaS -->|AuthPolicy + RateLimitPolicy| Kuadrant
    MaaS -->|tenant routing| MaaSGateway

    %% llm-d stack
    LlmdRouter -->|ext_proc routing| InfGateway
    LlmdModelSvc -->|creates P/D deployments| KServe
    LlmdAsync -->|async requests| LlmdRouter
    BatchGW -->|batch processing| KServe

    %% Pipeline dependencies
    DSPipelines -->|model deployment| KServe
    DSPipelines -->|distributed compute| KubeRay
    DSPipelines -->|experiment tracking| MLflow
    DSPipelines -->|workflow execution| ArgoWF
    DSPipelines -->|job scheduling| KueueOp

    %% Feature store and experiment
    Feast -->|feature injection| Kubeflow
    Feast -->|feature serving| KServe
    FeastModule -->|manages| Feast
    MLflowOp -->|manages| MLflow
    SparkOp -->|distributed compute| Feast

    %% User workloads
    Dashboard -->|manages| KServe
    Dashboard -->|displays| ModelRegistry
    Dashboard -->|manages| Workbenches
    Dashboard -->|UI for| DSPipelines
    Dashboard -->|routing| DSGateway
    WorkbenchesOp -->|manages| Workbenches
    Kubeflow -->|notebook lifecycle| Workbenches

    %% External dependencies
    KServe -->|model storage| S3
    KServe -->|runtime images| ContainerReg
    ModelRegistry -->|artifact storage| S3
    DSPipelines -->|pipeline artifacts| S3
    RhodsOp -->|API calls| K8sAPI
    DSGateway -->|data plane| IstioCP

    %% Observability
    OdhObserv -->|monitors| KServe
    OdhObserv -->|monitors| DSPipelines
    KubeRBACProxy -->|metrics auth| KServe
    KubeRBACProxy -->|metrics auth| KubeRay

