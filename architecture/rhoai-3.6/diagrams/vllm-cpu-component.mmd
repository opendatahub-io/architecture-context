graph TB
    subgraph "vLLM CPU Inference Server"
        direction TB
        CLI["vllm serve CLI<br/>(entrypoints.cli.main)"]
        APIServer["FastAPI/ASGI Application<br/>(api_server)"]
        AuthMW["AuthenticationMiddleware<br/>(Bearer Token)"]
        SSLRefresh["SSLCertRefresher<br/>(watchfiles)"]
        DPSupervisor["DP Supervisor<br/>(dp_supervisor, :9256)"]

        subgraph "API Routers"
            direction LR
            OpenAIRouter["OpenAI Router<br/>/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models"]
            AnthropicRouter["Anthropic Router<br/>/v1/messages"]
            SageMakerRouter["SageMaker Router<br/>/ping, /invocations"]
            DisaggRouter["Disaggregated Router<br/>/inference/v1/generate"]
            AudioRouter["Audio Router<br/>/v1/audio/transcriptions"]
        end

        Engine["AsyncLLM Engine<br/>(PagedAttention, Continuous Batching)"]

        CLI -->|launches| APIServer
        APIServer -->|optional| AuthMW
        APIServer -->|TLS reload| SSLRefresh
        APIServer --> OpenAIRouter
        APIServer --> AnthropicRouter
        APIServer --> SageMakerRouter
        APIServer --> DisaggRouter
        APIServer --> AudioRouter
        OpenAIRouter --> Engine
        AnthropicRouter --> Engine
        SageMakerRouter --> Engine
        DisaggRouter --> Engine
        AudioRouter --> Engine
        DPSupervisor -->|manages| APIServer
    end

    subgraph "gRPC Entry Point (Optional)"
        GRPCServer["gRPC Server<br/>VllmEngine :50051<br/>(insecure)"]
        GRPCServer --> Engine
    end

    Client[Client / KServe Route] -->|"HTTP/HTTPS :8000<br/>Bearer Token (optional)"| APIServer
    GRPCClient[gRPC Client] -->|"gRPC :50051<br/>No TLS"| GRPCServer

    Engine -->|"HTTPS :443<br/>Bearer (HF_TOKEN)"| HFHub[HuggingFace Hub]
    Engine -->|"HTTPS :443<br/>AWS IAM"| S3[S3 Storage]
    Engine -->|in-memory| Model["Model Weights<br/>(CPU Memory)"]

    APIServer -->|":8000 /metrics"| Prometheus[Prometheus]
    APIServer -->|"OTLP (optional)"| OTel[OpenTelemetry Collector]

    style CLI fill:#4a90e2,color:#fff
    style APIServer fill:#4a90e2,color:#fff
    style AuthMW fill:#e8544e,color:#fff
    style SSLRefresh fill:#e8544e,color:#fff
    style Engine fill:#4a90e2,color:#fff
    style GRPCServer fill:#4a90e2,color:#fff
    style DPSupervisor fill:#4a90e2,color:#fff
    style OpenAIRouter fill:#6bb5e0
    style AnthropicRouter fill:#6bb5e0
    style SageMakerRouter fill:#6bb5e0
    style DisaggRouter fill:#6bb5e0
    style AudioRouter fill:#6bb5e0
    style HFHub fill:#f5a623
    style S3 fill:#f5a623
    style Prometheus fill:#7ed321
    style OTel fill:#7ed321
    style Client fill:#e8e8e8,stroke:#333
    style GRPCClient fill:#e8e8e8,stroke:#333
    style Model fill:#d5e8d4
