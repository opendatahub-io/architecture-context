graph TB
    subgraph CorePod["Core Dashboard Pod"]
        direction TB
        KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS + OpenShift Auth"]
        NodeBackend["Node.js/Fastify Backend<br/>8080/TCP HTTP<br/>(loopback only)"]
        CoreBFF["core-bff<br/>8943/TCP HTTPS<br/>NIM, S3, Connections"]

        KubeRBACProxy -->|"x-forwarded-access-token<br/>localhost"| NodeBackend
    end

    subgraph Operator["Dashboard Operator"]
        DashOp["dashboard-operator<br/>Go controller-runtime"]
        Webhook["Webhook Server<br/>9443/TCP"]
        WorkspaceCtrl["Workspace Controller"]
        WKindCtrl["WorkspaceKind Controller"]
    end

    subgraph FederatedModules["Federated BFF Modules"]
        direction TB
        GenAI["gen-ai BFF<br/>8080/TCP"]
        MaaS["maas BFF<br/>8080/TCP"]
        ModelReg["model-registry BFF<br/>8080/TCP"]
        AgentOps["agent-ops BFF<br/>8080/TCP"]
        AutoML["automl BFF<br/>8080/TCP"]
        AutoRAG["autorag BFF<br/>8080/TCP"]
        EvalHub["eval-hub BFF<br/>8080/TCP"]
        MLflow["mlflow BFF<br/>8080/TCP"]
        DataConnect["data-connect-hub BFF<br/>8080/TCP"]
        DataReg["data-registry BFF<br/>8080/TCP"]
        Notebooks["notebooks BFF<br/>8080/TCP"]
    end

    User["User Browser"] -->|"HTTPS/443"| Gateway["data-science-gateway<br/>HTTPRoute"]
    Gateway -->|"HTTPS/8443"| KubeRBACProxy

    NodeBackend -->|"/_mf/:name/*"| GenAI
    NodeBackend -->|"/_mf/:name/*"| MaaS
    NodeBackend -->|"/_mf/:name/*"| ModelReg
    NodeBackend -->|"/_mf/:name/*"| AgentOps
    NodeBackend -->|"/_mf/:name/*"| AutoML
    NodeBackend -->|"/_mf/:name/*"| AutoRAG
    NodeBackend -->|"/_mf/:name/*"| EvalHub
    NodeBackend -->|"/_mf/:name/*"| MLflow
    NodeBackend -->|"/_mf/:name/*"| DataConnect
    NodeBackend -->|"/_mf/:name/*"| DataReg
    NodeBackend -->|"/_mf/:name/*"| Notebooks

    DashboardCR["Dashboard CR"] -->|"watched by"| DashOp
    DashOp -->|"manages"| CorePod
    DashOp -->|"manages"| FederatedModules
    DashOp -->|"creates"| HTTPRoute["HTTPRoute"]
    DashOp -->|"creates"| NetPol["NetworkPolicies"]
    DashOp -->|"creates"| RBAC["RBAC Resources"]

    NodeBackend -->|"HTTPS/6443<br/>User Impersonation"| K8sAPI["Kubernetes API"]

    style KubeRBACProxy fill:#4a90e2,color:#fff
    style NodeBackend fill:#4a90e2,color:#fff
