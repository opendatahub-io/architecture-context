graph TD
    subgraph "Caller Identity"
        User["User / ServiceAccount<br/>(kubeconfig or in-cluster SA)"]
    end

    subgraph "Required RBAC Permissions"
        direction TB

        subgraph "Trainer Permissions"
            TrainerRole["Required Role<br/>trainer.kubeflow.org"]
            TrainJobs["trainjobs"]
            TrainingRuntimes["trainingruntimes"]
            ClusterRuntimes["clustertrainingruntimes"]
            TrainerRole -->|"get, list, watch,<br/>create, delete, patch"| TrainJobs
            TrainerRole -->|"get, list, watch,<br/>create, delete, patch"| TrainingRuntimes
            TrainerRole -->|"get, list, watch,<br/>create, delete, patch"| ClusterRuntimes
        end

        subgraph "Optimizer Permissions"
            KatibRole["Required Role<br/>kubeflow.org"]
            Experiments["experiments"]
            Trials["trials"]
            KatibRole -->|"get, list, watch,<br/>create, delete"| Experiments
            KatibRole -->|"get, list, watch,<br/>create, delete"| Trials
        end

        subgraph "Spark Permissions"
            SparkRole["Required Role<br/>sparkoperator.k8s.io"]
            SparkConnects["sparkconnects"]
            SparkRole -->|"get, list, watch,<br/>create, delete"| SparkConnects
        end

        subgraph "Core Permissions"
            CoreRole["Required Role<br/>core API group"]
            Pods["pods"]
            ConfigMaps["configmaps"]
            Events["events"]
            CoreRole -->|"get, list, watch"| Pods
            CoreRole -->|"get, list, watch"| ConfigMaps
            CoreRole -->|"get, list, watch"| Events
        end
    end

    User -->|"needs"| TrainerRole
    User -->|"needs"| KatibRole
    User -->|"needs"| SparkRole
    User -->|"needs"| CoreRole

    subgraph "Secrets Used"
        HFToken["HF_TOKEN<br/>(env var)<br/>HuggingFace auth"]
        AccessToken["ACCESS_TOKEN<br/>(env var)<br/>Initializer auth"]
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>(env var)<br/>S3 checkpoint storage"]
        SAToken["KUBEFLOW_TRAINER_SERVER_TOKEN<br/>(projected SA token)<br/>5 min cache TTL"]
    end

    style User fill:#4a90e2,color:#fff
    style TrainerRole fill:#f5a623
    style KatibRole fill:#f5a623
    style SparkRole fill:#f5a623
    style CoreRole fill:#f5a623

    style TrainJobs fill:#7ed321
    style TrainingRuntimes fill:#7ed321
    style ClusterRuntimes fill:#7ed321
    style Experiments fill:#7ed321
    style Trials fill:#7ed321
    style SparkConnects fill:#7ed321
    style Pods fill:#7ed321
    style ConfigMaps fill:#7ed321
    style Events fill:#7ed321

    style HFToken fill:#fce4ec,stroke:#c62828
    style AccessToken fill:#fce4ec,stroke:#c62828
    style AWSKey fill:#fce4ec,stroke:#c62828
    style SAToken fill:#fce4ec,stroke:#c62828
