graph TD
    subgraph "vLLM CPU — Authentication Model"
        direction TB

        Note["ℹ️ No Kubernetes RBAC<br/>vllm-cpu is a stateless application server<br/>No CRDs, no operator, no K8s API access"]

        subgraph "Application-Level Auth"
            direction TB

            VLLM_API_KEY["Environment Variable<br/>VLLM_API_KEY"]
            CLIArg["CLI Argument<br/>--api-key"]

            AuthMW["AuthenticationMiddleware<br/>(ASGI Middleware)"]

            VLLM_API_KEY -->|"configures"| AuthMW
            CLIArg -->|"configures"| AuthMW
        end

        subgraph "Endpoint Access Matrix"
            direction TB

            ProtectedEndpoints["Protected Endpoints<br/>(when auth enabled)"]
            UnprotectedEndpoints["Always Open Endpoints"]

            V1Chat["/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models<br/>/v1/messages<br/>/v1/responses<br/>... all /v1/* routes"]
            UtilEndpoints["/generate<br/>/tokenize<br/>/detokenize<br/>/load<br/>/version"]

            HealthEndpoints["/health<br/>/ready<br/>/readyz<br/>/ping"]

            ProtectedEndpoints --> V1Chat
            ProtectedEndpoints --> UtilEndpoints
            UnprotectedEndpoints --> HealthEndpoints
        end

        AuthMW -->|"Bearer Token<br/>validates against<br/>static token list"| ProtectedEndpoints
        AuthMW -.-|"bypassed"| UnprotectedEndpoints
    end

    subgraph "Container Security Context"
        direction TB

        UID["UID: 2000 (non-root)"]
        GID["GID: 0 (root group)<br/>OpenShift compatibility"]
        BaseImage["Base: ubi9/ubi-minimal-pqc"]
    end

    subgraph "Secrets (Environment Variables)"
        direction TB

        Secret1["VLLM_API_KEY<br/>API auth token<br/>No auto-rotation"]
        Secret2["HF_TOKEN<br/>HuggingFace auth<br/>No auto-rotation"]
        Secret3["S3_ACCESS_KEY_ID<br/>S3 access key<br/>No auto-rotation"]
        Secret4["S3_SECRET_ACCESS_KEY<br/>S3 secret key<br/>No auto-rotation"]
    end

    style Note fill:#fff3cd,stroke:#ffc107,color:#333
    style AuthMW fill:#e8544e,color:#fff
    style VLLM_API_KEY fill:#f5a623,color:#fff
    style CLIArg fill:#f5a623,color:#fff
    style ProtectedEndpoints fill:#d5e8d4,stroke:#82b366
    style UnprotectedEndpoints fill:#fff2cc,stroke:#d6b656
    style V1Chat fill:#d5e8d4,stroke:#82b366
    style UtilEndpoints fill:#d5e8d4,stroke:#82b366
    style HealthEndpoints fill:#fff2cc,stroke:#d6b656
    style UID fill:#dbeafe,stroke:#3b82f6
    style GID fill:#dbeafe,stroke:#3b82f6
    style BaseImage fill:#dbeafe,stroke:#3b82f6
    style Secret1 fill:#fecaca,stroke:#dc2626
    style Secret2 fill:#fecaca,stroke:#dc2626
    style Secret3 fill:#fecaca,stroke:#dc2626
    style Secret4 fill:#fecaca,stroke:#dc2626
