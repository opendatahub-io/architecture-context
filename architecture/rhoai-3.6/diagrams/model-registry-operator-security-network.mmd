graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["API Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP → 8443/TCP<br/>TLS Re-encrypt"]
        HTTPRoute["Gateway HTTPRoute<br/>via data-science-gateway<br/>TLS SIMPLE"]
    end

    subgraph AuthProxy["AUTH PROXY LAYER"]
        KRBAC_Reg["kube-rbac-proxy<br/>(Registry sidecar)<br/>:8443/TCP HTTPS<br/>TokenReview + SAR"]
        KRBAC_Cat["kube-rbac-proxy<br/>(Catalog sidecar)<br/>:8443/TCP HTTPS<br/>TokenReview + SAR"]
    end

    subgraph Application["APPLICATION LAYER"]
        direction TB

        subgraph NS_Registry["Namespace: {registries-namespace}"]
            Registry["Model Registry Server<br/>SA: {registry-name}<br/>:8080/TCP HTTP"]
        end

        subgraph NS_Operator["Namespace: {operator-namespace}"]
            Catalog["Model Catalog Server<br/>SA: model-catalog<br/>:8080/TCP HTTP"]
        end
    end

    subgraph DataLayer["DATA LAYER"]
        RegDB["Registry PostgreSQL/MySQL<br/>{registry-name}-postgres<br/>:5432/TCP or :3306/TCP<br/>Credentials Secret"]
        CatDB["Catalog PostgreSQL<br/>model-catalog-postgres<br/>:5432/TCP<br/>Credentials Secret"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        Operator["model-registry-operator<br/>SA: controller-manager<br/>:8443 metrics, :8081 health<br/>:9443 webhooks"]
        K8sAPI["Kubernetes API Server<br/>:6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Route
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| HTTPRoute

    %% Ingress → Auth Proxy
    Route -->|"HTTPS/8443<br/>Re-encrypt TLS<br/>Bearer Token"| KRBAC_Reg
    HTTPRoute -->|"HTTPS/8443<br/>TLS SIMPLE<br/>Bearer Token"| KRBAC_Reg
    Route -->|"HTTPS/8443<br/>Re-encrypt TLS<br/>Bearer Token"| KRBAC_Cat
    HTTPRoute -->|"HTTPS/8443<br/>TLS SIMPLE<br/>Bearer Token"| KRBAC_Cat

    %% Auth Proxy → API Server (auth check)
    KRBAC_Reg -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    KRBAC_Cat -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Auth Proxy → Application
    KRBAC_Reg -->|"HTTP/8080<br/>None (localhost)<br/>Pre-authorized"| Registry
    KRBAC_Cat -->|"HTTP/8080<br/>None (localhost)<br/>Pre-authorized"| Catalog

    %% Application → Data
    Registry -->|"TCP/5432 or 3306<br/>Optional TLS<br/>Credentials Secret"| RegDB
    Catalog -->|"TCP/5432<br/>None<br/>Credentials Secret"| CatDB

    %% Control Plane
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#e6d5f7,stroke:#9673a6,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route,HTTPRoute ingress
    class KRBAC_Reg,KRBAC_Cat authproxy
    class Registry,Catalog application
    class RegDB,CatDB data
    class Operator,K8sAPI controlplane
