graph TB
    subgraph InternalCluster["INTERNAL CLUSTER (Platform-Managed Trust)"]
        direction TB

        subgraph OrcNS["Namespace: guardrails / orchestrator"]
            Orchestrator["FMS Guardrails Orchestrator<br/>Initiates detection requests"]
        end

        subgraph DetectorNS["Namespace: guardrails / detector"]
            Detector["guardrails-regex-detector<br/>Port: 8080/TCP<br/>Protocol: HTTP (plain)<br/>Auth: None<br/>Crypto: None"]
        end
    end

    subgraph PlatformSecurity["PLATFORM SECURITY LAYER"]
        direction TB
        NetworkPolicy["NetworkPolicy<br/>(restrict to orchestrator)"]
        IstioMTLS["Istio mTLS<br/>(if service mesh enabled)"]
        AuthzPolicy["Istio AuthorizationPolicy<br/>(platform-level access control)"]
    end

    %% Flows
    Orchestrator -->|"POST /api/v1/text/contents<br/>HTTP/8080<br/>No app-level auth<br/>Platform: Istio mTLS if enabled"| Detector

    Detector -->|"HTTP Response<br/>JSON detection results"| Orchestrator

    %% Platform security annotations
    NetworkPolicy -.->|enforces| DetectorNS
    IstioMTLS -.->|encrypts| DetectorNS
    AuthzPolicy -.->|controls access| DetectorNS

    %% Notes
    NoEgress["No Egress Traffic<br/>Fully self-contained<br/>No K8s API access<br/>No secrets"]

    Detector --- NoEgress

    %% Styling
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef note fill:#fff2cc,stroke:#d6b656,stroke-width:1px,stroke-dasharray: 5 5

    class Orchestrator,Detector internal
    class NetworkPolicy,IstioMTLS,AuthzPolicy platform
    class NoEgress note
