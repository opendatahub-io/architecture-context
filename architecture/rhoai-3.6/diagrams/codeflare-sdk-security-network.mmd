graph TB
    subgraph UserEnv["USER ENVIRONMENT (Client-Side)"]
        User["Data Scientist<br/>(Jupyter Workbench / CI / Local)"]
        SDK["CodeFlare SDK<br/>(Python Library)<br/>No listening ports<br/>ContextVar isolation"]
        CertStore["Local TLS Certs<br/>RSA-3072, SHA-256<br/>Permissions: 0600"]

        User --> SDK
        SDK -->|"write certs<br/>0600 perms"| CertStore
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>Bearer/OIDC/OAuth"]

        subgraph CRDs["CRDs Consumed by SDK"]
            RayCluster["RayCluster CR<br/>(ray.io/v1)"]
            RayJob["RayJob CR<br/>(ray.io/v1)"]
            LocalQueue["LocalQueue<br/>(kueue.x-k8s.io)"]
            HTTPRoute["HTTPRoute<br/>(gateway.networking.k8s.io)"]
            Route["OpenShift Route<br/>(route.openshift.io)"]
            GatewayConfig["GatewayConfig<br/>(services.platform.opendatahub.io)"]
            DSCluster["DataScienceCluster<br/>(datasciencecluster.opendatahub.io)"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES (Internal)"]
        RayHead["Ray Head Node<br/>8265/TCP or via Route<br/>TLS / mTLS<br/>Bearer token (OCP)"]
        KubeRayOp["KubeRay Operator<br/>(creates CA secrets)"]
        KueueCtrl["Kueue Controller<br/>(admits workloads)"]
    end

    subgraph External["EXTERNAL SERVICES"]
        PyPI["PyPI<br/>pypi.org<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% SDK to K8s API flows
    SDK -->|"HTTPS/6443<br/>TLS 1.2+<br/>kube-authkit<br/>(Bearer/OIDC/OAuth)"| K8sAPI
    K8sAPI --- RayCluster
    K8sAPI --- RayJob
    K8sAPI --- LocalQueue
    K8sAPI --- HTTPRoute
    K8sAPI --- Route
    K8sAPI --- GatewayConfig
    K8sAPI --- DSCluster

    %% SDK to Ray Head
    SDK -->|"HTTPS/8265 or 443<br/>TLS + mTLS<br/>Bearer token (OCP)"| RayHead

    %% Indirect interactions
    KubeRayOp -.->|"watches CRDs<br/>creates CA secrets"| K8sAPI
    KueueCtrl -.->|"admits workloads<br/>from LocalQueue"| K8sAPI

    %% Package install
    SDK -.->|"HTTPS/443<br/>TLS 1.2+<br/>pip install"| PyPI

    %% Styling
    classDef client fill:#dfe6e9,stroke:#636e72,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef crd fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef cert fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User,SDK client
    class K8sAPI controlplane
    class RayCluster,RayJob,LocalQueue,HTTPRoute,Route,GatewayConfig,DSCluster crd
    class RayHead,KubeRayOp,KueueCtrl service
    class PyPI external
    class CertStore cert
