graph TD
    subgraph "Training Hub Security Model"
        direction TB
        Note["Training Hub is a Python library, not a Kubernetes operator.<br/>No Kubernetes RBAC roles, bindings, or service accounts are defined.<br/>Security is based on environment variable secrets and process isolation."]
    end

    subgraph "Environment Variable Secrets"
        OPENAI["OPENAI_API_KEY<br/>Type: Env Var<br/>Purpose: LLM API auth for GEPA"]
        WANDB["WANDB_API_KEY<br/>Type: Env Var<br/>Purpose: W&B experiment tracking"]
        AWS["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>Type: Env Var<br/>Purpose: S3 checkpoint storage"]
        HF["HF_TOKEN<br/>Type: Env Var<br/>Purpose: HuggingFace Hub access"]
    end

    subgraph "Authentication Flows"
        GEPAAuth["GEPA Prompt Optimization<br/>POST to LLM API<br/>Auth: Bearer Token"]
        S3Auth["Checkpoint Mirroring<br/>PUT/GET to S3<br/>Auth: AWS IAM credentials"]
        WandBAuth["Experiment Logging<br/>POST to W&B<br/>Auth: API Key"]
        HFAuth["Model/Dataset Download<br/>GET from HuggingFace<br/>Auth: HF Token"]
    end

    subgraph "Trust Boundaries"
        YAMLConfig["YAML Config Files<br/>Trust boundary: _resolve_dotted_path<br/>imports arbitrary modules<br/>cli.py:386-433"]
        ProcIsolation["Process Isolation<br/>Secrets in /proc/environ<br/>Risk: shared pods"]
    end

    OPENAI -->|"authenticates"| GEPAAuth
    AWS -->|"authenticates"| S3Auth
    WANDB -->|"authenticates"| WandBAuth
    HF -->|"authenticates"| HFAuth

    style Note fill:#f9f9f9,stroke:#999
    style OPENAI fill:#f8cecc,stroke:#b85450
    style WANDB fill:#f8cecc,stroke:#b85450
    style AWS fill:#f8cecc,stroke:#b85450
    style HF fill:#f8cecc,stroke:#b85450
