graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator-<br/>controller-manager"]
        SA_Registry["{registry-name}"]
        SA_Catalog["model-catalog"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator-<br/>manager-rolebinding"]
        CRB_Metrics["model-registry-operator-<br/>metrics-auth-rolebinding"]
        CRB_RegAuth["{registry-name}-<br/>auth-delegator"]
        CRB_CatAuth["model-catalog-<br/>auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-<br/>manager-role"]
        CR_MetricsAuth["model-registry-operator-<br/>metrics-auth-role"]
        CR_MetricsRead["model-registry-operator-<br/>metrics-reader"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
    end

    subgraph APIResources["API Resources"]
        MR["modelregistry.opendatahub.io<br/>ModelRegistry"]
        Core["core<br/>configmaps, secrets,<br/>services, serviceaccounts,<br/>persistentvolumeclaims"]
        Apps["apps<br/>deployments"]
        Auth["authentication.k8s.io<br/>tokenreviews"]
        AuthZ["authorization.k8s.io<br/>subjectaccessreviews"]
        Routes["route.openshift.io<br/>routes, routes/custom-host"]
        Users["user.openshift.io<br/>groups"]
        GW["gateway.networking.k8s.io<br/>httproutes, referencegrants"]
        NetPol["networking.k8s.io<br/>networkpolicies"]
        RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterrolebindings"]
        Migration["migration.k8s.io<br/>storageversionmigrations"]
        Metrics["/metrics"]
    end

    subgraph DynamicRBAC["Per-Registry Dynamic RBAC"]
        RegRole["registry-user-{name}<br/>(Role, namespace-scoped)"]
        RegGroup["{name}-users<br/>(OpenShift Group)"]
        RegBinding["{name}-users<br/>(RoleBinding)"]
    end

    subgraph CatalogRBAC["Catalog RBAC"]
        CatRole["model-catalog<br/>(Role)"]
        CatAdminRole["model-catalog-admin<br/>(Role)"]
        CatAuthBinding["model-catalog-authenticated<br/>(RoleBinding)"]
        CatAdminBinding["model-catalog-admin-binding<br/>(RoleBinding)"]
        SysAuth["Group: system:authenticated"]
        AdminGroup["Group: admin-group"]
    end

    %% Operator SA bindings
    SA_Operator -->|"bound via"| CRB_Manager
    SA_Operator -->|"bound via"| CRB_Metrics
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_MetricsAuth

    %% Manager role → resources
    CR_Manager -->|"CRUD"| MR
    CR_Manager -->|"CRUD"| Core
    CR_Manager -->|"CRUD"| Apps
    CR_Manager -->|"create"| Auth
    CR_Manager -->|"create"| AuthZ
    CR_Manager -->|"CRUD"| Routes
    CR_Manager -->|"CRUD"| Users
    CR_Manager -->|"CRUD"| GW
    CR_Manager -->|"CRUD"| NetPol
    CR_Manager -->|"CRUD"| RBAC
    CR_Manager -->|"CRUD"| Migration

    %% Metrics
    CR_MetricsAuth -->|"create"| Auth
    CR_MetricsAuth -->|"create"| AuthZ
    CR_MetricsRead -->|"get"| Metrics

    %% Registry SA bindings
    SA_Registry -->|"bound via"| CRB_RegAuth
    CRB_RegAuth -->|"grants"| CR_AuthDelegator

    %% Catalog SA bindings
    SA_Catalog -->|"bound via"| CRB_CatAuth
    CRB_CatAuth -->|"grants"| CR_AuthDelegator

    %% Dynamic per-registry
    RegGroup -->|"bound via"| RegBinding
    RegBinding -->|"grants"| RegRole

    %% Catalog
    SysAuth -->|"bound via"| CatAuthBinding
    CatAuthBinding -->|"grants"| CatRole
    AdminGroup -->|"bound via"| CatAdminBinding
    CatAdminBinding -->|"grants"| CatAdminRole

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style SA_Registry fill:#4a90e2,color:#fff
    style SA_Catalog fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsRead fill:#f5a623,color:#fff
    style CR_AuthDelegator fill:#f5a623,color:#fff
    style CR_Admin fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style MR fill:#7ed321
    style Core fill:#7ed321
    style Apps fill:#7ed321
    style RegRole fill:#e6d5f7
    style RegGroup fill:#e6d5f7
    style CatRole fill:#e6d5f7
    style CatAdminRole fill:#e6d5f7
