graph TD
    subgraph "llm-d-inference-sim RBAC"
        direction TB

        Note["No ClusterRoles, Roles, or RoleBindings defined.<br/><br/>The simulator is a testing/development tool<br/>that does not interact with the Kubernetes API<br/>and requires no RBAC permissions.<br/><br/>Authentication: None on all endpoints<br/>Authorization: None (open access)"]
    end

    subgraph "Secrets"
        HFToken["HF_TOKEN<br/>Type: Opaque (env var)<br/>Purpose: HuggingFace API token<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    subgraph "Security Posture"
        direction LR
        TLS["TLS: Optional<br/>Min: TLS 1.2<br/>Ciphers: AEAD + ECDHE"]
        Auth["Auth: None<br/>(testing tool)"]
        Image["Image: distroless/static:nonroot<br/>Static binary, no shell"]
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style HFToken fill:#f8cecc,stroke:#b85450
    style TLS fill:#d5e8d4,stroke:#82b366
    style Auth fill:#f8cecc,stroke:#b85450
    style Image fill:#d5e8d4,stroke:#82b366
