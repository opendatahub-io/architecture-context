    Sidecar -->|"route ingress<br/>HTTPS/8080"| OpenShiftRouter["OpenShift Router"]

    %% External Dependencies
    Sidecar -->|"API watch<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>v0.31.3"]
    Sidecar -->|"structured logging"| Logr["go-logr/logr<br/>v1.4.2"]
    Sidecar -->|"request correlation"| UUID["google/uuid<br/>v1.6.0"]
    Sidecar -->|"proxy caching"| LRU["hashicorp/golang-lru<br/>v2.0.7"]
    Sidecar -->|"informers + dynamic client"| ClientGo["k8s.io/client-go<br/>v0.31.3"]
    Sidecar -->|"API types"| APIMachinery["k8s.io/apimachinery<br/>v0.31.3"]

