graph LR
    Sidecar["llm-d-routing-sidecar<br/>(Go Reverse Proxy Sidecar)"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>HTTP/HTTPS port 8001"| LocalDecoder["Local vLLM Decoder<br/>(co-located)"]
    Sidecar -->|"reverse proxy<br/>HTTP/HTTPS per-request"| RemotePrefiller["Remote vLLM Prefiller(s)"]
