graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["evalhub-evalhub-opendatahub-job"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB["swebench-eval<br/>(RoleBinding, namespace-scoped)"]
        CRB["swebench-eval-anyuid-NAMESPACE<br/>(ClusterRoleBinding)"]
    end

    subgraph Roles["Roles"]
        Role["swebench-eval<br/>(Role, namespace-scoped)"]
        CR["system:openshift:scc:anyuid<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        Jobs["batch<br/>jobs"]
        Pods["core<br/>pods"]
        PodsLog["core<br/>pods/log"]
    end

    subgraph SCCAccess["Security Context Constraints"]
        AnyUID["anyuid SCC<br/>Allows root container execution"]
    end

    SA -->|bound via| RB
    SA -->|bound via| CRB
    RB -->|grants| Role
    CRB -->|grants| CR
    Role -->|create, get, list, delete| Jobs
    Role -->|get, list| Pods
    Role -->|get, list| PodsLog
    CR -->|allows| AnyUID

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#dae8fc,stroke:#6c8ebf
    style CRB fill:#dae8fc,stroke:#6c8ebf
    style Role fill:#f5a623,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style Jobs fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style PodsLog fill:#7ed321,stroke:#333
    style AnyUID fill:#f8cecc,stroke:#b85450
