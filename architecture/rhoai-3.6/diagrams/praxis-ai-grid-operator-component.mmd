graph TB
    subgraph ControlPlane["Control Plane (operator)"]
        direction TB
        Controllers["Kubernetes Controllers<br/>GridNetwork, GridSite,<br/>InferenceProvider, AgentToolProvider"]
        SWIMRuntime["SWIM Runtime<br/>7946/UDP"]
        CRDTEngine["CRDT Engine<br/>LWW Registers, OR-Sets, G-Counters"]
        ScoringEngine["Scoring Engine<br/>noMetrics / queueDepth / kvCachePressure"]
        OverlayRenderer["Overlay Renderer<br/>ConfigMap Writer"]
        Controllers --> CRDTEngine
        Controllers --> ScoringEngine
        SWIMRuntime --> CRDTEngine
        ScoringEngine --> OverlayRenderer
    end

    subgraph EnrollmentSvc["Enrollment Service"]
        direction TB
        EnrollmentAPI["Enrollment API<br/>8443/TCP HTTPS"]
        PrivateCA["Private CA<br/>rcgen X.509"]
        TokenStore["Token Store<br/>Postgres"]
        EnrollmentAPI --> PrivateCA
        EnrollmentAPI --> TokenStore
    end

    subgraph DataPlane["Data Plane (grid-gateway)"]
        direction TB
        PraxisProxy["Praxis/Pingora Proxy"]
        AGNFilters["AGN Routing Filters"]
        APITranslation["API Translation<br/>OpenAI, Anthropic, Bedrock, Vertex"]
        CredInjection["Credential Injection"]
        PraxisProxy --> AGNFilters
        PraxisProxy --> APITranslation
        PraxisProxy --> CredInjection
    end

    subgraph Sidecars["Sidecars"]
        OverlaySync["grid-overlay-sync<br/>ConfigMap → File"]
    end

    %% CRD interactions
    GridNetworkCR["GridNetwork CR"]
    GridSiteCR["GridSite CR"]
    InferenceProviderCR["InferenceProvider CR"]
    AgentToolProviderCR["AgentToolProvider CR"]

    GridNetworkCR -->|watched by| Controllers
    GridSiteCR -->|watched/created by| Controllers
    InferenceProviderCR -->|watched by| Controllers
    AgentToolProviderCR -->|watched by| Controllers

    %% Overlay flow
    OverlayRenderer -->|writes| OverlayCM["Routing Overlay<br/>ConfigMap"]
    OverlayCM -->|watched by| OverlaySync
    OverlaySync -->|writes file| PraxisProxy

    %% SWIM peers
    SWIMRuntime -->|gossip| SWIMPeers["Remote SWIM Peers<br/>7946/UDP AES-256-GCM"]

    %% Enrollment to operator
    EnrollmentSvc -->|issues certs| ControlPlane

    %% Signal scraping
    SignalsClient["signals-client"] -->|mTLS scrape| RemoteSignals["Remote Signal Endpoints"]
    SignalsClient --> ScoringEngine

    %% External
    K8sAPI["Kubernetes API<br/>443/TCP"]
    Controllers -->|CRD watch/CRUD| K8sAPI
    OverlayRenderer -->|ConfigMap write| K8sAPI

    %% Styling
    style ControlPlane fill:#4a90e2,stroke:#333,color:#fff
    style EnrollmentSvc fill:#9b59b6,stroke:#333,color:#fff
    style DataPlane fill:#e67e22,stroke:#333,color:#fff
    style Sidecars fill:#3498db,stroke:#333,color:#fff
    style GridNetworkCR fill:#f5a623,stroke:#333
    style GridSiteCR fill:#f5a623,stroke:#333
    style InferenceProviderCR fill:#f5a623,stroke:#333
    style AgentToolProviderCR fill:#f5a623,stroke:#333
    style OverlayCM fill:#f5a623,stroke:#333
    style SWIMPeers fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style RemoteSignals fill:#e8e8e8,stroke:#333
