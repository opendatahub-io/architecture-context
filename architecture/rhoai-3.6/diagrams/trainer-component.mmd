graph TB
    subgraph Trainer["Kubeflow Trainer Operator"]
        direction TB
        Controller["trainer-controller-manager<br/>(Go controller-runtime)<br/>Ports: 8081, 8443, 9443, 10443"]
        Webhook["Webhook Server<br/>9443/TCP HTTPS"]
        MetricsServer["Metrics Server<br/>8443/TCP HTTPS"]
        StatusServer["Status Server<br/>10443/TCP HTTPS<br/>(alpha, feature-gated)"]

        Controller -->|serves| Webhook
        Controller -->|serves| MetricsServer
        Controller -->|serves| StatusServer
    end

    subgraph InitContainers["Init Containers (injected into training pods)"]
        DatasetInit["dataset-initializer<br/>(Python)<br/>Downloads datasets"]
        ModelInit["model-initializer<br/>(Python)<br/>Downloads model weights"]
    end

    subgraph Plugins["ML Framework Plugins"]
        PyTorch["PyTorch Plugin"]
        DeepSpeed["DeepSpeed Plugin"]
        MPI["MPI Plugin"]
        XGBoost["XGBoost Plugin"]
        MLX["MLX Plugin"]
        JAX["JAX Plugin"]
    end

    %% CRDs
    TrainJobCR["TrainJob CR<br/>(Namespaced)"]
    RuntimeCR["TrainingRuntime CR<br/>(Namespaced)"]
    ClusterRuntimeCR["ClusterTrainingRuntime CR<br/>(Cluster-scoped)"]
    OptJobCR["OptimizationJob CR<br/>(Namespaced)"]
    ConfigCR["Configuration CR<br/>(controller config)"]

    %% User interaction
    User["User / Pipeline"] -->|creates| TrainJobCR
    TrainJobCR -->|watched by| Controller
    TrainJobCR -->|references| RuntimeCR
    TrainJobCR -->|references| ClusterRuntimeCR
    OptJobCR -->|watched by| Controller
    ConfigCR -->|configures| Controller

    %% Plugin chain
    Controller -->|delegates to| Plugins
    Plugins -->|builds| JobSetCR["JobSet CR"]

    %% Init containers injected
    Controller -->|injects| DatasetInit
    Controller -->|injects| ModelInit

    %% Training pods report back
    TrainingPod["Training Pod"] -->|reports status| StatusServer

    %% External dependencies
    Controller -->|creates/watches| JobSetCR
    Controller -->|creates| PodGroupCR["PodGroup CR<br/>(gang scheduling)"]
    Controller -->|integrates| Katib["Katib<br/>(hyperparameter search)"]

    %% Monitoring
    Prometheus["Prometheus<br/>(openshift-monitoring)"] -->|scrapes| MetricsServer

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style StatusServer fill:#4a90e2,stroke:#333,color:#fff
    style DatasetInit fill:#50c878,stroke:#333,color:#fff
    style ModelInit fill:#50c878,stroke:#333,color:#fff
    style TrainJobCR fill:#f5a623,stroke:#333
    style RuntimeCR fill:#f5a623,stroke:#333
    style ClusterRuntimeCR fill:#f5a623,stroke:#333
    style OptJobCR fill:#f5a623,stroke:#333
    style ConfigCR fill:#f5a623,stroke:#333
    style JobSetCR fill:#f5a623,stroke:#333
    style PodGroupCR fill:#f5a623,stroke:#333
    style Katib fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style User fill:#d5e8d4,stroke:#333
    style TrainingPod fill:#d5e8d4,stroke:#333
