graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["feast-operator-controller-manager<br/>(redhat-ods-applications)"]
        PerCRSA["per-CR ServiceAccount<br/>(user namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["feast-operator-manager-rolebinding"]
        CRB2["feast-operator-metrics-auth-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["feast-operator-manager-role"]
        CR2["feast-operator-metrics-auth-role"]
        CR3["feast-operator-metrics-reader"]
        CR4["feast-operator-featurestore-editor-role"]
        CR5["feast-operator-featurestore-viewer-role"]
    end

    subgraph ManagerResources["Manager Role Resources (12 API Groups)"]
        FeastCRDs["feast.dev<br/>featurestores<br/>featurestores/finalizers<br/>featurestores/status"]
        AppsDeploy["apps<br/>deployments"]
        CoreRes["core<br/>configmaps, services,<br/>pvcs, pods, serviceaccounts"]
        AutoscaleRes["autoscaling<br/>horizontalpodautoscalers"]
        BatchRes["batch<br/>cronjobs"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        RouteRes["route.openshift.io<br/>routes"]
        MonitorRes["monitoring.coreos.com<br/>servicemonitors"]
        KubeflowRes["kubeflow.org<br/>notebooks"]
        MLflowRes["mlflow.opendatahub.io<br/>mlflows"]
        SparkRes["sparkoperator.k8s.io<br/>sparkapplications"]
        ConfigRes["config.openshift.io<br/>apiservers"]
        PolicyRes["policy<br/>poddisruptionbudgets"]
    end

    subgraph MetricsResources["Metrics Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    subgraph FeatureStoreResources["FeatureStore Editor/Viewer Resources"]
        FSRes["feast.dev<br/>featurestores<br/>featurestores/status"]
    end

    %% Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2

    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2

    %% Manager role permissions
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| FeastCRDs
    CR1 -->|"create,delete,get,<br/>list,update,watch"| AppsDeploy
    CR1 -->|"create,delete,get,<br/>list,update,watch"| CoreRes
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| AutoscaleRes
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| BatchRes
    CR1 -->|"create,delete,get,<br/>list,update"| RBACRes
    CR1 -->|"create,delete,get,<br/>list,update,watch"| RouteRes
    CR1 -->|"create,delete,get,<br/>list,patch,watch"| MonitorRes
    CR1 -->|"get,list,watch"| KubeflowRes
    CR1 -->|"get,list,watch"| MLflowRes
    CR1 -->|"create,delete,get"| SparkRes
    CR1 -->|"get,list,watch"| ConfigRes
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| PolicyRes

    %% Metrics auth role
    CR2 -->|create| TokenReview
    CR2 -->|create| SAR
    CR3 -->|get| MetricsURL

    %% Editor/Viewer roles
    CR4 -->|"create,delete,get,list,<br/>patch,update,watch"| FSRes
    CR5 -->|"get,list,watch"| FSRes

