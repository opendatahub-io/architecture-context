graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator"]
        OrcClient["Orchestrator Client"]
    end

    subgraph RegexDetector["guardrails-regex-detector (Rust Service)"]
        direction TB
        AxumRouter["Axum Router<br/>Port 8080/TCP"]
        DetectionHandler["Detection Handler<br/>POST /api/v1/text/contents"]
        HealthHandler["Health Handler<br/>GET /health"]

        subgraph BuiltInDetectors["Built-in PII Detectors"]
            EmailDetector["Email Detector<br/>(regex pattern)"]
            SSNDetector["SSN Detector<br/>(regex pattern)"]
            CreditCardDetector["Credit Card Detector<br/>(regex pattern)"]
        end

        CustomRegex["Custom Regex Engine<br/>(user-supplied patterns)"]

        AxumRouter --> DetectionHandler
        AxumRouter --> HealthHandler
        DetectionHandler --> EmailDetector
        DetectionHandler --> SSNDetector
        DetectionHandler --> CreditCardDetector
        DetectionHandler --> CustomRegex
    end

    OrcClient -->|"POST /api/v1/text/contents<br/>HTTP 8080/TCP"| AxumRouter
    DetectionHandler -->|"JSON Response<br/>(matches, positions, scores)"| OrcClient

    style AxumRouter fill:#4a90e2,color:#fff
    style DetectionHandler fill:#4a90e2,color:#fff
    style HealthHandler fill:#4a90e2,color:#fff
    style EmailDetector fill:#7ed321,color:#fff
    style SSNDetector fill:#7ed321,color:#fff
    style CreditCardDetector fill:#7ed321,color:#fff
    style CustomRegex fill:#f5a623,color:#fff
    style OrcClient fill:#e8e8e8,stroke:#999
