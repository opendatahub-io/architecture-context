graph TB
    subgraph KAP["kube-auth-proxy"]
        direction TB

        subgraph PreAuth["Pre-Auth Chain"]
            Logging["Request Logging"]
            HealthCheck["Health Checks<br/>/ping, /ready"]
            Metrics["Metrics Middleware"]
            HTTPSRedirect["HTTPS Redirect"]
        end

        subgraph SessionChain["Session Chain (cascade on failure)"]
            K8sTokenValidator["TokenReviewValidator<br/>(K8s SA tokens)"]
            JWTValidator["JWT/OAuth Bearer<br/>Validator"]
            BasicAuth["Basic Auth<br/>(htpasswd)"]
            StoredSession["Stored Session<br/>(Cookie)"]
        end

        subgraph Core["Core Engine"]
            OAuthProxy["OAuthProxy<br/>(alice middleware)"]
            HeadersChain["Headers Chain<br/>(inject/strip headers)"]
            UpstreamProxy["Upstream Reverse Proxy"]
        end

        subgraph AuthDeny["Auth Deny Handlers"]
            MLflowHandler["MLflow AuthDeny<br/>(JSON errors for SDK)"]
            DefaultDeny["Default Deny<br/>(HTML error page)"]
        end

        subgraph Providers["Auth Providers"]
            OpenShiftProv["OpenShiftProvider<br/>(OAuth discovery, token mgmt)"]
            OIDCProv["OIDCProvider<br/>(JWT verification)"]
        end

        subgraph SessionStore["Session Storage"]
            CookieStore["Cookie Store<br/>(default)"]
            RedisStore["Redis SessionStore<br/>(multi-replica)"]
        end

        MetricsServer["Metrics Server<br/>(separate bind)"]
    end

    Logging --> HealthCheck
    HealthCheck --> Metrics
    Metrics --> HTTPSRedirect
    HTTPSRedirect --> OAuthProxy

    OAuthProxy --> K8sTokenValidator
    K8sTokenValidator -->|fail| JWTValidator
    JWTValidator -->|fail| BasicAuth
    BasicAuth -->|fail| StoredSession
    StoredSession -->|fail| MLflowHandler
    StoredSession -->|fail| DefaultDeny

    K8sTokenValidator -->|pass| HeadersChain
    JWTValidator -->|pass| HeadersChain
    BasicAuth -->|pass| HeadersChain
    StoredSession -->|pass| HeadersChain
    HeadersChain --> UpstreamProxy

    OAuthProxy --> OpenShiftProv
    OAuthProxy --> OIDCProv
    OAuthProxy --> CookieStore
    OAuthProxy --> RedisStore

    %% External interactions
    Client["Client / Browser"] -->|"Port 4180/TCP"| Logging
    UpstreamProxy -->|"HTTP/HTTPS"| Upstream["Upstream Application"]

    K8sTokenValidator -->|"TokenReview API"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftProv -->|"OAuth2 Discovery"| OAuthServer["OpenShift OAuth<br/>443/TCP"]
    OIDCProv -->|"OIDC Discovery"| OIDCEndpoint["OIDC Provider<br/>443/TCP"]
    RedisStore -->|"Redis Protocol"| Redis["Redis / Valkey"]

    %% Styling
    style KAP fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style OAuthProxy fill:#4a90e2,color:#fff
    style K8sTokenValidator fill:#5b9bd5,color:#fff
    style OpenShiftProv fill:#5b9bd5,color:#fff
    style OIDCProv fill:#5b9bd5,color:#fff
    style MLflowHandler fill:#f5a623
    style DefaultDeny fill:#f5a623
    style RedisStore fill:#7ed321
    style CookieStore fill:#7ed321
    style MetricsServer fill:#9b59b6,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Upstream fill:#f9f9f9,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style OAuthServer fill:#e8e8e8,stroke:#999
    style OIDCEndpoint fill:#e8e8e8,stroke:#999
    style Redis fill:#e8e8e8,stroke:#999
