graph LR
    BG["Batch Gateway<br/>(API + Processor + GC)"]

    %% External Dependencies (required infrastructure)
    BG -->|"metadata storage<br/>pgx pool"| PostgreSQL["PostgreSQL<br/>(pgx/v5)"]
    BG -->|"priority queue<br/>event channels"| Redis["Redis/Valkey<br/>(go-redis/v9)"]
    BG -->|"file storage<br/>AWS SDK v2"| S3["S3-compatible Storage<br/>(aws-sdk-go-v2)"]

    %% Internal Platform Dependencies
    BG -->|"sync inference dispatch<br/>AIMD concurrency"| LLMdGW["llm-d Inference Gateway"]
    BG -->|"async dispatch mode<br/>Go library v0.9.1"| LLMdAsync["llm-d-async<br/>(producer API)"]

    %% Kubernetes Dependencies
    BG -->|"pod/statefulset watching<br/>GC reconciler only"| K8sAPI["Kubernetes API<br/>(client-go v0.36.4)"]

    %% Optional Dependencies
    BG -.->|"TLS certificates"| CertManager["cert-manager"]
    BG -.->|"distributed tracing<br/>OTLP/gRPC"| OTel["OpenTelemetry Collector"]
    BG -.->|"metrics scraping"| Prometheus["Prometheus Operator<br/>(ServiceMonitor/PodMonitor)"]
    BG -.->|"external routing<br/>HTTPRoute"| GatewayAPI["Gateway API"]

    %% Integration Points (external consumers/producers)
    Kuadrant["Kuadrant/Authorino<br/>Gateway"] -->|"auth + routing<br/>X-MaaS-Username"| BG
    Grafana["Grafana"] -.->|"dashboard JSON<br/>ConfigMap"| BG

    %% Build Dependencies
    subgraph Build["Build Dependencies"]
        Go["Go 1.26"]
        UBI["ubi9/ubi-minimal-pqc"]
        FIPS["GOEXPERIMENT=<br/>strictfipsruntime"]
    end

    BG ---|"built with"| Build

    style BG fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff
    style LLMdGW fill:#7ed321,stroke:#333
    style LLMdAsync fill:#7ed321,stroke:#333
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333
    style OTel fill:#999,stroke:#333
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333
    style Kuadrant fill:#f5a623,stroke:#333
    style Grafana fill:#999,stroke:#333
    style Go fill:#00add8,stroke:#333,color:#fff
    style UBI fill:#cc0000,stroke:#333,color:#fff
    style FIPS fill:#cc0000,stroke:#333,color:#fff
