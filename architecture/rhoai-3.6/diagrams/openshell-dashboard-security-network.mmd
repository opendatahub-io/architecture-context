graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / SPA Client"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
        AuthProxy["Auth Proxy (oauth2-proxy)<br/>443/TCP<br/>TLS 1.3<br/>OIDC session management"]
    end

    subgraph Application["APPLICATION (Behind auth proxy)"]
        subgraph BFFContainer["OpenShell Dashboard BFF"]
            BFF["Go BFF Server<br/>8080/TCP HTTP(S)<br/>Image: odh-openshell-dashboard-rhel9<br/>User: 65532 (non-root)<br/>FIPS: strictfipsruntime + CGO"]
        end
    end

    subgraph Backend["BACKEND SERVICE"]
        Gateway["OpenShell Gateway<br/>50051/TCP gRPC<br/>JWT validation (OIDC JWKS)<br/>Per-workspace RBAC"]
    end

    %% Flows
    Browser -->|"HTTPS + WSS / 443<br/>TLS 1.3<br/>OIDC session cookie"| AuthProxy
    AuthProxy -->|"HTTP(S) + WS(S) / 8080<br/>TLS 1.3 (when configured)<br/>x-forwarded-access-token (JWT)"| BFF
    BFF -->|"gRPC / 50051<br/>TLS 1.2+ (mTLS optional)<br/>Bearer token (forwarded)<br/>InsecureSkipVerify: NEVER"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Browser external
    class AuthProxy auth
    class BFF app
    class Gateway backend
