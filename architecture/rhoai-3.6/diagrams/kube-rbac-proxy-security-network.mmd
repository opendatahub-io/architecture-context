graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(e.g. Prometheus, Dashboard)<br/>Bearer / Client Cert / OIDC"]
    end

    subgraph SidecarProxy["SIDECAR PROXY (Pod boundary)"]
        direction TB

        subgraph ProxyContainer["kube-rbac-proxy container"]
            TLS["TLS Termination<br/>8443/TCP<br/>TLS 1.2+ FIPS<br/>(strictfipsruntime/OpenSSL)"]
            AuthNLayer["Authentication<br/>TokenReview / Client Cert / OIDC"]
            AuthZLayer["Authorization Chain<br/>1. Hardcoded (prometheus-k8s)<br/>2. Static Rules<br/>3. SubjectAccessReview"]
            Headers["Header Injection<br/>x-remote-user<br/>x-remote-groups"]
            Audit["OCSF 1.9.0 Audit<br/>AI Activity Events"]
            Health["/healthz<br/>proxy-endpoints port<br/>No Auth"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph Localhost["LOCALHOST (Pod-internal, trusted)"]
        Upstream["Upstream Service<br/>8081/TCP HTTP<br/>No Encryption<br/>No Auth"]
    end

    subgraph Secrets["SECRETS"]
        TLSSecret["TLS Cert/Key<br/>kubernetes.io/tls<br/>cert-manager<br/>Hot-Reloadable"]
    end

    %% Flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+ FIPS<br/>Bearer / mTLS / OIDC"| TLS
    TLS --> AuthNLayer
    AuthNLayer --> AuthZLayer
    AuthZLayer --> Headers
    Headers --> Audit

    AuthNLayer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>TokenReview"| K8sAPI
    AuthZLayer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>SubjectAccessReview"| K8sAPI

    Audit -->|"HTTP/8081<br/>localhost<br/>No encryption"| Upstream

    TLSSecret -.->|hot-reload| TLS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef localhost fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secrets fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class TLS,AuthNLayer,AuthZLayer,Headers,Audit,Health proxy
    class K8sAPI controlplane
    class Upstream localhost
    class TLSSecret secrets
