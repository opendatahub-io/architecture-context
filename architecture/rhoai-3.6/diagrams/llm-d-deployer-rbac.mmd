graph TD
    subgraph "Service Accounts"
        SA_Manager["SA: {release}-manager"]
        SA_EPP["SA: {release}-endpoint-picker"]
        SA_Grafana["SA: grafana-sa"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["{release}-manager-binding"]
        CRB_EPP["{release}-endpoint-picker-binding"]
        CRB_View["view-grafana"]
        CRB_CMV["cluster-monitoring-view-grafana"]
        CRB_OCMV["openshift-cluster-monitoring-view-grafana"]
        CRB_PR["grafana-prometheus-reader-binding"]
    end

    subgraph "ClusterRoles"
        CR_Manager["{release}-manager"]
        CR_EPP["{release}-endpoint-picker"]
        CR_View["view"]
        CR_CMV["cluster-monitoring-view"]
        CR_OCMV["openshift-cluster-monitoring-view"]
        CR_PR["grafana-prometheus-reader"]
    end

    subgraph "Manager Role Resources"
        MS["llm-d.ai<br/>ModelService<br/>modelservices/finalizers<br/>modelservices/status"]
        Deploy["apps<br/>Deployments<br/>deployments/scale"]
        Svc["core<br/>Services<br/>ConfigMaps<br/>ServiceAccounts<br/>Pods"]
        Net["gateway.networking.k8s.io<br/>HTTPRoutes"]
        GAIE["inference.networking.x-k8s.io<br/>InferenceModels<br/>InferencePools"]
        Disc["discovery.k8s.io<br/>EndpointSlices"]
        RBACRes["rbac.authorization.k8s.io<br/>RoleBindings"]
    end

    subgraph "EPP Role Resources"
        EPP_GAIE["inference.networking.x-k8s.io<br/>InferencePools<br/>InferenceModels"]
        EPP_Core["core<br/>Pods"]
        EPP_Disc["discovery.k8s.io<br/>EndpointSlices"]
        EPP_Auth["authentication.k8s.io<br/>TokenReviews"]
        EPP_Authz["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph "Grafana Resources"
        Prom["monitoring.coreos.com<br/>Prometheuses<br/>Prometheuses/*"]
    end

    %% Manager bindings
    SA_Manager -->|"bound via"| CRB_Manager
    CRB_Manager -->|"grants"| CR_Manager
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| MS
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Deploy
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Svc
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Net
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| GAIE
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Disc
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| RBACRes

    %% EPP bindings
    SA_EPP -->|"bound via"| CRB_EPP
    CRB_EPP -->|"grants"| CR_EPP
    CR_EPP -->|"get, watch, list"| EPP_GAIE
    CR_EPP -->|"get, watch, list"| EPP_Core
    CR_EPP -->|"get, watch, list"| EPP_Disc
    CR_EPP -->|"create"| EPP_Auth
    CR_EPP -->|"create"| EPP_Authz

    %% Grafana bindings
    SA_Grafana -->|"bound via"| CRB_View
    SA_Grafana -->|"bound via"| CRB_CMV
    SA_Grafana -->|"bound via"| CRB_OCMV
    SA_Grafana -->|"bound via"| CRB_PR
    CRB_View -->|"grants"| CR_View
    CRB_CMV -->|"grants"| CR_CMV
    CRB_OCMV -->|"grants"| CR_OCMV
    CRB_PR -->|"grants"| CR_PR
    CR_PR -->|"get, list, watch"| Prom

    style SA_Manager fill:#4a90e2,color:#fff
    style SA_EPP fill:#4a90e2,color:#fff
    style SA_Grafana fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_EPP fill:#f5a623,color:#fff
    style CR_PR fill:#f5a623,color:#fff
    style MS fill:#7ed321,color:#fff
    style Deploy fill:#7ed321,color:#fff
    style Svc fill:#7ed321,color:#fff
    style Net fill:#7ed321,color:#fff
    style GAIE fill:#7ed321,color:#fff
    style EPP_GAIE fill:#7ed321,color:#fff
    style EPP_Auth fill:#e74c3c,color:#fff
    style EPP_Authz fill:#e74c3c,color:#fff
