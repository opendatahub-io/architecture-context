graph TD
    subgraph "Training Hub — Authentication Model"
        direction TB
        Note["Training Hub is a Python library with<br/>NO Kubernetes RBAC manifests.<br/>All RBAC is managed by consuming components."]
    end

    subgraph "Runtime Credentials (Environment Variables)"
        HF_TOKEN["HF_TOKEN<br/>(optional)"]
        OPENAI_KEY["OPENAI_API_KEY<br/>(required for GEPA)"]
        WANDB_KEY["WANDB_API_KEY<br/>(optional)"]
        AWS_CREDS["AWS_* credentials<br/>(required for S3 checkpoints)"]
        S3_ENDPOINT["AWS_ENDPOINT_URL_S3<br/>(optional, custom endpoint)"]
    end

    subgraph "External Service Authentication"
        HuggingFace["HuggingFace Hub<br/>Bearer Token<br/>Public models: no auth<br/>Gated models: HF_TOKEN required"]
        OpenAIAPI["OpenAI-Compatible API<br/>Bearer Token<br/>Required for GEPA"]
        S3Storage["S3-Compatible Storage<br/>AWS IAM / credentials<br/>Required for checkpoint mirroring"]
        WandBService["Weights & Biases<br/>API Key<br/>Optional experiment tracking"]
    end

    subgraph "Platform-Level Isolation (Not Managed by Training Hub)"
        K8sRBAC["Kubernetes RBAC<br/>(namespace isolation)"]
        PodSA["Pod ServiceAccount<br/>(consuming component)"]
        NetworkPolicy["Network Policies<br/>(consuming component)"]
        ResourceQuota["ResourceQuota / LimitRange<br/>(compute isolation)"]
    end

    %% Credential to service mappings
    HF_TOKEN -->|authenticates| HuggingFace
    OPENAI_KEY -->|authenticates| OpenAIAPI
    WANDB_KEY -->|authenticates| WandBService
    AWS_CREDS -->|authenticates| S3Storage
    S3_ENDPOINT -->|configures endpoint| S3Storage

    %% Platform provides isolation
    K8sRBAC -->|"provides tenant<br/>isolation"| Note
    PodSA -->|"provides pod<br/>identity"| Note
    NetworkPolicy -->|"controls egress<br/>access"| Note
    ResourceQuota -->|"limits compute<br/>resources"| Note

    %% Styling
    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style HF_TOKEN fill:#dae8fc,stroke:#6c8ebf
    style OPENAI_KEY fill:#dae8fc,stroke:#6c8ebf
    style WANDB_KEY fill:#dae8fc,stroke:#6c8ebf
    style AWS_CREDS fill:#dae8fc,stroke:#6c8ebf
    style S3_ENDPOINT fill:#dae8fc,stroke:#6c8ebf
    style HuggingFace fill:#f9f9f9,stroke:#999
    style OpenAIAPI fill:#f9f9f9,stroke:#999
    style S3Storage fill:#f9f9f9,stroke:#999
    style WandBService fill:#f9f9f9,stroke:#999
    style K8sRBAC fill:#d5e8d4,stroke:#82b366
    style PodSA fill:#d5e8d4,stroke:#82b366
    style NetworkPolicy fill:#d5e8d4,stroke:#82b366
    style ResourceQuota fill:#d5e8d4,stroke:#82b366
