graph TB
    subgraph EPP["Endpoint Picker (EPP)"]
        direction TB
        EPPServer["gRPC ExtProc Server<br/>9002/TCP"]
        EPPHealth["Health Server<br/>9003/TCP"]
        EPPMetrics["Metrics Server<br/>9090/TCP"]
        PluginFramework["Plugin Framework<br/>(Filters + Scorers)"]
        EndpointDatastore["Endpoint Datastore<br/>(in-memory)"]
        EPPServer --> PluginFramework
        PluginFramework --> EndpointDatastore
    end

    subgraph CoordinatorComp["Coordinator"]
        direction TB
        CoordServer["HTTP/HTTPS Server<br/>8080/TCP"]
        Pipeline["Pipeline Engine<br/>(replace-media-urls, render,<br/>encode, prefill, decode)"]
        AsyncBroker["Async Broker<br/>(llm-d-async)"]
        CoordMetrics["Metrics Server<br/>9090/TCP"]
        CoordServer --> Pipeline
        CoordServer --> AsyncBroker
    end

    subgraph SidecarComp["Disaggregation Sidecar"]
        direction TB
        SidecarProxy["Reverse Proxy<br/>8000/TCP"]
        KVConnector["KV Connector<br/>(NIXL RDMA / shared-storage / SGLang)"]
        SidecarProxy --> KVConnector
    end

    subgraph Controllers["EPP Controllers"]
        direction TB
        IOCtrl["InferenceObjective<br/>Controller"]
        IMRCtrl["InferenceModelRewrite<br/>Controller"]
        IPCtrl["InferencePool<br/>Controller"]
        PodCtrl["Pod Controller"]
    end

    %% CRDs
    EPConfig["EndpointPickerConfig CR<br/>(llm-d.ai/v1)"]
    IObjCR["InferenceObjective CR<br/>(llm-d.ai/v1)"]
    IMRCR["InferenceModelRewrite CR<br/>(llm-d.ai/v1alpha2)"]
    IPoolCR["InferencePool CR<br/>(inference.networking.k8s.io)"]

    %% CRD relationships
    EPConfig -->|configures| PluginFramework
    IObjCR -->|watched by| IOCtrl
    IMRCR -->|watched by| IMRCtrl
    IPoolCR -->|watched by| IPCtrl

    %% External dependencies
    Envoy["Envoy Proxy"] -->|ext-proc callout| EPPServer
    EPPServer -->|routing decision| Envoy
    Envoy -->|forward request| ModelServer["Model Server Pods"]

    CoordServer -->|forward stages| InfGW["Inference Gateway"]
    CoordServer -->|tokenize| RenderSvc["Rendering Service"]
    AsyncBroker -->|queue ops| Redis["Redis"]

    SidecarProxy -->|prefill requests| PrefillWorkers["Prefill Workers"]
    SidecarProxy -->|decode requests| LocalModel["Local Model Server<br/>8200/TCP"]

    PodCtrl -->|watches| ModelServer
    Controllers -->|watches via| K8sAPI["Kubernetes API<br/>6443/TCP"]

    OTel["OpenTelemetry Collector"] -.->|traces from| EPP
    OTel -.->|traces from| CoordinatorComp
    OTel -.->|traces from| SidecarComp

    %% Styling
    style EPPServer fill:#4a90e2,color:#fff
    style CoordServer fill:#4a90e2,color:#fff
    style SidecarProxy fill:#4a90e2,color:#fff
    style PluginFramework fill:#4a90e2,color:#fff
    style EndpointDatastore fill:#4a90e2,color:#fff
    style Pipeline fill:#4a90e2,color:#fff
    style AsyncBroker fill:#4a90e2,color:#fff
    style KVConnector fill:#4a90e2,color:#fff
    style EPConfig fill:#f5a623,color:#000
    style IObjCR fill:#f5a623,color:#000
    style IMRCR fill:#f5a623,color:#000
    style IPoolCR fill:#f5a623,color:#000
    style Envoy fill:#e8e8e8,color:#000
    style ModelServer fill:#e8e8e8,color:#000
    style InfGW fill:#e8e8e8,color:#000
    style RenderSvc fill:#e8e8e8,color:#000
    style Redis fill:#e8e8e8,color:#000
    style PrefillWorkers fill:#e8e8e8,color:#000
    style LocalModel fill:#e8e8e8,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style OTel fill:#e8e8e8,color:#000
