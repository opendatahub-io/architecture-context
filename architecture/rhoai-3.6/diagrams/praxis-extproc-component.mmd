graph TB
    subgraph External["External Traffic"]
        Client["External Client"]
    end

    subgraph Gateway["Istio Gateway (Envoy)"]
        direction TB
        EnvoyFilter["EnvoyFilter<br/>HTTP Filter Chain"]
    end

    subgraph PreAuth["Pre-Auth Stage (fail-open)"]
        PreProc["payload-pre-processing<br/>9004/TCP gRPC<br/>failure_mode_allow: true"]
    end

    subgraph Auth["Auth Layer"]
        Kuadrant["Kuadrant WasmPlugin<br/>Auth / AuthZ"]
    end

    subgraph PostAuth["Post-Auth Stage (fail-closed)"]
        PostProc["payload-processing<br/>9004/TCP gRPC<br/>failure_mode_allow: false"]
    end

    subgraph PraxisInternal["praxis-extproc Internal Architecture"]
        direction TB
        Server["server module<br/>ExternalProcessor gRPC Service"]
        Handlers["handlers module<br/>Phase Dispatchers"]
        Pipeline["pipeline module<br/>FilterPipeline Execution"]
        Protocol["protocol module<br/>ExtProc Sequencing"]
        Context["CarriedContext / HydratedContext<br/>Cross-Phase State"]
        FIPS["fips module<br/>OpenSSL CryptoProvider"]
        TLS["tls module<br/>OpenSSL TLS Termination"]

        Server -->|dispatches phases| Handlers
        Handlers -->|invokes| Pipeline
        Pipeline -->|enforces| Protocol
        Handlers -->|parks/hydrates| Context
        FIPS -->|installs provider| TLS
    end

    subgraph Downstream["Downstream"]
        InferencePool["InferencePool / EPP<br/>ExtProc"]
        ModelServer["Upstream Model Server"]
    end

    subgraph Observability["Observability"]
        Health["grpc.health.v1.Health<br/>50052/TCP"]
        Metrics["/metrics<br/>9090/TCP HTTP"]
        Kubelet["kubelet"]
        Prometheus["Prometheus"]
    end

    subgraph ExternalDeps["External Dependencies"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
        PraxisCore["praxis-core 0.7.1"]
        PraxisFilter["praxis-filter 0.7.1"]
        PraxisAI["praxis-ai-filters v0.4.1"]
    end

    Client -->|HTTPS/443| EnvoyFilter
    EnvoyFilter -->|gRPC ExtProc| PreProc
    PreProc -->|"X-Gateway-Model-Name header"| EnvoyFilter
    EnvoyFilter -->|post-extraction| Kuadrant
    Kuadrant -->|authenticated| EnvoyFilter
    EnvoyFilter -->|gRPC ExtProc| PostProc
    PostProc -->|mutations| EnvoyFilter
    EnvoyFilter -->|ExtProc| InferencePool
    InferencePool --> ModelServer

    PostProc -->|reads CRDs, configmaps, secrets| K8sAPI
    PreProc -->|reads configmaps| K8sAPI

    Kubelet -->|readiness/liveness| Health
    Prometheus -->|scrape| Metrics

    Pipeline -.->|uses| PraxisCore
    Pipeline -.->|uses| PraxisFilter
    Pipeline -.->|uses| PraxisAI

    style PreProc fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style PostProc fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Kuadrant fill:#e8e8e8,stroke:#333
    style EnvoyFilter fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Server fill:#dae8fc,stroke:#6c8ebf
    style Pipeline fill:#dae8fc,stroke:#6c8ebf
    style FIPS fill:#f8cecc,stroke:#b85450
    style TLS fill:#f8cecc,stroke:#b85450
    style K8sAPI fill:#fff2cc,stroke:#d6b656
    style InferencePool fill:#d5e8d4,stroke:#82b366
