graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI Pipeline"]
    end

    subgraph CLIHost["CLI HOST"]
        CLI["llmdbenchmark CLI<br/>Python 3.14+<br/>kubeconfig auth"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS + RBAC"]

        subgraph NS["Namespace: ${NAMESPACE}"]
            direction TB
            Harness["Harness StatefulSet<br/>Image: ghcr.io/llm-d/llm-d-benchmark<br/>PVC: workspace"]
            SVC["ClusterIP Service<br/>8080/TCP<br/>No Encryption<br/>No Auth"]
            Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>Edge TLS<br/>No App Auth"]
        end
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Google OAuth / ADC"]
        Prism["Prism Proxy<br/>prism.llm-d.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        LLM["LLM Inference Endpoint<br/>HTTP/HTTPS<br/>Varies"]
    end

    subgraph RBACWarning["⚠️ RBAC CONCERN"]
        RBAC["pods/exec → system:authenticated<br/>All cluster users can exec<br/>into benchmark pod"]
    end

    %% Flows
    User -->|Local CLI invocation| CLI
    CLI -->|HTTPS/6443<br/>TLS<br/>Bearer / Client Cert| K8sAPI
    K8sAPI -->|pods/exec| Harness
    Route -->|edge TLS termination<br/>443 → 8080| SVC
    SVC -->|TCP/8080<br/>No encryption| Harness
    Harness -->|HTTP or HTTPS<br/>varies<br/>None / Bearer| LLM
    CLI -->|HTTPS/443<br/>TLS 1.2+<br/>Google ADC| GCS
    CLI -->|HTTPS/443<br/>TLS 1.2+<br/>No Auth| Prism
    CLI -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef clihost fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef namespace fill:#c8e6c9,stroke:#4caf50,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcdd2,stroke:#e53935,stroke-width:2px

    class User external
    class CLI clihost
    class K8sAPI,Harness,SVC,Route cluster
    class GCS,Prism,HFHub,LLM externalservice
    class RBAC warning
