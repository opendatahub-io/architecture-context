graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Inference Gateway<br/>(Istio / kgateway / GKE L7)<br/>80/TCP HTTP<br/>No TLS (default)<br/>No Auth"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No Network Isolation)"]
        direction TB

        subgraph EPPGroup["Endpoint Picker"]
            EPP["EPP (llm-d-inference-scheduler)<br/>9002/TCP gRPC ext_proc<br/>9003/TCP gRPC health<br/>9090/TCP HTTP metrics<br/>SA: release-endpoint-picker"]
        end

        subgraph InferencePods["Inference Pods"]
            Prefill["Prefill vLLM Pod<br/>8000/TCP HTTP inference<br/>5557/TCP NixL<br/>Image: llm-d:0.0.8"]
            Decode["Decode vLLM Pod<br/>8001/TCP HTTP vLLM<br/>5557/TCP NixL<br/>Image: llm-d:0.0.8"]
            Proxy["Routing Proxy Sidecar<br/>8000/TCP → 8001/TCP<br/>Image: llm-d-routing-sidecar:0.0.7"]
        end

        subgraph DataStore["Data Store"]
            RedisStore["Redis (Bitnami 20.13.4)<br/>8100/TCP<br/>Auth: DISABLED<br/>NetworkPolicy: DISABLED"]
        end

        subgraph ControlPlane["Control Plane"]
            MSController["ModelService Controller<br/>8443/TCP ClusterIP<br/>8081/TCP health probes<br/>Image: llm-d-model-service:v0.0.15<br/>seccompProfile: RuntimeDefault"]
        end
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        Grafana["Grafana<br/>443/TCP HTTPS<br/>OpenShift Route (TLS edge)<br/>SA: grafana-sa"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer HF_TOKEN"]
        Bitnami["charts.bitnami.com<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        GHCR["github.com / ghcr.io<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Flows
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Gateway
    Gateway -->|"gRPC/9002<br/>ext_proc<br/>No Encryption"| EPP
    EPP -->|"HTTP/8000<br/>No Encryption"| Proxy
    Proxy -->|"HTTP/8001<br/>No Encryption"| Decode
    EPP -->|"HTTP/8000<br/>No Encryption"| Prefill
    Prefill -->|"NixL/5557<br/>KV-cache transfer<br/>No Encryption"| Decode
    Prefill -->|"Redis/8100<br/>No Auth"| RedisStore
    Decode -->|"Redis/8100<br/>No Auth"| RedisStore
    Prefill -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HF
    Grafana -->|"SA Token"| Prometheus
    Prometheus -->|"HTTP/9090<br/>metrics scrape"| EPP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef control fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class EPP,Prefill,Decode,Proxy internal
    class RedisStore datastore
    class MSController control
    class Grafana,Prometheus observability
    class HF,Bitnami,GHCR externalservice
