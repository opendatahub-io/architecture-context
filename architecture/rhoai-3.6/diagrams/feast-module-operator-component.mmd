graph TB
    subgraph FeastModuleOperator["Feast Module Operator"]
        Controller["opendatahub-feast-operator<br/>Go Operator Controller"]
        Chartgen["chartgen<br/>Helm Chart Generator"]
        Manifests["/manifests/<br/>Embedded Kustomize Manifests"]
        Controller -->|reads & renders| Manifests
    end

    ODHOperator["ODH Operator"] -->|deploys via Helm chart| FeastModuleOperator
    ODHOperator -->|creates| FeastOperatorCR["FeastOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped, singleton"]

    FeastOperatorCR -->|watched by| Controller

    subgraph ConfigSources["Configuration Sources"]
        ConfigMap["odh-feastoperator-config<br/>ConfigMap"]
        ParamsEnv["params.env<br/>RELATED_IMAGE_FEAST_OPERATOR<br/>RELATED_IMAGE_FEATURE_SERVER<br/>RELATED_IMAGE_CRON_JOB<br/>OIDC_ISSUER_URL"]
    end

    Controller -->|reads platform version| ConfigMap
    Controller -->|reads image params| ParamsEnv

    subgraph DeployedResources["Deployed Resources (feast-operator)"]
        FeastOperatorDeploy["feast-operator<br/>Controller Manager"]
        FeatureStoreCRD["FeatureStore CRD<br/>(feast.dev)"]
        FeastRBAC["RBAC<br/>ClusterRoles & Bindings"]
        FeastSvcMon["ServiceMonitor"]
    end

    Controller -->|deploys| FeastOperatorDeploy
    Controller -->|creates| FeatureStoreCRD
    Controller -->|creates| FeastRBAC
    Controller -->|creates| FeastSvcMon

    subgraph PlatformIntegrations["Platform Integrations (delegated RBAC)"]
        FeatureStore["Feast FeatureStore<br/>(feast.dev)"]
        Notebooks["Kubeflow Notebooks<br/>(kubeflow.org)"]
        MLflow["MLflow<br/>(mlflow.opendatahub.io)"]
        Routes["OpenShift Routes<br/>(route.openshift.io)"]
        Spark["Spark Applications<br/>(sparkoperator.k8s.io)"]
    end

    FeastOperatorDeploy -->|CRUD| FeatureStore
    FeastOperatorDeploy -->|watch| Notebooks
    FeastOperatorDeploy -->|watch| MLflow
    FeastOperatorDeploy -->|CRUD| Routes
    FeastOperatorDeploy -->|CRUD| Spark

    subgraph Libraries["Go Libraries"]
        ODHReconciler["opendatahub-operator/v2<br/>Reconciler Framework"]
        PlatformUtils["odh-platform-utilities<br/>Platform Detection"]
    end

    Controller -->|uses| ODHReconciler
    Controller -->|uses| PlatformUtils

    KubeAPI["Kubernetes API<br/>6443/TCP HTTPS"] -->|leader election,<br/>CRD watches,<br/>resource CRUD| Controller

    Prometheus["Prometheus"] -->|scrapes 8443/TCP<br/>HTTPS + kube-rbac-proxy| FeastSvcMon

