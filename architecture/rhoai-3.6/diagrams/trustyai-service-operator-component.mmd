graph TB
    subgraph Operator["TrustyAI Service Operator"]
        direction TB
        Manager["manager<br/>(cmd/main.go)<br/>Go Operator"]

        subgraph Controllers["Controllers"]
            TASCtrl["TrustyAIService<br/>Controller"]
            EvalHubCtrl["EvalHub<br/>Controller"]
            LMEvalCtrl["LMEvalJob<br/>Controller"]
            NemoCtrl["NemoGuardrails<br/>Controller"]
            JobFailCtrl["Job Failure<br/>Reconciler"]
            KueueCtrl["Kueue Workload<br/>Reconciler"]
            TLSWatcher["TLS Profile<br/>Watcher"]
            ModuleCtrl["TrustyAI Module<br/>Controller"]
        end

        Manager -->|enables via --enable-services| TASCtrl
        Manager -->|enables via --enable-services| EvalHubCtrl
        Manager -->|enables via --enable-services| LMEvalCtrl
        Manager -->|enables via --enable-services| NemoCtrl
        Manager -->|starts| JobFailCtrl
        Manager -->|starts| KueueCtrl
        Manager -->|starts| TLSWatcher
        Manager -->|starts| ModuleCtrl
    end

    subgraph Sidecars["Sidecar Components"]
        Driver["lmes-driver<br/>(Go sidecar)"]
        LMESJob["lmes-job<br/>(Python container)"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        TrustyAICR["TrustyAIService CR"]
        EvalHubCR["EvalHub CR"]
        LMEvalCR["LMEvalJob CR"]
        NemoCR["NemoGuardrails CR"]
        TrustyAICompCR["TrustyAI Component CR"]
    end

    %% CRD watches
    TASCtrl -->|reconciles| TrustyAICR
    EvalHubCtrl -->|reconciles| EvalHubCR
    LMEvalCtrl -->|reconciles| LMEvalCR
    NemoCtrl -->|reconciles| NemoCR
    ModuleCtrl -->|reconciles| TrustyAICompCR

    %% Created resources
    TASCtrl -->|creates| TASDeployment["TrustyAI Deployment<br/>+ kube-rbac-proxy"]
    TASCtrl -->|creates| TASRoute["Route / VirtualService"]
    TASCtrl -->|creates| TASService["Service :443"]
    TASCtrl -->|creates| TASPVC["PVC"]

    EvalHubCtrl -->|creates| EHDeployment["EvalHub Deployment"]
    EvalHubCtrl -->|provisions| TenantRBAC["Tenant SA + RBAC"]
    EvalHubCtrl -->|propagates| TenantCM["Tenant ConfigMaps"]

    LMEvalCtrl -->|creates| EvalJob["Batch Job<br/>(lmes-driver + lmes-job)"]
    NemoCtrl -->|creates| NemoDeployment["Guardrails Server"]

    %% Sidecar relationship
    EvalJob -->|contains| Driver
    EvalJob -->|contains| LMESJob

    %% External dependencies
    TASCtrl -->|watches| KServeIS["KServe InferenceService"]
    TLSWatcher -->|watches| APIServer["OpenShift APIServer Config"]
    KueueCtrl -->|watches| KueueWL["Kueue Workloads"]
    TASCtrl -->|creates| ServiceMonitor["ServiceMonitor"]

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style TASCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style EvalHubCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style LMEvalCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style NemoCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style JobFailCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style KueueCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style TLSWatcher fill:#5ba3f5,stroke:#333,color:#fff
    style ModuleCtrl fill:#5ba3f5,stroke:#333,color:#fff
    style Driver fill:#f5a623,stroke:#333
    style LMESJob fill:#f5a623,stroke:#333
    style TrustyAICR fill:#7ed321,stroke:#333
    style EvalHubCR fill:#7ed321,stroke:#333
    style LMEvalCR fill:#7ed321,stroke:#333
    style NemoCR fill:#7ed321,stroke:#333
    style TrustyAICompCR fill:#7ed321,stroke:#333
    style KServeIS fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style KueueWL fill:#e8e8e8,stroke:#333
