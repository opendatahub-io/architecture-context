graph LR
    Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies (downstream services)
    Orchestrator -->|"gRPC/8033<br/>text generation"| TGIS["TGIS Generation<br/>Service"]
    Orchestrator -->|"gRPC<br/>text generation"| CaikitNLP["Caikit NLP<br/>Service"]
    Orchestrator -->|"HTTP(S)<br/>chat/text completions"| OpenAISvc["OpenAI-compatible<br/>Service"]
    Orchestrator -->|"HTTP(S)/8080<br/>content detection"| Detectors["Detector<br/>Services"]
    Orchestrator -->|"gRPC/8085<br/>text chunking"| Chunkers["Chunker<br/>Services"]

    %% Observability
    Orchestrator -.->|"gRPC/HTTP<br/>traces & metrics"| OTLP["OTLP Collector"]

    %% Key framework dependencies
    subgraph RustEcosystem["Rust Framework Stack"]
        Axum["axum 0.8.8<br/>HTTP routing"]
        Tonic["tonic 0.14.2<br/>gRPC client"]
        Tokio["tokio 1.49.0<br/>async runtime"]
        Rustls["rustls 0.23.36<br/>TLS (ring)"]
        Reqwest["reqwest 0.12.28<br/>HTTP client"]
        Hyper["hyper 1.8.1<br/>HTTP transport"]
        Ginepro["ginepro<br/>gRPC load balancing"]
    end

    Orchestrator -->|"HTTP framework"| Axum
    Orchestrator -->|"gRPC framework"| Tonic
    Orchestrator -->|"async runtime"| Tokio
    Orchestrator -->|"TLS stack"| Rustls
    Orchestrator -->|"detector HTTP client"| Reqwest
    Orchestrator -->|"HTTP transport"| Hyper
    Orchestrator -->|"DNS load balancing"| Ginepro

