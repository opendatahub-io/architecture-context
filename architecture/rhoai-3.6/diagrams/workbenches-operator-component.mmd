graph TB
    subgraph Orchestrator["Platform Orchestrator"]
        PlatformOp["opendatahub-operator /<br/>rhods-operator"]
    end

    PlatformOp -->|"creates / updates"| WorkbenchesCR["Workbenches CR<br/>(default-workbenches)<br/>Cluster-scoped"]

    subgraph WBO["Workbenches Operator"]
        Controller["workbenches-operator-<br/>controller-manager<br/>(Go / controller-runtime)"]
        HWWebhook["Hardware Profile<br/>Webhook<br/>:9443/workbenches-hardware-profile"]
        ConnWebhook["Connection Notebook<br/>Webhook<br/>:9443/workbenches-connection-notebook"]
    end

    WorkbenchesCR -->|"watched by"| Controller

    Controller -->|"reads & renders"| Manifests["/opt/manifests<br/>(Kustomize bundles)"]
    Controller -->|"SSA apply"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]

    Controller -->|"creates"| KFNotebookCtrl["Kubeflow Notebook<br/>Controller"]
    Controller -->|"creates"| ODHNotebookCtrl["ODH Notebook<br/>Controller"]
    Controller -->|"creates"| NotebookManifests["Notebook Manifests<br/>(RBAC, Services,<br/>NetworkPolicies)"]

    K8sAPI -->|"admission request<br/>(Notebook CREATE/UPDATE)"| HWWebhook
    HWWebhook -->|"reads"| HWProfile["HardwareProfile CR<br/>(infrastructure.opendatahub.io)"]
    HWWebhook -->|"mutates pod spec:<br/>resources, tolerations,<br/>nodeSelector, Kueue label"| K8sAPI

    K8sAPI -->|"admission request<br/>(Notebook CREATE/UPDATE)"| ConnWebhook
    ConnWebhook -->|"SAR check + read Secrets"| K8sAPI
    ConnWebhook -->|"injects envFrom<br/>secret references"| K8sAPI

    Controller -->|"creates"| ServiceMonitor["ServiceMonitor<br/>(monitoring.coreos.com)"]
    Controller -->|"manages"| ImageStreams["ImageStreams<br/>(image.openshift.io)"]

    subgraph TLS["TLS Bootstrap"]
        TLSConfig["TLS Config<br/>(OpenShift profile /<br/>Mozilla Intermediate)"]
    end
    Controller -.->|"configures at startup"| TLSConfig

    CertManager["cert-manager"] -.->|"provisions cert<br/>(non-OpenShift)"| WBO
    ServiceCA["OpenShift service-CA"] -.->|"provisions cert<br/>(OpenShift)"| WBO

    style Controller fill:#4a90e2,color:#fff
    style HWWebhook fill:#4a90e2,color:#fff
    style ConnWebhook fill:#4a90e2,color:#fff
    style WorkbenchesCR fill:#f5a623,color:#fff
    style HWProfile fill:#f5a623,color:#fff
    style Manifests fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style PlatformOp fill:#7ed321,color:#fff
    style ServiceMonitor fill:#7ed321,color:#fff
    style ImageStreams fill:#7ed321,color:#fff
    style CertManager fill:#999,color:#fff
    style ServiceCA fill:#999,color:#fff
    style KFNotebookCtrl fill:#7ed321,color:#fff
    style ODHNotebookCtrl fill:#7ed321,color:#fff
    style NotebookManifests fill:#7ed321,color:#fff
