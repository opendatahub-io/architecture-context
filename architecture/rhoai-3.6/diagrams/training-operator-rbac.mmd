graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["training-operator<br/>(ServiceAccount)"]
    end

    subgraph ClusterBindings["Cluster Role Bindings"]
        CRB["training-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph NamespaceBindings["Role Bindings (Operator Namespace)"]
        RB["training-operator-webhook<br/>(RoleBinding)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["training-operator<br/>(ClusterRole)"]
        CREdit["training-edit<br/>(Aggregated ClusterRole)"]
        CRView["training-view<br/>(Aggregated ClusterRole)"]
    end

    subgraph NamespaceRoles["Roles (Operator Namespace)"]
        RoleWebhook["training-operator-webhook<br/>(Role)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["(core)<br/>configmaps"]
        Events["(core)<br/>events"]
        Pods["(core)<br/>pods"]
        PodsExec["(core)<br/>pods/exec"]
        ServiceAccts["(core)<br/>serviceaccounts"]
        Services["(core)<br/>services"]
        Secrets["(core)<br/>secrets"]
    end

    subgraph KubeflowResources["Kubeflow API Resources"]
        PyTorchJobs["kubeflow.org<br/>pytorchjobs"]
        TFJobs["kubeflow.org<br/>tfjobs"]
        MPIJobs["kubeflow.org<br/>mpijobs"]
        XGBoostJobs["kubeflow.org<br/>xgboostjobs"]
        PaddleJobs["kubeflow.org<br/>paddlejobs"]
        JAXJobs["kubeflow.org<br/>jaxjobs"]
        Finalizers["kubeflow.org<br/>*/finalizers"]
        Status["kubeflow.org<br/>*/status"]
    end

    subgraph OtherResources["Other API Resources"]
        WebhookConfigs["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        HPAs["autoscaling<br/>horizontalpodautoscalers"]
        Roles["rbac.authorization.k8s.io<br/>roles, rolebindings"]
        VolcanoPG["scheduling.volcano.sh<br/>podgroups"]
        SchedPG["scheduling.x-k8s.io<br/>podgroups"]
        APIServers["config.openshift.io<br/>apiservers"]
        NetPolicies["networking.k8s.io<br/>networkpolicies"]
    end

    %% SA → Bindings
    SA -->|bound via| CRB
    SA -->|bound via| RB

    %% Bindings → Roles
    CRB -->|grants| CR
    RB -->|grants| RoleWebhook

    %% ClusterRole → Resources
    CR -->|"create, list, update, watch"| ConfigMaps
    CR -->|"create, delete, get, list,<br/>patch, update, watch"| Events
    CR -->|"create, delete, get, list,<br/>patch, update, watch"| Pods
    CR -->|"create"| PodsExec
    CR -->|"create, get, list, watch"| ServiceAccts
    CR -->|"create, delete, get, list, watch"| Services
    CR -->|"get, list, update, watch"| WebhookConfigs
    CR -->|"CRUD + watch"| HPAs
    CR -->|"CRUD + watch"| PyTorchJobs
    CR -->|"CRUD + watch"| TFJobs
    CR -->|"CRUD + watch"| MPIJobs
    CR -->|"CRUD + watch"| XGBoostJobs
    CR -->|"CRUD + watch"| PaddleJobs
    CR -->|"CRUD + watch"| JAXJobs
    CR -->|"update"| Finalizers
    CR -->|"get, patch, update"| Status
    CR -->|"create, list, update, watch"| Roles
    CR -->|"CRUD + watch"| VolcanoPG
    CR -->|"CRUD + watch"| SchedPG
    CR -->|"get"| APIServers
    CR -->|"CRUD + watch"| NetPolicies

    %% Webhook Role → Secrets
    RoleWebhook -->|"get, list, update, watch"| Secrets

    %% Aggregated roles
    CREdit -->|"CRUD + watch"| PyTorchJobs
    CREdit -->|"CRUD + watch"| TFJobs
    CREdit -->|"CRUD + watch"| MPIJobs
    CREdit -->|"CRUD + watch"| XGBoostJobs
    CREdit -->|"CRUD + watch"| PaddleJobs
    CRView -->|"get, list, watch"| PyTorchJobs
    CRView -->|"get, list, watch"| TFJobs
    CRView -->|"get, list, watch"| MPIJobs
    CRView -->|"get, list, watch"| XGBoostJobs
    CRView -->|"get, list, watch"| PaddleJobs

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#000
    style CREdit fill:#f5a623,color:#000
    style CRView fill:#f5a623,color:#000
    style RoleWebhook fill:#f5a623,color:#000
    style PyTorchJobs fill:#7ed321,color:#000
    style TFJobs fill:#7ed321,color:#000
    style MPIJobs fill:#7ed321,color:#000
    style XGBoostJobs fill:#7ed321,color:#000
    style PaddleJobs fill:#7ed321,color:#000
    style JAXJobs fill:#7ed321,color:#000
