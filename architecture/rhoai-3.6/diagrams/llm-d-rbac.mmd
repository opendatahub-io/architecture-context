graph TD
    subgraph "llm-d RBAC Model"
        direction TB

        Note["NOTE: No ClusterRoles or RoleBindings<br/>defined in this repository.<br/>RBAC is delegated to llm-d-router<br/>Helm chart and per-deployment config."]

        subgraph SA["Service Accounts"]
            ModelSA["Model Server SA<br/>automountServiceAccountToken: false"]
        end

        subgraph Secrets["Secrets"]
            HFToken["llm-d-hf-token<br/>Type: Opaque<br/>Hugging Face API Token<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        end

        subgraph DelegatedRBAC["Delegated RBAC (llm-d-router)"]
            EPPRole["EPP Role<br/>(defined in router chart)"]
            EPPResources["inference.networking.k8s.io<br/>InferencePool<br/>Verbs: get, list, watch"]
            EPPRole -->|grants access to| EPPResources
        end

        subgraph AuthModel["Authentication Model"]
            NoAuth["Model Server Endpoints<br/>/v1/completions<br/>/v1/chat/completions<br/>Auth: None (default)"]
            GatewayAuth["Gateway Layer<br/>Auth: Configurable<br/>Enforcement: External"]
        end

        ModelSA -->|mounts| HFToken
        GatewayAuth -->|"protects (optional)"| NoAuth
    end

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style ModelSA fill:#4a90e2,color:#fff
    style HFToken fill:#f5a623,color:#fff
    style EPPRole fill:#7ed321,color:#fff
    style EPPResources fill:#7ed321,color:#fff
    style NoAuth fill:#f8d7da,stroke:#721c24
    style GatewayAuth fill:#d4edda,stroke:#155724
