graph TD
    subgraph "rhoai-additional-images RBAC"
        direction TB
        NoRBAC["No RBAC Defined"]
        Reason["This is a metadata-only repository<br/>with no deployed workload,<br/>no Kubernetes API surface,<br/>and no service accounts."]
        NoRBAC --- Reason
    end

    subgraph "Related Access Requirements"
        direction TB
        Note1["Registry pull secrets are managed<br/>externally by disconnected deployment tooling"]
        Note2["Image access requires registry<br/>credentials (quay.io, registry.redhat.io)"]
        Note1 --- Note2
    end

    style NoRBAC fill:#e8e8e8,stroke:#999,stroke-width:2px
    style Reason fill:#fff,stroke:#ccc
    style Note1 fill:#fff2cc,stroke:#d6b656
    style Note2 fill:#fff2cc,stroke:#d6b656
