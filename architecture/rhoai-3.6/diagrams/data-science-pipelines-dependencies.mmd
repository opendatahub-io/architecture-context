graph LR
    DSP["Data Science Pipelines<br/>API Server + Controllers"]

    %% External Dependencies (Required)
    DSP -->|"state persistence<br/>3306/TCP MySQL"| MySQL["MySQL 8.x"]
    DSP -->|"artifact storage<br/>HTTP/HTTPS"| S3["S3-Compatible<br/>Storage"]
    DSP -->|"workflow execution<br/>Kubernetes API"| Argo["Argo Workflows<br/>v3.5 / v3.7 / v4.0"]
    DSP -->|"lineage tracking<br/>8080/TCP gRPC"| MLMD["ML Metadata<br/>1.14.0"]
    DSP -->|"webhook TLS certs"| CertManager["cert-manager"]
    DSP -->|"gRPC-HTTP proxy<br/>9090/TCP"| Envoy["Envoy"]

    %% Platform Dependencies
    DSP -->|"CRD/Workflow CRUD<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]

    %% Internal RHOAI Dependencies
    DSPO["Data Science Pipelines<br/>Operator (DSPO)"] -->|"deploys/manages<br/>via DSPA CR"| DSP
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>8888/TCP, 9090/TCP"| DSP
    DSP -.->|"manages workbenches<br/>CRD CRUD"| Notebooks["Kubeflow Notebooks"]

    %% Integration Points (inbound)
    Dashboard["ODH Dashboard"] -.->|"UI management"| DSP
    Pipelines["Pipeline SDK"] -->|"submits pipelines<br/>8888/TCP REST, 8887/TCP gRPC"| DSP

    %% Styling
    style DSP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External dependencies - gray
    style MySQL fill:#999,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style Argo fill:#999,stroke:#333,color:#fff
    style MLMD fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style Envoy fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff

    %% Internal RHOAI - green
    style DSPO fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style Notebooks fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% Clients - light blue
    style Pipelines fill:#87ceeb,stroke:#333
