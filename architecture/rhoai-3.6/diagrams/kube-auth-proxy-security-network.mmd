graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Browser / External Client"]
    end

    subgraph Ingress["INGRESS (TLS Edge Termination)"]
        Route["OpenShift Route<br/>443/TCP → 4180/TCP<br/>TLS Edge Termination"]
    end

    subgraph Application["APPLICATION (kube-auth-proxy Pod)"]
        direction TB

        subgraph AuthChain["Authentication Chain (cascade)"]
            K8sToken["1. K8s TokenReview<br/>(SA Bearer tokens)"]
            JWTBearer["2. JWT/OAuth Bearer<br/>(local verify)"]
            BasicAuthN["3. Basic Auth<br/>(htpasswd)"]
            SessionAuth["4. Stored Session<br/>(Cookie/Redis)"]
        end

        Proxy["kube-auth-proxy<br/>4180/TCP<br/>FIPS: strictfipsruntime<br/>Base: ubi9/ubi-minimal-pqc<br/>TLS 1.2+ configurable"]

        UpstreamProxy2["Upstream Reverse Proxy<br/>Forwarded Headers:<br/>X-Forwarded-User/Email/Groups"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+ cluster CA<br/>ServiceAccount token"]
        OAuthServer["OpenShift OAuth<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Client credentials"]
        OIDCProv["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Client credentials + PKCE"]
        RedisValkey["Redis / Valkey<br/>Configurable port<br/>TLS optional<br/>Password optional"]
    end

    subgraph UpstreamZone["UPSTREAM (Trusted)"]
        UpstreamApp["Upstream Application<br/>Configurable port<br/>HTTP/HTTPS"]
    end

    subgraph OptionalIntegration["OPTIONAL INTEGRATIONS"]
        Envoy["Envoy Proxy<br/>ext_authz via /oauth2/auth<br/>HTTP internal<br/>202 or 401/403"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS edge<br/>Cookie/Bearer/None"| Route
    Route -->|"HTTP/4180<br/>Post TLS termination<br/>Forwarded headers"| Proxy

    Proxy --> K8sToken
    K8sToken -->|fail| JWTBearer
    JWTBearer -->|fail| BasicAuthN
    BasicAuthN -->|fail| SessionAuth

    Proxy -->|"Authenticated request<br/>Identity headers"| UpstreamProxy2
    UpstreamProxy2 -->|"HTTP/HTTPS<br/>Configurable<br/>X-Forwarded-User"| UpstreamApp

    K8sToken -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Proxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>Client creds"| OAuthServer
    Proxy -->|"HTTPS/443<br/>TLS 1.2+<br/>PKCE + Client creds"| OIDCProv
    Proxy -->|"TCP<br/>TLS optional<br/>Password optional"| RedisValkey
    Envoy -->|"HTTP/4180<br/>Internal<br/>Forwarded headers"| Proxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef upstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Route ingress
    class Proxy,K8sToken,JWTBearer,BasicAuthN,SessionAuth,UpstreamProxy2 application
    class K8sAPI,OAuthServer,OIDCProv,RedisValkey externalservice
    class UpstreamApp upstream
    class Envoy optional
