graph TB
    subgraph "llm-d-benchmark"
        direction TB

        subgraph CLI["llmdbenchmark CLI"]
            PlanPhase["Plan Phase<br/>Configuration Rendering"]
            StandupPhase["Standup Phase<br/>Infrastructure Provisioning"]
            RunPhase["Run Phase<br/>Experiment Execution"]
            TeardownPhase["Teardown Phase<br/>Resource Cleanup"]
            RenderPlans["RenderPlans Engine<br/>Jinja2 Template Merge"]
            StepExecutor["StepExecutor<br/>Sequential Step Runner"]
        end

        subgraph Harness["Harness Container (StatefulSet)"]
            Entrypoint["llm-d-benchmark.sh<br/>Entrypoint Script"]
            InferencePerf["inference-perf<br/>v0.7.0"]
            VllmBench["vllm-benchmark<br/>v0.30.0"]
            GuideLLM["guidellm<br/>v0.7.3"]
            AiPerf["aiperf<br/>v0.12.0"]
            LmEval["lm-eval<br/>0.4.12"]
            Analysis["Analysis Script<br/>Post-run Processing"]
        end

        subgraph ResultsStore["Results Store"]
            GCSClient["GCS Direct Client"]
            GCSProxy["GCS Proxy Client<br/>(Prism Fallback)"]
        end

        subgraph Discovery["llm_d_stack_discovery"]
            StackTracer["Stack Tracer<br/>pykube-ng"]
        end

        BenchReport["benchmark-report<br/>Schema Library"]
    end

    %% CLI internal flows
    PlanPhase -->|renders| RenderPlans
    RenderPlans -->|workspace config| StandupPhase
    StandupPhase -->|step execution| StepExecutor
    RunPhase -->|step execution| StepExecutor
    TeardownPhase -->|step execution| StepExecutor

    %% CLI to Harness
    StandupPhase -->|deploys| Harness

    %% Harness internal flows
    Entrypoint -->|dispatches| InferencePerf
    Entrypoint -->|dispatches| VllmBench
    Entrypoint -->|dispatches| GuideLLM
    Entrypoint -->|dispatches| AiPerf
    Entrypoint -->|dispatches| LmEval
    InferencePerf -->|results| Analysis
    VllmBench -->|results| Analysis
    GuideLLM -->|results| Analysis
    AiPerf -->|results| Analysis
    LmEval -->|results| Analysis
    Analysis -->|structured report| BenchReport

    %% Results storage
    Analysis -->|upload| GCSClient
    Analysis -->|fallback read| GCSProxy

    %% External dependencies
    User[User / CI Pipeline] -->|invokes| CLI
    StandupPhase -->|provisions| K8sAPI[Kubernetes API<br/>6443/TCP]
    RunPhase -->|monitors| K8sAPI
    TeardownPhase -->|deletes| K8sAPI
    Harness -->|sends load| LLMEndpoint[LLM Inference Endpoint]
    GCSClient -->|push/pull| GCS[Google Cloud Storage<br/>443/TCP]
    GCSProxy -->|read-only| Prism[Prism Proxy<br/>prism.llm-d.ai]
    StackTracer -->|traces topology| K8sAPI
    CLI -->|model metadata| HFHub[HuggingFace Hub<br/>443/TCP]

    %% Styling
    style CLI fill:#4a90e2,color:#fff
    style Harness fill:#4a90e2,color:#fff
    style ResultsStore fill:#4a90e2,color:#fff
    style Discovery fill:#4a90e2,color:#fff
    style BenchReport fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style GCS fill:#f5a623
    style Prism fill:#f5a623
    style HFHub fill:#f5a623
    style LLMEndpoint fill:#f5a623
    style User fill:#9b59b6,color:#fff
