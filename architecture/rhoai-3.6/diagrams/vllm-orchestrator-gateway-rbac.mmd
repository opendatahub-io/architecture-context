graph TD
    subgraph Note["RBAC Status"]
        direction TB
        Info["No RBAC manifests defined in this repository<br/>RBAC managed by deploying operator or platform"]
    end

    subgraph Gateway["vllm-orchestrator-gateway"]
        direction TB
        Service["Stateless HTTP Service<br/>No K8s API Access Required"]
    end

    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB
        Inbound["Inbound Auth<br/>None enforced by gateway"]
        AuthHeader["Authorization Header<br/>Forwarded transparently"]
        Outbound["Outbound Auth<br/>Optional mTLS client cert"]
    end

    subgraph Enforcement["Auth Enforcement Points"]
        direction TB
        Ingress["Platform Ingress<br/>(Route / Gateway API)<br/>TLS termination + auth"]
        Orchestrator["FMS Guardrails Orchestrator<br/>Receives forwarded Authorization"]
    end

    subgraph Secrets["Secrets (Certificate-Based)"]
        direction TB
        TLSCert["TLS Certificate<br/>/etc/tls/private/tls.crt<br/>/etc/tls/private/tls.key<br/>Type: kubernetes.io/tls<br/>Provisioned: service-serving-cert-signer<br/>Auto-rotate: Yes"]
        CACert["CA Certificate<br/>/etc/tls/ca/service-ca.crt<br/>Type: ConfigMap<br/>Provisioned: service-ca operator<br/>Auto-rotate: Yes"]
    end

    Service -->|"no auth enforcement"| Inbound
    Inbound -->|"pass-through"| AuthHeader
    AuthHeader -->|"forwarded to"| Orchestrator
    Service -->|"uses for mTLS"| TLSCert
    Service -->|"uses for trust verification"| CACert
    Ingress -->|"terminates TLS,<br/>enforces auth"| Service

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style Info fill:#fff3cd,stroke:#856404
    style Service fill:#4a90e2,stroke:#333,color:#fff
    style Inbound fill:#f8d7da,stroke:#721c24
    style AuthHeader fill:#f5a623,stroke:#333
    style Outbound fill:#d5e8d4,stroke:#82b366
    style Ingress fill:#d5e8d4,stroke:#82b366
    style Orchestrator fill:#7ed321,stroke:#333
    style TLSCert fill:#ffe6cc,stroke:#d79b00
    style CACert fill:#ffe6cc,stroke:#d79b00
