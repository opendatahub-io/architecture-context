graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
        NewSite["New Site Operator"]
    end

    subgraph Ingress["INGRESS (Optional Routes)"]
        EnrollRoute["Enrollment Route<br/>8443/TCP HTTPS<br/>TLS 1.2+ passthrough"]
        GatewayRoute["Gateway Route<br/>8080/TCP HTTPS<br/>TLS 1.2+ passthrough/reencrypt"]
    end

    subgraph CrossSite["CROSS-SITE (Encrypted Mesh)"]
        direction TB
        PeerSWIM["Peer SWIM Endpoints<br/>7946/UDP<br/>AES-256-GCM<br/>Shared Key"]
        PeerSignals["Peer Signals Endpoints<br/>9091/TCP HTTPS<br/>mTLS (site identity)<br/>Client Certificate"]
        PeerGateway["Peer Provider Gateway<br/>8080/TCP HTTPS<br/>mTLS (site identity)<br/>Client Certificate"]
    end

    subgraph GridSystem["GRID-SYSTEM NAMESPACE (Operator)"]
        direction TB

        subgraph OperatorPod["Operator Pod<br/>SA: grid-operator<br/>seccomp: RuntimeDefault<br/>readOnlyRootFilesystem"]
            OpMetrics["Metrics + Health<br/>9090/TCP HTTP<br/>TLS optional (auto)"]
            OpSWIM["SWIM Gossip<br/>7946/UDP<br/>AES-256-GCM"]
            OpSignals["Signals Server<br/>9091/TCP HTTPS<br/>mTLS"]
        end

        subgraph EnrollPod["Enrollment Pod (optional)<br/>SA: grid-enrollment"]
            EnrollServer["Enrollment API<br/>8443/TCP HTTPS<br/>TLS 1.2+<br/>mTLS + Token"]
        end

        subgraph GatewayPod["Gateway Pod<br/>overlay-sync sidecar"]
            GatewaySvc["Provider Gateway<br/>8080/TCP<br/>TLS optional<br/>Bearer / mTLS"]
            OverlaySyncC["Overlay-Sync<br/>8080/TCP HTTP<br/>ConfigMap watcher"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS 1.2+<br/>Client Cert / Password"]
        InferenceBackend["Inference Backends<br/>configurable port<br/>HTTP/HTTPS<br/>Bearer / mTLS"]
        Prometheus["Prometheus<br/>scrapes 9090/TCP<br/>HTTP/HTTPS<br/>NetworkPolicy restricted"]
    end

    %% External flows
    Client -->|"HTTPS 8080<br/>API key / Bearer"| GatewayRoute
    NewSite -->|"HTTPS 8443<br/>One-time Token"| EnrollRoute

    %% Ingress to services
    EnrollRoute -->|"passthrough"| EnrollServer
    GatewayRoute -->|"passthrough"| GatewaySvc

    %% Cross-site mesh
    OpSWIM <-->|"UDP 7946<br/>AES-256-GCM<br/>Shared Key"| PeerSWIM
    OpSignals <-->|"HTTPS 9091<br/>mTLS<br/>Cert Pin / SPIFFE"| PeerSignals
    GatewaySvc <-->|"HTTPS 8080<br/>mTLS<br/>Site Identity"| PeerGateway

    %% Internal flows
    OperatorPod -->|"HTTPS 443<br/>SA Token"| K8sAPI
    OverlaySyncC -->|"HTTPS 443<br/>SA Token"| K8sAPI
    EnrollServer -->|"TLS 5432<br/>Client Cert"| PostgreSQL
    EnrollServer -->|"HTTPS 443<br/>SA Token"| K8sAPI
    GatewaySvc -->|"HTTP/S<br/>Credential Injection"| InferenceBackend
    Prometheus -->|"HTTP/S 9090<br/>NetworkPolicy"| OpMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef crosssite fill:#e6d5f5,stroke:#7c3aed,stroke-width:2px
    classDef gridsystem fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,NewSite external
    class EnrollRoute,GatewayRoute ingress
    class PeerSWIM,PeerSignals,PeerGateway crosssite
    class OpMetrics,OpSWIM,OpSignals,EnrollServer,GatewaySvc,OverlaySyncC gridsystem
    class K8sAPI,PostgreSQL,InferenceBackend,Prometheus externalservice
