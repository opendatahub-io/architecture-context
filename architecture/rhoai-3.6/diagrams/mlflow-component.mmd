graph TB
    subgraph External["External Access"]
        User["Data Scientist / SDK Client"]
        Browser["Browser"]
    end

    subgraph ODHGateway["ODH Data Science Gateway"]
        Gateway["Gateway<br/>/mlflow endpoint<br/>443/TCP HTTPS"]
    end

    subgraph MLflowComponent["MLflow Component"]
        subgraph Server["mlflow-server (Port 5000)"]
            FastAPI["FastAPI / Flask App"]
            KubeAuth["kubernetes-auth Plugin<br/>(mlflow-kubernetes-plugins)"]
            WorkspaceStore["Workspace Store<br/>(kubernetes://)"]
            ArtifactProxy["Artifact Proxy"]
            MetricsExporter["Prometheus Metrics<br/>(prometheus-flask-exporter)"]
            FastAPI --> KubeAuth
            KubeAuth --> WorkspaceStore
            FastAPI --> ArtifactProxy
            FastAPI --> MetricsExporter
        end

        subgraph UI["mlflow-ui"]
            ReactUI["React Frontend<br/>(bundled in server)"]
        end

        subgraph SDKs["Client Libraries"]
            MLflowSkinny["mlflow-skinny<br/>(lightweight SDK)"]
            MLflowTracing["mlflow-tracing<br/>(LLM observability)"]
        end

        ReactUI -->|"served by"| FastAPI
    end

    subgraph BackendServices["Backend Services"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    end

    subgraph Operator["MLflow Operator (external)"]
        MLflowOperator["MLflow Operator<br/>Manages Deployment, HTTPRoute,<br/>MLflowConfig CRDs"]
    end

    User -->|"Bearer token +<br/>X-MLFLOW-WORKSPACE"| Gateway
    Browser -->|"OAuth via ODH Dashboard"| Gateway
    Gateway -->|"HTTP/HTTPS<br/>5000/TCP"| FastAPI

    MLflowSkinny -.->|"uses"| Gateway
    MLflowTracing -.->|"uses"| Gateway

    KubeAuth -->|"SelfSubjectAccessReview"| K8sAPI
    WorkspaceStore -->|"namespace list/watch"| K8sAPI
    FastAPI -->|"metadata queries"| PostgreSQL
    ArtifactProxy -->|"artifact storage"| S3

    MLflowOperator -->|"manages lifecycle"| Server

    style FastAPI fill:#4a90e2,stroke:#333
    style KubeAuth fill:#e74c3c,stroke:#333,color:#fff
    style WorkspaceStore fill:#e74c3c,stroke:#333,color:#fff
    style ArtifactProxy fill:#4a90e2,stroke:#333
    style MetricsExporter fill:#4a90e2,stroke:#333
    style ReactUI fill:#9b59b6,stroke:#333,color:#fff
    style MLflowSkinny fill:#3498db,stroke:#333,color:#fff
    style MLflowTracing fill:#3498db,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style Gateway fill:#2ecc71,stroke:#333
    style MLflowOperator fill:#7ed321,stroke:#333
