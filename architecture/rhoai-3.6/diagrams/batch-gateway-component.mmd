graph TB
    subgraph BatchGateway["Batch Gateway System"]
        direction TB

        subgraph APIServer["API Server (8000/TCP, 8081/TCP)"]
            Mux["HTTP Mux<br/>Recovery + RequestMiddleware<br/>+ SecurityHeaders"]
            BatchHandler["Batch Handler<br/>/v1/batches"]
            FileHandler["File Handler<br/>/v1/files"]
            ObsServer["Observability Server<br/>/health, /ready, /metrics"]
        end

        subgraph Processor["Processor (StatefulSet, 9090/TCP)"]
            QueuePoller["Queue Poller<br/>pollInterval: 5s"]
            PlanBuilder["Execution Plan Builder<br/>per-model grouping"]
            Dispatcher["Dispatcher<br/>AIMD concurrency control"]
            ObsProc["Observability<br/>/health, /ready, /metrics"]
        end

        subgraph GC["Garbage Collector (9091/TCP)"]
            Collector["Expired Item Collector<br/>interval: 30m"]
            Reconciler["Orphan Reconciler<br/>watches processor pods"]
            ObsGC["Metrics Server<br/>/health, /metrics"]
        end
    end

    Client["External Client"] -->|"POST /v1/batches<br/>POST /v1/files"| Gateway
    Gateway["Kuadrant/Authorino Gateway<br/>443/TCP HTTPS"] -->|"X-MaaS-Username header<br/>8000/TCP"| Mux
    Mux --> BatchHandler
    Mux --> FileHandler

    BatchHandler -->|"store metadata"| PostgreSQL["PostgreSQL"]
    BatchHandler -->|"enqueue job"| Redis["Redis/Valkey"]
    FileHandler -->|"store file"| S3["S3-compatible Storage"]
    FileHandler -->|"store metadata"| PostgreSQL

    QueuePoller -->|"poll jobs"| Redis
    PlanBuilder -->|"read metadata"| PostgreSQL
    Dispatcher -->|"fetch input"| S3
    Dispatcher -->|"inference requests<br/>AIMD flow control"| LLMd["llm-d Inference Gateway"]
    Dispatcher -->|"write output"| S3
    Dispatcher -->|"update status"| PostgreSQL

    Reconciler -->|"watch pods/statefulsets<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    Collector -->|"delete expired"| PostgreSQL
    Collector -->|"delete files"| S3

    QueuePoller --> PlanBuilder
    PlanBuilder --> Dispatcher

    style APIServer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Processor fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style GC fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style PostgreSQL fill:#e8e8e8,stroke:#999
    style Redis fill:#e8e8e8,stroke:#999
    style S3 fill:#e8e8e8,stroke:#999
    style LLMd fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style Client fill:#f9f9f9,stroke:#999
