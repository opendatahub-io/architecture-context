graph TB
    subgraph IPP["Inference Payload Processor (IPP)"]
        direction TB
        ExtProcServer["ExtProc gRPC Server<br/>9004/TCP"]
        PluginFramework["Plugin Framework"]
        ConfigMapReconciler["ConfigMapReconciler<br/>(controller-runtime)"]
        DataLayerProcessor["Data Layer Processor"]
        HealthServer["Health Server<br/>9005/TCP"]
        MetricsServer["Metrics Server<br/>9090/TCP"]

        ExtProcServer -->|"dispatches events"| PluginFramework
        PluginFramework -->|"feeds events"| DataLayerProcessor
        ConfigMapReconciler -->|"populates"| AdaptersStore["AdaptersStore<br/>(in-memory LRU)"]
    end

    subgraph Plugins["Plugin Pipeline"]
        direction TB
        PreProc["PreProcessor"]
        ProfilePicker["ProfilePicker"]
        ProfileReq["Profile Request<br/>(Filter → Score → Pick)"]
        ProfileResp["Profile Response"]
        PostProc["PostProcessor"]

        PreProc --> ProfilePicker
        ProfilePicker --> ProfileReq
        ProfileReq --> ProfileResp
        ProfileResp --> PostProc
    end

    subgraph InTreePlugins["In-Tree Plugins"]
        BodyFieldToHeader["body-field-to-header"]
        BaseModelToHeader["base-model-to-header"]
        ModelGroupFilter["model-group filter"]
        CostGuard["cost-guard scorer"]
        SessionAffinity["session-affinity scorer"]
        ModelSelector["model-selector"]
        ModelNameToHeader["model-name-to-header"]
    end

    PluginFramework -->|"stages"| Plugins
    Plugins -.->|"registered"| InTreePlugins
    BaseModelToHeader -->|"lookups"| AdaptersStore

    EnvoyProxy["Envoy Proxy"] -->|"gRPC ext-proc<br/>9004/TCP"| ExtProcServer
    ConfigMapReconciler -->|"watches"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    PayloadProcessorConfig["PayloadProcessorConfig<br/>(YAML/ConfigMap)"] -->|"configures"| PluginFramework

    MetricsServer -.->|"scraped by"| Prometheus["Prometheus"]
    DataLayerProcessor -.->|"exports traces"| OTLP["OTLP Collector<br/>4317/TCP"]

    style ExtProcServer fill:#4a90e2,stroke:#333,color:#fff
    style PluginFramework fill:#4a90e2,stroke:#333,color:#fff
    style ConfigMapReconciler fill:#4a90e2,stroke:#333,color:#fff
    style DataLayerProcessor fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style AdaptersStore fill:#4a90e2,stroke:#333,color:#fff
    style PayloadProcessorConfig fill:#f5a623,stroke:#333,color:#333
    style EnvoyProxy fill:#e8e8e8,stroke:#333,color:#333
    style K8sAPI fill:#e8e8e8,stroke:#333,color:#333
    style Prometheus fill:#7ed321,stroke:#333,color:#333
    style OTLP fill:#7ed321,stroke:#333,color:#333
