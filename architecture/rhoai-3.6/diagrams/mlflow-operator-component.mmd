graph TB
    subgraph MLflowOperator["MLflow Operator"]
        direction TB
        Manager["mlflow-operator-controller-manager<br/>(Go Operator)"]

        subgraph Controllers["Controllers"]
            MLflowReconciler["MLflowReconciler<br/>Reconciles MLflow CRs"]
            ModuleReconciler["MLflowOperatorReconciler<br/>ODH module handoff<br/>(conditionally enabled)"]
            NSRBACReconciler["NamespaceRBACReconciler<br/>Workspace RBAC propagation<br/>(conditionally enabled)"]
            TLSWatcher["SecurityProfileWatcher<br/>TLS profile reload"]
        end

        HelmRenderer["Helm Renderer<br/>charts/mlflow/"]

        Manager --> MLflowReconciler
        Manager --> ModuleReconciler
        Manager --> NSRBACReconciler
        Manager --> TLSWatcher
        MLflowReconciler --> HelmRenderer
    end

    %% CRDs
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)<br/>Cluster-scoped"]
    MLflowOperatorCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    AuthCR["Auth CR<br/>(services.platform.opendatahub.io)"]

    %% Rendered Resources
    subgraph RenderedResources["Helm-Rendered Resources"]
        Deploy["Deployment<br/>(MLflow Server)"]
        SVC["Service"]
        PVC["PersistentVolumeClaim"]
        CronJob["CronJobs<br/>(GC + Trace Archival)"]
        NetPol["NetworkPolicy"]
        ArtifactDeploy["Artifact Server<br/>Deployment (optional)"]
        SA["ServiceAccount"]
    end

    %% External integrations
    Gateway["Gateway API<br/>(HTTPRoute)"]
    ConsoleLink["OpenShift ConsoleLink"]
    ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]
    APIServer["OpenShift APIServer<br/>(TLS Profile)"]

    %% Flows
    MLflowCR -->|watched by| MLflowReconciler
    MLflowOperatorCR -->|watched by| ModuleReconciler
    AuthCR -->|watched by| NSRBACReconciler
    APIServer -->|watched by| TLSWatcher

    HelmRenderer -->|renders| RenderedResources
    MLflowReconciler -->|creates| Gateway
    MLflowReconciler -->|creates| ConsoleLink
    MLflowReconciler -->|creates| ServiceMonitor
    NSRBACReconciler -->|creates| RoleBindings["RoleBindings<br/>(per namespace)"]

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style MLflowReconciler fill:#4a90e2,color:#fff
    style ModuleReconciler fill:#4a90e2,color:#fff
    style NSRBACReconciler fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style HelmRenderer fill:#6c5ce7,color:#fff
    style MLflowCR fill:#f5a623,color:#000
    style MLflowOperatorCR fill:#f5a623,color:#000
    style AuthCR fill:#f5a623,color:#000
    style Gateway fill:#7ed321,color:#000
    style ConsoleLink fill:#7ed321,color:#000
    style ServiceMonitor fill:#7ed321,color:#000
    style APIServer fill:#999,color:#fff
