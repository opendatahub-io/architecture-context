graph LR
    NemoGuardrails["NeMo Guardrails"]

    %% Core Runtime Dependencies
    NemoGuardrails -->|HTTP framework| FastAPI["FastAPI >=0.103.0"]
    NemoGuardrails -->|ASGI server| Uvicorn["uvicorn >=0.23"]
    NemoGuardrails -->|LLM client| OpenAI["openai >=1.0.0"]
    NemoGuardrails -->|schema validation| Pydantic["pydantic >=2.5"]
    NemoGuardrails -->|HTTP client| HTTPX["httpx >=0.24.1"]
    NemoGuardrails -->|async HTTP| Aiohttp["aiohttp >=3.10.11"]
    NemoGuardrails -->|language parser| Lark["lark >=1.1.7"]
    NemoGuardrails -->|embeddings| FastEmbed["fastembed >=0.2.2"]
    NemoGuardrails -->|model inference| ONNX["onnxruntime >=1.17.0"]

    %% ML Model Dependencies (Optional)
    NemoGuardrails -.->|ML inference| PyTorch["torch >=2.0.0"]
    NemoGuardrails -.->|transformers| HFTransformers["transformers >=4.35.0"]
    NemoGuardrails -.->|sentence embeddings| SentenceTransformers["sentence-transformers >=2.2.0"]
    NemoGuardrails -.->|NLP processing| SpaCy["spaCy >=3.4.4"]
    NemoGuardrails -.->|jailbreak detection| YARA["yara-python >=4.5.1"]

    %% PII Detection (Optional)
    NemoGuardrails -.->|PII detection| PresidioAnalyzer["presidio-analyzer >=2.2"]
    NemoGuardrails -.->|PII anonymization| PresidioAnonymizer["presidio-anonymizer >=2.2"]

    %% Observability (Optional)
    NemoGuardrails -.->|tracing API| OTelAPI["opentelemetry-api >=1.27.0"]
    NemoGuardrails -.->|FastAPI tracing| OTelFastAPI["opentelemetry-instrumentation-fastapi"]

    %% External Service Dependencies
    NemoGuardrails -->|LLM inference| LLMEndpoint["OpenAI-compatible LLM<br/>443/TCP HTTPS"]
    NemoGuardrails -->|Azure LLM| AzureOpenAI["Azure OpenAI<br/>443/TCP HTTPS"]
    NemoGuardrails -.->|external evals| ThirdPartySaaS["Third-Party SaaS<br/>443/TCP HTTPS"]
    NemoGuardrails -.->|telemetry export| OTelCollector["OpenTelemetry Collector"]

