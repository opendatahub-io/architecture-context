graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mcp-lifecycle-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_Metrics["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (NS-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>(mcp-lifecycle-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
    end

    subgraph Roles["Roles (NS-scoped)"]
        R_Leader["leader-election-role"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        CR_Admin["mcpserver-admin-role<br/>(aggregate-to-admin)"]
        CR_Editor["mcpserver-editor-role<br/>(aggregate-to-edit)"]
        CR_Viewer["mcpserver-viewer-role<br/>(aggregate-to-view)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["(core)<br/>configmaps, namespaces,<br/>pods, secrets"]
        Services["(core)<br/>services"]
        Events["(core), events.k8s.io<br/>events"]
        Deployments["apps<br/>deployments"]
    end

    subgraph GatewayResources["Gateway API Resources"]
        Gateways["gateway.networking.k8s.io<br/>gateways"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
    end

    subgraph MCPResources["MCP API Resources"]
        MCPServers["mcp.x-k8s.io<br/>mcpservers"]
        MCPBindings["mcp.x-k8s.io<br/>mcpgatewaybindings"]
        MCPFinalizers["mcp.x-k8s.io<br/>*/finalizers"]
        MCPStatus["mcp.x-k8s.io<br/>*/status"]
    end

    subgraph KuadrantResources["Kuadrant Resources"]
        KuadrantExt["mcp.kuadrant.io<br/>mcpgatewayextensions"]
        KuadrantReg["mcp.kuadrant.io<br/>mcpserverregistrations"]
    end

    subgraph NetworkResources["Network Resources"]
        NetPol["networking.k8s.io<br/>networkpolicies"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    %% Bindings
    SA -->|bound via| CRB_Manager
    SA -->|bound via| CRB_Metrics
    SA -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    RB_Leader -->|grants| R_Leader

    %% Manager role permissions
    CR_Manager -->|"get, list, watch"| ConfigMaps
    CR_Manager -->|"create, get, list,<br/>update, watch"| Services
    CR_Manager -->|"create, patch"| Events
    CR_Manager -->|"create, get, list,<br/>update, watch"| Deployments
    CR_Manager -->|"get, list, watch"| Gateways
    CR_Manager -->|"create, delete, get,<br/>list, update, watch"| HTTPRoutes
    CR_Manager -->|"get, list, patch,<br/>update, watch"| MCPServers
    CR_Manager -->|"create, delete, get,<br/>list, update, watch"| MCPBindings
    CR_Manager -->|"update"| MCPFinalizers
    CR_Manager -->|"get, patch, update"| MCPStatus
    CR_Manager -->|"get, list, watch"| KuadrantExt
    CR_Manager -->|"create, delete, get,<br/>list, update, watch"| KuadrantReg
    CR_Manager -->|"create, get, list,<br/>update, watch"| NetPol

    %% Metrics auth permissions
    CR_MetricsAuth -->|"create"| TokenReview
    CR_MetricsAuth -->|"create"| SAR

    %% Metrics reader
    CR_MetricsReader -->|"get"| MetricsURL

    %% Aggregate roles
    CR_Admin -->|"CRUD + deletecollection"| MCPServers
    CR_Editor -->|"CRUD"| MCPServers
    CR_Viewer -->|"get, list, watch"| MCPServers

