graph TD
    subgraph TestOnly["TEST-ONLY RBAC (Not Production)"]
        direction TB

        subgraph Users["Test Users"]
            TestUser["User: TEST_USER_USERNAME_PLACEHOLDER"]
            AuthGroup["Group: system:authenticated"]
        end

        subgraph Bindings["ClusterRoleBindings"]
            SelfProvBind["test-user-self-provisioner<br/>(Cluster-scoped)"]
            AdminBind["test-user-admin<br/>(Cluster-scoped)"]
            ClusterAdminBind["test-user-cluster-admin<br/>(Cluster-scoped)"]
            KueueBatchBind["kueue-batch-user-rolebinding<br/>(Cluster-scoped)"]
        end

        subgraph Roles["ClusterRoles"]
            SelfProv["self-provisioner"]
            Admin["admin"]
            ClusterAdmin["cluster-admin"]
            KueueAdmin["test-user-kueue-admin"]
            RayAdmin["test-user-ray-admin"]
            KueueBatch["kueue-batch-user-role"]
        end

        subgraph Resources["API Resources"]
            subgraph KueueRes["kueue.x-k8s.io"]
                CQ["clusterqueues"]
                LQ["localqueues"]
                RF["resourceflavors"]
                WL["workloads"]
            end

            subgraph RayRes["ray.io"]
                RC["rayclusters"]
                RJ["rayjobs"]
            end

            subgraph CoreRes["core + apps"]
                NS["namespaces"]
                Deploy["deployments"]
                Pods["pods"]
                Svc["services"]
                CM["configmaps"]
                Secrets["secrets"]
            end
        end

        %% User to Binding
        TestUser -->|"bound via"| SelfProvBind
        TestUser -->|"bound via"| AdminBind
        TestUser -->|"bound via"| ClusterAdminBind
        AuthGroup -->|"bound via"| KueueBatchBind

        %% Binding to Role
        SelfProvBind -->|"grants"| SelfProv
        AdminBind -->|"grants"| Admin
        ClusterAdminBind -->|"grants"| ClusterAdmin
        KueueBatchBind -->|"grants"| KueueBatch

        %% Role to Resources
        KueueAdmin -->|"CRUD"| CQ
        KueueAdmin -->|"CRUD"| LQ
        KueueAdmin -->|"CRUD"| RF
        KueueAdmin -->|"CRUD"| WL

        RayAdmin -->|"CRUD"| RC
        RayAdmin -->|"CRUD"| RJ

        KueueBatch -->|"CRUD"| CQ
        KueueBatch -->|"CRUD"| LQ
        KueueBatch -->|"CRUD"| RF
        KueueBatch -->|"CRUD"| RC
        KueueBatch -->|"CRUD"| RJ
        KueueBatch -->|"CRUD"| NS
        KueueBatch -->|"CRUD"| Deploy
        KueueBatch -->|"CRUD"| Pods
        KueueBatch -->|"CRUD"| Svc
        KueueBatch -->|"CRUD"| CM
        KueueBatch -->|"CRUD"| Secrets
    end

    subgraph Production["PRODUCTION RBAC"]
        ProdNote["Production RBAC is defined by the<br/>deploying operator (e.g., odh-operator),<br/>not by this SDK repository"]
    end

    style TestUser fill:#4a90e2,color:#fff
    style AuthGroup fill:#4a90e2,color:#fff
    style KueueAdmin fill:#f5a623
    style RayAdmin fill:#f5a623
    style KueueBatch fill:#f5a623
    style SelfProv fill:#e8e8e8
    style Admin fill:#e8e8e8
    style ClusterAdmin fill:#e8e8e8
    style ProdNote fill:#d5e8d4,stroke:#82b366,stroke-width:2px
