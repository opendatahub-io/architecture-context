graph TB
    subgraph WVA["Workload-Variant-Autoscaler Controller"]
        direction TB

        subgraph Engines["Optimization Engines (Leader-Elected Runnables)"]
            SatEngine["Saturation Engine<br/>(15s/60s loop)"]
            SFZEngine["Scale-from-Zero Engine"]
            Coordinator["Coordinator<br/>(GPU Rebalancing - Experimental)"]
        end

        subgraph Reconcilers["Discovery Reconcilers"]
            CMReconciler["ConfigMap Reconciler"]
            HPAReconciler["HPA Reconciler"]
            IPReconciler["InferencePool Reconciler"]
            SOReconciler["ScaledObject Reconciler<br/>(Conditional)"]
        end

        Datastore["In-Memory Datastore"]
        CRDWatcher["CRD Watcher<br/>(Auto-Restart on CRD Install)"]

        CMReconciler -->|updates config| Datastore
        HPAReconciler -->|registers models| Datastore
        IPReconciler -->|registers pools| Datastore
        SOReconciler -->|registers models| Datastore

        SatEngine -->|reads models & config| Datastore
        SFZEngine -->|reads models| Datastore
        Coordinator -->|reads GPU state| Datastore
    end

    %% External Resources Watched
    ConfigMaps["ConfigMaps<br/>(labeled)"] -->|watched by| CMReconciler
    HPAs["HorizontalPodAutoscalers<br/>(annotated)"] -->|watched by| HPAReconciler
    InferencePools["InferencePool CRs<br/>(Gateway API)"] -->|watched by| IPReconciler
    ScaledObjects["ScaledObject CRs<br/>(KEDA - optional)"] -->|watched by| SOReconciler
    OptionalCRDs["Optional CRDs<br/>(LWS, KEDA)"] -->|detected by| CRDWatcher

    %% Egress
    SatEngine -->|queries metrics| Prometheus["Prometheus / Thanos Querier"]
    SatEngine -->|patches scale| K8sAPI["Kubernetes API"]
    SFZEngine -->|patches scale| K8sAPI

    %% Metrics endpoint
    PromScraper["Prometheus ServiceMonitor"] -->|scrapes :8443| WVA

    %% Styles
    style WVA fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style SatEngine fill:#4a90e2,color:#fff
    style SFZEngine fill:#4a90e2,color:#fff
    style Coordinator fill:#4a90e2,color:#fff,stroke-dasharray:5 5
    style Datastore fill:#f5a623,color:#fff
    style CRDWatcher fill:#7c7c7c,color:#fff
    style CMReconciler fill:#6aa84f,color:#fff
    style HPAReconciler fill:#6aa84f,color:#fff
    style IPReconciler fill:#6aa84f,color:#fff
    style SOReconciler fill:#6aa84f,color:#fff,stroke-dasharray:5 5
    style Prometheus fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style ConfigMaps fill:#fff2cc,stroke:#d6b656
    style HPAs fill:#fff2cc,stroke:#d6b656
    style InferencePools fill:#fff2cc,stroke:#d6b656
    style ScaledObjects fill:#fff2cc,stroke:#d6b656,stroke-dasharray:5 5
    style OptionalCRDs fill:#fff2cc,stroke:#d6b656,stroke-dasharray:5 5
    style PromScraper fill:#e8e8e8,stroke:#999
