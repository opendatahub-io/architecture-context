graph TB
    subgraph "Training Hub"
        direction TB

        subgraph "Public API"
            CLI["thub CLI<br/>(console script)"]
            PythonAPI["Python API<br/>(sft, osft, lora_sft,<br/>lora_grpo, grpo, gepa,<br/>embedding_sft)"]
        end

        subgraph "Core Framework"
            Registry["AlgorithmRegistry<br/>(Strategy + Registry Pattern)"]
            AlgorithmABC["Algorithm ABC"]
            BackendABC["Backend ABC"]
            AlgorithmABC --> Registry
            BackendABC --> Registry
        end

        subgraph "Cross-Cutting Concerns"
            Callbacks["TrainingHubCallback<br/>(9 lifecycle hooks)"]
            JITCheckpoint["JIT Preemption<br/>Checkpoint<br/>(SIGTERM handler)"]
            CheckpointMgr["Checkpoint Manager<br/>(LIFO upload worker)"]
            MemoryEstimator["GPU Memory<br/>Estimator"]
            Visualization["Training Loss<br/>Visualization"]
        end

        subgraph "Callback Adapters"
            AdapterIL["InstructLab<br/>Adapter"]
            AdapterMT["Mini-Trainer<br/>Adapter"]
            AdapterUS["Unsloth<br/>Adapter"]
            Serialize["Serializer<br/>(torchrun class-source)"]
        end

        subgraph "Algorithm Backends"
            SFTBackend["InstructLabTraining<br/>SFTBackend<br/>(torchrun)"]
            OSFTBackend["MiniTrainer<br/>OSFTBackend<br/>(torchrun)"]
            LoRASFTBackend["Unsloth<br/>LoRABackend<br/>(HF Trainer)"]
            ARTBackend["ART LoRA<br/>GRPOBackend<br/>(single-GPU)"]
            VeRLBackend["VeRL LoRA<br/>GRPOBackend<br/>(multi-GPU FSDP)"]
            GEPABackend["GEPABackend<br/>(gradient-free)"]
            MLflowGEPA["MLflow<br/>GEPABackend"]
            EmbeddingBackend["SentenceTransformers<br/>Backend"]
        end
    end

    %% API routing
    CLI -->|"YAML config<br/>+ CLI args"| Registry
    PythonAPI -->|"convenience<br/>functions"| Registry

    %% Registry dispatches to backends
    Registry -->|dispatches| SFTBackend
    Registry -->|dispatches| OSFTBackend
    Registry -->|dispatches| LoRASFTBackend
    Registry -->|dispatches| ARTBackend
    Registry -->|dispatches| VeRLBackend
    Registry -->|dispatches| GEPABackend
    Registry -->|dispatches| MLflowGEPA
    Registry -->|dispatches| EmbeddingBackend

    %% Callbacks connect to adapters
    Callbacks --> AdapterIL
    Callbacks --> AdapterMT
    Callbacks --> AdapterUS
    AdapterIL --> SFTBackend
    AdapterMT --> OSFTBackend
    AdapterUS --> LoRASFTBackend

    %% Cross-cutting connections
    JITCheckpoint -->|"SIGTERM<br/>coordination"| SFTBackend
    JITCheckpoint -->|"SIGTERM<br/>coordination"| OSFTBackend
    JITCheckpoint -->|"JITCheckpointCallback"| LoRASFTBackend
    CheckpointMgr -->|"background<br/>LIFO upload"| S3["S3-Compatible<br/>Storage"]

    %% Styling
    style CLI fill:#4a90e2,color:#fff
    style PythonAPI fill:#4a90e2,color:#fff
    style Registry fill:#f5a623,color:#fff
    style AlgorithmABC fill:#f5a623,color:#fff
    style BackendABC fill:#f5a623,color:#fff
    style Callbacks fill:#9b59b6,color:#fff
    style JITCheckpoint fill:#9b59b6,color:#fff
    style CheckpointMgr fill:#9b59b6,color:#fff
    style MemoryEstimator fill:#9b59b6,color:#fff
    style Visualization fill:#9b59b6,color:#fff
    style SFTBackend fill:#7ed321,color:#fff
    style OSFTBackend fill:#7ed321,color:#fff
    style LoRASFTBackend fill:#7ed321,color:#fff
    style ARTBackend fill:#7ed321,color:#fff
    style VeRLBackend fill:#7ed321,color:#fff
    style GEPABackend fill:#7ed321,color:#fff
    style MLflowGEPA fill:#7ed321,color:#fff
    style EmbeddingBackend fill:#7ed321,color:#fff
    style S3 fill:#e8e8e8,stroke:#999
