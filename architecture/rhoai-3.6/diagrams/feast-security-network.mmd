graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["ML Application / Data Scientist"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        Route["OpenShift Route (feast-ui)<br/>443/TCP → 6566/TCP<br/>TLS Edge/Reencrypt<br/>Auth: CRD-configured"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB
        Operator["Feast Operator<br/>SA: feast-operator-controller-manager"]

        subgraph OperatorPorts["Operator Ports"]
            Metrics["Metrics: 8443/TCP HTTPS<br/>TLS (self-signed)<br/>Auth: TokenReview + SubjectAccessReview"]
            Health["Health: 8081/TCP HTTP<br/>No auth (probes)"]
        end
    end

    subgraph UserNS["USER NAMESPACE (per-FeatureStore CR)"]
        direction TB
        FeatureServer["Feature Server (Python)<br/>SA: per-CR service account<br/>Image: odh-feature-server-rhel9"]

        subgraph FSPorts["Feature Server Ports"]
            FSPort["6566/TCP HTTP/HTTPS<br/>TLS 1.2+ (when enabled)<br/>Auth: Kubernetes RBAC / OIDC / None"]
        end

        GoServer["Feature Server (Go)<br/>SA: per-CR service account"]

        subgraph GoServerPorts["Go Server Ports"]
            GoHTTP["HTTP: configurable<br/>TLS 1.2+ (min), X25519MLKEM768<br/>Auth: None (no middleware)"]
            GoGRPC["gRPC: configurable<br/>TLS configurable<br/>Auth: None"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        Redis["Redis / Valkey<br/>Configurable port TCP<br/>TLS configurable<br/>Password / TLS auth"]
        PostgreSQL["PostgreSQL<br/>Configurable port TCP<br/>TLS configurable<br/>Username / Password"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM / configured"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS<br/>Google credentials"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        OpenShiftAPI["OpenShift APIServer Config<br/>config.openshift.io<br/>6443/TCP HTTPS"]
        Prometheus["Prometheus<br/>(scrapes ServiceMonitor)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS Edge/Reencrypt<br/>CRD-configured auth"| Route
    Route -->|"HTTP(S)/6566<br/>TLS 1.2+ (configurable)<br/>Kubernetes RBAC / OIDC / None"| FeatureServer

    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>Read TLS profile"| OpenShiftAPI
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>TokenReview"| Metrics

    FeatureServer -->|"TCP/configurable<br/>TLS configurable<br/>Password/TLS"| Redis
    FeatureServer -->|"TCP/configurable<br/>TLS configurable<br/>Username/Password"| PostgreSQL
    FeatureServer -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    FeatureServer -->|"HTTPS/443<br/>TLS<br/>Google creds"| GCS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operatorns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef userns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Route ingress
    class Operator,Metrics,Health operatorns
    class FeatureServer,GoServer,FSPort,GoHTTP,GoGRPC userns
    class K8sAPI,Redis,PostgreSQL,S3,GCS externalservice
    class OpenShiftAPI,Prometheus platform
