graph TB
    subgraph SDK["Kubeflow SDK (kubeflow PyPI package)"]
        direction TB

        subgraph Common["kubeflow.common"]
            Types["Shared Types<br/>(KubernetesBackendConfig)"]
            Logging["Structured Logging<br/>(structlog)"]
        end

        subgraph Trainer["kubeflow.trainer"]
            TrainerClient["TrainerClient"]
            K8sBackend["KubernetesBackend"]
            ContainerBackend["ContainerBackend<br/>(Docker/Podman)"]
            LocalBackend["LocalProcessBackend"]
            TrainerClient --> K8sBackend
            TrainerClient --> ContainerBackend
            TrainerClient --> LocalBackend
        end

        subgraph RHAI["kubeflow.trainer.rhai"]
            TransformersTrainer["TransformersTrainer"]
            TrainingHubTrainer["TrainingHubTrainer"]
            SpecDecTrainer["SpeculativeDecodingTrainer"]
            Instrumentation["Instrumentation<br/>(code injection via<br/>inspect.getsource)"]
            TransformersTrainer --> Instrumentation
            TrainingHubTrainer --> Instrumentation
            SpecDecTrainer --> Instrumentation
        end

        subgraph Optimizer["kubeflow.optimizer"]
            OptimizerClient["OptimizerClient"]
        end

        subgraph Spark["kubeflow.spark"]
            SparkClient["SparkClient"]
        end

        subgraph Hub["kubeflow.hub"]
            ModelRegistryClient["ModelRegistryClient"]
        end

        subgraph Pipelines["kubeflow.pipelines"]
            PipelinesClient["PipelinesClient"]
        end
    end

    %% CRDs consumed
    TrainJobCR["TrainJob CR<br/>(trainer.kubeflow.org/v1alpha1)"]
    TrainingRuntimeCR["TrainingRuntime CR<br/>(trainer.kubeflow.org/v1alpha1)"]
    ExperimentCR["Experiment CR<br/>(kubeflow.org/v1beta1)"]
    SparkConnectCR["SparkConnect CR<br/>(sparkoperator.k8s.io/v1alpha1)"]

    K8sBackend -->|creates/watches| TrainJobCR
    K8sBackend -->|references| TrainingRuntimeCR
    OptimizerClient -->|creates/watches| ExperimentCR
    SparkClient -->|creates/watches| SparkConnectCR

    %% External Dependencies
    K8sAPI["Kubernetes API Server"]
    HFHub["HuggingFace Hub"]
    S3["S3-Compatible Storage"]
    ModelReg["Model Registry"]
    KFPipelines["Kubeflow Pipelines"]

    K8sBackend -->|443/TCP HTTPS| K8sAPI
    ModelRegistryClient -->|REST API| ModelReg
    PipelinesClient -->|wraps kfp| KFPipelines
    Instrumentation -.->|injected into pods| HFHub
    Instrumentation -.->|injected into pods| S3

    %% Styling
    style SDK fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Trainer fill:#bbdefb,stroke:#1565c0
    style RHAI fill:#c8e6c9,stroke:#2e7d32
    style Optimizer fill:#bbdefb,stroke:#1565c0
    style Spark fill:#bbdefb,stroke:#1565c0
    style Hub fill:#bbdefb,stroke:#1565c0
    style Pipelines fill:#bbdefb,stroke:#1565c0
    style Common fill:#f5f5f5,stroke:#757575

    style TrainJobCR fill:#fff3e0,stroke:#e65100
    style TrainingRuntimeCR fill:#fff3e0,stroke:#e65100
    style ExperimentCR fill:#fff3e0,stroke:#e65100
    style SparkConnectCR fill:#fff3e0,stroke:#e65100

    style K8sAPI fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style ModelReg fill:#c8e6c9,stroke:#2e7d32
    style KFPipelines fill:#c8e6c9,stroke:#2e7d32
