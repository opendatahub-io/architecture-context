graph TD
    subgraph Production["PRODUCTION (No RBAC Defined)"]
        direction TB
        NoRBAC["No production ClusterRoles<br/>or RoleBindings defined"]
        Inherited["Authentication inherited from<br/>RHOAI Workbench Controller"]
        NoRBAC --- Inherited
    end

    subgraph TestRBAC["TEST ENVIRONMENT (Dynamic RBAC)"]
        direction TB

        subgraph TestFramework["Test Framework"]
            TestRunner["E2E Test Runner<br/>Go binary"]
            NewTestNS["NewTestNamespace()<br/>Creates isolated namespace"]
        end

        subgraph DynamicRoles["Dynamically Created (per test)"]
            TestRole["Role<br/>(test-specific permissions)"]
            TestRB["RoleBinding<br/>(test namespace scoped)"]
        end

        subgraph TestSA["Service Accounts"]
            SA["Test ServiceAccount<br/>(per test namespace)"]
        end

        subgraph TestResources["Test CRD Access"]
            TrainJob["kubeflow.org<br/>TrainJob"]
            PyTorchJob["kubeflow.org<br/>PyTorchJob"]
            RayCluster["ray.io<br/>RayCluster"]
            RayJob["ray.io<br/>RayJob"]
            KueueRes["kueue.x-k8s.io<br/>ResourceFlavor<br/>ClusterQueue<br/>LocalQueue"]
        end

        TestRunner -->|creates| NewTestNS
        NewTestNS -->|creates| TestRole
        NewTestNS -->|creates| TestRB
        TestRB -->|binds| TestRole
        TestRB -->|to| SA
        TestRole -->|get,list,watch,create,delete| TrainJob
        TestRole -->|get,list,watch,create,delete| PyTorchJob
        TestRole -->|get,list,watch,create,delete| RayCluster
        TestRole -->|get,list,watch,create,delete| RayJob
        TestRole -->|get,list,watch,create,delete| KueueRes
    end

    subgraph Cleanup["CLEANUP"]
        AutoClean["Automatic namespace deletion<br/>after test completion"]
    end

    TestRunner -->|cleanup| AutoClean

    subgraph ExampleRBAC["EXAMPLES ONLY (Not Product)"]
        ExEdit["RoleBinding: edit"]
        ExAnyuid["RoleBinding: nfs-server-sa-anyuid"]
        ExPriv["RoleBinding: nfs-server-sa-privileged"]
        ExNote["These exist only in workshop<br/>materials, not shipped"]
    end

    style NoRBAC fill:#d5e8d4,stroke:#82b366
    style Inherited fill:#d5e8d4,stroke:#82b366
    style TestRunner fill:#4a90e2,color:#fff
    style TestRole fill:#f5a623
    style TestRB fill:#f5a623
    style SA fill:#4a90e2,color:#fff
    style AutoClean fill:#7ed321
    style ExEdit fill:#f9f9f9,stroke:#999
    style ExAnyuid fill:#f9f9f9,stroke:#999
    style ExPriv fill:#f9f9f9,stroke:#999
    style ExNote fill:#f9f9f9,stroke:#999
