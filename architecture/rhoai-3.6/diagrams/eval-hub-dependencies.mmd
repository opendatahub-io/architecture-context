graph LR
    EvalHub["eval-hub<br/>Evaluation Orchestration"]

    %% Internal Platform Dependencies
    EvalHub -->|"reads CRDs"| HWProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1"]
    EvalHub -->|"lists queues"| Kueue["Kueue LocalQueue<br/>kueue.x-k8s.io/v1beta1"]
    EvalHub -->|"Go library"| MLflowGo["mlflow-go<br/>opendatahub-io/mlflow-go"]
    EvalHub -->|"authn/authz sidecar"| KubeRBAC["kube-rbac-proxy"]

    %% External Infrastructure
    EvalHub -->|"CRUD Jobs, ConfigMaps,<br/>Secrets, NetworkPolicies"| K8sAPI["Kubernetes API<br/>k8s.io/client-go v0.37.1"]
    EvalHub -->|"persistent storage"| PostgreSQL["PostgreSQL<br/>pgx v5.11.0"]
    EvalHub -.->|"dev storage"| SQLite["SQLite<br/>modernc.org/sqlite v1.60.1"]

    %% Evaluation Backends (via sidecar proxy)
    EvalHub -->|"experiment tracking"| MLflow["MLflow Server"]
    EvalHub -->|"model inference"| ModelEP["Model Endpoints<br/>lm-eval / RAGAS /<br/>Garak / GuideLLM"]

    %% Data Sources (init container)
    EvalHub -->|"test data download"| S3["S3 Storage<br/>aws-sdk-go-v2 v1.47.1"]
    EvalHub -->|"dataset download"| HuggingFace["HuggingFace Hub<br/>go-huggingface v0.4.3"]
    EvalHub -->|"git clone"| GitRepos["Git Repositories<br/>go-git v5.19.3"]

    %% Artifact Storage
    EvalHub -->|"eval cards"| OCI["OCI Registries"]

    %% Telemetry
    EvalHub -->|"traces, metrics, logs"| OTel["OpenTelemetry Collector<br/>otel v1.47.0 / gRPC v1.83.2"]
    EvalHub -->|"Prometheus metrics"| PromClient["Prometheus<br/>client_golang v1.24.1"]

    %% MCP Integration
    EvalHub -->|"AI agent protocol"| MCP["MCP SDK<br/>go-sdk v1.8.0"]

    %% Styling
    style EvalHub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal platform (green)
    style HWProfile fill:#7ed321,stroke:#333
    style Kueue fill:#7ed321,stroke:#333
    style MLflowGo fill:#7ed321,stroke:#333
    style KubeRBAC fill:#7ed321,stroke:#333

    %% External infrastructure (grey)
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style SQLite fill:#999,stroke:#333,color:#fff

    %% Evaluation backends (orange)
    style MLflow fill:#f5a623,stroke:#333
    style ModelEP fill:#f5a623,stroke:#333

    %% Data sources (yellow)
    style S3 fill:#fff2cc,stroke:#d6b656
    style HuggingFace fill:#fff2cc,stroke:#d6b656
    style GitRepos fill:#fff2cc,stroke:#d6b656
    style OCI fill:#fff2cc,stroke:#d6b656

    %% Telemetry (light red)
    style OTel fill:#f8cecc,stroke:#b85450
    style PromClient fill:#f8cecc,stroke:#b85450

    %% MCP (blue)
    style MCP fill:#dae8fc,stroke:#6c8ebf
