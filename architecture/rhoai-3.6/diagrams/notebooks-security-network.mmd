graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Edge TLS Termination)"]
        Route["OpenShift Route<br/>443/TCP → oauth-proxy<br/>TLS 1.2+ Edge<br/>Created by: ODH Notebook Controller"]
    end

    subgraph NotebookPod["PER-USER NOTEBOOK POD (StatefulSet)"]
        direction TB

        OAuthProxy["OAuth Proxy Sidecar<br/>Injected by ODH Notebook Controller<br/>OpenShift OAuth Enforcement"]
        JupyterServer["Jupyter Server<br/>8888/TCP HTTP<br/>or Code-Server 8787/TCP<br/>SA: per-notebook"]
        OAuthProxy -->|"HTTP/8888 or 8787<br/>localhost<br/>No encryption"| JupyterServer
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / HMAC"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Token"]
        MLflow["MLflow Server<br/>Configurable Port<br/>HTTP/HTTPS"]
        GitRemote["Git Remotes<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Token/SSH"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OpenShift OAuth"| Route
    Route -->|"Forward<br/>Edge TLS terminated"| OAuthProxy

    JupyterServer -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    JupyterServer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / HMAC"| S3
    JupyterServer -->|"HTTPS/443<br/>TLS 1.2+<br/>API token"| HuggingFace
    JupyterServer -->|"HTTP(S)<br/>Configurable"| MLflow
    JupyterServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Token/SSH"| GitRemote

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy,JupyterServer pod
    class K8sAPI cluster
    class S3,HuggingFace,MLflow,GitRemote externalservice
