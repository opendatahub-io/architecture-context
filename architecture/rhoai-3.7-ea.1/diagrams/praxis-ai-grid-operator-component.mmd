graph TB
    Admin["Admin / Helm chart"]

    subgraph CRDs["grid.praxis.fast/v1alpha1 CRDs (cluster-scoped)"]
        GridNetwork["GridNetwork CR"]
        GridSite["GridSite CR"]
        InferenceProvider["InferenceProvider CR"]
        AgentToolProvider["AgentToolProvider CR"]
        SiteInvite["SiteInvite CR"]
    end

    subgraph Operator["grid-operator (odh-praxis-ai-grid-operator, one per site, leader-elected)"]
        Reconcilers["Reconcilers<br/>GridNetwork / GridSite /<br/>InferenceProvider / AgentToolProvider"]
        Leader["Leader election<br/>Lease grid-operator"]
        Swim["SWIM membership<br/>foca, 7946/UDP<br/>AES-256-GCM"]
        Crdt["CRDT state store<br/>delta broadcasts"]
        Scoring["Scoring engine<br/>noMetrics / queueDepth /<br/>kvCachePressure"]
        Publisher["Routing overlay publisher<br/>SHA-256 digest + revision"]
        Signals["Signals exporter<br/>/v1/site/signals<br/>9091/TCP mTLS"]
        Trust["Trust and identity manager<br/>site identity, mesh key ref,<br/>trust bundles"]
        MetricsL["Metrics / health listener<br/>9090/TCP HTTPS"]
    end

    subgraph Enrollment["grid-enrollment (optional, odh-praxis-ai-grid-enrollment)"]
        EnrollAPI["Enrollment API<br/>8443/TCP HTTPS"]
        CA["Grid CA signer<br/>CSR signing, rotation"]
        Store["Token / enrollment store<br/>memory or Postgres"]
    end

    subgraph DataPlane["Data plane (operator not in request path)"]
        OverlaySync["grid-overlay-sync sidecar"]
        PraxisGW["Praxis AI gateway"]
        GridGW["grid-gateway operand<br/>Praxis / Pingora"]
    end

    OverlayCM["Routing overlay ConfigMap<br/>routing-overlay.json<br/>routing-config.json"]
    ServingCM["Serving ConfigMap<br/>GRID_SERVING_CONFIG"]
    HolderES["Holder EndpointSlices<br/>grid-operator-swim-holder<br/>grid-operator-signals-holder"]
    IdentitySecret["Secret grid-site-identity"]
    SwimKey["Secret grid-swim-key"]

    Admin -->|creates| GridNetwork
    Admin -->|creates| InferenceProvider
    Admin -->|creates| AgentToolProvider
    Admin -->|creates| SiteInvite
    GridNetwork -->|watched by| Reconcilers
    GridSite -->|watched by| Reconcilers
    InferenceProvider -->|watched by| Reconcilers
    AgentToolProvider -->|watched by| Reconcilers
    Reconcilers -->|creates local records| GridSite

    Reconcilers -->|local provider state| Crdt
    Crdt <-->|delta gossip| Swim
    Crdt -->|merged view| Scoring
    Scoring -->|candidates| Publisher
    Publisher -->|writes| OverlayCM
    Publisher -->|writes| ServingCM
    Reconcilers -->|patches mounts| GridGW
    Leader -->|writes| HolderES
    Trust -->|reads / writes| IdentitySecret
    Trust -->|loads mesh key| SwimKey
    SwimKey -.->|key| Swim

    OverlayCM -->|watched by| OverlaySync
    OverlaySync -->|atomic file write<br/>shared emptyDir| PraxisGW
    ServingCM -->|mounted by| GridGW
    GridGW -->|peer signals| Signals

    EnrollAPI --> CA
    EnrollAPI --> Store
    SiteInvite -.->|used by| EnrollAPI
    Trust -->|enroll / rotate via CSR| EnrollAPI

    Peers["Peer site operators"]
    Providers["Inference providers / llm-d"]
    MCP["MCP servers"]
    Swim <-->|7946/UDP| Peers
    Signals <-->|9091/TCP mTLS| Peers
    Reconcilers -->|health, /metrics, /v1/models| Providers
    Reconcilers -->|tools/list| MCP

