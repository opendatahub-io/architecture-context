graph TB
    subgraph Repo["guardrails-detectors repo (rhoai-3.7-ea.1 @ e4e2a9d)"]
        Common["detectors/common<br/>DetectorBaseAPI (FastAPI)<br/>/health, trustyai_guardrails_* counters<br/>FMS Detector API schemas"]

        subgraph HF["HF detector runtime (Konflux-built, SHIPPED)"]
            HFApp["uvicorn :8000/TCP<br/>1 worker<br/>huggingface/app.py"]
            HFDet["Detector.run<br/>seq-class / token-class /<br/>Granite Guardian causal LM"]
            HFApp -->|run_in_threadpool| HFDet
        end

        subgraph BI["Built-in detector (Dockerfile only, NOT built on this branch)"]
            BIApp["uvicorn :8080/TCP<br/>4 workers<br/>built_in/app.py"]
            Regex["Regex PII detectors<br/>REGEX_TIMEOUT ReDoS guard"]
            FileType["JSON/YAML/XML<br/>and schema validators"]
            Custom["Custom Python registry<br/>custom_detectors.py<br/>NOT a sandbox"]
            BIApp --> Regex
            BIApp --> FileType
            BIApp -->|"passes inbound headers"| Custom
        end

        subgraph LJ["LLM-judge detector (upstream only)"]
            LJApp["uvicorn :8000/TCP<br/>4 workers<br/>llm_judge/app.py"]
            Judge["vllm_judge.Judge<br/>(httpx)"]
            LJApp --> Judge
        end

        Common -.->|base class| HFApp
        Common -.->|base class| BIApp
        Common -.->|base class| LJApp
    end

    Orchestrator["FMS Guardrails Orchestrator /<br/>vllm-orchestrator-gateway"] -->|"POST /api/v1/text/contents"| HFApp
    Orchestrator -.->|"POST /api/v1/text/contents"| BIApp
    Orchestrator -.->|"POST /api/v1/text/contents and /generation"| LJApp

    User["Data Scientist"] -->|creates| ISVC["InferenceService CR<br/>serving.kserve.io"]
    ODHMC["odh-model-controller<br/>hf-detector-template"] -->|provides| SR["ServingRuntime<br/>guardrails-detector-huggingface-runtime"]
    ISVC -->|uses| SR
    KServe["KServe controller"] -->|"watches, creates predictor"| ISVC
    KServe -->|"storage-initializer to /mnt/models"| HFDet
    RHODS["rhods-operator<br/>RELATED_IMAGE_..._HUGGINGFACE_RUNTIME_IMAGE"] -->|pins image| SR
    Dashboard["odh-dashboard"] -->|"UI deploy"| SR

    Judge -->|"OpenAI API HTTP/HTTPS"| JudgeLLM["Judge LLM<br/>VLLM_BASE_URL"]
    HFDet -->|CUDA| GPU["nvidia.com/gpu<br/>(optional)"]
    Prom["Prometheus<br/>user workload monitoring"] -->|"GET /metrics :8000"| HFApp

