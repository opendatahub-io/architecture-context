graph TB
    Operator["Operator / AI Coding Agent<br/>(workstation, user kubeconfig)"]

    subgraph Repo["llm-d-pd-utils (tooling only - no controller, CRD, or long-running service)"]
        direction TB
        subgraph Skills["Agentic Skills (SKILL.md)"]
            PreflightSkill["/llm-d-preflight-checks skill"]
            NetSkill["/llm-d-networking-tests skill"]
        end

        subgraph NetSuite["Networking test suite (uv run, matplotlib)"]
            RunTests["run-tests.sh / run-tests.py<br/>CLI entry point"]
            Common["run-tests-common.py<br/>kubectl exec / debug / SSH helpers"]
            Discovery["run-tests-discovery.py<br/>GPU/NIC topology"]
            Perftest["run-tests-perftest.py<br/>ib_*_bw/lat, port 18515+"]
            Iperf["run-tests-iperf3.py<br/>TCP/UDP, port 5201"]
            NCCL["run-tests-nccl-rccl.py<br/>mpirun + sshd 22"]
            Nixlbench["run-tests-nixlbench.py<br/>etcd 2379 + ASIO 12345"]
        end

        subgraph Legacy["Legacy NIXL benchmark"]
            BenchDeploy["benchmark_deployment.sh<br/>oc apply"]
            BenchPy["benchmark.py<br/>NIXL READ/WRITE, ZMQ 5555"]
            Manifests["deployment/nixl_*.yaml<br/>Pods + NodePort Service"]
            Dockerfile["Dockerfile<br/>CUDA 12.5.1 / Ubuntu 24.04<br/>MOFED, gdrcopy, UCX 1.18.0, NIXL 0.1.1"]
            Installers["installers/install_nixl*.sh"]
        end

        PreflightScript["llm-d-preflight-checks.py<br/>stdlib Python, in-pod"]
    end

    subgraph Cluster["OpenShift / Kubernetes cluster"]
        K8sAPI["Kubernetes API server<br/>6443/TCP"]
        CM["ConfigMap<br/>llm-d-preflight-checks"]
        subgraph ModelPod["llm-d model-server pod (llm-d.ai/model)"]
            PreflightGate["Preflight gate<br/>HTTP 8000 /health /info /exit"]
            VLLM["vllm serve<br/>(starts after &&)"]
        end
        NixlPods["nixl-server / nixl-client Pods<br/>Service nixl-server NodePort 30002"]
    end

    Operator -->|invokes| PreflightSkill
    Operator -->|invokes| NetSkill
    PreflightSkill -->|kubectl create configmap| CM
    PreflightSkill -->|kustomize patch modelserver| K8sAPI
    NetSkill -->|drives| RunTests
    RunTests --> Common
    RunTests --> Discovery
    RunTests --> Perftest
    RunTests --> Iperf
    RunTests --> NCCL
    RunTests --> Nixlbench
    Common -->|kubectl get/exec/debug| K8sAPI
    K8sAPI -->|exec streams| ModelPod
    CM -->|mounted at /preflight| PreflightGate
    PreflightScript -.->|packaged into| CM
    PreflightGate -->|/exit releases gate| VLLM
    RunTests -->|"--unpause / --preflight-info<br/>(kubectl exec curl localhost)"| PreflightGate

    BenchDeploy -->|oc apply| Manifests
    Manifests -->|creates| NixlPods
    BenchPy -.->|runs in| NixlPods
    Dockerfile -.->|builds image for| NixlPods

    style PreflightSkill fill:#4a90e2,color:#fff
    style NetSkill fill:#4a90e2,color:#fff
    style RunTests fill:#4a90e2,color:#fff
    style Common fill:#4a90e2,color:#fff
    style Discovery fill:#4a90e2,color:#fff
