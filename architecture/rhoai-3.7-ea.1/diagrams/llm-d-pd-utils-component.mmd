    style BenchPy fill:#9fb7d9
    style Manifests fill:#9fb7d9
    style Dockerfile fill:#9fb7d9
    style Installers fill:#9fb7d9
    style CM fill:#f5a623
    style PreflightGate fill:#e74c3c,color:#fff
    style VLLM fill:#7ed321
    style NixlPods fill:#f5a623
    style K8sAPI fill:#e8e8e8
