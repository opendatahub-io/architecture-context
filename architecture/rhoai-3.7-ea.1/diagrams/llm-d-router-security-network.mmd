graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client[Client]
    end

    subgraph Ingress["INGRESS - Shared Gateway"]
        Gateway["Gateway API impl. Istio/OSSM Envoy<br/>443/TCP HTTPS<br/>Platform auth at gateway<br/>HTTPRoute to InferencePool"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy shipped)"]
        direction TB
        subgraph NS_Pool["Namespace: pool / release namespace"]
            EPP["EPP<br/>SA: release name<br/>9002/TCP ext-proc TLS 1.2+ self-signed default<br/>9003/TCP gRPC health, no TLS<br/>9090/TCP metrics TokenReview+SAR<br/>5557/TCP ZMQ"]
            Sidecar["pd-sidecar<br/>8000/TCP HTTPS TLS 1.2+<br/>No auth, SSRF allowlist off by default"]
            Decoder["Local decoder model server<br/>8200/TCP HTTP localhost"]
            ModelPods["Model server pods vLLM/SGLang<br/>target port e.g. 8000<br/>5557/TCP KV events"]
            Coordinator["coordinator<br/>8080/TCP HTTPS TLS 1.2+<br/>No auth<br/>9090/TCP metrics"]
            Predictor["Latency predictor servers<br/>HTTP, no auth (optional)"]
        end
        Prometheus["Prometheus<br/>SA token Secret"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL / SHARED SERVICES"]
        Redis["Redis llm-d-async<br/>6379/TCP RESP<br/>redis:// plaintext or rediss:// TLS"]
        OTel["OpenTelemetry Collector<br/>4317/TCP OTLP"]
    end

    Client -->|HTTPS/443<br/>TLS gateway<br/>Platform auth| Gateway
    Gateway -->|gRPC/9002<br/>TLS SIMPLE insecureSkipVerify<br/>optional mTLS| EPP
    Gateway -->|HTTP or HTTPS/8000<br/>per deployment<br/>no auth| ModelPods
    Gateway -->|HTTPS/8000<br/>TLS 1.2+<br/>no auth| Sidecar
    Sidecar -->|HTTP or HTTPS/pod port<br/>optional TLS, may skip verify| ModelPods
    Sidecar -->|HTTP/8200<br/>localhost plaintext| Decoder
    ModelPods -.->|TCP RDMA/8998, 14579<br/>KV transfer, unencrypted| Decoder
    EPP -->|HTTP/target port<br/>plaintext metrics scrape| ModelPods
    ModelPods -->|ZMQ/5557<br/>plaintext, optional| EPP
    EPP -.->|HTTP<br/>plaintext, optional| Predictor
    EPP -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| K8sAPI
    Sidecar -.->|HTTPS/6443<br/>SA token, SSRF allowlist| K8sAPI
    Prometheus -->|HTTP or HTTPS/9090<br/>Bearer token TokenReview+SAR| EPP
    Client -.->|HTTPS/8080<br/>TLS 1.2+, no auth| Coordinator
    Coordinator -->|HTTP/80<br/>plaintext default| Gateway
    Coordinator -.->|RESP/6379<br/>URL credentials| Redis
    EPP -.->|OTLP/4317<br/>per OTEL env| OTel

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class EPP,Sidecar,Decoder,ModelPods,Coordinator,Predictor,Prometheus internal
    class K8sAPI controlplane
    class Redis,OTel externalservice
