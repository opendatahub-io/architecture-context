graph LR
    PDU["llm-d-pd-utils<br/>(Agentic Skills + test tooling)"]

    %% Required tooling
    PDU -->|"pod discovery, exec, apply"| Kubectl["kubectl / oc"]
    PDU -->|"runs run-tests.py (PEP 723)"| UV["uv"]
    PDU -->|"result plots"| Matplotlib["matplotlib >=3.7"]

    %% Benchmark image stack
    PDU -->|"benchmark image base"| CUDA["NVIDIA CUDA base<br/>12.5.1-devel-ubuntu24.04"]
    PDU -->|"libibverbs, rdmacm"| MOFED["MLNX OFED libs<br/>24.10-1.1.4.0"]
    PDU -->|"GPUDirect RDMA copy"| Gdrcopy["gdrcopy<br/>master / 2.5"]
    PDU -->|"transport"| UCX["UCX v1.18.0"]
    PDU -->|"library under test"| NIXL["NIXL (ai-dynamo)<br/>0.1.1 / source HEAD"]
    PDU -->|"benchmark.py"| Torch["PyTorch, pyzmq, numpy<br/>(unpinned)"]
    PDU -.->|"profiling (optional)"| Nsight["Nsight Systems CLI<br/>2025.1.1"]

    %% Optional --install-deps tools
    PDU -.->|"RDMA BW/latency"| Perftest["perftest (linux-rdma)"]
    PDU -.->|"TCP/UDP"| Iperf3["iperf3"]
    PDU -.->|"collectives"| NCCLTests["nccl-tests, OpenMPI, openssh"]
    PDU -.->|"nixlbench rendezvous"| Etcd["etcd v3.5.21"]
    PDU -.->|"nixlbench build"| GRPC["protobuf v21.12 / gRPC v1.46.7<br/>etcd-cpp-apiv3"]

    %% Cluster-provided
    PDU -->|"secondary RoCE NICs"| Multus["Multus CNI<br/>multi-nic-network"]
    PDU -->|"nvidia.com/gpu, roce_gdr"| NvOps["NVIDIA GPU &<br/>Network Operators"]
    PDU -->|"HTTPS/6443"| K8sAPI["Kubernetes API server"]

    %% Internal platform
    PDU -->|"preflight injection + network tests"| ModelServer["llm-d vLLM model-server pods<br/>(llm-d.ai/model)"]
    PDU -->|"kustomize *-preflight overlay"| Guides["llm-d deployment guides<br/>(quickstart, pd-disaggregation,<br/>llm-d-benchmark)"]
    PDU -->|"benchmark subject"| NixlConn["vLLM NIXL KV connector<br/>(P/D disaggregation)"]
    PDU -.->|"prerequisite"| GIE["Gateway API Inference<br/>Extension CRDs"]

    %% Integration points (consumers)
    Agent["AI coding agents<br/>(Claude Code)"] -->|"Agentic Skills SKILL.md"| PDU
    Operator["llm-d operator / SRE"] -->|"CLI"| PDU

    %% External services
    PDU -->|"--install-deps downloads HTTPS/443"| GitHub["GitHub / PyPI /<br/>distro mirrors"]
    PDU -->|"release image"| GHCR["ghcr.io/llm-d"]

