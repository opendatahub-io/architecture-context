graph TB
    User["User / maas-controller"] -->|creates| EPCR["ExternalProvider CR<br/>inference.opendatahub.io/v1alpha1"]
    User -->|creates| EMCR["ExternalModel CR<br/>inference.opendatahub.io/v1alpha1"]
    User -->|creates| ProvSecret["Provider Secret<br/>label inference.llm-d.ai/ipp-managed=true"]
    LegacyCR["Legacy ExternalModel CR<br/>maas.opendatahub.io/v1alpha1"]

    subgraph IPP["ai-gateway-payload-processing (/bbr, single ctrl.Manager)"]
        direction TB

        subgraph DataPlane["Data plane (runs on every replica)"]
            ExtProc["ext-proc gRPC server<br/>9004/TCP, TLS self-signed"]
            DynMeta["dynamicmetadata wrapper<br/>(hub mode subset hints)"]
            Health["gRPC health server<br/>9005/TCP"]

            subgraph Chain["IPP plugin chain (default profile)"]
                direction TB
                P1["1. maas-headers-guard"]
                P2["2. body-field-to-header<br/>model → X-Gateway-Model-Name"]
                P3["3. model-provider-resolver<br/>weighted selection, loop 403"]
                P4["4. stream-usage-enforcer"]
                P5["5. api-translation<br/>OpenAI ↔ Anthropic / Vertex / Bedrock / Azure"]
                P6["6. apikey-injection<br/>API key / SigV4 / GCP OAuth2"]
                P1 --> P2 --> P3 --> P4 --> P5 --> P6
            end

            Optional["Optional plugins:<br/>external-metering, nemo guards,<br/>passthrough-profile-picker"]

            ExtProc --> DynMeta
            ExtProc --> Chain
            ExtProc -.-> Optional
        end

        subgraph ControlPlane["Control plane (controllers, no leader election configured)"]
            EPCtrl["ExternalProvider controller"]
            EMCtrl["ExternalModel controller"]
            LMCtrl["legacy-migration controller<br/>(only if legacy CRD exists)"]
        end

        Stores["In-memory stores<br/>models / providers / credentials"]
        Metrics["Metrics + pprof<br/>9090/TCP"]

        P3 -->|reads| Stores
        P6 -->|reads| Stores
    end

    EPCR -->|watched by| EPCtrl
    EMCR -->|watched by| EMCtrl
    LegacyCR -->|watched by| LMCtrl
    LMCtrl -->|creates| EPCR
    LMCtrl -->|creates| EMCR
    EPCR -->|informer| Stores
    EMCR -->|informer| Stores
    ProvSecret -->|label-filtered informer| Stores

    EPCtrl -->|creates| ExtNameSvc["Service (ExternalName)<br/>→ provider FQDN"]
    EPCtrl -->|creates| SE["Istio ServiceEntry<br/>MESH_EXTERNAL"]
    EPCtrl -->|creates| DR["Istio DestinationRule<br/>TLS origination SIMPLE"]
    EPCtrl -->|validates| ProvSecret
    EMCtrl -->|creates| Route["HTTPRoute<br/>parent maas-default-gateway"]

    Gateway["MaaS Gateway (Envoy)<br/>maas-default-gateway"] -->|ext_proc callout| ExtProc
    Route -->|attached to| Gateway
    Route -->|backendRef| ExtNameSvc

    AGC["ai-gateway-controller (AGC / Praxis)"] -.->|ownership hand-off<br/>finalizers, gatewayRefs| EMCR
    AGC -.->|finalizer claim| EPCR

    style ExtProc fill:#4a90e2
    style DynMeta fill:#4a90e2
    style Health fill:#4a90e2
    style EPCtrl fill:#4a90e2
    style EMCtrl fill:#4a90e2
    style LMCtrl fill:#4a90e2
    style Stores fill:#4a90e2
    style Metrics fill:#4a90e2
    style EPCR fill:#f5a623
    style EMCR fill:#f5a623
    style LegacyCR fill:#f5a623
    style ProvSecret fill:#f5a623
    style ExtNameSvc fill:#e8e8e8
    style SE fill:#e8e8e8
    style DR fill:#e8e8e8
    style Route fill:#e8e8e8
    style Gateway fill:#7ed321
    style AGC fill:#7ed321
