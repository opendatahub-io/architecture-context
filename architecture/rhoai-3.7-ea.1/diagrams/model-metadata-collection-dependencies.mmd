graph LR
    MMC["model-metadata-collection<br/>(data image + offline CLIs)"]

    %% Go libraries
    MMC -->|OCI access| CImage["containers/image v5.36.1"]
    MMC -->|ref parsing| DistRef["distribution/reference v0.6.0"]
    MMC -->|schema validation| KinOpenAPI["kin-openapi v0.149.0"]
    MMC -->|version ordering| Semver["Masterminds/semver v3.5.0"]
    MMC -->|layer decompression| XZ["ulikunitz/xz v0.5.14"]
    MMC -->|name normalization| XText["golang.org/x/text v0.28.0"]
    MMC -->|catalog I/O| YAML["gopkg.in/yaml.v3 v3.0.1"]

    %% Subprocess tools
    MMC -->|image extract| Skopeo["skopeo v1.22.0"]
    MMC -->|render templates| Kustomize["kustomize v5.8.1"]
    MMC -->|SBOM attestations| Cosign["cosign v3.0.5"]

    %% Base image
    MMC -->|runtime base| UBI["ubi9/ubi-minimal-pqc<br/>digest-pinned"]

    %% External SaaS (build time)
    MMC -.->|discovery, enrichment| HF["HuggingFace Hub"]
    MMC -.->|agent metadata| GH["GitHub API / raw"]
    MMC -->|ModelCar, MCP, controller images| RHReg["registry.redhat.io"]

    %% Internal platform
    MR["model-registry<br/>catalog service"] -->|"mounts /app/data (inferred)"| MMC
    Operator["rhods-operator /<br/>model-registry-operator"] -.->|"deploys, configures paths (inferred)"| MMC
    MMC -->|template source build-time| KServe["KServe controller images<br/>(llmisvc, runtimes)"]
    MMC -->|modelcard source build-time| ModelCar["Red Hat AI ModelCar images<br/>rhelai1/*"]
    Dashboard["odh-dashboard"] -.->|"indirect: runtime labels"| MMC
    MMC -->|CI pipeline| Konflux["konflux-central<br/>multi-arch-container-build"]

