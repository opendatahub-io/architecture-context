graph TD
    subgraph SAs["Service Accounts"]
        CtrlSA["modelservice SA<br/>release ns"]
        EppSA["model-epp-sa<br/>per ModelService"]
        ScrapeSA["SA-epp-metrics-scrape"]
        GrafSA["grafana-sa / grafana-sa-token<br/>llm-d-observability"]
        Users["Users"]
    end

    subgraph Bindings["Bindings"]
        CRB_M["CRB manager"]
        CRB_E["CRB endpoint-picker"]
        CRB_A["CRB metrics-auth"]
        RB_LE["RoleBinding leader-election<br/>release ns"]
        RB_EPP["EPP RoleBinding<br/>controller-generated, ModelService ns"]
        CRB_S["CRB epp-metrics-scrape"]
        CRB_G["CRBs view, cluster-monitoring-view,<br/>openshift-cluster-monitoring-view,<br/>grafana-prometheus-reader"]
    end

    subgraph Roles["Roles"]
        Manager["ClusterRole fullname-manager"]
        EPPRole["ClusterRole fullname-endpoint-picker"]
        MetricsAuth["ClusterRole fullname-metrics-auth"]
        LE["Role leader-election<br/>services, events, leases"]
        Scrape["ClusterRole fullname-epp-metrics-scrape"]
        UserRoles["ClusterRoles admin / editor / viewer<br/>llm-d.ai modelservices"]
        GrafRoles["view, cluster-monitoring-view,<br/>grafana-prometheus-reader"]
    end

    subgraph Resources["API Resources"]
        R_Core["core<br/>configmaps, serviceaccounts, services"]
        R_Pods["core<br/>pods"]
        R_Deploy["apps<br/>deployments, deployments/scale"]
        R_ES["discovery.k8s.io<br/>endpointslices"]
        R_HR["gateway.networking.k8s.io<br/>httproutes"]
        R_Inf["inference.networking.x-k8s.io<br/>inferencepools, inferencemodels"]
        R_MS["llm-d.ai<br/>modelservices, /status, /finalizers"]
        R_RB["rbac.authorization.k8s.io<br/>rolebindings"]
        R_Auth["authentication / authorization<br/>tokenreviews, subjectaccessreviews"]
        R_Metrics["nonResourceURL /metrics"]
        R_Prom["monitoring<br/>prometheuses, cluster read"]
    end

    CtrlSA -->|bound via| CRB_M
    CtrlSA -->|bound via| CRB_E
    CtrlSA -->|bound via| CRB_A
    CtrlSA -->|bound via| RB_LE
    EppSA -->|bound via| RB_EPP
    EppSA -->|bound via| CRB_S
    ScrapeSA -->|bound via| CRB_S
    GrafSA -->|bound via| CRB_G
    Users -->|granted| UserRoles

    CRB_M -->|grants| Manager
    CRB_E -->|grants| EPPRole
    RB_EPP -->|grants| EPPRole
    CRB_A -->|grants| MetricsAuth
    RB_LE -->|grants| LE
    CRB_S -->|grants| Scrape
    CRB_G -->|grants| GrafRoles

    Manager -->|create,delete,get,list,patch,update,watch| R_Core
    Manager -->|get,list,watch| R_Pods
    Manager -->|create,delete,get,list,patch,update,watch| R_Deploy
    Manager -->|get,list,watch| R_ES
    Manager -->|create,delete,get,list,patch,update,watch| R_HR
    Manager -->|create,delete,get,list,patch,update,watch| R_Inf
    Manager -->|CRUD + status, finalizers| R_MS
    Manager -->|create,delete,get,list,patch,update,watch<br/>ESCALATION RISK| R_RB

    EPPRole -->|get,watch,list| R_Inf
    EPPRole -->|get,watch,list| R_Pods
    EPPRole -->|get,watch,list| R_ES
    EPPRole -->|create| R_Auth
    MetricsAuth -->|create| R_Auth
    Scrape -->|get,watch,list| R_Pods
    Scrape -->|create| R_Auth
    Scrape -->|get| R_Metrics
    UserRoles -->|admin *, editor CRUD, viewer read| R_MS
    GrafRoles -->|get,list,watch| R_Prom

