graph TD
    subgraph SAs["Service Accounts / Subjects"]
        OpSA["redhat-ods-operator/<br/>redhat-ods-operator-controller-manager"]
        KapSA["openshift-ingress/<br/>kube-auth-proxy"]
        ArgoSA["argo/argo"]
        PromSA["redhat-ods-monitoring/<br/>data-science-monitoringstack-prometheus"]
        AdminGrp["Groups: Auth.spec.adminGroups"]
        AllowedGrp["Groups: Auth.spec.allowedGroups"]
    end

    subgraph Bindings["Bindings"]
        OpCRB["CRB rhods-operator-rolebinding"]
        KapCRB["CRB kube-auth-proxy-tokenreview"]
        ArgoCRB["CRB ds-pipeline-argo-binding"]
        ArgoRB["RB argo-binding (ns argo)"]
        PromRB["RB data-science-pipelines-operator-rhoai-prometheus<br/>(ns redhat-ods-monitoring)"]
        AdminCRB["CRB data-science-admingroupcluster-rolebinding"]
        AdminRB["RB data-science-admingroup-rolebinding<br/>(ns redhat-ods-applications)"]
        AdminMaaS["RB admingroup-maas / admingroup-kuadrant<br/>(models-as-a-service, kuadrant-system, if present)"]
        AllowedCRB["CRB data-science-allowedgroupcluster-rolebinding"]
    end

    subgraph Roles["Roles"]
        OpRole["ClusterRole rhods-operator-role<br/>(315 kubebuilder markers, near cluster-admin)"]
        AuthDel["ClusterRole system:auth-delegator"]
        ArgoCR["ClusterRole argo-cluster-role"]
        ArgoR["Role argo-role"]
        MetricsReader["Role data-science-pipelines-operator-metrics-reader"]
        AdminCR["ClusterRole data-science-admingroupcluster-role"]
        AdminR["Role data-science-admingroup-role"]
        AllowedCR["ClusterRole data-science-allowedgroupcluster-role"]
        MR["ClusterRole metrics-reader"]
    end

    subgraph Resources["API Resources"]
        Wild["* (any group)<br/>services, deployments, statefulsets"]
        WildRS["* (any group)<br/>replicasets"]
        Broad["core, apps, rbac, apiextensions, admissionregistration,<br/>route.openshift.io, gateway.networking.k8s.io, networking.istio.io,<br/>oauth.openshift.io, monitoring.coreos.com, *.opendatahub.io<br/>namespaces, secrets, configmaps, CRDs, roles/bindings,<br/>webhooks, routes, gateways, envoyfilters, oauthclients, monitors"]
        TR["authentication.k8s.io tokenreviews<br/>authorization.k8s.io subjectaccessreviews"]
        ArgoRes["core + argoproj.io<br/>pods, pods/exec, configmaps, namespaces, workflows"]
        PlatCR["services.platform.opendatahub.io auths<br/>datasciencecluster / dscinitialization"]
        AuthsRO["services.platform.opendatahub.io<br/>auths, auths/status"]
        MetricsURL["nonResourceURL /metrics"]
    end

    OpSA -->|bound via| OpCRB
    OpCRB -->|grants| OpRole
    OpRole -->|create,delete,get,list,patch,update,watch| Wild
    OpRole -->|get,list,watch| WildRS
    OpRole -->|full CRUD on most| Broad

    KapSA -->|bound via| KapCRB
    KapCRB -->|grants| AuthDel
    AuthDel -->|create| TR

    ArgoSA -->|bound via| ArgoCRB
    ArgoCRB -->|grants| ArgoCR
    ArgoCR -->|create,get,list,watch,update,patch,delete| ArgoRes
    ArgoSA -->|bound via| ArgoRB
    ArgoRB -->|grants| ArgoR

    PromSA -->|bound via| PromRB
    PromRB -->|grants| MetricsReader

    AdminGrp -->|bound via| AdminCRB
    AdminCRB -->|grants| AdminCR
    AdminCR -->|get,list,watch,patch| PlatCR
    AdminGrp -->|bound via| AdminRB
    AdminRB -->|grants| AdminR
    AdminGrp -->|bound via| AdminMaaS

    AllowedGrp -->|bound via| AllowedCRB
    AllowedCRB -->|grants| AllowedCR
    AllowedCR -->|get,list,watch| AuthsRO

    MR -->|get| MetricsURL

    style OpSA fill:#4a90e2,color:#fff
    style KapSA fill:#4a90e2,color:#fff
    style ArgoSA fill:#4a90e2,color:#fff
    style PromSA fill:#4a90e2,color:#fff
    style AdminGrp fill:#4a90e2,color:#fff
    style AllowedGrp fill:#4a90e2,color:#fff
    style OpRole fill:#f8cecc,stroke:#b85450,stroke-width:3px
    style AuthDel fill:#f5a623
    style ArgoCR fill:#f5a623
    style ArgoR fill:#f5a623
    style MetricsReader fill:#f5a623
    style AdminCR fill:#f5a623
    style AdminR fill:#f5a623
    style AllowedCR fill:#f5a623
    style MR fill:#f5a623
    style Wild fill:#f8cecc
    style WildRS fill:#7ed321
    style Broad fill:#f8cecc
    style TR fill:#7ed321
    style ArgoRes fill:#7ed321
    style PlatCR fill:#7ed321
    style AuthsRO fill:#7ed321
    style MetricsURL fill:#7ed321
