graph TB
    User["User / Data Scientist"]
    Dashboard["ODH Dashboard"]
    RHODS["rhods-operator<br/>(Workbenches component)"]

    subgraph CtrlNS["Controller namespace (applications ns)"]
        subgraph KF["odh-kf-notebook-controller (upstream Kubeflow)"]
            NBRec["NotebookReconciler<br/>Notebook → StatefulSet + Service"]
            Culler["CullingReconciler<br/>(optional, ENABLE_CULLING)"]
            KFTLS["TLS profile watcher<br/>exits on profile change"]
            KFMetrics["Metrics :8443 HTTPS<br/>Probes :8081"]
        end

        subgraph ODH["odh-notebook-controller (RHOAI extension)"]
            MutWH["Mutating webhook<br/>/mutate-notebook-v1 :8443"]
            ValWH["Validating webhook<br/>/validate-notebook-v1 :8443"]
            OSRec["OpenshiftNotebookReconciler"]
            SPW["SecurityProfileWatcher<br/>(TLS profile + adherence)"]
            ODHMetrics["Metrics :8080 HTTPS<br/>Probes :8081"]
        end

        Common["components/common<br/>reconcilehelper library"]
        HTTPRoute["HTTPRoute per notebook<br/>/notebook/&lt;ns&gt;/&lt;name&gt;"]
        ImageStreams["ImageStreams<br/>(workbench images)"]
        Config["odh-notebook-controller-config<br/>(ingresses list)"]
    end

    NotebookCR["Notebook CR<br/>kubeflow.org/v1"]

    subgraph UserNS["User namespace (Data Science Project)"]
        STS["StatefulSet<br/>(1 replica, :8888)"]
        Svc["Service &lt;nb&gt;<br/>80 → 8888 HTTP"]
        KRPSvc["Service &lt;nb&gt;-kube-rbac-proxy<br/>8443 HTTPS"]
        Pod["Notebook Pod<br/>Jupyter/IDE :8888<br/>+ kube-rbac-proxy sidecar :8443/:8444"]
        RefGrant["ReferenceGrant<br/>notebook-httproute-access"]
        NetPol["NetworkPolicies<br/>-ctrl-np, kube-rbac-proxy, -egress-np"]
        SAObj["ServiceAccount &lt;nb&gt;"]
        CMs["ConfigMaps<br/>workbench-trusted-ca-bundle,<br/>pipeline-runtime-images,<br/>kube-rbac-proxy config"]
        DSPSecret["Secret ds-pipeline-config"]
        RBs["RoleBindings<br/>elyra-pipelines-&lt;nb&gt;, &lt;nb&gt;-mlflow"]
    end

    CRB["ClusterRoleBinding<br/>&lt;nb&gt;-rbac-&lt;ns&gt;-auth-delegator"]

    Gateway["data-science-gateway<br/>(openshift-ingress)"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    ServiceCA["OpenShift service-ca"]
    DSPO["data-science-pipelines-operator<br/>(DSPA CR)"]
    MLflow["MLflow operator"]
    Feast["Feast operator<br/>&lt;nb&gt;-feast-config"]
    OSConfig["config.openshift.io<br/>APIServer / Proxy"]
    Monitoring["OpenShift monitoring"]

    RHODS -->|deploys rhoai overlay| KF
    RHODS -->|deploys rhoai overlay| ODH
    User -->|uses| Dashboard
    Dashboard -->|creates| NotebookCR
    NotebookCR -->|admission CREATE/UPDATE| MutWH
    NotebookCR -->|admission CREATE/UPDATE| ValWH
    NotebookCR -->|watched by| NBRec
    NotebookCR -->|watched by| OSRec
    MutWH -->|reconciliation lock| NBRec
    MutWH -->|resolves images| ImageStreams
    NBRec -->|creates| STS
    NBRec -->|creates| Svc
    STS --> Pod
    Culler -->|"HTTP :80 /api/kernels"| Svc
    OSRec -->|creates| HTTPRoute
    OSRec -->|creates| RefGrant
    OSRec -->|creates| KRPSvc
    OSRec -->|creates| NetPol
    OSRec -->|creates| SAObj
    OSRec -->|creates| CMs
    OSRec -->|creates| DSPSecret
    OSRec -->|creates| RBs
    OSRec -->|creates| CRB
    OSRec -->|reads| Config
    NBRec -.->|uses| Common
    OSRec -.->|uses| Common
    HTTPRoute -->|parentRef| Gateway
    HTTPRoute -->|backend via ReferenceGrant| KRPSvc
    HTTPRoute -.->|backend when auth disabled| Svc
    KRPSvc --> Pod

    OSRec -->|reads DSPA| DSPO
    RBs -->|binds| MLflow
    MutWH -->|mounts config| Feast
    KFTLS -->|watches| OSConfig
    SPW -->|watches| OSConfig
    ServiceCA -->|serving certs| MutWH
    ServiceCA -->|serving certs| KRPSvc
    Monitoring -->|scrapes| KFMetrics
    Monitoring -->|scrapes| ODHMetrics
    KF -->|SA token| K8sAPI
    ODH -->|SA token| K8sAPI

