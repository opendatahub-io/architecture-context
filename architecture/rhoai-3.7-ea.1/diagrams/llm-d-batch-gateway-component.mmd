graph TB
    User["API Client<br/>(OpenAI SDK / curl)"]

    subgraph Platform["Platform Gateway (Gateway API + Kuadrant)"]
        ExtGW["External Gateway<br/>HTTPRoute batch-route<br/>AuthPolicy TokenReview + RateLimitPolicy"]
        IntGW["Internal Gateway (ClusterIP)<br/>HTTPRoute batch-llm-route<br/>AuthPolicy SAR on inferencepools"]
    end

    subgraph BG["llm-d-batch-gateway (Helm chart batch-gateway)"]
        direction TB
        API["batch-gateway-apiserver<br/>Deployment<br/>:8000 API / :8081 observability"]
        Proc["batch-gateway-processor<br/>StatefulSet + headless Service<br/>:9090 observability"]
        GC["batch-gateway-gc<br/>Deployment, 1 replica<br/>:9091 metrics"]

        subgraph Libs["Shared Go libraries"]
            DataLayer["Data layer<br/>internal/database, internal/files_store<br/>retry + tracing decorators"]
            InfClient["Inference clients<br/>Resty HTTP + llm-d-async producer<br/>AIMD semaphores"]
        end

        WorkDir[("emptyDir workDir<br/>plans + result checkpoints")]
    end

    subgraph Data["Coordination and storage plane"]
        PG[("PostgreSQL<br/>batch_items, file_items<br/>priority queue, events, LISTEN/NOTIFY")]
        Store[("S3-compatible storage<br/>or filesystem/PVC<br/>t-sha256 tenant prefixes")]
        Redis[("Redis/Valkey<br/>sorted sets<br/>async mode only")]
    end

    Async["llm-d-async dispatcher"]
    Sched["llm-d inference scheduler<br/>vLLM pods"]
    K8s["Kubernetes API"]

    User -->|"HTTPS /v1/files, /v1/batches"| ExtGW
    ExtGW -->|"HTTP :8000 + X-MaaS-Username"| API
    API -->|"metadata, enqueue, cancel event"| PG
    API -->|"upload / download files"| Store

    Proc -->|"dequeue, lease, status, LISTEN cancel"| PG
    Proc -->|"input / output / error files"| Store
    Proc -->|"writes plans"| WorkDir
    Proc -->|"sync: POST inference + replayed Bearer"| IntGW
    Proc -.->|"async: push requests"| Redis
    Redis -.->|"consumed by"| Async
    Async -.->|"inference + Bearer"| IntGW
    IntGW --> Sched

    GC -->|"watch StatefulSet / pods"| K8s
    GC -->|"expire rows, reclaim orphans"| PG
    GC -->|"delete expired objects"| Store

    API -.->|uses| DataLayer
    Proc -.->|uses| DataLayer
    GC -.->|uses| DataLayer
    Proc -.->|uses| InfClient

    style API fill:#4a90e2,color:#fff
    style Proc fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
