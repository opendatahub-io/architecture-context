graph TD
    subgraph Repo["vllm-gaudi repository"]
        None["No ClusterRoles, Roles, RoleBindings<br/>or ServiceAccounts defined"]
    end

    subgraph Pod["Model server pod (deployed by KServe)"]
        SA["ServiceAccount<br/>supplied by deployer"]
        API["vLLM API server<br/>8000/TCP"]
        SA -.->|no Kubernetes API calls| K8s["Kubernetes API<br/>(not accessed)"]
    end

    subgraph AppAuth["Application-level access control"]
        Default["Default: unauthenticated<br/>/v1/*, /health, /metrics"]
        APIKey["Optional: vLLM --api-key<br/>Bearer token on /v1/*"]
        Platform["Platform: KServe / gateway<br/>auth and NetworkPolicy"]
    end

    Client["Client"] -->|enforced by| Platform
    Platform -->|forwards| API
    API -->|default| Default
    API -->|if configured| APIKey

    style None fill:#e8e8e8
    style SA fill:#4a90e2
    style API fill:#4a90e2
    style K8s fill:#e8e8e8,stroke-dasharray: 5 5
    style Default fill:#f8cecc
    style APIKey fill:#f5a623
    style Platform fill:#7ed321
