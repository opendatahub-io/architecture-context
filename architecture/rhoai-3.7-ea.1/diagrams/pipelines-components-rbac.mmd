graph TD
    Note["No RBAC manifests in this repo.<br/>Permissions are granted outside the repo<br/>(DSPO / user / namespace admin)"]

    subgraph Identities["Task pod identities (tenant namespace)"]
        RunnerSA["DSP pipeline runner<br/>ServiceAccount"]
        UserToken["kubernetes-credentials secret<br/>KUBERNETES_AUTH_TOKEN<br/>(user-supplied, scope unknown)"]
    end

    subgraph Grants["Namespace RBAC (defined externally)"]
        ExtRole["Role / RoleBinding<br/>not in this repo"]
    end

    subgraph Resources["API Resources required by components"]
        ISVC["serving.kserve.io<br/>InferenceService v1beta1"]
        SR["serving.kserve.io<br/>ServingRuntime v1alpha1"]
        HWP["infrastructure.opendatahub.io<br/>HardwareProfile"]
        TrainerJobs["Kubeflow Trainer<br/>jobs (TrainerClient)"]
        Ray["ray.io<br/>Ray resources"]
    end

    subgraph StarterKit["agentic-rag starter kit (template)"]
        Reviewer["K8S_REVIEWER_TOKEN identity"]
        TR["authentication.k8s.io<br/>TokenReview"]
        Caller["Caller ServiceAccount<br/>optional ALLOWED_SA_USERNAME match"]
    end

    RunnerSA -->|bound via| ExtRole
    UserToken -->|bound via| ExtRole
    ExtRole -->|CRUD, verbs inferred| ISVC
    ExtRole -->|CRUD, verbs inferred| SR
    ExtRole -->|read| HWP
    ExtRole -->|submit jobs, verbs inferred| TrainerJobs
    ExtRole -->|verbs inferred| Ray

    Reviewer -->|create| TR
    Caller -->|Bearer / x-api-key validated by| TR

    style Note fill:#fff2cc,stroke:#d6b656
    style RunnerSA fill:#4a90e2,color:#fff
    style UserToken fill:#f8cecc,stroke:#b85450
    style ExtRole fill:#f5a623,stroke-dasharray: 5 5
    style ISVC fill:#7ed321
    style SR fill:#7ed321
    style HWP fill:#7ed321
    style TrainerJobs fill:#7ed321
    style Ray fill:#7ed321
    style Reviewer fill:#4a90e2,color:#fff
    style TR fill:#7ed321
    style Caller fill:#e8e8e8
