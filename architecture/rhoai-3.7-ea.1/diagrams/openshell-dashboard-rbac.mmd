graph TD
    subgraph K8s["Kubernetes RBAC"]
        SA["ServiceAccount<br/>openshell-dashboard<br/>automountServiceAccountToken: false"]
        None["No ClusterRoles, Roles or Bindings<br/>(no Kubernetes API calls)"]
        SA -.->|no bindings| None
    end

    subgraph App["Application authorization (OpenShell gateway)"]
        Token["User access token (JWT)<br/>iss, aud=openshell-api, sub, roles"]
        AdminRole["Role: openshell-admin<br/>platform scope: gateway, global policy,<br/>settings, cross-workspace lists, profiles"]
        UserRole["Role: openshell-user"]
        Member["Workspace membership<br/>(keyed by sub; ADMIN member role)"]
        WS["Workspace resources<br/>sandboxes, templates, policies, drafts,<br/>providers, services, files, terminal"]
        Token --> AdminRole
        Token --> UserRole
        UserRole --> Member
        Member -->|authorizes| WS
        AdminRole -->|authorizes| WS
    end

    subgraph Enforcement["Enforcement points"]
        Proxy["oauth2-proxy<br/>optional allowed-role / allowed-group"]
        BFF["BFF auth.Middleware<br/>token presence only (401 if missing)"]
        GW["OpenShell gateway<br/>JWT validation + RBAC"]
        UIFlags["UI role checks + FEATURE_* flags<br/>visibility only, NOT access control"]
    end

    Proxy --> BFF --> GW
    GW --> Token
    UIFlags -.-> BFF

    style SA fill:#4a90e2,color:#fff
    style None fill:#e8e8e8
    style GW fill:#f5a623
    style AdminRole fill:#7ed321
    style UserRole fill:#7ed321
    style Member fill:#7ed321
    style UIFlags fill:#f9f9f9,stroke-dasharray: 5 5
