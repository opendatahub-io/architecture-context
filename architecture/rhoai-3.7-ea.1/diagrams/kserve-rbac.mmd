graph TD
    subgraph SAs["Service Accounts"]
        SA_Mod["kserve-module-controller-manager"]
        SA_K["kserve-controller-manager"]
        SA_L["llmisvc SA<br/>$(llmisvc-serviceAccountName)"]
        SA_LM["kserve-localmodel-controller-manager"]
        SA_LMA["kserve-localmodelnode-agent"]
        SA_KCA["kserve-kernelcachenode-agent<br/>(not built)"]
        SA_CoCo["coco-cc-storage"]
    end

    subgraph Bindings["Bindings"]
        B_Mod["kserve-module-manager-rolebinding<br/>ClusterRoleBinding"]
        B_K["kserve-manager-rolebinding<br/>ClusterRoleBinding"]
        B_KP["kserve-proxy-rolebinding<br/>ClusterRoleBinding"]
        B_L["llmisvc-manager-rolebinding<br/>ClusterRoleBinding"]
        B_LM["kserve-localmodel-manager-rolebinding<br/>ClusterRoleBinding"]
        B_KCNG["kserve-kernelcache-nodegroup-manager<br/>RoleBinding"]
        B_LMA["kserve-localmodelnode-agent-rolebinding<br/>RoleBinding"]
        B_KCA["kserve-kernelcachenode-agent-rolebinding<br/>RoleBinding"]
        B_CoCo["coco-cc-storage<br/>RoleBinding"]
        B_LE["leader-election RoleBindings<br/>kserve / llmisvc / localmodel / module"]
    end

    subgraph Roles["Roles"]
        R_Mod["kserve-module-manager-role<br/>47 rules, cluster-admin-equivalent"]
        R_K["kserve-manager-role"]
        R_KP["kserve-proxy-role"]
        R_L["kserve-llmisvc-manager-role"]
        R_LM["kserve-localmodel-manager-role"]
        R_KCNG["kserve-kernelcache-nodegroup-manager"]
        R_LMA["kserve-localmodelnode-agent-role"]
        R_KCA["kserve-kernelcachenode-agent-role"]
        R_CoCo["openshift-ai-llmisvc-confidential-bare-metal<br/>privileged SCC"]
        R_LE["leader-election Roles<br/>leases, configmaps, events"]
        R_MR["kserve-metrics-reader<br/>/metrics get"]
    end

    subgraph Res["API Resources"]
        Res_RBAC["rbac.authorization.k8s.io<br/>clusterroles, roles, bindings"]
        Res_SCC["security.openshift.io<br/>securitycontextconstraints"]
        Res_WH["admissionregistration.k8s.io<br/>mutating/validating webhookconfigs"]
        Res_CRD["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Res_Core["core: namespaces, nodes, configmaps,<br/>pvcs, pvs, SAs, services, secrets"]
        Res_Apps["apps: deployments, daemonsets<br/>batch: jobs"]
        Res_Cert["cert-manager.io<br/>certificates, issuers, clusterissuers"]
        Res_ModCR["components.platform.opendatahub.io<br/>kserves"]
        Res_Mon["monitoring, perses, kuadrant,<br/>nim, templates, networkpolicies"]
        Res_ModServing["serving.kserve.io<br/>clusterservingruntimes, clusterstoragecontainers,<br/>llminferenceserviceconfigs, localmodelnodegroups"]
        Res_RO["read-only: clusterversions, subscriptions,<br/>clusterextensions, hardwareprofiles,<br/>runtimeclasses, resourceslices, ..."]
        Res_ISVC["serving.kserve.io<br/>inferenceservices, inferencegraphs, trainedmodels,<br/>servingruntimes, clusterservingruntimes"]
        Res_Net["httproutes, ingresses, virtualservices,<br/>knative services, HPA, scaledobjects,<br/>opentelemetrycollectors"]
        Res_KCore["core: services, events<br/>configmaps create/get/update<br/>pods, namespaces read; secrets, SAs get"]
        Res_Auth["tokenreviews,<br/>subjectaccessreviews"]
        Res_LLM["serving.kserve.io<br/>llminferenceservices, llminferenceserviceconfigs"]
        Res_LLMNet["gateways, gatewayclasses, httproutes,<br/>inferencepools, inferenceobjectives, ..."]
        Res_LLMWork["deployments, HPA, scaledobjects,<br/>leaderworkersets, disaggregatedsets,<br/>resourceclaims"]
        Res_LLMCore["secrets, serviceaccounts, services<br/>roles, rolebindings, clusterrolebindings"]
        Res_LMC["localmodelcaches, localmodelnamespacecaches,<br/>localmodelnodes, pvcs, pvs, jobs"]
        Res_KC["kernelcachenodes/status,<br/>serviceaccounts/token"]
    end

    SA_Mod --> B_Mod --> R_Mod
    SA_K --> B_K --> R_K
    SA_K --> B_KP --> R_KP
    SA_L --> B_L --> R_L
