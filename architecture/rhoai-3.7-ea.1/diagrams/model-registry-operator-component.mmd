graph TB
    RHODS["rhods-operator<br/>(platform operator)"]
    User["User / Dashboard"]

    subgraph Image["model-registry-operator image: /manager (one binary, three operators)"]
        AIHubOp["aihub-controller-manager<br/>manager aihub<br/>8443 metrics / 8081 health"]
        MROp["model-registry-operator-controller-manager<br/>manager (modelregistry)<br/>9443 webhooks / 8443 metrics / 8081 health"]
        CatOp["catalog-controller-manager<br/>manager catalog<br/>9443 webhook / 8081 health"]
        Bundle["Embedded kustomize bundle<br/>/opt/manifests-template/modelregistry/overlays/odh"]
        SVM["SVM migration<br/>v1alpha1 to v1beta1"]
    end

    AIHubCR["AIHub CR<br/>components.platform.opendatahub.io/v1alpha1<br/>default-aihub (cluster)"]
    CatalogCR["Catalog CR<br/>aihub.opendatahub.io/v1alpha1<br/>catalog (singleton)"]
    MRCR["ModelRegistry CR<br/>modelregistry.opendatahub.io<br/>v1alpha1 / v1beta1 (storage)"]

    RHODS -->|"deploys overlays/aihub"| AIHubOp
    RHODS -->|"creates from DSC aiHub"| AIHubCR
    AIHubCR -->|"watched by"| AIHubOp
    AIHubOp -->|"renders"| Bundle
    Bundle -->|"SSA: CRDs, webhooks, RBAC, NetPols"| MROp
    Bundle -->|"SSA"| CatOp
    AIHubOp -->|"creates after catalog op Available"| CatalogCR
    AIHubOp -->|"creates"| InstNS["Instances namespace<br/>rhoai-model-registries"]
    AIHubOp -->|"applies"| Templates["jobs-async-upload<br/>OpenShift Templates"]
    AIHubOp -->|"AIHubReady status"| RHODS

    User -->|"creates"| MRCR
    MRCR -->|"watched by"| MROp
    CatalogCR -->|"watched by"| CatOp
    MROp --- SVM

    subgraph Registry["Per-registry workload (instances ns)"]
        RegDep["{registry-name} Deployment<br/>rest-container :8080<br/>kube-rbac-proxy :8443"]
        RegPG["{registry-name}-postgres<br/>PostgreSQL 16 (optional)"]
        RegRes["Service, SA, Role, Group,<br/>auth-delegator CRB, NetworkPolicies,<br/>Route (reencrypt), HTTPRoute, ReferenceGrant"]
    end

    subgraph Catalog["Shared catalog workload (instances ns)"]
        CatDep["model-catalog Deployment<br/>catalog :8080 + kube-rbac-proxy :8443<br/>init: data / benchmark / validation"]
        CatPG["model-catalog-postgres<br/>PVC-backed PostgreSQL 16"]
        IS["ImageStreams<br/>model-catalog-data:stable<br/>model-catalog-benchmark-data:stable"]
    end

    MROp -->|"creates"| RegDep
    MROp -->|"creates"| RegPG
    MROp -->|"creates"| RegRes
    CatOp -->|"creates"| CatDep
    CatOp -->|"creates"| CatPG
    CatOp -->|"manages"| IS
    RegDep -->|"5432"| RegPG
    RegDep -.->|"5432 / 3306"| ExtDB["User PostgreSQL / MySQL"]
    CatDep -->|"5432"| CatPG

    Gateway["data-science-gateway<br/>(openshift-ingress)"]
    Gateway -->|"/model-registry/{name}/"| RegDep
    Gateway -->|"/catalog/"| CatDep

    style AIHubOp fill:#4a90e2
    style MROp fill:#4a90e2
    style CatOp fill:#4a90e2
    style Bundle fill:#4a90e2
    style SVM fill:#4a90e2
    style AIHubCR fill:#f5a623
    style CatalogCR fill:#f5a623
    style MRCR fill:#f5a623
    style RHODS fill:#7ed321
    style Gateway fill:#7ed321
    style ExtDB fill:#e8e8e8
