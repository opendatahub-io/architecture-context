graph TB
    subgraph AP["llm-d-async Async Processor (Deployment, replicas: 1)"]
        Main["Main binary<br/>cmd/main.go → /llm-d-async"]
        Transport["Transport flows<br/>redis-pubsub (deprecated), redis-sortedset,<br/>gcp-pubsub, sql (experimental)"]
        Gates["Flow control / dispatch gates<br/>budget: prometheus-budget, prometheus-saturation, scrape<br/>admission: redis-quota, sql-quota, redis-leased-rate, tier-priority-admission"]
        Merge["Merge policies (plugins)<br/>random-robin, tier-priority<br/>fairness header stamp"]
        Worker["Async worker pools<br/>HTTP client, retry/backoff until deadline,<br/>body transforms: gcs_uri_multipart"]
        Health["Health server<br/>/healthz, /readyz :8081"]
        Metrics["Metrics server (controller-runtime)<br/>/metrics :9090<br/>optional TokenReview/SAR"]

        Main --> Transport
        Transport -->|per-queue admission| Gates
        Gates -->|admitted messages| Merge
        Merge -->|one channel per worker pool| Worker
        Worker -->|pool-level gates: Wait/Refuse/Drop| Gates
        Worker -->|results / DEADLINE_EXCEEDED| Transport
        Main --> Health
        Main --> Metrics
    end

    subgraph Libs["Go workspace libraries"]
        LibAPI["api / pipeline modules"]
        Producer["producer (Redis)"]
        ProducerSQL["producer-sql (Postgres + migrations)"]
    end

    subgraph Chart["Helm chart charts/llm-d-async v0.7.0"]
        SA[ServiceAccount]
        ConnSecret["Connection Secret<br/>(REDIS_URL / SQL_URL)"]
        CM["ConfigMap<br/>pools, merge policy, transforms"]
        PodMon["PodMonitor / PrometheusRule /<br/>Grafana dashboards"]
    end

    BatchGW["batch-gateway<br/>(/v1/batches)"] -->|uses| Producer
    BatchGW -->|uses| ProducerSQL
    Producer -->|enqueue| Redis[(Redis / Valkey)]
    ProducerSQL -->|enqueue| Postgres[(PostgreSQL)]

    Transport <-->|RESP 6379| Redis
    Transport <-->|Postgres 5432| Postgres
    Transport <-->|gRPC 443| PubSub[(GCP Pub/Sub)]

    Gates -->|PromQL| Prometheus[Prometheus]
    Gates -->|scrape /metrics| EPPMetrics[EPP / model-server metrics]
    Worker -->|"POST /v1/completions<br/>x-llm-d-inference-fairness-id<br/>x-llm-d-inference-objective"| IGW["llm-d-router / EPP<br/>Inference Gateway"]
    IGW --> VLLM[vLLM inference pool]

    PodMon -.->|scrape| Metrics
    ConnSecret -.->|env| Main
    CM -.->|mounted config files| Main
    SA -.->|identity| Main
    Main -->|OTLP gRPC 4317| OTLP[OTLP collector]
    Main -->|REST config / TokenReview, SAR| K8sAPI[Kubernetes API]

