graph LR
    GitOps["odh-gitops<br/>(Kustomize + Helm charts)"]

    %% Platform prerequisites
    GitOps -->|target platform| OCP["OpenShift 4.19.9+"]
    GitOps -->|Subscriptions| OLM["OLM catalogs<br/>redhat / certified / community"]
    GitOps -.->|GitOps sync| Argo["Argo CD / OpenShift GitOps"]

    %% Dependency operators installed via OLM (tri-state auto/true/false)
    subgraph DepOps["Dependency operators (enabled: auto)"]
        CertMgr["cert-manager<br/>stable-v1 / 1.18.1"]
        Kueue["Kueue<br/>stable-v1.5"]
        LWS["Leader Worker Set<br/>stable-v1.0"]
        JobSet["JobSet<br/>stable-v1.0"]
        RHCL["RHCL Kuadrant/Authorino<br/>stable / 1.3.0"]
        COO["Cluster Observability"]
        OTel["OpenTelemetry"]
        Tempo["Tempo"]
        Loki["Loki stable-6.5"]
        CMA["Custom Metrics Autoscaler"]
        NFD["Node Feature Discovery"]
        GPU["NVIDIA GPU Operator v25.10"]
        Sandbox["Agent Sandbox preview-0.9"]
        MariaDB["MariaDB v0.29"]
    end
    GitOps -->|installs| DepOps

    %% Transitive closure computed by shouldInstall
    GPU -.->|requires| NFD
    Kueue -.->|requires| CertMgr
    Tempo -.->|requires| OTel

    %% Internal RHOAI
    GitOps -->|"Subscription + DSCI/DSC"| RHODS["rhods-operator /<br/>opendatahub-operator"]
    GitOps -->|openshift-ai-inference Gateway| KServe["KServe"]
    GitOps -->|"maas-default-gateway + Praxis"| AIGW["AIGateway<br/>(MaaS, Batch, AI Grid)"]
    GitOps -->|DSCI spec.monitoring| Monitoring["Monitoring service"]
    GitOps -->|"DSC managementState"| Comps["Dashboard, Pipelines, Workbenches,<br/>Ray, Trainer, TrustyAI, Model Registry,<br/>Feature Store, MLflow, OGX, MCP, Spark"]
    GitOps -->|"Authorino CR + CA patch"| RHCL

    %% AI Grid / multi-cluster
    GitOps -->|"subcharts 0.3.0-rc.4"| Praxis["Praxis proxy / grid<br/>(third-party)"]
    GitOps -->|"Policy, Placement, ScrapeConfig"| ACM["Red Hat ACM"]
    GitOps -->|ObjectBucketClaim| NooBaa["ODF / NooBaa"]
    GitOps -->|PersesDashboard| COO
    Praxis -.->|Grid CA| CertMgr

    %% XKS path
    subgraph XKSDeps["XKS (non-OLM) dependencies"]
        GWAPI["Gateway API CRDs v1.4.0"]
        Sail["Sail operator OSSM 3.4.2"]
        OSECLI["ose-cli-rhel9 v4.20"]
        OIDC["OIDC issuer<br/>Keycloak / Entra ID"]
    end
    GitOps -->|rhai-on-xks-chart| XKSDeps

    %% Consumers / CI
    Konflux["Konflux<br/>(.tekton validation, digest substitution)"] -->|validates| GitOps
    Admin["Platform Admin"] -->|applies| GitOps

    style GitOps fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OCP fill:#999,stroke:#333
    style OLM fill:#999,stroke:#333
    style Argo fill:#999,stroke:#333
    style ACM fill:#999,stroke:#333
    style NooBaa fill:#999,stroke:#333
    style Praxis fill:#f5a623,stroke:#333
    style RHODS fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style AIGW fill:#7ed321,stroke:#333
    style Monitoring fill:#7ed321,stroke:#333
    style Comps fill:#7ed321,stroke:#333
    style Konflux fill:#e8e8e8,stroke:#333
    style Admin fill:#e8e8e8,stroke:#333
