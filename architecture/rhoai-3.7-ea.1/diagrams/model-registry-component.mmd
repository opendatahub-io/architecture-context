graph TB
    subgraph Image["odh-model-registry-rhel9 image (one FIPS Go binary /model-registry, 8080/TCP plain HTTP)"]
        subgraph Proxy["proxy subcommand: Model Registry REST server (one per ModelRegistry instance)"]
            RegAPI["REST API<br/>/api/model_registry/v1<br/>/api/model_registry/v1alpha3 (deprecated)"]
            RegMW["Middleware<br/>logging, CORS opt., validation,<br/>RFC 8594 Deprecation/Sunset<br/>NO authn/authz"]
            RegCore["Service layer<br/>models, versions, artifacts,<br/>experiments, runs, serving envs, ISVCs"]
            Embedmd["embedmd GORM datastore<br/>+ golang-migrate"]
            RegAPI --> RegMW --> RegCore --> Embedmd
        end

        subgraph Catalog["catalog subcommand: Model Catalog API server (shared platform instance)"]
            CatAPI["Plugin router<br/>ValidationMiddleware<br/>NO authn/authz"]
            PModel["model plugin<br/>/api/model_catalog/v1alpha1"]
            PMCP["mcp plugin<br/>/api/mcp_catalog/v1alpha1"]
            PAgent["agent plugin<br/>/api/agent_catalog/v1alpha1"]
            PSkill["skill plugin<br/>/api/skill_catalog/v1<br/>git-skills-plugin source"]
            PSR["serving_runtime plugin<br/>/api/serving_runtime_catalog/v1"]
            Leader["Leader election<br/>pglock advisory lock catalog-leader<br/>60s lease / 15s heartbeat"]
            Ingest["Ingestion (leader only)"]
            CatAPI --> PModel
            CatAPI --> PMCP
            CatAPI --> PAgent
            CatAPI --> PSkill
            CatAPI --> PSR
            Leader -->|gates| Ingest
        end

        Platform["internal/platform<br/>DB connectors, DB TLS config,<br/>health checkers, middleware"]
        Proxy -.->|shares| Platform
        Catalog -.->|shares| Platform
    end

    subgraph InitC["Catalog init containers (RHOAI overlay)"]
        PerfData["odh-model-performance-data-rhel9:v3.0.0<br/>→ /shared-data/performance"]
        MetaColl["odh-model-metadata-collection<br/>(ODH default sources)"]
    end
    PerfData -->|seeds| Ingest
    MetaColl -->|seeds| Ingest

    subgraph JobImg["odh-model-registry-job-async-upload-rhel9 (Python 3.12, AIPCC cpu-el9.8)"]
        Job["async-upload Job<br/>python -m job.entrypoint"]
        JobSteps["download S3/OCI/URI → upload S3 or<br/>ModelCar (olot + skopeo) → register →<br/>optional sign (rh-model-signing, cosign)"]
        Job --> JobSteps
    end

    subgraph Lib["Code shipped elsewhere / not built here"]
        ISVCCtrl["pkg/inferenceservice-controller<br/>(imported by model-registry-operator)"]
        Upstream["Upstream only: cmd/controller, UI BFF,<br/>frontend, cmd/csi, Python clients"]
    end

    Operator["model-registry-operator"] -->|deploys proxy| Proxy
    Operator -->|deploys catalog| Catalog
    Operator -->|embeds| ISVCCtrl
    Dashboard["odh-dashboard<br/>model-registry BFF"] -->|REST via auth proxy| RegAPI
    Dashboard -->|REST via auth proxy| CatAPI
    Dashboard -->|creates Job + Secrets| Job

    ISVCCR["KServe InferenceService CR"] -->|watched by| ISVCCtrl
    ISVCCtrl -->|sync serving state| RegAPI
    JobSteps -->|registers model| RegAPI

    Embedmd -->|3306 / 5432| RegDB[("MySQL or PostgreSQL<br/>registry DB (per instance)")]
    Ingest -->|5432| CatDB[("PostgreSQL<br/>model-catalog-postgres")]
    CatAPI -->|reads| CatDB
    Leader -->|advisory lock| CatDB
    Ingest -->|HTTPS 443| HF["huggingface.co"]
    PSkill -->|git CLI, not in RHOAI image| Git["Git remotes"]
    JobSteps -->|HTTPS 443| Storage["S3 / OCI registries"]
    JobSteps -->|HTTPS 443| Sigstore["Sigstore<br/>Fulcio / Rekor / TUF"]

