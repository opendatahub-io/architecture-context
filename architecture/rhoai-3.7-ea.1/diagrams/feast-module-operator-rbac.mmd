    CR -->|create, delete, get, list, patch, update, watch| RBACRes
    CR -->|bind| Bind
    CR -->|create| AuthN
    CR -->|CRUD, status update, finalizers update| FeastOpRes
    CR -->|CRUD| FeastDev
    CR -->|CRUD, connections use| DR
    CR -->|CRUD| Mon
    CR -->|create, delete, get, list, update, watch| Routes
    CR -->|get, list, watch| APIServers
