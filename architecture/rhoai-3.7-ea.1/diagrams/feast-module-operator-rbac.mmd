graph TD
    subgraph SAs["Service Accounts"]
        SA["opendatahub-feast-operator<br/>release namespace"]
        FeastSA["feast-operator-controller-manager<br/>redhat-ods-applications - payload"]
    end

    subgraph Bindings["Bindings"]
        CRB["ClusterRoleBinding<br/>opendatahub-feast-manager-rolebinding"]
        CRBMetrics["ClusterRoleBinding<br/>opendatahub-feast-metrics-auth-rolebinding"]
        RBLeader["RoleBinding<br/>opendatahub-feast-leader-election-rolebinding"]
        CRBTLS["ClusterRoleBinding<br/>feast-operator-openshift-tls-profile-reader-binding"]
    end

    subgraph Roles["Roles"]
        CR["ClusterRole<br/>opendatahub-feast-manager-role"]
        CRMetrics["ClusterRole<br/>opendatahub-feast-metrics-auth-role"]
        RLeader["Role<br/>opendatahub-feast-leader-election-role"]
        CRTLS["ClusterRole<br/>feast-operator-openshift-tls-profile-reader"]
    end

    subgraph UserRoles["Aggregated user roles - not bound by default"]
        Admin["feastoperator-admin-role<br/>CRUD feastoperators"]
        Editor["feastoperator-editor-role<br/>CRUD feastoperators"]
        Viewer["feastoperator-viewer-role<br/>get, list, watch"]
        Reader["opendatahub-feast-metrics-reader<br/>/metrics get"]
    end

    subgraph Resources["API Resources"]
        Core["core<br/>configmaps, serviceaccounts, services"]
        NS["core<br/>namespaces"]
        Pods["core<br/>pods, pods/log, PVCs"]
        Exec["core<br/>pods/exec"]
        Secrets["core<br/>secrets - cluster-wide"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Workloads["apps, batch, autoscaling, policy,<br/>networking.k8s.io, coordination.k8s.io"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings, roles, rolebindings"]
        Bind["rbac.authorization.k8s.io<br/>clusterroles system:auth-delegator"]
        AuthN["authentication.k8s.io / authorization.k8s.io<br/>tokenreviews, subjectaccessreviews"]
        FeastOpRes["components.platform.opendatahub.io<br/>feastoperators, /status, /finalizers"]
        FeastDev["feast.dev<br/>featurestores, /status, /finalizers"]
        DR["dataregistry.opendatahub.io<br/>registries, tables, volumes, connections"]
        Mon["monitoring.coreos.com<br/>servicemonitors"]
        Routes["route.openshift.io<br/>routes, routes/custom-host"]
        APIServers["config.openshift.io<br/>apiservers"]
        Misc["sparkoperator.k8s.io, kubeflow.org,<br/>mlflow.opendatahub.io, OLM"]
        Leases["core + coordination.k8s.io<br/>configmaps, events, leases"]
    end

    SA -->|bound via| CRB
    SA -->|bound via| CRBMetrics
    SA -->|bound via| RBLeader
    FeastSA -->|bound via| CRBTLS
    CRB -->|grants| CR
    CRBMetrics -->|grants| CRMetrics
    RBLeader -->|grants| RLeader
    CRBTLS -->|grants| CRTLS

    CR -->|full CRUD + deletecollection| Core
