graph LR
    MG["odh-must-gather<br/>(gather.sh)"]

    %% Build / runtime external dependencies
    MG -->|runtime base| BaseImg["ose-must-gather-rhel9<br/>v4.22 (digest-pinned)"]
    MG -->|kubectl binary| CliImg["ose-cli-rhel9<br/>(digest-pinned, kubectl 1.33.3)"]
    MG -->|"helm get values/manifest"| Helm["Helm CLI v4.1.4<br/>(Git LFS bin/helm)"]
    MG -->|crypto policy DEFAULT:PQ| RPM["crypto-policies-scripts RPM"]
    MG -->|"all data, HTTPS/443"| KubeAPI["Kubernetes / OpenShift<br/>API server (OCP 4.16+ for --since)"]

    %% Orchestration
    OcCli["oc adm must-gather"] -->|"image contract /usr/bin/gather"| MG
    Konflux["Konflux konflux-central"] -.->|hermetic multi-arch build| MG

    %% Internal RHOAI (CRD reads)
    MG -->|"DSCI, DSC, platform CRs, Subscription/CSV"| RHODS["rhods-operator"]
    MG -->|CRD read| DSP["Data Science Pipelines<br/>+ Argo"]
    MG -->|CRD read| KServe["KServe / LLM-D /<br/>ModelExpress / NIM"]
    MG -->|CRD read| WB["Notebooks / Workbenches"]
    MG -->|CRD read| Dist["KubeRay / Kueue /<br/>Kubeflow Trainer"]
    MG -->|CRD read| Data["Model Registry / Feast /<br/>Data Registry / MLflow /<br/>TrustyAI / Spark"]
    MG -->|"CRD + Helm read"| AIGW["AI Gateway / MaaS /<br/>Grid / Batch Gateway"]
    MG -->|CRD read| MCP["MCP Lifecycle Operator /<br/>OGX Operator"]
    MG -->|"Helm read, ns inspect"| RHAI["RHAII Helm chart /<br/>cloud manager"]

    %% Optional external dependencies
    MG -.->|"optional, full ns incl. Secrets"| CertMgr["cert-manager"]
    MG -.->|"optional, full ns incl. Secrets"| Sail["Sail Operator / Istio"]
    MG -.->|optional| LWS["LeaderWorkerSet"]
    MG -.->|optional| Kuadrant["Kuadrant / Authorino /<br/>Limitador"]
    MG -.->|"optional (xKS)"| Prom["Prometheus Operator /<br/>Azure Managed Prometheus"]

