graph TD
    subgraph SAs["Service Accounts"]
        SA["ray-module-operator-controller-manager"]
        KRSA["kuberay-operator<br/>(operand, applications namespace)"]
        NBSA["Notebook ServiceAccounts<br/>(bound by Workbenches)"]
    end

    subgraph Bindings["Bindings"]
        CRB["ClusterRoleBinding<br/>ray-module-operator-manager-rolebinding"]
        RB["RoleBinding (operator ns)<br/>ray-module-operator-manager-rolebinding"]
        LERB["RoleBinding<br/>ray-module-operator-leader-election-rolebinding"]
        MARB["ClusterRoleBinding<br/>ray-module-operator-metrics-auth-rolebinding"]
        KRCRB["kuberay-operator, kuberay-tls-profile-rolebinding,<br/>-configmap, -gateway-api, leader-election"]
        NBB["Workbenches binding<br/>(RoleBinding or ClusterRoleBinding, outside repo)"]
    end

    subgraph ModuleRoles["Module Operator Roles"]
        CR["ClusterRole<br/>ray-module-operator-manager-role<br/>(privilege superset of KubeRay)"]
        NR["Role ray-module-operator-manager-role<br/>services, configmaps, SAs, events, deployments"]
        LER["Role leader-election-role<br/>leases"]
        MAR["ClusterRole metrics-auth-role<br/>tokenreviews, subjectaccessreviews: create"]
    end

    subgraph RuntimeRoles["Roles created at runtime"]
        RayRole["ClusterRole ray<br/>(notebook, no ownerRef)"]
        KRRoles["kuberay-operator ClusterRole (broad CRUD),<br/>kuberay-tls-profile-role, -configmap, -gateway-api"]
    end

    subgraph Resources["API Resources (module manager-role)"]
        R1["components.platform.opendatahub.io<br/>rays, rays/status, rays/finalizers"]
        R2["core<br/>configmaps, events, PVCs, serviceaccounts, services"]
        R3["core<br/>pods, pods/proxy, pods/resize, pods/status,<br/>secrets, services/proxy, services/status"]
        R4["apps deployments, batch jobs"]
        R5["admissionregistration.k8s.io<br/>mutating/validating webhookconfigurations"]
        R6["apiextensions.k8s.io<br/>customresourcedefinitions"]
        R7["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings, roles, rolebindings"]
        R8["security.openshift.io<br/>securitycontextconstraints"]
        R9["cert-manager.io<br/>certificates, issuers, certificates/status"]
        R10["ray.io<br/>rayclusters, rayjobs, rayservices, raycronjobs<br/>+ finalizers, status"]
        R11["gateway.networking.k8s.io gateways, httproutes, referencegrants<br/>networking.k8s.io ingresses, ingressclasses, networkpolicies<br/>extensions ingresses, route.openshift.io routes"]
        R12["read-only: namespaces, endpointslices,<br/>config.openshift.io apiservers,<br/>operator.openshift.io kubeapiservers"]
        R13["coordination.k8s.io leases, events.k8s.io events,<br/>tokenreviews, subjectaccessreviews"]
    end

    subgraph NBResources["ClusterRole ray permissions"]
        N1["ray.io rayjobs"]
        N2["ray.io rayjobs/status, rayclusters, rayclusters/status"]
        N3["core secrets"]
    end

