graph TD
    subgraph NoRBAC["lm-evaluation-harness defines NO Kubernetes RBAC"]
        Note["No ClusterRoles, Roles, Bindings or ServiceAccounts<br/>No Kubernetes API usage<br/>Pod identity is set by the launcher"]
    end

    subgraph Launcher["Launcher-owned pod (trustyai-service-operator / EvalHub)"]
        PodSA["Job pod ServiceAccount<br/>(owned by launcher)"]
        K8sSecrets["Kubernetes Secrets<br/>(model.auth.secret_ref, data connections)"]
        JobSpec["/meta/job.json<br/>(mounted job spec)"]
    end

    subgraph Env["Credentials injected as env vars / files"]
        OpenAIKey["OPENAI_API_KEY<br/>(resolve_model_credentials)"]
        HFToken["HF_TOKEN<br/>(hf-token key)"]
        APIKeys["ANTHROPIC_API_KEY, WATSONX_API_KEY"]
        AWSCreds["AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY"]
        RegCreds["REGISTRY_* / OCI_* creds,<br/>/tmp/.docker/config.json"]
    end

    subgraph Enforcement["Authorization enforced remotely"]
        ModelGW["Model server / gateway<br/>Bearer, POST"]
        HFHub["Hugging Face Hub<br/>gated assets"]
        EvalHubSvc["EvalHub service<br/>eval-hub-sdk auth, POST"]
        S3Svc["S3 service<br/>access key/secret"]
        RegSvc["OCI registry<br/>push"]
        ThirdParty["Third-party LLM APIs"]
    end

    PodSA -->|mounts| K8sSecrets
    K8sSecrets -->|populates| OpenAIKey
    K8sSecrets -->|populates| HFToken
    K8sSecrets -->|populates| APIKeys
    K8sSecrets -->|populates| AWSCreds
    K8sSecrets -->|populates| RegCreds
    JobSpec -->|callback_url, model url| EvalHubSvc

    OpenAIKey -->|authenticates| ModelGW
    HFToken -->|authenticates| HFHub
    APIKeys -->|authenticates| ThirdParty
    AWSCreds -->|authenticates| S3Svc
    RegCreds -->|authenticates| RegSvc

    style Note fill:#e8e8e8
    style PodSA fill:#4a90e2
    style K8sSecrets fill:#f5a623
    style JobSpec fill:#f5a623
    style ModelGW fill:#7ed321
    style HFHub fill:#7ed321
    style EvalHubSvc fill:#7ed321
    style S3Svc fill:#7ed321
    style RegSvc fill:#7ed321
    style ThirdParty fill:#7ed321
