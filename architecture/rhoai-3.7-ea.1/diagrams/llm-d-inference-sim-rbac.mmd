        Admin["/admin/config GET/POST<br/>latency, failure injection, fake metrics"]
        Lora["/v1/load_lora_adapter<br/>/v1/unload_lora_adapter"]
        Sleep["/sleep, /wake_up, /is_sleeping"]
        Metrics["/metrics, /health, /health/ready"]
        GRPC["gRPC VllmEngine + reflection"]
        ZMQ["ZMQ PUB / ROUTER (no CURVE)"]
    end

    Anyone["Any caller with network reach"]

