graph TD
    subgraph "Service Account"
        SA["default ServiceAccount<br/>(none defined by manifests)"]
    end

    subgraph "Kubernetes RBAC"
        None["No ClusterRoles, Roles or bindings<br/>Simulator makes no Kubernetes API calls<br/>controller-runtime used for logging only"]
