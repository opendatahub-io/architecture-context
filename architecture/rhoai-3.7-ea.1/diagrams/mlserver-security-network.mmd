graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-managed, not in this repo)"]
        Gateway["Platform Gateway HTTPRoute / OpenShift Route<br/>443/TCP HTTPS<br/>TLS (platform)"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_User["Namespace: user namespace (per InferenceService)"]
            subgraph Pod["Predictor Pod"]
                KRP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS (typical)<br/>TokenReview + SAR<br/>KServe-injected when auth enabled"]
                MLS["MLServer<br/>REST 0.0.0.0:8080 HTTP<br/>gRPC 0.0.0.0:8081 h2c<br/>No TLS, no app auth<br/>Includes model load/unload API"]
                Metrics["MLServer metrics<br/>0.0.0.0:8082 HTTP<br/>No TLS, no auth"]
                Allow["Trusted runtime allowlist<br/>/etc/mlserver/trusted-runtimes.json<br/>0444, PRODUCTION mode"]
                Vol[("/mnt/models")]
                SI["storage-initializer<br/>(init container)"]
            end
        end

        subgraph NS_Mon["Namespace: openshift-user-workload-monitoring"]
            Prom["Prometheus"]
        end

        PodNet["Other pod-network clients<br/>(when IS auth disabled or<br/>no NetworkPolicy)"]
    end

    subgraph ExternalServices["EXTERNAL / OPTIONAL SERVICES"]
        Storage["Object storage / PVC / OCI<br/>443/TCP HTTPS, TLS<br/>Storage credentials"]
        OTLP["OTLP collector<br/>gRPC, insecure=True<br/>No auth"]
        Kafka["Kafka brokers<br/>default 9092/TCP<br/>No SSL / SASL<br/>(disabled by default)"]
    end

    Client -->|HTTPS/443<br/>TLS<br/>Bearer token| Gateway
    Gateway -->|HTTPS/8443<br/>TLS<br/>Bearer token| KRP
    KRP -->|HTTP/8080 or gRPC/8081<br/>plaintext, localhost<br/>no auth| MLS
    PodNet -.->|HTTP/8080, gRPC/8081<br/>PLAINTEXT, UNAUTHENTICATED<br/>infer + load/unload| MLS
    Prom -->|HTTP/8082<br/>plaintext<br/>no auth| Metrics
    SI -->|HTTPS/443<br/>TLS<br/>storage creds| Storage
    SI -->|filesystem| Vol
    MLS -->|reads model-settings.json| Vol
    MLS -->|import path check| Allow
    MLS -.->|OTLP/gRPC<br/>plaintext<br/>no auth| OTLP
    MLS -.->|Kafka<br/>plaintext<br/>no auth| Kafka

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class KRP,Prom,SI,Vol internal
    class MLS,Metrics,PodNet risk
    class Allow control
    class Storage,OTLP,Kafka externalservice
