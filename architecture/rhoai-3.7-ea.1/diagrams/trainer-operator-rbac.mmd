graph TD
    subgraph SAs["Service Accounts"]
        SA["trainer-operator-controller-manager<br/>ns: trainer-operator-system"]
        OPSA["kubeflow-trainer-controller-manager<br/>(operand)"]
        PromSA["prometheus-k8s<br/>ns: openshift-monitoring"]
    end

    subgraph Bindings["ClusterRoleBindings"]
        CRB[trainer-operator-manager-rolebinding]
        TLSB["trainer-tls-profile (operand)"]
        MRB["trainer-metrics-reader (operand)"]
    end

    subgraph Roles["ClusterRoles"]
        CR["trainer-operator-manager-role<br/>(broad by design: RBAC escalation prevention)"]
        TLSR["trainer-tls-profile"]
        MR["trainer-metrics-reader"]
        OMR["trainer-operator-metrics-reader<br/>get /metrics"]
        ADM["trainer-operator-trainer-admin-role<br/>trainers: CRUD"]
        VIEW["trainer-operator-trainer-viewer-role<br/>trainers: read"]
        TRN["training-edit / training-admin / training-view<br/>(operand, aggregate-to-view)"]
    end

    subgraph Res["API Resources"]
        Core["core<br/>configmaps, secrets, services"]
        NS["core<br/>namespaces"]
        SAres["core<br/>serviceaccounts"]
        Webhooks["admissionregistration.k8s.io<br/>mutating/validating webhookconfigs"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Deploy["apps<br/>deployments"]
        RBACres["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        Trainer["components.platform.opendatahub.io<br/>trainers, /status, /finalizers"]
        KFT["trainer.kubeflow.org<br/>clustertrainingruntimes, trainingruntimes, trainjobs"]
        KFTOpt["trainer.kubeflow.org<br/>optimizationjobs, */status, */finalizers"]
        JobSets["jobset.x-k8s.io<br/>jobsets"]
        PodGroups["scheduling.volcano.sh / scheduling.x-k8s.io<br/>podgroups"]
        Mon["monitoring.coreos.com<br/>servicemonitors, podmonitors, prometheusrules"]
        NP["networking.k8s.io<br/>networkpolicies"]
        IS["image.openshift.io<br/>imagestreams"]
        OSCfg["config.openshift.io<br/>apiservers, clusterversions"]
        Deps["operator.openshift.io jobsetoperators<br/>OLM operatorconditions, clusterextensions"]
        Misc["coordination.k8s.io leases, events,<br/>pods, limitranges, runtimeclasses, priorityclasses"]
        Auth["tokenreviews, subjectaccessreviews"]
        Metrics["nonResourceURL /metrics"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    OPSA -->|bound via| TLSB
    TLSB -->|grants| TLSR
    PromSA -->|bound via| MRB
    MRB -->|grants| MR

    CR -->|create, delete, get, list, patch, update, watch| Core
    CR -->|create, get, list, patch, update, watch| NS
    CR -->|create, list, watch; delete/get/patch/update by resourceNames| SAres
    CR -->|create, delete, get, list, patch, update, watch| Webhooks
    CR -->|create, get, list, patch, update, watch| CRDs
    CR -->|create, delete, get, list, patch, update, watch| Deploy
    CR -->|create, list, watch; delete/get/patch/update by resourceNames| RBACres
    CR -->|get, list, patch, update, watch| Trainer
    CR -->|create, delete, get, list, patch, update, watch| KFT
    CR -->|get, list, patch, update, watch| KFTOpt
    CR -->|create, delete, get, list, patch, update, watch| JobSets
    CR -->|create, get, list, patch, update, watch, delete| PodGroups
    CR -->|create, delete, get, list, patch, update, watch| Mon
    CR -->|create, get, list, patch, update, watch| NP
    CR -->|create, delete, get, list, patch, update, watch| IS
    CR -->|get, list, watch| OSCfg
    CR -->|get, list, watch / list| Deps
    CR -->|various read + leases/events write| Misc
    CR -->|create| Auth
    CR -->|get| Metrics

    TLSR -->|get, list, watch apiservers cluster| OSCfg
    MR -->|get| Metrics
    OMR -->|get| Metrics
    ADM -->|CRUD| Trainer
    VIEW -->|get, list, watch| Trainer
    TRN -->|edit: CRUD trainjobs, read runtimes; admin: CRUD; view: read| KFT

