graph TD
    subgraph SAs["Service Account"]
        SA["name<br/>(per-release EPP ServiceAccount)"]
    end

    subgraph Bindings["Bindings"]
        CRB["cluster-rbac-name<br/>ClusterRoleBinding"]
        RB_SA["name-sa<br/>RoleBinding (release ns)"]
        RB_NONSA["name-non-sa<br/>RoleBinding (release ns)"]
        RB_LE["name-leader-election-binding<br/>RoleBinding (release ns, HA)"]
    end

    subgraph Roles["Roles"]
        CR["cluster-rbac-name<br/>ClusterRole (when prometheus auth enabled)"]
        R_SA["name-sa<br/>Role"]
        R_NONSA["name-non-sa<br/>Role"]
        R_LE["name-leader-election<br/>Role (HA)"]
    end

    subgraph Resources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SARs["authorization.k8s.io<br/>subjectaccessreviews"]
        MetricsURL["nonResourceURL<br/>/metrics"]
        Pods["core<br/>pods"]
        Objectives["llm-d.ai<br/>inferenceobjectives"]
        Rewrites["llm-d.ai<br/>inferencemodelrewrites"]
        Pools["inference.networking.k8s.io<br/>inferencepools"]
        Leases["coordination.k8s.io<br/>leases"]
        Events["core<br/>events"]
    end

    SA -->|bound via| CRB
    SA -->|bound via| RB_SA
    SA -->|bound via| RB_NONSA
    SA -->|bound via| RB_LE
    CRB -->|grants| CR
    RB_SA -->|grants| R_SA
    RB_NONSA -->|grants| R_NONSA
    RB_LE -->|grants| R_LE

    CR -->|create| TokenReviews
    CR -->|create| SARs
    CR -->|get, prometheus-operator provider| MetricsURL
    R_SA -->|get, watch, list| Pods
    R_NONSA -->|get, watch, list| Objectives
    R_NONSA -->|get, watch, list| Rewrites
    R_NONSA -->|get, watch, list| Pools
    R_LE -->|get, list, watch, create, update, patch, delete| Leases
    R_LE -->|create, patch| Events

    Secret["Secret: router.monitoring.prometheus.auth.secretName<br/>kubernetes.io/service-account-token<br/>long-lived, no rotation"] -.->|token for Prometheus scrape| SA

