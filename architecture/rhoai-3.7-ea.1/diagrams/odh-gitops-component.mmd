graph TB
    Admin["Platform Admin"]
    ArgoCD["Argo CD / OpenShift GitOps<br/>(optional, SkipDryRunOnMissingResource)"]

    subgraph Repo["odh-gitops repository (configuration only, no images built)"]
        direction TB

        subgraph Kustomize["Kustomize path (OpenShift)"]
            KComponents["components/operators/*<br/>Namespace + OperatorGroup + Subscription"]
            KDeps["dependencies/operators/*<br/>11 operator bundles<br/>(NFD, GPU, MariaDB commented out)"]
            KConfigs["configurations/*<br/>Kueue, JobSet, LWS, Kuadrant,<br/>Authorino TLS stage 2"]
            KComponents -->|composed by| KDeps
            KDeps -.->|admin waits for CRDs| KConfigs
        end

        subgraph OCPChart["rhai-on-openshift-chart (Helm, OLM-based, v3.6.0)"]
            Helpers["_helpers.tpl<br/>shouldInstall tri-state resolver<br/>crdExists lookup gating"]
            Profiles["profiles/*<br/>default, rhaii, maas,<br/>ai-grid-ingress/inference/combined"]
            OpTpl["Operator Subscription<br/>(DISABLE_DSC_CONFIG=true)"]
            DSCTpl["default-dsci / default-dsc<br/>(DSCInitialization, DSC v3)"]
            GwTpl["Gateways<br/>openshift-ai-inference<br/>maas-default-gateway + Route"]
            AuthTpl["Kuadrant / Authorino CRs<br/>Authorino CA SSA patch"]
            Perses["PersesDashboard<br/>ai-grid-routing-admin"]
            Profiles --> Helpers
            Helpers --> OpTpl
            Helpers --> DSCTpl
            Helpers --> GwTpl
            Helpers --> AuthTpl

            subgraph AIGrid["AI Grid subcharts (Praxis 0.3.0-rc.4, adapted)"]
                GridGW["grid-gateway<br/>(consumer, TLS 8443, metrics 9443)"]
                GridProv["grid-provider-gateway<br/>(provider, mTLS 8080, passthrough Route)"]
                Enroll["grid-enrollment<br/>Grid CA, site identities,<br/>ACM Policies, CA bootstrap Job"]
                O11yHub["ai-grid-o11y-hub<br/>LokiStack usage-logs + OBC"]
                O11ySpoke["ai-grid-o11y-spoke<br/>ACM ScrapeConfig + NetworkPolicy"]
            end
            Helpers -->|"aiGridManaged"| AIGrid
        end

        subgraph XKSChart["rhai-on-xks-chart (Helm, non-OLM: AKS/EKS/CoreWeave)"]
            RhaiOp["rhai-operator Deployment<br/>(ODH_PLATFORM_TYPE=XKS)<br/>webhook 9443, metrics 8080 HTTP"]
            CloudMgr["aws/azure/coreweave<br/>cloud-manager-operator"]
            XCRDs["CRDs: Platform,<br/>*KubernetesEngine, GatewayConfig"]
            Hooks["Hook Jobs (ose-cli)<br/>post-install CRs + inference-gateway<br/>pre-delete / pre-upgrade"]
            subgraph Vendored["charts/dependencies/*"]
                VCM["cert-manager-operator 1.18.1"]
                VGW["gateway-api v1.4.0 CRDs"]
                VLWS["lws-operator 1.0"]
                VRHCL["rhcl-operator 1.3.0"]
                VSail["sail-operator (OSSM 3.4.2)"]
                VXGW["xks-gateway<br/>(GatewayConfig, OIDC)"]
            end
        end

        Scripts["scripts/*.sh<br/>verify deps, wait CRDs, Authorino TLS,<br/>uninstall cleanup"]
        Tekton[".tekton/*<br/>Konflux HyperShift validation"]
    end

    Admin -->|kubectl apply -k| Kustomize
    Admin -->|helm install / upgrade| OCPChart
    Admin -->|helm install| XKSChart
    ArgoCD -->|syncs| Kustomize
    ArgoCD -->|syncs| OCPChart

    OLM["OLM + Catalogs<br/>redhat / certified / community"]
    RHODS["rhods-operator /<br/>opendatahub-operator"]
    DepOps["Dependency operators<br/>cert-manager, Kueue, LWS, JobSet, RHCL,<br/>COO, OTel, Tempo, Loki, CMA, NFD, GPU"]
    ACM["Red Hat ACM"]
    CertMgr["cert-manager"]
    KServeGW["KServe / openshift-ai-inference"]
    PeerSites["Peer grid sites"]

    KComponents -->|Subscriptions| OLM
    OpTpl -->|Subscription| OLM
    OLM -->|installs| RHODS
    OLM -->|installs| DepOps
    DSCTpl -->|reconciled by| RHODS
    KConfigs -->|CRs reconciled by| DepOps
    AuthTpl -->|CRs reconciled by| DepOps
    Enroll -->|Issuer / Certificate| CertMgr
    Enroll -->|Policy / Placement| ACM
    O11ySpoke -->|ScrapeConfig| ACM
    GridGW -->|mTLS 443| PeerSites
    PeerSites -->|mTLS 443 passthrough| GridProv
    GridProv -->|Bearer SA token| KServeGW
    CloudMgr -->|installs via KubernetesEngine CR| Vendored
    CloudMgr -->|webhook cert| RhaiOp
    Hooks -->|create CRs| XCRDs

    classDef repo fill:#4a90e2,stroke:#333,color:#fff
    classDef grid fill:#9013fe,stroke:#333,color:#fff
    classDef xks fill:#50e3c2,stroke:#333
    classDef external fill:#e8e8e8,stroke:#999
    classDef internal fill:#7ed321,stroke:#333
    classDef actor fill:#f5a623,stroke:#333

    class KComponents,KDeps,KConfigs,Helpers,Profiles,OpTpl,DSCTpl,GwTpl,AuthTpl,Perses,Scripts,Tekton repo
    class GridGW,GridProv,Enroll,O11yHub,O11ySpoke grid
    class RhaiOp,CloudMgr,XCRDs,Hooks,VCM,VGW,VLWS,VRHCL,VSail,VXGW xks
    class OLM,DepOps,ACM,CertMgr,PeerSites external
    class RHODS,KServeGW internal
    class Admin,ArgoCD actor
