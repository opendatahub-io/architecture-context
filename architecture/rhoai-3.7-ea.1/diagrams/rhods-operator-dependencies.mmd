graph LR
    Op["rhods-operator<br/>(platform operator)"]

    %% External / cluster dependencies
    Op -->|"reconcile, SSA<br/>HTTPS/6443"| K8sAPI[Kubernetes API Server]
    Op -->|install, upgrade| OLM[OLM]
    Op -->|"GatewayClass, EnvoyFilter,<br/>DestinationRule"| Istio["OpenShift Service Mesh / Istio"]
    Op -->|"webhook, metrics,<br/>gateway, proxy certs"| ServiceCA[OpenShift service-ca]
    Op -->|TLS security profile| APIServerCfg["config.openshift.io<br/>APIServer"]
    Op -->|Routes| Router[OpenShift Router]
    Op -.->|"XKS: gateway cert"| CertManager[cert-manager]

    %% Libraries
    Op -.->|framework| CR["controller-runtime v0.25.1"]
    Op -.->|Gateway API types| GWAPI["gateway-api v1.3.0"]
    Op -.->|reconciler framework| PU["odh-platform-utilities v0.5.0"]
    Op -.->|rendering| Render["k8s-manifest-kit / kustomize v0.21.1"]

    %% Operator-managed workloads
    Op -->|deploys| KAP["kube-auth-proxy"]
    Op -->|deploys| Redirect["dashboard-redirect nginx"]
    KAP -->|"OAuth2<br/>HTTPS/443"| OAuth[OpenShift OAuth]
    KAP -->|"OIDC<br/>HTTPS/443"| OIDC[External OIDC IdP]

    %% Internal RHOAI modules
    Op -->|"runlevel 20<br/>Helm"| Dashboard[odh-dashboard]
    Op -->|"runlevel 20<br/>Kustomize"| Pipelines["aipipelines<br/>+ Argo CRDs"]
    Op -->|"runlevel 20"| Workbenches[workbenches]
    Op -->|"runlevel 20"| Monitoring["monitoring stack<br/>redhat-ods-monitoring"]
    Op -->|"runlevel 20"| R20["ray, trainer, aihub,<br/>databaseservice, mcplifecycleoperator"]
    Op -->|"runlevel 31<br/>Kustomize"| KServe["kserve /<br/>odh-model-controller"]
    Op -->|"runlevel 31<br/>component CR"| Kueue[Kueue]
    Op -->|"runlevel 32"| R32["aigateway, data, mlflowoperator,<br/>ogx, sparkoperator, trustyai"]
    Op -->|admin RoleBindings| MaaS["Models-as-a-Service /<br/>Kuadrant"]

    %% Build inputs
    BuildCfg["RHOAI-Build-Config<br/>manifests-config.yaml<br/>(pinned rhoai-3.6 refs)"] -.->|build input| Op

    %% Consumers
    Admin[Platform Admin] -->|"DSC / DSCI / Auth /<br/>GatewayConfig"| Op
    Prom[Prometheus] -->|"scrape HTTPS/8443"| Op

    %% XKS
    Op -->|"cloudmanager<br/>Helm"| XKS["XKS prereqs:<br/>Gateway API, LWS, Sail, RHCL"]

    style Op fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style OAuth fill:#f5a623,stroke:#333
    style OIDC fill:#f5a623,stroke:#333
    style OLM fill:#999,stroke:#333
    style Istio fill:#999,stroke:#333
    style ServiceCA fill:#999,stroke:#333
    style APIServerCfg fill:#999,stroke:#333
    style Router fill:#999,stroke:#333
    style CertManager fill:#999,stroke:#333
    style XKS fill:#999,stroke:#333
    style CR fill:#e8e8e8,stroke:#333
    style GWAPI fill:#e8e8e8,stroke:#333
    style PU fill:#e8e8e8,stroke:#333
    style Render fill:#e8e8e8,stroke:#333
    style KAP fill:#4a90e2,stroke:#333,color:#fff
    style Redirect fill:#4a90e2,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333
    style Pipelines fill:#7ed321,stroke:#333
    style Workbenches fill:#7ed321,stroke:#333
    style Monitoring fill:#7ed321,stroke:#333
    style R20 fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style Kueue fill:#7ed321,stroke:#333
    style R32 fill:#7ed321,stroke:#333
    style MaaS fill:#7ed321,stroke:#333
    style BuildCfg fill:#fff2cc,stroke:#333
