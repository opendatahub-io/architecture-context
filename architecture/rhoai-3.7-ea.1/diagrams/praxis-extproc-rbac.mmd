graph TD
    subgraph SAs["Service Accounts"]
        SA["openshift-ingress/payload-processing<br/>(both instances, token automounted)"]
        PromSA["redhat-ods-monitoring/prometheus-k8s"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB1["payload-processing-metrics-auth"]
        CRB2["payload-processing-metrics-reader"]
    end

    subgraph Roles["ClusterRoles"]
        CR1["payload-processing-metrics-auth"]
        CR2["payload-processing-metrics-reader"]
    end

    subgraph Resources["API Resources / URLs"]
        TR["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        MetricsURL["nonResourceURL<br/>/metrics"]
    end

    SA -->|bound via| CRB1
    CRB1 -->|grants| CR1
    CR1 -->|create| TR
    CR1 -->|create| SAR

    PromSA -->|bound via| CRB2
    CRB2 -->|grants| CR2
    CR2 -->|get| MetricsURL

    PromSA -.->|scrapes /metrics 9090, checked in-process by| SA

    Removed["Removed: payload-processing-reader<br/>cluster-scoped secrets get<br/>(must not be restored)"]

    style SA fill:#4a90e2
    style PromSA fill:#4a90e2
    style CR1 fill:#f5a623
    style CR2 fill:#f5a623
    style TR fill:#7ed321
    style SAR fill:#7ed321
    style MetricsURL fill:#7ed321
    style Removed fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
