graph LR
    VLLM["vllm-cpu<br/>odh-vllm-cpu-rhel9"]

    %% External runtime dependencies
    VLLM -->|runtime| Python["Python 3.12"]
    VLLM -->|tensor compute| Torch["PyTorch 2.11.0 CPU"]
    VLLM -->|multimodal, not on s390x| TV["torchvision / torchaudio"]
    VLLM -->|model/tokenizer loading| HFT["transformers >=5.6.0"]
    VLLM -->|tokenization| Tok["tokenizers / tiktoken"]
    VLLM -->|HTTP API| FastAPI["fastapi / uvicorn"]
    VLLM -->|protocol types| OAI["openai / openai-harmony"]
    VLLM -->|metrics| PromC["prometheus_client"]
    VLLM -->|structured output| XG["xgrammar"]
    VLLM -->|engine IPC| ZMQ["pyzmq"]
    VLLM -.->|installed, servicer missing| GRPCio["grpcio / grpcio-reflection"]
    VLLM -.->|n-gram spec decode, not on s390x| Numba["numba / llvmlite"]
    VLLM -->|model loading| TZ["tensorizer 2.10.1"]
    VLLM -->|native libs| RPMs["OpenBLAS, numactl, OpenMPI,<br/>libsndfile, tcmalloc"]

    %% Internal platform dependencies
    ODHMC["odh-model-controller<br/>vllm-cpu ServingRuntime templates"] -->|image reference| VLLM
    KServe["KServe"] -->|hosts predictor pod| VLLM
    Konflux["konflux-central<br/>multi-arch-container-build"] -->|builds| VLLM
    Prom["Prometheus<br/>user workload monitoring"] -->|scrapes /metrics 8000| VLLM

    %% External services
    VLLM -->|HTTPS 443| HF["Hugging Face Hub"]
    VLLM -->|HTTPS 443| S3["S3-compatible storage"]
    VLLM -.->|HTTPS 443 optional| MS["ModelScope"]
    VLLM -.->|build-time, non-hermetic| Idx["IBM DevPI, PyPI, PyTorch CDN,<br/>GitHub, rustup, EPEL"]
    VLLM -.->|upstream fork of| Upstream["vllm-project/vllm"]
    VLLM -.->|migration target, not adopted| AIPCC["AIPCC CPU base<br/>aipcc-cpu-torch2.11-el9.8-app"]

