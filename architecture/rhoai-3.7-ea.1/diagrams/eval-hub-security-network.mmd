graph TB
    subgraph External["CLIENTS (Authenticated by kube-rbac-proxy)"]
        Client["Client<br/>eval-hub-sdk / RHOAI Dashboard"]
        MCPClient["AI Assistant<br/>(MCP client)"]
    end

    subgraph PlatformNS["Namespace: eval-hub deployment (operator-managed)"]
        direction TB
        subgraph APIPod["eval-hub Pod"]
            KRP["kube-rbac-proxy<br/>8443/TCP HTTPS (operator-defined)<br/>TokenReview + SAR<br/>sets X-Tenant / X-User"]
            API["eval-hub API<br/>127.0.0.1:8080/TCP HTTP<br/>trusts identity headers<br/>optional native TLS 1.2+"]
            Metrics["Metrics listener<br/>0.0.0.0:8081/TCP HTTP<br/>NO AUTH"]
        end
        MCP["evalhub-mcp (optional)<br/>3001/TCP HTTP/HTTPS<br/>auth: none (default) / rbac-proxy"]
    end

    subgraph TenantNS["Namespace: tenant (X-Tenant)"]
        direction TB
        NetPol["NetworkPolicy per job<br/>ingress: deny all<br/>egress: NOT restricted"]
        subgraph JobPod["Evaluation Job Pod<br/>automountServiceAccountToken: false"]
            Init["eval-runtime-init<br/>init container"]
            Adapter["Adapter container<br/>sees placeholder creds only"]
            Sidecar["eval-runtime-sidecar<br/>localhost:8080/TCP HTTP<br/>holds tokens + model creds"]
        end
    end

    subgraph ClusterSvc["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
        PG["PostgreSQL<br/>5432/TCP<br/>sslmode per DSN"]
        Prom["Prometheus"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC / 4318 HTTP"]
        MLflow["MLflow<br/>HTTPS, custom CA"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3-compatible storage<br/>443/TCP HTTPS"]
        Git["Git / Hugging Face<br/>443/TCP HTTPS"]
        OCI["OCI Registry<br/>443/TCP HTTPS"]
        Model["Model / judge endpoints<br/>HTTP/HTTPS configured"]
    end

    Client -->|HTTPS/8443<br/>TLS at proxy<br/>Bearer token| KRP
    MCPClient -->|stdio or HTTP/3001<br/>no auth by default| MCP
    MCP -->|HTTPS<br/>Bearer EVALHUB_TOKEN| KRP
    KRP -->|HTTP/8080 pod-local<br/>plaintext<br/>X-Tenant / X-User| API
    API -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token| K8sAPI
    API -->|PostgreSQL/5432<br/>per DSN<br/>DB password| PG
    API -->|HTTPS<br/>custom CA<br/>Bearer token file| MLflow
    API -->|gRPC/4317<br/>TLS unless insecure<br/>no auth| OTLP
    Prom -->|HTTP/8081<br/>plaintext<br/>no auth| Metrics
    K8sAPI -.->|creates Job, ConfigMap,<br/>Secret, NetworkPolicy| TenantNS

    Init -->|HTTPS/443 TLS<br/>AWS access keys| S3
    Init -->|HTTPS/443 TLS<br/>basic auth / HF token| Git
    Adapter -->|HTTP localhost:8080<br/>no auth| Sidecar
    Sidecar -->|HTTP/HTTPS<br/>TLS per endpoint<br/>model credentials| Model
    Sidecar -->|HTTPS/443<br/>TLS<br/>OCI token| OCI
    Sidecar -->|HTTPS<br/>TLS<br/>Bearer token cached 5m| MLflow
    Sidecar -->|HTTPS/8443<br/>TLS service-ca<br/>Bearer token| KRP

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,MCPClient external
    class KRP ingress
    class API,K8sAPI,PG,Prom,OTLP,MLflow internal
    class Init,Adapter,Sidecar tenant
    class Metrics,MCP,NetPol risk
    class S3,Git,OCI,Model externalservice
