graph TD
    subgraph Repo["MLServer repository"]
        NoRBAC["No ClusterRoles, Roles, RoleBindings<br/>or ServiceAccounts defined<br/>MLServer does not call the Kubernetes API"]
    end

    subgraph Platform["Platform-delegated access control (KServe)"]
        PodSA["Predictor pod ServiceAccount<br/>(KServe-managed)"]
        KRP["kube-rbac-proxy sidecar<br/>(when InferenceService auth enabled)"]
        TR["authentication.k8s.io<br/>TokenReview"]
        SAR["authorization.k8s.io<br/>SubjectAccessReview"]
    end

    subgraph App["In-application controls"]
        Allow["Trusted runtime allowlist<br/>/etc/mlserver/trusted-runtimes.json"]
        CORS["CORS middleware (opt-in)<br/>wildcards rejected in PRODUCTION"]
    end

    subgraph Surfaces["MLServer API surfaces"]
        Infer["REST/gRPC inference<br/>8080 / 8081"]
        Repo2["Model repository<br/>load / unload / index"]
        MetricsEP["/metrics 8082<br/>(no auth)"]
    end

    Caller["Caller bearer token"] -->|presented to| KRP
    KRP -->|validates via| TR
    KRP -->|authorizes via| SAR
    KRP -->|allowed requests forwarded| Infer
    KRP -->|allowed requests forwarded| Repo2
    PodSA -.->|identity of pod,<br/>no permissions used by MLServer| NoRBAC
    Repo2 -->|implementation checked by| Allow
    Infer -->|browser origins checked by| CORS

    style NoRBAC fill:#e8e8e8,stroke-dasharray: 5 5
    style KRP fill:#4a90e2,color:#fff
    style TR fill:#7ed321
    style SAR fill:#7ed321
    style Allow fill:#f5a623
    style CORS fill:#f5a623
    style MetricsEP fill:#f8cecc
    style Repo2 fill:#f8cecc
