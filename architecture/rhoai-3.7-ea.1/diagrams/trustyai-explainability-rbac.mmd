graph TD
    subgraph SAs["Service Account"]
        SA["trustyai-serviceaccount"]
    end

    subgraph Bindings["ClusterRole Binding - legacy in-repo manifest"]
        CRB["trustyai-clusterrolebinding<br/>cluster-scoped"]
    end

    subgraph Roles["ClusterRole Permissions"]
        CR["trustyai-role"]
    end

    subgraph Resources["API Resources"]
        CM["core<br/>configmaps<br/>ALL namespaces"]
    end

    subgraph Consumer["Actual consumer"]
        Init["ose-cli init container<br/>oc apply model-serving-config"]
    end

    subgraph Runtime["Runtime authorization - operator deployment"]
        RBP["kube-rbac-proxy 8443<br/>Bearer → SubjectAccessReview"]
        IntP["internal-tls-proxy 4443<br/>bypass: /, /consumer/kserve/v2, /q/health"]
        App["trustyai-service<br/>no app-level authZ"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|create, delete, get, list, patch, update, watch| CM
    Init -->|runs as| SA
    RBP -->|authorized requests| App
    IntP -->|unauthenticated ingestion| App

    style SA fill:#4a90e2
    style CRB fill:#f5a623
    style CR fill:#f5a623
    style CM fill:#7ed321
    style Init fill:#e8e8e8
    style RBP fill:#dae8fc
    style IntP fill:#f8cecc
    style App fill:#dae8fc
