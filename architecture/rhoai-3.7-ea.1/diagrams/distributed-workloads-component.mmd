graph TB
    subgraph Repo["distributed-workloads repo (build + test, no deployed service)"]
        direction TB
        subgraph Universal["Universal training images (Konflux hermetic)"]
            CUDA["th-torch-cuda-py312<br/>CUDA 13.0, torch 2.13.0, vLLM 0.31<br/>x86_64, arm64"]
            CPU["th-torch-cpu-py312<br/>torch 2.13.0<br/>x86_64, arm64, ppc64le"]
            ROCM["th-torch-rocm-py312<br/>ROCm 7.14, torch 2.12.0<br/>x86_64, no MPI/SSH"]
        end
        Entrypoint["entrypoint-universal.sh<br/>NOTEBOOK_ARGS set: Jupyter<br/>else: command passthrough"]
        UIDExec["openshift-uid-exec.sh<br/>symlinked as mpirun / mpiexec<br/>UID to /etc/passwd, DNS wait, nofile cap"]
        SSHD["user sshd<br/>2222/TCP, pubkey only"]
        Ray["Ray runtime images<br/>quay.io/modh/ray:2.52.1-*, 2.58.0-*<br/>UBI9 python, non-hermetic"]
        TestsImg["tests image<br/>gotestsum + oc 4.18"]
        E2E["E2E test suite (Go)<br/>kfto, trainer, odh, fms suites"]
        Bench["benchmarks/<br/>MPI DDP SFT, OSU MPI"]
        Examples["examples/, workshops/<br/>demo only: MinIO, NFS, ServingRuntime"]
    end

    CUDA --> Entrypoint
    CPU --> Entrypoint
    ROCM --> Entrypoint
    CUDA --> UIDExec
    CPU --> UIDExec
    CUDA --> SSHD
    CPU --> SSHD
    TestsImg -->|runs| E2E

    Notebooks["notebooks<br/>Jupyter minimal workbench images"] -->|BASE_IMAGE| Universal
    AIPCC["AIPCC PyPI index<br/>public-rhai/rhoai/3.6"] -->|wheels via Cachi2 prefetch| Universal
    UBI9["UBI9 python-312"] -->|base| Ray

    Trainer["trainer<br/>ClusterTrainingRuntime"] -->|references image| Universal
    Workbench["notebook-controller / dashboard"] -->|injects NOTEBOOK_ARGS| Entrypoint
    KubeRay["kuberay<br/>RayCluster / RayJob"] -->|uses image| Ray
    Bench -->|TrainJob| Trainer

    E2E -->|tests PyTorchJob| KFTO["training-operator v1"]
    E2E -->|tests TrainJob / JobSet| Trainer
    E2E -->|tests RayCluster / RayJob| KubeRay
    E2E -->|tests queues / admission| Kueue["kueue"]
    E2E -->|OLM checks| OLM["OLM"]

