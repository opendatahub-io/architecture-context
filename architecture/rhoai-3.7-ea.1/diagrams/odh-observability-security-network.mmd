graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / Perses / Gateway<br/>Bearer token"]
        Remote["Remote OTLP / remote-write hub<br/>user-defined"]
        Obj["S3 / GCS object storage<br/>443/TCP TLS"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        R1["data-science-prometheus-route<br/>443/TCP reencrypt"]
        R2["data-science-thanos-querier-route<br/>443/TCP reencrypt"]
        R3["data-science-prometheus-cluster-proxy<br/>443/TCP reencrypt, insecure Redirect"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP TLS 1.2+"]
    end

    subgraph OpNS["Operator namespace"]
        Op["odh-observability manager<br/>SA: fullname<br/>metrics 8443 HTTPS Bearer+SAR<br/>health 8081 HTTP no auth"]
        WH["Webhook :9443 HTTPS<br/>cluster TLS profile, HTTP/1.1 ALPN<br/>failurePolicy Fail"]
    end

    subgraph MonNS["Monitoring namespace (redhat-ods-monitoring)"]
        subgraph ProxyPod["Namespace proxy pods"]
            KRP["kube-rbac-proxy :8443<br/>TLS profile + FIPS curves<br/>TokenReview + SAR"]
            Gate["method-gate 127.0.0.1:9092<br/>HTTP plaintext loopback"]
            PLP["prom-label-proxy 127.0.0.1:9091<br/>HTTP plaintext loopback"]
        end
        CProxy["cluster proxy kube-rbac-proxy :8443<br/>allow-paths=/metrics"]
        Thanos["Thanos Querier :10902<br/>HTTP plaintext"]
        Prom["prometheus-operated :9090<br/>HTTPS mTLS"]
        Coll["OTel Collectors<br/>OTLP 4317/4318 TLS, no auth<br/>exporters 8889/8890 HTTPS"]
        TA["TargetAllocator<br/>mTLS cert-manager"]
        Tempo["Tempo<br/>OTLP gRPC TLS, write ACL"]
        Loki["LokiStack gateway<br/>HTTPS service-ca"]
        K8r["Korrel8r :8443 HTTPS<br/>token delegation"]
    end

    subgraph Tenant["Tenant / workload namespaces (opted in)"]
        WL["Workloads, KServe, MaaS<br/>ServiceMonitors / PodMonitors<br/>DCGM :9400 HTTP"]
    end

    Client -->|HTTPS/443 TLS<br/>Bearer| R1
    Client -->|HTTPS/443 TLS<br/>Bearer| R2
    Client -->|HTTPS/443 TLS<br/>Bearer| R3
    R1 -->|HTTPS/8443 reencrypt| KRP
    R2 -->|"HTTPS/8443 reencrypt (service CA)"| KRP
    R3 -->|HTTPS/8443 reencrypt| CProxy
    KRP -->|HTTP/9092 loopback| Gate
    Gate -->|HTTP/9091 loopback| PLP
    PLP -->|HTTP/10902 plaintext| Thanos
    CProxy -->|HTTPS/9090 mTLS client cert| Prom
    KRP -->|TokenReview/SAR| API
    Op -->|HTTPS/6443 SA token<br/>watch, SSA, GC| API
    API -->|HTTPS/9443 TLS<br/>ipBlock CIDRs| WH
    WL -->|OTLP 4317/4318 TLS| Coll
    Coll -->|HTTPS mTLS| TA
    Coll -->|HTTP/HTTPS scrape per monitor| WL
    Prom -->|HTTPS/8889 TLS| Coll
    Coll -->|OTLP gRPC TLS<br/>SA token| Tempo
    Coll -->|OTLP/HTTP TLS<br/>SA token| Loki
    Coll -->|OTLP TLS<br/>credentialSecret| Remote
    Tempo -->|HTTPS/443<br/>storage secret| Obj
    Loki -->|HTTPS/443<br/>storage secret| Obj
    K8r -->|HTTPS/6443 caller token| API

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef plaintext fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,Remote,Obj external
    class R1,R2,R3 ingress
    class API control
    class Op,WH,KRP,CProxy,Prom,Coll,TA,Tempo,Loki,K8r internal
    class Gate,PLP,Thanos plaintext
    class WL tenant
