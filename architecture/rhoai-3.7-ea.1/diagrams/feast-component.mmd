graph TB
    User["Data Scientist / Dashboard"]
    PlatformOp["RHOAI platform operator<br/>(rhods-operator)"]

    subgraph OperatorNS["Namespace: redhat-ods-applications"]
        subgraph OperatorPod["odh-feast-operator (Go, controller-runtime 0.23.3)"]
            FSR["FeatureStoreReconciler"]
            NBR["NotebookConfigMapReconciler"]
            TLSWatch["SecurityProfileWatcher<br/>(cluster TLS profile)"]
            Metrics["Metrics :8443 HTTPS<br/>TokenReview + SAR"]
            Probes["Probes :8081<br/>/healthz /readyz"]
        end
    end

    PlatformOp -->|deploys overlay rhoai<br/>injects RELATED_IMAGE_*, OIDC_ISSUER_URL| OperatorPod

    FSCR["FeatureStore CR<br/>feast.dev/v1 (v1alpha1 served)<br/>Namespaced"]
    NotebookCR["Notebook CR<br/>kubeflow.org"]
    MLflowCR["MLflow CR<br/>mlflow.opendatahub.io"]
    APIServerCfg["apiservers.config.openshift.io/cluster"]

    User -->|creates| FSCR
    FSCR -->|watched by| FSR
    NotebookCR -->|watched by| NBR
    MLflowCR -->|discovered by| FSR
    APIServerCfg -->|TLS profile| TLSWatch

    subgraph TenantNS["Tenant namespace (per FeatureStore CR)"]
        subgraph FeastPod["Deployment feast-{name}<br/>(odh-feature-server image, one container per service)"]
            Registry["Registry<br/>serve_registry<br/>gRPC 6570/6571, REST 6572/6573"]
            Online["Online server<br/>serve<br/>6566/6567"]
            Offline["Offline server<br/>serve_offline (Arrow Flight)<br/>8815/8816"]
            UI["UI server<br/>ui<br/>8888/8443"]
            Lineage["Lineage server<br/>serve_lineage<br/>6580/6581"]
            MCP["MCP server<br/>mcp<br/>8100/8101"]
        end
        Svcs["Services feast-{name}-*<br/>80/443"]
        Route["Route feast-{name}-ui<br/>reencrypt"]
        PVC["PVCs"]
        CronJob["CronJob (ose-cli)<br/>kubectl exec feast apply / materialize"]
        NetPol["NetworkPolicies (up to 6)"]
        RBAC["SA + Role/RoleBinding"]
        HPA["HPA / PDB / ServiceMonitor"]
        NBCM["ConfigMap notebook-feast-config"]
        IntraCM["ConfigMap intra-comm token"]
    end

    subgraph DRNS["Data registry (cluster singleton)"]
        DRPod["Data registry pod<br/>kube-rbac-proxy :8443<br/>→ serve_registry --rest-api 127.0.0.1:6572"]
    end

    FSR -->|creates| FeastPod
    FSR -->|creates| Svcs
    FSR -->|creates| Route
    FSR -->|creates| PVC
    FSR -->|creates| CronJob
    FSR -->|creates| NetPol
    FSR -->|creates| RBAC
    FSR -->|creates| HPA
    FSR -->|creates| IntraCM
    FSR -->|creates| DRPod
    NBR -->|writes| NBCM

    CronJob -->|pods/exec| FeastPod
    Online -->|gRPC + intra token| Registry
    Offline -->|gRPC + intra token| Registry
    UI --> Registry
    MCP --> Registry
    Lineage --> Registry
    Route --> UI

    StandaloneMCP["odh-feast-mcp image<br/>feast mcp :8000<br/>(no operator wiring)"]
    StandaloneMCP -.->|Feast client| Registry

    Stores["Online / offline / registry stores<br/>Redis, PostgreSQL, S3, Snowflake, ..."]
    Online --> Stores
    Offline --> Stores
    Registry --> Stores

    K8sAPI["Kubernetes API"]
    FSR -->|reconcile| K8sAPI

