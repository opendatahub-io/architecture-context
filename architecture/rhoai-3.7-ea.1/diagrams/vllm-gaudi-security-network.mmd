graph TB
    subgraph External["EXTERNAL / PLATFORM INGRESS (owned by KServe / gateway, not this repo)"]
        Client["Client / KServe ingress<br/>Auth and TLS delegated to platform"]
    end

    subgraph Namespace["USER NAMESPACE: InferenceService pod (Service, RBAC and NetworkPolicy defined outside this repo)"]
        direction TB
        API["vLLM OpenAI API server<br/>odh-vllm-gaudi-rhel9<br/>8000/TCP HTTP<br/>No TLS by default (optional --ssl-*)<br/>No auth by default (optional --api-key)<br/>UID 2000 / GID 0"]
        Plugin["vllm_gaudi plugin + HpuPlatform<br/>in-process, no network listeners<br/>no crypto imports"]
        HPU["Intel Gaudi HPU<br/>habana.ai/gaudi via device plugin"]
        API --> Plugin
        Plugin -->|device access| HPU
    end

    subgraph Peers["DISAGGREGATED SERVING PEERS (optional)"]
        Decode["Decode / prefill instance<br/>HPU NIXL connector"]
    end

    subgraph ExtServices["EXTERNAL SERVICES (runtime egress)"]
        Storage["Model storage<br/>S3 / HF Hub / PVC<br/>443/TCP HTTPS, TLS<br/>system trust store"]
    end

    subgraph Build["BUILD-TIME SOURCES (Konflux, hermetic: false)"]
        BuildSrc["github.com (vllm, vllm-gaudi clone v0.16.0)<br/>vault.habana.ai, pypi.org<br/>mirror.stream.centos.org, dl.fedoraproject.org<br/>443/TCP HTTPS"]
    end

    Client -->|HTTP/8000<br/>plaintext by default<br/>no auth by default| API
    Plugin -.->|NIXL/UCX, deployment-defined port<br/>encryption not specified<br/>no auth in plugin| Decode
    API -->|HTTPS/443<br/>TLS<br/>deployment-supplied creds| Storage
    BuildSrc -.->|image build only<br/>GPG check on RPM repos only<br/>FIPS provider removed| API

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Plugin,HPU workload
    class API,Decode,BuildSrc risk
    class Storage externalservice
