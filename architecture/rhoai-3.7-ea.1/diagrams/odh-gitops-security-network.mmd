graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Data Scientist"]
        AdminU["Admin / Argo CD"]
        PeerSites["Peer AI Grid sites<br/>(other clusters)"]
        OIDC["OIDC issuer<br/>Keycloak / Entra ID<br/>443/TCP TLS"]
        Registries["registry.redhat.io / quay.io / ghcr.io<br/>443/TCP TLS"]
    end

    subgraph OCP["OPENSHIFT CLUSTER (rhai-on-openshift-chart / Kustomize)"]
        direction TB
        subgraph Ingress["INGRESS - ns openshift-ingress"]
            MaaSGW["maas-default-gateway<br/>443/TCP HTTPS TLS terminate<br/>Authorino AuthPolicy"]
            MaaSRoute["maas-gateway-route<br/>Route reencrypt, Redirect<br/>maas-gw-service-tls"]
            InfGW["openshift-ai-inference<br/>Gateway 443/TCP HTTPS<br/>allowedRoutes required"]
            ProvRoute["grid-provider-gateway Route<br/>443/TCP passthrough, 300 s<br/>mTLS end-to-end"]
        end

        subgraph GridNS["ns redhat-ai-grid (AI Grid)"]
            GridGW["grid-gateway<br/>Svc 443 to 8443/TCP HTTPS<br/>TLS service-ca, Authorization stripped<br/>NetworkPolicy: ingress policy-group"]
            GridMetrics["grid-gateway-metrics<br/>9443/TCP HTTPS TLS service-ca<br/>NetworkPolicy: monitoring ns"]
            GridProv["grid-provider-gateway<br/>8080/TCP mTLS Grid CA<br/>require_named client cert<br/>no NetworkPolicy"]
            SAToken["grid-model-client-token<br/>long-lived SA token, no rotation"]
        end

        subgraph Mon["ns redhat-ods-monitoring"]
            Collector["data-science-collector<br/>8890/TCP HTTP plaintext<br/>NetworkPolicy allow-acm-rhai-metrics"]
        end

        subgraph ACMNS["ns open-cluster-management-agent-addon"]
            ACMColl["ACM metrics-collector"]
        end

        KServe["KServe backends<br/>HTTPS service-ca"]
        Authorino["Authorino clusterWide<br/>listener TLS authorino-server-cert"]
        KAPI["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
        OLMCat["OLM catalog pods<br/>50051/TCP gRPC, no TLS"]
    end

    subgraph Hub["AI GRID HUB CLUSTER"]
        HubLoki["Hub Loki gateway Route<br/>443/TCP HTTPS TLS<br/>Bearer hub-usage-logs-auth"]
        NooBaa["NooBaa S3<br/>443/TCP HTTPS TLS service-ca<br/>S3 keys"]
    end

    subgraph XKS["NON-OPENSHIFT CLUSTER (rhai-on-xks-chart)"]
        IGW["inference-gateway (Istio LB)<br/>80/TCP HTTP plaintext<br/>443/TCP HTTPS rhai-ca-issuer cert"]
        DefGW["default-gateway rh-ai-gateway<br/>443/TCP HTTPS + kube-auth-proxy OIDC"]
        RhaiOp["rhai-operator<br/>webhook 9443 TLS cert-manager<br/>metrics 8080 HTTP no auth<br/>health 8081 HTTP"]
        CloudMgr["cloud-manager-operator<br/>metrics 8080 HTTP, health 8081"]
        XAPI["kube-apiserver<br/>443/TCP HTTPS"]
    end

    AdminU -->|"HTTPS/6443 TLS 1.2+<br/>cluster-admin token"| KAPI
    AdminU -->|"HTTPS/443 TLS<br/>cluster-admin"| XAPI
    KAPI -->|"gRPC/50051 plaintext"| OLMCat

    Client -->|"HTTPS/443 TLS<br/>Bearer via Authorino"| MaaSRoute
    MaaSRoute -->|"reencrypt TLS"| MaaSGW
    MaaSGW -.->|"ext-auth"| Authorino
    MaaSGW -->|"HTTPS 443 to 8443<br/>TLS service-ca<br/>Authorization stripped"| GridGW
    GridGW -->|"HTTPS/443 mTLS Grid CA<br/>site SPIFFE identity"| PeerSites
    PeerSites -->|"HTTPS/443 mTLS<br/>named client cert"| ProvRoute
    ProvRoute -->|"passthrough to 8080"| GridProv
    GridProv -->|"HTTPS/443 TLS service-ca<br/>Bearer SA token"| InfGW
    SAToken -.->|mounted| GridProv
    SAToken -.->|mounted| GridGW
    InfGW --> KServe

    ACMColl -->|"HTTP/8890 plaintext<br/>no auth"| Collector
    Collector -->|"HTTPS/443 TLS<br/>Bearer token OTLP"| HubLoki
    HubLoki -->|"HTTPS/443 TLS<br/>S3 keys"| NooBaa

    Client -->|"HTTP/80 plaintext or<br/>HTTPS/443 TLS"| IGW
    Client -->|"HTTPS/443 TLS<br/>OIDC cookie session"| DefGW
    DefGW -->|"HTTPS/443 OIDC client secret"| OIDC
    XAPI -->|"HTTPS 443 to 9443<br/>webhook TLS"| RhaiOp
    CloudMgr -->|"HTTPS/443 SA token"| XAPI
    RhaiOp -.->|"image pull<br/>rhai-pull-secret"| Registries

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef hub fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,AdminU,PeerSites,OIDC,Registries external
    class MaaSGW,MaaSRoute,InfGW,ProvRoute,DefGW ingress
    class GridGW,GridMetrics,GridProv,KServe,Authorino,KAPI,ACMColl,XAPI,CloudMgr internal
    class Collector,SAToken,IGW,RhaiOp,OLMCat risk
    class HubLoki,NooBaa hub
