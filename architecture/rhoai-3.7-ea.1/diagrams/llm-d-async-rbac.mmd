graph TD
    subgraph SAG["Service Account (Helm chart)"]
        SA["fullname<br/>optional imagePullSecrets"]
    end

    subgraph Shipped["RBAC shipped by chart"]
        None["No ClusterRole, Role,<br/>or bindings shipped"]
    end

    subgraph Required["Required only when --metrics-endpoint-auth=true<br/>(grant outside chart)"]
        ExtBinding["ClusterRoleBinding<br/>(user-provided)"]
        ExtRole["ClusterRole<br/>(user-provided)"]
    end

    subgraph Resources["API Resources"]
        TR["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph Secrets["Secrets consumed (env / mount)"]
        Conn["Connection Secret (key url)<br/>REDIS_URL / SQL_URL"]
        TLS["ap.tls.secretName<br/>CA + client cert/key at /etc/tls"]
        GCP["GCP ADC<br/>workload identity / env"]
    end

    SA -.->|has| None
    SA -.->|bound via| ExtBinding
    ExtBinding -.->|grants| ExtRole
    ExtRole -.->|create| TR
    ExtRole -.->|create| SAR

    SA -->|pod uses| Conn
    SA -->|pod mounts| TLS
    SA -->|pod uses| GCP

    style SA fill:#4a90e2
    style None fill:#e8e8e8
    style ExtBinding fill:#f5a623,stroke-dasharray: 5 5
    style ExtRole fill:#f5a623,stroke-dasharray: 5 5
    style TR fill:#7ed321
    style SAR fill:#7ed321
    style Conn fill:#f8cecc
    style TLS fill:#f8cecc
    style GCP fill:#f8cecc
