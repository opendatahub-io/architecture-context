graph TB
    subgraph Image["odh-vllm-gaudi-rhel9 container image (UID 2000, GID 0, x86_64)"]
        direction TB
        APIServer["vLLM OpenAI API server<br/>python3 -m vllm.entrypoints.openai.api_server<br/>8000/TCP HTTP (upstream vLLM v0.16.0)"]
        Engine["vLLM engine<br/>(upstream, VLLM_TARGET_DEVICE=empty)"]

        subgraph Plugin["vllm_gaudi plugin (upstream Intel v0.16.0)"]
            direction TB
            Register["vllm_gaudi:register<br/>entry points: vllm.platform_plugins / vllm.general_plugins"]
            Platform["HpuPlatform<br/>device_name=hpu, dispatch_key=HPU"]
            Ops["HPU attention backends, fused MoE,<br/>quantization kernels (FP8, GPTQ, AWQ,<br/>compressed-tensors, ModelOpt), LoRA, Mamba/SSM"]
            KVConn["kv_transfer<br/>HPU NIXL connector<br/>+ hetero-layout connector (VLLM_HPU_HETERO_KV_LAYOUT)"]
            Offload["kv_offload.worker.cpu_hpu<br/>CPU to HPU KV offload"]
            Register --> Platform
            Register --> Ops
            Register --> KVConn
        end

        HabanaPT["Habana PyTorch modules<br/>PyTorch 2.9.0 HPU backend"]
        Synapse["Intel Gaudi SW / Synapse 1.23.0-695<br/>drivers, graph compiler"]

        APIServer --> Engine
        Engine -->|discovers plugin| Register
        Engine -->|runs on| Platform
        Platform --> HabanaPT
        Ops --> HabanaPT
        Offload --> HabanaPT
        HabanaPT --> Synapse
    end

    Client["Client / KServe ingress"] -->|HTTP 8000/TCP<br/>no auth by default| APIServer
    KServe["KServe<br/>(ServingRuntime / InferenceService)"] -->|deploys image| Image
    Templates["odh-model-controller / odh-dashboard<br/>ServingRuntime templates"] -.->|reference image| KServe
    DevicePlugin["Intel Gaudi device plugin<br/>habana.ai/gaudi"] -->|allocates HPU| Synapse
    KVConn -.->|NIXL/UCX optional<br/>no auth/encryption| Peer["Peer prefill/decode instance"]
    Engine -->|HTTPS 443| Storage["Model storage<br/>S3 / HF Hub / PVC"]

    DevImages[".cd/* and tests Dockerfiles<br/>upstream dev/CI only, not built by Konflux"]

    style APIServer fill:#4a90e2
    style Engine fill:#4a90e2
    style Register fill:#4a90e2
    style Platform fill:#4a90e2
    style Ops fill:#4a90e2
    style KVConn fill:#4a90e2
    style Offload fill:#4a90e2
    style HabanaPT fill:#e8e8e8
    style Synapse fill:#e8e8e8
    style DevicePlugin fill:#e8e8e8
    style Storage fill:#f5a623
    style Peer fill:#f5a623
    style KServe fill:#7ed321
    style Templates fill:#7ed321
    style DevImages fill:#f0f0f0,stroke-dasharray: 5 5
