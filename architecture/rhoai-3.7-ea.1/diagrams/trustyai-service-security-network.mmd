graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / ODH Dashboard<br/>Bearer token"]
    end

    subgraph Ingress["INGRESS (operator-managed)"]
        Route["OpenShift Route<br/>443/TCP HTTPS TLS"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy in repo)"]
        KServe["KServe InferenceService logger<br/>(optionally via Knative)"]
        MM["ModelMesh payload processor"]
        Prom["Prometheus / UWM"]
        Kubelet["kubelet probes"]

        subgraph NS["Namespace: user namespace (one instance per TrustyAIService CR)"]
            subgraph Pod["TrustyAI Service Pod - USER 1001"]
                KRP["kube-rbac-proxy sidecar<br/>TokenReview + SAR<br/>(RBAC by operator)"]
                App8081["Main app HTTP<br/>127.0.0.1:8081 loopback<br/>no in-app auth"]
                App4443["Main app HTTPS<br/>0.0.0.0:4443<br/>TLS system policy or TLSv1.2/1.3 configured<br/>NO AUTH"]
                Health8080["health_app HTTP<br/>0.0.0.0:8080 plaintext<br/>NO AUTH, ingest + probes"]
            end
            PVC[("PVC HDF5<br/>file I/O")]
        end
    end

    subgraph ExtSvc["EXTERNAL / SHARED SERVICES (optional)"]
        Maria[("MariaDB<br/>3306/TCP")]
        PG[("PostgreSQL<br/>5432/TCP")]
    end

    User -->|"HTTPS/443<br/>TLS<br/>Bearer token"| Route
    Route -->|"HTTPS to proxy port<br/>TLS"| KRP
    KRP -->|"HTTP/8081 loopback<br/>pod-local, plaintext<br/>already authorized"| App8081
    KServe -->|"HTTP/8080 POST /<br/>plaintext<br/>NO AUTH"| Health8080
    MM -->|"HTTP/8080 POST /consumer/kserve/v2<br/>plaintext<br/>NO AUTH"| Health8080
    Kubelet -->|"HTTP/8080 /q/health*<br/>no auth"| Health8080
    Prom -->|"HTTPS/4443 GET /q/metrics<br/>TLS<br/>per ServiceMonitor"| App4443
    App8081 -->|"file I/O"| PVC
    App8081 -->|"MariaDB/3306<br/>TLS ssl_verify_cert if CA mounted<br/>UNVERIFIED by default otherwise<br/>username/password"| Maria
    App8081 -->|"PostgreSQL/5432<br/>sslmode=verify-full if CA mounted<br/>UNVERIFIED by default otherwise<br/>username/password"| PG

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Route ingress
    class KServe,MM,Prom,Kubelet,KRP,App8081,PVC internal
    class App4443,Health8080 risk
    class Maria,PG externalservice
