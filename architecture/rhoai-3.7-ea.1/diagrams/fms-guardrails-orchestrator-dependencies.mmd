graph LR
    Orch["FMS Guardrails Orchestrator<br/>fms-guardrails-orchestr8 0.18.3"]

    %% Internal platform dependencies
    Orch -->|"REST Detector API"| Detectors["Guardrails detector services<br/>guardrails-detectors, regex, HF runtime"]
    Orch -->|"gRPC chunking"| Chunkers["caikit chunker services"]
    Orch -->|"gRPC generation"| TGIS["TGIS generation server"]
    Orch -->|"gRPC generation (provider: nlp)"| NLP["caikit-nlp"]
    Orch -->|"REST completions + /tokenize"| LLM["vLLM / KServe InferenceService<br/>OpenAI-compatible"]
    Orch -.->|"OTLP traces/metrics (optional)"| OTel["OpenTelemetry collector"]

    %% Integration points (inbound)
    Ingress["Platform ingress / auth proxy<br/>(deployer-provided)"] -->|"HTTP(S)/8033 + X-Forwarded-Access-Token"| Orch
    Deployer["Deploying operator (TrustyAI stack)<br/>not established for this release"] -.->|"renders config, deploys image"| Orch

    %% Key external libraries
    Orch -->|"async runtime"| Tokio["tokio 1.49"]
    Orch -->|"HTTP server"| Axum["axum 0.8 / hyper 1.8"]
    Orch -->|"gRPC clients"| Tonic["tonic 0.14 + ginepro fork (git)"]
    Orch -->|"TLS"| Rustls["rustls 0.23 + ring 0.17<br/>(not FIPS validated)"]
    Orch -->|"OTLP HTTP exporter"| OpenSSL["reqwest native-tls<br/>system OpenSSL (dynamic)"]
    Orch -->|"telemetry"| OTelSDK["opentelemetry 0.31"]

    style Orch fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Detectors fill:#7ed321,stroke:#333
    style Chunkers fill:#7ed321,stroke:#333
    style TGIS fill:#7ed321,stroke:#333
    style NLP fill:#7ed321,stroke:#333
    style LLM fill:#7ed321,stroke:#333
    style Ingress fill:#7ed321,stroke:#333
    style Deployer fill:#7ed321,stroke:#333,stroke-dasharray: 5 5
    style OTel fill:#f5a623,stroke:#333
    style Tokio fill:#999,stroke:#333
    style Axum fill:#999,stroke:#333
    style Tonic fill:#999,stroke:#333
    style Rustls fill:#999,stroke:#333
    style OpenSSL fill:#999,stroke:#333
    style OTelSDK fill:#999,stroke:#333
