graph TB
    Admin["Admin / rhods-operator"] -->|creates| MLflowCR["MLflow CR<br/>mlflow.opendatahub.io/v1<br/>Cluster, name=mlflow"]
    Platform["rhods-operator"] -->|creates| ModuleCR["MLflowOperator CR<br/>components.platform.opendatahub.io/v1alpha1"]
    Platform -->|owns| AuthCR["Auth CR<br/>services.platform.opendatahub.io"]
    Tenant["Namespace admin"] -->|creates| MLflowConfigCR["MLflowConfig CR<br/>mlflow.kubeflow.org/v1<br/>Namespaced"]

    subgraph Operator["mlflow-operator manager (redhat-ods-applications)"]
        Manager["manager /manager<br/>:8081 health, :8443 metrics<br/>leader election"]
        MLflowRec[MLflowReconciler]
        ModuleRec["MLflowOperatorReconciler<br/>ENABLE_MLFLOW_OPERATOR_MODULE_CONTROLLER=false"]
        NsRBACRec["NamespaceRBACReconciler<br/>ENABLE_NAMESPACE_RBAC=true"]
        Chart["Embedded Helm chart<br/>charts/mlflow"]
        Migration["Migration logic<br/>scale-to-zero then Job"]
        Manager --- MLflowRec
        Manager --- ModuleRec
        Manager --- NsRBACRec
        MLflowRec -->|renders| Chart
        MLflowRec -->|runs| Migration
    end

    MLflowCR -->|watched by| MLflowRec
    ModuleCR -->|watched by| ModuleRec
    AuthCR -->|read by| NsRBACRec

    subgraph Operands["Operands (redhat-ods-applications)"]
        Tracking["mlflow Deployment + Service<br/>HTTPS 8443<br/>kubernetes-auth, kubernetes:// workspaces"]
        Artifacts["mlflow-artifacts Deployment + Service<br/>HTTPS 8443, optional"]
        Res["SA mlflow-sa, ClusterRole/Binding,<br/>PVC, NetworkPolicy, ServiceMonitor"]
        Cron["CronJobs: GC, trace archival,<br/>trace rollups"]
        MigJob["Migration Job"]
    end

    Chart -->|server-side apply| Tracking
    Chart -->|server-side apply| Artifacts
    Chart -->|server-side apply| Res
    Chart -->|server-side apply| Cron
    Migration -->|creates| MigJob

    MLflowRec -->|creates| HTTPRoute["HTTPRoutes mlflow / mlflow-artifacts<br/>parent data-science-gateway"]
    MLflowRec -->|creates| ConsoleLink["ConsoleLink<br/>application menu"]
    NsRBACRec -->|creates| RB["RoleBindings odh-group-mlflow-view/edit<br/>in labeled workspace namespaces"]

    HTTPRoute -->|routes to| Tracking
    HTTPRoute -->|routes to| Artifacts
    Tracking -->|reads| MLflowConfigCR
    Tracking -->|SSAR| K8sAPI[Kubernetes API]
    Tracking -->|SQL| DB["PostgreSQL / MySQL / SQLite"]
    Tracking -->|artifacts| Storage["S3 object storage or PVC"]
    Artifacts -->|artifacts| Storage

