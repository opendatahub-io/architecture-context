graph TB
    User["User / Admin<br/>(Browser)"]
    Agent["AI Coding Agent / Human<br/>prism-results CLI"]

    subgraph CloudRun["Google Cloud Run: service prism (us-central1)"]
        Edge["Cloud Run Front End<br/>prism.llm-d.ai 443/TCP<br/>Google-managed TLS"]
        subgraph Prism["Prism container (node:26-alpine, 8080/TCP HTTP)"]
            Server["Prism Server<br/>server/server.js<br/>Express BFF via tsx"]
            OAuth["OAuth Router<br/>server/oauth.ts"]
            IAM["IAM Module<br/>server/iam.ts<br/>allowlists + Playground Mode"]
            Results["Results Store<br/>server/results/"]
            Avatar["Avatar Router<br/>server/avatar.ts"]
            SPA["Prism SPA bundle<br/>dist/ (React 19 + Vite + Recharts)"]
            Tooling["Agent Tooling<br/>prism.mjs, SKILL.md, llms.txt,<br/>.well-known/agent.json"]
        end
    end

    LocalDir["PRISM_LOCAL_DIR<br/>local dir / PVC hook"]

    subgraph GCP["Google Cloud (SaaS)"]
        GCS["Google Cloud Storage<br/>bucket llm-d-benchmarks<br/>results-store prefix + prism-iam/"]
        GIQ["GKE Inference Quickstart<br/>gkerecommender.googleapis.com"]
    end

    GitHub["GitHub OAuth + REST API<br/>github.com / api.github.com"]
    ClientSrc["Browser-side sources<br/>S3, Google Drive, googletagmanager"]
    Harness["llm-d benchmark harnesses<br/>BRv0.2 reports"]

    User -->|HTTPS 443| Edge
    Agent -->|HTTPS 443<br/>X-Prism-Github-Token| Edge
    Edge -->|HTTP 8080| Server
    Server -->|serves| SPA
    Server --> OAuth
    Server --> Results
    Server --> Avatar
    Results -->|serves| Tooling
    Results -->|permission check| IAM
    OAuth -->|permission merge| IAM

    Server -->|"/api/gcs/* proxy<br/>ADC"| GCS
    Server -->|"/api/giq/* proxy<br/>ADC or user Bearer"| GIQ
    Server -->|reads| LocalDir
    Results -->|read/write runs<br/>ADC| GCS
    IAM -->|reads allowlists<br/>ADC| GCS
    OAuth -->|token exchange,<br/>user + org membership| GitHub
    User -.->|client-side fetch| ClientSrc
    Harness -.->|produce reports| GCS

