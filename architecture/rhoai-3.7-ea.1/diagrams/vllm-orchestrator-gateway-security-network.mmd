graph TB
    subgraph External["CLIENT ZONE (trust depends on deployer)"]
        Client["Client<br/>OpenAI-compatible SDK"]
    end

    subgraph Front["FRONTING PROXY (deployer-provided, not in repo)"]
        Proxy["Auth Proxy<br/>Inbound TLS termination<br/>Authentication"]
    end

    subgraph Pod["GATEWAY POD (historically same pod as orchestrator)"]
        direction TB
        Gateway["vllm-orchestrator-gateway<br/>0.0.0.0:8090/TCP plain HTTP<br/>No in-process AuthN/AuthZ<br/>No health/metrics endpoints<br/>Logs tokens + payloads at DEBUG"]
        Certs["Mounted files<br/>/etc/tls/private/tls.crt,key<br/>/etc/tls/ca/service-ca.crt"]
        Orchestrator["FMS Guardrails Orchestrator<br/>localhost:8085 baked config<br/>/api/v2/chat/completions-detection"]
    end

    subgraph Backends["ORCHESTRATOR BACKENDS (orchestrator-defined)"]
        Detectors["Detector servers<br/>regex / guardrails-detectors"]
        Model["vLLM / OpenAI-compatible<br/>model server"]
    end

    Client -->|"HTTPS (proxy-defined)<br/>Bearer token"| Proxy
    Proxy -->|"HTTP/8090<br/>Plaintext<br/>Bearer forwarded"| Gateway
    Certs -.->|read at startup| Gateway
    Gateway -->|"HTTP or HTTPS/8085<br/>TLS system defaults if certs present<br/>Optional mTLS client cert<br/>Bearer + x-forwarded-*<br/>Hostname check OFF for localhost"| Orchestrator
    Orchestrator -->|"HTTP(S)<br/>orchestrator-defined"| Detectors
    Orchestrator -->|"HTTP(S)<br/>orchestrator-defined"| Model

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Proxy ingress
    class Gateway risk
    class Certs,Orchestrator internal
    class Detectors,Model externalservice
