graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        EndUser["End User"]
        ExtClient["External Client<br/>(legacy mode)"]
    end

    subgraph IngressZone["INGRESS / FRONT DOOR"]
        PraxisGW["Praxis Gateway<br/>NS: praxis-standalone<br/>443/TCP HTTPS TLS<br/>Platform auth"]
        IngCtl["Ingress Controller / Router<br/>Ingress networking.k8s.io/v1<br/>443/TCP edge TLS<br/>Secret: externalAccess.tls.secretName"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        KAPI["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
        OCPAPI["config.openshift.io APIServer cluster<br/>TLS profile"]
    end

    subgraph AppNS["Namespace: applications (redhat-ods-applications)"]
        Module["ogx-module manager<br/>SA: opendatahub-ogx-operator<br/>metrics 8443/TCP HTTPS, NO authn<br/>health 8081/TCP HTTP"]
        Operator["OGX operator manager<br/>SA: ogx-k8s-operator-controller-manager<br/>health 8081/TCP HTTP"]
        WebhookSvc["ogx-k8s-operator-webhook-service<br/>443→9443/TCP HTTPS<br/>service-CA cert, cluster TLS profile"]
        MetricsSvc["ogx-k8s-operator-controller-manager-metrics-service<br/>8443/TCP HTTPS<br/>Bearer → TokenReview/SAR"]
        ModMetrics["opendatahub-ogx-metrics-service<br/>8443/TCP HTTPS<br/>no auth"]
    end

    subgraph TenantNS["Namespace: OGXServer namespace (tenant)"]
        NetPol["NetworkPolicy<br/>Praxis: Praxis pods + operator NS<br/>Legacy: same NS + router"]
        OGXSvc["name-service ClusterIP<br/>8321/TCP HTTP<br/>no TLS from operator"]
        OGXPod["OGX server pod<br/>SA: per-OGXServer<br/>SCC: nonroot-v2<br/>Praxis: header auth x-user-id/x-tenant-id"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Registry["Container Registry<br/>docker.io / quay.io<br/>443/TCP HTTPS, 80/TCP HTTP fallback<br/>Anonymous"]
        Backends["Inference Providers / SQL / KV<br/>provider-specific HTTPS/TCP<br/>Secret-injected credentials"]
        Prom["Prometheus / platform monitoring"]
    end

    EndUser -->|HTTPS/443<br/>TLS<br/>Platform auth| PraxisGW
    ExtClient -->|HTTPS/443<br/>TLS edge<br/>Distribution-defined| IngCtl
    PraxisGW -->|HTTP/8321<br/>mTLS expected, not wired<br/>x-user-id / x-tenant-id| OGXSvc
    IngCtl -->|HTTP/8321<br/>plaintext<br/>Distribution-defined| OGXSvc
    OGXSvc --> OGXPod
    NetPol -.->|guards| OGXPod

    KAPI -->|HTTPS/9443<br/>TLS cluster profile<br/>Admission, service-CA| WebhookSvc
    WebhookSvc --> Operator
    Operator -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| KAPI
    Module -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| KAPI
    Operator -->|reads TLS profile| OCPAPI
    Module -->|reads TLS profile| OCPAPI
    Operator -->|HTTP/8321<br/>plaintext, no auth<br/>status polling| OGXSvc
    Operator -->|HTTPS/443 or HTTP/80<br/>downgrade fallback<br/>Anonymous| Registry
    OGXPod -->|HTTPS/TCP<br/>CA bundle mounted<br/>Secret credentials| Backends
    Prom -->|HTTPS/8443<br/>Bearer token| MetricsSvc
    Prom -->|HTTPS/8443<br/>no auth| ModMetrics
    MetricsSvc --> Operator
    ModMetrics --> Module

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class EndUser,ExtClient external
    class PraxisGW,IngCtl ingress
    class KAPI,OCPAPI control
    class Operator,WebhookSvc,MetricsSvc,Module internal
    class ModMetrics risk
    class NetPol,OGXSvc,OGXPod tenant
    class Registry,Backends,Prom externalservice
