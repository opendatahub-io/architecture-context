graph TD
    subgraph Runtime["Runtime (shipped data image)"]
        Img["odh-model-metadata-collection-rhel9<br/>USER 1001 (catalog)"]
        NoSA["No ServiceAccount, Role, ClusterRole<br/>or bindings defined in this repo"]
        NoAPI["No Kubernetes API access<br/>No inbound endpoints"]
        Img --- NoSA
        Img --- NoAPI
    end

    subgraph Consumer["Access control delegated to consumer"]
        Op["rhods-operator /<br/>model-registry-operator<br/>(owns pod SA and RBAC)"]
        MR["model-registry catalog service<br/>(enforces catalog API AuthN/AuthZ)"]
        Op -->|deploys| MR
    end

    Img -->|"/app/data files 0644 (read-only)"| MR

    subgraph BuildCreds["Build-time credentials (not in image, not K8s RBAC)"]
        HF["HF_TOKEN<br/>env / .env (gitignored)"]
        GH["GITHUB_TOKEN<br/>env"]
        RegAuth["Registry auth file /<br/>Docker keychain"]
        Quay["QUAY_USERNAME / QUAY_PASSWORD<br/>GitHub Actions secret"]
        GitAuth["git_auth_secret<br/>Tekton workspace secret"]
    end

    HF -->|Bearer, optional| HFHub["huggingface.co"]
    GH -->|Bearer, optional| GHAPI["GitHub API / raw"]
    RegAuth -->|pull| RHReg["registry.redhat.io"]
    Quay -->|push| QuayODH["quay.io/opendatahub"]
    GitAuth -->|clone| Konflux["Konflux pipeline"]

    style Img fill:#4a90e2
    style NoSA fill:#e8e8e8,stroke-dasharray: 5 5
    style NoAPI fill:#e8e8e8,stroke-dasharray: 5 5
    style Op fill:#7ed321
    style MR fill:#7ed321
    style HF fill:#f8cecc
    style GH fill:#f8cecc
    style RegAuth fill:#f8cecc
    style Quay fill:#f8cecc
    style GitAuth fill:#f8cecc
