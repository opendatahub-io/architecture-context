%%{init: {'theme':'base'}}%%
graph LR
    subgraph Inventory["Platform Inventory - RHOAI 3.7-ea.1"]
        direction TB
        A1["Total Components: 95<br/>94 documented + odh-dashboard inventory-only"]
        A2["Operator/controller components: 34<br/>~15 module operators via rhods-operator"]
        A3["CRDs: 216 in 51 API groups"]
        A4["Network surface: 282 Services,<br/>747 endpoints, 94 gRPC services"]
        A5["Container images: 132 digest-pinned"]
        A6["RBAC: 1,447 role records,<br/>714 controller watches"]
    end

    subgraph API["API Maturity"]
        direction TB
        B1["v1alpha1: 134 CRDs - 62%"]
        B2["v1beta1: 22 - v1: 22"]
        B3["Others: v1alpha2, v1beta2, v2beta1,<br/>v3 DataScienceCluster"]
        B4["Conversion webhooks: kserve, kubeflow,<br/>model-registry, mcp-lifecycle, workbenches"]
    end

    subgraph Security["Security Posture"]
        direction TB
        C1["Gateway auth: 3 different stacks<br/>kube-auth-proxy, Authorino SAR, Authorino API keys"]
        C2["mTLS: MIXED<br/>no mesh-wide STRICT observed"]
        C3["Backend TLS: insecureSkipVerify<br/>on 5+ gateway hops"]
        C4["FIPS: Partial<br/>CSV fips-compliant false"]
        C5["Cluster TLS-profile propagation<br/>broad and consistent"]
        C6["Admission: 225 webhook entries<br/>20 components, all Fail"]
    end

    subgraph Ingress["Gateway API Coverage"]
        direction TB
        D1["High: dashboard, workbenches, MLflow,<br/>model registry, Ray, GenAI serving"]
        D2["Partial: pipelines, TrustyAI, observability,<br/>Feast, raw ISVC on reencrypt Routes"]
        D3["Unresolved joins: odh-gateway,<br/>llm-d-inference-gateway"]
    end

    subgraph Deploy["Deployment Readiness"]
        direction TB
        E1["HA: rhods-operator 3 replicas<br/>most module operators 1 replica"]
        E2["Request-path SPOFs: maas-api,<br/>praxis-extproc, workbenches-operator"]
        E3["Disconnected: Supported<br/>digest pinning + image-embedded manifests"]
        E4["Multi-arch: amd64 full<br/>arm64, ppc64le, s390x partial"]
        E5["Version drift: 21 manifest refs<br/>pinned to rhoai-3.6"]
    end

    subgraph Gaps["Evidence Gaps"]
        direction TB
        F1["HA, disconnected, supply-chain topics:<br/>no deterministic evidence"]
        F2["NetworkPolicy + Dockerfile inventory: 0"]
        F3["rhods-operator webhooks missing<br/>from structured inventory"]
    end

    Inventory --> API
    Inventory --> Security
    Security --> Ingress
    Ingress --> Deploy
    Deploy --> Gaps

