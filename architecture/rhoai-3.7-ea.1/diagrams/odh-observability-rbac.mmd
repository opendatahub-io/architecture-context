graph TD
    subgraph SAs["Service Accounts"]
        OpSA["fullname<br/>operator SA"]
        PromSA[data-science-monitoringstack-prometheus]
        OTelOpSA[opentelemetry-operator-controller-manager]
        ProxySA["data-science-*-proxy SAs<br/>namespace, thanos-querier, cluster"]
        CollSA[data-science-collector-collector]
        TASA[TargetAllocator SA]
        K8rSA[Korrel8r SA]
        ULSA[usage-logs collector SA]
        CLFSA[CLF collector SA]
    end

    subgraph Roles["ClusterRoles / Roles"]
        Mgr["fullname-manager<br/>ClusterRole"]
        MReader["fullname-metrics-reader"]
        CMRole[odh-observability-opentelemetry-cert-manager]
        CMV["cluster-monitoring-view<br/>+ system:auth-delegator"]
        GenProc["generate-processors-role<br/>tempo-trace-export, mlflow-trace-export"]
        GenTA["generate-processors-targetallocator-role<br/>+ targetallocator-secrets Role per allowlisted ns"]
        K8rQ["korrel8r-query<br/>+ system:auth-delegator"]
        ULP[data-science-usage-logs-processor]
        CLFR["collect-application-logs<br/>cluster-logging-write-application-logs"]
    end

    OpSA -->|ClusterRoleBinding| Mgr
    PromSA -->|ClusterRoleBinding| MReader
    OTelOpSA -->|ClusterRoleBinding| CMRole
    ProxySA -->|ClusterRoleBindings| CMV
    CollSA -->|ClusterRoleBindings| GenProc
    TASA -->|"ClusterRoleBinding + RoleBindings"| GenTA
    K8rSA -->|ClusterRoleBindings| K8rQ
    ULSA -->|ClusterRoleBinding| ULP
    CLFSA -->|ClusterRoleBindings| CLFR

    subgraph HighRisk["Operator grants - high risk"]
        Secrets["core: secrets, configmaps, services, SAs<br/>full CRUD cluster-wide"]
        Monitors["monitoring.coreos.com<br/>podmonitors, servicemonitors: *"]
        RBAC["rbac.authorization.k8s.io<br/>get, list, watch, create<br/>update/patch/delete named only"]
        AuthN["tokenreviews, subjectaccessreviews: create"]
    end

    subgraph OperandCRs["Operator grants - operand CRs (full CRUD)"]
        Svc["services.platform.opendatahub.io<br/>monitorings + status/finalizers"]
        RHOBS["monitoring.rhobs<br/>monitoringstacks, thanosqueriers, monitors, rules"]
        TempoG["tempo.grafana.com<br/>tempomonolithics, tempostacks"]
        OTelG["opentelemetry.io<br/>collectors, instrumentations"]
        LokiG["loki.grafana.com lokistacks<br/>observability.openshift.io clusterlogforwarders"]
        PersesG["perses.dev<br/>perses, datasources, dashboards"]
        Admission["admissionregistration.k8s.io<br/>validatingadmissionpolicies, bindings"]
        Work["apps deployments, batch jobs,<br/>networkpolicies, routes, leases"]
    end

    subgraph ReadOnly["Operator grants - read"]
        Read["pods, namespaces, nodes, nodes/metrics, endpoints,<br/>CRDs, apiservers, infrastructures,<br/>operatorconditions, CSVs, clusterextensions,<br/>serving.kserve.io inferenceservices"]
        NonRes["nonResourceURLs /metrics, /api/*, /apis/*: get"]
    end

    Mgr --> Secrets
    Mgr --> Monitors
    Mgr --> RBAC
    Mgr --> AuthN
    Mgr --> Svc
    Mgr --> RHOBS
    Mgr --> TempoG
    Mgr --> OTelG
    Mgr --> LokiG
    Mgr --> PersesG
    Mgr --> Admission
    Mgr --> Work
    Mgr --> Read
    Mgr --> NonRes
    Mgr -->|update| MLflowE["mlflow.kubeflow.org experiments"]
    CMRole -->|full CRUD| CertM["cert-manager.io<br/>issuers, certificates, certificaterequests"]
    MReader -->|get| MetricsURL["/metrics"]

    style OpSA fill:#4a90e2
    style Mgr fill:#f5a623
    style Secrets fill:#e74c3c,color:#fff
    style Monitors fill:#e74c3c,color:#fff
    style RBAC fill:#e74c3c,color:#fff
    style AuthN fill:#f39c12
    style Svc fill:#7ed321
    style RHOBS fill:#7ed321
    style TempoG fill:#7ed321
    style OTelG fill:#7ed321
    style LokiG fill:#7ed321
    style PersesG fill:#7ed321
    style Admission fill:#7ed321
    style Work fill:#7ed321
