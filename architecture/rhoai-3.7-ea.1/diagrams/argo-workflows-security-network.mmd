graph TB
    subgraph Monitoring["MONITORING NAMESPACES (openshift-monitoring, user-workload, redhat-ods-monitoring)"]
        Prom["Prometheus"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+"]
    end

    subgraph DSPANS["DSPA NAMESPACE (tenant boundary)"]
        KFP["KFP API Server<br/>SA: ds-pipeline-&lt;dspa&gt;"]
        subgraph CtrlPod["workflow-controller pod (USER 8737)"]
            Controller["workflow-controller<br/>9090/TCP HTTPS metrics, self-signed ECDSA P-256<br/>6060/TCP HTTP /healthz, no auth<br/>pprof only if ARGO_PPROF=true"]
        end
        NP["NetworkPolicy (DSPO)<br/>9090 ingress: monitoring namespaces only"]
        subgraph Workload["Workflow step / agent pods (USER 2000)"]
            Exec["argoexec init / wait<br/>SA: pipeline-runner-&lt;dspa&gt;<br/>no listening ports"]
            Agent["argoexec agent<br/>HTTP templates"]
        end
        Secrets["Secrets<br/>artifact repo credentials<br/>argo-workflows-agent-ca-certificates"]
    end

    subgraph External["EXTERNAL SERVICES (egress unrestricted by this repo)"]
        S3["Object Storage<br/>S3/MinIO, GCS, Azure, OSS<br/>443/TCP HTTPS TLS 1.2+<br/>HTTP if insecure config"]
        HDFS["HDFS<br/>Kerberos"]
        Git["Git Remotes<br/>443/TCP HTTPS, 22/TCP SSH"]
        UserHTTP["User HTTP Endpoints<br/>any port, TLS optional"]
    end

    subgraph NotShipped["NOT SHIPPED IN RHOAI (upstream source only)"]
        ArgoServer["argo-server<br/>2746/TCP HTTPS + gRPC, TLS 1.2+<br/>Bearer / SSO OIDC"]
    end

    Prom -->|"HTTPS/9090<br/>TLS self-signed<br/>no auth (NetworkPolicy)"| Controller
    NP -.->|restricts| Controller
    KFP -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token: create Workflow"| K8sAPI
    Controller -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>SA token: watch/CRUD Pods, CRs, Leases"| K8sAPI
    Exec -->|"HTTPS/6443<br/>TLS 1.2+<br/>Pod SA: WorkflowTaskResult, read Secrets"| K8sAPI
    Agent -->|"HTTPS/6443<br/>TLS 1.2+<br/>Pod SA: patch WorkflowTaskSet"| K8sAPI
    Secrets -.->|mounted / read| Exec
    Exec -->|"HTTPS/443<br/>TLS 1.2+<br/>access keys / cloud identity"| S3
    Controller -->|"HTTPS/443<br/>artifact GC"| S3
    Exec -->|"HDFS RPC<br/>Kerberos"| HDFS
    Exec -->|"HTTPS/443 or SSH/22<br/>Secret creds, ssh_known_hosts"| Git
    Agent -->|"HTTP/HTTPS any<br/>insecureSkipVerify per template<br/>template headers"| UserHTTP
    ArgoServer -.->|not deployed| K8sAPI

    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tenant fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef notshipped fill:#eeeeee,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class Prom monitoring
    class K8sAPI control
    class KFP,Controller,Exec,NP,Secrets tenant
    class Agent risk
    class S3,HDFS,Git,UserHTTP externalservice
    class ArgoServer notshipped
