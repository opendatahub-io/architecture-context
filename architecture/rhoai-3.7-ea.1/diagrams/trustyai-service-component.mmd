graph TB
    subgraph Pod["TrustyAI Service Pod (one per namespace, deployed by trustyai-service-operator)"]
        KRP["kube-rbac-proxy sidecar<br/>(provisioned by operator)"]

        subgraph Proc["Python process: python -m trustyai_service.main (asyncio.gather)"]
            App["Main app (FastAPI)<br/>HTTP 127.0.0.1:8081<br/>HTTPS 0.0.0.0:4443 (if certs mounted)"]
            Health["health_app (FastAPI)<br/>HTTP 0.0.0.0:8080<br/>/q/health*, POST /, POST /consumer/kserve/v2"]
            MW["Middleware<br/>CORS * with credentials<br/>Gzip decompress 16 MB cap<br/>Trailing-slash strip"]
            Sched["Prometheus scheduler<br/>asyncio task, every 30s<br/>SERVICE_METRICS_SCHEDULE"]
            Metrics["Metric engines<br/>Fairness: SPD, DIR<br/>Drift: CompareMeans, KS, streaming KS,<br/>Jensen-Shannon, MMD<br/>BatchMean"]
            Explain["Explainers LIME/SHAP/CF/TSSaliency/PDP<br/>disabled by default, 501 Not Implemented"]
            Storage["GlobalStorageInterface<br/>SERVICE_STORAGE_FORMAT:<br/>PVC, DATABASE, MARIA, POSTGRESQL, SQLITE"]
            Gauges["Prometheus gauges<br/>GET /q/metrics"]
        end
        Migrate["trustyai-migrate CLI<br/>one-shot legacy data migration"]
    end

    KRP -->|"proxy to 127.0.0.1:8081"| App
    App --> MW
    Health --> MW
    App -->|register metric requests| Sched
    Sched -->|reads data| Storage
    Sched -->|computes| Metrics
    Metrics -->|updates| Gauges
    App -.->|feature flag explainer| Explain
    Health -->|persist joined request/response rows| Storage
    App -->|data upload, info| Storage

    KServe["KServe InferenceService logger<br/>CloudEvents"] -->|"POST / 8080/TCP HTTP"| Health
    ModelMesh["ModelMesh payload processor"] -->|"POST /consumer/kserve/v2 8080/TCP HTTP"| Health
    User["User / ODH Dashboard"] -->|"Route 443 HTTPS Bearer"| KRP
    Prom["Prometheus / UWM"] -->|"scrape /q/metrics"| Gauges
    Kubelet["kubelet probes"] -->|"/q/health 8080"| Health

    Storage -->|"h5py file I/O"| PVC[("PVC HDF5")]
    Storage -->|"3306/TCP TLS if CA"| Maria[("MariaDB")]
    Storage -->|"5432/TCP verify-full if CA"| PG[("PostgreSQL")]
    Storage -->|file| SQLite[("SQLite")]
    Migrate -->|"legacy PVC/CSV or MariaDB"| Maria
    Migrate -->|"canonical SQL schema"| PG

    Operator["trustyai-service-operator<br/>TrustyAIService CR"] -.->|"deploys, env vars, mounts TLS/DB secrets"| Pod

