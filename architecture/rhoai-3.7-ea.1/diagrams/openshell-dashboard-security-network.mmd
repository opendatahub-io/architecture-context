graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph IngressZone["INGRESS (namespace: openshift-ingress)"]
        Router["OpenShift Router / Gateway API listener<br/>443/TCP HTTPS<br/>TLS: edge, reencrypt, or terminate<br/>insecure -> Redirect<br/>timeout 300s, tunnel 1h"]
    end

    subgraph NS["Namespace: openshell (NetworkPolicy: ingress 4180 only, from openshift-ingress; egress unrestricted)"]
        subgraph PodZone["openshell-dashboard Pod (automountServiceAccountToken: false, UID 65532)"]
            Proxy["oauth2-proxy sidecar<br/>4180/TCP HTTP or HTTPS<br/>OIDC session cookie<br/>skip-jwt-bearer-tokens=false"]
            BFF["BFF (Go)<br/>127.0.0.1:8080/TCP HTTP<br/>Trusts token header, no validation<br/>WebSocket Origin check"]
        end
        Gateway["OpenShell gateway<br/>openshell.&lt;ns&gt;.svc:8080/TCP<br/>gRPC TLS 1.2+<br/>Validates JWT, enforces RBAC + workspace membership"]
    end

    subgraph IdP["IDENTITY PROVIDER"]
        OIDC["OIDC issuer (Keycloak)<br/>443/TCP or 8443/TCP HTTPS<br/>realm: openshell<br/>client: openshell-api"]
    end

    Browser -->|"HTTPS/443<br/>TLS<br/>Session cookie"| Router
    Router -->|"HTTP or HTTPS/4180<br/>None (edge) / TLS (reencrypt)<br/>Session cookie"| Proxy
    Browser -.->|"HTTPS/443 redirect<br/>OIDC auth code + PKCE"| OIDC
    Proxy -->|"HTTPS/443<br/>TLS<br/>OIDC client secret"| OIDC
    Proxy -->|"HTTP/8080 loopback<br/>No encryption<br/>X-Forwarded-Access-Token"| BFF
    BFF -->|"gRPC/8080<br/>TLS 1.2+ (optional mTLS)<br/>Bearer user token per RPC"| Gateway
    Gateway -->|"HTTPS/443<br/>TLS<br/>JWKS (public)"| OIDC

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef loopback fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef idp fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Router ingress
    class Proxy,Gateway internal
    class BFF loopback
    class OIDC idp
