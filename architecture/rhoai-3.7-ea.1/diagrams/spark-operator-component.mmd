graph TB
    %% Platform layer
    ODHOp["opendatahub-operator<br/>rhods-operator"]
    SparkOpCR["SparkOperator CR<br/>components.platform.opendatahub.io/v1alpha1<br/>cluster-scoped singleton: default-sparkoperator"]

    subgraph ModuleNS["Module tier - odh-spark-operator-module-controller image"]
        Module["spark-operator-module-controller-manager<br/>Go controller-runtime, odh-platform-utilities<br/>health :8081"]
        Manifests["/opt/manifests-template<br/>baked config/ tree<br/>overlays/rhoai or overlays/odh"]
        Module -->|renders kustomize| Manifests
    end

    subgraph Operand["Workload operator - redhat-ods-applications - odh-spark-operator image"]
        subgraph CtrlDep["spark-operator-controller Deployment: controller start"]
            SAppCtrl["SparkApplication controller<br/>spark-submit in-process<br/>JDK 17 + PySpark 4.0.4"]
            SchedCtrl["ScheduledSparkApplication controller<br/>robfig/cron"]
            ConnCtrl["SparkConnect controller"]
            NPCtrl["Operand NetworkPolicy reconciler<br/>OperandNetworkPolicy=true"]
            TLSW1["TLS profile watcher<br/>apiservers/cluster"]
        end
        subgraph WhDep["spark-operator-webhook Deployment: webhook start"]
            Mut["Mutating webhooks<br/>SparkApplication, ScheduledSparkApplication,<br/>SparkConnect, Spark pods"]
            Val["Validating webhooks<br/>name, sparkConf, ConfigMaps, ResourceQuota"]
            Conv["/convert CRD conversion"]
            CABundle["Mutating/Validating WebhookConfiguration<br/>caBundle sync controllers"]
            CertMgr["Self-signed cert manager<br/>RSA-2048, 10-year validity"]
            TLSW2["TLS profile watcher"]
        end
        WhSecret["Secret spark-operator-webhook-certs"]
        CertMgr -->|writes| WhSecret
        CertMgr -->|CA| CABundle
    end

    %% Platform flow
    ODHOp -->|deploys + injects env| Module
    ODHOp -->|creates| SparkOpCR
    SparkOpCR -->|watched by| Module
    Module -->|applies CRDs, RBAC, Deployments,<br/>webhook configs, NetworkPolicies, PodMonitors| Operand
    Module -->|status: Ready, releases| SparkOpCR

    %% User CRs
    User["Data Scientist / Kubeflow SDK"]
    SAppCR["SparkApplication CR<br/>sparkoperator.k8s.io/v1beta2"]
    SchedCR["ScheduledSparkApplication CR<br/>v1beta2"]
    ConnCR["SparkConnect CR<br/>v1alpha1"]
    User -->|creates| SAppCR
    User -->|creates| SchedCR
    User -->|creates| ConnCR
    SchedCR -->|watched by| SchedCtrl
    SchedCtrl -->|creates on schedule| SAppCR
    SAppCR -->|watched by| SAppCtrl
    ConnCR -->|watched by| ConnCtrl

    %% Operands
    Driver["Spark driver pod"]
    Exec["Spark executor pods<br/>7078/7079"]
    UISvc["UI Service :4040"]
    UIIng["UI Ingress<br/>opt-in, not set in RHOAI"]
    PDB["Driver PodDisruptionBudget<br/>opt-in"]
    ConnPod["SparkConnect server pod + Service<br/>gRPC 15002, 7078, 7079, 4040"]
    OpNP["Operand NetworkPolicies"]
    SAppCtrl -->|spark-submit creates| Driver
    Driver -->|creates| Exec
    SAppCtrl -->|creates| UISvc
    SAppCtrl -.->|creates if configured| UIIng
    SAppCtrl -.->|creates if enabled| PDB
    ConnCtrl -->|creates| ConnPod
    NPCtrl -->|creates| OpNP

    %% Admission
    K8s["Kubernetes API Server"]
    K8s -->|admission 443 to 9443| Mut
    K8s -->|admission| Val
    K8s -->|conversion| Conv

    %% External deps
    OCPCfg["OpenShift APIServer config<br/>TLS security profile"]
    ServiceCA["OpenShift service-ca<br/>metrics certs"]
    Prom["Prometheus via PodMonitor"]
    TLSW1 -->|reads| OCPCfg
    TLSW2 -->|reads| OCPCfg
    ServiceCA -.->|issues metrics certs| Operand
    Prom -->|scrapes HTTPS 8080| Operand

    style Module fill:#4a90e2,color:#fff
    style SAppCtrl fill:#4a90e2,color:#fff
    style SchedCtrl fill:#4a90e2,color:#fff
    style ConnCtrl fill:#4a90e2,color:#fff
    style NPCtrl fill:#4a90e2,color:#fff
    style TLSW1 fill:#4a90e2,color:#fff
    style Mut fill:#4a90e2,color:#fff
    style Val fill:#4a90e2,color:#fff
    style Conv fill:#4a90e2,color:#fff
    style CABundle fill:#4a90e2,color:#fff
    style CertMgr fill:#4a90e2,color:#fff
    style TLSW2 fill:#4a90e2,color:#fff
    style SparkOpCR fill:#f5a623
    style SAppCR fill:#f5a623
    style SchedCR fill:#f5a623
    style ConnCR fill:#f5a623
    style ODHOp fill:#7ed321
    style User fill:#7ed321
    style K8s fill:#e8e8e8
    style OCPCfg fill:#e8e8e8
    style ServiceCA fill:#e8e8e8
    style Prom fill:#e8e8e8
    style UIIng stroke-dasharray: 5 5
    style PDB stroke-dasharray: 5 5
