graph TB
    Client["Client"] -->|"HTTPS 443"| Gateway["Gateway<br/>Envoy / Istio + Kuadrant AuthPolicy"]
    EPP["llm-d EPP / inference scheduler"] -.->|"picks decode + prefill pods<br/>sets x-prefiller-host-port"| Gateway

    subgraph DecodePod["Decode Pod (injected by KServe LLMInferenceService)"]
        subgraph Sidecar["llm-d-routing-sidecar (native sidecar, :8000)"]
            Main["main.go<br/>flag parsing, signal handling"]
            Server["internal/proxy.Server<br/>ServeMux, optional TLS listener"]
            Health["GET /health"]
            Completions["POST /v1/chat/completions<br/>POST /v1/completions"]
            PassThrough["/ catch-all<br/>httputil.ReverseProxy"]
            Connectors["P/D connectors<br/>nixlv2 default, nixl, lmcache"]
            LRU["Prefiller proxy LRU cache<br/>16 entries, keyed by host:port"]
            Allowlist["AllowlistValidator<br/>optional SSRF protection"]
            CertGen["Self-signed cert generator<br/>RSA-4096, 10 years"]

            Main -->|builds and starts| Server
            Server --> Health
            Server --> Completions
            Server --> PassThrough
            Completions -->|"prefill header present"| Connectors
            Completions -->|"no header"| PassThrough
            Connectors -->|validates target| Allowlist
            Connectors --> LRU
            Server -->|"no -cert-path"| CertGen
        end
        VLLMDecode["vLLM decode container<br/>localhost:8001 default"]
    end

    Gateway -->|"HTTPS 8000"| Server
    LRU -->|"prefill pass<br/>max_tokens=1, stream=false"| Prefill["vLLM prefill pods<br/>port from header"]
    Connectors -->|"decode pass + kv_transfer_params"| VLLMDecode
    PassThrough -->|HTTP| VLLMDecode
    VLLMDecode -.->|"NIXL/UCX KV cache pull"| Prefill

    Allowlist -->|"LIST/WATCH"| K8sAPI["Kubernetes API"]
    InferencePoolCR["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"] -->|watched by| Allowlist
    TLSSecret["TLS Secret<br/>tls.crt / tls.key at -cert-path"] -->|"loaded once at startup"| Server
    KServe["KServe LLMInferenceService controller"] -->|"injects sidecar"| DecodePod

