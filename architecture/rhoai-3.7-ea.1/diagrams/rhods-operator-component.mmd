graph TB
    Admin["Platform Admin<br/>(kubectl / dashboard)"]
    OLM["OLM<br/>CSV rhods-operator"]

    subgraph OperatorNS["Namespace: redhat-ods-operator"]
        subgraph Manager["rhods-operator Deployment (manager, 3 replicas, leader election)"]
            DSCCtrl[DataScienceCluster controller]
            DSCICtrl[DSCInitialization controller]
            ModCtrl["Built-in module controller<br/>render, upgrade gate, SSA, GC"]
            KueueCtrl["Kueue component controller<br/>(only in-tree component)"]
            GwCtrl[Gateway service controller]
            AuthCtrl[Auth service controller]
            CertCtrl[CertConfigMapGenerator]
            HWPCtrl[HardwareProfile controller]
            Webhook["Webhook server<br/>9443/TCP HTTPS"]
            Metrics["Metrics 8443/TCP HTTPS<br/>TokenReview + SAR"]
        end
        Assets["Bundled assets<br/>/opt/charts, /opt/manifests"]
        CloudMgr["cloudmanager (optional, XKS)<br/>AWS / Azure / CoreWeave"]
    end

    subgraph CRDs["Operator-owned CRDs"]
        DSC["DataScienceCluster v3<br/>default-dsc"]
        DSCI[DSCInitialization]
        Platform["Platform<br/>(conversion webhook)"]
        AuthCR[Auth]
        GwCfg[GatewayConfig]
        KueueCR[Kueue]
        HWP[HardwareProfile]
        KE["AWS / Azure / CoreWeave<br/>KubernetesEngine"]
    end

    subgraph GatewayNS["Namespace: openshift-ingress"]
        GWClass[GatewayClass data-science-gateway-class]
        GW["Gateway data-science-gateway<br/>443/TCP HTTPS"]
        KAP["kube-auth-proxy<br/>8443/TCP, oauth2-proxy fork"]
        EF["EnvoyFilter ext_authz + Lua<br/>DestinationRule (insecureSkipVerify)"]
        HR["HTTPRoute oauth-callback-route"]
    end

    subgraph AppNS["Namespace: redhat-ods-applications"]
        Redirect["dashboard-redirect nginx<br/>8080/TCP"]
        NP[Default NetworkPolicy]
        Modules["Module operators<br/>dashboard, kserve, aipipelines,<br/>workbenches, ray, trainer, trustyai, ..."]
    end

    MonNS["redhat-ods-monitoring<br/>monitoring stack"]
    RBAC["Admin / allowed group<br/>RoleBindings"]
    CABundle[Trusted CA bundle ConfigMaps]
    Prereqs["XKS prerequisites<br/>Gateway API, LWS, Sail, RHCL, cert-manager"]

    OLM -->|installs| Manager
    Admin -->|creates| DSC
    Admin -->|creates| DSCI
    Admin -->|configures| AuthCR
    Admin -->|configures| GwCfg

    DSC -->|watched by| DSCCtrl
    DSCI -->|watched by| DSCICtrl
    AuthCR -->|watched by| AuthCtrl
    GwCfg -->|watched by| GwCtrl
    KueueCR -->|watched by| KueueCtrl
    HWP -->|watched by| HWPCtrl
    KE -->|watched by| CloudMgr

    DSCCtrl -->|module enablement| ModCtrl
    DSCCtrl -->|creates| KueueCR
    ModCtrl -->|reads| Assets
    ModCtrl -->|server-side apply| Modules
    ModCtrl -->|injects config from| Platform
    Modules -.->|status read back| DSCCtrl

    DSCICtrl -->|creates| NP
    DSCICtrl -->|configures| MonNS
    CertCtrl -->|distributes| CABundle
    AuthCtrl -->|creates| RBAC

    GwCtrl -->|creates| GWClass
    GwCtrl -->|creates| GW
    GwCtrl -->|deploys| KAP
    GwCtrl -->|creates| EF
    GwCtrl -->|creates| HR
    GwCtrl -->|deploys| Redirect

    Webhook -.->|validates / mutates| DSC
    Webhook -.->|validates| DSCI
    Webhook -.->|validates| GwCfg
    Webhook -.->|converts| Platform

    CloudMgr -->|Helm install| Prereqs

    classDef op fill:#4a90e2,stroke:#333,color:#fff
    classDef crd fill:#f5a623,stroke:#333
    classDef workload fill:#7ed321,stroke:#333
    classDef ext fill:#e8e8e8,stroke:#333

    class DSCCtrl,DSCICtrl,ModCtrl,KueueCtrl,GwCtrl,AuthCtrl,CertCtrl,HWPCtrl,Webhook,Metrics,CloudMgr op
    class DSC,DSCI,Platform,AuthCR,GwCfg,KueueCR,HWP,KE crd
    class KAP,Redirect,Modules,GW,GWClass,EF,HR workload
    class OLM,Admin,Prereqs,MonNS,RBAC,CABundle,NP,Assets ext
