graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
        UserCLI["User / Dashboard<br/>kubectl, oc"]
    end

    subgraph Ingress["INGRESS (DMZ) - not created by this repo"]
        Gateway["Platform Gateway / OpenShift Route<br/>443/TCP HTTPS<br/>TLS at Gateway (SIMPLE / edge / reencrypt)<br/>Kuadrant AuthPolicy / Authorino"]
    end

    subgraph ControlPlane["CONTROL PLANE (Kubernetes API)"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph NS_ODH["Namespace: opendatahub (controller NetworkPolicies allow-all ingress)"]
        Module["kserve-module-controller<br/>SA: kserve-module-controller-manager<br/>8081/TCP probes<br/>cluster-admin-equivalent RBAC"]
        KWebhook["kserve-webhook-server-service<br/>443→9443/TCP HTTPS<br/>service-CA cert, cluster TLS profile"]
        KCtrl["kserve-controller-manager<br/>SA: kserve-controller-manager"]
        LWebhook["llmisvc-webhook-server-service<br/>443→9443/TCP HTTPS service-CA<br/>+ /convert"]
        LCtrl["llmisvc-controller-manager<br/>SA: llmisvc SA"]
        Metrics["Metrics Services<br/>8443/TCP HTTPS<br/>kube-rbac-proxy TokenReview + SAR"]
        Probes["/healthz, /readyz<br/>8081/TCP HTTP, no auth"]
        LMC["localmodel controller + node agent<br/>SA: kserve-localmodel-controller-manager,<br/>kserve-localmodelnode-agent"]
    end

    subgraph NS_Tenant["Namespace: tenant data science project"]
        Predictor["Predictor pod<br/>8080 REST / 8081 gRPC h2c<br/>No app auth (delegated)<br/>TLS if cluster profile enabled"]
        LLMPods["LLMISVC vLLM / EPP pods<br/>8000/8443 HTTPS<br/>LLMISVC TLS default on"]
        Router["InferenceGraph router<br/>80→8080/TCP HTTP/HTTPS<br/>Bearer → TokenReview + SAR"]
        SI["storage-initializer<br/>+ kserve-decrypt"]
        AgentS["agent 9081 / qpext 9088<br/>HTTP, no auth"]
        subgraph TEE["Confidential TEE (SA: coco-cc-storage, privileged SCC)"]
            CDH["CoCo CDH<br/>127.0.0.1:8006 HTTP loopback"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prom["Prometheus"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Storage["S3 / GCS / Azure / HF / ModelScope<br/>443/TCP HTTPS TLS 1.2+"]
        OCI["OCI registries<br/>443/TCP TLS 1.2 min<br/>insecure opt-in"]
        HDFS["HDFS / WebHDFS<br/>Kerberos"]
        KBS["Trustee KBS"]
        LogSink["Logger sink<br/>HTTP/HTTPS, skip-verify opt-in"]
    end

    Client -->|"HTTPS/443<br/>TLS<br/>Gateway / Kuadrant auth"| Gateway
    Gateway -->|"HTTP/h2c 8080<br/>plaintext in-cluster"| Predictor
    Gateway -->|"HTTPS 8000<br/>TLS"| LLMPods
    Gateway -->|"HTTP(S) 8080<br/>optional TLS"| Router
    Router -->|"HTTP 8080"| Predictor

    UserCLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>User token"| APIServer
    APIServer -->|"HTTPS/443<br/>TLS service-CA<br/>failurePolicy Fail"| KWebhook
    APIServer -->|"HTTPS/443<br/>TLS service-CA"| LWebhook
    KWebhook --- KCtrl
    LWebhook --- LCtrl
    Module -->|"HTTPS/6443<br/>SA token<br/>SSA manifests"| APIServer
    KCtrl -->|"HTTPS/6443<br/>SA token"| APIServer
    LCtrl -->|"HTTPS/6443<br/>SA token"| APIServer
    LMC -->|"HTTPS/6443<br/>SA token"| APIServer
    Router -->|"TokenReview + SAR<br/>HTTPS/6443"| APIServer
    Prom -->|"HTTPS/8443<br/>Bearer + SAR"| Metrics

    SI -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage secret / IRSA"| Storage
    SI -->|"HTTPS/443<br/>Pull secret"| OCI
    SI -->|"Kerberos"| HDFS
    SI -->|"HTTP/8006 loopback<br/>no TLS (local)"| CDH
    CDH -->|"TEE attestation"| KBS
    AgentS -->|"HTTP/HTTPS<br/>CloudEvents"| LogSink

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,UserCLI external
    class Gateway ingress
    class APIServer control
    class KWebhook,KCtrl,LWebhook,LCtrl,Metrics,LMC,Predictor,LLMPods,Router,SI,AgentS,Prom internal
    class Module,CDH,Probes risk
    class Storage,OCI,HDFS,KBS,LogSink externalservice
