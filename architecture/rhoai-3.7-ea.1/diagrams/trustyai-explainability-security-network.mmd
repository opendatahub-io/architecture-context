graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        ExtUser["External User<br/>browser / API client"]
    end

    subgraph Ingress["INGRESS"]
        Route["Route trustyai - legacy manifest<br/>80/TCP HTTP<br/>tls: null - PLAINTEXT"]
        OpRoute["Operator-managed Route<br/>to kube-rbac-proxy"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        subgraph Monitoring["openshift-user-workload-monitoring"]
            Prom["Prometheus<br/>ServiceMonitor trustyai-metrics<br/>4s interval"]
        end

        subgraph NS["Namespace: user / TrustyAIService namespace"]
            MM["ModelMesh<br/>payload processor"]
            KSLog["KServe InferenceService<br/>logger"]
            ModelSrv["Model Server Service<br/>KServe v2 gRPC"]

            subgraph Pod["trustyai-service Pod - SA: trustyai-serviceaccount, 1 replica"]
                RBP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>Bearer → SubjectAccessReview"]
                IntProxy["internal-tls-proxy<br/>4443/TCP HTTPS<br/>auth bypass: /, /consumer/kserve/v2, /q/health"]
                App["trustyai-service Quarkus<br/>8080/TCP HTTP, 4443/TCP HTTPS<br/>NO app-level authN/authZ"]
                Init["ose-cli init container<br/>legacy manifest only"]
            end
            PVC["PVC 1Gi RWO<br/>/inputs"]
        end
    end

    subgraph ExtSvc["EXTERNAL / USER-PROVIDED SERVICES"]
        DB["MariaDB / MySQL<br/>3306/TCP JDBC<br/>TLS verify-ca if configured<br/>user/password"]
        MinIO["MinIO / S3<br/>HTTP or HTTPS<br/>access/secret key"]
        K8s["Kubernetes API<br/>443/TCP HTTPS<br/>SA token"]
    end

    ExtUser -->|HTTPS/443 TLS<br/>Bearer token| OpRoute
    OpRoute -->|HTTPS/8443| RBP
    ExtUser -.->|HTTP/80 plaintext<br/>no auth - legacy| Route
    Route -.->|HTTP/8080| App
    RBP -->|HTTP/8080 localhost| App
    MM -->|HTTPS 443→4443<br/>no auth| IntProxy
    KSLog -->|HTTPS 443→4443 CloudEvents<br/>no auth| IntProxy
    IntProxy -->|localhost| App
    Prom -->|HTTP/8080 /q/metrics<br/>Bearer sent, not verified| App
    App -->|gRPC user-specified port<br/>PLAINTEXT, no auth| ModelSrv
    App -->|file I/O| PVC
    App -->|JDBC 3306<br/>TLS optional| DB
    App -->|S3 API<br/>scheme-dependent| MinIO
    Init -.->|HTTPS/443 oc apply<br/>model-serving-config| K8s

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class ExtUser external
    class OpRoute ingress
    class Route risk
    class Prom,MM,KSLog,ModelSrv,PVC internal
    class RBP,IntProxy,App,Init app
    class DB,MinIO,K8s externalservice
