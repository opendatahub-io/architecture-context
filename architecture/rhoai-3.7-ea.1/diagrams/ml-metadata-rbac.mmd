graph TD
    subgraph K8s["Kubernetes RBAC"]
        None["No ClusterRoles, Roles, bindings<br/>or ServiceAccounts defined in repo<br/>Server makes no Kubernetes API calls"]
    end

    subgraph AppAuth["Application-level access control"]
        Clients["Any client reaching 8080/TCP"]
        MLMD["metadata_store_server<br/>MetadataStoreService (~60 RPCs)"]
        mTLS["Optional mTLS<br/>client_verify in ssl_config<br/>(off by default)"]
        Clients -->|"all RPCs: full read/write<br/>no per-RPC authorization"| MLMD
        mTLS -.->|only gate when enabled| MLMD
    end

    subgraph Creds["Credentials (no Kubernetes Secrets referenced)"]
        DBPass["DB password<br/>--mysql_config_password / --postgres_config_password<br/>CLI flag, visible in process args"]
        TLSPem["gRPC TLS key/cert/CA<br/>inline PEM in textproto config"]
        DBTLS["DB client TLS files<br/>--mysql_config_ssl* / --postgres_config_ssl*"]
    end

    MLMD -->|authenticates to DB with| DBPass
    MLMD -->|serves TLS with| TLSPem
    MLMD -->|DB client TLS with| DBTLS
    DSPO["data-science-pipelines-operator<br/>(inferred)"] -->|provisions| Creds

    style None fill:#e8e8e8
    style MLMD fill:#4a90e2
    style Clients fill:#ff9999
    style mTLS fill:#f5a623
    style DBPass fill:#f5a623
    style TLSPem fill:#f5a623
    style DBTLS fill:#f5a623
    style DSPO fill:#7ed321
