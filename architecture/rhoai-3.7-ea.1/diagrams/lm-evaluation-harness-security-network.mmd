graph TB
    subgraph Launchers["CONTROL PLANE (Platform launchers, no inbound to this component)"]
        TrustyAI["trustyai-service-operator<br/>LMEvalJob controller"]
        EvalHubL["EvalHub job scheduler"]
    end

    subgraph Tenant["TENANT NAMESPACE (ephemeral job pod, single-tenant)"]
        Pod["odh-ta-lmes-job-rhel9 pod<br/>UID 65532<br/>NO listening ports, NO K8s API access<br/>Secrets as env: OPENAI_API_KEY, HF_TOKEN,<br/>AWS keys, registry creds"]
        Vols["Volumes: /meta/job.json, /test_data,<br/>output, hf_home"]
    end

    subgraph Cluster["IN-CLUSTER SERVICES (runtime-configured URLs)"]
        Model["Model inference endpoint<br/>KServe / vLLM / llm-d<br/>/v1/completions"]
        EvalHubAPI["EvalHub API<br/>callback_url"]
        MLflow["MLflow tracking server"]
    end

    subgraph External["EXTERNAL SERVICES (Internet)"]
        HF["Hugging Face Hub<br/>huggingface.co<br/>443/TCP TLS 1.2+"]
        Registry["OCI registry<br/>443/TCP"]
        S3["S3-compatible storage<br/>AWS_S3_ENDPOINT"]
        APIs["Third-party LLM APIs<br/>OpenAI, Anthropic, watsonx.ai<br/>443/TCP"]
    end

    TrustyAI -->|creates pod<br/>python -m lm_eval| Pod
    EvalHubL -->|creates pod<br/>python main.py| Pod
    Vols -->|file mount| Pod

    Pod -->|"HTTP/HTTPS, runtime port<br/>TLS if https (custom CA, verify can be disabled)<br/>Bearer OPENAI_API_KEY"| Model
    Pod -->|"HTTP/HTTPS, runtime port<br/>TLS (evalhub_insecure possible)<br/>eval-hub-sdk auth"| EvalHubAPI
    Pod -->|"HTTP/HTTPS, runtime port<br/>TLS<br/>eval-hub-sdk auth"| MLflow
    Pod -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN optional<br/>disabled in offline mode"| HF
    Pod -->|"HTTPS/443<br/>TLS (--tls-verify=false possible)<br/>Username/password or auth file"| Registry
    Pod -->|"HTTPS, runtime port<br/>TLS (S3_VERIFY_SSL=false possible)<br/>AWS access key/secret"| S3
    Pod -.->|"HTTPS/443<br/>TLS<br/>API keys (CLI path only)"| APIs

    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class TrustyAI,EvalHubL control
    class Pod,Vols tenant
    class Model,EvalHubAPI,MLflow cluster
    class HF,Registry,S3,APIs externalservice
