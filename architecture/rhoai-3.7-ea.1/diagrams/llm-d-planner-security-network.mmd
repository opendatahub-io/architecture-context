graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
        Anyone["Any API client<br/>(no auth required)"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        RouteUI["Route: planner<br/>443/TCP HTTPS<br/>edge TLS, insecure → Redirect<br/>No oauth-proxy / kube-rbac-proxy"]
        RouteBE["Route: planner-backend<br/>443/TCP HTTPS<br/>edge TLS, insecure → Redirect<br/>Unauthenticated API"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (no service mesh, plaintext HTTP)"]
        direction TB
        subgraph NS_Planner["Namespace: planner (no NetworkPolicy)"]
            UI["ui<br/>8501/TCP HTTP<br/>SA: default<br/>runs as root"]
            Backend["backend<br/>8000/TCP HTTP<br/>SA: planner-backend<br/>CORS * with credentials<br/>No auth middleware"]
            Ollama["ollama<br/>11434/TCP HTTP<br/>SA: default<br/>1 NVIDIA GPU"]
            PVC[("SQLite RWO PVC")]
        end
        subgraph NS_MR["Namespace: rhoai-model-registries"]
            NP["NetworkPolicy<br/>allow planner backend → 8443"]
            MC["Model Catalog<br/>8443/TCP HTTPS<br/>service-CA TLS"]
        end
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (egress)"]
        Vertex["Vertex AI *.googleapis.com<br/>443/TCP TLS<br/>GCP SA credentials"]
        OpenAI["OpenAI-compatible API<br/>443/TCP TLS<br/>Bearer API key"]
        HF["huggingface.co<br/>443/TCP TLS<br/>HF_TOKEN optional"]
        AA["artificialanalysis.ai<br/>443/TCP TLS<br/>AA_API_KEY"]
        OllamaReg["registry.ollama.ai<br/>443/TCP TLS<br/>No auth"]
    end

    Browser -->|HTTPS/443<br/>TLS edge<br/>No auth| RouteUI
    Anyone -->|HTTPS/443<br/>TLS edge<br/>No auth| RouteBE
    RouteUI -->|HTTP/8501<br/>plaintext<br/>No auth| UI
    RouteBE -->|HTTP/8000<br/>plaintext<br/>No auth| Backend
    UI -->|HTTP/8000<br/>plaintext<br/>No auth| Backend
    Backend -->|HTTP/11434<br/>plaintext<br/>No auth| Ollama
    Backend -->|local file| PVC
    Backend -->|HTTPS/8443<br/>TLS service-CA<br/>Bearer token / SA token| MC
    NP -.-> MC
    Backend -->|HTTPS/6443<br/>TLS<br/>SA token: list nodes<br/>kubectl apply if granted| K8sAPI
    Backend -->|HTTPS/443| Vertex
    Backend -->|HTTPS/443| OpenAI
    Backend -->|HTTPS/443| HF
    Backend -->|HTTPS/443| AA
    Ollama -->|HTTPS/443<br/>pull granite3.3:2b| OllamaReg

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:3px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser,Anyone external
    class RouteUI ingress
    class RouteBE,Backend risk
    class UI,Ollama,PVC,NP,MC,K8sAPI internal
    class Vertex,OpenAI,HF,AA,OllamaReg externalservice
