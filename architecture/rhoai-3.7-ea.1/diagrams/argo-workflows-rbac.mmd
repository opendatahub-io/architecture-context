graph TD
    subgraph RHOAI["RHOAI deployment (via DSPO)"]
        DSPOSA["SA: workflow-controller SA<br/>per DSPA namespace"]
        DSPORole["Role (namespace)<br/>DSPO role.yaml.tmpl"]
        RunnerSA["SA: pipeline-runner-&lt;dspa&gt;<br/>workflow step pods"]
        DSPOSA -->|bound via RoleBinding| DSPORole
        DSPORole -->|namespace-scoped equivalents<br/>of argo-cluster-role| NSRes["Namespace resources<br/>pods, configmaps, PDBs, Argo CRs, leases"]
        RunnerSA -->|create/patch| WTRr["argoproj.io<br/>WorkflowTaskResult"]
    end

    subgraph Upstream["Upstream cluster-install - NOT used by RHOAI"]
        SA["SA: argo"]
        CRB["ClusterRoleBinding<br/>argo-binding"]
        RB["RoleBinding argo-binding<br/>ns: argo"]
        CR["ClusterRole<br/>argo-cluster-role"]
        R["Role argo-role"]

        ServerSA["SA: argo-server"]
        ServerCRB["ClusterRoleBinding<br/>argo-server-binding"]
        ServerCR["ClusterRole<br/>argo-server-cluster-role"]

        SA -->|bound via| CRB
        SA -->|bound via| RB
        CRB -->|grants| CR
        RB -->|grants| R
        ServerSA -->|bound via| ServerCRB
        ServerCRB -->|grants| ServerCR
    end

    subgraph Resources["API Resources"]
        Pods["core<br/>pods, pods/exec"]
        CMs["core<br/>configmaps"]
        PVCs["core<br/>persistentvolumeclaims (+finalizers)"]
        SAs["core<br/>serviceaccounts"]
        Events["core<br/>events"]
        AgentSecret["core<br/>secrets: argo-workflows-agent-ca-certificates"]
        WFs["argoproj.io<br/>workflows, workflowtasksets,<br/>workflowartifactgctasks (+finalizers)"]
        Templates["argoproj.io<br/>workflowtemplates,<br/>clusterworkflowtemplates"]
        WTR["argoproj.io<br/>workflowtaskresults"]
        Cron["argoproj.io<br/>cronworkflows (+finalizers)"]
        PDBs["policy<br/>poddisruptionbudgets"]
        Leases["coordination.k8s.io<br/>leases"]
        Secrets["core<br/>secrets"]
        ServerRes["argoproj.io<br/>eventsources, sensors, workflows,<br/>workfloweventbindings, templates, cronworkflows"]
        ServerCore["core<br/>configmaps, secrets, pods, pods/log,<br/>events, serviceaccounts"]
    end

    CR -->|create,get,list,watch,update,patch,delete| Pods
    CR -->|get,watch,list| CMs
    CR -->|create,update,delete,get| PVCs
    CR -->|get,list| SAs
    CR -->|create,patch| Events
    CR -->|get| AgentSecret
    CR -->|get,list,watch,update,patch,delete,create| WFs
    CR -->|get,list,watch| Templates
    CR -->|list,watch,deletecollection| WTR
    CR -->|get,list,watch,update,patch,delete| Cron
    CR -->|create,get,delete| PDBs
    R -->|create,get,update| Leases
    R -->|get| Secrets
    ServerCR -->|create,get,list,watch,update,patch,delete| ServerRes
    ServerCR -->|get/list/watch, create, delete, patch| ServerCore

    Aggregate["argo-aggregate-to-view/edit/admin"] -->|aggregates Workflow CR access into| BuiltIn["built-in view / edit / admin"]

