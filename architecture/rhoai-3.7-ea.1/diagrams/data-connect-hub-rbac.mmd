graph TD
    subgraph SAs["Service Accounts"]
        CtrlSA["dc-controller-manager<br/>ns dc-controller-system"]
        RestSA[dch-rest-service-sa]
        FlightSA[dch-flight-service-sa]
        Users["Users / Groups<br/>per tenant namespace"]
    end

    subgraph Bindings["Bindings"]
        CRB_Mgr["CRB dc-controller-manager-rolebinding"]
        CRB_MAuth["CRB dc-controller-metrics-auth-rolebinding"]
        RB_LE["RoleBinding dc-controller-leader-election-rolebinding<br/>ns dc-controller-system"]
        CRB_FAD["CRB dch-flight-auth-delegator<br/>subject ns rewritten to DCS ns"]
        CRB_KRP["CRB dch-kube-rbac-proxy-auth-review"]
        CRB_DA["CRB dch-rest-service-data-access"]
        RB_SA["RoleBinding dch-rest-service-secret-access<br/>manual, each tenant ns"]
        RB_FS["Admin-defined RoleBinding<br/>manual, per-Secret resourceName"]
        RB_User["Tenant RoleBindings<br/>manual"]
    end

    subgraph Roles["Roles"]
        MgrRole[dc-controller-manager-role]
        MAuthRole[dc-controller-metrics-auth-role]
        LERole["dc-controller-leader-election-role (Role)"]
        AuthDel["system:auth-delegator<br/>built-in"]
        KRPRole[dch-kube-rbac-proxy-auth-review]
        DARole[dch-rest-service-data-access]
        SARole[dch-rest-service-secret-access]
        FSRole["Role: get specific Secrets"]
        ReadRole[dch-read]
        RWRole["dch-read-write / dch-admin"]
        ExpRole[dch-secret-export]
    end

    subgraph Resources["API Resources"]
        CoreRes["core<br/>configmaps, secrets,<br/>serviceaccounts, services"]
        Deploy["apps<br/>deployments"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings"]
        DCHRes["dataconnecthub.opendatahub.io<br/>dataconnectservices, initdataconnection(type)s"]
        Synthetic["dataconnecthub.opendatahub.io synthetic<br/>data-connections, data-connection-types,<br/>data-store, flight-services"]
        DataStore["dataconnecthub.opendatahub.io<br/>data-store"]
        NetRes["gateway.networking.k8s.io httproutes, gateways<br/>networking.k8s.io networkpolicies<br/>monitoring.coreos.com servicemonitors"]
        OCPRes["config.openshift.io apiservers, ingresses<br/>operator.openshift.io ingresscontrollers<br/>route.openshift.io routes"]
        AuthRes["authentication.k8s.io tokenreviews<br/>authorization.k8s.io subjectaccessreviews"]
        LeaseRes["coordination.k8s.io leases<br/>core configmaps, events"]
        Secrets["core secrets<br/>tenant namespace"]
    end

    CtrlSA --> CRB_Mgr --> MgrRole
    CtrlSA --> CRB_MAuth --> MAuthRole
    CtrlSA --> RB_LE --> LERole
    FlightSA --> CRB_FAD --> AuthDel
    FlightSA --> RB_FS --> FSRole
    RestSA --> CRB_KRP --> KRPRole
    RestSA --> CRB_DA --> DARole
    RestSA --> RB_SA --> SARole
    Users --> RB_User
    RB_User --> ReadRole
    RB_User --> RWRole
    RB_User --> ExpRole

    MgrRole -->|create,delete,get,list,patch,update,watch| CoreRes
    MgrRole -->|create,delete,get,list,patch,update,watch| Deploy
    MgrRole -->|"create,delete,get,list,patch,update,watch<br/>ESCALATION-CAPABLE"| RBACRes
    MgrRole -->|"full CRUD dataconnectservices;<br/>get,list,watch init*; status, finalizers"| DCHRes
    MgrRole -->|create,delete,get,list,patch,update,watch| Synthetic
    MgrRole -->|"CRUD; gateways get,list,watch"| NetRes
    MgrRole -->|get,list,watch / get| OCPRes
    MgrRole -->|create| AuthRes
    MAuthRole -->|create| AuthRes
    LERole -->|"CRUD; events create,patch"| LeaseRes
    AuthDel -->|create| AuthRes
    KRPRole -->|create| AuthRes
    DARole -->|"get (cluster-wide)"| DataStore
    SARole -->|get,create,patch,delete| Secrets
    FSRole -->|get| Secrets
    ReadRole -->|get,list,watch| Synthetic
    RWRole -->|get,list,watch,create,update,patch,delete| Synthetic
    ExpRole -->|create| Secrets

