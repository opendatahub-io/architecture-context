graph TD
    subgraph "Predictor Pod Identity"
        SA["Predictor Pod / ServiceAccount<br/>(per InferenceService, set by KServe)"]
    end

    subgraph "RBAC Granted by This Component"
        None["No ClusterRoles<br/>No Roles / RoleBindings"]
    end

    subgraph "Kubernetes API Access"
        NoAPI["None required<br/>runtime container never calls the API server"]
    end

    subgraph "Non-RBAC Credentials (env / volume injection)"
        StorageCreds["Storage credentials secret<br/>AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY<br/>AZ_CLIENT_SECRET, GIT_PASSWORD"]
        HDFS["kserve-hdfscreds<br/>/var/secrets/kserve-hdfscreds"]
    end

    subgraph "Out of Scope (separate RHOAI kserve component)"
        KSRole["kserve-manager-role<br/>(inherited in tree, not shipped here)"]
    end

    SA -->|bound to| None
    None -->|grants| NoAPI
    StorageCreds -.->|injected into| SA
    HDFS -.->|mounted into| SA
    KSRole -.-x|not used by runtime| SA

    style SA fill:#4a90e2
    style None fill:#e8e8e8
    style NoAPI fill:#7ed321
    style StorageCreds fill:#f5a623
    style HDFS fill:#f5a623
    style KSRole fill:#e8e8e8,stroke-dasharray: 5 5
