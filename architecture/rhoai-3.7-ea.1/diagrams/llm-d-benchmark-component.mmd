graph TB
    Operator["Operator / CI Runner"]

    subgraph Workstation["Workstation / CI (client-side orchestrator)"]
        CLI["llmdbenchmark CLI<br/>plan / standup / update / smoketest /<br/>run / teardown / experiment / results"]
        Parser["Plan/Render Engine<br/>defaults → scenario → env → CLI<br/>Pydantic + Jinja2"]
        Executor["Step Executor<br/>numbered standup/run/teardown steps<br/>kubectl / oc / helm / helmfile"]
        Workspace[("Local Workspace<br/>rendered manifests + helmfiles")]
        ResultsStore["Results Store<br/>GCS SDK / Prism proxy"]
        Telemetry["Telemetry (optional)<br/>HTTP POST + Google OIDC"]
        BReport["benchmark-report library<br/>Benchmark Report v0.2"]
        CLI --> Parser
        Parser -->|renders| Workspace
        CLI --> Executor
        Executor -->|reads| Workspace
        CLI --> ResultsStore
        CLI --> Telemetry
        CLI --> BReport
    end

    subgraph HarnessNS["Harness Namespace (ephemeral)"]
        HarnessPod["Harness Pod(s)<br/>ghcr.io/llm-d/llm-d-benchmark:nightly<br/>inference-perf, vllm-benchmark, guidellm,<br/>inferencemax, aiperf, lm-eval, nop"]
        ReportSidecar["report sidecar<br/>(optional)"]
        ProfilesCM["Workload Profile ConfigMaps"]
        WorkloadPVC[("Workload PVC<br/>/requests")]
        DataAccess["Data-access Pod<br/>rsync daemon 20873/TCP"]
        DataSvc["Data-access Service<br/>ClusterIP 20873/TCP"]
        HarnessPod --- ReportSidecar
        ProfilesCM -->|mounted| HarnessPod
        HarnessPod -->|writes results| WorkloadPVC
        DataAccess -->|mounts| WorkloadPVC
        DataSvc --> DataAccess
    end

    subgraph ModelNS["Model Namespace (system under test)"]
        DownloadJob["Model Download Job / DaemonSet"]
        ModelPVC[("Model PVC")]
        Stack["llm-d stack<br/>Gateway → EPP → vLLM<br/>(modelservice / standalone / kustomize / FMA)"]
        DownloadJob -->|writes weights| ModelPVC
        ModelPVC --> Stack
    end

    Discovery["llm_d_stack_discovery<br/>CLI / K8s Job (read-only)"]
    Unused["util/deploy kustomization<br/>(unused scaffolding)"]

    Operator -->|runs| CLI
    Executor -->|creates ns, SA, RBAC, secrets, PVCs| HarnessNS
    Executor -->|helmfile / kubectl apply| ModelNS
    HarnessPod -->|OpenAI-compatible load| Stack
    CLI -->|kubectl cp| DataAccess
    Discovery -->|traces| Stack

    K8sAPI["Kubernetes / OpenShift API"]
    HF["Hugging Face Hub"]
    GCS["Google Cloud Storage"]
    Prism["prism.llm-d.ai"]
    S3["Amazon S3"]
    Thanos["Thanos / Prometheus"]
    TelRecv["Telemetry Receiver"]

    Executor -->|Python client + subprocess| K8sAPI
    DownloadJob -->|HF_TOKEN| HF
    ResultsStore --> GCS
    ResultsStore -.->|fallback| Prism
    CLI -->|aws s3 cp| S3
    CLI -->|curl -k| Thanos
    Telemetry -.-> TelRecv

