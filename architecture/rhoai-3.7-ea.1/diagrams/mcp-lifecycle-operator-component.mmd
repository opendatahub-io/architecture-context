graph TB
    User["User / GitOps"]
    ODHOp["opendatahub-operator<br/>DSC component: mcplifecycleoperator"]

    subgraph Operator["mcp-lifecycle-operator (ns: mcp-lifecycle-operator-system)"]
        Manager["manager binary<br/>/manager (cmd/main.go)<br/>1 replica, leader-elected"]
        MCPCtrl["MCPServer controller<br/>MCPServerReconciler"]
        HTTPRouteProv["httproute provider<br/>MCPGatewayBinding reconciler"]
        KuadrantProv["kuadrant provider<br/>MCPGatewayBinding reconciler"]
        CRDWatcher["CRD watcher<br/>lazy provider start"]
        LogLevel["Log-level reconciler<br/>mcp-lifecycle-operator-config"]
        VWebhook["Validating webhook<br/>/validate-mcp-x-k8s-io-v1alpha1-mcpserver<br/>9443/TCP"]
        CWebhook["Conversion webhook<br/>/convert v1alpha1 ↔ v1beta1<br/>9443/TCP"]
        Metrics["Metrics /metrics<br/>8443/TCP HTTPS"]
        Health["Probes /healthz /readyz<br/>8081/TCP HTTP"]

        Manager --> MCPCtrl
        Manager --> HTTPRouteProv
        Manager --> KuadrantProv
        Manager --> CRDWatcher
        Manager --> LogLevel
        Manager --> VWebhook
        Manager --> CWebhook
        Manager --> Metrics
        Manager --> Health
        CRDWatcher -->|starts when CRDs exist| HTTPRouteProv
        CRDWatcher -->|starts when CRDs exist| KuadrantProv
    end

    MCPServerCR["MCPServer CR<br/>mcp.x-k8s.io v1beta1 storage<br/>v1alpha1 served"]
    BindingCR["MCPGatewayBinding CR<br/>mcp.x-k8s.io v1alpha1"]

    subgraph Managed["Managed mode resources (tenant namespace)"]
        Deployment["Deployment<br/>MCP server pods"]
        Service["Service<br/>port name: mcp"]
        NetPol["NetworkPolicy<br/>posture: open / restricted"]
    end

    BYO["BYO workloadRef / serviceRef<br/>Deployment / StatefulSet / DaemonSet / Service<br/>not owned"]

    HTTPRoute["Gateway API HTTPRoute"]
    MCPReg["Kuadrant MCPServerRegistration"]
    Gateway["Existing Gateway<br/>platform or tenant"]
    MCPGwExt["MCPGatewayExtension"]
    GwConfig["Binding ConfigMap<br/>spec.gateway.configRef"]

    ODHOp -->|deploys / removes| Manager
    User -->|creates| MCPServerCR
    MCPServerCR -->|validated by| VWebhook
    MCPServerCR -->|converted by| CWebhook
    MCPServerCR -->|watched by| MCPCtrl
    MCPCtrl -->|creates| Deployment
    MCPCtrl -->|creates| Service
    MCPCtrl -->|creates| NetPol
    MCPCtrl -.->|references| BYO
    MCPCtrl -->|MCP initialize handshake| Service
    MCPCtrl -->|creates owned, if spec.gateway| BindingCR
    BindingCR -->|provider: httproute| HTTPRouteProv
    BindingCR -->|provider: kuadrant| KuadrantProv
    HTTPRouteProv -->|reads| GwConfig
    HTTPRouteProv -->|creates| HTTPRoute
    HTTPRouteProv -->|reads address| Gateway
    HTTPRoute -->|attaches to| Gateway
    KuadrantProv -->|reads| MCPGwExt
    KuadrantProv -->|creates| MCPReg

    style Manager fill:#4a90e2
    style MCPCtrl fill:#4a90e2
    style HTTPRouteProv fill:#4a90e2
    style KuadrantProv fill:#4a90e2
    style CRDWatcher fill:#4a90e2
    style LogLevel fill:#4a90e2
    style VWebhook fill:#4a90e2
    style CWebhook fill:#4a90e2
    style Metrics fill:#4a90e2
    style Health fill:#4a90e2
    style MCPServerCR fill:#f5a623
    style BindingCR fill:#f5a623
    style Deployment fill:#d5e8d4
    style Service fill:#d5e8d4
    style NetPol fill:#d5e8d4
    style BYO fill:#e8e8e8
    style HTTPRoute fill:#e8e8e8
    style MCPReg fill:#e8e8e8
    style Gateway fill:#e8e8e8
    style MCPGwExt fill:#e8e8e8
    style GwConfig fill:#e8e8e8
    style ODHOp fill:#7ed321
