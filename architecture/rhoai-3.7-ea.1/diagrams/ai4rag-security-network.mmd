graph TB
    subgraph Cluster["OPENSHIFT CLUSTER (tenant namespace, per-namespace DSP instance)"]
        subgraph Pod["KFP Component Pod (Argo / Data Science Pipelines)"]
            Lib["ai4rag library (in-process)<br/>NO listening sockets<br/>Outbound only<br/>Creds from env vars (K8s Secrets)<br/>Trust policy: ensure_safe_url"]
        end

        subgraph InCluster["IN-CLUSTER SERVICES (*.cluster.local, plaintext permitted by ai4rag)"]
            MaaS["Models-as-a-Service<br/>OpenAI-compatible<br/>/v1/models, /v1/embeddings,<br/>/v1/chat/completions"]
            Milvus["Milvus<br/>19530/TCP gRPC"]
            PG["PostgreSQL + pgvector<br/>5432/TCP"]
            Neo4j["Neo4j<br/>7687/TCP Bolt"]
        end
    end

    subgraph External["EXTERNAL SERVICES (TLS verified required)"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>AWS SigV4"]
        Zilliz["Zilliz Cloud / remote Milvus<br/>https:// gRPC TLS"]
        HF["Hugging Face Hub<br/>huggingface.co 443/TCP<br/>connected mode only"]
    end

    Lib -->|HTTPS/443<br/>TLS verified, MAAS_CA_BUNDLE + SSL_CERT_DIR/ca.crt<br/>HTTP only if local/cluster.local<br/>Bearer API key| MaaS
    Lib -->|gRPC/19530<br/>TLS if https://, MILVUS_CA_CERT<br/>Token MILVUS_TOKEN| Milvus
    Lib -->|PG wire/5432<br/>TLS verify-full for non-local<br/>driver default for cluster.local<br/>user/password| PG
    Lib -->|Bolt/7687<br/>neo4j+s / bolt+s, NEO4J_CA_CERT<br/>+ssc rejected<br/>user/password| Neo4j
    Lib -->|HTTPS/443<br/>TLS verified, AWS_CA_BUNDLE<br/>AWS SigV4| S3
    Lib -->|gRPC TLS<br/>Token| Zilliz
    Lib -.->|HTTPS/443<br/>TLS<br/>No auth, revision-pinned| HF

    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef incluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Lib pod
    class MaaS,Milvus,PG,Neo4j incluster
    class S3,Zilliz,HF externalservice
