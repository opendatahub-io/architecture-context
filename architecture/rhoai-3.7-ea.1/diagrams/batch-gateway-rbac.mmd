graph TD
    subgraph SAs["Service Accounts"]
        GCSA["gc ServiceAccount<br/>(gc.serviceAccountName)"]
        APISA["apiserver ServiceAccount<br/>(no RBAC)"]
        ProcSA["processor ServiceAccount<br/>(no RBAC)"]
    end

    subgraph Bindings["RoleBindings (release namespace)"]
        RB["gc-fullname-pod-watcher<br/>RoleBinding"]
    end

    subgraph Roles["Roles (namespaced, no ClusterRoles)"]
        R["gc-fullname-pod-watcher<br/>Role<br/>gated by gc.config.reconciler.enabled"]
    end

    subgraph Resources["API Resources"]
        Pods["core<br/>pods"]
        STS["apps<br/>statefulsets"]
    end

    GCSA -->|bound via| RB
    RB -->|grants| R
    R -->|"get, list, watch"| Pods
    R -->|"get, list, watch"| STS

    style GCSA fill:#4a90e2
    style APISA fill:#e8e8e8
    style ProcSA fill:#e8e8e8
    style RB fill:#f5a623
    style R fill:#f5a623
    style Pods fill:#7ed321
    style STS fill:#7ed321
