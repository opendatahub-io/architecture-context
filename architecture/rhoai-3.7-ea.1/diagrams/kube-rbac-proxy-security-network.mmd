graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["External User / Client<br/>Bearer token or OIDC JWT"]
    end

    subgraph Ingress["INGRESS (Gateway API, consumer-defined)"]
        Gateway["data-science-gateway<br/>HTTPRoute → Service:8443<br/>defined by consuming operator"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        Prom["Prometheus<br/>SA: openshift-monitoring:prometheus-k8s"]
        InCluster["In-cluster service client<br/>SA token or x509 cert"]

        subgraph WorkloadNS["Namespace: consumer workload namespace"]
            subgraph Pod["Workload Pod (sidecar pattern)"]
                KRP["kube-rbac-proxy sidecar<br/>Image: odh-kube-rbac-proxy-rhel9<br/>8443/TCP HTTPS, TLS 1.2+ (flags)<br/>UID 65534, FIPS strictfipsruntime<br/>Authn: TokenReview / OIDC / x509<br/>Authz: hardcoded → static → SAR"]
                Health["/healthz<br/>--proxy-endpoints-port<br/>TLS, NO AUTH"]
                App["Upstream App<br/>8080/TCP localhost<br/>HTTP plaintext"]
            end
        end

        subgraph ControlPlane["Kubernetes Control Plane"]
            K8sAPI["kube-apiserver<br/>6443/TCP (kubernetes.default.svc:443)<br/>TokenReview, SubjectAccessReview"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (optional)"]
        OIDC["OIDC Issuer<br/>443/TCP HTTPS<br/>discovery + JWKS"]
    end

    Logs["stdout / log collection<br/>OCSF 1.9.0 audit (optional)"]
    Kubelet["Kubelet<br/>liveness / readiness probes"]

    %% Flows
    User -->|HTTPS/443<br/>TLS<br/>Bearer| Gateway
    Gateway -->|HTTPS/8443<br/>TLS 1.2+<br/>Bearer passthrough| KRP
    InCluster -->|HTTPS/8443<br/>TLS 1.2+<br/>Bearer or client cert| KRP
    Prom -->|HTTPS/8443<br/>TLS 1.2+<br/>Bearer SA token<br/>GET /metrics implicit allow| KRP
    KRP -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| K8sAPI
    KRP -->|HTTPS/443<br/>TLS system or custom CA<br/>no auth| OIDC
    KRP -->|HTTP/8080 localhost<br/>plaintext, or TLS 1.2+ / mTLS<br/>x-remote-user / x-remote-groups| App
    KRP -.->|ignore-paths: NO AUTH| App
    KRP -.->|audit events| Logs
    Kubelet -->|HTTPS/healthz<br/>TLS<br/>no auth| Health

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Gateway ingress
    class KRP,App,InCluster,Prom,Kubelet internal
    class K8sAPI controlplane
    class OIDC,Logs externalservice
    class Health risk
