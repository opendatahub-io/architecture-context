graph TD
    subgraph ServiceAccounts["Service Accounts"]
        OpSA["modelexpress-operator<br/>(operator namespace)"]
        SrvSA["&lt;cr&gt;-server<br/>(CR namespace, operator-generated)"]
    end

    subgraph Bindings["Bindings"]
        OpCRB["ClusterRoleBinding<br/>modelexpress-operator"]
        OpOCPCRB["ClusterRoleBinding<br/>modelexpress-operator-openshift"]
        SrvRB["RoleBinding<br/>&lt;cr&gt;-metadata"]
        AuthCRB["ClusterRoleBinding<br/>modelexpress-&lt;ns&gt;-&lt;cr&gt;-auth-delegator-&lt;digest&gt;<br/>(enforce mode only, finalizer)"]
    end

    subgraph Roles["Roles"]
        OpCR["ClusterRole<br/>modelexpress-operator"]
        OpOCPCR["ClusterRole<br/>modelexpress-operator-openshift"]
        SrvRole["Role &lt;cr&gt;-metadata<br/>(namespaced)"]
        AuthDel["ClusterRole<br/>system:auth-delegator"]
    end

    subgraph Resources["API Resources"]
        MXS["modelexpress.opendatahub.io<br/>modelexpressservers"]
        MXSStatus["modelexpress.opendatahub.io<br/>modelexpressservers/status, /finalizers"]
        Deploy["apps<br/>deployments"]
        Core["core<br/>services, persistentvolumeclaims,<br/>serviceaccounts, configmaps"]
        NetPol["networking.k8s.io<br/>networkpolicies"]
        RBACRes["rbac.authorization.k8s.io<br/>roles, rolebindings"]
        CRBRes["rbac.authorization.k8s.io<br/>clusterrolebindings"]
        TR["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        NV["modelexpress.nvidia.com<br/>modelmetadatas, modelcacheentries<br/>(+status, finalizers)"]
        APIServers["config.openshift.io<br/>apiservers"]
        SM["monitoring.coreos.com<br/>servicemonitors"]
        NSCM["core<br/>configmaps (CR namespace, all)"]
    end

    OpSA -->|bound via| OpCRB
    OpSA -->|bound via| OpOCPCRB
    OpCRB -->|grants| OpCR
    OpOCPCRB -->|grants| OpOCPCR

    SrvSA -->|bound via| SrvRB
    SrvSA -->|bound via| AuthCRB
    SrvRB -->|grants| SrvRole
    AuthCRB -->|grants| AuthDel

    OpCR -->|get, list, watch, patch| MXS
    OpCR -->|update, patch| MXSStatus
    OpCR -->|CRUD| Deploy
    OpCR -->|CRUD| Core
    OpCR -->|CRUD| NetPol
    OpCR -->|CRUD| RBACRes
    OpCR -->|CRUD - escalation surface| CRBRes
    OpCR -->|create| TR
    OpCR -->|create| SAR
    OpCR -->|CRUD; status get/update/patch;<br/>finalizers update| NV

    OpOCPCR -->|get, list, watch| APIServers
    OpOCPCR -->|get, create, patch, update| SM

    SrvRole -->|CRUD; status get/update/patch;<br/>finalizers update| NV
    SrvRole -->|CRUD| NSCM

    AuthDel -->|create| TR
    AuthDel -->|create| SAR

    OpCR -.->|creates per CR| SrvRole
    OpCR -.->|creates per CR| AuthCRB

    style OpSA fill:#4a90e2,color:#fff
    style SrvSA fill:#4a90e2,color:#fff
    style OpCR fill:#f5a623
    style OpOCPCR fill:#f5a623
    style SrvRole fill:#f5a623
    style AuthDel fill:#f5a623
    style CRBRes fill:#ff9999
    style NSCM fill:#ff9999
    style MXS fill:#7ed321
    style MXSStatus fill:#7ed321
    style NV fill:#7ed321
