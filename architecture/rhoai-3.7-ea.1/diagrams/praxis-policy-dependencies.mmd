graph LR
    PPE["praxis-policy<br/>(embedded library)"]

    %% Host
    Praxis["Praxis proxy<br/>(host, RHOAI)"] -->|"embeds; injects HttpTransport,<br/>listener, FIPS config"| PPE

    %% Internal platform services
    PPE -->|"JWKS, RFC 8693, CIBA<br/>HTTPS/443"| IdP["OIDC IdP<br/>(Keycloak)"]
    PPE -->|"secrets, delegation<br/>HTTPS/8200"| Vault[HashiCorp Vault]
    PPE -->|"sessions, CIBA, DPoP<br/>RESP+TLS/6379"| Valkey["Valkey / Redis"]
    PPE -.->|"experimental quota<br/>HTTPS"| Limitador["Limitador<br/>(Kuadrant)"]

    %% Required libraries
    PPE -->|"async runtime"| Tokio["tokio / futures"]
    PPE -->|"config"| Serde["serde / serde_yaml"]
    PPE -->|"caches"| Moka["moka 0.12"]
    PPE -->|"secret memory"| Zeroize[zeroize]
    PPE -->|"logging"| Tracing[tracing]
    PPE -->|"default crypto"| RustCrypto["sha2 / hmac<br/>(crypto-rustcrypto)"]

    %% Optional libraries
    PPE -.->|"fips, jwt-openssl-fips"| OpenSSL["openssl 0.10.82<br/>(system libssl)"]
    PPE -.->|"jwt"| JWT["jsonwebtoken 11.1.0<br/>(AWS-LC)"]
    PPE -.->|"cedar"| Cedar["cedar-policy 4"]
    PPE -.->|"cel"| CEL["cel 0.15.0"]
    PPE -.->|"opa"| Regorus["regorus 0.13<br/>(embedded Rego)"]
    PPE -.->|"valkey"| Redis["redis 1.7 / deadpool-redis<br/>(rustls)"]
    PPE -.->|"experimental-ratelimit"| LimLib["limitador / limitador-cel"]
    PPE -.->|"http-hyper"| Hyper["hyper-rustls / rustls 0.23<br/>webpki-roots (ring)"]

    style PPE fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Praxis fill:#7ed321,stroke:#333
    style IdP fill:#f5a623,stroke:#333
    style Vault fill:#f5a623,stroke:#333
    style Valkey fill:#f5a623,stroke:#333
    style Limitador fill:#f5a623,stroke:#333
    style Tokio fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style Moka fill:#999,stroke:#333
    style Zeroize fill:#999,stroke:#333
    style Tracing fill:#999,stroke:#333
    style RustCrypto fill:#999,stroke:#333
    style OpenSSL fill:#ddd,stroke:#333
    style JWT fill:#ddd,stroke:#333
    style Cedar fill:#ddd,stroke:#333
    style CEL fill:#ddd,stroke:#333
    style Regorus fill:#ddd,stroke:#333
    style Redis fill:#ddd,stroke:#333
    style LimLib fill:#ddd,stroke:#333
    style Hyper fill:#ddd,stroke:#333
