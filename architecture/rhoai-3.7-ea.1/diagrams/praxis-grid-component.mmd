graph TB
    %% praxis-grid (AI Grid Network, AGN) - component structure
    %% Source: architecture/rhoai-3.7-ea.1/praxis-grid.md

    Admin["Platform Admin / Deployment Owner"]

    subgraph CRDs["grid.praxis.fast/v1alpha1 CRDs (all cluster-scoped)"]
        GridNetwork["GridNetwork<br/>seeds, SWIM key ref, TLS, scoring policy"]
        GridSite["GridSite<br/>participating site + reachability"]
        InferenceProvider["InferenceProvider<br/>endpoint, models, auth secretRef"]
        AgentToolProvider["AgentToolProvider<br/>MCP tools/list discovery"]
        SiteInvite["SiteInvite<br/>site admission invitation"]
    end

    subgraph SiteNS["Namespace: grid-system (one operator per site)"]
        subgraph OperatorPod["grid-operator Deployment"]
            Reconciler["Reconcilers<br/>kube-rs controller"]
            SwimRT["SWIM runtime<br/>foca, AES-256-GCM<br/>7946/UDP"]
            CRDTState["Delta CRDT state<br/>LWW, OR-Set, G-Counter"]
            Scoring["Scoring engine<br/>noMetrics / queueDepth / kvCachePressure"]
            MetricsSrv["Metrics + health<br/>9090/TCP HTTPS"]
            SignalsSrv["Signals API<br/>9091/TCP mTLS"]
            Leader["Leader election<br/>Lease grid-operator"]
            FIPS["grid_fips::verify<br/>startup check (FIPS build)"]
        end

        OverlayCM["Routing overlay ConfigMap<br/>content-addressed envelope"]
        ServingCM["Serving ConfigMap<br/>GRID_SERVING_CONFIG"]
        OperatorConfig["grid-operator-config ConfigMap<br/>VAP: operator cannot update"]
        HolderSlices["Holder EndpointSlices<br/>grid-operator-swim-holder<br/>grid-operator-signals-holder"]
        SiteIdentity["grid-site-identity Secret<br/>SPIFFE site cert"]
    end

    subgraph GatewayPod["Praxis AI gateway Pod (data plane)"]
        OverlaySync["grid-overlay-sync sidecar<br/>health 9091/TCP"]
        SharedDir["Shared emptyDir<br/>overlay file"]
        PraxisGW["Praxis AI gateway<br/>intelligent_route + credential_inject"]
    end

    GridGateway["grid-gateway<br/>project-owned Praxis operand"]

    subgraph Hub["Optional hub services"]
        Enrollment["enrollment service<br/>8443/TCP HTTPS<br/>CSR signing, token mint, rotation"]
        Postgres[("PostgreSQL<br/>5432/TCP")]
        Dashboard["fleet-dashboard<br/>8080/TCP, behind oauth-proxy"]
    end

    PeerOps["Peer grid-operators<br/>other sites / clouds"]
    Providers["Inference providers<br/>vLLM, llm-d EPP, external APIs"]
    MCP["MCP servers"]
    K8sAPI["Kubernetes API Server"]

    Admin -->|creates| GridNetwork
    Admin -->|creates| InferenceProvider
    Admin -->|creates| AgentToolProvider
    Admin -->|creates| SiteInvite

    GridNetwork -->|watched by| Reconciler
    GridSite -->|watched by| Reconciler
    InferenceProvider -->|watched by| Reconciler
    AgentToolProvider -->|watched by| Reconciler
    Reconciler -->|creates/patches| GridSite
    Reconciler -->|reads| OperatorConfig

    Reconciler --> Scoring
    SwimRT <-->|deltas| CRDTState
    CRDTState --> Scoring
    Scoring -->|writes| OverlayCM
    Scoring -->|writes| ServingCM
    Leader -->|points at leader pod| HolderSlices
    SignalsSrv -->|uses| SiteIdentity

    Reconciler -->|"health, /v1/models, metrics"| Providers
    Reconciler -->|"tools/list"| MCP
    Reconciler -->|watch/write| K8sAPI

    SwimRT <-->|"gossip 7946/UDP"| PeerOps
    SignalsSrv <-->|"signals 9091/TCP mTLS"| PeerOps

    OverlayCM -->|watched by| OverlaySync
    OverlaySync -->|atomic write| SharedDir
    SharedDir -->|hot reload| PraxisGW
    ServingCM -->|consumed by| GridGateway
    PraxisGW -->|"POST /v1/site/signals/ingest"| SignalsSrv
    PraxisGW -->|"routes requests, injects Bearer"| Providers

    Reconciler -.->|"enroll / rotate cert"| Enrollment
    Enrollment --> Postgres
    Enrollment -.->|issues| SiteIdentity

