graph TD
    subgraph SAs["Service Accounts"]
        SA["odh-db-operator-operator<br/>ns: odh-db-operator-system"]
        CollectorSA["data-science-collector-collector<br/>ns: opendatahub"]
        PGSA["Internal provider SA<br/>no token automount"]
    end

    subgraph Bindings["Bindings"]
        CRB1["odh-db-operator-manager-rolebinding<br/>ClusterRoleBinding"]
        CRB2["odh-db-operator-metrics-auth-rolebinding<br/>ClusterRoleBinding"]
        RB1["odh-db-operator-internal-provider-writer<br/>RoleBinding in odh-db-operator-system"]
        RB2["odh-db-operator-leader-election-rolebinding<br/>RoleBinding in odh-db-operator-system"]
        RB3["odh-db-operator-metrics-reader-binding<br/>RoleBinding in opendatahub"]
        RB4["per-provider RoleBinding<br/>runtime, backend namespace"]
    end

    subgraph Roles["Roles"]
        MgrRole[odh-db-operator-manager-role]
        WriterRole["odh-db-operator-internal-provider-writer<br/>ClusterRole, namespaced use"]
        LERole["odh-db-operator-leader-election-role<br/>Role"]
        AuthRole[odh-db-operator-metrics-auth-role]
        ReaderRole[odh-db-operator-metrics-reader]
        SCCRole[odh-db-internal-postgres]
    end

    subgraph Resources["API Resources"]
        Secrets["core: secrets<br/>cluster-wide"]
        CoreRO["core: configmaps, serviceaccounts, services"]
        PVCs["core: persistentvolumeclaims"]
        CRDs["apiextensions: customresourcedefinitions"]
        CRDPatch["CRDs databaseclaims / databaseproviders /<br/>schemaclaims.infrastructure.opendatahub.io"]
        WorkloadRO["apps statefulsets, cert-manager certificates/issuers,<br/>networkpolicies, rolebindings"]
        Claims["infrastructure.opendatahub.io<br/>databaseclaims, schemaclaims"]
        Providers["infrastructure.opendatahub.io<br/>databaseproviders"]
        InfraSub["infrastructure.opendatahub.io<br/>*/status, */finalizers"]
        DSvc["services.platform.opendatahub.io<br/>databaseservices (+status, finalizers)"]
        SCC["security.openshift.io<br/>SCC odh-db-internal-postgres"]
        Reviews["tokenreviews, subjectaccessreviews"]
        Events["events.k8s.io events"]
        Metrics["nonResourceURL /metrics"]
        WriterRes["configmaps, PVCs, secrets, SAs, services,<br/>statefulsets, rolebindings, certificates,<br/>issuers, networkpolicies"]
        Leases["configmaps, coordination leases, events"]
    end

