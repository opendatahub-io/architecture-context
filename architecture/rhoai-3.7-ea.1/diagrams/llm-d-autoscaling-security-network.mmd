graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        NoIngress["No ingress defined<br/>no Routes, Ingresses, Gateways, HTTPRoutes"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy, no service mesh)"]
        direction TB

        subgraph NS_WVA["Namespace: wva-system - LEGACY WVA (deprecated)"]
            WVA["WVA controller-manager<br/>SA: controller-manager<br/>Image: controller:latest placeholder<br/>non-root, drop ALL caps"]
            Probes["Probes :8081/TCP<br/>HTTP, no auth<br/>/healthz /readyz"]
            MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8443/TCP HTTPS<br/>self-signed cert (K8s) / service-ca (OCP)<br/>TokenReview + SubjectAccessReview"]
            WVA --- Probes
            WVA --- MetricsSvc
        end

        subgraph NS_Mon["Monitoring namespace"]
            Prom["Prometheus 9090/TCP<br/>kube-prometheus-stack"]
            Thanos["Thanos Querier 9091/TCP<br/>openshift-monitoring<br/>kube-rbac-proxy"]
        end

        subgraph NS_KEDA["KEDA namespace"]
            KEDA["KEDA operator<br/>+ managed HPA"]
        end

        subgraph NS_User["Namespace: user / llm-d workload"]
            EPP["EPP pods<br/>metrics port: Service port named *metric*<br/>/metrics"]
            ModelServers["vLLM Deployments /<br/>LeaderWorkerSets"]
        end

        Kubelet["kubelet / Kubelet probes"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    %% Flows
    WVA -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token controller-manager<br/>watch, scale, leases"| API
    WVA -->|"HTTPS/9090<br/>TLS 1.2 min, skip-verify by default<br/>Bearer SA token"| Prom
    WVA -->|"HTTPS/9091<br/>TLS 1.2 min, service-ca verified<br/>Bearer SA token, cluster-monitoring-view"| Thanos
    WVA ==>|"HTTP plaintext / EPP metrics port<br/>NO ENCRYPTION<br/>Bearer epp-metrics-reader token in clear"| EPP
    Prom -->|"HTTPS/8443<br/>TLS, insecureSkipVerify on K8s<br/>Bearer to TokenReview + SAR"| MetricsSvc
    Kubelet -->|"HTTP/8081<br/>no auth"| Probes
    Prom -->|"HTTP(S) / metrics port<br/>per ServiceMonitor"| ModelServers
    Prom -->|"HTTP(S) / metrics port<br/>per ServiceMonitor"| EPP
    KEDA -->|"HTTPS/9090-9091<br/>TLS<br/>Bearer TriggerAuthentication"| Prom
    KEDA -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token, scale update"| API
    API -->|scale| ModelServers

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef legacy fill:#e0e0e0,stroke:#666,stroke-width:2px,stroke-dasharray: 5 5
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class NoIngress external
    class WVA,Probes,MetricsSvc legacy
    class Prom,Thanos,KEDA,ModelServers,Kubelet internal
    class EPP risk
    class API controlplane
