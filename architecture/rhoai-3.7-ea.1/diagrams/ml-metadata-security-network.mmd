graph TB
    subgraph Cluster["CLUSTER NETWORK (no NetworkPolicy, Service or Ingress in repo)"]
        subgraph Clients["Platform clients (inferred)"]
            Driver["KFP driver / launcher / API server"]
            Envoy["metadata-envoy gRPC-Web proxy<br/>(fronts DSP UI)"]
        end

        subgraph NS_DSPA["Namespace: per-DSPA (deployed by DSPO, inferred)"]
            MLMD["metadata_store_server<br/>Image: odh-mlmd-grpc-server-rhel9<br/>UID 65534, base ubi-minimal-pqc<br/>Listens 0.0.0.0:8080/TCP<br/>No authN / authZ<br/>TLS: BoringSSL (non-FIPS), off by default"]
        end
    end

    subgraph DataTier["DATA TIER"]
        MariaDB[("MySQL / MariaDB<br/>3306/TCP")]
        Postgres[("PostgreSQL<br/>5432/TCP")]
    end

    Driver -->|"gRPC/8080<br/>Plaintext by default (TLS/mTLS if ssl_config)<br/>No auth (optional mTLS client cert)"| MLMD
    Envoy -->|"gRPC/8080<br/>Plaintext by default<br/>No auth at MLMD"| MLMD
    MLMD -->|"MySQL wire/3306<br/>Optional TLS (BoringSSL)<br/>Server cert verify OFF by default<br/>User/password via CLI flags"| MariaDB
    MLMD -.->|"PostgreSQL wire/5432<br/>No TLS: libpq built without OpenSSL<br/>Password / passfile"| Postgres

    classDef client fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef component fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef data fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Driver,Envoy client
    class MLMD component
    class MariaDB,Postgres data
