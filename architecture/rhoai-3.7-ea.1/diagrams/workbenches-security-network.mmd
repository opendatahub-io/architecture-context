graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph Ingress["INGRESS - openshift-ingress"]
        GW["data-science-gateway<br/>443/TCP HTTPS TLS 1.2+<br/>Platform OAuth/OIDC<br/>TLS terminated at Gateway"]
    end

    subgraph CtrlNS["CONTROLLER NAMESPACE - redhat-ods-applications<br/>NetworkPolicy: ingress 9443, 8081; metrics from monitoring ns only"]
        direction TB
        HR["HTTPRoute ws-NS-NAME<br/>one per Workspace"]
        Ctrl["workspaces-controller<br/>SA: workspaces-controller<br/>webhook 9443/TCP HTTPS<br/>health 8081/TCP HTTP<br/>metrics 8443/TCP HTTPS"]
        WHSvc["workspaces-webhook-service<br/>443 to 9443/TCP<br/>TLS cluster profile, Service CA"]
        MSvc["workspaces-controller-metrics-service<br/>8443/TCP HTTPS<br/>Bearer to TokenReview/SAR"]
    end

    subgraph UserNS["USER NAMESPACE - Data Science Project<br/>NO NetworkPolicy created by controller"]
        direction TB
        RG["ReferenceGrant<br/>allows controller-ns HTTPRoute"]
        KRPSvc["WS-kube-rbac-proxy Service<br/>8443/TCP HTTPS<br/>TLS cluster profile, FIPS-filtered"]
        subgraph Pod["Workspace pod - StatefulSet, per-Workspace SA"]
            KRP["kube-rbac-proxy sidecar<br/>8443/TCP, health 8444/TCP<br/>SAR: get workspaces/NAME"]
            IDE["IDE container<br/>app port HTTP<br/>no auth"]
        end
        WSSvc["Workspace Service<br/>image-config ports HTTP<br/>no auth"]
    end

    subgraph Cluster["CLUSTER CONTROL PLANE"]
        K8s["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
        APICfg["config.openshift.io<br/>APIServer/cluster<br/>TLS profile"]
        SCA["OpenShift Service CA"]
    end

    subgraph Mon["MONITORING NAMESPACES"]
        Prom["Prometheus<br/>openshift-monitoring /<br/>redhat-ods-monitoring"]
    end

    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth/OIDC"| GW
    GW -->|"via HTTPRoute"| HR
    HR -.->|"cross-ns backendRef<br/>permitted by"| RG
    GW -->|"HTTPS/8443<br/>TLS Service CA<br/>Bearer token"| KRPSvc
    KRPSvc --> KRP
    KRP -->|"HTTPS/6443<br/>TokenReview + SAR<br/>via auth-delegator CRB"| K8s
    KRP -->|"HTTP loopback<br/>X-Auth-Request-User/Groups"| IDE
    WSSvc --> IDE

    K8s -->|"HTTPS/443 to 9443<br/>admission, failurePolicy Fail"| WHSvc
    WHSvc --> Ctrl
    Ctrl -->|"HTTPS/6443<br/>SA token<br/>CRUD, watches, pods/exec"| K8s
    Ctrl -->|"HTTP plaintext<br/>pod IP /api/status<br/>bypasses sidecar"| IDE
    Ctrl -->|"get/watch"| APICfg
    Prom -->|"HTTPS/8443<br/>Bearer token"| MSvc
    MSvc --> Ctrl
    SCA -.->|"serving certs"| WHSvc
    SCA -.->|"serving certs"| MSvc
    SCA -.->|"serving certs"| KRPSvc

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef trusted fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef control fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class GW,HR ingress
    class Ctrl,WHSvc,MSvc,Prom trusted
    class KRPSvc,KRP,RG tenant
    class IDE,WSSvc risk
    class K8s,APICfg,SCA control
