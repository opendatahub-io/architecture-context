graph TB
    subgraph Cluster["CLUSTER INTERNAL (deployment defined externally — no Service/NetworkPolicy in repo)"]
        subgraph Callers["Callers"]
            Orch["FMS Guardrails Orchestrator"]
            Kubelet["kubelet / probe"]
        end

        subgraph Pod["regex-detector container (namespace: set by deployer)"]
            Det["regex-detector<br/>Listener: 0.0.0.0:8080/TCP<br/>Plain HTTP — no TLS<br/>No authN / authZ<br/>No USER directive in image<br/>SA: default (no RBAC)"]
        end

        Logs["Container logs<br/>(full payload incl. PII at INFO)"]
    end

    subgraph Egress["EGRESS"]
        None["None — no outbound connections"]
    end

    Orch -->|"HTTP/8080<br/>POST /api/v1/text/contents<br/>Encryption: none<br/>Auth: none"| Det
    Kubelet -->|"HTTP/8080<br/>GET /health<br/>Encryption: none<br/>Auth: none"| Det
    Det -.->|stdout| Logs
    Det -.->|"no egress"| None

    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef component fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class Orch,Kubelet internal
    class Det component
    class Logs risk
    class None external
