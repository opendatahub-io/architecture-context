graph LR
    MaaS["Models-as-a-Service<br/>maas-controller + maas-api + maas-discovery"]

    %% Platform / external dependencies
    MaaS -->|"AuthPolicy, TokenRateLimitPolicy,<br/>TelemetryPolicy (RHCL 1.3+)"| Kuadrant["Red Hat Connectivity Link<br/>Authorino + Limitador"]
    MaaS -->|"DestinationRule, EnvoyFilter,<br/>ServiceEntry, Telemetry"| Istio["OpenShift Service Mesh / Istio<br/>(Gateway API impl)"]
    MaaS -->|"Gateway read, HTTPRoute CRUD"| GatewayAPI["Gateway API v1.6.2<br/>maas-default-gateway"]
    MaaS -->|"API key store (pgx, migrate)"| Postgres[("PostgreSQL<br/>maas-db-config")]
    MaaS -->|"platform, service-ca, TLS profile"| OpenShift["OpenShift 4.19.9+"]
    MaaS -.->|"certs (xKS only)"| CertManager["cert-manager<br/>ClusterIssuer rhai-ca-issuer"]
    MaaS -.->|"usage logs, dashboards (optional)"| ObsStack["OpenTelemetry operator<br/>Loki, Perses"]
    MaaS -->|"watch / CRUD / TokenReview / SAR"| K8sAPI["Kubernetes API"]

    %% Internal RHOAI dependencies
    RHOAIOp["RHOAI Operator<br/>(DSC modelsAsService)"] -->|"deploys controller,<br/>DSCInitialization read"| MaaS
    MaaS -->|"LLMInferenceService read"| KServe["KServe"]
    MaaS -->|"InferenceObjective CRUD"| LLMD["llm-d"]
    MaaS -->|"deploys image, ext_proc 9004/TCP,<br/>inference.opendatahub.io CRDs, AIGuardrails"| IPP["ai-gateway /<br/>payload-processing (IPP)"]
    MaaS -->|"inference.opendatahub.io types,<br/>AIGuardrails read"| AIGWCtrl["ai-gateway-controller"]

    %% Consumers
    Dashboard["odh-dashboard / maas-ui"] -->|"REST 8443/TCP<br/>keys and subscriptions"| MaaS
    Prom["Prometheus<br/>redhat-ods-monitoring"] -->|"scrape 9090, 8443/TCP"| MaaS
    Clients["API clients"] -->|"HTTPS 443 via gateway"| GatewayAPI

    %% Outbound
    MaaS -->|"ServiceEntry, 443/TCP"| ExtProviders["External LLM providers<br/>(OpenAI, Anthropic, ...)"]

    %% Key Go libraries
    subgraph GoLibs["Key Go libraries"]
        direction TB
        L1["controller-runtime v0.25.2"]
        L2["gin v1.12.0"]
        L3["kustomize/api v0.21.1"]
        L4["pgx v5.11.0, golang-migrate v4.20.1"]
        L5["kserve v0.19.0-rc0, llm-d-router v0.11.0"]
        L6["openai-go v2.7.1, cel-go v0.29.2"]
        L7["otel v1.47.0 (optional), prometheus client v1.24.1"]
    end
    MaaS -.->|builds with| GoLibs

    style MaaS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Kuadrant fill:#999,stroke:#333
    style Istio fill:#999,stroke:#333
    style GatewayAPI fill:#999,stroke:#333
    style OpenShift fill:#999,stroke:#333
    style CertManager fill:#999,stroke:#333,stroke-dasharray: 5 5
    style ObsStack fill:#999,stroke:#333,stroke-dasharray: 5 5
    style RHOAIOp fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style LLMD fill:#7ed321,stroke:#333
    style IPP fill:#7ed321,stroke:#333
    style AIGWCtrl fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
