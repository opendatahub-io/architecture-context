graph TD
    subgraph K8sRBAC["Kubernetes RBAC"]
        None["training_hub defines NO ClusterRoles, Roles,<br/>RoleBindings or ServiceAccounts<br/>and makes no Kubernetes API calls"]
    end

    subgraph Host["Hosting identity - owned by other components"]
        PodSA["Training pod ServiceAccount<br/>set by Kubeflow Trainer / KFTO / workbench"]
    end

    subgraph Creds["Outbound credentials - process-wide env vars"]
        AWS["AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY<br/>or credential chain"]
        OpenAI["OPENAI_API_KEY<br/>dummy fallback, mutated by gepa()"]
        Wandb["WANDB_API_KEY"]
        Tokens["MLflow / HF tokens"]
    end

    subgraph Targets["Protected resources"]
        S3["S3 bucket / prefix<br/>checkpoint read/write/delete"]
        LLM["OpenAI-compatible LLM endpoint"]
        WB["W&B project"]
        ML["MLflow experiment / HF Hub"]
    end

    subgraph Local["Local trust boundaries"]
        Payload["Callback payload file 0600<br/>exec() in all ranks"]
        CLIImport["CLI YAML callable params<br/>importlib.import_module"]
    end

    PodSA -->|"mounts Secrets as env"| Creds
    AWS -->|"get, put, delete objects"| S3
    OpenAI -->|"Bearer auth"| LLM
    Wandb -->|API key| WB
    Tokens -->|SDK auth| ML
    PodSA -.->|"filesystem perms on output_dir PVC"| Payload
    PodSA -.->|"whoever controls config"| CLIImport

    style None fill:#e8e8e8
    style PodSA fill:#4a90e2
    style AWS fill:#f5a623
    style OpenAI fill:#f5a623
    style Wandb fill:#f5a623
    style Tokens fill:#f5a623
    style S3 fill:#7ed321
    style LLM fill:#7ed321
    style WB fill:#7ed321
    style ML fill:#7ed321
    style Payload fill:#f8cecc
    style CLIImport fill:#f8cecc
