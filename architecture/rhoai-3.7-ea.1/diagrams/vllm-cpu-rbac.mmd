graph TD
    subgraph "Service Account"
        SA["ISVC predictor pod ServiceAccount<br/>(KServe default; none defined by this repo)"]
    end

    subgraph "Kubernetes RBAC"
        None["No ClusterRoles, Roles or bindings<br/>vLLM makes no Kubernetes API calls"]
    end

    subgraph "Application-level access (uvicorn 8000/TCP)"
        V1["/v1/* chat, completions, responses,<br/>messages, models, embeddings, audio,<br/>realtime WS, LoRA load/unload"]
        V2["/v2/embed, /v2/rerank"]
        Inf["/inference/v1/generate"]
        Compute["/tokenize, /detokenize, /pooling,<br/>/classify, /score, /rerank,<br/>/generative_scoring, /invocations"]
        Ops["/scale_elastic_ep, /start_profile,<br/>/stop_profile, /abort_requests"]
        Health["/health, /load, /version, /ping,<br/>/metrics, /docs"]
    end

    Key["Bearer API key (opt-in)<br/>--api-key / VLLM_API_KEY<br/>SHA-256 + compare_digest"]
    Platform["Platform auth (expected)<br/>Route / Gateway / auth proxy"]
    Anyone["Any caller with network reach to the pod"]

    SA -.->|no bindings| None
    Platform -.->|guards external path only| Key
    Anyone -->|if key configured| Key
    Key -->|grants| V1
    Key -->|grants| V2
    Key -->|grants| Inf
    Anyone -->|unauthenticated| Compute
    Anyone -->|unauthenticated| Ops
    Anyone -->|unauthenticated| Health

    style SA fill:#4a90e2
    style None fill:#e8e8e8
    style Key fill:#f5a623
    style Platform fill:#7ed321
    style Anyone fill:#f8cecc
    style Ops fill:#f8cecc
    style Compute fill:#f8cecc
    style V1 fill:#f5a623
    style V2 fill:#f5a623
    style Inf fill:#f5a623
    style Health fill:#f5a623
