graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Browser / API Client"]
        Admin["Platform Admin"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Router["OpenShift Router<br/>443/TCP<br/>Reencrypt (gateway) / Edge+HSTS (legacy)"]
        LB["LoadBalancer (XKS mode)<br/>443/TCP HTTPS"]
    end

    subgraph GatewayNS["Namespace: openshift-ingress"]
        GW["data-science-gateway (Envoy)<br/>443/TCP HTTPS, TLS 1.2+ Terminate<br/>cert data-science-gatewayconfig-tls<br/>EnvoyFilter ext_authz + Lua"]
        KAP["kube-auth-proxy<br/>8443/TCP HTTPS, 9000/TCP metrics<br/>SA: kube-auth-proxy<br/>cert kube-auth-proxy-tls (service-ca)<br/>NetPol: ingress gateway only, egress ALL"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph OperatorNS["Namespace: redhat-ods-operator"]
        Op["rhods-operator manager (x3)<br/>SA: redhat-ods-operator-controller-manager<br/>ClusterRole rhods-operator-role (near cluster-admin)<br/>Metrics 8443/TCP, Webhook 9443/TCP, Probes 8081/TCP HTTP"]
        CM["cloudmanager (XKS optional)<br/>metrics: plain HTTP, NO auth"]
    end

    subgraph AppNS["Namespace: redhat-ods-applications"]
        Redirect["dashboard-redirect nginx<br/>8080/TCP HTTP plaintext<br/>exempt from default NetPol"]
        Backends["Backends: dashboard, model APIs<br/>enforce RBAC via SAR"]
    end

    subgraph MonNS["Namespace: redhat-ods-monitoring"]
        Prom["Prometheus"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OAuth["OpenShift OAuth server<br/>443/TCP HTTPS<br/>OAuthClient data-science"]
        OIDC["External OIDC Issuer<br/>443/TCP HTTPS<br/>Client ID / secret"]
    end

    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>no auth yet"| Router
    Client -->|"HTTPS/443<br/>TLS (XKS)"| LB
    Router -->|"HTTPS/443<br/>TLS service-ca reencrypt"| GW
    LB -->|HTTPS/443| GW
    GW -->|"HTTPS/8443 ext_authz<br/>TLS, cert NOT verified<br/>cookie / Bearer"| KAP
    KAP -->|"HTTPS/443<br/>OAuth2 code flow"| OAuth
    KAP -->|"HTTPS/443<br/>OIDC"| OIDC
    KAP -->|"HTTPS/6443<br/>TokenReview<br/>system:auth-delegator"| API
    GW -->|"Bearer user token<br/>cookies stripped"| Backends
    Router -->|"HTTP/8080<br/>plaintext in-cluster"| Redirect

    Admin -->|"HTTPS/6443<br/>user token"| API
    API -->|"HTTPS 443→9443<br/>service-ca caBundle<br/>failurePolicy Fail"| Op
    Op -->|"HTTPS/6443<br/>SA token<br/>watch + SSA"| API
    CM -->|"HTTPS/6443<br/>SA token"| API
    Prom -->|"HTTPS/8443<br/>Bearer TokenReview + SAR"| Op

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,Admin external
    class Router,LB,GW ingress
    class API,Backends,Prom internal
    class Op,KAP,CM,Redirect risk
    class OAuth,OIDC externalservice
