graph TB
    %% ogx-distribution: packaging repo that builds the RHOAI OGX server image (odh-ogx-core-rhel9)
    %% Source: architecture/rhoai-3.7-ea.1/ogx-distribution.md

    subgraph BuildTime["Build Time (repo tooling)"]
        BuildYaml["build/build.yaml<br/>single source of truth"]
        Generators["build/*.py generators<br/>gen_config, gen_containerfile,<br/>gen_lockfile, gen_distro_docs,<br/>verify_secrets"]
        SyncLabels["scripts/sync_labels.py"]
        Lockfiles["requirements-lock-konflux.txt<br/>hashed, ~1,350 lines"]
        DockerfileKonflux["Dockerfile.konflux<br/>config.yaml as base64 OCI label<br/>com.ogx.config.config.yaml"]
        BuildYaml --> Generators
        Generators -->|generates| Lockfiles
        SyncLabels -->|generates + syncs labels| DockerfileKonflux
    end

    subgraph Image["Container Image: quay.io/rhoai/odh-ogx-core-rhel9"]
        Entrypoint["entrypoint.sh<br/>resolves 18 *_FILE secrets<br/>selects config<br/>optional opentelemetry-instrument"]
        ConfigYaml["config.yaml (rh distribution)<br/>env-gated providers<br/>PostgreSQL storage, ABAC policy"]
        Server["OGX server (ogx run --insecure)<br/>FastAPI/uvicorn<br/>8321/TCP HTTP"]
        ModelCache["${APP_ROOT}/.cache<br/>docling, embedding, tiktoken<br/>from modelcar"]

        subgraph AlwaysOn["Always-on inline providers"]
            Builtin["inline::builtin<br/>responses, messages"]
            LocalFS["inline::localfs<br/>files"]
            FileSearch["inline::file-search"]
            MCPRuntime["remote::model-context-protocol"]
            AutoFP["inline::auto<br/>file processors"]
            RefBatch["inline::reference<br/>batches"]
        end

        subgraph Gated["Env-gated remote providers"]
            InferenceP["Inference: vLLM, OpenAI, Anthropic,<br/>Azure, Bedrock, Vertex AI,<br/>Gemini, watsonx"]
            VectorP["vector_io: Milvus,<br/>pgvector, Qdrant"]
            S3P["Files: S3"]
            SearchP["Tools: Brave, Tavily"]
        end

        Entrypoint -->|exec with config| Server
        ConfigYaml -->|loaded by| Server
        Server --> AlwaysOn
        Server --> Gated
        AutoFP -.->|reads models| ModelCache
    end

    Generators -->|generates| ConfigYaml

    ServiceMonitor["ServiceMonitor<br/>/metrics every 60s<br/>managed-by: ogx-operator"]

    Operator["OGX Operator"] -->|deploys image, reads OCI labels| Image
    Client["Client<br/>notebook, app, agent"] -->|"HTTP/8321<br/>OpenAI + Anthropic APIs"| Server
    ServiceMonitor -->|scrapes| Server

    Server -->|KV + SQL state| Postgres[("PostgreSQL<br/>5432/TCP")]
    InferenceP -->|inference| VLLM["KServe / vLLM / MaaS"]
    InferenceP -->|inference| LLMAPIs["Public LLM APIs"]
    VectorP --> VectorDB[("Vector stores")]
    S3P --> S3[("S3")]

    Konflux["Konflux hermetic build"] -->|builds| Image
    DockerfileKonflux -->|input to| Konflux

