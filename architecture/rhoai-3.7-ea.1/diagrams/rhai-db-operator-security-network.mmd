graph TB
    subgraph Cluster["CLUSTER CONTROL PLANE"]
        API["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph Monitoring["MONITORING NAMESPACES"]
        Prom["Prometheus / data-science-collector<br/>SA: data-science-collector-collector"]
    end

    subgraph OpNS["Namespace: odh-db-operator-system (NetworkPolicy: ingress 8443 from monitoring, 9443 from host-network; egress unrestricted)"]
        Op["odh-db-operator-operator<br/>SA: odh-db-operator-operator<br/>UID 65532, FIPS build<br/>:8081 health HTTP, no auth<br/>:8443 metrics HTTPS<br/>:9443 webhook, no handlers"]
        MetSvc["odh-db-operator-metrics-service<br/>ClusterIP 8443/TCP<br/>TLS service-ca cert"]
        WhSvc["odh-db-operator-webhook-service<br/>ClusterIP 443 to 9443<br/>TLS cert-manager self-signed<br/>no handlers registered"]
    end

    subgraph IntNS["Internal backend namespace (default odh-db-operator-system)"]
        PGSvc["Internal PostgreSQL Service<br/>headless, 5432/TCP"]
        PG["PostgreSQL StatefulSet<br/>rhel9/postgresql-16, UID/GID 26<br/>SCC odh-db-internal-postgres<br/>no SA token, ssl=on via cert-manager"]
        PGNP["Generated NetworkPolicy<br/>5432 from operator pod +<br/>bound-claim namespaces only"]
    end

    subgraph Tenant["TENANT NAMESPACES (claim namespaces)"]
        Consumer["Consuming workload<br/>mounts connection Secret"]
        ConnSec["Connection Secret<br/>Opaque, per-claim role/password"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES (administrator-managed)"]
        ExtPG["External PostgreSQL<br/>admin-defined port<br/>sslmode default require"]
    end

    Prom -->|"HTTPS/8443<br/>TLS service-ca<br/>Bearer token TokenReview+SAR"| MetSvc
    MetSvc --> Op
    Op -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| API
    Op -->|"PostgreSQL/5432<br/>TLS verify-full when enabled<br/>postgres admin password"| PGSvc
    Op -->|"PostgreSQL/admin-defined<br/>require, verify-ca if CA given<br/>admin credentials"| ExtPG
    PGSvc --> PG
    PGNP -.->|guards| PGSvc
    Consumer -->|reads| ConnSec
    Consumer -->|"PostgreSQL/5432<br/>per sslmode + ca.crt<br/>per-claim role/password"| PGSvc
    Consumer -.->|"PostgreSQL<br/>per sslmode"| ExtPG
    WhSvc --> Op

    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef tenant fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class API control
    class Prom monitoring
    class Op,MetSvc,WhSvc operator
    class PGSvc,PG,PGNP data
    class Consumer,ConnSec tenant
    class ExtPG externalservice
