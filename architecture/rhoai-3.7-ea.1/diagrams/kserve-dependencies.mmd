graph LR
    KServe["KServe<br/>module + controllers"]

    %% External Dependencies (libraries / platform services)
    KServe -->|"operator framework"| CR["controller-runtime v0.25.2"]
    KServe -->|"K8s API"| ClientGo["client-go v0.37.1"]
    KServe -->|"HTTPRoute / Gateway"| GWAPI["Gateway API v1.6.2"]
    KServe -->|"InferencePool"| GIE["Gateway API Inference Ext v1.6.2"]
    KServe -->|"multi-node LLM"| LWS["LeaderWorkerSet v1.0.0"]
    KServe -->|"Route, TLS profile, SCC"| OCPAPI["openshift/api"]
    KServe -.->|"Serverless, optional"| Knative["Knative Serving v0.48.1"]
    KServe -.->|"VirtualService, optional"| Istio["Istio client v1.31.2"]
    KServe -.->|"ScaledObject, optional"| KEDA["KEDA v2.20.2"]
    KServe -.->|"collector, optional"| OTel["OpenTelemetry operator v0.152.0"]
    KServe -.->|"ServiceMonitor, optional"| PromOp["prometheus-operator v0.91.0"]
    KServe -->|"OCI / KernelCache"| Cosign["cosign v3, go-containerregistry"]
    KServe -->|"TLS certs"| CertMgr["cert-manager / service-CA"]
    KServe -->|"model servers"| PyStack["Python 3.12: FastAPI, uvicorn,<br/>grpcio, cryptography, jwcrypto"]

    %% Internal RHOAI Dependencies
    KServe -->|"Go library"| PlatUtil["odh-platform-utilities"]
    KServe -->|"deploys manifests"| OMC["odh-model-controller"]
    KServe -->|"EPP, P/D sidecar images"| LLMD["llm-d router"]
    KServe -->|"runtime images"| RHAIIS["RHAIIS vLLM<br/>CUDA/ROCm/Gaudi/Spyre/CPU"]
    KServe -->|"runtime images"| OVMS["OVMS / MLServer"]
    KServe -.->|"Removed by default"| MEX["ModelExpress"]
    KServe -.->|"Removed by default"| WVA["Workload Variant Autoscaler"]
    KServe -->|"CRD read"| HWP["HardwareProfile"]
    KServe -->|"CRD read"| MonCR["Monitoring CR"]
    KServe -->|"TelemetryPolicy"| Kuadrant["Kuadrant"]
    KServe -->|"NIM Account"| NIM["NIM"]
    KServe -->|"confidential serving"| CoCo["OSC storage helper /<br/>Trustee KBS"]

    %% Integration Points (consumers)
    RHODS["rhods-operator"] -->|"Kserve PlatformObject"| KServe
    Dashboard["ODH Dashboard"] -->|"creates ISVC / LLMISVC"| KServe
    OMC -->|"watches ISVC / LLMISVC"| KServe

    %% External Services
    KServe -->|"API server 6443"| K8sAPI["Kubernetes API"]
    KServe -->|"model storage 443"| Storage["S3 / GCS / Azure / HF / OCI"]
    KServe -->|"scrape 8443"| Prom["Prometheus / Perses"]

