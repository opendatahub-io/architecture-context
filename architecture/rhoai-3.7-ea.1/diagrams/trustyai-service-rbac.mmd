graph TD
    subgraph K8sRBAC["Kubernetes RBAC (none in this repo)"]
        NoRBAC["No ClusterRoles, Roles or Bindings defined<br/>Service does not call the Kubernetes API"]
        OpRBAC["kube-rbac-proxy RBAC provisioned by trustyai-service-operator<br/>authentication.k8s.io tokenreviews: create<br/>authorization.k8s.io subjectaccessreviews: create"]
    end

    subgraph Callers["Callers"]
        User["User / ODH Dashboard<br/>Bearer token"]
        Loggers["KServe logger / ModelMesh"]
        Prom["Prometheus"]
        Any["Any pod with network reach"]
    end

    subgraph AppAccess["Application-level access (no auth middleware)"]
        KRP["kube-rbac-proxy sidecar<br/>TokenReview + SAR"]
        P8081["Main app 127.0.0.1:8081<br/>all routes"]
        P4443["Main app 0.0.0.0:4443<br/>all routes, NO AUTH"]
        P8080["health_app 0.0.0.0:8080<br/>POST /, POST /consumer/kserve/v2,<br/>GET /q/health*, NO AUTH"]
    end

    subgraph Resources["Data / API resources"]
        MetricsAPI["Metrics API: /metrics/* register, delete, compute"]
        DataAPI["Data API: /data/upload, /info/*"]
        Ingest["Inference payload storage"]
        PromMetrics["Prometheus endpoint: /q/metrics"]
    end

    OpRBAC -.->|enables| KRP
    User -->|authenticated| KRP
    KRP -->|authorized| P8081
    Loggers -->|unauthenticated plaintext| P8080
    Prom -->|TLS, no app auth| P4443
    Any -.->|"reachable unless NetworkPolicy"| P4443
    Any -.->|"reachable unless NetworkPolicy"| P8080
    P8081 -->|"GET, POST, DELETE"| MetricsAPI
    P8081 -->|"GET, POST, DELETE"| DataAPI
    P4443 -->|"GET, POST, DELETE"| MetricsAPI
    P4443 -->|"GET, POST, DELETE"| DataAPI
    P4443 -->|GET| PromMetrics
    P8080 -->|POST write| Ingest

    style NoRBAC fill:#e8e8e8
    style OpRBAC fill:#f5a623
    style KRP fill:#4a90e2
    style P8081 fill:#7ed321
    style P4443 fill:#f8cecc
    style P8080 fill:#f8cecc
    style MetricsAPI fill:#7ed321
    style DataAPI fill:#7ed321
    style Ingest fill:#7ed321
    style PromMetrics fill:#7ed321
