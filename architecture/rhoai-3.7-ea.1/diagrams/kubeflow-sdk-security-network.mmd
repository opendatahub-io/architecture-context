graph TB
    subgraph UserZone["USER PROCESS (trust = caller identity; SDK adds no SA, RBAC or Service)"]
        SDK["kubeflow SDK 0.5.0<br/>Python library in workbench pod or laptop<br/>No listening ports"]
        Sock["Docker / Podman socket<br/>local Unix socket, OS permissions<br/>(container backend only)"]
        SDK -->|HTTP over Unix socket| Sock
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["Kubernetes API server<br/>6443/TCP (or 443)<br/>RBAC: caller's namespace permissions"]
    end

    subgraph Tenant["TENANT NAMESPACE (Data Science Project)"]
        subgraph TrainPod["TrainJob pod (universal training image, pod SA)"]
            Script["Generated training script<br/>(remote code execution of user function)"]
            Metrics["Metrics HTTP server<br/>0.0.0.0:28080/TCP<br/>NO TLS, NO AUTH"]
            VLLM["vllm-sidecar<br/>localhost:8234/TCP<br/>HTTP, loopback only"]
            Script --> Metrics
            Script -->|HTTP loopback| VLLM
        end
        SparkSrv["Spark Connect server<br/>15002/TCP gRPC<br/>plaintext, no auth"]
        DataConn["Data Connection Secret<br/>Opaque S3 keys<br/>referenced via secretKeyRef"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        TC["Trainer controller<br/>status endpoint (HTTPS)<br/>KUBEFLOW_TRAINER_SERVER_URL"]
        MR["Model Registry REST<br/>443/TCP HTTPS (or 8080 HTTP)"]
        KFP["KFP API<br/>HTTPS"]
    end

    subgraph External["EXTERNAL SERVICES (egress)"]
        PyPI["PyPI pypi.org/simple<br/>443/TCP HTTPS<br/>default pip index"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>HF_TOKEN optional"]
        S3["S3-compatible storage<br/>443/TCP HTTPS"]
    end

    SDK -->|HTTPS/6443<br/>TLS kubeconfig / in-cluster CA<br/>Bearer token / client cert| API
    API -->|key names only| DataConn
    SDK -->|gRPC/15002 in-cluster<br/>plaintext, no auth| SparkSrv
    SDK -.->|off-cluster: port-forward<br/>SPDY tunnel, TLS to API server| API
    API -.->|tunnel 15002| SparkSrv
    SDK -->|HTTPS/443<br/>TLS, optional custom CA<br/>Bearer user_token| MR
    SDK -->|HTTPS<br/>TLS<br/>Bearer| KFP
    SDK -->|HTTPS/443<br/>TLS<br/>S3 access keys| S3

    TC -->|HTTP/28080<br/>plaintext<br/>no auth| Metrics
    Script -->|HTTPS POST<br/>TLS, controller CA<br/>projected SA token, 300s cache| TC
    Script -->|HTTPS/443<br/>TLS, verify may be disabled<br/>S3 keys from Data Connection| S3
    Script -->|HTTPS/443<br/>TLS<br/>no auth - pip install| PyPI
    Script -->|HTTPS/443<br/>TLS<br/>HF_TOKEN| HF

    classDef user fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef control fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class SDK,Sock user
    class API control
    class Script,VLLM,DataConn tenant
    class Metrics,SparkSrv risk
    class TC,MR,KFP platform
    class PyPI,HF,S3 externalservice
