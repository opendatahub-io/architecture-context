graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        ExtClient["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-managed, not in this repo)"]
        GW["Gateway API HTTPRoute + auth proxy<br/>443/TCP HTTPS TLS<br/>Bearer token<br/>only when enable-auth: 'true'"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy shipped)"]
        Orch["FMS Guardrails Orchestrator<br/>(in-cluster caller)"]
        Prom["Prometheus<br/>user workload monitoring"]

        subgraph NS_User["Namespace: user project"]
            Svc["Service: isvc-predictor<br/>ClusterIP 80/TCP to 8000"]
            HF["HF Detector kserve-container<br/>uvicorn 0.0.0.0:8000 HTTP plaintext<br/>No in-app auth, UID 1001<br/>Image: odh-guardrails-detector-huggingface-runtime-rhel9"]
            SI["storage-initializer"]
            Vol["/mnt/models volume"]
            Secret["Secret: S3 data connection<br/>Opaque, AWS keys"]
        end

        subgraph Upstream["Upstream-only detectors (not shipped in 3.7-ea.1)"]
            BI["Built-in detector<br/>8080/TCP HTTP, no auth<br/>custom Python code runs in-process"]
            LJ["LLM-judge detector<br/>8000/TCP HTTP, no auth"]
        end
    end

    subgraph ExtSvc["EXTERNAL / OTHER SERVICES"]
        S3["S3 storage<br/>443/TCP HTTPS (or 9000/TCP HTTP sample MinIO)<br/>AWS access keys"]
        LLM["Judge LLM endpoint<br/>VLLM_BASE_URL<br/>HTTP/HTTPS, no auth"]
    end

    ExtClient -->|"HTTPS/443<br/>TLS<br/>Bearer token"| GW
    GW -->|"HTTP/8000<br/>plaintext at pod (mTLS only with sidecar)<br/>no in-app auth"| Svc
    Orch -->|"HTTP/8000<br/>plaintext<br/>NO AUTH (direct path bypasses proxy)"| Svc
    Svc --> HF
    Prom -->|"HTTP/8000 GET /metrics<br/>no auth"| HF
    SI -->|"reads"| Secret
    SI -->|"HTTPS/443 or HTTP/9000<br/>AWS keys"| S3
    SI -->|"writes"| Vol
    HF -->|"reads MODEL_DIR"| Vol
    Orch -.->|"HTTP/8080, inbound headers forwarded to custom code"| BI
    Orch -.->|"HTTP/8000"| LJ
    LJ -.->|"HTTP/HTTPS<br/>certifi CA bundle<br/>no auth"| LLM

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class ExtClient external
    class GW ingress
    class Orch,Prom,Svc,SI,Vol internal
    class HF,BI,LJ risk
    class S3,LLM externalservice
    class Secret secret
