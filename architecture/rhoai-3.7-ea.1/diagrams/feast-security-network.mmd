graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / External User"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        Router["Route feast-{name}-ui<br/>443/TCP HTTPS<br/>TLS reencrypt, insecure → Redirect<br/>No auth at Route"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no service mesh; NetworkPolicy-driven)"]
        direction TB

        subgraph NS_Ops["Namespace: redhat-ods-applications"]
            Operator["feast-operator<br/>SA: feast-operator-controller-manager<br/>Metrics 8443/TCP HTTPS (TokenReview + SAR)<br/>Probes 8081/TCP HTTP (no auth)"]
            Dashboard["rhods-dashboard"]
            Prom["Prometheus<br/>(user-workload monitoring)"]
        end

        subgraph NS_Any["Any namespace"]
            Workbench["Workbench pod<br/>label opendatahub.io/feast-integration=true"]
        end

        subgraph NS_Tenant["Namespace: FeatureStore tenant"]
            Online["Online server<br/>443→6567/TCP HTTPS<br/>Feast authz"]
            Registry["Registry<br/>gRPC 443→6571 / REST 443→6573<br/>Feast authz"]
            Offline["Offline (Arrow Flight)<br/>443→8816/TCP TLS<br/>Feast authz"]
            UI["UI server<br/>443→8443/TCP HTTPS<br/>No auth detected"]
            Lineage["Lineage<br/>443→6581/TCP HTTPS"]
            MCP["MCP server<br/>443→8101/TCP HTTPS"]
            FeastMetrics["Feast metrics<br/>8000/TCP HTTP<br/>No TLS, no auth"]
            Cron["CronJob (ose-cli)<br/>SA: per-CR, Role pods/exec"]
        end

        subgraph NS_DR["Data registry (cluster singleton)"]
            KRP["kube-rbac-proxy<br/>443→8443/TCP HTTPS<br/>TokenReview + SAR"]
            DRReg["Feast REST registry<br/>127.0.0.1:6572 HTTP<br/>Feast forced no_auth"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Stores["Online / registry DBs<br/>PostgreSQL, Redis, Cassandra, Snowflake<br/>configurable TLS, DB creds"]
        S3["Object storage S3/GCS<br/>443/TCP HTTPS"]
        OIDC["OIDC provider<br/>443/TCP HTTPS, JWKS"]
        MLflow["MLflow / OpenLineage<br/>HTTPS, token / API key"]
        Git["Git repo<br/>443/TCP HTTPS, optional token"]
    end

    Browser -->|HTTPS/443<br/>TLS| Router
    Router -->|HTTPS/8443<br/>TLS reencrypt| UI

    Workbench -->|HTTPS/443→6567<br/>TLS service CA<br/>Bearer token| Online
    Workbench -->|gRPC/443→6571<br/>TLS<br/>Bearer token| Registry
    Dashboard -->|HTTPS/443→6573<br/>TLS<br/>Bearer token| Registry
    Dashboard -->|HTTPS/443→8443<br/>TLS service CA<br/>Bearer token| KRP
    KRP -->|HTTP loopback 6572<br/>X-Remote-User| DRReg

    Online -->|gRPC/6571 TLS<br/>intra-comm token| Registry
    Offline -->|gRPC/6571 TLS<br/>intra-comm token| Registry
    Prom -->|HTTP/8000<br/>no auth| FeastMetrics
    Prom -->|HTTPS/8443<br/>TokenReview + SAR| Operator

    Operator -->|HTTPS/6443<br/>SA token| K8sAPI
    Cron -->|HTTPS/WSS 6443<br/>pods/exec| K8sAPI
    Online -->|TokenReview<br/>HTTPS/6443| K8sAPI
    KRP -->|TokenReview + SAR<br/>HTTPS/6443| K8sAPI

    Online -->|TCP/TLS configured<br/>DB credentials| Stores
    Registry -->|TCP/HTTPS configured| Stores
    Offline -->|HTTPS/443<br/>AWS/GCP creds| S3
    Online -->|HTTPS/443 JWKS| OIDC
    Registry -->|HTTPS| MLflow
    Registry -->|HTTPS/443 clone| Git

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Router ingress
    class Operator,Dashboard,Prom,Online,Registry,Offline,Lineage,MCP,Cron,KRP,DRReg internal
    class UI,FeastMetrics,Workbench risk
    class K8sAPI control
    class Stores,S3,OIDC,MLflow,Git externalservice
