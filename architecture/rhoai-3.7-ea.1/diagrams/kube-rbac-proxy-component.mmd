graph TB
    %% kube-rbac-proxy (RHOAI 3.7-ea.1, v0.21.1 downstream fork)
    %% A sidecar utility with no CRDs and no controller. One binary, one upstream.

    Operators["RHOAI Component Operators<br/>(rhods-operator, notebook controller,<br/>KServe, TrustyAI, ...)"]
    Client["Client<br/>(user via Gateway HTTPRoute,<br/>in-cluster service, Prometheus)"]

    subgraph Pod["Workload Pod"]
        direction TB

        subgraph KRP["kube-rbac-proxy sidecar (odh-kube-rbac-proxy-rhel9)"]
            direction TB
            Listener["Secure Listener<br/>--secure-listen-address (usually 8443/TCP)<br/>HTTPS h2/http1.1, TLS 1.2+"]
            Health["/healthz listener<br/>--proxy-endpoints-port<br/>TLS, no auth"]
            AllowPaths["1. WithAllowPaths<br/>404 if not on --allow-paths"]
            IgnorePaths["2. --ignore-paths bypass<br/>skips authn/authz"]
            Timeouts["3. withRequestTimeouts<br/>auth 30s / upstream 30s"]
            AuthN["4. WithAuthentication (pkg/authn)<br/>TokenReview / OIDC JWT / x509<br/>anonymous disabled, 2 min cache"]
            AuthZ["5. WithAuthorization (pkg/authz)<br/>Union authorizer<br/>all attribute sets must allow"]
            Hardcoded["Hardcoded authorizer<br/>GET /metrics for<br/>openshift-monitoring:prometheus-k8s"]
            Static["Static authorizer<br/>config allow-list"]
            SAR["SAR authorizer<br/>Format1 rewrites / Format2 endpoints<br/>allow 5 min / deny 30s cache"]
            AuthHeaders["6. WithAuthHeaders<br/>x-remote-user / x-remote-groups"]
            RevProxy["7. ReverseProxy<br/>httputil.NewSingleHostReverseProxy"]
            Audit["pkg/audit<br/>OCSF 1.9.0 AI Operation profile<br/>async queue to stdout (optional)"]
            TLSReload["pkg/tls<br/>cert hot-reload, curve prefs"]

            Listener --> AllowPaths --> IgnorePaths --> Timeouts --> AuthN --> AuthZ
            IgnorePaths -.->|matched paths| RevProxy
            AuthZ --> Hardcoded
            AuthZ --> Static
            AuthZ --> SAR
            AuthZ --> AuthHeaders --> RevProxy
            TLSReload -.->|server cert| Listener
            AuthZ -.->|decorators when metadata profile| Audit
        end

        App["Upstream Application Container<br/>usually 8080/TCP localhost<br/>HTTP / HTTPS / h2c"]
        RevProxy -->|forward allowed request| App
    end

    Config["Mounted config<br/>--config-file (authorization YAML)<br/>serving cert, client CA, upstream CA"]
    K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    OIDC["OIDC Issuer (optional)<br/>443/TCP HTTPS"]
    Logs["Log collection<br/>stdout"]
    Kubelet["Kubelet probes"]

    Operators -->|inject sidecar + TLS profile flags| KRP
    Operators -->|mount| Config
    Config -.->|read| KRP
    Client -->|HTTPS 8443/TCP<br/>Bearer token or client cert| Listener
    AuthN -->|TokenReview| K8sAPI
    SAR -->|SubjectAccessReview| K8sAPI
    AuthN -->|discovery / JWKS| OIDC
    Audit --> Logs
    Kubelet -->|GET /healthz| Health

    style Listener fill:#4a90e2,color:#fff
    style Health fill:#4a90e2,color:#fff
    style AllowPaths fill:#4a90e2,color:#fff
    style IgnorePaths fill:#e57373,color:#fff
    style Timeouts fill:#4a90e2,color:#fff
    style AuthN fill:#4a90e2,color:#fff
    style AuthZ fill:#4a90e2,color:#fff
    style Hardcoded fill:#e57373,color:#fff
    style Static fill:#4a90e2,color:#fff
    style SAR fill:#4a90e2,color:#fff
    style AuthHeaders fill:#4a90e2,color:#fff
    style RevProxy fill:#4a90e2,color:#fff
    style Audit fill:#4a90e2,color:#fff
    style TLSReload fill:#4a90e2,color:#fff
    style App fill:#7ed321
    style Operators fill:#7ed321
    style Config fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style OIDC fill:#e8e8e8
    style Logs fill:#e8e8e8
    style Kubelet fill:#e8e8e8
    style Client fill:#e8e8e8
