graph TD
    subgraph SAs["Service Accounts"]
        SA["kuberay-operator<br/>(platform namespace)"]
        HeadSA["&lt;cluster&gt;-oauth-proxy-sa / head SA<br/>(user namespace, runtime)"]
    end

    subgraph Bindings["Bindings"]
        CRB1["ClusterRoleBinding<br/>kuberay-operator"]
        CRB2["ClusterRoleBinding<br/>kuberay-tls-profile-rolebinding"]
        RB1["RoleBinding<br/>kuberay-operator-configmap"]
        RB2["RoleBinding<br/>kuberay-operator-gateway-api"]
        RB3["RoleBinding<br/>kuberay-operator-leader-election"]
        RB4["RoleBinding &lt;cluster&gt; autoscaler<br/>(per RayCluster)"]
        SCC["SCC user grant<br/>run-as-ray-user (uid 1000, drop ALL)"]
    end

    subgraph Roles["Roles"]
        CR["ClusterRole kuberay-operator"]
        TLSR["ClusterRole kuberay-tls-profile-role"]
        CMR["ClusterRole kuberay-operator-configmap"]
        GWR["ClusterRole kuberay-operator-gateway-api"]
        LER["Role kuberay-operator-leader-election"]
        ASR["Role &lt;cluster&gt; autoscaler"]
    end

    subgraph HighPriv["High-privilege resources (cluster-wide)"]
        Secrets["core: secrets<br/>create, delete, get, list, update, watch"]
        Pods["core: pods<br/>create, delete, deletecollection, get, list, patch, update, watch"]
        RBAC["rbac: roles, rolebindings<br/>create, delete, get, list, (patch), update, watch"]
        Proxy["core: services/proxy, pods/proxy<br/>create, get, patch, update"]
    end

    subgraph Resources["Other API Resources"]
        Ray["ray.io: rayclusters, rayjobs, rayservices, raycronjobs<br/>create, delete, get, list, patch, update, watch<br/>+ */status, */finalizers"]
        Core["core: configmaps, PVCs, serviceaccounts, services<br/>full CRUD + watch"]
        Batch["batch: jobs<br/>full CRUD + watch"]
        Net["networking.k8s.io: networkpolicies, ingresses<br/>CRUD + watch; ingressclasses read"]
        GW["gateway.networking.k8s.io: gateways, httproutes, referencegrants<br/>CRUD + watch"]
        Route["route.openshift.io: routes<br/>CRUD + watch"]
        Cert["cert-manager.io: certificates, issuers<br/>create, get, list, (update), watch"]
        Auth["authentication/authorization.k8s.io:<br/>tokenreviews, subjectaccessreviews: create"]
        Misc["apps: deployments (no create/delete)<br/>coordination: leases; events.k8s.io: events<br/>discovery: endpointslices (read)<br/>rbac: clusterroles/bindings (read)<br/>operator.openshift.io: kubeapiservers (read)"]
        APIS["config.openshift.io: apiservers<br/>get, list, watch"]
        LeaderRes["configmaps, events, leases<br/>(operator namespace)"]
    end

    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| RB1
    SA -->|bound via| RB2
