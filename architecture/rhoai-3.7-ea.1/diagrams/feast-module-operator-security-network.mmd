graph TB
    subgraph Monitoring["CLUSTER INTERNAL - monitoring policy-group namespaces"]
        Prom["Prometheus<br/>OpenShift monitoring"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        PlatformOp["ODH/RHOAI Platform Operator<br/>Helm install + FeastOperator CR"]
    end

    subgraph ModuleNS["Namespace: release namespace - opendatahub-feast-system"]
        NPIn["NetworkPolicy: opendatahub-feast-allow-metrics-traffic<br/>ingress 8443/TCP from monitoring only"]
        NPOut["NetworkPolicy: opendatahub-feast-allow-egress<br/>allow-all egress"]
        MetricsSvc["Service: opendatahub-feast-metrics-service<br/>ClusterIP 8443/TCP"]
        Module["feast-module-operator manager<br/>SA: opendatahub-feast-operator<br/>UID 65532, read-only rootfs<br/>/metrics 8443 intended - default :8080<br/>/healthz /readyz 8081 HTTP no auth"]
    end

    subgraph AppNS["Namespace: redhat-ods-applications"]
        FeastOp["Feast Operator<br/>feast-operator-controller-manager<br/>SA: feast-operator-controller-manager"]
        FeastSvc["Service: feast-operator-controller-manager-metrics-service<br/>8443/TCP HTTPS<br/>service-CA cert controller-manager-metrics-tls"]
    end

    Kubelet["Kubelet probes"]

    Prom -->|HTTPS/8443<br/>TLS self-signed or profile-driven<br/>Bearer TokenReview + SAR| MetricsSvc
    MetricsSvc -->|8443/TCP| Module
    Prom -->|HTTPS/8443<br/>service-CA TLS<br/>Bearer TokenReview + SAR| FeastSvc
    FeastSvc --> FeastOp
    Kubelet -->|HTTP/8081<br/>plaintext<br/>no auth| Module
    PlatformOp -->|HTTPS/6443<br/>TLS 1.2+<br/>Platform operator SA| API
    Module -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>reconcile, TLS profile, leader election| API
    FeastOp -->|HTTPS/6443<br/>TLS 1.2+<br/>Feast SA| API
    NPIn -.->|guards| MetricsSvc
    NPOut -.->|governs| Module

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef policy fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Prom,Kubelet external
    class API,PlatformOp controlplane
    class MetricsSvc,FeastOp,FeastSvc internal
    class Module risk
    class NPIn,NPOut policy
