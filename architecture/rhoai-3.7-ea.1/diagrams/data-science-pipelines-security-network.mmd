graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / KFP SDK / ODH Dashboard<br/>OpenShift Bearer token"]
    end

    subgraph Ingress["INGRESS (DSPO-managed, outside this repo)"]
        Route["DSPA Route / Gateway<br/>443/TCP HTTPS<br/>TLS (router)"]
        AuthProxy["Auth Proxy<br/>OpenShift user token<br/>namespace RBAC"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        KAPI["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
        Argo["Argo workflow-controller<br/>platform-shared"]
    end

    subgraph NS["Namespace: DSPA project (per-namespace instance)"]
        direction TB
        API["ml-pipeline API server<br/>SA: ml-pipeline<br/>8888 REST / 8887 gRPC: optional TLS, Go defaults<br/>8443 webhook: TLS, HTTP fallback if no cert<br/>AuthZ: TokenReview + SAR only if MULTIUSER"]
        PA["Persistence Agent<br/>SA: ml-pipeline-persistenceagent"]
        SWF["ScheduledWorkflow Controller<br/>SA: ml-pipeline-scheduledworkflow<br/>/metrics HTTP"]
        Tasks["Task pods: driver + launcher + user code<br/>SA: pipeline-runner (broad * Role)<br/>holds object-store creds"]
        MLMD["metadata-grpc-service<br/>8080/TCP gRPC<br/>optional TLS, NO auth"]
        DB[("MariaDB / MySQL / PostgreSQL<br/>3306 / 5432 TCP<br/>DB password, optional TLS")]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible object store<br/>443 or configured<br/>HTTP/HTTPS endpoint-dependent<br/>Access key / secret key"]
        MLflow["MLflow tracking server<br/>HTTPS, insecureSkipVerify configurable<br/>kfp-mlflow-credentials"]
        URLs["Arbitrary pipeline URLs<br/>443/TCP HTTPS<br/>system CAs"]
    end

    User -->|HTTPS/443<br/>TLS<br/>Bearer token| Route
    Route --> AuthProxy
    AuthProxy -->|HTTP or HTTPS/8888<br/>optional TLS<br/>forwarded identity| API
    KAPI -->|HTTPS/8443<br/>TLS Go defaults<br/>admission caBundle| API
    API -->|HTTPS/6443<br/>SA token<br/>Workflows, CRs, TokenReview, SAR| KAPI
    API -->|MySQL/3306<br/>DB password| DB
    API -->|gRPC/8080<br/>optional TLS| MLMD
    API -->|HTTP/HTTPS<br/>access key| S3
    API -->|HTTPS<br/>Bearer/basic| MLflow
    API -->|HTTPS/443| URLs
    PA -->|gRPC/8887<br/>optional TLS<br/>SA Bearer + SAR report| API
    PA -->|HTTPS/6443 watch| KAPI
    SWF -->|gRPC/8887<br/>SA token, SAR runs create| API
    SWF -->|HTTPS/6443| KAPI
    Argo -->|create pods| KAPI
    Tasks -->|gRPC/8887<br/>optional TLS<br/>pipeline-runner token| API
    Tasks -->|gRPC/8080<br/>no auth| MLMD
    Tasks -->|HTTP/HTTPS<br/>access key from Secret| S3
    Tasks -.->|HTTPS optional<br/>MLFLOW_TRACKING_* env| MLflow
    Tasks -->|HTTPS/6443<br/>ConfigMaps, Secrets, PVCs| KAPI

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Route,AuthProxy ingress
    class KAPI,Argo control
    class API,PA,SWF,DB internal
    class Tasks,MLMD risk
    class S3,MLflow,URLs externalservice
