graph TB
    %% trainer-operator component structure (RHOAI 3.7-ea.1, operand Kubeflow Trainer 2.3.0)

    PlatformOp["rhods-operator<br/>(platform operator)"]
    TrainerCR["Trainer CR<br/>components.platform.opendatahub.io/v1alpha1<br/>default-trainer (Cluster, singleton)"]
    TrainerCfgCM["ConfigMap odh-trainer-config<br/>(platformVersion)"]
    APIServerCfg["APIServer cluster<br/>config.openshift.io<br/>(TLS profile + adherence)"]

    subgraph OperatorNS["trainer-operator-controller-manager Deployment (1 replica, SA trainer-operator-controller-manager)"]
        direction TB
        Manager["manager binary (cmd/main.go)<br/>controller-runtime v0.25.2<br/>metrics :8443 HTTPS, probes :8081"]
        Reconciler["Trainer reconciler<br/>(odh-platform-utilities framework)<br/>finalizer trainer-cleanup"]
        TLSWatcher["TLS profile resolver / watcher<br/>(internal/tls)"]
        Templates["Baked templates<br/>/opt/manifests-template<br/>/opt/runtimes-template<br/>/opt/imagestreams-template"]
        WorkDir["emptyDir /opt/manifests-work<br/>(256Mi, params.env edited)"]

        subgraph Actions["Action chain"]
            direction LR
            A1[checkDependencies] --> A2[ensureNamespace] --> A3[updateReleases] --> A4[renderManifests] --> A5["deploy (SSA)"] --> A6[deployments status] --> A7[stripRuntimeFinalizers] --> A8[GC]
        end

        Manager --> Reconciler
        Manager --> TLSWatcher
        Reconciler --> Actions
        Templates -->|copied at startup| WorkDir
        A4 -->|kustomize rhoai overlay| WorkDir
        TLSWatcher -->|operand tls section + hash| A4
    end

    PlatformOp -->|creates| TrainerCR
    PlatformOp -->|injects APPLICATIONS_NAMESPACE, RELATED_IMAGE_*| Manager
    PlatformOp -->|publishes| TrainerCfgCM
    TrainerCR -->|watched by| Reconciler
    TrainerCfgCM -->|read uncached| A3
    APIServerCfg -->|read at startup, watched| TLSWatcher

    subgraph Deps["Prerequisites (gate reconcile)"]
        JobSetOp["Red Hat JobSet Operator<br/>JobSetOperator CR cluster"]
        JobSetCRD["jobsets.jobset.x-k8s.io CRD"]
        OLM["OLM operatorconditions /<br/>clusterextensions"]
    end
    A1 -->|checks| JobSetOp
    A1 -->|checks| JobSetCRD
    A1 -->|lists| OLM

    subgraph AppNS["Applications namespace (spec.appNamespace, fallback opendatahub)"]
        Operand["kubeflow-trainer-controller-manager<br/>Kubeflow Trainer v2.3.0<br/>webhook 9443, metrics 8443, status 10443"]
        OperandSvc["Service kubeflow-trainer-controller-manager<br/>8443 / 443 / 10443"]
        OperandNP["NetworkPolicies (ingress/egress)"]
        OperandSM["ServiceMonitor"]
        OperandCfg["ConfigMap kubeflow-trainer-config<br/>(TLS profile injected)"]
    end

    subgraph ClusterScoped["Cluster-scoped operand resources"]
        CRDs["CRDs: TrainJob, TrainingRuntime,<br/>ClusterTrainingRuntime, OptimizationJob"]
        Webhooks["Mutating + Validating<br/>WebhookConfigurations"]
        CTRs["16 ClusterTrainingRuntimes<br/>torch-distributed, training-hub,<br/>openmpi, speculator, vllm-extract"]
        RBACRes["ClusterRoles / Bindings<br/>training-edit/admin/view, trainer-tls-profile"]
        ImageStreams["ImageStreams (OpenShift only)<br/>training-hub universal CUDA/ROCm/CPU"]
    end

    A5 -->|applies| Operand
    A5 -->|applies| OperandSvc
    A5 -->|applies| OperandNP
    A5 -->|applies| OperandSM
    A5 -->|applies| OperandCfg
    A5 -->|applies| CRDs
    A5 -->|applies| Webhooks
    A5 -->|applies| CTRs
    A5 -->|applies| RBACRes
    A5 -->|applies| ImageStreams

    Operand -->|creates JobSets| JobSetCRD

    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style Templates fill:#4a90e2,color:#fff
    style WorkDir fill:#4a90e2,color:#fff
    style TrainerCR fill:#f5a623
    style CRDs fill:#f5a623
    style CTRs fill:#f5a623
    style PlatformOp fill:#7ed321
    style TrainerCfgCM fill:#7ed321
    style Operand fill:#7ed321
    style JobSetOp fill:#e8e8e8
    style JobSetCRD fill:#e8e8e8
    style OLM fill:#e8e8e8
    style APIServerCfg fill:#e8e8e8
