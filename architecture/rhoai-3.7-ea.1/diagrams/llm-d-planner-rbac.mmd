graph TD
    subgraph SAs["Service Accounts (namespace: planner)"]
        SA["planner-backend"]
        DefaultSA["default<br/>(used by ui, ollama)<br/>no extra RBAC"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)"]
    end

    subgraph Roles["ClusterRole Permissions"]
        CR["planner-gpu-reader"]
    end

    subgraph Resources["API Resources"]
        Nodes["core<br/>nodes"]
    end

    subgraph NotGranted["Required by deploy endpoints but NOT granted"]
        NS["core<br/>namespaces: create"]
        ISVC["serving.kserve.io<br/>inferenceservices: apply/get/delete"]
        Pods["core<br/>pods: get/list"]
    end

    subgraph Outbound["Outbound identity use"]
        MC["Model Catalog<br/>SA token as Bearer fallback"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|list| Nodes
    SA -.->|"missing: deploy features fail in-cluster<br/>(also no kubectl in image)"| NS
    SA -.-> ISVC
    SA -.-> Pods
    SA -->|projected token| MC

    style SA fill:#4a90e2
    style DefaultSA fill:#e8e8e8
    style CRB fill:#f5a623
    style CR fill:#f5a623
    style Nodes fill:#7ed321
    style NS fill:#f8cecc
    style ISVC fill:#f8cecc
    style Pods fill:#f8cecc
    style MC fill:#7ed321
