graph TD
    subgraph SAs["Service Accounts (release namespace)"]
        SA_GC["gc ServiceAccount"]
        SA_API["apiserver ServiceAccount<br/>no bindings, token automounted"]
        SA_PROC["processor ServiceAccount<br/>no bindings, token automounted"]
    end

    subgraph Bindings["RoleBindings (namespaced)"]
        RB["&lt;release&gt;-gc-pod-watcher"]
    end

    subgraph Roles["Roles (namespaced; created only when gc.enabled AND reconciler.enabled)"]
        R["&lt;release&gt;-gc-pod-watcher"]
    end

    subgraph Resources["API Resources (same namespace)"]
        Pods["core<br/>pods"]
        STS["apps<br/>statefulsets"]
    end

    NoCR["No ClusterRoles or ClusterRoleBindings"]

    subgraph AppSecrets["Mounted Secrets"]
        Sec["batch-gateway-secrets<br/>postgresql-url, redis-url,<br/>inference-api-key, s3-secret-access-key<br/>/etc/.secrets read-only"]
        TLS["apiserver TLS secret<br/>(optional, cert-manager)"]
    end

    SA_GC -->|bound via| RB
    RB -->|grants| R
    R -->|get, list, watch| Pods
    R -->|get, list, watch| STS

    SA_API -.->|mounts| Sec
    SA_PROC -.->|mounts| Sec
    SA_GC -.->|mounts| Sec
    SA_API -.->|mounts| TLS

    style SA_GC fill:#4a90e2,color:#fff
    style SA_API fill:#a8c8f0
    style SA_PROC fill:#a8c8f0
    style RB fill:#f5a623
    style R fill:#f5a623
    style Pods fill:#7ed321
    style STS fill:#7ed321
    style NoCR fill:#e8e8e8,stroke-dasharray: 5 5
    style Sec fill:#fff2cc
    style TLS fill:#fff2cc
