graph TB
    Client["Clients<br/>eval-hub-sdk / RHOAI Dashboard"]
    MCPClient["AI Assistant<br/>(MCP client)"]

    subgraph Operator["trustyai-service-operator (deploys eval-hub)"]
        direction TB
        subgraph APIPod["eval-hub Pod (image odh-eval-hub-rhel9)"]
            KRP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>sets X-Tenant / X-User"]
            API["eval-hub API server<br/>127.0.0.1:8080/TCP<br/>cmd/eval_hub"]
            Metrics["Metrics listener<br/>0.0.0.0:8081/TCP<br/>/metrics"]
            Storage["SQL storage layer<br/>SQLite / PostgreSQL<br/>tenant-scoped"]
            Catalog["Provider / collection catalog<br/>config/providers, config/collections"]
            K8sRuntime["Kubernetes runtime<br/>runtimes/k8s"]
            LocalRuntime["Local runtime<br/>(dev / --local)"]
        end
    end

    MCP["evalhub-mcp<br/>stdio or 3001/TCP<br/>auth: none / rbac-proxy"]

    subgraph TenantNS["Tenant Namespace = X-Tenant"]
        direction TB
        JobCM["Job spec ConfigMap<br/>sidecar_config.json"]
        RefSecret["Per-job reference Secret<br/>(rewritten model creds)"]
        NetPol["NetworkPolicy<br/>ingress-deny, egress open"]
        subgraph JobPod["Evaluation Job Pod (batch/v1, SA token automount off)"]
            Init["eval-runtime-init<br/>init container<br/>S3 / Git / HF staging"]
            Sidecar["eval-runtime-sidecar<br/>native sidecar, localhost:8080<br/>credential injection"]
            Adapter["Adapter container<br/>provider image<br/>lm-eval, garak, ragas, ..."]
        end
    end

    Client -->|HTTPS + Bearer token| KRP
    KRP -->|HTTP + identity headers| API
    MCPClient -->|MCP stdio / HTTP| MCP
    MCP -->|REST + EVALHUB_TOKEN| KRP
    API --> Storage
    API --> Catalog
    API --> K8sRuntime
    API -.->|dev only| LocalRuntime
    K8sRuntime -->|creates| JobCM
    K8sRuntime -->|creates| RefSecret
    K8sRuntime -->|creates| NetPol
    K8sRuntime -->|creates Job| JobPod
    Init -->|stages data| Adapter
    Adapter -->|all outbound calls| Sidecar
    Sidecar -->|status events via proxy| KRP

    Storage -->|PostgreSQL wire| PG[("PostgreSQL")]
    API -->|experiments| MLflow["MLflow"]
    K8sRuntime -->|client-go| K8sAPI["Kubernetes API"]
    K8sRuntime -->|sizing| HWP["HardwareProfile CR"]
    K8sRuntime -->|queue labels| Kueue["Kueue LocalQueue"]
    Sidecar -->|results| MLflow
    Sidecar -->|artifacts| OCI["OCI Registry"]
    Sidecar -->|inference| Model["Model / judge endpoints"]
    Init --> DataSrc["S3 / Git / Hugging Face"]
    Prom["Prometheus"] -->|scrape| Metrics

