graph LR
    Sidecar["llm-d-routing-sidecar"]

    %% Runtime peers (internal platform)
    Sidecar -->|"decode + pass-through<br/>HTTP localhost:8001"| VLLMDecode["vLLM decode (same pod)"]
    Sidecar -->|"prefill stage<br/>HTTP(S) header port"| VLLMPrefill["vLLM prefill pods"]
    EPP["llm-d EPP / llm-d-router"] -->|"x-prefiller-host-port header"| Sidecar
    Sidecar -.->|"optional CRD watch"| InferencePool["Gateway API Inference Extension<br/>InferencePool v1alpha2"]
    KServe["KServe LLMInferenceService"] -->|"pod template injection"| Sidecar
    Gateway["Istio Gateway DestinationRule"] -->|"TLS origination :8000"| Sidecar

    %% Go libraries
    Sidecar -->|"informers, optional"| ClientGo["k8s.io/client-go v0.31.3"]
    Sidecar --> Apimachinery["k8s.io/apimachinery v0.31.3"]
    Sidecar -->|logging| Klog["klog/v2 v2.130.1 + logr v1.4.2"]
    Sidecar -->|"prefiller proxy cache"| LRU["golang-lru/v2 v2.0.7"]
    Sidecar -->|"x-request-id UUIDv1"| UUID["google/uuid v1.6.0"]
    Sidecar --> KUtils["k8s.io/utils"]

    %% External services / build
    Sidecar -->|"SSRF allowlist"| K8sAPI["Kubernetes API"]
    Sidecar -->|"runtime base"| UBI["ubi9/ubi-micro:latest"]
    Sidecar -->|build| GoToolchain["Go 1.24.2"]

    %% Successor
    Sidecar -.->|"deprecated, moved to"| Successor["llm-d-inference-scheduler<br/>cmd/pd_sidecar"]

