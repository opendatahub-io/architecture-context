graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Browser"]
    end

    subgraph Ingress["INGRESS - Gateway namespace: openshift-ingress"]
        GW["Gateway Envoy<br/>maas-default-gateway / tenant Gateway<br/>443/TCP HTTPS, TLS terminated<br/>Kuadrant wasm auth"]
        PreProc["payload-pre-processing[-tenant]<br/>gRPC 9004/TCP TLS service-ca<br/>NetworkPolicy: gateway pods only"]
        PostProc["payload-processing[-tenant]<br/>gRPC 9004/TCP TLS service-ca<br/>SA: payload-processing"]
    end

    subgraph Policy["POLICY SERVICES"]
        Authorino["Kuadrant Authorino / Limitador<br/>ns: kuadrant-system"]
    end

    subgraph TenantNS["TENANT NAMESPACE"]
        EMProc["payload-processing-external-model<br/>gRPC 9004/TCP TLS (SAN verified)<br/>mounts agc-cred-&lt;hash12&gt;"]
        ProvSvc["provider-&lt;name&gt; ExternalName Svc<br/>+ ServiceEntry 443/TCP"]
    end

    subgraph InfraNS["TENANT INFRA NAMESPACE"]
        AuthProxy["maas-consumer-portal-auth-proxy<br/>HTTPS 4180/TCP TLS 1.2+ service-ca<br/>metrics 9000/TCP HTTP<br/>NetworkPolicy: Gateway + Authorino"]
    end

    subgraph DashNS["DASHBOARD NAMESPACE (redhat-ods-applications)"]
        Portal["maas-portal Service<br/>HTTPS 8443/TCP"]
    end

    subgraph ControlNS["CONTROL PLANE - ns: opendatahub"]
        AGC["ai-gateway-controller<br/>SA: ai-gateway-controller<br/>metrics 8443/TCP HTTPS (TokenReview+SAR)<br/>health 8081/TCP HTTP (no auth)<br/>UID 1001, readOnlyRootFS, drop ALL"]
    end

    subgraph Platform["KUBERNETES CONTROL PLANE"]
        K8s["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph Monitoring["MONITORING"]
        Prom["Prometheus<br/>redhat-ods-monitoring / openshift-monitoring"]
    end

    subgraph TrustyNS["TRUSTYAI"]
        Nemo["NeMo Guardrails<br/>8000/TCP HTTP no auth<br/>8443/TCP HTTPS kube-rbac-proxy"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Provider["External LLM Providers<br/>openai, anthropic, azure, bedrock, vertex<br/>443/TCP HTTPS"]
        OIDC["OIDC Issuer<br/>443/TCP HTTPS"]
    end

    %% Data plane
    Client -->|HTTPS/443<br/>TLS<br/>MaaS API key / token| GW
    GW -->|gRPC/9004<br/>TLS service-ca<br/>fail-closed, no app auth| PreProc
    GW -->|gRPC<br/>platform TLS<br/>MaaS credential| Authorino
    GW -->|gRPC/9004<br/>TLS service-ca| PostProc
    GW -->|gRPC/9004<br/>TLS SAN-verified| EMProc
    PostProc -->|HTTP/8000 none<br/>or HTTPS/8443 SA token| Nemo
    EMProc -->|HTTP/8000 none<br/>or HTTPS/8443 SA token| Nemo
    GW -->|via ProvSvc| ProvSvc
    ProvSvc -->|HTTPS/443<br/>TLS SIMPLE SNI=endpoint<br/>Injected API key / SigV4 / OAuth2| Provider

    %% Portal
    Authorino -->|HTTPS/4180<br/>/oauth2/auth cookie| AuthProxy
    GW -->|HTTPS/4180 re-encrypt<br/>anonymous /oauth2/*| AuthProxy
    AuthProxy -->|HTTPS/443<br/>system + odh-trusted-ca-bundle<br/>OIDC client creds| OIDC
    GW -->|HTTPS/8443 TLS SIMPLE<br/>ReferenceGrant<br/>injected identity headers| Portal

    %% Control plane
    AGC -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token, cluster-wide ClusterRole| K8s
    K8s -.->|configures EnvoyFilters,<br/>DRs, Deployments, Secrets| GW
    Prom -->|HTTPS/8443<br/>TLS service-ca<br/>Bearer SA token| AGC
    AGC -.->|pods/log read<br/>serving revision| EMProc

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class GW,PreProc,PostProc ingress
    class EMProc,ProvSvc,AuthProxy,Portal,Authorino,Nemo,Prom internal
    class AGC,K8s control
    class Provider,OIDC externalservice
