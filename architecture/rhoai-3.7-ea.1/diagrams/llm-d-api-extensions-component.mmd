graph TB
    Operator["Operator / Deployment Tooling<br/>KServe LLMInferenceService (inferred)"]

    subgraph Pod["vLLM Model-Server Pod (host image, not built by this repo)"]
        subgraph APIServer["vLLM OpenAI-compatible API Server (8000/TCP)"]
            PluginLoader["vLLM endpoint-plugin loader<br/>entry points: vllm.endpoint_plugins"]
            ConfigPlugin["ServerConfigPlugin<br/>GET /plugins/llm-d-server-introspection/config<br/>required_tasks = None (also on render server)"]
            DevicesPlugin["ServerDevicesPlugin<br/>GET /plugins/llm-d-server-introspection/devices<br/>required_tasks = ENGINE_TASKS"]
            KVPlugin["ServerKVCachePlugin<br/>GET /plugins/llm-d-server-introspection/kv-cache<br/>required_tasks = ENGINE_TASKS"]
            Common["common.py<br/>read_attr / build_tolerant / guarded_init_state<br/>cached response or 503"]
            Schemas["schemas.py<br/>Pydantic v2 nullable models<br/>10 KV-cache group kinds + UnknownGroupSpec"]
            AppState[("app.state<br/>cached server_*_response")]
        end

        subgraph Workers["vLLM Engine Worker Processes (per GPU rank)"]
            WorkerExt["DeviceInfoWorkerExtension<br/>--worker-extension-cls mixin<br/>get_device_properties()"]
            Platform["vllm.platforms.current_platform"]
        end

        VllmConfig["VllmConfig + CLI args<br/>cache_config / model_config / kv_transfer_config"]
        EngineClient["vLLM EngineClient"]
    end

    Operator -->|"sets VLLM_PLUGINS +<br/>--worker-extension-cls"| PluginLoader
    PluginLoader -->|"attach_router / init_state"| ConfigPlugin
    PluginLoader -->|"attach_router / init_state"| DevicesPlugin
    PluginLoader -->|"attach_router / init_state"| KVPlugin

    ConfigPlugin -->|reads| VllmConfig
    KVPlugin -->|reads| VllmConfig
    DevicesPlugin -->|"collective_rpc('get_device_properties')"| EngineClient
    KVPlugin -.->|"get_kv_cache_group_metadata()<br/>optional, vllm#48121 (unreleased)"| EngineClient
    EngineClient -->|vLLM internal IPC| WorkerExt
    WorkerExt -->|reads| Platform

    ConfigPlugin --> Common
    DevicesPlugin --> Common
    KVPlugin --> Common
    Common --> Schemas
    Common -->|"caches once at startup"| AppState

    LLMD["llm-d scheduler / router"] -->|"HTTP GET 8000/TCP<br/>auth inherited from vLLM"| APIServer

