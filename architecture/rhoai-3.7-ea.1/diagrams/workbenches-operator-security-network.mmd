graph TB
    subgraph Users["USERS (Authenticated via kube-apiserver)"]
        User["User / ODH Dashboard<br/>Bearer token"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        KubeAPI["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph Monitoring["MONITORING NAMESPACES<br/>openshift-monitoring, openshift-user-workload-monitoring,<br/>redhat-ods-monitoring, opendatahub-monitoring"]
        Prom["Prometheus"]
    end

    subgraph OperatorNS["Namespace: workbenches-operator-system / applications NS<br/>NetworkPolicy controller-manager-allow-ports"]
        WHSvc["Service workbenches-operator-webhook-service<br/>ClusterIP 443/TCP → 9443"]
        Pod["workbenches-operator pod<br/>SA: workbenches-operator-controller-manager<br/>replicas: 1, UID 65532, RO rootfs<br/>9443 webhook TLS / 8443 metrics TLS / 8081 probes HTTP"]
        CertSecret["Secret workbenches-operator-controller-webhook-cert<br/>kubernetes.io/tls"]
    end

    subgraph CertProviders["CERT PROVIDERS"]
        ServiceCA["OpenShift service-CA<br/>(preferred)"]
        CertManager["cert-manager<br/>self-signed ClusterIssuer<br/>(fallback)"]
    end

    subgraph UserNS["USER NAMESPACES (tenants)"]
        Notebook["Notebook CRs"]
        ConnSecrets["Connection Secrets"]
    end

    Kubelet["Kubelet"]

    User -->|HTTPS/6443<br/>TLS 1.2+<br/>User Bearer token| KubeAPI
    KubeAPI -->|HTTPS/443 → 9443<br/>TLS APIServer profile<br/>Server cert via injected CA bundle<br/>failurePolicy Fail, 5s timeout| WHSvc
    WHSvc --> Pod
    Prom -->|HTTPS/8443 /metrics<br/>TLS APIServer profile<br/>Bearer: TokenReview + SAR| Pod
    Kubelet -->|HTTP/8081 /healthz /readyz<br/>plaintext, no auth| Pod
    Pod -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SSA, watches, SAR, TLS profile| KubeAPI
    ServiceCA -.->|issues cert| CertSecret
    CertManager -.->|issues cert| CertSecret
    CertSecret -.->|mounted /tmp/k8s-webhook-server/serving-certs| Pod
    KubeAPI -.->|stores| Notebook
    KubeAPI -.->|stores| ConnSecrets

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef certs fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef tenant fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class User,Kubelet external
    class KubeAPI control
    class WHSvc,Pod,CertSecret operator
    class ServiceCA,CertManager certs
    class Prom external
    class Notebook,ConnSecrets tenant
