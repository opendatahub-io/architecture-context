    subgraph Bindings["Bindings (example)"]
        RB["RoleBinding<br/>swebench-eval"]
        CRB["ClusterRoleBinding<br/>swebench-eval-anyuid-NAMESPACE"]
    end

    subgraph Roles["Roles (example)"]
        Role["Role<br/>swebench-eval"]
        SCC["ClusterRole<br/>system:openshift:scc:anyuid"]
    end

    subgraph Resources["API Resources"]
        Jobs["batch<br/>jobs"]
        Pods["core<br/>pods, pods/log"]
        AnyUID["security.openshift.io<br/>SCC anyuid"]
    end

    Note ~~~ SA
    SA -->|bound via| RB
    SA -->|bound via| CRB
    RB -->|grants| Role
    CRB -->|grants| SCC
    Role -->|create, get, list, delete| Jobs
    Role -->|get, list| Pods
    SCC -->|use| AnyUID

