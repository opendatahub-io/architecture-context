    Note["Productized adapters define NO RBAC and do not call the Kubernetes API.<br/>Job ServiceAccount and permissions are owned by eval-hub.<br/>Below: SWE-bench EXAMPLE only (adapters/swebench/rbac.yaml, applied by hand per namespace)"]

    subgraph SAGroup["Service Account (shared by all adapter Jobs in namespace)"]
        SA["evalhub-evalhub-opendatahub-job"]
