graph TB
    subgraph Praxis["Praxis (praxis-praxis) - Rust proxy framework + binary v0.8.0"]
        direction TB
        Server["praxis-proxy (crates/server)<br/>praxis binary: config load,<br/>pipeline build, hot reload,<br/>--validate / --dump"]
        Core["praxis-proxy-core<br/>Config + validation, KV store registry,<br/>sub-request client, ServerRuntime contract"]
        Filter["praxis-proxy-filter<br/>HttpFilter/TcpFilter traits,<br/>FilterPipeline, FilterRegistry,<br/>built-in filters"]
        Protocol["praxis-proxy-protocol<br/>HTTP/TCP adapters,<br/>admin/health/metrics handlers,<br/>active health checks"]
        TLS["praxis-proxy-tls<br/>ListenerTls/ClusterTls, OpenSSL rustls provider,<br/>SNI, mTLS/SPIFFE, cert hot reload"]

        subgraph Pipeline["Per-listener filter pipeline (chains concatenated)"]
            direction LR
            Auth["Auth filters<br/>Policy JWT/API key/DPoP,<br/>mTLS, IP ACL"]
            Mutate["Header/path rewrite,<br/>CORS/CSRF, rate limit,<br/>guardrails, credential injection"]
            Router["router + load balancer"]
            Obs["access log + tracing"]
            Auth --> Mutate --> Router --> Obs
        end

        Server --> Core
        Server --> Filter
        Server --> Protocol
        Server --> TLS
        Filter --> Pipeline
        Protocol -->|invokes| Pipeline
    end

    Config["YAML config<br/>/etc/praxis/config.yaml<br/>listeners, filter_chains, clusters"] -->|loaded + watched| Server
    Certs["Mounted PEM certs/keys"] -->|hot reload| TLS

    subgraph Backends["Network backend - one per build (cargo feature)"]
        Pingora["Pingora fork<br/>quixotic-plecostomus-* 0.11.4<br/>default"]
        Hyper["hyper 1.12<br/>experimental"]
    end
    Protocol -->|adapts| Pingora
    Protocol -.->|alt build| Hyper

    OpenSSL["System OpenSSL libcrypto.so.3<br/>FIPS provider on UBI 9"]
    TLS -->|rustls-openssl provider| OpenSSL
    PPE["praxis-policy PPE 0.6.0<br/>feature policy-*"]
    Filter -.->|optional| PPE

    Client[Clients] -->|"8080/TCP HTTP/1.1, HTTP/2, gRPC, WS, TCP"| Protocol
    Router -->|forwards| Upstream["Upstream clusters"]
    PraxisAI["praxis-proxy/ai<br/>praxis-ai binary"] -.->|depends on crates| Core

