    %% RHOAI 3.7-ea.1 - Monitoring and Observability Map
    %% PLATFORM.md has no Monitoring and Observability section in this generation.
    %% Endpoints below come from the component architecture documents in architecture/rhoai-3.7-ea.1/.

    subgraph Stack["odh-observability - redhat-ods-monitoring"]
        direction TB
        Prom["MonitoringStack Prometheus<br/>prometheus-operated 9090"]
        PromProxy["kube-rbac-proxy to prom-label-proxy<br/>reencrypt Routes, SAR + label enforcement"]
        Thanos["ThanosQuerier"]
        Alert["Alertmanager + PrometheusRules"]
        OTelC["OTel data-science-collector<br/>OTLP 4317 gRPC, TLS service-ca"]
        OTelU["OTel data-science-usage-logs<br/>OTLP 4317 / 4318, TLS"]
        Tempo["TempoMonolithic / TempoStack"]
        Loki["LokiStack + ClusterLogForwarder"]
        Perses["Perses dashboards"]
        ObsOp["odh-observability operator<br/>PodMonitor mutating webhook<br/>AdmissionProbe canary every 5 min"]
    end

    subgraph Secure["Scrape Targets - HTTPS, TokenReview + SAR"]
        direction TB
        M1["rhods-operator<br/>:8443 /metrics"]
        M2["kserve controllers<br/>:8443 kube-rbac-proxy"]
        M3["odh-model-controller<br/>:8443 manager"]
        M4["data-science-pipelines-operator<br/>:8443, KFP API :8445"]
        M5["maas-controller :8443<br/>maas-api :9090"]
        M6["mlflow-operator, model-registry-operator,<br/>workbenches-operator, trainer-operator,<br/>ray-module-operator :8443"]
        M7["kueue-operator<br/>:8443 cert-manager cert"]
        M8["kuberay<br/>Service :8443"]
        M9["ai-gateway-operator, ai-gateway-controller,<br/>llm-d-batch-gateway-operator :8443"]
        M10["trustyai-service-operator, mcp-lifecycle-operator,<br/>ogx root operator, rhai-db-operator,<br/>feast-module, data-connect-hub controller :8443"]
        M11["llm-d EPP<br/>:9090 TokenReview + SAR default"]
        M12["praxis-extproc<br/>:9090 HTTP, TokenReview + SAR"]
        M13["odh-observability operator<br/>:8443"]
    end

    subgraph Open["Scrape Targets - No Auth"]
        direction TB
        N1["rhods-operator cloudmanager<br/>plain HTTP"]
        N2["ogx-module<br/>:8443 HTTPS, no filter"]
        N3["spark-operator<br/>:8080 HTTPS, no filter"]
        N4["trustyai module controller<br/>:8080 HTTP"]
        N5["praxis-ai-grid-operator<br/>:9090"]
        N6["odh-model-controller model-serving-api<br/>:8080 HTTPS"]
        N7["kserve qpext<br/>:9088 HTTP"]
        N8["batch-gateway<br/>:8081 / :9090 / :9091 HTTP"]
        N9["llm-d coordinator :9090<br/>data-connect-hub REST/Flight :9090"]
        N10["kube-auth-proxy<br/>metrics address unset by default"]
    end

    subgraph Probes["Health Probes"]
        direction TB
        H1["Go operators - L /healthz, R /readyz :8081<br/>rhods-operator, kserve, odh-model-controller,<br/>DSPO, mlflow-operator, model-registry-operator,<br/>kueue, trainer, workbenches, ray-module,<br/>ai-gateway-*, batch-gateway-operator,<br/>trustyai, mcp-lifecycle, ogx, feast-module,<br/>rhai-db, spark-operator, observability"]
        H2["kuberay<br/>L/R :8082"]
        H3["kube-auth-proxy<br/>R /ready :4180"]
        H4["maas-api<br/>/health, /health/database :8443"]
        H5["praxis-extproc<br/>/healthz :9090"]
        H6["praxis-ai-grid-operator<br/>L/R :9090, enrollment :8443"]
        H7["model-serving-api<br/>L/R :8443 HTTPS"]
        H8["Model Registry REST<br/>/readyz/isDirty, /readyz/health :8080<br/>proxy healthz :8888"]
        H9["batch-gateway<br/>/health, /ready :8081 / :9090 / :9091"]
    end

    subgraph Tracing["Distributed Tracing - OTLP"]
        direction TB
        T1["llm-d-router EPP<br/>--tracing true default, OTLP 4317"]
        T2["llm-d-async<br/>OTLP gRPC 4317, insecure default"]
        T3["batch-gateway<br/>OTLP gRPC 4317, insecure default"]
        T4["fms-guardrails-orchestrator<br/>OTLP traces + metrics 4317 / 4318"]
        T5["praxis-ai<br/>OTLP configurable, metrics 9901"]
        T6["MaaS gateway access logger<br/>usage logs"]
        T7["MLflow tracking server<br/>OTLP ingest /v1/traces"]
    end

    Prom -->|ServiceMonitor / PodMonitor<br/>Bearer| Secure
    Prom -.->|scrape, no auth| Open
    Prom --> Thanos
    Prom --> Alert
    Thanos --> Perses
    PromProxy --> Prom

    T1 -->|OTLP gRPC| OTelC
    T2 -->|OTLP gRPC| OTelC
    T3 -->|OTLP gRPC| OTelC
    T4 -->|OTLP| OTelC
    T5 -->|OTLP| OTelC
    T6 -->|OTLP 4317/4318| OTelU
    OTelC -->|otlp/tempo, SA token| Tempo
    OTelC -.->|collector trace export| T7
    OTelU -->|otlphttp/loki| Loki
    ObsOp -->|reconciles| Stack

