graph TB
    subgraph Users["USERS (Authenticated via kube-apiserver)"]
        Admin["Cluster Admin / OLM"]
        DS["Data Scientist<br/>creates jobs in opt-in namespace"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+<br/>ns: openshift-kube-apiserver"]
    end

    subgraph NS_Op["Namespace: openshift-kueue-operator (default-deny NetworkPolicy)"]
        Operator["openshift-kueue-operator<br/>SA: openshift-kueue-operator<br/>2 replicas, metrics 60000/TCP<br/>ClusterRole: bind+escalate RBAC"]
        WebhookSvc["kueue-webhook-service<br/>ClusterIP 443→9443/TCP<br/>TLS cert-manager self-signed"]
        MetricsSvc["kueue-controller-manager-metrics-service<br/>ClusterIP 8443/TCP<br/>TLS metrics-server-cert"]
        VisSvc["kueue-visibility-server<br/>ClusterIP 443→8082/TCP<br/>DISABLED - no listener"]
        Operand["kueue-controller-manager<br/>SA: kueue-controller-manager<br/>2 replicas, readOnlyRootFilesystem<br/>health 8081/TCP HTTP plaintext"]
    end

    subgraph NS_CM["Namespace: cert-manager"]
        CertManager["cert-manager<br/>Issuer selfsigned<br/>Certificates webhook-cert, metrics-certs"]
    end

    subgraph NS_Mon["Namespace: openshift-monitoring"]
        Prom["prometheus-k8s<br/>ServiceMonitor"]
    end

    subgraph NS_DNS["Namespace: openshift-dns"]
        DNS["Cluster DNS<br/>53/TCP+UDP"]
    end

    subgraph External["EXTERNAL (optional)"]
        Remote["MultiKueue remote clusters<br/>6443/TCP HTTPS<br/>kubeconfig Secret"]
    end

    Admin -->|HTTPS/6443<br/>TLS 1.2+<br/>User token| API
    DS -->|HTTPS/6443<br/>TLS 1.2+<br/>User token| API
    Operator -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    Operand -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    CertManager -->|HTTPS/6443<br/>TLS Secrets + CA injection<br/>SA token| API
    API -->|HTTPS/443→9443<br/>TLS injected CA<br/>Admission, failurePolicy Fail<br/>NetPol: kube-apiserver only| WebhookSvc
    WebhookSvc --> Operand
    Prom -->|HTTPS/8443<br/>TLS verified, serverName pinned<br/>Bearer token + client cert| MetricsSvc
    MetricsSvc --> Operand
    VisSvc -.->|no backend| Operand
    Operator -->|DNS/53| DNS
    Operand -->|DNS/53| DNS
    Operand -.->|HTTPS/6443<br/>kubeconfig creds<br/>only if MultiKueue| Remote

    classDef user fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef disabled fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Admin,DS user
    class API control
    class Operator,WebhookSvc,MetricsSvc,Operand,CertManager,Prom,DNS internal
    class VisSvc disabled
    class Remote external
