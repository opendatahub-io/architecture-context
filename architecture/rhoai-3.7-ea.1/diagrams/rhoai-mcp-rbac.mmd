graph TD
    subgraph SAs["Service Account"]
        SA["rhoai-mcp<br/>ns: rhoai-mcp / opendatahub / redhat-ods-applications"]
    end

    subgraph Bindings["ClusterRole Binding"]
        CRB["rhoai-mcp<br/>ClusterRoleBinding"]
    end

    subgraph Roles["ClusterRole variants - chosen by overlay"]
        CRBase["rhoai-mcp - SA-as-actor<br/>base + openshift / odh / rhoai"]
        CROIDC["rhoai-mcp - OIDC<br/>openshift-oidc replaces all rules"]
    end

    subgraph CoreRes["Core API"]
        RRead["pods, pods/log, services,<br/>events, nodes"]
        RPods["pods"]
        RPV["persistentvolumes"]
        RNS["namespaces"]
        RSec["secrets, persistentvolumeclaims"]
    end

    subgraph CRDRes["Platform CRDs"]
        RNB["kubeflow.org<br/>notebooks"]
        RTJ["trainer.kubeflow.org<br/>trainjobs"]
        RTR["trainer.kubeflow.org<br/>trainingruntimes"]
        RCTR["trainer.kubeflow.org<br/>clustertrainingruntimes"]
        RDSPA["datasciencepipelinesapplications.opendatahub.io<br/>datasciencepipelinesapplications"]
        RISVC["serving.kserve.io<br/>inferenceservices"]
        RSR["serving.kserve.io<br/>servingruntimes"]
        RSC["storage.k8s.io<br/>storageclasses"]
    end

    subgraph OCPRes["OpenShift overlay additions"]
        RDSC["datasciencecluster.opendatahub.io<br/>datascienceclusters"]
        RMR["components.platform.opendatahub.io<br/>modelregistries"]
        RTpl["template.openshift.io<br/>templates"]
        RRoute["route.openshift.io<br/>routes"]
        RProj["project.openshift.io<br/>projects"]
        RIS["image.openshift.io<br/>imagestreams"]
    end

    subgraph OIDCRes["OIDC-mode resources"]
        RTokRev["authentication.k8s.io<br/>tokenreviews"]
        RSAR["authorization.k8s.io<br/>subjectaccessreviews"]
        RUsers["user.openshift.io<br/>users"]
    end

