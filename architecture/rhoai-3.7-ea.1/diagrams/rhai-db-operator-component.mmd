graph TB
    %% rhai-db-operator (downstream of opendatahub-db-operator) - component structure
    RHODS["rhods-operator<br/>DataScienceCluster databaseservice component"]
    Admin[Cluster Administrator]
    Consumer["Consuming component / user<br/>e.g. model registry, feature store"]

    subgraph OpNS["Namespace: odh-db-operator-system"]
        subgraph Manager["odh-db-operator-operator Deployment<br/>/manager operator"]
            DSRec["DatabaseService reconciler<br/>installs infra CRDs, manages rhai-db default provider"]
            DPRec["DatabaseProvider reconciler<br/>Internal render / External validate"]
            DCRec["DatabaseClaim reconciler<br/>database-scoped role, optional dedicated DB"]
            SCRec["SchemaClaim reconciler<br/>dedicated schema + login role"]
            PGLib["pkg/postgres<br/>pgx client, TLS, safe DDL, crypto/rand passwords, log redaction"]
            Endpoints["Endpoints<br/>:8081 healthz/readyz<br/>:8443 HTTPS metrics<br/>:9443 webhook (no handlers)"]
        end

        subgraph Internal["Internal provider backend (e.g. rhai-db)"]
            STS["PostgreSQL StatefulSet<br/>rhel9/postgresql-16, 1 replica, UID 26"]
            PGSvc["Headless Service<br/>5432/TCP"]
            PVC["PVC (RWO)<br/>retained on provider removal"]
            NP["Generated NetworkPolicy<br/>operator pod + bound-claim namespaces"]
            Cert["cert-manager Issuer + Certificate<br/>server TLS Secret"]
            AdminSec["Internal admin Secret<br/>postgres superuser password"]
        end
    end

    subgraph CRDs["CRDs"]
        DS["DatabaseService<br/>services.platform.opendatahub.io/v1alpha1<br/>Cluster, singleton default-db-operator"]
        DP["DatabaseProvider<br/>infrastructure.opendatahub.io/v1alpha1<br/>Cluster"]
        DC["DatabaseClaim<br/>infrastructure.opendatahub.io/v1alpha1<br/>Namespaced"]
        SC["SchemaClaim<br/>infrastructure.opendatahub.io/v1alpha1<br/>Namespaced"]
    end

    subgraph ClaimNS["Namespace: claim namespace"]
        ConnSec["Connection Secret (Opaque)<br/>connection-type-protocol: postgres<br/>host, port, user, password, dbname, sslmode, schema?, ca.crt?"]
        Workload[Consuming workload]
    end

    ExtPG["External PostgreSQL<br/>administrator-managed"]
    ExtSec["External admin Secret<br/>connectionSecretRef"]

    RHODS -->|creates| DS
    DS -->|watched by| DSRec
    DSRec -->|applies CRDs + creates rhai-db| DP
    Admin -->|creates External/Internal| DP
    Admin -->|provides| ExtSec
    Consumer -->|creates| DC
    Consumer -->|creates| SC

    DP -->|watched by| DPRec
    DC -->|watched by| DCRec
    SC -->|watched by| SCRec

    DPRec -->|renders| STS
    DPRec -->|renders| PGSvc
    DPRec -->|renders| PVC
    DPRec -->|renders| NP
    DPRec -->|renders| Cert
    DPRec -->|generates| AdminSec
    DPRec -->|reads| ExtSec

    DCRec --> PGLib
    SCRec --> PGLib
    DPRec --> PGLib
    PGLib -->|DDL, roles, grants 5432/TCP TLS| PGSvc
    PGLib -->|validate + provision| ExtPG
    PGSvc --> STS
    STS --> PVC

    DCRec -->|writes| ConnSec
    SCRec -->|writes| ConnSec
    Workload -->|mounts| ConnSec
    Workload -->|connects 5432/TCP| PGSvc
    Workload -.->|or| ExtPG

