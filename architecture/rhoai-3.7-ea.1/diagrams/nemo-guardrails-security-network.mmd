graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client App / Llama Stack"]
    end

    subgraph Ingress["INGRESS (operator-owned, not in this repo)"]
        Route["Route / Gateway / Auth Proxy<br/>443/TCP HTTPS<br/>TLS terminated by platform<br/>Auth: platform-defined"]
    end

    subgraph Cluster["CLUSTER INTERNAL (per-namespace instance)"]
        direction TB
        subgraph NS["Namespace: user / TrustyAI-managed"]
            Svc["Service (ClusterIP, expected)<br/>8000/TCP to 8000 HTTP<br/>No TLS, no in-app auth"]
            Pod["Guardrails Server Pod<br/>uvicorn 0.0.0.0:8000<br/>UID 1001 non-root<br/>No K8s API access, no RBAC"]
            Config["Rails config volume<br/>/app/config/CONFIG_ID<br/>executable config.py / actions.py<br/>TRUST BOUNDARY"]
            Secrets["Env secrets<br/>OPENAI_API_KEY, AZURE_OPENAI_API_KEY,<br/>F5_GUARDRAILS_API_KEY, POLYGRAF_API_KEY"]
        end
        LLM["Main LLM: KServe / vLLM<br/>MAIN_MODEL_BASE_URL<br/>HTTP/HTTPS configurable"]
        OTel["OTLP Collector<br/>4317/4318 gRPC/HTTP<br/>no auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (optional)"]
        OpenAI["OpenAI / Azure OpenAI<br/>443/TCP HTTPS TLS<br/>API key env"]
        SaaS["Retained guardrail SaaS<br/>f5, polygraf, guardrails_ai<br/>443/TCP HTTPS, API key env"]
        HFC["HF classifier endpoints<br/>HTTPS, verify_ssl configurable<br/>optional mTLS client cert"]
        NVTel["NVIDIA telemetry<br/>events.telemetry.data.nvidia.com<br/>DISABLED: DO_NOT_TRACK=1"]
    end

    Client -->|HTTPS/443<br/>TLS platform<br/>platform auth + X-Authorization| Route
    Route -->|HTTP/8000<br/>plaintext<br/>no in-app auth| Svc
    Svc --> Pod
    Config -->|mounted, loaded per request| Pod
    Secrets -->|env vars| Pod
    Pod -->|HTTP/HTTPS configurable<br/>TLS if https<br/>Bearer env key or X-Authorization| LLM
    Pod -->|GET /models<br/>Bearer env key ELSE inbound Authorization| LLM
    Pod -.->|gRPC/HTTP OTLP<br/>no auth| OTel
    Pod -.->|HTTPS/443 TLS<br/>API key| OpenAI
    Pod -.->|HTTPS/443 TLS<br/>API key| SaaS
    Pod -.->|HTTPS<br/>TLS / mTLS| HFC
    Pod -.-x|blocked by DO_NOT_TRACK| NVTel

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef disabled fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5

    class Client external
    class Route ingress
    class Svc,Pod,LLM,OTel internal
    class Config,Secrets risk
    class OpenAI,SaaS,HFC externalservice
    class NVTel disabled
