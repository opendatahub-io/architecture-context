graph TD
    subgraph K8s["Kubernetes RBAC"]
        NoRBAC["None shipped<br/>Gateway does not call the Kubernetes API<br/>No ServiceAccount, Role or Binding in repo"]
    end

    subgraph App["Effective application-level access"]
        Caller["Any caller that can reach 8090/TCP"]
        RoutePII["POST /pii/v1/chat/completions<br/>regex-language output detector<br/>email, ssn"]
        RoutePass["POST /passthrough/v1/chat/completions<br/>no detectors"]
        RouteAny["POST /{route}/v1/chat/completions<br/>route-pinned detectors"]
    end

    subgraph Enforce["Enforcement delegated"]
        Proxy["Fronting auth proxy<br/>(deployer-provided)"]
        Orch["FMS Guardrails Orchestrator<br/>receives forwarded Authorization<br/>+ optional mTLS client cert"]
    end

    Caller -->|no in-process auth| RoutePII
    Caller -->|no in-process auth| RoutePass
    Caller -->|no in-process auth| RouteAny
    Proxy -.->|should gate| Caller
    RoutePII -->|bearer pass-through| Orch
    RoutePass -->|bearer pass-through| Orch
    RouteAny -->|bearer pass-through| Orch

    style NoRBAC fill:#e8e8e8
    style Caller fill:#f8cecc
    style RoutePII fill:#4a90e2
    style RoutePass fill:#4a90e2
    style RouteAny fill:#4a90e2
    style Proxy fill:#f5a623
    style Orch fill:#7ed321
