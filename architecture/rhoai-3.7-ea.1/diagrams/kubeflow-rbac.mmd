graph TD
    subgraph SAs["Service Accounts"]
        KFSA["notebook-controller-service-account"]
        ODHSA["odh-notebook-controller-manager"]
        NBSA["&lt;nb&gt; (per-notebook SA, user ns)"]
    end

    subgraph Bindings["Bindings"]
        KFCRB["notebook-controller-role-binding"]
        KFAux["metrics-auth-binding /<br/>openshift-config-reader-binding"]
        ODHCRB["odh-notebook-controller-manager-rolebinding"]
        ODHAux["metrics-auth-binding /<br/>openshift-config-reader-binding"]
        ODHLE["leader-election-rolebinding<br/>(controller ns)"]
        NBAD["&lt;nb&gt;-rbac-&lt;ns&gt;-auth-delegator<br/>(ClusterRoleBinding, runtime)"]
        NBElyra["elyra-pipelines-&lt;nb&gt;<br/>(RoleBinding, user ns)"]
        NBML["&lt;nb&gt;-mlflow<br/>(RoleBinding, user ns)"]
    end

    subgraph Roles["Roles"]
        KFRole["ClusterRole<br/>notebook-controller-role"]
        KFAuxR["ClusterRoles<br/>metrics-auth, openshift-config-reader"]
        ODHRole["ClusterRole<br/>odh-notebook-controller-manager-role"]
        ODHAuxR["ClusterRoles<br/>metrics-auth, openshift-config-reader"]
        LERole["Role<br/>leader-election-role"]
        AuthDel["ClusterRole<br/>system:auth-delegator"]
        DSPRole["Role<br/>ds-pipeline-user-access-dspa"]
        MLRole["ClusterRole<br/>mlflow-operator-mlflow-integration"]
    end

    subgraph KFRes["notebook-controller resources"]
        KFNB["kubeflow.org<br/>notebooks, /finalizers, /status"]
        KFSTS["apps statefulsets<br/>core services"]
        KFPods["core pods, events"]
        KFIstio["networking.istio.io<br/>virtualservices (unused on RHOAI)"]
    end

    subgraph ODHRes["odh-notebook-controller resources"]
        ODHCore["core configmaps, secrets,<br/>serviceaccounts, services"]
        ODHGW["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/>(gateways: read)"]
        ODHNP["networking.k8s.io<br/>networkpolicies"]
        ODHRBAC["rbac.authorization.k8s.io<br/>clusterrolebindings, rolebindings, roles"]
        ODHBind["clusterroles<br/>mlflow-operator-mlflow-integration"]
        ODHRead["imagestreams, routes,<br/>namespaces, DSPA"]
        ODHDSPAAPI["DSPA /api"]
        ODHOAuth["oauth.openshift.io<br/>oauthclients"]
        ODHNB["kubeflow.org notebooks"]
        TRSAR["tokenreviews,<br/>subjectaccessreviews"]
        OSCfg["config.openshift.io<br/>apiservers, proxies"]
    end

    KFSA --> KFCRB --> KFRole
    KFSA --> KFAux --> KFAuxR
    ODHSA --> ODHCRB --> ODHRole
    ODHSA --> ODHAux --> ODHAuxR
    ODHSA --> ODHLE --> LERole
    NBSA --> NBAD --> AuthDel
    NBSA --> NBElyra --> DSPRole
    NBSA --> NBML --> MLRole

    KFRole -->|"*"| KFNB
    KFRole -->|"*"| KFSTS
    KFRole -->|"get,list,watch,delete / create,patch"| KFPods
    KFRole -->|"*"| KFIstio
    KFAuxR -->|create| TRSAR
    KFAuxR -->|"get,list,watch"| OSCfg

    ODHRole -->|"create,get,list,patch,update,watch"| ODHCore
    ODHRole -->|"create,delete,get,list,patch,update,watch"| ODHGW
    ODHRole -->|"create,delete,get,list,patch,update,watch"| ODHNP
    ODHRole -->|"create,delete,get,list,patch,update,watch"| ODHRBAC
    ODHRole -->|bind| ODHBind
    ODHRole -->|"get,list,watch"| ODHRead
    ODHRole -->|"create,delete,get,patch,update"| ODHDSPAAPI
    ODHRole -->|"delete,get,list,patch,update,watch"| ODHOAuth
    ODHRole -->|"get,list,patch,update,watch"| ODHNB
    ODHRole -->|create| TRSAR
    ODHAuxR -->|"get,list,watch"| OSCfg
    AuthDel -->|create| TRSAR

