graph TD
    %% RHOAI 3.7-ea.1 - Platform Security Overview

    subgraph AuthN["Authentication Mechanisms"]
        A1["Gateway ext_authz to kube-auth-proxy<br/>OpenShift OAuth user:full or OIDC<br/>data-science-gateway, fail closed"]
        A2["Kuadrant AuthPolicy to Authorino<br/>TokenReview + SAR / OPA<br/>openshift-ai-inference, maas-default-gateway"]
        A3["MaaS API keys sk-oai-*<br/>validated by maas-api"]
        A4["kube-rbac-proxy sidecar<br/>TokenReview + templated SAR<br/>cache 5m allow / 30s deny"]
        A5["controller-runtime secure metrics<br/>WithAuthenticationAndAuthorization"]
        A6["mTLS / SPIFFE-style site identity<br/>praxis-grid, grid operator, openshell"]
        A7["Header-trust identity<br/>X-MaaS-*, x-remote-user,<br/>x-auth-tenant, X-Tenant-Id"]
    end

    subgraph Gateways["Gateway Policies"]
        G1["data-science-gateway<br/>EnvoyFilter data-science-authn-filter<br/>ext_authz + Lua Bearer conversion"]
        G2["openshift-ai-inference<br/>AuthPolicy gateway-authn<br/>SAR get llminferenceservices"]
        G3["maas-default-gateway<br/>AuthPolicy maas-gateway-auth<br/>TRLP + gateway-default-deny"]
    end

    subgraph SAs["Privileged Identities"]
        SA1["rhods-operator<br/>ns redhat-ods-operator<br/>315 RBAC markers"]
        SA2["kserve-module<br/>47 rules"]
        SA3["ray-module / trainer-operator /<br/>ogx-module / ai-gateway-operator"]
        SA4["data-connect-hub<br/>ClusterRole/Binding create, delete"]
    end

    subgraph Roles["Privilege Patterns"]
        R1["RBAC-escalation mirroring<br/>module SA holds every verb it grants<br/>cluster-admin-adjacent"]
        R2["Cluster-wide Secret access<br/>llm-d-batch-gateway-operator, mcp-lifecycle,<br/>rhai-db, ogx, payload-processing"]
    end

    subgraph Secrets["Critical Secrets"]
        S1["kube-auth-proxy-tls<br/>kubernetes.io/tls, service-ca"]
        S2["kube-auth-proxy cookie secret<br/>AES-CFB + HMAC sessions"]
        S3["agc-cred-hash12<br/>external provider API keys"]
        S4["MaaS API key store<br/>maas-api"]
        S5["AI Grid mesh key<br/>AES-256-GCM shared"]
        S6["AI Grid root CA<br/>cert-manager, rotationPolicy Never"]
    end

    subgraph TLS["TLS Configuration"]
        T1["Cluster TLS-profile propagation<br/>APIServer TLSSecurityProfile,<br/>restart on change"]
        T2["Webhooks 9443/TCP<br/>service-ca or cert-manager"]
        T3["Metrics 8443/TCP<br/>service-ca, TokenReview + SAR"]
        T4["Gateway to backend<br/>DR SIMPLE insecureSkipVerify<br/>data-science-tls-rule host *"]
        T5["Authorino 50051/TCP<br/>EnvoyFilter CLUSTER patch, service-ca"]
        T6["External providers 443/TCP<br/>DR TLS origination + SNI"]
    end

    subgraph Container["Container Security"]
        C1["FIPS-oriented Go builds<br/>strictfipsruntime, ubi-minimal-pqc"]
        C2["CSV fips-compliant false<br/>Rust components ship non-FIPS crypto"]
        C3["132 digest-pinned operand images<br/>RELATED_IMAGE_*"]
        C4["Non-root, restricted SCC<br/>read-only root FS, drop ALL"]
        C5["Hermetic Konflux builds<br/>4 architectures"]
        C6["ValidatingAdmissionPolicy self-fencing<br/>grid operator, mlflow-operator"]
    end

    subgraph Admission["Admission Control"]
        W1["225 webhook entries, 20 components<br/>all failurePolicy Fail"]
        W2["4 Pod mutators<br/>kserve, odh-model-controller,<br/>spark-operator, kueue"]
    end

    subgraph Weak["Unauthenticated / NetworkPolicy-only"]
        U1["maas-api /internal/v1/*<br/>DSPO 8888/8887"]
        U2["llm-d-planner API, TAS consumer endpoint,<br/>ogx-module metrics, grid-operator 9090"]
        U3["Model servers without sidecar<br/>NeMo without enable-auth"]
    end

