graph TB
    subgraph Tenants["TENANT NAMESPACES (untrusted users)"]
        User["User / Dashboard / SDK<br/>User bearer token"]
        TrainPods["Training pods<br/>label training.kubeflow.org/job-name"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["Kubernetes API server<br/>6443/TCP HTTPS TLS 1.2+"]
        APIServerCfg["APIServer cluster<br/>TLS profile"]
    end

    subgraph Monitoring["MONITORING NAMESPACES"]
        Prom["Prometheus<br/>openshift-monitoring / UWM /<br/>redhat-ods-monitoring<br/>SA prometheus-k8s"]
    end

    subgraph OperatorNS["Namespace: trainer-operator-system (no ingress/route)"]
        TO["trainer-operator-controller-manager<br/>SA: trainer-operator-controller-manager<br/>non-root UID 65532, RO rootfs, caps dropped<br/>FIPS: CGO + strictfipsruntime"]
        TOSvc["Service ...-metrics-service<br/>ClusterIP 8443/TCP HTTPS<br/>cert: trainer-operator-metrics-tls (service-ca)"]
        TOProbe["Probes :8081 HTTP<br/>/healthz /readyz (no auth)"]
        TONP["NetworkPolicy allow-metrics-traffic<br/>8443 from same ns + 3 monitoring ns"]
    end

    subgraph AppNS["Namespace: applications (appNamespace, e.g. redhat-ods-applications)"]
        OP["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>Trainer v2.3.0"]
        OPSvc["Service kubeflow-trainer-controller-manager<br/>8443 metrics / 443 to 9443 webhook / 10443 status<br/>cert: kubeflow-trainer-webhook-cert (internal rotator)"]
        OPNP["NetworkPolicy ingress: 9443 any source,<br/>10443 labeled job pods any ns, 8443 openshift-monitoring<br/>egress: allow-all"]
    end

    %% Operator flows
    TO -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>watch, SSA, GC| API
    API -->|read at startup + watch| APIServerCfg
    Prom -->|HTTPS/8443<br/>TLS service-ca, cluster profile<br/>Bearer token TokenReview + SAR| TOSvc
    TOSvc --> TO
    TO -.-> TOProbe
    TO -.->|SSA apply operand| OP

    %% Operand flows
    User -->|HTTPS/6443<br/>TLS 1.2+<br/>User bearer token<br/>create TrainJob| API
    API -->|HTTPS/443 to 9443<br/>TLS<br/>API server, failurePolicy Fail| OPSvc
    Prom -->|HTTPS/8443<br/>TLS webhook-cert CA<br/>Bearer token trainer-metrics-reader| OPSvc
    TrainPods -->|HTTPS/10443<br/>TLS not-extracted<br/>auth not-extracted| OPSvc
    OPSvc --> OP
    OP -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>create JobSets| API

    classDef tenant fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operand fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef risk fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,stroke-dasharray: 5 5

    class User,TrainPods tenant
    class API,APIServerCfg controlplane
    class Prom monitoring
    class TO,TOSvc,TOProbe,TONP operator
    class OP,OPSvc operand
    class OPNP risk
