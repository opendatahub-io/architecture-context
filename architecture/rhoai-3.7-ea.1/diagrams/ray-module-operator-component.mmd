graph TB
    Platform["Platform Operator<br/>(rhods-operator / opendatahub-operator)"]
    Workbenches["Workbenches<br/>(Notebook ServiceAccounts)"]

    subgraph ModuleOp["ray-module-operator (Deployment: ray-module-operator-controller-manager, 1 replica)"]
        direction TB
        Manager["manager binary<br/>cmd/main.go<br/>metrics 8443/TCP HTTPS, probes 8081/TCP"]
        TLSWatcher["TLS SecurityProfileWatcher<br/>watches config.openshift.io APIServer<br/>restarts manager on profile change"]
        subgraph Pipeline["Ray reconciler: odh-platform-utilities ReconcilerFor action chain"]
            direction TB
            A1["Management state<br/>+ PreApply gate: ApplicationsNamespaceNotProjected"]
            A2["Releases<br/>KubeRay version from image tag / params.env"]
            A3["Manifest init<br/>/opt/manifests/kuberay copied to /tmp/ray-module-manifests"]
            A4["Image params rewrite<br/>RELATED_IMAGE_* written to params.env, overlay namespace set"]
            A5["Kustomize render<br/>force namespace, label part-of=ray"]
            A6["cert-manager prerequisite check<br/>hard-fail if Issuer/Certificate CRDs absent"]
            A7["OpenShift SCC filter<br/>drop SCCs on non-OpenShift"]
            A8["Notebook ClusterRole 'ray'<br/>no ownerRef"]
            A9["SSA deploy<br/>field owner: ray, WithApplyOrder"]
            A10["Deployment status, distribution,<br/>platform release, Degraded, observedGeneration"]
            A11["GC<br/>owned-only when Managed; full sweep on Removed"]
            Fin["Finalizer<br/>platform.opendatahub.io/finalizer<br/>CRDs retained"]
            A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7 --> A8 --> A9 --> A10 --> A11
        end
        Manifests[("Vendored KubeRay manifests<br/>/opt/manifests/kuberay<br/>(rhoai snapshot, baked in image)")]
        Manager --> Pipeline
        Manager --> TLSWatcher
        Manifests -.->|read at reconcile| A3
    end

    RayCR["Ray CR (cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1<br/>singleton: default-ray"]
    ConfigMap["ConfigMap odh-ray-config<br/>(applications namespace)<br/>distribution.name, distribution.version, platformVersion"]

    Platform -->|deploys module operator| ModuleOp
    Platform -->|creates / projects applicationsNamespace| RayCR
    Platform -->|manages| ConfigMap
    Platform -->|injects RELATED_IMAGE_* env| Manager
    RayCR -->|watched by| Pipeline
    ConfigMap -->|watched by name predicate| Pipeline
    A10 -->|updates status: Ready, ProvisioningSucceeded,<br/>DeploymentsAvailable, Degraded, releases, distribution| RayCR

    subgraph Operand["KubeRay operand (applications namespace)"]
        direction TB
        KubeRay["kuberay-operator Deployment<br/>v1.7.1<br/>metrics 8443/TCP HTTPS, webhook 9443/TCP"]
        CRDs["ray.io CRDs<br/>RayCluster, RayJob, RayService, RayCronJob<br/>(never deleted)"]
        Webhooks["Mutating + Validating webhooks<br/>RayCluster CREATE/UPDATE<br/>failurePolicy: Fail"]
        CertRes["cert-manager Issuer selfsigned-issuer<br/>+ Certificate serving-cert"]
        OpRBAC["KubeRay ClusterRoles / Bindings<br/>kuberay-operator, kuberay-tls-profile-role, ..."]
        NetPol["NetworkPolicy<br/>allow-metrics-traffic"]
        SCC["SCC run-as-ray-user<br/>uid 1000"]
        Svcs["Services<br/>kuberay-operator :8443<br/>kuberay-webhook-service :443 to 9443"]
    end

    NotebookRole["ClusterRole 'ray'<br/>RayJob CRUD, secrets create"]

    A9 -->|SSA apply| KubeRay
    A9 -->|SSA apply| CRDs
    A9 -->|SSA apply| Webhooks
    A9 -->|SSA apply| CertRes
    A9 -->|SSA apply| OpRBAC
    A9 -->|SSA apply| NetPol
    A9 -->|SSA apply| SCC
    A9 -->|SSA apply| Svcs
    A8 -->|creates| NotebookRole
    Workbenches -->|bind to Notebook SAs| NotebookRole
    KubeRay -->|reconciles| CRDs

    CertManager["cert-manager"]
    ServiceCA["OpenShift service-ca"]
    CertManager -->|issues kuberay-webhook-server-cert| CertRes
    ServiceCA -->|issues kuberay-operator-metrics-tls| Svcs

