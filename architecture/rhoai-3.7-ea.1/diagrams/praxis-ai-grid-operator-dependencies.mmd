graph LR
    AGN["praxis-ai-grid-operator<br/>(AI Grid Network)"]

    %% External libraries / runtime dependencies
    AGN -->|K8s client + controller| Kube["kube / kube-runtime /<br/>k8s-openapi"]
    AGN -->|async + HTTP servers| Tokio["tokio / axum / hyper"]
    AGN -->|SWIM membership| Foca["foca"]
    AGN -->|TLS + crypto, default build| Rustls["rustls / ring /<br/>aes-gcm / sha2"]
    AGN -.->|optional fips feature| OpenSSL["system OpenSSL<br/>(not used by Konflux builds)"]
    AGN -->|cert generation| Rcgen["rcgen / x509-parser"]
    AGN -->|provider probes| Reqwest["reqwest"]
    AGN -->|MCP tool discovery| Rmcp["rmcp"]
    AGN -->|metrics parsing| Prom["prometheus /<br/>promql-parser"]
    AGN -->|gateway runtime| Praxis["praxis-proxy 0.8 /<br/>Pingora"]
    AGN -.->|enrollment store| Sqlx["sqlx postgres"]
    AGN -->|Go API types| Apimachinery["k8s.io/apimachinery<br/>v0.32.13"]

    %% Internal ODH / RHOAI platform dependencies
    AGN -->|routing overlays<br/>ConfigMap / file| PraxisGW["Praxis AI gateway"]
    AGN -->|queueDepth / kvCachePressure<br/>metrics scrape| LLMD["llm-d EPP /<br/>inference pools"]
    AGN -->|metrics TLS cert| ServiceCA["OpenShift service-ca"]
    AGN -.->|shared Postgres optional| MaaS["Models-as-a-Service"]

    %% Integration points
    RHODS["rhods-operator /<br/>opendatahub-operator"] -->|Kustomize vendoring<br/>params.env| AGN
    Monitoring["OpenShift monitoring<br/>ServiceMonitor"] -->|scrape 9090/TCP| AGN
    Peers["Peer grid-operators"] <-->|SWIM 7946/UDP<br/>signals 9091/TCP| AGN

    %% External services
    AGN -->|API server 6443/TCP| K8sAPI["Kubernetes API"]
    AGN -->|health / tools/list| MCP["MCP servers"]
    AGN -.->|optional 5432/TCP| Postgres["PostgreSQL"]
    AGN -.->|optional| PromOp["Prometheus Operator<br/>ServiceMonitor CRD"]

