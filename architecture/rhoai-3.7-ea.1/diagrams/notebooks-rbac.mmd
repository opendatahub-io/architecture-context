graph TD
    Note0["notebooks defines NO ClusterRoles, Roles or RoleBindings.<br/>Images run as the workbench pod ServiceAccount provisioned by the notebook controller."]

    subgraph Identities["Runtime identities (provisioned externally)"]
        WBSA["Workbench pod ServiceAccount<br/>notebook controller"]
        UserTok["User token<br/>oc login inside workbench"]
        PipeSA["Pipeline pod SA<br/>DSP / Argo"]
        OpSA["rhods-operator SA"]
    end

    subgraph Credentials["Credentials mounted into pods"]
        SAToken["Projected SA token<br/>KF_PIPELINES_SA_TOKEN_PATH<br/>auto-rotated"]
        ElyraSecret["Elyra runtime config Secret<br/>/opt/app-root/runtimes/<br/>DSP endpoint + S3 keys"]
        AWSEnv["AWS_ACCESS_KEY_ID / SECRET<br/>or AWS_ROLE_ARN + web identity"]
    end

    subgraph Enforcement["Authorization enforcement points (external to repo)"]
        KRP["kube-rbac-proxy sidecar<br/>SubjectAccessReview on Notebook"]
        NSRBAC["Namespace RBAC<br/>Data Science Project"]
        DSPAuth["DSP API server auth"]
    end

    subgraph Resources["API resources reached"]
        NotebookCR["kubeflow.org<br/>Notebook"]
        RayRes["ray.io<br/>RayCluster / RayJob"]
        PipeRes["DSP pipelines / runs"]
        ISRes["image.openshift.io<br/>ImageStream x24"]
        CMRes["core<br/>ConfigMap notebook-image-params,<br/>notebook-image-commithash"]
    end

    WBSA -->|"mounts"| SAToken
    WBSA -->|"mounts"| ElyraSecret
    PipeSA -->|"env"| AWSEnv
    SAToken -->|"Bearer"| DSPAuth
    DSPAuth -->|"namespace RBAC"| PipeRes
    UserTok -->|"Bearer 6443"| NSRBAC
    WBSA -->|"Bearer 6443"| NSRBAC
    NSRBAC -->|"CodeFlare SDK"| RayRes
    KRP -->|"SAR, controller-defined policy"| NotebookCR
    OpSA -->|"applies, operator RBAC external"| ISRes
    OpSA -->|"applies, operator RBAC external"| CMRes

    style Note0 fill:#fff2cc,stroke:#d6b656
    style WBSA fill:#4a90e2
    style UserTok fill:#4a90e2
