graph TD
    subgraph SAs["Service Accounts / Subjects"]
        HarnessSA["Harness SA<br/>serviceAccount.name<br/>(harness/model ns)"]
        MSSA["modelservice SA<br/>model_id_label<br/>(model ns)"]
        DiscSA["default/llm-d-stack-discovery"]
        AuthGroup["Group system:authenticated<br/>(unused scaffolding)"]
    end

    subgraph Bindings["Bindings"]
        B1["RoleBinding<br/>inference-perf-job-creator-binding"]
        B2["RoleBinding<br/>inference-perf-restricted-scc"]
        B3["RoleBinding<br/>model_id_label-pod-self-labeler"]
        B4["ClusterRoleBinding<br/>llm-d-stack-discovery"]
        B5["RoleBinding<br/>PROJECT_NAME-exec-rolebinding"]
    end

    subgraph Roles["Roles / ClusterRoles"]
        R1["Role<br/>inference-perf-job-creator"]
        R2["ClusterRole<br/>system:openshift:scc:restricted"]
        R3["Role<br/>model_id_label-pod-self-labeler"]
        R4["ClusterRole<br/>llm-d-stack-discovery (read-only)"]
        R5["Role<br/>PROJECT_NAME-exec-role"]
    end

    subgraph Resources["API Resources"]
        Jobs["batch<br/>jobs"]
        CoreRead["core<br/>serviceaccounts, pods, pods/log, services"]
        MetricsSecret["core<br/>secrets: inference-gateway-sa-metrics-reader-secret"]
        FMADeploy["apps deployments +<br/>fma.llm-d.ai inferenceserverconfigs<br/>(FMA only)"]
        SCCRes["security.openshift.io<br/>SCC restricted (use)"]
        Pods["core<br/>pods"]
        DiscRes["core pods, services, configmaps, nodes<br/>apps deployments, statefulsets, replicasets<br/>route.openshift.io routes<br/>security.openshift.io SCCs<br/>gateway.networking.k8s.io gateways, httproutes, gatewayclasses<br/>inference.networking.x-k8s.io inferencepools, inferencemodels"]
        ClusterVer["config.openshift.io<br/>clusterversions"]
        Exec["core<br/>pods/exec: PROJECT_NAME-0-0"]
    end

    HarnessSA -->|bound via| B1
    HarnessSA -->|bound via| B2
    MSSA -->|bound via| B3
    DiscSA -->|bound via| B4
    AuthGroup -->|bound via| B5

    B1 -->|grants| R1
    B2 -->|grants| R2
    B3 -->|grants| R3
    B4 -->|grants| R4
    B5 -->|grants| R5

    R1 -->|create, get, list, watch, delete, patch, update| Jobs
    R1 -->|get / list / watch| CoreRead
    R1 -->|get| MetricsSecret
    R1 -->|get, patch / get| FMADeploy
    R2 -->|use| SCCRes
    R3 -->|get, patch| Pods
    R4 -->|get, list| DiscRes
    R4 -->|get| ClusterVer
    R5 -->|create| Exec

    style HarnessSA fill:#4a90e2
    style MSSA fill:#4a90e2
    style DiscSA fill:#4a90e2
    style AuthGroup fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
    style R1 fill:#f5a623
    style R2 fill:#f5a623
    style R3 fill:#f5a623
    style R4 fill:#f5a623
    style R5 fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
    style B5 fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
    style Exec fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
    style Jobs fill:#7ed321
    style CoreRead fill:#7ed321
    style MetricsSecret fill:#7ed321
    style FMADeploy fill:#7ed321
    style SCCRes fill:#7ed321
    style Pods fill:#7ed321
    style DiscRes fill:#7ed321
    style ClusterVer fill:#7ed321
