graph TD
    subgraph "Service Account"
        SA["ISVC pod ServiceAccount<br/>(KServe default; none defined by this repo)"]
    end

    subgraph "Kubernetes RBAC"
        None["No ClusterRoles, Roles or bindings<br/>OVMS makes no Kubernetes API calls"]
    end

    subgraph "Application-level access (REST 8888 / gRPC 8001)"
        V3["/v3/* generation, embeddings,<br/>rerank, images, audio"]
        V2["/v2/* KServe v2<br/>health, metadata, infer"]
        V1["/v1/* TFS v1<br/>predict, classify, regress, status"]
        Reload["/v1/config/reload<br/>admin action"]
        Metrics["/metrics"]
        GRPC["gRPC GRPCInferenceService,<br/>PredictionService, ModelService"]
    end

    Key["Static Bearer API key<br/>--api_key_file / API_KEY<br/>non-constant-time compare"]
    Platform["Platform auth (optional)<br/>Route/Gateway + kube-rbac-proxy / Authorino"]
    Anyone["Any caller with network reach to the pod"]

    SA -.->|no bindings| None
    Platform -.->|guards external path only| V2
    Anyone -->|if key configured| Key
    Key -->|grants| V3
    Anyone -->|unauthenticated| V2
    Anyone -->|unauthenticated| V1
    Anyone -->|unauthenticated| Reload
    Anyone -->|unauthenticated| Metrics
    Anyone -->|unauthenticated, no TLS| GRPC

