graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph Ingress["INGRESS - Platform Gateway (external to repo)"]
        GW["Gateway API HTTPRoute<br/>/notebook/ns/name = NB_PREFIX<br/>443/TCP HTTPS TLS 1.2+<br/>OAuth/OIDC session"]
    end

    subgraph UserNS["USER NAMESPACE - Data Science Project (NetworkPolicy by notebook controller)"]
        direction TB
        subgraph JPod["Jupyter workbench pod (StatefulSet, 1 replica)"]
            KRP1["kube-rbac-proxy sidecar<br/>added by controller<br/>Bearer to SubjectAccessReview"]
            Jupyter["Jupyter Server<br/>8888/TCP HTTP<br/>token='' password=''<br/>allow_origin=*"]
            Kernels["Kernels / terminals<br/>ZMQ localhost, HMAC key"]
        end
        subgraph CPod["code-server workbench pod"]
            KRP2["kube-rbac-proxy sidecar"]
            Nginx["nginx 8888/TCP HTTP<br/>no auth"]
            CS["code-server 8787/TCP HTTP<br/>--auth none<br/>BOUND 0.0.0.0 / [::]"]
            Httpd["httpd CGI 8080/TCP HTTP<br/>no auth"]
        end
        subgraph RPod["Pipeline node pod"]
            Boot["runtime-* image<br/>Elyra bootstrapper.py<br/>no listener"]
        end
        Culler["Notebook-controller culler"]
    end

    subgraph Cluster["CLUSTER SERVICES"]
        K8s["Kubernetes / OpenShift API<br/>6443/TCP HTTPS"]
        DSP["DSP API server<br/>8888 or 443/TCP HTTPS"]
        AppNS["Applications namespace<br/>24 ImageStreams + 2 ConfigMaps<br/>applied by rhods-operator"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible storage<br/>HTTPS or HTTP per endpoint"]
        PyPI["Python indexes<br/>443/TCP HTTPS"]
        Git["Git / GitHub<br/>443/TCP HTTPS, 22/TCP SSH"]
        DB["External databases<br/>DB-specific ports"]
        Registry["registry.redhat.io<br/>443/TCP HTTPS"]
    end

    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth/OIDC"| GW
    GW -->|"HTTPS<br/>TLS service CA<br/>Bearer token"| KRP1
    GW -->|"HTTPS<br/>TLS service CA<br/>Bearer token"| KRP2
    KRP1 -->|"HTTP/8888<br/>plaintext pod-local<br/>no auth"| Jupyter
    Jupyter -->|"ZMQ localhost"| Kernels
    KRP2 -->|"HTTP/8888<br/>no auth"| Nginx
    Nginx -->|"HTTP+WS/8787<br/>no auth"| CS
    Nginx -->|"HTTP/8080"| Httpd
    Httpd -->|"HTTP/8787 /healthz"| CS
    Culler -->|"HTTP/8888 api/kernels<br/>no auth"| Jupyter
    Culler -->|"HTTP/8888 api/kernels/<br/>no auth"| Nginx
    Culler -.->|"pod IP reachable if<br/>NetworkPolicy missing"| CS

    Jupyter -->|"HTTPS/6443<br/>TLS cluster CA<br/>Bearer SA/user token"| K8s
    Jupyter -->|"HTTPS/8888 or 443<br/>TLS<br/>Bearer pod SA token"| DSP
    Jupyter -->|"S3 API<br/>TLS if https://<br/>access key"| S3
    Boot -->|"S3 API<br/>TLS only if https://<br/>static keys / IRSA"| S3
    DSP -->|"launches via Argo"| Boot
    Jupyter -.->|"HTTPS/443 user pip"| PyPI
    Jupyter -.->|"HTTPS/443, SSH/22<br/>user credentials"| Git
    Jupyter -.->|"DB protocols<br/>user credentials"| DB
    AppNS -->|"image import<br/>HTTPS/443 pull secret"| Registry

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class GW,KRP1,KRP2 ingress
    class Jupyter,Kernels,Nginx,Httpd,Boot,Culler internal
    class CS risk
    class K8s,DSP,AppNS cluster
    class S3,PyPI,Git,DB,Registry externalservice
