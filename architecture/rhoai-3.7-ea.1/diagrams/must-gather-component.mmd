graph TB
    Admin["Cluster Admin<br/>oc adm must-gather / kubectl apply Job"]

    subgraph Image["odh-must-gather-rhel9 image (ose-must-gather-rhel9:v4.22 base)"]
        Gather["gather<br/>(collection-scripts/gather.sh)<br/>ENTRYPOINT /usr/bin/gather"]
        Common["common.sh<br/>run_mustgather / rhoai_version /<br/>collect_helm_releases / get_operator_ns"]
        XksUtil["llm-d/xks_util.sh<br/>detect_k8s_distro / kubectl_inspect /<br/>auto_discover_resources"]
        Collectors["Component collectors<br/>gather_*.sh (20 scripts)<br/>DSP, KServe, Workbench, KubeRay, Kueue, KFTO,<br/>Model Registry, TrustyAI, Feast, Data Registry,<br/>MLflow, Spark, AI Gateway, MCPLO, OGX"]
        LLMD["LLM-D collectors<br/>gather_llmd / gather_cluster /<br/>gather_o11y / gather_batch_gateway"]
        DepCol["Dependency collectors<br/>cert-manager / sail / lws"]
        Original["gather_original<br/>(stock OpenShift gather, never called)"]
        Tools["CLIs: oc, kubectl (ose-cli-rhel9),<br/>helm v4.1.4 (Git LFS)"]

        Gather -->|sources| Common
        Gather -->|sources| XksUtil
        Gather -->|"dispatches (parallel on OCP)"| Collectors
        Gather -->|dispatches| LLMD
        LLMD -->|runs| DepCol
        Collectors -->|oc adm inspect| Common
        LLMD -->|kubectl_inspect| XksUtil
        DepCol -->|kubectl_inspect| XksUtil
        Common --> Tools
        XksUtil --> Tools
    end

    Admin -->|"runs image (--image=...)"| Gather
    Original -.->|not invoked| Gather

    KubeAPI["Kubernetes / OpenShift API server<br/>443 or 6443/TCP HTTPS"]
    Tools -->|"get / list / logs / api-resources<br/>SA bearer token"| KubeAPI

    subgraph Read["CRs read (owned by other components)"]
        PlatformCR["DSCI, DSC,<br/>*.components / *.services.platform.opendatahub.io,<br/>webhooks, VAPs"]
        CompCR["Component CRs<br/>InferenceService, LLMInferenceService, Notebook,<br/>RayCluster, Kueue, DSPA, AIGateway, MaaS ..."]
        DepCR["Dependency CRs<br/>cert-manager, Istio/Sail, LWS,<br/>Kuadrant, Prometheus Operator"]
        HelmSec["Helm release Secrets<br/>sh.helm.release.v1.*"]
        OLM["OLM Subscription / CSV<br/>rhods-operator"]
    end

    KubeAPI --> PlatformCR
    KubeAPI --> CompCR
    KubeAPI --> DepCR
    KubeAPI --> HelmSec
    KubeAPI --> OLM

    Output["Pod-local must-gather/ directory<br/>version file, namespaces, CR YAML,<br/>pod logs, Helm values, cluster-scoped dump"]
    Gather -->|writes| Output
    Output -->|"copied out (oc adm must-gather / kubectl cp)"| Bundle["Support bundle<br/>must-gather.local.*"]

    style Gather fill:#4a90e2,color:#fff
    style Common fill:#4a90e2,color:#fff
    style XksUtil fill:#4a90e2,color:#fff
    style Collectors fill:#4a90e2,color:#fff
    style LLMD fill:#4a90e2,color:#fff
    style DepCol fill:#4a90e2,color:#fff
    style Tools fill:#4a90e2,color:#fff
    style Original fill:#e8e8e8,stroke-dasharray: 5 5
    style KubeAPI fill:#e8e8e8
    style PlatformCR fill:#f5a623
    style CompCR fill:#f5a623
    style DepCR fill:#f5a623
    style HelmSec fill:#f5a623
    style OLM fill:#f5a623
    style Output fill:#7ed321
    style Bundle fill:#ff9999
