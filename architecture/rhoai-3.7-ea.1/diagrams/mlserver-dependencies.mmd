    MLServer["MLServer 1.7.1+rhaiv.11<br/>(odh-mlserver-rhel9,<br/>odh-mlserver-cuda-rhel9)"]

    %% External library dependencies
    MLServer -->|REST framework| FastAPI["fastapi 0.136.3 /<br/>starlette 1.10.0"]
    MLServer -->|ASGI server| Uvicorn["uvicorn 0.54.0 / uvloop"]
    MLServer -->|gRPC transport| GRPCIO["grpcio 1.85.1 /<br/>protobuf 6.33.6"]
    MLServer -->|settings, V2 types| Pydantic["pydantic 2 /<br/>pydantic-settings"]
    MLServer -->|metrics| PromLibs["prometheus-client,<br/>py-grpc-prometheus,<br/>starlette-exporter"]
    MLServer -.->|tracing, optional| OTel["opentelemetry 1.45.2"]
    MLServer -.->|Kafka, optional| AIOKafka["aiokafka 0.15.0"]
    MLServer -->|codecs| NumPy["numpy, pandas, orjson"]

    %% Runtime plugins
    MLServer -->|CPU image| SKL["scikit-learn, joblib"]
