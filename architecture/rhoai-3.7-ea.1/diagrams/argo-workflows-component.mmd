graph TB
    subgraph DSPA_NS["DSPA Namespace (per Data Science Project)"]
        subgraph Shipped["argo-workflows (shipped in RHOAI)"]
            Controller["workflow-controller<br/>--namespaced<br/>metrics 9090/TCP TLS, healthz 6060/TCP"]
            subgraph StepPod["Workflow Step Pod (one per step)"]
                Init["argoexec init<br/>fetch input artifacts"]
                Main["main container<br/>user/KFP component code"]
                Wait["argoexec wait<br/>upload outputs, logs"]
                Init --> Main --> Wait
            end
            Agent["argoexec agent pod<br/>HTTP/plugin templates"]
        end
        CM["ConfigMap<br/>ds-pipeline-workflow-controller-&lt;dspa&gt;"]
        PDB["PodDisruptionBudgets"]
        MemoCM["Memoization ConfigMaps"]
    end

    subgraph CRDs["argoproj.io/v1alpha1 CRDs"]
        WF["Workflow"]
        WFT["WorkflowTemplate"]
        CWFT["ClusterWorkflowTemplate<br/>cluster-scoped, read-only"]
        CronWF["CronWorkflow"]
        WTR["WorkflowTaskResult"]
        WTS["WorkflowTaskSet"]
        WAGC["WorkflowArtifactGCTask"]
        WEB["WorkflowEventBinding<br/>argo-server only"]
    end

    DSPO["Data Science Pipelines Operator<br/>deploys controller per DSPA"] -->|creates Deployment, Role,<br/>NetworkPolicy, ConfigMap| Controller
    DSPO -->|renders| CM
    KFP["KFP API Server"] -->|creates| WF
    PA["KFP Persistence Agent"] -->|watches status| WF

    CM -->|configures| Controller
    WF -->|watched by| Controller
    WFT -->|referenced by| Controller
    CWFT -->|referenced by| Controller
    CronWF -->|watched by| Controller
    Controller -->|creates| StepPod
    Controller -->|creates| PDB
    Controller -->|creates| MemoCM
    Controller -->|creates| WTS
    Controller -->|creates| Agent
    Controller -->|creates| WAGC
    Wait -->|writes| WTR
    WTR -->|read by| Controller
    Agent -->|patches status| WTS

    Init -->|HTTPS/443| ObjStore["Object Storage<br/>S3/MinIO, GCS, Azure, OSS, HDFS"]
    Wait -->|HTTPS/443| ObjStore
    Controller -->|artifact GC| ObjStore
    Init -.->|HTTPS/SSH| Git["Git Remotes"]
    Agent -->|HTTP/HTTPS any port| HTTPEP["User HTTP Endpoints"]
    Controller -->|HTTPS/6443| K8sAPI["Kubernetes API"]
    Prom["OpenShift Monitoring"] -->|HTTPS/9090| Controller

    subgraph NotShipped["Upstream only - NOT shipped in RHOAI"]
        ArgoServer["argo-server<br/>UI + gRPC/REST 2746/TCP"]
        CLI["argo CLI"]
        SQL["SQL Archive<br/>MySQL/Postgres"]
    end
    CLI -.-> ArgoServer
    ArgoServer -.-> SQL
    ArgoServer -.-> WEB

    style Controller fill:#4a90e2,color:#fff
    style Init fill:#4a90e2,color:#fff
    style Wait fill:#4a90e2,color:#fff
    style Agent fill:#4a90e2,color:#fff
    style Main fill:#d0e4f7
    style WF fill:#f5a623
    style WFT fill:#f5a623
    style CWFT fill:#f5a623
    style CronWF fill:#f5a623
    style WTR fill:#f5a623
    style WTS fill:#f5a623
    style WAGC fill:#f5a623
    style WEB fill:#f5a623
    style DSPO fill:#7ed321
    style KFP fill:#7ed321
    style PA fill:#7ed321
    style Prom fill:#7ed321
    style ObjStore fill:#e8e8e8
    style Git fill:#e8e8e8
    style HTTPEP fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style ArgoServer fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5
    style CLI fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5
    style SQL fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5
