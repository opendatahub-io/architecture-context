graph TB
    Platform["opendatahub-operator / rhods-operator<br/>(platform module handler)"]
    ConfigMap["odh-aigateway-config ConfigMap<br/>data.platformVersion"]

    subgraph NS_Apps["Namespace: redhat-ods-applications"]
        subgraph OperatorPod["Deployment: ai-gateway-operator"]
            Init["copy-manifests init container<br/>/manifests → /opt/manifests emptyDir"]
            Manager["manager (Cobra: /manager operator)<br/>probes :8081, HTTPS metrics :8443"]
            Reconciler["AIGateway reconciler<br/>init → infra-RBAC → render → deploy SSA → status → GC"]
            TLSWatch["TLS profile resolver/watcher<br/>(internal/tls)"]
            Config["Module config loader<br/>(Viper, ODH_MODULE_OPERATOR_*)"]
            Manifests["Vendored manifests<br/>/opt/manifests params.env rewrite"]
            Init -->|populates| Manifests
            Manager --> Reconciler
            Manager --> TLSWatch
            Manager --> Config
            Reconciler -->|kustomize render| Manifests
        end
        MaaS["maas-controller + maas-api<br/>payload-processing, discovery,<br/>key-cleanup CronJob"]
        AIGWCtrl["ai-gateway-controller<br/>praxis-extproc, kube-auth-proxy"]
        Batch["llm-d-batch-gateway-operator"]
    end

    subgraph NS_Infra["Namespace: redhat-ai-gateway-infra"]
        DBSecret["Secret: maas-db-config<br/>(preserved on removal)"]
        MigrateRole["Role/RoleBinding:<br/>maas-controller-secret-migrate"]
    end

    subgraph NS_Grid["Namespace: redhat-ai-grid"]
        Grid["grid-operator (Praxis AI Grid)<br/>LB Services 7946/UDP, 9091/TCP"]
    end

    AIGatewayCR["AIGateway CR (cluster)<br/>default-aigateway<br/>batchGateway / modelsAsAService / aiGrid"]
    MaaSCRDs["MaaS CRDs<br/>maas.opendatahub.io (8)<br/>inference.opendatahub.io (2)"]
    BatchCRD["LLMBatchGateway CRD<br/>batch.llm-d.ai"]
    GuardCRD["AIGuardrail CRD<br/>aigateway.opendatahub.io"]
    GridCRDs["grid.praxis.fast CRDs (5)<br/>never deleted"]
    Webhook["ValidatingWebhookConfiguration<br/>maas-validating-webhook-configuration"]
    APIServer["OpenShift APIServer<br/>TLS profile"]

    Platform -->|deploys overlay, injects RELATED_IMAGE_*| OperatorPod
    Platform -->|sets toggles| AIGatewayCR
    Platform -->|maintains| ConfigMap
    AIGatewayCR -->|watched by| Reconciler
    ConfigMap -->|platformVersion handshake| Reconciler
    APIServer -->|watched by| TLSWatch

    Reconciler -->|modelsAsAService: Managed| MaaS
    Reconciler -->|modelsAsAService: Managed| AIGWCtrl
    Reconciler -->|batchGateway: Managed| Batch
    Reconciler -->|aiGrid: Managed| Grid
    Reconciler -->|installs| MaaSCRDs
    Reconciler -->|installs| BatchCRD
    Reconciler -->|installs| GuardCRD
    Reconciler -->|installs| GridCRDs
    Reconciler -->|installs| Webhook
    Reconciler -->|creates NS + RBAC| MigrateRole
    Reconciler -.->|teardown-requested annotation| MaaS
    MaaS -.->|teardown-completed annotation| Reconciler
    MigrateRole -->|grants access| DBSecret
    Webhook -->|admission| MaaS
    Reconciler -->|status: conditions, releases, module| AIGatewayCR

