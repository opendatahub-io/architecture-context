graph TD
    subgraph SAs["Service Accounts"]
        ModSA["mcp-lifecycle-module-operator-controller-manager"]
        OpSA["mcp-lifecycle-operator-controller-manager"]
    end

    subgraph Bindings["Bindings"]
        ModCRB["ClusterRoleBinding<br/>mcp-lifecycle-module-operator-manager-rolebinding"]
        OpCRB["ClusterRoleBinding<br/>mcp-lifecycle-operator-manager-rolebinding"]
        OpMetricsCRB["ClusterRoleBinding<br/>mcp-lifecycle-operator-metrics-auth-rolebinding"]
        OpLeaderRB["RoleBinding (SYSTEM_NAMESPACE)<br/>mcp-lifecycle-operator-leader-election-rolebinding"]
    end

    subgraph Roles["Roles"]
        ModCR["ClusterRole<br/>mcp-lifecycle-module-operator-manager-role<br/>(superset of operand perms)"]
        OpCR["ClusterRole<br/>mcp-lifecycle-operator-manager-role"]
        OpMetricsCR["ClusterRole<br/>mcp-lifecycle-operator-metrics-auth-role"]
        OpLeaderR["Role<br/>mcp-lifecycle-operator-leader-election-role"]
    end

    subgraph ModRes["Module: API Resources"]
        MRbac["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings, roles, rolebindings"]
        MCrd["apiextensions.k8s.io customresourcedefinitions<br/>admissionregistration.k8s.io validatingwebhookconfigurations"]
        MCore["core: configmaps, namespaces, serviceaccounts, services<br/>apps: deployments<br/>networking.k8s.io: networkpolicies<br/>cert-manager.io: certificates, issuers<br/>monitoring.coreos.com: servicemonitors<br/>coordination.k8s.io: leases"]
        MRead["core: pods, secrets<br/>apps: daemonsets, statefulsets<br/>config.openshift.io: apiservers<br/>gateway.networking.k8s.io: gateways<br/>mcp.kuadrant.io: mcpgatewayextensions"]
        MMcp["mcp.x-k8s.io<br/>mcpservers, mcpgatewaybindings (+status, finalizers)"]
        MGw["gateway.networking.k8s.io httproutes<br/>mcp.kuadrant.io mcpserverregistrations"]
        MSelf["components.platform.opendatahub.io<br/>mcplifecycleoperators (+status, finalizers)"]
        MSvm["migration.k8s.io<br/>storageversionmigrations"]
        MAuth["tokenreviews, subjectaccessreviews<br/>events.k8s.io events<br/>nonResource /metrics"]
    end

    subgraph OpRes["Operand: API Resources"]
        ORead["core: configmaps, namespaces, pods, secrets<br/>apps: daemonsets, statefulsets<br/>apiextensions: CRDs<br/>gateways, mcpgatewayextensions"]
        OWrite["core: services<br/>apps: deployments<br/>networking.k8s.io: networkpolicies<br/>httproutes, mcpserverregistrations"]
        OMcp["mcp.x-k8s.io mcpservers<br/>mcpgatewaybindings (+status, finalizers)"]
        OAuth["tokenreviews, subjectaccessreviews"]
        OLease["configmaps, leases, events"]
    end

    subgraph Aggregated["Aggregated user roles (mcp.x-k8s.io mcpservers)"]
        AggAdmin["mcpserver-admin-role → admin<br/>full CRUD + deletecollection"]
        AggEdit["mcpserver-editor-role → edit<br/>CRUD"]
        AggView["mcpserver-viewer-role → view<br/>get, list, watch"]
    end

    ModSA -->|bound via| ModCRB --> ModCR
    OpSA -->|bound via| OpCRB --> OpCR
    OpSA -->|bound via| OpMetricsCRB --> OpMetricsCR
    OpSA -->|bound via| OpLeaderRB --> OpLeaderR

    ModCR -->|create,delete,get,list,patch,update,watch| MRbac
    ModCR -->|create,delete,get,list,patch,update,watch| MCrd
    ModCR -->|create,delete,get,list,patch,update,watch| MCore
    ModCR -->|get,list,watch| MRead
    ModCR -->|full CRUD + deletecollection| MMcp
    ModCR -->|create,delete,get,list,patch,update,watch| MGw
    ModCR -->|full CRUD| MSelf
    ModCR -->|create,delete,get| MSvm
    ModCR -->|create / get| MAuth

    OpCR -->|get,list,watch| ORead
    OpCR -->|create,get,list,update,watch +delete on svc/routes| OWrite
    OpCR -->|get,list,patch,update,watch / CRUD on bindings| OMcp
    OpMetricsCR -->|create| OAuth
    OpLeaderR -->|create,delete,get,list,patch,update,watch| OLease

    ModCR -.->|creates| OpCR
    ModCR -.->|creates| Aggregated

