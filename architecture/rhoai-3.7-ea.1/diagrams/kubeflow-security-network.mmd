graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph Ingress["INGRESS - openshift-ingress"]
        Gateway["data-science-gateway<br/>Gateway API, 443/TCP HTTPS<br/>TLS terminated at Gateway<br/>Platform auth (gateway-level)"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        KubeAPI["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph CtrlNS["CONTROLLER NAMESPACE (applications ns)"]
        ODHWH["odh-notebook-controller webhook<br/>Svc 443 → 8443/TCP HTTPS<br/>TLS per cluster profile, service-ca cert<br/>failurePolicy: Fail"]
        ODHCtl["odh-notebook-controller<br/>SA: odh-notebook-controller-manager<br/>Metrics Svc 8443 → 8080 HTTPS<br/>Probes 8081 HTTP"]
        KFCtl["notebook-controller<br/>SA: notebook-controller-service-account<br/>Metrics 8443 HTTPS<br/>Probes 8081 HTTP"]
        Routes["HTTPRoutes<br/>/notebook/&lt;ns&gt;/&lt;name&gt;"]
    end

    subgraph UserNS["USER NAMESPACE (tenant)"]
        KRPSvc["&lt;nb&gt;-kube-rbac-proxy Service<br/>8443/TCP HTTPS<br/>service-ca cert, cluster TLS flags<br/>NP: 8443 from ANY source"]
        subgraph Pod["Notebook Pod (SA: &lt;nb&gt;)"]
            KRP["kube-rbac-proxy sidecar<br/>8443 TLS, 8444 health<br/>TokenReview + SAR"]
            NB["Jupyter / IDE<br/>8888/TCP HTTP"]
        end
        NBSvc["&lt;nb&gt; Service<br/>80 → 8888 HTTP, no auth<br/>NP -ctrl-np: 8888 from controller ns"]
    end

    subgraph Monitoring["openshift-monitoring"]
        Prom["Prometheus"]
    end

    subgraph Egress["EXTERNAL / ANY DESTINATION"]
        Any["Any destination<br/>(-egress-np allow-all)"]
    end

    Browser -->|"HTTPS/443<br/>TLS<br/>Platform auth"| Gateway
    Gateway -->|"HTTPRoute (via ReferenceGrant)"| Routes
    Routes -->|"HTTPS/8443<br/>TLS service-ca<br/>Bearer / X-Auth-Request-*"| KRPSvc
    Routes -.->|"HTTP/8888 plaintext<br/>NO AUTH (inject-auth absent)"| NBSvc
    KRPSvc --> KRP
    KRP -->|"HTTP 127.0.0.1:8888<br/>loopback"| NB
    KRP -->|"HTTPS/6443<br/>TokenReview + SAR<br/>system:auth-delegator"| KubeAPI
    NBSvc --> NB

    KubeAPI -->|"HTTPS/443→8443<br/>TLS cluster profile<br/>Admission"| ODHWH
    ODHCtl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| KubeAPI
    KFCtl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| KubeAPI
    KFCtl -->|"HTTP/80→8888<br/>PLAINTEXT, no auth<br/>culler /api/kernels"| NBSvc

    Prom -->|"HTTPS/8443<br/>TLS service-ca<br/>Bearer → TokenReview/SAR"| ODHCtl
    Prom -->|"HTTPS/8443<br/>TLS service-ca<br/>Bearer → TokenReview/SAR"| KFCtl

    NB -->|"any port/protocol"| Any

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Gateway ingress
    class KubeAPI controlplane
    class ODHWH,ODHCtl,KFCtl,Routes controller
    class KRPSvc,KRP,NB tenant
    class NBSvc risk
    class Prom,Any externalservice
