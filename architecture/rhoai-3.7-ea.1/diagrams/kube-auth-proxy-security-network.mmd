graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser user"]
        CLI["CLI / SDK<br/>oc whoami -t, SA tokens"]
        MLflowCli["mlflow-python-client"]
    end

    subgraph Ingress["INGRESS (operator-managed, external to repo)"]
        GW["data-science-gateway<br/>Gateway API + ext_authz EnvoyFilter<br/>443/TCP HTTPS TLS 1.2+ SIMPLE"]
        Route["Example OpenShift Route<br/>443/TCP edge TLS<br/>insecureEdgeTerminationPolicy: Redirect"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        subgraph NS_KAP["Namespace: deployer-defined (example: default)"]
            KAP["kube-auth-proxy<br/>SA: kube-auth-proxy<br/>4180/TCP HTTP (default bind 127.0.0.1)<br/>optional HTTPS :443 TLS 1.2+<br/>Svc example: 80/TCP to 4180"]
            Metrics["/metrics<br/>--metrics-address (unset by default)<br/>no auth, optional TLS"]
        end
        Upstream["Upstream RHOAI component<br/>component port<br/>identity headers"]
        Redis["Redis / Valkey (optional)<br/>6379/TCP typical<br/>optional TLS, password"]
        Prom["Prometheus"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>kubernetes.default.svc 443/TCP<br/>TLS 1.2+, SA CA bundle"]
        OAuthSrv["OpenShift OAuth server<br/>443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        IdP["External OIDC IdP (BYOIDC)<br/>443/TCP HTTPS TLS 1.2+<br/>optional custom CA"]
    end

    Browser -->|HTTPS/443<br/>TLS 1.2+<br/>session cookie| GW
    CLI -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer token| GW
    MLflowCli -->|HTTPS/443<br/>Bearer or none| GW
    Browser -.->|HTTPS/443 example| Route
    GW -->|ext_authz HTTP or HTTPS/4180<br/>per operator config<br/>forwarded bearer/cookie| KAP
    Route -.->|HTTP/80 to 4180<br/>plaintext after edge| KAP
    GW -->|component port<br/>TLS DestinationRule<br/>identity headers| Upstream
    KAP -->|reverse-proxy mode<br/>HTTP/HTTPS, skip-verify configurable| Upstream
    KAP -->|HTTPS/443<br/>SA token<br/>TokenReview create| K8sAPI
    KAP -->|HTTPS/443<br/>user bearer token<br/>users/~ GET, OAuthAccessToken DELETE| K8sAPI
    KAP -->|HTTPS/443<br/>client ID + SA token secret<br/>code redeem| OAuthSrv
    KAP -->|HTTPS/443<br/>client ID/secret<br/>discovery, JWKS, token| IdP
    KAP -.->|TCP RESP<br/>AES-GCM tickets| Redis
    Prom -.->|HTTP/HTTPS scrape| Metrics
    Browser -.->|HTTPS/443<br/>user credentials| OAuthSrv
    Browser -.->|HTTPS/443<br/>user credentials| IdP

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser,CLI,MLflowCli external
    class GW,Route ingress
    class KAP,Metrics,Upstream,Redis,Prom internal
    class K8sAPI,OAuthSrv control
    class IdP externalservice
