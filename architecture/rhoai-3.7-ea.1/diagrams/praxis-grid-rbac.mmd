graph TD
    subgraph SAs["Service Accounts (grid-system)"]
        SA["grid-operator"]
        ScraperSA["grid-operator-metrics-scraper"]
    end

    subgraph Bindings["Bindings"]
        CRB_CRD["ClusterRoleBinding<br/>grid-operator-crd"]
        CRB_Scraper["ClusterRoleBinding<br/>grid-operator-metrics-scraper"]
        RB_Res["RoleBinding grid-operator-resources<br/>ns: grid-system → ClusterRole"]
        RB_LE["RoleBinding grid-operator-leader-election"]
        RB_Tok["RoleBinding grid-operator-metrics-scraper-token"]
        RB_Cfg["RoleBinding grid-operator-operator-config"]
    end

    subgraph Roles["Roles"]
        CR_CRD["ClusterRole grid-operator-crd"]
        CR_Scraper["ClusterRole grid-operator-metrics-scraper"]
        CR_Res["ClusterRole grid-operator-resources<br/>(bound namespaced)"]
        R_LE["Role grid-operator-leader-election"]
        R_Tok["Role grid-operator-metrics-scraper-token"]
        R_Cfg["Role grid-operator-operator-config"]
    end

    subgraph Resources["API Resources"]
        GridCRs["grid.praxis.fast<br/>gridnetworks, inferenceproviders, agenttoolproviders"]
        GridSites["grid.praxis.fast<br/>gridsites"]
        GridStatus["grid.praxis.fast<br/>*/status"]
        NonRes["Non-resource URL<br/>/metrics"]
        Secrets["core<br/>secrets"]
        Services["core<br/>services: grid-gateway, grid-operator-swim, grid-operator-signals"]
        Deploy["apps<br/>deployments: grid-gateway"]
        Events["events.k8s.io<br/>events"]
        CMs["core<br/>configmaps"]
        CMLocal["core<br/>configmaps: grid-operator-local-records"]
        Leases["coordination.k8s.io<br/>leases"]
        Pods["core<br/>pods"]
        Slices["discovery.k8s.io<br/>endpointslices"]
        SlicesRestricted["discovery.k8s.io<br/>endpointslices/restricted"]
        SlicesHolder["discovery.k8s.io<br/>endpointslices: *-swim-holder, *-signals-holder"]
        SAToken["core<br/>serviceaccounts/token: grid-operator-metrics-scraper"]
        CfgCM["core<br/>configmaps: grid-operator-config"]
    end

    subgraph VAPs["ValidatingAdmissionPolicies (failurePolicy: Fail)"]
        VAP_Slice["grid-operator-endpointslice-cleanup<br/>DELETE only controller-managed slices<br/>on swim/signals Services"]
        VAP_Cfg["grid-operator-protect-config<br/>deny operator SA UPDATE of grid-operator-config"]
    end

    SA --> CRB_CRD --> CR_CRD
    ScraperSA --> CRB_Scraper --> CR_Scraper
    SA --> RB_Res --> CR_Res
    SA --> RB_LE --> R_LE
    SA --> RB_Tok --> R_Tok
    SA --> RB_Cfg --> R_Cfg

    CR_CRD -->|"get, list, watch, patch; create gridnetworks"| GridCRs
    CR_CRD -->|"get, list, watch, patch, create, update, delete"| GridSites
    CR_CRD -->|"get, patch"| GridStatus
    CR_Scraper -->|"get"| NonRes
    CR_Res -->|"get, create, patch"| Secrets
    CR_Res -->|"get"| Services
    CR_Res -->|"get, patch"| Deploy
    CR_Res -->|"create, patch"| Events
    CR_Res -->|"get, create, patch, update"| CMs
    CR_Res -->|"delete"| CMLocal
    R_LE -->|"create; get, update name: grid-operator"| Leases
    R_LE -->|"get, list"| Pods
    R_LE -->|"get"| Services
    R_LE -->|"create, list, delete"| Slices
    R_LE -->|"create"| SlicesRestricted
    R_LE -->|"get, update"| SlicesHolder
    R_Tok -->|"create"| SAToken
    R_Cfg -->|"get, list, watch"| CfgCM

    VAP_Slice -.->|"restricts delete"| Slices
    VAP_Cfg -.->|"blocks update"| CfgCM

    style SA fill:#4a90e2,color:#fff
    style ScraperSA fill:#4a90e2,color:#fff
    style CR_CRD fill:#f5a623
    style CR_Scraper fill:#f5a623
    style CR_Res fill:#f5a623
    style R_LE fill:#f5a623
    style R_Tok fill:#f5a623
    style R_Cfg fill:#f5a623
    style Secrets fill:#f8cecc
    style Slices fill:#f8cecc
    style VAP_Slice fill:#dae8fc
    style VAP_Cfg fill:#dae8fc
    style GridCRs fill:#7ed321
    style GridSites fill:#7ed321
    style GridStatus fill:#7ed321
