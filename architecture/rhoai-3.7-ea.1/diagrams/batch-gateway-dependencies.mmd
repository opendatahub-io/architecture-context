graph LR
    BG["batch-gateway<br/>(apiserver, processor, gc)"]

    %% External Dependencies
    BG -->|"metadata, queue, leases (required)"| PG["PostgreSQL 12+"]
    BG -.->|"async queues (optional)"| Redis["Redis 6+ / Valkey 8+"]
    BG -.->|"file content (optional, alt FS/PVC)"| S3["S3-compatible storage"]
    BG -.->|"traces (optional)"| OTel["OpenTelemetry Collector"]
    BG -.->|"API server TLS cert (optional)"| CertManager["cert-manager"]
    BG -.->|"ServiceMonitor/PodMonitor/PrometheusRule"| PromOp["Prometheus Operator"]
    BG -->|"GC orphan reconciler"| K8sAPI["Kubernetes API"]

    %% Internal Platform Dependencies
    BG -->|"sync inference HTTP(S)"| IGW["llm-d inference gateway / EPP<br/>InferencePool / InferenceObjective"]
    BG -.->|"async dispatch library + queues"| Async["llm-d-async"]
    TLSProfile["Platform TLS profile<br/>(operator-injected)"] -->|"minVersion, ciphers, ALPN"| BG

    %% Integration Points (inbound)
    PlatGW["Platform Gateway<br/>(Gateway API HTTPRoute)"] -->|"routes /v1/batches, /v1/files"| BG
    Kuadrant["Kuadrant AuthPolicy / RateLimitPolicy<br/>MaaS"] -->|"authn, tenant header, rate limits"| PlatGW

    %% Key Go libraries
    BG -.-> Libs["Go libs: pgx v5.11, aws-sdk-go-v2,<br/>go-redis v9.22, resty v2.17,<br/>client-go v0.36.4, otel v1.47"]

    style BG fill:#4a90e2,stroke:#333,stroke-width:4px
    style PG fill:#999,stroke:#333
    style Redis fill:#999,stroke:#333
    style OTel fill:#999,stroke:#333
    style CertManager fill:#999,stroke:#333
    style PromOp fill:#999,stroke:#333
    style IGW fill:#7ed321,stroke:#333
    style Async fill:#7ed321,stroke:#333
    style TLSProfile fill:#7ed321,stroke:#333
    style PlatGW fill:#7ed321,stroke:#333
    style Kuadrant fill:#7ed321,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style Libs fill:#e8e8e8,stroke:#333
