graph TD
    subgraph SAs["Service Accounts"]
        SA["llm-d-kv-cache-pvc-evictor<br/>automountServiceAccountToken: false"]
        TokSA["UDS tokenizer sidecar<br/>runs under EPP scheduler pod SA<br/>defined by KServe, not this repo"]
    end

    subgraph Bindings["Role / ClusterRole Bindings"]
        NoBinding["None defined"]
    end

    subgraph Roles["Roles / ClusterRoles"]
        NoRole["None defined<br/>no Kubernetes API usage in shipped components"]
    end

    subgraph NonK8s["Non-Kubernetes access controls"]
        Socket["UDS socket dir /tmp/tokenizer<br/>mode 0700, pod-local emptyDir"]
        FS["Shared PVC /kv-cache<br/>UID / GID / fsGroup match with vLLM writer"]
        SecCtx["Evictor securityContext<br/>non-root UID 65532, drop ALL caps<br/>seccomp RuntimeDefault"]
    end

    subgraph NotShipped["Not shipped in RHOAI"]
        Example["examples/kv_events/pod_reconciler<br/>demo Pod watcher"]
        Stub["deploy/ stub SA operator-controller-manager<br/>references missing rbac files"]
    end

    SA -.->|no bindings| NoBinding
    NoBinding -.-> NoRole
    SA -->|filesystem access| FS
    SA -->|constrained by| SecCtx
    TokSA -->|serves on| Socket

    style SA fill:#4a90e2
    style TokSA fill:#4a90e2
    style NoBinding fill:#e8e8e8
    style NoRole fill:#e8e8e8
    style Socket fill:#f5a623
    style FS fill:#f5a623
    style SecCtx fill:#7ed321
    style Example fill:#ccc,stroke-dasharray: 5 5
    style Stub fill:#ccc,stroke-dasharray: 5 5
