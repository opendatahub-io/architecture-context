graph TB
    Admin["Platform Admin"]
    User["Data Scientist / odh-dashboard"]

    subgraph CRDs["kubeflow.org/v1beta1 CRDs"]
        WSK["WorkspaceKind CR<br/>Cluster-scoped template"]
        WS["Workspace CR<br/>Namespaced"]
    end

    subgraph Controller["workspaces-controller (odh-workbenches-controller-rhel9)"]
        direction TB
        Manager["controller-runtime Manager<br/>leader election, replicas: 1"]
        WSR["WorkspaceReconciler<br/>MaxConcurrentReconciles=10"]
        WSKR["WorkspaceKindReconciler<br/>usage counts in status"]
        WSV["WorkspaceValidator<br/>9443/TCP webhook"]
        WSKV["WorkspaceKindValidator<br/>9443/TCP webhook"]
        TLSP["TLS ProfileWatcher<br/>pkg/tls"]
        Probe["Activity prober<br/>HTTP /api/status or pods/exec"]
        Health["Health 8081/TCP<br/>Metrics 8443/TCP HTTPS"]
        Manager --> WSR
        Manager --> WSKR
        Manager --> WSV
        Manager --> WSKV
        Manager --> TLSP
        Manager --> Health
        WSR --> Probe
    end

    subgraph UserNS["User namespace - per Workspace"]
        STS["StatefulSet<br/>IDE pod: JupyterLab / code-server / RStudio"]
        KRP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS, health 8444"]
        KRPSvc["WS-kube-rbac-proxy Service<br/>+ ConfigMap + TLS Secret"]
        WSSvc["Workspace Service<br/>image-config ports"]
        SA["ServiceAccount + RoleBindings"]
        RG["ReferenceGrant"]
    end

    subgraph CtrlNS["Controller namespace"]
        HR["HTTPRoute ws-NS-NAME"]
    end

    CRB["ClusterRoleBinding<br/>system:auth-delegator per Workspace"]
    VS["Istio VirtualService<br/>upstream mode only"]

    Admin -->|creates| WSK
    User -->|creates| WS
    WS -->|validated by| WSV
    WSK -->|validated by| WSKV
    WS -->|watched by| WSR
    WSK -->|watched by| WSKR
    WSR -->|creates| STS
    WSR -->|creates| KRPSvc
    WSR -->|creates| WSSvc
    WSR -->|creates| SA
    WSR -->|creates| RG
    WSR -->|creates| HR
    WSR -->|creates| CRB
    WSR -.->|Istio mode| VS
    STS --- KRP
    Probe -->|plaintext HTTP to pod IP| STS

    HR -->|parentRef| Gateway["data-science-gateway<br/>openshift-ingress"]
    HR -->|backendRef 8443| KRPSvc
    TLSP -->|get/watch| APIServerCfg["config.openshift.io APIServer/cluster"]
    ServiceCA["OpenShift Service CA"] -->|serving certs| KRPSvc
    ServiceCA -->|serving certs + caBundle| WSV
    Operator["workbenches-operator"] -->|deploys overlays/gateway| Controller
    Backend["backend REST API :4000<br/>upstream-only"] -.->|CRUD via K8s API| WS
    Frontend["frontend nginx :8080<br/>upstream-only"] -.-> Backend

    style Manager fill:#4a90e2
    style WSR fill:#4a90e2
    style WSKR fill:#4a90e2
    style WSV fill:#4a90e2
    style WSKV fill:#4a90e2
    style TLSP fill:#4a90e2
    style Probe fill:#4a90e2
    style Health fill:#4a90e2
    style WS fill:#f5a623
    style WSK fill:#f5a623
    style Gateway fill:#7ed321
    style ServiceCA fill:#7ed321
    style Operator fill:#7ed321
    style APIServerCfg fill:#7ed321
    style KRP fill:#e8e8e8
    style VS fill:#e8e8e8
    style Backend fill:#e8e8e8,stroke-dasharray: 5 5
    style Frontend fill:#e8e8e8,stroke-dasharray: 5 5
    style CRB fill:#ff9999
