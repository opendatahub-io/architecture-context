graph TB
    Platform["ODH/RHOAI Platform Operator<br/>rhods-operator"]

    subgraph ModuleNS["Namespace: release namespace - opendatahub-feast-system in kustomize"]
        subgraph ModuleDeploy["Deployment: opendatahub-feast-operator - 1 replica"]
            Init["Init container: copy-manifests<br/>/manifests to emptyDir /opt/manifests"]
            Manager["manager container<br/>/manager operator<br/>SA: opendatahub-feast-operator"]
            subgraph Internals["Manager internals"]
                Reconciler["FeastOperator Reconciler<br/>opendatahub-operator action pipeline"]
                TLSWatch["TLS Profile Loader/Watcher<br/>restarts manager on change"]
                Metrics["Metrics server<br/>8443/TCP HTTPS intended<br/>default :8080"]
                Health["Health probes<br/>8081/TCP HTTP"]
            end
        end
        DataConfig["ConfigMap: odh-data-config<br/>platformVersion, platform-type"]
        MetricsSvc["Service: opendatahub-feast-metrics-service<br/>ClusterIP 8443/TCP"]
    end

    Chartgen["chartgen subcommand<br/>build-time Helm chart generator"]
    Chart["Helm chart config/chart"]

    FeastCR["FeastOperator CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster singleton: default-feastoperator"]
    APIServerCfg["APIServer cluster<br/>config.openshift.io/v1<br/>tlsSecurityProfile"]

    subgraph AppNS["Namespace: redhat-ods-applications"]
        FeastOp["Deployment: feast-operator-controller-manager<br/>upstream Feast operator 0.67.0"]
        CapCM["ConfigMap: feast-capabilities-config<br/>featureStoreEnabled, dataRegistryEnabled"]
        FeastSvc["Service: feast-operator-controller-manager-metrics-service<br/>8443/TCP service-CA TLS"]
        SM["ServiceMonitor"]
        FeastRBAC["Feast operator RBAC<br/>ClusterRole/Binding, Role/Binding"]
    end

    FSCRD["CRD: FeatureStore<br/>feast.dev/v1"]
    DRNS["Namespace: rhoai-data-registry<br/>label dataregistry.opendatahub.io/enabled=true"]

    Chartgen -->|generates| Chart
    Platform -->|Helm install| ModuleDeploy
    Platform -->|creates| FeastCR
    Platform -->|writes| DataConfig
    Init -->|prepares manifests| Manager
    FeastCR -->|watched by| Reconciler
    DataConfig -->|platform version handshake| Reconciler
    APIServerCfg -->|watched by| TLSWatch
    TLSWatch -->|configures TLS| Metrics
    MetricsSvc -->|targets| Metrics

    Reconciler -->|kustomize render + apply| FeastOp
    Reconciler -->|installs| FSCRD
    Reconciler -->|applies| FeastSvc
    Reconciler -->|applies| SM
    Reconciler -->|applies| FeastRBAC
    Reconciler -->|CreateOrUpdate + finalizer| CapCM
    Reconciler -->|create/label, never delete| DRNS
    Reconciler -->|patch capabilities-hash annotation| FeastOp
    Reconciler -->|status: Ready, DeploymentsAvailable, releases| FeastCR

    CapCM -->|read by| FeastOp
    FeastOp -->|reconciles FeatureStore CRs| FSCRD
    FeastOp -->|Data Registry workloads| DRNS

    style Manager fill:#4a90e2
    style Reconciler fill:#4a90e2
    style TLSWatch fill:#4a90e2
    style Metrics fill:#4a90e2
    style Health fill:#4a90e2
    style Init fill:#4a90e2
    style FeastCR fill:#f5a623
    style FSCRD fill:#f5a623
    style CapCM fill:#f5a623
    style DataConfig fill:#f5a623
    style Platform fill:#7ed321
    style FeastOp fill:#7ed321
    style APIServerCfg fill:#e8e8e8
    style Chartgen fill:#e8e8e8
    style Chart fill:#e8e8e8
