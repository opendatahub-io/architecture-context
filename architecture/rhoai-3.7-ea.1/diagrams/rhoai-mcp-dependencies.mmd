graph LR
    MCP[rhoai-mcp MCP Server]

    %% External Dependencies
    MCP -->|MCP framework| FastMCP["mcp / FastMCP 1.26+"]
    MCP -->|K8s client| K8sPy["kubernetes-python 35.x"]
    MCP -->|HTTP client| Httpx["httpx 0.28+"]
    MCP -->|plugins| Pluggy["pluggy 1.6+"]
    MCP -->|JWT validation| PyJWT["PyJWT crypto 2.15+"]
    MCP -->|ASGI| Uvicorn["starlette / uvicorn / sse-starlette"]
    MCP -->|config| Pydantic["pydantic / pydantic-settings"]
    MCP -->|embedded recommender| LLMDPlanner["llm-d-planner 0.3+"]

    %% Internal Platform Dependencies
    MCP -->|"CRD CRUD"| Notebooks["Kubeflow Notebooks"]
    MCP -->|"CRD CRUD"| KServe["KServe"]
    MCP -->|"CRD CRUD"| Trainer["Kubeflow Trainer v2"]
    MCP -->|"CRD CRUD"| DSP["Data Science Pipelines"]
    MCP -->|"CRD read"| Operator["ODH / RHOAI Operator"]
    MCP -->|"REST 8080/8443"| ModelRegistry["Model Registry"]
    MCP -->|"REST 8443"| ModelCatalog["Model Catalog"]
    MCP -.->|"REST 8000, optional"| RemotePlanner["Remote Planner backend"]
    MCP -.->|"CA bundle"| ServiceCA["OpenShift service-ca operator"]

    %% Integration Points
    Clients["MCP clients<br/>Claude Desktop, Copilot, Lightspeed"] -->|"MCP stdio / SSE / streamable-http"| MCP
    Operator -->|"deploys via kustomize, RELATED_IMAGE"| MCP
    MCPLO["MCP Lifecycle Operator"] -.->|"reconciles MCPServer CR"| MCP

    %% External Services
    MCP -->|"API server 6443"| K8sAPI["Kubernetes / OpenShift API"]
    MCP -.->|"JWKS, JWT mode"| OIDC["OIDC Issuer"]

