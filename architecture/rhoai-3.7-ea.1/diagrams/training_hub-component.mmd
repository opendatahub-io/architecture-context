graph TB
    User["Data Scientist / Pipeline"]

    subgraph TH["training_hub Python package v0.11.2 - runs inside training pods"]
        direction TB
        CLI["thub CLI<br/>training_hub.cli:main<br/>YAML --config via safe_load"]
        API["Python API<br/>sft / osft / lora_sft / lora_grpo / grpo / gepa / embedding_sft"]
        Registry["AlgorithmRegistry<br/>Algorithm + Backend ABCs"]

        subgraph Algos["Algorithms and Backends"]
            SFT["SFT<br/>InstructLabTrainingSFTBackend"]
            OSFT["OSFT<br/>MiniTrainerOSFTBackend"]
            LoRA["LoRA-SFT<br/>UnslothLoRABackend"]
            GRPO_ART["LoRA-GRPO<br/>ARTLoRAGRPOBackend<br/>co-located vLLM"]
            GRPO_VERL["GRPO<br/>VeRLLoRAGRPOBackend<br/>subprocess.Popen"]
            GEPA["GEPA<br/>GEPABackend / MLflowGEPABackend"]
            EMB["Embedding SFT<br/>SentenceTransformersBackend"]
        end

        Callbacks["Callbacks / adapters<br/>TrainingHubCallback<br/>serialize.py source to exec in workers"]
        JIT["JIT checkpoint<br/>SIGTERM flag + all_reduce MAX"]
        CkptMgr["Checkpoint manager<br/>fsspec mirror, 4 workers, 3 attempts<br/>.upload_complete markers"]
        Profiling["Profiling<br/>memory / runtime estimators"]
        Viz["Visualization<br/>plot_loss"]

        CLI --> API
        API --> Registry
        Registry --> SFT
        Registry --> OSFT
        Registry --> LoRA
        Registry --> GRPO_ART
        Registry --> GRPO_VERL
        Registry --> GEPA
        Registry --> EMB
        SFT --> Callbacks
        OSFT --> Callbacks
        Callbacks --> JIT
        JIT --> CkptMgr
    end

    User -->|"thub algo / Python call"| CLI
    User -->|import| API

    Trainer["Kubeflow Trainer v2 / KFTO<br/>TrainJob / PyTorchJob"] -->|"creates pods, injects PET_* env"| TH
    UImage["Universal training image<br/>distributed-workloads"] -->|pip install| TH

    SFT -->|torchrun| ILab["instructlab-training"]
    OSFT -->|torchrun| MiniT["rhai-innovation-mini-trainer"]
    LoRA --> Unsloth["Unsloth + TRL"]
    GRPO_ART --> ART["OpenPipe ART + vLLM"]
    GRPO_VERL --> Verl["verl + Ray / NCCL"]
    GEPA --> LiteLLM["gepa + litellm"]
    EMB --> ST["sentence-transformers"]

    CkptMgr -->|HTTPS/443| S3["S3-compatible storage"]
    GEPA -->|HTTP/HTTPS| LLM["OpenAI-compatible LLM endpoint<br/>e.g. RHOAI vLLM"]
    GEPA -->|HTTP/HTTPS| MLflow["MLflow tracking"]
    API -->|HTTPS/443| HF["HuggingFace Hub"]
    LoRA -.->|optional| WandB["Weights & Biases"]

