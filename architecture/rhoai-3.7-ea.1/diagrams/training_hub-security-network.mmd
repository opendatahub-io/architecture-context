graph TB
    subgraph Platform["KUBERNETES CONTROL PLANE"]
        Trainer["Kubeflow Trainer v2 / KFTO<br/>creates TrainJob / PyTorchJob pods<br/>injects PET_* env"]
        Kubelet["Kubelet<br/>SIGTERM on preemption"]
    end

    subgraph UserNS["USER NAMESPACE - training job pods, universal image"]
        direction TB
        subgraph Pod0["Node-0 training pod"]
            Launcher["training_hub launcher<br/>NO inbound listeners<br/>creds from pod env"]
            Workers0["torchrun workers rank 0..k"]
            Payload["Callback payload file<br/>mode 0600, exec() by workers<br/>TRUST BOUNDARY"]
        end
        subgraph PodN["Node-N training pods"]
            WorkersN["torchrun workers rank k+1..N"]
        end
        PVC[("PVC output_dir<br/>checkpoints, may hold payload")]
    end

    subgraph Egress["EXTERNAL / PLATFORM SERVICES - egress only"]
        S3["S3-compatible storage<br/>MinIO / ODF / AWS<br/>443/TCP HTTPS<br/>AWS creds from env"]
        MLflow["MLflow tracking server<br/>MLFLOW_TRACKING_URI<br/>HTTP/HTTPS, SDK auth"]
        LLM["OpenAI-compatible LLM endpoint<br/>api_base, HTTP/HTTPS<br/>Bearer OPENAI_API_KEY"]
        WandB["Weights & Biases<br/>443/TCP HTTPS<br/>WANDB_API_KEY"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>optional HF token"]
    end

    Trainer -->|"Pod spec, Kubernetes RBAC"| Launcher
    Kubelet -->|SIGTERM| Workers0
    Launcher -->|"local spawn<br/>TRAINING_HUB_CALLBACKS_PATH"| Payload
    Payload -->|"exec() in every rank"| Workers0
    Workers0 <-->|"TCP master_port c10d + NCCL/Gloo dynamic<br/>PLAINTEXT, NO AUTH"| WorkersN
    Workers0 -->|filesystem| PVC
    WorkersN -->|filesystem| PVC

    Launcher -->|"HTTPS/443<br/>TLS SDK default<br/>AWS IAM keys"| S3
    Launcher -->|"HTTP or HTTPS per URI<br/>token / basic"| MLflow
    Launcher -->|"HTTP or HTTPS per URL<br/>Bearer API key"| LLM
    Launcher -.->|"HTTPS/443 TLS<br/>API key, optional"| WandB
    Launcher -->|"HTTPS/443 TLS<br/>optional token"| HF

    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Trainer,Kubelet platform
    class Launcher,Workers0,WorkersN,PVC internal
    class Payload risk
    class S3,MLflow,LLM,WandB,HF externalservice
