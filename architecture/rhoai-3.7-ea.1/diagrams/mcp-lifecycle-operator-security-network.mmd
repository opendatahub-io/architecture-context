graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External MCP Client"]
    end

    subgraph Ingress["INGRESS (Gateway - pre-existing, not created by operator)"]
        Gateway["Gateway API Gateway / Kuadrant MCP Gateway<br/>Listener port: Gateway-defined<br/>TLS: Gateway-defined<br/>Auth: Gateway-defined"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph OperatorNS["Namespace: mcp-lifecycle-operator-system"]
        Operator["mcp-lifecycle-operator controller-manager<br/>SA: mcp-lifecycle-operator-controller-manager<br/>UID 65532, restricted securityContext<br/>FIPS: strictfipsruntime"]
        WebhookSvc["webhook-service<br/>ClusterIP 443/TCP → 9443<br/>TLS: mcplo-webhook-server-cert"]
        MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8443/TCP HTTPS<br/>TLS: mcplo-metrics-server-cert"]
        Probes["Probes :8081/TCP HTTP<br/>/healthz /readyz - no auth"]
    end

    subgraph Monitoring["Namespaces: openshift-monitoring / openshift-user-workload-monitoring"]
        Prom["Prometheus<br/>ServiceMonitor"]
    end

    subgraph TenantNS["Tenant Namespace (per MCPServer)"]
        MCPSvc["MCP server Service<br/>ClusterIP spec.config.port<br/>HTTP or HTTPS (server-defined)"]
        MCPPod["MCP server pods<br/>Deployment (managed) or BYO workload<br/>NetworkPolicy: open (default) / restricted"]
    end

    User["User / GitOps"]
    Kubelet["kubelet"]

    %% Flows
    User -->|HTTPS/6443<br/>TLS 1.2+<br/>User token / RBAC| API
    API -->|HTTPS/443→9443<br/>TLS<br/>Admission + Conversion<br/>failurePolicy Fail| WebhookSvc
    WebhookSvc --> Operator
    Operator -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token| API
    Operator -->|HTTP/HTTPS spec.config.port<br/>None / TLS CA bundle / insecureSkipVerify<br/>No credentials - MCP initialize| MCPSvc
    MCPSvc --> MCPPod
    Prom -->|HTTPS/8443<br/>TLS<br/>Bearer token TokenReview + SAR| MetricsSvc
    MetricsSvc --> Operator
    Kubelet -->|HTTP/8081<br/>no auth| Probes
    Client -->|HTTP/HTTPS<br/>Gateway listener<br/>Gateway-defined auth| Gateway
    Gateway -->|HTTPRoute / MCPServerRegistration<br/>spec.config.port| MCPSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,User external
    class Gateway ingress
    class API,Kubelet controlplane
    class Operator,WebhookSvc,MetricsSvc,Probes,Prom operator
    class MCPSvc,MCPPod tenant
