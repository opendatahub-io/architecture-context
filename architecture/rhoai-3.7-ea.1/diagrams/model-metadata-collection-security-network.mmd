graph TB
    subgraph BuildZone["BUILD ZONE (CI / developer workstation, offline tooling)"]
        Tools["Catalog CLIs<br/>model-extractor, serving-runtime-catalog,<br/>serving-runtime-validate, metadata-report<br/>Go net/http, 30s timeout, system trust store"]
        Creds["Credentials (not shipped)<br/>HF_TOKEN, GITHUB_TOKEN,<br/>registry auth file / Docker keychain"]
        Creds -.-> Tools
    end

    subgraph Internet["EXTERNAL SERVICES (Internet, untrusted content)"]
        HF["huggingface.co<br/>443/TCP HTTPS"]
        GHAPI["api.github.com<br/>443/TCP HTTPS"]
        GHRaw["raw.githubusercontent.com<br/>443/TCP HTTPS<br/>5 MiB response cap"]
        RHReg["registry.redhat.io<br/>443/TCP HTTPS"]
    end

    subgraph TrustBoundary["SUPPLY-CHAIN TRUST BOUNDARY"]
        Git["Git PR review of data/*.yaml"]
        Konflux["Konflux hermetic build<br/>digest-pinned ubi9/ubi-minimal-pqc<br/>multi-arch: x86_64, ppc64le, s390x, arm64"]
        Quay["quay.io/rhoai/<br/>odh-model-metadata-collection-rhel9"]
    end

    subgraph Cluster["OPENSHIFT CLUSTER (runtime)"]
        Kubelet["Kubelet<br/>cluster pull secret"]
        subgraph Pod["Consuming pod (namespace set by operator)"]
            DataImg["Data image container<br/>UID 1001, sleep infinity<br/>NO listeners, NO egress,<br/>NO K8s API access, NO secrets"]
            MR["model-registry catalog service<br/>enforces AuthN/AuthZ for catalog API"]
        end
    end

    Tools -->|"HTTPS/443<br/>TLS (stdlib)<br/>optional Bearer HF_TOKEN"| HF
    Tools -->|"HTTPS/443<br/>TLS (stdlib)<br/>optional Bearer GITHUB_TOKEN"| GHAPI
    Tools -->|"HTTPS/443<br/>TLS (stdlib)<br/>optional Bearer GITHUB_TOKEN"| GHRaw
    Tools -->|"HTTPS/443 OCI<br/>TLS (containers/image, skopeo, cosign)<br/>registry credentials"| RHReg

    Tools -->|"File write<br/>generated YAML"| Git
    Git -->|"COPY data/*.yaml"| Konflux
    Konflux -->|"HTTPS/443<br/>TLS<br/>Konflux service account"| Quay
    Kubelet -->|"HTTPS/443<br/>TLS<br/>pull secret"| Quay
    Kubelet -->|"image pull"| DataImg
    DataImg -->|"/app/data volume (read-only files 0644)<br/>inferred"| MR

    classDef build fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef trust fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Tools build
    class Creds secret
    class HF,GHAPI,GHRaw,RHReg external
    class Git,Konflux,Quay trust
    class Kubelet,DataImg,MR cluster
