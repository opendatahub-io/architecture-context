graph TD
    subgraph K8sRBAC["Kubernetes RBAC"]
        None["No ClusterRoles, Roles, or Bindings defined<br/>Orchestrator does not call the Kubernetes API<br/>ServiceAccount is chosen by the deployer"]
    end

    subgraph Inbound["Inbound access control (application level)"]
        MTLS["8033 all routes<br/>Optional mTLS<br/>rustls WebPkiClientVerifier<br/>only if TLS_CLIENT_CA_CERT_PATH set"]
        Passthrough["/api/v1/*, /api/v2/*<br/>Header passthrough allow-list<br/>(passthrough_headers, empty by default)"]
        Rewrite["/api/v1/*, /api/v2/*<br/>X-Forwarded-Access-Token<br/>rewritten to Authorization: Bearer<br/>(rewrite_forwarded_access_header)"]
        Open["/health, /info on 8034<br/>No auth, plain HTTP"]
    end

    subgraph Outbound["Outbound credentials"]
        Token["Static Bearer api_token<br/>value = name of env var<br/>(typically from a Secret)"]
        ClientTLS["Client TLS/mTLS files<br/>tls.NAME.cert_path / key_path /<br/>client_ca_cert_path"]
    end

    subgraph Downstream["Downstream services (enforce their own authz)"]
        Detectors["Detector services"]
        LLM["OpenAI-compatible LLM"]
        GRPC["Chunkers / TGIS / caikit-nlp"]
    end

    Caller["Caller"] --> MTLS
    MTLS --> Passthrough
    MTLS --> Rewrite
    Passthrough -->|forwards headers| Detectors
    Passthrough -->|forwards as gRPC metadata| GRPC
    Rewrite -->|Bearer caller token| Detectors
    Rewrite -->|Bearer caller token| LLM
    Token -->|Bearer shared token| Detectors
    Token -->|Bearer shared token| LLM
    ClientTLS -->|mTLS identity| GRPC
    ClientTLS -->|TLS/mTLS| Detectors
    Kubelet["Kubelet / monitoring"] --> Open

    style None fill:#e8e8e8
    style MTLS fill:#4a90e2,color:#fff
    style Passthrough fill:#4a90e2,color:#fff
    style Rewrite fill:#4a90e2,color:#fff
    style Open fill:#f8cecc
    style Token fill:#f5a623
    style ClientTLS fill:#f5a623
    style Detectors fill:#7ed321
    style LLM fill:#7ed321
    style GRPC fill:#7ed321
