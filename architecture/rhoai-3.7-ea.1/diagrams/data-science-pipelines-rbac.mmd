        Events["core: events"]
        Workflows["argoproj.io: workflows"]
        WTR["argoproj.io: workflowtaskresults"]
        SWF["kubeflow.org: scheduledworkflows"]
        KFAll["kubeflow.org: *"]
        PipelinesCR["pipelines.kubeflow.org:<br/>pipelines, pipelineversions"]
        Synthetic["pipelines.kubeflow.org (SAR-only):<br/>workflows, scheduledworkflows, runs"]
        Reviews["authn/authz.k8s.io:<br/>tokenreviews, subjectaccessreviews"]
        MLflowExp["mlflow.kubeflow.org: experiments"]
        Apps["apps: deployments, replicasets<br/>batch: jobs"]
        Seldon["machinelearning.seldon.io:<br/>seldondeployments"]
        Snap["snapshot.storage.k8s.io:<br/>volumesnapshots"]
    end

    SA_API -->|ml-pipeline binding| R_API
