graph LR
    subgraph SAs["Service Accounts"]
        SA_API["ml-pipeline"]
        SA_PA["ml-pipeline-persistenceagent"]
        SA_SWF["ml-pipeline-scheduledworkflow"]
        SA_Runner["pipeline-runner<br/>task pods"]
        G_Auth["Group: system:authenticated"]
    end

    subgraph Roles["Roles (upstream kubeflow ns, DSPO per-namespace in RHOAI)"]
        R_API["ml-pipeline"]
        R_PA["ml-pipeline-persistenceagent-role"]
        R_SWF["ml-pipeline-scheduledworkflow-role"]
        R_Runner["pipeline-runner<br/>(very broad)"]
