graph TD
    subgraph SAs["Service Accounts"]
        SA["opendatahub/ai-gateway-controller"]
        PPSA["openshift-ingress/payload-processing<br/>(managed)"]
        PromSA["redhat-ods-monitoring/prometheus-k8s"]
    end

    subgraph Bindings["ClusterRoleBindings"]
        CRB["ai-gateway-controller-rolebinding"]
        PPCRB["payload-processing-metrics-auth[-tenant]<br/>(managed)"]
        PRCRB["payload-processing-metrics-reader<br/>(managed)"]
    end

    subgraph Roles["ClusterRoles"]
        CR["ai-gateway-controller-role"]
        PPCR["payload-processing-metrics-auth"]
        PRCR["payload-processing-metrics-reader"]
    end

    subgraph Tenant["MaaS / Platform CRs"]
        MTC["maas.opendatahub.io<br/>maastenantconfigs"]
        MaaSRead["maas.opendatahub.io<br/>aitenants, maassubscriptions,<br/>maasmodelrefs, externalmodels"]
        Inference["inference.opendatahub.io<br/>externalmodels, externalproviders"]
        InfStatus["inference.opendatahub.io<br/>*/status, */finalizers"]
        AIG["aigateway.opendatahub.io<br/>aiguardrails (+ /status get,patch)"]
        ReadOnly["trustyai nemoguardrails,<br/>dscinitializations, namespaces,<br/>gateways, routes"]
    end

    subgraph Workloads["Workload / Network Resources"]
        Core["core<br/>services, serviceaccounts, configmaps"]
        Deploy["apps deployments<br/>autoscaling HPAs<br/>networkpolicies, servicemonitors"]
        IstioRes["networking.istio.io<br/>envoyfilters, destinationrules,<br/>serviceentries"]
        GWRes["gateway.networking.k8s.io<br/>httproutes, referencegrants"]
        AuthPol["kuadrant.io<br/>authpolicies"]
        Pods["core pods (get,list)<br/>pods/log (get)<br/>replicasets, endpointslices (get,list)"]
    end

    subgraph Sensitive["Sensitive (cluster-wide)"]
        Secrets["core secrets"]
        RBACRes["rbac clusterroles,<br/>clusterrolebindings,<br/>roles, rolebindings"]
    end

    subgraph Auth["Auth / Coordination"]
        Reviews["tokenreviews,<br/>subjectaccessreviews"]
        Leases["coordination leases<br/>events"]
        Metrics["nonResourceURL /metrics"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    PPSA -->|bound via| PPCRB
    PPCRB -->|grants| PPCR
    PromSA -->|bound via| PRCRB
    PRCRB -->|grants| PRCR

    CR -->|get,list,watch,update,patch| MTC
    CR -->|get,list,watch| MaaSRead
    CR -->|get,list,watch,create,update,patch| Inference
    CR -->|get,update,patch / update| InfStatus
    CR -->|get,list,watch| AIG
    CR -->|get,list,watch| ReadOnly
    CR -->|full CRUD| Core
    CR -->|full CRUD| Deploy
    CR -->|full CRUD| IstioRes
    CR -->|full CRUD| GWRes
    CR -->|full CRUD| AuthPol
    CR -->|read| Pods
    CR -->|get,list,watch,create,patch,delete| Secrets
    CR -->|create,update,patch,delete<br/>clusterroles: no delete| RBACRes
    CR -->|create| Reviews
    CR -->|CRUD / create,patch| Leases
    CR -->|get| Metrics
    PPCR -->|create| Reviews
    PRCR -->|get| Metrics

