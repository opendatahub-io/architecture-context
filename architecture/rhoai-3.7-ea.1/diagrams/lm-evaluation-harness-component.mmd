graph TB
    subgraph Image["odh-ta-lmes-job-rhel9 image (quay.io/rhoai, UID 65532, CMD python)"]
        direction TB
        CLI["lm-eval / lm_eval CLI<br/>lm_eval.__main__:cli_evaluate"]
        Adapter["main.py LMEvalAdapter<br/>(EvalHub FrameworkAdapter)"]
        Lib["lm_eval package<br/>tasks, models, simple_evaluate,<br/>filters, metrics, caching"]
        OCI["scripts/oci.py<br/>olot + skopeo"]
        S3DL["scripts/s3_downloader.py<br/>boto3"]
        CLI -->|calls| Lib
        Adapter -->|simple_evaluate<br/>local-completions| Lib
        Adapter -->|optional export| OCI
    end

    subgraph Mounts["Pod volumes"]
        JobSpec["/meta/job.json<br/>(path-traversal guarded)"]
        TestData["/test_data<br/>(offline tokenizer + datasets)"]
        Dirs["output, hf_home,<br/>my_tasks, my_catalogs"]
    end

    TrustyAI["trustyai-service-operator<br/>(LMEvalJob controller)"] -->|launches pod:<br/>python -m lm_eval| CLI
    EvalHub["EvalHub"] -->|launches pod:<br/>python main.py| Adapter
    EvalHub -->|mounts| JobSpec
    EvalHub -->|init container fills| TestData
    JobSpec -->|read by| Adapter
    TestData -->|HF offline mode| Adapter
    CLI -->|writes results| Dirs
    S3DL -->|downloads into| Dirs

    Lib -->|"/v1/completions (Bearer)"| ModelSrv["OpenAI-compatible model server<br/>(KServe / vLLM / llm-d)"]
    Lib -->|datasets, tokenizers, metrics| HF["Hugging Face Hub"]
    Lib -.->|optional CLI backends| ThirdParty["OpenAI / Anthropic /<br/>watsonx.ai / TextSynth"]
    Adapter -->|status + results callbacks| EvalHub
    Adapter -->|results via eval-hub-sdk| MLflow["MLflow"]
    OCI -->|push artifact| Registry["OCI registry"]
    S3DL -->|GET objects| S3["S3-compatible storage"]

    Base["AIPCC base images<br/>CUDA 13.0 torch 2.13 (x86_64, aarch64)<br/>CPU torch 2.13 (ppc64le, s390x)"] -.->|base image| Image

