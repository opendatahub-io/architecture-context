graph TD
    subgraph SAs["Service Accounts"]
        OpSA["mlflow-operator-controller-manager"]
        MlSA["mlflow-sa (+ trace archival SA)"]
    end

    subgraph Groups["Groups from Auth CR"]
        Allowed["allowedGroups"]
        AdminG["adminGroups"]
    end

    subgraph Bindings["Bindings"]
        CRB1["manager-rolebinding (cluster)"]
        RB1["manager-rolebinding (redhat-ods-applications)"]
        RB2["leader-election-rolebinding"]
        CRB2["metrics-auth-rolebinding"]
        CRB3["openshift-tls-profile-reader-binding"]
        CRB4["mlflow ClusterRoleBinding"]
        RBV["odh-group-mlflow-view<br/>per labeled namespace"]
        RBE["odh-group-mlflow-edit<br/>per labeled namespace"]
    end

    subgraph Roles["Roles"]
        MgrCR["manager-role ClusterRole"]
        MgrR["manager-role Role"]
        LER["leader-election-role"]
        MAR["metrics-auth-role"]
        TLSR["tls-profile-reader"]
        MlCR["mlflow ClusterRole"]
        View["mlflow-view (aggregate)"]
        Edit["mlflow-edit (aggregate)"]
        Integ["mlflow-integration"]
    end

    subgraph Resources["API Resources"]
        R1["mlflow.opendatahub.io<br/>mlflows: full CRUD"]
        R2["components.platform.opendatahub.io<br/>mlflowoperators: get,list,watch,patch,update"]
        R3["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings, rolebindings<br/>CRUD + bind (resourceNames-scoped)"]
        R4["gateway.networking.k8s.io httproutes<br/>console.openshift.io consolelinks<br/>monitoring.coreos.com servicemonitors: CRUD"]
        R5["core namespaces, pods, secrets: get,list,watch<br/>services.platform.opendatahub.io auths: read"]
        R6["core/apps/batch/networking in app ns<br/>configmaps, PVCs, secrets, SAs, services,<br/>deployments, cronjobs, jobs, networkpolicies: CRUD"]
        R7["coordination leases, configmaps, events"]
        R8["tokenreviews, subjectaccessreviews: create"]
        R9["config.openshift.io apiservers: read"]
        R10["core namespaces, secret mlflow-artifact-connection<br/>mlflow.kubeflow.org mlflowconfigs: get,list,watch"]
        R11["mlflow.kubeflow.org virtual resources<br/>experiments, registeredmodels, datasets,<br/>gateway*, mcpservers, skills"]
    end

    OpSA --> CRB1 --> MgrCR
    OpSA --> RB1 --> MgrR
    OpSA --> RB2 --> LER
    OpSA --> CRB2 --> MAR
    OpSA --> CRB3 --> TLSR
    MlSA --> CRB4 --> MlCR
    Allowed --> RBV --> View
    AdminG --> RBE --> Edit

    MgrCR --> R1
    MgrCR --> R2
    MgrCR --> R3
    MgrCR --> R4
    MgrCR --> R5
    MgrR --> R6
    LER --> R7
    MAR --> R8
    TLSR --> R9
    MlCR --> R10
    View -->|get,list,watch| R11
    Edit -->|create,delete,update,patch,get,list + /use| R11
    Integ -->|create,get,list,update; gatewayendpoints/use| R11

