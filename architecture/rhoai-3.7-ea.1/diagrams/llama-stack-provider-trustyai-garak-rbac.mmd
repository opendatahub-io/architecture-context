graph TD
    subgraph NoRBAC["This repo defines NO RBAC"]
        Note["No ClusterRoles, Roles, Bindings or ServiceAccounts in repo<br/>Job SA is provisioned by eval-hub / operator"]
    end

    subgraph Identity["Runtime identity (provisioned externally)"]
        SA["Job ServiceAccount<br/>(eval-hub provisioned)"]
        Token["SA token<br/>direct, KFP_AUTH_TOKEN, or sidecar-injected<br/>AutomountServiceAccountToken=false with sidecar"]
    end

    subgraph Required["Required permissions (inferred from code)"]
        Secrets["core / secrets<br/>ns: job namespace<br/>(Data Connection)"]
        CMs["core / configmaps<br/>ns: redhat-ods-applications or opendatahub<br/>(trustyai-service-operator-config)"]
        Runs["KFP / DSP runs<br/>ns: KFP_NAMESPACE"]
    end

    MASecret["model-auth Secret<br/>mounted at /mnt/model-auth, optional=True"]

    subgraph Fallback["Failure behavior"]
        ImgFallback["ConfigMap read denied:<br/>silent fallback to upstream quay.io/trustyai image"]
        KeyFallback["Model API key missing:<br/>13-step chain ends in DUMMY"]
    end

    SA -->|issues| Token
    Token -->|get| Secrets
    Token -->|get| CMs
    Token -->|create, get| Runs
    CMs -.->|if denied| ImgFallback
    MASecret -.->|key missing| KeyFallback

    style SA fill:#4a90e2
    style Token fill:#4a90e2
    style Secrets fill:#7ed321
    style CMs fill:#7ed321
    style Runs fill:#7ed321
    style MASecret fill:#f5a623
    style ImgFallback fill:#f8cecc
    style KeyFallback fill:#f8cecc
    style Note fill:#e8e8e8
