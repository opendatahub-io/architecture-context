graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM INGRESS (outside this repo)"]
        Ingress["Route / Gateway / auth proxy<br/>443/TCP HTTPS TLS<br/>Platform-defined auth<br/>(KServe / odh-model-controller templates)"]
        Prom["Prometheus<br/>user workload monitoring"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        subgraph NS_User["Namespace: {user-namespace} (InferenceService)"]
            subgraph Pod["Predictor pod: odh-vllm-cpu-rhel9 (UID 2000, GID 0)"]
                API["uvicorn API server<br/>8000/TCP HTTP<br/>optional TLS --ssl-* (CERT_NONE default)<br/>Bearer opt-in on /v1 /v2 /inference only<br/>CORS *"]
                Engine["Engine core<br/>ZeroMQ local IPC"]
                GRPC["gRPC VllmEngine 50051/TCP<br/>insecure, reflection<br/>NOT installed in image"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (runtime egress)"]
        HF["Hugging Face Hub<br/>huggingface.co 443/TCP<br/>TLS, optional HF_TOKEN"]
        S3["S3-compatible storage<br/>443/TCP TLS<br/>S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY"]
        MS["ModelScope 443/TCP<br/>TLS, optional MODELSCOPE_API_TOKEN"]
    end

    subgraph BuildEgress["BUILD-TIME EGRESS (non-hermetic Konflux)"]
        Idx["wheels.developerfirst.ibm.com, pypi.org,<br/>download.pytorch.org, packages.redhat.com,<br/>github.com, sh.rustup.rs, dl.fedoraproject.org<br/>uv unsafe-best-match"]
    end

    Client -->|HTTPS/443<br/>TLS<br/>Platform auth| Ingress
    Ingress -->|HTTP/8000<br/>plaintext by default<br/>Optional Bearer API key| API
    Prom -->|HTTP/8000 /metrics<br/>plaintext<br/>No auth| API
    API -->|ZeroMQ IPC<br/>in-pod, no auth| Engine
    API -.->|disabled| GRPC
    API -->|HTTPS/443<br/>TLS system OpenSSL<br/>HF_TOKEN| HF
    API -->|HTTPS/443<br/>TLS<br/>S3 keys| S3
    API -.->|HTTPS/443<br/>if VLLM_USE_MODELSCOPE| MS
    Idx -.->|baked into image build;<br/>UV_EXTRA_INDEX_URL persists at runtime| Pod

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef disabled fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Ingress,Prom ingress
    class API,Engine internal
    class GRPC disabled
    class HF,S3,MS externalservice
    class Idx risk
