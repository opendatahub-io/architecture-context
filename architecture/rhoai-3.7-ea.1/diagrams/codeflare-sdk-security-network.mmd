graph TB
    subgraph UserZone["USER PROCESS (trust = end-user identity, no SDK service account)"]
        SDK["codeflare-sdk<br/>Python library in workbench pod or laptop<br/>No listening ports, no Service"]
        TLSDir["Local TLS material<br/>~/.local/share/codeflare/tls/cluster-ns/<br/>0700 dir / 0600 files, 30-day, no auto-rotate"]
        SDK -->|writes| TLSDir
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["Kubernetes / OpenShift API server<br/>6443/TCP (443 in-cluster)<br/>RBAC: user's namespace permissions"]
    end

    subgraph Ingress["PLATFORM INGRESS (RHOAI 3.x)"]
        GW["Data-science Gateway<br/>https://host/ray/ns/cluster<br/>443/TCP TLS<br/>kube-auth-proxy ext_authz"]
        Legacy["Legacy Route / Ingress<br/>ray-dashboard-name (RHOAI 2.x)"]
    end

    subgraph Tenant["TENANT NAMESPACE (Data Science Project)"]
        Head["Ray Head pod<br/>dashboard 8265/TCP<br/>client 10001/TCP (RAY_USE_TLS)"]
        CASecret["cluster-ca-secret-*<br/>ca.crt + tls.key (CA private key)<br/>provisioned by KubeRay / RHOAI"]
        FileSecret["RayJob file Secret (Opaque)<br/>ownerRef to RayJob, GC'd"]
        Submitter["RayJob submitter pod"]
    end

    subgraph Operators["PLATFORM OPERATORS"]
        KubeRay["KubeRay operator<br/>(Operator SA)"]
        Kueue["Kueue / RHBOK"]
    end

    subgraph External["EXTERNAL (build/install only)"]
        PyPI["PyPI / quay.io/modh/ray<br/>443/TCP HTTPS"]
    end

    SDK -->|HTTPS/6443<br/>TLS verify forced<br/>Bearer / OIDC / client cert via kube-authkit| API
    SDK -->|HTTPS/443<br/>TLS, verify on OpenShift only<br/>Bearer token header| GW
    SDK -.->|HTTPS/443 fallback| Legacy
    GW -->|HTTP/S 8265<br/>Gateway-enforced| Head
    Legacy -.-> Head
    SDK -->|gRPC/10001<br/>mTLS<br/>SDK-minted client cert| Head
    API -->|Secret read incl. private key| CASecret
    KubeRay -->|creates| CASecret
    KubeRay -->|reconciles RayCluster / RayJob| Head
    Submitter -->|mounts| FileSecret
    Submitter -->|HTTP/8265 in-cluster| Head
    Kueue -.->|admission via queue-name label| Head
    PyPI -.->|pip install into workbench image| SDK

    classDef user fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef control fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef operator fill:#f5f5f5,stroke:#666,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class SDK,TLSDir user
    class API control
    class GW,Legacy ingress
    class Head,Submitter tenant
    class CASecret,FileSecret secret
    class KubeRay,Kueue operator
    class PyPI external
