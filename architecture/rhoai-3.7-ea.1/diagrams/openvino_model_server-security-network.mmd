graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client[External Client]
    end

    subgraph Ingress["INGRESS (Platform-managed, created by ODH Model Controller)"]
        Route["OpenShift Route / Gateway HTTPRoute<br/>443/TCP HTTPS<br/>TLS edge/reencrypt<br/>Optional kube-rbac-proxy / Authorino"]
    end

    subgraph Cluster["IN-CLUSTER (plaintext, no service-level auth at OVMS)"]
        direction TB
        Svc["isvc-predictor Service<br/>ClusterIP 80/TCP to 8888"]
        Prom["Prometheus<br/>user workload monitoring"]
        GClient["In-cluster gRPC client"]

        subgraph NS_User["Namespace: user InferenceService namespace"]
            subgraph PodBox["OVMS Pod (UID 5000, non-root)"]
                Init["Storage initializer<br/>init container"]
                RESTp["OVMS REST 8888/TCP HTTP<br/>v2, v1, /v1/config/reload: no auth<br/>/v3: optional static Bearer key<br/>CORS default *"]
                GRPCp["OVMS gRPC 8001/TCP<br/>InsecureServerCredentials<br/>no auth"]
                Vol[("/mnt/models")]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (egress)"]
        S3["S3 / S3-compatible<br/>443/TCP HTTPS TLS<br/>AWS keys / session token"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS TLS<br/>GOOGLE_APPLICATION_CREDENTIALS"]
        Azure["Azure Blob / File<br/>443/TCP HTTPS TLS<br/>connection string"]
        HF["Hugging Face<br/>443/TCP HTTPS TLS<br/>HF_TOKEN optional"]
        Media["Media URLs<br/>--allowed_media_domains<br/>HTTP/HTTPS, no auth"]
    end

    Client -->|HTTPS/443<br/>TLS<br/>Bearer token if platform auth| Route
    Route -->|HTTP/80<br/>plaintext or proxy TLS<br/>platform proxy| Svc
    Svc -->|HTTP/8888<br/>plaintext<br/>none| RESTp
    Prom -->|HTTP/8888 /metrics<br/>plaintext<br/>none| RESTp
    GClient -->|gRPC/8001<br/>plaintext<br/>none, not externally routable| GRPCp
    Init -->|HTTPS/443<br/>TLS<br/>data connection creds| S3
    Init -->|writes| Vol
    Vol -->|read| RESTp
    RESTp -->|HTTPS/443 TLS<br/>AWS SDK creds, optional| S3
    RESTp -->|HTTPS/443 TLS, optional| GCS
    RESTp -->|HTTPS/443 TLS, optional| Azure
    RESTp -->|HTTPS/443 TLS<br/>--pull, optional| HF
    RESTp -->|HTTP/HTTPS<br/>allowlisted VLM inputs| Media

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route ingress
    class Svc,Prom,GClient,Init,Vol internal
    class RESTp,GRPCp risk
    class S3,GCS,Azure,HF,Media externalservice
