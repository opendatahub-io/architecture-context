graph LR
    BG["llm-d-batch-gateway<br/>apiserver / processor / gc"]

    %% External services
    BG -->|"required: metadata, queue, events"| PG["PostgreSQL"]
    BG -.->|"optional: file storage (default fs/PVC)"| S3["S3-compatible storage"]
    BG -.->|"optional: async dispatch"| Redis["Redis / Valkey"]
    BG -.->|"optional: traces"| OTel["OpenTelemetry Collector"]
    BG -->|"gc reconciler watch"| K8sAPI["Kubernetes API"]

    %% Internal platform dependencies
    BG -->|"inference requests"| IntGW["llm-d Internal Gateway<br/>batch-llm-route"]
    IntGW --> Router["llm-d inference scheduler<br/>vLLM"]
    BG -.->|"Go library + queue"| Async["llm-d-async"]
    Async -.-> IntGW
    BG -.->|"Certificate CR"| CertManager["cert-manager"]
    BG -.->|"ServiceMonitor / PodMonitor / PrometheusRule"| PromOp["Prometheus Operator"]

    %% Inbound integration
    ExtGW["Platform Gateway + Kuadrant<br/>Authorino / Limitador<br/>batch-route"] -->|"HTTPRoute, AuthPolicy,<br/>tenant header"| BG

    %% Go libraries
    subgraph GoLibs["Key Go libraries"]
        pgx["jackc/pgx v5.11.0"]
        awssdk["aws-sdk-go-v2 / s3 v1.114.3"]
        goredis["redis/go-redis v9.23.0"]
        resty["go-resty v2.17.2"]
        asynclib["llm-d-async v1.0.0"]
        otellib["otel v1.47.0"]
        promlib["prometheus client_golang v1.25.0"]
        clientgo["k8s client-go v0.36.5"]
    end
    BG -.->|builds with| GoLibs

    style BG fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PG fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style OTel fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style IntGW fill:#7ed321,stroke:#333
    style Router fill:#7ed321,stroke:#333
    style Async fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333
    style PromOp fill:#7ed321,stroke:#333
    style ExtGW fill:#7ed321,stroke:#333
    style GoLibs fill:#f0f0f0,stroke:#999
