graph TD
    subgraph SAs["Service Accounts (namespace: grid-system)"]
        SA["grid-operator"]
        ScraperSA["grid-operator-metrics-scraper"]
    end

    subgraph Bindings["Bindings"]
        CRB_CRD["ClusterRoleBinding<br/>grid-operator-crd"]
        RB_Res["RoleBinding to ClusterRole<br/>grid-operator-resources<br/>(grid-system)"]
        RB_LE["RoleBinding<br/>grid-operator-leader-election"]
        RB_Tok["RoleBinding<br/>grid-operator-metrics-scraper-token"]
        RB_Cfg["RoleBinding<br/>grid-operator-operator-config"]
        CRB_Scr["ClusterRoleBinding<br/>grid-operator-metrics-scraper"]
    end

    subgraph Roles["Roles"]
        CR_CRD["ClusterRole<br/>grid-operator-crd"]
        CR_Res["ClusterRole<br/>grid-operator-resources"]
        R_LE["Role<br/>grid-operator-leader-election"]
        R_Tok["Role<br/>grid-operator-metrics-scraper-token"]
        R_Cfg["Role<br/>grid-operator-operator-config"]
        CR_Scr["ClusterRole<br/>grid-operator-metrics-scraper"]
    end

    subgraph Resources["API Resources"]
        GridCRs["grid.praxis.fast<br/>agenttoolproviders, gridnetworks,<br/>inferenceproviders"]
        GridSites["grid.praxis.fast<br/>gridsites"]
        GridStatus["grid.praxis.fast<br/>*/status"]
        GridNetCreate["grid.praxis.fast<br/>gridnetworks"]
        Secrets["core<br/>secrets"]
        Services["core<br/>services: grid-gateway,<br/>grid-operator-swim, grid-operator-signals"]
        Deploy["apps<br/>deployments: grid-gateway"]
        Events["events.k8s.io<br/>events"]
        CMs["core<br/>configmaps"]
        CMLocal["core<br/>configmaps: grid-operator-local-records"]
        Leases["coordination.k8s.io<br/>leases: grid-operator"]
        Pods["core<br/>pods"]
        ES["discovery.k8s.io<br/>endpointslices (*-holder)"]
        ESR["discovery.k8s.io<br/>endpointslices/restricted"]
        Token["core<br/>serviceaccounts/token:<br/>grid-operator-metrics-scraper"]
        CMCfg["core<br/>configmaps: grid-operator-config"]
        MetricsURL["nonResourceURL<br/>/metrics"]
    end

    subgraph VAPs["ValidatingAdmissionPolicies (failurePolicy: Fail)"]
        VAP1["grid-operator-endpointslice-cleanup<br/>DELETE only own controller-managed slices"]
        VAP2["grid-operator-protect-config<br/>never UPDATE grid-operator-config"]
    end

    SA -->|bound via| CRB_CRD
    SA -->|bound via| RB_Res
    SA -->|bound via| RB_LE
    SA -->|bound via| RB_Tok
    SA -->|bound via| RB_Cfg
    ScraperSA -->|bound via| CRB_Scr

    CRB_CRD -->|grants| CR_CRD
    RB_Res -->|grants| CR_Res
    RB_LE -->|grants| R_LE
    RB_Tok -->|grants| R_Tok
    RB_Cfg -->|grants| R_Cfg
    CRB_Scr -->|grants| CR_Scr

    CR_CRD -->|get,list,watch,patch| GridCRs
    CR_CRD -->|get,list,watch,patch,create,update,delete| GridSites
    CR_CRD -->|get,patch| GridStatus
    CR_CRD -->|create| GridNetCreate

    CR_Res -->|get,create,patch| Secrets
    CR_Res -->|get| Services
    CR_Res -->|get,patch| Deploy
    CR_Res -->|create,patch| Events
    CR_Res -->|get,create,patch,update| CMs
    CR_Res -->|delete| CMLocal

    R_LE -->|create; get,update| Leases
    R_LE -->|get,list| Pods
    R_LE -->|get| Services
    R_LE -->|create,list,delete; get,update| ES
    R_LE -->|create| ESR

    R_Tok -->|create| Token
    R_Cfg -->|get,list,watch| CMCfg
    CR_Scr -->|get| MetricsURL

    VAP1 -.->|constrains SA| ES
    VAP2 -.->|constrains SA| CMCfg

