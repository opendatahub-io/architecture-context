graph TB
    subgraph External["EXTERNAL (Untrusted) - optional exposure"]
        ExtClient["External Client"]
    end

    subgraph IngressZone["INGRESS (optional, disabled by default)"]
        Ingress["Kubernetes Ingress (Helm)<br/>llm-d-inference-sim.local<br/>80/443 TCP<br/>TLS edge if ingress.tls set<br/>No auth"]
        NodePort["NodePort Service vllm-sim<br/>dev/KIND clusters<br/>No auth"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no mesh, no NetworkPolicy shipped)"]
        direction TB
        subgraph NS_Test["Namespace: test / dev namespace"]
            Router["llm-d router / EPP<br/>P/D routing sidecar"]
            Harness["Test harness"]
            Prom["Prometheus / EPP scraper"]
            Svc["Service vllm-sim<br/>NodePort 8000/TCP or Helm ClusterIP 8001/TCP"]
            subgraph PodZone["vllm-sim Pod (UID 65532, distroless)"]
                Sim["llm-d-inference-sim<br/>8000/TCP HTTP/1.1 + gRPC h2c via cmux<br/>HTTPS TLS 1.2+ optional, gRPC unreachable when TLS on<br/>NO AUTHENTICATION on any route<br/>incl. /admin/config, LoRA, sleep"]
                Render["vllm-render sidecar<br/>localhost:8082/TCP HTTP<br/>HF_TOKEN as plain env"]
            end
            KVIndexer["llm-d KV-cache indexer<br/>or zmq-listener<br/>5557/TCP ZMQ SUB"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["huggingface.co<br/>443/TCP HTTPS"]
        DSURL["--dataset-url host<br/>443/TCP HTTPS typical"]
    end

    ExtClient -->|HTTP 80 / HTTPS 443<br/>edge TLS optional<br/>no auth| Ingress
    ExtClient -->|HTTP/node port<br/>plaintext, no auth| NodePort
    Ingress --> Svc
    NodePort --> Svc
    Router -->|HTTP or gRPC h2c / 8000<br/>plaintext, TLS optional<br/>no auth| Svc
    Prom -->|HTTP GET /metrics / 8000<br/>no auth| Svc
    Harness -->|HTTP POST /admin/config / 8000<br/>no auth| Svc
    Svc --> Sim
    Sim -->|HTTP / 8082 localhost<br/>plaintext, no auth| Render
    Sim -->|ZMQ PUB / 5557<br/>no CURVE, no auth<br/>msgpack KV events| KVIndexer
    Render -->|HTTPS / 443<br/>TLS<br/>Bearer HF_TOKEN optional| HF
    Sim -.->|HTTPS / 443 optional<br/>TLS Go defaults<br/>no auth| DSURL

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class ExtClient external
    class Ingress,NodePort ingress
    class Router,Harness,Prom,Svc,KVIndexer,Render internal
    class Sim risk
    class HF,DSURL externalservice
