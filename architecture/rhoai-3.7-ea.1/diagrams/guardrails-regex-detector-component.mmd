graph TB
    subgraph Image["regex-detector-release image (UBI 9 minimal)"]
        subgraph Binary["regex-detector binary — /app/bin/regex-detector"]
            Main["main.rs<br/>Axum Router + Tokio listener<br/>HOST:HTTP_PORT (0.0.0.0:8080)<br/>plain HTTP"]
            Trace["tower-http TraceLayer<br/>INFO request/response logs"]
            HealthRoute["GET /health<br/>returns 'healthy'"]
            ContentsRoute["POST /api/v1/text/contents<br/>handle_text_contents"]
            subgraph Detectors["detectors module (detectors.rs)"]
                BuiltIn["Built-in PII detectors<br/>email · ssn · credit-card<br/>detection_type: pii<br/>HashMap rebuilt per request"]
                Custom["Custom regex matcher<br/>caller-supplied patterns<br/>detection_type: custom<br/>compiled per request"]
            end
        end
        OpenSSL["compat-openssl11 RPM<br/>(installed, not linked)"]
    end

    Orchestrator["FMS Guardrails Orchestrator"] -->|"POST contents + detector_params.regex"| ContentsRoute
    Kubelet["kubelet / probe"] -->|"GET"| HealthRoute
    Main --> Trace
    Main --> HealthRoute
    Main --> ContentsRoute
    ContentsRoute -->|"known name"| BuiltIn
    ContentsRoute -->|"other pattern"| Custom
    ContentsRoute -.->|"logs full payload (PII) at INFO"| Logs["Container stdout logs"]

    Env["Env: HTTP_PORT, HOST"] -.->|configures| Main

    BuiltInDetector["guardrails-detectors<br/>odh-built-in-detector<br/>(operator-shipped regex/PII detector)"] -.-|"functional overlap"| Binary

    style Main fill:#4a90e2
    style Trace fill:#4a90e2
    style HealthRoute fill:#4a90e2
    style ContentsRoute fill:#4a90e2
    style BuiltIn fill:#4a90e2
    style Custom fill:#4a90e2
    style OpenSSL fill:#e8e8e8
    style Orchestrator fill:#7ed321
    style BuiltInDetector fill:#7ed321
    style Kubelet fill:#e8e8e8
    style Logs fill:#f5a623
    style Env fill:#f5a623
