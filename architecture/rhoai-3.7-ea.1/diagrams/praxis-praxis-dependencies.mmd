graph LR
    Praxis["Praxis<br/>praxis-proxy v0.8.0"]

    %% Network backends
    Praxis -->|"HTTP/TCP engine (default)"| Pingora["Pingora fork<br/>quixotic-plecostomus-* 0.11.4"]
    Praxis -.->|"experimental backend"| Hyper["hyper 1.12 / hyper-util 0.1.21"]
    Praxis -->|"async runtime (pinned)"| Tokio["tokio ~1.53.3"]

    %% TLS / crypto
    Praxis -->|"TLS state machine"| Rustls["rustls 0.23.46<br/>no default providers"]
    Rustls -->|"crypto provider"| RustlsOpenSSL["quixotic-plecostomus-rustls-openssl 0.4.1"]
    RustlsOpenSSL -->|"system bindings"| OpenSSL["openssl 0.10.81<br/>system libcrypto.so.3"]
    Praxis -->|"peer identity"| Spiffe["spiffe 0.19 / x509-parser 0.18"]
    Praxis -->|"secret handling"| Secrecy["secrecy / zeroize / subtle"]

    %% Policy
    Praxis -.->|"feature policy-*"| PPE["praxis-policy PPE 0.6.0<br/>RustCrypto or OpenSSL FIPS"]

    %% Observability / ops
    Praxis -->|"tracing"| OTel["opentelemetry 0.33.1"]
    Praxis -->|"metrics"| Metrics["metrics / metrics-exporter-prometheus"]
    Praxis -->|"logging"| Tracing["tracing / tracing-subscriber"]
    Praxis -.->|"config-reload"| Notify["notify 8.2 / arc-swap 1.9"]
    Praxis -->|"config parsing"| Serde["yaml_serde / serde_json"]
    Praxis -->|"allocator"| Jemalloc["tikv-jemallocator 0.7"]

    %% Internal platform
    PraxisAI["praxis-proxy/ai<br/>praxis-ai"] -->|"Rust crate dependency"| Praxis
    Praxis -->|"base image (FIPS)"| UBI["Red Hat UBI 9 / ubi-minimal"]

    %% Runtime integrations
    Praxis -->|"reverse proxy"| Upstream["Upstream backends"]
    Prometheus["Prometheus"] -->|"scrape 9902/TCP"| Praxis
    Praxis -->|"OTLP push"| Collector["OpenTelemetry collector"]

