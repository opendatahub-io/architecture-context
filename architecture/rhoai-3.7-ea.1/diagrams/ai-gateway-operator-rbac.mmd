graph TD
    subgraph SAs["Service Accounts"]
        SA["redhat-ods-applications/<br/>ai-gateway-operator"]
        MaaSSA["redhat-ods-applications/<br/>maas-controller"]
    end

    subgraph Bindings["Bindings"]
        CRB1["ai-gateway-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB2["ai-gateway-metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        CRB3["ai-gateway-tls-profile-rolebinding<br/>(ClusterRoleBinding)"]
        RB1["ai-gateway-leader-election-rolebinding<br/>(RoleBinding, redhat-ods-applications)"]
        RB2["maas-controller-secret-migrate<br/>(RoleBinding, redhat-ai-gateway-infra, runtime)"]
    end

    subgraph Roles["Roles"]
        Manager["ai-gateway-manager-role<br/>ClusterRole ~76 rules<br/>HIGHLY PRIVILEGED"]
        MetricsAuth["ai-gateway-metrics-auth-role"]
        TLSRole["ai-gateway-tls-profile-role"]
        LeaderRole["ai-gateway-leader-election-role<br/>(Role)"]
        MigrateRole["maas-controller-secret-migrate<br/>(Role)"]
    end

    subgraph HighRisk["High-risk API Resources"]
        RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        Secrets["core<br/>secrets (cluster-wide)"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        VWC["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        SATok["core serviceaccounts/token<br/>grid-operator-metrics-scraper"]
        SCC["security.openshift.io SCC<br/>nonroot-v2"]
    end

    subgraph Owned["Owned / Sub-component APIs"]
        AIGW["components.platform.opendatahub.io<br/>aigateways, modelsasservices"]
        SubAPIs["maas.opendatahub.io, inference.opendatahub.io,<br/>batch.llm-d.ai, grid.praxis.fast,<br/>aigateway.opendatahub.io, llm-d.ai"]
        Workloads["core: configmaps, services, serviceaccounts, namespaces<br/>apps: deployments, statefulsets<br/>batch, autoscaling, networkpolicies, endpointslices"]
        Mesh["gateway.networking.k8s.io, networking/telemetry.istio.io,<br/>kuadrant.io, cert-manager.io, monitoring.coreos.com,<br/>opentelemetry.io, perses.dev, loki.grafana.com"]
        ReadOnly["read-only: dscinitializations, config.openshift.io,<br/>routes, gateways, authorinos,<br/>llminferenceservices, nemoguardrails"]
    end

    subgraph Other["Other Resources"]
        Reviews["tokenreviews, subjectaccessreviews"]
        APIServerCfg["config.openshift.io<br/>apiservers, authentications"]
        Leases["configmaps, leases, events<br/>(redhat-ods-applications)"]
        DBSecret["secret maas-db-config<br/>(redhat-ai-gateway-infra)"]
    end

    SA --> CRB1 --> Manager
    SA --> CRB2 --> MetricsAuth
    SA --> CRB3 --> TLSRole
    SA --> RB1 --> LeaderRole
    MaaSSA --> RB2 --> MigrateRole

    Manager -->|create,delete,get,list,patch,update,watch| RBAC
