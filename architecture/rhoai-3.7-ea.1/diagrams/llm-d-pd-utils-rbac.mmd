graph TD
    Note["No RBAC shipped by llm-d-pd-utils<br/>No ServiceAccount, Role, ClusterRole, or binding.<br/>All actions use the invoking user's kubeconfig."]

    subgraph Identity["Identity"]
        User["Operator / AI agent<br/>user kubeconfig<br/>(OIDC / token / client cert)"]
        DefaultSA["ServiceAccount: default<br/>(RoCE benchmark pods,<br/>no extra permissions granted)"]
    end

    subgraph UserRBAC["Required user permissions (namespace-scoped, provided by cluster admin)"]
        Perms["User's own Role / ClusterRole bindings"]
    end

    subgraph Resources["API Resources in target namespace"]
        Pods["core<br/>pods"]
        Exec["core<br/>pods/exec"]
        Ephemeral["core<br/>pods/ephemeralcontainers"]
        Logs["core<br/>pods/log"]
        ConfigMaps["core<br/>configmaps"]
        Deployments["apps<br/>deployments"]
    end

    subgraph InPod["In-pod access controls (no K8s RBAC)"]
        Preflight["Preflight HTTP 8000<br/>NO AUTH"]
        SSHD["sshd 22<br/>per-run RSA-2048 pubkey<br/>root authorized_keys"]
        EtcdNode["etcd 2379/2380<br/>NO AUTH"]
        NodePortSvc["nixl-server NodePort 30002<br/>NO AUTH"]
    end

    User -->|authorized by| Perms
    Perms -->|get, list| Pods
    Perms -->|create| Exec
    Perms -->|"patch (--debug-image only)"| Ephemeral
    Perms -->|get| Logs
    Perms -->|"create, delete (preflight skill)"| ConfigMaps
    Perms -->|"patch, update (preflight skill)"| Deployments

    Exec -.->|"kubectl exec curl"| Preflight
    Exec -.->|"sets up"| SSHD
    Exec -.->|"starts"| EtcdNode
    DefaultSA -.->|runs| NodePortSvc

    style Note fill:#fff2cc,stroke:#d6b656
    style User fill:#4a90e2,color:#fff
    style DefaultSA fill:#4a90e2,color:#fff
    style Perms fill:#f5a623
    style Pods fill:#7ed321
    style Exec fill:#7ed321
    style Ephemeral fill:#7ed321
    style Logs fill:#7ed321
    style ConfigMaps fill:#7ed321
    style Deployments fill:#7ed321
    style Preflight fill:#f8cecc,stroke:#b85450
    style SSHD fill:#f8cecc,stroke:#b85450
    style EtcdNode fill:#f8cecc,stroke:#b85450
    style NodePortSvc fill:#f8cecc,stroke:#b85450
