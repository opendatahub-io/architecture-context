        Net["route.openshift.io routes,<br/>networking.k8s.io networkpolicies - full CRUD"]
        Webhooks["admissionregistration: webhook configs<br/>resourceNames pipelineversions.pipelines.kubeflow.org"]
        CRDs["apiextensions: CRDs (named Argo CRDs)<br/>get,list,patch,update,watch"]
        Passthru["ray.io, serving.kserve.io,<br/>workload.codeflare.dev - CRUD<br/>for pipeline-runner pass-through"]
        Mon["monitoring.coreos.com / monitoring.rhobs<br/>servicemonitors, prometheusrules"]
        AuthZ["tokenreviews, subjectaccessreviews - create"]
        Platform["components.platform.opendatahub.io<br/>aipipelines, delete default-datasciencepipelines<br/>config.openshift.io apiservers - read"]
        MLflowRes["mlflow.kubeflow.org experiments, runs<br/>mlflow.opendatahub.io mlflows - read"]
    end

    subgraph UserRoles["Aggregated user ClusterRoles"]
        AggEdit["aggregate-dspa-admin-edit<br/>DSPA, /api, pipelines, pipelineversions<br/>full CRUD -> admin, edit"]
        AggView["aggregate-dspa-admin-view<br/>get,list,watch -> view"]
        ArgoAgg["argo-aggregate-to-admin / -edit / -view"]
    end

