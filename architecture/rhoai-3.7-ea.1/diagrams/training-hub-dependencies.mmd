graph LR
    TH["training-hub v0.11.2"]

    %% Core required dependencies
    TH -->|runtime, NCCL/Gloo| Torch["torch >=2.6.0"]
    TH -->|models, HF Trainer| Transformers["transformers >=4.57.6"]
    TH -->|dataset loading| Datasets["datasets >=4.0.0"]
    TH -->|SFT backend| ILab["instructlab-training >=0.16.2"]
    TH -->|OSFT backend| MiniTrainer["rhai-innovation-mini-trainer >=0.8.3"]
    TH -->|LoRA adapters| PEFT["peft >=0.15"]
    TH -->|device placement| Accelerate["accelerate >=0.34.2"]
    TH -->|checkpoint storage| FSSpec["fsspec >=2025.0"]
    TH -->|config, CLI, plots| Misc["pydantic, pyyaml, rich, jinja2,<br/>pandas, numpy, matplotlib"]

    %% Optional extras
    TH -.->|"[s3]"| S3FS["s3fs >=2025.0"]
    TH -.->|"[lora]"| Unsloth["unsloth, trl, xformers"]
    TH -.->|"[grpo]"| ART["openpipe-art + litellm<br/>excludes 1.82.7, 1.82.8, 1.107.0"]
    TH -.->|"[grpo-verl]"| Verl["verl >=0.7"]
    TH -.->|"[gepa]"| GEPALib["gepa + litellm + mlflow >=3.5.0"]
    TH -.->|"[embedding]"| ST["sentence-transformers >=5.0"]
    TH -.->|"[cuda]"| CUDA["flash-attn, bitsandbytes,<br/>liger-kernel, mamba-ssm"]

    %% Internal platform dependencies / integrations
    DW["distributed-workloads<br/>odh-th-torch-* universal images"] -->|"pip-installs 0.11.2"| TH
    KSDK["Kubeflow SDK<br/>TrainingHubTrainer"] -->|generated code calls| TH
    Trainer["Kubeflow Trainer v2 / KFTO"] -.->|"injects PET_* env, 29500/TCP"| TH
    WB["Workbenches (Notebooks)"] -->|interactive use| TH
    Kueue["Kueue"] -.->|SIGTERM on preemption| TH
    TH -->|Python client| MLflowSvc["MLflow (RHOAI or external)"]
    TH -->|"LiteLLM HTTP/HTTPS"| Serving["vLLM / KServe /<br/>OpenAI-compatible endpoint"]

    %% External services
    TH -->|"HTTPS/443"| HF["Hugging Face Hub"]
    TH -->|"HTTPS/443"| S3["S3-compatible storage"]
    TH -->|"HTTPS/443"| WandB["Weights & Biases"]

