graph TB
    subgraph Image["odh-vllm-cpu-rhel9 image (quay.io/rhoai/odh-vllm-cpu-rhel9:rhoai-3.7-ea.1)<br/>ppc64le + s390x, UID 2000, ubi9/ubi-minimal-pqc"]
        API["vllm.entrypoints.openai.api_server<br/>FastAPI / uvicorn<br/>8000/TCP HTTP (optional TLS)"]
        AuthMW["AuthenticationMiddleware<br/>(only if --api-key / VLLM_API_KEY)<br/>guards /v1, /v2, /inference"]
        CORS["CORSMiddleware<br/>allow_origins=*"]
        Metrics["/metrics<br/>prometheus_client ASGI"]
        Engine["vLLM engine core<br/>vllm/v1/engine, model_executor<br/>continuous batching, KV cache"]
        Kernels["CPU backend<br/>torch 2.11 CPU + csrc/ C++ kernels"]
        Tensorizer["tensorizer loader<br/>[tensorizer] extra"]
        CLI["vllm console script<br/>vllm serve / bench"]
        API --> CORS
        API --> AuthMW
        API --> Metrics
        API -->|ZeroMQ local IPC| Engine
        Engine --> Kernels
        Engine --> Tensorizer
        CLI -.->|launches| API
    end

    subgraph Optional["Present in source, not active in image"]
        GRPC["grpc_server VllmEngine<br/>50051/TCP insecure, reflection<br/>smg-grpc-servicer NOT installed"]
        DPSup["DP supervisor<br/>/ready, /readyz 9256/TCP<br/>multi-port external-LB DP only"]
        Legacy["Legacy Dockerfile.*.ubi, docker/Dockerfile.*<br/>(not used by Konflux)"]
    end

    subgraph Build["Build layer (Konflux, hermetic: false)"]
        DF["Dockerfile.konflux.cpu"]
        PPC["build_vllm_ppc64le.sh<br/>IBM DevPI + RHOAI 3.5-EA2 index"]
        S390["build_vllm_s390x.sh<br/>PyTorch CDN, PyPI, GitHub source builds"]
        DF -->|uname -m = ppc64le| PPC
        DF -->|uname -m = s390x| S390
    end

    DF -->|produces| Image

    ODHMC["odh-model-controller<br/>vllm-cpu-runtime-template<br/>vllm-cpu-x86-runtime-template"] -->|ServingRuntime image ref| Image
    KServe["KServe<br/>InferenceService / ServingRuntime"] -->|creates predictor pod| Image
    Konflux["konflux-central<br/>multi-arch-container-build"] -->|runs| DF

    Engine -->|HTTPS 443| HF["Hugging Face Hub"]
    Tensorizer -->|HTTPS 443| S3["S3-compatible storage"]
    Engine -.->|HTTPS 443 if VLLM_USE_MODELSCOPE| MS["ModelScope"]

