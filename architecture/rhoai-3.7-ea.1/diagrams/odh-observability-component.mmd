graph TB
    PlatformOp["rhods-operator / opendatahub-operator<br/>ModuleHandler, DSCI spec.monitoring"]
    User[Cluster Admin]

    MonCR["Monitoring CR<br/>services.platform.opendatahub.io/v1alpha1<br/>singleton: default-monitoring"]

    PlatformOp -->|creates / configures| MonCR
    User -->|creates| MonCR

    subgraph OpNS["odh-observability operator (operator namespace)"]
        Manager["manager<br/>cmd/main.go<br/>metrics :8443 HTTPS, health :8081"]
        Reconciler["MonitoringReconciler<br/>prereq checks, action functions,<br/>SSA apply (field owner: monitoring), label GC"]
        Injector["Mutating Webhook Injector<br/>:9443 HTTPS<br/>adds monitoring.opendatahub.io/scrape=true"]
        Probe["AdmissionProbe<br/>canary PodMonitor every 5 min"]
        Manager --> Reconciler
        Manager --> Injector
        Manager --> Probe
        Probe -->|exercises| Injector
    end

    MonCR -->|watched by| Reconciler

    subgraph MonNS["Monitoring namespace (e.g. redhat-ods-monitoring)"]
        subgraph NSProxy["data-science-prometheus-namespace-proxy / data-science-thanos-querier-proxy"]
            KRP["kube-rbac-proxy<br/>:8443 TLS, TokenReview + SAR"]
            Gate["method-gate<br/>127.0.0.1:9092<br/>same operator image"]
            PLP["prom-label-proxy<br/>127.0.0.1:9091"]
            KRP --> Gate --> PLP
        end
        ClusterProxy["data-science-prometheus-cluster-proxy<br/>kube-rbac-proxy, allow-paths=/metrics"]
        Korrel8r["Korrel8r<br/>:8443 HTTPS, MCP disabled"]
        NetPol[NetworkPolicies per operand]
        Rules["PrometheusRules<br/>alerting + DCGM recording rules"]
        VAP[ValidatingAdmissionPolicy]
    end

    Reconciler -->|creates| NSProxy
    Reconciler -->|creates| ClusterProxy
    Reconciler -->|creates| Korrel8r
    Reconciler -->|creates| NetPol
    Reconciler -->|creates| Rules
    Reconciler -->|creates| VAP

    subgraph Operands["Operand CRs (owned by other operators)"]
        MS["MonitoringStack + ThanosQuerier<br/>COO"]
        Tempo["TempoMonolithic / TempoStack<br/>Tempo Operator"]
        OTel["OpenTelemetryCollector + Instrumentation<br/>data-science-collector, data-science-usage-logs"]
        Loki["LokiStack<br/>Loki Operator"]
        CLF["ClusterLogForwarder<br/>Cluster Logging Operator"]
        Perses["Perses, PersesDatasource, PersesDashboard"]
    end

    Reconciler -->|SSA renders| MS
    Reconciler -->|SSA renders| Tempo
    Reconciler -->|SSA renders| OTel
    Reconciler -->|SSA renders| Loki
    Reconciler -->|SSA renders| CLF
    Reconciler -->|SSA renders| Perses

    PLP -->|HTTP :10902| MS
    ClusterProxy -->|"mTLS :9090 prometheus-operated"| MS

    Monitors["ServiceMonitor / PodMonitor<br/>in opted-in namespaces"]
    Injector -->|labels| Monitors
    OTel -.->|TargetAllocator discovers| Monitors

    OLM["OLM OperatorConditions / ClusterExtensions<br/>+ CRD discovery"]
    Reconciler -->|prerequisite detection| OLM

