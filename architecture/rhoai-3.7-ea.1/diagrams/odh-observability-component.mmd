    style Tempo fill:#e8e8e8
    style OTel fill:#e8e8e8
    style Loki fill:#e8e8e8
    style CLF fill:#e8e8e8
    style Perses fill:#e8e8e8
    style OLM fill:#e8e8e8
    style PlatformOp fill:#7ed321
