graph TD
    subgraph SAs["Service Accounts"]
        KedaSA["keda-epp-metrics-reader"]
        WvaSA["wva-controller-manager<br/>ns llm-d-autoscaler"]
        KsmSA["kube-state-metrics<br/>ns monitoring"]
        IPSA["interactive-pod<br/>guide ns"]
        MXSA["modelexpress<br/>guide ns"]
        MSSA["sa - model servers<br/>automountServiceAccountToken: false<br/>no RBAC"]
    end

    subgraph CRBs["ClusterRoleBindings - collide across multi-namespace installs"]
        KedaCRB["keda-epp-metrics-reader-monitoring-view"]
        WvaCRB["wva-metrics-auth-rolebinding"]
        KsmCRB["kube-state-metrics-deployments"]
    end

    subgraph RBs["RoleBindings - guide namespace"]
        IPRB["interactive-pod-editor-binding"]
        MXRB["modelexpress-metadata"]
    end

    subgraph CRs["ClusterRoles"]
        CMV["cluster-monitoring-view<br/>OCP built-in"]
        WvaRole["patched role - metrics auth"]
        KsmRole["kube-state-metrics-deployments"]
        FMANode["fma-node-viewer"]
    end

    subgraph Roles["Roles - namespaced"]
        IPRole["interactive-pod-editor<br/>HIGH RISK"]
        MXRole["modelexpress-metadata"]
        FMARole["fma-launcher-pod-state-writer"]
    end

    subgraph Res["API Resources"]
        Mon["OpenShift monitoring<br/>Thanos query"]
        Nodes["core<br/>nodes"]
        Deps["apps<br/>deployments"]
        IPRes["core: pods, secrets, configmaps, services,<br/>serviceaccounts, namespaces<br/>apps: deployments<br/>gateway API, LWS, inference, llm-d.ai, kserve"]
        RBACRes["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings"]
        MXRes["modelexpress.nvidia.com<br/>modelmetadatas, modelcacheentries +status<br/>core: configmaps"]
        Pods["core<br/>pods"]
    end

    KedaSA -->|bound via| KedaCRB
    KedaCRB -->|grants| CMV
    CMV -->|"query, built-in"| Mon

    WvaSA -->|bound via| WvaCRB
    WvaCRB -->|grants| WvaRole

    KsmSA -->|bound via| KsmCRB
    KsmCRB -->|grants| KsmRole
    KsmRole -->|"list, watch"| Deps

    FMANode -->|"get, list, watch"| Nodes

    IPSA -->|bound via| IPRB
    IPRB -->|grants| IPRole
    IPRole -->|"get, list, watch, create, update, patch, delete"| IPRes
    IPRole -->|"create, update, ... - privilege escalation"| RBACRes

    MXSA -->|bound via| MXRB
    MXRB -->|grants| MXRole
    MXRole -->|"full CRUD"| MXRes

    FMARole -->|"get, patch"| Pods

