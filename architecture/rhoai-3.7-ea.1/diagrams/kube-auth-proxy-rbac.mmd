graph TD
    subgraph SAs["Identities used by kube-auth-proxy"]
        SA["ServiceAccount kube-auth-proxy<br/>(example: ns default)<br/>OAuth redirect annotations"]
        UserTok["Logged-in user's<br/>OAuth access token"]
    end

    subgraph Bindings["Bindings (none shipped in repo)"]
        CRB["Deployer-provided ClusterRoleBinding<br/>(rhods-operator in RHOAI)"]
        UserRBAC["User's own cluster RBAC"]
    end

    subgraph Roles["Required permissions (inferred from code)"]
        CR["Inferred ClusterRole<br/>(deployer-provided)"]
    end

    subgraph Resources["API Resources"]
        TR["authentication.k8s.io<br/>tokenreviews"]
        Users["user.openshift.io<br/>users/~"]
        OAT["oauth.openshift.io<br/>oauthaccesstokens"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|create| TR
    UserTok -->|authorized by| UserRBAC
    UserRBAC -->|get| Users
    UserRBAC -->|delete on sign-out| OAT

    SA -.->|acts as OAuth client<br/>system:serviceaccount:ns:sa| OAuthClient["OpenShift OAuth server"]

    NoAuthZ["No RBAC / SAR authorization in proxy<br/>Authentication only; AuthZ delegated downstream"]

    style SA fill:#4a90e2
    style UserTok fill:#4a90e2
    style CR fill:#f5a623
    style TR fill:#7ed321
    style Users fill:#7ed321
    style OAT fill:#7ed321
    style NoAuthZ fill:#ffcccc,stroke:#cc0000
