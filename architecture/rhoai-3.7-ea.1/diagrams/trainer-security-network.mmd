graph TB
    subgraph Users["USERS (authenticated via kube-apiserver)"]
        User["User / Kubeflow SDK / Dashboard<br/>bearer token / OAuth"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        API["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
        OIDC["Cluster OIDC issuer<br/>(via kube-apiserver, gated)"]
    end

    subgraph Platform["PLATFORM OPERATORS"]
        RHODS["rhods-operator"]
        JobSetCtl["JobSet controller<br/>(OpenShift JobSet Operator)"]
    end

    subgraph OpNS["Namespace: trainer-operator-system"]
        Operator["trainer-operator<br/>SA: trainer-operator-controller-manager<br/>8443/TCP metrics HTTPS service-ca<br/>8081/TCP probes HTTP"]
    end

    subgraph AppNS["Namespace: redhat-ods-applications"]
        CM["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>9443 webhook, 8443 metrics,<br/>10443 status (gated), 8081 probes"]
    end

    subgraph Monitoring["Namespace: openshift-monitoring"]
        Prom["Prometheus<br/>SA: prometheus-k8s"]
    end

    subgraph Tenant["TENANT NAMESPACES (per-TrainJob NetworkPolicy)"]
        Pods["Training pods (JobSet)<br/>28080/TCP metrics HTTP<br/>Secrets: MPI SSH, Flux CURVE"]
        Optuna["Optuna suggestion Service<br/>6789/TCP gRPC (gated, off)"]
    end

    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User bearer / OAuth"| API
    RHODS -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token, SSA apply"| API
    CM -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| API
    JobSetCtl -->|"HTTPS/6443<br/>SA token"| API
    API -->|"HTTPS svc 443 to 9443<br/>TLS cert-controller CA<br/>admission, failurePolicy Fail"| CM
    Prom -->|"HTTPS/8443<br/>TLS webhook-cert CA<br/>Bearer, TokenReview + SAR"| CM
    Prom -->|"HTTPS/8443<br/>TLS service-ca<br/>Bearer, TokenReview + SAR"| Operator
    CM -->|"HTTP/28080<br/>PLAINTEXT<br/>no auth, NetworkPolicy only"| Pods
    Pods -.->|"HTTPS/10443<br/>TLS<br/>projected SA JWT, OIDC verified"| CM
    CM -.->|"gRPC/6789<br/>INSECURE<br/>no auth"| Optuna
    CM -.->|"OIDC discovery + JWKS<br/>HTTPS/6443"| OIDC
    Pods <-->|"same-JobSet peers<br/>allowed by NetworkPolicy"| Pods

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef trusted fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class API,OIDC control
    class RHODS,JobSetCtl,Operator,CM,Prom trusted
    class Pods tenant
    class Optuna risk
