graph TB
    Client["API Client<br/>(OpenAI Batch API)"]
    Gateway["Platform Gateway<br/>batch-route (HTTPRoute)<br/>Kuadrant AuthPolicy"]

    subgraph BG["batch-gateway (Helm chart charts/batch-gateway)"]
        direction TB
        APIServer["batch-gateway-apiserver<br/>Deployment<br/>8000/TCP API, 8081/TCP obs"]
        Processor["batch-gateway-processor<br/>StatefulSet<br/>9090/TCP obs"]
        GC["batch-gateway-gc<br/>Deployment (1 replica)<br/>9091/TCP obs"]
        WorkDir["Local work dir<br/>(per-model plans, 10Gi)"]
        Secret["Secret batch-gateway-secrets<br/>/etc/.secrets"]

        Processor -->|writes plans| WorkDir
        Secret -.->|mounted| APIServer
        Secret -.->|mounted| Processor
        Secret -.->|mounted| GC
    end

    subgraph State["Shared State"]
        PG[("PostgreSQL<br/>metadata, priority queue,<br/>events, checkpoints, leases")]
        Store[("S3-compatible storage<br/>or filesystem/PVC<br/>t-sha256(tenant) prefixes")]
        Redis[("Redis/Valkey<br/>llm-d-async queues<br/>(async mode only)")]
    end

    InferenceGW["llm-d inference gateway / EPP<br/>batch-llm-route<br/>SubjectAccessReview on inferencepools"]
    AsyncDispatcher["llm-d-async<br/>Batch Dispatcher"]
    K8sAPI["Kubernetes API"]
    OTel["OTel Collector<br/>(OTLP/gRPC)"]
    Prom["Prometheus<br/>ServiceMonitor / PodMonitor"]

    Client -->|"HTTPS /v1/files, /v1/batches"| Gateway
    Gateway -->|"sets X-MaaS-Username"| APIServer

    APIServer -->|"metadata, queue entry,<br/>pth:Authorization tag"| PG
    APIServer -->|file content| Store

    Processor -->|"dequeue, lease, status"| PG
    Processor -->|"input download, output upload"| Store
    Processor -->|"sync: HTTP(S) + forwarded bearer<br/>AIMD concurrency"| InferenceGW
    Processor -->|"async: request/result queues"| Redis
    Redis --> AsyncDispatcher
    AsyncDispatcher --> InferenceGW

    GC -->|"expire, re-queue orphans"| PG
    GC -->|delete expired files| Store
    GC -->|"watch StatefulSet, list pods"| K8sAPI

    APIServer -.->|traces| OTel
    Processor -.->|traces| OTel
    GC -.->|traces| OTel
    Prom -.->|scrape| APIServer
    Prom -.->|scrape| Processor
    Prom -.->|scrape| GC

    style APIServer fill:#4a90e2
    style Processor fill:#4a90e2
    style GC fill:#4a90e2
    style WorkDir fill:#4a90e2
    style Secret fill:#f5a623
    style PG fill:#e8e8e8
    style Store fill:#e8e8e8
    style Redis fill:#e8e8e8
    style OTel fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style Prom fill:#e8e8e8
    style Gateway fill:#7ed321
    style InferenceGW fill:#7ed321
    style AsyncDispatcher fill:#7ed321
