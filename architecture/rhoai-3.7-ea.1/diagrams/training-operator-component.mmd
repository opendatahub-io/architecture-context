graph TB
    User["Data Scientist<br/>Workbench / Kubeflow Training SDK / oc"]
    KAPI["kube-apiserver<br/>6443/TCP HTTPS"]

    subgraph CRDs["kubeflow.org/v1 CRDs (Namespaced)"]
        PyTorchJobCR["PyTorchJob"]
        TFJobCR["TFJob"]
        MPIJobCR["MPIJob"]
        XGBoostJobCR["XGBoostJob"]
        PaddleJobCR["PaddleJob"]
        JAXJobCR["JAXJob"]
    end

    subgraph Operator["training-operator (Deployment kubeflow-training-operator, ns: opendatahub)"]
        Manager["Manager /manager<br/>controller-runtime, 1 replica"]
        CertRotator["Cert Rotator<br/>open-policy-agent/cert-controller"]
        Webhook["Validating Webhook Server<br/>:9443 HTTPS"]
        Common["Common JobController<br/>pods / services / status / run-policy / gang scheduling"]
        PyTorchR["PyTorchJob reconciler"]
        TFR["TFJob reconciler"]
        MPIR["MPIJob reconciler"]
        XGBR["XGBoostJob reconciler"]
        PaddleR["PaddleJob reconciler"]
        JAXR["JAXJob reconciler"]
        Metrics["Metrics :8080<br/>plain HTTP, no auth"]
        Probes["Probes :8081<br/>/healthz /readyz"]

        Manager --> CertRotator
        Manager --> Webhook
        Manager --> Metrics
        Manager --> Probes
        CertRotator -->|"certsReady gates controllers + readiness"| Common
        Common --> PyTorchR
        Common --> TFR
        Common --> MPIR
        Common --> XGBR
        Common --> PaddleR
        Common --> JAXR
    end

    User -->|"create job CR"| KAPI
    KAPI -->|"AdmissionReview CREATE/UPDATE<br/>failurePolicy: Fail"| Webhook
    Webhook -.->|"validates (MPIJob: no webhook)"| CRDs
    KAPI --> CRDs

    PyTorchJobCR -->|watched by| PyTorchR
    TFJobCR -->|watched by| TFR
    MPIJobCR -->|watched by| MPIR
    XGBoostJobCR -->|watched by| XGBR
    PaddleJobCR -->|watched by| PaddleR
    JAXJobCR -->|watched by| JAXR

    subgraph UserNS["User namespace (created resources, owner refs)"]
        Pods["Replica Pods<br/>master / worker / chief / ps / launcher"]
        Svcs["Headless Services<br/>e.g. PyTorch 23456, TF 2222"]
        HPA["HorizontalPodAutoscaler<br/>PyTorch elastic"]
        NetPol["NetworkPolicy<br/>PyTorchJob only, SSA"]
        MPIRes["MPI launcher ConfigMap, SA,<br/>Role pods/exec, RoleBinding"]
        PodGroup["PodGroup<br/>Volcano / scheduler-plugins (optional)"]
    end

    Common -->|creates| Pods
    Common -->|creates| Svcs
    Common -->|creates| PodGroup
    PyTorchR -->|creates| HPA
    PyTorchR -->|creates| NetPol
    MPIR -->|creates| MPIRes

    WebhookSecret["Secret<br/>kubeflow-training-operator-webhook-cert"]
    VWC["ValidatingWebhookConfiguration<br/>kubeflow-validator.training-operator.kubeflow.org"]
    APIServerCfg["config.openshift.io/v1<br/>APIServer cluster tlsSecurityProfile"]

    CertRotator -->|"writes CA + serving cert"| WebhookSecret
    CertRotator -->|"patches caBundle"| VWC
    Manager -->|"reads TLS profile at startup"| APIServerCfg

    RHOAIOp["RHOAI operator<br/>rhods-operator"] -->|"deploys manifests/rhoai"| Operator
    Prometheus["OpenShift monitoring<br/>PodMonitor"] -->|"scrape 8080/TCP HTTP"| Metrics
    Kueue["Kueue"] -.->|"suspend / admit via runPolicy.suspend"| CRDs

    style Manager fill:#4a90e2
    style CertRotator fill:#4a90e2
    style Webhook fill:#4a90e2
    style Common fill:#4a90e2
    style PyTorchR fill:#4a90e2
    style TFR fill:#4a90e2
    style MPIR fill:#4a90e2
    style XGBR fill:#4a90e2
    style PaddleR fill:#4a90e2
    style JAXR fill:#4a90e2
    style Metrics fill:#f8cecc
    style Probes fill:#4a90e2
    style PyTorchJobCR fill:#f5a623
    style TFJobCR fill:#f5a623
    style MPIJobCR fill:#f5a623
    style XGBoostJobCR fill:#f5a623
    style PaddleJobCR fill:#f5a623
    style JAXJobCR fill:#f5a623
    style KAPI fill:#e8e8e8
    style APIServerCfg fill:#e8e8e8
    style RHOAIOp fill:#7ed321
    style Prometheus fill:#7ed321
    style Kueue fill:#7ed321
