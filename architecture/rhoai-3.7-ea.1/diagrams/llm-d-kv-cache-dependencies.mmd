graph LR
    KVC["llm-d-kv-cache<br/>indexer library, UDS tokenizer, PVC evictor"]

    %% Internal platform integrations
    EPP["llm-d EPP scheduler<br/>llm-d-router"] -->|Go import + UDS gRPC| KVC
    KServe["KServe LLMInferenceService<br/>controller"] -->|sidecar + config injection| KVC
    VLLM["vLLM<br/>RHAIIS / llm-d runtime"] -->|ZMQ KVEvents 5557/TCP| KVC
    VLLM -->|shared PVC writer| KVC
    KVC -->|base images + PyPI index| AIPCC["AIPCC base images<br/>cpu:3.5 / cpu-el9.8:3.6.0-ea.2"]

    %% External services
    KVC -->|HTTPS 443 tokenizers| HF["Hugging Face Hub"]
    KVC -.->|optional HTTPS 443| MS["ModelScope"]
    KVC -.->|optional RESP 6379| Redis["Redis / Valkey"]
    KVC -.->|optional OTLP 4317| OTel["OpenTelemetry Collector"]
    KVC -->|POSIX FS| PVC["Shared KV-cache PVC"]

    %% Go libraries
    KVC -->|ZeroMQ| ZMQ["go-zeromq/zmq4 v0.17.0"]
    KVC -->|KVEvent codec| MsgPack["msgpack/v5 v5.4.1"]
    KVC -->|block hash input| CBOR["fxamacker/cbor v2.9.2"]
    KVC -->|in-memory index| Ristretto["ristretto v2.4.0 / golang-lru v2.0.7"]
    KVC -.->|optional backend| GoRedis["go-redis v9.20.0"]
    KVC -->|UDS client| GRPCGo["grpc-go v1.81.1"]
    KVC -->|tracing| OTelGo["otel v1.44.0"]
    KVC -->|metrics| Prom["prometheus client_golang v1.23.2"]
    KVC -.->|examples only| CR["controller-runtime v0.21.0"]

    %% Python libraries (tokenizer)
    KVC -->|rendering| VLLMPy["vllm 0.18.0+rhaiv.4"]
    KVC -->|tokenizers| Transformers["transformers 4.57.6 / tiktoken 0.12.0"]
    KVC -->|download| HFHub["huggingface-hub 0.36.2"]
    KVC -->|gRPC server| GRPCPy["grpcio 1.80.0"]
    KVC -->|health probe| AIOHTTP["aiohttp 3.13.5"]
    KVC -->|transitive via vLLM| Torch["torch 2.10.0"]

