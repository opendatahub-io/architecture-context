graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>MaaS API consumer"]
    end

    subgraph Ingress["INGRESS - Namespace: openshift-ingress"]
        Gateway["maas-default-gateway Envoy<br/>Istio / OSSM 3<br/>443/TCP HTTPS, gateway TLS<br/>labels gateway.istio.io/managed"]
        Kuadrant["Kuadrant Wasm plugin<br/>Authorino AuthN / Limitador"]
    end

    subgraph ExtProcNS["CLUSTER INTERNAL - Namespace: openshift-ingress (non-mesh, NetworkPolicy enforced)"]
        direction TB
        Pre["payload-pre-processing<br/>SA: payload-processing<br/>gRPC 9004/TCP TLS 1.2/1.3<br/>Secret: payload-pre-processing-tls"]
        Post["payload-processing<br/>SA: payload-processing<br/>gRPC 9004/TCP TLS 1.2/1.3<br/>Secret: payload-processing-tls"]
        HealthPort["gRPC health 50052/TCP<br/>plaintext, no auth<br/>not in NetworkPolicy allow-list"]
        MetricsSvc["payload-processing-metrics<br/>9090/TCP HTTP plaintext<br/>/metrics: TokenReview + SAR<br/>/healthz: open"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API server<br/>443/6443 TCP HTTPS"]
        DNS["Cluster DNS<br/>53/5353 UDP/TCP"]
        Prom["Prometheus prometheus-k8s<br/>redhat-ods-monitoring /<br/>openshift-monitoring /<br/>openshift-user-workload-monitoring"]
        Kubelet["kubelet probes"]
        ServiceCA["OpenShift service-ca"]
    end

    subgraph Backends["MODEL BACKENDS"]
        LLMISVC["KServe LLMInferenceService<br/>backend port, HTTP/HTTPS"]
    end

    subgraph Optional["OPTIONAL EGRESS (not configured in shipped ODH chains)"]
        Sub["Filter subrequests<br/>AWS SigV4 upstreams, Postgres store,<br/>guardrails - 443/TCP HTTPS"]
    end

    Client -->|HTTPS/443<br/>TLS gateway cert<br/>API key / Bearer| Gateway
    Gateway -->|"1: gRPC ext_proc/9004<br/>TLS SIMPLE, ALPN h2, SNI+SAN pinned<br/>service-CA trust, no client auth<br/>fail-closed, CB max 8"| Pre
    Gateway -->|in-process| Kuadrant
    Gateway -->|"2: gRPC ext_proc/9004<br/>TLS SIMPLE, service-CA<br/>fail-closed, CB max 8"| Post
    Gateway -->|HTTP/HTTPS<br/>credentials stripped| LLMISVC
    Prom -->|HTTP/9090 plaintext<br/>Bearer SA token| MetricsSvc
    MetricsSvc -->|HTTPS/443 or 6443<br/>TLS OpenSSL<br/>Pod SA token<br/>TokenReview + SAR| K8sAPI
    Kubelet -->|gRPC health/50052<br/>plaintext| HealthPort
    Post -->|DNS 53| DNS
    Post -.->|HTTPS/443<br/>rustls + OpenSSL provider<br/>SigV4 / client cert| Sub
    ServiceCA -.->|serving-cert Secrets| Pre
    ServiceCA -.->|serving-cert Secrets| Post

