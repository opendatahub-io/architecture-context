graph LR
    %% ogx-distribution dependency graph. Source: architecture/rhoai-3.7-ea.1/ogx-distribution.md
    OGX["ogx-distribution<br/>odh-ogx-core-rhel9"]

    %% Core packaged dependency
    OGX -->|"packages (API server)"| OGXPkg["ogx / ogx-api<br/>1.4.1+rhaiv.0<br/>opendatahub-io fork"]

    %% Required runtime
    OGX -->|"KV + SQL state (required)"| PG["PostgreSQL<br/>asyncpg 0.32.0"]
    OGX -->|"inference (at least one)"| VLLM["KServe / vLLM (RHAIIS)"]
    OGX -.->|"inference (CI)"| MaaS["Models-as-a-Service"]
    OGX -.->|"inference (optional)"| LLMAPIs["OpenAI, Anthropic, Azure,<br/>Bedrock, Vertex AI, Gemini, watsonx"]

    %% Optional runtime
    OGX -.->|vector_io| VDB["Milvus / pgvector / Qdrant<br/>pymilvus 3.0.2, qdrant-client 1.20.0"]
    OGX -.->|file storage| S3["AWS S3 / S3-compatible<br/>boto3"]
    OGX -.->|web search| Search["Brave / Tavily"]
    OGX -.->|remote tools| MCP["MCP servers"]
    OGX -.->|JWT validation| OIDC["OIDC issuer / JWKS<br/>pyjwt 2.15.1"]
    OGX -.->|traces + metrics| OTel["OTLP collector"]
    OGX -.->|"doc conversion (dependency-only)"| Docling["Docling-serve"]
    OGX -.->|"inline (dependency-only)"| Torch["torch 2.13 / docling 2.145 /<br/>sentence-transformers 6.2"]

    %% Build-time
    OGX -->|base image| AIPCC["AIPCC cpu-torch2.13-el9.8<br/>+ RHEL AI PyPI"]
    OGX -->|build stage| Modelcar["modelcar-redhatai-ogx-distribution:3.0"]
    Konflux["Konflux-central<br/>multi-arch pipeline"] -->|builds 4 arches| OGX

    %% Consumers / integrations
    Operator["OGX Operator"] -->|"deploys, reads OCI labels"| OGX
    Prom["Platform Prometheus"] -->|ServiceMonitor scrape| OGX
    Praxis["Praxis proxy<br/>(test evidence)"] -.->|tenant headers| OGX

