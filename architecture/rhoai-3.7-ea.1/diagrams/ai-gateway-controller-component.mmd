graph TB
    subgraph AGC["ai-gateway-controller (Deployment, ns: opendatahub, replicas: 1)"]
        direction TB
        Manager["manager (cmd/manager)<br/>controller-runtime<br/>:8443 metrics HTTPS / :8081 health"]

        TenantR["Tenant reconciler<br/>pkg/tenant<br/>primary: MaasTenantConfig"]
        ModelR["ExternalModel reconciler<br/>pkg/controller"]
        ProviderR["ExternalProvider reconciler<br/>pkg/controller"]
        PortalR["Consumer portal reconciler<br/>pkg/consumerportal"]
        GuardR["AIGuardrail reconciler<br/>pkg/guardrail"]
        Render["Render pipeline (pkg/render)<br/>krusty build → post-render → SSA<br/>field owner: ai-gateway-controller"]
        Manifests[("Vendored manifests<br/>/config/manifests<br/>praxis-extproc, external-model, consumer-portal")]

        Manager --> TenantR
        Manager --> ModelR
        Manager --> ProviderR
        Manager --> PortalR
        Manager --> GuardR
        TenantR --> Render
        PortalR --> Render
        Render -->|reads| Manifests
    end

    %% Watched CRs
    MTC["MaasTenantConfig / AITenant CR<br/>maas.opendatahub.io"]
    SubRef["MaaSSubscription / MaaSModelRef CR<br/>maas.opendatahub.io"]
    EM["ExternalModel CR<br/>inference.opendatahub.io/v1alpha1"]
    EP["ExternalProvider CR<br/>inference.opendatahub.io/v1alpha1"]
    AIG["AIGuardrail CR<br/>aigateway.opendatahub.io/v1alpha1"]
    Nemo["NemoGuardrails CR<br/>trustyai.opendatahub.io"]
    DSCI["DSCInitialization CR"]

    MaaSCtrl["maas-controller"] -->|writes + payload-processing-status CAS| MTC
    User["Platform Admin / Model Owner"] -->|creates| EM
    User -->|creates| EP
    User -->|creates| AIG

    MTC -->|watched by| TenantR
    SubRef -->|watched by| TenantR
    EM -->|watched by| ModelR
    EP -->|watched by| ProviderR
    AIG -->|watched by| GuardR
    Nemo -->|validated against| GuardR
    DSCI -->|applicationsNamespace| PortalR
    GuardR -.->|Accepted policies compiled by| TenantR

    %% Created resources
    subgraph GwNS["Gateway namespace (openshift-ingress)"]
        PreProc["payload-pre-processing[-tenant]<br/>praxis-extproc Deployment<br/>gRPC 9004/TCP TLS"]
        PostProc["payload-processing[-tenant]<br/>praxis-extproc Deployment<br/>gRPC 9004/TCP TLS"]
        EnvoyF["EnvoyFilters<br/>fail-closed ExtProc"]
        GwDR["DestinationRules<br/>TLS SIMPLE / SNI"]
        GwMisc["NetworkPolicies, HPAs,<br/>ServiceMonitors, ConfigMaps"]
    end

    subgraph TenantNS["Tenant / model namespace"]
        EMProc["payload-processing-external-model<br/>praxis-extproc Deployment<br/>gRPC 9004/TCP TLS"]
        Routes["Per-model HTTPRoutes<br/>overlay ConfigMaps"]
        Transport["provider-&lt;name&gt; ExternalName Service<br/>ServiceEntry"]
        Cred["agc-cred-&lt;hash12&gt;<br/>credential copies"]
    end

    subgraph InfraNS["Tenant infra namespace"]
        AuthProxy["maas-consumer-portal-auth-proxy<br/>kube-auth-proxy OIDC<br/>HTTPS 4180/TCP"]
        PortalPol["Portal HTTPRoutes, ReferenceGrant,<br/>Kuadrant AuthPolicies"]
    end

    TenantR -->|SSA| PreProc
    TenantR -->|SSA| PostProc
    TenantR -->|SSA| EnvoyF
    TenantR -->|SSA| GwMisc
    TenantR -->|SSA| EMProc
    ModelR -->|creates| Routes
    ModelR -->|copies| Cred
    ProviderR -->|creates| Transport
    ProviderR -->|creates| GwDR
    PortalR -->|creates| AuthProxy
    PortalR -->|creates| PortalPol
    ModelR -.->|reads pod logs<br/>serving revision| EMProc

    %% Dependencies
    K8s["Kubernetes API<br/>6443/TCP HTTPS"]
    Istio["Istio Gateway<br/>networking.istio.io"]
    Kuadrant["Kuadrant / Authorino"]
    Operator["ai-gateway-operator"]

    Operator -->|deploys| AGC
    Manager -->|watch / SSA / TokenReview| K8s
    EnvoyF -->|configures| Istio
    PortalPol -->|enforced by| Kuadrant

    style Manager fill:#4a90e2,color:#fff
    style TenantR fill:#4a90e2,color:#fff
    style ModelR fill:#4a90e2,color:#fff
    style ProviderR fill:#4a90e2,color:#fff
    style PortalR fill:#4a90e2,color:#fff
    style GuardR fill:#4a90e2,color:#fff
    style Render fill:#4a90e2,color:#fff
    style MTC fill:#f5a623
    style SubRef fill:#f5a623
    style EM fill:#f5a623
    style EP fill:#f5a623
    style AIG fill:#f5a623
    style Nemo fill:#f5a623
    style DSCI fill:#f5a623
    style MaaSCtrl fill:#7ed321
    style Operator fill:#7ed321
    style K8s fill:#e8e8e8
    style Istio fill:#e8e8e8
    style Kuadrant fill:#e8e8e8
