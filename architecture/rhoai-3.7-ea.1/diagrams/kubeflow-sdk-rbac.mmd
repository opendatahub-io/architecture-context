graph TD
    subgraph Identity["Caller identity (SDK ships NO RBAC, SA or bindings)"]
        Caller["User kubeconfig identity<br/>or workbench pod ServiceAccount"]
    end

    subgraph Binding["Bindings (provisioned by platform / admin, not SDK)"]
        NSRole["Namespace Role / RoleBinding<br/>(e.g. Data Science Project edit)"]
        ClusterRead["Cluster-scoped read<br/>(ClusterTrainingRuntimes)"]
    end

    subgraph Resources["API resources required for full SDK functionality"]
        TrainJobs["trainer.kubeflow.org<br/>trainjobs"]
        TRuntimes["trainer.kubeflow.org<br/>trainingruntimes"]
        CTRuntimes["trainer.kubeflow.org<br/>clustertrainingruntimes (cluster)"]
        Katib["kubeflow.org<br/>experiments, trials"]
        SparkRes["sparkoperator.k8s.io<br/>sparkconnects, sparkapplications"]
        Pods["core<br/>pods, pods/log, events"]
        Secrets["core<br/>secrets (RHAI Data Connections)"]
        CM["core<br/>configmaps (kubeflow-trainer-public<br/>in KUBEFLOW_SYSTEM_NAMESPACE)"]
        PF["core<br/>pods/portforward (off-cluster Spark)"]
    end

    subgraph PodAuth["In-pod auth created by SDK-generated code"]
        Projected["Projected SA token<br/>-> Trainer status endpoint (Bearer)"]
        MetricsNoAuth["Metrics server :28080<br/>NO AUTH"]
    end

    Caller -->|bound via| NSRole
    Caller -->|bound via| ClusterRead
    NSRole -->|create, get, list, watch, delete| TrainJobs
    NSRole -->|get, list| TRuntimes
    ClusterRead -->|get, list| CTRuntimes
    NSRole -->|create, get, list, watch, delete| Katib
    NSRole -->|create, get, list, watch, delete| SparkRes
    NSRole -->|get, list| Pods
    NSRole -->|get - key names only| Secrets
    NSRole -->|get - cross-namespace, failure non-fatal| CM
    NSRole -->|create| PF

