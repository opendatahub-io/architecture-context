graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Inference Client"]
    end

    subgraph Ingress["PLATFORM INGRESS (managed by KServe / odh-model-controller, not this repo)"]
        Gateway["Route / Gateway / auth proxy<br/>443/TCP HTTPS<br/>Bearer token when auth enabled"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB
        Prom["Prometheus<br/>user-workload monitoring"]
        KCtrl["KServe Controller<br/>(no runtime API access needed)"]

        subgraph NS_User["Namespace: user namespace"]
            Svc["isvc-predictor Service<br/>ClusterIP 80/TCP → 8080"]
            subgraph Pod["Predictor Pod (runAsNonRoot, drop ALL, UID 1001)"]
                Init["storage-initializer"]
                Server["autogluonserver<br/>REST 8080/TCP plaintext, no auth<br/>gRPC 8081/TCP insecure, not exposed"]
                Vol[("/mnt/models<br/>untrusted pickles")]
            end
            Secret["Storage credentials secret<br/>AWS_*, AZ_CLIENT_SECRET, GIT_PASSWORD<br/>kserve-hdfscreds"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible storage<br/>443/TCP HTTPS TLS<br/>AWS keys / IAM<br/>S3_VERIFY_SSL, AWS_CA_BUNDLE"]
        GCSAz["GCS / Azure Blob/File<br/>443/TCP HTTPS TLS<br/>SA / Azure client secret"]
        Other["HDFS / WebHDFS / HTTP(S) / Git<br/>port varies, scheme-dependent TLS"]
    end

    Client -->|"HTTPS/443<br/>TLS (platform)<br/>Bearer token (if enabled)"| Gateway
    Gateway -->|"HTTP/80<br/>platform/mesh-dependent"| Svc
    Svc -->|"HTTP/8080<br/>plaintext<br/>no auth"| Server
    Prom -->|"HTTP/8080 /metrics<br/>plaintext, no auth"| Server
    KCtrl -.->|"creates pod (K8s API, TLS)"| Pod
    Secret -.->|env / volume injection| Init
    Secret -.->|env injection| Server
    Init -->|"HTTPS/443<br/>TLS<br/>storage creds"| S3
    Init -->|HTTPS/443 TLS| GCSAz
    Init -->|scheme-dependent| Other
    Server -.->|"HTTPS/443 (remote model_dir only)"| S3
    Init -->|write| Vol
    Vol -->|"unpickle (code exec risk)"| Server

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class Svc,Init,Prom,KCtrl internal
    class Server,Vol,Secret risk
    class S3,GCSAz,Other externalservice
