graph LR
    PC["pipelines-components<br/>kfp-components 1.11.0"]

    %% External libraries
    PC -->|define/compile| KFPSDK["kfp / kfp-kubernetes<br/>2.18.0 init, 2.17.0 autorag"]
    PC -->|K8s API access| K8sClient["kubernetes client<br/>37.0.1 / 36.0.3"]
    PC -->|fine-tuning| TrainerSDK["kubeflow Trainer SDK<br/>packages_to_install"]
    PC -->|AutoML| AutoGluon["AutoGluon<br/>1.6.3+rhaiv.2"]
    PC -->|AutoRAG| AI4RAG["ai4rag 0.25.4"]
    PC -->|extraction| Docling["docling-core / slim / ibm-models"]
    PC -->|model execution| Torch["torch 2.13.0<br/>transformers 5.22.1"]
    PC -->|LLM orchestration| LangChain["langchain 1.4.7<br/>openai 2.53.0"]
    PC -->|vector client| PyMilvus["pymilvus 3.0.2"]
    PC -->|object storage| Boto3["boto3 >=1.42"]
    PC -->|SDG| SDGHub["sdg-hub >=0.7.0"]
    PC -->|agent server| FastAPI["fastapi 0.162.0<br/>uvicorn 0.54.0"]

    %% Build-time
    AIPCC["AIPCC base<br/>cpu-torch2.13-el9.8"] -.->|base image| PC
    UBI["UBI 9 python-312<br/>non-AIPCC"] -.->|init image base| PC
    Modelcars["RHAI modelcars<br/>ogx-distribution, whisper-tiny"] -.->|build-time copy| PC
    OpenShell["OpenShell sandbox<br/>odh-openshell-sandbox-rhel9"] -.->|starter-kit base| PC

    %% Platform integration (consumers)
    ODHOp["opendatahub-operator"] -->|RELATED_IMAGE_* pins| DSPO["DSPO"]
    DSPO -->|init container + env| PC
    KFP["KFP API server / Argo"] -->|registers + executes| PC

    %% Platform dependencies
    PC -->|ISVC / ServingRuntime CRUD| KServe["KServe"]
    PC -->|HardwareProfile read| HWP["ODH infrastructure"]
    PC -->|TrainerClient jobs| Trainer["Kubeflow Trainer"]
    PC -->|ray.io CRDs| KubeRay["KubeRay"]
    PC -->|REST, plain HTTP| MR["Model Registry"]
    PC -->|REST/CRD| EvalHub["EvalHub / TrustyAI"]
    PC -->|HTTPS tracking| MLflow["MLflow"]
    PC -->|OpenAI-compatible REST| MaaS["MaaS"]
    PC -.->|secret convention| Connections["RHOAI Connections API"]

    %% External services
    PC -->|HTTPS 443| K8sAPI["Kubernetes API"]
    PC -->|HTTPS 443| S3["S3-compatible storage"]
    PC -->|HTTPS 443| HF["Hugging Face Hub"]
    PC -->|gRPC 19530 / PG 5432| VDB["Milvus / PGVector"]
    PC -->|HTTPS 443| OCI["OCI registry"]

