graph TB
    subgraph Repo["notebooks repository - rhoai-3.7-ea.1 (container image product, no operator)"]
        direction TB

        subgraph Jupyter["Jupyter workbench images (port 8888)"]
            JMin["jupyter-minimal<br/>CPU / CUDA 13.0 / ROCm 7.14<br/>JupyterLab 4.5 + Server 2.21"]
            JDS["jupyter-datascience (CPU)<br/>Elyra 5.0.3, Kale, KFP 2.18,<br/>CodeFlare 0.40.1, Ray, Feast, MLflow"]
            JPT["jupyter-pytorch (CUDA)<br/>torch 2.13 / CUDA 13.0"]
            JLLM["jupyter-pytorch-llmcompressor (CUDA)<br/>llmcompressor 0.14, lm-eval"]
            JTF["jupyter-tensorflow (CUDA)<br/>tensorflow 2.21 / CUDA 12.9"]
            JUni["jupyter-universal (CPU)<br/>dual-mode entrypoint-universal.sh<br/>workbench OR runtime"]
        end

        subgraph CodeServer["code-server workbench images"]
            CSDS["codeserver-datascience (CPU)<br/>code-server v4.122.1"]
            CSMin["codeserver-minimal (CPU)"]
            subgraph CSPod["in-pod process topology"]
                Nginx["nginx :8888<br/>public listener, NB_PREFIX routing"]
                CSBackend["code-server :8787<br/>--auth none, bound 0.0.0.0"]
                Httpd["httpd CGI :8080<br/>culler /api/kernels/"]
            end
        end

        subgraph Runtimes["Pipeline runtime images (headless, no port)"]
            RT["runtime-minimal / datascience /<br/>pytorch / pytorch-llmcompressor / tensorflow<br/>Elyra bootstrapper.py"]
        end

        subgraph Manifests["manifests/rhoai (kustomize)"]
            IS["24 ImageStreams<br/>N...N-5 tags<br/>19 marked deprecated"]
            CMParams["ConfigMap<br/>notebook-image-params"]
            CMCommit["ConfigMap<br/>notebook-image-commithash"]
        end

        subgraph BuildStages["Build-time components (not shipped as services)"]
            Mongocli["mongocli<br/>Go, CGO strictfipsruntime"]
            Addons["JupyterLab addons<br/>RHOAI branding"]
            BuildInputs["scripts/buildinputs<br/>Go CI helper"]
        end
    end

    JMin -->|"layer rebuilt in"| JDS
    JDS -->|"layer rebuilt in"| JPT
    JPT -->|"layer rebuilt in"| JLLM
    JDS -->|"layer rebuilt in"| JTF
    JDS -->|"layer rebuilt in"| JUni
    Mongocli -->|"copied into"| JDS
    Addons -->|"applied at build"| JMin
    CSDS --- CSPod
    CSMin --- CSPod
    Nginx -->|"proxy /codeserver/"| CSBackend
    Nginx -->|"proxy /api/kernels/"| Httpd
    Httpd -->|"/healthz"| CSBackend
    CMParams -->|"replacements: image digests"| IS
    CMCommit -->|"replacements: build commit"| IS

    %% External platform actors
    AIPCC["AIPCC base images<br/>quay.io/aipcc/base-images/*-el9.8"]
    Konflux["Konflux hermetic builds<br/>15 pipelines"]
    Operator["rhods-operator<br/>workbenches component"]
    NBC["ODH notebook controller<br/>Notebook CR to StatefulSet"]
    Dashboard["odh-dashboard"]
    DSP["Data Science Pipelines"]
    Quay["quay.io/rhoai / registry.redhat.io"]

    AIPCC -->|"FROM BASE_IMAGE"| Jupyter
    AIPCC -->|"FROM BASE_IMAGE"| CodeServer
    AIPCC -->|"FROM BASE_IMAGE"| Runtimes
    Konflux -->|"builds and pushes"| Quay
    Operator -->|"applies + patches params-latest.env"| Manifests
    Dashboard -->|"reads notebook-image labels"| IS
    DSP -->|"runs runtime-* as pipeline nodes"| RT
    NBC -->|"launches pod, injects NOTEBOOK_ARGS"| Jupyter
    NBC -->|"launches pod, injects NB_PREFIX"| CodeServer
    IS -->|"references"| Quay

