graph TD
    subgraph Identity["Identity (no ServiceAccount shipped)"]
        User["Invoking user<br/>kubeconfig credentials<br/>(bearer / client cert / OIDC)"]
    end

    subgraph Bindings["Bindings"]
        UB["User's existing RoleBindings /<br/>ClusterRoleBindings<br/>(odh-cli ships none)"]
    end

    subgraph Preflight["Pre-flight"]
        SSAR["SelfSubjectAccessReview<br/>pkg/util/kube/rbac/check.go:60<br/>(RHBOK and other migrations)"]
    end

    subgraph Commands["Commands and required access"]
        Lint["lint<br/>read-only (client.Reader)"]
        Migrate["migrate run<br/>--dry-run, confirmation / --yes"]
        Deps["deps install (hidden)<br/>--dry-run"]
    end

    subgraph ReadResources["Read access (lint, diagnose)"]
        R1["30+ platform API groups<br/>DSC/DSCI, DSPA, KServe, Ray,<br/>Training/Trainer, Kueue, TrustyAI,<br/>CodeFlare, LlamaStack/OGX, Dashboard,<br/>Kuadrant/Authorino, Gateway API"]
        R2["operators.coreos.com / olm.operatorframework.io<br/>CSV, Subscription, ClusterExtension"]
        R3["config.openshift.io / image.openshift.io"]
    end

    subgraph WriteResources["Write access (typically cluster-admin)"]
        W1["core<br/>Namespaces"]
        W2["operators.coreos.com<br/>OperatorGroups, Subscriptions"]
        W3["olm.operatorframework.io<br/>ClusterExtensions"]
        W4["datasciencecluster / dscinitialization<br/>DSC, DSCI"]
        W5["serving.kserve.io<br/>InferenceServices"]
        W6["rbac.authorization.k8s.io<br/>Roles, RoleBindings"]
        W7["Workload CRs<br/>Notebooks, Kueue, Ray, Training, TrustyAI"]
        W8["core<br/>pods/exec"]
    end

    User -->|bound via| UB
    User -->|checks own perms| SSAR
    UB --> Lint
    UB --> Migrate
    UB --> Deps

    Lint -->|get, list| R1
    Lint -->|get, list| R2
    Lint -->|get, list| R3
    Migrate -->|get, list, patch, update| W4
    Migrate -->|get, list, patch| W5
    Migrate -->|get, update, create| W6
    Migrate -->|get, list, create, patch, delete| W7
    Migrate -->|create| W8
    Deps -->|create, get| W1
    Deps -->|create, get, list| W2
    Deps -->|create, get, list| W3
    Deps -->|get, list, watch| R2

