graph TB
    subgraph External["EXTERNAL / USER ACCESS (Untrusted)"]
        User["User / Workbench<br/>Kubeflow Training SDK, oc"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        KAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC"]
        APIServerCfg["APIServer/cluster<br/>tlsSecurityProfile"]
    end

    subgraph NS_ODH["Namespace: opendatahub (no Istio sidecar)"]
        subgraph OpPod["Pod: kubeflow-training-operator, SA: kubeflow-training-operator, UID 65532"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS<br/>TLS cluster profile<br/>self-signed CA, no client certs"]
            Metrics["Metrics<br/>8080/TCP HTTP<br/>NO TLS, NO AUTH"]
            Probes["Probes<br/>8081/TCP HTTP<br/>/healthz /readyz"]
            Controllers["6 Job Reconcilers<br/>+ cert-controller rotator"]
        end
        Svc["Service kubeflow-training-operator<br/>ClusterIP 443/TCP → 9443<br/>metrics port removed in RHOAI"]
        Secret["Secret kubeflow-training-operator-webhook-cert<br/>CA + TLS key, auto-rotated"]
    end

    subgraph NS_Mon["Namespace: openshift-monitoring"]
        Prom["Prometheus<br/>PodMonitor"]
    end

    subgraph NS_User["User namespaces (tenant boundary)"]
        subgraph PyT["PyTorchJob pods: NetworkPolicy intra-job + monitoring:8080"]
            PTMaster["Master Pod<br/>23456/TCP"]
            PTWorker["Worker Pods<br/>init: nslookup 53/UDP"]
        end
        subgraph Others["TFJob / MPIJob / XGBoost / Paddle / JAX pods: NO NetworkPolicy"]
            OtherPods["Replica Pods<br/>framework ports e.g. TF 2222<br/>plaintext TCP"]
            Launcher["MPI Launcher<br/>SA: mpijob-launcher<br/>Role: pods/exec"]
        end
    end

    Kubelet["Kubelet"]

    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Bearer token<br/>RBAC training-edit"| KAPI
    KAPI -->|"HTTPS/443 → 9443<br/>TLS cluster profile<br/>caBundle server verify<br/>failurePolicy Fail"| Svc
    Svc --> Webhook
    Controllers -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>ClusterRole"| KAPI
    Controllers -->|"GET at startup"| APIServerCfg
    Controllers -->|"update via namespaced Role"| Secret
    Secret -.->|"mounted read-only"| Webhook
    Prom -->|"HTTP/8080<br/>plaintext<br/>no auth"| Metrics
    Kubelet -->|"HTTP/8081"| Probes
    PTWorker -->|"TCP/23456<br/>plaintext<br/>no auth"| PTMaster
    Launcher -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>launcher SA token<br/>pods/exec"| KAPI
    Prom -.->|"TCP/8080 allowed by NetworkPolicy"| PTMaster

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef secret fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef tenant fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class KAPI,APIServerCfg,Kubelet control
    class Webhook,Probes,Controllers,Svc,Prom operator
    class Metrics,OtherPods risk
    class Secret secret
    class PTMaster,PTWorker,Launcher tenant
