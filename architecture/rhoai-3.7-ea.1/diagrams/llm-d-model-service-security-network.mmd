graph TB
    subgraph External["EXTERNAL / USERS"]
        User["User / llm-d-deployer<br/>kubectl"]
        Client["Inference Client"]
    end

    subgraph Ingress["INGRESS (Gateway, external to component)"]
        Gateway["Gateway<br/>listener port/TLS per Gateway<br/>HTTPRoute parentRefs"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph NS_Ctrl["Namespace: modelservice-system"]
        Ctrl["modelservice-controller-manager<br/>SA: modelservice-controller-manager<br/>Probes :8081 HTTP unauthenticated<br/>Metrics :8443 HTTPS"]
        MetricsSvc["modelservice-controller-manager-metrics-service<br/>ClusterIP 8443/TCP<br/>TLS self-signed default"]
    end

    subgraph NS_Tenant["Namespace: ModelService namespace (tenant)"]
        EPP["EPP Pod<br/>SA: msvc-epp-sa<br/>9002 gRPC / 9003 health / 9090 metrics"]
        Decode["Decode Pods<br/>vLLM + routing sidecar<br/>8000/TCP HTTP"]
        Prefill["Prefill Pods<br/>vLLM<br/>8000/TCP HTTP"]
        HFSecret["Secret: authSecretName<br/>HF_TOKEN"]
    end

    subgraph Monitoring["MONITORING"]
        Prom["Prometheus"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace / OCI registries<br/>HTTPS 443"]
    end

    User -->|HTTPS/6443<br/>TLS 1.2+<br/>User creds + RBAC| API
    Ctrl -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>manager-role + EPP_CLUSTER_ROLE cluster-wide| API
    Prom -->|HTTPS/8443<br/>TLS self-signed<br/>Bearer token| MetricsSvc
    MetricsSvc --> Ctrl
    Ctrl -.->|TokenReview + SAR| API
    Client -->|HTTP/HTTPS<br/>per Gateway| Gateway
    Gateway -->|gRPC ext-proc/9002<br/>plaintext, no auth| EPP
    Gateway -->|HTTP/8000<br/>plaintext, no auth| Decode
    Decode -->|HTTP/8000 + NIXL 5557<br/>plaintext, no auth| Prefill
    HFSecret -.->|secretKeyRef| Decode
    HFSecret -.->|secretKeyRef| Prefill
    Decode -->|HTTPS/443<br/>HF_TOKEN| HF
    Prefill -->|HTTPS/443<br/>HF_TOKEN| HF

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User,Client external
    class Gateway ingress
    class API control
    class Ctrl,MetricsSvc,Prom internal
    class EPP,Decode,Prefill risk
    class HFSecret,HF externalservice
