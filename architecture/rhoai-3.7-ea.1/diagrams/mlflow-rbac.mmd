graph TD
    Note["No RBAC manifests in this repo.<br/>Roles and bindings are defined by the MLflow Operator."]

    subgraph ServerIdentity["Server identity (operator-defined)"]
        SA["MLflow server ServiceAccount"]
        SARole["Operator ClusterRole for server"]
    end

    subgraph ServerResources["Kubernetes API resources"]
        SSAR["authorization.k8s.io<br/>selfsubjectaccessreviews"]
        NS["core<br/>namespaces"]
        MC["mlflow.kubeflow.org (operator CRD)<br/>mlflowconfigs"]
    end

    subgraph UserIdentity["Caller identity (per request)"]
        User["User / SDK token<br/>(Bearer, forwarded by gateway)"]
        UserRB["Namespace RoleBindings<br/>(platform-managed)"]
        UserRole["Operator user-facing roles"]
    end

    subgraph Pseudo["mlflow.kubeflow.org pseudo-resources (not CRDs)"]
        PR["experiments, runs, registered models,<br/>prompts, artifacts, ... per workspace"]
    end

    SA -->|bound via ClusterRoleBinding| SARole
    SARole -->|create| SSAR
    SARole -->|list, watch| NS
    SARole -->|get, list, watch| MC

    User -->|bound via| UserRB
    UserRB -->|grants| UserRole
    UserRole -->|verbs checked by SSAR| PR

    Plugin["kubernetes-auth plugin"] -->|SSAR with caller token| PR

    style Note fill:#fff2cc,stroke:#d6b656
    style SA fill:#4a90e2
    style User fill:#4a90e2
    style SARole fill:#f5a623
    style UserRole fill:#f5a623
    style UserRB fill:#f5a623
    style SSAR fill:#7ed321
    style NS fill:#7ed321
    style MC fill:#7ed321
    style PR fill:#7ed321
    style Plugin fill:#4a90e2
