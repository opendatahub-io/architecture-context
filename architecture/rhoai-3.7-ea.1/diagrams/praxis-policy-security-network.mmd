graph TB
    subgraph External["EXTERNAL / CALLERS (Untrusted)"]
        Agent["AI Agent / Client<br/>Bearer JWT (DPoP optional) or API key"]
    end

    subgraph HostZone["HOST PROCESS: Praxis proxy (trust boundary owned by host)"]
        Listener["Praxis listener<br/>port / TLS host-defined"]
        subgraph Lib["praxis-policy (embedded, in-process, no listener)"]
            Engine["PolicyEngine<br/>APL + Cedar/CEL/OPA PDPs<br/>fail-closed defaults"]
            Transport["Host HttpTransport<br/>(pingora, host TLS trust)"]
            RedisClient["redis-rs client<br/>rustls (ring), non-FIPS"]
        end
    end

    subgraph Platform["PLATFORM SERVICES (in-cluster or external)"]
        IdP["OIDC IdP (Keycloak)<br/>443/TCP HTTPS<br/>JWKS, RFC 8693, CIBA"]
        Vault["HashiCorp Vault<br/>8200/TCP HTTPS"]
        Limitador["Limitador (experimental)<br/>port configurable, HTTPS"]
        Valkey["Valkey / Redis<br/>6379/TCP RESP over TLS"]
        APIKeyDir["HTTP API-key directory<br/>HTTPS, configurable"]
    end

    subgraph UpstreamZone["UPSTREAM SERVICES"]
        Upstream["Tool / MCP / LLM server<br/>port host-defined"]
    end

    Agent -->|"HTTP(S) / host-defined port<br/>host TLS<br/>Bearer JWT or API key"| Listener
    Listener -->|"in-process hook calls"| Engine
    Engine --> Transport
    Engine --> RedisClient

    Transport -->|"HTTPS/443<br/>TLS (host)<br/>no auth (JWKS)"| IdP
    Transport -->|"HTTPS/443<br/>TLS (host)<br/>client creds + subject token / auth_req_id"| IdP
    Transport -->|"HTTPS/8200<br/>TLS (host)<br/>SA JWT / AppRole then Vault token"| Vault
    Transport -->|"HTTPS/configurable<br/>TLS (host)<br/>no auth"| Limitador
    Transport -->|"HTTPS/configurable<br/>TLS (host)<br/>configurable credential"| APIKeyDir
    RedisClient -->|"RESP/6379<br/>TLS required unless localhost<br/>ACL user/password"| Valkey

    Listener -->|"HTTP(S) / host-defined<br/>host TLS<br/>delegated scoped token"| Upstream

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef host fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef lib fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef upstream fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Agent external
    class Listener host
    class Engine,Transport,RedisClient lib
    class IdP,Vault,Limitador,Valkey,APIKeyDir platform
    class Upstream upstream
