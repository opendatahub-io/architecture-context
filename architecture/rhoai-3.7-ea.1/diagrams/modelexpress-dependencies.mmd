graph LR
    MX["ModelExpress<br/>operator + server"]

    %% Runtime platform dependencies
    MX -->|CRDs, SSA, TokenReview, SAR| K8sAPI["Kubernetes API"]
    MX -->|cluster TLS profile| OCPConfig["OpenShift config API<br/>apiservers.config.openshift.io"]
    MX -->|TLS certs| ServiceCA["OpenShift service-ca"]
    MX -->|ServiceMonitor 8443| Monitoring["OpenShift monitoring"]

    %% Internal ODH integrations
    ODHOp["opendatahub-operator /<br/>rhods-operator"] -->|kustomize overlays/odh<br/>params.env images| MX
    Inference["Inference runtimes<br/>vLLM, SGLang, TRT-LLM,<br/>Dynamo, llm-d, KServe pods"] -->|gRPC 8001<br/>MX client library| MX

    %% Optional backends and external services
    MX -.->|metadata backend<br/>RESP 6379| Redis["Redis<br/>(optional)"]
    MX -->|model download<br/>HTTPS 443| HF["HuggingFace Hub"]
    MX -->|model download<br/>HTTPS 443| NGC["NVIDIA NGC"]
    MX -->|model download<br/>HTTPS 443| S3["S3-compatible storage"]
    MX -.->|disabled in RHOAI image| GCS["Google Cloud Storage"]

    %% Key libraries
    subgraph Libs["Key Rust libraries"]
        Tonic["tonic / prost 0.13"]
        Kube["kube 0.98 / k8s-openapi 0.24"]
        OpenSSL["openssl 0.10 / tokio-openssl 0.6.5<br/>(RHEL OpenSSL, FIPS)"]
        Axum["axum 0.8"]
        Tokio["tokio 1.46+"]
        RedisLib["redis 0.27"]
        ObjStore["reqwest 0.12 / object_store 0.14.1 / hf-hub 0.4.3"]
        Moka["moka 0.12 / secrecy 0.10"]
        PromLib["prometheus-client 0.25 /<br/>metrics-exporter-prometheus 0.18"]
        Rustls["rustls 0.23 + ring<br/>(excluded from Konflux builds)"]
    end
    MX --- Libs

    style MX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333
    style OCPConfig fill:#7ed321,stroke:#333
    style ServiceCA fill:#7ed321,stroke:#333
    style Monitoring fill:#7ed321,stroke:#333
    style ODHOp fill:#7ed321,stroke:#333
    style Inference fill:#7ed321,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style HF fill:#f5a623,stroke:#333
    style NGC fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#eee,stroke:#999,stroke-dasharray: 5 5
    style Rustls fill:#eee,stroke:#999,stroke-dasharray: 5 5
