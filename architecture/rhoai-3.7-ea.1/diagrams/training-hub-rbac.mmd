graph TD
    subgraph Library["training-hub (in-process library)"]
        TH["training-hub<br/>No ServiceAccount<br/>No ClusterRoles / Roles<br/>No Kubernetes API calls"]
    end

    subgraph Hosting["Hosting pod identity (owned by orchestrator)"]
        TJ["TrainJob / PyTorchJob pod<br/>ServiceAccount set by Kubeflow Trainer / KFTO"]
        NB["Workbench pod<br/>ServiceAccount set by Notebook controller"]
    end

    subgraph Creds["Credentials consumed (pod env / credential chain)"]
        OAI["OPENAI_API_KEY<br/>LiteLLM endpoints (GEPA, GRPO)"]
        WB["WANDB_API_KEY<br/>Weights & Biases"]
        AWS["AWS credentials<br/>S3 checkpoint mirroring"]
        HFT["HF_TOKEN<br/>gated models / datasets"]
    end

    TH -->|runs inside| TJ
    TH -->|runs inside| NB
    TJ -->|"env from Secret refs"| Creds
    NB -->|"env from Secret refs"| Creds
    TH -->|reads| OAI
    TH -->|reads| WB
    TH -->|reads| AWS
    TH -->|reads| HFT

    style TH fill:#4a90e2
    style TJ fill:#7ed321
    style NB fill:#7ed321
    style OAI fill:#f5a623
