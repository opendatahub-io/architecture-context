graph TD
    subgraph Identity["Runtime Identity"]
        SA["Host vLLM pod ServiceAccount<br/>(defined by consuming deployment)"]
    end

    subgraph K8sRBAC["Kubernetes RBAC defined by this component"]
        NoRBAC["None<br/>No ClusterRoles, Roles, Bindings or ServiceAccounts<br/>No Kubernetes API calls"]
    end

    subgraph HTTPAuth["HTTP access control for introspection routes"]
        Routes["GET /plugins/llm-d-server-introspection/<br/>config | devices | kv-cache"]
        VllmAuth["vLLM API server auth<br/>--api-key Bearer (optional)"]
        Gateway["Fronting gateway / auth proxy<br/>(deployment-specific)"]
        NetPol["NetworkPolicy on model-server namespace<br/>(deployment-specific)"]
    end

    subgraph AppControls["Application-level data controls"]
        Redact["kv_connector_extra_config values redacted<br/>unless LLM_D_INTROSPECTION_EXPOSE_KV_EXTRA_CONFIG=1"]
    end

    SA -.->|runs plugins in-process| Routes
    SA -.-> NoRBAC
    Gateway -->|may enforce| Routes
    VllmAuth -->|may enforce| Routes
    NetPol -->|may restrict reach| Routes
    Routes -->|/config applies| Redact

    style SA fill:#4a90e2,color:#fff
    style NoRBAC fill:#e8e8e8
    style Routes fill:#f5a623
    style VllmAuth fill:#7ed321
    style Gateway fill:#7ed321
    style NetPol fill:#7ed321
    style Redact fill:#d5e8d4
