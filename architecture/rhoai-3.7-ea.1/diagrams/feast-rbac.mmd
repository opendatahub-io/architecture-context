graph TD
    subgraph SAs["Service Accounts"]
        OpSA["feast-operator-controller-manager<br/>(redhat-ods-applications)"]
        CRSA["feast-{name} SA<br/>(tenant namespace)"]
        DRSA["data-registry SA"]
        AuthGroup["Group: system:authenticated"]
    end

    subgraph Bindings["Bindings"]
        MRB["ClusterRoleBinding<br/>feast-operator-manager-rolebinding"]
        MARB["ClusterRoleBinding<br/>feast-operator-metrics-auth-rolebinding"]
        LERB["RoleBinding<br/>feast-operator-leader-election-rolebinding"]
        TLSRB["ClusterRoleBinding<br/>feast-operator-openshift-tls-profile-reader-binding"]
        CRRB["RoleBinding feast-{name}"]
        DRRB["ClusterRoleBinding<br/>feast-{name}-data-registry-auth-delegator"]
        NSRB["RoleBinding namespace-registry<br/>(feast-configs-registry ns)"]
    end

    subgraph Roles["Roles"]
        MR["ClusterRole<br/>feast-operator-manager-role"]
        MAR["ClusterRole<br/>feast-operator-metrics-auth-role"]
        LER["Role<br/>feast-operator-leader-election-role"]
        TLSR["ClusterRole<br/>feast-operator-openshift-tls-profile-reader"]
        CRR["Role per-CR<br/>TokenReview/SAR, configmaps, pods/exec"]
        AD["ClusterRole<br/>system:auth-delegator"]
        NSR["Role: read feast-configs-registry ConfigMap"]
    end

    OpSA --> MRB --> MR
    OpSA --> MARB --> MAR
    OpSA --> LERB --> LER
    OpSA --> TLSRB --> TLSR
    CRSA --> CRRB --> CRR
    DRSA --> DRRB --> AD
    AuthGroup --> NSRB --> NSR

    subgraph HighRisk["Elevated permissions (manager-role)"]
        Secrets["core: secrets<br/>get, list, watch (cluster-wide)"]
        PodExec["core: pods/exec<br/>create"]
        ClusterRoles["rbac: clusterroles<br/>create, get, list, delete, update, bind"]
        RBACObjs["rbac: clusterrolebindings, rolebindings, roles<br/>create, delete, get, list, update, watch"]
        Namespaces["core: namespaces<br/>create, get, list, update, watch"]
        CustomHost["route.openshift.io: routes/custom-host<br/>create, update"]
    end

    subgraph Standard["Workload management (manager-role)"]
        FS["feast.dev: featurestores (+status, finalizers)<br/>full CRUD"]
        Core["core: configmaps, services, PVCs, pods, serviceaccounts<br/>CRUD; pods/log get"]
        Apps["apps: deployments; batch: cronjobs<br/>CRUD"]
        Scale["autoscaling: HPA; policy: PDB<br/>CRUD"]
        Net["networking.k8s.io: networkpolicies<br/>CRUD"]
        Routes["route.openshift.io: routes<br/>CRUD"]
        Mon["monitoring.coreos.com: servicemonitors<br/>CRUD"]
        DR["dataregistry.opendatahub.io:<br/>registries, namespaces, tables, volumes, generic-tables CRUD;<br/>connections use"]
        Spark["sparkoperator.k8s.io: sparkapplications<br/>create, delete, get"]
        TR["authentication.k8s.io: tokenreviews<br/>create"]
    end

    subgraph ReadOnly["Read-only watches (manager-role)"]
        NB["kubeflow.org: notebooks"]
        ML["mlflow.opendatahub.io: mlflows"]
        API["config.openshift.io: apiservers"]
        CRD["apiextensions.k8s.io: CRDs"]
        OLMr["OLM: catalogsources, operatorconditions,<br/>clustercatalogs, clusterextensions"]
    end

    MR --> HighRisk
    MR --> Standard
    MR -->|get, list, watch| ReadOnly
    MAR -->|create| TRSAR["tokenreviews, subjectaccessreviews"]
    LER -->|CRUD| LERes["configmaps, leases, events"]
    TLSR -->|get, list, watch| APICfg["apiservers.config.openshift.io"]

    subgraph UserRoles["User-facing ClusterRoles"]
        Editor["feast-operator-featurestore-editor-role<br/>featurestores CRUD"]
        Viewer["feast-operator-featurestore-viewer-role<br/>featurestores get, list, watch"]
        MReader["feast-operator-metrics-reader<br/>/metrics get"]
        DRRoles["feast-data-registry-viewer / -editor / -admin<br/>(operator-created, aggregated)"]
    end

