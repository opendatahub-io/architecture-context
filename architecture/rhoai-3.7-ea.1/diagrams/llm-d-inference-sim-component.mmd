graph TB
    subgraph Pod["vllm-sim Pod (sample Deployment / Helm chart)"]
        direction TB
        subgraph Sim["llm-d-inference-sim container (Go, distroless nonroot)"]
            Listener["cmux single-port listener<br/>:8000/TCP (Helm: 8001)<br/>port + rank per DP rank"]
            HTTP["fasthttp server<br/>OpenAI / Anthropic / vllm-omni APIs<br/>admin, health, metrics"]
            GRPC["gRPC server h2c<br/>VllmEngine + reflection<br/>(vLLM engine only)"]
            Engine["pkg/engine<br/>vllm personality / sglang experimental"]
            Simulator["pkg/simulator<br/>request queue, workers, latency model,<br/>LoRA, failure injection, sleep mode"]
            Dataset["pkg/dataset<br/>echo / random / SQLite dataset"]
            KVCache["pkg/kvcache<br/>simulated prefix KV cache"]
            Publisher["ZMQ PUB publisher<br/>default tcp://127.0.0.1:5557"]
            Replayer["ZMQ ROUTER replayer<br/>(optional)"]
            Tokenizer["pkg/tokenizer<br/>simulated or render client"]
            Metrics["pkg/metrics<br/>vLLM-compatible Prometheus metrics<br/>+ fake metrics"]

            Listener -->|non-HTTP/2| HTTP
            Listener -->|HTTP/2 preface| GRPC
            HTTP --> Engine
            GRPC --> Engine
            Engine --> Simulator
            Simulator --> Dataset
            Simulator --> Tokenizer
            Simulator --> KVCache
            Simulator --> Metrics
            KVCache --> Publisher
            KVCache --> Replayer
        end
        Render["vllm-render native sidecar<br/>vllm/vllm-openai-cpu:v0.21.0<br/>localhost:8082"]
    end

    Service["Service vllm-sim<br/>NodePort 8000 / Helm ClusterIP 8001"]
    Ingress["Ingress (Helm, optional)<br/>disabled by default"]

    Client["Client / llm-d router (EPP)"] -->|HTTP or gRPC| Service
    Ingress -.->|optional| Service
    Service --> Listener
    Tokenizer -->|HTTP render via render-url flag| Render
    Render -->|tokenizer files, HF_TOKEN| HF["HuggingFace Hub"]
    Publisher -->|msgpack KV events| KVIndexer["llm-d KV-cache indexer"]
    Publisher -.->|debug| ZMQListener["zmq-listener (Python debug tool)"]
    Prom["Prometheus / EPP metrics scraper"] -->|GET /metrics| Service
    Harness["Test harness"] -->|POST /admin/config| Service
    Dataset -.->|dataset-url flag, optional| DatasetHost["Dataset URL host"]

    DSTool["dataset-tool CLI (offline)"] -->|HTTPS + optional HF_TOKEN| HF
    DSTool -.->|produces SQLite dataset| Dataset
    RouterLib["llm-d-router Go library v0.11.0<br/>kvblock hashing, kvevents types"] -.->|compiled in| KVCache

