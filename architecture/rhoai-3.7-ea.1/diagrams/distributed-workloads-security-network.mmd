graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser"]
        HF["Hugging Face Hub<br/>443/TCP HTTPS<br/>HF_TOKEN optional"]
        S3["S3-compatible storage<br/>443/TCP HTTPS<br/>AWS access key"]
        PyPI["PyPI index<br/>443/TCP HTTPS"]
    end

    subgraph Ingress["INGRESS (Platform-owned, not in this repo)"]
        GW["Workbench Gateway / Route<br/>443/TCP, TLS terminated<br/>OpenShift OAuth / auth proxy"]
        RayRoute["Ray dashboard Route<br/>443/TCP TLS"]
        PromRoute["Prometheus/Thanos Route<br/>443/TCP TLS"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy shipped)"]
        direction TB
        API["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
        DNS["Cluster DNS<br/>53/UDP"]

        subgraph NS_User["Namespace: user namespace"]
            Jupyter["Jupyter Server (universal image)<br/>8888/TCP HTTP, no in-pod TLS<br/>token disabled"]
            Launcher["MPI launcher pod<br/>openshift-uid-exec.sh<br/>/etc/passwd g=u"]
            Worker["MPI worker pods<br/>sshd 2222/TCP<br/>pubkey only, no root, no forwarding"]
        end

        subgraph NS_Test["Namespace: per-test namespace"]
            Tests["E2E tests image<br/>gotestsum + oc"]
        end
    end

    subgraph Demo["DEMO ONLY (user-applied examples, not platform surface)"]
        MinIO["MinIO 9000/9001/9090 TCP HTTP<br/>hardcoded minio/minio creds<br/>Routes 443 edge TLS"]
        NFS["NFS server 2049/TCP, 111/UDP<br/>no auth<br/>anyuid + privileged SCC"]
    end

    Browser -->|HTTPS/443<br/>TLS<br/>OAuth| GW
    GW -->|HTTP/8888<br/>plaintext<br/>upstream-authenticated| Jupyter
    Jupyter -->|HTTPS/6443<br/>TLS 1.2+<br/>Bearer token| API
    Launcher -->|DNS/53 UDP<br/>none| DNS
    Launcher -->|SSH/2222<br/>SSH RSA host key<br/>public key| Worker
    Worker -->|HTTPS/443<br/>TLS<br/>AWS keys / HF token| S3
    Worker -->|HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN| HF
    Tests -->|HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig| API
    Tests -->|HTTPS/443<br/>TLS verify OFF<br/>Bearer| RayRoute
    Tests -->|HTTPS/443<br/>TLS custom CA<br/>Bearer| PromRoute
    Tests -->|HTTPS/443<br/>TLS verify OFF<br/>AWS key| S3
    Tests -->|HTTPS/443<br/>TLS<br/>none| PyPI

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef demo fill:#eeeeee,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class Browser,HF,S3,PyPI external
    class GW,RayRoute,PromRoute ingress
    class API,DNS,Jupyter,Launcher,Worker,Tests internal
    class MinIO,NFS demo
