graph LR
    KO["kueue-operator<br/>openshift-kueue-operator"]
    KCM["kueue-controller-manager<br/>Kueue operand 0.11.z"]
    KO -->|deploys + configures| KCM

    %% External Dependencies
    KO -->|"HARD gate: Issuer + Certificates"| CertManager["cert-manager<br/>cert-manager.io/v1"]
    KO -->|ServiceMonitor, unconditional| PromOp["Prometheus Operator<br/>monitoring.coreos.com/v1"]
    KO -->|install / upgrade| OLM["OLM<br/>channel alpha"]
    KO -.->|framework| LibGo["openshift/library-go"]
    KO -.->|config API types| KueueLib["sigs.k8s.io/kueue v0.10.2"]
    KO -.->|clients| ClientGo["k8s.io/client-go v0.32.3"]

    %% Platform services
    KO -->|"API server 6443"| K8sAPI["Kubernetes API"]
    KCM -->|"API server 6443"| K8sAPI
    Monitoring["OpenShift Monitoring<br/>prometheus-k8s"] -->|"scrape 8443 mTLS + bearer"| KCM

    %% Internal RHOAI consumers
    RHODS["rhods-operator<br/>Kueue integration"] -->|"consumes kueue.x-k8s.io"| KCM

    %% Job frameworks gated by Kueue
    KCM -->|webhook + patch| Training["Kubeflow Training Operator<br/>PyTorch/TF/XGBoost/Paddle/MPI"]
    KCM -->|webhook + patch| KubeRay["KubeRay<br/>RayJob/RayCluster"]
    KCM -->|webhook + patch| CodeFlare["CodeFlare<br/>AppWrapper"]
    KCM -->|webhook + patch| JobSet["JobSet / LeaderWorkerSet"]
    KCM -->|webhook + patch| Batch["batch Job, Pod,<br/>Deployment, StatefulSet"]

    %% Optional
    KCM -.->|ProvisioningRequest| Autoscaler["Cluster Autoscaler"]
    KCM -.->|"HTTPS 6443 kubeconfig"| MultiKueue["MultiKueue remote clusters"]

