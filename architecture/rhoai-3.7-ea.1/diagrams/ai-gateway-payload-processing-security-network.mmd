graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(MaaS API consumer)"]
    end

    subgraph Ingress["INGRESS - Namespace: openshift-ingress"]
        Gateway["MaaS Gateway (Envoy)<br/>maas-default-gateway<br/>443/TCP HTTPS, Gateway TLS"]
        Kuadrant["Kuadrant Wasm plugin<br/>AuthPolicy / rate limit"]
        Route["HTTPRoutes<br/>(per model namespace)<br/>300s timeout"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no mesh mTLS; no NetworkPolicy shipped)"]
        direction TB
        subgraph NS_GW["Namespace: Gateway / release namespace"]
            IPP["payload-processing (IPP)<br/>SA: payload-processing-&lt;release&gt;<br/>ext-proc 9004/TCP gRPC TLS self-signed<br/>health 9005/TCP plaintext<br/>metrics+pprof 9090/TCP HTTP"]
        end
        subgraph NS_Model["Namespace: provider / model namespaces"]
            ExtSvc["Service (ExternalName)<br/>→ provider FQDN"]
            SE["ServiceEntry MESH_EXTERNAL<br/>DestinationRule TLS SIMPLE"]
            Secrets["Provider Secrets<br/>label ipp-managed=true"]
        end
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
        Prom["Prometheus"]
        Kubelet["kubelet probes"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Providers["LLM Providers<br/>OpenAI, Anthropic, Azure OpenAI,<br/>Bedrock, Vertex AI, remote MaaS<br/>443/TCP HTTPS"]
        GoogleOAuth["oauth2.googleapis.com<br/>443/TCP HTTPS"]
        Nemo["NeMo Guardrails (optional)<br/>HTTPS TLS 1.2+"]
        Metering["External metering (optional)<br/>HTTP/HTTPS, no auth"]
    end

    Client -->|HTTPS/443<br/>TLS<br/>MaaS token| Gateway
    Gateway -->|in-process filter| Kuadrant
    Gateway -->|gRPC ext_proc/9004<br/>TLS 1.2+ insecureSkipVerify<br/>No auth, failure_mode_allow false| IPP
    Gateway --> Route
    Route --> ExtSvc
    ExtSvc --> SE
    SE -->|HTTPS/443<br/>TLS origination SIMPLE<br/>API key / SigV4 / OAuth2 bearer| Providers
    IPP -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| K8sAPI
    K8sAPI -.->|watch| Secrets
    IPP -->|HTTPS/443<br/>system trust<br/>SA JWT assertion| GoogleOAuth
    IPP -.->|HTTPS<br/>TLS 1.2+<br/>no auth| Nemo
    IPP -.->|HTTP or HTTPS<br/>no TLS enforcement<br/>no auth| Metering
    Prom -->|HTTP/9090<br/>plaintext<br/>TokenReview + SAR| IPP
    Kubelet -->|gRPC/9005<br/>plaintext<br/>no auth| IPP

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway,Kuadrant,Route ingress
    class IPP,ExtSvc,SE,K8sAPI,Prom,Kubelet internal
    class Secrets secret
    class Providers,GoogleOAuth,Nemo,Metering externalservice
