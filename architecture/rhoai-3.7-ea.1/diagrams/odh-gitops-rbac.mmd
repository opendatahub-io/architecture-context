graph TD
    subgraph SAs["Service Accounts"]
        SAOp["redhat-ods-operator/<br/>rhai-operator-controller-manager"]
        SACM["rhai-cloudmanager-system/<br/>cloud-manager-operator"]
        SAHook["release-ns/<br/>rhai-post-install-hook"]
        SAPre["release-ns/ pre-delete and<br/>pre-upgrade hook SAs"]
        SALoki["ai-grid-o11y/<br/>usage-logs-reader, usage-logs-writer"]
        SABoot["grid-enrollment-ca-bootstrap"]
        SAGridOp["grid-operator"]
    end

    subgraph Bindings["Bindings"]
        CRBOp["CRB rhai-operator-rolebinding"]
        CRBCM["CRB rhai-cloud-cloud-manager-rolebinding<br/>+ RB leader-election"]
        CRBHook["CRB rhai-post-install-hook<br/>+ RB rhai-post-install-hook-cert"]
        CRBPre["CRBs rhai-pre-delete-hook,<br/>rhai-pre-upgrade-delete-crs,<br/>rhai-pre-upgrade-migrate-certmanager"]
        CRBLoki["CRBs usage-logs-infrastructure-<br/>reader / writer"]
        RBBoot["RB grid-enrollment-ca-bootstrap<br/>(persists after uninstall)"]
        RBMount["RB role-mount-reconciliation<br/>(optional)"]
    end

    subgraph Roles["Roles"]
        CROp["ClusterRole rhai-operator-role<br/>95 rules, ~45 API groups"]
        CRCM["ClusterRole rhai-aws/azure/coreweave-<br/>cloud-manager-role (23 rules)"]
        CRHook["ClusterRole rhai-post-install-hook<br/>(9 rules)"]
        CRPre["Pre-delete / pre-upgrade ClusterRoles"]
        CRLoki["usage-logs-infrastructure-<br/>reader / writer"]
        RBoot["Role ca-bootstrap"]
        RMount["Role mount-reconciliation"]
        CRMetrics["ClusterRole rhai-operator-metrics-reader"]
    end

    subgraph Res["API Resources"]
        RRBAC["rbac.authorization.k8s.io<br/>roles, clusterroles, rolebindings,<br/>clusterrolebindings"]
        RWork["apiGroups *<br/>deployments, services, statefulsets"]
        RRS["*, apps, extensions<br/>replicasets"]
        ROther["core, admissionregistration, apiextensions,<br/>cert-manager.io, gateway.networking.k8s.io,<br/>networking.istio.io, monitoring.coreos.com, ..."]
        RCM["infrastructure.opendatahub.io, kuadrant.io,<br/>sailoperator.io, operator.openshift.io,<br/>cert-manager.io, coordination, rbac"]
        RHookRes["core, apiextensions, cert-manager.io,<br/>components/config/infrastructure.opendatahub.io,<br/>gateway.networking.k8s.io"]
        RPreRes["kserves, aigateways, platforms default,<br/>kubernetesengines, CRDs, certmanagers,<br/>leases cert-manager-operator-lock"]
        RLoki["loki.grafana.com<br/>infrastructure logs"]
        RSecret["core Secrets<br/>(create + name-scoped get/update/patch)"]
        RCMap["Secrets / ConfigMaps mounts"]
        RMetrics["nonResourceURL /metrics"]
    end

    SAOp --> CRBOp --> CROp
    SACM --> CRBCM --> CRCM
    SAHook --> CRBHook --> CRHook
    SAPre --> CRBPre --> CRPre
    SALoki --> CRBLoki --> CRLoki
    SABoot --> RBBoot --> RBoot
    SAGridOp --> RBMount --> RMount

    CROp -->|"* (escalation capable)"| RRBAC
    CROp -->|"create, delete, get, list, patch, update, watch"| RWork
    CROp -->|"get, list, watch"| RRS
    CROp -->|various| ROther
    CRCM -->|various| RCM
    CRHook -->|"create, get, patch"| RHookRes
    CRPre -->|"get, list, watch, delete, patch"| RPreRes
    CRLoki -->|"create / get"| RLoki
    RBoot -->|"create, get, update, patch"| RSecret
    RMount -->|reconcile| RCMap
    CRMetrics -->|get| RMetrics

