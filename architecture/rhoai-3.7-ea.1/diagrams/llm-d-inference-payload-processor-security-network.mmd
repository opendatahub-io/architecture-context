graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client"]
    end

    subgraph Ingress["INGRESS - Inference Gateway"]
        Gateway["Inference Gateway (Istio / Envoy)<br/>443/80 TCP<br/>TLS + auth per Gateway listener/policy<br/>EnvoyFilter ext_proc, failure_mode_allow: false"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy / AuthorizationPolicy shipped)"]
        direction TB
        subgraph NS_IPP["Namespace: release namespace"]
            IPP["payload-processor pod<br/>SA: name-release<br/>Image: ghcr.io/llm-d/llm-d-inference-payload-processor:v0.1.0<br/>UID 65532, distroless static"]
            Health["gRPC health 9005/TCP<br/>plaintext, no auth"]
            MetricsSrv["/metrics + /debug/pprof 9090/TCP<br/>plain HTTP<br/>TokenReview/SAR filter (default on)"]
        end
        Pools["InferencePools / llm-d-router EPP<br/>model server pods"]
        Prom["Prometheus"]
        Kubelet["Kubelet / GKE health check"]
        AnyPod["Any in-cluster pod"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph Optional["OPTIONAL EXTERNAL SERVICES"]
        OTLP["OTLP collector<br/>4317/TCP gRPC<br/>plaintext (WithInsecure)"]
    end

    Client -->|HTTPS/HTTP 443/80<br/>per Gateway listener| Gateway
    Gateway -->|gRPC ext_proc 9004/TCP<br/>TLS self-signed RSA-4096<br/>DestinationRule SIMPLE, insecureSkipVerify<br/>no client auth| IPP
    Gateway -->|header-based route<br/>per backend| Pools
    AnyPod -.->|9004/TCP reachable<br/>no authN| IPP
    Kubelet -->|gRPC 9005/TCP plaintext| Health
    Prom -->|HTTP 9090/TCP<br/>Bearer token in cleartext| MetricsSrv
    IPP -->|HTTPS 6443<br/>SA token<br/>configmaps get/list/watch| K8sAPI
    MetricsSrv -->|HTTPS 6443<br/>TokenReview / SAR<br/>RBAC not granted| K8sAPI
    IPP -.->|gRPC 4317 plaintext<br/>when OTEL_TRACES_EXPORTER=otlp| OTLP

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class IPP,Pools,Prom,Kubelet internal
    class Health,MetricsSrv,AnyPod risk
    class K8sAPI,OTLP externalservice
