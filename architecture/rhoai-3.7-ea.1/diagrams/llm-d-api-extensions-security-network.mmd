graph TB
    subgraph Cluster["CLUSTER NETWORK (trust depends on deployment NetworkPolicies / gateway)"]
        LLMD["llm-d Scheduler / Router<br/>(consumer)"]
        Other["Any client with network reach<br/>to the vLLM Service"]
    end

    subgraph Pod["vLLM MODEL-SERVER POD (single process trust boundary)"]
        subgraph API["vLLM API Server - 8000/TCP<br/>TLS: only if --ssl-* set (default plaintext)<br/>Auth: only if --api-key or fronting proxy"]
            Routes["/plugins/llm-d-server-introspection/<br/>config | devices | kv-cache<br/>GET, read-only, cached"]
            Redact["kv_connector_extra_config<br/>values redacted by default<br/>LLM_D_INTROSPECTION_EXPOSE_KV_EXTRA_CONFIG=1 disables"]
        end
        subgraph Engine["vLLM Engine Workers"]
            WorkerExt["DeviceInfoWorkerExtension<br/>get_device_properties"]
        end
    end

    subgraph Egress["EGRESS"]
        None["No runtime egress<br/>(test-only: Hugging Face download for e2e)"]
    end

    LLMD -->|"HTTP/8000<br/>TLS inherited (none by default)<br/>Auth inherited (Bearer --api-key if set)"| Routes
    Other -.->|"HTTP/8000<br/>same exposure: launch config,<br/>hardware, KV-transfer topology<br/>(kv_port, engine_id, NIXL side-channel host/port)"| Routes
    Routes --- Redact
    Routes -->|"collective_rpc at startup<br/>vLLM internal IPC, no auth"| WorkerExt

    classDef cluster fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class LLMD cluster
    class Other risk
    class Routes,Redact,WorkerExt pod
    class None external
