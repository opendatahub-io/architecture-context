graph LR
    LMEval["lm-evaluation-harness<br/>odh-ta-lmes-job-rhel9"]

    %% External Dependencies
    LMEval -->|runtime| Python["Python 3.12"]
    LMEval -->|tensor runtime| Torch["torch 2.13 (AIPCC base)"]
    LMEval -->|tokenizers, HF backends| Transformers["transformers 4.48+"]
    LMEval -->|dataset loading| Datasets["datasets 3.1+, below 4"]
    LMEval -->|metric loading| Evaluate["evaluate 0.4.3+"]
    LMEval -->|catalog integration| Unitxt["unitxt 1.17.2+"]
    LMEval -->|adapter, callbacks, creds| EvalHubSDK["eval-hub-sdk[adapter] ~1.0"]
    LMEval -.->|S3 downloads| Boto3["boto3"]
    LMEval -.->|OCI artifacts| Olot["olot + skopeo"]
    LMEval -->|API clients| HTTPLibs["requests / aiohttp / tiktoken"]
    LMEval -.->|watsonx backend| Watsonx["ibm-watsonx-ai"]

    %% Internal Platform Dependencies
    TrustyAI["trustyai-service-operator"] -->|launches LMEvalJob pods| LMEval
    EvalHub["EvalHub"] -->|schedules adapter jobs| LMEval
    LMEval -->|status + results callbacks| EvalHub
    LMEval -->|results persistence| MLflow["MLflow"]
    LMEval -->|"/v1/completions"| ModelServing["Model serving<br/>KServe / vLLM / llm-d"]
    AIPCC["AIPCC base images"] -.->|base image| LMEval

    %% External Services
    LMEval -->|datasets, tokenizers, metrics| HF["Hugging Face Hub"]
    LMEval -.->|result artifact push| Registry["OCI registry"]
    LMEval -.->|model/data download| S3["S3-compatible storage"]
    LMEval -.->|optional CLI backends| LLMAPIs["OpenAI / Anthropic / watsonx.ai"]

