graph TB
    subgraph Manager["odh-model-controller manager (Deployment odh-model-controller, SA odh-model-controller)"]
        direction TB
        Webhooks["Admission Webhook Server<br/>9443/TCP HTTPS<br/>5 mutating + 5 validating, failurePolicy Fail"]
        Metrics["Metrics Server<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
        Probes["Health Probes<br/>8081/TCP HTTP"]

        subgraph Reconcilers["Reconcilers (disabled in xKS webhook-only mode)"]
            ISVCRec[InferenceServiceReconciler]
            LLMRec[LLMInferenceServiceReconciler]
            GWRec[GatewayReconciler]
            GridRec[GridInferenceProviderReconciler]
            SRRec[ServingRuntimeReconciler]
            IGRec[InferenceGraphReconciler]
            SecretRec[SecretReconciler]
            CMRec[ConfigMapReconciler]
            PodRec["PodReconciler<br/>Ray TLS certs"]
            NIMRec["AccountReconciler (NIM)<br/>NIM_STATE=managed"]
            ProfileW["ProfileWatcher<br/>TLS profile → restart"]
            MaaSCleanup["MaaSRBACCleanupRunner<br/>one-shot"]
        end
    end

    subgraph API["model-serving-api (Deployment model-serving-api, SA model-serving-api)"]
        Gateways["/api/v1/gateways<br/>8443/TCP HTTPS<br/>Bearer + SSAR as user"]
        Samples["/api/v1/samples/llm-d<br/>8443/TCP, no auth"]
        APIMetrics["/metrics<br/>8080/TCP HTTPS, no auth"]
    end

    Runtimes["30 ClusterServingRuntimes + Templates<br/>vLLM CUDA/ROCm/Gaudi/Spyre/CPU, vLLM-Omni, MLServer, OVMS"]

    %% Watched CRs
    User[Data Scientist / Dashboard] -->|creates| ISVC[InferenceService]
    User -->|creates| LLMISVC["LLMInferenceService<br/>(v1alpha1/v1alpha2)"]
    User -->|creates| AccountCR["nim.opendatahub.io/v1 Account<br/>(owned CRD)"]
    ISVC -->|watched by| ISVCRec
    LLMISVC -->|watched by| LLMRec
    LLMISVC -->|watched by| GridRec
    SR[ServingRuntime] -->|watched by| SRRec
    IG[InferenceGraph] -->|watched by| IGRec
    GW[Gateway API Gateway] -->|watched by| GWRec
    AccountCR -->|watched by| NIMRec
    DataConn[Data connection Secrets] -->|watched by| SecretRec
    APIServerCfg["config.openshift.io APIServer<br/>TLS profile"] -->|watched by| ProfileW

    KAPI[kube-apiserver] -->|admission POST| Webhooks

    %% Created resources
    ISVCRec -->|creates| Route[OpenShift Route]
    ISVCRec -->|creates| ISVCRes["SA, ClusterRoleBinding,<br/>NetworkPolicy, ServiceMonitor/PodMonitor,<br/>KEDA TriggerAuthentication"]
    LLMRec -->|creates| LLMRes["SA, Secrets, KEDA,<br/>Kuadrant AuthPolicy"]
    GWRec -->|creates| GWRes["Istio EnvoyFilter,<br/>AuthPolicy, PodMonitor"]
    GridRec -->|creates| Provider["grid.praxis.fast InferenceProvider<br/>+ Roles/RoleBindings/NetworkPolicies"]
    SecretRec -->|creates| StorageCfg[storage-config Secret]
    CMRec -->|creates| CABundle[KServe custom CA ConfigMap]
    PodRec -->|creates| RayCerts[Ray TLS Secrets]
    NIMRec -->|creates| NIMRes["NIM Templates, ConfigMaps,<br/>pull Secrets"]

    %% External
    NIMRec -->|HTTPS/443| NGC["NVIDIA NGC<br/>api.ngc.nvidia.com, authn.nvidia.com, nvcr.io"]
    ISVCRec -.->|optional HTTPS| MR[Model Registry]
    Dashboard[RHOAI Dashboard] -->|HTTPS 443→8443| Gateways
    Gateways -->|list Gateways / SSAR| KAPI
    API -.->|optional OTLP/gRPC| OTel[OpenTelemetry Collector]
    Prom[Prometheus] -->|scrape| Metrics

