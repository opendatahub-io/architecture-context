graph TD
    Note["No Kubernetes RBAC: component runs on Google Cloud Run.<br/>Authorization is enforced in the application."]

    subgraph Identity["Identity sources"]
        Token["GitHub token<br/>X-Prism-Github-Token"]
        OrgRole["llm-d GitHub org membership<br/>api.github.com/orgs/llm-d/memberships/{user}<br/>admin → admin, member → user"]
        Allow["GCS allowlists<br/>gs://RESULTS_STORE_BUCKET/prism-iam/<br/>github-admin-allowlist.txt<br/>github-user-allowlist.txt"]
        Playground["RESULTS_STORE_PLAYGROUND_MODE<br/>1 / true / yes / on"]
    end

    subgraph Resolve["Permission resolution (server/oauth.ts:123-173, server/iam.ts:59-133)"]
        Max["max(org role, allowlist role)"]
    end

    subgraph Levels["Permission levels"]
        None["none<br/>(anonymous)"]
        User["user"]
        Admin["admin"]
    end

    subgraph Resources["Results Store / proxy operations"]
        Read["GET /api/results, /:runId, export<br/>public states"]
        ReadOwn["GET pending / own runs<br/>export, entry download"]
        Submit["POST /api/results"]
        Delete["DELETE /api/results/:runId"]
        Promote["POST /api/results/:runId/promote"]
        Review["POST /api/results/:runId/review"]
        GCSW["/api/gcs/* writes<br/>results-store prefix only"]
        GIQ["/api/giq/*<br/>unrestricted, server ADC fallback"]
    end

    subgraph GCPIAM["GCP identity (not defined in repo)"]
        SA["Cloud Run service account<br/>ADC: read/write bucket llm-d-benchmarks,<br/>call GIQ"]
    end

    Token --> OrgRole
    OrgRole --> Max
    Allow --> Max
    Max --> User
    Max --> Admin
    Playground -->|grants everyone| Admin

    None -->|read| Read
    None -->|call| GIQ
    User -->|read| Read
    User -->|owner only| ReadOwn
    User -->|create| Submit
    User -->|owner only| Delete
    User -->|ownership checked| Promote
    User -->|permission required| GCSW
    Admin -->|all| ReadOwn
    Admin -->|create| Submit
    Admin -->|any run| Delete
    Admin -->|any run| Promote
    Admin -->|approve / reject| Review
    Admin -->|write| GCSW

    Submit -.->|executed as| SA
    GCSW -.->|executed as| SA
    GIQ -.->|executed as| SA

