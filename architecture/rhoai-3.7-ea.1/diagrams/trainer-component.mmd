graph TB
    %% Trainer (Kubeflow Trainer v2 for RHOAI) - component structure
    Platform["rhods-operator<br/>(platform)"]
    User["User / Kubeflow SDK / Dashboard"]

    subgraph OperatorNS["trainer-operator (module operator)"]
        Operator["trainer-operator<br/>image: odh-trainer-operator-rhel9<br/>:8081 health, :8443 metrics"]
        Templates["Bundled manifests<br/>/opt/*-template<br/>(manifests/rhoai, runtimes, imagestreams)"]
        Operator -->|"renders with RELATED_IMAGE_* overrides"| Templates
    end

    subgraph AppNS["redhat-ods-applications"]
        subgraph Operand["kubeflow-trainer-controller-manager (operand)"]
            Reconcilers["Reconcilers<br/>TrainJob / TrainingRuntime /<br/>ClusterTrainingRuntime"]
            OptJobCtl["OptimizationJob controller<br/>(gated, off in RHOAI)"]
            Plugins["Runtime plugin framework<br/>Torch, MPI, JAX, XGBoost, Flux,<br/>PlainML, JobSet, CoScheduling,<br/>Volcano, TrainJobStatus"]
            Webhooks["Admission webhooks<br/>:9443 (svc 443)"]
            CertCtl["cert-controller rotator<br/>(self-signed CA)"]
            StatusSrv["Status server :10443<br/>(gated TrainJobStatus, off)"]
            Progression["RHAI progression tracking"]
            NetPolCtl["RHAI per-TrainJob NetworkPolicy"]
            Reconcilers --> Plugins
            Reconcilers --> Progression
            Reconcilers --> NetPolCtl
            CertCtl -->|serving cert| Webhooks
        end
        WebhookCert["Secret<br/>kubeflow-trainer-webhook-cert"]
        CfgMap["ConfigMap<br/>kubeflow-trainer-config"]
    end

    %% CRDs
    TrainerCR["Trainer CR<br/>components.platform.opendatahub.io<br/>(default-trainer, cluster)"]
    TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1"]
    TRCR["TrainingRuntime CR<br/>(namespaced)"]
    CTRCR["ClusterTrainingRuntime CR<br/>(curated runtimes)"]
    OptJobCR["OptimizationJob CR<br/>(alpha, gated)"]
    ImageStreams["Training-hub ImageStreams<br/>(CUDA / ROCm / CPU)"]

    Platform -->|creates| TrainerCR
    Platform -->|creates odh-trainer-config| Operator
    TrainerCR -->|watched by| Operator
    Operator -->|SSA apply CRDs, RBAC, Deployment, webhooks| Operand
    Operator -->|SSA apply| CTRCR
    Operator -->|SSA apply| ImageStreams
    Operator -->|writes tls profile| CfgMap
    CfgMap -->|mounted config| Reconcilers

    User -->|creates| TrainJobCR
    User -->|creates| TRCR
    TrainJobCR -->|watched by| Reconcilers
    TRCR -->|referenced by TrainJob| Reconcilers
    CTRCR -->|referenced by TrainJob| Reconcilers
    OptJobCR -.->|watched by| OptJobCtl
    CertCtl -->|writes| WebhookCert

    %% Created resources
    JobSet["JobSet<br/>jobset.x-k8s.io/v1alpha2"]
    Secrets["Secrets<br/>MPI SSH keys, Flux CURVE"]
    Services["Services / ConfigMaps"]
    PodGroups["PodGroups<br/>(CoScheduling / Volcano)"]
    NetPol["NetworkPolicy per TrainJob"]
    Suggestion["Optuna suggestion<br/>Deployment + Service :6789"]
    TrainPods["Training pods<br/>(user namespace)"]

    Plugins -->|creates| JobSet
    Plugins -->|creates| Secrets
    Plugins -->|creates| Services
    Plugins -.->|creates optional| PodGroups
    NetPolCtl -->|creates| NetPol
    OptJobCtl -.->|creates| Suggestion
    OptJobCtl -.->|gRPC GetSuggestions| Suggestion
    JobSet -->|run by JobSet controller| TrainPods
    Progression -->|HTTP GET /metrics :28080| TrainPods
    TrainPods -.->|POST status, gated| StatusSrv

    %% Dependencies
    JobSetOp["OpenShift JobSet Operator<br/>(required dependency)"]
    Kueue["Kueue<br/>(indirect)"]
    Prom["Prometheus / OpenShift monitoring"]
    K8sAPI["Kubernetes API"]

    Operator -->|dependency gate| JobSetOp
    JobSetOp -->|supplies CRDs + controller| JobSet
    Kueue -.->|admits workloads| JobSet
    Prom -->|scrapes :8443| Operand
    Prom -->|scrapes :8443| Operator
    K8sAPI -->|admission calls| Webhooks

    style Operator fill:#4a90e2,color:#fff
    style Reconcilers fill:#4a90e2,color:#fff
    style Plugins fill:#4a90e2,color:#fff
    style Webhooks fill:#4a90e2,color:#fff
    style CertCtl fill:#4a90e2,color:#fff
    style Progression fill:#4a90e2,color:#fff
    style NetPolCtl fill:#4a90e2,color:#fff
    style OptJobCtl fill:#cfe0f5,stroke-dasharray: 5 5
    style StatusSrv fill:#cfe0f5,stroke-dasharray: 5 5
    style TrainerCR fill:#f5a623
    style TrainJobCR fill:#f5a623
    style TRCR fill:#f5a623
    style CTRCR fill:#f5a623
    style OptJobCR fill:#f5a623,stroke-dasharray: 5 5
    style JobSetOp fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style Prom fill:#e8e8e8
    style Kueue fill:#7ed321
    style Platform fill:#7ed321
