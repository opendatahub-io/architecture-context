graph TB
    RHOAIOp["rhods-operator"] -->|"creates default-kserve"| KserveCR["Kserve CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster singleton"]
    User["Data Scientist / Dashboard"] -->|creates| ISVC["InferenceService<br/>v1beta1"]
    User -->|creates| LLMISVC["LLMInferenceService<br/>v1alpha1, v1alpha2"]
    User -->|creates| IG["InferenceGraph<br/>v1alpha1"]
    User -->|creates| LMC["LocalModelCache /<br/>LocalModelNamespaceCache"]

    subgraph Module["kserve-module (platform-module operator)"]
        ModuleCtrl["kserve-module-controller<br/>probes 8081/TCP"]
        Templates[("/opt/manifests-template<br/>config/ + prefetched modelcontroller,<br/>modelexpress, wva")]
        ModuleCtrl -->|"renders kustomize"| Templates
    end

    KserveCR -->|watched by| ModuleCtrl

    subgraph ControlPlane["KServe control plane (namespace: opendatahub)"]
        KCtrl["kserve-controller-manager<br/>webhook 9443 / metrics 8443"]
        LCtrl["llmisvc-controller-manager<br/>webhook 9443 / metrics 8443"]
        LMCtrl["kserve-localmodel-controller-manager<br/>(modelCache enabled only)"]
        LMAgent["kserve-localmodelnode-agent<br/>DaemonSet"]
        KCNode["kernelcachenode<br/>(source only, not built)"]
        RBACProxy["kube-rbac-proxy<br/>8443/TCP"]
    end

    ModuleCtrl -->|"SSA Deployments, CRDs,<br/>webhooks, RBAC"| KCtrl
    ModuleCtrl -->|SSA| LCtrl
    ModuleCtrl -->|"SSA (modelCache)"| LMCtrl
    ModuleCtrl -->|SSA| OMC["odh-model-controller"]
    ModuleCtrl -->|"SSA (Removed by default)"| MEX["ModelExpress / WVA"]
    ModuleCtrl -->|creates| CSR["ClusterServingRuntimes<br/>csr-kserve-vllm-*, ovms, mlserver"]
    ModuleCtrl -->|creates| LLMCfg["LLMInferenceServiceConfig<br/>versioned + accelerator presets"]
    ModuleCtrl -->|creates| Dash["Perses / console dashboards,<br/>TelemetryPolicy, NIM Account"]

    ISVC -->|watched by| KCtrl
    IG -->|watched by| KCtrl
    LLMISVC -->|watched by| LCtrl
    LLMCfg -->|"spec.baseRefs"| LCtrl
    LMC -->|watched by| LMCtrl
    LMCtrl -->|creates| LMNode["LocalModelNode"]
    LMNode -->|watched by| LMAgent
    LMAgent -->|"runs download Jobs"| NodePV[("Node PV/PVC")]

    subgraph DataPlane["Data plane (tenant namespaces)"]
        Predictor["Predictor Deployment<br/>model server 8080 REST / 8081 gRPC"]
        StorInit["storage-initializer<br/>init container + kserve-decrypt"]
        Agent["agent sidecar<br/>9081/TCP"]
        QPExt["qpext metrics aggregator<br/>9088/TCP"]
        Router["InferenceGraph router<br/>8080/TCP"]
        LLMWork["vLLM decode / prefill<br/>Deployment or LWS"]
        EPP["llm-d EPP scheduler"]
    end

    KCtrl -->|"creates Deployment, Service,<br/>HPA/KEDA, HTTPRoute/Route/Ingress"| Predictor
    KCtrl -->|creates| Router
    KCtrl -->|"/mutate-pods injects"| StorInit
    KCtrl -->|"/mutate-pods injects"| Agent
    KCtrl -->|"/mutate-pods injects"| QPExt
    LCtrl -->|"creates InferencePool, HTTPRoute,<br/>NetworkPolicy, SA, Role"| LLMWork
    LCtrl -->|creates| EPP
    StorInit -->|"writes /mnt/models"| Predictor
    Router -->|"calls nodes"| Predictor
    RBACProxy -.->|"protects /metrics"| KCtrl

    KCtrl -->|depends on| GW["Gateway API / OSSM"]
    LCtrl -->|depends on| GIE["Gateway API Inference Extension"]
    LCtrl -->|depends on| LWS["LeaderWorkerSet"]
    KCtrl -.->|optional| Knative["Knative Serving"]
    KCtrl -.->|optional| KEDA["KEDA"]
    ModuleCtrl -->|depends on| CertMgr["cert-manager / service-CA"]

    style ModuleCtrl fill:#4a90e2,color:#fff
    style KCtrl fill:#4a90e2,color:#fff
    style LCtrl fill:#4a90e2,color:#fff
    style LMCtrl fill:#4a90e2,color:#fff
    style LMAgent fill:#4a90e2,color:#fff
