graph TD
    subgraph K8s["Kubernetes RBAC"]
        NoRBAC["No ClusterRoles, Roles, bindings<br/>or ServiceAccount in repo<br/>praxis-ai does not call the Kubernetes API"]
    end

    subgraph AppAuth["Application-level access control (config-defined)"]
        Listener["Listener (any chain)<br/>optional TLS / mTLS (Praxis)<br/>optional basic_auth (experimental)"]
        ProviderRoutes["Provider-route chains<br/>peer_identity_trust (mandatory first filter)<br/>downstream mTLS + SPIFFE peer identity<br/>rejects optional/plaintext client cert modes"]
        StateAPIs["/v1/responses, /v1/conversations<br/>state_owner + identity_header_guard<br/>trusted x-auth-tenant / x-auth-user"]
        AdminEP["Admin 9901<br/>/healthy /ready /metrics<br/>no auth, loopback default"]
    end

    subgraph Data["Data scoping"]
        StoreRows["Store rows keyed by<br/>tenant_id + owner_issuer + owner_subject"]
        Buckets["Rate-limit buckets keyed by<br/>header / IP / model"]
    end

    subgraph Outbound["Outbound credentials"]
        Creds["API keys (watched files)<br/>AWS SigV4, Entra ID, GCP ADC<br/>bound to validated target origin"]
    end

    Authn["Trusted upstream authenticator"] -->|asserts identity headers| StateAPIs
    Peer["SPIFFE-identified peer"] -->|mTLS| ProviderRoutes
    StateAPIs -->|scopes queries| StoreRows
    Listener --> ProviderRoutes
    Listener --> StateAPIs
    Listener -->|token limits| Buckets
    ProviderRoutes -->|inject| Creds

    style NoRBAC fill:#e8e8e8
    style Listener fill:#4a90e2,color:#fff
    style ProviderRoutes fill:#4a90e2,color:#fff
    style StateAPIs fill:#4a90e2,color:#fff
    style AdminEP fill:#f8cecc
    style StoreRows fill:#7ed321
    style Buckets fill:#7ed321
    style Creds fill:#f5a623
    style Authn fill:#ffe6cc
    style Peer fill:#ffe6cc
