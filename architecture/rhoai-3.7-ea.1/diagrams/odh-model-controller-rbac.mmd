graph TD
    subgraph SAs["Service Accounts"]
        SA_MGR[odh-model-controller]
        SA_API[model-serving-api]
        SA_CM["controller-manager<br/>(metrics-auth binding)"]
    end

    subgraph Bindings["Bindings"]
        CRB_MAIN["odh-model-controller-rolebinding-opendatahub<br/>(ClusterRoleBinding)"]
        CRB_PROXY["proxy-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_MAUTH["metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_API["model-serving-api<br/>(ClusterRoleBinding)"]
        RB_LE["leader-election-rolebinding<br/>(RoleBinding, ns opendatahub)"]
    end

    subgraph Roles["Roles"]
        CR_MAIN[odh-model-controller-role]
        CR_PROXY["proxy-role / metrics-auth-role"]
        CR_API["model-serving-api ClusterRole"]
        R_LE["leader-election-role (Role)"]
    end

    subgraph Escalation["Escalation-capable / sensitive"]
        Secrets["core: secrets, configmaps,<br/>serviceaccounts, services"]
        RBACRes["rbac.authorization.k8s.io:<br/>clusterrolebindings, rolebindings, roles"]
        NetPol["networking.k8s.io: networkpolicies"]
    end

    subgraph Serving["Serving & Gateway resources"]
        KS["serving.kserve.io: inferenceservices, llminferenceservices<br/>servingruntimes, inferencegraphs (+finalizers/status)"]
        GWR["gateway.networking.k8s.io: gateways (patch/update),<br/>httproutes (read)"]
        EF[networking.istio.io: envoyfilters]
        AP["kuadrant.io: authpolicies (+status), kuadrants (read)"]
        AUTH["operator.authorino.kuadrant.io: authorinos (read)"]
        GRID[grid.praxis.fast: inferenceproviders]
        NIM["nim.opendatahub.io: accounts (+status, finalizers)"]
    end

    subgraph Platform["Platform & monitoring"]
        MON["monitoring.coreos.com: podmonitors, servicemonitors"]
        KEDA[keda.sh: triggerauthentications]
        CORE2["core: endpoints, namespaces, pods<br/>(no delete)"]
        ODH["datasciencecluster / dscinitialization /<br/>infrastructure hardwareprofiles (read)"]
        MISC["events.k8s.io events, metrics.k8s.io,<br/>resource.k8s.io resourceclaimtemplates (get),<br/>ingresses (read), serving.opendatahub.io models (post)"]
    end

    subgraph APIPerms["model-serving-api resources"]
        GWList[gateway.networking.k8s.io: gateways]
        NSGet[core: namespaces]
        APISrv[config.openshift.io: apiservers]
    end

    subgraph AuthAPIs["Authn/Authz APIs"]
        TR[authentication.k8s.io: tokenreviews]
        SAR[authorization.k8s.io: subjectaccessreviews]
    end

    LE["core/coordination.k8s.io:<br/>configmaps, leases, events"]

