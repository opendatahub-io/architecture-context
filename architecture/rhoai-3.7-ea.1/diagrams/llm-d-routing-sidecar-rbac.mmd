graph TD
    subgraph Subjects["Subjects"]
        SA["ServiceAccount: placeholder<br/>(set by deployer)"]
        AuthGroup["Group: system:authenticated"]
    end

    subgraph Bindings["RoleBindings (namespaced)"]
        RB1["ssrf-allowlist-rolebinding<br/>(unreferenced file)"]
        RB2["PROJECT_NAME-exec-rolebinding<br/>(scaffold)"]
    end

    subgraph Roles["Roles (namespaced, no ClusterRoles)"]
        R1["ssrf-allowlist-role"]
        R2["PROJECT_NAME-exec-role"]
    end

    subgraph Resources["API Resources"]
        Pods["core<br/>pods"]
        Pools["inference.networking.x-k8s.io<br/>inferencepools"]
        Exec["core<br/>pods/exec<br/>resourceName PROJECT_NAME-0-0"]
    end

    SA -->|bound via| RB1
    RB1 -->|grants| R1
    R1 -->|"get, list, watch"| Pods
    R1 -->|"get, list, watch"| Pools

    AuthGroup -->|bound via| RB2
    RB2 -->|grants| R2
    R2 -->|create| Exec

    style SA fill:#4a90e2
    style AuthGroup fill:#f8cecc
    style R1 fill:#f5a623
    style R2 fill:#f5a623
    style Pods fill:#7ed321
    style Pools fill:#7ed321
    style Exec fill:#f8cecc
