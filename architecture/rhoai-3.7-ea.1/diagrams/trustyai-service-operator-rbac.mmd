graph TD
    subgraph SAs["Service Accounts"]
        ModSA["trustyai-operator-module-controller-manager"]
        OpSA["trustyai-service-operator-controller-manager"]
    end

    subgraph Bindings["ClusterRoleBindings"]
        ModCRB["trustyai-operator-module-manager-rolebinding"]
        OpCRBs["trustyai-service-operator-<br/>tas / lmes / evalhub / nemo-guardrails<br/>-manager-rolebinding"]
        AuxCRBs["tls-profile-reader-binding<br/>proxy-rolebinding / metrics-auth<br/>manager-auth-delegator"]
        LERB["leader-election-rolebinding<br/>(operator namespace)"]
    end

    subgraph Roles["ClusterRoles"]
        ModRole["trustyai-operator-module-manager-role<br/>MOST PRIVILEGED - superset"]
        TASRole["tas-manager-role"]
        LMESRole["lmes-manager-role"]
        EHRole["evalhub-manager-role"]
        NemoRole["nemo-guardrails-manager-role"]
        AuxRoles["tls-profile-reader / proxy-role<br/>metrics-auth / system:auth-delegator"]
    end

    subgraph Resources["API Resources"]
        R_Platform["components.platform.opendatahub.io<br/>trustyais"]
        R_CRD["apiextensions.k8s.io<br/>customresourcedefinitions"]
        R_Webhook["admissionregistration.k8s.io<br/>mutating/validating webhookconfigurations"]
        R_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings, roles, rolebindings"]
        R_TrustyAI["trustyai.opendatahub.io<br/>trustyaiservices, lmevaljobs, evalhubs, nemoguardrails<br/>(+status, finalizers)"]
        R_Virtual["trustyai.opendatahub.io (virtual)<br/>evaluations, collections, providers, status-events, evalhubs/proxy"]
        R_Secrets["core<br/>secrets"]
        R_Core["core<br/>services, pods, configmaps, PVCs, serviceaccounts"]
        R_Exec["core<br/>pods/exec"]
        R_ReadCore["core<br/>namespaces, pods/log, events, persistentvolumes"]
        R_Apps["apps<br/>deployments, replicasets"]
        R_KServe["serving.kserve.io<br/>inferenceservices"]
        R_Istio["networking.istio.io<br/>destinationrules, virtualservices"]
        R_Net["route.openshift.io routes<br/>networking.k8s.io networkpolicies<br/>monitoring.coreos.com servicemonitors"]
        R_Jobs["batch jobs<br/>kueue.x-k8s.io workloads"]
        R_MLflow["mlflow.kubeflow.org experiments<br/>infrastructure.opendatahub.io hardwareprofiles"]
        R_Bind["clusterroles BIND<br/>resourceNames: evalhub-model-secret, -auth-reviewer-role,<br/>-jobs-writer, -job-config, -hardware-profiles-reader,<br/>-mlflow-access, -mlflow-jobs-access, -providers-access, -collections-access"]
        R_TLS["config.openshift.io<br/>apiservers"]
        R_Auth["authentication.k8s.io tokenreviews<br/>authorization.k8s.io subjectaccessreviews"]
    end

    ModSA -->|bound via| ModCRB
    ModCRB -->|grants| ModRole
    OpSA -->|bound via| OpCRBs
    OpSA -->|bound via| AuxCRBs
    OpSA -->|bound via| LERB
    OpCRBs -->|grants| TASRole
    OpCRBs -->|grants| LMESRole
    OpCRBs -->|grants| EHRole
    OpCRBs -->|grants| NemoRole
    AuxCRBs -->|grants| AuxRoles

    %% Module
    ModRole -->|full CRUD| R_Platform
    ModRole -->|create, delete, get, list, patch, update, watch| R_CRD
    ModRole -->|full CRUD| R_Webhook
    ModRole -->|full CRUD + clusterroles bind| R_RBAC
    ModRole -->|full CRUD| R_Secrets
    ModRole -->|full CRUD| R_Core
    ModRole -->|exec| R_Exec
    ModRole -.->|superset of all operator rules| R_TrustyAI

    %% TAS
    TASRole -->|full CRUD| R_TrustyAI
    TASRole -->|get, list, watch, create, update, patch, delete| R_Secrets
    TASRole -->|get, list, watch, create, update, patch, delete| R_Core
    TASRole -->|CRUD<br/>replicasets get| R_Apps
    TASRole -->|get, list, watch, update, patch| R_KServe
    TASRole -->|full CRUD| R_Istio
    TASRole -->|get, list, watch, create, update, delete| R_RBAC
    TASRole -->|routes CRUD<br/>servicemonitors list, watch, create<br/>networkpolicies get, list, watch, create, update| R_Net

    %% LMES
    LMESRole -->|full CRUD lmevaljobs| R_TrustyAI
    LMESRole -->|create, get| R_Exec
    LMESRole -->|CRUD pods, configmaps, PVCs| R_Core
    LMESRole -->|get, list, watch| R_Secrets

    %% EvalHub
    EHRole -->|full CRUD evalhubs| R_TrustyAI
    EHRole -->|full CRUD<br/>evalhubs/proxy get, create| R_Virtual
    EHRole -->|CRUD services, configmaps, SAs| R_Core
    EHRole -->|read| R_ReadCore
    EHRole -->|CRUD roles, rolebindings, CRBs| R_RBAC
    EHRole -->|bind| R_Bind
    EHRole -->|get, list, watch, patch| R_Jobs
    EHRole -->|get, list, create / get, list| R_MLflow
    EHRole -->|CRUD deployments| R_Apps
    EHRole -->|CRUD| R_Net

    %% NeMo
    NemoRole -->|full CRUD nemoguardrails| R_TrustyAI
    NemoRole -->|full CRUD| R_Secrets
    NemoRole -->|full CRUD configmaps, services, SAs| R_Core
    NemoRole -->|full CRUD deployments| R_Apps
    NemoRole -->|full CRUD clusterrolebindings| R_RBAC

    %% Aux
    AuxRoles -->|get, list, watch| R_TLS
    AuxRoles -->|create| R_Auth

