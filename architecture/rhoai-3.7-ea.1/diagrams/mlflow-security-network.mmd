graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser / MLflow SDK"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        GW["ODH Data Science Gateway<br/>HTTPRoute path /mlflow<br/>443/TCP HTTPS TLS<br/>Platform gateway auth"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB
        subgraph NS_MLflow["Namespace: operator-defined (shared MLflow service)"]
            Svc["Service: mlflow (ClusterIP)<br/>target 5000/TCP"]
            Pod["MLflow Server Pod<br/>uvicorn 4 workers, 5000/TCP<br/>TLS terminated in pod<br/>Host/CORS middleware<br/>kubernetes-auth SSAR"]
        end
        subgraph Tenants["Tenant namespaces = MLflow workspaces"]
            SDK["Workbenches / Pipelines /<br/>Training Jobs (SDK)"]
            MC["MLflowConfig (optional)"]
        end
        K8s["Kubernetes API Server<br/>443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL / BACKING SERVICES"]
        PG["PostgreSQL<br/>5432/TCP<br/>TLS if set in URI<br/>DB credentials"]
        S3["S3-compatible store<br/>443/TCP TLS 1.2+<br/>AWS keys / IAM"]
        WH["Webhook receivers<br/>443/TCP TLS<br/>HMAC-SHA256"]
        LLM["LLM providers<br/>443/TCP TLS<br/>API keys<br/>DISABLED by default"]
    end

    User -->|HTTPS/443<br/>TLS<br/>Bearer / session| GW
    SDK -->|HTTPS/443<br/>TLS<br/>Bearer| GW
    GW -->|HTTPS/5000<br/>TLS re-encrypt<br/>Bearer + X-MLFLOW-WORKSPACE| Svc
    Svc --> Pod
    Pod -->|HTTPS/443<br/>TLS in-cluster CA<br/>caller token: SSAR<br/>SA token: namespaces, MLflowConfig| K8s
    K8s -.->|reads| MC
    Pod -->|PostgreSQL/5432<br/>TLS optional<br/>DB credentials| PG
    Pod -->|HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / keys| S3
    Pod -->|HTTPS/443<br/>TLS<br/>HMAC signature| WH
    Pod -.->|HTTPS/443<br/>disabled| LLM

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef disabled fill:#eeeeee,stroke:#999,stroke-dasharray: 5 5

    class User external
    class GW ingress
    class Svc,Pod,SDK,MC,K8s internal
    class PG,S3,WH externalservice
    class LLM disabled
