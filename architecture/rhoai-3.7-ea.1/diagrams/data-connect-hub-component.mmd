    style IDCT fill:#f5a623
    style IDC fill:#f5a623
    style Gateway fill:#7ed321
    style ODHDash fill:#7ed321
    style PG fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style ExtSrc fill:#e8e8e8
    style APIServerCfg fill:#e8e8e8
