graph TB
    User["User / SDK / ODH Dashboard"]
    Admin["Cluster Admin"]

    subgraph Controller["dc-controller (Go, controller-runtime v0.25.2) - ns dc-controller-system"]
        DCSRec["DataConnectServiceReconciler<br/>render /manifests via krusty"]
        IDCTRec[InitDataConnectionTypeReconciler]
        IDCRec["InitDataConnectionReconciler<br/>log-only"]
        CMWatch["ConfigMapWatcherReconciler<br/>migration"]
        SecWatch["SecretWatcherReconciler<br/>migration"]
        TLSWatch[SecurityProfileWatcher]
    end

    subgraph CRDs["CRDs - dataconnecthub.opendatahub.io/v1alpha1 (Namespaced)"]
        DCS[DataConnectService]
        IDCT[InitDataConnectionType]
        IDC[InitDataConnection]
    end

    subgraph Operand["DCH operand - DataConnectService namespace"]
        subgraph RestPod["dch-rest-service Pod"]
            KRP["kube-rbac-proxy sidecar<br/>8443/TCP TLS<br/>TokenReview + SAR"]
            Rest["rest-service (Rust, actix-web)<br/>127.0.0.1:8080"]
        end
        subgraph FlightPod["dch-flight-service Pod"]
            Flight["flight-service (Rust, tonic + arrow-flight)<br/>8443/TCP gRPC TLS<br/>AuthLayer TokenReview + SAR"]
            Connectors["Connectors: postgres, sqlite, s3,<br/>milvus, elasticsearch, neo4j, uri"]
        end
        HTTPRoute["HTTPRoute dch-data-connect-hub"]
        NetPol[NetworkPolicies]
        SM["ServiceMonitor<br/>OpenShift overlay"]
        CRBs["ClusterRoles / ClusterRoleBindings<br/>dch-read, read-write, admin, secret-export"]
    end

    subgraph Libs["Shared Rust libraries"]
        Commons["commons<br/>SQLReader trait"]
        PgMeta["pg-meta-store<br/>tenant filtering"]
        KubeUtils["kube-utils<br/>Secret store, TokenReview/SAR"]
        FormatReaders["format-readers<br/>CSV / JSON / Parquet"]
    end

    Gateway["odh-gateway<br/>Gateway API, opendatahub ns"]
    PG[("PostgreSQL metastore<br/>external")]
    K8sAPI[Kubernetes API]
    ExtSrc["External data sources<br/>PostgreSQL, S3, Milvus, Elasticsearch,<br/>Neo4j, HTTP URI / HuggingFace"]
    ODHDash["ODH Dashboard ConfigMaps / Secrets<br/>legacy connections"]
    APIServerCfg["OpenShift APIServer<br/>TLS security profile"]

    Admin -->|creates| DCS
    DCS -->|watched by| DCSRec
    DCSRec -->|creates| IDCT
    IDCT -->|watched by| IDCTRec
    IDC -->|watched by| IDCRec
    DCSRec -->|applies| RestPod
    DCSRec -->|applies| FlightPod
    DCSRec -->|applies| HTTPRoute
    DCSRec -->|applies| NetPol
    DCSRec -->|applies| SM
    DCSRec -->|applies| CRBs
    DCSRec -->|"POST /flights<br/>register Flight"| KRP
    IDCTRec -->|"POST connection-types"| KRP
    CMWatch -->|watches| ODHDash
    SecWatch -->|watches| ODHDash
    CMWatch -->|promote types| KRP
    SecWatch -->|"connections with secret_ref"| KRP
    TLSWatch -->|reads| APIServerCfg

    User -->|HTTPS 443| Gateway
    Gateway -->|REST paths| KRP
    Gateway -->|gRPC Flight| Flight
    HTTPRoute -.->|parentRef| Gateway
    KRP -->|"x-remote-user"| Rest
    KRP -->|SAR| K8sAPI
    Rest -->|"gRPC 8443 REST SA token"| Flight
    Rest -->|metadata| PG
    Rest -->|Secret CRUD / export| K8sAPI
    Flight -->|metadata| PG
    Flight -->|"TokenReview/SAR, read Secrets"| K8sAPI
    Flight --> Connectors
    Connectors -->|reads| ExtSrc

    Rest -.-> PgMeta
    Flight -.-> PgMeta
    Flight -.-> KubeUtils
    Rest -.-> KubeUtils
    Connectors -.-> Commons
    Connectors -.-> FormatReaders

