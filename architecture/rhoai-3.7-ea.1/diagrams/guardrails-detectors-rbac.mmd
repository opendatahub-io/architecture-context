graph TD
    subgraph Product["Product detector pods"]
        PredSA["Predictor ServiceAccount<br/>(KServe-assigned)"]
        NoAPI["No Kubernetes API calls<br/>No Roles or ClusterRoles defined"]
        PredSA -.->|"no permissions required"| NoAPI
    end

    subgraph Sample["Sample manifests only (detectors/huggingface/deploy)"]
        SA["ServiceAccount<br/>user-one"]
        RB["RoleBinding<br/>user-one-view"]
        CR["ClusterRole<br/>view (built-in)"]
        Res["Namespace resources<br/>read-only: get, list, watch"]
        SA -->|bound via| RB
        RB -->|grants| CR
        CR -->|"get, list, watch"| Res
    end

    subgraph Platform["Platform-enforced access (outside this repo)"]
        Auth["Auth proxy / Gateway<br/>enable-auth: 'true'"]
        ISVC["serving.kserve.io<br/>InferenceService"]
        Auth -->|"Kubernetes RBAC check on"| ISVC
    end

    style PredSA fill:#4a90e2,color:#fff
    style NoAPI fill:#e8e8e8
    style SA fill:#4a90e2,color:#fff
    style RB fill:#9fbfe6
    style CR fill:#f5a623
    style Res fill:#7ed321
    style Auth fill:#ffe6cc
    style ISVC fill:#7ed321
