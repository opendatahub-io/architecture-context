graph LR
    NB["notebooks<br/>workbench + runtime images<br/>+ ImageStream manifests"]

    %% Build-time external dependencies
    NB -->|"FROM, digest-pinned"| AIPCC["AIPCC base images<br/>cpu / cuda13.0 / cuda12.9 torch2.13<br/>rocm7.14 torch2.12, el9.8"]
    NB -->|"hash-pinned wheels"| PyIdx["AIPCC Python channel index<br/>packages.redhat.com public-rhai"]
    NB -->|"hermetic build, check-payload"| Konflux["Konflux / Hermeto"]
    NB -->|"workbench UI"| JLab["JupyterLab 4.5.11<br/>Jupyter Server 2.21.1"]
    NB -->|"VS Code in browser"| CodeServer["code-server v4.122.1<br/>+ nginx, httpd, Node.js"]
    NB -->|"MongoDB CLI"| Mongocli["mongocli<br/>git submodule"]

    %% SDK stack shipped in images
    NB -->|"ships SDK"| Elyra["odh-elyra 5.0.3<br/>odh-kale 2.3.0"]
    NB -->|"ships SDK"| KFP["kfp 2.18.0"]
    NB -->|"ships SDK"| CodeFlare["codeflare-sdk 0.40.1<br/>ray 2.58.0"]
    NB -->|"ships SDK"| ML["torch 2.13 / tensorflow 2.21<br/>llmcompressor 0.14"]
    NB -->|"ships SDK"| Clients["feast, mlflow 3.17.2,<br/>DB connectors, boto3/minio"]

    %% Internal platform integrations
    Operator["rhods-operator<br/>workbenches component"] -->|"applies manifests,<br/>RELATED_IMAGE_* params"| NB
    NBC["ODH notebook controller"] -->|"launches pods, kube-rbac-proxy,<br/>HTTPRoute, culling"| NB
    Dashboard["odh-dashboard"] -->|"reads ImageStream labels"| NB
    DSP["Data Science Pipelines"] -->|"runs runtime-* images"| NB
    NB -->|"KFP REST submission"| DSP
    Trainer["Kubeflow Trainer"] -.->|"universal image reuse"| NB
    NB -->|"Ray clusters via K8s API"| KubeRay["CodeFlare / KubeRay"]
    NB -.->|"Python clients"| Platform["Feast, MLflow,<br/>Model Registry, TrustyAI"]

    %% External services at runtime
    NB -->|"S3 API, HTTPS/HTTP"| S3["S3-compatible object storage"]
    NB -->|"6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    NB -->|"pushes / references"| Registry["quay.io/rhoai<br/>registry.redhat.io/rhoai"]
    NB -.->|"user-driven, 443/22"| Git["Git remotes / GitHub<br/>BYO Copilot"]

