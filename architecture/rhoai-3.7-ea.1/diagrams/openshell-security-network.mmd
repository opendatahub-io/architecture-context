graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["CLI / SDK / Dashboard browser<br/>OIDC PKCE S256"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route<br/>443/TCP TLS passthrough<br/>gateway terminates TLS"]
        GRPCRoute["Optional: Gateway API GRPCRoute<br/>443/TCP edge + BackendTLSPolicy<br/>mTLS must be off"]
    end

    subgraph Cluster["OPENSHIFT CLUSTER"]
        direction TB
        subgraph NS_Release["Namespace: install namespace - TRUSTED CONTROL PLANE"]
            Gateway["openshell-gateway<br/>SA: release gateway SA<br/>8080/TCP gRPC+HTTPS TLS 1.2/1.3 rustls<br/>OIDC bearer / mTLS / sandbox JWT"]
            HealthMetrics["8081/TCP health HTTP no auth<br/>9090/TCP metrics HTTP no TLS default"]
            Peer["release-peer headless Service<br/>8080/TCP gRPC TLS<br/>projected SA token TokenReview"]
            DB[("SQLite PVC / PostgreSQL 5432 TLS")]
            Dash["openshell-dashboard<br/>OIDC + allowed groups"]
        end

        subgraph NS_Sup["Supervisor - TRUSTED POLICY ENFORCER"]
            Supervisor["openshell-supervisor<br/>5500/TCP gRPC TLS pinned identity<br/>bootstrap token<br/>L7 proxy + OPA + credential injection<br/>NetworkPolicy: ingress from workload pods only<br/>egress: unrestricted at K8s layer"]
        end

        subgraph NS_Sandbox["Sandbox namespace - UNTRUSTED WORKLOAD"]
            Sandbox["Sandbox Pod<br/>agent + openshell-sandbox static binary<br/>SSH 2222/TCP<br/>NetworkPolicy: ingress from gateway only"]
        end

        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OIDC["OIDC IdP - Keycloak<br/>443/TCP HTTPS JWKS"]
        Providers["Inference / model providers<br/>443/TCP HTTPS TLS 1.2+"]
        Vault["Optional: Vault/OpenBao 8200/TCP<br/>OTLP 4317/TCP"]
    end

    Client -->|gRPC/HTTPS 443<br/>TLS 1.2/1.3<br/>OIDC bearer and/or mTLS| Route
    Client -.->|gRPC 443 TLS| GRPCRoute
    Route -->|8080/TCP TLS passthrough| Gateway
    GRPCRoute -.->|8080/TCP TLS re-encrypt| Gateway
    Client -->|HTTPS OIDC| Dash
    Dash -->|gRPC/TLS 8080<br/>user bearer| Gateway
    Gateway -->|HTTPS 6443<br/>SA token<br/>CRUD + TokenReview| K8sAPI
    Gateway -->|HTTPS 443<br/>JWKS no auth| OIDC
    Gateway --> DB
    Gateway <-->|gRPC 8080 TLS<br/>Peer RPCs| Peer
    Supervisor -->|gRPC/TLS 8080<br/>client cert + sandbox JWT Ed25519 1h| Gateway
    Gateway -->|SSH 2222<br/>gateway-issued session key| Sandbox
    Sandbox -->|HTTP/CONNECT 5500<br/>TLS pinned, workload identity| Supervisor
    Supervisor -->|HTTPS 443 TLS 1.2+<br/>injected provider credential<br/>policy-approved only| Providers
    Gateway -.->|HTTPS 8200 K8s auth<br/>gRPC 4317| Vault

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef trusted fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef untrusted fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Route,GRPCRoute ingress
    class Gateway,HealthMetrics,Peer,DB,Dash,Supervisor trusted
    class Sandbox untrusted
    class OIDC,Providers,Vault externalservice
    class K8sAPI k8s
