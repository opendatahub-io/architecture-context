graph TB
    subgraph Callers["Callers (inside training pod or workbench)"]
        User["User / Notebook code"]
        SDK["Kubeflow SDK<br/>TrainingHubTrainer<br/>generated script"]
        YAML["YAML config<br/>thub --config"]
    end

    subgraph TH["training-hub v0.11.2 (in-process Python library)"]
        direction TB
        CLI["thub CLI<br/>training_hub.cli:main"]
        API["Public Python API<br/>sft / osft / lora_sft / lora_grpo / grpo / gepa / embedding_sft"]
        Registry["AlgorithmRegistry<br/>create_algorithm()"]

        subgraph Algos["Algorithms → Backends"]
            SFT["SFT → InstructLab-Training"]
            OSFT["OSFT → Mini-Trainer"]
            LoRA["LoRA SFT → Unsloth"]
            GRPO["LoRA GRPO / GRPO<br/>→ OpenPipe ART or verl"]
            GEPA["GEPA → GEPA or MLflow"]
            Emb["Embedding SFT<br/>→ SentenceTransformers"]
        end

        Callbacks["Callbacks + adapters<br/>serialize.py: base64 payload, exec() in workers"]
        JIT["JIT checkpoint<br/>flag-only SIGTERM handler + all_reduce MAX"]
        CkptMgr["Checkpoint manager<br/>pvc or fsspec URI, 4-worker uploader"]
        Prof["Profiling<br/>memory / timing estimators"]
        Viz["Visualization<br/>plot_loss"]
        Rewards["ITSRollout / rewards<br/>tool_call_reward, binary_reward"]
    end

    User --> API
    SDK --> API
    YAML -->|parsed by| CLI
    CLI -->|"importlib: dotted-path callables, no allowlist"| API
    API --> Registry
    Registry --> SFT
    Registry --> OSFT
    Registry --> LoRA
    Registry --> GRPO
    Registry --> GEPA
    Registry --> Emb
    GRPO --> Rewards
    SFT --> Callbacks
    OSFT --> Callbacks
    SFT --> JIT
    OSFT --> JIT
    JIT --> CkptMgr

    Workers["torchrun workers<br/>PET_* / MASTER_PORT 29500"]
    PVC[("Checkpoint dir<br/>on PVC")]
    S3["S3-compatible storage<br/>s3fs / botocore"]
    HF["Hugging Face Hub"]
    LLM["OpenAI-compatible LLM endpoint<br/>vLLM / KServe via LiteLLM"]
    MLflow["MLflow tracking"]
    WandB["Weights & Biases"]

    SFT -->|launches| Workers
    OSFT -->|launches| Workers
    Callbacks -->|"TRAINING_HUB_CALLBACKS_PATH (0600)"| Workers
    Workers -->|writes| PVC
    CkptMgr -->|"mirror / restore"| S3
    CkptMgr --> PVC
    API -->|models & datasets| HF
    GEPA -->|task / reflection LMs| LLM
    GRPO -->|rollouts / judge| LLM
    GEPA -->|tracking / backend| MLflow
    LoRA -->|optional metrics| MLflow
    LoRA -->|optional metrics| WandB

