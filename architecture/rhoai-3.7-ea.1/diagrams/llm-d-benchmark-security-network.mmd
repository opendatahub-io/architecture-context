graph TB
    subgraph Client["CLIENT ZONE (Operator workstation / CI runner)"]
        CLI["llmdbenchmark CLI<br/>kubeconfig or --cluster-url + token<br/>Temp files: client cert/key never deleted"]
        Discovery["llm_d_stack_discovery CLI"]
    end

    subgraph Cluster["KUBERNETES / OPENSHIFT CLUSTER (no NetworkPolicies rendered)"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>RBAC enforcement"]

        subgraph NS_Harness["Namespace: harness (PSA audit/warn: privileged)"]
            Harness["Harness Pod(s)<br/>SA: serviceAccount.name<br/>Role: inference-perf-job-creator<br/>SCC: restricted (privileged opt-in)<br/>No listeners"]
            DataAccess["Data-access Pod + Service<br/>ClusterIP 20873/TCP rsync<br/>NO AUTH, NO TLS<br/>read-only module requests"]
            PVC[("Workload PVC")]
        end

        subgraph NS_Model["Namespace: model (system under test)"]
            Gateway["Gateway / HTTPRoute<br/>Istio / agentgateway<br/>listener: scenario-defined"]
            EPP["GAIE EPP<br/>/metrics HTTPS<br/>Bearer metrics-reader SA token"]
            VLLM["vLLM pods<br/>8000/TCP HTTP<br/>pod-self-labeler Role"]
            DLJob["Model Download Job"]
        end

        subgraph NS_Mon["openshift-monitoring"]
            Thanos["Thanos Querier<br/>443/TCP HTTPS"]
        end

        DiscJob["llm-d-stack-discovery Job<br/>SA: default/llm-d-stack-discovery<br/>ClusterRole read-only (cluster-wide)<br/>UID 1000"]
    end

    subgraph External["EXTERNAL SERVICES (Internet)"]
        HF["huggingface.co<br/>443/TCP TLS 1.2+<br/>HF_TOKEN"]
        GCS["Google Cloud Storage<br/>443/TCP TLS 1.2+<br/>Google ADC"]
        Prism["prism.llm-d.ai<br/>443/TCP TLS<br/>no client auth"]
        S3["Amazon S3<br/>443/TCP TLS 1.2+<br/>AWS creds"]
        Tel["Telemetry Receiver<br/>443/TCP TLS<br/>Bearer OIDC (optional)"]
        Repos["Helm repos / registries / GitHub<br/>443/TCP TLS"]
    end

    CLI -->|"HTTPS/6443<br/>TLS, verify DISABLED for token login<br/>kubeconfig / Bearer"| APIServer
    CLI -->|"kubectl cp via API exec<br/>HTTPS/SPDY"| APIServer
    APIServer -->|exec| DataAccess
    CLI -->|"HTTPS/443<br/>curl -k (no verify)<br/>Bearer"| Thanos
    CLI -->|HTTPS/443 helm/helmfile| Repos
    CLI -->|HTTPS/443 TLS 1.2+ ADC| GCS
    CLI -.->|HTTPS/443 fallback, no auth| Prism
    CLI -->|HTTPS/443 AWS creds| S3
    CLI -.->|HTTPS/443 Bearer OIDC| Tel
    Discovery -->|HTTPS kubeconfig| APIServer

    Harness -->|"HTTP(S) OpenAI API<br/>scenario-dependent TLS<br/>none / Bearer"| Gateway
    Gateway --> EPP
    EPP -->|HTTP/8000| VLLM
    Harness -->|"HTTPS metrics port<br/>Bearer metrics-reader secret"| EPP
    Harness -->|"HTTPS/443<br/>projected SA token"| APIServer
    Harness -->|"HTTPS/443 HF_TOKEN"| HF
    Harness -->|writes| PVC
    DataAccess -->|reads| PVC
    VLLM -->|"HTTPS/443 PATCH pods<br/>SA CA or CERT_NONE fallback"| APIServer
    DLJob -->|HTTPS/443 HF_TOKEN| HF
    DiscJob -->|"HTTPS/443 SA token<br/>get/list"| APIServer

    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class CLI,Discovery client
    class APIServer,Harness,Gateway,EPP,VLLM,DLJob,Thanos,DiscJob,PVC cluster
    class DataAccess risk
    class HF,GCS,Prism,S3,Tel,Repos external
