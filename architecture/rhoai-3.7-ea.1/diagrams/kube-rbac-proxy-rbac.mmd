graph TD
    %% The repo ships no production RBAC. Rows come from test/ and examples/.
    %% Required in production: the proxy SA needs create on tokenreviews and
    %% subjectaccessreviews (equivalent to system:auth-delegator).

    subgraph ProxySide["Proxy-side RBAC (what the sidecar SA needs)"]
        direction TB
        SA_Proxy["SA: kube-rbac-proxy<br/>(test, ns default / named-captures)"]
        SA_Verb["SA: kube-rbac-proxy-verb-override<br/>(example, ns default)"]
        CRB_Proxy["ClusterRoleBinding<br/>kube-rbac-proxy / named-captures-kube-rbac-proxy"]
        CRB_Verb["ClusterRoleBinding<br/>kube-rbac-proxy-verb-override"]
        CR_Proxy["ClusterRole<br/>kube-rbac-proxy (+ named-captures variant)"]
        CR_Verb["ClusterRole<br/>kube-rbac-proxy-verb-override"]
        TR["authentication.k8s.io<br/>tokenreviews"]
        SARRes["authorization.k8s.io<br/>subjectaccessreviews"]

        SA_Proxy -->|bound via| CRB_Proxy -->|grants| CR_Proxy
        SA_Verb -->|bound via| CRB_Verb -->|grants| CR_Verb
        CR_Proxy -->|create| TR
        CR_Proxy -->|create| SARRes
        CR_Verb -->|create| TR
        CR_Verb -->|create| SARRes
    end

    subgraph ClientSide["Client-side RBAC (checked by SAR on behalf of callers)"]
        direction TB
        U_Admin["User: admin (test)"]
        SA_Default["SA: default (ns default)"]
        SA_JobReader["SA: job-reader (ns tenant-a)"]
        SA_Curl["SA: krp-curl-verb-override (ns monitoring)"]

        R_Metrics["ClusterRole: metrics"]
        R_Client["ClusterRole: kube-rbac-proxy-client"]
        R_NsMetrics["Role: namespace-metrics"]
        R_Job["Role: named-job-reader"]
        R_Pods["Role: kube-rbac-proxy-verb-override-client"]

        NR_Metrics["non-resource URL<br/>/metrics"]
        Res_SvcProxy["core<br/>services/proxy"]
        Res_NsMetrics["core<br/>namespace/metrics"]
        Res_Jobs["batch.example.io<br/>jobs"]
        Res_Pods["core<br/>pods"]

        U_Admin -->|binding: metrics| R_Metrics -->|get| NR_Metrics
        SA_Default -->|binding: kube-rbac-proxy-client| R_Client -->|get| Res_SvcProxy
        SA_Default -->|binding: namespace-metrics| R_NsMetrics -->|get| Res_NsMetrics
        SA_JobReader -->|binding: named-job-reader| R_Job -->|get| Res_Jobs
        SA_Curl -->|binding: kube-rbac-proxy-verb-override-client| R_Pods -->|list| Res_Pods
    end

    subgraph Implicit["Implicit grant (no RBAC object)"]
        PromSA["SA: openshift-monitoring:prometheus-k8s"]
        HC["Hardcoded authorizer<br/>pkg/hardcodedauthorizer/metrics.go"]
        PromSA -->|always allowed| HC -->|GET| NR_Metrics
    end

    CR_Proxy -.->|SAR checks client perms| ClientSide

    style SA_Proxy fill:#4a90e2,color:#fff
    style SA_Verb fill:#4a90e2,color:#fff
    style SA_Default fill:#4a90e2,color:#fff
    style SA_JobReader fill:#4a90e2,color:#fff
    style SA_Curl fill:#4a90e2,color:#fff
    style U_Admin fill:#4a90e2,color:#fff
    style PromSA fill:#4a90e2,color:#fff
    style CR_Proxy fill:#f5a623
    style CR_Verb fill:#f5a623
    style R_Metrics fill:#f5a623
    style R_Client fill:#f5a623
    style R_NsMetrics fill:#f5a623
    style R_Job fill:#f5a623
    style R_Pods fill:#f5a623
    style HC fill:#e57373,color:#fff
    style TR fill:#7ed321
    style SARRes fill:#7ed321
    style NR_Metrics fill:#7ed321
    style Res_SvcProxy fill:#7ed321
    style Res_NsMetrics fill:#7ed321
    style Res_Jobs fill:#7ed321
    style Res_Pods fill:#7ed321
