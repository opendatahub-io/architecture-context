graph TB
    Agent["MCP Client / AI Agent<br/>Claude Desktop, Copilot, OpenShift Lightspeed"]

    subgraph RHOAIMCP["rhoai-mcp Component"]
        direction TB
        Uvicorn["uvicorn ASGI server<br/>8000/TCP"]
        Server["rhoai-mcp server<br/>FastMCP over Starlette<br/>stdio / SSE / streamable-http"]
        Auth["Auth subsystem<br/>OIDCAuthMiddleware<br/>TokenReview / JWKS JWT<br/>SAR tool filtering"]
        PM["Plugin manager<br/>pluggy<br/>RHOAI_MCP_ENABLED_PLUGINS"]
        subgraph Domains["Domain plugins - CRUD"]
            DProjects[projects]
            DConn[connections]
            DStorage[storage]
            DInference[inference]
            DModelReg[model_registry]
            DNotebooks["notebooks<br/>(off by default)"]
            DPipelines["pipelines<br/>(off by default)"]
            DTraining["training<br/>(off by default)"]
            DPrompts["prompts<br/>(off by default)"]
        end
        subgraph Composites["Composite plugins - cross-domain"]
            CCluster["cluster-composites<br/>explore_cluster, diagnose_resource"]
            CMeta["meta-composites<br/>tool discovery"]
            CPlanner["planner-composites<br/>Navigator"]
            CTraining["training composite<br/>prepare_training"]
        end
        Planner["Embedded Planner<br/>llm-d-planner library"]
        WFToken["Workflow tokens<br/>HMAC-SHA256"]

        Uvicorn --> Server
        Server -->|OIDC mode only| Auth
        Server --> PM
        PM --> Domains
        PM --> Composites
        Composites -->|imports| Domains
        CPlanner --> Planner
        Server --> WFToken
    end

    Agent -->|"MCP JSON-RPC<br/>/sse, /messages/, /mcp"| Uvicorn

    subgraph K8sCRDs["Platform CRDs managed via Kubernetes API"]
        NS["Namespaces / Projects"]
        Secrets["Secrets - S3 data connections"]
        PVC["PVCs / PVs"]
        NB["Notebook<br/>kubeflow.org"]
        ISVC["InferenceService / ServingRuntime<br/>serving.kserve.io"]
        TJ["TrainJob / ClusterTrainingRuntime<br/>trainer.kubeflow.org"]
        DSPA["DataSciencePipelinesApplication"]
        DSC["DataScienceCluster / ModelRegistry<br/>read only"]
    end

    K8sAPI["Kubernetes / OpenShift API<br/>6443/TCP HTTPS"]
    Domains -->|kubernetes client + DynamicClient| K8sAPI
    Auth -->|TokenReview, SubjectAccessReview| K8sAPI
    K8sAPI --> NS
    K8sAPI --> Secrets
    K8sAPI --> PVC
    K8sAPI --> NB
    K8sAPI --> ISVC
    K8sAPI --> TJ
    K8sAPI --> DSPA
    K8sAPI --> DSC

    ModelRegistry["Model Registry<br/>8080 HTTP / 8443 HTTPS"]
    ModelCatalog["Model Catalog<br/>8443 HTTPS"]
    RemotePlanner["Remote Planner backend<br/>8000 HTTP, optional"]
    OIDCIssuer["OIDC Issuer<br/>JWKS, JWT mode"]
    MCPLO["MCP Lifecycle Operator<br/>MCPServer CR, optional"]
    Operator["ODH / RHOAI Operator<br/>deploys via kustomize overlay"]

    DModelReg -->|httpx REST| ModelRegistry
    Planner -->|benchmark sync| ModelCatalog
    CPlanner -.->|remote mode| RemotePlanner
    Auth -.->|discovery + JWKS| OIDCIssuer
    MCPLO -.->|reconciles Deployment/Service| RHOAIMCP
    Operator -->|deploys, injects RELATED_IMAGE| RHOAIMCP

