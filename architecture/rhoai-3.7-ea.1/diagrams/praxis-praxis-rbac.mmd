graph TD
    subgraph K8s["Kubernetes RBAC"]
        NoRBAC["No ServiceAccount, ClusterRole, Role or bindings shipped<br/>Praxis does not call the Kubernetes API"]
    end

    subgraph AppAuth["Application-level access control (in-process)"]
        DataPlane["Data plane listeners<br/>any method"]
        AdminAPI["Admin API /api/*<br/>GET/PUT/DELETE"]
        HealthAPI["Health/metrics<br/>/healthy /ready /metrics GET"]
    end

    subgraph Mechanisms["Enforcement mechanisms"]
        PolicyEng["Policy engine<br/>JWT, API key, OAuth, DPoP"]
        MTLS["mTLS client certs<br/>SPIFFE peer identity trust"]
        IPACL["IP ACL"]
        Basic["Basic auth (experimental)"]
        Loopback["Loopback-only bind<br/>+ Host check returns 421"]
        NetPol["Deployer NetworkPolicy<br/>(not shipped)"]
    end

    DataPlane -->|per filter chain| PolicyEng
    DataPlane -->|per filter chain| MTLS
    DataPlane -->|per filter chain| IPACL
    DataPlane -->|per filter chain| Basic
    AdminAPI -->|"NO auth - bind restriction only"| Loopback
    AdminAPI -.->|"override: insecure_options.allow_public_admin"| Exposed["Unauthenticated control plane<br/>KV writes, log-level changes"]
    HealthAPI -->|"NO auth - loopback Host check when loopback-bound"| Loopback
    HealthAPI -->|"when bound non-loopback"| NetPol

    style NoRBAC fill:#e8e8e8
    style DataPlane fill:#4a90e2
    style AdminAPI fill:#f5a623
    style HealthAPI fill:#f5a623
    style PolicyEng fill:#7ed321
    style MTLS fill:#7ed321
    style IPACL fill:#7ed321
    style Basic fill:#7ed321
    style Loopback fill:#7ed321
    style NetPol fill:#e8e8e8
    style Exposed fill:#f8cecc,stroke:#b85450
