graph LR
    subgraph SAs["Service Accounts"]
        SACtrl["maas-controller<br/>(applications ns)"]
        SAApi["maas-api<br/>(infra ns)"]
        SADisc["maas-discovery"]
        SAIPP["payload-processing<br/>(openshift-ingress)"]
        SACleanup["maas-api-cleanup<br/>(CronJob / revocation Jobs)"]
    end

    subgraph Bindings["Bindings"]
        CRBCtrl["CRB maas-controller-rolebinding"]
        CRBCfg["CRB maas-controller-cluster-config-rolebinding"]
        CRBOcp["CRB maas-controller-ocp-rolebinding"]
        RBLeader["RB maas-controller-leader-election-rolebinding<br/>(opendatahub)"]
        RBSecret["RB maas-controller-secret-migrate<br/>(opendatahub)"]
        CRBApi["CRB maas-api"]
        CRBDisc["CRB maas-discovery"]
        RBDiscT["RB maas-discovery (ai-tenants)"]
        RBDiscG["RB maas-discovery (openshift-ingress)"]
        CRBIPP["CRB payload-processing-reader"]
    end

    subgraph Roles["Roles"]
        CRCtrl["ClusterRole<br/>maas-controller-role"]
        CRCfg["ClusterRole<br/>maas-controller-cluster-config-role"]
        CROcp["ClusterRole<br/>maas-controller-ocp-role"]
        RLeader["Role leader-election"]
        RSecret["Role secret-migrate"]
        CRApi["ClusterRole maas-api<br/>(+ maas-api-supplemental)"]
        CRDisc["ClusterRole maas-discovery"]
        RDiscT["Role aitenants read"]
        RDiscG["Role gateways/routes read"]
        CRIPP["ClusterRole<br/>payload-processing-reader"]
    end

    subgraph Resources["API Resources"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        CoreW["core<br/>configmaps, services, serviceaccounts"]
        CoreR["core<br/>endpoints, pods, secrets (cluster-wide)"]
        NS["core<br/>namespaces"]
        Workloads["apps / autoscaling / batch<br/>deployments, HPAs, cronjobs, jobs"]
        MaaSCRs["maas.opendatahub.io<br/>maasmodelrefs, maasauthpolicies, maassubscriptions,<br/>aitenants, maastenantconfigs (+status, finalizers)"]
        MaaSTenants["maas.opendatahub.io<br/>tenants"]
        MaaSRO["maas.opendatahub.io<br/>configs, externalmodels"]
        InfCRs["inference.opendatahub.io<br/>externalmodels, externalproviders"]
        Kuadrant["kuadrant.io<br/>authpolicies, tokenratelimitpolicies,<br/>ratelimitpolicies, telemetrypolicies"]
        Istio["networking / telemetry .istio.io<br/>destinationrules, envoyfilters,<br/>serviceentries, telemetries"]
        GwAPI["gateway.networking.k8s.io<br/>gateways (read), httproutes"]
        NetPol["networking.k8s.io / discovery.k8s.io<br/>networkpolicies, endpointslices"]
        LLMD["llm-d.ai<br/>inferenceobjectives"]
        ReadOnly["serving.kserve.io llminferenceservices<br/>aigateway.opendatahub.io aiguardrails<br/>operator.authorino.kuadrant.io authorinos<br/>CRDs, dscinitializations, routes"]
        Obs["monitoring.coreos.com, opentelemetry.io, perses.dev<br/>cert-manager.io certificates"]
        SCC["security.openshift.io<br/>SCC nonroot-v2"]
        ConfigCR["maas.opendatahub.io<br/>configs (mutate default only)"]
        OCPCfg["config.openshift.io<br/>apiservers, authentications"]
        DBSecret["core secrets<br/>resourceName maas-db-config"]
        AuthAPIs["authentication.k8s.io tokenreviews<br/>authorization.k8s.io subjectaccessreviews"]
        ApiRead["services, gateways, aiguardrails,<br/>apiservers, MaaS CRs"]
        IPPCore["core configmaps, secrets<br/>(cluster-wide)"]
        IPPNet["services, httproutes,<br/>serviceentries, destinationrules"]
    end

    SACtrl --> CRBCtrl --> CRCtrl
    SACtrl --> CRBCfg --> CRCfg
    SACtrl --> CRBOcp --> CROcp
    SACtrl --> RBLeader --> RLeader
    SACtrl --> RBSecret --> RSecret
    SAApi --> CRBApi --> CRApi
    SADisc --> CRBDisc --> CRDisc
    SADisc --> RBDiscT --> RDiscT
    SADisc --> RBDiscG --> RDiscG
    SAIPP --> CRBIPP --> CRIPP
    SACleanup -.->|"TokenReview-verified caller<br/>of maas-api internal endpoints"| SAApi

    CRCtrl -->|create,delete,get,list,patch,update,watch| RBACRes
    CRCtrl -->|create,delete,get,list,patch,update,watch| CoreW
    CRCtrl -->|get,list,watch| CoreR
    CRCtrl -->|create,get,list,patch,watch| NS
    CRCtrl -->|create,delete,get,list,patch,update,watch| Workloads
    CRCtrl -->|create,delete,get,list,patch,update,watch| MaaSCRs
    CRCtrl -->|delete,get,list,patch,update,watch| MaaSTenants
    CRCtrl -->|get,list,watch| MaaSRO
    CRCtrl -->|create,delete,get,list,patch,update,watch| InfCRs
    CRCtrl -->|create,delete,get,list,patch,update,watch| Kuadrant
    CRCtrl -->|create,delete,get,list,patch,update,watch| Istio
    CRCtrl -->|get,list,watch + httproute CRUD| GwAPI
    CRCtrl -->|create,delete,get,list,patch,update,watch| NetPol
    CRCtrl -->|create,delete,get,list,patch,update,watch| LLMD
    CRCtrl -->|get,list,watch| ReadOnly
    CRCtrl -->|create,delete,get,list,patch,update,watch| Obs
    CRCtrl -->|use| SCC
    CRCfg -->|get,list,watch,create,update,patch| ConfigCR
    CROcp -->|get,list,watch| OCPCfg
    RSecret -->|create secrets, get maas-db-config| DBSecret

    CRApi -->|get| DBSecret
    CRApi -->|create| AuthAPIs
    CRApi -->|get,list,watch| ApiRead
    CRDisc -->|create| AuthAPIs
    CRDisc -->|get,list,watch| OCPCfg

    CRIPP -->|get,list,watch| IPPCore
    CRIPP -->|create,delete,get,list,patch,update,watch| InfCRs
    CRIPP -->|create,delete,get,list,patch,update,watch| IPPNet

