graph TB
    %% llm-d-batch-gateway-operator — component structure
    %% Source: architecture/rhoai-3.7-ea.1/llm-d-batch-gateway-operator.md

    subgraph Platform["Platform deployment chain"]
        RHODS["rhods-operator / opendatahub-operator<br/>DSC aigateway.batchGateway: Managed"]
        AIGW["ai-gateway-operator<br/>deploys kustomize config/base"]
        Params["params.env<br/>4 operand image digests"]
        RHODS -->|deploys| AIGW
        RHODS -->|supplies image digests| Params
    end

    subgraph OperatorNS["Namespace: redhat-ods-applications"]
        subgraph OperatorPod["llm-d-batch-gateway-operator Deployment - 1 replica, leader-elect"]
            Manager["manager - cmd/main.go<br/>scheme, flags, leader election"]
            Reconciler["LLMBatchGatewayReconciler<br/>validate, copy Secret, render, SSA,<br/>orphan delete, status conditions"]
            MetricsCtl["MetricsController<br/>own metrics Service, ServiceMonitor,<br/>PrometheusRule - needs POD_NAMESPACE"]
            Renderer["HelmRenderer<br/>helm.sh/helm/v3 engine<br/>in-memory, no releases"]
            TLSWatch["SecurityProfileWatcher<br/>restart on TLS profile change"]
            SecretFilter["secretWatchFilter<br/>dynamic Secret predicate"]
            ChartBG[("/charts/batch-gateway<br/>chart v0.1.0")]
            ChartAsync[("/charts/llm-d-async<br/>chart v0.7.0")]
            MetricsEP["/metrics :8443 HTTPS<br/>TokenReview + SAR"]
            Health["/healthz /readyz :8081 HTTP"]

            Manager --> Reconciler
            Manager --> MetricsCtl
            Manager --> TLSWatch
            Manager --> MetricsEP
            Manager --> Health
            Reconciler -->|specToBatchHelmValues<br/>specToAsyncHelmValues| Renderer
            Renderer -->|loads| ChartBG
            Renderer -->|loads| ChartAsync
            SecretFilter -.->|filters events for| Reconciler
        end
        MetricsSvc["Service llm-d-batch-gateway-operator-metrics<br/>8443/TCP, service-ca cert"]
        SM["ServiceMonitor + PrometheusRule -alerts"]
        NP["NetworkPolicy<br/>8443 only from monitoring namespaces"]
    end

    AIGW -->|deploys| OperatorPod
    Params -->|env LLM_D_* images| Manager
    MetricsCtl -->|SSA| MetricsSvc
    MetricsCtl -->|SSA| SM

    User["Namespace admin / editor"] -->|creates| LBG["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1, short name lbg"]
    LBG -->|watched by| Reconciler

    subgraph TenantNS["Namespace: workload / CR namespace"]
        APISrv["&lt;cr&gt;-apiserver Deployment + Service<br/>8000 /v1/batches, /v1/files<br/>8081 observability"]
        Proc["&lt;cr&gt;-processor StatefulSet<br/>headless Service, metrics :9090"]
        GC["&lt;cr&gt;-gc Deployment<br/>metrics :9091, GC Role/RoleBinding"]
        Async["async-processor Deployment<br/>llm-d-async"]
        CfgObjs["ConfigMaps, ServiceAccounts,<br/>Grafana dashboard ConfigMap"]
        Creds["&lt;cr&gt;-credentials Secret<br/>copy of cross-namespace secretRef"]
        OptObjs["Optional: HTTPRoute, Certificate,<br/>ServiceMonitor/PodMonitor, PrometheusRule"]
    end

    Reconciler -->|SSA, owner refs| APISrv
    Reconciler -->|SSA| Proc
    Reconciler -->|SSA| GC
    Reconciler -->|SSA| Async
    Reconciler -->|SSA| CfgObjs
    Reconciler -->|SSA if CRDs present| OptObjs
    Reconciler -->|copies data after ReferenceGrant check| Creds

    subgraph SrcNS["Secret source namespace (optional)"]
        SrcSecret["secretRef Secret<br/>postgresql-url, redis-url, S3 key, API key"]
        RG["ReferenceGrant<br/>from LLMBatchGateway to Secret"]
    end
    Reconciler -->|checks| RG
    Reconciler -->|reads| SrcSecret

    K8sAPI["Kubernetes API server<br/>6443/TCP"]
    OCPCfg["config.openshift.io/APIServer<br/>TLS security profile"]
    TLSWatch -->|watches| OCPCfg
    Reconciler <-->|watch + SSA| K8sAPI

    subgraph Backends["External operand backends"]
        PG[("PostgreSQL")]
        S3[("S3 / PVC")]
        Redis[("Redis / Valkey")]
        IGW["llm-d inference gateways / EPP"]
    end
    APISrv --> PG
    APISrv --> S3
    Proc --> PG
    Proc --> Redis
    Async --> Redis
    Async --> IGW

    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style MetricsCtl fill:#4a90e2,color:#fff
    style Renderer fill:#4a90e2,color:#fff
    style TLSWatch fill:#4a90e2,color:#fff
    style SecretFilter fill:#4a90e2,color:#fff
    style LBG fill:#f5a623
    style APISrv fill:#7ed321
    style Proc fill:#7ed321
    style GC fill:#7ed321
    style Async fill:#7ed321
    style AIGW fill:#7ed321
    style RHODS fill:#7ed321
    style PG fill:#e8e8e8
    style S3 fill:#e8e8e8
    style Redis fill:#e8e8e8
    style IGW fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style OCPCfg fill:#e8e8e8
