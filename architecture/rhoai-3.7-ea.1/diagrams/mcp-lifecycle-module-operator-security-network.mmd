graph TB
    subgraph External["EXTERNAL / CLUSTER ACTORS"]
        Admin["Cluster Admin<br/>user token"]
        Platform["opendatahub-operator /<br/>rhods-operator<br/>SA token"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph Monitoring["MONITORING (openshift-monitoring /<br/>openshift-user-workload-monitoring)"]
        Prom["Prometheus<br/>ServiceMonitor SA token"]
    end

    subgraph NS_Module["Namespace: mcp-lifecycle-module-operator-system / SYSTEM_NAMESPACE"]
        Module["Module Operator Pod<br/>SA: mcp-lifecycle-module-operator-controller-manager<br/>:8081 HTTP probes (no auth)<br/>:8443 HTTPS metrics (TokenReview+SAR)<br/>runAsNonRoot, readOnlyRootFS, drop ALL"]
        Kubelet["Kubelet probes"]
    end

    subgraph NS_Operand["Namespace: SYSTEM_NAMESPACE (default mcp-lifecycle-operator-system)"]
        WebhookSvc["webhook-service<br/>ClusterIP 443→9443/TCP<br/>TLS cert-manager self-signed"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS mcplo-metrics-server-cert"]
        Operand["Operand Pod<br/>SA: mcp-lifecycle-operator-controller-manager<br/>Secrets: mcplo-webhook-server-cert,<br/>mcplo-metrics-server-cert<br/>NetworkPolicy: allow-all egress (STOPGAP)"]
        WebhookSvc --> Operand
        MetricsSvc --> Operand
    end

    subgraph Tenants["USER NAMESPACES"]
        MCPServers["MCPServer workloads<br/>NetworkPolicy posture: restricted<br/>(deny-by-default ingress)"]
    end

    Admin -->|HTTPS/6443<br/>TLS 1.2+<br/>user token| API
    Platform -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    Module -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SSA apply, watch, GC| API
    Operand -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    API -->|HTTPS/443→9443<br/>TLS cert-manager CA<br/>/convert, /validate| WebhookSvc
    Prom -->|HTTPS/8443<br/>TLS verified<br/>Bearer token| MetricsSvc
    Prom -.->|HTTPS/8443<br/>Bearer → TokenReview+SAR<br/>no Service shipped| Module
    Kubelet -->|HTTP/8081<br/>no auth<br/>/healthz /readyz| Module
    Operand -->|creates Deployments,<br/>Services, HTTPRoutes,<br/>NetworkPolicies| MCPServers

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tenant fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Admin,Platform external
    class API control
    class Module,Kubelet,WebhookSvc,MetricsSvc,Operand internal
    class Prom monitoring
    class MCPServers tenant
