graph TB
    subgraph Untrusted["CODE-EXECUTION TRUST INPUTS"]
        YAML["thub YAML config / CLI flags<br/>dotted-path callables<br/>importlib, no allowlist"]
    end

    subgraph Pod["TRAINING POD / WORKBENCH (tenant namespace)<br/>Identity and RBAC owned by TrainJob / PyTorchJob / Notebook"]
        direction TB
        TH["training-hub library<br/>in-process, no listening service<br/>no Kubernetes API calls"]
        Env["Pod env secrets<br/>OPENAI_API_KEY, WANDB_API_KEY,<br/>AWS creds, HF_TOKEN"]
        Payload["Callback payload file<br/>base64 class source, mode 0600<br/>exec() in workers"]
    end

    subgraph JobNet["INTRA-JOB NETWORK (pods of one job, unencrypted)"]
        Peers["Peer training ranks<br/>torchrun workers<br/>29500/TCP + NCCL ports"]
    end

    subgraph Storage["SHARED STORAGE"]
        PVC[("Checkpoint PVC<br/>local FS")]
    end

    subgraph Cluster["IN-CLUSTER OR EXTERNAL PLATFORM SERVICES (URI-defined)"]
        LLM["OpenAI-compatible LLM<br/>vLLM / KServe / external<br/>via LiteLLM"]
        MLflow["MLflow tracking<br/>MLFLOW_TRACKING_URI"]
    end

    subgraph External["EXTERNAL SERVICES (Internet)"]
        HF["Hugging Face Hub<br/>huggingface.co"]
        S3["S3-compatible storage<br/>AWS_ENDPOINT_URL_S3"]
        WandB["Weights & Biases"]
    end

    Kubelet["Kubelet / Kueue<br/>preemption"]

    YAML -->|import_module| TH
    Env -.->|read by libraries| TH
    TH -->|writes| Payload
    Payload -.->|"TRAINING_HUB_CALLBACKS_PATH"| Peers
    Kubelet -->|SIGTERM| TH
    TH <-->|"c10d/NCCL 29500/TCP<br/>No encryption<br/>No auth"| Peers
    TH -->|"File I/O"| PVC
    Peers -->|"File I/O"| PVC
    TH -->|"HTTPS/443<br/>TLS library default<br/>optional HF token"| HF
    TH -->|"HTTPS/443 (endpoint-defined)<br/>TLS if https, botocore default<br/>AWS credentials"| S3
    TH -->|"HTTPS/443<br/>TLS<br/>WANDB_API_KEY"| WandB
    TH -->|"HTTP/HTTPS URI-defined<br/>TLS depends on URI<br/>OPENAI_API_KEY or dummy"| LLM
    TH -->|"HTTP/HTTPS URI-defined<br/>TLS depends on URI<br/>MLflow client auth"| MLflow

    classDef untrusted fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef storage fill:#f5a623,stroke:#333,stroke-width:1px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class YAML untrusted
    class TH,Env pod
    class Payload,Peers risk
    class PVC storage
    class LLM,MLflow internal
    class HF,S3,WandB externalservice
    class Kubelet internal
