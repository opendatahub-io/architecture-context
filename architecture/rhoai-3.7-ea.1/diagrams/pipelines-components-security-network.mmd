graph TB
    subgraph Control["PLATFORM CONTROL PLANE (cluster-internal, no network hop)"]
        ODHOp["opendatahub-operator<br/>imageParamMap"]
        DSPO["DSPO<br/>data-science-pipelines-operator"]
    end

    subgraph Tenant["TENANT NAMESPACE (DSPA / Data Science Project)"]
        direction TB
        subgraph APIPod["KFP API server pod"]
            Init["init container<br/>odh-pipelines-components<br/>no ports"]
            Vol["Shared volume<br/>/config/managed-pipelines"]
            KFP["KFP API server"]
        end
        Task["Pipeline task pods<br/>SA: DSP pipeline runner<br/>or kubernetes-credentials token<br/>Secrets mounted as env vars"]
        Starter["agentic-rag starter kit (template)<br/>8000/TCP HTTP, no app TLS<br/>TokenReview via auth_wrapper (optional)<br/>/health unauthenticated"]
    end

    subgraph ClusterSvc["CLUSTER SERVICES"]
        K8s["Kubernetes API server<br/>443/6443 TCP HTTPS<br/>in-cluster CA verified"]
        MR["Model Registry<br/>configurable port<br/>HTTP, is_secure=False"]
        VDB["Milvus / PGVector<br/>19530 gRPC / 5432 PG"]
    end

    subgraph External["EXTERNAL SERVICES (egress, unrestricted unless NetworkPolicy)"]
        S3["S3-compatible storage<br/>443/TCP HTTPS TLS 1.2+"]
        HF["Hugging Face Hub<br/>443/TCP HTTPS"]
        MaaS["MaaS / OpenAI-compatible LLM<br/>443/TCP HTTPS"]
        MLflow["MLflow<br/>443/TCP HTTPS"]
        OCI["OCI registry<br/>443/TCP HTTPS"]
    end

    ODHOp -->|RELATED_IMAGE_* env/params<br/>no network| DSPO
    DSPO -->|pod spec env<br/>no network| Init
    Init -->|filesystem write| Vol
    KFP -->|filesystem read| Vol
    KFP -->|schedules via Argo| Task

    Task -->|HTTPS/443-6443<br/>TLS in-cluster CA<br/>Bearer token| K8s
    Task -->|HTTP/configurable<br/>NO TLS<br/>NO auth| MR
    Task -->|gRPC 19530 / PG 5432<br/>TLS deployment-dependent<br/>connection secret creds| VDB
    Task -->|HTTPS/443<br/>TLS<br/>AWS access keys| S3
    Task -->|HTTPS/443<br/>TLS<br/>HF_TOKEN| HF
    Task -->|HTTPS/443<br/>TLS DSPA CA bundle<br/>API key| MaaS
    Task -->|HTTPS/443<br/>TLS<br/>MLFLOW_TRACKING_TOKEN| MLflow
    Task -->|HTTPS/443<br/>TLS<br/>OCI pull secret| OCI

    Starter -->|HTTPS/443-6443<br/>Bearer K8S_REVIEWER_TOKEN<br/>TokenReview| K8s
    Starter -->|HTTPS/443<br/>API key| MaaS
    Starter -->|gRPC 19530 / PG 5432<br/>credentials| VDB

    classDef control fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef template fill:#d5e8d4,stroke:#82b366,stroke-width:2px,stroke-dasharray: 5 5
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef insecure fill:#f8cecc,stroke:#b85450,stroke-width:3px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class ODHOp,DSPO control
    class Init,Vol,KFP,Task tenant
    class Starter template
    class K8s,VDB cluster
    class MR insecure
    class S3,HF,MaaS,MLflow,OCI externalservice
