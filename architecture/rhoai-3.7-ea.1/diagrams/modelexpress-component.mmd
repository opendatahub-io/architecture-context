graph TB
    User["User / ODH Dashboard / GitOps"]
    ODHOp["opendatahub-operator / rhods-operator<br/>(kustomize overlays/odh)"]

    subgraph OperatorNS["Operator namespace (ODH applications ns / modelexpress-operator-system)"]
        Operator["modelexpress-operator-openshift<br/>Rust / kube-rs controller<br/>image: odh-modelexpress-operator-rhel9<br/>:8081 health, :8443 TLS metrics"]
        OpMetricsSvc["Service: modelexpress-operator-metrics<br/>8443/TCP HTTPS"]
        SvcMon["ServiceMonitor<br/>(self-applied)"]
    end

    subgraph CRDs["Custom Resources"]
        MXS["ModelExpressServer<br/>modelexpress.opendatahub.io/v1alpha1<br/>(CEL-validated, no webhook)"]
        MM["ModelMetadata<br/>modelexpress.nvidia.com/v1alpha1"]
        MCE["ModelCacheEntry<br/>modelexpress.nvidia.com/v1alpha1"]
    end

    subgraph TenantNS["CR namespace (per ModelExpressServer)"]
        Deploy["Deployment: modelexpress-server<br/>image: odh-modelexpress-rhel9<br/>gRPC :8001, metrics :9401"]
        Svc["Service: &lt;cr-name&gt;<br/>ClusterIP 8001/TCP gRPC"]
        PVC["PVC<br/>model cache (optional)"]
        NP["NetworkPolicy<br/>(open unless allowFrom set)"]
        SA["ServiceAccount &lt;cr&gt;-server<br/>Role/RoleBinding &lt;cr&gt;-metadata"]
        CM["ConfigMaps<br/>tensor descriptors"]

        subgraph ServerInternals["modelexpress-server internals"]
            Auth["Tower AuthLayer<br/>TokenReview + allowlist<br/>(off by default)"]
            GRPC["gRPC services<br/>Model, P2P, Refit,<br/>RefitCollective, Api, Health"]
            Backend["Metadata backend<br/>Redis or Kubernetes CRDs"]
            Cache["Model cache + eviction"]
            Reaper["Stale P2P source reaper"]
            Auth --> GRPC
            GRPC --> Backend
            GRPC --> Cache
            Reaper --> Backend
        end
    end

    CRB["ClusterRoleBinding<br/>system:auth-delegator<br/>(enforce mode only, finalizer)"]

    Inference["Inference runtimes<br/>vLLM, SGLang, TRT-LLM, Dynamo, llm-d<br/>(ModelExpress client library)"]
    Redis["Redis<br/>(external, optional)"]
    Providers["HuggingFace / NGC / S3"]
    K8sAPI["Kubernetes API server"]
    OCPConfig["apiservers.config.openshift.io<br/>(cluster TLS profile)"]
    ServiceCA["OpenShift service-ca"]
    Prom["OpenShift monitoring / Prometheus"]

    ODHOp -->|deploys| Operator
    User -->|creates| MXS
    MXS -->|watched by| Operator
    Operator -->|SSA creates| Deploy
    Operator -->|SSA creates| Svc
    Operator -->|SSA creates| PVC
    Operator -->|SSA creates| NP
    Operator -->|SSA creates| SA
    Operator -->|creates| CRB
    Operator -->|reads TLS profile| OCPConfig
    Operator -->|creates| SvcMon
    Operator --> OpMetricsSvc

    Deploy --- ServerInternals
    Svc --> Deploy
    Backend -->|writes| MM
    Backend -->|writes| MCE
    Backend -->|writes| CM
    Backend -.->|RESP 6379| Redis
    Cache -->|stores| PVC
    Cache -->|downloads| Providers
    Auth -->|TokenReview| K8sAPI

    Inference -->|gRPC 8001| Svc
    Inference -.->|NIXL RDMA peer-to-peer weights| Inference
    ServiceCA -->|TLS certs| OpMetricsSvc
    ServiceCA -.->|optional gRPC TLS| Deploy
    Prom -->|scrapes 8443| OpMetricsSvc
    Prom -.->|scrapes 9401| Deploy

