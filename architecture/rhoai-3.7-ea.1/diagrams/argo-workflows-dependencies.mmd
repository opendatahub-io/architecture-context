graph LR
    Argo["argo-workflows<br/>workflow-controller + argoexec"]

    %% Internal RHOAI integrations
    DSPO["Data Science Pipelines Operator"] -->|deploys per DSPA,<br/>supplies argoexec image| Argo
    KFP["KFP API Server"] -->|submits Workflow CRs| Argo
    PA["KFP Persistence Agent"] -->|watches Workflow status| Argo
    Monitoring["OpenShift Monitoring"] -->|scrapes 9090/TCP| Argo
    Argo -->|artifacts and logs| MinIO["DSPA Object Store<br/>MinIO / S3"]

    %% Platform
    Argo -->|REST + watch 6443/TCP| K8sAPI["Kubernetes API"]

    %% Required libraries
    Argo -->|client/informers| ClientGo["k8s client-go v0.32.2"]
    Argo -->|S3 driver| Minio["minio-go v7.0.89"]
    Argo -->|expressions| Expr["expr-lang/expr v1.17.7,<br/>govaluate, sprig v3.3.0"]
    Argo -->|metrics| OTel["OpenTelemetry v1.39.0<br/>+ Prometheus exporter"]
    Argo -->|SSH, crypto| XCrypto["golang.org/x/crypto v0.53.0"]
    Argo -->|build| Go["Go 1.26.3<br/>GOFIPS140=v1.0.0"]

    %% Optional artifact drivers
    Argo -.->|optional| GCS["cloud.google.com/go/storage v1.50.0"]
    Argo -.->|optional| Azure["Azure azblob v1.3.2 / azidentity v1.8.2"]
    Argo -.->|optional| OSS["aliyun-oss-go-sdk v3.0.2"]
    Argo -.->|optional| HDFS["colinmarc/hdfs v2.4.0 + gokrb5 v8.4.4"]
    Argo -.->|optional| GoGit["go-git v5.14.0"]

    %% Not shipped in RHOAI
    subgraph NotShipped["argo-server only - not shipped in RHOAI"]
        GRPC["grpc v1.79.3 / grpc-gateway v1.16.0"]
        SQL["upper/db v4.7.0, mysql v1.7.1"]
        OIDC["go-oidc v3.9.0, go-jose v3.0.4"]
        Events["argo-events v1.9.6"]
    end
    Argo -.-> GRPC
    Argo -.-> SQL
    Argo -.-> OIDC
    Argo -.-> Events

    style Argo fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style DSPO fill:#7ed321,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style PA fill:#7ed321,stroke:#333
    style Monitoring fill:#7ed321,stroke:#333
    style MinIO fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style ClientGo fill:#999,stroke:#333
    style Minio fill:#999,stroke:#333
    style Expr fill:#999,stroke:#333
    style OTel fill:#999,stroke:#333
    style XCrypto fill:#999,stroke:#333
    style Go fill:#999,stroke:#333
    style GCS fill:#ddd,stroke:#333
    style Azure fill:#ddd,stroke:#333
    style OSS fill:#ddd,stroke:#333
    style HDFS fill:#ddd,stroke:#333
    style GoGit fill:#ddd,stroke:#333
    style GRPC fill:#eee,stroke:#999,stroke-dasharray: 5 5
    style SQL fill:#eee,stroke:#999,stroke-dasharray: 5 5
    style OIDC fill:#eee,stroke:#999,stroke-dasharray: 5 5
    style Events fill:#eee,stroke:#999,stroke-dasharray: 5 5
