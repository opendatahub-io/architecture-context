graph TB
    subgraph UserHost["USER HOST (workstation or one-shot container) - Trust: user"]
        Admin["Cluster Administrator"]
        Kubeconfig[("kubeconfig<br/>/kubeconfig mount or --token<br/>bearer / client cert / OIDC")]
        CLI["rhai-cli / kubectl-odh<br/>No ServiceAccount, runs as invoking user<br/>CGO + strictfipsruntime<br/>Crypto policy DEFAULT:PQ"]
        MCPSSE["MCP SSE server (hidden)<br/>127.0.0.1:8080/TCP HTTP<br/>No encryption, NO AUTH"]
        LocalProc["Local processes / AI agents"]
        Admin -->|invokes| CLI
        Kubeconfig -->|credentials| CLI
        LocalProc -->|"HTTP/8080 loopback<br/>no auth"| MCPSSE
        MCPSSE -->|executes tools with<br/>user credentials| CLI
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        API["Kubernetes / OpenShift API Server<br/>6443/TCP<br/>RBAC enforcement: user identity"]
    end

    subgraph ClusterWorkloads["CLUSTER WORKLOADS"]
        TrustyRoute["TrustyAI Service Route<br/>443/TCP HTTPS<br/>oauth proxy"]
        Pods["Workload Pods<br/>(exec target for TrustyAI data copy)"]
    end

    subgraph Internet["EXTERNAL / INTERNET"]
        GH["raw.githubusercontent.com<br/>opendatahub-io/odh-gitops"]
    end

    CLI -->|"HTTPS/6443<br/>TLS 1.2+ (client-go)<br/>kubeconfig creds<br/>--insecure-skip-tls-verify possible"| API
    API -->|"SPDY exec upgrade<br/>(via kubelet)"| Pods
    CLI -->|"HTTPS/443<br/>TLS 1.2 min, CERT VERIFY DISABLED<br/>Bearer token forwarded"| TrustyRoute
    CLI -.->|"HTTPS/443<br/>TLS system trust<br/>no auth (optional, hidden deps)"| GH

    classDef user fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Admin,Kubeconfig,CLI,LocalProc user
    class MCPSSE risk
    class API control
    class TrustyRoute,Pods workload
    class GH externalservice
