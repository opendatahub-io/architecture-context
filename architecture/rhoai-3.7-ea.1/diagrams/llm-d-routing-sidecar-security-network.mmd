graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        Gateway["Gateway (Envoy / Istio)<br/>443/TCP HTTPS<br/>Kuadrant AuthPolicy: Bearer token"]
        EPP["llm-d EPP<br/>sets x-prefiller-host-port"]
    end

    subgraph Cluster["CLUSTER POD NETWORK (no sidecar auth)"]
        subgraph NS_Tenant["Namespace: LLMInferenceService namespace"]
            subgraph DecodePod["Decode Pod"]
                Sidecar["llm-d-routing-sidecar<br/>8000/TCP HTTPS default<br/>TLS 1.2+, self-signed or service-ca<br/>Auth: None<br/>UID 65532"]
                Decode["vLLM decode<br/>localhost:8001/TCP HTTP"]
            end
            Prefill["vLLM prefill pods<br/>port from header"]
            Pool["InferencePool<br/>v1alpha2"]
        end
        Direct["Any in-cluster caller<br/>with pod-network reach"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP HTTPS"]
    end

    Client -->|"HTTPS/443<br/>TLS<br/>Bearer token"| Gateway
    Gateway -.->|"endpoint pick"| EPP
    Gateway -->|"HTTPS/8000<br/>TLS 1.2+, InsecureSkipVerify in P/D<br/>No auth"| Sidecar
    Direct -.->|"HTTPS/8000<br/>bypasses Gateway AuthPolicy"| Sidecar
    Sidecar -->|"HTTP/8001 loopback<br/>plaintext default<br/>No auth"| Decode
    Sidecar -->|"HTTP/header port<br/>plaintext default, TLS optional<br/>No auth, SSRF allowlist optional"| Prefill
    Decode -.->|"NIXL/UCX ~5557/TCP<br/>KV cache pull<br/>not sidecar-controlled"| Prefill
    Sidecar -->|"HTTPS/6443<br/>TLS<br/>SA token, only if SSRF on"| API
    API -.->|"watch"| Pool

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Gateway,EPP ingress
    class Sidecar,Decode,Prefill,Pool internal
    class Direct risk
    class API control
