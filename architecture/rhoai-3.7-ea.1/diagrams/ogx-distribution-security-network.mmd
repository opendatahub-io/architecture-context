graph TB
    %% ogx-distribution security network diagram
    %% Source: architecture/rhoai-3.7-ea.1/ogx-distribution.md
    %% Note: the repo defines no Service, Route, NetworkPolicy or RBAC; the OGX operator/platform creates them.

    subgraph External["EXTERNAL / CALLERS (Untrusted)"]
        Client["Client<br/>notebook, app, agent"]
    end

    subgraph Edge["PLATFORM EDGE (operator/platform-defined, not in this repo)"]
        EdgeTLS["Route / Gateway / mesh<br/>TLS termination if configured"]
        Praxis["Praxis proxy (test evidence)<br/>sets x-tenant-id, x-user-id"]
    end

    subgraph Cluster["CLUSTER NAMESPACE (operator-managed)"]
        OGX["OGX Server Pod<br/>image: odh-ogx-core-rhel9<br/>8321/TCP HTTP, no TLS (--insecure)<br/>Auth: none by default<br/>Optional OAuth2 JWT + owner ABAC<br/>Secrets via env or *_FILE mounts"]
        Metrics["metrics named port<br/>/metrics HTTP, no auth"]
        Prom["Prometheus<br/>ServiceMonitor 60s"]
        PG[("PostgreSQL<br/>5432/TCP")]
        VLLM["KServe / vLLM / MaaS<br/>8000 or 443/TCP"]
        VDBInt[("Milvus 19530 / pgvector 5432<br/>Qdrant 6333-6334")]
        OTel["OTLP collector<br/>4317/4318"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (443/TCP HTTPS)"]
        LLMAPIs["OpenAI, Anthropic, Azure OpenAI,<br/>AWS Bedrock, Vertex AI, Gemini, watsonx<br/>API key / IAM / GCP creds"]
        S3["S3 / S3-compatible<br/>AWS access keys"]
        Search["Brave / Tavily<br/>API key"]
        JWKS["OIDC JWKS<br/>AUTH_JWKS_URI"]
        MCP["MCP servers (user-supplied)<br/>HTTP/SSE, varies"]
    end

    Client -->|"HTTPS/443 at edge<br/>(if exposed)"| EdgeTLS
    EdgeTLS -->|"HTTP/8321 plaintext<br/>Optional Bearer JWT"| OGX
    Client -.->|"HTTP/8321 in-cluster<br/>plaintext, optional JWT"| OGX
    Praxis -.->|"HTTP/8321<br/>tenant headers"| OGX
    Prom -->|"HTTP /metrics<br/>no auth"| Metrics
    Metrics --- OGX

    OGX -->|"PostgreSQL/5432<br/>driver-default TLS<br/>user/password"| PG
    OGX -->|"HTTP or HTTPS<br/>tls_verify default true<br/>Bearer, default token fake"| VLLM
    OGX -->|"gRPC/HTTP/PG<br/>optional TLS/mTLS<br/>token / password / API key"| VDBInt
    OGX -->|"gRPC/HTTP OTLP<br/>per OTEL_* env"| OTel
    OGX -->|"HTTPS/443 TLS<br/>API key / IAM"| LLMAPIs
    OGX -->|"HTTPS/443 TLS<br/>AWS keys"| S3
    OGX -->|"HTTPS/443 TLS<br/>API key"| Search
    OGX -->|"HTTPS/443 TLS<br/>AUTH_VERIFY_TLS, no auth"| JWKS
    OGX -->|"HTTP(S)/SSE<br/>per-request auth"| MCP

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class EdgeTLS,Praxis ingress
    class PG,VLLM,VDBInt,OTel,Prom internal
    class OGX,Metrics risk
    class LLMAPIs,S3,Search,JWKS,MCP externalservice
