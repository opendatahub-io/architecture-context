graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client application"]
    end

    subgraph Ingress["INGRESS (deployer-provided, not in repo)"]
        Route["OpenShift Route / Gateway<br/>+ OAuth / kube-auth proxy<br/>TLS<br/>sets X-Forwarded-Access-Token"]
    end

    subgraph Cluster["CLUSTER INTERNAL (namespace of deployer's choosing)"]
        direction TB
        Kubelet["Kubelet / monitoring"]

        subgraph OrchPod["Orchestrator pod (UID 1001, stateless, no K8s API access)"]
            GServer["Guardrails server<br/>0.0.0.0:8033/TCP<br/>HTTP/1.1 + HTTP/2<br/>optional TLS 1.2/1.3 rustls+ring<br/>optional mTLS WebPkiClientVerifier<br/>NO caller authz"]
            HServer["Health server<br/>0.0.0.0:8034/TCP<br/>plain HTTP<br/>NO auth"]
        end

        subgraph Backends["Downstream model services"]
            Detectors["Detector services<br/>8080/TCP HTTP(S)"]
            Chunkers["Chunker services<br/>8085/TCP gRPC"]
            TGIS["TGIS<br/>8033/TCP gRPC"]
            NLP["caikit-nlp<br/>8085/TCP gRPC"]
            LLM["OpenAI-compatible LLM (vLLM)<br/>8080/TCP HTTP(S)"]
        end

        OTel["OTLP collector<br/>4317/TCP gRPC, 4318/TCP HTTP"]
    end

    Client -->|"HTTPS/443<br/>TLS<br/>user credentials"| Route
    Route -->|"HTTP(S)/8033<br/>optional TLS/mTLS<br/>X-Forwarded-Access-Token, passthrough headers"| GServer
    Kubelet -->|"HTTP/8034<br/>plaintext<br/>no auth"| HServer

    GServer -->|"HTTP(S)/8080<br/>optional TLS/mTLS (insecure: NoVerifier)<br/>Bearer api_token or rewritten token"| Detectors
    GServer -->|"gRPC/8085<br/>optional mTLS (keypair required)<br/>no auth"| Chunkers
    GServer -->|"gRPC/8033<br/>optional mTLS<br/>passthrough headers as metadata"| TGIS
    GServer -->|"gRPC/8085<br/>optional mTLS<br/>passthrough headers as metadata"| NLP
    GServer -->|"HTTP(S)/8080 JSON/SSE<br/>optional TLS/mTLS<br/>Bearer api_token or forwarded token"| LLM
    HServer -.->|"/info fan-out health checks<br/>HTTP /health, gRPC Health/Check"| Backends
    OrchPod -->|"OTLP gRPC/4317 or HTTP/4318<br/>plaintext by default<br/>no auth"| OTel

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route ingress
    class GServer,Kubelet,OTel internal
    class HServer risk
    class Detectors,Chunkers,TGIS,NLP,LLM backend
