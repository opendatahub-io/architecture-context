graph TD
    Note["No ClusterRoles or platform RBAC defined by this repo.<br/>E2E suite creates namespaced Roles/RoleBindings per test.<br/>Bindings below are from example/workshop manifests only."]

    subgraph Runtime["Runtime authentication (universal images)"]
        JupyterAuth["Jupyter 8888/TCP<br/>in-pod token disabled"]
        ProxyAuth["Workbench auth proxy<br/>(notebooks component)"]
        SSHAuth["sshd 2222/TCP<br/>public key only<br/>no root, no forwarding"]
        MPIKey["Secret: MPI SSH key<br/>mounted per job by Trainer"]
        ProxyAuth -->|enforces namespace access| JupyterAuth
        MPIKey -->|authorized_keys| SSHAuth
    end

    subgraph Tests["E2E test suite"]
        TestRBAC["Per-test namespaced<br/>Roles / RoleBindings<br/>tests/common/support/rbac.go"]
        TestCreds["env creds: AWS_*, HF_TOKEN,<br/>NOTEBOOK_USER_TOKEN"]
    end

    subgraph Demo["Example / workshop RBAC (user-applied)"]
        SA1["SA: stable-diffusion-nb<br/>ns: distributed"]
        RB1["RoleBinding: edit"]
        CR1["ClusterRole: edit"]
        SA2["SA: nfs-server-sa<br/>ns: nfs"]
        RB2["RoleBinding: nfs-server-sa-anyuid"]
        RB3["RoleBinding: nfs-server-sa-privileged"]
        SCC1["ClusterRole:<br/>system:openshift:scc:anyuid"]
        SCC2["ClusterRole:<br/>system:openshift:scc:privileged"]

        SA1 -->|bound via| RB1
        RB1 -->|grants| CR1
        SA2 -->|bound via| RB2
        SA2 -->|bound via| RB3
        RB2 -->|grants use| SCC1
        RB3 -->|grants use| SCC2
    end

    style Note fill:#fff2cc,stroke:#d6b656
    style JupyterAuth fill:#4a90e2
    style SSHAuth fill:#4a90e2
    style ProxyAuth fill:#7ed321
    style MPIKey fill:#f5a623
    style TestRBAC fill:#4a90e2
    style TestCreds fill:#f5a623
    style CR1 fill:#f5a623
    style SCC1 fill:#f8cecc,stroke:#b85450
    style SCC2 fill:#f8cecc,stroke:#b85450
