graph TB
    subgraph Workstation["ADMIN WORKSTATION (Trusted operator)"]
        Admin["Cluster Admin<br/>oc / kubectl<br/>Admin kubeconfig"]
        Bundle["Support bundle<br/>must-gather.local.*<br/>(may contain Secrets)"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP external<br/>kubernetes.default.svc:443 in-cluster<br/>RBAC enforcement"]
        Kubelet["Kubelet<br/>logs via API server proxy"]
    end

    subgraph GatherNS["Namespace: temp openshift-must-gather-* (OCP) / must-gather (xKS)"]
        Pod["must-gather pod<br/>Image: odh-must-gather-rhel9<br/>SA: temp SA (cluster-admin) or<br/>must-gather-sa (*/* get,list,watch)<br/>No listeners, no Service<br/>Crypto policy: DEFAULT:PQ"]
        FS["must-gather/ dir<br/>(pod-local, unencrypted)"]
    end

    subgraph Targets["DATA READ (all tenant + platform namespaces)"]
        Core["RHOAI core namespaces<br/>operator / applications /<br/>monitoring / notebooks"]
        Tenant["User namespaces holding<br/>watched CR kinds"]
        Sensitive["kubectl_inspect namespaces<br/>cert-manager, istio-system, LWS,<br/>monitoring, batch-gateway<br/>ALL Secrets captured unredacted"]
        Cluster["All cluster-scoped types<br/>+ node YAML"]
        HelmSec["Helm release Secrets<br/>helm get values (unfiltered)"]
    end

    subgraph External["EXTERNAL SERVICES"]
        Reg["registry.redhat.io<br/>443/TCP HTTPS TLS"]
    end

    Admin -->|"HTTPS/6443<br/>TLS<br/>Admin kubeconfig<br/>create ns/SA/binding/pod or Job"| API
    API -->|schedules| Pod
    Kubelet -->|"HTTPS/443<br/>TLS<br/>redhat-pull-secret (xKS)"| Reg
    Pod -->|"HTTPS/443<br/>TLS DEFAULT:PQ<br/>SA bearer token<br/>get/list/logs/api-resources"| API
    API -->|log proxy| Kubelet
    API --> Core
    API --> Tenant
    API --> Sensitive
    API --> Cluster
    API --> HelmSec
    Pod -->|filesystem write| FS
    FS -->|"HTTPS/6443 exec/rsync or kubectl cp<br/>TLS, Admin kubeconfig"| Bundle

    classDef workstation fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef gather fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef data fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:3px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Admin workstation
    class API,Kubelet control
    class Pod,FS gather
    class Core,Tenant data
    class Sensitive,Cluster,HelmSec,Bundle risk
    class Reg externalservice
