graph TB
    %% trustyai-service-operator (RHOAI 3.7-ea.1) - component structure
    RHODS["rhods-operator"]
    User["User / Data Scientist"]
    Dashboard["ODH Dashboard<br/>eval-hub-ui BFF"]

    TrustyAICR["TrustyAI CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster singleton: default-trustyai"]

    subgraph ModuleBox["trustyai-operator-module (image: odh-trustyai-module-operator-rhel9)"]
        Module["Module Controller<br/>metrics :8080 HTTP, no auth<br/>probes :8081"]
        Template["Bundled manifests<br/>/opt/manifests-template<br/>overlay: rhoai / odh / mcp-guardrails"]
        Module -->|renders via odh-platform-utilities| Template
    end

    subgraph OperatorBox["trustyai-service-operator manager (image: odh-trustyai-service-operator-rhel9)"]
        direction TB
        TASCtrl["TrustyAIService Reconciler<br/>TAS"]
        LMESCtrl["LMEvalJob Reconciler<br/>LMES"]
        EHCtrl["EvalHub Reconciler<br/>EVALHUB"]
        EHFail["EvalHub Failure Reconcilers<br/>Jobs / Pods / Kueue Workloads"]
        NemoCtrl["NemoGuardrails Reconciler<br/>NEMO_GUARDRAILS"]
        JobMgr["JobManager - Kueue<br/>JOB_MGR, disabled in RHOAI"]
        Profile["ProfileWatcher<br/>APIServer TLS profile"]
        Webhook["Conversion Webhook<br/>:9443 /convert"]
        Metrics["Metrics :8443 HTTPS<br/>TokenReview + SAR"]
    end

    subgraph CRDs["Namespaced CRDs - trustyai.opendatahub.io"]
        TASCR["TrustyAIService<br/>v1 storage, v1alpha1"]
        LMESCR["LMEvalJob<br/>v1alpha1"]
        EHCR["EvalHub<br/>v1 storage, v1alpha1"]
        NemoCR["NemoGuardrails<br/>v1alpha1"]
    end

    subgraph Operands["Operands in user / tenant namespaces"]
        TASPod["TrustyAI Service Pod<br/>trustyai-service 8081/8080<br/>kube-rbac-proxy 8443<br/>internal-tls-proxy 4443"]
        LMESPod["LMEvalJob Pod<br/>lm-eval + driver (18080)"]
        EHPod["EvalHub Pod<br/>evalhub 127.0.0.1:8444, metrics 8081<br/>kube-rbac-proxy 8443"]
        EHMCP["EvalHub MCP Pod (optional)<br/>evalhub-mcp 8445 behind proxy 8443"]
        EvalJobs["Evaluation Jobs<br/>tenant namespaces"]
        NemoPod["NeMo Guardrails Pod<br/>server 8000<br/>kube-rbac-proxy 8443 user / 8444 admin"]
        Routes["OpenShift Routes<br/>reencrypt (NeMo no-auth: edge)"]
        NetPol["NetworkPolicies"]
    end

    %% Deployment chain
    RHODS -->|creates / manages| TrustyAICR
    TrustyAICR -->|watched by| Module
    Template -->|SSA apply: CRDs, RBAC, Deployment| OperatorBox

    %% CR lifecycle
    User -->|creates| TASCR
    User -->|creates| LMESCR
    User -->|creates| EHCR
    User -->|creates| NemoCR
    TASCR -->|watched by| TASCtrl
    LMESCR -->|watched by| LMESCtrl
    EHCR -->|watched by| EHCtrl
    NemoCR -->|watched by| NemoCtrl
    JobMgr -.->|Kueue admission| LMESCR

    TASCtrl -->|creates| TASPod
    LMESCtrl -->|creates| LMESPod
    LMESCtrl -->|pods/exec get-status / shutdown| LMESPod
    EHCtrl -->|creates| EHPod
    EHCtrl -->|creates| EHMCP
    NemoCtrl -->|creates| NemoPod
    TASCtrl -->|creates| Routes
    EHCtrl -->|creates| Routes
    NemoCtrl -->|creates| Routes
    TASCtrl -->|creates| NetPol
    LMESCtrl -->|creates| NetPol
    EHCtrl -->|creates| NetPol
    EHPod -->|creates| EvalJobs
    EHFail -->|watches| EvalJobs
    EHFail -->|POST failure events 8443| EHPod
    Webhook -->|converts v1alpha1 / v1| TASCR
    Webhook -->|converts v1alpha1 / v1| EHCR

    %% Integrations
    KServe["KServe InferenceService<br/>/ ModelMesh"]
    Istio["Istio<br/>DestinationRule / VirtualService"]
    MLflow["MLflow<br/>mlflow.kubeflow.org"]
    Postgres["PostgreSQL<br/>(optional)"]
    Kueue["Kueue"]
    Prom["Prometheus<br/>(module precondition)"]
    ServiceCA["OpenShift service-ca"]
    APIServerCfg["OpenShift APIServer config"]

    TASCtrl -->|patches logger / MM_PAYLOAD_PROCESSORS| KServe
    TASCtrl -->|creates for Raw mode| Istio
    KServe -->|inference payloads 4443 / 8080| TASPod
    EHPod -->|experiments| MLflow
    EHPod -->|storage| Postgres
    TASPod -.->|DATABASE storage| Postgres
    EHFail -->|watches Workloads| Kueue
    Module -->|checks| Prom
    Profile -->|watches| APIServerCfg
    ServiceCA -.->|serving certs| Operands
    Dashboard -->|HTTPS 8443| EHPod

