graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        API["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforcement"]
    end

    subgraph Platform["PLATFORM OPERATORS"]
        PlatformOp["Platform Operator<br/>rhods-operator<br/>SA: platform SA"]
    end

    subgraph Monitoring["MONITORING NAMESPACES<br/>openshift-monitoring, openshift-user-workload-monitoring, redhat-ods-monitoring"]
        Prom["Prometheus"]
    end

    subgraph AppNS["APPLICATIONS NAMESPACE (spec.applicationsNamespace, e.g. redhat-ods-applications)"]
        direction TB
        subgraph ModulePod["ray-module-operator pod (NO NetworkPolicy)"]
            Module["ray-module-operator manager<br/>SA: ray-module-operator-controller-manager<br/>Image: quay.io/rhoai/odh-ray-module-operator-rhel9<br/>UID 65532, read-only root FS, /tmp emptyDir"]
        end
        MetricsSvc["Service: ray-module-operator-controller-manager-metrics-service<br/>ClusterIP 8443/TCP HTTPS<br/>TLS 1.2+ cluster profile, HTTP/1.1 only<br/>Self-signed cert (controller-runtime)"]
        Probes["Probes 8081/TCP HTTP<br/>/healthz, /readyz<br/>No auth, no TLS"]

        subgraph KubeRayPod["kuberay-operator pod (NetworkPolicy: allow-metrics-traffic)"]
            KubeRay["kuberay-operator v1.7.1<br/>SA: kuberay-operator<br/>SCC: run-as-ray-user uid 1000"]
        end
        KRMetrics["Service: kuberay-operator<br/>ClusterIP 8443/TCP HTTPS<br/>service-ca cert kuberay-operator-metrics-tls"]
        KRWebhook["Service: kuberay-webhook-service<br/>ClusterIP 443/TCP to 9443<br/>cert-manager cert kuberay-webhook-server-cert"]
        KRHealth["Health 8082/TCP<br/>(NetworkPolicy port-only allow, any source)"]
    end

    %% Flows
    PlatformOp -->|HTTPS/6443<br/>TLS 1.2+<br/>Platform SA token<br/>create Ray CR, ConfigMap, Deployment| API
    Module -->|HTTPS/6443<br/>TLS 1.2+<br/>Module SA token<br/>watch, SSA apply, TokenReview/SAR| API
    Prom -->|HTTPS/8443<br/>TLS 1.2+<br/>Bearer token| MetricsSvc
    MetricsSvc --> Module
    Module -.->|TokenReview + SAR<br/>HTTPS/6443| API
    Kubelet["Kubelet"] -->|HTTP/8081<br/>plaintext, no auth| Probes
    Probes --> Module
    Kubelet -->|HTTP/8082| KRHealth
    KRHealth --> KubeRay
    Prom -->|HTTPS/8443<br/>TLS service-ca<br/>NetworkPolicy allow-list| KRMetrics
    KRMetrics --> KubeRay
    API -->|HTTPS/443 to 9443<br/>TLS, CA injected by cert-manager<br/>AdmissionReview RayCluster CREATE/UPDATE<br/>failurePolicy: Fail| KRWebhook
    KRWebhook --> KubeRay
    KubeRay -->|HTTPS/6443<br/>TLS 1.2+<br/>kuberay-operator SA token| API

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef module fill:#4a90e2,stroke:#2a5d9f,stroke-width:2px,color:#fff
    classDef operand fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef weak fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class API controlplane
    class PlatformOp platform
    class Module,MetricsSvc module
    class KubeRay,KRMetrics,KRWebhook operand
    class Prom monitoring
    class Probes,KRHealth weak
    class Kubelet external
