graph TB
    subgraph DSP["data-science-pipelines (per DSPA namespace, deployed by DSPO)"]
        subgraph APIServerPod["ml-pipeline API server<br/>odh-ml-pipelines-api-server-v2"]
            APIServer["API Server<br/>gRPC 8887 / REST 8888"]
            Compiler["Compiler<br/>PipelineSpec IR → Argo Workflow"]
            Webhook["PipelineVersion Webhook<br/>8443 validating + mutating"]
            MLflowPlugin["MLflow Plugin<br/>experiments / runs / env injection"]
            APIServer -->|compiles via| Compiler
            APIServer -->|optional| MLflowPlugin
            APIServer -.->|when pipelinesStoreKubernetes| Webhook
        end
        PA["Persistence Agent<br/>ml-pipeline-persistenceagent"]
        SWF["ScheduledWorkflow Controller<br/>ml-pipeline-scheduledworkflow<br/>/metrics"]
    end

    subgraph TaskPod["Pipeline task pods (SA: pipeline-runner)"]
        Driver["Driver<br/>inputs, cache, K8s task config"]
        Launcher["Launcher v2<br/>wraps user container"]
        UserCode["User component container"]
        Launcher -->|executes| UserCode
    end

    User["User / ODH Dashboard / KFP SDK"] -->|REST via DSPA route + auth proxy| APIServer

    %% CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]
    SWFCR["ScheduledWorkflow CR<br/>kubeflow.org/v1beta1"]
    ViewerCR["Viewer CR<br/>kubeflow.org/v1beta1<br/>upstream only"]
    ArgoWF["Argo Workflow<br/>argoproj.io"]

    APIServer -->|creates/manages| PipelineCR
    APIServer -->|creates/manages| PipelineVersionCR
    Webhook -->|admits| PipelineVersionCR
    APIServer -->|creates| SWFCR
    APIServer -->|creates| ArgoWF
    SWFCR -->|watched by| SWF
    SWF -->|creates| ArgoWF
    SWF -->|create run gRPC 8887| APIServer
    ArgoWF -->|watched by| PA
    SWFCR -->|watched by| PA
    PA -->|ReportService gRPC 8887| APIServer
    ArgoWF -->|executed by| Argo["Argo Workflows controller"]
    Argo -->|runs| Driver
    Argo -->|runs| Launcher
    Driver -->|gRPC 8887| APIServer
    Launcher -->|gRPC 8887| APIServer

    %% Backing services
    DB[("MariaDB / MySQL / PostgreSQL<br/>3306 / 5432")]
    S3[("S3-compatible object store")]
    MLMD["MLMD gRPC<br/>metadata-grpc-service 8080"]
    MLflow["MLflow tracking server"]
    K8s["Kubernetes API 6443"]

    APIServer -->|metadata| DB
    APIServer -->|packages, artifacts| S3
    APIServer -->|lineage| MLMD
    APIServer -->|TokenReview, SAR, CRs| K8s
    Driver -->|executions, cache| MLMD
    Launcher -->|artifacts, logs| S3
    Launcher -->|publish outputs| MLMD
    MLflowPlugin -->|create experiments/runs| MLflow
    Launcher -.->|optional metrics| MLflow

    DSPO["data-science-pipelines-operator"] -->|deploys| DSP

    style APIServer fill:#4a90e2,color:#fff
    style Compiler fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style MLflowPlugin fill:#4a90e2,color:#fff
    style PA fill:#4a90e2,color:#fff
    style SWF fill:#4a90e2,color:#fff
    style Driver fill:#4a90e2,color:#fff
    style Launcher fill:#4a90e2,color:#fff
    style PipelineCR fill:#f5a623
    style PipelineVersionCR fill:#f5a623
    style SWFCR fill:#f5a623
    style ViewerCR fill:#f5a623,stroke-dasharray: 5 5
    style ArgoWF fill:#f5a623
    style DB fill:#e8e8e8
    style S3 fill:#e8e8e8
    style K8s fill:#e8e8e8
    style MLMD fill:#7ed321
    style Argo fill:#7ed321
    style MLflow fill:#7ed321
    style DSPO fill:#7ed321
