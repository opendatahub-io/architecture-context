graph TB
    subgraph ControlPlane["CLUSTER CONTROL PLANE (Trusted)"]
        EH["eval-hub service<br/>Job launcher + callback receiver"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    end

    subgraph Tenant["TENANT NAMESPACE (per-namespace boundary)"]
        subgraph Pod["Adapter Job Pod - SA: evalhub-evalhub-opendatahub-job"]
            Adapter["Adapter container<br/>odh-eval-hub-lighteval-rhel9 /<br/>odh-eval-hub-inspectai-rhel9<br/>NO inbound port<br/>UID 1001, /tmp 777, /opt/app-root g+rwX"]
            Sidecar["eval-hub sidecar<br/>localhost:8080/TCP HTTP"]
            Vols["Volumes<br/>/meta/job.json ConfigMap<br/>/var/run/secrets/model projected secret<br/>/test_data read-only"]
        end
        ToolBench["toolbench-server EXAMPLE only<br/>ClusterIP 8080/TCP HTTP<br/>no auth, NetworkPolicy same-ns"]
    end

    subgraph InClusterSvc["IN-CLUSTER PLATFORM SERVICES"]
        Model["Model serving<br/>KServe / vLLM<br/>port per endpoint"]
        MLflow["MLflow tracking<br/>HTTP/HTTPS per config"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES (Internet egress)"]
        Judge["Judge endpoint<br/>api.openai.com 443/TCP"]
        Anthropic["Anthropic API<br/>443/TCP"]
        HF["huggingface.co<br/>443/TCP"]
        GitHub["github.com /<br/>raw.githubusercontent.com<br/>443/TCP"]
        OCI["OCI registry<br/>443/TCP"]
    end

    EH -->|HTTPS/6443<br/>TLS<br/>eval-hub SA token| K8sAPI
    K8sAPI -->|creates Job, mounts secret + ConfigMap| Pod
    Vols -->|file read| Adapter
    Adapter -->|HTTP/8080 loopback<br/>plaintext pod-local<br/>Bearer reference token| Sidecar
    Sidecar -->|HTTP/HTTPS per endpoint<br/>real API key or SA token| Model
    Sidecar -->|HTTP callbacks<br/>SDK-managed| EH
    Adapter -.->|direct mode: HTTP/HTTPS<br/>Bearer API key| Model
    Adapter -->|HTTPS/443 TLS<br/>Bearer OPENAI_JUDGE_API_KEY| Judge
    Adapter -->|HTTPS/443 TLS<br/>ANTHROPIC_API_KEY| Anthropic
    Adapter -->|HTTPS/443 TLS<br/>optional HF_TOKEN| HF
    Adapter -->|HTTPS/443 TLS<br/>no auth| GitHub
    Adapter -->|HTTPS/443 TLS<br/>SDK-managed| OCI
    Adapter -->|HTTP/HTTPS<br/>SDK-managed| MLflow

    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef example fill:#eeeeee,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class EH,K8sAPI control
    class Adapter,Sidecar,Vols tenant
    class ToolBench example
    class Model,MLflow platform
    class Judge,Anthropic,HF,GitHub,OCI externalservice
