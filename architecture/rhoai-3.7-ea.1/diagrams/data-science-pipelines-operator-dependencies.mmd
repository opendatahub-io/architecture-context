graph LR
    DSPO["Data Science Pipelines Operator"]

    %% External Dependencies (libraries / operand images)
    DSPO -->|operator framework| CR["controller-runtime v0.24.1"]
    DSPO -->|K8s clients| ClientGo["client-go v0.36.0"]
    DSPO -->|template apply| Manifestival["manifestival v0.7.2"]
    DSPO -->|Routes, TLS profile| OpenShiftLibs["openshift/api, library-go,<br/>controller-runtime-common"]
    DSPO -->|DB health check| MySQLDrv["go-sql-driver/mysql v1.9.3"]
    DSPO -->|S3 health check| MinioGo["minio-go v7.0.99"]
    DSPO -->|OCI fetch| GCR["go-containerregistry v0.21.3"]
    DSPO -->|execution engine| Argo["Argo Workflows 3.6.12"]
    DSPO -->|operand images| KFP["Kubeflow Pipelines 2.16.0"]
    DSPO -.->|optional DB| MariaDB["MariaDB 10.5"]
    DSPO -.->|MLMD only| Envoy["OSSM proxyv2 Envoy 2.6"]
    DSPO -->|auth sidecar| KRP["kube-rbac-proxy"]

    %% Internal ODH Dependencies
    RHODS["rhods-operator"] -->|deploys, legacy handoff| DSPO
    DSPO -->|library| PlatformUtils["odh-platform-utilities"]
    DSPO -->|"CR read, endpoint"| MLflow["mlflow-operator / MLflow"]
    DSPO -->|ServiceMonitor, PrometheusRule| Prom["Prometheus / RHOBS"]
    DSPO -->|serving certs, CA injection| ServiceCA["OpenShift service-ca"]
    DSPO -->|TLS profile watch| OCPConfig["config.openshift.io APIServer"]
    DSPO -->|CA propagation| TrustedCA["odh-trusted-ca-bundle"]
    DSPO -.->|RBAC pass-through| KServe["KServe"]
    DSPO -.->|RBAC pass-through| Ray["Ray / CodeFlare"]
    DSPO -.->|image refs| Components["odh-pipelines-components,<br/>AutoML, AutoRAG"]

    %% Integration Points
    Dashboard["ODH Dashboard"] -->|REST 8443| DSPO

    %% External Services
    DSPO -->|"HTTPS 6443"| K8sAPI["Kubernetes API"]
    DSPO -->|"MySQL 3306"| ExtDB["External MySQL"]
    DSPO -->|"S3 443/9000"| S3["S3 Object Storage"]
    DSPO -->|"OCI 443"| Registry["Container Registries"]

