graph TB
    subgraph External["EXTERNAL (Untrusted, public internet)"]
        Browser["Browser<br/>React SPA"]
        CLI["prism-results CLI /<br/>AI coding agent"]
        Anon["Anonymous caller"]
    end

    subgraph Edge["GOOGLE FRONT END (Cloud Run managed ingress)"]
        GFE["prism.llm-d.ai<br/>443/TCP HTTPS<br/>Google-managed TLS, edge termination<br/>Invoker: allUsers (--allow-unauthenticated)"]
    end

    subgraph CR["CLOUD RUN SERVICE prism (project llm-d-prism, 0-100 instances)"]
        Server["Prism Express server<br/>8080/TCP plain HTTP<br/>trust proxy 1, 50 MB body limit<br/>rate limit 50,000 req/min/IP<br/>Identity: Cloud Run SA (ADC)"]
        AuthZ["App-level AuthZ<br/>X-Prism-Github-Token<br/>none / user / admin<br/>Playground Mode = all admin"]
    end

    subgraph GCPSaaS["GOOGLE CLOUD APIS"]
        GCS["storage.googleapis.com<br/>443/TCP HTTPS TLS<br/>GCP ADC Bearer<br/>bucket llm-d-benchmarks"]
        GIQ["gkerecommender.googleapis.com<br/>443/TCP HTTPS TLS<br/>ADC or user Bearer"]
    end

    subgraph GH["GITHUB"]
        GHOAuth["github.com/login/oauth<br/>443/TCP HTTPS TLS<br/>Client ID + secret"]
        GHAPI["api.github.com<br/>443/TCP HTTPS TLS<br/>User GitHub token"]
    end

    subgraph ClientSide["BROWSER-SIDE EGRESS (not via server)"]
        S3["S3 / Google Drive /<br/>googletagmanager<br/>443/TCP HTTPS<br/>Public / Google API key"]
    end

    Browser -->|"HTTPS/443 TLS<br/>X-Prism-Github-Token (optional)"| GFE
    CLI -->|"HTTPS/443 TLS<br/>X-Prism-Github-Token"| GFE
    Anon -->|"HTTPS/443 TLS<br/>no auth"| GFE
    GFE -->|"HTTP/8080<br/>internal to Cloud Run"| Server
    Server --> AuthZ
    AuthZ -->|"HTTPS/443<br/>validate token every request"| GHAPI
    Server -->|"HTTPS/443<br/>code exchange, refresh"| GHOAuth
    AuthZ -->|"HTTPS/443 ADC<br/>prism-iam allowlists"| GCS
    Server -->|"HTTPS/443 ADC<br/>proxy + Results Store writes<br/>results-store prefix only"| GCS
    Server -->|"HTTPS/443<br/>ADC fallback for anonymous"| GIQ
    Browser -.->|HTTPS/443| S3

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Browser,CLI external
    class Anon risk
    class GFE ingress
    class Server,AuthZ app
    class GCS,GIQ,GHOAuth,GHAPI,S3 externalservice
