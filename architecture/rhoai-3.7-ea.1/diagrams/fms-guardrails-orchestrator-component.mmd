graph TB
    Client["Client application<br/>(via deployer Route / auth proxy)"]
    Kubelet["Kubelet / monitoring"]

    subgraph Pod["fms-guardrails-orchestr8 pod (UID 1001, image odh-fms-guardrails-orchestrator-rhel9)"]
        direction TB
        GServer["Guardrails server<br/>axum, 8033/TCP<br/>HTTP/1.1 + HTTP/2<br/>optional TLS/mTLS"]
        HServer["Health server<br/>axum, 8034/TCP<br/>plain HTTP, no auth"]
        Core["Orchestrator core / task handlers<br/>chunking, detector fan-out,<br/>generation, streaming batcher"]
        Clients["Client layer<br/>tonic + ginepro LB (gRPC)<br/>hyper-rustls (HTTP)"]
        Telemetry["Telemetry<br/>OpenTelemetry SDK + tracing"]
        Config["OrchestratorConfig<br/>ORCHESTRATOR_CONFIG<br/>/app/config/config.yaml"]

        GServer -->|dispatches| Core
        HServer -->|"/info fan-out"| Clients
        Core -->|uses| Clients
        Config -->|builds clients at startup| Clients
        Core -.->|spans, metrics| Telemetry
    end

    Client -->|"POST /api/v1/task/*, /api/v2/*"| GServer
    Kubelet -->|"GET /health, /info"| HServer

    Clients -->|"REST Detector API<br/>/api/v1/text/{contents,chat,context/doc,generation}"| Detectors["Detector services<br/>guardrails-detectors, regex detector,<br/>HF detector runtime"]
    Clients -->|"gRPC ChunkersService"| Chunkers["caikit chunker services"]
    Clients -->|"gRPC fmaas.GenerationService"| TGIS["TGIS generation server"]
    Clients -->|"gRPC NlpService"| NLP["caikit-nlp"]
    Clients -->|"REST /v1/chat/completions,<br/>/v1/completions, /tokenize"| OpenAI["OpenAI-compatible LLM<br/>vLLM / KServe InferenceService"]
    Telemetry -->|"OTLP gRPC/HTTP"| OTel["OpenTelemetry collector"]

    Deployer["Deploying operator / user<br/>(not in repo; deployer not established)"] -.->|"renders config, creates<br/>Deployment/Service/Route"| Pod

    style GServer fill:#4a90e2,color:#fff
    style HServer fill:#4a90e2,color:#fff
    style Core fill:#4a90e2,color:#fff
    style Clients fill:#4a90e2,color:#fff
    style Telemetry fill:#4a90e2,color:#fff
    style Config fill:#f5a623
    style Detectors fill:#7ed321
    style Chunkers fill:#7ed321
    style TGIS fill:#7ed321
    style NLP fill:#7ed321
    style OpenAI fill:#7ed321
    style OTel fill:#e8e8e8
    style Deployer fill:#e8e8e8,stroke-dasharray: 5 5
