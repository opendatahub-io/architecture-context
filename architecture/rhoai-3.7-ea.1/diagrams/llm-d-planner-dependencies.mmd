graph LR
    Planner["llm-d-planner<br/>backend + ui"]

    %% Internal RHOAI dependencies
    Planner -->|"benchmarks, HTTPS 8443"| ModelCatalog["Model Catalog<br/>(model-registry)"]
    Planner -.->|"generates InferenceService"| KServe[KServe]
    Planner -.->|"generates kustomize / Helm values"| LLMD[llm-d]
    Planner -.->|"generates ServiceMonitor"| PromOp[Prometheus Operator]
    Planner -->|"CA bundle injection"| ServiceCA[OpenShift Service CA]

    %% Platform
    Planner -->|"list nodes, kubectl apply"| K8sAPI[Kubernetes API]
    Planner -->|"edge TLS Routes"| Router[OpenShift Router]

    %% Bundled / optional services
    Planner -->|"intent extraction, HTTP 11434"| Ollama["Ollama<br/>ollama/ollama:latest"]
    Planner -.->|"simulator mode"| Simulator["vLLM simulator"]

    %% External services
    Planner -.->|"optional LLM"| Vertex["Vertex AI (Claude)"]
    Planner -.->|"optional LLM"| OpenAI["OpenAI-compatible API"]
    Planner -->|"model configs, Arena data"| HF[HuggingFace Hub]
    Planner -->|"quality scores"| AA[Artificial Analysis]

    %% Libraries / build-time
    Planner -->|runtime| Libs["FastAPI, Streamlit, pydantic,<br/>jinja2, httpx, kubernetes"]
    Planner -->|"estimation, unpinned git HEAD"| LLMOpt["BentoML llm-optimizer"]
    Planner -.->|"base image, non-AIPCC"| PyBase["python:3.14-slim (Debian)"]

    %% Consumers
    User["Users / API clients"] -->|"HTTPS 443, no auth"| Planner

    style Planner fill:#4a90e2,stroke:#333,stroke-width:4px
    style ModelCatalog fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style LLMD fill:#7ed321,stroke:#333
    style PromOp fill:#7ed321,stroke:#333
    style ServiceCA fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style Router fill:#f5a623,stroke:#333
    style Ollama fill:#999,stroke:#333
    style Simulator fill:#4a90e2,stroke:#333
    style Vertex fill:#999,stroke:#333
    style OpenAI fill:#999,stroke:#333
    style HF fill:#999,stroke:#333
    style AA fill:#999,stroke:#333
    style Libs fill:#e8e8e8,stroke:#333
    style LLMOpt fill:#f8cecc,stroke:#b85450
    style PyBase fill:#f8cecc,stroke:#b85450
