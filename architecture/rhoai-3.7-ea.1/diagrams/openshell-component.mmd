graph TB
    User["User / Admin"]
    CLI["openshell CLI / TUI<br/>OIDC PKCE login"]
    Dashboard["openshell-dashboard<br/>separate Helm release"]

    subgraph OpenShell["OpenShell - per-namespace installation (Helm)"]
        direction TB
        subgraph GatewayPod["openshell-gateway (StatefulSet, 1 replica default)"]
            API["gRPC API openshell.v1.OpenShell<br/>+ HTTP auth/JWKS<br/>8080/TCP TLS multiplexed"]
            Auth["Auth layer<br/>OIDC bearer / mTLS / sandbox JWT<br/>method + workspace authz"]
            Prover["openshell-prover<br/>Z3 policy verification"]
            K8sDriver["openshell-driver-kubernetes<br/>in-tree compute driver"]
            CredDriver["Credential drivers<br/>DB AES-256-GCM / K8s Secrets / Vault"]
            SupCtl["openshell-supervisor-control<br/>pool assignment"]
            DB[("SQLite PVC<br/>or PostgreSQL")]
            Health["Health 8081/TCP<br/>Metrics 9090/TCP"]
            API --> Auth
            Auth --> Prover
            Auth --> K8sDriver
            Auth --> CredDriver
            Auth --> SupCtl
            Auth --> DB
            CredDriver --> DB
        end

        subgraph SupervisorTier["openshell-supervisor (shared pool or dedicated Pod)"]
            Proxy["L7 network proxy"]
            OPA["OPA/Rego - regorus<br/>+ middleware extensions"]
            Inject["Credential injection"]
            ProcRT["Process / SSH session runtime"]
            Proxy --> OPA
            OPA --> Inject
        end

        subgraph Workload["Sandbox workload (untrusted)"]
            SandboxBin["openshell-sandbox static binary<br/>FS + syscall confinement<br/>SSH 2222/TCP"]
            Agent["Agent process<br/>arbitrary agent image"]
            SandboxBin -->|confines| Agent
        end
    end

    SandboxCR["agents.x-k8s.io Sandbox CR"]
    AgentSandboxCtl["Agent Sandbox controller<br/>Kubernetes SIG"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OIDC["OIDC IdP<br/>Red Hat build of Keycloak"]
    Providers["Policy-approved endpoints<br/>inference/model APIs"]

    User --> CLI
    User --> Dashboard
    CLI -->|gRPC/TLS 443 via Route| API
    Dashboard -->|gRPC/TLS| API
    Auth -->|JWKS fetch| OIDC
    K8sDriver -->|creates| SandboxCR
    K8sDriver -->|creates Pods, Services,<br/>NetworkPolicies, Secrets| K8sAPI
    Auth -->|TokenReview| K8sAPI
    SandboxCR -->|watched by| AgentSandboxCtl
    AgentSandboxCtl -->|runs| Workload
    SupervisorTier -->|ConnectSupervisor<br/>sandbox JWT| API
    Agent -->|egress| Proxy
    Inject -->|HTTPS 443| Providers
    API -->|SSH sessions 2222| SandboxBin
    ProcRT -->|exec / sessions| SandboxBin

