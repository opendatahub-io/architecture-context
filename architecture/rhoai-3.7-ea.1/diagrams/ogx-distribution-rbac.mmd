graph TD
    %% ogx-distribution RBAC / authorization view
    %% Source: architecture/rhoai-3.7-ea.1/ogx-distribution.md
    %% The repo defines NO Kubernetes RBAC (no ClusterRole, Role, binding or ServiceAccount).
    %% The OGX server does not call the Kubernetes API. Authorization is in-process ABAC.

    subgraph K8sRBAC["Kubernetes RBAC"]
        None["None defined in this repo<br/>Pod SA and Service are created<br/>by the OGX operator"]
    end

    subgraph AuthN["Authentication (in-process, opt-in)"]
        NoAuth["Default: unauthenticated<br/>(AUTH_ISSUER unset)"]
        JWT["OAuth2 JWT bearer (oauth2_token)<br/>validated against AUTH_JWKS_URI<br/>audience: ogx"]
    end

    subgraph ABAC["ABAC Access Policy (config.yaml:269-280)"]
        R1["Rule: read<br/>unowned resources -> everyone"]
        R2["Rule: create<br/>any authenticated user"]
        R3["Rule: read, update, delete<br/>owner only"]
    end

    subgraph Resources["OGX API Resources"]
        Owned["Owned: files, vector stores,<br/>responses, conversations, batches"]
        Unowned["Unowned: models, providers<br/>(world-readable)"]
        Metrics["/metrics<br/>no auth"]
    end

    subgraph Build["Build-time identity"]
        PipelineSA["Konflux pipeline SA<br/>build-pipeline-odh-ogx-core-v3-7-ea-1"]
        IndexSecret["rhel-ai-private-index-auth<br/>build secret"]
        Quay["quay.io/rhoai/odh-ogx-core-rhel9"]
    end

    JWT -->|identity: JWT subject| ABAC
    NoAuth -.->|no enforcement| Resources
    R1 --> Unowned
    R2 --> Owned
    R3 --> Owned
    PipelineSA -->|push| Quay
    PipelineSA -->|uses| IndexSecret

    style None fill:#e8e8e8
    style NoAuth fill:#f8cecc
    style Metrics fill:#f8cecc
    style JWT fill:#4a90e2,color:#fff
    style R1 fill:#f5a623
    style R2 fill:#f5a623
    style R3 fill:#f5a623
    style Owned fill:#7ed321
    style Unowned fill:#7ed321
    style PipelineSA fill:#4a90e2,color:#fff
