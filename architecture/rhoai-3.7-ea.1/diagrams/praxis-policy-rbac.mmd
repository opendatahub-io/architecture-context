graph TD
    Note["praxis-policy defines NO Kubernetes RBAC<br/>(no ServiceAccount, Role, ClusterRole or binding).<br/>Kubernetes RBAC belongs to the host deployment (Praxis)."]

    subgraph HostIdentity["Host identity (Praxis deployment)"]
        HostSA["Host pod ServiceAccount<br/>(defined by host)"]
    end

    subgraph AppAuthZ["Application-level authorization (enforced in-process)"]
        Principal["Authenticated principal<br/>JWT (DPoP optional) or API key"]
        APL["APL predicates<br/>require(role.x)"]
        PDP["PDPs<br/>Cedar / CEL / OPA"]
        Taint["Session Taint<br/>(principal-bound)"]
        Delegate["delegate(...) action<br/>RFC 8693 / Vault"]
    end

    subgraph Resources["Protected route types"]
        Tool[tool]
        Resource[resource]
        Prompt[prompt]
        LLM[llm]
        HTTP[http]
    end

    subgraph External["Credential-scoped external access"]
        VaultKV["Vault KV v2<br/>/v1/{mount}/data/..."]
        Upstream["Upstream service<br/>audience-scoped token"]
    end

    HostSA -->|"Kubernetes auth login (SA JWT)"| VaultKV
    Principal -->|evaluated by| APL
    Principal -->|evaluated by| PDP
    APL -->|allow / deny| Tool
    APL -->|allow / deny| Resource
    APL -->|allow / deny| Prompt
    PDP -->|allow / deny| LLM
    PDP -->|allow / deny| HTTP
    Taint -->|restricts data flow| Tool
    APL --> Delegate
    Delegate -->|scoped token| Upstream

    style Note fill:#fff2cc,stroke:#d6b656
    style HostSA fill:#4a90e2,color:#fff
    style Principal fill:#4a90e2,color:#fff
    style APL fill:#f5a623
    style PDP fill:#f5a623
    style Taint fill:#f5a623
    style Delegate fill:#f5a623
    style Tool fill:#7ed321
    style Resource fill:#7ed321
    style Prompt fill:#7ed321
    style LLM fill:#7ed321
    style HTTP fill:#7ed321
