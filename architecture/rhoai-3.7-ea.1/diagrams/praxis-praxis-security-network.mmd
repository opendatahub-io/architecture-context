graph TB
    subgraph External["EXTERNAL / DOWNSTREAM (Untrusted)"]
        Client["Clients<br/>HTTP/1.1, HTTP/2, gRPC, WS, TCP"]
    end

    subgraph Cluster["CLUSTER (deployer-defined; no Service/NetworkPolicy shipped)"]
        Probes["Kubelet / Prometheus"]
    end

    subgraph Pod["PRAXIS POD / PROCESS (non-root; config from mounted YAML)"]
        direction TB
        Listener["Data plane listener<br/>0.0.0.0:8080/TCP default<br/>optional TLS 1.2/1.3 rustls + OpenSSL<br/>EMS required on TLS 1.2"]
        Pipeline["Filter pipeline<br/>JWT/API key/DPoP via Policy, mTLS/SPIFFE,<br/>IP ACL, basic auth experimental,<br/>rate limit, SSRF screening"]
        Metrics["Health/metrics listener<br/>127.0.0.1:9902/TCP default<br/>HTTP, NO TLS, NO AUTH<br/>/healthy /ready /metrics"]
        subgraph Loopback["LOOPBACK ONLY"]
            Admin["Admin API 9901/TCP<br/>HTTP, NO TLS, NO AUTH<br/>/api/kv/* PUT/DELETE, /api/log-level PUT<br/>Host check returns 421"]
            LocalOp["Local operator"]
        end
        Listener --> Pipeline
    end

    subgraph Egress["EXTERNAL / UPSTREAM SERVICES"]
        Upstream["Upstream clusters<br/>configured port<br/>optional TLS / mTLS / SPIFFE pinning"]
        SubReq["Sub-request destinations<br/>guardrails / policy callouts"]
        OTLP["OTLP collector<br/>gRPC / HTTP"]
        Syslog["Syslog / file sinks<br/>UDP/TCP/Unix"]
    end

    Client -->|"8080/TCP<br/>HTTP(S)<br/>optional TLS 1.2/1.3<br/>optional mTLS / JWT / API key"| Listener
    Probes -->|"9902/TCP HTTP<br/>plaintext<br/>no auth"| Metrics
    LocalOp -->|"9901/TCP HTTP<br/>plaintext, no auth"| Admin
    Pipeline -->|"configured port<br/>HTTP/1.1, HTTP/2, gRPC, TCP<br/>optional TLS<br/>client cert / injected credential"| Upstream
    Pipeline -->|"HTTP, optional TLS<br/>authority-bound credentials"| SubReq
    Pipeline -->|"gRPC / HTTP protobuf<br/>optional TLS, no auth"| OTLP
    Pipeline -->|"plaintext, no auth"| Syslog

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Probes cluster
    class Listener,Pipeline,LocalOp internal
    class Admin,Metrics risk
    class Upstream,SubReq,OTLP,Syslog externalservice
