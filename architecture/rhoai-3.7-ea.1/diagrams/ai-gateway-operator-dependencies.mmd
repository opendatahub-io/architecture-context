graph LR
    Op["AI Gateway Operator"]

    %% External Go dependencies
    Op -->|manager, cache, metrics| CR["controller-runtime v0.24.1"]
    Op -->|API types, clients| K8sLibs["k8s.io/* v0.36.2"]
    Op -->|reconciler framework| ODHLib["opendatahub-operator/v2 lib"]
    Op -->|TLS profile types| OSAPI["openshift/api"]
    Op -->|TLS profile watcher| CRCommon["openshift/controller-runtime-common"]
    Op -->|release status| OFAPI["operator-framework/api v0.42.0"]
    Op -->|CLI / config| CobraViper["cobra v1.10.2 / viper v1.21.0"]

    %% Parent platform
    Platform["rhods-operator / opendatahub-operator"] -->|deploys, injects RELATED_IMAGE_*,<br/>odh-aigateway-config| Op
    Op -->|reads| DSCI["DSCInitialization"]

    %% Managed sub-components
    Op -->|lifecycle, teardown handshake| MaaS["models-as-a-service<br/>maas-controller, maas-api"]
    Op -->|lifecycle, MaaS toggle| AIGWC["ai-gateway-controller"]
    Op -->|lifecycle| Batch["llm-d batch gateway operator"]
    Op -->|lifecycle, CRD watch| Grid["Praxis AI Grid operator"]

    %% RBAC escalation for vendored resources
    Op -.->|vendored resources| Istio["Gateway API / OSSM Istio"]
    Op -.->|vendored policies| Kuadrant["Kuadrant / Authorino RHCL"]
    Op -.->|Certificates| CertMgr["cert-manager"]
    Op -.->|vendored observability| OTel["OpenTelemetry / Perses / Loki"]
    Op -.->|ServiceMonitors, PrometheusRules| PromOp["Prometheus Operator"]
    MaaS -.->|llminferenceservices read| KServe["KServe"]
    AIGWC -.->|nemoguardrails read| TrustyAI["TrustyAI"]

    %% Infrastructure
    Op -->|HTTPS 6443| K8sAPI["Kubernetes API server"]
    ServiceCA["OpenShift service-ca"] -->|metrics serving cert| Op
    Prom["Prometheus"] -->|scrape HTTPS 8443| Op

