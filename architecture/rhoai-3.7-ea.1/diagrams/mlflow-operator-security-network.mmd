graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / SDK / Browser"]
    end

    subgraph Ingress["INGRESS - namespace openshift-ingress"]
        Gateway["data-science-gateway<br/>443/TCP HTTPS<br/>TLS terminated, re-encrypt to backend<br/>HTTPRoutes /mlflow, /mlflow-artifacts"]
    end

    subgraph Cluster["CLUSTER INTERNAL"]
        subgraph NS_Apps["Namespace: redhat-ods-applications"]
            Operator["mlflow-operator manager<br/>SA: mlflow-operator-controller-manager<br/>:8081 HTTP probes, no auth<br/>:8443 HTTPS metrics, TokenReview+SAR"]
            MLflow["mlflow tracking server<br/>SA: mlflow-sa<br/>8443/TCP HTTPS, cert mlflow-tls<br/>kubernetes-auth SSAR"]
            Artifacts["mlflow-artifacts, optional<br/>8443/TCP HTTPS, cert mlflow-artifacts-tls"]
        end
        subgraph NS_Mon["Monitoring namespaces"]
            Prom[Prometheus]
        end
        subgraph NS_Tenant["Tenant namespaces (other)"]
            InCluster["Workbenches / Pipelines / Dashboard"]
        end
        API["kube-apiserver<br/>6443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        DB["PostgreSQL 5432 / MySQL 3306<br/>TLS per URI<br/>DB creds from Secret"]
        Obj["Object storage<br/>443 / 9000 / 8333 / 8334<br/>Cloud/S3 credentials"]
    end

    Client -->|HTTPS/443<br/>TLS<br/>Bearer token| Gateway
    Gateway -->|HTTPS/8443<br/>TLS service-ca<br/>Bearer forwarded| MLflow
    Gateway -->|HTTPS/8443<br/>TLS<br/>Bearer forwarded| Artifacts
    InCluster -->|HTTPS/8443<br/>NetworkPolicy allows all namespaces<br/>Bearer token| MLflow
    Prom -->|HTTPS/8443<br/>TLS cluster profile<br/>TokenReview+SAR| Operator
    Prom -.->|HTTPS/8443<br/>ServiceMonitor insecureSkipVerify default| MLflow
    Operator -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    MLflow -->|HTTPS/6443<br/>SSAR with caller token| API
    MLflow -->|SQL 5432/3306| DB
    MLflow -->|HTTPS/HTTP| Obj
    Artifacts -->|HTTPS/HTTP| Obj

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class Operator,MLflow,Artifacts,Prom,InCluster,API internal
    class DB,Obj externalservice
