graph TB
    Platform["opendatahub-operator / rhods-operator"]
    PlatformCM["ConfigMap<br/>odh-mcplifecycleoperator-config<br/>(optional)"]
    ModuleCR["MCPLifecycleOperator/default<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster-scoped singleton"]

    subgraph Module["MCP Lifecycle Module Operator (/manager)"]
        Reconciler["MCPLifecycleOperatorReconciler<br/>render → SSA apply → GC → readiness<br/>→ conversion gate → storage migration"]
        Kustomize["KustomizeProvider<br/>embedded operand YAML + transforms"]
        TLS["TLS resolver +<br/>SecurityProfileWatcher"]
        GwDisc["Gateway discovery<br/>(dynamic informers)"]
        SVM["Storage migration driver"]
        Deployer["SSA Deployer<br/>field owner: mcplifecycleoperator"]
        Reconciler --> Kustomize
        Reconciler --> TLS
        Reconciler --> GwDisc
        Reconciler --> SVM
        Kustomize -->|rendered manifests| Deployer
    end

    subgraph Operand["Operand resources (SYSTEM_NAMESPACE, label part-of=mcplifecycleoperator)"]
        OperandDep["Deployment<br/>mcp-lifecycle-operator-controller-manager<br/>webhooks :9443, metrics :8443"]
        CRDs["CRDs: MCPServer v1beta1/v1alpha1<br/>MCPGatewayBinding v1alpha1"]
        RBAC["ClusterRoles / Bindings<br/>Role / RoleBinding, SA"]
        Svcs["Services: webhook 443→9443<br/>metrics 8443"]
        Certs["cert-manager Issuer (self-signed)<br/>+ Certificates"]
        VWC["ValidatingWebhookConfiguration<br/>(failurePolicy Fail)"]
        SM["ServiceMonitor"]
        NP["NetworkPolicy<br/>(stopgap allow-all egress)"]
    end

    SVMObj["StorageVersionMigration<br/>mcpservers-v1beta1"]
    MCPServer["MCPServer CRs<br/>(user namespaces)"]

    Platform -->|creates| ModuleCR
    Platform -->|provides| PlatformCM
    Platform -->|env: SYSTEM_NAMESPACE,<br/>RELATED_IMAGE_*| Module
    ModuleCR -->|watched by| Reconciler
    PlatformCM -->|read by| Reconciler
    Deployer -->|creates / updates / GCs| OperandDep
    Deployer --> CRDs
    Deployer --> RBAC
    Deployer --> Svcs
    Deployer --> Certs
    Deployer --> VWC
    Deployer --> SM
    Deployer --> NP
    SVM -->|creates| SVMObj
    Reconciler -->|LIST v1beta1<br/>conversion gate| MCPServer
    OperandDep -->|reconciles| MCPServer

    APIServer["OpenShift APIServer<br/>TLS profile"]
    Kuadrant["Kuadrant MCPGatewayExtension<br/>+ Gateway API"]
    CertManager["cert-manager"]
    Migrator["kube-storage-version-migrator"]
    APIServer -->|watched by| TLS
    GwDisc -->|discovers| Kuadrant
    Certs -.->|issued by| CertManager
    SVMObj -.->|served by| Migrator

    style Reconciler fill:#4a90e2
    style Kustomize fill:#4a90e2
    style TLS fill:#4a90e2
    style GwDisc fill:#4a90e2
    style SVM fill:#4a90e2
    style Deployer fill:#4a90e2
    style ModuleCR fill:#f5a623
    style CRDs fill:#f5a623
    style MCPServer fill:#f5a623
    style SVMObj fill:#f5a623
    style Platform fill:#7ed321
    style OperandDep fill:#7ed321
    style APIServer fill:#e8e8e8
    style Kuadrant fill:#e8e8e8
    style CertManager fill:#e8e8e8
    style Migrator fill:#e8e8e8
