graph TD
    subgraph SAs["Service Account"]
        SA["eval-hub ServiceAccount<br/>(operator-provisioned)"]
        JobSA["Job pod ServiceAccount<br/>automountServiceAccountToken: false"]
    end

    subgraph Bindings["RoleBindings (per tenant namespace)"]
        RB["Operator-provisioned RoleBindings<br/>no manifests in repo"]
    end

    subgraph Role["Role Permissions (inferred from k8s_helper.go)"]
        R["eval-hub job orchestration role"]
    end

    subgraph Resources["API Resources (tenant namespace)"]
        Jobs["batch<br/>jobs"]
        CMSec["core<br/>configmaps, secrets"]
        Pods["core<br/>pods, pods/log"]
        Events["core / events.k8s.io<br/>events"]
        NetPol["networking.k8s.io<br/>networkpolicies"]
        HWP["infrastructure.opendatahub.io<br/>hardwareprofiles"]
        LQ["kueue.x-k8s.io<br/>localqueues"]
    end

    subgraph AppAuth["Application-level AuthN/AuthZ"]
        Caller["Caller Bearer token"]
        KRP["kube-rbac-proxy<br/>TokenReview + SubjectAccessReview"]
        Headers["X-Tenant / X-User headers<br/>presence check only"]
        Tenant["Tenant-scoped SQL queries<br/>+ Job namespace"]
    end

    SA -->|bound via| RB
    RB -->|grants| R
    R -->|create, get, list, delete, patch| Jobs
    R -->|create, get, list, delete, update| CMSec
    R -->|list, get| Pods
    R -->|create| Events
    R -->|create, get, update| NetPol
    R -->|get, list, delete| HWP
    R -->|list| LQ
    JobSA -.->|no K8s API credential| Pods

    Caller --> KRP
    KRP -->|injects| Headers
    Headers -->|scopes| Tenant

    style SA fill:#4a90e2,color:#fff
    style JobSA fill:#4a90e2,color:#fff
    style RB fill:#f5a623
    style R fill:#f5a623
    style Jobs fill:#7ed321
    style CMSec fill:#7ed321
    style Pods fill:#7ed321
    style Events fill:#7ed321
    style NetPol fill:#7ed321
    style HWP fill:#7ed321
    style LQ fill:#7ed321
    style KRP fill:#ffe6cc
    style Headers fill:#f8cecc
