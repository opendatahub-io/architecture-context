graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>UI / SDK / notebook<br/>Bearer token"]
    end

    subgraph Ingress["INGRESS (openshift-ingress / router)"]
        GW["data-science-gateway<br/>443/TCP HTTPS<br/>TLS terminated at gateway<br/>HTTPRoute in redhat-ods-applications"]
        Router["OpenShift Router<br/>Route {name}-https / model-catalog-https<br/>443/TCP reencrypt"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        KAPI["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph AppNS["Namespace: redhat-ods-applications (operators)"]
        AIHub["aihub-controller-manager<br/>SA: aihub-controller-manager<br/>metrics 8443 HTTPS (authn/authz)"]
        MROp["model-registry-operator-controller-manager<br/>webhooks 9443 / metrics 8443"]
        CatOp["catalog-controller-manager<br/>webhook 9443"]
    end

    subgraph InstNS["Namespace: rhoai-model-registries (instances)"]
        subgraph RegPod["{registry-name} pod"]
            RegProxy["kube-rbac-proxy<br/>8443/TCP HTTPS (service-ca)<br/>TokenReview + SAR"]
            REST["rest-container<br/>8080/TCP HTTP (loopback)"]
        end
        RegPG["{registry-name}-postgres<br/>5432/TCP plaintext<br/>password auth"]
        subgraph CatPod["model-catalog pod"]
            CatProxy["kube-rbac-proxy<br/>8443/TCP HTTPS"]
            CatSrv["catalog<br/>8080/TCP HTTP"]
        end
        CatPG["model-catalog-postgres<br/>5432/TCP plaintext<br/>PVC-backed"]
        Jobs["Async upload Jobs<br/>from OpenShift Templates"]
    end

    subgraph Monitoring["Monitoring namespaces"]
        Prom["Prometheus<br/>ServiceMonitor scrape"]
    end

    subgraph ExtSvc["EXTERNAL SERVICES"]
        ExtDB["User PostgreSQL / MySQL<br/>5432 / 3306<br/>TLS optional (sslMode default disable)"]
        Reg["registry.redhat.io<br/>ai-hub-catalog-rhel9:stable<br/>443/TCP TLS"]
        S3["HF / S3 / OCI<br/>async upload Jobs<br/>443/TCP TLS"]
    end

    Client -->|"HTTPS/443<br/>TLS<br/>Bearer token"| GW
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer token"| Router
    GW -->|"HTTPS/8443<br/>TLS service-ca<br/>/model-registry/{name}/"| RegProxy
    GW -->|"HTTPS/8443<br/>/catalog/"| CatProxy
    Router -->|"HTTPS/8443 reencrypt"| RegProxy
    Router -->|"HTTPS/8443 reencrypt"| CatProxy
    RegProxy -->|"HTTP/8080 loopback<br/>no auth"| REST
    CatProxy -->|"HTTP/8080"| CatSrv
    RegProxy -->|"HTTPS/6443<br/>TokenReview + SAR<br/>auth-delegator"| KAPI
    CatProxy -->|"HTTPS/6443<br/>TokenReview + SAR"| KAPI
    REST -->|"PostgreSQL/5432<br/>plaintext, password"| RegPG
    REST -.->|"5432 / 3306<br/>optional TLS"| ExtDB
    CatSrv -->|"PostgreSQL/5432<br/>plaintext, password"| CatPG

    KAPI -->|"HTTPS 443→9443<br/>TLS service-ca<br/>admission, failurePolicy Fail"| MROp
    KAPI -->|"HTTPS 443→9443<br/>admission"| CatOp
    AIHub -->|"HTTPS/6443<br/>SA token, SSA"| KAPI
    MROp -->|"HTTPS/6443 SA token"| KAPI
    CatOp -->|"HTTPS/6443 SA token"| KAPI
    Prom -->|"HTTPS/8443<br/>Bearer + SAR"| AIHub
    Prom -->|"HTTPS/8443<br/>Bearer + SAR"| MROp
    KAPI -.->|"image import<br/>HTTPS/443 pull secret"| Reg
    Jobs -.->|"HTTPS/443<br/>user Secrets"| S3

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class GW,Router ingress
    class AIHub,MROp,CatOp,RegProxy,CatProxy,CatSrv,Prom,Jobs internal
    class KAPI control
    class ExtDB,Reg,S3 externalservice
    class REST,RegPG,CatPG risk
