graph TB
    subgraph Image["odh-mlmd-grpc-server-rhel9 image (shipped by Konflux)"]
        Server["metadata_store_server<br/>C++ gRPC server<br/>0.0.0.0:8080 (--grpc_port)"]
        Impl["MetadataStoreServiceImpl / MetadataStore<br/>Put/Get RPCs, schema init and migration"]
        subgraph Sources["RDBMS metadata sources"]
            MySQLSrc["MySQL/MariaDB source<br/>mysql_metadata_source.cc"]
            PGSrc["PostgreSQL source<br/>postgresql_metadata_source.cc"]
            FakeSrc["SQLite / in-memory fake<br/>sqlite_metadata_source.cc"]
        end
        Server -->|dispatches RPCs| Impl
        Impl -->|default / mysql mode| MySQLSrc
        Impl -->|postgresql mode| PGSrc
        Impl -.->|silent fallback when no DB configured| FakeSrc
    end

    subgraph NotShipped["In repo, not shipped in this release"]
        PyClient["ml_metadata Python package<br/>pybind11 + gRPC client"]
        GoSwig["Go SWIG bindings<br/>legacy"]
        OtherDF["Other Dockerfiles<br/>upstream / fedora / redhat / dev / manylinux"]
    end

    DSPO["data-science-pipelines-operator<br/>(inferred)"] -->|deploys image, supplies DB flags| Server
    KFP["DSP driver / launcher / API server<br/>(inferred)"] -->|gRPC 8080| Server
    Envoy["metadata-envoy gRPC-Web proxy<br/>DSP UI (inferred)"] -->|gRPC 8080| Server
    PyClient -.->|gRPC client| Server

    MySQLSrc -->|MySQL wire 3306/TCP| MariaDB[("MariaDB / MySQL<br/>DSPA DB or external")]
    PGSrc -->|PostgreSQL wire 5432/TCP| Postgres[("PostgreSQL")]

    BoringSSL["BoringSSL (pinned, static)<br/>non-FIPS-validated"] -.->|linked into gRPC + MariaDB connector| Server

    style Server fill:#4a90e2
    style Impl fill:#4a90e2
    style MySQLSrc fill:#4a90e2
    style PGSrc fill:#4a90e2
    style FakeSrc fill:#f5a623
    style PyClient fill:#e8e8e8,stroke-dasharray: 5 5
    style GoSwig fill:#e8e8e8,stroke-dasharray: 5 5
    style OtherDF fill:#e8e8e8,stroke-dasharray: 5 5
    style DSPO fill:#7ed321
    style KFP fill:#7ed321
    style Envoy fill:#7ed321
    style MariaDB fill:#e8e8e8
    style Postgres fill:#e8e8e8
    style BoringSSL fill:#ff9999
