graph TD
    subgraph K8sRBAC["Kubernetes RBAC"]
        None["No ClusterRoles, Roles or Bindings<br/>defined in this repository.<br/>The server does not call the Kubernetes API."]
        OperatorNote["Pod ServiceAccount and RBAC<br/>are owned by the TrustyAI operator"]
    end

    subgraph AppAuth["Application-level access (effective permissions)"]
        Caller["Any caller reaching<br/>Service 8000/TCP"]
        App["Guardrails Server<br/>no in-app authN/authZ"]
        Endpoints["Endpoints<br/>POST /v1/chat/completions<br/>POST /v1/checks, /v1/guardrail/checks<br/>GET /v1/models, /v1/rails/configs,<br/>/v1/challenges, /v1/health, /healthz, /"]
        Configs["Any config_id under /app/config<br/>path-traversal guard only"]
    end

    subgraph Creds["Credentials used outbound"]
        EnvKey["Static env API key<br/>OPENAI_API_KEY / provider key"]
        XAuth["X-Authorization header<br/>mapped to Authorization"]
        InAuth["Inbound Authorization header<br/>forwarded on /v1/models only"]
        LLM["Main LLM / Provider"]
    end

    Caller -->|unauthenticated| App
    App -->|exposes| Endpoints
    App -->|selects| Configs
    App -->|priority 1| EnvKey
    App -->|fallback, generation path| XAuth
    App -->|fallback, /v1/models path| InAuth
    EnvKey -->|Bearer| LLM
    XAuth -->|Bearer| LLM
    InAuth -->|Bearer| LLM

    style None fill:#e8e8e8
    style OperatorNote fill:#e8e8e8
    style App fill:#4a90e2
    style Caller fill:#f8cecc
    style Endpoints fill:#7ed321
    style Configs fill:#7ed321
    style EnvKey fill:#f5a623
    style XAuth fill:#f5a623
    style InAuth fill:#f8cecc
    style LLM fill:#7ed321
