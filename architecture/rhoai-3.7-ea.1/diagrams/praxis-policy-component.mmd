graph TB
    subgraph Host["Praxis proxy (host process, RHOAI)"]
        Listener["Network listener<br/>(host-owned inbound HTTP)"]
        Transport["Pingora-backed HttpTransport<br/>(injected by host)"]

        subgraph PPE["praxis-policy (embedded library, v0.6.0)"]
            Facade["praxis-policy facade<br/>crates/ppe<br/>crypto_capability_report()"]
            Core["ppe-core<br/>PolicyEngine, executor, hooks,<br/>HttpTransport trait, crypto backend"]
            Orch["ppe-orchestration<br/>async branch concurrency"]
            Runtime["ppe-apl-runtime<br/>PluginInvokers, PDP router,<br/>decision cache, session resolver"]
            CMF["ppe-apl-cmf<br/>CMF to AttributeBag bridge"]
            APL["ppe-apl-core<br/>APL parser, compiler, evaluator"]

            subgraph Builtins["praxis-policy-builtins (feature-gated)"]
                Identity["Identity<br/>jwt (DPoP), api-key"]
                Deleg["Delegation<br/>oauth (RFC 8693), delegator-vault"]
                CIBA["Elicitation<br/>elicitation-ciba"]
                PDPs["PDPs<br/>cedar, cel, opa (regorus)"]
                Sessions["Sessions<br/>valkey"]
                Secrets["Secrets<br/>secrets-vault, env, file"]
                Quota["Experimental<br/>Limitador quota, in-memory ratelimit"]
            end
        end
    end

    Policy["YAML policy document<br/>routes: tool / resource / prompt / llm / http"]
    Custom["Host-supplied plugins<br/>PluginFactory + register_factory"]

    subgraph Reference["Reference plugins (unpublished)"]
        PII[pii-scanner]
        AuditLog[audit-logger]
        OCSF["ocsf-audit<br/>DSSE / ECDSA P-256"]
        Transcript[transcript-scanner]
    end

    Agent["AI agent / client"] -->|"Bearer JWT / API key"| Listener
    Listener -->|"hook calls per request"| Facade
    Policy -->|"loaded at startup"| Core
    Custom -.->|"registered under kind:"| Core
    Reference -.->|"example extensions"| Core

    Facade --> Runtime
    Facade --> Builtins
    Runtime --> CMF
    CMF --> APL
    Runtime --> Orch
    Runtime --> Core
    Builtins --> Core
    Core -->|"all outbound HTTP"| Transport

    Transport -->|"JWKS, token exchange, CIBA"| IdP["OIDC IdP<br/>(Keycloak)"]
    Transport -->|"KV v2, login"| Vault[HashiCorp Vault]
    Transport -->|"/check, /report"| Limitador["Limitador<br/>(Kuadrant)"]
    Sessions -->|"rediss:// RESP TLS"| Valkey["Valkey / Redis"]
    Listener -->|"delegated scoped token"| Upstream["Upstream tool / LLM server"]

    style Facade fill:#4a90e2,color:#fff
    style Core fill:#4a90e2,color:#fff
    style Orch fill:#4a90e2,color:#fff
    style Runtime fill:#4a90e2,color:#fff
    style CMF fill:#4a90e2,color:#fff
    style APL fill:#4a90e2,color:#fff
    style Identity fill:#7fb3ee
    style Deleg fill:#7fb3ee
    style CIBA fill:#7fb3ee
    style PDPs fill:#7fb3ee
    style Sessions fill:#7fb3ee
    style Secrets fill:#7fb3ee
    style Quota fill:#f9e79f
    style Policy fill:#f5a623
    style Listener fill:#7ed321
    style Transport fill:#7ed321
    style IdP fill:#e8e8e8
    style Vault fill:#e8e8e8
    style Limitador fill:#e8e8e8
    style Valkey fill:#e8e8e8
    style Upstream fill:#e8e8e8
