graph TB
    subgraph Repo["pipelines-components repo (kfp-components 1.11.0)"]
        direction TB
        Lib["kfp-components library<br/>components/, pipelines/, utils/<br/>KFP v2 @dsl.component / @dsl.pipeline"]
        Gen["generate-managed-pipelines<br/>build-time compiler<br/>managed: true discovery"]
        Init["init-managed-pipelines<br/>one-shot init container entrypoint"]
        Tooling["scripts/* dev and CI tooling<br/>generate_readme, validate_*, sync_packages"]
        Starter["agentic-rag starter kit (template)<br/>FastAPI POST /v1/responses, GET /health<br/>optional TokenReview auth_wrapper"]

        subgraph Categories["Component categories"]
            DP["Data processing<br/>dataset download, chunking, SDG,<br/>AutoRAG discovery/extraction/indexing"]
            TR["Training<br/>SFT/OSFT/LoRA/GRPO, speculator,<br/>AutoGluon, AutoRAG optimization"]
            EV["Evaluation<br/>lm-eval, EvalHub, GRPO eval"]
            DE["Deployment<br/>KServe ISVC/ServingRuntime,<br/>embedding model, Model Registry"]
        end

        Lib --> Categories
        Gen -->|compiles managed pipelines from| Lib
        TR -->|AutoRAG emits| Starter
    end

    subgraph Images["Konflux images (quay.io/rhoai/*-rhel9)"]
        ImgInit["odh-pipelines-components<br/>UBI python-312 base (non-AIPCC)<br/>prebuilt KFP IR YAML + managed-pipelines.json"]
        ImgAutoML["odh-automl<br/>AIPCC cpu-torch2.13<br/>AutoGluon + kfp_components wheel"]
        ImgAutoRAG["odh-autorag<br/>AIPCC cpu-torch2.13<br/>ai4rag, Docling, Whisper, LangChain"]
        ImgInf["odh-autorag-inference<br/>AIPCC cpu-torch2.13<br/>placeholder"]
    end

    Gen -->|build-time compile| ImgInit
    Init -->|entrypoint of| ImgInit
    Lib -->|wheel installed in| ImgAutoML

    ODHOp["opendatahub-operator<br/>imageParamMap"] -->|RELATED_IMAGE_* pins| DSPO["Data Science Pipelines Operator"]
    DSPO -->|runs init container + env| ImgInit
    ImgInit -->|writes /config/managed-pipelines| KFP["KFP API server<br/>Argo Workflows"]
    KFP -->|executes tasks in| ImgAutoML
    KFP -->|executes tasks in| ImgAutoRAG

    DE -->|creates/patches| KServeCR["KServe InferenceService<br/>ServingRuntime"]
    DE -->|reads| HWP["ODH HardwareProfile"]
    TR -->|submits jobs via TrainerClient| Trainer["Kubeflow Trainer jobs"]
    DP -->|ray.io resources| Ray["KubeRay"]
    DE -->|registers models, plain HTTP| MR["Model Registry"]

    TR -->|tracking| MLflow["MLflow"]
    DP -->|LLM / embeddings| MaaS["MaaS / OpenAI-compatible LLM"]
    DP -->|indexing| VDB["Milvus / PGVector"]
    DP -->|datasets, documents| S3["S3-compatible storage"]
    DP -->|datasets, models| HF["Hugging Face Hub"]

