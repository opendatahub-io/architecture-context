graph TB
    subgraph External["EXTERNAL / UNTRUSTED CLIENTS"]
        Client["Client<br/>OpenAI / Anthropic / MCP / A2A"]
    end

    subgraph Edge["INGRESS / AUTHN (consumer-defined)"]
        Authn["Trusted Authenticator<br/>Gateway / kube-rbac-proxy<br/>asserts x-auth-tenant, x-auth-user"]
    end

    subgraph Pod["PRAXIS-AI POD (no in-repo Service / NetworkPolicy)"]
        Listener["Proxy Listener 8080/TCP<br/>HTTP/HTTPS<br/>TLS 1.2 (EMS) / 1.3 optional<br/>mTLS + SPIFFE for provider routes"]
        Filters["AI filter chain<br/>identity_header_guard, state_owner,<br/>peer_identity_trust, guardrails,<br/>rate limit, translators"]
        Admin["Admin 9901/TCP<br/>HTTP, no TLS, no auth<br/>/healthy /ready /metrics<br/>default bind 127.0.0.1"]
    end

    subgraph Cluster["IN-CLUSTER PLATFORM SERVICES"]
        KServe["KServe LLMInferenceService / vLLM<br/>Configured port"]
        EPP["llm-d EPP<br/>gRPC ext_proc, e.g. 3001"]
        ModelPod["Selected model-server pod"]
        OGX["OGX<br/>projected identity headers"]
        PG[("PostgreSQL 5432/TCP")]
        Valkey[("Valkey / Redis Sentinel")]
        Prom["Prometheus"]
    end

    subgraph Ext["EXTERNAL SERVICES (SSRF-guarded callouts)"]
        Bedrock["AWS Bedrock 443/TCP"]
        Azure["Azure OpenAI / Entra ID 443/TCP"]
        Vertex["Vertex AI / oauth2.googleapis.com 443/TCP<br/>GCP metadata 80/TCP"]
        SaaS["OpenAI / Anthropic 443/TCP"]
        Callouts["Guardrails (NeMo, Lakera), metering,<br/>web/file search, MCP servers 443/TCP"]
    end

    Client -->|HTTPS<br/>TLS| Authn
    Client -.->|"8080/TCP direct (RISK: header spoofing<br/>if authenticator bypassed)"| Listener
    Authn -->|"HTTP/HTTPS 8080/TCP<br/>TLS / mTLS SPIFFE<br/>trusted x-auth-* headers"| Listener
    Listener --> Filters

    Filters -->|"HTTP/HTTPS configured<br/>optional TLS<br/>injected credential / none"| KServe
    Filters -->|"gRPC configured<br/>optional TLS<br/>no auth"| EPP
    Filters -->|"HTTP configured<br/>optional TLS, no auth"| ModelPod
    Filters -->|"HTTP/HTTPS<br/>TLS<br/>identity headers"| OGX
    Filters -->|"PostgreSQL 5432/TCP<br/>TLS verified<br/>client cert (FIPS) / password"| PG
    Filters -->|"RESP configured<br/>TLS (tokio-rustls)"| Valkey
    Prom -->|"HTTP 9901/TCP<br/>plaintext, no auth"| Admin

    Filters -->|"HTTPS 443<br/>TLS 1.2+<br/>AWS SigV4"| Bedrock
    Filters -->|"HTTPS 443<br/>TLS 1.2+<br/>Entra ID bearer"| Azure
    Filters -->|"HTTPS 443 / HTTP 80<br/>GCP ADC RS256"| Vertex
    Filters -->|"HTTPS 443<br/>TLS 1.2+<br/>API key"| SaaS
    Filters -->|"HTTPS 443<br/>TLS 1.2+<br/>per-callout auth<br/>no redirects, private IPs denied"| Callouts

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Authn ingress
    class Listener,Filters pod
    class Admin risk
    class KServe,EPP,ModelPod,OGX,PG,Valkey,Prom internal
    class Bedrock,Azure,Vertex,SaaS,Callouts externalservice
