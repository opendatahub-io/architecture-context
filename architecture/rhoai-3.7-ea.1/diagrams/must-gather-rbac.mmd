graph TD
    subgraph OCP["OpenShift: created by oc adm must-gather (implicit)"]
        SA1["Temp ServiceAccount<br/>(temp openshift-must-gather-* ns)"]
        CRB1["Temp ClusterRoleBinding"]
        CR1["ClusterRole: cluster-admin"]
        SA1 -->|bound via| CRB1
        CRB1 -->|grants| CR1
    end

    subgraph XKS["xKS: README Job recipe"]
        SA2["ServiceAccount<br/>must-gather/must-gather-sa"]
        CRB2["ClusterRoleBinding<br/>must-gather-reader-binding"]
        CR2["ClusterRole<br/>must-gather-reader"]
        SA2 -->|bound via| CRB2
        CRB2 -->|grants| CR2
    end

    subgraph Resources["API Resources"]
        All["apiGroups: *<br/>resources: *<br/>(incl. secrets, all CRs, pods/log)"]
        NonRes["nonResourceURLs: *"]
    end

    CR1 -->|"* (all verbs)"| All
    CR1 -->|"*"| NonRes
    CR2 -->|"get, list, watch"| All

    PullSecret["Secret: redhat-pull-secret<br/>kubernetes.io/dockerconfigjson<br/>(Job imagePullSecret)"]
    SA2 -.->|uses| PullSecret

    Note["Repository ships no RBAC manifests.<br/>Read access to secrets lets kubectl_inspect<br/>capture Secrets unredacted."]

    style SA1 fill:#4a90e2,color:#fff
    style SA2 fill:#4a90e2,color:#fff
    style CRB1 fill:#e8e8e8
    style CRB2 fill:#e8e8e8
    style CR1 fill:#ff9999
    style CR2 fill:#f5a623
    style All fill:#7ed321
    style NonRes fill:#7ed321
    style PullSecret fill:#fff2cc
    style Note fill:#f8cecc,stroke:#b85450
