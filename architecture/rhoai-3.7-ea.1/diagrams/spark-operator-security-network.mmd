graph TB
    subgraph External["EXTERNAL - Untrusted"]
        ExtDeps["User dependency URLs<br/>jars, Python files, data sources<br/>any port/protocol"]
        Browser["Browser<br/>Spark UI, opt-in only"]
    end

    subgraph Ingress["INGRESS - opt-in, not configured in RHOAI"]
        UIIngress["Spark UI Ingress<br/>80/443 HTTP/HTTPS<br/>optional TLS, edge per IngressClass"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        API["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
        OCPCfg["apiservers.config.openshift.io/cluster<br/>TLS security profile"]
        ServiceCA["OpenShift service-ca"]
    end

    subgraph Platform["PLATFORM OPERATOR"]
        ODHOp["opendatahub-operator"]
        Module["spark-operator-module-controller-manager<br/>SA: spark-operator-module-controller-manager<br/>health 8081/TCP HTTP, no Service<br/>cluster-admin-equivalent RBAC"]
    end

    subgraph OperatorNS["Namespace: redhat-ods-applications - operator pods, allow-all egress"]
        Webhook["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>Svc 443 to 9443/TCP HTTPS<br/>cluster TLS profile, self-signed CA<br/>RSA-2048, 10-year cert"]
        Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>runs spark-submit in-process"]
        Metrics["/metrics 8080/TCP HTTPS<br/>service-CA cert<br/>NO authn/authz"]
        Probes["/healthz /readyz 8081/TCP HTTP<br/>unauthenticated"]
        WhSecret[("Secret spark-operator-webhook-certs")]
    end

    subgraph SparkPods["Spark operand pods - operator ns or user ns"]
        Driver["Spark driver pod<br/>SA: spark-operator-spark or user SA<br/>UI 4040/TCP HTTP, no auth"]
        Executors["Spark executor pods<br/>7078/7079/TCP Spark RPC<br/>plaintext, no auth"]
        Connect["SparkConnect server<br/>15002/TCP gRPC<br/>no TLS, no app auth"]
    end

    subgraph Monitoring["MONITORING - policy-group: monitoring"]
        Prom["Prometheus<br/>PodMonitor"]
    end

    subgraph Workbenches["WORKBENCHES - opendatahub.io/dashboard ns"]
        WB["Workbench pod<br/>Kubeflow SDK"]
    end

    ODHOp -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    Module -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token, SSA| API
    API -->|HTTPS 443 to 9443<br/>cluster TLS profile<br/>caBundle-pinned, failurePolicy Fail<br/>jobNamespaces only| Webhook
    Controller -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| API
    Webhook -->|HTTPS/6443<br/>SA token| API
    Controller -->|reads TLS profile| OCPCfg
    Webhook -->|reads TLS profile| OCPCfg
    Webhook -->|get/update| WhSecret
    ServiceCA -.->|issues metrics certs| Metrics
    Controller --- Metrics
    Webhook --- Metrics
    Controller --- Probes
    Prom -->|HTTPS/8080<br/>TLS, service-CA verified<br/>no auth, NetworkPolicy only| Metrics
    Driver -->|HTTPS/6443<br/>driver SA token| API
    Executors <-->|Spark RPC 7078/7079<br/>plaintext| Driver
    WB -->|gRPC/15002<br/>plaintext, no auth<br/>NetworkPolicy peer| Connect
    WB -->|HTTPS/6443<br/>user token| API
    Controller -->|any port, allow-all egress<br/>spark-submit dependency fetch| ExtDeps
    Driver -->|per-application| ExtDeps
    Browser -.->|HTTPS/443 opt-in| UIIngress
    UIIngress -.->|HTTP/4040| Driver

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,stroke-dasharray: 5 5
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef operand fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class ExtDeps,Browser external
    class UIIngress ingress
    class API,OCPCfg,ServiceCA controlplane
    class ODHOp,Webhook,Controller,WhSecret,Prom,WB operator
    class Module,Metrics,Probes risk
    class Driver,Executors,Connect operand
