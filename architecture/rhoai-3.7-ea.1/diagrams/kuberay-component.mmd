graph TB
    User["User / CodeFlare SDK / Workbench"]
    Kueue["Kueue<br/>(suspend / managedBy)"]
    KAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]

    subgraph Operator["kuberay-operator (Deployment, 1 replica, /manager)"]
        direction TB
        MWH["Mutating Webhook<br/>mraycluster.kb.io<br/>9443/TCP"]
        VWH["Validating Webhooks<br/>RayCluster (RayJob/RayService registered only)"]
        RCC["RayCluster Controller"]
        RJC["RayJob Controller"]
        RSC["RayService Controller"]
        RCJ["RayCronJob Controller<br/>(gate off in RHOAI)"]
        AUTH["AuthenticationController<br/>(downstream)"]
        MTLS["RayClusterMTLSController<br/>(gate RayClusterMTLS)"]
        NPC["NetworkPolicyController<br/>(gate RayClusterNetworkPolicy)"]
        LEG["LegacySecurityController<br/>(OpenShift + both gates)"]
        TLSW["TLS Profile Watcher<br/>(pkg/tls)"]
        MET["Metrics Server<br/>8080 bind / Svc 8443 HTTPS"]
        HP["Health Probes<br/>8082/TCP"]
        BS["Batch Scheduler Plugins<br/>(Volcano / scheduler-plugins / WAS, optional)"]
    end

    subgraph CRDs["ray.io CRDs"]
        RC["RayCluster"]
        RJ["RayJob"]
        RS["RayService"]
        RCJCR["RayCronJob"]
    end

    subgraph UserNS["User namespace (Data Science Project)"]
        Head["Ray Head Pod<br/>dashboard 8265, GCS 6379,<br/>client 10001, metrics 8080, serve 8000"]
        KRP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS + SAR"]
        Workers["Ray Worker Pods"]
        HeadSvc["head Service<br/>&lt;cluster&gt;-head-svc"]
        NP["NetworkPolicies<br/>head / worker"]
        PKI["cert-manager PKI<br/>Issuers, CA, head/worker Certificates"]
        Submitter["Submitter batch/v1 Job"]
        RG["ReferenceGrant<br/>kuberay-gateway-access"]
        AuthObjs["Auth ConfigMap, SA,<br/>autoscaler Role/RoleBinding,<br/>token Secret"]
    end

    subgraph PlatformNS["Platform namespace"]
        HR["HTTPRoute<br/>&lt;ns&gt;-&lt;cluster&gt;<br/>/ray/&lt;ns&gt;/&lt;cluster&gt;"]
    end

    GW["data-science-gateway<br/>(openshift-ingress)"]
    CM["cert-manager"]
    OCPCFG["OpenShift APIServer/cluster<br/>TLS profile"]

    User -->|creates| RC
    User -->|creates| RJ
    User -->|creates| RS
    Kueue -.->|admits / suspends| RJ
    KAPI -->|admission 443→9443| MWH
    KAPI -->|admission 443→9443| VWH
    MWH -->|secure defaults: mTLS, NetworkPolicy,<br/>enableIngress=false| RC

    RC -->|watched by| RCC
    RJ -->|watched by| RJC
    RS -->|watched by| RSC
    RCJCR -->|watched by| RCJ
    RCJ -->|creates| RJ
    RJC -->|creates| RC
    RJC -->|creates| Submitter
    RSC -->|creates / upgrades| RC
    RC -->|watched by| AUTH
    RC -->|watched by| MTLS
    RC -->|watched by| NPC
    RC -->|watched by| LEG

    RCC -->|creates| Head
    RCC -->|creates| Workers
    RCC -->|creates| HeadSvc
    RCC -->|creates| AuthObjs
    RCC -.->|PodGroups| BS
    AUTH -->|injects| KRP
    AUTH -->|creates| HR
    AUTH -->|creates| RG
    MTLS -->|creates| PKI
    NPC -->|creates| NP
    LEG -->|patches tlsOptions / networkPolicy| RC

    RJC -->|HTTP 8265 job submit/status| HeadSvc
    RSC -->|HTTP 8265 Serve config,<br/>HTTP 8000 health| HeadSvc
    Submitter -->|HTTP 8265 ray job submit| HeadSvc
    HeadSvc --> Head
    KRP -->|loopback 8265| Head
    Workers -->|gRPC 6379 mTLS| Head

    HR -->|parentRef| GW
    HR -->|backendRef 8265 via ReferenceGrant| HeadSvc
    PKI -->|issued by| CM
    TLSW -->|watches| OCPCFG

    classDef operator fill:#4a90e2,stroke:#333,color:#fff
    classDef crd fill:#f5a623,stroke:#333
    classDef operand fill:#7ed321,stroke:#333
    classDef external fill:#e8e8e8,stroke:#999
    classDef disabled fill:#ddd,stroke:#999,stroke-dasharray: 5 5

    class MWH,VWH,RCC,RJC,RSC,AUTH,MTLS,NPC,LEG,TLSW,MET,HP,BS operator
    class RCJ disabled
    class RC,RJ,RS,RCJCR crd
    class Head,KRP,Workers,HeadSvc,NP,PKI,Submitter,RG,AuthObjs,HR operand
    class User,Kueue,KAPI,GW,CM,OCPCFG external
