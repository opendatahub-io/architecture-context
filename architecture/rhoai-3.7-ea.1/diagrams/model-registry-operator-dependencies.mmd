graph LR
    MRO["model-registry-operator<br/>(aihub / modelregistry / catalog)"]

    %% Go / external dependencies
    MRO -->|"operator framework"| CR["controller-runtime v0.25.2"]
    MRO -->|"k8s clients"| K8sLibs["k8s.io api/client-go v0.37.2"]
    MRO -->|"SSA deployer, kustomize, TLS"| OPU["odh-platform-utilities v0.6.0"]
    MRO -->|"Route, Group, ImageStream types"| OSAPI["openshift/api"]
    MRO -->|"HTTPRoute, ReferenceGrant"| GWAPI["gateway-api v1.6.3"]
    MRO -->|"legacy config patch"| Istio["istio client-go v1.31.3"]
    MRO -->|"CLI"| Cobra["spf13/cobra v1.10.2"]
    MRO -->|"metadata storage"| PG["PostgreSQL 16 / MySQL"]

    %% Internal platform dependencies
    RHODS["rhods-operator"] -->|"deploys overlays/aihub,<br/>creates AIHub CR"| MRO
    MRO -->|"AIHubReady status"| RHODS
    MRO -->|"deploys image"| MRImg["model-registry<br/>REST / catalog image"]
    MRO -->|"sidecar image"| KRP["odh-kube-rbac-proxy"]
    MRO -->|"catalog data"| CatData["ai-hub-catalog /<br/>model-metadata-collection"]
    MRO -->|"Template image"| Upload["model-registry-job-async-upload"]
    MRO -->|"HTTPRoute + ReferenceGrant"| Gateway["data-science-gateway"]
    MRO -->|"reads admin groups"| AuthCR["Auth CR<br/>services.platform.opendatahub.io"]
    MRO -.->|"CA trust"| TrustCA["odh-trusted-ca-bundle"]
    MRO -.->|"serving certs"| ServiceCA["OpenShift service-ca"]

    %% Consumers
    Dashboard["RHOAI Dashboard<br/>model-registry-ui"] -->|"HTTPS 8443 via proxy"| MRO
    AutoML["automl-ui"] -->|"HTTPS 8443 via proxy"| MRO
    Prom["Prometheus"] -->|"scrape 8443"| MRO

    %% Platform services
    MRO -->|"API server 6443"| K8sAPI["Kubernetes API"]
    MRO -->|"APIServer, Ingress, Proxy"| OSConfig["OpenShift config APIs"]
    MRO -->|"Routes"| Router["OpenShift Router"]
    MRO -->|"ImageStream import"| RHReg["registry.redhat.io"]

