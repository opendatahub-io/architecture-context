graph TB
    User["User (browser)"]
    APIClient["API client / script"]

    subgraph Route["OpenShift Routes (edge TLS, no auth proxy)"]
        RouteUI["Route: planner<br/>443/TCP → ui:8501"]
        RouteBE["Route: planner-backend<br/>443/TCP → backend:8000"]
    end

    subgraph PlannerNS["Namespace: planner"]
        UI["ui<br/>Streamlit, 8501/TCP"]
        subgraph Backend["backend (FastAPI/uvicorn, 8000/TCP, 2 workers)"]
            API["planner.api<br/>10 routers, no auth middleware"]
            Lib["planner library<br/>Intent → Specification → Recommendation → Config"]
            Quality["quality_scoring<br/>Arena + Artificial Analysis"]
            Templates["Jinja2 templates<br/>KServe ISVC / HPA / ServiceMonitor / llm-d"]
            ClusterMgr["Cluster manager<br/>kubectl subprocess"]
            GPUDet["GPU detector<br/>kubernetes client"]
            MCClient["ModelCatalogClient<br/>httpx"]
            API --> Lib
            Lib --> Quality
            Lib --> Templates
            API --> ClusterMgr
            Lib --> GPUDet
            Lib --> MCClient
        end
        SQLite[("SQLite planner.db<br/>RWO PVC /app/db")]
        Ollama["ollama<br/>granite3.3:2b, 11434/TCP<br/>1 NVIDIA GPU"]
        Config["ConfigMap planner-config<br/>Secret planner-secrets"]
        CA["ConfigMap planner-service-ca<br/>service-CA bundle"]
    end

    Simulator["simulator (optional)<br/>vLLM-compatible API, 8080/TCP<br/>docker-compose / simulator mode"]
    CLI["planner CLI / PyPI library<br/>offline use"]

    subgraph RHOAI["RHOAI platform"]
        ModelCatalog["Model Catalog<br/>model-catalog.rhoai-model-registries.svc:8443"]
        KServe["KServe<br/>InferenceService RawDeployment"]
        LLMD["llm-d<br/>kustomize / Helm values"]
    end

    K8sAPI["Kubernetes API<br/>6443/TCP"]

    subgraph ExtLLM["External LLM providers (optional)"]
        Vertex["Vertex AI (Claude)"]
        OpenAI["OpenAI-compatible API"]
    end
    HF["HuggingFace Hub"]
    AA["artificialanalysis.ai"]

    User --> RouteUI --> UI
    APIClient --> RouteBE --> API
    UI -->|HTTP 8000| API
    Lib -->|HTTP 11434| Ollama
    Lib -.->|HTTPS 443| Vertex
    Lib -.->|HTTPS 443| OpenAI
    Lib --> SQLite
    MCClient -->|HTTPS 8443 Bearer| ModelCatalog
    CA -.->|TLS trust| MCClient
    Config -.-> Backend
    GPUDet -->|list nodes| K8sAPI
    ClusterMgr -->|create ns, apply, delete| K8sAPI
    K8sAPI -->|reconciled by| KServe
    Templates -.->|generates| KServe
    Templates -.->|generates| LLMD
    KServe -.->|simulator mode image| Simulator
    Quality -->|HTTPS 443| HF
    Quality -->|HTTPS 443| AA
    CLI -.->|same library| Lib

