graph TB
    User["Data Scientist<br/>browser / MLflow SDK"]
    Clients["Workbenches / Pipelines /<br/>Training Jobs (MLflow SDK)"]
    Dashboard["ODH Dashboard"]
    Gateway["ODH Data Science Gateway<br/>HTTPRoute /mlflow 443/TCP"]
    Operator["MLflow Operator<br/>MLflow CR (cluster) + Helm chart"]

    subgraph Image["odh-mlflow-rhel9 image (quay.io/rhoai/odh-mlflow-rhel9)"]
        direction TB
        Security["fastapi_security middleware<br/>Host validation, CORS, X-Frame-Options"]
        AuthPlugin["kubernetes-auth app plugin<br/>mlflow-kubernetes-plugins==2.1.1 (external)<br/>SSAR per request"]
        WSProvider["kubernetes:// workspace provider<br/>namespace = workspace"]
        subgraph Server["MLflow Tracking Server (uvicorn, 4 workers, 5000/TCP)"]
            FastAPI["FastAPI routers<br/>OTLP /v1/traces, artifacts proxy,<br/>Skills Registry, MCP servers, server-info, jobs"]
            Flask["Flask app (WSGI, mounted at /)<br/>/api/2.0/mlflow/*, /ajax-api/*,<br/>/graphql, /health"]
            UI["MLflow React UI<br/>standalone + module-federated bundle"]
        end
        Disabled["AI Gateway / Assistant / Job runner / Telemetry<br/>DISABLED via image ENV"]
        CLI["mlflow CLI<br/>server, db upgrade, db fix-migration-gap"]
    end

    SDKs["Python SDK libraries<br/>mlflow, mlflow-skinny, mlflow-tracing"]

    K8sAPI["Kubernetes API<br/>SSAR, namespaces, MLflowConfig"]
    MLflowConfig["MLflowConfig CR (namespaced)<br/>artifact-root override"]
    Postgres["PostgreSQL<br/>backend + registry store"]
    S3["S3-compatible object store<br/>artifacts"]
    LLM["LLM providers<br/>(only if AI Gateway enabled)"]
    Webhooks["Webhook receivers<br/>HMAC-SHA256"]

    User -->|HTTPS 443| Gateway
    Clients -->|HTTPS 443| Gateway
    Dashboard -->|embeds UI via module federation| UI
    Gateway -->|HTTPS 5000 + Bearer + X-MLFLOW-WORKSPACE| Security
    Security --> AuthPlugin
    AuthPlugin -->|authorized requests| FastAPI
    AuthPlugin -->|authorized requests| Flask
    Flask --> UI
    FastAPI --> WSProvider
    Flask --> WSProvider
    AuthPlugin -->|SelfSubjectAccessReview| K8sAPI
    WSProvider -->|list/watch namespaces| K8sAPI
    WSProvider -->|reads| MLflowConfig
    Flask -->|SQLAlchemy psycopg2 5432| Postgres
    FastAPI -->|boto3 HTTPS 443| S3
    Flask -->|model registry events| Webhooks
    Disabled -.->|off by default| LLM
    Operator -->|deploys Deployment, Service,<br/>HTTPRoute, TLS, RBAC| Image
    Clients -.->|uses| SDKs

