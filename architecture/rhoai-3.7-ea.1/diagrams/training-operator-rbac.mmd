graph TD
    subgraph SAs["Service Accounts"]
        SA["opendatahub/kubeflow-training-operator"]
        LauncherSA["user-ns/mpijob-launcher<br/>dynamic"]
        Users["Users / Groups<br/>via admin, edit, view"]
    end

    subgraph Bindings["Bindings"]
        CRB["ClusterRoleBinding<br/>kubeflow-training-operator"]
        RB["RoleBinding opendatahub<br/>kubeflow-training-operator-webhook"]
        LRB["RoleBinding user-ns<br/>mpijob-launcher"]
        Agg["Aggregation labels<br/>aggregate-to-admin/edit/view"]
    end

    subgraph Roles["Roles"]
        CR["ClusterRole<br/>kubeflow-training-operator"]
        WR["Role opendatahub<br/>kubeflow-training-operator-webhook"]
        LR["Role user-ns<br/>mpijob-launcher"]
        Edit["ClusterRole<br/>kubeflow-training-edit"]
        View["ClusterRole<br/>kubeflow-training-view"]
    end

    subgraph Resources["API Resources"]
        Jobs["kubeflow.org<br/>pytorchjobs, tfjobs, mpijobs,<br/>xgboostjobs, paddlejobs, jaxjobs"]
        JobSub["kubeflow.org<br/>*/status, */finalizers"]
        Pods["core<br/>pods, events"]
        PodExec["core<br/>pods/exec"]
        CoreOther["core<br/>services, configmaps, serviceaccounts"]
        RBACRes["rbac.authorization.k8s.io<br/>roles, rolebindings"]
        VWC["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        HPA["autoscaling<br/>horizontalpodautoscalers"]
        NP["networking.k8s.io<br/>networkpolicies"]
        PG["scheduling.volcano.sh / scheduling.x-k8s.io<br/>podgroups"]
        APISrv["config.openshift.io<br/>apiservers: cluster"]
        Secrets["core<br/>secrets"]
        UserJobs["kubeflow.org<br/>mpijobs, tfjobs, pytorchjobs, mxjobs,<br/>xgboostjobs, paddlejobs - NO jaxjobs"]
    end

