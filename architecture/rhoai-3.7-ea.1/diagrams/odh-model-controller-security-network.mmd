graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Bearer token"]
    end

    subgraph IngressZone["INGRESS (dynamically created by controller)"]
        Router["OpenShift Route per raw ISVC<br/>443/TCP HTTPS<br/>Reencrypt or Edge, HTTP→HTTPS redirect"]
        Gateway["Gateway API Gateway (Envoy)<br/>443/TCP HTTPS<br/>EnvoyFilter + Kuadrant AuthPolicy"]
        Authorino["Authorino<br/>token auth"]
    end

    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        KAPI["kube-apiserver<br/>6443/TCP HTTPS TLS 1.2+"]
        APIServerCfg["config.openshift.io APIServer<br/>TLS profile + TLSAdherence"]
    end

    subgraph NS_ODH["Namespace: opendatahub (controller namespace)"]
        subgraph MgrPod["odh-model-controller pod - SA: odh-model-controller<br/>NetworkPolicy: ingress allow-all"]
            Webhook["Webhook server<br/>9443/TCP HTTPS<br/>cluster TLS profile, service-ca cert<br/>10 webhooks, failurePolicy Fail"]
            MMetrics["Metrics<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
            MProbes["Probes /healthz /readyz<br/>8081/TCP HTTP, no auth"]
        end
        subgraph APIPod["model-serving-api pod - SA: model-serving-api"]
            GWAPI["/api/v1/gateways<br/>8443/TCP HTTPS TLS 1.2+<br/>Bearer + SSAR as user"]
            SamplesAPI["/api/v1/samples/llm-d<br/>8443/TCP, no auth"]
            AMetrics["/metrics<br/>8080/TCP HTTPS, no auth"]
        end
    end

    subgraph Monitoring["Monitoring"]
        Prom["Prometheus / UWM"]
    end

    subgraph Platform["RHOAI Platform"]
        Dashboard["RHOAI Dashboard backend"]
    end

    subgraph NS_User["Namespace: user data science project"]
        Predictor["ISVC Predictor<br/>kube-rbac-proxy (reencrypt)<br/>per-ISVC SA + CRB"]
        LLMD["llm-d EPP / vLLM<br/>Grid NetworkPolicies"]
        UserSecrets["storage-config, NIM pull Secret,<br/>Ray TLS Secrets, CA ConfigMap"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        NGC["NVIDIA NGC<br/>api.ngc.nvidia.com, authn.nvidia.com<br/>nvcr.io 443/TCP TLS"]
        MR["Model Registry (optional)<br/>HTTPS, MR_SKIP_TLS_VERIFY=false"]
        OTel["OTel Collector (optional)<br/>OTLP/gRPC"]
    end

    %% Inbound
    Client -->|HTTPS/443<br/>TLS<br/>Bearer| Router
    Router -->|TLS reencrypt| Predictor
    Client -->|HTTPS/443<br/>TLS<br/>Bearer| Gateway
    Gateway -->|ext authz| Authorino
    Gateway -->|HTTPS| LLMD

    KAPI -->|HTTPS 443→9443<br/>TLS cluster profile<br/>admission| Webhook
    Prom -->|HTTPS/8443<br/>TLS<br/>Bearer + SAR| MMetrics
    Prom -->|HTTPS/8080<br/>TLS<br/>no auth| AMetrics
    Dashboard -->|HTTPS 443→8443<br/>TLS 1.2+<br/>User Bearer| GWAPI

    %% Outbound
    MgrPod -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| KAPI
    APIPod -->|HTTPS/6443<br/>SA token + user token SSAR| KAPI
    MgrPod -.->|watch| APIServerCfg
    APIPod -.->|watch| APIServerCfg
    MgrPod -->|HTTPS/443<br/>TLS<br/>NGC API key| NGC
    MgrPod -.->|HTTPS<br/>TLS<br/>Bearer SA token| MR
    APIPod -.->|OTLP/gRPC<br/>runtime-configured| OTel
    MgrPod -->|creates via API| UserSecrets

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Router,Gateway,Authorino ingress
    class KAPI,APIServerCfg control
    class Webhook,MMetrics,GWAPI,Prom,Dashboard,Predictor,LLMD,UserSecrets internal
    class MProbes,SamplesAPI,AMetrics risk
    class NGC,MR,OTel externalservice
