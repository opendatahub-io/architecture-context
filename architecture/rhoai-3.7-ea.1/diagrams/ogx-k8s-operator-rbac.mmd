graph TD
    subgraph SAs["Service Accounts"]
        OpSA["ogx-k8s-operator-controller-manager"]
        ModSA["opendatahub-ogx-operator"]
        ServerSA["per-OGXServer ServiceAccount"]
    end

    subgraph Bindings["Bindings"]
        OpCRB["ogx-k8s-operator-manager-rolebinding"]
        OpProxyCRB["ogx-k8s-operator-proxy-rolebinding"]
        OpMetricsCRB["ogx-k8s-operator-metrics-auth<br/>(OpenShift)"]
        OpTLSCRB["ogx-k8s-operator-tls-profile<br/>(OpenShift)"]
        OpLeRB["ogx-k8s-operator-leader-election-rolebinding<br/>(operator NS)"]
        ModCRB["opendatahub-ogx-manager-cluster-rolebinding"]
        ModMetricsCRB["opendatahub-ogx-metrics-auth-rolebinding"]
        ModRB["opendatahub-ogx-manager-rolebinding<br/>(module NS)"]
        ModLeRB["opendatahub-ogx-leader-election-rolebinding<br/>(module NS)"]
        ServerRB["per-OGXServer RoleBinding<br/>(CR NS)"]
    end

    subgraph Roles["Roles"]
        OpRole["ClusterRole<br/>ogx-k8s-operator-manager-role"]
        OpProxy["ClusterRole<br/>ogx-k8s-operator-proxy-role"]
        OpMetrics["ClusterRole<br/>ogx-k8s-operator-metrics-auth"]
        OpTLS["ClusterRole<br/>ogx-k8s-operator-tls-profile"]
        OpLe["Role<br/>leader-election-role"]
        ModRole["ClusterRole<br/>manager-cluster-role<br/>cluster-admin-adjacent"]
        ModMetrics["ClusterRole<br/>metrics-auth-role"]
        ModNsRole["Role<br/>manager-role"]
        ModLe["Role<br/>leader-election-role"]
        SCC["ClusterRole<br/>system:openshift:scc:nonroot-v2"]
    end

    subgraph OpRes["Root operator resources"]
        R_OGXS["ogx.io<br/>ogxservers, /status, /finalizers<br/>full CRUD"]
        R_Work["apps deployments, autoscaling HPAs,<br/>batch jobs, policy PDBs,<br/>networking ingresses/networkpolicies<br/>full CRUD"]
        R_Core["core services, serviceaccounts: full CRUD<br/>configmaps, PVCs: create/get/list/patch/update/watch<br/>events: create/patch, pods: list"]
        R_Secrets["core secrets<br/>get, list, watch (cluster-wide)"]
        R_RBAC["rbac rolebindings: full CRUD<br/>clusterrolebindings: delete/get/list<br/>clusterroles: get/list/watch"]
        R_Misc["CRDs: get/list/watch<br/>config.openshift.io apiservers: get/list/watch<br/>monitoring.coreos.com: full CRUD<br/>SCC: use"]
        R_Auth["tokenreviews, subjectaccessreviews<br/>create"]
        R_Lease["configmaps, leases: CRUD<br/>events: create/patch"]
    end

    subgraph ModRes["ogx-module resources"]
        M_ClusterRBAC["rbac clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>full CRUD"]
        M_Admission["admissionregistration<br/>validatingwebhookconfigurations<br/>full CRUD"]
        M_CRD["apiextensions CRDs<br/>full CRUD"]
        M_OGX["components.platform.opendatahub.io<br/>ogxs, /status, /finalizers<br/>full CRUD"]
        M_Same["Same workload, core, ogx.io,<br/>monitoring, apiservers, SCC grants<br/>as root operator"]
        M_NS["Namespaced core, apps, autoscaling,<br/>networking, policy, rbac roles<br/>full CRUD"]
    end

    R_SCCUse["security.openshift.io<br/>securitycontextconstraints<br/>use (nonroot-v2)"]

