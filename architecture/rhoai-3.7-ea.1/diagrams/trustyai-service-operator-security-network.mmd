graph TB
    %% trustyai-service-operator - security network topology (RHOAI 3.7-ea.1)

    subgraph External["EXTERNAL (Untrusted)"]
        ExtUser["External User / Client<br/>Bearer token"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        RouteTAS["Route: tas<br/>443/TCP HTTPS<br/>reencrypt, insecure to Redirect"]
        RouteEH["Route: evalhub / evalhub-mcp<br/>443/TCP HTTPS<br/>reencrypt, insecure to Redirect"]
        RouteNemo["Route: nemoguardrails<br/>443/TCP HTTPS<br/>reencrypt if auth, else EDGE"]
    end

    subgraph ControlPlane["CONTROL PLANE (Cluster-wide, privileged)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS TLS 1.2+"]
        subgraph NS_Apps["Namespace: redhat-ods-applications"]
            Module["trustyai-operator-module<br/>SA: trustyai-operator-module-controller-manager<br/>metrics 8080/TCP HTTP NO AUTH<br/>probes 8081/TCP"]
            Operator["trustyai-service-operator manager<br/>SA: trustyai-service-operator-controller-manager<br/>metrics 8443/TCP HTTPS TokenReview+SAR<br/>probes 8081/TCP HTTP<br/>webhook 9443/TCP HTTPS (Svc 443)"]
        end
        APIServerCfg["APIServer config<br/>TLS profile"]
    end

    subgraph Monitoring["MONITORING NAMESPACES"]
        Prom["Prometheus<br/>ServiceMonitors"]
    end

    subgraph UserNS["USER / TENANT NAMESPACES (NetworkPolicy-scoped)"]
        subgraph TASPod["TrustyAI Service Pod"]
            TASKRP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>SAR get services/name"]
            TASITP["internal-tls-proxy<br/>4443/TCP HTTPS<br/>NO AUTH on /consumer/kserve/v2"]
            TASApp["trustyai-service<br/>8081 API / 8080 HTTP"]
        end
        subgraph EHPod["EvalHub Pod"]
            EHKRP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>Namespaced SAR via X-Tenant"]
            EHApp["evalhub<br/>127.0.0.1:8444<br/>metrics 8081/TCP HTTP NO AUTH"]
        end
        subgraph NemoPod["NeMo Guardrails Pod"]
            NemoKRP["kube-rbac-proxy<br/>user 8443 / admin 8444<br/>TLS 1.2 fixed ciphers"]
            NemoApp["NeMo server<br/>8000/TCP HTTP<br/>Svc 80 NO AUTH"]
        end
        LMESPod["LMEvalJob Pod<br/>lm-eval + driver 18080<br/>no Service"]
        EvalJob["EvalHub Evaluation Job Pods<br/>job SA"]
        KServe["KServe Predictor<br/>Raw / Serverless"]
    end

    subgraph ExternalServices["EXTERNAL / BACKING SERVICES"]
        PG["PostgreSQL<br/>DSN secret"]
        MLflow["MLflow<br/>443/TCP HTTPS<br/>projected SA token 3600s"]
        ModelEP["Model Inference Endpoint<br/>HTTP/HTTPS, user token"]
        OTLP["OTLP Collector<br/>optional"]
    end

    %% Ingress paths
    ExtUser -->|HTTPS 443<br/>TLS| RouteTAS
    ExtUser -->|HTTPS 443<br/>TLS| RouteEH
    ExtUser -->|HTTPS 443<br/>TLS| RouteNemo
    RouteTAS -->|HTTPS reencrypt<br/>to tas-tls Svc 443 to 8443| TASKRP
    RouteEH -->|HTTPS reencrypt<br/>8443| EHKRP
    RouteNemo -->|HTTPS reencrypt 8443<br/>auth enabled| NemoKRP
    RouteNemo -.->|EDGE: plaintext HTTP 8000<br/>auth NOT enabled| NemoApp

    %% Sidecar hops
    TASKRP -->|HTTP 8081 loopback| TASApp
    TASITP -->|HTTP 8080 loopback| TASApp
    EHKRP -->|HTTP 127.0.0.1:8444<br/>X-User header| EHApp
    NemoKRP -->|HTTP 127.0.0.1:8000| NemoApp

    %% In-cluster data plane
    KServe -->|HTTPS 443 to 4443<br/>service-CA TLS, no token| TASITP
    KServe -.->|HTTP 80 to 8080<br/>Serverless, plaintext| TASApp
    EvalJob -->|HTTPS 8443<br/>job SA token, SAR status-events| EHKRP
    Operator -->|HTTPS 8443 TLS 1.2+<br/>operator SA token<br/>failure events| EHKRP
    EHApp -->|DB port, per DSN| PG
    EHApp -->|HTTPS 443<br/>merged CA| MLflow
    LMESPod -->|HTTP/HTTPS<br/>merged CA bundle| ModelEP
    Operator -.->|OTLP gRPC/HTTP<br/>opt-in| OTLP

    %% Control plane
    Module -->|HTTPS 6443 SA token<br/>SSA apply CRDs, RBAC, Deployment| K8sAPI
    Operator -->|HTTPS 6443 SA token<br/>watch/CRUD, secrets, CRBs| K8sAPI
    Operator -->|HTTPS 6443 SPDY/WebSocket<br/>pods/exec driver| K8sAPI
    K8sAPI -.->|exec channel| LMESPod
    K8sAPI -->|HTTPS 443 to 9443<br/>service-CA TLS<br/>/convert| Operator
    Operator -->|watch| APIServerCfg
    EHApp -->|HTTPS 6443 API SA token<br/>create Jobs in tenant ns| K8sAPI

    %% Monitoring
    Prom -->|HTTPS 8443<br/>Bearer, TokenReview+SAR| Operator
    Prom -->|HTTP 8081<br/>no auth| EHApp
    Prom -->|HTTP 8080 /q/metrics| TASApp

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class ExtUser external
    class RouteTAS,RouteEH,RouteNemo ingress
    class K8sAPI,Operator,APIServerCfg control
    class TASKRP,TASApp,EHKRP,NemoKRP,LMESPod,EvalJob,KServe tenant
    class PG,MLflow,ModelEP,OTLP,Prom externalservice
    class Module,TASITP,EHApp,NemoApp risk
