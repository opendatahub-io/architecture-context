graph TB
    subgraph Control["PLATFORM CONTROL (eval-hub / operators)"]
        EvalHub["eval-hub<br/>creates Job, SA, mounts secrets"]
        OpCM["ConfigMap trustyai-service-operator-config<br/>ns: redhat-ods-applications / opendatahub"]
    end

    subgraph TenantNS["TENANT NAMESPACE (eval-hub job / KFP namespace) - no inbound listeners, no NetworkPolicy"]
        subgraph JobPod["Adapter Job pod (default user root in Dockerfile.konflux; restricted SCC applies)"]
            Adapter["GarakAdapter<br/>+ garak subprocess<br/>No Service / Route / EXPOSE"]
            Sidecar["eval-hub sidecar<br/>localhost:8080/TCP HTTP"]
        end
        KFPPods["KFP step pods (same image)<br/>validate ... write_kfp_outputs<br/>no resource limits set"]
        DCSecret["Data Connection Secret<br/>AWS_* keys"]
        MASecret["model-auth Secret<br/>/mnt/model-auth (optional)"]
    end

    subgraph ClusterSvc["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
        DSP["Data Science Pipelines API<br/>443/TCP HTTPS"]
    end

    subgraph ExternalServices["EXTERNAL / CONFIGURED SERVICES"]
        Models["Model endpoints<br/>target / attacker / judge / evaluator / SDG<br/>OpenAI-compatible, URL from JobSpec"]
        S3["S3-compatible storage<br/>AWS_S3_ENDPOINT 443/TCP"]
        OCI["OCI registry / MLflow<br/>443/TCP (optional)"]
        HF["Hugging Face Hub / NLTK corpora<br/>443/TCP"]
    end

    EvalHub -->|Job spec, envFrom, mounts| Adapter
    Adapter -->|HTTP/8080 loopback<br/>no TLS<br/>Bearer k8s_sa_token:ref placeholder| Sidecar
    Sidecar -->|HTTPS/443<br/>TLS<br/>real SA token| K8sAPI
    Adapter -->|"HTTPS/443<br/>TLS (verify DISABLED if CA file missing)<br/>SA token / KFP_AUTH_TOKEN"| K8sAPI
    K8sAPI -->|GET| DCSecret
    K8sAPI -->|GET| OpCM
    Adapter -->|"HTTPS/443 or via sidecar<br/>TLS (KFP_VERIFY_SSL default true)<br/>Bearer SA token"| DSP
    DSP -->|schedules| KFPPods
    DCSecret -.->|use_secret_as_env| KFPPods
    MASecret -.->|API keys| Adapter
    MASecret -.->|API keys| KFPPods
    Adapter -->|"HTTP(S)/configured port<br/>TLS if https<br/>Bearer API key (DUMMY fallback)"| Models
    KFPPods -->|"HTTPS/configured<br/>TLS<br/>Bearer per-role key"| Models
    Adapter -->|HTTPS/443<br/>TLS<br/>AWS access keys| S3
    KFPPods -->|HTTPS/443<br/>TLS<br/>AWS access keys| S3
    Sidecar -->|HTTPS/443<br/>TLS<br/>SDK-managed creds| OCI
    Adapter -->|HTTPS/443<br/>TLS<br/>no auth| HF

    classDef control fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class EvalHub,OpCM control
    class Adapter,Sidecar,KFPPods tenant
    class DCSecret,MASecret secret
    class K8sAPI,DSP cluster
    class Models,S3,OCI,HF externalservice
