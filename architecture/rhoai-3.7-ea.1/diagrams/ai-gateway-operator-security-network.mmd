graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        API["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        APIServerCfg["apiservers.config.openshift.io<br/>TLS profile + adherence"]
    end

    subgraph Monitoring["OPENSHIFT MONITORING"]
        Prom["Prometheus"]
    end

    subgraph Platform["PLATFORM OPERATOR"]
        RHODS["rhods-operator<br/>SA: platform operator"]
    end

    subgraph NS_Apps["Namespace: redhat-ods-applications (cluster-internal)"]
        MetricsSvc["Service: ai-gateway-metrics-service<br/>ClusterIP 8443/TCP HTTPS<br/>service-ca cert"]
        Operator["ai-gateway-operator<br/>SA: ai-gateway-operator<br/>HIGHLY PRIVILEGED (~76 cluster rules)<br/>probes 8081/TCP HTTP no auth"]
        WebhookSvc["Service: maas-controller-webhook-service<br/>ClusterIP 443/TCP HTTPS"]
        MaaS["maas-controller<br/>SA: maas-controller"]
        SubMetrics["maas-controller / ai-gateway-controller /<br/>llm-d-batch-gateway-operator metrics<br/>ClusterIP 8443/TCP HTTPS Bearer"]
    end

    subgraph NS_Infra["Namespace: redhat-ai-gateway-infra"]
        DBSecret["Secret: maas-db-config"]
    end

    subgraph NS_Grid["Namespace: redhat-ai-grid (REVIEW REQUIRED)"]
        GridOp["grid-operator"]
        GridMetrics["grid-operator-metrics<br/>ClusterIP 9090/TCP"]
        GridSignals["grid-operator-signals<br/>LoadBalancer 9091/TCP<br/>encryption/auth: not determined"]
        GridSwim["grid-operator-swim<br/>LoadBalancer 7946/UDP SWIM<br/>encryption/auth: not determined"]
    end

    subgraph External["POTENTIALLY EXTERNAL (non GKE/AWS/Azure)"]
        Peers["Grid peers / external clients"]
    end

    %% Flows
    RHODS -->|HTTPS/6443<br/>TLS 1.2+<br/>platform SA token| API
    API -->|watch HTTPS/6443<br/>TLS 1.2+| Operator
    Operator -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SSA, GC, status| API
    Operator -->|get/watch TLS profile| APIServerCfg
    Prom -->|HTTPS/8443<br/>cluster TLS profile<br/>Bearer token| MetricsSvc
    MetricsSvc --> Operator
    Operator -->|TokenReview + SAR<br/>HTTPS/6443| API
    API -->|admission HTTPS/443<br/>TLS, failurePolicy Fail| WebhookSvc
    WebhookSvc --> MaaS
    Prom -->|HTTPS/8443 Bearer| SubMetrics
    Prom -->|9090/TCP SA token| GridMetrics
    MaaS -.->|Role secret-migrate<br/>get maas-db-config, create secrets| DBSecret
    Peers -.->|TCP/9091| GridSignals
    Peers -.->|UDP/7946| GridSwim
    GridSignals --> GridOp
    GridSwim --> GridOp
    GridMetrics --> GridOp

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef privileged fill:#f8cecc,stroke:#b85450,stroke-width:3px
    classDef review fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef secret fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class API,APIServerCfg controlplane
    class Prom,RHODS,MetricsSvc,WebhookSvc,MaaS,SubMetrics,GridOp,GridMetrics internal
    class Operator privileged
    class GridSignals,GridSwim review
    class Peers external
    class DBSecret secret
