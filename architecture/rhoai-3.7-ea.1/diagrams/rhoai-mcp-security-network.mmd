graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["MCP Client / AI Agent"]
        OIDCIssuer["OIDC Issuer<br/>443/TCP HTTPS<br/>JWKS, JWT mode only"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        Route["Route rhoai-mcp<br/>443/TCP HTTPS<br/>Edge TLS termination<br/>HTTP to HTTPS redirect<br/>300s timeout in OIDC overlay"]
    end

    subgraph Cluster["CLUSTER INTERNAL (no NetworkPolicy on rhoai-mcp pod)"]
        direction TB
        subgraph NS_App["Namespace: redhat-ods-applications / opendatahub / rhoai-mcp"]
            Svc["Service rhoai-mcp<br/>ClusterIP 8000/TCP HTTP<br/>sessionAffinity ClientIP in OIDC"]
            Pod["rhoai-mcp pod, 1 replica<br/>SA: rhoai-mcp<br/>SA mode: NO endpoint auth<br/>OIDC mode: Bearer via OIDCAuthMiddleware"]
        end
        subgraph NS_MR["Namespace: rhoai-model-registries / odh-model-registries"]
            MR["Model Registry<br/>8080/TCP HTTP or 8443/TCP HTTPS<br/>kube-rbac-proxy"]
            MC["Model Catalog<br/>8443/TCP HTTPS<br/>service-serving cert"]
        end
        subgraph NS_Planner["Namespace: planner (optional)"]
            RP["Remote Planner<br/>8000/TCP HTTP"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes / OpenShift API<br/>6443/TCP HTTPS<br/>TLS verified via SA CA bundle"]
    end

    Client -->|"HTTPS/443<br/>TLS edge<br/>SA mode: none<br/>OIDC: Bearer token"| Route
    Route -->|"HTTP/8000<br/>plaintext<br/>Bearer forwarded"| Svc
    Svc --> Pod
    Pod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token, user token,<br/>or SA + Impersonate-User/Group"| K8sAPI
    Pod -->|"HTTP/8080 no TLS, no auth<br/>or HTTPS/8443 TLS UNVERIFIED<br/>Bearer SA token"| MR
    Pod -->|"HTTPS/8443<br/>TLS verified service-ca<br/>SA token / MODEL_CATALOG_TOKEN"| MC
    Pod -.->|"HTTP/8000<br/>no TLS, no auth<br/>remote mode only"| RP
    Pod -.->|"HTTPS/443<br/>TLS system CA<br/>discovery + JWKS"| OIDCIssuer

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class OIDCIssuer externalservice
    class Route ingress
    class Svc,MC,RP internal
    class Pod,MR risk
    class K8sAPI controlplane
