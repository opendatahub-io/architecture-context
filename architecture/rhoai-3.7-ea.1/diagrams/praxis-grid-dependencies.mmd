graph LR
    AGN["praxis-grid<br/>grid-operator (AGN)"]

    %% External dependencies
    AGN -->|"controller runtime"| Kube["kube / kube-runtime 5.0.0"]
    AGN -->|"SWIM membership"| Foca["foca"]
    AGN -->|"default TLS + crypto"| Rustls["rustls + ring 0.17.14<br/>aes-gcm, sha2 (non-FIPS)"]
    AGN -->|"FIPS build TLS + crypto"| OpenSSL["system OpenSSL 3<br/>UBI9 FIPS provider"]
    AGN -->|"cert generation"| Rcgen["rcgen, x509-parser"]
    AGN -->|"MCP client"| Rmcp["rmcp"]
    AGN -->|"provider HTTP"| Reqwest["reqwest"]
    AGN -.->|"optional CA"| CertManager["cert-manager"]
    AGN -.->|"ServiceMonitor"| Prom["Prometheus Operator<br/>monitoring.coreos.com"]

    %% Internal platform dependencies
    AGN ==>|"routing overlay ConfigMap → file"| Praxis["Praxis AI gateway<br/>praxis-proxy/ai"]
    AGN -->|"metrics scrape, TokenReview-authorized"| LLMD["llm-d EPP<br/>queueDepth / kvCachePressure"]
    AGN -.->|"metrics serving cert"| ServiceCA["OpenShift service-CA"]
    Monitoring["OpenShift monitoring"] -.->|"ServiceMonitor scrape 9090"| AGN

    %% Repo sub-components
    AGN -->|"serving ConfigMap + signals"| GridGW["grid-gateway"]
    AGN -->|"sidecar"| OverlaySync["grid-overlay-sync"]
    AGN -->|"site enrollment 8443"| Enrollment["enrollment service"]
    Enrollment -->|"5432/TCP"| Postgres["PostgreSQL"]
    Dashboard["fleet-dashboard"] -.->|"queries site Prometheus"| AGN

    %% Federation and external services
    AGN <-->|"SWIM 7946/UDP + signals 9091/TCP"| Peers["Peer grid-operators"]
    AGN -->|"health, /v1/models"| Providers["Inference providers<br/>external APIs"]
    AGN -->|"tools/list"| MCP["MCP servers"]
    AGN -->|"443/TCP"| K8sAPI["Kubernetes API"]

    style AGN fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Kube fill:#999,stroke:#333
    style Foca fill:#999,stroke:#333
