graph LR
    GD["guardrails-detectors<br/>HF detector runtime"]

    %% External Dependencies
    GD -->|HTTP framework| FastAPI["fastapi 0.141.1 /<br/>starlette 1.10.0"]
    GD -->|ASGI server| Uvicorn["uvicorn 0.34.0"]
    GD -->|inference| Torch["torch 2.13.0"]
    GD -->|model loading| Transformers["transformers 5.20.2 /<br/>tokenizers 0.23.3"]
    GD -->|metrics| PromClient["prometheus-client 0.26.0"]
    GD -->|runtime base| AIPCC["AIPCC base images<br/>CUDA 13.0 / CPU, torch 2.13, EL 9.8"]
    GD -.->|"judge client (upstream only)"| VllmJudge["vllm-judge 0.1.8"]
    GD -.->|"built-in only"| Regex["regex / jsonschema /<br/>xmlschema"]

    %% Internal Platform Dependencies
    GD -->|"ServingRuntime / InferenceService"| KServe["KServe"]
    ODHMC["odh-model-controller<br/>OOTB template"] -->|ships runtime| GD
    RHODS["rhods-operator<br/>related image"] -->|pins digest| GD
    Konflux["konflux-central<br/>Tekton pipeline"] -->|builds| GD
    GD -->|model creds via KServe| DataConn["S3 data connection Secret"]

    %% Integration Points
    Orchestrator["FMS Guardrails Orchestrator /<br/>vllm-orchestrator-gateway"] -->|"Detector API :8000"| GD
    Dashboard["odh-dashboard"] -->|UI deploy| GD
    Prom["Prometheus UWM"] -->|"scrape :8000"| GD

    %% External Services
    GD -->|"model storage (via storage-initializer)"| S3["S3 / PVC / OCI"]
    GD -.->|"OpenAI API (judge only)"| JudgeLLM["Judge LLM endpoint"]
    GD -->|optional| GPU["NVIDIA GPU"]

