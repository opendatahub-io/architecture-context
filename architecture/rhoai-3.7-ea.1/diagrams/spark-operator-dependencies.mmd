    style JDK fill:#999,stroke:#333
    style Catatonit fill:#999,stroke:#333
    style CR fill:#999,stroke:#333
    style ClientGo fill:#999,stroke:#333
    style OCPLib fill:#999,stroke:#333
    style Cron fill:#999,stroke:#333
    style PromGo fill:#999,stroke:#333
