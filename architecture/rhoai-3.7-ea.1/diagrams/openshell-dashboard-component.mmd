graph TB
    User["User<br/>(Browser)"]

    subgraph Ingress["Ingress (one of)"]
        Route["OpenShift Route<br/>443/TCP HTTPS<br/>edge or reencrypt"]
        HTTPRoute["Gateway API HTTPRoute<br/>443/TCP HTTPS listener"]
    end

    subgraph Pod["openshell-dashboard Pod (namespace: openshell)"]
        direction TB
        Proxy["oauth2-proxy sidecar<br/>4180/TCP<br/>OIDC sign-in, session cookie"]
        subgraph BFFContainer["openshell-dashboard container<br/>quay.io/rhoai/odh-openshell-dashboard-rhel9"]
            BFF["Go BFF (chi router)<br/>127.0.0.1:8080<br/>REST /api/v1"]
            SPA["React 18 + PatternFly 6 SPA<br/>static files in /srv/static"]
            Auth["auth.Middleware<br/>token presence only"]
            Terminal["Terminal WebSocket relay<br/>(gorilla/websocket)"]
            SDK["OpenShell Go SDK client"]
            Raw["Raw gRPC clients<br/>rawexec / rawprovider / rawprofile"]
        end
    end

    Gateway["OpenShell gateway<br/>openshell.&lt;ns&gt;.svc:8080<br/>gRPC (TLS)"]
    OIDC["OIDC provider<br/>(Keycloak, realm openshell)"]

    subgraph Helm["Helm chart: deploy/helm/openshell-dashboard"]
        Deploy["Deployment"]
        Svc["Service openshell-dashboard<br/>ClusterIP 4180/TCP"]
        NetPol["NetworkPolicy<br/>ingress 4180 from openshift-ingress"]
        HPA["HPA (optional, 1-4)"]
    end

    User -->|HTTPS 443| Route
    User -->|HTTPS 443| HTTPRoute
    Route -->|4180/TCP| Svc
    HTTPRoute -->|4180/TCP| Svc
    Svc --> Proxy
    Proxy -->|OIDC auth code + PKCE| OIDC
    Proxy -->|"HTTP loopback<br/>X-Forwarded-Access-Token"| BFF
    BFF --> SPA
    BFF --> Auth
    BFF --> Terminal
    Auth --> SDK
    Auth --> Raw
    Terminal --> SDK
    SDK -->|"gRPC + Bearer token"| Gateway
    Raw -->|"gRPC + Bearer token<br/>(upload, key names, profiles)"| Gateway
    Gateway -.->|validates JWT via JWKS| OIDC

    Deploy -.->|creates| Pod
    NetPol -.->|restricts| Pod
    HPA -.->|scales| Deploy

    style BFF fill:#4a90e2,color:#fff
    style SPA fill:#4a90e2,color:#fff
    style Auth fill:#4a90e2,color:#fff
    style Terminal fill:#4a90e2,color:#fff
    style SDK fill:#4a90e2,color:#fff
    style Raw fill:#4a90e2,color:#fff
    style Proxy fill:#f5a623
    style Gateway fill:#7ed321
    style OIDC fill:#e8e8e8
    style Route fill:#e8e8e8
    style HTTPRoute fill:#e8e8e8
