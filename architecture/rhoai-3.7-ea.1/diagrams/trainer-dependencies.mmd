graph LR
    Trainer["Trainer<br/>(trainer-operator +<br/>kubeflow-trainer-controller-manager)"]

    %% Internal RHOAI platform dependencies
    Trainer -->|"required: CRDs + controller, dependency gate"| JobSetOp["OpenShift JobSet Operator<br/>jobset-operator OLM"]
    Trainer -->|"CRUD/watch every TrainJob"| JobSet["JobSet<br/>jobset.x-k8s.io/v1alpha2"]
    Trainer -->|"Go library: reconciler, SSA, GC, TLS"| PlatUtils["odh-platform-utilities<br/>v0.5.0 / framework v0.3.1"]
    Kueue["Kueue"] -.->|"quota/queueing, indirect"| JobSet
    Trainer -.->|"optional PodGroups"| CoSched["scheduler-plugins<br/>CoScheduling"]
    Trainer -.->|"optional PodGroups"| Volcano["Volcano"]
    Trainer -->|"image references"| TrainImages["Universal training images<br/>training-hub"]

    %% Integration points (consumers / drivers)
    RHODS["rhods-operator"] -->|"Trainer CR, odh-trainer-config, env"| Trainer
    SDK["Kubeflow SDK"] -->|"creates TrainJobs"| Trainer
    Dashboard["Dashboard / workbenches"] -->|"consumes ImageStreams"| Trainer
    Prom["Prometheus / OpenShift monitoring"] -->|"scrapes 8443, ServiceMonitor, PrometheusRule"| Trainer

    %% Platform services
    Trainer -->|"HTTPS/6443 all reconciliation"| K8sAPI["Kubernetes API"]
    Trainer -->|"APIServer TLS profile, ClusterVersion"| OCPConfig["OpenShift config.openshift.io"]
    Trainer -->|"ImageStream CRUD"| ImageStreams["OpenShift ImageStreams"]
    Trainer -->|"HTTP/28080 progression polling"| Pods["Training pods"]
    Trainer -.->|"gRPC/6789 gated"| Optuna["Optuna suggestion service"]

    %% External Go libraries
    Trainer -->|"framework"| CR["controller-runtime v0.25.2"]
    Trainer -->|"client"| ClientGo["client-go / api v0.37.1"]
    Trainer -->|"types"| JobSetLib["sigs.k8s.io/jobset v0.12.0"]
    Trainer -->|"webhook certs"| CertCtl["cert-controller v0.16.0"]
    Trainer -->|"TLS profile types"| OSAPI["openshift/api, library-go"]
    Trainer -->|"MPI SSH encoding"| XCrypto["golang.org/x/crypto v0.58.0"]
    Trainer -->|"metrics"| PromClient["prometheus/client_golang v1.25.0"]
    Trainer -->|"OLM version helpers"| OLMAPI["operator-framework/api v0.42.0"]
    Trainer -.->|"gated: status server JWT"| OIDC["coreos/go-oidc v3.21.0"]
    Trainer -.->|"gated: Suggestion API"| Katib["kubeflow/katib v0.19.0<br/>grpc v1.84.0"]

