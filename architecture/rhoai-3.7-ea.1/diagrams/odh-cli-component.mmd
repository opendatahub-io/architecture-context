graph TB
    Admin["Cluster Administrator<br/>(workstation or one-shot container)"]

    subgraph CLI["odh-cli / rhai-cli (client-side binary, no in-cluster footprint)"]
        Root["rhai-cli / kubectl-odh<br/>cmd/main.go<br/>genericclioptions.ConfigFlags"]

        subgraph Supported["Supported subcommands"]
            Lint["lint<br/>pkg/lint<br/>read-only client.Reader Target<br/>exit codes 0/1/2"]
            Migrate["migrate<br/>pkg/migrate<br/>list / prepare / run / verify<br/>--dry-run, --yes"]
            Version["version"]
        end

        subgraph Hidden["Hidden subcommands"]
            Deps["deps<br/>pkg/deps<br/>OLM v0 / v1 install"]
            MCP["mcp serve<br/>pkg/mcp<br/>stdio or SSE 127.0.0.1:8080"]
            Diagnose["diagnose<br/>pkg/diagnose"]
            Misc["api, get, components, status,<br/>logs, events, completion"]
        end

        Backup["backup (pkg/backup)<br/>not registered in root"]
        Resources["pkg/resources<br/>GVR catalog, 30+ API groups"]
        RBACCheck["pkg/util/kube/rbac<br/>SelfSubjectAccessReview pre-flight"]
        Exec["pkg/util/exec<br/>SPDY pod exec"]
        Embedded["pkg/deps/data<br/>embedded odh-gitops manifest"]

        Root --> Lint
        Root --> Migrate
        Root --> Version
        Root --> Deps
        Root --> MCP
        Root --> Diagnose
        Root --> Misc
        Lint --> Resources
        Migrate --> Resources
        Migrate --> RBACCheck
        Migrate --> Exec
        Deps --> Embedded
    end

    Kubeconfig[("kubeconfig<br/>/kubeconfig or --token")]
    AIAgent["MCP Clients<br/>(AI agents)"]

    Admin -->|invokes| Root
    Kubeconfig -->|credentials| Root
    AIAgent -->|MCP stdio / SSE| MCP

    subgraph Cluster["OpenShift / Kubernetes Cluster"]
        APIServer["Kubernetes API Server<br/>6443/TCP"]
        DSC["DataScienceCluster /<br/>DSCInitialization CRs"]
        OLM["OLM v0 / v1<br/>Subscription, OperatorGroup,<br/>CSV, ClusterExtension"]
        CompCRs["Component CRs<br/>InferenceService, Kueue, Ray,<br/>Notebook, DSPA, TrustyAI, LlamaStack..."]
        TrustyRoute["TrustyAI Service Route<br/>443/TCP"]
        APIServer --- DSC
        APIServer --- OLM
        APIServer --- CompCRs
    end

    GitHub["raw.githubusercontent.com<br/>odh-gitops"]

    Lint -->|read| APIServer
    Migrate -->|read / patch / create / exec| APIServer
    Deps -->|create / poll| APIServer
    Diagnose -->|read| APIServer
    Migrate -->|"HTTPS, InsecureSkipVerify"| TrustyRoute
    Deps -.->|optional fetch| GitHub

    ODHOperator["opendatahub-operator<br/>Go libs: clusterhealth,<br/>failureclassifier, mcptools"]
    PlatformUtils["odh-platform-utilities v0.4.0"]
    Diagnose -.->|imports| ODHOperator
    MCP -.->|imports| ODHOperator
    Root -.->|imports| PlatformUtils

    style Root fill:#4a90e2,color:#fff
    style Lint fill:#4a90e2,color:#fff
    style Migrate fill:#4a90e2,color:#fff
    style Version fill:#4a90e2,color:#fff
    style Deps fill:#9fc5f8
    style MCP fill:#9fc5f8
    style Diagnose fill:#9fc5f8
    style Misc fill:#9fc5f8
    style Backup fill:#dddddd,stroke-dasharray: 5 5
    style DSC fill:#f5a623
    style OLM fill:#f5a623
    style CompCRs fill:#f5a623
    style APIServer fill:#e8e8e8
    style TrustyRoute fill:#7ed321
    style ODHOperator fill:#7ed321
    style PlatformUtils fill:#7ed321
    style GitHub fill:#e8e8e8
    style Kubeconfig fill:#ffe6cc
