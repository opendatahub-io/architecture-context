graph TB
    User["User / llm-d-deployer"] -->|creates| MSCR["ModelService CR<br/>llm-d.ai/v1alpha1"]
    Admin["Platform Admin"] -->|authors| BaseConfig["BaseConfig ConfigMap<br/>YAML templates"]

    subgraph Controller["llm-d-model-service (namespace: modelservice-system)"]
        Manager["manager binary<br/>Cobra CLI"]
        Reconciler["ModelServiceReconciler<br/>manager run"]
        Generate["manager generate<br/>offline rendering"]
        Template["Template interpolation<br/>Go templates + Sprig"]
        Merge["Semantic merge<br/>mergo + slice transformers"]
        CoU["CreateOrUpdate<br/>owner references"]
        Probes["Health probes<br/>:8081 /healthz /readyz"]
        Metrics["Metrics server<br/>:8443 HTTPS"]
        Manager --> Reconciler
        Manager --> Generate
        Reconciler --> Template
        Template --> Merge
        Merge --> CoU
        Generate -.->|reuses| Template
    end

    MSCR -->|watched by| Reconciler
    BaseConfig -->|read by| Reconciler

    subgraph Children["Child resources (ModelService namespace)"]
        PrefillDep["Prefill Deployment<br/>vLLM"]
        DecodeDep["Decode Deployment<br/>vLLM + routing sidecar"]
        EPPDep["EPP Deployment<br/>llm-d-inference-scheduler"]
        PDSvc["Prefill/Decode Services"]
        EPPSvc["EPP Service<br/>9002 gRPC ext-proc"]
        SAs["PD + EPP ServiceAccounts"]
        EPPRB["EPP RoleBinding<br/>to EPP_CLUSTER_ROLE"]
        CMs["Generated ConfigMaps"]
        Route["HTTPRoute"]
        Pool["InferencePool"]
        Model["InferenceModel"]
    end

    CoU -->|creates| PrefillDep
    CoU -->|creates| DecodeDep
    CoU -->|creates| EPPDep
    CoU -->|creates| PDSvc
    CoU -->|creates| EPPSvc
    CoU -->|creates| SAs
    CoU -->|creates| EPPRB
    CoU -->|creates| CMs
    CoU -->|creates| Route
    CoU -->|creates| Pool
    CoU -->|creates| Model
    Reconciler -->|updates status| MSCR

    Route -->|backendRef| Pool
    Pool -->|selects| DecodeDep
    Route -->|parentRefs| Gateway["Gateway<br/>external implementation"]

    Reconciler -->|depends on| K8sAPI["Kubernetes API"]
    Reconciler -->|depends on| GIE["Gateway API Inference Extension CRDs<br/>v1alpha2"]
    Reconciler -->|depends on| GWAPI["Gateway API CRDs v1"]

    style Manager fill:#4a90e2
    style Reconciler fill:#4a90e2
    style Generate fill:#4a90e2
    style Template fill:#4a90e2
    style Merge fill:#4a90e2
    style CoU fill:#4a90e2
    style Probes fill:#4a90e2
    style Metrics fill:#4a90e2
    style MSCR fill:#f5a623
    style BaseConfig fill:#f5a623
    style EPPDep fill:#7ed321
    style DecodeDep fill:#7ed321
    style PrefillDep fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style GIE fill:#e8e8e8
    style GWAPI fill:#e8e8e8
    style Gateway fill:#e8e8e8
