graph TD
    subgraph NoRBAC["ai4rag defines NO Kubernetes RBAC"]
        Note["No ClusterRoles, Roles, Bindings or ServiceAccounts<br/>No Kubernetes API usage<br/>Pod identity and RBAC belong to the consuming KFP pod"]
    end

    subgraph Host["Consuming KFP Component Pod (pipelines-components)"]
        PodSA["Pipeline run ServiceAccount<br/>(owned by DSP / pipelines-components)"]
        K8sSecrets["Kubernetes Secrets<br/>(e.g. data connections)"]
    end

    subgraph Env["Credentials injected as env vars / args"]
        S3Creds["AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY<br/>AWS_S3_ENDPOINT"]
        MaaSKey["MaaS api_key<br/>(function argument)"]
        MilvusTok["MILVUS_TOKEN"]
        PGCreds["PGVECTOR_USER / PGVECTOR_PASSWORD"]
        NeoCreds["NEO4J_USERNAME / NEO4J_PASSWORD"]
        CAs["MAAS_CA_BUNDLE, AWS_CA_BUNDLE,<br/>MILVUS_CA_CERT, PGVECTOR_CA_CERT, NEO4J_CA_CERT"]
    end

    subgraph Enforcement["Authorization enforced remotely"]
        S3Svc["S3 service<br/>SigV4, GET"]
        MaaSGW["MaaS gateway<br/>Bearer, GET/POST, rate limits"]
        DBs["Milvus / pgvector / Neo4j<br/>credential scope<br/>+ app-level ai4rag_* name prefix"]
    end

    PodSA -->|mounts| K8sSecrets
    K8sSecrets -->|populates| S3Creds
    K8sSecrets -->|populates| MaaSKey
    K8sSecrets -->|populates| MilvusTok
    K8sSecrets -->|populates| PGCreds
    K8sSecrets -->|populates| NeoCreds
    K8sSecrets -->|populates / DSP CA injection| CAs

    S3Creds -->|authenticates| S3Svc
    MaaSKey -->|authenticates| MaaSGW
    MilvusTok -->|authenticates| DBs
    PGCreds -->|authenticates| DBs
    NeoCreds -->|authenticates| DBs

    style Note fill:#e8e8e8
    style PodSA fill:#4a90e2
    style K8sSecrets fill:#f5a623
    style S3Svc fill:#7ed321
    style MaaSGW fill:#7ed321
    style DBs fill:#7ed321
