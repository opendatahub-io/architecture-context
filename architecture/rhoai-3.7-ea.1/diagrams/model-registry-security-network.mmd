graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform Gateway / odh-dashboard)"]
        Gateway["Platform Gateway + odh-dashboard<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth/OIDC bearer"]
        BFF["Dashboard model-registry BFF"]
    end

    subgraph Cluster["CLUSTER INTERNAL (RHOAI)"]
        direction TB

        subgraph NS_Reg["Namespace: registry instance (operator-managed)"]
            AuthProxy["Auth proxy<br/>kube-rbac-proxy / Gateway HTTPRoute<br/>8443/TCP HTTPS (operator-defined)<br/>TokenReview + SAR"]
            Registry["model-registry proxy<br/>8080/TCP HTTP, no TLS<br/>NO in-process authn/authz"]
            RegSvc["Service: model-registry-service<br/>ClusterIP 8080/TCP"]
        end

        subgraph NS_Cat["Namespace: catalog (operator-managed)"]
            CatProxy["Catalog proxy<br/>(operator-managed, proxy-defined TLS)"]
            Catalog["model-catalog<br/>8080/TCP HTTP, no TLS<br/>NO in-process authn/authz<br/>Leader election via pglock"]
            CatPG[("model-catalog-postgres<br/>5432/TCP<br/>TLS not configured<br/>Password Secret")]
        end

        subgraph NS_User["Namespace: user project"]
            Job["async-upload Job<br/>Python 3.12, AIPCC base<br/>Creds via Secret env/mount"]
        end

        subgraph NS_Op["Namespace: model-registry-operator"]
            Ctrl["ISVC controller library<br/>SA token"]
        end

        RegDB[("Registry DB<br/>MySQL 3306 / PostgreSQL 5432<br/>Optional TLS 1.2+<br/>server cert verify OFF by default")]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        HF["huggingface.co<br/>443/TCP HTTPS<br/>Optional HF_API_KEY"]
        Git["Git remotes<br/>443 / 80 / 9418 TCP<br/>TLS for https only"]
        S3["S3 storage<br/>443/TCP HTTPS<br/>AWS access keys"]
        OCI["OCI registries<br/>443/TCP HTTPS<br/>TLS verify on by default"]
        Sigstore["Sigstore Fulcio/Rekor/TUF<br/>443/TCP HTTPS<br/>OIDC token"]
    end

    Browser -->|HTTPS/443<br/>TLS 1.2+<br/>OAuth/OIDC bearer| Gateway
    Gateway --> BFF
    BFF -->|HTTPS/8443<br/>TLS<br/>User bearer token| AuthProxy
    AuthProxy -->|HTTP/8080<br/>plaintext loopback<br/>no auth| Registry
    BFF -->|HTTP or HTTPS/8080<br/>proxy-defined<br/>User token at proxy| CatProxy
    CatProxy -->|HTTP/8080<br/>plaintext| Catalog
    BFF -->|HTTPS/6443<br/>TLS 1.2+<br/>User/SA token<br/>create Job + Secret| K8sAPI

    RegSvc -.->|"direct in-cluster access<br/>BYPASSES auth (no NetworkPolicy)"| Registry

    Registry -->|DB wire 3306/5432<br/>optional TLS 1.2+<br/>DB password| RegDB
    Catalog -->|PostgreSQL/5432<br/>no TLS configured<br/>PGUSER/PGPASSWORD| CatPG
    Catalog -->|HTTPS/443<br/>TLS system trust<br/>optional HF key| HF
    Catalog -->|https/http/git<br/>optional git creds| Git

    Job -->|HTTPS/443<br/>TLS<br/>AWS keys| S3
    Job -->|HTTPS/443<br/>TLS<br/>registry creds| OCI
    Job -->|HTTPS/443<br/>TLS<br/>projected SA OIDC| Sigstore
    Job -->|HTTPS/443<br/>TLS, custom CA opt.<br/>Bearer user token| AuthProxy

    Ctrl -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| K8sAPI
    Ctrl -->|HTTPS/443 or HTTP/8080<br/>TLS 1.2, skip-verify opt.<br/>Bearer token| Registry

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Gateway,BFF ingress
    class AuthProxy,CatProxy,Job,Ctrl,K8sAPI,RegSvc internal
    class Registry,Catalog,RegDB,CatPG risk
    class HF,Git,S3,OCI,Sigstore externalservice
