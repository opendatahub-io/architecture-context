graph TD
    subgraph SAs["Service Accounts"]
        SA["workspaces-controller<br/>controller ns"]
        WSSA["per-Workspace SA<br/>user ns"]
    end

    subgraph Bindings["Bindings"]
        CRB1["workspaces-manager-rolebinding<br/>ClusterRoleBinding"]
        CRB2["workspaces-controller-tls-profile-rolebinding<br/>ClusterRoleBinding"]
        RB1["workspaces-leader-election-rolebinding<br/>RoleBinding, controller ns"]
        CRB3["ws-NAME-rbac-NS-auth-delegator<br/>ClusterRoleBinding, runtime"]
        RB2["per-Workspace RoleBindings<br/>user ns, runtime"]
    end

    subgraph Roles["Roles"]
        MR["workspaces-manager-role<br/>ClusterRole + gateway patch"]
        TR["workspaces-controller-tls-profile-role"]
        LR["workspaces-leader-election-role<br/>Role"]
        AD["system:auth-delegator"]
        WKR["ClusterRoles named in WorkspaceKind"]
    end

    subgraph Resources["API Resources"]
        Core["core: configmaps, events, namespaces, pods"]
        Exec["core: pods/exec"]
        SvcSA["core: services, serviceaccounts"]
        CM["core: configmaps (gateway patch)"]
        STS["apps: statefulsets"]
        Auth["authentication: tokenreviews<br/>authorization: subjectaccessreviews"]
        KF["kubeflow.org: workspaces, workspacekinds<br/>+ status, finalizers"]
        VS["networking.istio.io: virtualservices"]
        RBAC["rbac: rolebindings"]
        CRBRes["rbac: clusterrolebindings"]
        Bind["rbac: clusterroles incl. system:auth-delegator"]
        GW["gateway.networking.k8s.io:<br/>httproutes, referencegrants"]
        API["config.openshift.io: apiservers"]
        Lease["core configmaps, coordination leases, events"]
    end

    SA --> CRB1 --> MR
    SA --> CRB2 --> TR
    SA --> RB1 --> LR
    WSSA --> CRB3 --> AD
    WSSA --> RB2 --> WKR
    MR -.->|"controller creates CRB3 via bind"| CRB3

    MR -->|get, list, watch| Core
    MR -->|create| Exec
    MR -->|full CRUD| SvcSA
    MR -->|full CRUD| CM
    MR -->|full CRUD| STS
    MR -->|create| Auth
    MR -->|full CRUD| KF
    MR -->|full CRUD| VS
    MR -->|full CRUD| RBAC
    MR -->|full CRUD| CRBRes
    MR -->|bind| Bind
    MR -->|full CRUD| GW
    TR -->|get, list, watch| API
    LR -->|"get/list/watch/create/update/patch/delete"| Lease
    AD -->|create| Auth

    subgraph UserRoles["User-facing aggregated ClusterRoles"]
        Edit["workspaces-edit<br/>to OpenShift edit + workspaces-admin"]
        View["workspaces-view<br/>to OpenShift view"]
        KAdmin["kubeflow-workspaces-admin"]
    end
    Edit -->|full CRUD + deletecollection| WSRes["kubeflow.org: workspaces, workspaces/status"]
    View -->|get, list, watch| WSRes
    KAdmin -->|full CRUD| WSKRes["kubeflow.org: workspacekinds, status"]

