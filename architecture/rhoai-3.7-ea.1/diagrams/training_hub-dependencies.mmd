graph LR
    TH["training_hub v0.11.2<br/>training-hub on PyPI"]

    %% Core external dependencies
    TH -->|runtime| Torch["torch >=2.6.0<br/>torchrun, NCCL/Gloo"]
    TH -->|models| Transformers["transformers >=4.57.6"]
    TH -->|SFT backend| ILab["instructlab-training >=0.16.2"]
    TH -->|OSFT backend| MiniT["rhai-innovation-mini-trainer >=0.8.3"]
    TH -->|adapters| Peft["peft / accelerate"]
    TH -->|datasets| Datasets["datasets / pandas / numpy"]
    TH -->|checkpoint storage| Fsspec["fsspec >=2025.0"]
    TH -->|config| Pydantic["pydantic / pyyaml / rich / jinja2"]
    TH -->|plotting| Matplotlib["matplotlib >=3.9"]

    %% Optional extras
    TH -.->|"s3 extra"| S3fs["s3fs"]
    TH -.->|"cuda extra"| Cuda["flash-attn, bitsandbytes,<br/>liger-kernel, mamba-ssm"]
    TH -.->|"lora extra"| Unsloth["unsloth, trl, xformers"]
    TH -.->|"grpo extra"| ART["openpipe-art + vLLM"]
    TH -.->|"grpo / gepa extra"| LiteLLM["litellm >=1.71.1<br/>excludes 1.82.7, 1.82.8, 1.107.0"]
    TH -.->|"grpo-verl extra"| Verl["verl >=0.7"]
    TH -.->|"gepa extra"| Gepa["gepa / mlflow"]
    TH -.->|"embedding extra"| ST["sentence-transformers >=5.0"]

    %% Internal platform
    UImage["Universal training image<br/>distributed-workloads"] -->|pip install| TH
    AIPCC["AIPCC<br/>wheels + base images"] -.->|indirect| UImage
    Trainer["Kubeflow Trainer v2"] -->|"hosts pods, PET_* env"| TH
    KFTO["KFTO PyTorchJob"] -->|"legacy host"| TH
    Workbench["Notebooks / Workbenches"] -->|interactive use| TH
    TH -->|SDK client| MLflowSvc["MLflow RHOAI or external"]
    TH -->|"REST via litellm"| Serving["Model serving<br/>vLLM OpenAI-compatible"]
    FMS["fms-hf-tuning"] -.-|peer library| TH

    %% External services
    TH -->|"HTTPS/443"| S3["S3-compatible storage"]
    TH -->|"HTTPS/443"| HF["HuggingFace Hub"]
    TH -.->|"HTTPS/443"| WandB["Weights & Biases"]

