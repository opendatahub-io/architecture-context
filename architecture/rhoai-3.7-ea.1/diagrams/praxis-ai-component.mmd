graph TB
    Client["Client<br/>OpenAI / Anthropic / MCP / A2A"]
    Authn["Trusted Upstream Authenticator<br/>Gateway / kube-rbac-proxy"]

    subgraph PraxisAI["praxis-ai (single binary, image: ghcr.io/praxis-proxy/ai)"]
        direction TB
        subgraph Core["Praxis proxy core 0.8.0 (Pingora) - inherited"]
            Listener["Proxy Listener<br/>8080/TCP<br/>optional TLS / mTLS"]
            Admin["Admin API<br/>9901/TCP<br/>/healthy /ready /metrics"]
            LB["Router / Load Balancer<br/>health checks"]
            Reload["Config Hot Reload<br/>filesystem watcher"]
        end

        subgraph Server["praxis-ai-proxy (server/)"]
            CLI["CLI<br/>-c / -t / -T<br/>PRAXIS_CONFIG"]
            FIPS["FIPS startup checks<br/>PRAXIS_REQUIRE_FIPS"]
            Registry["Filter registration<br/>~60 AI filters<br/>build.rs auto-discovery"]
            Readiness["Store provisioning<br/>and readiness gate"]
        end

        subgraph Filters["praxis-ai-filters (filters/)"]
            Routing["Routing<br/>intelligent_route, model_to_header,<br/>model_to_provider,<br/>llmisvc_model_provider_resolver"]
            Policy["Policy<br/>guardrails, token rate limit / ceiling,<br/>identity_header_guard, peer_identity_trust"]
            Obs["Observability<br/>token usage, TTFT, inflight, OpenTelemetry"]
            CloudAuth["Cloud auth<br/>AWS SigV4, Azure AD, GCP ADC"]
        end

        subgraph Apis["praxis-ai-apis (apis/)"]
            Translators["Protocol translators<br/>Anthropic / Chat / Responses /<br/>Bedrock / Azure / Vertex"]
            Stateful["Responses / Conversations /<br/>agentic loop (experimental)"]
            StateOwner["state_owner<br/>trusted x-auth-* headers"]
            MCPClient["MCP client, web search,<br/>credential sources"]
        end

        ExtProc["praxis-ai-llmd-ext-proc<br/>(optional llmd-ext-proc feature)<br/>Envoy ext_proc gRPC client"]

        subgraph Store["Store crates"]
            StoreTraits["praxis-ai-store<br/>traits + StateOwner"]
            StoreBackends["praxis-ai-store-backends<br/>PostgreSQL / SQLite via SQLx fork"]
            StoreLifecycle["praxis-ai-store-lifecycle<br/>expiry / reaping"]
        end
    end

    Client -->|HTTP/HTTPS 8080| Listener
    Authn -->|x-auth-tenant / x-auth-user| Listener
    Listener --> Policy
    Policy --> Routing
    Routing --> Translators
    Translators --> CloudAuth
    Routing --> LB
    StateOwner --> Stateful
    Stateful --> StoreTraits
    StoreTraits --> StoreBackends
    StoreLifecycle --> StoreBackends
    Routing --> ExtProc
    CLI --> Registry
    Registry --> Filters
    Readiness --> Admin
    Reload --> Registry

    LB -->|HTTP/HTTPS| Backends["Inference Backends<br/>vLLM, KServe LLMInferenceService,<br/>OpenAI, Anthropic"]
    CloudAuth -->|HTTPS 443| Cloud["AWS Bedrock / Azure OpenAI /<br/>Vertex AI"]
    ExtProc -->|gRPC ext_proc| EPP["llm-d EPP"]
    StoreBackends -->|PostgreSQL 5432 TLS| PG[("PostgreSQL / SQLite")]
    Policy -->|RESP TLS| Valkey[("Valkey / Redis Sentinel")]
    Policy -->|HTTPS 443| Guardrails["NeMo Guardrails / Lakera"]
    MCPClient -->|HTTPS| MCP["MCP servers / A2A agents"]
    Obs -->|OTLP| OTel["OpenTelemetry collector"]
    Prom["Prometheus"] -->|scrape 9901| Admin

