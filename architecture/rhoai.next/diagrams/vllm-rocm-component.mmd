graph TB
    subgraph "vLLM ROCm Inference Server"
        direction TB
        subgraph "Container: vllm-grpc-adapter"
            TGISAdapter["vllm_tgis_adapter<br/>(Python entrypoint)"]
            VLLMEngine["vLLM Engine<br/>(from RHAIIS base image)"]
            OpenAIServer["OpenAI-Compatible REST API<br/>Port 8000/TCP"]
            TGISServer["TGIS gRPC Server<br/>Port 8033/TCP"]

            TGISAdapter -->|starts| VLLMEngine
            TGISAdapter -->|exposes| TGISServer
            VLLMEngine -->|serves| OpenAIServer
        end
    end

    subgraph "Base Image Layer"
        RHAIIS["RHAIIS vllm-rocm-rhel9:3.2.1<br/>(ROCm runtime, Python, vLLM)"]
    end

    subgraph "Platform Infrastructure"
        KServe["KServe<br/>(Container Orchestration)"]
        ODHModelCtrl["odh-model-controller<br/>(ServingRuntime Template)"]
        Ingress["Platform Ingress<br/>(Gateway API / kube-rbac-proxy)"]
        Istio["Istio Service Mesh<br/>(mTLS)"]
    end

    subgraph "Hardware"
        GPU["AMD ROCm GPU<br/>(Device Plugin)"]
    end

    Client[External Client] -->|HTTPS/443| Ingress
    Ingress -->|HTTP/8000<br/>mTLS| OpenAIServer
    ODHModelCtrl -->|deploys via<br/>SHA256 digest| TGISAdapter
    KServe -->|manages lifecycle| TGISAdapter
    Istio -->|mTLS sidecar| TGISAdapter
    VLLMEngine -->|GPU compute| GPU
    RHAIIS -.->|provides all<br/>runtime dependencies| TGISAdapter

    style TGISAdapter fill:#4a90e2,color:#fff
    style VLLMEngine fill:#4a90e2,color:#fff
    style OpenAIServer fill:#7ed321,color:#fff
    style TGISServer fill:#7ed321,color:#fff
    style RHAIIS fill:#9b59b6,color:#fff
    style KServe fill:#e8e8e8,stroke:#333
    style ODHModelCtrl fill:#e8e8e8,stroke:#333
    style Ingress fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style GPU fill:#f5a623,color:#fff
    style Client fill:#f9f9f9,stroke:#999
