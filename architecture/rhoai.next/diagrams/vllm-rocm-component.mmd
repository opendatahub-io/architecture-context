graph TB
    subgraph External["External Clients"]
        HTTPClient["HTTP Client<br/>(OpenAI-compatible)"]
        GRPCClient["Caikit / gRPC Client<br/>(TGIS protocol)"]
    end

    subgraph KServePod["KServe InferenceService Pod"]
        subgraph Sidecars["Platform Sidecars"]
            IstioProxy["Istio Sidecar Proxy<br/>mTLS termination"]
            KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>AuthN/AuthZ enforcement"]
        end

        subgraph VLLMContainer["vllm-rocm Container"]
            TGIS["vllm_tgis_adapter<br/>ENTRYPOINT<br/>Port 8033/TCP gRPC"]
            VLLMEngine["vLLM Engine<br/>Port 8000/TCP HTTP<br/>OpenAI-compatible API"]
            TGIS -->|in-process| VLLMEngine
        end
    end

    subgraph GPUHardware["GPU Hardware"]
        ROCM["AMD ROCm GPU<br/>(Instinct series)<br/>ROCm 7.14+"]
    end

    subgraph ModelSources["Model Sources"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS"]
        PVC["PVC Volume Mount"]
    end

    HTTPClient -->|"POST /v1/completions<br/>POST /v1/chat/completions"| IstioProxy
    GRPCClient -->|"gRPC 8033/TCP"| IstioProxy

    IstioProxy -->|"8443/TCP HTTPS"| KubeRBACProxy
    KubeRBACProxy -->|"8000/TCP HTTP<br/>plaintext localhost"| VLLMEngine
    IstioProxy -->|"8033/TCP gRPC<br/>plaintext localhost"| TGIS

    VLLMEngine -->|"PCIe / Infinity Fabric"| ROCM

    VLLMEngine -->|"Model loading<br/>TLS 1.2+"| HFHub
    VLLMEngine -->|"Model loading<br/>TLS 1.2+"| S3
    VLLMEngine -->|"Model loading"| PVC

    subgraph BaseImage["Build Lineage"]
        RHAIIS["registry.redhat.io/rhaiis/<br/>vllm-rocm-rhel9:3.2.1<br/>(base image)"]
    end

    RHAIIS -.->|"FROM (extends)"| VLLMContainer

