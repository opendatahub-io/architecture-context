graph TB
    subgraph External["External Access"]
        Client[Client / Application]
    end

    subgraph PlatformIngress["Platform Ingress Layer"]
        GatewayAPI["Gateway API<br/>443/TCP HTTPS"]
        KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>Auth Sidecar"]
    end

    subgraph VllmRocmPod["vllm-rocm Pod (UID 2000)"]
        direction TB
        TGISAdapter["vllm_tgis_adapter<br/>Entrypoint Module"]
        VllmEngine["vLLM Engine<br/>(from RHAIIS base)"]
        HTTPApi["OpenAI-Compatible REST API<br/>8000/TCP HTTP"]
        GRPCApi["TGIS gRPC Service<br/>8033/TCP gRPC"]

        TGISAdapter -->|starts| VllmEngine
        VllmEngine -->|serves| HTTPApi
        TGISAdapter -->|serves| GRPCApi
    end

    subgraph BaseImage["RHAIIS Base Image"]
        RHAIISBase["registry.redhat.io/rhaiis/<br/>vllm-rocm-rhel9:3.2.1"]
        ROCmRuntime["AMD ROCm Runtime"]
        VllmLib["vLLM Library<br/>(PagedAttention)"]
    end

    subgraph GPUHardware["GPU Hardware"]
        AMDGPU["AMD Instinct/Radeon GPU<br/>ROCm Device Plugin"]
    end

    subgraph KServePlatform["KServe Platform"]
        ServingRuntime["ServingRuntime CR"]
        InferenceService["InferenceService CR"]
        KServeController["KServe Controller"]
    end

    subgraph ModelStorage["Model Storage"]
        S3["S3 / PVC<br/>Model Weights"]
        HFHub["Hugging Face Hub<br/>(optional)"]
    end

    %% External access flow
    Client -->|HTTPS/443<br/>Bearer Token| GatewayAPI
    GatewayAPI -->|routes to| KubeRBACProxy
    KubeRBACProxy -->|HTTP/8000| HTTPApi
    KubeRBACProxy -->|gRPC/8033| GRPCApi

    %% KServe management
    KServeController -->|creates pod from| ServingRuntime
    ServingRuntime -->|references| VllmRocmPod
    InferenceService -->|triggers| KServeController

    %% Base image relationship
    RHAIISBase -->|extends via FROM| VllmRocmPod
    ROCmRuntime -.->|included in| RHAIISBase
    VllmLib -.->|included in| RHAIISBase

    %% GPU access
    VllmEngine -->|device driver| AMDGPU

    %% Model loading
    VllmEngine -->|loads models| S3
    VllmEngine -->|downloads| HFHub

    %% Styling
    style VllmRocmPod fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style TGISAdapter fill:#5ba3f5,stroke:#333,color:#fff
    style VllmEngine fill:#5ba3f5,stroke:#333,color:#fff
    style HTTPApi fill:#5ba3f5,stroke:#333,color:#fff
    style GRPCApi fill:#5ba3f5,stroke:#333,color:#fff
    style GatewayAPI fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style RHAIISBase fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ROCmRuntime fill:#d5e8d4,stroke:#82b366
    style VllmLib fill:#d5e8d4,stroke:#82b366
    style AMDGPU fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style ServingRuntime fill:#7ed321,stroke:#333
    style InferenceService fill:#7ed321,stroke:#333
    style KServeController fill:#7ed321,stroke:#333
    style S3 fill:#fff2cc,stroke:#d6b656
    style HFHub fill:#fff2cc,stroke:#d6b656
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
