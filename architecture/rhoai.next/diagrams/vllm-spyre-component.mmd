graph TB
    subgraph "vllm-spyre Container Image"
        direction TB
        TGISAdapter["vllm_tgis_adapter<br/>Python Module"]
        VLLMEngine["vLLM Inference Engine<br/>PagedAttention"]
        SpyreSDK["IBM Spyre SDK 1.3.1<br/>Hardware Acceleration"]

        TGISAdapter -->|wraps| VLLMEngine
        VLLMEngine -->|accelerated by| SpyreSDK
    end

    subgraph "Exposed APIs"
        gRPCPort["TGIS GenerationService<br/>gRPC :8033"]
        HTTPPort["OpenAI-Compatible API<br/>HTTP :8000"]
    end

    gRPCPort -->|routed to| TGISAdapter
    HTTPPort -->|routed to| VLLMEngine

    subgraph "Platform Layer"
        KServe["KServe / ModelMesh<br/>ServingRuntime"]
        ModelCtrl["Model Controller<br/>InferenceService CR"]
        Istio["Istio Sidecar<br/>mTLS / AuthZ"]
    end

    KServe -->|deploys & routes| gRPCPort
    KServe -->|deploys & routes| HTTPPort
    ModelCtrl -->|references image| TGISAdapter
    Istio -->|enforces auth| gRPCPort
    Istio -->|enforces auth| HTTPPort

    subgraph "External"
        ModelStorage["Model Storage<br/>S3 / PVC"]
        SpyreHW["IBM Spyre Accelerator<br/>Device Plugin"]
    end

    VLLMEngine -->|loads weights| ModelStorage
    SpyreSDK -->|device access| SpyreHW

    subgraph "Base Image Chain"
        RHAIIS["RHAIIS vllm-spyre-rhel9:3.2.2<br/>Product Image"]
        AIPCC["AIPCC Spyre Base Image<br/>Python 3.12 / RHEL 9.8"]
        RHAIIS -->|extends| AIPCC
    end

    TGISAdapter -.->|inherited from| RHAIIS

    style TGISAdapter fill:#4a90e2,color:#fff
    style VLLMEngine fill:#4a90e2,color:#fff
    style SpyreSDK fill:#4a90e2,color:#fff
    style gRPCPort fill:#f5a623,color:#fff
    style HTTPPort fill:#f5a623,color:#fff
    style KServe fill:#7ed321,color:#fff
    style ModelCtrl fill:#7ed321,color:#fff
    style Istio fill:#7ed321,color:#fff
    style ModelStorage fill:#e8e8e8,stroke:#333
    style SpyreHW fill:#e8e8e8,stroke:#333
    style RHAIIS fill:#d5e8d4,stroke:#82b366
    style AIPCC fill:#d5e8d4,stroke:#82b366
