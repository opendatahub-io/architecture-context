graph TB
    subgraph External["External Clients"]
        Client[Client Application]
    end

    subgraph KServePod["KServe Inference Pod"]
        subgraph Sidecar["Auth Sidecar"]
            KRBAC["kube-rbac-proxy<br/>8443/TCP HTTPS"]
        end

        subgraph VLLMContainer["vllm-spyre Container"]
            TGIS["vllm_tgis_adapter<br/>(Entrypoint)"]
            VLLMEngine["vLLM Engine<br/>(IBM Spyre accelerated)"]
            HTTPApi["OpenAI-compatible API<br/>8000/TCP HTTP"]
            GRPCApi["TGIS gRPC API<br/>8033/TCP gRPC"]

            TGIS --> VLLMEngine
            TGIS --> HTTPApi
            TGIS --> GRPCApi
        end

        KRBAC -->|"HTTP/8000<br/>localhost"| HTTPApi
        KRBAC -->|"gRPC/8033<br/>localhost"| GRPCApi
    end

    subgraph Platform["RHOAI Platform"]
        KServe["KServe Controller<br/>(ServingRuntime CR)"]
        Prometheus["Prometheus<br/>(Metrics Scrape)"]
    end

    subgraph Storage["Model Storage"]
        PVC["PVC Mount<br/>(Model Weights)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>(Optional)"]
    end

    subgraph Hardware["Accelerator Hardware"]
        Spyre["IBM Spyre<br/>Accelerator"]
    end

    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KRBAC
    KServe -->|"deploys & manages"| KServePod
    VLLMEngine -->|"loads model"| PVC
    VLLMEngine -->|"downloads model<br/>(if not pre-staged)"| HFHub
    VLLMEngine -->|"hardware acceleration"| Spyre
    Prometheus -->|"scrapes /metrics<br/>HTTP/8000"| HTTPApi

    style KRBAC fill:#e8a838,stroke:#333,stroke-width:2px
    style TGIS fill:#4a90e2,stroke:#333,stroke-width:2px
    style VLLMEngine fill:#4a90e2,stroke:#333,stroke-width:2px
    style HTTPApi fill:#4a90e2,stroke:#333,stroke-width:2px
    style GRPCApi fill:#4a90e2,stroke:#333,stroke-width:2px
    style KServe fill:#7ed321,stroke:#333,stroke-width:2px
    style Prometheus fill:#7ed321,stroke:#333,stroke-width:2px
    style PVC fill:#f5a623,stroke:#333,stroke-width:2px
    style HFHub fill:#f5a623,stroke:#333,stroke-width:2px
    style Spyre fill:#9b59b6,stroke:#333,stroke-width:2px
    style Client fill:#e8e8e8,stroke:#333,stroke-width:2px
