graph TB
    subgraph External["EXTERNAL CLIENTS"]
        Client["Client / Application<br/>(HTTP or gRPC)"]
    end

    subgraph KServePod["KServe ServingRuntime Pod"]
        subgraph AuthProxy["Authentication Layer"]
            KubeRBACProxy["kube-rbac-proxy<br/>Sidecar<br/>8443/TCP (HTTPS)"]
        end

        subgraph InferenceRuntime["vllm-spyre Container<br/>(odh-vllm-spyre-rhel9)"]
            TGISAdapter["vllm_tgis_adapter<br/>Entrypoint Module"]
            VLLMEngine["vLLM Inference Engine<br/>(from RHAIIS base image)"]
            SpyreBackend["IBM Spyre<br/>Accelerator Backend"]

            TGISAdapter -->|"manages"| VLLMEngine
            VLLMEngine -->|"offloads inference"| SpyreBackend
        end

        subgraph APIs["Exposed APIs"]
            HTTPPort["HTTP API<br/>8000/TCP<br/>OpenAI-compatible"]
            GRPCPort["gRPC API<br/>8033/TCP<br/>TGIS-compatible"]
        end

        TGISAdapter -->|"serves"| HTTPPort
        TGISAdapter -->|"serves"| GRPCPort
        KubeRBACProxy -->|"HTTP/8000<br/>(pre-authenticated)"| HTTPPort
        KubeRBACProxy -->|"gRPC/8033<br/>(pre-authenticated)"| GRPCPort
    end

    subgraph Platform["RHOAI Platform"]
        KServeController["KServe Controller<br/>(deploys ServingRuntime)"]
        SpyrePlugin["IBM Spyre<br/>Device Plugin"]
    end

    subgraph Storage["Model Storage"]
        PVC["PVC / S3<br/>Model Weights"]
    end

    subgraph BaseImage["Image Provenance"]
        RHAIIS["RHAIIS Base Image<br/>vllm-spyre-rhel9:3.2.2"]
        AIPCC["AIPCC Spyre Base<br/>quay.io/aipcc/base-images/spyre"]
        RHAIIS -->|"built from"| AIPCC
    end

    Client -->|"HTTPS/8443<br/>Bearer Token"| KubeRBACProxy
    KServeController -->|"lifecycle mgmt"| KServePod
    SpyrePlugin -->|"device allocation"| SpyreBackend
    PVC -->|"volume mount"| VLLMEngine

    %% Styling
    style KubeRBACProxy fill:#f5a623,stroke:#d79b00,stroke-width:2px
    style TGISAdapter fill:#4a90e2,stroke:#2171c7,stroke-width:2px
    style VLLMEngine fill:#4a90e2,stroke:#2171c7,stroke-width:2px
    style SpyreBackend fill:#9b59b6,stroke:#7d3c98,stroke-width:2px
    style HTTPPort fill:#7ed321,stroke:#5ea81a,stroke-width:2px
    style GRPCPort fill:#7ed321,stroke:#5ea81a,stroke-width:2px
    style KServeController fill:#e8e8e8,stroke:#999,stroke-width:2px
    style SpyrePlugin fill:#e8e8e8,stroke:#999,stroke-width:2px
    style PVC fill:#e8e8e8,stroke:#999,stroke-width:2px
    style RHAIIS fill:#ddd,stroke:#999,stroke-width:1px
    style AIPCC fill:#ddd,stroke:#999,stroke-width:1px
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
