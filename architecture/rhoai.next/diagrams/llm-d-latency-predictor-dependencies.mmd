graph LR
    LLP["llm-d-latency-predictor<br/>(Prediction + Training Servers)"]

    %% Internal Platform Dependencies
    LLP -->|"training data<br/>(TTFT/TPOT observations)"| LLMd["llm-d<br/>Inference Engine"]

    %% Integration Points (consumers)
    LLMdRouter["llm-d<br/>Routing Layer"] -->|"prediction requests<br/>POST /predict"| LLP

    %% Core ML Dependencies
    LLP -->|"quantile/mean regression"| XGBoost["XGBoost 3.3.0"]
    LLP -->|"tree-based regression"| LightGBM["LightGBM 4.6.0"]
    LLP -->|"BayesianRidge fallback"| ScikitLearn["scikit-learn 1.9.0"]

    %% Framework Dependencies
    LLP -->|"HTTP API"| FastAPI["FastAPI 0.138.1"]
    LLP -->|"ASGI server"| Uvicorn["uvicorn 0.49.0"]
    LLP -->|"validation"| Pydantic["Pydantic 2.13.4"]

    %% Data Processing Dependencies
    LLP -->|"feature engineering"| Pandas["pandas 3.0.3"]
    LLP -->|"numerical computation"| NumPy["numpy 2.5.0"]
    LLP -->|"model serialization"| Joblib["joblib 1.5.3"]
    LLP -->|"quantile statistics"| SciPy["scipy 1.18.0"]

    %% Optional Dependencies
    LLP -.->|"fast JSON (optional)"| ORJSON["orjson 3.11.9"]

    %% Infrastructure Dependencies
    LLP -->|"HTTP client<br/>(model downloads)"| Requests["requests 2.34.2"]
    LLP -->|"model file storage"| PVC["Kubernetes PVC"]
    LLP -->|"container runtime"| K8s["Kubernetes"]

    %% Build Dependencies
    LLP -->|"base image"| AIPCC["AIPCC CPU Base<br/>Image 3.5.0"]

    %% Styling
    style LLP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal platform
    style LLMd fill:#7ed321,stroke:#333
    style LLMdRouter fill:#7ed321,stroke:#333

    %% ML Libraries
    style XGBoost fill:#9b59b6,stroke:#333,color:#fff
    style LightGBM fill:#9b59b6,stroke:#333,color:#fff
    style ScikitLearn fill:#9b59b6,stroke:#333,color:#fff

    %% Frameworks
    style FastAPI fill:#e74c3c,stroke:#333,color:#fff
    style Uvicorn fill:#e74c3c,stroke:#333,color:#fff
    style Pydantic fill:#e74c3c,stroke:#333,color:#fff

    %% Data processing
    style Pandas fill:#f39c12,stroke:#333
    style NumPy fill:#f39c12,stroke:#333
    style Joblib fill:#f39c12,stroke:#333
    style SciPy fill:#f39c12,stroke:#333
    style ORJSON fill:#f39c12,stroke:#333

    %% Infrastructure
    style Requests fill:#999,stroke:#333
    style PVC fill:#999,stroke:#333
    style K8s fill:#999,stroke:#333
    style AIPCC fill:#999,stroke:#333
