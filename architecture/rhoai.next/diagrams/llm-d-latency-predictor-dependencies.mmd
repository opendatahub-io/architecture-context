graph LR
    LLP["llm-d-latency-predictor"]

    %% Internal Platform Dependencies
    LLP -->|"training data<br/>(TTFT/TPOT observations)"| LLMD["llm-d<br/>Inference Engine"]

    %% Core Framework Dependencies
    LLP -->|"HTTP API framework"| FastAPI["FastAPI 0.138.1"]
    LLP -->|"ASGI server"| Uvicorn["uvicorn 0.49.0"]
    LLP -->|"request validation"| Pydantic["pydantic 2.13.4"]

    %% ML Model Dependencies
    LLP -->|"quantile regression"| XGBoost["XGBoost 3.3.0"]
    LLP -->|"tree regression"| LightGBM["LightGBM 4.6.0"]
    LLP -->|"Bayesian regression<br/>StandardScaler"| Sklearn["scikit-learn 1.9.0"]

    %% Data Processing Dependencies
    LLP -->|"feature engineering"| Pandas["pandas 3.0.3"]
    LLP -->|"numerical computation"| Numpy["numpy 2.5.0"]
    LLP -->|"statistical functions"| Scipy["scipy 1.18.0"]

    %% Infrastructure Dependencies
    LLP -->|"model serialization"| Joblib["joblib 1.5.3"]
    LLP -->|"HTTP client<br/>(model download)"| Requests["requests 2.34.2"]
    LLP -.->|"fast JSON serialization<br/>(optional)"| Orjson["orjson 3.11.9"]

    %% Integration Points (consumers)
    RoutingLayer["llm-d Routing Layer"] -->|"consumes predictions<br/>POST /predict"| LLP

