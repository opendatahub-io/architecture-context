graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["${EPP_NAME}<br/>ServiceAccount"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["${EPP_NAME}-binding"]
        CRB2["${EPP_NAME}-leader-election-binding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["${EPP_NAME}"]
        CR2["${EPP_NAME}-leader-election"]
    end

    subgraph APIResources_Core["Core API Resources"]
        direction TB
        InfPools_xk8s["inference.networking.x-k8s.io<br/>InferencePools"]
        InfPools_k8s["inference.networking.k8s.io<br/>InferencePools"]
        InfObjectives["llm-d.ai<br/>InferenceObjectives"]
        InfModelRewrites["llm-d.ai<br/>InferenceModelRewrites"]
        Pods["core<br/>Pods"]
    end

    subgraph APIResources_Auth["Auth API Resources"]
        direction TB
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph APIResources_HA["HA / Leader Election Resources"]
        direction TB
        Leases["coordination.k8s.io<br/>Leases"]
        Events["core<br/>Events"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2

    CRB1 -->|"grants"| CR1
    CRB2 -->|"grants"| CR2

    %% Core role permissions
    CR1 -->|"get, watch, list"| InfPools_xk8s
    CR1 -->|"get, watch, list"| InfPools_k8s
    CR1 -->|"get, watch, list"| InfObjectives
    CR1 -->|"get, watch, list"| InfModelRewrites
    CR1 -->|"get, watch, list"| Pods
    CR1 -->|"create"| TokenReviews
    CR1 -->|"create"| SAR

    %% Leader election role permissions
    CR2 -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| Leases
    CR2 -->|"create, patch"| Events

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB1 fill:#50b5a9,stroke:#333,color:#fff
    style CRB2 fill:#50b5a9,stroke:#333,color:#fff
    style CR1 fill:#f5a623,stroke:#333,color:#000
    style CR2 fill:#f5a623,stroke:#333,color:#000
    style InfPools_xk8s fill:#7ed321,stroke:#333
    style InfPools_k8s fill:#7ed321,stroke:#333
    style InfObjectives fill:#7ed321,stroke:#333
    style InfModelRewrites fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style TokenReviews fill:#e8e8e8,stroke:#333
    style SAR fill:#e8e8e8,stroke:#333
    style Leases fill:#dae8fc,stroke:#333
    style Events fill:#dae8fc,stroke:#333
