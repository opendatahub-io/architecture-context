graph TD
    subgraph "Service Accounts"
        SA["${EPP_NAME}<br/>ServiceAccount<br/>Namespace: ${POOL_NAMESPACE}"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Main["${EPP_NAME}-binding<br/>ClusterRoleBinding"]
        CRB_LE["${EPP_NAME}-leader-election-binding<br/>ClusterRoleBinding"]
    end

    subgraph "ClusterRoles"
        CR_Main["${EPP_NAME}<br/>ClusterRole"]
        CR_LE["${EPP_NAME}-leader-election<br/>ClusterRole"]
    end

    subgraph "API Resources — Inference CRDs"
        InferencePools["inference.networking.x-k8s.io<br/>inference.networking.k8s.io<br/><b>InferencePools</b>"]
        InferenceObjectives["llm-d.ai<br/><b>InferenceObjectives</b><br/>+ /status"]
        InferenceModelRewrites["llm-d.ai<br/><b>InferenceModelRewrites</b><br/>+ /status"]
    end

    subgraph "API Resources — Core"
        Pods["core<br/><b>Pods</b>"]
    end

    subgraph "API Resources — Auth"
        TokenReviews["authentication.k8s.io<br/><b>TokenReviews</b>"]
        SAR["authorization.k8s.io<br/><b>SubjectAccessReviews</b>"]
    end

    subgraph "API Resources — Leader Election"
        Leases["coordination.k8s.io<br/><b>Leases</b>"]
        Events["core<br/><b>Events</b>"]
    end

    %% SA to bindings
    SA -->|"bound via"| CRB_Main
    SA -->|"bound via"| CRB_LE

    %% Bindings to roles
    CRB_Main -->|"grants"| CR_Main
    CRB_LE -->|"grants"| CR_LE

    %% Main role permissions
    CR_Main -->|"get, watch, list"| InferencePools
    CR_Main -->|"get, list, watch,<br/>update, patch"| InferenceObjectives
    CR_Main -->|"get, list, watch,<br/>update, patch"| InferenceModelRewrites
    CR_Main -->|"get, watch, list"| Pods
    CR_Main -->|"create"| TokenReviews
    CR_Main -->|"create"| SAR

    %% Leader election role permissions
    CR_LE -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| Leases
    CR_LE -->|"create, patch"| Events

    %% Styles
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB_Main fill:#6c8ebf,stroke:#333,color:#fff
    style CRB_LE fill:#6c8ebf,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333,color:#000
    style CR_LE fill:#f5a623,stroke:#333,color:#000
    style InferencePools fill:#7ed321,stroke:#333,color:#fff
    style InferenceObjectives fill:#7ed321,stroke:#333,color:#fff
    style InferenceModelRewrites fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style TokenReviews fill:#e06666,stroke:#333,color:#fff
    style SAR fill:#e06666,stroke:#333,color:#fff
    style Leases fill:#b4a7d6,stroke:#333,color:#000
    style Events fill:#b4a7d6,stroke:#333,color:#000
