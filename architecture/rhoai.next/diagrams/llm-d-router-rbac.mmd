graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["llm-d-router<br/>Namespace: {release-namespace}"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["llm-d-router-cluster-rbac<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB["llm-d-router-sa<br/>(RoleBinding)<br/>Namespace: {release-namespace}"]
    end

    subgraph ClusterRolePerms["ClusterRole: llm-d-router-cluster-rbac"]
        direction TB
        CR_TokenReview["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        CR_SubjectAccess["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
        CR_Metrics["(non-resource)<br/>/metrics<br/>Verbs: get"]
    end

    subgraph RolePerms["Role: llm-d-router-sa (namespace-scoped)"]
        R_Pods["core (&quot;&quot;)<br/>pods<br/>Verbs: get, watch, list"]
    end

    subgraph WatchedResources["Watched Resources (via controller-runtime)"]
        InferencePool["inference.networking.k8s.io/v1<br/>InferencePool<br/>Verbs: get, watch, list"]
        InferenceObjective["llm-d.ai/v1alpha2<br/>InferenceObjective<br/>Verbs: get, watch, list,<br/>update (status)"]
        InferenceModelRewrite["llm-d.ai/v1alpha2<br/>InferenceModelRewrite<br/>Verbs: get, watch, list,<br/>update (status)"]
    end

    subgraph AuthEndpoints["Authenticated Endpoints"]
        MetricsEndpoint["/metrics (9090/TCP)<br/>Auth: Bearer Token<br/>via SA tokenreview<br/>Default: enabled"]
        ExtProc["ext-proc gRPC (9002/TCP)<br/>Auth: None<br/>Network isolation only"]
        HealthEndpoint["Health (9003/TCP)<br/>Auth: None"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| CR_TokenReview
    CRB -->|"grants"| CR_SubjectAccess
    CRB -->|"grants"| CR_Metrics
    RB -->|"grants"| R_Pods

    %% CRD watches (controller-runtime permissions)
    SA -.->|"watches via<br/>controller-runtime"| InferencePool
    SA -.->|"watches + updates<br/>status"| InferenceObjective
    SA -.->|"watches + updates<br/>status"| InferenceModelRewrite

    %% Auth enforcement
    CR_TokenReview -->|"enables auth for"| MetricsEndpoint
    CR_SubjectAccess -->|"enables auth for"| MetricsEndpoint

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#d5e8d4,stroke:#82b366,color:#333
    style RB fill:#d5e8d4,stroke:#82b366,color:#333
    style CR_TokenReview fill:#f5a623,stroke:#333,color:#333
    style CR_SubjectAccess fill:#f5a623,stroke:#333,color:#333
    style CR_Metrics fill:#f5a623,stroke:#333,color:#333
    style R_Pods fill:#f5a623,stroke:#333,color:#333
    style InferencePool fill:#7ed321,stroke:#333,color:#333
    style InferenceObjective fill:#7ed321,stroke:#333,color:#333
    style InferenceModelRewrite fill:#7ed321,stroke:#333,color:#333
    style MetricsEndpoint fill:#fff2cc,stroke:#d6b656,color:#333
    style ExtProc fill:#fff2cc,stroke:#d6b656,color:#333
    style HealthEndpoint fill:#fff2cc,stroke:#d6b656,color:#333
