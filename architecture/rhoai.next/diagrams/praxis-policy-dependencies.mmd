graph LR
    PPE["Praxis Policy Engine<br/>(praxis-policy)"]

    %% Primary Host (Internal)
    PraxisProxy["Praxis Proxy<br/>(praxis-proxy/praxis)"] -->|"embeds as policy layer"| PPE

    %% Core Runtime Dependencies
    PPE -->|"async runtime"| Tokio["tokio 1.x"]
    PPE -->|"config + messages"| Serde["serde / serde_json /<br/>serde_yaml"]
    PPE -->|"diagnostics"| Tracing["tracing 0.1"]
    PPE -->|"timestamps"| Chrono["chrono 0.4"]
    PPE -->|"secret erasure"| Zeroize["zeroize 1.9"]

    %% TLS Stack (http-hyper feature)
    PPE -->|"TLS (http-hyper)"| Rustls["rustls 0.23<br/>(ring provider)"]
    PPE -->|"HTTPS connector"| HyperRustls["hyper-rustls 0.27"]
    PPE -->|"HTTP client"| HyperUtil["hyper-util 0.1"]
    PPE -->|"CA roots"| WebPKI["webpki-roots 1"]

    %% Identity (jwt feature)
    PPE -->|"JWT verify (jwt)"| JWT["jsonwebtoken 11<br/>(aws_lc_rs)"]

    %% Policy Decision Points
    PPE -->|"Cedar eval (cedar)"| Cedar["cedar-policy 4"]
    PPE -->|"CEL eval (cel)"| CEL["cel 0.14.5"]
    PPE -->|"Rego eval (opa)"| Regorus["regorus 0.12<br/>(restricted builtins)"]
    PPE -->|"stack guard (cedar/opa)"| Stacker["stacker 0.1"]

    %% Session & Cache
    PPE -->|"Valkey client (valkey)"| Redis["redis 1.7<br/>(tokio-rustls-comp)"]
    PPE -->|"connection pool (valkey)"| Deadpool["deadpool-redis 0.23"]
    PPE -->|"token cache (oauth)"| Moka["moka 0.12"]

    %% Crypto
    PPE -->|"HMAC (oauth)"| HMAC["hmac 0.13"]
    PPE -->|"SHA-256 (api-key/oauth/valkey)"| SHA2["sha2 0.11"]
    PPE -->|"base64 (jwt/oauth/ciba)"| Base64["base64 0.23"]

    %% External Services (runtime)
    PPE -.->|"JWKS + token exchange"| IdP["Identity Provider<br/>(Keycloak / Auth0)"]
    PPE -.->|"session taint labels"| Valkey["Valkey / Redis<br/>6379/TCP"]
    PPE -.->|"KV v2 secrets"| Vault["HashiCorp Vault<br/>8200/TCP"]

    %% Styling
    style PPE fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal Platform
    style PraxisProxy fill:#7ed321,stroke:#333,color:#fff

    %% Core deps
    style Tokio fill:#999,stroke:#333,color:#fff
    style Serde fill:#999,stroke:#333,color:#fff
    style Tracing fill:#999,stroke:#333,color:#fff
    style Chrono fill:#999,stroke:#333,color:#fff
    style Zeroize fill:#999,stroke:#333,color:#fff

    %% TLS stack
    style Rustls fill:#e67e22,stroke:#333,color:#fff
    style HyperRustls fill:#e67e22,stroke:#333,color:#fff
    style HyperUtil fill:#e67e22,stroke:#333,color:#fff
    style WebPKI fill:#e67e22,stroke:#333,color:#fff

    %% Identity + PDP
    style JWT fill:#9b59b6,stroke:#333,color:#fff
    style Cedar fill:#9b59b6,stroke:#333,color:#fff
    style CEL fill:#9b59b6,stroke:#333,color:#fff
    style Regorus fill:#9b59b6,stroke:#333,color:#fff
    style Stacker fill:#999,stroke:#333,color:#fff

    %% Session & Cache
    style Redis fill:#27ae60,stroke:#333,color:#fff
    style Deadpool fill:#27ae60,stroke:#333,color:#fff
    style Moka fill:#27ae60,stroke:#333,color:#fff

    %% Crypto
    style HMAC fill:#e67e22,stroke:#333,color:#fff
    style SHA2 fill:#e67e22,stroke:#333,color:#fff
    style Base64 fill:#999,stroke:#333,color:#fff

    %% External services
    style IdP fill:#f5a623,stroke:#333,color:#fff
    style Valkey fill:#f5a623,stroke:#333,color:#fff
    style Vault fill:#f5a623,stroke:#333,color:#fff
