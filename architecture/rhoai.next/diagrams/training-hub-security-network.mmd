graph TB
    subgraph UserEnv["USER ENVIRONMENT (Local / Kubeflow / Cloud GPU)"]
        direction TB

        User["User Code / thub CLI<br/>Python 3.11+"]

        subgraph Library["Training Hub Library"]
            Registry["AlgorithmRegistry<br/>(Strategy + Registry)"]
            Callbacks["TrainingHubCallback<br/>(9 Lifecycle Hooks)"]
        end

        subgraph GPUBackends["GPU TRAINING BACKENDS"]
            direction TB
            ILab["InstructLab Training<br/>(torchrun, NCCL)"]
            MiniTrainer["Mini-Trainer<br/>(torchrun, OSFT)"]
            Unsloth["Unsloth LoRA<br/>(DDP, multi-GPU)"]
            ART["ART/OpenPipe GRPO<br/>(mp.spawn, vLLM in-process)"]
            VeRL["verl FSDP<br/>(Popen, Ray/NCCL)"]
            SentTrans["sentence-transformers<br/>(PyTorch contrastive)"]
        end

        subgraph CPUBackend["CPU BACKEND (No GPU)"]
            GEPADirect["GEPA Direct<br/>(Evolutionary Optimization)"]
            GEPAMLflow["MLflow GEPA<br/>(Prompt Registry)"]
        end

        Disk["Local Filesystem<br/>(Checkpoints, Metrics,<br/>training_metrics.jsonl)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS"]
        LLMAPI["OpenAI-Compatible LLM API<br/>443/TCP HTTPS TLS<br/>⚠ litellm !=1.82.7,!=1.82.8"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS TLS"]
        MLflow["MLflow Tracking<br/>varies HTTPS TLS"]
        PyPI["PyPI<br/>pypi.org<br/>443/TCP HTTPS TLS"]
    end

    subgraph Platform["PLATFORM INTEGRATION"]
        Kubeflow["Kubeflow<br/>(File-based progress tracking)"]
    end

    %% User to Library
    User -->|"In-process API call<br/>No network"| Registry

    %% Registry to backends
    Registry -->|"dispatch"| ILab
    Registry -->|"dispatch"| MiniTrainer
    Registry -->|"dispatch"| Unsloth
    Registry -->|"dispatch"| ART
    Registry -->|"dispatch"| VeRL
    Registry -->|"dispatch"| SentTrans
    Registry -->|"dispatch"| GEPADirect
    Registry -->|"dispatch"| GEPAMLflow

    %% Backends to disk
    ILab -->|"Filesystem"| Disk
    ART -->|"JSON IPC<br/>training_results.json"| Disk
    VeRL -->|"Parquet + Checkpoints"| Disk
    SentTrans -->|"Filesystem"| Disk

    %% Disk to Kubeflow
    Disk -.->|"training_metrics.jsonl<br/>max_steps → progressPercentage"| Kubeflow

    %% External egress
    User -->|"HTTPS/443<br/>TLS<br/>Bearer HF_TOKEN"| HF
    GEPADirect -->|"HTTPS/443<br/>TLS<br/>Bearer OPENAI_API_KEY"| LLMAPI
    GEPAMLflow -->|"HTTPS/443<br/>TLS<br/>Bearer OPENAI_API_KEY"| LLMAPI
    ILab -.->|"HTTPS/443<br/>TLS<br/>API key WANDB_API_KEY"| WandB
    GEPAMLflow -.->|"HTTPS<br/>TLS<br/>Token"| MLflow
    User -.->|"HTTPS/443<br/>TLS"| PyPI

    %% Styling
    classDef userenv fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef backend fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef core fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User,Disk userenv
    class Registry,Callbacks core
    class ILab,MiniTrainer,Unsloth,ART,VeRL,SentTrans,GEPADirect,GEPAMLflow backend
    class HF,LLMAPI,WandB,MLflow,PyPI external
    class Kubeflow platform
