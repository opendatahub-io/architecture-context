graph TB
    subgraph TrainingHost["TRAINING HOST (Trusted - GPU Node / Pod)"]
        direction TB

        subgraph Library["Training Hub Library<br/>(PyPI: training-hub)"]
            direction TB

            subgraph InProcess["In-Process Algorithms"]
                SFT["SFT / OSFT / LoRA+SFT<br/>In-process backends"]
                GEPA["GEPA<br/>Prompt Optimization"]
            end

            subgraph SubProcess["Subprocess-Isolated Algorithms"]
                ART["LoRA GRPO (ART)<br/>subprocess + vLLM<br/>(thread safety isolation)"]
                VeRL["LoRA GRPO (verl)<br/>subprocess + Ray/FSDP"]
            end
        end
    end

    subgraph DistributedTraining["INTER-NODE (Distributed Training)"]
        direction TB
        TorchWorkers["PyTorch torchrun Workers<br/>NCCL/Gloo<br/>TCP, No Encryption<br/>Auth: rdzv_id"]
        RayCluster["Ray Cluster<br/>Object Store + GCS<br/>TCP, No Encryption<br/>Auth: None"]
    end

    subgraph EgressServices["EGRESS (Runtime-Dependent)"]
        direction TB
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: HF_TOKEN (optional)"]
        vLLMEndpoint["vLLM Inference Endpoint<br/>configurable port<br/>HTTP, None/TLS<br/>Auth: API key (optional)"]
        MLflowServer["MLflow Tracking Server<br/>configurable port<br/>HTTP/HTTPS<br/>Auth: Token (optional)"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: WANDB_API_KEY"]
        LLMAPI["LLM API (via litellm)<br/>configurable<br/>HTTP/HTTPS<br/>Auth: API key<br/>NOTE: v1.82.7-8 excluded<br/>(supply chain attack)"]
    end

    subgraph LocalIO["LOCAL I/O"]
        Checkpoints["Checkpoint Directory<br/>safetensors format"]
        TBLogs["TensorBoard Logs"]
        MetricsJSON["training_metrics.jsonl"]
    end

    %% In-process training flows
    SFT -->|"torchrun launch<br/>TCP (NCCL/Gloo)<br/>No Encryption"| TorchWorkers
    VeRL -->|"subprocess<br/>TCP (Ray)<br/>No Encryption"| RayCluster
    ART -->|"HTTP<br/>rollout generation"| vLLMEndpoint

    %% Egress flows
    Library -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    VeRL -->|"TCP (NCCL)<br/>rollout generation"| vLLMEndpoint
    GEPA -->|"HTTPS<br/>API key"| LLMAPI
    GEPA -->|"HTTP/HTTPS<br/>Token"| MLflowServer
    Library -.->|"HTTPS/443<br/>WANDB_API_KEY<br/>(optional)"| WandB
    Library -.->|"HTTP/HTTPS<br/>Token (optional)"| MLflowServer

    %% Local I/O
    Library -->|"File I/O"| Checkpoints
    Library -->|"File I/O"| TBLogs
    VeRL -->|"Log parsing"| MetricsJSON

    %% Styling
    classDef trusted fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef distributed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef localio fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef algorithm fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class SFT,GEPA,ART,VeRL algorithm
    class TorchWorkers,RayCluster distributed
    class HFHub,vLLMEndpoint,MLflowServer,WandB,LLMAPI egress
    class Checkpoints,TBLogs,MetricsJSON localio
