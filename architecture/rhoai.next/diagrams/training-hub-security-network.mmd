graph TB
    subgraph HostProcess["HOST PROCESS (Python Library — No Inbound Listeners)"]
        direction TB

        subgraph UserCode["User Code"]
            User["User Script / Notebook<br/>InstructLab CLI"]
        end

        subgraph Library["training-hub Library"]
            direction TB
            Registry["AlgorithmRegistry"]
            SFTBackend["SFT / OSFT Backends<br/>(in-process)"]
            LoRABackend["LoRA Backend<br/>(in-process)"]
            GRPOBackend["GRPO Backend<br/>(subprocess)"]
            GEPABackend["GEPA Backend<br/>(in-process)"]
        end

        subgraph LocalProcesses["Local Subprocesses"]
            GPU["GPU Workers<br/>torchrun<br/>TCP (NCCL/Gloo)<br/>No encryption"]
            vLLM["vLLM Inference<br/>localhost only<br/>HTTP (no TLS)<br/>No auth"]
        end
    end

    subgraph Egress["OUTBOUND (Egress — All Optional, Feature-Gated)"]
        direction TB
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: API Key"]
        MLflow["MLflow Tracking<br/>Configurable endpoint<br/>HTTP/HTTPS<br/>Auth: Configurable"]
        LLM_API["LLM API (litellm)<br/>OpenAI / Azure / etc.<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: API Key"]
        TorchRendezvous["PyTorch Rendezvous<br/>Cluster-internal nodes<br/>TCP (NCCL/Gloo)<br/>No encryption<br/>Auth: Rendezvous ID"]
    end

    subgraph LocalIO["LOCAL I/O"]
        FS["Local Filesystem<br/>Checkpoints, Adapters,<br/>Datasets, Logs<br/>POSIX permissions"]
        TB_Logs["TensorBoard Logs<br/>File I/O only"]
    end

    %% Internal flows
    User -->|"In-process call<br/>No network"| Registry
    Registry --> SFTBackend
    Registry --> LoRABackend
    Registry --> GRPOBackend
    Registry --> GEPABackend

    SFTBackend -->|"torchrun launch"| GPU
    LoRABackend -->|"in-process"| GPU
    GRPOBackend -->|"subprocess"| vLLM
    GRPOBackend -->|"subprocess"| GPU

    %% Egress flows
    SFTBackend -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| WandB
    SFTBackend -.->|"HTTP(S)<br/>Configurable"| MLflow
    GEPABackend -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| LLM_API
    GPU -.->|"TCP<br/>No encryption<br/>Rendezvous ID"| TorchRendezvous

    %% Local I/O
    SFTBackend -->|"File I/O"| FS
    LoRABackend -->|"File I/O"| FS
    GRPOBackend -->|"File I/O"| FS
    GEPABackend -->|"File I/O"| FS
    SFTBackend -.->|"File I/O"| TB_Logs

    %% Styling
    classDef hostprocess fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef usercode fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef library fill:#fff3cd,stroke:#d6b656,stroke-width:1px
    classDef localproc fill:#fce4ec,stroke:#e91e63,stroke-width:1px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef localio fill:#e8e8e8,stroke:#999,stroke-width:1px
    classDef warning fill:#f8d7da,stroke:#dc3545,stroke-width:2px

    class User usercode
    class Registry,SFTBackend,LoRABackend,GRPOBackend,GEPABackend library
    class GPU,vLLM localproc
    class WandB,MLflow,LLM_API egress
    class TorchRendezvous warning
    class FS,TB_Logs localio
