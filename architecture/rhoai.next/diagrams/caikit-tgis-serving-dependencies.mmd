graph LR
    CaikitTGIS["Caikit-TGIS-Serving<br/>(Model Serving Runtime)"]

    %% Internal Platform Dependencies
    CaikitTGIS -->|"CRD orchestration<br/>ServingRuntime, InferenceService"| KServe["KServe"]
    CaikitTGIS -->|"gRPC localhost:8033<br/>inference backend"| TGIS["TGIS<br/>(text-generation-inference)"]
    CaikitTGIS -->|"serverless scaling<br/>revision management"| Knative["Knative Serving"]
    CaikitTGIS -->|"Envoy sidecar<br/>mTLS STRICT"| Istio["Istio Service Mesh"]
    CaikitTGIS -.->|"metrics 8086/TCP<br/>PERMISSIVE mTLS"| Prometheus["Prometheus<br/>(openshift-user-workload-monitoring)"]

    %% External Dependencies (Python libraries)
    CaikitTGIS -->|"runtime APIs<br/>model management"| Caikit["caikit 0.28.1"]
    CaikitTGIS -->|"NLP text generation<br/>task support"| CaikitNLP["caikit-nlp 0.5.14"]
    CaikitTGIS -->|"TGIS backend<br/>connector"| CaikitTGISBackend["caikit-tgis-backend 0.1.39"]
    CaikitTGIS -->|"model acceleration"| Accelerate["accelerate 1.5.1"]

    %% External Services
    CaikitTGIS -->|"S3 API<br/>model artifacts"| S3["S3-Compatible Storage"]
    CaikitTGIS -->|"build-time<br/>dependency mgmt"| Poetry["Poetry"]
    CaikitTGIS -->|"runtime"| Python["Python ~3.11"]

    %% Integration Points (inbound)
    Dashboard["ODH Dashboard"] -.->|"UI management"| CaikitTGIS
    Pipelines["Data Science Pipelines"] -.->|"auto deploy models"| CaikitTGIS

