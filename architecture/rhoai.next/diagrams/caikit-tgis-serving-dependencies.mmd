graph LR
    CaikitTGIS["Caikit-TGIS Serving<br/>(Container Image)"]

    %% Internal Platform Dependencies
    CaikitTGIS -->|"CRD: ServingRuntime,<br/>InferenceService"| KServe["KServe"]
    CaikitTGIS -->|"gRPC/8033<br/>(localhost, same pod)"| TGIS["TGIS<br/>(text-generation-inference)"]
    CaikitTGIS -->|"CRD: Knative Service,<br/>Revision"| Knative["Knative Serving"]
    CaikitTGIS -->|"sidecar injection<br/>mTLS STRICT"| Istio["Istio / Service Mesh"]
    CaikitTGIS -->|"filesystem mount<br/>/mnt/models/"| PVC["PVC<br/>(Model Volume)"]

    %% External Services
    CaikitTGIS -->|"S3 API/443<br/>TLS 1.2+"| S3["S3 / MinIO<br/>Storage"]
    CaikitTGIS -.->|"HTTPS/443<br/>(dev only, ALLOW_DOWNLOADS=1)"| HuggingFace["HuggingFace Hub"]

    %% Python Library Dependencies
    CaikitTGIS -->|"v0.28.1"| Caikit["caikit<br/>(AI Toolkit)"]
    CaikitTGIS -->|"v0.5.14"| CaikitNLP["caikit-nlp<br/>(NLP Module)"]
    CaikitTGIS -->|"v0.1.39"| CaikitTGISBackend["caikit-tgis-backend<br/>(gRPC Connector)"]
    Caikit -->|"transitive"| Torch["torch >=2.0.0"]
    Caikit -->|"transitive"| Transformers["transformers"]
    Caikit -->|"transitive v1.5.1"| Accelerate["accelerate"]

    %% Consumers / Integration Points
    Prometheus["Prometheus<br/>(openshift-user-workload-<br/>monitoring)"] -->|"HTTP/8086<br/>ServiceMonitor"| CaikitTGIS
    Dashboard["ODH Dashboard /<br/>RHOAI Console"] -.->|"manages via"| KServe
    DSPipelines["Data Science<br/>Pipelines"] -.->|"auto-deploy via"| KServe

    %% Base Image
    CaikitTGIS -->|"base image"| UBI9["UBI 9 Minimal<br/>(ubi-minimal:latest)"]
    UBI9 -->|"provides"| Python311["Python 3.11"]
    UBI9 -->|"provides"| OpenSSL["OpenSSL<br/>(FIPS-capable)"]

