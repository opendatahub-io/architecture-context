graph LR
    CaikitTGIS["Caikit-TGIS-Serving<br/>(Container Image)"]

    %% Python Library Dependencies (bundled in image)
    CaikitTGIS -->|"imports<br/>(bundled)"| Caikit["caikit 0.28.1<br/>(Core AI Toolkit)"]
    CaikitTGIS -->|"imports<br/>(bundled)"| CaikitNLP["caikit-nlp 0.5.14<br/>(NLP Module)"]
    CaikitTGIS -->|"imports<br/>(bundled)"| CaikitTGISBackend["caikit-tgis-backend<br/>0.1.39<br/>(TGIS Connector)"]

    %% Runtime Dependencies
    CaikitTGIS -->|"runtime"| Python["Python 3.11"]
    CaikitTGIS -->|"base image"| UBI["UBI 9 Minimal<br/>(latest)"]

    %% Internal Platform Dependencies (runtime)
    CaikitTGIS -->|"gRPC :8033<br/>(co-located)"| TGIS["TGIS<br/>(text-generation-inference)<br/>Inference Engine"]
    CaikitTGIS -->|"deployed by<br/>(ServingRuntime CR)"| KServe["KServe"]
    CaikitTGIS -->|"sidecar<br/>(mTLS, traffic)"| Istio["Istio /<br/>Service Mesh"]
    CaikitTGIS -->|"autoscaling<br/>(Knative Service)"| Knative["Knative Serving /<br/>Serverless"]
    CaikitTGIS -->|"model download<br/>(init-container)"| StorageInit["KServe Storage<br/>Initializer"]

    %% Integration Points (consumed by)
    Prometheus["Prometheus /<br/>User Workload Monitoring"] -->|"scrapes :8086<br/>(HTTP)"| CaikitTGIS
    KServe -->|"references image"| CaikitTGIS

    %% External Services
    StorageInit -->|"model artifacts"| ModelStorage["Model Storage<br/>(S3 / MinIO / PVC)"]
    ConvertPy["convert.py<br/>(utility)"] -->|"HTTPS :443"| HFHub["HuggingFace Hub"]

    %% Build System
    Konflux["Konflux CI<br/>(Tekton)"] -->|"builds<br/>(x86_64, arm64)"| CaikitTGIS

    %% Platform Operator
    RHODSOp["rhods-operator"] -->|"manages"| KServe

