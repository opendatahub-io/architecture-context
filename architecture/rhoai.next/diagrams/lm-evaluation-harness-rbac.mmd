graph TD
    subgraph "RBAC Management (External)"
        Operator["TrustyAI Operator<br/>(LMEvalJob Controller)"]
    end

    subgraph "Job Pod Identity"
        SA["ServiceAccount<br/>(set by operator at Job creation)"]
    end

    subgraph "Secrets (Environment Variables)"
        HFToken["HF_TOKEN<br/>HuggingFace Hub Auth"]
        OpenAIKey["OPENAI_API_KEY<br/>Model Endpoint Auth"]
        AnthropicKey["ANTHROPIC_API_KEY<br/>Anthropic API Auth"]
        WatsonXKey["WATSONX_API_KEY<br/>watsonx.ai API Auth"]
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>S3 Storage Auth"]
        RegistryPwd["REGISTRY_PASSWORD<br/>OCI Registry Auth"]
    end

    subgraph "Application Security Guards"
        PathGuard["Path Traversal Guard<br/>Files must resolve under /meta<br/>(CWE-22 mitigation)"]
        ErrorSanitizer["Error Sanitization<br/>Regex redaction of tokens,<br/>keys, URLs, credentials"]
        CodeExecGuard["Code Execution Allow-List<br/>HF_ALLOW_CODE_EVAL scoped<br/>to humaneval, mbpp only"]
    end

    subgraph "Target Services"
        ModelEP["Model Inference Endpoint"]
        EvalHub["EvalHub Service"]
        HFHub["HuggingFace Hub"]
        S3["S3 Storage"]
        OCIReg["OCI Registry"]
    end

    %% RBAC flow
    Operator -->|"creates Job with<br/>ServiceAccount & RBAC"| SA

    %% Secret usage
    SA -->|"mounts secrets"| HFToken
    SA -->|"mounts secrets"| OpenAIKey
    SA -->|"mounts secrets"| AnthropicKey
    SA -->|"mounts secrets"| WatsonXKey
    SA -->|"mounts secrets"| AWSKey
    SA -->|"mounts secrets"| RegistryPwd

    %% Secret to service mapping
    OpenAIKey -->|"Bearer token"| ModelEP
    HFToken -->|"Bearer token"| HFHub
    AWSKey -->|"AWS v4 signing"| S3
    RegistryPwd -->|"Basic auth"| OCIReg

    %% Guard enforcement
    PathGuard -.->|"protects"| SA
    ErrorSanitizer -.->|"protects"| EvalHub
    CodeExecGuard -.->|"restricts"| SA

    %% Styling
    style Operator fill:#7ed321,color:#fff
    style SA fill:#4a90e2,color:#fff
    style HFToken fill:#f5a623,color:#fff
    style OpenAIKey fill:#f5a623,color:#fff
    style AnthropicKey fill:#f5a623,color:#fff
    style WatsonXKey fill:#f5a623,color:#fff
    style AWSKey fill:#f5a623,color:#fff
    style RegistryPwd fill:#f5a623,color:#fff
    style PathGuard fill:#f8cecc,stroke:#b85450
    style ErrorSanitizer fill:#f8cecc,stroke:#b85450
    style CodeExecGuard fill:#f8cecc,stroke:#b85450
    style ModelEP fill:#e8e8e8,stroke:#333
    style EvalHub fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OCIReg fill:#e8e8e8,stroke:#333
