graph TD
    subgraph OperatorManaged["RBAC Managed by TrustyAI LMEval Operator"]
        direction TB

        subgraph Operator["TrustyAI LMEval Operator"]
            OperatorSA["Operator ServiceAccount<br/>(manages RBAC for Job pods)"]
        end

        subgraph JobPodRBAC["Job Pod RBAC (Operator-Provisioned)"]
            JobSA["Job Pod ServiceAccount<br/>(created per LMEvalJob)"]
        end

        OperatorSA -->|"creates & binds"| JobSA
    end

    subgraph Secrets["Secrets (Provisioned Externally)"]
        direction TB
        ModelAuth["Model Auth Secret<br/>(Opaque)<br/>Keys: api-key, hf-token<br/>Provisioned: User / Operator<br/>Auto-rotate: No"]
        OCIAuth["OCI Registry Auth<br/>(Docker Config)<br/>Path: /tmp/.docker/config.json<br/>Provisioned: Operator<br/>Auto-rotate: No"]
        S3Creds["S3 Credentials<br/>(Opaque)<br/>Keys: AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY<br/>Provisioned: User<br/>Auto-rotate: No"]
    end

    subgraph AuthMechanisms["Outbound Authentication"]
        direction TB
        ModelBearerAuth["Model Endpoint Auth<br/>Method: Bearer Token<br/>Source: OPENAI_API_KEY env var<br/>Enforcement: Model serving infra"]
        HFAuth["HuggingFace Auth<br/>Method: Bearer Token<br/>Source: HF_TOKEN env var<br/>Enforcement: HuggingFace API"]
        EvalHubAuth["EvalHub Auth<br/>Method: Bearer Token<br/>Source: eval-hub-sdk config<br/>Enforcement: EvalHub service"]
        OCIAuthMech["OCI Registry Auth<br/>Method: Docker auth / user+pass<br/>Source: Docker config or<br/>OCI_USERNAME/OCI_PASSWORD<br/>Enforcement: Registry"]
    end

    JobSA -->|"mounts"| ModelAuth
    JobSA -->|"mounts"| OCIAuth
    JobSA -->|"mounts"| S3Creds
    ModelAuth -->|"provides"| ModelBearerAuth
    ModelAuth -->|"provides"| HFAuth
    OCIAuth -->|"provides"| OCIAuthMech

    Note["Note: This component defines NO ClusterRoles,<br/>Roles, or RoleBindings directly.<br/>All RBAC is managed by the TrustyAI LMEval Operator."]

    style OperatorSA fill:#7ed321,stroke:#333,color:#fff
    style JobSA fill:#4a90e2,stroke:#333,color:#fff
    style ModelAuth fill:#f5a623,stroke:#333
    style OCIAuth fill:#f5a623,stroke:#333
    style S3Creds fill:#f5a623,stroke:#333
    style ModelBearerAuth fill:#e8e8e8,stroke:#333
    style HFAuth fill:#e8e8e8,stroke:#333
    style EvalHubAuth fill:#e8e8e8,stroke:#333
    style OCIAuthMech fill:#e8e8e8,stroke:#333
    style Note fill:#fff3cd,stroke:#856404,color:#856404
