graph TD
    subgraph JobOrchestrator["EvalHub (External RBAC Manager)"]
        EvalHub["EvalHub Service<br/>Manages Job RBAC externally"]
    end

    subgraph JobRuntime["LMEval Batch Job Runtime"]
        SA["ServiceAccount<br/>(assigned by EvalHub)"]
    end

    subgraph CredentialSources["Credential Sources"]
        ModelSecret["model-auth-secret<br/>(Opaque)<br/>Contains: OPENAI_API_KEY, HF_TOKEN"]
        OCIAuth["oci-auth-config<br/>(dockerconfigjson)<br/>Contains: registry credentials"]
        AWSCreds["AWS Environment Variables<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
    end

    subgraph CredentialUsage["Credential Usage by Destination"]
        ModelAuth["Model Inference Endpoint<br/>Auth: Bearer Token<br/>(OPENAI_API_KEY)"]
        EvalHubAuth["EvalHub Callbacks<br/>Auth: Bearer Token<br/>(eval-hub-sdk managed)"]
        HFAuth["HuggingFace Hub<br/>Auth: Bearer Token<br/>(HF_TOKEN, optional)"]
        OCIRegAuth["OCI Registry<br/>Auth: Docker config<br/>(/tmp/.docker/config.json)"]
        S3Auth["S3 Storage<br/>Auth: AWS IAM<br/>(access key + secret)"]
        MLflowAuth["MLflow Server<br/>Auth: Bearer Token"]
    end

    %% EvalHub manages RBAC
    EvalHub -->|"creates Job with<br/>ServiceAccount"| SA
    EvalHub -->|"provisions via<br/>JobSpec secret_ref"| ModelSecret
    EvalHub -.->|"platform operator<br/>provisions"| OCIAuth

    %% SA uses credentials
    SA -->|"mounts secret"| ModelSecret
    SA -->|"mounts secret"| OCIAuth
    SA -->|"env vars"| AWSCreds

    %% Credential → Destination mapping
    ModelSecret -->|"OPENAI_API_KEY"| ModelAuth
    ModelSecret -->|"HF_TOKEN"| HFAuth
    OCIAuth -->|"docker config"| OCIRegAuth
    AWSCreds -->|"IAM credentials"| S3Auth

    %% Security controls
    subgraph SecurityControls["Security Controls"]
        Redaction["Error Redaction<br/>_sanitize_error_message()<br/>3-layer regex filtering"]
        PathProtection["Path Traversal Protection<br/>CWE-22: /meta restriction"]
        AirGap["Air-Gap Auto-Detection<br/>Disables HF network access<br/>when /test_data detected"]
    end

    SA -.->|"applied to<br/>all error output"| Redaction
    SA -.->|"restricts job spec<br/>file access"| PathProtection
    SA -.->|"auto-configures<br/>offline mode"| AirGap

    %% Styling
    style EvalHub fill:#7ed321,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style ModelSecret fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style OCIAuth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style AWSCreds fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ModelAuth fill:#f8cecc,stroke:#b85450
    style EvalHubAuth fill:#f8cecc,stroke:#b85450
    style HFAuth fill:#f8cecc,stroke:#b85450
    style OCIRegAuth fill:#f8cecc,stroke:#b85450
    style S3Auth fill:#f8cecc,stroke:#b85450
    style MLflowAuth fill:#f8cecc,stroke:#b85450
    style Redaction fill:#e1d5e7,stroke:#9673a6
    style PathProtection fill:#e1d5e7,stroke:#9673a6
    style AirGap fill:#e1d5e7,stroke:#9673a6
