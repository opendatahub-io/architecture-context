graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / SDK Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Kubeflow Gateway<br/>Istio VirtualService<br/>TLS SIMPLE"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS - multi-user mode)"]
        direction TB

        subgraph NS_Pipeline["Namespace: kubeflow"]
            Frontend["Frontend<br/>ml-pipeline-ui<br/>80/TCP &rarr; 3000<br/>SA: ml-pipeline-ui"]
            APIServer["API Server<br/>ml-pipeline<br/>8888/TCP HTTP, 8887/TCP gRPC<br/>SA: ml-pipeline<br/>Auth: TokenReview + SAR"]
            VizServer["Visualization Server<br/>8888/TCP HTTP<br/>No Auth"]
            PersistAgent["Persistence Agent<br/>SA: ml-pipeline-persistenceagent"]
            ScheduledWF["ScheduledWorkflow Controller<br/>SA: ml-pipeline-scheduledworkflow"]
            ViewerCtrl["Viewer Controller<br/>SA: ml-pipeline-viewer-crd-sa"]
        end

        subgraph NS_Cache["Cache System"]
            CacheServer["Cache Server<br/>8443/TCP HTTPS<br/>TLS cert: /etc/webhook/certs<br/>SA: kubeflow-pipelines-cache"]
        end

        subgraph NS_Data["Data Services"]
            MySQL["MySQL<br/>3306/TCP<br/>Istio mTLS<br/>AuthzPolicy: 7 SAs"]
            MinIO["MinIO<br/>9000/TCP HTTP<br/>Istio mTLS<br/>AuthzPolicy: 2 SAs"]
            MLMD["ML Metadata gRPC<br/>8080/TCP<br/>No Encryption<br/>No Auth"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        Tekton["Tekton Pipelines v0.41.0<br/>CRD-based interaction"]
    end

    %% External flows
    User -->|"HTTP/80<br/>TLS at gateway<br/>OAuth / userid header"| Gateway
    Gateway -->|"HTTP/3000<br/>Istio mTLS"| Frontend

    %% Frontend to API
    Frontend -->|"HTTP/8888<br/>Istio mTLS<br/>Bearer Token"| APIServer

    %% API Server outbound
    APIServer -->|"TCP/3306<br/>Istio mTLS<br/>Password"| MySQL
    APIServer -->|"HTTP/9000<br/>Istio mTLS<br/>Access key"| MinIO
    APIServer -->|"HTTP/8888<br/>No Auth"| VizServer
    APIServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Cache webhook flow
    K8sAPI -->|"HTTPS/443<br/>TLS<br/>Admission cert"| CacheServer
    CacheServer -->|"TCP/3306<br/>Istio mTLS<br/>Password"| MySQL

    %% Persistence agent
    PersistAgent -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    PersistAgent -->|"HTTP/8888<br/>Istio mTLS"| APIServer

    %% ScheduledWorkflow
    ScheduledWF -->|"HTTPS/6443<br/>SA Token"| K8sAPI

    %% Metadata
    PersistAgent -->|"gRPC/8080<br/>No TLS"| MLMD

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cache fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Gateway ingress
    class Frontend,APIServer,VizServer,PersistAgent,ScheduledWF,ViewerCtrl servicemesh
    class CacheServer cache
    class MySQL,MinIO,MLMD data
    class K8sAPI,Tekton externalservice
