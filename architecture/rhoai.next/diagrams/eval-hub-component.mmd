graph TB
    subgraph External["External Clients"]
        Client[Client / AI Agent]
    end

    subgraph AuthProxy["Auth Boundary"]
        KRBP["kube-rbac-proxy<br/>443/TCP HTTPS<br/>Bearer Token Auth"]
    end

    subgraph EvalHubPod["eval-hub Pod"]
        API["eval-hub API Server<br/>8080/TCP"]
        Metrics["Metrics Server<br/>8081/TCP"]
    end

    subgraph MCPPod["evalhub-mcp Pod"]
        MCP["evalhub-mcp Server<br/>3001/TCP"]
    end

    subgraph JobPod["Evaluation Job Pod"]
        Init["eval-runtime-init<br/>(init container)"]
        Adapter["Provider Adapter<br/>(lm-eval-harness / RAGAS<br/>/ Garak / GuideLLM)"]
        Sidecar["eval-runtime-sidecar<br/>(sidecar proxy)"]
        Init -->|"shared volume"| Adapter
        Adapter -->|"all outbound traffic"| Sidecar
    end

    subgraph DataStores["Data Stores"]
        PG["PostgreSQL<br/>5432/TCP"]
        SQLite["SQLite<br/>(dev mode)"]
    end

    subgraph ExternalServices["External Services"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        S3["S3 Storage<br/>443/TCP"]
        MLflow["MLflow Tracking<br/>HTTPS"]
        OCI["OCI Registry<br/>443/TCP"]
        ModelEP["Model Endpoints<br/>HTTPS"]
        OTEL["OpenTelemetry Collector<br/>OTLP/gRPC"]
    end

    subgraph PlatformCRDs["Platform CRDs"]
        HWProfile["HardwareProfile CR"]
        LocalQueue["Kueue LocalQueue CR"]
    end

    Prometheus["Prometheus"] -->|"scrape"| Metrics

    Client -->|"HTTPS/443"| KRBP
    KRBP -->|"X-User/X-Tenant"| API
    KRBP -->|"X-User/X-Tenant"| MCP
    MCP -->|"REST API calls"| KRBP

    API -->|"SQL"| PG
    API -->|"SQL"| SQLite
    API -->|"create/watch Jobs"| K8sAPI
    API -->|"read CRDs"| HWProfile
    API -->|"read CRDs"| LocalQueue
    API -->|"OTLP"| OTEL

    Init -->|"download test data"| S3

    Sidecar -->|"inference"| ModelEP
    Sidecar -->|"experiment tracking"| MLflow
    Sidecar -->|"eval card publish"| OCI
    Sidecar -->|"callback"| API
    Sidecar -->|"OTLP"| OTEL

