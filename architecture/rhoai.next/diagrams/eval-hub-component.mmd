graph TB
    subgraph External["External Clients"]
        User[User / Data Scientist]
        Agent[AI Agent]
    end

    subgraph RBACProxy["Authentication Layer"]
        KRP[kube-rbac-proxy<br/>443/TCP HTTPS<br/>TLS termination]
    end

    subgraph EvalHubService["EvalHub Service"]
        direction TB
        API[eval-hub<br/>Go REST API<br/>8080/TCP]
        MetricsSrv[Metrics Server<br/>8081/TCP Prometheus]
        API --- MetricsSrv
    end

    subgraph MCPService["MCP Service"]
        MCP[evalhub-mcp<br/>MCP Server<br/>3001/TCP]
    end

    subgraph EvalJobPod["Evaluation Job Pod (K8s Job)"]
        direction TB
        Init[eval-runtime-init<br/>Init Container<br/>S3 downloader]
        Adapter[Evaluation Adapter<br/>lm-eval / Garak / RAGAS / etc.]
        Sidecar[eval-runtime-sidecar<br/>Sidecar Proxy<br/>8080/TCP]
        Init -->|downloads to /test_data| Adapter
        Adapter -->|all upstream traffic| Sidecar
    end

    subgraph CRD["Custom Resources"]
        EvalHubCR[EvalHub CR<br/>trustyai.opendatahub.io/v1alpha1]
    end

    subgraph Operator["TrustyAI Service Operator"]
        TrustyOp[TrustyAI Operator<br/>Manages EvalHub lifecycle]
    end

    %% External flows
    User -->|HTTPS/443| KRP
    Agent -->|MCP over HTTP/3001| MCP
    KRP -->|X-Tenant, X-User headers<br/>HTTP/8080| API

    %% CRD management
    EvalHubCR -->|watched by| TrustyOp
    TrustyOp -->|creates/manages| API

    %% API to Job
    API -->|creates K8s Jobs| EvalJobPod

    %% MCP to API
    MCP -->|REST API calls<br/>Bearer Token| API

    %% Sidecar upstream connections
    Sidecar -->|job status callbacks<br/>SA Token| API
    Sidecar -->|experiment logging<br/>Bearer Token| MLflow[MLflow Server]
    Sidecar -->|eval card publish<br/>Docker auth| OCI[OCI Registry]
    Sidecar -->|model inference<br/>Ref Token / SA Token| ModelEP[Model Endpoint]

    %% Init container
    Init -->|download datasets<br/>AWS credentials| S3[S3 Storage]

    %% API upstream
    API -->|Job CRUD, logs<br/>SA Token| K8sAPI[Kubernetes API]
    API -->|experiment tracking<br/>Bearer Token| MLflow

    %% Storage
    API -->|persistent storage| PG[(PostgreSQL)]

    %% Metrics
    Prometheus[Prometheus] -->|scrape /metrics| MetricsSrv

    %% Styling
    style API fill:#4a90e2,stroke:#333,color:#fff
    style MCP fill:#4a90e2,stroke:#333,color:#fff
    style Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style Init fill:#4a90e2,stroke:#333,color:#fff
    style MetricsSrv fill:#4a90e2,stroke:#333,color:#fff
    style KRP fill:#ffe6cc,stroke:#d79b00
    style TrustyOp fill:#7ed321,stroke:#333,color:#fff
    style EvalHubCR fill:#f5a623,stroke:#333,color:#fff
    style Adapter fill:#d5e8d4,stroke:#82b366
    style MLflow fill:#999,stroke:#333,color:#fff
    style OCI fill:#999,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style ModelEP fill:#999,stroke:#333,color:#fff
    style PG fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
