graph TB
    subgraph EvalHubImage["odh-eval-hub-rhel9 Image (Multi-Binary)"]
        subgraph EvalHubService["eval-hub API Service"]
            API["eval-hub<br/>Go HTTP Server<br/>:8080/TCP (API)<br/>:8081/TCP (metrics)"]
            ConfigWatcher["Config Watcher<br/>Hot-reload providers/collections"]
            API --- ConfigWatcher
        end

        subgraph Sidecar["eval-runtime-sidecar"]
            SidecarProxy["Reverse Proxy<br/>:8080/TCP (pod-local)<br/>Credential Injection"]
        end

        subgraph InitContainer["eval-runtime-init"]
            Init["S3 Downloader<br/>Batch process<br/>Downloads test data"]
        end

        subgraph MCPServer["evalhub-mcp"]
            MCP["MCP Server<br/>:3001/TCP<br/>stdio / HTTP / SSE"]
        end
    end

    %% External Actors
    Client["Client<br/>(Dashboard / SDK / CLI)"]
    Agent["AI Agent / LLM"]
    Operator["TrustyAI Service Operator<br/>EvalHub CR"]

    %% Cluster Services
    RBAC["kube-rbac-proxy<br/>:8443/TCP<br/>TLS termination"]

    %% Evaluation Job Pod
    subgraph JobPod["Evaluation Job Pod"]
        InitC["eval-runtime-init<br/>(init container)"]
        Adapter["Evaluation Adapter<br/>(Python SDK)<br/>lm-eval-harness / RAGAS / Garak"]
        SidecarC["eval-runtime-sidecar<br/>(sidecar container)"]
        InitC -.->|"completes before"| Adapter
        Adapter -->|"localhost:8080"| SidecarC
    end

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>:443/TCP"]
    PostgreSQL["PostgreSQL<br/>:5432/TCP"]
    MLflow["MLflow Tracking<br/>:5000/TCP"]
    OCI["OCI Registry<br/>:443/TCP"]
    S3["AWS S3<br/>:443/TCP"]
    OTLP["OTLP Collector<br/>:4317/4318"]
    ModelEP["Model Endpoint<br/>Inference"]

    %% Client flows
    Client -->|"HTTPS :8443"| RBAC
    RBAC -->|"HTTP :8080<br/>X-Tenant, X-User"| API
    Agent -->|"HTTP/HTTPS :3001<br/>MCP Protocol"| MCP

    %% Operator manages
    Operator -->|"creates/manages<br/>Deployment, Service, ConfigMap"| EvalHubService

    %% API dependencies
    API -->|"SQL (pgx)"| PostgreSQL
    API -->|"HTTPS"| K8sAPI
    API -->|"HTTP/HTTPS"| MLflow
    API -->|"HTTPS"| OCI
    API -->|"gRPC/HTTP"| OTLP

    %% MCP → API
    MCP -->|"HTTP/HTTPS :8080<br/>Bearer token"| API

    %% Job creation
    API -->|"creates Jobs"| K8sAPI
    K8sAPI -.->|"schedules"| JobPod

    %% Sidecar proxying
    SidecarC -->|"SA token"| API
    SidecarC -->|"Bearer token"| MLflow
    SidecarC -->|"Docker auth"| OCI
    SidecarC -->|"Bearer/ref-token"| ModelEP

    %% Init container
    InitC -->|"AWS IAM"| S3

    %% Prometheus
    Prometheus["Prometheus"] -->|"scrape :8081"| API

    %% Styling
    style API fill:#4a90e2,stroke:#333,color:#fff
    style SidecarProxy fill:#4a90e2,stroke:#333,color:#fff
    style Init fill:#4a90e2,stroke:#333,color:#fff
    style MCP fill:#4a90e2,stroke:#333,color:#fff
    style RBAC fill:#e8a838,stroke:#333,color:#fff
    style Operator fill:#7ed321,stroke:#333,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style MLflow fill:#999,stroke:#333,color:#fff
    style OCI fill:#999,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OTLP fill:#999,stroke:#333,color:#fff
    style ModelEP fill:#f5a623,stroke:#333,color:#fff
    style Adapter fill:#9b59b6,stroke:#333,color:#fff
    style InitC fill:#4a90e2,stroke:#333,color:#fff
    style SidecarC fill:#4a90e2,stroke:#333,color:#fff
