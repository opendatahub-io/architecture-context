graph TB
    subgraph DSP["Data Science Pipelines Tekton"]
        direction TB

        subgraph CoreServices["Core Services"]
            APIServer["API Server<br/>Go<br/>8888/HTTP, 8887/gRPC"]
            Frontend["Frontend<br/>React/Node.js<br/>3000/TCP"]
            VizServer["Visualization Server<br/>Python<br/>8888/TCP"]
        end

        subgraph Controllers["Controllers & Agents"]
            PersistenceAgent["Persistence Agent<br/>Go"]
            ScheduledWF["ScheduledWorkflow<br/>Controller<br/>Go"]
            ViewerCtrl["Viewer Controller<br/>Go"]
            MetadataWriter["Metadata Writer<br/>Python"]
        end

        subgraph CacheSystem["Cache System"]
            CacheServer["Cache Server<br/>Go Webhook<br/>8443/HTTPS"]
            CacheDeployer["Cache Deployer<br/>Shell Job"]
        end

        subgraph TektonCatalog["Tekton Catalog Extensions"]
            PipelineLoops["Pipeline Loops<br/>Controller + Webhook"]
            AnySequencer["Any Sequencer<br/>Custom Task"]
            KubectlWrapper["Kubectl Wrapper<br/>Custom Task"]
        end
    end

    %% Internal flows
    Frontend -->|REST API| APIServer
    APIServer -->|delegates| VizServer
    PersistenceAgent -->|syncs status| APIServer
    CacheDeployer -->|provisions certs| CacheServer

    %% CRD interactions
    ScheduledWFCR["ScheduledWorkflow CR"]
    ViewerCR["Viewer CR"]
    PipelineRunCR["Tekton PipelineRun"]

    ScheduledWFCR -->|watched by| ScheduledWF
    ViewerCR -->|watched by| ViewerCtrl
    PipelineRunCR -->|watched by| PersistenceAgent
    APIServer -->|creates| PipelineRunCR
    ScheduledWF -->|creates| PipelineRunCR

    %% External dependencies
    MySQL["MySQL<br/>3306/TCP"]
    MinIO["MinIO<br/>9000/TCP"]
    MLMD["ML Metadata<br/>gRPC 8080/TCP"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    Tekton["Tekton Pipelines<br/>v0.41.0"]
    Istio["Istio Service Mesh"]

    APIServer -->|metadata| MySQL
    APIServer -->|artifacts| MinIO
    APIServer -->|pipeline exec| K8sAPI
    CacheServer -->|cache lookup| MySQL
    PersistenceAgent -->|watch runs| K8sAPI
    MetadataWriter -->|lineage| MLMD
    K8sAPI -->|admission webhook| CacheServer
    Tekton -->|executes| PipelineRunCR

    %% User
    User["User / SDK"] -->|upload & manage| Frontend
    User -->|gRPC / REST| APIServer

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Frontend fill:#4a90e2,stroke:#333,color:#fff
    style VizServer fill:#4a90e2,stroke:#333,color:#fff
    style CacheServer fill:#e8744f,stroke:#333,color:#fff
    style PersistenceAgent fill:#9b59b6,stroke:#333,color:#fff
    style ScheduledWF fill:#9b59b6,stroke:#333,color:#fff
    style ViewerCtrl fill:#9b59b6,stroke:#333,color:#fff
    style MetadataWriter fill:#9b59b6,stroke:#333,color:#fff
    style CacheDeployer fill:#e8744f,stroke:#333,color:#fff
    style PipelineLoops fill:#2ecc71,stroke:#333,color:#fff
    style AnySequencer fill:#2ecc71,stroke:#333,color:#fff
    style KubectlWrapper fill:#2ecc71,stroke:#333,color:#fff
    style ScheduledWFCR fill:#f5a623,stroke:#333
    style ViewerCR fill:#f5a623,stroke:#333
    style PipelineRunCR fill:#f5a623,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style MinIO fill:#e8e8e8,stroke:#333
    style MLMD fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Tekton fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
