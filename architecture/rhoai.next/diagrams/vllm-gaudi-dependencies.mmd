graph LR
    VLLMGaudi["vllm-gaudi<br/>HPU Plugin"]

    %% Core External Dependencies
    VLLMGaudi -->|"plugin extends<br/>(entry points)"| VLLM["vLLM v0.16.0"]
    VLLMGaudi -->|"HPU backend"| PyTorch["PyTorch 2.9.0"]
    VLLMGaudi -->|"device driver<br/>graph compiler"| SynapseAI["Habana SynapseAI<br/>1.23.0 (rev 695)"]
    VLLMGaudi -->|"HPU bridge<br/>FusedSDPA, HCCL"| HabanaFW["habana_frameworks<br/>.torch"]
    VLLMGaudi -->|"media loading"| MediaLoader["habana-media-loader<br/>1.23.0"]

    %% ML/Data Dependencies
    VLLMGaudi -->|"model loading<br/>tokenization"| Transformers["transformers<br/>>=4.56.0, <5"]
    VLLMGaudi -->|"numerical ops"| NumPy["numpy >=1.26.0"]
    VLLMGaudi -->|"data processing"| Pandas["pandas >=2.2.3"]
    VLLMGaudi -->|"JIT compilation"| Numba["numba >=0.58.0"]
    VLLMGaudi -.->|"tensor rearrange<br/>(optional)"| Einops["einops"]

    %% Distributed Dependencies
    VLLMGaudi -->|"multi-HPU<br/>orchestration"| Ray["Ray >=2.48.0"]
    VLLMGaudi -.->|"KV cache transfer<br/>(optional)"| NIXL["NIXL"]

    %% Internal Platform Dependencies (RHOAI)
    KServe["KServe<br/>ServingRuntime"] -->|"deploys as<br/>container image"| VLLMGaudi
    RHODSOp["rhods-operator"] -->|"creates<br/>ServingRuntime CRs"| KServe
    KubeRBAC["kube-rbac-proxy"] -->|"auth sidecar<br/>8443→8000"| VLLMGaudi
    GatewayAPI["Gateway API<br/>(HTTPRoute)"] -->|"ingress<br/>routing"| KubeRBAC

    %% External Services
    VLLMGaudi -->|"model weights<br/>HTTPS/443"| S3["S3 / PVC<br/>Model Storage"]
    VLLMGaudi -->|"models & tokenizers<br/>HTTPS/443"| HFHub["HuggingFace Hub"]

    %% Styling
    style VLLMGaudi fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core dependencies (required)
    style VLLM fill:#999,stroke:#333,color:#fff
    style PyTorch fill:#999,stroke:#333,color:#fff
    style SynapseAI fill:#999,stroke:#333,color:#fff
    style HabanaFW fill:#999,stroke:#333,color:#fff
    style MediaLoader fill:#999,stroke:#333,color:#fff

    %% ML dependencies
    style Transformers fill:#b0b0b0,stroke:#333,color:#fff
    style NumPy fill:#b0b0b0,stroke:#333,color:#fff
    style Pandas fill:#b0b0b0,stroke:#333,color:#fff
    style Numba fill:#b0b0b0,stroke:#333,color:#fff
    style Einops fill:#d0d0d0,stroke:#333

    %% Distributed
    style Ray fill:#999,stroke:#333,color:#fff
    style NIXL fill:#d0d0d0,stroke:#333

    %% Platform (Internal RHOAI)
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style RHODSOp fill:#7ed321,stroke:#333,color:#fff
    style KubeRBAC fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style HFHub fill:#f5a623,stroke:#333,color:#fff
