graph LR
    VllmGaudi["vllm-gaudi<br/>HPU Plugin"]

    %% Core Runtime Dependencies (Required)
    VllmGaudi -->|"inference engine<br/>(base server)"| VLLM["vLLM 0.16.0"]
    VllmGaudi -->|"HPU drivers<br/>graph compiler"| SynapseAI["Intel Gaudi<br/>SynapseAI 1.23.0"]
    VllmGaudi -->|"HPU backend<br/>tensor ops"| PyTorch["PyTorch 2.9.0<br/>(Habana fork)"]
    VllmGaudi -->|"HPU extensions<br/>htorch, hpu ops"| HabanaFW["habana_frameworks<br/>1.23.0"]

    %% ML Framework Dependencies
    VllmGaudi -->|"model loading<br/>tokenization"| Transformers["HuggingFace<br/>transformers >=4.56"]
    VllmGaudi -->|"numerical arrays<br/>padding, bucketing"| NumPy["numpy >=1.26"]
    VllmGaudi -->|"JIT compilation<br/>numerical kernels"| Numba["numba >=0.58"]

    %% Distributed Dependencies
    VllmGaudi -->|"distributed execution<br/>multi-HPU"| Ray["Ray >=2.48"]

    %% Utility Dependencies
    VllmGaudi -->|"benchmarking<br/>profiling"| Pandas["pandas >=2.2.3"]
    VllmGaudi -->|"memory monitoring"| Psutil["psutil"]

    %% Internal Platform Dependencies (RHOAI)
    KServe["KServe /<br/>ServingRuntime"] -->|"manages container<br/>routes traffic"| VllmGaudi
    ModelStorage["Model Storage<br/>(S3 / PVC)"] -->|"model weights<br/>volume mount"| VllmGaudi

    %% External Services
    VllmGaudi -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub<br/>huggingface.co"]

    %% Hardware
    VllmGaudi -->|"PCIe / HPU API"| GaudiHW["Intel Gaudi HW<br/>Gaudi2 / Gaudi3"]

    %% Styling
    style VllmGaudi fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core runtime (dark blue)
    style VLLM fill:#2c5f8a,stroke:#333,color:#fff
    style SynapseAI fill:#2c5f8a,stroke:#333,color:#fff
    style PyTorch fill:#2c5f8a,stroke:#333,color:#fff
    style HabanaFW fill:#2c5f8a,stroke:#333,color:#fff

    %% ML frameworks (medium blue)
    style Transformers fill:#5b9bd5,stroke:#333,color:#fff
    style NumPy fill:#5b9bd5,stroke:#333,color:#fff
    style Numba fill:#5b9bd5,stroke:#333,color:#fff

    %% Distributed (teal)
    style Ray fill:#4db6ac,stroke:#333,color:#fff

    %% Utilities (gray)
    style Pandas fill:#999,stroke:#333,color:#fff
    style Psutil fill:#999,stroke:#333,color:#fff

    %% Internal platform (green)
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelStorage fill:#7ed321,stroke:#333,color:#fff

    %% External services (orange)
    style HFHub fill:#f5a623,stroke:#333,color:#fff

    %% Hardware (amber)
    style GaudiHW fill:#ff8f00,stroke:#333,color:#fff
