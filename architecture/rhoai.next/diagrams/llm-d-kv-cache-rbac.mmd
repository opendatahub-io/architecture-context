graph TD
    subgraph "Service Accounts"
        SA["${PROJECT_NAME}<br/>(llm-d-kv-cache)"]
    end

    subgraph "Role Bindings"
        RB_NS["RoleBinding<br/>(namespace-scoped)<br/>Namespace: ${NAMESPACE}"]
        RB_Cluster["ClusterRoleBinding<br/>(cluster-wide)"]
        RB_Exec["exec-rbac-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "Roles"
        Role_NS["kv-cache-manager<br/>(namespace-scoped Role)"]
        Role_Cluster["kv-cache-manager<br/>(ClusterRole)"]
        Role_Exec["exec-rbac-role<br/>(Role)"]
    end

    subgraph "API Resources"
        Pods["core (v1)<br/>pods"]
        PodsExec["core (v1)<br/>pods/exec"]
    end

    subgraph "Permitted Verbs"
        direction LR
        ReadVerbs["get, list, watch"]
        ExecVerb["create"]
    end

    %% Bindings
    SA -->|bound via| RB_NS
    SA -->|bound via| RB_Cluster
    SA -->|bound via| RB_Exec

    RB_NS -->|grants| Role_NS
    RB_Cluster -->|grants| Role_Cluster
    RB_Exec -->|grants| Role_Exec

    %% Permissions
    Role_NS -->|"get, list, watch"| Pods
    Role_Cluster -->|"get, list, watch"| Pods
    Role_Exec -->|"create"| PodsExec

    %% Notes
    Note_NS["Purpose: Discover model server<br/>pods within namespace for<br/>ZMQ subscriber management"]
    Note_Cluster["Purpose: Discover model server<br/>pods cluster-wide when<br/>namespace not specified ⚠️"]
    Note_Exec["Purpose: Execute commands<br/>in model server pods<br/>(debug/management)"]

    Role_NS ~~~ Note_NS
    Role_Cluster ~~~ Note_Cluster
    Role_Exec ~~~ Note_Exec

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RB_NS fill:#b8d4e3,stroke:#333
    style RB_Cluster fill:#b8d4e3,stroke:#333
    style RB_Exec fill:#b8d4e3,stroke:#333
    style Role_NS fill:#f5a623,stroke:#333,color:#fff
    style Role_Cluster fill:#f5a623,stroke:#333,color:#fff
    style Role_Exec fill:#e74c3c,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style PodsExec fill:#e74c3c,stroke:#333,color:#fff
    style Note_NS fill:#fff,stroke:#ccc,stroke-dasharray: 5 5
    style Note_Cluster fill:#fff2cc,stroke:#d6b656,stroke-dasharray: 5 5
    style Note_Exec fill:#fff,stroke:#ccc,stroke-dasharray: 5 5
