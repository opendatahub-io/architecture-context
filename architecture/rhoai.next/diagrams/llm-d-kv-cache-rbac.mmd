graph TD
    subgraph "Service Account"
        SA["operator-controller-manager<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole Binding"
        CRB["exec-rbac-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole"
        CR["exec-rbac-role"]
    end

    subgraph "API Resources"
        PodsExec["Core API Group (\"\")<br/>pods/exec"]
    end

    subgraph "Endpoints (No Auth)"
        direction LR
        Health["/healthz<br/>8082/TCP HTTP<br/>No auth"]
        Metrics["/metrics<br/>8080/TCP HTTP<br/>No auth"]
        ScoreComp["/score_completions<br/>8080/TCP HTTP<br/>No auth"]
        ScoreChat["/score_chat_completions<br/>8080/TCP HTTP<br/>No auth"]
        IndexerRPC["IndexerService.GetPodScores<br/>50051/TCP gRPC<br/>No auth (insecure creds)"]
        TokenRPC["TokenizationService<br/>UDS gRPC<br/>No auth (UDS isolation)"]
    end

    subgraph "Secrets"
        Secret1["vllm-p2p-secrets<br/>Type: Opaque<br/>HuggingFace API token<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"create"| PodsExec

    SA -.->|"uses"| Secret1

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e67e22,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style PodsExec fill:#7ed321,stroke:#333,color:#fff
    style Health fill:#ecf0f1,stroke:#999
    style Metrics fill:#ecf0f1,stroke:#999
    style ScoreComp fill:#ecf0f1,stroke:#999
    style ScoreChat fill:#ecf0f1,stroke:#999
    style IndexerRPC fill:#ecf0f1,stroke:#999
    style TokenRPC fill:#ecf0f1,stroke:#999
    style Secret1 fill:#e74c3c,stroke:#333,color:#fff
