graph TB
    subgraph BenchmarkFramework["llm-d-benchmark Framework"]
        direction TB
        CLI["llmdbenchmark CLI<br/>Python Package v0.8.0"]
        StepExecutor["StepExecutor<br/>Phased step orchestration"]
        ConfigEngine["Configuration Engine<br/>Jinja2 + YAML merge chain"]
        DoE["DoE Engine<br/>Design of Experiments<br/>parameter sweeps"]
        BenchReport["benchmark-report<br/>Universal Report Schema v0.2"]

        CLI --> StepExecutor
        CLI --> ConfigEngine
        CLI --> DoE
        StepExecutor --> BenchReport
    end

    subgraph StackDiscovery["Stack Discovery"]
        Discovery["llm_d_stack_discovery<br/>Python CLI Tool"]
    end

    subgraph ContainerImages["Container Images"]
        BenchImage["Benchmark Image<br/>ghcr.io/llm-d/llm-d-benchmark<br/>Bundles 5 harnesses + CLIs"]
        DiscoveryImage["Stack Discovery Image<br/>Lightweight Python 3.11"]
    end

    subgraph Harnesses["Bundled Benchmark Harnesses"]
        InferencePerf["inference-perf v0.7.0"]
        GuideLLM["guidellm v0.7.3"]
        VLLMBench["vllm-benchmark v0.30.0"]
        AiPerf["aiperf v0.12.0"]
        LMEval["lm-eval 0.4.12"]
    end

    %% CLI subcommands
    User[User / CI] -->|"standup, run, teardown<br/>experiment, plan"| CLI
    User -->|"discover"| Discovery

    %% Container image relationships
    CLI -->|"deploys as"| BenchImage
    Discovery -->|"runs in"| DiscoveryImage
    BenchImage -->|"includes"| InferencePerf
    BenchImage -->|"includes"| GuideLLM
    BenchImage -->|"includes"| VLLMBench
    BenchImage -->|"includes"| AiPerf
    BenchImage -->|"includes"| LMEval

    %% External dependencies
    CLI -->|"kubectl/helm"| K8sAPI["Kubernetes API"]
    CLI -->|"model validation"| HFHub["HuggingFace Hub"]
    CLI -->|"result upload"| CloudStorage["GCS / S3"]
    Discovery -->|"traces topology"| K8sAPI

    %% Kubernetes resources
    CLI -->|"creates"| StatefulSet["StatefulSet<br/>(benchmark pod)"]
    CLI -->|"creates"| Service["ClusterIP Service<br/>8080/TCP"]
    CLI -->|"creates"| Route["OpenShift Route<br/>443/TCP TLS edge"]

    %% Styling
    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style Discovery fill:#4a90e2,stroke:#333,color:#fff
    style StepExecutor fill:#5ba3f5,stroke:#333,color:#fff
    style ConfigEngine fill:#5ba3f5,stroke:#333,color:#fff
    style DoE fill:#5ba3f5,stroke:#333,color:#fff
    style BenchReport fill:#5ba3f5,stroke:#333,color:#fff
    style BenchImage fill:#7ed321,stroke:#333,color:#fff
    style DiscoveryImage fill:#7ed321,stroke:#333,color:#fff
    style InferencePerf fill:#b8e986,stroke:#333
    style GuideLLM fill:#b8e986,stroke:#333
    style VLLMBench fill:#b8e986,stroke:#333
    style AiPerf fill:#b8e986,stroke:#333
    style LMEval fill:#b8e986,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style CloudStorage fill:#e8e8e8,stroke:#333
    style StatefulSet fill:#f5a623,stroke:#333
    style Service fill:#f5a623,stroke:#333
    style Route fill:#f5a623,stroke:#333
