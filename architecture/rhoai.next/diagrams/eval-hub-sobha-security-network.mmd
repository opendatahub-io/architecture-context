graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(Dashboard / SDK)"]
    end

    subgraph Ingress["INGRESS (mTLS Termination)"]
        KubeRBACProxy["kube-rbac-proxy<br/>443/TCP<br/>TLS 1.2+<br/>mTLS + TokenReview"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Authenticated)"]
        direction TB

        subgraph NS_EvalHub["Namespace: eval-hub"]
            EvalHubAPI["eval-hub API<br/>8080/TCP<br/>HTTP/HTTPS (configurable TLS 1.2-1.3)<br/>SA: eval-hub-sa"]
        end

        subgraph NS_Tenant["Namespace: {tenant} (per-namespace)"]
            direction TB
            InitContainer["eval_runtime_init<br/>SA: {evalhub}-sa<br/>Init Container"]
            Sidecar["eval_runtime_sidecar<br/>8080/TCP<br/>HTTP (localhost only)<br/>SA: {evalhub}-sa"]
            EvalAdapter["lighteval Adapter<br/>Batch Process<br/>SA: {evalhub}-sa"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>SA Token Auth"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
        OTELCollector["OTEL Collector<br/>OTLP/gRPC"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MLflow["MLflow Server<br/>HTTPS<br/>TLS 1.2-1.3 (custom CA)<br/>Bearer Token"]
        S3["S3-Compatible Storage<br/>HTTPS<br/>TLS<br/>AWS IAM Credentials"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8080<br/>X-User, X-Tenant headers<br/>Token validated"| EvalHubAPI
    EvalHubAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>Job/ConfigMap CRUD + TokenReview/SAR"| K8sAPI
    EvalHubAPI -->|"HTTPS<br/>TLS 1.2-1.3<br/>Bearer Token"| MLflow
    EvalHubAPI -.->|"OTLP/gRPC<br/>Configurable"| OTELCollector
    Prometheus -->|"HTTP/8080<br/>No Auth"| EvalHubAPI
    InitContainer -->|"HTTPS<br/>TLS<br/>AWS Credentials (secret files)"| S3
    EvalAdapter -->|"HTTP/8080<br/>localhost only<br/>No encryption<br/>No auth"| Sidecar
    Sidecar -->|"HTTPS<br/>TLS 1.2+ (custom CA)<br/>Bearer Token"| EvalHubAPI
    Sidecar -->|"HTTPS<br/>TLS 1.2-1.3 (custom CA)<br/>Bearer Token (cached)"| MLflow

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef clusterinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class KubeRBACProxy ingress
    class EvalHubAPI,InitContainer,Sidecar,EvalAdapter clusterinternal
    class K8sAPI,Prometheus,OTELCollector platform
    class MLflow,S3 externalservice
