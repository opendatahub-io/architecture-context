graph TD
    subgraph "Authentication"
        User["Authenticated User<br/>(kubeconfig identity)"]
    end

    subgraph "No Custom RBAC"
        Note["odh-cli defines no custom roles.<br/>It inherits the user's existing<br/>Kubernetes RBAC permissions."]
    end

    User -->|"uses existing RBAC"| Note

    subgraph "Required Permissions by Command"
        direction TB

        subgraph "Read-Only Commands"
            Lint["lint<br/>────────────────────<br/>Read: DSC, DSCI, CRDs,<br/>CSVs, Subscriptions,<br/>Namespaces, all workload<br/>CRs (cluster-wide)"]

            Status["status<br/>────────────────────<br/>Read: Nodes, Deployments,<br/>Pods, Events,<br/>ResourceQuotas,<br/>DSC, DSCI, CSVs"]

            Backup["backup<br/>────────────────────<br/>Read: all workload CRs,<br/>ConfigMaps, PVCs, Secrets"]

            Get["get<br/>────────────────────<br/>Read: requested<br/>resource types"]

            Events["events<br/>────────────────────<br/>Read: Events,<br/>Pods, Deployments"]

            Logs["logs<br/>────────────────────<br/>Read: Pods,<br/>Pod/log subresource"]

            Deps["deps<br/>────────────────────<br/>Read: Subscriptions,<br/>CSVs, PackageManifests"]

            ComponentsList["components list/describe<br/>────────────────────<br/>Read: DataScienceCluster"]
        end

        subgraph "Read-Write Commands"
            ComponentsToggle["components enable/disable<br/>────────────────────<br/>Patch: DataScienceCluster"]

            DepsInstall["deps install<br/>────────────────────<br/>Create/Update:<br/>Subscriptions,<br/>OperatorGroups"]

            Migrate["migrate<br/>────────────────────<br/>Read/Write: workload CRs,<br/>CRDs, Roles, RoleBindings,<br/>Pods, Deployments"]
        end
    end

    User -->|"read-only"| Lint
    User -->|"read-only"| Status
    User -->|"read-only"| Backup
    User -->|"read-only"| Get
    User -->|"read-only"| Events
    User -->|"read-only"| Logs
    User -->|"read-only"| Deps
    User -->|"read-only"| ComponentsList
    User -->|"read-write"| ComponentsToggle
    User -->|"read-write"| DepsInstall
    User -->|"read-write"| Migrate

    subgraph "API Resources Accessed"
        RHOAI_CRDs["RHOAI CRDs<br/>────────────────────<br/>datascienceclusters.datasciencecluster.opendatahub.io<br/>dscinitializations.dscinitialization.opendatahub.io"]
        Workload_CRDs["Workload CRDs<br/>────────────────────<br/>notebooks.kubeflow.org<br/>datasciencepipelinesapplications.datasciencepipelinesapplications.opendatahub.io<br/>inferenceservices.serving.kserve.io<br/>rayclusters.ray.io<br/>trustyaiservices.trustyai.opendatahub.io"]
        K8s_Core["Kubernetes Core<br/>────────────────────<br/>pods, pods/log, services,<br/>events, nodes, namespaces,<br/>configmaps, secrets, pvcs"]
        K8s_RBAC["Kubernetes RBAC<br/>────────────────────<br/>roles, rolebindings,<br/>clusterroles"]
        OLM_Resources["OLM Resources<br/>────────────────────<br/>subscriptions, csvs,<br/>packagemanifests,<br/>operatorgroups"]
    end

    Lint -->|reads| RHOAI_CRDs
    Lint -->|reads| Workload_CRDs
    Status -->|reads| K8s_Core
    Migrate -->|reads/writes| Workload_CRDs
    Migrate -->|reads/writes| K8s_RBAC
    DepsInstall -->|creates| OLM_Resources

