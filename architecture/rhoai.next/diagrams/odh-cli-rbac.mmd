graph TD
    subgraph UserAuth["User Authentication (kubeconfig)"]
        User["Platform Engineer<br/>kubeconfig credentials"]
        BearerToken["Bearer Token"]
        ClientCert["Client Certificate"]
        User --> BearerToken
        User --> ClientCert
    end

    subgraph CLITool["rhai-cli (No Deployed RBAC)"]
        CLI["rhai-cli Binary<br/>Inherits user's cluster permissions"]

        subgraph PreflightChecks["RBAC Preflight (Migration)"]
            SAR["SubjectAccessReview<br/>Checks before modifying resources"]
        end

        subgraph TempRBAC["Temporary RBAC (Migration Only)"]
            TempSA["Temporary ServiceAccount<br/>Created for ISVC owner refs"]
            TempRole["Temporary Role<br/>Scoped to migration namespace"]
            TempRB["Temporary RoleBinding<br/>Binds SA to Role"]
            TempSA --> TempRB
            TempRole --> TempRB
        end
    end

    subgraph K8sRBAC["Kubernetes RBAC (Enforced by kube-apiserver)"]
        direction TB

        subgraph ReadOps["Read Operations (lint, status, get, deps)"]
            ReadCRDs["CRD Read Access<br/>DSC, DSCI, InferenceService,<br/>Notebook, ClusterQueue, DSPA,<br/>TrustyAIService, RayCluster,<br/>PyTorchJob, SMMR, KnativeServing,<br/>Kuadrant, cert-manager,<br/>ClusterVersion, AcceleratorProfile"]
            ReadPods["Pod/Event Access<br/>List pods, stream logs,<br/>watch events"]
        end

        subgraph WriteOps["Write Operations (migrate only)"]
            WriteDSC["DSC/DSCI Write<br/>Enable/disable components,<br/>update Kueue config"]
            WriteISVC["InferenceService Write<br/>ModelMesh→Raw conversion"]
            WriteNotebook["Notebook Write<br/>Auth model migration"]
            WriteKueue["ClusterQueue Write<br/>RHBOK migration"]
            WriteDSPA["DSPA Write<br/>v1alpha1→v1 migration"]
            WriteOLM["OLM Write<br/>Create RHBOK Subscription"]
            DeleteOAuth["OAuthClient Delete<br/>Legacy cleanup"]
        end
    end

    subgraph OLMWhitelist["OLM Catalog Source Whitelist"]
        RHOps["redhat-operators"]
        CertOps["certified-operators"]
        CommOps["community-operators"]
    end

    subgraph TrustyAIAuth["TrustyAI REST Auth"]
        TrustyToken["Bearer Token<br/>(re-uses cluster token)<br/>InsecureSkipVerify: true"]
    end

    subgraph MCPAuth["MCP Server Auth"]
        Localhost["Network Isolation Only<br/>127.0.0.1:8080<br/>No authentication"]
    end

    %% Flows
    BearerToken -->|authenticates| CLI
    ClientCert -->|authenticates| CLI
    CLI -->|"user's permissions"| ReadOps
    CLI -->|"user's permissions<br/>(after SAR check)"| WriteOps
    CLI -->|"validates source"| OLMWhitelist
    CLI -->|"re-uses token"| TrustyAIAuth
    CLI -->|"localhost binding"| MCPAuth
    SAR -->|"checks before"| WriteOps

    %% Styling
    style User fill:#4a90e2,stroke:#333,color:#fff
    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style SAR fill:#f5a623,stroke:#333
    style TempSA fill:#f5a623,stroke:#333
    style TempRole fill:#f5a623,stroke:#333
    style TempRB fill:#f5a623,stroke:#333
    style ReadCRDs fill:#7ed321,stroke:#333
    style ReadPods fill:#7ed321,stroke:#333
    style WriteDSC fill:#e8744f,stroke:#333,color:#fff
    style WriteISVC fill:#e8744f,stroke:#333,color:#fff
    style WriteNotebook fill:#e8744f,stroke:#333,color:#fff
    style WriteKueue fill:#e8744f,stroke:#333,color:#fff
    style WriteDSPA fill:#e8744f,stroke:#333,color:#fff
    style WriteOLM fill:#e8744f,stroke:#333,color:#fff
    style DeleteOAuth fill:#e8744f,stroke:#333,color:#fff
    style Localhost fill:#ddd,stroke:#333
    style TrustyToken fill:#f8cecc,stroke:#b85450
