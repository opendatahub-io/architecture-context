graph TD
    subgraph "Authentication"
        KubeConfig["kubeconfig<br/>Credential Chain"]
        BearerToken["Bearer Token"]
        ClientCert["Client Certificate"]
        OIDC["OIDC Token"]
        KubeConfig --- BearerToken
        KubeConfig --- ClientCert
        KubeConfig --- OIDC
    end

    subgraph "Pre-Flight Validation"
        SSAR["SelfSubjectAccessReview<br/>pkg/util/kube/rbac/check.go"]
    end

    subgraph "CLI Commands Requiring Cluster Access"
        Lint["lint<br/>Reads: CRDs, Deployments,<br/>CSVs, Services"]
        Diagnose["diagnose<br/>Reads: Pods, Events,<br/>Deployments, CSVs<br/>(cluster-wide)"]
        Migrate["migrate<br/>Reads/Writes: Resources,<br/>TrustYAI metrics<br/>(cluster-wide)"]
        Backup["backup<br/>Reads: Workloads,<br/>Dependencies"]
        Status["status<br/>Reads: Platform health"]
        DepsInstall["deps install<br/>Creates: Subscriptions,<br/>OperatorGroups<br/>(cluster-wide)"]
        Get["get / components<br/>Reads: Various resources"]
        LogsEvents["logs / events<br/>Reads: Pod logs, Events"]
    end

    subgraph "Kubernetes API Server"
        RBAC["RBAC Enforcement<br/>kube-apiserver"]
    end

    subgraph "Required API Resources"
        CoreAPI["core<br/>Pods, Services, Secrets,<br/>ConfigMaps, Events,<br/>Namespaces, ServiceAccounts"]
        AppsAPI["apps<br/>Deployments,<br/>ReplicaSets, StatefulSets"]
        CRDAPI["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        OLMAPI["operators.coreos.com<br/>ClusterServiceVersions,<br/>Subscriptions,<br/>OperatorGroups"]
        ODHAPI["datasciencecluster.opendatahub.io<br/>DataScienceClusters,<br/>DSCInitialization"]
    end

    KubeConfig -->|"authenticates"| SSAR
    SSAR -->|"validates access<br/>before privileged ops"| RBAC

    Lint -->|"get, list, watch"| RBAC
    Diagnose -->|"get, list, watch"| RBAC
    Migrate -->|"get, list, create,<br/>update, patch, delete"| RBAC
    Backup -->|"get, list"| RBAC
    Status -->|"get, list"| RBAC
    DepsInstall -->|"get, list, create,<br/>update"| RBAC
    Get -->|"get, list"| RBAC
    LogsEvents -->|"get, list, watch"| RBAC

    RBAC -->|"enforces"| CoreAPI
    RBAC -->|"enforces"| AppsAPI
    RBAC -->|"enforces"| CRDAPI
    RBAC -->|"enforces"| OLMAPI
    RBAC -->|"enforces"| ODHAPI

    style KubeConfig fill:#4a90e2,color:#fff
    style SSAR fill:#e67e22,color:#fff
    style RBAC fill:#f5a623,color:#fff
    style Lint fill:#d5e8d4,stroke:#82b366
    style Diagnose fill:#d5e8d4,stroke:#82b366
    style Migrate fill:#ffcdd2,stroke:#c62828
    style Backup fill:#d5e8d4,stroke:#82b366
    style Status fill:#d5e8d4,stroke:#82b366
    style DepsInstall fill:#ffcdd2,stroke:#c62828
    style Get fill:#d5e8d4,stroke:#82b366
    style LogsEvents fill:#d5e8d4,stroke:#82b366
    style CoreAPI fill:#e8e8e8,stroke:#333
    style AppsAPI fill:#e8e8e8,stroke:#333
    style CRDAPI fill:#e8e8e8,stroke:#333
    style OLMAPI fill:#e8e8e8,stroke:#333
    style ODHAPI fill:#e8e8e8,stroke:#333
