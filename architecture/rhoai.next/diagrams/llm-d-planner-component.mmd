graph TB
    subgraph External["External Users & Clients"]
        User["User Browser"]
    end

    subgraph OpenShiftRoutes["OpenShift Routes (TLS Edge Termination)"]
        RouteUI["Route: planner<br/>443/TCP HTTPS"]
        RouteBackend["Route: planner-backend<br/>443/TCP HTTPS"]
    end

    subgraph PlannerNamespace["llm-d-planner Namespace"]
        direction TB

        subgraph UILayer["Frontend Layer"]
            StreamlitUI["Streamlit UI<br/>Port: 8501/TCP<br/>Python 3.14"]
        end

        subgraph APILayer["API Layer"]
            BackendAPI["Backend API (FastAPI)<br/>Port: 8000/TCP<br/>Python 3.14"]
        end

        subgraph DomainServices["Domain Services (In-Process)"]
            IntentExtractor["Intent Extractor<br/>LLM-powered NLU"]
            RecommendationEngine["Recommendation Engine<br/>Multi-criteria scoring"]
            CapacityPlanner["Capacity Planner<br/>GPU memory calculator"]
            GPURecommender["GPU Recommender<br/>Roofline estimator"]
            ConfigGenerator["Configuration Generator<br/>Jinja2 templates"]
            KnowledgeBase["Knowledge Base<br/>Benchmarks + SLO templates"]
            ClusterManager["Cluster Manager<br/>K8s integration"]
        end

        subgraph DataLayer["Data Layer"]
            PostgreSQL["PostgreSQL<br/>Port: 5432/TCP"]
            DBInitJob["DB Init Job<br/>Schema + data loading"]
        end

        subgraph DevLayer["Development Tools"]
            Simulator["vLLM Simulator<br/>Port: 8080/TCP<br/>OpenAI-compatible mock"]
        end

        subgraph LLMProviders["LLM Providers (In-Cluster)"]
            Ollama["Ollama<br/>Port: 11434/TCP"]
        end
    end

    subgraph ExternalAPIs["External APIs"]
        HuggingFace["HuggingFace Hub API<br/>443/TCP HTTPS"]
        OpenAI["OpenAI API<br/>443/TCP HTTPS"]
        VertexAI["Vertex AI (Anthropic)<br/>443/TCP HTTPS"]
        ModelCatalog["RHOAI Model Catalog<br/>8443/TCP HTTPS"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    end

    subgraph TargetPlatform["Deployment Targets"]
        KServe["KServe InferenceService"]
        LLMDScheduler["llm-d Scheduler Stack"]
    end

    %% User flows
    User -->|HTTPS/443| RouteUI
    User -->|HTTPS/443| RouteBackend
    RouteUI -->|HTTP/8501| StreamlitUI
    RouteBackend -->|HTTP/8000| BackendAPI

    %% UI to Backend
    StreamlitUI -->|HTTP/8000| BackendAPI

    %% Backend orchestrates domain services
    BackendAPI --> IntentExtractor
    BackendAPI --> RecommendationEngine
    BackendAPI --> CapacityPlanner
    BackendAPI --> GPURecommender
    BackendAPI --> ConfigGenerator
    BackendAPI --> KnowledgeBase
    BackendAPI --> ClusterManager

    %% Domain service dependencies
    IntentExtractor -->|HTTP/11434| Ollama
    IntentExtractor -->|HTTPS/443| OpenAI
    IntentExtractor -->|HTTPS/443| VertexAI
    KnowledgeBase -->|TCP/5432| PostgreSQL
    KnowledgeBase -->|HTTPS/8443| ModelCatalog
    CapacityPlanner -->|HTTPS/443| HuggingFace
    GPURecommender -->|llm-optimizer| RecommendationEngine
    ClusterManager -->|HTTPS/6443| K8sAPI
    DBInitJob -->|TCP/5432| PostgreSQL

    %% Configuration outputs
    ConfigGenerator -->|generates| KServe
    ConfigGenerator -->|generates| LLMDScheduler

    %% Styling
    classDef frontend fill:#6c5ce7,stroke:#333,color:#fff
    classDef api fill:#4a90e2,stroke:#333,color:#fff
    classDef domain fill:#00b894,stroke:#333,color:#fff
    classDef data fill:#fdcb6e,stroke:#333,color:#000
    classDef external fill:#dfe6e9,stroke:#636e72
    classDef route fill:#e17055,stroke:#333,color:#fff
    classDef target fill:#a29bfe,stroke:#333,color:#fff
    classDef dev fill:#fab1a0,stroke:#333,color:#000

    class StreamlitUI frontend
    class BackendAPI api
    class IntentExtractor,RecommendationEngine,CapacityPlanner,GPURecommender,ConfigGenerator,KnowledgeBase,ClusterManager domain
    class PostgreSQL,DBInitJob data
    class HuggingFace,OpenAI,VertexAI,ModelCatalog,K8sAPI,Ollama external
    class RouteUI,RouteBackend route
    class KServe,LLMDScheduler target
    class Simulator dev
    class User external
