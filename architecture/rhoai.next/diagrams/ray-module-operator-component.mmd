graph TB
    subgraph RayModule["Ray Module Operator"]
        direction TB
        Controller["ray-module-operator<br/>(Go controller-runtime)"]
        ReconcilePipeline["Reconciliation Pipeline<br/>management state → releases →<br/>manifest init → image params →<br/>kustomize render → cert-manager check →<br/>platform filter → notebook RBAC →<br/>SSA deploy → health monitor →<br/>distribution status → GC"]
        Controller --> ReconcilePipeline
    end

    subgraph Operand["KubeRay Operand (Managed)"]
        KubeRayOp["kuberay-operator<br/>(Deployment)"]
    end

    subgraph CRDs["Custom Resources"]
        RayCR["Ray CR<br/>(cluster-scoped, singleton)<br/>default-ray"]
        RayCluster["RayCluster CR"]
        RayJob["RayJob CR"]
        RayService["RayService CR"]
        RayCronJob["RayCronJob CR"]
    end

    subgraph Config["Configuration"]
        ConfigMap["odh-ray-config<br/>(ConfigMap)"]
        ParamsEnv["params.env<br/>(RELATED_IMAGE overrides)"]
    end

    PlatformOp["Platform Operator"] -->|creates| RayCR
    RayCR -->|watched by| Controller
    ConfigMap -->|watched by| Controller
    Controller -->|renders manifests<br/>via kustomize| ParamsEnv
    ReconcilePipeline -->|SSA deploy| KubeRayOp
    ReconcilePipeline -->|creates| RayClusterRole["ray ClusterRole<br/>(Notebook RBAC)"]

    KubeRayOp -->|reconciles| RayCluster
    KubeRayOp -->|reconciles| RayJob
    KubeRayOp -->|reconciles| RayService
    KubeRayOp -->|reconciles| RayCronJob

    User["Data Scientist /<br/>Notebook User"] -->|creates| RayCluster
    User -->|creates| RayJob

    Controller -->|depends on| CertManager["cert-manager"]
    KubeRayOp -->|manages| GatewayAPI["Gateway API Resources<br/>(HTTPRoutes, Gateways)"]
    KubeRayOp -->|manages| Routes["OpenShift Routes<br/>(Ray Dashboard)"]

    style Controller fill:#4a90e2,color:#fff
    style ReconcilePipeline fill:#4a90e2,color:#fff
    style KubeRayOp fill:#7ed321,color:#fff
    style RayCR fill:#f5a623
    style RayCluster fill:#f5a623
    style RayJob fill:#f5a623
    style RayService fill:#f5a623
    style RayCronJob fill:#f5a623
    style ConfigMap fill:#b8e6ff
    style ParamsEnv fill:#b8e6ff
    style CertManager fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style Routes fill:#e8e8e8
    style RayClusterRole fill:#d5e8d4
