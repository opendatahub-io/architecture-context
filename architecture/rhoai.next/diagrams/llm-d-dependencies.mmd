graph LR
    LLMd["llm-d<br/>Integration Platform"]

    %% Core External Dependencies (Required)
    LLMd -->|"inference engine<br/>(embedded)"| vLLM["vLLM v0.30.0"]
    LLMd -->|"deployment target"| K8s["Kubernetes 1.29+"]
    LLMd -->|"ingress mechanism"| GatewayAPI["Gateway API"]
    LLMd -->|"InferencePool CRD"| GAIE["Gateway API<br/>Inference Extension"]
    LLMd -->|"router deployment"| Helm["Helm 3.x"]
    LLMd -->|"model server deployment"| Kustomize["Kustomize 5.x"]

    %% Conditional External Dependencies
    LLMd -->|"multi-host serving"| LWS["LeaderWorkerSet<br/>v0.11.1"]
    LLMd -->|"autoscaling"| KEDA["KEDA 2.x"]
    LLMd -->|"metrics source"| Prometheus["Prometheus"]

    %% Optional External Dependencies
    LLMd -.->|"distributed tracing"| OTel["OpenTelemetry SDK<br/>>=1.39.1"]
    LLMd -.->|"KV cache transfer"| NIXL["NIXL"]
    LLMd -.->|"high-perf networking"| UCX["UCX"]
    LLMd -.->|"AMD collectives"| UCCL["UCCL v0.0.1.post6"]
    LLMd -.->|"Intel XPU cache"| LMCache["LMCache v0.5.0"]
    LLMd -.->|"AMD memory opt"| MORI["MORI v1.2.2"]

    %% Internal Platform Dependencies (sibling repos)
    LLMd -->|"LLM-aware routing<br/>Helm + ext-proc"| Router["llm-d-router"]
    LLMd -->|"distributed cache"| KVCache["llm-d-kv-cache"]
    LLMd -->|"P/D disaggregation"| Sidecar["llm-d-routing-sidecar"]
    LLMd -.->|"async workloads"| Async["llm-d-async"]
    LLMd -.->|"batch API"| BatchGW["llm-d-batch-gateway"]
    LLMd -.->|"latency scoring"| LatPred["llm-d-latency-predictor"]
    LLMd -.->|"autoscaling (deprecated)"| WVA["llm-d-workload-<br/>variant-autoscaler"]

    %% External Services
    LLMd -->|"model downloads<br/>HTTPS/443"| HF["HuggingFace Hub"]

    %% Gateway Implementations
    GatewayAPI -.->|"implementation"| Envoy["Envoy"]
    GatewayAPI -.->|"implementation"| Istio["Istio"]
    GatewayAPI -.->|"implementation"| kgateway["kgateway"]
    GatewayAPI -.->|"implementation"| EnvoyAI["Envoy AI Gateway"]
    GatewayAPI -.->|"implementation"| AgentGW["Agent Gateway"]

