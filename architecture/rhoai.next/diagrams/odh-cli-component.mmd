    style DSC fill:#f5a623,stroke:#333
    style DSCI fill:#f5a623,stroke:#333
    style OLM fill:#f5a623,stroke:#333
    style TrustyAI fill:#7ed321,stroke:#333
    style GitHub fill:#999,stroke:#333,color:#fff
    style User fill:#d5e8d4,stroke:#82b366
    style AIAgent fill:#d5e8d4,stroke:#82b366
