graph TB
    subgraph "odh-cli / rhai-cli"
        direction TB
        RootCmd["cmd/main.go<br/>Cobra Root Command"]
        subgraph "Command Groups"
            Lint["lint<br/>Upgrade Readiness"]
            Diagnose["diagnose<br/>4-Step Diagnostics"]
            Migrate["migrate<br/>Version Migration"]
            Backup["backup<br/>Workload Export"]
            Status["status<br/>Platform Health"]
            Deps["deps<br/>Operator Lifecycle"]
            Components["components<br/>Resource Introspection"]
            Get["get<br/>Resource Retrieval"]
            Logs["logs<br/>Log Streaming"]
            Events["events<br/>Event Monitoring"]
        end
        subgraph "MCP Server"
            MCPServe["mcp serve<br/>JSON-RPC Server"]
            ToolAdapter["toolAdapter<br/>Command Bridge"]
            MCPServe -->|"wraps commands"| ToolAdapter
        end
        subgraph "Client Layer"
            ClientFacade["pkg/util/client<br/>Multi-Client Facade"]
            DynClient["Dynamic Client<br/>Arbitrary GVRs"]
            DiscClient["Discovery Client<br/>API Discovery"]
            TypedClient["Typed Clientset<br/>Core Resources"]
            MetaClient["Metadata Client"]
            OLMClient["OLM Client<br/>CSV/Subscription"]
            CRClient["Controller-Runtime<br/>Health Checks"]
            ClientFacade --- DynClient
            ClientFacade --- DiscClient
            ClientFacade --- TypedClient
            ClientFacade --- MetaClient
            ClientFacade --- OLMClient
            ClientFacade --- CRClient
        end
        subgraph "Cross-Cutting"
            ErrorHandler["pkg/util/errors<br/>Structured Error Classification"]
            RBACCheck["pkg/util/kube/rbac<br/>SelfSubjectAccessReview"]
        end
        RootCmd --> Lint
        RootCmd --> Diagnose
        RootCmd --> Migrate
        RootCmd --> Backup
        RootCmd --> Status
        RootCmd --> Deps
        RootCmd --> Components
        RootCmd --> Get
        RootCmd --> Logs
        RootCmd --> Events
        RootCmd --> MCPServe
    end

    User["CLI User / kubectl odh"] -->|"stdin/flags"| RootCmd
    Agent["MCP-Capable Agent<br/>Claude, GPT, Cursor"] -->|"JSON-RPC<br/>stdio / SSE 8080"| MCPServe
    ClientFacade -->|"HTTPS 6443/TCP<br/>TLS 1.2+"| K8sAPI["Kubernetes API Server"]

    subgraph "Imported Libraries"
        ODHOperator["opendatahub-operator<br/>clusterhealth, failureclassifier, mcptools"]
        PlatUtils["odh-platform-utilities<br/>Platform detection, OLM helpers"]
    end

    Diagnose -->|"Go import"| ODHOperator
    MCPServe -->|"Go import"| ODHOperator
    ClientFacade -->|"Go import"| PlatUtils

    style RootCmd fill:#4a90e2,color:#fff
    style MCPServe fill:#9b59b6,color:#fff
    style ToolAdapter fill:#9b59b6,color:#fff
    style ClientFacade fill:#4a90e2,color:#fff
    style ErrorHandler fill:#e67e22,color:#fff
    style RBACCheck fill:#e67e22,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style User fill:#f5f5f5,stroke:#333
    style Agent fill:#f5f5f5,stroke:#333
    style ODHOperator fill:#7ed321,color:#fff
    style PlatUtils fill:#7ed321,color:#fff
