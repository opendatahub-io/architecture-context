graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["KServe V2 REST Client<br/>JSON Inference Requests"]
    end

    subgraph Platform["PLATFORM INGRESS"]
        MeshIngress["Istio Service Mesh<br/>mTLS Enforcement<br/>+ Optional kube-rbac-proxy"]
        MMService["ModelMesh Serving Service<br/>Routes to pod"]
    end

    subgraph Pod["MODELMESH SERVING POD (Shared Network Namespace)"]
        direction TB

        subgraph ProxyContainer["rest-proxy Sidecar Container"]
            ProxyListener["HTTP/HTTPS Listener<br/>8008/TCP<br/>TLS: Optional (MM_TLS_KEY_CERT_PATH)<br/>FIPS: strictfipsruntime"]
            ProxyGRPC["gRPC Client<br/>grpc-gateway"]
        end

        subgraph InferenceContainer["gRPC Inference Server Container"]
            GRPCServer["ModelMesh gRPC<br/>8033/TCP<br/>V2 Predict Protocol"]
        end

        ProxyListener --> ProxyGRPC
        ProxyGRPC -->|"gRPC/8033<br/>TLS: REST_PROXY_USE_TLS<br/>Verify: REST_PROXY_SKIP_VERIFY<br/>Auth: None (localhost)"| GRPCServer
    end

    subgraph Config["CONFIGURATION"]
        ConfigMap["model-serving-config<br/>ConfigMap<br/>restProxy.image"]
    end

    %% Flows
    Client -->|"HTTP(S)/8008<br/>Configurable TLS<br/>Auth: Delegated"| MeshIngress
    MeshIngress -->|"mTLS<br/>Service Identity"| MMService
    MMService -->|"Pod Network"| ProxyListener

    ConfigMap -.->|"Image reference"| ProxyContainer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef config fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class MeshIngress,MMService platform
    class ProxyListener,ProxyGRPC proxy
    class GRPCServer inference
    class ConfigMap config
