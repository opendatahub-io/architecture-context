graph TB
    subgraph Cluster["CLUSTER INTERNAL"]
        Client["Client<br/>(within cluster)"]
    end

    subgraph PodBoundary["POD BOUNDARY (Sidecar Deployment)"]
        direction TB

        subgraph ProxyContainer["rest-proxy Container"]
            Proxy["rest-proxy<br/>8008/TCP HTTP/HTTPS<br/>TLS optional<br/>Auth: None<br/>FIPS: strictfipsruntime"]
        end

        subgraph InferenceContainer["Inference Server Container"]
            Backend["ModelMesh Inference Server<br/>8033/TCP gRPC<br/>localhost only"]
        end
    end

    subgraph Deployment["DEPLOYMENT MANAGEMENT"]
        ModelMesh["ModelMesh Serving<br/>Sidecar injection via<br/>restProxy.image config"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8008/TCP<br/>TLS optional<br/>Auth: None<br/>Max: 16 MB"| Proxy
    Proxy -->|"gRPC 8033/TCP<br/>localhost<br/>TLS optional<br/>SkipVerify configurable"| Backend
    ModelMesh -.->|"Deploys sidecar<br/>model-serving-config ConfigMap"| Proxy

    %% Styling
    classDef cluster fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef mgmt fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client cluster
    class Proxy proxy
    class Backend backend
    class ModelMesh mgmt
