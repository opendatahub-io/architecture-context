graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["REST Client<br/>Inference Consumer"]
    end

    subgraph PlatformAuth["PLATFORM AUTH LAYER"]
        direction TB
        AuthProxy["kube-rbac-proxy / oauth-proxy<br/>(external to rest-proxy)<br/>Enforces AuthN/AuthZ"]
    end

    subgraph Pod["MODELMESH SERVING POD (Pod-Local Network)"]
        direction TB

        subgraph Sidecar["rest-proxy Sidecar Container"]
            RESTServer["REST Server<br/>0.0.0.0:8008/TCP<br/>HTTP or HTTPS<br/>Optional TLS (MM_TLS_KEY_CERT_PATH)<br/>No MinVersion set (default TLS 1.2)<br/>FIPS: strictfipsruntime"]
            GRPCClient["gRPC Client<br/>Optional TLS (REST_PROXY_USE_TLS)<br/>InsecureSkipVerify: configurable"]
            RESTServer --> GRPCClient
        end

        subgraph MMServing["ModelMesh Serving Container"]
            GRPCInference["gRPC Inference Service<br/>8033/TCP gRPC<br/>KServe V2 Predict Protocol"]
        end

        GRPCClient -->|"gRPC/8033<br/>localhost<br/>Optional TLS<br/>No Auth"| GRPCInference
    end

    subgraph Secrets["SECRETS"]
        TLSSecret["TLS Cert/Key<br/>kubernetes.io/tls<br/>Provisioned by MM operator"]
    end

    %% Flows
    Client -->|"HTTP(S)/8008<br/>Optional TLS<br/>No proxy-level auth"| AuthProxy
    AuthProxy -->|"Authenticated request"| RESTServer
    TLSSecret -.->|"mounted volume<br/>shared in pod"| RESTServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authLayer fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef sidecar fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef mmserving fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class AuthProxy authLayer
    class RESTServer,GRPCClient sidecar
    class GRPCInference mmserving
    class TLSSecret secrets
