graph TB
    subgraph "vllm-gaudi Container (odh-vllm-gaudi-rhel9)"
        subgraph "vLLM Server"
            APIServer["vLLM OpenAI API Server<br/>vllm.entrypoints.openai.api_server<br/>Port 8000/TCP"]
        end

        subgraph "vllm_gaudi Plugin Package"
            Platform["HPU Platform Plugin<br/>vllm_gaudi/platform.py"]
            AttentionBackend["Attention Backends<br/>HPU Paged Attention<br/>128-token blocks"]
            ModelRunner["HPU Model Runner<br/>v1/worker/hpu_model_runner.py"]
            Worker["HPU Worker<br/>v1/worker/hpu_worker.py"]
            Bucketing["Bucketing System<br/>linear / exponential / vision"]
            QuantBackends["Quantization Backends<br/>FP8 (INC, CT, ModelOpt)<br/>GPTQ (2/3/4/8-bit) / AWQ"]
            CustomOps["Custom HPU Ops<br/>attention, rotary, layernorm<br/>fused_moe, lora, mamba"]
            Communicator["HPU Communicator<br/>HCCL Collectives<br/>TP / DP / EP"]
            KVOffload["KV Cache Offloader<br/>HPU ↔ CPU async transfer"]
            SpecDecode["Speculative Decoding<br/>Eagle3 / Eagle Unified"]
            Models["Model Overrides<br/>Pixtral, Qwen2.5-VL<br/>Qwen3-MoE, MiniMax"]
        end

        APIServer -->|inference request| Platform
        Platform -->|registers| AttentionBackend
        Platform -->|registers| ModelRunner
        Platform -->|registers| Worker
        Platform -->|registers| CustomOps
        Platform -->|registers| QuantBackends
        ModelRunner -->|uses| Bucketing
        ModelRunner -->|uses| AttentionBackend
        ModelRunner -->|uses| QuantBackends
        Worker -->|uses| Communicator
        Worker -->|uses| KVOffload
        Worker -->|uses| SpecDecode
        ModelRunner -->|loads| Models
    end

    Client[External Client] -->|POST /v1/completions<br/>POST /v1/chat/completions| APIServer
    KServe["KServe / ServingRuntime"] -->|manages container| APIServer
    GaudiDevice["Intel Gaudi HPU<br/>(Gaudi2 / Gaudi3)<br/>SynapseAI 1.23.0"] <-->|PCIe / HPU API| Worker
    ModelStorage["Model Storage<br/>(S3 / PVC)"] -->|model weights| APIServer
    RayCluster["Ray Cluster<br/>6379/TCP"] <-->|distributed execution| Communicator

    style APIServer fill:#4a90e2,color:#fff
    style Platform fill:#4a90e2,color:#fff
