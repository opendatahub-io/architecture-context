graph TB
    subgraph "vllm-gaudi Plugin"
        direction TB

        subgraph "Plugin Registration"
            Init["__init__.py<br/>Entry Point Registration"]
            PlatformPlugin["vllm.platform_plugins<br/>(hpu)"]
            GeneralPlugins["vllm.general_plugins<br/>(utils, ops, models)"]
            Init --> PlatformPlugin
            Init --> GeneralPlugins
        end

        subgraph "Platform Layer"
            HpuPlatform["HpuPlatform<br/>Platform Interface Implementation"]
            Envs["envs.py<br/>HPU Environment Variables"]
            HpuPlatform --> Envs
        end

        subgraph "Runtime Configuration"
            Runtime["runtime.py<br/>Lazy-evaluated Config"]
            Features["features.py<br/>HW Detection<br/>(Gaudi 2 / Gaudi 3)"]
            Runtime --> Features
        end

        subgraph "Worker Layer"
            HPUWorker["HPUWorker<br/>vLLM v1 Worker for HPU"]
            HpuComm["HpuCommunicator<br/>HCCL Collectives"]
            HPUWorker --> HpuComm
        end

        subgraph "Custom Ops"
            Attention["Attention Backends<br/>(Unified, FSDPA, MLA)"]
            FusedMoE["Fused MoE"]
            Quant["Quantization<br/>(FP8, AWQ, GPTQ, ModelOpt)"]
            RotEmbed["Rotary Embedding"]
            LoRA["LoRA Ops"]
            Mamba["Mamba/SSM Ops"]
        end

        subgraph "Model Overrides"
            Models["HPU Model Registry<br/>(11 architectures)"]
            Gemma3["Gemma3"]
            Qwen["Qwen2.5-VL / Qwen3-VL-MoE"]
            DeepSeek["DeepSeek-v2"]
            Pixtral["Pixtral"]
            Models --> Gemma3
            Models --> Qwen
            Models --> DeepSeek
            Models --> Pixtral
        end

        PlatformPlugin --> HpuPlatform
        GeneralPlugins --> HPUWorker
        GeneralPlugins --> Models
        HpuPlatform --> Runtime
        HPUWorker --> Attention
        HPUWorker --> FusedMoE
        HPUWorker --> Quant
    end

    subgraph "Upstream vLLM"
        VllmEngine["vLLM Engine<br/>v0.16.0"]
        APIServer["OpenAI API Server<br/>8000/TCP"]
        APIServer --> VllmEngine
    end

    subgraph "Hardware"
        HPU["Intel Gaudi HPU<br/>(Gaudi 2 / Gaudi 3)"]
        SynapseAI["SynapseAI SDK 1.23.0"]
        HPU --> SynapseAI
    end

    VllmEngine -->|"loads plugin"| Init
    HPUWorker -->|"inference execution"| HPU
    HpuComm -->|"HCCL collectives"| HPU

    style HpuPlatform fill:#4a90e2,color:#fff
    style HPUWorker fill:#4a90e2,color:#fff
    style HpuComm fill:#4a90e2,color:#fff
    style Models fill:#4a90e2,color:#fff
    style VllmEngine fill:#7ed321,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style HPU fill:#f5a623,color:#fff
    style SynapseAI fill:#f5a623,color:#fff
    style Attention fill:#9b59b6,color:#fff
    style FusedMoE fill:#9b59b6,color:#fff
    style Quant fill:#9b59b6,color:#fff
