    style Communicator fill:#4a90e2,color:#fff
    style KVOffload fill:#4a90e2,color:#fff
    style SpecDecode fill:#4a90e2,color:#fff
    style Models fill:#4a90e2,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style KServe fill:#7ed321,color:#fff
    style GaudiDevice fill:#f5a623,color:#fff
    style ModelStorage fill:#f5a623,color:#fff
