graph TB
    subgraph External["External Access"]
        Client[Client / Data Scientist]
    end

    subgraph Platform["RHOAI Platform Layer"]
        GatewayAPI["Gateway API<br/>(Envoy)<br/>443/TCP HTTPS"]
        KubeRBACProxy["kube-rbac-proxy<br/>Sidecar<br/>8443/TCP HTTPS"]
    end

    subgraph VLLMGaudiPod["vllm-gaudi Pod"]
        subgraph Container["odh-vllm-gaudi-rhel9 Container"]
            APIServer["vLLM OpenAI API Server<br/>8000/TCP HTTP"]
            subgraph Plugin["vllm_gaudi Plugin"]
                PlatformPlugin["HpuPlatform<br/>(platform_plugins entry point)"]
                AttentionBackends["Attention Backends<br/>HPUAttentionV1 | Unified | MLA"]
                ModelOverrides["Model Overrides<br/>14 architectures<br/>(Qwen, DeepSeek, Pixtral, ...)"]
                CustomOps["Custom Ops<br/>FusedMoE | FP8 | Mamba"]
                ExtConfig["Extension Config<br/>Lazy eval | HW detection | Feature flags"]
                Bucketing["Bucketing Manager<br/>Tensor shape quantization"]
                SpecDecode["Speculative Decoding<br/>EAGLE | Unified EAGLE"]
                KVOffload["KV Cache Offload<br/>CPU ↔ HPU"]
            end
        end
    end

    subgraph Hardware["Intel Gaudi Hardware"]
        HPU["Gaudi2/3 HPU<br/>PCIe/HCCL"]
        HPUGraph["HPU Graph<br/>Compilation Cache"]
    end

    subgraph DistributedLayer["Distributed Inference (Multi-Card)"]
        HCCL["HCCL Communicator<br/>RDMA/TCP"]
        RayWorkers["Ray Workers<br/>6379/TCP"]
        PeerHPUs["Peer HPU Workers"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>Bearer Token"| GatewayAPI
    GatewayAPI -->|"HTTPS/8443<br/>TLS"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8000<br/>localhost"| APIServer

    %% Internal plugin flows
    APIServer --> PlatformPlugin
    PlatformPlugin --> AttentionBackends
    PlatformPlugin --> ModelOverrides
    PlatformPlugin --> CustomOps
    PlatformPlugin --> ExtConfig
    ExtConfig --> Bucketing
    AttentionBackends --> HPU
    ModelOverrides --> HPU
    CustomOps --> HPU
    HPU --> HPUGraph
    SpecDecode --> AttentionBackends

    %% Distributed flows
    APIServer --> RayWorkers
    RayWorkers --> PeerHPUs
    PeerHPUs --> HCCL
    HCCL --> HPU
    KVOffload --> HPU

    %% Styling
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style GatewayAPI fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style APIServer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style PlatformPlugin fill:#4a90e2,stroke:#333,color:#fff
    style AttentionBackends fill:#5b9bd5,stroke:#333,color:#fff
    style ModelOverrides fill:#5b9bd5,stroke:#333,color:#fff
    style CustomOps fill:#5b9bd5,stroke:#333,color:#fff
    style ExtConfig fill:#5b9bd5,stroke:#333,color:#fff
    style Bucketing fill:#5b9bd5,stroke:#333,color:#fff
    style SpecDecode fill:#5b9bd5,stroke:#333,color:#fff
    style KVOffload fill:#5b9bd5,stroke:#333,color:#fff
    style HPU fill:#7b2d8e,stroke:#333,stroke-width:2px,color:#fff
    style HPUGraph fill:#7b2d8e,stroke:#333,color:#fff
    style HCCL fill:#9b59b6,stroke:#333,color:#fff
    style RayWorkers fill:#9b59b6,stroke:#333,color:#fff
    style PeerHPUs fill:#9b59b6,stroke:#333,color:#fff
