graph TB
    subgraph TrustyAI["TrustyAI Service"]
        direction TB

        subgraph MainApp["Main App (API Server)"]
            APIRouter["FastAPI Router<br/>8081/TCP HTTP (loopback)<br/>4443/TCP HTTPS"]
            DriftEndpoints["Drift Endpoints<br/>KS Test, Jensen-Shannon,<br/>MMD, Compare Means,<br/>KS Streaming"]
            FairnessEndpoints["Fairness Endpoints<br/>SPD, DIR"]
            ExplainerEndpoints["Explainer Endpoints<br/>LIME, SHAP, CF, PDP<br/>(disabled by default)"]
            InfoEndpoints["Info / Data Endpoints<br/>/info, /data/upload"]
            MetricsEndpoint["/q/metrics<br/>Prometheus scrape"]
        end

        subgraph HealthApp["Health App (Consumer Server)"]
            HealthProbes["Health Probes<br/>8080/TCP HTTP (all interfaces)<br/>/q/health/ready, /q/health/live"]
            CloudEventConsumer["CloudEvent Consumer<br/>POST /"]
            KServeV2Consumer["KServe v2 Consumer<br/>POST /consumer/kserve/v2"]
        end

        subgraph Background["Background Tasks"]
            Scheduler["Prometheus Scheduler<br/>(asyncio, 30s interval)"]
        end

        subgraph Storage["Storage Backends"]
            PVCStorage["PVC Storage<br/>HDF5 via h5py"]
            MariaDBStorage["MariaDB Storage<br/>(optional, TLS)"]
        end

        subgraph Config["Configuration"]
            FeatureFlags["Feature Flags<br/>TRUSTYAI_ENABLE_*"]
            TLSConfig["PolicyAwareConfig<br/>System Crypto Policy"]
        end
    end

    APIRouter --> DriftEndpoints
    APIRouter --> FairnessEndpoints
    APIRouter --> ExplainerEndpoints
    APIRouter --> InfoEndpoints
    APIRouter --> MetricsEndpoint

    FeatureFlags -.->|gates| DriftEndpoints
    FeatureFlags -.->|gates| FairnessEndpoints
    FeatureFlags -.->|gates| ExplainerEndpoints

    CloudEventConsumer --> PVCStorage
    CloudEventConsumer --> MariaDBStorage
    KServeV2Consumer --> PVCStorage
    KServeV2Consumer --> MariaDBStorage

    Scheduler -->|reads| PVCStorage
    Scheduler -->|reads| MariaDBStorage
    Scheduler -->|publishes| MetricsEndpoint

    DriftEndpoints -->|reads| PVCStorage
    DriftEndpoints -->|reads| MariaDBStorage
    FairnessEndpoints -->|reads| PVCStorage
    FairnessEndpoints -->|reads| MariaDBStorage

    TLSConfig -.->|configures| APIRouter

    %% External actors
    KubeRBACProxy["kube-rbac-proxy<br/>(sidecar)"] -->|forwards auth'd requests<br/>HTTP loopback| APIRouter
    KServeLogger["KServe Inference Logger"] -->|CloudEvents<br/>HTTP/8080| CloudEventConsumer
    ModelMeshAgent["ModelMesh Agent"] -->|KServe v2 JSON<br/>HTTP/8080| KServeV2Consumer
    Prometheus["Prometheus"] -->|scrapes /q/metrics<br/>HTTP/8081| MetricsEndpoint
    Kubelet["Kubelet"] -->|probes<br/>HTTP/8080| HealthProbes

    %% Styling
    style TrustyAI fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style MainApp fill:#dbeafe,stroke:#3b82f6,stroke-width:1px
    style HealthApp fill:#dcfce7,stroke:#22c55e,stroke-width:1px
    style Background fill:#fef3c7,stroke:#f59e0b,stroke-width:1px
    style Storage fill:#f3e8ff,stroke:#a855f7,stroke-width:1px
    style Config fill:#fce7f3,stroke:#ec4899,stroke-width:1px

    style KubeRBACProxy fill:#fed7aa,stroke:#ea580c,stroke-width:2px
    style KServeLogger fill:#e5e7eb,stroke:#6b7280,stroke-width:1px
    style ModelMeshAgent fill:#e5e7eb,stroke:#6b7280,stroke-width:1px
    style Prometheus fill:#e5e7eb,stroke:#6b7280,stroke-width:1px
    style Kubelet fill:#e5e7eb,stroke:#6b7280,stroke-width:1px
