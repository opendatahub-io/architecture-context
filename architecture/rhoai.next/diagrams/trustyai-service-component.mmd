graph TB
    subgraph External["External Clients"]
        KServeAgent["KServe Agent"]
        ModelMeshAgent["ModelMesh Agent"]
        Dashboard["RHOAI Dashboard"]
        PromScraper["Prometheus Scraper"]
        K8sAPI["Kubernetes API<br/>(Health Probes)"]
    end

    subgraph Proxy["Authentication Layer"]
        KRBP["kube-rbac-proxy<br/>8443/TCP → 127.0.0.1:8080<br/>TLS Termination + Bearer Auth"]
    end

    subgraph TrustyAI["TrustyAI Service (FastAPI + Hypercorn)"]
        direction TB

        subgraph Middleware["Middleware"]
            GzipMW["Gzip Middleware<br/>Decompression + Bomb Protection"]
        end

        subgraph Endpoints["API Endpoints"]
            KServeConsumer["KServe V2 Consumer<br/>POST /"]
            MMConsumer["ModelMesh Consumer<br/>POST /consumer/kserve/v2"]
            MetricsEndpoints["Metrics Endpoints<br/>SPD, DIR, KS Test,<br/>Compare Means, Batch Mean"]
            InfoEndpoints["Info Endpoints<br/>GET /info, /info/names"]
            LMEvalEndpoint["LM Eval Harness<br/>POST /eval/lm-evaluation-harness/job"]
            HealthEndpoints["Health & Metrics<br/>/q/health/*, /q/metrics"]
        end

        subgraph Core["Core (Pure Algorithms)"]
            FairnessMetrics["Fairness Metrics<br/>SPD, DIR"]
            DriftMetrics["Drift Detection<br/>KS Test, Welch's t-test"]
            BatchStats["Batch Statistics<br/>Moving Average"]
        end

        subgraph Services["Service Layer"]
            PrometheusScheduler["Prometheus Scheduler<br/>Periodic Computation<br/>(asyncio, configurable interval)"]
            PrometheusPublisher["Prometheus Publisher<br/>Gauge Registry"]
            MetricsDirectory["Metrics Directory<br/>Plugin Registry"]
            StorageInterface["Storage Interface<br/>(Abstract)"]
        end
    end

    subgraph StorageBackends["Storage Backends"]
        PVCStorage["PVC Storage<br/>HDF5 Files<br/>Local I/O"]
        MariaDBStorage["MariaDB<br/>3306/TCP<br/>TLS (optional)"]
    end

    subgraph OptionalExternal["Optional External Services"]
        LMEvalAPIs["LM Eval API Providers<br/>443/TCP HTTPS"]
    end

    %% External to Proxy
    KServeAgent -->|"HTTPS/8443<br/>Bearer Token"| KRBP
    ModelMeshAgent -->|"HTTPS/8443<br/>Bearer Token"| KRBP
    Dashboard -->|"HTTPS/8443<br/>Bearer Token"| KRBP
    PromScraper -->|"HTTPS/8443<br/>Bearer Token"| KRBP
    K8sAPI -->|"HTTP/8080<br/>Direct (probes)"| HealthEndpoints

    %% Proxy to Service
    KRBP -->|"HTTP/8080<br/>loopback"| GzipMW

    %% Middleware to Endpoints
    GzipMW --> KServeConsumer
    GzipMW --> MMConsumer
    GzipMW --> MetricsEndpoints
    GzipMW --> InfoEndpoints
    GzipMW --> LMEvalEndpoint
    GzipMW --> HealthEndpoints

    %% Endpoints to Core
    MetricsEndpoints --> FairnessMetrics
    MetricsEndpoints --> DriftMetrics
    MetricsEndpoints --> BatchStats

    %% Endpoints to Services
    KServeConsumer --> StorageInterface
    MMConsumer --> StorageInterface
    MetricsEndpoints --> StorageInterface
    InfoEndpoints --> StorageInterface

    %% Scheduler flow
    PrometheusScheduler --> MetricsDirectory
    MetricsDirectory --> FairnessMetrics
    MetricsDirectory --> DriftMetrics
    MetricsDirectory --> BatchStats
    PrometheusScheduler --> StorageInterface
    PrometheusScheduler --> PrometheusPublisher

    %% Storage backends
    StorageInterface --> PVCStorage
    StorageInterface --> MariaDBStorage

    %% LM Eval
    LMEvalEndpoint -->|"Subprocess<br/>Sandboxed Env"| LMEvalAPIs

    %% Styling
    style KRBP fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style GzipMW fill:#e1d5e7,stroke:#9673a6
    style KServeConsumer fill:#dae8fc,stroke:#6c8ebf
    style MMConsumer fill:#dae8fc,stroke:#6c8ebf
    style MetricsEndpoints fill:#dae8fc,stroke:#6c8ebf
    style InfoEndpoints fill:#dae8fc,stroke:#6c8ebf
    style LMEvalEndpoint fill:#dae8fc,stroke:#6c8ebf
    style HealthEndpoints fill:#dae8fc,stroke:#6c8ebf
    style FairnessMetrics fill:#d5e8d4,stroke:#82b366
    style DriftMetrics fill:#d5e8d4,stroke:#82b366
    style BatchStats fill:#d5e8d4,stroke:#82b366
    style PrometheusScheduler fill:#fff2cc,stroke:#d6b656
    style PrometheusPublisher fill:#fff2cc,stroke:#d6b656
    style MetricsDirectory fill:#fff2cc,stroke:#d6b656
    style StorageInterface fill:#fff2cc,stroke:#d6b656
    style PVCStorage fill:#f8cecc,stroke:#b85450
    style MariaDBStorage fill:#f8cecc,stroke:#b85450
    style LMEvalAPIs fill:#f5f5f5,stroke:#666
