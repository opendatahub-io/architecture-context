graph LR
    WVA["WVA Controller Manager"]

    %% Required External Dependencies
    WVA -->|"operator framework"| CR["controller-runtime v0.22.5"]
    WVA -->|"InferencePool CRD types"| GAIE["gateway-api-inference-ext v1.2.1"]
    WVA -->|"metrics source"| Prometheus["Prometheus"]
    WVA -->|"parameter tuning"| Kalman["kalman-filter v0.1.2"]
    WVA -->|"queueing math"| Gonum["gonum v0.17.0"]

    %% Optional External Dependencies
    WVA -.->|"external autoscaler<br/>(optional)"| KEDA["KEDA v2.18.0"]
    WVA -.->|"multi-worker scale<br/>(optional)"| LWS["LeaderWorkerSet v0.8.0"]
    WVA -.->|"monitoring CRDs<br/>(optional)"| PromOp["prometheus-operator v0.89.0"]

    %% Internal Platform Dependencies
    WVA -->|"arrival rate,<br/>queue metrics"| EPP["EPP<br/>(Endpoint Picker)"]
    WVA -->|"KV cache, queue,<br/>throughput metrics"| vLLM["vLLM Servers"]
    WVA -->|"equivalent metrics<br/>(sglang: prefix)"| SGLang["SGLang Servers"]
    WVA -->|"GPU node labels"| GPUOp["NVIDIA GPU Operator"]

    %% Integration Points (downstream consumers)
    HPA["HPA"] -->|"consumes<br/>wva_desired_replicas"| WVA
    KEDAConsumer["KEDA ScaledObject"] -->|"consumes<br/>wva_desired_replicas"| WVA

    %% Kubernetes
    WVA -->|"API server"| K8sAPI["Kubernetes API"]

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required dependencies
    style CR fill:#999,stroke:#333
    style GAIE fill:#999,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style Kalman fill:#999,stroke:#333
    style Gonum fill:#999,stroke:#333

    %% Optional dependencies
    style KEDA fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style LWS fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style PromOp fill:#ccc,stroke:#333,stroke-dasharray: 5 5

    %% Internal platform
    style EPP fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style SGLang fill:#7ed321,stroke:#333
    style GPUOp fill:#7ed321,stroke:#333

    %% Downstream consumers
    style HPA fill:#f5a623,stroke:#333
    style KEDAConsumer fill:#f5a623,stroke:#333

    %% Kubernetes
    style K8sAPI fill:#f5a623,stroke:#333
