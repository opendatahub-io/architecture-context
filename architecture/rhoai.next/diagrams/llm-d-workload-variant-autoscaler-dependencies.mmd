graph LR
    WVA["WVA<br/>Workload Variant<br/>Autoscaler"]

    %% Required External Dependencies
    WVA -->|"operator framework<br/>v0.22.5"| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    WVA -->|"InferencePool CRD types<br/>v1 + v1alpha2"| GatewayAPIInference["gateway-api-inference<br/>-extension v1.2.1"]
    WVA -->|"metrics source"| Prometheus["Prometheus"]
    WVA -->|"Kalman filter tuning<br/>v0.1.2"| KalmanFilter["kalman-filter<br/>v0.1.2"]
    WVA -->|"queueing theory math<br/>(M/M/1/K) v0.17.0"| Gonum["gonum v0.17.0"]

    %% Optional External Dependencies
    WVA -.->|"ScaledObject CRD<br/>(conditional)"| KEDA["KEDA v2.18.0"]
    WVA -.->|"multi-worker inference<br/>(conditional)"| LWS["LeaderWorkerSet<br/>v0.8.0"]
    WVA -.->|"ServiceMonitor/PrometheusRule<br/>(optional)"| PromOperator["prometheus-operator<br/>v0.89.0"]

    %% Internal Platform Dependencies
    WVA -->|"arrival rate &<br/>queue metrics"| EPP["EPP<br/>(Endpoint Picker)"]
    WVA -->|"KV cache, queue,<br/>throughput metrics"| vLLM["vLLM Servers"]
    WVA -->|"equivalent metrics<br/>(sglang: prefix)"| SGLang["SGLang Servers"]
    WVA -->|"GPU node labels"| GPUOperator["NVIDIA GPU<br/>Operator"]

    %% Integration Points (consumers of WVA)
    HPA["HPA<br/>(autoscaling/v2)"] -->|"reads<br/>wva_desired_replicas"| WVA
    KEDAConsumer["KEDA ScaledObject"] -.->|"reads<br/>wva_desired_replicas"| WVA

    %% Kubernetes API (bidirectional)
    WVA -->|"watch + scale<br/>subresource"| K8sAPI["Kubernetes API"]

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external - gray
    style ControllerRuntime fill:#999,stroke:#333
    style GatewayAPIInference fill:#999,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style KalmanFilter fill:#999,stroke:#333
    style Gonum fill:#999,stroke:#333

    %% Optional external - lighter gray, dashed
    style KEDA fill:#bbb,stroke:#333,stroke-dasharray: 5 5
    style LWS fill:#bbb,stroke:#333,stroke-dasharray: 5 5
    style PromOperator fill:#bbb,stroke:#333,stroke-dasharray: 5 5

    %% Internal platform - green
    style EPP fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style SGLang fill:#7ed321,stroke:#333
    style GPUOperator fill:#7ed321,stroke:#333

    %% Consumers - orange
    style HPA fill:#f5a623,stroke:#333
    style KEDAConsumer fill:#f5a623,stroke:#333,stroke-dasharray: 5 5

    %% Kubernetes API - yellow
    style K8sAPI fill:#f5a623,stroke:#333
