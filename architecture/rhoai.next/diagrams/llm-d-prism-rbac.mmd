graph TD
    subgraph AuthFlow["Authentication Flow"]
        User["User Browser"]
        OAuthLogin["GitHub OAuth Login<br/>(read:user scope)"]
        TokenExchange["Token Exchange<br/>Client ID + Secret"]
        AccessToken["GitHub Access Token"]
    end

    subgraph RoleResolution["Role Resolution"]
        ValidateToken["Validate Token<br/>GET api.github.com/user"]
        OrgCheck["Org Membership Check<br/>llm-d organization"]
        AdminAllowlist["Admin Allowlist<br/>GCS: prism-iam/<br/>github-admin-allowlist.txt"]
        UserAllowlist["User Allowlist<br/>GCS: prism-iam/<br/>github-user-allowlist.txt"]
    end

    subgraph Roles["Resolved Roles"]
        AdminRole["Admin Role"]
        UserRole["User Role"]
        NoneRole["None Role<br/>(unauthenticated / no allowlist)"]
    end

    subgraph Permissions["API Permissions"]
        subgraph AdminPerms["Admin Permissions"]
            PromoteResults["POST /api/results/:id/promote"]
            ReviewResults["POST /api/results/:id/review"]
            DeleteResults["DELETE /api/results/:id"]
            GCSWrite["POST/PUT/DELETE /api/gcs/*<br/>(Results Store prefix only)"]
            ViewAll["View all submissions<br/>(any state)"]
        end

        subgraph UserPerms["User Permissions"]
            SubmitResults["POST /api/results<br/>(submit new benchmark)"]
            ViewOwn["View own submissions<br/>(any state)"]
            ExportResults["GET /api/results/:id/export"]
            DownloadEntry["GET /api/results/:id/entries/:idx/download"]
        end

        subgraph PublicPerms["Public Permissions"]
            ViewPublic["View public/promoted results"]
            ReadConfig["GET /api/config"]
            ReadBenchmarks["GET /api/prefix-cache/data<br/>GET /api/pd-disaggregation/data<br/>GET /api/regressions"]
            StaticAssets["GET /* (SPA static assets)"]
        end
    end

    subgraph PlaygroundMode["Dev Override"]
        Playground["RESULTS_STORE_PLAYGROUND_MODE=1<br/>Bypasses ALL auth checks"]
    end

    %% Auth flow
    User -->|"initiates"| OAuthLogin
    OAuthLogin -->|"redirects to GitHub"| TokenExchange
    TokenExchange -->|"returns"| AccessToken

    %% Role resolution
    AccessToken -->|"validates"| ValidateToken
    ValidateToken -->|"checks"| OrgCheck
    OrgCheck -->|"checks"| AdminAllowlist
    OrgCheck -->|"checks"| UserAllowlist
    AdminAllowlist -->|"match"| AdminRole
    UserAllowlist -->|"match"| UserRole
    OrgCheck -->|"no match in either list"| NoneRole

    %% Role to permissions
    AdminRole -->|"grants"| AdminPerms
    AdminRole -->|"inherits"| UserPerms
    AdminRole -->|"inherits"| PublicPerms
    UserRole -->|"grants"| UserPerms
    UserRole -->|"inherits"| PublicPerms
    NoneRole -->|"grants"| PublicPerms

    %% Playground bypass
    Playground -.->|"bypasses"| AdminPerms
    Playground -.->|"bypasses"| UserPerms

    %% Styling
    style User fill:#4a90e2,stroke:#333,color:#fff
    style AdminRole fill:#e74c3c,stroke:#333,color:#fff
    style UserRole fill:#f5a623,stroke:#333,color:#fff
    style NoneRole fill:#95a5a6,stroke:#333,color:#fff
    style Playground fill:#e74c3c,stroke:#c0392b,stroke-width:3px,stroke-dasharray:5 5,color:#fff
    style OAuthLogin fill:#4a90e2,stroke:#333,color:#fff
    style TokenExchange fill:#4a90e2,stroke:#333,color:#fff
    style AccessToken fill:#4a90e2,stroke:#333,color:#fff
    style ValidateToken fill:#9b59b6,stroke:#333,color:#fff
    style OrgCheck fill:#9b59b6,stroke:#333,color:#fff
    style AdminAllowlist fill:#9b59b6,stroke:#333,color:#fff
    style UserAllowlist fill:#9b59b6,stroke:#333,color:#fff
