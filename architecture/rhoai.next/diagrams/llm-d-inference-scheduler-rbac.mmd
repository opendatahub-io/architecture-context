graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["{pool}-epp<br/>Namespace: {pool-namespace}"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Metrics["{pool}-epp<br/>(metrics auth)"]
    end

    subgraph NamespaceRoleBindings["Namespace RoleBindings"]
        RB1["{pool}-epp<br/>→ {pool}-epp-role"]
        RB2["{pool}-epp-pods<br/>→ {pool}-epp-pods-role"]
        RB3["{pool}-epp-leader-election<br/>→ {pool}-epp-leader-election-role"]
    end

    subgraph ClusterRolePerms["ClusterRole: {pool}-epp (metrics auth)"]
        direction TB
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
        MetricsURL["nonResourceURL<br/>/metrics<br/>Verbs: get"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        direction TB
        subgraph Role1["{pool}-epp-role"]
            R1_Res["InferencePool, InferenceObjective,<br/>InferenceModelRewrite CRDs<br/>Verbs: get, list, watch"]
        end
        subgraph Role2["{pool}-epp-pods-role"]
            R2_Res["Pods<br/>Verbs: get, list, watch"]
        end
        subgraph Role3["{pool}-epp-leader-election-role"]
            R3_Res["Leases<br/>Verbs: get, create, update"]
        end
    end

    subgraph APIResources["API Resources Accessed"]
        InferencePoolRes["gateway.networking.x-k8s.io<br/>InferencePool"]
        InferenceObjRes["llm-d.ai<br/>InferenceObjective"]
        InferenceRewriteRes["llm-d.ai<br/>InferenceModelRewrite"]
        PodsRes["core<br/>Pods"]
        LeasesRes["coordination.k8s.io<br/>Leases"]
        TokenReviewRes["authentication.k8s.io<br/>TokenReviews"]
        SARRes["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    %% Bindings
    SA -->|"bound via"| CRB_Metrics
    SA -->|"bound via"| RB1
    SA -->|"bound via"| RB2
    SA -->|"bound via"| RB3

    CRB_Metrics -->|"grants"| ClusterRolePerms

    RB1 -->|"grants"| Role1
    RB2 -->|"grants"| Role2
    RB3 -->|"grants"| Role3

    %% Resource access
    TokenReview -->|"create"| TokenReviewRes
    SAR -->|"create"| SARRes
    R1_Res -->|"get, list, watch"| InferencePoolRes
    R1_Res -->|"get, list, watch"| InferenceObjRes
    R1_Res -->|"get, list, watch"| InferenceRewriteRes
    R2_Res -->|"get, list, watch"| PodsRes
    R3_Res -->|"get, create, update"| LeasesRes

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB_Metrics fill:#e8a838,stroke:#333,color:#fff
    style RB1 fill:#e8a838,stroke:#333,color:#fff
    style RB2 fill:#e8a838,stroke:#333,color:#fff
    style RB3 fill:#e8a838,stroke:#333,color:#fff
    style TokenReview fill:#f5a623,stroke:#333
    style SAR fill:#f5a623,stroke:#333
    style MetricsURL fill:#f5a623,stroke:#333
    style InferencePoolRes fill:#7ed321,stroke:#333
    style InferenceObjRes fill:#7ed321,stroke:#333
    style InferenceRewriteRes fill:#7ed321,stroke:#333
    style PodsRes fill:#7ed321,stroke:#333
    style LeasesRes fill:#7ed321,stroke:#333
    style TokenReviewRes fill:#7ed321,stroke:#333
    style SARRes fill:#7ed321,stroke:#333
