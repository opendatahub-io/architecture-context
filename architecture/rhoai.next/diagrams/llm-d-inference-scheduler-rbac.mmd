graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["${EPP_NAME}<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB["${EPP_NAME}-binding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        Role["${EPP_NAME}"]
    end

    subgraph APIResources["API Resources"]
        direction TB

        subgraph GIE_XK8s["inference.networking.x-k8s.io"]
            InferencePool_X["InferencePool"]
            InferenceObj_X["InferenceObjective"]
            InferenceRewrite_X["InferenceModelRewrite"]
        end

        subgraph GIE_K8s["inference.networking.k8s.io"]
            InferencePool_K["InferencePool"]
        end

        subgraph LLMD_AI["llm-d.ai"]
            InferenceObj_L["InferenceObjective"]
            InferenceRewrite_L["InferenceModelRewrite"]
        end

        subgraph Core["core (\"\")"]
            Pods["Pods"]
        end

        subgraph AuthN["authentication.k8s.io"]
            TokenReviews["TokenReviews"]
        end

        subgraph AuthZ["authorization.k8s.io"]
            SAR["SubjectAccessReviews"]
        end
    end

    %% Bindings
    SA -->|"bound via"| RB
    RB -->|"grants"| Role

    %% Permissions
    Role -->|"get, watch, list"| InferencePool_X
    Role -->|"get, watch, list"| InferenceObj_X
    Role -->|"get, watch, list"| InferenceRewrite_X
    Role -->|"get, watch, list"| InferencePool_K
    Role -->|"get, watch, list"| InferenceObj_L
    Role -->|"get, watch, list"| InferenceRewrite_L
    Role -->|"get, watch, list"| Pods
    Role -->|"create"| TokenReviews
    Role -->|"create"| SAR

    %% Styles
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#9b59b6,stroke:#333,color:#fff
    style Role fill:#f5a623,stroke:#333,color:#fff

    style InferencePool_X fill:#7ed321,stroke:#333,color:#fff
    style InferenceObj_X fill:#7ed321,stroke:#333,color:#fff
    style InferenceRewrite_X fill:#7ed321,stroke:#333,color:#fff
    style InferencePool_K fill:#7ed321,stroke:#333,color:#fff
    style InferenceObj_L fill:#7ed321,stroke:#333,color:#fff
    style InferenceRewrite_L fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style TokenReviews fill:#e74c3c,stroke:#333,color:#fff
    style SAR fill:#e74c3c,stroke:#333,color:#fff
