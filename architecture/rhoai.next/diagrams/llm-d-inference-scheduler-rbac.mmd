graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["llm-d-router<br/>(release namespace)"]
        AuthGroup["system:authenticated<br/>(Group - dev only)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB1["llm-d-router-sa<br/>RoleBinding"]
        RB2["llm-d-router-leader-election<br/>RoleBinding<br/>(when replicas > 1)"]
        CRB1["llm-d-router cluster RBAC<br/>ClusterRoleBinding<br/>(when monitoring enabled)"]
        RB3["exec-rolebinding<br/>RoleBinding<br/>(development only)"]
    end

    subgraph Roles["Roles"]
        R1["llm-d-router-sa<br/>Role (namespace)"]
        R2["llm-d-router-leader-election<br/>Role (namespace)"]
        CR1["llm-d-router cluster RBAC<br/>ClusterRole"]
        R3["exec-role<br/>Role (namespace)"]
    end

    subgraph PodAccess["Pod Access Resources"]
        Pods["core<br/>pods"]
    end

    subgraph LeaderElection["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>leases"]
        Events["core<br/>events"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    subgraph DevResources["Development Resources"]
        PodsExec["core<br/>pods/exec"]
    end

    %% Service Account bindings
    SA -->|bound via| RB1
    SA -->|bound via| RB2
    SA -->|bound via| CRB1
    AuthGroup -->|bound via| RB3

    %% Role binding to roles
    RB1 -->|grants| R1
    RB2 -->|grants| R2
    CRB1 -->|grants| CR1
    RB3 -->|grants| R3

    %% Role permissions
    R1 -->|"get, watch, list"| Pods
    R2 -->|"get, list, watch,<br/>create, update, patch, delete"| Leases
    R2 -->|"create, patch"| Events
    CR1 -->|"create"| TokenReviews
    CR1 -->|"create"| SAR
    CR1 -->|"get"| MetricsURL
    R3 -->|"create"| PodsExec

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style AuthGroup fill:#e57373,color:#fff
    style R1 fill:#f5a623,color:#fff
    style R2 fill:#f5a623,color:#fff
    style CR1 fill:#ff7043,color:#fff
    style R3 fill:#e57373,color:#fff
    style Pods fill:#7ed321,color:#fff
    style Leases fill:#7ed321,color:#fff
    style Events fill:#7ed321,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style MetricsURL fill:#7ed321,color:#fff
    style PodsExec fill:#e57373,color:#fff
