graph TD
    subgraph "Service Accounts (kubeflow-workspaces namespace)"
        SA_Controller["workspaces-controller<br/>ServiceAccount"]
        SA_Backend["workspaces-backend<br/>ServiceAccount"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Controller["workspaces-controller<br/>ClusterRoleBinding"]
        CRB_Backend["workspaces-backend<br/>ClusterRoleBinding"]
        RB_Leader["leader-election-rolebinding<br/>RoleBinding (namespaced)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["workspaces-manager-role<br/>ClusterRole"]
        CR_Backend["workspaces-backend<br/>ClusterRole"]
        CR_Leader["leader-election-role<br/>Role"]
    end

    subgraph "Kubeflow.org API Resources"
        Workspaces["kubeflow.org<br/>workspaces<br/>create, delete, get, list,<br/>patch, update, watch"]
        WorkspaceKinds["kubeflow.org<br/>workspacekinds<br/>create, delete, get, list,<br/>patch, update, watch"]
        WS_Status["kubeflow.org<br/>workspaces/status<br/>workspacekinds/status<br/>get, patch, update"]
        WS_Finalizers["kubeflow.org<br/>workspaces/finalizers<br/>workspacekinds/finalizers<br/>update"]
    end

    subgraph "Core API Resources"
        CoreRead["core<br/>configmaps, events, pods<br/>get, list, watch"]
        Services["core<br/>services<br/>create, delete, get, list,<br/>patch, update, watch"]
        Secrets["core<br/>secrets<br/>get, list, watch,<br/>create, update, delete"]
        Namespaces["core<br/>namespaces<br/>get, list, watch"]
        PVCs["core<br/>persistentvolumeclaims<br/>get, list, watch, create, delete"]
        PVs["core<br/>persistentvolumes<br/>get, list, watch"]
    end

    subgraph "Extended API Resources"
        StatefulSets["apps<br/>statefulsets<br/>create, delete, get, list,<br/>patch, update, watch"]
        VirtualServices["networking.istio.io<br/>virtualservices<br/>create, delete, get, list,<br/>patch, update, watch"]
        StorageClasses["storage.k8s.io<br/>storageclasses<br/>get, list, watch"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph "Aggregated Roles (Kubeflow RBAC)"
        CR_Admin["kubeflow-workspaces-admin<br/>(aggregated)"]
        CR_Edit["kubeflow-workspaces-edit<br/>(aggregated)"]
        CR_View["kubeflow-workspaces-view<br/>workspaces, workspaces/status<br/>get, list, watch"]
    end

    %% Controller bindings
    SA_Controller -->|bound via| CRB_Controller
    CRB_Controller -->|grants| CR_Manager
    SA_Controller -->|bound via| RB_Leader
    RB_Leader -->|grants| CR_Leader

    %% Controller permissions
    CR_Manager -->|full CRUD| Workspaces
    CR_Manager -->|full CRUD| WorkspaceKinds
    CR_Manager -->|status ops| WS_Status
    CR_Manager -->|finalizer ops| WS_Finalizers
    CR_Manager -->|read-only| CoreRead
    CR_Manager -->|full CRUD| Services
    CR_Manager -->|full CRUD| StatefulSets
    CR_Manager -->|full CRUD| VirtualServices

    %% Backend bindings
    SA_Backend -->|bound via| CRB_Backend
    CRB_Backend -->|grants| CR_Backend

    %% Backend permissions
    CR_Backend -->|full CRUD| Workspaces
    CR_Backend -->|full CRUD| WorkspaceKinds
    CR_Backend -->|read-only| Namespaces
    CR_Backend -->|read-only| CoreRead
    CR_Backend -->|CRUD| Secrets
    CR_Backend -->|CRUD| PVCs
    CR_Backend -->|read-only| PVs
    CR_Backend -->|read-only| StorageClasses
    CR_Backend -->|create| SAR

    %% Aggregated role hierarchy
    CR_Admin -.->|aggregates| CR_Edit
    CR_Edit -.->|aggregates| CR_View

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_Backend fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#000
    style CR_Backend fill:#f5a623,color:#000
    style CR_Leader fill:#f5a623,color:#000
    style CR_Admin fill:#d4a5f5,color:#000
    style CR_Edit fill:#d4a5f5,color:#000
    style CR_View fill:#d4a5f5,color:#000
    style Workspaces fill:#7ed321,color:#000
    style WorkspaceKinds fill:#7ed321,color:#000
    style WS_Status fill:#7ed321,color:#000
    style WS_Finalizers fill:#7ed321,color:#000
    style CoreRead fill:#7ed321,color:#000
    style Services fill:#7ed321,color:#000
    style Secrets fill:#7ed321,color:#000
    style Namespaces fill:#7ed321,color:#000
    style PVCs fill:#7ed321,color:#000
    style PVs fill:#7ed321,color:#000
    style StatefulSets fill:#7ed321,color:#000
    style VirtualServices fill:#7ed321,color:#000
    style StorageClasses fill:#7ed321,color:#000
    style SAR fill:#7ed321,color:#000
