graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["workspaces-controller"]
        SA_Backend["workspaces-backend"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Controller["workspaces-manager-rolebinding<br/>(cluster-scoped)"]
        CRB_Backend["workspaces-backend<br/>(cluster-scoped)"]
    end

    subgraph ControllerRole["ClusterRole: workspaces-manager-role"]
        CR_Workspaces["kubeflow.org<br/>workspaces, workspacekinds<br/>+finalizers, +status"]
        CR_Core_RO["core<br/>configmaps, events,<br/>namespaces, pods"]
        CR_PodExec["core<br/>pods/exec"]
        CR_Core_RW["core<br/>serviceaccounts, services"]
        CR_Apps["apps<br/>statefulsets"]
        CR_Auth["authentication.k8s.io<br/>tokenreviews"]
        CR_Authz["authorization.k8s.io<br/>subjectaccessreviews"]
        CR_Istio["networking.istio.io<br/>virtualservices"]
        CR_RBAC["rbac.authorization.k8s.io<br/>clusterroles, rolebindings"]
    end

    subgraph BackendRole["ClusterRole: workspaces-backend"]
        BE_Workspaces["kubeflow.org<br/>workspaces, workspacekinds"]
        BE_NS["core<br/>namespaces, configmaps"]
        BE_Secrets["core<br/>secrets"]
        BE_Pods["core<br/>pods, pods/log"]
        BE_PVCs["core<br/>persistentvolumeclaims,<br/>persistentvolumes"]
        BE_Storage["storage.k8s.io<br/>storageclasses"]
        BE_Metrics["metrics.k8s.io<br/>pods"]
        BE_SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph UserRoles["User-Facing Aggregated Roles"]
        Admin["kubeflow-workspaces-admin<br/>WorkspaceKind CRUD"]
        Edit["kubeflow-workspaces-edit<br/>Workspace CRUD"]
        View["kubeflow-workspaces-view<br/>Workspace read-only"]
    end

    SA_Controller -->|bound via| CRB_Controller
    SA_Backend -->|bound via| CRB_Backend

    CRB_Controller -->|grants| CR_Workspaces
    CRB_Controller -->|grants| CR_Core_RO
    CRB_Controller -->|grants| CR_PodExec
    CRB_Controller -->|grants| CR_Core_RW
    CRB_Controller -->|grants| CR_Apps
    CRB_Controller -->|grants| CR_Auth
    CRB_Controller -->|grants| CR_Authz
    CRB_Controller -->|grants| CR_Istio
    CRB_Controller -->|grants| CR_RBAC

    CRB_Backend -->|grants| BE_Workspaces
    CRB_Backend -->|grants| BE_NS
    CRB_Backend -->|grants| BE_Secrets
    CRB_Backend -->|grants| BE_Pods
    CRB_Backend -->|grants| BE_PVCs
    CRB_Backend -->|grants| BE_Storage
    CRB_Backend -->|grants| BE_Metrics
    CRB_Backend -->|grants| BE_SAR

    CR_Workspaces ---|"create,delete,get,list,<br/>patch,update,watch"| CR_Workspaces
    CR_Core_RO ---|"get,list,watch"| CR_Core_RO
    CR_PodExec ---|"create"| CR_PodExec
    CR_Core_RW ---|"create,delete,get,list,<br/>patch,update,watch"| CR_Core_RW
    CR_Apps ---|"create,delete,get,list,<br/>patch,update,watch"| CR_Apps

    style SA_Controller fill:#4a90e2,color:#fff
