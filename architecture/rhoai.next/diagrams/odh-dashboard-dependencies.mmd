graph LR
    Dashboard["ODH Dashboard<br/>(Frontend + BFF Monorepo)"]

    %% Build / Runtime Dependencies
    subgraph BuildDeps["Build & Runtime"]
        NodeJS["Node.js 22+"]
        Go["Go 1.25-1.26"]
        PatternFly["PatternFly 6.3-6.4"]
        React["React 18.3.1"]
        Webpack["Webpack 5.104<br/>+ Module Federation"]
        Fastify["Fastify 4.29"]
        ControllerRT["controller-runtime"]
    end

    Dashboard -->|"runtime"| NodeJS
    Dashboard -->|"compilation"| Go
    Dashboard -->|"UI design system"| PatternFly
    Dashboard -->|"frontend framework"| React
    Dashboard -->|"build + federation"| Webpack
    Dashboard -->|"HTTP framework"| Fastify
    Dashboard -->|"operator framework"| ControllerRT

    %% Platform Dependencies (Internal RHOAI)
    subgraph PlatformDeps["Internal RHOAI Components"]
        Operator["rhods-operator<br/>(creates Dashboard CR)"]
        K8sAPI["Kubernetes API<br/>Server"]
        KRBP["kube-rbac-proxy<br/>(auth sidecar)"]
        GatewayAPI["Platform Gateway<br/>(HTTPRoute ingress)"]
        DSC["DataScienceCluster<br/>(component enablement)"]
        KServe["KServe<br/>(InferenceService)"]
        ModelReg["Model Registry<br/>(model catalog)"]
        KFPipelines["Kubeflow Pipelines<br/>(ML workflows)"]
        MLflowSrv["MLflow Server<br/>(experiment tracking)"]
        TrustyAI["TrustyAI<br/>(bias metrics)"]
        Kueue["Kueue<br/>(workload queuing)"]
        Feast["Feast<br/>(feature store)"]
        Notebooks["Kubeflow Notebooks<br/>(notebook lifecycle)"]
        Thanos["Thanos Querier<br/>(metrics)"]
        Perses["Perses<br/>(observability dashboards)"]
    end

    Operator -->|"CRD: Dashboard CR"| Dashboard
    Dashboard -->|"REST API / WebSocket<br/>6443/TCP"| K8sAPI
    Dashboard -->|"auth sidecar<br/>8443/TCP"| KRBP
    Dashboard -->|"HTTPRoute<br/>443/TCP"| GatewayAPI
    Dashboard -->|"CRD Watch"| DSC
    Dashboard -->|"CRD Watch<br/>InferenceService"| KServe
    Dashboard -->|"REST + CRD<br/>8080/TCP"| ModelReg
    Dashboard -->|"REST API"| KFPipelines
    Dashboard -->|"REST API"| MLflowSrv
    Dashboard -->|"REST API<br/>8080/TCP"| TrustyAI
    Dashboard -->|"CRD Watch"| Kueue
    Dashboard -->|"CRD Watch<br/>FeatureStore"| Feast
    Dashboard -->|"CRD CRUD"| Notebooks
    Dashboard -->|"REST API<br/>9092/TCP"| Thanos
    Dashboard -->|"REST API proxy<br/>8080/TCP"| Perses

    %% External Services
    subgraph ExtSvcs["External Services"]
        LlamaStack["Llama Stack<br/>(LLM inference)"]
        NeMo["NeMo Guardrails<br/>(content moderation)"]
        S3["S3 Storage<br/>(object storage)"]
        OpenAI["OpenAI API<br/>(fallback LLM)"]
        OGX["OGX<br/>(RAG optimization)"]
        MCP["MCP Servers<br/>(tool protocol)"]
        EvalAPI["EvalHub API<br/>(eval jobs)"]
        PGVector["pgvector/PostgreSQL<br/>(vector store)"]
        NIM["NVIDIA NIM<br/>(model serving)"]
    end

    Dashboard -->|"HTTPS/443<br/>gen-ai module"| LlamaStack
    Dashboard -->|"HTTPS/443<br/>gen-ai module"| NeMo
    Dashboard -->|"HTTPS/443<br/>automl/autorag"| S3
    Dashboard -->|"HTTPS/443<br/>gen-ai fallback"| OpenAI
    Dashboard -->|"HTTPS/443<br/>autorag module"| OGX
    Dashboard -->|"HTTPS/various<br/>gen-ai module"| MCP
    Dashboard -->|"HTTPS/443<br/>eval-hub module"| EvalAPI
    Dashboard -->|"TCP/5432<br/>gen-ai RAG"| PGVector
    Dashboard -.->|"HTTPS/various"| NIM

    %% Integration (consumers of Dashboard)
    subgraph Consumers["Components That Consume Dashboard"]
        Console["OpenShift Console<br/>(ConsoleLink)"]
        OLM["OLM<br/>(Subscription/CSV)"]
    end

    Dashboard -->|"ConsoleLink"| Console
    Dashboard -->|"CRD Watch"| OLM

