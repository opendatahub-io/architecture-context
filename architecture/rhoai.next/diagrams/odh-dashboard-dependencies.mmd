graph LR
    Dashboard["ODH Dashboard<br/>(Frontend + BFF Monorepo)"]

    %% External Dependencies (Build/Runtime)
    Dashboard -->|"runtime"| NodeJS["Node.js 22+"]
    Dashboard -->|"runtime"| Go["Go 1.25-1.26"]
    Dashboard -->|"UI framework"| React["React 18.3"]
    Dashboard -->|"UI components"| PatternFly["PatternFly 6.4"]
    Dashboard -->|"module loading"| ModFed["Webpack Module<br/>Federation 5.x"]
    Dashboard -->|"operator framework"| CtrlRuntime["controller-runtime<br/>0.20+"]
    Dashboard -->|"K8s client"| K8sClient["@kubernetes/<br/>client-node 0.12"]
    Dashboard -->|"build orchestration"| Turbo["turbo 2.9"]
    Dashboard -->|"auth sidecar"| KubeRBAC["kube-rbac-proxy"]

    %% Internal Platform Dependencies
    Dashboard -->|"Dashboard CR lifecycle"| RhodsOp["rhods-operator /<br/>opendatahub-operator"]
    Dashboard -->|"K8s API proxy<br/>(user impersonation)"| K8sAPI["Kubernetes<br/>API Server"]
    Dashboard -->|"module enablement"| DSC["DataScienceCluster<br/>(CRD Watch)"]
    Dashboard -->|"platform init status"| DSCI["DSCInitialization<br/>(CRD Watch)"]
    Dashboard -->|"primary ingress<br/>HTTPRoute"| GatewayAPI["Gateway API<br/>(data-science-gateway)"]
    Dashboard -->|"model serving<br/>(InferenceService, ServingRuntime)"| KServe["KServe"]
    Dashboard -->|"model registry<br/>(ModelRegistry CR)"| ModelReg["Model Registry<br/>Operator"]
    Dashboard -->|"MLflow discovery<br/>(MLflow CR)"| MLflowOp["MLflow Operator"]
    Dashboard -->|"evaluation hub<br/>(EvalHub CR)"| TrustyAI["TrustyAI<br/>Operator"]
    Dashboard -->|"notebook lifecycle<br/>(Notebook CR)"| Notebooks["Kubeflow<br/>Notebooks"]
    Dashboard -->|"NIM integration<br/>(Account CR)"| NIM["NIM Operator"]
    Dashboard -->|"feature discovery<br/>(FeatureStore CR)"| Feast["Feast"]
    Dashboard -->|"sandbox + MCP<br/>(Sandbox, McpServerReg)"| AgentOps["Agent Ops"]
    Dashboard -->|"OTel collectors<br/>(LLM tracing)"| OTelOp["OpenTelemetry<br/>Operator"]
    Dashboard -->|"observability dashboards<br/>(PersesDashboard CR)"| Perses["Perses (COO)"]
    Dashboard -->|"metrics queries"| Prometheus["Prometheus"]
    Dashboard -->|"Perses API proxy"| PersesAPI["data-science-perses"]

    %% Reverse dependencies (who depends on Dashboard)
    RhodsOp -.->|"creates Dashboard CR"| Dashboard
    OpenShiftConsole -.->|"ConsoleLink"| Dashboard
    OpenShiftConsole["OpenShift Console"]

    %% External Services
    Dashboard -->|"MaaS endpoints<br/>MLflow servers"| ExtServices["External HTTPS<br/>Services"]

