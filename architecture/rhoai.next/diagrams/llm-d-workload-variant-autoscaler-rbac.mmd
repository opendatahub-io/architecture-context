graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["controller-manager<br/>(wva-system namespace)"]
        SA_Prometheus["Prometheus SA<br/>(or controller-manager on OpenShift)"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(cluster-wide)"]
        CRB_MetricsReader["metrics-reader-rolebinding<br/>(cluster-wide)"]
        CRB_MetricsAuth["metrics-auth-rolebinding<br/>(cluster-wide)"]
        CRB_EPP["epp-metrics-reader-rolebinding<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_LeaderElection["leader-election-rolebinding<br/>(system namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_MetricsReader["metrics-reader"]
        CR_MetricsAuth["metrics-auth"]
        CR_EPPReader["epp-metrics-reader"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_LeaderElection["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources (read-only)"]
        ConfigMaps["core<br/>configmaps<br/>get, list, watch"]
        ConfigMapsStatus["core<br/>configmaps/status<br/>get"]
        Namespaces["core<br/>namespaces<br/>get, list, watch"]
        Nodes["core<br/>nodes, nodes/status<br/>get, list, watch"]
        Pods["core<br/>pods<br/>get, list, watch"]
        ResourceQuotas["core<br/>resourcequotas<br/>get, list, watch"]
        Services["core<br/>services<br/>get, list, watch"]
    end

    subgraph CoreWrite["Core API Resources (write)"]
        Events["core<br/>events<br/>create, patch"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps<br/>deployments<br/>get, list, patch,<br/>update, watch"]
        DeploymentsScale["apps<br/>deployments/scale<br/>get, update"]
        ReplicaSets["apps<br/>replicasets, statefulsets<br/>get, list, watch"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPAs["autoscaling<br/>horizontalpodautoscalers<br/>get, list, patch,<br/>update, watch"]
    end

    subgraph InferenceResources["Inference API Resources"]
        InferencePools["inference.networking.k8s.io<br/>inference.networking.x-k8s.io<br/>inferencepools<br/>get, list, watch"]
    end

    subgraph KEDAResources["KEDA Resources (conditional)"]
        ScaledObjects["keda.sh<br/>scaledobjects<br/>get, list, patch,<br/>update, watch"]
    end

    subgraph LWSResources["LeaderWorkerSet Resources (conditional)"]
        LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>get, list, patch,<br/>update, watch"]
        LWSScale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale<br/>get, update"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors<br/>get, list, watch"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    %% SA → Binding → Role flows
    SA_Controller -->|"bound via"| CRB_Manager
    SA_Controller -->|"bound via"| CRB_MetricsAuth
    SA_Controller -->|"bound via"| RB_LeaderElection
    SA_Prometheus -->|"bound via"| CRB_MetricsReader
    SA_EPP -->|"bound via"| CRB_EPP

    %% Binding → Role
    CRB_Manager -->|"grants"| CR_Manager
    CRB_MetricsReader -->|"grants"| CR_MetricsReader
    CRB_MetricsAuth -->|"grants"| CR_MetricsAuth
    CRB_EPP -->|"grants"| CR_EPPReader
    RB_LeaderElection -->|"grants"| R_LeaderElection

    %% Role → Resources
    CR_Manager --> ConfigMaps
    CR_Manager --> ConfigMapsStatus
    CR_Manager --> Namespaces
    CR_Manager --> Nodes
    CR_Manager --> Pods
    CR_Manager --> ResourceQuotas
    CR_Manager --> Services
    CR_Manager --> Events
    CR_Manager --> Deployments
    CR_Manager --> DeploymentsScale
    CR_Manager --> ReplicaSets
    CR_Manager --> HPAs
    CR_Manager --> InferencePools
    CR_Manager --> ScaledObjects
    CR_Manager --> LWS
    CR_Manager --> LWSScale
    CR_Manager --> ServiceMonitors

    CR_MetricsAuth --> TokenReviews
    CR_MetricsAuth --> SAR

