graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_EPP["epp-metrics-reader"]
        SA_Prom["Prometheus SA"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(cluster-wide)"]
        CRB_Metrics["metrics-reader-rolebinding<br/>(cluster-wide)"]
        CRB_Auth["metrics-auth-rolebinding<br/>(cluster-wide)"]
        CRB_EPP["epp-metrics-reader-rolebinding<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(system namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_Reader["metrics-reader"]
        CR_Auth["metrics-auth"]
        CR_EPP["epp-metrics-reader"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph ManagerResources["manager-role Resources"]
        Core_RO["core: configmaps, namespaces,<br/>nodes, nodes/status, pods,<br/>resourcequotas, services<br/>→ get, list, watch"]
        Core_CM["core: configmaps/status<br/>→ get"]
        Core_Events["core: events<br/>→ create, patch"]
        Apps_Deploy["apps: deployments<br/>→ get, list, patch, update, watch"]
        Apps_Scale["apps: deployments/scale<br/>→ get, update"]
        Apps_RO["apps: replicasets, statefulsets<br/>→ get, list, watch"]
        Autoscaling["autoscaling:<br/>horizontalpodautoscalers<br/>→ get, list, patch, update, watch"]
        InferencePool["inference.networking.k8s.io:<br/>inferencepools<br/>→ get, list, watch"]
        KEDASOs["keda.sh: scaledobjects<br/>→ get, list, patch, update, watch"]
        LWSAPI["leaderworkerset.x-k8s.io:<br/>leaderworkersets + /scale<br/>→ get, list, patch, update, watch"]
        Monitoring["monitoring.coreos.com:<br/>servicemonitors<br/>→ get, list, watch"]
    end

    subgraph AuthResources["metrics-auth Resources"]
        TokenReview["authentication.k8s.io:<br/>tokenreviews → create"]
        SAR["authorization.k8s.io:<br/>subjectaccessreviews → create"]
    end

    %% Bindings
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Auth
    SA_CM -->|bound via| RB_Leader
    SA_Prom -->|bound via| CRB_Metrics
    SA_EPP -->|bound via| CRB_EPP

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Reader
    CRB_Auth -->|grants| CR_Auth
    CRB_EPP -->|grants| CR_EPP
    RB_Leader -->|grants| R_Leader

    %% Resource access
    CR_Manager -->|access| Core_RO
    CR_Manager -->|access| Core_CM
    CR_Manager -->|access| Core_Events
    CR_Manager -->|access| Apps_Deploy
    CR_Manager -->|access| Apps_Scale
    CR_Manager -->|access| Apps_RO
    CR_Manager -->|access| Autoscaling
    CR_Manager -->|access| InferencePool
    CR_Manager -->|access| KEDASOs
    CR_Manager -->|access| LWSAPI
    CR_Manager -->|access| Monitoring

    CR_Auth -->|access| TokenReview
    CR_Auth -->|access| SAR

