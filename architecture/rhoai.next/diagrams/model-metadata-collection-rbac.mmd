graph TD
    subgraph "model-metadata-collection RBAC"
        direction TB

        Note["This component is a data container,<br/>NOT a Kubernetes controller.<br/>No RBAC roles or bindings are defined."]

        subgraph "CI/CD Secrets (Build-Time Only)"
            HFToken["HF_TOKEN<br/>Type: Opaque (env var)<br/>Purpose: HuggingFace API auth<br/>Required: No (optional enrichment)<br/>Provisioned: Manual (.env or CI secret)<br/>Auto-Rotate: No"]
            GitHubToken["GITHUB_TOKEN<br/>Type: Opaque (env var)<br/>Purpose: GitHub API auth<br/>Required: No (optional enrichment)<br/>Provisioned: Manual (CI secret)<br/>Auto-Rotate: No"]
            GitAuthSecret["git_auth_secret<br/>Type: kubernetes.io/basic-auth<br/>Purpose: Tekton PipelineRun git auth<br/>Required: Yes (for Konflux builds)<br/>Provisioned: Konflux/PipelinesAsCode<br/>Auto-Rotate: No"]
        end

        subgraph "Runtime Container"
            DataContainer["Data Container Image<br/>UBI9-minimal<br/>No ServiceAccount escalation<br/>No RBAC requirements<br/>No secrets at runtime<br/>sleep infinity"]
        end
    end

    HFToken -.->|"used during<br/>CI/CD only"| DataContainer
    GitHubToken -.->|"used during<br/>CI/CD only"| DataContainer
    GitAuthSecret -.->|"used during<br/>Konflux build only"| DataContainer

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style HFToken fill:#f8d7da,stroke:#721c24
    style GitHubToken fill:#f8d7da,stroke:#721c24
    style GitAuthSecret fill:#f8d7da,stroke:#721c24
