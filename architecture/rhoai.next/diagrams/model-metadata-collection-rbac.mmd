graph TD
    subgraph RuntimeContainer["Data Container (Runtime)"]
        Container["model-metadata-collection<br/>UID: 1001 (non-root)<br/>CMD: sleep infinity"]
    end

    subgraph NoRBAC["No RBAC Required"]
