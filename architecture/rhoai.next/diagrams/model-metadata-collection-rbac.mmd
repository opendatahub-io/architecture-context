        DockerAuth["Docker Auth<br/>Type: ~/.docker/config.json<br/>Purpose: Registry access<br/>Required: Yes"]
    end

    Container -.->|"no API access needed"| NoRBAC
    HFToken -.->|"not shipped in image"| Container
    GHToken -.->|"not shipped in image"| Container
    DockerAuth -.->|"not shipped in image"| Container

    style Container fill:#4a90e2,color:#fff
