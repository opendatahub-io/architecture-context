graph TD
    subgraph "Note: No Kubernetes RBAC"
        NoRBAC["This is a container image,<br/>not a Kubernetes operator.<br/>No ClusterRoles, Roles,<br/>or RoleBindings defined."]
    end

    subgraph "Application-Level Authorization (OAuth2 JWT)"
        direction TB

        AuthMiddleware["OGX Auth Middleware<br/>(enabled when AUTH_ISSUER is set)"]

        subgraph "Auth Configuration"
            AuthIssuer["AUTH_ISSUER<br/>(enables auth)"]
            AuthAudience["AUTH_AUDIENCE<br/>(default: ogx)"]
            AuthJWKS["AUTH_JWKS_URI<br/>(key retrieval)"]
            AuthTLS["AUTH_VERIFY_TLS<br/>(default: true)"]
            AuthRecheck["AUTH_JWKS_RECHECK_PERIOD<br/>(default: 3600s)"]
        end

        subgraph "Authorization Policies"
            ReadPolicy["Read System Resources<br/>GET on unowned resources<br/>Permit: all authenticated users"]
            CreatePolicy["Create Resources<br/>POST<br/>Permit: authenticated users"]
            ManagePolicy["Manage Owned Resources<br/>GET/PUT/DELETE<br/>Permit: resource owner only"]
        end

        AuthIssuer -->|"activates"| AuthMiddleware
        AuthAudience -->|"configures"| AuthMiddleware
        AuthJWKS -->|"key source"| AuthMiddleware
        AuthTLS -->|"TLS verify"| AuthMiddleware
        AuthRecheck -->|"recheck interval"| AuthMiddleware

        AuthMiddleware -->|"enforces"| ReadPolicy
        AuthMiddleware -->|"enforces"| CreatePolicy
        AuthMiddleware -->|"enforces"| ManagePolicy
    end

    subgraph "Secret Management (18 env vars with _FILE support)"
        direction TB
        ProviderKeys["Provider API Keys<br/>OPENAI_API_KEY<br/>ANTHROPIC_API_KEY<br/>GEMINI_API_KEY<br/>AZURE_OPENAI_API_KEY<br/>WATSONX_API_KEY"]
        SearchKeys["Search API Keys<br/>BRAVE_SEARCH_API_KEY<br/>TAVILY_SEARCH_API_KEY"]
        StorageKeys["Storage Credentials<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>POSTGRES_PASSWORD<br/>PGVECTOR_PASSWORD<br/>MILVUS_TOKEN<br/>QDRANT_API_KEY"]
        FileMount["_FILE Variant Resolution<br/>entrypoint.sh reads mounted files<br/>Prevents /proc/1/environ exposure"]
    end

    ProviderKeys -->|"resolved via"| FileMount
    SearchKeys -->|"resolved via"| FileMount
    StorageKeys -->|"resolved via"| FileMount

    style NoRBAC fill:#fff3cd,stroke:#856404,stroke-width:2px,color:#856404
    style AuthMiddleware fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ReadPolicy fill:#d4edda,stroke:#155724,stroke-width:1px
    style CreatePolicy fill:#d4edda,stroke:#155724,stroke-width:1px
    style ManagePolicy fill:#f8d7da,stroke:#721c24,stroke-width:1px
    style FileMount fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
