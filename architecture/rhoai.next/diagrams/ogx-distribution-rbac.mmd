graph TD
    subgraph PlatformManaged["Platform-Managed RBAC (rhods-operator)"]
        Note1["No Kubernetes RBAC defined<br/>in this repository.<br/>RBAC is managed by<br/>rhods-operator."]
    end

    subgraph ApplicationAuth["Application-Level Access Control"]
        direction TB

        subgraph AuthConfig["OAuth2/JWT Configuration"]
            AuthIssuer["AUTH_ISSUER<br/>(enables auth when set)"]
            AuthAudience["AUTH_AUDIENCE<br/>(default: 'ogx')"]
            AuthJWKS["AUTH_JWKS_URI<br/>(JWKS endpoint)"]
        end

        subgraph AccessPolicy["Ownership-Based Access Policy"]
            ReadUnowned["Read Unowned Resources<br/>(system models, tool groups)<br/>→ All authenticated users"]
            CreateAny["Create Resources<br/>(files, vector stores, etc.)<br/>→ Authenticated users"]
            ManageOwn["Update/Delete Own Resources<br/>→ Owner only"]
        end

        AuthIssuer -->|enables| AccessPolicy
    end

    subgraph Secrets["Secrets (18 vars with _FILE support)"]
        direction TB

        subgraph InferenceSecrets["Inference Provider Keys"]
            VLLM_TOKEN["VLLM_API_TOKEN"]
            VLLM_EMB_TOKEN["VLLM_EMBEDDING_API_TOKEN"]
            OPENAI_KEY["OPENAI_API_KEY"]
            ANTHROPIC_KEY["ANTHROPIC_API_KEY"]
            AZURE_KEY["AZURE_API_KEY"]
            GEMINI_KEY["GEMINI_API_KEY"]
            GEMINI_TOKEN["GEMINI_ACCESS_TOKEN"]
            WATSONX_KEY["WATSONX_API_KEY"]
            BEDROCK_TOKEN["AWS_BEDROCK_BEARER_TOKEN"]
        end

        subgraph AWSSecrets["AWS Credentials"]
            AWS_AK["AWS_ACCESS_KEY_ID"]
            AWS_SK["AWS_SECRET_ACCESS_KEY"]
        end

        subgraph StorageSecrets["Storage Credentials"]
            PG_PASS["POSTGRES_PASSWORD"]
            PGV_PASS["PGVECTOR_PASSWORD"]
            MILVUS_TK["MILVUS_TOKEN"]
            QDRANT_KEY["QDRANT_API_KEY"]
        end

        subgraph ToolSecrets["Tool Provider Keys"]
            BRAVE_KEY["BRAVE_SEARCH_API_KEY"]
            TAVILY_KEY["TAVILY_SEARCH_API_KEY"]
            DOCLING_KEY["DOCLING_SERVE_API_KEY"]
        end
    end

    subgraph SecretMounting["Secret Injection Mechanisms"]
        EnvVar["Environment Variables<br/>(direct injection)"]
        FileMounting["_FILE-suffixed Variables<br/>(Kubernetes secret mount)<br/>Entrypoint resolves at startup"]
    end

    Secrets --> EnvVar
    Secrets --> FileMounting

    subgraph Endpoints["API Endpoint Auth Matrix"]
        direction TB
        HealthEP["/v1/health<br/>GET → No Auth"]
        ModelsEP["/v1/models<br/>GET → OAuth2 JWT (conditional)"]
        ChatEP["/v1/chat/completions<br/>POST → OAuth2 JWT (conditional)"]
        MessagesEP["/v1/messages<br/>POST → OAuth2 JWT (conditional)"]
        ResponsesEP["/v1/responses<br/>POST → OAuth2 JWT (conditional)"]
        FilesEP["/v1/files<br/>POST/GET → OAuth2 JWT (conditional)"]
        VectorEP["/v1/vector_stores<br/>POST/GET → OAuth2 JWT (conditional)"]
        EmbedEP["/v1/embeddings<br/>POST → OAuth2 JWT (conditional)"]
    end

    AccessPolicy --> Endpoints

