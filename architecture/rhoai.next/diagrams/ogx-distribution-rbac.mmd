graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["Solid = Required"]
        L2["Dashed = Optional"]
    end

    subgraph AppAuth["Application-Level Auth (OAuth2 JWT)"]
        direction TB
        AuthIssuer["OAuth2/OIDC Issuer<br/>(AUTH_ISSUER)"]
        JWKSEndpoint["JWKS Endpoint<br/>(AUTH_JWKS_URI)<br/>Recheck: 3600s"]
        AuthMiddleware["OGX Auth Middleware<br/>JWT Validation"]

        AuthIssuer -->|"issues tokens"| JWKSEndpoint
        JWKSEndpoint -->|"provides signing keys"| AuthMiddleware
    end

    subgraph AccessPolicy["Access Policy Engine"]
        direction TB
        ReadUnowned["Read Unowned Resources<br/>All authenticated users"]
        CreateResource["Create Resources<br/>All authenticated users"]
        ManageOwned["Read/Update/Delete Owned<br/>Owner only"]
    end

    subgraph APIEndpoints["API Endpoints"]
        direction TB
        HealthEndpoint["/v1/health<br/>Auth: None<br/>Always accessible"]
        MetricsEndpoint["/metrics<br/>Auth: None<br/>Always accessible"]
        ProtectedEndpoints["/v1/* (all other routes)<br/>Auth: OAuth2 JWT<br/>(when AUTH_ISSUER set)"]
    end

    AuthMiddleware -->|"validates JWT"| ProtectedEndpoints
    ProtectedEndpoints -->|"identity extracted"| ReadUnowned
    ProtectedEndpoints -->|"identity extracted"| CreateResource
    ProtectedEndpoints -->|"owner check"| ManageOwned

    subgraph K8sRBAC["Kubernetes RBAC"]
        direction TB
        NoRBAC["No RBAC resources defined<br/>by this component"]
        OperatorManaged["RBAC managed by<br/>ogx-operator"]
    end

    subgraph SecretAccess["Secret Access (18 env vars with _FILE support)"]
        direction TB
        InferenceSecrets["Inference Provider Secrets<br/>ANTHROPIC_API_KEY, OPENAI_API_KEY,<br/>AZURE_API_KEY, WATSONX_API_KEY,<br/>VLLM_API_TOKEN, VLLM_EMBEDDING_API_TOKEN,<br/>AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,<br/>AWS_BEDROCK_BEARER_TOKEN,<br/>GEMINI_API_KEY, GEMINI_ACCESS_TOKEN"]
        StorageSecrets["Storage Secrets<br/>POSTGRES_PASSWORD, PGVECTOR_PASSWORD,<br/>MILVUS_TOKEN, QDRANT_API_KEY"]
        ToolSecrets["Tool & Service Secrets<br/>BRAVE_SEARCH_API_KEY, TAVILY_SEARCH_API_KEY,<br/>DOCLING_SERVE_API_KEY"]
    end

    subgraph Entrypoint["entrypoint.sh — Secret Resolution"]
        FileMount["_FILE variant detection<br/>Reads secret from mounted file<br/>Avoids /proc/1/environ exposure"]
    end

    FileMount -->|"resolves"| InferenceSecrets
    FileMount -->|"resolves"| StorageSecrets
    FileMount -->|"resolves"| ToolSecrets

    style AuthMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style ReadUnowned fill:#7ed321,stroke:#333,color:#fff
    style CreateResource fill:#7ed321,stroke:#333,color:#fff
    style ManageOwned fill:#f5a623,stroke:#333,color:#fff
    style HealthEndpoint fill:#d5e8d4,stroke:#82b366
    style MetricsEndpoint fill:#d5e8d4,stroke:#82b366
    style ProtectedEndpoints fill:#dae8fc,stroke:#6c8ebf
    style NoRBAC fill:#f9f9f9,stroke:#999
    style OperatorManaged fill:#f9f9f9,stroke:#999
    style FileMount fill:#e1d5e7,stroke:#9673a6
