graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph GatewayZone["GATEWAY (Data Plane)"]
        Gateway["Envoy Gateway<br/>443/TCP HTTPS<br/>HTTPRoute → InferencePool backendRef"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (ClusterIP)"]
        direction TB

        subgraph NS_BBR["BBR Deployment"]
            BBR["BBR — Body Based Router<br/>SA: default<br/>9004/TCP gRPC TLS (self-signed)<br/>9005/TCP gRPC health"]
        end

        subgraph NS_EPP["EPP Deployment (per InferencePool)"]
            EPP["EPP — Endpoint Picker<br/>SA: default<br/>9002/TCP gRPC TLS<br/>9003/TCP gRPC health<br/>9090/TCP HTTP metrics"]
            LatencyPredictor["Latency Predictor (sidecar)<br/>8000/TCP training<br/>8001/TCP prediction<br/>No TLS"]
        end

        subgraph NS_Models["Model Server Pods"]
            ModelServer["Model Servers<br/>(vLLM, SGLang)<br/>Prometheus /metrics"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>No encryption"]
        Prometheus["Prometheus<br/>Scrapes 9090/TCP<br/>Optional SA token auth"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS<br/>Gateway-dependent auth"| Gateway
    Gateway -->|"gRPC/9004<br/>TLS (self-signed)<br/>No auth"| BBR
    Gateway -->|"gRPC/9002<br/>TLS (self-signed or cert)<br/>No auth"| EPP
    Gateway -->|"HTTP (forwarded request)<br/>to selected pod"| ModelServer
    EPP -->|"HTTP(S)/configurable<br/>InsecureSkipVerify=true<br/>Metrics scrape"| ModelServer
    LatencyPredictor -.->|"HTTP/8001<br/>No TLS"| EPP
    EPP -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    BBR -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    EPP -.->|"gRPC/4317<br/>No encryption"| OTLP
    Prometheus -.->|"HTTP/9090<br/>Optional auth"| EPP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway gateway
    class BBR,EPP,LatencyPredictor,ModelServer internal
    class K8sAPI controlplane
    class OTLP,Prometheus externalservice
