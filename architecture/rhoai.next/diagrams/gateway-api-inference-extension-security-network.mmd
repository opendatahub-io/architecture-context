graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Gateway (Istio / GKE)<br/>Envoy Proxy<br/>80/TCP or 443/TCP<br/>TLS: Configurable"]
    end

    subgraph InferenceServices["INFERENCE EXTENSION SERVICES (Cluster Internal)"]
        direction TB

        subgraph BBRZone["Body-Based Router"]
            BBR["BBR ext-proc<br/>9004/TCP gRPC TLS (self-signed)<br/>Auth: None (Envoy cluster)"]
            BBRHealth["BBR Health<br/>9005/TCP gRPC plaintext<br/>Auth: None"]
            BBRMetrics["BBR Metrics<br/>9090/TCP HTTP<br/>Auth: Optional TokenReview+SAR"]
        end

        subgraph EPPZone["Endpoint Picker"]
            EPP["EPP ext-proc<br/>9002/TCP gRPC TLS (self-signed RSA-4096)<br/>Auth: None (Envoy cluster)"]
            EPPHealth["EPP Health<br/>9003/TCP gRPC plaintext<br/>Auth: None"]
            EPPMetrics["EPP Metrics<br/>9090/TCP HTTP<br/>Auth: Optional TokenReview+SAR"]
        end

        subgraph LatencyZone["Latency Predictor (Optional)"]
            Training["Training Server<br/>8000/TCP HTTP plaintext<br/>Auth: None"]
            Prediction["Prediction Server<br/>8001/TCP HTTP plaintext<br/>Auth: None"]
        end

        subgraph ModelZone["Model Servers"]
            ModelServers["Model Server Pods<br/>(vLLM / SGLang / Triton)<br/>Target port: configurable<br/>Metrics: /metrics HTTP"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: ServiceAccount Token"]
        Prometheus["Prometheus (Optional)<br/>Scrapes 9090/TCP HTTP"]
        OTLP["OTLP Collector (Optional)<br/>4317/TCP gRPC<br/>Auth: None"]
    end

    %% External flows
    Client -->|"HTTP/HTTPS<br/>80 or 443/TCP<br/>TLS: Configurable"| Gateway

    %% Gateway to ext-proc
    Gateway -->|"gRPC/HTTP2<br/>9004/TCP<br/>TLS (self-signed)"| BBR
    Gateway -->|"gRPC/HTTP2<br/>9002/TCP<br/>TLS (self-signed)"| EPP

    %% EPP to model servers
    EPP -->|"HTTP<br/>configurable/TCP<br/>skip verify default<br/>Auth: None"| ModelServers

    %% Gateway to model servers (routed traffic)
    Gateway -->|"HTTP/HTTP2<br/>configurable/TCP<br/>Selected endpoint"| ModelServers

    %% EPP to latency predictor
    EPP -.->|"HTTP<br/>8001/TCP<br/>plaintext"| Prediction
    EPP -.->|"HTTP<br/>8000/TCP<br/>plaintext"| Training

    %% CRD watches
    EPP -->|"HTTPS<br/>443/TCP TLS 1.2+<br/>SA Bearer Token"| K8sAPI
    BBR -->|"HTTPS<br/>443/TCP TLS 1.2+<br/>SA Bearer Token"| K8sAPI

    %% Observability
    Prometheus -.->|"HTTP<br/>9090/TCP<br/>TokenReview+SAR"| EPPMetrics
    Prometheus -.->|"HTTP<br/>9090/TCP<br/>TokenReview+SAR"| BBRMetrics
    EPP -.->|"gRPC<br/>4317/TCP<br/>configurable"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef serviceHealth fill:#e6f3e6,stroke:#a0c8a0,stroke-width:1px
    classDef serviceMetrics fill:#e6f3e6,stroke:#a0c8a0,stroke-width:1px
    classDef optional fill:#fff2cc,stroke:#d6b656,stroke-width:1px,stroke-dasharray: 5 5
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef model fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class BBR,EPP service
    class BBRHealth,EPPHealth serviceHealth
    class BBRMetrics,EPPMetrics serviceMetrics
    class Training,Prediction optional
    class ModelServers model
    class K8sAPI,Prometheus,OTLP cluster
