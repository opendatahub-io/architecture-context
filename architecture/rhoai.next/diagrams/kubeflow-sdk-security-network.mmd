graph TB
    subgraph Client["CLIENT ENVIRONMENT (Developer Workstation / Notebook)"]
        SDK["Kubeflow SDK<br/>Python Client Library<br/>v0.4.1+rhai0"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (Trusted)"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Auth"]

        subgraph Operators["Operator Namespace"]
            TrainerOp["Kubeflow Trainer Operator<br/>SA token auth"]
        end

        subgraph UserNS["Namespace: user-namespace"]
            TrainingPod["Training Pod<br/>Injected metrics: 28080/TCP HTTP<br/>Annotations: trainer.opendatahub.io/*<br/>No Auth on metrics endpoint"]
            vLLMSidecar["vLLM Sidecar<br/>8234/TCP HTTP localhost<br/>No Auth<br/>(DATA_ONLY mode only)"]
            SharedPVC["Shared PVC Volume"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>Configurable TLS<br/>AWS IAM credentials"]
        ModelReg["Model Registry<br/>443 or 8080/TCP<br/>HTTP/HTTPS configurable<br/>user_token (optional)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>HF_TOKEN"]
        PyPI["PyPI / Custom Index<br/>443/TCP HTTPS<br/>TLS<br/>No Auth"]
    end

    subgraph Local["LOCAL RUNTIME"]
        Docker["Docker / Podman<br/>Unix socket<br/>No encryption"]
    end

    %% Flows
    SDK -->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig / SA token"| K8sAPI
    K8sAPI -->|"Watch/Informer<br/>In-cluster TLS<br/>SA token"| TrainerOp
    TrainerOp -->|"Creates pods<br/>with injected instrumentation"| TrainingPod
    TrainerOp -->|"GET /metrics<br/>HTTP/28080<br/>No Auth"| TrainingPod
    TrainingPod -->|"HTTP/8234<br/>localhost<br/>No Auth"| vLLMSidecar
    TrainingPod -->|"Filesystem I/O"| SharedPVC
    vLLMSidecar -->|"Filesystem I/O"| SharedPVC

    TrainingPod -->|"HTTPS/443<br/>Configurable TLS<br/>AWS credentials"| S3
    SDK -->|"HTTP or HTTPS<br/>443 or 8080<br/>user_token optional"| ModelReg
    TrainingPod -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub
    TrainingPod -->|"HTTPS/443<br/>TLS"| PyPI
    SDK -->|"Unix socket"| Docker

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef cluster fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef operator fill:#c8e6c9,stroke:#388e3c
    classDef workload fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef external fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef local fill:#f3e5f5,stroke:#7b1fa2

    class SDK client
    class K8sAPI cluster
    class TrainerOp operator
    class TrainingPod,vLLMSidecar,SharedPVC workload
    class S3,ModelReg,HFHub,PyPI external
    class Docker local
