graph TB
    subgraph Client["CLIENT-SIDE (User Workstation / Notebook)"]
        UserCode["User Python Code<br/>kubeflow SDK"]
    end

    subgraph ClusterIngress["CLUSTER API (TLS Boundary)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP<br/>TLS 1.2+<br/>Bearer Token / x509"]
    end

    subgraph ServerSide["CLUSTER-INTERNAL (Operators)"]
        direction TB

        subgraph NS_Operator["Namespace: kubeflow / redhat-ods-applications"]
            TrainerOp["Trainer Operator<br/>Watches: TrainJob, TrainingRuntime"]
            KatibCtrl["Katib Controller<br/>Watches: Experiment, Trial"]
            SparkOp["Spark Operator<br/>Watches: SparkConnect"]
            JobSetCtrl["JobSet Controller<br/>Watches: JobSet"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            TrainPod["Training Pod(s)<br/>SA: user-configured"]
            MetricsSrv["Metrics Server<br/>28080/TCP HTTP<br/>NO encryption<br/>NO auth"]
            SparkPod["SparkConnect Pod"]
            SparkSvc["spark-connect-{uuid}-svc<br/>ClusterIP<br/>15002/TCP gRPC<br/>NO encryption<br/>NO auth"]
        end
    end

    subgraph PlatformServices["INTERNAL PLATFORM SERVICES"]
        ModelRegistry["Model Registry Server<br/>443/TCP HTTPS or 8080/TCP HTTP<br/>Bearer Token (user_token)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HuggingFace["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>Bearer Token (ACCESS_TOKEN)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM credentials"]
        Maven["Maven Central<br/>repo1.maven.org<br/>443/TCP HTTPS TLS 1.2+<br/>No auth"]
        PyPI["PyPI<br/>pypi.org<br/>443/TCP HTTPS TLS 1.2+<br/>No auth"]
    end

    subgraph LocalDev["LOCAL DEVELOPMENT (Optional)"]
        Docker["Docker/Podman Daemon<br/>Unix socket HTTP<br/>NO encryption<br/>NO auth"]
    end

    %% Client to Cluster
    UserCode -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>CRD CRUD, pod logs, events"| K8sAPI

    %% Client to Platform Services
    UserCode -->|"HTTPS/443 or HTTP/8080<br/>TLS 1.2+ (if HTTPS)<br/>Bearer Token"| ModelRegistry

    %% Client to SparkConnect (gRPC - no encryption)
    UserCode -->|"gRPC/15002<br/>NO encryption<br/>NO auth"| SparkSvc

    %% Client to Local Dev
    UserCode -.->|"Unix socket<br/>NO encryption"| Docker

    %% K8s API to Operators
    K8sAPI -->|"Controller Watch"| TrainerOp
    K8sAPI -->|"Controller Watch"| KatibCtrl
    K8sAPI -->|"Controller Watch"| SparkOp

    %% Operators to Resources
    TrainerOp -->|"Create JobSet"| JobSetCtrl
    JobSetCtrl -->|"Schedule"| TrainPod
    KatibCtrl -->|"Create Trial TrainJobs"| K8sAPI
    SparkOp -->|"Create Pod + Service"| SparkPod
    SparkPod --- SparkSvc

    %% Training Pod connections
    TrainPod --- MetricsSrv
    TrainerOp -->|"HTTP/28080<br/>Poll progress<br/>NO encryption"| MetricsSrv
    TrainPod -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    TrainPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HuggingFace

    %% Spark connections
    SparkPod -->|"HTTPS/443<br/>TLS 1.2+"| Maven

    %% Styling
    classDef client fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef tlsBoundary fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef internal fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef platform fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef external fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    classDef localdev fill:#f5f5f5,stroke:#616161,stroke-width:1px,stroke-dasharray: 5 5
    classDef warning fill:#ffebee,stroke:#c62828,stroke-width:2px

    class UserCode client
    class K8sAPI tlsBoundary
    class TrainerOp,KatibCtrl,SparkOp,JobSetCtrl,TrainPod,SparkPod internal
    class ModelRegistry platform
    class HuggingFace,S3,Maven,PyPI external
    class Docker localdev
    class MetricsSrv,SparkSvc warning
