graph TB
    subgraph ClientEnv["CLIENT ENVIRONMENT (User Workstation / Notebook / Pipeline)"]
        SDK["Kubeflow SDK<br/>Python Library<br/>pip install kubeflow"]
    end

    subgraph K8sCluster["KUBERNETES CLUSTER"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforcement"]

        subgraph Operators["Controllers"]
            TrainerOp["Trainer Operator<br/>Reconciles TrainJob"]
            KatibCtrl["Katib Controller<br/>Reconciles Experiment"]
            SparkOp["Spark Operator<br/>Reconciles SparkApplication"]
        end

        subgraph Workloads["Training Workloads"]
            TrainingPod["Training Pod<br/>Injected code via<br/>inspect.getsource()<br/>/metrics: 8080/TCP HTTP (RHAI)"]
        end

        K8sAPI -->|Watch/Reconcile| TrainerOp
        K8sAPI -->|Watch/Reconcile| KatibCtrl
        K8sAPI -->|Watch/Reconcile| SparkOp
        TrainerOp -->|Creates JobSet + Pods| TrainingPod
    end

    subgraph LocalRuntime["LOCAL RUNTIME (Container Backend)"]
        Docker["Docker/Podman<br/>Unix Socket<br/>No Encryption<br/>No Auth"]
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        ModelRegistry["Model Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        SparkConnect["SparkConnect Server<br/>15002/TCP gRPC<br/>TLS Optional<br/>No Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Keys"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        PyPI["PyPI / Custom Index<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
    end

    %% SDK egress flows
    SDK -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token / Client Cert<br/>TrainJob, Experiment, SparkApp CRs"| K8sAPI
    SDK -->|"Unix Socket<br/>No Encryption<br/>Container Backend (local dev)"| Docker
    SDK -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token<br/>Model CRUD"| ModelRegistry
    SDK -->|"gRPC/15002<br/>TLS Optional<br/>Spark Sessions"| SparkConnect

    %% Training pod egress
    TrainingPod -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM<br/>Checkpoint Upload"| S3
    TrainingPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>PATCH annotations"| K8sAPI

    %% SDK indirect (via initializers in pods)
    K8sAPI -.->|"Pod initializers<br/>download models"| HFHub
    K8sAPI -.->|"Pod pip install<br/>from index"| PyPI

    %% Styling
    classDef client fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef local fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controller fill:#e8e8e8,stroke:#666
    classDef workload fill:#f8cecc,stroke:#b85450

    class SDK client
    class K8sAPI k8s
    class TrainerOp,KatibCtrl,SparkOp controller
    class TrainingPod workload
    class Docker local
    class ModelRegistry,SparkConnect internal
    class S3,HFHub,PyPI external
