graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Router["OpenShift Router<br/>Route: {name}-https<br/>TLS reencrypt<br/>Host: {name}-rest.{domain}"]
        Gateway["Data Science Gateway (Envoy)<br/>HTTPRoute: model-registry-{name}<br/>Path: /model-registry/{name}/"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (NetworkPolicy Enforced)"]
        direction TB

        subgraph RegistryPod["Registry Pod - Namespace: {registry-namespace}"]
            KRBP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>TLS: service-ca cert<br/>Auth: SubjectAccessReview"]
            RestContainer["rest-container<br/>8080/TCP HTTP<br/>Image: model-registry"]
        end

        subgraph OperatorPod["Operator Pod"]
            OperatorMgr["Operator Manager<br/>Probes: 8081/TCP HTTP<br/>Metrics: 8443/TCP HTTPS<br/>SA: controller-manager"]
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>TLS: controller-runtime"]
        end
    end

    subgraph DatabaseTier["DATABASE TIER"]
        AutoPG["Auto-Provisioned PostgreSQL<br/>{name}-postgres<br/>5432/TCP<br/>Auth: Generated Password"]
        ExternalDB["External PostgreSQL/MySQL<br/>5432/3306/TCP<br/>SSL: Configurable<br/>Auth: User-Provided Secret"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OSConfig["OpenShift Config API<br/>config.openshift.io<br/>Ingress domain, TLS profile"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS (edge)<br/>No auth required"| Router
    Client -->|"HTTPS/443<br/>TLS<br/>Platform auth"| Gateway

    %% Ingress to kube-rbac-proxy
    Router -->|"HTTPS/8443<br/>TLS reencrypt<br/>service-ca cert"| KRBP
    Gateway -->|"HTTPS/8443<br/>TLS<br/>HTTPRoute routing"| KRBP

    %% kube-rbac-proxy flows
    KRBP -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SubjectAccessReview"| K8sAPI
    KRBP -->|"HTTP/8080<br/>localhost<br/>No auth (proxy-authorized)"| RestContainer

    %% REST to database
    RestContainer -->|"PostgreSQL/5432<br/>Configurable SSL<br/>Password (Secret)"| AutoPG
    RestContainer -->|"PostgreSQL/5432 or MySQL/3306<br/>Configurable SSL<br/>Password (Secret)"| ExternalDB

    %% Operator flows
    OperatorMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CR watches + CRUD"| K8sAPI
    OperatorMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OSConfig
    WebhookSrv -->|"Called by K8s API<br/>HTTPS/9443<br/>TLS"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef database fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Router,Gateway ingress
    class KRBP,RestContainer internal
    class OperatorMgr,WebhookSrv operator
    class AutoPG,ExternalDB database
    class K8sAPI,OSConfig platform
