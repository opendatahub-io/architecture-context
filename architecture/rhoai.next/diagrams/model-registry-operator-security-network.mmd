graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / Client"]
    end

    subgraph Ingress["INGRESS LAYER"]
        Route["OpenShift Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        HTTPRoute["HTTPRoute via Platform Gateway<br/>data-science-gateway<br/>8443/TCP TLS Passthrough"]
    end

    subgraph AuthLayer["AUTHENTICATION (kube-rbac-proxy)"]
        RegistryProxy["Registry kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TokenReview + SAR<br/>Cert: OpenShift serving cert"]
        CatalogProxy["Catalog kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TokenReview + SAR<br/>Cert: OpenShift serving cert"]
    end

    subgraph AppLayer["APPLICATION LAYER"]
        RegistryREST["model-registry REST<br/>8080/TCP HTTP localhost<br/>No auth after proxy"]
        CatalogService["model-catalog service<br/>8080/TCP HTTP localhost<br/>No auth after proxy"]
    end

    subgraph DataLayer["DATA LAYER"]
        RegistryDB["registry-name-postgres<br/>PostgreSQL 16<br/>5432/TCP<br/>Password auth"]
        CatalogDB["model-catalog-postgres<br/>PostgreSQL 16<br/>5432/TCP<br/>Password auth"]
    end

    subgraph OperatorPlane["OPERATOR CONTROL PLANE"]
        OperatorPod["controller-manager<br/>SA: model-registry-operator-controller-manager"]
        Metrics["Metrics 8443/TCP HTTPS<br/>TokenReview + SAR"]
        Health["Health 8081/TCP HTTP<br/>No auth"]
        WebhookSvr["Webhooks 9443/TCP HTTPS<br/>K8s Admission"]
    end

    subgraph K8sPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OpenShiftAPI["OpenShift API<br/>config.openshift.io<br/>6443/TCP HTTPS"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Route
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HTTPRoute

    %% Ingress to Auth
    Route -->|"HTTPS/8443<br/>TLS reencrypt"| RegistryProxy
    Route -->|"HTTPS/8443<br/>TLS reencrypt"| CatalogProxy
    HTTPRoute -->|"HTTPS/8443<br/>TLS passthrough"| RegistryProxy
    HTTPRoute -->|"HTTPS/8443<br/>TLS passthrough"| CatalogProxy

    %% Auth validation
    RegistryProxy -->|"HTTPS/6443<br/>TokenReview + SAR"| K8sAPI
    CatalogProxy -->|"HTTPS/6443<br/>TokenReview + SAR"| K8sAPI

    %% Auth to App
    RegistryProxy -->|"HTTP/8080<br/>localhost only<br/>no encryption"| RegistryREST
    CatalogProxy -->|"HTTP/8080<br/>localhost only<br/>no encryption"| CatalogService

    %% App to Data
    RegistryREST -->|"PostgreSQL/5432<br/>Optional SSL<br/>Password"| RegistryDB
    CatalogService -->|"PostgreSQL/5432<br/>No encryption<br/>Password"| CatalogDB

    %% Operator flows
    OperatorPod --> Metrics
    OperatorPod --> Health
    OperatorPod --> WebhookSvr
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    OperatorPod -->|"HTTPS/6443<br/>TLS profile read<br/>SA Token"| OpenShiftAPI
    K8sAPI -->|"Admission calls<br/>HTTPS/9443"| WebhookSvr

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef k8s fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route,HTTPRoute ingress
    class RegistryProxy,CatalogProxy auth
    class RegistryREST,CatalogService app
    class RegistryDB,CatalogDB data
    class OperatorPod,Metrics,Health,WebhookSvr operator
    class K8sAPI,OpenShiftAPI k8s
