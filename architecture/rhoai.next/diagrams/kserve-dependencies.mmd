graph LR
    KServe["KServe<br/>(Multi-Controller Platform)"]

    %% Required External Dependencies
    subgraph Required["Required Dependencies"]
        K8s["Kubernetes ≥1.27"]
        CertMgr["cert-manager ≥1.0"]
    end

    KServe -->|"CRD reconciliation<br/>HTTPS/443 SA token"| K8s
    KServe -->|"webhook TLS certs<br/>Certificate/Issuer CRUD"| CertMgr

    %% Optional External Dependencies
    subgraph Optional["Optional External Dependencies"]
        Istio["Istio ≥1.17<br/>(VirtualService, mTLS)"]
        Knative["Knative Serving ≥1.10<br/>(serverless mode)"]
        KEDA["KEDA ≥2.0<br/>(event-driven autoscaling)"]
        OTelOp["OpenTelemetry Operator ≥0.80<br/>(collector sidecar)"]
        LWS["LeaderWorkerSet ≥0.3<br/>(multi-node LLM)"]
        GatewayAPI["Gateway API ≥1.0<br/>(HTTPRoute ingress)"]
        GIE["GIE<br/>(InferencePool scheduling)"]
        WVA["WVA<br/>(LLM autoscaling)"]
        PromOp["Prometheus Operator ≥0.60<br/>(PodMonitor/ServiceMonitor)"]
        Kuadrant["Kuadrant AuthPolicy<br/>(HTTPRoute auth, distro)"]
    end

    KServe -.->|"traffic mgmt"| Istio
    KServe -.->|"serverless deploy"| Knative
    KServe -.->|"ScaledObject"| KEDA
    KServe -.->|"OTel injection"| OTelOp
    KServe -.->|"multi-node topology"| LWS
    KServe -.->|"HTTPRoute/Gateway"| GatewayAPI
    KServe -.->|"InferencePool"| GIE
    KServe -.->|"VariantAutoscaling"| WVA
    KServe -.->|"metrics scraping"| PromOp
    KServe -.->|"AuthPolicy"| Kuadrant

    %% Internal Platform Dependencies
    subgraph InternalPlatform["Internal RHOAI Platform"]
        ODHOperator["rhods-operator /<br/>opendatahub-operator"]
        ServiceMesh["Service Mesh (Istio)"]
        DSGateway["data-science-gateway"]
    end

    ODHOperator -->|"Kserve CR<br/>lifecycle mgmt"| KServe
    KServe -->|"DestinationRule<br/>VirtualService"| ServiceMesh
    KServe -->|"HTTPRoute routing"| DSGateway

    %% Integration Points (other ODH components)
    subgraph Integrations["Integration Points (Consuming)"]
        Dashboard["ODH Dashboard"]
        Pipelines["Data Science Pipelines"]
        ODHModelCtrl["odh-model-controller"]
    end

    Dashboard -.->|"UI management"| KServe
    Pipelines -.->|"auto deploy models"| KServe
    ODHModelCtrl -.->|"mutating/validating<br/>webhooks"| KServe

    %% External Services
    subgraph ExtServices["External Services (Egress)"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>GCP creds"]
        AzureBlob["Azure Blob Storage<br/>443/TCP HTTPS<br/>Azure Identity"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>HF Token"]
        HDFS["HDFS NameNode<br/>8020/TCP RPC<br/>Kerberos"]
    end

    KServe -->|"model download"| S3
    KServe -->|"model download"| GCS
    KServe -->|"model download"| AzureBlob
    KServe -->|"model download"| HFHub
    KServe -.->|"HDFS download"| HDFS

    %% Styling
    style KServe fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style K8s fill:#326ce5,stroke:#333,color:#fff
    style CertMgr fill:#326ce5,stroke:#333,color:#fff

    style Istio fill:#999,stroke:#333,color:#fff
    style Knative fill:#999,stroke:#333,color:#fff
    style KEDA fill:#999,stroke:#333,color:#fff
    style OTelOp fill:#999,stroke:#333,color:#fff
    style LWS fill:#999,stroke:#333,color:#fff
