graph LR
    KServe["KServe<br/>(9 sub-components)"]

    %% External Dependencies (Required)
    KServe -->|"platform runtime<br/>(required)"| K8s["Kubernetes 1.29+"]
    KServe -->|"operator framework<br/>(required)"| CtrlRuntime["controller-runtime v0.20+"]

    %% External Dependencies (Optional)
    KServe -->|"serverless mode"| Knative["Knative Serving v1"]
    KServe -->|"service mesh<br/>VirtualServices"| Istio["Istio v1alpha3+"]
    KServe -->|"HTTPRoute ingress<br/>(RHOAI 3.x primary)"| GatewayAPI["Gateway API v1"]
    KServe -->|"gateway-aware scheduling<br/>InferencePool"| GIE["GIE v1/v1alpha2"]
    KServe -->|"external metrics<br/>autoscaling"| KEDA["KEDA v1alpha1"]
    KServe -->|"multi-node LLM<br/>inference"| LWS["LeaderWorkerSet v1"]
    KServe -->|"TLS certificates"| CertManager["cert-manager v1"]
    KServe -->|"metrics collection<br/>sidecars"| OTel["OpenTelemetry<br/>Operator v1beta1"]
    KServe -->|"PodMonitor /<br/>ServiceMonitor"| PromOp["Prometheus<br/>Operator v1"]
    KServe -->|"LLM-specific<br/>scaling"| WVA["WVA (llm-d) v0.7.0"]

    %% Internal RHOAI Dependencies
    RHOAIOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates Kserve CR"| KServe
    KServe -.->|"mTLS<br/>DestinationRules"| ServiceMesh["Service Mesh (Istio)"]
    GatewayCtrl["Gateway Controller"] -->|"ingress for<br/>inference endpoints"| KServe
    KServe -->|"auth sidecar<br/>SubjectAccessReview"| AuthProxy["kube-rbac-proxy /<br/>kube-auth-proxy"]
    KServe -->|"LLM engine<br/>CUDA/ROCm/Gaudi/Spyre"| vLLM["vLLM"]
    KServe -->|"endpoint picker<br/>EPP"| LLMD["llm-d router/<br/>scheduler"]
    KServe -->|"metric queries<br/>KEDA/HPA"| Prometheus["Prometheus"]

    %% Integration Points (incoming)
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe
    ODMController["ODH Model<br/>Controller"] -->|"webhook mutation<br/>InferenceService, IG,<br/>LLMInferenceService"| KServe
    Kuadrant["Kuadrant"] -.->|"AuthPolicy<br/>precondition"| KServe

    %% External Services
    KServe -->|"model storage<br/>download"| S3["S3 / GCS /<br/>Azure Blob"]
    KServe -->|"model download<br/>HF token"| HF["HuggingFace Hub"]
    KServe -->|"OCI model<br/>artifacts"| Registries["Container<br/>Registries"]

