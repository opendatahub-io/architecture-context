    style GIE fill:#999,stroke:#333,color:#fff
    style WVA fill:#999,stroke:#333,color:#fff
    style PromOp fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff

    style ODHOperator fill:#7ed321,stroke:#333,color:#fff
    style ServiceMesh fill:#7ed321,stroke:#333,color:#fff
    style DSGateway fill:#7ed321,stroke:#333,color:#fff

    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style Pipelines fill:#7ed321,stroke:#333,color:#fff
    style ODHModelCtrl fill:#7ed321,stroke:#333,color:#fff

