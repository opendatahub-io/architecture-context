graph LR
    Caikit["Caikit<br/>Python AI Runtime Framework"]

    %% Internal RHOAI Dependencies (consume caikit as pip dep)
    CaikitNLP["caikit-nlp<br/>(NLP modules)"] -->|"Python import<br/>registers modules"| Caikit
    CaikitTGIS["caikit-tgis-serving<br/>(TGIS integration)"] -->|"Python import<br/>registers modules"| Caikit

    %% Platform Dependencies (caikit runs inside these)
    Caikit -->|"gRPC sidecar API<br/>mmesh.ModelRuntime<br/>unix socket"| ModelMesh["ModelMesh<br/>(multi-model orchestration)"]
    Caikit -->|"deployed as<br/>InferenceService pod"| KServe["KServe<br/>(serverless inference)"]

    %% Core Python Dependencies
    Caikit -->|"gRPC server/client"| grpcio["grpcio >=1.35,<2.0"]
    Caikit -->|"data serialization"| protobuf["protobuf >=3.19,<6"]
    Caikit -->|"dynamic proto gen"| pyToProto["py-to-proto >=0.5,<0.6"]
    Caikit -->|"config system"| aconfig["alchemy-config >=1.1,<2.0"]
    Caikit -->|"structured logging"| alog["alchemy-logging >=1.3,<2.0"]

    %% Optional Runtime Dependencies
    Caikit -.->|"HTTP server"| fastapi["FastAPI >=0.100,<1"]
    Caikit -.->|"request validation"| pydantic["Pydantic >=2.8,<3"]
    Caikit -.->|"SSE streaming"| sseStarlette["sse-starlette >=1.6,<3"]
    Caikit -.->|"gRPC health checks"| grpcHealth["grpcio-health-checking"]
    Caikit -.->|"gRPC reflection"| grpcReflect["grpcio-reflection"]

    %% Observability Dependencies
    Caikit -.->|"distributed tracing"| otelSDK["opentelemetry-sdk >=1.24,<2"]
    Caikit -.->|"metrics"| promClient["prometheus_client >=0.12,<1"]
    Caikit -.->|"gRPC metrics"| grpcProm["py-grpc-prometheus >=0.7,<0.9"]

    %% External Service Dependencies
    Caikit -->|"OTLP trace export<br/>4317/TCP gRPC"| OTLPCollector["OTLP Collector"]
    Caikit -->|"training data I/O<br/>443/TCP HTTPS"| S3["S3-Compatible Storage"]
    Caikit -.->|"model discovery<br/>gRPC or HTTP"| RemoteCaikit["Remote Caikit Instances"]

    %% Integration Points (other components that interact with caikit)
    ModelTrainDWF["Model-Train DWF"] -->|"gRPC/8085<br/>processproto.Process"| Caikit
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>8086/TCP"| Caikit

    %% Styles
    style Caikit fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI (green)
    style CaikitNLP fill:#7ed321,stroke:#333,color:#fff
    style CaikitTGIS fill:#7ed321,stroke:#333,color:#fff
    style ModelMesh fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelTrainDWF fill:#7ed321,stroke:#333,color:#fff

    %% Core Python deps (light blue)
    style grpcio fill:#dae8fc,stroke:#6c8ebf
    style protobuf fill:#dae8fc,stroke:#6c8ebf
    style pyToProto fill:#dae8fc,stroke:#6c8ebf
    style aconfig fill:#dae8fc,stroke:#6c8ebf
    style alog fill:#dae8fc,stroke:#6c8ebf

    %% Optional deps (lighter)
    style fastapi fill:#e8f4f8,stroke:#6c8ebf
    style pydantic fill:#e8f4f8,stroke:#6c8ebf
    style sseStarlette fill:#e8f4f8,stroke:#6c8ebf
