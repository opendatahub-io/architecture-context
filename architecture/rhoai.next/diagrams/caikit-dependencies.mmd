graph LR
    Caikit["Caikit<br/>AI Runtime Framework"]

    %% Internal RHOAI Dependencies (consume Caikit as library)
    CaikitNLP["caikit-nlp"] -->|imports| Caikit
    CaikitTGIS["caikit-tgis-serving"] -->|imports| Caikit
    KServe["KServe"] -->|runs as<br/>ServingRuntime| Caikit
    ModelMesh["ModelMesh"] -->|gRPC Unix socket<br/>model lifecycle| Caikit

    %% Core Python Dependencies
    Caikit -->|gRPC protocol| grpcio["grpcio >=1.35,<2"]
    Caikit -->|data serialization| protobuf["protobuf >=3.19,<6"]
    Caikit -->|dynamic proto gen| py_to_proto["py-to-proto >=0.5,<0.6"]
    Caikit -->|config mgmt| alchemy_config["alchemy-config >=1.1,<2"]
    Caikit -->|structured logging| alchemy_logging["alchemy-logging >=1.3,<2"]
    Caikit -->|YAML parsing| pyyaml["PyYAML >=6,<7"]
    Caikit -->|array ops| numpy["numpy >=1.22,<2"]

    %% Optional Runtime Dependencies
    Caikit -.->|HTTP server| fastapi["FastAPI >=0.100,<1"]
    Caikit -.->|validation| pydantic["Pydantic >=2.8,<3"]
    Caikit -.->|SSE streaming| sse_starlette["sse-starlette >=1.6,<3"]
    Caikit -.->|metrics| prometheus["prometheus_client >=0.12,<1"]
    Caikit -.->|gRPC metrics| grpc_prom["py-grpc-prometheus >=0.7,<0.9"]
    Caikit -.->|tracing| otel_sdk["opentelemetry-sdk >=1.24,<2"]
    Caikit -.->|trace export| otel_otlp["opentelemetry-exporter-otlp >=1.24,<2"]

    %% Optional Interface Dependencies
    Caikit -.->|timeseries| pandas["pandas >=1.4,<2"]
    Caikit -.->|spark backend| pyspark["pyspark >=3.3,<3.6"]
    Caikit -.->|image processing| pillow["Pillow >=6.2,<11"]

    %% Infrastructure Integration Points
    Caikit -->|trace export| OTelCollector["OTel Collector<br/>4317/4318 TCP"]
    Caikit -->|metrics scrape| PromServer["Prometheus<br/>8086/TCP"]
    Caikit -.->|remote inference| RemoteCaikit["Remote Caikit Runtime<br/>gRPC"]

    %% Styling
    style Caikit fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI components
    style CaikitNLP fill:#7ed321,stroke:#333,color:#fff
    style CaikitTGIS fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelMesh fill:#7ed321,stroke:#333,color:#fff

