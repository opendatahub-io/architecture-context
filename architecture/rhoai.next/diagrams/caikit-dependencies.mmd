graph LR
    Caikit["Caikit<br/>AI Runtime Framework"]

    %% Internal Platform Dependencies
    Caikit -->|"gRPC Unix socket<br/>model lifecycle"| ModelMesh["ModelMesh"]
    Caikit -->|"ServingRuntime<br/>backend"| KServe["KServe"]
    CaikitNLP["caikit-nlp"] -->|"Python import<br/>NLP modules"| Caikit
    CaikitTGIS["caikit-tgis-serving"] -->|"Python import<br/>TGIS integration"| Caikit

    %% Core External Dependencies
    Caikit -->|"gRPC protocol"| GRPCIO["grpcio >=1.35,<2.0"]
    Caikit -->|"data serialization"| Protobuf["protobuf >=3.19,<6"]
    Caikit -->|"dynamic proto gen"| PyToProto["py-to-proto >=0.5,<0.6"]
    Caikit -->|"config management"| AlchemyConfig["alchemy-config >=1.1,<2.0"]
    Caikit -->|"structured logging"| AlchemyLogging["alchemy-logging >=1.3,<2.0"]
    Caikit -->|"YAML parsing"| PyYAML["PyYAML >=6.0,<7.0"]
    Caikit -->|"numerical ops"| NumPy["numpy >=1.22,<2"]

    %% Optional Runtime Dependencies
    Caikit -.->|"HTTP server"| FastAPI["fastapi >=0.100,<1"]
    Caikit -.->|"request validation"| Pydantic["pydantic >=2.8,<3"]
    Caikit -.->|"SSE streaming"| SSEStarlette["sse-starlette >=1.6,<3"]
    Caikit -.->|"metrics export"| PromClient["prometheus_client >=0.12,<1"]
    Caikit -.->|"distributed tracing"| OTelSDK["opentelemetry-sdk >=1.24,<2"]

    %% Optional Interface Dependencies
    Caikit -.->|"time series"| Pandas["pandas >=1.4,<2"]
    Caikit -.->|"Spark backend"| PySpark["pyspark >=3.3,<3.6"]
    Caikit -.->|"image processing"| Pillow["pillow >=6.2,<11"]

    %% Integration Points
    Caikit -.->|"OTLP traces<br/>4317/4318 TCP"| OTelCollector["OpenTelemetry<br/>Collector"]
    Caikit -.->|"remote inference<br/>gRPC"| RemoteCaikit["Remote Caikit<br/>Runtime"]
    PromScraper["Prometheus<br/>Scraper"] -.->|"scrape metrics<br/>8086/TCP"| Caikit

    %% Styling
    style Caikit fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal ODH/RHOAI components
    style ModelMesh fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style CaikitNLP fill:#7ed321,stroke:#333
    style CaikitTGIS fill:#7ed321,stroke:#333

    %% Required external deps
    style GRPCIO fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style PyToProto fill:#999,stroke:#333
    style AlchemyConfig fill:#999,stroke:#333
    style AlchemyLogging fill:#999,stroke:#333
    style PyYAML fill:#999,stroke:#333
    style NumPy fill:#999,stroke:#333

    %% Optional external deps
    style FastAPI fill:#ccc,stroke:#333
    style Pydantic fill:#ccc,stroke:#333
    style SSEStarlette fill:#ccc,stroke:#333
    style PromClient fill:#ccc,stroke:#333
    style OTelSDK fill:#ccc,stroke:#333
    style Pandas fill:#ccc,stroke:#333
    style PySpark fill:#ccc,stroke:#333
    style Pillow fill:#ccc,stroke:#333

    %% External services
    style OTelCollector fill:#f5a623,stroke:#333
