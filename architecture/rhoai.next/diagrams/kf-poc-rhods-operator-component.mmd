graph TB
    subgraph OperatorPod["redhat-ods-operator-controller-manager"]
        direction TB
        DSCIReconciler["DSCInitializationReconciler<br/>(Go Controller)"]
        DSCReconciler["DataScienceClusterReconciler<br/>(Go Controller)"]
        SecretGen["SecretGeneratorReconciler<br/>(Go Controller)"]
        CertGen["CertConfigmapGeneratorReconciler<br/>(Go Controller)"]
        ValidatingWH["Validating Webhook<br/>(port 9443)"]
        MutatingWH["Mutating Webhook<br/>(port 9443)"]
    end

    Admin[Platform Admin] -->|creates| DSCI_CR["DSCInitialization CR<br/>(Cluster-scoped)"]
    Admin -->|creates| DSC_CR["DataScienceCluster CR<br/>(Cluster-scoped)"]

    DSCI_CR -->|watched by| DSCIReconciler
    DSC_CR -->|watched by| DSCReconciler
    DSC_CR -->|validated by| ValidatingWH
    DSC_CR -->|mutated by| MutatingWH

    DSCIReconciler -->|bootstraps| AppNS["applications namespace"]
    DSCIReconciler -->|configures| Monitoring["Monitoring Stack"]
    DSCIReconciler -->|configures| ServiceMesh["Service Mesh<br/>(data-science-smcp)"]
    DSCIReconciler -->|distributes| CABundle["Trusted CA Bundles"]

    DSCReconciler -->|deploys/removes| Components["11 Data Science Components"]

    subgraph ManagedComponents["Managed Components"]
        Dashboard["Dashboard"]
        Workbenches["Workbenches"]
        KServe["KServe"]
        ModelMesh["ModelMesh Serving"]
        DSPipelines["Data Science Pipelines"]
        CodeFlare["CodeFlare"]
        Ray["Ray"]
        Kueue["Kueue"]
        TrustyAI["TrustyAI"]
        TrainingOp["Training Operator"]
        ModelReg["Model Registry"]
    end

    Components --- Dashboard
    Components --- Workbenches
    Components --- KServe
    Components --- ModelMesh
    Components --- DSPipelines
    Components --- CodeFlare
    Components --- Ray
    Components --- Kueue
    Components --- TrustyAI
    Components --- TrainingOp
    Components --- ModelReg

    SecretGen -->|manages| OAuthSecrets["OAuth Secrets"]
    CertGen -->|distributes| CACerts["CA ConfigMaps"]

    FeatureTracker["FeatureTracker CR<br/>(Visibility API)"]

    style OperatorPod fill:#4a90e2,color:#fff
    style DSCIReconciler fill:#3a7bc8,color:#fff
    style DSCReconciler fill:#3a7bc8,color:#fff
    style SecretGen fill:#3a7bc8,color:#fff
    style CertGen fill:#3a7bc8,color:#fff
    style ValidatingWH fill:#3a7bc8,color:#fff
    style MutatingWH fill:#3a7bc8,color:#fff
    style DSCI_CR fill:#f5a623
    style DSC_CR fill:#f5a623
    style FeatureTracker fill:#f5a623
    style ManagedComponents fill:#e8f5e9,stroke:#82b366
    style Dashboard fill:#7ed321
    style Workbenches fill:#7ed321
    style KServe fill:#7ed321
    style ModelMesh fill:#7ed321
    style DSPipelines fill:#7ed321
    style CodeFlare fill:#7ed321
    style Ray fill:#7ed321
