graph TB
    subgraph CaikitNLP["caikit-nlp Library"]
        direction TB

        subgraph TextGen["Text Generation Modules"]
            PeftPromptTuning["PeftPromptTuning<br/>(Local Prompt Tuning)"]
            TextGeneration["TextGeneration<br/>(Local HF Transformers)"]
            PeftPromptTuningTGIS["PeftPromptTuningTGIS<br/>(Remote via TGIS)"]
            TextGenerationTGIS["TextGenerationTGIS<br/>(Remote via TGIS)"]
        end

        subgraph Embedding["Embedding & Ranking Modules"]
            EmbeddingModule["EmbeddingModule<br/>(sentence-transformers)"]
            CrossEncoderModule["CrossEncoderModule<br/>(Cross-Encoder Reranking)"]
        end

        subgraph Classification["Classification Modules (WIP)"]
            SequenceClassification["SequenceClassification"]
            FilteredSpanClassification["FilteredSpanClassification"]
        end

        subgraph Tokenization["Tokenization"]
            RegexSentenceSplitter["RegexSentenceSplitter"]
        end

        subgraph ModelMgmt["Model Management"]
            TGISAutoFinder["TGISAutoFinder<br/>(Endpoint Discovery)"]
        end
    end

    CaikitRuntime["Caikit Runtime<br/>(python -m caikit.runtime)"]
    CaikitRuntime -->|"loads library<br/>RUNTIME_LIBRARY=caikit_nlp"| CaikitNLP

    Client["Client"] -->|"HTTP POST :8080"| CaikitRuntime
    Client -->|"gRPC :8085"| CaikitRuntime

    PeftPromptTuningTGIS -->|"gRPC (configurable TLS)"| TGIS["TGIS Server"]
    TextGenerationTGIS -->|"gRPC (configurable TLS)"| TGIS
    TGISAutoFinder -->|"discovers"| TGIS

    PeftPromptTuning -->|"uses"| PyTorch["PyTorch / Transformers"]
    TextGeneration -->|"uses"| PyTorch
    EmbeddingModule -->|"uses"| SentenceTransformers["sentence-transformers"]

    CaikitNLP -.->|"optional download<br/>ALLOW_DOWNLOADS=1"| HFHub["HuggingFace Hub"]

    style CaikitRuntime fill:#4a90e2,stroke:#333,color:#fff
    style PeftPromptTuning fill:#7ed321,stroke:#333
    style TextGeneration fill:#7ed321,stroke:#333
    style PeftPromptTuningTGIS fill:#f5a623,stroke:#333
    style TextGenerationTGIS fill:#f5a623,stroke:#333
    style EmbeddingModule fill:#7ed321,stroke:#333
    style CrossEncoderModule fill:#7ed321,stroke:#333
    style SequenceClassification fill:#ccc,stroke:#333
    style FilteredSpanClassification fill:#ccc,stroke:#333
    style RegexSentenceSplitter fill:#7ed321,stroke:#333
    style TGISAutoFinder fill:#4a90e2,stroke:#333,color:#fff
    style TGIS fill:#e8e8e8,stroke:#333
    style PyTorch fill:#e8e8e8,stroke:#333
    style SentenceTransformers fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
