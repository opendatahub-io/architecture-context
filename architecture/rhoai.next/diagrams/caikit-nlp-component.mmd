graph TB
    subgraph CaikitNLP["Caikit NLP Library"]
        direction TB

        subgraph TextGen["Text Generation Modules"]
            PeftPromptTuning["PeftPromptTuning<br/>(Local PyTorch)"]
            PeftPromptTuningTGIS["PeftPromptTuningTGIS<br/>(Remote via TGIS)"]
            TextGenLocal["TextGeneration<br/>(Local Fine-tuned)"]
            TextGenTGIS["TextGenerationTGIS<br/>(Remote Fine-tuned)"]
        end

        subgraph Embedding["Text Embedding Modules"]
            EmbeddingModule["EmbeddingModule<br/>(7 tasks: Embed, Similarity,<br/>Rerank, Tokenize)"]
            CrossEncoder["CrossEncoderModule<br/>(Cross-attention Reranking)"]
        end

        subgraph Classification["Classification Modules"]
            SeqClassification["SequenceClassification"]
            TokenClassification["FilteredSpanClassification"]
        end

        subgraph Resources["Resources"]
            PretrainedModel["PretrainedModel<br/>(HF AutoModel Wrappers)"]
            CausalLM["HFAutoCausalLM"]
            Seq2SeqLM["HFAutoSeq2SeqLM"]
            SeqClassifier["HFAutoSeqClassifier"]
        end

        subgraph Toolkit["Toolkit"]
            TGISUtils["TGISGenerationClient<br/>(gRPC Error Mapping)"]
            TorchRun["torch_run<br/>(Distributed Training)"]
            ModelRunUtils["model_run_utils<br/>(Generation Pipeline)"]
        end

        PretrainedModel --> CausalLM
        PretrainedModel --> Seq2SeqLM
        PretrainedModel --> SeqClassifier
    end

    subgraph CaikitRuntime["Caikit Runtime (Host Process)"]
        HTTPServer["HTTP Server<br/>8080/TCP"]
        GRPCServer["gRPC Server<br/>8085/TCP"]
    end

    Client[Client / Platform] -->|"POST /api/v1/task/*"| HTTPServer
    Client -->|"gRPC caikit.runtime.Nlp"| GRPCServer

    HTTPServer -->|"dispatches to"| TextGen
    HTTPServer -->|"dispatches to"| Embedding
    HTTPServer -->|"dispatches to"| Classification
    GRPCServer -->|"dispatches to"| TextGen
    GRPCServer -->|"dispatches to"| Embedding
    GRPCServer -->|"dispatches to"| Classification

    PeftPromptTuning -->|"uses"| PretrainedModel
    TextGenLocal -->|"uses"| PretrainedModel
    PeftPromptTuningTGIS -->|"gRPC"| TGIS["TGIS Backend"]
    TextGenTGIS -->|"gRPC"| TGIS
    EmbeddingModule -->|"uses"| SentenceTransformers["sentence-transformers"]
    CrossEncoder -->|"uses"| CrossEncoderLib["CrossEncoder (HF)"]

    PeftPromptTuning -->|"training"| PyTorch["PyTorch"]
    TorchRun -->|"distributed"| PyTorchDist["torch.distributed<br/>29550/TCP"]

    style CaikitNLP fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style CaikitRuntime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style TGIS fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style SentenceTransformers fill:#e8e8e8,stroke:#999
    style CrossEncoderLib fill:#e8e8e8,stroke:#999
    style PyTorch fill:#e8e8e8,stroke:#999
    style PyTorchDist fill:#e8e8e8,stroke:#999
    style HTTPServer fill:#4a90e2,color:#fff
    style GRPCServer fill:#4a90e2,color:#fff
