graph TB
    subgraph CaikitNLP["Caikit-NLP Service"]
        direction TB

        subgraph TextGen["Text Generation Modules"]
            PeftPromptTuning["PeftPromptTuning<br/><i>Prompt tuning via PEFT</i>"]
            TextGenLocal["TextGeneration<br/><i>Local CausalLM/Seq2Seq</i>"]
            PeftTGIS["PeftPromptTuningTGIS<br/><i>Remote prompt-tuned inference</i>"]
            TextGenTGIS["TextGenerationTGIS<br/><i>Remote text generation</i>"]
        end

        subgraph Embedding["Embedding & Reranking Modules"]
            EmbeddingMod["EmbeddingModule<br/><i>Embeddings, similarity, reranking</i>"]
            CrossEncoder["CrossEncoderModule<br/><i>Cross-encoder reranking</i>"]
        end

        subgraph Classification["Classification Modules"]
            SeqClass["SequenceClassification<br/><i>Text classification</i>"]
            SpanClass["FilteredSpanClassification<br/><i>Token classification</i>"]
        end

        subgraph Tokenization["Tokenization"]
            RegexSplitter["RegexSentenceSplitter<br/><i>Regex-based tokenization</i>"]
        end

        subgraph Runtime["Caikit Runtime Layer"]
            GRPCServer["gRPC Runtime Server<br/>Port 8085/TCP"]
            RESTGateway["REST Gateway Proxy<br/>Port 8080/TCP"]
            AutoFinder["TGISAutoFinder<br/><i>Auto-discover TGIS models</i>"]
        end

        RESTGateway -->|proxies to| GRPCServer
        GRPCServer -->|hosts| PeftPromptTuning
        GRPCServer -->|hosts| TextGenLocal
        GRPCServer -->|hosts| PeftTGIS
        GRPCServer -->|hosts| TextGenTGIS
        GRPCServer -->|hosts| EmbeddingMod
        GRPCServer -->|hosts| CrossEncoder
        GRPCServer -->|hosts| SeqClass
        GRPCServer -->|hosts| SpanClass
        GRPCServer -->|hosts| RegexSplitter
        AutoFinder -->|probes| TGISServer
    end

    Client[Client] -->|HTTP 8080| RESTGateway
    Client -->|gRPC 8085| GRPCServer

    TextGenLocal -->|loads model| HFModel["HuggingFace Model<br/>(in-memory GPU/CPU)"]
    EmbeddingMod -->|loads model| STModel["Sentence Transformers<br/>(in-memory)"]
    PeftTGIS -->|gRPC| TGISServer["TGIS Server<br/>(Remote Inference)"]
    TextGenTGIS -->|gRPC| TGISServer
    PeftPromptTuning -->|downloads| HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]

    KServe["KServe / ModelMesh<br/>(Platform Deployment)"] -->|deploys container| CaikitNLP

    style CaikitNLP fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style TextGen fill:#dbeafe,stroke:#3b82f6
    style Embedding fill:#dbeafe,stroke:#3b82f6
    style Classification fill:#dbeafe,stroke:#3b82f6
    style Tokenization fill:#dbeafe,stroke:#3b82f6
    style Runtime fill:#fef3c7,stroke:#f59e0b
    style GRPCServer fill:#4a90e2,color:#fff
    style RESTGateway fill:#4a90e2,color:#fff
    style AutoFinder fill:#4a90e2,color:#fff
    style TGISServer fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style HFModel fill:#d1fae5,stroke:#10b981
    style STModel fill:#d1fae5,stroke:#10b981
    style KServe fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
