graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mlflow<br/>(configurable via Helm)"]
    end

    subgraph AuthPlugins["Authentication Plugins (--app-name)"]
        K8sAuth["kubernetes-auth Plugin"]
        BasicAuth["basic-auth Plugin"]
    end

    subgraph KubernetesRBAC["Kubernetes RBAC (Dynamic - via Helm extraRules)"]
        direction TB

        subgraph ClusterScope["Cluster-Scoped (cluster_rbac.extraRules)"]
            CRB["ClusterRoleBinding<br/>(created when extraRules non-empty)"]
            CR["ClusterRole<br/>(dynamic rules from values.yaml)"]
        end

        subgraph NamespaceScope["Namespace-Scoped (namespace_rbac.extraRules)"]
            RB["RoleBinding<br/>(created when extraRules non-empty)"]
            Role["Role<br/>(dynamic rules from values.yaml)"]
        end
    end

    subgraph RequiredPermissions["Required Permissions (kubernetes-auth plugin)"]
        NSList["API: core<br/>Resource: namespaces<br/>Verbs: list<br/>Purpose: Workspace enumeration"]
        TokenReview["API: authentication.k8s.io<br/>Resource: tokenreviews<br/>Verbs: create<br/>Purpose: User authentication"]
    end

    subgraph AppLevelRBAC["Application-Level RBAC (MLflow Auth)"]
        direction TB
        WorkspacePerms["Workspace Permissions<br/>- READ (default)<br/>- EDIT<br/>- MANAGE<br/>- NO_PERMISSIONS"]
        UserPerms["Per-User Permissions<br/>(stored in PostgreSQL)"]
        AuthCache["Auth Cache<br/>(configurable TTL)"]
    end

    subgraph SecurityMiddleware["Security Middleware Stack"]
        CORSBlock["CORSBlockingMiddleware<br/>Blocks cross-origin state changes"]
        HostValidation["HostValidationMiddleware<br/>DNS rebinding protection"]
        SecHeaders["SecurityHeadersMiddleware<br/>X-Content-Type-Options: nosniff<br/>X-Frame-Options: SAMEORIGIN"]
    end

    subgraph Secrets["Secrets & Credentials"]
        TLSSecret["mlflow-tls<br/>Type: kubernetes.io/tls<br/>Purpose: TLS cert/key<br/>Provisioned: Manual/cert-manager"]
        DBSecret["mlflow-db-secret<br/>Type: Opaque<br/>Purpose: DB connection URI<br/>Provisioned: Manual"]
        KEKSecret["MLFLOW_CRYPTO_KEK_PASSPHRASE<br/>Type: env var<br/>Purpose: AES-GCM KEK for gateway secrets<br/>Rotation: mlflow crypto rotate-kek"]
    end

    %% Relationships
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| CR
    RB -->|"grants"| Role

    SA -->|"used by"| K8sAuth
    K8sAuth -->|"requires"| NSList
    K8sAuth -->|"requires"| TokenReview
    K8sAuth -->|"validates users via"| TokenReview

    K8sAuth -->|"populates"| UserPerms
    BasicAuth -->|"populates"| UserPerms
    UserPerms -->|"cached in"| AuthCache
    UserPerms -->|"scoped by"| WorkspacePerms

    %% Styles
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style Role fill:#f5a623,stroke:#333
    style CRB fill:#f5a623,stroke:#333
    style RB fill:#f5a623,stroke:#333
    style NSList fill:#7ed321,stroke:#333
    style TokenReview fill:#7ed321,stroke:#333
    style K8sAuth fill:#9b59b6,stroke:#333,color:#fff
    style BasicAuth fill:#9b59b6,stroke:#333,color:#fff
    style WorkspacePerms fill:#3498db,stroke:#333,color:#fff
    style UserPerms fill:#3498db,stroke:#333,color:#fff
    style AuthCache fill:#3498db,stroke:#333,color:#fff
    style TLSSecret fill:#e74c3c,stroke:#333,color:#fff
    style DBSecret fill:#e74c3c,stroke:#333,color:#fff
    style KEKSecret fill:#e74c3c,stroke:#333,color:#fff
    style CORSBlock fill:#e67e22,stroke:#333,color:#fff
    style HostValidation fill:#e67e22,stroke:#333,color:#fff
    style SecHeaders fill:#e67e22,stroke:#333,color:#fff
