graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mlflow<br/>(release namespace)"]
    end

    subgraph Bindings["Role Bindings"]
        RB["mlflow RoleBinding<br/>(namespace-scoped)"]
    end

    subgraph Roles["Roles"]
        Role["mlflow Role<br/>(Helm-managed)"]
        ExtraNS["namespace_rbac.extraRules<br/>(configurable)"]
        ExtraCluster["cluster_rbac.extraRules<br/>(configurable)"]
    end

    subgraph AuthPlugin["kubernetes-auth Plugin (Runtime RBAC)"]
        SSAR["SelfSubjectAccessReview<br/>per API request"]
    end

    subgraph PseudoResources["mlflow.kubeflow.org Pseudo-Resources"]
        Experiments["mlflow.kubeflow.org<br/>experiments"]
        Runs["mlflow.kubeflow.org<br/>runs"]
        Models["mlflow.kubeflow.org<br/>registered-models"]
        Artifacts["mlflow.kubeflow.org<br/>artifacts"]
    end

    subgraph K8sResources["Kubernetes Resources Accessed"]
        Namespaces["core<br/>Namespaces<br/>(list, get)"]
        MLflowConfig["apiextensions<br/>MLflowConfig CRs<br/>(get, list, watch)"]
        SSAR_API["authentication.k8s.io<br/>SelfSubjectAccessReview<br/>(create)"]
    end

    SA -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -.->|"extended by"| ExtraNS
    Role -.->|"extended by"| ExtraCluster

    SA -->|"runtime auth via"| SSAR
    SSAR -->|"checks access to"| Experiments
    SSAR -->|"checks access to"| Runs
    SSAR -->|"checks access to"| Models
    SSAR -->|"checks access to"| Artifacts

    SA -->|"accesses"| Namespaces
    SA -->|"reads"| MLflowConfig
    SA -->|"creates"| SSAR_API

    style SA fill:#4a90e2,color:#fff
    style Role fill:#f5a623
    style ExtraNS fill:#f5a623
    style ExtraCluster fill:#f5a623
    style SSAR fill:#e74c3c,color:#fff
    style Experiments fill:#7ed321
    style Runs fill:#7ed321
    style Models fill:#7ed321
    style Artifacts fill:#7ed321
    style Namespaces fill:#dae8fc
    style MLflowConfig fill:#dae8fc
    style SSAR_API fill:#dae8fc
