graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mlflow<br/>ServiceAccount<br/>(release namespace)"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB
        BasicAuth["Basic Auth<br/>(username/password)"]
        K8sToken["Kubernetes Token<br/>(Bearer SA Token)"]
        K8sNamespaced["Kubernetes Namespaced<br/>(Bearer + X-MLFLOW-WORKSPACE)"]
    end

    subgraph HelmRBAC["Helm-Configurable RBAC"]
        direction TB

        subgraph ClusterScope["Cluster-Scoped"]
            ClusterRole["ClusterRole<br/>(cluster_rbac.extraRules)<br/>User-defined API groups,<br/>resources, and verbs"]
            CRB["ClusterRoleBinding"]
        end

        subgraph NamespaceScope["Namespace-Scoped"]
            Role["Role<br/>(namespace_rbac.extraRules)<br/>User-defined API groups,<br/>resources, and verbs"]
            RB["RoleBinding<br/>(release namespace)"]
        end
    end

    subgraph AppRBAC["Application-Level RBAC"]
        direction TB
        Permissions["MLflow Permissions System"]

        subgraph PermTypes["Permission Types"]
            READ["READ<br/>View experiments, runs,<br/>models, artifacts"]
            WRITE["WRITE<br/>Create/update experiments,<br/>runs, models"]
            MANAGE["MANAGE<br/>Admin operations,<br/>user management"]
        end

        subgraph Resources["Protected Resources"]
            Experiments["Experiments<br/>/api/2.0/mlflow/experiments/*"]
            Runs["Runs<br/>/api/2.0/mlflow/runs/*"]
            Models["Registered Models<br/>/api/2.0/mlflow/registered-models/*"]
            Artifacts["Artifacts<br/>/api/2.0/mlflow/artifacts/*"]
            GatewayEndpoints["AI Gateway<br/>/gateway/*"]
            MCPServers["MCP Servers<br/>/ajax-api/3.0/mlflow/mcp-servers/*"]
            Jobs["Jobs<br/>/ajax-api/3.0/jobs/*"]
        end
    end

    subgraph SecurityContext["Pod Security Context"]
        PodSec["runAsNonRoot: true<br/>readOnlyRootFilesystem: true<br/>seccompProfile: RuntimeDefault<br/>capabilities: drop ALL<br/>automountServiceAccountToken: false"]
    end

    subgraph SecretAccess["Secrets"]
        TLSSecret["mlflow-tls<br/>(kubernetes.io/tls)<br/>TLS cert for HTTPS"]
        DBSecret["mlflow-db-secret<br/>(Opaque)<br/>Database URI"]
        KEK["MLFLOW_CRYPTO_KEK_PASSPHRASE<br/>(Env var / Secret)<br/>AES-GCM-256 KEK<br/>Rotatable via mlflow crypto rotate-kek"]
    end

    %% Kubernetes RBAC bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| ClusterRole
    RB -->|"grants"| Role

    %% Auth enforcement
    BasicAuth -->|"validates"| Permissions
    K8sToken -->|"validates via<br/>K8s API 6443/TCP"| Permissions
    K8sNamespaced -->|"maps namespace<br/>to workspace"| Permissions

    %% Permission grants
    Permissions -->|"READ/WRITE/MANAGE"| Experiments
    Permissions -->|"READ/WRITE/MANAGE"| Runs
    Permissions -->|"READ/WRITE/MANAGE"| Models
    Permissions -->|"READ/WRITE/MANAGE"| Artifacts
    Permissions -->|"READ/WRITE/MANAGE"| GatewayEndpoints
    Permissions -->|"READ/WRITE/MANAGE"| MCPServers
    Permissions -->|"READ/WRITE/MANAGE"| Jobs

    %% Secret access
    SA -.->|"mounts"| TLSSecret
    SA -.->|"mounts"| DBSecret
    SA -.->|"env injection"| KEK

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style BasicAuth fill:#f5a623,color:#fff
    style K8sToken fill:#f5a623,color:#fff
    style K8sNamespaced fill:#f5a623,color:#fff
    style ClusterRole fill:#e74c3c,color:#fff
    style Role fill:#e74c3c,color:#fff
    style Permissions fill:#9b59b6,color:#fff
    style READ fill:#27ae60,color:#fff
    style WRITE fill:#f39c12,color:#fff
    style MANAGE fill:#e74c3c,color:#fff
    style PodSec fill:#34495e,color:#fff
    style TLSSecret fill:#c0392b,color:#fff
    style DBSecret fill:#c0392b,color:#fff
    style KEK fill:#c0392b,color:#fff
    style Experiments fill:#7ed321,color:#fff
    style Runs fill:#7ed321,color:#fff
    style Models fill:#7ed321,color:#fff
    style Artifacts fill:#7ed321,color:#fff
    style GatewayEndpoints fill:#7ed321,color:#fff
    style MCPServers fill:#7ed321,color:#fff
    style Jobs fill:#7ed321,color:#fff
