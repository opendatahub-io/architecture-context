graph LR
    OGX["OGX K8s Operator<br/>(ogx-k8s-operator)"]

    %% External Go Dependencies
    subgraph GoDeps["Go Dependencies"]
        ControllerRuntime["controller-runtime<br/>v0.23.3"]
        OpenshiftAPI["openshift/api<br/>v0.0.0-20260610"]
        OpenshiftCRCommon["openshift/controller-<br/>runtime-common<br/>v0.0.0-20260428"]
        PromOperator["prometheus-operator<br/>/apis/monitoring<br/>v0.82.0"]
        KustomizeAPI["kustomize/api<br/>v0.21.0"]
        GoContainerReg["go-containerregistry<br/>v0.21.7"]
    end

    OGX -->|"controller framework"| ControllerRuntime
    OGX -->|"OpenShift API types<br/>(config, security)"| OpenshiftAPI
    OGX -->|"TLS security profile"| OpenshiftCRCommon
    OGX -->|"ServiceMonitor/<br/>PrometheusRule types"| PromOperator
    OGX -->|"manifest rendering"| KustomizeAPI
    OGX -->|"OCI image label<br/>fetching"| GoContainerReg

    %% Internal Platform Dependencies
    subgraph PlatformDeps["Internal Platform Dependencies"]
        PlatformOp["rhods-operator /<br/>opendatahub-operator"]
        ODHPlatUtils["odh-platform-<br/>utilities"]
        ODHCA["ODH Trusted<br/>CA Bundle"]
    end

    OGX -->|"CRD Watch (OGX CR)<br/>component enable/disable"| PlatformOp
    OGX -->|"module contract,<br/>deployer, GC"| ODHPlatUtils
    OGX -->|"CA cert injection<br/>into OGX server pods"| ODHCA

    %% Infrastructure Dependencies
    subgraph InfraDeps["Infrastructure Dependencies"]
        CertManager["cert-manager<br/>(vanilla K8s)"]
        ServingCert["OpenShift service-<br/>serving-cert-signer"]
        PromCMO["Prometheus / CMO"]
        K8sAPI["Kubernetes API<br/>Server"]
        OCIRegistry["OCI Container<br/>Registries"]
        OSAPIServer["OpenShift APIServer CR"]
    end

    OGX -->|"webhook TLS cert<br/>(non-OpenShift)"| CertManager
    OGX -->|"webhook TLS cert<br/>(OpenShift)"| ServingCert
    OGX -->|"ServiceMonitor scrape<br/>8080/TCP, 9464/TCP"| PromCMO
    OGX -->|"resource CRUD,<br/>leader election"| K8sAPI
    OGX -->|"distribution config<br/>resolution"| OCIRegistry
    OGX -->|"cluster TLS profile"| OSAPIServer

    %% Downstream consumers (who depends on OGX)
    subgraph Consumers["Components That Depend on OGX"]
        OGXServer["OGX Server<br/>(managed workload)"]
    end

    OGX -->|"deploys & manages<br/>lifecycle"| OGXServer

    %% External Provider Dependencies (of managed OGX Server)
    subgraph ExternalProviders["External Provider Dependencies (OGX Server)"]
        InferenceProviders["Inference:<br/>vLLM, OpenAI, Azure,<br/>Bedrock, Vertex AI,<br/>Watsonx"]
        VectorProviders["Vector I/O:<br/>pgvector, Milvus,<br/>Qdrant"]
        ToolProviders["Tools & Storage:<br/>Brave Search, Tavily,<br/>S3, Docling"]
    end

    OGXServer -->|"inference requests<br/>HTTPS/443"| InferenceProviders
    OGXServer -->|"vector operations<br/>various ports"| VectorProviders
    OGXServer -->|"search, storage<br/>HTTPS/443"| ToolProviders

