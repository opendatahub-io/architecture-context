graph LR
    OGXOp["OGX K8s Operator<br/>(ogx-k8s-operator)"]

    %% External Framework Dependencies
    OGXOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    OGXOp -->|"manifest rendering"| Kustomize["kustomize/api<br/>v0.21.0"]
    OGXOp -->|"OCI image labels"| GoContainerReg["go-containerregistry<br/>v0.21.7"]
    OGXOp -->|"TLS profiles, SCC"| OpenShiftAPI["openshift/api<br/>v0.0.0-20260610"]
    OGXOp -->|"TLS config"| CtrlRuntimeCommon["openshift/controller-<br/>runtime-common<br/>v0.0.0-20260428"]
    OGXOp -.->|"metrics CRDs<br/>(conditional)"| PromOperator["prometheus-operator<br/>v0.82.0"]

    %% Internal Platform Dependencies
    OGXOp -->|"OGX CR lifecycle"| RhodsOp["rhods-operator /<br/>opendatahub-operator"]
    OGXOp -->|"CA trust bundle"| CABundle["odh-trusted-ca-bundle<br/>ConfigMap"]
    OGXOp -->|"webhook TLS cert"| CertMgr["cert-manager /<br/>OpenShift service-ca"]
    OGXOp -->|"metrics scraping<br/>& alerting"| Prometheus["Prometheus /<br/>OpenShift Monitoring"]

    %% Integration Points (inbound)
    RhodsOp -->|"creates OGX CR"| OGXOp

    %% External Services
    OGXOp -->|"image manifests"| OCIRegistry["OCI Container<br/>Registry"]
    OGXOp -->|"resource mgmt"| K8sAPI["Kubernetes API<br/>Server"]
    OGXOp -->|"TLS profile"| OSAPI["OpenShift API<br/>(config.openshift.io)"]
    OGXOp -->|"metrics auth"| KubeRBACProxy["kube-rbac-proxy<br/>Sidecar"]

    %% Managed workload dependencies
    OGXServer["OGX Distribution<br/>Server (managed)"]
    OGXOp -->|"deploys & manages"| OGXServer
    OGXServer -.->|"KV storage<br/>(optional)"| Redis["Redis<br/>6379/TCP"]
    OGXServer -.->|"SQL storage<br/>(optional)"| Postgres["PostgreSQL<br/>5432/TCP"]

    %% Legacy
    OGXOp -.->|"adoption migration"| LegacyLLSD["Legacy<br/>LlamaStackDistribution<br/>resources"]

    %% Styling
    style OGXOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External frameworks
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style Kustomize fill:#999,stroke:#333,color:#fff
    style GoContainerReg fill:#999,stroke:#333,color:#fff
    style OpenShiftAPI fill:#999,stroke:#333,color:#fff
    style CtrlRuntimeCommon fill:#999,stroke:#333,color:#fff
    style PromOperator fill:#999,stroke:#333,color:#fff

    %% Internal platform
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style CABundle fill:#7ed321,stroke:#333,color:#fff
    style CertMgr fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style OCIRegistry fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style OSAPI fill:#f5a623,stroke:#333,color:#fff
    style KubeRBACProxy fill:#f5a623,stroke:#333,color:#fff

    %% Managed
    style OGXServer fill:#4a90e2,stroke:#333,color:#fff
    style Redis fill:#ddd,stroke:#333
    style Postgres fill:#ddd,stroke:#333

    %% Legacy
    style LegacyLLSD fill:#f8cecc,stroke:#b85450
