graph LR
    OGXOperator["ogx-k8s-operator<br/>Go Operator"]

    %% External Dependencies (Build/Runtime)
    OGXOperator -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    OGXOperator -->|"API client"| ClientGo["client-go<br/>v0.35.2"]
    OGXOperator -->|"manifest rendering"| Kustomize["kustomize/api<br/>v0.21.0"]
    OGXOperator -->|"TLS profiles"| OpenShiftAPI["openshift/api"]
    OGXOperator -->|"TLS integration"| CRCommon["controller-runtime-common"]
    OGXOperator -->|"image parsing"| GoContainerReg["go-containerregistry<br/>v0.22.1"]
    OGXOperator -->|"monitoring CRDs"| PromOperatorAPI["prometheus-operator/api<br/>v0.82.0"]
    OGXOperator -->|"structured logging"| Zap["go.uber.org/zap<br/>v1.28.0"]

    %% Internal Platform Dependencies
    OGXOperator -->|"metrics proxy"| KubeRBACProxy["kube-rbac-proxy<br/>(odh-kube-auth-proxy)"]

    subgraph PlatformTier["Platform Tier"]
        OGXModule["ogx-module"]
        OGXModule -->|"platform helpers"| PlatformUtils["odh-platform-utilities"]
        OGXModule -->|"config mgmt"| Viper["spf13/viper<br/>v1.21.0"]
    end
    OGXModule -->|"deploys"| OGXOperator

    %% Runtime Dependencies
    OGXOperator -->|"CRD management"| PromOperator["prometheus-operator"]
    OGXOperator -->|"TLS certificates"| ServiceCA["OpenShift service-ca"]
    OGXOperator -->|"TLS config"| OpenShiftTLS["OpenShift TLS Profile<br/>config.openshift.io"]
    OGXOperator -->|"TLS certs (non-OCP)"| CertManager["cert-manager"]

    %% Integration Points (inbound)
    ODHPlatform["ODH/RHOAI<br/>Platform Operator"] -->|"manages via OGX CR"| OGXModule
    Prometheus["Prometheus"] -->|"scrapes /metrics"| OGXOperator

    %% Core dependency
    OGXOperator -->|"all reconciliation"| K8sAPI["Kubernetes API<br/>6443/TCP"]

