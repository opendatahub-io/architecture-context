graph LR
    OGX["OGX Distribution<br/>(ogx-core)"]

    %% External Dependencies (Required)
    OGX -->|"core framework<br/>v1.2.1+rhaiv.0"| OGXUpstream["OGX<br/>(opendatahub-io/ogx)"]
    OGX -->|"state storage<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    OGX -->|"runtime<br/>3.12"| Python["Python 3.12"]
    OGX -->|"package manager"| uv["uv"]

    %% Internal Platform Dependencies
    OGX -->|"inference backend<br/>HTTP/HTTPS"| vLLM["vLLM"]
    OGX -->|"vector storage<br/>5432/TCP"| pgvector["pgvector"]
    OGX -->|"vector storage<br/>HTTP/gRPC"| Milvus["Milvus"]
    OGX -->|"vector storage<br/>6333-6334/TCP"| Qdrant["Qdrant"]
    OGX -->|"document processing<br/>HTTP/HTTPS"| DoclingServe["Docling Serve"]
    OGX -->|"file storage<br/>443/TCP HTTPS"| S3["S3 / Object Storage"]

    %% Cloud Inference Providers (env-var activated)
    OGX -->|"cloud inference<br/>443/TCP"| Bedrock["AWS Bedrock"]
    OGX -->|"cloud inference<br/>443/TCP"| WatsonX["IBM WatsonX"]
    OGX -->|"cloud inference<br/>443/TCP"| AzureOAI["Azure OpenAI"]
    OGX -->|"cloud inference<br/>443/TCP"| VertexAI["Google Vertex AI"]
    OGX -->|"cloud inference<br/>443/TCP"| OpenAI["OpenAI API"]
    OGX -->|"cloud inference<br/>443/TCP"| Gemini["Google Gemini"]
    OGX -->|"cloud inference<br/>443/TCP"| Anthropic["Anthropic API"]

    %% Tool Integrations
    OGX -->|"web search<br/>443/TCP"| Brave["Brave Search"]
    OGX -->|"web search<br/>443/TCP"| Tavily["Tavily Search"]
    OGX -.->|"tool execution<br/>configurable"| MCP["MCP Servers"]

    %% Observability (optional)
    OGX -.->|"traces/metrics<br/>OTLP"| OTEL["OTEL Collector"]

    %% Auth
    OGX -.->|"JWT validation<br/>443/TCP"| JWKS["JWKS Endpoint"]

    %% Platform management (inbound)
    Operator["rhods-operator /<br/>opendatahub-operator"] -->|"deploys & manages"| OGX
    BaseImage["AIPCC Base Image<br/>cpu:3.5.0"] -.->|"base layer"| OGX

    %% Styling
    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external deps
    style OGXUpstream fill:#4a90e2,stroke:#333,color:#fff
    style PostgreSQL fill:#4a90e2,stroke:#333,color:#fff
    style Python fill:#999,stroke:#333,color:#fff
    style uv fill:#999,stroke:#333,color:#fff

    %% Internal platform
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style pgvector fill:#7ed321,stroke:#333,color:#fff
    style Milvus fill:#7ed321,stroke:#333,color:#fff
    style Qdrant fill:#7ed321,stroke:#333,color:#fff
    style DoclingServe fill:#7ed321,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333

    %% Cloud providers
    style Bedrock fill:#f5a623,stroke:#333
    style WatsonX fill:#f5a623,stroke:#333
    style AzureOAI fill:#f5a623,stroke:#333
    style VertexAI fill:#f5a623,stroke:#333
    style OpenAI fill:#f5a623,stroke:#333
    style Gemini fill:#f5a623,stroke:#333
    style Anthropic fill:#f5a623,stroke:#333

    %% Tools
    style Brave fill:#e74c3c,stroke:#333,color:#fff
    style Tavily fill:#e74c3c,stroke:#333,color:#fff
    style MCP fill:#e74c3c,stroke:#333,color:#fff

    %% Observability
    style OTEL fill:#999,stroke:#333,color:#fff
    style JWKS fill:#9b59b6,stroke:#333,color:#fff

    %% Platform
    style Operator fill:#7ed321,stroke:#333,color:#fff
    style BaseImage fill:#e8e8e8,stroke:#333
