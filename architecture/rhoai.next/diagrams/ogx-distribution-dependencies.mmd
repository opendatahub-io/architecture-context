graph LR
    OGX["OGX Distribution<br/>AI/ML API Server<br/>8321/TCP"]

    %% Internal Platform Dependencies
    subgraph InternalPlatform["Internal Platform (RHOAI)"]
        direction TB
        Operator["rhods-operator<br/>(deploys OGX)"]
        vLLM["vLLM ServingRuntime<br/>(inference + embedding)"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        Milvus["Milvus<br/>(vector DB)"]
        OIDC["OAuth2/OIDC Provider<br/>(e.g., Keycloak)"]
    end

    %% External Cloud Inference Providers
    subgraph CloudInference["Cloud Inference Providers"]
        direction TB
        OpenAI["OpenAI<br/>HTTPS/443"]
        Bedrock["AWS Bedrock<br/>HTTPS/443"]
        Azure["Azure OpenAI<br/>HTTPS/443"]
        VertexAI["Google Vertex AI<br/>HTTPS/443"]
        WatsonX["IBM WatsonX<br/>HTTPS/443"]
        Gemini["Google Gemini<br/>HTTPS/443"]
        Anthropic["Anthropic<br/>HTTPS/443"]
    end

    %% Vector Storage
    subgraph VectorStorage["Vector Databases"]
        direction TB
        pgvector["pgvector<br/>5432/TCP"]
        Qdrant["Qdrant<br/>6333/6334 TCP"]
    end

    %% Tool Services
    subgraph ToolServices["Tool Services"]
        direction TB
        Brave["Brave Search<br/>HTTPS/443"]
        Tavily["Tavily Search<br/>HTTPS/443"]
        Docling["Docling Serve<br/>HTTP/HTTPS"]
        MCP["MCP Servers<br/>varies"]
    end

    %% Storage Services
    subgraph StorageServices["File & Object Storage"]
        direction TB
        S3["S3-compatible Storage<br/>HTTPS/443"]
    end

    %% Build Dependencies
    subgraph BuildDeps["Build-Time Dependencies"]
        direction TB
        OGXFramework["OGX Framework<br/>v1.2.1+rhaiv.0"]
        Python["Python 3.12"]
        UV["uv (package manager)"]
        RHAI["RHAI PyPI Index<br/>packages.redhat.com"]
        Hermeto["Hermeto/Cachi2<br/>(hermetic prefetch)"]
    end

    %% Pre-fetched Models
    subgraph EmbeddedModels["Pre-fetched Models (in-image)"]
        direction TB
        GraniteEmb["Granite Embedding<br/>125m-english"]
        DoclingModels["Docling v2.3.0"]
        RapidOCR["RapidOCR v3.8.0"]
        Tiktoken["tiktoken cl100k_base"]
    end

    %% Observability
    OTel["OpenTelemetry Collector<br/>OTLP"]

    %% Internal dependencies
    Operator -->|deploys| OGX
    OGX -->|inference & embedding| vLLM
    OGX -->|persistent storage| PostgreSQL
    OGX -->|vector storage| Milvus
    OGX -->|JWT validation| OIDC

    %% Cloud inference
    OGX -->|inference| OpenAI
    OGX -->|inference| Bedrock
    OGX -->|inference| Azure
    OGX -->|inference| VertexAI
    OGX -->|inference| WatsonX
    OGX -->|inference| Gemini
    OGX -->|inference| Anthropic

    %% Vector DBs
    OGX -->|vector storage| pgvector
    OGX -->|vector storage| Qdrant

    %% Tools
    OGX -->|web search| Brave
    OGX -->|web search| Tavily
    OGX -->|doc processing| Docling
    OGX -->|tool calls| MCP

    %% Storage
    OGX -->|file storage| S3

    %% Observability
    OGX -.->|traces & metrics| OTel

    %% Build deps
    OGXFramework -.->|runtime framework| OGX
    Python -.->|runtime| OGX
    UV -.->|build-time| OGX
    RHAI -.->|build-time packages| OGX
    Hermeto -.->|hermetic build| OGX

    %% Embedded
    GraniteEmb -.->|in-image| OGX
    DoclingModels -.->|in-image| OGX
    RapidOCR -.->|in-image| OGX
    Tiktoken -.->|in-image| OGX

