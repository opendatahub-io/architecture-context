graph LR
    OGX["OGX Distribution<br/>(ogx-core)"]

    %% Core Dependencies (Required)
    OGX -->|"core framework<br/>v1.4.0+rhaiv.1"| OGXFramework["OGX Framework<br/>(opendatahub-io/ogx)"]
    OGX -->|"persistent storage<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    OGX -->|"runtime"| Python["Python 3.12"]

    %% Inference Providers (Conditional)
    OGX -->|"primary inference"| vLLM["vLLM"]
    OGX -.->|"remote inference"| OpenAI["OpenAI API"]
    OGX -.->|"remote inference"| AnthropicAPI["Anthropic API"]
    OGX -.->|"remote inference"| AzureAI["Azure OpenAI"]
    OGX -.->|"remote inference"| Bedrock["AWS Bedrock"]
    OGX -.->|"remote inference"| WatsonX["IBM WatsonX"]
    OGX -.->|"remote inference"| VertexAI["Google Vertex AI"]
    OGX -.->|"remote inference"| Gemini["Google Gemini"]
    OGX -.->|"local embedding"| SentenceTransformers["sentence-transformers<br/>(dep-only)"]

    %% Vector Store Providers (Conditional)
    OGX -.->|"vector storage"| Milvus["Milvus"]
    OGX -.->|"vector storage"| PGVector["pgvector"]
    OGX -.->|"vector storage"| Qdrant["Qdrant"]
    OGX -.->|"local vector"| FAISS["FAISS (dep-only)"]
    OGX -.->|"local vector"| MilvusLite["milvus-lite (dep-only)"]

    %% Tool Runtimes (Conditional)
    OGX -.->|"web search"| BraveSearch["Brave Search API"]
    OGX -.->|"web search"| Tavily["Tavily Search API"]
    OGX -.->|"document processing"| Docling["docling (bundled)"]
    OGX -.->|"file storage"| S3["S3 Storage"]

    %% Internal Platform Dependencies
    OGXOperator["ogx-operator"] -->|"lifecycle mgmt"| OGX
    Prometheus["Prometheus /<br/>OpenShift Monitoring"] -->|"scrapes /metrics"| OGX
    OGX -.->|"optional tracing"| OTEL["OpenTelemetry"]

    %% Build Dependencies
    subgraph BuildDeps["Build Infrastructure"]
        direction TB
        AIPCC["AIPCC Base Image<br/>cpu-el9.8:3.6.0-ea.2"]
        Modelcar["Modelcar OCI<br/>Pre-scanned artifacts"]
        Cachi2["Hermeto/cachi2<br/>Hermetic prefetch"]
        UV["uv<br/>Package manager"]
    end
    OGX -.->|"image base"| AIPCC
    OGX -.->|"ML artifacts"| Modelcar

    %% Consumers
    Praxis["Praxis Proxy"] -->|"multi-tenant routing"| OGX

