graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph EnvoyZone["INGRESS (Envoy Proxy)"]
        Envoy["Envoy Proxy<br/>443/TCP<br/>TLS 1.2+<br/>Gateway or Standalone mode"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph EPPZone["EPP Service — Namespace: ${NAMESPACE}"]
            EPP["Endpoint Picker (EPP)<br/>SA: ${EPP_NAME}<br/>Image: llm-d-router-epp<br/>(distroless/static)"]
            EPPPorts["Ports:<br/>9002/TCP gRPC ext-proc (TLS optional)<br/>9003/TCP gRPC health (TLS optional)<br/>9090/TCP HTTP metrics<br/>5557/TCP ZMQ subscriber"]
        end

        subgraph CoordZone["Coordinator Service"]
            Coordinator["Coordinator<br/>Image: llm-d-router-coordinator<br/>(distroless/static)"]
            CoordPorts["Ports:<br/>8080/TCP HTTPS inference (TLS 1.2+)<br/>9090/TCP HTTP/HTTPS metrics"]
        end

        subgraph SidecarZone["PD-Sidecar (pod-level)"]
            Sidecar["PD-Sidecar<br/>Image: llm-d-router-sidecar<br/>(distroless/static)"]
            SidecarPort["Port:<br/>8000/TCP HTTP/HTTPS reverse proxy"]
        end

        subgraph Workers["Model Server Pods"]
            ModelPods["Model Server Pods<br/>(metrics, DCGM, models)"]
            PrefillWorker["Prefill Workers"]
            EncodeWorker["Encode Workers"]
            DecodeServer["Decode Server<br/>(co-located with sidecar)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>ServiceAccount"]
        Redis["Redis<br/>6379/TCP<br/>TCP (no encryption)"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable TLS"]
        InfGateway["Inference Gateway<br/>80/TCP<br/>HTTP/HTTPS"]
        RenderSvc["Rendering Service<br/>8080/TCP<br/>HTTP (no encryption)"]
    end

    %% External to Envoy
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Auth: Varies"| Envoy

    %% Envoy to EPP
    Envoy -->|"gRPC/9002<br/>Optional TLS<br/>Auth: None"| EPP

    %% EPP egress
    EPP -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    EPP -->|"HTTP(S)/configurable<br/>InsecureSkipVerify=true<br/>Auth: None"| ModelPods
    EPP -.->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Envoy to model pods (post-routing)
    Envoy -->|"HTTP(S)/configurable<br/>Routed by EPP headers"| ModelPods

    %% Coordinator flows
    Client -->|"HTTPS/8080<br/>TLS 1.2+<br/>Auth: None"| Coordinator
    Coordinator -->|"HTTP/80<br/>Configurable TLS<br/>Auth: None"| InfGateway
    Coordinator -->|"HTTP/8080<br/>No encryption<br/>Auth: None"| RenderSvc
    Coordinator -->|"TCP/6379<br/>No encryption<br/>Auth: None"| Redis
    Coordinator -.->|"OTLP/gRPC<br/>Configurable"| OTel

    %% Sidecar flows
    Sidecar -->|"HTTP(S)/configurable<br/>TLS per-stage InsecureSkipVerify<br/>Auth: None"| PrefillWorker
    Sidecar -->|"HTTP(S)/configurable<br/>TLS per-stage InsecureSkipVerify<br/>Auth: None"| EncodeWorker
    Sidecar -->|"HTTP(S)/configurable<br/>TLS per-stage InsecureSkipVerify<br/>Auth: None"| DecodeServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workers fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Envoy ingress
    class EPP,Coordinator,Sidecar internal
    class ModelPods,PrefillWorker,EncodeWorker,DecodeServer workers
    class K8sAPI,Redis,OTel,InfGateway,RenderSvc externalservice
