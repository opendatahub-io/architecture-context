graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS, HF_TOKEN"]
        DatasetsServer["HF Datasets Server<br/>datasets-server.huggingface.co<br/>443/TCP HTTPS<br/>TLS"]
        S3["S3-Compatible Storage<br/>Configured endpoint<br/>HTTPS<br/>TLS (AWS_CA_BUNDLE)<br/>AWS IAM credentials"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        subgraph OperatorNS["Namespace: operator"]
            TrustyAI["trustyai-service-operator<br/>SA: controller-manager"]
        end

        subgraph JobNS["Namespace: job namespace"]
            subgraph JobPod["lmes-job Pod (UID 65532)"]
                MainPy["main.py LMEvalAdapter"]
                LMEval["lm_eval engine"]
                S3Downloader["s3_downloader.py"]
            end
            ConfigMap["ConfigMap<br/>/meta/job.json"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        ModelEndpoint["Model Inference Endpoint<br/>Configured port<br/>HTTPS<br/>TLS (custom CA)<br/>Bearer token"]
        EvalHubSvc["EvalHub Service<br/>Configured port<br/>HTTPS<br/>TLS<br/>Bearer token"]
        OCIRegistry["OCI Registry<br/>Configured port<br/>HTTPS<br/>TLS<br/>Registry credentials"]
        MLflowSvc["MLflow<br/>Configured port<br/>HTTPS<br/>TLS<br/>Bearer token"]
    end

    %% Operator creates job
    TrustyAI -->|"Creates K8s Job<br/>ServiceAccount"| JobPod

    %% Job reads config
    ConfigMap -->|"Filesystem mount<br/>No network"| MainPy

    %% Outbound connections from job
    LMEval -->|"HTTPS<br/>TLS (custom CA supported)<br/>Bearer token (OPENAI_API_KEY)"| ModelEndpoint
    MainPy -->|"HTTPS<br/>TLS<br/>Bearer token"| EvalHubSvc
    LMEval -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN (optional)"| HFHub
    LMEval -->|"HTTPS/443<br/>TLS"| DatasetsServer
    S3Downloader -->|"HTTPS<br/>TLS (AWS_CA_BUNDLE)<br/>AWS IAM"| S3
    MainPy -->|"HTTPS<br/>TLS<br/>Registry credentials"| OCIRegistry
    MainPy -->|"HTTPS<br/>TLS<br/>Bearer token"| MLflowSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef job fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class HFHub,DatasetsServer,S3 external
    class TrustyAI cluster
    class ModelEndpoint,EvalHubSvc,OCIRegistry,MLflowSvc platform
    class MainPy,LMEval,S3Downloader,ConfigMap job
