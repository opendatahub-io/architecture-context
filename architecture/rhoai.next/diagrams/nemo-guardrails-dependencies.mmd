graph LR
    NemoGuardrails["NeMo Guardrails<br/>Guardrails Server"]

    %% Core Framework Dependencies
    NemoGuardrails -->|"HTTP framework"| FastAPI["FastAPI >=0.103.0"]
    NemoGuardrails -->|"ASGI server"| Uvicorn["Uvicorn >=0.23"]
    NemoGuardrails -->|"validation"| Pydantic["Pydantic >=2.5,<3.0"]
    NemoGuardrails -->|"async HTTP client<br/>(engine outbound)"| aiohttp["aiohttp >=3.10.11"]
    NemoGuardrails -->|"async HTTP client<br/>(LLM providers)"| httpx["httpx >=0.24.1"]

    %% Colang / NLP Dependencies
    NemoGuardrails -->|"Colang parser"| Lark["lark >=1.1.7"]
    NemoGuardrails -->|"prompt templates"| Jinja2["Jinja2 >=3.1.6"]
    NemoGuardrails -.->|"NLP pipeline"| spaCy["spaCy >=3.4.4"]
    NemoGuardrails -.->|"tokenization"| NLTK["nltk >=3.8"]

    %% Embedding Dependencies
    NemoGuardrails -->|"ONNX embeddings<br/>(all-MiniLM-L6-v2)"| FastEmbed["fastembed >=0.2.2"]
    FastEmbed -->|"ONNX backend"| ONNXRuntime["onnxruntime >=1.17.0"]
    NemoGuardrails -.->|"alt embeddings"| SentenceTransformers["sentence-transformers >=2.2.0"]
    SentenceTransformers -.->|"ML backend"| PyTorch["torch >=2.0.0"]

    %% LLM Provider SDKs
    NemoGuardrails -.->|"OpenAI SDK"| OpenAISDK["openai >=1.0.0,<3.0.0"]
    NemoGuardrails -.->|"framework adapter"| LangChain["langchain >=0.2.14"]

    %% Observability
    NemoGuardrails -.->|"tracing API"| OTelAPI["opentelemetry-api >=1.27.0"]
    NemoGuardrails -.->|"auto-instrumentation"| OTelDistro["opentelemetry-distro >=0.48b0"]

    %% Crypto (transitive)
    NemoGuardrails -->|"TLS/crypto (transitive)"| Cryptography["cryptography ==46.0.7"]

    %% External Services (not Python deps)
    NemoGuardrails ==>|"HTTPS/443<br/>Bearer Token"| OpenAI["OpenAI API<br/>api.openai.com"]
    NemoGuardrails ==>|"HTTPS/443<br/>Bearer (nvapi-*)"| NIM["NVIDIA NIM<br/>integrate.api.nvidia.com"]
    NemoGuardrails ==>|"HTTPS/443<br/>API Key"| AzureOAI["Azure OpenAI<br/>*.openai.azure.com"]
    NemoGuardrails ==>|"HTTPS/443<br/>x-api-key"| Anthropic["Anthropic API<br/>api.anthropic.com"]
    NemoGuardrails ==>|"HTTPS/443<br/>Bearer Token"| Cohere["Cohere API<br/>api.cohere.com"]
    NemoGuardrails ==>|"HTTPS/443<br/>API Key"| Google["Google Gemini API"]
    NemoGuardrails ==>|"gRPC<br/>network-trusted"| Triton["Triton Inference Server<br/>(TRT-LLM)"]
    NemoGuardrails ==>|"Redis/6379"| Redis["Redis (optional)"]

    %% No Internal RHOAI Dependencies
    %% NeMo Guardrails is a standalone service with no direct
    %% dependencies on other RHOAI platform components

    %% Styling
    style NemoGuardrails fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core deps (required)
    style FastAPI fill:#2ecc71,stroke:#27ae60
    style Uvicorn fill:#2ecc71,stroke:#27ae60
    style Pydantic fill:#2ecc71,stroke:#27ae60
    style aiohttp fill:#2ecc71,stroke:#27ae60
    style httpx fill:#2ecc71,stroke:#27ae60
    style FastEmbed fill:#2ecc71,stroke:#27ae60
    style ONNXRuntime fill:#2ecc71,stroke:#27ae60
    style Lark fill:#2ecc71,stroke:#27ae60
    style Jinja2 fill:#2ecc71,stroke:#27ae60
    style Cryptography fill:#2ecc71,stroke:#27ae60

    %% Optional deps
    style spaCy fill:#bdc3c7,stroke:#95a5a6
    style NLTK fill:#bdc3c7,stroke:#95a5a6
    style SentenceTransformers fill:#bdc3c7,stroke:#95a5a6
    style PyTorch fill:#bdc3c7,stroke:#95a5a6
    style OpenAISDK fill:#bdc3c7,stroke:#95a5a6
    style LangChain fill:#bdc3c7,stroke:#95a5a6
    style OTelAPI fill:#bdc3c7,stroke:#95a5a6
    style OTelDistro fill:#bdc3c7,stroke:#95a5a6

    %% External services
    style OpenAI fill:#f5a623,stroke:#e09612
    style NIM fill:#76b900,stroke:#5a8f00,color:#fff
    style AzureOAI fill:#f5a623,stroke:#e09612
    style Anthropic fill:#f5a623,stroke:#e09612
    style Cohere fill:#f5a623,stroke:#e09612
    style Google fill:#f5a623,stroke:#e09612
    style Triton fill:#f5a623,stroke:#e09612
    style Redis fill:#d63029,stroke:#b32520,color:#fff
