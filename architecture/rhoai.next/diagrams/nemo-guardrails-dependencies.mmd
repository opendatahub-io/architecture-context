graph LR
    NemoGR["NeMo Guardrails<br/>(FastAPI Service)"]

    %% Runtime Dependencies
    NemoGR -->|"HTTP API framework"| FastAPI["FastAPI >=0.103"]
    NemoGR -->|"ASGI server"| Uvicorn["uvicorn >=0.23"]
    NemoGR -->|"LLM client"| OpenAI["openai >=1.0,<3.0"]
    NemoGR -->|"request validation"| Pydantic["pydantic >=2.5,<3.0"]
    NemoGR -->|"Colang parser"| Lark["lark >=1.1.7"]
    NemoGR -->|"async HTTP"| Aiohttp["aiohttp >=3.10"]
    NemoGR -->|"embeddings"| FastEmbed["fastembed >=0.2.2"]
    NemoGR -->|"ONNX inference"| ONNXRuntime["onnxruntime >=1.17"]

    %% Optional ML Dependencies
    NemoGR -.->|"ML inference"| Torch["torch >=2.0"]
    NemoGR -.->|"model loading"| Transformers["transformers >=4.35"]
    NemoGR -.->|"sentence embeddings"| SentenceTransformers["sentence-transformers >=2.2"]
    NemoGR -.->|"NLP pipeline"| SpaCy["spaCy >=3.4,<4.0"]

    %% Optional Security Dependencies
    NemoGR -.->|"PII detection"| Presidio["presidio-analyzer >=2.2"]
    NemoGR -.->|"jailbreak patterns"| Yara["yara-python >=4.5,<5.0"]

    %% Optional Observability
    NemoGR -.->|"distributed tracing"| OTelAPI["opentelemetry-api >=1.27"]
    NemoGR -.->|"FastAPI tracing"| OTelFastAPI["opentelemetry-instrumentation-fastapi"]
    NemoGR -.->|"OTLP export"| OTelExporter["opentelemetry-exporter-otlp"]

    %% Transitive
    NemoGR -.->|"TLS/crypto (transitive)"| Cryptography["cryptography ==46.0.7<br/>(uses system OpenSSL)"]

    %% Platform Dependencies
    LLMServer["LLM Inference Server<br/>(vLLM, TGI, etc.)"] -->|"backend LLM"| NemoGR
    AzureOpenAI["Azure OpenAI"] -->|"alt LLM/embedding"| NemoGR

    %% Integration Points
    SafetyAPIs["Third-Party Safety APIs<br/>(ActiveFence, Pangea,<br/>CrowdStrike, etc.)"] -->|"external guardrails"| NemoGR
    OTelCollector["OpenTelemetry Collector"] -->|"trace collection"| NemoGR

    %% Baked-in Models
    NemoGR -->|"baked at build time"| ModelCars["Modelcar ML Models<br/>(MiniLM, Snowflake Arctic,<br/>spaCy, NLTK, DeBERTa,<br/>Granite Guardian HAP)"]

    %% Styling
    style NemoGR fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style FastAPI fill:#7ed321,stroke:#333
    style Uvicorn fill:#7ed321,stroke:#333
    style OpenAI fill:#7ed321,stroke:#333
    style Pydantic fill:#7ed321,stroke:#333
    style Lark fill:#7ed321,stroke:#333
    style Aiohttp fill:#7ed321,stroke:#333
    style FastEmbed fill:#7ed321,stroke:#333
    style ONNXRuntime fill:#7ed321,stroke:#333
    style Torch fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style Transformers fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style SentenceTransformers fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style SpaCy fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style Presidio fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style Yara fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style OTelAPI fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style OTelFastAPI fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style OTelExporter fill:#c8e6c9,stroke:#333,stroke-dasharray: 5 5
    style Cryptography fill:#e0e0e0,stroke:#333,stroke-dasharray: 5 5
    style LLMServer fill:#f5a623,stroke:#333
    style AzureOpenAI fill:#f5a623,stroke:#333
