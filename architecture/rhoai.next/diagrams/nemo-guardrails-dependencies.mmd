graph LR
    NemoGuardrails["NeMo Guardrails<br/>Server"]

    %% External Dependencies (Libraries/Frameworks)
    subgraph CoreDeps["Core Dependencies"]
        FastAPI["FastAPI >=0.103.0"]
        Uvicorn["Uvicorn >=0.23"]
        Pydantic["Pydantic >=2.5,<3.0"]
        httpx["httpx >=0.24.1"]
        aiohttp["aiohttp >=3.10.11"]
        Lark["Lark >=1.1.7"]
        Jinja2["Jinja2 >=3.1.6"]
    end

    subgraph MLDeps["ML/Embedding Dependencies"]
        FastEmbed["FastEmbed >=0.2.2"]
        ONNXRuntime["ONNX Runtime >=1.17.0"]
        PyTorch["PyTorch >=2.0.0 (CPU)"]
        SentenceTransformers["sentence-transformers >=2.2.0"]
        NLTK["NLTK >=3.8"]
    end

    subgraph SecurityDeps["Security/NLP Dependencies"]
        spaCy["spaCy >=3.4.4<br/>+ en_core_web_lg"]
        Presidio["Presidio Analyzer/<br/>Anonymizer >=2.2"]
        YARA["YARA Python >=4.5.1"]
    end

    subgraph OptionalDeps["Optional Dependencies"]
        OpenTelemetry["OpenTelemetry >=1.27.0"]
    end

    NemoGuardrails --> FastAPI
    NemoGuardrails --> Uvicorn
    NemoGuardrails --> Pydantic
    NemoGuardrails --> httpx
    NemoGuardrails --> aiohttp
    NemoGuardrails --> Lark
    NemoGuardrails --> Jinja2
    NemoGuardrails --> FastEmbed
    NemoGuardrails --> ONNXRuntime
    NemoGuardrails --> PyTorch
    NemoGuardrails --> SentenceTransformers
    NemoGuardrails --> NLTK
    NemoGuardrails --> spaCy
    NemoGuardrails --> Presidio
    NemoGuardrails -.-> YARA
    NemoGuardrails -.-> OpenTelemetry

    %% Internal Platform Dependencies
    subgraph PlatformDeps["Internal Platform Dependencies"]
        UpstreamLLM["Upstream LLM Service<br/>(vLLM / NVIDIA NIM)"]
        OTelCollector["OpenTelemetry Collector"]
    end

    NemoGuardrails -->|"REST API (HTTPS/443)<br/>Bearer Token"| UpstreamLLM
    NemoGuardrails -.->|"OTLP (gRPC/HTTP)"| OTelCollector

    %% Integration Points (services that integrate WITH NeMo Guardrails)
    subgraph Integrations["Integration Points"]
        JailbreakSvc["Jailbreak Detection<br/>Service"]
        AlignScoreSvc["AlignScore Service"]
        Redis["Redis"]
        LangChain["LangChain<br/>(in-process)"]
    end

    NemoGuardrails -->|"HTTP/1337"| JailbreakSvc
    NemoGuardrails -->|"HTTP/5000"| AlignScoreSvc
    NemoGuardrails -.->|"TCP/6379"| Redis
    NemoGuardrails -.->|"Library API"| LangChain

    %% External Services
    subgraph ExtServices["External Services"]
        HFHub["HuggingFace Hub"]
        NVTelemetry["NVIDIA Telemetry"]
    end

    NemoGuardrails -.->|"HTTPS/443<br/>(pre-fetched at build)"| HFHub
    NemoGuardrails -.->|"HTTPS/443<br/>(disabled via DO_NOT_TRACK)"| NVTelemetry

