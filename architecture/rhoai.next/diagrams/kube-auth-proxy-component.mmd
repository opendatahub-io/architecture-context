graph TB
    subgraph KAP["kube-auth-proxy"]
        direction TB
        OAuthProxy["OAuthProxy<br/>(gorilla/mux + alice middleware)"]
        TokenReview["TokenReviewValidator<br/>(singleflight + TTL cache)"]
        OpenShiftProv["OpenShiftProvider<br/>(auto-discovery, custom CA)"]
        OIDCProv["OIDCProvider<br/>(ID token verification, refresh)"]
        MetricsServer["Metrics Server<br/>(Prometheus /metrics)"]
        MLflowHandler["MLflowHandler<br/>(auth-denied JSON errors)"]

        OAuthProxy -->|K8s token chain| TokenReview
        OAuthProxy -->|OAuth2 flow| OpenShiftProv
        OAuthProxy -->|OIDC flow| OIDCProv
        OAuthProxy -->|unauthenticated MLflow| MLflowHandler
    end

    Client["User Browser"] -->|HTTP/HTTPS :4180| OAuthProxy
    SDKClient["MLflow SDK / API Client"] -->|Bearer token :4180| OAuthProxy
    EnvoyProxy["Envoy Proxy"] -->|ext_authz /oauth2/auth| OAuthProxy

    TokenReview -->|TokenReview API :6443| K8sAPI["Kubernetes API Server"]
    OpenShiftProv -->|OAuth2 :443| OAuthOIDC["OpenShift OAuth Server"]
    OIDCProv -->|OIDC :443| ExtOIDC["External OIDC Provider"]
    OAuthProxy -->|proxied requests| Upstream["Upstream Application"]
    OAuthProxy -.->|sessions| Redis["Redis / Valkey"]

    style OAuthProxy fill:#4a90e2,color:#fff
    style TokenReview fill:#4a90e2,color:#fff
    style OpenShiftProv fill:#4a90e2,color:#fff
    style OIDCProv fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style MLflowHandler fill:#4a90e2,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OAuthOIDC fill:#e8e8e8,stroke:#333
    style ExtOIDC fill:#e8e8e8,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style Upstream fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#333
    style SDKClient fill:#f9f9f9,stroke:#333
    style EnvoyProxy fill:#7ed321,stroke:#333
