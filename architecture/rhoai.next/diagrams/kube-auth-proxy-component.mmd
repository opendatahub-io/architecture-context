graph TB
    subgraph "kube-auth-proxy"
        direction TB

        subgraph "Pre-Auth Chain"
            ScopeInjection[Scope Injection]
            HTTPSRedirect[HTTPS Redirect]
            HealthChecks[Health Checks<br/>/ping, /ready]
            Logging[Request Logging]
            Metrics[Metrics Collection]
        end

        subgraph "Session Chain (Authentication)"
            K8sTokenReview[K8s TokenReview<br/>Validator]
            OAuthBearer[OAuth Bearer<br/>Session Loader]
            JWTBearer[JWT Bearer<br/>Session Loader]
            BasicAuth[Basic Auth<br/>(htpasswd)]
            StoredSession[Stored Session<br/>Loader]
        end

        subgraph "Providers"
            OIDCProvider[OIDC Provider<br/>pkg/providers/oidc]
            OpenShiftProvider[OpenShift Provider<br/>providers/openshift.go]
        end

        subgraph "Session Storage"
            CookieStore[Cookie Store<br/>AES-CFB + HMAC<br/>4KB auto-split]
            RedisStore[Redis Store<br/>AES-GCM per-ticket<br/>Standalone/Sentinel/Cluster]
        end

        subgraph "Special Handlers"
            ExtAuthz[ext_authz Endpoint<br/>/oauth2/auth<br/>202/401/403]
            MLflowDeny[MLflow Auth Deny<br/>JSON error responses]
        end

        HeadersChain[Headers Chain<br/>X-Forwarded-User/Email/Access-Token]
    end

    Client[Client Browser / CLI] -->|HTTP 4180/TCP<br/>or HTTPS 4443/TCP| ScopeInjection
    ScopeInjection --> HTTPSRedirect
    HTTPSRedirect --> HealthChecks
    HealthChecks --> Logging
    Logging --> Metrics

    Metrics --> K8sTokenReview
    K8sTokenReview -->|no match| OAuthBearer
    OAuthBearer -->|no match| JWTBearer
    JWTBearer -->|no match| BasicAuth
    BasicAuth -->|no match| StoredSession

    StoredSession -->|OIDC session| OIDCProvider
    StoredSession -->|OpenShift session| OpenShiftProvider

    K8sTokenReview -->|authenticated| HeadersChain
    OAuthBearer -->|authenticated| HeadersChain
    JWTBearer -->|authenticated| HeadersChain
    BasicAuth -->|authenticated| HeadersChain
    StoredSession -->|authenticated| HeadersChain

    OIDCProvider -->|token exchange| ExtOIDC[OIDC Provider<br/>443/TCP HTTPS]
    OpenShiftProvider -->|OAuth flow| ExtOAuth[OpenShift OAuth<br/>443/TCP HTTPS]
    K8sTokenReview -->|TokenReview API| K8sAPI[Kubernetes API<br/>443/TCP HTTPS]

    StoredSession --> CookieStore
    StoredSession --> RedisStore
    RedisStore -->|TCP 6379/6380| Redis[Redis Server]

    Envoy[Envoy Gateway] -->|ext_authz subrequest| ExtAuthz
    ExtAuthz -->|202 Accept / 401 / 403| Envoy

    HeadersChain -->|proxy pass| Upstream[Upstream Application]
    MLflowDeny -.->|JSON error on 401| MLflowSDK[MLflow Python SDK]

    MetricsScrape[Prometheus] -->|scrape 8090/TCP| Metrics

