graph TB
    subgraph KAP["kube-auth-proxy"]
        direction TB

        subgraph Middleware["Middleware Chain"]
            PreAuth["Pre-Auth Middleware<br/>(HTTPS redirect, health checks,<br/>request logging, metrics)"]
            SessionLoad["Session Loading Chain<br/>(K8s token → JWT/OAuth bearer<br/>→ Basic auth → Stored session)"]
            AuthDecision["Authentication Decision"]
            RouteHandler["Route Handler<br/>(proxy, sign-in, callback, etc.)"]
            HeaderInjection["Response Header Injection<br/>(X-Forwarded-User, Email, Groups)"]
        end

        subgraph Providers["Authentication Providers"]
            OIDCProvider["OIDC Provider Module<br/>(OpenID Connect flows,<br/>PKCE, JWT verification)"]
            OSProvider["OpenShift OAuth Module<br/>(SA auto-detection,<br/>user validation)"]
        end

        subgraph Validators["Token Validators"]
            K8sValidator["K8s TokenReview<br/>Validator"]
            HtpasswdValidator["htpasswd<br/>Basic Auth"]
        end

        subgraph Sessions["Session Storage"]
            CookieStore["Cookie Store<br/>(CFB/GCM encryption,<br/>cookie splitting)"]
            RedisStore["Redis Store<br/>(Standalone, Sentinel,<br/>Cluster)"]
        end

        MetricsServer["Metrics Server<br/>(Prometheus endpoint)"]
        MLflowHandler["MLflow Auth Deny<br/>Handler (JSON 401)"]
        FileWatcher["File Watcher<br/>(htpasswd hot-reload)"]

        PreAuth --> SessionLoad
        SessionLoad --> AuthDecision
        AuthDecision --> RouteHandler
        RouteHandler --> HeaderInjection
    end

    %% External actors
    Browser["Browser / Client"]
    EnvoyProxy["Envoy Proxy<br/>(ext_authz)"]
    K8sPod["K8s Pod<br/>(SA token)"]

    %% External services
    OIDCExt["OIDC Provider<br/>(Keycloak, Dex)"]
    OSAuth["OpenShift<br/>OAuth Server"]
    K8sAPI["Kubernetes<br/>API Server"]
    Redis["Redis<br/>(optional)"]
    Upstream["Upstream<br/>Application"]
    Prometheus["Prometheus"]

    %% Incoming flows
    Browser -->|"HTTP/HTTPS :4180"| PreAuth
    EnvoyProxy -->|"ext_authz /oauth2/auth"| PreAuth
    K8sPod -->|"Bearer SA token"| PreAuth

    %% Provider flows
    OIDCProvider -->|"OIDC discovery + token exchange"| OIDCExt
    OSProvider -->|"OAuth + user validation"| OSAuth
    K8sValidator -->|"TokenReview API"| K8sAPI

    %% Session flows
    SessionLoad -.->|"load/save"| CookieStore
    SessionLoad -.->|"load/save"| RedisStore
    RedisStore -->|"TCP/TLS :6379"| Redis

    %% Outbound
    HeaderInjection -->|"proxied request +<br/>identity headers"| Upstream
    MetricsServer -->|"scraped by"| Prometheus
    FileWatcher -.->|"watches"| HtpasswdValidator

    %% Styles
    style KAP fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Middleware fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style Providers fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    style Validators fill:#f8cecc,stroke:#b85450,stroke-width:1px
    style Sessions fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style Browser fill:#f9f9f9,stroke:#999
    style EnvoyProxy fill:#f9f9f9,stroke:#999
    style K8sPod fill:#f9f9f9,stroke:#999
    style OIDCExt fill:#e8e8e8,stroke:#666
    style OSAuth fill:#e8e8e8,stroke:#666
    style K8sAPI fill:#e8e8e8,stroke:#666
    style Redis fill:#e8e8e8,stroke:#666
    style Upstream fill:#e8e8e8,stroke:#666
    style Prometheus fill:#e8e8e8,stroke:#666
