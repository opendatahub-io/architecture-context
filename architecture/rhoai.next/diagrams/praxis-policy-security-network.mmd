graph TB
    subgraph HostBoundary["HOST PROCESS (Trusted Boundary)"]
        Host["Praxis Proxy / Host App<br/>Owns socket, TLS, connection pool<br/>Injects HttpTransport into PPE"]
    end

    subgraph PPEEngine["PPE ENGINE (In-Process Reference Monitor)"]
        direction TB

        Executor["PolicyEngine<br/>Five-Phase Executor<br/>unsafe_code = forbid"]

        subgraph IdentityLayer["Identity Resolution"]
            JWTPlugin["JWT Plugin<br/>RS256/ES256/EdDSA<br/>jsonwebtoken 11 (aws_lc_rs)"]
            APIKeyPlugin["API-Key Plugin<br/>SHA-256 digest verification"]
        end

        subgraph PDPLayer["Policy Decision (in-process)"]
            CedarPDP["Cedar PDP<br/>cedar-policy 4"]
            CELPDP["CEL PDP<br/>cel 0.14.5"]
            OPAPDP["OPA PDP<br/>regorus 0.12<br/>restricted builtins"]
        end

        subgraph DelegationLayer["Credential Delegation"]
            OAuthDelegator["OAuth Delegator<br/>RFC 8693 Exchange<br/>HMAC-SHA256 cache keys"]
            CIBAElicit["CIBA Elicitation<br/>Human-in-the-loop"]
        end

        subgraph SSRFGuard["SSRF Protection (Bundled Transport)"]
            EgressResolver["EgressResolver<br/>Blocks: RFC 1918, link-local,<br/>loopback, CGNAT, metadata<br/>Checks resolved addresses"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        IdPJWKS["IdP JWKS Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+ (rustls/ring)<br/>Auth: None (public keys)"]
        IdPToken["IdP Token Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+ (rustls/ring)<br/>Auth: client_credentials"]
        IdPCIBA["IdP CIBA Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+ (rustls/ring)<br/>Auth: Bearer"]
        ValkeyStore["Valkey/Redis<br/>6379/TCP<br/>TLS (optional, rustls)<br/>Auth: Password"]
        VaultKV["HashiCorp Vault<br/>8200/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Token"]
    end

    %% Host to PPE (in-process)
    Host -->|"In-process Rust API<br/>No network boundary"| Executor

    %% Internal dispatch
    Executor -->|"identity.resolve"| JWTPlugin
    Executor -->|"identity.resolve"| APIKeyPlugin
    Executor -->|"authorization.decide"| CedarPDP
    Executor -->|"authorization.decide"| CELPDP
    Executor -->|"authorization.decide"| OPAPDP
    Executor -->|"delegation.exchange"| OAuthDelegator
    Executor -->|"elicitation.approve"| CIBAElicit

    %% Egress flows
    JWTPlugin -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth"| IdPJWKS
    OAuthDelegator -->|"HTTPS/443<br/>TLS 1.2+<br/>client_credentials"| IdPToken
    CIBAElicit -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer"| IdPCIBA
    Executor -->|"TCP/6379<br/>TLS (optional)<br/>Password"| ValkeyStore
    Executor -->|"HTTPS/8200<br/>TLS 1.2+<br/>Token"| VaultKV

    %% All egress through SSRF guard
    EgressResolver -.->|"validates all<br/>resolved addresses"| IdPJWKS
    EgressResolver -.->|"validates"| IdPToken
    EgressResolver -.->|"validates"| ValkeyStore
    EgressResolver -.->|"validates"| VaultKV

    %% Styling
    classDef host fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef engine fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef identity fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef pdp fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef delegation fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef ssrf fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Host host
    class Executor engine
    class JWTPlugin,APIKeyPlugin identity
    class CedarPDP,CELPDP,OPAPDP pdp
    class OAuthDelegator,CIBAElicit delegation
    class EgressResolver ssrf
    class IdPJWKS,IdPToken,IdPCIBA,ValkeyStore,VaultKV external
