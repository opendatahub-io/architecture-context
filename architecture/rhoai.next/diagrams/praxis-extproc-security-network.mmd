graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Istio Gateway)"]
        Gateway["Istio Gateway (Envoy)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Kuadrant Auth"]
    end

    subgraph ServiceLayer["SERVICE LAYER (openshift-ingress namespace)"]
        direction TB

        subgraph PreAuth["Pre-Auth Processing"]
            PreProc["payload-pre-processing<br/>SA: payload-processing<br/>9004/TCP gRPC<br/>TLS (self-signed, P-256)<br/>FIPS: OpenSSL provider"]
        end

        subgraph Auth["Auth"]
            Kuadrant["Kuadrant Auth<br/>WasmPlugin<br/>Token validation"]
        end

        subgraph PostAuth["Post-Auth Processing"]
            PostProc["payload-processing<br/>SA: payload-processing<br/>9004/TCP gRPC<br/>TLS (self-signed, P-256)<br/>FIPS: OpenSSL provider"]
        end

        subgraph Probes["Health / Metrics"]
            HealthSvc["Health Check<br/>50052/TCP gRPC<br/>Plaintext"]
            MetricsSvc["Metrics<br/>9090/TCP HTTP<br/>Plaintext"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP, 6443/TCP<br/>HTTPS TLS<br/>ServiceAccount Token"]
        DNS["DNS<br/>53/UDP, 53/TCP<br/>5353/UDP, 5353/TCP"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>openshift-monitoring<br/>HTTP scrape"]
    end

    subgraph Downstream["DOWNSTREAM (Inference)"]
        InferencePool["KServe InferencePool<br/>Header-based routing<br/>X-Gateway-Model-Name"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Gateway -->|"gRPC/9004<br/>TLS (ACCEPT_UNTRUSTED)<br/>No auth (cluster-internal)"| PreProc
    Gateway -->|"In-process<br/>WasmPlugin"| Kuadrant
    Gateway -->|"gRPC/9004<br/>TLS (ACCEPT_UNTRUSTED)<br/>No auth (cluster-internal)"| PostProc
    Gateway -->|"Header routing<br/>X-Gateway-Model-Name"| InferencePool

    PostProc -->|"HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI
    PreProc -->|"UDP/53<br/>DNS"| DNS
    PostProc -->|"UDP/53<br/>DNS"| DNS

    Prometheus -->|"HTTP/9090<br/>Plaintext<br/>NetworkPolicy controlled"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef downstream fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Gateway ingress
    class PreProc,PostProc,HealthSvc,MetricsSvc service
    class K8sAPI,DNS platform
    class Prometheus monitoring
    class Kuadrant auth
    class InferencePool downstream
