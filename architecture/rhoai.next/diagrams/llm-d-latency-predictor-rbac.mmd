graph TD
    subgraph "llm-d-latency-predictor RBAC"
        direction TB

        subgraph ServiceAccounts["Service Accounts"]
            PredSA["prediction-server<br/>SA: default"]
            TrainSA["training-server<br/>SA: default"]
        end

        subgraph Permissions["Effective Permissions"]
            DefaultPerms["Default ServiceAccount<br/>Permissions Only<br/>(no custom RBAC)"]
        end

        subgraph Endpoints["Unprotected Endpoints (No Auth)"]
            direction TB

            subgraph PredEndpoints["Prediction Server (8001/TCP)"]
                P1["POST /predict"]
                P2["POST /predict/bulk/strict"]
                P3["POST /predict/bulk"]
                P4["POST /reload"]
                P5["GET /status"]
                P6["GET /healthz"]
                P7["GET /readyz"]
            end

            subgraph TrainEndpoints["Training Server (8000/TCP)"]
                T1["POST /add_training_data_bulk"]
                T2["POST /predict"]
                T3["GET /model/{name}/info"]
                T4["GET /model/{name}/download"]
                T5["GET /metrics"]
                T6["GET /data/status"]
                T7["POST /flush"]
                T8["GET /healthz"]
                T9["GET /readyz"]
            end
        end

        PredSA -->|uses| DefaultPerms
        TrainSA -->|uses| DefaultPerms
    end

    subgraph Warning["SECURITY NOTE"]
        direction TB
        W1["No ClusterRoles defined"]
        W2["No Roles defined"]
        W3["No RoleBindings defined"]
        W4["No AuthorizationPolicies"]
        W5["No NetworkPolicies"]
        W6["All endpoints open/unauthenticated"]
    end

    style PredSA fill:#4a90e2,stroke:#333,color:#fff
    style TrainSA fill:#4a90e2,stroke:#333,color:#fff
    style DefaultPerms fill:#f5a623,stroke:#333
    style Warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style W1 fill:#f8cecc,stroke:#b85450
    style W2 fill:#f8cecc,stroke:#b85450
    style W3 fill:#f8cecc,stroke:#b85450
    style W4 fill:#f8cecc,stroke:#b85450
    style W5 fill:#f8cecc,stroke:#b85450
    style W6 fill:#f8cecc,stroke:#b85450
    style P1 fill:#dae8fc,stroke:#6c8ebf
    style P2 fill:#dae8fc,stroke:#6c8ebf
    style P3 fill:#dae8fc,stroke:#6c8ebf
    style P4 fill:#dae8fc,stroke:#6c8ebf
    style P5 fill:#dae8fc,stroke:#6c8ebf
    style P6 fill:#dae8fc,stroke:#6c8ebf
    style P7 fill:#dae8fc,stroke:#6c8ebf
    style T1 fill:#d5e8d4,stroke:#82b366
    style T2 fill:#d5e8d4,stroke:#82b366
    style T3 fill:#d5e8d4,stroke:#82b366
    style T4 fill:#d5e8d4,stroke:#82b366
    style T5 fill:#d5e8d4,stroke:#82b366
    style T6 fill:#d5e8d4,stroke:#82b366
