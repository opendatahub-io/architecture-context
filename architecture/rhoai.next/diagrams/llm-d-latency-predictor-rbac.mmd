graph TD
    subgraph "llm-d-latency-predictor RBAC"
        direction TB

        Note["⚠ No RBAC Resources Defined<br/><br/>This component uses default ServiceAccounts<br/>and requires no Kubernetes API access.<br/><br/>No ClusterRoles, Roles, or RoleBindings<br/>are created by this component."]

        subgraph "Service Accounts (default)"
            SA_Pred["default<br/>(prediction-server pods)"]
            SA_Train["default<br/>(training-server pod)"]
            SA_Test["default<br/>(test-harness job)"]
        end

        subgraph "Network Access (No Auth)"
            EP_Predict["/predict, /predict/bulk<br/>Port: 80/TCP → 8001/TCP<br/>Auth: None"]
            EP_Train["/add_training_data_bulk<br/>Port: 8000/TCP<br/>Auth: None"]
            EP_Models["/model/{name}/download<br/>Port: 8000/TCP<br/>Auth: None"]
            EP_Metrics["/metrics<br/>Port: 8000/TCP<br/>Auth: None"]
            EP_Health["/healthz, /readyz<br/>Ports: 8000, 8001/TCP<br/>Auth: None"]
        end

        subgraph "Security Gaps"
            Gap1["❌ No NetworkPolicy"]
            Gap2["❌ No Authentication"]
            Gap3["❌ No Authorization"]
            Gap4["❌ No mTLS / Service Mesh"]
            Gap5["❌ No TLS (plaintext HTTP)"]
        end
    end

