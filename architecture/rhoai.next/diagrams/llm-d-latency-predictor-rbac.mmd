graph TD
    subgraph "Service Accounts"
        PredSA["default<br/>(prediction-server)"]
        TrainSA["default<br/>(training-server)"]
        TestSA["default<br/>(test-harness)"]
    end

    subgraph "RBAC Configuration"
        NoRBAC["No ClusterRoles Defined<br/>No RoleBindings Defined<br/>No Kubernetes API Access Required"]
    end

    subgraph "Authentication Status"
        NoAuth["No Authentication<br/>All endpoints openly accessible<br/>No Bearer tokens<br/>No mTLS<br/>No API keys"]
    end

    subgraph "Authorization Status"
        NoAuthz["No Authorization<br/>No AuthorizationPolicy<br/>No NetworkPolicy<br/>No kube-rbac-proxy"]
    end

    subgraph "Security Gap - Production Requirements"
        direction TB
        Req1["Network Policies<br/>(restrict pod-to-pod traffic)"]
        Req2["kube-rbac-proxy Sidecars<br/>(endpoint authentication)"]
        Req3["Service Mesh mTLS<br/>(encrypt inter-service traffic)"]
        Req4["PeerAuthentication STRICT<br/>(enforce mTLS)"]
    end

    PredSA --> NoRBAC
    TrainSA --> NoRBAC
    TestSA --> NoRBAC

    PredSA --> NoAuth
    TrainSA --> NoAuth

    NoAuth --> NoAuthz

    NoAuthz -.->|"requires for production"| Req1
    NoAuthz -.->|"requires for production"| Req2
    NoAuthz -.->|"requires for production"| Req3
    NoAuthz -.->|"requires for production"| Req4

    style NoRBAC fill:#fff2cc,stroke:#d6b656
    style NoAuth fill:#f8cecc,stroke:#b85450
    style NoAuthz fill:#f8cecc,stroke:#b85450
    style Req1 fill:#d5e8d4,stroke:#82b366
    style Req2 fill:#d5e8d4,stroke:#82b366
    style Req3 fill:#d5e8d4,stroke:#82b366
    style Req4 fill:#d5e8d4,stroke:#82b366
    style PredSA fill:#4a90e2,color:#fff
    style TrainSA fill:#f5a623,color:#fff
