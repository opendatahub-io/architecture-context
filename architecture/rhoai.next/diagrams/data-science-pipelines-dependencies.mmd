graph LR
    DSP["Data Science Pipelines<br/>(ml-pipeline)"]

    %% External Dependencies
    DSP -->|"workflow execution"| ArgoWF["Argo Workflows<br/>v3.7.14"]
    DSP -->|"metadata storage<br/>3306/TCP"| MySQL["MySQL / MariaDB<br/>8.4+"]
    DSP -->|"artifact storage<br/>S3 API"| S3["S3-Compatible<br/>Storage"]
    DSP -->|"lineage tracking<br/>gRPC/8080"| MLMD["ML Metadata<br/>1.14.0"]
    DSP -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    DSP -->|"RPC transport"| GRPC["gRPC<br/>v1.82.1"]
    DSP -->|"REST-to-gRPC proxy"| GRPCGateway["grpc-gateway<br/>v2.28.0"]
    DSP -->|"HTTP routing"| Mux["gorilla/mux<br/>v1.8.1"]
    DSP -->|"S3 client"| AWSSDK["AWS SDK Go v2<br/>v1.41.5"]
    DSP -->|"ORM"| GORM["GORM<br/>v1.30.1"]
    DSP -->|"metrics"| PromClient["Prometheus client<br/>v1.23.2"]
    DSP -.->|"TLS certs (optional)"| CertManager["cert-manager"]
    DSP -.->|"HTTP-gRPC proxy (optional)"| Envoy["Envoy"]

    %% Internal Platform Dependencies
    DSPO["data-science-pipelines-operator"] -->|"deploys via<br/>DSPApplication CR"| DSP
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>8888, 9090/TCP"| DSP
    DSP -->|"Workflow CRUD<br/>CRD mgmt, auth<br/>6443/TCP"| K8sAPI["Kubernetes API"]

    %% Integration Points
    Dashboard["ODH Dashboard"] -.->|"UI integration"| DSP
    MLflow["MLflow<br/>(optional plugin)"] -.->|"experiment tracking"| DSP
    Istio["Istio<br/>(multi-user)"] -.->|"mTLS, AuthZ"| DSP

