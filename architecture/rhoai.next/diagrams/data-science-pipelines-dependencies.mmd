graph LR
    DSP["Data Science Pipelines<br/>(API Server + Agents + Controllers)"]

    %% External Dependencies (Required)
    DSP -->|"pipeline execution<br/>Argo Workflow DAGs"| Argo["Argo Workflows<br/>v3.7.14"]
    DSP -->|"metadata persistence<br/>3306/5432/TCP"| Database["MySQL 8+ /<br/>PostgreSQL 12+"]
    DSP -->|"artifact storage<br/>S3 API 443/TCP"| S3["S3-compatible<br/>Object Storage"]
    DSP -->|"artifact lineage<br/>gRPC 8080/TCP"| MLMD["ML Metadata<br/>(MLMD)"]
    DSP -->|"controller framework<br/>webhook + CRD mgmt"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    DSP -->|"CRD hosting, RBAC<br/>HTTPS 443/TCP"| K8s["Kubernetes<br/>v1.35+"]

    %% External Dependencies (Optional)
    DSP -.->|"experiment tracking<br/>HTTP/HTTPS (plugin)"| MLflow["MLflow Server<br/>(optional)"]

    %% Internal Platform Dependencies
    DSPO["data-science-pipelines-<br/>operator (DSPO)"] -->|"deploys & manages<br/>DSPA CR"| DSP
    DSPO -->|"deploys"| MariaDB["MariaDB<br/>(default DB)"]
    DSPO -->|"deploys"| MinIO["MinIO<br/>(default storage)"]
    DSPO -->|"deploys"| MLMDDeployed["MLMD<br/>(deployed instance)"]

    %% Integration Points (consumers)
    Dashboard["RHOAI Dashboard"] -.->|"UI management"| DSP
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>HTTP 8888/TCP"| DSP

