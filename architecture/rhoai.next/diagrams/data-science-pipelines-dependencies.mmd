    style S3 fill:#999,stroke:#333,color:#fff
    style MLMD fill:#999,stroke:#333,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style MLflow fill:#999,stroke:#333,stroke-dasharray: 5 5,color:#fff
    style DSPO fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    style MariaDB fill:#7ed321,stroke:#333,color:#fff
    style MinIO fill:#7ed321,stroke:#333,color:#fff
    style MLMDDeployed fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,stroke-dasharray: 5 5,color:#fff
