graph TD
    subgraph "Guardrails Regex Detector - RBAC"
        direction TB

        NoRBAC["No RBAC Resources Defined"]

        subgraph "Security Model"
            direction TB
            Note1["This service does not interact<br/>with the Kubernetes API"]
            Note2["No ClusterRoles or Roles"]
            Note3["No RoleBindings or ClusterRoleBindings"]
            Note4["No ServiceAccount requirements"]
        end

        subgraph "Authentication"
            direction TB
            Endpoint1["POST /api/v1/text/contents<br/>Auth: None"]
            Endpoint2["GET /health<br/>Auth: None"]
        end

        subgraph "Network-Level Security (External)"
            direction TB
            NetworkPolicy["NetworkPolicy<br/>(if configured)"]
            ServiceMesh["Service Mesh mTLS<br/>(if sidecar injected)"]
            PodIsolation["Pod Network Isolation<br/>(namespace boundaries)"]
        end

        NoRBAC --- Note1
        Endpoint1 -.->|"protected by"| NetworkPolicy
        Endpoint1 -.->|"encrypted by"| ServiceMesh
        Endpoint2 -.->|"protected by"| NetworkPolicy
        Endpoint2 -.->|"encrypted by"| ServiceMesh
    end

    style NoRBAC fill:#f5a623,stroke:#333,stroke-width:2px
    style Note1 fill:#fff2cc,stroke:#d6b656
    style Note2 fill:#fff2cc,stroke:#d6b656
    style Note3 fill:#fff2cc,stroke:#d6b656
    style Note4 fill:#fff2cc,stroke:#d6b656
    style Endpoint1 fill:#4a90e2,stroke:#333,color:#fff
    style Endpoint2 fill:#4a90e2,stroke:#333,color:#fff
    style NetworkPolicy fill:#d5e8d4,stroke:#82b366
    style ServiceMesh fill:#d5e8d4,stroke:#82b366
    style PodIsolation fill:#d5e8d4,stroke:#82b366
