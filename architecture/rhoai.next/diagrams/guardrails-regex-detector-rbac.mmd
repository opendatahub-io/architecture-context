graph TD
    subgraph "guardrails-regex-detector RBAC"
        direction TB

        Note["This service has NO RBAC requirements.<br/>It does not interact with the Kubernetes API.<br/>No ServiceAccount, ClusterRole, or RoleBinding<br/>resources are defined in the repository."]

        subgraph "Security Model"
            direction LR
            NetworkIsolation["Network-Level Isolation<br/>(assumed external)"]
            NoAuth["No Application-Level Auth<br/>No Bearer Tokens<br/>No mTLS<br/>No API Keys"]
            NoK8sAPI["No Kubernetes API Access<br/>No RBAC Required"]
        end

        subgraph "Access Control Gaps"
            direction LR
            Gap1["⚠️ No NetworkPolicy<br/>defined in repo"]
            Gap2["⚠️ No ServiceMesh config<br/>defined in repo"]
            Gap3["⚠️ No AuthorizationPolicy<br/>defined in repo"]
        end
    end

    style Note fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style NetworkIsolation fill:#d5e8d4,stroke:#82b366
    style NoAuth fill:#fff2cc,stroke:#d6b656
    style NoK8sAPI fill:#d5e8d4,stroke:#82b366
    style Gap1 fill:#f8cecc,stroke:#b85450
    style Gap2 fill:#f8cecc,stroke:#b85450
    style Gap3 fill:#f8cecc,stroke:#b85450
