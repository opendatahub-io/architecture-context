graph TD
    subgraph "Application Level"
        App["Guardrails Regex Detector<br/>(No RBAC defined in repository)"]
    end

    subgraph "Platform Level (Managed by Deploying Operator)"
        SA["Service Account<br/>(assigned by operator)"]
        NP["Network Policy<br/>(restricts pod access)"]
        SM["Service Mesh<br/>(mTLS + AuthorizationPolicy)"]
    end

    subgraph "Security Posture"
        NoAuth["No App-Level Auth<br/>Relies on platform"]
        NoTLS["No App-Level TLS<br/>Relies on service mesh"]
        NoSecrets["No Secrets Consumed"]
        NoRBAC["No RBAC Roles Defined<br/>Managed externally"]
    end

    App -.->|"security delegated to"| SA
    App -.->|"network isolation via"| NP
    App -.->|"transport security via"| SM

    style App fill:#4a90e2,color:#fff
    style SA fill:#f5a623,color:#fff
    style NP fill:#f5a623,color:#fff
    style SM fill:#f5a623,color:#fff
    style NoAuth fill:#ff6b6b,color:#fff
    style NoTLS fill:#ff6b6b,color:#fff
    style NoSecrets fill:#7ed321,color:#fff
    style NoRBAC fill:#ff6b6b,color:#fff
