graph TD
    subgraph "Service Accounts"
        SA_MS["model-server SA<br/>(guides/recipes/modelserver/common/sa.yaml)<br/>automountServiceAccountToken: false"]
        SA_EPP["EPP Service Account<br/>(managed by EPP Helm chart)"]
    end

    subgraph "Model Server RBAC"
