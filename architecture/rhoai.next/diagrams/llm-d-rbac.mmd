graph TD
    subgraph "llm-d RBAC (Minimal - Delegated)"
        direction TB

        Note["llm-d does not define RBAC resources<br/>in this repository. RBAC is provided by<br/>sibling components."]

        subgraph ModelServerSA["Model Server Service Account"]
            SA["ServiceAccount<br/>(per-deployment)"]
            SAConfig["automountServiceAccountToken: false<br/>No API server access"]
        end

        subgraph SecretAccess["Secret Access"]
            HFSecret["llm-d-hf-token<br/>Type: Opaque<br/>Provisioned: Manual (kubectl)<br/>Auto-Rotate: No"]
        end

        subgraph DelegatedRBAC["Delegated RBAC (from llm-d-router Helm chart)"]
            RouterSA["Router Service Account"]
            RouterRole["Router ClusterRole"]
            RouterResources["InferencePool<br/>EndpointSlice<br/>inference.networking.x-k8s.io"]
        end

        subgraph GatewayAuth["Gateway-Level Auth (Infrastructure)"]
            GWAuth["Authentication delegated to<br/>Gateway controller<br/>(Envoy / Istio / kgateway)"]
            NoModelAuth["Model server: No auth<br/>Port 8000/TCP unauthenticated"]
        end
    end

    SA --> SAConfig
    SA -.->|"mounts"| HFSecret

    RouterSA -->|"bound via<br/>ClusterRoleBinding"| RouterRole
    RouterRole -->|"get, list, watch"| RouterResources

    GWAuth -->|"enforces auth<br/>before traffic reaches"| NoModelAuth

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style SAConfig fill:#dae8fc,stroke:#6c8ebf
    style HFSecret fill:#f8cecc,stroke:#b85450
    style RouterSA fill:#7ed321,stroke:#333
    style RouterRole fill:#f5a623,stroke:#333
    style RouterResources fill:#fff2cc,stroke:#d6b656
    style GWAuth fill:#ffe6cc,stroke:#d79b00
    style NoModelAuth fill:#f8cecc,stroke:#b85450
    style Note fill:#fff,stroke:#999,stroke-dasharray: 5 5
