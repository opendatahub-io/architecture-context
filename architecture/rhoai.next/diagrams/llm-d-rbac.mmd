        LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSet"]
        Pods["core<br/>Pods"]
        Endpoints["core<br/>Endpoints"]
    end

    subgraph "Secrets"
        HFToken["llm-d-hf-token<br/>Type: Opaque<br/>Contains: HF_TOKEN<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    subgraph "Security Context"
        PodSec["Pod Security<br/>UID: 2000 (non-root)<br/>Group: 0 (OCP compat)<br/>No privileged containers"]
    end

    %% Relationships
    SA_MS -->|"no bindings"| MS_Note
    SA_MS -->|"mounts"| HFToken
