graph LR
    FMO["feast-module-operator<br/>(Module Operator)"]

    %% External Dependencies (frameworks/libraries)
    FMO -->|"operator framework"| CR["controller-runtime<br/>v0.24.1"]
    FMO -->|"common APIs &<br/>deploy framework"| ODHLib["opendatahub-operator/v2<br/>v2.0.0-20260623"]
    FMO -->|"cache optimization"| PlatUtils["odh-platform-utilities<br/>v0.0.0-20260528"]
    FMO -->|"OLM version types"| OFApi["operator-framework/api<br/>v0.42.0"]
    FMO -->|"ServiceMonitor types"| PromApi["prometheus-operator/apis<br/>v0.74.0"]
    FMO -->|"manifest rendering"| ManifestKit["k8s-manifest-kit<br/>v0.2.1"]
    FMO -->|"chart rendering"| Helm["helm.sh/helm/v4<br/>v4.1.1"]

    %% Internal Platform Dependencies
    PlatOp["opendatahub-operator<br/>(rhods-operator)"] -->|"creates FeastOperator CR<br/>deploys via Helm"| FMO
    PlatOp -->|"writes platformVersion"| ConfigMap["odh-feastoperator-config<br/>ConfigMap"]
    ConfigMap -->|"watched by"| FMO

    %% Deployed Workload
    FMO -->|"deploys via kustomize"| FeastOp["feast-operator<br/>(upstream)"]
    FMO -->|"deploys CRD"| FeatureStore["FeatureStore CRD<br/>feast.dev/v1"]

    %% Integration Points (consumers)
    FeastOp -->|"watches (read-only)"| KFNotebooks["Kubeflow Notebooks<br/>kubeflow.org"]
    FeastOp -->|"manages"| Routes["OpenShift Routes<br/>route.openshift.io"]
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>8443/TCP HTTPS"| FMO
    Chaos["operator-chaos"] -.->|"shift-left validation<br/>GitHub Actions"| FMO

    %% Infrastructure
    FMO -->|"API calls<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API"]

