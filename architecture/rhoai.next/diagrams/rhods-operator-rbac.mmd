graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["redhat-ods-operator-<br/>controller-manager"]
        SA_AuthProxy["{kube-auth-proxy SA}"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["rhods-operator-rolebinding"]
        CRB_TokenReview["{kube-auth-proxy}-tokenreview"]
        CRB_AdminGroup["{admin-group}-binding<br/>(per admin group)"]
        CRB_AllowedGroup["{allowed-group}-binding<br/>(per allowed group)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["rhods-operator-role"]
        CR_Metrics["redhat-ods-operator-<br/>metrics-reader"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Admin["data-science-<br/>admingroupcluster-role"]
        CR_Allowed["data-science-<br/>allowedgroupcluster-role"]
    end

    subgraph ComponentEditorRoles["Component Editor ClusterRoles"]
        CR_Dashboard["dashboard-editor-role"]
        CR_KServe["kserve-editor-role"]
        CR_Kueue["kueue-editor-role"]
        CR_ModelReg["modelregistry-editor-role"]
        CR_Ray["ray-editor-role"]
        CR_TrustyAI["trustyai-editor-role"]
        CR_Workbenches["workbenches-editor-role"]
        CR_Auth["auth-editor-role"]
    end

    subgraph AdminResources["Admin Group Resources"]
        R_Auths["services.platform<br/>auths"]
        R_DSC["datasciencecluster<br/>datascienceclusters"]
        R_MR["modelregistry<br/>modelregistries"]
        R_Feast["feast.dev<br/>featurestores"]
        R_Storage["storage.k8s.io<br/>storageclasses"]
        R_Users["user.openshift.io<br/>groups, users"]
        R_MaaS["maas.opendatahub.io<br/>maasmodelrefs"]
        R_Loki["loki.grafana.com<br/>application"]
    end

    subgraph ComponentResources["Component Resources"]
        R_Dashboards["components.platform<br/>dashboards"]
        R_KServes["components.platform<br/>kserves"]
        R_Kueues["components.platform<br/>kueues"]
        R_ModelRegs["components.platform<br/>modelregistries"]
        R_Rays["components.platform<br/>rays"]
        R_TrustyAIs["components.platform<br/>trustyais"]
        R_WB["components.platform<br/>workbenches"]
    end

    subgraph MetricsResource["Non-Resource URLs"]
        NR_Metrics["/metrics"]
    end

    %% Operator SA bindings
    SA_Manager -->|bound via| CRB_Main
    CRB_Main -->|grants| CR_Main

    %% Auth proxy bindings
    SA_AuthProxy -->|bound via| CRB_TokenReview
    CRB_TokenReview -->|grants| CR_AuthDelegator

    %% Metrics reader
    CR_Metrics -->|get| NR_Metrics

    %% Admin group bindings
    CRB_AdminGroup -->|grants| CR_Admin
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_Auths
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_DSC
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_MR
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_Feast
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_Storage
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_Users
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_MaaS
    CR_Admin -->|"get, list, watch,<br/>patch, update,<br/>create, delete"| R_Loki

    %% Allowed group bindings
    CRB_AllowedGroup -->|grants| CR_Allowed
    CR_Allowed -->|"get, list, watch"| R_Auths

    %% Component editor roles
    CR_Dashboard -->|"CRUD + watch"| R_Dashboards
    CR_KServe -->|"CRUD + watch"| R_KServes
    CR_Kueue -->|"CRUD + watch"| R_Kueues
    CR_ModelReg -->|"CRUD + watch"| R_ModelRegs
    CR_Ray -->|"CRUD + watch"| R_Rays
    CR_TrustyAI -->|"CRUD + watch"| R_TrustyAIs
    CR_Workbenches -->|"CRUD + watch"| R_WB

    %% Styling
    style SA_Manager fill:#4a90e2,stroke:#333,color:#fff
    style SA_AuthProxy fill:#4a90e2,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_Admin fill:#f5a623,stroke:#333
    style CR_Allowed fill:#f5a623,stroke:#333
    style CR_Dashboard fill:#e6b8af,stroke:#333
    style CR_KServe fill:#e6b8af,stroke:#333
    style CR_Kueue fill:#e6b8af,stroke:#333
    style CR_ModelReg fill:#e6b8af,stroke:#333
    style CR_Ray fill:#e6b8af,stroke:#333
    style CR_TrustyAI fill:#e6b8af,stroke:#333
    style CR_Workbenches fill:#e6b8af,stroke:#333
    style CR_Auth fill:#e6b8af,stroke:#333
    style R_Auths fill:#7ed321,stroke:#333
    style R_DSC fill:#7ed321,stroke:#333
    style R_MR fill:#7ed321,stroke:#333
    style R_Feast fill:#7ed321,stroke:#333
    style R_Storage fill:#7ed321,stroke:#333
    style R_Users fill:#7ed321,stroke:#333
    style R_MaaS fill:#7ed321,stroke:#333
    style R_Loki fill:#7ed321,stroke:#333
    style R_Dashboards fill:#7ed321,stroke:#333
    style R_KServes fill:#7ed321,stroke:#333
    style R_Kueues fill:#7ed321,stroke:#333
    style R_ModelRegs fill:#7ed321,stroke:#333
    style R_Rays fill:#7ed321,stroke:#333
    style R_TrustyAIs fill:#7ed321,stroke:#333
    style R_WB fill:#7ed321,stroke:#333
