graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["rhods-operator<br/>controller-manager"]
        SA_KubeAuth["kube-auth-proxy<br/>(openshift-ingress)"]
    end

    subgraph Groups["User Groups (from Auth CR)"]
        AdminGroups["Admin Groups<br/>(configurable)"]
        AllowedGroups["Allowed Groups<br/>(configurable)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["rhods-operator<br/>rolebinding"]
        CRB_KubeAuth["kube-auth-proxy-crb"]
        CRB_Admin["data-science-admin<br/>groupcluster-rolebinding"]
        CRB_Allowed["data-science-allowed<br/>groupcluster-rolebinding"]
        CRB_Kueue["kueue-batch-admin<br/>rolebinding"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_AdminApps["data-science-admingroup<br/>-rolebinding<br/>(applications NS)"]
        RB_AdminMaaS["data-science-admingroup<br/>-maas-rolebinding<br/>(models-as-a-service NS)"]
        RB_AdminKuadrant["data-science-admingroup<br/>-kuadrant-rolebinding<br/>(kuadrant-system NS)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Operator["rhods-operator<br/>(generated)"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Admin["data-science-admin<br/>groupcluster-role"]
        CR_Allowed["data-science-allowed<br/>groupcluster-role"]
        CR_KueueAdmin["kueue-batch-admin-role"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        NR_AdminApps["data-science-admingroup<br/>-role (applications)"]
        NR_AdminMaaS["data-science-admingroup<br/>-maas-role"]
        NR_AdminKuadrant["data-science-admingroup<br/>-kuadrant-role"]
    end

    subgraph PlatformResources["Platform API Resources"]
        DSC["datasciencecluster.opendatahub.io<br/>DataScienceCluster"]
        DSCI["dscinitialization.opendatahub.io<br/>DSCInitialization"]
        GwConfig["services.platform.opendatahub.io<br/>GatewayConfig"]
        CompCRs["components.platform.opendatahub.io<br/>Dashboard, KServe, etc."]
    end

    subgraph NetworkResources["Network API Resources"]
        GwAPI["gateway.networking.k8s.io<br/>Gateways, GatewayClasses, HTTPRoutes"]
        IstioRes["networking.istio.io<br/>EnvoyFilters, DestinationRules"]
        NetPol["networking.k8s.io<br/>NetworkPolicies"]
        Routes["route.openshift.io<br/>Routes"]
    end

    subgraph CoreResources["Core API Resources"]
        CoreRes["core (v1)<br/>ConfigMaps, Services, Secrets<br/>Namespaces, ServiceAccounts"]
        AppsRes["apps (v1)<br/>Deployments"]
        RBACRes["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings<br/>Roles, RoleBindings"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Operator
    CRB_Operator -->|grants| CR_Operator
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| DSC
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| DSCI
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| GwConfig
    CR_Operator -->|"get,list,watch"| CompCRs
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| GwAPI
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| IstioRes
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| NetPol
    CR_Operator -->|"create,patch,update"| Routes
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| CoreRes
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| AppsRes
    CR_Operator -->|"get,list,watch,create<br/>update,patch,delete"| RBACRes

    %% kube-auth-proxy SA bindings
    SA_KubeAuth -->|bound via| CRB_KubeAuth
    CRB_KubeAuth -->|grants| CR_AuthDelegator

    %% Admin group bindings
    AdminGroups -->|bound via| CRB_Admin
    CRB_Admin -->|grants| CR_Admin
    CR_Admin -->|"various admin<br/>permissions"| PlatformResources

    AdminGroups -->|bound via| RB_AdminApps
    RB_AdminApps -->|grants| NR_AdminApps

    AdminGroups -->|bound via| RB_AdminMaaS
    RB_AdminMaaS -->|grants| NR_AdminMaaS

    AdminGroups -->|bound via| RB_AdminKuadrant
    RB_AdminKuadrant -->|grants| NR_AdminKuadrant

    AdminGroups -->|bound via| CRB_Kueue
    CRB_Kueue -->|grants| CR_KueueAdmin

    %% Allowed group bindings
    AllowedGroups -->|bound via| CRB_Allowed
    CRB_Allowed -->|grants| CR_Allowed
    CR_Allowed -->|"get,list,watch<br/>(read-only)"| PlatformResources

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_KubeAuth fill:#4a90e2,stroke:#333,color:#fff
    style AdminGroups fill:#e67e22,stroke:#333,color:#fff
    style AllowedGroups fill:#e67e22,stroke:#333,color:#fff
    style CR_Operator fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_Admin fill:#f5a623,stroke:#333
    style CR_Allowed fill:#f5a623,stroke:#333
    style CR_KueueAdmin fill:#f5a623,stroke:#333
    style NR_AdminApps fill:#f5c451,stroke:#333
    style NR_AdminMaaS fill:#f5c451,stroke:#333
    style NR_AdminKuadrant fill:#f5c451,stroke:#333
    style DSC fill:#7ed321,stroke:#333
    style DSCI fill:#7ed321,stroke:#333
    style GwConfig fill:#7ed321,stroke:#333
    style CompCRs fill:#7ed321,stroke:#333
    style GwAPI fill:#7ed321,stroke:#333
    style IstioRes fill:#7ed321,stroke:#333
    style NetPol fill:#7ed321,stroke:#333
    style Routes fill:#7ed321,stroke:#333
    style CoreRes fill:#7ed321,stroke:#333
    style AppsRes fill:#7ed321,stroke:#333
    style RBACRes fill:#7ed321,stroke:#333
