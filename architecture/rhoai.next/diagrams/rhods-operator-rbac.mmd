graph TD
    subgraph "Service Accounts"
        SA_Operator["opendatahub-operator-<br/>controller-manager"]
        SA_AuthProxy["kube-auth-proxy<br/>(openshift-ingress)"]
    end

    subgraph "Groups"
        AdminGroup["Platform Admin Group<br/>(platform-specific)"]
        AuthenticatedGroup["system:authenticated<br/>(all authenticated users)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["opendatahub-operator-<br/>manager-rolebinding<br/>(cluster-wide)"]
        CRB_Admin["data-science-admingroupcluster-<br/>rolebinding<br/>(cluster-wide)"]
        CRB_Allowed["data-science-allowedgroupcluster-<br/>rolebinding<br/>(cluster-wide)"]
        CRB_TokenReview["kube-auth-proxy-<br/>tokenreview<br/>(cluster-wide)"]
    end

    subgraph "Role Bindings"
        RB_AdminNS["data-science-admingroup-<br/>rolebinding<br/>(application namespace)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["opendatahub-operator<br/>(manager)"]
        CR_Admin["data-science-admingroup-<br/>clusterrole"]
        CR_Allowed["data-science-<br/>allowedgroupcluster-role"]
        CR_AuthDelegator["system:auth-delegator"]
    end

    subgraph "API Resources — Operator Manager"
        DSC["datasciencecluster.opendatahub.io<br/>DataScienceCluster<br/>+status, +finalizers"]
        DSCI["dscinitialization.opendatahub.io<br/>DSCInitialization<br/>+status, +finalizers"]
        Components["components.platform.opendatahub.io<br/>Dashboard, KServe, Kueue, Ray,<br/>ModelRegistry, ModelController,<br/>Workbenches, DSPipelines, TrustyAI,<br/>Trainer, TrainingOperator, Feast,<br/>OGX, Spark, AIGateway, MLflow, MCP"]
        Services["services.platform.opendatahub.io<br/>Auth, GatewayConfig, Monitoring"]
        GatewayRes["gateway.networking.k8s.io<br/>Gateway, GatewayClass, HTTPRoute"]
        IstioRes["networking.istio.io<br/>EnvoyFilter, DestinationRule"]
        RouteRes["route.openshift.io<br/>Route"]
        OAuthRes["oauth.openshift.io<br/>OAuthClient"]
        MonitoringRes["monitoring.coreos.com<br/>ServiceMonitor, PrometheusRule,<br/>PodMonitor"]
    end

    subgraph "API Resources — Admin Group"
        AdminDSC["datasciencecluster.opendatahub.io<br/>DataScienceCluster"]
        AdminAuth["services.platform.opendatahub.io<br/>Auth"]
        AdminHWP["infrastructure.opendatahub.io<br/>HardwareProfile"]
        AdminUsers["user.openshift.io<br/>Groups, Users"]
    end

    subgraph "API Resources — Allowed Group"
        AllowedAuth["services.platform.opendatahub.io<br/>Auth"]
    end

    subgraph "API Resources — Auth Proxy"
        TokenReviewRes["TokenReview<br/>SubjectAccessReview"]
    end

    %% SA → Binding → Role → Resources
    SA_Operator -->|"bound via"| CRB_Manager
    CRB_Manager -->|"grants"| CR_Manager
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| DSC
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| DSCI
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Components
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Services
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| GatewayRes
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| IstioRes
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| RouteRes
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| OAuthRes
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| MonitoringRes

    %% Admin group
    AdminGroup -->|"bound via"| CRB_Admin
    AdminGroup -->|"bound via"| RB_AdminNS
    CRB_Admin -->|"grants"| CR_Admin
    CR_Admin -->|"get,list,watch,<br/>update,patch"| AdminDSC
    CR_Admin -->|"get,list,watch,patch"| AdminAuth
    CR_Admin -->|"get,list,watch,create,<br/>update,patch,delete"| AdminHWP
    CR_Admin -->|"get,list,watch"| AdminUsers

    %% Allowed group
    AuthenticatedGroup -->|"bound via"| CRB_Allowed
    CRB_Allowed -->|"grants"| CR_Allowed
    CR_Allowed -->|"get,list,watch"| AllowedAuth

    %% Auth proxy
    SA_AuthProxy -->|"bound via"| CRB_TokenReview
    CRB_TokenReview -->|"grants"| CR_AuthDelegator
    CR_AuthDelegator -->|"create"| TokenReviewRes

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style SA_AuthProxy fill:#4a90e2,color:#fff
    style AdminGroup fill:#9013fe,color:#fff
    style AuthenticatedGroup fill:#9013fe,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Admin fill:#f5a623,color:#fff
    style CR_Allowed fill:#f5a623,color:#fff
    style CR_AuthDelegator fill:#f5a623,color:#fff
    style DSC fill:#7ed321,color:#fff
    style DSCI fill:#7ed321,color:#fff
    style Components fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style GatewayRes fill:#7ed321,color:#fff
    style IstioRes fill:#7ed321,color:#fff
    style RouteRes fill:#7ed321,color:#fff
    style OAuthRes fill:#7ed321,color:#fff
    style MonitoringRes fill:#7ed321,color:#fff
    style AdminDSC fill:#7ed321,color:#fff
    style AdminAuth fill:#7ed321,color:#fff
    style AdminHWP fill:#7ed321,color:#fff
    style AdminUsers fill:#7ed321,color:#fff
    style AllowedAuth fill:#7ed321,color:#fff
    style TokenReviewRes fill:#7ed321,color:#fff
