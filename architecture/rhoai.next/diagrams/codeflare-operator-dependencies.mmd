graph LR
    CFOp["CodeFlare Operator"]

    %% External Dependencies (required libraries/frameworks)
    CFOp -->|"controller framework"| CtrlRuntime["controller-runtime<br/>v0.19.3"]
    CFOp -->|"RayCluster CRD types"| KubeRayAPI["kuberay ray-operator APIs<br/>v1.2.1"]
    CFOp -->|"AppWrapper CRD + controller"| AppWrapper["appwrapper<br/>v1.1.2"]
    CFOp -->|"webhook TLS rotation"| CertCtrl["cert-controller<br/>v0.12.0"]
    CFOp -->|"Route types"| OSApi["openshift/api"]
    CFOp -->|"Route + Config clients"| OSClient["openshift/client-go"]
    CFOp -->|"DSCInitialization types"| ODHApi["opendatahub-operator/v2 APIs<br/>v2.10.0"]
    CFOp -.->|"quota mgmt (via appwrapper)"| KueueLib["kueue<br/>v0.10.1"]

    %% Internal Platform Dependencies
    CFOp -->|"watches CRs"| KubeRay["KubeRay Operator"]
    CFOp -->|"reads DSCI CR"| ODHOp["opendatahub-operator /<br/>rhods-operator"]
    CFOp -->|"auth delegation"| OSAuth["OpenShift OAuth"]
    CFOp -->|"cluster domain lookup"| OSIngress["OpenShift Ingress Config"]

    %% Integration Points (components that interact with CodeFlare)
    Monitoring["Prometheus<br/>(openshift-monitoring)"] -->|"scrapes metrics<br/>HTTP/8080"| CFOp
    K8sAPI["Kubernetes API Server"] -->|"webhook calls<br/>HTTPS/9443"| CFOp
    CertSigner["service-serving-cert-signer"] -.->|"generates OAuth<br/>service TLS certs"| CFOp
    Kueue["Kueue"] -.->|"quota + gang scheduling"| CFOp

    %% Styling
    style CFOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps (libraries)
    style CtrlRuntime fill:#e8e8e8,stroke:#999
    style KubeRayAPI fill:#e8e8e8,stroke:#999
    style AppWrapper fill:#e8e8e8,stroke:#999
    style CertCtrl fill:#e8e8e8,stroke:#999
    style OSApi fill:#e8e8e8,stroke:#999
    style OSClient fill:#e8e8e8,stroke:#999
    style ODHApi fill:#e8e8e8,stroke:#999
    style KueueLib fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5

    %% Internal platform
    style KubeRay fill:#7ed321,stroke:#333,color:#fff
    style ODHOp fill:#7ed321,stroke:#333,color:#fff
    style OSAuth fill:#7ed321,stroke:#333,color:#fff
    style OSIngress fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style Monitoring fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style CertSigner fill:#f5a623,stroke:#333,color:#fff
    style Kueue fill:#f5a623,stroke:#333,color:#fff
