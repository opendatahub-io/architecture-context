graph LR
    Prism["Prism<br/>(BFF Web App)"]

    %% Runtime Dependencies
    Prism -->|"runtime"| Node["Node.js 26<br/>(Alpine)"]
    Prism -->|"UI framework"| React["React ^19.2.0"]
    Prism -->|"build tool"| Vite["Vite ^7.2.4"]
    Prism -->|"HTTP server"| Express["Express ^4.18.2"]
    Prism -->|"charts"| Recharts["Recharts ^3.4.1"]
    Prism -->|"styling"| Tailwind["Tailwind CSS ^4.1.17"]
    Prism -->|"validation"| Zod["Zod ^4.4.3"]
    Prism -->|"rate limiting"| RateLimit["express-rate-limit ^7.1.5"]
    Prism -->|"GCS client"| GCSLib["@google-cloud/storage ^7.21.0"]
    Prism -->|"auth library"| GoogleAuth["google-auth-library ^9.4.1"]

    %% Cloud Service Dependencies
    Prism -->|"benchmark data<br/>Results Store"| GCS["Google Cloud Storage<br/>storage.googleapis.com"]
    Prism -->|"perf profiles<br/>cost data"| GIQ["GKE Recommender API<br/>gkerecommender.googleapis.com"]
    Prism -->|"authentication<br/>org membership"| GitHub["GitHub OAuth<br/>github.com + api.github.com"]
    Prism -->|"hosting<br/>TLS termination"| CloudRun["Google Cloud Run<br/>prism.llm-d.ai"]

    %% Client-Side Data Sources
    Prism -.->|"public benchmarks<br/>(client-side)"| S3["AWS S3"]
    Prism -.->|"shared data<br/>(client-side)"| GDrive["Google Drive/Sheets"]

    %% Internal Platform
    Benchmark["llm-d-benchmark"] -.->|"benchmark_report_v0.2<br/>YAML format"| Prism

    %% Dev Dependencies
    Prism -.->|"dev: testing"| Vitest["Vitest ^4.1.11"]
    Prism -.->|"dev: types"| TS["TypeScript ^5.5.4"]
    Prism -.->|"dev: linting"| ESLint["ESLint ^9.39.1"]

    %% Styling
    style Prism fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Node fill:#999,stroke:#333
    style React fill:#999,stroke:#333
    style Vite fill:#999,stroke:#333
    style Express fill:#999,stroke:#333
    style Recharts fill:#999,stroke:#333
    style Tailwind fill:#999,stroke:#333
    style Zod fill:#999,stroke:#333
    style RateLimit fill:#999,stroke:#333
    style GCSLib fill:#999,stroke:#333
    style GoogleAuth fill:#999,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style GIQ fill:#f5a623,stroke:#333
    style GitHub fill:#f5a623,stroke:#333
    style CloudRun fill:#f5a623,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style GDrive fill:#e8e8e8,stroke:#333
    style Benchmark fill:#7ed321,stroke:#333
    style Vitest fill:#ddd,stroke:#999,stroke-dasharray:5 5
    style TS fill:#ddd,stroke:#999,stroke-dasharray:5 5
    style ESLint fill:#ddd,stroke:#999,stroke-dasharray:5 5
