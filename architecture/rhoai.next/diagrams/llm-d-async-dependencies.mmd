graph LR
    AP["llm-d-async<br/>(Async Processor)"]

    %% External Dependencies (Conditional)
    AP -->|"message queue<br/>Redis protocol/6379<br/>Optional TLS"| Redis["Redis / Valkey<br/>(any version)"]
    AP -->|"message queue<br/>gRPC/443<br/>TLS 1.2+, GCP ADC"| GCPPubSub["GCP Pub/Sub<br/>(v2 API)"]
    AP -->|"backlog metrics<br/>gRPC/443<br/>TLS 1.2+, GCP ADC"| GCPMonitoring["GCP Cloud Monitoring<br/>(v1 API)"]
    AP -->|"dispatch gate queries<br/>HTTP/9090"| Prometheus["Prometheus<br/>(v1 API)"]
    AP -->|"trace export<br/>gRPC/4317<br/>Optional TLS"| OTLP["OTLP Collector<br/>(Jaeger / Tempo)"]

    %% Internal llm-d Dependencies
    AP -->|"dispatch requests<br/>HTTP POST<br/>Optional mTLS"| LLMDRouter["llm-d-router"]
    AP -.->|"dispatch requests<br/>HTTP POST<br/>(alternative IGW)"| GenericIGW["Generic Inference<br/>Gateway (OpenAI-compat)"]

    %% Metric Sources (consumed by gates)
    EPP["gateway-api-inference-<br/>extension (EPP)"] -.->|"flow control metrics<br/>(saturation, queue_size)"| AP
    VLLM["vLLM Model Servers"] -.->|"running/waiting metrics<br/>HTTP scrape"| AP
    InfPool["InferencePool<br/>(Gateway API)"] -.->|"ready_pods metric"| AP

    %% Monitoring Integration
    PodMonitor["PodMonitor<br/>(Prometheus Operator)"] -.->|"scrapes /metrics<br/>HTTP/9090"| AP
    Grafana["Grafana"] -.->|"dashboard JSON<br/>via ConfigMap"| AP

    %% Client Libraries
    ProducerLib["Producer Library<br/>(Go module)"] -->|"enqueue/dequeue<br/>Redis protocol"| Redis

    %% Styling
    style AP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External dependencies
    style Redis fill:#999,stroke:#333,color:#fff
    style GCPPubSub fill:#999,stroke:#333,color:#fff
    style GCPMonitoring fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style OTLP fill:#999,stroke:#333,color:#fff

    %% Internal llm-d components
    style LLMDRouter fill:#7ed321,stroke:#333,color:#fff
    style GenericIGW fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style VLLM fill:#7ed321,stroke:#333,color:#fff
    style InfPool fill:#7ed321,stroke:#333,color:#fff

    %% Platform / monitoring
    style PodMonitor fill:#4a90e2,stroke:#333,color:#fff
    style Grafana fill:#4a90e2,stroke:#333,color:#fff

    %% Client
    style ProducerLib fill:#f5a623,stroke:#333,color:#fff
