graph LR
    AP["llm-d-async<br/>(Async Processor)"]

    %% Required External Dependencies
    AP -->|"HTTP POST<br/>inference dispatch"| IGW["llm-d-router<br/>(Inference Gateway)<br/>Required"]
    AP -->|"Go types"| CtrlRuntime["controller-runtime<br/>v0.22.5<br/>Required"]
    AP -->|"Go types"| GatewayAPI["gateway-api-inference-<br/>extension v1.2.1<br/>Required"]

    %% Conditional Queue Backends
    AP -->|"RESP 6379/TCP<br/>queue + gates"| Redis["Redis/Valkey 6+<br/>Conditional"]
    AP -->|"gRPC 443/TCP<br/>queue backend"| GCPPubSub["GCP Pub/Sub v2<br/>Conditional"]

    %% Optional Dependencies
    AP -->|"gRPC 443/TCP<br/>backlog metrics"| GCPMon["GCP Cloud Monitoring v1<br/>Conditional"]
    AP -->|"HTTP PromQL<br/>dispatch gating"| Prometheus["Prometheus<br/>v1 API<br/>Optional"]
    AP -->|"gRPC OTLP 4317/TCP<br/>trace export"| OTel["OpenTelemetry<br/>Collector<br/>Optional"]

    %% Internal Platform Dependencies
    AP -.->|"PromQL API<br/>saturation queries"| Thanos["Prometheus/Thanos<br/>(Internal)"]
    AP -.->|"indirect via PodMonitor<br/>metric relabeling"| vLLM["vLLM Model Servers<br/>(Internal)"]

    %% Integration Points (inbound)
    PromOp["Prometheus Operator"] -->|"PodMonitor scrape<br/>HTTP 9090/TCP"| AP
    K8s["Kubernetes"] -->|"health probes<br/>HTTP 8081/TCP"| AP

    %% Styling
    style AP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required
    style IGW fill:#2ecc71,stroke:#333,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff

    %% Conditional
    style Redis fill:#e74c3c,stroke:#333,color:#fff
    style GCPPubSub fill:#e74c3c,stroke:#333,color:#fff
    style GCPMon fill:#e74c3c,stroke:#333,color:#fff

    %% Optional
    style Prometheus fill:#f5a623,stroke:#333,color:#fff
    style OTel fill:#f5a623,stroke:#333,color:#fff

    %% Internal
    style Thanos fill:#2ecc71,stroke:#333,color:#fff
    style vLLM fill:#2ecc71,stroke:#333,color:#fff

    %% Inbound
    style PromOp fill:#e8e8e8,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
