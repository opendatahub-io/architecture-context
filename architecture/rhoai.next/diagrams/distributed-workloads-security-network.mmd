graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN (optional)"]
        S3Ext["S3 Storage<br/>(MinIO / AWS S3)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS Credentials"]
        PyPI["AIPCC PyPI Index<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        Registry["Container Registry<br/>(quay.io)<br/>443/TCP HTTPS<br/>Registry Credentials"]
    end

    subgraph Cluster["CLUSTER BOUNDARY"]
        subgraph IngressZone["INGRESS (Example Resources Only)"]
            MinIORoute["MinIO Routes<br/>443/TCP HTTPS → 9000-9001/TCP<br/>TLS Edge Termination"]
        end

        subgraph TestNS["TEST NAMESPACE (ephemeral)"]
            TestRunner["Test Runner<br/>(Go Test Suite)<br/>SA: test-namespace SA"]
            Workers["Worker Pods<br/>(Universal Training Images)<br/>th-torch-cpu/cuda/rocm-py312"]
        end

        subgraph Platform["PLATFORM CONTROLLERS"]
            K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
            KFTO["Training Operator<br/>(PyTorchJob)"]
            TrainerV2["Trainer v2<br/>(TrainJob)"]
            KubeRay["KubeRay<br/>(RayCluster, RayJob)"]
            KueueCtrl["Kueue<br/>(Admission Control)"]
        end

        subgraph ExampleSvc["EXAMPLE SERVICES"]
            MinIO["MinIO<br/>9000/TCP HTTP (API)<br/>9090/TCP HTTP (console)<br/>No encryption<br/>Opaque secret auth"]
            NFS["NFS Server<br/>2049/TCP NFS<br/>No encryption<br/>SCC: anyuid + privileged"]
        end

        subgraph Monitoring["MONITORING"]
            Prom["Prometheus<br/>443/TCP HTTPS<br/>TLS (CA-verified)<br/>SA Token auth"]
        end
    end

    %% Test execution flows
    TestRunner -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    K8sAPI -->|"CRD Watch"| KFTO
    K8sAPI -->|"CRD Watch"| TrainerV2
    K8sAPI -->|"CRD Watch"| KubeRay
    K8sAPI -->|"CRD Watch"| KueueCtrl
    KFTO -->|"Creates pods"| Workers
    TrainerV2 -->|"Creates pods"| Workers
    KubeRay -->|"Creates pods"| Workers

    %% Worker egress
    Workers -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS Creds"| S3Ext
    Workers -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HF

    %% Test monitoring
    TestRunner -->|"HTTPS/443<br/>TLS (CA-verified)<br/>SA Token"| Prom

    %% Example routes
    MinIORoute -->|"HTTP/9000-9001"| MinIO

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef testns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef example fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class HF,S3Ext,PyPI,Registry external
    class MinIORoute ingress
    class TestRunner,Workers testns
    class K8sAPI,KFTO,TrainerV2,KubeRay,KueueCtrl platform
    class MinIO,NFS example
    class Prom monitoring
