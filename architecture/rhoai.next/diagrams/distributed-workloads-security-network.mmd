graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI Pipeline"]
        Browser["User Browser"]
    end

    subgraph ControlPlane["OPENSHIFT CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / X.509"]
    end

    subgraph OperatorPlane["OPERATOR PLANE (Cluster Services)"]
        direction TB
        KFTO["KFTO Controller<br/>watches: PyTorchJob"]
        TrainerV2["Trainer v2 Controller<br/>watches: TrainJob"]
        KubeRay["KubeRay Operator<br/>watches: RayJob, RayCluster"]
        KueueCtrl["Kueue Controller<br/>watches: ClusterQueue"]
        JobSetCtrl["JobSet Controller<br/>watches: JobSet"]
    end

    subgraph WorkerPlane["WORKER PLANE (Training Pods)"]
        direction TB

        subgraph StandardTraining["Standard Training"]
            Worker1["Worker Pod 1<br/>Runtime/Universal Image"]
            WorkerN["Worker Pod N<br/>Runtime/Universal Image"]
        end

        subgraph MPITraining["MPI Training (OpenMPI)"]
            Launcher["Launcher Pod<br/>SA: per-job"]
            MPIWorker1["Worker Pod 1<br/>sshd: 2222/TCP"]
            MPIWorkerN["Worker Pod N<br/>sshd: 2222/TCP"]
        end

        subgraph WorkbenchMode["Workbench Mode"]
            Route["OpenShift Route<br/>443/TCP HTTPS<br/>TLS 1.2+"]
            Jupyter["JupyterLab Pod<br/>8888/TCP HTTP<br/>Universal Image"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN Bearer"]
        PyPI["PyPI (public)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        AIPCCPyPI["AIPCC PyPI (private)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RHEL subscription"]
        NVPyPI["NVIDIA PyPI<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        Prometheus["Prometheus<br/>9090/TCP HTTP<br/>No encryption"]
    end

    %% Control plane flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"CRD Watch<br/>HTTPS<br/>ServiceAccount"| KFTO
    K8sAPI -->|"CRD Watch<br/>HTTPS<br/>ServiceAccount"| TrainerV2
    K8sAPI -->|"CRD Watch<br/>HTTPS<br/>ServiceAccount"| KubeRay
    K8sAPI -->|"CRD Watch<br/>HTTPS<br/>ServiceAccount"| KueueCtrl

    %% Operator → Worker scheduling
    KFTO -->|"Pod scheduling"| Worker1
    TrainerV2 -->|"Pod scheduling"| Launcher

    %% Standard training inter-pod
    Worker1 <-->|"NCCL/RCCL<br/>Dynamic ports<br/>NO encryption"| WorkerN

    %% MPI training inter-pod
    Launcher -->|"SSH/2222<br/>SSH key pair"| MPIWorker1
    Launcher -->|"SSH/2222<br/>SSH key pair"| MPIWorkerN
    MPIWorker1 <-->|"NCCL/RCCL over IB/RDMA<br/>NO encryption"| MPIWorkerN

    %% Workbench mode
    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth/OIDC"| Route
    Route -->|"HTTP/8888<br/>No encryption<br/>Platform auth"| Jupyter
    Jupyter -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Egress flows
    Worker1 -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    MPIWorker1 -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Jupyter -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Jupyter -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    Worker1 -.->|"HTTPS/443<br/>build-time only"| PyPI
    Worker1 -.->|"HTTPS/443<br/>build-time only"| AIPCCPyPI
    Worker1 -.->|"HTTPS/443<br/>build-time only"| NVPyPI

    %% Monitoring
    K8sAPI -.->|"HTTP/9090<br/>GPU metrics"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workerplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef mpizone fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User,Browser external
    class K8sAPI controlplane
    class KFTO,TrainerV2,KubeRay,KueueCtrl,JobSetCtrl operatorplane
    class Worker1,WorkerN,Launcher,MPIWorker1,MPIWorkerN,Route,Jupyter workerplane
    class S3,HFHub,PyPI,AIPCCPyPI,NVPyPI,Prometheus externalservice
