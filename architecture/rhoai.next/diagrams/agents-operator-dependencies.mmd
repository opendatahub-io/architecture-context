graph LR
    AgentsOp["agents-operator<br/>(kagenti-operator)"]

    %% Required External Dependencies
    AgentsOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]
    AgentsOp -->|"K8s API client"| ClientGo["k8s.io/client-go<br/>v0.36.2"]
    AgentsOp -->|"JWT/JWK/JWS"| JWX["lestrrat-go/jwx<br/>v2.1.6"]
    AgentsOp -->|"policy eval (IBAC)"| OPA["open-policy-agent/opa<br/>v1.4.2"]
    AgentsOp -->|"gRPC framework"| GRPC["google.golang.org/grpc<br/>v1.81.1"]
    AgentsOp -->|"Envoy ext_proc"| EnvoyCP["envoyproxy/go-control-plane<br/>v1.37.0"]
    AgentsOp -->|"HTTP routing"| Chi["go-chi/chi<br/>v5.3.0"]
    AgentsOp -->|"metrics"| Prometheus["prometheus/client_golang<br/>v1.23.2"]
    AgentsOp -->|"JSON canonicalization"| JCS["gowebpki/jcs<br/>v1.0.1"]
    AgentsOp -->|"config hot-reload"| FSNotify["fsnotify<br/>v1.10.1"]
    AgentsOp -->|"SPARC reflection"| ALTK["agent-lifecycle-toolkit<br/>0.10.1"]
    AgentsOp -->|"Python HTTP"| FastAPI["fastapi<br/>>=0.110"]

    %% Optional External Dependencies
    AgentsOp -.->|"TLS certs (optional)"| CertManager["cert-manager<br/>v1.21.0"]
    AgentsOp -.->|"workload identity (optional)"| GoSpiffe["go-spiffe<br/>v2.8.1"]
    AgentsOp -.->|"supply-chain verify (optional)"| Sigstore["sigstore-go<br/>v1.2.2"]

    %% Internal Platform Dependencies
    AgentsOp -->|"CRD CRUD<br/>webhook TLS, mTLS"| CertMgrInt["cert-manager"]
    AgentsOp -->|"CRD Watch<br/>detect components"| DSC["DataScienceCluster"]
    AgentsOp -->|"CRD + REST API<br/>experiments, tracing"| MLflow["MLflow"]
    AgentsOp -->|"CRD CRUD + REST API<br/>clients, realms"| Keycloak["Keycloak"]
    AgentsOp -->|"CRD Watch + CRUD<br/>API gateway policies"| Kuadrant["Kuadrant"]
    AgentsOp -->|"CRD CRUD<br/>identity, trust bundles"| SPIRE["SPIRE / SPIFFE"]
    AgentsOp -->|"CRD Watch + Patch<br/>build workflows"| Tekton["Tekton"]
    AgentsOp -->|"gRPC ExtProc<br/>9090/TCP"| Envoy["Envoy Proxy"]
    AgentsOp -->|"CRD CRUD<br/>route management"| Routes["OpenShift Routes"]
    AgentsOp -->|"CRD Watch + Mutate<br/>sandbox mgmt"| Sandbox["Sandbox<br/>(agents.x-k8s.io)"]

    %% Integration points (inbound)
    DSC -.->|"component status"| AgentsOp

