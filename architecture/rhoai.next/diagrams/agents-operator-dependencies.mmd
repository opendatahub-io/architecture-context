graph LR
    AgentsOp["agents-operator<br/>(Kagenti Operator)"]

    %% External Dependencies (libraries/frameworks)
    AgentsOp -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    AgentsOp -->|"metrics"| Prometheus["prometheus/client_golang<br/>v1.23.2"]
    AgentsOp -.->|"SPIFFE Workload API"| GoSpiffe["go-spiffe/v2<br/>v2.8.1"]
    AgentsOp -.->|"supply-chain attestation"| SigstoreGo["sigstore-go<br/>v1.2.2"]
    AgentsOp -.->|"gateway API types"| GatewayAPI["gateway-api<br/>v1.6.0"]

    %% Internal Platform Dependencies (services)
    AgentsOp -->|"client registration<br/>REST API / 8080"| Keycloak["Keycloak (RHBK)"]
    AgentsOp -->|"workload identity<br/>CRD + Workload API"| SPIRE["SPIRE (ZTWIM)"]
    AgentsOp -->|"TLS certs<br/>CRD management"| CertManager["cert-manager<br/>v1.21.0"]
    AgentsOp -->|"ambient mesh<br/>namespace labels"| Istio["Istio (ztunnel)"]
    AgentsOp -.->|"experiment tracking<br/>REST API"| MLflow["MLflow"]
    AgentsOp -->|"platform state<br/>CRD watch"| DSCluster["DataScienceCluster"]
    AgentsOp -.->|"API management<br/>CRD create"| Kuadrant["Kuadrant"]
    AgentsOp -.->|"CI/CD config<br/>CRD patch"| Tekton["Tekton"]
    AgentsOp -->|"network validation<br/>API read"| OVN["OVN-Kubernetes"]

    %% Sub-component dependencies
    subgraph SubComponents["Sub-Components"]
        AuthBridge["AuthBridge Proxy"]
        TokenBrokerSvc["Token Broker"]
        BundleSvc["Bundle Service"]
    end

    AgentsOp -->|"sidecar injection"| AuthBridge
    AuthBridge -->|"token acquisition<br/>HTTP / 8190"| TokenBrokerSvc
    AuthBridge -->|"policy bundles<br/>HTTP / 8080"| BundleSvc

    %% External services consumed
    TokenBrokerSvc -->|"PKCE exchange<br/>HTTPS / 443"| OAuthProviders["OAuth Providers"]
    AgentsOp -.->|"attestation<br/>HTTPS / 443"| Sigstore["Sigstore Rekor"]

    %% Core infrastructure
    AgentsOp -->|"CRD watches<br/>HTTPS / 6443"| K8sAPI["Kubernetes API"]

    %% Styling
    style AgentsOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External library deps
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style GoSpiffe fill:#999,stroke:#333,color:#fff
    style SigstoreGo fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff

    %% Internal platform deps
    style Keycloak fill:#7ed321,stroke:#333,color:#fff
    style SPIRE fill:#7ed321,stroke:#333,color:#fff
    style CertManager fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style MLflow fill:#7ed321,stroke:#333,color:#fff
    style DSCluster fill:#7ed321,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style Tekton fill:#7ed321,stroke:#333,color:#fff
    style OVN fill:#7ed321,stroke:#333,color:#fff

    %% Sub-components
    style AuthBridge fill:#50c878,stroke:#333,color:#fff
    style TokenBrokerSvc fill:#50c878,stroke:#333,color:#fff
    style BundleSvc fill:#50c878,stroke:#333,color:#fff

    %% External services
    style OAuthProviders fill:#f5a623,stroke:#333,color:#fff
    style Sigstore fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
