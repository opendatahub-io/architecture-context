graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Platform Ingress<br/>Gateway API / OpenShift Route<br/>443/TCP → 8000/TCP<br/>TLS 1.2+<br/>kube-rbac-proxy auth"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT)"]
        direction TB

        subgraph NS_User["Namespace: user-namespace"]
            VLLMPod["vllm-rocm Predictor Pod<br/>User: 2000 (non-root)<br/>Image: rhoai/odh-vllm-rocm-rhel9<br/>Base: rhaiis/vllm-rocm-rhel9:3.2.1"]

            subgraph Ports["Exposed Ports"]
                REST["REST API<br/>8000/TCP HTTP<br/>OpenAI Compatible"]
                GRPC["TGIS gRPC<br/>8033/TCP<br/>RHAII scope only"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["Model Storage<br/>S3/PVC/OCI<br/>TLS 1.2+ (S3)<br/>Storage Credentials"]
        HF["Hugging Face Hub<br/>443/TCP HTTPS<br/>Bearer Token (optional)"]
        GPU["AMD ROCm GPU<br/>Device Plugin<br/>Host Driver"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Gateway -->|"HTTP/8000<br/>mTLS STRICT<br/>Service Identity"| REST
    VLLMPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Storage Credentials"| S3
    VLLMPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HF
    VLLMPod -->|"Device Driver<br/>GPU Compute"| GPU

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef port fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px

    class Client external
    class Gateway ingress
    class VLLMPod servicemesh
    class REST,GRPC port
    class S3,HF,GPU externalservice
