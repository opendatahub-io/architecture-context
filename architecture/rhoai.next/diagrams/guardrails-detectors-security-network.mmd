graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        vLLM["External vLLM Server<br/>OpenAI-compatible API<br/>Encryption: Configurable<br/>Auth: None"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT via Istio)"]
        direction TB

        subgraph NS_Guardrails["Namespace: guardrails"]
            Orchestrator["FMS Guardrails Orchestrator<br/>Caller — invokes detectors"]
        end

        subgraph NS_BuiltIn["Namespace: guardrails (standalone or KServe)"]
            BuiltIn["Built-in Detector<br/>odh-built-in-detector-rhel9<br/>8080/TCP HTTP<br/>Istio sidecar injected<br/>Platform auth (mTLS)"]
        end

        subgraph NS_HF["Namespace: KServe ISVC"]
            HFDetector["HuggingFace Detector<br/>odh-guardrails-detector-<br/>huggingface-runtime-rhel9<br/>8000/TCP HTTP<br/>Istio sidecar injected<br/>enable-auth: true"]
        end

        subgraph NS_Judge["Namespace: KServe ISVC"]
            JudgeDetector["LLM Judge Detector<br/>community-built image<br/>8000/TCP HTTP<br/>Istio sidecar injected<br/>enable-auth: true"]
        end
    end

    subgraph Storage["OBJECT STORAGE"]
        S3["S3/MinIO<br/>minio-guardrails-guardian<br/>9000/TCP HTTP<br/>Encryption: Configurable<br/>Auth: AWS IAM credentials"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes /metrics<br/>HTTP, No Auth<br/>trustyai_guardrails_* counters"]
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>mTLS (Istio)<br/>Platform Auth"| BuiltIn
    Orchestrator -->|"HTTP/8000<br/>mTLS (Istio)<br/>Platform Auth"| HFDetector
    Orchestrator -->|"HTTP/8000<br/>mTLS (Istio)<br/>Platform Auth + detector_id"| JudgeDetector

    JudgeDetector -->|"HTTP/configurable<br/>Configurable encryption<br/>No Auth"| vLLM

    HFDetector -->|"HTTP/9000<br/>Configurable encryption<br/>AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY"| S3

    Prometheus -.->|"HTTP/8080<br/>No Auth"| BuiltIn
    Prometheus -.->|"HTTP/8000<br/>No Auth"| HFDetector
    Prometheus -.->|"HTTP/8000<br/>No Auth"| JudgeDetector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef orchestrator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class vLLM external
    class Orchestrator orchestrator
    class BuiltIn,HFDetector,JudgeDetector servicemesh
    class S3 storage
    class Prometheus monitoring
