graph TB
    subgraph External["EXTERNAL CONSUMERS"]
        Orchestrator["FMS Guardrails Orchestrator<br/>REST API consumer"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS for KServe ISVCs)"]
        direction TB

        subgraph BuiltInNS["Built-in Detector (Deployment)"]
            BuiltIn["Built-in Detector<br/>ClusterIP :8080/TCP<br/>HTTP / Mesh TLS<br/>UID 1001 (non-root)<br/>No K8s API access"]
        end

        subgraph HFNS["HuggingFace Detector (KServe ISVC)"]
            HF["HuggingFace Detector<br/>ClusterIP :8000/TCP<br/>HTTP / Istio mTLS STRICT<br/>Auth: security.opendatahub.io<br/>UID 1001 (non-root)"]
        end

        subgraph JudgeNS["LLM Judge Detector (KServe ISVC)"]
            Judge["LLM Judge Detector<br/>ClusterIP :8000/TCP<br/>HTTP / Istio mTLS STRICT<br/>Auth: security.opendatahub.io<br/>UID 1001 (non-root)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 / MinIO<br/>:9000/TCP HTTP<br/>AWS credentials auth<br/>Model artifact storage"]
        vLLM["vLLM Inference Server<br/>Configurable port HTTP<br/>No auth<br/>LLM evaluation backend"]
        Prometheus["Prometheus<br/>Metrics scraping<br/>HTTP"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        KServe["KServe<br/>InferenceService lifecycle"]
        Istio["Istio Service Mesh<br/>mTLS + auth injection"]
        StorageInit["KServe Storage Initializer<br/>Init container"]
    end

    %% Inbound flows
    Orchestrator -->|"POST /api/v1/text/contents<br/>HTTP :8080<br/>Mesh TLS / Platform auth"| BuiltIn
    Orchestrator -->|"POST /api/v1/text/contents<br/>HTTP :8000<br/>Istio mTLS / Platform auth"| HF
    Orchestrator -->|"POST /api/v1/text/contents<br/>POST /api/v1/text/generation<br/>HTTP :8000<br/>Istio mTLS / Platform auth"| Judge

    %% Outbound flows
    Judge -->|"HTTP<br/>VLLM_BASE_URL<br/>No auth / No mandatory TLS"| vLLM
    StorageInit -->|"HTTP :9000<br/>AWS credentials"| S3
    StorageInit -.->|"model files → /mnt/models"| HF

    %% Metrics
    Prometheus -->|"GET /metrics<br/>HTTP :8080"| BuiltIn
    Prometheus -->|"GET /metrics<br/>HTTP :8000"| HF

    %% Platform management
    KServe -.->|manages| HF
    KServe -.->|manages| Judge
    Istio -.->|"sidecar injection<br/>mTLS enforcement"| HF
    Istio -.->|"sidecar injection<br/>mTLS enforcement"| Judge

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef mesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Orchestrator external
    class BuiltIn,HF,Judge mesh
    class S3,vLLM,Prometheus extsvc
    class KServe,Istio,StorageInit platform
