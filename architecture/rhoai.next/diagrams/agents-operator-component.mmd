graph TB
    subgraph AgentsOperator["Agents Operator (kagenti-operator-system)"]
        direction TB

        subgraph Manager["kagenti-operator (manager)"]
            direction LR
            ARCtrl["AgentRuntime<br/>Controller"]
            ACCtrl["AgentCard<br/>Controller"]
            ACSyncCtrl["AgentCard Sync<br/>Controller"]
            NPCtrl["NetworkPolicy<br/>Controller"]
            CRCtrl["ClientRegistration<br/>Reconciler"]
            MLflowCtrl["MLflow<br/>Controller"]
            KuadrantCtrl["Kuadrant<br/>Controller"]
            SPIRECtrl["SPIRE<br/>Controller"]
            TektonCtrl["TektonConfig<br/>Controller"]
            SharedTrustCtrl["SharedTrust<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks (9443/TCP)"]
            MutatingWH["inject.kagenti.io<br/>Mutating Webhook"]
            ValidateAC["vagentcard.kb.io<br/>Validating Webhook"]
            ValidateAR["vagentruntime.kb.io<br/>Validating Webhook"]
        end

        BundleSvc["bundle-service<br/>8080/TCP"]
    end

    subgraph Sidecars["Injected Sidecars (per agent pod)"]
        direction LR
        AuthProxy["authbridge-proxy<br/>8080/8081/TCP"]
        AuthEnvoy["authbridge-envoy<br/>9090/TCP gRPC"]
        AuthLite["authbridge-lite"]
        ProxyInit["proxy-init<br/>iptables setup"]
    end

    TokenBroker["token-broker<br/>8080/TCP"]
    SparcSvc["sparc-service<br/>Python/FastAPI"]
    AgentCardSigner["agentcard-signer<br/>CLI"]

    %% CRDs
    AgentRuntimeCR["AgentRuntime CR"]
    AgentCardCR["AgentCard CR"]
    AuthzPolicyCR["AuthorizationPolicy CR"]

    %% User interactions
    User["User / Platform Admin"] -->|creates| AgentRuntimeCR
    AgentRuntimeCR -->|watched by| ARCtrl
    ARCtrl -->|labels workload<br/>triggers injection| MutatingWH
    MutatingWH -->|injects| AuthProxy
    MutatingWH -->|injects| ProxyInit

    %% AgentCard lifecycle
    ARCtrl -->|triggers| ACSyncCtrl
    ACSyncCtrl -->|creates| AgentCardCR
    AgentCardCR -->|watched by| ACCtrl
    ACCtrl -->|fetches A2A card<br/>verifies JWS| AgentPod["Agent Pod"]
    ACCtrl -->|updates status| NPCtrl
    NPCtrl -->|creates/updates| NP["NetworkPolicy"]

    %% Client registration
    ARCtrl -->|triggers| CRCtrl
    CRCtrl -->|registers client| Keycloak["Keycloak"]

    %% Bundle service
    AuthzPolicyCR -->|watched by| BundleSvc
    BundleSvc -->|serves OPA bundles| AuthProxy

    %% Token broker
    AuthProxy -->|token exchange| TokenBroker
    TokenBroker -->|OAuth2 flows| Keycloak

    %% Validation webhooks
    AgentCardCR -.->|validated by| ValidateAC
    AgentRuntimeCR -.->|validated by| ValidateAR

    %% Signing
    AgentCardSigner -->|signs with SPIRE X.509| AgentCardCR

    %% Conditional controllers
    MLflowCtrl -.->|if CRD exists| MLflow["MLflow"]
    KuadrantCtrl -.->|if CRD exists| KuadrantSvc["Kuadrant"]
    SPIRECtrl -.->|if CRD exists| SPIRESvc["SPIRE"]
    TektonCtrl -.->|if CRD exists| TektonSvc["Tekton"]

    %% Styles
    style ARCtrl fill:#4a90e2,color:#fff
    style ACCtrl fill:#4a90e2,color:#fff
    style ACSyncCtrl fill:#4a90e2,color:#fff
    style NPCtrl fill:#4a90e2,color:#fff
    style CRCtrl fill:#4a90e2,color:#fff
    style MLflowCtrl fill:#4a90e2,color:#fff
    style KuadrantCtrl fill:#4a90e2,color:#fff
    style SPIRECtrl fill:#4a90e2,color:#fff
    style TektonCtrl fill:#4a90e2,color:#fff
    style SharedTrustCtrl fill:#4a90e2,color:#fff
    style MutatingWH fill:#e67e22,color:#fff
    style ValidateAC fill:#e67e22,color:#fff
    style ValidateAR fill:#e67e22,color:#fff
    style BundleSvc fill:#27ae60,color:#fff
    style AuthProxy fill:#8e44ad,color:#fff
    style AuthEnvoy fill:#8e44ad,color:#fff
    style AuthLite fill:#8e44ad,color:#fff
    style ProxyInit fill:#8e44ad,color:#fff
    style TokenBroker fill:#27ae60,color:#fff
    style AgentRuntimeCR fill:#f5a623
    style AgentCardCR fill:#f5a623
    style AuthzPolicyCR fill:#f5a623
    style Keycloak fill:#999,color:#fff
    style MLflow fill:#999,color:#fff
    style KuadrantSvc fill:#999,color:#fff
    style SPIRESvc fill:#999,color:#fff
    style TektonSvc fill:#999,color:#fff
