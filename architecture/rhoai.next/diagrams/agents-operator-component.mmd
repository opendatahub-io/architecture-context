graph TB
    subgraph KagentiOperator["Kagenti Operator (kagenti-system)"]
        direction TB
        Controller["kagenti-operator<br/>Go Operator<br/>8081/TCP health<br/>8443/TCP metrics<br/>9443/TCP webhooks"]
        MutatingWH["AuthBridge Mutating Webhook<br/>/mutate-workloads-authbridge"]
        ValidatingWH_Card["AgentCard Validating Webhook<br/>/validate-agentcard"]
        ValidatingWH_RT["AgentRuntime Validating Webhook<br/>/validate-agentruntime"]
        Controller --> MutatingWH
        Controller --> ValidatingWH_Card
        Controller --> ValidatingWH_RT
    end

    subgraph SidecarLayer["Sidecar Layer (per-agent Pod)"]
        AuthBridge["authbridge-proxy<br/>8080/TCP reverse proxy<br/>3128/TCP forward proxy<br/>9091/TCP health<br/>mTLS + JWT + plugins"]
    end

    subgraph SupportServices["Support Services (kagenti-system)"]
        TokenBroker["token-broker<br/>8190/TCP<br/>OAuth2 PKCE session broker"]
        BundleService["bundle-service<br/>8080/TCP<br/>OPA policy bundles"]
    end

    subgraph CLITools["CLI / Test Tools"]
        AgentCardSigner["agentcard-signer<br/>JWS signing CLI"]
        TestTLSAgent["test-tls-agent<br/>8443/TCP mTLS test server"]
    end

    %% CRDs
    User[User / kubectl] -->|creates| AgentRuntimeCR["AgentRuntime CR<br/>agent.kagenti.dev/v1alpha1"]
    AgentRuntimeCR -->|watched by| Controller
    Controller -->|creates| AgentCardCR["AgentCard CR<br/>agent.kagenti.dev/v1alpha1"]
    Controller -->|manages| AuthPolicyCR["AuthorizationPolicy CR<br/>agent.kagenti.dev/v1alpha1"]

    %% Sidecar injection
    MutatingWH -->|injects sidecar into| AgentPod["Agent Pod"]
    AuthBridge -.->|runs inside| AgentPod

    %% Support service connections
    AuthBridge -->|token acquisition| TokenBroker
    AuthBridge -->|policy bundles| BundleService

    %% External dependencies
    Controller -->|client registration| Keycloak["Keycloak (RHBK)"]
    Controller -->|identity management| SPIRE["SPIRE (ZTWIM)"]
    Controller -->|TLS certs| CertManager["cert-manager"]
    Controller -->|mesh enrollment| Istio["Istio (ztunnel)"]
    Controller -->|experiment tracking| MLflow["MLflow"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style MutatingWH fill:#4a90e2,stroke:#333,color:#fff
    style ValidatingWH_Card fill:#4a90e2,stroke:#333,color:#fff
    style ValidatingWH_RT fill:#4a90e2,stroke:#333,color:#fff
    style AuthBridge fill:#50c878,stroke:#333,color:#fff
    style TokenBroker fill:#50c878,stroke:#333,color:#fff
    style BundleService fill:#50c878,stroke:#333,color:#fff
    style AgentCardSigner fill:#b0b0b0,stroke:#333
    style TestTLSAgent fill:#b0b0b0,stroke:#333
    style AgentRuntimeCR fill:#f5a623,stroke:#333
    style AgentCardCR fill:#f5a623,stroke:#333
    style AuthPolicyCR fill:#f5a623,stroke:#333
    style Keycloak fill:#e8e8e8,stroke:#333
    style SPIRE fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
