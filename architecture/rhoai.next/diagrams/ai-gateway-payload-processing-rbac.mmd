graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["payload-processing-{release}"]
    end

    subgraph Bindings["ClusterRole Binding"]
        CRB["{release}-externalmodels-reader<br/>ClusterRoleBinding"]
    end

    subgraph ClusterRolePerms["ClusterRole: {release}-externalmodels-reader"]
        CR["{release}-externalmodels-reader"]
    end

    subgraph CoreResources["API Group: core ('')"]
        Secrets["secrets"]
        Services["services"]
    end

    subgraph MaasResources["API Group: maas.opendatahub.io"]
        MaasEM["externalmodels<br/>(legacy)"]
    end

    subgraph InferenceResources["API Group: inference.opendatahub.io"]
        EP["externalproviders"]
        EM["externalmodels"]
        EPStatus["externalproviders/status"]
        EMStatus["externalmodels/status"]
        EPFinalizers["externalproviders/finalizers"]
        EMFinalizers["externalmodels/finalizers"]
    end

    subgraph GatewayResources["API Group: gateway.networking.k8s.io"]
        HTTPRoutes["httproutes"]
    end

    subgraph IstioResources["API Group: networking.istio.io"]
        ServiceEntries["serviceentries"]
        DestRules["destinationrules"]
    end

    %% Binding chain
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR

    %% Core permissions
    CR -->|"get, list, watch"| Secrets
    CR -->|"get, list, watch,<br/>create, update, delete"| Services

    %% Legacy permissions
    CR -->|"get, list, watch"| MaasEM

    %% Inference CRD permissions
    CR -->|"get, list, watch,<br/>create, update"| EP
    CR -->|"get, list, watch,<br/>create, update"| EM
    CR -->|"get, update, patch"| EPStatus
    CR -->|"get, update, patch"| EMStatus
    CR -->|"update"| EPFinalizers
    CR -->|"update"| EMFinalizers

    %% Gateway API permissions
    CR -->|"get, list, watch,<br/>create, update, delete"| HTTPRoutes

    %% Istio permissions
    CR -->|"get, list, watch,<br/>create, update, delete"| ServiceEntries
    CR -->|"get, list, watch,<br/>create, update, delete"| DestRules

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CRB fill:#d5e8d4,stroke:#82b366
    style CR fill:#f5a623,color:#fff
    style Secrets fill:#f8cecc,stroke:#b85450
    style Services fill:#7ed321,color:#fff
    style MaasEM fill:#ccc,stroke:#999
    style EP fill:#7ed321,color:#fff
    style EM fill:#7ed321,color:#fff
    style EPStatus fill:#d5e8d4,stroke:#82b366
    style EMStatus fill:#d5e8d4,stroke:#82b366
    style EPFinalizers fill:#e1d5e7,stroke:#9673a6
    style EMFinalizers fill:#e1d5e7,stroke:#9673a6
    style HTTPRoutes fill:#fff2cc,stroke:#d6b656
    style ServiceEntries fill:#ffe6cc,stroke:#d79b00
    style DestRules fill:#ffe6cc,stroke:#d79b00
