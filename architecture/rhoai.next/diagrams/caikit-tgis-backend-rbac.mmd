graph TD
    subgraph Note["caikit-tgis-backend RBAC"]
        direction TB
        Info["This component is a Python library,<br/>not a Kubernetes operator or deployed workload.<br/><br/>It has NO direct RBAC requirements:<br/>• No ClusterRoles<br/>• No RoleBindings<br/>• No ServiceAccounts<br/>• No Kubernetes API interactions"]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB

        subgraph RemoteTLS["Remote Mode — TLS"]
            TLS_Auth["grpc.ssl_channel_credentials<br/><br/>CA cert: validates server identity<br/>Enforcement: gRPC channel creation"]
        end

        subgraph RemoteMTLS["Remote Mode — mTLS"]
            MTLS_Auth["grpc.ssl_channel_credentials<br/><br/>CA cert: validates server identity<br/>Client cert: proves client identity<br/>Client key: private key<br/>Enforcement: gRPC channel creation"]
        end

        subgraph LocalInsecure["Local Mode — Insecure"]
            Insecure_Auth["grpc.insecure_channel<br/><br/>No encryption<br/>No authentication<br/>Localhost only (127.0.0.1:50055)"]
        end
    end

    subgraph SecretAccess["Secrets Consumed (file paths)"]
        CACert["ca_cert_file<br/><i>TLS CA certificate</i><br/>Provisioned by: consuming deployment"]
        ClientCert["client_cert_file<br/><i>TLS client certificate</i><br/>Provisioned by: consuming deployment"]
        ClientKey["client_key_file<br/><i>TLS private key</i><br/>Provisioned by: consuming deployment"]
    end

    TLS_Auth -.->|"reads from disk"| CACert
    MTLS_Auth -.->|"reads from disk"| CACert
    MTLS_Auth -.->|"reads from disk"| ClientCert
    MTLS_Auth -.->|"reads from disk"| ClientKey

    subgraph Delegation["RBAC Delegation"]
        Runtime["caikit-tgis-serving<br/>(consuming deployment)<br/><br/>Responsible for:<br/>• ServiceAccount creation<br/>• RoleBinding configuration<br/>• Secret mounting<br/>• Network policy"]
    end

    style Info fill:#fff3cd,stroke:#ffc107,stroke-width:2px,color:#333
    style TLS_Auth fill:#d5e8d4,stroke:#82b366
    style MTLS_Auth fill:#d5e8d4,stroke:#82b366
    style Insecure_Auth fill:#f8cecc,stroke:#b85450
    style CACert fill:#f8cecc,stroke:#b85450
    style ClientCert fill:#f8cecc,stroke:#b85450
    style ClientKey fill:#f8cecc,stroke:#b85450
    style Runtime fill:#dae8fc,stroke:#6c8ebf
