graph TD
    subgraph Note["caikit-tgis-backend RBAC"]
        direction TB
        Info["No RBAC Roles or Bindings<br/><br/>caikit-tgis-backend is a Python library<br/>with no direct Kubernetes API interactions.<br/><br/>RBAC is the responsibility of the<br/>hosting serving runtime pod."]
    end

    subgraph TLSAuth["TLS/mTLS Authentication"]
        direction TB

        subgraph Credentials["Credential Files"]
            CACert["CA Certificate<br/>(ca_cert_file)<br/>Validates TGIS server identity"]
            ClientCert["Client Certificate<br/>(client_cert_file)<br/>mTLS client authentication"]
            ClientKey["Client Key<br/>(client_key_file)<br/>mTLS client private key"]
        end

        subgraph Modes["Connection Modes"]
            Plaintext["Plaintext<br/>(local subprocess only)<br/>No TLS"]
            TLS["TLS<br/>(server verification)<br/>CA cert required"]
            MTLS["mTLS<br/>(mutual authentication)<br/>CA cert + client cert + key"]
        end

        CACert -->|"used by"| TLS
        CACert -->|"used by"| MTLS
        ClientCert -->|"used by"| MTLS
        ClientKey -->|"used by"| MTLS
    end

    subgraph Enforcement["Enforcement Points"]
        GRPCChannel["grpc.ssl_channel_credentials()<br/>(tgis_connection.py:270-281)"]
        FileCheck["File existence validation<br/>(tgis_connection.py:147-154)"]
        PairCheck["mTLS requires BOTH<br/>client cert AND client key"]
    end

    TLS -->|"configured via"| GRPCChannel
    MTLS -->|"configured via"| GRPCChannel
    Credentials -->|"validated by"| FileCheck
    ClientCert -->|"enforced by"| PairCheck
    ClientKey -->|"enforced by"| PairCheck

    style Info fill:#f9f9f9,stroke:#999
    style CACert fill:#f5a623,color:#fff
    style ClientCert fill:#f5a623,color:#fff
    style ClientKey fill:#f5a623,color:#fff
    style Plaintext fill:#e8e8e8
    style TLS fill:#7ed321,color:#fff
    style MTLS fill:#4a90e2,color:#fff
    style GRPCChannel fill:#dae8fc,stroke:#6c8ebf
    style FileCheck fill:#dae8fc,stroke:#6c8ebf
    style PairCheck fill:#dae8fc,stroke:#6c8ebf
