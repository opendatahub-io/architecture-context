graph TB
    subgraph "lm-evaluation-harness-sobha"
        subgraph "EvalHub Adapter Layer"
            MainPy["main.py<br/>(LMEvalAdapter)"]
            PathResolver["Path Resolver<br/>(CWE-22 mitigation)"]
            Sanitizer["Error Sanitizer<br/>(secret redaction)"]
            MainPy --> PathResolver
            MainPy --> Sanitizer
        end

        subgraph "Core Evaluation Framework"
            LMEval["lm_eval<br/>(v0.4.8)"]
            Tasks["Benchmark Tasks<br/>(150+ categories)"]
            Models["Model Backends<br/>(local-completions, HF, vLLM)"]
            Metrics["Metrics Computation<br/>(BLEU, ROUGE, WER)"]
            LMEval --> Tasks
            LMEval --> Models
            LMEval --> Metrics
        end

        subgraph "Utilities"
            S3Downloader["s3_downloader.py"]
        end

        MainPy -->|"configures & runs"| LMEval
        MainPy -->|"optional pre-fetch"| S3Downloader
    end

    %% External Inputs
    K8sJob["Kubernetes Job<br/>(created by operator)"] -->|"launches container"| MainPy
    ConfigMap["/meta/job.json<br/>(ConfigMap)"] -->|"job specification"| PathResolver

    %% External Services
    Models -->|"POST /v1/completions<br/>Bearer token"| ModelEndpoint["Model Inference<br/>Endpoint"]
    MainPy -->|"status & results<br/>Bearer token"| EvalHub["EvalHub<br/>Callback Service"]
    LMEval -->|"download tokenizers<br/>HF_TOKEN"| HFHub["HuggingFace Hub"]
    S3Downloader -->|"download assets<br/>AWS IAM"| S3["S3-Compatible<br/>Storage"]
    MainPy -->|"push artifacts"| OCIRegistry["OCI Registry"]
    MainPy -->|"log metrics"| MLflow["MLflow"]

    %% Platform dependency
    TrustyAI["trustyai-service-operator"] -.->|"creates Job from<br/>LMEvalJob CRD"| K8sJob

    %% Styles
    style MainPy fill:#4a90e2,color:#fff
    style LMEval fill:#4a90e2,color:#fff
    style S3Downloader fill:#4a90e2,color:#fff
    style PathResolver fill:#4a90e2,color:#fff
    style Sanitizer fill:#4a90e2,color:#fff
    style Tasks fill:#4a90e2,color:#fff
    style Models fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style ConfigMap fill:#f5a623,color:#000
    style K8sJob fill:#f5a623,color:#000
    style TrustyAI fill:#7ed321,color:#000
    style ModelEndpoint fill:#e8e8e8,color:#000
    style EvalHub fill:#e8e8e8,color:#000
    style HFHub fill:#e8e8e8,color:#000
    style S3 fill:#e8e8e8,color:#000
    style OCIRegistry fill:#e8e8e8,color:#000
    style MLflow fill:#e8e8e8,color:#000
