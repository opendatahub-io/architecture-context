graph LR
    OpenShell["OpenShell<br/>(Gateway + Supervisor + Sandbox)"]

    %% External Dependencies - Core
    OpenShell -->|"async runtime"| Tokio["tokio 1.43"]
    OpenShell -->|"HTTP server"| Axum["axum 0.8"]
    OpenShell -->|"gRPC framework"| Tonic["tonic 0.14"]
    OpenShell -->|"TLS"| Rustls["rustls 0.23<br/>aws-lc-rs provider"]
    OpenShell -->|"database"| SQLx["sqlx 0.9<br/>PostgreSQL + SQLite"]

    %% External Dependencies - Security
    OpenShell -->|"policy verification"| Z3["Z3 SMT Solver"]
    OpenShell -->|"policy engine"| Regorus["regorus 0.9<br/>OPA/Rego"]
    OpenShell -->|"FIPS crypto"| AwsLcRs["aws-lc-rs 1.16"]

    %% External Dependencies - Integration
    OpenShell -->|"K8s client"| Kube["kube 0.99"]
    OpenShell -->|"SSH protocol"| Russh["russh 0.63.1"]
    OpenShell -->|"Docker API"| Bollard["bollard 0.20"]

    %% Platform Dependencies
    OpenShell -->|"pod lifecycle,<br/>RBAC, Secrets"| K8sAPI["Kubernetes API"]
    OpenShell -->|"user auth"| OIDC["OIDC Provider"]
    OpenShell -->|"sandbox CRD"| SandboxCRD["agents.x-k8s.io<br/>Sandbox CRD"]

    %% Optional Dependencies
    OpenShell -.->|"TLS certs"| CertManager["cert-manager"]
    OpenShell -.->|"credential storage"| Vault["Vault"]
    OpenShell -.->|"tracing"| OTLP["OTLP Collector"]
    OpenShell -.->|"external ingress"| EnvoyGW["Envoy Gateway<br/>Gateway API"]
    OpenShell -.->|"external ingress"| OSRouter["OpenShift Router"]
    OpenShell -.->|"identity tokens"| SPIFFE["SPIFFE Workload API"]

    %% SDK Dependencies
    GoSDK["Go SDK"] -->|"gRPC transport"| GoGRPC["google.golang.org/grpc 1.83"]
    PythonSDK["Python SDK"] -->|"gRPC transport"| GrpcIO["grpcio ≥1.60"]
    PythonSDK -->|"HTTP client"| Httpx["httpx ≥0.27"]
    GoSDK -->|"gateway client"| OpenShell
    PythonSDK -->|"gateway client"| OpenShell

