graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Service["SERVICE (Internal Testing)"]
        direction TB

        subgraph SimPod["Pod: llm-d-inference-sim"]
            Sim["llm-d-inference-sim<br/>8000/TCP HTTP+gRPC<br/>Optional TLS 1.2+<br/>No Auth<br/>distroless/static:nonroot<br/>CGO_ENABLED=0 (not FIPS)"]
            Render["vLLM Render Sidecar<br/>8082/TCP HTTP<br/>No TLS, No Auth<br/>Init container (native sidecar)"]
        end

        subgraph DiagPod["Pod: zmq-listener (optional)"]
            ZMQListener["zmq-listener<br/>5557/TCP ZMQ SUB<br/>python:3.12-slim"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        ZMQSub["ZMQ Subscriber(s)<br/>5557/TCP<br/>ZMQ PUB/SUB<br/>No Encryption"]
        Prometheus["Prometheus<br/>Scrapes /metrics<br/>8000/TCP HTTP"]
    end

    %% Ingress flows
    Client -->|"HTTP+gRPC / 8000/TCP<br/>Optional TLS 1.2+<br/>No Auth"| Sim

    %% Internal flows
    Sim -->|"HTTP / 8082/TCP<br/>No TLS, No Auth<br/>Tokenization"| Render

    %% Egress flows
    Sim -->|"ZMQ PUB / 5557/TCP<br/>No Encryption, No Auth<br/>KV cache events"| ZMQSub
    Sim -->|"HTTPS / 443/TCP<br/>TLS 1.2+<br/>Bearer Token (HF_TOKEN)<br/>Datasets + Tokenizers"| HFHub
    Prometheus -->|"HTTP / 8000/TCP<br/>Scrape /metrics<br/>Optional TLS"| Sim
    ZMQListener -->|"ZMQ SUB / 5557/TCP<br/>No Encryption"| Sim

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Sim,Render,ZMQListener service
    class HFHub,ZMQSub,Prometheus externalservice
