graph LR
    LMEval["LM Evaluation Harness<br/>(Batch Job)"]

    %% External Dependencies (Libraries)
    LMEval -->|"runtime"| Python["Python 3.11"]
    LMEval -->|"tensor ops"| PyTorch["PyTorch 2.6.0"]
    LMEval -->|"tokenizers"| Transformers["HF Transformers 4.48.0"]
    LMEval -->|"datasets"| Datasets["HF Datasets 3.1.0"]
    LMEval -->|"adapter SDK"| EvalHubSDK["eval-hub-sdk 0.4.4"]
    LMEval -->|"custom tasks"| Unitxt["Unitxt 1.17.2"]
    LMEval -->|"LoRA models"| PEFT["PEFT 0.13.2"]
    LMEval -->|"S3 access"| Boto3["boto3 1.42.12"]
    LMEval -->|"OCI artifacts"| Olot["olot 0.1.15"]
    LMEval -->|"OCI push"| Skopeo["skopeo (system)"]
    LMEval -.->|"optional"| WatsonX["ibm-watsonx-ai 1.4.11"]

    %% Internal Platform Dependencies
    LMEval -->|"status callbacks"| EvalHub["EvalHub Service"]
    LMEval -->|"evaluation prompts"| ModelServing["Model Serving<br/>(vLLM / TGI)"]
    LMEval -->|"experiment tracking"| MLflow["MLflow"]

    %% Things that depend on LMEval
    Operator["TrustyAI LMEval<br/>Operator"] -->|"creates Job with<br/>this image"| LMEval

    %% External Services
    LMEval -->|"result storage"| OCIRegistry["OCI Registry<br/>(Quay)"]
    LMEval -->|"datasets download"| HFHub["HuggingFace Hub"]
    LMEval -->|"model assets"| S3["S3-compatible<br/>Storage"]

    %% Kubernetes Resources
    LMEval -->|"job spec"| ConfigMap["K8s ConfigMap<br/>(/meta/job.json)"]
    LMEval -->|"credentials"| Secrets["K8s Secrets"]

    %% Styling
    style LMEval fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External libraries
    style Python fill:#999,stroke:#333
    style PyTorch fill:#999,stroke:#333
    style Transformers fill:#999,stroke:#333
    style Datasets fill:#999,stroke:#333
    style EvalHubSDK fill:#999,stroke:#333
    style Unitxt fill:#999,stroke:#333
    style PEFT fill:#999,stroke:#333
    style Boto3 fill:#999,stroke:#333
    style Olot fill:#999,stroke:#333
    style Skopeo fill:#999,stroke:#333
    style WatsonX fill:#ccc,stroke:#999,stroke-dasharray: 5 5

    %% Internal platform
    style EvalHub fill:#7ed321,stroke:#333
    style ModelServing fill:#7ed321,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style Operator fill:#7ed321,stroke:#333

    %% External services
    style OCIRegistry fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333

    %% Kubernetes
    style ConfigMap fill:#f5a623,stroke:#333
    style Secrets fill:#f5a623,stroke:#333
