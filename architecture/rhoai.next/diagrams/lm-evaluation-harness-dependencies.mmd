graph LR
    LMEval["LM Evaluation Harness<br/>(Batch Job)"]

    %% Core Python Dependencies
    subgraph CoreDeps["Core Dependencies"]
        lmeval_lib["lm-evaluation-harness<br/>0.4.8"]
        evalhub_sdk["eval-hub-sdk<br/>0.4.4"]
        torch["PyTorch<br/>2.6.0"]
        transformers["HF Transformers<br/>4.48.0"]
    end

    LMEval -->|"evaluation framework"| lmeval_lib
    LMEval -->|"platform integration"| evalhub_sdk
    LMEval -->|"tensor operations"| torch
    LMEval -->|"tokenization"| transformers

    %% ML/Data Dependencies
    subgraph MLDeps["ML & Data Libraries"]
        accelerate["accelerate<br/>1.0.1"]
        datasets["datasets<br/>3.1.0"]
        unitxt["unitxt<br/>1.17.2"]
        peft["peft<br/>0.13.2"]
        sklearn["scikit-learn<br/>1.5.2"]
        sacrebleu["sacrebleu<br/>2.4.3"]
    end

    LMEval -->|"distributed eval"| accelerate
    LMEval -->|"dataset loading"| datasets
    LMEval -->|"custom task catalogs"| unitxt
    LMEval -->|"adapter support"| peft
    LMEval -->|"statistical metrics"| sklearn
    LMEval -->|"translation metrics"| sacrebleu

    %% Infrastructure Dependencies
    subgraph InfraDeps["Infrastructure & Storage"]
        boto3["boto3<br/>1.42.12"]
        olot["olot<br/>0.1.15"]
        skopeo["skopeo<br/>(system)"]
    end

    LMEval -->|"S3 access (air-gapped)"| boto3
    LMEval -->|"OCI artifact mgmt"| olot
    LMEval -->|"OCI push"| skopeo

    %% Optional Dependencies
    subgraph OptionalDeps["Optional"]
        watsonx["ibm-watsonx-ai<br/>1.4.11"]
    end

    LMEval -.->|"IBM backend (optional)"| watsonx

    %% Internal Platform Dependencies
    subgraph PlatformDeps["Internal Platform (RHOAI)"]
        EvalHubSvc["EvalHub Service"]
        ModelEP["Model Inference<br/>Endpoint"]
        MLflow["MLflow"]
    end

    LMEval -->|"job specs + callbacks"| EvalHubSvc
    LMEval -->|"model evaluation<br/>/v1/completions"| ModelEP
    LMEval -.->|"experiment tracking"| MLflow

    %% External Service Dependencies
    subgraph ExtServices["External Services"]
        HFHub["HuggingFace Hub"]
        OCIReg["OCI Registry"]
        S3["S3-Compatible<br/>Storage"]
    end

    LMEval -->|"tokenizers + datasets"| HFHub
    LMEval -->|"result artifacts"| OCIReg
    LMEval -.->|"cached data (air-gapped)"| S3

    %% Styling
    style LMEval fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style lmeval_lib fill:#4a90e2,stroke:#333,color:#fff
