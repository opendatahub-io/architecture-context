graph LR
    LMES["lm-evaluation-harness<br/>(Batch Job)"]

    %% Internal RHOAI Dependencies
    LMES -->|"launched by<br/>LMEvalJob CRD"| TrustyAI["TrustyAI Operator"]
    LMES -->|"HTTP callbacks<br/>HTTPS/443"| EvalHub["EvalHub Service"]
    LMES -->|"OpenAI Completions API<br/>HTTPS"| ModelEP["Model Inference<br/>Endpoint"]

    %% External Dependencies - Core Runtime
    LMES -->|"evaluation engine"| LMEvalPkg["lm_eval v0.4.8"]
    LMES -->|"tensor ops"| PyTorch["torch >=2.6.0"]
    LMES -->|"tokenizer loading"| Transformers["transformers >=4.48.0"]
    LMES -->|"model acceleration"| Accelerate["accelerate >=1.0.1"]
    LMES -->|"dataset loading"| Datasets["datasets >=3.1.0"]

    %% External Dependencies - Integration
    LMES -->|"job lifecycle"| EvalHubSDK["eval-hub-sdk ~=1.0.0"]
    LMES -->|"S3 access"| Boto3["boto3 >=1.42.12"]
    LMES -->|"OCI artifacts"| Olot["olot >=0.1.15"]
    LMES -->|"HTTP client"| Requests["requests ==2.32.5"]
    LMES -->|"async HTTP"| Aiohttp["aiohttp ==3.13.3"]
    LMES -->|"Unitxt framework"| Unitxt["unitxt >=1.17.2"]
    LMES -.->|"optional"| WatsonX["ibm-watsonx-ai ==1.4.11"]

    %% External Services
    LMES -->|"datasets, tokenizers<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    LMES -->|"asset storage<br/>HTTPS"| S3["S3 Storage"]
    LMES -->|"result artifacts<br/>HTTPS/443"| OCIReg["OCI Registry"]
    LMES -->|"metrics logging<br/>HTTPS"| MLflow["MLflow Server"]

    %% System Dependencies
    LMES -->|"OCI image copy"| Skopeo["skopeo (RPM)"]

    %% Styling
    style LMES fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TrustyAI fill:#7ed321,stroke:#333,color:#fff
    style EvalHub fill:#7ed321,stroke:#333,color:#fff
    style ModelEP fill:#7ed321,stroke:#333,color:#fff
    style LMEvalPkg fill:#b8d4f0,stroke:#333
    style PyTorch fill:#b8d4f0,stroke:#333
    style Transformers fill:#b8d4f0,stroke:#333
