graph TB
    subgraph DCH["Data Connect Hub"]
        direction TB

        subgraph ControlPlane["Control Plane (Go)"]
            Controller["dc-controller<br/>(controller-runtime)<br/>Go 1.26"]
        end

        subgraph DataPlane["Data Plane (Rust)"]
            direction TB

            subgraph RESTStack["REST Service Stack"]
                KubeRBACProxy["kube-rbac-proxy<br/>(sidecar)<br/>8443/TCP"]
                RESTService["rest-service<br/>(actix-web)<br/>8080/TCP"]
                KubeRBACProxy -->|"authenticated<br/>traffic"| RESTService
            end

            subgraph FlightStack["Flight Service Stack"]
                AuthLayer["AuthLayer<br/>(Tower middleware)"]
                FlightService["flight-service<br/>(tonic gRPC)<br/>8443/TCP"]
                AuthLayer -->|"validated<br/>request"| FlightService
            end

            subgraph Connectors["Pluggable Connectors"]
                direction LR
                PG["postgres-<br/>connector"]
                SQLite["sqlite-<br/>connector"]
                S3Conn["s3-<br/>connector"]
                Milvus["milvus-<br/>connector"]
                ES["elasticsearch-<br/>connector"]
                Neo4j["neo4j-<br/>connector"]
                URI["uri-<br/>connector"]
            end

            subgraph SharedLibs["Shared Libraries"]
                direction LR
                Commons["commons"]
                FormatReaders["format-readers<br/>(CSV, JSON, Parquet)"]
                KubeUtils["kube-utils"]
                PgMetaStore["pg-meta-store"]
            end
        end
    end

    %% CRDs
    DCSCR["DataConnectService CR"]
    InitDC["InitDataConnection CR"]
    InitDCT["InitDataConnectionType CR"]

    %% External systems
    User["Client / SDK"]
    K8sAPI["Kubernetes API"]
    PostgreSQL["PostgreSQL"]
    Gateway["odh-gateway<br/>(HTTPRoute)"]
    DataSources["Data Source<br/>Backends"]

    %% Relationships
    DCSCR -->|"watched by"| Controller
    InitDC -->|"watched by"| Controller
    InitDCT -->|"watched by"| Controller
    Controller -->|"creates/manages"| RESTStack
    Controller -->|"creates/manages"| FlightStack
    Controller -->|"manages RBAC,<br/>NetworkPolicy,<br/>HTTPRoute"| K8sAPI

    User -->|"HTTPS/8443"| Gateway
    Gateway -->|"routes to"| KubeRBACProxy
    Gateway -->|"routes to"| AuthLayer

    RESTService -->|"gRPC/8443"| FlightService
    FlightService --> Connectors
    Connectors --> DataSources

    RESTService -->|"SQL/5432"| PostgreSQL
    FlightService -->|"SQL/5432"| PostgreSQL

    KubeRBACProxy -->|"TokenReview +<br/>SubjectAccessReview"| K8sAPI
    AuthLayer -->|"TokenReview +<br/>SubjectAccessReview"| K8sAPI

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style RESTService fill:#4a90e2,stroke:#333,color:#fff
    style FlightService fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACProxy fill:#e8a838,stroke:#333,color:#fff
    style AuthLayer fill:#e8a838,stroke:#333,color:#fff
    style DCSCR fill:#f5a623,stroke:#333
    style InitDC fill:#f5a623,stroke:#333
    style InitDCT fill:#f5a623,stroke:#333
    style Gateway fill:#7ed321,stroke:#333
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style DataSources fill:#999,stroke:#333,color:#fff
    style User fill:#e8e8e8,stroke:#333
    style PG fill:#dfe6f0,stroke:#336791
    style SQLite fill:#dfe6f0,stroke:#336791
    style S3Conn fill:#dfe6f0,stroke:#c97b1a
    style Milvus fill:#dfe6f0,stroke:#00a1ea
    style ES fill:#dfe6f0,stroke:#f9b110
    style Neo4j fill:#dfe6f0,stroke:#018bff
    style URI fill:#dfe6f0,stroke:#999
