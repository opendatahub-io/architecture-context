graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["KServe / Caikit Client"]
    end

    subgraph K8sService["KUBERNETES SERVICE (Internal)"]
        HeadlessSvc["inference-server<br/>(Headless ClusterIP: None)<br/>8033/TCP gRPC"]
    end

    subgraph Pod["CONTAINER (Pod Boundary)<br/>SecurityContext: non-root, drop ALL, RuntimeDefault<br/>User: tgis (UID 2000)"]
        direction TB

        subgraph RustLayer["Rust Layer"]
            GRPCServer["gRPC Server<br/>fmaas.GenerationService<br/>8033/TCP<br/>TLS 1.2+ (optional)<br/>rustls + ring (non-FIPS)"]
            HTTPServer["HTTP Server<br/>/health, /metrics<br/>3000/TCP<br/>Plaintext, No Auth"]
        end

        subgraph PythonLayer["Python Layer (Model Shards)"]
            Shard0["text-generation-server<br/>Shard 0<br/>Unix Socket: /tmp/text-generation-server-0<br/>gRPC insecure port"]
            ShardN["text-generation-server<br/>Shards 1..N<br/>Unix Sockets<br/>Tensor Parallel"]
        end
    end

    subgraph GPUs["GPU HARDWARE"]
        GPU["NVIDIA GPU(s)<br/>A100/A10<br/>CUDA 12.1<br/>NCCL 2.18.3"]
    end

    subgraph Storage["STORAGE"]
        PVC["PVC<br/>/shared_model_storage<br/>Read-only mount<br/>Model weights (safetensors)"]
    end

    subgraph ExternalServices["EGRESS (External Services)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>Disabled: HF_HUB_OFFLINE=1"]
        OTLP["OpenTelemetry Collector<br/>gRPC OTLP<br/>Configurable port<br/>Optional"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>HTTP scrape"]
        Kubelet["Kubelet<br/>Health probes"]
    end

    %% External flows
    Client -->|"gRPC/8033<br/>TLS 1.2+ (optional)<br/>mTLS (optional)"| HeadlessSvc
    HeadlessSvc -->|"8033/TCP<br/>DNS-based discovery"| GRPCServer

    %% Monitoring flows
    Kubelet -->|"HTTP GET /health<br/>3000/TCP<br/>No auth"| HTTPServer
    Prometheus -->|"HTTP GET /metrics<br/>3000/TCP<br/>No auth"| HTTPServer

    %% Internal flows
    GRPCServer -->|"Unix Domain Socket<br/>gRPC (insecure)<br/>Prefill, NextToken"| Shard0
    Shard0 <-->|"NCCL<br/>TCP/SHM/NVLink<br/>No encryption"| ShardN

    %% Hardware flows
    Shard0 -->|"PCIe/NVLink<br/>CUDA"| GPU
    ShardN -->|"PCIe/NVLink<br/>CUDA"| GPU

    %% Storage flows
    Shard0 -->|"Filesystem<br/>Read-only"| PVC

    %% Egress flows
    GRPCServer -.->|"gRPC OTLP<br/>Configurable"| OTLP
    Shard0 -.->|"HTTPS/443<br/>TLS 1.2+<br/>Token (optional)<br/>Disabled at runtime"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef gpu fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef monitoring fill:#e8e8e8,stroke:#666,stroke-width:1px

    class Client external
    class HeadlessSvc k8sservice
    class GRPCServer,HTTPServer ingress
    class Shard0,ShardN pod
    class GPU gpu
    class PVC storage
    class HFHub,OTLP egress
    class Prometheus,Kubelet monitoring
