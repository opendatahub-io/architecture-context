graph TD
    subgraph "Service Account"
        SA["planner-backend<br/>(Namespace: planner)"]
    end

    subgraph "ClusterRole Binding"
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)"]
    end

    subgraph "ClusterRole"
        CR["planner-gpu-reader"]
    end

    subgraph "API Resources"
        Nodes["core<br/>nodes"]
    end

    subgraph "Permissions"
        ListVerb["list"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|list| Nodes

    subgraph "Application-Level Auth"
        AdminEndpoints["DB Admin Endpoints<br/>/api/v1/db/upload-benchmarks<br/>/api/v1/db/reset<br/>/api/v1/db/verify-admin"]
        AdminAuth["X-Admin-Password Header<br/>(hmac.compare_digest)"]
        PublicEndpoints["All Other /api/v1/* Endpoints"]
        NoAuth["No Authentication<br/>(Unauthenticated)"]
    end

    AdminEndpoints -->|protected by| AdminAuth
    PublicEndpoints -->|uses| NoAuth

    subgraph "Secrets"
        PlannerSecrets["planner-secrets (Opaque)<br/>HF_TOKEN<br/>OPENAI_API_KEY<br/>DB_ADMIN_PASSWORD<br/>MODEL_CATALOG creds<br/>VERTEX_AI creds"]
        SAToken["ServiceAccount Token<br/>(auto-mounted)"]
    end

    SA -->|auto-mounted| SAToken
    PlannerSecrets -->|env vars| AdminAuth

    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623
    style CRB fill:#f5a623
    style Nodes fill:#7ed321
    style AdminEndpoints fill:#e74c3c,color:#fff
    style AdminAuth fill:#f39c12
    style PublicEndpoints fill:#95a5a6
    style NoAuth fill:#e74c3c,color:#fff
    style PlannerSecrets fill:#9b59b6,color:#fff
    style SAToken fill:#3498db,color:#fff
