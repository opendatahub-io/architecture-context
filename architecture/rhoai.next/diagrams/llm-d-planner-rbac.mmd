graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["planner-backend<br/>(planner namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)<br/>Scope: cluster-wide"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        Nodes["core (v1)<br/>nodes"]
    end

    subgraph ImpliedPermissions["Implied Permissions (kubectl-based)"]
        direction TB
        InferenceServices["serving.kserve.io<br/>InferenceService<br/>(CRUD via kubectl)"]
        Namespaces["core (v1)<br/>Namespaces<br/>(list/create)"]
        Pods["core (v1)<br/>Pods<br/>(list/get)"]
    end

    %% Explicit RBAC chain
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes

    %% Implied operations (not in explicit RBAC manifests)
    SA -.->|"requires additional<br/>RBAC (not in manifests)"| InferenceServices
    SA -.->|"requires additional<br/>RBAC (not in manifests)"| Namespaces
    SA -.->|"requires additional<br/>RBAC (not in manifests)"| Pods

    subgraph AuthEndpoints["API Authentication"]
        direction TB
        AdminEndpoints["/api/v1/db/upload-benchmarks<br/>/api/v1/db/reset<br/>/api/v1/db/verify-admin"]
        PublicEndpoints["All other /api/v1/* endpoints"]
    end

    AdminEndpoints -->|"HMAC password<br/>(x-admin-password header)<br/>Optional enforcement"| AdminAuth["hmac.compare_digest<br/>(Application Code)"]
    PublicEndpoints -->|"NO AUTH"| NoAuth["Unauthenticated<br/>⚠️ Security Gap"]

    subgraph Secrets["Secrets Referenced"]
        PlannerSecrets["planner-secrets (Opaque)<br/>• DATABASE_URL<br/>• HF_TOKEN<br/>• MODEL_CATALOG_TOKEN<br/>• GCP_CREDENTIALS_JSON<br/>• OPENAI_API_KEY<br/>• DB_ADMIN_PASSWORD"]
        ServiceCA["planner-service-ca (ConfigMap)<br/>• service-ca.crt<br/>Auto-injected by service-ca operator"]
    end

    SA -.->|"mounts"| PlannerSecrets
    SA -.->|"mounts"| ServiceCA

    %% Styling
    classDef sa fill:#4a90e2,stroke:#333,color:#fff
    classDef binding fill:#00b894,stroke:#333,color:#fff
    classDef role fill:#f5a623,stroke:#333,color:#000
    classDef resource fill:#7ed321,stroke:#333,color:#fff
    classDef implied fill:#dfe6e9,stroke:#636e72,stroke-dasharray: 5 5,color:#333
    classDef auth fill:#e17055,stroke:#333,color:#fff
    classDef noauth fill:#d63031,stroke:#333,color:#fff
    classDef secret fill:#fdcb6e,stroke:#333,color:#000

    class SA sa
    class CRB binding
    class CR role
    class Nodes resource
    class InferenceServices,Namespaces,Pods implied
    class AdminEndpoints,AdminAuth auth
    class PublicEndpoints,NoAuth noauth
    class PlannerSecrets,ServiceCA secret
