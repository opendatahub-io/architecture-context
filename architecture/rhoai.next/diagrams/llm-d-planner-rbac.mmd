graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["planner-backend<br/>Namespace: planner"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)<br/>Scope: cluster-wide"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        Nodes["core (v1)<br/>nodes"]
    end

    subgraph Verbs["Permitted Verbs"]
        ListVerb["list"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes

    subgraph AppAuth["Application-Level Auth (Non-RBAC)"]
        direction TB

        subgraph AdminEndpoints["Protected Endpoints"]
            UploadBench["/api/v1/db/upload-benchmarks<br/>POST"]
            ResetDB["/api/v1/db/reset<br/>POST"]
            VerifyAdmin["/api/v1/db/verify-admin<br/>POST"]
        end

        subgraph AuthMechanism["Auth Mechanism"]
            HMAC["HMAC Password Comparison<br/>Header: X-Admin-Password<br/>Env: DB_ADMIN_PASSWORD<br/>Optional (only when env set)"]
        end

        UploadBench -->|"requires"| HMAC
        ResetDB -->|"requires"| HMAC
        VerifyAdmin -->|"verifies"| HMAC
    end

    subgraph UnprotectedEndpoints["Unprotected Endpoints ⚠️"]
        AllOther["All other /api/v1/* endpoints<br/>(26 endpoints)<br/>Auth: None<br/>Relies on network isolation"]
    end

    subgraph ExternalAuth["External Service Authentication"]
        direction TB
        MCAuth["Backend → Model Catalog<br/>Bearer Token / SA Token<br/>(auto-read from /var/run/secrets)"]
        HFAuth["Backend → HuggingFace<br/>Bearer Token (HF_TOKEN)<br/>(optional, for gated models)"]
        K8sAuth["Backend → Kubernetes API<br/>kubeconfig / in-cluster SA"]
        VertexAuth["Backend → Vertex AI<br/>GCP OAuth2 credentials"]
        OpenAIAuth["Backend → OpenAI<br/>API Key (Bearer)"]
    end

    subgraph Secrets["Kubernetes Secrets"]
        PlannerSecrets["planner-secrets (Opaque)<br/>- DATABASE_URL<br/>- HF_TOKEN<br/>- MODEL_CATALOG_TOKEN<br/>- Vertex AI creds<br/>- OpenAI API key<br/>- DB_ADMIN_PASSWORD<br/>Manual provisioning / No auto-rotate"]
        ServiceCA["planner-service-ca (ConfigMap)<br/>- service-ca.crt<br/>OpenShift service-ca operator<br/>Auto-rotate: Yes"]
    end

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style Nodes fill:#7ed321,stroke:#333
    style ListVerb fill:#d5e8d4,stroke:#82b366
    style HMAC fill:#ffe6cc,stroke:#d79b00
    style UploadBench fill:#fff2cc,stroke:#d6b656
    style ResetDB fill:#fff2cc,stroke:#d6b656
    style VerifyAdmin fill:#fff2cc,stroke:#d6b656
    style AllOther fill:#f8cecc,stroke:#b85450
    style PlannerSecrets fill:#e1d5e7,stroke:#9673a6
    style ServiceCA fill:#e1d5e7,stroke:#9673a6
