graph TB
    subgraph LMEvalJob["LM Evaluation Harness (Kubernetes Job Pod)"]
        direction TB
        Adapter["LMEval Adapter<br/>(main.py)<br/>EvalHub Integration"]
        LMEvalLib["lm-eval Library<br/>(lm_eval/)<br/>Core Evaluation Engine"]
        OCIPub["OCI Artifact Publisher<br/>(scripts/oci.py)<br/>skopeo + olot"]
        S3Down["S3 Downloader<br/>(scripts/s3_downloader.py)<br/>boto3"]

        Adapter -->|"configures & runs"| LMEvalLib
        Adapter -->|"publishes results"| OCIPub
        S3Down -->|"pre-stages data"| LMEvalLib
    end

    %% Inputs
    ConfigMap["/meta/job.json<br/>(ConfigMap Mount)"]
    Secrets["Kubernetes Secrets<br/>(API Key, HF Token,<br/>OCI Auth, S3 Creds)"]

    ConfigMap -->|"reads job spec"| Adapter
    Secrets -->|"credentials"| Adapter
    Secrets -->|"AWS creds"| S3Down

    %% Operator
    Operator["TrustyAI LMEval Operator"] -->|"creates Job +<br/>mounts ConfigMap/Secrets"| LMEvalJob

    %% Outbound connections
    LMEvalLib -->|"POST /v1/completions<br/>HTTPS/443"| ModelEndpoint["Model Serving Endpoint<br/>(vLLM, TGI, etc.)"]
    Adapter -->|"status callbacks<br/>HTTPS/443"| EvalHub["EvalHub Service"]
    OCIPub -->|"skopeo push<br/>HTTPS/443"| OCIRegistry["OCI Registry<br/>(Quay)"]
    LMEvalLib -->|"download datasets<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    Adapter -->|"log metrics<br/>HTTPS/443"| MLflow["MLflow Tracking Server"]
    S3Down -->|"download assets<br/>HTTPS/443"| S3["S3-compatible Storage"]

    %% Styling
    style Adapter fill:#4a90e2,stroke:#333,color:#fff
    style LMEvalLib fill:#4a90e2,stroke:#333,color:#fff
    style OCIPub fill:#4a90e2,stroke:#333,color:#fff
    style S3Down fill:#4a90e2,stroke:#333,color:#fff
    style ConfigMap fill:#f5a623,stroke:#333
    style Secrets fill:#f5a623,stroke:#333
    style Operator fill:#7ed321,stroke:#333
    style ModelEndpoint fill:#e8e8e8,stroke:#333
    style EvalHub fill:#7ed321,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
