graph TB
    subgraph K8s["Kubernetes Job Pod"]
        subgraph LMESJob["lm-evaluation-harness"]
            Adapter["LMEvalAdapter<br/>(main.py)"]
            LMEval["lm_eval Package<br/>(v0.4.8)"]
            S3Downloader["s3_downloader.py"]
            OCI["oci.py"]
            CLI["lm-eval CLI"]

            Adapter -->|"wraps simple_evaluate()"| LMEval
            Adapter -->|"creates OCI artifacts"| OCI
            Adapter -->|"pre-fetches assets"| S3Downloader
        end
    end

    %% External orchestrator
    TrustyAI["TrustyAI Operator<br/>(LMEvalJob CRD)"] -->|"creates Job"| K8s

    %% Job spec input
    JobSpec["/meta/job.json<br/>(mounted ConfigMap)"] -->|"read at startup"| Adapter

    %% Egress connections
    Adapter -->|"POST status/results<br/>HTTPS/443"| EvalHub["EvalHub Service"]
    LMEval -->|"POST prompts<br/>OpenAI Completions API"| ModelEndpoint["Model Inference<br/>Endpoint"]
    LMEval -->|"GET datasets/tokenizers<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    S3Downloader -->|"GET objects<br/>HTTPS"| S3["S3-Compatible<br/>Storage"]
    OCI -->|"push via skopeo<br/>HTTPS/443"| Registry["OCI Registry"]
    Adapter -->|"log metrics<br/>HTTPS"| MLflow["MLflow Tracking<br/>Server"]

    %% Offline mode
    TestData["/test_data<br/>(volume mount)"] -.->|"offline mode<br/>auto-detected"| LMEval

    %% Styling
    style Adapter fill:#4a90e2,color:#fff
    style LMEval fill:#4a90e2,color:#fff
    style S3Downloader fill:#4a90e2,color:#fff
    style OCI fill:#4a90e2,color:#fff
    style CLI fill:#4a90e2,color:#fff
    style TrustyAI fill:#7ed321,color:#fff
    style EvalHub fill:#7ed321,color:#fff
    style ModelEndpoint fill:#f5a623,color:#fff
    style HFHub fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style Registry fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style JobSpec fill:#f5a623,color:#fff
    style TestData fill:#f5a623,color:#fff
