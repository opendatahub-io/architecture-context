graph LR
    TrainingOp["Training Operator<br/>(KFTO)"]

    %% External Dependencies (Required)
    subgraph RequiredDeps["Required Dependencies"]
        CtrlRuntime["controller-runtime<br/>v0.19.1"]
        K8sAPI_Dep["k8s.io/api<br/>v0.31.3"]
        K8sClientGo["k8s.io/client-go<br/>v0.31.3"]
        CertController["cert-controller<br/>v0.12.0"]
        PromClient["prometheus/client_golang<br/>v1.20.2"]
    end

    TrainingOp -->|"controller framework"| CtrlRuntime
    TrainingOp -->|"API types"| K8sAPI_Dep
    TrainingOp -->|"API client"| K8sClientGo
    TrainingOp -->|"webhook cert rotation"| CertController
    TrainingOp -->|"metrics instrumentation"| PromClient

    %% External Dependencies (Optional)
    subgraph OptionalDeps["Optional Dependencies"]
        Volcano["Volcano APIs<br/>v1.9.0"]
        SchedPlugins["scheduler-plugins<br/>v0.28.9"]
    end

    TrainingOp -.->|"gang scheduling<br/>(optional)"| Volcano
    TrainingOp -.->|"gang scheduling<br/>(optional)"| SchedPlugins

    %% Internal Platform Dependencies
    subgraph InternalPlatform["Internal Platform Dependencies"]
        RhodsOp["rhods-operator /<br/>opendatahub-operator"]
        OpenShiftAPI["OpenShift APIServer<br/>(config.openshift.io)"]
        OpenShiftMon["OpenShift Monitoring<br/>(PodMonitor)"]
    end

    RhodsOp -->|"deploys via<br/>kustomize manifests"| TrainingOp
    TrainingOp -->|"reads TLS profile<br/>HTTPS/443"| OpenShiftAPI
    OpenShiftMon -->|"scrapes metrics<br/>HTTPS/8080"| TrainingOp

    %% Kubernetes Infrastructure
    subgraph K8sInfra["Kubernetes Infrastructure"]
        K8sAPIServer["Kubernetes API Server"]
        K8sDNS["Kubernetes DNS<br/>53/UDP"]
        K8sScheduler["Kubernetes Scheduler"]
    end

    TrainingOp -->|"CRUD operations<br/>HTTPS/443"| K8sAPIServer
    TrainingOp -->|"headless svc DNS<br/>inter-replica discovery"| K8sDNS
    TrainingOp -->|"pod scheduling<br/>custom scheduler names"| K8sScheduler

    %% Integration Points (consumers)
    subgraph Consumers["Integration Points"]
        MultiKueue["MultiKueueController<br/>(optional delegation)"]
        KfJobsCtrl["KubeflowJobsController<br/>(default management)"]
    end

    MultiKueue -.->|"watches runPolicy<br/>.managedBy"| TrainingOp
    KfJobsCtrl -->|"watches runPolicy<br/>.managedBy"| TrainingOp

