    style TrainingOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style K8sAPI_Dep fill:#999,stroke:#333,color:#fff
    style K8sClientGo fill:#999,stroke:#333,color:#fff
    style CertController fill:#999,stroke:#333,color:#fff
    style PromClient fill:#999,stroke:#333,color:#fff
    style Volcano fill:#ccc,stroke:#333
    style SchedPlugins fill:#ccc,stroke:#333
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style OpenShiftAPI fill:#7ed321,stroke:#333,color:#fff
    style OpenShiftMon fill:#7ed321,stroke:#333,color:#fff
    style K8sAPIServer fill:#f5a623,stroke:#333
    style K8sDNS fill:#f5a623,stroke:#333
