graph TD
    subgraph AuthFlow["Authentication Flow (Application-Level)"]
        direction TB
        Request["Incoming Request<br/>/v1/* endpoints"]
        AuthMW["Auth Middleware<br/>(server/auth.py)"]
        Request -->|"Bearer Token<br/>in Authorization header"| AuthMW
    end

    subgraph AuthModes["Auth Provider Modes (mutually exclusive)"]
        direction LR
        OAuth2JWT["OAuth2TokenAuthProvider<br/>(JWT via JWKS)"]
        OAuth2Intro["OAuth2TokenAuthProvider<br/>(RFC 7662 Introspection)"]
        CustomAuth["CustomAuthProvider<br/>(External endpoint)"]
        NoAuth["Disabled<br/>(DEFAULT — no auth!)"]
    end

    AuthMW -->|"type: oauth2_token<br/>config.jwks_uri"| OAuth2JWT
    AuthMW -->|"type: oauth2_token<br/>config.introspection_url"| OAuth2Intro
    AuthMW -->|"type: custom<br/>config.endpoint"| CustomAuth
    AuthMW -->|"no auth config"| NoAuth

    subgraph JWTValidation["JWT Validation (OAuth2)"]
        JWKS["JWKS Endpoint<br/>(443/TCP HTTPS)"]
        Claims["JWT Claims Extraction<br/>sub → principal<br/>claims → attributes"]
        Audience["Audience Validation<br/>(configurable)"]
        Issuer["Issuer Validation<br/>(optional)"]
    end

    OAuth2JWT -->|"GET /.well-known/jwks.json<br/>(cached)"| JWKS
    JWKS -->|"public keys"| Claims
    Claims --> Audience
    Audience --> Issuer

    subgraph Principal["Authenticated Principal"]
        User["User Object<br/>principal: sub claim<br/>attributes: mapped claims"]
    end

    Issuer --> User
    OAuth2Intro --> User
    CustomAuth --> User
    NoAuth -->|"no principal"| SkipACL["Skip Access Control"]

    subgraph AccessControl["Cedar-like Access Control (access_control/access_control.py)"]
        direction TB
        PolicyEngine["Policy Engine"]
        PermitRule["Permit Rules<br/>• user is owner<br/>• user with attribute value"]
        ForbidRule["Forbid Rules<br/>• explicit deny"]
        DefaultPolicy["Default Policy<br/>Full access to<br/>owner-created resources"]
    end

    User -->|"principal + attributes"| PolicyEngine
    PolicyEngine --> PermitRule
    PolicyEngine --> ForbidRule
    PolicyEngine --> DefaultPolicy

    subgraph ResourceOwnership["Resource Ownership Tracking"]
        direction LR
        Models["Models<br/>(model_id → owner)"]
        Shields["Shields<br/>(shield_id → owner)"]
        VectorDBs["Vector DBs<br/>(vector_db_id → owner)"]
        Datasets["Datasets<br/>(dataset_id → owner)"]
        Agents["Agents<br/>(agent_id → owner)"]
    end

    PolicyEngine -->|"check ownership"| ResourceOwnership

    subgraph QuotaEnforcement["Rate Limiting (server/quota.py)"]
        AnonQuota["Anonymous<br/>100 requests/day"]
        AuthQuota["Authenticated<br/>1000 requests/day<br/>(configurable)"]
    end

    NoAuth --> AnonQuota
    User --> AuthQuota

    subgraph UnauthEndpoints["Unauthenticated Endpoints (always accessible)"]
        Health["GET /v1/health"]
        Version["GET /v1/version"]
        Inspect["GET /v1/inspect/routes"]
    end

    %% Styling
    style AuthMW fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style OAuth2JWT fill:#e3f2fd,stroke:#1565C0
    style OAuth2Intro fill:#e3f2fd,stroke:#1565C0
    style CustomAuth fill:#e3f2fd,stroke:#1565C0
    style NoAuth fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style PolicyEngine fill:#f3e5f5,stroke:#6a1b9a
    style PermitRule fill:#e8f5e9,stroke:#2e7d32
    style ForbidRule fill:#ffcdd2,stroke:#c62828
    style DefaultPolicy fill:#fff9c4,stroke:#f57f17
    style User fill:#4a90e2,stroke:#333,color:#fff
    style AnonQuota fill:#ffcdd2,stroke:#c62828
    style AuthQuota fill:#e8f5e9,stroke:#2e7d32
    style Health fill:#e0f2f1,stroke:#00695C
    style Version fill:#e0f2f1,stroke:#00695C
    style Inspect fill:#e0f2f1,stroke:#00695C
    style SkipACL fill:#ffcdd2,stroke:#c62828
