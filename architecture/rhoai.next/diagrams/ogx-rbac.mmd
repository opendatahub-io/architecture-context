graph TD
    subgraph AuthFlow["Authentication Flow"]
        direction TB
        Request["Incoming Request<br/>Authorization: Bearer &lt;token&gt;"]
        AuthMW["AuthenticationMiddleware<br/>(ASGI Layer)"]
        Request --> AuthMW
    end

    subgraph AuthProviders["Auth Provider (pluggable)"]
        direction LR
        OAuth2["OAuth2Provider<br/>• JWKS key rotation<br/>• JWT verification<br/>• Token introspection (RFC 7662)<br/>• Configurable refresh period"]
        CustomAuth["CustomProvider<br/>• Forwards token to external endpoint<br/>• Configurable URL and TLS"]
    end

    AuthMW -->|"delegates to"| OAuth2
    AuthMW -->|"OR delegates to"| CustomAuth

    subgraph Identity["Authenticated Identity"]
        Principal["Principal<br/>(extracted from JWT claims)"]
        Attributes["User Attributes<br/>• roles<br/>• teams<br/>• projects<br/>• namespaces"]
    end

    OAuth2 -->|"extracts"| Principal
    OAuth2 -->|"extracts"| Attributes
    CustomAuth -->|"extracts"| Principal
    CustomAuth -->|"extracts"| Attributes

    subgraph QuotaEnforcement["Quota Enforcement (QuotaMiddleware)"]
        QuotaCheck["Per-Client Rate Limiting"]
        AnonQuota["Anonymous: 100 req/day"]
        AuthQuota["Authenticated: 1000 req/day"]
        QuotaCheck --> AnonQuota
        QuotaCheck --> AuthQuota
    end

    Principal --> QuotaCheck

    subgraph ABACEngine["Access Control Engine (Cedar-inspired ABAC)"]
        direction TB
        PolicyEval["Policy Evaluation<br/>CommonRoutingTableImpl"]
        Conditions["Conditions Evaluated:<br/>• Principal identity<br/>• Resource type & ID<br/>• User attributes (roles, teams)<br/>• Project membership<br/>• Namespace scope"]
    end

    Attributes -->|"input to"| PolicyEval
    PolicyEval --> Conditions

    subgraph Resources["Protected Resources"]
        direction LR
        Models["Models<br/>/v1/models/*"]
        Shields["Shields<br/>/v1/shields/*"]
        VectorDBs["Vector DBs<br/>/v1/vector-io/*"]
        Agents["Agents<br/>/v1/agents/*"]
        Datasets["Datasets<br/>/v1/datasets/*"]
        ToolGroups["Tool Groups<br/>/v1/toolgroups/*"]
        Benchmarks["Benchmarks<br/>/v1/eval/benchmarks/*"]
    end

    Conditions -->|"ALLOW / DENY"| Models
    Conditions -->|"ALLOW / DENY"| Shields
    Conditions -->|"ALLOW / DENY"| VectorDBs
    Conditions -->|"ALLOW / DENY"| Agents
    Conditions -->|"ALLOW / DENY"| Datasets
    Conditions -->|"ALLOW / DENY"| ToolGroups
    Conditions -->|"ALLOW / DENY"| Benchmarks

    subgraph UnprotectedEndpoints["Unauthenticated Endpoints"]
        Health["/v1/health<br/>No auth required"]
        Version["/v1/version<br/>No auth required"]
        Routes["/v1/inspect/routes<br/>No auth required"]
    end

    subgraph Notes["Important Notes"]
        Note1["Auth is OPTIONAL<br/>Server runs without auth by default"]
        Note2["ABAC policies only enforced<br/>when auth is enabled"]
        Note3["No Kubernetes RBAC<br/>All authorization is application-level"]
    end

    %% Styling
    style Request fill:#e8e8e8,stroke:#333,stroke-width:2px
    style AuthMW fill:#f5a623,stroke:#333,stroke-width:2px
    style OAuth2 fill:#4a90e2,stroke:#333,color:#fff
    style CustomAuth fill:#4a90e2,stroke:#333,color:#fff
    style Principal fill:#7ed321,stroke:#333
    style Attributes fill:#7ed321,stroke:#333
    style PolicyEval fill:#f5a623,stroke:#333,stroke-width:2px
    style QuotaCheck fill:#ff9900,stroke:#333

    style Models fill:#dae8fc,stroke:#6c8ebf
    style Shields fill:#dae8fc,stroke:#6c8ebf
    style VectorDBs fill:#dae8fc,stroke:#6c8ebf
    style Agents fill:#dae8fc,stroke:#6c8ebf
    style Datasets fill:#dae8fc,stroke:#6c8ebf
    style ToolGroups fill:#dae8fc,stroke:#6c8ebf
    style Benchmarks fill:#dae8fc,stroke:#6c8ebf

    style Health fill:#d5e8d4,stroke:#82b366
    style Version fill:#d5e8d4,stroke:#82b366
    style Routes fill:#d5e8d4,stroke:#82b366

    style Note1 fill:#f8cecc,stroke:#b85450
    style Note2 fill:#f8cecc,stroke:#b85450
    style Note3 fill:#f8cecc,stroke:#b85450
