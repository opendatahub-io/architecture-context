graph TD
    subgraph AuthFlow["Authentication Flow"]
        direction TB
        BearerToken["Bearer Token<br/>(Authorization header)"]
        AuthMW["AuthenticationMiddleware<br/>(ASGI)"]
        BearerToken -->|"extracted by"| AuthMW
    end

    subgraph AuthProviders["Auth Provider Options (runtime-selectable)"]
        direction TB
        OAuth2JWT["OAuth2 JWT/JWKS<br/>(python-jose)"]
        OAuth2Introspect["OAuth2 Introspection<br/>(RFC 7662)"]
        CustomHTTP["Custom HTTP Auth<br/>(endpoint delegation)"]
        NoAuth["No Auth<br/>(unauthenticated mode)"]
    end

    AuthMW -->|"validates via"| OAuth2JWT
    AuthMW -->|"validates via"| OAuth2Introspect
    AuthMW -->|"validates via"| CustomHTTP
    AuthMW -->|"bypasses"| NoAuth

    subgraph PrincipalAttrs["Extracted Principal Attributes"]
        direction TB
        Roles["Roles"]
        Teams["Teams"]
        Projects["Projects"]
        Namespaces["Namespaces"]
    end

    OAuth2JWT -->|"extracts"| PrincipalAttrs
    OAuth2Introspect -->|"extracts"| PrincipalAttrs
    CustomHTTP -->|"extracts"| PrincipalAttrs

    subgraph ABACPolicy["ABAC Policy Engine"]
        direction TB
        PermitRules["Permit Rules<br/>(with conditions)"]
        ForbidRules["Forbid Rules<br/>(with conditions)"]
        DefaultPolicy["Default Policy<br/>(backwards compat)"]
    end

    PrincipalAttrs -->|"evaluated against"| ABACPolicy

    subgraph EnforcementPoints["Enforcement Points"]
        direction TB
        RoutingTableOps["Routing Table Operations<br/>(create, delete, read)<br/>routing_tables/common.py"]
        AgentPersistence["Agent Persistence<br/>(create, read sessions)<br/>persistence.py"]
        QuotaEnforce["Quota Enforcement<br/>(per-client rate limits)<br/>quota.py"]
    end

    ABACPolicy -->|"is_action_allowed"| RoutingTableOps
    ABACPolicy -->|"is_action_allowed"| AgentPersistence
    ABACPolicy -->|"rate check"| QuotaEnforce

    subgraph ProtectedResources["Protected Resources"]
        direction TB
        Models["Models<br/>(inference routing)"]
        Shields["Shields<br/>(safety routing)"]
        VectorDBs["Vector DBs<br/>(vector-io routing)"]
        Datasets["Datasets<br/>(dataset routing)"]
        AgentSessions["Agent Sessions<br/>(per-session owner)"]
        Benchmarks["Benchmarks<br/>(eval routing)"]
    end

    RoutingTableOps -->|"guards access to"| Models
    RoutingTableOps -->|"guards access to"| Shields
    RoutingTableOps -->|"guards access to"| VectorDBs
    RoutingTableOps -->|"guards access to"| Datasets
    RoutingTableOps -->|"guards access to"| Benchmarks
    AgentPersistence -->|"guards access to"| AgentSessions

    style AuthFlow fill:#4a90e2,color:#fff
    style AuthProviders fill:#ffe6cc,stroke:#d79b00
    style PrincipalAttrs fill:#d5e8d4,stroke:#82b366
    style ABACPolicy fill:#f5a623,color:#fff
    style EnforcementPoints fill:#dae8fc,stroke:#6c8ebf
    style ProtectedResources fill:#7ed321,color:#fff
    style NoAuth fill:#f44336,color:#fff
