graph TD
    subgraph UserSpace["User-Space Execution (No Kubernetes RBAC)"]
        direction TB

        subgraph Process["Training Hub Process"]
            TH["Training Hub Library<br/>(Python Package)"]
            CLI["thub CLI<br/>(Console Script)"]
        end

        subgraph SecretAccess["Environment Variable Secrets"]
            direction TB
            OPENAI["OPENAI_API_KEY<br/>(env var)"]
            WANDB["WANDB_API_KEY<br/>(env var)"]
            MLFLOW["MLFLOW_TRACKING_URI<br/>(env var)"]
            HF["HF_TOKEN<br/>(env var)"]
        end

        subgraph Auth["Authentication Mechanisms"]
            direction TB
            LLMAuth["LLM API Auth<br/>Method: Bearer Token<br/>Key: OPENAI_API_KEY<br/>Enforcement: litellm / OpenAI client<br/>Policy: Required; dummy key for local endpoints"]
            HFAuth["HuggingFace Auth<br/>Method: Bearer Token<br/>Key: HF_TOKEN<br/>Enforcement: huggingface_hub library<br/>Policy: Optional (public), Required (gated)"]
            WandBAuth["W&B Auth<br/>Method: API Key<br/>Key: WANDB_API_KEY<br/>Enforcement: wandb library<br/>Policy: Optional, auto-detected"]
            MLflowAuth["MLflow Auth<br/>Method: Token<br/>Key: MLFLOW_TRACKING_URI<br/>Enforcement: mlflow library<br/>Policy: Optional"]
        end
    end

    subgraph KubeflowContext["When Deployed in Kubeflow"]
        direction TB
        KFIsolation["Platform-Provided Isolation"]
        NSPod["Namespace-Scoped Pods"]
        KFRBAC["Kubeflow RBAC"]
        ResQuota["Resource Quotas"]
    end

    subgraph SecurityNotes["Security Considerations"]
        direction TB
        DottedPath["⚠ CLI dotted-path resolution<br/>Imports arbitrary Python modules<br/>Do not expose to untrusted input"]
        SupplyChain["⚠ litellm exclusion<br/>!=1.82.7, !=1.82.8<br/>TeamPCP supply chain attack (Mar 2026)"]
        NoLockFiles["⚠ No lock files<br/>Dependency pinning by downstream consumers"]
    end

    %% Connections
    CLI -->|"invokes"| TH
    OPENAI -->|"used by"| LLMAuth
    WANDB -->|"used by"| WandBAuth
    MLFLOW -->|"used by"| MLflowAuth
    HF -->|"used by"| HFAuth

    KFIsolation --> NSPod
    KFIsolation --> KFRBAC
    KFIsolation --> ResQuota

    %% Styling
    style TH fill:#4a90e2,stroke:#333,color:#fff
    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style OPENAI fill:#f5a623,stroke:#333
    style WANDB fill:#f5a623,stroke:#333
    style MLFLOW fill:#f5a623,stroke:#333
    style HF fill:#f5a623,stroke:#333
    style LLMAuth fill:#7ed321,stroke:#333
    style HFAuth fill:#7ed321,stroke:#333
    style WandBAuth fill:#7ed321,stroke:#333
    style MLflowAuth fill:#7ed321,stroke:#333
    style KFIsolation fill:#dae8fc,stroke:#6c8ebf
    style NSPod fill:#dae8fc,stroke:#6c8ebf
    style KFRBAC fill:#dae8fc,stroke:#6c8ebf
    style ResQuota fill:#dae8fc,stroke:#6c8ebf
    style DottedPath fill:#f8cecc,stroke:#b85450
    style SupplyChain fill:#f8cecc,stroke:#b85450
    style NoLockFiles fill:#f8cecc,stroke:#b85450
