graph TD
    subgraph Notice["training-hub — No Kubernetes RBAC"]
        direction TB
        Note["training-hub is a Python library,<br/>not a Kubernetes operator.<br/><br/>It does not define or require:<br/>• ClusterRoles<br/>• Roles<br/>• RoleBindings<br/>• ServiceAccounts<br/><br/>RBAC is determined by the hosting<br/>environment's ServiceAccount<br/>(e.g., RHOAI Workbench pod SA)."]
    end

    subgraph RuntimeContext["Runtime Security Context (Hosting Environment)"]
        direction TB

        subgraph HostPod["Hosting Pod (e.g., RHOAI Workbench)"]
            SA["Pod ServiceAccount<br/>(determined by workbench)"]
        end

        subgraph Credentials["Runtime Credentials (Environment Variables)"]
            WANDB["WANDB_API_KEY<br/>Weights & Biases logging"]
            MLFLOW["MLFLOW_TRACKING_URI<br/>MLflow experiment tracking"]
            HF["HF_TOKEN<br/>Hugging Face model downloads"]
            LLM["LLM API Keys<br/>GEPA evaluation (via litellm)"]
        end

        SA -->|"provides identity for"| HostPod
        HostPod -->|"env vars injected into"| Credentials
    end

    subgraph SupplyChain["Supply Chain Security"]
        direction TB
        PyPI["PyPI Publishing<br/>GitHub Actions<br/>id-token: write<br/>(trusted publishing)"]
        LiteLLM["litellm Exclusion<br/>!=1.82.7, !=1.82.8<br/>TeamPCP attack<br/>2026-03-24"]
        VersionFloors["Dependency Floors<br/>All deps specify<br/>minimum versions"]
    end

    %% Styling
    style Notice fill:#fff3cd,stroke:#d6b656,stroke-width:2px
    style Note fill:#fff3cd,stroke:none

    style RuntimeContext fill:#e8f0fe,stroke:#4a90e2,stroke-width:1px
    style HostPod fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style Credentials fill:#f8d7da,stroke:#dc3545,stroke-width:1px
    style SA fill:#4a90e2,color:#fff

    style SupplyChain fill:#e2d5f1,stroke:#6f42c1,stroke-width:1px
    style PyPI fill:#7ed321,stroke:#333
    style LiteLLM fill:#e74c3c,stroke:#333,color:#fff
    style VersionFloors fill:#7ed321,stroke:#333
