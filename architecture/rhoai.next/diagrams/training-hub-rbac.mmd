graph TD
    subgraph LibraryContext["Training Hub - Runtime Security Context"]
        direction TB

        subgraph DeploymentNote["Deployment Type: Python Library (not a K8s workload)"]
            Note["Training Hub defines no Kubernetes RBAC resources.<br/>No ClusterRoles, RoleBindings, or ServiceAccounts.<br/><br/>Security context is inherited from the consuming<br/>application/pipeline that imports the library."]
        end

        subgraph RuntimeCredentials["Runtime Credentials (Environment Variables)"]
            direction TB
            HFToken["HF_TOKEN<br/>(HuggingFace Hub)<br/>Optional"]
            WandBKey["WANDB_API_KEY<br/>(Weights & Biases)<br/>Optional"]
            MLflowToken["MLFLOW_TRACKING_TOKEN<br/>(MLflow Server)<br/>Optional"]
            LLMKey["LLM API Key<br/>(Provider-specific)<br/>Optional"]
        end

        subgraph EgressPermissions["Egress Permissions Required by Host"]
            direction TB
            EgressHF["Allow HTTPS/443<br/>→ huggingface.co<br/>(model downloads)"]
            EgressWandB["Allow HTTPS/443<br/>→ api.wandb.ai<br/>(metrics logging)"]
            EgressMLflow["Allow HTTP/HTTPS<br/>→ MLflow server<br/>(experiment tracking)"]
            EgressLLM["Allow HTTP/HTTPS<br/>→ LLM API endpoint<br/>(GEPA optimization)"]
            EgressvLLM["Allow HTTP<br/>→ vLLM endpoint<br/>(GRPO rollouts)"]
        end

        subgraph DistributedTrainingPerms["Distributed Training Network Permissions"]
            direction TB
            NCCL["Allow TCP<br/>NCCL ports (configurable)<br/>Between GPU nodes<br/>(torchrun rendezvous)"]
            RayPorts["Allow TCP<br/>Ray ports (configurable)<br/>Between Ray workers<br/>(verl backend only)"]
        end

        subgraph HostRequirements["Host Pod/Container Requirements"]
            direction TB
            GPUAccess["GPU Device Access<br/>nvidia.com/gpu resource"]
            SharedMemory["Shared Memory<br/>/dev/shm (enlarged)<br/>Required for NCCL"]
            FileSystem["Filesystem Write<br/>Checkpoint + log directories"]
        end
    end

    HFToken -->|"authenticates"| EgressHF
    WandBKey -->|"authenticates"| EgressWandB
    MLflowToken -->|"authenticates"| EgressMLflow
    LLMKey -->|"authenticates"| EgressLLM

    subgraph SupplyChainSecurity["Supply Chain Security"]
        LiteLLMExclusion["litellm v1.82.7-1.82.8<br/>EXCLUDED<br/>(supply chain attack)<br/>Enforced via pyproject.toml<br/>version constraints"]
    end

    style LibraryContext fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style DeploymentNote fill:#fff3e0,stroke:#f5a623,stroke-width:2px
    style RuntimeCredentials fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style EgressPermissions fill:#fce4ec,stroke:#e91e63,stroke-width:2px
    style DistributedTrainingPerms fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style HostRequirements fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
    style SupplyChainSecurity fill:#ffebee,stroke:#c62828,stroke-width:3px

    style Note fill:#fff3e0,stroke:#f5a623
    style HFToken fill:#4caf50,color:#fff
    style WandBKey fill:#4caf50,color:#fff
    style MLflowToken fill:#4caf50,color:#fff
    style LLMKey fill:#4caf50,color:#fff
    style LiteLLMExclusion fill:#e91e63,color:#fff
