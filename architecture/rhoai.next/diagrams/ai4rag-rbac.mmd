graph TD
    subgraph LibraryContext["ai4rag Library (No Kubernetes RBAC)"]
        direction TB
        Note["ai4rag is a Python library, not a Kubernetes operator.<br/>No ClusterRoles, Roles, or RoleBindings are defined.<br/>The library inherits the permissions of its caller."]
    end

    subgraph CallerContext["Caller's Security Context"]
        direction TB
        KFPRunner["KFP Pipeline Runner<br/>ServiceAccount"]
        UserProcess["User Process<br/>(local or container)"]
    end

    subgraph CredentialAccess["Credential-Based Access (Environment Variables)"]
        direction TB

        subgraph OGXAuth["OGX API Access"]
            OGXURL["OGX_CLIENT_BASE_URL<br/>(endpoint URL)"]
            APIKEY["API_KEY<br/>(Bearer token)"]
        end

        subgraph S3Auth["S3 Storage Access"]
            AWSKEY["AWS_ACCESS_KEY_ID"]
            AWSSECRET["AWS_SECRET_ACCESS_KEY"]
            S3EP["AWS_S3_ENDPOINT"]
        end
    end

    subgraph AccessedResources["Resources Accessed"]
        direction TB

        subgraph OGXAPIs["OGX Server APIs"]
            ChatAPI["POST /chat/completions"]
            EmbedAPI["POST /embeddings"]
            VectorInsert["POST /vector_io/insert"]
            VectorQuery["POST /vector_io/query"]
            ModelsAPI["GET /models"]
            ProvidersAPI["GET /providers"]
        end

        subgraph S3Ops["S3 Operations"]
            ListObjects["list_objects_v2<br/>(document discovery)"]
            GetObject["get_object<br/>(document download)"]
        end
    end

    %% Caller provides credentials
    KFPRunner -->|"provisions env vars"| CredentialAccess
    UserProcess -->|"provisions env vars"| CredentialAccess

    %% Credentials grant access
    OGXAuth -->|"API Key auth<br/>per-key ACL"| OGXAPIs
    S3Auth -->|"IAM auth<br/>bucket-level policy"| S3Ops

    %% Styling
    classDef note fill:#fff3cd,stroke:#856404,stroke-width:2px
    classDef caller fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef cred fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef resource fill:#d5e8d4,stroke:#82b366,stroke-width:1px

    class Note note
    class KFPRunner,UserProcess caller
    class OGXURL,APIKEY,AWSKEY,AWSSECRET,S3EP cred
    class ChatAPI,EmbedAPI,VectorInsert,VectorQuery,ModelsAPI,ProvidersAPI,ListObjects,GetObject resource
