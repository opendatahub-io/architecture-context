graph TD
    subgraph Note["ai4rag RBAC — Python Library"]
        direction TB
        Info["ai4rag is a Python library, not a Kubernetes operator.<br/>No ClusterRoles, Roles, or RoleBindings are defined.<br/>RBAC is the responsibility of the consuming workload."]
    end

    subgraph Credentials["Credential-Based Access (Non-Kubernetes)"]
        direction TB

        subgraph OGXAuth["OGX Server Authentication"]
            OGXKey["OGX API Key<br/>(Bearer Token)"]
            OGXAccess["OGX Server Access<br/>• chat.completions (POST)<br/>• embeddings (POST)<br/>• vector_io CRUD (POST/GET/DELETE)<br/>• vector_stores (POST)<br/>• models (GET)"]
            OGXKey -->|"authenticates"| OGXAccess
        end

        subgraph S3Auth["S3 Storage Authentication"]
            AWSAccessKey["AWS_ACCESS_KEY_ID"]
            AWSSecretKey["AWS_SECRET_ACCESS_KEY"]
            S3Access["S3 Bucket Access<br/>• GET objects<br/>• PUT objects<br/>• DELETE objects"]
            AWSAccessKey -->|"authenticates"| S3Access
            AWSSecretKey -->|"authenticates"| S3Access
        end
    end

    subgraph ConsumerRBAC["Consumer Workload Responsibility"]
        direction TB
        ConsumerSA["Consumer Service Account<br/>(e.g., KFP pipeline runner)"]
        ConsumerRole["Consumer Role<br/>(defined by deployer)"]
        ConsumerSA -->|"must have"| ConsumerRole
        ConsumerRole -->|"manages"| SecretAccess["Access to Secrets<br/>containing OGX Key +<br/>AWS credentials"]
    end

    style Note fill:#f0f0f0,stroke:#999,stroke-width:1px
    style Info fill:#fff,stroke:#999
    style OGXAuth fill:#fff2cc,stroke:#d6b656
    style S3Auth fill:#fff2cc,stroke:#d6b656
    style ConsumerRBAC fill:#e8f0fe,stroke:#4a90e2
    style OGXKey fill:#f8cecc,stroke:#b85450
    style AWSAccessKey fill:#f8cecc,stroke:#b85450
    style AWSSecretKey fill:#f8cecc,stroke:#b85450
    style OGXAccess fill:#d5e8d4,stroke:#82b366
    style S3Access fill:#d5e8d4,stroke:#82b366
    style ConsumerSA fill:#dae8fc,stroke:#6c8ebf
    style ConsumerRole fill:#dae8fc,stroke:#6c8ebf
    style SecretAccess fill:#f8cecc,stroke:#b85450
