graph TD
    subgraph "Authentication Flow (Starter Kit)"
        Client["External Client"]
        BearerToken["Bearer Token<br/>(K8s ServiceAccount Token)"]
        Client -->|"provides"| BearerToken
    end

    subgraph "Auth Middleware (auth_wrapper.py)"
        Middleware["_BearerAuthMiddleware<br/>(ASGI Middleware)"]
        Extract["Extract Bearer Token<br/>from Authorization Header"]
        Validate["K8s TokenReview API Call<br/>HTTPS/443 · K8s CA Verified"]
        CheckSA["Optional: Verify SA Username<br/>against ALLOWED_SA_USERNAME"]
        Middleware --> Extract
        Extract --> Validate
        Validate --> CheckSA
    end

    subgraph "Kubernetes API"
        TokenReview["TokenReview API<br/>/apis/authentication.k8s.io/v1/tokenreviews"]
    end

    subgraph "Service Endpoints"
        Responses["/v1/responses (POST)<br/>Protected — Requires Valid Token"]
        Health["/health (GET)<br/>Unprotected"]
    end

    subgraph "Required Secrets"
        ReviewerToken["K8S_REVIEWER_TOKEN<br/>(SA token for TokenReview calls)"]
        K8sCA["K8S_CA_PATH<br/>(default: /var/run/secrets/.../ca.crt)"]
        AllowedSA["ALLOWED_SA_USERNAME<br/>(optional restriction)"]
    end

    BearerToken -->|"forwarded to"| Middleware
    Validate -->|"HTTPS POST"| TokenReview
    TokenReview -->|"authenticated: true/false"| Validate
    CheckSA -->|"allow"| Responses
    CheckSA -->|"deny → 401/403"| Client

    ReviewerToken -->|"used by"| Validate
    K8sCA -->|"TLS verification"| Validate
    AllowedSA -->|"compared against"| CheckSA

    style Middleware fill:#4a90e2,color:#fff
    style TokenReview fill:#f5a623,color:#000
    style Responses fill:#7ed321,color:#000
    style Health fill:#d5e8d4,color:#000
    style ReviewerToken fill:#f8cecc,color:#000
    style K8sCA fill:#f8cecc,color:#000
    style AllowedSA fill:#f8cecc,color:#000

    linkStyle 7 stroke:#e74c3c,stroke-width:2px
