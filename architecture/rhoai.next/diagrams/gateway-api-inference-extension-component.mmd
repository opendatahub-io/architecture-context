graph TB
    subgraph External["External Clients"]
        Client[Client Application]
    end

    subgraph Gateway["Gateway Layer"]
        EnvoyGW["Envoy-based Gateway<br/>(Envoy Gateway / Istio / GKE Gateway / kgateway)<br/>443/TCP HTTPS"]
    end

    subgraph IGW["Gateway API Inference Extension"]
        direction TB

        subgraph BBRComponent["Body Based Router (Optional)"]
            BBR["BBR ext-proc Server<br/>9004/TCP gRPC TLS<br/>Go 1.25"]
            BBRHealth["BBR Health<br/>9005/TCP gRPC"]
            BBRPlugins["BBR Plugin Framework<br/>LoRA Adapter Mapping<br/>ConfigMap Reconciler"]
            BBR --> BBRPlugins
        end

        subgraph EPPComponent["Endpoint Picker (Core)"]
            EPP["EPP ext-proc Server<br/>9002/TCP gRPC TLS<br/>Go 1.25"]
            EPPHealth["EPP Health<br/>9003/TCP gRPC"]
            EPPMetrics["EPP Metrics<br/>9090/TCP HTTP"]

            subgraph Scheduling["Scheduling Framework"]
                Filters["Filters"]
                Scorers["Scorers"]
                Pickers["Pickers"]
                ProfileHandler["Profile Handler"]
                Filters --> Scorers --> Pickers
            end

            subgraph RequestControl["Request Control"]
                Admission["Admission Plugin"]
                PrepareData["PrepareData Plugin"]
                PreRequest["PreRequest Plugin"]
                ResponseHeader["ResponseHeader Plugin"]
                ResponseBody["ResponseBody Plugin"]
            end

            subgraph FlowControl["Flow Control (Feature-Gated)"]
                FairnessPolicy["Fairness Policy"]
                OrderingPolicy["Ordering Policy<br/>(FCFS / EDF / SLO-Deadline)"]
                UsageLimit["Usage Limit Policy"]
                EvictionFilter["Eviction Filter"]
                ShardedRegistry["Sharded Registry<br/>(Lock-free)"]
            end

            subgraph DataLayer["Data Layer"]
                DataSource["DataSource<br/>(HTTP / K8s Notifications)"]
                Extractors["Extractors<br/>(Concurrency / Latency / PrefixCache)"]
                AttributeMap["Attribute DAG<br/>(Topological Ordering)"]
                DataSource --> Extractors --> AttributeMap
            end

            EPP --> Scheduling
            EPP --> RequestControl
            EPP --> FlowControl
            EPP --> DataLayer
        end

        subgraph LatencyPredictor["Latency Predictor (Optional Sidecars)"]
            AsyncClient["Async Client<br/>Go Sidecar"]
            TrainingServer["Training Server<br/>8000/TCP HTTP<br/>Python FastAPI"]
            PredictionServer["Prediction Server<br/>8001/TCP HTTP<br/>Python FastAPI"]
            AsyncClient -->|training data| TrainingServer
            AsyncClient -->|predictions| PredictionServer
            PredictionServer -->|fetch models| TrainingServer
        end

        EPP -.->|latency predictions| AsyncClient
    end

    subgraph CRDs["Custom Resource Definitions"]
        InferencePool["InferencePool<br/>v1 (GA)"]
        InferenceObjective["InferenceObjective<br/>v1alpha2"]
        InferenceModelRewrite["InferenceModelRewrite<br/>v1alpha2"]
        InferencePoolImport["InferencePoolImport<br/>v1alpha1"]
        EndpointPickerConfig["EndpointPickerConfig<br/>config/v1alpha1"]
    end

    subgraph ModelServers["Model Server Pods"]
        vLLM["vLLM<br/>8000/TCP"]
        SGLang["SGLang<br/>8000/TCP"]
        Triton["Triton TensorRT-LLM<br/>8000/TCP"]
        TrtllmServe["trtllm-serve<br/>8000/TCP"]
    end

    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]

    %% Client flows
    Client -->|HTTPS/443| EnvoyGW
    EnvoyGW -->|gRPC ext-proc<br/>9004/TCP| BBR
    BBR -->|model name header| EnvoyGW
    EnvoyGW -->|gRPC ext-proc<br/>9002/TCP| EPP
    EPP -->|endpoint selection| EnvoyGW
    EnvoyGW -->|routed request<br/>8000/TCP| vLLM

    %% EPP data flows
    EPP -->|scrape /metrics| vLLM
    EPP -->|scrape /metrics| SGLang
    EPP -->|scrape /metrics| Triton
    EPP -->|scrape /metrics| TrtllmServe

    %% CRD watches
    InferencePool -->|watched by| EPP
    InferenceObjective -->|watched by| EPP
    InferenceModelRewrite -->|watched by| EPP
    EndpointPickerConfig -.->|configures| EPP

    %% K8s API
    EPP -->|watch Pods, CRDs| K8sAPI
    BBR -->|watch ConfigMaps| K8sAPI

    %% Styles
    style EPP fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style BBR fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style EnvoyGW fill:#7ed321,stroke:#333,stroke-width:2px
    style Client fill:#f9f9f9,stroke:#999
    style InferencePool fill:#f5a623,stroke:#333
    style InferenceObjective fill:#f5a623,stroke:#333
    style InferenceModelRewrite fill:#f5a623,stroke:#333
    style InferencePoolImport fill:#f5a623,stroke:#333
    style EndpointPickerConfig fill:#f5a623,stroke:#333
    style vLLM fill:#e8e8e8,stroke:#333
    style SGLang fill:#e8e8e8,stroke:#333
    style Triton fill:#e8e8e8,stroke:#333
    style TrtllmServe fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style TrainingServer fill:#9b59b6,stroke:#333,color:#fff
    style PredictionServer fill:#9b59b6,stroke:#333,color:#fff
    style AsyncClient fill:#9b59b6,stroke:#333,color:#fff
