graph TB
    subgraph IGW["Gateway API Inference Extension"]
        direction TB

        subgraph EPPServer["EPP (Endpoint Picker)"]
            ExtProc["ExtProc gRPC Server<br/>9002/TCP TLS"]
            HealthEPP["Health gRPC Server<br/>9003/TCP"]
            MetricsEPP["Metrics HTTP Server<br/>9090/TCP"]
            Scheduler["Scheduling Pipeline"]
            DataLayer["Data Layer<br/>(Metrics Scraper)"]
            FlowControl["Flow Control<br/>(Feature-Gated)"]
            RequestParser["Request Parser<br/>(OpenAI / vLLM / Passthrough)"]

            ExtProc --> RequestParser
            RequestParser --> Scheduler
            Scheduler --> FlowControl
            DataLayer -->|endpoint metrics| Scheduler
        end

        subgraph Controllers["Controllers"]
            PoolCtrl["InferencePool Controller"]
            ObjectiveCtrl["InferenceObjective Controller"]
            RewriteCtrl["InferenceModelRewrite Controller"]
            PodCtrl["Pod Controller"]
            CMCtrl["ConfigMap Controller"]
        end

        subgraph BBRServer["BBR (Body Based Router)"]
            BBRProc["ExtProc gRPC Server<br/>9004/TCP TLS"]
            HealthBBR["Health gRPC Server<br/>9005/TCP"]
            BodyParser["Body Parser<br/>(Model Name Extraction)"]
            BaseModelPlugin["Base-Model-to-Header Plugin"]

            BBRProc --> BodyParser
            BodyParser --> BaseModelPlugin
        end

        subgraph LatencyPredictor["Latency Predictor (Optional Sidecar)"]
            TrainingServer["Training Server<br/>8000/TCP Python"]
            PredictionServer["Prediction Server<br/>8001/TCP Python"]
            TrainingServer -->|trained model| PredictionServer
        end

        PredictionServer -.->|latency estimates| Scheduler
        PoolCtrl -->|endpoint config| DataLayer
        PodCtrl -->|pod endpoints| DataLayer
        ObjectiveCtrl -->|SLO priorities| FlowControl
        RewriteCtrl -->|model aliases| RequestParser
        CMCtrl -->|base model map| BaseModelPlugin
    end

    %% External Interactions
    Client["External Client"] -->|HTTPS/443| Gateway["Envoy Gateway"]
    Gateway -->|ext-proc gRPC| BBRProc
    Gateway -->|ext-proc gRPC| ExtProc
    Gateway -->|forwards request| ModelServer["Model Server Pods<br/>(vLLM, SGLang)"]

    DataLayer -->|HTTP scrape| ModelServer

    %% CRDs
    InferencePoolCR["InferencePool CR<br/>(v1)"] -->|watched by| PoolCtrl
    InferenceObjectiveCR["InferenceObjective CR<br/>(v1alpha2)"] -->|watched by| ObjectiveCtrl
    InferenceModelRewriteCR["InferenceModelRewrite CR<br/>(v1alpha2)"] -->|watched by| RewriteCtrl

    K8sAPI["Kubernetes API<br/>6443/TCP"] -->|watch events| Controllers

