graph LR
    ASK["Agentic Starter Kits<br/>(Template Collection)"]

    %% External Dependencies (Runtime)
    ASK -->|"LLM inference<br/>HTTP/HTTPS"| OGX["OGX / vLLM / Ollama"]
    ASK -->|"token auth<br/>HTTPS/443"| K8sAPI["Kubernetes API"]
    ASK -->|"ingress<br/>Route (edge TLS)"| OSRouter["OpenShift Router"]

    %% Optional External Dependencies
    ASK -.->|"tracing<br/>HTTP/HTTPS"| MLflow["MLflow"]
    ASK -.->|"vector retrieval<br/>HTTP"| Milvus["Milvus"]
    ASK -.->|"memory<br/>TCP/5432"| PostgreSQL["PostgreSQL"]
    ASK -.->|"notifications<br/>HTTPS/443"| Slack["Slack API"]
    ASK -.->|"safety filtering<br/>HTTP/HTTPS"| NeMo["NeMo Guardrails"]

    %% Framework Dependencies
    ASK -->|"agent framework"| LangGraph["LangGraph / LangChain"]
    ASK -->|"agent framework"| CrewAI["CrewAI"]
    ASK -->|"agent framework"| LlamaIndex["LlamaIndex"]
    ASK -->|"agent framework"| AutoGen["AutoGen"]
    ASK -->|"agent framework"| GoogleADK["Google ADK 2.0"]
    ASK -->|"agent framework"| OpenAIClient["OpenAI Python Client"]

    %% Build Dependencies
    ASK -->|"base image"| UBI9["UBI9 Python 3.12"]
    ASK -->|"package mgmt"| UV["uv (pkg manager)"]
    ASK -->|"web framework"| FastAPI["FastAPI / uvicorn"]
    ASK -->|"validation"| Pydantic["Pydantic >=2.0"]

    %% Styling
    style ASK fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external services
    style OGX fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style OSRouter fill:#f5a623,stroke:#333

    %% Optional external services
    style MLflow fill:#e1d5e7,stroke:#9673a6
    style Milvus fill:#e1d5e7,stroke:#9673a6
    style PostgreSQL fill:#e1d5e7,stroke:#9673a6
    style Slack fill:#e1d5e7,stroke:#9673a6
    style NeMo fill:#e1d5e7,stroke:#9673a6

    %% Framework dependencies
    style LangGraph fill:#999,stroke:#333,color:#fff
    style CrewAI fill:#999,stroke:#333,color:#fff
    style LlamaIndex fill:#999,stroke:#333,color:#fff
    style AutoGen fill:#999,stroke:#333,color:#fff
    style GoogleADK fill:#999,stroke:#333,color:#fff
    style OpenAIClient fill:#999,stroke:#333,color:#fff

    %% Build dependencies
    style UBI9 fill:#7ed321,stroke:#333,color:#fff
    style UV fill:#7ed321,stroke:#333,color:#fff
    style FastAPI fill:#7ed321,stroke:#333,color:#fff
    style Pydantic fill:#7ed321,stroke:#333,color:#fff
