graph TD
    subgraph "Service Accounts / Subjects"
        SA_Auth["Group: system:authenticated"]
        SA_Deploy["ServiceAccount<br/>(patched at deploy)"]
    end

    subgraph "Role Bindings"
        RB_Exec["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}"]
        RB_SSRF["ssrf-allowlist-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "Roles"
        Role_Exec["${PROJECT_NAME}-exec-role"]
        Role_SSRF["ssrf-allowlist-role"]
    end

    subgraph "API Resources - Exec (Debugging)"
        Exec["Core API<br/>pods/exec"]
    end

    subgraph "API Resources - SSRF Allowlist"
        PodsRes["Core API<br/>pods"]
        InferencePoolRes["inference.networking.x-k8s.io<br/>inferencepools"]
    end

    %% Exec RBAC chain
    SA_Auth -->|bound via| RB_Exec
    RB_Exec -->|grants| Role_Exec
    Role_Exec -->|create| Exec

    %% SSRF Allowlist RBAC chain
    SA_Deploy -->|bound via| RB_SSRF
    RB_SSRF -->|grants| Role_SSRF
    Role_SSRF -->|"get, watch, list"| PodsRes
    Role_SSRF -->|"get, watch, list"| InferencePoolRes

    style SA_Auth fill:#4a90e2,color:#fff
    style SA_Deploy fill:#4a90e2,color:#fff
    style RB_Exec fill:#b8d4e3,color:#333
    style RB_SSRF fill:#b8d4e3,color:#333
    style Role_Exec fill:#f5a623,color:#fff
    style Role_SSRF fill:#f5a623,color:#fff
    style Exec fill:#7ed321,color:#fff
    style PodsRes fill:#7ed321,color:#fff
    style InferencePoolRes fill:#7ed321,color:#fff
