graph TD
    subgraph ServiceAccounts["Service Accounts / Subjects"]
        SA["ServiceAccount<br/>operator-controller-manager"]
        AuthGroup["Group<br/>system:authenticated"]
        PlaceholderSA["ServiceAccount<br/>placeholder"]
    end

    subgraph RoleBindings["Role Bindings"]
        ExecRB["exec-rolebinding<br/>Namespace: hc4ai-operator"]
        SSRFRB["ssrf-allowlist-rolebinding<br/>Namespace: (configured)"]
    end

    subgraph Roles["Roles (Namespace-Scoped)"]
        ExecRole["exec-role"]
        SSRFRole["ssrf-allowlist-role"]
    end

    subgraph APIResources["API Resources"]
        PodsExec["Core API<br/>pods/exec"]
        Pods["Core API<br/>pods"]
        InferencePools["inference.networking.x-k8s.io<br/>inferencepools"]
    end

    %% Bindings
    AuthGroup -->|"bound via"| ExecRB
    ExecRB -->|"grants"| ExecRole

    PlaceholderSA -->|"bound via"| SSRFRB
    SSRFRB -->|"grants"| SSRFRole

    %% Permissions
    ExecRole -->|"create"| PodsExec

    SSRFRole -->|"get, watch, list"| Pods
    SSRFRole -->|"get, watch, list"| InferencePools

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style AuthGroup fill:#4a90e2,color:#fff
    style PlaceholderSA fill:#4a90e2,color:#fff
    style ExecRB fill:#9b59b6,color:#fff
    style SSRFRB fill:#9b59b6,color:#fff
    style ExecRole fill:#f5a623,color:#fff
    style SSRFRole fill:#f5a623,color:#fff
    style PodsExec fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style InferencePools fill:#7ed321,color:#fff
