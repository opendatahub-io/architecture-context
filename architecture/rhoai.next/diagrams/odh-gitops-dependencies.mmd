graph LR
    ODHGitops["odh-gitops<br/>(GitOps Configuration Layer)"]

    %% ===== External Dependencies =====
    ODHGitops -->|"target platform<br/>(OLM path)"| OpenShift["OpenShift 4.19.9+"]
    ODHGitops -->|"target platform<br/>(xKS path)"| Kubernetes["Kubernetes 1.28+"]
    ODHGitops -->|"chart lifecycle"| Helm["Helm 3.x"]
    ODHGitops -.->|"optional GitOps"| ArgoCD["ArgoCD / Flux"]
    ODHGitops -.->|"optional manifests"| Kustomize["Kustomize v5+"]

    %% ===== Internal Platform Dependencies =====
    ODHGitops -->|"deploys operator"| RHODSOp["rhods-operator /<br/>opendatahub-operator"]
    ODHGitops -->|"TLS certs for<br/>gateways, webhooks"| CertManager["cert-manager"]
    ODHGitops -->|"service mesh,<br/>Gateway data plane"| Sail["Sail Operator<br/>(Istio)"]
    ODHGitops -->|"Gateway, HTTPRoute,<br/>GatewayClass CRDs"| GatewayAPI["Gateway API CRDs"]
    ODHGitops -->|"distributed<br/>inference"| LWS["LeaderWorkerSet<br/>Operator"]
    ODHGitops -->|"job management<br/>for training"| JobSet["JobSet Operator"]
    ODHGitops -->|"workload queuing"| Kueue["Kueue Operator"]
    ODHGitops -->|"AuthPolicy,<br/>RateLimitPolicy"| RHCL["RHCL / Kuadrant"]
    ODHGitops -->|"cluster monitoring"| COO["Cluster Observability<br/>Operator"]
    ODHGitops -->|"distributed tracing"| OTEL["OpenTelemetry<br/>Operator"]
    ODHGitops -->|"tracing backend"| Tempo["Tempo Operator"]
    ODHGitops -->|"event-driven<br/>autoscaling"| KEDA["Custom Metrics<br/>Autoscaler (KEDA)"]
    ODHGitops -.->|"optional GPU<br/>node detection"| NFD["NFD"]
    ODHGitops -.->|"optional GPU<br/>enablement"| NVIDIA["NVIDIA GPU<br/>Operator"]
    ODHGitops -.->|"optional TrustyAI<br/>database"| MariaDB["MariaDB Operator"]

    %% ===== Integration / Downstream =====
    SyncWorkflow["Helm Sync<br/>(GitHub Actions)"] -->|"chart sync on<br/>release branches"| BuildConfig["RHOAI-Build-Config"]
    ODHGitops -->|"triggers"| SyncWorkflow

    %% ===== CRD Integrations =====
    ODHGitops -->|"creates DSC CR"| DSC["DataScienceCluster<br/>CRD"]
    ODHGitops -->|"creates DSCI CR"| DSCI["DSCInitialization<br/>CRD"]
    ODHGitops -->|"creates Platform CR<br/>(xKS)"| PlatformCRD["Platform CRD<br/>(config.opendatahub.io)"]
    ODHGitops -->|"creates KE CR<br/>(AWS/Azure/CoreWeave)"| KECRD["KubernetesEngine CRD<br/>(infrastructure.opendatahub.io)"]
    ODHGitops -->|"OLM Subscriptions<br/>(OpenShift)"| OLM["OLM<br/>(operators.coreos.com)"]

