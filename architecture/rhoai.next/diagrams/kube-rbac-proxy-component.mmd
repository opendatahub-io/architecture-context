graph TB
    subgraph "kube-rbac-proxy Sidecar"
        direction TB
        TLSListener["TLS Listener<br/>8443/TCP<br/>TLS 1.2+"]
        PathFilter["Path Filter<br/>(--allow-paths / --ignore-paths)"]
        AuthN["Authentication Layer"]
        AuthZ["Authorization Layer"]
        AuthHeaders["Auth Header Injection<br/>(x-remote-user, x-remote-groups)"]
        CertReloader["CertReloader<br/>(TLS hot-reload, 1m poll)"]
        SanitizingFilter["SanitizingFilter<br/>(Bearer token masking in logs)"]
        HealthEndpoint["/healthz Endpoint<br/>(proxy-endpoints-port)"]

        subgraph "Authentication Backends"
            TokenReviewAuth["TokenReview Authenticator<br/>(Bearer Token)"]
            X509Auth["X.509 Authenticator<br/>(Client TLS Certificate)"]
            OIDCAuth["OIDC Authenticator<br/>(JWT via --oidc-issuer)"]
        end

        subgraph "Authorization Backends"
            SARAuthorizer["SAR Authorizer<br/>(SubjectAccessReview)"]
            HardcodedMetrics["Hardcoded Metrics Authorizer<br/>(Prometheus SA → /metrics)"]
            StaticAuthorizer["Static Authorizer<br/>(configurable allow-list)"]
        end

        subgraph "Config Formats"
            Format1["Format1<br/>(top-level resourceAttributes)"]
            Format2["Format2<br/>(path-scoped endpoints)"]
        end

        TLSListener --> PathFilter
        PathFilter -->|"matched --ignore-paths"| UpstreamProxy
        PathFilter -->|"not ignored"| AuthN
        AuthN --> TokenReviewAuth
        AuthN --> X509Auth
        AuthN --> OIDCAuth
        AuthN --> AuthZ
        AuthZ --> SARAuthorizer
        AuthZ --> HardcodedMetrics
        AuthZ --> StaticAuthorizer
        SARAuthorizer --> Format1
        SARAuthorizer --> Format2
        AuthZ --> AuthHeaders
        AuthHeaders --> UpstreamProxy["Upstream Reverse Proxy"]
    end

    Client["Client<br/>(via Gateway/HTTPRoute)"] -->|"HTTPS/8443<br/>Bearer / mTLS / OIDC"| TLSListener
    Prometheus["Prometheus<br/>(openshift-monitoring)"] -->|"HTTPS/8443<br/>GET /metrics"| TLSListener

    UpstreamProxy -->|"HTTP/8080<br/>localhost"| AppContainer["Application Container<br/>(upstream service)"]

    TokenReviewAuth -->|"HTTPS/443"| K8sAPI["Kubernetes API Server"]
    SARAuthorizer -->|"HTTPS/443"| K8sAPI
    OIDCAuth -->|"HTTPS/443"| OIDCProvider["OIDC Identity Provider"]
    CertReloader -.->|"polls cert files"| TLSListener

    %% Styling
    style TLSListener fill:#4a90e2,stroke:#333,color:#fff
    style AuthN fill:#4a90e2,stroke:#333,color:#fff
    style AuthZ fill:#4a90e2,stroke:#333,color:#fff
    style UpstreamProxy fill:#4a90e2,stroke:#333,color:#fff
    style CertReloader fill:#4a90e2,stroke:#333,color:#fff
    style SanitizingFilter fill:#4a90e2,stroke:#333,color:#fff
    style PathFilter fill:#4a90e2,stroke:#333,color:#fff
    style AuthHeaders fill:#4a90e2,stroke:#333,color:#fff
    style HealthEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style TokenReviewAuth fill:#6baed6,stroke:#333
    style X509Auth fill:#6baed6,stroke:#333
    style OIDCAuth fill:#6baed6,stroke:#333
    style SARAuthorizer fill:#f5a623,stroke:#333
    style HardcodedMetrics fill:#f5a623,stroke:#333
    style StaticAuthorizer fill:#f5a623,stroke:#333
    style Format1 fill:#d4edda,stroke:#333
    style Format2 fill:#d4edda,stroke:#333
    style Client fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
