graph TB
    subgraph External["External Callers"]
        Client[Client / Gateway]
        Prometheus["Prometheus<br/>(openshift-monitoring)"]
    end

    subgraph Pod["Application Pod"]
        subgraph KRP["kube-rbac-proxy Sidecar"]
            TLSListener["TLS Listener<br/>8443/TCP HTTPS<br/>TLS 1.2+"]
            CertReloader["CertReloader<br/>(hot-reload certs)"]
            AuthNFilter["AuthN Filter"]
            PathFilter["Path Filter<br/>(--ignore-paths)"]
            DelegatingAuthN["Delegating AuthN<br/>(TokenReview)"]
            OIDCAuthN["OIDC AuthN<br/>(JWT verification)"]
            X509AuthN["X.509 Client Cert<br/>AuthN"]
            AuthZChain["AuthZ Chain<br/>(union.New)"]
            HardcodedAuthZ["Hardcoded Metrics<br/>Authorizer<br/>(prometheus-k8s allow)"]
            StaticAuthZ["Static Authorizer<br/>(allow-list)"]
            SARAuthZ["SAR Authorizer<br/>(SubjectAccessReview)"]
            ReverseProxy["Reverse Proxy<br/>(httputil.ReverseProxy)"]

            TLSListener --> PathFilter
            PathFilter -->|"matched: bypass auth"| ReverseProxy
            PathFilter -->|"unmatched"| AuthNFilter
            AuthNFilter --> DelegatingAuthN
            AuthNFilter --> OIDCAuthN
            AuthNFilter --> X509AuthN
            DelegatingAuthN --> AuthZChain
            OIDCAuthN --> AuthZChain
            X509AuthN --> AuthZChain
            AuthZChain --> HardcodedAuthZ
            AuthZChain --> StaticAuthZ
            AuthZChain --> SARAuthZ
            AuthZChain -->|"authorized"| ReverseProxy
            CertReloader -.->|"reloads"| TLSListener
        end

        UpstreamApp["Upstream Application<br/>8080/TCP HTTP<br/>(localhost)"]
        ReverseProxy -->|"HTTP localhost"| UpstreamApp
    end

    subgraph K8sControl["Kubernetes Control Plane"]
        APIServer["Kubernetes API Server<br/>443/TCP HTTPS"]
    end

    subgraph ExternalIDPs["External Identity"]
        OIDCProvider["OIDC Identity Provider<br/>443/TCP HTTPS"]
    end

    Client -->|"HTTPS/8443<br/>Bearer Token / mTLS / OIDC JWT"| TLSListener
    Prometheus -->|"HTTPS/8443<br/>SA Token"| TLSListener
    DelegatingAuthN -->|"TokenReview<br/>HTTPS/443"| APIServer
    SARAuthZ -->|"SubjectAccessReview<br/>HTTPS/443"| APIServer
    OIDCAuthN -->|"OIDC Discovery + JWKS<br/>HTTPS/443"| OIDCProvider

    %% Styling
    style TLSListener fill:#4a90e2,color:#fff
    style AuthNFilter fill:#4a90e2,color:#fff
    style AuthZChain fill:#4a90e2,color:#fff
    style ReverseProxy fill:#4a90e2,color:#fff
    style CertReloader fill:#4a90e2,color:#fff
    style PathFilter fill:#4a90e2,color:#fff
    style DelegatingAuthN fill:#5ba3d9,color:#fff
    style OIDCAuthN fill:#5ba3d9,color:#fff
    style X509AuthN fill:#5ba3d9,color:#fff
    style HardcodedAuthZ fill:#e8a838,color:#fff
    style StaticAuthZ fill:#e8a838,color:#fff
    style SARAuthZ fill:#e8a838,color:#fff
    style UpstreamApp fill:#7ed321,color:#fff
    style APIServer fill:#999,color:#fff
    style OIDCProvider fill:#999,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Prometheus fill:#f9f9f9,stroke:#999
