graph TB
    subgraph "kube-rbac-proxy Sidecar"
        direction TB
        TLSTermination["TLS Termination<br/>TLS 1.2+<br/>CertReloader (hot-reload)"]
        AuthnChain["Authentication Chain"]
        AuthzChain["Authorization Chain"]
        ReverseProxy["Reverse Proxy<br/>(httputil.ReverseProxy)"]
        AuditLog["Audit Logger<br/>(JSON structured)"]

        subgraph "Authentication"
            DelegatingAuth["Delegating TokenReview"]
            OIDCAuth["OIDC JWT Validation"]
            X509Auth["Client TLS Certificate"]
        end

        subgraph "Authorization"
            HardcodedAuthz["Hardcoded Authorizer<br/>(prometheus-k8s SA)"]
            StaticAuthz["Static Authorizer<br/>(config-driven allow)"]
            SARAuthz["SAR Authorizer<br/>(SubjectAccessReview)"]
        end

        TLSTermination --> AuthnChain
        AuthnChain --> DelegatingAuth
        AuthnChain --> OIDCAuth
        AuthnChain --> X509Auth
        AuthnChain --> AuditLog
        AuthnChain --> AuthzChain
        AuthzChain --> HardcodedAuthz
        AuthzChain --> StaticAuthz
        AuthzChain --> SARAuthz
        AuthzChain --> AuditLog
        AuthzChain --> ReverseProxy
    end

    Client["Client<br/>(e.g., Prometheus)"] -->|"HTTPS/8443<br/>Bearer Token / Client Cert / OIDC"| TLSTermination
    SARAuthz -->|"TokenReview +<br/>SubjectAccessReview"| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    ReverseProxy -->|"HTTP localhost<br/>8081/TCP"| Upstream["Upstream Service<br/>(e.g., metrics endpoint)"]

    style TLSTermination fill:#4a90e2,stroke:#333
    style AuthnChain fill:#4a90e2,stroke:#333
    style AuthzChain fill:#4a90e2,stroke:#333
    style ReverseProxy fill:#4a90e2,stroke:#333
    style AuditLog fill:#4a90e2,stroke:#333
    style DelegatingAuth fill:#5b9bd5,stroke:#333
    style OIDCAuth fill:#5b9bd5,stroke:#333
    style X509Auth fill:#5b9bd5,stroke:#333
    style HardcodedAuthz fill:#f5a623,stroke:#333
    style StaticAuthz fill:#f5a623,stroke:#333
    style SARAuthz fill:#f5a623,stroke:#333
    style Client fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Upstream fill:#7ed321,stroke:#333
