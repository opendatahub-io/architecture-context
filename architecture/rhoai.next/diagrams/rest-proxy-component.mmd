        direction TB
        Main["rest-proxy<br/>Go Service<br/>Port 8008/TCP"]
        Marshaler["CustomJSONPb Marshaler<br/>Tensor Data Conversion"]
        Stubs["gRPC-Gateway Stubs<br/>Generated from proto"]

        Main -->|"uses"| Marshaler
        Main -->|"routes via"| Stubs
        Stubs -->|"custom serialize/deserialize"| Marshaler
    end

    Client["Client<br/>(within cluster)"] -->|"REST<br/>KServe V2 Predict Protocol<br/>HTTP/HTTPS 8008/TCP"| Main

