graph TB
    subgraph ExternalAccess["External Access"]
        Client[REST Client]
    end

    subgraph ModelMeshPod["ModelMesh Serving Pod"]
        subgraph RestProxy["rest-proxy Sidecar"]
            Server["REST Server<br/>8008/TCP HTTP(S)"]
            Marshaler["Custom JSON Marshaler<br/>Tensor data encoding/decoding"]
            GRPCClient["gRPC Client<br/>grpc-gateway/v2"]
            Server -->|decodes request| Marshaler
            Marshaler -->|protobuf message| GRPCClient
        end

        subgraph ModelMesh["ModelMesh Serving"]
            GRPCService["gRPC Inference Service<br/>8033/TCP gRPC"]
        end

        GRPCClient -->|gRPC call<br/>localhost:8033| GRPCService
        GRPCService -->|gRPC response| GRPCClient
        GRPCClient -->|protobuf response| Marshaler
        Marshaler -->|encodes response| Server
    end

    subgraph ProtoDefinition["Protocol Definition"]
        Proto["grpc_predict_v2.proto<br/>KServe V2 Predict Protocol"]
        GenCode["gen/ package<br/>Generated Go stubs"]
        Proto -->|protoc + grpc-gateway| GenCode
    end

    Client -->|"REST KServe V2<br/>POST /v2/models/{name}/infer<br/>GET /v2/models/{name}"| Server
    Server -->|JSON response| Client

    GenCode -.->|compiled into| RestProxy

    subgraph TLSConfig["TLS Configuration"]
        TLSCert["TLS Cert/Key<br/>MM_TLS_KEY_CERT_PATH"]
        TLSBackend["Backend TLS<br/>REST_PROXY_USE_TLS"]
    end

    TLSCert -.->|optional HTTPS| Server
    TLSBackend -.->|optional TLS| GRPCClient

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style Marshaler fill:#4a90e2,stroke:#333,color:#fff
    style GRPCClient fill:#4a90e2,stroke:#333,color:#fff
    style GRPCService fill:#7ed321,stroke:#333,color:#fff
    style Proto fill:#f5a623,stroke:#333,color:#fff
    style GenCode fill:#f5a623,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style TLSCert fill:#ff6b6b,stroke:#333,color:#fff
    style TLSBackend fill:#ff6b6b,stroke:#333,color:#fff
