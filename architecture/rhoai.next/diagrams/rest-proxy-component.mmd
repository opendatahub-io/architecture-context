graph TB
    subgraph ModelMeshPod["ModelMesh Serving Pod"]
        direction TB

        subgraph RestProxy["rest-proxy Sidecar"]
            HTTPListener["HTTP Listener<br/>8008/TCP<br/>HTTP or HTTPS"]
            JSONDecoder["JSON Decoder<br/>+ Request Transformer"]
            CustomMarshaler["CustomJSONPb Marshaler<br/>Tensor flattening, BYTES/base64,<br/>raw binary content"]
            GRPCClient["gRPC Client<br/>(grpc-gateway)"]
            ResponseEncoder["Response Transformer<br/>+ JSON Encoder"]
        end

        subgraph InferenceServer["gRPC Inference Server (ModelMesh)"]
            GRPCEndpoint["gRPC V2 Predict<br/>8033/TCP"]
        end

        HTTPListener -->|"JSON request"| JSONDecoder
        JSONDecoder -->|"parsed request"| CustomMarshaler
        CustomMarshaler -->|"protobuf message"| GRPCClient
        GRPCClient -->|"gRPC call"| GRPCEndpoint
        GRPCEndpoint -->|"gRPC response"| ResponseEncoder
        ResponseEncoder -->|"JSON response"| HTTPListener
    end

    Client["KServe V2 REST Client"] -->|"POST /v2/models/{name}/infer<br/>8008/TCP HTTP/HTTPS"| HTTPListener

    ConfigMap["model-serving-config<br/>ConfigMap"] -.->|"restProxy.image"| RestProxy

    ServiceMesh["Istio Service Mesh<br/>(mTLS)"] -.->|"transport security"| ModelMeshPod

    style RestProxy fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style InferenceServer fill:#7ed321,stroke:#333,stroke-width:2px
    style Client fill:#f5a623,stroke:#333,stroke-width:2px
    style ConfigMap fill:#e8e8e8,stroke:#333
    style ServiceMesh fill:#e8e8e8,stroke:#333
    style HTTPListener fill:#357abd,stroke:#333,color:#fff
    style JSONDecoder fill:#357abd,stroke:#333,color:#fff
    style CustomMarshaler fill:#357abd,stroke:#333,color:#fff
    style GRPCClient fill:#357abd,stroke:#333,color:#fff
    style ResponseEncoder fill:#357abd,stroke:#333,color:#fff
    style GRPCEndpoint fill:#5cb85c,stroke:#333,color:#fff
