        InferenceServer["ModelMesh<br/>Inference Server<br/>gRPC 8033/TCP"]
    end

    Stubs -->|"gRPC<br/>V2 Predict Protocol<br/>8033/TCP"| InferenceServer

    subgraph "Parent Deployment"
        ModelMesh["ModelMesh Serving<br/>Sidecar Injection"]
    end

    ModelMesh -.->|"deploys as sidecar<br/>restProxy.image config"| Main

    style Main fill:#4a90e2,stroke:#333,color:#fff
    style Marshaler fill:#4a90e2,stroke:#333,color:#fff
    style Stubs fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#f5a623,stroke:#333,color:#fff
    style InferenceServer fill:#7ed321,stroke:#333,color:#fff
