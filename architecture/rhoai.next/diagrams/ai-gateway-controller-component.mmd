graph TB
    subgraph AGC["ai-gateway-controller (Deployment)"]
        direction TB
        Manager["Controller Manager<br/>cmd/manager/main.go"]

        subgraph TenantPlane["Tenant Plane (pkg/tenant)"]
            TenantReconciler["Tenant Reconciler<br/>Watches MaasTenantConfig + AITenant"]
            Migration["Migration Handler<br/>Backend swap CAS handshake"]
        end

        subgraph ModelPlane["Model Plane (pkg/controller)"]
            ModelReconciler["Model Reconciler<br/>Watches ExternalModel + ExternalProvider"]
        end

        subgraph SharedPkgs["Shared Packages"]
            Render["pkg/render<br/>Kustomize build + SSA apply"]
            Publisher["pkg/publisher<br/>Content-addressed overlay publication"]
            Resolver["pkg/resolver<br/>Multi-provider route resolution"]
            Envelope["pkg/envelope<br/>Overlay digest computation"]
        end

        Manager --> TenantReconciler
        Manager --> ModelReconciler
        TenantReconciler --> Migration
        TenantReconciler --> Render
        ModelReconciler --> Resolver
        ModelReconciler --> Publisher
        ModelReconciler --> Render
        Publisher --> Envelope
    end

    %% CRDs Owned
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io/v1alpha1)"]
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io/v1alpha1)"]
    AIGuardrailCR["AIGuardrail CR<br/>(aigateway.opendatahub.io/v1alpha1)"]

    %% CRDs Watched (owned by maas-controller)
    MaasTenantConfigCR["MaasTenantConfig CR<br/>(maas.opendatahub.io)"]
    AITenantCR["AITenant CR<br/>(maas.opendatahub.io)"]

    %% Resources Created
    HTTPRoute["HTTPRoute<br/>(per-model)"]
    EnvoyFilter["EnvoyFilter<br/>(per-tenant)"]
    DestRule["DestinationRule<br/>(per-provider)"]
    ServiceEntry["ServiceEntry<br/>(per-provider)"]
    PraxisDeployment["praxis-extproc<br/>Deployment (per-tenant)"]
    OverlayCM["Routing Overlay<br/>ConfigMap (per-namespace)"]

    %% Watch relationships
    ExternalModelCR -->|watched by| ModelReconciler
    ExternalProviderCR -->|watched by| ModelReconciler
    AIGuardrailCR -->|watched by| ModelReconciler
    MaasTenantConfigCR -->|watched by| TenantReconciler
    AITenantCR -->|watched by| TenantReconciler

    %% Create relationships
    ModelReconciler -->|creates| HTTPRoute
    ModelReconciler -->|creates| DestRule
    ModelReconciler -->|creates| ServiceEntry
    ModelReconciler -->|creates| OverlayCM
    TenantReconciler -->|creates| EnvoyFilter
    TenantReconciler -->|creates| PraxisDeployment

    %% External dependencies
    KubeAPI["Kubernetes API<br/>6443/TCP"]
    AGC -->|SSA apply| KubeAPI

    %% Styling
    style AGC fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style TenantReconciler fill:#4a90e2,color:#fff
    style ModelReconciler fill:#4a90e2,color:#fff
    style Migration fill:#4a90e2,color:#fff
    style Render fill:#64b5f6
    style Publisher fill:#64b5f6
    style Resolver fill:#64b5f6
    style Envelope fill:#64b5f6
    style ExternalModelCR fill:#f5a623
    style ExternalProviderCR fill:#f5a623
    style AIGuardrailCR fill:#f5a623
    style MaasTenantConfigCR fill:#ffcc80
    style AITenantCR fill:#ffcc80
    style HTTPRoute fill:#7ed321
    style EnvoyFilter fill:#7ed321
    style DestRule fill:#7ed321
    style ServiceEntry fill:#7ed321
    style PraxisDeployment fill:#7ed321
    style OverlayCM fill:#7ed321
    style KubeAPI fill:#e8e8e8
