graph LR
    Operator["LLM-D Batch Gateway<br/>Operator"]

    %% External Dependencies (Required)
    Operator -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    Operator -->|"chart rendering"| Helm["helm.sh/helm/v3<br/>v3.20.2"]

    %% External Dependencies (Optional)
    Operator -.->|"HTTPRoute, ReferenceGrant<br/>(optional CRD watches)"| GatewayAPI["gateway-api<br/>v1.5.1"]
    Operator -.->|"TLS certificates<br/>(optional)"| CertManager["cert-manager<br/>v1.20.2"]
    Operator -.->|"ServiceMonitor, PodMonitor,<br/>PrometheusRule (optional)"| PromOperator["prometheus-operator<br/>v0.91.0"]

    %% Internal Platform Dependencies
    PlatformOp["rhods-operator /<br/>opendatahub-operator"] -->|"deploys via kustomize<br/>provides params.env images"| Operator

    %% Managed Component Dependencies (runtime)
    subgraph ManagedDeps["Managed Component Runtime Dependencies"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        Redis["Redis / Valkey<br/>6379/TCP"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS"]
        InfGW["Inference Gateway<br/>(llm-d GIE/EPP)<br/>HTTP/HTTPS"]
    end

    Operator -->|"managed pods connect to"| PostgreSQL
    Operator -.->|"managed pods connect to<br/>(async mode / alt backend)"| Redis
    Operator -.->|"managed pods connect to<br/>(file storage)"| S3
    Operator -->|"managed pods dispatch<br/>inference requests to"| InfGW

    %% Kubernetes API
    Operator -->|"watch + SSA"| KubeAPI["kube-apiserver<br/>443/TCP HTTPS"]

    %% Observability Dependencies
    Operator -.->|"metrics scrape"| Prometheus["Prometheus<br/>8443, 8081, 9090, 9091/TCP"]
    Operator -.->|"distributed tracing<br/>(optional)"| OTLP["OTLP Collector<br/>4317/TCP gRPC"]

    %% Integration Points (inbound)
    Operator -.->|"batch job submissions<br/>from clients"| Clients["External Clients<br/>8000/TCP HTTP/HTTPS"]

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style Helm fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#bbb,stroke:#333
    style CertManager fill:#bbb,stroke:#333
    style PromOperator fill:#bbb,stroke:#333
    style PlatformOp fill:#7ed321,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style InfGW fill:#7ed321,stroke:#333,color:#fff
    style KubeAPI fill:#f5a623,stroke:#333
    style Prometheus fill:#bbb,stroke:#333
    style OTLP fill:#bbb,stroke:#333
    style Clients fill:#f9f9f9,stroke:#999
