graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["training-operator<br/>Namespace: opendatahub"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["training-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Webhook["training-operator-webhook<br/>(RoleBinding, opendatahub)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["training-operator"]
        CR_Edit["training-edit<br/>(aggregates to: edit, admin)"]
        CR_View["training-view<br/>(aggregates to: view)"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Webhook["training-operator-webhook<br/>(opendatahub)"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR_Main
    SA -->|"bound via"| RB_Webhook
    RB_Webhook -->|"grants"| R_Webhook

    %% Core Resources
    subgraph CoreResources["Core API Resources ('')"]
        Pods["pods<br/>get, list, watch,<br/>create, update, patch, delete"]
        PodsExec["pods/exec<br/>create"]
        Services["services<br/>get, list, watch,<br/>create, delete"]
        ConfigMaps["configmaps<br/>create, list, update, watch"]
        Events["events<br/>get, list, watch,<br/>create, update, patch, delete"]
        ServiceAccounts_R["serviceaccounts<br/>get, list, watch, create"]
    end

    %% CRD Resources
    subgraph CRDResources["kubeflow.org Resources"]
        PyTorchJobs["pytorchjobs<br/>+ /status + /finalizers<br/>FULL CRUD"]
        TFJobs["tfjobs<br/>+ /status + /finalizers<br/>FULL CRUD"]
        XGBoostJobs["xgboostjobs<br/>+ /status + /finalizers<br/>FULL CRUD"]
        MPIJobs["mpijobs<br/>+ /status + /finalizers<br/>FULL CRUD"]
        PaddleJobs["paddlejobs<br/>+ /status + /finalizers<br/>FULL CRUD"]
        JAXJobs["jaxjobs<br/>+ /status + /finalizers<br/>FULL CRUD"]
    end

    %% Scheduling Resources
    subgraph SchedulingResources["Scheduling Resources"]
        HPA["autoscaling /<br/>horizontalpodautoscalers<br/>FULL CRUD"]
        VolcanoPG["scheduling.volcano.sh /<br/>podgroups<br/>FULL CRUD"]
        SchedPG["scheduling.x-k8s.io /<br/>podgroups<br/>FULL CRUD"]
    end

    %% Other Resources
    subgraph OtherResources["Other Resources"]
        RBACRoles["rbac.authorization.k8s.io /<br/>roles, rolebindings<br/>create, list, update, watch"]
        NetPolicies["networking.k8s.io /<br/>networkpolicies<br/>FULL CRUD"]
        VWC["admissionregistration.k8s.io /<br/>validatingwebhookconfigurations<br/>get, list, update, watch"]
        APIServers["config.openshift.io /<br/>apiservers (cluster)<br/>get"]
    end

    %% Webhook Role Resources
    subgraph WebhookResources["Webhook Role Resources"]
        Secrets["secrets<br/>get, list, watch,<br/>create, update, patch"]
    end

    %% ClusterRole → Resources
    CR_Main -->|"manages"| CoreResources
    CR_Main -->|"manages"| CRDResources
    CR_Main -->|"manages"| SchedulingResources
    CR_Main -->|"manages"| OtherResources

    %% Webhook Role → Resources
    R_Webhook -->|"manages"| WebhookResources

    %% Aggregated roles
    subgraph AggregatedResources["Aggregated Role Resources (kubeflow.org)"]
        EditJobs["mpijobs, tfjobs, pytorchjobs,<br/>mxjobs, xgboostjobs, paddlejobs"]
        EditStatus["*/status<br/>get"]
    end

    CR_Edit -->|"FULL CRUD"| EditJobs
    CR_Edit -->|"read"| EditStatus
    CR_View -->|"get, list, watch"| EditJobs
    CR_View -->|"read"| EditStatus

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#5b9bd5,stroke:#333,color:#fff
    style RB_Webhook fill:#5b9bd5,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333
    style CR_Edit fill:#f5a623,stroke:#333
    style CR_View fill:#f5a623,stroke:#333
    style R_Webhook fill:#f5a623,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style PodsExec fill:#e57373,stroke:#333,color:#fff
    style Services fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
    style ServiceAccounts_R fill:#7ed321,stroke:#333
    style PyTorchJobs fill:#7ed321,stroke:#333
    style TFJobs fill:#7ed321,stroke:#333
    style XGBoostJobs fill:#7ed321,stroke:#333
    style MPIJobs fill:#7ed321,stroke:#333
    style PaddleJobs fill:#7ed321,stroke:#333
    style JAXJobs fill:#7ed321,stroke:#333
    style HPA fill:#7ed321,stroke:#333
    style VolcanoPG fill:#7ed321,stroke:#333
    style SchedPG fill:#7ed321,stroke:#333
    style RBACRoles fill:#e57373,stroke:#333,color:#fff
    style NetPolicies fill:#7ed321,stroke:#333
    style VWC fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
    style Secrets fill:#e57373,stroke:#333,color:#fff
