graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["training-operator<br/>(operator namespace)"]
        SA_MPI["{job-name}-launcher<br/>(per MPIJob, job namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Op["training-operator<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Webhook["training-operator-webhook<br/>(operator namespace)"]
        RB_MPI["{job-name}-launcher<br/>(per MPIJob, job namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Op["training-operator"]
        CR_Edit["training-edit<br/>(aggregate-to-edit)"]
        CR_View["training-view<br/>(aggregate-to-view)"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_Webhook["training-operator-webhook"]
        R_MPI["{job-name}-launcher"]
    end

    %% Bindings
    SA_Op -->|bound via| CRB_Op
    SA_Op -->|bound via| RB_Webhook
    SA_MPI -->|bound via| RB_MPI
    CRB_Op -->|grants| CR_Op
    RB_Webhook -->|grants| R_Webhook
    RB_MPI -->|grants| R_MPI

    %% ClusterRole: training-operator - Training CRDs
    subgraph TrainingCRDs["kubeflow.org Resources"]
        PyTorchJobs["pytorchjobs<br/>+ /status, /finalizers"]
        TFJobs["tfjobs<br/>+ /status, /finalizers"]
        XGBoostJobs["xgboostjobs<br/>+ /status, /finalizers"]
        MPIJobs["mpijobs<br/>+ /status, /finalizers"]
        PaddleJobs["paddlejobs<br/>+ /status, /finalizers"]
        JAXJobs["jaxjobs<br/>+ /status, /finalizers"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["pods"]
        PodsExec["pods/exec"]
        Services["services"]
        SvcAccounts["serviceaccounts"]
        ConfigMaps["configmaps"]
        Events["events"]
    end

    subgraph SchedulingResources["Scheduling Resources"]
        VolcanoPG["scheduling.volcano.sh<br/>podgroups"]
        SchedPluginsPG["scheduling.x-k8s.io<br/>podgroups"]
    end

    subgraph AdminResources["Admin Resources"]
        RBAC_Roles["rbac.authorization.k8s.io<br/>roles, rolebindings"]
        HPA["autoscaling<br/>horizontalpodautoscalers"]
        Webhooks["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        NetPolicies["networking.k8s.io<br/>networkpolicies"]
        OpenShiftTLS["config.openshift.io<br/>apiservers (cluster)"]
    end

    %% training-operator ClusterRole permissions
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| PyTorchJobs
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| TFJobs
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| XGBoostJobs
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| MPIJobs
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| PaddleJobs
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| JAXJobs

    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| Pods
    CR_Op -->|"create"| PodsExec
    CR_Op -->|"get,list,watch,<br/>create,delete"| Services
    CR_Op -->|"get,list,watch,create"| SvcAccounts
    CR_Op -->|"create,list,<br/>update,watch"| ConfigMaps
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| Events

    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| VolcanoPG
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| SchedPluginsPG

    CR_Op -->|"create,list,<br/>update,watch"| RBAC_Roles
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| HPA
    CR_Op -->|"get,list,watch,update"| Webhooks
    CR_Op -->|"get,list,watch,create,<br/>update,patch,delete"| NetPolicies
    CR_Op -->|"get"| OpenShiftTLS

    %% training-edit ClusterRole
    subgraph EditResources["training-edit Resources"]
        EditJobs["kubeflow.org<br/>mpijobs, tfjobs, pytorchjobs,<br/>mxjobs, xgboostjobs, paddlejobs"]
    end
    CR_Edit -->|"create,delete,get,list,<br/>patch,update,watch<br/>+ get on /status"| EditJobs

    %% training-view ClusterRole
    subgraph ViewResources["training-view Resources"]
        ViewJobs["kubeflow.org<br/>mpijobs, tfjobs, pytorchjobs,<br/>mxjobs, xgboostjobs, paddlejobs"]
    end
    CR_View -->|"get,list,watch<br/>+ get on /status"| ViewJobs

    %% MPI per-job Role
    subgraph MPIResources["MPI Per-Job Resources"]
        MPIPods["pods (job namespace)"]
        MPIPodsExec["pods/exec"]
    end
    R_MPI -->|"get,list,watch,<br/>create (pods/exec)"| MPIResources

    %% Webhook Role
    subgraph WebhookResources["Webhook Resources"]
        WebhookSecret["secrets<br/>(training-operator-webhook-cert)"]
    end
    R_Webhook -->|"get,list,watch,<br/>create,update"| WebhookSecret

