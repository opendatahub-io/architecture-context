    style ProxyServer fill:#4a90e2,stroke:#333,color:#fff
    style Catalog fill:#4a90e2,stroke:#333,color:#fff
    style ISVCCtrl fill:#4a90e2,stroke:#333,color:#fff
    style StorageInit fill:#4a90e2,stroke:#333,color:#fff
    style BFF fill:#4a90e2,stroke:#333,color:#fff
    style UploadJob fill:#4a90e2,stroke:#333,color:#fff
    style InferenceServiceCR fill:#f5a623,stroke:#333,color:#333
    style ClusterStorageCR fill:#f5a623,stroke:#333,color:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style OCI fill:#f5a623,stroke:#333
    style HuggingFace fill:#f5a623,stroke:#333
    style SigstoreService fill:#f5a623,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
