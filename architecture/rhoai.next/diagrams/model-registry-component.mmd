graph TB
    subgraph ModelRegistry["Model Registry Platform"]
        direction TB

        subgraph ProxyServer["model-registry (proxy server)"]
            RestAPI["REST API Server<br/>Go / 8080/TCP"]
            HealthCheck["Health & Readiness<br/>/readyz/health, /readyz/isDirty"]
            CORS["CORS Middleware"]
            Validation["Request Validation"]
            RestAPI --> CORS
            RestAPI --> Validation
            RestAPI --> HealthCheck
        end

        subgraph CatalogService["model-catalog (catalog server)"]
            CatalogAPI["Catalog API Server<br/>Go / 8080/TCP"]
            ModelPlugin["Model Catalog Plugin<br/>(HuggingFace sync)"]
            MCPPlugin["MCP Server Plugin<br/>(YAML sources)"]
            AgentPlugin["Agent Catalog Plugin<br/>(YAML sources)"]
            LeaderElection["Leader Election<br/>(PostgreSQL pglock)"]
            FileMonitor["File Monitor<br/>(CRC32 change detection)"]
            CatalogAPI --> ModelPlugin
            CatalogAPI --> MCPPlugin
            CatalogAPI --> AgentPlugin
            ModelPlugin --> LeaderElection
            MCPPlugin --> LeaderElection
            AgentPlugin --> LeaderElection
            ModelPlugin --> FileMonitor
        end

        subgraph Controller["inference-service-controller"]
            ISController["KServe Controller<br/>Go / controller-runtime"]
            Finalizer["Finalizer Manager"]
            ISController --> Finalizer
        end

        subgraph CSI["storage-initializer (CSI)"]
            StorageInit["Storage Initializer<br/>Go CLI"]
            URIValidator["URI Validator<br/>(blocks 169.254.169.254)"]
            StorageInit --> URIValidator
        end

        subgraph UI["model-registry-ui"]
            Frontend["React/TypeScript Frontend"]
            BFF["Go BFF Server<br/>8080/TCP"]
            SARCheck["SubjectAccessReview<br/>Permission Checks"]
            Frontend --> BFF
            BFF --> SARCheck
        end

        subgraph AsyncUpload["async-upload-job"]
            UploadJob["Python Job<br/>(K8s Job)"]
            SigningModule["Sigstore Signing<br/>(cosign/Fulcio/Rekor)"]
            UploadJob --> SigningModule
        end
    end

    %% Data Stores
    RegistryDB[("PostgreSQL<br/>model-registry-db<br/>5432/TCP")]
    CatalogDB[("PostgreSQL<br/>model-catalog-postgres<br/>5432/TCP")]

    %% External Services
    HuggingFace["HuggingFace API<br/>443/TCP HTTPS"]
    S3["S3 Storage<br/>443/TCP HTTPS"]
    OCI["OCI Registry<br/>443/TCP HTTPS"]
    Sigstore["Sigstore<br/>(Fulcio/Rekor/TUF)"]

    %% Platform Dependencies
    Istio["Istio Service Mesh<br/>(mTLS, AuthZ)"]
    KServe["KServe<br/>(InferenceService CRD)"]
    KubeAPI["Kubernetes API<br/>443/TCP"]
    KubeflowGW["Kubeflow Gateway<br/>(Istio Ingress)"]

    %% User
    User["Data Scientist / User"]

    %% Connections
    User -->|HTTPS/443| KubeflowGW
    KubeflowGW -->|VirtualService| RestAPI
    KubeflowGW -->|VirtualService| CatalogAPI
    KubeflowGW -->|VirtualService| Frontend

    RestAPI -->|GORM| RegistryDB
    CatalogAPI -->|GORM| CatalogDB
    ModelPlugin -->|HTTPS/443| HuggingFace

    ISController -->|watches| KServe
    ISController -->|REST| RestAPI
    ISController -->|HTTPS/443| KubeAPI

    StorageInit -->|REST| RestAPI
    StorageInit -->|delegates| KServe

    UploadJob -->|HTTPS| RestAPI
    UploadJob -->|HTTPS/443| S3
    UploadJob -->|HTTPS/443| OCI
    UploadJob -->|HTTPS/443| Sigstore

    BFF -->|HTTPS/443| KubeAPI

    Istio -.->|sidecar inject| ProxyServer
    Istio -.->|sidecar inject| CatalogService
    Istio -.->|sidecar inject| UI

    %% Styling
    style RestAPI fill:#4a90e2,color:#fff
    style CatalogAPI fill:#4a90e2,color:#fff
    style ISController fill:#4a90e2,color:#fff
    style StorageInit fill:#4a90e2,color:#fff
    style BFF fill:#4a90e2,color:#fff
    style UploadJob fill:#9b59b6,color:#fff
    style Frontend fill:#3498db,color:#fff
    style RegistryDB fill:#f5a623,color:#fff
    style CatalogDB fill:#f5a623,color:#fff
    style HuggingFace fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OCI fill:#e8e8e8,stroke:#333
    style Sigstore fill:#e8e8e8,stroke:#333
    style Istio fill:#7ed321,color:#fff
    style KServe fill:#7ed321,color:#fff
    style KubeAPI fill:#e8e8e8,stroke:#333
    style KubeflowGW fill:#7ed321,color:#fff
    style User fill:#fff,stroke:#333,stroke-width:2px
