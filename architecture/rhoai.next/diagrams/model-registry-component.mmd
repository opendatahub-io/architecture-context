graph TB
    subgraph ModelRegistry["Model Registry Platform"]
        direction TB

        subgraph CoreAPI["Core REST API Server"]
            ProxyServer["model-registry<br/>(proxy server)<br/>Go · 8080/TCP"]
            OpenAPI["OpenAPI v1alpha3<br/>REST Endpoints"]
            ProxyServer --- OpenAPI
        end

        subgraph CatalogServer["Catalog Server"]
            Catalog["model-catalog<br/>(catalog server)<br/>Go · 8080/TCP"]
            PluginRegistry["Plugin Registry<br/>model | agent | MCP"]
            Catalog --- PluginRegistry
        end

        subgraph Controller["InferenceService Controller"]
            ISVCCtrl["inference-service-controller<br/>Go Controller"]
            Reconciler["ISVC Reconciler<br/>Watch + Sync"]
            ISVCCtrl --- Reconciler
        end

        subgraph CSI["CSI Storage Initializer"]
            StorageInit["mr-storage-initializer<br/>Go CLI"]
            URIHandler["model-registry://<br/>URI Handler"]
            StorageInit --- URIHandler
        end

        subgraph UIBFF["UI Backend-for-Frontend"]
            BFF["model-registry-ui<br/>(BFF)<br/>Go · 8080/TCP"]
            ReactUI["React Frontend"]
            BFF --- ReactUI
        end

        subgraph AsyncJob["Async Upload Job"]
            UploadJob["async-upload-job<br/>Python · K8s Job"]
            Signing["Sigstore Signing"]
            UploadJob --- Signing
        end
    end

    %% Internal integrations
    ISVCCtrl -->|"REST API<br/>8080/TCP"| ProxyServer
    StorageInit -->|"REST API<br/>8080/TCP"| ProxyServer
    BFF -->|"Proxy API calls<br/>8080/TCP"| ProxyServer
    BFF -->|"Proxy catalog calls<br/>8080/TCP"| Catalog
    UploadJob -->|"Register models<br/>443/TCP"| ProxyServer

    %% CRDs
    InferenceServiceCR["InferenceService CR<br/>serving.kserve.io/v1beta1"]
    ClusterStorageCR["ClusterStorageContainer CR<br/>serving.kserve.io/v1alpha1"]
    InferenceServiceCR -->|"watched by"| ISVCCtrl
    ClusterStorageCR -->|"registers"| StorageInit

    %% External Dependencies
    MySQL[("MySQL 8.3+<br/>3306/TCP")]
    PostgreSQL[("PostgreSQL 16+<br/>5432/TCP")]
    ProxyServer -->|"GORM<br/>SQL"| MySQL
    ProxyServer -->|"GORM<br/>SQL"| PostgreSQL
    Catalog -->|"SQL"| PostgreSQL

    %% External Services
    S3["S3 Storage<br/>443/TCP"]
    OCI["OCI Registry<br/>443/TCP"]
    HuggingFace["HuggingFace Hub<br/>443/TCP"]
    SigstoreService["Sigstore<br/>443/TCP"]

    UploadJob -->|"download/upload"| S3
    UploadJob -->|"push OCI artifact"| OCI
    UploadJob -->|"download models"| HuggingFace
    UploadJob -->|"sign artifacts"| SigstoreService
    StorageInit -->|"download models"| S3

    %% Platform Integration
    Dashboard["RHOAI Dashboard"]
    Istio["Istio Service Mesh"]
    KServe["KServe"]
    K8sAPI["Kubernetes API<br/>443/TCP"]

    Dashboard -->|"UI access"| BFF
    Istio -->|"mTLS + AuthZ"| ProxyServer
    KServe -->|"creates ISVCs"| InferenceServiceCR
    ISVCCtrl -->|"SA token"| K8sAPI
    BFF -->|"SubjectAccessReview"| K8sAPI

    %% Users
    User["Data Scientist / ML Engineer"]
    User -->|"REST API / UI"| Dashboard
    User -->|"kubectl / CLI"| InferenceServiceCR

