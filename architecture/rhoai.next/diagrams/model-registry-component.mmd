graph TB
    subgraph ModelRegistry["Model Registry System"]
        direction TB

        subgraph ProxyServer["model-registry proxy"]
            API["REST API Server<br/>:8080/TCP"]
            GORM["GORM ORM Layer"]
            Migrations["golang-migrate<br/>Schema Migrations"]
            TLSConfig["TLS Config<br/>MinVersion 1.2"]
            API --> GORM
            GORM --> Migrations
            API --> TLSConfig
        end

        subgraph ControllerComp["controller (manager)"]
            Reconciler["InferenceService<br/>Reconciler"]
            LeaderElection["Leader Election"]
            MetricsEndpoint["Metrics<br/>:8443/TCP HTTPS"]
            HealthProbe["Health Probe<br/>:8081/TCP"]
            Reconciler --> LeaderElection
        end

        subgraph BFF["UI BFF"]
            BFFRouter["HTTP Router<br/>:8080/TCP"]
            AuthMiddleware["Auth Middleware<br/>(internal / user_token)"]
            K8sClient["Per-Request<br/>K8s Client"]
            BFFRouter --> AuthMiddleware
            AuthMiddleware --> K8sClient
        end

        subgraph Catalog["model-catalog-server"]
            CatalogAPI["Catalog API<br/>:8080/TCP"]
            PluginSystem["Plugin System"]
            HFPlugin["HuggingFace<br/>Plugin"]
            SRPlugin["Serving Runtime<br/>Plugin"]
            MCPPlugin["MCP Server<br/>Plugin"]
            AgentPlugin["Agent/Skill<br/>Plugin"]
            CatalogAPI --> PluginSystem
            PluginSystem --> HFPlugin
            PluginSystem --> SRPlugin
            PluginSystem --> MCPPlugin
            PluginSystem --> AgentPlugin
        end

        CSI["mr-storage-initializer<br/>(CSI init container)"]
        AsyncUpload["async-upload Job<br/>(Python)"]
    end

    %% External actors
    User["User / Browser"]
    KServeIS["KServe<br/>InferenceService CR"]

    %% Databases
    PostgreSQL["PostgreSQL<br/>:5432/TCP"]
    CatalogDB["model-catalog-postgres<br/>PostgreSQL :5432/TCP"]

    %% External services
    K8sAPI["Kubernetes API<br/>:6443/TCP"]
    S3["S3 / OCI Storage<br/>:443/TCP"]
    HuggingFace["HuggingFace API<br/>:443/TCP"]
    IstioGW["Istio Ingress<br/>Gateway"]

    %% User flows
    User -->|"Bearer Token"| IstioGW
    IstioGW -->|"VirtualService"| BFFRouter
    IstioGW -->|"VirtualService"| API
    IstioGW -->|"VirtualService"| CatalogAPI

    %% BFF connections
    BFFRouter -->|"HTTP/Istio mTLS"| API
    K8sClient -->|"HTTPS :6443"| K8sAPI
    BFFRouter -->|"HTTP"| CatalogAPI

    %% Controller connections
    KServeIS -->|"watched by"| Reconciler
    Reconciler -->|"HTTP :8080"| API

    %% Data layer
    GORM -->|"SQL :5432"| PostgreSQL
    CatalogAPI -->|"SQL :5432"| CatalogDB

    %% CSI flow
    CSI -->|"HTTP :8080"| API
    CSI -->|"HTTPS :443"| S3

    %% Async upload flow
    AsyncUpload -->|"HTTP :8080"| API
    AsyncUpload -->|"HTTPS :443"| S3
    AsyncUpload -->|"sigstore signing"| S3

    %% Catalog external
    HFPlugin -->|"HTTPS :443"| HuggingFace

    %% Styling
    style API fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style BFFRouter fill:#4a90e2,color:#fff
    style CatalogAPI fill:#4a90e2,color:#fff
    style CSI fill:#4a90e2,color:#fff
    style AsyncUpload fill:#9b59b6,color:#fff
    style PostgreSQL fill:#336791,color:#fff
    style CatalogDB fill:#336791,color:#fff
    style K8sAPI fill:#326ce5,color:#fff
    style IstioGW fill:#466bb0,color:#fff
    style S3 fill:#f5a623,color:#fff
    style HuggingFace fill:#f5a623,color:#fff
    style KServeIS fill:#e67e22,color:#fff
    style User fill:#999,color:#fff
