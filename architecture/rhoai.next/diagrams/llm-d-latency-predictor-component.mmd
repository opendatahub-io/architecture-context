graph TB
    subgraph LLP["llm-d-latency-predictor"]
        direction TB

        subgraph TrainingServer["Training Server (8000/TCP)"]
            TrainAPI["FastAPI + Uvicorn"]
            DataIngestion["Data Ingestion<br/>/add_training_data_bulk"]
            RetrainLoop["Retrain Loop<br/>(30min interval)"]
            ModelStore["Model Storage<br/>(PVC /models/*.joblib)"]
            BucketSampler["Bucketed Sampler<br/>(5×20×4 = 400 buckets)"]
            ModelServe["Model Download<br/>/model/{name}/download"]
            Metrics["Prometheus Metrics<br/>/metrics"]

            DataIngestion --> BucketSampler
            BucketSampler --> RetrainLoop
            RetrainLoop -->|"trains XGBoost/LightGBM/<br/>BayesianRidge"| ModelStore
            ModelStore --> ModelServe
            TrainAPI --> DataIngestion
            TrainAPI --> ModelServe
            TrainAPI --> Metrics
        end

        subgraph PredictionServer["Prediction Server (8001/TCP, 10 replicas)"]
            PredAPI["FastAPI + Uvicorn<br/>(8 workers)"]
            SyncThread["Model Sync Thread<br/>(10s interval)"]
            LocalModels["Local Model Cache<br/>(emptyDir)"]
            PredictEngine["Prediction Engine"]
            EnsembleGate["Gated Ensemble<br/>(noqueue/queued)"]

            SyncThread -->|"checksum-based<br/>cache invalidation"| LocalModels
            LocalModels --> PredictEngine
            PredictEngine --> EnsembleGate
            PredAPI -->|"/predict<br/>/predict/bulk"| PredictEngine
        end

        subgraph CommonLib["common/types"]
            Types["ModelType | ObjectiveType<br/>QueueGatedModel<br/>RandomDropDeque"]
        end
    end

    %% External data source
    LLMd["llm-d Inference Engine"] -->|"POST /add_training_data_bulk<br/>TTFT/TPOT observations"| DataIngestion

    %% Model sync flow
    SyncThread -->|"GET /model/{name}/info<br/>GET /model/{name}/download<br/>HTTP 8000/TCP"| ModelServe

    %% Client prediction
    Client["llm-d Routing Layer"] -->|"POST /predict<br/>POST /predict/bulk/strict<br/>HTTP 80/TCP"| PredAPI

    %% Shared types
    CommonLib -.->|"shared types"| TrainingServer
    CommonLib -.->|"shared types"| PredictionServer

    %% Styling
    style TrainingServer fill:#4a90e2,stroke:#2c5f8a,color:#fff
    style PredictionServer fill:#7ed321,stroke:#5a9e18,color:#fff
    style CommonLib fill:#f5a623,stroke:#c4841a,color:#fff
    style LLMd fill:#e8e8e8,stroke:#999
    style Client fill:#e8e8e8,stroke:#999
    style ModelStore fill:#fff2cc,stroke:#d6b656
    style LocalModels fill:#fff2cc,stroke:#d6b656
    style EnsembleGate fill:#d5e8d4,stroke:#82b366
    style BucketSampler fill:#d5e8d4,stroke:#82b366
