graph TB
    subgraph LLP["llm-d-latency-predictor"]
        direction TB

        subgraph PredServer["Prediction Server (FastAPI)"]
            PredAPI["Prediction API<br/>8001/TCP"]
            ModelSync["Model Sync Thread<br/>Periodic Download"]
            BulkPredict["Bulk Predict Fast Path<br/>up to 10k requests"]
            PredAPI --> BulkPredict
        end

        subgraph TrainServer["Training Server (FastAPI)"]
            TrainAPI["Training API<br/>8000/TCP"]
            RetrainLoop["Retrain Loop<br/>30min interval"]
            BucketStore["Bucketed Data Store<br/>RandomDropDeque<br/>400 buckets"]
            ModelStore["Model Store<br/>PVC /models/*.joblib"]
            TrainAPI --> BucketStore
            RetrainLoop --> BucketStore
            RetrainLoop --> ModelStore
        end

        subgraph CommonLib["common/types"]
            ModelType["ModelType<br/>xgboost/lightgbm/bayesian_ridge"]
            ObjectiveType["ObjectiveType<br/>quantile/mean"]
            QueueGatedModel["QueueGatedModel<br/>Ensemble Routing"]
        end

        ModelSync -->|"HTTP GET /model/download<br/>checksum-based cache"| TrainAPI
        PredAPI -.-> ModelType
        PredAPI -.-> QueueGatedModel
        TrainAPI -.-> ModelType
        TrainAPI -.-> ObjectiveType
    end

    InferenceEngine["llm-d Inference Engine"] -->|"POST /add_training_data_bulk<br/>TTFT/TPOT observations"| TrainAPI
    RoutingLayer["llm-d Routing Layer"] -->|"POST /predict<br/>or /predict/bulk/strict"| PredAPI

    subgraph TestHarness["test-harness (pytest Job)"]
        Tests["Integration Tests"]
    end

    Tests -.->|validates| PredAPI
    Tests -.->|validates| TrainAPI

    style PredServer fill:#4a90e2,stroke:#333,color:#fff
    style TrainServer fill:#f5a623,stroke:#333,color:#fff
    style CommonLib fill:#7ed321,stroke:#333,color:#fff
    style InferenceEngine fill:#e8e8e8,stroke:#333
    style RoutingLayer fill:#e8e8e8,stroke:#333
    style TestHarness fill:#d5d5d5,stroke:#999,stroke-dasharray:5 5
