graph TB
    subgraph LLP["llm-d-latency-predictor"]
        direction TB

        subgraph TrainingServer["training-server (FastAPI/Uvicorn)"]
            TrainAPI["Training API<br/>Port: 8000/TCP"]
            ModelTrainer["Model Trainer<br/>(XGBoost / LightGBM / Bayesian Ridge)"]
            DataBuckets["Stratified Data Buckets<br/>(queue depth, KV cache %, prefix cache)"]
            MetricsEndpoint["Prometheus Metrics<br/>/metrics"]
            TrainAPI -->|ingest samples| DataBuckets
            DataBuckets -->|periodic retrain| ModelTrainer
            ModelTrainer -->|save joblib| PVC
        end

        subgraph PredictionServer["prediction-server (FastAPI/Uvicorn)"]
            PredictAPI["Prediction API<br/>Port: 8001/TCP"]
            ModelSync["Background Model Sync Thread<br/>(polls every MODEL_SYNC_INTERVAL_SEC)"]
            LocalModels["Local Model Cache<br/>(/local_models/)"]
            BulkFastPath["Bulk Predict Fast Path<br/>ORJSONResponse + numpy"]
            ModelSync -->|download & validate| LocalModels
            PredictAPI -->|load model| LocalModels
            BulkFastPath -->|load model| LocalModels
        end

        subgraph Common["common library"]
            Types["ModelType, ObjectiveType<br/>QueueGatedModel<br/>RandomDropDeque"]
        end

        PVC["PVC<br/>/models/<br/>(Persistent Volume)"]
    end

    RoutingLayer["llm-d Routing Layer<br/>(Consumer)"]
    Prometheus["Prometheus<br/>(Monitoring)"]

    %% External flows
    RoutingLayer -->|"POST /add_training_data_bulk<br/>8000/TCP HTTP"| TrainAPI
    RoutingLayer -->|"POST /predict/bulk/strict<br/>80/TCP → 8001/TCP HTTP"| PredictAPI
    ModelSync -->|"GET /model/{name}/info<br/>GET /model/{name}/download<br/>8000/TCP HTTP"| TrainAPI
    Prometheus -->|"GET /metrics<br/>8000/TCP HTTP"| MetricsEndpoint

    %% Internal references
    TrainingServer -.->|uses| Common
    PredictionServer -.->|uses| Common

    %% Styling
    style TrainingServer fill:#4a90e2,stroke:#333,color:#fff
    style PredictionServer fill:#4a90e2,stroke:#333,color:#fff
    style Common fill:#b8d4f0,stroke:#333
    style PVC fill:#f5a623,stroke:#333
    style RoutingLayer fill:#7ed321,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style TrainAPI fill:#357abd,stroke:#333,color:#fff
    style PredictAPI fill:#357abd,stroke:#333,color:#fff
    style ModelTrainer fill:#357abd,stroke:#333,color:#fff
    style DataBuckets fill:#357abd,stroke:#333,color:#fff
    style MetricsEndpoint fill:#357abd,stroke:#333,color:#fff
    style ModelSync fill:#357abd,stroke:#333,color:#fff
    style LocalModels fill:#357abd,stroke:#333,color:#fff
    style BulkFastPath fill:#357abd,stroke:#333,color:#fff
    style Types fill:#8bb8e0,stroke:#333
