graph LR
    Provider["llama-stack-provider-ragas"]

    %% Core Dependencies (always required)
    Provider -->|"provider interface<br/>API types"| LlamaStack["llama-stack >0.2.23"]
    Provider -->|"RAG evaluation engine"| Ragas["ragas ==0.3.0"]
    Provider -->|"LLM/embedding wrappers"| LangChain["langchain-core ==0.3.76"]
    Provider -->|"data manipulation"| Pandas["pandas <2.3.0"]
    Provider -->|"columnar format"| PyArrow["pyarrow >=21.0.0"]
    Provider -->|"HuggingFace datasets"| Datasets["datasets >=2.16.0"]

    %% Remote-only Dependencies
    Provider -.->|"pipeline SDK<br/>(remote only)"| KFP["kfp >=2.5.0"]
    Provider -.->|"K8s extensions<br/>(remote only)"| KFPKube["kfp-kubernetes >=2.0.0"]
    Provider -.->|"API client<br/>(remote only)"| K8sClient["kubernetes >=30.0.0"]
    Provider -.->|"S3 filesystem<br/>(remote only)"| S3FS["s3fs >=2024.12.0"]

    %% Internal Platform Dependencies
    Provider -->|"pipeline submission<br/>HTTP/443"| DSP["Data Science Pipelines<br/>(Kubeflow Pipelines)"]
    Provider -->|"inference + embeddings<br/>8321/TCP"| LSServer["Llama Stack Server"]
    Provider -->|"ConfigMap reads<br/>HTTPS/443"| K8sAPI["Kubernetes API"]
    Provider -.->|"base image config"| TrustyAI["TrustyAI Service Operator"]

    %% Integration Points (consumers)
    LSServer -->|"hosts provider"| Provider

    %% External Services
    Provider -->|"result storage<br/>HTTPS/443"| S3["S3 Storage"]
    Provider -.->|"LLM backend<br/>(sample distro)<br/>HTTP/11434"| Ollama["Ollama"]

    %% Runtime
    Provider -->|"runtime"| Python["Python >=3.12"]

    style Provider fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
