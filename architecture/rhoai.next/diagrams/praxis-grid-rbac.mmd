graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["grid-operator<br/>Namespace: grid-system"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_CRD["grid-operator-crd<br/>ClusterRoleBinding<br/>Scope: cluster-wide"]
        CRB_Resources["grid-operator-resources<br/>ClusterRoleBinding<br/>Scope: grid-system namespace"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_CRD["grid-operator-crd"]
        CR_Resources["grid-operator-resources"]
    end

    subgraph CRDResources["grid.praxis.fast API Resources"]
        AgentToolProviders["agenttoolproviders<br/>get, list, watch, patch"]
        GridNetworks["gridnetworks<br/>get, list, watch, patch"]
        InferenceProviders["inferenceproviders<br/>get, list, watch, patch"]
        GridSites["gridsites<br/>get, list, watch, patch,<br/>create, update, delete"]
        StatusSubresources["*/status<br/>get, patch"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["secrets<br/>get, create, patch"]
        Services["services<br/>get<br/>provider-gateway,<br/>grid-operator-swim,<br/>grid-operator-signals"]
        ConfigMaps["configmaps<br/>get, create, patch, update"]
        Events["events.k8s.io/events<br/>create, patch"]
    end

    %% Bindings
    SA -->|bound via| CRB_CRD
    SA -->|bound via| CRB_Resources
    CRB_CRD -->|grants| CR_CRD
    CRB_Resources -->|grants| CR_Resources

    %% CRD role permissions
    CR_CRD -->|read + patch| AgentToolProviders
    CR_CRD -->|read + patch| GridNetworks
    CR_CRD -->|read + patch| InferenceProviders
    CR_CRD -->|full CRUD| GridSites
    CR_CRD -->|status updates| StatusSubresources

    %% Resource role permissions
    CR_Resources -->|credential access| Secrets
    CR_Resources -->|service discovery| Services
    CR_Resources -->|overlay writes| ConfigMaps
    CR_Resources -->|audit trail| Events

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CRB_CRD fill:#b8d4f0
    style CRB_Resources fill:#b8d4f0
    style CR_CRD fill:#f5a623
    style CR_Resources fill:#f5a623
    style AgentToolProviders fill:#7ed321
    style GridNetworks fill:#7ed321
    style InferenceProviders fill:#7ed321
    style GridSites fill:#7ed321
    style StatusSubresources fill:#7ed321
    style Secrets fill:#ff6b6b
    style Services fill:#e8e8e8
    style ConfigMaps fill:#e8e8e8
    style Events fill:#e8e8e8
