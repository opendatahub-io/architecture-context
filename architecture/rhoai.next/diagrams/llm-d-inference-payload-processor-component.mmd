graph TB
    subgraph IPP["llm-d Inference Payload Processor (IPP)"]
        direction TB

        subgraph Server["gRPC Server (ext-proc)"]
            ExtProc["ExternalProcessor Service<br/>9004/TCP gRPC/HTTP2<br/>Self-signed TLS"]
            HealthSvc["Health Service<br/>9005/TCP gRPC<br/>Plaintext"]
        end

        subgraph Observability["Observability"]
            Metrics["Metrics Endpoint<br/>/metrics 9090/TCP"]
            Pprof["Profiling<br/>/debug/pprof/* 9090/TCP"]
            Tracing["OTel Tracing<br/>(optional)"]
        end

        subgraph PluginFramework["Plugin Framework"]
            Registry["Plugin Registry<br/>(factory pattern)"]

            subgraph RequestPlugins["Request Processors"]
                BodyFieldToHeader["body-field-to-header<br/>Extracts model → X-Gateway-Model-Name"]
                BaseModelExtractor["base-model-to-header<br/>Maps adapter → X-Gateway-Base-Model-Name"]
            end

            subgraph ResponsePlugins["Response Processors"]
                ModelNameToHeader["model-name-to-header<br/>Extracts model from response"]
            end

            subgraph ModelSelector["Model Selector Pipeline"]
                direction LR
                Filter["Filter"]
                Score["Score"]
                Pick["Pick"]
                Filter --> Score --> Pick
            end

            subgraph Filters["Filters"]
                ModelGroupFilter["model-group-filter"]
            end

            subgraph Scorers["Scorers"]
                CostAware["cost-aware-scorer"]
                CostGuard["costguard-scorer<br/>(epsilon-greedy bandit)"]
                InFlight["inflight-requests-scorer"]
                SessionAffinity["session-affinity-scorer"]
            end

            subgraph Pickers["Pickers"]
                MaxScore["max-score"]
                Random["random"]
                WeightedRandom["weighted-random"]
            end
        end

        subgraph DataLayer["Data Layer"]
            EventNotifier["Event Notifier<br/>(buffered channel, cap 10K)"]
            subgraph Extractors["Extractors"]
                RequestMetadata["request-metadata-extractor"]
                RequestCostMetadata["request-cost-metadata-extractor"]
            end
            subgraph DataSources["Data Sources"]
                ModelConfigCollector["model-config-collector<br/>(fsnotify file watch)"]
            end
            Datastore["In-Memory Datastore<br/>(model attributes, costs, in-flight)"]
        end

        subgraph ConfigReconciler["ConfigMap Reconciler"]
            AdaptersStore["AdaptersStore<br/>(adapter → base model)"]
            CMWatcher["ConfigMap Watch<br/>label: inference.llm-d.ai/ipp-managed"]
        end
    end

    %% External connections
    Client[External Client] -->|HTTPS/443| EnvoyProxy
    EnvoyProxy["Envoy Proxy<br/>(Gateway)"] -->|gRPC ext-proc<br/>9004/TCP| ExtProc
    ExtProc -->|header/body mutations| EnvoyProxy
    EnvoyProxy -->|HTTPRoute<br/>header match| InferencePool["InferencePool"]
    InferencePool --> EPP["llm-d Router (EPP)<br/>(pod selection)"]
    EPP --> ModelServer["Model Servers<br/>(vLLM, etc.)<br/>8000/TCP"]

    CMWatcher -->|watch| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    K8sAPI -->|events| AdaptersStore

    Tracing -->|OTLP/gRPC<br/>4317/TCP| OTelCollector["OTel Collector"]
    Prometheus["Prometheus"] -->|scrape| Metrics

    %% Internal flows
    ExtProc --> Registry
    Registry --> RequestPlugins
    Registry --> ResponsePlugins
    Registry --> ModelSelector
    BaseModelExtractor -->|reads| AdaptersStore
    ModelSelector --> Filters
    ModelSelector --> Scorers
    ModelSelector --> Pickers
    Scorers -->|reads| Datastore
    Filters -->|reads| Datastore
    EventNotifier --> Extractors
    Extractors -->|writes| Datastore
    ModelConfigCollector -->|writes| Datastore

    %% PayloadProcessorConfig
    PPConfig["PayloadProcessorConfig<br/>(YAML)"] -.->|configures| Registry

    %% Styling
    style IPP fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style ExtProc fill:#4a90e2,color:#fff
    style HealthSvc fill:#4a90e2,color:#fff
    style EnvoyProxy fill:#f5a623,stroke:#333
    style InferencePool fill:#7ed321,stroke:#333
    style EPP fill:#7ed321,stroke:#333
    style ModelServer fill:#999,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style OTelCollector fill:#999,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style PPConfig fill:#fff2cc,stroke:#d6b656
    style CostGuard fill:#e8d4f0,stroke:#9b59b6
    style Datastore fill:#d5e8d4,stroke:#82b366
