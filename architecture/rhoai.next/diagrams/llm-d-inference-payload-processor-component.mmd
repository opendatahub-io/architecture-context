graph TB
    subgraph External["External Clients"]
        Client["Client<br/>(Inference Request)"]
    end

    subgraph EnvoyLayer["Envoy Gateway Proxy"]
        Envoy["Envoy Proxy<br/>443/TCP HTTPS"]
    end

    subgraph IPP["Inference Payload Processor"]
        direction TB

        subgraph CoreServer["Core Server"]
            ExtProc["ExternalProcessor<br/>gRPC Server<br/>9004/TCP"]
            HealthSrv["Health Server<br/>gRPC 9005/TCP"]
            MetricsSrv["Metrics Server<br/>HTTP 9090/TCP"]
        end

        subgraph Pipeline["Processing Pipeline"]
            PreProc["PreProcessors"]
            ProfilePicker["Profile Picker"]
            ReqPlugins["Profile Request Plugins"]
            RespPlugins["Profile Response Plugins"]
            PostProc["PostProcessors"]
        end

        subgraph PluginFramework["Plugin Framework"]
            BodyToHeader["body-field-to-header<br/>Extracts model name"]
            BaseModelExtractor["base-model-extractor<br/>Resolves LoRA to base"]
            BaseModelToHeader["base-model-to-header<br/>Injects X-Gateway-Base-Model-Name"]
        end

        subgraph ModelSelection["Model Selector Pipeline"]
            Filter["Filter"]
            Score["Score<br/>(CostGuard, Affinity)"]
            Pick["Pick"]
        end

        subgraph DataLayer["Data Layer"]
            EventNotifier["EventNotifier<br/>(buffered channel)"]
            Extractors["Extractors<br/>(request-metadata, cost-metadata)"]
            Collectors["Collectors<br/>(periodic polling)"]
            Datastore["In-Memory Datastore"]
        end
    end

    subgraph ExternalDeps["External Dependencies"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        ConfigMap["ConfigMaps<br/>(model mappings)"]
        OTLP["OTLP Collector<br/>4317/TCP"]
        Prometheus["Prometheus<br/>(scrapes /metrics)"]
    end

    subgraph RoutingTargets["Routing Targets"]
        Pool1["InferencePool A<br/>(Base Model 1)"]
        Pool2["InferencePool B<br/>(Base Model 2)"]
        EPP["llm-d Router EPP<br/>(Pod Selection)"]
    end

    %% Request flow
    Client -->|HTTPS/443| Envoy
    Envoy -->|"gRPC ext-proc<br/>9004/TCP"| ExtProc
    ExtProc --> PreProc
    PreProc --> ProfilePicker
    ProfilePicker --> ReqPlugins
    ReqPlugins --> BodyToHeader
    ReqPlugins --> BaseModelExtractor
    ReqPlugins --> BaseModelToHeader
    ReqPlugins -.->|"model selection"| Filter
    Filter --> Score
    Score --> Pick
    RespPlugins --> PostProc
    PostProc -->|"header mutations"| ExtProc

    %% Data layer flow
    ExtProc -->|"events"| EventNotifier
    EventNotifier --> Extractors
    Extractors --> Datastore
    Collectors --> Datastore
    Filter -->|"read candidates"| Datastore

    %% External connections
    BaseModelExtractor -->|"watch"| K8sAPI
    K8sAPI --> ConfigMap
    MetricsSrv -->|"/metrics"| Prometheus
    ExtProc -.->|"traces"| OTLP

    %% Routing
    Envoy -->|"X-Gateway-Model-Name<br/>header match"| Pool1
    Envoy -->|"X-Gateway-Base-Model-Name<br/>header match"| Pool2
    Pool1 --> EPP
    Pool2 --> EPP

    %% Styling
    style ExtProc fill:#4a90e2,stroke:#333,stroke-width:2px
    style HealthSrv fill:#4a90e2,stroke:#333
    style MetricsSrv fill:#4a90e2,stroke:#333
    style BodyToHeader fill:#7ed321,stroke:#333
    style BaseModelExtractor fill:#7ed321,stroke:#333
    style BaseModelToHeader fill:#7ed321,stroke:#333
    style Filter fill:#f5a623,stroke:#333
    style Score fill:#f5a623,stroke:#333
    style Pick fill:#f5a623,stroke:#333
    style EventNotifier fill:#9b59b6,stroke:#333
    style Extractors fill:#9b59b6,stroke:#333
    style Collectors fill:#9b59b6,stroke:#333
    style Datastore fill:#9b59b6,stroke:#333
    style Envoy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OTLP fill:#e8e8e8,stroke:#333
    style Pool1 fill:#e8e8e8,stroke:#333
    style Pool2 fill:#e8e8e8,stroke:#333
    style EPP fill:#e8e8e8,stroke:#333
