graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["ai-gateway-controller<br/>Namespace: opendatahub"]
    end

    subgraph Bindings["ClusterRole Binding"]
        CRB["ai-gateway-controller-rolebinding<br/>(cluster-scoped)"]
    end

    subgraph ClusterRole["ClusterRole: ai-gateway-controller-role"]
        CR["ai-gateway-controller-role"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR

    subgraph MaaSResources["maas.opendatahub.io"]
        MaasTenantConfig["MaasTenantConfig<br/>get, list, watch, update, patch"]
        AITenant["AITenant<br/>get, list, watch"]
        MaaSExternalModels["ExternalModels<br/>get, list, watch"]
        MaaSExternalModelsFin["ExternalModels/finalizers<br/>update"]
    end

    subgraph InferenceResources["inference.opendatahub.io"]
        InfExternalProviders["ExternalProviders<br/>get, list, watch, create, update"]
        InfExternalModels["ExternalModels<br/>get, list, watch, create, update"]
        InfStatus["*/status<br/>get, update, patch"]
        InfFinalizers["*/finalizers<br/>update"]
    end

    subgraph AIGatewayResources["aigateway.opendatahub.io"]
        AIGuardrails["AIGuardrails<br/>get, list, watch"]
    end

    subgraph CoreResources["Core API"]
        Services["Services<br/>full CRUD"]
        ServiceAccounts2["ServiceAccounts<br/>full CRUD"]
        ConfigMaps["ConfigMaps<br/>full CRUD"]
        Secrets["Secrets<br/>get, list, watch (read-only)"]
        Events["Events<br/>create, patch"]
    end

    subgraph AppsResources["apps"]
        Deployments["Deployments<br/>full CRUD"]
    end

    subgraph NetworkResources["networking.k8s.io"]
        NetworkPolicies["NetworkPolicies<br/>full CRUD"]
    end

    subgraph IstioResources["networking.istio.io"]
        EnvoyFilters["EnvoyFilters<br/>full CRUD"]
        DestinationRules["DestinationRules<br/>full CRUD"]
        ServiceEntries["ServiceEntries<br/>full CRUD"]
    end

    subgraph RBACResources["rbac.authorization.k8s.io"]
        ClusterRoles["ClusterRoles<br/>full CRUD"]
        ClusterRoleBindings["ClusterRoleBindings<br/>full CRUD"]
    end

    subgraph GatewayResources["gateway.networking.k8s.io"]
        HTTPRoutes["HTTPRoutes<br/>full CRUD"]
    end

    subgraph CoordinationResources["coordination.k8s.io"]
        Leases["Leases<br/>full CRUD (leader election)"]
    end

    CR --> MaasTenantConfig
    CR --> AITenant
    CR --> MaaSExternalModels
    CR --> MaaSExternalModelsFin
    CR --> InfExternalProviders
    CR --> InfExternalModels
    CR --> InfStatus
    CR --> InfFinalizers
    CR --> AIGuardrails
    CR --> Services
    CR --> ServiceAccounts2
    CR --> ConfigMaps
    CR --> Secrets
    CR --> Events
    CR --> Deployments
    CR --> NetworkPolicies
    CR --> EnvoyFilters
    CR --> DestinationRules
    CR --> ServiceEntries
    CR --> ClusterRoles
    CR --> ClusterRoleBindings
    CR --> HTTPRoutes
    CR --> Leases

