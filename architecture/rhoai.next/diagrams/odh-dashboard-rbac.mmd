graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Dashboard["odh-dashboard<br/>(broad K8s API permissions)"]
        SA_Modules["odh-dashboard-modules<br/>(restricted BFF permissions)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["odh-dashboard"]
        CRB_AuthDeleg["odh-dashboard-auth-delegator"]
        CRB_Monitoring["odh-dashboard-monitoring"]
        CRB_Modules["odh-dashboard-modules"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["odh-dashboard"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_Monitoring["cluster-monitoring-view"]
        CR_GenAI["odh-dashboard-gen-ai"]
        CR_Modules["odh-dashboard-modules"]
    end

    %% SA → CRB → CR bindings
    SA_Dashboard -->|"bound via"| CRB_Main
    SA_Dashboard -->|"bound via"| CRB_AuthDeleg
    SA_Dashboard -->|"bound via"| CRB_Monitoring
    SA_Modules -->|"bound via"| CRB_Modules

    CRB_Main -->|"grants"| CR_Main
    CRB_AuthDeleg -->|"grants"| CR_AuthDeleg
    CRB_Monitoring -->|"grants"| CR_Monitoring
    CRB_Modules -->|"grants"| CR_Modules

    subgraph MainResources["odh-dashboard ClusterRole Resources"]
        direction TB

        subgraph K8sCore["Core K8s"]
            Nodes["nodes<br/>get, list"]
            ConfigMaps["configmaps<br/>CRUD + watch"]
            PVCs["persistentvolumeclaims<br/>CRUD + watch"]
            Secrets["secrets<br/>CRUD + watch"]
        end

        subgraph OpenShiftAPIs["OpenShift APIs"]
            StorageClasses["storageclasses<br/>update, patch"]
            MachineAutoscalers["machineautoscalers<br/>machinesets<br/>get, list"]
            ClusterVersions["clusterversions<br/>ingresses<br/>get, watch, list"]
            CSVs["clusterserviceversions<br/>subscriptions<br/>get, list, watch"]
            Routes["routes<br/>get, list, watch"]
            UsersGroups["users, groups<br/>get, list, watch"]
        end

        subgraph RBACMgmt["RBAC Management"]
            RoleBindings["rolebindings<br/>clusterrolebindings<br/>roles<br/>list, get, create, patch, delete"]
        end

        subgraph ODHAPIs["ODH/RHOAI APIs"]
            Notebooks["notebooks (kubeflow.org)<br/>CRUD + watch"]
            DSCs["datascienceclusters<br/>dscinitializations<br/>list, watch, get"]
            InfSvc["inferenceservices<br/>(serving.kserve.io)<br/>get, list, watch"]
            ModelRegs["modelregistries<br/>(modelregistry.opendatahub.io)<br/>CRUD + watch"]
            FeatureStores["featurestores (feast.dev)<br/>get, list, watch"]
            MLflows["mlflows<br/>(mlflow.opendatahub.io)<br/>get, list, watch"]
            Auths["auths<br/>(services.platform.opendatahub.io)<br/>get"]
        end

        subgraph AuthAPIs["Auth APIs"]
            TokenReviews["tokenreviews<br/>create"]
            SubjectAccess["subjectaccessreviews<br/>create"]
        end
    end

    CR_Main -->|"permissions"| K8sCore
    CR_Main -->|"permissions"| OpenShiftAPIs
    CR_Main -->|"permissions"| RBACMgmt
    CR_Main -->|"permissions"| ODHAPIs
    CR_Main -->|"permissions"| AuthAPIs

    subgraph GenAIResources["odh-dashboard-gen-ai ClusterRole Resources"]
        OTelCollectors["opentelemetrycollectors<br/>get, list, create, update, delete"]
        GenAISecrets["secrets, services, pvc,<br/>configmaps<br/>create, get, update, delete"]
        Deployments["deployments<br/>create, get, update, delete"]
        NetPolicies["networkpolicies<br/>create, get, update, delete"]
    end

    CR_GenAI -->|"permissions"| GenAIResources

    subgraph AuthDelegResources["system:auth-delegator Resources"]
        AuthDelegOps["tokenreviews<br/>subjectaccessreviews<br/>create"]
    end

    CR_AuthDeleg -->|"permissions"| AuthDelegResources

    subgraph MonitoringResources["cluster-monitoring-view Resources"]
        MonitoringRead["monitoring resources<br/>get, list, watch"]
    end

    CR_Monitoring -->|"permissions"| MonitoringResources

    %% SA Token Isolation Note
    SANote["SA Token Isolation:<br/>Dashboard pod disables automountServiceAccountToken.<br/>Uses projected volumes to mount appropriate<br/>token per container (shell vs BFF modules)."]

    %% Styling
    classDef sa fill:#4a90e2,stroke:#333,color:#fff
    classDef crb fill:#f5a623,stroke:#333
    classDef cr fill:#e74c3c,stroke:#333,color:#fff
    classDef resource fill:#7ed321,stroke:#333
    classDef genai fill:#9b59b6,stroke:#333,color:#fff
    classDef note fill:#fff3cd,stroke:#ffc107,stroke-width:2px

    class SA_Dashboard,SA_Modules sa
    class CRB_Main,CRB_AuthDeleg,CRB_Monitoring,CRB_Modules crb
    class CR_Main,CR_AuthDeleg,CR_Monitoring,CR_GenAI,CR_Modules cr
    class Nodes,ConfigMaps,PVCs,Secrets,StorageClasses,MachineAutoscalers,ClusterVersions,CSVs,Routes,UsersGroups,RoleBindings,Notebooks,DSCs,InfSvc,ModelRegs,FeatureStores,MLflows,Auths,TokenReviews,SubjectAccess resource
    class OTelCollectors,GenAISecrets,Deployments,NetPolicies genai
    class AuthDelegOps,MonitoringRead resource
    class SANote note
