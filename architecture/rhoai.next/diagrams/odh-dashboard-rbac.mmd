graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Dashboard["rhods-dashboard<br/>NS: redhat-ods-applications"]
        SA_Operator["dashboard-operator<br/>NS: system"]
    end

    subgraph DashboardBindings["Dashboard Bindings"]
        CRB_Dashboard["rhods-dashboard<br/>(ClusterRoleBinding)"]
        CRB_AuthDelegator["odh-dashboard-auth-delegator<br/>(ClusterRoleBinding)"]
        CRB_Monitoring["odh-dashboard-cluster-monitoring<br/>(ClusterRoleBinding)"]
    end

    subgraph OperatorBindings["Operator Bindings"]
        CRB_Operator["dashboard-operator-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph AggregateBindings["Aggregate / User Bindings"]
        CRB_AgentSandbox["aggregate-agent-sandbox-permissions<br/>(ClusterRoleBinding)"]
        CRB_HardwareProfile["aggregate-hardware-profiles-permissions<br/>(ClusterRoleBinding)"]
        RB_ModelRegUI["fetch-model-registry-ui-config-binding<br/>(RoleBinding)"]
        RB_NIMAccess["nim-account-access-binding<br/>(RoleBinding)"]
    end

    subgraph DashboardRoles["Dashboard ClusterRoles"]
        CR_Dashboard["rhods-dashboard<br/>(ClusterRole)"]
        CR_AuthDelegator["system:auth-delegator<br/>(ClusterRole)"]
        CR_Monitoring["cluster-monitoring-view<br/>(ClusterRole)"]
    end

    subgraph OperatorRoles["Operator ClusterRole"]
        CR_Operator["dashboard-operator-role<br/>(ClusterRole, 61 rules)"]
    end

    subgraph AggregateRoles["Aggregate / User Roles"]
        CR_AgentSandbox["aggregate-agent-sandbox-permissions<br/>(ClusterRole)"]
        CR_HardwareProfile["aggregate-hardware-profiles-permissions<br/>(ClusterRole)"]
    end

    subgraph DashboardResources["Dashboard API Resources"]
        R_Core["core: configmaps, nodes"]
        R_OpenShift["config.openshift.io:<br/>clusterversions, ingresses, apiservers"]
        R_OLM["operators.coreos.com:<br/>CSVs, subscriptions"]
        R_Kubeflow["kubeflow.org: notebooks"]
        R_KServe["serving.kserve.io:<br/>inferenceservices, servingruntimes"]
        R_ModelReg["modelregistry.opendatahub.io:<br/>modelregistries"]
        R_Feast["feast.dev: featurestores"]
        R_MLflow["mlflow.opendatahub.io: mlflows"]
        R_Auth["authentication.k8s.io: tokenreviews<br/>authorization.k8s.io: subjectaccessreviews"]
    end

    subgraph OperatorResources["Operator API Resources"]
        R_Dashboard_CR["components.platform.opendatahub.io:<br/>dashboards, dashboards/status"]
        R_CoreOp["core: configmaps, secrets,<br/>services, serviceaccounts,<br/>namespaces, PVCs, events, pods, nodes"]
        R_Apps["apps: deployments, replicasets"]
        R_RBAC["rbac.authorization.k8s.io:<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        R_Gateway["gateway.networking.k8s.io:<br/>httproutes, gateways"]
        R_Network["networking.k8s.io:<br/>networkpolicies, ingresses"]
        R_CRDs["apiextensions.k8s.io:<br/>customresourcedefinitions"]
        R_Impersonate["Impersonate: groups,<br/>serviceaccounts, users"]
    end

    subgraph AgentResources["Aggregate Resources"]
        R_Sandboxes["agents.x-k8s.io: sandboxes"]
        R_HWProfiles["infrastructure.opendatahub.io:<br/>hardwareprofiles"]
    end

    %% Dashboard SA bindings
    SA_Dashboard -->|bound via| CRB_Dashboard
    SA_Dashboard -->|bound via| CRB_AuthDelegator
    SA_Dashboard -->|bound via| CRB_Monitoring
    CRB_Dashboard -->|grants| CR_Dashboard
    CRB_AuthDelegator -->|grants| CR_AuthDelegator
    CRB_Monitoring -->|grants| CR_Monitoring

    %% Dashboard role → resources
    CR_Dashboard -->|"get, list"| R_Core
    CR_Dashboard -->|"get, list, watch"| R_OpenShift
    CR_Dashboard -->|"get, list, watch"| R_OLM
    CR_Dashboard -->|"full CRUD"| R_Kubeflow
    CR_Dashboard -->|"full CRUD"| R_KServe
    CR_Dashboard -->|"full CRUD"| R_ModelReg
    CR_Dashboard -->|"get, list, watch"| R_Feast
    CR_Dashboard -->|"get, list, watch"| R_MLflow
    CR_Dashboard -->|"create"| R_Auth

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Operator
    CRB_Operator -->|grants| CR_Operator

    %% Operator role → resources
    CR_Operator -->|"full CRUD"| R_Dashboard_CR
    CR_Operator -->|"full CRUD"| R_CoreOp
    CR_Operator -->|"full CRUD"| R_Apps
    CR_Operator -->|"full CRUD"| R_RBAC
    CR_Operator -->|"full CRUD"| R_Gateway
    CR_Operator -->|"full CRUD"| R_Network
    CR_Operator -->|"create, get, list,<br/>patch, update, watch"| R_CRDs
    CR_Operator -->|"impersonate"| R_Impersonate

    %% Aggregate bindings
    CRB_AgentSandbox -->|grants| CR_AgentSandbox
    CRB_HardwareProfile -->|grants| CR_HardwareProfile
    CR_AgentSandbox -->|"get, list, patch"| R_Sandboxes
    CR_HardwareProfile -->|"get, list, watch"| R_HWProfiles

    %% Styling
    style SA_Dashboard fill:#4a90e2,stroke:#333,color:#fff
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style CR_Dashboard fill:#f5a623,stroke:#333,color:#fff
    style CR_Operator fill:#f5a623,stroke:#333,color:#fff
    style CR_AuthDelegator fill:#f5a623,stroke:#333,color:#fff
    style CR_Monitoring fill:#f5a623,stroke:#333,color:#fff
    style CR_AgentSandbox fill:#f5a623,stroke:#333,color:#fff
    style CR_HardwareProfile fill:#f5a623,stroke:#333,color:#fff
