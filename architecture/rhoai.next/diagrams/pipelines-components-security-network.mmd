graph TB
    subgraph PipelinePods["PIPELINE TASK PODS (Ephemeral KFP Tasks)"]
        direction TB

        subgraph InitNS["Namespace: {dspo-namespace}"]
            InitContainer["odh-pipelines-components<br/>(Init Container)<br/>Image: UBI9 Python 3.12<br/>No network services"]
        end

        subgraph PipelineNS["Namespace: {pipeline-namespace}"]
            AutoML["odh-automl<br/>AIPCC CPU Base<br/>Ephemeral task pod"]
            AutoRAG["odh-autorag<br/>AIPCC CPU Base<br/>Bundled Docling models<br/>Ephemeral task pod"]
        end
    end

    subgraph InternalPlatform["INTERNAL PLATFORM SERVICES"]
        direction TB
        KFPAPI["KFP API Server"]
        SharedPVC["Shared PVC<br/>/config/managed-pipelines/"]
        KServe["KServe InferenceService<br/>8080/TCP HTTP<br/>8443/TCP HTTPS<br/>Auth: None/Bearer"]
        ModelReg["Model Registry<br/>8080/TCP HTTP<br/>Auth: None"]
        Milvus["Milvus<br/>19530/TCP gRPC<br/>TLS optional<br/>Auth: Token optional"]
        MLflow["MLflow<br/>5000/TCP HTTP<br/>Auth: None"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB
        S3["S3 / MinIO<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS SigV4"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer optional"]
        OGX["OGX API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: API Key"]
        EvalHub["Eval Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer"]
    end

    %% Init Container flows (filesystem only)
    InitContainer -->|"Filesystem<br/>Shared PVC"| SharedPVC
    SharedPVC -->|"Filesystem<br/>Read compiled YAMLs"| KFPAPI

    %% Pipeline task egress - Internal
    AutoML -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    AutoRAG -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    AutoML -->|"HTTP/8080<br/>No TLS<br/>No Auth"| ModelReg
    AutoRAG -->|"gRPC/19530<br/>TLS optional<br/>Token optional"| Milvus
    AutoML -->|"HTTP/8080-8443<br/>TLS when available<br/>None/Bearer"| KServe
    AutoRAG -->|"HTTP/8080-8443<br/>TLS when available<br/>None/Bearer"| KServe
    AutoML -->|"HTTP/5000<br/>No TLS<br/>No Auth"| MLflow

    %% Pipeline task egress - External
    AutoML -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS SigV4"| S3
    AutoRAG -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS SigV4"| S3
    AutoML -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer optional"| HFHub
    AutoRAG -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| OGX
    AutoML -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer"| EvalHub

    %% Styling
    classDef pipeline fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#fff3cd,stroke:#d79b00,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef noauth fill:#ffcccc,stroke:#cc0000,stroke-width:1px

    class InitContainer,AutoML,AutoRAG pipeline
    class KFPAPI,SharedPVC,KServe,Milvus internal
    class ModelReg,MLflow noauth
    class K8sAPI k8s
    class S3,HFHub,OGX,EvalHub external
