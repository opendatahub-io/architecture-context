graph TB
    subgraph PipelinePod["PIPELINE POD (Ephemeral - per KFP step)"]
        direction TB

        subgraph InitContainer["Init Container"]
            Init["init-managed-pipelines<br/>Image: odh-pipelines-components<br/>SA: KFP-configured"]
        end

        subgraph StepContainers["Step Containers"]
            DataProc["Data Processing Steps<br/>Image: odh-autorag / odh-automl"]
            TrainingStep["Training Steps<br/>Image: odh-pipelines-components"]
            EvalStep["Evaluation Steps<br/>Image: odh-pipelines-components"]
            DeployStep["Deployment Steps<br/>Image: odh-pipelines-components"]
        end
    end

    subgraph SharedStorage["SHARED STORAGE"]
        WorkspacePVC["Workspace PVC<br/>(per-pipeline, ReadWriteMany)"]
        ManagedVolume["Managed Pipelines Volume<br/>/config/managed-pipelines"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (In-Cluster)"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS CA verified"]
        KFPServer["KFP API Server"]
        KServeCRDs["KServe CRDs<br/>ServingRuntime /<br/>InferenceService"]
        HWProfiles["ODH HardwareProfiles<br/>infrastructure.opendatahub.io/v1"]
        EvalHub["EvalHub API<br/>HTTPS configurable<br/>⚠️ verify_tls=False default"]
        ModelReg["Model Registry<br/>HTTPS"]
        MilvusDB["Milvus<br/>gRPC/HTTP configurable"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>Auth: HF_TOKEN"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS<br/>Auth: AWS_SECRET_ACCESS_KEY"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS<br/>Auth: Google auth"]
        LLM["LLM Inference<br/>HTTPS configurable<br/>TLS<br/>Auth: LLM_API_KEY"]
    end

    subgraph Operator["OPERATOR"]
        DSPO["DSPO<br/>Injects RELATED_IMAGE_*"]
    end

    %% Init container flows
    DSPO -->|"env var injection<br/>RELATED_IMAGE_*"| Init
    Init -->|"filesystem write<br/>compiled YAMLs"| ManagedVolume
    ManagedVolume -->|"filesystem read"| KFPServer

    %% Step container flows
    DeployStep -->|"HTTPS/443<br/>TLS CA verified<br/>Bearer token SA"| K8sAPI
    K8sAPI --> KServeCRDs
    K8sAPI --> HWProfiles
    EvalStep -->|"HTTPS configurable<br/>⚠️ TLS verify off<br/>Bearer token + X-Tenant"| EvalHub
    TrainingStep -->|"filesystem"| WorkspacePVC
    DataProc -->|"filesystem"| WorkspacePVC

    %% External egress
    DataProc -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HF
    DataProc -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    DataProc -->|"HTTPS/443<br/>TLS<br/>Google auth"| GCS
    DataProc -->|"gRPC/HTTP<br/>configurable"| MilvusDB
    TrainingStep -->|"HTTPS<br/>TLS<br/>LLM_API_KEY"| LLM
    EvalStep -->|"HTTPS<br/>TLS<br/>SA token"| ModelReg

    %% Styling
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#fff2cc,stroke:#d6b656,stroke-width:3px,stroke-dasharray: 5 5

    class Init,DataProc,TrainingStep,EvalStep,DeployStep pod
    class WorkspacePVC,ManagedVolume storage
    class K8sAPI,KFPServer,KServeCRDs,HWProfiles,ModelReg,MilvusDB platform
    class EvalHub warning
    class HF,S3,GCS,LLM external
    class DSPO operator
