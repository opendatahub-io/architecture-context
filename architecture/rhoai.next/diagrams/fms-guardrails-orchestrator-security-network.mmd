graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph Service["GUARDRAILS ORCHESTRATOR SERVICE"]
        direction TB

        subgraph GuardrailsServer["guardrails-server (ClusterIP)"]
            API["REST API Server<br/>Port 8033/TCP<br/>HTTP/HTTPS<br/>rustls + ring (NOT OpenSSL)<br/>mTLS: WebPkiClientVerifier"]
        end

        subgraph HealthSrv["health-server (ClusterIP)"]
            Health["Health/Info Server<br/>Port 8034/TCP<br/>HTTP plaintext<br/>No auth (open access)"]
        end
    end

    subgraph Backend["BACKEND SERVICES (Internal Cluster)"]
        direction TB

        TGIS["TGIS<br/>8033/TCP gRPC<br/>TLS/mTLS configurable<br/>Client cert auth"]
        CaikitNLP["Caikit NLP<br/>8085/TCP gRPC<br/>TLS/mTLS configurable<br/>Client cert auth"]
        Chunker["Caikit Chunker<br/>8085/TCP gRPC<br/>TLS/mTLS configurable<br/>Client cert auth"]
        Detectors["Detector Service(s)<br/>8080/TCP HTTP/HTTPS<br/>TLS/mTLS configurable<br/>Bearer token auth"]
        OpenAILLM["OpenAI-compatible LLM<br/>8080/TCP HTTP/HTTPS<br/>TLS/mTLS configurable<br/>Bearer token auth"]
    end

    subgraph Observability["OBSERVABILITY (Internal)"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC or 4318/TCP HTTP<br/>plaintext<br/>No auth"]
    end

    %% Inbound flows
    Client -->|"HTTP/HTTPS 8033/TCP<br/>TLS (optional)<br/>mTLS (optional)<br/>WebPkiClientVerifier"| API

    %% Outbound flows - gRPC backends
    API -->|"gRPC 8033/TCP<br/>TLS/mTLS<br/>Client cert<br/>3 retries + exp backoff"| TGIS
    API -->|"gRPC 8085/TCP<br/>TLS/mTLS<br/>Client cert<br/>3 retries + exp backoff"| CaikitNLP
    API -->|"gRPC 8085/TCP<br/>TLS/mTLS<br/>Client cert<br/>Unary + bidi-streaming"| Chunker

    %% Outbound flows - HTTP backends
    API -->|"HTTP/HTTPS 8080/TCP<br/>TLS/mTLS<br/>Bearer token (api_token)"| Detectors
    API -->|"HTTP/HTTPS 8080/TCP<br/>TLS/mTLS<br/>Bearer token (api_token)"| OpenAILLM

    %% Observability
    API -.->|"OTLP 4317/4318<br/>plaintext<br/>No auth"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class API,Health service
    class TGIS,CaikitNLP,Chunker,Detectors,OpenAILLM backend
    class OTel observability
