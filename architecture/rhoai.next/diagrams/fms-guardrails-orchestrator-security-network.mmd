graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph InternalServices["INTERNAL SERVICES"]
        direction TB

        subgraph OrchestratorPod["Orchestrator Pod (UID 1001, GID 0)"]
            direction TB
            GS["Guardrails Server<br/>8033/TCP HTTP/HTTPS<br/>TLS 1.2+ (rustls+ring, optional)<br/>mTLS via WebPkiClientVerifier (optional)"]
            HS["Health Server<br/>8034/TCP HTTP<br/>No TLS, No Auth"]
            HeaderRewrite["Header Passthrough<br/>X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
        end

        subgraph DownstreamGRPC["Downstream gRPC Services"]
            TGIS["TGIS Generation Service<br/>8033/TCP gRPC<br/>TLS: configurable<br/>Auth: None"]
            Chunker["Chunker Services<br/>8085/TCP gRPC<br/>TLS: optional (named TLS config)<br/>Auth: None"]
        end

        subgraph DownstreamREST["Downstream REST Services"]
            Detector["Detector Services<br/>8080/TCP HTTP/HTTPS<br/>TLS: optional (named TLS config)<br/>Auth: Bearer token (optional)"]
            DetectorHealth["Detector Health<br/>8081/TCP HTTP/HTTPS<br/>TLS: None<br/>Auth: None"]
            OpenAISvc["OpenAI-Compatible Service<br/>Port: Configurable<br/>TLS: optional<br/>Auth: Bearer token (optional)"]
        end
    end

    subgraph Observability["OBSERVABILITY"]
        OTLP["OTLP Collector<br/>Port: Configurable<br/>gRPC or HTTP<br/>TLS: Configurable"]
    end

    subgraph KubePlatform["KUBERNETES PLATFORM"]
        Kubelet["Kubelet"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8033/TCP<br/>TLS 1.2+ (optional)<br/>Passthrough Headers"| GS
    Kubelet -->|"HTTP 8034/TCP<br/>No TLS, No Auth"| HS

    GS -->|"gRPC 8033/TCP<br/>TLS configurable"| TGIS
    GS -->|"gRPC 8085/TCP<br/>TLS optional"| Chunker
    GS -->|"HTTP/HTTPS 8080/TCP<br/>TLS optional<br/>Bearer token optional"| Detector
    GS -->|"HTTP/HTTPS 8081/TCP<br/>No TLS"| DetectorHealth
    GS -->|"HTTP/HTTPS Configurable<br/>TLS optional<br/>Bearer token optional"| OpenAISvc
    GS -->|"gRPC/HTTP Configurable<br/>TLS configurable"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef orchestrator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef downstream fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class GS,HS,HeaderRewrite orchestrator
    class TGIS,Chunker,Detector,DetectorHealth,OpenAISvc downstream
    class OTLP observability
    class Kubelet platform
