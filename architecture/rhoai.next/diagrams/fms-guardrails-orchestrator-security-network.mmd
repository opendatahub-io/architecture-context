graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / AI Application"]
    end

    subgraph OrchestratorZone["ORCHESTRATOR SERVICE"]
        direction TB

        subgraph MainService["fms-guardrails-orchestr8 (Rust)"]
            GS["Guardrails Server<br/>8033/TCP HTTP/HTTPS<br/>rustls TLS 1.2+ (ring backend)<br/>mTLS supported<br/>⚠ ring NOT FIPS validated"]
            HS["Health Server<br/>8034/TCP HTTP<br/>No TLS, No Auth"]
        end
    end

    subgraph BackendServices["BACKEND SERVICES (Internal)"]
        direction TB

        subgraph DetectorZone["Detector Services"]
            Detectors["Detectors (HAP, Toxicity, PII)<br/>8080/TCP HTTP/HTTPS<br/>TLS configurable per-detector<br/>Bearer token + header passthrough"]
        end

        subgraph ChunkerZone["Chunker Services"]
            Chunker["Caikit Chunker Runtime<br/>8085/TCP gRPC<br/>TLS/mTLS configurable<br/>mm-model-id header"]
        end

        subgraph GenerationZone["Generation Services"]
            TGIS["TGIS<br/>8033/TCP gRPC<br/>TLS/mTLS configurable<br/>Header passthrough"]
            CaikitNLP["Caikit NLP<br/>8085/TCP gRPC<br/>TLS/mTLS configurable<br/>mm-model-id header"]
            OpenAILLM["OpenAI-compatible LLM (vLLM)<br/>8080/TCP HTTP/HTTPS + SSE<br/>TLS configurable<br/>Bearer token (api_token)"]
        end
    end

    subgraph Observability["OBSERVABILITY"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC or 4318/TCP HTTP<br/>Encryption configurable<br/>W3C traceparent propagation"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8033/TCP<br/>TLS optional (rustls/ring)<br/>Header passthrough<br/>X-Forwarded-Access-Token rewrite"| GS

    GS -->|"HTTP/HTTPS 8080/TCP<br/>TLS per-detector<br/>Bearer token + detector-id<br/>x-model-name header"| Detectors
    GS -->|"gRPC 8085/TCP<br/>TLS/mTLS configurable<br/>mm-model-id header"| Chunker
    GS -->|"gRPC 8033/TCP<br/>TLS/mTLS configurable<br/>Header passthrough"| TGIS
    GS -->|"gRPC 8085/TCP<br/>TLS/mTLS configurable<br/>mm-model-id header"| CaikitNLP
    GS -->|"HTTP/HTTPS 8080/TCP<br/>TLS configurable<br/>Bearer token (api_token)"| OpenAILLM
    GS -.->|"OTLP 4317/TCP gRPC<br/>or 4318/TCP HTTP<br/>Traces + Metrics"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef orchestrator fill:#4a90e2,stroke:#2c5282,stroke-width:2px,color:#fff
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef generation fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class GS,HS orchestrator
    class Detectors,Chunker backend
    class TGIS,CaikitNLP,OpenAILLM generation
    class OTLP observability
