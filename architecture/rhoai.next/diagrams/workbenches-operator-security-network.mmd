graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - Kubernetes Network)"]
        direction TB

        subgraph NS_Operator["Namespace: workbenches-operator-system"]
            direction TB
            OperatorPod["workbenches-operator Pod<br/>SA: controller-manager<br/>FIPS: strictfipsruntime"]

            subgraph Ports["Exposed Ports"]
                HealthProbe["8081/TCP HTTP<br/>/healthz, /readyz<br/>No auth"]
                Metrics["8443/TCP HTTPS<br/>/metrics<br/>TLS (cluster profile)<br/>Bearer token + RBAC"]
                WebhookPort["9443/TCP HTTPS<br/>/workbenches-hardware-profile<br/>/workbenches-connection-notebook<br/>TLS (service-CA)<br/>API server client cert"]
            end

            WebhookSvc["webhook-service (ClusterIP)<br/>443/TCP → 9443<br/>Cert: webhook-cert (auto-rotated)"]
        end

        subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
            OSAPIServer["OpenShift APIServer<br/>(config.openshift.io)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Reads: TLS security profile"]
        end

        subgraph PlatformComponents["PLATFORM COMPONENTS"]
            Orchestrator["Platform Orchestrator<br/>(rhods-operator /<br/>opendatahub-operator)"]
            ServiceCA["OpenShift Service-CA<br/>Controller<br/>Provisions webhook TLS cert"]
        end
    end

    %% Ingress flows (API server → webhook)
    K8sAPI -->|"HTTPS/9443<br/>TLS (service-CA)<br/>API server client cert<br/>Notebook create/update"| WebhookSvc
    WebhookSvc --> WebhookPort

    %% Egress flows (operator → API server)
    OperatorPod -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>Watch CRs, SSA Patch,<br/>SubjectAccessReview"| K8sAPI
    OperatorPod -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>Read TLS profile"| OSAPIServer

    %% Platform interactions
    Orchestrator -->|"Creates Workbenches CR<br/>Manages ConfigMap"| K8sAPI
    ServiceCA -->|"Provisions + rotates<br/>webhook TLS cert"| NS_Operator

    %% No external egress
    NoExternal["No External Egress<br/>(all traffic within cluster)"]

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    classDef port fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef noexternal fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class OperatorPod operator
    class HealthProbe,Metrics,WebhookPort port
    class K8sAPI,OSAPIServer controlplane
    class Orchestrator,ServiceCA platform
    class WebhookSvc service
    class NoExternal noexternal
