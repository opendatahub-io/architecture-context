graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>redhat-ods-applications"]
        direction TB

        subgraph OperatorPod["Workbenches Operator Pod<br/>SA: controller-manager<br/>FIPS: strictfipsruntime + OpenSSL"]
            direction TB

            Reconciler["WorkbenchesReconciler<br/>SSA Field Manager"]
            KrustyRenderer["Krusty Manifest Renderer<br/>/opt/manifests"]

            subgraph WebhookServer["Webhook Server :9443/TCP<br/>TLS auto-detected"]
                HWWH["Hardware Profile Webhook<br/>POST /workbenches-hardware-profile<br/>FailurePolicy: Fail"]
                ConnWH["Connection Notebook Webhook<br/>POST /workbenches-connection-notebook<br/>FailurePolicy: Fail"]
                ConvWH["Conversion Webhook<br/>POST /convert"]
            end

            subgraph MgmtEndpoints["Management Endpoints"]
                HealthReady["Health + Ready<br/>:8081/TCP HTTP<br/>No Auth"]
                MetricsEP["Metrics<br/>:8443/TCP HTTPS<br/>TLS 1.2+ cluster profile<br/>TokenReview + SAR"]
            end
        end

        WebhookSvc["webhook-service<br/>ClusterIP 443/TCP → 9443"]
    end

    subgraph OperandNS["MANAGED OPERANDS<br/>applications namespace"]
        KFController["Kubeflow Notebook Controller"]
        ODHController["ODH Notebook Controller"]
        NotebookManifests["Notebook Manifests<br/>ODH / RHOAI overlays"]
    end

    subgraph PlatformSvcs["PLATFORM SERVICES"]
        Prometheus["Prometheus Operator<br/>ServiceMonitor"]
        CertManager["cert-manager<br/>ClusterIssuer + Certificate"]
        OSAPIServer["OpenShift APIServer<br/>TLS Security Profile"]
        Kueue["Kueue<br/>Queue Scheduling"]
    end

    %% Flows
    K8sAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Watch + CRUD<br/>SA token"| Reconciler
    Reconciler -->|"HTTPS/6443<br/>TLS 1.2+<br/>SSA Apply<br/>SA token"| K8sAPI
    K8sAPI -->|"HTTPS/443<br/>TLS auto-detected<br/>Admission webhook call<br/>API server cert"| WebhookSvc
    WebhookSvc -->|":9443 forward"| WebhookServer
    HWWH -->|"HTTPS/6443<br/>Read HardwareProfile"| K8sAPI
    ConnWH -->|"HTTPS/6443<br/>Read Secrets + SAR"| K8sAPI
    Reconciler -->|"SSA deploy"| OperandNS
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>TokenReview + SAR"| MetricsEP
    CertManager -.->|"webhook TLS cert<br/>when detected"| WebhookServer
    OSAPIServer -.->|"TLS profile<br/>cipher/version config"| OperatorPod
    HWWH -.->|"Kueue queue label<br/>injection"| Kueue

    %% Styling
    classDef k8s fill:#e8e8e8,stroke:#666,stroke-width:2px,color:#333
    classDef operator fill:#4a90e2,stroke:#2a6cba,stroke-width:2px,color:#fff
    classDef webhook fill:#d5574c,stroke:#b33a30,stroke-width:2px,color:#fff
    classDef operand fill:#7ed321,stroke:#5ca318,stroke-width:2px,color:#fff
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#333
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,color:#333
    classDef mgmt fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#333

    class K8sAPI k8s
    class Reconciler,KrustyRenderer operator
    class HWWH,ConnWH,ConvWH webhook
    class KFController,ODHController,NotebookManifests operand
    class Prometheus,CertManager,OSAPIServer,Kueue platform
    class WebhookSvc service
    class HealthReady,MetricsEP mgmt
