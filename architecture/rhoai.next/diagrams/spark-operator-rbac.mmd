graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["spark-operator-controller<br/>(redhat-ods-applications)"]
        SA_Webhook["spark-operator-webhook<br/>(redhat-ods-applications)"]
        SA_Spark["spark-operator-spark<br/>(application namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Controller["spark-operator-controller<br/>(ClusterRoleBinding)"]
        CRB_Webhook["spark-operator-webhook<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (per app namespace)"]
        RB_Spark["spark-role-binding<br/>(RoleBinding)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Controller["spark-operator-controller<br/>(ClusterRole)"]
        CR_Webhook["spark-operator-webhook<br/>(ClusterRole)"]
    end

    subgraph Roles["Roles (per app namespace)"]
        R_Spark["spark-role<br/>(Role)"]
    end

    subgraph ControllerResources["Controller API Resources"]
        SA_CRDs["sparkoperator.k8s.io<br/>sparkapplications<br/>scheduledsparkapplications<br/>sparkconnects<br/><i>+ status, finalizers</i>"]
        SA_Core["core (&quot;&quot;)<br/>pods, services,<br/>configmaps, events"]
        SA_Net["extensions, networking.k8s.io<br/>ingresses"]
        SA_Policy["policy<br/>poddisruptionbudgets"]
        SA_APIExt["apiextensions.k8s.io<br/>customresourcedefinitions"]
        SA_OpenShift["config.openshift.io<br/>apiservers (cluster)"]
        SA_NetPol["networking.k8s.io<br/>networkpolicies<br/><i>(RHOAI patch)</i>"]
    end

    subgraph SparkResources["Spark Driver Resources (per namespace)"]
        Spark_Pods["core (&quot;&quot;)<br/>pods<br/><i>create, manage executors</i>"]
    end

    %% Service Account → Binding
    SA_Controller -->|"bound via"| CRB_Controller
    SA_Webhook -->|"bound via"| CRB_Webhook
    SA_Spark -->|"bound via"| RB_Spark

    %% Binding → Role
    CRB_Controller -->|"grants"| CR_Controller
    CRB_Webhook -->|"grants"| CR_Webhook
    RB_Spark -->|"grants"| R_Spark

    %% Role → Resources
    CR_Controller -->|"create, delete, get,<br/>list, watch"| SA_CRDs
    CR_Controller -->|"create, delete, get,<br/>list, update, watch"| SA_Core
    CR_Controller -->|"create, delete,<br/>get, update"| SA_Net
    CR_Controller -->|"create, delete, get,<br/>list, watch"| SA_Policy
    CR_Controller -->|"get"| SA_APIExt
    CR_Controller -->|"get"| SA_OpenShift
    CR_Controller -->|"create, delete,<br/>update"| SA_NetPol

    R_Spark -->|"create, delete, get,<br/>list, watch"| Spark_Pods

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_Webhook fill:#4a90e2,color:#fff
    style SA_Spark fill:#4a90e2,color:#fff
    style CRB_Controller fill:#9b59b6,color:#fff
    style CRB_Webhook fill:#9b59b6,color:#fff
    style RB_Spark fill:#9b59b6,color:#fff
    style CR_Controller fill:#f5a623,color:#fff
    style CR_Webhook fill:#f5a623,color:#fff
    style R_Spark fill:#f5a623,color:#fff
    style SA_CRDs fill:#7ed321,color:#fff
    style SA_Core fill:#7ed321,color:#fff
    style SA_Net fill:#7ed321,color:#fff
    style SA_Policy fill:#7ed321,color:#fff
    style SA_APIExt fill:#7ed321,color:#fff
    style SA_OpenShift fill:#7ed321,color:#fff
    style SA_NetPol fill:#7ed321,color:#fff,stroke-dasharray:5
    style Spark_Pods fill:#7ed321,color:#fff
