graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["spark-operator-controller"]
        SA_Webhook["spark-operator-webhook"]
        SA_Module["spark-operator-module-controller-manager"]
        SA_Spark["spark-operator-spark"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Controller["spark-operator-controller<br/>(ClusterRoleBinding)"]
        CRB_TLS_C["spark-operator-tls-profile<br/>(ClusterRoleBinding - controller)"]
        CRB_TLS_W["spark-operator-tls-profile<br/>(ClusterRoleBinding - webhook)"]
        CRB_Webhook["spark-operator-webhook<br/>(ClusterRoleBinding)"]
        CRB_Module["spark-operator-module-manager-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_CtrlSys["spark-operator-controller<br/>(RoleBinding, ns: system)"]
        RB_WebSys["spark-operator-webhook<br/>(RoleBinding, ns: system)"]
        RB_Spark["spark-role-binding<br/>(RoleBinding, ns: redhat-ods-applications)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Controller["spark-operator-controller"]
        CR_TLS["spark-operator-tls-profile"]
        CR_Webhook["spark-operator-webhook"]
        CR_Module["spark-operator-module-manager-role"]
        CR_AppEditor["sparkapplication-editor-role"]
        CR_AppViewer["sparkapplication-viewer-role"]
        CR_SchedEditor["scheduledsparkapplication-editor-role"]
        CR_SchedViewer["scheduledsparkapplication-viewer-role"]
    end

    subgraph ControllerResources["Controller Resources"]
        R_ConfigMaps["(core) configmaps<br/>create,get,list,patch,update,watch"]
        R_Events["(core) events<br/>create,patch,update"]
        R_Pods["(core) pods<br/>create,delete,get,list,update,watch"]
        R_Services["(core) services<br/>create,delete,get,list,patch,update,watch"]
        R_SparkApps["sparkoperator.k8s.io<br/>sparkapplications<br/>create,delete,get,list,watch"]
        R_SchedApps["sparkoperator.k8s.io<br/>scheduledsparkapplications<br/>get,list,watch"]
        R_Connects["sparkoperator.k8s.io<br/>sparkconnects<br/>get,list,watch"]
        R_NetPol["networking.k8s.io<br/>networkpolicies<br/>create,delete,update"]
        R_PDB["policy poddisruptionbudgets<br/>create,delete,get,list,watch"]
        R_Ingress["networking.k8s.io ingresses<br/>create,delete,get,update"]
    end

    subgraph WebhookResources["Webhook Resources"]
        R_WHConfig["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations<br/>get,list,update,watch"]
        R_WHSparkApps["sparkoperator.k8s.io<br/>sparkapplications,scheduledsparkapps<br/>get,list,watch"]
        R_Quotas["(core) resourcequotas<br/>list"]
        R_WHPods["(core) pods<br/>list,watch"]
    end

    subgraph ModuleResources["Module Manager Resources"]
        R_SparkOperator["components.platform.opendatahub.io<br/>sparkoperators + status/finalizers<br/>get,list,patch,update,watch"]
        R_Deployments["apps deployments<br/>full CRUD"]
        R_CRDs["apiextensions.k8s.io CRDs<br/>create,get,list,patch,update,watch"]
        R_RBAC["rbac.authorization.k8s.io<br/>clusterroles,bindings,roles<br/>full CRUD + bind,escalate"]
        R_Certs["cert-manager.io<br/>certificates,issuers<br/>full CRUD"]
        R_PodMon["monitoring.coreos.com<br/>podmonitors<br/>full CRUD"]
    end

    subgraph TLSResources["TLS Profile Resources"]
        R_APIServers["config.openshift.io<br/>apiservers<br/>get,list,watch"]
    end

    %% SA → Binding → Role → Resources
    SA_Controller -->|bound via| CRB_Controller
    SA_Controller -->|bound via| CRB_TLS_C
    CRB_Controller -->|grants| CR_Controller
    CRB_TLS_C -->|grants| CR_TLS
    CR_Controller -->|accesses| R_ConfigMaps
    CR_Controller -->|accesses| R_Events
    CR_Controller -->|accesses| R_Pods
    CR_Controller -->|accesses| R_Services
    CR_Controller -->|accesses| R_SparkApps
    CR_Controller -->|accesses| R_SchedApps
    CR_Controller -->|accesses| R_Connects
    CR_Controller -->|accesses| R_NetPol
    CR_Controller -->|accesses| R_PDB
    CR_Controller -->|accesses| R_Ingress

    SA_Webhook -->|bound via| CRB_Webhook
    SA_Webhook -->|bound via| CRB_TLS_W
    CRB_Webhook -->|grants| CR_Webhook
    CRB_TLS_W -->|grants| CR_TLS
    CR_Webhook -->|accesses| R_WHConfig
    CR_Webhook -->|accesses| R_WHSparkApps
    CR_Webhook -->|accesses| R_Quotas
    CR_Webhook -->|accesses| R_WHPods

    CR_TLS -->|accesses| R_APIServers

    SA_Module -->|bound via| CRB_Module
    CRB_Module -->|grants| CR_Module
    CR_Module -->|accesses| R_SparkOperator
    CR_Module -->|accesses| R_Deployments
    CR_Module -->|accesses| R_CRDs
    CR_Module -->|accesses| R_RBAC
    CR_Module -->|accesses| R_Certs
    CR_Module -->|accesses| R_PodMon

    SA_Spark -->|bound via| RB_Spark

