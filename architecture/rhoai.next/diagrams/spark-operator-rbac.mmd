graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["spark-operator-controller<br/>(operator namespace)"]
        SA_Webhook["spark-operator-webhook<br/>(operator namespace)"]
        SA_Spark["spark-operator-spark<br/>(operator namespace)"]
    end

    subgraph ControllerBindings["Controller Bindings"]
        CRB_Controller["spark-operator-controller<br/>ClusterRoleBinding"]
        RB_Controller["spark-operator-controller<br/>RoleBinding (namespace)"]
    end

    subgraph WebhookBindings["Webhook Bindings"]
        CRB_Webhook["spark-operator-webhook<br/>ClusterRoleBinding"]
        RB_Webhook["spark-operator-webhook<br/>RoleBinding (namespace)"]
    end

    subgraph SparkBindings["Spark Pod Bindings"]
        RB_Spark["spark-operator-spark<br/>RoleBinding (namespace)"]
    end

    subgraph ControllerClusterRole["ClusterRole: spark-operator-controller"]
        direction LR
        CR_Core["core<br/>pods, configmaps,<br/>services, events<br/>get,list,watch,<br/>create,update,<br/>patch,delete"]
        CR_Net["networking.k8s.io<br/>ingresses,<br/>networkpolicies<br/>get,create,<br/>update,delete"]
        CR_Spark["sparkoperator.k8s.io<br/>sparkapplications,<br/>scheduledsparkapplications,<br/>sparkconnects<br/>get,list,watch,<br/>create,update,delete"]
        CR_SparkStatus["sparkoperator.k8s.io<br/>*/status, */finalizers<br/>update,patch"]
        CR_Policy["policy<br/>poddisruptionbudgets<br/>get,list,watch,<br/>create,delete"]
        CR_OpenShift["config.openshift.io<br/>apiservers (cluster)<br/>get"]
        CR_CRD["apiextensions.k8s.io<br/>customresourcedefinitions<br/>get"]
    end

    subgraph WebhookClusterRole["ClusterRole: spark-operator-webhook"]
        direction LR
        WR_Core["core<br/>resourcequotas,<br/>pods<br/>list,watch"]
        WR_Admission["admissionregistration<br/>mutatingwebhookconfigurations,<br/>validatingwebhookconfigurations<br/>get,list,watch,update"]
        WR_Spark["sparkoperator.k8s.io<br/>sparkapplications,<br/>scheduledsparkapplications<br/>get,list,watch"]
        WR_OpenShift["config.openshift.io<br/>apiservers (cluster)<br/>get"]
    end

    subgraph SparkRole["Role: spark-role (namespace)"]
        SR_Perms["core<br/>pods, services,<br/>configmaps<br/>get,list,watch,<br/>create,update,delete"]
    end

    %% Controller bindings
    SA_Controller -->|bound via| CRB_Controller
    SA_Controller -->|bound via| RB_Controller
    CRB_Controller -->|grants| ControllerClusterRole
    RB_Controller -->|grants| ControllerClusterRole

    %% Webhook bindings
    SA_Webhook -->|bound via| CRB_Webhook
    SA_Webhook -->|bound via| RB_Webhook
    CRB_Webhook -->|grants| WebhookClusterRole
    RB_Webhook -->|grants| WebhookClusterRole

    %% Spark bindings
    SA_Spark -->|bound via| RB_Spark
    RB_Spark -->|grants| SparkRole

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Webhook fill:#4a90e2,stroke:#333,color:#fff
    style SA_Spark fill:#4a90e2,stroke:#333,color:#fff

    style CRB_Controller fill:#e8e8e8,stroke:#333
    style RB_Controller fill:#e8e8e8,stroke:#333
    style CRB_Webhook fill:#e8e8e8,stroke:#333
    style RB_Webhook fill:#e8e8e8,stroke:#333
    style RB_Spark fill:#e8e8e8,stroke:#333

    style CR_Core fill:#7ed321,stroke:#333
    style CR_Net fill:#7ed321,stroke:#333
    style CR_Spark fill:#7ed321,stroke:#333
    style CR_SparkStatus fill:#7ed321,stroke:#333
    style CR_Policy fill:#7ed321,stroke:#333
    style CR_OpenShift fill:#7ed321,stroke:#333
    style CR_CRD fill:#7ed321,stroke:#333

    style WR_Core fill:#f5a623,stroke:#333
    style WR_Admission fill:#f5a623,stroke:#333
    style WR_Spark fill:#f5a623,stroke:#333
    style WR_OpenShift fill:#f5a623,stroke:#333

    style SR_Perms fill:#9b59b6,stroke:#333,color:#fff
