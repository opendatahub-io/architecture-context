graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AppLayer["APPLICATION LAYER (OGX Server :8321)"]
        direction TB

        subgraph Middleware["ASGI Middleware Stack"]
            AuthMW["AuthenticationMiddleware<br/>Bearer Token Extraction<br/>OAuth2 JWT/JWKS | Introspection | Custom"]
            QuotaMW["QuotaMiddleware<br/>Per-client rate limiting<br/>Auth vs Anon thresholds"]
        end

        subgraph Security["Security Enforcement"]
            ABACEngine["ABAC Engine<br/>Permit/Forbid rules<br/>Roles, Teams, Projects, Namespaces"]
        end

        subgraph Routing["Routing Table"]
            RouteTable["Resource → Provider mapping<br/>19 API domains<br/>Inline + Remote providers"]
        end

        subgraph InlineProvs["Inline Providers (in-process)"]
            MetaRef["meta-reference inference"]
            SQLiteVec["SQLite-vec vector store"]
            FaissVec["Faiss vector store"]
            SQLiteKV["SQLite KV store"]
        end
    end

    subgraph AuthServices["AUTH SERVICES"]
        JWKS["JWKS Endpoint<br/>443/TCP HTTPS<br/>TLS, configurable CA"]
        Introspect["OAuth2 Introspection<br/>443/TCP HTTPS<br/>TLS, client credentials"]
        CustomAuth["Custom Auth Endpoint<br/>Configured port HTTPS"]
    end

    subgraph InferenceBackends["INFERENCE BACKENDS"]
        VLLM["vLLM<br/>Configured port HTTPS<br/>TLS, API key<br/>Configurable verify + CA"]
        TGI["TGI<br/>Configured port HTTPS<br/>TLS, API key"]
        OpenAI["OpenAI API<br/>Configured port HTTPS<br/>TLS, API key"]
        CloudAI["Fireworks / Together /<br/>Cerebras / SambaNova /<br/>NVIDIA / WatsonX<br/>HTTPS, API key"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Tavily["api.tavily.com<br/>443/TCP HTTPS<br/>TLS, API key"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS, HF token"]
        MCPServers["MCP Servers<br/>Configured port<br/>HTTP/SSE"]
    end

    subgraph DataStores["DATA STORES"]
        RemoteVec["Remote Vector Stores<br/>Chroma / Milvus / PgVector /<br/>Qdrant / Weaviate<br/>TLS varies"]
        RemoteKV["Remote KV Stores<br/>PostgreSQL / Redis / MongoDB<br/>TLS varies"]
    end

    %% Client to server
    Client -->|"HTTP(S)/8321<br/>Optional TLS<br/>Bearer token"| AuthMW

    %% Auth middleware to auth services
    AuthMW -.->|"HTTPS/443<br/>TLS"| JWKS
    AuthMW -.->|"HTTPS/443<br/>TLS, client creds"| Introspect
    AuthMW -.->|"HTTPS<br/>TLS"| CustomAuth

    %% Middleware chain
    AuthMW --> QuotaMW
    QuotaMW --> ABACEngine
    ABACEngine --> RouteTable

    %% Routing to providers
    RouteTable --> InlineProvs
    RouteTable -->|"HTTPS<br/>TLS, API key"| VLLM
    RouteTable -->|"HTTPS<br/>TLS, API key"| TGI
    RouteTable -->|"HTTPS<br/>TLS, API key"| OpenAI
    RouteTable -->|"HTTPS<br/>TLS, API key"| CloudAI

    %% Tool and external service access
    RouteTable -->|"HTTPS/443<br/>TLS, API key"| Tavily
    RouteTable -->|"HTTPS/443<br/>TLS, HF token"| HFHub
    RouteTable -->|"HTTP/SSE"| MCPServers

    %% Data store access
    RouteTable -->|"TLS varies"| RemoteVec
    RouteTable -->|"TLS varies"| RemoteKV

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef applayer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef authservice fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef inference fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef datastore fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class AuthMW,QuotaMW,ABACEngine,RouteTable,MetaRef,SQLiteVec,FaissVec,SQLiteKV applayer
    class JWKS,Introspect,CustomAuth authservice
    class VLLM,TGI,OpenAI,CloudAI inference
    class Tavily,HFHub,MCPServers extservice
    class RemoteVec,RemoteKV datastore
