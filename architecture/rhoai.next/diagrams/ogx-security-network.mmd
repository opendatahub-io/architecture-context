graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(SDK / curl / OpenAI client)"]
        StreamlitUser["Browser User"]
    end

    subgraph Ingress["INGRESS (OGX Server Boundary)"]
        direction TB
        ServerPort["Llama Stack Server<br/>8321/TCP<br/>HTTP or HTTPS (Configurable TLS 1.2+)<br/>mTLS support (ssl.CERT_REQUIRED)"]
        UIPort["Streamlit UI<br/>8501/TCP<br/>HTTP (no TLS)"]
    end

    subgraph AuthStack["AUTHENTICATION & AUTHORIZATION STACK"]
        direction TB
        AuthMW["AuthenticationMiddleware<br/>Bearer Token extraction<br/>OAuth2 JWT / Custom provider"]
        QuotaMW["QuotaMiddleware<br/>100 req/day anon<br/>1000 req/day auth (configurable)"]
        AccessControl["Access Control Engine<br/>Cedar-inspired ABAC<br/>principal + resource + attributes"]
    end

    subgraph RoutingLayer["ROUTING & PROVIDER LAYER"]
        direction TB
        RoutingTable["CommonRoutingTableImpl<br/>Resource → Provider mapping<br/>ABAC checks on every lookup"]
        InlineP["Inline Providers<br/>(in-process)"]
        RemoteP["Remote Providers<br/>(outbound HTTP/HTTPS)"]
    end

    subgraph LocalStorage["LOCAL STORAGE"]
        SQLite["SQLite<br/>Local file<br/>No encryption<br/>KV store, inference store,<br/>vector store (sqlite-vec)"]
    end

    subgraph DatabaseBackends["DATABASE BACKENDS"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL wire protocol<br/>TLS optional<br/>Password/certificate auth"]
        Redis["Redis<br/>6379/TCP<br/>Redis protocol<br/>TLS optional<br/>Password auth"]
        MongoDB["MongoDB<br/>27017/TCP<br/>MongoDB protocol<br/>TLS optional<br/>Password/certificate auth"]
    end

    subgraph VectorDBs["VECTOR DATABASE BACKENDS"]
        Chroma["Chroma<br/>Configurable port<br/>HTTP<br/>TLS configurable<br/>Bearer Token optional"]
        Milvus["Milvus<br/>19530/TCP<br/>gRPC/HTTP<br/>TLS optional<br/>Token optional"]
        Qdrant["Qdrant<br/>6333/TCP<br/>HTTP/gRPC<br/>TLS optional<br/>Bearer Token optional"]
        Weaviate["Weaviate<br/>8080/TCP<br/>HTTP<br/>TLS optional<br/>Bearer Token optional"]
    end

    subgraph InferenceProviders["EXTERNAL INFERENCE PROVIDERS"]
        OpenAI["OpenAI API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        Anthropic["Anthropic API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
        Gemini["Google Gemini<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        NVIDIA["NVIDIA NIM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        WatsonX["IBM WatsonX<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        OtherLLMs["Groq / Together / Fireworks /<br/>Cerebras / SambaNova /<br/>Databricks / RunPod<br/>443/TCP HTTPS TLS 1.2+<br/>Bearer Token (API key)"]
    end

    subgraph LocalInference["LOCAL INFERENCE BACKENDS"]
        vLLM["vLLM<br/>Configurable port<br/>HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token optional"]
        Ollama["Ollama<br/>11434/TCP<br/>HTTP (no TLS)<br/>No auth"]
        TGI["TGI<br/>Configurable port<br/>HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token optional"]
    end

    subgraph AuthServices["AUTHENTICATION SERVICES"]
        JWKS["OAuth2/JWKS Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>JWKS key retrieval"]
        CustomAuth["Custom Auth Endpoint<br/>Configurable port<br/>HTTPS configurable<br/>Bearer Token forwarding"]
    end

    subgraph ToolServices["TOOL RUNTIME SERVICES"]
        SearchAPIs["Bing / Brave / Tavily<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        Wolfram["Wolfram Alpha<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (API key)"]
        MCP["MCP Servers<br/>Configurable port<br/>HTTP/HTTPS configurable<br/>Auth configurable"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTEL["OTEL Collector<br/>Configurable port<br/>HTTP (OTLP)<br/>TLS configurable"]
    end

    subgraph ModelRegistry["MODEL REGISTRY"]
        HuggingFace["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (HF token)"]
    end

    %% Client flows
    Client -->|"HTTP/HTTPS 8321/TCP<br/>Configurable TLS 1.2+<br/>Bearer Token (optional)"| ServerPort
    StreamlitUser -->|"HTTP 8501/TCP<br/>No TLS<br/>No auth"| UIPort
    UIPort -->|"HTTP<br/>Internal API calls"| ServerPort

    %% Auth stack
    ServerPort --> AuthMW
    AuthMW -->|"HTTPS/443<br/>TLS 1.2+"| JWKS
    AuthMW -->|"HTTPS configurable<br/>Bearer Token"| CustomAuth
    AuthMW --> QuotaMW
    QuotaMW --> AccessControl
    AccessControl --> RoutingTable

    %% Provider routing
    RoutingTable --> InlineP
    RoutingTable --> RemoteP

    %% Remote provider egress
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| OpenAI
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Anthropic
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| Bedrock
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Gemini
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| NVIDIA
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| WatsonX
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| OtherLLMs

    %% Local inference
    RemoteP -->|"HTTP/HTTPS configurable<br/>Bearer Token optional"| vLLM
    RemoteP -->|"HTTP/11434<br/>No TLS, No auth"| Ollama
    RemoteP -->|"HTTP/HTTPS configurable<br/>Bearer Token optional"| TGI

    %% Storage
    InlineP --> SQLite
    RemoteP -->|"5432/TCP<br/>TLS optional<br/>Password/cert"| PostgreSQL
    QuotaMW -->|"6379/TCP<br/>TLS optional<br/>Password"| Redis
    RemoteP -->|"27017/TCP<br/>TLS optional<br/>Password/cert"| MongoDB

    %% Vector DBs
    RemoteP -->|"HTTP configurable<br/>Bearer Token optional"| Chroma
    RemoteP -->|"gRPC 19530/TCP<br/>TLS optional"| Milvus
    RemoteP -->|"HTTP/gRPC 6333/TCP<br/>TLS optional"| Qdrant
    RemoteP -->|"HTTP 8080/TCP<br/>TLS optional"| Weaviate

    %% Tool services
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| SearchAPIs
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Wolfram
    RemoteP -->|"HTTP/HTTPS configurable"| MCP

    %% Observability
    ServerPort -->|"HTTP OTLP<br/>TLS configurable"| OTEL

    %% Model download
    InlineP -->|"HTTPS/443<br/>TLS 1.2+<br/>HF token"| HuggingFace

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f5a623,stroke:#d79b00,stroke-width:2px
    classDef routing fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef danger fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client,StreamlitUser external
    class ServerPort,UIPort ingress
    class AuthMW,QuotaMW,AccessControl auth
    class RoutingTable,InlineP,RemoteP routing
    class SQLite,PostgreSQL,Redis,MongoDB storage
    class Chroma,Milvus,Qdrant,Weaviate storage
    class OpenAI,Anthropic,Bedrock,Gemini,NVIDIA,WatsonX,OtherLLMs externalservice
    class vLLM,TGI externalservice
    class Ollama danger
    class JWKS,CustomAuth externalservice
    class SearchAPIs,Wolfram,MCP externalservice
    class OTEL externalservice
    class HuggingFace externalservice
