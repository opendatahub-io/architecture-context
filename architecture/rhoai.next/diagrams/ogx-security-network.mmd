graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / SDK"]
    end

    subgraph AppBoundary["APPLICATION BOUNDARY (OGX Llama Stack Server)"]
        direction TB

        subgraph AuthLayer["Authentication Layer (OPTIONAL)"]
            AuthMW["Auth Middleware<br/>JWT via JWKS / OAuth2 Introspection / Custom<br/>Crypto: python-jose (NOT FIPS-validated)"]
            ACL["Cedar-like Access Control<br/>Permit/Forbid rules<br/>Resource ownership tracking"]
            Quota["Quota Middleware<br/>Anon: 100/day | Auth: 1000/day"]
        end

        subgraph ServerCore["FastAPI/Uvicorn — Port 8321/TCP"]
            API["API Endpoints<br/>11 API types, 40+ routes"]
            HealthEndpoints["/v1/health, /v1/version<br/>/v1/inspect/routes<br/>(NO AUTH REQUIRED)"]
        end

        subgraph Providers["Provider Plugin System"]
            InlineP["Inline Providers<br/>(in-process: FAISS, SQLite-vec)"]
            RemoteP["Remote Providers<br/>(external service calls)"]
        end

        subgraph StorageLayer["Storage"]
            KV["KV Store<br/>SQLite / Redis / PostgreSQL / MongoDB"]
            SQL["SQL Store<br/>SQLite / PostgreSQL"]
        end
    end

    subgraph AuthServices["AUTH SERVICES (Egress)"]
        OIDC["OIDC/OAuth2 Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
        Introspect["OAuth2 Introspection<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Basic Auth"]
        CustomAuth["Custom Auth Endpoint<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph InferenceServices["INFERENCE PROVIDERS (Egress)"]
        Ollama["Ollama<br/>11434/TCP HTTP<br/>No TLS (local)"]
        vLLM["vLLM Server<br/>8000/TCP HTTP/HTTPS<br/>TLS (configurable)<br/>API Key"]
        TGI["TGI<br/>8080/TCP HTTP/HTTPS<br/>TLS (configurable)<br/>API Key"]
        CloudLLM["Cloud APIs<br/>(OpenAI/Anthropic/Bedrock/NIM)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key / IAM"]
    end

    subgraph VectorServices["VECTOR DATABASES (Egress)"]
        Chroma["ChromaDB<br/>8000/TCP HTTP"]
        Qdrant["Qdrant<br/>6333-6334/TCP<br/>HTTP/gRPC<br/>TLS (configurable)"]
        Milvus["Milvus<br/>19530/TCP gRPC<br/>TLS (configurable)"]
    end

    subgraph DataStores["DATA STORES (Egress)"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (configurable)<br/>Password Auth"]
        Redis["Redis<br/>6379/TCP<br/>TLS (configurable)<br/>Password (optional)"]
        MongoDB["MongoDB<br/>27017/TCP<br/>TLS (configurable)<br/>Password Auth"]
    end

    subgraph ToolServices["TOOL & OBSERVABILITY (Egress)"]
        SearchAPIs["Search APIs<br/>(Brave/Bing/Tavily/Wolfram)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        MCP["MCP Servers<br/>Configurable Port<br/>HTTP/stdio"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF Token"]
        OTel["OpenTelemetry Collector<br/>4318/TCP HTTP<br/>TLS (configurable)"]
    end

    %% Ingress flows
    Client -->|"HTTP/HTTPS 8321/TCP<br/>TLS (optional)<br/>Bearer Token (optional)"| ServerCore

    %% Auth egress
    AuthMW -->|"HTTPS/443<br/>TLS 1.2+"| OIDC
    AuthMW -->|"HTTPS/443<br/>Basic Auth"| Introspect
    AuthMW -->|"HTTPS/443"| CustomAuth

    %% Provider egress
    RemoteP -->|"HTTP/11434<br/>No TLS"| Ollama
    RemoteP -->|"HTTP(S)/8000<br/>API Key"| vLLM
    RemoteP -->|"HTTP(S)/8080<br/>API Key"| TGI
    RemoteP -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key/IAM"| CloudLLM

    %% Vector DB egress
    RemoteP -->|"HTTP/8000"| Chroma
    RemoteP -->|"HTTP+gRPC/6333"| Qdrant
    RemoteP -->|"gRPC/19530"| Milvus

    %% Storage egress
    StorageLayer -->|"PostgreSQL/5432<br/>TLS (config)<br/>Password"| PostgreSQL
    StorageLayer -->|"Redis/6379<br/>TLS (config)"| Redis
    StorageLayer -->|"MongoDB/27017<br/>TLS (config)"| MongoDB

    %% Tool egress
    RemoteP -->|"HTTPS/443<br/>API Key"| SearchAPIs
    RemoteP -->|"HTTP/stdio"| MCP
    RemoteP -->|"HTTPS/443<br/>HF Token"| HFHub
    ServerCore -->|"HTTP/4318<br/>OTLP"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appboundary fill:#e3f2fd,stroke:#1565C0,stroke-width:2px
    classDef authzone fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef inference fill:#fce4ec,stroke:#c62828,stroke-width:2px
    classDef vectordb fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef datastore fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef toolservice fill:#fff9c4,stroke:#f57f17,stroke-width:2px

    class Client external
    class AuthMW,ACL,Quota authzone
    class Ollama,vLLM,TGI,CloudLLM inference
    class Chroma,Qdrant,Milvus vectordb
    class PostgreSQL,Redis,MongoDB datastore
    class SearchAPIs,MCP,HFHub,OTel toolservice
