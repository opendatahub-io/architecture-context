graph TB
    subgraph "Platform Operator Tier"
        rhods["rhods-operator<br/>Platform Lifecycle Orchestration"]
    end

    subgraph "Model Serving Stack"
        KServe["KServe + odh-model-controller<br/>Model Serving Backbone"]
        gwie["gateway-api-inference-extension<br/>Inference-Aware EPP"]
        llmd["llm-d<br/>Disaggregated Inference"]
        modelmesh["ModelMesh<br/>Multi-Model Serving"]
        maas["models-as-a-service<br/>Multi-Tenant Consumption"]
        aigateway["ai-gateway-controller<br/>Multi-Provider Routing"]
    end

    subgraph "Training and Scheduling"
        codeflare["codeflare-operator<br/>Distributed Workloads"]
        kuberay["KubeRay<br/>Ray Clusters"]
        kueue["Kueue<br/>Job Queueing"]
        trainer["Trainer<br/>Distributed Training"]
        spark["spark-operator<br/>Batch Processing"]
    end

    subgraph "Development and MLOps"
        dashboard["odh-dashboard<br/>Platform UI"]
        workbenches["Workbenches<br/>Notebooks and Workspaces"]
        pipelines["Data Science Pipelines<br/>ML Workflows"]
        mlflow["MLflow + mlflow-operator<br/>Experiment Tracking"]
        registry["model-registry-operator<br/>Model Registry"]
    end

    subgraph "Responsible AI and Agents"
        trustyai["TrustyAI<br/>Model Evaluation"]
        guardrails["NeMo Guardrails<br/>Content Safety"]
        agents["agents-operator<br/>AI Agent Lifecycle"]
        mcpop["mcp-lifecycle-operator<br/>MCP Server Management"]
    end

    subgraph "Platform Infrastructure"
        feast["Feast<br/>Feature Store"]
        dsgw["data-science-gateway<br/>Primary Gateway"]
        maasgw["maas-default-gateway<br/>MaaS Gateway"]
        kubeauthproxy["kube-auth-proxy<br/>Gateway Authentication"]
        observability["odh-observability<br/>Monitoring Stack"]
    end

    %% rhods-operator deploys all components
    rhods -->|"lifecycle mgmt"| KServe
    rhods -->|"lifecycle mgmt"| dashboard
    rhods -->|"lifecycle mgmt"| workbenches
    rhods -->|"lifecycle mgmt"| pipelines
    rhods -->|"lifecycle mgmt"| registry
    rhods -->|"lifecycle mgmt"| kueue
    rhods -->|"lifecycle mgmt"| codeflare
    rhods -->|"lifecycle mgmt"| maas
    rhods -->|"lifecycle mgmt"| feast
    rhods -->|"lifecycle mgmt"| trainer
    rhods -->|"lifecycle mgmt"| observability
    rhods -->|"lifecycle mgmt"| agents
    rhods -->|"provisions"| dsgw
    rhods -->|"deploys"| kubeauthproxy

    %% Serving stack dependencies
    KServe -->|"inference routing"| gwie
    KServe -->|"disaggregated serving"| llmd
    maas -->|"model endpoints"| KServe
    maas -->|"provisions"| maasgw
    aigateway -->|"multi-provider"| KServe
    guardrails -->|"safety checks"| KServe

    %% Training ecosystem
    codeflare -->|"manages clusters"| kuberay
    codeflare -->|"quota mgmt"| kueue
    kueue -->|"admits workloads"| kuberay
    kueue -->|"admits workloads"| trainer
    kueue -->|"admits workloads"| workbenches
    kuberay -->|"routing"| gwie

    %% Pipeline integrations
    pipelines -->|"auto-deploy"| KServe
    pipelines -->|"registers models"| registry
    pipelines -->|"tracks experiments"| mlflow
    pipelines -->|"imports API types"| codeflare

    %% Dashboard integrations
    dashboard -->|"manages serving"| KServe
    dashboard -->|"displays models"| registry
    dashboard -->|"launches"| workbenches

    %% Feature store
    feast -->|"reads instances"| mlflow
    feast -->|"injects clients"| workbenches
    feast -->|"batch jobs"| spark

    %% Gateway auth chain
    dsgw -->|"ext_authz"| kubeauthproxy

