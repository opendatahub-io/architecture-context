graph TB
    subgraph "Platform Operator"
        rhods["rhods-operator<br/>(Platform Control Plane)<br/>15 reverse deps"]
    end

    subgraph "Core Serving Infrastructure"
        KServe["KServe<br/>(Model Serving)<br/>17 reverse deps"]
        ModelMesh["modelmesh-serving<br/>(Multi-model Serving)"]
        odmctrl["odh-model-controller<br/>(Serving Config)"]
        vLLM["vLLM (CUDA)<br/>(LLM Inference)"]
    end

    subgraph "LLM Routing & Gateway"
        GAIE["Gateway API Inference Extension<br/>(Filter-Score-Pick Scheduler)"]
        llmdRouter["llm-d Router (EPP)<br/>(Cache-aware Routing)"]
        EnvoyGW["Envoy Gateway<br/>(data-science-gateway)"]
        kubeauthproxy["kube-auth-proxy<br/>(OAuth2 Gateway)"]
    end

    subgraph "Multi-Tenant AI Gateway (MaaS)"
        AIGatewayOp["AI Gateway Operator<br/>(Module Operator)"]
        MaaS["Models as a Service<br/>(Tenant Gateway)"]
        BatchGW["batch-gateway<br/>(Async Inference)"]
        PayloadProc["ai-gateway-payload-processing<br/>(ext_proc Pipeline)"]
    end

    subgraph "Dashboard & UI"
        Dashboard["odh-dashboard<br/>(Gen AI Studio)"]
    end

    subgraph "Training & Scheduling"
        TrainingOp["Training Operator (KFTO)<br/>(Distributed Training)"]
        KFTrainer["Kubeflow Trainer<br/>(TrainJob v2)"]
        KubeRay["KubeRay Operator<br/>(Ray Clusters)"]
        SparkOp["Spark Operator<br/>(Spark Jobs)"]
        Kueue["Kueue<br/>(Job Scheduling)<br/>8 reverse deps"]
    end

    subgraph "Data Science Workflows"
        DSP["Data Science Pipelines<br/>(Pipeline Orchestration)"]
        DSPO["DS Pipelines Operator<br/>(DSPA Lifecycle)"]
        Notebooks["Kubeflow Notebook Controllers<br/>(Workbenches)"]
        Feast["Feast<br/>(Feature Store)"]
    end

    subgraph "Model Governance & Evaluation"
        TrustyAI["TrustyAI Service Operator<br/>(Fairness & Eval)"]
        ModelReg["Model Registry<br/>(Model Metadata)<br/>5 reverse deps"]
        NemoGuard["NeMo Guardrails<br/>(Content Moderation)"]
        MCPServer["RHOAI MCP Server<br/>(Tool Orchestration)"]
    end

    subgraph "ML Experiment Tracking"
        MLflowOp["MLflow Operator<br/>(Module Operator)"]
    end

    subgraph "Agent & GenAI Extensions"
        OGX["OGX (Llama Stack)<br/>(Agent Orchestration)"]
        MCPLifecycle["MCP Lifecycle Operator<br/>(MCP Server Lifecycle)"]
    end

    subgraph "Auth Sidecar"
        krbacproxy["kube-rbac-proxy<br/>(SubjectAccessReview)<br/>8 reverse deps"]
    end

    %% rhods-operator manages all top-level components
    rhods -->|manages| KServe
    rhods -->|manages| Dashboard
    rhods -->|manages| DSP
    rhods -->|manages| Notebooks
    rhods -->|manages| TrainingOp
    rhods -->|manages| KFTrainer
    rhods -->|manages| KubeRay
    rhods -->|manages| SparkOp
    rhods -->|manages| Kueue
    rhods -->|manages| ModelReg
    rhods -->|manages| TrustyAI
    rhods -->|manages| odmctrl
    rhods -->|manages| AIGatewayOp
    rhods -->|manages| MLflowOp
    rhods -->|manages| MCPLifecycle
    rhods -->|manages| OGX

    %% AI Gateway sub-components
    AIGatewayOp -->|deploys| MaaS
    AIGatewayOp -->|deploys| BatchGW
    MaaS -->|serving| KServe
    BatchGW -->|async dispatch| llmdRouter
    PayloadProc -->|API translation| KServe

    %% LLM Serving Pipeline
    KServe -->|deploys| vLLM
    vLLM -->|metrics| llmdRouter
    vLLM -->|metrics| GAIE
    llmdRouter -->|routing| EnvoyGW
    GAIE -->|scheduling| EnvoyGW

    %% Dashboard integrations
    Dashboard -->|model serving| KServe
    Dashboard -->|model catalog| ModelReg
    Dashboard -->|pipeline mgmt| DSP
    Dashboard -->|queue mgmt| Kueue
    Dashboard -->|workbench images| Notebooks
    Dashboard -->|fairness metrics| TrustyAI
    Dashboard -->|experiment tracking| MLflowOp
    Dashboard -->|feature store| Feast
    Dashboard -->|content moderation| NemoGuard

    %% Data Science Pipelines
    DSP -->|deploys| DSPO
    DSPO -->|optional| MLflowOp

    %% Model Registry integrations
    ModelReg -->|serving| KServe
    TrustyAI -->|patches logger| KServe
    odmctrl -->|reads config| KServe

    %% Training integrations
    TrainingOp -->|submits to| Kueue
    KFTrainer -->|submits to| Kueue
    TrustyAI -->|LMEvalJob| Kueue
    SparkOp -->|submits to| Kueue

    %% Notebook integrations
    Feast -->|injects config| Notebooks
    Notebooks -->|connection secret| DSP

    %% MCP Server
    MCPServer -->|pipeline mgmt| DSPO
    MCPServer -->|serving| KServe
    MCPServer -->|workbenches| Notebooks
    MCPServer -->|model discovery| ModelReg

    %% Auth sidecar usage
    krbacproxy -.->|auth sidecar| KubeRay
    krbacproxy -.->|auth sidecar| Dashboard
    krbacproxy -.->|auth sidecar| KServe
    krbacproxy -.->|auth sidecar| TrustyAI

    %% OGX
    OGX -->|inference backend| vLLM

