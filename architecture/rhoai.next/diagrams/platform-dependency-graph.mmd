graph TB
    subgraph PlatformControlPlane["Platform Control Plane"]
        RhodsOp["rhods-operator<br/>(Meta-Operator)<br/>DAG Provisioning: RL20→RL31→RL32→RL33"]
    end

    subgraph ServingStack["AI/ML Serving Stack"]
        KServe["KServe<br/>InferenceService &<br/>LLMInferenceService"]
        ODHModelCtrl["odh-model-controller<br/>Platform Bridge"]
        LLMD["llm-d Router (EPP)<br/>Inference-Aware Routing"]
        VLLM["vLLM CUDA<br/>LLM Runtime"]
        ModelMesh["ModelMesh Serving<br/>Multi-Model"]
        MaaS["Models-as-a-Service<br/>External Providers"]
    end

    subgraph AIGatewayStack["AI Gateway"]
        AIGateway["ai-gateway-operator<br/>Module Operator"]
        BatchGW["Batch Gateway<br/>Async LLM"]
    end

    subgraph DataScience["Data Science Workflows"]
        DSPO["DS Pipelines Operator"]
        DSPipelines["Data Science Pipelines<br/>Argo Workflows"]
        MLMD["ML Metadata"]
        MLflowOp["MLflow Operator"]
        MLflow["MLflow<br/>Experiment Tracking"]
    end

    subgraph ModelMgmt["Model Management"]
        ModelRegOp["Model Registry Operator"]
        ModelReg["Model Registry<br/>MLMD Schema"]
    end

    subgraph WorkbenchStack["Workbenches"]
        WorkbenchesOp["workbenches-operator<br/>Module Operator"]
        KubeflowCtrl["Kubeflow Notebook<br/>Controller"]
        Notebooks["Notebooks<br/>Jupyter / VS Code / RStudio"]
    end

    subgraph TrainingStack["Distributed Training"]
        TrainingOp["Training Operator"]
        KubeflowTrainer["Kubeflow Trainer<br/>TrainingRuntime"]
        KubeRay["KubeRay Operator<br/>RayCluster"]
        CodeFlare["CodeFlare Operator"]
        Kueue["Kueue<br/>Queue Management"]
    end

    subgraph TrustSafety["Trust & Safety"]
        TrustyAI["TrustyAI Operator<br/>Explainability & Fairness"]
        NemoGuard["NeMo Guardrails"]
        Feast["Feast<br/>Feature Store"]
        FeastModOp["feast-module-operator"]
    end

    subgraph AgentInfra["Agent Infrastructure"]
        AgentsOp["agents-operator<br/>Kagenti / A2A Protocol"]
        MCPLifecycle["MCP Lifecycle Operator"]
        MCPServer["RHOAI MCP Server"]
        OGX["OGX (Llama Stack)"]
    end

    subgraph PlatformUI["Platform UI"]
        Dashboard["odh-dashboard<br/>Web UI + Go BFF Modules"]
    end

    subgraph PlatformSvc["Platform Services"]
        KubeRBACProxy["kube-rbac-proxy<br/>Auth Sidecar (15+ components)"]
        KubeAuthProxy["kube-auth-proxy<br/>OAuth2/OIDC Gateway"]
        SparkOp["Spark Operator"]
    end

    subgraph ExternalInfra["External Infrastructure"]
        GatewayAPI["Gateway API<br/>Envoy + HTTPRoutes"]
        Istio["Istio<br/>Service Mesh"]
        Knative["KNative Serving<br/>Serverless"]
        MonStack["Monitoring Stack<br/>Prometheus / Tempo / Perses"]
    end

    %% ─── rhods-operator deploys all module operators (RL20-RL33) ───
    RhodsOp -->|"RL20: deploys"| KServe
    RhodsOp -->|"RL20: deploys"| DSPO
    RhodsOp -->|"RL20: deploys"| Dashboard
    RhodsOp -->|"RL20: deploys"| KubeflowCtrl
    RhodsOp -->|"RL31: deploys"| AIGateway
    RhodsOp -->|"RL32: deploys"| ModelRegOp
    RhodsOp -->|"RL32: deploys"| WorkbenchesOp
    RhodsOp -->|"RL32: deploys"| TrustyAI
    RhodsOp -->|"RL32: deploys"| KubeRay
    RhodsOp -->|"RL32: deploys"| Kueue
    RhodsOp -->|"RL32: deploys"| TrainingOp
    RhodsOp -->|"RL32: deploys"| KubeflowTrainer
    RhodsOp -->|"RL32: deploys"| MLflowOp
    RhodsOp -->|"RL32: deploys"| FeastModOp
    RhodsOp -->|"RL32: deploys"| SparkOp
    RhodsOp -->|"RL32: deploys"| CodeFlare

    %% ─── AI Gateway relationships ───
    AIGateway -->|"manages"| BatchGW
    AIGateway -->|"MaaS integration"| KServe
    AIGateway -->|"manages"| MaaS
    BatchGW -->|"async processing"| LLMD

    %% ─── Serving stack ───
    KServe -->|"deploys runtime"| VLLM
    KServe -->|"serverless autoscaling"| Knative
    KServe -->|"traffic management"| Istio
    KServe -->|"model-registry:// URI"| ModelReg
    ODHModelCtrl -->|"watches InferenceService CRs"| KServe
    ODHModelCtrl -->|"creates HTTPRoutes"| GatewayAPI
    ODHModelCtrl -->|"registers models (optional)"| ModelReg
    LLMD -->|"selects optimal pod (EPP)"| VLLM

    %% ─── Data Science ───
    DSPO -->|"deploys"| DSPipelines
    DSPO -->|"discovers endpoint"| MLflowOp
    DSPipelines -->|"execution tracking"| MLMD
    MLflowOp -->|"deploys"| MLflow

    %% ─── Model Management ───
    ModelRegOp -->|"deploys"| ModelReg
    ModelReg -->|"syncs InferenceService state"| KServe

    %% ─── Workbenches ───
    WorkbenchesOp -->|"deploys"| KubeflowCtrl
    KubeflowCtrl -->|"creates StatefulSets"| Notebooks
    KubeflowCtrl -->|"ambient: injects pipeline config"| DSPipelines
    KubeflowCtrl -->|"ambient: injects MLflow"| MLflow
    KubeflowCtrl -->|"ambient: injects Feast"| Feast

    %% ─── Training ───
    Kueue -->|"admits workloads"| TrainingOp
    Kueue -->|"admits workloads"| KubeRay
    CodeFlare -->|"injects OAuth + mTLS"| KubeRay

    %% ─── Trust & Safety ───
    TrustyAI -->|"patches InferenceService"| KServe
    TrustyAI -->|"LMES evaluation jobs"| Kueue
    FeastModOp -->|"deploys"| Feast

    %% ─── Dashboard integrations ───
    Dashboard -->|"serving management"| KServe
    Dashboard -->|"workbench management"| KubeflowCtrl
    Dashboard -->|"model registry UI"| ModelRegOp
    Dashboard -->|"pipeline runs UI"| DSPipelines
    Dashboard -->|"experiment tracking"| MLflowOp
    Dashboard -->|"feature store discovery"| Feast
    Dashboard -->|"evaluation hub"| TrustyAI
    Dashboard -->|"Spark management"| SparkOp

    %% ─── Agent / MCP ───
    MCPLifecycle -->|"manages lifecycle"| MCPServer
    MCPServer -->|"discovers"| KServe
    MCPServer -->|"discovers"| ModelReg
    MCPServer -->|"discovers"| DSPO
    MCPServer -->|"discovers"| KubeflowCtrl
    TrustyAI -->|"MCP gateway"| MCPServer

    %% ─── Cross-cutting: auth sidecar ───
    KubeRBACProxy -.->|"sidecar: 15+ components"| KServe
    KubeRBACProxy -.->|"sidecar"| ModelRegOp
    KubeRBACProxy -.->|"sidecar"| TrustyAI
    KubeRBACProxy -.->|"sidecar"| KubeRay
    KubeRBACProxy -.->|"sidecar"| Dashboard
    KubeRBACProxy -.->|"sidecar"| KubeflowCtrl
    KubeRBACProxy -.->|"sidecar"| DSPO
    KubeAuthProxy -.->|"OAuth2/OIDC ingress"| GatewayAPI

