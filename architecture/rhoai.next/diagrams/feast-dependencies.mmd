graph LR
    Feast["Feast<br/>(Operator + Feature Server)"]

    %% External Framework Dependencies
    Feast -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.21+"]
    Feast -->|"REST API framework"| FastAPI["FastAPI<br/>≥0.68.0"]
    Feast -->|"ASGI server"| Gunicorn["Gunicorn/Uvicorn<br/>≥0.30.6"]
    Feast -->|"JWT parsing"| PyJWT["PyJWT"]
    Feast -->|"metrics"| PromClient["Prometheus Client<br/>≥0.20.0"]
    Feast -->|"gRPC serving"| gRPC["gRPC Python<br/>≥1.56.2"]
    Feast -->|"K8s auth mode"| K8sPyClient["Kubernetes<br/>Python Client"]

    %% Internal Platform Dependencies (RHOAI/ODH)
    Feast -->|"Create Routes<br/>for UI (OpenShift)"| OpenShiftRoute["OpenShift Route API<br/>route.openshift.io"]
    Feast -->|"Fetch TLS profile<br/>FIPS compliance"| OpenShiftAPIServer["OpenShift APIServer CR<br/>config.openshift.io"]
    Feast -->|"Watch Notebooks<br/>ConfigMap injection"| KubeflowNB["Kubeflow Notebooks<br/>kubeflow.org"]
    Feast -->|"Batch feature<br/>computation"| SparkOperator["Spark Operator<br/>sparkoperator.k8s.io"]
    Feast -->|"Metrics scraping<br/>ServiceMonitor"| PrometheusOp["Prometheus Operator<br/>monitoring.coreos.com"]
    Feast -.->|"Namespace discovery<br/>label: opendatahub.io/feast"| ODHPlatform["OpenDataHub<br/>Platform"]

    %% External Service Dependencies
    Feast -->|"online store<br/>6379/TCP"| Redis["Redis"]
    Feast -->|"online/offline/registry<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    Feast -->|"online store<br/>443/TCP HTTPS"| DynamoDB["AWS DynamoDB"]
    Feast -->|"offline store<br/>443/TCP HTTPS"| Snowflake["Snowflake"]
    Feast -->|"offline store<br/>443/TCP HTTPS"| BigQuery["Google BigQuery"]
    Feast -->|"online store<br/>443/TCP gRPC"| Bigtable["Google Cloud<br/>Bigtable"]
    Feast -->|"token validation<br/>443/TCP HTTPS"| OIDC["OIDC Provider"]
    Feast -->|"lineage events<br/>HTTP/HTTPS"| OpenLineage["OpenLineage"]
    Feast -->|"CR reconciliation<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API"]

    %% Consumers (reverse dependencies)
    ODHDashboard["ODH Dashboard"] -->|"namespace discovery<br/>UI management"| Feast
    DSPipelines["Data Science<br/>Pipelines"] -.->|"feature retrieval"| Feast

    %% Styling
    style Feast fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

