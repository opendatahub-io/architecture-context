graph LR
    Feast["Feast Operator +<br/>Feature Servers"]

    %% External Dependencies (Required)
    Feast -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    Feast -->|"TLS profiles"| OpenShiftAPI["openshift/api v0.0.0-20260317"]
    Feast -->|"TLS bootstrap"| OpenShiftCRC["controller-runtime-common<br/>v0.0.0-20260428"]
    Feast -->|"HTTP framework"| FastAPI["FastAPI >=0.68.0"]
    Feast -->|"gRPC transport"| gRPC["grpcio >=1.56.2"]
    Feast -->|"data transport"| PyArrow["pyarrow >=16.1.0"]
    Feast -->|"data manipulation"| Pandas["pandas >=1.4.3"]
    Feast -->|"ASGI server"| Uvicorn["uvicorn >=0.30.6"]
    Feast -->|"JWT handling"| PyJWT["PyJWT >=2.13.0"]
    Feast -->|"crypto"| Cryptography["cryptography >=43.0"]
    Feast -->|"metrics"| PromClient["prometheus-client<br/>>=0.20.0"]
    Feast -->|"MCP server"| MCP["MCP >=1.0"]

    %% Internal Platform Dependencies (RHOAI)
    Feast -->|"CRD Watch"| KubeflowNB["Kubeflow Notebooks"]
    Feast -->|"CRD Watch"| MLflow["MLflow"]
    Feast -->|"CRD CRUD"| PromOperator["Prometheus Operator"]
    Feast -->|"CRD CRUD"| SparkOp["Spark Operator"]
    Feast -->|"CRD CRUD"| OSRoutes["OpenShift Routes"]

    %% Integration Points (consumed by)
    Dashboard["ODH Dashboard"] -.->|"references"| Feast
    Pipelines["Data Science Pipelines"] -.->|"integrates"| Feast

    %% External Backend Services
    Feast -->|"online store"| Redis["Redis / Valkey"]
    Feast -->|"online/offline store"| PostgreSQL["PostgreSQL"]
    Feast -->|"registry/data"| S3["S3-compatible Storage"]
    Feast -->|"registry/data"| GCS["Google Cloud Storage"]
    Feast -->|"offline store"| BigQuery["BigQuery"]
    Feast -->|"offline store"| Snowflake["Snowflake"]
    Feast -->|"distributed compute"| Ray["Ray"]
    Feast -->|"API server"| K8sAPI["Kubernetes API"]

    %% Styling
    style Feast fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
