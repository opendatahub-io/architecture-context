    VLLMRocm -->|"model weights<br/>HTTPS/443"| S3["S3-compatible Storage"]

    %% Internal RHOAI Dependencies
    VLLMRocm -->|"deployed by<br/>serving runtime"| KServe["KServe"]
    VLLMRocm -->|"mTLS, routing<br/>ingress"| Istio["Istio / Service Mesh"]
    VLLMRocm -->|"AuthN/AuthZ sidecar<br/>8443/TCP"| KubeRBAC["kube-rbac-proxy"]
    VLLMRocm -->|"model storage<br/>PVC/S3 mount"| ModelStorage["Model Storage<br/>(PVC/S3)"]

