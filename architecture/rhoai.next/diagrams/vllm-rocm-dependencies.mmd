    %% External Dependencies (Required)
    VLLMRocm -->|"base image<br/>FROM extends"| RHAIIS["RHAIIS Base Image<br/>vllm-rocm-rhel9:3.2.1"]
    VLLMRocm -->|"GPU compute<br/>ROCm 7.14+"| ROCmGPU["AMD ROCm GPU<br/>(Instinct series)"]
