graph LR
    VllmRocm["vllm-rocm<br/>Container Image Wrapper"]

    %% External Dependencies (required)
    VllmRocm -->|"FROM base image<br/>v3.2.1"| RHAIISBase["RHAIIS vllm-rocm-rhel9<br/>Base Image 3.2.1"]
    VllmRocm -->|"GPU compute<br/>(inherited)"| ROCm["AMD ROCm Runtime"]
    VllmRocm -->|"inference engine<br/>(inherited)"| VllmLib["vLLM<br/>(PagedAttention)"]
    VllmRocm -->|"gRPC bridge<br/>(inherited)"| TGISAdapter["vllm_tgis_adapter<br/>TGIS Protocol Adapter"]

    %% Internal RHOAI Dependencies
    VllmRocm -->|"deployed as<br/>ServingRuntime pod"| KServe["KServe"]
    VllmRocm -->|"lifecycle<br/>management"| RhodsOperator["rhods-operator"]
    VllmRocm -->|"TLS termination<br/>& routing"| GatewayAPI["Gateway API<br/>(Platform Ingress)"]
    VllmRocm -->|"auth sidecar<br/>8443/TCP"| KubeRBACProxy["kube-rbac-proxy"]

    %% External Services (runtime)
    VllmRocm -->|"model weights<br/>HTTPS/443"| S3["S3 / Object Storage"]
    VllmRocm -->|"models & tokenizers<br/>HTTPS/443"| HFHub["Hugging Face Hub"]
    VllmRocm -->|"GPU device<br/>driver"| AMDGPU["AMD Instinct/<br/>Radeon GPU"]

    %% Build Dependencies
    VllmRocm -.->|"Tekton pipeline<br/>PipelinesAsCode"| Konflux["Konflux Central<br/>(Build Pipeline)"]

    %% Things that consume vllm-rocm
    KServeRT["KServe ServingRuntime CR"] -->|"image reference"| VllmRocm
    InferSvc["KServe InferenceService CR"] -->|"triggers pod"| VllmRocm

    %% Styling
    style VllmRocm fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps
    style RHAIISBase fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ROCm fill:#999,stroke:#333,color:#fff
    style VllmLib fill:#999,stroke:#333,color:#fff
    style TGISAdapter fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style RhodsOperator fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff
    style KubeRBACProxy fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style HFHub fill:#f5a623,stroke:#333,color:#fff
    style AMDGPU fill:#9673a6,stroke:#333,color:#fff

    %% Build
    style Konflux fill:#e8e8e8,stroke:#333

    %% Consumers
    style KServeRT fill:#7ed321,stroke:#333,color:#fff
    style InferSvc fill:#7ed321,stroke:#333,color:#fff
