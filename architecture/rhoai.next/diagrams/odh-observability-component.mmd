graph TB
    subgraph ODH_Obs["odh-observability Operator"]
        direction TB
        Reconciler["MonitoringReconciler<br/>(controller-runtime)"]
        Templates["Embedded Go Templates<br/>(46 template files)"]
        SSA["Server-Side Apply<br/>(odh-platform-utilities)"]
        TLSResolver["TLS Profile Resolver<br/>(openshift/library-go)"]
        GC["Label-based Garbage Collector<br/>(platform.opendatahub.io/part-of=monitoring)"]
        Webhook["Mutating Webhook<br/>:9443/TCP"]

        Reconciler -->|renders| Templates
        Reconciler -->|applies via| SSA
        Reconciler -->|resolves TLS| TLSResolver
        Reconciler -->|cleans stale| GC
    end

    subgraph Operands["Managed Operands"]
        direction TB
        ClusterProxy["data-science-prometheus<br/>-cluster-proxy<br/>(kube-rbac-proxy)"]
        NSProxy["data-science-prometheus<br/>-namespace-proxy<br/>(kube-rbac-proxy +<br/>prom-label-proxy)"]
        Korrel8r["Korrel8r<br/>(correlation engine)"]
        Collector["OpenTelemetry Collector"]
        Prometheus["MonitoringStack<br/>(Prometheus)"]
        Thanos["ThanosQuerier"]
        Tempo["TempoMonolithic /<br/>TempoStack"]
        Perses["Perses<br/>(dashboards)"]
        LogForwarder["ClusterLogForwarder"]
    end

    %% CR input
    User[Platform Admin] -->|creates| MonitoringCR["Monitoring CR<br/>(default-monitoring)<br/>Cluster-scoped"]
    MonitoringCR -->|watched by| Reconciler

    %% Reconciler creates operands
    Reconciler -->|creates| ClusterProxy
    Reconciler -->|creates| NSProxy
    Reconciler -->|creates| Korrel8r
    Reconciler -->|creates| Collector
    Reconciler -->|creates| Prometheus
    Reconciler -->|creates| Thanos
    Reconciler -->|creates| Tempo
    Reconciler -->|creates| Perses
    Reconciler -->|creates| LogForwarder

    %% Webhook interaction
    APIServer["kube-apiserver"] -->|admission request| Webhook
    Webhook -->|injects scrape label| PodMonitor["PodMonitor /<br/>ServiceMonitor"]

    %% External reads
    TLSResolver -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config"]

    %% CRD dependencies
    Reconciler -->|discovers CRDs| COO["Cluster Observability<br/>Operator"]
    Reconciler -->|discovers CRDs| TempoOp["Tempo Operator"]
    Reconciler -->|discovers CRDs| OTelOp["OpenTelemetry Operator"]
    Reconciler -->|discovers CRDs| PersesOp["Perses Operator"]
    Reconciler -->|discovers CRDs| LokiOp["Loki Operator"]
    Reconciler -->|discovers CRDs| LoggingOp["Cluster Logging<br/>Operator"]

    %% Styling
    style Reconciler fill:#4a90e2,color:#fff
    style Templates fill:#4a90e2,color:#fff
    style SSA fill:#4a90e2,color:#fff
    style TLSResolver fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style MonitoringCR fill:#f5a623,color:#fff
    style ClusterProxy fill:#7ed321,color:#fff
    style NSProxy fill:#7ed321,color:#fff
    style Korrel8r fill:#7ed321,color:#fff
    style Collector fill:#7ed321,color:#fff
    style Prometheus fill:#7ed321,color:#fff
    style Thanos fill:#7ed321,color:#fff
    style Tempo fill:#7ed321,color:#fff
    style Perses fill:#7ed321,color:#fff
    style LogForwarder fill:#7ed321,color:#fff
    style COO fill:#e8e8e8,stroke:#999
    style TempoOp fill:#e8e8e8,stroke:#999
    style OTelOp fill:#e8e8e8,stroke:#999
    style PersesOp fill:#e8e8e8,stroke:#999
    style LokiOp fill:#e8e8e8,stroke:#999
    style LoggingOp fill:#e8e8e8,stroke:#999
    style PodMonitor fill:#f5a623,color:#fff
