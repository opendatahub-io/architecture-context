graph LR
    InferSim["llm-d-inference-sim<br/>Go Service"]

    %% Internal Platform Dependencies
    InferSim -->|"KV event types<br/>Go library"| LLMDRouter["llm-d-router"]

    %% Core Runtime Dependencies
    InferSim -->|"HTTP server"| FastHTTP["fasthttp v1.74.0"]
    InferSim -->|"HTTP routing"| FastHTTPRouter["fasthttprouter v0.1.1"]
    InferSim -->|"port multiplexing"| CMux["cmux v0.1.5"]
    InferSim -->|"gRPC server"| GRPC["grpc v1.83.2"]
    InferSim -->|"protobuf"| Protobuf["protobuf v1.36.12"]

    %% Observability & Metrics
    InferSim -->|"metrics"| Prometheus["prometheus/client_golang v1.24.1"]

    %% KV Cache & Messaging
    InferSim -->|"ZMQ publisher"| ZMQ4["go-zeromq/zmq4 v0.17.0"]
    InferSim -->|"event encoding"| MsgPack["msgpack/v5 v5.4.1"]

    %% Data & Storage
    InferSim -->|"response datasets"| SQLite["go-sqlite3 v0.35.5"]
    InferSim -->|"API types"| OpenAIGo["openai-go/v3 v3.63.1"]

    %% Infrastructure
    InferSim -->|"cert hot-reload"| FSNotify["fsnotify v1.10.1"]
    InferSim -->|"CLI flags"| PFlag["pflag v1.0.10"]
    InferSim -->|"structured logging"| Logr["logr v1.4.4"]
    InferSim -->|"logging backend"| KLog["klog/v2 v2.140.0"]
    InferSim -->|"JSON schema validation"| JSONSchema["jsonschema/v5 v5.3.1"]

    %% Runtime Integration Targets
    InferSim -->|"tokenization<br/>HTTP 8082/TCP"| VLLMRender["vLLM Render Sidecar"]
    InferSim -->|"KV events<br/>ZMQ 5557/TCP"| ZMQSubs["ZMQ Subscribers"]
    InferSim -->|"datasets + tokenizers<br/>HTTPS 443/TCP"| HFHub["HuggingFace Hub"]
    Prom["Prometheus"] -->|"scrape /metrics<br/>HTTP 8000/TCP"| InferSim

