graph TB
    subgraph Monitoring["MONITORING (Restricted by NetworkPolicy)"]
        Prometheus["Prometheus<br/>redhat-ods-monitoring /<br/>openshift-monitoring"]
    end

    subgraph OperatorNS["OPERATOR (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["Operator Pod"]
            direction LR
            MetricsEP["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (service-ca cert)<br/>Auth: Bearer + RBAC"]
            HealthEP["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            Reconciler["LLMBatchGatewayReconciler"]
            MetricsCtrl["MetricsController"]
            TLSWatch["TLS Profile Watcher"]
        end
    end

    subgraph K8sAPI["KUBERNETES API"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OperandNS["OPERAND NAMESPACE (per CR)"]
        direction TB
        BatchAPI["API Server<br/>Batch job submissions"]
        Processor["Processor<br/>Inference dispatch"]
        GC["Garbage Collector<br/>Job cleanup"]
        AsyncProc["Async Processor<br/>Redis queue dispatch<br/>(optional)"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES (conditional)"]
        direction TB
        CertMgr["cert-manager<br/>Certificate CRs"]
        GatewayAPI["Gateway API<br/>HTTPRoute + ReferenceGrant"]
        PromOp["prometheus-operator<br/>ServiceMonitor / PrometheusRule"]
        ServiceCA["OpenShift service-ca<br/>Cert provisioning"]
        OSConfig["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS Profile"]
    end

    subgraph ParentOp["PARENT OPERATOR"]
        ODHOp["opendatahub-operator /<br/>rhods-operator<br/>Deploys operator + params.env"]
    end

    %% Monitoring flow
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer token"| MetricsEP
    MetricsEP -->|"TokenReview +<br/>SubjectAccessReview"| APIServer

    %% Operator to K8s API
    Reconciler -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CRUD + Watch + SSA"| APIServer
    MetricsCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| APIServer
    TLSWatch -->|"HTTPS/6443<br/>Watch config.openshift.io"| APIServer

    %% K8s API manages operands (via SSA from operator)
    APIServer -.->|"Server-Side Apply<br/>(Helm-rendered manifests)"| BatchAPI
    APIServer -.->|"Server-Side Apply"| Processor
    APIServer -.->|"Server-Side Apply"| GC
    APIServer -.->|"Server-Side Apply"| AsyncProc

    %% Conditional platform integrations
    Reconciler -.->|"Certificate CR CRUD<br/>(if CRD present)"| CertMgr
    Reconciler -.->|"HTTPRoute CRUD +<br/>ReferenceGrant read"| GatewayAPI
    Reconciler -.->|"ServiceMonitor/PrometheusRule<br/>CRUD (if CRDs present)"| PromOp

    %% Parent operator
    ODHOp -->|"Deploys + image refs<br/>via params.env"| OperatorPod

    %% Styling
    classDef monitoring fill:#e1f5fe,stroke:#0277bd,stroke-width:2px,color:#000
    classDef operator fill:#e8eaf6,stroke:#283593,stroke-width:2px,color:#000
    classDef k8sapi fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef operand fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000
    classDef platform fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    classDef parent fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#000

    class Prometheus monitoring
    class MetricsEP,HealthEP,Reconciler,MetricsCtrl,TLSWatch operator
    class APIServer k8sapi
    class BatchAPI,Processor,GC,AsyncProc operand
    class CertMgr,GatewayAPI,PromOp,ServiceCA,OSConfig platform
    class ODHOp parent
