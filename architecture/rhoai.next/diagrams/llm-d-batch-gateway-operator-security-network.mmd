graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Optional - Gateway API)"]
        HTTPRoute["HTTPRoute<br/>/v1/batches, /v1/files<br/>8000/TCP<br/>Configurable TLS"]
    end

    subgraph ManagedWorkloads["MANAGED WORKLOADS (Operator-Controlled)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            APIServer["API Server<br/>8000/TCP http, 8081/TCP obs<br/>SA: {name}-apiserver"]
            Processor["Processor<br/>9090/TCP metrics<br/>Sync dispatch"]
            GC["Garbage Collector<br/>9091/TCP metrics"]
            AsyncProc["Async Processor<br/>(optional)<br/>SA: {name}-async-processor<br/>⚠ InsecureSkipVerify gap"]
        end
    end

    subgraph OperatorPlane["OPERATOR (Control Plane)"]
        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["LLM-D Batch Gateway Operator<br/>8081/TCP health, 8443/TCP metrics<br/>SA: llm-d-batch-gateway-operator"]
        end
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes: 8443, 8081, 9090, 9091/TCP"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>(optional)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Connection URL credentials"]
        Redis["Redis/Valkey<br/>6379/TCP<br/>Configurable TLS"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM"]
        InfGW["Inference Gateway<br/>(llm-d GIE/EPP)<br/>Configurable port<br/>Bearer token"]
        KubeAPI["kube-apiserver<br/>443/TCP HTTPS<br/>ServiceAccount token"]
    end

    %% External → Ingress → API Server
    Client -->|"HTTP/HTTPS 8000/TCP<br/>Configurable TLS<br/>Authorization header"| HTTPRoute
    HTTPRoute -->|"HTTP 8000/TCP<br/>Gateway routing"| APIServer

    %% API Server egress
    APIServer -->|"TCP 5432<br/>Configurable<br/>Credentials"| PostgreSQL
    APIServer -->|"HTTPS 443<br/>TLS<br/>AWS IAM"| S3
    APIServer -->|"TCP 6379<br/>Configurable TLS<br/>Credentials"| Redis

    %% Processor egress
    Processor -->|"TCP 5432<br/>Configurable<br/>Credentials"| PostgreSQL
    Processor -->|"HTTP/HTTPS<br/>TLS/mTLS<br/>Bearer token"| InfGW
    Processor -->|"TCP 6379<br/>Configurable TLS<br/>Credentials"| Redis
    Processor -->|"HTTPS 443<br/>TLS<br/>AWS IAM"| S3

    %% GC egress
    GC -->|"TCP 5432<br/>Credentials"| PostgreSQL

    %% Async Processor egress
    AsyncProc -->|"TCP 6379<br/>Configurable TLS<br/>Credentials"| Redis
    AsyncProc -->|"HTTP/HTTPS<br/>Configurable TLS/mTLS"| InfGW

    %% Operator → kube-apiserver
    Operator -->|"HTTPS 443<br/>TLS<br/>SA token<br/>Watch + SSA"| KubeAPI

    %% Observability
    Prometheus -.->|"HTTP 8443<br/>ServiceMonitor"| Operator
    Prometheus -.->|"HTTP 8081<br/>ServiceMonitor"| APIServer
    Prometheus -.->|"HTTP 9090<br/>PodMonitor"| Processor
    Prometheus -.->|"HTTP 9091<br/>PodMonitor"| GC
    APIServer -.->|"gRPC 4317<br/>Configurable"| OTLP
    Processor -.->|"gRPC 4317<br/>Configurable"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class HTTPRoute ingress
    class APIServer,Processor,GC managed
    class AsyncProc warning
    class Operator operator
    class PostgreSQL,Redis,S3,InfGW,KubeAPI externalservice
    class Prometheus,OTLP observability
