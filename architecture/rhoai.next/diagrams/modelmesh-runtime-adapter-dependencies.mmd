graph LR
    MRA["ModelMesh Runtime Adapter<br/>(multi-binary sidecar)"]

    %% Internal RHOAI Dependencies (inbound)
    ModelMesh["ModelMesh Controller"] -->|"gRPC 8084/TCP<br/>LoadModel/UnloadModel"| MRA
    MMServing["modelmesh-serving<br/>(modelmesh-controller)"] -->|"ConfigMap<br/>storageHelperImage"| MRA

    %% Target Runtimes (outbound, localhost)
    MRA -->|"gRPC 8001/TCP<br/>RepositoryModelLoad/Unload"| Triton["NVIDIA Triton<br/>Inference Server"]
    MRA -->|"gRPC 8001/TCP<br/>RepositoryModelLoad/Unload"| MLServer["Seldon MLServer"]
    MRA -->|"HTTP 8001/TCP<br/>POST /v1/config/reload"| OVMS["OpenVINO Model<br/>Server"]
    MRA -->|"gRPC 7071/TCP mgmt<br/>gRPC 7070/TCP inf"| TorchServe["PyTorch<br/>TorchServe"]

    %% Cloud Storage Dependencies (outbound, encrypted)
    MRA -->|"HTTPS 443/TCP<br/>TLS 1.2+<br/>Access Key + Secret"| S3["S3 / MinIO /<br/>IBM COS"]
    MRA -->|"HTTPS 443/TCP<br/>TLS 1.2+<br/>Service Account"| GCS["Google Cloud<br/>Storage"]
    MRA -->|"HTTPS 443/TCP<br/>TLS 1.2+<br/>Conn String / SPN"| AzureBlob["Azure Blob<br/>Storage"]
    MRA -->|"HTTP/HTTPS<br/>Optional mTLS"| HTTPSources["HTTP/HTTPS<br/>Model Sources"]

    %% Kubernetes Infrastructure
    MRA -.->|"volume mount<br/>/storage-config"| K8sSecrets["Kubernetes<br/>Secrets"]
    MRA -.->|"volume mount<br/>/pvc_mounts/"| K8sPVC["Kubernetes<br/>PVC"]

    %% Go Library Dependencies
    MRA -.->|"Go module"| gRPCLib["google.golang.org/grpc<br/>v1.56.3"]
    MRA -.->|"Go module"| Protobuf["google.golang.org/protobuf<br/>v1.33.0"]
    MRA -.->|"Go module"| IBMCOS["IBM COS SDK<br/>v1.9.1"]
    MRA -.->|"Go module"| GCSLib["cloud.google.com/go/storage<br/>v1.28.1"]
    MRA -.->|"Go module"| AzureSDK["Azure SDK for Go<br/>azblob v0.3.0"]
    MRA -.->|"Go module"| SecureJoin["filepath-securejoin<br/>v0.2.4"]

    %% Python Dependencies (Triton only)
    MRA -.->|"Python subprocess<br/>Keras conversion"| TensorFlow["TensorFlow 2.19.0<br/>+ Keras 3.11.3"]

