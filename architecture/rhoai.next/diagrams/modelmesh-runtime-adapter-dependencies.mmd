graph LR
    MRA["modelmesh-runtime-adapter<br/>Sidecar Service"]

    %% Internal RHOAI Dependencies
    MRA -->|"gRPC inbound<br/>8084/TCP"| ModelMesh["ModelMesh<br/>Orchestrator"]
    MRA -.->|"ConfigMap<br/>model-serving-config"| ModelmeshServing["modelmesh-serving<br/>Operator"]

    %% Inference Runtime Dependencies
    MRA -->|"gRPC outbound<br/>localhost"| Triton["Triton Inference Server"]
    MRA -->|"gRPC outbound<br/>localhost"| MLServer["MLServer"]
    MRA -->|"gRPC outbound<br/>localhost"| OVMS["OpenVINO Model Server"]
    MRA -->|"gRPC outbound<br/>localhost"| TorchServe["TorchServe"]

    %% Storage Dependencies
    MRA -->|"HTTPS/443<br/>model storage"| S3["S3 / IBM COS"]
    MRA -->|"HTTPS/443<br/>model storage"| Azure["Azure Blob Storage"]
    MRA -->|"HTTPS/443<br/>model storage"| GCS["Google Cloud Storage"]
    MRA -->|"HTTP(S)<br/>model storage"| HTTP["HTTP/HTTPS Endpoints"]

    %% Key Library Dependencies
    MRA -->|"gRPC framework"| GRPC["google.golang.org/grpc<br/>v1.56.3"]
    MRA -->|"storage SDK"| IBMCOS["IBM COS SDK<br/>v1.9.1"]
    MRA -->|"storage SDK"| AzureSDK["Azure SDK azblob<br/>v0.3.0"]
    MRA -->|"storage SDK"| GCSSDK["cloud.google.com/go/storage<br/>v1.28.1"]
    MRA -->|"Keras conversion"| TensorFlow["TensorFlow<br/>2.19.0 (Python)"]
    MRA -->|"logging"| Zap["go.uber.org/zap<br/>v1.24.0"]
    MRA -->|"path security"| SecureJoin["cyphar/filepath-securejoin<br/>v0.2.4"]

