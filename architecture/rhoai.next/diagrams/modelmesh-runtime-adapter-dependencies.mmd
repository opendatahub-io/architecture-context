graph LR
    MRA["ModelMesh Runtime Adapter<br/>(Sidecar Container)"]

    %% Internal Platform Dependencies (consumers/callers)
    ModelMesh["ModelMesh Serving<br/>(modelmesh-serving)"] -->|"gRPC 8084/8085<br/>LoadModel/UnloadModel"| MRA

    %% Runtime Dependencies (downstream, one per pod)
    MRA -->|"gRPC 8001/TCP<br/>RepositoryModelLoad"| Triton["NVIDIA Triton<br/>Inference Server"]
    MRA -->|"gRPC 8001/TCP<br/>RepositoryModelLoad"| MLServer["Seldon MLServer"]
    MRA -->|"HTTP 8001/TCP<br/>/v1/config/reload"| OVMS["OpenVINO Model<br/>Server (OVMS)"]
    MRA -->|"gRPC 7071+7070/TCP<br/>RegisterModel/Ping"| TorchServe["TorchServe"]

    %% Cloud Storage Dependencies (external egress)
    MRA -->|"HTTPS 443/TCP<br/>Static credentials"| S3["AWS S3 /<br/>IBM COS"]
    MRA -->|"HTTPS 443/TCP<br/>Service account JWT"| GCS["Google Cloud<br/>Storage"]
    MRA -->|"HTTPS 443/TCP<br/>Connection string"| Azure["Azure Blob<br/>Storage"]
    MRA -->|"HTTP(S) 80/443/TCP<br/>Custom headers"| HTTP["HTTP(S) Model<br/>Repositories"]

    %% Kubernetes Dependencies
    MRA -.->|"Volume mount<br/>credentials"| K8sSecrets["Kubernetes Secrets<br/>(storage-config)"]
    MRA -.->|"Volume mount<br/>symlink access"| K8sPVC["Kubernetes PVC"]

    %% Build Dependencies
    MRA -.->|"build"| Go["Go 1.23.6"]
    MRA -.->|"Keras conversion"| TF["TensorFlow 2.19.0<br/>+ Keras 3.11.3"]
    MRA -.->|"gRPC framework"| GoGRPC["google.golang.org/grpc<br/>1.56.3"]
    MRA -.->|"GCS provider"| GCSLib["cloud.google.com/go/storage<br/>1.28.1"]
    MRA -.->|"Azure provider"| AzureLib["azure-sdk-for-go<br/>0.13.2"]
    MRA -.->|"S3 provider"| IBMLib["ibm-cos-sdk-go<br/>1.9.1"]

    %% Styling
    style MRA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ModelMesh fill:#2ecc71,stroke:#333,color:#fff

    style Triton fill:#f5a623,stroke:#333
    style MLServer fill:#f5a623,stroke:#333
    style OVMS fill:#f5a623,stroke:#333
    style TorchServe fill:#f5a623,stroke:#333

    style S3 fill:#e74c3c,stroke:#333,color:#fff
    style GCS fill:#e74c3c,stroke:#333,color:#fff
    style Azure fill:#e74c3c,stroke:#333,color:#fff
    style HTTP fill:#e74c3c,stroke:#333,color:#fff

    style K8sSecrets fill:#8e44ad,stroke:#333,color:#fff
    style K8sPVC fill:#8e44ad,stroke:#333,color:#fff

    style Go fill:#999,stroke:#333
    style TF fill:#999,stroke:#333
    style GoGRPC fill:#999,stroke:#333
    style GCSLib fill:#999,stroke:#333
    style AzureLib fill:#999,stroke:#333
    style IBMLib fill:#999,stroke:#333
