graph TB
    subgraph TrustyAI["TrustyAI Explainability Service"]
        direction TB

        subgraph ServiceLayer["explainability-service (Quarkus REST)"]
            MetricsEndpoints["Metrics Endpoints<br/>/metrics/group/fairness/*<br/>/metrics/drift/*"]
            ExplainerEndpoints["Explainer Endpoints<br/>/explainers/local/*<br/>/explainers/global/*<br/>(disabled in RHOAI)"]
            ConsumerEndpoint["Consumer Endpoint<br/>/consumer/kserve/v2"]
            CloudEventConsumer["CloudEvent Consumer<br/>(Funqy function)"]
            DataEndpoints["Data Endpoints<br/>/data/upload, /data/download"]
            InfoEndpoints["Info Endpoints<br/>/info, /info/tags, /info/names"]
            HealthEndpoints["Health & Metrics<br/>/q/health/*, /q/metrics"]
        end

        subgraph Reconcilers["Payload Reconcilers"]
            MMReconciler["ModelMesh<br/>InferencePayload<br/>Reconciler"]
            KSReconciler["KServe<br/>InferencePayload<br/>Reconciler"]
        end

        subgraph StorageLayer["Storage Backends (CDI selected)"]
            PVCStorage["PVC Storage<br/>/inputs mount"]
            MinIOStorage["MinIO/S3 Storage<br/>HTTP/HTTPS"]
            DBStorage["Hibernate Storage<br/>MariaDB/MySQL"]
            MemStorage["Memory Storage<br/>(dev/test only)"]
        end

        subgraph Scheduling["Metric Scheduling"]
            PrometheusScheduler["Prometheus<br/>Scheduler"]
            PrometheusPublisher["Prometheus<br/>Publisher<br/>(Micrometer gauges)"]
        end

        ConsumerEndpoint --> MMReconciler
        CloudEventConsumer --> KSReconciler
        MMReconciler --> PVCStorage
        MMReconciler --> MinIOStorage
        MMReconciler --> DBStorage
        KSReconciler --> PVCStorage
        KSReconciler --> MinIOStorage
        KSReconciler --> DBStorage
        MetricsEndpoints --> PrometheusScheduler
        PrometheusScheduler --> PrometheusPublisher
    end

    subgraph CoreLib["explainability-core (Library)"]
        LIME["LIME"]
        SHAP["SHAP"]
        Counterfactual["Counterfactual<br/>(OptaPlanner)"]
        TSSaliency["Time Series<br/>Saliency"]
        SPD["SPD Metric"]
        DIR["DIR Metric"]
        DriftAlgos["Drift Detection<br/>KS-Test, Meanshift,<br/>Fourier MMD"]
    end

    subgraph ConnectorsLib["explainability-connectors (Library)"]
        GRPCConnector["gRPC Connector<br/>KServe V2 Protocol"]
        HTTPConnector["HTTP Connector<br/>KServe V2 Protocol"]
    end

    subgraph ArrowLib["explainability-arrow (Library)"]
        ArrowInterchange["Apache Arrow<br/>Data Interchange"]
    end

    %% External actors
    Client["Client / Dashboard"]
    ModelMesh["ModelMesh Serving"]
    KServeService["KServe InferenceService"]
    KnativeEventing["Knative Eventing<br/>(CloudEvents)"]
    ModelServer["KServe/ModelMesh<br/>Model Server"]
    Prometheus["Prometheus<br/>(ServiceMonitor)"]

    %% Inbound flows
    Client -->|"REST 8080/TCP"| MetricsEndpoints
    Client -->|"REST 8080/TCP"| ExplainerEndpoints
    Client -->|"REST 8080/TCP"| DataEndpoints
    Client -->|"REST 8080/TCP"| InfoEndpoints
    ModelMesh -->|"REST 8080/TCP"| ConsumerEndpoint
    KServeService -->|"CloudEvents via Knative"| KnativeEventing
    KnativeEventing -->|"HTTP 8080/TCP"| CloudEventConsumer
    Prometheus -->|"scrape /q/metrics"| HealthEndpoints

    %% Outbound flows
    ExplainerEndpoints -->|"uses"| CoreLib
    ExplainerEndpoints -->|"gRPC (plaintext)"| GRPCConnector
    GRPCConnector -->|"gRPC V2 protocol"| ModelServer
    MetricsEndpoints -->|"uses"| SPD
    MetricsEndpoints -->|"uses"| DIR
    MetricsEndpoints -->|"uses"| DriftAlgos

    %% Styling
    style TrustyAI fill:#e8f4f8,stroke:#4a90e2,stroke-width:2px
    style ServiceLayer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style CoreLib fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ConnectorsLib fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ArrowLib fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style StorageLayer fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Reconcilers fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style Scheduling fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style ModelMesh fill:#f9f9f9,stroke:#999,stroke-width:2px
    style KServeService fill:#f9f9f9,stroke:#999,stroke-width:2px
    style KnativeEventing fill:#f9f9f9,stroke:#999,stroke-width:2px
    style ModelServer fill:#f9f9f9,stroke:#999,stroke-width:2px
    style Prometheus fill:#f9f9f9,stroke:#999,stroke-width:2px
