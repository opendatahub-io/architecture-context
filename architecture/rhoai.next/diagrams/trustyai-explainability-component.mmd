graph TB
    subgraph TrustyAI["TrustyAI Explainability Service"]
        direction TB

        subgraph ServiceLayer["explainability-service (Quarkus REST)"]
            direction LR
            FairnessAPI["Fairness Endpoints<br/>/metrics/group/fairness/*<br/>SPD, DIR"]
            DriftAPI["Drift Endpoints<br/>/metrics/drift/*<br/>Meanshift, KS, FourierMMD"]
            ExplainerAPI["Explainer Endpoints<br/>/explainers/*<br/>LIME, SHAP, CF, TSSaliency, PDP<br/>(ODH only)"]
            ConsumerAPI["Consumer Endpoints<br/>/consumer/kserve/v2<br/>CloudEventConsumer"]
            DataAPI["Data Endpoints<br/>/data/upload, /data/download"]
            InfoAPI["Info Endpoints<br/>/info, /info/tags, /info/names"]
            HealthMetrics["Health & Metrics<br/>/q/health/*, /q/metrics"]
        end

        subgraph Scheduler["Prometheus Scheduler"]
            PrometheusScheduler["PrometheusScheduler<br/>Recurring metric computation<br/>Default interval: 5s"]
        end

        subgraph Storage["Storage Backends"]
            direction LR
            PVCStorage["PVCStorage<br/>CSV flat files<br/>/inputs/"]
            HibernateStorage["HibernateStorage<br/>MariaDB/MySQL<br/>JDBC"]
            MinioStorage["MinioStorage<br/>MinIO objects"]
            MemoryStorage["MemoryStorage<br/>In-memory"]
        end

        subgraph CoreLib["explainability-core (Library)"]
            direction LR
            FairnessAlgo["Fairness Metrics<br/>SPD, DIR"]
            DriftAlgo["Drift Detectors<br/>KS, Meanshift, FourierMMD"]
            ExplainAlgo["Explainability<br/>LIME, SHAP, CF,<br/>TSSaliency, PDP"]
            DataFrame["Dataframe<br/>Data Model"]
        end

        subgraph Connectors["explainability-connectors (Library)"]
            GRPCClient["KServe V2 gRPC Client<br/>grpc_predict_v2.proto"]
        end

        subgraph Arrow["explainability-arrow (Library)"]
            ArrowIPC["Apache Arrow IPC<br/>Java-Python bridge"]
        end
    end

    %% External interactions
    ModelMesh["ModelMesh<br/>Payload Processor"] -->|POST /consumer/kserve/v2<br/>8080/TCP| ConsumerAPI
    KServeLogger["KServe Inference Logger"] -->|CloudEvents<br/>8080/TCP| ConsumerAPI
    User["User / Dashboard"] -->|REST API<br/>8080/TCP| FairnessAPI
    User -->|REST API<br/>8080/TCP| DriftAPI
    User -->|REST API<br/>8080/TCP| ExplainerAPI
    User -->|REST API<br/>8080/TCP| DataAPI

    %% Internal flows
    FairnessAPI --> FairnessAlgo
    DriftAPI --> DriftAlgo
    ExplainerAPI --> ExplainAlgo
    ExplainAlgo --> GRPCClient
    ConsumerAPI --> Storage
    PrometheusScheduler --> FairnessAlgo
    PrometheusScheduler --> DriftAlgo
    PrometheusScheduler --> HealthMetrics

    %% External dependencies
    GRPCClient -->|gRPC V2 Predict| KServeInference["KServe/ModelMesh<br/>Inference Server"]
    HibernateStorage -->|JDBC 3306/TCP| MariaDB["MariaDB"]
    MinioStorage -->|HTTP/HTTPS| MinIO["MinIO"]
    Prometheus["Prometheus"] -->|scrape /q/metrics<br/>8080/TCP| HealthMetrics
    Operator["TrustyAI Service Operator"] -.->|manages| TrustyAI

    %% Styling
    style TrustyAI fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style ServiceLayer fill:#d5e8f9,stroke:#4a90e2
    style CoreLib fill:#d5e8f9,stroke:#4a90e2
    style Connectors fill:#d5e8f9,stroke:#4a90e2
    style Arrow fill:#d5e8f9,stroke:#4a90e2
    style Scheduler fill:#fff3cd,stroke:#f5a623
    style Storage fill:#e8f5e9,stroke:#7ed321
    style FairnessAPI fill:#4a90e2,color:#fff
    style DriftAPI fill:#4a90e2,color:#fff
    style ExplainerAPI fill:#4a90e2,color:#fff
    style ConsumerAPI fill:#4a90e2,color:#fff
    style DataAPI fill:#4a90e2,color:#fff
    style InfoAPI fill:#4a90e2,color:#fff
    style HealthMetrics fill:#4a90e2,color:#fff
    style ModelMesh fill:#e8e8e8,stroke:#999
    style KServeLogger fill:#e8e8e8,stroke:#999
    style KServeInference fill:#e8e8e8,stroke:#999
    style MariaDB fill:#f5a623,stroke:#333
    style MinIO fill:#f5a623,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#999
    style Operator fill:#7ed321,stroke:#333
    style User fill:#f9f9f9,stroke:#333
