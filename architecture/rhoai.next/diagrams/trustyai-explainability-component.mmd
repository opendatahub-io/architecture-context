graph TB
    subgraph TrustyAI["TrustyAI Explainability"]
        direction TB

        subgraph Service["explainability-service (Quarkus REST)"]
            direction TB
            FairnessAPI["Fairness API<br/>/metrics/group/fairness/*"]
            DriftAPI["Drift API<br/>/metrics/drift/*"]
            ExplainerAPI["Explainer API<br/>/explainers/* (disabled in RHOAI)"]
            ConsumerAPI["Consumer API<br/>/consumer/kserve/v2"]
            InfoAPI["Info/Data API<br/>/info, /data/*"]
            HealthMetrics["Health & Metrics<br/>/q/health/*, /q/metrics"]

            subgraph Reconcilers["Payload Reconcilers"]
                MMReconciler["ModelMeshInference<br/>PayloadReconciler"]
                KSReconciler["KServeInference<br/>PayloadReconciler"]
            end

            subgraph Scheduler["Prometheus Scheduler"]
                PromScheduler["PrometheusScheduler<br/>(@Scheduled, default 5s)"]
                PromPublisher["PrometheusPublisher<br/>(Micrometer Gauges)"]
            end

            subgraph Storage["Storage Layer (CDI Strategy)"]
                DataSource["DataSource Abstraction"]
                PVCStorage["PVCStorage<br/>(CSV flat files)"]
                MinioStorage["MinioStorage<br/>(S3-compatible)"]
                HibernateStorage["HibernateStorage<br/>(MariaDB/MySQL)"]
            end

            ConsumerAPI --> MMReconciler
            MMReconciler --> DataSource
            KSReconciler --> DataSource
            DataSource --> PVCStorage
            DataSource --> MinioStorage
            DataSource --> HibernateStorage

            FairnessAPI --> DataSource
            DriftAPI --> DataSource
            FairnessAPI --> PromScheduler
            DriftAPI --> PromScheduler
            PromScheduler --> DataSource
            PromScheduler --> PromPublisher
            PromPublisher --> HealthMetrics
        end

        subgraph Core["explainability-core (Library)"]
            FairnessMetrics["Fairness Metrics<br/>(SPD, DIR)"]
            DriftMetrics["Drift Metrics<br/>(KS, MMD, Meanshift)"]
            Explainers["Explainers<br/>(LIME, SHAP, CF, TSSaliency)"]
            DataFrame["DataFrame Abstractions"]
        end

        subgraph Connectors["explainability-connectors (Library)"]
            KServeV2Client["KServe v2 gRPC/HTTP Client"]
        end

        subgraph Arrow["explainability-arrow (Library)"]
            ArrowIPC["Apache Arrow IPC<br/>(Java-Python exchange)"]
        end
    end

    %% External Inputs
    ModelMesh["ModelMesh"] -->|"POST /consumer/kserve/v2<br/>inference payloads"| ConsumerAPI
    KServeEvents["KServe<br/>(Knative CloudEvents)"] -->|"HTTP CloudEvents<br/>request/response"| KSReconciler
    Client["Client / Dashboard"] -->|"POST fairness/drift<br/>metric requests"| FairnessAPI
    Client -->|"POST fairness/drift<br/>metric requests"| DriftAPI

    %% External Outputs
    ExplainerAPI -->|"gRPC/HTTP predictions"| KServeV2Client
    KServeV2Client -->|"gRPC plaintext"| InferenceServers["KServe/ModelMesh<br/>Inference Servers"]
    HealthMetrics -->|"GET /q/metrics<br/>Bearer SA token"| Prometheus["Prometheus"]

    %% Internal library usage
    FairnessAPI -.->|uses| FairnessMetrics
    DriftAPI -.->|uses| DriftMetrics
    ExplainerAPI -.->|uses| Explainers

    %% Operator
    Operator["TrustyAI Service Operator"] -.->|"deploys & configures<br/>per namespace"| Service

    %% Styling
    style Service fill:#4a90e2,stroke:#333,color:#fff
    style Core fill:#7ed321,stroke:#333,color:#fff
    style Connectors fill:#7ed321,stroke:#333,color:#fff
    style Arrow fill:#7ed321,stroke:#333,color:#fff
    style ModelMesh fill:#f5a623,stroke:#333
    style KServeEvents fill:#f5a623,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style InferenceServers fill:#e8e8e8,stroke:#333
    style Operator fill:#9b59b6,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
