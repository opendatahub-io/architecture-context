graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Git["Taxonomy Git Repo<br/>443/TCP HTTPS<br/>Basic auth / SSH key"]
        OCIReg["OCI Registry<br/>443/TCP HTTPS<br/>dockerconfigjson"]
    end

    subgraph Cluster["OPENSHIFT CLUSTER"]
        direction TB

        subgraph DSPANamespace["Namespace: Data Science Project"]
            direction TB
            DSPA["Data Science Pipelines<br/>Application"]
            PipelineRunner["Pipeline Runner Pod<br/>SA: pipeline-runner-dspa<br/>Image: odh-ml-pipelines-runtime-generic"]
            TeacherSecret["teacher-secret<br/>(Opaque)"]
            JudgeSecret["judge-secret<br/>(Opaque)"]
            TaxonomySecret["taxonomy-repo-secret<br/>(basic-auth / ssh-auth)"]
            OCISecret["OCI registry secret<br/>(dockerconfigjson)"]
            PVC["PVC<br/>(ReadWriteMany)"]

            DSPA -->|executes| PipelineRunner
            PipelineRunner -->|reads| TeacherSecret
            PipelineRunner -->|reads| JudgeSecret
            PipelineRunner -->|reads| TaxonomySecret
            PipelineRunner -->|reads| OCISecret
            PipelineRunner -->|mounts| PVC
        end

        subgraph TrainingNamespace["Namespace: Data Science Project (Training)"]
            TrainingMaster["Training Master Pod<br/>SA: default<br/>Image: RHELAI instructlab-nvidia<br/>Istio sidecar: DISABLED"]
            TrainingWorkers["Training Worker Pods<br/>SA: default<br/>Image: RHELAI instructlab-nvidia<br/>Istio sidecar: DISABLED"]

            TrainingMaster -->|PyTorch RDZV<br/>TCP, no TLS| TrainingWorkers
        end

        subgraph ModelServing["Namespace: Model Serving"]
            TeacherIS["Teacher InferenceService<br/>(KServe)"]
            JudgeIS["Judge InferenceService<br/>(KServe)"]
        end

        subgraph RegistryNS["Namespace: rhoai-model-registries"]
            ModelReg["Model Registry<br/>443/TCP HTTPS"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS (SA CA cert)<br/>Bearer token"]
        TrainOp["Training Operator<br/>443/TCP HTTPS"]
    end

    %% Pipeline task flows
    PipelineRunner -->|HTTPS/443<br/>TLS (SA CA)<br/>Bearer token| K8sAPI
    PipelineRunner -->|HTTPS/varies<br/>TLS (system CA)<br/>Bearer token (api_token)| TeacherIS
    PipelineRunner -->|HTTPS/varies<br/>TLS (system CA)<br/>Bearer token (api_token)| JudgeIS
    PipelineRunner -->|HTTPS/443<br/>TLS<br/>Bearer token (SA)| ModelReg
    PipelineRunner -->|HTTPS/443<br/>TLS<br/>dockerconfigjson| OCIReg
    PipelineRunner -->|HTTPS or SSH<br/>TLS / SSH<br/>Basic auth / SSH key| Git

    %% Training
    K8sAPI -->|creates via<br/>Training Operator| TrainingMaster
    TrainingMaster -->|reads/writes| PVC
    TrainingWorkers -->|reads/writes| PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pipeline fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef training fill:#e74c3c,stroke:#333,stroke-width:2px,color:#fff
    classDef serving fill:#f5a623,stroke:#333,stroke-width:2px
    classDef platform fill:#7ed321,stroke:#333,stroke-width:2px
    classDef secret fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef storage fill:#dfe6e9,stroke:#636e72,stroke-width:1px

    class Git,OCIReg external
    class DSPA,PipelineRunner pipeline
    class TrainingMaster,TrainingWorkers training
    class TeacherIS,JudgeIS serving
    class K8sAPI,TrainOp,ModelReg platform
    class TeacherSecret,JudgeSecret,TaxonomySecret,OCISecret secret
    class PVC storage
