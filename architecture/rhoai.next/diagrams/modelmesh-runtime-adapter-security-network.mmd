graph TB
    subgraph External["EXTERNAL (Cloud Storage - Encrypted)"]
        S3["S3 / MinIO / IBM COS<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Access Key + Secret Key"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Service Account"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Connection String / SPN"]
        HTTPSrc["HTTP/HTTPS Sources<br/>configurable port<br/>Optional TLS/mTLS<br/>Auth: Optional headers + certs"]
    end

    subgraph PodBoundary["POD BOUNDARY (ModelMesh Serving Pod)"]
        direction TB

        subgraph PullerContainer["model-serving-puller (sidecar)"]
            Puller["Puller gRPC Server<br/>8084/TCP plaintext<br/>Auth: None (loopback)<br/>FIPS: strictfipsruntime"]
            PullMan["PullMan Library<br/>Storage client cache<br/>1h TTL, credential hash key"]
        end

        subgraph AdapterContainer["Runtime Adapter (sidecar - one variant)"]
            Adapter["Adapter gRPC Server<br/>8085/TCP plaintext<br/>Auth: None (loopback)"]
        end

        subgraph RuntimeContainer["Target Runtime Server"]
            direction LR
            TritonRT["Triton<br/>gRPC 8001/TCP"]
            MLServerRT["MLServer<br/>gRPC 8001/TCP"]
            OVMSRT["OVMS<br/>HTTP 8001/TCP"]
            TorchServeRT["TorchServe<br/>gRPC 7071/TCP mgmt<br/>gRPC 7070/TCP inf"]
        end

        subgraph Volumes["Shared Volumes"]
            Models["/models<br/>(emptyDir)"]
            StorageConfig["/storage-config<br/>(Secret mount)"]
            PVCMount["/pvc_mounts<br/>(PVC mount, optional)"]
        end
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Control Plane)"]
        ModelMesh["ModelMesh Controller<br/>gRPC client"]
        MMController["modelmesh-controller<br/>ConfigMap management"]
        K8sAPI["Kubernetes API<br/>Secret + PVC provisioning"]
    end

    %% External flows (encrypted)
    PullMan -->|"HTTPS/443<br/>TLS 1.2+<br/>Access Key + Secret Key"| S3
    PullMan -->|"HTTPS/443<br/>TLS 1.2+<br/>SA private key"| GCS
    PullMan -->|"HTTPS/443<br/>TLS 1.2+<br/>Conn String / SPN"| Azure
    PullMan -->|"HTTP(S)/configurable<br/>Optional mTLS<br/>Optional headers"| HTTPSrc

    %% Cluster internal flows (plaintext within cluster)
    ModelMesh -->|"gRPC/8084<br/>plaintext<br/>No auth"| Puller

    %% Pod-internal flows (loopback only)
    Puller -->|"gRPC/8085<br/>plaintext loopback<br/>No auth"| Adapter
    Adapter -->|"gRPC/8001 plaintext<br/>loopback"| TritonRT
    Adapter -->|"gRPC/8001 plaintext<br/>loopback"| MLServerRT
    Adapter -->|"HTTP/8001 plaintext<br/>loopback"| OVMSRT
    Adapter -->|"gRPC/7071+7070<br/>plaintext loopback"| TorchServeRT

    %% Volume flows
    K8sAPI -.->|"Secret mount"| StorageConfig
    K8sAPI -.->|"PVC mount"| PVCMount
    MMController -.->|"ConfigMap<br/>storageHelperImage"| PodBoundary

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef runtime fill:#ffe6cc,stroke:#d79b00,stroke-width:1px

    class S3,GCS,Azure,HTTPSrc external
    class Puller,PullMan,Adapter pod
    class TritonRT,MLServerRT,OVMSRT,TorchServeRT runtime
    class ModelMesh,MMController,K8sAPI cluster
    class Models,StorageConfig,PVCMount storage
