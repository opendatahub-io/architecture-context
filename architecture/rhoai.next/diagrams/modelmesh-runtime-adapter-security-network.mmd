graph TB
    subgraph PodBoundary["POD BOUNDARY (Model Serving Pod)<br/>All internal: localhost / plaintext gRPC / no auth"]
        direction TB

        subgraph PullerSidecar["model-serving-puller Sidecar"]
            PullerGRPC["Puller gRPC Server<br/>mmesh.ModelRuntime<br/>localhost:8084/TCP<br/>Plaintext gRPC<br/>No auth interceptors"]
            Pullman["pullman Storage Client<br/>crypto/tls with custom CA<br/>Optional client cert mTLS"]
        end

        subgraph AdapterSidecar["Runtime Adapter Sidecar (one active)"]
            AdapterGRPC["Adapter gRPC Server<br/>mmesh.ModelRuntime<br/>localhost:8085/TCP<br/>Plaintext gRPC<br/>No auth interceptors"]
        end

        subgraph RuntimeContainer["Inference Runtime Container"]
            Runtime["Triton / MLServer / OVMS / TorchServe<br/>gRPC localhost<br/>Plaintext"]
        end
    end

    subgraph Internal["INTERNAL (Same Pod)"]
        ModelMesh["ModelMesh Orchestrator<br/>Calls via localhost"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress Only)"]
        S3["S3 / IBM COS<br/>443/TCP HTTPS<br/>TLS (SDK-managed)<br/>Access Key + Secret Key"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS (SDK-managed)<br/>Connection String / Azure Identity"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS (SDK-managed)<br/>Service Account JSON"]
        HTTP["HTTP/HTTPS Endpoints<br/>Configurable port<br/>Optional TLS + custom CA<br/>Optional client certs + headers"]
    end

    %% Flows
    ModelMesh -->|"gRPC/8084<br/>Plaintext<br/>No auth<br/>localhost only"| PullerGRPC
    PullerGRPC -->|"gRPC/8085<br/>Plaintext<br/>insecure.NewCredentials()<br/>localhost only"| AdapterGRPC
    AdapterGRPC -->|"gRPC/runtime port<br/>Plaintext<br/>localhost only"| Runtime

    Pullman -->|"HTTPS/443<br/>TLS (SDK)<br/>Access Key"| S3
    Pullman -->|"HTTPS/443<br/>TLS (SDK)<br/>Azure Identity"| Azure
    Pullman -->|"HTTPS/443<br/>TLS (SDK)<br/>SA JSON"| GCS
    Pullman -->|"HTTP(S)<br/>Optional TLS + mTLS<br/>Custom CA + client cert"| HTTP

    %% Styling
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef grpcserver fill:#4a90e2,color:#fff,stroke:#333,stroke-width:2px
    classDef storageclient fill:#7ed321,color:#fff,stroke:#333,stroke-width:2px

    class PullerGRPC,AdapterGRPC grpcserver
    class Pullman storageclient
    class Runtime pod
    class ModelMesh internal
    class S3,Azure,GCS,HTTP external
