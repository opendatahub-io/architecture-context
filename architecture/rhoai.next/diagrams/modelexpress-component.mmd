graph TB
    subgraph MX["ModelExpress System"]
        direction TB

        subgraph Operator["modelexpress-operator"]
            OpController["Operator Controller<br/>(kube-rs)"]
            OpMetrics["Metrics Endpoint<br/>8080/TCP"]
            OpHealth["Health Probes<br/>8081/TCP"]
        end

        subgraph OpOCP["modelexpress-operator-openshift"]
            TLSWatch["TLS Profile Watcher<br/>(apiservers.config.openshift.io)"]
            SvcMon["ServiceMonitor Manager"]
        end

        subgraph Server["modelexpress-server"]
            direction TB
            ApiSvc["ApiService<br/>(gRPC)"]
            ModelSvc["ModelService<br/>(gRPC)"]
            P2pSvc["P2pService<br/>(gRPC)"]
            RefitSvc["RefitService<br/>(gRPC)"]
            HealthSvc["HealthService<br/>(gRPC)"]
            AuthLayer["AuthLayer<br/>(TokenReview + SAR)"]
            AuthLayer --> ApiSvc
            AuthLayer --> ModelSvc
            AuthLayer --> P2pSvc
            AuthLayer --> RefitSvc
        end

        subgraph Client["modelexpress-client"]
            ClientLib["Rust/Python/Go<br/>Client Library"]
            CLI["CLI<br/>(health, download, list,<br/>validate, clear)"]
        end

        subgraph Common["modelexpress-common"]
            Proto["Protobuf Definitions<br/>(5 proto files)"]
            TLSSettings["TLS Settings"]
            ConfigTypes["Configuration Types"]
        end
    end

    %% CRDs
    MXServerCR["ModelExpressServer CR<br/>(modelexpress.opendatahub.io/v1alpha1)"]
    ModelMetaCR["ModelMetadata CR<br/>(modelexpress.nvidia.com/v1alpha1)"]
    CacheEntryCR["ModelCacheEntry CR<br/>(modelexpress.nvidia.com/v1alpha1)"]

    %% External
    K8sAPI["Kubernetes API<br/>443/TCP"]
    Redis["Redis<br/>6379/TCP"]
    HFHub["Hugging Face Hub<br/>443/TCP"]
    NGC["NGC Catalog<br/>443/TCP"]

    %% Relationships
    MXServerCR -->|watched by| OpController
    OpController -->|creates| Server
    OpController -->|creates Deployment, Service,<br/>PVC, RBAC, NetworkPolicy| K8sAPI
    TLSWatch -->|reads TLS profile| K8sAPI
    TLSWatch -->|applies defaults| OpController
    SvcMon -->|creates ServiceMonitor| K8sAPI

    Server -->|reads/writes metadata| Redis
    Server -->|reads/writes CRDs| K8sAPI
    Server -->|publishes| ModelMetaCR
    Server -->|publishes| CacheEntryCR
    Server -->|downloads models| HFHub
    Server -->|downloads models| NGC

    ClientLib -->|gRPC 8001/TCP| Server
    CLI -->|gRPC 8001/TCP| Server

    %% Styling
    style MX fill:#f0f4ff,stroke:#4a90e2,stroke-width:2px
    style Operator fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    style OpOCP fill:#e0e7ff,stroke:#6366f1,stroke-width:2px
    style Server fill:#d1fae5,stroke:#10b981,stroke-width:2px
    style Client fill:#fef3c7,stroke:#f59e0b,stroke-width:2px
    style Common fill:#f3e8ff,stroke:#8b5cf6,stroke-width:2px
    style MXServerCR fill:#fef08a,stroke:#ca8a04
    style ModelMetaCR fill:#fef08a,stroke:#ca8a04
    style CacheEntryCR fill:#fef08a,stroke:#ca8a04
    style K8sAPI fill:#e5e7eb,stroke:#6b7280
    style Redis fill:#e5e7eb,stroke:#6b7280
    style HFHub fill:#e5e7eb,stroke:#6b7280
    style NGC fill:#e5e7eb,stroke:#6b7280
