graph LR
    BGW["llm-d-batch-gateway"]

    %% External Dependencies (required infrastructure)
    BGW -->|"database driver<br/>(pgx v5.11.0)"| PostgreSQL["PostgreSQL"]
    BGW -->|"queue & events<br/>(go-redis v9.22.0)"| Redis["Redis / Valkey"]
    BGW -->|"file storage<br/>(AWS SDK v1.47.1)"| S3["S3-compatible Storage"]

    %% Internal Platform Dependencies
    BGW -->|"inference dispatch<br/>HTTP/HTTPS"| InferGW["llm-d Inference Gateway"]
    BGW -.->|"async dispatch<br/>(Go library)"| AsyncLib["llm-d-async"]

    %% Kubernetes Dependencies
    BGW -->|"pod watching<br/>(client-go v0.36.5)"| K8sAPI["Kubernetes API"]

    %% Observability Dependencies
    BGW -->|"metrics<br/>(client_golang v1.24.1)"| Prometheus["Prometheus"]
    BGW -->|"tracing<br/>(OTel v1.47.0)"| OTel["OpenTelemetry Collector"]

    %% Optional Dependencies
    BGW -.->|"TLS certs<br/>(optional)"| CertManager["cert-manager"]
    BGW -.->|"routing<br/>(optional HTTPRoute)"| GatewayAPI["Gateway API"]
    BGW -.->|"auth<br/>(delegated)"| Kuadrant["Kuadrant / Authorino"]

    %% Integration Points (other components that use this)
    ExtClient["External Client"] -->|"/v1/batches<br/>/v1/files"| BGW

