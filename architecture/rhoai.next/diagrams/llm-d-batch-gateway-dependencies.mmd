graph LR
    BatchGW["llm-d Batch Gateway<br/>(apiserver + processor + gc)"]

    %% External Dependencies (Required)
    BatchGW -->|"metadata storage<br/>5432/TCP"| PostgreSQL["PostgreSQL 12+"]
    BatchGW -->|"queue, events, status<br/>6379/TCP"| Redis["Redis 6+ / Valkey 8+"]
    BatchGW -->|"file storage<br/>443/TCP HTTPS"| S3["S3-Compatible Storage"]

    %% Internal Platform Dependencies (Required)
    BatchGW -->|"sync inference dispatch<br/>HTTP/HTTPS + mTLS"| LLMDRouter["llm-d Router"]
    BatchGW -->|"auth enforcement<br/>gateway proxy"| Kuadrant["Kuadrant / Authorino"]

    %% Internal Platform Dependencies (Optional)
    BatchGW -.->|"async dispatch<br/>Go lib + Redis queues"| LLMDAsync["llm-d-async v0.7.4"]
    BatchGW -.->|"ingress routing<br/>HTTPRoute CRD"| GatewayAPI["Gateway API"]

    %% External Dependencies (Optional)
    BatchGW -.->|"TLS certs<br/>Certificate CRD"| CertManager["cert-manager"]
    BatchGW -.->|"trace export<br/>gRPC/4317"| OTel["OTel Collector"]
    BatchGW -.->|"metrics scrape<br/>HTTP/8081,9090,9091"| Prometheus["Prometheus"]
    BatchGW -.->|"dashboard discovery<br/>ConfigMap sidecar"| Grafana["Grafana"]

    %% Styling
    style BatchGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external (dark)
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff

    %% Internal platform (green)
    style LLMDRouter fill:#7ed321,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style LLMDAsync fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff

    %% Optional external (gray)
    style CertManager fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style Grafana fill:#999,stroke:#333,color:#fff
