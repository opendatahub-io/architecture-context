graph LR
    DSPO["Data Science Pipelines<br/>Operator (DSPO)"]

    %% External Dependencies (Required)
    DSPO -->|"execution engine<br/>(bundled CRDs)"| Argo["Argo Workflows<br/>v3.6.12"]
    DSPO -->|"controller framework"| CR["controller-runtime<br/>v0.23.3"]
    DSPO -->|"metadata DB<br/>(managed or external)"| MariaDB["MariaDB 10.5"]
    DSPO -->|"gRPC-web proxy<br/>(MLMD access)"| Envoy["Envoy Proxy<br/>Service Mesh 2.6"]
    DSPO -->|"API auth sidecar<br/>(SubjectAccessReview)"| KRBP["kube-rbac-proxy"]
    DSPO -->|"auto TLS certs<br/>(pod-to-pod)"| ServiceCA["OpenShift<br/>service-CA"]

    %% External Dependencies (Optional)
    DSPO -.->|"dev/test artifacts<br/>(optional)"| MinIO["MinIO"]
    DSPO -.->|"experiment tracking<br/>(optional)"| MLflow["MLflow Operator<br/>v1"]

    %% Internal Platform Dependencies
    PlatformOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates DSPA CRs"| DSPO
    DSPO -->|"global CA bundle"| TrustedCA["odh-trusted-ca-bundle<br/>ConfigMap"]
    DSPO -->|"TLS security profile"| OSAPI["OpenShift APIServer<br/>(config.openshift.io)"]

    %% Downstream Integrations (via pipeline-runner RBAC)
    subgraph PipelineIntegrations["Pipeline Runner Integrations (RBAC)"]
        KServe["KServe<br/>(inferenceservices)"]
        Ray["Ray<br/>(rayclusters, rayjobs)"]
        Seldon["Seldon<br/>(seldondeployments)"]
        CodeFlare["CodeFlare<br/>(appwrappers)"]
    end
    DSPO -->|"pipeline steps can create"| PipelineIntegrations

    %% External Services
    DSPO -->|"artifact storage<br/>HTTP(S)"| S3["S3-Compatible<br/>Storage"]
    DSPO -->|"managed pipelines<br/>HTTPS/443"| OCI["OCI Container<br/>Registries"]
    DSPO -->|"controller ops<br/>HTTPS/443"| K8sAPI["Kubernetes<br/>API Server"]

    %% Consumers
    Dashboard["ODH Dashboard"] -->|"UI management"| DSPO
    Prometheus["Prometheus"] -->|"metrics scrape<br/>:8888/TCP"| DSPO

    %% Styling
    style DSPO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external deps
    style Argo fill:#999,stroke:#333,color:#fff
    style CR fill:#999,stroke:#333,color:#fff
    style MariaDB fill:#999,stroke:#333,color:#fff
    style Envoy fill:#999,stroke:#333,color:#fff
    style KRBP fill:#999,stroke:#333,color:#fff
    style ServiceCA fill:#999,stroke:#333,color:#fff

    %% Optional external deps
    style MinIO fill:#bbb,stroke:#333,color:#fff,stroke-dasharray:5 5
    style MLflow fill:#bbb,stroke:#333,color:#fff,stroke-dasharray:5 5

    %% Internal platform
    style PlatformOp fill:#7ed321,stroke:#333,color:#fff
    style TrustedCA fill:#7ed321,stroke:#333,color:#fff
    style OSAPI fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% Pipeline integrations
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Ray fill:#7ed321,stroke:#333,color:#fff
    style Seldon fill:#7ed321,stroke:#333,color:#fff
    style CodeFlare fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style S3 fill:#f5a623,stroke:#333
    style OCI fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333

    %% Consumers
    style Prometheus fill:#9b59b6,stroke:#333,color:#fff
