graph LR
    DSPO["Data Science Pipelines<br/>Operator (DSPO)"]

    %% External Dependencies (required)
    DSPO -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    DSPO -->|"manifest templating"| Manifestival["manifestival<br/>v0.7.2"]
    DSPO -->|"S3 health checks"| MinIOClient["minio-go/v7<br/>v7.0.99"]
    DSPO -->|"DB health checks"| MySQLDriver["go-sql-driver/mysql<br/>v1.9.3"]
    DSPO -->|"OCI manifest fetch"| GoContainerReg["go-containerregistry<br/>v0.21.3"]
    DSPO -->|"OpenShift API types"| OpenshiftAPI["openshift/api<br/>v0.0.0-20260331"]
    DSPO -->|"TLS profile mgmt"| OSCtrlCommon["openshift/controller-<br/>runtime-common<br/>v0.0.0-20260428"]
    DSPO -->|"config management"| Viper["spf13/viper<br/>v1.21.0"]
    DSPO -->|"live config reload"| FSNotify["fsnotify<br/>v1.9.0"]

    %% External Dependencies (optional)
    DSPO -.->|"MLflow integration"| MLflowAPI["mlflow-operator/api<br/>v0.0.0-20260331"]
    DSPO -.->|"chaos testing"| OperatorChaos["operator-chaos<br/>v0.0.0-20260525"]

    %% Internal Platform Dependencies
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"CRD: creates DSPA CRs"| DSPO
    DSPO -->|"watches CA bundle"| TrustedCA["odh-trusted-ca-bundle<br/>ConfigMap"]
    DSPO -->|"auto TLS certs"| ServiceCA["OpenShift service-ca<br/>operator"]
    DSPO -->|"TLS security profile"| APIServerConfig["OpenShift APIServer<br/>config"]
    DSPO -.->|"CRD watch: MLflow CR"| MLflowOp["MLflow Operator"]

    %% Integration Points (downstream)
    DSPO -->|"creates InferenceService CRs"| KServe["KServe"]
    DSPO -->|"creates RayCluster/Job CRs"| Ray["Ray"]
    DSPO -->|"creates SeldonDeployment CRs"| Seldon["Seldon"]
    DSPO -->|"creates AppWrapper CRs"| CodeFlare["CodeFlare"]
    DSPO -->|"manages Workflow CRs"| ArgoWF["Argo Workflows"]
    DSPO -->|"manages Pipeline CRs"| KFPipelines["Kubeflow Pipelines CRDs"]

    %% Integration Points (upstream consumers)
    Dashboard["ODH Dashboard"] -->|"UI management"| DSPO

    %% External Services
    DSPO -->|"pipeline metadata<br/>MySQL/3306"| MariaDB["MariaDB / External MySQL"]
    DSPO -->|"artifact storage<br/>HTTP(S)/9000 or 443"| S3["S3 / MinIO Storage"]
    DSPO -->|"managed pipelines<br/>HTTPS/443"| OCIReg["OCI Container Registry"]
    DSPO -->|"resource mgmt<br/>HTTPS/6443"| K8sAPI["Kubernetes API Server"]
    DSPO -->|"metrics scrape<br/>HTTP/8080"| Prometheus["Prometheus /<br/>ServiceMonitor"]
    DSPO -->|"image resolution"| ImageStreams["OpenShift<br/>ImageStreamTags"]

