graph TD
    subgraph "Service Accounts"
        MixtralSA["mixtral-sa"]
        PrometheusSA["prometheus-sa"]
        NFSServerSA["nfs-server-sa"]
        PipelineRunnerSA["pipeline-runner-dspa<br/>(pipeline execution)"]
    end

    subgraph "Role Bindings"
        MixtralBinding["mixtral-view<br/>(RoleBinding)"]
        PrometheusBinding["prometheus-view<br/>(RoleBinding)"]
        NFSAnyuidBinding["nfs-server-sa-anyuid<br/>(RoleBinding)"]
        NFSPrivilegedBinding["nfs-server-sa-privileged<br/>(RoleBinding)"]
    end

    subgraph "Roles (Namespace-scoped)"
        MixtralRole["mixtral-view-role<br/>(Role)"]
        PrometheusRole["prometheus-view-role<br/>(Role)"]
    end

    subgraph "ClusterRoles (Referenced)"
        AnyuidSCC["system:openshift:scc:anyuid<br/>(ClusterRole)"]
        PrivilegedSCC["system:openshift:scc:privileged<br/>(ClusterRole)"]
    end

    subgraph "API Resources"
        MixtralIS["serving.kserve.io<br/>InferenceService<br/>(resourceName: mixtral)"]
        PrometheusIS["serving.kserve.io<br/>InferenceService<br/>(resourceName: prometheus)"]
    end

    subgraph "Pipeline Runtime Permissions"
        K8sSecrets["core/v1<br/>Secrets"]
        K8sNamespaces["core/v1<br/>Namespaces"]
        PyTorchJobs["kubeflow.org<br/>PyTorchJobs"]
        InferenceServices["serving.kserve.io<br/>InferenceServices"]
    end

    %% Model serving RBAC
    MixtralSA -->|bound via| MixtralBinding
    MixtralBinding -->|grants| MixtralRole
    MixtralRole -->|get| MixtralIS

    PrometheusSA -->|bound via| PrometheusBinding
    PrometheusBinding -->|grants| PrometheusRole
    PrometheusRole -->|get| PrometheusIS

    %% NFS RBAC
    NFSServerSA -->|bound via| NFSAnyuidBinding
    NFSAnyuidBinding -->|grants| AnyuidSCC
    NFSServerSA -->|bound via| NFSPrivilegedBinding
    NFSPrivilegedBinding -->|grants| PrivilegedSCC

    %% Pipeline runner (implicit via SA token)
    PipelineRunnerSA -.->|reads via API| K8sSecrets
    PipelineRunnerSA -.->|reads via API| K8sNamespaces
    PipelineRunnerSA -.->|creates via<br/>Training Operator| PyTorchJobs
    PipelineRunnerSA -.->|checks status| InferenceServices

    style MixtralSA fill:#4a90e2,color:#fff
    style PrometheusSA fill:#4a90e2,color:#fff
    style NFSServerSA fill:#4a90e2,color:#fff
    style PipelineRunnerSA fill:#4a90e2,color:#fff
    style MixtralRole fill:#f5a623
    style PrometheusRole fill:#f5a623
    style AnyuidSCC fill:#e74c3c,color:#fff
    style PrivilegedSCC fill:#e74c3c,color:#fff
    style MixtralIS fill:#7ed321
    style PrometheusIS fill:#7ed321
    style K8sSecrets fill:#7ed321
    style K8sNamespaces fill:#7ed321
    style PyTorchJobs fill:#7ed321
    style InferenceServices fill:#7ed321
