        SA3["odh-dashboard<br/>NS: redhat-ods-applications<br/>UI + BFF, per-module SAs"]
        SA4["ai-gateway-operator<br/>NS: redhat-ods-applications<br/>30+ roles (RBAC amplification)"]
        SA5["agents-operator<br/>NS: redhat-ods-applications<br/>30+ roles, SPIFFE identity"]
        SA6["data-science-pipelines-operator<br/>NS: redhat-ods-applications<br/>Pipeline lifecycle"]
        SA7["notebook-controller-sa<br/>NS: redhat-ods-applications<br/>Workbench management"]
