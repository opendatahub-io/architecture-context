    subgraph RBACRoles["RBAC Landscape (913 roles, 187 CRDs)"]
        CR1["rhods-operator<br/>29 CRDs owned<br/>Full platform lifecycle<br/>DAG provisioning all components"]
        CR2["ai-gateway-operator<br/>30+ roles<br/>Escalation rights for sub-components<br/>MaaS + Batch Gateway + EPP"]
        CR3["kserve-controller-manager<br/>serving.kserve.io/*<br/>core/services, apps/deployments<br/>InferenceService + LLMInferenceService"]
        CR4["trainer-operator<br/>30+ roles<br/>PyTorchJob, TrainingRuntime<br/>Gang scheduling support"]
        CR5["agents-operator<br/>30+ roles<br/>AgentRuntime CRDs<br/>SPIFFE registration entries"]
    end

    subgraph ContainerSecurity["Container Security Patterns"]
        CS1["UBI9-minimal Base Images<br/>64 components<br/>Certified, vulnerability-scanned<br/>Regular CVE patching"]
        CS2["Distroless/Scratch Images<br/>20 components<br/>agents-op, kserve, kuberay,<br/>training-op, batch-gw, feast, etc."]
        CS3["FIPS-Compliant Builds<br/>Most Go components<br/>GOEXPERIMENT=strictfipsruntime<br/>GOFIPS140=v1.0.0 (DSPO)"]
        CS4["Non-Root Execution<br/>All components<br/>UID 1001, 2000, or 65532<br/>Group 0 for OpenShift compat"]
        CS5["Multi-Stage Builds<br/>All Go + Python components<br/>Build deps excluded from runtime<br/>Reduced attack surface"]
        CS6["RELATED_IMAGE Disconnected<br/>All OLM-managed operators<br/>Image mirroring for air-gap<br/>oc-mirror digest pinning"]
        CS7["Konflux/Tekton Pipelines<br/>All productized components<br/>Hermetic Cachi2 prefetch<br/>Supply chain attestation"]
    end

    subgraph FIPSGaps["FIPS Compliance Gaps"]
        FG1["fms-guardrails-orchestrator<br/>Rust: ring/rustls<br/>NOT FIPS-validated"]
        FG2["Some module controllers<br/>CGO_ENABLED=0<br/>Missing FIPS flags"]
        FG3["agents-operator Token Broker<br/>Lacks Konflux Dockerfile<br/>Build provenance gap"]
    end

    subgraph TLSConfig["TLS Configuration"]
        TLS1["Service-Serving Certificates<br/>Automatic via annotations<br/>kubeflow, model-registry-op,<br/>modelmesh, DSPO, dashboard,<br/>rhods-operator, trustyai-op"]
        TLS2["cert-manager Certificates<br/>Operator-managed TLS<br/>agents-op, modelmesh, kserve,<br/>llm-d components, workbenches"]
        TLS3["Cluster TLS Profile Alignment<br/>Dynamic read + restart on change<br/>rhods-op, trustyai-op, model-reg-op,<br/>workbenches-op, feast-op, kuberay,<br/>spark-op, trainer, odh-model-ctrl"]
        TLS4["Webhook TLS<br/>9443/TCP Server TLS<br/>KServe, Kueue, TrustyAI,<br/>model-registry-operator"]
        TLS5["Metrics TLS<br/>8443/TCP via kube-rbac-proxy<br/>26+ components<br/>ServiceMonitor/PodMonitor scraping"]
    end

    subgraph TLSRisks["TLS Configuration Risks"]
        TR1["InsecureSkipVerify present<br/>DSPO MariaDB (opt-in),<br/>Feast internal registry calls"]
        TR2["NoVerifier struct<br/>fms-guardrails-orchestrator<br/>In production code"]
        TR3["Hardcoded TLS 1.2+<br/>Some components use fixed<br/>cipher suites vs cluster profile"]
    end

    subgraph ServiceMeshSecurity["Service Mesh Security"]
        SM1["PeerAuthentication<br/>STRICT: model-registry, MaaS<br/>PERMISSIVE: caikit-tgis-serving<br/>NOT mesh-wide"]
        SM2["AuthorizationPolicy<br/>model-registry: svc-to-svc ACL<br/>models-as-a-service: svc-to-svc ACL"]
        SM3["SPIFFE Identity (ZTWIM)<br/>X.509-SVIDs per workload<br/>agents-operator AuthBridge<br/>4 deployment shapes, 3 mTLS modes"]
        SM4["NetworkPolicy Enforcement<br/>37 policies, 17 components<br/>MaaS: 10 policies (most restricted)<br/>model-registry: 4, modelmesh: 4"]
    end

