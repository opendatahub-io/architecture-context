graph TD
    subgraph AuthMech["Authentication Mechanisms (7 patterns)"]
        OAuth["OAuth2/OIDC<br/>kube-auth-proxy in<br/>platform gateway"]
        KuadrantAuth["Kuadrant AuthPolicy<br/>+ TokenRateLimitPolicy<br/>Per-route enforcement"]
        APIKey["API Key (SHA-256)<br/>MaaS tenant access<br/>Authorino HTTP callback"]
        KRBAC["kube-rbac-proxy<br/>SubjectAccessReview<br/>8+ components"]
        mTLSAuth["mTLS (Istio)<br/>Mesh-level identity<br/>Serving paths + MaaS"]
        BearerSA["Bearer Token<br/>(ServiceAccount)<br/>All controllers"]
        SAIsolation["SA Token Isolation<br/>odh-dashboard pod<br/>shell vs BFF tokens"]
    end

    subgraph KeySAs["Key ServiceAccounts"]
        SA_rhods["rhods-operator<br/>NS: redhat-ods-operator"]
        SA_kserve["kserve-controller-manager<br/>NS: redhat-ods-applications"]
        SA_dashboard["odh-dashboard<br/>NS: redhat-ods-applications"]
        SA_dashmod["odh-dashboard-modules<br/>NS: redhat-ods-applications"]
        SA_aigw["ai-gateway-operator<br/>NS: redhat-ods-operator"]
        SA_maas["maas-controller<br/>NS: odh-ai-gateway-infra"]
        SA_odmctrl["odh-model-controller<br/>NS: redhat-ods-applications"]
    end

    subgraph CRoles["ClusterRoles (Top Privileged)"]
        CR_rhods["rhods-operator<br/>components.platform.opendatahub.io/*<br/>datascienceclusters/*<br/>dscinitialization/*"]
        CR_kserve["kserve-manager-role<br/>serving.kserve.io/*<br/>core/services, apps/deployments<br/>autoscaling/hpa"]
        CR_kueue["kueue-manager-role<br/>kueue.x-k8s.io/*<br/>batch/jobs<br/>scheduling gates"]
        CR_aigw["ai-gateway-operator<br/>maas.opendatahub.io/*<br/>gateway.networking.k8s.io/*<br/>kuadrant.io/*"]
        CR_dashboard["odh-dashboard-role<br/>opendatahub.io/*<br/>monitoring.coreos.com/*"]
    end

    subgraph Secrets["Critical Secrets"]
        Sec_webhook["kserve-webhook-server-cert<br/>Type: kubernetes.io/tls<br/>Webhook TLS cert"]
        Sec_storage["storage-config<br/>Type: Opaque<br/>S3 credentials for models"]
        Sec_apikeys["maas-api-keys<br/>Type: Opaque<br/>SHA-256 hashed tenant keys"]
        Sec_oauth["oauth-proxy-tls<br/>Type: kubernetes.io/tls<br/>Dashboard HTTPS"]
        Sec_hf["huggingface-secret<br/>Type: Opaque<br/>HuggingFace API token"]
    end

    subgraph TLSConfig["TLS Configuration"]
        TLS_webhook["Webhook Servers<br/>9443/TCP Server TLS<br/>cert-manager or OCP<br/>serving cert"]
        TLS_metrics["Metrics Endpoints<br/>8443/TCP Server TLS<br/>kube-rbac-proxy<br/>cluster TLS profile"]
        TLS_mesh["Service Mesh Internal<br/>Istio mTLS<br/>serving paths, MaaS,<br/>Caikit-TGIS"]
        TLS_gw["Platform Gateway<br/>443/TCP Server TLS<br/>Envoy + kube-auth-proxy<br/>cluster TLS profile"]
    end

    subgraph ContainerSec["Container Security Patterns"]
        CS_nonroot["Non-root Execution<br/>361 of 517 Dockerfiles (70%)<br/>UID 1001 or 65532"]
        CS_ubi["UBI Base Images<br/>199 Dockerfiles (38%)<br/>FIPS-validated crypto"]
        CS_distroless["Distroless Runtime<br/>23 Dockerfiles (4%)<br/>Minimal attack surface"]
        CS_multistage["Multi-stage Builds<br/>Widespread<br/>Separate build/runtime"]
        CS_fips["FIPS Compliance<br/>Go: strictfipsruntime tag<br/>Python: UBI OpenSSL"]
        CS_scratch["Scratch Base<br/>9 Dockerfiles<br/>Zero OS dependencies"]
        CS_scc["SecurityContextConstraints<br/>KServe multi-node,<br/>codeflare-operator<br/>anyuid SCC when needed"]
    end

    subgraph NetPolicies["Network Policies (32 total)"]
        NP_modelmesh["modelmesh-serving<br/>5 policies"]
        NP_modelreg["model-registry-operator<br/>4 policies"]
        NP_maas["models-as-a-service<br/>3 policies"]
        NP_other["ai-gateway, kserve,<br/>data-science-pipelines<br/>1-2 policies each"]
    end

    subgraph MeshSec["Service Mesh Security"]
        MeshMode["mTLS Mode: MIXED<br/>Not mesh-wide STRICT<br/>Enabled on serving paths"]
        MeshDR["DestinationRules<br/>TLS origination<br/>for external services"]
        MeshNote["Note: Some components use<br/>InsecureSkipVerify=true<br/>for internal TLS<br/>(MaaS, llm-d metrics)"]
    end

    %% SA to ClusterRole bindings
    SA_rhods -->|bound to| CR_rhods
    SA_kserve -->|bound to| CR_kserve
    SA_aigw -->|bound to| CR_aigw
    SA_dashboard -->|bound to| CR_dashboard

    %% SA to Auth mechanism links
    SA_dashboard -->|uses| OAuth
    SA_dashboard -->|uses| SAIsolation
    SA_dashmod -->|uses| SAIsolation
    SA_kserve -->|uses| BearerSA
    SA_kserve -->|uses| KRBAC
    SA_maas -->|uses| APIKey
    SA_maas -->|uses| KuadrantAuth
    SA_rhods -->|uses| BearerSA
    SA_aigw -->|uses| BearerSA

    %% SA to Secrets
    SA_kserve -->|uses| Sec_webhook
    SA_kserve -->|uses| Sec_storage
    SA_dashboard -->|uses| Sec_oauth
    SA_maas -->|uses| Sec_apikeys

    %% TLS to supporting infrastructure
    TLS_webhook -->|cert from| Sec_webhook
    TLS_metrics -->|enforced by| KRBAC
    TLS_mesh -->|enforced by| MeshMode
    TLS_gw -->|enforced by| OAuth

    %% Network policies
    NP_modelmesh -.->|restricts| MeshMode
    NP_modelreg -.->|restricts| MeshMode
    NP_maas -.->|restricts| MeshMode

