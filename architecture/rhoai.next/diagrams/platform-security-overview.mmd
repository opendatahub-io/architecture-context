        Auth3["kube-auth-proxy<br/>OAuth2/OIDC Code Flow<br/>Gateway API ingress"]
        Auth4["Kubernetes API Server Auth<br/>ServiceAccount tokens<br/>37 operators/controllers"]
        Auth5["OAuth Proxy Sidecar<br/>OpenShift OAuth<br/>RayCluster dashboards, Argo"]
        Auth6["SPIFFE/mTLS (AuthBridge)<br/>X.509 SVIDs via SPIRE<br/>Agent workloads, A2A protocol"]
        Auth7["Istio AuthorizationPolicy<br/>Service-to-service ACL<br/>model-registry, MaaS"]
    end

