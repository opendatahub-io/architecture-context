graph TB
    subgraph Operator["LLM-D Batch Gateway Operator"]
        direction TB
        LBGController["LLMBatchGateway Controller<br/>(Reconciler)"]
        MetricsCtrl["Metrics Controller<br/>(Reconciler)"]
        BatchChart["Batch-Gateway<br/>Helm Chart<br/>(Embedded)"]
        AsyncChart["Async-Processor<br/>Helm Chart<br/>(Embedded)"]
        SecretSync["Secret Sync<br/>(Cross-Namespace)"]

        LBGController -->|renders| BatchChart
        LBGController -->|renders| AsyncChart
        LBGController -->|resolves secrets| SecretSync
    end

    User["Platform Admin"] -->|creates| LBGateCR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1"]
    LBGateCR -->|watched by| LBGController

    subgraph ManagedSync["Managed Resources (Sync Mode)"]
        APIServer["API Server<br/>Deployment<br/>8000/TCP"]
        Processor["Processor<br/>Deployment"]
        GC["Garbage Collector<br/>Deployment"]
        APIServerSvc["API Server Service<br/>ClusterIP 8000/TCP"]
        APIServerCM["API Server ConfigMap"]
        ProcessorCM["Processor ConfigMap"]
        GCCM["GC ConfigMap"]
    end

    subgraph ManagedAsync["Managed Resources (Async Mode)"]
        AsyncProcessor["Async Processor<br/>Deployment"]
        AsyncCM["Async ConfigMap"]
        AsyncSA["Async ServiceAccount"]
    end

    subgraph ManagedObservability["Managed Observability Resources"]
        SvcMonitor["ServiceMonitor"]
        PodMonitor["PodMonitor"]
        PromRule["PrometheusRule"]
        GrafanaDash["Grafana Dashboards"]
    end

    subgraph ManagedIngress["Managed Ingress (Optional)"]
        HTTPRoute["HTTPRoute<br/>/v1/batches, /v1/files"]
        TLSCert["Certificate<br/>(cert-manager)"]
    end

    BatchChart -->|SSA| APIServer
    BatchChart -->|SSA| Processor
    BatchChart -->|SSA| GC
    BatchChart -->|SSA| APIServerSvc
    BatchChart -->|SSA| APIServerCM
    BatchChart -->|SSA| ProcessorCM
    BatchChart -->|SSA| GCCM
    BatchChart -->|SSA| HTTPRoute
    BatchChart -->|SSA| TLSCert
    BatchChart -->|SSA| SvcMonitor
    BatchChart -->|SSA| PodMonitor
    BatchChart -->|SSA| PromRule
    AsyncChart -->|SSA| AsyncProcessor
    AsyncChart -->|SSA| AsyncCM
    AsyncChart -->|SSA| AsyncSA

    MetricsCtrl -->|self-heals| OpMetricsSvc["Operator Metrics Service<br/>8443/TCP"]
    MetricsCtrl -->|self-heals| OpSvcMonitor["Operator ServiceMonitor"]
    MetricsCtrl -->|self-heals| OpPromRule["Operator PrometheusRule"]

    SecretSync -->|copies via ReferenceGrant| TargetSecret["Cross-NS Secret"]
    TargetSecret -->|copied to| ManagedSecret["{name}-credentials<br/>in CR namespace"]

    LBGController -->|watches| KubeAPI["kube-apiserver<br/>443/TCP HTTPS"]

    Processor -->|dispatches inference| InferenceGW["Inference Gateway<br/>(llm-d GIE/EPP)"]
    APIServer -->|persists jobs| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    APIServer -->|stores files| S3["S3-Compatible<br/>Storage 443/TCP"]
    AsyncProcessor -->|queues via| Redis["Redis/Valkey<br/>6379/TCP"]

    PlatformOp["rhods-operator /<br/>opendatahub-operator"] -->|deploys via kustomize| Operator

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style LBGController fill:#2c6fbb,stroke:#333,color:#fff
    style MetricsCtrl fill:#2c6fbb,stroke:#333,color:#fff
    style BatchChart fill:#5ba3d9,stroke:#333,color:#fff
    style AsyncChart fill:#5ba3d9,stroke:#333,color:#fff
    style SecretSync fill:#5ba3d9,stroke:#333,color:#fff
    style LBGateCR fill:#f5a623,stroke:#333,color:#000
    style ManagedSync fill:#d5e8d4,stroke:#82b366
    style ManagedAsync fill:#dae8fc,stroke:#6c8ebf
    style ManagedObservability fill:#fff2cc,stroke:#d6b656
    style ManagedIngress fill:#ffe6cc,stroke:#d79b00
    style APIServer fill:#a8d08d,stroke:#333
    style Processor fill:#a8d08d,stroke:#333
    style GC fill:#a8d08d,stroke:#333
    style AsyncProcessor fill:#93c5fd,stroke:#333
    style InferenceGW fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style KubeAPI fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#7ed321,stroke:#333,color:#fff
