graph TB
    subgraph Operator["llm-d-batch-gateway-operator"]
        direction TB
        Reconciler["LLMBatchGatewayReconciler<br/>Primary controller"]
        MetricsCtrl["MetricsController<br/>Operator monitoring"]
        TLSWatcher["TLS Profile Watcher<br/>SecurityProfileWatcher"]
        HelmRenderer["Helm Renderer<br/>Helm v3 SDK"]

        Reconciler -->|"renders charts via"| HelmRenderer
        TLSWatcher -->|"triggers restart on<br/>profile change"| Reconciler
    end

    User["Platform Admin"] -->|"creates"| CR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1"]
    CR -->|"watched by"| Reconciler

    subgraph Operands["Helm-Rendered Operands"]
        direction TB
        APIServer["API Server<br/>OpenAI-compatible batch endpoint"]
        Processor["Processor<br/>Inference dispatch (sync)"]
        GC["Garbage Collector<br/>Expired job cleanup"]
        AsyncProc["Async Processor<br/>Redis queue dispatch (optional)"]
    end

    HelmRenderer -->|"batch-gateway chart"| APIServer
    HelmRenderer -->|"batch-gateway chart"| Processor
    HelmRenderer -->|"batch-gateway chart"| GC
    HelmRenderer -->|"async-processor chart<br/>(dispatchMode=async)"| AsyncProc

    Reconciler -->|"Server-Side Apply"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Reconciler -->|"orphan cleanup"| K8sAPI
    Reconciler -->|"cross-ns secret sync"| K8sAPI
    MetricsCtrl -->|"ensures"| MetricsSvc["Metrics Service<br/>8443/TCP HTTPS"]
    MetricsCtrl -->|"ensures"| ServiceMonitor["ServiceMonitor"]
    MetricsCtrl -->|"ensures"| PrometheusRule["PrometheusRule<br/>Alert: high error rate,<br/>leader election loss"]

    Reconciler -->|"creates (conditional)"| CertManagerCR["Certificate CR"]
    Reconciler -->|"creates (conditional)"| HTTPRoute["HTTPRoute"]
    Reconciler -->|"reads"| RefGrant["ReferenceGrant"]

    TLSWatcher -->|"reads/watches"| OSConfig["OpenShift APIServer<br/>config.openshift.io/v1"]

    style Reconciler fill:#4a90e2,color:#fff
    style MetricsCtrl fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style HelmRenderer fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#000
    style APIServer fill:#7ed321,color:#000
    style Processor fill:#7ed321,color:#000
    style GC fill:#7ed321,color:#000
    style AsyncProc fill:#7ed321,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style OSConfig fill:#e8e8e8,color:#000
    style CertManagerCR fill:#d5e8d4,color:#000
    style HTTPRoute fill:#d5e8d4,color:#000
    style RefGrant fill:#d5e8d4,color:#000
