graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_AIGW["ai-gateway-operator<br/>(applications namespace)"]
        SA_BGW["llm-d-batch-gateway-operator<br/>(applications namespace)"]
        SA_MaaS["maas-controller<br/>(applications namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_AIGW["ai-gateway-operator<br/>(ClusterRoleBinding)"]
        CRB_BGW["llm-d-batch-gateway-operator<br/>(ClusterRoleBinding)"]
        CRB_MaaS["maas-controller-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(applications NS)"]
        RB_Secret["maas-controller-secret-migrate<br/>(infrastructure NS)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role<br/>(ai-gateway-operator)<br/>20+ API groups, 60+ RBAC markers"]
        CR_BGW["llm-d-batch-gateway-operator<br/>(ClusterRole)"]
        CR_MaaS["maas-controller-role<br/>(ClusterRole)"]
        CR_Leader["leader-election-role"]
        CR_Metrics["metrics-reader"]
    end

    subgraph Roles["Namespace Roles"]
        R_SecretMigrate["maas-controller-secret-migrate<br/>(infrastructure NS)"]
    end

    %% SA → CRB → CR bindings
    SA_AIGW -->|"bound via"| CRB_AIGW
    CRB_AIGW -->|"grants"| CR_Manager

    SA_BGW -->|"bound via"| CRB_BGW
    CRB_BGW -->|"grants"| CR_BGW

    SA_MaaS -->|"bound via"| CRB_MaaS
    CRB_MaaS -->|"grants"| CR_MaaS

    %% Namespace bindings
    SA_AIGW -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| CR_Leader

    SA_MaaS -->|"bound via"| RB_Secret
    RB_Secret -->|"grants"| R_SecretMigrate

    subgraph PlatformResources["Platform Resources (components.platform.opendatahub.io)"]
        AIGateway["AIGateway<br/>aigateways, /status, /finalizers"]
        DSCI_R["DSCInitialization<br/>dscinitializations"]
    end

    subgraph BatchResources["Batch Resources (batch.llm-d.ai)"]
        LLMBatchGW["LLMBatchGateway<br/>llmbatchgateways, /status, /finalizers"]
    end

    subgraph MaaSResources["MaaS Resources (maas.opendatahub.io)"]
        AITenant["AITenant"]
        MaaSConfig["Config"]
        MaaSSub["MaaSSubscription"]
        MaaSAuth["MaaSAuthPolicy"]
        MaaSModel["MaaSModelRef"]
        MaaSTenant["MaaSTenantConfig"]
        MaaSExtModel["ExternalModel"]
    end

    subgraph GatewayResources["Gateway Resources (gateway.networking.k8s.io)"]
        GW["Gateway"]
        HTTPRoute["HTTPRoute"]
        RefGrant["ReferenceGrant"]
    end

    subgraph IstioResources["Istio Resources (networking.istio.io)"]
        DestRule["DestinationRule"]
        EnvoyFilter["EnvoyFilter"]
        SvcEntry["ServiceEntry"]
    end

    subgraph KuadrantResources["Kuadrant Resources (kuadrant.io)"]
        AuthPolicy["AuthPolicy"]
        TRL["TokenRateLimitPolicy"]
        RLP["RateLimitPolicy"]
    end

    subgraph CoreResources["Core K8s Resources"]
        Deployments["apps/Deployments"]
        Services["core/Services"]
        Secrets["core/Secrets"]
        ConfigMaps["core/ConfigMaps"]
        Namespaces["core/Namespaces"]
        CRDs_R["apiextensions/CRDs"]
        RBAC_R["rbac/ClusterRoles,<br/>RoleBindings"]
    end

    subgraph MonitoringResources["Monitoring Resources (monitoring.coreos.com)"]
        PodMon["PodMonitor"]
        SvcMon["ServiceMonitor"]
        PromRule["PrometheusRule"]
    end

    %% manager-role permissions
    CR_Manager -->|"full CRUD"| AIGateway
    CR_Manager -->|"get,list,watch"| DSCI_R
    CR_Manager -->|"full CRUD<br/>(RBAC escalation)"| LLMBatchGW
    CR_Manager -->|"full CRUD<br/>(RBAC escalation)"| AITenant
    CR_Manager -->|"full CRUD<br/>(RBAC escalation)"| MaaSConfig
    CR_Manager -->|"full CRUD<br/>(RBAC escalation)"| MaaSSub
    CR_Manager -->|"full CRUD"| HTTPRoute
    CR_Manager -->|"get,list,watch"| GW
    CR_Manager -->|"full CRUD"| AuthPolicy
    CR_Manager -->|"full CRUD"| DestRule
    CR_Manager -->|"full CRUD"| Deployments
    CR_Manager -->|"varies"| CoreResources
    CR_Manager -->|"full CRUD"| MonitoringResources

    %% Secret migrate role
    R_SecretMigrate -->|"get,list,create,<br/>update,patch"| Secrets

