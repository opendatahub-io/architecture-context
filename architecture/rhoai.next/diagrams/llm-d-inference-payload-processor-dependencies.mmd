graph LR
    IPP["Inference Payload Processor<br/>(IPP)"]

    %% External Dependencies (Required)
    IPP -->|"ext-proc invocation<br/>gRPC/9004"| Envoy["Envoy Proxy<br/>(ext-proc support required)"]
    IPP -->|"ConfigMap watch<br/>HTTPS/443"| K8sAPI["Kubernetes API Server<br/>v1.31+"]
    IPP -->|"lifecycle mgmt<br/>metrics, health, reconciler"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    IPP -->|"ext-proc protobuf types"| GoControlPlane["envoy go-control-plane<br/>v1.37.0"]

    %% External Dependencies (Optional)
    IPP -.->|"trace export<br/>gRPC/4317 OTLP"| OTel["OpenTelemetry Collector"]
    IPP -.->|"metrics scrape<br/>HTTP/9090"| Prometheus["Prometheus"]

    %% Internal llm-d Dependencies
    IPP -->|"complementary ext-proc<br/>(IPP selects pool,<br/>EPP selects pod)"| EPP["llm-d Router (EPP)"]
    IPP -->|"header injection for<br/>HTTPRoute matching"| InferencePool["InferencePool<br/>(Gateway API Inference Ext)"]

    %% Integration Points (consuming IPP)
    IstioGW["Istio Gateway"] -->|"EnvoyFilter insertion<br/>into filter chain"| IPP
    GKEGW["GKE Gateway"] -->|"GCPRoutingExtension<br/>routing registration"| IPP

    %% Downstream
    InferencePool -->|"pod selection"| EPP
    EPP -->|"inference request<br/>HTTP/8000"| ModelServers["Model Servers<br/>(vLLM, etc.)"]

    %% ConfigMap data source
    IPP -->|"adapter→base model<br/>label: inference.llm-d.ai/<br/>ipp-managed"| ConfigMaps["Kubernetes ConfigMaps"]

    %% Styling
    style IPP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external deps
    style Envoy fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style GoControlPlane fill:#999,stroke:#333,color:#fff

    %% Optional external deps
    style OTel fill:#ccc,stroke:#333
    style Prometheus fill:#ccc,stroke:#333

    %% Internal llm-d
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style InferencePool fill:#7ed321,stroke:#333,color:#fff

    %% Integration points
    style IstioGW fill:#f5a623,stroke:#333,color:#fff
    style GKEGW fill:#f5a623,stroke:#333,color:#fff

    %% Downstream
    style ModelServers fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#dae8fc,stroke:#6c8ebf
