    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_BatchAdmin fill:#f5a623,color:#fff
    style CR_BatchUser fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff
    style KueueCRDs fill:#7ed321,color:#fff
    style BatchRes fill:#7ed321,color:#fff
