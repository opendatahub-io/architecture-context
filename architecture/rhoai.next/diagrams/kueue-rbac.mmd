graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kueue-controller-manager"]
        SA_MetricsReader["kueue-controller-manager-<br/>metrics-reader"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["kueue-manager-<br/>rolebinding"]
        CRB_MetricsAuth["kueue-metrics-auth-<br/>rolebinding"]
        CRB_ReadMetrics["kueue-controller-manager-<br/>read-metrics"]
    end

    subgraph RoleBindings["Role Bindings (opendatahub ns)"]
        RB_Leader["kueue-leader-election-<br/>rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["kueue-manager-role"]
        CR_MetricsAuth["kueue-metrics-auth-role"]
        CR_MetricsReader["kueue-metrics-reader"]
        CR_BatchAdmin["kueue-batch-admin-role<br/>(aggregated)"]
        CR_BatchUser["kueue-batch-user-role<br/>(aggregated)"]
    end

    subgraph Roles["Roles"]
        R_Leader["kueue-leader-election-role"]
    end

    subgraph KueueResources["Kueue API Resources (kueue.x-k8s.io)"]
        KueueCRDs["ClusterQueue, LocalQueue,<br/>Workload, ResourceFlavor,<br/>AdmissionCheck, Cohort,<br/>WorkloadPriorityClass, Topology"]
    end

    subgraph WorkloadResources["Workload API Resources"]
        BatchRes["batch/v1 Jobs"]
        KubeflowRes["kubeflow.org<br/>PyTorchJob, TFJob, MPIJob,<br/>PaddleJob, XGBoostJob"]
        RayRes["ray.io<br/>RayJob, RayCluster"]
        JobSetRes["jobset.x-k8s.io<br/>JobSet"]
        AppWrapperRes["workload.codeflare.dev<br/>AppWrapper"]
        LWSRes["leaderworkerset.x-k8s.io<br/>LeaderWorkerSet"]
    end

    subgraph CoreResources["Core API Resources"]
        CoreRes["Pods, Events, Secrets,<br/>PodTemplates, Namespaces,<br/>LimitRanges, Nodes"]
        AdmissionRes["admissionregistration.k8s.io<br/>MutatingWebhookConfigurations,<br/>ValidatingWebhookConfigurations"]
        AutoscaleRes["autoscaling.x-k8s.io<br/>ProvisioningRequests"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReview["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        Metrics["/metrics"]
    end

    %% Bindings
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_MetricsAuth
    SA_Manager -->|bound via| RB_Leader
    SA_MetricsReader -->|bound via| CRB_ReadMetrics

    CRB_Manager -->|grants| CR_Manager
    CRB_MetricsAuth -->|grants| CR_MetricsAuth
    CRB_ReadMetrics -->|grants| CR_MetricsReader
    RB_Leader -->|grants| R_Leader

    %% Manager role permissions
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| KueueCRDs
    CR_Manager -->|"get, list, patch,<br/>update, watch"| BatchRes
    CR_Manager -->|"get, list, patch,<br/>update, watch"| KubeflowRes
    CR_Manager -->|"get, list, patch,<br/>update, watch"| RayRes
    CR_Manager -->|"get, list, patch,<br/>update, watch"| JobSetRes
    CR_Manager -->|"get, list, patch,<br/>update, watch"| AppWrapperRes
    CR_Manager -->|"get, list, watch"| LWSRes
    CR_Manager -->|"various verbs"| CoreRes
    CR_Manager -->|"get, list, update, watch"| AdmissionRes
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| AutoscaleRes

    %% Metrics auth role
    CR_MetricsAuth -->|"create"| TokenReview
    CR_MetricsAuth -->|"create"| SAR

    %% Metrics reader
    CR_MetricsReader -->|"get"| Metrics

