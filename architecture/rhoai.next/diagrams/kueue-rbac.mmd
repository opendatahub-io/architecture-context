graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kueue-controller-manager<br/>(opendatahub namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["kueue-manager-rolebinding<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB["kueue-leader-election-rolebinding<br/>(opendatahub namespace)"]
    end

    subgraph ClusterRoles["ClusterRole: kueue-manager-role"]
        CR["kueue-manager-role"]
    end

    subgraph NamespaceRoles["Role: kueue-leader-election-role"]
        LER["kueue-leader-election-role<br/>(opendatahub)"]
    end

    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| CR
    RB -->|"grants"| LER

    subgraph CoreAPI["Core API Resources"]
        Events["events<br/>create, patch, update, watch"]
        LimitRanges["limitranges, namespaces, nodes<br/>get, list, watch"]
        Pods["pods<br/>delete, get, list, patch, update, watch"]
        PodsFinalizers["pods/finalizers<br/>get, update"]
        PodsStatus["pods/status<br/>get, patch"]
        PodTemplates["podtemplates<br/>create, delete, get, list, update, watch"]
        Secrets["secrets<br/>get, list, update, watch"]
    end

    subgraph KueueAPI["kueue.x-k8s.io Resources"]
        KueueFull["admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads<br/>create, delete, get, list, patch, update, watch"]
        KueueRead["multikueueclusters, multikueueconfigs,<br/>provisioningrequestconfigs,<br/>workloadpriorityclasses<br/>get, list, watch"]
        ResourceFlavors["resourceflavors<br/>delete, get, list, update, watch"]
        Topologies["topologies<br/>get, list, update, watch"]
    end

    subgraph JobAPIs["Job Framework API Resources"]
        BatchJobs["batch: jobs<br/>get, list, patch, update, watch"]
        BatchJobsSub["batch: jobs/finalizers, jobs/status<br/>get, patch, update"]
        KubeflowJobs["kubeflow.org: mpijobs, paddlejobs,<br/>pytorchjobs, tfjobs, xgboostjobs<br/>get, list, patch, update, watch"]
        RayResources["ray.io: rayclusters, rayjobs<br/>get, list, patch, update, watch"]
        JobSets["jobset.x-k8s.io: jobsets<br/>get, list, patch, update, watch"]
        AppWrappers["workload.codeflare.dev: appwrappers<br/>get, list, patch, update, watch"]
        LWS["leaderworkerset.x-k8s.io: leaderworkersets<br/>get, list, watch"]
    end

    subgraph OtherAPIs["Other API Resources"]
        Apps["apps: deployments, replicasets, statefulsets<br/>get, list, watch"]
        AdmissionReg["admissionregistration.k8s.io:<br/>mutating/validatingwebhookconfigurations<br/>get, list, update, watch"]
        Scheduling["scheduling.k8s.io: priorityclasses<br/>get, list, watch"]
        RuntimeClasses["node.k8s.io: runtimeclasses<br/>get, list, watch"]
        FlowControl["flowcontrol.apiserver.k8s.io:<br/>flowschemas, prioritylevelconfigurations<br/>list, watch"]
        ProvReqs["autoscaling.x-k8s.io: provisioningrequests<br/>create, delete, get, list, patch, update, watch"]
    end

    CR -->|"grants access"| CoreAPI
    CR -->|"grants access"| KueueAPI
    CR -->|"grants access"| JobAPIs
    CR -->|"grants access"| OtherAPIs

