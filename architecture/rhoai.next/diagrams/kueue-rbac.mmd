graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["system:controller-manager<br/>(Namespace: opendatahub)"]
        MetricsSA["opendatahub:controller-manager<br/>-metrics-reader<br/>(RHOAI only)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["manager-rolebinding<br/>(ClusterRoleBinding)"]
        MetricsCRB["kueue-metrics-reader<br/>-clusterrole-binding<br/>(RHOAI, ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_LE["leader-election-rolebinding<br/>(Namespace: system)"]
        RB_Auth["visibility-server-auth-reader<br/>(Namespace: kube-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR["manager-role"]
        MetricsCR["metrics-reader"]
    end

    subgraph Roles["Roles"]
        R_LE["leader-election-role<br/>(Namespace: system)"]
        R_Auth["extension-apiserver<br/>-authentication-reader<br/>(Namespace: kube-system)"]
    end

    %% Kueue Core CRDs
    subgraph KueueResources["kueue.x-k8s.io Resources"]
        CQ["ClusterQueue"]
        LQ["LocalQueue"]
        WL["Workload"]
        RF["ResourceFlavor"]
        AC["AdmissionCheck"]
        WPC["WorkloadPriorityClass"]
        MKConfig["MultiKueueConfig"]
        MKCluster["MultiKueueCluster"]
        PRC["ProvisioningRequestConfig"]
        Cohort["Cohort (v1alpha1)"]
        Topology["Topology (v1alpha1)"]
    end

    %% Kubernetes Core Resources
    subgraph CoreResources["Core Kubernetes Resources"]
        Pods["Pods + finalizers + status"]
        Events["Events"]
        Secrets["Secrets"]
        ConfigMaps["ConfigMaps"]
        Nodes["Nodes"]
        Namespaces["Namespaces"]
        LimitRanges["LimitRanges"]
        PodTemplates["PodTemplates"]
    end

    %% Workload Resources
    subgraph WorkloadResources["Managed Workload Resources"]
        Jobs["batch/Jobs + finalizers + status"]
        Deployments["apps/Deployments + finalizers + status"]
        StatefulSets["apps/StatefulSets + finalizers + status"]
        ReplicaSets["apps/ReplicaSets"]
        KubeflowJobs["kubeflow.org/*Jobs<br/>(PyTorch, TF, MPI,<br/>Paddle, XGBoost)<br/>+ finalizers + status"]
        RayResources["ray.io/RayClusters,<br/>RayJobs<br/>+ finalizers + status"]
        JobSets["jobset.x-k8s.io/JobSets<br/>+ finalizers + status"]
        AppWrappers["workload.codeflare.dev<br/>/AppWrappers<br/>+ finalizers + status"]
        LeaderWorkerSets["leaderworkerset.x-k8s.io<br/>/LeaderWorkerSets<br/>+ finalizers + status"]
    end

    %% Other API Resources
    subgraph OtherResources["Other API Resources"]
        ProvReqs["autoscaling.x-k8s.io<br/>/ProvisioningRequests<br/>+ status"]
        WebhookConfigs["admissionregistration.k8s.io<br/>/MutatingWebhookConfigurations<br/>/ValidatingWebhookConfigurations"]
        FlowSchemas["flowcontrol.apiserver.k8s.io<br/>/FlowSchemas,<br/>PriorityLevelConfigurations"]
        PriorityClasses["scheduling.k8s.io<br/>/PriorityClasses"]
        RuntimeClasses["node.k8s.io<br/>/RuntimeClasses"]
    end

    %% Leader Election Resources
    subgraph LEResources["Leader Election Resources"]
        LE_CM["ConfigMaps"]
        LE_Leases["Leases"]
        LE_Events["Events"]
    end

    %% Bindings
    SA -->|bound via| CRB
    SA -->|bound via| RB_LE
    SA -->|bound via| RB_Auth
    MetricsSA -->|bound via| MetricsCRB

    CRB -->|grants| CR
    MetricsCRB -->|grants| MetricsCR
    RB_LE -->|grants| R_LE
    RB_Auth -->|grants| R_Auth

    %% Permissions - manager-role
    CR -->|"create, delete, get, list,<br/>patch, update, watch<br/>+ status + finalizers"| KueueResources
    CR -->|"get, list, patch,<br/>update, watch<br/>+ finalizers + status"| WorkloadResources
    CR -->|"delete, get, list, patch,<br/>update, watch + finalizers"| Pods
    CR -->|"create, patch, update"| Events
    CR -->|"get, list, watch"| Secrets
    CR -->|"get, list, watch"| ConfigMaps
    CR -->|"get, list, watch"| Nodes
    CR -->|"get, list, watch"| Namespaces
    CR -->|"get, list, watch"| LimitRanges
    CR -->|"create, delete, get,<br/>list, update, watch"| PodTemplates
    CR -->|"full CRUD + status"| ProvReqs
    CR -->|"get, list, update, watch"| WebhookConfigs
    CR -->|"list, watch"| FlowSchemas
    CR -->|"get, list, watch"| PriorityClasses
    CR -->|"get, list, watch"| RuntimeClasses

    %% Leader Election
    R_LE -->|"full CRUD"| LE_CM
    R_LE -->|"full CRUD"| LE_Leases
    R_LE -->|"create, patch"| LE_Events

