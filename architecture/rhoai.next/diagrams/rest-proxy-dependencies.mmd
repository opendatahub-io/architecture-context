    RestProxy -->|"protobuf<br/>serialization"| Protobuf["google.golang.org/protobuf<br/>v1.35.1"]
    RestProxy -.->|"structured<br/>logging only"| CtrlRuntime["controller-runtime<br/>v0.14.1 (zap logger)"]

