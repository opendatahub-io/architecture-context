graph LR
    ModelMesh["ModelMesh<br/>v0.11.0<br/>Java 21 Sidecar"]

    %% Internal Platform Dependencies
    ModelMesh -->|"deployed by<br/>(sidecar injection)"| Controller["modelmesh-controller<br/>(modelmesh-serving)"]
    ModelMesh -->|"gRPC/8085 or UDS<br/>sidecar communication"| Runtime["Model Runtime<br/>(Triton/MLServer/Custom)"]
    ModelMesh -->|"gRPC/2379<br/>TLS optional"| etcd["etcd Cluster<br/>v3.5+"]

    %% External Dependencies (required)
    ModelMesh -->|"runtime"| OpenJDK["OpenJDK 21"]
    ModelMesh -->|"gRPC framework"| gRPC["gRPC-Java 1.63.2"]
    ModelMesh -->|"network I/O"| Netty["Netty 4.1.132.Final"]
    ModelMesh -->|"inter-instance RPC"| LiteLinks["LiteLinks 1.7.2<br/>(IBM Thrift framework)"]
    ModelMesh -->|"serialization"| Protobuf["Protobuf 3.25.5"]
    ModelMesh -->|"serialization"| Thrift["Apache Thrift 0.20.0"]
    ModelMesh -->|"KV abstraction"| KVUtils["kv-utils 0.5.1"]
    ModelMesh -->|"metrics"| PromClient["Prometheus Client 0.9.0"]
    ModelMesh -->|"TLS certs"| BouncyCastle["BouncyCastle 1.78"]
    ModelMesh -->|"JSON"| Jackson["Jackson 2.16.2"]
    ModelMesh -->|"logging"| Log4j2["Log4j2 2.23.1"]

    %% Optional / Alternative Dependencies
    ModelMesh -.->|"alternative KV store<br/>(legacy)"| ZooKeeper["ZooKeeper 3.7+"]
    ModelMesh -.->|"conditional"| etcdJava["etcd-java 0.0.24"]

    %% Integration Points (consumers of ModelMesh)
    Controller -.->|"configures env,<br/>TLS, storage"| ModelMesh

    %% External Services
    ModelMesh -.->|"HTTPS/2112<br/>self-signed TLS"| Prometheus["Prometheus"]
    ModelMesh -.->|"UDP/8126"| StatsD["StatsD"]
    ModelMesh -.->|"HTTP(S)<br/>configurable"| PayloadSvc["Remote Payload<br/>Processor"]
    ModelMesh -.->|"file watch"| ConfigMap["Kubernetes<br/>ConfigMap"]

