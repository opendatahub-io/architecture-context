graph LR
    ModelMesh["ModelMesh<br/>(Distributed LRU Cache<br/>& Routing Layer)"]

    %% External Dependencies (Required)
    ModelMesh -->|"model registry,<br/>leader election,<br/>vmodel state"| etcd["etcd v3.5+"]
    ModelMesh -->|"runtime environment"| Java21["Java 21<br/>(OpenJDK)"]
    ModelMesh -->|"external API,<br/>sidecar comm"| gRPC["gRPC 1.63.2"]
    ModelMesh -->|"network transport"| Netty["Netty 4.1.132.Final"]
    ModelMesh -->|"API serialization"| Protobuf["Protobuf 3.25.5"]
    ModelMesh -->|"inter-instance RPC,<br/>service discovery"| litelinks["litelinks 1.7.2"]
    ModelMesh -->|"KV store<br/>abstraction"| kvutils["kv-utils 0.5.1"]
    ModelMesh -->|"etcd Java client"| etcdjava["etcd-java 0.0.24"]
    ModelMesh -->|"metrics collection"| PromClient["Prometheus<br/>simpleclient 0.9.0"]
    ModelMesh -->|"TLS cert generation<br/>(metrics endpoint)"| BouncyCastle["BouncyCastle<br/>bcpkix-jdk18on 1.78"]
    ModelMesh -->|"inter-instance<br/>serialization"| Thrift["Apache Thrift 0.20.0"]
    ModelMesh -->|"logging"| Log4j2["Log4j2 2.23.1"]

    %% Internal Platform Dependencies
    Controller["modelmesh-serving<br/>Controller"] -.->|"ConfigMap<br/>model-serving-config"| ModelMesh
    ModelMesh -->|"gRPC sidecar API<br/>(load/unload/predict)"| Runtimes["Model Runtimes<br/>(mlserver, Triton,<br/>custom)"]

    %% Cluster Services
    Kubelet["Kubernetes Kubelet"] -->|"health probes<br/>HTTP/8089"| ModelMesh
    Prometheus["Prometheus Scraper"] -->|"metrics scraping<br/>HTTPS/2112"| ModelMesh

    %% Styling
    style ModelMesh fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps
    style etcd fill:#f5a623,stroke:#333,color:#fff
    style Java21 fill:#999,stroke:#333,color:#fff
    style gRPC fill:#999,stroke:#333,color:#fff
    style Netty fill:#999,stroke:#333,color:#fff
    style Protobuf fill:#999,stroke:#333,color:#fff
    style litelinks fill:#999,stroke:#333,color:#fff
    style kvutils fill:#999,stroke:#333,color:#fff
    style etcdjava fill:#999,stroke:#333,color:#fff
    style PromClient fill:#999,stroke:#333,color:#fff
    style BouncyCastle fill:#999,stroke:#333,color:#fff
    style Thrift fill:#999,stroke:#333,color:#fff
    style Log4j2 fill:#999,stroke:#333,color:#fff

    %% Internal platform
    style Controller fill:#7ed321,stroke:#333,color:#fff
    style Runtimes fill:#7ed321,stroke:#333,color:#fff

    %% Cluster services
    style Kubelet fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
