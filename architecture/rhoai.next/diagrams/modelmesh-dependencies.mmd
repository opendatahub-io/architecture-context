graph LR
    ModelMesh["ModelMesh<br/>(mm sidecar)"]

    %% External Dependencies (Required)
    ModelMesh -->|"KV store<br/>model registry,<br/>leader election"| etcd["etcd v3.5+"]
    ModelMesh -->|"gRPC framework"| gRPC["gRPC-Java 1.63.2"]
    ModelMesh -->|"NIO transport"| Netty["Netty 4.1.132"]
    ModelMesh -->|"inter-pod RPC"| litelinks["litelinks 1.7.2<br/>(IBM Thrift RPC)"]
    ModelMesh -->|"KV abstraction"| kvutils["kv-utils 0.5.1"]
    ModelMesh -->|"etcd client"| etcdjava["etcd-java 0.0.24"]
    ModelMesh -->|"serialization"| Protobuf["Protobuf 3.25.5"]
    ModelMesh -->|"utilities"| Guava["Guava 33.1.0"]
    ModelMesh -->|"logging"| Log4j2["Log4j2 2.23.1"]
    ModelMesh -->|"runtime"| JDK["OpenJDK 21"]

    %% External Dependencies (Optional)
    ModelMesh -.->|"self-signed certs"| BouncyCastle["BouncyCastle 1.78"]
    ModelMesh -.->|"metrics client"| PromClient["Prometheus Client 0.9.0"]

    %% Internal RHOAI Dependencies
    MMServing["modelmesh-serving"] -->|"deployment<br/>orchestration"| ModelMesh
    ModelMesh -->|"sidecar gRPC<br/>:8085/UDS"| RuntimeContainers["Model Runtimes<br/>(Triton, MLServer, OVMS)"]

    %% Observability
    Prometheus["Prometheus"] -->|"scrape :2112<br/>HTTPS self-signed"| ModelMesh

