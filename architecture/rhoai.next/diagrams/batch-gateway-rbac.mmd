graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["batch-gateway-apiserver<br/>(API Server)"]
        SA_Proc["batch-gateway-processor<br/>(Processor)"]
        SA_GC["batch-gateway-gc<br/>(Garbage Collector)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_GC["{release}-gc-pod-watcher<br/>RoleBinding"]
    end

    subgraph Roles["Roles (Namespace-Scoped)"]
        Role_GC["{release}-gc-pod-watcher<br/>Role"]
    end

    subgraph APIResources["API Resources"]
        Pods["core<br/>pods"]
        StatefulSets["apps<br/>statefulsets"]
    end

    subgraph Verbs["Permissions"]
        ReadOnly["get, list, watch"]
    end

    %% GC RBAC chain
    SA_GC -->|"bound via"| RB_GC
    RB_GC -->|"grants"| Role_GC
    Role_GC -->|"get, list, watch"| Pods
    Role_GC -->|"get, list, watch"| StatefulSets

    %% API Server and Processor have no RBAC roles
    SA_API -.-|"no cluster/role bindings<br/>(no k8s API access)"| NoRBAC_API["No RBAC Required"]
    SA_Proc -.-|"no cluster/role bindings<br/>(no k8s API access)"| NoRBAC_Proc["No RBAC Required"]

    subgraph ExternalAuth["External Authentication (Delegated)"]
        direction LR
        GW["Upstream Gateway<br/>(Kuadrant/Authorino)"]
        TenantHeader["X-MaaS-Username Header<br/>(tenant identity)"]
        GW -->|"injects"| TenantHeader
        TenantHeader -->|"extracted by"| SA_API
    end

    subgraph Secrets["Secrets Access"]
        Secret["batch-gateway-secrets<br/>(Opaque)"]
        SecretTLS["{release}-apiserver-tls<br/>(kubernetes.io/tls)"]
        Secret -->|"postgresql-url"| SA_API
        Secret -->|"redis-url"| SA_API
        Secret -->|"postgresql-url"| SA_Proc
        Secret -->|"redis-url"| SA_Proc
        Secret -->|"postgresql-url"| SA_GC
        Secret -->|"redis-url"| SA_GC
        Secret -->|"s3-secret-access-key"| SA_API
        Secret -->|"s3-secret-access-key"| SA_Proc
        Secret -->|"s3-secret-access-key"| SA_GC
        Secret -->|"inference-api-key"| SA_Proc
        SecretTLS -->|"tls.crt, tls.key"| SA_API
    end

    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proc fill:#7ed321,stroke:#333,color:#fff
    style SA_GC fill:#f5a623,stroke:#333,color:#fff
    style Role_GC fill:#f5a623,stroke:#333
    style RB_GC fill:#ffe6cc,stroke:#333
    style Pods fill:#dae8fc,stroke:#333
    style StatefulSets fill:#dae8fc,stroke:#333
    style NoRBAC_API fill:#f0f0f0,stroke:#ccc,stroke-dasharray: 5 5
    style NoRBAC_Proc fill:#f0f0f0,stroke:#ccc,stroke-dasharray: 5 5
    style Secret fill:#ff6b6b,stroke:#333,color:#fff
    style SecretTLS fill:#ff6b6b,stroke:#333,color:#fff
    style GW fill:#e8e8e8,stroke:#333
