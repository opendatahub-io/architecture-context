graph TD
    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB

        subgraph TenantIsolation["Tenant Isolation (Application-Level)"]
            Header["X-MaaS-Username Header<br/>(configurable via input_headers.tenant)"]
            Middleware["Request Middleware<br/>(apiserver)"]
            DBFilter["Database Query Filter<br/>(tenant_id scoping)"]

            Header -->|"extracted by"| Middleware
            Middleware -->|"applied to"| DBFilter
            DBFilter -->|"404 on mismatch"| TenantResult["Tenant-scoped results<br/>Mismatched tenant → 404"]
        end

        subgraph UpstreamAuth["Upstream Authentication (Required)"]
            Proxy["Authenticating Proxy<br/>(Envoy ext_authz, kube-rbac-proxy)"]
            Proxy -->|"injects tenant header"| Header
            Proxy -->|"validates identity"| AuthCheck["API Key / JWT / mTLS<br/>Validation"]
        end

        subgraph EndpointAuth["Endpoint Authentication"]
            BatchEndpoints["/v1/batches/*<br/>Methods: GET, POST"]
            FileEndpoints["/v1/files/*<br/>Methods: GET, POST, DELETE"]
            HealthEndpoints["/health, /ready, /metrics<br/>Methods: GET"]

            BatchEndpoints -->|"requires"| TenantHeader["Tenant Header<br/>(X-MaaS-Username)"]
            FileEndpoints -->|"requires"| TenantHeader
            HealthEndpoints -->|"no auth"| Unauthenticated["Unauthenticated<br/>Open access"]
        end

        subgraph InferenceAuth["Inference Backend Auth"]
            APIKey["inference-api-key<br/>(from batch-gateway-secrets)"]
            InferenceHeaders["x-gateway-inference-objective<br/>x-gateway-inference-fairness-id"]
            PassThrough["Pass-through Authorization header<br/>(captured from original batch request)"]

            APIKey -->|"sent to"| InferenceGW["LLM Inference Gateway"]
            InferenceHeaders -->|"sent to"| InferenceGW
            PassThrough -->|"forwarded to"| InferenceGW
        end
    end

    subgraph Secrets["Secrets"]
        Secret1["batch-gateway-secrets<br/>Type: Opaque<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        Secret1Contents["redis-url<br/>postgresql-url<br/>inference-api-key<br/>s3-secret-access-key"]
        Secret1 --- Secret1Contents

        Secret2["{release}-batch-gateway-apiserver-tls<br/>Type: kubernetes.io/tls<br/>Provisioned: cert-manager or manual<br/>Auto-Rotate: Yes (if cert-manager)"]
        Secret2Contents["tls.crt<br/>tls.key"]
        Secret2 --- Secret2Contents
    end

    subgraph NoRBAC["Kubernetes RBAC"]
        NoneNeeded["No ClusterRoles or RoleBindings<br/>Batch Gateway does not interact<br/>with the Kubernetes API"]
    end

    %% Styling
    style AuthModel fill:#fff,stroke:#333
    style TenantIsolation fill:#d5e8d4,stroke:#82b366
    style UpstreamAuth fill:#ffe6cc,stroke:#d79b00
    style EndpointAuth fill:#dae8fc,stroke:#6c8ebf
    style InferenceAuth fill:#fff2cc,stroke:#d6b656
    style Secrets fill:#f8cecc,stroke:#b85450
    style NoRBAC fill:#e8e8e8,stroke:#666

    style Proxy fill:#d79b00,stroke:#333,color:#fff
    style Header fill:#82b366,stroke:#333,color:#fff
    style Middleware fill:#82b366,stroke:#333,color:#fff
    style NoneNeeded fill:#e8e8e8,stroke:#666
    style Secret1 fill:#b85450,stroke:#333,color:#fff
    style Secret2 fill:#b85450,stroke:#333,color:#fff
