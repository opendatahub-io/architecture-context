graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["No Kubernetes RBAC defined"]
        L2["Components use default SA permissions"]
        L3["Auth delegated to external gateway"]
    end

    subgraph ServiceAccounts["Service Accounts (Default Permissions)"]
        SA_API["{release}-batch-gateway-apiserver"]
        SA_Proc["{release}-batch-gateway-processor"]
        SA_GC["{release}-batch-gateway-gc"]
    end

    subgraph ExternalAuth["External Authentication (Kuadrant / Authorino)"]
        direction TB
        AuthPolicy["AuthPolicy<br/>Per-tier identity extraction"]

        subgraph AuthMechanisms["Supported Auth Mechanisms"]
            APIKey["API Key"]
            SAToken["ServiceAccount Token"]
            UserToken["OpenShift User Token"]
        end

        AuthPolicy --> APIKey
        AuthPolicy --> SAToken
        AuthPolicy --> UserToken
    end

    subgraph TenantIsolation["Application-Level Tenant Isolation"]
        direction TB
        TenantHeader["X-MaaS-Username Header<br/>(injected by gateway)"]

        subgraph DataScoping["Data Scoping by Tenant"]
            PGScope["PostgreSQL: WHERE tenant_id = ?"]
            RedisScope["Redis: Key-prefixed by tenant ID"]
            S3Scope["S3: SHA256 folder paths per tenant"]
        end

        TenantHeader --> PGScope
        TenantHeader --> RedisScope
        TenantHeader --> S3Scope
    end

    subgraph Endpoints["Endpoint Access Control"]
        direction TB

        subgraph Protected["Protected Endpoints (Auth Required)"]
            BatchEndpoints["/v1/batches<br/>GET, POST, CANCEL"]
            FileEndpoints["/v1/files<br/>GET, POST, DELETE, Content"]
        end

        subgraph Unprotected["Unprotected Endpoints (No Auth)"]
            HealthEndpoints["/health, /ready<br/>Ports: 8081, 9090, 9091"]
            MetricsEndpoints["/metrics<br/>Ports: 8081, 9090, 9091"]
        end
    end

    subgraph InferenceAuth["Inference Auth"]
        InfAPIKey["API Key (Bearer header)<br/>Per-model or global<br/>From secret: inference-api-key"]
    end

    %% Flows
    AuthPolicy -->|"authenticates"| Protected
    SA_API -->|"runs"| Protected
    SA_Proc -->|"dispatches via"| InfAPIKey
    SA_GC -->|"cleanup only<br/>no API exposure"| DataScoping

    %% Cross-tenant protection
    Protected -->|"tenant-scoped<br/>404 on cross-tenant"| TenantIsolation

    %% Styling
    style Legend fill:#ffffcc,stroke:#999
    style ServiceAccounts fill:#e8f0fe,stroke:#4a90e2
    style ExternalAuth fill:#ffcccc,stroke:#cc3333
    style TenantIsolation fill:#d5e8d4,stroke:#82b366
    style Endpoints fill:#fff2cc,stroke:#d6b656
    style InferenceAuth fill:#dae8fc,stroke:#6c8ebf

    style SA_API fill:#4a90e2,color:#fff
    style SA_Proc fill:#4a90e2,color:#fff
    style SA_GC fill:#4a90e2,color:#fff
    style AuthPolicy fill:#f5a623
    style TenantHeader fill:#7ed321,color:#fff
    style BatchEndpoints fill:#f5a623
    style FileEndpoints fill:#f5a623
    style HealthEndpoints fill:#e8e8e8
    style MetricsEndpoints fill:#e8e8e8
    style InfAPIKey fill:#6c8ebf,color:#fff
