graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        Gateway["Gateway (Envoy)<br/>443/TCP<br/>TLS 1.2+<br/>Platform Auth"]
    end

    subgraph NotebookPod["NOTEBOOK POD (User Namespace)"]
        direction TB
        KRBAC["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
        Notebook["Notebook Container<br/>8888/TCP HTTP"]
        NP1["NetworkPolicy: ctrl-np<br/>Allow from controller ns"]
        NP2["NetworkPolicy: oauth-np<br/>Allow kube-rbac-proxy ports"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (opendatahub)"]
        direction TB
        Controller["odh-notebook-controller-manager<br/>SA: odh-notebook-controller-manager"]
        MetricsSvc["metrics service<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
        WebhookSvc["webhook service<br/>443/TCP → 8443/TCP HTTPS<br/>K8s Admission"]
        HealthProbe["health probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        direction TB
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OSConfig["OpenShift Config API<br/>TLS Profile + Proxy"]
    end

    %% External access flow
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform Auth"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KRBAC
    KRBAC -->|"HTTP/8888<br/>Localhost<br/>No Auth"| Notebook

    %% Controller to API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>Notebook, StatefulSet,<br/>Service, NetworkPolicy,<br/>HTTPRoute, RBAC"| APIServer

    %% Webhook flow
    APIServer -->|"HTTPS/443<br/>TLS 1.2+<br/>K8s Admission"| WebhookSvc

    %% TokenReview
    KRBAC -.->|"HTTPS/6443<br/>TokenReview"| APIServer

    %% Config watch
    Controller -.->|"watch"| OSConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef notebookpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef networkpolicy fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class Gateway ingress
    class KRBAC,Notebook notebookpod
    class Controller,MetricsSvc,WebhookSvc,HealthProbe controller
    class APIServer,OSConfig controlplane
    class NP1,NP2 networkpolicy
