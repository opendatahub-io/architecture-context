graph LR
    MMS["ModelMesh Serving<br/>Controller"]

    %% External Dependencies (Build / Runtime Framework)
    MMS -->|"operator framework"| ControllerRuntime["controller-runtime v0.16.3"]
    MMS -->|"CRD API types"| KServe["kserve v0.12.0"]
    MMS -->|"gRPC client"| gRPC["google.golang.org/grpc v1.59.0"]
    MMS -->|"model metadata"| etcdClient["etcd client v3.5.9"]
    MMS -->|"manifest mgmt"| Manifestival["manifestival v0.7.1"]
    MMS -->|"config parsing"| Viper["spf13/viper v1.11.0"]
    MMS -->|"leader election"| OperatorLib["operator-lib v0.10.0"]
    MMS -->|"K8s client"| ClientGo["client-go v0.28.4"]

    %% Internal Platform Dependencies
    MMS -->|"gRPC client<br/>model coordination"| etcd["etcd Cluster<br/>2379/TCP gRPC TLS"]
    MMS -->|"gRPC client<br/>model lifecycle"| ModelMesh["ModelMesh<br/>(kserve/modelmesh)"]
    MMS -->|"sidecar container<br/>model pull/load"| RuntimeAdapter["modelmesh-runtime-adapter"]
    MMS -->|"sidecar container<br/>REST-to-gRPC"| RestProxy["rest-proxy<br/>(kserve/rest-proxy)"]
    MMS -->|"ServiceMonitor CRD"| PrometheusOp["prometheus-operator"]

    %% Integration Points
    MMS -->|"webhook TLS certs"| CertManager["cert-manager"]
    MMS -->|"CRUD all resources"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    MMS -.->|"optional watch<br/>ENABLE_ISVC_WATCH"| ISvcWatch["KServe InferenceService"]

    %% Consumers / Integrations
    Dashboard["ODH Dashboard"] -.->|"manages models via"| MMS
    RuntimeAdapter -->|"model storage"| ObjectStorage["Object Storage<br/>S3-compatible<br/>443/TCP HTTPS"]

    %% Built-in Serving Runtimes
    subgraph "Supported Runtimes"
        Triton["Triton 2.x<br/>keras, onnx, pytorch,<br/>tensorflow, tensorrt,<br/>xgboost, sklearn, lightgbm"]
        MLServer["MLServer 1.x<br/>sklearn, xgboost,<br/>lightgbm"]
        OVMS["OVMS 1.x<br/>onnx, openvino_ir"]
        TorchServe["TorchServe 0.x<br/>pytorch-mar"]
    end

    MMS -->|"ClusterServingRuntime"| Triton
    MMS -->|"ClusterServingRuntime"| MLServer
    MMS -->|"ClusterServingRuntime"| OVMS
    MMS -->|"ClusterServingRuntime"| TorchServe

