graph LR
    MMServing["ModelMesh Serving<br/>Controller"]

    %% External Dependencies (Required)
    MMServing -->|"coordination<br/>gRPC/2379 TLS"| etcd["etcd v3.5.x<br/>(Required)"]
    MMServing -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.16.3<br/>(Required)"]
    MMServing -->|"CRD type definitions"| KServeAPI["kserve/kserve API<br/>v0.12.0<br/>(Required)"]
    MMServing -->|"model orchestration<br/>sidecar"| ModelMesh["kserve/modelmesh<br/>(Required)"]
    MMServing -->|"storage puller<br/>sidecar"| RuntimeAdapter["kserve/modelmesh-<br/>runtime-adapter<br/>(Required)"]

    %% External Dependencies (Optional)
    MMServing -.->|"REST→gRPC proxy<br/>sidecar"| RESTProxy["kserve/rest-proxy<br/>(Optional)"]
    MMServing -.->|"ServiceMonitor CRD"| PrometheusOp["prometheus-operator<br/>v0.55.0<br/>(Optional)"]

    %% Internal Platform Dependencies
    MMServing -->|"SAR auth sidecar<br/>HTTPS/8443"| OAuthProxy["OpenShift<br/>OAuth Proxy"]
    MMServing -->|"TLS cert provisioning<br/>annotation-triggered"| ServiceCA["OpenShift<br/>service-ca"]

    %% External Services
    MMServing -->|"model storage<br/>HTTPS/443"| ObjectStorage["Object Storage<br/>(S3/GCS/PVC)"]
    MMServing -->|"cluster API<br/>HTTPS/443"| K8sAPI["Kubernetes<br/>API Server"]

    %% Integration Points (things that use ModelMesh Serving)
    K8sHPA["Kubernetes HPA"] -.->|"autoscaling<br/>HPA CRD"| MMServing
    K8sNamespaces["Kubernetes<br/>Namespaces"] -.->|"modelmesh-enabled<br/>label watch"| MMServing
    ConfigMap["model-serving-config<br/>ConfigMap"] -.->|"runtime configuration<br/>watch"| MMServing

    %% External Webhooks (peer components)
    KServeController["KServe Controller"] -.->|"validates shared CRDs<br/>(InferenceService,<br/>ServingRuntime)"| MMServing
    ODHModelController["odh-model-controller"] -.->|"mutates/validates<br/>InferenceService"| MMServing

    %% Styling
    style MMServing fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style etcd fill:#999,stroke:#333,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style KServeAPI fill:#999,stroke:#333,color:#fff
    style ModelMesh fill:#999,stroke:#333,color:#fff
    style RuntimeAdapter fill:#999,stroke:#333,color:#fff

    style RESTProxy fill:#bbb,stroke:#333,color:#fff
    style PrometheusOp fill:#bbb,stroke:#333,color:#fff

    style OAuthProxy fill:#7ed321,stroke:#333,color:#fff
    style ServiceCA fill:#7ed321,stroke:#333,color:#fff

    style ObjectStorage fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333

    style K8sHPA fill:#ddd,stroke:#999
    style K8sNamespaces fill:#ddd,stroke:#999
    style ConfigMap fill:#ddd,stroke:#999
    style KServeController fill:#e8d5f5,stroke:#9b59b6
    style ODHModelController fill:#e8d5f5,stroke:#9b59b6
