graph TB
    subgraph External["EXTERNAL (User Workstation / CI)"]
        Admin["Cluster Admin / CI<br/>kubectl rhaii-validate"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+ (FIPS)<br/>Bearer Token Auth"]
    end

    subgraph Workers["GPU WORKER NODES (ns: rhaii-validation)"]
        direction TB

        subgraph CheckPod["Per-Node Check Job"]
            CheckContainer["rhaii-cluster-validator<br/>SA: rhaii-validator<br/>automountSAToken: false<br/>SecurityContext: privileged"]
        end

        subgraph HostAccess["Host Resources"]
            Sysfs["/sys/class/infiniband<br/>/sys/bus/pci/devices<br/>nvidia-smi / rocm-smi"]
        end

        subgraph ServerPod["Bandwidth Server Job (Node A)"]
            Server["validator-tools<br/>automountSAToken: false<br/>Resources: GPU + RDMA"]
        end

        subgraph ClientPod["Bandwidth Client Job (Node B)"]
            Client["validator-tools<br/>automountSAToken: false<br/>Resources: GPU + RDMA"]
        end
    end

    subgraph Prerequisites["PLATFORM PREREQUISITES (validated only)"]
        GatewayAPI["Gateway API CRDs"]
        InferencePool["InferencePool CRD"]
        LWS["LeaderWorkerSet CRD"]
        CertMgr["cert-manager"]
        Istio["Istio"]
        GPUPlugin["GPU Device Plugin"]
        RDMAPlugin["RDMA Device Plugin"]
    end

    %% Flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+ (FIPS)<br/>Bearer Token (kubeconfig)"| K8sAPI
    K8sAPI -->|"Job scheduling"| CheckContainer
    K8sAPI -->|"Job scheduling"| Server
    K8sAPI -->|"Job scheduling"| Client

    CheckContainer -->|"chroot /host<br/>privileged container"| Sysfs

    Client -->|"TCP/5201<br/>plaintext<br/>iperf3 bandwidth"| Server
    Client -->|"TCP/12865<br/>plaintext<br/>TCP latency"| Server
    Client -->|"RDMA/18515+<br/>IB/RoCE<br/>ib_write_bw (GPUDirect)"| Server
    Client -->|"RDMA/18515+<br/>IB/RoCE<br/>ibv_rc_pingpong"| Server

    K8sAPI -.->|"CRD GET / Pod list<br/>validation only"| Prerequisites

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px,color:#333
    classDef controlplane fill:#dce8f7,stroke:#4a90e2,stroke-width:2px,color:#333
    classDef worker fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#333
    classDef host fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#333
    classDef prereq fill:#e8e8e8,stroke:#999,stroke-width:1px,color:#333

    class Admin external
    class K8sAPI controlplane
    class CheckContainer,Server,Client worker
    class Sysfs host
    class GatewayAPI,InferencePool,LWS,CertMgr,Istio,GPUPlugin,RDMAPlugin prereq
