graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - Kubernetes Network)"]
        direction TB

        subgraph PlatformNS["Namespace: platform-operator"]
            PlatformOp["rhods-operator /<br/>opendatahub-operator<br/>SA: system-level"]
        end

        subgraph OperatorNS["Namespace: redhat-ods-applications"]
            direction TB
            ModuleOp["feast-module-operator<br/>SA: opendatahub-feast-operator<br/>Image: feast-module-operator"]
            InitContainer["copy-manifests<br/>(Init Container)"]
            MetricsSvc["opendatahub-feast-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS / TLS<br/>Bearer Token (SA)"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No TLS / No Auth<br/>/healthz, /readyz"]

            InitContainer -->|"emptyDir volume"| ModuleOp
            ModuleOp --- MetricsSvc
            ModuleOp --- HealthProbe
        end

        subgraph DeployedNS["Namespace: target (deployed by module operator)"]
            UpstreamOp["Upstream Feast Operator<br/>(Deployment)<br/>Image: feast-operator:0.64.0"]
            FeatureStoreCRD["FeatureStore CRD<br/>feast.dev/v1<br/>Namespaced"]
            UpstreamRBAC["ClusterRoles &<br/>ClusterRoleBindings"]
        end

        subgraph MonitoringNS["Namespace: openshift-monitoring"]
            Prometheus["Prometheus /<br/>OpenShift Monitoring"]
        end

        K8sAPI["Kubernetes API Server"]
    end

    %% Flows
    PlatformOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Create FeastOperator CR +<br/>ConfigMap"| K8sAPI

    ModuleOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>CR watch, resource CRUD,<br/>leader election"| K8sAPI

    ModuleOp -->|"Renders kustomize &<br/>applies manifests"| UpstreamOp
    ModuleOp -->|"Installs CRD"| FeatureStoreCRD
    ModuleOp -->|"Creates RBAC"| UpstreamRBAC

    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token (SA)<br/>ServiceMonitor"| MetricsSvc

    %% Notes
    NoIngress["No external ingress<br/>(no Routes/Gateways)"]
    NoExternalEgress["No external egress<br/>(K8s API only)"]

    %% Styling
    classDef platform fill:#7ed321,stroke:#333,stroke-width:2px
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef deployed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef infrastructure fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef note fill:#ffe6cc,stroke:#d79b00,stroke-width:1px,stroke-dasharray: 5 5

    class PlatformOp platform
    class ModuleOp,InitContainer operator
    class MetricsSvc,HealthProbe operator
    class UpstreamOp,FeatureStoreCRD,UpstreamRBAC deployed
    class Prometheus monitoring
    class K8sAPI infrastructure
    class NoIngress,NoExternalEgress note
