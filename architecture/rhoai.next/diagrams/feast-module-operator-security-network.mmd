graph TB
    subgraph External["CLUSTER INTERNAL (Trusted)"]
        PlatOp["ODH Platform Operator<br/>SA: opendatahub-operator<br/>NS: redhat-ods-operator"]
    end

    subgraph K8sAPI["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(redhat-ods-applications)"]
        direction TB

        subgraph ModOp["feast-module-operator Pod"]
            direction LR
            HealthProbes["8081/TCP HTTP<br/>/healthz /readyz<br/>No encryption<br/>No auth"]
            MetricsPort["8443/TCP HTTPS<br/>/metrics<br/>TLS<br/>Bearer Token (SA)"]
        end

        MetricsSvc["opendatahub-feast-<br/>metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS TLS"]

        subgraph Monitoring["Monitoring"]
            Prometheus["Prometheus<br/>(via ServiceMonitor)"]
        end
    end

    subgraph Deployed["DEPLOYED WORKLOAD"]
        FeastOp["feast-operator<br/>controller-manager<br/>(Deployment)"]
        FeatureStoreCRD["FeatureStore CRD<br/>feast.dev/v1, v1alpha1"]
    end

    %% Flows
    PlatOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Creates FeastOperator CR"| APIServer
    PlatOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Writes ConfigMap"| APIServer

    APIServer -->|"Watch events<br/>HTTPS/443<br/>TLS 1.2+<br/>SA Token"| ModOp
    ModOp -->|"Resource CRUD<br/>HTTPS/443<br/>TLS 1.2+<br/>SA Token"| APIServer

    ModOp -->|"Deploys via<br/>kustomize"| FeastOp
    ModOp -->|"Deploys"| FeatureStoreCRD

    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token (SA)"| MetricsSvc
    MetricsSvc -->|"8443/TCP"| MetricsPort

    %% Styling
    classDef trusted fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef apiserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef deployed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef service fill:#f5f5f5,stroke:#666,stroke-width:1px

    class PlatOp trusted
    class APIServer apiserver
    class HealthProbes,MetricsPort operator
    class FeastOp,FeatureStoreCRD deployed
    class Prometheus monitoring
    class MetricsSvc service
