graph TB
    subgraph Cluster["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Operator["Namespace: opendatahub-feast-system"]
            FMO["feast-module-operator<br/>SA: operator<br/>Image: odh-feast-module-operator-rhel9<br/>FIPS: strictfipsruntime + UBI9-pqc"]
            MetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP<br/>HTTPS / TLS<br/>TokenReview + SAR"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
        end

        subgraph NS_Apps["Namespace: redhat-ods-applications"]
            FeastOp["feast-operator<br/>Deployment<br/>Image: feast-operator:0.66.0"]
            FeatureStoreCR["FeatureStore CRs<br/>feast.dev/v1<br/>Namespaced"]
        end

        subgraph NS_Platform["Platform Resources"]
            FeastOperatorCR["FeastOperator CR<br/>Cluster-scoped singleton<br/>default-feastoperator"]
            PlatformCM["odh-feastoperator-config<br/>ConfigMap<br/>Platform version info"]
            FeatureStoreCRD["FeatureStore CRD<br/>feast.dev/v1"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]

        subgraph Monitoring["Monitoring"]
            Prometheus["Prometheus<br/>ServiceMonitor"]
        end
    end

    %% Control flows
    FMO -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    FMO -->|"watches"| FeastOperatorCR
    FMO -->|"watches<br/>(named predicate)"| PlatformCM
    FMO -->|"deploys via<br/>kustomize"| FeastOp
    FMO -->|"deploys"| FeatureStoreCRD
    FeastOp -->|"manages"| FeatureStoreCR

    %% Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview+SAR"| MetricsSvc

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef deployed fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    classDef cr fill:#f5a623,stroke:#333,stroke-width:2px,color:#fff
    classDef infra fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef monitoring fill:#27ae60,stroke:#333,stroke-width:2px,color:#fff
    classDef service fill:#3498db,stroke:#333,stroke-width:1px,color:#fff

    class FMO operator
    class FeastOp deployed
    class FeastOperatorCR,PlatformCM,FeatureStoreCRD,FeatureStoreCR cr
    class K8sAPI infra
    class Prometheus monitoring
    class MetricsSvc,HealthProbe service
