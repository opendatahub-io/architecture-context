    style ModelReg fill:#27ae60,color:#fff,stroke:#1e8449
    style MaaS fill:#27ae60,color:#fff,stroke:#1e8449
    style MLflow fill:#27ae60,color:#fff,stroke:#1e8449
    style EvalHub fill:#27ae60,color:#fff,stroke:#1e8449
    style AutoML fill:#27ae60,color:#fff,stroke:#1e8449
    style AutoRAG fill:#27ae60,color:#fff,stroke:#1e8449
