    style KubeRBAC fill:#e74c3c,color:#fff,stroke:#c0392b,stroke-width:2px
    style Dashboard fill:#4a90e2,color:#fff,stroke:#357abd
    style CoreBFF fill:#4a90e2,color:#fff,stroke:#357abd
    style DashOp fill:#9b59b6,color:#fff,stroke:#8e44ad
    style Gateway fill:#f39c12,color:#fff,stroke:#e67e22
    style APIServer fill:#2c3e50,color:#fff,stroke:#1a252f
