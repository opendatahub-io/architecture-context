graph TB
    subgraph External["External Access"]
        Browser[Browser / Client]
    end

    subgraph GatewayLayer["Gateway Layer"]
        Gateway["data-science-gateway<br/>HTTPRoute<br/>443/TCP HTTPS"]
    end

    subgraph DashboardPod["ODH Dashboard Pod (Sidecar Mode)"]
        direction TB

        subgraph AuthLayer["Auth Layer"]
            KubeRBAC["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS termination + RBAC"]
        end

        subgraph CoreServices["Core Services"]
            Dashboard["odh-dashboard<br/>(Node.js Express BFF)<br/>8080/TCP"]
            CoreBFF["core-bff<br/>(Go BFF - next gen)<br/>8080/TCP"]
        end

        subgraph ModuleBFFs["Module Federation BFFs"]
            direction LR
            ModelReg["model-registry<br/>8043/TCP"]
            GenAI["gen-ai<br/>8143/TCP"]
            MaaS["maas<br/>8243/TCP"]
            MLflow["mlflow<br/>8343/TCP"]
            EvalHub["eval-hub<br/>8543/TCP"]
            AutoML["automl<br/>8643/TCP"]
            AutoRAG["autorag<br/>8743/TCP"]
            AgentOps["agent-ops<br/>8843/TCP"]
        end
    end

    subgraph Operator["Dashboard Operator"]
        DashOp["dashboard-operator<br/>Go controller-runtime<br/>Reconciles Dashboard CR"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        DashboardCR["Dashboard CR<br/>components.platform.opendatahub.io/v1alpha1"]
        OdhConfig["OdhDashboardConfig<br/>opendatahub.io/v1alpha"]
        OdhApp["OdhApplication<br/>dashboard.opendatahub.io/v1"]
        OdhDoc["OdhDocument<br/>dashboard.opendatahub.io/v1"]
        OdhQS["OdhQuickStart<br/>console.openshift.io/v1"]
    end

    subgraph K8sAPI["Kubernetes"]
        APIServer["K8s API Server<br/>6443/TCP HTTPS"]
    end

    %% External flows
    Browser -->|HTTPS/443| Gateway
    Gateway -->|HTTPS/8443| KubeRBAC
    KubeRBAC -->|HTTP/8080<br/>auth headers| Dashboard
    KubeRBAC -->|HTTP/8080<br/>auth headers| CoreBFF

    %% Module proxying
    Dashboard -->|HTTPS/8143| GenAI
    Dashboard -->|HTTPS/8043| ModelReg
    Dashboard -->|HTTPS/8243| MaaS
    Dashboard -->|HTTPS/8343| MLflow
    Dashboard -->|HTTPS/8543| EvalHub
    Dashboard -->|HTTPS/8643| AutoML
    Dashboard -->|HTTPS/8743| AutoRAG
    Dashboard -->|HTTPS/8843| AgentOps

    %% K8s API access
    Dashboard -->|HTTPS/6443<br/>user token| APIServer
    CoreBFF -->|HTTPS/6443<br/>user token| APIServer
    GenAI -->|HTTPS/6443<br/>impersonation| APIServer
    ModelReg -->|HTTPS/6443<br/>impersonation| APIServer
    MaaS -->|HTTPS/6443<br/>impersonation| APIServer
    AgentOps -->|HTTPS/6443<br/>impersonation| APIServer

    %% Operator
    DashOp -->|watches| DashboardCR
    DashOp -->|manages| DashboardPod
    Dashboard -->|reads| OdhConfig
    Dashboard -->|reads| OdhApp

    %% Inter-module
    GenAI -.->|HTTPS/8243<br/>token passthrough| MaaS
    GenAI -.->|HTTPS/8343<br/>token passthrough| MLflow

