graph TB
    subgraph External["External Access"]
        User["User Browser"]
    end

    subgraph PlatformIngress["Platform Ingress"]
        Gateway["Platform Gateway<br/>(Envoy)<br/>443/TCP HTTPS"]
    end

    subgraph DashboardPod["ODH Dashboard Pod (Sidecar Mode)"]
        direction TB

        subgraph AuthLayer["Auth Layer"]
            KRBP["kube-rbac-proxy<br/>8443/TCP<br/>OAuth Token Validation"]
        end

        subgraph ShellApp["Shell Application"]
            Frontend["React/PatternFly 6<br/>Frontend (TypeScript)<br/>Module Federation Host"]
            Backend["Node.js/Fastify BFF<br/>(Legacy Backend)<br/>8080/TCP"]
            Frontend -->|"served by"| Backend
        end

        subgraph BFFModules["Go BFF Modules (Micro-Frontends)"]
            CoreBFF["core-bff<br/>4000/TCP<br/>Core K8s API"]
            GenAI["gen-ai<br/>8143/TCP<br/>LLM Playground, RAG,<br/>Guardrails, MCP"]
            MaaS["maas<br/>8243/TCP<br/>Managed Model Deploy"]
            ModelReg["model-registry<br/>8043/TCP<br/>Model Catalog"]
            MLflow["mlflow<br/>8343/TCP<br/>Experiment Tracking"]
            EvalHub["eval-hub<br/>8543/TCP<br/>LM Evaluation Jobs"]
            AutoML["automl<br/>8643/TCP<br/>AutoGluon Pipelines"]
            AutoRAG["autorag<br/>8743/TCP<br/>RAG Optimization"]
            AgentOps["agent-ops<br/>8843/TCP<br/>Agent Lifecycle"]
        end

        KRBP -->|"x-forwarded-access-token"| Backend
        Backend -->|"proxy /gen-ai/api"| GenAI
        Backend -->|"proxy /maas/api"| MaaS
        Backend -->|"proxy /model-registry/api"| ModelReg
        Backend -->|"proxy /_bff/mlflow/api"| MLflow
        Backend -->|"proxy /eval-hub/api"| EvalHub
        Backend -->|"proxy /automl/api"| AutoML
        Backend -->|"proxy /autorag/api"| AutoRAG
        Backend -->|"proxy /agent-ops/api"| AgentOps
    end

    subgraph Operator["Dashboard Operator"]
        DashOp["dashboard-operator<br/>(controller-runtime)<br/>Reconciles Dashboard CR"]
    end

    subgraph CRDs["Custom Resources"]
        DashboardCR["Dashboard CR<br/>(Cluster-scoped)"]
        OdhConfig["OdhDashboardConfig"]
        OdhApp["OdhApplication"]
        DSC["DataScienceCluster"]
    end

    subgraph InterBFF["Inter-BFF Communication"]
        GenAI -->|"8243/TCP TLS"| MaaS
        GenAI -->|"8343/TCP TLS"| MLflow
        EvalHub -->|"8043/TCP TLS"| ModelReg
    end

    %% External flows
    User -->|"HTTPS/443"| Gateway
    Gateway -->|"HTTPS/8443<br/>HTTPRoute"| KRBP
    Backend -->|"HTTPS/6443"| K8sAPI["Kubernetes API<br/>Server"]

    %% Operator flows
    DashOp -->|"watches"| DashboardCR
    DashOp -->|"watches"| DSC
    DashOp -->|"deploys/manages"| DashboardPod

    %% CRD reads
    Backend -->|"reads"| OdhConfig
    Backend -->|"reads"| OdhApp

    %% Styling
    classDef frontend fill:#4a90e2,stroke:#333,color:#fff
    classDef backend fill:#7b68ee,stroke:#333,color:#fff
    classDef bff fill:#50c878,stroke:#333,color:#fff
    classDef auth fill:#f5a623,stroke:#333,color:#fff
    classDef operator fill:#e74c3c,stroke:#333,color:#fff
    classDef crd fill:#f39c12,stroke:#333
    classDef external fill:#e8e8e8,stroke:#999

    class Frontend frontend
    class Backend backend
    class CoreBFF,GenAI,MaaS,ModelReg,MLflow,EvalHub,AutoML,AutoRAG,AgentOps bff
    class KRBP auth
    class DashOp operator
    class DashboardCR,OdhConfig,OdhApp,DSC crd
    class User,Gateway,K8sAPI external
