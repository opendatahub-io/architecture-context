graph TB
    subgraph External["External Access"]
        Browser[Browser]
        Gateway["data-science-gateway<br/>(Gateway API)<br/>443/TCP HTTPS"]
    end

    subgraph CorePod["Core Dashboard Pod (3 containers)"]
        direction TB
        KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS termination + OpenShift auth"]
        NodeJS["odh-dashboard<br/>(Node.js + React SPA)<br/>8080/TCP HTTP (loopback)"]
        CoreBFF["core-bff<br/>(Go BFF)<br/>8943/TCP HTTPS"]

        KubeRBACProxy -->|"x-forwarded-access-token<br/>loopback"| NodeJS
    end

    subgraph FederatedModules["Federated Module Pods (per-module deployment)"]
        direction TB
        GenAI["gen-ai BFF<br/>8080/TCP"]
        ModelReg["model-registry BFF<br/>8080/TCP"]
        MaaS["maas BFF<br/>8080/TCP"]
        EvalHub["eval-hub BFF<br/>8080/TCP"]
        MLflow["mlflow BFF<br/>8080/TCP"]
        Notebooks["notebooks BFF<br/>8080/TCP"]
        AgentOps["agent-ops BFF<br/>8080/TCP"]
        AutoML["automl BFF<br/>8080/TCP"]
        AutoRAG["autorag BFF<br/>8080/TCP"]
        DataConnectHub["data-connect-hub BFF<br/>8080/TCP"]
        DataRegistry["data-registry BFF<br/>8080/TCP"]
    end

    subgraph OperatorPod["Operator Pod"]
        DashOp["dashboard-operator<br/>(controller-runtime)<br/>8081/TCP health"]
        WorkspaceCtrl["Workspace controller"]
        WorkspaceKindCtrl["WorkspaceKind controller"]
    end

    subgraph CRDs["Custom Resources"]
        DashboardCR["Dashboard CR<br/>(components.platform.opendatahub.io)"]
        WorkspaceCR["Workspace CR<br/>(kubeflow.org/v1beta1)"]
        WorkspaceKindCR["WorkspaceKind CR<br/>(kubeflow.org/v1beta1)"]
        OdhDashboardConfig["OdhDashboardConfig CR"]
        OdhApplication["OdhApplication CR"]
        OdhQuickStart["OdhQuickStart CR"]
    end

    subgraph PlatformDeps["Platform Dependencies"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
        RhodsOp["rhods-operator"]
        KServe["KServe"]
        ModelRegistrySvc["Model Registry"]
        DSPipelines["DS Pipelines"]
        Prometheus["Prometheus/Thanos<br/>9092/TCP"]
    end

    %% External flows
    Browser -->|"HTTPS/443"| Gateway
    Gateway -->|"HTTPS/8443"| KubeRBACProxy
    Gateway -->|"HTTPS/8943"| CoreBFF

    %% Node.js flows
    NodeJS -->|"HTTPS/6443<br/>User Impersonation"| K8sAPI
    NodeJS -->|"Module Federation<br/>proxy /_mf/:name/*"| GenAI
    NodeJS -->|"proxy"| ModelReg
    NodeJS -->|"proxy"| MaaS

    %% BFF flows
    CoreBFF -->|"HTTPS/6443<br/>Bearer Token"| K8sAPI
    GenAI -->|"HTTPS/6443"| K8sAPI
    ModelReg -->|"HTTPS/6443"| K8sAPI

    %% Operator flows
    RhodsOp -->|creates| DashboardCR
    DashOp -->|"reconciles"| DashboardCR
    DashOp -->|"deploys"| CorePod
    DashOp -->|"deploys"| FederatedModules
    WorkspaceCtrl -->|"reconciles"| WorkspaceCR
    WorkspaceKindCtrl -->|"reconciles"| WorkspaceKindCR

    %% Styling
    style KubeRBACProxy fill:#e8a838,stroke:#333,stroke-width:2px
    style NodeJS fill:#4a90e2,stroke:#333,stroke-width:2px
    style CoreBFF fill:#4a90e2,stroke:#333,stroke-width:2px
    style DashOp fill:#9b59b6,stroke:#333,stroke-width:2px
    style WorkspaceCtrl fill:#9b59b6,stroke:#333,stroke-width:2px
    style WorkspaceKindCtrl fill:#9b59b6,stroke:#333,stroke-width:2px
