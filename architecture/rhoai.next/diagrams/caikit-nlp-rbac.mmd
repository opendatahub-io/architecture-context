graph TD
    subgraph Notice["Caikit-NLP RBAC Model"]
        direction TB
        Info["ℹ Caikit-NLP is a library/service,<br/>not a Kubernetes operator.<br/>No RBAC resources are defined<br/>within this component."]
    end

    subgraph PlatformAuth["Platform-Delegated Authentication"]
        direction TB

        subgraph Endpoints["Exposed Endpoints"]
            REST["REST Gateway<br/>8080/TCP HTTP"]
            GRPC["gRPC Runtime<br/>8085/TCP gRPC"]
        end

        subgraph PlatformEnforcement["Platform Enforcement Points"]
            KubeRBAC["kube-rbac-proxy<br/>sidecar container<br/><i>Enforces AuthN/AuthZ</i>"]
            KServeAuth["KServe Auth<br/>mechanism<br/><i>InferenceService-level auth</i>"]
            IstioMTLS["Istio/ServiceMesh<br/><i>mTLS between pods</i>"]
        end

        KubeRBAC -->|"protects"| REST
        KubeRBAC -->|"protects"| GRPC
        KServeAuth -->|"protects"| REST
        KServeAuth -->|"protects"| GRPC
        IstioMTLS -.->|"encrypts pod traffic"| REST
        IstioMTLS -.->|"encrypts pod traffic"| GRPC
    end

    subgraph Secrets["Secrets / Credentials"]
        direction TB
        TLSKey["RUNTIME_TLS_SERVER_KEY<br/><i>gRPC server TLS key</i><br/>Provisioned by: Platform operator"]
        TLSCert["RUNTIME_TLS_SERVER_CERT<br/><i>gRPC server TLS cert</i><br/>Provisioned by: Platform operator"]
        ClientCert["RUNTIME_TLS_CLIENT_CERT<br/><i>mTLS client cert</i><br/>Provisioned by: Platform operator"]
        TGISCACert["TGIS ca_cert_file<br/><i>TLS verification for TGIS</i><br/>Provisioned by: Platform operator"]
        TGISClientCert["TGIS client_cert/key<br/><i>mTLS for TGIS connection</i><br/>Provisioned by: Platform operator"]
    end

    TLSKey -->|"enables TLS on"| GRPC
    TLSCert -->|"enables TLS on"| GRPC
    ClientCert -->|"enables mTLS"| GRPC
    TGISCACert -->|"verifies"| TGISConn["TGIS Connection"]
    TGISClientCert -->|"authenticates to"| TGISConn

    style Notice fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style Info fill:#fff3cd,stroke:#ffc107
    style PlatformAuth fill:#d5e8d4,stroke:#82b366
    style Endpoints fill:#e8f4fd,stroke:#4a90e2
    style PlatformEnforcement fill:#d5e8d4,stroke:#82b366
    style Secrets fill:#fce4ec,stroke:#e57373
    style REST fill:#4a90e2,color:#fff
    style GRPC fill:#4a90e2,color:#fff
    style KubeRBAC fill:#82b366,color:#fff
    style KServeAuth fill:#82b366,color:#fff
    style IstioMTLS fill:#82b366,color:#fff
    style TLSKey fill:#f5a623,color:#fff
    style TLSCert fill:#f5a623,color:#fff
    style ClientCert fill:#f5a623,color:#fff
    style TGISCACert fill:#f5a623,color:#fff
    style TGISClientCert fill:#f5a623,color:#fff
    style TGISConn fill:#999,color:#fff
