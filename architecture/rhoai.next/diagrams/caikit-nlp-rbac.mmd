graph TD
    subgraph LibraryContext["caikit-nlp (Library - No Kubernetes RBAC)"]
        direction TB
        Note["caikit-nlp is a Python library, not a Kubernetes operator.<br/>No ClusterRoles, Roles, or RoleBindings are defined.<br/>All access control is delegated to the platform."]
    end

    subgraph RuntimeContext["Platform-Level Access Control"]
        direction TB

        subgraph ContainerSecurity["Container Security"]
            UID["Container UID: 1001<br/>(non-root)"]
            BaseImage["Base Image: UBI9-minimal<br/>(reduced attack surface)"]
        end

        subgraph AuthDelegation["Authentication Delegation"]
            RuntimeTLS["Caikit Runtime TLS<br/>RUNTIME_TLS_SERVER_KEY<br/>RUNTIME_TLS_SERVER_CERT<br/>RUNTIME_TLS_CLIENT_CERT"]
            PlatformAuth["Platform Auth<br/>Istio / kube-rbac-proxy"]
        end

        subgraph TGISSecurity["TGIS Connection Security"]
            TGISCerts["TGIS TLS Certificates<br/>ca_cert_file<br/>client_cert_file<br/>client_key_file"]
        end

        subgraph DownloadControl["Download Security"]
            AllowDownloads["allow_downloads<br/>Default: false<br/>(blocks external model downloads)"]
        end
    end

    subgraph Endpoints["Protected Endpoints"]
        HTTP["HTTP :8080/TCP<br/>/api/v1/task/*"]
        GRPC["gRPC :8085/TCP<br/>NLP Task Services"]
    end

    PlatformAuth -->|"enforces access to"| Endpoints
    RuntimeTLS -->|"encrypts"| Endpoints

    style Note fill:#fff2cc,stroke:#d6b656
    style UID fill:#d5e8d4,stroke:#82b366
    style BaseImage fill:#d5e8d4,stroke:#82b366
    style RuntimeTLS fill:#dae8fc,stroke:#6c8ebf
    style PlatformAuth fill:#dae8fc,stroke:#6c8ebf
    style TGISCerts fill:#dae8fc,stroke:#6c8ebf
    style AllowDownloads fill:#f8cecc,stroke:#b85450
    style HTTP fill:#e1d5e7,stroke:#9673a6
    style GRPC fill:#e1d5e7,stroke:#9673a6
