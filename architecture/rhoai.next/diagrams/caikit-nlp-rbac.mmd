graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["🟦 Library Component"]
        L2["🟩 Platform Enforcement"]
        L3["🟨 Configurable"]
    end

    subgraph CaikitNLP["Caikit NLP (Library)"]
        direction TB
        NoRBAC["No RBAC Roles Defined<br/><i>Library, not a Kubernetes controller</i>"]
    end

    subgraph PlatformAuth["Platform-Level Auth Enforcement"]
        direction TB

        subgraph HTTPAuth["HTTP API (8080/TCP)"]
            HTTPEndpoints["POST /api/v1/task/*<br/>GET /openapi.json"]
            HTTPEnforcement["Enforcement: Caikit Runtime<br/>+ KServe / kube-rbac-proxy"]
        end

        subgraph GRPCAuth["gRPC API (8085/TCP)"]
            GRPCServices["caikit.runtime.Nlp<br/>caikit.runtime.NlpTraining"]
            GRPCEnforcement["Enforcement: Caikit Runtime<br/>+ Platform"]
        end
    end

    subgraph Secrets["Secrets (Configurable)"]
        TGISCerts["TGIS TLS Certificates<br/>Type: kubernetes.io/tls<br/>Provisioned: Manual / cert-manager<br/>Auto-Rotate: No<br/>Config: ca_cert_file,<br/>client_cert_file, client_key_file"]
        HFToken["HuggingFace Token<br/>Type: Opaque<br/>Provisioned: Manual<br/>Auto-Rotate: No<br/>Config: HF_TOKEN env var"]
    end

    subgraph TLSConfig["TLS Configuration"]
        ServerTLS["Server TLS<br/>RUNTIME_TLS_SERVER_KEY<br/>RUNTIME_TLS_SERVER_CERT"]
        ClientTLS["TGIS Client TLS<br/>ca_cert_file<br/>client_cert_file<br/>client_key_file"]
    end

    CaikitNLP -->|"delegates auth to"| PlatformAuth
    TGISCerts -->|"used for mTLS"| ClientTLS
    HFToken -->|"used for downloads"| HTTPAuth
    ServerTLS -->|"secures"| HTTPAuth
    ServerTLS -->|"secures"| GRPCAuth

    style CaikitNLP fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style NoRBAC fill:#f9f9f9,stroke:#999
    style PlatformAuth fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style TLSConfig fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style HTTPEndpoints fill:#d5e8d4,stroke:#82b366
    style HTTPEnforcement fill:#d5e8d4,stroke:#82b366
    style GRPCServices fill:#d5e8d4,stroke:#82b366
    style GRPCEnforcement fill:#d5e8d4,stroke:#82b366
    style TGISCerts fill:#fff2cc,stroke:#d6b656
    style HFToken fill:#fff2cc,stroke:#d6b656
