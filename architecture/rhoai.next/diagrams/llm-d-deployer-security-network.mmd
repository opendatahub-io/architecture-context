graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS"]
        Gateway["Inference Gateway<br/>80/TCP HTTP<br/>GatewayClass: istio (default)<br/>TLS: optional"]
    end

    subgraph Routing["ROUTING LAYER"]
        EPP["Endpoint Picker<br/>9002/TCP gRPC (ExternalProcessor)<br/>9003/TCP gRPC (health)<br/>9090/TCP HTTP (metrics)<br/>SA: {release}-endpoint-picker"]
    end

    subgraph InferencePlane["INFERENCE PLANE"]
        direction TB

        subgraph PrefillZone["Prefill Nodes"]
            Prefill["Prefill vLLM<br/>8000/TCP HTTP<br/>5557/TCP NIXL<br/>runAsNonRoot, drop ALL caps<br/>ghcr.io/llm-d/llm-d:0.0.8"]
        end

        subgraph DecodeZone["Decode Nodes"]
            Proxy["Routing Proxy Sidecar<br/>8000/TCP HTTP ingress<br/>ghcr.io/llm-d/llm-d-routing-sidecar:0.0.7"]
            Decode["Decode vLLM<br/>8001/TCP HTTP<br/>5557/TCP NIXL<br/>runAsNonRoot, drop ALL caps<br/>ghcr.io/llm-d/llm-d:0.0.8"]
        end
    end

    subgraph DataLayer["DATA LAYER"]
        Redis["Redis<br/>8100/TCP<br/>Auth: disabled<br/>Encryption: none<br/>Bitnami 20.13.4"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        Controller["ModelService Controller<br/>8443/TCP HTTPS<br/>8081/TCP health<br/>SA: {release}-modelservice<br/>runAsNonRoot, drop ALL caps"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS, SA token"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN Bearer"]
    end

    %% Flows
    Client -->|"HTTP/80<br/>No encryption<br/>No auth (default)"| Gateway
    Gateway -->|"gRPC/9002<br/>No encryption<br/>No auth"| EPP
    EPP -->|"HTTP/8000<br/>No encryption<br/>No auth"| Prefill
    EPP -->|"HTTP/8000<br/>No encryption<br/>No auth"| Proxy
    Proxy -->|"HTTP/8001<br/>localhost"| Decode
    Prefill -->|"NIXL/5557<br/>TCP direct GPU-to-GPU<br/>No encryption"| Decode
    Prefill -->|"TCP/8100<br/>No encryption<br/>No auth"| Redis
    Decode -->|"TCP/8100<br/>No encryption<br/>No auth"| Redis
    Controller -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    Prefill -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN Bearer"| HFHub
    Decode -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN Bearer"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef routing fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef control fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class EPP routing
    class Prefill,Proxy,Decode inference
    class Redis data
    class Controller control
    class K8sAPI,HFHub extsvc
