graph TD
    subgraph "vllm-spyre RBAC Model"
        direction TB

        Note["NOTE: vllm-spyre defines no RBAC resources.<br/>It is a container image with no Kubernetes API interactions.<br/>All authentication and authorization is delegated<br/>to the kube-rbac-proxy sidecar."]
    end

    subgraph "Platform-Injected Auth (kube-rbac-proxy sidecar)"
        direction TB

        ExtClient["External Client"]
        KRBAC["kube-rbac-proxy<br/>(Sidecar Container)"]
        PlatformRBAC["Platform RBAC Policy<br/>(Defined by RHOAI Operator)"]

        ExtClient -->|"HTTPS/8443<br/>Bearer Token"| KRBAC
        KRBAC -->|"evaluates against"| PlatformRBAC
    end

    subgraph "Protected Endpoints"
        direction TB

        HTTPEndpoints["HTTP Endpoints (8000/TCP)"]
        HTTP1["/v1/completions - POST"]
        HTTP2["/v1/chat/completions - POST"]
        HTTP3["/v1/models - GET"]
        HTTP4["/health - GET"]

        GRPCEndpoints["gRPC Endpoints (8033/TCP)"]
        GRPC1["TGIS GenerationService<br/>unary/streaming"]

        HTTPEndpoints --- HTTP1
        HTTPEndpoints --- HTTP2
        HTTPEndpoints --- HTTP3
        HTTPEndpoints --- HTTP4
        GRPCEndpoints --- GRPC1
    end

    KRBAC -->|"authorized requests<br/>(localhost, no auth)"| HTTPEndpoints
    KRBAC -->|"authorized requests<br/>(localhost, no auth)"| GRPCEndpoints

    subgraph "Container Security Context"
        SecurityCtx["Non-root execution: USER 2000<br/>No privileged capabilities<br/>No Kubernetes API access"]
    end

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style KRBAC fill:#e8a838,stroke:#333,stroke-width:2px
    style PlatformRBAC fill:#f5a623,stroke:#333,stroke-width:2px
    style ExtClient fill:#e8e8e8,stroke:#333,stroke-width:2px
    style HTTPEndpoints fill:#4a90e2,stroke:#333,stroke-width:2px
    style GRPCEndpoints fill:#4a90e2,stroke:#333,stroke-width:2px
    style SecurityCtx fill:#d5e8d4,stroke:#82b366,stroke-width:2px
