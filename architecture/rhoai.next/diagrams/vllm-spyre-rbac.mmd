graph TD
    subgraph "Container Image (No Direct RBAC)"
        Container["vllm-spyre Container<br/>UID 2000 (non-root)"]
    end

    subgraph "Platform-Managed RBAC"
        SA["Service Account<br/>(assigned by KServe at deploy time)"]
        SR["ServingRuntime CR<br/>Defines container spec"]
        IS["InferenceService CR<br/>Defines model deployment"]
    end

    subgraph "Auth Enforcement Points"
        IstioSidecar["Istio Sidecar<br/>mTLS STRICT"]
        AuthzPolicy["AuthorizationPolicy<br/>Per InferenceService"]
        KubeRBAC["kube-rbac-proxy<br/>(optional)"]
    end

    subgraph "Exposed Ports (No Native Auth)"
        gRPC["gRPC :8033/TCP<br/>TGIS GenerationService<br/>No native auth"]
        HTTP["HTTP :8000/TCP<br/>OpenAI-compatible API<br/>No native auth"]
    end

    SR -->|"creates pod with"| SA
    IS -->|"triggers"| SR
    SA -->|"identity for"| Container
    Container -->|"serves"| gRPC
    Container -->|"serves"| HTTP

    IstioSidecar -->|"intercepts traffic to"| gRPC
    IstioSidecar -->|"intercepts traffic to"| HTTP
    AuthzPolicy -->|"applied to"| IstioSidecar
    KubeRBAC -->|"optional layer for"| HTTP

    style Container fill:#4a90e2,color:#fff
    style SA fill:#f5a623,color:#fff
    style SR fill:#7ed321,color:#fff
    style IS fill:#7ed321,color:#fff
    style IstioSidecar fill:#ffe6cc,stroke:#d79b00
    style AuthzPolicy fill:#ffe6cc,stroke:#d79b00
    style KubeRBAC fill:#ffe6cc,stroke:#d79b00
