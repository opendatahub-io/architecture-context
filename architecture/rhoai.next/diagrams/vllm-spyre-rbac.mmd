graph TD
    subgraph ContainerSecurity["vllm-spyre Container Security Model"]
        direction TB

        subgraph Runtime["Container Runtime Properties"]
            UID["Runs as UID 2000<br/>(non-root)"]
            NoK8sAPI["No Kubernetes API Access<br/>(no ServiceAccount token)"]
            NoEgress["No Egress<br/>(HF_HUB_OFFLINE=1)"]
            NoPrivEsc["No Privilege Escalation"]
        end

        subgraph AuthModel["Authentication Model<br/>(Platform-Managed)"]
            direction LR
            ExternalReq["External Request<br/>Bearer Token"]
            KRBP["kube-rbac-proxy<br/>(sidecar)"]
            K8sRBAC["Kubernetes RBAC<br/>API Server"]
            Inference["vllm-spyre<br/>(pre-authenticated)"]

            ExternalReq -->|"HTTPS/8443<br/>Bearer Token"| KRBP
            KRBP -->|"TokenReview API"| K8sRBAC
            K8sRBAC -->|"auth decision"| KRBP
            KRBP -->|"HTTP/8000 or gRPC/8033<br/>(no auth - localhost)"| Inference
        end

        subgraph Endpoints["Protected Endpoints"]
            HTTP_V1["/v1/* (HTTP)<br/>GET, POST<br/>Auth: Bearer Token<br/>Enforced by: kube-rbac-proxy"]
            TGIS["TGIS gRPC<br/>unary/streaming<br/>Auth: Bearer Token<br/>Enforced by: kube-rbac-proxy"]
        end
    end

    subgraph PlatformRBAC["Platform RBAC (Managed by rhods-operator)"]
        direction TB
        Note1["No ClusterRoles defined by this component"]
        Note2["No RoleBindings defined by this component"]
        Note3["No Secrets defined by this component"]
        Note4["All RBAC managed by KServe + rhods-operator"]
    end

    %% Styling
    style UID fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style NoK8sAPI fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style NoEgress fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style NoPrivEsc fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style KRBP fill:#f5a623,stroke:#d79b00,stroke-width:2px
    style K8sRBAC fill:#4a90e2,stroke:#2171c7,stroke-width:2px
    style Inference fill:#7ed321,stroke:#5ea81a,stroke-width:2px
    style HTTP_V1 fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style TGIS fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Note1 fill:#f9f9f9,stroke:#ccc,stroke-width:1px
    style Note2 fill:#f9f9f9,stroke:#ccc,stroke-width:1px
    style Note3 fill:#f9f9f9,stroke:#ccc,stroke-width:1px
    style Note4 fill:#f9f9f9,stroke:#ccc,stroke-width:1px
