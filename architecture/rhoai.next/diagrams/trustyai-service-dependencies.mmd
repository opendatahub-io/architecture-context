graph LR
    TrustyAI["TrustyAI Service<br/>(FastAPI + Hypercorn)"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"receives inference payloads<br/>REST CloudEvents"| KServe["KServe<br/>InferenceService"]
    TrustyAI -->|"receives protobuf payloads<br/>REST"| ModelMesh["ModelMesh<br/>ServingRuntime"]
    TrustyAI -.->|"deployed & configured by"| Operator["TrustyAI Operator"]

    %% Infrastructure Dependencies
    TrustyAI -->|"HDF5 data storage<br/>filesystem"| PVC["PersistentVolumeClaim"]
    TrustyAI -->|"optional DB storage<br/>MySQL/3306"| MariaDB["MariaDB"]
    TrustyAI -->|"auth proxy sidecar<br/>HTTPS/8443 → HTTP/8080"| KubeRBAC["kube-rbac-proxy"]

    %% External Dependencies (Python Libraries)
    TrustyAI -->|"REST framework"| FastAPI["FastAPI >=0.116"]
    TrustyAI -->|"ASGI server"| Hypercorn["Hypercorn >=0.18"]
    TrustyAI -->|"statistical tests"| SciPy["scipy >=1.15"]
    TrustyAI -->|"ML algorithms"| Sklearn["scikit-learn >=1.7"]
    TrustyAI -->|"metrics publishing"| PromClient["prometheus-client >=0.22"]
    TrustyAI -->|"protobuf parsing"| Protobuf["protobuf >=7"]
    TrustyAI -->|"HDF5 I/O"| H5py["h5py >=3.13"]
    TrustyAI -.->|"optional: LLM eval"| LMEval["lm-eval >=0.4"]

    %% Integration Points (consumers of TrustyAI)
    Dashboard["OpenShift Dashboard"] -->|"queries /info<br/>HTTPS/8443"| TrustyAI
    Prometheus["Prometheus Server"] -->|"scrapes /q/metrics<br/>HTTPS/8443"| TrustyAI

    %% Optional egress
    TrustyAI -.->|"optional: LM eval targets<br/>HTTPS"| LLMEndpoint["LLM Inference<br/>Endpoint"]

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelMesh fill:#7ed321,stroke:#333,color:#fff
    style Operator fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% Infrastructure
    style PVC fill:#f5a623,stroke:#333,color:#fff
    style MariaDB fill:#f5a623,stroke:#333,color:#fff
    style KubeRBAC fill:#e74c3c,stroke:#333,color:#fff

    %% External services
    style Prometheus fill:#999,stroke:#333,color:#fff
    style LLMEndpoint fill:#999,stroke:#333,color:#fff

    %% Python libraries
    style FastAPI fill:#e8e8e8,stroke:#333
    style Hypercorn fill:#e8e8e8,stroke:#333
    style SciPy fill:#e8e8e8,stroke:#333
    style Sklearn fill:#e8e8e8,stroke:#333
    style PromClient fill:#e8e8e8,stroke:#333
    style Protobuf fill:#e8e8e8,stroke:#333
    style H5py fill:#e8e8e8,stroke:#333
    style LMEval fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
