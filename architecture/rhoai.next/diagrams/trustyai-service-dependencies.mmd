graph LR
    TrustyAI["TrustyAI Service<br/>(Python / FastAPI)"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"auth proxy<br/>HTTP/8081 loopback"| KRBP["kube-rbac-proxy<br/>(sidecar)"]
    TrustyAI -->|"deployment mgmt<br/>Kubernetes API"| Operator["trustyai-service-operator"]

    %% Inbound Integration Dependencies
    KServe["KServe<br/>Inference Logger"] -->|"CloudEvents<br/>HTTP/8080"| TrustyAI
    ModelMesh["ModelMesh<br/>Agent"] -->|"KServe v2 JSON<br/>HTTP/8080"| TrustyAI

    %% Outbound Dependencies
    TrustyAI -->|"metric scrape<br/>HTTP/8081"| Prometheus["Prometheus"]
    TrustyAI -.->|"storage (optional)<br/>MySQL/3306 TLS"| MariaDB["MariaDB"]

    %% Python Library Dependencies
    subgraph PythonDeps["Key Python Dependencies"]
        FastAPI["FastAPI >=0.116"]
        Hypercorn["Hypercorn >=0.18"]
        ScikitLearn["scikit-learn >=1.7"]
        SciPy["scipy >=1.15"]
        Pandas["pandas >=3.0"]
        Polars["polars >=1.2"]
        H5py["h5py >=3.13"]
        PromClient["prometheus-client >=0.22"]
        Protobuf["protobuf >=7"]
    end

    TrustyAI --- PythonDeps

    %% Platform Dependencies
    Kubelet["Kubelet"] -->|"health probes<br/>HTTP/8080"| TrustyAI
    Dashboard["ODH Dashboard"] -->|"user requests<br/>via kube-rbac-proxy"| TrustyAI

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KRBP fill:#f5a623,stroke:#333
    style Operator fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ModelMesh fill:#7ed321,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style MariaDB fill:#999,stroke:#333
    style Kubelet fill:#999,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style PythonDeps fill:#f0f0f0,stroke:#ccc,stroke-width:1px
    style FastAPI fill:#fff,stroke:#999
    style Hypercorn fill:#fff,stroke:#999
    style ScikitLearn fill:#fff,stroke:#999
    style SciPy fill:#fff,stroke:#999
    style Pandas fill:#fff,stroke:#999
    style Polars fill:#fff,stroke:#999
    style H5py fill:#fff,stroke:#999
    style PromClient fill:#fff,stroke:#999
    style Protobuf fill:#fff,stroke:#999
