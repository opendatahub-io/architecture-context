graph LR
    TrustyAI["TrustyAI Service<br/>(Python/FastAPI)"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"deployment mgmt<br/>CRD reconciliation"| TrustyAIOperator["TrustyAI Operator"]
    TrustyAI -->|"inference payloads<br/>KServe V2 protocol"| KServe["KServe / ModelMesh"]
    TrustyAI -->|"auth sidecar<br/>8443→127.0.0.1:8080"| KubeRbacProxy["kube-rbac-proxy"]
    TrustyAI -->|"metrics scrape<br/>GET /q/metrics"| Prometheus["Prometheus"]

    %% Integration Points (inbound)
    Dashboard["RHOAI Dashboard"] -->|"REST API client<br/>queries /info, /metrics/*"| TrustyAI
    KServeAgent["KServe Agent"] -->|"POST / (CloudEvent)<br/>V2 inference payloads"| TrustyAI
    ModelMeshAgent["ModelMesh Agent"] -->|"POST /consumer/kserve/v2<br/>protobuf payloads"| TrustyAI
    K8sAPI["Kubernetes API"] -->|"health probes<br/>/q/health/*"| TrustyAI

    %% External Dependencies (egress)
    TrustyAI -->|"HDF5 file storage<br/>Local I/O"| PVC["PVC Storage"]
    TrustyAI -.->|"database storage<br/>3306/TCP TLS (optional)"| MariaDB["MariaDB"]
    TrustyAI -.->|"LM eval API calls<br/>443/TCP HTTPS (optional)"| LMEvalAPIs["LM Eval API Providers<br/>(OpenAI, Anthropic)"]

    %% Key Python Dependencies
    subgraph PythonDeps["Key Python Libraries"]
        FastAPI["FastAPI >=0.116"]
        Hypercorn["Hypercorn >=0.18"]
        SciPy["SciPy >=1.15"]
        ScikitLearn["scikit-learn >=1.7"]
        PromClient["prometheus-client >=0.22"]
        Protobuf["protobuf >=7"]
        H5py["h5py >=3.13"]
        Pandas["Pandas >=3.0"]
        NumPy["NumPy >=2.0"]
        Cryptography["cryptography >=48.0.1"]
    end

    TrustyAI -->|"runtime deps"| PythonDeps

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TrustyAIOperator fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style KubeRbacProxy fill:#d79b00,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style KServeAgent fill:#7ed321,stroke:#333,color:#fff
    style ModelMeshAgent fill:#7ed321,stroke:#333,color:#fff
