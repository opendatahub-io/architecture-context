graph LR
    Trainer["Kubeflow Trainer<br/>Operator"]

    %% Required External Dependencies
    Trainer -->|"creates JobSets<br/>(required)"| JobSet["JobSet Controller<br/>v0.10.1"]
    Trainer -->|"operator framework<br/>(required)"| ControllerRuntime["controller-runtime<br/>v0.22.3"]
    Trainer -->|"webhook TLS certs<br/>(required)"| CertController["cert-controller<br/>v0.14.0"]

    %% Optional External Dependencies
    Trainer -.->|"CoScheduling PodGroups<br/>(optional)"| SchedulerPlugins["scheduler-plugins<br/>v0.34.1-devel"]
    Trainer -.->|"Volcano PodGroups<br/>(optional)"| Volcano["Volcano<br/>v1.13.1"]

    %% Platform Dependencies
    Trainer -->|"reads TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]
    Trainer -->|"CRD reconciliation<br/>resource CRUD"| K8sAPI["Kubernetes API Server"]
    Trainer -->|"watches"| RuntimeClass["Kubernetes RuntimeClass<br/>node.k8s.io"]
    Trainer -->|"watches"| LimitRange["Kubernetes LimitRange"]

    %% Internal Platform Dependencies
    RhodsOperator["rhods-operator /<br/>opendatahub-operator"] -->|"deploys via<br/>kustomize"| Trainer

    %% Integration Points - Inbound
    Dashboard["ODH Dashboard"] -.->|"UI management<br/>(via CRDs)"| Trainer
    Prometheus["Prometheus"] -->|"scrapes :8443<br/>PodMonitor"| Trainer

    %% Integration Points - Outbound
    Trainer -->|"downloads datasets<br/>HTTPS"| Storage["S3 / GCS / PVC<br/>Object Storage"]

    %% Styling
    style Trainer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required (solid borders)
    style JobSet fill:#e8e8e8,stroke:#333,stroke-width:2px
    style ControllerRuntime fill:#e8e8e8,stroke:#333,stroke-width:2px
    style CertController fill:#e8e8e8,stroke:#333,stroke-width:2px

    %% Optional (dashed borders)
    style SchedulerPlugins fill:#f0f0f0,stroke:#999,stroke-width:1px,stroke-dasharray:5
    style Volcano fill:#f0f0f0,stroke:#999,stroke-width:1px,stroke-dasharray:5

    %% Platform
    style OpenShiftAPI fill:#6c8ebf,color:#fff
    style K8sAPI fill:#6c8ebf,color:#fff
    style RuntimeClass fill:#6c8ebf,color:#fff
    style LimitRange fill:#6c8ebf,color:#fff

    %% Internal Platform
    style RhodsOperator fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333

    %% External Services
    style Storage fill:#f5a623,stroke:#333
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
