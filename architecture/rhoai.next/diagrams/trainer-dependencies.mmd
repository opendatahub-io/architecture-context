graph LR
    Trainer["Kubeflow Trainer v2<br/>trainer-controller-manager"]

    %% Required External Dependencies
    Trainer -->|"creates JobSets<br/>HTTPS/443"| JobSet["JobSet Controller<br/>jobset.x-k8s.io v1alpha2<br/><b>Required</b>"]
    Trainer -->|"core platform<br/>HTTPS/443"| K8s["Kubernetes v1.34+<br/><b>Required</b>"]

    %% Optional External Dependencies
    Trainer -.->|"creates PodGroups<br/>gang scheduling"| CoSched["Coscheduling<br/>scheduling.x-k8s.io v1alpha1<br/><i>Optional</i>"]
    Trainer -.->|"creates PodGroups<br/>gang scheduling"| Volcano["Volcano Scheduler<br/>scheduling.volcano.sh v1beta1<br/><i>Optional</i>"]

    %% Internal RHOAI Dependencies
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"deploys via<br/>kustomize manifests"| Trainer
    Trainer -->|"reads cluster<br/>TLS security profile<br/>HTTPS/443"| OCP_API["OpenShift APIServer<br/>config.openshift.io"]

    %% Integration Points - Inbound
    Prometheus["Prometheus /<br/>OCP Monitoring"] -->|"scrapes metrics<br/>PodMonitor<br/>HTTPS/8443"| Trainer
    Kueue["Kueue / MultiKueue"] -.->|"delegates via<br/>managedBy field"| Trainer

    %% Integration Points - Outbound (Workload)
    Trainer -->|"polls /metrics<br/>HTTP/28080<br/>RHAI progression"| TrainingPods["Training Pods<br/>(PyTorch/MPI/TorchTune/<br/>DeepSpeed)"]
    Trainer -->|"creates per-job"| NetPol["NetworkPolicies<br/>RHAI pod isolation"]

    %% Inter-pod
    TrainingPods <-->|"NCCL/MPI/gRPC<br/>TCP/29500<br/>plaintext"| TrainingPods

    %% Cert management
    Trainer -->|"webhook TLS"| CertCtrl["cert-controller<br/>(open-policy-agent)<br/>auto-rotate"]

    %% Styling
    style Trainer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external (dark gray)
    style JobSet fill:#666,stroke:#333,color:#fff
    style K8s fill:#666,stroke:#333,color:#fff

    %% Optional external (light gray)
    style CoSched fill:#999,stroke:#333,color:#fff
    style Volcano fill:#999,stroke:#333,color:#fff
    style Kueue fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI (green)
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style OCP_API fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff

    %% Workload (orange)
    style TrainingPods fill:#f5a623,stroke:#333
    style NetPol fill:#e74c3c,stroke:#333,color:#fff

    %% Infrastructure
    style CertCtrl fill:#9b59b6,stroke:#333,color:#fff
