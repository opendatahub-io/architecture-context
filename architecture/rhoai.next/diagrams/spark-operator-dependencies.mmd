graph LR
    SparkOp["Spark Operator<br/>v2.5.0-rc.0"]

    %% External Dependencies (Required)
    SparkOp -->|"container orchestration"| K8s["Kubernetes 1.16+"]
    SparkOp -->|"controller framework"| CR["controller-runtime v0.23.3"]
    SparkOp -->|"distributed computing"| Spark["Apache Spark 3.0+<br/>(4.0.1 bundled)"]
    SparkOp -->|"JVM runtime"| Java["Java 17 (OpenJDK)"]

    %% External Dependencies (Optional)
    SparkOp -.->|"TLS cert mgmt"| CertManager["cert-manager"]
    SparkOp -.->|"gang scheduling<br/>(PodGroup CR)"| Volcano["Volcano v1/v1beta1"]
    SparkOp -.->|"gang scheduling<br/>(scheduler-plugins PodGroup)"| KubeSched["kube-scheduler-plugins"]
    SparkOp -.->|"gang scheduling<br/>(pod annotations)"| YuniKorn["YuniKorn"]
    SparkOp -.->|"metrics collection"| Prometheus["Prometheus"]
    SparkOp -.->|"external submission<br/>(RestSubmitter gate, mTLS)"| RESTSubmitter["REST Spark Submitter"]

    %% Internal Platform Dependencies
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates SparkOperator CR"| SparkOp
    Dashboard["ODH Dashboard"] -.->|"NetworkPolicy allows<br/>SparkConnect gRPC/15002"| SparkOp

    %% Control Plane Dependencies
    SparkOp -->|"CRD watches,<br/>pod CRUD, RBAC"| K8sAPI["Kubernetes API Server"]
    SparkOp -->|"TLS security profile"| OpenShiftAPI["OpenShift APIServer"]

    %% Styling
    style SparkOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external (gray)
    style K8s fill:#999,stroke:#333,color:#fff
    style CR fill:#999,stroke:#333,color:#fff
    style Spark fill:#999,stroke:#333,color:#fff
    style Java fill:#999,stroke:#333,color:#fff

    %% Optional external (light gray)
    style CertManager fill:#bbb,stroke:#333
    style Volcano fill:#bbb,stroke:#333
    style KubeSched fill:#bbb,stroke:#333
    style YuniKorn fill:#bbb,stroke:#333
    style Prometheus fill:#bbb,stroke:#333
    style RESTSubmitter fill:#bbb,stroke:#333

    %% Internal platform (green)
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% Control plane (orange)
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style OpenShiftAPI fill:#f5a623,stroke:#333,color:#fff
