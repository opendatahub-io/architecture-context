graph LR
    SparkOp["Spark Operator<br/>v2.5.0-rc.0"]

    %% External Dependencies (required)
    SparkOp -->|"spark-submit<br/>bundled in image"| Spark["Apache Spark 4.0.1<br/>(PySpark)"]
    SparkOp -->|"JVM runtime"| Java["Java 17<br/>(OpenJDK)"]
    SparkOp -->|"controller framework"| CR["controller-runtime<br/>v0.23.3"]
    SparkOp -->|"init process (PID 1)"| Catatonit["catatonit"]

    %% External Dependencies (optional)
    SparkOp -.->|"Helm deploy path"| Helm["Helm v3<br/>v3.18.5"]

    %% Internal Platform Dependencies
    SparkOp -->|"kustomize deploy"| RHODS["rhods-operator /<br/>opendatahub-operator"]
    SparkOp -.->|"optional TLS certs"| CertMgr["cert-manager"]
    SparkOp -.->|"gang scheduling<br/>PodGroup CRDs"| Volcano["Volcano Scheduler"]
    SparkOp -.->|"batch scheduling<br/>task group annotations"| Yunikorn["Yunikorn Scheduler"]
    SparkOp -->|"metrics scraping<br/>PodMonitor"| Prometheus["Prometheus"]

    %% Integration Points (consumers of Spark Operator)
    K8sAPI["Kubernetes API Server"] -->|"admission webhooks<br/>CRD reconciliation"| SparkOp
    OpenShiftAPI["OpenShift APIServer CR"] -.->|"TLS profile<br/>cipher alignment"| SparkOp

    %% Optional
    RESTSub["REST Submitter<br/>(feature gate)"] -.->|"remote spark-submit<br/>optional mTLS"| SparkOp

    %% Managed Resources (downstream)
    SparkOp -->|"creates/manages"| DriverPods["Spark Driver Pods"]
    SparkOp -->|"creates/manages"| ExecPods["Spark Executor Pods"]
    SparkOp -->|"creates/manages"| ConnectPods["SparkConnect Server Pods"]
    SparkOp -->|"creates"| Services["Services, Ingresses,<br/>PDBs, NetworkPolicies"]

