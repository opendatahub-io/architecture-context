graph TD
    subgraph Legend["Legend"]
        direction LR
        LegSA["Service Account"]
        LegSecret["Secret"]
        LegEndpoint["Endpoint"]
        style LegSA fill:#4a90e2,color:#fff
        style LegSecret fill:#ff6b6b,color:#fff
        style LegEndpoint fill:#7ed321,color:#fff
    end

    subgraph PipelineSA["Pipeline Service Accounts (Configured by DSPO/Admin)"]
        SA["Pipeline ServiceAccount<br/>(per-namespace)"]
    end

    subgraph RequiredRBAC["Required RBAC (Not Defined Here - Configured Externally)"]
        direction TB
        KServeCR["ClusterRole: kserve-access<br/>serving.kserve.io<br/>InferenceService, ServingRuntime<br/>Verbs: create, get, list, watch, delete"]
        TrainingCR["ClusterRole: training-access<br/>training.kubeflow.org<br/>ClusterTrainingRuntime, TrainingJob<br/>Verbs: create, get, list, watch"]
        RayCR["ClusterRole: ray-access<br/>ray.io<br/>RayJob<br/>Verbs: create, get, list, watch, delete"]
        KueueCR["ClusterRole: kueue-access<br/>kueue.x-k8s.io<br/>WorkloadPriorityClass<br/>Verbs: get, list"]
        CoreCR["ClusterRole: core-access<br/>core<br/>pods, services, configmaps, secrets<br/>Verbs: get, list, create"]
        HwProfileCR["ClusterRole: hwprofile-access<br/>dashboard.opendatahub.io<br/>HardwareProfile<br/>Verbs: get, list"]
    end

    subgraph Secrets["Secrets Used by Pipeline Tasks"]
        direction TB
        S3Secret["s3-secret (Opaque)<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>AWS_S3_ENDPOINT<br/>AWS_DEFAULT_REGION<br/>Manual | No rotation"]
        HFSecret["hf-token (Opaque)<br/>HF_TOKEN<br/>Manual | No rotation"]
        LLMSecret["llm-credentials (Opaque)<br/>LLM API Key<br/>Manual | No rotation"]
        K8sSecret["kubernetes-credentials (Opaque)<br/>K8s API credentials<br/>Manual | No rotation"]
        OCISecret["oci-pull-secret (dockerconfigjson)<br/>OCI registry auth<br/>Manual | No rotation"]
        MinioSecret["minio-secret (Opaque)<br/>access_key, secret_key<br/>Manual | No rotation"]
        OGXSecret["ogx_secret (Opaque)<br/>OGX_CLIENT_BASE_URL<br/>OGX_CLIENT_API_KEY<br/>Manual | No rotation"]
    end

    subgraph AuthEndpoints["Authentication Endpoints"]
        direction TB
        S3Auth["S3 / MinIO<br/>AWS SigV4<br/>IAM Policy"]
        HFAuth["HuggingFace Hub<br/>Bearer Token<br/>Public/Gated"]
        OGXAuth["OGX API<br/>API Key Header<br/>API Key Validation"]
        K8sAuth["Kubernetes API<br/>SA Token<br/>RBAC"]
        KServeAuth["KServe<br/>None / Bearer<br/>Model-Level"]
        MilvusAuth["Milvus<br/>Token (optional)<br/>Database-Level"]
    end

    %% SA to RBAC
    SA -->|"requires"| KServeCR
    SA -->|"requires"| TrainingCR
    SA -->|"requires"| RayCR
    SA -->|"requires"| KueueCR
    SA -->|"requires"| CoreCR
    SA -->|"requires"| HwProfileCR

    %% Secrets to Auth
    S3Secret -->|"provides credentials"| S3Auth
    HFSecret -->|"provides token"| HFAuth
    OGXSecret -->|"provides API key"| OGXAuth
    K8sSecret -->|"provides creds"| K8sAuth
    SA -->|"SA Token"| K8sAuth

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style KServeCR fill:#f5a623,stroke:#333
    style TrainingCR fill:#f5a623,stroke:#333
    style RayCR fill:#f5a623,stroke:#333
    style KueueCR fill:#f5a623,stroke:#333
    style CoreCR fill:#f5a623,stroke:#333
    style HwProfileCR fill:#f5a623,stroke:#333
    style S3Secret fill:#ff6b6b,stroke:#333,color:#fff
    style HFSecret fill:#ff6b6b,stroke:#333,color:#fff
    style LLMSecret fill:#ff6b6b,stroke:#333,color:#fff
    style K8sSecret fill:#ff6b6b,stroke:#333,color:#fff
    style OCISecret fill:#ff6b6b,stroke:#333,color:#fff
    style MinioSecret fill:#ff6b6b,stroke:#333,color:#fff
    style OGXSecret fill:#ff6b6b,stroke:#333,color:#fff
    style S3Auth fill:#7ed321,stroke:#333
    style HFAuth fill:#7ed321,stroke:#333
    style OGXAuth fill:#7ed321,stroke:#333
    style K8sAuth fill:#7ed321,stroke:#333
    style KServeAuth fill:#7ed321,stroke:#333
    style MilvusAuth fill:#7ed321,stroke:#333
