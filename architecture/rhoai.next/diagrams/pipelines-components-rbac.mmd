graph TD
    subgraph ServiceAccounts["Service Accounts"]
        PipelineSA["{pipeline-sa}<br/>Namespace: {user-namespace}"]
    end

    subgraph RoleBindings["Role Bindings (Configured by Platform Operator)"]
        RB1["pipeline-kserve-binding"]
        RB2["pipeline-core-binding"]
        RB3["pipeline-ray-binding"]
        RB4["pipeline-trainer-binding"]
    end

    subgraph Roles["Roles / ClusterRoles (Runtime Requirements)"]
        KServeRole["KServe Access Role"]
        CoreRole["Core Resources Role"]
        RayRole["Ray Access Role"]
        TrainerRole["Trainer Access Role"]
    end

    subgraph KServeResources["serving.kserve.io Resources"]
        ServingRuntimes["ServingRuntimes"]
        InferenceServices["InferenceServices"]
    end

    subgraph CoreResources["Core ('') Resources"]
        Pods["Pods"]
        Services["Services"]
        Secrets["Secrets"]
        ConfigMaps["ConfigMaps"]
        PodsLog["Pods/log"]
    end

    subgraph RayResources["ray.io Resources"]
        RayJobs["RayJobs"]
    end

    subgraph TrainerResources["kubeflow.org Resources"]
        TrainJobs["TrainJobs"]
    end

    %% Bindings
    PipelineSA -->|bound via| RB1
    PipelineSA -->|bound via| RB2
    PipelineSA -->|bound via| RB3
    PipelineSA -->|bound via| RB4

    RB1 -->|grants| KServeRole
    RB2 -->|grants| CoreRole
    RB3 -->|grants| RayRole
    RB4 -->|grants| TrainerRole

    %% Permissions
    KServeRole -->|"get, list, create,<br/>patch, delete"| ServingRuntimes
    KServeRole -->|"get, list, create,<br/>patch, delete"| InferenceServices

    CoreRole -->|"get, list"| Pods
    CoreRole -->|"get, list"| Services
    CoreRole -->|"get, list"| Secrets
    CoreRole -->|"get, list"| ConfigMaps
    CoreRole -->|"get"| PodsLog

    RayRole -->|"get, list,<br/>create, delete"| RayJobs

    TrainerRole -->|"get, list,<br/>create, watch"| TrainJobs

    %% Secrets used by pipeline tasks
    subgraph SecretResources["Secrets Referenced by Pipeline Tasks"]
        S3Secret["s3-secret / minio-secret<br/>(Opaque)<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
        HFSecret["hf-token<br/>(Opaque)<br/>HuggingFace Token"]
        K8sCreds["kubernetes-credentials<br/>(Opaque)<br/>KUBERNETES_SERVER_URL<br/>KUBERNETES_AUTH_TOKEN"]
        OCISecret["oci-pull-secret-model-download<br/>(kubernetes.io/dockerconfigjson)<br/>Docker config.json"]
        OGXSecret["ogx-secret<br/>(Opaque)<br/>OGX_CLIENT_BASE_URL<br/>OGX_CLIENT_API_KEY"]
        LLMCreds["llm-credentials<br/>(Opaque)<br/>LLM API key"]
    end

    PipelineSA -.->|"mounts/reads"| S3Secret
    PipelineSA -.->|"mounts/reads"| HFSecret
    PipelineSA -.->|"mounts/reads"| K8sCreds
    PipelineSA -.->|"mounts/reads"| OCISecret
    PipelineSA -.->|"mounts/reads"| OGXSecret
    PipelineSA -.->|"mounts/reads"| LLMCreds

    %% Styling
    style PipelineSA fill:#4a90e2,stroke:#333,color:#fff

    style RB1 fill:#e1d5e7,stroke:#9673a6
    style RB2 fill:#e1d5e7,stroke:#9673a6
    style RB3 fill:#e1d5e7,stroke:#9673a6
    style RB4 fill:#e1d5e7,stroke:#9673a6

    style KServeRole fill:#f5a623,stroke:#333,color:#fff
    style CoreRole fill:#f5a623,stroke:#333,color:#fff
    style RayRole fill:#f5a623,stroke:#333,color:#fff
    style TrainerRole fill:#f5a623,stroke:#333,color:#fff

    style ServingRuntimes fill:#7ed321,stroke:#333,color:#fff
    style InferenceServices fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style Services fill:#7ed321,stroke:#333,color:#fff
    style Secrets fill:#7ed321,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style PodsLog fill:#7ed321,stroke:#333,color:#fff
    style RayJobs fill:#7ed321,stroke:#333,color:#fff
    style TrainJobs fill:#7ed321,stroke:#333,color:#fff

    style S3Secret fill:#fff2cc,stroke:#d6b656
    style HFSecret fill:#fff2cc,stroke:#d6b656
    style K8sCreds fill:#fff2cc,stroke:#d6b656
    style OCISecret fill:#fff2cc,stroke:#d6b656
    style OGXSecret fill:#fff2cc,stroke:#d6b656
    style LLMCreds fill:#fff2cc,stroke:#d6b656
