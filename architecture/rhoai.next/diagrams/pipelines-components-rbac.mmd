graph TD
    subgraph "Service Accounts"
        KFPSA["KFP Controller-configured SA<br/>(per-namespace)"]
        ExplicitSA["Explicit KUBERNETES_AUTH_TOKEN<br/>(training components)"]
    end

    subgraph "Required Permissions"
        direction TB
        Note["No RBAC manifests defined by<br/>pipelines-components directly.<br/>Permissions required at runtime:"]
    end

    subgraph "KServe API Resources"
        ServingRuntime["serving.kserve.io/v1alpha1<br/>ServingRuntime"]
        InferenceService["serving.kserve.io/v1beta1<br/>InferenceService"]
    end

    subgraph "ODH API Resources"
        HardwareProfile["infrastructure.opendatahub.io/v1<br/>HardwareProfile"]
    end

    subgraph "Core API Resources"
        Services["core/v1<br/>Services"]
        Pods["core/v1<br/>Pods"]
        Secrets["core/v1<br/>Secrets"]
        ConfigMaps["core/v1<br/>ConfigMaps"]
    end

    subgraph "Secrets Required (env vars via KFP)"
        HF_TOKEN["HF_TOKEN<br/>HuggingFace auth"]
        AWS_KEY["AWS_SECRET_ACCESS_KEY<br/>S3 auth"]
        S3_KEY["S3_SECRET_KEY<br/>S3-compatible auth"]
        LLM_KEY["LLM_API_KEY<br/>LLM inference auth"]
        OCI_SECRET["OCI_PULL_SECRET_MODEL_DOWNLOAD<br/>OCI registry auth"]
        K8S_TOKEN["KUBERNETES_AUTH_TOKEN<br/>K8s API auth"]
        TEST_AWS["TEST_DATA_AWS_SECRET_ACCESS_KEY<br/>AutoRAG test S3"]
        INPUT_AWS["INPUT_DATA_AWS_SECRET_ACCESS_KEY<br/>AutoRAG input S3"]
    end

    %% SA to resources
    KFPSA -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ServingRuntime
    KFPSA -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| InferenceService
    KFPSA -->|"get,list"| HardwareProfile
    KFPSA -->|"get,list"| Services
    KFPSA -->|"get,list"| Pods
    ExplicitSA -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ServingRuntime
    ExplicitSA -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| InferenceService

    %% Secrets consumed
    KFPSA -.->|"injected by KFP"| HF_TOKEN
    KFPSA -.->|"injected by KFP"| AWS_KEY
    KFPSA -.->|"injected by KFP"| S3_KEY
    KFPSA -.->|"injected by KFP"| LLM_KEY
    KFPSA -.->|"injected by KFP"| OCI_SECRET
    KFPSA -.->|"injected by KFP"| TEST_AWS
    KFPSA -.->|"injected by KFP"| INPUT_AWS

    %% Styling
    style KFPSA fill:#4a90e2,color:#fff
    style ExplicitSA fill:#4a90e2,color:#fff
    style Note fill:#fff3cd,stroke:#856404
    style ServingRuntime fill:#7ed321,color:#fff
    style InferenceService fill:#7ed321,color:#fff
    style HardwareProfile fill:#7ed321,color:#fff
    style Services fill:#b8daff
    style Pods fill:#b8daff
    style Secrets fill:#b8daff
    style ConfigMaps fill:#b8daff
    style HF_TOKEN fill:#f5a623,color:#fff
    style AWS_KEY fill:#f5a623,color:#fff
    style S3_KEY fill:#f5a623,color:#fff
    style LLM_KEY fill:#f5a623,color:#fff
    style OCI_SECRET fill:#f5a623,color:#fff
    style K8S_TOKEN fill:#f5a623,color:#fff
    style TEST_AWS fill:#f5a623,color:#fff
    style INPUT_AWS fill:#f5a623,color:#fff
