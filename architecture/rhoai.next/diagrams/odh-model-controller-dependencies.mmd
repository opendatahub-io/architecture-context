graph LR
    ODH["odh-model-controller<br/>Operator + REST API"]

    %% External Dependencies (Required)
    ODH -->|"CRD Watch + Reconcile<br/>(Required)"| KServe["KServe<br/>v0.17.0-rc1"]
    ODH -->|"ServiceMonitor/PodMonitor<br/>(Required)"| PromOp["Prometheus Operator<br/>v0.89.0"]
    ODH -->|"Gateway + HTTPRoute<br/>(Required)"| GatewayAPI["Gateway API<br/>v1"]
    ODH -->|"Route, Template, Config<br/>(Required)"| OpenShift["OpenShift API<br/>v0.0.0-20260306"]

    %% External Dependencies (Conditional)
    ODH -->|"AuthPolicy CRUD<br/>(Conditional)"| Kuadrant["Kuadrant Operator<br/>v1.4.2"]
    ODH -->|"TLS bootstrap detect<br/>(Conditional)"| Authorino["Authorino<br/>v0.22.0"]
    ODH -->|"EnvoyFilter CRUD<br/>(Conditional)"| Istio["Istio<br/>v1.27.8"]
    ODH -->|"TriggerAuthentication<br/>(Conditional)"| KEDA["KEDA<br/>v2.18.3"]
    ODH -->|"Model Registry sync<br/>(Conditional)"| KubeflowHub["Kubeflow Hub<br/>v0.3.9"]
    ODH -->|"NIM catalog + validation<br/>(Conditional)"| NGC["NVIDIA NGC API"]

    %% Internal Platform Dependencies
    ODH -->|"CRD Watch (read-only)"| DSC["DataScienceCluster"]
    ODH -->|"CRD Watch (read-only)"| DSCI["DSCInitialization"]
    ODH -->|"CRD Watch (read-only)"| HWProfile["HardwareProfile"]
    ODH -->|"RoleBinding creation"| OSMonitoring["OpenShift Monitoring"]
    ODH -->|"ConfigMap Watch"| KServeConfig["KServe ISVC Config"]
    ODH -->|"Template API"| OSTemplates["OpenShift Templates"]

    %% Integration Points (consumers of this component)
    RHOAIDash["RHOAI Dashboard"] -->|"REST API /api/v1/gateways<br/>HTTPS/8443"| ODH
    KnativeServing["Knative Serving"] -.->|"Domain resolution<br/>(InferenceGraph validation)"| ODH

    %% Label injection
    ODH -.->|"queue-name label injection"| Kueue["Kueue"]

