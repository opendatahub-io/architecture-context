graph LR
    ODMC["odh-model-controller<br/>Operator + API Server"]

    %% External Dependencies (Required)
    ODMC -->|"InferenceService, ServingRuntime,<br/>InferenceGraph, LLMInferenceService CRDs"| KServe["KServe v0.17.0-rc1<br/>(ODH fork)"]
    ODMC -->|"Route, Template,<br/>Authentication CRDs"| OpenShiftAPI["OpenShift API<br/>v0.0.0-20260306"]

    %% External Dependencies (Optional)
    ODMC -.->|"AuthPolicy for<br/>inference auth"| Kuadrant["Kuadrant v1.4.2 /<br/>Authorino v0.22.0"]
    ODMC -.->|"TriggerAuthentication<br/>for autoscaling"| KEDA["KEDA v2.18.3"]
    ODMC -.->|"EnvoyFilter for<br/>Authorino TLS bootstrap"| Istio["Istio v1.27.8"]
    ODMC -.->|"ServiceMonitor,<br/>PodMonitor"| PromOp["Prometheus Operator<br/>v0.89.0"]
    ODMC -.->|"Gateway, HTTPRoute<br/>for LLM ingress"| GatewayAPI["Gateway API v1.2.1"]
    ODMC -.->|"InferencePool,<br/>InferenceModel"| GatewayInfer["Gateway API<br/>Inference Ext v1.3.1"]
    ODMC -.->|"Service CRD<br/>serverless mode"| Knative["Knative Serving<br/>v0.48.1"]
    ODMC -.->|"optional TLS<br/>cert management"| CertManager["cert-manager v1.16.3"]

    %% Internal ODH Dependencies
    ODMC -->|"reads platform config<br/>(namespace, component states)"| RhodsOp["rhods-operator /<br/>opendatahub-operator"]
    ODMC -.->|"syncs deployed<br/>models (optional)"| ModelRegistry["Model Registry"]
    ODMC -->|"resolves hardware<br/>scheduling constraints"| HWProfile["HardwareProfile<br/>Controller"]

    %% Integration Points (consumers of ODMC)
    Dashboard["RHOAI Dashboard"] -->|"GET /api/v1/gateways<br/>GET /api/v1/samples/llm-d<br/>8443/TCP HTTPS FIPS"| ODMC
    KServe -->|"CRD lifecycle<br/>triggers reconciliation"| ODMC

    %% External Services
    ODMC -->|"NIM catalog,<br/>API key validation<br/>443/TCP HTTPS"| NIMAPI["NVIDIA NIM API<br/>api.ngc.nvidia.com"]
    ODMC -->|"Route exposure<br/>for InferenceServices"| OSRouter["OpenShift Router"]
    ODMC -->|"KEDA metrics source<br/>SA token auth"| OSMonitoring["OpenShift Monitoring<br/>(Prometheus)"]
    ODMC -.->|"model registration<br/>443/TCP HTTPS"| ModelReg2["Model Registry API"]

    %% Kubernetes API (implicit)
    ODMC -->|"all CRD CRUD<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]

    %% Styling
    style ODMC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style KServe fill:#e8744f,stroke:#333,color:#fff
    style OpenShiftAPI fill:#e8744f,stroke:#333,color:#fff

    %% Optional external
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style KEDA fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style PromOp fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style GatewayInfer fill:#999,stroke:#333,color:#fff
    style Knative fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff

    %% Internal ODH
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style ModelRegistry fill:#7ed321,stroke:#333,color:#fff
    style HWProfile fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style NIMAPI fill:#f5a623,stroke:#333,color:#fff
    style OSRouter fill:#f5a623,stroke:#333,color:#fff
    style OSMonitoring fill:#f5a623,stroke:#333,color:#fff
    style ModelReg2 fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
