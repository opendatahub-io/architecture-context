graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformIngress["INGRESS (Platform-Managed)"]
        Gateway["Platform Ingress<br/>(Gateway/Route)<br/>443/TCP<br/>TLS 1.2+<br/>OpenShift OAuth"]
    end

    subgraph Sidecar["SIDECAR (Auth Enforcement)"]
        KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP → 8888/TCP<br/>TLS termination<br/>SubjectAccessReview"]
    end

    subgraph OVMSPod["OVMS POD (UID 5000, non-root, all caps dropped)"]
        direction TB

        subgraph RESTPort["REST Port 8888/TCP (HTTP plaintext)"]
            TFSAPI["/v1/* TFS API"]
            KServeAPI["/v2/* KServe v2 API"]
            OpenAIAPI["/v3/* OpenAI API"]
            HealthAPI["/v2/health/* (unauth)"]
            MetricsAPI["/metrics (unauth)"]
        end

        subgraph GRPCPort["gRPC Port 8001/TCP (plaintext)"]
            GRPCInfer["GRPCInferenceService<br/>InsecureServerCredentials"]
            TFSGPRC["TFS PredictionService"]
        end

        subgraph InProcess["In-Process Runtime"]
            OpenVINO["OpenVINO Runtime 2026.2"]
            GenAI["OpenVINO GenAI 2026.2"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Model Storage)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP Service Account"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Storage Key / SAS Token"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+ (libgit2)<br/>HF_TOKEN (optional)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (OAuth)"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Kubernetes RBAC"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8888<br/>plaintext (localhost)<br/>No auth (delegated)"| RESTPort

    Client -.->|"gRPC/8001<br/>plaintext<br/>No auth"| GRPCPort

    RESTPort --> InProcess
    GRPCPort --> InProcess

    InProcess -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    InProcess -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP SA"| GCS
    InProcess -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure Key"| Azure
    InProcess -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HF

    Prometheus -->|"HTTP/8888<br/>plaintext<br/>No auth"| MetricsAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef sidecar fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef unauth fill:#fff,stroke:#cc0000,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gateway ingress
    class KubeRBACProxy sidecar
    class TFSAPI,KServeAPI,OpenAIAPI,GRPCInfer,TFSGPRC,OpenVINO,GenAI application
    class HealthAPI,MetricsAPI unauth
    class S3,GCS,Azure,HF externalservice
    class Prometheus monitoring
