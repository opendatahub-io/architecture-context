graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)<br/>Managed by KServe / RHOAI"]
        Gateway["Platform Ingress<br/>(Gateway API / kube-rbac-proxy)<br/>443/TCP → rest_port or port/TCP<br/>TLS 1.2+ termination<br/>Platform auth"]
    end

    subgraph AppPod["APPLICATION (KServe InferenceService Pod)<br/>UID 5000 (non-root) | No K8s API access"]
        direction TB

        subgraph HTTPLayer["HTTP Frontend (Drogon)"]
            HTTPFE["OVMS HTTP Server<br/>rest_port/TCP<br/>HTTP (plaintext)<br/>Bearer Token on /v3/* only"]
        end

        subgraph GRPCLayer["gRPC Frontend"]
            GRPCFE["OVMS gRPC Server<br/>port/TCP<br/>gRPC (plaintext)<br/>No auth"]
        end

        subgraph InferenceEngine["Inference Engine (in-process)"]
            OVRuntime["OpenVINO Runtime 2026.2"]
            OVGenAI["OpenVINO GenAI 2026.2"]
            OVTokenizers["OpenVINO Tokenizers 2026.2"]
        end

        subgraph Pipelines["Pipeline Execution (in-process)"]
            MPipe["MediaPipe Graphs"]
            DAG["DAG Pipeline Engine"]
            PyNode["Python Nodes (pybind11)"]
        end

        HfPull["HfPullModelModule<br/>(libgit2 / curl)"]

        HTTPFE --> OVRuntime
        HTTPFE --> MPipe
        GRPCFE --> OVRuntime
        MPipe --> OVGenAI
        MPipe --> OVTokenizers
        DAG --> OVRuntime
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS (system CA)<br/>HF Token (Bearer)"]
        S3["AWS S3<br/>s3.amazonaws.com<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM"]
        GCS["Google Cloud Storage<br/>storage.googleapis.com<br/>443/TCP HTTPS<br/>TLS<br/>ADC"]
        Azure["Azure Blob Storage<br/>*.blob.core.windows.net<br/>443/TCP HTTPS<br/>TLS<br/>Connection string"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform auth"| Gateway
    Gateway -->|"HTTP/rest_port<br/>Plaintext (pod-internal)<br/>No encryption"| HTTPFE
    Gateway -->|"gRPC/port<br/>Plaintext (pod-internal)<br/>No encryption"| GRPCFE
    HfPull -->|"HTTPS/443<br/>TLS (libgit2/curl)<br/>HF Token"| HFHub
    HfPull -->|"HTTPS/443<br/>TLS (AWS SDK)<br/>IAM credentials"| S3
    HfPull -->|"HTTPS/443<br/>TLS (GCS SDK)<br/>ADC"| GCS
    HfPull -->|"HTTPS/443<br/>TLS (Azure SDK)<br/>Connection string"| Azure
    Prometheus -->|"HTTP/rest_port<br/>GET /metrics<br/>No auth"| HTTPFE

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef runtime fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class HTTPFE,GRPCFE app
    class OVRuntime,OVGenAI,OVTokenizers runtime
    class MPipe,DAG,PyNode app
    class HfPull app
    class HFHub,S3,GCS,Azure externalservice
    class Prometheus monitoring
