graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Application"]
    end

    subgraph Ingress["INGRESS (Platform-Managed TLS)"]
        Gateway["Istio Gateway / OpenShift Route<br/>443/TCP<br/>TLS Termination"]
    end

    subgraph AppPod["APPLICATION POD (Namespace-scoped)"]
        direction TB

        subgraph OVMSContainer["OVMS Container (UID 5000, drop ALL caps)"]
            direction TB
            RESTAPI["HTTP REST API<br/>rest_port/TCP<br/>Drogon Framework<br/>Bearer Token (optional)"]
            GRPCServer["gRPC Server<br/>grpc_port/TCP (default 9000)<br/>InsecureServerCredentials<br/>No Auth"]
            Metrics["/metrics Endpoint<br/>rest_port/TCP<br/>No Auth<br/>Prometheus Format"]
            HealthProbes["Health Probes<br/>/v2/health/ready<br/>/v2/health/live<br/>No Auth"]
        end

        subgraph OptionalSidecar["Optional: nginx-mtls-auth Sidecar"]
            Nginx["nginx Reverse Proxy<br/>mTLS Termination<br/>Client Cert Validation"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS (system CA)<br/>AWS IAM Credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS (system CA)<br/>GCP Credentials"]
        AzureBlob["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS (system CA)<br/>Azure Credentials"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS (CURLSSLOPT_NATIVE_CA)<br/>Bearer HF_TOKEN (optional)"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        KServe["KServe Controller<br/>Deploys OVMS via<br/>ServingRuntime CRD"]
        Prometheus["Prometheus<br/>Metrics Scraping"]
    end

    %% Inbound flows
    Client -->|"HTTPS/443<br/>TLS (platform)<br/>Bearer Token (optional)"| Gateway
    Gateway -->|"HTTP/rest_port<br/>Plaintext (TLS terminated)<br/>Forwarded headers"| RESTAPI
    Gateway -->|"gRPC/grpc_port<br/>Plaintext<br/>No Auth"| GRPCServer

    %% Optional mTLS path
    Client -.->|"mTLS<br/>Client Cert"| Nginx
    Nginx -.->|"HTTP/loopback<br/>Plaintext"| RESTAPI

    %% Platform interactions
    KServe -->|"Creates Pod<br/>via ServingRuntime"| AppPod
    Prometheus -->|"HTTP/rest_port<br/>Scrapes /metrics<br/>No Auth"| Metrics

    %% Egress flows
    RESTAPI -->|"HTTPS/443<br/>TLS (system CA)<br/>Cloud Credentials"| S3
    RESTAPI -->|"HTTPS/443<br/>TLS (system CA)<br/>Cloud Credentials"| GCS
    RESTAPI -->|"HTTPS/443<br/>TLS (system CA)<br/>Cloud Credentials"| AzureBlob
    RESTAPI -->|"HTTPS/443<br/>TLS (system CA)<br/>Bearer HF_TOKEN"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef sidecar fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class Gateway ingress
    class RESTAPI,GRPCServer,Metrics,HealthProbes application
    class Nginx sidecar
    class S3,GCS,AzureBlob,HFHub externalservice
    class KServe,Prometheus platform
