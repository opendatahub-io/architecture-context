graph TB
    subgraph PlatformOperator["Platform Operator"]
        RhodsOp["rhods-operator /<br/>opendatahub-operator"]
    end

    subgraph TrainerOperator["Trainer Operator (trainer-operator-system)"]
        Controller["trainer-operator<br/>Go Operator<br/>(controller-runtime)"]
        Controller -->|renders| Manifests["Kustomize Manifest<br/>Rendering Pipeline"]
        Manifests -->|templates from| Templates["/opt/manifests-template/<br/>/opt/runtimes-template/<br/>/opt/imagestreams-template/"]
    end

    subgraph DeployedComponents["Deployed Components (managed)"]
        TrainerCtrl["kubeflow-trainer-<br/>controller-manager<br/>(Deployment)"]
        Webhook["Validating Webhook<br/>9443/TCP HTTPS"]
        TrainerCtrl -->|validates via| Webhook
        Runtimes["ClusterTrainingRuntimes<br/>(torch-distributed,<br/>training-hub, deepspeed, etc.)"]
        ImageStreams["OpenShift ImageStreams<br/>(training-hub-universal:<br/>CUDA, ROCm, CPU)"]
        PodMon["PodMonitor<br/>(monitoring.coreos.com)"]
        RBAC_Roles["RBAC Aggregation Roles<br/>(training-edit,<br/>training-admin,<br/>training-view)"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        TrainerCR["Trainer CR<br/>components.platform.opendatahub.io/v1alpha1<br/>(cluster-scoped, singleton)"]
        TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1<br/>(namespaced)"]
        ClusterRuntimeCR["ClusterTrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1<br/>(cluster-scoped)"]
        TrainingRuntimeCR["TrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1<br/>(namespaced)"]
    end

    %% Platform operator creates Trainer CR
    RhodsOp -->|creates| TrainerCR
    TrainerCR -->|watched by| Controller

    %% Operator deploys components
    Controller -->|deploys| TrainerCtrl
    Controller -->|creates| Runtimes
    Controller -->|creates| ImageStreams
    Controller -->|creates| PodMon
    Controller -->|creates| RBAC_Roles
    Controller -->|deploys| Webhook

    %% Kubeflow Trainer controller watches CRDs
    TrainerCtrl -->|reconciles| TrainJobCR
    TrainerCtrl -->|reads| ClusterRuntimeCR
    TrainerCtrl -->|reads| TrainingRuntimeCR

    %% User interaction
    User["Data Scientist / User"] -->|creates| TrainJobCR

    %% External dependencies
    Controller -->|dependency check| JobSetOp["JobSet Operator<br/>(OLM)"]
    TrainerCtrl -->|creates| JobSet["JobSet<br/>(jobset.x-k8s.io)"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style TrainerCtrl fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style TrainerCR fill:#f5a623,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style ClusterRuntimeCR fill:#f5a623,stroke:#333
    style TrainingRuntimeCR fill:#f5a623,stroke:#333
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style JobSetOp fill:#999,stroke:#333,color:#fff
    style JobSet fill:#999,stroke:#333,color:#fff
    style User fill:#e8e8e8,stroke:#333
    style Runtimes fill:#d5e8d4,stroke:#82b366
    style ImageStreams fill:#d5e8d4,stroke:#82b366
    style PodMon fill:#d5e8d4,stroke:#82b366
    style RBAC_Roles fill:#d5e8d4,stroke:#82b366
