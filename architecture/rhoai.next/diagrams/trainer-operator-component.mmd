graph TB
    subgraph TrainerOperator["Trainer Operator"]
        Controller["trainer-operator<br/>(Go Operator / controller-runtime)"]
    end

    subgraph DeployedControlPlane["Deployed Kubeflow Trainer v2 Control Plane"]
        KFController["kubeflow-trainer-controller-manager<br/>(Deployment)"]
        MutatingWH["Mutating Webhook<br/>(TrainJob defaults)"]
        ValidatingWH["Validating Webhooks<br/>(TrainJob, Runtimes)"]
        KFController --- MutatingWH
        KFController --- ValidatingWH
    end

    Admin[Platform Admin] -->|creates| TrainerCR["Trainer CR<br/>(default-trainer)<br/>components.platform.opendatahub.io/v1alpha1"]
    TrainerCR -->|watched by| Controller

    Controller -->|"SSA deploy (kustomize)"| KFController
    Controller -->|deploys CRDs| TrainJobCRD["TrainJob CRD"]
    Controller -->|deploys CRDs| TrainingRuntimeCRD["TrainingRuntime CRD"]
    Controller -->|deploys CRDs| ClusterTrainingRuntimeCRD["ClusterTrainingRuntime CRD"]
    Controller -->|deploys CRDs| OptimizationJobCRD["OptimizationJob CRD"]
    Controller -->|deploys| Runtimes["ClusterTrainingRuntimes<br/>(torch, deepspeed, jax, etc.)"]
    Controller -->|deploys| ImageStreams["OpenShift ImageStreams<br/>(CPU, CUDA, ROCm)"]

    User[Data Scientist] -->|creates| TrainJob["TrainJob CR"]
    TrainJob -->|admission| MutatingWH
    TrainJob -->|admission| ValidatingWH
    TrainJob -->|reconciled by| KFController
    KFController -->|creates| JobSets["JobSet Resources"]

    Controller -->|checks dependency| JobSetOp["JobSet Operator"]
    Controller -->|uses framework| ODHUtils["odh-platform-utilities"]
    Controller -->|creates| ServiceMonitor["ServiceMonitor"]
    Controller -->|reads TLS profile| APIServer["OpenShift APIServer"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style KFController fill:#4a90e2,stroke:#333,color:#fff
    style MutatingWH fill:#4a90e2,stroke:#333,color:#fff
    style ValidatingWH fill:#4a90e2,stroke:#333,color:#fff
    style TrainerCR fill:#f5a623,stroke:#333
    style TrainJob fill:#f5a623,stroke:#333
    style TrainJobCRD fill:#f5a623,stroke:#333
    style TrainingRuntimeCRD fill:#f5a623,stroke:#333
    style ClusterTrainingRuntimeCRD fill:#f5a623,stroke:#333
    style OptimizationJobCRD fill:#f5a623,stroke:#333
    style Runtimes fill:#f5a623,stroke:#333
    style JobSetOp fill:#e8e8e8,stroke:#333
    style ODHUtils fill:#7ed321,stroke:#333
    style ServiceMonitor fill:#7ed321,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style ImageStreams fill:#f5a623,stroke:#333
    style JobSets fill:#e8e8e8,stroke:#333
