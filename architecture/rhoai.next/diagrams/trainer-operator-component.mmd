graph TB
    subgraph Platform["RHOAI Platform Layer"]
        PlatformOp["RHOAI Platform Operator<br/>(rhods-operator)"]
        TrainerCR["Trainer CR<br/>(default-trainer)<br/>components.platform.opendatahub.io/v1alpha1"]
    end

    subgraph TrainerOperator["Trainer Operator (trainer-operator-system)"]
        Controller["trainer-operator<br/>Go Operator<br/>(controller-runtime)"]
        ManifestRenderer["Manifest Renderer<br/>(kustomize via odh-platform-utilities)"]
        DepChecker["Dependency Checker<br/>(JobSet, OLM)"]
        Controller --> ManifestRenderer
        Controller --> DepChecker
    end

    subgraph Operand["Kubeflow Trainer V2 (opendatahub namespace)"]
        TrainerCtrl["kubeflow-trainer-controller-manager<br/>Upstream Go Controller"]
        Webhook["Validating Webhook<br/>443/TCP → 9443/TCP"]
        TrainerCtrl -->|registers| Webhook
    end

    subgraph UserCRDs["User-Facing CRDs"]
        TrainJob["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1<br/>(Namespaced)"]
        ClusterRuntime["ClusterTrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1<br/>(Cluster)"]
        NSRuntime["TrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1<br/>(Namespaced)"]
    end

    subgraph ManagedResources["Managed Resources"]
        CRDs["Kubeflow CRDs<br/>(TrainJob, ClusterTrainingRuntime,<br/>TrainingRuntime)"]
        Runtimes["ClusterTrainingRuntimes<br/>(torch-distributed CUDA/ROCm/CPU,<br/>training-hub variants)"]
        ImageStreams["OpenShift ImageStreams<br/>(Training Hub workbench images<br/>CPU, CUDA, ROCm)"]
    end

    %% Flows
    PlatformOp -->|creates| TrainerCR
    TrainerCR -->|watched by| Controller
    ManifestRenderer -->|deploys| TrainerCtrl
    ManifestRenderer -->|creates| CRDs
    ManifestRenderer -->|creates| Runtimes
    ManifestRenderer -->|"creates (OpenShift only)"| ImageStreams

    User["Data Scientist / User"] -->|creates| TrainJob
    TrainJob -->|validated by| Webhook
    TrainJob -->|reconciled by| TrainerCtrl
    TrainerCtrl -->|resolves runtime| ClusterRuntime
    TrainerCtrl -->|creates| JobSet["JobSet<br/>(jobset.x-k8s.io)"]

    DepChecker -->|checks| JobSetOp["JobSet Operator"]

    Controller -->|"reads platformVersion"| ConfigMap["odh-trainer-config<br/>ConfigMap"]
    Controller -->|"updates status"| TrainerCR

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ManifestRenderer fill:#4a90e2,stroke:#333,color:#fff
    style DepChecker fill:#4a90e2,stroke:#333,color:#fff
    style TrainerCtrl fill:#50a0d0,stroke:#333,color:#fff
    style Webhook fill:#50a0d0,stroke:#333,color:#fff
    style TrainerCR fill:#f5a623,stroke:#333
    style TrainJob fill:#f5a623,stroke:#333
    style ClusterRuntime fill:#f5a623,stroke:#333
    style NSRuntime fill:#f5a623,stroke:#333
    style CRDs fill:#7ed321,stroke:#333
    style Runtimes fill:#7ed321,stroke:#333
    style ImageStreams fill:#7ed321,stroke:#333
    style JobSet fill:#e8e8e8,stroke:#333
    style JobSetOp fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#9b59b6,stroke:#333,color:#fff
    style ConfigMap fill:#e8e8e8,stroke:#333
