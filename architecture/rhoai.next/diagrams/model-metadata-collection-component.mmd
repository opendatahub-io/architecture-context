graph TB
    subgraph "model-metadata-collection"
        direction TB
        subgraph "CLI Tools (Build-Time Only)"
            Extractor["model-extractor<br/>Go CLI<br/>Main pipeline"]
            Reporter["metadata-report<br/>Go CLI<br/>Completeness reports"]
        end

        subgraph "Output Artifacts"
            ModelsCatalog["data/models-catalog.yaml"]
            ValidatedCatalog["data/validated-models-catalog.yaml"]
            MCPCatalog["data/*-mcp-servers-catalog.yaml"]
            AgentsCatalog["data/redhat-agents-catalog.yaml"]
            EnrichmentYAML["data/enrichment.yaml<br/>(provenance sidecar)"]
        end

        subgraph "Data Container (Runtime)"
            DataImage["UBI9-minimal Container<br/>sleep infinity<br/>Volume: /app/data"]
        end
    end

    subgraph "Data Sources"
        ModelsIndex["data/models-index.yaml<br/>(model list)"]
        MCPInput["input/mcp_servers/*.yaml<br/>(curated entries)"]
        SupplementalCatalog["supplemental-catalog.yaml<br/>(manual overrides)"]
        VLLMConfigs["vLLM config files<br/>(recommended configs)"]
    end

    subgraph "External APIs"
        HF["HuggingFace API<br/>huggingface.co:443"]
        GitHub["GitHub API<br/>api.github.com:443"]
        OCIRegistry["OCI Registry<br/>registry.redhat.io:443"]
        OCIOther["OCI Registries (other)<br/>443/TCP"]
    end

    subgraph "Consumer"
        Dashboard["RHOAI Dashboard<br/>(volume mount)"]
    end

    %% Data source inputs
    ModelsIndex -->|input| Extractor
    MCPInput -->|input| Extractor
    SupplementalCatalog -->|merge| Extractor
    VLLMConfigs -->|append| Extractor

    %% External API calls (build-time)
    HF -->|model details, tags,<br/>READMEs, collections| Extractor
    GitHub -->|agent.yaml,<br/>README.md| Extractor
    OCIRegistry -->|modelcar manifests,<br/>layers, config blobs| Extractor
    OCIOther -->|architectures,<br/>timestamps| Extractor

    %% Output generation
    Extractor -->|generates| ModelsCatalog
    Extractor -->|generates| ValidatedCatalog
    Extractor -->|generates| MCPCatalog
    Extractor -->|generates| AgentsCatalog
    Extractor -->|generates| EnrichmentYAML

    %% Report
    ModelsCatalog -->|reads| Reporter
    EnrichmentYAML -->|reads| Reporter

    %% Container packaging
    ModelsCatalog -->|copied into| DataImage
    ValidatedCatalog -->|copied into| DataImage
    MCPCatalog -->|copied into| DataImage
    AgentsCatalog -->|copied into| DataImage

    %% Consumer
    DataImage -->|volume mount<br/>/app/data| Dashboard

    %% Styling
    style Extractor fill:#4a90e2,stroke:#333,color:#fff
    style Reporter fill:#4a90e2,stroke:#333,color:#fff
    style DataImage fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#9b59b6,stroke:#333,color:#fff
    style HF fill:#f5a623,stroke:#333
    style GitHub fill:#f5a623,stroke:#333
    style OCIRegistry fill:#f5a623,stroke:#333
    style OCIOther fill:#f5a623,stroke:#333
    style ModelsCatalog fill:#e8e8e8,stroke:#333
    style ValidatedCatalog fill:#e8e8e8,stroke:#333
    style MCPCatalog fill:#e8e8e8,stroke:#333
    style AgentsCatalog fill:#e8e8e8,stroke:#333
    style EnrichmentYAML fill:#e8e8e8,stroke:#333
