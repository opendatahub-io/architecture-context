graph TB
    subgraph "model-metadata-collection"
        subgraph "CLI Tools (CI/CD time)"
            Extractor["model-extractor<br/>(Go CLI)"]
            Reporter["metadata-report<br/>(Go CLI)"]
        end

        subgraph "Data Container (Runtime)"
            Container["odh-model-metadata-collection<br/>(UBI9-minimal)"]
            ModelsCatalog["models-catalog.yaml"]
            MCPCatalog["mcp-servers-catalog.yaml"]
            AgentsCatalog["agents-catalog.yaml"]
            Benchmarks["benchmark data"]
            Container --- ModelsCatalog
            Container --- MCPCatalog
            Container --- AgentsCatalog
            Container --- Benchmarks
        end

        Extractor -->|"generates"| ModelsCatalog
        Extractor -->|"generates"| MCPCatalog
        Extractor -->|"generates"| AgentsCatalog
        Reporter -->|"reads"| ModelsCatalog
    end

    subgraph "External Data Sources"
        Registry["OCI Registries<br/>(registry.redhat.io, quay.io)"]
        HF["HuggingFace API<br/>(huggingface.co)"]
        GH["GitHub API<br/>(api.github.com)"]
        Modelcars["Red Hat AI Modelcars<br/>(OCI images)"]
    end

    subgraph "Platform Consumers"
        Dashboard["RHOAI Dashboard"]
        Konflux["Konflux CI/CD"]
    end

    Extractor -->|"HTTPS/443<br/>OCI manifests & modelcards"| Registry
    Extractor -->|"HTTPS/443<br/>model details & collections"| HF
    Extractor -->|"HTTPS/443<br/>agent.yaml & READMEs"| GH
    Extractor -->|"HTTPS/443<br/>modelcard layers"| Modelcars

    Konflux -->|"builds image"| Container
    Dashboard -->|"volume mount<br/>(init container)"| Container

