graph TB
    subgraph BuildTime["Build-Time Pipeline (CI/CD)"]
        direction TB
        Extractor["model-extractor<br/>Go CLI"]
        Report["metadata-report<br/>Go CLI"]
        SRCatalog["serving-runtime-catalog<br/>Go CLI"]

        Extractor -->|"generates catalogs"| YAMLFiles["YAML Catalog Files"]
        Extractor -->|"quality check"| Report
        SRCatalog -->|"generates"| SRFiles["Serving Runtime Catalog"]
    end

    subgraph ExternalSources["External Data Sources"]
        HF["HuggingFace API<br/>huggingface.co"]
        Registry["Container Registry<br/>registry.redhat.io"]
        GitHub["GitHub API<br/>raw.githubusercontent.com"]
    end

    subgraph DataContainer["Data Container (Runtime)"]
        direction TB
        AppData["/app/data/<br/>YAML Catalogs"]
        Benchmarks["/app/benchmarks/<br/>Sample Data"]
        Sleep["CMD: sleep infinity<br/>UID 1001"]
    end

    subgraph Consumers["Platform Consumers (Runtime)"]
        Dashboard["RHOAI Dashboard"]
        ModelController["odh-model-controller"]
    end

    HF -->|"HTTPS/443<br/>Bearer HF_TOKEN"| Extractor
    Registry -->|"HTTPS/443<br/>Docker auth"| Extractor
    GitHub -->|"HTTPS/443<br/>Bearer GITHUB_TOKEN"| Extractor

    YAMLFiles -->|"COPY in Dockerfile"| AppData
    SRFiles -->|"COPY in Dockerfile"| AppData

    AppData -->|"volume mount"| Dashboard
    AppData -->|"volume mount"| ModelController

