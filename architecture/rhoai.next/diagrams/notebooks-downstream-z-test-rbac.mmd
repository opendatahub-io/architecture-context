graph TD
    subgraph WorkbenchPod["Workbench Pod (Per-User)"]
        SA["ServiceAccount<br/>(managed by Notebook Controller)"]
    end

    subgraph AuthEnforcement["Authentication Enforcement"]
        OAuthProxy["OAuth Proxy Sidecar<br/>(injected by Notebook Controller)"]
    end

    subgraph PlatformRBAC["Platform-Managed RBAC"]
        NC["ODH Notebook Controller"]
        OShiftOAuth["OpenShift OAuth"]
    end

    subgraph UserAccess["User Access Control"]
        UserIdentity["User Identity<br/>(OpenShift OAuth)"]
        PerUserNS["Per-User Namespace"]
        PVC["Per-User PVC<br/>(data isolation)"]
    end

    NC -->|"injects"| OAuthProxy
    NC -->|"creates & manages"| SA
    NC -->|"provisions"| PVC
    OShiftOAuth -->|"validates token"| OAuthProxy
    UserIdentity -->|"authenticates via"| OShiftOAuth
    OAuthProxy -->|"enforces per-user access to"| WorkbenchPod
    SA -->|"scoped to"| PerUserNS

    Note1["NOTE: This repository defines NO RBAC resources.<br/>All RBAC, authentication, and authorization<br/>are managed by the ODH Notebook Controller<br/>and the OpenShift platform."]

    style WorkbenchPod fill:#d5e8d4,stroke:#82b366
    style AuthEnforcement fill:#ffe6cc,stroke:#d79b00
    style PlatformRBAC fill:#dae8fc,stroke:#6c8ebf
    style UserAccess fill:#fff2cc,stroke:#d6b656
    style Note1 fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
