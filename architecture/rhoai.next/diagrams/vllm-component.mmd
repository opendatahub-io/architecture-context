graph TB
    subgraph "vLLM CUDA Container"
        direction TB
        TGISAdapter["vllm_tgis_adapter<br/>(Entrypoint)"]
        VLLMEngine["vLLM Engine<br/>(Inherited from RHAIIS)"]
        CUDARuntime["CUDA Runtime<br/>(Inherited from RHAIIS)"]

        TGISAdapter -->|bridges TGIS protocol| VLLMEngine
        VLLMEngine -->|GPU compute| CUDARuntime
    end

    subgraph "APIs Exposed"
        HTTPApi["OpenAI-Compatible HTTP API<br/>Port 8000/TCP"]
        GRPCApi["TGIS gRPC API<br/>Port 8033/TCP"]
        MetricsEndpoint["/metrics<br/>Prometheus Scrape<br/>Port 8000/TCP"]
    end

    TGISAdapter --> HTTPApi
    TGISAdapter --> GRPCApi
    VLLMEngine --> MetricsEndpoint

    subgraph "KServe Serving Infrastructure"
        ServingRuntime["ServingRuntime CR"]
        InferenceService["InferenceService CR"]
        KubeRBACProxy["kube-rbac-proxy Sidecar<br/>Port 8443/TCP HTTPS"]
    end

    Client["Client"] -->|HTTPS/8443| KubeRBACProxy
    KubeRBACProxy -->|HTTP/8000| HTTPApi
    KubeRBACProxy -->|gRPC/8033| GRPCApi

    ServingRuntime -->|references image| TGISAdapter
    InferenceService -->|triggers pod creation| ServingRuntime

    subgraph "Model Storage"
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS"]
    end

    VLLMEngine -->|download weights| HuggingFace
    VLLMEngine -->|download weights| S3

    GPU["NVIDIA GPU<br/>(Device Plugin)"] --- CUDARuntime
    Prometheus["Prometheus"] -->|scrape /metrics| MetricsEndpoint

    subgraph "Base Image Supply Chain"
        RHAIISBase["RHAIIS vllm-cuda-rhel9:3.2.2<br/>(registry.redhat.io)"]
        KonfluxPipeline["Konflux Build Pipeline<br/>(Tekton)"]
    end

    RHAIISBase -->|base image| TGISAdapter
    KonfluxPipeline -->|builds| TGISAdapter

    style TGISAdapter fill:#4a90e2,stroke:#333,color:#fff
    style VLLMEngine fill:#4a90e2,stroke:#333,color:#fff
    style CUDARuntime fill:#4a90e2,stroke:#333,color:#fff
    style HTTPApi fill:#7ed321,stroke:#333,color:#fff
    style GRPCApi fill:#7ed321,stroke:#333,color:#fff
    style MetricsEndpoint fill:#7ed321,stroke:#333,color:#fff
    style KubeRBACProxy fill:#f5a623,stroke:#333,color:#fff
    style ServingRuntime fill:#f5a623,stroke:#333,color:#fff
    style InferenceService fill:#f5a623,stroke:#333,color:#fff
    style HuggingFace fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style GPU fill:#9b59b6,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style RHAIISBase fill:#d35400,stroke:#333,color:#fff
    style KonfluxPipeline fill:#d35400,stroke:#333,color:#fff
