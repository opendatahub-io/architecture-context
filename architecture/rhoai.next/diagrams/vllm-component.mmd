graph TB
    subgraph External["External Clients"]
        Client[Client / Application]
    end

    subgraph ServingInfra["RHOAI Serving Infrastructure"]
        Gateway["Gateway API<br/>(Envoy)"]
        KubeRBAC["kube-rbac-proxy<br/>Sidecar<br/>8443/TCP TLS"]
    end

    subgraph VLLMPod["vLLM Serving Pod (UID 2000)"]
        subgraph VLLMContainer["vllm-cuda Container"]
            TGISAdapter["vllm_tgis_adapter<br/>Entrypoint Module"]
            VLLMEngine["vLLM Inference Engine<br/>(from RHAIIS base)"]
            OpenAIAPI["OpenAI-Compatible<br/>HTTP Server<br/>Port 8000/TCP"]
            TGISGRPC["TGIS gRPC Server<br/>Port 8033/TCP"]

            TGISAdapter -->|launches| OpenAIAPI
            TGISAdapter -->|launches| TGISGRPC
            OpenAIAPI -->|inference| VLLMEngine
            TGISGRPC -->|inference| VLLMEngine
        end
    end

    subgraph GPU["NVIDIA GPU"]
        CUDARuntime["CUDA Runtime<br/>(cuDNN, cuBLAS, NCCL)"]
    end

    subgraph ModelStorage["Model Storage"]
        S3["S3 Storage<br/>443/TCP HTTPS"]
        PVC["Persistent Volume<br/>Filesystem"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS"]
    end

    subgraph Platform["RHOAI Platform"]
        KServe["KServe Controller"]
        InferenceServiceCR["InferenceService CR"]
    end

    Client -->|HTTPS/443| Gateway
    Gateway -->|TLS/8443| KubeRBAC
    KubeRBAC -->|HTTP/8000| OpenAIAPI
    KubeRBAC -->|gRPC/8033| TGISGRPC

    VLLMEngine -->|CUDA calls| CUDARuntime

    VLLMEngine -->|model loading| S3
    VLLMEngine -->|model loading| PVC
    VLLMEngine -->|model loading| HFHub

    KServe -->|deploys| VLLMPod
    InferenceServiceCR -->|watched by| KServe

    style TGISAdapter fill:#4a90e2,stroke:#333
    style VLLMEngine fill:#4a90e2,stroke:#333
    style OpenAIAPI fill:#4a90e2,stroke:#333
    style TGISGRPC fill:#4a90e2,stroke:#333
    style KubeRBAC fill:#f5a623,stroke:#333
    style Gateway fill:#f5a623,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style InferenceServiceCR fill:#f5a623,stroke:#333
    style CUDARuntime fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style PVC fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
