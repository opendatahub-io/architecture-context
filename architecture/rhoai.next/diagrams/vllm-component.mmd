graph TB
    subgraph "vllm-cuda Container"
        direction TB
        Adapter["vllm_tgis_adapter<br/>(Python Module)"]
        VLLMEngine["vLLM Inference Engine<br/>(inherited from base image)"]
        CUDARuntime["CUDA Runtime<br/>(GPU acceleration)"]

        Adapter -->|"bridges API protocols"| VLLMEngine
        VLLMEngine -->|"CUDA calls"| CUDARuntime
    end

    subgraph "Build System"
        Dockerfile["Dockerfile.konflux.cuda"]
        Tekton["Tekton Pipeline<br/>(.tekton/)"]
        BaseImage["RHAIIS Base Image<br/>vllm-cuda-rhel9:3.2.2"]

        Dockerfile -->|"FROM"| BaseImage
        Tekton -->|"builds"| Dockerfile
    end

    Client["Client / API Gateway"] -->|"POST /v1/completions<br/>HTTP :8000"| Adapter
    KServeRouter["KServe Router /<br/>Model Mesh"] -->|"GenerationService<br/>gRPC :8033"| Adapter

    VLLMEngine -->|"model weights"| ModelStorage["Model Storage<br/>(S3 / PVC)"]

    KServe["KServe Controller"] -->|"deploys as<br/>InferenceService runtime"| Adapter
    ModelServing["ODH Model Controller"] -->|"orchestrates lifecycle"| KServe

    Istio["Istio Service Mesh"] -->|"mTLS sidecar"| Adapter
    GPU["NVIDIA GPU<br/>(device plugin)"] -->|"GPU resources"| CUDARuntime

    style Adapter fill:#4a90e2,stroke:#333,color:#fff
    style VLLMEngine fill:#4a90e2,stroke:#333,color:#fff
    style CUDARuntime fill:#4a90e2,stroke:#333,color:#fff
    style Dockerfile fill:#b8d4f0,stroke:#333
    style Tekton fill:#b8d4f0,stroke:#333
    style BaseImage fill:#b8d4f0,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style KServeRouter fill:#f9f9f9,stroke:#999
    style ModelStorage fill:#f5a623,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ModelServing fill:#7ed321,stroke:#333
    style Istio fill:#999,stroke:#333,color:#fff
    style GPU fill:#999,stroke:#333,color:#fff
