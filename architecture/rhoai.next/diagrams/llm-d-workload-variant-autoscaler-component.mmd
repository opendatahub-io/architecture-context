graph TB
    subgraph WVA["Workload Variant Autoscaler (WVA)"]
        direction TB

        subgraph Controllers["Controllers (Read-Only)"]
            HPAReconciler["HPA Reconciler<br/>watches autoscaling/v2"]
            SOReconciler["ScaledObject Reconciler<br/>watches keda.sh/v1alpha1"]
            CMReconciler["ConfigMap Reconciler<br/>watches core/v1"]
            IPReconciler["InferencePool Reconciler<br/>watches inference.networking.k8s.io"]
        end

        subgraph Datastore["In-Memory Datastore"]
            DS["Datastore<br/>(VariantAutoscaling objects)"]
            Config["Thread-Safe Config<br/>(saturation, scale-to-zero,<br/>queueing-model)"]
        end

        subgraph Engines["Scaling Engines"]
            SatEngine["Saturation Engine<br/>(V1/V2/Queueing Model)"]
            SFZEngine["Scale-From-Zero Engine<br/>(100ms polling)"]
        end

        subgraph Pipeline["Optimization Pipeline"]
            Analyzers["Analyzers<br/>(V2 Token/Capacity,<br/>Queueing M/M/1/K)"]
            Optimizers["Optimizers<br/>(Cost-Aware, Greedy-by-Score)"]
            Limiters["GPU Limiters<br/>(Inventory, Quota, Composite)"]
        end

        subgraph MetricsCollection["Metrics Collection"]
            Collector["Metrics Collector"]
            PromSource["Prometheus Source"]
            PodSource["Pod Scraping Source"]
        end

        subgraph Actuation["Actuation"]
            Actuator["Actuator<br/>(emits wva_desired_replicas)"]
            DirectActuator["Direct Actuator<br/>(patches scale subresource)"]
        end

        GPUDiscovery["GPU Discovery<br/>(NVIDIA, AMD, Intel Gaudi/Xe)"]
        Coordinator["Coordinator (Experimental)<br/>(GPU rebalance plugin)"]
    end

    %% Controller flows
    HPAReconciler -->|"discovers managed<br/>workloads"| DS
    SOReconciler -->|"discovers managed<br/>workloads"| DS
    CMReconciler -->|"live-reload<br/>config"| Config
    IPReconciler -->|"model-to-pool<br/>mapping"| DS

    %% Collection flows
    Collector --> PromSource
    Collector --> PodSource
    PromSource -->|"metrics"| SatEngine
    PodSource -->|"metrics"| SatEngine

    %% Engine flows
    SatEngine --> Analyzers
    Analyzers --> Optimizers
    Optimizers --> Limiters
    Limiters -->|"scaling decision"| Actuator

    SFZEngine -->|"queue_size > 0<br/>replicas == 0"| DirectActuator

    %% GPU Discovery
    GPUDiscovery -->|"GPU capacity"| Limiters

    %% External resources
    HPA["HPA<br/>(autoscaling/v2)"]
    ScaledObject["ScaledObject<br/>(keda.sh)"]
    ConfigMaps["ConfigMaps<br/>(saturation-scaling,<br/>scale-to-zero,<br/>queueing-model)"]
    InferencePool["InferencePool CR"]

    HPA -->|"annotation:<br/>llm-d.ai/managed"| HPAReconciler
    ScaledObject -->|"annotation:<br/>llm-d.ai/managed"| SOReconciler
    ConfigMaps --> CMReconciler
    InferencePool --> IPReconciler

    %% External targets
    Prometheus["Prometheus"]
    K8sAPI["Kubernetes API<br/>(scale subresource)"]

    Actuator -->|"wva_desired_replicas<br/>metric"| Prometheus
    DirectActuator -->|"PATCH replicas"| K8sAPI

    %% Styling
    style WVA fill:#e8f4fd,stroke:#2196F3,stroke-width:2px
    style Controllers fill:#fff3e0,stroke:#FF9800
    style Engines fill:#e8f5e9,stroke:#4CAF50
    style Pipeline fill:#f3e5f5,stroke:#9C27B0
    style MetricsCollection fill:#fff8e1,stroke:#FFC107
    style Actuation fill:#fce4ec,stroke:#E91E63
    style Datastore fill:#e0f2f1,stroke:#009688

    style HPAReconciler fill:#fff3e0,stroke:#FF9800
    style SOReconciler fill:#fff3e0,stroke:#FF9800
    style CMReconciler fill:#fff3e0,stroke:#FF9800
    style IPReconciler fill:#fff3e0,stroke:#FF9800

    style SatEngine fill:#e8f5e9,stroke:#4CAF50
    style SFZEngine fill:#e8f5e9,stroke:#4CAF50

    style Actuator fill:#fce4ec,stroke:#E91E63
    style DirectActuator fill:#fce4ec,stroke:#E91E63

    style HPA fill:#f5f5f5,stroke:#9e9e9e
    style ScaledObject fill:#f5f5f5,stroke:#9e9e9e
    style ConfigMaps fill:#f5f5f5,stroke:#9e9e9e
    style InferencePool fill:#f5f5f5,stroke:#9e9e9e
    style Prometheus fill:#f5f5f5,stroke:#9e9e9e
    style K8sAPI fill:#f5f5f5,stroke:#9e9e9e

    style GPUDiscovery fill:#e3f2fd,stroke:#2196F3
    style Coordinator fill:#fafafa,stroke:#bdbdbd,stroke-dasharray: 5 5
