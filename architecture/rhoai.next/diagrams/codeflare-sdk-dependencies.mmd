graph LR
    SDK["CodeFlare SDK<br/>(Python Client Library)"]

    %% External Python Dependencies
    subgraph PythonDeps["Python Dependencies"]
        Ray["ray 2.35.0<br/>(job submission client)"]
        K8sClient["kubernetes >= 25.3.0, < 27<br/>(K8s API client)"]
        OCClient["openshift-client 1.0.18<br/>(Route API access)"]
        Crypto["cryptography 40.0.2<br/>(TLS cert generation)"]
        Pydantic["pydantic < 2<br/>(data validation)"]
        Rich["rich ^12.5<br/>(terminal formatting)"]
        IPyWidgets["ipywidgets 8.1.2<br/>(Jupyter widgets)"]
        Executing["executing 1.2.0<br/>(stack introspection)"]
    end

    SDK -->|job submission| Ray
    SDK -->|API calls| K8sClient
    SDK -->|Route access| OCClient
    SDK -->|cert gen| Crypto
    SDK -->|validation| Pydantic
    SDK -->|pretty print| Rich
    SDK -->|notebook UI| IPyWidgets
    SDK -->|error handling| Executing

    %% Internal RHOAI Platform Dependencies
    subgraph RHOAIPlatform["Internal RHOAI Platform"]
        KubeRayOp["KubeRay Operator<br/>(reconciles RayCluster CRs)"]
        CFOperator["CodeFlare Operator<br/>(manages AppWrappers)"]
        KueueCtrl["Kueue<br/>(batch scheduling)"]
        ODHTrustedCA["ODH Trusted CA Bundle<br/>(ConfigMap)"]
        ODHNotebooks["ODH Notebooks<br/>(SDK runtime environment)"]
    end

    SDK -->|creates RayCluster CR| KubeRayOp
    SDK -->|creates AppWrapper CR| CFOperator
    SDK -->|queries LocalQueue CR| KueueCtrl
    SDK -.->|mounts CA bundle| ODHTrustedCA
    ODHNotebooks -->|runs| SDK

    %% Infrastructure Dependencies
    subgraph Infrastructure["Infrastructure"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP"]
        RayDashboard["Ray Dashboard<br/>(head node, 8265/TCP)"]
        OSRoutes["OpenShift Routes<br/>(route.openshift.io/v1)"]
    end

    SDK -->|HTTPS/6443| K8sAPI
    SDK -->|HTTPS/8265 via Route| RayDashboard
    SDK -->|reads Route URLs| OSRoutes

    %% Integration Points (consumers of SDK)
    subgraph Consumers["Downstream Consumers"]
        Notebooks["RHOAI Workbench<br/>(Jupyter Notebooks)"]
        Pipelines["Data Science Pipelines<br/>(automation)"]
    end

    Notebooks -->|imports SDK| SDK
    Pipelines -.->|can use SDK| SDK

    %% Styling
    style SDK fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Ray fill:#999,stroke:#333
    style K8sClient fill:#999,stroke:#333
    style OCClient fill:#999,stroke:#333
    style Crypto fill:#999,stroke:#333
    style Pydantic fill:#999,stroke:#333
    style Rich fill:#999,stroke:#333
    style IPyWidgets fill:#999,stroke:#333
    style Executing fill:#999,stroke:#333
    style KubeRayOp fill:#7ed321,stroke:#333
    style CFOperator fill:#7ed321,stroke:#333
    style KueueCtrl fill:#7ed321,stroke:#333
    style ODHTrustedCA fill:#7ed321,stroke:#333
    style ODHNotebooks fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style RayDashboard fill:#f5a623,stroke:#333
    style OSRoutes fill:#f5a623,stroke:#333
    style Notebooks fill:#b8d4e3,stroke:#333
    style Pipelines fill:#b8d4e3,stroke:#333
