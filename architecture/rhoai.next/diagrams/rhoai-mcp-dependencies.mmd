graph LR
    MCP["RHOAI MCP Server<br/>(rhoai-mcp)"]

    %% External Dependencies (Python packages)
    subgraph ExtDeps["External Dependencies"]
        FastMCP["mcp / FastMCP<br/>>=1.0.0"]
        K8sLib["kubernetes<br/>>=28.1.0"]
        Pydantic["pydantic<br/>>=2.0.0"]
        Httpx["httpx<br/>>=0.27.0"]
        Pluggy["pluggy<br/>>=1.4.0"]
        PyJWT["PyJWT crypto<br/>>=2.12.0"]
        Starlette["starlette<br/>(transitive)"]
    end

    MCP -->|"MCP protocol framework"| FastMCP
    MCP -->|"K8s API access"| K8sLib
    MCP -->|"data validation"| Pydantic
    MCP -->|"async HTTP client"| Httpx
    MCP -->|"plugin hook system"| Pluggy
    MCP -->|"JWT/OIDC validation"| PyJWT
    FastMCP -.->|"ASGI framework"| Starlette

    %% Internal RHOAI Platform Dependencies
    subgraph InternalDeps["Internal RHOAI Platform Dependencies"]
        NotebookCtrl["Kubeflow Notebook<br/>Controller"]
        KServe["KServe<br/>Controller"]
        TrainOp["Kubeflow Training<br/>Operator v2"]
        DSPOp["Data Science Pipelines<br/>Operator"]
        ModelReg["Model Registry /<br/>Model Catalog"]
        Dashboard["RHOAI Dashboard<br/>(DSC/DSCI)"]
        AccProfile["AcceleratorProfile<br/>(dashboard.opendatahub.io)"]
        PlannerSvc["Planner<br/>Service"]
    end

    MCP -->|"Notebook CRDs"| NotebookCtrl
    MCP -->|"InferenceService CRDs"| KServe
    MCP -->|"TrainJob CRDs"| TrainOp
    MCP -->|"DSPA CRDs"| DSPOp
    MCP -->|"REST API (v1alpha3/v1alpha1)"| ModelReg
    MCP -->|"DSC status reads"| Dashboard
    MCP -->|"GPU discovery"| AccProfile
    MCP -->|"REST API (recommendations)"| PlannerSvc

    %% OpenShift Platform Dependencies
    subgraph OCPDeps["OpenShift Platform Dependencies"]
        K8sAPI["Kubernetes<br/>API Server"]
        OCPProjects["OpenShift<br/>Projects API"]
        OCPRoutes["OpenShift<br/>Routes"]
        OCPTemplates["OpenShift<br/>Templates"]
        OCPImageStreams["OpenShift<br/>ImageStreams"]
        OCPOAuth["OpenShift<br/>OAuth Server"]
    end

    MCP -->|"all K8s CRUD"| K8sAPI
    MCP -->|"project mgmt"| OCPProjects
    MCP -->|"URL discovery"| OCPRoutes
    MCP -->|"ServingRuntime templates"| OCPTemplates
    MCP -->|"notebook image listing"| OCPImageStreams
    MCP -->|"TokenReview"| OCPOAuth

    %% External Identity
    subgraph Identity["Identity"]
        OIDC["OIDC Provider"]
    end

    MCP -->|"JWKS / token validation"| OIDC

    %% Reverse dependencies (components that integrate with MCP)
    %% (none defined in the architecture doc)

