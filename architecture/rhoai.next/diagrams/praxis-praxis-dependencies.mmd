graph LR
    Praxis["Praxis Proxy<br/>v0.7.3"]

    %% Core External Dependencies
    Praxis -->|"proxy engine"| Pingora["Pingora<br/>(quixotic-plecostomus)<br/>0.10.0"]
    Praxis -->|"TLS protocol"| Rustls["rustls<br/>0.23.45<br/>(no built-in provider)"]
    Praxis -->|"crypto provider"| RustlsOpenSSL["rustls-openssl<br/>(quixotic-plecostomus)<br/>0.4.1"]
    Praxis -->|"all crypto ops"| OpenSSL["System OpenSSL<br/>(dynamic linking)"]
    Praxis -->|"async runtime"| Tokio["tokio<br/>1.53.1"]

    %% Build / Config Dependencies
    Praxis -->|"config parsing"| Serde["serde / serde_yaml<br/>1.0.229 / 0.10.7"]
    Praxis -->|"CLI"| Clap["clap<br/>4.6.7"]
    Praxis -->|"memory allocator"| Jemalloc["jemalloc<br/>0.7.0"]

    %% Observability Dependencies
    Praxis -->|"metrics"| Metrics["metrics /<br/>metrics-exporter-prometheus<br/>0.24.6 / 0.18.3"]
    Praxis -.->|"tracing (optional)"| OTel["opentelemetry<br/>0.33.0"]

    %% Optional Dependencies
    Praxis -.->|"policy engine (optional)"| PPE["ppe (praxis-policy)<br/>0.4.0"]

    %% Integration Points (consumers/peers)
    Prometheus["Prometheus"] -->|"scrapes /metrics"| Praxis
    OTLPCollector["OTLP Collector"] <-.->|"trace export"| Praxis
    Upstream["Upstream Clusters"] <-->|"proxied traffic<br/>HTTP/HTTPS/gRPC"| Praxis

    %% Cert Providers
    CertManager["cert-manager /<br/>certbot / operator"] -->|"TLS certs (PEM)"| Praxis

    %% FIPS-excluded note
    PPE -.->|"EXCLUDED in FIPS build<br/>(carries aws-lc-rs, sha2, hmac)"| FIPSNote["FIPS Build<br/>Exclusion"]

