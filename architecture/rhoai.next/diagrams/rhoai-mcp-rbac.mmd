graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["rhoai-mcp<br/>(ns: rhoai-mcp)"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB["rhoai-mcp<br/>(cluster-scoped)"]
    end

    subgraph BaseRole["ClusterRole: rhoai-mcp (Base)"]
        direction TB
        CR_Base["Base Permissions"]
    end

    subgraph OSRole["ClusterRole: rhoai-mcp (OpenShift Extension)"]
        direction TB
        CR_OS["OpenShift Permissions"]
    end

    subgraph OIDCRole["ClusterRole: rhoai-mcp (OIDC Extension)"]
        direction TB
        CR_OIDC["Impersonation Permissions"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["core<br/>pods, pods/log<br/>get, list, watch, create"]
        Services["core<br/>services, events, nodes<br/>get, list, watch"]
        Namespaces["core<br/>namespaces<br/>get, list, watch, create, patch, delete"]
        Secrets["core<br/>secrets, PVCs<br/>get, list, watch, create, delete"]
        PVs["core<br/>persistentvolumes<br/>create"]
        StorageClasses["storage.k8s.io<br/>storageclasses<br/>list"]
    end

    subgraph CRDResources["CRD Resources"]
        InferenceService["serving.kserve.io<br/>inferenceservices<br/>get, list, watch, create, delete"]
        ServingRuntime["serving.kserve.io<br/>servingruntimes<br/>get, list, watch, create"]
        Notebooks["kubeflow.org<br/>notebooks<br/>get, list, watch, create, patch, delete"]
        TrainJobs["trainer.kubeflow.org<br/>trainjobs<br/>get, list, watch, create, update, patch, delete"]
        TrainingRuntimes["trainer.kubeflow.org<br/>trainingruntimes, clustertrainingruntimes<br/>get, list, watch (+ create, delete for cluster)"]
        DSPAs["datasciencepipelinesapplications...<br/>datasciencepipelinesapplications<br/>get, list, watch, create, delete"]
    end

    subgraph OSResources["OpenShift Resources"]
        DSClusters["datasciencecluster...<br/>datascienceclusters<br/>get, list, watch"]
        ModelRegistries["components.platform...<br/>modelregistries<br/>get, list, watch"]
        Templates["template.openshift.io<br/>templates<br/>get, list, watch"]
        Routes["route.openshift.io<br/>routes<br/>get, list, watch"]
        Projects["project.openshift.io<br/>projects<br/>get, list, watch, patch"]
        ImageStreams["image.openshift.io<br/>imagestreams<br/>list"]
    end

    subgraph OIDCResources["OIDC Resources"]
        Impersonate["core<br/>users, groups, serviceaccounts<br/>impersonate"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SARs["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        OCPUsers["user.openshift.io<br/>users<br/>get"]
    end

    %% Bindings
    SA -->|bound via| CRB
    CRB -->|grants| CR_Base
    CRB -->|grants| CR_OS
    CRB -->|grants (OIDC mode)| CR_OIDC

    %% Base permissions
    CR_Base --> Pods
    CR_Base --> Services
    CR_Base --> Namespaces
    CR_Base --> Secrets
    CR_Base --> PVs
    CR_Base --> StorageClasses
    CR_Base --> InferenceService
    CR_Base --> ServingRuntime
    CR_Base --> Notebooks
    CR_Base --> TrainJobs
    CR_Base --> TrainingRuntimes
    CR_Base --> DSPAs

    %% OpenShift permissions
    CR_OS --> DSClusters
    CR_OS --> ModelRegistries
    CR_OS --> Templates
    CR_OS --> Routes
    CR_OS --> Projects
    CR_OS --> ImageStreams

    %% OIDC permissions
    CR_OIDC --> Impersonate
    CR_OIDC --> TokenReviews
    CR_OIDC --> SARs
    CR_OIDC --> OCPUsers

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CRB fill:#e8e8e8,stroke:#333
    style CR_Base fill:#f5a623,color:#333
    style CR_OS fill:#f5a623,color:#333
    style CR_OIDC fill:#f5a623,color:#333

    style Pods fill:#7ed321,color:#333
    style Services fill:#7ed321,color:#333
    style Namespaces fill:#7ed321,color:#333
    style Secrets fill:#7ed321,color:#333
    style PVs fill:#7ed321,color:#333
    style StorageClasses fill:#7ed321,color:#333

    style InferenceService fill:#7ed321,color:#333
    style ServingRuntime fill:#7ed321,color:#333
    style Notebooks fill:#7ed321,color:#333
    style TrainJobs fill:#7ed321,color:#333
    style TrainingRuntimes fill:#7ed321,color:#333
    style DSPAs fill:#7ed321,color:#333

    style DSClusters fill:#a8d08d,color:#333
    style ModelRegistries fill:#a8d08d,color:#333
    style Templates fill:#a8d08d,color:#333
    style Routes fill:#a8d08d,color:#333
    style Projects fill:#a8d08d,color:#333
    style ImageStreams fill:#a8d08d,color:#333

    style Impersonate fill:#ffcccc,color:#333
    style TokenReviews fill:#ffcccc,color:#333
    style SARs fill:#ffcccc,color:#333
    style OCPUsers fill:#ffcccc,color:#333
