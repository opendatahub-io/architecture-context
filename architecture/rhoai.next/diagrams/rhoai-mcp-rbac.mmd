graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["rhoai-mcp<br/>Namespace: rhoai-mcp"]
    end

    subgraph Bindings["ClusterRoleBinding"]
        CRB["rhoai-mcp<br/>(cluster-scoped)"]
    end

    subgraph BaseRole["ClusterRole: rhoai-mcp (base)"]
        direction TB
        subgraph CoreResources["Core API Resources"]
            Pods["pods, pods/log<br/>get, list, watch"]
            PodsCreate["pods<br/>create"]
            Services["services<br/>get, list, watch"]
            Events["events<br/>get, list, watch"]
            Nodes["nodes<br/>get, list"]
            Namespaces["namespaces<br/>get, list, create, delete, patch"]
            Secrets["secrets<br/>get, list, create, delete"]
            PVCs["persistentvolumeclaims<br/>get, list, create, delete"]
            PVs["persistentvolumes<br/>create"]
        end

        subgraph KubeflowResources["Kubeflow Resources"]
            Notebooks["kubeflow.org<br/>notebooks<br/>get, list, watch, create, patch, delete"]
            TrainJobs["trainer.kubeflow.org<br/>trainjobs<br/>get, list, watch, create, patch, delete"]
            TrainingRuntimes["trainer.kubeflow.org<br/>clustertrainingruntimes,<br/>trainingruntimes<br/>get, list, watch, create, delete"]
        end

        subgraph PlatformResources["Platform Resources"]
            DSPA["datasciencepipelinesapplications<br/>.opendatahub.io<br/>datasciencepipelinesapplications<br/>get, list, create, delete"]
            InferenceServices["serving.kserve.io<br/>inferenceservices<br/>get, list, watch, create, patch, delete"]
            ServingRuntimes["serving.kserve.io<br/>servingruntimes<br/>get, list, watch, create"]
            StorageClasses["storage.k8s.io<br/>storageclasses<br/>list"]
        end
    end

    subgraph OCPRole["ClusterRole: rhoai-mcp (OpenShift)"]
        direction TB
        DSC["datasciencecluster.opendatahub.io<br/>datascienceclusters<br/>get, list"]
        ModelRegistries["components.platform.opendatahub.io<br/>modelregistries<br/>get, list"]
        Templates["template.openshift.io<br/>templates<br/>get, list"]
        Routes["route.openshift.io<br/>routes<br/>get, list"]
        Projects["project.openshift.io<br/>projects<br/>get, list, patch"]
        ImageStreams["image.openshift.io<br/>imagestreams<br/>list"]
    end

    subgraph OIDCRole["ClusterRole: rhoai-mcp (OIDC)"]
        direction TB
        Impersonate["core<br/>users, groups, serviceaccounts<br/>impersonate"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        OCPUsers["user.openshift.io<br/>users<br/>get"]
    end

    %% Connections
    SA -->|"bound via"| CRB
    CRB -->|"grants"| BaseRole
    CRB -->|"grants (OpenShift overlay)"| OCPRole
    CRB -->|"grants (OIDC overlay)"| OIDCRole

