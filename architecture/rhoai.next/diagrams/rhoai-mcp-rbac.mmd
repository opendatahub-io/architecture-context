graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["rhoai-mcp<br/>NS: rhoai-mcp"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB["rhoai-mcp<br/>ClusterRoleBinding"]
    end

    subgraph BaseRole["ClusterRole: rhoai-mcp (base)"]
        CR_Base["rhoai-mcp base role"]
    end

    subgraph OSRole["ClusterRole: rhoai-mcp (openshift)"]
        CR_OS["rhoai-mcp openshift additions"]
    end

    subgraph OIDCRole["ClusterRole: rhoai-mcp (oidc overlay)"]
        CR_OIDC["rhoai-mcp oidc<br/>(replaces base)"]
    end

    subgraph BaseResources["Base API Resources"]
        Pods["core<br/>pods, pods/log<br/>get, list, watch, create"]
        Services["core<br/>services, events, nodes<br/>get, list, watch"]
        Namespaces["core<br/>namespaces<br/>get, list, watch, create, patch, delete"]
        Secrets["core<br/>secrets, PVCs<br/>get, list, watch, create, delete"]
        PVs["core<br/>persistentvolumes<br/>create"]
        Notebooks["kubeflow.org<br/>notebooks<br/>get, list, watch, create, patch, delete"]
        TrainJobs["trainer.kubeflow.org<br/>trainjobs<br/>get, list, watch, create, update, patch, delete"]
        TrainRuntimes["trainer.kubeflow.org<br/>trainingruntimes, clustertrainingruntimes<br/>get, list, watch (+ create, delete for cluster)"]
        DSPApps["datasciencepipelinesapplications<br/>datasciencepipelinesapplications<br/>get, list, watch, create, delete"]
        InferSvc["serving.kserve.io<br/>inferenceservices<br/>get, list, watch, create, delete"]
        ServingRT["serving.kserve.io<br/>servingruntimes<br/>get, list, watch, create"]
        StorageClasses["storage.k8s.io<br/>storageclasses<br/>list"]
    end

    subgraph OSResources["OpenShift API Resources"]
        DSClusters["datasciencecluster.opendatahub.io<br/>datascienceclusters<br/>get, list, watch"]
        ModelRegs["components.platform.opendatahub.io<br/>modelregistries<br/>get, list, watch"]
        Templates["template.openshift.io<br/>templates<br/>get, list, watch"]
        Routes["route.openshift.io<br/>routes<br/>get, list, watch"]
        Projects["project.openshift.io<br/>projects<br/>get, list, watch, patch"]
        ImageStreams["image.openshift.io<br/>imagestreams<br/>list"]
    end

    subgraph OIDCResources["OIDC API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        Users["user.openshift.io<br/>users<br/>get"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR_Base
    CRB -->|"grants (openshift overlay)"| CR_OS
    CRB -->|"grants (oidc overlay, replaces base)"| CR_OIDC

    %% Base role to resources
    CR_Base --> Pods
    CR_Base --> Services
    CR_Base --> Namespaces
    CR_Base --> Secrets
    CR_Base --> PVs
    CR_Base --> Notebooks
    CR_Base --> TrainJobs
    CR_Base --> TrainRuntimes
    CR_Base --> DSPApps
    CR_Base --> InferSvc
    CR_Base --> ServingRT
    CR_Base --> StorageClasses

    %% OpenShift additions
    CR_OS --> DSClusters
    CR_OS --> ModelRegs
    CR_OS --> Templates
    CR_OS --> Routes
    CR_OS --> Projects
    CR_OS --> ImageStreams

    %% OIDC overlay
    CR_OIDC --> TokenReviews
    CR_OIDC --> SAR
    CR_OIDC --> Users

