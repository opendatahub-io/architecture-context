graph LR
    FMS["fms-hf-tuning<br/>(LLM Fine-Tuning)"]

    %% Internal Platform Dependencies
    subgraph InternalPlatform["Internal Platform"]
        KFTO["Kubeflow Training<br/>Operator"]
        Kueue["Kueue"]
    end

    FMS -->|"PyTorchJob CRD<br/>consumer"| KFTO
    FMS -.->|"queue-name label"| Kueue

    %% Core Python Dependencies (Required)
    subgraph CoreDeps["Core Dependencies (Required)"]
        Transformers["transformers<br/>>=4.55.0,<=4.55.4"]
        Torch["torch<br/>>2.7.0,<2.9.0"]
        TRL["trl<br/>>=0.19.1,<0.20.0"]
        PEFT["peft<br/>>=0.18.0,<0.19.0"]
        Accelerate["accelerate<br/>>=1.9.0,<2.0.0"]
        Datasets["datasets<br/>>=4.0.0,<5.0.0"]
    end

    FMS -->|"model loading<br/>tokenization"| Transformers
    FMS -->|"deep learning<br/>CUDA, FSDP"| Torch
    FMS -->|"SFTTrainer<br/>SFTConfig"| TRL
    FMS -->|"LoRA, Prompt<br/>Tuning, adapters"| PEFT
    FMS -->|"multi-GPU launch<br/>FSDP config"| Accelerate
    FMS -->|"data loading<br/>processing"| Datasets

    %% Optional Acceleration Dependencies
    subgraph AccelDeps["Acceleration Plugins (Optional)"]
        FMSAccel["fms-acceleration<br/>>=0.6.2"]
        FlashAttn["flash-attn<br/>>=2.8.3"]
        MambaSSM["mamba-ssm<br/>>=2.0.0,<3.0.0"]
        AutoGPTQ["auto_gptq<br/>>0.4.2"]
    end

    FMS -.->|"QLoRA, fused ops<br/>padding-free, ScatterMoE"| FMSAccel
    FMS -.->|"efficient attention"| FlashAttn
    FMS -.->|"state-space models"| MambaSSM
    FMS -.->|"GPTQ quantization"| AutoGPTQ

    %% External Services
    subgraph ExternalSvcs["External Services"]
        HFHub["Hugging Face Hub<br/>huggingface.co"]
        AimStack["AimStack<br/>(optional tracker)"]
        MLflow["MLflow<br/>(optional tracker)"]
        ClearML["ClearML<br/>(optional tracker)"]
    end

    FMS -->|"model/dataset<br/>download<br/>HTTPS/443"| HFHub
    FMS -.->|"metrics<br/>HTTP"| AimStack
    FMS -.->|"metrics<br/>HTTP/HTTPS"| MLflow
    FMS -.->|"metrics<br/>HTTPS"| ClearML

    %% Downstream Consumers
    subgraph Downstream["Downstream Consumers"]
        vLLM["vLLM<br/>(inference engine)"]
    end

    FMS -.->|"produces LoRA<br/>adapters for"| vLLM

    %% Distributed Training
    subgraph Distributed["Distributed Training"]
        PyTorchFSDP["PyTorch FSDP<br/>(NCCL/Gloo)"]
    end

    FMS -->|"gradient sync<br/>29500/TCP"| PyTorchFSDP

    %% Styling
    style FMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style KFTO fill:#7ed321,stroke:#333,stroke-width:2px
    style Kueue fill:#7ed321,stroke:#333,stroke-width:2px

    style Transformers fill:#e8e8e8,stroke:#333
    style Torch fill:#e8e8e8,stroke:#333
    style TRL fill:#e8e8e8,stroke:#333
    style PEFT fill:#e8e8e8,stroke:#333
    style Accelerate fill:#e8e8e8,stroke:#333
    style Datasets fill:#e8e8e8,stroke:#333

    style FMSAccel fill:#fff2cc,stroke:#d6b656
    style FlashAttn fill:#fff2cc,stroke:#d6b656
    style MambaSSM fill:#fff2cc,stroke:#d6b656
    style AutoGPTQ fill:#fff2cc,stroke:#d6b656

    style HFHub fill:#f5a623,stroke:#333,stroke-width:2px
    style AimStack fill:#ffe6cc,stroke:#d79b00
    style MLflow fill:#ffe6cc,stroke:#d79b00
    style ClearML fill:#ffe6cc,stroke:#d79b00

    style vLLM fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style PyTorchFSDP fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
