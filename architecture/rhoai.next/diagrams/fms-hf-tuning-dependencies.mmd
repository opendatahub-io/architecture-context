graph LR
    FMS["fms-hf-tuning<br/>LLM Fine-Tuning Engine"]

    %% Core Python Dependencies (Required)
    subgraph CoreDeps["Core Dependencies (Required)"]
        Transformers["transformers<br/>>=4.55.0,<=4.55.4"]
        Torch["torch<br/>>2.7.0,<2.9.0"]
        Accelerate["accelerate<br/>>=1.9.0,<2.0.0"]
        PEFT["peft<br/>>=0.18.0,<0.19.0"]
        TRL["trl<br/>>=0.19.1,<0.20.0"]
        Datasets["datasets<br/>>=4.0.0,<5.0.0"]
        NumPy["numpy<br/>>=1.26.4,<2.2.0"]
        Safetensors["safetensors"]
        SentencePiece["sentencepiece<br/>>=0.1.99,<0.3"]
        SimpleEval["simpleeval<br/>>=0.9.13,<2.0"]
        Pillow["pillow<br/>>=12.1.1"]
        Kernels["kernels<br/><=0.9.0"]
    end

    %% Optional Dependencies
    subgraph OptionalDeps["Optional Dependencies"]
        FlashAttn["flash-attn<br/>>=2.8.3"]
        MambaSSM["mamba_ssm<br/>>=2.0.0,<3.0.0"]
        FMSAccel["fms-acceleration<br/>>=0.6.2"]
    end

    %% Optional Trackers
    subgraph Trackers["Experiment Trackers (Optional)"]
        Aim["aim<br/>>=3.19.0,<4.0"]
        MLflow["mlflow"]
        ClearML["clearml<br/>==2.0.0"]
    end

    %% Internal Platform Dependencies
    subgraph Platform["Internal RHOAI Platform"]
        KFTO["Kubeflow Training<br/>Operator (KFTO)"]
        Kueue["Kueue<br/>(optional)"]
        HFHub["HuggingFace Hub /<br/>Model Registry"]
    end

    %% Downstream Consumers
    subgraph Consumers["Downstream Consumers"]
        vLLM["vLLM<br/>(adapter artifacts)"]
    end

    %% Core dependency edges
    FMS -->|model loading, tokenizer| Transformers
    FMS -->|deep learning framework| Torch
    FMS -->|multi-GPU launcher, FSDP| Accelerate
    FMS -->|LoRA, Prompt Tuning| PEFT
    FMS -->|SFTTrainer, SFTConfig| TRL
    FMS -->|dataset loading| Datasets
    FMS -->|numerical computing| NumPy
    FMS -->|checkpoint serialization| Safetensors
    FMS -->|tokenizer support| SentencePiece
    FMS -->|rule evaluation| SimpleEval
    FMS -->|vision-language tuning| Pillow
    FMS -->|kernel library| Kernels

    %% Optional dependency edges
    FMS -.->|efficient attention| FlashAttn
    FMS -.->|state-space models| MambaSSM
    FMS -.->|quantized LoRA, fused ops,<br/>padding-free, MoE, ODM| FMSAccel

    %% Tracker edges
    FMS -.->|metrics| Aim
    FMS -.->|metrics| MLflow
    FMS -.->|metrics| ClearML

    %% Platform edges
    KFTO -->|orchestrates as<br/>PyTorchJob| FMS
    Kueue -.->|job queue<br/>scheduling| KFTO
    FMS -->|model download<br/>HTTPS/443| HFHub

    %% Consumer edges
    FMS -->|LoRA adapters<br/>safetensors| vLLM

    %% Styling
    style FMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style Transformers fill:#999,stroke:#333
    style Torch fill:#999,stroke:#333
    style Accelerate fill:#999,stroke:#333
    style PEFT fill:#999,stroke:#333
    style TRL fill:#999,stroke:#333
    style Datasets fill:#999,stroke:#333
    style NumPy fill:#999,stroke:#333
    style Safetensors fill:#999,stroke:#333
    style SentencePiece fill:#999,stroke:#333
    style SimpleEval fill:#999,stroke:#333
    style Pillow fill:#999,stroke:#333
    style Kernels fill:#999,stroke:#333

    style FlashAttn fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style MambaSSM fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style FMSAccel fill:#ccc,stroke:#333,stroke-dasharray: 5 5

    style Aim fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style MLflow fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style ClearML fill:#ccc,stroke:#333,stroke-dasharray: 5 5

    style KFTO fill:#7ed321,stroke:#333
    style Kueue fill:#7ed321,stroke:#333
    style HFHub fill:#f5a623,stroke:#333

