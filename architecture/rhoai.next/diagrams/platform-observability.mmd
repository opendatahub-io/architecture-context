graph TB
    subgraph Prometheus["Prometheus Scrape Targets (ServiceMonitor/PodMonitor)"]
        direction TB
        P1["rhods-operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
        P2["KServe controller<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P3["odh-model-controller<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P4["odh-dashboard Go BFF<br/>:8080/TCP metrics<br/>Auth: service-ca TLS"]
        P5["Kueue<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P6["codeflare-operator<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P7["model-registry-operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy sidecar"]
        P8["DS Pipelines Operator<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P9["agents-operator<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P10["data-connect-hub<br/>:8443/TCP metrics<br/>Auth: controller-runtime authn"]
        P11["All operators<br/>ServiceMonitor/PodMonitor pattern<br/>Platform label injection via webhook"]
    end

    subgraph MonitorInfra["Monitoring Infrastructure"]
        direction TB
        ODHObs["odh-observability<br/>Declarative observability stack<br/>Monitoring CR provisioning"]
        PodMonMut["PodMonitor Mutating Webhooks<br/>rhods-operator: platform labels<br/>odh-observability: additional labels"]
        PromStack["Platform Prometheus<br/>Scrapes ServiceMonitors<br/>and PodMonitors"]
    end

    subgraph HealthProbes["Health Probes (controller-runtime defaults)"]
        direction TB
        H1["All Go operators<br/>Liveness: :8081 healthz<br/>Readiness: :8081 readyz"]
        H2["odh-dashboard core<br/>Liveness: HTTP probe<br/>Readiness: HTTP probe"]
        H3["Model serving pods<br/>Liveness: runtime-specific<br/>Readiness: model-loaded check"]
        H4["kube-auth-proxy<br/>Liveness: HTTP probe<br/>Readiness: HTTP probe"]
        H5["maas-api / maas-discovery<br/>Liveness: HTTP probe<br/>Readiness: HTTP probe"]
        H6["All unauthenticated<br/>Health endpoints intentionally<br/>skip authentication"]
    end

    subgraph WebhookMetrics["Webhook Server Metrics"]
        direction TB
        W1["25 webhook servers<br/>304 total webhooks<br/>Failure policy: Fail"]
        W2["Webhook cert sources:<br/>service-ca, cert-manager<br/>Port: 9443/TCP (typical)"]
    end

    subgraph InferenceMetrics["Inference Observability"]
        direction TB
        I1["KServe model metrics<br/>Request latency, throughput<br/>Per-InferenceService"]
        I2["gateway-api-inference-extension<br/>EPP routing metrics<br/>KV-cache utilization, queue depth"]
        I3["llm-d metrics<br/>Prefill/decode latency<br/>NIXL transfer stats"]
        I4["vLLM runtime metrics<br/>Token throughput, TTFT, TPOT<br/>GPU utilization"]
        I5["llm-d-latency-predictor<br/>SLO prediction metrics<br/>Latency model accuracy"]
    end

    %% Monitoring infrastructure connections
    P11 -->|"scraped by"| PromStack
    PodMonMut -->|"injects labels into"| P11
    ODHObs -->|"provisions"| PromStack
    ODHObs -->|"deploys"| PodMonMut

    %% Inference metrics to Prometheus
    I1 -->|"ServiceMonitor"| PromStack
    I2 -->|"ServiceMonitor"| PromStack
    I4 -->|"ServiceMonitor"| PromStack

    %% Styling
    classDef prom fill:#e8d5b7,stroke:#b8860b
    classDef probe fill:#d5e8d4,stroke:#82b366
    classDef infra fill:#dae8fc,stroke:#6c8ebf
    classDef webhook fill:#e6ccff,stroke:#9673a6
    classDef inference fill:#ffe6cc,stroke:#d79b00

    class P1,P2,P3,P4,P5,P6,P7,P8,P9,P10,P11 prom
    class H1,H2,H3,H4,H5,H6 probe
    class ODHObs,PodMonMut,PromStack infra
    class W1,W2 webhook
    class I1,I2,I3,I4,I5 inference
