graph TB
    subgraph ObsStack["Observability Stack (redhat-ods-monitoring)"]
        direction TB

        subgraph PromScrape["Prometheus Scrape Targets (26+ components)"]
            direction TB
            P1["KServe Controller<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P2["llmisvc-controller<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P3["odh-dashboard<br/>:8080/TCP metrics<br/>Auth: varies by module"]
            P4["odh-model-controller<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P5["DS Pipelines Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P6["Model Registry Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P7["TrustyAI Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P8["Kubeflow Notebook Controller<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P9["Kueue Controller<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P10["KubeRay Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P11["Spark Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P12["Training Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P13["CodeFlare Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P14["AI Gateway Operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P15["workbenches-operator<br/>:8443/TCP metrics<br/>Auth: kube-rbac-proxy"]
            P16["InferenceService pods<br/>:8080/TCP metrics<br/>Auth: varies"]
            P17["vLLM runtime pods<br/>:8000/TCP metrics<br/>Auth: none (pod-level)"]
            P18["llm-d Router (EPP)<br/>:9090/TCP metrics<br/>Auth: none (pod-level)"]
        end

        subgraph MetricsInfra["Metrics Infrastructure"]
            MonStack["MonitoringStack CR<br/>(Prometheus Operator)<br/>Conditional: requires CRD"]
            PromProxy["prom-label-proxy<br/>Multi-tenant isolation<br/>Namespace-scoped queries"]
            ThanosQ["Thanos Querier<br/>Federated metrics<br/>Cross-namespace view"]
        end
    end

    subgraph TracingStack["Distributed Tracing"]
        direction TB
        T1["KServe<br/>OTLP/gRPC traces"]
        T2["DS Pipelines<br/>OTLP/gRPC traces"]
        T3["llm-d components<br/>OTLP/gRPC traces"]
        T4["vLLM runtime<br/>OTLP/gRPC traces"]
        Collector["OpenTelemetry Collector<br/>Telemetry aggregation<br/>Conditional: requires CRD"]
        TempoSvc["Tempo<br/>Trace storage + query<br/>Conditional: requires CRD"]
    end

    subgraph Dashboarding["Dashboarding"]
        Perses["Perses<br/>Platform dashboards<br/>Conditional: requires CRD"]
        MetricsDash["MetricsDashboard CRs<br/>Created by odh-model-controller<br/>Per-InferenceService dashboards"]
    end

    subgraph HealthProbes["Health Probes (per component)"]
        direction TB
        H1["rhods-operator<br/>L: healthz<br/>R: readyz"]
        H2["KServe Controller<br/>L: :8081 healthz<br/>R: :8081 readyz"]
        H3["odh-dashboard<br/>L: :8080 healthz<br/>R: :8080 readyz"]
        H4["Model Registry<br/>L: :8080 healthz<br/>R: :8080 readyz"]
        H5["DS Pipelines Operator<br/>L: :8080 healthz<br/>R: :8080 readyz"]
        H6["Kueue<br/>L: :8081 healthz<br/>R: :8081 readyz"]
        H7["KubeRay<br/>L: :8081 healthz<br/>R: :8081 readyz"]
        H8["Training Operator<br/>L: :8081 healthz<br/>R: :8081 readyz"]
        H9["Kubeflow Notebook Controller<br/>L: :8081 healthz<br/>R: :8081 readyz"]
    end

    subgraph ScrapeDiscovery["Scrape Target Discovery"]
        SM["ServiceMonitor CRs<br/>Created by operators<br/>Per-component + per-workload"]
        PM["PodMonitor CRs<br/>For workload pods<br/>InferenceService, notebooks"]
    end

    subgraph ConditionalDeploy["Conditional Deployment Warning"]
        CW["Observability stack varies by cluster<br/>Each component conditionally deployed<br/>based on operator CRD availability:<br/>MonitoringStack, Tempo,<br/>OpenTelemetryCollector, Perses<br/>Non-deterministic monitoring coverage"]
    end

    %% ─── Prometheus scraping flow ───
    SM -->|"discovered by"| MonStack
    PM -->|"discovered by"| MonStack
    MonStack -->|"scrapes"| P1
    MonStack -->|"scrapes"| P2
    MonStack -->|"scrapes"| P3
    MonStack -->|"scrapes"| P4
    MonStack -->|"scrapes"| P5
    MonStack -->|"scrapes"| P6
    MonStack -->|"scrapes"| P7
    MonStack -->|"scrapes"| P8
    MonStack -->|"scrapes"| P16

    %% ─── Multi-tenant metrics ───
    MonStack -->|"proxied via"| PromProxy
    PromProxy -->|"federated"| ThanosQ

    %% ─── Tracing flow ───
    T1 -->|"OTLP/gRPC"| Collector
    T2 -->|"OTLP/gRPC"| Collector
    T3 -->|"OTLP/gRPC"| Collector
    T4 -->|"OTLP/gRPC"| Collector
    Collector -->|"exports"| TempoSvc

    %% ─── Dashboarding ───
    MonStack -->|"data source"| Perses
    MetricsDash -->|"renders in"| Perses

    %% ─── Styling ───
    classDef prom fill:#e8d5b7,stroke:#b8860b
    classDef probe fill:#d5e8d4,stroke:#82b366
    classDef trace fill:#dae8fc,stroke:#6c8ebf
    classDef infra fill:#fff2cc,stroke:#d6b656
    classDef warning fill:#f8cecc,stroke:#b85450

    class P1,P2,P3,P4,P5,P6,P7,P8,P9,P10,P11,P12,P13,P14,P15,P16,P17,P18 prom
    class H1,H2,H3,H4,H5,H6,H7,H8,H9 probe
    class T1,T2,T3,T4,Collector,TempoSvc trace
    class MonStack,PromProxy,ThanosQ,Perses,MetricsDash,SM,PM infra
    class CW warning
