graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Route["OpenShift Route / Gateway<br/>443/TCP → 8443/TCP<br/>TLS 1.2+<br/>OpenShift OAuth"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (Per-User Isolated Instance)"]
        direction TB
        OAuthProxy["OAuth Proxy Sidecar<br/>8443/TCP HTTPS<br/>Injected by Notebook Controller<br/>Validates OAuth Token"]
        Workbench["JupyterLab / code-server<br/>8888/TCP or 8080/TCP HTTP<br/>Plain HTTP (no TLS)<br/>SA: managed by controller"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
        Git["Git Repositories<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        KFP["Kubeflow Pipelines API<br/>HTTP/HTTPS<br/>Bearer Token"]
    end

    subgraph BuildTimeOnly["BUILD-TIME EGRESS (not at runtime)"]
        PyPI["PyPI / Package Registries<br/>443/TCP HTTPS<br/>uv pip install --verify-hashes"]
        Mirror["mirror.openshift.com<br/>443/TCP HTTPS<br/>oc client download"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OpenShift OAuth"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth Token"| OAuthProxy
    OAuthProxy -->|"HTTP/8888 or 8080<br/>No encryption<br/>Pod-internal"| Workbench
    Workbench -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / Access Key<br/>boto3 SDK"| S3
    Workbench -->|"HTTPS/443<br/>TLS 1.2+<br/>Git credentials"| Git
    Workbench -->|"HTTP or HTTPS<br/>Bearer Token<br/>Elyra bootstrapper"| KFP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef buildtime fill:#f0f0f0,stroke:#ccc,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class Route ingress
    class OAuthProxy,Workbench workbench
    class S3,Git,KFP externalservice
    class PyPI,Mirror buildtime
