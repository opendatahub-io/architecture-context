graph LR
    OVMS["OpenVINO Model Server<br/>(C++ Inference Server)"]

    %% Core Runtime Dependencies
    OVMS -->|"inference engine"| OpenVINORT["OpenVINO Runtime<br/>2026.2"]
    OVMS -->|"GenAI pipelines"| OpenVINOGenAI["OpenVINO GenAI<br/>2026.2"]
    OVMS -->|"tokenization"| OpenVINOTok["OpenVINO Tokenizers<br/>2026.2"]

    %% Framework Dependencies
    OVMS -->|"graph orchestration"| MediaPipe["MediaPipe"]
    OVMS -->|"HTTP server"| Drogon["Drogon<br/>(HTTP Framework)"]
    OVMS -->|"gRPC server"| gRPCLib["gRPC C++"]
    OVMS -->|"metrics"| PromClient["Prometheus C++<br/>Client"]
    OVMS -->|"image processing"| OpenCV["OpenCV 4.13.0"]

    %% Storage SDK Dependencies
    OVMS -->|"S3 model storage"| AWSSDK["AWS SDK (S3)"]
    OVMS -->|"GCS model storage"| GCSSDK["GCS SDK"]
    OVMS -->|"Azure model storage"| AzureSDK["Azure Storage SDK<br/>7.5.0"]
    OVMS -->|"HF model clone"| libgit2["libgit2"]

    %% Utility Dependencies
    OVMS -->|"serialization"| Protobuf["Protocol Buffers 3"]
    OVMS -->|"JSON parsing"| RapidJSON["RapidJSON"]
    OVMS -->|"networking/fs"| Boost["Boost 1.68.0"]
    OVMS -->|"HTTP client"| cURL["cURL 8.20.0"]
    OVMS -.->|"optional runtime"| Python["Python 3.12<br/>(DAG nodes, Jinja2)"]

    %% Internal RHOAI Dependencies
    KServe["KServe"] -->|"deploys as<br/>ServingRuntime"| OVMS
    KubeRBACProxy["kube-rbac-proxy"] -->|"auth sidecar<br/>(RHOAI 3.x)"| OVMS
    Dashboard["OpenShift AI<br/>Dashboard"] -.->|"UI selection"| OVMS

    %% Integration Points (consumers)
    Prometheus["Prometheus"] -->|"scrapes /metrics"| OVMS

    %% External Services
    OVMS -->|"model artifacts"| S3["S3 Storage"]
    OVMS -->|"model artifacts"| GCS["Google Cloud Storage"]
    OVMS -->|"model artifacts"| Azure["Azure Blob Storage"]
    OVMS -->|"model repos"| HF["HuggingFace Hub"]

    %% Build Dependencies
    OVMS -.->|"build system"| Bazel["Bazel 6.1.1"]

    %% Styling
    style OVMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core runtime - orange
    style OpenVINORT fill:#f5a623,stroke:#333,color:#fff
    style OpenVINOGenAI fill:#f5a623,stroke:#333,color:#fff
    style OpenVINOTok fill:#f5a623,stroke:#333,color:#fff

    %% Frameworks - light blue
    style MediaPipe fill:#7ec8e3,stroke:#333
    style Drogon fill:#7ec8e3,stroke:#333
    style gRPCLib fill:#7ec8e3,stroke:#333
    style PromClient fill:#7ec8e3,stroke:#333
    style OpenCV fill:#7ec8e3,stroke:#333

    %% Storage SDKs - yellow
    style AWSSDK fill:#fff2cc,stroke:#333
    style GCSSDK fill:#fff2cc,stroke:#333
    style AzureSDK fill:#fff2cc,stroke:#333
    style libgit2 fill:#fff2cc,stroke:#333

    %% Utilities - grey
    style Protobuf fill:#e8e8e8,stroke:#333
    style RapidJSON fill:#e8e8e8,stroke:#333
    style Boost fill:#e8e8e8,stroke:#333
    style cURL fill:#e8e8e8,stroke:#333
    style Python fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style Bazel fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5

    %% Internal RHOAI - green
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style KubeRBACProxy fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff

    %% External services - red-ish
    style S3 fill:#f8cecc,stroke:#b85450
    style GCS fill:#f8cecc,stroke:#b85450
    style Azure fill:#f8cecc,stroke:#b85450
    style HF fill:#f8cecc,stroke:#b85450
