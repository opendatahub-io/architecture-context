graph LR
    OVMS["OpenVINO Model Server<br/>(OVMS)"]

    %% Core Runtime Dependencies (Required)
    OVMS -->|"core inference<br/>(in-process)"| OpenVINORT["OpenVINO Runtime<br/>2026.2"]
    OVMS -->|"LLM generation<br/>(in-process)"| OpenVINOGenAI["OpenVINO GenAI<br/>2026.2"]
    OVMS -->|"tokenization<br/>(in-process)"| OpenVINOTok["OpenVINO Tokenizers<br/>2026.2"]

    %% Server Framework Dependencies (Required)
    OVMS -->|"HTTP server"| Drogon["Drogon<br/>(HTTP framework)"]
    OVMS -->|"gRPC server"| GRPC["gRPC C++"]
    OVMS -->|"JSON parsing"| RapidJSON["RapidJSON"]
    OVMS -->|"logging"| Spdlog["spdlog"]
    OVMS -->|"utilities"| Boost["Boost 1.68.0"]
    OVMS -->|"image processing"| OpenCV["OpenCV 4.13.0"]
    OVMS -->|"XML parsing"| Pugixml["pugixml 1.13"]
    OVMS -->|"TLS/crypto"| OpenSSL["OpenSSL<br/>(system)"]

    %% Optional Extensions
    OVMS -.->|"streaming pipelines<br/>(optional)"| MediaPipe["MediaPipe"]
    OVMS -.->|"Python nodes<br/>(optional)"| Pybind11["pybind11 /<br/>Python 3.12"]
    OVMS -.->|"metrics<br/>(optional)"| PromCpp["prometheus-cpp"]

    %% Storage Backend Dependencies (Optional)
    OVMS -.->|"S3 storage<br/>(optional)"| AWSSDK["AWS SDK C++"]
    OVMS -.->|"GCS storage<br/>(optional)"| GCSSDK["Google Cloud C++"]
    OVMS -.->|"Azure storage<br/>(optional)"| AzureSDK["Azure Storage SDK<br/>C++ 7.5.0"]
    OVMS -->|"HTTP client"| Libcurl["libcurl"]
    OVMS -.->|"HF model pulling<br/>(optional)"| Libgit2["libgit2"]

    %% Internal RHOAI Platform Dependencies
    KServe["KServe<br/>InferenceService"] -->|"container runtime"| OVMS
    RHOAIOp["RHOAI Operator"] -->|"image reference"| OVMS

    %% External Service Integrations
    OVMS -->|"model pulling<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    OVMS -.->|"model storage<br/>HTTPS/443"| S3["AWS S3"]
    OVMS -.->|"model storage<br/>HTTPS/443"| GCS["Google Cloud Storage"]
    OVMS -.->|"model storage<br/>HTTPS/443"| AzureBlob["Azure Blob Storage"]

    %% Monitoring Integration
    Prometheus["Prometheus"] -->|"scrape /metrics"| OVMS

    %% Hardware Integration
    OVMS -.->|"GPU acceleration<br/>(optional)"| IntelGPU["Intel GPU<br/>(OpenCL driver)"]

    %% Styling
    style OVMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OpenVINORT fill:#7b1fa2,stroke:#333,color:#fff
    style OpenVINOGenAI fill:#7b1fa2,stroke:#333,color:#fff
    style OpenVINOTok fill:#7b1fa2,stroke:#333,color:#fff
    style Drogon fill:#999,stroke:#333,color:#fff
    style GRPC fill:#999,stroke:#333,color:#fff
    style RapidJSON fill:#999,stroke:#333,color:#fff
    style Spdlog fill:#999,stroke:#333,color:#fff
    style Boost fill:#999,stroke:#333,color:#fff
    style OpenCV fill:#999,stroke:#333,color:#fff
    style Pugixml fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
