graph LR
    OVMS["OpenVINO Model Server<br/>C++ Inference Server"]

    %% Core Runtime Dependencies (Required)
    OVMS -->|"inference engine"| OpenVINO["OpenVINO Runtime<br/>2026.2.0"]
    OVMS -->|"LLM/VLM pipelines"| GenAI["OpenVINO GenAI<br/>2026.2"]
    OVMS -->|"tokenizer support"| Tokenizers["OpenVINO Tokenizers"]

    %% Server Framework Dependencies (Required)
    OVMS -->|"gRPC server"| gRPC["gRPC<br/>Bazel-managed"]
    OVMS -->|"HTTP server"| Drogon["Drogon<br/>Bazel-managed"]
    OVMS -->|"v3 API routing"| MediaPipe["MediaPipe<br/>Bazel-managed"]

    %% Build Dependencies
    OVMS -->|"build system"| Bazel["Bazel 6.1.1"]
    OVMS -->|"image processing"| OpenCV["OpenCV 4.13.0"]

    %% Optional Runtime Dependencies
    OVMS -.->|"Azure storage"| BoostAzure["Boost 1.68.0 +<br/>Azure SDK 7.5.0"]
    OVMS -.->|"HF model download"| libgit2["libgit2"]
    OVMS -.->|"model conversion"| OptimumIntel["optimum-intel"]

    %% Internal RHOAI Dependencies
    KServe["KServe<br/>ServingRuntime CRD"] -->|"deploys"| OVMS

    %% Integration Points
    Prometheus["Prometheus"] -->|"scrapes /metrics"| OVMS
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe

    %% External Services (Egress)
    OVMS -->|"model storage<br/>HTTPS/443"| S3["S3-compatible<br/>Storage"]
    OVMS -->|"model storage<br/>HTTPS/443"| GCS["Google Cloud<br/>Storage"]
    OVMS -->|"model storage<br/>HTTPS/443"| AzureStorage["Azure Blob<br/>Storage"]
    OVMS -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]

    %% System Dependencies
    OVMS -->|"TLS, checksums"| OpenSSL["OpenSSL<br/>system/UBI"]
    OVMS -->|"HTTP client"| curl["curl<br/>system"]

