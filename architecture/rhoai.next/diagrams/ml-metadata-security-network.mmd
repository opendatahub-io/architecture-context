graph TB
    subgraph PipelineClients["PIPELINE CONSUMERS (gRPC Clients)"]
        DSP["Data Science Pipelines<br/>Controller<br/>NS: {dspa-namespace}"]
        KFP["Kubeflow Pipelines SDK<br/>NS: {dspa-namespace}"]
        PipelineUI["Pipeline UI / Dashboard<br/>NS: {dspa-namespace}"]
    end

    subgraph MLMDService["MLMD SERVICE (ClusterIP - Internal Only)"]
        Server["metadata_store_server<br/>Container: odh-mlmd-grpc-server<br/>Base: UBI9 | UID: 65534 (non-root)<br/>Port: 8080/TCP gRPC/HTTP2<br/>Crypto: BoringSSL<br/>TLS: Optional (SSLConfig)<br/>Auth: Optional mTLS (client_verify)"]
    end

    subgraph DatabaseBackends["DATABASE BACKENDS"]
        MySQL["MySQL / MariaDB<br/>3306/TCP<br/>MySQL protocol<br/>Optional TLS<br/>(cert, key, ca, cipher)<br/>Auth: Username/password"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL protocol<br/>Optional TLS<br/>(sslmode, sslcert, sslkey)<br/>Auth: Username/password"]
    end

    subgraph Secrets["SECRETS"]
        direction LR
        DBCreds["DB Credentials<br/>(Opaque)<br/>Provisioned by: DSP controller<br/>Auto-Rotate: No"]
        TLSCert["TLS Server Key/Cert<br/>(kubernetes.io/tls)<br/>Provisioned by: operator/cert-manager"]
        ClientCA["TLS Client CA<br/>(Opaque)<br/>For mTLS verification"]
    end

    %% Client to MLMD flows
    DSP -->|"gRPC/8080/TCP<br/>HTTP2<br/>Optional TLS (BoringSSL)<br/>Optional mTLS (client_verify)"| Server
    KFP -->|"gRPC/8080/TCP<br/>HTTP2<br/>Optional TLS (BoringSSL)<br/>Optional mTLS (client_verify)"| Server
    PipelineUI -->|"gRPC/8080/TCP<br/>HTTP2<br/>Optional TLS (BoringSSL)<br/>Optional mTLS (client_verify)"| Server

    %% MLMD to Database flows
    Server -->|"MySQL/3306/TCP<br/>Optional TLS<br/>Username/password"| MySQL
    Server -->|"PostgreSQL/5432/TCP<br/>Optional TLS<br/>Username/password"| PostgreSQL

    %% Secrets references
    Server -.->|"uses"| DBCreds
    Server -.->|"uses"| TLSCert
    Server -.->|"uses"| ClientCA

    %% Warning annotation
    Warning["WARNING: No application-level AuthZ<br/>Any client reaching port 8080<br/>can read/modify ALL metadata<br/>Isolation via NetworkPolicy only"]

    Server -.-> Warning

    %% Styling
    classDef client fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class DSP,KFP,PipelineUI client
    class Server service
    class MySQL,PostgreSQL database
    class DBCreds,TLSCert,ClientCA secret
    class Warning warning
