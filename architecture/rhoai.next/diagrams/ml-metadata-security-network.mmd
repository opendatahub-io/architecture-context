graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        KFP["Kubeflow Pipelines SDK<br/>(Pipeline Steps)"]
        KFPUI["Kubeflow Pipelines UI<br/>(Backend)"]
        TFX["TFX Client"]
    end

    subgraph Internal["INTERNAL CLUSTER (Trusted)"]
        direction TB

        subgraph NS_DSP["Namespace: data-science-pipelines"]
            MLMD["MLMD gRPC Server<br/>metadata_store_server<br/>Port: 8080/TCP<br/>Protocol: gRPC (HTTP/2)<br/>User: 65534:65534 (non-root)<br/>Image: UBI9-based"]
        end

        subgraph NS_Operator["Namespace: operator"]
            DSPOp["Data Science Pipelines Operator<br/>Deploys & manages MLMD"]
        end
    end

    subgraph DatabaseTier["DATABASE TIER"]
        PostgreSQL["PostgreSQL<br/>Port: 5432/TCP<br/>Protocol: PostgreSQL wire<br/>Auth: Username/Password<br/>+ Optional client cert"]
        MySQL["MySQL/MariaDB<br/>Port: 3306/TCP<br/>Protocol: MySQL wire<br/>Auth: Username/Password"]
    end

    %% Flows
    KFP -->|"gRPC/8080<br/>HTTP/2<br/>Optional TLS (SSLConfig)<br/>Optional mTLS (client_verify)"| MLMD
    KFPUI -->|"gRPC/8080<br/>HTTP/2<br/>Optional TLS<br/>Optional mTLS"| MLMD
    TFX -->|"gRPC/8080<br/>HTTP/2<br/>Optional TLS<br/>Optional mTLS"| MLMD

    MLMD -->|"5432/TCP<br/>PostgreSQL wire protocol<br/>Optional TLS (sslmode:<br/>disable/allow/verify-ca/verify-full)<br/>Username/Password + optional client cert"| PostgreSQL
    MLMD -->|"3306/TCP<br/>MySQL wire protocol<br/>Optional TLS (SSL cert/key/CA)<br/>Username/Password"| MySQL

    DSPOp -.->|"Manages Deployment,<br/>Service, Config"| MLMD

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class KFP,KFPUI,TFX external
    class MLMD internal
    class PostgreSQL,MySQL database
    class DSPOp operator
