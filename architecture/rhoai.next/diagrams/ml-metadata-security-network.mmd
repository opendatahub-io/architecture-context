graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph Clients["Clients (DSP Namespace)"]
            KFPipelines["Kubeflow Pipelines SDK<br/>gRPC Client"]
            PipelineUI["Pipeline UI<br/>gRPC Client (via proxy)"]
        end

        subgraph MLMDServer["MLMD gRPC Server"]
            Server["metadata_store_server<br/>Port: 8080/TCP gRPC<br/>Image: odh-mlmd-grpc-server<br/>Base: ubi9-minimal-pqc<br/>User: 65534:65534<br/>Crypto: BoringSSL (static)<br/>Default: InsecureServerCredentials"]
        end
    end

    subgraph DatabaseTier["DATABASE TIER"]
        MySQL["MySQL / MariaDB<br/>3306/TCP<br/>Optional SSL<br/>Username/password"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Optional SSL (sslmode)<br/>Username/password"]
    end

    %% Flows
    KFPipelines -->|"gRPC/8080<br/>Optional TLS (BoringSSL)<br/>Auth: None or mTLS"| Server
    PipelineUI -->|"gRPC/8080<br/>Optional TLS (BoringSSL)<br/>Auth: None or mTLS"| Server
    Server -->|"MySQL/3306<br/>Optional SSL<br/>Username/password"| MySQL
    Server -->|"PostgreSQL/5432<br/>Optional SSL<br/>Username/password"| PostgreSQL

    %% Styling
    classDef client fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef server fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class KFPipelines,PipelineUI client
    class Server server
    class MySQL,PostgreSQL database
