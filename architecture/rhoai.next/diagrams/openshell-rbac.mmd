graph TD
    subgraph ServiceAccounts["Service Accounts"]
        GatewaySA["Gateway SA<br/>(release namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        NodeReaderCRB["&lt;fullname&gt;-node-reader-&lt;ns&gt;<br/>ClusterRoleBinding"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        SandboxRB["&lt;fullname&gt;-sandbox<br/>RoleBinding<br/>(sandbox namespace)"]
        PeerRB["&lt;fullname&gt;-peer<br/>RoleBinding<br/>(release namespace)"]
        CredSecRB["&lt;fullname&gt;-credential-secrets<br/>RoleBinding<br/>(credential namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        NodeReaderCR["&lt;fullname&gt;-node-reader-&lt;ns&gt;<br/>ClusterRole"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        SandboxRole["&lt;fullname&gt;-sandbox<br/>Role"]
        PeerRole["&lt;fullname&gt;-peer<br/>Role"]
        CredSecRole["&lt;fullname&gt;-credential-secrets<br/>Role"]
    end

    subgraph ClusterResources["Cluster-Scoped Resources"]
        RuntimeClasses["node.k8s.io<br/>RuntimeClasses"]
        PriorityClasses["scheduling.k8s.io<br/>PriorityClasses"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        Nodes["core<br/>Nodes"]
        Namespaces["core<br/>Namespaces"]
        Sandboxes["agents.x-k8s.io<br/>Sandboxes + Status"]
    end

    subgraph NamespaceResources["Namespace-Scoped Resources"]
        Pods["core<br/>Pods"]
        Secrets["core<br/>Secrets"]
        ConfigMaps["core<br/>ConfigMaps"]
    end

    %% SA to Bindings
    GatewaySA -->|"bound via"| NodeReaderCRB
    GatewaySA -->|"bound via"| SandboxRB
    GatewaySA -->|"bound via"| PeerRB
    GatewaySA -->|"bound via"| CredSecRB

    %% Bindings to Roles
    NodeReaderCRB -->|"grants"| NodeReaderCR
    SandboxRB -->|"grants"| SandboxRole
    PeerRB -->|"grants"| PeerRole
    CredSecRB -->|"grants"| CredSecRole

    %% ClusterRole to Resources
    NodeReaderCR -->|"get"| RuntimeClasses
    NodeReaderCR -->|"get"| PriorityClasses
    NodeReaderCR -->|"create"| TokenReviews
    NodeReaderCR -->|"get, list, watch"| Nodes
    NodeReaderCR -->|"get (+ list, watch,<br/>create, delete<br/>in managed mode)"| Namespaces
    NodeReaderCR -->|"create, delete, get,<br/>list, patch, update,<br/>watch (non-shared)"| Sandboxes

    %% Namespace Roles to Resources
    SandboxRole -->|"CRUD"| Pods
    SandboxRole -->|"CRUD"| Secrets
    CredSecRole -->|"get, list, create,<br/>update, delete"| Secrets

    %% Styling
    style GatewaySA fill:#4a90e2,color:#fff
    style NodeReaderCR fill:#f5a623
    style SandboxRole fill:#f5a623
    style PeerRole fill:#f5a623
    style CredSecRole fill:#f5a623
    style RuntimeClasses fill:#7ed321
    style PriorityClasses fill:#7ed321
    style TokenReviews fill:#7ed321
    style Nodes fill:#7ed321
    style Namespaces fill:#7ed321
    style Sandboxes fill:#7ed321
    style Pods fill:#7ed321
    style Secrets fill:#7ed321
    style ConfigMaps fill:#7ed321
