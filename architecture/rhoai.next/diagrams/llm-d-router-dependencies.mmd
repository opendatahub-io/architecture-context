graph LR
    Router["llm-d Router<br/>(EPP + Sidecar + Coordinator)"]

    %% ===== External Dependencies =====
    Router -->|"gRPC ext-proc v3<br/>routing decisions"| Envoy["Envoy Proxy<br/>(ext-proc v3 compatible)"]
    Router -->|"CRD watches<br/>HTTPS/443"| K8s["Kubernetes 1.31+"]
    Router -->|"HTTPRoute/Gateway<br/>resources"| GatewayAPI["Gateway API v1.5.1"]
    Router -->|"InferencePool CRD<br/>EPP protocol"| GIE["Gateway API<br/>Inference Extension v1.5.0"]

    %% Optional external deps
    Router -.->|"metrics collection"| Prometheus["Prometheus"]
    Router -.->|"traces gRPC/4317"| OTEL["OTEL Collector"]
    Router -.->|"KV-cache metadata<br/>Redis/6379"| Redis["Redis v9+"]
    Router -.->|"KV-Events<br/>ZMQ/5557"| ZMQ["ZeroMQ v4"]

    %% ===== Internal Platform Dependencies =====
    Router -->|"metrics scraping<br/>HTTP (50ms poll)"| vLLM["vLLM Model Server"]
    Router -->|"metrics scraping<br/>HTTP"| SGLang["SGLang Model Server"]
    Router -->|"GPU metrics<br/>HTTP"| DCGM["DCGM Exporter"]
    Router -->|"Gateway controller<br/>Envoy data plane"| Istio["Istio / kGateway"]

    %% ===== Coordinator-specific Dependencies =====
    Router -.->|"dispatch stages<br/>HTTP/80"| InfGateway["Inference Gateway"]
    Router -.->|"tokenize prompts<br/>HTTP/8080"| RenderSvc["Rendering Service"]

    %% ===== Sidecar-specific Dependencies =====
    Router -->|"decode requests<br/>HTTP/8200"| LocalVLLM["Local vLLM Decoder<br/>(same pod)"]
    Router -->|"prefill routing<br/>HTTP/HTTPS"| PrefillPods["Remote Prefill Pods"]
    Router -.->|"encode routing<br/>HTTP/HTTPS (E/P/D)"| EncoderPods["Remote Encoder Pods"]

    %% ===== KV-Cache Transfer Protocols =====
    subgraph KVTransfer["KV-Cache Transfer Protocols"]
        direction TB
        NIXL["NIXLv2"]
        SharedStorage["Shared Storage"]
        SGLangProto["SGLang Protocol"]
        Mooncake["Mooncake"]
        Offloading["P2P Offloading"]
    end
    Router -.->|"KV-cache transfer<br/>(sidecar)"| KVTransfer

    %% Styling
    style Router fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps - required
    style Envoy fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style GIE fill:#999,stroke:#333,color:#fff

    %% External deps - optional
    style Prometheus fill:#bbb,stroke:#333,color:#333
    style OTEL fill:#bbb,stroke:#333,color:#333
    style Redis fill:#bbb,stroke:#333,color:#333
    style ZMQ fill:#bbb,stroke:#333,color:#333

    %% Internal platform deps
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style SGLang fill:#7ed321,stroke:#333,color:#fff
    style DCGM fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style InfGateway fill:#7ed321,stroke:#333,color:#fff
    style RenderSvc fill:#7ed321,stroke:#333,color:#fff

    %% Sidecar deps
    style LocalVLLM fill:#50c878,stroke:#333,color:#fff
    style PrefillPods fill:#50c878,stroke:#333,color:#fff
    style EncoderPods fill:#50c878,stroke:#333,color:#fff

    %% KV Transfer
    style NIXL fill:#f5a623,stroke:#333
    style SharedStorage fill:#f5a623,stroke:#333
    style SGLangProto fill:#f5a623,stroke:#333
    style Mooncake fill:#f5a623,stroke:#333
    style Offloading fill:#f5a623,stroke:#333
