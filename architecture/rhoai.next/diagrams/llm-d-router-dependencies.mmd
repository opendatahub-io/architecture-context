graph LR
    LLMDRouter["llm-d Router<br/>(EPP + pd-sidecar + Coordinator)"]

    %% External Dependencies (Required)
    LLMDRouter -->|"ext-proc gRPC/9002<br/>traffic interception"| Envoy["Envoy Proxy"]
    LLMDRouter -->|"InferencePool CRD<br/>v1.5.0"| GIE["Gateway API<br/>Inference Extension<br/>v1.5.0"]
    LLMDRouter -->|"CRD reconciliation<br/>controller-runtime"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    LLMDRouter -->|"Gateway API types<br/>v1.5.1"| GatewayAPI["gateway-api<br/>v1.5.1"]
    LLMDRouter -->|"inference execution<br/>HTTP/8000"| vLLM["vLLM Model Servers"]

    %% External Dependencies (Optional)
    LLMDRouter -.->|"distributed state<br/>TCP/6379"| Redis["Redis<br/>(optional)"]
    LLMDRouter -.->|"trace export<br/>gRPC/4317"| OTLP["OpenTelemetry<br/>Collector<br/>(optional)"]
    LLMDRouter -.->|"KV-cache events<br/>ZMQ/5557"| ZMQ["ZMQ Events<br/>(optional)"]
    LLMDRouter -.->|"latency prediction<br/>HTTP/8001"| LatencyPredictor["Latency Predictor<br/>(optional)"]

    %% Platform Dependencies
    LLMDRouter -->|"watch CRDs + Pods<br/>HTTPS/443"| K8sAPI["Kubernetes API<br/>Server"]

    %% Internal Integration Points
    LLMDRouter -->|"prefill requests<br/>HTTP/Dynamic"| PrefillWorkers["Prefill Worker Pods"]
    LLMDRouter -->|"encode requests<br/>HTTP/Dynamic"| EncoderWorkers["Encoder Worker Pods"]
    LLMDRouter -->|"decode proxy<br/>HTTP/8200"| LocalDecoder["Local vLLM Decoder"]
    LLMDRouter -->|"metrics scraping<br/>HTTP/8000"| ModelServerMetrics["Model Server Metrics<br/>(Prometheus)"]
    LLMDRouter -.->|"GPU metrics<br/>HTTP/9400"| DCGM["DCGM Exporter<br/>(optional)"]

    %% Coordinator-specific
    LLMDRouter -.->|"E/P/D pipeline<br/>HTTP/2 /80"| InferenceGW["Inference Gateway"]
    LLMDRouter -.->|"tokenization<br/>HTTP/8080"| RenderingSvc["Rendering Service"]

    %% Observability
    Prometheus["Prometheus"] -->|"scrape metrics<br/>HTTP/9090"| LLMDRouter

    %% Styling
    style LLMDRouter fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External required
    style Envoy fill:#999,stroke:#333,color:#fff
    style GIE fill:#999,stroke:#333,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style vLLM fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff

    %% External optional
    style Redis fill:#bbb,stroke:#333,stroke-dasharray: 5 5,color:#333
    style OTLP fill:#bbb,stroke:#333,stroke-dasharray: 5 5,color:#333
    style ZMQ fill:#bbb,stroke:#333,stroke-dasharray: 5 5,color:#333
    style LatencyPredictor fill:#bbb,stroke:#333,stroke-dasharray: 5 5,color:#333
    style DCGM fill:#bbb,stroke:#333,stroke-dasharray: 5 5,color:#333

    %% Internal
    style PrefillWorkers fill:#7ed321,stroke:#333,color:#333
    style EncoderWorkers fill:#7ed321,stroke:#333,color:#333
    style LocalDecoder fill:#7ed321,stroke:#333,color:#333
    style ModelServerMetrics fill:#7ed321,stroke:#333,color:#333
    style InferenceGW fill:#7ed321,stroke:#333,color:#333
    style RenderingSvc fill:#7ed321,stroke:#333,color:#333

    %% Observability
    style Prometheus fill:#f5a623,stroke:#333,color:#333
