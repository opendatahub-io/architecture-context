graph LR
    AutoxCI["autox-ci<br/>Test Suite / CI Tooling"]

    %% Internal RHOAI Dependencies
    AutoxCI -->|"CRD create<br/>(DataSciencePipelinesApplication)"| DSPO["Data Science Pipelines<br/>Operator (DSPO)"]
    AutoxCI -->|"KFP SDK client<br/>(submit, poll, retrieve)"| KFP["Kubeflow Pipelines"]
    AutoxCI -->|"CRD create/delete<br/>(InferenceService,<br/>ServingRuntime)"| KServe["KServe"]
    AutoxCI -->|"Route discovery<br/>(route.openshift.io)"| Routes["OpenShift Routes"]
    AutoxCI -.->|"annotation convention<br/>(Data Connection)"| ODHModelCtrl["odh-model-controller"]
    AutoxCI -.->|"label convention<br/>(dashboard visibility)"| Dashboard["OpenShift AI Dashboard"]
    AutoxCI -->|"CRD read<br/>(infrastructure.opendatahub.io)"| HWProfiles["HardwareProfiles"]
    AutoxCI -->|"Template read<br/>(template.openshift.io)"| Templates["OpenShift Templates"]

    %% External Dependencies
    AutoxCI -->|"resource mgmt<br/>(Python client)"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    AutoxCI -->|"test data + artifacts<br/>(boto3)"| S3["S3-Compatible<br/>Storage"]
    AutoxCI -->|"benchmark datasets"| HuggingFace["HuggingFace Hub"]
    AutoxCI -.->|"package install<br/>(AutoGluon)"| RHELPyPI["RHEL AI PyPI"]

    %% Python Dependencies
    AutoxCI -->|"test framework"| Pytest["pytest >=7.0"]
    AutoxCI -->|"K8s client"| K8sPy["kubernetes >=28.0"]
    AutoxCI -->|"pipeline SDK"| KFPSdk["kfp >=2.16.1"]
    AutoxCI -->|"S3 client"| Boto3["boto3 >=1.28"]
    AutoxCI -->|"artifact parsing"| PyArrow["pyarrow >=20.0"]

    %% Reverse Dependencies (who uses autox-ci)
    CIJobs["CI / Jenkins Jobs"] -->|"test execution"| AutoxCI
    Downstream["Downstream Repos<br/>(git submodule)"] -.->|"test import"| AutoxCI

    %% Styling
    style AutoxCI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI (green)
    style DSPO fill:#7ed321,stroke:#333,color:#fff
    style KFP fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Routes fill:#7ed321,stroke:#333,color:#fff
    style ODHModelCtrl fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style HWProfiles fill:#7ed321,stroke:#333,color:#fff
    style Templates fill:#7ed321,stroke:#333,color:#fff

    %% External Services (orange)
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style HuggingFace fill:#f5a623,stroke:#333,color:#fff
    style RHELPyPI fill:#f5a623,stroke:#333,color:#fff

    %% Python libs (grey)
    style Pytest fill:#999,stroke:#333,color:#fff
    style K8sPy fill:#999,stroke:#333,color:#fff
    style KFPSdk fill:#999,stroke:#333,color:#fff
    style Boto3 fill:#999,stroke:#333,color:#fff
    style PyArrow fill:#999,stroke:#333,color:#fff

    %% Reverse deps (light blue)
    style CIJobs fill:#b3d9ff,stroke:#333
    style Downstream fill:#b3d9ff,stroke:#333
