graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Container["CONTAINER BOUNDARY (caikit-nlp pod)"]
        direction TB

        RESTGw["REST Gateway<br/>8080/TCP HTTP/1.1<br/>Optional TLS<br/>Auth: Platform-delegated"]
        GRPCRuntime["gRPC Runtime Server<br/>8085/TCP gRPC (HTTP/2)<br/>Optional TLS<br/>Services: TextGen, Embedding,<br/>Rerank, Classification, Tokenization"]
        LocalModel["HuggingFace Model<br/>(in-memory GPU/CPU)<br/>No network I/O"]

        RESTGw -->|"gRPC/8085<br/>localhost (no TLS)<br/>Process-internal"| GRPCRuntime
        GRPCRuntime -->|"LOCAL PATH<br/>PyTorch inference"| LocalModel
    end

    subgraph Platform["PLATFORM SECURITY LAYER"]
        KServe["KServe InferenceService<br/>Provides: K8s Service, Ingress, Auth"]
        RBAC["kube-rbac-proxy sidecar<br/>Enforces AuthN/AuthZ"]
    end

    subgraph InternalServices["INTERNAL SERVICES"]
        TGIS["TGIS Server<br/>configurable/TCP (default 8033)<br/>gRPC<br/>Optional TLS/mTLS"]
        PyTorchDist["PyTorch Distributed<br/>29550/TCP<br/>TCP (gloo/nccl)<br/>No encryption<br/>(training only)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API token (optional)"]
    end

    %% External flows
    Client -->|"HTTP/8080<br/>Optional TLS<br/>Auth: kube-rbac-proxy"| RESTGw
    Client -->|"gRPC/8085<br/>Optional TLS<br/>Auth: Platform"| GRPCRuntime

    %% Platform wrapping
    KServe -.->|"deploys & exposes"| Container
    RBAC -.->|"auth sidecar"| Container

    %% Remote inference path
    GRPCRuntime -->|"REMOTE PATH<br/>gRPC/configurable<br/>Optional TLS/mTLS<br/>ca_cert + client_cert"| TGIS

    %% Egress
    GRPCRuntime -->|"HTTPS/443<br/>TLS 1.2+<br/>API token<br/>(allow_downloads=true)"| HFHub

    %% Distributed training
    GRPCRuntime -.->|"TCP/29550<br/>gloo/nccl<br/>No encryption"| PyTorchDist

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef container fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#fce4ec,stroke:#e57373,stroke-width:2px
    classDef runtime fill:#4a90e2,color:#fff
    classDef localmodel fill:#d1fae5,stroke:#10b981

    class Client external
    class RESTGw,GRPCRuntime runtime
    class LocalModel localmodel
    class KServe,RBAC platform
    class TGIS,PyTorchDist internal
    class HFHub externalservice
