graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client"]
    end

    subgraph AppBoundary["CAIKIT RUNTIME (Application Boundary)"]
        direction TB

        Runtime["Caikit Runtime<br/>HTTP :8080/TCP | gRPC :8085/TCP<br/>Configurable TLS<br/>UID: 1001 (non-root)"]

        subgraph LocalModules["caikit-nlp In-Process Modules"]
            direction LR
            LocalInference["Local Inference<br/>PeftPromptTuning<br/>TextGeneration<br/>EmbeddingModule"]
            RemoteInference["Remote Inference<br/>PeftPromptTuningTGIS<br/>TextGenerationTGIS"]
        end

        Runtime -->|"function call<br/>(no network boundary)"| LocalModules
    end

    subgraph Backend["BACKEND SERVICES"]
        TGIS["TGIS Server<br/>gRPC<br/>Configurable TLS<br/>Certificate Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>API Token (optional)"]
        Filesystem["Local Filesystem<br/>Model Storage<br/>UID 1001 access"]
    end

    %% Flows
    Client -->|"HTTP :8080 / gRPC :8085<br/>Configurable TLS<br/>Auth: Platform-dependent"| Runtime
    RemoteInference -->|"gRPC<br/>Configurable TLS<br/>ca_cert + client_cert"| TGIS
    LocalInference -.->|"HTTPS :443<br/>TLS<br/>ALLOW_DOWNLOADS=1<br/>(default: disabled)"| HFHub
    LocalInference -->|"File I/O<br/>Model load/save"| Filesystem

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appboundary fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Runtime,LocalInference,RemoteInference appboundary
    class TGIS backend
    class HFHub,Filesystem externalservice
