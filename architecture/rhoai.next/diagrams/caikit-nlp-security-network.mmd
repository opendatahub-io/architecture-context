graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Platform Service"]
    end

    subgraph Platform["PLATFORM BOUNDARY (KServe / ModelMesh)"]
        direction TB

        subgraph Container["Caikit Runtime Container<br/>Image: odh-caikit-nlp-rhel9 (UBI9)"]
            HTTPServer["Caikit HTTP Server<br/>8080/TCP<br/>TLS configurable<br/>Auth: Platform-managed"]
            GRPCServer["Caikit gRPC Server<br/>8085/TCP<br/>TLS configurable<br/>Auth: Platform-managed"]

            subgraph Modules["NLP Modules (in-process)"]
                TextGenMods["Text Generation<br/>(Local + TGIS)"]
                EmbedMods["Embedding / Reranking<br/>(sentence-transformers)"]
                ClassMods["Classification<br/>(Sequence + Token)"]
            end

            HTTPServer -->|dispatches| Modules
            GRPCServer -->|dispatches| Modules
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        TGIS["TGIS Backend<br/>configurable/TCP gRPC<br/>TLS optional mTLS<br/>Auth: mTLS certs"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: HF Token (optional)"]
    end

    subgraph LocalServices["LOCAL SERVICES (Training only)"]
        TorchDist["torch.distributed<br/>localhost:29550/TCP<br/>No encryption<br/>No auth"]
    end

    %% Ingress flows
    Client -->|"HTTP/8080 or gRPC/8085<br/>TLS configurable<br/>Auth: Platform (KServe,<br/>kube-rbac-proxy)"| Container

    %% Egress flows
    TextGenMods -->|"gRPC<br/>TLS optional mTLS<br/>ca_cert + client_cert"| TGIS
    Modules -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN<br/>(ALLOW_DOWNLOADS=1)"| HFHub
    Modules -->|"TCP/29550<br/>No encryption<br/>Multi-GPU training"| TorchDist

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef localservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef module fill:#e1d5e7,stroke:#9673a6

    class Client external
    class HTTPServer,GRPCServer container
    class TextGenMods,EmbedMods,ClassMods module
    class TGIS,HFHub externalservice
    class TorchDist localservice
