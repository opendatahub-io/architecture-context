graph TD
    subgraph "Provider Runtime Identity"
        SA_Inline["Llama Stack Server SA<br/>(inline provider runs in-process)"]
        SA_KFP["KFP Pipeline Pod SA<br/>(remote provider KFP steps)"]
    end

    subgraph "Required Permissions (Not Provisioned)"
        direction TB
        ConfigMapRead["ConfigMap Read<br/>(base image resolution)"]
    end

    subgraph "Target Resources"
        CM_RHODS["ConfigMap: trustyai-service-operator-config<br/>Namespace: redhat-ods-applications"]
        CM_ODH["ConfigMap: trustyai-service-operator-config<br/>Namespace: opendatahub"]
    end

    subgraph "Secrets (User-Provisioned)"
        S3Secret["S3 Credentials Secret<br/>Type: Opaque<br/>Fields: access_key, secret_key, region<br/>Provisioned by: Manual<br/>Auto-rotate: No"]
    end

    subgraph "External Auth Mechanisms"
        KFPToken["KFP Bearer Token<br/>Source: KUBEFLOW_PIPELINES_TOKEN<br/>or kubeconfig fallback<br/>Stored as: SecretStr"]
        AWSCreds["AWS IAM Credentials<br/>Source: K8s Secret<br/>Injected via: kfp-kubernetes"]
    end

    %% Flows
    SA_Inline -.->|"needs"| ConfigMapRead
    SA_KFP -.->|"needs"| ConfigMapRead
    ConfigMapRead -->|"get"| CM_RHODS
    ConfigMapRead -->|"get (fallback)"| CM_ODH

    SA_KFP -->|"mounts"| S3Secret
    S3Secret -->|"provides"| AWSCreds

    SA_Inline -->|"uses"| KFPToken
    SA_KFP -.->|"no direct use"| KFPToken

    %% Notes
    Note1["Note: This component defines NO RBAC roles.<br/>Permissions must be granted externally.<br/>The inline provider has no network auth.<br/>The remote provider needs KFP + S3 + K8s API access."]

    style SA_Inline fill:#4a90e2,color:#fff
    style SA_KFP fill:#4a90e2,color:#fff
    style ConfigMapRead fill:#f5a623
    style CM_RHODS fill:#7ed321
    style CM_ODH fill:#7ed321
    style S3Secret fill:#e74c3c,color:#fff
    style KFPToken fill:#e74c3c,color:#fff
    style AWSCreds fill:#e74c3c,color:#fff
    style Note1 fill:#fff,stroke:#999,stroke-dasharray: 5 5
