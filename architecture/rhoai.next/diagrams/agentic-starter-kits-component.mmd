graph TB
    subgraph External["External Clients"]
        Client[External Client]
    end

    subgraph OpenShift["OpenShift Platform"]
        Route["OpenShift Route<br/>443/TCP HTTPS<br/>Edge TLS"]

        subgraph SharedInfra["Shared Infrastructure"]
            HelmChart["Shared Helm Chart<br/>(Deployment, Service,<br/>Route, Secret, SA)"]
            AuthMiddleware["agent-auth<br/>SATokenAuthMiddleware<br/>(ASGI Middleware)"]
            TracingModule["tracing.py<br/>MLflow Integration<br/>(opt-in)"]
            TestHarness["Behavioral Test Harness<br/>pytest + scorers"]
        end

        subgraph AgentTemplates["Standard Agent Templates (Port 8080)"]
            direction TB
            subgraph LangGraph["LangGraph"]
                ReactAgent["ReAct Agent"]
                AgenticRAG["Agentic RAG"]
                DBMemory["DB Memory Agent"]
                HITL["Human-in-the-Loop"]
            end
            subgraph OtherFrameworks["Other Frameworks"]
                CrewAI["CrewAI Websearch"]
                LlamaIndex["LlamaIndex Websearch"]
                AutoGen["AutoGen MCP Agent"]
                GoogleADK["Google ADK Agent"]
                Langflow["Langflow Agent"]
                A2A["A2A LangGraph+CrewAI"]
                Vanilla["Vanilla Python Agent"]
            end
        end

        subgraph Examples["LangGraph Examples"]
            CIFailure["CI Failure Summarizer"]
            Guardrailed["Guardrailed Banking Agent"]
        end

        subgraph NonStandard["Non-Standard Deployments"]
            OpenClaw["OpenClaw Gateway<br/>Port 18789<br/>(Kustomize)"]
            ClaudeCode["Claude Code<br/>(Containerfile)"]
            Codex["Codex CLI<br/>(OpenShell)"]
            OpenCode["OpenCode<br/>(Kustomize)"]
        end
    end

    subgraph ExternalServices["External Services"]
        LLM["OGX / vLLM / Ollama<br/>LLM Inference"]
        MLflow["MLflow Tracking Server"]
        K8sAPI["Kubernetes API<br/>TokenReview"]
        MilvusDB["Milvus Vector DB"]
        PostgreSQL["PostgreSQL"]
        SlackAPI["Slack API"]
    end

    %% Client flows
    Client -->|HTTPS/443| Route
    Route -->|HTTP/8080| AgentTemplates
    Route -->|HTTP/18789| OpenClaw

    %% Shared infrastructure usage
    HelmChart -.->|deploys| AgentTemplates
    AuthMiddleware -.->|protects| AgentTemplates
    TracingModule -.->|traces| AgentTemplates

    %% Agent dependencies
    AgentTemplates -->|inference| LLM
    AgentTemplates -->|tracing| MLflow
    AuthMiddleware -->|TokenReview| K8sAPI
    AgenticRAG -->|vector retrieval| MilvusDB
    DBMemory -->|memory| PostgreSQL
    CIFailure -->|triage| SlackAPI
    Guardrailed -->|filtering| NeMo["NeMo Guardrails"]
    OpenClaw -->|inference| LLM

    %% Styling
    style Route fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style AuthMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style TracingModule fill:#4a90e2,stroke:#333,color:#fff
    style HelmChart fill:#4a90e2,stroke:#333,color:#fff
    style TestHarness fill:#4a90e2,stroke:#333,color:#fff
    style OpenClaw fill:#e8e8e8,stroke:#666,stroke-width:2px
    style LLM fill:#f5a623,stroke:#333
    style MLflow fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style MilvusDB fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SlackAPI fill:#f5a623,stroke:#333
    style NeMo fill:#f5a623,stroke:#333
