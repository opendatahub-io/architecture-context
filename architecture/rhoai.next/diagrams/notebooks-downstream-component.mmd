graph TB
    subgraph "notebooks-downstream (Container Image Factory)"
        direction TB

        subgraph "Jupyter Workbenches"
            JupMin["Jupyter Minimal<br/>8888/TCP<br/>CPU / CUDA / ROCm"]
            JupDS["Jupyter DataScience<br/>8888/TCP<br/>CPU / CUDA / ROCm"]
            JupPT["Jupyter PyTorch<br/>8888/TCP<br/>CUDA 12.6 / ROCm 6.2"]
            JupTF["Jupyter TensorFlow<br/>8888/TCP<br/>CUDA 12.6 / ROCm 6.2"]
            JupTAI["Jupyter TrustyAI<br/>8888/TCP<br/>CPU + Java 17"]
        end

        subgraph "IDE Workbenches"
            CodeSrv["Code Server v4.98.0<br/>8787/TCP<br/>VS Code + NGINX"]
            RStudioC9["RStudio Server (c9s)<br/>8787/TCP<br/>R 4.4.3 + NGINX"]
            RStudioRH["RStudio Server (RHEL9)<br/>8787/TCP<br/>R 4.4.3 + subscription-mgr"]
        end

        subgraph "Pipeline Runtimes"
            RTMin["Runtime Minimal<br/>Elyra/KFP<br/>CPU"]
            RTDS["Runtime DataScience<br/>Elyra/KFP<br/>CPU"]
            RTPT["Runtime PyTorch<br/>Elyra/KFP<br/>CUDA"]
            RTTF["Runtime TensorFlow<br/>Elyra/KFP<br/>CUDA"]
            RTROCmPT["Runtime ROCm PyTorch<br/>Elyra/KFP<br/>ROCm"]
            RTROCmTF["Runtime ROCm TensorFlow<br/>Elyra/KFP<br/>ROCm"]
        end

        subgraph "Build Tooling"
            BuildInputs["buildinputs (Go CLI)<br/>Minimal build context analyzer"]
            ISManifests["ImageStream Manifests<br/>Kustomize + params.env<br/>6 versions (N through N-5)"]
        end
    end

    %% Layered image builds
    JupMin -->|base for| JupDS
    JupDS -->|base for| JupPT
    JupDS -->|base for| JupTF
    JupDS -->|base for| JupTAI
    JupMin -->|base for| RTMin
    RTMin -->|base for| RTDS
    RTDS -->|base for| RTPT
    RTDS -->|base for| RTTF

    %% Platform integration
    NotebookCtrl["odh-notebook-controller"] -->|creates Pods from| JupMin
    NotebookCtrl -->|creates Pods from| CodeSrv
    NotebookCtrl -->|creates Pods from| RStudioC9
    NotebookCtrl -->|injects| KubeRBAC["kube-rbac-proxy<br/>8443/TCP sidecar"]

    RhodsOp["rhods-operator"] -->|deploys| ISManifests

    KFP["Kubeflow Pipelines"] -->|executes| RTMin
    Elyra["Elyra"] -->|executes| RTMin

    Dashboard["ODH Dashboard"] -->|reads ImageStream<br/>annotations| ISManifests

    Konflux["Konflux (Tekton)"] -->|builds & publishes| QuayIO["quay.io/opendatahub"]

    %% Styling
    style JupMin fill:#4a90e2,color:#fff
    style JupDS fill:#4a90e2,color:#fff
    style JupPT fill:#4a90e2,color:#fff
    style JupTF fill:#4a90e2,color:#fff
    style JupTAI fill:#4a90e2,color:#fff
    style CodeSrv fill:#5b9bd5,color:#fff
    style RStudioC9 fill:#5b9bd5,color:#fff
    style RStudioRH fill:#5b9bd5,color:#fff
    style RTMin fill:#7ed321,color:#fff
    style RTDS fill:#7ed321,color:#fff
    style RTPT fill:#7ed321,color:#fff
    style RTTF fill:#7ed321,color:#fff
    style RTROCmPT fill:#7ed321,color:#fff
    style RTROCmTF fill:#7ed321,color:#fff
    style BuildInputs fill:#f5a623,color:#fff
    style ISManifests fill:#f5a623,color:#fff
    style NotebookCtrl fill:#e8e8e8,stroke:#333
    style RhodsOp fill:#e8e8e8,stroke:#333
    style KubeRBAC fill:#e8e8e8,stroke:#333
    style KFP fill:#e8e8e8,stroke:#333
    style Elyra fill:#e8e8e8,stroke:#333
    style Dashboard fill:#e8e8e8,stroke:#333
    style Konflux fill:#e8e8e8,stroke:#333
    style QuayIO fill:#e8e8e8,stroke:#333
