graph TB
    subgraph NotebooksDownstream["Notebooks Downstream (Container Image Factory)"]
        direction TB

        subgraph Workbenches["Workbench Images"]
            JupyterMinimal["Jupyter Minimal<br/>8888/TCP"]
            JupyterDS["Jupyter DataScience<br/>8888/TCP"]
            JupyterPyTorch["Jupyter PyTorch<br/>8888/TCP"]
            JupyterTF["Jupyter TensorFlow<br/>8888/TCP"]
            JupyterTrustyAI["Jupyter TrustyAI<br/>8888/TCP"]
            JupyterROCmPT["Jupyter ROCm PyTorch<br/>8888/TCP"]
            JupyterROCmTF["Jupyter ROCm TensorFlow<br/>8888/TCP"]
            CodeServer["Code Server<br/>8787/TCP"]
            RStudioC9S["RStudio (c9s)<br/>8787/TCP"]
            RStudioRHEL["RStudio (RHEL9)<br/>8787/TCP"]
        end

        subgraph Runtimes["Pipeline Runtime Images"]
            RuntimeMinimal["Runtime Minimal"]
            RuntimeDS["Runtime DataScience"]
            RuntimePyTorch["Runtime PyTorch"]
            RuntimeTF["Runtime TensorFlow"]
            RuntimeROCmPT["Runtime ROCm PyTorch"]
            RuntimeROCmTF["Runtime ROCm TensorFlow"]
        end

        subgraph BuildTooling["Build Tooling"]
            BuildInputs["buildinputs<br/>(Go CLI)"]
            ImageStreams["ImageStream Manifests<br/>(Kustomize)"]
        end
    end

    subgraph AcceleratorVariants["Accelerator Variants"]
        CPU["CPU"]
        CUDA["NVIDIA CUDA 12.6.3"]
        ROCm["AMD ROCm 6.2.4"]
    end

    %% Image layering
    JupyterMinimal -->|base for| JupyterDS
    JupyterDS -->|base for| JupyterPyTorch
    JupyterDS -->|base for| JupyterTF
    JupyterDS -->|base for| JupyterTrustyAI

    %% Accelerator connections
    CPU -.->|variant| JupyterMinimal
    CUDA -.->|variant| JupyterPyTorch
    CUDA -.->|variant| JupyterTF
    ROCm -.->|variant| JupyterROCmPT
    ROCm -.->|variant| JupyterROCmTF

    %% Platform integration
    NotebookController["odh-notebook-controller"] -->|creates Pods from| Workbenches
    NotebookController -->|creates Pods from| Runtimes
    RhodsOperator["rhods-operator"] -->|deploys| ImageStreams
    KubeRBACProxy["kube-rbac-proxy"] -->|auth sidecar for| Workbenches
    KFP["Kubeflow Pipelines"] -->|executes steps in| Runtimes
    Elyra["Elyra"] -->|runs notebooks in| Runtimes

    %% Build
    BuildInputs -->|minimal build context| Workbenches
    BuildInputs -->|minimal build context| Runtimes
    Konflux["Konflux (Tekton)"] -->|builds| Workbenches
    Konflux -->|builds| Runtimes
    Konflux -->|pushes to| QuayIO["quay.io/opendatahub"]

    %% Styling
    style JupyterMinimal fill:#4a90e2,color:#fff
    style JupyterDS fill:#4a90e2,color:#fff
    style JupyterPyTorch fill:#4a90e2,color:#fff
    style JupyterTF fill:#4a90e2,color:#fff
    style JupyterTrustyAI fill:#4a90e2,color:#fff
    style JupyterROCmPT fill:#4a90e2,color:#fff
    style JupyterROCmTF fill:#4a90e2,color:#fff
    style CodeServer fill:#357abd,color:#fff
    style RStudioC9S fill:#357abd,color:#fff
    style RStudioRHEL fill:#357abd,color:#fff
    style RuntimeMinimal fill:#7ed321
    style RuntimeDS fill:#7ed321
    style RuntimePyTorch fill:#7ed321
    style RuntimeTF fill:#7ed321
    style RuntimeROCmPT fill:#7ed321
    style RuntimeROCmTF fill:#7ed321
    style BuildInputs fill:#f5a623
    style ImageStreams fill:#f5a623
    style CPU fill:#e8e8e8,stroke:#999
    style CUDA fill:#76b900,color:#fff
    style ROCm fill:#ed1c24,color:#fff
    style NotebookController fill:#e8e8e8,stroke:#333
    style RhodsOperator fill:#e8e8e8,stroke:#333
    style KubeRBACProxy fill:#e8e8e8,stroke:#333
    style KFP fill:#e8e8e8,stroke:#333
    style Elyra fill:#e8e8e8,stroke:#333
    style Konflux fill:#e8e8e8,stroke:#333
    style QuayIO fill:#e8e8e8,stroke:#333
