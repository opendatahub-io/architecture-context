graph TB
    subgraph BuildSystem["Build System"]
        direction TB
        BuildInputs["buildinputs<br/>(Go CLI)<br/>Dockerfile static analysis"]
        Sandbox["sandbox.py<br/>(Python)<br/>Build isolation wrapper"]
        MatrixGen["gen_gha_matrix_jobs.py<br/>CI matrix generation"]
        MatrixGen -->|generates| GHA["GitHub Actions<br/>CI/CD"]
        GHA -->|uses| Sandbox
        Sandbox -->|uses| BuildInputs
    end

    subgraph TektonPipelines["Konflux / Tekton"]
        Tekton["Multi-arch<br/>Build Pipelines"]
    end

    subgraph BaseLayer["Shared Base Layer"]
        UBI9["UBI9 Python<br/>(3.11 / 3.12)"]
        UBI9 -->|+ micropipenv<br/>+ oc CLI<br/>+ skopeo| BaseStage["Base Stage"]
    end

    subgraph JupyterImages["Jupyter Workbenches"]
        direction TB
        JupyterMinimal["Jupyter Minimal<br/>Port: 8888/TCP"]
        JupyterDS["Jupyter Data Science<br/>+ pandas, scikit-learn<br/>+ MongoDB CLI, MSSQL<br/>+ Elyra"]
        JupyterPyTorch["Jupyter PyTorch<br/>+ CUDA 12.6.3"]
        JupyterTF["Jupyter TensorFlow<br/>+ CUDA 12.6.3"]
        JupyterTrustyAI["Jupyter TrustyAI<br/>+ Java 17"]
        JupyterMinimal --> JupyterDS
        JupyterMinimal --> JupyterPyTorch
        JupyterMinimal --> JupyterTF
        JupyterMinimal --> JupyterTrustyAI
    end

    subgraph AlternateWorkbenches["Alternate Workbenches"]
        direction TB
        CodeServer["CodeServer<br/>code-server v4.98.0<br/>+ NGINX proxy<br/>Port: 8787/TCP"]
        RStudio["RStudio Server<br/>R 4.4.3<br/>+ NGINX proxy<br/>Port: 8787/TCP"]
    end

    subgraph RuntimeImages["Elyra Pipeline Runtimes"]
        direction TB
        RuntimeMinimal["Runtime Minimal"]
        RuntimeDS["Runtime Data Science"]
        RuntimePyTorchCUDA["Runtime PyTorch<br/>(CUDA)"]
        RuntimeTFCUDA["Runtime TensorFlow<br/>(CUDA)"]
        RuntimeROCmPT["Runtime ROCm<br/>PyTorch"]
        RuntimeROCmTF["Runtime ROCm<br/>TensorFlow"]
    end

    subgraph Manifests["Deployment Artifacts"]
        direction TB
        KustomizeBase["Kustomize Base<br/>manifests/base/<br/>18 ImageStreams (Py3.11)"]
        KustomizeOverlay["Kustomize Overlay<br/>manifests/overlays/additional/<br/>15 ImageStreams (Py3.12)"]
        ParamsEnv["params.env<br/>SHA256 digest-pinned<br/>image references"]
    end

    %% Build flows
    BaseStage --> JupyterMinimal
    BaseStage --> CodeServer
    BaseStage --> RStudio
    BaseStage --> RuntimeMinimal

    GHA -->|builds| JupyterImages
    GHA -->|builds| AlternateWorkbenches
    GHA -->|builds| RuntimeImages
    Tekton -->|multi-arch builds| JupyterImages
    Tekton -->|multi-arch builds| AlternateWorkbenches
    Tekton -->|multi-arch builds| RuntimeImages

    %% Output
    JupyterImages -->|publish| Quay["quay.io/modh/*<br/>quay.io/opendatahub/*"]
    AlternateWorkbenches -->|publish| Quay
    RuntimeImages -->|publish| Quay
    Quay -->|referenced by| ParamsEnv

    %% Platform consumers
    NotebookController["ODH Notebook Controller"]
    Dashboard["odh-dashboard"]
    KustomizeBase -->|ImageStreams| NotebookController
    KustomizeOverlay -->|ImageStreams| NotebookController
    KustomizeBase -->|annotations| Dashboard

    %% Styling
    style BuildInputs fill:#9b59b6,color:#fff
    style Sandbox fill:#9b59b6,color:#fff
    style MatrixGen fill:#9b59b6,color:#fff
    style GHA fill:#8e44ad,color:#fff
    style Tekton fill:#8e44ad,color:#fff
    style UBI9 fill:#cc0000,color:#fff
    style BaseStage fill:#cc0000,color:#fff
    style JupyterMinimal fill:#4a90e2,color:#fff
    style JupyterDS fill:#4a90e2,color:#fff
    style JupyterPyTorch fill:#4a90e2,color:#fff
    style JupyterTF fill:#4a90e2,color:#fff
    style JupyterTrustyAI fill:#4a90e2,color:#fff
    style CodeServer fill:#2ecc71,color:#fff
    style RStudio fill:#2ecc71,color:#fff
    style RuntimeMinimal fill:#f5a623,color:#fff
    style RuntimeDS fill:#f5a623,color:#fff
    style RuntimePyTorchCUDA fill:#f5a623,color:#fff
    style RuntimeTFCUDA fill:#f5a623,color:#fff
    style RuntimeROCmPT fill:#f5a623,color:#fff
    style RuntimeROCmTF fill:#f5a623,color:#fff
    style KustomizeBase fill:#34495e,color:#fff
    style KustomizeOverlay fill:#34495e,color:#fff
    style ParamsEnv fill:#34495e,color:#fff
    style Quay fill:#e74c3c,color:#fff
    style NotebookController fill:#7ed321
    style Dashboard fill:#7ed321
