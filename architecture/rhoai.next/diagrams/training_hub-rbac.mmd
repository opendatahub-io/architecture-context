graph TD
    subgraph LibraryContext["Training Hub - Library Context (No K8s RBAC)"]
        direction TB
        Note["Training Hub is a Python library, not a<br/>Kubernetes controller. It has no ClusterRoles,<br/>Roles, or ServiceAccounts of its own."]
    end

    subgraph RuntimeRBAC["Runtime RBAC (Inherited from Caller)"]
        direction TB

        subgraph KubeflowPod["When Running in Kubeflow Training Pod"]
            PodSA["Pod ServiceAccount<br/>(configured by Kubeflow)"]
            PodNS["Namespace Scope<br/>(user's namespace)"]
            PodSA -->|"inherits"| PodNS
        end

        subgraph NotebookSession["When Running in RHOAI Notebook"]
            NotebookSA["Notebook ServiceAccount<br/>(configured by ODH/RHOAI)"]
            NotebookNS["Namespace Scope<br/>(user's namespace)"]
            NotebookSA -->|"inherits"| NotebookNS
        end
    end

    subgraph Secrets["Secrets / Credentials"]
        direction TB
        OpenAIKey["OPENAI_API_KEY<br/>Type: env var<br/>Purpose: GEPA LLM API auth<br/>Provisioned by: runtime env<br/>Auto-rotate: No"]
        WandBKey["WANDB_API_KEY<br/>Type: env var<br/>Purpose: W&B experiment tracking<br/>Provisioned by: runtime env<br/>Auto-rotate: No"]
        MLflowURI["MLFLOW_TRACKING_URI<br/>Type: env var<br/>Purpose: MLflow connection<br/>May contain credentials<br/>Auto-rotate: No"]
        HFToken["HF_TOKEN<br/>Type: env var (optional)<br/>Purpose: Gated model downloads<br/>Auto-rotate: No"]
    end

    subgraph TrustBoundaries["Trust Boundaries"]
        direction TB
        YAMLTrust["YAML Config Trust Boundary<br/>_resolve_dotted_path() in cli.py:386-434<br/>Can import arbitrary modules<br/>Risk: Code execution via config"]
        SupplyChain["Supply Chain Boundary<br/>litellm !=1.82.7,!=1.82.8<br/>TeamPCP credential harvesting<br/>Mitigation: Version exclusion"]
    end

    LibraryContext -.->|"deploys into"| RuntimeRBAC
    RuntimeRBAC -.->|"accesses"| Secrets
    Secrets -.->|"constrained by"| TrustBoundaries

    style Note fill:#e8e8e8,stroke:#999
    style PodSA fill:#4a90e2,color:#fff
    style NotebookSA fill:#4a90e2,color:#fff
    style OpenAIKey fill:#f5a623,color:#fff
    style WandBKey fill:#f5a623,color:#fff
    style MLflowURI fill:#f5a623,color:#fff
    style HFToken fill:#f5a623,color:#fff
    style YAMLTrust fill:#f8cecc,stroke:#b85450
    style SupplyChain fill:#f8cecc,stroke:#b85450
