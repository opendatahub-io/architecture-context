graph TD
    subgraph SA["Service Account"]
        NotebookSA["(notebook service account)<br/>User-managed SA<br/>Namespace: user namespace"]
    end

    subgraph Binding["Role Bindings"]
        RB["(user-managed)<br/>RoleBinding<br/>Namespace: user namespace"]
    end

    subgraph Role["Required Role Permissions"]
        UserRole["(user-provided)<br/>Role or ClusterRole"]
    end

    subgraph RayResources["ray.io API Group"]
        RayClusters["ray.io<br/>rayclusters"]
    end

    subgraph CFResources["workload.codeflare.dev API Group"]
        AppWrappers["workload.codeflare.dev<br/>appwrappers"]
    end

    subgraph KueueResources["kueue.x-k8s.io API Group"]
        LocalQueues["kueue.x-k8s.io<br/>localqueues"]
    end

    subgraph OSResources["route.openshift.io API Group"]
        Routes["route.openshift.io<br/>routes"]
    end

    subgraph CoreResources["Core API Group"]
        Secrets["core<br/>secrets"]
        Namespaces["core<br/>namespaces"]
    end

    subgraph NetworkResources["networking.k8s.io API Group"]
        Ingresses["networking.k8s.io<br/>ingresses"]
    end

    %% Bindings
    NotebookSA -->|"bound via"| RB
    RB -->|"grants"| UserRole

    %% Permissions
    UserRole -->|"get, list, create, delete"| RayClusters
    UserRole -->|"get, list, create, delete"| AppWrappers
    UserRole -->|"get, list"| LocalQueues
    UserRole -->|"get, list"| Routes
    UserRole -->|"get, list"| Secrets
    UserRole -->|"get"| Namespaces
    UserRole -->|"get, list"| Ingresses

    %% Secrets Access Detail
    subgraph SecretDetail["Secrets Accessed"]
        CASSecret["{cluster-name}-ca-secret-{suffix}<br/>Type: Opaque<br/>Keys: ca.crt, ca.key<br/>Purpose: Ray TLS CA cert/key<br/>Provisioned by: KubeRay operator<br/>Auto-Rotate: No"]
    end

    Secrets -.->|"includes"| CASSecret

    %% Styling
    style NotebookSA fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#b8d4e3,stroke:#333
    style UserRole fill:#f5a623,stroke:#333
    style RayClusters fill:#7ed321,stroke:#333
    style AppWrappers fill:#7ed321,stroke:#333
    style LocalQueues fill:#7ed321,stroke:#333
    style Routes fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style Ingresses fill:#7ed321,stroke:#333
    style CASSecret fill:#f8cecc,stroke:#b85450
