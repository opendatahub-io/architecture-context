graph TD
    subgraph "Authentication Methods"
        AuthKit["kube-authkit<br/>(auto-detect)"]
        OIDC["OIDC Token"]
        OAuth["OpenShift OAuth"]
        BearerToken["Bearer Token"]
        KubeConfig["kubeconfig"]
        LegacyToken["TokenAuthentication<br/>(deprecated)"]
        LegacyKube["KubeConfigFileAuthentication<br/>(deprecated)"]
    end

    subgraph "User Identity"
        User["Authenticated User<br/>(Data Scientist)"]
    end

    AuthKit --> User
    OIDC --> User
    OAuth --> User
    BearerToken --> User
    KubeConfig --> User
    LegacyToken -.->|deprecated| User
    LegacyKube -.->|deprecated| User

    subgraph "Required RBAC Permissions"
        direction TB

        subgraph RayIO["API Group: ray.io"]
            RayClusters["rayclusters<br/>get, list, create, patch, delete"]
            RayJobs["rayjobs<br/>get, list, create, patch, delete"]
        end

        subgraph KueueIO["API Group: kueue.x-k8s.io"]
            LocalQueues["localqueues<br/>list"]
            Workloads["workloads<br/>list"]
            PriorityClasses["workloadpriorityclasses<br/>get"]
        end

        subgraph CoreAPI["API Group: core ('')"]
            Secrets["secrets<br/>get, list, create, update"]
        end

        subgraph RouteAPI["API Group: route.openshift.io"]
            Routes["routes<br/>list"]
        end

        subgraph GatewayNetAPI["API Group: gateway.networking.k8s.io"]
            HTTPRoutes["httproutes<br/>get, list"]
            Gateways["gateways<br/>get, list"]
        end

        subgraph PlatformAPI["API Group: services.platform.opendatahub.io"]
            GatewayConfigs["gatewayconfigs<br/>get"]
        end

        subgraph NetworkAPI["API Group: networking.k8s.io"]
            Ingresses["ingresses<br/>list"]
        end
    end

    User -->|"operates with<br/>user's own permissions"| RayClusters
    User --> RayJobs
    User --> LocalQueues
    User --> Workloads
    User --> PriorityClasses
    User --> Secrets
    User --> Routes
    User --> HTTPRoutes
    User --> Gateways
    User --> GatewayConfigs
    User --> Ingresses

    subgraph "Secrets Accessed"
        CASecret["{cluster}-ca-secret-{suffix}<br/>Type: Opaque<br/>CA cert + key<br/>Provisioned by: KubeRay"]
        FileSecret["{rayjob}-files<br/>Type: Opaque<br/>Scripts + working_dir<br/>Created by: SDK<br/>ownerRef cleanup"]
    end

    Secrets -->|read| CASecret
    Secrets -->|create/update| FileSecret

    subgraph "Network Auth"
        K8sAPIAuth["Kubernetes API<br/>6443/TCP HTTPS<br/>Auth: kube-authkit"]
        RayHeadAuth["Ray Head<br/>10001/TCP<br/>Auth: mTLS client cert<br/>(SDK-generated)"]
        DashboardAuth["Ray Dashboard<br/>8265/TCP HTTPS<br/>Auth: Bearer Token<br/>(OpenShift OAuth proxy)"]
    end

    User -->|authenticates| K8sAPIAuth
    User -->|mTLS| RayHeadAuth
    User -->|bearer token| DashboardAuth

    %% Styling
    style User fill:#4a90e2,stroke:#333,color:#fff
    style AuthKit fill:#7ed321,stroke:#333,color:#fff
    style OIDC fill:#e8e8e8,stroke:#333
    style OAuth fill:#e8e8e8,stroke:#333
    style BearerToken fill:#e8e8e8,stroke:#333
    style KubeConfig fill:#e8e8e8,stroke:#333
    style LegacyToken fill:#ffcccc,stroke:#cc0000
    style LegacyKube fill:#ffcccc,stroke:#cc0000

    style RayClusters fill:#f5a623,stroke:#333
    style RayJobs fill:#f5a623,stroke:#333
    style LocalQueues fill:#f5a623,stroke:#333
    style Workloads fill:#f5a623,stroke:#333
    style PriorityClasses fill:#f5a623,stroke:#333
    style Secrets fill:#f5a623,stroke:#333
    style Routes fill:#f5a623,stroke:#333
    style HTTPRoutes fill:#f5a623,stroke:#333
    style Gateways fill:#f5a623,stroke:#333
    style GatewayConfigs fill:#f5a623,stroke:#333
    style Ingresses fill:#f5a623,stroke:#333

    style CASecret fill:#fce4ec,stroke:#b71c1c
    style FileSecret fill:#fce4ec,stroke:#b71c1c

    style K8sAPIAuth fill:#d5e8d4,stroke:#82b366
    style RayHeadAuth fill:#d5e8d4,stroke:#82b366
    style DashboardAuth fill:#d5e8d4,stroke:#82b366
