graph TD
    subgraph "SDK User Identity"
        User["SDK User<br/>(via kube-authkit)"]
    end

    subgraph "Authentication Methods"
        OIDC["OIDC Token"]
        OAuth["OpenShift OAuth"]
        Kubeconfig["kubeconfig"]
        InCluster["In-Cluster SA"]
    end

    User -->|"auto-detect"| OIDC
    User -->|"auto-detect"| OAuth
    User -->|"auto-detect"| Kubeconfig
    User -->|"auto-detect"| InCluster

    subgraph "Required RBAC Permissions"
        RayRole["ray.io API Group"]
        KueueRole["kueue.x-k8s.io API Group"]
        CoreSecretsRole["core - Secrets"]
        CoreCMRole["core - ConfigMaps"]
        RouteRole["route.openshift.io API Group"]
        GatewayRole["gateway.networking.k8s.io API Group"]
    end

    OIDC -->|"binds to"| RayRole
    OIDC -->|"binds to"| KueueRole
    OIDC -->|"binds to"| CoreSecretsRole
    OIDC -->|"binds to"| CoreCMRole
    OIDC -->|"binds to"| RouteRole
    OIDC -->|"binds to"| GatewayRole

    subgraph "ray.io Resources"
        RayClusters["rayclusters"]
        RayJobs["rayjobs"]
    end

    subgraph "kueue.x-k8s.io Resources"
        LocalQueues["localqueues"]
        WPC["workloadpriorityclasses"]
    end

    subgraph "Core Resources"
        Secrets["secrets"]
        ConfigMaps["configmaps"]
    end

    subgraph "Ingress Discovery Resources"
        Routes["routes"]
        HTTPRoutes["httproutes"]
        Gateways["gateways"]
    end

    RayRole -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| RayClusters
    RayRole -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| RayJobs

    KueueRole -->|"get, list"| LocalQueues
    KueueRole -->|"get, list"| WPC

    CoreSecretsRole -->|"get, list"| Secrets
    CoreCMRole -->|"get, list, create,<br/>update, patch"| ConfigMaps

    RouteRole -->|"get, list"| Routes
    GatewayRole -->|"get, list"| HTTPRoutes
    GatewayRole -->|"get, list"| Gateways

