graph TB
    subgraph SparkOperator["Spark Operator (spark-operator binary)"]
        direction TB

        subgraph ControllerPlane["Controller Deployment"]
            Controller["spark-operator controller<br/>Go Operator (controller-runtime)<br/>Port: 8080/TCP metrics, 8081/TCP probes"]
            SAController["SparkApplication Controller<br/>17-state state machine"]
            SSAController["ScheduledSparkApplication Controller<br/>Cron-based scheduling"]
            SCController["SparkConnect Controller<br/>gRPC server provisioning"]
            CertController["Certificate Controller<br/>Self-signed cert rotation"]
            Controller --> SAController
            Controller --> SSAController
            Controller --> SCController
            Controller --> CertController
        end

        subgraph WebhookPlane["Webhook Deployment"]
            Webhook["spark-operator webhook<br/>Port: 9443/TCP (TLS)"]
            MutatingWH["Mutating Webhooks<br/>Pod, SparkApp, ScheduledSparkApp, SparkConnect"]
            ValidatingWH["Validating Webhooks<br/>SparkApp, ScheduledSparkApp, SparkConnect"]
            Webhook --> MutatingWH
            Webhook --> ValidatingWH
        end
    end

    subgraph ModuleController["Spark Operator Module"]
        Module["spark-operator-module<br/>ODH Platform Module Controller<br/>Manages SparkOperatorModule CRD"]
    end

    %% CRDs
    SparkAppCR["SparkApplication CR<br/>sparkoperator.k8s.io/v1beta2"]
    ScheduledCR["ScheduledSparkApplication CR<br/>sparkoperator.k8s.io/v1beta2"]
    SparkConnectCR["SparkConnect CR<br/>sparkoperator.k8s.io/v1alpha1"]

    %% Managed Resources
    DriverPod["Driver Pod<br/>spark-submit execution"]
    ExecutorPods["Executor Pods<br/>Spark workers"]
    DriverSvc["Driver Service<br/>4040/TCP Spark UI"]
    Ingress["Ingress<br/>Optional external UI access"]
    PDB["PodDisruptionBudget<br/>Driver protection"]
    MonitoringCM["Monitoring ConfigMap<br/>JMX exporter config"]
    NetworkPol["NetworkPolicy<br/>RHOAI only"]
    ConnectSvc["SparkConnect Service<br/>15002/TCP gRPC"]

    %% User interaction
    User["User / Data Scientist"] -->|"kubectl create"| SparkAppCR
    User -->|"kubectl create"| ScheduledCR
    User -->|"kubectl create"| SparkConnectCR

    %% Controller watches
    SparkAppCR -->|"watched by"| SAController
    ScheduledCR -->|"watched by"| SSAController
    SparkConnectCR -->|"watched by"| SCController

    %% Controller creates
    SAController -->|"creates"| DriverPod
    SAController -->|"creates"| DriverSvc
    SAController -->|"creates"| Ingress
    SAController -->|"creates"| PDB
    SAController -->|"creates"| MonitoringCM
    SAController -->|"creates"| NetworkPol
    DriverPod -->|"spawns"| ExecutorPods
    SCController -->|"creates"| ConnectSvc

    %% Webhook intercepts
    SparkAppCR -.->|"admission"| Webhook
    ScheduledCR -.->|"admission"| Webhook
    SparkConnectCR -.->|"admission"| Webhook
    DriverPod -.->|"pod mutation"| MutatingWH

    %% External dependencies
    K8sAPI["Kubernetes API Server"]
    Controller -->|"reconciles via"| K8sAPI
    Webhook -->|"ResourceQuota check"| K8sAPI

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style Module fill:#4a90e2,color:#fff
    style SparkAppCR fill:#f5a623,color:#fff
    style ScheduledCR fill:#f5a623,color:#fff
    style SparkConnectCR fill:#f5a623,color:#fff
    style DriverPod fill:#7ed321,color:#fff
    style ExecutorPods fill:#7ed321,color:#fff
    style DriverSvc fill:#b8e986
    style ConnectSvc fill:#b8e986
    style Ingress fill:#b8e986
    style PDB fill:#b8e986
    style MonitoringCM fill:#b8e986
    style NetworkPol fill:#b8e986
    style K8sAPI fill:#e8e8e8
    style User fill:#d0d0d0
