graph TB
    subgraph SparkOperatorPlatform["Spark Operator Platform Layer"]
        ModuleController["spark-operator-module-controller<br/>Go Controller<br/>Port: 8081/TCP (health)"]
    end

    subgraph SparkOperatorWorkload["Spark Operator Workload Layer"]
        Controller["spark-operator-controller<br/>Go Controller<br/>Ports: 8080/TCP (metrics), 8081/TCP (health)"]
        Webhook["spark-operator-webhook<br/>Go Webhook Server<br/>Port: 9443/TCP (HTTPS)"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        SparkAppCR["SparkApplication<br/>(sparkoperator.k8s.io/v1beta2)<br/>Namespaced"]
        ScheduledCR["ScheduledSparkApplication<br/>(sparkoperator.k8s.io/v1beta2)<br/>Namespaced"]
        ConnectCR["SparkConnect<br/>(sparkoperator.k8s.io/v1alpha1)<br/>Namespaced"]
        PlatformCR["SparkOperator<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    end

    subgraph SparkWorkloads["Spark Workloads"]
        Driver["Driver Pod"]
        Executors["Executor Pods"]
        ConnectServer["Spark Connect Server<br/>Port: 15002/TCP (gRPC)"]
    end

    User["User / Pipeline"] -->|creates| SparkAppCR
    User -->|creates| ScheduledCR
    User -->|creates| ConnectCR

    ODHOperator["ODH/RHOAI Operator"] -->|creates| PlatformCR
    PlatformCR -->|watched by| ModuleController
    ModuleController -->|manages lifecycle| Controller
    ModuleController -->|manages lifecycle| Webhook

    SparkAppCR -->|watched by| Controller
    ScheduledCR -->|watched by| Controller
    ConnectCR -->|watched by| Controller

    SparkAppCR -->|validated/mutated by| Webhook
    ScheduledCR -->|validated/mutated by| Webhook
    ConnectCR -->|validated/mutated by| Webhook

    Controller -->|creates| Driver
    Controller -->|creates| ConnectServer
    Driver -->|creates| Executors
    Driver -->|"7078/TCP (driver-rpc)"| Executors

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|depends on| CertManager["cert-manager<br/>(optional)"]
    Controller -->|integrates| PrometheusOp["prometheus-operator<br/>(PodMonitor)"]

    Webhook -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer<br/>(config.openshift.io)"]

    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style ModuleController fill:#4a90e2,color:#fff
    style SparkAppCR fill:#f5a623,color:#fff
    style ScheduledCR fill:#f5a623,color:#fff
    style ConnectCR fill:#f5a623,color:#fff
    style PlatformCR fill:#f5a623,color:#fff
    style Driver fill:#7ed321,color:#fff
    style Executors fill:#7ed321,color:#fff
    style ConnectServer fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8
    style CertManager fill:#e8e8e8
    style PrometheusOp fill:#e8e8e8
    style OpenShiftAPI fill:#e8e8e8
    style ODHOperator fill:#999,color:#fff
