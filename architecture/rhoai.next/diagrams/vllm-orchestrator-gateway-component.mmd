graph TB
    subgraph "vllm-orchestrator-gateway (Rust Service)"
        direction TB
        ConfigLoader["Config Loader<br/>(YAML)"]
        Router["Axum Router<br/>(Dynamic Routes)"]
        RequestHandler["Request Handler<br/>(Stream/Non-Stream)"]
        MTLSClient["mTLS Client Builder<br/>(OpenSSL + native-tls)"]
        FallbackEngine["Fallback Response Engine"]

        ConfigLoader -->|"builds routes"| Router
        Router -->|"dispatches"| RequestHandler
        RequestHandler -->|"uses"| MTLSClient
        RequestHandler -->|"applies"| FallbackEngine
    end

    Client[External Client] -->|"POST /{route}/v1/chat/completions<br/>8090/TCP HTTP"| Router

    subgraph "Configuration"
        ConfigFile["config.yaml<br/>(GATEWAY_CONFIG env)"]
        TLSCerts["TLS Certificates<br/>(/etc/tls/private/)"]
        CACert["CA Bundle<br/>(/etc/tls/ca/service-ca.crt)"]
    end

    ConfigFile -->|"loaded at startup"| ConfigLoader
    TLSCerts -->|"PKCS#12 identity"| MTLSClient
    CACert -->|"server validation"| MTLSClient

    RequestHandler -->|"POST /api/v2/chat/completions-detection<br/>HTTP/HTTPS (optional mTLS)"| Orchestrator["FMS Guardrails Orchestrator<br/>Port 8085"]

    Orchestrator -->|"delegates"| Detectors["Content Detectors<br/>(PII, Toxicity, Regex)"]
    Orchestrator -->|"inference"| vLLM["vLLM Inference Server"]

    style ConfigLoader fill:#4a90e2,color:#fff
    style Router fill:#4a90e2,color:#fff
    style RequestHandler fill:#4a90e2,color:#fff
    style MTLSClient fill:#4a90e2,color:#fff
    style FallbackEngine fill:#4a90e2,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Orchestrator fill:#7ed321,color:#fff
    style Detectors fill:#7ed321,color:#fff
    style vLLM fill:#7ed321,color:#fff
    style ConfigFile fill:#f5a623,color:#fff
    style TLSCerts fill:#f5a623,color:#fff
    style CACert fill:#f5a623,color:#fff
