graph TB
    subgraph "vLLM Orchestrator Gateway (Rust/axum)"
        Gateway["vllm-orchestrator-gateway<br/>8090/TCP HTTP<br/>Rust Service (axum)"]
        ConfigLoader["Config Loader<br/>(serde_yml)"]
        RouteHandler["Route Handler<br/>/{route_name}/v1/chat/completions"]
        DetectorInjector["Detector Injector<br/>Injects detector specs per route"]
        StreamHandler["SSE Stream Handler<br/>Streaming response processor"]
        FallbackHandler["Fallback Handler<br/>Replaces detected content"]
        TLSManager["TLS/mTLS Manager<br/>(openssl + native-tls)"]

        ConfigLoader -->|"loads routes<br/>from config.yaml"| RouteHandler
        RouteHandler -->|"injects detectors"| DetectorInjector
        DetectorInjector -->|"forwards request"| Gateway
        Gateway -->|"streaming path"| StreamHandler
        Gateway -->|"non-streaming path"| FallbackHandler
        StreamHandler -->|"checks detections"| FallbackHandler
        TLSManager -->|"optional mTLS identity"| Gateway
    end

    Client["Client<br/>(AI Application)"] -->|"POST /{route}/v1/chat/completions<br/>8090/TCP HTTP<br/>Authorization header"| RouteHandler

    Gateway -->|"POST /api/v2/chat/completions-detection<br/>8085/TCP HTTP/HTTPS<br/>Optional mTLS"| Orchestrator["FMS Guardrails<br/>Orchestrator"]

    Orchestrator -->|"calls detectors"| Detectors["Detector Services<br/>(e.g., guardrails-regex-detector)"]
    Orchestrator -->|"LLM inference"| vLLM["vLLM Model Server"]

    TLSCerts["/etc/tls/private/<br/>tls.crt + tls.key"] -.->|"client identity"| TLSManager
    CACert["/etc/tls/ca/<br/>service-ca.crt"] -.->|"CA trust"| TLSManager

    style Gateway fill:#4a90e2,stroke:#333,color:#fff
    style ConfigLoader fill:#4a90e2,stroke:#333,color:#fff
    style RouteHandler fill:#4a90e2,stroke:#333,color:#fff
    style DetectorInjector fill:#4a90e2,stroke:#333,color:#fff
    style StreamHandler fill:#4a90e2,stroke:#333,color:#fff
    style FallbackHandler fill:#4a90e2,stroke:#333,color:#fff
    style TLSManager fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style Detectors fill:#e8e8e8,stroke:#333
    style vLLM fill:#e8e8e8,stroke:#333
    style TLSCerts fill:#fff2cc,stroke:#d6b656
    style CACert fill:#fff2cc,stroke:#d6b656
