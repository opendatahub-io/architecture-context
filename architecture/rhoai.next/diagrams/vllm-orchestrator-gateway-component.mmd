graph TB
    subgraph External["External Clients"]
        Client[Client Application]
    end

    subgraph Gateway["vllm-orchestrator-gateway (Rust/axum)"]
        direction TB
        Router["axum Router<br/>Dynamic Route Generation"]
        ConfigLoader["Config Loader<br/>(serde_yml)"]
        StreamHandler["SSE Stream Handler<br/>(futures/tokio)"]
        NonStreamHandler["Non-Streaming Handler"]
        DetectorInjector["Detector Config Injector<br/>Injects input/output detectors<br/>into request payload"]
        FallbackHandler["Fallback Message Handler<br/>Replaces response on detection"]
        TLSClient["mTLS Client Builder<br/>(openssl + native-tls)"]

        ConfigLoader -->|generates routes| Router
        Router -->|stream=false| NonStreamHandler
        Router -->|stream=true| StreamHandler
        NonStreamHandler --> DetectorInjector
        StreamHandler --> DetectorInjector
        DetectorInjector -->|sends via| TLSClient
        NonStreamHandler --> FallbackHandler
        StreamHandler --> FallbackHandler
    end

    subgraph OrchestratorStack["TrustyAI Ecosystem"]
        Orchestrator["FMS Guardrails<br/>Orchestrator<br/>8085/TCP"]
        Detectors["Detector Services<br/>(e.g., guardrails-regex-detector)"]
        vLLM["vLLM Inference Server"]
        Orchestrator -->|dispatches to| Detectors
        Orchestrator -->|inference calls| vLLM
    end

    subgraph CertProviders["OpenShift Certificate Infrastructure"]
        CertSigner["service-serving-cert-signer<br/>/etc/tls/private/"]
        CAOperator["service-ca-operator<br/>/etc/tls/ca/service-ca.crt"]
    end

    Client -->|"POST /{route}/v1/chat/completions<br/>8090/TCP HTTP"| Router
    TLSClient -->|"POST /api/v2/chat/completions-detection<br/>HTTP or HTTPS (mTLS)"| Orchestrator
    FallbackHandler -->|"Response (JSON or SSE)"| Client

    CertSigner -.->|provisions client cert| TLSClient
    CAOperator -.->|provisions CA cert| TLSClient

    style Gateway fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Router fill:#5ba0f2,stroke:#333,color:#fff
    style ConfigLoader fill:#5ba0f2,stroke:#333,color:#fff
    style StreamHandler fill:#5ba0f2,stroke:#333,color:#fff
    style NonStreamHandler fill:#5ba0f2,stroke:#333,color:#fff
    style DetectorInjector fill:#5ba0f2,stroke:#333,color:#fff
    style FallbackHandler fill:#5ba0f2,stroke:#333,color:#fff
    style TLSClient fill:#5ba0f2,stroke:#333,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Detectors fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style CertSigner fill:#e8e8e8,stroke:#999
    style CAOperator fill:#e8e8e8,stroke:#999
