graph TD
    subgraph Note["RBAC Model"]
        direction TB
        Info["This component does NOT define its own RBAC resources.<br/>RBAC is managed by KServe and the platform operator.<br/>Service accounts are configured per-InferenceService deployment."]
    end

    subgraph KServeManagedRBAC["KServe-Managed RBAC (per InferenceService)"]
        direction TB

        subgraph ServiceAccounts["Service Accounts"]
            ISvcSA["per-InferenceService SA<br/>(auto-created by KServe)"]
        end

        subgraph PlatformSAs["Platform Service Accounts"]
            KServeSA["KServe Controller<br/>kserve-controller-manager"]
            IstioSA["Istio Sidecar<br/>istio-proxy"]
        end
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        direction TB

        subgraph IstioAuth["Istio Service Mesh Auth"]
            PeerAuth["PeerAuthentication<br/>Mode: STRICT<br/>(namespace-scoped)"]
            PeerAuthMetrics["PeerAuthentication<br/>Mode: PERMISSIVE<br/>(port 8086 only)"]
        end

        subgraph NetworkPolicies["Network Policies"]
            NP_UWM["NetworkPolicy<br/>Allow ingress from<br/>openshift-user-workload-monitoring<br/>on port 8086/TCP"]
        end
    end

    subgraph Secrets["Secrets"]
        direction TB
        MinioSecret["minio-secret<br/>Type: Opaque<br/>Purpose: S3 access credentials<br/>Provisioned: Manual / Platform Operator<br/>Auto-Rotate: No"]
        GitAuth["git-auth<br/>Type: Opaque<br/>Purpose: Git credentials (Konflux)<br/>Provisioned: Pipelines-as-Code<br/>Auto-Rotate: No"]
    end

    subgraph Endpoints["Protected Endpoints"]
        direction TB
        HTTPEndpoint["/api/v1/task/*<br/>HTTP/8080<br/>Auth: Istio mTLS + PeerAuth"]
        GRPCEndpoint["gRPC Services<br/>gRPC/8085<br/>Auth: Istio mTLS + PeerAuth"]
        MetricsEndpoint["Metrics<br/>HTTP/8086<br/>Auth: None (PERMISSIVE mTLS)"]
        ExternalEndpoint["Knative External<br/>HTTPS/443<br/>Auth: TLS passthrough"]
    end

    %% Relationships
    ISvcSA -->|"runs"| HTTPEndpoint
    ISvcSA -->|"runs"| GRPCEndpoint
    ISvcSA -->|"runs"| MetricsEndpoint
    KServeSA -->|"manages lifecycle"| ISvcSA
    IstioSA -->|"enforces"| PeerAuth
    IstioSA -->|"enforces"| PeerAuthMetrics
    PeerAuth -->|"protects"| HTTPEndpoint
    PeerAuth -->|"protects"| GRPCEndpoint
    PeerAuthMetrics -->|"allows scraping"| MetricsEndpoint
    NP_UWM -->|"allows ingress"| MetricsEndpoint
    MinioSecret -->|"provides credentials"| ISvcSA

    %% Styling
    style Info fill:#fff3cd,stroke:#856404,color:#856404
    style ISvcSA fill:#4a90e2,stroke:#333,color:#fff
    style KServeSA fill:#7ed321,stroke:#333,color:#fff
    style IstioSA fill:#7ed321,stroke:#333,color:#fff
    style PeerAuth fill:#d5e8d4,stroke:#82b366
    style PeerAuthMetrics fill:#ffe6cc,stroke:#d79b00
    style NP_UWM fill:#d5e8d4,stroke:#82b366
    style MinioSecret fill:#f8cecc,stroke:#b85450
    style GitAuth fill:#f8cecc,stroke:#b85450
    style HTTPEndpoint fill:#dae8fc,stroke:#6c8ebf
    style GRPCEndpoint fill:#dae8fc,stroke:#6c8ebf
    style MetricsEndpoint fill:#dae8fc,stroke:#6c8ebf
    style ExternalEndpoint fill:#dae8fc,stroke:#6c8ebf
