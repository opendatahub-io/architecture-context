graph TD
    subgraph Legend["Legend"]
        direction LR
        LegNote["This component does NOT define its own RBAC.<br/>RBAC is managed by KServe and rhods-operator.<br/>Diagram shows the surrounding RBAC context."]
    end

    subgraph PlatformRBAC["Platform-Managed RBAC (KServe / rhods-operator)"]
        direction TB

        subgraph ServiceAccounts["Service Accounts"]
            PodSA["Pod ServiceAccount<br/>(isvc-name-sa)<br/>Namespace: user-ns"]
        end

        subgraph AuthNPolicies["Authentication Policies (Istio)"]
            PA_Strict["PeerAuthentication<br/>Mode: STRICT<br/>Scope: Namespace<br/>Ports: 8080, 8085"]
            PA_Permissive["PeerAuthentication<br/>Mode: PERMISSIVE<br/>Port: 8086 (metrics only)"]
        end
    end

    subgraph PodSecurity["Pod Security Context"]
        direction TB
        Container1["transformer-container<br/>(caikit-tgis-serving)<br/>Non-root, UBI 9"]
        Container2["kserve-container<br/>(TGIS)<br/>Non-root"]
        InitCont["init-container<br/>(storage-initializer)<br/>Accesses S3/PVC via SA"]
    end

    subgraph Secrets["Secrets (User-Provisioned)"]
        StorageCreds["(storage credentials)<br/>Type: Opaque<br/>Purpose: S3/MinIO access<br/>Provisioned by: User / KServe<br/>Auto-rotate: No"]
    end

    subgraph ExternalEnforcement["External Enforcement Points"]
        IstioSidecar["Istio Sidecar Proxy<br/>Enforces mTLS<br/>Validates PeerAuthentication"]
        KubeRBACProxy["kube-rbac-proxy<br/>(RHOAI 3.x alternative)<br/>Enforces OAuth"]
    end

    %% Relationships
    PodSA -->|"runs as"| Container1
    PodSA -->|"runs as"| Container2
    PodSA -->|"runs as"| InitCont
    PodSA -->|"annotated with"| StorageCreds

    PA_Strict -->|"enforced by"| IstioSidecar
    PA_Permissive -->|"allows"| Prometheus["Prometheus<br/>Scrapes :8086"]

    IstioSidecar -->|"protects"| Container1
    KubeRBACProxy -.->|"alternative to<br/>Istio sidecar"| Container1

    InitCont -->|"uses credentials"| StorageCreds

    %% Styling
    style LegNote fill:#fff3cd,stroke:#856404,color:#856404
    style PodSA fill:#4a90e2,stroke:#333,color:#fff
    style PA_Strict fill:#f5a623,stroke:#333
    style PA_Permissive fill:#f5a623,stroke:#333
    style Container1 fill:#dae8fc,stroke:#6c8ebf
    style Container2 fill:#dae8fc,stroke:#6c8ebf
    style InitCont fill:#dae8fc,stroke:#6c8ebf
    style StorageCreds fill:#f8cecc,stroke:#b85450
    style IstioSidecar fill:#d5e8d4,stroke:#82b366
    style KubeRBACProxy fill:#d5e8d4,stroke:#82b366
    style Prometheus fill:#e1d5e7,stroke:#9673a6
