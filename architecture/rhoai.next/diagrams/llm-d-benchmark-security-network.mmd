graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI Runner"]
    end

    subgraph Ingress["INGRESS (Edge TLS)"]
        Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>TLS edge termination<br/>No application-level auth"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Bench["Namespace: ${NAMESPACE}"]
            BenchPod["Benchmark StatefulSet Pod<br/>Image: ghcr.io/llm-d/llm-d-benchmark<br/>Port: 8080/TCP<br/>RBAC: pods/exec for system:authenticated"]
            Service["ClusterIP Service<br/>8080/TCP HTTP<br/>No encryption<br/>No auth"]
            DiscoveryPod["Stack Discovery Pod<br/>Lightweight Python 3.11<br/>Non-root user"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS<br/>Auth: kubeconfig / Bearer / SA"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: HF_TOKEN Bearer"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: google-auth ADC"]
        S3["AWS S3<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM"]
        Registries["Container Registries<br/>ghcr.io / quay.io<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        InferenceEndpoint["Inference Endpoint<br/>80/TCP or 8080/TCP<br/>HTTP<br/>No encryption"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS edge<br/>No app auth"| Route
    Route -->|"HTTP/8080<br/>Plaintext<br/>No auth"| Service
    Service --> BenchPod

    BenchPod -->|"HTTPS/443<br/>TLS<br/>kubeconfig/Bearer"| K8sAPI
    BenchPod -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN Bearer"| HFHub
    BenchPod -->|"HTTPS/443<br/>TLS 1.2+<br/>google-auth"| GCS
    BenchPod -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    BenchPod -->|"HTTP/8080<br/>Plaintext<br/>No auth"| InferenceEndpoint

    DiscoveryPod -->|"HTTPS/443<br/>TLS<br/>kubeconfig/SA"| K8sAPI

    K8sAPI -.->|"verify_ssl=False path<br/>⚠ Security concern"| BenchPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Route ingress
    class BenchPod,Service,DiscoveryPod,K8sAPI internal
    class HFHub,GCS,S3,Registries,InferenceEndpoint externalservice
