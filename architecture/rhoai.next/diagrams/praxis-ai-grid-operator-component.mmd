graph TB
    subgraph OperatorBinary["Operator Binary"]
        direction TB
        Controllers["Controllers<br/>(GridNetwork, GridSite,<br/>InferenceProvider, AgentToolProvider)"]
        SWIMRuntime["SWIM Runtime<br/>(foca + AES-256-GCM)"]
        ScoringEngine["Scoring Engine<br/>(noMetrics, queueDepth,<br/>kvCachePressure)"]
        OverlayRenderer["Overlay Renderer<br/>(ConfigMap writer)"]
        MetricsServer["Metrics/Health Server<br/>9090/TCP"]
    end

    subgraph Libraries["Shared Libraries"]
        direction TB
        ScoringLib["scoring<br/>(strategy engine)"]
        CertsLib["certs<br/>(mTLS, SPIFFE)"]
        SwimLib["swim<br/>(foca wrapper)"]
        CRDTLib["crdt<br/>(LWW, OR-Set, G-Counter)"]
        SignalsLib["signals<br/>(health primitives)"]
        SignalsClientLib["signals-client<br/>(mTLS scrape)"]
    end

    subgraph EnrollmentBinary["Enrollment Service"]
        EnrollmentAPI["Enrollment API<br/>8443/TCP HTTPS"]
        TokenMgmt["Token Management"]
        CertSigning["CSR Signing"]
    end

    subgraph GatewayBinary["Grid Gateway"]
        GatewayProxy["Praxis Gateway<br/>8080/TCP HTTPS"]
        OverlaySyncSidecar["overlay-sync sidecar"]
    end

    subgraph FleetUI["Fleet Dashboard (Optional)"]
        Dashboard["Axum + React UI"]
    end

    %% CRDs
    GridNetworkCR["GridNetwork CR"]
    GridSiteCR["GridSite CR"]
    InferenceProviderCR["InferenceProvider CR"]
    AgentToolProviderCR["AgentToolProvider CR"]

    %% CRD watches
    GridNetworkCR -->|watched by| Controllers
    GridSiteCR -->|watched by| Controllers
    InferenceProviderCR -->|watched by| Controllers
    AgentToolProviderCR -->|watched by| Controllers

    %% Internal wiring
    Controllers --> ScoringEngine
    Controllers --> OverlayRenderer
    SWIMRuntime -->|peer discovery| Controllers
    ScoringEngine --> ScoringLib
    SWIMRuntime --> SwimLib
    SwimLib --> CRDTLib
    Controllers --> CertsLib
    Controllers --> SignalsLib
    SWIMRuntime --> SignalsClientLib

    %% Overlay flow
    OverlayRenderer -->|writes ConfigMap| OverlaySyncSidecar
    OverlaySyncSidecar -->|file write| GatewayProxy

    %% External dependencies
    EnrollmentAPI -->|stores state| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    EnrollmentAPI -->|issues certs to| Controllers
    Controllers -->|CRD watches, Secret reads| K8sAPI["Kubernetes API<br/>443/TCP"]

    %% Peer communication
    SWIMRuntime -->|7946/UDP gossip| PeerOperators["Peer Site Operators"]
    SignalsClientLib -->|9091/TCP mTLS| PeerOperators
    GatewayProxy -->|mTLS| PeerGateways["Peer Site Gateways"]

    %% Styling
    style Controllers fill:#4a90e2,stroke:#333,color:#fff
    style SWIMRuntime fill:#4a90e2,stroke:#333,color:#fff
    style ScoringEngine fill:#4a90e2,stroke:#333,color:#fff
    style OverlayRenderer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style EnrollmentAPI fill:#50c878,stroke:#333,color:#fff
    style GatewayProxy fill:#e87d4a,stroke:#333,color:#fff
    style OverlaySyncSidecar fill:#e87d4a,stroke:#333,color:#fff
    style Dashboard fill:#9b59b6,stroke:#333,color:#fff
    style GridNetworkCR fill:#f5a623,stroke:#333
    style GridSiteCR fill:#f5a623,stroke:#333
    style InferenceProviderCR fill:#f5a623,stroke:#333
    style AgentToolProviderCR fill:#f5a623,stroke:#333
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style PeerOperators fill:#999,stroke:#333,color:#fff
    style PeerGateways fill:#999,stroke:#333,color:#fff
