graph LR
    PraxisGrid["Praxis Grid<br/>AGN Operator"]

    %% Internal Platform Dependencies
    PraxisGrid -->|"routing overlay<br/>ConfigMap + mTLS"| PraxisGateway["Praxis AI Gateway"]
    PraxisGrid -.->|"optional bootstrap"| CertManager["cert-manager"]
    PraxisGrid -->|"ServiceMonitor scrape"| OpenShiftMonitoring["OpenShift Monitoring"]
    PraxisGrid -.->|"optional Route"| OpenShiftRoutes["OpenShift Routes"]

    %% External Infrastructure
    PraxisGrid -->|"CRD watches<br/>ConfigMap writes<br/>Secret reads"| K8sAPI["Kubernetes API<br/>443/TCP"]
    PraxisGrid -->|"enrollment state"| PostgreSQL["PostgreSQL<br/>5432/TCP"]

    %% External Service Dependencies
    PraxisGrid -->|"health probes<br/>metrics scrape"| InferenceBackends["Inference Backends<br/>vLLM, llm-d, cloud APIs"]
    PraxisGrid -->|"MCP health probes"| MCPServers["MCP Servers<br/>Streamable HTTP"]

    %% Key Rust Dependencies
    subgraph RustEcosystem["Core Rust Dependencies"]
        Axum["axum 0.8.9<br/>HTTP framework"]
        Tokio["tokio 1.53.1<br/>Async runtime"]
        Kube["kube 4.2.0<br/>K8s controller runtime"]
        Foca["foca 1.0.0<br/>SWIM protocol"]
        Rustls["rustls 0.23<br/>TLS (default)"]
        OpenSSL["openssl 0.10<br/>TLS (FIPS)"]
        RMCP["rmcp 3.1.4<br/>MCP client"]
        AesGcm["aes-gcm 0.11.1<br/>SWIM encryption"]
        SQLx["sqlx 0.9<br/>PostgreSQL driver"]
    end

    PraxisGrid --> Axum
    PraxisGrid --> Tokio
    PraxisGrid --> Kube
    PraxisGrid --> Foca
    PraxisGrid -->|"default build"| Rustls
    PraxisGrid -->|"FIPS build"| OpenSSL
    PraxisGrid --> RMCP
    PraxisGrid --> AesGcm
    PraxisGrid -->|"enrollment only"| SQLx

    %% Cross-Site Dependencies
    PraxisGrid -->|"7946/UDP<br/>SWIM gossip"| PeerOperator["Peer grid-operator<br/>Remote site"]
    PraxisGrid -->|"9091/TCP<br/>mTLS signals"| PeerSignals["Peer Signals<br/>Remote site"]

    %% Styling
    style PraxisGrid fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PraxisGateway fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333
    style OpenShiftMonitoring fill:#7ed321,stroke:#333
    style OpenShiftRoutes fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style InferenceBackends fill:#f5a623,stroke:#333
    style MCPServers fill:#f5a623,stroke:#333
    style PeerOperator fill:#e8e8e8,stroke:#333
    style PeerSignals fill:#e8e8e8,stroke:#333
    style Axum fill:#ddd,stroke:#333
    style Tokio fill:#ddd,stroke:#333
    style Kube fill:#ddd,stroke:#333
    style Foca fill:#ddd,stroke:#333
