graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (L7 Proxy)"]
        Envoy["Envoy Proxy<br/>8081/TCP (standalone) or 80/TCP (Gateway)<br/>ext-proc filter enabled"]
    end

    subgraph EPPZone["EPP SERVICE (Routing Engine)"]
        direction TB
        EPP["Endpoint Picker (EPP)<br/>SA: {pool}-epp<br/>Image: odh-llm-d-inference-scheduler<br/>FIPS: CGO_ENABLED=1 (no strictfipsruntime ⚠️)"]

        subgraph EPPPorts["EPP Ports"]
            ExtProcPort["9002/TCP gRPC ext-proc<br/>TLS 1.2+ (self-signed/mounted)"]
            HealthPort["9003/TCP gRPC Health<br/>Plaintext"]
            MetricsPort["9090/TCP HTTP Metrics<br/>Plaintext (optional TokenReview auth)"]
            ZMQPort["5557/TCP ZMQ KV-events<br/>Plaintext"]
        end
    end

    subgraph ModelZone["MODEL SERVERS"]
        direction TB
        ModelServer["vLLM / SGLang Pods<br/>8000/TCP HTTP<br/>Selected by InferencePool labels"]

        subgraph SidecarZone["Disaggregation (when P/D enabled)"]
            PdSidecar["pd-sidecar<br/>8000/TCP HTTP/HTTPS TLS 1.2+<br/>FIPS: strictfipsruntime ✓<br/>SSRF protection (optional)"]
            LocalDecoder["Local vLLM Decoder<br/>8001/TCP HTTP/HTTPS"]
        end
    end

    subgraph RemoteWorkers["REMOTE WORKERS"]
        Prefiller["Remote Prefill Workers<br/>8000/TCP HTTP/HTTPS"]
        Encoder["Remote Encoder Workers<br/>8000/TCP HTTP/HTTPS"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        Prometheus["Prometheus<br/>Scrapes 9090/TCP<br/>HTTP<br/>Optional TokenReview"]
        OTEL["OpenTelemetry Collector<br/>4317/TCP gRPC<br/>TLS"]
        Istio["Istio (optional)<br/>DestinationRule<br/>mTLS"]
    end

    %% Flows
    Client -->|"HTTP 8081 or 80<br/>No encryption (or Gateway TLS)<br/>No auth"| Envoy
    Envoy -->|"gRPC 9002<br/>TLS 1.2+ (self-signed)<br/>No client auth ⚠️"| ExtProcPort
    EPP -->|"HTTP 8000<br/>No encryption<br/>insecureSkipVerify ⚠️"| ModelServer
    Envoy -->|"HTTP/gRPC 8000<br/>No encryption<br/>No auth"| ModelServer
    Envoy -->|"HTTP/HTTPS 8000<br/>TLS 1.2+ configurable"| PdSidecar
    PdSidecar -->|"HTTP/HTTPS 8001<br/>Configurable TLS"| LocalDecoder
    PdSidecar -->|"HTTP/HTTPS 8000<br/>Configurable TLS"| Prefiller
    PdSidecar -->|"HTTP/HTTPS 8000<br/>Configurable TLS"| Encoder
    EPP -->|"HTTPS 443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Prometheus -->|"HTTP 9090<br/>Optional auth"| MetricsPort
    EPP -->|"gRPC 4317<br/>TLS"| OTEL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef eppzone fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef modelzone fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef remote fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Envoy ingress
    class EPP,ExtProcPort,HealthPort,MetricsPort,ZMQPort eppzone
    class ModelServer,PdSidecar,LocalDecoder modelzone
    class K8sAPI,Prometheus,OTEL,Istio platform
    class Prefiller,Encoder remote
