graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        EnvoyGW["Envoy Gateway<br/>443/TCP -> internal<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        Route["OpenShift Route<br/>443/TCP HTTPS<br/>TLS edge termination"]
    end

    subgraph Internal["INTERNAL (Cluster Network)"]
        direction TB

        subgraph EPPZone["EPP Service Zone"]
            EPP["Endpoint Picker (EPP)<br/>SA: llm-d-router<br/>Image: odh-llm-d-inference-scheduler"]
            EPPGrpc["gRPC ext-proc<br/>9002/TCP<br/>Optional TLS"]
            EPPHealth["gRPC Health<br/>9003/TCP<br/>Optional TLS"]
            EPPMetrics["HTTP Metrics<br/>9090/TCP<br/>No encryption"]
            KubeRBACProxy["kube-rbac-proxy<br/>(optional, when monitoring enabled)"]
        end

        subgraph SidecarZone["Sidecar Zone (per decode pod)"]
            SidecarProxy["pd-sidecar<br/>SA: per-pod<br/>Image: odh-llm-d-routing-sidecar<br/>FIPS: strictfipsruntime"]
            SidecarPort["HTTP Proxy<br/>8000/TCP<br/>Optional TLS"]
        end

        subgraph ModelZone["Model-Serving Zone"]
            ModelPods["Model-Serving Pods<br/>Configurable ports<br/>HTTP/HTTPS"]
            PrefillWorkers["Prefill Workers<br/>Configurable ports<br/>HTTP/HTTPS<br/>Configurable TLS"]
            EncodeWorkers["Encode Workers<br/>Configurable ports<br/>HTTP/HTTPS<br/>Configurable TLS"]
            LocalDecoder["Local vLLM Decoder<br/>8001/TCP<br/>HTTP/HTTPS<br/>Configurable TLS"]
        end
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        OTelCollector["OpenTelemetry Collector<br/>Configurable port<br/>OTLP/gRPC<br/>Configurable"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (opt)"| EnvoyGW
    Client -->|"HTTPS/443<br/>TLS edge"| Route
    Route -->|internal| EnvoyGW

    %% Ingress to EPP
    EnvoyGW -->|"gRPC/9002<br/>Optional TLS<br/>No app auth"| EPPGrpc

    %% Ingress to Sidecar
    EnvoyGW -->|"HTTP/8000<br/>Optional TLS<br/>No app auth"| SidecarPort

    %% EPP to model pods
    EPP -->|"HTTP<br/>Optional TLS<br/>Metrics scrape"| ModelPods

    %% Sidecar to workers
    SidecarProxy -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Prefill orchestration"| PrefillWorkers
    SidecarProxy -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Encode orchestration"| EncodeWorkers
    SidecarProxy -->|"HTTP/HTTPS/8001<br/>Configurable TLS<br/>Decode forwarding"| LocalDecoder

    %% Platform dependencies
    EPP -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    SidecarProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    EPP -->|"OTLP/gRPC<br/>Configurable"| OTelCollector

    %% Metrics path
    KubeRBACProxy -->|"TokenReview +<br/>SubjectAccessReview"| EPPMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class EnvoyGW,Route ingress
    class EPP,EPPGrpc,EPPHealth,EPPMetrics,KubeRBACProxy,SidecarProxy,SidecarPort,ModelPods,PrefillWorkers,EncodeWorkers,LocalDecoder internal
    class K8sAPI,OTelCollector platform
