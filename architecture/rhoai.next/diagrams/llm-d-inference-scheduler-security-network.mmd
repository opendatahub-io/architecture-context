graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Envoy Gateway<br/>inference-gateway<br/>80/TCP HTTP<br/>No TLS"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (ClusterIP)"]
        direction TB

        subgraph NS_EPP["Namespace: ${NAMESPACE}"]
            direction TB
            EPP["Endpoint Picker (EPP)<br/>SA: ${EPP_NAME}<br/>Image: odh-llm-d-inference-scheduler"]
            EPP_ExtProc["ext-proc gRPC<br/>9002/TCP<br/>TLS (self-signed)"]
            EPP_Health["gRPC Health<br/>9003/TCP<br/>Plaintext"]
            EPP_Metrics["Prometheus Metrics<br/>9090/TCP HTTP<br/>Auth: Optional SA token"]
            EPP_ZMQ["ZMQ KV-Events<br/>5557/TCP<br/>No encryption"]
        end

        subgraph NS_Decode["Decode Worker Pod"]
            direction TB
            Sidecar["pd-sidecar<br/>Image: odh-llm-d-routing-sidecar<br/>8000/TCP HTTP/HTTPS<br/>TLS 1.2+ (configurable)"]
            DecodeWorker["Local Decode Worker<br/>8001/TCP HTTP/HTTPS"]
        end

        subgraph NS_Workers["Worker Pods"]
            PrefillWorker["Prefill Workers<br/>HTTP/HTTPS"]
            EncodeWorker["Encode Workers<br/>HTTP/HTTPS"]
        end

        subgraph NS_ModelServers["Model Server Pods"]
            ModelServer["vLLM / SGLang / Triton<br/>8000/TCP HTTP<br/>Prometheus metrics"]
        end
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OptionalServices["OPTIONAL EXTERNAL SERVICES"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>No encryption"]
        LatencyPredictor["Latency Predictor<br/>8000-8001+/TCP HTTP<br/>No encryption"]
        Prometheus["Prometheus<br/>Scrapes 9090/TCP"]
    end

    %% External → Ingress
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Gateway

    %% Ingress → EPP (ext-proc)
    Gateway -->|"gRPC/9002<br/>TLS (self-signed)<br/>FULL_DUPLEX_STREAMED"| EPP_ExtProc

    %% EPP → K8s API
    EPP -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% EPP → Model Servers (metrics scraping)
    EPP -->|"HTTP/configurable<br/>⚠ InsecureSkipVerify<br/>No Auth"| ModelServer

    %% EPP ZMQ → Model Servers
    EPP_ZMQ -->|"ZMQ SUB/5557<br/>No encryption"| ModelServer

    %% Gateway → Model Server (after EPP decision)
    Gateway -->|"HTTP/8000<br/>No TLS<br/>No Auth"| ModelServer

    %% Gateway → Sidecar (P/D mode)
    Gateway -->|"HTTP(S)/8000<br/>TLS 1.2+"| Sidecar

    %% Sidecar → Workers
    Sidecar -->|"HTTP(S)/header-specified<br/>TLS configurable<br/>⚠ SSRF prot. optional"| PrefillWorker
    Sidecar -->|"HTTP(S)/header-specified<br/>TLS configurable<br/>⚠ SSRF prot. optional"| EncodeWorker
    Sidecar -->|"HTTP(S)/8001<br/>TLS configurable"| DecodeWorker

    %% EPP → Optional services
    EPP -.->|"gRPC/4317<br/>No encryption"| OTLP
    EPP -.->|"HTTP/8000+<br/>No encryption"| LatencyPredictor
    Prometheus -.->|"HTTP/9090<br/>Optional SA token"| EPP_Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef optional fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class EPP,EPP_ExtProc,EPP_Health,EPP_Metrics,EPP_ZMQ,Sidecar,DecodeWorker,PrefillWorker,EncodeWorker,ModelServer cluster
    class K8sAPI control
    class OTLP,LatencyPredictor,Prometheus optional
