graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["llm-d-batch-gateway-operator<br/>(ServiceAccount)"]
    end

    subgraph ClusterBindings["Cluster Role Bindings"]
        CRB["operator<br/>(ClusterRoleBinding)<br/>Cluster-wide"]
        LEB["leader-election-rolebinding<br/>(RoleBinding)<br/>Operator namespace"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["operator<br/>(ClusterRole)"]
        LER["leader-election-role<br/>(Role)"]
    end

    subgraph AggregateRoles["Aggregate Cluster Roles"]
        AdminCR["admin (aggregate)<br/>(ClusterRole)"]
        ViewCR["view (aggregate)<br/>(ClusterRole)"]
    end

    subgraph BatchResources["batch.llm-d.ai Resources"]
        LBG["llmbatchgateways<br/>get, list, watch,<br/>update, patch"]
        LBGStatus["llmbatchgateways/status<br/>get, update, patch"]
        LBGFinalizers["llmbatchgateways/finalizers<br/>update"]
    end

    subgraph CoreResources["Core API Resources"]
        Deployments["apps/deployments<br/>get, list, watch, create,<br/>update, patch, delete"]
        Services["core/services<br/>get, list, watch, create,<br/>update, patch, delete"]
        ConfigMaps["core/configmaps<br/>get, list, watch, create,<br/>update, patch, delete"]
        ServiceAccts["core/serviceaccounts<br/>get, list, watch, create,<br/>update, patch, delete"]
        Secrets["core/secrets<br/>get, list, watch,<br/>create, patch"]
        Events["core/events<br/>create, patch"]
    end

    subgraph GatewayResources["Gateway API Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes<br/>get, list, watch, create,<br/>update, patch, delete"]
        RefGrants["gateway.networking.k8s.io<br/>referencegrants<br/>get, list, watch"]
    end

    subgraph OptionalResources["Optional CRD Resources"]
        Certificates["cert-manager.io<br/>certificates<br/>get, list, watch, create,<br/>update, patch, delete"]
        SvcMonitors["monitoring.coreos.com<br/>servicemonitors<br/>get, list, watch, create,<br/>update, patch, delete"]
        PodMonitors["monitoring.coreos.com<br/>podmonitors<br/>get, list, watch, create,<br/>update, patch, delete"]
        PromRules["monitoring.coreos.com<br/>prometheusrules<br/>get, list, watch, create,<br/>update, patch, delete"]
    end

    subgraph AggregatePermissions["Aggregate Role Permissions"]
        AdminLBG["llmbatchgateways<br/>get, list, watch, create,<br/>update, patch, delete"]
        AdminLBGStatus["llmbatchgateways/status<br/>get"]
        ViewLBG["llmbatchgateways<br/>get, list, watch"]
        ViewLBGStatus["llmbatchgateways/status<br/>get"]
    end

    %% Bindings
    SA -->|bound via| CRB
    SA -->|bound via| LEB

    %% Role grants
    CRB -->|grants| CR
    LEB -->|grants| LER

    %% Operator ClusterRole permissions
    CR -->|manages| LBG
    CR -->|manages| LBGStatus
    CR -->|manages| LBGFinalizers
    CR -->|manages| Deployments
    CR -->|manages| Services
    CR -->|manages| ConfigMaps
    CR -->|manages| ServiceAccts
    CR -->|manages| Secrets
    CR -->|manages| Events
    CR -->|manages| HTTPRoutes
    CR -->|manages| RefGrants
    CR -->|manages| Certificates
    CR -->|manages| SvcMonitors
    CR -->|manages| PodMonitors
    CR -->|manages| PromRules

    %% Aggregate roles
    AdminCR -->|grants| AdminLBG
    AdminCR -->|grants| AdminLBGStatus
    ViewCR -->|grants| ViewLBG
    ViewCR -->|grants| ViewLBGStatus

