graph TB
    subgraph ClientEnv["CLIENT ENVIRONMENT (User Workstation / Jupyter Notebook)"]
        SDK["CodeFlare SDK<br/>Python Client Library<br/>Auth: kube-authkit"]
        TLSStore["Local TLS Store<br/>~/.local/share/codeflare/tls/<br/>Permissions: 0600"]
        SDK -->|"Write certs<br/>File I/O<br/>0600 perms"| TLSStore
    end

    subgraph K8sCluster["KUBERNETES CLUSTER (OpenShift)"]
        subgraph ControlPlane["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AuthN: Bearer/OIDC/SA"]
        end

        subgraph KubeRayNS["Namespace: kuberay-system"]
            KubeRayOp["KubeRay Operator<br/>SA: kuberay-operator"]
        end

        subgraph KueueNS["Namespace: kueue-system"]
            KueueCtrl["Kueue Controller<br/>SA: kueue-controller"]
        end

        subgraph UserNS["Namespace: user-namespace"]
            RayHead["Ray Head Pod<br/>8265/TCP HTTP/HTTPS<br/>6379/TCP GCS<br/>Optional mTLS"]
            RayWorker["Ray Worker Pods"]
            CASec["CA Secret<br/>(ca-secret-*)"]
            RayHead --- RayWorker
        end

        subgraph IngressLayer["INGRESS LAYER"]
            Route["OpenShift Route<br/>(route.openshift.io/v1)"]
            HTTPRoute["Gateway API HTTPRoute<br/>(gateway.networking.k8s.io/v1)"]
            GWConfig["RHOAI GatewayConfig<br/>(services.platform.opendatahub.io)"]
        end
    end

    %% Client to Control Plane
    SDK -->|"HTTPS/443<br/>TLS 1.2+<br/>kube-authkit<br/>(Bearer/OIDC/SA/kubeconfig)"| K8sAPI

    %% SDK reads ingress resources via K8s API
    K8sAPI -.->|"API reads"| Route
    K8sAPI -.->|"API reads"| HTTPRoute
    K8sAPI -.->|"API reads"| GWConfig
    K8sAPI -.->|"API reads"| CASec

    %% Client to Ray Head (data plane)
    SDK -->|"HTTP(S)/8265<br/>Optional TLS<br/>Client cert from local store"| RayHead
    SDK -->|"TCP/6379<br/>Optional TLS<br/>(RAY_USE_TLS)"| RayHead

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userworkload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef ingress fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class SDK,TLSStore client
    class K8sAPI controlplane
    class KubeRayOp,KueueCtrl operator
    class RayHead,RayWorker userworkload
    class Route,HTTPRoute,GWConfig ingress
    class CASec secret
