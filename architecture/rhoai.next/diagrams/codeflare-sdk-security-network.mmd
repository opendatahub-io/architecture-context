graph TB
    subgraph UserEnv["USER ENVIRONMENT (Client-Side)"]
        SDK["CodeFlare SDK<br/>Python 3.9/3.11<br/>cryptography==40.0.2<br/>SA: notebook pod SA"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC enforced"]

        subgraph Operators["Platform Operators"]
            CFOp["CodeFlare Operator<br/>Watches: AppWrapper CR"]
            KubeRay["KubeRay Operator<br/>Watches: RayCluster CR"]
            KueueCtrl["Kueue Controller<br/>Watches: LocalQueue CR"]
        end
    end

    subgraph RayCluster["RAY CLUSTER (User Namespace)"]
        direction TB
        subgraph HeadSvc["{cluster-name}-head-svc (ClusterIP)"]
            RayHead["Ray Head Pod<br/>Image: quay.io/modh/ray<br/>(SHA256 digest-pinned)<br/>Volumes: odh-trusted-ca-bundle"]
        end
        RayWorkers["Ray Worker Pods<br/>Image: quay.io/modh/ray"]
    end

    subgraph IngressLayer["INGRESS LAYER (Platform-Managed)"]
        Route["OpenShift Route<br/>ray-dashboard-{name}<br/>443/TCP HTTPS<br/>TLS edge/passthrough<br/>oauth-proxy"]
    end

    %% SDK to K8s API
    SDK -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token / Kubeconfig<br/>CRUD: RayCluster, AppWrapper,<br/>LocalQueue, Route, Secret"| K8sAPI

    %% SDK to Ray Dashboard via Route
    SDK -->|"HTTPS/443 → 8265<br/>TLS (via Route)<br/>Bearer Token (OpenShift)<br/>Job submit/status/logs"| Route
    Route -->|"HTTP/8265<br/>Internal"| RayHead

    %% SDK to Ray Client via Route (mTLS)
    SDK -.->|"gRPC+TLS/443 → 10001<br/>mTLS (optional)<br/>Client cert signed by cluster CA<br/>RSA-2048, SHA256"| Route

    %% Operators watching CRDs
    K8sAPI ---|"CRD watch"| CFOp
    K8sAPI ---|"CRD watch"| KubeRay
    K8sAPI ---|"CRD watch"| KueueCtrl

    %% Operator actions
    CFOp -->|"schedules via"| KueueCtrl
    KubeRay -->|"provisions"| RayHead
    KubeRay -->|"provisions"| RayWorkers

    %% Styling
    classDef client fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef raycluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef ingress fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class SDK client
    class K8sAPI controlplane
    class CFOp,KubeRay,KueueCtrl operator
    class RayHead,RayWorkers raycluster
    class Route ingress
