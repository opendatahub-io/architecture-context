graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["trainer-operator-controller-manager<br/>(trainer-operator-system)"]
        SA_Ctrl["kubeflow-trainer-controller-manager<br/>(opendatahub)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Op["trainer-operator-manager-rolebinding"]
        CRB_Ctrl["kubeflow-trainer-controller-manager"]
    end

    subgraph OperatorRole["ClusterRole: manager-role (trainer-operator)"]
        direction TB
        subgraph PlatformResources["Platform Resources"]
            R_Trainers["components.platform.opendatahub.io<br/>trainers, trainers/status, trainers/finalizers<br/>get,list,watch,patch,update"]
        end

        subgraph CoreResources["Core API Resources"]
            R_NS["core: namespaces<br/>get,list,watch,create,update,patch"]
            R_CM["core: configmaps, services, serviceaccounts<br/>get,list,watch,create,update,patch,delete"]
            R_Secrets["core: secrets<br/>create,get,list,patch,update,watch"]
            R_Events["core: events<br/>create,patch,update,watch"]
            R_Pods["core: pods<br/>get,list"]
        end

        subgraph ExtResources["Extended API Resources"]
            R_Deploy["apps: deployments<br/>get,list,watch,create,update,patch,delete"]
            R_Webhook["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>get,list,watch,create,update,patch,delete"]
            R_CRDs["apiextensions.k8s.io<br/>customresourcedefinitions<br/>get,list,watch,create,update,patch"]
            R_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings, rolebindings<br/>get,list,watch,create,update,patch,delete"]
        end

        subgraph MonitoringResources["Monitoring & Networking"]
            R_PodMon["monitoring.coreos.com: podmonitors<br/>get,list,watch,create,update,patch,delete"]
            R_NetPol["networking.k8s.io: networkpolicies<br/>get,list,watch,create,update,patch"]
        end

        subgraph OpenShiftResources["OpenShift-Specific"]
            R_IS["image.openshift.io: imagestreams<br/>get,list,watch,create,update,patch,delete"]
            R_Config["config.openshift.io: apiservers, clusterversions<br/>get"]
            R_JobSetOp["operator.openshift.io: jobsetoperators<br/>get,list"]
            R_OLM["operators.coreos.com: operatorconditions<br/>list"]
        end

        subgraph TrainerResources["Kubeflow Trainer Resources"]
            R_Trainer["trainer.kubeflow.org<br/>clustertrainingruntimes, trainingruntimes, trainjobs<br/>get,list,watch,create,update,patch,delete"]
            R_JobSet["jobset.x-k8s.io: jobsets<br/>create,get,list,patch,update,watch"]
            R_PodGroups["scheduling.volcano.sh, scheduling.x-k8s.io<br/>podgroups<br/>create,get,list,patch,update,watch"]
        end
    end

    subgraph UserRoles["User-Facing ClusterRoles"]
        CR_Admin["training-admin<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>create,delete,get,list,patch,update,watch"]
        CR_Edit["training-edit<br/>trainjobs: create,delete,get,list,patch,update,watch<br/>runtimes: get,list,watch"]
        CR_View["training-view<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>get,list,watch"]
    end

    %% Bindings
    SA_Op -->|bound via| CRB_Op
    SA_Ctrl -->|bound via| CRB_Ctrl
    CRB_Op -->|grants| OperatorRole
    CRB_Ctrl -->|"grants upstream role"| TrainerResources

