graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["controller-manager<br/>(trainer-operator-system)"]
        SA_Ctrl["kubeflow-trainer-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Op["manager-rolebinding<br/>(cluster-wide)"]
        CRB_Ctrl["kubeflow-trainer-controller-<br/>manager-rolebinding"]
    end

    subgraph OperatorRole["Operator ClusterRole: manager-role"]
        direction TB
        OP_Trainers["components.platform.opendatahub.io<br/>trainers, trainers/status, trainers/finalizers"]
        OP_Core["core<br/>namespaces, services, serviceaccounts,<br/>configmaps, secrets, events, pods, limitranges"]
        OP_Apps["apps<br/>deployments"]
        OP_Admission["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        OP_CRD["apiextensions.k8s.io<br/>customresourcedefinitions"]
        OP_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings"]
        OP_Monitor["monitoring.coreos.com<br/>podmonitors"]
        OP_Trainer["trainer.kubeflow.org<br/>clustertrainingruntimes,<br/>trainingruntimes, trainjobs"]
        OP_JobSet["jobset.x-k8s.io<br/>jobsets"]
        OP_Image["image.openshift.io<br/>imagestreams"]
        OP_OLM["operator.openshift.io: jobsetoperators<br/>operators.coreos.com: operatorconditions"]
        OP_Network["networking.k8s.io<br/>networkpolicies"]
    end

    subgraph CtrlRole["Deployed ClusterRole: kubeflow-trainer-controller-manager"]
        direction TB
        CTRL_Trainer["trainer.kubeflow.org<br/>clustertrainingruntimes,<br/>trainingruntimes, trainjobs"]
        CTRL_JobSet["jobset.x-k8s.io<br/>jobsets"]
        CTRL_Webhook["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        CTRL_Core["core<br/>configmaps, secrets,<br/>events, pods, limitranges"]
        CTRL_Network["networking.k8s.io<br/>networkpolicies"]
    end

    subgraph UserRoles["User-Facing RBAC Aggregation Roles"]
        direction TB
        TrainingView["training-view<br/>trainer.kubeflow.org:<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>Verbs: get, list, watch"]
        TrainingEdit["training-edit<br/>trainer.kubeflow.org:<br/>trainjobs → CRUD<br/>trainingruntimes, clustertrainingruntimes<br/>→ get, list, watch"]
        TrainingAdmin["training-admin<br/>trainer.kubeflow.org:<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>Verbs: CRUD"]
    end

    subgraph AdminRoles["Platform Admin Roles"]
        direction TB
        TrainerAdmin["trainer-admin-role<br/>components.platform.opendatahub.io:<br/>trainers → *"]
        TrainerEditor["trainer-editor-role<br/>components.platform.opendatahub.io:<br/>trainers → CRUD"]
        TrainerViewer["trainer-viewer-role<br/>components.platform.opendatahub.io:<br/>trainers → get, list, watch"]
    end

    %% Operator bindings
    SA_Op -->|bound via| CRB_Op
    CRB_Op -->|grants| OP_Trainers
    CRB_Op -->|grants| OP_Core
    CRB_Op -->|grants| OP_Apps
    CRB_Op -->|grants| OP_Admission
    CRB_Op -->|grants| OP_CRD
    CRB_Op -->|grants| OP_RBAC
    CRB_Op -->|grants| OP_Monitor
    CRB_Op -->|grants| OP_Trainer
    CRB_Op -->|grants| OP_JobSet
    CRB_Op -->|grants| OP_Image
    CRB_Op -->|grants| OP_OLM
    CRB_Op -->|grants| OP_Network

    %% Controller bindings
    SA_Ctrl -->|bound via| CRB_Ctrl
    CRB_Ctrl -->|grants| CTRL_Trainer
    CRB_Ctrl -->|grants| CTRL_JobSet
    CRB_Ctrl -->|grants| CTRL_Webhook
    CRB_Ctrl -->|grants| CTRL_Core
    CRB_Ctrl -->|grants| CTRL_Network

    %% User role aggregation
    TrainingView -.->|aggregates to| K8sView["k8s view ClusterRole"]
    TrainingEdit -.->|aggregates to| K8sEdit["k8s edit ClusterRole"]
    TrainingAdmin -.->|aggregates to| K8sAdmin["k8s admin ClusterRole"]

    %% Styling
    style SA_Op fill:#4a90e2,color:#fff
    style SA_Ctrl fill:#4a90e2,color:#fff
    style CRB_Op fill:#dae8fc,stroke:#6c8ebf
    style CRB_Ctrl fill:#dae8fc,stroke:#6c8ebf
    style OP_Trainers fill:#f5a623
    style OP_Core fill:#f5a623
    style OP_Apps fill:#f5a623
    style OP_Admission fill:#f5a623
    style OP_CRD fill:#f5a623
    style OP_RBAC fill:#f5a623
    style OP_Monitor fill:#f5a623
    style OP_Trainer fill:#f5a623
    style OP_JobSet fill:#f5a623
    style OP_Image fill:#f5a623
    style OP_OLM fill:#f5a623
    style OP_Network fill:#f5a623
    style CTRL_Trainer fill:#7ed321
    style CTRL_JobSet fill:#7ed321
    style CTRL_Webhook fill:#7ed321
    style CTRL_Core fill:#7ed321
    style CTRL_Network fill:#7ed321
    style TrainingView fill:#e1d5e7,stroke:#9673a6
    style TrainingEdit fill:#e1d5e7,stroke:#9673a6
    style TrainingAdmin fill:#e1d5e7,stroke:#9673a6
    style TrainerAdmin fill:#fff2cc,stroke:#d6b656
    style TrainerEditor fill:#fff2cc,stroke:#d6b656
    style TrainerViewer fill:#fff2cc,stroke:#d6b656
