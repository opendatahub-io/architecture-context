graph TD
    subgraph OperatorSA["Operator Service Account"]
        SA1["controller-manager<br/>(namespace: system)"]
    end

    subgraph DeployedSA["Deployed Controller Service Account"]
        SA2["kubeflow-trainer-controller-manager<br/>(namespace: opendatahub)"]
    end

    subgraph MonitoringSA["Monitoring Service Account"]
        SA3["prometheus-k8s<br/>(namespace: openshift-monitoring)"]
    end

    subgraph UserGroups["User Groups"]
        AuthUsers["system:authenticated"]
    end

    subgraph OperatorBindings["Operator Role Bindings"]
        CRB1["manager-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph DeployedBindings["Deployed Controller Bindings"]
        CRB2["kubeflow-trainer-controller-manager<br/>(ClusterRoleBinding)"]
        CRB3["trainer-tls-profile<br/>(ClusterRoleBinding)"]
    end

    subgraph MonitoringBindings["Monitoring Bindings"]
        CRB4["trainer-metrics-reader<br/>(ClusterRoleBinding)"]
    end

    subgraph PublicBindings["Public Bindings"]
        RB1["kubeflow-trainer-public<br/>(RoleBinding, ns: opendatahub)"]
    end

    subgraph OperatorRoles["Operator ClusterRoles"]
        CR1["manager-role"]
    end

    subgraph DeployedRoles["Deployed Controller ClusterRoles"]
        CR2["kubeflow-trainer-controller-manager"]
        CR5["trainer-tls-profile"]
    end

    subgraph UserRoles["User-Facing ClusterRoles"]
        CR6["training-admin"]
        CR7["training-edit"]
        CR8["training-view"]
    end

    subgraph MetricsRoles["Metrics ClusterRoles"]
        CR9["trainer-metrics-reader"]
    end

    subgraph OperatorResources["Operator API Resources"]
        Trainers["components.platform.opendatahub.io<br/>Trainers, status, finalizers"]
        Deployments["apps<br/>Deployments"]
        CRDs["apiextensions.k8s.io<br/>CRDs"]
        RBAC["rbac.authorization.k8s.io<br/>Roles, Bindings"]
        ImgStreams["image.openshift.io<br/>ImageStreams"]
    end

    subgraph DeployedResources["Deployed Controller API Resources"]
        TrainingRes["trainer.kubeflow.org<br/>TrainJobs, Runtimes"]
        JobSets["jobset.x-k8s.io<br/>JobSets"]
        NetPol["networking.k8s.io<br/>NetworkPolicies"]
        Webhooks["admissionregistration.k8s.io<br/>Webhook Configs"]
        CoreRes["core<br/>ConfigMaps, Secrets"]
    end

    subgraph TLSResources["TLS Resources"]
        APIServers["config.openshift.io<br/>APIServers"]
    end

    subgraph MetricsResources["Metrics Resources"]
        MetricsURL["/metrics<br/>(Non-Resource URL)"]
    end

    %% Operator path
    SA1 -->|bound via| CRB1
    CRB1 -->|grants| CR1
    CR1 -->|"get,list,watch,update,patch"| Trainers
    CR1 -->|"full CRUD"| Deployments
    CR1 -->|"create,get,list,patch,update,watch"| CRDs
    CR1 -->|"create,list,watch (scoped)"| RBAC
    CR1 -->|"full CRUD"| ImgStreams

    %% Deployed controller path
    SA2 -->|bound via| CRB2
    CRB2 -->|grants| CR2
    CR2 -->|"get,list,patch,update,watch"| TrainingRes
    CR2 -->|"full CRUD"| JobSets
    CR2 -->|"create,get,list,patch,update,watch"| NetPol
    CR2 -->|"get,list,update,watch"| Webhooks
    CR2 -->|"create,get,list,patch,update,watch"| CoreRes

    %% TLS path
    SA2 -->|bound via| CRB3
    CRB3 -->|grants| CR5
    CR5 -->|"get,list,watch"| APIServers

    %% Monitoring path
    SA3 -->|bound via| CRB4
    CRB4 -->|grants| CR9
    CR9 -->|"GET"| MetricsURL

    %% Public access
    AuthUsers -->|bound via| RB1

    style SA1 fill:#4a90e2,stroke:#333,color:#fff
    style SA2 fill:#4a90e2,stroke:#333,color:#fff
    style SA3 fill:#7ed321,stroke:#333
    style CR1 fill:#f5a623,stroke:#333
    style CR2 fill:#f5a623,stroke:#333
    style CR5 fill:#f5a623,stroke:#333
    style CR6 fill:#e8e8e8,stroke:#333
    style CR7 fill:#e8e8e8,stroke:#333
    style CR8 fill:#e8e8e8,stroke:#333
    style CR9 fill:#f5a623,stroke:#333
    style Trainers fill:#7ed321,stroke:#333
    style TrainingRes fill:#7ed321,stroke:#333
