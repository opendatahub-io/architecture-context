graph LR
    VLLMSpyre["vllm-spyre<br/>Container Image"]

    %% Base Image Chain
    VLLMSpyre -->|"extends"| RHAIIS["RHAIIS vllm-spyre-rhel9:3.2.2<br/>Product Image"]
    RHAIIS -->|"extends"| AIPCC["AIPCC Spyre Base Image<br/>Python 3.12 / RHEL 9.8"]

    %% External Dependencies (inherited from base image)
    RHAIIS -->|"provides"| VLLM["vLLM<br/>Inference Engine"]
    RHAIIS -->|"provides"| TGISAdapter["vllm_tgis_adapter<br/>TGIS gRPC Adapter"]
    AIPCC -->|"provides"| SpyreSDK["IBM Spyre SDK 1.3.1<br/>Accelerator Runtime"]
    AIPCC -->|"provides"| Python["Python 3.12<br/>Runtime"]

    %% Internal Platform Dependencies
    KServe["KServe / ModelMesh"] -->|"deploys as<br/>ServingRuntime"| VLLMSpyre
    ModelCtrl["Model Controller"] -->|"references<br/>container image"| VLLMSpyre

    %% External Services
    VLLMSpyre -->|"model storage<br/>HTTPS/NFS"| S3["S3 / PVC<br/>Model Storage"]
    VLLMSpyre -->|"device access<br/>kernel/driver"| SpyreHW["IBM Spyre<br/>Accelerator HW"]
    VLLMSpyre -->|"API server"| K8sAPI["Kubernetes API"]

    %% Platform Integration
    Istio["Istio Service Mesh"] -->|"sidecar injection<br/>mTLS / AuthZ"| VLLMSpyre

