graph LR
    VLLMSpyre["vllm-spyre<br/>(odh-vllm-spyre-rhel9)"]

    %% External Dependencies (Required at build or runtime)
    VLLMSpyre -->|"base image (FROM)"| RHAIISBase["RHAIIS Base Image<br/>vllm-spyre-rhel9:3.2.2"]
    RHAIISBase -->|"base image (FROM)"| AIPCCBase["AIPCC Spyre Base<br/>quay.io/aipcc/base-images/spyre"]
    VLLMSpyre -->|"hardware (runtime)"| SpyreHW["IBM Spyre<br/>Accelerator HW"]
    VLLMSpyre -->|"model weights<br/>(startup)"| HFModels["HuggingFace<br/>Model Weights<br/>(pre-downloaded)"]

    %% Internal Platform Dependencies
    KServe["KServe<br/>ServingRuntime"] -->|"deploys as<br/>container runtime"| VLLMSpyre
    KubeRBACProxy["kube-rbac-proxy<br/>(sidecar)"] -->|"auth proxy<br/>HTTPS/8443 → HTTP/8000,<br/>gRPC/8033"| VLLMSpyre
    ModelStorage["Model Storage<br/>(PVC / S3)"] -->|"volume mount"| VLLMSpyre
    SpyrePlugin["IBM Spyre<br/>Device Plugin"] -->|"device allocation"| VLLMSpyre

    %% Upstream provenance
    subgraph Provenance["Source Provenance Chain"]
        direction TB
        Upstream["vllm-project/vllm<br/>(upstream)"]
        Midstream["neuralmagic/nm-vllm<br/>(midstream)"]
        Downstream["red-hat-data-services/<br/>vllm-spyre<br/>(downstream)"]
        Upstream -->|"manual sync"| Midstream
        Midstream -->|"manual sync<br/>midstream-cuda-v0.9.1.0"| Downstream
    end

    %% Integration Points (components that consume vllm-spyre)
    VLLMSpyre -.->|"serves inference"| RHOAIPlatform["RHOAI Platform<br/>(consumers)"]

    %% Styling
    style VLLMSpyre fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style RHAIISBase fill:#999,stroke:#333,color:#fff
    style AIPCCBase fill:#999,stroke:#333,color:#fff
    style SpyreHW fill:#9b59b6,stroke:#333,color:#fff
    style HFModels fill:#f5a623,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style KubeRBACProxy fill:#7ed321,stroke:#333,color:#fff
    style ModelStorage fill:#7ed321,stroke:#333,color:#fff
    style SpyrePlugin fill:#7ed321,stroke:#333,color:#fff
    style RHOAIPlatform fill:#85bbf0,stroke:#333,color:#fff
    style Upstream fill:#ddd,stroke:#333
    style Midstream fill:#ddd,stroke:#333
    style Downstream fill:#ddd,stroke:#333
