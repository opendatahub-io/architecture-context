graph TB
    subgraph VllmCPU["vllm-cpu Inference Server"]
        direction TB

        subgraph Entrypoints["Entrypoints Layer"]
            APIServer["OpenAI API Server<br/>(FastAPI/Uvicorn)<br/>Port 8000/TCP"]
            GRPCServer["gRPC Server<br/>(grpc.aio)<br/>Port 8000/TCP"]
            DPSupervisor["Data-Parallel Supervisor<br/>(Multi-port LB mode)"]
            CLI["CLI Entry Point<br/>(vllm command)"]
        end

        subgraph Middleware["Middleware Layer"]
            AuthMW["AuthenticationMiddleware<br/>(Bearer Token / SHA-256)"]
            ScalingMW["ScalingMiddleware<br/>(Elastic Expert-Parallelism)"]
            SSLRefresh["SSLCertRefresher<br/>(File-watching hot-reload)"]
        end

        subgraph Engine["Engine Layer"]
            AsyncLLM["AsyncLLM / EngineClient"]
            PagedAttn["PagedAttention<br/>(KV-cache management)"]
            ContBatch["Continuous Batching"]
            LoRA["LoRA Adapter Manager"]
        end

        subgraph APIFamilies["API Families"]
            OpenAIAPI["/v1/* OpenAI-compatible"]
            AnthropicAPI["/v1/messages Anthropic"]
            PoolingAPI["/v1/embeddings, /v1/score,<br/>/v1/rerank, /classify"]
            DisaggAPI["/inference/* Disaggregated"]
            SageMakerAPI["/ping, /invocations<br/>SageMaker"]
            InfraAPI["/health, /load, /version<br/>Infrastructure"]
        end
    end

    Client["Client / KServe Router"] -->|"HTTP 8000/TCP<br/>Bearer token auth"| APIServer
    Client -->|"gRPC 8000/TCP<br/>Insecure port"| GRPCServer

    APIServer --> AuthMW
    APIServer --> ScalingMW
    APIServer -.->|"TLS opt-in"| SSLRefresh

    AuthMW -->|"Guards /v1, /v2, /inference"| OpenAIAPI
    AuthMW --> AnthropicAPI
    AuthMW --> PoolingAPI
    AuthMW --> DisaggAPI

    OpenAIAPI --> AsyncLLM
    AnthropicAPI --> AsyncLLM
    PoolingAPI --> AsyncLLM
    DisaggAPI --> AsyncLLM
    SageMakerAPI --> AsyncLLM
    GRPCServer --> AsyncLLM

    AsyncLLM --> PagedAttn
    AsyncLLM --> ContBatch
    AsyncLLM --> LoRA

    DPSupervisor -->|"Health aggregation"| APIServer

    AsyncLLM -->|"Model loading"| ModelStorage["Model Storage<br/>(PVC / S3 / HF Hub)"]
    APIServer -->|"Metrics scrape"| Prometheus["Prometheus"]
    AsyncLLM -->|"Tracing export"| OTel["OpenTelemetry Collector"]

    style APIServer fill:#4a90e2,color:#fff
    style GRPCServer fill:#4a90e2,color:#fff
    style DPSupervisor fill:#4a90e2,color:#fff
    style AsyncLLM fill:#4a90e2,color:#fff
    style AuthMW fill:#f5a623,color:#fff
    style ScalingMW fill:#f5a623,color:#fff
    style SSLRefresh fill:#f5a623,color:#fff
    style PagedAttn fill:#7ed321,color:#fff
    style ContBatch fill:#7ed321,color:#fff
    style LoRA fill:#7ed321,color:#fff
    style ModelStorage fill:#e8e8e8,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#999
    style OTel fill:#e8e8e8,stroke:#999
    style Client fill:#f9f9f9,stroke:#999
