graph TB
    subgraph "vllm-cpu Inference Server"
        direction TB

        subgraph "Frontend Layer"
            APIServer["OpenAI API Server<br/>FastAPI/Uvicorn<br/>Port 8000/TCP"]
            GRPCServer["gRPC Server<br/>grpc.aio<br/>Port 50051/TCP"]
            CLI["CLI<br/>serve / benchmark / batch"]
        end

        subgraph "Rust Frontend (PyO3)"
            RustTokenizer["Tokenizer"]
            RustChat["Chat Renderer"]
            RustToolParser["Tool Parser"]
            RustReasoning["Reasoning Parser"]
        end

        subgraph "V1 Engine Core"
            InputProc["Input Processor"]
            ZMQ_In["ZMQ PUSH"]
            Scheduler["Scheduler"]
            ZMQ_Out["ZMQ PUB"]
            OutputProc["Output Processor"]
        end

        subgraph "Model Executor"
            ModelLoader["Model Loader<br/>15+ format plugins"]
            WeightMgr["Weight Manager"]
            Executor["CPU Executor<br/>UniProcExecutor"]
        end

        subgraph "CPU Platform"
            NUMA["NUMA-aware Memory"]
            OpenMP["OpenMP Threading"]
            DType["Arch-specific DType<br/>bf16/fp16/fp32"]
        end
    end

    %% Frontend connections
    APIServer -->|"request parsing"| RustTokenizer
    APIServer -->|"chat template"| RustChat
    APIServer -->|"tool calls"| RustToolParser

    %% API to Engine flow
    APIServer -->|"processed request"| InputProc
    GRPCServer -->|"processed request"| InputProc
    InputProc --> ZMQ_In
    ZMQ_In --> Scheduler
    Scheduler -->|"schedule batch"| Executor
    Executor --> ZMQ_Out
    ZMQ_Out --> OutputProc
    OutputProc -->|"response"| APIServer
    OutputProc -->|"response"| GRPCServer

    %% Model loading
    ModelLoader -->|"load weights"| WeightMgr
    WeightMgr -->|"memory map"| NUMA
    Executor -->|"inference"| DType
    Executor -->|"threading"| OpenMP

    %% External dependencies
    KServe["KServe<br/>InferenceService"] -->|"routes traffic to"| APIServer
    HFHub["HuggingFace Hub<br/>443/TCP HTTPS"] -.->|"model download"| ModelLoader
    Prometheus["Prometheus"] -.->|"scrape metrics"| APIServer

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style GRPCServer fill:#4a90e2,stroke:#333,color:#fff
    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style RustTokenizer fill:#e06c37,stroke:#333,color:#fff
    style RustChat fill:#e06c37,stroke:#333,color:#fff
    style RustToolParser fill:#e06c37,stroke:#333,color:#fff
    style RustReasoning fill:#e06c37,stroke:#333,color:#fff
    style InputProc fill:#7ed321,stroke:#333
    style Scheduler fill:#7ed321,stroke:#333
    style OutputProc fill:#7ed321,stroke:#333
    style ZMQ_In fill:#a8d08d,stroke:#333
    style ZMQ_Out fill:#a8d08d,stroke:#333
    style ModelLoader fill:#f5a623,stroke:#333
    style WeightMgr fill:#f5a623,stroke:#333
    style Executor fill:#f5a623,stroke:#333
    style NUMA fill:#9b59b6,stroke:#333,color:#fff
    style OpenMP fill:#9b59b6,stroke:#333,color:#fff
    style DType fill:#9b59b6,stroke:#333,color:#fff
    style KServe fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
