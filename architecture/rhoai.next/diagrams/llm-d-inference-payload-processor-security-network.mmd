graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Gateway["INGRESS / GATEWAY (DMZ)"]
        EnvoyProxy["Envoy Proxy (Gateway)<br/>443/TCP → internal<br/>TLS 1.2+ termination<br/>Istio EnvoyFilter or GKE GCPRoutingExtension"]
    end

    subgraph Cluster["SERVICE MESH / CLUSTER (Trusted)"]
        direction TB

        subgraph NS_IPP["Namespace: {release-namespace}"]
            IPP["Inference Payload Processor<br/>SA: payload-processor-{release}<br/>Ports: 9004 (gRPC), 9005 (health), 9090 (metrics)"]
        end

        subgraph NS_K8s["Control Plane"]
            K8sAPI["Kubernetes API Server<br/>ConfigMap watch<br/>label: inference.llm-d.ai/ipp-managed"]
        end

        subgraph NS_Pool["Namespace: {pool-namespace}"]
            InferencePool["InferencePool<br/>(HTTPRoute header match)"]
            EPP["llm-d Router (EPP)<br/>(pod selection within pool)"]
        end

        subgraph NS_Models["Namespace: {model-namespace}"]
            ModelServer["Model Servers (vLLM)<br/>8000/TCP HTTP"]
        end
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC OTLP"]
    end

    %% External → Gateway
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| EnvoyProxy

    %% Gateway ↔ IPP (ext-proc)
    EnvoyProxy <-->|"gRPC/9004<br/>Self-signed TLS (4096-bit RSA)<br/>No auth (proxy trust)<br/>insecureSkipVerify: true (Istio)"| IPP

    %% IPP → K8s API
    IPP -->|"HTTPS/443<br/>TLS 1.2+<br/>SA bearer token<br/>RBAC: configmaps [get,list,watch]"| K8sAPI

    %% Gateway → Pool → Model
    EnvoyProxy -->|"HTTPRoute match<br/>X-Gateway-Base-Model-Name header"| InferencePool
    InferencePool --> EPP
    EPP -->|"HTTP/8000<br/>Varies<br/>No auth"| ModelServer

    %% Observability
    IPP -.->|"HTTP/9090<br/>No encryption<br/>Optional auth"| Prometheus
    IPP -.->|"gRPC/4317<br/>Plaintext<br/>No auth"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class EnvoyProxy gateway
    class IPP,InferencePool,EPP,ModelServer cluster
    class K8sAPI controlplane
    class Prometheus,OTel observability
