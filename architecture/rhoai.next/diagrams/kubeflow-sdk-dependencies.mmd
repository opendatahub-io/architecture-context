    SDK -->|"creates SparkApplication CRs"| SparkOp["Spark Operator"]
    SDK -->|"REST API calls"| ModelReg["Model Registry"]
    SDK -->|"reads ConfigMap"| ConfigMap["kubeflow-trainer-public<br/>ConfigMap"]

    %% Integration Points (consumed by)
    Dashboard["ODH Dashboard"] -.->|"displays training status"| SDK
    Pipelines["Data Science<br/>Pipelines"] -.->|"uses SDK in pipeline steps"| SDK

    %% External Services
    SDK -->|"model storage"| S3["S3-compatible<br/>Storage"]
    SDK -->|"model downloads"| HFHub["HuggingFace Hub"]
    SDK -->|"Spark sessions"| SparkConnect["SparkConnect<br/>Server"]
    SDK -->|"all CRD ops"| K8sAPI["Kubernetes<br/>API Server"]
    SDK -->|"container mgmt"| DockerPodman["Docker / Podman"]

