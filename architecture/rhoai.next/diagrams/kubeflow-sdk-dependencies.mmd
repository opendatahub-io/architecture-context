graph LR
    KubeflowSDK["Kubeflow SDK<br/>(Python Client Library)"]

    %% Python Library Dependencies (Required)
    KubeflowSDK -->|"API client"| kubernetes["kubernetes<br/>Python >=27.2.0"]
    KubeflowSDK -->|"data validation"| pydantic["pydantic<br/>>=2.10.0"]
    KubeflowSDK -->|"CRD models"| trainerApi["kubeflow-trainer-api<br/>>=2.0.0"]
    KubeflowSDK -->|"CRD models"| katibApi["kubeflow-katib-api<br/>>=0.19.0"]

    %% Python Library Dependencies (Optional)
    KubeflowSDK -.->|"optional: docker extra"| docker["docker<br/>>=6.1.3"]
    KubeflowSDK -.->|"optional: podman extra"| podman["podman<br/>>=5.6.0"]
    KubeflowSDK -.->|"optional: spark extra"| pyspark["pyspark-connect<br/>==4.0.1"]
    KubeflowSDK -.->|"optional: spark extra"| sparkApi["kubeflow-spark-api<br/>>=2.4.0"]
    KubeflowSDK -.->|"optional: hub extra"| modelRegistryLib["model-registry<br/>>=0.3.6"]
    KubeflowSDK -.->|"optional: rhai extra"| fsspec["fsspec<br/>>=2025.3.0"]
    KubeflowSDK -.->|"optional: rhai extra"| s3fs["s3fs<br/>>=2025.3.0"]

    %% Internal Platform Dependencies (Server-Side Operators)
    KubeflowSDK -->|"CRD: TrainJob"| TrainerOperator["Kubeflow Trainer<br/>Operator"]
    KubeflowSDK -->|"CRD: Experiment"| KatibController["Katib Controller"]
    KubeflowSDK -->|"CRD: SparkConnect"| SparkOperator["Spark Operator"]
    KubeflowSDK -->|"REST API"| ModelRegistrySrv["Model Registry<br/>Server"]
    TrainerOperator -->|"CRD: JobSet"| JobSetController["JobSet Controller"]

    %% External Service Dependencies
    KubeflowSDK -->|"CRD CRUD<br/>443/TCP HTTPS"| K8sAPI["Kubernetes<br/>API Server"]
    KubeflowSDK -.->|"model/dataset download<br/>443/TCP HTTPS"| HuggingFace["HuggingFace Hub"]
    KubeflowSDK -.->|"checkpoint storage<br/>443/TCP HTTPS"| S3["S3-Compatible<br/>Storage"]
    KubeflowSDK -.->|"gRPC session<br/>15002/TCP"| SparkConnectSvc["SparkConnect<br/>Service"]

    %% Integration Points (Consumers)
    Dashboard["ODH Dashboard"] -.->|"UI management"| KubeflowSDK
    Pipelines["Data Science<br/>Pipelines"] -.->|"auto deploy"| KubeflowSDK

