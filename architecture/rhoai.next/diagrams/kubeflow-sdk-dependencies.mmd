graph LR
    SDK["Kubeflow SDK<br/>v0.3.0+rhai0"]

    %% External Python Dependencies (Required)
    SDK -->|"API client"| kubernetes["kubernetes<br/>Python >=27.2.0"]
    SDK -->|"data validation"| pydantic["pydantic<br/>>=2.10.0"]
    SDK -->|"TrainJob types"| trainerApi["kubeflow-trainer-api<br/>>=2.0.0"]
    SDK -->|"Katib types"| katibApi["kubeflow-katib-api<br/>>=0.19.0"]

    %% External Python Dependencies (Optional)
    SDK -.->|"optional: container backend"| docker["docker<br/>Python >=6.1.3"]
    SDK -.->|"optional: container backend"| podman["podman<br/>Python >=5.6.0"]
    SDK -.->|"optional: rhai extra"| fsspec["fsspec<br/>>=2025.3.0"]
    SDK -.->|"optional: rhai extra"| s3fs["s3fs<br/>>=2025.3.0"]
    SDK -.->|"optional: spark extra"| pyspark["pyspark-connect<br/>==4.0.1"]
    SDK -.->|"optional: spark extra"| sparkApi["kubeflow-spark-api<br/>>=2.4.0"]
    SDK -.->|"optional: hub extra"| modelRegPkg["model-registry<br/>>=0.3.6"]

    %% Internal Platform Dependencies (Operators/Controllers)
    SDK -->|"creates TrainJob CRs"| TrainerOp["Kubeflow Trainer<br/>Operator"]
