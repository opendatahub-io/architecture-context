graph LR
    SDK["Kubeflow SDK<br/>v0.4.1+rhai0"]

    %% Internal Platform Dependencies
    SDK -->|"CRD client<br/>TrainJob, TrainingRuntime"| TrainerOp["Kubeflow Trainer<br/>Operator"]
    SDK -->|"CRD client<br/>OptimizationJob"| Katib["Kubeflow Katib"]
    SDK -->|"CRD client<br/>SparkConnect"| SparkOp["Kubeflow Spark<br/>Operator"]
    SDK -->|"REST client<br/>HTTP(S)/443 or 8080"| ModelReg["Kubeflow Model<br/>Registry"]
    SDK -->|"REST client<br/>via kfp"| KFP["Kubeflow Pipelines<br/>Server"]

    %% External Dependencies (required)
    SDK -->|"HTTPS/443<br/>kubeconfig / SA token"| K8sAPI["Kubernetes API<br/>Server"]
    SDK -->|"Python client"| K8sLib["kubernetes<br/>>=27.2.0,<36.0.0"]
    SDK -->|"data validation"| Pydantic["pydantic<br/>>=2.10.0"]
    SDK -->|"API models"| TrainerAPI["kubeflow-trainer-api<br/>>=2.2.0,<2.3"]
    SDK -->|"API models"| KatibAPI["kubeflow-katib-api<br/>>=0.19.0,<0.20"]
    SDK -->|"structured logging"| Structlog["structlog<br/>>=24.1.0"]

    %% External Dependencies (optional)
    SDK -.->|"local execution"| Docker["Docker / Podman"]
    SDK -.->|"S3 checkpoints<br/>HTTPS/443"| S3["S3-compatible<br/>Storage"]
    SDK -.->|"model config<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    SDK -.->|"optional dep"| FSSpec["fsspec + s3fs<br/>>=2025.3.0"]
    SDK -.->|"optional dep"| PySpark["pyspark-connect<br/>==4.2.0"]
    SDK -.->|"optional dep"| MRLib["model-registry<br/>>=0.3.14,<0.4"]
    SDK -.->|"optional dep"| KFPLib["kfp<br/>>=2.17.0,<2.18"]

    %% Integration points (other components using SDK)
    Notebooks["Jupyter Notebooks"] -->|"imports SDK"| SDK
    DSPipelines["Data Science<br/>Pipelines"] -.->|"uses SDK"| SDK

