graph TB
    subgraph Active["Active: KEDA-Native Autoscaling"]
        Blueprints["KEDA Scenario Blueprints<br/>(ScaledObject configs)"]
        BenchmarkBed["Benchmark Test Bed<br/>(Python/Shell)"]
        Blueprints -->|"evaluated by"| BenchmarkBed
    end

    subgraph Legacy["Legacy: WVA Controller (deprecated)"]
        direction TB
        Manager["WVA Controller Manager<br/>Go / controller-runtime"]

        subgraph Reconcilers["Reconcilers"]
            ConfigMapR["ConfigMap Reconciler"]
            HPAR["HPA Reconciler"]
            InferencePoolR["InferencePool Reconciler"]
            ScaledObjectR["ScaledObject Reconciler<br/>(conditional)"]
        end

        subgraph Engines["Service Loops"]
            SatEngine["Saturation Engine"]
            ScaleZero["Scale-from-Zero Engine"]
            Coordinator["Coordinator<br/>(experimental)"]
        end

        Manager --> ConfigMapR
        Manager --> HPAR
        Manager --> InferencePoolR
        Manager --> ScaledObjectR
        Manager --> SatEngine
        Manager --> ScaleZero
        Manager --> Coordinator
    end

    %% External resources watched
    InferencePoolCR["InferencePool CR<br/>(Gateway API)"]
    ScaledObjectCR["ScaledObject CR<br/>(KEDA)"]
    LWSCR["LeaderWorkerSet CR"]
    ConfigMapCR["ConfigMaps<br/>(scaling config)"]
    HPARes["HorizontalPodAutoscaler"]

    InferencePoolCR -->|"watched by"| InferencePoolR
    ScaledObjectCR -->|"watched by"| ScaledObjectR
    ConfigMapCR -->|"watched by"| ConfigMapR
    HPARes -->|"watched by"| HPAR

    %% External dependencies
    Prometheus["Prometheus<br/>9090/TCP HTTPS"]
    K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    BenchmarkHarness["llm-d-benchmark<br/>(external tool)"]

    SatEngine -->|"queries metrics"| Prometheus
    SatEngine -->|"patches scale"| K8sAPI
    ScaleZero -->|"patches scale"| K8sAPI
    Coordinator -->|"GPU rebalance"| K8sAPI
    BenchmarkBed -->|"drives load"| BenchmarkHarness

    %% KEDA active flow
    KEDAOp["KEDA Operator"]
    Blueprints -->|"configures"| KEDAOp
    KEDAOp -->|"queries metrics"| Prometheus
    KEDAOp -->|"drives HPA"| HPARes

    style Blueprints fill:#4a90e2,stroke:#333,stroke-width:2px
    style BenchmarkBed fill:#4a90e2,stroke:#333,stroke-width:2px
    style Manager fill:#999,stroke:#333,stroke-width:2px
    style SatEngine fill:#999,stroke:#333
    style ScaleZero fill:#999,stroke:#333
    style Coordinator fill:#999,stroke:#333
    style ConfigMapR fill:#999,stroke:#333
    style HPAR fill:#999,stroke:#333
    style InferencePoolR fill:#999,stroke:#333
    style ScaledObjectR fill:#999,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style KEDAOp fill:#7ed321,stroke:#333
    style InferencePoolCR fill:#ffe6cc,stroke:#d79b00
    style ScaledObjectCR fill:#ffe6cc,stroke:#d79b00
    style LWSCR fill:#ffe6cc,stroke:#d79b00
    style ConfigMapCR fill:#ffe6cc,stroke:#d79b00
    style HPARes fill:#ffe6cc,stroke:#d79b00
    style BenchmarkHarness fill:#e8e8e8,stroke:#333
