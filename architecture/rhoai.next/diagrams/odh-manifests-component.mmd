graph TB
    subgraph "odh-manifests Repository"
        direction TB

        subgraph "Deployment Profiles"
            KfDefCore["KfDef: odh-core<br/>11 components"]
            KfDefServing["KfDef: model-serving<br/>Minimal serving profile"]
        end

        subgraph "Model Serving Manifests"
            KServeBuilt["kserve-built<br/>19K-line monolithic bundle<br/>4 CRDs + Controller + RBAC"]
            ModelMesh["model-mesh<br/>ModelMesh controller +<br/>4 ClusterServingRuntimes"]
            OdhModelCtrl["odh-model-controller<br/>3 replicas, HA<br/>Go controller"]
        end

        subgraph "Platform Component Manifests"
            Dashboard["odh-dashboard<br/>+ RHOAI overlay (rhods)"]
            DSPO["data-science-pipelines-operator<br/>CRDs + Controller"]
            Notebook["odh-notebook-controller<br/>Kubeflow + ODH controllers"]
            TrustYAI["trustyai-service-operator<br/>Explainability service"]
            Monitoring["monitoring stack<br/>Prometheus + Grafana"]
            CodeFlare["codeflare-stack<br/>Distributed computing"]
            RayOp["ray/operator<br/>Ray cluster management"]
        end

        subgraph "Serving Runtimes"
            Triton["triton-2.x<br/>ClusterServingRuntime"]
            MLServer["mlserver-0.x<br/>ClusterServingRuntime"]
            OVMS["ovms-1.x<br/>ClusterServingRuntime"]
            TorchServe["torchserve-0.x<br/>ClusterServingRuntime"]
            OVMSTemplate["ovms (Template)<br/>ServingRuntime"]
            CaikitTemplate["caikit-tgis-runtime (Template)<br/>ServingRuntime"]
            TGISTemplate["tgis-grpc-runtime (Template)<br/>ServingRuntime"]
        end

        subgraph "Packaging"
            ContainerImage["UBI Container Image<br/>tar.gz manifest archive"]
        end
    end

    KfDefCore -->|composes| KServeBuilt
    KfDefCore -->|composes| ModelMesh
    KfDefCore -->|composes| Dashboard
    KfDefCore -->|composes| DSPO
    KfDefCore -->|composes| Notebook
    KfDefCore -->|composes| Monitoring
    KfDefServing -->|composes| KServeBuilt
    KfDefServing -->|composes| ModelMesh

    ModelMesh -->|defines| Triton
    ModelMesh -->|defines| MLServer
    ModelMesh -->|defines| OVMS
    ModelMesh -->|defines| TorchServe
    Dashboard -->|defines| OVMSTemplate
    Dashboard -->|defines| CaikitTemplate
    Dashboard -->|defines| TGISTemplate

    OdhModelCtrl -->|watches| KServeBuilt
    OdhModelCtrl -->|coordinates| ModelMesh

    ContainerImage -->|packages all| KfDefCore

