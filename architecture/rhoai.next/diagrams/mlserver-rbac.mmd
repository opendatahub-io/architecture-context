graph TD
    subgraph "MLServer Runtime Security Model"
        direction TB

        subgraph "Container Identity"
            Container["MLServer Container<br/>UID: 1000 (non-root)"]
            SA["ServiceAccount<br/>(managed by KServe per InferenceService)"]
        end

        subgraph "Kubernetes RBAC"
            NoRBAC["No ClusterRoles defined<br/>No ClusterRoleBindings defined<br/>No Roles defined<br/>No RoleBindings defined<br/><i>MLServer has no K8s API access</i>"]
        end

        subgraph "Application-Level Security Controls"
            direction TB

            TrustedRuntimes["Trusted Runtimes Allowlist<br/>/etc/mlserver/trusted-runtimes.json<br/><b>Production mode only</b>"]

            Enforcement1["ModelSettings Validation<br/>Checks implementation against allowlist<br/>at settings parse time"]
            Enforcement2["Implementation Property<br/>Checks implementation against allowlist<br/>at runtime load time"]

            CORSPolicy["CORS Policy (Production)<br/>Wildcard origins (*): BLOCKED<br/>Regex patterns: BLOCKED<br/>Only explicit origins allowed"]

            EnvBlocking["Custom Environment Blocking<br/>environment_tarball: BLOCKED<br/>environment_path: BLOCKED<br/>sys.path manipulation: PREVENTED"]
        end

        subgraph "Allowed Runtimes (CPU Image)"
            RT1["mlserver_sklearn.SKLearnModel"]
            RT2["mlserver_xgboost.XGBoostModel"]
            RT3["mlserver_lightgbm.LightGBMModel"]
            RT4["mlserver_onnx.ONNXModel"]
        end

        subgraph "Allowed Runtimes (CUDA Image)"
            RT5["mlserver_onnx.ONNXModel<br/>(CUDAExecutionProvider)"]
        end

        Container -->|"runs as"| SA
        SA -.->|"no K8s RBAC"| NoRBAC

        TrustedRuntimes -->|"validates"| Enforcement1
        TrustedRuntimes -->|"validates"| Enforcement2

        Enforcement1 -->|"allows"| RT1
        Enforcement1 -->|"allows"| RT2
        Enforcement1 -->|"allows"| RT3
        Enforcement1 -->|"allows"| RT4
        Enforcement1 -->|"allows"| RT5
    end

    subgraph "Platform Auth (External to MLServer)"
        KubeRBACProxy["kube-rbac-proxy<br/>Sidecar Container"]
        PlatformGW["Platform Gateway<br/>Auth Proxy"]
        KServeAuth["KServe Auth<br/>RequestAuthentication"]
    end

    KubeRBACProxy -->|"enforces auth before<br/>forwarding to MLServer"| Container
    PlatformGW -->|"TLS + auth<br/>at ingress"| Container
    KServeAuth -->|"JWT validation<br/>at gateway"| Container

    %% Styling
    style Container fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style NoRBAC fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style TrustedRuntimes fill:#f8cecc,stroke:#b85450
    style Enforcement1 fill:#f8cecc,stroke:#b85450
    style Enforcement2 fill:#f8cecc,stroke:#b85450
    style CORSPolicy fill:#f8cecc,stroke:#b85450
    style EnvBlocking fill:#f8cecc,stroke:#b85450
    style RT1 fill:#7ed321,stroke:#333
    style RT2 fill:#7ed321,stroke:#333
    style RT3 fill:#7ed321,stroke:#333
    style RT4 fill:#7ed321,stroke:#333
    style RT5 fill:#7ed321,stroke:#333
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00
    style PlatformGW fill:#ffe6cc,stroke:#d79b00
    style KServeAuth fill:#ffe6cc,stroke:#d79b00
