graph TD
    subgraph PodIdentity["MLServer Pod Identity"]
        Container["MLServer Container<br/>UID: 1000 (unprivileged)"]
        SA["KServe Service Account<br/>(managed by KServe controller)"]
    end

    subgraph AuthProxy["Authentication Proxy (RHOAI 3.x)"]
        KubeRBACProxy["kube-rbac-proxy Sidecar<br/>Injected by platform operator"]
        SAR["SubjectAccessReview<br/>(Kubernetes API)"]
    end

    subgraph ApplicationSecurity["Application-Level Security"]
        TrustedRuntimes["Trusted Runtimes Allowlist<br/>/etc/mlserver/trusted-runtimes.json<br/>(image-baked at build time)"]
        CORSPolicy["CORS Policy<br/>Wildcard ('*') rejected<br/>in PRODUCTION mode"]
        EnvRestriction["Custom Environment Restriction<br/>environment_tarball disabled<br/>environment_path disabled<br/>in PRODUCTION mode"]
    end

    subgraph NetworkSecurity["Network-Level Security"]
        NetworkPolicy["NetworkPolicy<br/>(platform-managed)"]
        MetricsAccess["/metrics endpoint<br/>8082/TCP<br/>Internal-only via NetworkPolicy"]
    end

    subgraph AccessFlow["Request Authorization Flow"]
        ExternalRequest["External Request<br/>HTTPS/8443"]
        TokenValidation["Bearer Token<br/>Validation"]
        RBACCheck["Kubernetes RBAC<br/>Authorization"]
        ForwardToApp["Forward to MLServer<br/>HTTP/8080 or gRPC/8081<br/>(plaintext, localhost)"]
    end

    %% Pod identity
    Container -->|"runs as"| SA

    %% Auth proxy flow
    ExternalRequest -->|"TLS terminated"| KubeRBACProxy
    KubeRBACProxy -->|"validates"| TokenValidation
    TokenValidation -->|"checks"| SAR
    SAR -->|"authorized"| RBACCheck
    RBACCheck -->|"allowed"| ForwardToApp
    ForwardToApp -->|"no auth (pre-authed)"| Container

    %% Application security
    Container -->|"validates model imports"| TrustedRuntimes
    Container -->|"enforces"| CORSPolicy
    Container -->|"enforces"| EnvRestriction

    %% Network security
    NetworkPolicy -->|"restricts access to"| MetricsAccess

    %% Notes
    Note1["NOTE: MLServer defines NO<br/>Kubernetes ClusterRoles,<br/>Roles, or RoleBindings.<br/>All RBAC is managed by<br/>KServe and the platform."]

    style Container fill:#4a90e2,color:#fff
    style SA fill:#4a90e2,color:#fff
    style KubeRBACProxy fill:#ef5350,color:#fff
    style SAR fill:#ef5350,color:#fff
    style TrustedRuntimes fill:#ff9800,color:#fff
    style CORSPolicy fill:#ff9800,color:#fff
    style EnvRestriction fill:#ff9800,color:#fff
    style NetworkPolicy fill:#66bb6a,color:#fff
    style MetricsAccess fill:#66bb6a,color:#fff
    style ExternalRequest fill:#e0e0e0,stroke:#616161
    style TokenValidation fill:#ffcdd2,stroke:#C62828
    style RBACCheck fill:#ffcdd2,stroke:#C62828
    style ForwardToApp fill:#c8e6c9,stroke:#388E3C
    style Note1 fill:#fff9c4,stroke:#F9A825,stroke-dasharray: 5 5
