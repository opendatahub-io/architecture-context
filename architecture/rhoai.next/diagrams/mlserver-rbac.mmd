graph TD
    subgraph "Platform-Delegated Authentication"
        KRBAC["kube-rbac-proxy Sidecar<br/>(Injected by KServe)"]
    end

    subgraph "Authentication Methods"
        OAuth["OpenShift OAuth Token"]
        SA["ServiceAccount Token"]
    end

    subgraph "Enforcement Points"
        REST_EP["REST Endpoints<br/>Port 8080/TCP<br/>All V2 Protocol routes"]
        GRPC_EP["gRPC Endpoints<br/>Port 8081/TCP<br/>All Inference RPCs"]
        Metrics_EP["Metrics Endpoint<br/>Port 8082/TCP<br/>GET /metrics"]
    end

    subgraph "Application Security Controls"
        TrustedRT["Trusted Runtimes Allowlist<br/>/etc/mlserver/trusted-runtimes.json"]
        CORSVal["CORS Validator<br/>Rejects wildcard origins<br/>in production mode"]
        EnvBlock["Environment Block<br/>Blocks environment_path and<br/>environment_tarball in production"]
    end

    subgraph "Protected Resources"
        Models["Model Inference<br/>/v2/models/*/infer"]
        ModelRepo["Model Repository<br/>/v2/repository/*"]
        ServerMeta["Server Metadata<br/>/v2, /v2/health/*"]
        RuntimeSec["Runtime Security<br/>/v2/runtimes"]
    end

    %% Auth flows
    OAuth -->|"validates"| KRBAC
    SA -->|"validates"| KRBAC
    KRBAC -->|"protects<br/>authenticated"| REST_EP
    KRBAC -->|"protects<br/>authenticated"| GRPC_EP
    Metrics_EP -.->|"NO AUTH<br/>unauthenticated"| Metrics_EP

    %% Endpoint to resource mapping
    REST_EP --> Models
    REST_EP --> ModelRepo
    REST_EP --> ServerMeta
    REST_EP --> RuntimeSec
    GRPC_EP --> Models
    GRPC_EP --> ModelRepo
    GRPC_EP --> ServerMeta
    GRPC_EP --> RuntimeSec

    %% Application-level security
    TrustedRT -->|"restricts model<br/>implementation classes"| Models
    TrustedRT -->|"restricts model<br/>loading"| ModelRepo
    CORSVal -->|"restricts cross-origin<br/>requests"| REST_EP
    EnvBlock -->|"blocks custom<br/>Python envs"| ModelRepo

    %% Styling
    style KRBAC fill:#f5a623,color:#000
    style OAuth fill:#4a90e2,color:#fff
    style SA fill:#4a90e2,color:#fff
    style REST_EP fill:#d5e8d4,stroke:#82b366
    style GRPC_EP fill:#d5e8d4,stroke:#82b366
    style Metrics_EP fill:#f8cecc,stroke:#b85450
    style TrustedRT fill:#e74c3c,color:#fff
    style CORSVal fill:#e74c3c,color:#fff
    style EnvBlock fill:#e74c3c,color:#fff
    style Models fill:#7ed321,color:#000
    style ModelRepo fill:#7ed321,color:#000
    style ServerMeta fill:#7ed321,color:#000
    style RuntimeSec fill:#7ed321,color:#000
