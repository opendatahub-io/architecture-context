graph TD
    subgraph Note["RBAC Summary"]
        direction TB
        Info["NeMo Guardrails is a stateless<br/>application-level service, NOT an operator.<br/>No Kubernetes RBAC resources defined."]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB

        subgraph Endpoints["HTTP Endpoints (port 8000)"]
            ChatEndpoint["/v1/chat/completions<br/>POST"]
            ChecksEndpoint["/v1/checks<br/>POST"]
            ModelsEndpoint["/v1/models<br/>GET"]
            HealthEndpoint["/v1/health, /healthz<br/>GET"]
            ConfigsEndpoint["/v1/rails/configs<br/>GET"]
        end

        subgraph AuthMechanisms["Auth Mechanisms"]
            HeaderPassthrough["Header Passthrough<br/>(Authorization header<br/>forwarded to upstream LLM)"]
            NoAuth["No Authentication<br/>(public endpoint)"]
            PlatformAuth["Platform-Level Auth<br/>(kube-rbac-proxy or<br/>ingress-level enforcement)"]
        end
    end

    ChatEndpoint -->|"auth"| HeaderPassthrough
    ChecksEndpoint -->|"auth"| HeaderPassthrough
    ModelsEndpoint -->|"auth"| HeaderPassthrough
    HealthEndpoint -->|"auth"| NoAuth
    ConfigsEndpoint -->|"auth"| NoAuth

    PlatformAuth -->|"enforces access to"| ChatEndpoint
    PlatformAuth -->|"enforces access to"| ChecksEndpoint
    PlatformAuth -->|"enforces access to"| ModelsEndpoint

    subgraph Secrets["Secrets"]
        LLMKeys["LLM API Keys (Opaque)<br/>OPENAI_API_KEY, etc.<br/>Manual provisioning<br/>No auto-rotation"]
    end

    subgraph MultiTenancy["Multi-Tenancy Isolation"]
        ConfigId["config_id Routing<br/>(per-tenant guardrails config)"]
        PathProtection["Path Traversal Protection<br/>(rejects '..' and '/' in config_id)"]
        ThreadIsolation["Thread Isolation<br/>(per-thread-id message storage)"]
    end

    HeaderPassthrough -->|"uses"| LLMKeys
    ConfigId --> PathProtection
    ConfigId --> ThreadIsolation

    %% Styling
    style Info fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style ChatEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style ChecksEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style ModelsEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style HealthEndpoint fill:#28a745,stroke:#333,color:#fff
    style ConfigsEndpoint fill:#28a745,stroke:#333,color:#fff
    style HeaderPassthrough fill:#f5a623,stroke:#333
    style NoAuth fill:#28a745,stroke:#333,color:#fff
    style PlatformAuth fill:#9b59b6,stroke:#333,color:#fff
    style LLMKeys fill:#dc3545,stroke:#333,color:#fff
    style ConfigId fill:#17a2b8,stroke:#333,color:#fff
    style PathProtection fill:#17a2b8,stroke:#333,color:#fff
    style ThreadIsolation fill:#17a2b8,stroke:#333,color:#fff
