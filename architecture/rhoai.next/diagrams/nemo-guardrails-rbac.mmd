graph TD
    subgraph SecurityModel["NeMo Guardrails Security Model"]
        direction TB

        Note["⚠️ NeMo Guardrails has NO built-in RBAC<br/>No ClusterRoles, Roles, or RoleBindings<br/>It is a standalone containerized service"]
    end

    subgraph ExternalEnforcement["External Security Enforcement (Required)"]
        direction TB

        subgraph Option1["Option A: kube-rbac-proxy Sidecar"]
            KRBAC["kube-rbac-proxy<br/>Sidecar Container"]
            KRBAC -->|"Authenticates &<br/>authorizes requests"| ServerA["NeMo Guardrails<br/>8000/TCP"]
        end

        subgraph Option2["Option B: Istio Authorization"]
            IstioAP["Istio AuthorizationPolicy"]
            IstioRA["Istio RequestAuthentication<br/>(JWT validation)"]
            IstioAP -->|"Enforces access control"| ServerB["NeMo Guardrails<br/>8000/TCP"]
            IstioRA -->|"Validates tokens"| IstioAP
        end

        subgraph Option3["Option C: Network Policy"]
            NetPol["Kubernetes NetworkPolicy"]
            NetPol -->|"Restricts pod-to-pod<br/>network access"| ServerC["NeMo Guardrails<br/>8000/TCP"]
        end
    end

    subgraph HeaderSecurity["Header-Based Auth Forwarding"]
        direction LR

        IncomingReq["Incoming Request<br/>X-Authorization: Bearer <token><br/>X-Custom-Header: value"]
        HeaderFwd["header_forwarding.py"]
        UpstreamLLM["Upstream LLM Provider"]

        IncomingReq -->|"Extract X-* headers"| HeaderFwd
        HeaderFwd -->|"Authorization: Bearer <token><br/>Custom-Header: value"| UpstreamLLM

        subgraph Stripped["Headers Stripped"]
            XForwarded["x-forwarded-*"]
            XReal["x-real-*"]
            XRequestId["x-request-id"]
        end

        HeaderFwd -.->|"Excluded"| Stripped
    end

    subgraph Secrets["Secrets Management"]
        direction TB

        EnvVars["Environment Variables<br/>(Opaque)"]
        EnvVars --- Key1["OPENAI_API_KEY"]
        EnvVars --- Key2["ANTHROPIC_API_KEY"]
        EnvVars --- Key3["AZURE_OPENAI_API_KEY"]
        EnvVars --- Key4["COHERE_API_KEY"]
        EnvVars --- Key5["GOOGLE_API_KEY"]

        ProvisionNote["Provisioned by: Manual / External Secret Mgmt<br/>Auto-Rotate: No<br/>Never persisted to disk"]
    end

    subgraph InputValidation["Defense-in-Depth Input Validation"]
        direction TB

        PathTraversal["Path Traversal Prevention<br/>(config ID validation)"]
        ThreadIDLen["Minimum Thread ID Length<br/>Enforcement"]
        HeaderSanitize["Request Header Sanitization<br/>(infrastructure prefix stripping)"]
    end

    %% Styling
    style SecurityModel fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    style ExternalEnforcement fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style HeaderSecurity fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style InputValidation fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style Stripped fill:#f8cecc,stroke:#b85450

    style Note fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    style KRBAC fill:#82b366,stroke:#333
    style IstioAP fill:#82b366,stroke:#333
    style IstioRA fill:#82b366,stroke:#333
    style NetPol fill:#82b366,stroke:#333
    style HeaderFwd fill:#4a90e2,stroke:#333,color:#fff
    style EnvVars fill:#f5a623,stroke:#333
    style ProvisionNote fill:#fff2cc,stroke:#d6b656
