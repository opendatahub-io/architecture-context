graph TD
    subgraph AppAuth["Application-Level Auth (No Kubernetes RBAC)"]
        direction TB
        Note["NeMo Guardrails is a standalone application service<br/>No ClusterRoles, Roles, or RoleBindings defined"]
    end

    subgraph HeaderForwarding["Header Forwarding Auth Model"]
        direction TB
        InboundReq["Inbound Request"]
        XAuth["X-Authorization Header"]
        Auth["Authorization Header"]
        OutboundReq["Outbound LLM Request"]

        InboundReq -->|"carries"| XAuth
        InboundReq -->|"carries"| Auth
        XAuth -->|"mapped to Authorization"| OutboundReq
        Auth -->|"NEVER forwarded"| Blocked["Blocked"]
    end

    subgraph Endpoints["Endpoint Auth Matrix"]
        direction TB
        ChatEndpoint["/v1/chat/completions<br/>Auth: Header forwarding"]
        ModelsEndpoint["/v1/models<br/>Auth: Header forwarding"]
        ChecksEndpoint["/v1/checks<br/>Auth: None"]
        HealthEndpoint["/v1/health, /healthz<br/>Auth: None"]
        ConfigsEndpoint["/v1/rails/configs<br/>Auth: None"]
        ActionsEndpoint["/v1/actions/*<br/>Auth: None"]
    end

    subgraph Secrets["API Key Secrets (Environment Variables)"]
        direction TB
        AzureKey["AZURE_OPENAI_API_KEY<br/>Azure OpenAI"]
        ActiveFence["ACTIVEFENCE_API_KEY<br/>Content moderation"]
        CrowdStrike["CS_AIDR_TOKEN<br/>AI Detection & Response"]
        Pangea["PANGEA_API_TOKEN<br/>Security API"]
        OtherKeys["+ 10 more provider keys<br/>(all optional, profile-dependent)"]
    end

    subgraph MultiTenancy["Multi-Tenancy Isolation"]
        direction TB
        ConfigID["Tenant Boundary: config_id"]
        SharedProcess["Shared Process Memory"]
        NoRBACPerConfig["No per-config-id RBAC"]
        Risk["Risk: Any client can<br/>access any config_id"]

        ConfigID --> SharedProcess
        SharedProcess --> NoRBACPerConfig
        NoRBACPerConfig --> Risk
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style Blocked fill:#f8cecc,stroke:#b85450
    style ChatEndpoint fill:#d5e8d4,stroke:#82b366
    style ModelsEndpoint fill:#d5e8d4,stroke:#82b366
    style ChecksEndpoint fill:#fff2cc,stroke:#d6b656
    style HealthEndpoint fill:#fff2cc,stroke:#d6b656
    style ConfigsEndpoint fill:#fff2cc,stroke:#d6b656
    style ActionsEndpoint fill:#fff2cc,stroke:#d6b656
    style Risk fill:#f8cecc,stroke:#b85450
    style AzureKey fill:#e1d5e7,stroke:#9673a6
    style ActiveFence fill:#e1d5e7,stroke:#9673a6
    style CrowdStrike fill:#e1d5e7,stroke:#9673a6
    style Pangea fill:#e1d5e7,stroke:#9673a6
    style OtherKeys fill:#e1d5e7,stroke:#9673a6
