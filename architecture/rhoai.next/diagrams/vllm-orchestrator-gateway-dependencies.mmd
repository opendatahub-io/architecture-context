graph LR
    Gateway["vllm-orchestrator-gateway<br/>(Rust Service)"]

    %% Internal Platform Dependencies
    Gateway -->|"REST API<br/>POST /api/v2/chat/completions-detection<br/>HTTP/HTTPS 8085"| Orchestrator["FMS Guardrails<br/>Orchestrator"]
    Orchestrator -->|"delegates detection"| Detectors["Content Detectors<br/>(PII, Toxicity, Regex)"]
    Orchestrator -->|"inference requests"| vLLM["vLLM Inference Server"]

    %% Platform Service Dependencies
    Gateway -.->|"CA cert mount<br/>/etc/tls/ca/service-ca.crt"| ServiceCA["OpenShift service-ca"]
    Gateway -.->|"client cert/key mount<br/>/etc/tls/private/"| CertProvisioner["Platform TLS Provisioner<br/>(cert-manager)"]

    %% Runtime Dependencies
    Gateway -.->|"system OpenSSL<br/>(FIPS-compatible)"| OpenSSL["OpenSSL<br/>(via UBI9)"]

    %% Consumers
    Client["API Clients"] -->|"POST /{route}/v1/chat/completions<br/>HTTP 8090"| Gateway

    %% Key Rust Crate Dependencies
    subgraph "Key Rust Dependencies"
        Axum["axum 0.7.9<br/>(HTTP framework)"]
        Tokio["tokio 1.41.1<br/>(async runtime)"]
        Reqwest["reqwest 0.12.12<br/>(HTTP client, native-tls)"]
        OpenSSLCrate["openssl 0.10.73<br/>(PKCS#12 + mTLS)"]
    end

    Gateway -.->|"built with"| Axum
    Gateway -.->|"built with"| Tokio
    Gateway -.->|"built with"| Reqwest
    Gateway -.->|"built with"| OpenSSLCrate

    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style Detectors fill:#7ed321,stroke:#333,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style ServiceCA fill:#dae8fc,stroke:#6c8ebf
    style CertProvisioner fill:#dae8fc,stroke:#6c8ebf
    style OpenSSL fill:#dae8fc,stroke:#6c8ebf
    style Client fill:#f9f9f9,stroke:#999
    style Axum fill:#e8e8e8,stroke:#333
    style Tokio fill:#e8e8e8,stroke:#333
    style Reqwest fill:#e8e8e8,stroke:#333
    style OpenSSLCrate fill:#e8e8e8,stroke:#333
