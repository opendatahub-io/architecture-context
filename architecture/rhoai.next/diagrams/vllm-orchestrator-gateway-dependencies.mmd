graph LR
    Gateway["vllm-orchestrator-gateway<br/>(Rust/axum)"]

    %% Internal Platform Dependencies
    Gateway -->|"POST /api/v2/chat/completions-detection<br/>HTTP or HTTPS/8085<br/>Optional mTLS"| Orchestrator["FMS Guardrails<br/>Orchestrator"]
    Gateway -.->|"indirect (via orchestrator)<br/>detector names in config"| Detectors["Detector Services<br/>(e.g., guardrails-regex-detector)"]
    Gateway -.->|"indirect (via orchestrator)<br/>LLM inference backend"| vLLM["vLLM Inference Server"]

    %% Infrastructure Dependencies
    Gateway -->|"client cert provisioning<br/>/etc/tls/private/"| CertSigner["OpenShift<br/>service-serving-cert-signer"]
    Gateway -->|"CA cert provisioning<br/>/etc/tls/ca/"| CAOperator["OpenShift<br/>service-ca-operator"]

    %% Key Rust Crate Dependencies
    subgraph RustCrates["Key Rust Dependencies"]
        axum["axum 0.7.9<br/>(HTTP framework)"]
        reqwest["reqwest 0.12.12<br/>(HTTP client)"]
        tokio["tokio 1.41.1<br/>(async runtime)"]
        openssl_crate["openssl 0.10.73<br/>(TLS/PKCS12)"]
        native_tls["native-tls 0.2.12<br/>(TLS backend)"]
        serde["serde / serde_json<br/>(JSON serialization)"]
        serde_yml["serde_yml 0.0.12<br/>(YAML config)"]
        futures_crate["futures 0.3.30<br/>(SSE streaming)"]
    end

    Gateway -->|"built with"| axum
    Gateway -->|"built with"| reqwest
    Gateway -->|"built with"| tokio
    Gateway -->|"built with"| openssl_crate
    Gateway -->|"built with"| native_tls
    Gateway -->|"built with"| serde
    Gateway -->|"built with"| serde_yml
    Gateway -->|"built with"| futures_crate

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Detectors fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style CertSigner fill:#999,stroke:#333,color:#fff
    style CAOperator fill:#999,stroke:#333,color:#fff
    style axum fill:#f5a623,stroke:#333
    style reqwest fill:#f5a623,stroke:#333
    style tokio fill:#f5a623,stroke:#333
    style openssl_crate fill:#f5a623,stroke:#333
    style native_tls fill:#f5a623,stroke:#333
    style serde fill:#f5a623,stroke:#333
    style serde_yml fill:#f5a623,stroke:#333
    style futures_crate fill:#f5a623,stroke:#333
