graph LR
    Gateway["vllm-orchestrator-gateway<br/>Rust Service (axum)"]

    %% Internal Platform Dependencies
    Gateway -->|"POST /api/v2/chat/completions-detection<br/>HTTP/HTTPS 8085/TCP<br/>optional mTLS"| Orchestrator["FMS Guardrails<br/>Orchestrator"]
    Orchestrator -->|"detector calls"| Detectors["Detector Services<br/>(e.g., guardrails-regex-detector)"]
    Orchestrator -->|"LLM inference"| vLLM["vLLM Model Server"]

    %% Infrastructure Dependencies
    Gateway -.->|"CA cert provisioning<br/>/etc/tls/ca/service-ca.crt"| ServiceCA["OpenShift<br/>service-ca"]
    Gateway -.->|"TLS cert+key provisioning<br/>/etc/tls/private/"| CertManager["cert-manager /<br/>cluster CA"]

    %% Integration Points (consumers)
    Clients["AI Application<br/>Clients"] -->|"POST /{route}/v1/chat/completions<br/>HTTP 8090/TCP"| Gateway

    %% Key Rust Dependencies
    subgraph RustDeps["Key Rust Crate Dependencies"]
        Axum["axum 0.7.9<br/>HTTP framework"]
        Reqwest["reqwest 0.12.12<br/>HTTP client"]
        Tokio["tokio 1.41.1<br/>Async runtime"]
        OpenSSL["openssl 0.10.73<br/>TLS/mTLS cert handling"]
        NativeTLS["native-tls 0.2.12<br/>TLS backend"]
        Serde["serde + serde_json<br/>JSON serialization"]
        SerdeYml["serde_yml 0.0.12<br/>YAML config parsing"]
        TowerHTTP["tower-http 0.6.2<br/>Tracing middleware"]
    end

    Gateway -.->|"built with"| RustDeps

    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Detectors fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style ServiceCA fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style Clients fill:#f5a623,stroke:#333
    style Axum fill:#e8e8e8,stroke:#333
    style Reqwest fill:#e8e8e8,stroke:#333
    style Tokio fill:#e8e8e8,stroke:#333
    style OpenSSL fill:#e8e8e8,stroke:#333
    style NativeTLS fill:#e8e8e8,stroke:#333
    style Serde fill:#e8e8e8,stroke:#333
    style SerdeYml fill:#e8e8e8,stroke:#333
    style TowerHTTP fill:#e8e8e8,stroke:#333
