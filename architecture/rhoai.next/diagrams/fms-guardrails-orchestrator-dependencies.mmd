graph LR
    Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies
    Orchestrator -->|"content detection<br/>HTTP/HTTPS 8080/TCP"| Detectors["Detector Services<br/>(HAP, Toxicity, PII)"]
    Orchestrator -->|"text chunking<br/>gRPC 8085/TCP"| Chunker["Chunker Services<br/>(Caikit Runtime)"]
    Orchestrator -->|"text generation<br/>gRPC 8033/TCP"| TGIS["TGIS<br/>(fmaas protocol)"]
    Orchestrator -->|"text gen + tokenize<br/>gRPC 8085/TCP"| CaikitNLP["Caikit NLP"]
    Orchestrator -->|"chat completions<br/>HTTP/HTTPS 8080/TCP"| OpenAILLM["OpenAI-compatible LLM<br/>(e.g., vLLM)"]

    %% Infrastructure Dependencies
    Orchestrator -.->|"traces + metrics<br/>OTLP 4317/4318"| OTLP["OTLP Collector"]

    %% External Library Dependencies (key ones)
    subgraph RustDeps["Key Rust Dependencies"]
        direction TB
        Axum["axum 0.8.8<br/>(HTTP server)"]
        Tonic["tonic 0.14.2<br/>(gRPC client)"]
        Rustls["rustls 0.23.36<br/>(TLS - ring backend)"]
        Tokio["tokio 1.49.0<br/>(async runtime)"]
        OTelLib["opentelemetry 0.31.0<br/>(observability)"]
        Ginepro["ginepro<br/>(gRPC load balancing)"]
    end

    Orchestrator -.->|"built with"| RustDeps

    %% Reverse dependencies (what depends on orchestrator)
    subgraph Consumers["Consumers (via deploying operator)"]
        direction TB
        AIApps["AI Applications"]
    end

    AIApps -->|"guardrails API<br/>HTTP/HTTPS 8033/TCP"| Orchestrator

    style Orchestrator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Detectors fill:#7ed321,stroke:#333
    style Chunker fill:#7ed321,stroke:#333
    style TGIS fill:#7ed321,stroke:#333
    style CaikitNLP fill:#7ed321,stroke:#333
    style OpenAILLM fill:#f5a623,stroke:#333
    style OTLP fill:#999,stroke:#333,color:#fff
    style Axum fill:#e8e8e8,stroke:#333
    style Tonic fill:#e8e8e8,stroke:#333
    style Rustls fill:#e8e8e8,stroke:#333
    style Tokio fill:#e8e8e8,stroke:#333
    style OTelLib fill:#e8e8e8,stroke:#333
    style Ginepro fill:#e8e8e8,stroke:#333
    style AIApps fill:#f9f9f9,stroke:#999
