graph LR
    Orchestrator["FMS Guardrails Orchestrator<br/>(Rust, axum + tonic)"]

    %% Downstream Service Dependencies
    Orchestrator -->|"gRPC 8033/TCP<br/>text generation"| TGIS["TGIS Generation Service"]
    Orchestrator -->|"gRPC 8085/TCP<br/>text chunking"| Chunker["Chunker Services<br/>(caikit chunker API)"]
    Orchestrator -->|"REST 8080/TCP<br/>content safety"| Detector["Detector Services<br/>(HAP, toxicity)"]
    Orchestrator -->|"REST 8081/TCP<br/>health probing"| DetectorHealth["Detector Health Services"]
    Orchestrator -->|"REST configurable<br/>chat/text completions"| OpenAISvc["OpenAI-Compatible Service"]

    %% Observability
    Orchestrator -.->|"gRPC/HTTP<br/>traces + metrics"| OTLP["OTLP Collector"]

    %% Key Library Dependencies
    subgraph RustCrates["Key Rust Crates"]
        axum["axum 0.8.8<br/>(HTTP framework)"]
        tonic["tonic 0.14.2<br/>(gRPC client)"]
        rustls["rustls 0.23.36<br/>(TLS, ring provider)"]
        reqwest["reqwest 0.12.28<br/>(HTTP client)"]
        tokio["tokio 1.49.0<br/>(async runtime)"]
        otel["opentelemetry 0.31.0<br/>(observability)"]
        ginepro["ginepro<br/>(gRPC load balancing)"]
    end

    Orchestrator ---|"web framework"| axum
    Orchestrator ---|"gRPC client"| tonic
    Orchestrator ---|"TLS stack"| rustls
    Orchestrator ---|"REST client"| reqwest
    Orchestrator ---|"async runtime"| tokio
    Orchestrator ---|"tracing/metrics"| otel
    Orchestrator ---|"DNS load balance"| ginepro

    %% Platform Dependencies
    Orchestrator -.->|"health probes<br/>8034/TCP"| K8s["Kubernetes Platform<br/>(kubelet)"]

    style Orchestrator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TGIS fill:#999,stroke:#333
    style Chunker fill:#999,stroke:#333
    style Detector fill:#999,stroke:#333
    style DetectorHealth fill:#999,stroke:#333
    style OpenAISvc fill:#999,stroke:#333
    style OTLP fill:#f5a623,stroke:#333
    style K8s fill:#f5a623,stroke:#333
    style axum fill:#d5e8d4,stroke:#82b366
    style tonic fill:#d5e8d4,stroke:#82b366
    style rustls fill:#d5e8d4,stroke:#82b366
    style reqwest fill:#d5e8d4,stroke:#82b366
    style tokio fill:#d5e8d4,stroke:#82b366
    style otel fill:#d5e8d4,stroke:#82b366
    style ginepro fill:#d5e8d4,stroke:#82b366
