graph LR
    Orch["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies (gRPC backends)
    Orch -->|"gRPC 8033/TCP<br/>Generate/GenerateStream<br/>3 retries + backoff"| TGIS["TGIS<br/>Text Generation<br/>Inference Server"]
    Orch -->|"gRPC 8085/TCP<br/>TextGenerationTaskPredict"| CaikitNLP["Caikit NLP<br/>Service"]
    Orch -->|"gRPC 8085/TCP<br/>ChunkerTokenizationTaskPredict<br/>+ bidi-streaming"| CaikitChunker["Caikit Chunker<br/>Service"]

    %% Internal Platform Dependencies (HTTP backends)
    Orch -->|"HTTP/HTTPS 8080/TCP<br/>/api/v1/text/*<br/>Bearer token"| Detectors["Detector<br/>Service(s)"]
    Orch -->|"HTTP/HTTPS 8080/TCP<br/>/v1/chat/completions<br/>Bearer token"| vLLM["OpenAI-compatible<br/>LLM (e.g., vLLM)"]

    %% Observability
    Orch -.->|"OTLP 4317/4318 TCP<br/>traces + metrics"| OTel["OpenTelemetry<br/>Collector"]

    %% Key External Library Dependencies
    subgraph RustDeps["Key Rust Dependencies"]
        axum["axum 0.8.8<br/>HTTP framework"]
        tonic["tonic 0.14.2<br/>gRPC framework"]
        rustls["rustls 0.23.36<br/>TLS (ring backend)"]
        hyper["hyper 1.8.1<br/>HTTP server"]
        reqwest["reqwest 0.12.28<br/>HTTP client"]
        otelSDK["opentelemetry 0.31.0<br/>Observability SDK"]
        ginepro["ginepro<br/>gRPC load balancing"]
    end

    Orch -.->|"build dep"| axum
    Orch -.->|"build dep"| tonic
    Orch -.->|"build dep"| rustls
    Orch -.->|"build dep"| hyper
    Orch -.->|"build dep"| reqwest
    Orch -.->|"build dep"| otelSDK
    Orch -.->|"build dep"| ginepro

    %% Styling
    style Orch fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TGIS fill:#7ed321,stroke:#333
    style CaikitNLP fill:#7ed321,stroke:#333
    style CaikitChunker fill:#7ed321,stroke:#333
    style Detectors fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
    style OTel fill:#f5a623,stroke:#333
    style axum fill:#e8e8e8,stroke:#333
    style tonic fill:#e8e8e8,stroke:#333
    style rustls fill:#e8e8e8,stroke:#333
    style hyper fill:#e8e8e8,stroke:#333
    style reqwest fill:#e8e8e8,stroke:#333
    style otelSDK fill:#e8e8e8,stroke:#333
    style ginepro fill:#e8e8e8,stroke:#333
