graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Platform Admin<br/>kubectl / API client"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - K8s Network)"]
        direction TB

        subgraph NS_WVA["Namespace: wva-system"]
            WVA["WVA Controller Manager<br/>SA: controller-manager<br/>Ports: 8443/TCP (metrics), 8081/TCP (health)"]
        end

        subgraph NS_Monitoring["Namespace: openshift-monitoring"]
            Prometheus["Prometheus / Thanos Querier<br/>443/TCP or 9090/TCP<br/>TLS 1.2+"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            HPA["HPA / KEDA<br/>llm-d.ai/managed=true"]
            InfDeploy["Inference Deployment<br/>vLLM / SGLang pods"]
            EPP["Gateway API EPP<br/>Pod port HTTP/HTTPS"]
            ConfigMaps["ConfigMaps<br/>saturation / queueing-model /<br/>scale-to-zero config"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]

        subgraph NS_Nodes["Cluster Nodes"]
            Nodes["Worker Nodes<br/>GPU operator labels<br/>NVIDIA / AMD / Intel"]
        end
    end

    %% Admin to K8s
    Admin -->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig auth"| K8sAPI

    %% WVA to Prometheus
    WVA -->|"HTTPS/443 or HTTP/9090<br/>TLS 1.2+ (configurable)<br/>Bearer Token (SA token)"| Prometheus

    %% WVA to K8s API
    WVA -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (SA token)<br/>watch/patch HPA, ScaledObject,<br/>Deployment, ConfigMap, Node"| K8sAPI

    %% WVA to EPP
    WVA -->|"HTTP or HTTPS/Pod port<br/>Configurable TLS<br/>Bearer Token (optional)<br/>flow-control queue scrape"| EPP

    %% HPA reads WVA metrics
    HPA -->|"HTTPS/8443<br/>TLS (self-signed or Service CA)<br/>Bearer Token + authn/authz<br/>wva_desired_replicas"| WVA

    %% HPA scales deployments
    HPA -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>scale subresource"| K8sAPI

    %% Prometheus scrapes WVA (via ServiceMonitor)
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>ServiceMonitor scrape"| WVA

    %% Health probes
    K8sAPI -->|"HTTP/8081<br/>No TLS, No Auth<br/>liveness/readiness probes"| WVA

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef wva fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef monitoring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef userspace fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8sapi fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef nodes fill:#e8e8e8,stroke:#666,stroke-width:1px

    class Admin external
    class WVA wva
    class Prometheus monitoring
    class HPA,InfDeploy,EPP,ConfigMaps userspace
    class K8sAPI k8sapi
    class Nodes nodes
