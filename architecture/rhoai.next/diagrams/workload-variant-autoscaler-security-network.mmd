graph TB
    subgraph Monitoring["MONITORING / OBSERVABILITY"]
        Prometheus["Prometheus / Thanos Querier<br/>9090-9091/TCP<br/>HTTPS, TLS 1.2+<br/>Bearer Token (SA)"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE"]
        direction TB

        WVA["WVA Controller Manager<br/>SA: controller-manager<br/>Replicas: 1 (leader-elected)<br/>FIPS: strictfipsruntime"]

        MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS, TLS (service-ca)"]

        HealthPort["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]

        NetPol["NetworkPolicy:<br/>allow-metrics-traffic<br/>(all ingress allowed)"]

        WVA --- MetricsSvc
        WVA --- HealthPort
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (SA)"]
    end

    subgraph InferenceNS["INFERENCE WORKLOAD NAMESPACES"]
        direction TB

        InferencePods["vLLM / SGLang Pods<br/>configurable/TCP<br/>HTTP/HTTPS<br/>Optional TLS + Auth"]

        EPP["EPP (Endpoint Picker)<br/>Prometheus metrics<br/>SA: epp-metrics-reader"]

        HPA["HPA / KEDA ScaledObject<br/>annotation: llm-d.ai/managed"]

        Deployments["Deployment / LWS<br/>(Scale targets)"]
    end

    %% Flows from WVA
    WVA -->|"PromQL queries<br/>HTTPS/9090-9091<br/>TLS 1.2+<br/>Bearer Token (SA)"| Prometheus
    WVA -->|"Watch/List/Update<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (SA)"| K8sAPI
    WVA -->|"Direct pod scrape<br/>HTTP(S)/configurable<br/>Optional TLS<br/>Optional Bearer Token"| InferencePods
    WVA -->|"Scale-from-zero patch<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (SA)"| Deployments

    %% Prometheus scrapes WVA
    Prometheus -->|"Scrape /metrics<br/>HTTPS/8443<br/>TLS (service-ca)<br/>Bearer Token (RBAC)"| MetricsSvc

    %% HPA/KEDA reads from Prometheus
    HPA -->|"Query wva_desired_replicas<br/>HTTPS<br/>TLS 1.2+<br/>Bearer Token"| Prometheus
    HPA -->|"Scale subresource<br/>HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI
    K8sAPI -->|"Scale replicas"| Deployments

    %% Styling
    classDef monitoring fill:#e8daef,stroke:#8e44ad,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef service fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Prometheus monitoring
    class WVA,HealthPort controller
    class MetricsSvc,NetPol service
    class K8sAPI k8s
    class InferencePods,EPP,HPA,Deployments inference
