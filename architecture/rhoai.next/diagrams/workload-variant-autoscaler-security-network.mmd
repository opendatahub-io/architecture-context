graph TB
    subgraph IngressZone["INGRESS (Metrics Consumers)"]
        direction TB
        HPA["HPA / KEDA<br/>reads wva_desired_replicas"]
        PromScraper["Prometheus<br/>(ServiceMonitor)"]
    end

    subgraph ControllerZone["WVA CONTROLLER (wva-system namespace)"]
        direction TB

        subgraph MetricsSvc["controller-manager-metrics-service (ClusterIP)"]
            MetricsEP["/metrics<br/>8443/TCP HTTPS<br/>TLS (self-signed / Service CA)<br/>Bearer Token + authn/authz"]
        end

        subgraph HealthSvc["controller-manager-health-service (ClusterIP)"]
            HealthEP["/healthz /readyz<br/>8081/TCP HTTP<br/>No encryption<br/>No auth"]
        end

        Controller["WVA Controller Manager<br/>SA: controller-manager<br/>FIPS: strictfipsruntime + CGO"]
    end

    subgraph EgressZone["EGRESS DESTINATIONS"]
        direction TB

        Prometheus["Prometheus / Thanos Querier<br/>443/TCP or 9090/TCP<br/>HTTPS (TLS 1.2+)<br/>Bearer Token (SA token)"]

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (SA token)"]

        EPP["Gateway API EPP<br/>Pod port HTTP/HTTPS<br/>Configurable encryption<br/>Bearer Token (optional)"]
    end

    %% Ingress flows
    HPA -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| MetricsEP
    PromScraper -->|"HTTPS/8443<br/>TLS<br/>Bearer Token (SA)"| MetricsEP

    %% Internal
    Controller --- MetricsEP
    Controller --- HealthEP

    %% Egress flows
    Controller -->|"HTTPS/443 or 9090<br/>TLS 1.2+<br/>Bearer Token (SA)"| Prometheus
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (SA)"| K8sAPI
    Controller -->|"HTTP(S)/Pod port<br/>Configurable<br/>Bearer Token (opt)"| EPP

    %% Styling
    classDef controller fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef health fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Controller controller
    class MetricsEP service
    class HealthEP health
    class HPA,PromScraper ingress
    class Prometheus,K8sAPI,EPP egress
