graph TB
    subgraph Sidecar["llm-d-routing-sidecar"]
        direction TB
        Mux["HTTP ServeMux<br/>Port 8000/TCP TLS 1.2+"]
        Health["Health Handler<br/>GET /health"]
        ChatHandler["Chat Completions Handler<br/>POST /v1/chat/completions"]
        CompHandler["Completions Handler<br/>POST /v1/completions"]
        Passthrough["Catch-All Passthrough<br/>Reverse Proxy"]

        subgraph Connectors["Connector Protocols"]
            NIXLv2["NIXL v2 Protocol<br/>(current)"]
            NIXLv1["NIXL v1 Protocol<br/>(deprecated)"]
            LMCache["LMCache Protocol<br/>(deprecated)"]
        end

        subgraph SSRFProtection["SSRF Protection"]
            Allowlist["AllowlistValidator"]
            PodInformer["Pod Informer"]
            PoolInformer["InferencePool Informer"]
        end

        ProxyCache["Prefiller Proxy LRU Cache<br/>(16 entries)"]

        Mux --> Health
        Mux --> ChatHandler
        Mux --> CompHandler
        Mux --> Passthrough

        ChatHandler -->|"validates host"| Allowlist
        CompHandler -->|"validates host"| Allowlist
        ChatHandler -->|"dispatches"| Connectors
        CompHandler -->|"dispatches"| Connectors
        Connectors -->|"cached proxy"| ProxyCache

        PoolInformer -->|"label selector"| PodInformer
        PodInformer -->|"rebuilds"| Allowlist
    end

    Client["Client"] -->|"HTTPS/8000<br/>TLS 1.2+"| Mux

    subgraph External["External Dependencies"]
        Decoder["vLLM Decoder<br/>(co-located)"]
        Prefiller["vLLM Prefiller<br/>(remote)"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
    end

    InferencePoolCR["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]

    Passthrough -->|"HTTP(S)/8001"| Decoder
    Connectors -->|"prefill request"| Prefiller
    Connectors -->|"decode request"| Decoder

    PoolInformer -->|"watches"| InferencePoolCR
    PodInformer -->|"watches pods"| K8sAPI
    PoolInformer -->|"watches pool"| K8sAPI

    style Mux fill:#4a90e2,color:#fff
    style ChatHandler fill:#4a90e2,color:#fff
    style CompHandler fill:#4a90e2,color:#fff
    style Health fill:#4a90e2,color:#fff
    style Passthrough fill:#4a90e2,color:#fff
    style NIXLv2 fill:#7ed321,color:#fff
    style NIXLv1 fill:#999,color:#fff
    style LMCache fill:#999,color:#fff
    style Allowlist fill:#f5a623,color:#fff
    style PodInformer fill:#f5a623,color:#fff
    style PoolInformer fill:#f5a623,color:#fff
    style ProxyCache fill:#4a90e2,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style Decoder fill:#e8e8e8,stroke:#333
    style Prefiller fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style InferencePoolCR fill:#f5a623,color:#fff
