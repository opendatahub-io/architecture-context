graph TB
    subgraph "llm-d-routing-sidecar"
        direction TB
        Proxy["Reverse Proxy<br/>(Go HTTP Server)<br/>Port 8000/TCP HTTPS"]
        AllowlistValidator["AllowlistValidator<br/>(K8s Informer)<br/>SSRF Protection"]
        ConnectorNIXLv2["NIXL v2 Connector<br/>(default protocol)"]
        ConnectorNIXLv1["NIXL v1 Connector<br/>(deprecated)"]
        ConnectorLMCache["LMCache Connector<br/>(deprecated)"]
        TLSManager["TLS Manager<br/>Self-signed or external cert<br/>RSA 4096-bit"]

        Proxy -->|validates prefiller target| AllowlistValidator
        Proxy -->|prefill/decode protocol| ConnectorNIXLv2
        Proxy -.->|legacy protocol| ConnectorNIXLv1
        Proxy -.->|legacy protocol| ConnectorLMCache
        Proxy -->|TLS termination| TLSManager
    end

    Client["Client / Gateway EPP"] -->|"POST /v1/chat/completions<br/>HTTPS 8000/TCP<br/>x-prefiller-host-port header"| Proxy

    Proxy -->|"HTTP/HTTPS<br/>dynamic port"| Prefiller["Remote Prefiller Pod<br/>(vLLM)"]
    Proxy -->|"HTTP/HTTPS<br/>8001/TCP (default)"| Decoder["Local vLLM Decoder<br/>(co-located)"]

    AllowlistValidator -->|"Watch InferencePool CRs<br/>HTTPS 443/TCP"| K8sAPI["Kubernetes API Server"]
    AllowlistValidator -->|"Watch Pods<br/>HTTPS 443/TCP"| K8sAPI

    InferencePoolCR["InferencePool CR<br/>(Gateway API Inference Extension)"] -->|watched by| AllowlistValidator

    style Proxy fill:#4a90e2,color:#fff
    style AllowlistValidator fill:#4a90e2,color:#fff
    style ConnectorNIXLv2 fill:#4a90e2,color:#fff
    style ConnectorNIXLv1 fill:#999,color:#fff
    style ConnectorLMCache fill:#999,color:#fff
    style TLSManager fill:#4a90e2,color:#fff
    style Client fill:#f5a623,color:#fff
    style Prefiller fill:#7ed321,color:#fff
    style Decoder fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8
    style InferencePoolCR fill:#f5a623,color:#fff
