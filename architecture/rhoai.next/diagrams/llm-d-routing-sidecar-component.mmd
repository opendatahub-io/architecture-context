graph TB
    subgraph "llm-d-routing-sidecar"
        direction TB
        Proxy["Reverse Proxy<br/>(net/http/httputil.ReverseProxy)<br/>Port 8000/TCP"]
        AllowlistValidator["AllowlistValidator<br/>(Kubernetes Informer)<br/>SSRF Protection"]
        ConnectorNIXLv2["Connector: NIXL v2<br/>(Primary Protocol)"]
        ConnectorNIXLv1["Connector: NIXL v1<br/>(Deprecated)"]
        ConnectorLMCache["Connector: LMCache<br/>(Deprecated)"]
        LRUCache["LRU Cache<br/>(Prefiller Proxy Handlers)<br/>Capacity: 16"]

        Proxy -->|validates prefill target| AllowlistValidator
        Proxy -->|uses| ConnectorNIXLv2
        Proxy -.->|fallback| ConnectorNIXLv1
        Proxy -.->|fallback| ConnectorLMCache
        Proxy -->|caches handlers| LRUCache
    end

    Client[External Client] -->|"POST /v1/chat/completions<br/>POST /v1/completions<br/>8000/TCP HTTPS"| Proxy

    subgraph "Kubernetes API"
        InferencePoolCR["InferencePool CR<br/>(inference.networking.x-k8s.io/v1alpha2)"]
        PodAPI["Pod API (v1)<br/>Pod IP tracking"]
    end

    AllowlistValidator -->|"watches via dynamic informer<br/>443/TCP HTTPS"| InferencePoolCR
    AllowlistValidator -->|"watches matching pods<br/>443/TCP HTTPS"| PodAPI

    subgraph "vLLM Workers"
        Decoder["Local vLLM Decoder<br/>Port 8001/TCP (default)"]
        Prefiller["Remote vLLM Prefiller<br/>Port: header-specified"]
    end

    Proxy -->|"decode requests<br/>HTTP/HTTPS"| Decoder
    Proxy -->|"prefill requests<br/>(x-prefiller-host-port header)<br/>HTTP/HTTPS"| Prefiller

    Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>TLS edge termination"]
    Route -->|forwards| Proxy

    style Proxy fill:#4a90e2,color:#fff
    style AllowlistValidator fill:#4a90e2,color:#fff
    style ConnectorNIXLv2 fill:#5ba0f2,color:#fff
    style ConnectorNIXLv1 fill:#999,color:#fff
    style ConnectorLMCache fill:#999,color:#fff
    style LRUCache fill:#5ba0f2,color:#fff
    style Client fill:#f9f9f9,stroke:#333
    style InferencePoolCR fill:#f5a623,color:#fff
    style PodAPI fill:#f5a623,color:#fff
    style Decoder fill:#7ed321,color:#fff
    style Prefiller fill:#7ed321,color:#fff
    style Route fill:#ffe6cc,stroke:#d79b00
