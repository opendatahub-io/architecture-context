graph LR
    TrainerOp["Trainer Operator<br/>(trainer-operator)"]

    %% External Dependencies (Required)
    TrainerOp -->|"deploys v2.2.0"| KubeflowTrainer["Kubeflow Trainer V2<br/>2.2.0"]
    TrainerOp -->|"framework"| ControllerRuntime["controller-runtime<br/>0.23.3"]
    TrainerOp -->|"platform utilities"| ODHPlatformUtils["odh-platform-utilities<br/>0.1.0"]
    TrainerOp -->|"dependency check"| JobSetCRD["JobSet CRD<br/>v1alpha2"]
    TrainerOp -->|"operator check<br/>(OpenShift only)"| JobSetOperator["JobSet Operator"]

    %% Internal Platform Dependencies
    TrainerOp -->|"CR lifecycle"| PlatformOp["RHOAI Platform Operator<br/>(rhods-operator)"]
    TrainerOp -->|"version handshake"| ConfigMap["odh-trainer-config<br/>ConfigMap"]
    TrainerOp -->|"image pinning"| RelatedImages["RELATED_IMAGE_*<br/>env vars"]

    %% Operand creates
    KubeflowTrainer -->|"creates"| JobSets["JobSets<br/>(jobset.x-k8s.io)"]
    KubeflowTrainer -.->|"optional"| Volcano["Volcano Scheduler<br/>(scheduling.volcano.sh)"]
    KubeflowTrainer -.->|"optional"| Kueue["Kueue<br/>(scheduling.x-k8s.io)"]

    %% Integration Points (components that interact with this)
    PlatformOp -->|"creates Trainer CR"| TrainerOp
    Prometheus["Prometheus /<br/>OpenShift Monitoring"] -->|"scrapes metrics"| TrainerOp
    Prometheus -->|"scrapes metrics<br/>(insecureSkipVerify)"| KubeflowTrainer
    OLM["OLM"] -.->|"OperatorConditions"| TrainerOp

    %% Managed Resources
    TrainerOp -->|"manages"| CRDs["Kubeflow CRDs<br/>(TrainJob, ClusterTrainingRuntime,<br/>TrainingRuntime)"]
    TrainerOp -->|"manages"| Runtimes["ClusterTrainingRuntimes<br/>(torch-distributed, training-hub<br/>CUDA/ROCm/CPU variants)"]
    TrainerOp -->|"manages<br/>(OpenShift only)"| ImageStreams["ImageStreams<br/>(Training Hub workbench<br/>CPU, CUDA, ROCm)"]

    %% Infrastructure
    TrainerOp -->|"API calls"| K8sAPI["Kubernetes /<br/>OpenShift API"]
    KubeflowTrainer -->|"API calls"| K8sAPI

