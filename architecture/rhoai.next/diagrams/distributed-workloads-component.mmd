graph TB
    subgraph DW["Distributed Workloads Repository"]
        direction TB

        subgraph TestFramework["E2E Test Framework (Go)"]
            TestRunner["Test Runner<br/>go test / containerized"]
            KFTO_Tests["KFTO v1 Tests<br/>PyTorchJob"]
            Trainer_Tests["Trainer v2 Tests<br/>TrainJob"]
            Ray_Tests["KubeRay Tests<br/>RayJob / RayCluster"]
            Kueue_Tests["Kueue Tests<br/>ClusterQueue / LocalQueue"]
            TestRunner --> KFTO_Tests
            TestRunner --> Trainer_Tests
            TestRunner --> Ray_Tests
            TestRunner --> Kueue_Tests
        end

        subgraph RuntimeImages["Runtime Training Images"]
            direction LR
            CUDA_Images["CUDA Images (5)<br/>12.1 / 12.4 / 12.8 / 13.0"]
            ROCm_Images["ROCm Images (5)<br/>6.2 / 6.4"]
            OpenMPI_CUDA["OpenMPI CUDA 13.0<br/>AIPCC hermetic"]
            OpenMPI_ROCm["OpenMPI ROCm 6.4<br/>AIPCC hermetic"]
        end

        subgraph UniversalImages["Universal Training Images"]
            direction LR
            CPU_Img["CPU<br/>torch 2.10 / py312"]
            CUDA_Uni["CUDA 13.0<br/>torch 2.10 / py312"]
            ROCm_Uni["ROCm 6.4<br/>torch 2.9.1 / py312"]
        end

        subgraph Support["Support Images"]
            direction LR
            OSU_Bench["OSU Benchmark<br/>CPU + CUDA"]
            TestRunnerImg["Test Runner Image<br/>Go + oc CLI"]
        end

        subgraph Examples["Examples & Benchmarks"]
            Notebooks["Jupyter Notebooks<br/>Ray, KFTO, Feast, RAG"]
            Benchmarks["MPI DDP SFT<br/>OSU Micro-Benchmarks"]
        end
    end

    %% Test targets (CRDs from other components)
    KFTO_Tests -->|"creates"| PyTorchJobCR["PyTorchJob CR<br/>kubeflow.org/v1"]
    Trainer_Tests -->|"creates"| TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1"]
    Ray_Tests -->|"creates"| RayJobCR["RayJob CR<br/>ray.io/v1"]
    Kueue_Tests -->|"creates"| ClusterQueueCR["ClusterQueue CR<br/>kueue.x-k8s.io/v1beta2"]

    %% CRDs watched by operators
    PyTorchJobCR -->|"watched by"| KFTO["KFTO Controller"]
    TrainJobCR -->|"watched by"| TrainerV2["Trainer v2 Controller"]
    RayJobCR -->|"watched by"| KubeRay["KubeRay Operator"]
    ClusterQueueCR -->|"watched by"| KueueCtrl["Kueue Controller"]

    %% Runtime images used by CRs
    KFTO -->|"schedules pods using"| CUDA_Images
    KFTO -->|"schedules pods using"| ROCm_Images
    TrainerV2 -->|"schedules pods using"| OpenMPI_CUDA
    TrainerV2 -->|"schedules pods using"| UniversalImages

    %% Universal images dual mode
    CPU_Img -->|"workbench mode"| JupyterLab["JupyterLab<br/>8888/TCP"]
    CUDA_Uni -->|"workbench mode"| JupyterLab
    ROCm_Uni -->|"workbench mode"| JupyterLab

    %% External services
    RuntimeImages -->|"downloads models"| S3["S3 Storage<br/>443/TCP HTTPS"]
    UniversalImages -->|"downloads models"| HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]

    %% Build dependencies
    OpenMPI_CUDA -->|"built from"| AIPCC["AIPCC Base Images<br/>quay.io/aipcc"]
    OpenMPI_ROCm -->|"built from"| AIPCC
    UniversalImages -->|"built from"| AIPCC_PyPI["AIPCC PyPI Index"]

    %% Styling
    style DW fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style TestFramework fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style RuntimeImages fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style UniversalImages fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style Support fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Examples fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    style PyTorchJobCR fill:#f5a623,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style RayJobCR fill:#f5a623,stroke:#333
    style ClusterQueueCR fill:#f5a623,stroke:#333

    style KFTO fill:#999,stroke:#333
    style TrainerV2 fill:#999,stroke:#333
    style KubeRay fill:#999,stroke:#333
    style KueueCtrl fill:#999,stroke:#333

    style S3 fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style AIPCC fill:#7ed321,stroke:#333
    style AIPCC_PyPI fill:#7ed321,stroke:#333
