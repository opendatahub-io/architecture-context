graph TB
    subgraph TestSuites["Test Suites (Go)"]
        direction TB
        KFTO["tests/kfto<br/>PyTorchJob E2E"]
        Trainer["tests/trainer<br/>TrainJob E2E"]
        ODH["tests/odh<br/>KubeRay E2E"]
        FMS["tests/fms<br/>fms-hf-tuning E2E"]
    end

    subgraph CommonLib["Shared Test Infrastructure"]
        Support["tests/common/support<br/>~40 files"]
        Support -->|multi-client| K8sClients["K8s + OpenShift Clients"]
        Support -->|resource helpers| ResourceHelpers["Resource Helpers"]
        Support -->|lifecycle| TestLifecycle["Test Lifecycle Mgmt"]
    end

    subgraph UniversalImages["Universal Training Images"]
        direction TB
        CPU["th-torch-cpu-py312<br/>UBI9 + PyTorch 2.11.0<br/>Python 3.12"]
        CUDA["th-torch-cuda-py312<br/>UBI9 + CUDA 13.0.2<br/>PyTorch 2.11.0"]
        ROCm["th-torch-rocm-py312<br/>UBI9 + ROCm 7.14<br/>PyTorch 2.11.0"]
    end

    subgraph RayImages["Ray Runtime Images"]
        RayCPU["Ray CPU"]
        RayCUDA["Ray CUDA"]
        RayROCm["Ray ROCm"]
    end

    subgraph Extras["Examples & Benchmarks"]
        Benchmarks["MPI DDP SFT<br/>OSU Micro-benchmarks"]
        Examples["Jupyter Notebooks<br/>Ray Tune, DreamBooth,<br/>LLM SFT, RAG, Docling"]
    end

    %% Test suites use common library
    KFTO -->|imports| Support
    Trainer -->|imports| Support
    ODH -->|imports| Support
    FMS -->|imports| Support

    %% Tests create workloads using training images
    KFTO -->|creates PyTorchJob with| CPU
    KFTO -->|creates PyTorchJob with| CUDA
    Trainer -->|creates TrainJob with| CPU
    Trainer -->|creates TrainJob with| CUDA
    FMS -->|creates fine-tuning job with| CUDA
    ODH -->|creates RayCluster with| RayCUDA

    %% Consumed CRDs
    PyTorchJobCR["PyTorchJob CR<br/>(KFTO v1)"]
    TrainJobCR["TrainJob CR<br/>(Trainer v2)"]
    RayClusterCR["RayCluster CR<br/>(KubeRay)"]
    RayJobCR["RayJob CR<br/>(KubeRay)"]
    KueueCR["ClusterQueue / LocalQueue<br/>(Kueue)"]

    Support -->|creates| PyTorchJobCR
    Support -->|creates| TrainJobCR
    Support -->|creates| RayClusterCR
    Support -->|creates| RayJobCR
    Support -->|creates| KueueCR

    %% Dual-mode entrypoint
    Entrypoint["entrypoint-universal.sh<br/>Dual-mode: Jupyter / Training"]
    CPU --- Entrypoint
    CUDA --- Entrypoint
    ROCm --- Entrypoint

    %% External dependencies
    K8sAPI["Kubernetes API"]
    Support -->|REST + WebSocket| K8sAPI

