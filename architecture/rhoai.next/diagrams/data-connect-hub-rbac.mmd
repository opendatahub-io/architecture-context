graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["dc-controller-manager"]
        SA_REST["rest-service-sa"]
        SA_Flight["(flight-service SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["dc-controller-manager-rolebinding"]
        CRB2["dc-controller-metrics-auth-rolebinding"]
        CRB3["kube-rbac-proxy-auth-review"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB1["dc-controller-leader-election-rolebinding<br/>(ns: dc-controller-system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["dc-controller-manager-role"]
        CR_MetricsAuth["dc-controller-metrics-auth-role"]
