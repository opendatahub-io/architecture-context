            TokenReviews["tokenreviews"]
            SAR["subjectaccessreviews"]
        end
        subgraph DCHAPI["dataconnecthub.opendatahub.io"]
            DCS["dataconnectservices"]
            DataConn["data-connections"]
            DataConnType["data-connection-types"]
            DataStore["data-store"]
            FlightSvc["flight-services"]
        end
        subgraph GatewayAPIRes["gateway.networking.k8s.io"]
            Gateways["gateways"]
            HTTPRoutes["httproutes"]
        end
        subgraph MonitoringAPI["monitoring.coreos.com"]
            ServiceMonitors["servicemonitors"]
        end
        subgraph NetworkAPI["networking.k8s.io"]
            NetworkPolicies["networkpolicies"]
        end
        subgraph RBACAPI["rbac.authorization.k8s.io"]
            CRoles["clusterroles"]
            CRBindings["clusterrolebindings"]
        end
        subgraph OSConfigAPI["config.openshift.io"]
            APIServers["apiservers"]
            Ingresses["ingresses"]
        end
        subgraph NonResource["Non-Resource URLs"]
            MetricsURL["/metrics"]
        end
    end

