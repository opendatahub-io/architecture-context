graph TB
    subgraph MCPServer["RHOAI MCP Server (FastMCP)"]
        direction TB
        Core["Core Server<br/>__main__.py / server.py"]
        PluginMgr["Plugin Manager<br/>(pluggy hooks)"]
        AuthModule["Auth Module"]
        K8sClient["K8s Client<br/>(multi-auth)"]
        Core --> PluginMgr
        Core --> AuthModule
        Core --> K8sClient
    end

    subgraph Auth["Authentication & Authorization"]
        direction TB
        OIDCMiddleware["OIDC Middleware<br/>(ASGI)"]
        TokenReview["TokenReview<br/>(opaque tokens)"]
        RBACChecker["RBAC Checker<br/>(SubjectAccessReview)"]
        UserContext["UserContext<br/>(context var)"]
        OIDCMiddleware --> TokenReview
        OIDCMiddleware --> UserContext
        RBACChecker --> UserContext
    end

    subgraph DomainPlugins["Domain Plugins (7)"]
        direction LR
        Projects["Projects"]
        Notebooks["Notebooks"]
        Inference["Inference"]
        Pipelines["Pipelines"]
        Connections["Connections"]
        Storage["Storage"]
        Training["Training"]
    end

    subgraph CompositePlugins["Composite Plugins (4)"]
        direction LR
        Cluster["Cluster<br/>Explorer"]
        TrainingComposite["Training<br/>Composites"]
        Meta["Meta<br/>(tool discovery)"]
        Planner["Planner<br/>(recommendations)"]
    end

    subgraph ExternalClients["External Clients"]
        direction LR
        PlannerClient["Planner Client<br/>(REST)"]
        ModelRegClient["Model Registry /<br/>Catalog Client<br/>(REST, auto-discover)"]
    end

    %% Internal connections
    AuthModule --> OIDCMiddleware
    AuthModule --> RBACChecker
    PluginMgr --> DomainPlugins
    PluginMgr --> CompositePlugins
    CompositePlugins --> DomainPlugins
    Planner --> PlannerClient
    Inference --> ModelRegClient

    %% External actors
    Agent["AI Agent<br/>(Claude Desktop / VS Code)"]
    Agent -->|"MCP Protocol<br/>(stdio / SSE / streamable-http)"| Core

    %% K8s interactions
    K8sAPI["Kubernetes API Server"]
    K8sClient -->|"HTTPS/443<br/>SA Token / Impersonation"| K8sAPI

    %% CRDs consumed
    subgraph CRDs["CRDs Consumed (via K8s API)"]
        direction LR
        NotebookCR["Notebook<br/>(kubeflow.org)"]
        InferenceServiceCR["InferenceService<br/>(serving.kserve.io)"]
        TrainJobCR["TrainJob<br/>(trainer.kubeflow.org)"]
        DSPACR["DSPA<br/>(opendatahub.io)"]
        DSCCR["DataScienceCluster<br/>(opendatahub.io)"]
    end

    DomainPlugins -->|"CRUD"| CRDs

    %% External services
    OIDCProvider["OIDC Provider"]
    OIDCMiddleware -->|"JWKS fetch<br/>HTTPS/443"| OIDCProvider
    PlannerService["Planner Service"]
    PlannerClient -->|"REST API"| PlannerService
    ModelRegService["Model Registry /<br/>Model Catalog"]
    ModelRegClient -->|"REST API<br/>8080/8443"| ModelRegService

    %% Styles
    style MCPServer fill:#4a90e2,stroke:#333,color:#fff
    style Auth fill:#e74c3c,stroke:#333,color:#fff
    style DomainPlugins fill:#27ae60,stroke:#333,color:#fff
    style CompositePlugins fill:#8e44ad,stroke:#333,color:#fff
    style ExternalClients fill:#f39c12,stroke:#333,color:#fff
    style CRDs fill:#f5a623,stroke:#333,color:#fff
    style Agent fill:#2c3e50,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OIDCProvider fill:#999,stroke:#333,color:#fff
    style PlannerService fill:#999,stroke:#333,color:#fff
    style ModelRegService fill:#999,stroke:#333,color:#fff
