graph TB
    subgraph RhoaiMCP["rhoai-mcp Service"]
        direction TB

        subgraph Transport["Transport Layer"]
            Uvicorn["uvicorn<br/>ASGI Server<br/>8000/TCP"]
        end

        subgraph Auth["Authentication & Authorization"]
            OIDCMiddleware["OIDC Auth Middleware<br/>Bearer Token Validation"]
            RBACChecker["RBAC Checker<br/>SubjectAccessReview"]
            WorkflowToken["Workflow Token<br/>HMAC-SHA256 Signing"]
        end

        subgraph Core["Core Framework"]
            FastMCPServer["FastMCP Server<br/>Tool/Resource/Prompt Registry"]
            PluginManager["Plugin Manager<br/>Pluggy Hooks"]
            K8sClient["K8sClient<br/>Python Kubernetes SDK"]
        end

        subgraph Domains["Domain Plugins"]
            Projects["Projects Domain<br/>Namespace CRUD"]
            Notebooks["Notebooks Domain<br/>Workbench CRUD"]
            Inference["Inference Domain<br/>InferenceService CRUD"]
            Connections["Connections Domain<br/>Secret Management"]
            Storage["Storage Domain<br/>PVC Management"]
            Pipelines["Pipelines Domain<br/>DSPA CRUD"]
            Training["Training Domain<br/>TrainJob CRUD"]
            ModelReg["Model Registry Domain<br/>REST Client"]
        end

        subgraph Composite["Composite Plugins"]
            ClusterExplorer["Cluster Explorer<br/>Cross-domain Discovery"]
            TrainingOrch["Training Orchestrator<br/>prepare_training"]
            InferencePlanner["Inference Planner<br/>GPU/Resource Planning"]
            Diagnostics["Resource Diagnostics<br/>Cross-cutting Analysis"]
        end
    end

    %% External actors
    Agent["AI Agent<br/>(Claude Code / Codex / Pi)"]
    Route["OpenShift Route<br/>443/TCP HTTPS"]

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    ModelRegSvc["Model Registry Service<br/>8080/8443 TCP"]
    ModelCatalog["Model Catalog<br/>8443/TCP HTTPS"]
    LlmdPlanner["llm-d Planner<br/>8000/TCP HTTP"]

    %% Flow connections
    Agent -->|MCP Protocol<br/>HTTPS/443| Route
    Route -->|HTTP/8000| Uvicorn
    Uvicorn --> OIDCMiddleware
    OIDCMiddleware --> RBACChecker
    RBACChecker --> FastMCPServer
    FastMCPServer --> PluginManager
    PluginManager --> Domains
    PluginManager --> Composite
    WorkflowToken -.->|validates tokens| Composite

    %% Domain to K8s
    Projects --> K8sClient
    Notebooks --> K8sClient
    Inference --> K8sClient
    Connections --> K8sClient
    Storage --> K8sClient
    Pipelines --> K8sClient
    Training --> K8sClient
    K8sClient --> K8sAPI

    %% External integrations
    ModelReg -->|REST| ModelRegSvc
    InferencePlanner -->|REST| LlmdPlanner
    InferencePlanner -->|REST| ModelCatalog

    %% Styling
    style RhoaiMCP fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Agent fill:#f9f9f9,stroke:#999,stroke-width:2px
    style Route fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style K8sAPI fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ModelRegSvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ModelCatalog fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style LlmdPlanner fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style FastMCPServer fill:#4a90e2,color:#fff
    style PluginManager fill:#4a90e2,color:#fff
    style K8sClient fill:#4a90e2,color:#fff
    style OIDCMiddleware fill:#e06666,color:#fff
    style RBACChecker fill:#e06666,color:#fff
    style WorkflowToken fill:#e06666,color:#fff
