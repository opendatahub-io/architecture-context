graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kube-auth-proxy SA<br/>(per-deployment)"]
    end

    subgraph Bindings["Role Bindings (managed by deploying operator)"]
        CRB["ClusterRoleBinding<br/>(not bundled)"]
    end

    subgraph Roles["Cluster Role Permissions"]
        CR["ClusterRole<br/>(not bundled)"]
    end

    subgraph Resources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
    end

    subgraph AuthMethods["Authentication Methods Enforced"]
        direction LR
        OIDC["OIDC<br/>Browser OAuth2 flow"]
        OSAuth["OpenShift OAuth<br/>Browser + Bearer"]
        K8sToken["K8s TokenReview<br/>SA Bearer tokens"]
        BasicAuth["Basic Auth<br/>(htpasswd)"]
        JWTAuth["JWT Bearer<br/>Token validation"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|create| TokenReviews

    SA -->|uses| OIDC
    SA -->|uses| OSAuth
    SA -->|validates via| K8sToken
    SA -->|validates via| BasicAuth
    SA -->|validates via| JWTAuth

    subgraph Note["Note"]
        NoteText["RBAC manifests are NOT bundled in the repository.<br/>The deploying operator must grant<br/>tokenreviews/create permission."]
    end

    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style OIDC fill:#dae8fc,stroke:#6c8ebf
    style OSAuth fill:#dae8fc,stroke:#6c8ebf
    style K8sToken fill:#dae8fc,stroke:#6c8ebf
    style BasicAuth fill:#dae8fc,stroke:#6c8ebf
    style JWTAuth fill:#dae8fc,stroke:#6c8ebf
    style NoteText fill:#fff2cc,stroke:#d6b656
