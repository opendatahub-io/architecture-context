graph TD
    subgraph "kube-auth-proxy Deployment"
        SA["ServiceAccount<br/>(deployment-specific)"]
    end

    subgraph "Required Permissions (deployment-time)"
        direction TB
        TR_Perm["TokenReview Permission"]
        User_Perm["User Info Permission"]
        OAuth_Perm["OAuth Redirect Annotation"]
    end

    subgraph "API Resources - TokenReview"
        TokenReviewAPI["authentication.k8s.io/v1<br/>TokenReview"]
    end

    subgraph "API Resources - User Info"
        UserAPI["user.openshift.io/v1<br/>users"]
    end

    subgraph "OAuth Configuration"
        OAuthRedirect["serviceaccounts.openshift.io/oauth-redirecturi.*<br/>(annotation on ServiceAccount)"]
    end

    subgraph "Authentication Methods Supported"
        direction TB
        OIDC["OIDC Provider<br/>(external IdP)<br/>Client credentials via Secret"]
        OShiftOAuth["OpenShift OAuth<br/>SA auto-detected credentials"]
        K8sToken["K8s SA Token<br/>TokenReview validation"]
        HtPasswd["htpasswd<br/>File-based basic auth"]
        SessionCookie["Session Cookie<br/>HMAC-signed, AES-CFB encrypted"]
    end

    SA -->|"requires"| TR_Perm
    SA -->|"requires (OpenShift)"| User_Perm
    SA -->|"requires (OpenShift OAuth)"| OAuth_Perm

    TR_Perm -->|"create"| TokenReviewAPI
    User_Perm -->|"get"| UserAPI
    OAuth_Perm -->|"annotation"| OAuthRedirect

    SA -.->|"uses"| OIDC
    SA -.->|"uses"| OShiftOAuth
    SA -.->|"uses"| K8sToken
    SA -.->|"uses"| HtPasswd
    SA -.->|"uses"| SessionCookie

    subgraph "Secrets Required"
        CookieSecret["kube-auth-proxy-secret<br/>Type: Opaque<br/>cookie-secret (AES key)<br/>client-secret (OAuth2)<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        TLSSecret["TLS cert/key<br/>Type: kubernetes.io/tls<br/>HTTPS listener cert<br/>Provisioned: cert-manager<br/>Auto-Rotate: Deployment-specific"]
        SAToken["SA token<br/>Type: kubernetes.io/service-account-token<br/>OpenShift OAuth auto-detect<br/>Provisioned: Kubernetes<br/>Auto-Rotate: Yes"]
    end

    SA -->|"mounts"| CookieSecret
    SA -->|"mounts (HTTPS)"| TLSSecret
    SA -->|"auto-mounted"| SAToken

    style SA fill:#4a90e2,color:#fff
    style TR_Perm fill:#f5a623
    style User_Perm fill:#f5a623
    style OAuth_Perm fill:#f5a623
    style TokenReviewAPI fill:#7ed321
    style UserAPI fill:#7ed321
    style OAuthRedirect fill:#7ed321
    style CookieSecret fill:#e74c3c,color:#fff
    style TLSSecret fill:#e74c3c,color:#fff
    style SAToken fill:#e74c3c,color:#fff
    style OIDC fill:#dae8fc,stroke:#6c8ebf
    style OShiftOAuth fill:#dae8fc,stroke:#6c8ebf
    style K8sToken fill:#dae8fc,stroke:#6c8ebf
    style HtPasswd fill:#dae8fc,stroke:#6c8ebf
    style SessionCookie fill:#dae8fc,stroke:#6c8ebf
