graph TD
    subgraph DeploymentModel["Deployment Model (Sidecar Injection)"]
        direction TB
        RhodsOp["rhods-operator<br/>(configures RBAC)"]
        NotebookCtrl["odh-notebook-controller<br/>(configures RBAC)"]
    end

    subgraph SidecarPod["Pod with kube-auth-proxy Sidecar"]
        direction TB
        SA["ServiceAccount<br/>(configured per-component)"]
        KAP["kube-auth-proxy<br/>container"]
    end

    subgraph RequiredRBAC["Required RBAC (when K8s token validation enabled)"]
        direction TB
        CR["ClusterRole / Role<br/>(provisioned by operator)"]
    end

    subgraph APIResources["API Resources"]
        direction TB
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
    end

    subgraph AuthEndpoints["Auth Check Endpoints"]
        direction TB
        ExtAuthz["/oauth2/auth<br/>(Envoy ext_authz)<br/>202 Accepted / 401 Unauthorized"]
        ProxyAll["/* (reverse proxy)<br/>Authenticated → upstream<br/>Unauthenticated → sign-in"]
    end

    subgraph SessionSecurity["Session & Cookie Security"]
        direction TB
        CookieEncrypt["Session Cookie<br/>_oauth2_proxy<br/>CFB/GCM encrypted<br/>Secure, HttpOnly"]
        CSRFCookie["CSRF Cookie<br/>_oauth2_proxy_csrf<br/>HMAC-signed<br/>Secure, HttpOnly"]
    end

    subgraph Secrets["Secrets Required"]
        direction TB
        ClientSecret["kube-auth-proxy-secret<br/>(Opaque)<br/>client-secret: OAuth client secret<br/>cookie-secret: Session encryption key<br/>Provisioned by: Manual / Operator<br/>Auto-Rotate: No"]
        SAToken["ServiceAccount Token<br/>(kubernetes.io/service-account-token)<br/>Auto-detected for OpenShift OAuth<br/>Provisioned by: Kubernetes<br/>Auto-Rotate: Yes"]
    end

    %% Deployment flow
    RhodsOp -.->|"injects sidecar +<br/>configures SA"| SidecarPod
    NotebookCtrl -.->|"injects sidecar +<br/>configures SA"| SidecarPod

    %% RBAC binding
    SA -->|"bound via<br/>ClusterRoleBinding / RoleBinding"| CR
    CR -->|"create"| TokenReview

    %% Secret usage
    KAP -->|"reads"| ClientSecret
    KAP -->|"auto-detects"| SAToken

    %% Auth enforcement
    KAP -->|"enforces"| ExtAuthz
    KAP -->|"enforces"| ProxyAll

    %% Session management
    KAP -->|"issues"| CookieEncrypt
    KAP -->|"validates"| CSRFCookie

    %% Styles
    style DeploymentModel fill:#e8f0fe,stroke:#4a90e2,stroke-width:1px
    style SidecarPod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style RequiredRBAC fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    style APIResources fill:#f8cecc,stroke:#b85450,stroke-width:1px
    style AuthEndpoints fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style SessionSecurity fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    style Secrets fill:#ffe6cc,stroke:#d79b00,stroke-width:1px
    style SA fill:#4a90e2,color:#fff
    style KAP fill:#4a90e2,color:#fff
    style CR fill:#f5a623
    style TokenReview fill:#7ed321
