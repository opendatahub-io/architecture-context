graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        TASRoute["TrustyAI Service Route<br/>443/TCP HTTPS<br/>TLS Reencrypt"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["Operator Pod"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
            MetricsSrv["Metrics Server<br/>8443/TCP HTTPS<br/>service-ca TLS<br/>Bearer + RBAC"]
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>webhook-server-cert TLS<br/>API Server Validation"]
        end

        MetricsSvc["Metrics Service (ClusterIP)<br/>8443/TCP HTTPS<br/>service-ca TLS"]
        WebhookSvc["Webhook Service (ClusterIP)<br/>443/TCP → 9443/TCP HTTPS<br/>webhook-server-cert TLS"]
    end

    subgraph UserNS["USER NAMESPACE"]
        direction TB

        subgraph TASPod["TrustyAI Service Pod"]
            RBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS TLS<br/>TokenReview + SAR"]
            TASSvc["TrustyAI Service<br/>8081/TCP HTTP<br/>Proxied Access"]
        end

        TASSvcK8s["TrustyAI Service (ClusterIP)<br/>443/TCP → 8443/TCP HTTPS<br/>Per-instance TLS cert"]

        subgraph LMEvalPod["LMEval Job Pod"]
            Driver["Driver Container<br/>Go Binary"]
            LMESJob["lmes-job Container<br/>Python"]
        end

        EvalHubPod["EvalHub Instance<br/>8443/TCP HTTPS<br/>kube-rbac-proxy"]

        NemoPod["NemoGuardrails Server"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        PrometheusOp["Prometheus<br/>(ServiceMonitor scrape)"]
        OTELCollector["OpenTelemetry Collector<br/>OTLP gRPC/HTTP<br/>(opt-in)"]
    end

    subgraph OpenShiftConfig["OPENSHIFT PLATFORM"]
        APIServerCfg["APIServer Config<br/>(TLS Security Profile)"]
        ServiceCA["service-ca Operator<br/>(Certificate Provisioning)"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS Reencrypt<br/>Bearer Token"| TASRoute
    TASRoute -->|"HTTPS/8443<br/>TLS<br/>Proxied"| RBACProxy

    %% Internal proxy flow
    RBACProxy -->|"HTTP/8081<br/>None (localhost)<br/>Proxied"| TASSvc
    RBACProxy -->|"HTTPS/6443<br/>TokenReview + SAR"| K8sAPI

    %% Operator to K8s API
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI

    %% Driver pod/exec
    Driver -->|"HTTPS/6443<br/>pod/exec<br/>ServiceAccount"| K8sAPI
    Driver -->|"in-pod"| LMESJob

    %% Monitoring
    PrometheusOp -->|"HTTPS/8443<br/>Bearer Token"| MetricsSvc
    OperatorPod -->|"OTLP<br/>Configured"| OTELCollector

    %% Platform config
    OperatorPod -->|"HTTPS/6443<br/>Watch"| APIServerCfg
    ServiceCA -->|"Provisions certs"| MetricsSvc
    ServiceCA -->|"Provisions certs"| WebhookSvc

    %% K8s API to webhook
    K8sAPI -->|"HTTPS/443<br/>TLS Validation"| WebhookSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef openshift fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class TASRoute ingress
    class Health,MetricsSrv,WebhookSrv,MetricsSvc,WebhookSvc operator
    class RBACProxy,TASSvc,TASSvcK8s,Driver,LMESJob,EvalHubPod,NemoPod workload
    class K8sAPI,PrometheusOp,OTELCollector platform
    class APIServerCfg,ServiceCA openshift
