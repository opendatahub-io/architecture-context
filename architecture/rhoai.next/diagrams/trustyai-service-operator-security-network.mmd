graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["External User / Agent"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes — TLS Termination)"]
        direction LR
        TASRoute["TAS Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        EvalHubRoute["EvalHub Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        EvalHubMCPRoute["EvalHub MCP Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        GORCHRoute["GORCH Route<br/>443/TCP → 8432/TCP<br/>TLS Reencrypt"]
        GORCHGWRoute["GORCH Gateway Route<br/>443/TCP → 8490/TCP<br/>TLS Edge/Reencrypt"]
        NemoRoute["NemoGuardrails Route<br/>443/TCP<br/>TLS Edge/Reencrypt"]
    end

    subgraph AuthBoundary["AUTH BOUNDARY (kube-rbac-proxy sidecars)"]
        direction TB
        KRBP_TAS["kube-rbac-proxy (TAS)<br/>8443/TCP → 8080/TCP<br/>TLS service-serving-cert<br/>TokenReview + SAR"]
        KRBP_EvalHub["kube-rbac-proxy (EvalHub)<br/>8443/TCP → 8444/TCP<br/>TLS service-serving-cert<br/>SAR + X-Tenant"]
        KRBP_GORCH["kube-rbac-proxy (GORCH)<br/>8432/TCP<br/>TLS service-serving-cert<br/>SAR (when auth enabled)"]
        KRBP_Nemo["kube-rbac-proxy (Nemo)<br/>TLS service-serving-cert<br/>SAR (when auth enabled)"]
    end

    subgraph AppTier["APPLICATION TIER (Operator + Operands)"]
        direction TB

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["TrustyAI Operator<br/>SA: controller-manager<br/>8080/TCP metrics<br/>8081/TCP health<br/>9443/TCP webhooks<br/>FIPS: strictfipsruntime"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            TASApp["TrustyAI Service<br/>8080/TCP HTTP<br/>(behind kube-rbac-proxy)"]
            EvalHubApp["EvalHub<br/>8444/TCP HTTP<br/>+ MCP sidecar (optional)"]
            GORCHApp["GORCH Orchestrator<br/>+ Gateway (8490/TCP)<br/>+ Detector (8480/TCP)"]
            NemoApp["NemoGuardrails Server"]
            LMESPod["LMEvalJob Pod<br/>lmes-driver 18080/TCP<br/>(pod-internal only)"]
        end
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        WebhookSvc["Webhook Service<br/>9443/TCP HTTPS<br/>cert-manager TLS<br/>API server client cert"]
    end

    subgraph ServiceMesh["SERVICE MESH (Conditional — Istio)"]
        DestRule["DestinationRule<br/>(TAS — mTLS)"]
        VirtSvc["VirtualService<br/>(TAS — routing)"]
        EnvoyFilter["EnvoyFilter<br/>mcp-sse-strip<br/>(NemoGuardrails)<br/>⚠ Cross-namespace write"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        KServeEP["KServe Endpoints<br/>HTTP/HTTPS/gRPC<br/>Bearer/None"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS Credentials"]
        OCI["OCI Registries<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry Credentials"]
        PgSQL["PostgreSQL<br/>5432/TCP<br/>Optional TLS<br/>Username/Password"]
        MLflow["MLflow Server<br/>443/TCP HTTPS<br/>TLS<br/>Projected SA Token"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>Bearer Token"| TASRoute
    User -->|"HTTPS/443<br/>Bearer Token"| EvalHubRoute
    User -->|"HTTPS/443<br/>Bearer Token"| GORCHRoute
    User -->|"HTTPS/443<br/>Bearer Token"| NemoRoute

    %% Ingress → Auth
    TASRoute -->|"TLS Reencrypt<br/>8443/TCP"| KRBP_TAS
    EvalHubRoute -->|"TLS Reencrypt<br/>8443/TCP"| KRBP_EvalHub
    EvalHubMCPRoute -->|"TLS Reencrypt<br/>8443/TCP"| KRBP_EvalHub
    GORCHRoute -->|"TLS<br/>8432/TCP"| KRBP_GORCH
    GORCHGWRoute -->|"TLS<br/>8490/TCP"| KRBP_GORCH
    NemoRoute -->|"TLS"| KRBP_Nemo

    %% Auth → App
    KRBP_TAS -->|"HTTP/8080<br/>localhost"| TASApp
    KRBP_EvalHub -->|"HTTP/8444<br/>loopback"| EvalHubApp
    KRBP_GORCH -->|"HTTP<br/>localhost"| GORCHApp
    KRBP_Nemo -->|"HTTP<br/>localhost"| NemoApp

    %% Operator → Control Plane
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    K8sAPI -->|"TLS client cert<br/>9443/TCP"| WebhookSvc

    %% Operator → Operands
    Operator -.->|"pod exec<br/>18080/TCP"| LMESPod

    %% App → External Services
    TASApp -->|"HTTP/HTTPS/gRPC<br/>varies"| KServeEP
    GORCHApp -->|"HTTP/HTTPS<br/>varies"| KServeEP
    LMESPod -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS creds"| S3
    LMESPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry creds"| OCI
    TASApp -->|"TCP/TLS<br/>5432"| PgSQL
    EvalHubApp -->|"TCP/TLS<br/>5432"| PgSQL
    EvalHubApp -->|"HTTPS/443<br/>TLS<br/>SA Token"| MLflow

    %% Service Mesh (conditional)
    Operator -.->|creates| DestRule
    Operator -.->|creates| VirtSvc
    Operator -.->|"creates<br/>⚠ cross-ns"| EnvoyFilter

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef mesh fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class TASRoute,EvalHubRoute,EvalHubMCPRoute,GORCHRoute,GORCHGWRoute,NemoRoute ingress
    class KRBP_TAS,KRBP_EvalHub,KRBP_GORCH,KRBP_Nemo auth
    class Operator,TASApp,EvalHubApp,GORCHApp,NemoApp,LMESPod app
    class K8sAPI,WebhookSvc controlplane
    class DestRule,VirtSvc,EnvoyFilter mesh
    class KServeEP,S3,OCI,PgSQL,MLflow externalservice
