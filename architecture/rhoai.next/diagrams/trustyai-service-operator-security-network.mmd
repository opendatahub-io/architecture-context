graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes — TLS 1.2+)"]
        TASRoute["TAS Route<br/>443/TCP → 8443/TCP<br/>TLS edge"]
        EHRoute["EvalHub Route<br/>443/TCP → 8443/TCP<br/>TLS passthrough"]
        EHMCPRoute["EvalHub MCP Route<br/>443/TCP → 8443/TCP<br/>TLS passthrough"]
        GORCHRoute["GORCH Route<br/>443/TCP → 8432/TCP<br/>TLS reencrypt"]
        NemoRoute["NeMo Route<br/>443/TCP → 8443/TCP<br/>TLS edge/reencrypt"]
    end

    subgraph AuthProxy["AUTH PROXY LAYER (kube-rbac-proxy)"]
        direction TB
        TASKRBP["TAS kube-rbac-proxy<br/>8443/TCP HTTPS<br/>SAR: trustyaiservices<br/>Auth: always"]
        EHKRBP["EvalHub kube-rbac-proxy<br/>8443/TCP HTTPS<br/>SAR: evalhubs/proxy<br/>Auth: always"]
        EHMCPKRBP["EvalHub MCP kube-rbac-proxy<br/>8443/TCP HTTPS<br/>SAR + AuthSecret"]
        GORCHKRBP["GORCH kube-rbac-proxy<br/>8432/TCP HTTPS<br/>SAR (if enable-auth)"]
        NEMOKRBP["NeMo kube-rbac-proxy<br/>8443/TCP HTTPS<br/>SAR (if enable-auth)"]
    end

    subgraph Services["APPLICATION LAYER (Cluster-Internal)"]
        direction TB

        subgraph NS_TAS["TAS Instance Namespace"]
            TAS["TrustyAI Service<br/>SA: {instance}-proxy<br/>8080/TCP HTTP"]
        end

        subgraph NS_EH["EvalHub Instance Namespace"]
            EvalHub["EvalHub API Server<br/>8444/TCP HTTP"]
            EvalHubMCP["EvalHub MCP Server<br/>HTTP"]
        end

        subgraph NS_GORCH["GORCH Instance Namespace"]
            Orch["Guardrails Orchestrator<br/>8032/TCP HTTPS"]
            BuiltIn["Built-in Detector<br/>8080/TCP HTTP"]
        end

        subgraph NS_Nemo["NeMo Instance Namespace"]
            NemoSrv["NeMo Guardrails Server"]
        end

        subgraph NS_LMEval["LMEval Pod (ephemeral)"]
            EvalPod["LMEval Main Container"]
            Driver["ta-lmes-driver<br/>18080/TCP HTTP<br/>localhost only"]
        end
    end

    subgraph ControlPlane["OPERATOR CONTROL PLANE"]
        Operator["trustyai-service-operator<br/>SA: controller-manager<br/>8080/TCP metrics<br/>8081/TCP probes<br/>9443/TCP webhook HTTPS"]
    end

    subgraph PlatformIntegration["PLATFORM INTEGRATION"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA Token Auth"]
        KServeIS["KServe InferenceServices<br/>HTTPS (serving cert)"]
        DetectorIS["Detector InferenceServices<br/>HTTPS (serving cert)"]
        GenIS["Generation InferenceService<br/>HTTPS (serving cert)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        PG["PostgreSQL<br/>5432/TCP<br/>TLS optional<br/>Auth: user/pass"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM"]
        OCIReg["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: dockerConfigJson"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        OTLPCol["OTLP Collector<br/>gRPC/HTTP<br/>TLS optional"]
    end

    %% External → Ingress
    Client -->|HTTPS/443<br/>TLS 1.2+| TASRoute
    Client -->|HTTPS/443<br/>TLS 1.2+| EHRoute
    Client -->|HTTPS/443<br/>TLS 1.2+| EHMCPRoute
    Client -->|HTTPS/443<br/>TLS 1.2+| GORCHRoute
    Client -->|HTTPS/443<br/>TLS 1.2+| NemoRoute

    %% Ingress → Auth Proxy
    TASRoute -->|HTTPS/8443<br/>OpenShift serving cert| TASKRBP
    EHRoute -->|HTTPS/8443<br/>serving cert| EHKRBP
    EHMCPRoute -->|HTTPS/8443<br/>serving cert| EHMCPKRBP
    GORCHRoute -->|HTTPS/8432<br/>TLS reencrypt| GORCHKRBP
    NemoRoute -->|HTTPS/8443<br/>serving cert| NEMOKRBP

    %% Auth Proxy → App
    TASKRBP -->|HTTP/8080<br/>localhost| TAS
    EHKRBP -->|HTTP/8444<br/>localhost| EvalHub
    EHMCPKRBP -->|HTTP<br/>localhost| EvalHubMCP
    GORCHKRBP -->|HTTPS/8032<br/>serving cert| Orch
    NEMOKRBP -->|HTTP<br/>localhost| NemoSrv

    %% App → External Services
    TAS -->|HTTPS<br/>serving cert| KServeIS
    EvalHub -->|PostgreSQL/5432<br/>TLS optional| PG
    EvalHub -->|gRPC/HTTP<br/>TLS optional| OTLPCol
    Orch -->|HTTPS<br/>serving cert| DetectorIS
    Orch -->|HTTPS<br/>serving cert| GenIS
    Orch -->|HTTP/8080<br/>localhost| BuiltIn
    EvalPod -->|HTTPS/443<br/>TLS 1.2+| HFHub
    EvalPod -->|HTTP/18080<br/>localhost| Driver
    Driver -->|HTTPS/443<br/>TLS 1.2+| OCIReg
    EvalPod -->|HTTPS/443<br/>TLS 1.2+| S3

    %% Operator → K8s API
    Operator -->|HTTPS/443<br/>SA Token| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class TASRoute,EHRoute,EHMCPRoute,GORCHRoute,NemoRoute ingress
    class TASKRBP,EHKRBP,EHMCPKRBP,GORCHKRBP,NEMOKRBP authproxy
    class TAS,EvalHub,EvalHubMCP,Orch,BuiltIn,NemoSrv,EvalPod,Driver service
    class Operator controlplane
    class K8sAPI,KServeIS,DetectorIS,GenIS platform
    class PG,S3,OCIReg,HFHub,OTLPCol externalservice
