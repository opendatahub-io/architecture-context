    style GatewayServer fill:#4a90e2,color:#fff
    style SupervisorCore fill:#4a90e2,color:#fff
    style SandboxRuntime fill:#4a90e2,color:#fff
    style Z3Prover fill:#9b59b6,color:#fff
    style K8sDriver fill:#7ed321
    style DockerDriver fill:#7ed321
    style PodmanDriver fill:#7ed321
    style VMDriver fill:#7ed321
    style MXCDriver fill:#7ed321
    style K8sSecrets fill:#f5a623
    style VaultDriver fill:#f5a623
    style DBCredStore fill:#f5a623
    style CLI fill:#e8e8e8
    style PythonSDK fill:#e8e8e8
    style GoSDK fill:#e8e8e8
    style TSSDK fill:#e8e8e8
