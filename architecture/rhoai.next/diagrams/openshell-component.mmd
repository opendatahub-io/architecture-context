graph TB
    subgraph Gateway["OpenShell Gateway (Rust/axum+tonic)"]
        direction TB
        GatewayServer["Gateway Server<br/>8080/TCP gRPC+HTTP"]
        AuthOIDC["OIDC Auth Module"]
        PolicyStore["Policy Storage"]
        ProviderMgr["Provider Credential Manager"]
        PeerRelay["Peer Relay (HA)"]
        WorkspaceMgr["Workspace Manager"]
        Interceptors["Gateway Interceptors"]
        GatewayServer --> AuthOIDC
        GatewayServer --> PolicyStore
        GatewayServer --> ProviderMgr
        GatewayServer --> PeerRelay
        GatewayServer --> WorkspaceMgr
        GatewayServer --> Interceptors
    end

    subgraph Supervisor["OpenShell Supervisor (Rust)"]
        direction TB
        SupervisorCore["Supervisor Core<br/>5500/TCP mTLS"]
        L7Proxy["L7 Network Proxy"]
        PolicyEval["Policy Evaluator<br/>OPA/Rego"]
        CredInjector["Credential Injector"]
        ProcessMgr["Process Lifecycle Manager"]
        Middleware["Middleware Chain"]
        SupervisorCore --> L7Proxy
        SupervisorCore --> PolicyEval
        SupervisorCore --> CredInjector
        SupervisorCore --> ProcessMgr
        SupervisorCore --> Middleware
    end

    subgraph Sandbox["OpenShell Sandbox (Rust static binary)"]
        direction TB
        SandboxRuntime["Sandbox Runtime"]
        SeccompMediator["Seccomp Mediator"]
        FSAccess["Filesystem Access Control"]
        ProcessIdentity["Process Identity Resolver"]
        SandboxRuntime --> SeccompMediator
        SandboxRuntime --> FSAccess
        SandboxRuntime --> ProcessIdentity
    end

    subgraph Prover["Formal Verification"]
        Z3Prover["Policy Prover<br/>Z3 SMT Solver"]
    end

    subgraph Drivers["Compute Drivers"]
        K8sDriver["Kubernetes Driver"]
        DockerDriver["Docker Driver"]
        PodmanDriver["Podman Driver"]
        VMDriver["MicroVM Driver<br/>libkrun"]
        MXCDriver["Windows MXC Driver"]
    end

    subgraph CredDrivers["Credential Drivers"]
        K8sSecrets["Kubernetes Secrets"]
        VaultDriver["Vault KV"]
        DBCredStore["DB CredStore<br/>AES-256-GCM"]
    end

    subgraph SDKs["Client SDKs"]
        CLI["openshell-cli"]
        PythonSDK["Python SDK"]
        GoSDK["Go SDK"]
        TSSDK["TypeScript SDK"]
    end

    %% SDK to Gateway
    CLI -->|gRPC/TLS| GatewayServer
    PythonSDK -->|gRPC/TLS| GatewayServer
    GoSDK -->|gRPC/TLS| GatewayServer
    TSSDK -->|Connect/TLS| GatewayServer

    %% Gateway to Drivers
    GatewayServer -->|ComputeDriver gRPC| K8sDriver
    GatewayServer -->|ComputeDriver gRPC| DockerDriver
    GatewayServer -->|ComputeDriver gRPC| PodmanDriver
    GatewayServer -->|ComputeDriver gRPC| VMDriver
    GatewayServer -->|ComputeDriver gRPC| MXCDriver

    %% Gateway to Credential Drivers
    ProviderMgr -->|CredentialDriver gRPC| K8sSecrets
    ProviderMgr -->|CredentialDriver gRPC| VaultDriver
    ProviderMgr -->|CredentialDriver gRPC| DBCredStore

    %% Gateway to Supervisor
    GatewayServer -->|mTLS/5500| SupervisorCore

    %% Sandbox to Supervisor
    SandboxRuntime -->|Sandbox Protocol<br/>mTLS + JWT| SupervisorCore

    %% Policy verification
    PolicyStore -->|verify changes| Z3Prover

    %% External dependencies
    K8sAPI[Kubernetes API]
    OIDC[OIDC Provider]
    OTLP[OTLP Collector]

    GatewayServer -->|HTTPS/443| K8sAPI
    AuthOIDC -->|HTTPS/443| OIDC
    GatewayServer -.->|gRPC/4317| OTLP

