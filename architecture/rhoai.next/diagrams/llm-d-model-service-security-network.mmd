graph TB
    subgraph External["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>Auth: HF_TOKEN"]
        Prometheus["Prometheus<br/>Scrapes 8443/TCP HTTPS<br/>Auth: Bearer Token<br/>(metrics-reader ClusterRole)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (modelservice-system)"]
        direction TB

        Controller["ModelService Controller<br/>SA: controller-manager<br/>Resources: 500m CPU, 512Mi mem"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS, TLS (self-signed)<br/>Auth: TokenReview + SAR"]
        HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No Auth<br/>/healthz, /readyz"]

        Controller --- MetricsSvc
        Controller --- HealthProbe
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Token"]
    end

    subgraph WorkloadNS["MANAGED WORKLOAD NAMESPACE (per-ModelService)"]
        direction TB

        subgraph InferenceStack["Inference Stack (per ModelService CR)"]
            Prefill["Prefill Deployment<br/>SA: per-model SA<br/>Ports: per BaseConfig"]
            Decode["Decode Deployment<br/>SA: per-model SA<br/>Ports: per BaseConfig"]
            EPP["EPP Deployment + Service<br/>SA: per-model SA<br/>RoleBinding: $EPP_CLUSTER_ROLE"]
        end

        subgraph RoutingCRs["Routing Resources"]
            HTTPRoute["HTTPRoute<br/>(gateway.networking.k8s.io)"]
            InfPool["InferencePool CR<br/>(inference.networking.x-k8s.io)"]
            InfModel["InferenceModel CR<br/>(inference.networking.x-k8s.io)"]
        end

        subgraph IdentityCRs["Identity Resources"]
            SA["ServiceAccount"]
            RB["RoleBinding"]
            CM["ConfigMaps"]
        end
    end

    %% Flows
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>CRUD operations"| K8sAPI
    K8sAPI -->|"Watch events<br/>HTTPS/443<br/>TLS 1.2+"| Controller

    Controller -->|"Creates/manages<br/>via K8s API"| Prefill
    Controller -->|"Creates/manages<br/>via K8s API"| Decode
    Controller -->|"Creates/manages<br/>via K8s API"| EPP
    Controller -->|"Creates/manages"| HTTPRoute
    Controller -->|"Creates/manages"| InfPool
    Controller -->|"Creates/manages"| InfModel
    Controller -->|"Creates/manages"| SA
    Controller -->|"Creates/manages"| RB
    Controller -->|"Creates/manages"| CM

    Prefill -->|"HTTPS/443<br/>HF_TOKEN"| HF
    Decode -->|"HTTPS/443<br/>HF_TOKEN"| HF
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| MetricsSvc

    %% Styling
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workload fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef routing fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef identity fill:#fff2cc,stroke:#d6b656,stroke-width:1px

    class HF,Prometheus external
    class Controller,MetricsSvc,HealthProbe operator
    class K8sAPI controlplane
    class Prefill,Decode,EPP workload
    class HTTPRoute,InfPool,InfModel routing
    class SA,RB,CM identity
