graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Model Owner / kubectl"]
        Prometheus["Prometheus<br/>Metrics Scraper"]
    end

    subgraph ClusterNetwork["KUBERNETES CLUSTER"]
        direction TB

        subgraph APIServer["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforced"]
        end

        subgraph ControllerNS["Namespace: modelservice-system"]
            Controller["modelservice-controller-manager<br/>SA: modelservice-controller-manager<br/>Image: controller:latest"]
            HealthProbe["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
            MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TLS (self-signed/cert-manager)<br/>TokenReview + SubjectAccessReview"]
        end

        subgraph TenantNS["Namespace: {user-namespace}"]
            PrefillPod["Prefill Deployment<br/>SA: per-model SA"]
            DecodePod["Decode Deployment<br/>SA: per-model SA"]
            EPPPod["EPP Deployment<br/>SA: per-model SA<br/>RoleBinding: $EPP_CLUSTER_ROLE"]
            EPPSvc["EPP Service"]
            InfPool["InferencePool CR"]
            InfModel["InferenceModel CR"]
            HTTPRouteCR["HTTPRoute CR"]
        end
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview + SAR"| MetricsEndpoint

    %% Controller to API Server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>CRUD on 10 resource types"| K8sAPI

    %% Health probes (kubelet)
    K8sAPI -.->|"HTTP/8081<br/>No encryption<br/>No auth"| HealthProbe

    %% Controller manages child resources (via API Server)
    Controller -.->|reconciles| PrefillPod
    Controller -.->|reconciles| DecodePod
    Controller -.->|reconciles| EPPPod
    Controller -.->|reconciles| InfPool
    Controller -.->|reconciles| InfModel
    Controller -.->|reconciles| HTTPRouteCR

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef childresource fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class User,Prometheus external
    class K8sAPI controlplane
    class Controller,HealthProbe,MetricsEndpoint controller
    class PrefillPod,DecodePod,EPPPod,EPPSvc,InfPool,InfModel,HTTPRouteCR childresource
