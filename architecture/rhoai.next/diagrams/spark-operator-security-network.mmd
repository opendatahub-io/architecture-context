graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / SA Token"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: redhat-ods-applications"]
        direction TB

        Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>8080/TCP metrics (HTTP)<br/>8081/TCP health (HTTP)<br/>FIPS: strictfipsruntime"]

        Webhook["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>9443/TCP HTTPS TLS 1.2+<br/>Platform-profiled TLS<br/>Cert: self-signed CA / cert-manager"]

        WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443 → 9443<br/>HTTPS TLS 1.2+"]

        Module["spark-operator-module controller<br/>8080/TCP metrics<br/>8081/TCP health<br/>⚠ No FIPS flags (CGO_ENABLED=0)"]
    end

    subgraph UserNS["USER NAMESPACES (Per-Tenant)"]
        direction TB

        Driver["Spark Driver Pod<br/>SA: spark-operator-spark<br/>Webhook-mutated"]
        Executors["Spark Executor Pods<br/>SA: spark-operator-spark"]

        UISvc["{app}-ui-svc<br/>ClusterIP 4040/TCP<br/>HTTP, No encryption"]

        ConnectSvc["{sparkconnect}-server<br/>ClusterIP<br/>7078, 7079, 4040, 15002/TCP<br/>gRPC, No encryption"]
    end

    subgraph WorkbenchNS["WORKBENCH NAMESPACES"]
        Workbench["Workbench Client<br/>Labels: opendatahub.io/dashboard<br/>opendatahub.io/workbenches"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        RESTSubmitter["REST Spark Submitter<br/>(optional, feature gate)<br/>HTTPS, mTLS<br/>Client cert + CA validation<br/>1MB request limit"]

        Prometheus["Prometheus<br/>8080/TCP HTTP<br/>Configurable TLS"]

        OpenShiftAPI["OpenShift APIServer<br/>443/TCP HTTPS<br/>TLS security profile fetch"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (RBAC)"| K8sAPI

    %% API server to webhooks
    K8sAPI -->|"HTTPS/9443<br/>TLS 1.2+<br/>K8s API auth"| WebhookSvc
    WebhookSvc --> Webhook

    %% Controller watches
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Module -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token (SSA)"| K8sAPI

    %% Controller creates resources
    Controller -.->|"creates + watches"| Driver
    Driver -.->|"TCP (intra-ns)"| Executors

    %% Workbench to SparkConnect
    Workbench -->|"gRPC/15002<br/>No encryption<br/>NetworkPolicy"| ConnectSvc

    %% External service flows
    Controller -->|"HTTPS<br/>mTLS client certs"| RESTSubmitter
    Controller -.->|"HTTP/8080<br/>metrics scrape"| Prometheus
    Controller -->|"HTTPS/443<br/>TLS 1.2+"| OpenShiftAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef workbench fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Controller,Webhook,WebhookSvc,Module operator
    class Driver,Executors,UISvc,ConnectSvc userns
    class Workbench workbench
    class RESTSubmitter,Prometheus,OpenShiftAPI extsvc
