graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Science Pipeline"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer / SA Token"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443/TCP → 9443/TCP<br/>TLS 1.2+ (self-signed/cert-manager)<br/>SA: spark-operator-webhook"]

        Controller["spark-operator-controller<br/>8080/TCP (metrics), 8081/TCP (health)<br/>Leader Election: Lease<br/>SA: spark-operator-controller"]

        ModuleCtrl["spark-operator-module-controller<br/>8081/TCP (health)<br/>SA: spark-operator-module-controller-manager"]

        WebhookCert["Secret: spark-operator-webhook-certs<br/>kubernetes.io/tls"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACES (NetworkPolicy enforced)"]
        direction TB

        Driver["Driver Pod<br/>SA: spark-operator-spark"]

        Executors["Executor Pods<br/>7078/TCP (driver-rpc)<br/>7079/TCP (blockmanager)"]

        ConnectSvr["Spark Connect Server<br/>15002/TCP (gRPC)<br/>4040/TCP (Spark UI)"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile config"]
        CertMgr["cert-manager<br/>(optional)<br/>Certificate + Issuer CRs"]
        PromOp["prometheus-operator<br/>PodMonitor scraping"]
        ODHOp["ODH/RHOAI Operator<br/>SparkOperator CR"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User token / SA"| K8sAPI

    %% Control Plane → Webhook
    K8sAPI -->|"HTTPS/443→9443<br/>TLS 1.2+<br/>Admission CA bundle"| WebhookSvc

    %% Controller → K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Module Controller → K8s API
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Controller → Workloads
    Controller -->|"Creates via K8s API"| Driver
    Controller -->|"Creates via K8s API"| ConnectSvr

    %% Driver ↔ Executors
    Driver -->|"TCP/7078 driver-rpc<br/>TCP/7079 blockmanager<br/>No encryption"| Executors

    %% Platform Service integrations
    WebhookSvc -->|"Reads TLS profile<br/>HTTPS/6443"| OpenShiftAPI
    Controller -->|"Certificate CRs<br/>via K8s API"| CertMgr
    PromOp -->|"Scrapes HTTP/8080<br/>PodMonitor"| Controller
    ODHOp -->|"SparkOperator CR<br/>via K8s API"| ModuleCtrl

    %% Webhook cert
    WebhookSvc -.->|uses| WebhookCert

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class K8sAPI controlplane
    class WebhookSvc,Controller,ModuleCtrl operator
    class Driver,Executors,ConnectSvr workload
    class OpenShiftAPI,CertMgr,PromOp,ODHOp platform
    class WebhookCert secret
