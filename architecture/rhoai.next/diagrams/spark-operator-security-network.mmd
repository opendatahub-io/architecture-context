graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer / SA Token / mTLS"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443/TCP &rarr; 9443/TCP<br/>TLS 1.2+ (OpenShift profile)<br/>mTLS (fail-closed)<br/>SA: spark-operator-webhook"]

        Controller["spark-operator-controller<br/>8080/TCP metrics (HTTP)<br/>8081/TCP probes (HTTP)<br/>SA: spark-operator-controller<br/>ReadOnly rootfs, drop ALL caps"]
    end

    subgraph AppNS["APPLICATION NAMESPACE (user workloads)"]
        direction TB

        subgraph SparkPods["Spark Workload Pods"]
            Driver["Spark Driver Pod<br/>SA: spark-operator-spark<br/>4040/TCP Spark UI (HTTP)"]
            Executors["Spark Executor Pods<br/>Dynamic scaling"]
            ConnectServer["SparkConnect Server<br/>15002/TCP gRPC<br/>7078/TCP Driver RPC<br/>7079/TCP Block Manager<br/>4040/TCP Web UI"]
        end

        NetworkPolicy["NetworkPolicy (RHOAI)<br/>Allow: 7078, 7079, 4040, 15002<br/>From: workbench namespaces"]

        DriverSvc["Driver Service<br/>ClusterIP 4040/TCP HTTP"]
        ConnectSvcRes["SparkConnect Service<br/>ClusterIP 15002/TCP gRPC"]
    end

    subgraph OptIngress["OPTIONAL INGRESS"]
        IngressRes["Ingress Resource<br/>80/TCP HTTP<br/>Optional TLS (SIMPLE)<br/>Templatable host"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes 8080/TCP HTTP<br/>PodMonitor discovery"]
    end

    subgraph OptionalServices["OPTIONAL SERVICES"]
        RESTSubmitter["REST Submitter Service<br/>configurable/TCP<br/>HTTP/HTTPS<br/>Optional mTLS + client cert"]
        CertManager["cert-manager<br/>Certificate CRD<br/>Webhook TLS lifecycle"]
        Volcano["Volcano Scheduler<br/>PodGroup CRD<br/>Gang scheduling"]
        Yunikorn["Yunikorn Scheduler<br/>Pod annotations<br/>Task group scheduling"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Webhook admission flow
    K8sAPI -->|"HTTPS 443&rarr;9443<br/>TLS 1.2+ (cluster profile)<br/>mTLS"| WebhookSvc
    WebhookSvc -->|"HTTPS/443<br/>ResourceQuota check<br/>SA token"| K8sAPI

    %% Controller reconciliation
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Controller to spark-submit / pods
    Controller -->|"spark-submit exec<br/>or REST POST (mTLS)"| RESTSubmitter
    Controller -.->|"Creates via K8s API"| Driver

    %% Spark internal
    Driver -->|"TCP/7078-7079<br/>No encryption<br/>Spark internal"| Executors
    ConnectServer -->|"TCP/7078-7079<br/>No encryption"| Executors

    %% Services
    Driver --- DriverSvc
    ConnectServer --- ConnectSvcRes

    %% Optional ingress
    DriverSvc -.-> IngressRes

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>No encryption"| Controller
    Prometheus -->|"HTTP/8080<br/>No encryption"| WebhookSvc

    %% Optional services
    CertManager -.->|"Certificate CRD"| WebhookSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef appns fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5

    class User external
    class K8sAPI controlplane
    class WebhookSvc,Controller operator
    class Driver,Executors,ConnectServer,NetworkPolicy,DriverSvc,ConnectSvcRes appns
    class IngressRes ingress
    class Prometheus monitoring
    class RESTSubmitter,CertManager,Volcano,Yunikorn optional
