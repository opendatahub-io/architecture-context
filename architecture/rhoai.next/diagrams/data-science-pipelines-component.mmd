graph TB
    subgraph DSP["Data Science Pipelines"]
        direction TB

        subgraph Services["Deployed Services"]
            APIServer["API Server<br/>gRPC: 8887/TCP<br/>REST: 8888/TCP<br/>Webhook: 8443/TCP"]
            PersistenceAgent["Persistence Agent<br/>(no listener)"]
            SWFController["Scheduled Workflow<br/>Controller<br/>(no listener)"]
            CacheServer["Cache Server<br/>Mutating Webhook<br/>443/TCP → 8443/TCP"]
            ViewerController["Viewer Controller<br/>(no listener)"]
        end

        subgraph StepBinaries["Argo Workflow Step Binaries"]
            Driver["Driver<br/>(init container)<br/>Resolves inputs, checks cache"]
            Launcher["Launcher<br/>(step container)<br/>Artifact I/O, executes user code"]
        end
    end

    %% CRDs
    ScheduledWorkflowCR["ScheduledWorkflow CR<br/>kubeflow.org/v1beta1"]
    ViewerCR["Viewer CR<br/>kubeflow.org/v1beta1"]
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]

    %% External Users
    Client["Client<br/>(SDK / UI / CLI)"]
    DSPO["data-science-pipelines-operator<br/>(DSPO)"]

    %% CRD relationships
    Client -->|"creates runs via API"| APIServer
    APIServer -->|"validates/mutates"| PipelineVersionCR
    APIServer -->|"manages"| PipelineCR
    SWFController -->|"watches & reconciles"| ScheduledWorkflowCR
    ViewerController -->|"watches & reconciles"| ViewerCR
    PersistenceAgent -->|"reports status to"| APIServer

    %% Argo Workflow integration
    APIServer -->|"creates"| ArgoWorkflow["Argo Workflow"]
    SWFController -->|"creates on schedule"| ArgoWorkflow
    ArgoWorkflow -->|"runs"| Driver
    Driver -->|"prepares env for"| Launcher
    PersistenceAgent -->|"watches"| ArgoWorkflow
    PersistenceAgent -->|"watches"| ScheduledWorkflowCR

    %% Cache webhook
    CacheServer -->|"intercepts pod creation<br/>injects cached outputs"| ArgoWorkflow

    %% External dependencies
    APIServer -->|"gRPC 8080"| MLMD["ML Metadata<br/>(MLMD)"]
    APIServer -->|"3306/5432"| Database["MySQL / PostgreSQL"]
    APIServer -->|"S3 API 443"| ObjectStorage["S3 / MinIO"]
    APIServer -.->|"HTTP/HTTPS"| MLflow["MLflow Server<br/>(optional)"]
    Driver -->|"gRPC 8080"| MLMD
    Driver -->|"S3 API"| ObjectStorage
    Launcher -->|"gRPC 8080"| MLMD
    Launcher -->|"S3 API"| ObjectStorage

    %% Operator
    DSPO -->|"deploys & manages"| DSP

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style PersistenceAgent fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style SWFController fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style CacheServer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ViewerController fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Driver fill:#50c878,stroke:#333,stroke-width:2px,color:#fff
    style Launcher fill:#50c878,stroke:#333,stroke-width:2px,color:#fff
    style ScheduledWorkflowCR fill:#f5a623,stroke:#333,stroke-width:1px
    style ViewerCR fill:#f5a623,stroke:#333,stroke-width:1px
    style PipelineCR fill:#f5a623,stroke:#333,stroke-width:1px
    style PipelineVersionCR fill:#f5a623,stroke:#333,stroke-width:1px
    style ArgoWorkflow fill:#f5a623,stroke:#333,stroke-width:1px
    style Database fill:#e8e8e8,stroke:#333
    style ObjectStorage fill:#e8e8e8,stroke:#333
    style MLMD fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style DSPO fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    style Client fill:#f9f9f9,stroke:#333,stroke-width:2px
