graph TB
    subgraph DSP["Data Science Pipelines"]
        direction TB

        subgraph APIServer["ml-pipeline (API Server)"]
            HTTPProxy["HTTP Proxy<br/>8888/TCP"]
            gRPCServer["gRPC Server<br/>8887/TCP"]
            WebhookServer["Webhook Server<br/>8443/TCP HTTPS"]
            HTTPProxy -->|"grpc-gateway"| gRPCServer
        end

        subgraph TaskPod["Argo Workflow Task Pod"]
            Driver["Driver<br/>(init container)"]
            Launcher["Launcher v2<br/>(main container)"]
            UserCode["User Code"]
            Driver -->|"pod spec patch"| Launcher
            Launcher -->|"executes"| UserCode
        end

        PersistenceAgent["Persistence Agent<br/>(informer-based)"]
        SWFController["Scheduled Workflow<br/>Controller<br/>9090/TCP metrics"]
    end

    %% CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]
    SWFCR["ScheduledWorkflow CR<br/>scheduledworkflow.kubeflow.org/v1beta1"]
    ViewerCR["Viewer CR<br/>viewer.kubeflow.org/v1beta1"]

    %% External dependencies
    ArgoWF["Argo Workflows v3"]
    Database["MySQL / PostgreSQL"]
    ObjectStore["MinIO / S3 / GCS"]
    MLMD["ML Metadata<br/>(MLMD)<br/>8080/TCP gRPC"]
    K8sAPI["Kubernetes API<br/>443/TCP"]
    CacheServer["Cache Server<br/>443/TCP HTTPS"]
    VizServer["Visualization Server<br/>8888/TCP"]

    %% Internal consumers
    Client["Client<br/>(SDK / UI / Dashboard)"]
    DSPO["Data Science Pipelines<br/>Operator (DSPO)"]

    %% Client flows
    Client -->|"REST/gRPC"| HTTPProxy
    Client -->|"gRPC"| gRPCServer

    %% API Server connections
    gRPCServer -->|"SQL"| Database
    gRPCServer -->|"S3 API"| ObjectStore
    gRPCServer -->|"REST"| ArgoWF
    gRPCServer -->|"gRPC"| MLMD
    gRPCServer -->|"HTTP"| VizServer
    gRPCServer -->|"REST"| K8sAPI
    WebhookServer -->|"validates/mutates"| PipelineVersionCR

    %% CRD relationships
    PipelineCR -->|"watched by"| gRPCServer
    SWFCR -->|"reconciled by"| SWFController

    %% Task pod connections
    Driver -->|"gRPC"| MLMD
    Driver -->|"HTTPS"| CacheServer
    Launcher -->|"S3 API"| ObjectStore
    Launcher -->|"gRPC"| MLMD

    %% Persistence Agent connections
    PersistenceAgent -->|"watches Workflows"| K8sAPI
    PersistenceAgent -->|"gRPC reports"| gRPCServer

    %% SWF Controller connections
    SWFController -->|"watches SWF"| K8sAPI
    SWFController -->|"CreateRun gRPC"| gRPCServer

    %% Argo creates task pods
    ArgoWF -->|"creates"| TaskPod

    %% Operator manages
    DSPO -.->|"deploys & manages"| DSP

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Driver fill:#4a90e2,stroke:#333,color:#fff
    style Launcher fill:#4a90e2,stroke:#333,color:#fff
    style PersistenceAgent fill:#4a90e2,stroke:#333,color:#fff
    style SWFController fill:#4a90e2,stroke:#333,color:#fff
    style PipelineCR fill:#f5a623,stroke:#333,color:#000
    style PipelineVersionCR fill:#f5a623,stroke:#333,color:#000
    style SWFCR fill:#f5a623,stroke:#333,color:#000
    style ViewerCR fill:#f5a623,stroke:#333,color:#000
    style ArgoWF fill:#e8e8e8,stroke:#333,color:#000
    style Database fill:#e8e8e8,stroke:#333,color:#000
    style ObjectStore fill:#e8e8e8,stroke:#333,color:#000
    style MLMD fill:#7ed321,stroke:#333,color:#000
    style CacheServer fill:#7ed321,stroke:#333,color:#000
    style VizServer fill:#7ed321,stroke:#333,color:#000
    style DSPO fill:#7ed321,stroke:#333,color:#000
    style K8sAPI fill:#e8e8e8,stroke:#333,color:#000
    style Client fill:#f9f9f9,stroke:#999
