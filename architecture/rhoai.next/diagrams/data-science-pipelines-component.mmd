graph TB
    subgraph DSP["Data Science Pipelines"]
        direction TB

        subgraph APILayer["API Layer"]
            APIServer["ml-pipeline<br/>(API Server)<br/>8888/TCP HTTP<br/>8887/TCP gRPC<br/>8443/TCP Webhook"]
            CacheServer["cache-server<br/>Mutating Webhook<br/>443/TCP HTTPS"]
        end

        subgraph Controllers["Controllers"]
            PersistenceAgent["ml-pipeline-persistenceagent<br/>Syncs Workflow status"]
            ScheduledWorkflow["ml-pipeline-scheduledworkflow<br/>Recurring run controller<br/>9090/TCP metrics"]
            ViewerCRD["ml-pipeline-viewer-crd<br/>Viewer controller"]
        end

        subgraph TaskExecution["Task Execution (In-Pod)"]
            Driver["driver<br/>Init/Sidecar<br/>Resolves inputs, patches pod spec"]
            Launcher["launcher-v2<br/>Sidecar<br/>Artifact I/O, executor invocation"]
        end

        subgraph Frontend["Frontend"]
            UI["ml-pipeline-ui<br/>React Web UI<br/>80/TCP"]
            VizServer["ml-pipeline-visualizationserver<br/>ROC, confusion matrix<br/>8888/TCP"]
        end

        subgraph Metadata["Metadata Services"]
            MetadataGRPC["metadata-grpc-deployment<br/>MLMD gRPC<br/>8080/TCP"]
            MetadataEnvoy["metadata-envoy-deployment<br/>HTTP-to-gRPC proxy<br/>9090/TCP"]
            MetadataWriter["metadata-writer<br/>Writes MLMD entries"]
        end
    end

    %% External Resources
    User["Data Scientist / KFP SDK"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    ArgoWF["Argo Workflows Controller"]
    MySQL["MySQL / MariaDB<br/>3306/TCP"]
    S3["S3-Compatible Storage"]

    %% CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]
    ScheduledWorkflowCR["ScheduledWorkflow CR<br/>kubeflow.org"]

    %% User flows
    User -->|"REST/gRPC"| APIServer
    User -->|"Web UI"| UI
    UI -->|"API calls"| APIServer

    %% API Server connections
    APIServer -->|"SQL"| MySQL
    APIServer -->|"S3 API"| S3
    APIServer -->|"creates Workflows"| K8sAPI
    APIServer -->|"validates/mutates"| PipelineVersionCR

    %% CRD interactions
    PipelineCR -->|"watched by"| APIServer
    PipelineVersionCR -->|"watched by"| APIServer
    ScheduledWorkflowCR -->|"watched by"| ScheduledWorkflow

    %% Controller flows
    PersistenceAgent -->|"watches Workflows"| K8sAPI
    PersistenceAgent -->|"reports status"| APIServer
    ScheduledWorkflow -->|"creates Workflows"| K8sAPI

    %% Execution flows
    ArgoWF -->|"injects"| Driver
    ArgoWF -->|"injects"| Launcher
    Driver -->|"gRPC"| MetadataGRPC
    Launcher -->|"artifact I/O"| S3

    %% Cache
    CacheServer -->|"intercepts pods"| K8sAPI

    %% Metadata
    MetadataWriter -->|"writes entries"| MetadataGRPC
    MetadataEnvoy -->|"proxies"| MetadataGRPC
    VizServer -->|"reads artifacts"| S3

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style CacheServer fill:#4a90e2,stroke:#333,color:#fff
    style PersistenceAgent fill:#50c878,stroke:#333
    style ScheduledWorkflow fill:#50c878,stroke:#333
    style ViewerCRD fill:#50c878,stroke:#333
    style Driver fill:#9b59b6,stroke:#333,color:#fff
    style Launcher fill:#9b59b6,stroke:#333,color:#fff
    style UI fill:#e67e22,stroke:#333,color:#fff
    style VizServer fill:#e67e22,stroke:#333,color:#fff
    style MetadataGRPC fill:#95a5a6,stroke:#333
    style MetadataEnvoy fill:#95a5a6,stroke:#333
    style MetadataWriter fill:#95a5a6,stroke:#333
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style ScheduledWorkflowCR fill:#f5a623,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ArgoWF fill:#e8e8e8,stroke:#333
