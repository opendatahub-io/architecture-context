graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS LAYER"]
        direction TB
        GW1["Gateway / Istio Gateway<br/>443/TCP → HTTPRoute/VirtualService<br/>TLS 1.2+<br/>(InferenceService traffic)"]
        GW2["data-science-gateway<br/>443/TCP → HTTPRoute → InferencePool<br/>TLS 1.2+<br/>(LLMInferenceService traffic)"]
    end

    subgraph ControlPlane["CONTROL PLANE (Namespace: kserve)"]
        direction TB
        KServeCtrl["kserve-controller-manager<br/>SA: kserve-controller-manager<br/>9443/TCP webhook (TLS, cert-manager)<br/>8080/TCP metrics (kube-rbac-proxy)<br/>8081/TCP health"]
        LLMCtrl["llmisvc-controller<br/>SA: llmisvc-controller-manager<br/>9443/TCP webhook (TLS, cert-manager)<br/>8080/TCP metrics<br/>8081/TCP health"]
        LMCtrl["localmodel-controller<br/>SA: localmodel-controller-manager<br/>8081/TCP health"]
        LMNodeAgent["localmodelnode-agent<br/>SA: localmodelnode-controller-manager<br/>8081/TCP health (per-node)"]
        ModuleCtrl["kserve-module-controller<br/>SA: kserve-module-controller-manager<br/>8081/TCP health"]
    end

    subgraph WebhookSvc["WEBHOOK SERVICES"]
        WHSvc["kserve-webhook-server-service<br/>ClusterIP 443→9443/TCP<br/>TLS (cert-manager)<br/>K8s webhook x509 auth"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS, kube-rbac-proxy"]
    end

    subgraph DataPlaneISVC["DATA PLANE — InferenceService (user namespace)"]
        Predictor["Predictor Pod<br/>8080/TCP HTTP<br/>Sidecar: inference-agent (optional)<br/>Sidecar: kube-rbac-proxy 8443/TCP (distro)<br/>Init: storage-initializer"]
        IGRouter["InferenceGraph Router<br/>8080/TCP HTTP, 8443/TCP HTTPS<br/>Auth: auth-delegator (distro)"]
    end

    subgraph DataPlaneLLM["DATA PLANE — LLMInferenceService (user namespace)"]
        Scheduler["Scheduler (EPP)<br/>gRPC (endpoint picking)<br/>metrics/TCP (Bearer token)<br/>TLS"]
        Workload["Workload Pod (vLLM)<br/>8000/TCP HTTP/HTTPS<br/>TLS (self-signed)<br/>mTLS via DestinationRule (distro)"]
        LWS["LeaderWorkerSet<br/>Headless services<br/>(multi-node discovery)"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES (Cluster-Internal)"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA token auth"]
        CertMgr["cert-manager<br/>443/TCP HTTPS<br/>Certificate/Issuer"]
        Istio["Istio / Service Mesh<br/>VirtualService, DestinationRule<br/>mTLS STRICT"]
        Knative["Knative Serving<br/>Serverless mode"]
        GatewayAPI["Gateway API<br/>Gateway, HTTPRoute<br/>GIE InferencePool"]
        KEDA_dep["KEDA<br/>ScaledObject"]
        PromOp["Prometheus Operator<br/>PodMonitor/ServiceMonitor"]
        LWSdep["LeaderWorkerSet<br/>Multi-node topology"]
        WVA["WVA<br/>VariantAutoscaling"]
        ODHOp["ODH Platform Operator<br/>Kserve CR"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES (Egress)"]
        S3["S3 Storage<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS TLS 1.2+<br/>GCP credentials"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS TLS 1.2+<br/>Azure Identity"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS TLS 1.2+<br/>HF Token (optional)"]
        HDFS["HDFS NameNode<br/>8020/TCP RPC<br/>Kerberos TGT"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prom["Prometheus<br/>9090/TCP"]
        OTel["OTLP Endpoint<br/>gRPC TLS (configurable)"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer/OAuth"| GW1
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer/OAuth"| GW2

    %% Ingress → Data Plane
    GW1 -->|"HTTP/8080<br/>cluster-internal"| Predictor
    GW1 -->|"HTTP/8080<br/>cluster-internal"| IGRouter
    GW2 -->|"gRPC<br/>mTLS (DestinationRule)"| Scheduler
    Scheduler -->|"HTTP(S)/8000<br/>TLS (self-signed)"| Workload

    %% Control Plane → K8s API
    KServeCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    LLMCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    LMCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    LMNodeAgent -->|"HTTPS/443<br/>SA token"| K8sAPI
    ModuleCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI

    %% Webhook
    K8sAPI -->|"HTTPS/443→9443<br/>x509 auth"| WHSvc

    %% Data Plane → External Storage
    Predictor -->|"HTTPS/443<br/>TLS 1.2+<br/>Backend creds"| S3
    Predictor -->|"HTTPS/443<br/>TLS 1.2+"| GCS
    Predictor -->|"HTTPS/443<br/>TLS 1.2+"| Azure
    Predictor -->|"HTTPS/443<br/>TLS 1.2+"| HF

    %% Observability
    Prom -->|"HTTPS/8000<br/>insecureSkipVerify"| Workload
    Prom -->|"HTTP/metrics<br/>Bearer token"| Scheduler
    Workload -.->|"gRPC OTLP<br/>TLS"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef dataplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef webhook fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px

    class Client external
    class GW1,GW2 ingress
    class KServeCtrl,LLMCtrl,LMCtrl,LMNodeAgent,ModuleCtrl controlplane
    class Predictor,IGRouter,Scheduler,Workload,LWS dataplane
    class K8sAPI,CertMgr,Istio,Knative,GatewayAPI,KEDA_dep,PromOp,LWSdep,WVA,ODHOp platform
    class S3,GCS,Azure,HF,HDFS externalsvc
    class Prom,OTel observability
    class WHSvc,MetricsSvc webhook
