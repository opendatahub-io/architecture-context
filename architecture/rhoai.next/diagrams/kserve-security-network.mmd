graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / Data Scientist"]
    end

    subgraph K8sLayer["KUBERNETES API SERVER"]
        K8sAPI["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph ControlPlane["KSERVE CONTROL PLANE (RBAC Enforced)"]
        direction TB

        subgraph NS_Controller["Namespace: redhat-ods-applications"]
            ModuleCtrl["kserve-module-controller<br/>SA: kserve-module-controller-manager<br/>8081/TCP health, 9443/TCP webhooks<br/>FIPS: strictfipsruntime"]
            ServingAPI["model-serving-api<br/>SA: model-serving-api<br/>8443/TCP HTTPS TLS<br/>8080/TCP metrics"]
            WebhookSvc["Webhook Service<br/>443→9443/TCP HTTPS<br/>TLS service-CA<br/>failurePolicy: Fail"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>kube-rbac-proxy"]
        end
    end

    subgraph IngressLayer["INGRESS (Dynamic per InferenceService)"]
        Gateway["Platform Gateway<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph DataPlaneLayer["DATA PLANE (Per-Namespace, Tenant-Isolated)"]
        direction TB

        subgraph NS_User["Namespace: user-namespace"]
            ServingPod["Model Serving Pod<br/>vLLM / OVMS / MLServer<br/>8080/TCP REST, 8081/TCP gRPC<br/>No auth middleware"]
            QPExt["qpext sidecar<br/>Prometheus metrics"]
        end

        subgraph NS_Nodes["DaemonSet: worker nodes"]
            LMNAgent["LocalModelNode Agent<br/>SA: kserve-localmodelnode-agent<br/>Download Jobs"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>AWS IAM"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>Google OAuth"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>Azure Identity"]
        Registry["Container Registries<br/>443/TCP HTTPS<br/>cosign verification"]
    end

    %% Flows
    Client -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"HTTPS/443→9443<br/>TLS service-CA<br/>Client cert"| WebhookSvc
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    ServingAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    ModuleCtrl -.->|"Creates HTTPRoute"| Gateway
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Gateway -->|"HTTP/8080<br/>No encryption<br/>NetworkPolicy"| ServingPod

    LMNAgent -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    LMNAgent -->|"HTTPS/443<br/>TLS<br/>Google OAuth"| GCS
    LMNAgent -->|"HTTPS/443<br/>TLS<br/>Azure Identity"| Azure
    ModuleCtrl -->|"HTTPS/443<br/>TLS<br/>Registry creds"| Registry

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8s fill:#326ce5,stroke:#1a3a7a,stroke-width:2px,color:#fff
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef dataplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class K8sAPI k8s
    class ModuleCtrl,ServingAPI,WebhookSvc,MetricsSvc controlplane
    class Gateway ingress
    class ServingPod,QPExt,LMNAgent dataplane
    class S3,GCS,Azure,Registry externalservice
