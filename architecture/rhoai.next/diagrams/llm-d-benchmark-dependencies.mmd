    style Helmfile fill:#999,stroke:#333,color:#fff
    style Jinja2 fill:#999,stroke:#333,color:#fff
    style PyYAML fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style HFHub fill:#999,stroke:#333,color:#fff
    style BenchReport fill:#999,stroke:#333,color:#fff

    %% Cloud storage
