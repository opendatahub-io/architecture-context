    style S3 fill:#f5a623,stroke:#333,color:#fff

    %% Bundled harnesses
    style InferencePerf fill:#b8e986,stroke:#333
    style GuideLLM fill:#b8e986,stroke:#333
    style VLLMBench fill:#b8e986,stroke:#333
    style AiPerf fill:#b8e986,stroke:#333
