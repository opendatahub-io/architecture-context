graph LR
    LLMDBench["llm-d-benchmark<br/>CLI + Framework"]

    %% Core Runtime Dependencies
    LLMDBench -->|"cluster ops"| K8sAPI["Kubernetes API<br/>Python SDK + kubectl"]
    LLMDBench -->|"model validation"| HFHub["HuggingFace Hub<br/>huggingface-hub"]
    LLMDBench -->|"manifest rendering"| Jinja2["Jinja2<br/>Template engine"]
    LLMDBench -->|"config parsing"| PyYAML["PyYAML >=6.0"]
    LLMDBench -->|"schema validation"| Pydantic["pydantic >=2.0"]
    LLMDBench -->|"result schema"| BenchReport["llmd-benchmark-report<br/>>=0.2.1,<0.3"]

    %% Deployment Tools
    LLMDBench -->|"chart mgmt"| Helm["Helm >=4.x"]
    LLMDBench -->|"chart orchestration"| Helmfile["helmfile >=1.5"]

    %% Cloud Storage
    LLMDBench -->|"result upload"| GCS["Google Cloud Storage<br/>google-cloud-storage >=2.10.0"]
    LLMDBench -->|"result upload"| S3["AWS S3<br/>aws CLI"]

    %% Bundled Harnesses
    LLMDBench -.->|"bundled"| InferencePerf["inference-perf v0.7.0"]
    LLMDBench -.->|"bundled"| GuideLLM["guidellm v0.7.3"]
    LLMDBench -.->|"bundled"| VLLMBench["vllm-benchmark v0.30.0"]
    LLMDBench -.->|"bundled"| AiPerf["aiperf v0.12.0"]
    LLMDBench -.->|"bundled"| LMEval["lm-eval 0.4.12"]

    %% Platform Dependencies (internal)
    LLMDBench -->|"route discovery"| OSRoutes["OpenShift Routes<br/>route.openshift.io/v1"]
    LLMDBench -->|"gateway discovery"| GatewayAPI["Gateway API<br/>gateway.networking.k8s.io/v1"]
    LLMDBench -->|"pool discovery"| GAIE["GAIE CRDs<br/>inference.networking.x-k8s.io"]
    LLMDBench -.->|"metrics"| Prometheus["Prometheus<br/>PodMonitor CRD"]

    %% Integration consumers
    ModelService["llm-d-modelservice<br/>Helm chart"] -.->|"deployed by"| LLMDBench
    LLMDInfra["llm-d-infra<br/>Prerequisite CRDs"] -.->|"required by"| LLMDBench

    %% Styling
    style LLMDBench fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

