graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / Dashboard<br/>External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        DSPRoute["ds-pipeline-{name} Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        MLMDRoute["ds-pipeline-metadata-envoy Route<br/>443/TCP → 9090/TCP<br/>TLS"]
        MinIORoute["minio-{name} Route<br/>443/TCP → 9000/TCP<br/>TLS (conditional)"]
    end

    subgraph AuthzLayer["AUTHORIZATION LAYER"]
        RBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS (service-ca)<br/>SubjectAccessReview on DSPA api"]
    end

    subgraph AppLayer["APPLICATION LAYER (User Namespace)"]
        direction TB

        subgraph DSPComponents["DSP Components (NetworkPolicy protected)"]
            APIServer["KFP API Server<br/>:8888 HTTP/HTTPS<br/>:8887 gRPC<br/>SA: ds-pipeline-{name}"]
            PersistAgent["Persistence Agent<br/>SA: ds-pipeline-persistenceagent-{name}"]
            SchedWF["Scheduled Workflow<br/>SA: ds-pipeline-scheduledworkflow-{name}"]
            ArgoCtrl["Argo Workflow Controller<br/>SA: ds-pipeline-workflow-controller-{name}"]
        end

        subgraph MLMDComponents["MLMD Stack"]
            EnvoyProxy["MLMD Envoy Proxy<br/>:9090 gRPC<br/>TLS (service-ca)"]
            MLMDServer["MLMD gRPC Server<br/>:8080 gRPC<br/>mTLS (service-ca)"]
        end

        TaskPods["Pipeline Task Pods"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(redhat-ods-applications)"]
        DSPOCtrl["DSPO Controller Manager<br/>Health: 8081/TCP<br/>Metrics: 8080/TCP TLS<br/>Webhook: 9443/TCP TLS<br/>SA: dspo-controller-manager"]
    end

    subgraph InternalInfra["INTERNAL INFRASTRUCTURE (Optional)"]
        MariaDB["MariaDB<br/>:3306 MySQL<br/>TLS (service-ca)<br/>Password auth"]
        MinIO["MinIO<br/>:9000 HTTP<br/>Plaintext<br/>Access key auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ExtDB["External MySQL DB<br/>:3306 TLS<br/>Password auth"]
        ExtS3["External S3 Storage<br/>:443 HTTPS<br/>Access key auth"]
        OCIReg["OCI Container Registry<br/>:443 HTTPS TLS 1.2+<br/>Docker keychain"]
        K8sAPI["Kubernetes API<br/>:6443 HTTPS mTLS<br/>SA token"]
        OSConfig["OpenShift APIServer Config<br/>K8s API mTLS"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS Reencrypt<br/>Bearer Token"| DSPRoute
    Client -.->|"HTTPS/443<br/>TLS (conditional)"| MLMDRoute
    Client -.->|"HTTPS/443<br/>TLS (conditional)"| MinIORoute

    %% Ingress to auth
    DSPRoute -->|"HTTPS/8443<br/>TLS (service-ca)<br/>SubjectAccessReview"| RBACProxy
    MLMDRoute -->|"gRPC/9090<br/>TLS (service-ca)"| EnvoyProxy
    MinIORoute -->|"HTTP/9000<br/>Access key"| MinIO

    %% Auth to app
    RBACProxy -->|"HTTP(S)/8888<br/>pod-to-pod TLS<br/>No auth (internal)"| APIServer

    %% Internal component flows
    PersistAgent -->|"HTTP(S)/8888<br/>pod-to-pod TLS"| APIServer
    SchedWF -->|"HTTP(S)/8888<br/>pod-to-pod TLS"| APIServer
    APIServer -->|"K8s API<br/>Workflow CR creation"| ArgoCtrl
    ArgoCtrl -->|"K8s API<br/>Pod creation"| TaskPods
    TaskPods -->|"gRPC/9090<br/>TLS (service-ca)"| EnvoyProxy
    EnvoyProxy -->|"gRPC/8080<br/>mTLS (service-ca)"| MLMDServer

    %% Backend connections
    APIServer -->|"MySQL/3306<br/>TLS (service-ca)<br/>Password"| MariaDB
    APIServer -->|"HTTP/9000<br/>Access key + Secret"| MinIO
    MLMDServer -->|"MySQL/3306<br/>TLS (service-ca)<br/>Password"| MariaDB

    %% Alternative external backends
    APIServer -.->|"MySQL/3306<br/>TLS (configurable)<br/>Password"| ExtDB
    APIServer -.->|"HTTPS/443<br/>TLS<br/>Access key"| ExtS3

    %% Operator flows
    DSPOCtrl -->|"HTTPS/6443<br/>mTLS<br/>SA token"| K8sAPI
    DSPOCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>Docker keychain"| OCIReg
    DSPOCtrl -->|"K8s API<br/>mTLS"| OSConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authz fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef appLayer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef infra fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef extsvc fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class DSPRoute,MLMDRoute,MinIORoute ingress
    class RBACProxy authz
    class APIServer,PersistAgent,SchedWF,ArgoCtrl,EnvoyProxy,MLMDServer,TaskPods appLayer
    class DSPOCtrl operator
    class MariaDB,MinIO infra
    class ExtDB,ExtS3,OCIReg,K8sAPI,OSConfig extsvc
