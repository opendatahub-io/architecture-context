graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        RouteAPI["ds-pipeline-{name} Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        RouteMD["ds-pipeline-md-{name} Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        RouteMinio["minio-{name} Route<br/>443/TCP → 9000/TCP<br/>TLS Edge (optional)"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER (kube-rbac-proxy)"]
        KRBP_API["kube-rbac-proxy<br/>(API Server sidecar)<br/>8443/TCP HTTPS<br/>SubjectAccessReview<br/>Cert: ds-pipelines-proxy-tls"]
        KRBP_MLMD["kube-rbac-proxy<br/>(MLMD Envoy sidecar)<br/>8443/TCP HTTPS<br/>SubjectAccessReview<br/>Cert: ds-pipelines-envoy-proxy-tls"]
    end

    subgraph AppLayer["APPLICATION LAYER — Namespace: {dspa-namespace}"]
        direction TB

        subgraph APIBlock["API Services"]
            APIServer["DS Pipelines API Server<br/>SA: ds-pipeline-{name}<br/>:8888 REST, :8887 gRPC<br/>Conditional podToPodTLS"]
        end

        subgraph ExecutionBlock["Execution"]
            ArgoWF["Argo Workflow Controller<br/>SA: ds-pipeline-workflow-controller-{name}<br/>:6060 health, :9090 metrics"]
            Pods["Pipeline Step Pods<br/>SA: pipeline-runner-{name}<br/>⚠ Broad namespace RBAC"]
        end

        subgraph MetadataBlock["Metadata"]
            MLMDgRPC["MLMD gRPC Server<br/>:8080/TCP gRPC<br/>Conditional TLS<br/>NetworkPolicy: restricted"]
            MLMDEnvoy["MLMD Envoy Proxy<br/>:9090/TCP gRPC-web<br/>→ :8080 upstream"]
        end

        subgraph AgentBlock["Agents"]
            PA["Persistence Agent<br/>SA: ds-pipeline-persistenceagent-{name}"]
            SWF["Scheduled Workflow Controller<br/>SA: ds-pipeline-scheduledworkflow-{name}"]
        end

        subgraph DataBlock["Data Storage"]
            MariaDB["MariaDB<br/>:3306/TCP MySQL<br/>Conditional TLS<br/>NetworkPolicy: restricted<br/>Auth: Password"]
            MinIO["MinIO<br/>:9000/TCP HTTP<br/>⚠ No TLS<br/>⚠ No NetworkPolicy<br/>Auth: AccessKey/SecretKey"]
        end
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        DSPOCtrl["DSPO Controller Manager<br/>:8080 metrics, :8081 health<br/>Cluster TLS profile"]
        PVWebhook["PipelineVersion Webhook<br/>:8443/TCP HTTPS (service-CA)<br/>Cluster-wide scope<br/>Fail-closed"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        ExtDB["External MariaDB<br/>:3306/TCP MySQL<br/>Conditional TLS<br/>Password"]
        ExtS3["S3-Compatible Storage<br/>:443/TCP HTTPS<br/>TLS<br/>AccessKey/IAM"]
        OCI["OCI Container Registries<br/>:443/TCP HTTPS<br/>TLS<br/>Registry credentials"]
        K8sAPI["Kubernetes API Server<br/>:443/TCP HTTPS<br/>TLS<br/>ServiceAccount token"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS Reencrypt<br/>SubjectAccessReview"| RouteAPI
    User -->|"HTTPS/443<br/>TLS Reencrypt<br/>SubjectAccessReview"| RouteMD

    %% Ingress → Auth
    RouteAPI -->|"HTTPS/8443<br/>service-CA TLS"| KRBP_API
    RouteMD -->|"HTTPS/8443<br/>service-CA TLS"| KRBP_MLMD

    %% Auth → Application
    KRBP_API -->|"HTTP/8888<br/>Conditional podToPodTLS<br/>Pre-authenticated"| APIServer
    KRBP_MLMD -->|"HTTP/9090<br/>Pre-authenticated"| MLMDEnvoy

    %% Internal flows
    APIServer -->|"MySQL/3306<br/>Conditional TLS<br/>Password"| MariaDB
    APIServer -->|"K8s API<br/>TLS, SA token"| ArgoWF
    ArgoWF -->|"Pod lifecycle<br/>SA token"| Pods
    Pods -->|"HTTP/9000<br/>⚠ No TLS<br/>AccessKey"| MinIO
    Pods -->|"gRPC/8080<br/>Conditional TLS<br/>NetworkPolicy"| MLMDgRPC
    MLMDEnvoy -->|"gRPC/8080<br/>Conditional TLS"| MLMDgRPC
    MLMDgRPC -->|"MySQL/3306<br/>Conditional TLS<br/>Password"| MariaDB
    PA -->|"HTTP+gRPC/8888+8887<br/>Conditional TLS<br/>SA token"| APIServer
    PA -->|"gRPC/8080<br/>Conditional TLS"| MLMDgRPC

    %% Operator flows
    DSPOCtrl -->|"K8s API<br/>TLS<br/>Deploys stack"| AppLayer
    DSPOCtrl -->|"HTTPS/443<br/>TLS<br/>Registry creds"| OCI

    %% External service flows
    Pods -->|"HTTPS/443<br/>TLS<br/>AccessKey/IAM"| ExtS3
    APIServer -->|"MySQL/3306<br/>Conditional TLS"| ExtDB
    DSPOCtrl -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray:5 5

    class User external
    class RouteAPI,RouteMD,RouteMinio ingress
    class KRBP_API,KRBP_MLMD auth
    class APIServer,ArgoWF,Pods,MLMDgRPC,MLMDEnvoy,PA,SWF app
    class MariaDB data
    class MinIO warning
    class DSPOCtrl,PVWebhook operator
    class ExtDB,ExtS3,OCI,K8sAPI extsvc
