graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        OCIRegistry["OCI Registries<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry Credentials"]
    end

    subgraph ClusterNetwork["CLUSTER NETWORK (Kubernetes)"]
        direction TB

        subgraph OperatorNS["Namespace: redhat-ods-applications"]
            DSPO["DSPO Controller<br/>SA: controller-manager"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>TLS (service-ca)<br/>RBAC Auth"]
            HealthSvc["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            WebhookSvc["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster profile)<br/>K8s API Server client cert"]
        end

        subgraph TenantNS["Namespace: {user-namespace} (per DSPA)"]
            APIServer["API Server<br/>8888/TCP REST<br/>8887/TCP gRPC"]
            PersistenceAgent["Persistence Agent"]
            ScheduledWorkflow["Scheduled Workflow"]
            WorkflowCtrl["Argo Workflow Controller"]
            MLMDServer["MLMD gRPC + Envoy"]
            MariaDB["MariaDB<br/>3306/TCP<br/>TLS configurable<br/>Username/Password"]
            MinIO["MinIO<br/>9000/TCP<br/>Static Credentials"]
            NetworkPolicy["NetworkPolicy<br/>(MariaDB access)"]
        end

        subgraph MonitoringNS["Namespace: openshift-monitoring"]
            Prometheus["Prometheus<br/>SA: prometheus-k8s"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        OSAPIServer["OpenShift APIServer CR"]
    end

    subgraph ExternalStorage["EXTERNAL STORAGE"]
        ExtDB["External Database<br/>3306/TCP<br/>TLS configurable<br/>Username/Password"]
        ExtObjStore["External Object Store<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Static Creds / IAM"]
    end

    %% Operator to K8s API
    DSPO -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    DSPO -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>(read TLS profile)"| OSAPIServer

    %% Operator to tenant resources
    DSPO -->|"TCP/3306<br/>TLS configurable<br/>Username/Password"| MariaDB
    DSPO -->|"HTTPS/443 or HTTP/9000<br/>TLS configurable<br/>Static Creds / IAM"| MinIO

    %% External storage
    DSPO -->|"TCP/3306<br/>TLS configurable<br/>Username/Password"| ExtDB
    DSPO -->|"HTTPS/443<br/>TLS 1.2+<br/>Static Creds / IAM"| ExtObjStore

    %% OCI registry
    DSPO -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry Creds"| OCIRegistry

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>RBAC"| MetricsSvc

    %% K8s API to webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>Client Cert"| WebhookSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef infra fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef extstorage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class OCIRegistry external
    class DSPO,MetricsSvc,HealthSvc,WebhookSvc operator
    class APIServer,PersistenceAgent,ScheduledWorkflow,WorkflowCtrl,MLMDServer,MariaDB,MinIO,NetworkPolicy tenant
    class Prometheus monitoring
    class K8sAPI,OSAPIServer infra
    class ExtDB,ExtObjStore extstorage
