graph TB
    subgraph "odh-deployer Init Container"
        DeploySH["deploy.sh<br/>Main Orchestrator"]
        Dockerfile["UBI8-minimal Image<br/>oc CLI + openssl"]
        DeploySH -->|"packaged in"| Dockerfile
    end

    subgraph "KfDef Manifests (Created by deploy.sh)"
        KfDefDashboard["KfDef: rhods-dashboard"]
        KfDefNBC["KfDef: rhods-nbc"]
        KfDefModelMesh["KfDef: rhods-model-mesh"]
        KfDefDSPO["KfDef: rhods-dspo"]
        KfDefNotebooks["KfDef: rhods-notebooks"]
        KfDefMonitoring["KfDef: rhods-monitoring"]
        KfDefAnaconda["KfDef: rhods-anaconda"]
    end

    subgraph "Monitoring Stack (Created by deploy.sh)"
        Prometheus["Prometheus<br/>9091/TCP"]
        Alertmanager["Alertmanager<br/>443/TCP"]
        BlackboxExporter["Blackbox Exporter<br/>9114/TCP"]
        OAuthProxy["oauth-proxy sidecars"]
        Prometheus --- OAuthProxy
        Alertmanager --- OAuthProxy
        BlackboxExporter --- OAuthProxy
    end

    subgraph "Dashboard CRDs & ISVs"
        OdhAppCRD["CRD: OdhApplication"]
        OdhDocCRD["CRD: OdhDocument"]
        OdhQSCRD["CRD: OdhQuickStart"]
        OdhDashCRD["CRD: OdhDashboardConfig"]
        ISVTiles["ISV Application Tiles<br/>(AIKit, Anaconda, Jupyter,<br/>OpenVINO, Pachyderm, Watson)"]
    end

    subgraph "Network Policies"
        NPOperator["NetworkPolicy:<br/>operator namespace"]
        NPApps["NetworkPolicy:<br/>applications namespace"]
        NPMonitoring["NetworkPolicy:<br/>monitoring namespace"]
    end

    %% deploy.sh creates everything
    DeploySH -->|"creates namespaces<br/>(ods-apps, ods-monitoring, notebooks)"| Namespaces["OpenShift Namespaces"]
    DeploySH -->|"applies CRDs"| OdhAppCRD
    DeploySH -->|"applies CRDs"| OdhDocCRD
    DeploySH -->|"applies CRDs"| OdhQSCRD
    DeploySH -->|"applies CRDs"| OdhDashCRD
    DeploySH -->|"creates"| KfDefDashboard
    DeploySH -->|"creates"| KfDefNBC
    DeploySH -->|"creates"| KfDefModelMesh
    DeploySH -->|"creates"| KfDefDSPO
    DeploySH -->|"creates"| KfDefNotebooks
    DeploySH -->|"creates"| KfDefMonitoring
    DeploySH -->|"creates"| KfDefAnaconda
    DeploySH -->|"deploys"| Prometheus
    DeploySH -->|"deploys"| Alertmanager
    DeploySH -->|"deploys"| BlackboxExporter
    DeploySH -->|"applies"| ISVTiles
    DeploySH -->|"applies"| NPOperator
    DeploySH -->|"applies"| NPApps
    DeploySH -->|"applies"| NPMonitoring

    %% External dependency
    RHODSOperator["rhods-operator"] -->|"watches"| KfDefDashboard
    RHODSOperator -->|"watches"| KfDefNBC
    RHODSOperator -->|"watches"| KfDefModelMesh
    RHODSOperator -->|"watches"| KfDefDSPO
    DeploySH -->|"oc CLI calls<br/>6443/TCP HTTPS"| K8sAPI["OpenShift API Server"]

