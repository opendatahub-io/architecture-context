graph TB
    subgraph DeployerComponent["odh-deployer (Init Container)"]
        DeploySH["deploy.sh<br/>Main Orchestrator"]
        Dockerfile["Container Image<br/>(UBI8-minimal + oc CLI)"]
        ManifestsTar["odh-manifests.tar.gz<br/>(Bundled Kustomize Manifests)"]
    end

    subgraph KfDefCRs["KfDef Custom Resources"]
        KfDashboard["rhods-dashboard<br/>KfDef"]
        KfNBC["rhods-nbc<br/>KfDef"]
        KfModelMesh["rhods-model-mesh<br/>KfDef"]
        KfDSPO["rhods-dspo<br/>KfDef"]
        KfNotebooks["rhods-notebooks<br/>KfDef"]
        KfMonitoring["rhods-monitoring<br/>KfDef"]
        KfAnaconda["rhods-anaconda<br/>KfDef"]
    end

    subgraph MonitoringStack["Monitoring Stack"]
        Prometheus["Prometheus<br/>9091/TCP"]
        Alertmanager["Alertmanager<br/>10443/TCP"]
        BlackboxExporter["Blackbox Exporter<br/>9114/TCP"]
        OAuthProxy["OAuth Proxy<br/>(sidecars)"]
    end

    subgraph DashboardCRDs["Dashboard CRDs & ISVs"]
        OdhApp["OdhApplication CRD"]
        OdhDoc["OdhDocument CRD"]
        OdhQS["OdhQuickStart CRD"]
        OdhDashConfig["OdhDashboardConfig CR"]
        ISVTiles["ISV Application Tiles<br/>(AIKit, Anaconda, Jupyter,<br/>OpenVINO, Pachyderm, Watson)"]
    end

    subgraph NetworkPolicies["Network Policies"]
        NPOperator["Operator NS Policy"]
        NPApps["Applications NS Policy"]
        NPMonitoring["Monitoring NS Policy"]
    end

    %% Deployment flows
    DeploySH -->|creates| KfDashboard
    DeploySH -->|creates| KfNBC
    DeploySH -->|creates| KfModelMesh
    DeploySH -->|creates| KfDSPO
    DeploySH -->|creates| KfNotebooks
    DeploySH -->|creates| KfMonitoring
    DeploySH -->|creates| KfAnaconda
    DeploySH -->|deploys| Prometheus
    DeploySH -->|deploys| Alertmanager
    DeploySH -->|deploys| BlackboxExporter
    DeploySH -->|applies| OdhApp
    DeploySH -->|applies| OdhDoc
    DeploySH -->|applies| OdhQS
    DeploySH -->|creates| OdhDashConfig
    DeploySH -->|applies| ISVTiles
    DeploySH -->|applies| NPOperator
    DeploySH -->|applies| NPApps
    DeploySH -->|applies| NPMonitoring

    %% External dependencies
    Operator["rhods-operator"] -->|watches| KfDashboard
    Operator -->|watches| KfNBC
    Operator -->|watches| KfModelMesh
    Operator -->|watches| KfDSPO

    DeploySH -->|uses| OCAPI["OpenShift API<br/>6443/TCP"]
    DeploySH -->|reads| ManifestsTar

    %% Monitoring dependencies
    Prometheus -->|scrapes| ComponentMetrics["Component Metrics<br/>(8080/TCP HTTP)"]
    Prometheus -->|federates| ClusterProm["Cluster Prometheus<br/>9091/TCP HTTPS"]
    Alertmanager -->|alerts| PagerDuty["PagerDuty<br/>443/TCP HTTPS"]
    Alertmanager -->|heartbeat| DMS["Dead Man's Snitch<br/>443/TCP HTTPS"]
    Alertmanager -->|emails| SMTP["SMTP Server"]

    %% Styling
    style DeploySH fill:#4a90e2,stroke:#333,stroke-width:3px
    style Operator fill:#7ed321,stroke:#333
    style Prometheus fill:#e6522c,stroke:#333
    style Alertmanager fill:#e6522c,stroke:#333
    style BlackboxExporter fill:#e6522c,stroke:#333
    style OdhApp fill:#f5a623,stroke:#333
    style OdhDoc fill:#f5a623,stroke:#333
    style OdhQS fill:#f5a623,stroke:#333
    style OdhDashConfig fill:#f5a623,stroke:#333
    style PagerDuty fill:#999,stroke:#333
    style DMS fill:#999,stroke:#333
    style SMTP fill:#999,stroke:#333
    style OCAPI fill:#999,stroke:#333
    style ClusterProm fill:#999,stroke:#333
