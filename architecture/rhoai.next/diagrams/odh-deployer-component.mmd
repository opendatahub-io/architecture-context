graph TB
    subgraph "odh-deployer Container"
        DeployScript["deploy.sh<br/>Main Deployment Orchestrator"]
        KfDefs["KfDef Manifests<br/>(kfdefs/)"]
        MonitoringManifests["Monitoring Manifests<br/>(monitoring/)"]
        NetworkPolicies["Network Policies<br/>(network/)"]
        DashboardISVs["Dashboard ISV Tiles<br/>(odh-dashboard/)"]
        DashboardCRDs["Dashboard CRDs<br/>(odh-dashboard/crds/)"]
        ConsoleLink["ConsoleLink CR<br/>(consolelink/)"]

        DeployScript -->|applies| KfDefs
        DeployScript -->|configures| MonitoringManifests
        DeployScript -->|applies| NetworkPolicies
        DeployScript -->|deploys| DashboardISVs
        DeployScript -->|creates| DashboardCRDs
        DeployScript -->|creates| ConsoleLink
    end

    subgraph "KfDef Resources Created"
        KfDefDashboard["KfDef: rhods-dashboard"]
        KfDefNBC["KfDef: rhods-nbc"]
        KfDefModelMesh["KfDef: rhods-model-mesh"]
        KfDefDSPO["KfDef: rhods-dspo"]
        KfDefMonitoring["KfDef: rhods-monitoring"]
        KfDefNotebooks["KfDef: rhods-notebooks"]
        KfDefAnaconda["KfDef: rhods-anaconda"]
    end

    subgraph "Monitoring Stack Deployed"
        Prometheus["Prometheus<br/>9091/TCP HTTPS"]
        Alertmanager["Alertmanager<br/>443/TCP HTTPS"]
        BlackboxExporter["Blackbox Exporter<br/>9114/TCP HTTPS"]
        OAuthProxy["OAuth Proxy Sidecars"]

        Prometheus --> Alertmanager
        Prometheus --> BlackboxExporter
        OAuthProxy -.->|protects| Prometheus
        OAuthProxy -.->|protects| Alertmanager
        OAuthProxy -.->|protects| BlackboxExporter
    end

    subgraph "CRDs Defined"
        OdhApp["OdhApplication<br/>dashboard.opendatahub.io/v1"]
        OdhDoc["OdhDocument<br/>dashboard.opendatahub.io/v1"]
        OdhConfig["OdhDashboardConfig<br/>opendatahub.io/v1alpha"]
        OdhQS["OdhQuickStart<br/>console.openshift.io/v1"]
    end

    KfDefs -->|creates| KfDefDashboard
    KfDefs -->|creates| KfDefNBC
    KfDefs -->|creates| KfDefModelMesh
    KfDefs -->|creates| KfDefDSPO
    KfDefs -->|creates| KfDefMonitoring
    KfDefs -->|creates| KfDefNotebooks
    KfDefs -->|creates| KfDefAnaconda

    MonitoringManifests -->|deploys| Prometheus
    MonitoringManifests -->|deploys| Alertmanager
    MonitoringManifests -->|deploys| BlackboxExporter

    DashboardCRDs -->|defines| OdhApp
    DashboardCRDs -->|defines| OdhDoc
    DashboardCRDs -->|defines| OdhConfig
    DashboardCRDs -->|defines| OdhQS

    ODHOperator["opendatahub Operator"] -->|watches| KfDefDashboard
    ODHOperator -->|watches| KfDefNBC
    ODHOperator -->|watches| KfDefModelMesh
    ODHOperator -->|watches| KfDefDSPO

    OpenShiftAPI["OpenShift API<br/>6443/TCP HTTPS"] ---|oc CLI| DeployScript
    AddonCatalog["addon-managed-odh-catalog<br/>CatalogSource"] -.->|mode detection| DeployScript

