graph TB
    subgraph MaaS["Models as a Service (MaaS)"]
        direction TB

        subgraph ControllerNS["Controller Namespace (opendatahub)"]
            Controller["maas-controller<br/>Go Operator (controller-runtime)<br/>:8081/TCP health, :8443/TCP metrics"]
            Webhook["Validating Webhook<br/>AITenant, MaaSAuthPolicy,<br/>MaaSModelRef, MaaSSubscription"]
            Controller -->|validates via| Webhook
        end

        subgraph InfraNS["Infrastructure Namespace (per-tenant)"]
            MaaSAPI["maas-api (per-tenant)<br/>Go HTTP Service (Gin)<br/>:8080/TCP HTTP, :8443/TCP HTTPS,<br/>:9090/TCP metrics"]
            Cleanup["API Key Cleanup CronJob<br/>Periodic expired key removal"]
        end

        subgraph DiscoveryNS["Discovery Deployment"]
            Discovery["maas-discovery<br/>Go HTTP Service (2 replicas)<br/>:8443/TCP HTTPS"]
        end
    end

    %% CRDs
    AITenant["AITenant CR"]
    MaaSModelRef["MaaSModelRef CR"]
    MaaSSubscription["MaaSSubscription CR"]
    MaaSAuthPolicy["MaaSAuthPolicy CR"]
    ExternalModel["ExternalModel CR"]
    MaaSTenantConfig["MaasTenantConfig CR"]
    Config["Config CR (Cluster)"]
    Tenant["Tenant CR"]

    %% Controller watches/manages CRDs
    AITenant -->|watched by| Controller
    MaaSModelRef -->|watched by| Controller
    MaaSSubscription -->|watched by| Controller
    MaaSAuthPolicy -->|watched by| Controller
    ExternalModel -->|watched by| Controller
    Config -->|watched by| Controller

    %% Controller creates per-tenant resources
    Controller -->|deploys per-tenant| MaaSAPI
    Controller -->|creates| MaaSTenantConfig
    Controller -->|creates| Tenant

    %% External dependencies
    Controller -->|creates HTTPRoutes| GatewayAPI["Gateway API<br/>(maas-default-gateway)"]
    Controller -->|creates AuthPolicies| Kuadrant["Kuadrant/Authorino"]
    Controller -->|creates DestinationRules,<br/>EnvoyFilters, ServiceEntries| Istio["Istio"]
    Controller -->|watches LLMInferenceService| KServe["KServe"]
    Controller -->|creates NetworkPolicies| K8sAPI["Kubernetes API"]

    %% maas-api dependencies
    MaaSAPI -->|API key storage| PostgreSQL["PostgreSQL<br/>:5432/TCP"]
    MaaSAPI -->|trace export| OTLP["OpenTelemetry Collector"]

    %% Discovery routing
    Discovery -->|routed via| DSGateway["data-science-gateway"]

    %% Client access
    Client["External Client"] -->|HTTPS :443| GatewayAPI
    GatewayAPI -->|authenticated request| MaaSAPI

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style MaaSAPI fill:#4a90e2,color:#fff
    style Discovery fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style Cleanup fill:#4a90e2,color:#fff

    style AITenant fill:#f5a623,color:#fff
    style MaaSModelRef fill:#f5a623,color:#fff
    style MaaSSubscription fill:#f5a623,color:#fff
    style MaaSAuthPolicy fill:#f5a623,color:#fff
    style ExternalModel fill:#f5a623,color:#fff
    style MaaSTenantConfig fill:#f5a623,color:#fff
    style Config fill:#f5a623,color:#fff
    style Tenant fill:#f5a623,color:#fff

    style GatewayAPI fill:#7ed321,color:#fff
    style Kuadrant fill:#7ed321,color:#fff
    style Istio fill:#7ed321,color:#fff
    style KServe fill:#7ed321,color:#fff
    style DSGateway fill:#7ed321,color:#fff

    style PostgreSQL fill:#e8e8e8,stroke:#333
    style OTLP fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#333
