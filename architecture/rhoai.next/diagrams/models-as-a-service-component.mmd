graph TB
    subgraph MaaS["Models as a Service (MaaS) Platform"]
        direction TB

        subgraph Controller["maas-controller (Go Operator)"]
            AITenantR["AITenant<br/>Reconciler"]
            TenantR["Tenant<br/>Reconciler"]
            ModelRefR["MaaSModelRef<br/>Reconciler"]
            AuthPolicyR["MaaSAuthPolicy<br/>Reconciler"]
            SubscriptionR["MaaSSubscription<br/>Reconciler"]
            ExternalModelR["ExternalModel<br/>Reconciler"]
            LifecycleR["Lifecycle<br/>Reconciler"]
            WebhookSrv["Webhook Server<br/>9443/TCP"]
        end

        subgraph API["maas-api (Go/Gin Service)"]
            ModelsEndpoint["/v1/models"]
            APIKeysEndpoint["/v1/api-keys"]
            SubsEndpoint["/v1/subscriptions"]
            TenantsEndpoint["/v1/tenants"]
            InternalEndpoints["/internal/v1/*<br/>(validate, cleanup,<br/>subscription select)"]
            MetricsEndpoint["/metrics<br/>9090/TCP"]
        end

        subgraph PayloadProc["payload-processing (ext_proc)"]
            PreProc["payload-pre-processing<br/>(pre-auth)<br/>Model name extraction"]
            PostProc["payload-processing<br/>(post-auth)<br/>API translation,<br/>credential injection"]
        end
    end

    %% CRDs
    AITenantCR["AITenant CR"]
    ConfigCR["Config CR<br/>(cluster singleton)"]
    MaaSModelRefCR["MaaSModelRef CR"]
    MaaSAuthPolicyCR["MaaSAuthPolicy CR"]
    MaaSSubscriptionCR["MaaSSubscription CR"]
    ExternalModelCR["ExternalModel CR"]
    MaasTenantConfigCR["MaasTenantConfig CR"]

    %% CRD relationships
    AITenantCR -->|watched by| AITenantR
    ConfigCR -->|watched by| LifecycleR
    MaaSModelRefCR -->|watched by| ModelRefR
    MaaSAuthPolicyCR -->|watched by| AuthPolicyR
    MaaSSubscriptionCR -->|watched by| SubscriptionR
    ExternalModelCR -->|watched by| ExternalModelR
    MaasTenantConfigCR -->|watched by| TenantR

    %% Controller creates
    AITenantR -->|creates| MaasTenantConfigCR
    TenantR -->|deploys| API
    AuthPolicyR -->|generates| KuadrantAuthPolicy["Kuadrant<br/>AuthPolicy"]
    SubscriptionR -->|generates| KuadrantTRLP["Kuadrant<br/>TokenRateLimitPolicy"]
    ExternalModelR -->|creates| IstioResources["ServiceEntry +<br/>DestinationRule +<br/>HTTPRoute"]

    %% External dependencies
    Controller -->|depends on| KServe["KServe<br/>(LLMInferenceService)"]
    Controller -->|depends on| GatewayAPI["Gateway API<br/>(Gateway, HTTPRoute)"]
    Controller -->|manages| Istio["Istio<br/>(EnvoyFilter, ServiceEntry)"]
    API -->|queries| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    API -->|authenticates via| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Gateway integration
    Client["External Client"] -->|HTTPS/443| Gateway["MaaS Gateway<br/>(Gateway API)"]
    Gateway -->|ext_proc| PreProc
    Gateway -->|ext_proc| PostProc
    Gateway -->|routes to| KServe
    Gateway -->|auth via| Authorino["Kuadrant<br/>Authorino"]
    Authorino -->|callback| InternalEndpoints

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style API fill:#50b5e9,stroke:#333,color:#fff
    style PayloadProc fill:#6baed6,stroke:#333,color:#fff
    style AITenantCR fill:#f5a623,stroke:#333
    style ConfigCR fill:#f5a623,stroke:#333
    style MaaSModelRefCR fill:#f5a623,stroke:#333
    style MaaSAuthPolicyCR fill:#f5a623,stroke:#333
    style MaaSSubscriptionCR fill:#f5a623,stroke:#333
    style ExternalModelCR fill:#f5a623,stroke:#333
    style MaasTenantConfigCR fill:#f5a623,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Authorino fill:#7ed321,stroke:#333
    style KuadrantAuthPolicy fill:#7ed321,stroke:#333
    style KuadrantTRLP fill:#7ed321,stroke:#333
    style Gateway fill:#ffe6cc,stroke:#d79b00
    style Client fill:#f9f9f9,stroke:#999
