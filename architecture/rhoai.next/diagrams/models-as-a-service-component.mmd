graph TB
    subgraph MaaS["Models-as-a-Service Platform"]
        direction TB

        subgraph Controller["maas-controller (Go Operator)"]
            AITenantCtrl["AITenant Controller"]
            ModelRefCtrl["MaaSModelRef Controller"]
            SubscriptionCtrl["MaaSSubscription Controller"]
            AuthPolicyCtrl["MaaSAuthPolicy Controller"]
            SelfDeployCtrl["Self-Deployment Controller"]
            WebhookServer["Webhook Server<br/>443/TCP"]
            ExternalModelReconciler["ExternalModel Reconciler"]
        end

        subgraph API["maas-api (Go HTTP Service, per-tenant)"]
            APIKeyHandler["API Key Handler<br/>/v1/api-keys/*"]
            ModelHandler["Model Discovery<br/>/v1/models"]
            SubHandler["Subscription Handler<br/>/v1/subscriptions"]
            TenantHandler["Tenant Handler<br/>/v1/tenants"]
            InternalValidate["Internal: Key Validate<br/>/internal/v1/api-keys/validate"]
            InternalSubSelect["Internal: Sub Select<br/>/internal/v1/subscriptions/select"]
            MetricsServer["Metrics Server<br/>9090/TCP"]
        end

        subgraph PayloadProc["payload-processing (Go gRPC)"]
            IPPPre["ipp-pre<br/>(pre-auth)<br/>Model name extraction"]
            IPP["ipp<br/>(post-auth)<br/>Body processing"]
        end
    end

    %% CRDs
    AITenantCR["AITenant CR"]
    MaaSModelRefCR["MaaSModelRef CR"]
    MaaSSubscriptionCR["MaaSSubscription CR"]
    MaaSAuthPolicyCR["MaaSAuthPolicy CR"]
    ExternalModelCR["ExternalModel CR"]
    ConfigCR["Config CR<br/>(cluster-scoped)"]

    %% External Systems
    User["Data Scientist / Client"]
    K8sAPI["Kubernetes API Server"]
    Gateway["Gateway API Gateway<br/>(maas-default-gateway)"]
    Authorino["Authorino<br/>(Kuadrant)"]
    PostgreSQL["PostgreSQL"]
    KServe["KServe<br/>LLMInferenceService"]
    Envoy["Envoy Gateway"]

    %% CRD Relationships
    AITenantCR -->|watched by| AITenantCtrl
    MaaSModelRefCR -->|watched by| ModelRefCtrl
    MaaSSubscriptionCR -->|watched by| SubscriptionCtrl
    MaaSAuthPolicyCR -->|watched by| AuthPolicyCtrl
    ExternalModelCR -->|watched by| ExternalModelReconciler

    %% Controller outputs
    AITenantCtrl -->|creates| Gateway
    AITenantCtrl -->|deploys| API
    ModelRefCtrl -->|creates HTTPRoute| Gateway
    AuthPolicyCtrl -->|creates AuthPolicy| Authorino
    SubscriptionCtrl -->|creates TokenRateLimitPolicy| Authorino

    %% Controller dependencies
    AITenantCtrl -->|CRUD via| K8sAPI
    ModelRefCtrl -->|watches| KServe

    %% API dependencies
    APIKeyHandler -->|hash storage| PostgreSQL
    InternalValidate -->|key lookup| PostgreSQL
    ModelHandler -->|probes models via| Gateway

    %% Authorino callbacks
    Authorino -->|validates keys| InternalValidate
    Authorino -->|selects subscription| InternalSubSelect

    %% Traffic flow
    User -->|inference request| Gateway
    Gateway -->|ext_proc pre-auth| IPPPre
    Gateway -->|auth| Authorino
    Gateway -->|ext_proc post-auth| IPP
    Envoy -->|gRPC 9004/TCP| PayloadProc

    %% Webhook
    K8sAPI -->|admission| WebhookServer

    %% Styles
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style API fill:#50a0d0,stroke:#333,color:#fff
    style PayloadProc fill:#6ab0e0,stroke:#333,color:#fff
    style AITenantCR fill:#f5a623,stroke:#333
    style MaaSModelRefCR fill:#f5a623,stroke:#333
    style MaaSSubscriptionCR fill:#f5a623,stroke:#333
    style MaaSAuthPolicyCR fill:#f5a623,stroke:#333
    style ExternalModelCR fill:#f5a623,stroke:#333
    style ConfigCR fill:#f5a623,stroke:#333
    style Gateway fill:#7ed321,stroke:#333
    style Authorino fill:#7ed321,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Envoy fill:#e8e8e8,stroke:#333
