graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User Browser / API Client"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        Gateway["data-science-gateway<br/>443/TCP → internal<br/>TLS 1.2+ (cluster profile)<br/>Terminate / Reencrypt"]
        Envoy["Envoy Proxy (Istio Sidecar)<br/>EnvoyFilter: data-science-authn-filter<br/>Lua: cookie strip + token forward<br/>DestinationRule: TLS SIMPLE"]
        Gateway --> Envoy
    end

    subgraph AuthLayer["AUTHENTICATION (Auth Proxy)"]
        AuthProxy["kube-auth-proxy<br/>8443/TCP HTTPS (service-ca)<br/>9000/TCP metrics<br/>SA: kube-auth-proxy<br/>Modes: OAuth / OIDC / Bypass"]
    end

    subgraph ControlPlane["OPERATOR (Control Plane)"]
        direction TB
        Manager["rhods-operator manager<br/>SA: odh-operator-controller-manager<br/>9443/TCP webhook<br/>8081/TCP healthz/readyz<br/>8443/TCP metrics<br/>FIPS: strictfipsruntime"]
        CloudMgr["rhods-operator cloudmanager<br/>KubernetesEngine CRs<br/>(AWS, Azure, CoreWeave)"]
    end

    subgraph Webhook["WEBHOOK (Admission)"]
        WebhookSvc["webhook-service<br/>9443/TCP HTTPS<br/>TLS 1.2+ (K8s API certs)<br/>Auth: K8s client cert"]
    end

    subgraph Monitoring["MONITORING (Observability)"]
        Prometheus["Prometheus<br/>9090/TCP HTTPS<br/>TLS (service-ca)"]
        Thanos["Thanos Querier<br/>9091/TCP HTTPS<br/>TLS (service-ca)"]
        Tempo["Tempo<br/>(Distributed Tracing)"]
        OTel["OpenTelemetry<br/>Collectors"]
        Perses["Perses<br/>(Dashboards)"]
    end

    subgraph Redirect["REDIRECT (Legacy)"]
        DashRedirect["dashboard-redirect (nginx)<br/>8080/TCP HTTP<br/>301 → new Gateway URL"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        OAuthServer["OpenShift OAuth Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        OIDCProvider["External OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>(optional)"]
        TokenReview["K8s TokenReview API<br/>6443/TCP HTTPS"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Cookie / Bearer / None"| Gateway

    %% Ingress → Auth
    Envoy -->|"HTTPS/8443<br/>ext_authz<br/>TLS (service-ca)"| AuthProxy

    %% Auth → External
    AuthProxy -->|"HTTPS/443<br/>OAuth client creds"| OAuthServer
    AuthProxy -->|"HTTPS/443<br/>OIDC client creds"| OIDCProvider
    AuthProxy -->|"HTTPS/6443<br/>system:auth-delegator"| TokenReview

    %% Operator → K8s
    Manager -->|"HTTPS/6443<br/>SA token<br/>CRD reconciliation"| K8sAPI
    CloudMgr -->|"HTTPS/6443<br/>SA token<br/>Helm charts"| K8sAPI

    %% Operator → OAuth (OAuthClient registration)
    Manager -->|"HTTPS/443<br/>OAuthClient CR"| OAuthServer

    %% Webhook
    K8sAPI -->|"HTTPS/9443<br/>Client cert<br/>Admission webhooks"| WebhookSvc

    %% Legacy redirect
    Client -.->|"HTTPS/443<br/>Legacy URL<br/>Edge TLS"| DashRedirect
    DashRedirect -.->|"301 Redirect"| Client

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef redirect fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#e8e8e8,stroke:#666,stroke-width:2px

    class Client external
    class Gateway,Envoy ingress
    class AuthProxy auth
    class Manager,CloudMgr controlplane
    class WebhookSvc webhook
    class Prometheus,Thanos,Tempo,OTel,Perses monitoring
    class DashRedirect redirect
    class K8sAPI,OAuthServer,OIDCProvider,TokenReview externalservice
