graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["External User / Admin"]
    end

    subgraph IngressLayer["INGRESS LAYER"]
        Router["OpenShift Router<br/>443/TCP<br/>TLS Passthrough / Edge"]

        subgraph GatewayPath["Gateway Ingress Path"]
            Gateway["data-science-gateway<br/>Gateway API<br/>443/TCP HTTPS<br/>TLS 1.2+ (cluster profile)<br/>SIMPLE or MUTUAL"]
            AuthProxy["kube-auth-proxy<br/>HTTPS (configurable)<br/>OIDC/OAuth<br/>NetworkPolicy enforced"]
        end

        subgraph LegacyPath["Legacy Redirect Path"]
            LegacyRoute["OpenShift Route<br/>443/TCP edge TLS"]
            NginxRedirect["nginx redirect<br/>8080/TCP HTTP<br/>301 → Gateway"]
        end
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-operator)"]
        direction TB

        OperatorPod["rhods-operator manager<br/>SA: redhat-ods-operator-controller-manager<br/>FIPS: strictfipsruntime + ubi9-minimal-pqc"]

        WebhookSvc["Webhook Service<br/>443→9443/TCP HTTPS<br/>TLS (service-ca)<br/>Auth: K8s admission"]
        MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>Auth: WithAuthenticationAndAuthorization"]
        HealthEndpoint["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
    end

    subgraph PlatformComponents["PLATFORM COMPONENTS"]
        Dashboard["Dashboard"]
        KServe["KServe"]
        Ray["Ray"]
        Kueue["Kueue"]
        TrustyAI["TrustyAI"]
        ModelReg["Model Registry"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        OIDCProvider["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Client Credentials"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer / OIDC"| Router

    %% Gateway path
    Router -->|"HTTPS/443<br/>TLS passthrough"| Gateway
    Gateway -->|"HTTPS<br/>TLS (DestinationRule)<br/>OIDC token"| AuthProxy
    AuthProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview"| K8sAPI
    AuthProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>Client creds"| OIDCProvider
    AuthProxy -->|"HTTP(S)<br/>Set-Authorization"| Dashboard
    AuthProxy -->|"HTTP(S)<br/>Set-Authorization"| KServe

    %% Legacy path
    Router -->|"HTTPS/443<br/>edge TLS"| LegacyRoute
    LegacyRoute -->|"HTTP/8080"| NginxRedirect

    %% Operator flows
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"HTTPS/9443<br/>TLS (service-ca)<br/>Admission"| WebhookSvc

    %% Operator deploys components
    OperatorPod -.->|deploys| Dashboard
    OperatorPod -.->|deploys| KServe
    OperatorPod -.->|deploys| Ray
    OperatorPod -.->|deploys| Kueue
    OperatorPod -.->|deploys| TrustyAI
    OperatorPod -.->|deploys| ModelReg
    OperatorPod -.->|deploys| AuthProxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef component fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Router,Gateway,AuthProxy,LegacyRoute,NginxRedirect ingress
    class OperatorPod,WebhookSvc,MetricsSvc,HealthEndpoint operator
    class Dashboard,KServe,Ray,Kueue,TrustyAI,ModelReg component
    class K8sAPI,OIDCProvider externalservice
