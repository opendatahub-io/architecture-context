graph LR
    AGO["ai-gateway-operator<br/>(Module Operator)"]

    %% Vendored Sub-Components (deployed by AGO)
    AGO ==>|"deploys via SSA<br/>batchGateway=Managed"| BGO["batch-gateway-operator"]
    AGO ==>|"deploys via SSA<br/>MaaS=Managed"| MaaS["maas-controller"]

    %% Platform Dependencies
    AGO -->|"AIGateway CR creation<br/>platformVersion ConfigMap"| ODH["opendatahub-operator"]
    AGO -->|"reads monitoring namespace"| DSCI["DSCInitialization"]

    %% MaaS Integration Dependencies
    MaaS -->|"HTTPRoute parent<br/>get/list/watch"| GatewayAPI["Gateway API<br/>v1.3.0+"]
    MaaS -->|"AuthPolicy<br/>TokenRateLimitPolicy<br/>RateLimitPolicy"| Kuadrant["Kuadrant"]
    MaaS -->|"DestinationRule<br/>EnvoyFilter<br/>ServiceEntry"| Istio["Istio"]
    MaaS -->|"LLMInferenceService<br/>get/list/watch"| KServe["KServe"]
    MaaS -->|"operator availability<br/>get/list/watch"| Authorino["Authorino"]
    MaaS -->|"OpenTelemetryCollector"| OTel["OpenTelemetry"]
    MaaS -->|"PersesDashboard<br/>PersesDataSource"| Perses["Perses"]
    MaaS -->|"Telemetry CRs"| IstioTelemetry["Istio Telemetry"]

    %% Shared Dependencies
    AGO -->|"webhook TLS certs"| CertMgr["cert-manager"]
    BGO -.->|"webhook TLS (xKS)"| CertMgr

    %% Monitoring
    AGO -->|"ServiceMonitor<br/>PodMonitor"| Prometheus["Prometheus<br/>(monitoring.coreos.com)"]
    MaaS -->|"ServiceMonitor<br/>PodMonitor"| Prometheus

    %% Build/Runtime Dependencies
    AGO -->|"controller framework"| CR["controller-runtime<br/>v0.24.1"]
    AGO -->|"reconciler SDK<br/>deploy actions"| ODHSDK["opendatahub-operator/v2<br/>v2.8.1"]
    AGO -->|"OLM version handling"| OFW["operator-framework/api<br/>v0.42.0"]
    AGO -->|"manifest rendering"| MK["k8s-manifest-kit<br/>v0.2.1"]

    %% Integration consumers
    Dashboard["ODH Dashboard"] -.->|"UI management"| AGO
    Pipelines["Data Science Pipelines"] -.->|"auto deploy"| BGO

    %% Styling
    style AGO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style BGO fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    style MaaS fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    style ODH fill:#9b59b6,stroke:#333,color:#fff
    style DSCI fill:#9b59b6,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Authorino fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Perses fill:#999,stroke:#333,color:#fff
    style IstioTelemetry fill:#999,stroke:#333,color:#fff
    style CertMgr fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#e74c3c,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style ODHSDK fill:#f5a623,stroke:#333
    style OFW fill:#f5a623,stroke:#333
    style MK fill:#f5a623,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style Pipelines fill:#7ed321,stroke:#333,color:#fff
