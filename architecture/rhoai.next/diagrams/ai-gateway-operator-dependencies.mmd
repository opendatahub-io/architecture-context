graph LR
    AIGW["ai-gateway-operator<br/>(Module Operator)"]

    %% Platform Dependencies (Internal RHOAI)
    AIGW -->|"CRD creator<br/>(AIGateway CR)"| ODHOperator["opendatahub-operator"]
    AIGW -->|"reads monitoring NS"| DSCI["DSCInitialization"]
    AIGW -->|"watches<br/>LLMInferenceService"| KServe["KServe"]

    %% Vendored Sub-Components
    AIGW ==>|"deploys via SSA<br/>(batchGateway: Managed)"| BatchGW["batch-gateway-operator<br/>(llm-d)"]
    AIGW ==>|"deploys via SSA<br/>(modelsAsAService: Managed)"| MaaSCtrl["maas-controller"]

    %% External Dependencies (Infrastructure)
    BatchGW -->|"manages HTTPRoutes"| GatewayAPI["Gateway API<br/>v1.3.0"]
    BatchGW -->|"manages Certificates"| CertManager["cert-manager"]
    MaaSCtrl -->|"manages HTTPRoutes"| GatewayAPI
    MaaSCtrl -->|"AuthPolicy,<br/>TokenRateLimitPolicy"| Kuadrant["Kuadrant"]
    MaaSCtrl -->|"DestinationRule,<br/>EnvoyFilter,<br/>ServiceEntry"| Istio["Istio /<br/>Service Mesh"]
    MaaSCtrl -->|"watches Authorinos"| Authorino["Authorino"]
    MaaSCtrl -->|"manages collectors"| OTel["OpenTelemetry"]
    MaaSCtrl -->|"manages dashboards"| Perses["Perses"]

    %% Monitoring
    AIGW -->|"ServiceMonitor,<br/>PodMonitor"| Prometheus["Prometheus<br/>(monitoring.coreos.com)"]
    BatchGW -->|"monitoring resources"| Prometheus
    MaaSCtrl -->|"monitoring resources"| Prometheus

    %% Core Dependencies
    AIGW -->|"CRD watch, SSA,<br/>leader election"| K8sAPI["Kubernetes API"]

    %% Build Dependencies
    AIGW -.->|"controller-runtime v0.24.1"| CR["controller-runtime"]
    AIGW -.->|"ODH reconciler framework"| ODHv2["opendatahub-operator/v2<br/>v2.8.1"]

    %% Integration consumers
    Dashboard["ODH Dashboard"] -.->|"UI management"| AIGW
    Pipelines["Data Science<br/>Pipelines"] -.->|"auto deploy"| AIGW

    %% Styling
    style AIGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style BatchGW fill:#4a90e2,stroke:#333,color:#fff
    style MaaSCtrl fill:#4a90e2,stroke:#333,color:#fff

    style ODHOperator fill:#7ed321,stroke:#333,color:#fff
    style DSCI fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style Pipelines fill:#7ed321,stroke:#333,color:#fff

    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style Authorino fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Perses fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff

    style CR fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style ODHv2 fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
