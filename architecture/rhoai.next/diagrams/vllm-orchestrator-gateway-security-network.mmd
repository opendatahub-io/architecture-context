graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformRouting["PLATFORM ROUTING (TLS Termination)"]
        IngressProxy["Ingress / Route Proxy<br/>(managed by operator)<br/>TLS terminated here"]
    end

    subgraph Internal["INTERNAL CLUSTER (Trusted)"]
        direction TB

        subgraph GatewayPod["Gateway Pod"]
            Gateway["vllm-orchestrator-gateway<br/>8090/TCP HTTP<br/>Stateless reverse proxy<br/>Image: odh-trustyai-vllm-orchestrator-gateway-rhel9"]
            TLSMounts["Mounted Secrets:<br/>- /etc/tls/private/tls.crt<br/>- /etc/tls/private/tls.key<br/>- /etc/tls/ca/service-ca.crt"]
        end

        subgraph OrchestratorZone["Orchestrator Zone"]
            Orchestrator["FMS Guardrails Orchestrator<br/>8085/TCP HTTP or HTTPS<br/>Optional mTLS"]
        end

        subgraph DetectorZone["Detector Services"]
            Detectors["Content Detectors<br/>(PII, Toxicity, Regex)<br/>Accessed via Orchestrator"]
        end

        subgraph InferenceZone["Inference Zone"]
            vLLM["vLLM Inference Server<br/>Accessed via Orchestrator"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        ServiceCA["OpenShift service-ca<br/>CA certificate provisioner"]
        CertManager["Platform TLS Provisioner<br/>(cert-manager inferred)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| IngressProxy
    IngressProxy -->|"HTTP/8090<br/>Plaintext<br/>Forwarded Auth"| Gateway
    Gateway -->|"HTTP or HTTPS/8085<br/>Optional mTLS<br/>Forwarded Auth + X-Forwarded-*"| Orchestrator
    Orchestrator -->|"HTTP/varies<br/>Internal"| Detectors
    Orchestrator -->|"HTTP/varies<br/>Internal"| vLLM

    ServiceCA -.->|"Provisions CA cert"| TLSMounts
    CertManager -.->|"Provisions client cert/key"| TLSMounts

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platformsvc fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class IngressProxy platform
    class Gateway,Orchestrator,Detectors,vLLM internal
    class TLSMounts secrets
    class ServiceCA,CertManager platformsvc
