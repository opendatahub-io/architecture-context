graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>No auth required by gateway"]
    end

    subgraph Application["APPLICATION LAYER"]
        Gateway["vllm-orchestrator-gateway<br/>Rust/axum<br/>0.0.0.0:8090/TCP (HTTP plaintext)<br/>No auth enforcement<br/>No RBAC / No K8s API access"]
    end

    subgraph InternalServices["INTERNAL SERVICES (TrustyAI Ecosystem)"]
        direction TB
        Orchestrator["FMS Guardrails Orchestrator<br/>8085/TCP (configurable)<br/>Endpoint: /api/v2/chat/completions-detection<br/>Receives forwarded Authorization"]

        subgraph OrchestratorBackends["Orchestrator Backends (indirect)"]
            Detectors["Detector Services<br/>(e.g., guardrails-regex-detector)<br/>Called by orchestrator"]
            vLLM["vLLM Inference Server<br/>Called by orchestrator"]
        end

        Orchestrator -->|dispatches| Detectors
        Orchestrator -->|inference| vLLM
    end

    subgraph CertInfra["CERTIFICATE INFRASTRUCTURE (OpenShift)"]
        CertSigner["service-serving-cert-signer<br/>/etc/tls/private/tls.crt + tls.key<br/>kubernetes.io/tls<br/>Auto-rotate: Yes"]
        CAOperator["service-ca-operator<br/>/etc/tls/ca/service-ca.crt<br/>ConfigMap (projected)<br/>Auto-rotate: Yes"]
    end

    %% Network flows
    Client -->|"HTTP/8090<br/>Plaintext<br/>Authorization header (pass-through)"| Gateway
    Gateway -->|"HTTP or HTTPS/8085<br/>Optional mTLS (PKCS12 identity)<br/>Client cert + forwarded Auth header<br/>+ X-Forwarded-* headers"| Orchestrator

    %% Certificate provisioning
    CertSigner -.->|"provisions client cert<br/>(mTLS identity)"| Gateway
    CAOperator -.->|"provisions CA cert<br/>(server validation)"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#4a90e2,stroke:#2a70c2,stroke-width:2px,color:#fff
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef indirect fill:#e8f5e9,stroke:#a5d6a7,stroke-width:1px
    classDef certinfra fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway application
    class Orchestrator internal
    class Detectors,vLLM indirect
    class CertSigner,CAOperator certinfra
