graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / AI Application"]
    end

    subgraph GatewayZone["GATEWAY SERVICE"]
        Gateway["vllm-orchestrator-gateway<br/>Listen: 0.0.0.0:8090/TCP<br/>Protocol: HTTP (plaintext)<br/>Auth: None enforced<br/>Forwards: Authorization + x-forwarded-*<br/>Rust/axum 0.7.9<br/>⚠ Runs as root"]
    end

    subgraph InternalServices["INTERNAL SERVICES"]
        direction TB

        Orchestrator["FMS Guardrails Orchestrator<br/>8085/TCP (configurable)<br/>POST /api/v2/chat/completions-detection<br/>Auth: mTLS + Authorization header"]

        subgraph OrchestratorBackends["Orchestrator Backends"]
            Detectors["Detector Services<br/>(e.g., guardrails-regex-detector)<br/>Ports/protocols vary"]
            vLLM["vLLM Model Server<br/>LLM inference backend<br/>Ports/protocols vary"]
        end
    end

    subgraph CertProvisioning["CERTIFICATE PROVISIONING"]
        ServiceCA["OpenShift service-ca<br/>Provides: /etc/tls/ca/service-ca.crt"]
        CertManager["cert-manager / cluster CA<br/>Provides: /etc/tls/private/tls.{crt,key}"]
    end

    %% Flows
    Client -->|"HTTP/8090<br/>Plaintext<br/>Authorization header<br/>(pass-through, not enforced)"| Gateway

    Gateway -->|"HTTP or HTTPS/8085<br/>Optional mTLS<br/>Client cert: PKCS#12<br/>⚠ danger_accept_invalid_hostnames<br/>for localhost only"| Orchestrator

    Orchestrator -->|"Detector calls<br/>Varies"| Detectors
    Orchestrator -->|"LLM inference<br/>Varies"| vLLM

    ServiceCA -.->|"CA trust cert"| Gateway
    CertManager -.->|"TLS client cert + key"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef certs fill:#fff2cc,stroke:#d6b656,stroke-width:1px

    class Client external
    class Gateway gateway
    class Orchestrator internal
    class Detectors,vLLM backend
    class ServiceCA,CertManager certs
