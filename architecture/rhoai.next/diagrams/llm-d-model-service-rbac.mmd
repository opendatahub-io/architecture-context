graph TD
    subgraph "Service Accounts"
        SA["controller-manager<br/>(modelservice-system)"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["manager-rolebinding<br/>(cluster-wide)"]
        CRB2["manager-epp-rolebinding<br/>(cluster-wide)"]
    end

    subgraph "Role Bindings"
        RB1["leader-election-rolebinding<br/>(namespace-scoped)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["manager-role"]
        CR_EPP["$EPP_CLUSTER_ROLE<br/>(external)"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
    end

    subgraph "Roles"
        R_Leader["leader-election-role<br/>(namespace-scoped)"]
    end

    subgraph "API Resources - llm-d.ai"
        ModelServices["llm-d.ai<br/>modelservices"]
        ModelServicesStatus["llm-d.ai<br/>modelservices/status"]
        ModelServicesFinalizers["llm-d.ai<br/>modelservices/finalizers"]
    end

    subgraph "API Resources - apps"
        Deployments["apps<br/>deployments"]
        DeploymentsScale["apps<br/>deployments/scale"]
    end

    subgraph "API Resources - Gateway API"
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        InferenceModels["inference.networking.x-k8s.io<br/>inferencemodels"]
        InferencePools["inference.networking.x-k8s.io<br/>inferencepools"]
    end

    subgraph "API Resources - Core"
        ConfigMaps["core<br/>configmaps"]
        ServiceAccounts["core<br/>serviceaccounts"]
        Services["core<br/>services"]
    end

    subgraph "API Resources - RBAC"
        RoleBindings["rbac.authorization.k8s.io<br/>rolebindings"]
    end

    subgraph "API Resources - Auth"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SubjectAccessReviews["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Non-Resource URLs"
        Metrics["/metrics"]
    end

    subgraph "Leader Election Resources"
        LE_ConfigMaps["core<br/>configmaps"]
        LE_Leases["coordination.k8s.io<br/>leases"]
        LE_Events["core<br/>events"]
    end

    %% Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| RB1
    CRB1 -->|grants| CR_Manager
    CRB2 -->|grants| CR_EPP
    RB1 -->|grants| R_Leader

    %% manager-role permissions
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| ModelServices
    CR_Manager -->|"get, update, patch"| ModelServicesStatus
    CR_Manager -->|"update"| ModelServicesFinalizers
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| Deployments
    CR_Manager -->|"update, patch"| DeploymentsScale
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| HTTPRoutes
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| InferenceModels
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| InferencePools
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| ConfigMaps
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| ServiceAccounts
    CR_Manager -->|"list, watch,<br/>create, update, patch, delete"| Services
    CR_Manager -->|"get, list, watch,<br/>create, update, patch, delete"| RoleBindings

    %% metrics-auth-role permissions
    CR_MetricsAuth -->|"create"| TokenReviews
    CR_MetricsAuth -->|"create"| SubjectAccessReviews

    %% metrics-reader permissions
    CR_MetricsReader -->|"get"| Metrics

    %% leader-election-role permissions
    R_Leader -->|"get, list, watch,<br/>create, update, patch, delete"| LE_ConfigMaps
    R_Leader -->|"get, list, watch,<br/>create, update, patch, delete"| LE_Leases
    R_Leader -->|"create, patch"| LE_Events

