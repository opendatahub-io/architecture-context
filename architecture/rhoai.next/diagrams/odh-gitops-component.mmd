graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph HelmCharts["Helm Charts"]
            XKSChart["rhai-on-xks-chart<br/>(AWS EKS, Azure AKS, CoreWeave)"]
            OSChart["rhai-on-openshift-chart<br/>(OLM-based OpenShift)"]
        end

        subgraph DepSubCharts["Dependency Sub-Charts (5)"]
            CertMgrSub["cert-manager-operator"]
            GatewayAPISub["gateway-api"]
            SailSub["sail-operator"]
            LWSSub["lws-operator"]
            RHCLSub["rhcl-operator"]
        end

        subgraph KustomizeManifests["Kustomize Manifests"]
            DepManifests["dependencies/<br/>Operator Subscriptions"]
            ConfigManifests["configurations/<br/>Post-install Configs"]
            CompManifests["components/<br/>Kustomize Components"]
        end

        Schemas["Contract Schemas<br/>(JSON Schema ~85K lines)"]
        SyncWorkflow["Helm Sync Workflow<br/>(GitHub Actions)"]
    end

    %% xKS Chart internal structure
    XKSChart -->|deploys| OperatorDeploy["RHAI Operator Deployment"]
    XKSChart -->|installs| CRDs["CRDs<br/>(Platform, Kserve)"]
    XKSChart -->|creates| RBAC["RBAC<br/>(ClusterRoles, Bindings)"]
    XKSChart -->|runs| PostInstallHooks["Post-Install Hooks<br/>(Weight 1→2→3)"]

    PostInstallHooks -->|weight 1| KEandPlatform["KubernetesEngine CR<br/>Platform CR<br/>Component CRs"]
    PostInstallHooks -->|weight 2| InferenceGW["Inference Gateway<br/>TLS Certificates"]
    PostInstallHooks -->|weight 3| MaaSGW["MaaS Gateway<br/>TLS Certificates"]

    %% OpenShift Chart structure
    OSChart -->|creates| OLMSub["OLM Subscriptions"]
    OSChart -->|renders| DSCCR["DataScienceCluster CR"]
    OSChart -->|renders| DSCICR["DSCInitialization CR"]
    OSChart -->|resolves| TriState["Tri-State Dependencies<br/>(auto/true/false)"]

    %% Dependency sub-charts used by xKS
    XKSChart -->|includes| CertMgrSub
    XKSChart -->|includes| GatewayAPISub
    XKSChart -->|includes| SailSub
    XKSChart -->|includes| LWSSub
    XKSChart -->|includes| RHCLSub

    %% Kustomize targets
    CompManifests -->|composes| DepManifests
    DepManifests -->|installs operators| OLMSubK["OLM Subscriptions<br/>(12+ operators)"]
    ConfigManifests -->|configures| OperatorCRs["Operator CRs<br/>(Kuadrant, Kueue, LWS, etc.)"]

    %% Schema validation
    Schemas -->|validates| XKSChart
    Schemas -->|validates| OSChart

    %% Sync workflow
    SyncWorkflow -->|pushes charts to| BuildConfig["RHOAI-Build-Config"]

    %% External targets
    K8sAPI["Kubernetes API<br/>443/TCP"]
    OperatorDeploy -->|watches CRs via| K8sAPI

    %% Styling
    style XKSChart fill:#4a90e2,stroke:#333,color:#fff
    style OSChart fill:#4a90e2,stroke:#333,color:#fff
    style CertMgrSub fill:#7ed321,stroke:#333
    style GatewayAPISub fill:#7ed321,stroke:#333
    style SailSub fill:#7ed321,stroke:#333
    style LWSSub fill:#7ed321,stroke:#333
    style RHCLSub fill:#7ed321,stroke:#333
    style DepManifests fill:#f5a623,stroke:#333
    style ConfigManifests fill:#f5a623,stroke:#333
    style CompManifests fill:#f5a623,stroke:#333
    style Schemas fill:#bd10e0,stroke:#333,color:#fff
    style SyncWorkflow fill:#9013fe,stroke:#333,color:#fff
    style PostInstallHooks fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style BuildConfig fill:#e8e8e8,stroke:#333
    style CRDs fill:#f5a623,stroke:#333
