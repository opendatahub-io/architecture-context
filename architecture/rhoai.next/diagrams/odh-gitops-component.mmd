graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph KustomizeDeps["Kustomize Dependency Manifests"]
            CertMgrComp["cert-manager<br/>Component"]
            KueueComp["Kueue<br/>Component"]
            LWSComp["LWS<br/>Component"]
            RHCLComp["RHCL/Kuadrant<br/>Component"]
            ObsComp["Cluster Observability<br/>Component"]
            OTelComp["OpenTelemetry<br/>Component"]
            TempoComp["Tempo<br/>Component"]
            LokiComp["Loki<br/>Component"]
            KEDAComp["KEDA<br/>Component"]
            AgentSandbox["Agent Sandbox<br/>Component"]
            JobSetComp["JobSet<br/>Component"]
        end

        subgraph KustomizeConfig["Kustomize Configurations"]
            KueueCR["Kueue CR Config"]
            LWSCR["LWS CR Config"]
            RHCLCR["RHCL CR Config"]
            JobSetCR["JobSet CR Config"]
        end

        subgraph HelmOCP["rhai-on-openshift-chart"]
            TriState["Tri-State Dependency<br/>Resolution"]
            Profiles["Profiles<br/>default / rhaii / maas"]
            DSCDSCI["DSC/DSCI CR<br/>Generation"]
            OLMTemplates["OLM Subscription<br/>Templates"]
        end

        subgraph HelmXKS["rhai-on-xks-chart"]
            ProviderReg["Provider Registry<br/>AWS / Azure / CoreWeave"]
            RHAIOp["RHAI Operator<br/>Direct Deployment"]
            GatewayHooks["Gateway Hook Scripts<br/>create-gateway.sh"]
            MaaSHooks["MaaS Hook Scripts<br/>create-maas-gateway.sh"]
            CRDBundle["CRD Bundle"]
        end

        subgraph SubCharts["Dependency Sub-Charts"]
            CertMgrSub["cert-manager"]
            GatewayAPISub["Gateway API"]
            LWSSub["LWS"]
            RHCLSub["RHCL"]
            SAILSub["SAIL/Istio"]
        end

        VerifyScripts["Verification Scripts<br/>verify-dependencies.sh"]
        TektonPipeline["Tekton Pipeline<br/>Cluster Validation"]
    end

    Admin["Cluster Administrator"]
    ArgoCD["ArgoCD / Flux<br/>GitOps Controller"]

    Admin -->|"kustomize build / helm install"| KustomizeDeps
    Admin -->|"kustomize build"| KustomizeConfig
    Admin -->|"helm install"| HelmOCP
    Admin -->|"helm install"| HelmXKS
    ArgoCD -.->|"reconciles"| KustomizeDeps
    ArgoCD -.->|"reconciles"| HelmOCP

    HelmXKS -->|"includes"| SubCharts
    Profiles -->|"controls"| TriState
    TriState -->|"determines"| OLMTemplates
    TriState -->|"determines"| DSCDSCI
    ProviderReg -->|"generates"| CRDBundle
    GatewayHooks -->|"provisions TLS via"| CertMgrSub

    KustomizeDeps -.->|"phase 1: operators"| KustomizeConfig
    VerifyScripts -->|"validates"| KustomizeDeps

    style Admin fill:#f9f9f9,stroke:#333
    style ArgoCD fill:#f9f9f9,stroke:#333
    style HelmOCP fill:#dce8f5,stroke:#4a90e2,stroke-width:2px
    style HelmXKS fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style KustomizeDeps fill:#fff2cc,stroke:#d6b656
    style KustomizeConfig fill:#fff2cc,stroke:#d6b656
    style SubCharts fill:#e8e8e8,stroke:#999
    style VerifyScripts fill:#f5d5ce,stroke:#d79b00
    style TektonPipeline fill:#f5d5ce,stroke:#d79b00
