graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph "Helm Charts"
            OpenShiftChart["rhai-on-openshift-chart<br/>(OpenShift + OLM)"]
            XKSChart["rhai-on-xks-chart<br/>(Vanilla K8s)"]
        end

        subgraph "Kustomize Layer"
            KustomizeDeps["Kustomize Dependencies<br/>(OLM Subscriptions)"]
            KustomizeConfigs["Kustomize Configurations<br/>(Operator CRs)"]
        end

        subgraph "Dependency Subcharts"
            CertManager["cert-manager-operator<br/>v1.18.1"]
            GatewayAPI["gateway-api<br/>v1.4.0"]
            SAILOp["sail-operator<br/>3.3.3"]
            RHCLOp["rhcl-operator<br/>1.3.0"]
            LWSOp["lws-operator<br/>1.0"]
        end

        subgraph "Supporting Assets"
            ContractSchemas["Contract Schemas<br/>(78 JSON schemas)"]
            LifecycleHooks["Lifecycle Hooks<br/>(post-install / pre-delete Jobs)"]
        end

        OpenShiftChart -->|"OLM Subscriptions<br/>or Helm subcharts"| KustomizeDeps
        OpenShiftChart -->|"profiles: default, rhaii"| KustomizeConfigs
        XKSChart -->|"depends on"| CertManager
        XKSChart -->|"depends on"| GatewayAPI
        XKSChart -->|"depends on"| SAILOp
        XKSChart -->|"depends on"| RHCLOp
        XKSChart -->|"depends on"| LWSOp
        XKSChart -->|"runs"| LifecycleHooks
        OpenShiftChart -->|"validates with"| ContractSchemas
        XKSChart -->|"validates with"| ContractSchemas
    end

    Admin[Administrator] -->|"helm install"| OpenShiftChart
    Admin -->|"helm install"| XKSChart
    Admin -->|"kubectl apply -k"| KustomizeDeps

    subgraph "CRDs Created"
        DSC["DataScienceCluster CR"]
        DSCI["DSCInitialization CR"]
        PlatformCR["Platform CR"]
        KServeCR["KServe CR"]
        AIGatewayCR["AIGateway CR"]
        KECR["KubernetesEngine CR<br/>(AWS / Azure / CoreWeave)"]
    end

    OpenShiftChart -->|"creates"| DSC
    OpenShiftChart -->|"creates"| DSCI
    LifecycleHooks -->|"creates"| PlatformCR
    LifecycleHooks -->|"creates"| KServeCR
    LifecycleHooks -->|"creates"| AIGatewayCR
    LifecycleHooks -->|"creates"| KECR

    subgraph "External Dependencies"
        OLM["OLM<br/>(Operator Lifecycle Manager)"]
        K8sAPI["Kubernetes API<br/>443/TCP"]
        CertMgrExt["cert-manager"]
        IstioExt["Istio / SAIL"]
        KuadrantExt["Kuadrant / RHCL"]
    end

    KustomizeDeps -->|"manages via"| OLM
    XKSChart -->|"deploys operator to"| K8sAPI
    LifecycleHooks -->|"waits for CA"| CertMgrExt
    LifecycleHooks -->|"creates Gateway"| IstioExt

    subgraph "Sync Targets"
        RHOAIBuildConfig["RHOAI-Build-Config"]
        RhodsOperator["rhods-operator<br/>(template source)"]
    end

    OpenShiftChart -->|"helm-sync.yml"| RHOAIBuildConfig
    RhodsOperator -->|"update-bundle.sh"| XKSChart

    style OpenShiftChart fill:#4a90e2,stroke:#333,color:#fff
    style XKSChart fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeDeps fill:#7ed321,stroke:#333
    style KustomizeConfigs fill:#7ed321,stroke:#333
    style CertManager fill:#f5a623,stroke:#333
    style GatewayAPI fill:#f5a623,stroke:#333
    style SAILOp fill:#f5a623,stroke:#333
    style RHCLOp fill:#f5a623,stroke:#333
    style LWSOp fill:#f5a623,stroke:#333
    style ContractSchemas fill:#9b59b6,stroke:#333,color:#fff
    style LifecycleHooks fill:#e74c3c,stroke:#333,color:#fff
    style DSC fill:#f5a623,stroke:#333
    style DSCI fill:#f5a623,stroke:#333
    style PlatformCR fill:#f5a623,stroke:#333
    style KServeCR fill:#f5a623,stroke:#333
    style AIGatewayCR fill:#f5a623,stroke:#333
    style KECR fill:#f5a623,stroke:#333
    style OLM fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style CertMgrExt fill:#e8e8e8,stroke:#333
    style IstioExt fill:#e8e8e8,stroke:#333
    style KuadrantExt fill:#e8e8e8,stroke:#333
    style RHOAIBuildConfig fill:#3498db,stroke:#333,color:#fff
    style RhodsOperator fill:#3498db,stroke:#333,color:#fff
