graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        Gateway["Gateway<br/>(Envoy / Istio / kgateway)<br/>80/TCP HTTP or 443/TCP HTTPS<br/>TLS termination (if configured)<br/>Auth: per Gateway controller config"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No mTLS by default)"]
        direction TB

        subgraph RouterNS["Router Namespace"]
            RouterProxy["Router Proxy (Envoy)<br/>8080/TCP HTTP<br/>No encryption<br/>No auth"]
            RouterEPP["Router EPP<br/>9002/TCP gRPC (ext-proc)<br/>No encryption<br/>No auth"]
        end

        subgraph ModelServerNS["Model Server Namespace"]
            DecodeServer["Decode Model Server (vLLM)<br/>8000/TCP HTTP<br/>No encryption<br/>No auth<br/>SA: automountServiceAccountToken=false"]
            PrefillServer["Prefill Model Server (vLLM)<br/>8000/TCP HTTP<br/>No encryption<br/>No auth"]
            RoutingSidecar["Routing Sidecar<br/>P/D traffic steering"]
        end

        subgraph Monitoring["Observability"]
            Prometheus["Prometheus<br/>Scrapes /metrics on 8000/TCP"]
            OTelCollector["OpenTelemetry Collector<br/>4317/TCP gRPC OTLP"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HuggingFace["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer (HF_TOKEN)"]
    end

    %% Flows
    Client -->|"HTTP(S) 80/443<br/>TLS if configured"| Gateway
    Gateway -->|"HTTP/8080<br/>No encryption<br/>Cluster internal"| RouterProxy
    RouterProxy -->|"gRPC/9002<br/>ext-proc<br/>localhost"| RouterEPP
    RouterProxy -->|"HTTP/8000<br/>No encryption<br/>No auth"| DecodeServer
    RouterEPP -.->|"Endpoint selection<br/>LLM-aware routing"| DecodeServer
    RouterEPP -.->|"Endpoint selection"| PrefillServer
    PrefillServer -->|"NIXL RDMA/TCP<br/>KV cache transfer<br/>No encryption"| DecodeServer
    RoutingSidecar -->|"HTTP/8000<br/>Decode routing"| DecodeServer
    DecodeServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HuggingFace
    PrefillServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HuggingFace
    Prometheus -.->|"HTTP/8000<br/>GET /metrics"| DecodeServer
    DecodeServer -.->|"gRPC/4317<br/>OTLP traces"| OTelCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class RouterProxy,RouterEPP,DecodeServer,PrefillServer,RoutingSidecar internal
    class HuggingFace externalservice
    class Prometheus,OTelCollector monitoring
