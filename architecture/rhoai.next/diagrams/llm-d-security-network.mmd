graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Edge - No TLS)"]
        Envoy["Envoy Proxy<br/>8081/TCP HTTP<br/>No Auth<br/>distroless-v1.33.2"]
        EPP["EPP (Endpoint Picker)<br/>9002/TCP gRPC (ext_proc)<br/>9003/TCP gRPC (health)<br/>9090/TCP HTTP (metrics)<br/>No Auth"]
    end

    subgraph Workload["WORKLOAD (Internal - No Service Mesh)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            PrefillPod["vLLM Prefill Pod<br/>SA: model-server (no token mount)<br/>UID: 2000 (non-root)<br/>8000/TCP HTTP<br/>Image: ghcr.io/llm-d/llm-d-cuda"]
            DecodePod["vLLM Decode Pod<br/>SA: model-server (no token mount)<br/>UID: 2000 (non-root)<br/>8000/TCP HTTP<br/>Sidecar: routing-sidecar"]
        end

        subgraph NS_Mooncake["Namespace: {mooncake-ns} (optional)"]
            MooncakeMaster["Mooncake Master Store<br/>50051/TCP gRPC<br/>8080/TCP HTTP (metadata)<br/>9003/TCP HTTP (metrics)"]
            MooncakeClient["Mooncake Client (DaemonSet)<br/>50052/TCP TCP/RDMA"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>Bearer Token (HF_TOKEN)"]
        GHCR["Container Registries<br/>ghcr.io / nvcr.io<br/>443/TCP HTTPS TLS 1.2+"]
    end

    %% Flows with security annotations
    Client -->|"HTTP/8081<br/>No Encryption<br/>No Auth"| Envoy
    Envoy -->|"gRPC/9002<br/>No Encryption<br/>No Auth (ext_proc)"| EPP
    Envoy -->|"HTTP/8000<br/>No Encryption<br/>No Auth (ORIGINAL_DST)"| PrefillPod
    EPP -.->|"Kubernetes API<br/>mTLS (in-cluster)<br/>InferencePool watch"| PrefillPod
    PrefillPod -->|"TCP-RDMA/5600<br/>No Encryption<br/>No Auth (NIXL KV transfer)"| DecodePod
    DecodePod -->|"HTTP/8000<br/>No Encryption<br/>No Auth"| Envoy
    PrefillPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HF
    DecodePod -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN"| HF
    PrefillPod -.->|"TCP-RDMA/50052<br/>No Encryption"| MooncakeClient
    MooncakeClient -.->|"gRPC/50051<br/>No Encryption"| MooncakeMaster

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workload fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workloadWarn fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class Envoy,EPP ingress
    class PrefillPod,DecodePod workloadWarn
    class MooncakeMaster,MooncakeClient workload
    class HF,GHCR externalservice
