graph TB
    subgraph KueueSystem["Kueue Controller Manager"]
        direction TB
        Scheduler["Scheduler<br/>Evaluates Workloads against<br/>ClusterQueue quotas"]
        WebhookServer["Webhook Server<br/>9443/TCP TLS<br/>Mutating + Validating"]

        subgraph Controllers["Reconciliation Controllers"]
            CQCtrl["ClusterQueue<br/>Controller"]
            LQCtrl["LocalQueue<br/>Controller"]
            WLCtrl["Workload<br/>Controller"]
            ACCtrl["AdmissionCheck<br/>Controller"]
            ProvCtrl["Provisioning<br/>Controller"]
            TASCtrl["TAS Controllers<br/>Topology-Aware"]
        end

        subgraph DisabledControllers["Disabled in RHOAI"]
            MKCluster["MultiKueueCluster<br/>Controller"]
            MKWorkload["MultiKueue Workload<br/>Controller"]
            VisServer["Visibility Server"]
        end

        subgraph JobFramework["Job Framework (Pluggable Integrations)"]
            JobInt["batch/v1 Job"]
            PyTorchInt["PyTorchJob"]
            TFInt["TFJob"]
            MPIInt["MPIJob"]
            RayInt["RayJob / RayCluster"]
            JobSetInt["JobSet"]
            AppWrapperInt["AppWrapper"]
            LWSInt["LeaderWorkerSet"]
        end
    end

    %% CRDs
    User["User / kubectl"] -->|creates| LQ["LocalQueue CR"]
    User -->|submits| Job["Workload<br/>(Job, PyTorchJob, etc.)"]
    Job -->|intercepted by| WebhookServer
    WebhookServer -->|suspends & annotates| Job
    WLCtrl -->|creates| WL["Workload CR"]
    WL -->|evaluated by| Scheduler
    Scheduler -->|checks quota| CQ["ClusterQueue CR"]
    CQ -->|borrows from| Cohort["Cohort CR"]
    Scheduler -->|admits| WL
    WLCtrl -->|unsuspends| Job
    LQ -->|references| CQ
    CQ -->|uses| RF["ResourceFlavor CR"]

    %% External
    Scheduler -->|watches| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    ProvCtrl -->|creates| PR["ProvisioningRequest"]
    PR -->|processed by| Autoscaler["Cluster Autoscaler"]

    %% Monitoring
    Prometheus["Prometheus"] -->|scrapes| MetricsSvc["Metrics Service<br/>8443/TCP HTTPS"]

    %% Styling
    style KueueSystem fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Scheduler fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style CQCtrl fill:#5ba3f5,color:#fff
    style LQCtrl fill:#5ba3f5,color:#fff
    style WLCtrl fill:#5ba3f5,color:#fff
    style ACCtrl fill:#5ba3f5,color:#fff
    style ProvCtrl fill:#5ba3f5,color:#fff
    style TASCtrl fill:#5ba3f5,color:#fff
    style MKCluster fill:#ccc,stroke:#999
    style MKWorkload fill:#ccc,stroke:#999
    style VisServer fill:#ccc,stroke:#999
    style CQ fill:#f5a623
    style LQ fill:#f5a623
    style WL fill:#f5a623
    style RF fill:#f5a623
    style Cohort fill:#f5a623
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Autoscaler fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style User fill:#d5e8d4,stroke:#82b366
