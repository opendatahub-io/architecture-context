graph TB
    subgraph KueueSystem["Kueue Controller Manager<br/>(opendatahub namespace)"]
        direction TB
        Controller["Kueue Controller<br/>(controller-runtime)"]
        Scheduler["Scheduler<br/>(in-process)"]
        WebhookServer["Webhook Server<br/>9443/TCP HTTPS"]
        VisibilityServer["Visibility Server<br/>(feature-gated, disabled in RHOAI)"]
        Cache["In-Memory Cache"]

        Controller -->|triggers| Scheduler
        Scheduler -->|reads/writes| Cache
        Controller -->|updates| Cache
    end

    %% CRDs - Resource Definition Layer
    subgraph ResourceDefs["Resource Definition CRDs"]
        ClusterQueueCR["ClusterQueue<br/>(cluster-scoped)"]
        ResourceFlavorCR["ResourceFlavor<br/>(cluster-scoped)"]
        CohortCR["Cohort<br/>(cluster-scoped, alpha)"]
        AdmissionCheckCR["AdmissionCheck<br/>(cluster-scoped)"]
        TopologyCR["Topology<br/>(cluster-scoped, alpha)"]
    end

    %% CRDs - Workload Submission Layer
    subgraph WorkloadSubmission["Workload Submission CRDs"]
        LocalQueueCR["LocalQueue<br/>(namespaced)"]
        WorkloadCR["Workload<br/>(namespaced)"]
        WorkloadPriorityClassCR["WorkloadPriorityClass<br/>(cluster-scoped)"]
    end

    %% User interactions
    User["User / Data Scientist"] -->|creates| Job["batch/Job<br/>PyTorchJob, RayJob, etc."]
    Job -->|references| LocalQueueCR
    LocalQueueCR -->|points to| ClusterQueueCR
    ClusterQueueCR -->|references| ResourceFlavorCR
    ClusterQueueCR -->|member of| CohortCR

    %% Controller watches
    Controller -->|watches & creates| WorkloadCR
    Controller -->|watches| ClusterQueueCR
    Controller -->|watches| LocalQueueCR
    Controller -->|watches| ResourceFlavorCR
    Controller -->|watches| AdmissionCheckCR

    %% Webhook validates
    K8sAPI["Kubernetes API Server"] -->|admission review| WebhookServer
    WebhookServer -->|validates/mutates| Job
    WebhookServer -->|validates/mutates| ClusterQueueCR
    WebhookServer -->|validates/mutates| WorkloadCR

    %% Scheduler admits
    Scheduler -->|evaluates quota| ClusterQueueCR
    Scheduler -->|admits/preempts| WorkloadCR

    %% Controller acts on jobs
    Controller -->|suspends/unsuspends| Job

    %% External integrations
    Controller -->|watches| K8sAPI
    Prometheus["Prometheus"] -->|scrapes :8443| Controller

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Scheduler fill:#4a90e2,stroke:#333,color:#fff
    style WebhookServer fill:#4a90e2,stroke:#333,color:#fff
    style VisibilityServer fill:#4a90e2,stroke:#333,color:#fff,stroke-dasharray: 5 5
    style Cache fill:#4a90e2,stroke:#333,color:#fff

    style ClusterQueueCR fill:#f5a623,stroke:#333
    style ResourceFlavorCR fill:#f5a623,stroke:#333
    style CohortCR fill:#f5a623,stroke:#333
    style AdmissionCheckCR fill:#f5a623,stroke:#333
    style TopologyCR fill:#f5a623,stroke:#333
    style LocalQueueCR fill:#f5a623,stroke:#333
    style WorkloadCR fill:#f5a623,stroke:#333
    style WorkloadPriorityClassCR fill:#f5a623,stroke:#333

    style Job fill:#7ed321,stroke:#333
    style User fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
