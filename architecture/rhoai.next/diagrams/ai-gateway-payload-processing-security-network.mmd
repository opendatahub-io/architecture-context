graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["AI Gateway (Envoy)<br/>443/TCP<br/>TLS 1.2+<br/>Bearer Token (platform auth)<br/>HTTPRoute: /{ns}/{model}/*"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT)"]
        direction TB

        subgraph NS_Gateway["Namespace: {gateway-namespace}"]
            PayloadProc["Payload Processing Service<br/>SA: payload-processing-{release}<br/>Image: odh-ai-gateway-payload-processing-rhel9<br/>FIPS: strictfipsruntime"]

            subgraph Ports["Exposed Ports"]
                ExtProc["9004/TCP gRPC<br/>ext_proc filter"]
                Health["9005/TCP HTTP<br/>/healthz /readyz"]
            end
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>SA Bearer Token<br/>RBAC: {release}-externalmodels-reader"]
    end

    subgraph MeshEgress["MESH EGRESS (Istio TLS Origination)"]
        direction TB

        OpenAI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS<br/>TLS 1.2+ SIMPLE<br/>API Key header"]
        Anthropic["Anthropic API<br/>api.anthropic.com<br/>443/TCP HTTPS<br/>TLS 1.2+ SIMPLE<br/>API Key header"]
        Bedrock["AWS Bedrock<br/>bedrock.*.amazonaws.com<br/>443/TCP HTTPS<br/>TLS 1.2+ SIMPLE<br/>SigV4 signature"]
        VertexAI["Google Vertex AI<br/>*-aiplatform.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+ SIMPLE<br/>OAuth2 Bearer"]
        AzureOAI["Azure OpenAI<br/>*.openai.azure.com<br/>443/TCP HTTPS<br/>TLS 1.2+ SIMPLE<br/>API Key header"]
    end

    subgraph OptionalServices["OPTIONAL EXTERNAL SERVICES"]
        Metering["Metering Service<br/>configurable port<br/>HTTP/HTTPS<br/>No Auth"]
        NemoGuard["NeMo Guardrails<br/>configurable port<br/>HTTP/HTTPS<br/>/v1/guardrail/checks<br/>No Auth"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| Gateway
    Gateway -->|"gRPC/9004<br/>Istio mTLS STRICT<br/>Service Identity"| ExtProc
    PayloadProc -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token"| K8sAPI

    %% Egress via Istio DestinationRule SIMPLE
    Gateway -->|"HTTPS/443<br/>TLS 1.2+ (DR SIMPLE)<br/>API Key (injected)"| OpenAI
    Gateway -->|"HTTPS/443<br/>TLS 1.2+ (DR SIMPLE)<br/>API Key (injected)"| Anthropic
    Gateway -->|"HTTPS/443<br/>TLS 1.2+ (DR SIMPLE)<br/>SigV4 (injected)"| Bedrock
    Gateway -->|"HTTPS/443<br/>TLS 1.2+ (DR SIMPLE)<br/>OAuth2 (injected)"| VertexAI
    Gateway -->|"HTTPS/443<br/>TLS 1.2+ (DR SIMPLE)<br/>API Key (injected)"| AzureOAI

    %% Optional
    PayloadProc -.->|"HTTP/HTTPS<br/>configurable<br/>No Auth"| Metering
    PayloadProc -.->|"HTTP/HTTPS<br/>configurable<br/>No Auth"| NemoGuard

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px,stroke-dasharray: 5 5

    class Client external
    class Gateway ingress
    class PayloadProc,ExtProc,Health,K8sAPI servicemesh
    class OpenAI,Anthropic,Bedrock,VertexAI,AzureOAI egress
    class Metering,NemoGuard optional
