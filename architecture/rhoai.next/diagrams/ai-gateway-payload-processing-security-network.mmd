graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Envoy["Envoy Proxy / AI Gateway<br/>443/TCP<br/>TLS 1.2+<br/>Kuadrant WASM auth"]
    end

    subgraph Application["APPLICATION (Payload Processing)"]
        direction TB

        ExtProc["ext_proc gRPC Server<br/>Port: 9004/TCP gRPC<br/>SA: ipp-name-release<br/>FIPS: strictfipsruntime"]
        Health["Health gRPC Server<br/>Port: 9005/TCP"]

        subgraph PluginChain["Plugin Pipeline"]
            P1["maas-headers-guard"]
            P2["model-extractor"]
            P3["model-provider-resolver"]
            P4["stream-usage-enforcer"]
            P5["api-translation"]
            P6["apikey-injection"]
        end

        ExtProc --- PluginChain
    end

    subgraph InternalServices["INTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        NeMo["NeMo Guardrails<br/>HTTPS TLS 1.2+<br/>Scheme validated"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OpenAI["OpenAI<br/>443/TCP HTTPS"]
        Anthropic["Anthropic<br/>443/TCP HTTPS"]
        Azure["Azure OpenAI<br/>443/TCP HTTPS"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>SigV4"]
        Vertex["Google Vertex<br/>443/TCP HTTPS<br/>OAuth2"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform auth"| Envoy
    Envoy -->|"gRPC/9004<br/>Optional TLS<br/>Network-local"| ExtProc
    ExtProc -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    ExtProc -->|"HTTPS<br/>TLS 1.2+<br/>No auth"| NeMo
    Envoy -->|"HTTPS/443<br/>TLS Istio SIMPLE<br/>API key"| OpenAI
    Envoy -->|"HTTPS/443<br/>TLS Istio SIMPLE<br/>API key"| Anthropic
    Envoy -->|"HTTPS/443<br/>TLS Istio SIMPLE<br/>API key"| Azure
    Envoy -->|"HTTPS/443<br/>TLS Istio SIMPLE<br/>SigV4"| Bedrock
    Envoy -->|"HTTPS/443<br/>TLS Istio SIMPLE<br/>OAuth2"| Vertex

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef plugin fill:#e1d5e7,stroke:#9673a6

    class Client external
    class Envoy ingress
    class ExtProc,Health application
    class P1,P2,P3,P4,P5,P6 plugin
    class K8sAPI,NeMo internal
    class OpenAI,Anthropic,Azure,Bedrock,Vertex externalservice
