graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Cluster Users / SRE"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - Reencrypt TLS)"]
        DashRoute["rhods-dashboard Route<br/>8443/TCP HTTPS<br/>Reencrypt TLS"]
        PromRoute["prometheus Route<br/>9091/TCP HTTPS<br/>Reencrypt TLS"]
        AMRoute["alertmanager Route<br/>443/TCP HTTPS<br/>Reencrypt TLS"]
    end

    subgraph MonitoringNS["NAMESPACE: redhat-ods-monitoring"]
        direction TB

        subgraph PromPod["Prometheus Pod (4 containers)"]
            Prom["prometheus<br/>9090/TCP HTTP"]
            PromProxy["oauth-proxy<br/>9091/TCP HTTPS<br/>TLS: serving cert<br/>Auth: OpenShift SAR"]
            AM["alertmanager<br/>9093/TCP HTTP"]
            AMProxy["alertmanager-proxy<br/>10443/TCP HTTPS<br/>TLS: serving cert<br/>Auth: OpenShift SAR"]
        end

        subgraph BBEPod["Blackbox Exporter Pod"]
            BBE["blackbox-exporter<br/>9115/TCP HTTP"]
            BBEProxy["oauth-proxy<br/>9114/TCP HTTPS<br/>TLS: serving cert<br/>Auth: OpenShift SAR"]
        end
    end

    subgraph AppsNS["NAMESPACE: redhat-ods-applications"]
        NBC["odh-notebook-controller<br/>8080/TCP HTTP"]
        ModelCtrl["odh-model-controller<br/>8080/TCP HTTP"]
        ModelMesh["modelmesh-controller<br/>8080/TCP HTTP"]
        DSPO["data-science-pipelines-operator<br/>8080/TCP HTTP"]
        Dashboard["odh-dashboard<br/>8443/TCP HTTPS"]
    end

    subgraph OperatorNS["NAMESPACE: redhat-ods-operator"]
        OperatorMetrics["rhods-operator-metrics<br/>8383/TCP HTTP"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        ClusterProm["Cluster Prometheus<br/>openshift-monitoring<br/>9091/TCP HTTPS<br/>TLS: service CA"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Managed Only)"]
        PD["PagerDuty API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Service Key"]
        DMS["Dead Man's Snitch<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: URL Secret"]
        SMTP["SMTP Server<br/>STARTTLS<br/>Auth: User/Pass"]
    end

    %% User access flows
    User -->|"HTTPS/443<br/>OpenShift OAuth"| DashRoute
    User -->|"HTTPS/443<br/>OpenShift OAuth"| PromRoute
    User -->|"HTTPS/443<br/>OpenShift OAuth"| AMRoute

    DashRoute -->|"HTTPS/8443<br/>Reencrypt"| Dashboard
    PromRoute -->|"HTTPS/9091<br/>Reencrypt"| PromProxy
    AMRoute -->|"HTTPS/10443<br/>Reencrypt"| AMProxy

    %% Prometheus scraping (unencrypted metrics)
    Prom -->|"HTTP/8080<br/>No Auth"| NBC
    Prom -->|"HTTP/8080<br/>No Auth"| ModelCtrl
    Prom -->|"HTTP/8080<br/>No Auth"| ModelMesh
    Prom -->|"HTTP/8080<br/>No Auth"| DSPO
    Prom -->|"HTTP/8383<br/>No Auth"| OperatorMetrics

    %% Federation
    Prom -->|"HTTPS/9091<br/>TLS (service CA)<br/>Bearer Token (SA)"| ClusterProm

    %% Blackbox probes
    BBE -->|"HTTPS/8443<br/>Bearer Token"| Dashboard
    BBE -->|"HTTP/8080<br/>Bearer Token"| NBC

    %% Alerting egress
    AM -->|"HTTPS/443<br/>TLS 1.2+<br/>Service Key"| PD
    AM -->|"HTTPS/443<br/>TLS 1.2+<br/>URL Secret"| DMS
    AM -->|"SMTP<br/>STARTTLS<br/>User/Pass"| SMTP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef apps fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class DashRoute,PromRoute,AMRoute ingress
    class Prom,PromProxy,AM,AMProxy,BBE,BBEProxy monitoring
    class NBC,ModelCtrl,ModelMesh,DSPO,Dashboard apps
    class OperatorMetrics operator
    class ClusterProm cluster
    class PD,DMS,SMTP externalservice
