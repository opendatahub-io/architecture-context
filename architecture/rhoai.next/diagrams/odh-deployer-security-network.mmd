graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["SRE / Admin User"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - Reencrypt TLS)"]
        DashRoute["rhods-dashboard Route<br/>8443/TCP HTTPS<br/>TLS Reencrypt"]
        PromRoute["prometheus Route<br/>9091/TCP HTTPS<br/>TLS Reencrypt"]
        AMRoute["alertmanager Route<br/>443/TCP HTTPS<br/>TLS Reencrypt"]
    end

    subgraph DeployTime["DEPLOYMENT-TIME (Init Container)"]
        DeploySh["deploy.sh Container<br/>UBI-minimal + oc CLI<br/>SA: deployer"]
    end

    subgraph MonitoringNS["Namespace: redhat-ods-monitoring (Internal Services)"]
        direction TB

        subgraph PromStack["Prometheus Stack"]
            Prom["Prometheus<br/>9091/TCP HTTPS<br/>TLS (service-ca)<br/>OAuth proxy"]
            AM["Alertmanager<br/>443/TCP → 10443<br/>HTTPS TLS (service-ca)<br/>OAuth proxy"]
            BB["Blackbox Exporter<br/>9114/TCP HTTPS<br/>TLS (shared cert)<br/>OAuth proxy<br/>insecure_skip_verify: true"]
        end
    end

    subgraph AppNS["Namespace: redhat-ods-applications (Monitored Components)"]
        NBC["odh-notebook-controller<br/>8080/TCP HTTP Plaintext"]
        ModelCtrl["odh-model-controller<br/>8080/TCP HTTP Plaintext"]
        ModelMesh["modelmesh-controller<br/>8080/TCP HTTP Plaintext"]
        DSPO["dspo-service<br/>8080/TCP HTTP Plaintext"]
        Dashboard["rhods-dashboard<br/>8443/TCP HTTPS"]
    end

    subgraph OperatorNS["Namespace: redhat-ods-operator"]
        RhodsOp["rhods-operator-metrics<br/>8383/TCP HTTP Plaintext"]
    end

    subgraph ClusterMonitoring["Namespace: openshift-monitoring"]
        ClusterProm["prometheus-k8s<br/>9091/TCP HTTPS<br/>TLS (service-ca)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PD["PagerDuty API<br/>443/TCP HTTPS TLS1.2+<br/>Service key auth"]
        DMS["Dead Man's Snitch<br/>443/TCP HTTPS TLS1.2+<br/>Webhook URL auth"]
        SMTP["SMTP Server<br/>STARTTLS<br/>Username/password"]
        OAPI["OpenShift API<br/>6443/TCP HTTPS TLS1.2+<br/>SA token auth"]
    end

    %% External access flows
    User -->|"HTTPS/443<br/>TLS Reencrypt<br/>OAuth SSO"| DashRoute
    User -->|"HTTPS/443<br/>TLS Reencrypt<br/>OAuth SSO"| PromRoute
    User -->|"HTTPS/443<br/>TLS Reencrypt<br/>OAuth SSO"| AMRoute

    DashRoute --> Dashboard
    PromRoute --> Prom
    AMRoute --> AM

    %% Deploy-time flows
    DeploySh -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OAPI

    %% Prometheus scraping - plaintext
    Prom -->|"HTTP/8080<br/>PLAINTEXT<br/>No auth"| NBC
    Prom -->|"HTTP/8080<br/>PLAINTEXT<br/>No auth"| ModelCtrl
    Prom -->|"HTTP/8080<br/>PLAINTEXT<br/>No auth"| ModelMesh
    Prom -->|"HTTP/8080<br/>PLAINTEXT<br/>No auth"| DSPO
    Prom -->|"HTTP/8383<br/>PLAINTEXT<br/>No auth"| RhodsOp

    %% Prometheus federation
    Prom -->|"HTTPS/9091<br/>TLS (service-ca)<br/>Bearer token (SA)"| ClusterProm

    %% Blackbox probing
    Prom -->|"HTTP/9115<br/>Plaintext"| BB
    BB -->|"HTTPS/HTTP<br/>Bearer token (SA)"| Dashboard

    %% Alert routing
    AM -->|"HTTPS/443<br/>TLS 1.2+<br/>Service key"| PD
    AM -->|"HTTPS/443<br/>TLS 1.2+<br/>Webhook URL"| DMS
    AM -->|"SMTP<br/>STARTTLS<br/>User/pass"| SMTP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef deploytime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef appcomponent fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef clustermon fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#f5f5f5,stroke:#666,stroke-width:2px

    class User external
    class DashRoute,PromRoute,AMRoute ingress
    class DeploySh deploytime
    class Prom,AM,BB monitoring
    class NBC,ModelCtrl,ModelMesh,DSPO,Dashboard appcomponent
    class RhodsOp operator
    class ClusterProm clustermon
    class PD,DMS,SMTP,OAPI externalservice
