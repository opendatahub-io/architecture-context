graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["OpenShift Console User"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - Reencrypt TLS)"]
        DashRoute["rhods-dashboard Route<br/>8443/TCP HTTPS<br/>TLS Reencrypt"]
        PromRoute["prometheus Route<br/>9091/TCP HTTPS<br/>TLS Reencrypt"]
        AMRoute["alertmanager Route<br/>443/TCP HTTPS<br/>TLS Reencrypt"]
        ConsoleLink["rhodslink ConsoleLink<br/>Application Launcher"]
    end

    subgraph DeployTime["DEPLOYMENT-TIME (Init Container)"]
        DeploySH["deploy.sh<br/>UBI8-minimal + oc CLI<br/>One-shot execution"]
    end

    subgraph NS_Monitoring["Namespace: redhat-ods-monitoring"]
        direction TB
        subgraph PromPod["Prometheus Pod (4 containers)"]
            Prom["prometheus<br/>9090/TCP HTTP"]
            PromProxy["oauth-proxy<br/>9091/TCP HTTPS<br/>TLS (serving cert)<br/>SAR Auth"]
            AM["alertmanager<br/>9093/TCP HTTP"]
            AMProxy["alertmanager-proxy<br/>10443/TCP HTTPS<br/>TLS (serving cert)<br/>SAR Auth"]
        end
        subgraph BBPod["Blackbox Exporter Pod"]
            BB["blackbox-exporter<br/>9115/TCP HTTP<br/>insecure_skip_verify: true"]
            BBProxy["oauth-proxy<br/>9114/TCP HTTPS<br/>TLS (serving cert)<br/>SAR Auth"]
        end
    end

    subgraph NS_Apps["Namespace: redhat-ods-applications"]
        direction TB
        Dashboard["odh-dashboard<br/>8443/TCP HTTPS"]
        NBC["odh-notebook-controller<br/>8080/TCP HTTP<br/>No Auth"]
        ModelCtrl["odh-model-controller<br/>8080/TCP HTTP<br/>No Auth"]
        MMesh["modelmesh-controller<br/>8080/TCP HTTP<br/>No Auth"]
        DSPO["data-science-pipelines-operator<br/>8080/TCP HTTP<br/>No Auth"]
    end

    subgraph NS_Operator["Namespace: redhat-ods-operator"]
        OperatorMetrics["rhods-operator-metrics<br/>8383/TCP HTTP<br/>No Auth"]
    end

    subgraph ClusterMonitoring["Namespace: openshift-monitoring"]
        ClusterProm["prometheus-k8s<br/>9091/TCP HTTPS<br/>TLS (service CA)<br/>Bearer Token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Managed Mode Only)"]
        PD["PagerDuty API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Service Key"]
        DMS["Dead Man's Snitch<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>URL Secret"]
        SMTP["SMTP Server<br/>STARTTLS<br/>Username/Password"]
    end

    %% External access flows
    User -->|"HTTPS/443<br/>OpenShift OAuth"| DashRoute
    User -->|"HTTPS/443<br/>OpenShift OAuth"| PromRoute
    User -->|"HTTPS/443<br/>OpenShift OAuth"| AMRoute

    %% Route to service
    DashRoute -->|"8443/TCP HTTPS<br/>Reencrypt"| Dashboard
    PromRoute -->|"9091/TCP HTTPS<br/>Reencrypt"| PromProxy
    AMRoute -->|"443→10443/TCP HTTPS<br/>Reencrypt"| AMProxy

    %% Deploy-time flow
    DeploySH -->|"6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token"| K8sAPI["OpenShift API<br/>6443/TCP"]

    %% Monitoring scrape flows (no auth, no encryption)
    Prom -->|"HTTP/8080<br/>No Encryption<br/>No Auth"| NBC
    Prom -->|"HTTP/8080<br/>No Encryption<br/>No Auth"| ModelCtrl
    Prom -->|"HTTP/8080<br/>No Encryption<br/>No Auth"| MMesh
    Prom -->|"HTTP/8080<br/>No Encryption<br/>No Auth"| DSPO
    Prom -->|"HTTP/8383<br/>No Encryption<br/>No Auth"| OperatorMetrics

    %% Federation
    Prom -->|"HTTPS/9091<br/>TLS (service CA)<br/>Bearer Token"| ClusterProm

    %% Health probes
    BB -->|"HTTPS/8443<br/>Bearer Token"| Dashboard
    BB -->|"HTTP/8080<br/>Bearer Token"| NBC

    %% Alert routing (managed mode)
    AM -->|"HTTPS/443<br/>TLS 1.2+<br/>Service Key"| PD
    AM -->|"HTTPS/443<br/>TLS 1.2+<br/>URL Secret"| DMS
    AM -->|"SMTP<br/>STARTTLS<br/>User/Pass"| SMTP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef deploytime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef apps fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef clustermon fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class DashRoute,PromRoute,AMRoute,ConsoleLink ingress
    class DeploySH deploytime
    class Prom,PromProxy,AM,AMProxy,BB,BBProxy monitoring
    class Dashboard,NBC,ModelCtrl,MMesh,DSPO apps
    class OperatorMetrics operator
    class ClusterProm clustermon
    class PD,DMS,SMTP externalservice
    class K8sAPI external
