graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph K8sLayer["KUBERNETES API"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (opendatahub)<br/>NetworkPolicy: Ingress restricted per port"]
        direction TB

        subgraph ControllerPod["trainer-controller-manager Pod<br/>SA: kubeflow-trainer-controller-manager<br/>FIPS: strictfipsruntime | HTTP/2: disabled"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            MetricsSrv["Metrics Server<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>TokenReview + SAR"]
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster profile)<br/>Kubernetes Admission"]
            StatusSrv["Status Server<br/>10443/TCP HTTPS<br/>TLS (cluster profile)<br/>OIDC projected SA token<br/>Feature: TrainJobStatus"]
        end
    end

    subgraph UserNS["USER NAMESPACES (per-tenant)"]
        TrainingPod["Training Pod<br/>SA: projected OIDC token<br/>Audience: trainer.kubeflow.org/{ns}/{name}"]
    end

    subgraph Monitoring["MONITORING (openshift-monitoring)"]
        Prometheus["Prometheus<br/>SA: prometheus-k8s"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% API Server to Controller
    K8sAPI -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>Admission webhook"| WebhookSrv

    %% Controller to API Server
    ControllerPod -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Training pod to Status Server
    TrainingPod -->|"HTTPS/10443<br/>TLS (cluster profile)<br/>OIDC SA token"| StatusSrv

    %% Prometheus to Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS (cluster profile)<br/>Bearer token + SAR"| MetricsSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sapi fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userworkload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI k8sapi
    class HealthProbes,MetricsSrv,WebhookSrv,StatusSrv controller
    class TrainingPod userworkload
    class Prometheus monitoring
