graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist<br/>kubectl / Platform UI"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS (Cluster CA)<br/>AuthN: Bearer / Client Cert<br/>AuthZ: RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: opendatahub"]
        direction TB

        subgraph ControllerPod["trainer-controller-manager"]
            direction TB
            WebhookSvc["Webhook Service<br/>443→9443/TCP HTTPS<br/>TLS: self-signed (cert-controller)<br/>Auth: K8s API server only"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>TLS 1.2+ (cluster profile)<br/>Auth: None (HTTPS only)"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>kubelet only"]
        end

        WebhookCert["Secret: kubeflow-trainer-webhook-cert<br/>kubernetes.io/tls<br/>cert-controller (auto-rotate)"]
    end

    subgraph UserNS["USER NAMESPACES (per training job)"]
        direction TB

        subgraph TrainingJobPods["Training Pods (JobSet managed)"]
            Pod1["Pod rank-0<br/>Metrics: 28080/TCP HTTP"]
            Pod2["Pod rank-1"]
            Pod3["Pod rank-N"]
        end

        NetPol["NetworkPolicy (per TrainJob)<br/>Ingress: same-job pods (all ports)<br/>+ controller→28080/TCP"]
        MPISecret["Secret: {trainjob}-mpi-ssh-auth<br/>kubernetes.io/ssh-auth<br/>(MPI jobs only, no auto-rotate)"]
    end

    subgraph ExternalDeps["EXTERNAL DEPENDENCIES"]
        direction TB
        JobSetCtrl["JobSet Controller<br/>jobset.x-k8s.io<br/>443/TCP HTTPS TLS"]
        CoSched["Coscheduling<br/>scheduling.x-k8s.io<br/>443/TCP HTTPS TLS<br/>(optional)"]
        Volcano["Volcano Scheduler<br/>scheduling.volcano.sh<br/>443/TCP HTTPS TLS<br/>(optional)"]
        Kueue["Kueue / MultiKueue<br/>(optional delegation)"]
    end

    subgraph OpenShift["OPENSHIFT PLATFORM"]
        OCP_API["OpenShift APIServer<br/>config.openshift.io<br/>443/TCP HTTPS TLS"]
        Prometheus["Prometheus / OCP Monitoring<br/>PodMonitor scrape<br/>8443/TCP HTTPS TLS 1.2+"]
    end

    %% External → Control Plane
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Control Plane → Operator (Webhooks)
    K8sAPI -->|"HTTPS/9443<br/>TLS (self-signed)<br/>API Server client cert<br/>failurePolicy: Fail"| WebhookSvc

    %% Operator → Control Plane (CRUD operations)
    ControllerPod -->|"HTTPS/443 TLS<br/>ServiceAccount token<br/>CRUD: TrainJob, JobSet,<br/>PodGroup, NetworkPolicy,<br/>Secret, ConfigMap"| K8sAPI

    %% Operator → OpenShift
    ControllerPod -->|"HTTPS/443 TLS<br/>ServiceAccount token<br/>Read TLS profile"| OCP_API

    %% Operator → Training Pods (RHAI progression)
    ControllerPod -->|"HTTP/28080<br/>plaintext<br/>No auth<br/>NetworkPolicy restricted<br/>Poll /metrics"| Pod1

    %% Prometheus → Operator
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>PodMonitor"| MetricsSvc

    %% Inter-pod communication
    Pod1 <-->|"TCP/29500<br/>plaintext<br/>NCCL/MPI/gRPC<br/>NetworkPolicy restricted"| Pod2
    Pod2 <-->|"TCP/29500<br/>plaintext<br/>NCCL/MPI/gRPC"| Pod3

    %% External deps
    ControllerPod -.->|"Creates JobSet CRs"| JobSetCtrl
    ControllerPod -.->|"Creates PodGroups"| CoSched
    ControllerPod -.->|"Creates PodGroups"| Volcano

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externaldep fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef openshift fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef secret fill:#ffe6cc,stroke:#d79b00,stroke-width:1px,stroke-dasharray:5 5

    class User external
    class K8sAPI controlplane
    class WebhookSvc,MetricsSvc,HealthProbe,ControllerPod operator
    class Pod1,Pod2,Pod3,NetPol userns
    class JobSetCtrl,CoSched,Volcano,Kueue externaldep
    class OCP_API,Prometheus openshift
    class WebhookCert,MPISecret secret
