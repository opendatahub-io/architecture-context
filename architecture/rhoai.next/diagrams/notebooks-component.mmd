graph TB
    subgraph Notebooks["Notebooks Component<br/>(Container Image Build Repository)"]
        direction TB

        subgraph JupyterWorkbenches["Jupyter Workbenches (10 images)"]
            direction LR
            JupMinCPU["Jupyter Minimal<br/>CPU"]
            JupMinCUDA["Jupyter Minimal<br/>CUDA 13.0"]
            JupMinROCm["Jupyter Minimal<br/>ROCm 7.14"]
            JupDS["Jupyter Data Science<br/>CPU"]
            JupPyTorch["Jupyter PyTorch<br/>CUDA 13.0"]
            JupPyTorchLLM["Jupyter PyTorch<br/>+LLMCompressor<br/>CUDA 13.0"]
            JupTF["Jupyter TensorFlow<br/>CUDA 12.9"]
            JupTrustyAI["Jupyter TrustyAI<br/>CPU"]
            JupROCmPT["Jupyter ROCm<br/>PyTorch"]
            JupROCmTF["Jupyter ROCm<br/>TensorFlow"]
        end

        subgraph Runtimes["Pipeline Runtimes (7 images)"]
            direction LR
            RtMin["Runtime Minimal<br/>CPU"]
            RtDS["Runtime Data Science<br/>CPU"]
            RtPyTorch["Runtime PyTorch<br/>CUDA 13.0"]
            RtPyTorchLLM["Runtime PyTorch<br/>+LLMCompressor<br/>CUDA 13.0"]
            RtTF["Runtime TensorFlow<br/>CUDA 12.9"]
            RtROCmPT["Runtime ROCm<br/>PyTorch"]
            RtROCmTF["Runtime ROCm<br/>TensorFlow"]
        end

        subgraph IDE["IDE Workbench (1 image)"]
            CodeServer["Code-Server<br/>CPU<br/>Ports: 8585, 80, 8080"]
        end

        subgraph BuildSystem["Build System"]
            direction LR
            Makefile["Makefile<br/>Per-image targets"]
            VersionsConfig["versions_config.yml<br/>Base image versions"]
            LockFiles["Lock Files<br/>pylock.toml / rpms.lock.yaml"]
        end

        subgraph Manifests["Deployment Manifests"]
            direction LR
            RHOAIManifests["RHOAI ImageStreams<br/>manifests/rhoai/"]
            ODHManifests["ODH ImageStreams<br/>manifests/odh/"]
        end
    end

    %% Base Images
    AIPCCBase["AIPCC Base Images<br/>quay.io/aipcc/base-images/*"]
    AIPCCBase -->|CPU base| JupMinCPU
    AIPCCBase -->|CPU base| JupDS
    AIPCCBase -->|CPU base| JupTrustyAI
    AIPCCBase -->|CPU base| CodeServer
    AIPCCBase -->|CPU base| RtMin
    AIPCCBase -->|CPU base| RtDS
    AIPCCBase -->|CUDA 13.0 base| JupMinCUDA
    AIPCCBase -->|CUDA 13.0 base| JupPyTorch
    AIPCCBase -->|CUDA 13.0 base| JupPyTorchLLM
    AIPCCBase -->|CUDA 13.0 base| RtPyTorch
    AIPCCBase -->|CUDA 13.0 base| RtPyTorchLLM
    AIPCCBase -->|CUDA 12.9 base| JupTF
    AIPCCBase -->|CUDA 12.9 base| RtTF
    AIPCCBase -->|ROCm 7.14 base| JupMinROCm
    AIPCCBase -->|ROCm 7.14 base| JupROCmPT
    AIPCCBase -->|ROCm 7.14 base| JupROCmTF
    AIPCCBase -->|ROCm 7.14 base| RtROCmPT
    AIPCCBase -->|ROCm 7.14 base| RtROCmTF

    %% Consumers
    Operator["ODH/RHOAI Operator"]
    Dashboard["ODH Dashboard"]
    NotebookController["ODH Notebook Controller"]

    RHOAIManifests -->|kustomize apply| Operator
    ODHManifests -->|kustomize apply| Operator
    Operator -->|creates ImageStreams| Dashboard
    Dashboard -->|discovers images| NotebookController
    NotebookController -->|deploys pods from| JupyterWorkbenches
    NotebookController -->|deploys pods from| Runtimes
    NotebookController -->|deploys pods from| IDE

    %% Hermetic Build
    Konflux["Konflux / Tekton CI"]
    Cachi2["Cachi2 / Hermeto<br/>Hermetic Prefetch"]
    RHAI["RHEL AI Python<br/>Package Index"]

    Konflux -->|builds| JupyterWorkbenches
    Konflux -->|builds| Runtimes
    Konflux -->|builds| IDE
    Cachi2 -->|prefetches deps| Konflux
    RHAI -->|Python wheels| Cachi2

