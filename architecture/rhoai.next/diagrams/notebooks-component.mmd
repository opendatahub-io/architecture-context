graph TB
    subgraph BaseImages["Base Images"]
        direction LR
        CPUBase["base-images/cpu<br/>CentOS Stream 9<br/>Python 3.12, PQ Crypto"]
        CUDABase["base-images/cuda<br/>CUDA 12.9 / 13.0<br/>Python 3.12"]
        ROCmBase["base-images/rocm<br/>ROCm 7.14<br/>Python 3.12"]
    end

    subgraph JupyterWorkbenches["Jupyter Workbenches"]
        direction TB
        JMinimal["jupyter/minimal<br/>JupyterLab 4.6<br/>8888/TCP"]
        JDataScience["jupyter/datascience<br/>pandas, scikit-learn,<br/>boto3, kafka"]
        JPyTorch["jupyter/pytorch<br/>PyTorch 2.13<br/>CUDA 13.0"]
        JPyTorchLLM["jupyter/pytorch+llmcompressor<br/>LLMCompressor 0.13<br/>Transformers 5.14"]
        JTensorFlow["jupyter/tensorflow<br/>TensorFlow 2.21<br/>CUDA 12.9"]
        JTrustyAI["jupyter/trustyai<br/>TrustyAI 0.6.4"]
        JROCmPT["jupyter/rocm/pytorch<br/>ROCm 7.14"]
        JROCmTF["jupyter/rocm/tensorflow<br/>ROCm 7.14"]
    end

    subgraph CodeServerWorkbenches["Code-Server Workbenches"]
        direction TB
        CSBaseline["codeserver-baseline<br/>JupyterLab + code-server"]
        CS["codeserver<br/>VS Code in browser<br/>8787/TCP"]
    end

    subgraph PipelineRuntimes["Elyra Pipeline Runtimes"]
        direction TB
        RTMinimal["runtimes/minimal<br/>Headless Python"]
        RTDataSci["runtimes/datascience<br/>Data science libs"]
        RTPyTorch["runtimes/pytorch<br/>PyTorch + CUDA"]
        RTLLM["runtimes/pytorch+llmcompressor<br/>Model quantization"]
        RTTensorFlow["runtimes/tensorflow<br/>TensorFlow + CUDA"]
        RTROCmPT["runtimes/rocm-pytorch<br/>ROCm"]
        RTROCmTF["runtimes/rocm-tensorflow<br/>ROCm"]
    end

    subgraph BuildTooling["Build Tooling"]
        direction LR
        BuildInputs["scripts/buildinputs<br/>Go CLI"]
        CheckPayload["scripts/check-payload<br/>FIPS scanner"]
    end

    subgraph Manifests["ImageStream Manifests"]
        direction LR
        RHOAIManifests["manifests/rhoai/<br/>registry.redhat.io images<br/>N through N-3 tags"]
        ODHManifests["manifests/odh/<br/>quay.io/opendatahub images"]
    end

    %% Base image feeds
    CPUBase -->|BASE_IMAGE| JMinimal
    CPUBase -->|BASE_IMAGE| CSBaseline
    CPUBase -->|BASE_IMAGE| RTMinimal
    CUDABase -->|BASE_IMAGE| JPyTorch
    CUDABase -->|BASE_IMAGE| JPyTorchLLM
    CUDABase -->|BASE_IMAGE| JTensorFlow
    ROCmBase -->|BASE_IMAGE| JROCmPT
    ROCmBase -->|BASE_IMAGE| JROCmTF

    %% Multi-stage embedding
    JMinimal -.->|stages embedded| JDataScience
    JMinimal -.->|stages embedded| JPyTorch
    JMinimal -.->|stages embedded| JTensorFlow

    %% Manifests reference images
    JMinimal --> RHOAIManifests
    JDataScience --> RHOAIManifests
    JPyTorch --> RHOAIManifests
    CS --> RHOAIManifests
    RTMinimal --> RHOAIManifests

    %% External consumers
    NotebookController["ODH Notebook Controller"]
    Dashboard["RHOAI Dashboard"]
    DSPipelines["Data Science Pipelines"]

    RHOAIManifests -->|ImageStream| NotebookController
    RHOAIManifests -->|annotations| Dashboard
    RTMinimal -->|container pull| DSPipelines

    %% Styling
    style CPUBase fill:#4a90e2,stroke:#333,color:#fff
    style CUDABase fill:#76b900,stroke:#333,color:#fff
    style ROCmBase fill:#ed1c24,stroke:#333,color:#fff
    style JMinimal fill:#f5a623,stroke:#333
    style JDataScience fill:#f5a623,stroke:#333
    style JPyTorch fill:#f5a623,stroke:#333
    style JPyTorchLLM fill:#f5a623,stroke:#333
    style JTensorFlow fill:#f5a623,stroke:#333
    style JTrustyAI fill:#f5a623,stroke:#333
    style JROCmPT fill:#f5a623,stroke:#333
    style JROCmTF fill:#f5a623,stroke:#333
    style CSBaseline fill:#9b59b6,stroke:#333,color:#fff
    style CS fill:#9b59b6,stroke:#333,color:#fff
    style RTMinimal fill:#2ecc71,stroke:#333
    style RTDataSci fill:#2ecc71,stroke:#333
    style RTPyTorch fill:#2ecc71,stroke:#333
    style RTLLM fill:#2ecc71,stroke:#333
    style RTTensorFlow fill:#2ecc71,stroke:#333
    style RTROCmPT fill:#2ecc71,stroke:#333
    style RTROCmTF fill:#2ecc71,stroke:#333
    style BuildInputs fill:#95a5a6,stroke:#333
    style CheckPayload fill:#95a5a6,stroke:#333
    style NotebookController fill:#e8e8e8,stroke:#333
    style Dashboard fill:#e8e8e8,stroke:#333
    style DSPipelines fill:#e8e8e8,stroke:#333
