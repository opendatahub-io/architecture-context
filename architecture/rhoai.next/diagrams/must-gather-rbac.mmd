graph TD
    subgraph OCP["OpenShift Platform"]
        OCPSA["ServiceAccount<br/>(auto-provisioned by<br/>oc adm must-gather)"]
        OCPCRB["ClusterRoleBinding<br/>(auto-provisioned)"]
        OCPCR["ClusterRole<br/>cluster-reader"]

        OCPSA -->|"bound via"| OCPCRB
        OCPCRB -->|"grants"| OCPCR
    end

    subgraph XKS["xKS Platform (AKS/EKS/CKS)"]
        XKSSA["ServiceAccount<br/>must-gather-sa"]
        XKSCRB["ClusterRoleBinding<br/>must-gather-reader-binding"]
        XKSCR["ClusterRole<br/>must-gather-reader"]

        XKSSA -->|"bound via"| XKSCRB
        XKSCRB -->|"grants"| XKSCR
    end

    subgraph Resources["API Resources (Read-Only)"]
        direction LR
        AllGroups["All API Groups (*)"]
        AllResources["All Resources (*)"]
    end

    subgraph CRDResources["Specific CRD Resources Collected"]
        direction LR
        ServingCRDs["serving.kserve.io<br/>InferenceService<br/>ServingRuntime<br/>LLMInferenceService<br/>InferencePool"]
        PipelineCRDs["datasciencepipelineapplication<br/>Argo Workflow CRDs"]
        TrainingCRDs["kubeflow.org<br/>PyTorchJob, TrainJob<br/>TrainingRuntime"]
        GatewayCRDs["gateway.networking.k8s.io<br/>Gateway, HTTPRoute<br/>GRPCRoute"]
        IstioCRDs["networking.istio.io<br/>VirtualService<br/>AuthorizationPolicy<br/>PeerAuthentication"]
        MonitoringCRDs["monitoring.coreos.com<br/>ServiceMonitor<br/>PrometheusRule"]
    end

    subgraph Verbs["Permitted Operations"]
        ReadOps["get, list, watch"]
    end

    OCPCR -->|"cluster-wide read"| AllGroups
    XKSCR -->|"get, list, watch"| AllGroups
    AllGroups --> AllResources
    AllResources --> ReadOps
    AllResources -.->|"includes"| CRDResources

    style OCPSA fill:#4a90e2,color:#fff
    style XKSSA fill:#4a90e2,color:#fff
    style OCPCR fill:#f5a623,color:#fff
    style XKSCR fill:#f5a623,color:#fff
    style ReadOps fill:#7ed321
    style ServingCRDs fill:#dae8fc,stroke:#6c8ebf
    style PipelineCRDs fill:#dae8fc,stroke:#6c8ebf
    style TrainingCRDs fill:#dae8fc,stroke:#6c8ebf
    style GatewayCRDs fill:#dae8fc,stroke:#6c8ebf
    style IstioCRDs fill:#dae8fc,stroke:#6c8ebf
    style MonitoringCRDs fill:#dae8fc,stroke:#6c8ebf
