graph TD
    subgraph "OpenShift (OCP) RBAC"
        direction TB
        SA_OCP["ServiceAccount<br/>must-gather<br/>(auto-created by oc adm must-gather)"]

        CRB_OCP["ClusterRoleBinding<br/>(auto-provisioned)"]

        CR_OCP["ClusterRole<br/>must-gather<br/>(standard OpenShift role)"]

        subgraph "Permissions (OCP)"
            AllGroups_OCP["API Groups: *<br/>(all groups)"]
            AllResources_OCP["Resources: *<br/>(all resources)"]
            ReadVerbs_OCP["Verbs: get, list, watch<br/>(read-only)"]
        end

        SA_OCP -->|bound via| CRB_OCP
        CRB_OCP -->|grants| CR_OCP
        CR_OCP -->|scoped to| AllGroups_OCP
        CR_OCP -->|scoped to| AllResources_OCP
        CR_OCP -->|limited to| ReadVerbs_OCP
    end

    subgraph "xKS (Non-OpenShift) RBAC"
        direction TB
        SA_XKS["ServiceAccount<br/>must-gather-sa<br/>(user-created)"]

        CRB_XKS["ClusterRoleBinding<br/>must-gather-reader-binding<br/>(cluster-scoped)"]

        CR_XKS["ClusterRole<br/>must-gather-reader<br/>(user-created)"]

        subgraph "Permissions (xKS)"
            AllGroups_XKS["API Groups: *<br/>(all groups)"]
            AllResources_XKS["Resources: *<br/>(all resources)"]
            ReadVerbs_XKS["Verbs: get, list, watch<br/>(read-only)"]
        end

        SA_XKS -->|bound via| CRB_XKS
        CRB_XKS -->|grants| CR_XKS
        CR_XKS -->|scoped to| AllGroups_XKS
        CR_XKS -->|scoped to| AllResources_XKS
        CR_XKS -->|limited to| ReadVerbs_XKS
    end

    subgraph "Authentication"
        direction TB
        Auth["Authentication Mechanism<br/>ServiceAccount Bearer Token<br/>(automounted)"]
        Enforcement["Enforcement Point<br/>kube-apiserver RBAC"]
        Policy["Policy<br/>Read-only access to<br/>all API groups and resources"]

        Auth --> Enforcement
        Enforcement --> Policy
    end

    subgraph "Secrets"
        direction TB
        PullSecret["redhat-pull-secret (xKS only)<br/>Type: kubernetes.io/dockerconfigjson<br/>Purpose: Image pull for registry.redhat.io<br/>Provisioned: Manual (user-created)<br/>Auto-Rotate: No"]
    end

    SA_OCP -.->|uses| Auth
    SA_XKS -.->|uses| Auth
    SA_XKS -.->|requires| PullSecret

    %% API Resources Accessed
    subgraph "API Resources (Read-Only)"
        direction LR
        RHOAI_CRDs["RHOAI CRDs<br/>serving.kserve.io<br/>datasciencepipelinesapplications.opendatahub.io<br/>datasciencecluster.components.opendatahub.io<br/>+15 more CRD groups"]
        K8s_Core["Core Resources<br/>pods, services, events,<br/>configmaps, secrets (metadata only),<br/>deployments, replicasets"]
        Networking["Networking CRDs<br/>gateway.networking.k8s.io<br/>networking.istio.io<br/>security.istio.io"]
    end

    Policy -->|authorizes GET/LIST| RHOAI_CRDs
    Policy -->|authorizes GET/LIST| K8s_Core
    Policy -->|authorizes GET/LIST| Networking

    style SA_OCP fill:#4a90e2,color:#fff
    style SA_XKS fill:#4a90e2,color:#fff
    style CR_OCP fill:#f5a623,stroke:#333
    style CR_XKS fill:#f5a623,stroke:#333
    style CRB_OCP fill:#e8e8e8,stroke:#333
    style CRB_XKS fill:#e8e8e8,stroke:#333
    style Auth fill:#9b59b6,color:#fff
    style Enforcement fill:#9b59b6,color:#fff
    style Policy fill:#9b59b6,color:#fff
    style RHOAI_CRDs fill:#7ed321,stroke:#333
    style K8s_Core fill:#7ed321,stroke:#333
    style Networking fill:#7ed321,stroke:#333
    style PullSecret fill:#e74c3c,color:#fff
