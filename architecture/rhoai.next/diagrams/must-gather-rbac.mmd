graph TD
    subgraph OCPMode["OpenShift Mode"]
        direction TB
        OCPPlugin["oc adm must-gather Plugin"]
        OCPSA["Auto-Provisioned ServiceAccount<br/>(cluster-admin equivalent)"]
        OCPCRB["ClusterRoleBinding<br/>(auto-created by plugin)"]
        OCPCR["cluster-admin ClusterRole"]

        OCPPlugin -->|"creates ephemeral"| OCPSA
        OCPSA -->|"bound via"| OCPCRB
        OCPCRB -->|"grants"| OCPCR

        subgraph OCPResources["Accessible Resources (all namespaces)"]
            direction LR
            OCPAll["All API Groups<br/>All Resources<br/>Verbs: get, list, watch"]
        end

        OCPCR -->|"full read access"| OCPResources
    end

    subgraph XKSMode["xKS Mode (AKS / EKS / CKS)"]
        direction TB
        XKS_SA["ServiceAccount<br/>must-gather-sa<br/>Namespace: must-gather"]
        XKS_CRB["ClusterRoleBinding<br/>must-gather-reader-binding<br/>Scope: cluster-wide"]
        XKS_CR["ClusterRole<br/>must-gather-reader"]

        XKS_SA -->|"bound via"| XKS_CRB
        XKS_CRB -->|"grants"| XKS_CR

        subgraph XKSResources["Accessible Resources"]
            direction LR
            XKSAll["API Groups: * (all)<br/>Resources: * (all)<br/>Verbs: get, list, watch"]
        end

        XKS_CR -->|"read-only cluster-wide"| XKSResources
    end

    subgraph Secrets["Secrets"]
        direction TB
        PullSecret["redhat-pull-secret<br/>Type: kubernetes.io/dockerconfigjson<br/>Purpose: Pull image from registry.redhat.io<br/>Provisioned: Manual (user-created)<br/>Auto-Rotate: No<br/>(xKS only)"]
    end

    subgraph AuthN["Authentication & Authorization"]
        direction TB
        AuthFlow["Kubernetes API<br/>Methods: GET, LIST<br/>Auth: ServiceAccount bearer token<br/>Enforcement: Kubernetes API server<br/>Policy: ClusterRole with read-only access"]
    end

    %% Styling
    style OCPPlugin fill:#4a90e2,stroke:#333,color:#fff
    style OCPSA fill:#4a90e2,stroke:#333,color:#fff
    style OCPCRB fill:#f5a623,stroke:#333,color:#fff
    style OCPCR fill:#f5a623,stroke:#333,color:#fff

    style XKS_SA fill:#4a90e2,stroke:#333,color:#fff
    style XKS_CRB fill:#f5a623,stroke:#333,color:#fff
    style XKS_CR fill:#f5a623,stroke:#333,color:#fff

    style OCPAll fill:#7ed321,stroke:#333
    style XKSAll fill:#7ed321,stroke:#333

    style PullSecret fill:#e8e8e8,stroke:#333
    style AuthFlow fill:#dae8fc,stroke:#6c8ebf
