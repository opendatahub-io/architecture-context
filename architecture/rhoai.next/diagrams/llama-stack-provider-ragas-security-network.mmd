graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AppBoundary["LLAMA STACK SERVER (Application Boundary)"]
        direction TB
        LlamaStack["Llama Stack Server<br/>FastAPI/uvicorn<br/>8321/TCP HTTP<br/>Auth: configurable"]

        subgraph Provider["llama-stack-provider-ragas"]
            direction TB
            InlineEval["RagasEvaluatorInline<br/>max_workers=1<br/>In-process only"]
            RemoteEval["RagasEvaluatorRemote<br/>Network egress"]
        end

        subgraph InProcessAPIs["In-Process APIs (no network)"]
            InferenceAPI["Inference API<br/>(LLM + Embeddings)"]
            DatasetAPI["DatasetIO API"]
        end

        LlamaStack --> InlineEval
        LlamaStack --> RemoteEval
        InlineEval --> InferenceAPI
        InlineEval --> DatasetAPI
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        KFP["Kubeflow Pipelines API<br/>443/TCP HTTPS<br/>TLS (default)<br/>Bearer token"]

        KFPPod["KFP Pipeline Pods<br/>Image: KUBEFLOW_BASE_IMAGE<br/>Stages: retrieve_data,<br/>run_ragas_evaluation"]

        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>SA / kubeconfig"]

        TrustyAICM["TrustyAI ConfigMap<br/>trustyai-service-operator-config<br/>NS: redhat-ods-applications"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS (default)<br/>AWS IAM (K8s secret)"]
    end

    %% External to App
    Client -->|"HTTP/8321<br/>No encryption<br/>Auth: configurable"| LlamaStack

    %% Remote provider egress
    RemoteEval -->|"HTTPS/443<br/>TLS (default)<br/>Bearer token"| KFP
    RemoteEval -->|"HTTPS/443<br/>TLS (default)<br/>AWS IAM"| S3
    RemoteEval -->|"HTTPS/443<br/>TLS<br/>SA/kubeconfig"| K8sAPI

    %% KFP pod flows
    KFP -->|"Launches"| KFPPod
    KFPPod -->|"HTTP/configurable<br/>No encryption<br/>No auth"| LlamaStack
    KFPPod -->|"HTTPS/443<br/>TLS (default)<br/>AWS IAM (K8s secret)"| S3

    %% K8s internal
    K8sAPI -->|"ConfigMap read"| TrustyAICM

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appboundary fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef provider fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class LlamaStack,InlineEval,RemoteEval,InferenceAPI,DatasetAPI appboundary
    class KFP,KFPPod,K8sAPI,TrustyAICM cluster
    class S3 externalservice
