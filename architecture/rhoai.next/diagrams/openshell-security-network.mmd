graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["CLI / SDK Client"]
    end

    subgraph Ingress["INGRESS (Optional)"]
        GRPCRoute["GRPCRoute / OpenShift Route<br/>443/TCP<br/>TLS terminate or passthrough"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        Gateway["OpenShell Gateway<br/>8080/TCP gRPC+HTTP<br/>8081/TCP Health<br/>9090/TCP Metrics<br/>TLS 1.2+ / mTLS<br/>SA: gateway<br/>Image: odh-openshell-gateway-rhel9"]
    end

    subgraph EnforcementBoundary["ENFORCEMENT BOUNDARY (Per-Sandbox)"]
        direction TB

        subgraph SupervisorZone["Supervisor Container"]
            Supervisor["OpenShell Supervisor<br/>5500/TCP mTLS<br/>L7 Policy Enforcement<br/>OPA/Rego + Credential Injection<br/>Image: odh-openshell-supervisor-rhel9"]
        end

        subgraph SandboxZone["Sandbox Container"]
            SandboxRT["Sandbox Runtime<br/>Static glibc binary<br/>Seccomp + Landlock<br/>No listening ports"]
            AgentWorkload["Agent Workload<br/>All egress proxied<br/>No credential access"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token"]
        OIDCProvider["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>JWKS"]
        Vault["Vault (optional)<br/>8200/TCP HTTPS<br/>TLS 1.2+<br/>K8s SA Token"]
        OTLPCollector["OTLP Collector (optional)<br/>4317/TCP gRPC<br/>TLS optional"]
        UpstreamAPIs["Upstream APIs<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Injected Credentials"]
    end

    %% External flows
    Client -->|"gRPC+HTTP/8080<br/>TLS 1.2+<br/>OIDC Bearer / mTLS"| GRPCRoute
    GRPCRoute -->|"TLS passthrough<br/>or terminate+re-encrypt"| Gateway

    %% Gateway to Supervisor
    Gateway -->|"gRPC/5500<br/>mTLS<br/>Sandbox JWT"| Supervisor

    %% Sandbox Protocol
    SandboxRT -->|"Sandbox Protocol<br/>mTLS + Sandbox JWT<br/>Process Identity"| Supervisor
    AgentWorkload -->|"HTTP via L7 proxy<br/>Policy-evaluated"| Supervisor

    %% Supervisor to external
    Supervisor -->|"HTTPS/443<br/>TLS 1.2+<br/>Provider creds injected"| UpstreamAPIs

    %% Gateway to external services
    Gateway -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Gateway -->|"HTTPS/443<br/>TLS 1.2+<br/>JWKS fetch"| OIDCProvider
    Gateway -.->|"HTTPS/8200<br/>TLS 1.2+<br/>K8s SA Token"| Vault
    Gateway -.->|"gRPC/4317<br/>TLS optional"| OTLPCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef enforcement fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class GRPCRoute ingress
    class Gateway controlplane
    class Supervisor,SandboxRT,AgentWorkload enforcement
    class K8sAPI,OIDCProvider,Vault,OTLPCollector,UpstreamAPIs externalservice
