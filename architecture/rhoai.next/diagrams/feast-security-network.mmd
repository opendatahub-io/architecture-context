graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        Route["OpenShift Route<br/>443/TCP → 6566/TCP<br/>TLS edge/passthrough<br/>CRD-configured Auth"]
    end

    subgraph ClusterInternal["APPLICATION SERVICES (Cluster-Internal)"]
        direction TB

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["Feast Operator<br/>SA: feast-operator-controller-manager<br/>8081/TCP Health (no auth)<br/>8443/TCP Metrics (HTTPS, TokenReview)"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            FS_Python["Feature Server (Python)<br/>Port: 6566/TCP<br/>HTTP/HTTPS (CRD-configured)<br/>Auth: K8s RBAC / OIDC / NoAuth<br/>Image: AIPCC CPU base"]
            FS_Go["Feature Server (Go)<br/>Port: Configurable<br/>TLS 1.2+ (X25519MLKEM768)<br/>Auth: None (external enforcement)"]
            CronJob["Materialization CronJob<br/>Image: ose-cli (digest-pinned)"]
        end
    end

    subgraph BackendServices["EGRESS (Backend Services)"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        Redis["Redis / Valkey<br/>Configured port<br/>TCP, Optional TLS<br/>Optional password"]
        PostgreSQL["PostgreSQL<br/>Configured port<br/>TCP, Configured encryption<br/>Connection string"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM / credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS<br/>Google credentials"]
        BigQuery["BigQuery<br/>443/TCP HTTPS<br/>TLS<br/>Google credentials"]
        Snowflake["Snowflake<br/>443/TCP HTTPS<br/>TLS<br/>Snowflake credentials"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS edge/passthrough<br/>CRD-configured Auth"| Route
    Route -->|"HTTP(S)/6566<br/>CRD-configured TLS"| FS_Python
    Client -.->|"HTTP(S)/configurable<br/>TLS 1.2+ (PQ curves)<br/>No app-level auth"| FS_Go

    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    CronJob -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    FS_Python -->|"TCP/configured<br/>Optional TLS<br/>Password/TLS"| Redis
    FS_Python -->|"TCP/configured<br/>Configured<br/>Conn string"| PostgreSQL
    FS_Python -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    FS_Python -->|"HTTPS/443<br/>TLS<br/>Google creds"| GCS
    FS_Python -->|"HTTPS/443<br/>TLS<br/>Google creds"| BigQuery
    FS_Python -->|"HTTPS/443<br/>TLS<br/>Snowflake creds"| Snowflake

    FS_Go -->|"TCP/configured<br/>Optional TLS"| Redis
    FS_Go -->|"TCP/configured<br/>Configured"| PostgreSQL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route ingress
    class Operator,FS_Python,FS_Go,CronJob internal
    class K8sAPI,Redis,PostgreSQL,S3,GCS,BigQuery,Snowflake backend
