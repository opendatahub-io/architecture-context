graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        MLApp["ML Application<br/>Data Scientist"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Feast["Namespace: feast-{project}"]
            subgraph FeastPod["feast-{project} Deployment (multi-container)"]
                FeatureServer["Feature Server<br/>6566/TCP HTTP/gRPC<br/>SA: feast-{project}<br/>Auth: OIDC/K8s token"]
                Registry["Registry Server<br/>8080/TCP REST<br/>Auth: OIDC/K8s token"]
                OfflineServer["Offline Server<br/>(batch processing)"]
                FeastUI["Feast UI<br/>8501/TCP HTTP<br/>Auth: None"]
                MetricsExporter["Metrics Exporter<br/>8000/TCP HTTP<br/>Auth: None"]
            end
            CronJob["CronJob Pod<br/>SA: feast-{project}<br/>Image: origin-cli"]
        end

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            Operator["Feast Operator<br/>Controller Manager<br/>8081/TCP health (no auth)<br/>8443/TCP metrics (HTTPS, bearer)<br/>SA: controller-manager<br/>FIPS: strictfipsruntime"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        OCPAPI["OpenShift API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        CertSigner["service-serving-cert-signer<br/>Annotation-triggered<br/>TLS provisioning"]
        PrometheusOp["Prometheus Operator<br/>ServiceMonitor CRD"]
        CABundle["odh-trusted-ca-bundle<br/>ConfigMap mount"]
        KubeFlow["KubeFlow Notebook Controller<br/>CRD Watch"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Redis["Redis<br/>6379/TCP<br/>TLS optional<br/>Password auth"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS optional<br/>Credentials"]
        DynamoDB["DynamoDB<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        BigQuery["BigQuery<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP IAM"]
        Snowflake["Snowflake<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Credentials"]
        OIDC["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External to Cluster
    MLApp -->|"HTTP-gRPC/6566<br/>TLS 1.2+ (when configured)<br/>OIDC/K8s token"| FeatureServer

    %% Intra-pod communication
    FeatureServer <-->|"Intra-pod<br/>HMAC-SHA256 JWT"| Registry

    %% CronJob flow
    CronJob -->|"kubectl exec<br/>HTTPS/6443<br/>SA token"| K8sAPI
    K8sAPI -->|"exec into pod"| FeatureServer

    %% Operator flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| OCPAPI
    Operator -->|"HTTP(S)/8080<br/>Bearer JWT<br/>⚠ InsecureSkipVerify"| Registry

    %% Platform integrations
    Operator -.->|"CRD create"| PrometheusOp
    Operator -.->|"CRD watch"| KubeFlow
    CertSigner -.->|"auto-provision<br/>TLS certs"| FeastPod
    CABundle -.->|"volume mount"| FeastPod

    %% Feature Server to stores
    FeatureServer -->|"TCP/6379<br/>TLS optional<br/>Password"| Redis
    FeatureServer -->|"TCP/5432<br/>TLS optional<br/>Credentials"| PostgreSQL
    FeatureServer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| DynamoDB

    %% Offline store
    OfflineServer -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP IAM"| BigQuery
    OfflineServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Credentials"| Snowflake

    %% OIDC validation
    FeatureServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Discovery"| OIDC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class MLApp external
    class FeatureServer,Registry,OfflineServer,FeastUI,MetricsExporter,CronJob cluster
    class Operator cluster
    class K8sAPI,OCPAPI,CertSigner,PrometheusOp,CABundle,KubeFlow platform
    class Redis,PostgreSQL,DynamoDB,BigQuery,Snowflake,OIDC externalservice
