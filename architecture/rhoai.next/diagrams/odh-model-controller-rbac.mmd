graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["odh-model-controller"]
        SA_MSA["model-serving-api"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB_Main["odh-model-controller-<br/>rolebinding-opendatahub"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_MSA["model-serving-api<br/>binding"]
        CRB_Metrics["metrics-auth-<br/>rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["odh-model-controller-role"]
        CR_Proxy["proxy-role"]
        CR_MSA["model-serving-api"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsRead["metrics-reader"]
    end

    subgraph KServeCRDs["serving.kserve.io"]
        IS["InferenceService<br/>+finalizers +status"]
        LLMIS["LLMInferenceService<br/>+finalizers +status"]
        IG["InferenceGraph<br/>+finalizers"]
        SR["ServingRuntime<br/>+finalizers"]
    end

    subgraph NIMCRDs["nim.opendatahub.io"]
        NIMAcct["Account<br/>+finalizers +status"]
    end

    subgraph GatewayRes["gateway.networking.k8s.io"]
        GW["Gateways"]
        HTTPRoute["HTTPRoutes"]
    end

    subgraph KuadrantRes["kuadrant.io"]
        AuthPolicy["AuthPolicies"]
    end

    subgraph KEDARes["keda.sh"]
        TrigAuth["TriggerAuthentications"]
    end

    subgraph MonitoringRes["monitoring.coreos.com"]
        PodMon["PodMonitors"]
        SvcMon["ServiceMonitors"]
    end

    subgraph IstioRes["networking.istio.io"]
        EnvFilter["EnvoyFilters"]
    end

    subgraph CoreRes["Core API Resources"]
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
        SvcAccts["ServiceAccounts"]
        Services["Services"]
        Pods["Pods"]
        NetPol["NetworkPolicies"]
        Roles["Roles / RoleBindings /<br/>ClusterRoleBindings"]
    end

    subgraph AuthRes["Auth APIs"]
        TokenReview["TokenReviews"]
        SAR["SubjectAccessReviews"]
    end

    %% Controller SA bindings
    SA_Controller -->|bound via| CRB_Main
    SA_Controller -->|bound via| CRB_Proxy
    CRB_Main -->|grants| CR_Main
    CRB_Proxy -->|grants| CR_Proxy

    %% MSA bindings
    SA_MSA -->|bound via| CRB_MSA
    CRB_MSA -->|grants| CR_MSA

    %% Metrics bindings
    CRB_Metrics -->|grants| CR_MetricsAuth

    %% Main role permissions
    CR_Main -->|"get,list,watch,create,<br/>patch,update"| IS
    CR_Main -->|"get,list,watch,create,<br/>patch,update"| LLMIS
    CR_Main -->|"get,list,watch,create,<br/>patch,update"| IG
    CR_Main -->|"get,list,watch,create,<br/>patch,update"| SR
    CR_Main -->|"get,list,patch,<br/>update,watch"| NIMAcct
    CR_Main -->|"get,list,watch,<br/>patch,update"| GW
    CR_Main -->|"get,list,watch,<br/>patch,update"| HTTPRoute
    CR_Main -->|"full CRUD"| AuthPolicy
    CR_Main -->|"full CRUD"| TrigAuth
    CR_Main -->|"full CRUD"| PodMon
    CR_Main -->|"full CRUD"| SvcMon
    CR_Main -->|"full CRUD"| EnvFilter
    CR_Main -->|"full CRUD"| ConfigMaps
    CR_Main -->|"full CRUD"| Secrets
    CR_Main -->|"full CRUD"| SvcAccts
    CR_Main -->|"full CRUD"| Services
    CR_Main -->|"full CRUD"| NetPol
    CR_Main -->|"full CRUD"| Roles

    %% Proxy + metrics auth role
    CR_Proxy -->|"create"| TokenReview
    CR_Proxy -->|"create"| SAR
    CR_MetricsAuth -->|"create"| TokenReview
    CR_MetricsAuth -->|"create"| SAR

    %% MSA role
    CR_MSA -->|"list"| GW
    CR_MSA -->|"get"| CoreNS["Namespaces"]

    style SA_Controller fill:#4a90e2,color:#fff
    style SA_MSA fill:#4a90e2,color:#fff
    style CR_Main fill:#f5a623
    style CR_Proxy fill:#f5a623
    style CR_MSA fill:#f5a623
    style CR_MetricsAuth fill:#f5a623
    style CR_MetricsRead fill:#f5a623
    style IS fill:#7ed321
    style LLMIS fill:#7ed321
    style IG fill:#7ed321
    style SR fill:#7ed321
    style NIMAcct fill:#7ed321
