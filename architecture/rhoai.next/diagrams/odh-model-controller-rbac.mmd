graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["odh-model-controller<br/>(system namespace)"]
        SA_Server["model-serving-api"]
        SA_Prometheus["prometheus-custom<br/>(openshift-monitoring)"]
        SA_ISVC["{isvc}-predictor SA<br/>(per ISVC)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["odh-model-controller-<br/>rolebinding-opendatahub<br/>(cluster-wide)"]
        CRB_Server["model-serving-api-<br/>rolebinding<br/>(cluster-wide)"]
        CRB_AuthDeleg["{ns}-{sa}-auth-delegator<br/>(per ISVC, cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>(system namespace)"]
        RB_Prometheus["prometheus-ns-access<br/>(per user namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Main["odh-model-controller-role"]
        CR_Server["model-serving-api"]
        CR_Editor["account-editor-role"]
        CR_Viewer["account-viewer-role"]
        CR_Metrics["metrics-reader"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_PromAccess["prometheus-ns-access"]
    end

    subgraph Roles["Namespace Roles"]
        R_Leader["leader-election-role"]
    end

    %% SA → CRB → CR
    SA_Controller -->|"bound via"| CRB_Main
    CRB_Main -->|"grants"| CR_Main

    SA_Server -->|"bound via"| CRB_Server
    CRB_Server -->|"grants"| CR_Server

    SA_ISVC -->|"bound via"| CRB_AuthDeleg
    CRB_AuthDeleg -->|"grants"| CR_AuthDeleg

    %% SA → RB → R
    SA_Controller -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| R_Leader

    SA_Prometheus -->|"bound via"| RB_Prometheus
    RB_Prometheus -->|"grants"| CR_PromAccess

    subgraph MainRoleResources["odh-model-controller-role Permissions"]
        direction LR

        subgraph KServeCRDs["serving.kserve.io"]
            ISVC_Res["inferenceservices<br/>+ finalizers<br/>CRUD"]
            LLMISVC_Res["llminferenceservices<br/>+ status + finalizers<br/>CRUD + post"]
            SR_Res["servingruntimes<br/>+ finalizers<br/>get/list/watch/create/update"]
            IG_Res["inferencegraphs<br/>+ finalizers<br/>get/list/watch/update"]
            LLMConfig_Res["llminferenceserviceconfigs<br/>get/list/watch"]
        end

        subgraph NIMCRDs["nim.opendatahub.io"]
            Account_Res["accounts<br/>+ status + finalizers<br/>CRUD"]
        end

        subgraph CoreRes["core (v1)"]
            Core_Res["secrets, configmaps,<br/>serviceaccounts, services,<br/>namespaces, pods, endpoints<br/>CRUD"]
            Events_Res["events<br/>create/patch"]
        end

        subgraph NetworkRes["Networking"]
            Route_Res["route.openshift.io<br/>routes, routes/custom-host<br/>CRUD"]
            GW_Res["gateway.networking.k8s.io<br/>gateways + finalizers<br/>get/list/watch/update/patch"]
            HR_Res["gateway.networking.k8s.io<br/>httproutes<br/>get/list/watch"]
            NP_Res["networking.k8s.io<br/>networkpolicies<br/>CRUD"]
        end

        subgraph SecurityRes["Security / Auth"]
            AuthPolicy_Res["kuadrant.io<br/>authpolicies + status<br/>CRUD"]
            Kuadrant_Res["kuadrant.io<br/>kuadrants<br/>get/list/watch"]
            EnvoyFilter_Res["networking.istio.io<br/>envoyfilters<br/>CRUD"]
            RBAC_Res["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>roles, rolebindings<br/>CRUD"]
            Authorino_Res["operator.authorino.kuadrant.io<br/>authorinos<br/>get/list/watch"]
            AuthConfig_Res["config.openshift.io<br/>authentications<br/>get/list/watch"]
        end

        subgraph MonitoringRes["Monitoring"]
            SM_Res["monitoring.coreos.com<br/>servicemonitors, podmonitors<br/>CRUD"]
            KEDA_Res["keda.sh<br/>triggerauthentications<br/>CRUD"]
            MetricsK8s_Res["metrics.k8s.io<br/>pods, nodes<br/>get/list/watch"]
        end

        subgraph PlatformRes["Platform (read-only)"]
            DSC_Res["datasciencecluster.opendatahub.io<br/>datascienceclusters<br/>get/list/watch"]
            DSCI_Res["dscinitialization.opendatahub.io<br/>dscinitializations<br/>get/list/watch"]
            HWP_Res["infrastructure.opendatahub.io<br/>hardwareprofiles<br/>get/list/watch"]
            Template_Res["template.openshift.io<br/>templates<br/>CRUD"]
        end
    end

    CR_Main -->|"manages"| MainRoleResources

    subgraph ServerRoleResources["model-serving-api Permissions"]
        GW_List["gateway.networking.k8s.io<br/>gateways<br/>list"]
        NS_Get["core: namespaces<br/>get"]
    end

    CR_Server -->|"manages"| ServerRoleResources

    subgraph LeaderResources["leader-election-role Permissions"]
        Leader_Res["core: configmaps,<br/>leases, events<br/>CRUD"]
    end

    R_Leader -->|"manages"| LeaderResources

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_Server fill:#4a90e2,color:#fff
    style SA_Prometheus fill:#4a90e2,color:#fff
    style SA_ISVC fill:#4a90e2,color:#fff

    style CR_Main fill:#f5a623,color:#fff
    style CR_Server fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style CR_AuthDeleg fill:#f5a623,color:#fff
    style CR_PromAccess fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff

    style CRB_Main fill:#e0e0e0
    style CRB_Server fill:#e0e0e0
    style CRB_AuthDeleg fill:#e0e0e0
    style RB_Leader fill:#e0e0e0
    style RB_Prometheus fill:#e0e0e0
