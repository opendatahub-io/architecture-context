graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["odh-model-controller<br/>Namespace: opendatahub"]
        SA_API["model-serving-api<br/>Namespace: opendatahub"]
        SA_Dynamic["Dynamic SAs<br/>(per InferenceService)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["odh-model-controller-rolebinding<br/>(cluster-wide)"]
        CRB_Proxy["proxy-rolebinding<br/>(cluster-wide)"]
        CRB_API["model-serving-api<br/>(cluster-wide)"]
        CRB_Leader["leader-election-rolebinding<br/>(namespace-scoped)"]
        CRB_AuthDel["{ns}-{sa}-auth-delegator<br/>(dynamic, cluster-wide)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["odh-model-controller-role"]
        CR_Proxy["proxy-role"]
        CR_API["model-serving-api"]
        CR_Leader["leader-election-role"]
        CR_AuthDel["system:auth-delegator"]
        CR_PromK8s["kserve-prometheus-k8s"]
        CR_AccEditor["account-editor-role"]
        CR_AccViewer["account-viewer-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>ConfigMaps"]
        Secrets["core<br/>Secrets"]
        ServiceAccounts_R["core<br/>ServiceAccounts"]
        Services["core<br/>Services"]
        Endpoints["core<br/>Endpoints"]
        Namespaces["core<br/>Namespaces"]
        Pods["core<br/>Pods"]
        Events["core<br/>Events"]
    end

    subgraph KServeResources["KServe API Resources"]
        InferenceService["serving.kserve.io<br/>InferenceService"]
        ServingRuntime["serving.kserve.io<br/>ServingRuntime"]
        LLMInferenceService["serving.kserve.io<br/>LLMInferenceService"]
        InferenceGraph["serving.kserve.io<br/>InferenceGraph"]
    end

    subgraph NIMResources["NIM API Resources"]
        Account["nim.opendatahub.io<br/>Account"]
    end

    subgraph NetworkResources["Network & Auth Resources"]
        AuthPolicy["kuadrant.io<br/>AuthPolicy"]
        Kuadrant_R["kuadrant.io<br/>Kuadrant"]
        Authorino_R["operator.authorino.kuadrant.io<br/>Authorino"]
        Gateway["gateway.networking.k8s.io<br/>Gateway"]
        HTTPRoute["gateway.networking.k8s.io<br/>HTTPRoute"]
        EnvoyFilter["networking.istio.io<br/>EnvoyFilter"]
        Route["route.openshift.io<br/>Route"]
        NetworkPolicy["networking.k8s.io<br/>NetworkPolicy"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitor["monitoring.coreos.com<br/>ServiceMonitor"]
        PodMonitor["monitoring.coreos.com<br/>PodMonitor"]
        TriggerAuth["keda.sh<br/>TriggerAuthentication"]
    end

    subgraph RBACResources["RBAC Resources"]
        ClusterRoleBinding_R["rbac.authorization.k8s.io<br/>ClusterRoleBinding"]
        RoleBinding_R["rbac.authorization.k8s.io<br/>RoleBinding"]
        Role_R["rbac.authorization.k8s.io<br/>Role"]
    end

    subgraph PlatformResources["Platform Resources"]
        Template["template.openshift.io<br/>Template"]
        Authentication["config.openshift.io<br/>Authentication"]
        DSC["datasciencecluster.opendatahub.io<br/>DataScienceCluster"]
        DSCI["dscinitialization.opendatahub.io<br/>DSCInitialization"]
        HWProfile["infrastructure.opendatahub.io<br/>HardwareProfile"]
        TokenReview["authentication.k8s.io<br/>TokenReview"]
        SAR["authorization.k8s.io<br/>SubjectAccessReview"]
    end

    %% Service Account → Binding → Role chains
    SA_Controller -->|bound via| CRB_Main
    SA_Controller -->|bound via| CRB_Proxy
    SA_Controller -->|bound via| CRB_Leader
    SA_API -->|bound via| CRB_API
    SA_Dynamic -->|bound via| CRB_AuthDel

    CRB_Main -->|grants| CR_Main
    CRB_Proxy -->|grants| CR_Proxy
    CRB_API -->|grants| CR_API
    CRB_Leader -->|grants| CR_Leader
    CRB_AuthDel -->|grants| CR_AuthDel

    %% CR_Main permissions (CRUD)
    CR_Main -->|"CRUD + watch"| ConfigMaps
    CR_Main -->|"CRUD + watch"| Secrets
    CR_Main -->|"CRUD + watch"| ServiceAccounts_R
    CR_Main -->|"CRUD + watch"| Services
    CR_Main -->|"create,get,list,<br/>patch,update,watch"| Endpoints
    CR_Main -->|"create,get,list,<br/>patch,update,watch"| Pods
    CR_Main -->|"create, patch"| Events
    CR_Main -->|"get,list,patch,<br/>update,watch"| InferenceService
    CR_Main -->|"create,get,list,<br/>update,watch"| ServingRuntime
    CR_Main -->|"CRUD + watch + status"| LLMInferenceService
    CR_Main -->|"get,list,watch"| InferenceGraph
    CR_Main -->|"get,list,patch,<br/>update,watch"| Account
    CR_Main -->|"CRUD + watch"| AuthPolicy
    CR_Main -->|"get,list,watch"| Kuadrant_R
    CR_Main -->|"get,list,watch"| Authorino_R
    CR_Main -->|"get,list,patch,<br/>update,watch"| Gateway
    CR_Main -->|"get,list,patch,<br/>update,watch"| HTTPRoute
    CR_Main -->|"CRUD + watch"| EnvoyFilter
    CR_Main -->|"CRUD + watch"| Route
    CR_Main -->|"CRUD + watch"| NetworkPolicy
    CR_Main -->|"CRUD + watch"| ServiceMonitor
    CR_Main -->|"CRUD + watch"| PodMonitor
    CR_Main -->|"CRUD + watch"| TriggerAuth
    CR_Main -->|"CRUD + watch"| ClusterRoleBinding_R
    CR_Main -->|"CRUD + watch"| RoleBinding_R
    CR_Main -->|"CRUD + watch"| Role_R
    CR_Main -->|"CRUD + watch"| Template
    CR_Main -->|"get,list,watch"| Authentication
    CR_Main -->|"get,list,watch"| DSC
    CR_Main -->|"get,list,watch"| DSCI
    CR_Main -->|"get,list,watch"| HWProfile

    %% CR_Proxy permissions
    CR_Proxy -->|"create"| TokenReview
    CR_Proxy -->|"create"| SAR

    %% CR_API permissions
    CR_API -->|"list"| Gateway
    CR_API -->|"get"| Namespaces

