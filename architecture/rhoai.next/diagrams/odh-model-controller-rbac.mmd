    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Dynamic fill:#4a90e2,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333,color:#fff
    style CR_Proxy fill:#f5a623,stroke:#333,color:#fff
    style CR_API fill:#f5a623,stroke:#333,color:#fff
    style CR_Leader fill:#f5a623,stroke:#333,color:#fff
    style CR_AuthDel fill:#f5a623,stroke:#333,color:#fff
    style CR_PromK8s fill:#f5a623,stroke:#333,color:#fff
    style CR_AccEditor fill:#f5a623,stroke:#333,color:#fff
    style CR_AccViewer fill:#f5a623,stroke:#333,color:#fff
    style InferenceService fill:#7ed321,stroke:#333
    style ServingRuntime fill:#7ed321,stroke:#333
    style LLMInferenceService fill:#7ed321,stroke:#333
    style InferenceGraph fill:#7ed321,stroke:#333
