graph LR
    GIE["Gateway API<br/>Inference Extension"]

    %% Required External Dependencies
    GIE -->|"ext-proc filter chain<br/>gRPC/HTTP2"| Envoy["Envoy Proxy v1.33+<br/>(Istio / GKE)"]
    GIE -->|"Gateway, HTTPRoute CRDs"| GatewayAPI["Gateway API CRDs v1"]
    GIE -->|"CRD reconciliation<br/>controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    GIE -->|"ext-proc protocol<br/>definitions"| GoControlPlane["go-control-plane<br/>v1.37.0"]
    GIE -->|"metrics collection<br/>and exposition"| PromClient["Prometheus Client<br/>v1.23.2"]

    %% Optional External Dependencies
    GIE -.->|"distributed tracing<br/>(optional)"| OTEL["OpenTelemetry SDK<br/>v1.43.0"]
    GIE -.->|"latency prediction<br/>(optional)"| XGBoost["XGBoost"]
    GIE -.->|"latency prediction<br/>(optional)"| LightGBM["LightGBM"]
    GIE -.->|"latency prediction<br/>(optional)"| SKLearn["scikit-learn"]

    %% Internal Platform Dependencies
    GIE -->|"HTTP /metrics scraping<br/>KV cache, queue depth,<br/>LoRA adapter info"| ModelServers["Model Server Pods<br/>(vLLM / SGLang / Triton)"]
    GIE -->|"CRD Watch + Pod Watch<br/>Lease Lock (HA)<br/>HTTPS 443/TCP"| K8sAPI["Kubernetes API Server"]
    GIE -->|"Gateway + HTTPRoute<br/>CRDs for ingress"| GatewayProvider["Gateway API Provider<br/>(Istio / GKE)"]

    %% Optional Internal Dependencies
    GIE -.->|"ServiceMonitor<br/>scrape 9090/TCP"| Prometheus["Prometheus"]
    GIE -.->|"gRPC trace export<br/>4317/TCP"| OTLPCollector["OTLP Collector"]

    %% Components that integrate WITH this extension
    Dashboard["ODH Dashboard /<br/>RHOAI Console"] -.->|"UI management<br/>(future)"| GIE
    Pipelines["Data Science<br/>Pipelines"] -.->|"auto deploy<br/>(future)"| GIE

    %% Styling
    style GIE fill:#4a90e2,stroke:#2c5f8a,color:#fff,stroke-width:4px

    %% Required external (grey)
    style Envoy fill:#999,stroke:#666,color:#fff
    style GatewayAPI fill:#999,stroke:#666,color:#fff
    style ControllerRuntime fill:#999,stroke:#666,color:#fff
    style GoControlPlane fill:#999,stroke:#666,color:#fff
    style PromClient fill:#999,stroke:#666,color:#fff

    %% Optional external (light grey, dashed)
    style OTEL fill:#ccc,stroke:#999,color:#333
    style XGBoost fill:#ccc,stroke:#999,color:#333
    style LightGBM fill:#ccc,stroke:#999,color:#333
    style SKLearn fill:#ccc,stroke:#999,color:#333

    %% Internal platform (green)
    style ModelServers fill:#7ed321,stroke:#5a9e15,color:#fff
    style K8sAPI fill:#7ed321,stroke:#5a9e15,color:#fff
    style GatewayProvider fill:#7ed321,stroke:#5a9e15,color:#fff

    %% Optional internal (light green)
    style Prometheus fill:#b8e986,stroke:#82b366,color:#333
    style OTLPCollector fill:#b8e986,stroke:#82b366,color:#333

    %% Downstream integrators (orange)
    style Dashboard fill:#f5a623,stroke:#c07d10,color:#fff
    style Pipelines fill:#f5a623,stroke:#c07d10,color:#fff
