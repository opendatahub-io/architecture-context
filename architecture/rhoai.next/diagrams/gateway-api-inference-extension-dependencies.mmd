graph LR
    IGW["Gateway API<br/>Inference Extension"]

    %% External Dependencies (required)
    IGW -->|"ext-proc gRPC<br/>9002/9004 TCP"| Envoy["Envoy Gateway"]
    IGW -->|"metrics scrape<br/>HTTP(S)"| ModelServers["Model Servers<br/>(vLLM, SGLang)"]
    IGW -->|"CRD watch<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    IGW -->|"HTTPRoute backendRef"| GatewayAPI["Gateway API<br/>(sigs.k8s.io/gateway-api)"]

    %% Build Dependencies
    IGW -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    IGW -->|"gRPC framework"| gRPC["google.golang.org/grpc<br/>v1.80.0"]
    IGW -->|"ext-proc protos"| EnvoyCP["go-control-plane<br/>v1.37.0"]
    IGW -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.23.2"]
    IGW -->|"tracing"| OTel["OpenTelemetry<br/>v1.43.0"]
    IGW -->|"CEL expressions"| CEL["cel-go<br/>v0.26.0"]
    IGW -->|"prefix cache"| LRU["golang-lru/v2<br/>v2.0.7"]
    IGW -->|"metrics TTL"| TTLCache["ttlcache/v3<br/>v3.4.0"]
    IGW -->|"cert reload"| Fsnotify["fsnotify<br/>v1.9.0"]

    %% Optional Dependencies
    IGW -.->|"trace export<br/>4317/TCP gRPC"| OTLPCollector["OTLP Collector"]
    IGW -.->|"latency prediction<br/>8001/TCP HTTP"| LatencyPredictor["Latency Predictor<br/>(XGBoost sidecar)"]

    %% Integration Points (consumers)
    Prometheus["Prometheus /<br/>ServiceMonitor"] -->|"scrape 9090/TCP"| IGW

