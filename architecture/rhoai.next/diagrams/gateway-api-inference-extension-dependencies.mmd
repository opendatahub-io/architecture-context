graph LR
    IGW["Gateway API<br/>Inference Extension<br/>(EPP + BBR)"]

    %% Required External Dependencies
    IGW -->|"ext-proc gRPC filter<br/>9002/9004 TCP"| EnvoyGW["Envoy-based Gateway<br/>(Envoy GW / Istio /<br/>GKE GW / kgateway)<br/>Required"]
    IGW -->|"HTTPRoute CRDs<br/>routing rules"| GatewayAPICRDs["Gateway API CRDs<br/>v1<br/>Required"]
    IGW -->|"CRD reconciliation<br/>manager lifecycle"| ControllerRuntime["controller-runtime<br/>v0.23.3<br/>Required"]
    IGW -->|"metrics collection<br/>exposition"| PromClient["Prometheus<br/>client_golang v1.23.2<br/>Required"]
    IGW -->|"ext-proc protocol<br/>definitions"| GoControlPlane["envoy<br/>go-control-plane v1.37.0<br/>Required"]

    %% Required: Model Servers
    IGW -->|"Prometheus /metrics<br/>scraping HTTP/8000"| vLLM["vLLM<br/>Required"]
    IGW -->|"Prometheus /metrics<br/>scraping HTTP/8000"| SGLang["SGLang<br/>Required"]
    IGW -->|"Prometheus /metrics<br/>scraping HTTP/8000"| Triton["Triton TensorRT-LLM<br/>Required"]
    IGW -->|"Prometheus /metrics<br/>scraping HTTP/8000"| TrtllmServe["trtllm-serve<br/>Required"]

    %% Optional External Dependencies
    IGW -.->|"OTLP traces<br/>gRPC/4317"| OTelSDK["OpenTelemetry SDK<br/>v1.43.0<br/>Optional"]
    IGW -.->|"TTFT/TPOT prediction<br/>model training"| XGBoost["XGBoost<br/>Optional"]
    IGW -.->|"alternative prediction<br/>model"| LightGBM["LightGBM<br/>Optional"]
    IGW -.->|"Bayesian Ridge<br/>model training"| ScikitLearn["scikit-learn<br/>Optional"]

    %% Internal Platform Dependencies
    IGW -->|"CRD watch<br/>Pod watch<br/>HTTPS/443"| K8sAPI["Kubernetes API Server"]

    %% Integration Points (incoming)
    Prometheus["Prometheus<br/>ServiceMonitor"] -->|"scrape /metrics<br/>HTTP/9090"| IGW
    OTelCollector["OpenTelemetry<br/>Collector"] -.->|"receive traces<br/>gRPC/4317"| IGW
    llmd["llm-d Inference<br/>Scheduler"] -.->|"plugin integration<br/>disaggregated vLLM"| IGW

    %% Styling
    style IGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style EnvoyGW fill:#999,stroke:#333
    style GatewayAPICRDs fill:#999,stroke:#333
    style ControllerRuntime fill:#999,stroke:#333
    style PromClient fill:#999,stroke:#333
    style GoControlPlane fill:#999,stroke:#333

    %% Model servers
    style vLLM fill:#e8e8e8,stroke:#333
    style SGLang fill:#e8e8e8,stroke:#333
    style Triton fill:#e8e8e8,stroke:#333
    style TrtllmServe fill:#e8e8e8,stroke:#333

    %% Optional
    style OTelSDK fill:#bbb,stroke:#333,stroke-dasharray:5
    style XGBoost fill:#bbb,stroke:#333,stroke-dasharray:5
    style LightGBM fill:#bbb,stroke:#333,stroke-dasharray:5
    style ScikitLearn fill:#bbb,stroke:#333,stroke-dasharray:5

    %% Cluster services
    style K8sAPI fill:#f5a623,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style OTelCollector fill:#7ed321,stroke:#333
    style llmd fill:#7ed321,stroke:#333
