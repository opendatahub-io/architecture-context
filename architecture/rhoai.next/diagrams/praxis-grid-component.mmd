graph TB
    subgraph ControlPlane["Praxis Grid Control Plane"]
        direction TB
        Operator["grid-operator<br/>Rust Kubernetes Operator<br/>Port: 9090/TCP metrics"]
        OverlaySync["overlay-sync<br/>Rust Sidecar<br/>Content-addressed envelope validator"]
        Enrollment["enrollment<br/>Rust REST Service<br/>Certificate signing & identity rotation"]
        FleetDashboard["fleet-dashboard<br/>Rust + React<br/>Fleet-wide visibility UI"]
    end

    subgraph Libraries["Internal Libraries"]
        direction TB
        Scoring["scoring<br/>noMetrics / queueDepth / kvCachePressure"]
        Certs["certs<br/>mTLS provider + SPIFFE verifier"]
        SWIM["swim<br/>SWIM membership via foca"]
        CRDT["crdt<br/>LWW register, OR-Set, G-Counter"]
        Signals["grid-signals<br/>Provider health primitives"]
        SignalsClient["grid-signals-client<br/>mTLS scrape transport"]
    end

    subgraph CRDs["CRDs - grid.praxis.fast/v1alpha1"]
        GridNetwork["GridNetwork CR<br/>Mesh definition, scoring, TLS"]
        GridSite["GridSite CR<br/>Cluster / location identity"]
        InferenceProvider["InferenceProvider CR<br/>Model capacity at a site"]
        AgentToolProvider["AgentToolProvider CR<br/>MCP servers at a site"]
    end

    %% CRD watches
    GridNetwork -->|watched by| Operator
    GridSite -->|watched by| Operator
    InferenceProvider -->|watched by| Operator
    AgentToolProvider -->|watched by| Operator

    %% Library dependencies
    Operator --> Scoring
    Operator --> Certs
    Operator --> SWIM
    Operator --> CRDT
    Operator --> Signals
    Operator --> SignalsClient

    %% Overlay pipeline
    Operator -->|writes routing overlay<br/>ConfigMap| K8sAPI["Kubernetes API"]
    K8sAPI -->|ConfigMap watch| OverlaySync
    OverlaySync -->|atomic file write<br/>emptyDir volume| PraxisGateway["Praxis AI Gateway"]

    %% Cross-site communication
    Operator -->|7946/UDP<br/>AES-256-GCM| PeerOperator["Peer grid-operator<br/>SWIM gossip"]
    Operator -->|9091/TCP<br/>mTLS| PeerSignals["Peer Signals<br/>Provider metrics"]

    %% Enrollment
    Enrollment -->|5432/TCP TLS| PostgreSQL["PostgreSQL"]
    Enrollment -->|signs site certificate| Operator

    %% Fleet dashboard
    FleetDashboard -->|Prometheus queries| PrometheusPerSite["Per-site Prometheus"]

    %% Styling
    style Operator fill:#4a90e2,color:#fff
    style OverlaySync fill:#4a90e2,color:#fff
    style Enrollment fill:#4a90e2,color:#fff
    style FleetDashboard fill:#4a90e2,color:#fff
    style Scoring fill:#b8d4f0
    style Certs fill:#b8d4f0
    style SWIM fill:#b8d4f0
    style CRDT fill:#b8d4f0
    style Signals fill:#b8d4f0
    style SignalsClient fill:#b8d4f0
    style GridNetwork fill:#f5a623
    style GridSite fill:#f5a623
    style InferenceProvider fill:#f5a623
    style AgentToolProvider fill:#f5a623
    style PraxisGateway fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style PeerOperator fill:#e8e8e8
    style PeerSignals fill:#e8e8e8
    style PostgreSQL fill:#e8e8e8
    style PrometheusPerSite fill:#e8e8e8
