graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform-managed)"]
        Route["OpenShift Route<br/>443/TCP → 8443/TCP<br/>TLS 1.2+<br/>OAuth2"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (Single-tenant, per-user)"]
        direction TB
        OAuthProxy["OAuth Proxy Sidecar<br/>8443/TCP HTTPS<br/>OAuth2 enforcement"]
        JupyterLab["JupyterLab Container<br/>8888/TCP HTTP<br/>UID: 1001, GID: 0<br/>PQ Crypto Enabled"]
        CodeServer["Code-Server Container<br/>8787/TCP HTTP<br/>UID: 1001, GID: 0"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Object Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Optional Token"]
    end

    subgraph BuildPipeline["BUILD PIPELINE (Konflux CI)"]
        direction TB
        Cachi2["Cachi2 Prefetch<br/>(network allowed)"]
        HermeticBuild["Dockerfile Build<br/>(HERMETIC - no network)<br/>/cachi2/output/deps/"]
    end

    subgraph BuildServices["BUILD SERVICES"]
        AIPCC["RHEL AI PyPI<br/>packages.redhat.com<br/>443/TCP HTTPS"]
        QuayReg["Quay.io Registry<br/>443/TCP HTTPS"]
    end

    %% Runtime flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth2 token"| OAuthProxy
    OAuthProxy -->|"HTTP/8888<br/>None (localhost)<br/>Trusted"| JupyterLab
    OAuthProxy -->|"HTTP/8787<br/>None (localhost)<br/>Trusted"| CodeServer
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>Access Key"| S3
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>Optional token"| HuggingFace

    %% Build flows
    Cachi2 -->|"HTTPS/443<br/>TLS 1.2+<br/>Build secret"| AIPCC
    Cachi2 -->|"HTTPS/443<br/>TLS 1.2+<br/>Pull secret"| QuayReg
    Cachi2 -->|"local mount"| HermeticBuild
    HermeticBuild -->|"HTTPS/443<br/>TLS 1.2+<br/>Push secret"| QuayReg

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef build fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef buildservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy,JupyterLab,CodeServer workbench
    class S3,HuggingFace externalservice
    class Cachi2,HermeticBuild build
    class AIPCC,QuayReg buildservice
