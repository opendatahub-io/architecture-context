graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["Platform Ingress / Route<br/>443/TCP → 8443/TCP<br/>TLS 1.3<br/>OAuth"]
    end

    subgraph NotebookPod["NOTEBOOK POD BOUNDARY"]
        direction TB

        subgraph JupyterPath["Jupyter Workbench Path"]
            RBACProxy1["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>mTLS + OAuth validation"]
            JupyterLab["JupyterLab Server<br/>8888/TCP HTTP<br/>localhost only<br/>Token disabled"]
        end

        subgraph CodeServerPath["Code-Server Path"]
            RBACProxy2["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>mTLS + OAuth validation"]
            Nginx["nginx Proxy<br/>80/TCP HTTP<br/>localhost only"]
            HTTPD["httpd CGI<br/>8080/TCP HTTP<br/>localhost only<br/>/api/kernels/ (fake)"]
            CodeSrv["code-server IDE<br/>8585/TCP HTTP<br/>localhost only"]
        end
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token"]
        NotebookCtrl["Notebook Controller<br/>Culler: polls /api/kernels/<br/>via kube-rbac-proxy"]
        Operator["ODH/RHOAI Operator<br/>ImageStream deploy"]
        Dashboard["ODH Dashboard<br/>Image discovery"]
    end

    subgraph EgressTargets["EGRESS (Outbound)"]
        DSPA["DSPA Backend<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        PyPI["Package Registries<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No auth"]
        Git["Git Repositories<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>User credentials"]
    end

    subgraph BuildTime["BUILD-TIME ONLY"]
        AIPCC["AIPCC Base Images<br/>quay.io/aipcc/base-images<br/>443/TCP HTTPS<br/>SHA256 digest pinned"]
        RHAI["RHEL AI Python Index<br/>443/TCP HTTPS<br/>Prefetched by Cachi2"]
        Konflux["Konflux / Tekton<br/>Hermetic builds<br/>No network at build"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS 1.3<br/>OAuth"| Gateway

    %% Ingress → Pod (Jupyter path)
    Gateway -->|"HTTPS/8443<br/>mTLS<br/>SA token"| RBACProxy1
    RBACProxy1 -->|"HTTP/8888<br/>localhost<br/>Proxied"| JupyterLab

    %% Ingress → Pod (Code-Server path)
    Gateway -->|"HTTPS/8443<br/>mTLS<br/>SA token"| RBACProxy2
    RBACProxy2 -->|"HTTP/80<br/>localhost<br/>Proxied"| Nginx
    Nginx -->|"HTTP/8080<br/>localhost"| HTTPD
    Nginx -->|"HTTP/8585<br/>localhost"| CodeSrv
    HTTPD -->|"HTTP/8585<br/>healthz check"| CodeSrv

    %% Culler
    NotebookCtrl -->|"HTTPS/8443<br/>mTLS<br/>SA token"| RBACProxy1
    NotebookCtrl -->|"HTTPS/8443<br/>mTLS<br/>SA token"| RBACProxy2

    %% Cluster internal
    Operator -->|"HTTPS/6443<br/>SA token"| K8sAPI
    Dashboard -->|"HTTPS/6443<br/>User OAuth"| K8sAPI
    NotebookCtrl -->|"HTTPS/6443<br/>SA token"| K8sAPI

    %% Egress
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| DSPA
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+"| PyPI
    JupyterLab -->|"HTTPS/443<br/>TLS 1.2+<br/>User creds"| Git

    %% Build-time
    Konflux -->|"Registry pull<br/>SHA256 pinned"| AIPCC
    Konflux -->|"Cachi2 prefetch"| RHAI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef buildtime fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class Gateway ingress
    class RBACProxy1,RBACProxy2,JupyterLab,Nginx,HTTPD,CodeSrv pod
    class K8sAPI,NotebookCtrl,Operator,Dashboard cluster
    class DSPA,PyPI,Git egress
    class AIPCC,RHAI,Konflux buildtime
