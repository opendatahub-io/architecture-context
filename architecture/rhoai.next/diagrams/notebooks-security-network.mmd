graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph Platform["PLATFORM LAYER (OpenShift / ODH)"]
        direction TB
        Dashboard["ODH Dashboard<br/>NS: redhat-ods-applications"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP"]
        Controller["ODH Notebook Controller<br/>NS: redhat-ods-applications"]
        Registry["Container Registry<br/>registry.redhat.io/rhoai/<br/>quay.io/opendatahub/"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (User Namespace)"]
        direction TB
        KRBP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS TLS 1.3<br/>Auth: Bearer Token"]

        subgraph JupyterStack["Jupyter Workbench"]
            JupyterLab["JupyterLab Server<br/>8888/TCP HTTP<br/>Endpoints: /lab, /api/kernels/, /api/status"]
        end

        subgraph CodeServerStack["Code-Server Workbench"]
            CSNginx["nginx<br/>80/TCP HTTP"]
            CSHttpd["httpd CGI<br/>8080/TCP HTTP"]
            CSAccess["access.cgi<br/>(bash CGI)"]
            CSServer["code-server<br/>8888/TCP HTTP"]
        end

        Secrets["Mounted Secrets<br/>DSPA: /opt/app-root/runtimes/<br/>CA: /etc/pki/tls/custom-certs/"]
    end

    subgraph EgressTargets["EGRESS DESTINATIONS"]
        direction TB
        KFP["Kubeflow Pipelines API<br/>443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"]
        S3["S3 Object Storage<br/>443/TCP HTTPS<br/>TLS 1.2+ / AWS IAM"]
        Git["Git Repositories<br/>443/TCP HTTPS<br/>TLS 1.2+ / Bearer Token"]
        MongoDB["MongoDB<br/>27017/TCP<br/>TLS / Username+Password"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS / Username+Password"]
        MySQL["MySQL<br/>3306/TCP<br/>TLS / Username+Password"]
        MLflow["MLflow Tracking<br/>5000/TCP HTTP/S<br/>Bearer Token"]
    end

    subgraph BuildTime["BUILD-TIME (Hermetic)"]
        AIPCC["AIPCC Base Images<br/>RHEL 9.6 EUS<br/>CPU / CUDA / ROCm"]
        Konflux["Konflux / Tekton<br/>Cachi2 Prefetch<br/>check-payload FIPS"]
    end

    %% External → Platform flows
    User -->|"HTTPS/443<br/>TLS 1.3<br/>OpenShift OAuth"| Dashboard
    Dashboard -->|"HTTPS/6443<br/>TLS 1.3<br/>Service Account"| K8sAPI
    K8sAPI -->|"Watch mTLS<br/>Service Account"| Controller
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>Image Pull Secret"| Registry

    %% User → Workbench
    User -->|"HTTPS/8443<br/>TLS 1.3<br/>Bearer Token"| KRBP
    KRBP -->|"HTTP/8888<br/>None (pod-internal)<br/>No Auth"| JupyterLab
    KRBP -->|"HTTP/80<br/>None (pod-internal)<br/>No Auth"| CSNginx
    CSNginx -->|"HTTP/8080<br/>pod-internal"| CSHttpd
    CSHttpd -->|"CGI"| CSAccess
    CSAccess -->|"HTTP/8888<br/>localhost"| CSServer

    %% Controller → Workbench (idle culling)
    Controller -.->|"HTTPS/8443<br/>Bearer Token<br/>Poll /api/kernels/"| KRBP

    %% Egress from workbench
    JupyterLab -->|"HTTPS/443<br/>Bearer Token"| KFP
    JupyterLab -->|"HTTPS/443<br/>AWS IAM"| S3
    JupyterLab -->|"HTTPS/443<br/>Bearer/SSH"| Git
    JupyterLab -->|"TCP/27017<br/>TLS"| MongoDB
    JupyterLab -->|"TCP/5432<br/>TLS"| PostgreSQL
    JupyterLab -->|"TCP/3306<br/>TLS"| MySQL
    JupyterLab -->|"HTTP/5000<br/>Bearer Token"| MLflow

    %% Build-time
    AIPCC -.->|"FROM ${BASE_IMAGE}<br/>HTTPS / Registry Auth"| WorkbenchPod
    Konflux -.->|"Hermetic build<br/>FIPS validation"| WorkbenchPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef buildtime fill:#f5f5f5,stroke:#616161,stroke-width:2px,stroke-dasharray:5 5
    classDef authproxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class Dashboard,K8sAPI,Controller,Registry platform
    class KRBP authproxy
    class JupyterLab,CSNginx,CSHttpd,CSAccess,CSServer,Secrets workbench
    class KFP,S3,Git,MongoDB,PostgreSQL,MySQL,MLflow egress
    class AIPCC,Konflux buildtime
