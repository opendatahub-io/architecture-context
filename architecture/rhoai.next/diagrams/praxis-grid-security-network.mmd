graph TB
    subgraph External["EXTERNAL (Cross-Site — Untrusted)"]
        PeerSWIM["Peer grid-operator<br/>SWIM gossip"]
        PeerSignals["Peer grid-operator<br/>Signals endpoint"]
    end

    subgraph LBServices["KUBERNETES SERVICES (LoadBalancer)"]
        SWIMService["grid-operator-swim<br/>7946/UDP<br/>AES-256-GCM"]
        SignalsService["grid-operator-signals<br/>9091/TCP<br/>mTLS"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (grid-system)"]
        direction TB

        subgraph OperatorPod["grid-operator Pod"]
            Operator["grid-operator<br/>SA: grid-operator<br/>User: 100:101 non-root<br/>seccomp + caps drop<br/>readOnlyRootFilesystem"]
        end

        subgraph GatewayPod["Praxis Gateway Pod"]
            OverlaySync["overlay-sync sidecar<br/>Content-addressed validator"]
            SharedVolume["emptyDir volume<br/>routing-overlay.json"]
            Gateway["Praxis AI Gateway<br/>Hot-reload overlay"]
        end

        MetricsService["grid-operator-metrics<br/>ClusterIP 9090/TCP<br/>HTTP (optional TLS)"]
    end

    subgraph EnrollmentZone["ENROLLMENT (grid-enrollment)"]
        EnrollServer["enrollment server<br/>HTTPS TLS 1.2+<br/>K8s RBAC / Token / mTLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP TLS<br/>Client cert / password"]
        InferenceBackends["Inference Backends<br/>vLLM, llm-d, cloud APIs<br/>HTTP/HTTPS<br/>Bearer / SigV4 / mTLS"]
        MCPServers["MCP Servers<br/>Streamable HTTP<br/>TLS"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA token"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape"]
    end

    %% Cross-site flows
    PeerSWIM -->|"UDP/7946<br/>AES-256-GCM<br/>Shared key"| SWIMService
    PeerSignals -->|"HTTPS/9091<br/>mTLS<br/>Site certificate"| SignalsService
    SWIMService --> Operator
    SignalsService --> Operator

    %% Internal flows
    Operator -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    K8sAPI -->|"ConfigMap watch<br/>TLS<br/>SA token"| OverlaySync
    OverlaySync -->|"Atomic write<br/>File I/O"| SharedVolume
    Gateway -->|"Read overlay<br/>File I/O"| SharedVolume

    %% Operator to external
    Operator -->|"HTTP/HTTPS<br/>TLS<br/>Bearer token"| InferenceBackends
    Operator -->|"HTTP/HTTPS<br/>TLS"| MCPServers

    %% Metrics
    Prometheus -->|"HTTP/9090<br/>Optional TLS"| MetricsService
    MetricsService --> Operator

    %% Enrollment flows
    EnrollServer -->|"TCP/5432<br/>TLS<br/>Client cert"| PostgreSQL
    EnrollServer -.->|"Signs site cert"| Operator

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef lb fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef enrollment fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class PeerSWIM,PeerSignals external
    class SWIMService,SignalsService lb
    class Operator,OverlaySync,SharedVolume,Gateway,MetricsService internal
    class EnrollServer enrollment
    class PostgreSQL,InferenceBackends,MCPServers,K8sAPI,Prometheus externalservice
