graph TD
    subgraph ServiceAccounts["Service Accounts"]
        AgentSA["&lt;agent&gt; ServiceAccount<br/>(per Helm release)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        AuthDelegatorCRB["&lt;agent&gt;-&lt;nshash&gt;-auth-delegator<br/>ClusterRoleBinding<br/>(created when auth.enabled=true)"]
    end

    subgraph ClusterRoles["ClusterRole"]
        AuthDelegator["system:auth-delegator<br/>(built-in ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
    end

    subgraph AuthMiddleware["Auth Middleware Flow"]
        SATokenAuth["SATokenAuthMiddleware<br/>(ASGI Middleware)"]
        AuthConfig["Configuration:<br/>AUTH_ENABLED=true<br/>AUTH_AUDIENCE=&lt;audience&gt;<br/>AUTH_EXCLUDE_PATHS=/health<br/>AUTH_ALLOWED_SERVICEACCOUNTS=ns:sa"]
    end

    subgraph ProtectedEndpoints["Protected Endpoints"]
        ChatEndpoint["/chat/completions<br/>/v1/chat/completions<br/>POST 8080/TCP"]
        HealthEndpoint["/health<br/>GET 8080/TCP<br/>(EXCLUDED from auth)"]
    end

    %% RBAC bindings
    AgentSA -->|"bound via"| AuthDelegatorCRB
    AuthDelegatorCRB -->|"grants"| AuthDelegator
    AuthDelegator -->|"create"| TokenReviews

    %% Auth middleware flow
    SATokenAuth -->|"calls"| TokenReviews
    AuthConfig -.->|"configures"| SATokenAuth
    SATokenAuth -->|"protects"| ChatEndpoint
    SATokenAuth -->|"excludes"| HealthEndpoint

    %% Styling
    style AgentSA fill:#4a90e2,stroke:#333,color:#fff
    style AuthDelegatorCRB fill:#dae8fc,stroke:#6c8ebf
    style AuthDelegator fill:#f5a623,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SATokenAuth fill:#4a90e2,stroke:#333,color:#fff
    style AuthConfig fill:#f9f9f9,stroke:#999
    style ChatEndpoint fill:#ffe6cc,stroke:#d79b00
    style HealthEndpoint fill:#d5e8d4,stroke:#82b366
