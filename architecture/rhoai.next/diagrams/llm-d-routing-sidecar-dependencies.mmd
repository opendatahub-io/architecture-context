graph LR
    Sidecar["llm-d-routing-sidecar<br/>(Go HTTP/HTTPS Reverse Proxy)"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>HTTP/HTTPS 8001/TCP"| Decoder["vLLM Decoder<br/>(local, co-located)"]
    Sidecar -->|"reverse proxy<br/>HTTP/HTTPS header-port"| Prefiller["vLLM Prefiller<br/>(remote pods)"]
    Sidecar -->|"CRD Watch<br/>dynamic informer"| InferencePool["InferencePool CR<br/>(inference.networking.x-k8s.io/v1alpha2)"]
    Sidecar -->|"Pod Watch<br/>dynamic informer"| PodAPI["Kubernetes Pod API<br/>(v1)"]

    %% External Dependencies (Build/Runtime)
    Sidecar -->|"Kubernetes client"| ClientGo["k8s.io/client-go<br/>v0.31.3 (optional)"]
    Sidecar -->|"K8s object types"| Apimachinery["k8s.io/apimachinery<br/>v0.31.3 (optional)"]
    Sidecar -->|"handler caching"| LRU["golang-lru/v2<br/>v2.0.7"]
    Sidecar -->|"structured logging"| Logr["go-logr/logr<br/>v1.4.2"]
    Sidecar -->|"request correlation"| UUID["google/uuid<br/>v1.6.0"]

    %% Architectural Dependencies
    GatewayAPI["Gateway API<br/>Inference Extension"] -.->|"defines CRD"| InferencePool

    %% Infrastructure
    OpenShiftRoute["OpenShift Router"] -->|"ingress<br/>443/TCP edge TLS"| Sidecar
    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"] -->|"serves watches"| ClientGo

