    Sidecar -->|"structured logging"| Logr["go-logr/logr<br/>v1.4.2"]
    Sidecar -->|"request correlation"| UUID["google/uuid<br/>v1.6.0"]
    Sidecar -->|"proxy handler cache"| LRU["golang-lru/v2<br/>v2.0.7"]
    Sidecar -->|"set data structure"| K8sUtils["k8s.io/utils"]

    %% Infrastructure Dependencies
    Sidecar -->|"API server"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Sidecar -->|"TLS edge"| Route["OpenShift Route<br/>443/TCP"]

