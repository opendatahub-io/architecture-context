graph LR
    Sidecar["llm-d-routing-sidecar<br/>Go Sidecar Service"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>HTTP(S)/8001"| Decoder["vLLM Decoder<br/>(co-located)"]
    Sidecar -->|"reverse proxy<br/>HTTP(S)/per-header"| Prefiller["vLLM Prefiller<br/>(remote)"]
