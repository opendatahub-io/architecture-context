graph LR
    Sidecar["llm-d-routing-sidecar<br/>(Sidecar Proxy)"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>HTTP(S)/8001"| Decoder["vLLM Decoder<br/>(co-located)"]
    Sidecar -->|"prefill requests<br/>HTTP(S)/dynamic"| Prefiller["vLLM Prefiller<br/>(remote pods)"]
    Sidecar -->|"CRD watch<br/>read-only"| InferencePool["InferencePool CR<br/>(Gateway API<br/>Inference Extension)"]
    Sidecar -->|"pod IP watch<br/>read-only"| Pods["Kubernetes Pods<br/>(matching selector)"]

    %% Integration Points (inbound)
    EPP["Gateway API<br/>Inference Extension<br/>(EPP)"] -->|"x-prefiller-host-port<br/>header convention"| Sidecar

    %% External Dependencies (libraries)
    Sidecar -.->|"K8s client"| ClientGo["k8s.io/client-go<br/>v0.31.3"]
    Sidecar -.->|"LRU cache (16)"| LRU["golang-lru/v2<br/>v2.0.7"]
    Sidecar -.->|"request IDs"| UUID["google/uuid<br/>v1.6.0"]

    %% External Services
    Sidecar -->|"watch API<br/>HTTPS/443"| K8sAPI["Kubernetes<br/>API Server"]

    %% Build Pipeline
    Konflux["Konflux / Tekton"] -->|"builds image<br/>Dockerfile.konflux"| Sidecar

    style Sidecar fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Decoder fill:#7ed321,stroke:#333,color:#fff
    style Prefiller fill:#7ed321,stroke:#333,color:#fff
    style InferencePool fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style ClientGo fill:#e8e8e8,stroke:#333
    style LRU fill:#e8e8e8,stroke:#333
    style UUID fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style Konflux fill:#f5a623,stroke:#333,color:#fff
