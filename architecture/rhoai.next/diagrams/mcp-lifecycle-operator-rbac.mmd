graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mcp-lifecycle-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["mcp-lifecycle-operator-<br/>manager-rolebinding"]
        CRB2["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (namespaced)"]
        RB1["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["mcp-lifecycle-operator-<br/>manager-role"]
        CR2["mcp-lifecycle-operator-<br/>metrics-auth-role"]
        CR3["mcp-lifecycle-operator-<br/>metrics-reader"]
    end

    subgraph Roles["Roles (namespaced)"]
        R1["mcp-lifecycle-operator-<br/>leader-election-role"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles<br/>(auto-inherited by built-in roles)"]
        AGG1["mcpserver-admin-role<br/>(aggregate-to-admin)"]
        AGG2["mcpserver-editor-role<br/>(aggregate-to-edit)"]
        AGG3["mcpserver-viewer-role<br/>(aggregate-to-view)"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        CoreRead["(core) configmaps, namespaces,<br/>pods, secrets<br/>get, list, watch"]
        CoreSvc["(core) services<br/>create, get, list, update, watch"]
        Events["events.k8s.io events<br/>create, patch"]
        Deployments["apps deployments<br/>create, get, list, update, watch"]
        Gateways["gateway.networking.k8s.io<br/>gateways<br/>get, list, watch"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes<br/>create, delete, get, list,<br/>update, watch"]
        KuadrantExt["mcp.kuadrant.io<br/>mcpgatewayextensions<br/>get, list, watch"]
        KuadrantReg["mcp.kuadrant.io<br/>mcpserverregistrations<br/>create, delete, get, list,<br/>update, watch"]
        MCPBindings["mcp.x-k8s.io<br/>mcpgatewaybindings<br/>create, delete, get, list,<br/>update, watch"]
        MCPServers["mcp.x-k8s.io<br/>mcpservers<br/>get, list, patch, update, watch"]
        NetPolicies["networking.k8s.io<br/>networkpolicies<br/>create, get, list, update, watch"]
    end

    subgraph MetricsResources["Metrics Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph MetricsReaderResources["Metrics Reader Resources"]
        MetricsURL["/metrics<br/>get"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    SA -->|"bound via"| RB1

    CRB1 -->|"grants"| CR1
    CRB2 -->|"grants"| CR2
    RB1 -->|"grants"| R1

    %% Manager role permissions
    CR1 -->|"permits"| CoreRead
    CR1 -->|"permits"| CoreSvc
    CR1 -->|"permits"| Events
    CR1 -->|"permits"| Deployments
    CR1 -->|"permits"| Gateways
    CR1 -->|"permits"| HTTPRoutes
    CR1 -->|"permits"| KuadrantExt
    CR1 -->|"permits"| KuadrantReg
    CR1 -->|"permits"| MCPBindings
    CR1 -->|"permits"| MCPServers
    CR1 -->|"permits"| NetPolicies

    %% Metrics auth permissions
    CR2 -->|"permits"| TokenReview
    CR2 -->|"permits"| SAR

    %% Metrics reader
    CR3 -->|"permits"| MetricsURL

