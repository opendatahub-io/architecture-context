graph TD
    subgraph "Service Accounts"
        SA["controller-manager<br/>(mcp-lifecycle-operator-system)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["manager-rolebinding<br/>(cluster-wide)"]
        RB_Leader["leader-election-rolebinding<br/>(namespace-scoped)"]
    end

    subgraph "Cluster Roles"
        CR_Manager["manager-role<br/>(ClusterRole)"]
        CR_MetricsAuth["metrics-auth-role<br/>(ClusterRole)"]
        CR_MetricsReader["metrics-reader-role<br/>(ClusterRole)"]
        R_Leader["leader-election-role<br/>(Role - namespace-scoped)"]
    end

    subgraph "MCPServer Resources (mcp.x-k8s.io)"
        MCPServers["mcpservers<br/>get, list, watch, update, patch"]
        MCPStatus["mcpservers/status<br/>get, update, patch"]
        MCPFinalizers["mcpservers/finalizers<br/>update"]
    end

    subgraph "Kubernetes Core Resources"
        Deployments["apps/deployments<br/>get, list, watch, create, update"]
        Services["core/services<br/>get, list, watch, create, update"]
        ConfigMaps["core/configmaps<br/>get, list, watch"]
        Secrets["core/secrets<br/>get, list, watch"]
        Pods["core/pods<br/>get, list"]
        NetworkPolicies["networking.k8s.io/networkpolicies<br/>get, list, watch, create, update"]
        Events["core+events.k8s.io/events<br/>create, patch"]
    end

    subgraph "Leader Election Resources"
        LE_ConfigMaps["core/configmaps<br/>get, list, watch, create,<br/>update, patch, delete"]
        LE_Leases["coordination.k8s.io/leases<br/>get, list, watch, create,<br/>update, patch, delete"]
        LE_Events["core/events<br/>create, patch"]
    end

    subgraph "Metrics Auth Resources"
        TokenReviews["authentication.k8s.io/tokenreviews<br/>create"]
        SAR["authorization.k8s.io/subjectaccessreviews<br/>create"]
    end

    subgraph "Non-Resource URLs"
        MetricsURL["/metrics<br/>get"]
    end

    subgraph "User-Facing Roles"
        AdminRole["mcpserver-admin-role<br/>mcpservers: full CRUD"]
        EditorRole["mcpserver-editor-role<br/>mcpservers: full CRUD"]
        ViewerRole["mcpserver-viewer-role<br/>mcpservers: get, list, watch"]
    end

    %% Bindings
    SA -->|"bound via"| CRB_Manager
    SA -->|"bound via"| RB_Leader

    CRB_Manager -->|"grants"| CR_Manager
    RB_Leader -->|"grants"| R_Leader

    %% Manager role permissions
    CR_Manager -->|"manages"| MCPServers
    CR_Manager -->|"manages"| MCPStatus
    CR_Manager -->|"manages"| MCPFinalizers
    CR_Manager -->|"manages"| Deployments
    CR_Manager -->|"manages"| Services
    CR_Manager -->|"reads"| ConfigMaps
    CR_Manager -->|"reads"| Secrets
    CR_Manager -->|"reads"| Pods
    CR_Manager -->|"manages"| NetworkPolicies
    CR_Manager -->|"writes"| Events

    %% Leader election permissions
    R_Leader -->|"manages"| LE_ConfigMaps
    R_Leader -->|"manages"| LE_Leases
    R_Leader -->|"writes"| LE_Events

    %% Metrics auth permissions
    CR_MetricsAuth -->|"validates"| TokenReviews
    CR_MetricsAuth -->|"validates"| SAR

    %% Metrics reader
    CR_MetricsReader -->|"reads"| MetricsURL

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333,color:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333,color:#333
    style R_Leader fill:#f5a623,stroke:#333,color:#333
    style MCPServers fill:#7ed321,stroke:#333,color:#333
    style MCPStatus fill:#7ed321,stroke:#333,color:#333
    style MCPFinalizers fill:#7ed321,stroke:#333,color:#333
    style Deployments fill:#7ed321,stroke:#333,color:#333
    style Services fill:#7ed321,stroke:#333,color:#333
    style ConfigMaps fill:#7ed321,stroke:#333,color:#333
    style Secrets fill:#7ed321,stroke:#333,color:#333
    style Pods fill:#7ed321,stroke:#333,color:#333
    style NetworkPolicies fill:#7ed321,stroke:#333,color:#333
    style Events fill:#7ed321,stroke:#333,color:#333
    style AdminRole fill:#dce6f1,stroke:#4a90e2,color:#333
    style EditorRole fill:#dce6f1,stroke:#4a90e2,color:#333
    style ViewerRole fill:#dce6f1,stroke:#4a90e2,color:#333
