graph TD
    subgraph "Service Account"
        SA["controller-manager<br/>(mcp-lifecycle-operator-system)"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB2["metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph "Role Binding (namespace-scoped)"
        RB1["leader-election-rolebinding<br/>(RoleBinding)"]
    end

    subgraph "ClusterRole: manager-role"
        CR_MCP["mcp.x-k8s.io<br/>mcpservers<br/>mcpservers/status<br/>mcpservers/finalizers"]
        CR_Apps["apps<br/>deployments"]
        CR_Core["core<br/>services<br/>configmaps, secrets<br/>pods"]
        CR_Net["networking.k8s.io<br/>networkpolicies"]
        CR_Events["core, events.k8s.io<br/>events"]
    end

    subgraph "Role: leader-election-role"
        LR_CM["core<br/>configmaps"]
        LR_Leases["coordination.k8s.io<br/>leases"]
        LR_Events["core<br/>events"]
    end

    subgraph "ClusterRole: metrics-auth-role"
        MA_Token["authentication.k8s.io<br/>tokenreviews"]
        MA_SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    SA -->|"bound via"| RB1

    CRB1 -->|"grants"| CR_MCP
    CRB1 -->|"grants"| CR_Apps
    CRB1 -->|"grants"| CR_Core
    CRB1 -->|"grants"| CR_Net
    CRB1 -->|"grants"| CR_Events

    RB1 -->|"grants"| LR_CM
    RB1 -->|"grants"| LR_Leases
    RB1 -->|"grants"| LR_Events

    CRB2 -->|"grants"| MA_Token
    CRB2 -->|"grants"| MA_SAR

    %% Verb annotations
    CR_MCP -.-|"get, list, watch,<br/>update, patch"| MCP_Verbs[" "]
    CR_Apps -.-|"get, list, watch,<br/>create, update"| Apps_Verbs[" "]
    CR_Core -.-|"get, list, watch<br/>(+ create, update for services)"| Core_Verbs[" "]
    CR_Net -.-|"get, list, watch,<br/>create, update"| Net_Verbs[" "]
    CR_Events -.-|"create, patch"| Events_Verbs[" "]
    LR_CM -.-|"full CRUD"| LR_CM_Verbs[" "]
    LR_Leases -.-|"full CRUD"| LR_Leases_Verbs[" "]
    MA_Token -.-|"create"| MA_Token_Verbs[" "]
    MA_SAR -.-|"create"| MA_SAR_Verbs[" "]

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB1 fill:#b8d4f0,stroke:#333
    style CRB2 fill:#b8d4f0,stroke:#333
    style RB1 fill:#b8d4f0,stroke:#333
    style CR_MCP fill:#f5a623,stroke:#333
    style CR_Apps fill:#f5a623,stroke:#333
    style CR_Core fill:#f5a623,stroke:#333
    style CR_Net fill:#f5a623,stroke:#333
    style CR_Events fill:#f5a623,stroke:#333
    style LR_CM fill:#ffd700,stroke:#333
    style LR_Leases fill:#ffd700,stroke:#333
    style LR_Events fill:#ffd700,stroke:#333
    style MA_Token fill:#ff9999,stroke:#333
    style MA_SAR fill:#ff9999,stroke:#333
    style MCP_Verbs fill:none,stroke:none
    style Apps_Verbs fill:none,stroke:none
    style Core_Verbs fill:none,stroke:none
    style Net_Verbs fill:none,stroke:none
    style Events_Verbs fill:none,stroke:none
    style LR_CM_Verbs fill:none,stroke:none
    style LR_Leases_Verbs fill:none,stroke:none
    style MA_Token_Verbs fill:none,stroke:none
    style MA_SAR_Verbs fill:none,stroke:none
