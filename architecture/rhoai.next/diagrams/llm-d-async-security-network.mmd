graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Producer["Producer Client<br/>(Go library)"]
    end

    subgraph MessageBrokers["MESSAGE BROKERS (Shared Infrastructure)"]
        direction LR
        Redis["Redis / Valkey<br/>6379/TCP<br/>Redis protocol<br/>Optional TLS (rediss://)<br/>Auth: Password in URL"]
        GCPPubSub["GCP Pub/Sub<br/>443/TCP<br/>gRPC/HTTPS<br/>TLS 1.2+<br/>Auth: GCP ADC"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Pod Network)"]
        subgraph PodSecurity["Pod Security Context"]
            direction TB
            AP["Async Processor Pod<br/>SA: async-processor<br/>runAsNonRoot: true<br/>readOnlyRootFS: true<br/>capabilities: drop ALL"]
        end

        subgraph InboundPorts["Inbound Ports (pod-level, no Service)"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>No auth"]
            MetricsPort["Prometheus Metrics<br/>9090/TCP HTTP<br/>No encryption<br/>Optional auth"]
        end

        AP --- Health
        AP --- MetricsPort
    end

    subgraph EgressTargets["EGRESS DESTINATIONS"]
        direction TB
        IGW["llm-d-router / IGW<br/>Configurable port<br/>HTTP/HTTPS<br/>Optional TLS 1.2+<br/>Optional mTLS certs"]
        Prometheus["Prometheus<br/>9090/TCP HTTP<br/>No encryption<br/>No auth"]
        VLLMMetrics["vLLM/EPP /metrics<br/>Configurable port<br/>HTTP<br/>No encryption"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>Optional TLS"]
        GCPMonitoring["GCP Cloud Monitoring<br/>443/TCP gRPC<br/>TLS 1.2+<br/>GCP ADC"]
    end

    %% Producer to brokers
    Producer -->|"Redis protocol/6379<br/>Optional TLS<br/>Password auth"| Redis
    Producer -->|"gRPC/443<br/>TLS 1.2+<br/>GCP ADC"| GCPPubSub

    %% Brokers to processor
    Redis -->|"ZPOPMIN, BRPOP<br/>Redis protocol/6379<br/>Optional TLS<br/>Password auth"| AP
    GCPPubSub -->|"Subscriber.Receive<br/>gRPC/443<br/>TLS 1.2+<br/>GCP ADC"| AP

    %% Processor egress
    AP -->|"POST /v1/completions<br/>HTTP(S)/configurable<br/>Optional TLS 1.2+<br/>Optional mTLS"| IGW
    AP -->|"PromQL queries<br/>HTTP/9090<br/>No encryption"| Prometheus
    AP -->|"Metric scrape<br/>HTTP/configurable<br/>No encryption"| VLLMMetrics
    AP -->|"Trace export<br/>gRPC/4317<br/>Optional TLS"| OTLP
    AP -->|"Backlog query<br/>gRPC/443<br/>TLS 1.2+<br/>GCP ADC"| GCPMonitoring

    %% Result paths
    AP -->|"LPUSH results<br/>Redis/6379<br/>Optional TLS"| Redis
    AP -->|"Publish results<br/>gRPC/443<br/>TLS 1.2+"| GCPPubSub

    %% Monitoring inbound
    PodMon["PodMonitor<br/>(Prometheus Operator)"] -->|"Scrape /metrics<br/>HTTP/9090"| MetricsPort
    Kubelet["kubelet"] -->|"POST /healthz /readyz<br/>HTTP/8081"| Health

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef broker fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f5f5f5,stroke:#666,stroke-dasharray: 5 5

    class Producer external
    class Redis,GCPPubSub broker
    class AP,Health,MetricsPort internal
    class IGW,Prometheus,VLLMMetrics,OTLP,GCPMonitoring egress
    class PodMon,Kubelet monitoring
