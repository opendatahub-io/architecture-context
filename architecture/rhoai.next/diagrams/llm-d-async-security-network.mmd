graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes Namespace)"]
        direction TB

        subgraph Pod["Async Processor Pod<br/>SA: release-llm-d-async<br/>readOnlyRootFilesystem | runAsNonRoot | drop ALL"]
            HealthSvr["Health Server<br/>8081/TCP HTTP<br/>No auth (kubelet)"]
            MetricsSvr["Metrics Server<br/>9090/TCP HTTP<br/>Optional kube-rbac-proxy"]
            Processor["Dispatch Engine<br/>Gate Pipeline + Workers"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        Prometheus["Prometheus<br/>9090/TCP HTTP<br/>No encryption"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        Router["llm-d-router<br/>configurable port<br/>HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS"]
        OTLPCollector["OTLP Collector<br/>4317/TCP gRPC<br/>Optional TLS"]
        PromOperator["Prometheus Operator<br/>PodMonitor + PrometheusRule"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>Redis protocol<br/>Optional TLS<br/>URL credentials"]
        GCPPubSub["GCP Pub/Sub<br/>443/TCP gRPC<br/>TLS 1.2+<br/>GCP IAM"]
        GCPMonitoring["GCP Cloud Monitoring<br/>443/TCP gRPC<br/>TLS 1.2+<br/>GCP IAM"]
    end

    %% Pod-local access
    Kubelet["Kubelet"] -->|HTTP/8081<br/>No auth| HealthSvr
    PromOperator -->|HTTP/9090<br/>Optional auth| MetricsSvr

    %% Egress: Platform
    Processor -->|HTTP or HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>Client cert| Router
    Processor -->|HTTP/9090<br/>No encryption<br/>No auth| Prometheus
    MetricsSvr -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token| K8sAPI
    Processor -->|gRPC/4317<br/>Optional TLS| OTLPCollector

    %% Egress: External
    Processor -->|Redis/6379<br/>Optional TLS<br/>URL creds| Redis
    Processor -->|gRPC/443<br/>TLS 1.2+<br/>GCP IAM| GCPPubSub
    Processor -->|gRPC/443<br/>TLS 1.2+<br/>GCP IAM| GCPMonitoring

    %% Styling
    classDef cluster fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef pod fill:#bbdefb,stroke:#1565c0,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef kubelet fill:#f9f9f9,stroke:#999,stroke-width:1px

    class HealthSvr,MetricsSvr,Processor pod
    class Prometheus,K8sAPI,Router,OTLPCollector,PromOperator platform
    class Redis,GCPPubSub,GCPMonitoring external
    class Kubelet kubelet
