graph TD
    subgraph ServiceAccounts["Service Accounts"]
        APISA["{release}-apiserver-sa"]
        ProcSA["{release}-processor-sa"]
        GCSA["{release}-gc-sa"]
    end

    subgraph RoleBindings["Role Bindings"]
        GCRB["{release}-gc-pod-watcher<br/>RoleBinding"]
    end

    subgraph Roles["Namespace-Scoped Roles"]
        GCRole["{release}-gc-pod-watcher<br/>Role"]
    end

    subgraph APIResources["API Resources"]
        Pods["core<br/>pods"]
        StatefulSets["apps<br/>statefulsets"]
    end

    subgraph NoRBAC["No RBAC Required"]
        APINote["apiserver-sa: No Kubernetes<br/>API access needed"]
        ProcNote["processor-sa: No Kubernetes<br/>API access needed"]
    end

    %% GC RBAC chain
    GCSA -->|"bound via"| GCRB
    GCRB -->|"grants"| GCRole
    GCRole -->|"get, list, watch"| Pods
    GCRole -->|"get, list, watch"| StatefulSets

    %% No RBAC for other SAs
    APISA -.->|"no bindings"| APINote
    ProcSA -.->|"no bindings"| ProcNote

    subgraph Secrets["Secrets Access"]
        BGSecret["batch-gateway-secrets<br/>(Opaque)<br/>PostgreSQL URL, Redis URL,<br/>Inference API key, S3 key"]
        TLSSecret["{release}-apiserver-tls<br/>(kubernetes.io/tls)<br/>cert-manager managed"]
    end

    %% Secret access (via env/volume mounts, not RBAC)
    APISA -.->|"env mount"| BGSecret
    APISA -.->|"volume mount<br/>(when TLS enabled)"| TLSSecret
    ProcSA -.->|"env mount"| BGSecret
    GCSA -.->|"env mount"| BGSecret

    subgraph Condition["Conditional"]
        CondNote["GC Role + RoleBinding only created<br/>when gc.config.reconciler.enabled = true"]
    end

    style GCSA fill:#4a90e2
    style APISA fill:#4a90e2
    style ProcSA fill:#4a90e2
    style GCRole fill:#f5a623
    style GCRB fill:#f5a623
    style Pods fill:#7ed321
    style StatefulSets fill:#7ed321
    style BGSecret fill:#e74c3c,color:#fff
    style TLSSecret fill:#e74c3c,color:#fff
    style CondNote fill:#fff3cd,stroke:#856404
