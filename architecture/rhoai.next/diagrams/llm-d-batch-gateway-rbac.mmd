graph TD
    subgraph PodSecurity["Pod Security Context (all components)"]
        direction TB
        SecurityCtx["SecurityContext<br/>runAsUser: 65532 (nonroot)<br/>readOnlyRootFilesystem: true<br/>allowPrivilegeEscalation: false<br/>capabilities: ALL dropped<br/>seccompProfile: RuntimeDefault"]
    end

    subgraph ServiceAccounts["Service Accounts (Helm-created)"]
        SA_API["SA: {release}-apiserver"]
        SA_Proc["SA: {release}-processor"]
        SA_GC["SA: {release}-gc"]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB
        GatewayAuth["Kuadrant / Authorino<br/>(Gateway-level enforcement)"]
        TenantHeader["Tenant Extraction<br/>Header: X-MaaS-Username<br/>Method: LastHeaderValue()"]
        AuthMethods["Supported Auth Methods<br/>• API key<br/>• ServiceAccount token<br/>• OpenShift user token"]
    end

    subgraph TenantIsolation["Tenant Isolation (Application-Level)"]
        direction TB
        DBIsolation["PostgreSQL<br/>All queries filter by TenantID<br/>Cross-tenant → 404 (hides existence)"]
        FileIsolation["S3 Storage<br/>Tenant folders: t-SHA256(tenantID)<br/>Shared bucket, path-based isolation"]
        RedisIsolation["Redis/Valkey<br/>Tenant context in job metadata<br/>No Redis-level isolation primitive"]
    end

    subgraph Secrets["Secrets"]
        direction TB
        SecretMain["batch-gateway-secrets (Opaque)<br/>• Redis URL<br/>• PostgreSQL URL<br/>• S3 secret key<br/>• Inference API key<br/>Provisioned: Manual<br/>Auto-rotate: No"]
        SecretTLS["{release}-apiserver-tls (kubernetes.io/tls)<br/>• TLS certificate<br/>• TLS private key<br/>Provisioned: cert-manager or manual<br/>Auto-rotate: Yes (cert-manager)"]
    end

    subgraph Endpoints["Endpoint Authorization"]
        direction TB
        ProtectedEndpoints["/v1/batches/* — Delegated auth<br/>/v1/files/* — Delegated auth"]
        OpenEndpoints["/health, /ready, /metrics<br/>No auth (observability ports)"]
    end

    %% Flows
    AuthMethods -->|"validated by"| GatewayAuth
    GatewayAuth -->|"extracts"| TenantHeader
    TenantHeader -->|"enforced at"| DBIsolation
    TenantHeader -->|"enforced at"| FileIsolation
    TenantHeader -->|"enforced at"| RedisIsolation

    SA_API -->|"uses"| SecretMain
    SA_API -->|"uses"| SecretTLS
    SA_Proc -->|"uses"| SecretMain
    SA_GC -->|"uses"| SecretMain

    GatewayAuth -->|"protects"| ProtectedEndpoints
    OpenEndpoints -.->|"no auth required"| SecurityCtx

    %% Note: No Kubernetes RBAC
    NoRBAC["Note: No Kubernetes RBAC<br/>Components do not interact<br/>with Kubernetes API.<br/>No Roles/RoleBindings defined."]

    style PodSecurity fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style AuthModel fill:#e6ccff,stroke:#7c3aed,stroke-width:2px
    style TenantIsolation fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Endpoints fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style ServiceAccounts fill:#f0f0f0,stroke:#666,stroke-width:1px
    style NoRBAC fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    style SecurityCtx fill:#b6d7a8
    style GatewayAuth fill:#b4a7d6
    style DBIsolation fill:#a4c2f4
    style FileIsolation fill:#a4c2f4
    style SecretMain fill:#ffe599
    style SecretTLS fill:#ffe599
