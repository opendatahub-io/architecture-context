graph TB
    subgraph "fms-hf-tuning Component"
        direction TB
        Entrypoint["accelerate_launch.py<br/>(Container Entrypoint)"]
        SFTTrainer["sft_trainer.py<br/>(Training Module)"]
        TrainerController["trainercontroller<br/>(Training Loop Control)"]
        Trackers["trackers<br/>(Experiment Tracking)"]
        DataSubsystem["data<br/>(Data Processing)"]
        ConfigModule["config<br/>(ModelArgs, DataArgs,<br/>TrainingArgs, PEFTConfig)"]

        Entrypoint -->|"reads JSON config<br/>constructs accelerate args"| SFTTrainer
        SFTTrainer -->|"initializes"| TrainerController
        SFTTrainer -->|"initializes"| Trackers
        SFTTrainer -->|"loads & preprocesses"| DataSubsystem
        SFTTrainer -->|"reads"| ConfigModule
        TrainerController -->|"policy-driven<br/>early stopping"| SFTTrainer
    end

    subgraph "Acceleration Plugins (Optional)"
        direction TB
        AccelCore["fms-acceleration<br/>(Core Framework)"]
        AccelPEFT["fms-acceleration-peft<br/>(Quantized LoRA)"]
        AccelFOAK["fms-acceleration-foak<br/>(Fused LoRA Kernels)"]
        AccelAADP["fms-acceleration-aadp<br/>(Padding-Free Attention)"]
        AccelMoE["fms-acceleration-moe<br/>(ScatterMoE)"]
        AccelODM["fms-acceleration-odm<br/>(Online Data Mixing)"]
    end

    Config["SFT_TRAINER_CONFIG_JSON_PATH<br/>(JSON Config File)"] -->|"read at startup"| Entrypoint
    EnvVar["SFT_TRAINER_CONFIG_JSON_ENV_VAR<br/>(Base64 Config)"] -->|"alternative config"| Entrypoint

    SFTTrainer -->|"dynamic plugin loading"| AccelCore
    AccelCore --> AccelPEFT
    AccelCore --> AccelFOAK
    AccelCore --> AccelAADP
    AccelCore --> AccelMoE
    AccelCore --> AccelODM

    TrainingOperator["Training Operator<br/>(codeflare/kubeflow)"] -->|"launches container"| Entrypoint

    SFTTrainer -->|"downloads models"| HFHub["Hugging Face Hub"]
    SFTTrainer -->|"CUDA/FSDP"| GPU["GPU (CUDA)"]
    SFTTrainer -->|"saves model"| OutputDir["Local Filesystem<br/>(output_dir)"]
    Entrypoint -->|"writes errors"| TermLog["/dev/termination-log"]

    Trackers -->|"optional"| AimServer["Aim Server"]
    Trackers -->|"optional"| MLflowServer["MLflow Server"]
    Trackers -->|"optional"| ClearMLServer["ClearML"]
    Trackers -->|"file logging"| FileLog["File Logger"]

    style Entrypoint fill:#4a90e2,stroke:#333,color:#fff
    style SFTTrainer fill:#4a90e2,stroke:#333,color:#fff
    style TrainerController fill:#4a90e2,stroke:#333,color:#fff
    style Trackers fill:#4a90e2,stroke:#333,color:#fff
    style DataSubsystem fill:#4a90e2,stroke:#333,color:#fff
    style ConfigModule fill:#4a90e2,stroke:#333,color:#fff
    style AccelCore fill:#7ed321,stroke:#333
    style AccelPEFT fill:#7ed321,stroke:#333
    style AccelFOAK fill:#7ed321,stroke:#333
    style AccelAADP fill:#7ed321,stroke:#333
    style AccelMoE fill:#7ed321,stroke:#333
    style AccelODM fill:#7ed321,stroke:#333
    style Config fill:#f5a623,stroke:#333
    style EnvVar fill:#f5a623,stroke:#333
    style TrainingOperator fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style GPU fill:#e8e8e8,stroke:#333
    style OutputDir fill:#e8e8e8,stroke:#333
    style TermLog fill:#e8e8e8,stroke:#333
