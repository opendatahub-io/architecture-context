graph TB
    subgraph External["External Orchestration"]
        KFTOOperator["Kubeflow Training Operator<br/>(creates PyTorchJob pods)"]
        Kueue["Kueue<br/>(queue management)"]
    end

    subgraph PyTorchJobPod["PyTorchJob Pod (fms-hf-tuning container)"]
        direction TB

        subgraph EntryPoint["Entry Point Layer"]
            AccelLaunch["accelerate_launch.py<br/>(container entry point)"]
            ConfigLoader["get_json_config()<br/>JSON file or base64 env var"]
        end

        subgraph Core["Core Training Layer"]
            SFTTrainer["tuning.sft_trainer<br/>(training orchestrator)"]
            SumLossTrainer["SumLossSFTTrainer<br/>(experimental sum loss)"]
        end

        subgraph DataLayer["Data Preprocessing Layer"]
            DataPipeline["tuning.data<br/>(data preprocessing)"]
            DataHandlers["DataHandler plugins<br/>(map, filter, remove, select)"]
            ChatTemplates["Chat / Jinja2 Templates"]
            VisionData["Vision Multimodal Data"]
        end

        subgraph ConfigLayer["Configuration Layer"]
            Config["tuning.config<br/>(model, data, training args)"]
            PEFTConfig["PEFT Config<br/>(LoRA, Prompt Tuning)"]
            AccelConfig["acceleration_configs<br/>(QLoRA, fused ops, padding-free)"]
        end

        subgraph ControlLayer["Training Control Layer"]
            TrainerController["tuning.trainercontroller<br/>(rule-based control)"]
            Trackers["tuning.trackers<br/>(experiment tracking)"]
            Recommender["fms-recommender<br/>(config recommender)"]
        end
    end

    subgraph ExternalDeps["External Dependencies"]
        HFHub["Hugging Face Hub<br/>(models & datasets)"]
        FMSAccel["fms-acceleration<br/>(optional plugins)"]
        TrackerServers["Tracker Servers<br/>(AimStack / MLflow / ClearML)"]
    end

    subgraph DistTraining["Distributed Training"]
        WorkerPods["Other Worker Pods<br/>(FSDP all-reduce)"]
    end

    subgraph Storage["Storage"]
        PVC["PVC / Output Directory<br/>(model checkpoints)"]
        GPU["GPU Memory<br/>(CUDA)"]
    end

    %% Orchestration flows
    KFTOOperator -->|"creates pod via<br/>PyTorchJob CRD"| AccelLaunch
    Kueue -.->|"queue-name label"| KFTOOperator

    %% Internal flows
    AccelLaunch -->|"parses config"| ConfigLoader
    ConfigLoader -->|"accelerate launch"| SFTTrainer
    SFTTrainer -->|"alternative"| SumLossTrainer
    SFTTrainer -->|"preprocesses data"| DataPipeline
    DataPipeline --> DataHandlers
    DataPipeline --> ChatTemplates
    DataPipeline --> VisionData
    SFTTrainer -->|"reads config"| Config
    Config --> PEFTConfig
    Config --> AccelConfig
    SFTTrainer -->|"training loop control"| TrainerController
    SFTTrainer -->|"logs metrics"| Trackers

    %% External flows
    SFTTrainer -->|"downloads models<br/>HTTPS/443"| HFHub
    AccelConfig -->|"optional plugins"| FMSAccel
    Trackers -->|"sends metrics"| TrackerServers
    SFTTrainer -->|"NCCL/Gloo<br/>29500/TCP"| WorkerPods
    SFTTrainer -->|"saves checkpoints"| PVC
    SFTTrainer -->|"training compute"| GPU

    %% Styling
    style KFTOOperator fill:#e8e8e8,stroke:#666,stroke-width:2px
    style Kueue fill:#e8e8e8,stroke:#666,stroke-width:2px
    style AccelLaunch fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ConfigLoader fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style SFTTrainer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style SumLossTrainer fill:#6ba3d6,stroke:#333,stroke-width:1px,color:#fff
    style DataPipeline fill:#7ed321,stroke:#333,stroke-width:2px
    style DataHandlers fill:#a8e06c,stroke:#333
    style ChatTemplates fill:#a8e06c,stroke:#333
    style VisionData fill:#a8e06c,stroke:#333
    style Config fill:#f5a623,stroke:#333,stroke-width:2px
    style PEFTConfig fill:#f7be57,stroke:#333
    style AccelConfig fill:#f7be57,stroke:#333
    style TrainerController fill:#bd10e0,stroke:#333,stroke-width:2px,color:#fff
    style Trackers fill:#bd10e0,stroke:#333,stroke-width:2px,color:#fff
    style Recommender fill:#bd10e0,stroke:#333,stroke-width:2px,color:#fff
    style HFHub fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style FMSAccel fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style TrackerServers fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style WorkerPods fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style PVC fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style GPU fill:#f8cecc,stroke:#b85450,stroke-width:2px
