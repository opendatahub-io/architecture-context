graph TD
    subgraph "Service Accounts"
        SA_ModelCtrl["odh-model-controller"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["odh-model-controller-rolebinding<br/>(Cluster-scoped)"]
        CRB2["proxy-rolebinding<br/>(Cluster-scoped)"]
    end

    subgraph "Role Bindings"
        RB1["leader-election-rolebinding<br/>(Namespace-scoped)"]
    end

    subgraph "ClusterRoles"
        CR_Main["odh-model-controller-role"]
        CR_Proxy["proxy-role"]
        CR_Metrics["metrics-reader"]
    end

    subgraph "Roles"
        R_Leader["leader-election-role"]
    end

    subgraph "Core API Resources"
        CoreRes["(core)<br/>configmaps, endpoints,<br/>namespaces, pods, secrets,<br/>serviceaccounts, services"]
    end

    subgraph "Service Mesh Resources"
        MaistraRes["maistra.io<br/>servicemeshcontrolplanes,<br/>servicemeshmemberrolls,<br/>servicemeshmembers"]
        IstioNet["networking.istio.io<br/>virtualservices"]
        IstioSec["security.istio.io<br/>peerauthentications"]
        IstioTel["telemetry.istio.io<br/>telemetries"]
    end

    subgraph "Monitoring Resources"
        MonRes["monitoring.coreos.com<br/>podmonitors,<br/>servicemonitors"]
    end

    subgraph "Network & RBAC Resources"
        NetRes["networking.k8s.io<br/>networkpolicies"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>rolebindings"]
    end

    subgraph "Platform Resources"
        RouteRes["route.openshift.io<br/>routes"]
        KServeRes["serving.kserve.io<br/>inferenceservices,<br/>servingruntimes"]
    end

    subgraph "Auth Resources"
        AuthRes["authentication.k8s.io<br/>tokenreviews"]
        AuthzRes["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Leader Election Resources"
        LeaderRes["(core) configmaps, events<br/>coordination.k8s.io leases"]
    end

    subgraph "Non-Resource URLs"
        MetricsURL["/metrics"]
    end

    %% Bindings
    SA_ModelCtrl -->|bound via| CRB1
    SA_ModelCtrl -->|bound via| CRB2
    SA_ModelCtrl -->|bound via| RB1

    CRB1 -->|grants| CR_Main
    CRB2 -->|grants| CR_Proxy
    RB1 -->|grants| R_Leader

    %% Permissions
    CR_Main -->|"create, get, list,<br/>patch, update, watch"| CoreRes
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| MaistraRes
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| IstioNet
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| IstioSec
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| IstioTel
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| MonRes
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| NetRes
    CR_Main -->|"create, delete, get, list,<br/>patch, update, watch"| RBACRes
    CR_Main -->|"create, get, list,<br/>patch, update, watch"| RouteRes
    CR_Main -->|"get, list, update, watch"| KServeRes

    CR_Proxy -->|create| AuthRes
    CR_Proxy -->|create| AuthzRes

    CR_Metrics -->|get| MetricsURL

    R_Leader -->|"create, delete, get, list,<br/>patch, update, watch"| LeaderRes

