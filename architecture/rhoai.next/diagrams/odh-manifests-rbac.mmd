    style SA_ModelCtrl fill:#4a90e2,color:#fff
    style CR_Main fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style R_Leader fill:#e8a623
