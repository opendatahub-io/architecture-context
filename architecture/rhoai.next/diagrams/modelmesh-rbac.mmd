    style Rule3 fill:#ffe6cc,stroke:#d79b00
    style Auth1 fill:#d5e8d4,stroke:#82b366
    style Auth2 fill:#f8cecc,stroke:#b85450
    style Auth3 fill:#d5e8d4,stroke:#82b366
    style Auth4 fill:#f8cecc,stroke:#b85450
    style Auth5 fill:#ffe6cc,stroke:#d79b00
