graph TD
    subgraph Note["ModelMesh RBAC"]
        direction TB
        Info["ModelMesh defines no RBAC roles<br/>in its own repository.<br/><br/>All RBAC is managed by the companion<br/>modelmesh-serving controller."]
    end

    subgraph NetworkPolicy["NetworkPolicy (config/base/networkpolicy.yaml)"]
        direction TB
        NP["NetworkPolicy: model-mesh"]
    end

    subgraph IngressRules["Ingress Rules"]
        direction TB
        Rule1["Ports 8033, 8080<br/>From: pods with label<br/>app=model-mesh"]
        Rule2["Port 8033<br/>From: all sources<br/>(inference)"]
        Rule3["Port 2112<br/>From: all sources<br/>(metrics)"]
    end

    subgraph Auth["Authentication Mechanisms"]
        direction TB
        Auth1["gRPC :8033<br/>mTLS optional<br/>(MM_TLS_CLIENT_AUTH)"]
        Auth2["gRPC :8085<br/>No auth<br/>(localhost trust)"]
        Auth3["Thrift :8080<br/>TLS + client auth optional<br/>(litelinks SSL)"]
        Auth4["HTTP :8089<br/>No auth<br/>(health probes)"]
        Auth5["HTTPS :2112<br/>Server TLS only<br/>(self-signed, no client auth)"]
    end

    subgraph Secrets["Secrets"]
        direction TB
        TLSSecret["model-mesh-tls-secret<br/>Type: kubernetes.io/tls<br/>Purpose: gRPC + litelinks TLS<br/>Provisioned: Manual / cert-manager<br/>Auto-Rotate: No"]
        EtcdSecret["model-mesh-icd-etcd<br/>Type: Opaque<br/>Purpose: etcd connection config<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    NP --> Rule1
    NP --> Rule2
    NP --> Rule3

    style Info fill:#fff3cd,stroke:#856404,color:#856404
    style NP fill:#4a90e2,stroke:#333,color:#fff
    style Rule1 fill:#d5e8d4,stroke:#82b366
