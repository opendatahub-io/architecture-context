graph TD
    subgraph Note["ModelMesh RBAC"]
        direction TB
        Info["ModelMesh does NOT define RBAC resources.<br/>It runs as a Java process within a pod<br/>and does not interact with the Kubernetes API.<br/><br/>RBAC is managed by the<br/>modelmesh-serving controller."]
    end

    subgraph Secrets["Secrets Used by ModelMesh"]
        direction TB
        EtcdSecret["model-mesh-icd-etcd<br/>Type: Opaque (JSON)<br/>Purpose: etcd connection config<br/>(endpoints, credentials, TLS certs)<br/>Provisioned: Manual / platform operator<br/>Auto-Rotate: No"]
        TLSSecret["model-mesh-tls-secret<br/>Type: kubernetes.io/tls<br/>Purpose: TLS cert/key for<br/>external gRPC + internal litelinks<br/>Provisioned: Manual / cert-manager<br/>Auto-Rotate: No"]
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        direction TB
        ExtGRPC["gRPC External (8033/TCP)<br/>Auth: Optional mTLS<br/>MM_TLS_CLIENT_AUTH:<br/>NONE / REQUIRE / OPTIONAL<br/>Enforcement: Netty SslContext"]
        IntGRPC["gRPC Litelinks (8080/TCP)<br/>Auth: Optional mTLS<br/>MM_INTRACLUSTER_CLIENTAUTH<br/>Enforcement: litelinks TLS"]
        Health["Health Probes (8089/TCP)<br/>Auth: None<br/>Unauthenticated<br/>(kubelet probes)"]
        Metrics["Prometheus (2112/TCP)<br/>Auth: TLS server-auth only<br/>Self-signed cert<br/>No client auth"]
    end

    subgraph FIPSWarning["FIPS Compliance Warning"]
        direction TB
        FIPS["CRITICAL: Java FIPS mode DISABLED<br/>-Dcom.redhat.fips=false<br/><br/>SunPKCS11 provider removed<br/>BouncyCastle (non-FIPS) used for certs<br/>BoringSSL-static NOT FIPS-validated<br/><br/>ModelMesh does NOT use FIPS-validated<br/>crypto even on FIPS-enabled hosts"]
    end

    style Info fill:#f0f0f0,stroke:#999,stroke-width:1px
    style EtcdSecret fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style TLSSecret fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ExtGRPC fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style IntGRPC fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Health fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Metrics fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style FIPS fill:#f8d7da,stroke:#dc3545,stroke-width:3px
