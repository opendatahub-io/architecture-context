graph TD
    subgraph "ModelMesh RBAC & Security Posture"
        direction TB

        Note["NOTE: ModelMesh does not define its own RBAC.<br/>It does not interact with the Kubernetes API.<br/>RBAC is managed by modelmesh-controller.<br/><br/>This diagram shows the security-relevant<br/>identity and access configuration."]
    end

    subgraph "TLS Secrets"
        TLSSecret["model-mesh-tls-secret<br/>Type: kubernetes.io/tls<br/>Provisioned: Manual / cert-manager<br/>Auto-Rotate: No"]
        etcdSecret["model-mesh-icd-etcd<br/>Type: Opaque<br/>Provisioned: Manual / operator<br/>Auto-Rotate: No"]
    end

    subgraph "Authentication Endpoints"
        direction TB
        GrpcAuth["mmesh.ModelMesh gRPC<br/>Port: 8033/TCP<br/>Auth: TLS (server/mTLS)<br/>Enforcement: gRPC TLS handler<br/>Policy: Transport-level only"]
        ThriftAuth["Internal Thrift<br/>Port: 8080/TCP<br/>Auth: TLS + client-auth (optional)<br/>Enforcement: LiteLinks SSL handler<br/>Policy: Client cert validation"]
        MetricsAuth["Prometheus Metrics<br/>Port: 2112/TCP<br/>Auth: None<br/>Policy: NetworkPolicy only"]
        HealthAuth["Health Probes<br/>Port: 8089/TCP<br/>Auth: None<br/>Policy: Internal only"]
    end

    subgraph "modelmesh-controller RBAC (External)"
        ControllerSA["ServiceAccount<br/>modelmesh-controller"]
        ControllerRole["ClusterRole<br/>(defined by controller)"]
        ControllerSA -->|"bound via ClusterRoleBinding"| ControllerRole
        ControllerRole -->|"manages"| Deployments["Deployments<br/>Services<br/>ConfigMaps"]
    end

    TLSSecret -->|"mounted into"| GrpcAuth
    TLSSecret -->|"used by"| ThriftAuth
    etcdSecret -->|"connection config"| etcdConn["etcd Connection<br/>2379/TCP"]

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style TLSSecret fill:#f5a623,stroke:#333
    style etcdSecret fill:#f5a623,stroke:#333
    style GrpcAuth fill:#4a90e2,stroke:#333,color:#fff
    style ThriftAuth fill:#4a90e2,stroke:#333,color:#fff
    style MetricsAuth fill:#d4edda,stroke:#333
    style HealthAuth fill:#d4edda,stroke:#333
    style ControllerSA fill:#7ed321,stroke:#333
    style ControllerRole fill:#7ed321,stroke:#333
    style Deployments fill:#e8e8e8,stroke:#333
    style etcdConn fill:#e8e8e8,stroke:#333
