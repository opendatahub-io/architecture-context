graph TD
    subgraph Operator["TrustyAI Service Operator (Manages RBAC)"]
        OpSA["Operator ServiceAccount<br/>trustyai-service-operator"]
    end

    subgraph EvalHubRBAC["EvalHub Runtime Permissions<br/>(Granted via Operator SA)"]
        direction TB

        subgraph JobMgmt["Job Management"]
            Jobs["batch/v1<br/>Jobs"]
        end

        subgraph ConfigMgmt["Configuration Management"]
            ConfigMaps["core/v1<br/>ConfigMaps"]
            Secrets["core/v1<br/>Secrets"]
        end
    end

    subgraph AuthFlow["Authentication & Authorization Flow"]
        direction TB

        subgraph ExternalAuth["External Authentication"]
            KRP["kube-rbac-proxy<br/>OAuth/Bearer validation"]
        end

        subgraph HeaderInjection["Header-Based Identity"]
            XTenant["X-Tenant Header<br/>(maps to namespace)"]
            XUser["X-User Header<br/>(authenticated user)"]
        end

        subgraph AppAuth["Application-Level Auth"]
            EvalHubAPI["EvalHub API<br/>Header validation<br/>(cluster mode)"]
        end
    end

    subgraph SidecarAuth["Sidecar Authentication"]
        direction TB

        SA_Token["K8s SA Token<br/>(projected, 5-min cache)"]
        MLflow_Token["MLflow Bearer Token<br/>(file-based, 5-min cache)"]
        OCI_Creds["Docker config.json<br/>(challenge-response)"]
        Ref_Token["Ref Token Resolution<br/>(api-key:ref → secret lookup)"]
    end

    subgraph SecretResources["Managed Secrets"]
        ModelAuth["model-auth (Opaque)<br/>Model endpoint API keys"]
        MLflowSecret["mlflow-token (Opaque)<br/>MLflow bearer token"]
        OCICreds["oci-credentials (dockerconfigjson)<br/>OCI registry auth"]
        S3Creds["test-data-s3 (Opaque)<br/>AWS access key, secret, region, endpoint"]
        TLSCert["TLS certs (kubernetes.io/tls)<br/>Server cert + key"]
        ServiceCA["service-ca (ConfigMap)<br/>OpenShift service CA bundle<br/>Auto-rotated"]
    end

    %% RBAC flow
    OpSA -->|"grants permissions to"| Jobs
    OpSA -->|"grants permissions to"| ConfigMaps
    OpSA -->|"grants permissions to"| Secrets

    %% Auth flow
    KRP -->|"validates identity"| XTenant
    KRP -->|"validates identity"| XUser
    XTenant -->|"required in cluster mode"| EvalHubAPI
    XUser -->|"required in cluster mode"| EvalHubAPI

    %% Sidecar auth
    SA_Token -->|"authenticates to EvalHub API"| EvalHubAPI
    MLflow_Token -->|"authenticates to MLflow"| MLflowSecret
    OCI_Creds -->|"authenticates to OCI"| OCICreds
    Ref_Token -->|"resolves from"| ModelAuth

    %% Verbs
    Jobs -.-|"create, get, delete,<br/>list, watch"| JobMgmt
    ConfigMaps -.-|"create, get, update,<br/>delete"| ConfigMgmt
    Secrets -.-|"get, list"| ConfigMgmt

    %% Styling
    style OpSA fill:#4a90e2,stroke:#333,color:#fff
    style KRP fill:#ffe6cc,stroke:#d79b00
    style EvalHubAPI fill:#4a90e2,stroke:#333,color:#fff
    style Jobs fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#f5a623,stroke:#333,color:#fff
    style Secrets fill:#f5a623,stroke:#333,color:#fff
    style XTenant fill:#d5e8d4,stroke:#82b366
    style XUser fill:#d5e8d4,stroke:#82b366
    style ModelAuth fill:#fff2cc,stroke:#d6b656
    style MLflowSecret fill:#fff2cc,stroke:#d6b656
    style OCICreds fill:#fff2cc,stroke:#d6b656
    style S3Creds fill:#fff2cc,stroke:#d6b656
    style TLSCert fill:#fff2cc,stroke:#d6b656
    style ServiceCA fill:#fff2cc,stroke:#d6b656
    style SA_Token fill:#e1d5e7,stroke:#9673a6
    style MLflow_Token fill:#e1d5e7,stroke:#9673a6
    style OCI_Creds fill:#e1d5e7,stroke:#9673a6
    style Ref_Token fill:#e1d5e7,stroke:#9673a6
