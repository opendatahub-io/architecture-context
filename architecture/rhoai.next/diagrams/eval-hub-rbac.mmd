graph TD
    subgraph OperatorManaged["Managed by TrustyAI Service Operator"]
        direction TB

        subgraph ServiceAccounts["Service Accounts"]
            SA_EvalHub["eval-hub SA<br/>(operator-created)"]
        end

        subgraph RoleBindings["Role Bindings (operator-created)"]
            RB_Jobs["Jobs RoleBinding"]
            RB_Pods["Pods RoleBinding"]
            RB_Secrets["Secrets RoleBinding"]
            RB_ConfigMaps["ConfigMaps RoleBinding"]
            RB_HWProfile["HardwareProfile RoleBinding"]
        end

        subgraph Roles["Roles (operator-created)"]
            R_Jobs["Jobs Role"]
            R_Pods["Pods Role"]
            R_Secrets["Secrets Role"]
            R_ConfigMaps["ConfigMaps Role"]
            R_HWProfile["HardwareProfile Role"]
        end

        subgraph APIResources["Kubernetes API Resources"]
            Jobs["batch/v1<br/>Jobs<br/>create, delete, get, list, watch"]
            Pods["core/v1<br/>Pods<br/>get, list (logs)"]
            Secrets["core/v1<br/>Secrets<br/>get, list (Docker config, model creds)"]
            ConfigMaps["core/v1<br/>ConfigMaps<br/>create, get (job spec, sidecar config)"]
            HWProfile["hardwareprofiles.dashboard.opendatahub.io<br/>HardwareProfile CRD<br/>get, list (GPU/resource allocation)"]
        end
    end

    subgraph AuthFlow["Authentication Flow"]
        direction TB

        Client["Client<br/>(Dashboard / SDK / CLI)"]
        KubeRBAC["kube-rbac-proxy<br/>:8443/TCP"]
        EvalHubAPI["eval-hub API<br/>:8080/TCP"]

        Client -->|"Bearer token<br/>RBAC validation"| KubeRBAC
        KubeRBAC -->|"X-Tenant header<br/>X-User header"| EvalHubAPI
    end

    subgraph SidecarAuth["Sidecar Credential Injection"]
        direction TB

        Adapter["Eval Adapter<br/>(Python)"]
        Sidecar["eval-runtime-sidecar"]

        subgraph CredentialSources["Secret Mounts"]
            SAToken["ServiceAccount Token<br/>kubernetes.io/service-account-token<br/>Projected volume, auto-rotate"]
            MLflowToken["MLflow Token<br/>Opaque<br/>/var/run/secrets/mlflow/token"]
            OCICreds["OCI Registry Credentials<br/>dockerconfigjson<br/>/etc/evalhub/.docker/config.json"]
            ModelCreds["Model Credentials<br/>Opaque<br/>secretMountPath (API keys, endpoints)"]
            S3Creds["S3 Credentials<br/>Opaque<br/>/var/run/secrets/test-data/<br/>AWS access key, secret, region, endpoint"]
            TLSCert["TLS Cert/Key<br/>kubernetes.io/tls<br/>cert-manager/Operator, auto-rotate"]
        end

        Adapter -->|"HTTP localhost:8080<br/>No auth"| Sidecar
        Sidecar -->|"SA token injection"| SAToken
        Sidecar -->|"Bearer token injection"| MLflowToken
        Sidecar -->|"Docker auth injection"| OCICreds
        Sidecar -->|"ref-token resolution"| ModelCreds
    end

    %% SA bindings
    SA_EvalHub -->|"bound via"| RB_Jobs
    SA_EvalHub -->|"bound via"| RB_Pods
    SA_EvalHub -->|"bound via"| RB_Secrets
    SA_EvalHub -->|"bound via"| RB_ConfigMaps
    SA_EvalHub -->|"bound via"| RB_HWProfile

    RB_Jobs -->|"grants"| R_Jobs
    RB_Pods -->|"grants"| R_Pods
    RB_Secrets -->|"grants"| R_Secrets
    RB_ConfigMaps -->|"grants"| R_ConfigMaps
    RB_HWProfile -->|"grants"| R_HWProfile

    R_Jobs -->|"create, delete,<br/>get, list, watch"| Jobs
    R_Pods -->|"get, list<br/>(logs)"| Pods
    R_Secrets -->|"get, list"| Secrets
    R_ConfigMaps -->|"create, get"| ConfigMaps
    R_HWProfile -->|"get, list"| HWProfile

    %% Styling
    style SA_EvalHub fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBAC fill:#e8a838,stroke:#333,color:#fff
    style EvalHubAPI fill:#4a90e2,stroke:#333,color:#fff
    style Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style Jobs fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style Secrets fill:#7ed321,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style HWProfile fill:#7ed321,stroke:#333,color:#fff
    style SAToken fill:#f5a623,stroke:#333
    style MLflowToken fill:#f5a623,stroke:#333
    style OCICreds fill:#f5a623,stroke:#333
    style ModelCreds fill:#f5a623,stroke:#333
    style S3Creds fill:#f5a623,stroke:#333
    style TLSCert fill:#f5a623,stroke:#333
