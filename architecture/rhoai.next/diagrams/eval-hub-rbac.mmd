graph TD
    subgraph Note["RBAC Configuration"]
        direction TB
        NoteText["No RBAC manifests shipped in this repository.<br/>RBAC is managed externally by the deploying operator<br/>(TrustyAI / ODH operator)."]
    end

    subgraph ServiceAccounts["Service Accounts"]
        SA_API["eval-hub SA<br/>(API server)"]
        SA_Job["Job Pod SA<br/>(per tenant namespace)"]
    end

    subgraph AuthProxy["Authentication Layer"]
        KRBP["kube-rbac-proxy<br/>Performs TokenReview + SAR"]
    end

    subgraph ExpectedPermissions["Expected Permissions (Operator-Managed)"]
        direction TB

        subgraph BatchAPI["batch API Group"]
            Jobs["Jobs<br/>get, list, watch,<br/>create, delete"]
        end

        subgraph CoreAPI["core API Group"]
            ConfigMaps["ConfigMaps<br/>get, list, create, delete"]
            Secrets["Secrets<br/>get, list"]
            Pods["Pods<br/>get, list, watch"]
            PodLog["Pods/log<br/>get"]
            Events["Events<br/>create"]
        end

        subgraph InfraAPI["infrastructure.opendatahub.io"]
            HWProfile["HardwareProfile<br/>get, list, delete"]
        end

        subgraph KueueAPI["kueue.x-k8s.io"]
            LocalQueue["LocalQueue<br/>get, list"]
        end
    end

    subgraph TenantIsolation["Multi-Tenant Isolation"]
        direction TB
        IdentityGate["Identity Gate<br/>(X-User + X-Tenant headers)"]
        SQLFilter["SQL tenant_id Filter<br/>(evaluations, collections, providers)"]
        NSScope["Namespace Scoping<br/>(jobs created in tenant NS)"]
    end

    %% Auth flow
    KRBP -->|"validates token<br/>checks RBAC"| SA_API
    KRBP -->|"injects"| IdentityGate

    %% SA → Permissions
    SA_API -->|"expected bindings"| Jobs
    SA_API -->|"expected bindings"| ConfigMaps
    SA_API -->|"expected bindings"| Secrets
    SA_API -->|"expected bindings"| Pods
    SA_API -->|"expected bindings"| PodLog
    SA_API -->|"expected bindings"| Events
    SA_API -->|"expected bindings"| HWProfile
    SA_API -->|"expected bindings"| LocalQueue

    %% Tenant isolation
    IdentityGate -->|"tenant_id"| SQLFilter
    IdentityGate -->|"namespace"| NSScope

    style NoteText fill:#fff3cd,stroke:#856404
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Job fill:#4a90e2,stroke:#333,color:#fff
    style KRBP fill:#f5a623,stroke:#333,color:#fff
    style IdentityGate fill:#7ed321,stroke:#333
    style SQLFilter fill:#7ed321,stroke:#333
    style NSScope fill:#7ed321,stroke:#333
    style Jobs fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets fill:#e8e8e8,stroke:#333
    style Pods fill:#e8e8e8,stroke:#333
    style PodLog fill:#e8e8e8,stroke:#333
    style Events fill:#e8e8e8,stroke:#333
    style HWProfile fill:#e8e8e8,stroke:#333
    style LocalQueue fill:#e8e8e8,stroke:#333
