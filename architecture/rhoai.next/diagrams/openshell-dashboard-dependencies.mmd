graph LR
    Dashboard["OpenShell Dashboard<br/>(Go BFF + React Frontend)"]

    %% Platform Dependencies (Required)
    Dashboard -->|"gRPC/50051<br/>Bearer relay + mTLS"| Gateway["OpenShell Gateway"]
    Dashboard -->|"HTTP headers<br/>Token injection"| AuthProxy["Auth Proxy<br/>(oauth2-proxy)"]

    %% Go Dependencies
    Dashboard -->|"gRPC client"| OpenShellSDK["NVIDIA OpenShell SDK<br/>(Go) v0.0.0-20260923"]
    Dashboard -->|"HTTP routing"| Chi["go-chi/chi v5.3.1"]
    Dashboard -->|"WebSocket relay"| Gorilla["gorilla/websocket v1.5.3"]
    Dashboard -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>v1.83.2"]
    Dashboard -->|"protobuf serialization"| Protobuf["google.golang.org/protobuf<br/>v1.36.11"]

    %% Frontend Dependencies
    Dashboard -->|"UI components"| PatternFly["PatternFly 6.x"]
    Dashboard -->|"framework"| React["React 18.x"]
    Dashboard -->|"data fetching"| TanStack["@tanstack/react-query 5.x"]
    Dashboard -->|"terminal emulator"| Xterm["xterm.js 6.x"]
    Dashboard -->|"code editor"| Monaco["Monaco Editor 0.52.x"]
    Dashboard -->|"i18n"| I18next["i18next 26.x"]

    %% Build Dependencies
    Dashboard -.->|"build-time"| Go["Go 1.26.7"]
    Dashboard -.->|"build-time"| Node["Node.js 22+"]

    %% Indirect Dependencies
    AuthProxy -.->|"OIDC/OAuth2"| OIDC["OIDC IdP<br/>(Keycloak / Dex)"]
    Gateway -.->|"JWKS validation"| OIDC

    %% Styling
    style Dashboard fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Gateway fill:#7ed321,stroke:#333
    style AuthProxy fill:#7ed321,stroke:#333
    style OIDC fill:#e8e8e8,stroke:#999
    style OpenShellSDK fill:#f5a623,stroke:#333
    style Chi fill:#f5a623,stroke:#333
    style Gorilla fill:#f5a623,stroke:#333
    style GRPC fill:#f5a623,stroke:#333
    style Protobuf fill:#f5a623,stroke:#333
    style PatternFly fill:#61affe,stroke:#333,color:#fff
    style React fill:#61affe,stroke:#333,color:#fff
    style TanStack fill:#61affe,stroke:#333,color:#fff
    style Xterm fill:#61affe,stroke:#333,color:#fff
    style Monaco fill:#61affe,stroke:#333,color:#fff
