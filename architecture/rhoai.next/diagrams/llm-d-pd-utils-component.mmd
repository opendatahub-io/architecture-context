graph TB
    subgraph "llm-d-pd-utils"
        direction TB

        subgraph PreflightChecks["Preflight Checks"]
            PreflightScript["llm-d-preflight-checks<br/>Python Script / AI Skill"]
            HTTPServer["Preflight HTTP Server<br/>Port 8000/TCP"]
            PreflightScript -->|pause mode| HTTPServer
        end

        subgraph NetworkingTests["Networking Test Suite"]
            TestRunner["llm-d-networking-tests<br/>Python Suite / AI Skill"]
            Perftest["perftest<br/>RDMA bandwidth/latency"]
            Iperf3["iperf3<br/>TCP bandwidth"]
            NCCL["NCCL/RCCL<br/>GPU collectives"]
            NIXLTest["nixlbench<br/>NIXL throughput"]
            TopoDiscovery["Topology Discovery<br/>GPU/NIC mapping"]
            TestRunner --> Perftest
            TestRunner --> Iperf3
            TestRunner --> NCCL
            TestRunner --> NIXLTest
            TestRunner --> TopoDiscovery
        end

        subgraph NIXLBenchmark["NIXL Benchmark"]
            BenchmarkScript["benchmark.py<br/>NIXL/UCX data transfer"]
            ZMQCoord["ZMQ Coordination<br/>Port 5555/TCP"]
            BenchmarkScript -->|coordinates via| ZMQCoord
        end

        subgraph Installers["NIXL Installers"]
            RootInstaller["install_nixl.sh<br/>Root install"]
            NonRootInstaller["install_nixl_nonroot.sh<br/>Non-root install"]
        end
    end

    %% External interactions
    Operator["Operator<br/>(kubectl exec)"]
    Operator -->|"GET /info, /exit"| HTTPServer
    Operator -->|runs| TestRunner

    vLLMPod["llm-d vLLM Pod"]
    PreflightScript -->|"injected into<br/>startup chain"| vLLMPod
    TestRunner -->|"kubectl exec"| vLLMPod

    GPUHardware["NVIDIA GPU<br/>Hardware"]
    PreflightScript -->|"nvidia-smi<br/>topology inspect"| GPUHardware
    BenchmarkScript -->|"VRAM allocation<br/>CUDA tensors"| GPUHardware

    K8sAPI["Kubernetes API<br/>443/TCP"]
    TestRunner -->|"pod discovery<br/>exec, apply"| K8sAPI

    %% Styling
    style PreflightScript fill:#4a90e2,color:#fff
    style TestRunner fill:#4a90e2,color:#fff
    style BenchmarkScript fill:#4a90e2,color:#fff
    style HTTPServer fill:#f5a623,color:#fff
    style ZMQCoord fill:#f5a623,color:#fff
    style Operator fill:#e8e8e8,stroke:#333
    style vLLMPod fill:#7ed321,color:#fff
    style GPUHardware fill:#999,color:#fff
    style K8sAPI fill:#999,color:#fff
    style RootInstaller fill:#9b59b6,color:#fff
    style NonRootInstaller fill:#9b59b6,color:#fff
