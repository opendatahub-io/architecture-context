graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_EPP["epp-metrics-reader"]
        SA_PROM["kube-prometheus-stack-prometheus"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_MGR["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_AUTH["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_MR["metrics-reader-rolebinding<br/>(monitoring NS)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_LE["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_MGR["manager-role"]
        CR_AUTH["metrics-auth-role"]
        CR_MR["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_LE["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps, namespaces,<br/>nodes, pods, resourcequotas,<br/>services<br/>(get, list, watch)"]
        Events["core<br/>events<br/>(create, patch)"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps<br/>deployments<br/>(get, list, patch, update, watch)"]
        DeployScale["apps<br/>deployments/scale<br/>(get, update)"]
        ReplicaSets["apps<br/>replicasets, statefulsets<br/>(get, list, watch)"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPAs["autoscaling<br/>horizontalpodautoscalers<br/>(get, list, patch, update, watch)"]
    end

    subgraph ExtensionResources["Extension API Resources"]
        InferencePools["inference.networking.k8s.io<br/>inferencepools<br/>(get, list, watch)"]
        ScaledObjects["keda.sh<br/>scaledobjects<br/>(get, list, patch, update, watch)"]
        LeaderWorkerSets["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>(get, list, patch, update, watch)"]
        LWSScale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale<br/>(get, update)"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors<br/>(get, list, watch)"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>(create)"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>(create)"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics<br/>(get)"]
    end

    subgraph LeaderElection["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>leases<br/>(create, delete, get, list,<br/>patch, update, watch)"]
        LEEvents["core<br/>events<br/>(create, patch)"]
    end

