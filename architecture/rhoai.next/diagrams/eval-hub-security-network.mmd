graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / AI Agent"]
    end

    subgraph AuthBoundary["AUTH BOUNDARY"]
        KRBP["kube-rbac-proxy<br/>443/TCP<br/>TLS 1.2+ termination<br/>TokenReview + SAR<br/>Injects X-User/X-Tenant"]
    end

    subgraph AppServices["APPLICATION SERVICES (Internal)"]
        direction TB

        subgraph EvalHubPod["eval-hub Pod"]
            API["eval-hub API<br/>8080/TCP HTTP/HTTPS<br/>TLS 1.2-1.3<br/>FIPS: strictfipsruntime<br/>Identity gate enforced"]
            MetricsSrv["Metrics Server<br/>8081/TCP HTTP<br/>No encryption<br/>No auth"]
        end

        subgraph MCPPod["evalhub-mcp Pod"]
            MCP["evalhub-mcp<br/>3001/TCP HTTP/HTTPS<br/>TLS 1.2-1.3<br/>MCP Streamable HTTP"]
        end
    end

    subgraph JobPods["EVALUATION JOB PODS (Tenant Namespace)"]
        direction TB
        Init["eval-runtime-init<br/>(init container)<br/>Downloads test data"]
        Adapter["Provider Adapter<br/>(lm-eval-harness / RAGAS<br/>/ Garak / GuideLLM)"]
        Sidecar["eval-runtime-sidecar<br/>Reverse proxy<br/>TLS + token mgmt<br/>FIPS-gated InsecureSkipVerify"]
    end

    subgraph ExternalSvcs["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        PG["PostgreSQL<br/>5432/TCP SQL<br/>TLS configurable<br/>Password auth"]
        MLflow["MLflow Tracking<br/>HTTPS<br/>TLS + CA bundle<br/>SA token"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS credentials"]
        OCI["OCI Registry<br/>443/TCP HTTPS<br/>TLS + CA bundle<br/>Docker config secret"]
        ModelEP["Model Endpoints<br/>HTTPS<br/>TLS configurable<br/>Configured auth"]
        OTEL["OTEL Collector<br/>OTLP/gRPC<br/>TLS configurable<br/>No auth"]
    end

    Prom["Prometheus"]

    %% External → Auth
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| KRBP

    %% Auth → Services
    KRBP -->|"HTTP/8080<br/>TLS 1.2-1.3<br/>X-User + X-Tenant"| API
    KRBP -->|"HTTP/3001<br/>TLS 1.2-1.3<br/>Forwarded identity"| MCP

    %% MCP loop-back
    MCP -->|"HTTPS/443<br/>TLS 1.2+<br/>EVALHUB_TOKEN"| KRBP

    %% Metrics scrape
    Prom -->|"HTTP/8081<br/>No TLS<br/>No auth"| MetricsSrv

    %% API → Data stores & K8s
    API -->|"SQL/5432<br/>TLS configurable<br/>Password"| PG
    API -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    API -->|"OTLP/gRPC<br/>TLS configurable"| OTEL

    %% Job pod flows
    Adapter -->|"HTTP local<br/>No TLS<br/>No auth"| Sidecar
    Init -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    Sidecar -->|"HTTPS<br/>TLS configurable<br/>Configured auth"| ModelEP
    Sidecar -->|"HTTPS<br/>TLS + CA<br/>SA token"| MLflow
    Sidecar -->|"HTTPS/443<br/>TLS + CA<br/>Docker config"| OCI
    Sidecar -->|"HTTPS/8080<br/>TLS + CA<br/>SA token"| API
    Sidecar -->|"OTLP/gRPC<br/>TLS configurable"| OTEL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef appservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef jobpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class KRBP auth
    class API,MetricsSrv,MCP appservice
    class Init,Adapter,Sidecar jobpod
    class K8sAPI,PG,MLflow,S3,OCI,ModelEP,OTEL,Prom externalservice
