graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-manager<br/><i>Namespace: opendatahub</i>"]
        OAuthSA["{raycluster}-oauth-proxy<br/><i>Namespace: per RayCluster</i>"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["manager-rolebinding<br/><i>cluster-wide</i>"]
        OAuthCRB["{raycluster}-{ns}-auth<br/><i>cluster-wide, per RayCluster</i>"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        LERB["leader-election-rolebinding<br/><i>operator namespace</i>"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR["manager-role"]
        AuthDel["system:auth-delegator<br/><i>(built-in)</i>"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        LER["leader-election-role"]
    end

    %% Bindings
    SA -->|bound via| CRB
    CRB -->|grants| CR
    SA -->|bound via| LERB
    LERB -->|grants| LER
    OAuthSA -->|bound via| OAuthCRB
    OAuthCRB -->|grants| AuthDel

    subgraph CoreResources["Core API Resources"]
        Events["core<br/>events"]
        Nodes["core<br/>nodes"]
        Pods["core<br/>pods"]
        Services["core<br/>services"]
        Secrets["core<br/>secrets"]
        SvcAccts["core<br/>serviceaccounts"]
        ConfigMaps["core<br/>configmaps"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    subgraph RayResources["Ray Resources"]
        RayClusters["ray.io<br/>rayclusters<br/>+ finalizers, status"]
        RayJobs["ray.io<br/>rayjobs"]
    end

    subgraph AppWrapperResources["AppWrapper Resources"]
        AppWrappers["workload.codeflare.dev<br/>appwrappers<br/>+ finalizers, status"]
    end

    subgraph NetworkResources["Network Resources"]
        NetPol["networking.k8s.io<br/>networkpolicies"]
        Ingresses["networking.k8s.io<br/>ingresses"]
        Routes["route.openshift.io<br/>routes, routes/custom-host"]
    end

    subgraph RBACResources["RBAC Resources"]
        CRBRes["rbac.authorization.k8s.io<br/>clusterrolebindings"]
    end

    subgraph AdmissionResources["Admission Resources"]
        MutWH["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations"]
        ValWH["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
    end

    subgraph WorkloadResources["Workload Resources"]
        Deployments["apps<br/>deployments, statefulsets"]
        Jobs["batch<br/>jobs"]
        PyTorchJobs["kubeflow.org<br/>pytorchjobs"]
        JobSets["jobset.x-k8s.io<br/>jobsets"]
        PodGroups["scheduling.sigs.k8s.io<br/>scheduling.x-k8s.io<br/>podgroups"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        OSIngress["config.openshift.io<br/>ingresses"]
        DSCI["dscinitialization.opendatahub.io<br/>dscinitializations"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    %% manager-role permissions
    CR -->|"create,patch,update,watch"| Events
    CR -->|"get,list,watch"| Nodes
    CR -->|"full CRUD"| Pods
    CR -->|"full CRUD"| Services
    CR -->|"get,list,watch,update + create,get,patch"| Secrets
    CR -->|"full CRUD"| SvcAccts
    CR -->|"full CRUD"| RayClusters
    CR -->|"full CRUD"| RayJobs
    CR -->|"full CRUD"| AppWrappers
    CR -->|"full CRUD"| NetPol
    CR -->|"full CRUD"| Ingresses
    CR -->|"full CRUD"| Routes
    CR -->|"full CRUD"| CRBRes
    CR -->|"get,list,update,watch"| MutWH
    CR -->|"get,list,update,watch"| ValWH
    CR -->|"full CRUD"| Deployments
    CR -->|"full CRUD"| Jobs
    CR -->|"full CRUD"| PyTorchJobs
    CR -->|"full CRUD"| JobSets
    CR -->|"full CRUD"| PodGroups
    CR -->|"create"| TokenReviews
    CR -->|"create"| SAR
    CR -->|"get"| OSIngress
    CR -->|"get,list,watch"| DSCI
    CR -->|"get,list,watch"| CRDs

    %% leader-election-role permissions
    LER -->|"full CRUD"| ConfigMaps
    LER -->|"full CRUD"| Leases
    LER -->|"create,patch"| Events

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style OAuthSA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style LER fill:#f5a623,color:#fff
    style AuthDel fill:#f5a623,color:#fff
    style CRB fill:#e8e8e8,stroke:#999
    style OAuthCRB fill:#e8e8e8,stroke:#999
    style LERB fill:#e8e8e8,stroke:#999
    style RayClusters fill:#7ed321,color:#fff
    style AppWrappers fill:#7ed321,color:#fff
