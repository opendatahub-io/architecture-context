graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["codeflare-operator-controller-manager<br/>Namespace: opendatahub"]
    end

    subgraph ClusterBindings["ClusterRole Bindings"]
        CRB_Manager["codeflare-operator-manager-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
