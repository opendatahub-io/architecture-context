graph TB
    subgraph Monitoring["MONITORING (Trusted)"]
        Prometheus["Prometheus<br/>(monitoring namespace)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["mlflow-operator-controller-manager"]
            Operator["Controller Manager<br/>SA: mlflow-operator-controller-manager<br/>Image: odh-mlflow-operator-rhel9<br/>Build: strictfipsruntime, CGO_ENABLED=1"]
            MetricsEndpoint["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS: service-ca<br/>Auth: TokenReview + SAR"]
            HealthEndpoint["Health Probes<br/>8081/TCP HTTP<br/>Auth: None"]
        end

        MetricsService["metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS, TLS (service-ca)"]
        MetricsTLS["controller-manager-metrics-tls<br/>(kubernetes.io/tls)<br/>Provisioned: service-ca<br/>Auto-Rotate: Yes"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        KubeAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Trusted)"]
        direction TB
        OpenShiftTLS["OpenShift APIServer<br/>config.openshift.io<br/>TLS Profile Policy"]
        AuthCR["Auth CR<br/>services.platform.opendatahub.io<br/>Workspace Subjects"]
        ServiceCA["OpenShift service-ca<br/>Certificate Provisioning"]
        GatewayAPI["Gateway API<br/>data-science-gateway<br/>HTTPRoute Management"]
        Console["OpenShift Console<br/>ConsoleLink"]
        PromOperator["prometheus-operator<br/>ServiceMonitor"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (Operator-Created)"]
        direction TB
        TrackingDeploy["MLflow Tracking<br/>Deployment"]
        ArtifactDeploy["Artifact Server<br/>Deployment"]
        MigrationJob["DB Migration Job"]
        CronJobs["GC + Archival<br/>CronJobs"]
        HTTPRoutes["HTTPRoutes<br/>/mlflow, /mlflow-artifacts"]
        WorkspaceRBAC["Workspace RoleBindings<br/>mlflow-view, mlflow-edit"]
    end

    %% Monitoring flow
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>TokenReview + SAR"| MetricsService
    MetricsService --> MetricsEndpoint
    MetricsTLS -.->|"provides cert"| MetricsEndpoint

    %% Operator → Control Plane
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| KubeAPI

    %% Operator → Platform Services (all via KubeAPI)
    Operator -->|"Read + Watch<br/>TLS profile"| OpenShiftTLS
    Operator -->|"Read<br/>workspace subjects"| AuthCR
    ServiceCA -.->|"provisions cert"| MetricsTLS

    %% Operator → Managed Resources (via KubeAPI)
    Operator -->|"CRUD"| TrackingDeploy
    Operator -->|"CRUD"| ArtifactDeploy
    Operator -->|"create/delete"| MigrationJob
    Operator -->|"CRUD"| CronJobs
    Operator -->|"CRUD"| HTTPRoutes
    Operator -->|"distribute"| WorkspaceRBAC
    Operator -->|"CRUD"| Console
    Operator -->|"CRUD"| PromOperator

    HTTPRoutes -->|"routes traffic"| GatewayAPI

    %% NetworkPolicy annotation
    NetworkPolicy["NetworkPolicy:<br/>Ingress: monitoring ns → 8443<br/>Egress: KubeAPI 6443"]

    %% Styling
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#000
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px,color:#000
    classDef managed fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000
    classDef netpol fill:#f5f5f5,stroke:#666,stroke-width:1px,stroke-dasharray: 5 5,color:#000

    class Prometheus monitoring
    class Operator,MetricsEndpoint,HealthEndpoint,MetricsService,MetricsTLS operator
    class KubeAPI controlplane
    class OpenShiftTLS,AuthCR,ServiceCA,GatewayAPI,Console,PromOperator platform
    class TrackingDeploy,ArtifactDeploy,MigrationJob,CronJobs,HTTPRoutes,WorkspaceRBAC managed
    class NetworkPolicy netpol
