graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway (Envoy)<br/>443/TCP → 8443/TCP<br/>TLS 1.2+ (SIMPLE)<br/>Platform auth (kube-rbac-proxy)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        Operator["mlflow-operator Pod<br/>SA: mlflow-operator-controller-manager<br/>FIPS: strictfipsruntime"]

        HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No auth"]

        Metrics["Metrics Endpoint<br/>8443/TCP HTTPS<br/>authn/authz filter"]
    end

    subgraph TargetNS["TARGET NAMESPACE (configurable)"]
        direction TB

        MLflowServer["MLflow Server Pod<br/>SA: mlflow-sa<br/>8443/TCP HTTPS<br/>TLS: service-ca cert<br/>Auth: SelfSubjectAccessReview"]

        TLSSecret["mlflow-tls Secret<br/>kubernetes.io/tls<br/>service-ca provisioned"]

        ArtifactSecret["mlflow-artifact-connection<br/>Opaque<br/>Per-namespace S3/GCS creds"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (PGSSLMODE)<br/>Connection string auth"]

        S3["S3-Compatible Storage<br/>443/9000/8333/8334 TCP<br/>TLS 1.2+<br/>AWS IAM / credentials"]

        DNS["CoreDNS<br/>53/UDP,TCP<br/>No encryption"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        PlatformOp["opendatahub-operator /<br/>rhods-operator"]
        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
        Console["OpenShift Console<br/>(via ConsoleLink)"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Platform auth"| Gateway

    %% Ingress → MLflow
    Gateway -->|"HTTPS/8443<br/>TLS (service-ca)<br/>K8s auth token"| MLflowServer

    %% Operator → K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% MLflow → External Services
    MLflowServer -->|"PostgreSQL/5432<br/>TLS (PGSSLMODE)<br/>Connection string"| PostgreSQL
    MLflowServer -->|"HTTPS/443,9000<br/>TLS 1.2+<br/>AWS IAM / creds"| S3
    MLflowServer -->|"DNS/53<br/>No encryption"| DNS
    Operator -->|"DNS/53<br/>No encryption"| DNS

    %% Platform interactions
    PlatformOp -.->|"Creates MLflowOperator CR"| Operator
    Prometheus -.->|"Scrapes /metrics<br/>HTTPS/8443"| Metrics

    %% Secret references
    TLSSecret -.->|"mounted"| MLflowServer
    ArtifactSecret -.->|"read by"| MLflowServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef target fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef secret fill:#f5f5f5,stroke:#666,stroke-dasharray:5

    class Client external
    class Gateway ingress
    class Operator,HealthProbes,Metrics operator
    class MLflowServer target
    class K8sAPI k8s
    class PostgreSQL,S3,DNS extsvc
    class PlatformOp,Prometheus,Console platform
    class TLSSecret,ArtifactSecret secret
