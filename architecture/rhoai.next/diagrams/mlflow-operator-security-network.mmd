graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Platform User / Data Scientist"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>443/TCP → 8443/TCP<br/>TLS SIMPLE (Gateway-terminated)<br/>kube-rbac-proxy auth"]
    end

    subgraph AppNamespace["APPLICATION NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["MLflow Operator Pod"]
            Operator["MLflow Operator<br/>SA: controller-manager<br/>8081/TCP health (HTTP)<br/>8443/TCP metrics (HTTPS)"]
            TLSWatcher["SecurityProfileWatcher<br/>OpenShift TLS profile sync"]
        end

        subgraph MLflowPod["MLflow Server Pod"]
            MLflow["MLflow Server<br/>SA: mlflow-sa<br/>8443/TCP (HTTPS)<br/>service-ca TLS certs<br/>kubernetes-auth (SSAR)"]
            CAInit["Init: CA Bundle Aggregator"]
            CASidecar["Sidecar: CA Watcher"]
        end

        subgraph MigrationPod["Migration Job Pod (ephemeral)"]
            MigJob["mlflow_db_migrate.py<br/>NetworkPolicy: ingress DENY ALL<br/>egress: DNS + DB only"]
        end

        NP_Deploy["NetworkPolicy: MLflow Deployment<br/>Ingress: any namespace<br/>Egress: DNS, HTTPS, DB, S3"]
        NP_Migration["NetworkPolicy: Migration Job<br/>Ingress: DENY ALL<br/>Egress: DNS, DB only"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>ServiceAccount Token"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS optional (PGSSLMODE)<br/>DB credentials"]
        MySQL["MySQL<br/>3306/TCP<br/>TLS optional<br/>DB credentials"]
        S3["S3-Compatible Storage<br/>443/9000/8333/8334 TCP<br/>HTTPS/HTTP<br/>AWS IAM / access keys"]
        DNS["DNS<br/>53/TCP, 53/UDP<br/>5353/TCP, 5353/UDP"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>ServiceMonitor<br/>8443/TCP HTTPS<br/>service-ca verified"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS (Gateway-terminated)<br/>kube-rbac-proxy"| Gateway
    Gateway -->|"HTTPS/8443<br/>service-ca TLS<br/>SSAR auth"| MLflow

    %% Operator flows
    Operator -->|"HTTPS/6443<br/>TLS<br/>SA Token"| K8sAPI
    Operator -.->|"manages lifecycle"| MLflow
    Operator -.->|"creates (ephemeral)"| MigJob

    %% MLflow egress
    MLflow -->|"TCP/5432<br/>TLS optional<br/>DB creds"| PostgreSQL
    MLflow -->|"HTTPS/443+<br/>TLS optional<br/>IAM/keys"| S3
    MLflow -->|"DNS/53"| DNS

    %% Migration egress (strict)
    MigJob -->|"TCP/5432 or 3306<br/>TLS optional<br/>DB creds"| PostgreSQL
    MigJob -->|"DNS/53"| DNS

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer Token"| Operator

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef migration fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef netpol fill:#e1d5e7,stroke:#9673a6,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class Gateway ingress
    class Operator,MLflow,CAInit,CASidecar,TLSWatcher app
    class MigJob migration
    class K8sAPI,PostgreSQL,MySQL,S3,DNS externalservice
    class Prometheus monitoring
    class NP_Deploy,NP_Migration netpol
