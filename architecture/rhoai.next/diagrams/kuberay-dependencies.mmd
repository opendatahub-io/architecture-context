graph LR
    KubeRay["KubeRay Operator"]

    %% External Dependencies (Required)
    KubeRay -->|"controller framework<br/>(required)"| ControllerRuntime["controller-runtime<br/>v0.22.4"]

    %% External Dependencies (Optional)
    KubeRay -->|"mTLS certificates<br/>(optional)"| CertManager["cert-manager<br/>v1.18.2"]
    KubeRay -->|"HTTPRoute ingress<br/>(optional, OpenShift)"| GatewayAPI["gateway-api<br/>v1.4.1"]
    KubeRay -->|"Route API, cluster config<br/>(optional, OpenShift)"| OpenShiftAPI["openshift/api"]
    KubeRay -->|"batch scheduling<br/>(optional)"| SchedulerPlugins["scheduler-plugins<br/>v0.33.5"]
    KubeRay -->|"gang scheduling<br/>(optional)"| Volcano["volcano.sh/apis<br/>v1.13.0"]
    KubeRay -->|"cron expressions<br/>(optional)"| RobfigCron["robfig/cron/v3<br/>v3.0.1"]
    KubeRay -->|"OIDC auth sidecar<br/>(optional, OpenShift)"| KubeRBACProxy["kube-rbac-proxy"]

    %% Internal RHOAI Dependencies
    RHODSOperator["rhods-operator /<br/>opendatahub-operator"] -->|"kustomize deploy"| KubeRay
    KubeRay -->|"HTTPRoute parent ref<br/>(auth)"| PlatformGateway["Platform Gateway<br/>(data-science-gateway)"]
    KubeRay -->|"job submission<br/>status polling"| RayDashboard["Ray Dashboard API<br/>8265/TCP"]

    %% Integration Points (incoming)
    CodeFlare["CodeFlare Operator"] -->|"external webhooks<br/>mraycluster/vraycluster"| KubeRay
    Prometheus["Prometheus"] -->|"metrics scrape<br/>8080/TCP"| KubeRay

    %% Integration Points (batch schedulers)
    KubeRay -.->|"PodGroups"| KaiScheduler["Kai-scheduler"]
    KubeRay -.->|"task group annotations"| Yunikorn["Yunikorn"]

    %% External Services
    KubeRay -->|"GCS fault tolerance<br/>6379/TCP"| Redis["Redis<br/>(external, optional)"]
    KubeRay -->|"resource CRUD<br/>443/TCP"| K8sAPI["Kubernetes API"]

