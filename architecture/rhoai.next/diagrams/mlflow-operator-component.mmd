graph TB
    subgraph OperatorPod["mlflow-operator-controller-manager (Deployment)"]
        direction TB
        MLflowReconciler["MLflowReconciler<br/>(Go Controller)"]
        MLflowOperatorReconciler["MLflowOperatorReconciler<br/>(Go Controller)"]
        NamespaceRBACReconciler["NamespaceRBACReconciler<br/>(Go Controller)"]
        HelmRenderer["Helm Chart Renderer<br/>(In-Process)"]
        SecurityProfileWatcher["SecurityProfileWatcher<br/>(TLS Profile Monitor)"]
        MetricsServer["Metrics Server<br/>8443/TCP HTTPS"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP"]
    end

    %% CRDs
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)<br/>Cluster-Scoped"]
    MLflowOperatorCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-Scoped"]
    MLflowConfigCR["MLflowConfig CR<br/>(mlflow.kubeflow.org/v1)<br/>Namespace-Scoped"]

    %% Managed Resources
    subgraph ManagedResources["Managed MLflow Resources"]
        direction TB
        TrackingDeployment["MLflow Tracking<br/>Deployment"]
        ArtifactDeployment["Artifact Server<br/>Deployment"]
        MigrationJob["DB Migration<br/>Job"]
        GCCronJob["Garbage Collection<br/>CronJob"]
        ArchivalCronJob["Trace Archival<br/>CronJob"]
        HTTPRoutes["HTTPRoutes<br/>(Gateway API)"]
        NetworkPolicies["NetworkPolicies"]
        RoleBindings["Workspace<br/>RoleBindings"]
    end

    %% Controller → CRD watches
    MLflowCR -->|"watched by"| MLflowReconciler
    MLflowOperatorCR -->|"watched by"| MLflowOperatorReconciler
    MLflowReconciler -->|"reads"| MLflowConfigCR

    %% Internal flows
    MLflowReconciler -->|"renders chart"| HelmRenderer
    HelmRenderer -->|"produces manifests"| ManagedResources

    %% Namespace RBAC
    NamespaceRBACReconciler -->|"distributes"| RoleBindings

    %% External dependencies
    KubeAPI["Kubernetes API<br/>6443/TCP"]
    GatewayAPI["Gateway API<br/>(data-science-gateway)"]
    OpenShiftConsole["OpenShift Console<br/>(ConsoleLink)"]
    Prometheus["Prometheus<br/>(ServiceMonitor)"]
    AuthCR["Auth CR<br/>(services.platform.opendatahub.io)"]
    OpenShiftTLS["OpenShift TLS Profile<br/>(config.openshift.io)"]

    MLflowReconciler -->|"CRUD via"| KubeAPI
    MLflowReconciler -->|"creates"| HTTPRoutes
    HTTPRoutes -->|"routes to"| GatewayAPI
    MLflowReconciler -->|"creates"| OpenShiftConsole
    MLflowReconciler -->|"creates"| Prometheus
    NamespaceRBACReconciler -->|"reads subjects"| AuthCR
    SecurityProfileWatcher -->|"watches"| OpenShiftTLS

    %% Prometheus scraping
    Prometheus -.->|"scrapes"| MetricsServer

    %% Styles
    style MLflowReconciler fill:#4a90e2,color:#fff
    style MLflowOperatorReconciler fill:#4a90e2,color:#fff
    style NamespaceRBACReconciler fill:#4a90e2,color:#fff
    style HelmRenderer fill:#4a90e2,color:#fff
    style SecurityProfileWatcher fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style HealthProbes fill:#4a90e2,color:#fff
    style MLflowCR fill:#f5a623,color:#000
    style MLflowOperatorCR fill:#f5a623,color:#000
    style MLflowConfigCR fill:#f5a623,color:#000
    style TrackingDeployment fill:#7ed321,color:#000
    style ArtifactDeployment fill:#7ed321,color:#000
    style MigrationJob fill:#7ed321,color:#000
    style GCCronJob fill:#7ed321,color:#000
    style ArchivalCronJob fill:#7ed321,color:#000
    style HTTPRoutes fill:#7ed321,color:#000
    style NetworkPolicies fill:#7ed321,color:#000
    style RoleBindings fill:#7ed321,color:#000
    style KubeAPI fill:#e8e8e8,color:#000
    style GatewayAPI fill:#e8e8e8,color:#000
    style OpenShiftConsole fill:#e8e8e8,color:#000
    style Prometheus fill:#e8e8e8,color:#000
    style AuthCR fill:#e8e8e8,color:#000
    style OpenShiftTLS fill:#e8e8e8,color:#000
