graph TB
    subgraph MLflowOperator["MLflow Operator"]
        direction TB

        subgraph Controllers["Controllers"]
            MLflowReconciler["MLflowReconciler<br/>(Primary Controller)<br/>Reconciles MLflow CRs"]
            MLflowOperatorReconciler["MLflowOperatorReconciler<br/>(Module Handoff Controller)<br/>Manages MLflowOperator CR"]
            NamespaceRBACReconciler["NamespaceRBACReconciler<br/>(Workspace RBAC Controller)<br/>Per-namespace RoleBindings"]
        end

        subgraph Libraries["Libraries"]
            HelmRenderer["HelmRenderer<br/>Renders embedded<br/>Helm chart"]
            SecurityProfileWatcher["SecurityProfileWatcher<br/>Watches TLS profile<br/>changes"]
        end

        MLflowReconciler -->|renders chart| HelmRenderer
        MLflowReconciler -->|reads TLS config| SecurityProfileWatcher
    end

    %% CRDs
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)<br/>Cluster-scoped"]
    MLflowOperatorCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    AuthCR["Auth CR<br/>(services.platform.opendatahub.io/v1alpha1)"]

    %% CRD Watches
    MLflowCR -->|watched by| MLflowReconciler
    MLflowOperatorCR -->|watched by| MLflowOperatorReconciler
    AuthCR -->|watched by| NamespaceRBACReconciler
    MLflowCR -->|watched by| NamespaceRBACReconciler

    %% Created Resources
    MLflowReconciler -->|Server-Side Apply| ManagedResources["Managed Resources<br/>Deployment, Service,<br/>NetworkPolicy, SA, RBAC,<br/>PVC, ServiceMonitor, CronJob"]
    MLflowReconciler -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    MLflowReconciler -->|creates| ConsoleLink["ConsoleLink<br/>(OpenShift)"]
    MLflowReconciler -->|creates| MigrationJob["Migration Job<br/>(on version change)"]

    NamespaceRBACReconciler -->|creates| RoleBindings["Workspace RoleBindings<br/>(mlflow-view, mlflow-edit)"]

    %% Platform Dependencies
    PlatformOp["opendatahub-operator /<br/>rhods-operator"] -->|creates| MLflowOperatorCR
    MLflowOperatorReconciler -->|reads gateway config| MLflowOperatorCR

    %% External Dependencies
    HTTPRoute -->|references| Gateway["data-science-gateway<br/>(openshift-ingress)"]

    %% Health/Metrics
    HealthProbe["Health Probes<br/>:8081/healthz, /readyz"]
    MetricsEndpoint["Metrics Endpoint<br/>:8443/metrics (HTTPS)"]

    MLflowOperator --- HealthProbe
    MLflowOperator --- MetricsEndpoint

    %% Styling
    style MLflowReconciler fill:#4a90e2,stroke:#333,color:#fff
    style MLflowOperatorReconciler fill:#4a90e2,stroke:#333,color:#fff
    style NamespaceRBACReconciler fill:#4a90e2,stroke:#333,color:#fff
    style HelmRenderer fill:#50b5e9,stroke:#333,color:#fff
    style SecurityProfileWatcher fill:#50b5e9,stroke:#333,color:#fff
    style MLflowCR fill:#f5a623,stroke:#333
    style MLflowOperatorCR fill:#f5a623,stroke:#333
    style AuthCR fill:#f5a623,stroke:#333
    style ManagedResources fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style ConsoleLink fill:#7ed321,stroke:#333
    style MigrationJob fill:#7ed321,stroke:#333
    style RoleBindings fill:#7ed321,stroke:#333
    style PlatformOp fill:#e8e8e8,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
