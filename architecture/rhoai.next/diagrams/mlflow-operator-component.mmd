graph TB
    subgraph "MLflow Operator"
        direction TB
        MLflowReconciler["MLflowReconciler<br/>Go Controller"]
        MLflowOperatorReconciler["MLflowOperatorReconciler<br/>Module CR Controller"]
        NamespaceRBACReconciler["NamespaceRBACReconciler<br/>Workspace RBAC Controller"]
        HelmRenderer["Helm Chart Renderer<br/>(embedded charts/mlflow)"]
        MigrationOrchestrator["Migration Orchestrator<br/>DB version checks + Job mgmt"]
        RoutingManager["Routing Manager<br/>HTTPRoute + ConsoleLink"]
        TLSProfileWatcher["SecurityProfileWatcher<br/>TLS profile sync"]

        MLflowReconciler -->|renders| HelmRenderer
        MLflowReconciler -->|orchestrates| MigrationOrchestrator
        MLflowReconciler -->|manages| RoutingManager
        MLflowOperatorReconciler -->|projects config to| MLflowReconciler
        TLSProfileWatcher -->|restarts on change| MLflowReconciler
    end

    %% CRDs
    MLflowCR["MLflow CR<br/>mlflow.opendatahub.io/v1"]
    MLflowOperatorCR["MLflowOperator CR<br/>components.platform.opendatahub.io/v1alpha1"]
    AuthCR["Auth CR<br/>services.platform.opendatahub.io/v1alpha1"]

    %% Managed Resources
    subgraph "Managed Operands"
        direction TB
        MLflowDeployment["MLflow Server<br/>Deployment"]
        MLflowService["MLflow Service<br/>ClusterIP 8443/TCP"]
        NetworkPolicy["NetworkPolicy<br/>(ingress/egress rules)"]
        PVC["PersistentVolumeClaim"]
        ServiceMonitor["ServiceMonitor<br/>Prometheus metrics"]
        GCCronJob["GC CronJob<br/>(conditional)"]
        TraceCronJob["Trace Archival CronJob<br/>(conditional)"]
    end

    subgraph "Routing Resources"
        HTTPRoute["HTTPRoute<br/>Gateway API"]
        ConsoleLink["ConsoleLink<br/>OpenShift Console"]
    end

    subgraph "Workspace RBAC"
        ViewRoleBinding["odh-group-mlflow-view<br/>RoleBinding"]
        EditRoleBinding["odh-group-mlflow-edit<br/>RoleBinding"]
    end

    %% Flows
    MLflowCR -->|watched by| MLflowReconciler
    MLflowOperatorCR -->|watched by| MLflowOperatorReconciler
    AuthCR -->|watched by| NamespaceRBACReconciler

    HelmRenderer -->|creates| MLflowDeployment
    HelmRenderer -->|creates| MLflowService
    HelmRenderer -->|creates| NetworkPolicy
    HelmRenderer -->|creates| PVC
    HelmRenderer -->|creates| ServiceMonitor
    HelmRenderer -->|creates| GCCronJob
    HelmRenderer -->|creates| TraceCronJob

    RoutingManager -->|creates| HTTPRoute
    RoutingManager -->|creates| ConsoleLink

    NamespaceRBACReconciler -->|creates| ViewRoleBinding
    NamespaceRBACReconciler -->|creates| EditRoleBinding

    MigrationOrchestrator -->|scales down/up| MLflowDeployment

    %% External Dependencies
    HTTPRoute -->|parent ref| Gateway["data-science-gateway<br/>(Gateway CR)"]
    MLflowDeployment -->|connects to| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    MLflowDeployment -->|stores artifacts| S3["S3-compatible Storage<br/>443/TCP"]

    %% Styling
    style MLflowReconciler fill:#4a90e2,stroke:#333,color:#fff
    style MLflowOperatorReconciler fill:#4a90e2,stroke:#333,color:#fff
    style NamespaceRBACReconciler fill:#4a90e2,stroke:#333,color:#fff
    style HelmRenderer fill:#4a90e2,stroke:#333,color:#fff
    style MigrationOrchestrator fill:#4a90e2,stroke:#333,color:#fff
    style RoutingManager fill:#4a90e2,stroke:#333,color:#fff
    style TLSProfileWatcher fill:#4a90e2,stroke:#333,color:#fff
    style MLflowCR fill:#f5a623,stroke:#333,color:#fff
    style MLflowOperatorCR fill:#f5a623,stroke:#333,color:#fff
    style AuthCR fill:#f5a623,stroke:#333,color:#fff
    style MLflowDeployment fill:#7ed321,stroke:#333
    style MLflowService fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style PVC fill:#7ed321,stroke:#333
    style ServiceMonitor fill:#7ed321,stroke:#333
    style GCCronJob fill:#7ed321,stroke:#333
    style TraceCronJob fill:#7ed321,stroke:#333
    style HTTPRoute fill:#9b59b6,stroke:#333,color:#fff
    style ConsoleLink fill:#9b59b6,stroke:#333,color:#fff
    style ViewRoleBinding fill:#e67e22,stroke:#333,color:#fff
    style EditRoleBinding fill:#e67e22,stroke:#333,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
