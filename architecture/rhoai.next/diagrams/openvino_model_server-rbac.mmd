graph TD
    subgraph OVMSPod["OVMS Pod Security Context"]
        direction TB
        Container["OVMS Container<br/>User: ovms (UID 5000)<br/>Non-root<br/>No privilege escalation<br/>All capabilities dropped"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB
        APIKey["API Key Auth<br/>(Optional)<br/>Single shared key<br/>via --api_key flag<br/>Authorization: Bearer header"]
        KubeRBAC["kube-rbac-proxy Sidecar<br/>(RHOAI 3.x)<br/>SubjectAccessReview<br/>Kubernetes RBAC enforcement"]
    end

    subgraph EndpointAuth["Endpoint Authentication Matrix"]
        direction TB
        AuthRequired["Authenticated Endpoints<br/>(API Key optional OR kube-rbac-proxy)"]
        NoAuth["Unauthenticated Endpoints<br/>(Always open)"]
    end

    subgraph AuthEndpoints["REST API Endpoints (auth optional)"]
        TFS["/v1/* TFS API<br/>predict, classify, regress"]
        KServeV2["/v2/* KServe v2 API<br/>infer, metadata"]
        OpenAI["/v3/* OpenAI API<br/>chat, completions, embeddings<br/>images, audio, rerank"]
    end

    subgraph UnauthEndpoints["Health & Metrics (always open)"]
        HealthReady["/v2/health/ready<br/>Readiness probe"]
        HealthLive["/v2/health/live<br/>Liveness probe"]
        MetricsEP["/metrics<br/>Prometheus scraping"]
    end

    subgraph DelegatedRBAC["Platform-Managed RBAC"]
        direction TB
        KServeRBAC["KServe Controller<br/>Manages pod creation<br/>and service accounts"]
        RHOAIOp["RHOAI Operator<br/>Injects kube-rbac-proxy<br/>Creates Routes/HTTPRoutes"]
        NetworkPolicy["NetworkPolicy<br/>(if configured by<br/>platform operator)"]
    end

    subgraph StorageCreds["Storage Credentials (env vars)"]
        direction TB
        AWSCreds["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>(S3 access)"]
        AzureCreds["AZURE_STORAGE_<br/>CONNECTION_STRING<br/>(Azure access)"]
        GCPCreds["GCP Service Account<br/>JSON<br/>(GCS access)"]
        HFToken["HF_TOKEN<br/>(HuggingFace, optional)"]
    end

    %% Connections
    APIKey -->|"protects"| AuthRequired
    KubeRBAC -->|"protects"| AuthRequired
    AuthRequired --> TFS
    AuthRequired --> KServeV2
    AuthRequired --> OpenAI
    NoAuth --> HealthReady
    NoAuth --> HealthLive
    NoAuth --> MetricsEP

    KServeRBAC -->|"manages"| OVMSPod
    RHOAIOp -->|"configures"| KubeRBAC
    NetworkPolicy -.->|"restricts traffic"| OVMSPod

    KServeRBAC -->|"injects from<br/>Kubernetes Secrets"| StorageCreds

    %% Styling
    style Container fill:#4a90e2,color:#fff
    style APIKey fill:#f5a623,color:#fff
    style KubeRBAC fill:#f5a623,color:#fff
    style TFS fill:#7ed321,color:#fff
    style KServeV2 fill:#7ed321,color:#fff
    style OpenAI fill:#7ed321,color:#fff
    style HealthReady fill:#ff6b6b,color:#fff
    style HealthLive fill:#ff6b6b,color:#fff
    style MetricsEP fill:#ff6b6b,color:#fff
    style KServeRBAC fill:#e8e8e8,stroke:#333
    style RHOAIOp fill:#e8e8e8,stroke:#333
    style NetworkPolicy fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style AWSCreds fill:#fff2cc,stroke:#333
    style AzureCreds fill:#fff2cc,stroke:#333
    style GCPCreds fill:#fff2cc,stroke:#333
    style HFToken fill:#fff2cc,stroke:#333
