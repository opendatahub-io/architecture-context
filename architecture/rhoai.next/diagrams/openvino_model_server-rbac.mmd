graph TD
    subgraph OVMSAuth["OpenVINO Model Server — Auth & Access Model"]
        direction TB

        subgraph Note["RBAC Delegation"]
            RBACNote["OVMS does not define its own RBAC<br/>Kubernetes RBAC is managed by KServe<br/>for InferenceService pods"]
        end

        subgraph PodSecurity["Pod Security Context"]
            SC["Security Context<br/>runAsNonRoot: true<br/>UID: 5000<br/>capabilities: drop ALL<br/>allowPrivilegeEscalation: false"]
        end

        subgraph AppAuth["Application-Level Authentication"]
            direction TB
            APIKey["API Key Source<br/>--api_key_file or API_KEY env var"]

            subgraph RESTEndpoints["REST Endpoints"]
                AuthEndpoints["Authenticated Endpoints<br/>/v1/* (TFS API)<br/>/v2/models/* (KServe API)<br/>/v3/* (OpenAI API)<br/>Auth: Bearer Token (optional)"]
                NoAuthEndpoints["Unauthenticated Endpoints<br/>/v2/health/ready<br/>/v2/health/live<br/>/metrics<br/>Auth: None (always open)"]
            end

            subgraph GRPCEndpoints["gRPC Endpoints"]
                GRPCNoAuth["All gRPC Services<br/>PredictionService<br/>ModelService<br/>GRPCInferenceService<br/>Auth: None<br/>InsecureServerCredentials"]
            end
        end

        subgraph PlatformRBAC["Platform-Level RBAC (KServe)"]
            KServeSA["ServiceAccount<br/>Created per InferenceService"]
            KServeRoles["KServe Manager Roles<br/>serving.kserve.io/*<br/>get, list, watch, create,<br/>update, patch, delete"]
        end
    end

    APIKey -->|"validates Bearer header"| AuthEndpoints
    APIKey -.->|"not applicable"| GRPCNoAuth

    KServeSA -->|"bound to"| KServeRoles
    KServeRoles -->|"manages"| SC

    style RBACNote fill:#fff3cd,stroke:#856404,stroke-width:2px
    style SC fill:#d5e8d4,stroke:#82b366
    style APIKey fill:#4a90e2,stroke:#333,color:#fff
    style AuthEndpoints fill:#dae8fc,stroke:#6c8ebf
    style NoAuthEndpoints fill:#f8d7da,stroke:#721c24
    style GRPCNoAuth fill:#f8d7da,stroke:#721c24
    style KServeSA fill:#e8e8e8,stroke:#333
    style KServeRoles fill:#e8e8e8,stroke:#333
