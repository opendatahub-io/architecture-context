graph TD
    subgraph ContainerIdentity["Container Identity"]
        OVMS["OVMS Container<br/>UID: 5000 (non-root)<br/>No K8s API access"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB

        subgraph PlatformAuth["Platform-Level Auth (External to OVMS)"]
            PlatformIngress["Platform Ingress<br/>(Gateway API / kube-rbac-proxy)<br/>Handles platform authentication"]
        end

        subgraph AppAuth["Application-Level Auth (OVMS Internal)"]
            V3Auth["v3 API Bearer Token<br/>Validated against --api_key_file<br/>or API_KEY env var"]
            V1V2Auth["v1/v2 API<br/>No application auth"]
            MetricsAuth["GET /metrics<br/>No auth"]
        end
    end

    subgraph Secrets["Secrets (Logical Names)"]
        APIKey["api-key<br/>Type: Opaque<br/>Purpose: v3 endpoint auth<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        HFToken["hf-token<br/>Type: Opaque<br/>Purpose: HuggingFace auth<br/>Provisioned: Manual (HF_TOKEN env)<br/>Auto-Rotate: No"]
        AWSCreds["aws-credentials<br/>Type: Opaque<br/>Purpose: AWS S3 access<br/>Provisioned: Manual (AWS env vars)<br/>Auto-Rotate: No"]
        GCSCreds["gcs-credentials<br/>Type: Opaque<br/>Purpose: GCS access<br/>Provisioned: Manual (ADC)<br/>Auto-Rotate: No"]
        AzureCreds["azure-credentials<br/>Type: Opaque<br/>Purpose: Azure storage<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
    end

    subgraph ManagedBy["RBAC Managed By (External)"]
        KServeRBAC["KServe<br/>Manages pod ServiceAccount<br/>and RBAC for InferenceService"]
        RHOAIOpRBAC["RHOAI Operator<br/>Manages ServingRuntime<br/>permissions"]
    end

    subgraph NoKubeRBAC["Kubernetes RBAC"]
        NoRoles["No ClusterRoles defined<br/>No RoleBindings defined<br/>OVMS does not interact<br/>with Kubernetes API"]
    end

    %% Flows
    PlatformIngress -->|"validates platform auth<br/>before reaching OVMS"| OVMS
    V3Auth -->|"validates Bearer Token<br/>on /v3/* requests"| OVMS
    V1V2Auth -->|"no auth required"| OVMS
    APIKey -->|"provides API key"| V3Auth
    HFToken -->|"HF_TOKEN env"| OVMS
    AWSCreds -->|"AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"| OVMS
    GCSCreds -->|"GOOGLE_APPLICATION_CREDENTIALS"| OVMS
    AzureCreds -->|"AZURE_STORAGE_CONNECTION_STRING"| OVMS
    KServeRBAC -.->|"manages pod identity"| OVMS
    RHOAIOpRBAC -.->|"manages runtime config"| OVMS

    %% Styling
    style OVMS fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style PlatformIngress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style V3Auth fill:#d5e8d4,stroke:#82b366
    style V1V2Auth fill:#f8cecc,stroke:#b85450
    style MetricsAuth fill:#f8cecc,stroke:#b85450
    style APIKey fill:#fff2cc,stroke:#d6b656
    style HFToken fill:#fff2cc,stroke:#d6b656
    style AWSCreds fill:#fff2cc,stroke:#d6b656
    style GCSCreds fill:#fff2cc,stroke:#d6b656
    style AzureCreds fill:#fff2cc,stroke:#d6b656
    style NoRoles fill:#e8e8e8,stroke:#999
    style KServeRBAC fill:#7ed321,stroke:#333,color:#fff
    style RHOAIOpRBAC fill:#7ed321,stroke:#333,color:#fff
