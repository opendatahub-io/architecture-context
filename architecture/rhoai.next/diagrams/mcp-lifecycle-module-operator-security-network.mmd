graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph OperatorNS["Module Operator Namespace"]
            ModuleOp["mcp-lifecycle-module-operator<br/>SA: ...-controller-manager<br/>8081/TCP health (HTTP, no auth)<br/>runAsNonRoot, 65532:65532<br/>FIPS: strictfipsruntime<br/>Crypto: DEFAULT:PQ"]
        end

        subgraph OperandNS["Operand Namespace (same namespace)"]
            OperandCtrl["mcp-lifecycle-operator<br/>SA: ...-controller-manager<br/>8081/TCP health (HTTP)"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>kube-rbac-proxy<br/>Auth: TokenReview + SAR"]
            WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP HTTPS<br/>cert-manager TLS<br/>Auth: K8s admission"]
            NetPol["NetworkPolicy<br/>deny-by-default ingress<br/>(restricted posture)"]

            OperandCtrl --- MetricsSvc
            OperandCtrl --- WebhookSvc
        end

        subgraph ControlPlane["Kubernetes Control Plane"]
            APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforcement"]
        end

        subgraph PlatformComponents["Platform Components"]
            PlatformOp["ODH Platform Operator"]
            CertManager["cert-manager<br/>Provisions webhook TLS cert<br/>Auto-rotate"]
            KSVM["kube-storage-version-migrator<br/>Re-encodes MCPServer to v1beta1"]
            Prometheus["prometheus-operator<br/>Scrapes via ServiceMonitor"]
        end

        subgraph OSConfig["OpenShift Configuration"]
            TLSProfile["APIServer CR<br/>TLS Profile<br/>(Intermediate default)"]
        end
    end

    %% Module operator flows
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>SSA apply, CRUD, watch"| APIServer
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>Read TLS profile"| TLSProfile

    %% Platform operator flows
    PlatformOp -->|"HTTPS/6443<br/>Creates MCPLifecycleOperator CR<br/>Reads status.releases"| APIServer

    %% cert-manager
    CertManager -->|"Provisions<br/>mcplo-webhook-server-cert"| WebhookSvc

    %% Storage migration
    KSVM -->|"HTTPS/6443<br/>Re-encode MCPServer objects"| APIServer

    %% Metrics scraping
    Prometheus -->|"HTTPS/8443<br/>TokenReview + SAR"| MetricsSvc

    %% Webhook calls from API server
    APIServer -->|"HTTPS/443→9443<br/>Admission webhooks<br/>(validate, convert)"| WebhookSvc

    %% Operand to API server
    OperandCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| APIServer

    %% Styling
    classDef operator fill:#4a90e2,stroke:#2c5f9e,color:#fff,stroke-width:2px
    classDef operand fill:#7ed321,stroke:#5a9e17,color:#fff,stroke-width:2px
    classDef service fill:#50c878,stroke:#3a9659,color:#fff,stroke-width:1px
    classDef controlplane fill:#f5a623,stroke:#c7841a,color:#fff,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#999,stroke-width:1px
    classDef security fill:#ff6b6b,stroke:#cc5555,color:#fff,stroke-width:2px
    classDef config fill:#ddd,stroke:#999,stroke-width:1px

    class ModuleOp operator
    class OperandCtrl operand
    class MetricsSvc,WebhookSvc service
    class APIServer controlplane
    class PlatformOp,CertManager,KSVM,Prometheus platform
    class NetPol security
    class TLSProfile config
