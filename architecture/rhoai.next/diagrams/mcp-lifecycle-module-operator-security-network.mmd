graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph OperatorNS["Namespace: {operator-namespace}"]
            direction TB

            ModuleOp["MCP Lifecycle Module Operator<br/>SA: controller-manager<br/>FIPS: strictfipsruntime<br/>Limits: 500m CPU, 512Mi mem"]
            MetricsService["controller-manager-<br/>metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS + TLS<br/>Bearer Token"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
            NetPolicy["NetworkPolicy<br/>allow-metrics-traffic<br/>Ingress: 8443/TCP from<br/>ns with metrics=enabled"]

            Operand["MCP Lifecycle Operator<br/>(Operand Deployment)<br/>TLS injected from cluster profile<br/>Manages MCPServer CRs"]
        end

        subgraph MonitoringNS["Namespace: monitoring"]
            Prometheus["Prometheus<br/>ServiceMonitor<br/>TokenReview + SAR"]
        end

        subgraph KubeSystem["Control Plane"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
            Kubelet["Kubelet<br/>Health Checks"]
        end

        subgraph OpenShiftConfig["OpenShift Config"]
            APIServerCR["APIServer CR<br/>config.openshift.io/v1<br/>TLS Profile: Intermediate"]
        end
    end

    %% Health probe flow
    Kubelet -->|HTTP/8081<br/>No Auth<br/>No Encryption| HealthProbes
    HealthProbes ---|/healthz, /readyz| ModuleOp

    %% Metrics flow
    Prometheus -->|HTTPS/8443<br/>TLS<br/>Bearer Token| MetricsService
    MetricsService ---|/metrics| ModuleOp

    %% K8s API flows
    ModuleOp -->|HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>CR watches, SSA apply,<br/>status patches| K8sAPI
    ModuleOp -->|HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Read TLS profile| APIServerCR

    %% Operand deployment
    ModuleOp -.->|Deploys via SSA<br/>Deployment, SA, RBAC,<br/>CRD, Service, NetPol| Operand

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef operand fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef infra fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef security fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class ModuleOp operator
    class Operand operand
    class MetricsService,HealthProbes,NetPolicy security
    class Prometheus monitoring
    class K8sAPI,Kubelet,APIServerCR controlplane
