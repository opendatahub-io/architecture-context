graph TB
    subgraph Cluster["KUBERNETES CLUSTER (Internal Only — No External Ingress/Egress)"]
        direction TB

        subgraph NS_Platform["Platform Operator Namespace"]
            PlatformOp["ODH Platform Operator<br/>(odh-operator / rhods-operator)<br/>Creates MCPLifecycleOperator CR"]
        end

        subgraph NS_Module["Namespace: mcp-lifecycle-module-operator-system"]
            ModuleOp["MCP Lifecycle Module Operator<br/>SA: controller-manager<br/>FIPS: strictfipsruntime + CGO<br/>Probes: /healthz, /readyz 8081/TCP"]
        end

        subgraph NS_Operand["Namespace: mcp-lifecycle-operator-system"]
            OperandDeploy["MCP Lifecycle Operator<br/>(Operand Deployment, 1 replica)<br/>SA: mcp-lifecycle-operator-controller-manager<br/>TLS: Injected from APIServer profile"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>Auth: kube-rbac-proxy<br/>(TokenReview + SubjectAccessReview)"]
            NetPol["NetworkPolicy:<br/>allow-metrics-traffic<br/>8081/TCP (probes)<br/>8443/TCP (metrics)"]
            MCPServerCRD["MCPServer CRD<br/>mcp.x-k8s.io<br/>(Namespaced)"]

            OperandDeploy --- MetricsSvc
            OperandDeploy -->|manages| MCPServerCRD
            NetPol -.->|protects| OperandDeploy
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: ServiceAccount Token"]

        subgraph ClusterConfig["Cluster Configuration"]
            OSAPIServer["OpenShift APIServer CR<br/>config.openshift.io/apiservers<br/>Provides: TLS Profile<br/>(min version + cipher suites)"]
            ConfigMap["ConfigMap<br/>odh-mcplifecycleoperator-config<br/>Provides: platformVersion"]
        end

        Prometheus["Prometheus<br/>(via ServiceMonitor)"]

        MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1<br/>managementState: Managed|Removed"]
    end

    %% Flows
    PlatformOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Creates/Updates CR"| MCPLifecycleOpCR
    MCPLifecycleOpCR -->|"Watch Event<br/>HTTPS/443<br/>TLS 1.2+"| ModuleOp
    ModuleOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Reads TLS profile"| OSAPIServer
    ModuleOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Reads platformVersion"| ConfigMap
    ModuleOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>SSA Apply: CRD, Deployment,<br/>RBAC, Service, NetworkPolicy,<br/>ServiceMonitor"| K8sAPI
    K8sAPI -->|"Deploys operand<br/>resources"| NS_Operand
    ModuleOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Status patch"| MCPLifecycleOpCR
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>(kube-rbac-proxy)"| MetricsSvc

    %% Styling
    classDef moduleop fill:#4a90e2,stroke:#2c5f9e,stroke-width:2px,color:#fff
    classDef operand fill:#7ed321,stroke:#5a9e18,stroke-width:2px,color:#fff
    classDef platform fill:#9b59b6,stroke:#7d3c98,stroke-width:2px,color:#fff
    classDef infra fill:#e8e8e8,stroke:#999,stroke-width:2px
    classDef crd fill:#f5a623,stroke:#c78418,stroke-width:2px,color:#fff
    classDef security fill:#e74c3c,stroke:#c0392b,stroke-width:1px,color:#fff

    class ModuleOp moduleop
    class OperandDeploy,MetricsSvc,MCPServerCRD operand
    class PlatformOp platform
    class K8sAPI,OSAPIServer,ConfigMap,Prometheus infra
    class MCPLifecycleOpCR crd
    class NetPol security
