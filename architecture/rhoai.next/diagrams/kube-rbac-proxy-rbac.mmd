graph TD
    subgraph "Service Account (per-component pod)"
        SA["Component ServiceAccount<br/>(e.g., dashboard-sa, modelmesh-sa)"]
    end

    subgraph "ClusterRoleBinding"
        CRB["ClusterRoleBinding<br/>(created by deploying operator)"]
    end

    subgraph "ClusterRole: kube-rbac-proxy"
        CR["kube-rbac-proxy ClusterRole<br/>(minimum required permissions)"]
    end

    subgraph "Kubernetes API Resources"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SubjectAccessReviews["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"create"| TokenReviews
    CR -->|"create"| SubjectAccessReviews

    subgraph "Hardcoded Authorization (no RBAC needed)"
        HardcodedSA["system:serviceaccount:<br/>openshift-monitoring:<br/>prometheus-k8s"]
        MetricsPath["GET /metrics"]
    end

    HardcodedSA -->|"always allowed<br/>(hardcoded in code)"| MetricsPath

    subgraph "Authorization Config (--config-file)"
        direction TB
        F1["Format1: resourceAttributes<br/>(top-level, simple)"]
        F2["Format2: endpoints<br/>(path-scoped, per-method)"]

        F1Config["namespace: {from header/query}<br/>apiGroup: {configured}<br/>resource: {configured}<br/>verb: {HTTP method mapping}"]
        F2Config["path: /api/v1/resource<br/>  GET → resource: pods, verb: get<br/>  POST → resource: pods, verb: create<br/>path: /api/v1/other<br/>  DELETE → resource: other, verb: delete"]

        F1 --> F1Config
        F2 --> F2Config
    end

    subgraph "SAR Decision (per-request)"
        SARRequest["SubjectAccessReview Request<br/>user: {authenticated identity}<br/>groups: {user groups}<br/>namespace: {from config/rewrite}<br/>resource: {from config}<br/>verb: {from config}"]
        SARResponse["SubjectAccessReview Response"]
        Allow["allowed: true → proxy to upstream"]
        Deny["allowed: false → HTTP 403 Forbidden"]
    end

    F1Config -->|"generates"| SARRequest
    F2Config -->|"generates"| SARRequest
    SARRequest -->|"K8s API evaluates"| SARResponse
    SARResponse -->|"allowed"| Allow
    SARResponse -->|"denied"| Deny

    %% SAR Caching
    subgraph "SAR Response Cache"
        AllowCache["Allow Cache: 5 minutes TTL"]
        DenyCache["Deny Cache: 30 seconds TTL"]
    end

    SARResponse -.->|"cached"| AllowCache
    SARResponse -.->|"cached"| DenyCache

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style CRB fill:#d4edda,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SubjectAccessReviews fill:#7ed321,stroke:#333
    style HardcodedSA fill:#e57373,stroke:#333,color:#fff
    style MetricsPath fill:#ffcdd2,stroke:#333
    style F1 fill:#bbdefb,stroke:#333
    style F2 fill:#bbdefb,stroke:#333
    style Allow fill:#c8e6c9,stroke:#333
    style Deny fill:#ffcdd2,stroke:#333
    style AllowCache fill:#e8e8e8,stroke:#333
    style DenyCache fill:#e8e8e8,stroke:#333
