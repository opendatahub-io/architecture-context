graph TD
    subgraph "Service Account"
        SA["kube-rbac-proxy<br/>(namespace: default)"]
    end

    subgraph "ClusterRole Bindings"
        CRB["kube-rbac-proxy<br/>ClusterRoleBinding"]
    end

    subgraph "ClusterRoles"
        CR_Proxy["kube-rbac-proxy<br/>ClusterRole"]
        CR_Metrics["metrics<br/>ClusterRole"]
    end

    subgraph "API Resources"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Non-Resource URLs"
        MetricsURL["/metrics"]
    end

    subgraph "Hardcoded Authorization"
        HardcodedSA["system:serviceaccount:<br/>openshift-monitoring:<br/>prometheus-k8s"]
        HardcodedRule["GET /metrics<br/>(bypass SAR)"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR_Proxy

    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR

    CR_Metrics -->|"get"| MetricsURL

    HardcodedSA -->|"hardcoded allow"| HardcodedRule

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#5b9bd5,stroke:#333,color:#fff
    style CR_Proxy fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style MetricsURL fill:#7ed321,stroke:#333
    style HardcodedSA fill:#ff6b6b,stroke:#333,color:#fff
    style HardcodedRule fill:#ff6b6b,stroke:#333,color:#fff
