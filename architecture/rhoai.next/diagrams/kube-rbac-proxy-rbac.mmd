graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kube-rbac-proxy<br/>(in component namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["kube-rbac-proxy<br/>(cluster-scoped)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["ClusterRole:<br/>kube-rbac-proxy"]
    end

    subgraph APIResources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph HardcodedPolicies["Hardcoded Authorization Policies"]
        HCMetrics["Hardcoded Metrics Authorizer"]
        PromSA["system:serviceaccount:<br/>openshift-monitoring:<br/>prometheus-k8s"]
        MetricsEndpoint["/metrics (GET)"]
    end

    subgraph AuthZConfig["Authorization Config (Format1 / Format2)"]
        Format1["Format1:<br/>Top-level resourceAttributes<br/>+ rewrites (header/query params)"]
        Format2["Format2:<br/>Path-scoped endpoint rules<br/>+ per-method SAR mappings"]
        TargetResources["Target K8s Resources<br/>(configured per deployment)"]
    end

    %% RBAC bindings
    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"create"| TokenReviews
    CR -->|"create"| SAR

    %% Hardcoded policies
    HCMetrics -->|"unconditionally allows"| PromSA
    PromSA -->|"GET"| MetricsEndpoint

    %% Authorization config
    Format1 -->|"SAR check against"| TargetResources
    Format2 -->|"SAR check against"| TargetResources

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CRB fill:#5ba3d9,color:#fff
    style CR fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style HCMetrics fill:#e8a838,color:#fff
    style PromSA fill:#f9f9f9,stroke:#999
    style MetricsEndpoint fill:#f9f9f9,stroke:#999
    style Format1 fill:#d5e8d4,stroke:#82b366
    style Format2 fill:#d5e8d4,stroke:#82b366
    style TargetResources fill:#e8e8e8,stroke:#666
