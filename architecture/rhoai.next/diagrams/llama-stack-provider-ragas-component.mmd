graph TB
    subgraph "llama-stack-provider-ragas"
        subgraph "Inline Provider"
            InlineEval["RagasEvaluatorInline<br/>(max_workers=1)"]
            LLMWrapper["LlamaStackLLM Wrapper<br/>(BaseRagasLLM)"]
            EmbedWrapper["LlamaStackEmbeddings Wrapper<br/>(BaseRagasEmbeddings)"]
            InlineEval --> LLMWrapper
            InlineEval --> EmbedWrapper
        end

        subgraph "Remote Provider"
            RemoteEval["RagasEvaluatorRemote"]
            KFPClient["KFP Client<br/>(kfp.Client)"]
            ImageResolver["Base Image Resolver<br/>(env / ConfigMap / default)"]
            RemoteEval --> KFPClient
            RemoteEval --> ImageResolver
        end

        Compat["compat.py<br/>(llama_stack / llama_stack_api)"]
        Config["config.py<br/>(InlineConfig / RemoteConfig)"]
        Constants["constants.py<br/>(Metrics: answer_relevancy,<br/>context_precision,<br/>faithfulness, context_recall)"]
    end

    Client[Client] -->|"POST /eval/run<br/>8321/TCP HTTP"| LlamaStack["Llama Stack Server<br/>(FastAPI/uvicorn:8321)"]
    LlamaStack -->|"in-process API"| InlineEval
    LlamaStack -->|"in-process API"| RemoteEval

    LLMWrapper -->|"in-process"| InferenceAPI["Llama Stack Inference API"]
    EmbedWrapper -->|"in-process"| InferenceAPI
    InlineEval -->|"in-process"| DatasetAPI["Llama Stack DatasetIO API"]

    KFPClient -->|"HTTPS/443<br/>Bearer token"| KFPServer["Kubeflow Pipelines"]
    RemoteEval -->|"HTTPS/443<br/>AWS IAM"| S3["S3 Storage"]

    ImageResolver -->|"HTTPS/443"| K8sAPI["Kubernetes API"]
    K8sAPI -->|"ConfigMap"| TrustyAI["TrustyAI Operator Config"]

    style InlineEval fill:#4a90e2,color:#fff
    style RemoteEval fill:#4a90e2,color:#fff
    style LLMWrapper fill:#4a90e2,color:#fff
    style EmbedWrapper fill:#4a90e2,color:#fff
    style KFPClient fill:#4a90e2,color:#fff
    style ImageResolver fill:#4a90e2,color:#fff
