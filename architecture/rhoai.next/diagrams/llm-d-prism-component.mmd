graph TB
    subgraph External["External Users"]
        User["AI Platform Engineer<br/>ML Engineer"]
    end

    subgraph CloudRun["Google Cloud Run (prism.llm-d.ai)"]
        subgraph BFF["Express Backend (BFF)"]
            Server["Express Server<br/>8080/TCP"]
            OAuth["OAuth Module<br/>(oauth.ts)"]
            IAM["IAM Module<br/>(iam.ts)"]
            GCSProxy["GCS Proxy<br/>(bucket-boundary checks)"]
            GIQProxy["GIQ Proxy<br/>(credential injection)"]
            ResultsStore["Results Store<br/>(submit, review, promote)"]
            RateLimit["Rate Limiter<br/>(express-rate-limit)"]
            PrefixCache["Prefix Cache API<br/>(5-min cache)"]
            PDDisagg["P/D Disaggregation API"]
            Regressions["Regressions API<br/>(5-min cache)"]
        end

        subgraph SPA["React 19 Frontend (Vite)"]
            Dashboard["Dashboard Views"]
            useGCS["useGCS Hook"]
            useGIQ["useGIQ Hook"]
            useAWS["useAWS Hook"]
            useLLMD["useLLMD Hook"]
            useDashboard["useDashboardData<br/>(merge hook)"]
            ResultsUI["Results Store UI"]
            Charts["Recharts Visualizations<br/>(scatter, comparison, tables)"]
        end
    end

    subgraph CloudServices["Google Cloud Services"]
        GCS["Google Cloud Storage<br/>(llm-d-benchmarks)"]
        GIQ["GKE Recommender API<br/>(GIQ)"]
    end

    subgraph AuthServices["Authentication Services"]
        GitHub["GitHub OAuth<br/>(api.github.com)"]
    end

    subgraph DataSources["External Data Sources"]
        S3["AWS S3<br/>(public benchmarks)"]
        GDrive["Google Drive/Sheets"]
    end

    subgraph InternalDeps["Internal Platform"]
        Benchmark["llm-d-benchmark<br/>(YAML data format)"]
    end

    %% User flows
    User -->|HTTPS/443| Server
    Server -->|serves static assets| SPA

    %% Frontend internal
    Dashboard --> useGCS
    Dashboard --> useGIQ
    Dashboard --> useAWS
    Dashboard --> useLLMD
    useGCS --> useDashboard
    useGIQ --> useDashboard
    useAWS --> useDashboard
    useLLMD --> useDashboard
    useDashboard --> Charts
    ResultsUI -->|/api/results| Server

    %% Backend modules
    Server --> OAuth
    Server --> RateLimit
    Server --> GCSProxy
    Server --> GIQProxy
    Server --> ResultsStore
    Server --> PrefixCache
    Server --> PDDisagg
    Server --> Regressions
    OAuth --> IAM

    %% External connections
    GCSProxy -->|HTTPS/443, ADC| GCS
    GIQProxy -->|HTTPS/443, ADC| GIQ
    ResultsStore -->|HTTPS/443, ADC| GCS
    OAuth -->|HTTPS/443| GitHub
    IAM -->|reads allowlists| GCS
    useAWS -->|HTTPS/443, public| S3
    useGCS -->|via /api/gcs| GCSProxy

    %% Data format dependency
    Benchmark -.->|benchmark_report_v0.2 YAML| GCS

