graph TB
    subgraph TrainerOperator["Trainer Operator (opendatahub namespace)"]
        direction TB
        Controller["trainer-controller-manager<br/>Go controller-runtime<br/>Ports: 8081, 8443, 9443, 10443"]
        Webhook["Webhook Server<br/>9443/TCP HTTPS"]
        Metrics["Metrics Server<br/>8443/TCP HTTPS"]
        StatusServer["Status Server<br/>10443/TCP HTTPS<br/>(feature-gated: TrainJobStatus)"]

        Controller --> Webhook
        Controller --> Metrics
        Controller --> StatusServer
    end

    subgraph PluginFramework["Runtime Plugin Framework"]
        direction LR
        TorchPlugin["Torch Plugin"]
        MPIPlugin["MPI Plugin"]
        DeepSpeedPlugin["DeepSpeed Plugin"]
        JobSetPlugin["JobSet Plugin"]
        CoSchedPlugin["CoScheduling Plugin"]
        VolcanoPlugin["Volcano Plugin"]
    end

    subgraph InitContainers["Init Containers"]
        DatasetInit["dataset-initializer<br/>Python"]
        ModelInit["model-initializer<br/>Python"]
    end

    subgraph CRDs["Custom Resources"]
        TrainJobCR["TrainJob CR"]
        TrainingRuntimeCR["TrainingRuntime CR"]
        ClusterRuntimeCR["ClusterTrainingRuntime CR"]
        OptimizationJobCR["OptimizationJob CR"]
    end

    User["User / Data Scientist"] -->|creates| TrainJobCR
    TrainJobCR -->|references| TrainingRuntimeCR
    TrainJobCR -->|references| ClusterRuntimeCR
    TrainJobCR -->|watched by| Controller

    Controller -->|resolves plugins| PluginFramework
    Controller -->|creates| JobSetWorkload["JobSet Workload"]
    Controller -->|reconciles| OptimizationJobCR

    JobSetWorkload -->|injects| DatasetInit
    JobSetWorkload -->|injects| ModelInit

    TrainingPod["Training Pod"] -->|pushes status| StatusServer

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|creates| JobSetCR["JobSet CRDs"]
    Controller -->|creates| PodGroupCR["PodGroup CRDs"]

    Prometheus["Prometheus<br/>(openshift-monitoring)"] -->|scrapes| Metrics
    CertController["cert-controller"] -->|rotates certs| Controller

    OptimizationJobCR -->|spawns trials via| Katib["Katib<br/>(hyperparameter tuning)"]

    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px
    style Webhook fill:#4a90e2,stroke:#333
    style Metrics fill:#4a90e2,stroke:#333
    style StatusServer fill:#4a90e2,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style TrainingRuntimeCR fill:#f5a623,stroke:#333
    style ClusterRuntimeCR fill:#f5a623,stroke:#333
    style OptimizationJobCR fill:#f5a623,stroke:#333
    style DatasetInit fill:#9b59b6,stroke:#333
    style ModelInit fill:#9b59b6,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style CertController fill:#e8e8e8,stroke:#333
    style Katib fill:#7ed321,stroke:#333
    style JobSetCR fill:#7ed321,stroke:#333
    style PodGroupCR fill:#7ed321,stroke:#333
