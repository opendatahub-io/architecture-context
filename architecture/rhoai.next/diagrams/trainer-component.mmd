graph TB
    subgraph TrainerOperator["Kubeflow Trainer Operator"]
        direction TB
        Controller["trainer-controller-manager<br/>Go Operator (controller-runtime)<br/>Port 8081 health, 8443 metrics"]
        Webhook["Validating Webhooks<br/>Port 9443/TCP HTTPS"]
        CertCtrl["cert-controller<br/>(open-policy-agent)"]

        Controller -->|serves| Webhook
        CertCtrl -->|provisions TLS cert| Webhook
    end

    subgraph RHOAIOverlay["RHOAI Overlay"]
        direction TB
        CTR_CUDA["ClusterTrainingRuntime<br/>torch-distributed-cuda"]
        CTR_ROCM["ClusterTrainingRuntime<br/>torch-distributed-rocm"]
        CTR_CPU["ClusterTrainingRuntime<br/>torch-distributed-cpu"]
        CTR_TH["ClusterTrainingRuntime<br/>training-hub variants"]
        ImageStreams["OpenShift ImageStreams<br/>Training Hub workbench images<br/>(CPU, CUDA, ROCm)"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1<br/>Namespaced"]
        TrainingRuntimeCR["TrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1<br/>Namespaced"]
        ClusterTrainingRuntimeCR["ClusterTrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1<br/>Cluster-scoped"]
    end

    subgraph RHAIFeatures["RHAI Downstream Features"]
        Progression["Progression Tracker<br/>Polls pod metrics HTTP/28080<br/>Stores progress in annotations"]
        NetPol["NetworkPolicy Manager<br/>Per-TrainJob pod isolation"]
    end

    subgraph Plugins["Runtime Plugin Framework"]
        PyTorch["PyTorch / torchrun"]
        MPI["MPI (OpenMPI)"]
        TorchTune["TorchTune"]
        DeepSpeed["DeepSpeed"]
        JobSetPlugin["JobSet Plugin"]
        CoSchedPlugin["Coscheduling Plugin"]
        VolcanoPlugin["Volcano Plugin"]
    end

    %% User interaction
    User["User / Data Scientist"] -->|creates| TrainJobCR
    TrainJobCR -->|references| TrainingRuntimeCR
    TrainJobCR -->|references| ClusterTrainingRuntimeCR

    %% Controller watches
    TrainJobCR -->|watched by| Controller
    TrainingRuntimeCR -->|watched by| Controller
    ClusterTrainingRuntimeCR -->|watched by| Controller

    %% Webhook validation
    TrainJobCR -->|validated by| Webhook
    TrainingRuntimeCR -->|validated by| Webhook
    ClusterTrainingRuntimeCR -->|validated by| Webhook

    %% Controller creates workloads
    Controller -->|builds via plugins| Plugins
    Controller -->|creates| JobSet["JobSet<br/>jobset.x-k8s.io/v1alpha2"]
    Controller -->|creates| PodGroup["PodGroup<br/>(gang scheduling)"]

    %% RHAI features
    Controller -->|invokes| Progression
    Controller -->|invokes| NetPol
    Progression -->|HTTP GET /metrics| TrainingPods["Training Pods"]
    NetPol -->|creates| NetworkPolicy["NetworkPolicy<br/>(per TrainJob)"]

    %% JobSet creates pods
    JobSet -->|orchestrates| TrainingPods

    %% External dependencies
    Controller -->|depends on| K8sAPI["Kubernetes API Server"]
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]
    Controller -->|metrics scraped by| Prometheus["Prometheus / OCP Monitoring<br/>PodMonitor 8443/TCP"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style CertCtrl fill:#4a90e2,stroke:#333,color:#fff
    style TrainJobCR fill:#f5a623,stroke:#333
    style TrainingRuntimeCR fill:#f5a623,stroke:#333
    style ClusterTrainingRuntimeCR fill:#f5a623,stroke:#333
    style CTR_CUDA fill:#7ed321,stroke:#333
    style CTR_ROCM fill:#7ed321,stroke:#333
    style CTR_CPU fill:#7ed321,stroke:#333
    style CTR_TH fill:#7ed321,stroke:#333
    style ImageStreams fill:#7ed321,stroke:#333
    style Progression fill:#9b59b6,stroke:#333,color:#fff
    style NetPol fill:#9b59b6,stroke:#333,color:#fff
    style JobSet fill:#e8e8e8,stroke:#333
    style PodGroup fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style TrainingPods fill:#3498db,stroke:#333,color:#fff
    style NetworkPolicy fill:#e74c3c,stroke:#333,color:#fff
