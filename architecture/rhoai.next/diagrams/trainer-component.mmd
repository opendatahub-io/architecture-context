    style Controller fill:#4a90e2,color:#fff
    style TorchPlugin fill:#6cb4ee
    style MPIPlugin fill:#6cb4ee
    style JobSetPlugin fill:#6cb4ee
    style CoSchedPlugin fill:#6cb4ee
    style VolcanoPlugin fill:#6cb4ee
    style PlainMLPlugin fill:#6cb4ee
    style Progression fill:#e88b3a,color:#fff
    style NetPolicy fill:#e88b3a,color:#fff
