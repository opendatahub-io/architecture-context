graph TB
    subgraph Trainer["Kubeflow Trainer Operator"]
        direction TB
        Controller["trainer-controller-manager<br/>(Go controller-runtime)"]

        subgraph Webhooks["Webhook Server :9443"]
            WHTrainJob["ValidateTrainJob"]
            WHRuntime["ValidateTrainingRuntime"]
            WHClusterRuntime["ValidateClusterTrainingRuntime"]
        end

        subgraph Plugins["Runtime Plugin Framework"]
            TorchPlugin["Torch Plugin<br/>(torchrun / TorchTune)"]
            MPIPlugin["MPI Plugin<br/>(OpenMPI / SSH)"]
            JobSetPlugin["JobSet Plugin<br/>(builds JobSet)"]
            CoSchedPlugin["CoScheduling Plugin<br/>(PodGroups)"]
            VolcanoPlugin["Volcano Plugin<br/>(PodGroups)"]
            PlainMLPlugin["PlainML Plugin<br/>(fallback)"]
        end

        subgraph RHAI["RHOAI Extensions (pkg/rhai)"]
            Progression["Progression Tracker<br/>(HTTP metrics polling)"]
            NetPolicy["NetworkPolicy Manager<br/>(per-TrainJob isolation)"]
        end

        Controller --> Webhooks
        Controller --> Plugins
        Controller --> RHAI
    end

    subgraph Initializers["Init Containers"]
        DatasetInit["dataset-initializer<br/>(Python)"]
        ModelInit["model-initializer<br/>(Python)"]
    end

    DataCache["data-cache<br/>(Rust sidecar)"]

    %% CRDs
    User["Data Scientist"] -->|creates| TrainJobCR["TrainJob CR"]
    TrainJobCR -->|watched by| Controller
    TrainJobCR -->|references| RuntimeCR

    subgraph CRDs["Custom Resources (trainer.kubeflow.org/v1alpha1)"]
        RuntimeCR["TrainingRuntime<br/>(namespaced)"]
        ClusterRuntimeCR["ClusterTrainingRuntime<br/>(cluster-scoped)"]
    end

    %% Output resources
    Controller -->|creates| JobSet["JobSet Resource"]
    Controller -->|creates| PodGroup["PodGroup<br/>(CoScheduling or Volcano)"]
    Controller -->|creates| MPISecret["MPI SSH Secret<br/>(ECDSA P-521)"]
    Controller -->|creates| MPIConfigMap["MPI Hostfile ConfigMap"]
    Controller -->|creates| NP["NetworkPolicy<br/>(RHOAI)"]

    JobSet -->|creates| TrainingPods["Training Pods"]
    TrainingPods --- DatasetInit
    TrainingPods --- ModelInit
    TrainingPods --- DataCache

    %% External dependencies
    Controller -->|depends on| JobSetCtrl["JobSet Controller"]
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer"]
    Controller -->|cert management| CertCtrl["cert-controller"]

    %% Metrics
    Prometheus["Prometheus"] -->|scrapes :8443| Controller
    Progression -->|polls :28080| TrainingPods

