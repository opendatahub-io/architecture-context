graph TB
    subgraph WBO["Workbenches Operator"]
        direction TB
        Reconciler["WorkbenchesReconciler<br/>Go controller-runtime"]
        KrustyEngine["Krusty Engine<br/>Manifest Rendering"]
        TLSBootstrap["TLS Bootstrap<br/>Auto-detect Provider"]

        subgraph Webhooks["Admission Webhooks :9443"]
            HWProfileWH["Hardware Profile Webhook<br/>/workbenches-hardware-profile"]
            ConnectionWH["Connection Notebook Webhook<br/>/workbenches-connection-notebook"]
            ConvertWH["Conversion Webhook<br/>/convert"]
        end

        subgraph Endpoints["Management Endpoints"]
            Health["/healthz :8081"]
            Ready["/readyz :8081"]
            Metrics["/metrics :8443<br/>TLS + TokenReview"]
        end

        Reconciler -->|renders manifests| KrustyEngine
        TLSBootstrap -->|configures TLS| Webhooks
    end

    %% CRDs
    WorkbenchesCR["Workbenches CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster-scoped Singleton"]
    NotebookCR["Notebook CR<br/>kubeflow.org/v1"]
    HardwareProfileCR["HardwareProfile CR<br/>infrastructure.opendatahub.io"]

    %% Flows
    WorkbenchesCR -->|watched by| Reconciler
    Reconciler -->|SSA applies| OperandResources["Operand Resources<br/>Deployments, RBAC,<br/>Services, ConfigMaps"]

    NotebookCR -->|CREATE/UPDATE| HWProfileWH
    NotebookCR -->|CREATE/UPDATE| ConnectionWH
    HWProfileWH -->|reads| HardwareProfileCR

    %% Baked Manifests
    BakedManifests["/opt/manifests<br/>Committed Upstream Manifests"]
    KrustyEngine -->|reads| BakedManifests

    %% External integrations
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    Reconciler -->|CRUD + watches| K8sAPI
    ConnectionWH -->|SubjectAccessReview| K8sAPI

    %% Operand stacks
    subgraph Operands["Managed Operand Stacks"]
        KFNotebook["Kubeflow Notebook Controller"]
        ODHNotebook["ODH Notebook Controller"]
        NotebookManifests["Notebook Manifests<br/>ODH / RHOAI overlays"]
    end

    Reconciler -->|deploys| Operands

    %% Styling
    style Reconciler fill:#4a90e2,color:#fff
    style HWProfileWH fill:#4a90e2,color:#fff
    style ConnectionWH fill:#4a90e2,color:#fff
    style ConvertWH fill:#4a90e2,color:#fff
    style WorkbenchesCR fill:#f5a623,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style HardwareProfileCR fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8,color:#333
    style BakedManifests fill:#d5e8d4,color:#333
    style KFNotebook fill:#7ed321,color:#fff
    style ODHNotebook fill:#7ed321,color:#fff
    style NotebookManifests fill:#7ed321,color:#fff
    style KrustyEngine fill:#4a90e2,color:#fff
    style TLSBootstrap fill:#4a90e2,color:#fff
