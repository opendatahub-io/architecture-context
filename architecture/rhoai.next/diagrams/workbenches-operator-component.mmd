graph TB
    subgraph WorkbenchesOperator["Workbenches Operator"]
        direction TB
        Controller["Workbenches Controller<br/>(Reconciler)"]
        HWWebhook["Hardware Profile Webhook<br/>POST /workbenches-hardware-profile<br/>9443/TCP HTTPS"]
        ConnWebhook["Notebook Connection Webhook<br/>POST /workbenches-connection-notebook<br/>9443/TCP HTTPS"]
        TLSBootstrap["TLS Bootstrap<br/>(Library)"]

        Controller --- TLSBootstrap
        HWWebhook --- TLSBootstrap
        ConnWebhook --- TLSBootstrap
    end

    %% CRDs
    WorkbenchesCR["Workbenches CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    NotebookCR["Notebook CR<br/>(kubeflow.org/v1)"]
    HardwareProfileCR["HardwareProfile CR<br/>(infrastructure.opendatahub.io)"]

    %% Platform Orchestrator
    Orchestrator["Platform Orchestrator<br/>(rhods-operator /<br/>opendatahub-operator)"]

    %% ConfigMap
    ConfigMap["odh-workbenches-config<br/>ConfigMap"]

    %% Deployed Components
    subgraph DeployedComponents["Deployed by Operator (SSA)"]
        KFNotebookCtrl["kf-notebook-controller<br/>Deployment"]
        ODHNotebookCtrl["odh-notebook-controller<br/>Deployment"]
        NotebookImages["Notebook ImageStreams<br/>(ODH / RHOAI variants)"]
    end

    %% Baked-in Manifests
    Manifests["/opt/manifests<br/>(Baked-in kustomize manifests)"]

    %% External
    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
    OSAPIServer["OpenShift APIServer<br/>(config.openshift.io)<br/>TLS Profile"]
    ServiceCA["OpenShift Service-CA<br/>Controller"]

    %% Flows
    Orchestrator -->|creates| WorkbenchesCR
    Orchestrator -->|manages| ConfigMap
    WorkbenchesCR -->|watched by| Controller
    ConfigMap -->|watched by| Controller
    Controller -->|reads| Manifests
    Controller -->|"SSA patch (kustomize build)"| K8sAPI
    K8sAPI -->|deploys| KFNotebookCtrl
    K8sAPI -->|deploys| ODHNotebookCtrl
    K8sAPI -->|deploys| NotebookImages
    Controller -->|tracks readiness| KFNotebookCtrl
    Controller -->|tracks readiness| ODHNotebookCtrl

    NotebookCR -->|"create/update intercepted"| HWWebhook
    NotebookCR -->|"create/update intercepted"| ConnWebhook
    HWWebhook -->|reads| HardwareProfileCR
    ConnWebhook -->|"validates secrets +<br/>SubjectAccessReview"| K8sAPI

    OSAPIServer -->|"TLS profile config"| TLSBootstrap
    ServiceCA -->|"provisions webhook cert"| WorkbenchesOperator

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style HWWebhook fill:#4a90e2,stroke:#333,color:#fff
    style ConnWebhook fill:#4a90e2,stroke:#333,color:#fff
    style TLSBootstrap fill:#4a90e2,stroke:#333,color:#fff
    style WorkbenchesCR fill:#f5a623,stroke:#333,color:#fff
    style NotebookCR fill:#f5a623,stroke:#333,color:#fff
    style HardwareProfileCR fill:#f5a623,stroke:#333,color:#fff
    style ConfigMap fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style KFNotebookCtrl fill:#7ed321,stroke:#333,color:#fff
    style ODHNotebookCtrl fill:#7ed321,stroke:#333,color:#fff
    style NotebookImages fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSAPIServer fill:#e8e8e8,stroke:#333
    style ServiceCA fill:#e8e8e8,stroke:#333
    style Manifests fill:#d4edda,stroke:#333
