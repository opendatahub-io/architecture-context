graph TB
    subgraph WorkbenchesOperator["Workbenches Operator"]
        direction TB
        Controller["Workbenches Controller<br/>(controller-runtime)<br/>Reconciles Workbenches CR"]
        ManifestRenderer["Manifest Renderer<br/>(kustomize API)<br/>Renders & SSA-applies manifests"]
        TLSConfig["TLS Config Bootstrap<br/>(SecurityProfileWatcher)<br/>OpenShift TLS profile alignment"]

        subgraph Webhooks["Admission Webhooks (9443/TCP)"]
            ConnectionWH["Connection Webhook<br/>connection-notebook.opendatahub.io<br/>Injects connection secrets"]
            HardwareProfileWH["HardwareProfile Webhook<br/>hardwareprofile-notebook-injector<br/>Injects resource requirements"]
        end

        Controller -->|renders manifests| ManifestRenderer
        Controller -->|configures TLS| TLSConfig
    end

    %% CRDs
    WorkbenchesCR["Workbenches CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    NotebookCR["Notebook CR<br/>(kubeflow.org/v1)<br/>Namespace-scoped"]
    HardwareProfileCR["HardwareProfile CR<br/>(infrastructure.opendatahub.io/v1)<br/>"]

    %% Orchestrator
    Orchestrator["rhods-operator /<br/>opendatahub-operator<br/>(Orchestrator)"]

    %% Config
    ConfigMap["odh-workbenches-config<br/>ConfigMap<br/>Distribution name, version, platformVersion"]

    %% Deployed Components
    subgraph DeployedStack["Deployed by Operator (via kustomize SSA)"]
        KFController["kf-notebook-controller<br/>Manages Notebook StatefulSets"]
        ODHController["odh-notebook-controller<br/>HTTPRoutes, NetworkPolicies,<br/>kube-rbac-proxy sidecars"]
        ImageStreams["Notebook ImageStreams<br/>(ODH or RHOAI variants)<br/>Workbench image references"]
    end

    %% Flows
    Orchestrator -->|creates & manages| WorkbenchesCR
    WorkbenchesCR -->|watched by| Controller
    Controller -->|reads config| ConfigMap
    ManifestRenderer -->|deploys| KFController
    ManifestRenderer -->|deploys| ODHController
    ManifestRenderer -->|deploys| ImageStreams
    Controller -->|updates status| WorkbenchesCR

    NotebookCR -->|CREATE/UPDATE intercepted by| ConnectionWH
    NotebookCR -->|CREATE/UPDATE intercepted by| HardwareProfileWH
    HardwareProfileWH -->|reads specs| HardwareProfileCR

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style ManifestRenderer fill:#4a90e2,stroke:#333,color:#fff
    style TLSConfig fill:#4a90e2,stroke:#333,color:#fff
    style ConnectionWH fill:#50b5e9,stroke:#333,color:#fff
    style HardwareProfileWH fill:#50b5e9,stroke:#333,color:#fff
    style WorkbenchesCR fill:#f5a623,stroke:#333,color:#fff
    style NotebookCR fill:#f5a623,stroke:#333,color:#fff
    style HardwareProfileCR fill:#f5a623,stroke:#333,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style ConfigMap fill:#b8e986,stroke:#333
    style KFController fill:#9b59b6,stroke:#333,color:#fff
    style ODHController fill:#9b59b6,stroke:#333,color:#fff
    style ImageStreams fill:#9b59b6,stroke:#333,color:#fff
