graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Istio Gateway)"]
        IstioGW["Istio Ingress Gateway<br/>VirtualService routing<br/>AuthorizationPolicy:<br/>ALLOW ingress-gateway SA +<br/>kubeflow namespace with JWT"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS)"]
        direction TB

        subgraph NS_Component["Namespace: component-namespace"]
            BFF["UI BFF<br/>:8080/TCP HTTP/HTTPS<br/>TLS 1.3 (optional)<br/>Auth: Bearer / SA token<br/>SelfSubjectAccessReview"]
            RegistryProxy["model-registry proxy<br/>:8080/TCP HTTP<br/>TLS 1.2 min<br/>Insecure cipher rejection<br/>Auth: Istio AuthzPolicy"]
            CatalogServer["model-catalog-server<br/>:8080/TCP HTTP<br/>Auth: None (internal)"]
            CatalogDB["model-catalog-postgres<br/>:5432/TCP PostgreSQL<br/>Auth: Username/password"]
            Controller["Controller (manager)<br/>:8081/TCP health (unauth)<br/>:8443/TCP metrics HTTPS<br/>TokenReview + SAR<br/>HTTP/2 disabled"]
            CSI["mr-storage-initializer<br/>(init container)<br/>model-registry:// resolver"]
            AsyncJob["async-upload Job<br/>Python / AIPCC cpu-el9.8<br/>sigstore model signing<br/>FIPS: strictfipsruntime"]
        end

        subgraph NS_DB["Database Layer"]
            PostgreSQL["PostgreSQL / MySQL<br/>:5432/3306 TCP<br/>Configurable TLS<br/>Auth: Username/password"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>SA / User Token"]
        S3["S3 / OCI Storage<br/>:443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Registry creds"]
        HuggingFace["HuggingFace API<br/>:443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
    end

    %% External to Ingress
    User -->|"HTTP :80<br/>Bearer Token"| IstioGW

    %% Ingress to Services
    IstioGW -->|"HTTP :8080<br/>Istio mTLS<br/>Service Identity"| BFF
    IstioGW -->|"HTTP :8080<br/>Istio mTLS<br/>AuthzPolicy"| RegistryProxy
    IstioGW -->|"HTTP :8080<br/>Istio mTLS"| CatalogServer

    %% BFF connections
    BFF -->|"HTTP :8080<br/>Istio mTLS<br/>SA Token"| RegistryProxy
    BFF -->|"HTTP :8080"| CatalogServer
    BFF -->|"HTTPS :6443<br/>TLS 1.2+<br/>User/SA Token"| K8sAPI

    %% Registry to DB
    RegistryProxy -->|"SQL :5432/3306<br/>Configurable TLS<br/>Username/password"| PostgreSQL

    %% Catalog connections
    CatalogServer -->|"SQL :5432<br/>Username/password"| CatalogDB
    CatalogServer -->|"HTTPS :443<br/>TLS 1.2+<br/>API Key"| HuggingFace

    %% Controller connections
    Controller -->|"HTTPS :6443<br/>TLS 1.2+<br/>SA Token<br/>Watch InferenceService"| K8sAPI
    Controller -->|"HTTP :8080<br/>SA Token"| RegistryProxy

    %% CSI connections
    CSI -->|"HTTP :8080"| RegistryProxy
    CSI -->|"HTTPS :443<br/>TLS 1.2+<br/>Storage creds"| S3

    %% Async upload connections
    AsyncJob -->|"HTTPS :443<br/>TLS 1.2+<br/>Credentials"| S3
    AsyncJob -->|"HTTP :8080<br/>SA Token"| RegistryProxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef database fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class IstioGW ingress
    class BFF,RegistryProxy,CatalogServer,Controller,CSI,AsyncJob,CatalogDB servicemesh
    class PostgreSQL database
    class K8sAPI,S3,HuggingFace externalservice
