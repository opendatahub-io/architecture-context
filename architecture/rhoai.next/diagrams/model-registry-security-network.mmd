graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist / External Client"]
    end

    subgraph Ingress["INGRESS (DMZ) - Kubeflow Gateway"]
        Gateway["Istio Ingress Gateway<br/>443/TCP → 8080/TCP<br/>TLS 1.3 Termination<br/>RequestAuthentication (JWT)"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS STRICT)"]
        direction TB

        subgraph NS_Registry["model-registry-service"]
            MR["model-registry (proxy)<br/>SA: model-registry<br/>Port: 8080/TCP ClusterIP<br/>Istio sidecar: ✅<br/>DestinationRule: ISTIO_MUTUAL"]
        end

        subgraph NS_Catalog["model-catalog"]
            Cat["model-catalog<br/>SA: model-catalog<br/>Port: 8080/TCP ClusterIP<br/>Istio sidecar: ✅<br/>Leader Election: pglock"]
        end

        subgraph NS_UI["model-registry-ui"]
            UI["model-registry-ui<br/>SA: model-registry-ui<br/>Port: 8080/TCP ClusterIP<br/>Resources: 2Gi/500m"]
        end

        subgraph NS_Controller["inference-service-controller"]
            Ctrl["controller-manager<br/>SA: controller-manager<br/>ClusterRole: cluster-wide<br/>Resources: 128Mi/10m"]
            Metrics["Metrics: 8443/TCP<br/>HTTPS (self-signed)<br/>Bearer Token auth<br/>NetworkPolicy restricted"]
        end

        subgraph NS_DB["Databases"]
            RegistryDB["model-registry-db<br/>PostgreSQL 5432/TCP<br/>Secret: model-registry-db-secrets<br/>PVC: 10Gi"]
            CatalogDB["model-catalog-postgres<br/>PostgreSQL 5432/TCP<br/>Secret: model-catalog-postgres<br/>StatefulSet"]
        end

        CSI["storage-initializer (CSI)<br/>Runs in KServe pods<br/>URI validation: blocks 169.254.169.254"]
    end

    subgraph BatchJobs["BATCH JOBS"]
        Job["async-upload-job<br/>AIPCC CPU base (UBI9)<br/>FIPS: OpenSSL inherited<br/>Termination: /dev/termination-log"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace API<br/>huggingface.co<br/>443/TCP HTTPS<br/>HF_API_KEY Bearer"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>AWS IAM credentials"]
        OCI["OCI Registry<br/>443/TCP HTTPS<br/>Docker credentials"]
        Sigstore["Sigstore (Fulcio/Rekor)<br/>443/TCP HTTPS<br/>OIDC identity token"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.3 / SA token"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>OAuth2/kubeflow-userid"| Gateway

    %% Ingress → Services (via VirtualService)
    Gateway -->|"HTTP/8080<br/>mTLS STRICT<br/>AuthorizationPolicy"| MR
    Gateway -->|"HTTP/8080<br/>mTLS STRICT<br/>VirtualService"| Cat
    Gateway -->|"HTTP/80<br/>mTLS STRICT<br/>VirtualService"| UI

    %% Internal service connections
    MR -->|"TCP/5432<br/>Configurable TLS<br/>Username/Password"| RegistryDB
    Cat -->|"TCP/5432<br/>None (pod-local)<br/>Username/Password"| CatalogDB
    Cat -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_API_KEY"| HF

    %% Controller connections
    Ctrl -->|"HTTP(S)/8080<br/>Configurable<br/>Bearer token (optional)"| MR
    Ctrl -->|"HTTPS/443<br/>TLS 1.3<br/>SA token"| K8sAPI

    %% CSI connections
    CSI -->|"HTTP/8080<br/>None<br/>None"| MR
    CSI -->|"HTTPS/443<br/>TLS 1.2+<br/>Provider-specific"| S3

    %% UI connections
    UI -->|"HTTPS/443<br/>TLS 1.3<br/>SA token (SAR)"| K8sAPI

    %% Async upload connections
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token"| MR
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>Docker creds"| OCI
    Job -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC token"| Sigstore

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef batch fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class MR,Cat,UI,Ctrl,Metrics,CSI servicemesh
    class RegistryDB,CatalogDB database
    class HF,S3,OCI,Sigstore,K8sAPI externalservice
    class Job batch
