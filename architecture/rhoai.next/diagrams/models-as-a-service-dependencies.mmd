graph LR
    MaaS["Models-as-a-Service<br/>(MaaS Operator + API)"]

    %% External Dependencies (Required)
    MaaS -->|"auth enforcement<br/>AuthPolicy, TokenRateLimitPolicy"| Kuadrant["Kuadrant<br/>v1.4.2+ / RHCL 1.3+"]
    MaaS -->|"token validation<br/>credential stripping"| Authorino["Authorino<br/>v0.23.1+ (via Kuadrant)"]
    MaaS -->|"token rate limiting"| Limitador["Limitador<br/>(via Kuadrant)"]
    MaaS -->|"HTTPRoute, Gateway CRDs"| GatewayAPI["Gateway API<br/>v1.4+"]
    MaaS -->|"EnvoyFilter ext_proc<br/>mTLS, telemetry"| Istio["Istio / OSSM"]
    MaaS -->|"API key hash storage<br/>migrations"| PostgreSQL["PostgreSQL"]
    MaaS -->|"CRD ops, TokenReview<br/>SAR, informers"| K8sAPI["Kubernetes API"]

    %% External Dependencies (Optional)
    MaaS -.->|"LLM inference<br/>LLMInferenceService CRD"| KServe["KServe<br/>v0.19+"]
    MaaS -.->|"distributed tracing<br/>usage logging"| OTLP["OpenTelemetry<br/>Collector"]

    %% Internal Platform Dependencies
    MaaS -->|"DSCInitialization watch<br/>platform lifecycle"| ODHOperator["ODH/RHOAI<br/>Platform Operator"]
    MaaS -->|"OIDC issuer discovery<br/>config.openshift.io"| OpenShiftAuth["OpenShift<br/>Authentication"]
    MaaS -->|"Envoy data plane<br/>for Gateway CRs"| GatewayController["OpenShift Gateway<br/>Controller"]

    %% Components that integrate WITH MaaS
    Dashboard["ODH Dashboard"] -.->|"UI management"| MaaS
    ExternalProviders["External Model Providers<br/>(OpenAI, Anthropic)"] -.->|"LLM inference<br/>via ExternalModel CR"| MaaS

    %% Observability
    Prometheus["Prometheus"] -.->|"metrics scrape<br/>8080, 9090, 9005/TCP"| MaaS
    Perses["Perses Dashboards"] -.->|"dashboard CRDs"| MaaS

    %% Styles
    style MaaS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external (dark gray)
    style Kuadrant fill:#666,stroke:#333,color:#fff
    style Authorino fill:#666,stroke:#333,color:#fff
    style Limitador fill:#666,stroke:#333,color:#fff
    style GatewayAPI fill:#666,stroke:#333,color:#fff
    style Istio fill:#666,stroke:#333,color:#fff
    style PostgreSQL fill:#666,stroke:#333,color:#fff
    style K8sAPI fill:#666,stroke:#333,color:#fff

    %% Optional external (lighter gray)
    style KServe fill:#999,stroke:#333,color:#fff
    style OTLP fill:#999,stroke:#333,color:#fff

    %% Internal platform (green)
    style ODHOperator fill:#7ed321,stroke:#333,color:#fff
    style OpenShiftAuth fill:#7ed321,stroke:#333,color:#fff
    style GatewayController fill:#7ed321,stroke:#333,color:#fff

    %% Consumers (orange)
    style Dashboard fill:#f5a623,stroke:#333,color:#fff
    style ExternalProviders fill:#f5a623,stroke:#333,color:#fff
    style Prometheus fill:#f5a623,stroke:#333,color:#fff
    style Perses fill:#f5a623,stroke:#333,color:#fff
