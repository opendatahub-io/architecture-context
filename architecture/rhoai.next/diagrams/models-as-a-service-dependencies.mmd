graph LR
    MaaS["MaaS<br/>(Models as a Service)"]

    %% External Dependencies (build/runtime)
    MaaS -->|"HTTPRoute CRUD"| GatewayAPI["Gateway API<br/>sigs.k8s.io/gateway-api v1.6.2"]
    MaaS -->|"AuthPolicy, TokenRateLimitPolicy"| Kuadrant["Kuadrant/Authorino<br/>kuadrant.io"]
    MaaS -->|"DestinationRule, EnvoyFilter,<br/>ServiceEntry"| Istio["Istio<br/>networking.istio.io"]
    MaaS -->|"LLMInferenceService watch"| KServe["KServe<br/>v0.19.0-rc0"]
    MaaS -->|"TLS certificates (xks)"| CertManager["cert-manager"]
    MaaS -->|"TLS certificates (OCP)"| ServiceCA["OpenShift service-ca"]
    MaaS -->|"API key & subscription storage"| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    MaaS -->|"distributed tracing"| OTLP["OpenTelemetry Collector<br/>OTLP/gRPC"]

    %% Internal RHOAI Dependencies
    MaaS -->|"component lifecycle"| ODHOperator["ODH/RHOAI Operator"]
    MaaS -.->|"inference routing"| DSGateway["data-science-gateway"]

    %% Integration Points (consumed by others)
    Dashboard["ODH Dashboard"] -.->|"tenant UI"| MaaS
    LLMd["llm-d"] -.->|"InferenceObjective"| MaaS

    %% External Services
    MaaS -->|"proxy inference"| ExternalProviders["External Model Providers<br/>(OpenAI, Azure, etc.)<br/>443/TCP HTTPS"]
    MaaS -->|"CRD operations,<br/>TokenReview,<br/>SubjectAccessReview"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]

    %% Build Dependencies
    MaaS -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.25.1"]
    MaaS -->|"HTTP framework"| Gin["Gin<br/>v1.12.0"]
    MaaS -->|"DB driver"| PGX["pgx/v5<br/>v5.11.0"]
    MaaS -->|"manifest rendering"| Kustomize["kustomize/api<br/>v0.21.1"]

    %% Styling
    style MaaS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style KServe fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style ServiceCA fill:#999,stroke:#333,color:#fff
    style OTLP fill:#999,stroke:#333,color:#fff

    style ODHOperator fill:#7ed321,stroke:#333,color:#fff
    style DSGateway fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style LLMd fill:#7ed321,stroke:#333,color:#fff

    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style ExternalProviders fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff

    style ControllerRuntime fill:#e8e8e8,stroke:#333
    style Gin fill:#e8e8e8,stroke:#333
    style PGX fill:#e8e8e8,stroke:#333
    style Kustomize fill:#e8e8e8,stroke:#333
