graph LR
    MaaS["MaaS Platform<br/>(maas-controller +<br/>maas-api +<br/>payload-processing)"]

    %% Required External Dependencies
    MaaS -->|"AuthPolicy,<br/>TokenRateLimitPolicy"| Kuadrant["Kuadrant / RHCL<br/>1.4.2+ (ODH) / 1.3+ (RHOAI)"]
    MaaS -->|"Gateway,<br/>HTTPRoute"| GatewayAPI["Gateway API<br/>v1"]
    MaaS -->|"LLMInferenceService<br/>watch"| KServe["KServe<br/>0.19+"]
    MaaS -->|"EnvoyFilter,<br/>ServiceEntry,<br/>DestinationRule"| Istio["Istio /<br/>Service Mesh"]
    MaaS -->|"API key storage<br/>5432/TCP"| PostgreSQL["PostgreSQL"]

    %% Optional External Dependencies
    MaaS -.->|"TLS certs"| CertManager["cert-manager"]
    MaaS -.->|"OTel Collector"| OTelOperator["OpenTelemetry<br/>Operator"]
    MaaS -.->|"Perses dashboards"| COO["Cluster Observability<br/>Operator (COO)"]
    MaaS -.->|"LWS scheduling"| LWS["LeaderWorkerSet<br/>(LWS)"]

    %% Internal Platform Dependencies
    ODHOperator["opendatahub-operator /<br/>rhods-operator"] -->|"deploys<br/>(DSCInitialization)"| MaaS
    MaaS -->|"HTTP callback<br/>key validation"| Authorino["Kuadrant<br/>Authorino"]
    MaaS -->|"token rate<br/>limiting"| Limitador["Kuadrant<br/>Limitador"]
    MaaS -->|"OIDC issuer<br/>discovery"| OpenShiftAuth["OpenShift<br/>Authentication"]

    %% External Services (Egress)
    MaaS -->|"model inference<br/>HTTPS/443"| ExtProviders["External Model<br/>Providers<br/>(OpenAI, Anthropic)"]
    MaaS -->|"usage logs<br/>HTTPS/8080"| Loki["Loki"]
    MaaS -.->|"tracing<br/>gRPC/4317"| OTLP["OTLP Endpoint"]

    %% Core Kubernetes
    MaaS -->|"TokenReview, SAR,<br/>CRD CRUD, informers<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>Server"]

    %% Integration points - other components that use MaaS
    %% (none defined in this architecture - MaaS is a leaf service)

