graph TB
    subgraph Client["CLIENT (Test Harness — Not Deployed)"]
        TestRunner["autox-ci Test Runner<br/>Python 3.12+<br/>CI pod or developer workstation"]
    end

    subgraph ClusterAPIs["CLUSTER APIs"]
        direction TB

        OCPAPI["OpenShift API Server<br/>6443/TCP (OCP) / 443/TCP (ROSA)<br/>TLS (configurable verify)<br/>Bearer Token"]

        KFP["KFP Pipeline Server<br/>443/TCP via OpenShift Route<br/>TLS (configurable verify)<br/>Bearer Token"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (not directly accessed)"]
        direction TB
        DSPO["DSPO Operator<br/>Reconciles DSPA CR"]
        PipelinePods["Pipeline Pods<br/>Execute KFP steps"]
    end

    subgraph InferenceEndpoints["INFERENCE ENDPOINTS"]
        KServeISVC["KServe InferenceService<br/>443/TCP via OpenShift Route<br/>⚠ TLS VERIFY DISABLED<br/>ssl.CERT_NONE<br/>Bearer Token"]
    end

    subgraph ExternalStorage["EXTERNAL STORAGE"]
        S3["S3-Compatible Storage<br/>Port: env-configured<br/>TLS (configurable verify)<br/>AWS Signature V4"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>443/TCP<br/>TLS<br/>Optional token"]
        PyPI["RHEL AI PyPI<br/>443/TCP<br/>TLS<br/>No auth"]
    end

    %% Client → Cluster API connections
    TestRunner -->|"HTTPS/6443<br/>TLS (configurable)<br/>Bearer Token<br/>Create: ns, secrets, DSPA CR,<br/>ISVC, ServingRuntime"| OCPAPI
    TestRunner -->|"HTTPS/443<br/>TLS (configurable)<br/>Bearer Token<br/>Submit + poll pipeline runs"| KFP

    %% Client → InferenceService
    TestRunner -->|"HTTPS/443<br/>⚠ ssl.CERT_NONE<br/>Bearer Token<br/>POST /v1/models/:predict"| KServeISVC

    %% Client → Storage
    TestRunner -->|"HTTPS<br/>TLS (configurable)<br/>AWS Sig V4<br/>PUT/GET/DELETE/HEAD"| S3

    %% Client → External
    TestRunner -->|"HTTPS/443<br/>TLS<br/>Download datasets"| HF
    TestRunner -.->|"HTTPS/443<br/>TLS<br/>uv package install"| PyPI

    %% Cluster internal (indirect)
    OCPAPI -.->|"DSPA CR reconcile"| DSPO
    KFP -.->|"Execute pipeline"| PipelinePods
    PipelinePods -.->|"Read K8s Secrets<br/>Write artifacts"| S3

    %% Styling
    classDef client fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef clusterapi fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#f0f0f0,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5
    classDef inference fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:1px

    class TestRunner client
    class OCPAPI,KFP clusterapi
    class DSPO,PipelinePods internal
    class KServeISVC inference
    class S3 storage
    class HF,PyPI external
