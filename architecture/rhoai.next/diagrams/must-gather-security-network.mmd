graph TB
    subgraph UserWorkstation["USER WORKSTATION (Trusted)"]
        Admin["Cluster Admin<br/>oc CLI / kubectl CLI<br/>Auth: kubeconfig"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph APIServer["API SERVER"]
            K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Bearer Token"]
        end

        subgraph MustGatherPod["MUST-GATHER POD (Ephemeral Batch Job)"]
            direction TB
            Container["must-gather Container<br/>Image: odh-must-gather (UBI9)<br/>No listening ports<br/>No inbound connections"]

            subgraph Tools["Bundled CLI Tools"]
                OC["oc CLI<br/>(base image)"]
                Kubectl["kubectl v1.33.3<br/>(ose-cli-rhel9)"]
                Helm["helm v4.1.4<br/>(Git LFS)"]
            end

            Container --> Tools
        end

        subgraph OCPNamespaces["OCP NAMESPACES (oc adm inspect)"]
            direction LR
            NS_Operator["rhods-operator"]
            NS_Apps["redhat-ods-applications"]
            NS_Mon["redhat-ods-monitoring"]
            NS_NB["rhods-notebooks"]
            NS_MR["rhoai-model-registries"]
            NS_Ingress["openshift-ingress"]
            NS_Kuadrant["kuadrant-system"]
            NS_GitOps["rhai-gitops"]
        end

        subgraph XKSNamespaces["xKS NAMESPACES (kubectl_inspect)"]
            direction LR
            NS_CloudMgr["rhai-cloudmanager-system"]
            NS_CertMgr["cert-manager"]
            NS_Istio["istio-system"]
            NS_Monitor["monitoring"]
            NS_LWS["openshift-lws-operator"]
            NS_Batch["batch-gateway"]
        end
    end

    subgraph Output["DATA OUTPUT"]
        Filesystem["Local Filesystem<br/>/must-gather/ (OCP)<br/>/tmp/must-gather/ (xKS)<br/>Resource YAML + Pod Logs"]
    end

    %% Flows
    Admin -->|"OCP: oc adm must-gather<br/>xKS: kubectl apply<br/>HTTPS/443 TLS 1.2+<br/>kubeconfig auth"| K8sAPI

    K8sAPI -->|"Schedule pod<br/>Inject SA token"| Container

    Tools -->|"EGRESS ONLY<br/>HTTPS/443 TLS 1.2+<br/>SA Bearer Token<br/>GET, LIST (read-only)"| K8sAPI

    K8sAPI -.->|"Resource data"| OCPNamespaces
    K8sAPI -.->|"Resource data"| XKSNamespaces

    Container -->|"Write collected data"| Filesystem
    Filesystem -->|"OCP: rsync via oc<br/>xKS: kubectl cp<br/>TLS 1.2+"| Admin

    %% Styling
    classDef trusted fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#f9f9f9,stroke:#666,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef namespace fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef output fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Admin trusted
    class K8sAPI apiserver
    class Container,OC,Kubectl,Helm pod
    class NS_Operator,NS_Apps,NS_Mon,NS_NB,NS_MR,NS_Ingress,NS_Kuadrant,NS_GitOps namespace
    class NS_CloudMgr,NS_CertMgr,NS_Istio,NS_Monitor,NS_LWS,NS_Batch namespace
    class Filesystem output
