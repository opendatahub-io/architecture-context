graph TB
    subgraph External["EXTERNAL (User Workstation)"]
        User["User / SRE<br/>oc adm must-gather (OCP)<br/>kubectl apply (xKS)"]
    end

    subgraph Cluster["CLUSTER (RBAC Enforced)"]
        direction TB

        subgraph MustGatherPod["must-gather Pod"]
            MG["must-gather Container<br/>Image: odh-must-gather-rhel9<br/>Base: ose-must-gather-rhel9:v4.20<br/>SA: must-gather (OCP) / must-gather-sa (xKS)<br/>Pure Bash — no compiled binaries"]

            subgraph CLIs["CLI Tools (TLS delegated)"]
                OC_CLI["oc CLI"]
                Kubectl_CLI["kubectl CLI"]
                Helm_CLI["helm CLI"]
            end
        end

        APIServer["kube-apiserver<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC: must-gather / must-gather-reader ClusterRole"]

        subgraph Resources["Resources Accessed (Read-Only)"]
            direction TB

            subgraph PlatformCRDs["RHOAI Platform CRDs"]
                DSC["DSCInitialization<br/>DataScienceCluster"]
                ComponentCRs["InferenceService, DSP,<br/>Dashboard, KubeRay, Kueue,<br/>Training, ModelRegistry,<br/>TrustyAI, Feast, MLflow,<br/>Spark, AIGateway, MCP"]
            end

            subgraph NetworkCRDs["Networking CRDs"]
                GatewayAPI["Gateway, HTTPRoute,<br/>GRPCRoute, ReferenceGrant"]
                IstioCRDs["VirtualService, DestinationRule,<br/>AuthorizationPolicy,<br/>PeerAuthentication"]
            end

            subgraph DepCRDs["Dependency CRDs (LLM-D)"]
                CertMgr["cert-manager:<br/>Certificate, Issuer"]
                LWS["LeaderWorkerSet"]
                KEDA["ScaledObject, ScaledJob"]
            end

            subgraph Namespaces["Namespace Inspections"]
                NS["redhat-ods-operator<br/>redhat-ods-applications<br/>redhat-ods-monitoring<br/>rhods-notebooks<br/>rhoai-model-registries<br/>openshift-ingress<br/>kuadrant-system<br/>rhai-gitops"]
            end
        end

        Output["/must-gather/ tarball<br/>Filesystem only — no network egress"]
    end

    %% Flows
    User -->|"kubeconfig auth<br/>(client cert / OIDC)"| MG
    MG --> OC_CLI
    MG --> Kubectl_CLI
    MG --> Helm_CLI
    OC_CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>GET, LIST only"| APIServer
    Kubectl_CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>GET, LIST only"| APIServer
    Helm_CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>GET, LIST only"| APIServer
    APIServer -->|read-only| PlatformCRDs
    APIServer -->|read-only| NetworkCRDs
    APIServer -->|read-only| DepCRDs
    APIServer -->|inspect| Namespaces
    MG -->|writes| Output
    Output -->|"oc rsync (OCP)<br/>kubectl cp (xKS)"| User

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef resources fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef output fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tools fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class User external
    class MG cluster
    class APIServer apiserver
    class DSC,ComponentCRs,GatewayAPI,IstioCRDs,CertMgr,LWS,KEDA,NS resources
    class Output output
    class OC_CLI,Kubectl_CLI,Helm_CLI tools
