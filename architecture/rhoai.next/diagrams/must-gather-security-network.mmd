graph TB
    subgraph External["EXTERNAL (User Workstation)"]
        Admin["Cluster Admin<br/>oc / kubectl CLI"]
    end

    subgraph Cluster["KUBERNETES CLUSTER"]
        subgraph MustGatherPod["must-gather Pod (Ephemeral)"]
            GatherSH["gather.sh<br/>SA: system:serviceaccount (OCP)<br/>or must-gather-sa (xKS)"]
        end

        subgraph ControlPlane["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>443/TCP<br/>TLS 1.2+<br/>RBAC Enforced"]
        end

        subgraph TargetNamespaces["TARGET NAMESPACES (Read-Only)"]
            direction LR
            NS1["redhat-ods-operator"]
            NS2["redhat-ods-applications"]
            NS3["istio-system"]
            NS4["knative-serving"]
            NS5["{user namespaces}"]
        end

        subgraph EphemeralStorage["EPHEMERAL STORAGE"]
            Output["/must-gather/<br/>Collected diagnostics"]
        end
    end

    %% Flows
    Admin -->|"oc adm must-gather / kubectl apply<br/>TLS 1.2+<br/>kubeconfig auth"| K8sAPI
    K8sAPI -->|"Creates pod<br/>Mounts SA token"| GatherSH
    GatherSH -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount token<br/>GET, LIST, WATCH only"| K8sAPI
    K8sAPI -.->|"read CRDs, pods,<br/>logs, events"| TargetNamespaces
    GatherSH -->|"Filesystem write<br/>No encryption"| Output
    Output -->|"rsync / kubectl cp<br/>TLS 1.2+<br/>kubeconfig auth"| Admin

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef namespace fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Admin external
    class K8sAPI controlplane
    class GatherSH pod
    class NS1,NS2,NS3,NS4,NS5 namespace
    class Output storage
