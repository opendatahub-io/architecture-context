graph TD
    subgraph "Security Model - Guardrails Detectors"
        direction TB

        subgraph "Application Level (No RBAC)"
            BuiltInSA["Built-in Detector<br/>UID: 1001 (non-root)<br/>No ServiceAccount RBAC<br/>No K8s API access"]
            HFSA["HuggingFace Detector<br/>UID: 1001 (non-root)<br/>No ServiceAccount RBAC<br/>No K8s API access"]
            JudgeSA["LLM Judge Detector<br/>UID: 1001 (non-root)<br/>No ServiceAccount RBAC<br/>No K8s API access"]
        end

        subgraph "Platform Auth (Delegated to KServe/RHOAI)"
            direction TB

            Annotation["InferenceService Annotations"]
            AuthAnnotation["security.opendatahub.io/<br/>enable-auth: 'true'"]
            IstioAnnotation["sidecar.istio.io/<br/>inject: 'true'"]
            DashAnnotation["opendatahub.io/<br/>dashboard: 'true'"]

            Annotation --> AuthAnnotation
            Annotation --> IstioAnnotation
            Annotation --> DashAnnotation
        end

        subgraph "RHOAI 3.x Auth Enforcement"
            IstioMTLS["Istio mTLS<br/>(PeerAuthentication STRICT)"]
            KubeRBAC["kube-rbac-proxy<br/>(AuthN/AuthZ sidecar)"]
        end

        subgraph "RHOAI 2.x Auth Enforcement"
            OAuthProxy["oauth-proxy<br/>(legacy auth sidecar)"]
        end

        subgraph "Secrets"
            S3Secret["aws-connection-minio-data-<br/>connection-guardrails-guardian<br/>Type: Opaque<br/>Keys: AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY<br/>Provisioned: Manual<br/>Auto-Rotate: No"]
        end

        AuthAnnotation -->|"enables on 3.x"| IstioMTLS
        AuthAnnotation -->|"enables on 3.x"| KubeRBAC
        AuthAnnotation -->|"enables on 2.x"| OAuthProxy

        S3Secret -->|"used by"| HFSA
    end

    subgraph "Network Isolation"
        NoNetPol["No NetworkPolicy defined<br/>in detector manifests"]
        PlatformIsolation["Relies on platform-level<br/>network isolation"]
        NamespaceIsolation["Per-namespace deployment<br/>via KServe InferenceService"]

        NoNetPol --> PlatformIsolation
        PlatformIsolation --> NamespaceIsolation
    end

    style BuiltInSA fill:#4a90e2,color:#fff
    style HFSA fill:#4a90e2,color:#fff
    style JudgeSA fill:#4a90e2,color:#fff
    style AuthAnnotation fill:#f5a623
    style IstioAnnotation fill:#f5a623
    style DashAnnotation fill:#f5a623
    style IstioMTLS fill:#7ed321,color:#fff
    style KubeRBAC fill:#7ed321,color:#fff
    style OAuthProxy fill:#e8e8e8,stroke:#333
    style S3Secret fill:#e74c3c,color:#fff
    style NoNetPol fill:#fff2cc,stroke:#d6b656
    style PlatformIsolation fill:#d5e8d4,stroke:#82b366
    style NamespaceIsolation fill:#d5e8d4,stroke:#82b366
