graph TD
    subgraph Legend["RBAC / Auth for Guardrails Detectors"]
        direction TB
        Note1["No Kubernetes RBAC defined.<br/>Detectors are application-level microservices,<br/>not Kubernetes operators.<br/>RBAC for KServe ISVCs is managed by KServe."]
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        direction TB

        subgraph IstioAuth["Istio Service Mesh Auth"]
            mTLS["mTLS (STRICT)<br/>Istio sidecar injection<br/>sidecar.istio.io/inject: true"]
            PlatformAuth["Platform Auth<br/>security.opendatahub.io/<br/>enable-auth: true"]
        end

        subgraph Endpoints["Protected Endpoints"]
            API1["/api/v1/text/contents<br/>POST<br/>Auth: Istio mTLS +<br/>Platform Auth"]
            API2["/api/v1/text/generation<br/>POST<br/>Auth: Istio mTLS +<br/>detector_id header"]
            Health["/health, /metrics<br/>GET<br/>Auth: None<br/>(unauthenticated)"]
        end
    end

    subgraph SecretAccess["Secrets"]
        S3Secret["aws-connection-minio-<br/>data-connection-<br/>guardrails-guardian<br/>(Opaque)"]
        S3Contents["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>AWS_S3_ENDPOINT<br/>AWS_S3_BUCKET"]
        S3Secret --> S3Contents
    end

    subgraph CodeSandbox["Built-in Detector Code Sandbox"]
        AST["AST Static Analysis<br/>on custom detector code"]
        BlockedImports["Blocked Imports:<br/>os, subprocess, sys, shutil"]
        BlockedCalls["Blocked Calls:<br/>eval, exec, open,<br/>compile, input"]
        AST --> BlockedImports
        AST --> BlockedCalls
    end

    mTLS -->|enforces| API1
    PlatformAuth -->|enforces| API1
    mTLS -->|enforces| API2
    PlatformAuth -->|enforces| API2

    style Note1 fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style mTLS fill:#d5e8d4,stroke:#82b366
    style PlatformAuth fill:#d5e8d4,stroke:#82b366
    style API1 fill:#dae8fc,stroke:#6c8ebf
    style API2 fill:#dae8fc,stroke:#6c8ebf
    style Health fill:#f8cecc,stroke:#b85450
    style S3Secret fill:#fff2cc,stroke:#d6b656
    style S3Contents fill:#fff2cc,stroke:#d6b656
    style AST fill:#e1d5e7,stroke:#9673a6
    style BlockedImports fill:#f8cecc,stroke:#b85450
    style BlockedCalls fill:#f8cecc,stroke:#b85450
