graph TD
    subgraph DetectorRuntime["Detector Runtime Security"]
        subgraph BuiltInSA["Built-in Detector"]
            BuiltInUID["Runs as UID 1001<br/>(non-root)"]
            BuiltInNoK8s["No Kubernetes API access"]
        end

        subgraph HFSA["HuggingFace Detector"]
            HFUID["Runs as UID 1001<br/>(non-root)"]
            HFNoK8s["No Kubernetes API access"]
        end

        subgraph JudgeSA["LLM Judge Detector"]
            JudgeUID["Runs as UID 1001<br/>(non-root)"]
            JudgeNoK8s["No Kubernetes API access"]
        end
    end

    subgraph ExampleRBAC["Example RoleBinding (dev only)"]
        SA["ServiceAccount<br/>user-one"]
        RB["RoleBinding<br/>user-one-view"]
        CR["ClusterRole<br/>view"]

        SA -->|"bound via"| RB
        RB -->|"grants"| CR
    end

    subgraph PlatformAuth["Platform Authentication"]
        IstioSidecar["Istio Sidecar<br/>sidecar.istio.io/inject: 'true'"]
        RHOAIAuth["RHOAI Auth Injection<br/>security.opendatahub.io/enable-auth: 'true'"]
    end

    subgraph SecretAccess["Secrets"]
        S3Secret["aws-connection-minio-data-<br/>connection-guardrails-guardian<br/>(Opaque)"]
        S3Fields["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
        S3Secret --> S3Fields
    end

    IstioSidecar -.->|"mTLS enforcement"| HFSA
    IstioSidecar -.->|"mTLS enforcement"| JudgeSA
    RHOAIAuth -.->|"auth sidecar"| HFSA
    RHOAIAuth -.->|"auth sidecar"| JudgeSA

    S3Secret -.->|"mounted as env vars"| HFSA

    subgraph NoClusterRoles["No ClusterRoles"]
        NoRoles["Detectors define NO ClusterRoles<br/>No cluster-wide permissions<br/>No Kubernetes API access"]
    end

    style BuiltInUID fill:#4a90e2,stroke:#333
    style HFUID fill:#4a90e2,stroke:#333
    style JudgeUID fill:#4a90e2,stroke:#333
    style BuiltInNoK8s fill:#d5e8d4,stroke:#82b366
    style HFNoK8s fill:#d5e8d4,stroke:#82b366
    style JudgeNoK8s fill:#d5e8d4,stroke:#82b366
    style SA fill:#f5a623,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style RB fill:#f5a623,stroke:#333
    style IstioSidecar fill:#dae8fc,stroke:#6c8ebf
    style RHOAIAuth fill:#dae8fc,stroke:#6c8ebf
    style S3Secret fill:#ffe6cc,stroke:#d79b00
    style S3Fields fill:#ffe6cc,stroke:#d79b00
    style NoRoles fill:#d5e8d4,stroke:#82b366
