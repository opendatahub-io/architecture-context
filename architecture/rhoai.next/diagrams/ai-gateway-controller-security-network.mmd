graph TB
    subgraph ControllerNS["CONTROLLER NAMESPACE (opendatahub)"]
        direction TB
        AGC["ai-gateway-controller<br/>SA: ai-gateway-controller<br/>Ports: 8080/TCP (metrics), 8081/TCP (probes)<br/>FIPS: strictfipsruntime + ubi-minimal-pqc"]
    end

    subgraph KubeAPI["KUBERNETES API SERVER"]
        direction TB
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC: ai-gateway-controller-role"]
    end

    subgraph TenantNS["TENANT NAMESPACES (per-tenant)"]
        direction TB
        PraxisExtProc["praxis-extproc Deployment<br/>Per-tenant ExtProc dataplane<br/>NetworkPolicy: per-tenant"]
        RoutingResources["Routing Resources<br/>HTTPRoute + ExternalName Service<br/>+ Overlay ConfigMap"]
        ProviderSecrets["Provider Secrets<br/>(read-only, via APIReader)"]
    end

    subgraph GatewayNS["GATEWAY NAMESPACE (openshift-ingress)"]
        direction TB
        Gateway["maas-default-gateway<br/>(Envoy Proxy)<br/>EnvoyFilter + DestinationRule<br/>+ ServiceEntry"]
    end

    subgraph External["EXTERNAL LLM PROVIDERS (mesh-external)"]
        direction TB
        LLMProvider["External LLM Endpoints<br/>Auth: API Key (from Secret)<br/>TLS via DestinationRule"]
    end

    subgraph MaaSControl["MAAS CONTROL PLANE"]
        direction TB
        MaaSController["maas-controller<br/>Coordinates via MaasTenantConfig<br/>annotation CAS handshake"]
    end

    %% Controller → API Server
    AGC -->|"HTTPS/6443<br/>TLS 1.2+ (OpenSSL FIPS)<br/>SA Token Auth<br/>CRD watches + SSA apply"| APIServer

    %% API Server → Tenant resources
    APIServer -->|"SSA Apply<br/>ForceOwnership<br/>field owner: ai-gateway-controller"| PraxisExtProc
    APIServer -->|"SSA Apply<br/>HTTPRoute, Service,<br/>ConfigMap"| RoutingResources
    APIServer -->|"APIReader (direct)<br/>bypasses cache<br/>read-only"| ProviderSecrets

    %% API Server → Gateway resources
    APIServer -->|"SSA Apply<br/>EnvoyFilter, DestinationRule,<br/>ServiceEntry"| Gateway

    %% Gateway → External (dataplane, not controller)
    Gateway -->|"Envoy dataplane<br/>TLS per DestinationRule<br/>API Key Auth"| LLMProvider

    %% Backend swap handshake
    AGC -.->|"Annotation CAS<br/>payload-processing-status<br/>cleanup-complete ↔ steady"| MaaSController

    %% Health probes (no auth)
    Kubelet["kubelet"] -->|"HTTP/8081<br/>No TLS, No Auth<br/>/healthz, /readyz"| AGC
    Prometheus["Prometheus"] -->|"HTTP/8080<br/>/metrics"| AGC

    %% Styling
    classDef controller fill:#4a90e2,stroke:#1565c0,stroke-width:2px,color:#fff
    classDef apiserver fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef tenant fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef maas fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef infra fill:#f9f9f9,stroke:#999,stroke-width:1px

    class AGC controller
    class APIServer apiserver
    class PraxisExtProc,RoutingResources,ProviderSecrets tenant
    class Gateway gateway
    class LLMProvider external
    class MaaSController maas
    class Kubelet,Prometheus infra
