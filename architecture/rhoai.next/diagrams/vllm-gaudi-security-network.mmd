graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (KServe / Platform Managed)"]
        Gateway["KServe Ingress / Gateway<br/>443/TCP → 8000/TCP<br/>TLS 1.3 Termination<br/>AuthN: kube-rbac-proxy / Gateway API"]
    end

    subgraph Container["CONTAINER (odh-vllm-gaudi-rhel9)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            APIServer["vLLM OpenAI API Server<br/>UID: 2000 (non-root)<br/>Port: 8000/TCP HTTP (plaintext)<br/>No container-level auth"]
            HPUWorker["vllm-gaudi HPU Worker<br/>(in-process plugin)"]
            GaudiDev["Intel Gaudi Device<br/>Gaudi2 / Gaudi3<br/>SynapseAI 1.23.0<br/>PCIe / HPU API"]
        end
    end

    subgraph Distributed["DISTRIBUTED (Optional — Multi-HPU)"]
        RayHead["Ray Head<br/>6379/TCP<br/>Ray protocol<br/>No encryption"]
        HPU_N["HPU Workers (rank 0..N)<br/>HCCL port (dynamic)<br/>No encryption"]
    end

    subgraph EgressRuntime["EGRESS — Runtime"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM (platform-injected)"]
        PVC["PVC Mount<br/>Filesystem<br/>No network"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>Bearer Token (optional)"]
    end

    subgraph EgressBuild["EGRESS — Build-Time Only"]
        Habana["vault.habana.ai<br/>443/TCP HTTPS<br/>Habana RPMs"]
        PyPI["pypi.org<br/>443/TCP HTTPS<br/>Python packages"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Bearer Token"| Gateway
    Gateway -->|"HTTP/8000<br/>Plaintext<br/>No auth (TLS terminated)"| APIServer
    APIServer -->|"In-process<br/>Python API"| HPUWorker
    HPUWorker -->|"PCIe / HPU API<br/>Hardware bus"| GaudiDev

    %% Distributed flows
    APIServer -.->|"Ray protocol/6379<br/>No encryption"| RayHead
    RayHead -.->|"Dynamic port<br/>No encryption"| HPU_N
    HPU_N -.->|"HCCL<br/>All-reduce / All-gather<br/>No encryption"| HPUWorker

    %% Egress flows
    APIServer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    APIServer -->|"Filesystem<br/>Volume mount"| PVC
    APIServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HFHub

    %% Build-time flows
    Container -.->|"Build-time only<br/>HTTPS/443"| Habana
    Container -.->|"Build-time only<br/>HTTPS/443"| PyPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef distributed fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef buildonly fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray:5 5

    class Client external
    class Gateway ingress
    class APIServer,HPUWorker,GaudiDev container
    class RayHead,HPU_N distributed
    class S3,PVC,HFHub egress
    class Habana,PyPI buildonly
