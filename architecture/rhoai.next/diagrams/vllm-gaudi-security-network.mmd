graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["Gateway API (Envoy)<br/>443/TCP → 8443/TCP<br/>TLS 1.3<br/>HTTPRoute CR"]
    end

    subgraph AuthLayer["AUTH ENFORCEMENT (Sidecar)"]
        KubeRBAC["kube-rbac-proxy<br/>8443/TCP → 8000/TCP<br/>TLS termination<br/>SubjectAccessReview"]
    end

    subgraph Application["APPLICATION (vllm-gaudi Pod)"]
        direction TB
        subgraph NS_User["Namespace: {user-namespace}"]
            VLLMServer["vLLM OpenAI API Server<br/>odh-vllm-gaudi-rhel9<br/>Port: 8000/TCP HTTP<br/>Service: vllm-openai (ClusterIP)"]
        end
    end

    subgraph HardwareLayer["HARDWARE ACCELERATOR"]
        HPU["Intel Gaudi2/3 HPU<br/>SynapseAI 1.23.0<br/>habanalabs driver"]
        PeerHPU["Peer HPU Workers<br/>HCCL/RDMA (dynamic)<br/>No encryption"]
    end

    subgraph DistributedLayer["DISTRIBUTED COORDINATION"]
        Ray["Ray Head Node<br/>6379/TCP<br/>No encryption<br/>No auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["Model Storage<br/>(S3 / PVC)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / SA Token"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF Token (optional)"]
        HabanaRepo["vault.habana.ai<br/>443/TCP HTTPS<br/>(build-time only)"]
    end

    %% Flows with security details
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Bearer Token"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>SubjectAccessReview"| KubeRBAC
    KubeRBAC -->|"HTTP/8000<br/>None (localhost)<br/>Trusted sidecar"| VLLMServer

    VLLMServer -->|"PCIe / HCCL<br/>Kernel driver<br/>N/A"| HPU
    HPU -.->|"HCCL/RDMA (dynamic)<br/>No encryption !!<br/>No auth !!"| PeerHPU

    VLLMServer -->|"TCP/6379<br/>No encryption !!<br/>No auth !!"| Ray

    VLLMServer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / SA"| S3
    VLLMServer -->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hardware fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef distributed fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Gateway ingress
    class KubeRBAC auth
    class VLLMServer application
    class HPU,PeerHPU hardware
    class Ray distributed
    class S3,HFHub,HabanaRepo externalservice
