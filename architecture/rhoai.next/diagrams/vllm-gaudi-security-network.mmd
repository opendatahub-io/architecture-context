graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Gateway["KServe Ingress / Istio Gateway<br/>443/TCP → 8000/TCP<br/>TLS 1.2+<br/>OIDC / Bearer Auth"]
    end

    subgraph InferencePod["INFERENCE POD (Non-root UID 2000)"]
        direction TB

        VLLM["vllm-gaudi Container<br/>odh-vllm-gaudi-rhel9<br/>8000/TCP HTTP<br/>⚠️ FIPS DISABLED"]

        subgraph Endpoints["OpenAI-Compatible API"]
            EP1["POST /v1/completions"]
            EP2["POST /v1/chat/completions"]
            EP3["GET /v1/models"]
            EP4["POST /v1/embeddings"]
            EP5["GET /health"]
        end

        HPU["Intel Gaudi HPU<br/>SynapseAI 1.23.0<br/>Gaudi 2 / Gaudi 3"]
    end

    subgraph DistributedWorkers["DISTRIBUTED WORKERS (Multi-HPU)"]
        Peers["HPUWorker Peers<br/>HCCL Collectives"]
        NIXL["NIXL Peers<br/>RDMA/TCP<br/>KV Cache Transfer"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["Model Storage<br/>S3/PVC<br/>443/TCP HTTPS<br/>AWS IAM"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC/Bearer"| Gateway
    Gateway -->|"HTTP/8000<br/>Istio mTLS sidecar<br/>No app-level auth"| VLLM
    VLLM --> EP1
    VLLM --> EP2
    VLLM --> EP3
    VLLM --> EP4
    VLLM --> EP5
    VLLM -->|"PCIe DMA"| HPU
    HPU -->|"HCCL<br/>No encryption<br/>No auth"| Peers
    HPU -->|"RDMA/TCP<br/>No encryption<br/>No auth"| NIXL
    VLLM -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM"| S3
    VLLM -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef hardware fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef distributed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class VLLM warning
    class EP1,EP2,EP3,EP4,EP5 pod
    class HPU hardware
    class Peers,NIXL distributed
    class S3,HFHub externalservice
