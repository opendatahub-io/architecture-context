graph LR
    vLLM["vLLM Inference Server<br/>(vllm-cuda)"]

    %% External Dependencies
    vLLM -->|"base image<br/>FROM directive"| RHAIIS["RHAIIS Base Image<br/>vllm-cuda-rhel9:3.2.2"]
    vLLM -->|"GPU acceleration"| CUDA["NVIDIA CUDA<br/>(inherited from base)"]
    vLLM -->|"pipeline definitions"| Konflux["konflux-central<br/>(Tekton sync)"]

    %% Internal Platform Dependencies
    KServe["KServe"] -->|"deploys as<br/>InferenceService runtime"| vLLM
    ModelController["ODH Model Controller"] -->|"orchestrates<br/>lifecycle"| vLLM

    %% Integration Points
    vLLM -->|"mTLS sidecar<br/>auth enforcement"| Istio["Istio Service Mesh"]
    vLLM -->|"GPU device<br/>allocation"| GPUPlugin["NVIDIA GPU<br/>Device Plugin"]
    vLLM -->|"model weights<br/>HTTPS/filesystem"| ModelStorage["Model Storage<br/>(S3 / PVC)"]
    vLLM -->|"model download<br/>HTTPS/443"| HFHub["Hugging Face Hub"]

    %% Upstream lineage
    subgraph "Upstream Lineage"
        direction TB
        Upstream["vllm-project/vllm<br/>(upstream OSS)"]
        ODHFork["opendatahub-io/vllm<br/>(ODH fork)"]
        Downstream["red-hat-data-services/vllm<br/>(RHOAI downstream)"]
        Upstream -->|"forked"| ODHFork
        ODHFork -->|"forked"| Downstream
    end

    style vLLM fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style RHAIIS fill:#999,stroke:#333,color:#fff
    style CUDA fill:#999,stroke:#333,color:#fff
    style Konflux fill:#999,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelController fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#f5a623,stroke:#333
    style GPUPlugin fill:#f5a623,stroke:#333
    style ModelStorage fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style Upstream fill:#e8e8e8,stroke:#333
    style ODHFork fill:#e8e8e8,stroke:#333
    style Downstream fill:#e8e8e8,stroke:#333
