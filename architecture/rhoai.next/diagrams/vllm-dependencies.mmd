graph LR
    VLLM["vLLM CUDA<br/>(ServingRuntime Image)"]

    %% Build-time Dependencies
    VLLM -->|"FROM (build-time)<br/>v3.2.2"| RHAIIS["RHAIIS vLLM CUDA Image<br/>registry.redhat.io/rhaiis/<br/>vllm-cuda-rhel9:3.2.2"]
    RHAIIS -->|"built on"| AIPCC["AIPCC CUDA Base Images<br/>CUDA 12.9/13.0/13.2"]

    %% Runtime Infrastructure Dependencies
    VLLM -->|"deployed by"| KServe["KServe<br/>(ServingRuntime consumer)"]
    VLLM -->|"auth sidecar"| KubeRBAC["kube-rbac-proxy<br/>(injected by RHOAI)"]
    VLLM -->|"ingress routing"| GatewayAPI["Gateway API<br/>(HTTPRoute / Envoy)"]

    %% Hardware Dependencies
    VLLM -->|"GPU compute"| NVIDIADriver["NVIDIA GPU Drivers"]
    VLLM -->|"device scheduling"| DevicePlugin["NVIDIA Device Plugin"]
    NVIDIADriver -->|"runtime"| CUDARuntime["NVIDIA CUDA Runtime<br/>(cuDNN, cuBLAS, NCCL)"]

    %% Model Storage Dependencies
    VLLM -->|"model loading<br/>HTTPS/443"| S3["S3 Storage<br/>(AWS IAM / HMAC)"]
    VLLM -->|"model loading<br/>Filesystem"| PVC["Persistent Volume<br/>(PVC)"]
    VLLM -->|"model loading<br/>HTTPS/443"| HFHub["Hugging Face Hub<br/>(Bearer Token)"]

    %% CI/CD Dependencies
    VLLM -.->|"pipeline sync"| KonfluxCentral["konflux-central<br/>(Tekton pipelines)"]

    %% Platform Integration Points (things that consume vLLM)
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe
    Pipelines["Data Science Pipelines"] -.->|"auto deploy"| KServe

