graph LR
    VLLM["vLLM CUDA<br/>(odh-vllm-cuda-rhel9)"]

    %% External Dependencies (Required)
    VLLM -->|"GPU compute<br/>(required)"| NVIDIADrivers["NVIDIA CUDA Drivers<br/>≥ compatible version"]
    VLLM -->|"device allocation<br/>(required)"| NVIDIAGPU["NVIDIA GPU Hardware<br/>Any CUDA-capable GPU"]

    %% External Dependencies (Optional)
    VLLM -.->|"model download<br/>(optional)"| HuggingFace["HuggingFace Hub<br/>huggingface.co"]
    VLLM -.->|"model download<br/>(optional)"| S3["S3-Compatible Storage"]

    %% Internal Platform Dependencies
    VLLM -->|"container image ref<br/>ServingRuntime CR"| KServe["KServe / ServingRuntime"]
    VLLM -->|"base image<br/>all runtime deps"| RHAIISBase["RHAIIS vllm-cuda-rhel9:3.2.2<br/>(registry.redhat.io)"]
    VLLM -->|"CI/CD build<br/>Tekton PipelineRun"| Konflux["Konflux Build Pipeline"]

    %% Integration Points (components that integrate WITH vLLM)
    KServeIS["KServe InferenceService"] -->|"triggers pod creation"| VLLM
    KubeRBACProxy["kube-rbac-proxy Sidecar<br/>(RHOAI 3.x)"] -->|"auth enforcement<br/>8443/TCP → 8000/TCP"| VLLM
    Prometheus["Prometheus"] -->|"metrics scrape<br/>HTTP /metrics"| VLLM
    GPUPlugin["NVIDIA GPU Device Plugin"] -->|"device scheduling"| VLLM

