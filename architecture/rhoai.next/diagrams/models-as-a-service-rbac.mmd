graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["maas-api<br/>(infra namespace)"]
        SA_Controller["maas-controller<br/>(controller namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_API["maas-api<br/>(cluster-scoped)"]
        CRB_Controller["maas-controller-role-binding<br/>(cluster-scoped)"]
        RB_LeaderElection["maas-controller-leader-election<br/>(namespace-scoped)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_API["maas-api"]
        CR_Controller["maas-controller-role"]
        CR_LeaderElection["maas-controller-leader-election-role"]
    end

    %% Bindings
    SA_API -->|bound via| CRB_API
    CRB_API -->|grants| CR_API
    SA_Controller -->|bound via| CRB_Controller
    CRB_Controller -->|grants| CR_Controller
    SA_Controller -->|bound via| RB_LeaderElection
    RB_LeaderElection -->|grants| CR_LeaderElection

    subgraph API_Resources["maas-api Permissions"]
        direction LR
        API_Secrets["core/secrets<br/>(maas-db-config)<br/>get"]
        API_NS["core/namespaces<br/>get, list, watch, create"]
        API_SA["core/serviceaccounts<br/>serviceaccounts/token<br/>get, list, watch,<br/>create, delete"]
        API_TokenReview["authentication.k8s.io<br/>tokenreviews<br/>create"]
        API_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        API_MaaSCRDs["maas.opendatahub.io<br/>maasauthpolicies,<br/>maasmodelrefs,<br/>maassubscriptions<br/>get, list, watch"]
        API_HTTPRoutes["gateway.networking.k8s.io<br/>httproutes<br/>get, list, watch"]
        API_Gateways["gateway.networking.k8s.io<br/>gateways<br/>get"]
    end

    subgraph Controller_Resources["maas-controller-role Permissions"]
        direction LR
        Ctrl_Core["core/configmaps,<br/>services, namespaces,<br/>serviceaccounts<br/>FULL CRUD + watch"]
        Ctrl_Apps["apps/deployments<br/>FULL CRUD + watch"]
        Ctrl_Batch["batch/cronjobs<br/>create, delete, get,<br/>list, patch, watch"]
        Ctrl_MaaS["maas.opendatahub.io<br/>aitenants, maasauthpolicies,<br/>maasmodelrefs, maassubscriptions,<br/>maastenantconfigs<br/>FULL CRUD + watch"]
        Ctrl_Kuadrant["kuadrant.io<br/>authpolicies,<br/>tokenratelimitpolicies<br/>FULL CRUD + watch"]
        Ctrl_Gateway["gateway.networking.k8s.io<br/>httproutes<br/>FULL CRUD + watch"]
        Ctrl_Istio["networking.istio.io<br/>envoyfilters,<br/>destinationrules,<br/>serviceentries<br/>FULL CRUD + watch"]
        Ctrl_NetPol["networking.k8s.io<br/>networkpolicies<br/>create, delete, get,<br/>list, patch, watch"]
        Ctrl_Monitoring["monitoring.coreos.com<br/>podmonitors,<br/>servicemonitors<br/>create, delete, get,<br/>list, patch, watch"]
        Ctrl_KServe["serving.kserve.io<br/>llminferenceservices<br/>get, list, watch"]
        Ctrl_RBAC["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings<br/>create, delete, get,<br/>list, patch, watch"]
        Ctrl_OTel["opentelemetry.io<br/>opentelemetrycollectors<br/>create, delete, get,<br/>list, patch, watch"]
        Ctrl_Perses["perses.dev<br/>persesdashboards,<br/>persesdatasources<br/>create, delete, get,<br/>list, patch, watch"]
        Ctrl_Telemetry["telemetry.istio.io<br/>telemetries<br/>create, delete, get,<br/>list, patch, watch"]
    end

    CR_API -->|permissions| API_Secrets
    CR_API -->|permissions| API_NS
    CR_API -->|permissions| API_SA
    CR_API -->|permissions| API_TokenReview
    CR_API -->|permissions| API_SAR
    CR_API -->|permissions| API_MaaSCRDs
    CR_API -->|permissions| API_HTTPRoutes
    CR_API -->|permissions| API_Gateways

    CR_Controller -->|permissions| Ctrl_Core
    CR_Controller -->|permissions| Ctrl_Apps
    CR_Controller -->|permissions| Ctrl_Batch
    CR_Controller -->|permissions| Ctrl_MaaS
    CR_Controller -->|permissions| Ctrl_Kuadrant
    CR_Controller -->|permissions| Ctrl_Gateway
    CR_Controller -->|permissions| Ctrl_Istio
    CR_Controller -->|permissions| Ctrl_NetPol
    CR_Controller -->|permissions| Ctrl_Monitoring
    CR_Controller -->|permissions| Ctrl_KServe
    CR_Controller -->|permissions| Ctrl_RBAC
    CR_Controller -->|permissions| Ctrl_OTel
    CR_Controller -->|permissions| Ctrl_Perses
    CR_Controller -->|permissions| Ctrl_Telemetry

    %% Styling
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style CR_API fill:#f5a623,stroke:#333
    style CR_Controller fill:#f5a623,stroke:#333
    style CR_LeaderElection fill:#f5a623,stroke:#333
    style CRB_API fill:#e8e8e8,stroke:#333
    style CRB_Controller fill:#e8e8e8,stroke:#333
    style RB_LeaderElection fill:#e8e8e8,stroke:#333

    style API_Secrets fill:#7ed321,stroke:#333
    style API_NS fill:#7ed321,stroke:#333
    style API_SA fill:#7ed321,stroke:#333
    style API_TokenReview fill:#7ed321,stroke:#333
    style API_SAR fill:#7ed321,stroke:#333
    style API_MaaSCRDs fill:#7ed321,stroke:#333
    style API_HTTPRoutes fill:#7ed321,stroke:#333
    style API_Gateways fill:#7ed321,stroke:#333

    style Ctrl_Core fill:#7ed321,stroke:#333
    style Ctrl_Apps fill:#7ed321,stroke:#333
    style Ctrl_Batch fill:#7ed321,stroke:#333
    style Ctrl_MaaS fill:#7ed321,stroke:#333
    style Ctrl_Kuadrant fill:#7ed321,stroke:#333
    style Ctrl_Gateway fill:#7ed321,stroke:#333
    style Ctrl_Istio fill:#7ed321,stroke:#333
    style Ctrl_NetPol fill:#7ed321,stroke:#333
    style Ctrl_Monitoring fill:#7ed321,stroke:#333
    style Ctrl_KServe fill:#7ed321,stroke:#333
    style Ctrl_RBAC fill:#7ed321,stroke:#333
    style Ctrl_OTel fill:#7ed321,stroke:#333
    style Ctrl_Perses fill:#7ed321,stroke:#333
    style Ctrl_Telemetry fill:#7ed321,stroke:#333
