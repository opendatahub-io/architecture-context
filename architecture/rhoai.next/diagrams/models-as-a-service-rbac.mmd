graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["maas-controller<br/>Namespace: opendatahub"]
        SA_API["maas-api<br/>Namespace: {tenant-infra}"]
    end

    subgraph ClusterBindings["ClusterRoleBindings"]
        CRB["maas-controller-rolebinding"]
    end

    subgraph TenantBindings["Per-Tenant RoleBindings"]
        TRB_Admin["aitenant-{name}-tenant-admin<br/>Namespace: {tenant-ns}"]
        TRB_Object["aitenant-{name}-object-admin<br/>Namespace: {infra-ns}"]
    end

    subgraph ClusterRolePerms["ClusterRole: maas-controller-role (235 rules)"]
        direction TB

        subgraph MaaSCRDs["maas.opendatahub.io"]
            MaasCRDs["aitenants, maasauthpolicies,<br/>maasmodelrefs, maassubscriptions,<br/>maastenantconfigs, configs,<br/>externalmodels, tenants"]
            MaasStatus["*/status"]
            MaasFinalizers["*/finalizers"]
        end

        subgraph GatewayPerms["gateway.networking.k8s.io"]
            GW_Read["gateways<br/>get, list, watch"]
            GW_Routes["httproutes, httproutes/finalizers<br/>full CRUD"]
        end

        subgraph KuadrantPerms["kuadrant.io"]
            Kuadrant_Policies["authpolicies,<br/>tokenratelimitpolicies,<br/>ratelimitpolicies<br/>full CRUD"]
        end

        subgraph KServePerms["serving.kserve.io"]
            KServe_Read["llminferenceservices<br/>get, list, watch"]
        end

        subgraph CorePerms["core (v1)"]
            Core_NS["namespaces<br/>get, list, watch, create, patch"]
            Core_CRUD["configmaps, services<br/>full CRUD"]
            Core_Read["secrets, pods, endpoints<br/>get, list, watch"]
            Core_SA["serviceaccounts,<br/>serviceaccounts/token<br/>get, list, watch, create, delete, patch"]
            Core_Events["events<br/>create, patch"]
        end

        subgraph AppsPerms["apps"]
            Apps_Deploy["deployments,<br/>deployments/finalizers<br/>full CRUD"]
        end

        subgraph RBACPerms["rbac.authorization.k8s.io"]
            RBAC_Full["roles, clusterroles,<br/>clusterrolebindings<br/>full CRUD"]
            RBAC_RB["rolebindings<br/>get, delete"]
        end

        subgraph AuthPerms["Authentication & Authorization"]
            Auth_TR["tokenreviews<br/>create"]
            Auth_SAR["subjectaccessreviews<br/>create"]
        end

        subgraph IstioPerms["networking.istio.io"]
            Istio_Net["envoyfilters,<br/>destinationrules,<br/>serviceentries<br/>full CRUD"]
        end

        subgraph NetworkPerms["networking.k8s.io"]
            NetPol["networkpolicies<br/>get, list, watch, create, delete, patch"]
        end

        subgraph MonitoringPerms["monitoring.coreos.com"]
            Monitoring["servicemonitors,<br/>podmonitors<br/>get, list, watch, create, delete, patch"]
        end

        subgraph AdditionalPerms["Additional API Groups"]
            Batch["batch: jobs, cronjobs"]
            Telemetry["telemetry.istio.io: telemetries"]
            KuadrantExt["extensions.kuadrant.io: telemetrypolicies"]
            OTEL["opentelemetry.io: opentelemetrycollectors"]
            AuthorinoOp["operator.authorino.kuadrant.io: authorinos"]
            Perses["perses.dev: persesdashboards, persesdatasources"]
            DSCI["dscinitialization.opendatahub.io: dscinitializations"]
            Discovery["discovery.k8s.io: endpointslices"]
            CRDDefs["apiextensions.k8s.io: customresourcedefinitions"]
            InferenceODH["inference.opendatahub.io: externalmodels, externalproviders"]
            OSAuth["config.openshift.io: authentications"]
        end
    end

    %% Bindings
    SA_Controller -->|"bound via"| CRB
    CRB -->|"grants"| ClusterRolePerms

    %% Tenant bindings created by controller
    SA_Controller -->|"creates"| TenantBindings
    TRB_Admin -->|"grants tenant-admin Role"| MaasCRDs
    TRB_Object -->|"grants object-admin Role"| Core_CRUD

    %% API service account (limited)
    SA_API -->|"uses"| Auth_TR
    SA_API -->|"uses"| Auth_SAR

    %% Styles
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e8e8e8,stroke:#333
    style TRB_Admin fill:#e8e8e8,stroke:#333
    style TRB_Object fill:#e8e8e8,stroke:#333
    style MaasCRDs fill:#7ed321,stroke:#333
    style MaasStatus fill:#7ed321,stroke:#333
    style MaasFinalizers fill:#7ed321,stroke:#333
    style GW_Read fill:#f5a623,stroke:#333
    style GW_Routes fill:#f5a623,stroke:#333
    style Kuadrant_Policies fill:#f5a623,stroke:#333
    style KServe_Read fill:#f5a623,stroke:#333
    style Auth_TR fill:#e74c3c,stroke:#333,color:#fff
    style Auth_SAR fill:#e74c3c,stroke:#333,color:#fff
