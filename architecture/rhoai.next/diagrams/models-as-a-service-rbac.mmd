graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["maas-controller<br/>(Namespace: opendatahub)"]
        SA_API["maas-api<br/>(Namespace: per-tenant infra)"]
    end

    subgraph Bindings["ClusterRole Bindings"]
        CRB_Controller["maas-controller-rolebinding<br/>(cluster-scoped)"]
        CRB_API["maas-api<br/>(cluster-scoped)"]
        CRB_API_Supp["maas-api-supplemental<br/>(cluster-scoped)"]
        RB_Leader["maas-controller-leader-election<br/>(Namespace: opendatahub)"]
    end

    subgraph ControllerRole["ClusterRole: maas-controller-role"]
        direction TB
        CR_MaaS["maas.opendatahub.io<br/>aitenants, maasauthpolicies,<br/>maasmodelrefs, maassubscriptions,<br/>maastenantconfigs<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_MaaS_RO["maas.opendatahub.io<br/>configs, externalmodels<br/>get,list,watch"]
        CR_Gateway["gateway.networking.k8s.io<br/>httproutes<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_Gateway_RO["gateway.networking.k8s.io<br/>gateways<br/>get,list,watch"]
        CR_Kuadrant["kuadrant.io<br/>authpolicies,<br/>tokenratelimitpolicies<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_KServe["serving.kserve.io<br/>llminferenceservices<br/>get,list,watch"]
        CR_Istio["networking.istio.io<br/>destinationrules, envoyfilters,<br/>serviceentries<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_Core["core<br/>configmaps, services,<br/>namespaces<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings, roles<br/>create,delete,get,list,<br/>patch,watch"]
        CR_Auth["authentication.k8s.io<br/>tokenreviews<br/>create"]
        CR_Authz["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        CR_LLMd["llm-d.ai<br/>inferenceobjectives<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_Apps["apps<br/>deployments<br/>create,delete,get,list,<br/>patch,update,watch"]
        CR_NetPol["networking.k8s.io<br/>networkpolicies<br/>create,delete,get,list,<br/>patch,update,watch"]
    end

    subgraph APIRole["ClusterRole: maas-api"]
        direction TB
        AR_Secrets["core<br/>secrets (maas-db-config only)<br/>get"]
        AR_Core["core<br/>namespaces, serviceaccounts,<br/>services<br/>get,list,watch"]
        AR_Auth["authentication.k8s.io<br/>tokenreviews<br/>create"]
        AR_Authz["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        AR_MaaS["maas.opendatahub.io<br/>maasauthpolicies, maasmodelrefs,<br/>maassubscriptions<br/>get,list,watch"]
        AR_Gateway["gateway.networking.k8s.io<br/>gateways<br/>get"]
        AR_OCP["config.openshift.io<br/>apiservers<br/>get,list,watch"]
    end

    subgraph LeaderRole["Role: maas-controller-leader-election-role"]
        LR_Lease["coordination.k8s.io<br/>leases<br/>get,list,watch,create,<br/>update,patch,delete"]
    end

    %% Bindings
    SA_Controller -->|bound via| CRB_Controller
    CRB_Controller -->|grants| CR_MaaS
    SA_Controller -->|bound via| RB_Leader
    RB_Leader -->|grants| LR_Lease

    SA_API -->|bound via| CRB_API
    CRB_API -->|grants| AR_Secrets
    SA_API -->|bound via| CRB_API_Supp

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_API fill:#4a90e2,color:#fff

    style CRB_Controller fill:#e8e8e8,stroke:#333
    style CRB_API fill:#e8e8e8,stroke:#333
    style CRB_API_Supp fill:#e8e8e8,stroke:#333
    style RB_Leader fill:#e8e8e8,stroke:#333

    style CR_MaaS fill:#f5a623,color:#fff
    style CR_MaaS_RO fill:#f5a623,color:#fff
    style CR_Gateway fill:#f5a623,color:#fff
    style CR_Gateway_RO fill:#f5a623,color:#fff
    style CR_Kuadrant fill:#f5a623,color:#fff
    style CR_KServe fill:#f5a623,color:#fff
    style CR_Istio fill:#f5a623,color:#fff
    style CR_Core fill:#f5a623,color:#fff
    style CR_RBAC fill:#f5a623,color:#fff
    style CR_Auth fill:#f5a623,color:#fff
    style CR_Authz fill:#f5a623,color:#fff
    style CR_LLMd fill:#f5a623,color:#fff
    style CR_Apps fill:#f5a623,color:#fff
    style CR_NetPol fill:#f5a623,color:#fff

    style AR_Secrets fill:#7ed321,color:#fff
    style AR_Core fill:#7ed321,color:#fff
    style AR_Auth fill:#7ed321,color:#fff
    style AR_Authz fill:#7ed321,color:#fff
    style AR_MaaS fill:#7ed321,color:#fff
    style AR_Gateway fill:#7ed321,color:#fff
    style AR_OCP fill:#7ed321,color:#fff

    style LR_Lease fill:#9b59b6,color:#fff
