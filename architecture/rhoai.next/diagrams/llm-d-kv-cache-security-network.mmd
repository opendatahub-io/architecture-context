graph TB
    subgraph ClusterInternal["CLUSTER-INTERNAL (No External Ingress)"]
        direction TB

        subgraph ServiceLayer["SERVICE LAYER"]
            direction TB

            subgraph Pod["kv-cache-manager Pod"]
                Manager["kv-cache-manager<br/>SA: operator-controller-manager<br/>Image: ghcr.io/llm-d/llm-d-kv-cache"]
                Tokenizer["UDS Tokenizer Sidecar<br/>Image: llm-d-uds-tokenizer<br/>Health: 8082/TCP"]
            end

            IndexerGRPC["IndexerService gRPC<br/>50051/TCP<br/>No Auth"]
        end

        subgraph EventIngestion["EVENT INGESTION"]
            Pool["kvevents.Pool<br/>Sharded Workers<br/>FNV-1a routing"]
        end
    end

    subgraph ModelServers["MODEL SERVERS"]
        vLLM["vLLM/SGLang Pods<br/>ZMQ PUB"]
    end

    subgraph IndexBackend["INDEX BACKEND"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>No Auth default<br/>TLS via rediss://"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>TLS 1.2+<br/>ServiceAccount"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC<br/>Insecure default"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>API token optional"]
    end

    Client["HTTP Client / llm-d-router"] -->|"HTTP/8080<br/>No encryption<br/>No Auth"| Manager
    Manager -->|"gRPC/UDS<br/>No encryption<br/>FS permissions"| Tokenizer
    Client -.->|"gRPC/50051<br/>No encryption<br/>No Auth"| IndexerGRPC

    vLLM -->|"ZMQ SUB/5557<br/>No encryption<br/>No Auth<br/>msgpack"| Pool
    Pool -->|"TCP/6379<br/>No encryption default<br/>Pipelined + Lua"| Redis
    Manager -->|"TCP/6379<br/>No encryption default"| Redis

    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    Manager -->|"gRPC/4317<br/>Insecure default"| OTel
    Tokenizer -->|"HTTPS/443<br/>TLS<br/>API token"| HFHub

    %% Styling
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef ingestion fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef client fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Manager,Tokenizer,IndexerGRPC service
    class K8sAPI,OTel,HFHub external
    class Redis backend
    class Pool ingestion
    class vLLM warning
    class Client client
