graph TB
    subgraph External["EXTERNAL SERVICES (TLS-protected)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API token (optional)"]
        ModelScope["ModelScope (optional)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph Cluster["CLUSTER INTERNAL (No Service Mesh)"]
        direction TB

        subgraph vLLMPod["vLLM Inference Pod"]
            vLLM["vLLM Process<br/>ZMQ PUB 5557/TCP<br/>Plaintext<br/>No auth"]
        end

        subgraph KVCachePod["KV-Cache Manager / Router Pod"]
            direction TB
            EventsPool["kvevents.Pool<br/>ZMQ SUB 5557/TCP<br/>Plaintext, No auth"]
            Indexer["kvcache.Indexer<br/>In-process scoring"]
            IndexerGRPC["IndexerService gRPC<br/>50051/TCP<br/>Plaintext (insecure creds)<br/>No auth"]
            HTTPAPI["HTTP API<br/>8080/TCP<br/>Plaintext, No auth<br/>/metrics /score_*"]
            UDSTokenizer["UDS Tokenizer<br/>UDS: /tmp/tokenizer/*.socket<br/>gRPC over UDS<br/>No encryption, No auth<br/>Health: 8082/TCP"]
        end

        subgraph EvictorPod["PVC Evictor Pod"]
            Evictor["PVC Evictor<br/>No network ports<br/>POSIX I/O only"]
        end

        subgraph Storage["Cluster Storage"]
            Redis["Redis / Valkey<br/>6379/TCP<br/>Plaintext*<br/>No auth*"]
            SharedPVC["Shared PVC<br/>POSIX filesystem<br/>/kv-cache"]
        end

        subgraph Infra["Cluster Infrastructure"]
            K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>SA token auth"]
            OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>Plaintext*<br/>No auth"]
            Prometheus["Prometheus<br/>Scrapes 8080/TCP<br/>HTTP, No auth"]
        end
    end

    %% Data flows with security details
    vLLM -->|"ZMQ PUB/SUB 5557/TCP<br/>Plaintext, No auth<br/>3-frame msgpack"| EventsPool
    EventsPool -->|"in-process"| Indexer
    Indexer -->|"gRPC over UDS<br/>No encryption"| UDSTokenizer
    UDSTokenizer -->|"HTTPS 443/TCP<br/>TLS 1.2+<br/>API token (opt)"| HFHub
    UDSTokenizer -.->|"HTTPS 443/TCP<br/>TLS 1.2+"| ModelScope

    Indexer -->|"Redis 6379/TCP<br/>Plaintext*"| Redis
    EventsPool -->|"HTTPS 443/TCP<br/>TLS, SA token"| K8sAPI
    Indexer -->|"gRPC 4317/TCP<br/>Plaintext*"| OTLP

    Evictor -->|"POSIX I/O<br/>Filesystem"| SharedPVC

    Prometheus -->|"HTTP 8080/TCP<br/>Plaintext"| HTTPAPI

    %% Styling
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef plaintext fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef secure fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef infra fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class HFHub,ModelScope external
    class vLLM,EventsPool,Indexer,IndexerGRPC,HTTPAPI,UDSTokenizer plaintext
    class K8sAPI secure
    class OTLP,Prometheus infra
    class Redis,SharedPVC,Evictor storage
