    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style PlatformDetect fill:#4a90e2,stroke:#333,color:#fff
    style Tier1 fill:#4a90e2,stroke:#333,color:#fff
    style Tier2 fill:#4a90e2,stroke:#333,color:#fff
    style Tier3 fill:#4a90e2,stroke:#333,color:#fff
    style ReportGen fill:#4a90e2,stroke:#333,color:#fff
    style API fill:#f5a623,stroke:#333
    style SA fill:#e8e8e8,stroke:#333
    style GPUAgent fill:#7ed321,stroke:#333
    style IperfServer fill:#7ed321,stroke:#333
    style IperfClient fill:#7ed321,stroke:#333
    style TCPLatServer fill:#7ed321,stroke:#333
    style TCPLatClient fill:#7ed321,stroke:#333
    style BWServer fill:#9b59b6,stroke:#333,color:#fff
    style BWClient fill:#9b59b6,stroke:#333,color:#fff
    style PingmeshServer fill:#9b59b6,stroke:#333,color:#fff
    style PingmeshClient fill:#9b59b6,stroke:#333,color:#fff
