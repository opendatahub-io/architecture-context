graph TB
    subgraph CLI["RHAII Cluster Validation (kubectl plugin)"]
        direction TB
        Validator["rhaii-validator<br/>Go CLI Binary"]
        Controller["Controller Mode<br/>(user invocation)"]
        Agent["Agent Mode<br/>(run inside Jobs)"]
        Validator --> Controller
        Validator --> Agent
    end

    subgraph Checks["Validation Checks"]
        direction TB
        GPUCheck["GPU Driver Check<br/>(nvidia-smi / rocm-smi)"]
        ECCCheck["ECC Memory Check"]
        TopologyCheck["GPU-NIC Topology<br/>Pairing"]
        CRDCheck["CRD Prerequisite<br/>Validation"]
        OperatorCheck["Operator Health<br/>Check"]
    end

    subgraph BandwidthTests["Bandwidth Tests"]
        direction TB
        IperfTest["iperf3 TCP<br/>Bandwidth"]
        RDMABWTest["ib_write_bw<br/>RDMA Bandwidth"]
        PingMesh["ibv_rc_pingpong<br/>RDMA Connectivity"]
        LoopbackBW["GPU-NIC Loopback<br/>Bandwidth Probe"]
        TCPLatency["TCP Latency<br/>Echo Test"]
    end

    subgraph ToolsImage["validator-tools Container"]
        direction TB
        Iperf3["iperf3"]
        Perftest["perftest Suite<br/>(CUDA GPUDirect)"]
    end

    subgraph Topologies["Test Topologies"]
        Ring["Ring<br/>(sequential pairs)"]
        Star["Star<br/>(one server, N clients)"]
        Pairwise["Pairwise<br/>(N-choose-2 mesh)"]
    end

    User["Cluster Admin"] -->|"kubectl rhaii-validate"| Validator
    Controller -->|"deploys Jobs"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|"reads pod logs"| K8sAPI
    Controller -->|"stores report"| ConfigMap["ConfigMap<br/>(JSON report)"]

    Agent --> GPUCheck
    Agent --> ECCCheck
    Agent --> TopologyCheck

    Controller --> CRDCheck
    Controller --> OperatorCheck
    Controller --> BandwidthTests

    IperfTest --> Iperf3
    RDMABWTest --> Perftest
    PingMesh --> Perftest
    LoopbackBW --> Perftest

    BandwidthTests --> Topologies

    GPUCheck -->|"chroot /host"| HostSysfs["Host sysfs<br/>/sys/class/infiniband<br/>/sys/bus/pci/devices"]

    style Validator fill:#4a90e2,color:#fff
    style Agent fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style Iperf3 fill:#7ed321,color:#fff
    style Perftest fill:#7ed321,color:#fff
    style K8sAPI fill:#f5a623,color:#fff
    style ConfigMap fill:#f5a623,color:#fff
    style HostSysfs fill:#e8e8e8,color:#333
    style User fill:#f9f9f9,stroke:#333
