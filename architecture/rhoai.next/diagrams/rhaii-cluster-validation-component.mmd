graph TB
    subgraph UserWorkstation["User Workstation"]
        CLI["kubectl rhaii-validate<br/>(Go CLI / kubectl plugin)"]
    end

    subgraph Controller["Controller Logic (in CLI process)"]
        direction TB
        PlatformDetect["Platform Auto-Detection<br/>(OCP/AKS/EKS/CoreWeave)"]
        Tier1["Tier 1: CRD & Operator Checks<br/>(API-level, no Jobs)"]
        Tier2["Tier 2: Per-Node GPU/RDMA Checks<br/>(deploys Jobs to GPU nodes)"]
        Tier3["Tier 3: Multi-Node Network Tests<br/>(bandwidth, pingmesh)"]
        ReportGen["Report Generator<br/>(JSON / table output)"]

        PlatformDetect --> Tier1
        Tier1 --> Tier2
        Tier2 -->|topology data| Tier3
        Tier3 --> ReportGen
    end

    subgraph K8sCluster["Kubernetes Cluster"]
        direction TB
        API["Kubernetes API Server<br/>6443/TCP HTTPS"]

        subgraph Namespace["Namespace: rhaii-validation"]
            SA["ServiceAccount<br/>rhaii-validator<br/>(empty ClusterRole, SCC subject only)"]

            subgraph GPUCheckJobs["GPU Check Jobs (per-node)"]
                GPUAgent["Validator Agent<br/>(privileged container)<br/>nvidia-smi / rocm-smi / ibstat"]
            end

            subgraph BandwidthJobs["Bandwidth Test Jobs"]
                IperfServer["iperf3 Server<br/>5201/TCP"]
                IperfClient["iperf3 Client"]
                TCPLatServer["TCP Latency Server<br/>12865/TCP"]
                TCPLatClient["TCP Latency Client"]
            end

            subgraph RDMAJobs["RDMA Test Jobs"]
                BWServer["ib_write_bw Server<br/>18515+/TCP"]
                BWClient["ib_write_bw Client"]
                PingmeshServer["ibv_rc_pingpong Server"]
                PingmeshClient["ibv_rc_pingpong Client"]
            end

            ConfigMapReport["ConfigMap<br/>rhaii-validate-report"]
            ConfigMapPingmesh["ConfigMap<br/>rhaii-validate-pingmesh-failures"]
        end
    end

    subgraph Hardware["Node Hardware (accessed via sysfs)"]
        GPU["GPU Devices<br/>(NVIDIA / AMD)"]
        RDMA["RDMA NICs<br/>(InfiniBand / RoCE)"]
        PCIe["PCIe / NUMA Topology"]
    end

    %% Controller flows
    CLI -->|kubeconfig auth| API
    CLI --> Controller

    %% Tier 1
    Tier1 -->|list CRDs, check pods| API

    %% Tier 2
    Tier2 -->|create Jobs| API
    GPUAgent -->|local exec| GPU
    GPUAgent -->|local exec| RDMA
    GPUAgent -->|sysfs read| PCIe

    %% Tier 3
    Tier3 -->|create Jobs| API
    IperfClient -->|TCP/5201| IperfServer
    TCPLatClient -->|TCP/12865| TCPLatServer
    BWClient -->|RDMA/18515+| BWServer
    PingmeshClient -->|RDMA/dynamic| PingmeshServer

    %% Report
    ReportGen -->|store results| ConfigMapReport

