graph LR
    AutoGluon["KServe AutoGluon Server<br/>Python Inference Runtime"]

    %% Core ML Dependencies
    AutoGluon -->|"tabular prediction<br/>v1.5.0+rhaiv.3"| AGTabular["autogluon.tabular"]
    AutoGluon -->|"time series forecasting<br/>v1.5.0+rhaiv.3"| AGTimeseries["autogluon.timeseries"]

    %% ML Backends
    AGTabular -->|"gradient boosting"| LightGBM["LightGBM 4.6.0"]
    AGTabular -->|"gradient boosting"| XGBoost["XGBoost 3.1.3"]
    AGTabular -->|"neural networks"| fastai["fastai 2.8.7"]
    AGTimeseries -->|"Chronos models"| Transformers["transformers 4.57.6"]

    %% Shared ML Libraries
    AGTabular -->|"ML utilities"| sklearn["scikit-learn 1.7.2"]
