graph LR
    AutoGluon["KServe AutoGluon Server<br/>(autogluonserver)"]

    %% Core ML Dependencies
    AutoGluon -->|"tabular prediction<br/>==1.5.0+rhaiv.3"| AGTabular["autogluon.tabular"]
    AutoGluon -->|"time series forecast<br/>==1.5.0+rhaiv.3"| AGTimeSeries["autogluon.timeseries"]

    %% KServe Framework Dependencies
    AutoGluon -->|"model server framework<br/>>=0.16.0"| KServeSDK["kserve (Python SDK)"]
