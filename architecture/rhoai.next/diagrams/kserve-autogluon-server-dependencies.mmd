    KServeSDK -->|"HTTP serving"| Uvicorn["uvicorn 0.49.0"]
    KServeSDK -->|"REST routing"| FastAPI["fastapi 0.136.3"]

    %% Internal Platform Dependencies
    KServeCtrl["KServe Controller"] -->|"creates pods<br/>InferenceService CR"| AutoGluon
    CSR["ClusterServingRuntime"] -->|"defines runtime<br/>image + model format"| KServeCtrl
    KRBPProxy["kube-rbac-proxy"] -->|"auth sidecar<br/>8443 → 8080"| AutoGluon

    %% External Storage Services
    KServeStorage -->|"model artifacts"| S3["S3 Storage"]
    KServeStorage -->|"model artifacts"| GCS["Google Cloud Storage"]
    KServeStorage -->|"model artifacts"| AzureBlob["Azure Blob Storage"]
    KServeStorage -->|"model artifacts"| HFHub["HuggingFace Hub"]

