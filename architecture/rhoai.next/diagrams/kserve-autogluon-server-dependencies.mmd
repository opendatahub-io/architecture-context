    AutoGluon -->|"data manipulation"| Pandas["pandas 2.3.3"]
    AutoGluon -->|"numerical computing"| NumPy["numpy 2.1.0"]

    %% KServe Framework (vendored)
    AutoGluon -->|"model serving<br/>framework"| KServeSDK["kserve 0.19.0<br/>(vendored)"]
