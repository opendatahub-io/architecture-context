graph LR
    AutoGluon["KServe AutoGluon Server<br/>(autogluonserver)"]

    %% ML Framework Dependencies
    AutoGluon -->|"tabular prediction"| AGTabular["autogluon.tabular<br/>1.5.0+rhaiv.3"]
    AutoGluon -->|"time series forecast"| AGTimeSeries["autogluon.timeseries<br/>1.5.0+rhaiv.3"]
    AGTabular -->|"ML backend"| LightGBM["LightGBM"]
    AGTabular -->|"ML backend"| XGBoost["XGBoost"]
    AGTabular -->|"ML backend"| CatBoost["CatBoost"]
    AGTabular -->|"NN backend"| PyTorch["PyTorch"]
    AGTabular -->|"NN backend"| fastai["fastai"]
    AGTimeSeries -->|"NN backend"| PyTorch

    %% KServe Framework Dependencies
    AutoGluon -->|"server framework"| KServeSDK["kserve SDK<br/>0.19.0"]
    AutoGluon -->|"model download"| KServeStorage["kserve-storage<br/>0.19.0"]

    %% Web Framework Dependencies
    KServeSDK -->|"REST API"| FastAPI["FastAPI<br/>>=0.115.3"]
    KServeSDK -->|"ASGI server"| uvicorn["uvicorn<br/>>=0.30.6"]
    KServeSDK -->|"gRPC server"| grpcio["grpcio<br/>>=1.73.0"]
    KServeSDK -->|"serialization"| protobuf["protobuf<br/>>=6.33.5"]

    %% Data Dependencies
    AutoGluon -->|"DataFrame handling"| pandas["pandas<br/>>=2.2.0"]
    AutoGluon -->|"tensor protocol"| numpy["numpy<br/>>=1.26.0"]

    %% Storage Dependencies
    KServeStorage -->|"S3 access"| boto3["boto3<br/>>=1.29.0"]
    KServeStorage -->|"HF downloads"| hfhub["huggingface-hub<br/>>=0.32.0"]

    %% Internal Platform Dependencies
    AutoGluon -.->|"deploys via CRD"| KServeOp["KServe Operator"]
    AutoGluon -.->|"runtime spec"| CSR["ClusterServingRuntime"]
    AutoGluon -.->|"auth sidecar"| KRBP["kube-rbac-proxy"]

    %% External Service Dependencies
    KServeStorage -->|"model storage"| S3["S3 Storage<br/>443/TCP"]
    KServeStorage -->|"model storage"| GCS["Google Cloud Storage<br/>443/TCP"]
    KServeStorage -->|"model storage"| AzureBlob["Azure Blob Storage<br/>443/TCP"]
    KServeStorage -->|"model storage"| HFHubSvc["Hugging Face Hub<br/>443/TCP"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"metrics scrape"| AutoGluon

    style AutoGluon fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% ML frameworks
    style AGTabular fill:#9b59b6,stroke:#333,color:#fff
    style AGTimeSeries fill:#9b59b6,stroke:#333,color:#fff
    style LightGBM fill:#c39bd3,stroke:#333
    style XGBoost fill:#c39bd3,stroke:#333
    style CatBoost fill:#c39bd3,stroke:#333
    style PyTorch fill:#c39bd3,stroke:#333
    style fastai fill:#c39bd3,stroke:#333

    %% KServe libraries
    style KServeSDK fill:#2ecc71,stroke:#333,color:#fff
    style KServeStorage fill:#2ecc71,stroke:#333,color:#fff

    %% Web framework
    style FastAPI fill:#999,stroke:#333
    style uvicorn fill:#999,stroke:#333
    style grpcio fill:#999,stroke:#333
    style protobuf fill:#999,stroke:#333

    %% Data libs
    style pandas fill:#999,stroke:#333
    style numpy fill:#999,stroke:#333
    style boto3 fill:#999,stroke:#333
    style hfhub fill:#999,stroke:#333

    %% Internal platform
    style KServeOp fill:#7ed321,stroke:#333,color:#fff
    style CSR fill:#7ed321,stroke:#333,color:#fff
    style KRBP fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style AzureBlob fill:#f5a623,stroke:#333
