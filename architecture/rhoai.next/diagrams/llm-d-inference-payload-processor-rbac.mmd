graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Release["payload-processor-{release}<br/>(production)"]
        SA_Dev["payload-processor<br/>(dev only)"]
    end

    subgraph SingleNS["Single-Namespace Mode"]
        RB_Single["RoleBinding:<br/>payload-processor-{release}-<br/>configmap-reader<br/>Namespace: release-ns"]
        Role_Single["Role:<br/>payload-processor-{release}-<br/>configmap-reader<br/>Namespace: release-ns"]
    end

    subgraph MultiNS["Multi-Namespace Mode (multiNamespace=true)"]
        CRB_Multi["ClusterRoleBinding:<br/>payload-processor-<br/>configmap-reader<br/>Scope: Cluster-wide"]
        CR_Multi["ClusterRole:<br/>payload-processor-<br/>configmap-reader"]
    end

    subgraph DevMode["Dev Mode"]
        CRB_Dev["ClusterRoleBinding:<br/>payload-processor-<br/>auth-reviewer-binding<br/>Scope: Cluster-wide"]
        CR_Dev["ClusterRole:<br/>payload-processor-<br/>auth-reviewer"]
    end

    subgraph Resources["API Resources"]
        ConfigMaps["Core API Group (\"\")<br/>configmaps"]
    end

    subgraph Verbs["Permitted Verbs"]
        VerbSet["get, list, watch"]
    end

    %% Single-namespace flow
    SA_Release -->|"bound via"| RB_Single
    RB_Single -->|"grants"| Role_Single
    Role_Single -->|"get, list, watch"| ConfigMaps

    %% Multi-namespace flow
    SA_Release -->|"bound via"| CRB_Multi
    CRB_Multi -->|"grants"| CR_Multi
    CR_Multi -->|"get, list, watch<br/>(all namespaces)"| ConfigMaps

    %% Dev flow
    SA_Dev -->|"bound via"| CRB_Dev
    CRB_Dev -->|"grants"| CR_Dev
    CR_Dev -->|"get, list, watch<br/>(all namespaces)"| ConfigMaps

    %% Label selector note
    ConfigMaps -.->|"filtered by label:<br/>inference.llm-d.ai/<br/>ipp-managed: true"| LabelNote["Label Selector<br/>(application-level filter)"]

    %% Risk annotations
    MultiNS -.->|"⚠ Risk: cluster-wide<br/>ConfigMap read access<br/>(potential info disclosure)"| RiskNote["Security Note"]

    %% Styling
    style SA_Release fill:#4a90e2,color:#fff
    style SA_Dev fill:#4a90e2,color:#fff
    style Role_Single fill:#f5a623,color:#fff
    style CR_Multi fill:#f5a623,color:#fff
    style CR_Dev fill:#f5a623,color:#fff
    style RB_Single fill:#dae8fc,stroke:#6c8ebf
    style CRB_Multi fill:#dae8fc,stroke:#6c8ebf
    style CRB_Dev fill:#dae8fc,stroke:#6c8ebf
    style ConfigMaps fill:#7ed321,color:#fff
    style VerbSet fill:#d5e8d4,stroke:#82b366
    style LabelNote fill:#fff2cc,stroke:#d6b656
    style RiskNote fill:#f8cecc,stroke:#b85450
