graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Helm["payload-processor-{name}-{release}<br/>(Helm deployment)"]
        SA_Dev["payload-processor<br/>(dev deployment)"]
    end

    subgraph SingleNS["Single-Namespace Mode (multiNamespace=false)"]
        Role_NS["Role (namespace-scoped)<br/>Namespace: release-namespace"]
        RB_NS["RoleBinding<br/>payload-processor-{name}-{release}"]
    end

    subgraph MultiNS["Multi-Namespace Mode (multiNamespace=true)"]
        CR_Multi["ClusterRole<br/>payload-processor-configmap-reader"]
        CRB_Multi["ClusterRoleBinding<br/>payload-processor-configmap-reader"]
    end

    subgraph DevMode["Dev Mode"]
        CR_Dev["ClusterRole<br/>payload-processor-auth-reviewer"]
        CRB_Dev["ClusterRoleBinding<br/>payload-processor-auth-reviewer-binding"]
    end

    subgraph Resources["API Resources"]
        ConfigMaps["Core API (\"\")<br/>configmaps"]
    end

    subgraph Verbs["Permitted Verbs"]
        ReadOps["get, list, watch"]
    end

    %% Single-namespace flow
    SA_Helm -->|"bound via"| RB_NS
    RB_NS -->|"grants"| Role_NS
    Role_NS -->|"get, list, watch"| ConfigMaps

    %% Multi-namespace flow
    SA_Helm -->|"bound via"| CRB_Multi
    CRB_Multi -->|"grants"| CR_Multi
    CR_Multi -->|"get, list, watch"| ConfigMaps

    %% Dev flow
    SA_Dev -->|"bound via"| CRB_Dev
    CRB_Dev -->|"grants"| CR_Dev
    CR_Dev -->|"get, list, watch"| ConfigMaps

    %% Verbs annotation
    ConfigMaps --- ReadOps

    %% Notes
    Note1["Note: RBAC is read-only (ConfigMap access only).<br/>No write permissions to any resources.<br/>Namespace scoping controlled by multiNamespace Helm value."]

    %% Styling
    style SA_Helm fill:#4a90e2,stroke:#333,color:#fff
    style SA_Dev fill:#4a90e2,stroke:#333,color:#fff
    style Role_NS fill:#f5a623,stroke:#333
    style CR_Multi fill:#f5a623,stroke:#333
    style CR_Dev fill:#f5a623,stroke:#333
    style RB_NS fill:#e8e8e8,stroke:#333
    style CRB_Multi fill:#e8e8e8,stroke:#333
    style CRB_Dev fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style ReadOps fill:#d5e8d4,stroke:#82b366
    style Note1 fill:#fff2cc,stroke:#d6b656
