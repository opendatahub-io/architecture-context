graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Ctrl["data-science-pipelines-operator-<br/>controller-manager<br/>(operator namespace)"]
        SA_API["ds-pipeline-{name}<br/>(dspa namespace)"]
        SA_Runner["pipeline-runner-{name}<br/>(dspa namespace)"]
        SA_PA["ds-pipeline-persistenceagent-{name}<br/>(dspa namespace)"]
        SA_SWF["ds-pipeline-scheduledworkflow-{name}<br/>(dspa namespace)"]
        SA_WFC["ds-pipeline-workflow-controller-{name}<br/>(dspa namespace)"]
        SA_Envoy["ds-pipeline-metadata-envoy-{name}<br/>(dspa namespace)"]
        SA_Webhook["ds-pipelines-webhook<br/>(operator namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role<br/>(ClusterRole)"]
        CR_Argo["manager-argo-role<br/>(ClusterRole)"]
        CR_AuthDelegator["system:auth-delegator<br/>(ClusterRole)"]
        CR_WebhookRole["ds-pipelines-webhook<br/>(ClusterRole)"]
        CR_Edit["ds-pipeline-user-access-{name}<br/>(aggregate: edit)"]
        CR_View["ds-pipeline-user-access-{name}<br/>(aggregate: view)"]
    end

    subgraph NamespaceRoles["Namespace Roles (per-DSPA)"]
        R_API["ds-pipeline-{name}<br/>(Role)"]
        R_Runner["pipeline-runner-{name}<br/>(Role)"]
        R_PA["ds-pipeline-persistenceagent-{name}<br/>(Role)"]
        R_SWF["ds-pipeline-scheduledworkflow-{name}<br/>(Role)"]
        R_WFC["ds-pipeline-workflow-controller-role-{name}<br/>(Role)"]
    end

    subgraph ManagerResources["manager-role API Resources"]
        Res_DSPA["opendatahub.io<br/>DSPA, status, finalizers, api"]
        Res_Core["core<br/>configmaps, secrets, SAs,<br/>services, pods, events, PVCs"]
        Res_Apps["apps<br/>deployments, replicasets"]
        Res_Argo["argoproj.io<br/>workflows, workflowtaskresults,<br/>workflowartifactgctasks"]
        Res_Admission["admissionregistration<br/>mutating/validating webhooks"]
        Res_Pipelines["pipelines.kubeflow.org<br/>pipelines, pipelineversions"]
        Res_Route["route.openshift.io<br/>routes"]
        Res_Network["networking.k8s.io<br/>networkpolicies, ingresses"]
        Res_RBAC_Res["rbac.authorization.k8s.io<br/>cluster/roles, bindings"]
        Res_Monitoring["monitoring.coreos.com<br/>servicemonitors"]
        Res_Auth["authentication/authorization<br/>tokenreviews,<br/>subjectaccessreviews"]
        Res_ML["KServe, Ray, Seldon,<br/>CodeFlare, MLflow<br/>(cross-component RBAC)"]
    end

    subgraph ArgoResources["manager-argo-role API Resources"]
        Res_ArgoFull["argoproj.io<br/>workflows, workflowtasksets,<br/>cronworkflows, workflowtemplates"]
        Res_AreCore["core<br/>pods, pods/exec, configmaps,<br/>PVCs, secrets, events, SAs"]
        Res_Coord["coordination.k8s.io<br/>leases"]
        Res_Policy["policy<br/>poddisruptionbudgets"]
    end

    %% Bindings
    SA_Ctrl -->|"ClusterRoleBinding"| CR_Manager
    SA_Ctrl -->|"ClusterRoleBinding"| CR_Argo

    SA_API -->|"RoleBinding"| R_API
    SA_API -->|"ClusterRoleBinding<br/>(auth-delegator)"| CR_AuthDelegator
    SA_Envoy -->|"ClusterRoleBinding<br/>(auth-delegator)"| CR_AuthDelegator

    SA_Runner -->|"RoleBinding"| R_Runner
    SA_PA -->|"RoleBinding"| R_PA
    SA_SWF -->|"RoleBinding"| R_SWF
    SA_WFC -->|"RoleBinding"| R_WFC
    SA_Webhook -->|"ClusterRoleBinding"| CR_WebhookRole

    %% ClusterRole → Resources
    CR_Manager -->|"full CRUD"| Res_DSPA
    CR_Manager -->|"full CRUD"| Res_Core
    CR_Manager -->|"full CRUD"| Res_Apps
    CR_Manager -->|"*, create, patch"| Res_Argo
    CR_Manager -->|"full CRUD"| Res_Admission
    CR_Manager -->|"full CRUD"| Res_Pipelines
    CR_Manager -->|"full CRUD"| Res_Route
    CR_Manager -->|"full CRUD"| Res_Network
    CR_Manager -->|"full CRUD"| Res_RBAC_Res
    CR_Manager -->|"full CRUD"| Res_Monitoring
    CR_Manager -->|"create"| Res_Auth
    CR_Manager -->|"create, get, list,<br/>patch, delete"| Res_ML

    CR_Argo -->|"*"| Res_ArgoFull
    CR_Argo -->|"*"| Res_AreCore
    CR_Argo -->|"create, get, update"| Res_Coord
    CR_Argo -->|"create, get, delete"| Res_Policy

    %% User-facing aggregate roles
    CR_Edit -->|"full CRUD on DSPA"| Res_DSPA
    CR_View -->|"get, list, watch DSPA"| Res_DSPA

    %% Styling
    style SA_Ctrl fill:#4a90e2,stroke:#333,color:#fff
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style SA_Runner fill:#e74c3c,stroke:#333,color:#fff
    style SA_PA fill:#4a90e2,stroke:#333,color:#fff
    style SA_SWF fill:#4a90e2,stroke:#333,color:#fff
    style SA_WFC fill:#4a90e2,stroke:#333,color:#fff
    style SA_Envoy fill:#4a90e2,stroke:#333,color:#fff
    style SA_Webhook fill:#4a90e2,stroke:#333,color:#fff

    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Argo fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_WebhookRole fill:#f5a623,stroke:#333
    style CR_Edit fill:#27ae60,stroke:#333,color:#fff
    style CR_View fill:#27ae60,stroke:#333,color:#fff

    style R_API fill:#f5d623,stroke:#333
    style R_Runner fill:#f5d623,stroke:#333
    style R_PA fill:#f5d623,stroke:#333
    style R_SWF fill:#f5d623,stroke:#333
    style R_WFC fill:#f5d623,stroke:#333

    style Res_DSPA fill:#7ed321,stroke:#333
    style Res_Core fill:#7ed321,stroke:#333
    style Res_Apps fill:#7ed321,stroke:#333
    style Res_Argo fill:#7ed321,stroke:#333
    style Res_Admission fill:#7ed321,stroke:#333
    style Res_Pipelines fill:#7ed321,stroke:#333
    style Res_Route fill:#7ed321,stroke:#333
    style Res_Network fill:#7ed321,stroke:#333
    style Res_RBAC_Res fill:#7ed321,stroke:#333
    style Res_Monitoring fill:#7ed321,stroke:#333
    style Res_Auth fill:#7ed321,stroke:#333
    style Res_ML fill:#7ed321,stroke:#333

    style Res_ArgoFull fill:#7ed321,stroke:#333
    style Res_AreCore fill:#7ed321,stroke:#333
    style Res_Coord fill:#7ed321,stroke:#333
    style Res_Policy fill:#7ed321,stroke:#333
