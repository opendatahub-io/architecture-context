graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["data-science-pipelines-operator-<br/>controller-manager"]
        SA_Prom["prometheus-k8s"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_Argo["manager-argo-rolebinding"]
        CRB_TLS["tls-profile-reader-binding"]
        CRB_Metrics["metrics-reader-binding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role<br/>(broad operator scope)"]
        CR_Argo["manager-argo-role<br/>(Argo controller)"]
        CR_TLS["dspo-openshift-tls-<br/>profile-reader"]
        CR_Metrics["metrics-reader"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        Agg_ArgoAdmin["argo-aggregate-to-admin"]
        Agg_ArgoEdit["argo-aggregate-to-edit"]
        Agg_ArgoView["argo-aggregate-to-view"]
        Agg_DSPAAdmin["aggregate-dspa-admin-edit"]
        Agg_DSPAView["aggregate-dspa-admin-view"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        Core["core<br/>pods, secrets, configmaps,<br/>services, PVCs, SAs"]
        Apps["apps<br/>deployments"]
        Networking["networking.k8s.io<br/>networkpolicies, ingresses"]
        RBACRes["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings"]
        OpenShift["route.openshift.io<br/>routes<br/>image.openshift.io<br/>imagestreamtags"]
        ArgoCRDs["argoproj.io<br/>workflows, workflowtemplates,<br/>cronworkflows, etc."]
        Monitoring["monitoring.rhobs<br/>servicemonitors,<br/>prometheusrules"]
        CrossPlatform["Cross-Platform<br/>serving.kserve.io,<br/>ray.io,<br/>workload.codeflare.dev"]
        DSPACRDs["datasciencepipelinesapplications<br/>.opendatahub.io<br/>DSPAs"]
        PipelineCRDs["pipelines.kubeflow.org<br/>pipelines, pipelineversions"]
    end

    subgraph ArgoResources["Argo Role Resources"]
        ArgoWorkflows["argoproj.io<br/>workflows, workflowtemplates"]
        ArgoPods["core<br/>pods, PVCs"]
    end

    subgraph TLSResources["TLS Reader Resources"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    subgraph MetricsResources["Metrics Resources"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% Service Account → Binding → Role
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Argo
    SA_CM -->|bound via| CRB_TLS
    SA_Prom -->|bound via| CRB_Metrics

    CRB_Manager -->|grants| CR_Manager
    CRB_Argo -->|grants| CR_Argo
    CRB_TLS -->|grants| CR_TLS
    CRB_Metrics -->|grants| CR_Metrics

    %% Role → Resources
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Core
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Apps
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Networking
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| RBACRes
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| OpenShift
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| ArgoCRDs
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| Monitoring
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| CrossPlatform
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| DSPACRDs
    CR_Manager -->|"get,list,watch,create,<br/>update,patch,delete"| PipelineCRDs

    CR_Argo -->|"Argo controller ops"| ArgoWorkflows
    CR_Argo -->|"Argo controller ops"| ArgoPods

    CR_TLS -->|"get,list,watch"| APIServers

    CR_Metrics -->|"get"| MetricsURL

    %% Aggregate roles
    Agg_ArgoAdmin -->|"aggregates to admin<br/>Full CRUD"| ArgoCRDs
    Agg_ArgoEdit -->|"aggregates to edit<br/>Full CRUD"| ArgoCRDs
    Agg_ArgoView -->|"aggregates to view<br/>get,list,watch"| ArgoCRDs
    Agg_DSPAAdmin -->|"aggregates to admin/edit<br/>Full CRUD"| DSPACRDs
    Agg_DSPAAdmin -->|"aggregates to admin/edit<br/>Full CRUD"| PipelineCRDs
    Agg_DSPAView -->|"aggregates to view<br/>get,list,watch"| DSPACRDs
    Agg_DSPAView -->|"aggregates to view<br/>get,list,watch"| PipelineCRDs

