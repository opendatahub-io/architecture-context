graph TB
    subgraph DSPO["Data Science Pipelines Operator"]
        Controller["DSPO Controller Manager<br/>(controller-runtime)<br/>Reconciles DSPA CRs"]
        Webhook["PipelineVersion Webhook<br/>:8443/TCP TLS<br/>Mutating + Validating"]
    end

    subgraph DeployedStack["Per-Namespace Pipeline Stack (deployed by DSPO)"]
        subgraph APILayer["API Layer"]
            APIServer["DS Pipelines API Server<br/>:8888 REST, :8887 gRPC<br/>KFP v2 compatible"]
            KubeRBACProxy1["kube-rbac-proxy<br/>:8443/TCP HTTPS<br/>SubjectAccessReview"]
        end

        subgraph Execution["Execution Engine"]
            ArgoController["Argo Workflow Controller<br/>:6060 health<br/>Pipeline DAG execution"]
            ScheduledWF["Scheduled Workflow<br/>Controller<br/>Cron-based triggers"]
        end

        subgraph Metadata["Metadata & Lineage"]
            MLMDgRPC["ML Metadata gRPC Server<br/>:8080/TCP gRPC<br/>Artifact lineage"]
            MLMDEnvoy["ML Metadata Envoy Proxy<br/>gRPC-web proxy"]
            KubeRBACProxy2["kube-rbac-proxy<br/>:8443/TCP HTTPS<br/>MLMD auth"]
        end

        subgraph Agents["Background Agents"]
            PersistenceAgent["Persistence Agent<br/>Syncs workflow state"]
        end

        subgraph Storage["Data Storage"]
            MariaDB["MariaDB<br/>:3306/TCP<br/>Metadata DB"]
            MinIO["MinIO<br/>:9000/TCP<br/>Artifact Storage<br/>(dev/test only)"]
        end
    end

    %% CRDs
    DSPACR["DataSciencePipelinesApplication CR"]
    PipelineCR["Pipeline / PipelineVersion CRs<br/>(pipelines.kubeflow.org)"]
    WorkflowCR["Workflow CR<br/>(argoproj.io)"]
    ScheduledWFCR["ScheduledWorkflow CR<br/>(kubeflow.org)"]

    %% External dependencies
    PlatformOp["rhods-operator /<br/>opendatahub-operator"]
    ServiceCA["OpenShift service-CA"]
    OSAPI["OpenShift APIServer<br/>TLS Security Profile"]
    MLflowOp["MLflow Operator<br/>(optional)"]

    %% User interaction
    User["User / Dashboard"]

    %% Flows
    PlatformOp -->|creates| DSPACR
    DSPACR -->|watched by| Controller
    Controller -->|deploys all| DeployedStack

    User -->|REST/gRPC via| KubeRBACProxy1
    KubeRBACProxy1 -->|proxies to| APIServer
    APIServer -->|creates| WorkflowCR
    WorkflowCR -->|watched by| ArgoController
    ArgoController -->|manages| PipelinePods["Pipeline Step Pods"]
    PipelinePods -->|artifacts| MinIO
    PipelinePods -->|lineage| MLMDgRPC

    APIServer -->|metadata| MariaDB
    MLMDgRPC -->|metadata| MariaDB

    PersistenceAgent -->|syncs state| APIServer
    PersistenceAgent -->|reads lineage| MLMDgRPC

    ScheduledWFCR -->|watched by| ScheduledWF
    ScheduledWF -->|triggers| APIServer

    User -->|metadata via| KubeRBACProxy2
    KubeRBACProxy2 -->|proxies to| MLMDEnvoy
    MLMDEnvoy -->|proxies to| MLMDgRPC

    PipelineCR -->|validated by| Webhook

    ServiceCA -->|provisions TLS certs| DeployedStack
    OSAPI -->|TLS profile| Controller
    MLflowOp -.->|optional integration| APIServer

