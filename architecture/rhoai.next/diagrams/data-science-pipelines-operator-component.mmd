graph TB
    subgraph Operator["Data Science Pipelines Operator"]
        direction TB
        DSPAReconciler["DSPAReconciler<br/>(Controller)"]
        AIPipelinesReconciler["AIPipelinesReconciler<br/>(Controller)"]
        AIPipelinesArgoReconciler["AIPipelinesArgoReconciler<br/>(Controller)"]
        SecurityProfileWatcher["SecurityProfileWatcher<br/>(Controller)"]
        WebhookServer["Webhook Server<br/>:9443/TCP"]
        MetricsServer["Metrics Server<br/>:8443/TCP HTTPS"]
        HealthProbes["Health Probes<br/>:8081/TCP"]
    end

    subgraph DSPAStack["DSPA-Managed Stack (per namespace)"]
        direction TB
        APIServer["API Server<br/>:8888/TCP REST<br/>:8887/TCP gRPC"]
        PersistenceAgent["Persistence Agent"]
        ScheduledWorkflow["Scheduled Workflow<br/>Controller"]
        WorkflowController["Argo Workflow<br/>Controller"]
        MLMD["MLMD gRPC Server<br/>+ Envoy Proxy"]
        MariaDB["MariaDB<br/>(optional)"]
        MinIO["MinIO<br/>(optional)"]
    end

    %% CRDs
    DSPACR["DataSciencePipelinesApplication CR<br/>(Namespaced)"]
    AIPipelinesCR["AIPipelines CR<br/>(Cluster-scoped)"]
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org"]

    %% Operator watches CRDs
    DSPACR -->|watched by| DSPAReconciler
    AIPipelinesCR -->|watched by| AIPipelinesReconciler
    AIPipelinesReconciler -->|delegates Argo| AIPipelinesArgoReconciler
    PipelineVersionCR -->|validated by| WebhookServer

    %% DSPAReconciler deploys stack
    DSPAReconciler -->|deploys| APIServer
    DSPAReconciler -->|deploys| PersistenceAgent
    DSPAReconciler -->|deploys| ScheduledWorkflow
    DSPAReconciler -->|deploys| WorkflowController
    DSPAReconciler -->|deploys| MLMD
    DSPAReconciler -->|deploys optional| MariaDB
    DSPAReconciler -->|deploys optional| MinIO

    %% Stack internal relationships
    PersistenceAgent -->|monitors| WorkflowController
    PersistenceAgent -->|persists to| MariaDB
    APIServer -->|stores artifacts| MinIO
    APIServer -->|stores metadata| MariaDB
    MLMD -->|stores lineage| MariaDB
    ScheduledWorkflow -->|triggers| WorkflowController

    %% SecurityProfileWatcher
    OpenShiftAPIServer["OpenShift APIServer CR"] -->|watched by| SecurityProfileWatcher
    SecurityProfileWatcher -->|restarts on change| Operator

    %% External integrations
    DSPAReconciler -->|integrates| KServe["KServe<br/>(InferenceService)"]
    DSPAReconciler -->|integrates| Ray["Ray<br/>(RayCluster/RayJob)"]
    DSPAReconciler -->|integrates| CodeFlare["CodeFlare<br/>(AppWrapper)"]
    DSPAReconciler -->|autodetects| MLflow["MLflow"]
    DSPAReconciler -->|creates| Routes["OpenShift Routes"]
    AIPipelinesReconciler -->|manages| PrometheusMonitoring["ServiceMonitor /<br/>PrometheusRule"]

    %% Styling
    style Operator fill:#4a90e2,color:#fff
    style DSPAStack fill:#d5e8d4,stroke:#82b366
    style DSPAReconciler fill:#4a90e2,color:#fff
    style AIPipelinesReconciler fill:#4a90e2,color:#fff
    style AIPipelinesArgoReconciler fill:#4a90e2,color:#fff
    style SecurityProfileWatcher fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style HealthProbes fill:#4a90e2,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style PersistenceAgent fill:#7ed321,color:#fff
    style ScheduledWorkflow fill:#7ed321,color:#fff
    style WorkflowController fill:#7ed321,color:#fff
    style MLMD fill:#7ed321,color:#fff
    style MariaDB fill:#f5a623,color:#fff
    style MinIO fill:#f5a623,color:#fff
    style DSPACR fill:#f5a623
    style AIPipelinesCR fill:#f5a623
    style PipelineCR fill:#f5a623
    style PipelineVersionCR fill:#f5a623
    style KServe fill:#e8e8e8
    style Ray fill:#e8e8e8
    style CodeFlare fill:#e8e8e8
    style MLflow fill:#e8e8e8
    style Routes fill:#e8e8e8
    style PrometheusMonitoring fill:#e8e8e8
    style OpenShiftAPIServer fill:#e8e8e8
