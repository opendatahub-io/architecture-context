graph TB
    subgraph DSPO["Data Science Pipelines Operator"]
        direction TB
        Controller["DSPO Controller Manager<br/>(controller-runtime)"]
        Webhook["PipelineVersion Webhook<br/>(mutating + validating)"]
    end

    subgraph ManagedComponents["Managed DSP Components (per DSPA instance)"]
        direction TB

        subgraph APIServerPod["API Server Pod"]
            RBACProxy["kube-rbac-proxy<br/>:8443 HTTPS"]
            InitPipelines["init-managed-pipelines<br/>(init container)"]
            APIServer["KFP API Server<br/>:8888 HTTP/HTTPS<br/>:8887 gRPC"]
        end

        PersistenceAgent["Persistence Agent"]
        ScheduledWorkflow["Scheduled Workflow"]
        ArgoController["Argo Workflow Controller"]

        subgraph MLMDStack["MLMD Stack"]
            EnvoyProxy["MLMD Envoy Proxy<br/>:9090 gRPC"]
            MLMDServer["MLMD gRPC Server<br/>:8080 gRPC"]
        end
    end

    subgraph OptionalInfra["Optional Infrastructure (per DSPA)"]
        MariaDB["MariaDB<br/>:3306 MySQL"]
        MinIO["MinIO<br/>:9000 HTTP"]
    end

    %% CRDs
    User[User / Platform Operator] -->|creates| DSPACR["DataSciencePipelinesApplication CR"]
    DSPACR -->|watched by| Controller
    Controller -->|deploys & configures| APIServerPod
    Controller -->|deploys| PersistenceAgent
    Controller -->|deploys| ScheduledWorkflow
    Controller -->|deploys| ArgoController
    Controller -->|deploys| MLMDStack
    Controller -->|deploys conditionally| MariaDB
    Controller -->|deploys conditionally| MinIO

    %% Internal data flows
    RBACProxy -->|proxies to| APIServer
    InitPipelines -->|extracts pipelines to| APIServer
    PersistenceAgent -->|syncs run state| APIServer
    ScheduledWorkflow -->|triggers scheduled runs| APIServer
    APIServer -->|creates Workflow CRs| ArgoController
    ArgoController -->|creates| TaskPods["Pipeline Task Pods"]
    TaskPods -->|stores metadata| EnvoyProxy
    EnvoyProxy -->|routes gRPC| MLMDServer

    %% Backend connections
    APIServer -->|reads/writes| MariaDB
    APIServer -->|stores artifacts| MinIO
    MLMDServer -->|stores metadata| MariaDB

    %% Webhook
    K8sAPI["Kubernetes API Server"] -->|admission review| Webhook
    Webhook -->|validates/mutates| PipelineVersionCR["PipelineVersion CR"]

    %% External integrations
    Controller -->|fetches manifests| OCIRegistry["OCI Container Registry"]
    Controller -->|reads TLS profile| OSConfig["OpenShift APIServer Config"]
    Controller -->|watches| TrustedCA["odh-trusted-ca-bundle ConfigMap"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style APIServer fill:#50c878,stroke:#333,color:#fff
    style RBACProxy fill:#e8725c,stroke:#333,color:#fff
    style PersistenceAgent fill:#50c878,stroke:#333,color:#fff
    style ScheduledWorkflow fill:#50c878,stroke:#333,color:#fff
    style ArgoController fill:#50c878,stroke:#333,color:#fff
    style EnvoyProxy fill:#50c878,stroke:#333,color:#fff
    style MLMDServer fill:#50c878,stroke:#333,color:#fff
    style MariaDB fill:#f5a623,stroke:#333,color:#fff
    style MinIO fill:#f5a623,stroke:#333,color:#fff
    style DSPACR fill:#9b59b6,stroke:#333,color:#fff
    style PipelineVersionCR fill:#9b59b6,stroke:#333,color:#fff
    style OCIRegistry fill:#999,stroke:#333,color:#fff
    style OSConfig fill:#999,stroke:#333,color:#fff
    style TrustedCA fill:#999,stroke:#333,color:#fff
    style TaskPods fill:#7ed321,stroke:#333,color:#fff
    style InitPipelines fill:#50c878,stroke:#333,color:#fff
