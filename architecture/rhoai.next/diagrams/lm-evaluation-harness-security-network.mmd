graph TB
    subgraph Orchestration["ORCHESTRATION (Kubernetes Control Plane)"]
        Operator["TrustyAI Operator<br/>LMEvalJob Controller<br/>RBAC: managed externally"]
    end

    subgraph JobPod["JOB POD (Ephemeral, Single-Tenant)"]
        direction TB

        subgraph Container["lmes-job Container"]
            Adapter["LMEvalAdapter<br/>device=cpu<br/>No model weights"]
            SecGuards["Security Guards:<br/>Path traversal (/meta)<br/>Error sanitization<br/>Code exec allow-list"]
        end

        subgraph Mounts["Volume Mounts"]
            JobSpec["/meta/job.json<br/>(ConfigMap)"]
            TestData["/test_data<br/>(optional, air-gap)"]
            HFCache["/opt/app-root/src/hf_home<br/>(ephemeral)"]
        end
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        EvalHub["EvalHub Service<br/>443/TCP HTTPS<br/>TLS<br/>Bearer Token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelEP["Model Inference Endpoint<br/>Configurable Port/TCP<br/>HTTPS<br/>TLS (custom CA supported)<br/>Bearer Token (OPENAI_API_KEY)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>HF_TOKEN (optional)"]
        HFDatasets["datasets-server.huggingface.co<br/>443/TCP HTTPS<br/>TLS<br/>No Auth"]
        S3["S3-Compatible Storage<br/>Configurable Port/TCP<br/>HTTPS<br/>TLS (custom CA supported)<br/>AWS v4 Signing"]
        OCIReg["OCI Registry<br/>443/TCP HTTPS<br/>TLS<br/>Registry Credentials"]
        MLflow["MLflow Tracking Server<br/>Configurable Port/TCP<br/>HTTPS<br/>TLS<br/>Configurable Auth"]
    end

    %% Flows
    Operator -->|"Job creation<br/>Kubernetes RBAC"| JobPod
    Adapter -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| EvalHub
    Adapter -->|"HTTPS/Configurable<br/>TLS (custom CA)<br/>OPENAI_API_KEY"| ModelEP
    Adapter -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub
    Adapter -->|"HTTPS/443<br/>TLS<br/>No Auth"| HFDatasets
    Adapter -->|"HTTPS/Configurable<br/>TLS (custom CA)<br/>AWS v4 Signing"| S3
    Adapter -->|"HTTPS/443<br/>TLS<br/>Registry Creds<br/>(via skopeo)"| OCIReg
    Adapter -->|"HTTPS/Configurable<br/>TLS<br/>Configurable Auth"| MLflow

    %% Styling
    classDef orchestration fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef jobpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Operator orchestration
    class Adapter,Container jobpod
    class SecGuards security
    class EvalHub internal
    class ModelEP,HFHub,HFDatasets,S3,OCIReg,MLflow external
