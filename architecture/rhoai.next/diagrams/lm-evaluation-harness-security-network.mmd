graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        Operator["TrustyAI LMEval Operator<br/>Creates Job + ConfigMap + Secrets"]
    end

    subgraph JobPod["JOB POD (Batch Execution - Egress Only)"]
        direction TB

        subgraph PodInternal["LMEval Job Pod<br/>Image: odh-ta-lmes-job<br/>Base: ubi9/python-311<br/>No inbound ports"]
            Adapter["LMEval Adapter<br/>(main.py)<br/>Job spec + lifecycle"]
            LMEval["lm-eval Library<br/>Benchmark engine"]
            OCIPub["OCI Publisher<br/>skopeo + olot"]
            S3Down["S3 Downloader<br/>boto3"]
        end

        subgraph Mounts["Volume Mounts"]
            JobSpec["/meta/job.json<br/>(ConfigMap)"]
            SecretMount["Secrets<br/>API Key, HF Token,<br/>OCI Auth, S3 Creds"]
            TestData["/test_data<br/>(optional, air-gapped)"]
        end
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        ModelEndpoint["Model Serving Endpoint<br/>(vLLM / TGI)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        EvalHub["EvalHub Service<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        MLflow["MLflow Tracking<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OCIRegistry["OCI Registry (Quay)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Docker Auth"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
    end

    %% Control plane flow
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| JobPod

    %% Egress flows
    LMEval -->|"POST /v1/completions<br/>HTTPS/443<br/>TLS 1.2+<br/>OPENAI_API_KEY"| ModelEndpoint
    Adapter -->|"POST callbacks<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| EvalHub
    Adapter -->|"POST metrics<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| MLflow
    OCIPub -->|"skopeo push<br/>HTTPS/443<br/>TLS 1.2+<br/>Docker Auth"| OCIRegistry
    LMEval -->|"GET datasets<br/>HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    S3Down -->|"GET assets<br/>HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef jobpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef component fill:#4a90e2,stroke:#333,color:#fff
    classDef mount fill:#f5a623,stroke:#333

    class Operator controlplane
    class Adapter,LMEval,OCIPub,S3Down component
    class JobSpec,SecretMount,TestData mount
    class ModelEndpoint,EvalHub,MLflow internal
    class OCIRegistry,HFHub,S3 external
