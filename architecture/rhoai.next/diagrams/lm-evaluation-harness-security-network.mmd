graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        EvalHub["EvalHub Service<br/>Creates Job + ConfigMap"]
    end

    subgraph BatchJob["BATCH JOB (Ephemeral)"]
        direction TB

        subgraph Container["LMEval Container<br/>Image: odh-ta-lmes-job-rhel9<br/>Base: UBI9 Python 3.11<br/>CPU only"]
            Adapter["LMEval Adapter<br/>FrameworkAdapter"]
            Library["lm-evaluation-harness<br/>simple_evaluate()"]
            OCIPub["OCI Artifact Publisher<br/>skopeo"]
            S3Down["S3 Downloader<br/>boto3 (air-gapped)"]
        end

        subgraph Secrets["Secrets"]
            ModelSecret["model-auth-secret<br/>(Opaque)<br/>OPENAI_API_KEY + HF_TOKEN"]
            OCISecret["oci-auth-config<br/>(dockerconfigjson)<br/>Registry auth"]
        end
    end

    subgraph EgressTargets["EGRESS DESTINATIONS"]
        ModelEP["Model Inference Endpoint<br/>configurable port/TCP<br/>HTTPS TLS 1.2+<br/>Bearer Token"]
        EvalHubCB["EvalHub Callback URL<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>Bearer Token"]
        HFHub["HuggingFace Hub<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>Bearer Token (optional)"]
        OCIReg["OCI Registry<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>Docker auth"]
        S3Store["S3-Compatible Storage<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>AWS IAM"]
        MLflow["MLflow Server<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>Bearer Token"]
    end

    %% Control Plane → Job
    EvalHub -->|"ConfigMap mount<br/>/meta/job.json<br/>K8s RBAC"| Container

    %% Secret references
    ModelSecret -.->|"env: OPENAI_API_KEY"| Adapter
    OCISecret -.->|"/tmp/.docker/config.json"| OCIPub

    %% Egress flows
    Library -->|"POST /v1/completions<br/>HTTPS TLS 1.2+<br/>Bearer Token<br/>≤128 concurrent"| ModelEP
    Adapter -->|"POST status+results<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| EvalHubCB
    Library -->|"GET tokenizers+datasets<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HFHub
    OCIPub -->|"Push artifacts<br/>HTTPS/443<br/>TLS 1.2+<br/>Docker auth"| OCIReg
    S3Down -->|"GET objects<br/>HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3Store
    Adapter -->|"POST metrics+runs<br/>HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| MLflow

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef batchjob fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef component fill:#4a90e2,stroke:#333,color:#fff
    classDef secret fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class EvalHub controlplane
    class Adapter,Library,OCIPub,S3Down component
    class ModelSecret,OCISecret secret
    class ModelEP,EvalHubCB,HFHub,OCIReg,S3Store,MLflow egress
