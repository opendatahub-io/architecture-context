graph LR
    TrainingHub["Training Hub<br/>(Python Library)"]

    %% Core Required Dependencies
    TrainingHub -->|"SFT backend"| InstructLab["instructlab-training<br/>>=0.14.0"]
    TrainingHub -->|"OSFT backend"| MiniTrainer["rhai-innovation-mini-trainer<br/>>=0.6.0"]
    TrainingHub -->|"distributed training"| PyTorch["torch<br/>>=2.6.0"]
    TrainingHub -->|"model loading, tokenizers"| Transformers["transformers<br/>>=4.57.6"]
    TrainingHub -->|"LoRA adapters"| PEFT["peft<br/>>=0.15"]
    TrainingHub -->|"dataset processing"| Datasets["datasets<br/>>=3.1.0"]
    TrainingHub -->|"distributed acceleration"| Accelerate["accelerate<br/>>=1.2.0"]
    TrainingHub -->|"SFTTrainer, GRPOTrainer"| TRL["trl<br/>>=0.18.1"]
    TrainingHub -->|"weight serialization"| Safetensors["safetensors<br/>>=0.4.3"]
    TrainingHub -->|"model downloads"| HFHub["huggingface-hub<br/>>=0.29.0"]
    TrainingHub -->|"loss curve plotting"| Matplotlib["matplotlib<br/>>=3.0"]

    %% Optional Dependencies (extras)
    TrainingHub -.->|"QLoRA quantization<br/>[cuda extra]"| BitsAndBytes["bitsandbytes<br/>>=0.45.5"]
    TrainingHub -.->|"optimized LoRA<br/>[lora extra]"| Unsloth["unsloth<br/>>=2025.6.3"]
    TrainingHub -.->|"single-GPU GRPO<br/>[grpo extra]"| OpenPipeART["openpipe-art<br/>>=0.5.18,<0.7"]
    TrainingHub -.->|"inference engine<br/>[grpo extra]"| vLLM["vllm<br/>>=0.9.1"]
    TrainingHub -.->|"multi-GPU GRPO<br/>[grpo-verl extra]"| verl["verl<br/>>=0.3.1.post1,<0.4"]
    TrainingHub -.->|"distributed compute<br/>[grpo-verl extra]"| Ray["ray<br/>>=2.46"]
    TrainingHub -.->|"prompt optimization<br/>[gepa extra]"| GEPA["gepa<br/>>=0.1.4"]
    TrainingHub -.->|"LLM API abstraction<br/>[gepa extra]"| LiteLLM["litellm<br/>>=1.72<br/>!=1.82.7,!=1.82.8<br/>(supply chain exclusion)"]
    TrainingHub -.->|"prompt registry<br/>[gepa extra]"| MLflow["mlflow<br/>>=2.22"]
    TrainingHub -.->|"math verification<br/>(optional)"| MathVerify["math-verify"]

    %% External Service Integrations
    TrainingHub ==>|"HTTPS/443<br/>model downloads"| HFHubService["HuggingFace Hub<br/>(huggingface.co)"]
    TrainingHub ==>|"HTTPS/443<br/>metrics logging"| WandBService["Weights & Biases<br/>(api.wandb.ai)"]
