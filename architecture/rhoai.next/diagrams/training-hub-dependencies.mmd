    Pipelines["RHOAI Training<br/>Pipelines"] -->|"pip install"| TrainingHub
    ClaudeCode["Claude Code<br/>(plugin)"] -->|"plugin invocation"| TrainingHub
    CodexCLI["Codex CLI<br/>(plugin)"] -->|"plugin invocation"| TrainingHub

