graph LR
    TH["Training Hub<br/>(Python Library + CLI)"]

    %% Core Dependencies (Required)
    subgraph CoreDeps["Core Dependencies (Required)"]
        Python["Python >=3.11"]
        Torch["torch >=2.6.0"]
        Transformers["transformers >=4.57.6"]
        Datasets["datasets >=4.0.0"]
        PEFT["peft >=0.15"]
        Accelerate["accelerate >=0.34.2"]
        Pydantic["pydantic >=2.7.0"]
        NumPy["numpy >=1.26.4"]
        Pandas["pandas >=2.2"]
        Rich["rich >=14.1.0"]
        Numba["numba >=0.61.2"]
        Matplotlib["matplotlib >=3.9"]
    end

    TH -->|"runtime"| Python
    TH -->|"ML framework"| Torch
    TH -->|"models/tokenizers"| Transformers
    TH -->|"data loading"| Datasets
    TH -->|"LoRA adapters"| PEFT
    TH -->|"distributed"| Accelerate
    TH -->|"validation"| Pydantic
    TH -->|"numerics"| NumPy
    TH -->|"data prep"| Pandas
    TH -->|"CLI output"| Rich
    TH -->|"JIT"| Numba
    TH -->|"visualization"| Matplotlib

    %% Backend-specific Dependencies (Optional Extras)
    subgraph BackendDeps["Backend Dependencies (Optional Extras)"]
        ILabTraining["instructlab-training >=0.16.2"]
        MiniTrainer["rhai-innovation-mini-trainer >=0.8.3"]
        Unsloth["unsloth >=2026.1.1<br/>(lora extra)"]
        TRL["trl >=0.18.0<br/>(lora extra)"]
        XFormers["xformers >=0.0.33<br/>(lora extra)"]
        ART["openpipe-art >=0.5.17<br/>(grpo extra)"]
        LiteLLM["litellm >=1.71.1<br/>!=1.82.7,!=1.82.8<br/>(grpo/gepa extras)"]
        VeRL["verl >=0.7<br/>(grpo-verl extra)"]
        GEPALib["gepa >=0.1.1<br/>(gepa extra)"]
        MLflowLib["mlflow >=3.5.0<br/>(gepa extra)"]
        SentTransLib["sentence-transformers >=5.0<br/>(embedding extra)"]
    end

    TH -->|"SFT backend"| ILabTraining
    TH -->|"OSFT backend"| MiniTrainer
    TH -->|"LoRA training"| Unsloth
    TH -->|"GRPO trainer"| TRL
    TH -->|"attention"| XFormers
    TH -->|"single-GPU GRPO"| ART
    TH -->|"LLM routing"| LiteLLM
    TH -->|"distributed GRPO"| VeRL
    TH -->|"prompt optimization"| GEPALib
    TH -->|"experiment tracking"| MLflowLib
    TH -->|"embedding training"| SentTransLib

    %% CUDA Extras
    subgraph CUDADeps["CUDA Extras (Optional)"]
        FlashAttn["flash-attn >=2.8"]
        BitsAndBytes["bitsandbytes >=0.47.0"]
        LigerKernel["liger-kernel >=0.5.10"]
    end

    TH -->|"flash attention"| FlashAttn
    TH -->|"quantization"| BitsAndBytes
    TH -->|"CUDA kernels"| LigerKernel

    %% Internal Platform Dependencies
    subgraph PlatformDeps["Internal Platform Dependencies"]
        Kubeflow["Kubeflow<br/>(File-based SDK)"]
    end

    TH -.->|"training_metrics.jsonl<br/>progress tracking"| Kubeflow

    %% External Services
    subgraph ExternalSvcs["External Services"]
        HFHub["HuggingFace Hub"]
        WandB["Weights & Biases"]
        LLMAPI["OpenAI-Compatible API"]
    end

    TH -.->|"model/dataset download"| HFHub
    TH -.->|"experiment tracking"| WandB
    TH -.->|"GEPA/GRPO inference"| LLMAPI

