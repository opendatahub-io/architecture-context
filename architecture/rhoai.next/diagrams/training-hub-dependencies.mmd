graph LR
    TrainingHub["training-hub<br/>v0.9.2"]

    %% Core Dependencies (Required)
    TrainingHub -->|"SFT backend"| ILabTraining["instructlab-training<br/>>=0.14.0"]
    TrainingHub -->|"OSFT backend"| MiniTrainer["rhai-innovation-<br/>mini-trainer >=0.6.0"]
    TrainingHub -->|"core framework"| PyTorch["torch >=2.6.0"]
    TrainingHub -->|"models & tokenizers"| Transformers["transformers >=4.57.6"]
    TrainingHub -->|"dataset loading"| Datasets["datasets >=4.0.0"]
    TrainingHub -->|"LoRA config"| PEFT["peft >=0.15"]
    TrainingHub -->|"distributed training"| Accelerate["accelerate >=0.34.2"]
    TrainingHub -->|"config validation"| Pydantic["pydantic >=2.7.0"]

    %% CUDA Optional Dependencies
    TrainingHub -.->|"cuda extra"| FlashAttn["flash-attn >=2.8"]
    TrainingHub -.->|"cuda extra"| BitsAndBytes["bitsandbytes >=0.47.0"]
    TrainingHub -.->|"cuda extra"| LigerKernel["liger-kernel >=0.5.10"]
    TrainingHub -.->|"cuda extra"| MambaSSM["mamba-ssm >=2.2.5"]

    %% LoRA Optional Dependencies
    TrainingHub -.->|"lora extra"| Unsloth["unsloth >=2026.1.1"]
    TrainingHub -.->|"lora extra"| TRL["trl >=0.18.0"]
    TrainingHub -.->|"lora extra"| XFormers["xformers >=0.0.33"]

    %% GRPO Optional Dependencies
    TrainingHub -.->|"grpo extra"| ART["openpipe-art >=0.5.17"]
    TrainingHub -.->|"grpo extra"| LiteLLM["litellm >=1.71.1<br/>⚠️ !=1.82.7,!=1.82.8"]
    TrainingHub -.->|"grpo-verl extra"| VeRL["verl >=0.7"]

    %% GEPA Optional Dependencies
    TrainingHub -.->|"gepa extra"| GEPA["gepa >=0.1.1"]
    TrainingHub -.->|"gepa extra"| MLflow["mlflow >=3.5.0"]

    %% External Services (Runtime)
    TrainingHub -.->|"optional logging"| WandB["Weights & Biases<br/>api.wandb.ai"]
    TrainingHub -.->|"optional logging"| TensorBoard["TensorBoard<br/>File I/O"]

    %% Consumers
    InstructLab["InstructLab CLI"] -->|"pip dependency"| TrainingHub
    Workbench["RHOAI Workbench<br/>Notebooks"] -->|"pip dependency"| TrainingHub
    ITSHub["ITS Hub"] -.->|"ITSRollout adapter"| TrainingHub

