graph LR
    LLMDRouter["llm-d Router<br/>(EPP + pd-sidecar)"]

    %% External Dependencies (Required)
    LLMDRouter -->|"L7 proxy<br/>ext-proc filter"| Envoy["Envoy Proxy 1.28+"]
    LLMDRouter -->|"container orchestration<br/>CRD hosting"| K8s["Kubernetes 1.30+"]
    LLMDRouter -->|"controller framework<br/>CRD reconciliation"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    LLMDRouter -->|"InferencePool CRD<br/>EPP protocol"| GIE["gateway-api-inference-extension<br/>v1.5.0"]

    %% External Dependencies (Optional)
    LLMDRouter -.->|"Gateway API CRDs<br/>(Gateway mode)"| GatewayAPI["gateway-api v1.5.1"]
    LLMDRouter -.->|"distributed tracing"| OTEL["OpenTelemetry v1.44.0"]
    LLMDRouter -.->|"metrics collection"| Prometheus["Prometheus v1.23.2"]
    LLMDRouter -.->|"KV-cache events"| ZMQ["ZeroMQ v0.17.0"]

    %% Internal Platform Dependencies
    LLMDRouter -->|"metrics scraping<br/>request routing"| vLLM["vLLM / SGLang<br/>Model Servers"]
    LLMDRouter -.->|"mTLS<br/>DestinationRule"| Istio["Istio (optional)"]
    LLMDRouter -->|"pod discovery<br/>label selectors"| InferencePool["InferencePool<br/>(GIE CRD)"]

    %% CRDs consumed
    LLMDRouter -->|"priority config<br/>flow control"| InfObjective["InferenceObjective<br/>(llm-d.ai CRD)"]
    LLMDRouter -->|"model rewriting<br/>A/B testing"| InfRewrite["InferenceModelRewrite<br/>(llm-d.ai CRD)"]

    %% Integration Points (consumers of llm-d Router)
    Envoy -->|"ext-proc stream"| LLMDRouter
    Prometheus -->|"scrapes /metrics"| LLMDRouter
    OTEL -->|"receives traces"| LLMDRouter

    %% Styling
    style LLMDRouter fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style Envoy fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style GIE fill:#999,stroke:#333,color:#fff

    %% Optional external
    style GatewayAPI fill:#bbb,stroke:#333,color:#333
    style OTEL fill:#bbb,stroke:#333,color:#333
    style Prometheus fill:#bbb,stroke:#333,color:#333
    style ZMQ fill:#bbb,stroke:#333,color:#333

    %% Internal platform
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style InferencePool fill:#f5a623,stroke:#333,color:#fff
    style InfObjective fill:#f5a623,stroke:#333,color:#fff
    style InfRewrite fill:#f5a623,stroke:#333,color:#fff
