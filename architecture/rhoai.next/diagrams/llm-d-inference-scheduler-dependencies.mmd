graph LR
    LLMDRouter["llm-d Router<br/>(EPP + pd-sidecar)"]

    %% External Dependencies (Required)
    LLMDRouter -->|"ext-proc gRPC/9002<br/>TLS"| Envoy["Envoy Proxy<br/>(ext-proc v3)"]
    LLMDRouter -->|"API watches<br/>HTTPS/443"| K8s["Kubernetes 1.30+"]
    LLMDRouter -->|"CRD: HTTPRoute<br/>Gateway"| GatewayAPI["Gateway API v1.5.1"]
    LLMDRouter -->|"CRD: InferencePool"| GIE["Gateway API<br/>Inference Extension v1.5.0"]
    LLMDRouter -->|"metrics scraping<br/>inference routing"| ModelServers["vLLM / SGLang / Triton"]

    %% External Dependencies (Optional)
    LLMDRouter -.->|"service mesh<br/>DestinationRule"| Istio["Istio<br/>(optional)"]
    LLMDRouter -.->|"metrics scraping<br/>HTTP/9090"| Prometheus["Prometheus<br/>(optional)"]
    LLMDRouter -.->|"traces<br/>gRPC/4317"| OTLP["OpenTelemetry Collector<br/>(optional)"]

    %% Internal Platform Dependencies
    LLMDRouter -->|"CRD Watch"| InferencePool["InferencePool<br/>(GIE CRD)"]
    LLMDRouter -->|"ZMQ SUB/5557"| KVCache["llm-d-kv-cache<br/>(Go library)"]
    LLMDRouter -.->|"HTTP/8000-8001+<br/>latency predictions"| LatencyPredictor["Latency Predictor<br/>(XGBoost, optional)"]

    %% CRDs Defined
    LLMDRouter -->|"defines"| InferenceObj["InferenceObjective<br/>(llm-d.ai/v1alpha2)"]
    LLMDRouter -->|"defines"| InferenceRewrite["InferenceModelRewrite<br/>(llm-d.ai/v1alpha2)"]

    %% Sidecar-specific dependencies
    LLMDRouter -->|"HTTP(S)<br/>KV transfer"| PrefillWorkers["Prefill Workers"]
    LLMDRouter -->|"HTTP(S)<br/>embed transfer"| EncodeWorkers["Encode Workers"]
    LLMDRouter -->|"HTTP(S)/8001<br/>decode"| DecodeWorkers["Decode Workers"]

    %% Styles
    style LLMDRouter fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style Envoy fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style GIE fill:#999,stroke:#333,color:#fff
    style ModelServers fill:#999,stroke:#333,color:#fff

    %% Optional external
    style Istio fill:#bbb,stroke:#333,color:#fff
    style Prometheus fill:#bbb,stroke:#333,color:#fff
    style OTLP fill:#bbb,stroke:#333,color:#fff

    %% Internal platform
    style InferencePool fill:#7ed321,stroke:#333,color:#fff
    style KVCache fill:#7ed321,stroke:#333,color:#fff
    style LatencyPredictor fill:#7ed321,stroke:#333,color:#fff

    %% CRDs defined by this component
    style InferenceObj fill:#f5a623,stroke:#333,color:#fff
    style InferenceRewrite fill:#f5a623,stroke:#333,color:#fff

    %% Worker pods
    style PrefillWorkers fill:#50c878,stroke:#333,color:#fff
    style EncodeWorkers fill:#50c878,stroke:#333,color:#fff
    style DecodeWorkers fill:#50c878,stroke:#333,color:#fff
