graph TB
    subgraph DSCLayer["DSC Component Module Layer"]
        Module["trustyai-operator-module<br/>(DSC Module Controller)"]
        TrustyAICR["TrustyAI CR<br/>(Cluster-scoped)"]
        TrustyAICR -->|watched by| Module
        Module -->|renders manifests| OperatorDeploy["Operator Deployment"]
    end

    subgraph Operator["trustyai-service-operator (manager)"]
        direction TB

        subgraph Controllers["Service Controllers"]
            TASCtrl["TrustyAIService<br/>Controller"]
            EvalHubCtrl["EvalHub<br/>Controller"]
            LMESCtrl["LMEvalJob<br/>Controller"]
            NemoCtrl["NemoGuardrails<br/>Controller"]
        end

        subgraph Support["Support Controllers"]
            TLSWatcher["TLS ProfileWatcher"]
            JobFailure["Job Failure<br/>Reconciler"]
            KueueReconciler["Kueue Workload<br/>Reconciler"]
        end

        subgraph Infra["Infrastructure"]
            Webhook["Webhook Server<br/>:9443/TCP"]
            Metrics["Metrics Server<br/>:8443/TCP"]
            Health["Health Probes<br/>:8081/TCP"]
        end

        Registration["Dynamic Service<br/>Registration<br/>(--enable-services)"]
        Registration --> TASCtrl
        Registration --> EvalHubCtrl
        Registration --> LMESCtrl
        Registration --> NemoCtrl
    end

    subgraph Workloads["Managed Workloads"]
        TASInstance["TrustyAI Service<br/>+ kube-rbac-proxy sidecar"]
        EvalHubInstance["EvalHub Instance"]
        LMEvalPod["LMEval Job Pod<br/>(driver + lmes-job)"]
        NemoInstance["NemoGuardrails Server"]
    end

    subgraph CRDs["Custom Resources"]
        TrustyAIServiceCR["TrustyAIService CR"]
        EvalHubCR["EvalHub CR"]
        LMEvalJobCR["LMEvalJob CR"]
        NemoGuardrailsCR["NemoGuardrails CR"]
    end

    TASCtrl -->|reconciles| TrustyAIServiceCR
    EvalHubCtrl -->|reconciles| EvalHubCR
    LMESCtrl -->|reconciles| LMEvalJobCR
    NemoCtrl -->|reconciles| NemoGuardrailsCR

    TASCtrl -->|creates| TASInstance
    EvalHubCtrl -->|creates| EvalHubInstance
    LMESCtrl -->|creates| LMEvalPod
    NemoCtrl -->|creates| NemoInstance

    TLSWatcher -->|watches| APIServerConfig["OpenShift APIServer<br/>TLS Profile"]
    TLSWatcher -->|triggers restart| Operator

    JobFailure -->|watches| FailedJobs["Failed Batch Jobs"]
    KueueReconciler -->|watches| KueueWorkloads["Kueue Workloads"]

    TASCtrl -->|watches/patches| InferenceService["KServe<br/>InferenceService"]
    EvalHubCtrl -->|propagates to| TenantNS["Tenant Namespaces<br/>(labeled)"]
    EvalHubCtrl -->|creates| MLflowExp["MLflow Experiments"]

    style Module fill:#9b59b6,stroke:#333,color:#fff
    style TASCtrl fill:#4a90e2,stroke:#333,color:#fff
    style EvalHubCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LMESCtrl fill:#4a90e2,stroke:#333,color:#fff
    style NemoCtrl fill:#4a90e2,stroke:#333,color:#fff
    style TLSWatcher fill:#e67e22,stroke:#333,color:#fff
    style JobFailure fill:#e67e22,stroke:#333,color:#fff
    style KueueReconciler fill:#e67e22,stroke:#333,color:#fff
    style TrustyAIServiceCR fill:#f5a623,stroke:#333
    style EvalHubCR fill:#f5a623,stroke:#333
    style LMEvalJobCR fill:#f5a623,stroke:#333
    style NemoGuardrailsCR fill:#f5a623,stroke:#333
    style TASInstance fill:#7ed321,stroke:#333
    style EvalHubInstance fill:#7ed321,stroke:#333
    style LMEvalPod fill:#7ed321,stroke:#333
    style NemoInstance fill:#7ed321,stroke:#333
    style Webhook fill:#95a5a6,stroke:#333,color:#fff
    style Metrics fill:#95a5a6,stroke:#333,color:#fff
    style Health fill:#95a5a6,stroke:#333,color:#fff
