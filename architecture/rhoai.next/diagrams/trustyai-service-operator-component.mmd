graph TB
    subgraph Operator["TrustyAI Service Operator (manager)"]
        direction TB
        TASCtrl["TAS Controller<br/>TrustyAI Service"]
        LMESCtrl["LMES Controller<br/>LMEvalJob"]
        EvalHubCtrl["EvalHub Controller<br/>Multi-tenant Eval Platform"]
        GORCHCtrl["GORCH Controller<br/>Guardrails Orchestrator"]
        NemoCtrl["NemoGuardrails Controller<br/>NeMo Guardrails"]
        ModuleCtrl["Module Controller<br/>Platform Integration"]
        JobMgrCtrl["Job Manager Controller<br/>Kueue Integration"]
        WebhookSrv["Webhook Server<br/>9443/TCP"]
    end

    subgraph Driver["ta-lmes-driver"]
        DriverBin["Driver Binary<br/>Init Container + Sidecar<br/>18080/TCP"]
    end

    %% CRDs
    TASCR["TrustyAIService CR<br/>trustyai.opendatahub.io/v1"]
    LMESCR["LMEvalJob CR<br/>trustyai.opendatahub.io/v1alpha1"]
    EvalHubCR["EvalHub CR<br/>trustyai.opendatahub.io/v1"]
    GORCHCR["GuardrailsOrchestrator CR<br/>trustyai.opendatahub.io/v1alpha1"]
    NemoCR["NemoGuardrails CR<br/>trustyai.opendatahub.io/v1alpha1"]
    ModuleCR["TrustyAI Module CR<br/>components.platform.opendatahub.io/v1alpha1"]

    %% CRD watches
    TASCR -->|watched by| TASCtrl
    LMESCR -->|watched by| LMESCtrl
    EvalHubCR -->|watched by| EvalHubCtrl
    GORCHCR -->|watched by| GORCHCtrl
    NemoCR -->|watched by| NemoCtrl
    ModuleCR -->|watched by| ModuleCtrl

    %% Managed resources
    TASCtrl -->|creates| TASDepl["TAS Deployment<br/>+ kube-rbac-proxy sidecar"]
    TASCtrl -->|creates| TASSvc["TAS Service<br/>8443/TCP"]
    TASCtrl -->|creates| TASRoute["TAS Route<br/>443/TCP edge"]
    TASCtrl -->|patches| InfSvc["KServe InferenceService"]

    LMESCtrl -->|creates| EvalPod["LMEval Pod<br/>+ Driver Sidecar"]
    DriverBin -.->|runs in| EvalPod

    EvalHubCtrl -->|creates| EHDepl["EvalHub Deployment<br/>API + MCP + kube-rbac-proxy"]
    EvalHubCtrl -->|creates| EHRoute["EvalHub Route<br/>443/TCP passthrough"]

    GORCHCtrl -->|creates| GORCHDepl["GORCH Deployment<br/>Orchestrator + Detectors<br/>+ kube-rbac-proxy"]
    GORCHCtrl -->|creates| GORCHRoute["GORCH Route<br/>443/TCP reencrypt"]
    GORCHCtrl -->|auto-discovers| InfSvc

    NemoCtrl -->|creates| NemoDepl["NeMo Deployment<br/>+ kube-rbac-proxy"]
    NemoCtrl -->|creates| NemoRoute["NeMo Route<br/>443/TCP"]
    NemoCtrl -->|creates| EnvoyFilter["Istio EnvoyFilter"]

    JobMgrCtrl -->|creates| KueueWL["Kueue Workload"]

    %% External dependencies
    TASCtrl -->|depends on| Istio["Istio Service Mesh"]
    GORCHCtrl -->|depends on| KServe["KServe"]
    NemoCtrl -->|depends on| MCPGateway["MCP Gateway<br/>(Kuadrant)"]

    %% Platform integration
    PlatformOp["rhods-operator /<br/>opendatahub-operator"] -->|creates| ModuleCR
    ModuleCtrl -->|manages| Operator

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Driver fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style TASCR fill:#f5a623,stroke:#333
    style LMESCR fill:#f5a623,stroke:#333
    style EvalHubCR fill:#f5a623,stroke:#333
    style GORCHCR fill:#f5a623,stroke:#333
    style NemoCR fill:#f5a623,stroke:#333
    style ModuleCR fill:#f5a623,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style MCPGateway fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#7ed321,stroke:#333
    style InfSvc fill:#7ed321,stroke:#333
