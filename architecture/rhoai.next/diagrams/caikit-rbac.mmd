graph TD
    subgraph CaikitLibrary["Caikit (Library — No Direct RBAC)"]
        Note["Caikit is a Python library, not a Kubernetes operator.<br/>It defines NO ClusterRoles, Roles, or RoleBindings.<br/>All RBAC is defined by consuming deployments."]
    end

    subgraph PlatformRBAC["Platform-Level RBAC (Defined by Consumers)"]
        direction TB

        subgraph KServeRBAC["KServe (defines RBAC for serving)"]
            KServeSA["ServiceAccount<br/>kserve-controller-manager"]
            KServeCR["ClusterRole<br/>kserve-manager-role"]
            KServeCRB["ClusterRoleBinding<br/>kserve-manager-rolebinding"]

            KServeSA -->|bound via| KServeCRB
            KServeCRB -->|grants| KServeCR
        end

        subgraph ModelMeshRBAC["ModelMesh (defines RBAC for model mgmt)"]
            MMeshSA["ServiceAccount<br/>modelmesh-controller"]
            MMeshCR["ClusterRole<br/>modelmesh-controller-role"]
            MMeshCRB["ClusterRoleBinding<br/>modelmesh-controller-binding"]

            MMeshSA -->|bound via| MMeshCRB
            MMeshCRB -->|grants| MMeshCR
        end
    end

    subgraph AuthDelegation["Authentication & Authorization Model"]
        direction TB

        Endpoint["All Caikit HTTP/gRPC Endpoints"]
        NoAuth["No Built-in Auth"]
        TLS["Transport Encryption<br/>TLS/mTLS (configurable)"]
        Platform["Platform Enforcement<br/>kube-rbac-proxy<br/>Istio AuthorizationPolicy<br/>KServe RequestAuthentication"]

        Endpoint --> NoAuth
        Endpoint --> TLS
        NoAuth -->|"delegated to"| Platform
    end

    subgraph Secrets["TLS Secrets (Config-based, not K8s Secrets)"]
        ServerKey["runtime.tls.server.key<br/>TLS private key"]
        ServerCert["runtime.tls.server.cert<br/>TLS certificate"]
        ClientCert["runtime.tls.client.cert<br/>Client CA (mTLS)"]
        TraceCA["runtime.trace.tls.ca<br/>OTel CA cert"]
        TraceKey["runtime.trace.tls.client_key<br/>OTel client key"]
        TraceCert["runtime.trace.tls.client_cert<br/>OTel client cert"]
    end

    %% Show delegation
    CaikitLibrary -.->|"RBAC delegated to"| PlatformRBAC
    CaikitLibrary -.->|"Auth delegated to"| AuthDelegation

    %% Styling
    style CaikitLibrary fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    style PlatformRBAC fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style AuthDelegation fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    style Secrets fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style Note fill:#bbdefb,stroke:#1976d2
    style NoAuth fill:#ffcdd2,stroke:#c62828
    style Platform fill:#c8e6c9,stroke:#388e3c
