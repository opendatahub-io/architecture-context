graph TD
    subgraph CaikitLibrary["Caikit (Library — No Direct RBAC)"]
        Note["Caikit is a Python library.<br/>It does not define Kubernetes RBAC resources.<br/>RBAC is configured by consuming deployments."]
    end

    subgraph PlatformRBAC["Platform-Level RBAC (Consuming Deployments)"]
        direction TB

        subgraph KServeDeployment["KServe ServingRuntime Deployment"]
            KServeSA["ServiceAccount<br/>(defined by KServe)"]
            KServeRB["RoleBinding<br/>(defined by KServe)"]
            KServeRole["Role/ClusterRole<br/>(defined by KServe)"]
            KServeSA -->|"bound via"| KServeRB
            KServeRB -->|"grants"| KServeRole
        end

        subgraph AuthProxy["Auth Proxy (kube-rbac-proxy)"]
            ProxySA["Proxy ServiceAccount"]
            ProxyRB["RoleBinding"]
            ProxyRole["ClusterRole<br/>(token review, SAR)"]
            ProxySA -->|"bound via"| ProxyRB
            ProxyRB -->|"grants"| ProxyRole
        end
    end

    subgraph TLSSecrets["TLS Secrets (Caikit Configuration)"]
        direction TB
        ServerKey["runtime.tls.server.key<br/>TLS private key<br/>Provisioned: cert-manager"]
        ServerCert["runtime.tls.server.cert<br/>TLS certificate<br/>Provisioned: cert-manager"]
        ClientCert["runtime.tls.client.cert<br/>TLS CA cert (mTLS)<br/>Provisioned: manual"]
        TraceCA["runtime.trace.tls.ca<br/>OTel exporter CA<br/>Provisioned: manual"]
        TraceKey["runtime.trace.tls.client_key<br/>OTel exporter key<br/>Provisioned: manual"]
        TraceCert["runtime.trace.tls.client_cert<br/>OTel exporter cert<br/>Provisioned: manual"]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB
        NoAuth["No built-in application auth"]
        TLSTransport["TLS/mTLS transport encryption"]
        Delegated["Auth delegated to platform:<br/>- KServe InferenceService<br/>- kube-rbac-proxy sidecar<br/>- Istio AuthorizationPolicy<br/>- OpenShift Route auth"]

        NoAuth --> TLSTransport
        TLSTransport --> Delegated
    end

    CaikitLibrary -.->|"deployed within"| KServeDeployment
    CaikitLibrary -.->|"protected by"| AuthProxy
    CaikitLibrary -->|"uses"| TLSSecrets

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style CaikitLibrary fill:#fff3cd,stroke:#856404
    style KServeDeployment fill:#d5e8d4,stroke:#82b366
    style AuthProxy fill:#d5e8d4,stroke:#82b366
    style TLSSecrets fill:#dce4f0,stroke:#6b7fa3

    style ServerKey fill:#f8d7da,stroke:#721c24
    style ServerCert fill:#f8d7da,stroke:#721c24
    style ClientCert fill:#f8d7da,stroke:#721c24
    style TraceCA fill:#f8d7da,stroke:#721c24
    style TraceKey fill:#f8d7da,stroke:#721c24
    style TraceCert fill:#f8d7da,stroke:#721c24

    style NoAuth fill:#fff,stroke:#333
    style TLSTransport fill:#d4edda,stroke:#155724
    style Delegated fill:#cce5ff,stroke:#004085
