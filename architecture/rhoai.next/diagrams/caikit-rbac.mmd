graph TD
    subgraph CaikitNote["Caikit RBAC Model"]
        direction TB
        Note["NOTE: Caikit is a pure Python library<br/>with NO built-in authentication or authorization.<br/>All RBAC is delegated to the platform layer."]
    end

    subgraph PlatformAuth["Platform-Level Auth Enforcement"]
        direction TB

        subgraph KServeRBAC["KServe Deployment"]
            KServeSA["ServiceAccount<br/>(KServe-managed)"]
            KServeRB["RoleBinding<br/>(KServe-managed)"]
            KServeCR["ClusterRole<br/>(KServe operator)"]
            KServeSA -->|"bound via"| KServeRB
            KServeRB -->|"grants"| KServeCR
        end

        subgraph ModelMeshRBAC["ModelMesh Deployment"]
            MMeshSA["ServiceAccount<br/>(ModelMesh-managed)"]
            MMeshRB["RoleBinding<br/>(ModelMesh-managed)"]
            MMeshCR["ClusterRole<br/>(ModelMesh operator)"]
            MMeshSA -->|"bound via"| MMeshRB
            MMeshRB -->|"grants"| MMeshCR
        end

        subgraph AuthProxies["Auth Proxy Sidecars"]
            KubeRBACProxy["kube-rbac-proxy<br/>Enforces Kubernetes RBAC<br/>on API access"]
            OAuthProxy["OAuth Proxy<br/>Enforces OAuth/OIDC<br/>authentication"]
            IstioMTLS["Istio Sidecar<br/>Enforces mTLS<br/>PeerAuthentication STRICT"]
        end
    end

    subgraph CaikitTLS["Caikit Transport Security (Not Auth)"]
        direction TB

        subgraph ServerTLS["Server TLS Configuration"]
            TLSKey["runtime.tls.server.key<br/>(TLS private key)"]
            TLSCert["runtime.tls.server.cert<br/>(TLS certificate)"]
            ClientCA["runtime.tls.client.cert<br/>(Client CA for mTLS)"]
        end

        subgraph TraceTLS["Trace TLS Configuration"]
            TraceCA["runtime.trace.tls.ca<br/>(OTLP collector CA)"]
            TraceKey["runtime.trace.tls.client_key<br/>(mTLS client key)"]
            TraceCert["runtime.trace.tls.client_cert<br/>(mTLS client cert)"]
        end

        GRPCEndpoint["gRPC Server 8085/TCP<br/>TLS/mTLS/plaintext"]
        HTTPEndpoint["HTTP Server 8080/TCP<br/>TLS/mTLS/plaintext"]

        TLSKey -->|"encrypts"| GRPCEndpoint
        TLSCert -->|"encrypts"| GRPCEndpoint
        TLSKey -->|"encrypts"| HTTPEndpoint
        TLSCert -->|"encrypts"| HTTPEndpoint
        ClientCA -->|"validates clients"| GRPCEndpoint
        ClientCA -->|"validates clients"| HTTPEndpoint
    end

    subgraph Endpoints["Caikit API Endpoints (No Auth)"]
        InferenceAPI["Inference APIs<br/>POST /api/v1/task/*<br/>gRPC {Domain}Service"]
        ManagementAPI["Management APIs<br/>POST/DELETE /management/models<br/>gRPC ModelManagement"]
        TrainingAPI["Training APIs<br/>POST /api/v1/*Train<br/>gRPC {Domain}TrainingService"]
        InfoAPI["Info APIs<br/>GET /health, /info/*<br/>gRPC InfoService"]
    end

    %% Platform protects endpoints
    KubeRBACProxy -->|"protects"| InferenceAPI
    KubeRBACProxy -->|"protects"| ManagementAPI
    OAuthProxy -->|"protects"| InferenceAPI
    IstioMTLS -->|"protects"| InferenceAPI
    IstioMTLS -->|"protects"| ManagementAPI
    IstioMTLS -->|"protects"| TrainingAPI

    %% Styles
    style Note fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00
    style OAuthProxy fill:#ffe6cc,stroke:#d79b00
    style IstioMTLS fill:#ffe6cc,stroke:#d79b00
    style GRPCEndpoint fill:#d5e8d4,stroke:#82b366
    style HTTPEndpoint fill:#d5e8d4,stroke:#82b366
    style InferenceAPI fill:#dae8fc,stroke:#6c8ebf
    style ManagementAPI fill:#dae8fc,stroke:#6c8ebf
    style TrainingAPI fill:#dae8fc,stroke:#6c8ebf
    style InfoAPI fill:#dae8fc,stroke:#6c8ebf
    style TLSKey fill:#fff2cc,stroke:#d6b656
    style TLSCert fill:#fff2cc,stroke:#d6b656
    style ClientCA fill:#fff2cc,stroke:#d6b656
    style TraceCA fill:#fff2cc,stroke:#d6b656
    style TraceKey fill:#fff2cc,stroke:#d6b656
    style TraceCert fill:#fff2cc,stroke:#d6b656
