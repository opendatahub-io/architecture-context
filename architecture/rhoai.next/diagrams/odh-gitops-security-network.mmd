graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Helm Client / kubectl / ArgoCD"]
    end

    subgraph K8sControl["KUBERNETES API SERVER"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-operator)"]
        direction TB

        Operator["RHAI Operator Deployment<br/>SA: rhai-operator-controller-manager<br/>Image: quay.io/opendatahub/opendatahub-operator"]

        WebhookSvc["rhai-operator-webhook-service<br/>ClusterIP 443→9443/TCP<br/>HTTPS, TLS webhook certs"]

        MetricsSvc["metrics-service<br/>ClusterIP 8080/TCP<br/>HTTP, No encryption"]

        HealthEndpoints["Health Probes<br/>/healthz, /readyz<br/>8081/TCP HTTP"]
    end

    subgraph HookJobs["POST-INSTALL HOOKS (xKS)"]
        direction TB
        Hook1["post-install-crs Job<br/>SA: rhai-post-install-hook<br/>Weight 1: KE + Platform + Component CRs"]
        Hook2["post-create-gateway Job<br/>SA: rhai-post-install-hook<br/>Weight 2: Inference Gateway + TLS"]
        Hook3["post-create-maas-gateway Job<br/>SA: rhai-post-install-hook<br/>Weight 3: MaaS Gateway + TLS"]
    end

    subgraph GatewayInfra["GATEWAY INFRASTRUCTURE (xKS)"]
        direction TB
        InferenceGW["inference-gateway<br/>Gateway API v1<br/>80/TCP HTTP, 443/TCP HTTPS<br/>TLS Terminate<br/>cert: inference-gateway-cert-secret"]
        MaaSGW["maas-default-gateway<br/>Gateway API v1<br/>80/TCP HTTP, 443/TCP HTTPS<br/>TLS Terminate<br/>cert: maas-gateway-cert-secret"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        CertMgrCA["cert-manager CA Secret<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        OLMCatalog["OLM CatalogSource<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>(OpenShift only)"]
        BuildConfig["RHOAI-Build-Config<br/>443/TCP HTTPS<br/>GitHub Actions token"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig creds"| K8sAPI

    K8sAPI -->|"Admission webhook<br/>HTTPS/443→9443<br/>TLS client cert"| WebhookSvc

    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>Watch/Manage CRs"| K8sAPI

    Hook1 -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Hook2 -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Hook2 -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| CertMgrCA
    Hook3 -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Hook3 -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| CertMgrCA

    Hook2 -.->|creates| InferenceGW
    Hook3 -.->|creates| MaaSGW

    Operator -->|"Resolves bundles<br/>HTTPS/443"| OLMCatalog

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sapi fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hooks fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gateway fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class K8sAPI k8sapi
    class Operator,WebhookSvc,MetricsSvc,HealthEndpoints operator
    class Hook1,Hook2,Hook3 hooks
    class InferenceGW,MaaSGW gateway
    class CertMgrCA,OLMCatalog,BuildConfig extsvc
