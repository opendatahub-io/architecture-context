graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Cluster Administrator<br/>kubeconfig auth"]
        ExtClient["External Client<br/>(Model Consumer)"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>kubeconfig / ServiceAccount"]
        OLM["OLM<br/>Operator Lifecycle Manager"]
    end

    subgraph IngressZone["INGRESS (Gateway Layer)"]
        InfGW["Inference Gateway<br/>80/TCP, 443/TCP<br/>TLS Terminate<br/>cert-manager cert"]
        MaaSGW["MaaS Gateway<br/>80/TCP, 443/TCP<br/>TLS Terminate<br/>cert-manager cert"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER"]
        Authorino["Authorino<br/>(RHCL/Kuadrant)<br/>AuthPolicy enforcement"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (rhai-system / redhat-ods-operator)"]
        RHAIOp["RHAI Operator<br/>SA: rhai-operator-controller-manager<br/>Webhook: 9443/TCP HTTPS<br/>Health: 8081/TCP<br/>Metrics: 8080/TCP"]
    end

    subgraph CloudMgr["CLOUD MANAGER NAMESPACE (rhai-cloudmanager-system)"]
        AWSMgr["AWS Cloud Manager<br/>SA: aws-cloud-manager-operator"]
        AzureMgr["Azure Cloud Manager<br/>SA: azure-cloud-manager-operator"]
        CWMgr["CoreWeave Cloud Manager<br/>SA: coreweave-cloud-manager-operator"]
    end

    subgraph CertMgrNS["CERT-MANAGER NAMESPACE"]
        CertMgr["cert-manager<br/>CA Issuer: rhai-ca-issuer"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        CatSrc["CatalogSource<br/>redhat-operators<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        ContReg["Container Registry<br/>quay.io / registry.redhat.io<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Pull Secret"]
    end

    %% Flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI
    ExtClient -->|"HTTPS/443<br/>TLS<br/>Bearer/Authorino"| InfGW
    ExtClient -->|"HTTPS/443<br/>TLS<br/>Bearer/Authorino"| MaaSGW
    InfGW -->|"AuthPolicy"| Authorino
    MaaSGW -->|"AuthPolicy"| Authorino
    K8sAPI -->|"Webhook<br/>HTTPS/9443<br/>TLS"| RHAIOp
    K8sAPI -->|"Metrics<br/>HTTP/8080"| RHAIOp
    OLM -->|"HTTPS/443<br/>TLS 1.2+"| CatSrc
    OLM -->|"HTTPS/443<br/>TLS 1.2+<br/>Pull Secret"| ContReg
    CertMgr -->|"Provisions TLS<br/>Secrets"| InfGW
    CertMgr -->|"Provisions TLS<br/>Secrets"| MaaSGW
    CertMgr -->|"Provisions TLS<br/>Secrets"| RHAIOp
    RHAIOp -->|"Kubernetes API<br/>TLS"| K8sAPI
    AWSMgr -->|"Kubernetes API<br/>TLS"| K8sAPI
    AzureMgr -->|"Kubernetes API<br/>TLS"| K8sAPI
    CWMgr -->|"Kubernetes API<br/>TLS"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dce8f5,stroke:#4a90e2,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#e6d5f5,stroke:#9673a6,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef certmgr fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Admin,ExtClient external
    class K8sAPI,OLM controlplane
    class InfGW,MaaSGW ingress
    class Authorino auth
    class RHAIOp,AWSMgr,AzureMgr,CWMgr operator
    class CertMgr certmgr
    class CatSrc,ContReg externalsvc
