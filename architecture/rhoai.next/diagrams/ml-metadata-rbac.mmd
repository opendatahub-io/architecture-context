graph TD
    subgraph DeploymentContext["Deployment Context"]
        DSPOperator["DSP Operator<br/>(rhods-operator / opendatahub-operator)<br/>Manages MLMD server lifecycle"]
    end

    subgraph MLMDServer["MLMD gRPC Server"]
        Server["metadata_store_server<br/>Container: odh-mlmd-grpc-server<br/>UID: 65534 (non-root)<br/>Port: 8080/TCP"]
    end

    subgraph TransportAuth["Transport-Level Authentication"]
        TLSConfig["SSLConfig (Optional)"]
        ServerTLS["Server TLS<br/>server_key + server_cert + custom_ca<br/>Crypto: BoringSSL"]
        ClientMTLS["Client mTLS (Optional)<br/>client_verify flag<br/>Requires valid client certificate"]
        TLSConfig --> ServerTLS
        TLSConfig --> ClientMTLS
    end

    subgraph NoAppAuthZ["Application-Level Authorization"]
        direction TB
        Warning["NO APPLICATION-LEVEL AUTHZ"]
        Detail1["All authenticated clients<br/>have FULL read/write access"]
        Detail2["No per-user scoping"]
        Detail3["No per-namespace scoping"]
        Detail4["No per-pipeline scoping"]
        Warning --- Detail1
        Warning --- Detail2
        Warning --- Detail3
        Warning --- Detail4
    end

    subgraph NetworkIsolation["Network-Level Isolation (Platform-Managed)"]
        NetworkPolicy["Kubernetes NetworkPolicy<br/>Deployed by platform operator<br/>Restricts which pods can<br/>reach MLMD port 8080"]
        SeparateInstances["Separate MLMD Instances<br/>One per DSPA namespace<br/>Database-level tenant boundary"]
    end

    subgraph Secrets["Secrets (Managed by Platform Operator)"]
        DBCreds["DB Credentials (Opaque)<br/>MySQL/PostgreSQL username + password<br/>Auto-Rotate: No"]
        TLSServerCert["TLS Server Cert (kubernetes.io/tls)<br/>gRPC TLS termination<br/>Auto-Rotate: Operator-dependent"]
        TLSClientCA["TLS Client CA (Opaque)<br/>mTLS client verification<br/>Auto-Rotate: No"]
        DBSSLCerts["DB SSL Certs (Opaque)<br/>MySQL: cert, key, ca, cipher<br/>PostgreSQL: sslcert, sslkey, sslrootcert<br/>Auto-Rotate: No"]
    end

    %% Relationships
    DSPOperator -->|"deploys & manages"| Server
    DSPOperator -->|"provisions"| Secrets
    Server -->|"configured with"| TLSConfig
    Server -->|"has"| NoAppAuthZ
    DSPOperator -->|"enforces"| NetworkIsolation

    %% Styling
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style DSPOperator fill:#7ed321,stroke:#333
    style Warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Detail1 fill:#f8cecc,stroke:#b85450
    style Detail2 fill:#f8cecc,stroke:#b85450
    style Detail3 fill:#f8cecc,stroke:#b85450
    style Detail4 fill:#f8cecc,stroke:#b85450
    style NetworkPolicy fill:#d5e8d4,stroke:#82b366
    style SeparateInstances fill:#d5e8d4,stroke:#82b366
    style TLSConfig fill:#dae8fc,stroke:#6c8ebf
    style ServerTLS fill:#dae8fc,stroke:#6c8ebf
    style ClientMTLS fill:#dae8fc,stroke:#6c8ebf
    style DBCreds fill:#e1d5e7,stroke:#9673a6
    style TLSServerCert fill:#e1d5e7,stroke:#9673a6
    style TLSClientCA fill:#e1d5e7,stroke:#9673a6
    style DBSSLCerts fill:#e1d5e7,stroke:#9673a6
