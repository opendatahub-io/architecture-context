graph TD
    subgraph "ML Metadata RBAC Model"
        direction TB

        Note["NOTE: ML Metadata defines no Kubernetes RBAC<br/>resources of its own. It runs as a standalone<br/>gRPC server without Kubernetes API access."]

        subgraph "Pod Security (managed by deploying operator)"
            Container["metadata_store_server<br/>Runs as: 65534:65534 (non-root)<br/>Image: odh-mlmd-grpc-server"]
        end

        subgraph "gRPC Authentication (application-level)"
            Default["Default Mode<br/>InsecureServerCredentials<br/>No authentication"]
            MTLS["Optional mTLS Mode<br/>SslServerCredentials<br/>client_verify=true<br/>Client certificate required"]
        end

        subgraph "Authorization Model"
            NoAuthZ["No per-user authorization<br/>All clients: full read/write<br/>to all metadata entities"]
        end

        subgraph "Managed By: DSP Operator"
            SA["ServiceAccount<br/>(operator-defined)"]
            Secrets["Secrets<br/>DB credentials<br/>TLS certificates"]
            NetworkPolicy["NetworkPolicy<br/>(operator-defined)"]
        end
    end

    Container --> Default
    Container --> MTLS
    Default --> NoAuthZ
    MTLS --> NoAuthZ
    SA -.->|"assigned to pod"| Container
    Secrets -.->|"mounted into pod"| Container
    NetworkPolicy -.->|"controls access to"| Container

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style Container fill:#4a90e2,stroke:#333,color:#fff
    style Default fill:#e8e8e8,stroke:#333
    style MTLS fill:#d5e8d4,stroke:#82b366
    style NoAuthZ fill:#f8d7da,stroke:#721c24
    style SA fill:#9b59b6,stroke:#333,color:#fff
    style Secrets fill:#9b59b6,stroke:#333,color:#fff
    style NetworkPolicy fill:#9b59b6,stroke:#333,color:#fff
