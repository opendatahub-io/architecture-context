graph TD
    subgraph "Service Account"
        SA["release-llm-d-async<br/>(created by Helm chart)"]
    end

    subgraph "Authentication Flow"
        MetricsServer["Metrics Server<br/>9090/TCP"]
        AuthFilter["kube-rbac-proxy Filter<br/>(optional, default enabled)"]
        SAR["SubjectAccessReview<br/>via Kubernetes API"]
    end

    subgraph "Secrets Access"
        RedisSecret["{release}-redis<br/>Type: Opaque<br/>Redis/Valkey connection URL"]
        TLSSecret["{ap.tls.secretName}<br/>Type: kubernetes.io/tls<br/>Client certs for mTLS"]
    end

    subgraph "Pod Security Context"
        SecurityCtx["Security Context<br/>readOnlyRootFilesystem: true<br/>runAsNonRoot: true<br/>allowPrivilegeEscalation: false<br/>capabilities: drop ALL<br/>seccompProfile: RuntimeDefault"]
    end

    SA -->|in-cluster token| MetricsServer
    MetricsServer -->|delegates auth| AuthFilter
    AuthFilter -->|HTTPS/6443| SAR

    SA -->|volume mount| RedisSecret
    SA -->|volume mount| TLSSecret

    SA -->|enforced on pod| SecurityCtx

    Note["NOTE: No explicit ClusterRoles,<br/>Roles, or RoleBindings defined.<br/>SA used only for metrics auth<br/>SubjectAccessReview calls."]

    style SA fill:#4a90e2,stroke:#333
    style MetricsServer fill:#4a90e2,stroke:#333
    style AuthFilter fill:#f5a623,stroke:#333
    style SAR fill:#f5a623,stroke:#333
    style RedisSecret fill:#e74c3c,stroke:#333,color:#fff
    style TLSSecret fill:#e74c3c,stroke:#333,color:#fff
    style SecurityCtx fill:#7ed321,stroke:#333
    style Note fill:#f9f9f9,stroke:#999,stroke-dasharray: 5 5
