graph TD
    subgraph "Pod Identity"
        SA["ServiceAccount<br/>async-processor"]
    end

    subgraph "Pod Security Context"
        PSC["Security Context<br/>runAsNonRoot: true<br/>readOnlyRootFilesystem: true<br/>allowPrivilegeEscalation: false<br/>capabilities: drop ALL"]
    end

    subgraph "RBAC Status"
        NoRBAC["No ClusterRole / Role defined<br/>No RoleBindings<br/>No Kubernetes API interaction at runtime"]
    end

    subgraph "Authentication Mechanisms"
        direction TB
        MetricsAuth["Metrics Endpoint Auth<br/>/metrics (9090/TCP)<br/>Optional controller-runtime auth<br/>(--metrics-endpoint-auth flag)"]
        MTLSAuth["Inference Gateway mTLS<br/>Optional client certs<br/>(--tls-cert, --tls-key)<br/>Custom CA (--tls-ca-cert)"]
        RedisAuth["Redis Auth<br/>Password in URL<br/>(redis://user:pass@host:port)<br/>Secret: async-processor-redis"]
        GCPAuth["GCP Auth<br/>Application Default Credentials<br/>(Workload Identity or SA key)"]
    end

    subgraph "Secrets"
        RedisSecret["async-processor-redis<br/>Type: Opaque<br/>Content: Redis connection URL<br/>Provisioned: Helm / pre-existing<br/>Auto-Rotate: No"]
        TLSSecret["(tls.secretName)<br/>Type: kubernetes.io/tls<br/>Content: TLS certs for IGW mTLS<br/>Provisioned: Manual / cert-manager<br/>Auto-Rotate: No"]
    end

    SA --> PSC
    SA --> NoRBAC
    SA --> MetricsAuth
    SA --> MTLSAuth
    SA --> RedisAuth
    SA --> GCPAuth
    RedisAuth -->|uses| RedisSecret
    MTLSAuth -->|uses| TLSSecret

    style SA fill:#4a90e2,color:#fff
    style PSC fill:#d5e8d4,stroke:#82b366
    style NoRBAC fill:#f5f5f5,stroke:#999
    style MetricsAuth fill:#fff2cc,stroke:#d6b656
    style MTLSAuth fill:#fff2cc,stroke:#d6b656
    style RedisAuth fill:#fff2cc,stroke:#d6b656
    style GCPAuth fill:#fff2cc,stroke:#d6b656
    style RedisSecret fill:#f8cecc,stroke:#b85450
    style TLSSecret fill:#f8cecc,stroke:#b85450
