graph TD
    subgraph "Service Account"
        SA["{release}-async-processor<br/>ServiceAccount"]
    end

    subgraph "RBAC Status"
        NoRBAC["No ClusterRoles or<br/>RoleBindings Defined"]
    end

    subgraph "Security Context (Pod-Level)"
        SecCtx["readOnlyRootFilesystem: true<br/>runAsNonRoot: true<br/>allowPrivilegeEscalation: false<br/>capabilities: drop ALL<br/>seccompProfile: RuntimeDefault"]
    end

    subgraph "Secrets Access"
        RedisSecret["{release}-redis<br/>Type: Opaque<br/>Key: REDIS_URL<br/>Provisioned: Helm chart"]
        RedisSecretExt["{ap.redis.secretName}<br/>Type: Opaque<br/>Key: REDIS_URL<br/>Provisioned: User"]
        TLSSecret["{ap.tls.secretName}<br/>Type: kubernetes.io/tls<br/>Keys: tls.crt, tls.key<br/>Provisioned: User / cert-manager"]
    end

    subgraph "External Auth Mechanisms"
        RedisAuth["Redis Auth<br/>Password via REDIS_URL env var<br/>(from Secret)"]
        GCPAuth["GCP IAM<br/>Workload Identity or<br/>Service Account Key"]
        mTLSAuth["mTLS Certificates<br/>--tls-cert, --tls-key,<br/>--tls-ca-cert flags"]
        MetricsAuth["Metrics Endpoint Auth<br/>--metrics-endpoint-auth flag<br/>(Optional)"]
    end

    SA -->|"no K8s API access"| NoRBAC
    SA -->|"enforces"| SecCtx
    SA -->|"mounts"| RedisSecret
    SA -->|"mounts"| RedisSecretExt
    SA -->|"mounts"| TLSSecret

    RedisSecret -->|"provides"| RedisAuth
    TLSSecret -->|"provides"| mTLSAuth

    %% Note: No K8s RBAC needed — processor only communicates with external systems
    Note["Note: llm-d-async requires no Kubernetes<br/>API access. It is a pure consumer/producer<br/>service. All auth is to external systems<br/>(Redis, GCP, Inference Gateway)."]

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style NoRBAC fill:#e8e8e8,stroke:#999
    style SecCtx fill:#d5e8d4,stroke:#82b366
    style RedisSecret fill:#f5a623,stroke:#333
    style RedisSecretExt fill:#f5a623,stroke:#333
    style TLSSecret fill:#f5a623,stroke:#333
    style RedisAuth fill:#fff2cc,stroke:#d6b656
    style GCPAuth fill:#fff2cc,stroke:#d6b656
    style mTLSAuth fill:#fff2cc,stroke:#d6b656
    style MetricsAuth fill:#fff2cc,stroke:#d6b656
    style Note fill:#f9f9f9,stroke:#ccc,stroke-dasharray: 5 5
