graph TB
    subgraph External["External Clients"]
        SDK["ML Training Code<br/>(Python SDK)"]
        ClientApp["Client Application"]
        OTelService["OTel-instrumented Service"]
        WorkloadPod["ML Workload Pod"]
    end

    subgraph MLflow["MLflow Server (Port 5000/TCP)"]
        direction TB

        subgraph FastAPILayer["FastAPI Application"]
            direction TB
            Gateway["AI Gateway Router<br/>Multi-provider LLM proxy<br/>(OpenAI/Anthropic/Gemini)"]
            MCPRegistry["MCP Server Registry<br/>Model Context Protocol<br/>server lifecycle"]
            OTelIngestion["OpenTelemetry Ingestion<br/>OTLP/HTTP → MLflow traces"]
            JobEngine["Job Execution Engine<br/>Async jobs via Huey"]
            FastAPISecurity["FastAPI Security Middleware<br/>CORS, Host validation"]
        end

        subgraph FlaskLayer["Flask Application (via WSGIMiddleware)"]
            direction TB
            TrackingAPI["Tracking API<br/>/api/2.0/mlflow/experiments/*<br/>/api/2.0/mlflow/runs/*"]
            ModelRegistry["Model Registry API<br/>/api/2.0/mlflow/registered-models/*<br/>/api/2.0/mlflow/model-versions/*"]
            ArtifactAPI["Artifact API<br/>/api/2.0/mlflow/artifacts/*"]
            AuthModule["Authentication Module<br/>Basic Auth + RBAC"]
            GraphQL["GraphQL API<br/>/graphql"]
        end

        subgraph AuthProviders["Auth Providers"]
            K8sAuth["Kubernetes Auth Provider<br/>SA token + namespace mapping"]
            WorkspaceStore["Workspace Store<br/>Multi-tenancy isolation"]
        end

        SecretsManager["Secrets Manager<br/>AES-GCM-256 encryption<br/>KEK rotation"]
    end

    subgraph WebUI["Web UI"]
        ReactUI["React + TypeScript UI<br/>PatternFly theming<br/>Module Federation"]
    end

    subgraph Backends["Backend Storage"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        S3["S3 / MinIO<br/>443/TCP HTTPS"]
    end

    %% Client connections
    SDK -->|"HTTP 5000/TCP<br/>Bearer Token"| TrackingAPI
    SDK -->|"HTTP 5000/TCP"| ArtifactAPI
    ClientApp -->|"HTTP 5000/TCP<br/>Bearer Token"| Gateway
    OTelService -->|"HTTP 5000/TCP<br/>OTLP/HTTP"| OTelIngestion
    WorkloadPod -->|"HTTP 5000/TCP<br/>SA Token + X-MLFLOW-WORKSPACE"| K8sAuth

    %% Internal flows
    FastAPISecurity --> Gateway
    FastAPISecurity --> MCPRegistry
    FastAPISecurity --> OTelIngestion
    FastAPISecurity --> JobEngine
    AuthModule --> K8sAuth
    K8sAuth --> WorkspaceStore
    Gateway --> SecretsManager

    %% Backend connections
    TrackingAPI --> PostgreSQL
    ModelRegistry --> PostgreSQL
    OTelIngestion --> PostgreSQL
    ArtifactAPI --> S3

    %% UI
    ReactUI -->|"Module Federation"| TrackingAPI

    %% Styling
    style MLflow fill:#e8f4fd,stroke:#4a90e2,stroke-width:3px
    style FastAPILayer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style FlaskLayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style AuthProviders fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Gateway fill:#4a90e2,color:#fff
    style MCPRegistry fill:#4a90e2,color:#fff
    style OTelIngestion fill:#4a90e2,color:#fff
    style JobEngine fill:#4a90e2,color:#fff
    style TrackingAPI fill:#6c8ebf,color:#fff
    style ModelRegistry fill:#6c8ebf,color:#fff
    style ArtifactAPI fill:#6c8ebf,color:#fff
    style AuthModule fill:#6c8ebf,color:#fff
    style K8sAuth fill:#f5a623,color:#fff
    style WorkspaceStore fill:#f5a623,color:#fff
    style SecretsManager fill:#e74c3c,color:#fff
    style PostgreSQL fill:#999,color:#fff
    style S3 fill:#999,color:#fff
    style ReactUI fill:#7ed321,color:#fff
