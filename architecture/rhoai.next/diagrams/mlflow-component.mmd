graph TB
    subgraph MLflowComponent["MLflow Component"]
        direction TB
        Server["mlflow-server<br/>FastAPI/uvicorn<br/>Port 5000/TCP"]
        UI["mlflow-ui<br/>React/TypeScript Frontend"]
        AuthPlugin["kubernetes-auth plugin<br/>SelfSubjectAccessReview"]
        WorkspaceProvider["kubernetes workspace provider<br/>Namespace-to-Workspace mapping"]
        Skinny["mlflow-skinny<br/>Lightweight Client Library"]
        Tracing["mlflow-tracing<br/>Tracing Instrumentation SDK"]
        FS2DB["fs2db<br/>FileStore-to-DB Migration"]

        Server -->|serves| UI
        Server -->|delegates auth| AuthPlugin
        Server -->|resolves workspaces| WorkspaceProvider
    end

    User["Data Scientist"] -->|browser| UI
    SDKClient["MLflow SDK Client"] -->|REST API| Server
    SDKClient -.->|uses| Skinny
    SDKClient -.->|uses| Tracing

    AuthPlugin -->|SelfSubjectAccessReview| K8sAPI["Kubernetes API<br/>6443/TCP"]
    WorkspaceProvider -->|list namespaces<br/>read MLflowConfig| K8sAPI

    Server -->|SQL via SQLAlchemy| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    Server -->|artifacts via boto3| S3["S3-compatible Storage<br/>443/TCP"]

    ODHGateway["ODH Data Science Gateway"] -->|HTTPRoute /mlflow| Server
    ODHDashboard["ODH Dashboard"] -->|module federation| UI
    MLflowOperator["MLflow Operator"] -->|manages Deployment| Server

    style Server fill:#4a90e2,color:#fff
    style UI fill:#4a90e2,color:#fff
    style AuthPlugin fill:#4a90e2,color:#fff
    style WorkspaceProvider fill:#4a90e2,color:#fff
    style Skinny fill:#7bb8f5
    style Tracing fill:#7bb8f5
    style FS2DB fill:#7bb8f5
    style K8sAPI fill:#e8e8e8
    style PostgreSQL fill:#e8e8e8
    style S3 fill:#f5a623
    style ODHGateway fill:#7ed321
    style ODHDashboard fill:#7ed321
    style MLflowOperator fill:#7ed321
