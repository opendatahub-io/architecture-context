graph TB
    subgraph MLflow["MLflow Server (Port 5000)"]
        direction TB

        subgraph FastAPILayer["FastAPI Application Layer"]
            FastAPI["FastAPI App<br/>(create_fastapi_app)"]
            SecurityMW["Security Middleware<br/>CORS / Host Validation / Headers"]
            AuthMW["Auth Middleware<br/>(kubernetes-auth / basic-auth)"]
        end

        subgraph AsyncRoutes["Native Async Routes (FastAPI)"]
            OTLPEndpoint["/otel/v1/traces<br/>OTLP Trace Ingestion"]
            GatewayEndpoint["/gateway/{endpoint}/invocations<br/>AI Gateway"]
            MCPEndpoint["/mcp/servers/{id}/*<br/>MCP Registry"]
            JobsEndpoint["Jobs Manager"]
        end

        subgraph FlaskWSGI["Flask WSGI (Legacy Routes)"]
            WSGIBridge["EfficientWSGIMiddleware"]
            TrackingAPI["/api/2.0/mlflow/*<br/>Tracking Service v2"]
            TrackingAPIv3["/api/3.0/mlflow/*<br/>Service v3"]
            AjaxAPI["/ajax-api/*<br/>UI Ajax Endpoints"]
            GraphQLAPI["/graphql<br/>GraphQL API"]
            ArtifactProxy["/api/2.0/mlflow-artifacts/*<br/>Artifact Proxy"]
            WebhookAPI["/api/2.0/mlflow/webhooks/*<br/>Webhooks"]
        end

        subgraph UI["Web UI"]
            ReactUI["React/TypeScript UI<br/>(Standalone + Module Federation)"]
        end

        subgraph Plugins["Plugins"]
            K8sAuth["mlflow-kubernetes-plugins<br/>Workspace Provider + Auth"]
        end

        FastAPI --> SecurityMW
        SecurityMW --> AuthMW
        AuthMW --> AsyncRoutes
        AuthMW --> WSGIBridge
        WSGIBridge --> FlaskWSGI
    end

    %% External interactions
    Client["ML Training Client<br/>(mlflow SDK)"] -->|"HTTP/HTTPS :5000<br/>kubernetes-auth token"| FastAPI
    Dashboard["RHOAI Dashboard"] -->|"Module Federation<br/>(JS import)"| ReactUI
    K8sAuth -->|"REST API :6443<br/>TokenReview / NS listing"| K8sAPI["Kubernetes API Server"]

    %% Data stores
    FastAPI -->|"PostgreSQL :5432<br/>Username/password"| PostgreSQL["PostgreSQL<br/>Metadata Store"]
    FastAPI -->|"HTTPS :443/9000<br/>AWS IAM / Access Key"| S3["S3-Compatible Storage<br/>Artifact Store"]

    %% AI Gateway egress
    GatewayEndpoint -->|"HTTPS :443<br/>API Key"| LLMProviders["External LLM Providers<br/>(OpenAI, Anthropic, etc.)"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"HTTP scrape :5000"| FastAPI

    %% Operator
    Operator["rhods-operator"] -->|"Manages resources"| MLflow

    %% Styles
    style FastAPI fill:#4a90e2,stroke:#333,color:#fff
    style SecurityMW fill:#e74c3c,stroke:#333,color:#fff
    style AuthMW fill:#e74c3c,stroke:#333,color:#fff
    style WSGIBridge fill:#9b59b6,stroke:#333,color:#fff
    style ReactUI fill:#2ecc71,stroke:#333,color:#fff
    style K8sAuth fill:#f39c12,stroke:#333,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style LLMProviders fill:#999,stroke:#333
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style Operator fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
