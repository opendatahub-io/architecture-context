graph TB
    subgraph "Guardrails Detectors"
        subgraph "Common Library"
            BaseApp["BaseDetectorApp<br/>(FastAPI base class)"]
            Schemas["Pydantic Schemas<br/>(Request/Response)"]
            Metrics["Prometheus<br/>Instrumentator"]
            Health["/health endpoint"]
        end

        subgraph "Built-in Detector (8080/TCP)"
            BuiltInApp["Built-in App"]
            RegexRegistry["RegexDetectorRegistry<br/>(email, CC, SSN, phone, IP)"]
            FileTypeRegistry["FileTypeDetectorRegistry<br/>(JSON, XML, YAML validation)"]
            CustomRegistry["CustomDetectorRegistry<br/>(user-defined Python functions)"]
            ASTValidator["AST Security Validator<br/>(blocks dangerous imports)"]

            BuiltInApp --> RegexRegistry
            BuiltInApp --> FileTypeRegistry
            BuiltInApp --> CustomRegistry
            CustomRegistry --> ASTValidator
        end

        subgraph "HuggingFace Detector (8000/TCP)"
            HFApp["HuggingFace App"]
            SeqClassifier["SequenceClassification<br/>(toxicity, prompt injection)"]
            TokenClassifier["TokenClassification<br/>(NER, span merging)"]
            CausalLM["GraniteForCausalLM<br/>(risk categories)"]

            HFApp --> SeqClassifier
            HFApp --> TokenClassifier
            HFApp --> CausalLM
        end

        subgraph "LLM Judge Detector (8000/TCP)"
            JudgeApp["LLM Judge App"]
            JudgeDetector["Judge Detector<br/>(vllm_judge library)"]
            JudgeApp --> JudgeDetector
        end

        BuiltInApp --> BaseApp
        HFApp --> BaseApp
        JudgeApp --> BaseApp
        BaseApp --> Schemas
        BaseApp --> Metrics
        BaseApp --> Health
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents"| BuiltInApp
    Orchestrator -->|"POST /api/v1/text/contents"| HFApp
    Orchestrator -->|"POST /api/v1/text/contents"| JudgeApp

    KServeInit["KServe Storage<br/>Initializer"] -->|"downloads model"| HFApp
    S3["S3/Minio<br/>Model Storage"] -->|"model files"| KServeInit
    vLLM["vLLM Server<br/>(OpenAI-compatible)"] <-->|"HTTP/8080"| JudgeDetector

    Prometheus["Prometheus"] -->|"scrape /metrics"| Metrics

    style BuiltInApp fill:#4a90e2,color:#fff
    style HFApp fill:#4a90e2,color:#fff
    style JudgeApp fill:#4a90e2,color:#fff
    style BaseApp fill:#6baed6,color:#fff
    style Schemas fill:#6baed6,color:#fff
    style Metrics fill:#6baed6,color:#fff
    style Health fill:#6baed6,color:#fff
    style RegexRegistry fill:#7ed321
    style FileTypeRegistry fill:#7ed321
    style CustomRegistry fill:#7ed321
    style ASTValidator fill:#f5a623
    style SeqClassifier fill:#7ed321
    style TokenClassifier fill:#7ed321
    style CausalLM fill:#7ed321
    style JudgeDetector fill:#7ed321
    style Orchestrator fill:#e8e8e8,stroke:#333
    style KServeInit fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style vLLM fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
