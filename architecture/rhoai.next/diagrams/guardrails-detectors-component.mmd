graph TB
    subgraph GD["Guardrails Detectors"]
        direction TB

        subgraph Common["Common Library (detectors.common)"]
            BaseAPI["DetectorBaseAPI<br/>FastAPI Base App"]
            Schemas["Pydantic Schemas<br/>Request/Response"]
            Instrumented["InstrumentedDetector<br/>Prometheus Metrics"]
        end

        subgraph BuiltIn["Built-in Detector (8080/TCP)"]
            BuiltInApp["FastAPI App"]
            RegexPII["Regex PII Detectors<br/>email, SSN, CC, phone, IP"]
            FileType["File-Type Validators<br/>JSON, XML, YAML + schema"]
            CustomDet["Custom Python Detectors<br/>AST-validated user code"]
            Registry["Detector Registry<br/>/registry endpoint"]
            BuiltInApp --> RegexPII
            BuiltInApp --> FileType
            BuiltInApp --> CustomDet
            BuiltInApp --> Registry
        end

        subgraph HFDetector["HuggingFace Detector (8000/TCP)"]
            HFApp["FastAPI App"]
            SeqClass["Sequence Classification<br/>AutoModelForSequenceClassification"]
            TokenClass["Token Classification<br/>AutoModelForTokenClassification<br/>+ span merging"]
            CausalLM["Causal LM<br/>GraniteForCausalLM"]
            ParamResolver["Parameter Resolver<br/>env → request → model"]
            HFApp --> SeqClass
            HFApp --> TokenClass
            HFApp --> CausalLM
            HFApp --> ParamResolver
        end

        subgraph LLMJudge["LLM Judge Detector (8000/TCP)"]
            JudgeApp["FastAPI App"]
            VLLMJudge["vLLM Judge Library<br/>Built-in + custom metrics"]
            JudgeApp --> VLLMJudge
        end

        BuiltInApp -.->|extends| BaseAPI
        HFApp -.->|extends| BaseAPI
        JudgeApp -.->|extends| BaseAPI
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|POST /api/v1/text/contents<br/>8080/TCP| BuiltInApp
    Orchestrator -->|POST /api/v1/text/contents<br/>8000/TCP| HFApp
    Orchestrator -->|POST /api/v1/text/contents<br/>8000/TCP| JudgeApp

    S3["S3/MinIO<br/>Model Storage"] -.->|model weights<br/>9000/TCP| HFDetector
    ExternalLLM["External vLLM Server<br/>OpenAI-compatible API"] <-->|HTTP evaluation<br/>requests| VLLMJudge

    Prometheus["Prometheus"] -->|scrape /metrics| BuiltIn
    Prometheus -->|scrape /metrics| HFDetector
    Prometheus -->|scrape /metrics| LLMJudge

    KServe["KServe<br/>InferenceService/ServingRuntime"] -.->|lifecycle mgmt| HFDetector
    KServe -.->|lifecycle mgmt| LLMJudge

    style BuiltInApp fill:#4a90e2,color:#fff
    style HFApp fill:#4a90e2,color:#fff
    style JudgeApp fill:#4a90e2,color:#fff
    style BaseAPI fill:#6c5ce7,color:#fff
    style Schemas fill:#6c5ce7,color:#fff
    style Instrumented fill:#6c5ce7,color:#fff
    style Orchestrator fill:#f5a623,color:#fff
    style S3 fill:#e8e8e8,stroke:#333
    style ExternalLLM fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,color:#fff
