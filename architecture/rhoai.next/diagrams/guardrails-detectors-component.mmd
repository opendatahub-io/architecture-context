graph TB
    subgraph GuardrailsDetectors["Guardrails Detectors"]
        subgraph SharedLib["Shared Libraries"]
            BaseAPI["DetectorBaseAPI<br/>/health, /metrics<br/>ASGI lifespan"]
            Instrumented["InstrumentedDetector<br/>Prometheus counters:<br/>trustyai_guardrails_*"]
        end

        subgraph BuiltInDetector["Built-in Detector :8080"]
            BuiltInAPI["FastAPI Service<br/>UID 1001"]
            Registry["BaseDetectorRegistry"]

            subgraph SubRegistries["Sub-Registries"]
                RegexReg["RegexDetectorRegistry<br/>PII: email, CC, SSN, phone, IP<br/>Timeout: REGEX_TIMEOUT"]
                FileTypeReg["FileTypeDetectorRegistry<br/>JSON, XML, YAML<br/>Schema enforcement"]
                CustomReg["CustomDetectorRegistry<br/>Dynamic Python loading<br/>AST sandboxing"]
            end

            BuiltInAPI --> Registry
            Registry --> RegexReg
            Registry --> FileTypeReg
            Registry --> CustomReg
        end

        subgraph HFDetector["HuggingFace Detector :8000"]
            HFAPI["FastAPI Service<br/>GPU capable"]
            ModelLoader["Model Auto-Detection"]

            subgraph ModelTypes["Supported Model Types"]
                SeqClass["Sequence Classification<br/>Per-label thresholds"]
                TokenClass["Token Classification<br/>Offset-mapping spans"]
                CausalLM["Causal LM<br/>Granite Guardian"]
            end

            HFAPI --> ModelLoader
            ModelLoader --> SeqClass
            ModelLoader --> TokenClass
            ModelLoader --> CausalLM
        end

        subgraph JudgeDetector["LLM Judge Detector :8000"]
            JudgeAPI["FastAPI Service<br/>Stateless"]
            JudgeLib["vllm_judge library<br/>Judge.from_url()"]
            Metrics["Built-in Metrics:<br/>safety, toxicity,<br/>accuracy, helpfulness"]

            JudgeAPI --> JudgeLib
            JudgeLib --> Metrics
        end

        BaseAPI -.->|base class| BuiltInAPI
        BaseAPI -.->|base class| HFAPI
        BaseAPI -.->|base class| JudgeAPI
        Instrumented -.->|mixin| BuiltInAPI
        Instrumented -.->|mixin| HFAPI
        Instrumented -.->|mixin| JudgeAPI
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|POST /api/v1/text/contents<br/>8080/TCP| BuiltInAPI
    Orchestrator -->|POST /api/v1/text/contents<br/>8000/TCP| HFAPI
    Orchestrator -->|POST /api/v1/text/contents<br/>POST /api/v1/text/generation<br/>8000/TCP| JudgeAPI

    KServe["KServe"] -->|manages lifecycle| HFDetector
    KServe -->|manages lifecycle| JudgeDetector

    StorageInit["KServe Storage<br/>Initializer"] -->|downloads model<br/>9000/TCP| S3["S3 / MinIO"]
    StorageInit -->|writes to /mnt/models| ModelLoader

    JudgeLib -->|HTTP| vLLM["vLLM Server"]

    Prometheus["Prometheus"] -->|scrapes /metrics| BuiltInAPI
    Prometheus -->|scrapes /metrics| HFAPI

    Istio["Istio Service Mesh"] -.->|mTLS sidecar| HFDetector
    Istio -.->|mTLS sidecar| JudgeDetector

    style BaseAPI fill:#4a90e2,stroke:#333
    style Instrumented fill:#4a90e2,stroke:#333
    style BuiltInAPI fill:#4a90e2,stroke:#333
    style HFAPI fill:#4a90e2,stroke:#333
    style JudgeAPI fill:#4a90e2,stroke:#333
    style Registry fill:#4a90e2,stroke:#333
    style RegexReg fill:#6bb5f0,stroke:#333
    style FileTypeReg fill:#6bb5f0,stroke:#333
    style CustomReg fill:#6bb5f0,stroke:#333
    style ModelLoader fill:#4a90e2,stroke:#333
    style SeqClass fill:#6bb5f0,stroke:#333
    style TokenClass fill:#6bb5f0,stroke:#333
    style CausalLM fill:#6bb5f0,stroke:#333
    style JudgeLib fill:#4a90e2,stroke:#333
    style Metrics fill:#6bb5f0,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style KServe fill:#999,stroke:#333
    style StorageInit fill:#999,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style vLLM fill:#f5a623,stroke:#333
    style Prometheus fill:#999,stroke:#333
