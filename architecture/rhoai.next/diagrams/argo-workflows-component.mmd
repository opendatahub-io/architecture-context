graph TB
    subgraph ArgoWorkflows["Argo Workflows"]
        direction TB

        subgraph ControllerDeployment["workflow-controller (Deployment)"]
            Controller["workflow-controller<br/>Go Controller<br/>Ports: 9090/TCP metrics, 6060/TCP health"]
            LeaderElection["Leader Election<br/>(Kubernetes Lease)"]
            Controller -->|uses| LeaderElection
        end

        subgraph ServerDeployment["argo-server (Deployment, optional)"]
            ArgoServer["argo-server<br/>Go API Server<br/>Port: 2746/TCP"]
            GRPCGateway["gRPC Gateway<br/>REST-to-gRPC Proxy"]
            SSOAuth["SSO/OIDC Auth"]
            ArgoServer -->|proxies| GRPCGateway
            ArgoServer -->|authenticates via| SSOAuth
        end

        ArgoExec["argoexec<br/>Go Sidecar Binary<br/>(injected into workflow pods)"]
        ArgoCLI["argo CLI<br/>Client Binary"]
    end

    %% CRDs
    WorkflowCR["Workflow CR<br/>(argoproj.io/v1alpha1)"]
    WorkflowTemplateCR["WorkflowTemplate CR"]
    CronWorkflowCR["CronWorkflow CR"]
    WorkflowTaskResultCR["WorkflowTaskResult CR"]
    WorkflowTaskSetCR["WorkflowTaskSet CR"]

    %% External interactions
    User["User / DSP API"] -->|creates| WorkflowCR
    User -->|creates| WorkflowTemplateCR
    User -->|creates| CronWorkflowCR
    ArgoCLI -->|submits| WorkflowCR
    ArgoCLI -->|connects to| ArgoServer

    WorkflowCR -->|watched by| Controller
    CronWorkflowCR -->|watched by| Controller
    WorkflowTemplateCR -->|referenced by| Controller

    Controller -->|creates| WorkflowPod["Workflow Step Pod"]
    Controller -->|updates status| WorkflowCR

    ArgoExec -->|injected into| WorkflowPod
    ArgoExec -->|reports via| WorkflowTaskResultCR
    WorkflowTaskResultCR -->|watched by| Controller
    Controller -->|creates| WorkflowTaskSetCR
    WorkflowTaskSetCR -->|watched by| ArgoExec

    ArgoExec -->|uploads/downloads| ArtifactStore["Artifact Store<br/>(S3/MinIO/GCS/Azure)"]
    Controller -->|archives to| SQLDatabase["SQL Database<br/>(MySQL/PostgreSQL)"]
    ArgoServer -->|queries| SQLDatabase

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    ArgoExec -->|depends on| K8sAPI

    DSPOperator["Data Science Pipelines<br/>Operator"] -->|deploys & configures| Controller
    DSPOperator -->|configures image| ArgoExec

    style Controller fill:#4a90e2,color:#fff
    style ArgoServer fill:#4a90e2,color:#fff
    style ArgoExec fill:#4a90e2,color:#fff
    style ArgoCLI fill:#4a90e2,color:#fff
    style WorkflowCR fill:#f5a623,color:#fff
    style WorkflowTemplateCR fill:#f5a623,color:#fff
    style CronWorkflowCR fill:#f5a623,color:#fff
    style WorkflowTaskResultCR fill:#f5a623,color:#fff
    style WorkflowTaskSetCR fill:#f5a623,color:#fff
    style ArtifactStore fill:#e8e8e8
    style SQLDatabase fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style DSPOperator fill:#7ed321,color:#fff
