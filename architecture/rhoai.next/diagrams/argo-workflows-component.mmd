graph TB
    subgraph ArgoWorkflows["Argo Workflows Component"]
        direction TB
        subgraph Controller["workflow-controller"]
            WFC[Workflow Controller<br/>Go Controller<br/>9090/TCP metrics, 6060/TCP health]
            LeaderElect[Leader Election]
            WFC --> LeaderElect
        end

        subgraph Executor["argoexec"]
            AE[Argo Executor<br/>Go Sidecar<br/>Emissary Mode]
            ArtifactMgr[Artifact Manager]
            ProcessProxy[Process Proxy]
            AE --> ArtifactMgr
            AE --> ProcessProxy
        end

        subgraph Server["argo server (bundled in DSP)"]
            AS[Argo Server<br/>gRPC + HTTP API<br/>2746/TCP]
            WebUI[Web UI]
            SSOAuth[SSO/OIDC Auth]
            WebhookHandler[Webhook Handler]
            AS --> WebUI
            AS --> SSOAuth
            AS --> WebhookHandler
        end
    end

    %% CRDs
    subgraph CRDs["Custom Resources (argoproj.io/v1alpha1)"]
        WorkflowCR[Workflow]
        CronWorkflowCR[CronWorkflow]
        WorkflowTemplateCR[WorkflowTemplate]
        ClusterWFTemplateCR[ClusterWorkflowTemplate]
        WorkflowEventBindingCR[WorkflowEventBinding]
        WorkflowTaskSetCR[WorkflowTaskSet]
        WorkflowTaskResultCR[WorkflowTaskResult]
        ArtifactGCTaskCR[WorkflowArtifactGCTask]
    end

    %% External Dependencies
    K8sAPI[Kubernetes API<br/>443/TCP]
    DSPAPI[DSP API Server]
    ArtifactStore[Artifact Storage<br/>S3/GCS/Azure<br/>443/TCP]
    DB[(PostgreSQL/MySQL<br/>5432/3306 TCP)]
    Registry[Container Registry<br/>443/TCP]
    OIDC[OIDC Provider<br/>443/TCP]
    GitProvider[Git Providers<br/>GitHub/GitLab/Bitbucket]

    %% Relationships
    DSPAPI -->|creates| WorkflowCR
    WorkflowCR -->|watched by| WFC
    CronWorkflowCR -->|watched by| WFC
    WorkflowTemplateCR -->|referenced by| WFC
    ClusterWFTemplateCR -->|referenced by| WFC
    WFC -->|creates Pods with| AE
    WFC -->|reconciles via| K8sAPI
    WFC -->|archives to| DB
    WFC -->|manages| ArtifactGCTaskCR
    AE -->|uploads/downloads| ArtifactStore
    AE -->|patches| WorkflowTaskResultCR
    AE -->|reads/writes via| K8sAPI
    WFC -->|image entrypoint lookup| Registry
    AS -->|CRUD operations via| K8sAPI
    SSOAuth -->|token exchange| OIDC
    WebhookHandler -->|receives events from| GitProvider
    WorkflowTaskSetCR -->|managed by| WFC

    %% Styling
    style WFC fill:#4a90e2,stroke:#333,color:#fff
    style AE fill:#4a90e2,stroke:#333,color:#fff
    style AS fill:#4a90e2,stroke:#333,color:#fff
    style WorkflowCR fill:#f5a623,stroke:#333
    style CronWorkflowCR fill:#f5a623,stroke:#333
    style WorkflowTemplateCR fill:#f5a623,stroke:#333
    style ClusterWFTemplateCR fill:#f5a623,stroke:#333
    style WorkflowEventBindingCR fill:#f5a623,stroke:#333
    style WorkflowTaskSetCR fill:#f5a623,stroke:#333
    style WorkflowTaskResultCR fill:#f5a623,stroke:#333
    style ArtifactGCTaskCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style DB fill:#e8e8e8,stroke:#333
    style ArtifactStore fill:#e8e8e8,stroke:#333
    style Registry fill:#e8e8e8,stroke:#333
    style OIDC fill:#e8e8e8,stroke:#333
    style DSPAPI fill:#7ed321,stroke:#333
    style GitProvider fill:#e8e8e8,stroke:#333
