graph TB
    subgraph ArgoWorkflows["Argo Workflows Component"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            Controller["workflow-controller<br/>Go Controller<br/>Ports: 9090 (metrics), 6060 (health)"]
            LeaderElection["Leader Election<br/>(Lease-based)"]
            Controller -->|acquires| LeaderElection
        end

        subgraph ExecutionPlane["Execution Plane (per Workflow Pod)"]
            ArgoExec["argoexec<br/>Emissary Executor<br/>(init + main container)"]
            UserContainer["User Container<br/>(workflow step)"]
            ArgoExec -->|wraps lifecycle| UserContainer
        end

        subgraph ServerOptional["API Server (not shipped in RHOAI)"]
            ArgoServer["argo-server<br/>gRPC + REST + UI<br/>Port: 2746/TCP"]
        end
    end

    %% CRDs
    WorkflowCR["Workflow CR<br/>argoproj.io/v1alpha1"]
    WorkflowTemplateCR["WorkflowTemplate CR"]
    ClusterWFTemplateCR["ClusterWorkflowTemplate CR"]
    CronWorkflowCR["CronWorkflow CR"]
    WorkflowTaskSetCR["WorkflowTaskSet CR"]
    WorkflowTaskResultCR["WorkflowTaskResult CR"]
    ArtifactGCTaskCR["WorkflowArtifactGCTask CR"]

    %% External interactions
    User["User / DSP API"]
    K8sAPI["Kubernetes API<br/>443/TCP"]
    S3["S3-compatible Storage<br/>443/TCP"]
    DB["PostgreSQL / MySQL<br/>5432 / 3306 TCP"]

    %% Flows
    User -->|creates| WorkflowCR
    WorkflowCR -->|watched by| Controller
    WorkflowTemplateCR -->|watched by| Controller
    ClusterWFTemplateCR -->|watched by| Controller
    CronWorkflowCR -->|watched by| Controller

    Controller -->|creates pods via| K8sAPI
    Controller -->|archives to| DB
    Controller -->|manages| WorkflowTaskSetCR
    Controller -->|reads| WorkflowTaskResultCR
    Controller -->|manages| ArtifactGCTaskCR

    ArgoExec -->|collects artifacts| S3
    ArgoExec -->|reports status via| K8sAPI
    ArgoExec -->|writes| WorkflowTaskResultCR

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style ArgoExec fill:#4a90e2,stroke:#333,color:#fff
    style ArgoServer fill:#999,stroke:#333,color:#fff
    style WorkflowCR fill:#f5a623,stroke:#333
    style WorkflowTemplateCR fill:#f5a623,stroke:#333
    style ClusterWFTemplateCR fill:#f5a623,stroke:#333
    style CronWorkflowCR fill:#f5a623,stroke:#333
    style WorkflowTaskSetCR fill:#f5a623,stroke:#333
    style WorkflowTaskResultCR fill:#f5a623,stroke:#333
    style ArtifactGCTaskCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style DB fill:#e8e8e8,stroke:#333
    style User fill:#7ed321,stroke:#333
