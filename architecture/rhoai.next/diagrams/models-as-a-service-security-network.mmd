graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(Data Scientist / Application)"]
    end

    subgraph Ingress["INGRESS (Gateway API - TLS Termination)"]
        Gateway["maas-default-gateway<br/>Namespace: openshift-ingress<br/>443/TCP → HTTPRoute routing<br/>TLS 1.2+ Terminate<br/>Cert: ${CERT_NAME}"]

        subgraph ExtProc["Envoy Filter Chain (ext_proc)"]
            PreProc["payload-pre-processing<br/>9004/TCP gRPC<br/>plaintext (mesh)<br/>Model name extraction"]
            PostProc["payload-processing<br/>9004/TCP gRPC<br/>plaintext (mesh)<br/>API translation +<br/>credential injection<br/>⚠ insecureSkipVerify"]
        end

        AuthorinoWasm["Kuadrant Authorino<br/>(WasmPlugin)<br/>TokenReview + API key validation<br/>CEL-based per-model AuthPolicy"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio)"]
        direction TB

        subgraph NS_Infra["Namespace: {infra-namespace}"]
            MaaSAPI["maas-api<br/>SA: maas-api<br/>8080/TCP HTTP (internal)<br/>8443/TCP HTTPS (public)<br/>9090/TCP HTTP (metrics)"]
            CronJob["maas-api-cleanup CronJob<br/>SA: maas-api<br/>Image: UBI minimal"]
        end

        subgraph NS_Controller["Namespace: {controller-namespace}"]
            Controller["maas-controller<br/>SA: maas-controller<br/>8080/TCP (metrics)<br/>8081/TCP (health)<br/>9443/TCP HTTPS (webhook)"]
        end

        subgraph NS_Models["Namespace: {user-namespace}"]
            KServeBackend["KServe LLMInferenceService<br/>80/443 TCP<br/>HTTP/HTTPS (mesh)"]
        end

        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (optional)<br/>Auth: Connection URL"]

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ExtProviders["External Model Providers<br/>(api.openai.com, etc.)<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: API Key (injected)"]
        Loki["Loki<br/>8080/TCP HTTPS<br/>TLS (service CA)<br/>Auth: SA Bearer Token"]
        OTLP["OTLP Endpoint<br/>4317/TCP gRPC<br/>Configurable TLS"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (OIDC)<br/>or API Key (sk-oai-*)"| Gateway

    %% Ingress internal flow
    Gateway -->|"gRPC/9004<br/>plaintext"| PreProc
    PreProc -.->|headers set| AuthorinoWasm
    AuthorinoWasm -->|"HTTP/8080<br/>NetworkPolicy"| MaaSAPI
    AuthorinoWasm -.->|auth result| PostProc
    Gateway -->|"gRPC/9004<br/>plaintext"| PostProc

    %% Gateway → backends
    Gateway -->|"HTTP(S)/80,443<br/>mTLS (mesh)"| KServeBackend
    PostProc -->|"HTTPS/443<br/>TLS 1.2+<br/>Injected API Key"| ExtProviders

    %% Internal flows
    MaaSAPI -->|"TCP/5432<br/>TLS (optional)<br/>Connection URL"| PostgreSQL
    MaaSAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    CronJob -->|"HTTP/8080<br/>NetworkPolicy"| MaaSAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Observability
    MaaSAPI -.->|"gRPC/4317"| OTLP
    MaaSAPI -.->|"HTTPS/8080<br/>Usage logs"| Loki

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px

    class Client external
    class Gateway,PreProc,PostProc,AuthorinoWasm ingress
    class MaaSAPI,CronJob,Controller,KServeBackend,PostgreSQL,K8sAPI servicemesh
    class ExtProviders,Loki,OTLP externalservice
