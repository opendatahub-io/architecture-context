graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API / Istio)"]
        Gateway["Istio Gateway<br/>(maas-default-gateway)<br/>443/TCP → 8443/TCP<br/>TLS 1.2+ (SIMPLE)<br/>HTTPRoute per tenant"]
        Authorino["Kuadrant/Authorino<br/>AuthPolicy Evaluation<br/>P0: API key (sk-oai-*)<br/>P1: OpenShift TokenReview<br/>Strips Auth, injects identity headers"]
    end

    subgraph Internal["INTERNAL (NetworkPolicy Enforced)"]
        direction TB

        subgraph NS_Controller["Namespace: opendatahub"]
            Controller["maas-controller<br/>SA: maas-controller<br/>:8081/TCP health<br/>:8443/TCP metrics (TLS)"]
            ControllerWebhook["Validating Webhook<br/>failurePolicy: Fail<br/>AITenant, MaaSAuthPolicy,<br/>MaaSModelRef, MaaSSubscription"]
            Discovery["maas-discovery (x2)<br/>SA: maas-discovery<br/>:8443/TCP HTTPS<br/>readOnlyRootFilesystem"]
        end

        subgraph NS_Tenant["Namespace: {tenant-infra} (per-tenant)"]
            MaaSAPI["maas-api (per-tenant)<br/>SA: maas-api<br/>:8080/TCP HTTP<br/>:8443/TCP HTTPS (service-ca)<br/>:9090/TCP metrics (TLS)"]
            CleanupJob["API Key Cleanup<br/>CronJob"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Configurable encryption<br/>Secret: maas-db-config"]
        ModelProviders["External Model Providers<br/>(OpenAI, Azure, etc.)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Per-model credentialRef"]
        OTLP["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Configurable"]
    end

    subgraph DSGateway["DISCOVERY INGRESS"]
        DataScienceGW["data-science-gateway<br/>8443/TCP HTTPS"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>API key / OpenShift token"| Gateway
    Gateway -->|"AuthPolicy eval"| Authorino
    Authorino -->|"HTTPS/8443<br/>API key validate callback"| MaaSAPI

    %% Gateway to backend (TLS gap)
    Gateway -->|"HTTPS/8443<br/>TLS (insecureSkipVerify!)<br/>RHOAIENG-61070"| MaaSAPI

    %% Internal flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    MaaSAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    MaaSAPI -->|"TCP/5432<br/>Secret auth"| PostgreSQL
    MaaSAPI -->|"OTLP/gRPC"| OTLP

    %% Model traffic
    Gateway -->|"HTTPS/443<br/>TLS 1.2+<br/>credentialRef"| ModelProviders

    %% Discovery
    DataScienceGW -->|"HTTPS/8443<br/>TLS"| Discovery

    %% Controller deploys per-tenant
    Controller -.->|"deploys (kustomize)"| MaaSAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway,Authorino ingress
    class Controller,ControllerWebhook,MaaSAPI,Discovery,CleanupJob internal
    class K8sAPI,PostgreSQL,ModelProviders,OTLP externalservice
    class DataScienceGW ingress
