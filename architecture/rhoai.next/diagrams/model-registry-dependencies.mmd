graph LR
    MR["Model Registry<br/>Platform"]

    %% External Dependencies (Required)
    MR -->|"metadata storage<br/>TCP/5432"| PostgreSQL["PostgreSQL<br/>16-alpine / 17.6"]
    MR -.->|"alt metadata storage<br/>TCP/3306"| MySQL["MySQL<br/>(alternative)"]

    %% External Dependencies (Optional per sub-component)
    MR -->|"InferenceService CRD watch<br/>(controller only)"| KServeCRD["KServe<br/>InferenceService CRD<br/>v1beta1"]
    MR -->|"storage provider registration<br/>(CSI only)"| KServeCSC["KServe<br/>ClusterStorageContainer<br/>v1alpha1"]
    MR -->|"model catalog sync<br/>HTTPS/443"| HuggingFace["HuggingFace API<br/>v1"]
    MR -->|"image signing<br/>HTTPS/443"| Cosign["cosign<br/>(RHTAS)"]
    MR -->|"image push/pull<br/>(async-upload)"| Skopeo["skopeo"]

    %% Internal Platform Dependencies
    MR -->|"mTLS + AuthZ<br/>VirtualService, DestinationRule"| Istio["Istio Service Mesh"]
    MR -->|"CRD watch + storage provider"| KServe["KServe"]
    MR -->|"UI routing<br/>/model-registry/ prefix"| Dashboard["Kubeflow Dashboard"]

    %% Integration Points (inbound)
    Dashboard -->|"VirtualService routing"| MR
    Prometheus["Prometheus"] -->|"metrics scrape<br/>HTTPS/8443"| MR

    %% Integration Points (outbound)
    MR -->|"model storage<br/>HTTPS/443"| S3["S3 Storage"]
    MR -->|"OCI artifacts<br/>HTTPS/443"| OCI["OCI Registry"]
    MR -->|"model signing<br/>HTTPS/443"| Sigstore["Sigstore<br/>(Fulcio/Rekor/TUF)"]
    MR -->|"resource mgmt<br/>HTTPS/443"| K8sAPI["Kubernetes API"]

    %% Styling
    style MR fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style MySQL fill:#f5a623,stroke:#333,stroke-dasharray: 5 5,color:#fff

    %% Optional external
    style KServeCRD fill:#999,stroke:#333,color:#fff
    style KServeCSC fill:#999,stroke:#333,color:#fff
    style HuggingFace fill:#999,stroke:#333,color:#fff
    style Cosign fill:#999,stroke:#333,color:#fff
    style Skopeo fill:#999,stroke:#333,color:#fff

    %% Internal platform
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% Monitoring
    style Prometheus fill:#e74c3c,stroke:#333,color:#fff

    %% External services
    style S3 fill:#e67e22,stroke:#333,color:#fff
    style OCI fill:#e67e22,stroke:#333,color:#fff
    style Sigstore fill:#e74c3c,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
