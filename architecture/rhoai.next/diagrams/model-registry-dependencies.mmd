graph LR
    MR["Model Registry<br/>(6 sub-components)"]

    %% External Dependencies
    subgraph ExtDeps["External Dependencies"]
        MySQL[("MySQL 8.3+")]
        PostgreSQL[("PostgreSQL 16+")]
        KServe["KServe v0.17.0-rc1"]
        CtrlRuntime["controller-runtime v0.22.4"]
        GORM["GORM v1.31.2"]
        Chi["go-chi/chi v5.3.1"]
        CobraViper["Cobra v1.10.2 /<br/>Viper v1.21.0"]
    end

    %% Python Dependencies (async-upload)
    subgraph PyDeps["Python Dependencies (async-upload)"]
        MRPython["model-registry >= 0.3.7<br/>(Python client)"]
        RHModelSigning["rh-model-signing >= 1.0.1"]
        HFHub["huggingface-hub ^1.16.4"]
        Boto3["boto3<br/>(via model-registry)"]
        Cosign["cosign<br/>(from RHTAS image)"]
    end

    %% Core server dependencies
    MR -->|"metadata storage<br/>(default)"| MySQL
    MR -->|"metadata storage<br/>(alternative) + catalog"| PostgreSQL
    MR -->|"HTTP router"| Chi
    MR -->|"ORM"| GORM
    MR -->|"CLI framework"| CobraViper

    %% Controller dependencies
    MR -->|"ISVC reconciliation"| KServe
    MR -->|"K8s controller framework"| CtrlRuntime

    %% Python dependencies
    MR -->|"Python client lib"| MRPython
    MR -->|"model signing"| RHModelSigning
    MR -->|"model downloads"| HFHub
    MR -->|"S3 operations"| Boto3
    MR -->|"image verification"| Cosign

    %% Internal Platform Dependencies
    subgraph IntDeps["Internal Platform Dependencies"]
        KServeInt["KServe<br/>(CRD Watch: InferenceService)"]
        KServeCSI["KServe<br/>(ClusterStorageContainer CR)"]
        Dashboard["RHOAI Dashboard<br/>(REST API consumer)"]
        Istio["Istio Service Mesh<br/>(AuthZ, DestinationRule,<br/>VirtualService)"]
        PlatformDB["Platform Database<br/>(MySQL/PostgreSQL)"]
    end

    MR -->|"watches ISVCs"| KServeInt
    MR -->|"registers URI handler"| KServeCSI
    Istio -->|"mTLS + AuthZ"| MR
    Dashboard -->|"UI access via BFF"| MR
    MR -->|"SQL connection"| PlatformDB

    %% External Services (Egress)
    subgraph ExtServices["External Services (Egress)"]
        S3["S3 Storage<br/>443/TCP"]
        OCI["OCI Registry<br/>443/TCP"]
        HuggingFace["HuggingFace Hub<br/>443/TCP"]
        Sigstore["Sigstore<br/>443/TCP"]
        K8sAPI["Kubernetes API<br/>443/TCP"]
    end

    MR -->|"model artifacts"| S3
    MR -->|"OCI push"| OCI
    MR -->|"model download"| HuggingFace
    MR -->|"artifact signing"| Sigstore
    MR -->|"service discovery,<br/>SubjectAccessReview"| K8sAPI

    %% Integration consumers
    subgraph Consumers["Integration Consumers"]
        DSPipelines["Data Science Pipelines<br/>(potential consumer)"]
    end

    DSPipelines -.->|"model deployment"| MR

    %% Styling
    style MR fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MySQL fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style CtrlRuntime fill:#e8e8e8,stroke:#333
    style GORM fill:#e8e8e8,stroke:#333
