graph TD
    subgraph ServiceAccounts["Service Accounts (namespace: kubeflow)"]
        SA_Pipeline["ml-pipeline"]
        SA_PA["ml-pipeline-<br/>persistenceagent"]
        SA_SWF["ml-pipeline-<br/>scheduledworkflow"]
        SA_Viewer["ml-pipeline-<br/>viewer-crd-sa"]
        SA_Cache["kubeflow-pipelines-<br/>cache"]
        SA_CacheDeployer["kubeflow-pipelines-<br/>cache-deployer-sa"]
    end

    subgraph RoleBindings["Role Bindings (namespace: kubeflow)"]
        RB_Pipeline["ml-pipeline"]
        RB_PA["ml-pipeline-<br/>persistenceagent-binding"]
        RB_SWF["ml-pipeline-<br/>scheduledworkflow-binding"]
        RB_Viewer["ml-pipeline-<br/>viewer-crd-binding"]
        RB_Cache["kubeflow-pipelines-<br/>cache-binding"]
        RB_CacheDeployer["kubeflow-pipelines-<br/>cache-deployer-binding"]
    end

    subgraph ClusterRoleBindings["Cluster Role Binding"]
        CRB_CacheDeployer["cache-deployer<br/>ClusterRoleBinding"]
    end

    subgraph ClusterRolePerms["ClusterRole: kubeflow-pipelines-cache-deployer-clusterrole"]
        CR_CSR["certificates.k8s.io<br/>certificatesigningrequests<br/>csr/approval<br/>→ create, delete, get, update"]
        CR_Webhook["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations<br/>→ create, delete, get, list, patch"]
        CR_Signers["certificates.k8s.io<br/>signers<br/>→ approve"]
    end

    subgraph Roles["Namespace Roles"]
        Role_Pipeline["ml-pipeline<br/>(Role)"]
        Role_PA["ml-pipeline-<br/>persistenceagent-role"]
        Role_SWF["ml-pipeline-<br/>scheduledworkflow-role"]
        Role_Viewer["ml-pipeline-<br/>viewer-crd-role"]
        Role_Cache["kubeflow-pipelines-<br/>cache-role"]
        Role_CacheDeployer["kubeflow-pipelines-<br/>cache-deployer-role"]
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        TokenReview["TokenReview<br/>audience: pipelines.kubeflow.org"]
        SAR["SubjectAccessReview<br/>per resource/verb"]
        HTTPHeader["HTTP Header Auth<br/>kubeflow-user header<br/>(multi-user mode)"]
    end

    %% SA → RoleBinding → Role
    SA_Pipeline -->|"bound via"| RB_Pipeline
    RB_Pipeline -->|"grants"| Role_Pipeline

    SA_PA -->|"bound via"| RB_PA
    RB_PA -->|"grants"| Role_PA

    SA_SWF -->|"bound via"| RB_SWF
    RB_SWF -->|"grants"| Role_SWF

    SA_Viewer -->|"bound via"| RB_Viewer
    RB_Viewer -->|"grants"| Role_Viewer

    SA_Cache -->|"bound via"| RB_Cache
    RB_Cache -->|"grants"| Role_Cache

    SA_CacheDeployer -->|"bound via"| RB_CacheDeployer
    RB_CacheDeployer -->|"grants"| Role_CacheDeployer

    %% ClusterRole for cache deployer
    SA_CacheDeployer -->|"bound via"| CRB_CacheDeployer
    CRB_CacheDeployer -->|"grants"| CR_CSR
    CRB_CacheDeployer -->|"grants"| CR_Webhook
    CRB_CacheDeployer -->|"grants"| CR_Signers

    %% Auth mechanisms used by API Server
    SA_Pipeline -->|"uses"| TokenReview
    TokenReview -->|"validates bearer tokens"| SAR
    HTTPHeader -->|"identifies user"| SAR

    %% Styling
    style SA_Pipeline fill:#4a90e2,stroke:#333,color:#fff
    style SA_PA fill:#4a90e2,stroke:#333,color:#fff
    style SA_SWF fill:#4a90e2,stroke:#333,color:#fff
    style SA_Viewer fill:#4a90e2,stroke:#333,color:#fff
    style SA_Cache fill:#4a90e2,stroke:#333,color:#fff
    style SA_CacheDeployer fill:#4a90e2,stroke:#333,color:#fff

    style Role_Pipeline fill:#f5a623,stroke:#333
    style Role_PA fill:#f5a623,stroke:#333
    style Role_SWF fill:#f5a623,stroke:#333
    style Role_Viewer fill:#f5a623,stroke:#333
    style Role_Cache fill:#f5a623,stroke:#333
    style Role_CacheDeployer fill:#f5a623,stroke:#333

    style CR_CSR fill:#e06666,stroke:#333,color:#fff
    style CR_Webhook fill:#e06666,stroke:#333,color:#fff
    style CR_Signers fill:#e06666,stroke:#333,color:#fff

    style TokenReview fill:#7ed321,stroke:#333,color:#fff
    style SAR fill:#7ed321,stroke:#333,color:#fff
    style HTTPHeader fill:#7ed321,stroke:#333,color:#fff
