graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["ml-pipeline"]
        SA_PA["ml-pipeline-persistenceagent"]
        SA_SWF["ml-pipeline-scheduledworkflow"]
        SA_Viewer["ml-pipeline-viewer-crd-<br/>service-account"]
        SA_Runner["pipeline-runner"]
    end

    subgraph RoleBindings["ClusterRole Bindings"]
        CRB_API["ml-pipeline"]
        CRB_PA["ml-pipeline-persistenceagent-<br/>binding"]
        CRB_SWF["ml-pipeline-scheduledworkflow-<br/>binding"]
        CRB_Viewer["ml-pipeline-viewer-crd-<br/>binding"]
        CRB_Runner["pipeline-runner-binding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_API["ml-pipeline"]
        CR_PA["ml-pipeline-persistenceagent-<br/>role"]
        CR_SWF["ml-pipeline-scheduledworkflow-<br/>role"]
        CR_Viewer["ml-pipeline-viewer-controller-<br/>role"]
        CR_Runner["pipeline-runner"]
    end

    subgraph Resources_API["ml-pipeline Resources"]
        R_Pods["core<br/>pods, pods/log<br/>get, list, delete"]
        R_Workflows["argoproj.io<br/>workflows<br/>create, get, list, watch,<br/>update, patch, delete"]
        R_SWF_API["kubeflow.org<br/>scheduledworkflows,<br/>scheduledworkflows/finalizers<br/>create, get, list, update,<br/>patch, delete"]
        R_Pipelines["pipelines.kubeflow.org<br/>pipelines<br/>get, list, watch"]
        R_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        R_TR["authentication.k8s.io<br/>tokenreviews<br/>create"]
        R_CM["core<br/>configmaps (kfp-launcher)<br/>get"]
    end

    subgraph Resources_PA["persistenceagent Resources"]
        R_PA_WF["argoproj.io<br/>workflows<br/>get, list, watch"]
        R_PA_SWF["kubeflow.org<br/>scheduledworkflows<br/>get, list, watch"]
    end

    subgraph Resources_SWF["scheduledworkflow Resources"]
        R_SWF_WF["argoproj.io<br/>workflows<br/>create, get, list, watch,<br/>update, patch, delete"]
        R_SWF_SWF["kubeflow.org<br/>scheduledworkflows,<br/>scheduledworkflows/finalizers<br/>create, get, list, watch,<br/>update, patch, delete"]
        R_SWF_Runs["pipelines.kubeflow.org<br/>runs<br/>create"]
        R_SWF_Events["core<br/>events<br/>create, patch"]
    end

    subgraph Resources_Runner["pipeline-runner Resources"]
        R_Run_Secrets["core<br/>secrets<br/>get"]
        R_Run_CM["core<br/>configmaps<br/>get, watch, list"]
        R_Run_PV["core<br/>persistentvolumes,<br/>persistentvolumeclaims<br/>*"]
        R_Run_Pods["core<br/>pods, pods/exec,<br/>pods/log, services<br/>*"]
        R_Run_WF["argoproj.io<br/>workflows,<br/>workflowtaskresults<br/>get, list, watch,<br/>update, patch, create"]
        R_Run_KF["kubeflow.org<br/>*<br/>*"]
        R_Run_Batch["batch<br/>jobs<br/>*"]
    end

    %% Bindings
    SA_API -->|"bound via"| CRB_API
    SA_PA -->|"bound via"| CRB_PA
    SA_SWF -->|"bound via"| CRB_SWF
    SA_Viewer -->|"bound via"| CRB_Viewer
    SA_Runner -->|"bound via"| CRB_Runner

    CRB_API -->|"grants"| CR_API
    CRB_PA -->|"grants"| CR_PA
    CRB_SWF -->|"grants"| CR_SWF
    CRB_Viewer -->|"grants"| CR_Viewer
    CRB_Runner -->|"grants"| CR_Runner

    %% Role to resources
    CR_API --> R_Pods
    CR_API --> R_Workflows
    CR_API --> R_SWF_API
    CR_API --> R_Pipelines
    CR_API --> R_SAR
    CR_API --> R_TR
    CR_API --> R_CM

    CR_PA --> R_PA_WF
    CR_PA --> R_PA_SWF

    CR_SWF --> R_SWF_WF
    CR_SWF --> R_SWF_SWF
    CR_SWF --> R_SWF_Runs
    CR_SWF --> R_SWF_Events

    CR_Runner --> R_Run_Secrets
    CR_Runner --> R_Run_CM
    CR_Runner --> R_Run_PV
    CR_Runner --> R_Run_Pods
    CR_Runner --> R_Run_WF
    CR_Runner --> R_Run_KF
    CR_Runner --> R_Run_Batch

