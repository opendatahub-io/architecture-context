graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["ml-pipeline"]
        SA_PA["ml-pipeline-persistenceagent"]
        SA_SW["ml-pipeline-scheduledworkflow"]
        SA_UI["ml-pipeline-ui"]
        SA_Viewer["ml-pipeline-viewer-crd-service-account"]
        SA_Runner["pipeline-runner"]
        SA_MW["kubeflow-pipelines-metadata-writer"]
        SA_Cache["kubeflow-pipelines-cache"]
        SA_CacheDeploy["kubeflow-pipelines-cache-deployer-sa"]
        SA_Auth["system:authenticated"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_API["ml-pipeline"]
        RB_PA["ml-pipeline-persistenceagent-binding"]
        RB_SW["ml-pipeline-scheduledworkflow-binding"]
        RB_UI["ml-pipeline-ui"]
        RB_Viewer["ml-pipeline-viewer-crd-binding"]
        RB_Runner["pipeline-runner-binding"]
        RB_MW["kubeflow-pipelines-metadata-writer-binding"]
        RB_Cache["kubeflow-pipelines-cache-binding"]
        RB_CacheDeploy["kubeflow-pipelines-cache-deployer-rolebinding"]
        RB_Public["kubeflow-pipelines-public"]
    end

    subgraph Roles["Cluster Roles"]
        CR_API["ml-pipeline"]
        CR_PA["ml-pipeline-persistenceagent-role"]
        CR_SW["ml-pipeline-scheduledworkflow-role"]
        CR_UI["ml-pipeline-ui"]
        CR_Runner["pipeline-runner"]
        CR_Cache["kubeflow-pipelines-cache-role"]
        CR_CacheDeploy["kubeflow-pipelines-cache-deployer-role"]
    end

    subgraph Resources_API["ml-pipeline Resources"]
        R_Pods["pods, pods/log<br/>get, list, delete"]
        R_Workflows["argoproj.io/workflows<br/>create, get, list, watch,<br/>update, patch, delete"]
        R_SW_API["kubeflow.org/scheduledworkflows<br/>+ finalizers<br/>create, get, list, update,<br/>patch, delete"]
        R_Pipelines["pipelines.kubeflow.org<br/>pipelines, pipelineversions<br/>+ status, finalizers<br/>create, get, list, watch,<br/>update, patch, delete"]
        R_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        R_TR["authentication.k8s.io<br/>tokenreviews<br/>create"]
    end

    subgraph Resources_PA["Persistence Agent Resources"]
        R_PA_WF["argoproj.io/workflows<br/>get, list, watch"]
        R_PA_SW["kubeflow.org/scheduledworkflows<br/>get, list, watch"]
    end

    subgraph Resources_SW["Scheduled Workflow Resources"]
        R_SW_WF["argoproj.io/workflows<br/>create, get, list, watch,<br/>update, patch, delete"]
        R_SW_SW["kubeflow.org/scheduledworkflows<br/>+ finalizers<br/>create, get, list, watch,<br/>update, patch, delete"]
    end

    subgraph Resources_Runner["Pipeline Runner Resources"]
        R_Runner_Pods["pods, pods/exec, pods/log<br/>services, PVCs, PVs<br/>verbs: *"]
        R_Runner_WF["argoproj.io/workflows<br/>workflowtaskresults<br/>get, list, watch, update,<br/>patch, create"]
        R_Runner_Jobs["batch/jobs<br/>verbs: *"]
    end

    subgraph Resources_Cache["Cache Resources"]
        R_Cache_Pods["pods<br/>get, list, watch, update, patch"]
        R_Cache_WF["argoproj.io/workflows<br/>get, list, watch, update, patch"]
    end

    %% SA to RoleBinding
    SA_API -->|"bound via"| RB_API
    SA_PA -->|"bound via"| RB_PA
    SA_SW -->|"bound via"| RB_SW
    SA_UI -->|"bound via"| RB_UI
    SA_Viewer -->|"bound via"| RB_Viewer
    SA_Runner -->|"bound via"| RB_Runner
    SA_MW -->|"bound via"| RB_MW
    SA_Cache -->|"bound via"| RB_Cache
    SA_CacheDeploy -->|"bound via"| RB_CacheDeploy
    SA_Auth -->|"bound via"| RB_Public

    %% RoleBinding to Role
    RB_API -->|"grants"| CR_API
    RB_PA -->|"grants"| CR_PA
    RB_SW -->|"grants"| CR_SW
    RB_UI -->|"grants"| CR_UI
    RB_Runner -->|"grants"| CR_Runner
    RB_Cache -->|"grants"| CR_Cache
    RB_CacheDeploy -->|"grants"| CR_CacheDeploy

    %% Role to Resources
    CR_API -->|"access"| R_Pods
    CR_API -->|"access"| R_Workflows
    CR_API -->|"access"| R_SW_API
    CR_API -->|"access"| R_Pipelines
    CR_API -->|"access"| R_SAR
    CR_API -->|"access"| R_TR

    CR_PA -->|"access"| R_PA_WF
    CR_PA -->|"access"| R_PA_SW

    CR_SW -->|"access"| R_SW_WF
    CR_SW -->|"access"| R_SW_SW

    CR_Runner -->|"access"| R_Runner_Pods
    CR_Runner -->|"access"| R_Runner_WF
    CR_Runner -->|"access"| R_Runner_Jobs

    CR_Cache -->|"access"| R_Cache_Pods
    CR_Cache -->|"access"| R_Cache_WF

