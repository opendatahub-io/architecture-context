graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Op["openshift-kueue-operator<br/>(ns: openshift-kueue-operator)"]
        SA_Ctrl["kueue-controller-manager<br/>(ns: kueue-system)"]
    end

    subgraph BindingsOp["Operator Bindings"]
        CRB_Op["openshift-kueue-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph BindingsCtrl["Controller Bindings"]
        CRB_Mgr["kueue-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Metrics["kueue-metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Proxy["kueue-proxy-rolebinding<br/>(ClusterRoleBinding)"]
        RB_Leader["kueue-leader-election-rolebinding<br/>(RoleBinding, ns: kueue-system)"]
        RB_AuthReader["kueue-visibility-server-auth-reader<br/>(RoleBinding, ns: kube-system)"]
    end

    subgraph RolesOp["Operator ClusterRole"]
        CR_Op["openshift-kueue-operator"]
    end

    subgraph RolesCtrl["Controller Roles"]
        CR_Mgr["kueue-manager-role<br/>(ClusterRole)"]
        CR_MetricsAuth["kueue-metrics-auth-role<br/>(ClusterRole)"]
        CR_Proxy["kueue-proxy-role<br/>(ClusterRole)"]
        R_Leader["kueue-leader-election-role<br/>(Role, ns: kueue-system)"]
        R_AuthReader["extension-apiserver-authentication-reader<br/>(Role, ns: kube-system)"]
        CR_MetricsReader["kueue-metrics-reader<br/>(ClusterRole)"]
    end

    subgraph OperatorResources["Operator-Managed Resources"]
        Res_Kueue["kueue.openshift.io<br/>kueues, kueues/status"]
        Res_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        Res_Apps["apps<br/>deployments, replicasets"]
        Res_Admission["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations,<br/>validatingwebhookconfigurations"]
        Res_CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Res_CertMgr["cert-manager.io<br/>certificates, issuers"]
        Res_Monitor["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph ControllerResources["Controller-Managed Resources"]
        Res_Queue["kueue.x-k8s.io<br/>admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads"]
        Res_Batch["batch<br/>jobs"]
        Res_Kubeflow["kubeflow.org<br/>mpijobs, paddlejobs, pytorchjobs,<br/>tfjobs, xgboostjobs"]
        Res_Ray["ray.io<br/>rayclusters, rayjobs"]
        Res_CodeFlare["workload.codeflare.dev<br/>appwrappers"]
        Res_JobSet["jobset.x-k8s.io<br/>jobsets"]
        Res_LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets"]
        Res_Metrics["/metrics<br/>(non-resource URL)"]
    end

    %% Operator chain
    SA_Op -->|bound via| CRB_Op
    CRB_Op -->|grants| CR_Op
    CR_Op -->|"CRUD + escalate"| Res_Kueue
    CR_Op -->|"CRUD + bind + escalate"| Res_RBAC
    CR_Op -->|CRUD| Res_Apps
    CR_Op -->|CRUD| Res_Admission
    CR_Op -->|CRUD| Res_CRDs
    CR_Op -->|CRUD| Res_CertMgr
    CR_Op -->|CRUD| Res_Monitor

    %% Controller chain
    SA_Ctrl -->|bound via| CRB_Mgr
    SA_Ctrl -->|bound via| CRB_Metrics
    SA_Ctrl -->|bound via| CRB_Proxy
    SA_Ctrl -->|bound via| RB_Leader
    SA_Ctrl -->|bound via| RB_AuthReader
    CRB_Mgr -->|grants| CR_Mgr
    CR_Mgr -->|"CRUD"| Res_Queue
    CR_Mgr -->|"get,list,patch,update,watch"| Res_Batch
    CR_Mgr -->|"get,list,patch,update,watch"| Res_Kubeflow
    CR_Mgr -->|"get,list,patch,update,watch"| Res_Ray
    CR_Mgr -->|"get,list,patch,update,watch"| Res_CodeFlare
    CR_Mgr -->|"get,list,patch,update,watch"| Res_JobSet
    CR_Mgr -->|"get,list,watch"| Res_LWS
    CR_MetricsReader -->|"get"| Res_Metrics

    %% Styling
    style SA_Op fill:#4a90e2,stroke:#333,color:#fff
    style SA_Ctrl fill:#4a90e2,stroke:#333,color:#fff
    style CR_Op fill:#f5a623,stroke:#333
    style CR_Mgr fill:#f5a623,stroke:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style R_AuthReader fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style Res_Kueue fill:#7ed321,stroke:#333
    style Res_RBAC fill:#7ed321,stroke:#333
    style Res_Apps fill:#7ed321,stroke:#333
    style Res_Admission fill:#7ed321,stroke:#333
    style Res_CRDs fill:#7ed321,stroke:#333
    style Res_CertMgr fill:#7ed321,stroke:#333
    style Res_Monitor fill:#7ed321,stroke:#333
    style Res_Queue fill:#7ed321,stroke:#333
    style Res_Batch fill:#7ed321,stroke:#333
    style Res_Kubeflow fill:#7ed321,stroke:#333
    style Res_Ray fill:#7ed321,stroke:#333
    style Res_CodeFlare fill:#7ed321,stroke:#333
    style Res_JobSet fill:#7ed321,stroke:#333
    style Res_LWS fill:#7ed321,stroke:#333
    style Res_Metrics fill:#7ed321,stroke:#333
