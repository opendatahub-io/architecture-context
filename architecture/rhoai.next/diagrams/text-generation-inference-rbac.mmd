graph TD
    subgraph PodSecurity["Pod Security Context"]
        SecurityCtx["Security Context<br/>runAsNonRoot: true<br/>capabilities: drop ALL<br/>seccompProfile: RuntimeDefault"]
    end

    subgraph ContainerUser["Container User"]
        User["tgis (UID 2000)<br/>Non-root user"]
    end

    subgraph NoRBAC["Kubernetes RBAC"]
        NoRoles["No ClusterRoles defined"]
        NoBindings["No RoleBindings defined"]
        NoSA["No custom ServiceAccount<br/>referenced in manifests"]
    end

    subgraph NetworkAccess["Network Access"]
        GRPCPort["gRPC :8033/TCP<br/>External inference API<br/>Optional mTLS"]
        HTTPPort["HTTP :3000/TCP<br/>Health + Metrics<br/>No auth (container port only)"]
        UnixSockets["Unix Domain Sockets<br/>/tmp/text-generation-server-*<br/>Internal shard communication"]
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        mTLS["Optional mTLS<br/>tonic ServerTlsConfig<br/>Client cert validated<br/>against TLS_CLIENT_CA_CERT_PATH"]
        NoAuth["No built-in token auth<br/>No RBAC-based API auth<br/>Relies on platform enforcement"]
    end

    subgraph TLSCerts["TLS Configuration (Optional)"]
        ServerCert["TLS_CERT_PATH<br/>Server certificate"]
        ServerKey["TLS_KEY_PATH<br/>Server private key"]
        ClientCA["TLS_CLIENT_CA_CERT_PATH<br/>Client CA for mTLS"]
        CryptoNote["Crypto: rustls + ring<br/>(NOT FIPS-validated)"]
    end

    subgraph StorageAccess["Storage Access"]
        PVCAccess["PVC Mount<br/>/shared_model_storage<br/>Read-only"]
        CacheAccess["HF Cache<br/>~/.cache/huggingface/hub<br/>Read-write"]
    end

    SecurityCtx --> User
    User --> NoRoles
    User --> NoBindings

    GRPCPort --> mTLS
    HTTPPort --> NoAuth

    mTLS --> ServerCert
    mTLS --> ServerKey
    mTLS --> ClientCA
    ServerCert --- CryptoNote

    User --> PVCAccess
    User --> CacheAccess

    %% Styling
    style SecurityCtx fill:#d5e8d4,stroke:#82b366
    style User fill:#4a90e2,stroke:#333,color:#fff
    style NoRoles fill:#e8e8e8,stroke:#999
    style NoBindings fill:#e8e8e8,stroke:#999
    style NoSA fill:#e8e8e8,stroke:#999
    style GRPCPort fill:#dae8fc,stroke:#6c8ebf
    style HTTPPort fill:#dae8fc,stroke:#6c8ebf
    style UnixSockets fill:#dae8fc,stroke:#6c8ebf
    style mTLS fill:#fff2cc,stroke:#d6b656
    style NoAuth fill:#f8cecc,stroke:#b85450
    style ServerCert fill:#fff2cc,stroke:#d6b656
    style ServerKey fill:#fff2cc,stroke:#d6b656
    style ClientCA fill:#fff2cc,stroke:#d6b656
    style CryptoNote fill:#f8cecc,stroke:#b85450
    style PVCAccess fill:#f5a623,stroke:#333,color:#fff
    style CacheAccess fill:#f5a623,stroke:#333,color:#fff
