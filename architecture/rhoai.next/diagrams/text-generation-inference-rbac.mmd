graph TD
    subgraph Legend["RBAC & Security Context"]
        direction TB
        Note["TGIS does not define its own RBAC resources.<br/>It runs as a standalone inference server pod<br/>and does not interact with the Kubernetes API.<br/><br/>Security is managed at the pod and network level."]
    end

    subgraph PodSecurity["Pod Security Context"]
        direction TB
        Container["TGIS Container"]
        ROFilesystem["Read-Only Root Filesystem<br/>(kustomize patch)"]
        GPUResources["Dedicated GPU Resources<br/>(resource limits enforced)"]
        ModelMount["Model Storage Mount<br/>Read-only PVC"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB
        GRPCAuth["gRPC Endpoint (8033/TCP)<br/>──────────────────<br/>Auth: Optional mTLS<br/>Enforcement: tonic TLS server<br/>Policy: Accepts valid client certs<br/>when TLS_CLIENT_CA_CERT_PATH set"]
        HTTPAuth["/health, /metrics (3000/TCP)<br/>──────────────────<br/>Auth: None<br/>Policy: Unauthenticated"]
    end

    subgraph UpstreamRBAC["Upstream RBAC (Not in TGIS)"]
        direction TB
        KServeRBAC["KServe manages RBAC<br/>for InferenceService CRs"]
        PlatformRBAC["Platform manages<br/>namespace-level NetworkPolicies"]
        CaikitRBAC["Caikit manages<br/>per-request auth enforcement"]
    end

    Container --> ROFilesystem
    Container --> GPUResources
    Container --> ModelMount
    Container --> GRPCAuth
    Container --> HTTPAuth

    GRPCAuth -.->|"multi-tenant auth<br/>delegated to"| KServeRBAC
    GRPCAuth -.->|"multi-tenant auth<br/>delegated to"| CaikitRBAC
    Container -.->|"network isolation<br/>delegated to"| PlatformRBAC

    style Legend fill:#fff3e0,stroke:#f5a623,stroke-width:2px
    style Note fill:#fff3e0,stroke:none
    style PodSecurity fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style AuthMechanisms fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style UpstreamRBAC fill:#f5f5f5,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5
    style Container fill:#4a90e2,stroke:#333,color:#fff
    style ROFilesystem fill:#c8e6c9,stroke:#4caf50
    style GPUResources fill:#c8e6c9,stroke:#4caf50
    style ModelMount fill:#c8e6c9,stroke:#4caf50
    style GRPCAuth fill:#ffcdd2,stroke:#c62828
    style HTTPAuth fill:#ffcdd2,stroke:#c62828
    style KServeRBAC fill:#e8e8e8,stroke:#999
    style PlatformRBAC fill:#e8e8e8,stroke:#999
    style CaikitRBAC fill:#e8e8e8,stroke:#999
