graph TB
    subgraph MLServer["MLServer Inference Server"]
        direction TB

        subgraph Core["Core Services"]
            Server["mlserver<br/>Server Orchestrator"]
            DataPlane["DataPlane<br/>Inference Pipeline"]
            ModelRegistry["Model Registry<br/>In-Memory"]
            Middleware["Middleware Chain<br/>Request/Response"]
            Cache["Response Cache<br/>(optional)"]
            Batcher["Adaptive Batcher<br/>(configurable)"]
        end

        subgraph Transports["Transport Layer"]
            REST["REST Server<br/>FastAPI/uvicorn<br/>8080/TCP"]
            GRPC["gRPC Server<br/>grpc.aio<br/>8081/TCP"]
            Kafka["Kafka Server<br/>aiokafka<br/>(optional)"]
            Metrics["Metrics Server<br/>Prometheus<br/>8082/TCP"]
        end

        subgraph Runtimes["Pluggable Runtime Adapters"]
            SKLearn["mlserver-sklearn<br/>Scikit-learn"]
            XGBoost["mlserver-xgboost<br/>XGBoost"]
            LightGBM["mlserver-lightgbm<br/>LightGBM"]
            ONNX["mlserver-onnx<br/>ONNX Runtime<br/>(CPU or CUDA)"]
            HuggingFace["mlserver-huggingface<br/>HF Transformers"]
            MLflow["mlserver-mlflow<br/>MLflow"]
            AlibiExplain["mlserver-alibi-explain<br/>Explainability"]
            AlibiDetect["mlserver-alibi-detect<br/>Drift Detection"]
            CatBoost["mlserver-catboost<br/>CatBoost"]
            MLlib["mlserver-mllib<br/>Spark MLlib"]
        end

        subgraph Workers["Parallel Inference (optional)"]
            Dispatcher["Dispatcher<br/>(main process)"]
            Worker1["Worker 1<br/>(OS process)"]
            Worker2["Worker N<br/>(OS process)"]
        end

        REST --> DataPlane
        GRPC --> DataPlane
        Kafka --> DataPlane
        DataPlane --> Middleware
        Middleware --> Cache
        Cache --> Batcher
        Batcher --> ModelRegistry
        ModelRegistry --> Dispatcher
        Dispatcher --> Worker1
        Dispatcher --> Worker2
        Server --> REST
        Server --> GRPC
        Server --> Kafka
        Server --> Metrics
    end

    %% External Interactions
    Client["External Client"] -->|"V2 Inference Protocol"| KServeGW["KServe Gateway<br/>443/TCP HTTPS"]
    KServeGW -->|"HTTP/8080"| REST
    KServeGW -->|"gRPC/8081"| GRPC

    ModelStorage["/mnt/models<br/>Model Artifacts"] -->|filesystem| ModelRegistry

    KafkaBroker["Apache Kafka<br/>9092/TCP"] <-->|"consume/produce"| Kafka

    Metrics -->|"scrape /metrics"| Prometheus["Prometheus"]
    DataPlane -->|"OTLP traces"| OTelCollector["OpenTelemetry<br/>Collector"]

    %% Styling
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style DataPlane fill:#4a90e2,stroke:#333,color:#fff
    style REST fill:#5ba0d0,stroke:#333,color:#fff
    style GRPC fill:#5ba0d0,stroke:#333,color:#fff
    style Kafka fill:#5ba0d0,stroke:#333,color:#fff
    style Metrics fill:#5ba0d0,stroke:#333,color:#fff
    style SKLearn fill:#7ed321,stroke:#333
    style XGBoost fill:#7ed321,stroke:#333
    style LightGBM fill:#7ed321,stroke:#333
    style ONNX fill:#7ed321,stroke:#333
    style HuggingFace fill:#7ed321,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style AlibiExplain fill:#7ed321,stroke:#333
    style AlibiDetect fill:#7ed321,stroke:#333
    style CatBoost fill:#7ed321,stroke:#333
    style MLlib fill:#7ed321,stroke:#333
    style KServeGW fill:#f5a623,stroke:#333
    style ModelStorage fill:#e8e8e8,stroke:#333
    style KafkaBroker fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
