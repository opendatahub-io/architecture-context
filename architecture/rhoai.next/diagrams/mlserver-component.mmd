graph TB
    subgraph External["External Clients"]
        Client[Client Application]
    end

    subgraph Platform["KServe Platform Layer"]
        KServe["KServe Controller<br/>(Pod Lifecycle & Scaling)"]
        KRBAC["kube-rbac-proxy Sidecar<br/>443/TCP TLS"]
    end

    subgraph MLServerCore["MLServer Core"]
        direction TB
        Orchestrator["MLServer Orchestrator<br/>(asyncio event loop)"]

        subgraph Servers["Transport Servers"]
            REST["REST Server<br/>FastAPI + uvicorn<br/>8080/TCP HTTP"]
            GRPC["gRPC Server<br/>grpc.aio<br/>8081/TCP H2C"]
            Metrics["Metrics Server<br/>uvicorn<br/>8082/TCP HTTP"]
            KafkaSrv["Kafka Server<br/>(optional)"]
        end

        DataPlane["DataPlane Handler<br/>(V2 Inference Protocol)"]
        Registry["MultiModelRegistry<br/>(Model Lifecycle)"]
        TrustedRT["Trusted Runtimes<br/>Allowlist Validator"]
        BatchHandler["Adaptive Batching<br/>(max_batch_size / max_batch_time)"]
        WorkerPool["Parallel Inference<br/>Worker Pool"]
    end

    subgraph Runtimes["Runtime Plugins"]
        SKLearn["mlserver-sklearn<br/>Scikit-Learn"]
        XGBoost["mlserver-xgboost<br/>XGBoost"]
        LightGBM["mlserver-lightgbm<br/>LightGBM"]
        ONNX["mlserver-onnx<br/>ONNX Runtime"]
        MLflow["mlserver-mlflow<br/>MLflow"]
        HF["mlserver-huggingface<br/>HuggingFace"]
        AlibiExp["mlserver-alibi-explain<br/>Explainability"]
        AlibiDet["mlserver-alibi-detect<br/>Drift Detection"]
        CatBoost["mlserver-catboost<br/>CatBoost"]
        MLlib["mlserver-mllib<br/>Spark MLlib"]
    end

    subgraph Storage["Model Storage"]
        ModelDir["/mnt/models<br/>(Volume Mount)"]
    end

    subgraph Observability["Observability"]
        Prometheus["Prometheus"]
        OTLPCollector["OTLP Collector"]
    end

    Client -->|HTTPS/443| KRBAC
    KServe -->|manages lifecycle| Orchestrator
    KServe -->|injects sidecar| KRBAC
    KRBAC -->|HTTP/8080| REST
    KRBAC -->|gRPC/8081| GRPC

    Orchestrator --> REST
    Orchestrator --> GRPC
    Orchestrator --> Metrics
    Orchestrator --> KafkaSrv

    REST --> DataPlane
    GRPC --> DataPlane
    DataPlane --> Registry
    Registry -->|validates| TrustedRT
    Registry --> BatchHandler
    BatchHandler --> WorkerPool

    Registry --> SKLearn
    Registry --> XGBoost
    Registry --> LightGBM
    Registry --> ONNX
    Registry --> MLflow
    Registry --> HF
    Registry --> AlibiExp
    Registry --> AlibiDet
    Registry --> CatBoost
    Registry --> MLlib

    KServe -->|mounts artifacts| ModelDir
    Registry -->|loads from| ModelDir

    Prometheus -->|scrape /metrics| Metrics
    Orchestrator -.->|OTLP traces| OTLPCollector

    style Orchestrator fill:#4a90e2,color:#fff
    style REST fill:#4a90e2,color:#fff
    style GRPC fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style DataPlane fill:#4a90e2,color:#fff
    style Registry fill:#4a90e2,color:#fff
    style TrustedRT fill:#e74c3c,color:#fff
    style BatchHandler fill:#4a90e2,color:#fff
    style WorkerPool fill:#4a90e2,color:#fff
