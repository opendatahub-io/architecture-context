graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>NS: feast-operator-system"]
        SA_FS["feast-{name}<br/>NS: {user-namespace}<br/>(dynamically created)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-wide)"]
        CRB_Metrics["metrics-auth-rolebinding<br/>(Cluster-wide)"]
        CRB_TokenReview["feast-{name}-cluster-binding<br/>(Cluster-wide, dynamic)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>NS: feast-operator-system"]
        RB_FS["feast-{name}<br/>NS: {user-namespace} (dynamic)"]
        RB_CronJob["feast-{name}-cronjob<br/>NS: {user-namespace} (dynamic)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_Editor["featurestore-editor-role"]
        CR_Viewer["featurestore-viewer-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_TokenReview["feast-token-review-cluster-role<br/>(dynamic)"]
        CR_DiscoverNS["feast-discover-namespaces<br/>(dynamic)"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role<br/>NS: feast-operator-system"]
        R_FS["feast-{name}<br/>NS: {user-namespace} (dynamic)"]
        R_CronJob["feast-{name}-cronjob<br/>NS: {user-namespace} (dynamic)"]
    end

    subgraph ManagerResources["manager-role API Resources"]
        Res_FS["feast.dev<br/>featurestores<br/>featurestores/status<br/>featurestores/finalizers<br/>→ get,list,watch,create,<br/>update,patch,delete"]
        Res_Core["core<br/>configmaps, services,<br/>serviceaccounts, pvc,<br/>pods, secrets, namespaces<br/>→ get,list,watch,create,<br/>update,delete,patch"]
        Res_Apps["apps<br/>deployments<br/>→ get,list,create,<br/>update,watch,delete"]
        Res_Batch["batch<br/>cronjobs<br/>→ get,list,watch,create,<br/>update,patch,delete"]
        Res_Scale["autoscaling<br/>horizontalpodautoscalers<br/>→ get,list,watch,create,<br/>update,patch,delete"]
        Res_Policy["policy<br/>poddisruptionbudgets<br/>→ get,list,watch,create,<br/>update,patch,delete"]
        Res_RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings<br/>→ get,list,create,<br/>update,watch,delete"]
        Res_Auth["authentication.k8s.io<br/>tokenreviews → create"]
        Res_OS["config.openshift.io<br/>apiservers → get,list,watch<br/>route.openshift.io<br/>routes → get,list,create,<br/>update,watch,delete"]
        Res_KF["kubeflow.org<br/>notebooks → get,list,watch"]
        Res_Spark["sparkoperator.k8s.io<br/>sparkapplications<br/>→ create,get,delete"]
        Res_Prom["monitoring.coreos.com<br/>servicemonitors<br/>→ get,list,watch,<br/>create,patch,delete"]
    end

    subgraph TokenReviewResources["feast-token-review-cluster-role Resources"]
        Res_TR["authentication.k8s.io<br/>tokenreviews → create<br/>authorization.k8s.io<br/>subjectaccessreviews → create"]
    end

    subgraph EditorResources["featurestore-editor-role Resources"]
        Res_EditorFS["feast.dev<br/>featurestores<br/>featurestores/status<br/>→ get,list,watch,create,<br/>update,patch,delete"]
    end

    subgraph ViewerResources["featurestore-viewer-role Resources"]
        Res_ViewerFS["feast.dev<br/>featurestores<br/>featurestores/status<br/>→ get,list,watch"]
    end

    %% SA → CRB → CR → Resources
    SA_CM -->|"bound via"| CRB_Manager
    SA_CM -->|"bound via"| CRB_Metrics
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_MetricsAuth

    CR_Manager -->|"permits"| Res_FS
    CR_Manager -->|"permits"| Res_Core
    CR_Manager -->|"permits"| Res_Apps
    CR_Manager -->|"permits"| Res_Batch
    CR_Manager -->|"permits"| Res_Scale
    CR_Manager -->|"permits"| Res_Policy
    CR_Manager -->|"permits"| Res_RBAC
    CR_Manager -->|"permits"| Res_Auth
    CR_Manager -->|"permits"| Res_OS
    CR_Manager -->|"permits"| Res_KF
    CR_Manager -->|"permits"| Res_Spark
    CR_Manager -->|"permits"| Res_Prom

    %% Dynamic SA → CRB → CR
    SA_FS -->|"bound via"| CRB_TokenReview
    CRB_TokenReview -->|"grants"| CR_TokenReview
    CR_TokenReview -->|"permits"| Res_TR

    %% Editor/Viewer (for end users)
    CR_Editor -->|"permits"| Res_EditorFS
    CR_Viewer -->|"permits"| Res_ViewerFS

    %% Namespace-scoped bindings
    SA_CM -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| R_Leader
    SA_FS -->|"bound via"| RB_FS
    RB_FS -->|"grants"| R_FS
    SA_FS -->|"bound via"| RB_CronJob
    RB_CronJob -->|"grants"| R_CronJob

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_FS fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_TokenReview fill:#f5a623,color:#fff,stroke-dasharray: 5 5
    style CR_DiscoverNS fill:#f5a623,color:#fff,stroke-dasharray: 5 5
    style R_Leader fill:#e8a020,color:#fff
    style R_FS fill:#e8a020,color:#fff,stroke-dasharray: 5 5
    style R_CronJob fill:#e8a020,color:#fff,stroke-dasharray: 5 5
    style Res_FS fill:#7ed321,color:#fff
    style Res_Core fill:#7ed321,color:#fff
    style Res_Apps fill:#7ed321,color:#fff
    style Res_Batch fill:#7ed321,color:#fff
    style Res_Scale fill:#7ed321,color:#fff
    style Res_Policy fill:#7ed321,color:#fff
    style Res_RBAC fill:#7ed321,color:#fff
    style Res_Auth fill:#7ed321,color:#fff
    style Res_OS fill:#7ed321,color:#fff
    style Res_KF fill:#7ed321,color:#fff
    style Res_Spark fill:#7ed321,color:#fff
    style Res_Prom fill:#7ed321,color:#fff
    style Res_TR fill:#7ed321,color:#fff
    style Res_EditorFS fill:#7ed321,color:#fff
    style Res_ViewerFS fill:#7ed321,color:#fff
