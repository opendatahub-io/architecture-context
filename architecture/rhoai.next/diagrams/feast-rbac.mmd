graph TD
    subgraph "Service Accounts"
        SA_Operator["controller-manager<br/>(feast-operator SA)<br/>Namespace: redhat-ods-applications"]
        SA_Feast["feast-{project}<br/>(per-FeatureStore SA)<br/>Namespace: {project-namespace}"]
        SA_CronJob["feast-{project}<br/>(CronJob uses same SA)<br/>Namespace: {project-namespace}"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["manager-rolebinding<br/>(cluster-wide)"]
        CRB_Editor["featurestore-editor-binding<br/>(cluster-wide)"]
        CRB_Viewer["featurestore-viewer-binding<br/>(cluster-wide)"]
        CRB_Discover["feast-{ns}--{project}-discover<br/>(cluster-wide, dynamic)"]
    end

    subgraph "Role Bindings (Namespace-scoped)"
        RB_Leader["leader-election-role-binding<br/>(operator namespace)"]
        RB_Feast["feast-{project}-role-binding<br/>(FeatureStore namespace)"]
        RB_CronJob["feast-{project}-cronjob-role-binding<br/>(FeatureStore namespace)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["manager-role"]
        CR_Editor["featurestore-editor-role"]
        CR_Viewer["featurestore-viewer-role"]
        CR_Discover["feast-{ns}--{project}-discover<br/>(dynamic, auto-access)"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader-role"]
    end

    subgraph "Roles (Namespace-scoped)"
        R_Leader["leader-election-role"]
        R_Feast["feast-{project}-role<br/>(dynamic)"]
        R_CronJob["feast-{project}-cronjob-role<br/>(dynamic)"]
    end

    subgraph "manager-role Permissions"
        direction LR
        Res_Core["core: configmaps, namespaces,<br/>persistentvolumeclaims,<br/>pods, pods/exec, pods/log,<br/>secrets, services,<br/>serviceaccounts"]
        Res_Apps["apps: deployments"]
        Res_Batch["batch: cronjobs"]
        Res_Feast["feast.dev: featurestores,<br/>featurestores/finalizers,<br/>featurestores/status"]
        Res_RBAC["rbac: clusterroles,<br/>clusterrolebindings,<br/>roles, rolebindings"]
        Res_Monitoring["monitoring.coreos.com:<br/>servicemonitors"]
        Res_OCP["config.openshift.io:<br/>apiservers<br/>route.openshift.io:<br/>routes"]
        Res_KF["kubeflow.org: notebooks"]
        Res_Spark["sparkoperator.k8s.io:<br/>sparkapplications"]
        Res_Autoscale["autoscaling:<br/>horizontalpodautoscalers<br/>policy:<br/>poddisruptionbudgets"]
        Res_Auth["authentication.k8s.io:<br/>tokenreviews<br/>apiextensions.k8s.io:<br/>customresourcedefinitions"]
    end

    subgraph "featurestore-editor-role Permissions"
        Res_EditorFeast["feast.dev: featurestores<br/>Verbs: get, list, watch,<br/>create, update, patch, delete"]
    end

    subgraph "featurestore-viewer-role Permissions"
        Res_ViewerFeast["feast.dev: featurestores<br/>Verbs: get, list, watch"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager
    SA_Operator -->|bound via| RB_Leader
    RB_Leader -->|grants| R_Leader

    %% Manager role to permissions
    CR_Manager -->|"create, delete, deletecollection,<br/>get, list, patch, update, watch"| Res_Core
    CR_Manager -->|"create, delete, get,<br/>list, update, watch"| Res_Apps
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Res_Batch
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Res_Feast
    CR_Manager -->|"create, delete, get,<br/>list, update, watch"| Res_RBAC
    CR_Manager -->|"create, delete, get,<br/>list, patch, watch"| Res_Monitoring
    CR_Manager -->|"get, list, watch (apiserver)<br/>create, delete, get, list,<br/>update, watch (routes)"| Res_OCP
    CR_Manager -->|"get, list, watch"| Res_KF
    CR_Manager -->|"create, delete, get,<br/>list, update, watch"| Res_Spark
    CR_Manager -->|"create, delete, get, list,<br/>patch, update, watch"| Res_Autoscale
    CR_Manager -->|"create (tokenreviews)<br/>get, list (CRDs)"| Res_Auth

    %% Editor role
    CRB_Editor -->|grants| CR_Editor
    CR_Editor -->|full CRUD| Res_EditorFeast

    %% Viewer role
    CRB_Viewer -->|grants| CR_Viewer
    CR_Viewer -->|read-only| Res_ViewerFeast

    %% FeatureStore SA bindings
    SA_Feast -->|bound via| RB_Feast
    RB_Feast -->|grants| R_Feast
    SA_Feast -->|bound via| CRB_Discover
    CRB_Discover -->|grants| CR_Discover

    %% CronJob SA bindings
    SA_CronJob -->|bound via| RB_CronJob
    RB_CronJob -->|grants| R_CronJob

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style SA_Feast fill:#4a90e2,color:#fff
    style SA_CronJob fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style CR_Discover fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style R_Leader fill:#e8a040,color:#fff
    style R_Feast fill:#e8a040,color:#fff
    style R_CronJob fill:#e8a040,color:#fff
    style Res_Feast fill:#7ed321,color:#fff
    style Res_EditorFeast fill:#7ed321,color:#fff
    style Res_ViewerFeast fill:#7ed321,color:#fff
