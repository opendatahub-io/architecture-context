graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_KServe["kserve-controller-manager<br/>(ns: opendatahub)"]
        SA_EPP["{name}-epp-sa<br/>(ns: per-LLMInferenceService)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_KServe["kserve-manager-rolebinding<br/>(cluster-wide)"]
        CRB_LLM["llmisvc-manager-rolebinding<br/>(cluster-wide)"]
        CRB_EPP_Auth["{namespace}-{name}-epp-auth-rb<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["kserve-leader-election-rolebinding<br/>(ns: opendatahub)"]
        RB_EPP["{name}-epp-rb<br/>(ns: per-LLMInferenceService)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_KServe["kserve-manager-role"]
        CR_LLM["llmisvc-manager-role"]
        CR_AuthDelegator["system:auth-delegator"]
    end

    subgraph Roles["Namespace Roles"]
        R_Leader["kserve-leader-election-role"]
        R_EPP["{name}-epp-role"]
    end

    subgraph KServeResources["kserve-manager-role Resources"]
        KR_ISVC["serving.kserve.io<br/>inferenceservices<br/>inferenceservices/status<br/>inferenceservices/finalizers"]
        KR_SR["serving.kserve.io<br/>servingruntimes<br/>clusterservingruntimes<br/>clusterstoragecontainers"]
        KR_Apps["apps<br/>deployments"]
        KR_Gateway["gateway.networking.k8s.io<br/>httproutes"]
        KR_HPA["autoscaling<br/>horizontalpodautoscalers"]
        KR_Core["core<br/>services, serviceaccounts<br/>configmaps, secrets<br/>events, pods, namespaces"]
        KR_Knative["serving.knative.dev<br/>services<br/>services/finalizers"]
        KR_Istio["networking.istio.io<br/>virtualservices<br/>virtualservices/finalizers"]
        KR_Admission["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations<br/>validatingwebhookconfigurations"]
    end

    subgraph LLMISVCResources["llmisvc-manager-role Resources"]
        LR_LLMISVC["serving.kserve.io<br/>llminferenceservices<br/>llminferenceserviceconfigs"]
        LR_LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets"]
        LR_GW["gateway.networking.k8s.io<br/>httproutes, gateways<br/>gatewayclasses"]
        LR_GIE["inference.networking.k8s.io<br/>+ inference.networking.x-k8s.io<br/>inferencepools<br/>inferencemodels"]
        LR_DRA["resource.k8s.io<br/>resourceclaims<br/>resourceclaimtemplates"]
        LR_WVA["llm-d.ai<br/>variantautoscalings"]
        LR_KEDA["keda.sh<br/>scaledobjects"]
        LR_Mon["monitoring.coreos.com<br/>podmonitors<br/>servicemonitors"]
        LR_Istio["networking.istio.io<br/>destinationrules<br/>(distro only)"]
        LR_SCC["security.openshift.io<br/>securitycontextconstraints<br/>(use verb, distro only)"]
    end

    %% SA → Bindings
    SA_KServe -->|bound via| CRB_KServe
    SA_KServe -->|bound via| CRB_LLM
    SA_KServe -->|bound via| RB_Leader
    SA_EPP -->|bound via| RB_EPP
    SA_EPP -->|bound via| CRB_EPP_Auth

    %% Bindings → Roles
    CRB_KServe -->|grants| CR_KServe
    CRB_LLM -->|grants| CR_LLM
    CRB_EPP_Auth -->|grants| CR_AuthDelegator
    RB_Leader -->|grants| R_Leader
    RB_EPP -->|grants| R_EPP

    %% kserve-manager-role → Resources
    CR_KServe -->|"get,list,watch<br/>create,update<br/>patch,delete"| KR_ISVC
    CR_KServe -->|"get,list,watch<br/>create,update<br/>patch,delete"| KR_SR
    CR_KServe -->|"get,list,watch<br/>create,update<br/>patch,delete"| KR_Apps
    CR_KServe -->|"get,list,watch<br/>create,update<br/>patch,delete"| KR_Gateway
    CR_KServe -->|"get,list,watch<br/>create,update<br/>patch,delete"| KR_HPA
    CR_KServe -->|"full CRUD"| KR_Core
    CR_KServe -->|"full CRUD"| KR_Knative
    CR_KServe -->|"full CRUD"| KR_Istio
    CR_KServe -->|"full CRUD"| KR_Admission

    %% llmisvc-manager-role → Resources
    CR_LLM -->|"get,list,watch<br/>create,update<br/>patch,delete"| LR_LLMISVC
    CR_LLM -->|"full CRUD"| LR_LWS
    CR_LLM -->|"full CRUD"| LR_GW
    CR_LLM -->|"full CRUD"| LR_GIE
    CR_LLM -->|"full CRUD"| LR_DRA
    CR_LLM -->|"full CRUD"| LR_WVA
    CR_LLM -->|"full CRUD"| LR_KEDA
    CR_LLM -->|"full CRUD"| LR_Mon
    CR_LLM -->|"full CRUD"| LR_Istio
    CR_LLM -->|"use"| LR_SCC

    %% Styling
    style SA_KServe fill:#4a90e2,stroke:#333,color:#fff
    style SA_EPP fill:#4a90e2,stroke:#333,color:#fff
    style CR_KServe fill:#f5a623,stroke:#333,color:#fff
    style CR_LLM fill:#f5a623,stroke:#333,color:#fff
    style CR_AuthDelegator fill:#f5a623,stroke:#333,color:#fff
    style R_Leader fill:#e8a317,stroke:#333,color:#fff
    style R_EPP fill:#e8a317,stroke:#333,color:#fff
    style CRB_KServe fill:#9b59b6,stroke:#333,color:#fff
    style CRB_LLM fill:#9b59b6,stroke:#333,color:#fff
    style CRB_EPP_Auth fill:#9b59b6,stroke:#333,color:#fff
    style RB_Leader fill:#8e44ad,stroke:#333,color:#fff
    style RB_EPP fill:#8e44ad,stroke:#333,color:#fff
    style KR_ISVC fill:#7ed321,stroke:#333
    style KR_SR fill:#7ed321,stroke:#333
    style KR_Apps fill:#7ed321,stroke:#333
    style KR_Gateway fill:#7ed321,stroke:#333
    style KR_HPA fill:#7ed321,stroke:#333
    style KR_Core fill:#7ed321,stroke:#333
    style KR_Knative fill:#7ed321,stroke:#333
    style KR_Istio fill:#7ed321,stroke:#333
    style KR_Admission fill:#7ed321,stroke:#333
    style LR_LLMISVC fill:#7ed321,stroke:#333
    style LR_LWS fill:#7ed321,stroke:#333
    style LR_GW fill:#7ed321,stroke:#333
    style LR_GIE fill:#7ed321,stroke:#333
    style LR_DRA fill:#7ed321,stroke:#333
    style LR_WVA fill:#7ed321,stroke:#333
    style LR_KEDA fill:#7ed321,stroke:#333
    style LR_Mon fill:#7ed321,stroke:#333
    style LR_Istio fill:#e74c3c,stroke:#333,color:#fff
    style LR_SCC fill:#e74c3c,stroke:#333,color:#fff
