graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Module["kserve-module-controller-manager"]
        SA_ODH["odh-model-controller"]
        SA_KServe["kserve-controller-manager"]
        SA_LLMISVC["llmisvc-serviceAccountName"]
        SA_LocalModel["kserve-localmodel-controller-manager"]
        SA_LMNode["kserve-localmodelnode-agent"]
        SA_ServingAPI["model-serving-api"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Module["kserve-module-manager-rolebinding"]
        CRB_ODH["odh-model-controller-rolebinding"]
        CRB_KServe["kserve-manager-rolebinding"]
        CRB_LLMISVC["llmisvc-manager-rolebinding"]
        CRB_LocalModel["kserve-localmodel-manager-rolebinding"]
        CRB_LMNode["kserve-localmodelnode-agent-rolebinding"]
        CRB_ServingAPI["model-serving-api binding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Module["kserve-module-manager-role"]
        CR_ODH["odh-model-controller-role"]
        CR_KServe["kserve-manager-role"]
        CR_LLMISVC["kserve-llmisvc-manager-role"]
        CR_LocalModel["kserve-localmodel-manager-role"]
        CR_LMNode["kserve-localmodelnode-agent-role"]
        CR_ServingAPI["model-serving-api role"]
    end

    subgraph Resources_Module["Module Manager Resources"]
        R_CSR["serving.kserve.io<br/>ClusterServingRuntime"]
        R_CSC["serving.kserve.io<br/>ClusterStorageContainer"]
        R_Kserve["components.platform.opendatahub.io<br/>Kserve + status + finalizers"]
        R_Webhooks["admissionregistration.k8s.io<br/>MutatingWebhookConfig<br/>ValidatingWebhookConfig"]
        R_Certs["cert-manager.io<br/>Certificates, Issuers"]
        R_SCC["security.openshift.io<br/>SecurityContextConstraints"]
    end

    subgraph Resources_ODH["ODH Model Controller Resources"]
        R_ISVC["serving.kserve.io<br/>InferenceService"]
        R_LLMISVC_R["serving.kserve.io<br/>LLMInferenceService"]
        R_NIM["nim.opendatahub.io<br/>Account + status + finalizers"]
        R_HTTPRoute["gateway.networking.k8s.io<br/>Gateway, HTTPRoute"]
        R_AuthPolicy["kuadrant.io<br/>AuthPolicy"]
    end

    subgraph Resources_Core["Core KServe Resources"]
        R_ISVC2["serving.kserve.io<br/>InferenceService + finalizers"]
        R_IG["serving.kserve.io<br/>InferenceGraph"]
        R_TM["serving.kserve.io<br/>TrainedModel"]
        R_SR["serving.kserve.io<br/>ServingRuntime"]
    end

    subgraph Resources_LLM["LLM Controller Resources"]
        R_LLMISVC2["serving.kserve.io<br/>LLMInferenceService + status"]
        R_InfModel["inference.networking.k8s.io<br/>InferenceModel, InferencePool"]
        R_LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSet"]
    end

    subgraph Resources_LM["Local Model Resources"]
        R_LMC["serving.kserve.io<br/>LocalModelCache + status"]
        R_LMN["serving.kserve.io<br/>LocalModelNode + status"]
        R_PV["core<br/>PersistentVolume<br/>PersistentVolumeClaim"]
    end

    %% SA → CRB
    SA_Module -->|bound via| CRB_Module
    SA_ODH -->|bound via| CRB_ODH
    SA_KServe -->|bound via| CRB_KServe
    SA_LLMISVC -->|bound via| CRB_LLMISVC
    SA_LocalModel -->|bound via| CRB_LocalModel
    SA_LMNode -->|bound via| CRB_LMNode
    SA_ServingAPI -->|bound via| CRB_ServingAPI

    %% CRB → CR
    CRB_Module -->|grants| CR_Module
    CRB_ODH -->|grants| CR_ODH
    CRB_KServe -->|grants| CR_KServe
    CRB_LLMISVC -->|grants| CR_LLMISVC
    CRB_LocalModel -->|grants| CR_LocalModel
    CRB_LMNode -->|grants| CR_LMNode
    CRB_ServingAPI -->|grants| CR_ServingAPI

    %% CR → Resources
    CR_Module -->|"CRUD"| R_CSR
    CR_Module -->|"CRUD"| R_CSC
    CR_Module -->|"get,list,patch,update,watch"| R_Kserve
    CR_Module -->|"CRUD"| R_Webhooks
    CR_Module -->|"CRUD"| R_Certs
    CR_Module -->|"CRUD"| R_SCC

    CR_ODH -->|"get,list,patch,update,watch"| R_ISVC
    CR_ODH -->|"get,list,patch,update,watch"| R_LLMISVC_R
    CR_ODH -->|"get,list,patch,update,watch"| R_NIM
    CR_ODH -->|"get,list,patch,update,watch"| R_HTTPRoute
    CR_ODH -->|"CRUD"| R_AuthPolicy

    CR_KServe -->|"CRUD"| R_ISVC2
    CR_KServe -->|"CRUD"| R_IG
    CR_KServe -->|"CRUD"| R_TM
    CR_KServe -->|"CRUD"| R_SR

    CR_LLMISVC -->|"CRUD"| R_LLMISVC2
    CR_LLMISVC -->|"CRUD"| R_InfModel
    CR_LLMISVC -->|"CRUD"| R_LWS

    CR_LocalModel -->|"CRUD"| R_LMC
    CR_LocalModel -->|"CRUD"| R_LMN
    CR_LocalModel -->|"CRUD"| R_PV

    CR_LMNode -->|"CRUD"| R_LMN

