graph TB
    subgraph OperatorLayer["Operator Layer (openshift-kueue-operator)"]
        Operator["openshift-kueue-operator<br/>Go Operator<br/>2 replicas, leader election<br/>Port: 60000/TCP (metrics)"]
    end

    subgraph OperandLayer["Operand Layer (kueue-controller-manager)"]
        Controller["kueue-controller-manager<br/>Queue Scheduling Controller<br/>1 replica<br/>Ports: 8443, 8082, 9443, 8081"]
        WebhookServer["Webhook Server<br/>9443/TCP<br/>17 mutating + 18 validating<br/>TLS (cert-manager)"]
        VisibilityAPI["Visibility API Server<br/>8082/TCP<br/>Pending workloads queries"]
        MetricsEndpoint["Metrics Endpoint<br/>8443/TCP<br/>mTLS (cert-manager)"]
        Controller --- WebhookServer
        Controller --- VisibilityAPI
        Controller --- MetricsEndpoint
    end

    subgraph MustGather["Diagnostics"]
        MG["must-gather<br/>Shell scripts<br/>Diagnostic data collection"]
    end

    %% CRDs
    KueueCR["Kueue CR<br/>(kueue.openshift.io/v1)<br/>Singleton: name='cluster'"]
    ClusterQueueCR["ClusterQueue<br/>(kueue.x-k8s.io/v1beta1)"]
    LocalQueueCR["LocalQueue<br/>(kueue.x-k8s.io/v1beta1)"]
    WorkloadCR["Workload<br/>(kueue.x-k8s.io/v1beta1)"]
    ResourceFlavorCR["ResourceFlavor<br/>(kueue.x-k8s.io/v1beta1)"]

    %% User interaction
    Admin["Cluster Admin"] -->|creates| KueueCR
    User["Data Scientist / Batch User"] -->|creates Jobs in<br/>managed namespaces| LocalQueueCR

    %% Operator watches and reconciles
    KueueCR -->|watched by| Operator
    Operator -->|"deploys & manages"| Controller
    Operator -->|"installs CRDs,<br/>RBAC, webhooks,<br/>network policies"| OperandLayer

    %% Controller watches queue CRDs
    Controller -->|watches| ClusterQueueCR
    Controller -->|watches| LocalQueueCR
    Controller -->|watches| WorkloadCR
    Controller -->|watches| ResourceFlavorCR

    %% External dependencies
    CertManager["cert-manager<br/>(prerequisite)"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    Prometheus["Prometheus"]

    Operator -->|"gates on availability"| CertManager
    Operator -->|"creates Issuer +<br/>Certificate CRs"| CertManager
    Operator -->|REST + Watch| K8sAPI
    Controller -->|REST + Watch| K8sAPI
    Prometheus -->|"scrapes mTLS<br/>8443/TCP"| MetricsEndpoint

    %% Workload framework integrations
    subgraph ManagedFrameworks["Managed Workload Frameworks"]
        BatchJob["batch/Job"]
        RayJob["ray.io/RayJob"]
        PyTorchJob["kubeflow.org/PyTorchJob"]
        AppWrapper["workload.codeflare.dev/AppWrapper"]
        JobSet["jobset.x-k8s.io/JobSet"]
    end

    WebhookServer -->|"admission control<br/>(opt-in namespaces)"| ManagedFrameworks

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style WebhookServer fill:#4a90e2,stroke:#333,color:#fff
    style VisibilityAPI fill:#4a90e2,stroke:#333,color:#fff
    style MetricsEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style MG fill:#87ceeb,stroke:#333
    style KueueCR fill:#f5a623,stroke:#333
    style ClusterQueueCR fill:#f5a623,stroke:#333
    style LocalQueueCR fill:#f5a623,stroke:#333
    style WorkloadCR fill:#f5a623,stroke:#333
    style ResourceFlavorCR fill:#f5a623,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style BatchJob fill:#7ed321,stroke:#333
    style RayJob fill:#7ed321,stroke:#333
    style PyTorchJob fill:#7ed321,stroke:#333
    style AppWrapper fill:#7ed321,stroke:#333
    style JobSet fill:#7ed321,stroke:#333
