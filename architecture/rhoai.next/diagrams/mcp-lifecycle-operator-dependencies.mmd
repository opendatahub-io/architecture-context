graph LR
    MCPOp["MCP Lifecycle Operator<br/>(mcpserver-controller)"]

    %% External Dependencies (Go libraries / runtime)
    MCPOp -->|"controller framework<br/>v0.24.1"| ControllerRuntime["controller-runtime"]
    MCPOp -->|"MCP protocol client<br/>v1.6.1"| MCPGoSDK["modelcontextprotocol/<br/>go-sdk"]
    MCPOp -->|"custom metrics<br/>v1.23.2"| PromClient["prometheus/<br/>client_golang"]
    MCPOp -->|"API types<br/>v0.36.2"| K8sAPI["k8s.io/api"]
    MCPOp -->|"client, informers<br/>v0.36.2"| K8sClientGo["k8s.io/client-go"]

    %% Internal Platform Dependencies
    Prometheus["Prometheus /<br/>OpenShift Monitoring"] -->|"ServiceMonitor<br/>scrape 8443/TCP"| MCPOp

    %% Kubernetes Control Plane
    MCPOp -->|"watch, CRUD, status<br/>443/TCP HTTPS"| K8sAPIServer["Kubernetes<br/>API Server"]

    %% Managed Resources (created by operator)
    MCPOp -->|"creates/manages"| Deployments["Deployments<br/>(MCP server pods)"]
    MCPOp -->|"creates/manages"| Services["ClusterIP Services<br/>(MCP endpoints)"]
    MCPOp -->|"creates/manages"| NetworkPolicies["NetworkPolicies<br/>(MCP port ingress)"]

    %% User-provided config
    MCPOp -->|"watches, reads<br/>for config hash"| ConfigMaps["ConfigMaps<br/>(user-referenced)"]
    MCPOp -->|"watches, reads<br/>for config hash"| Secrets["Secrets<br/>(user-referenced)"]

    %% MCP handshake target
    MCPOp -->|"MCP handshake<br/>HTTP/{port}"| MCPServers["MCP Server<br/>Containers"]

