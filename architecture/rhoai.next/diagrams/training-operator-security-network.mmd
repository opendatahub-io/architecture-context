graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / SDK / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP<br/>TLS 1.2+<br/>Bearer Token / SA Token"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: opendatahub"]
        direction TB

        TrainingOp["Training Operator Controller<br/>SA: training-operator<br/>Image: quay.io/opendatahub/training-operator<br/>FIPS: strictfipsruntime"]

        subgraph Ports["Exposed Ports"]
            Metrics["8080/TCP HTTPS<br/>Prometheus /metrics<br/>TLS 1.2+ (OpenShift profile)"]
            Health["8081/TCP HTTP<br/>/healthz, /readyz"]
            WebhookPort["9443/TCP HTTPS<br/>Validating Webhooks (5)<br/>TLS 1.2+ (OpenShift profile)<br/>cert-controller managed"]
        end

        WebhookCert["Secret: kubeflow-training-<br/>operator-webhook-cert<br/>Type: Opaque (TLS)<br/>Provisioned: cert-controller<br/>Auto-Rotate: Yes"]
    end

    subgraph UserNS["USER NAMESPACES (Per-Job)"]
        direction TB

        TrainingPods["Training Pods<br/>(Worker/Master replicas)"]
        HeadlessSvc["Headless Services<br/>ClusterIP: None<br/>Inter-replica DNS"]
        NetPolicy["NetworkPolicy<br/>(PyTorch only, RHOAI)<br/>Allow: pod-to-pod + monitoring"]

        subgraph MPIResources["MPI Job Resources"]
            MPIConfigMap["ConfigMap<br/>hostfile, kubexec.sh"]
            MPISA["ServiceAccount +<br/>Role + RoleBinding<br/>(pods/exec)"]
            LauncherPod["Launcher Pod"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["OpenShift Monitoring<br/>Namespace: openshift-monitoring<br/>PodMonitor scraping"]
    end

    subgraph OptionalIntegrations["OPTIONAL INTEGRATIONS"]
        Volcano["Volcano Scheduler<br/>PodGroup CRD<br/>scheduling.volcano.sh"]
        SchedPlugins["scheduler-plugins<br/>PodGroup CRD<br/>scheduling.x-k8s.io"]
    end

    subgraph OpenShiftControl["OPENSHIFT CONTROL PLANE"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile source"]
    end

    %% External → Control Plane
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Control Plane → Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS 1.2+<br/>API server mTLS<br/>Fail-closed"| WebhookPort

    %% Controller → API Server (egress)
    TrainingOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>CRUD: Pods, Services,<br/>ConfigMaps, CRDs"| K8sAPI

    %% Controller → OpenShift
    TrainingOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>GET: apiservers/cluster"| OpenShiftAPI

    %% Controller creates resources
    TrainingOp -.->|"creates"| TrainingPods
    TrainingOp -.->|"creates"| HeadlessSvc
    TrainingOp -.->|"creates (PyTorch)"| NetPolicy
    TrainingOp -.->|"creates (MPI)"| MPIConfigMap
    TrainingOp -.->|"creates (MPI)"| MPISA

    %% Pod-to-pod communication
    TrainingPods -->|"TCP/user-defined<br/>No encryption<br/>No auth<br/>Headless Service DNS"| TrainingPods

    %% MPI launcher flow
    LauncherPod -->|"HTTPS/443<br/>TLS 1.2+<br/>pods/exec<br/>SA RBAC"| K8sAPI

    %% Monitoring
    Prometheus -->|"HTTPS/8080<br/>TLS 1.2+<br/>PodMonitor<br/>No auth"| Metrics

    %% Optional integrations
    TrainingOp -.->|"K8s API<br/>PodGroup CRD"| Volcano
    TrainingOp -.->|"K8s API<br/>PodGroup CRD"| SchedPlugins

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef openshift fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class TrainingOp,Metrics,Health,WebhookPort,WebhookCert operator
    class TrainingPods,HeadlessSvc,NetPolicy,MPIConfigMap,MPISA,LauncherPod userns
    class Prometheus monitoring
    class Volcano,SchedPlugins optional
    class OpenShiftAPI openshift
