graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / SDK / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph OperatorPod["training-operator Pod<br/>SA: kubeflow-training-operator<br/>FIPS: strictfipsruntime"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster profile)<br/>OPA cert-controller auto-rotate"]
            Metrics["Metrics Server<br/>8080/TCP<br/>TLS (cluster profile)"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>No auth"]
        end
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACES (user namespaces)"]
        direction TB
        Workers["Worker/Master Pods<br/>Created per training job"]
        HeadlessSvc["Headless Service<br/>DNS peer discovery"]
        NetPol["NetworkPolicy<br/>(PyTorch jobs only)<br/>Ingress: same-job + monitoring"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>PodMonitor scrape"]
    end

    subgraph OpenShiftConfig["OPENSHIFT CONFIGURATION"]
        TLSProfile["APIServer Resource<br/>config.openshift.io<br/>TLS Security Profile"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| APIServer

    %% Control Plane → Webhook
    APIServer -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>Admission CA bundle"| Webhook

    %% Operator → Control Plane (outbound)
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| APIServer

    %% Operator → Created Resources
    OperatorPod -.->|"creates via API"| Workers
    OperatorPod -.->|"creates via API"| HeadlessSvc
    OperatorPod -.->|"creates via API"| NetPol

    %% Operator → OpenShift Config
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>GET apiservers/cluster"| TLSProfile

    %% Prometheus → Metrics
    Prometheus -->|"HTTP/8080<br/>TLS (cluster profile)<br/>No auth"| Metrics

    %% Worker communication
    Workers <-->|"Framework-specific<br/>inter-worker comm"| HeadlessSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef config fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class APIServer controlplane
    class Webhook,Metrics,Health operator
    class Workers,HeadlessSvc,NetPol workload
    class Prometheus monitoring
    class TLSProfile config
