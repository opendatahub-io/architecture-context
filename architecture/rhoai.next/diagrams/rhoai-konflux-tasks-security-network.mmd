graph TB
    subgraph Konflux["KONFLUX BUILD ENVIRONMENT (rhoai-tenant namespace)"]
        direction TB

        subgraph PipelineRun["PipelineRun (SA: build-pipeline-rhoai-konflux-tasks)"]
            direction TB

            Init["rhoai-init<br/>Image: UBI9<br/>No external calls"]
            Prefetch["prefetch-operand-manifests-oci-ta<br/>Image: rhoai-task-toolset<br/>Mounts: trusted-ca ConfigMap"]
            Buildah["buildah-oci-ta<br/>Container image build"]
            Scans["Security Scans<br/>Clair, ClamAV, Snyk,<br/>SAST, RPM sig, deprecated img"]
            EvalScan["evaluate-scan-results<br/>Image: alpine<br/>MODE: REPORT-ONLY"]
            SecureGit["secure-git-push<br/>leaktk-scanner pre-scan"]
            SecureOCI["secure-push-oci<br/>leaktk-scanner pre-scan<br/>Retry: up to 5 attempts"]
            TrigOp["trigger-operator-build"]
            TrigBundle["trigger-bundle-build"]
            TrigGroup["trigger-group-testing"]
            GenSnap["generate-snapshot-for-<br/>group-testing"]
            PRComment["pull-request-comment"]
            Sealights["rhoai-inject-sealights-oci-ta"]
        end

        subgraph Secrets["Kubernetes Secrets"]
            S1["rhoai-konflux-secret<br/>(Opaque)<br/>Slack webhook URL"]
            S2["odh-github-secret<br/>(Opaque)<br/>4 GitHub tokens"]
            S3["konflux-test-infra<br/>(Opaque)<br/>Bot commenter token"]
            S4["slack-config<br/>(ConfigMap)<br/>Notification templates"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        GitHubAPI["api.github.com<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        GitHubRepos["github.com<br/>(component repos)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        QuayIO["quay.io<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        SlackWH["Slack Webhook<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Task to external service flows
    Prefetch -->|HTTPS/443<br/>TLS 1.2+<br/>Git credentials| GitHubRepos
    Buildah -->|HTTPS/443<br/>TLS 1.2+<br/>Registry auth| QuayIO
    SecureGit -->|HTTPS/443<br/>TLS 1.2+<br/>Git credentials<br/>(post leaktk scan)| GitHubRepos
    SecureOCI -->|HTTPS/443<br/>TLS 1.2+<br/>Registry auth<br/>(post leaktk scan)| QuayIO
    TrigOp -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer token| GitHubAPI
    TrigBundle -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer token| GitHubAPI
    TrigGroup -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer token| GitHubAPI
    GenSnap -->|HTTPS/443<br/>TLS 1.2+<br/>None (public API)| QuayIO
    PRComment -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer token| GitHubAPI
    Sealights -->|HTTPS/443<br/>TLS 1.2+<br/>cosign attestation| QuayIO

    %% Slack notification
    Init -.->|on failure| SlackWH

    %% Secret references
    TrigOp -.->|reads| S2
    TrigBundle -.->|reads| S2
    PRComment -.->|reads| S3
    Init -.->|reads| S1
    Init -.->|reads| S4

    %% Styling
    classDef pipeline fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secret fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef security fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef reportonly fill:#fce4ec,stroke:#e74c3c,stroke-width:2px

    class Init,Prefetch,Buildah,TrigOp,TrigBundle,TrigGroup,GenSnap,PRComment,Sealights pipeline
    class SecureGit,SecureOCI security
    class Scans,EvalScan reportonly
    class S1,S2,S3,S4 secret
    class GitHubAPI,GitHubRepos,QuayIO,SlackWH external
