graph TB
    subgraph Client["CLIENT ENVIRONMENT (Jupyter / Python App)"]
        direction TB

        subgraph InProcess["IN-PROCESS (No Network)"]
            ModelWrapper["trustyai.model<br/>Model Wrappers"]
            JPypeBridge["JPype1 JVM Bridge<br/>+ JDK 17"]
            JavaLib["TrustyAI Java Library<br/>explainability-arrow JAR"]
            ArrowIPC["Apache Arrow IPC<br/>Zero-copy Transfer"]
            Explainers["Explainers<br/>LIME, SHAP, CF, PDP"]
            MetricsLocal["Metrics<br/>Fairness, Language"]
            TMaRCo["TMaRCo Detoxify<br/>(optional, torch)"]
        end

        subgraph APIClients["OPTIONAL NETWORK CLIENTS"]
            MetricsSvc["TrustyAIMetricsService<br/>token: Bearer Token<br/>verify: True (configurable)"]
        end
    end

    subgraph Cluster["OPENSHIFT CLUSTER"]
        direction TB

        RouteAPI["OpenShift Route API<br/>route.openshift.io/v1<br/>443/TCP HTTPS TLS<br/>Auth: kubeconfig"]

        subgraph UserNS["Namespace: user-project"]
            TrustyAISvc["TrustyAI Service<br/>443/TCP HTTPS<br/>TLS (Route termination)<br/>Auth: Bearer Token"]
        end

        subgraph Monitoring["Namespace: openshift-monitoring"]
            Thanos["Thanos Querier<br/>443/TCP HTTPS<br/>TLS<br/>Auth: Bearer Token"]
        end

        subgraph ModelNS["Namespace: model-namespace"]
            ModelEndpoint["Model Inference Endpoint<br/>443/TCP HTTPS<br/>TLS (Route termination)<br/>Auth: Bearer Token"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS<br/>Auth: None/API Token"]
        PyPI["PyPI<br/>pypi.org<br/>443/TCP HTTPS TLS<br/>Auth: None"]
    end

    %% Flows
    MetricsSvc -->|"HTTPS/443<br/>TLS<br/>kubeconfig"| RouteAPI
    MetricsSvc -->|"HTTPS/443<br/>TLS<br/>Bearer Token<br/>POST /data/upload<br/>GET /info<br/>POST /metrics/*"| TrustyAISvc
    MetricsSvc -->|"HTTPS/443<br/>TLS<br/>Bearer Token<br/>GET /api/v1/query"| Thanos
    MetricsSvc -->|"HTTPS/443<br/>TLS<br/>Bearer Token<br/>POST /predict"| ModelEndpoint
    TMaRCo -->|"HTTPS/443<br/>TLS<br/>Download models"| HFHub

    %% Styling
    classDef client fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef inprocess fill:#dbeafe,stroke:#4a90e2,stroke-width:1px
    classDef apiclient fill:#fef3c7,stroke:#d97706,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class ModelWrapper,JPypeBridge,JavaLib,ArrowIPC,Explainers,MetricsLocal,TMaRCo inprocess
    class MetricsSvc apiclient
    class RouteAPI,TrustyAISvc,Thanos,ModelEndpoint cluster
    class HFHub,PyPI external
