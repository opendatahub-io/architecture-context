graph TB
    subgraph UserEnv["USER ENVIRONMENT (Trusted - User Context)"]
        direction TB

        subgraph PythonProcess["Python Process"]
            Notebook["Jupyter Notebook /<br/>Python Application"]
            TrustyAISDK["trustyai SDK 0.6.1<br/>Core modules + optional extras"]
        end

        subgraph EmbeddedJVM["Embedded JVM (JPype1)"]
            JAR["TrustyAI Java Library<br/>explainability-arrow JAR<br/>JNI + Arrow IPC"]
        end

        Notebook -->|"import trustyai"| TrustyAISDK
        TrustyAISDK -->|"JNI (in-process)<br/>No network"| JAR
    end

    subgraph PlatformServices["PLATFORM SERVICES (OpenShift Cluster)"]
        direction TB

        subgraph TrustyAISvc["Namespace: {user-namespace}"]
            TrustyAIService["TrustyAI Service<br/>POST /data/upload<br/>GET /info<br/>POST /metrics/*"]
        end

        subgraph Monitoring["Namespace: openshift-monitoring"]
            Thanos["Thanos Querier<br/>GET /api/v1/query"]
        end

        subgraph ModelServing["Namespace: {model-namespace}"]
            ModelEndpoint["Model Inference Endpoint<br/>POST /v1/models/*:predict"]
        end

        K8sAPI["OpenShift API Server<br/>route.openshift.io/v1"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Internet)"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>Model downloads"]
        PyPI["PyPI<br/>pypi.org<br/>Package installation"]
    end

    %% Egress flows with security details
    TrustyAISDK -->|"HTTPS/443<br/>TLS (system OpenSSL)<br/>Bearer Token<br/>verify=True (configurable)"| TrustyAIService
    TrustyAISDK -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Thanos
    TrustyAISDK -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| ModelEndpoint
    TrustyAISDK -->|"HTTPS/443<br/>TLS<br/>kubeconfig / in-cluster"| K8sAPI
    TrustyAISDK -->|"HTTPS/443<br/>TLS<br/>None / API Token"| HFHub
    TrustyAISDK -->|"HTTPS/443<br/>TLS<br/>None"| PyPI

    %% Styling
    classDef userenv fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef platform fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef external fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef warning fill:#ffebee,stroke:#c62828,stroke-width:2px

    class Notebook,TrustyAISDK userenv
    class JAR userenv
    class TrustyAIService,Thanos,ModelEndpoint,K8sAPI platform
    class HFHub,PyPI external
