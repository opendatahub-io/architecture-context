graph TB
    subgraph Pod["KServe ServingRuntime Pod"]
        direction TB

        subgraph TransformerContainer["transformer-container"]
            CaikitRuntime["Caikit Runtime<br/>(python -m caikit.runtime)"]
            CaikitLib["caikit 0.28.1"]
            CaikitNLP["caikit-nlp 0.5.14"]
            CaikitTGISBackend["caikit-tgis-backend 0.1.39"]
            CaikitConfig["caikit.yml<br/>(CONFIG_FILES)"]
            HealthProbe["caikit_health_probe<br/>(readiness + liveness)"]

            CaikitRuntime -->|imports| CaikitLib
            CaikitRuntime -->|imports| CaikitNLP
            CaikitRuntime -->|imports| CaikitTGISBackend
            CaikitRuntime -->|reads| CaikitConfig
            HealthProbe -->|checks| CaikitRuntime
        end

        subgraph KServeContainer["kserve-container"]
            TGIS["TGIS<br/>(Text Generation Inference Server)<br/>Loads model weights"]
        end

        subgraph InitContainer["init-container"]
            StorageInit["KServe Storage Initializer<br/>Downloads model artifacts"]
        end

        ModelVolume[("/mnt/models<br/>(Shared Volume)")]

        StorageInit -->|writes| ModelVolume
        TGIS -->|reads| ModelVolume
        CaikitRuntime -->|"gRPC :8033<br/>(localhost)"| TGIS
    end

    Client["External Client"] -->|"HTTPS :443"| IstioGW["Istio Ingress Gateway"]
    IstioGW -->|"HTTP :8012<br/>mTLS"| QueueProxy["Knative Queue-Proxy"]
    QueueProxy -->|"HTTP :8080<br/>mTLS"| CaikitRuntime

    GRPCClient["gRPC Client"] -->|"gRPC :8085<br/>(h2c, optional)"| CaikitRuntime

    Prometheus["Prometheus"] -->|"HTTP :8086<br/>(PERMISSIVE)"| CaikitRuntime

    ConvertTool["convert.py<br/>(Utility)"] -->|"HTTPS :443"| HFHub["HuggingFace Hub"]

    ModelStorage["Model Storage<br/>(S3 / PVC)"] -->|"volume mount"| StorageInit

    style CaikitRuntime fill:#4a90e2,stroke:#333,color:#fff
    style TGIS fill:#4a90e2,stroke:#333,color:#fff
    style StorageInit fill:#4a90e2,stroke:#333,color:#fff
    style CaikitLib fill:#7ed321,stroke:#333
    style CaikitNLP fill:#7ed321,stroke:#333
    style CaikitTGISBackend fill:#7ed321,stroke:#333
    style CaikitConfig fill:#f5a623,stroke:#333
    style HealthProbe fill:#f5a623,stroke:#333
    style IstioGW fill:#e8e8e8,stroke:#333
    style QueueProxy fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style ModelStorage fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style ModelVolume fill:#fff2cc,stroke:#d6b656
    style ConvertTool fill:#d5e8d4,stroke:#82b366
