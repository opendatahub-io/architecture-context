graph TB
    subgraph CaikitTGIS["Caikit-TGIS-Serving Pod"]
        direction TB
        subgraph TransformerContainer["transformer-container"]
            CaikitRuntime["Caikit Runtime<br/>(python -m caikit.runtime)<br/>Python 3.11"]
            GRPC_API["gRPC API<br/>8085/TCP"]
            HTTP_API["HTTP API<br/>8080/TCP"]
            HealthProbe["caikit_health_probe<br/>Readiness / Liveness"]
            CaikitRuntime --> GRPC_API
            CaikitRuntime --> HTTP_API
            CaikitRuntime --> HealthProbe
        end

        subgraph KServeContainer["kserve-container"]
            TGIS["TGIS<br/>(text-generation-inference)<br/>8033/TCP gRPC"]
        end

        CaikitRuntime -->|"gRPC localhost:8033<br/>TGIS-AUTO finder"| TGIS
    end

    subgraph ConvertUtil["Utilities"]
        Convert["utils/convert.py<br/>HuggingFace → Caikit<br/>model format conversion"]
    end

    Client["External Client"] -->|"HTTPS 443/TCP"| IngressGW["Knative Ingress Gateway<br/>TLS SIMPLE"]
    IngressGW -->|"mTLS"| CaikitRuntime

    subgraph ServingRuntimes["KServe ServingRuntime Definitions"]
        CTGRPC["caikit-tgis-runtime-grpc"]
        CTHTTP["caikit-tgis-runtime"]
        CSGRPC["caikit-standalone-runtime-grpc"]
        CSHTTP["caikit-standalone-runtime"]
    end

    ServingRuntimes -.->|"defines pod topology"| CaikitTGIS

    ISVC["InferenceService CR"] -->|"watched by"| KServe["KServe Controller"]
    KServe -->|"creates"| CaikitTGIS

    TGIS -->|"S3 API"| S3["S3-Compatible Storage<br/>Model Artifacts"]
    Prometheus["Prometheus<br/>openshift-user-workload-monitoring"] -->|"HTTP 8086/TCP<br/>PERMISSIVE mTLS"| Metrics["Metrics Endpoint<br/>8086/TCP"]

    CaikitRuntime --> Metrics

    style CaikitRuntime fill:#4a90e2,color:#fff
    style TGIS fill:#4a90e2,color:#fff
    style GRPC_API fill:#50a0e2,color:#fff
    style HTTP_API fill:#50a0e2,color:#fff
    style IngressGW fill:#f5a623,color:#fff
    style KServe fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style ISVC fill:#f5a623,stroke:#333
    style Convert fill:#7ed321,stroke:#333
