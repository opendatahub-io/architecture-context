graph TB
    subgraph CaikitTGIS["Caikit-TGIS Serving Pod (KServe Multi-Container)"]
        direction TB

        subgraph TransformerContainer["transformer-container"]
            CaikitRuntime["Caikit Runtime<br/>(python -m caikit.runtime)"]
            CaikitLib["caikit v0.28.1<br/>AI Toolkit Framework"]
            CaikitNLP["caikit-nlp v0.5.14<br/>NLP Text Generation"]
            CaikitTGISBackend["caikit-tgis-backend v0.1.39<br/>gRPC Connector to TGIS"]
            HealthProbe["caikit_health_probe<br/>Health Check Utility"]

            CaikitRuntime --> CaikitLib
            CaikitRuntime --> CaikitNLP
            CaikitRuntime --> CaikitTGISBackend
            CaikitRuntime --> HealthProbe
        end

        subgraph KServeContainer["kserve-container"]
            TGIS["TGIS<br/>(Text Generation Inference Server)<br/>Actual LLM Inference"]
        end

        CaikitTGISBackend -->|"gRPC<br/>localhost:8033"| TGIS
    end

    subgraph ExternalAPIs["Exposed APIs"]
        HTTP["HTTP API<br/>Port 8080/TCP"]
        GRPC["gRPC API<br/>Port 8085/TCP"]
        Metrics["Metrics<br/>Port 8086/TCP"]
    end

    HTTP -->|"POST /api/v1/task/text-generation<br/>POST /api/v1/task/server-streaming-text-generation"| CaikitRuntime
    GRPC -->|"TextGenerationTaskPredict<br/>ServerStreamingTextGenerationTaskPredict"| CaikitRuntime
    Metrics -->|"caikit_* metrics"| CaikitRuntime
    HealthProbe -->|"GET /health"| HTTP

    ModelVolume["/mnt/models/<br/>PVC Mount"]
    ModelVolume -->|"model artifacts<br/>(Caikit format)"| CaikitRuntime
    ModelVolume -->|"model weights"| TGIS

    ConvertPy["convert.py<br/>HuggingFace → Caikit<br/>Format Converter"]
    ConvertPy -.->|"offline conversion"| ModelVolume

    Client["External Client"] -->|"HTTPS/443"| IstioGW["Istio IngressGateway"]
    IstioGW -->|"mTLS"| HTTP
    IstioGW -->|"mTLS"| GRPC

    Prometheus["Prometheus<br/>(openshift-user-workload-monitoring)"] -->|"HTTP/8086<br/>PERMISSIVE mTLS"| Metrics

    style CaikitRuntime fill:#4a90e2,stroke:#333,color:#fff
    style TGIS fill:#4a90e2,stroke:#333,color:#fff
    style CaikitLib fill:#6ba4e8,stroke:#333,color:#fff
    style CaikitNLP fill:#6ba4e8,stroke:#333,color:#fff
    style CaikitTGISBackend fill:#6ba4e8,stroke:#333,color:#fff
    style HealthProbe fill:#6ba4e8,stroke:#333,color:#fff
    style HTTP fill:#f5a623,stroke:#333
    style GRPC fill:#f5a623,stroke:#333
    style Metrics fill:#f5a623,stroke:#333
    style ModelVolume fill:#7ed321,stroke:#333
    style ConvertPy fill:#b8e986,stroke:#333
    style Client fill:#e8e8e8,stroke:#333
    style IstioGW fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
