graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Engine["llm-d Inference Engine<br/>(data source)"]
        Router["llm-d Routing Layer<br/>(prediction consumer)"]
    end

    subgraph ServiceLayer["SERVICE LAYER (No mTLS, No NetworkPolicy)"]
        direction TB

        subgraph NS_Default["Namespace: default"]
            PredSvc["prediction-service<br/>LoadBalancer 80/TCP -> 8001/TCP<br/>HTTP plaintext<br/>Auth: None<br/>SA: default<br/>Replicas: 10"]

            TrainSvc["training-service<br/>ClusterIP 8000/TCP -> 8000/TCP<br/>HTTP plaintext<br/>Auth: None<br/>SA: default<br/>Replicas: 1"]

            TrainSvcExt["training-service-external<br/>LoadBalancer 8080/TCP -> 8000/TCP<br/>HTTP plaintext<br/>Auth: None<br/>(optional)"]
        end
    end

    subgraph Storage["STORAGE"]
        PVC["PVC /models/*.joblib<br/>ReadWriteOnce<br/>Serialized ML models"]
        EmptyDir["emptyDir /local_models/*.joblib<br/>Cached model copies<br/>Atomic file replacement"]
    end

    %% Data ingestion flow
    Engine -->|"HTTP/8000<br/>POST /add_training_data_bulk<br/>No encryption<br/>No auth"| TrainSvc

    %% Prediction flow
    Router -->|"HTTP/80<br/>POST /predict, /predict/bulk/strict<br/>No encryption<br/>No auth"| PredSvc

    %% Model sync flow
    PredSvc -->|"HTTP/8000<br/>GET /model/download<br/>No encryption<br/>No auth<br/>MD5 checksum (non-crypto)"| TrainSvc

    %% Storage flows
    TrainSvc -->|"filesystem<br/>Write models"| PVC
    PredSvc -->|"filesystem<br/>Cache models"| EmptyDir

    %% Optional external access
    TrainSvcExt -.->|"forwards to"| TrainSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Engine,Router external
    class PredSvc,TrainSvc,TrainSvcExt service
    class PVC,EmptyDir storage
