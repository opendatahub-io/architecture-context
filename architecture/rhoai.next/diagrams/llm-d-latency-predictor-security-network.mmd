graph TB
    subgraph External["EXTERNAL (Untrusted -- No Auth)"]
        RoutingLayer["llm-d Routing Layer<br/>(Consumer)"]
        PrometheusExt["Prometheus<br/>(Monitoring)"]
    end

    subgraph K8sServices["KUBERNETES SERVICES (No Network Policies / No Service Mesh)"]
        direction TB

        subgraph PredSvc["prediction-service (LoadBalancer)"]
            PredLB["Port: 80/TCP -> 8001/TCP<br/>Protocol: HTTP<br/>Encryption: None<br/>Auth: None<br/>Exposure: External"]
        end

        subgraph TrainSvc["training-service (ClusterIP)"]
            TrainCIP["Port: 8000/TCP -> 8000/TCP<br/>Protocol: HTTP<br/>Encryption: None<br/>Auth: None<br/>Exposure: Internal"]
        end

        subgraph TrainSvcExt["training-service-external (LoadBalancer) -- OPTIONAL"]
            TrainLB["Port: 8080/TCP -> 8000/TCP<br/>Protocol: HTTP<br/>Encryption: None<br/>Auth: None<br/>Exposure: External<br/>WARNING: Data poisoning risk"]
        end

        subgraph NS_Default["Namespace: default"]
            PredPod["prediction-server<br/>Image: odh-latency-predictor-prediction<br/>Base: AIPCC cpu:3.5.0 (UBI9)<br/>SA: default<br/>Port: 8001/TCP<br/>Workers: 8 (uvicorn)<br/>Replicas: 10"]

            TrainPod["training-server<br/>Image: odh-latency-predictor-training<br/>Base: AIPCC cpu:3.5.0 (UBI9)<br/>SA: default<br/>Port: 8000/TCP<br/>Replicas: 1"]

            PVC["PVC /models/<br/>ttft.joblib, tpot.joblib"]
        end
    end

    %% External to Services
    RoutingLayer -->|"HTTP/80<br/>No Encryption<br/>No Auth<br/>POST /predict/bulk/strict"| PredLB
    RoutingLayer -->|"HTTP/8000<br/>No Encryption<br/>No Auth<br/>POST /add_training_data_bulk"| TrainCIP
    PrometheusExt -->|"HTTP/8000<br/>No Encryption<br/>No Auth<br/>GET /metrics"| TrainCIP

    %% Services to Pods
    PredLB --> PredPod
    TrainCIP --> TrainPod
    TrainLB --> TrainPod

    %% Inter-pod communication
    PredPod -->|"HTTP/8000<br/>No Encryption<br/>No Auth<br/>GET /model/{name}/download<br/>(model sync every 10s)"| TrainPod

    %% Storage
    TrainPod -->|"Filesystem<br/>/models/<br/>joblib write"| PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef lbservice fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cipservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warnservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class RoutingLayer,PrometheusExt external
    class PredLB lbservice
    class TrainCIP cipservice
    class TrainLB warnservice
    class PredPod,TrainPod pod
    class PVC storage
