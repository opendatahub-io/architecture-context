graph TD
    subgraph "Service Accounts"
        SA_Prom["prometheus<br/>(redhat-ods-monitoring)"]
        SA_MM["modelmesh-controller<br/>(redhat-ods-applications)"]
        SA_NBC["notebook-controller-service-account<br/>(redhat-ods-applications)"]
        SA_ModelCtrl["odh-model-controller<br/>(redhat-ods-applications)"]
        SA_Dashboard["rhods-dashboard<br/>(redhat-ods-applications)"]
        SA_ModelMesh["modelmesh<br/>(redhat-ods-applications)"]
        SA_AllMon["All SAs<br/>(redhat-ods-monitoring)"]
    end

    subgraph "ClusterRoleBindings"
        CRB_Scraper["prometheus-scraper<br/>(ClusterRoleBinding)"]
    end

    subgraph "RoleBindings"
        RB_AppSCC["rhods-applications-scc<br/>(redhat-ods-applications)"]
        RB_MonSCC["rhods-monitoring-scc<br/>(redhat-ods-monitoring)"]
        RB_PromViewer["rhods-prometheus-viewer<br/>(redhat-ods-applications)"]
    end

    subgraph "ClusterRoles"
        CR_Scraper["prometheus-scraper<br/>(ClusterRole)"]
        CR_View["view<br/>(ClusterRole)"]
    end

    subgraph "SCC Roles"
        SCC_AnyUID["system:openshift:scc:anyuid"]
    end

    subgraph "API Resources - prometheus-scraper"
        R_TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>[create]"]
        R_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>[create]"]
        R_Namespaces["core<br/>namespaces<br/>[get]"]
        R_RouterMetrics["route.openshift.io<br/>routers/metrics, routers/federate<br/>[get]"]
        R_RegistryMetrics["image.openshift.io<br/>registry/metrics<br/>[get]"]
        R_Discovery["core<br/>endpoints, pods, services, namespaces<br/>[list, get, watch]"]
    end

    subgraph "Network Policies"
        NP_Apps["redhat-ods-applications<br/>Ingress: 8443, 8080, 8081,<br/>5432, 8082, 8099, 8181 TCP<br/>From: any + labeled NS"]
        NP_Mon["redhat-ods-monitoring<br/>Ingress: 443, 9115, 8443,<br/>9091, 10443 TCP<br/>From: any + labeled NS"]
        NP_Op["redhat-ods-operator<br/>Pod: name=rhods-operator<br/>From: labeled NS only"]
    end

    %% ClusterRole bindings
    SA_Prom -->|bound via| CRB_Scraper
    CRB_Scraper -->|grants| CR_Scraper

    %% ClusterRole permissions
    CR_Scraper -->|create| R_TokenReviews
    CR_Scraper -->|create| R_SAR
    CR_Scraper -->|get| R_Namespaces
    CR_Scraper -->|get| R_RouterMetrics
    CR_Scraper -->|get| R_RegistryMetrics
    CR_Scraper -->|list, get, watch| R_Discovery

    %% SCC bindings - applications namespace
    SA_MM -->|bound via| RB_AppSCC
    SA_NBC -->|bound via| RB_AppSCC
    SA_ModelCtrl -->|bound via| RB_AppSCC
    SA_Dashboard -->|bound via| RB_AppSCC
    SA_ModelMesh -->|bound via| RB_AppSCC
    RB_AppSCC -->|grants| SCC_AnyUID

    %% SCC bindings - monitoring namespace
    SA_AllMon -->|bound via| RB_MonSCC
    RB_MonSCC -->|grants| SCC_AnyUID

    %% Prometheus viewer binding
    SA_Prom -->|bound via| RB_PromViewer
    RB_PromViewer -->|grants| CR_View

    style SA_Prom fill:#4a90e2,stroke:#333,color:#fff
    style SA_MM fill:#4a90e2,stroke:#333,color:#fff
    style SA_NBC fill:#4a90e2,stroke:#333,color:#fff
    style SA_ModelCtrl fill:#4a90e2,stroke:#333,color:#fff
    style SA_Dashboard fill:#4a90e2,stroke:#333,color:#fff
    style SA_ModelMesh fill:#4a90e2,stroke:#333,color:#fff
    style SA_AllMon fill:#4a90e2,stroke:#333,color:#fff

    style CR_Scraper fill:#f5a623,stroke:#333,color:#fff
    style CR_View fill:#f5a623,stroke:#333,color:#fff
    style SCC_AnyUID fill:#e74c3c,stroke:#333,color:#fff

    style R_TokenReviews fill:#7ed321,stroke:#333
    style R_SAR fill:#7ed321,stroke:#333
    style R_Namespaces fill:#7ed321,stroke:#333
    style R_RouterMetrics fill:#7ed321,stroke:#333
    style R_RegistryMetrics fill:#7ed321,stroke:#333
    style R_Discovery fill:#7ed321,stroke:#333

    style NP_Apps fill:#dae8fc,stroke:#6c8ebf
    style NP_Mon fill:#dae8fc,stroke:#6c8ebf
    style NP_Op fill:#dae8fc,stroke:#6c8ebf
