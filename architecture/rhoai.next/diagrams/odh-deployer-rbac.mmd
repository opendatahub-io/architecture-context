graph TD
    subgraph ServiceAccounts["Service Accounts"]
        PromSA["prometheus<br/>(redhat-ods-monitoring)"]
        MMCtrlSA["modelmesh-controller<br/>(redhat-ods-applications)"]
        NBCSA["notebook-controller-service-account<br/>(redhat-ods-applications)"]
        ModelCtrlSA["odh-model-controller<br/>(redhat-ods-applications)"]
        DashSA["rhods-dashboard<br/>(redhat-ods-applications)"]
        MMSA["modelmesh<br/>(redhat-ods-applications)"]
        AllMonSA["All SAs<br/>(redhat-ods-monitoring)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB1["prometheus-scraper<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB1["rhods-applications-scc<br/>(redhat-ods-applications)"]
        RB2["rhods-monitoring-scc<br/>(redhat-ods-monitoring)"]
        RB3["rhods-prometheus-viewer<br/>(redhat-ods-applications)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR1["prometheus-scraper"]
    end

    subgraph SCCRoles["SCC Roles"]
        SCC1["system:openshift:scc:anyuid"]
    end

    subgraph ViewRole["View Role"]
        View1["view<br/>(built-in)"]
    end

    subgraph APIResources["API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        Namespaces["core<br/>namespaces"]
        RouteMetrics["route.openshift.io<br/>routers/metrics,<br/>routers/federate"]
        ImageMetrics["image.openshift.io<br/>registry/metrics"]
        CoreResources["core<br/>endpoints, pods,<br/>services, namespaces"]
    end

    %% Prometheus ClusterRole chain
    PromSA -->|"bound via"| CRB1
    CRB1 -->|"grants"| CR1
    CR1 -->|"create"| TokenReviews
    CR1 -->|"create"| SAR
    CR1 -->|"get"| Namespaces
    CR1 -->|"get"| RouteMetrics
    CR1 -->|"get"| ImageMetrics
    CR1 -->|"list, get, watch"| CoreResources

    %% SCC bindings (applications)
    MMCtrlSA -->|"bound via"| RB1
    NBCSA -->|"bound via"| RB1
    ModelCtrlSA -->|"bound via"| RB1
    DashSA -->|"bound via"| RB1
    MMSA -->|"bound via"| RB1
    RB1 -->|"grants"| SCC1

    %% SCC bindings (monitoring)
    AllMonSA -->|"bound via"| RB2
    RB2 -->|"grants"| SCC1

    %% View binding
    PromSA -->|"bound via"| RB3
    RB3 -->|"grants"| View1

    %% Styling
    style PromSA fill:#4a90e2
    style CR1 fill:#f5a623
    style SCC1 fill:#e74c3c,color:#fff
    style View1 fill:#7ed321
    style TokenReviews fill:#d5e8d4
    style SAR fill:#d5e8d4
    style Namespaces fill:#d5e8d4
    style RouteMetrics fill:#d5e8d4
    style ImageMetrics fill:#d5e8d4
    style CoreResources fill:#d5e8d4
