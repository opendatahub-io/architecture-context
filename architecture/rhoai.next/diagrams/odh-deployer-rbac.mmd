graph TD
    subgraph "Service Accounts"
        SA_Prom["SA: prometheus<br/>Namespace: redhat-ods-monitoring"]
        SA_MMC["SA: modelmesh-controller<br/>Namespace: redhat-ods-applications"]
        SA_NBC["SA: notebook-controller-service-account<br/>Namespace: redhat-ods-applications"]
        SA_OMC["SA: odh-model-controller<br/>Namespace: redhat-ods-applications"]
        SA_Dash["SA: rhods-dashboard<br/>Namespace: redhat-ods-applications"]
        SA_MM["SA: modelmesh<br/>Namespace: redhat-ods-applications"]
        SA_AllMon["All SAs<br/>Namespace: redhat-ods-monitoring"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Scraper["ClusterRoleBinding:<br/>prometheus-scraper<br/>(cluster-wide)"]
        RB_AppsSCC["RoleBinding:<br/>rhods-applications-scc<br/>(redhat-ods-applications)"]
        RB_MonSCC["RoleBinding:<br/>rhods-monitoring-scc<br/>(redhat-ods-monitoring)"]
        RB_PromViewer["RoleBinding:<br/>rhods-prometheus-viewer<br/>(redhat-ods-applications)"]
    end

    subgraph "Roles"
        CR_Scraper["ClusterRole:<br/>prometheus-scraper"]
        SCC_AnyUID["SCC Role:<br/>system:openshift:scc:anyuid"]
        Role_View["ClusterRole:<br/>view"]
    end

    subgraph "API Resources (prometheus-scraper)"
        TR["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
        NS["core<br/>namespaces<br/>Verbs: get"]
        EPods["core<br/>endpoints, pods, services,<br/>namespaces<br/>Verbs: list, get, watch"]
        RouterM["route.openshift.io<br/>routers/metrics,<br/>routers/federate<br/>Verbs: get"]
        RegM["image.openshift.io<br/>registry/metrics<br/>Verbs: get"]
    end

    subgraph "SCC Capabilities (anyuid)"
        AnyUID["Allows running containers<br/>as any UID<br/>(bypasses restricted SCC)"]
    end

    subgraph "View Role Capabilities"
        ViewCap["Read-only access to<br/>most namespaced resources<br/>in redhat-ods-applications"]
    end

    %% prometheus-scraper bindings
    SA_Prom -->|"bound via"| CRB_Scraper
    CRB_Scraper -->|"grants"| CR_Scraper
    CR_Scraper -->|"create"| TR
    CR_Scraper -->|"create"| SAR
    CR_Scraper -->|"get"| NS
    CR_Scraper -->|"list, get, watch"| EPods
    CR_Scraper -->|"get"| RouterM
    CR_Scraper -->|"get"| RegM

    %% SCC bindings - applications namespace
    SA_MMC -->|"bound via"| RB_AppsSCC
    SA_NBC -->|"bound via"| RB_AppsSCC
    SA_OMC -->|"bound via"| RB_AppsSCC
    SA_Dash -->|"bound via"| RB_AppsSCC
    SA_MM -->|"bound via"| RB_AppsSCC
    RB_AppsSCC -->|"grants"| SCC_AnyUID
    SCC_AnyUID -->|"allows"| AnyUID

    %% SCC bindings - monitoring namespace
    SA_AllMon -->|"bound via"| RB_MonSCC
    RB_MonSCC -->|"grants"| SCC_AnyUID

    %% Prometheus viewer binding
    SA_Prom -->|"bound via"| RB_PromViewer
    RB_PromViewer -->|"grants"| Role_View
    Role_View -->|"read-only"| ViewCap

    %% Styling
    style SA_Prom fill:#4a90e2,stroke:#333,color:#fff
    style SA_MMC fill:#4a90e2,stroke:#333,color:#fff
    style SA_NBC fill:#4a90e2,stroke:#333,color:#fff
    style SA_OMC fill:#4a90e2,stroke:#333,color:#fff
    style SA_Dash fill:#4a90e2,stroke:#333,color:#fff
    style SA_MM fill:#4a90e2,stroke:#333,color:#fff
    style SA_AllMon fill:#4a90e2,stroke:#333,color:#fff

    style CR_Scraper fill:#f5a623,stroke:#333
    style SCC_AnyUID fill:#f5a623,stroke:#333
    style Role_View fill:#f5a623,stroke:#333

    style TR fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style NS fill:#7ed321,stroke:#333
    style EPods fill:#7ed321,stroke:#333
    style RouterM fill:#7ed321,stroke:#333
    style RegM fill:#7ed321,stroke:#333
    style AnyUID fill:#e8e8e8,stroke:#333
    style ViewCap fill:#e8e8e8,stroke:#333
