graph TB
    subgraph External["EXTERNAL (Monitoring)"]
        Prometheus["Prometheus"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (applicationsNamespace)"]
        direction TB

        subgraph ModuleOperator["ray-module-operator"]
            ModOp["ray-module-operator<br/>SA: controller-manager<br/>Image: rhoai/odh-ray-module-operator-rhel9<br/>FIPS: strictfipsruntime + UBI9-pqc"]
            ModHealth["Health: 8081/TCP HTTP"]
            ModMetrics["Metrics: 8443/TCP HTTPS<br/>Bearer token authn/authz"]
        end

        subgraph KubeRayOperand["kuberay-operator (operand)"]
            KubeRay["kuberay-operator<br/>SA: kuberay-operator<br/>Image: kuberay-operator:v1.6.2"]
            KRHealth["Health: 8082/TCP HTTP"]
            KRMetrics["Service: 8080/TCP HTTP"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
    end

    subgraph CRDDeps["CRD DEPENDENCIES"]
        CertManager["cert-manager<br/>(Issuer, Certificate CRDs)"]
        GatewayAPI["Gateway API<br/>(HTTPRoute, Gateway)"]
        OSRoutes["OpenShift Routes<br/>(Ray Dashboard)"]
    end

    %% Flows
    ModOp -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SSA apply, CR watch, status| K8sAPI
    KubeRay -->|HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Ray workload mgmt| K8sAPI
    Prometheus -->|HTTP/8080<br/>No encryption<br/>No auth<br/>prometheus.io/scrape| KRMetrics

    KubeRay -.->|CRD dependency| CertManager
    KubeRay -.->|CRD CRUD| GatewayAPI
    KubeRay -.->|CRD CRUD| OSRoutes

    ModOp -->|deploys/manages| KubeRay

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef crddep fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Prometheus external
    class ModOp,ModHealth,ModMetrics,KubeRay,KRHealth,KRMetrics operator
    class K8sAPI controlplane
    class CertManager,GatewayAPI,OSRoutes crddep
