graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Cluster Admin<br/>kubectl / oc"]
        GitRepo["GitHub / Image Registry<br/>HTTPS / TLS"]
    end

    subgraph ControlPlane["CONTROL PLANE (Kubernetes API)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC + ServiceAccount"]
    end

    subgraph PlatformNamespace["PLATFORM NAMESPACE (opendatahub)"]
        direction TB

        subgraph KfDefDeploy["Deployment Orchestration"]
            KfDefOp["KfDef Operator<br/>SA: kfdef-controller"]
        end

        subgraph ModelServing["Model Serving Control"]
            ModelCtrl["odh-model-controller<br/>3 replicas (HA)<br/>SA: odh-model-controller<br/>Leader Election"]
            KubeRBAC["kube-rbac-proxy<br/>8080/TCP<br/>TokenReview + SAR"]
        end

        subgraph DashboardStack["Dashboard"]
            DashboardPod["odh-dashboard / rhods-dashboard<br/>OAuth Proxy<br/>SA: odh-dashboard"]
        end
    end

    subgraph MonitoringNamespace["MONITORING NAMESPACE (redhat-ods-monitoring)"]
        Prometheus["Prometheus<br/>SA: kserve-prometheus-k8s"]
    end

    subgraph IstioNamespace["SERVICE MESH NAMESPACE"]
        IstioCtrl["Istio / Service Mesh<br/>VirtualService + PeerAuth"]
    end

    %% External flows
    Admin -->|"kubectl apply KfDef<br/>HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| K8sAPI
    KfDefOp -->|"Fetch manifests<br/>HTTPS/443<br/>TLS<br/>Token / Pull Secret"| GitRepo

    %% KfDef to K8s API
    KfDefOp -->|"Apply manifests<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA bearer"| K8sAPI

    %% Model Controller flows
    ModelCtrl -->|"Watch InferenceService<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA bearer"| K8sAPI
    ModelCtrl -->|"CRUD VirtualService<br/>PeerAuthentication<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA bearer"| IstioCtrl
    ModelCtrl -->|"Create Route<br/>NetworkPolicy<br/>ServiceMonitor<br/>HTTPS/6443"| K8sAPI

    %% Metrics
    Prometheus -->|"GET /metrics<br/>HTTP/8080<br/>kube-rbac-proxy<br/>TokenReview"| KubeRBAC
    KubeRBAC -->|proxy| ModelCtrl

    %% Health probes
    K8sAPI -->|"GET /healthz /readyz<br/>HTTP/8081<br/>No auth"| ModelCtrl

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef mesh fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Admin,GitRepo external
    class K8sAPI controlplane
    class KfDefOp,ModelCtrl,KubeRBAC,DashboardPod platform
    class Prometheus monitoring
    class IstioCtrl mesh
