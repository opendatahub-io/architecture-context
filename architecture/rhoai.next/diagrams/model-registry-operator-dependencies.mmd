graph LR
    MRO["Model Registry<br/>Operator"]

    %% External Dependencies (required)
    MRO -->|"operator framework<br/>(required)"| CR["controller-runtime<br/>v0.24.1"]

    %% External Dependencies (optional)
    MRO -->|"HTTPRoute & ReferenceGrant<br/>(optional)"| GatewayAPI["gateway-api<br/>v1.6.0"]
    MRO -->|"Route, User, Config APIs<br/>(optional, OpenShift)"| OSAPI["openshift/api<br/>v0.0.0-20260601"]
    MRO -->|"scheme registration<br/>(optional)"| Istio["istio/client-go<br/>v1.30.2"]
    MRO -->|"TLS profile mgmt<br/>(optional)"| OSCRC["openshift/controller-<br/>runtime-common"]

    %% Data backends
    MRO -->|"metadata backend<br/>5432/TCP<br/>auto-provisionable"| PostgreSQL["PostgreSQL 16"]
    MRO -->|"alternative backend<br/>3306/TCP"| MySQL["MySQL"]

    %% Auth proxy
    MRO -->|"auth sidecar<br/>8443/TCP HTTPS"| KRBProxy["kube-rbac-proxy"]

    %% Internal Platform Dependencies
    MRO -.->|"reads default registry config<br/>CRD Watch"| RHODSOp["rhods-operator /<br/>opendatahub-operator"]
    MRO -.->|"reads admin groups<br/>CRD Watch"| PlatformAuth["Platform Auth<br/>Service"]
    MRO -.->|"HTTPRoutes reference<br/>Gateway API"| DSGateway["Data Science<br/>Gateway"]
    MRO -.->|"creates Routes<br/>HTTPS access"| OSIngress["OpenShift Ingress<br/>Controller"]
    MRO -.->|"TLS cert generation<br/>annotations"| ServiceCA["OpenShift<br/>service-ca operator"]
    MRO -.->|"webhook TLS<br/>(optional)"| CertManager["cert-manager"]
    MRO -.->|"CRD migration<br/>v1alpha1 → v1beta1"| SVMAPI["StorageVersion<br/>Migration API"]

    %% Reverse integrations (things that depend on MRO)
    Dashboard["RHOAI Dashboard"] -.->|"UI management"| MRO
    K8sAPI["Kubernetes API<br/>6443/TCP"] -.->|"resource CRUD<br/>TokenReview/SAR"| MRO
    Prometheus["Prometheus"] -.->|"metrics scrape<br/>8443/TCP HTTPS"| MRO

    %% Styling
    style MRO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style CR fill:#999,stroke:#333
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style MySQL fill:#4479a1,stroke:#333,color:#fff
    style KRBProxy fill:#999,stroke:#333

    %% Optional external
    style GatewayAPI fill:#bbb,stroke:#333
    style OSAPI fill:#bbb,stroke:#333
    style Istio fill:#bbb,stroke:#333
    style OSCRC fill:#bbb,stroke:#333

    %% Internal platform (green)
    style RHODSOp fill:#7ed321,stroke:#333
    style PlatformAuth fill:#7ed321,stroke:#333
    style DSGateway fill:#7ed321,stroke:#333
    style OSIngress fill:#7ed321,stroke:#333
    style ServiceCA fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333
    style SVMAPI fill:#7ed321,stroke:#333

    %% Reverse / external services (orange)
    style Dashboard fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
