graph TB
    subgraph TrainingHub["training-hub (Python Library)"]
        direction TB

        subgraph Core["Core Plugin Architecture"]
            Registry["AlgorithmRegistry<br/>create_algorithm() factory"]
            AlgorithmABC["Algorithm ABC"]
            BackendABC["Backend ABC"]
            AlgorithmABC -->|"registered in"| Registry
            BackendABC -->|"registered in"| Registry
        end

        subgraph Algorithms["Training Algorithms"]
            SFT["SFTAlgorithm<br/>Full-parameter SFT"]
            OSFT["OSFTAlgorithm<br/>Orthogonal Subspace FT"]
            LoRASFT["LoRASFTAlgorithm<br/>LoRA/QLoRA SFT"]
            LoRAGRPO["LoRAGRPOAlgorithm<br/>LoRA + GRPO RL"]
            GEPA["GEPAAlgorithm<br/>Gradient-free Prompt Opt"]
        end

        subgraph Backends["Backend Implementations"]
            ILabBackend["InstructLabTraining<br/>SFTBackend"]
            MiniTrainerBackend["MiniTrainer<br/>OSFTBackend"]
            UnslothBackend["Unsloth<br/>LoRABackend"]
            ARTBackend["ART<br/>LoRAGRPOBackend"]
            VeRLBackend["VeRL<br/>LoRAGRPOBackend"]
            GEPABackend["GEPABackend /<br/>MLflowGEPABackend"]
        end

        subgraph Support["Support Modules"]
            PEFTExtender["LoRAPEFTExtender<br/>LoRA hyperparams"]
            Rewards["Reward Functions<br/>tool_call / binary"]
            ITSRollout["ITSRollout<br/>ITS Hub adapter"]
            AgentLoop["SingleTurnTool<br/>AgentLoop (verl)"]
        end

        subgraph Profiling["Profiling & Visualization"]
            MemEst["Memory Estimators<br/>Basic/OSFT/LoRA/QLoRA"]
            TimeEst["TimingEstimator<br/>Experimental"]
            PlotLoss["plot_loss<br/>Loss curve viz"]
        end

        subgraph Plugins["Coding Agent Plugins"]
            ClaudePlugin["claude-plugin/"]
            CodexPlugin["codex-plugin/"]
        end

        SFT -->|"backend"| ILabBackend
        OSFT -->|"backend"| MiniTrainerBackend
        LoRASFT -->|"backend"| UnslothBackend
        LoRAGRPO -->|"backend"| ARTBackend
        LoRAGRPO -->|"backend"| VeRLBackend
        GEPA -->|"backend"| GEPABackend
    end

    User["User Script /<br/>Notebook / CLI"] -->|"sft() osft() lora_sft()<br/>lora_grpo() grpo() gepa()"| Registry

    %% External framework dependencies
    ILabBackend -->|"imports"| ILabTraining["instructlab-training"]
    MiniTrainerBackend -->|"imports"| MiniTrainer["rhai-innovation-mini-trainer"]
    UnslothBackend -->|"imports"| Unsloth["unsloth"]
    ARTBackend -->|"subprocess"| ART["openpipe-art + vLLM"]
    VeRLBackend -->|"subprocess"| VeRL["verl"]
    GEPABackend -->|"imports"| GEPALib["gepa / mlflow"]

    %% Common dependencies
    TrainingHub -->|"core dep"| PyTorch["PyTorch + NCCL"]
    TrainingHub -->|"core dep"| HF["transformers + datasets + peft"]
    TrainingHub -->|"core dep"| Accelerate["accelerate"]

    %% Styling
    style TrainingHub fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Core fill:#fff3cd,stroke:#d6b656,stroke-width:1px
    style Algorithms fill:#d4edda,stroke:#82b366,stroke-width:1px
    style Backends fill:#d1ecf1,stroke:#17a2b8,stroke-width:1px
    style Support fill:#f8d7da,stroke:#dc3545,stroke-width:1px
    style Profiling fill:#e2d5f1,stroke:#6f42c1,stroke-width:1px
    style Plugins fill:#fce4ec,stroke:#e91e63,stroke-width:1px

    style Registry fill:#f5a623,stroke:#333
    style User fill:#4a90e2,color:#fff,stroke:#333
    style ILabTraining fill:#999,stroke:#333
    style MiniTrainer fill:#999,stroke:#333
    style Unsloth fill:#999,stroke:#333
    style ART fill:#999,stroke:#333
    style VeRL fill:#999,stroke:#333
    style GEPALib fill:#999,stroke:#333
    style PyTorch fill:#999,stroke:#333
    style HF fill:#999,stroke:#333
    style Accelerate fill:#999,stroke:#333
