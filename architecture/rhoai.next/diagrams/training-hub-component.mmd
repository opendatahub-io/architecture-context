graph TB
    subgraph TrainingHub["Training Hub (Python Library / CLI)"]
        direction TB

        subgraph Core["Core Framework"]
            Registry["AlgorithmRegistry<br/>(Strategy + Registry Pattern)"]
            Callback["TrainingHubCallback<br/>(9 Lifecycle Hooks)"]
            Utils["Utils<br/>(Dataset Loading, Torchrun Params)"]
        end

        subgraph CLI["CLI Layer"]
            ThubCLI["thub CLI<br/>(728 lines, YAML config, lazy imports)"]
        end

        subgraph Algorithms["Algorithms"]
            SFT["SFTAlgorithm"]
            OSFT["OSFTAlgorithm"]
            LoRASFT["LoRASFTAlgorithm"]
            LoRAGRPO["LoRAGRPOAlgorithm"]
            GEPA["GEPAAlgorithm"]
            EmbSFT["EmbeddingSFTAlgorithm"]
        end

        subgraph Backends["Backends"]
            ILabBackend["InstructLab Training<br/>(SFT Backend)"]
            MiniTrainerBackend["Mini-Trainer<br/>(OSFT Backend)"]
            UnslothBackend["Unsloth LoRA<br/>(LoRA SFT Backend)"]
            ARTBackend["ART/OpenPipe<br/>(LoRA GRPO Backend)"]
            VeRLBackend["verl FSDP<br/>(LoRA GRPO Backend)"]
            GEPABackend["GEPA Direct<br/>(Prompt Optimization)"]
            MLflowGEPABackend["MLflow GEPA<br/>(Prompt Registry)"]
            STBackend["sentence-transformers<br/>(Embedding SFT Backend)"]
        end

        subgraph Profiling["Profiling"]
            Estimators["VRAM Estimators<br/>(Basic, OSFT, LoRA, QLoRA)"]
        end
    end

    %% CLI to Registry
    ThubCLI -->|"lazy import + dispatch"| Registry

    %% Registry to Algorithms
    Registry -->|"resolves"| SFT
    Registry -->|"resolves"| OSFT
    Registry -->|"resolves"| LoRASFT
    Registry -->|"resolves"| LoRAGRPO
    Registry -->|"resolves"| GEPA
    Registry -->|"resolves"| EmbSFT

    %% Algorithms to Backends
    SFT -->|"dispatches"| ILabBackend
    OSFT -->|"dispatches"| MiniTrainerBackend
    LoRASFT -->|"dispatches"| UnslothBackend
    LoRAGRPO -->|"dispatches"| ARTBackend
    LoRAGRPO -->|"dispatches"| VeRLBackend
    GEPA -->|"dispatches"| GEPABackend
    GEPA -->|"dispatches"| MLflowGEPABackend
    EmbSFT -->|"dispatches"| STBackend

    %% Callback integration
    Callback -.->|"hooks into"| ILabBackend
    Callback -.->|"hooks into"| MiniTrainerBackend
    Callback -.->|"hooks into"| UnslothBackend
    Callback -.->|"hooks into"| ARTBackend
    Callback -.->|"hooks into"| VeRLBackend
    Callback -.->|"hooks into"| STBackend

    %% External dependencies
    GPU["GPU<br/>(CUDA/NCCL)"]
    HFHub["HuggingFace Hub"]
    LLMAPI["LLM API<br/>(OpenAI-compatible)"]
    Kubeflow["Kubeflow<br/>(Progress Tracking)"]

    ILabBackend -->|"torchrun"| GPU
    MiniTrainerBackend -->|"torchrun"| GPU
    UnslothBackend -->|"DDP"| GPU
    ARTBackend -->|"vLLM + Unsloth"| GPU
    VeRLBackend -->|"FSDP + vLLM"| GPU
    STBackend -->|"PyTorch"| GPU
    GEPABackend -->|"API calls"| LLMAPI
    MLflowGEPABackend -->|"API calls"| LLMAPI

    Utils -->|"downloads"| HFHub
    ARTBackend -.->|"training_metrics.jsonl"| Kubeflow
    VeRLBackend -.->|"training_metrics.jsonl"| Kubeflow

    %% Styling
    style Registry fill:#4a90e2,stroke:#333,color:#fff
    style Callback fill:#4a90e2,stroke:#333,color:#fff
    style ThubCLI fill:#4a90e2,stroke:#333,color:#fff
    style SFT fill:#7ed321,stroke:#333
    style OSFT fill:#7ed321,stroke:#333
    style LoRASFT fill:#7ed321,stroke:#333
    style LoRAGRPO fill:#7ed321,stroke:#333
    style GEPA fill:#7ed321,stroke:#333
    style EmbSFT fill:#7ed321,stroke:#333
    style ILabBackend fill:#f5a623,stroke:#333
    style MiniTrainerBackend fill:#f5a623,stroke:#333
    style UnslothBackend fill:#f5a623,stroke:#333
    style ARTBackend fill:#f5a623,stroke:#333
    style VeRLBackend fill:#f5a623,stroke:#333
    style GEPABackend fill:#f5a623,stroke:#333
    style MLflowGEPABackend fill:#f5a623,stroke:#333
    style STBackend fill:#f5a623,stroke:#333
    style GPU fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style LLMAPI fill:#e8e8e8,stroke:#333
    style Kubeflow fill:#e8e8e8,stroke:#333
