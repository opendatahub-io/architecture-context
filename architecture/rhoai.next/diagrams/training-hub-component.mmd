graph TB
    subgraph TrainingHub["Training Hub Library"]
        direction TB

        subgraph Core["Core Framework"]
            Registry["AlgorithmRegistry<br/>(Factory + Registration)"]
            AlgorithmABC["Algorithm ABC"]
            BackendABC["Backend ABC"]
            AlgorithmABC -->|"delegates to"| BackendABC
            Registry -->|"creates"| AlgorithmABC
        end

        subgraph Algorithms["Training Algorithms"]
            SFT["SFT<br/>(Supervised Fine-Tuning)"]
            OSFT["OSFT<br/>(Orthogonal Subspace FT)"]
            LoRASFT["LoRA + SFT<br/>(Parameter-Efficient FT)"]
            LoRAGRPO["LoRA + GRPO<br/>(RL Fine-Tuning)"]
            GRPO["GRPO<br/>(Full-Parameter RL)"]
            GEPA["GEPA<br/>(Prompt Optimization)"]
        end

        subgraph Backends["Pluggable Backends"]
            ILabBackend["InstructLab Training<br/>Backend"]
            MiniTrainerBackend["Mini-Trainer<br/>Backend"]
            UnslothBackend["Unsloth<br/>Backend"]
            ARTBackend["OpenPipe ART<br/>Backend (Single-GPU)"]
            VeRLBackend["verl<br/>Backend (Multi-GPU)"]
            GEPABackend["GEPA<br/>Backend"]
            MLflowBackend["MLflow Prompt<br/>Registry Backend"]
        end

        subgraph Utilities["Utilities"]
            MemoryEstimator["Memory Estimator<br/>(GPU Profiling)"]
            Visualization["Visualization<br/>(Loss Curves)"]
            RewardFunctions["Reward Functions<br/>(Tool-Call Verification)"]
            ITSRollout["ITS Rollout Adapter<br/>(BestOfN, BeamSearch)"]
            ModelValidation["Model Validation<br/>(15+ Architectures)"]
        end
    end

    %% Algorithm-to-Backend mappings
    SFT -->|"uses"| ILabBackend
    OSFT -->|"uses"| MiniTrainerBackend
    LoRASFT -->|"uses"| UnslothBackend
    LoRAGRPO -->|"uses"| ARTBackend
    LoRAGRPO -->|"uses"| VeRLBackend
    GRPO -->|"wraps (lora_r=0)"| LoRAGRPO
    GEPA -->|"uses"| GEPABackend
    GEPA -->|"uses"| MLflowBackend

    %% External consumers
    UserCode["User Code / Pipeline"] -->|"training_hub.sft()<br/>training_hub.lora_grpo()<br/>training_hub.gepa()"| Registry
    CodingAgent["AI Coding Agent<br/>(Claude Code / Codex)"] -->|"plugin invocation"| Registry

    %% Backend external dependencies
    ILabBackend -->|"torchrun"| PyTorch["PyTorch<br/>Distributed"]
    MiniTrainerBackend -->|"torchrun"| PyTorch
    UnslothBackend -->|"DDP"| PyTorch
    ARTBackend -->|"subprocess + vLLM"| vLLM["vLLM Engine"]
    VeRLBackend -->|"subprocess + Ray"| Ray["Ray Cluster"]
    VeRLBackend -->|"FSDP"| PyTorch
    GEPABackend -->|"LLM API calls"| LLMAPI["LLM API<br/>(via litellm)"]
    MLflowBackend -->|"REST API"| MLflow["MLflow Server"]

    %% Styling
    style TrainingHub fill:#e8f4fd,stroke:#4a90e2,stroke-width:3px
    style Core fill:#fff3e0,stroke:#f5a623,stroke-width:2px
    style Algorithms fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style Backends fill:#fce4ec,stroke:#e91e63,stroke-width:2px
    style Utilities fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px

    style Registry fill:#f5a623
    style AlgorithmABC fill:#f5a623
    style BackendABC fill:#f5a623
    style SFT fill:#4caf50,color:#fff
    style OSFT fill:#4caf50,color:#fff
    style LoRASFT fill:#4caf50,color:#fff
    style LoRAGRPO fill:#4caf50,color:#fff
    style GRPO fill:#4caf50,color:#fff
    style GEPA fill:#4caf50,color:#fff
    style UserCode fill:#e8e8e8,stroke:#333
    style CodingAgent fill:#e8e8e8,stroke:#333
    style PyTorch fill:#999,stroke:#333
    style vLLM fill:#999,stroke:#333
    style Ray fill:#999,stroke:#333
    style LLMAPI fill:#999,stroke:#333
    style MLflow fill:#999,stroke:#333
