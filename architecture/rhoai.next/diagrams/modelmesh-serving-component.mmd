graph TB
    subgraph "ModelMesh Serving Controller"
        direction TB
        Manager["modelmesh-serving<br/>Go controller-runtime operator"]

        subgraph "Reconcilers"
            ServiceReconciler["ServiceReconciler<br/>Manages headless Services,<br/>TLS secrets, ServiceMonitors"]
            ServingRuntimeReconciler["ServingRuntimeReconciler<br/>Generates runtime Deployments<br/>with ModelMesh sidecars"]
            PredictorReconciler["PredictorReconciler<br/>Model lifecycle via<br/>ModelMesh"]
            HPAReconciler["HPAReconciler<br/>HPA management for<br/>runtime pods"]
        end

        subgraph "Background Services"
            EventStream["ModelMeshEventStream<br/>Watches etcd for<br/>model lifecycle events"]
            GrpcResolver["GrpcResolver<br/>Custom gRPC name resolver<br/>via K8s Endpoints"]
        end

        Webhook["ServingRuntimeWebhook<br/>Validates autoscaler config<br/>on ServingRuntime CREATE/UPDATE<br/>Port 9443"]

        Manager --> ServiceReconciler
        Manager --> ServingRuntimeReconciler
        Manager --> PredictorReconciler
        Manager --> HPAReconciler
        Manager --> EventStream
        Manager --> GrpcResolver
        Manager --> Webhook
    end

    subgraph "Custom Resources"
        ServingRuntimeCR["ServingRuntime CR<br/>serving.kserve.io/v1alpha1"]
        ClusterServingRuntimeCR["ClusterServingRuntime CR<br/>serving.kserve.io/v1alpha1"]
        PredictorCR["Predictor CR<br/>serving.kserve.io/v1alpha1"]
        InferenceServiceCR["InferenceService CR<br/>serving.kserve.io/v1beta1"]
    end

    subgraph "Generated Resources"
        RuntimeDeployment["Runtime Deployment<br/>ModelMesh sidecar +<br/>Inference runtime container"]
        HeadlessService["Headless Service<br/>Inference traffic routing"]
        ServiceMonitor["ServiceMonitor<br/>Prometheus metrics"]
        HPA["HorizontalPodAutoscaler"]
    end

    subgraph "Runtime Pods"
        direction LR
        ModelMeshSidecar["ModelMesh Sidecar<br/>Model placement & routing"]
        RuntimeAdapter["modelmesh-runtime-adapter<br/>Model pull/load"]
        RestProxy["REST Proxy<br/>KServe V2 REST-to-gRPC<br/>Port 8008"]
        InferenceRuntime["Inference Runtime<br/>Triton / MLServer /<br/>OVMS / TorchServe"]
    end

    User["User / Dashboard"] -->|creates| PredictorCR
    User -->|creates| ServingRuntimeCR

    ServingRuntimeCR -->|watched by| ServingRuntimeReconciler
    ClusterServingRuntimeCR -->|watched by| ServingRuntimeReconciler
    PredictorCR -->|watched by| PredictorReconciler
    InferenceServiceCR -.->|watched by<br/>ENABLE_ISVC_WATCH| PredictorReconciler

    ServingRuntimeReconciler -->|creates| RuntimeDeployment
    ServiceReconciler -->|creates| HeadlessService
    ServiceReconciler -->|creates| ServiceMonitor
    HPAReconciler -->|creates| HPA

    RuntimeDeployment -->|contains| ModelMeshSidecar
    RuntimeDeployment -->|contains| RuntimeAdapter
    RuntimeDeployment -->|contains| RestProxy
    RuntimeDeployment -->|contains| InferenceRuntime

    EventStream -->|feeds events| PredictorReconciler

    etcd["etcd Cluster"] -->|model events| EventStream
    ModelMeshSidecar -->|coordinates| etcd
    GrpcResolver -->|resolves| HeadlessService

    style Manager fill:#4a90e2,color:#fff
    style ServiceReconciler fill:#4a90e2,color:#fff
    style ServingRuntimeReconciler fill:#4a90e2,color:#fff
    style PredictorReconciler fill:#4a90e2,color:#fff
    style HPAReconciler fill:#4a90e2,color:#fff
    style EventStream fill:#4a90e2,color:#fff
    style GrpcResolver fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style ServingRuntimeCR fill:#f5a623,color:#fff
    style ClusterServingRuntimeCR fill:#f5a623,color:#fff
    style PredictorCR fill:#f5a623,color:#fff
    style InferenceServiceCR fill:#f5a623,color:#fff
    style etcd fill:#e8e8e8,color:#333
    style ModelMeshSidecar fill:#7ed321,color:#fff
    style RuntimeAdapter fill:#7ed321,color:#fff
    style RestProxy fill:#7ed321,color:#fff
    style InferenceRuntime fill:#7ed321,color:#fff
