graph TB
    subgraph Controller["ModelMesh Serving Controller"]
        direction TB
        MainController["modelmesh-controller<br/>(controller-runtime)"]
        PredictorReconciler["PredictorReconciler<br/>Manages VModel entries via gRPC"]
        SRReconciler["ServingRuntimeReconciler<br/>Creates runtime Deployments,<br/>scale-to-zero, HPA"]
        ServiceReconciler["ServiceReconciler<br/>Manages K8s Services,<br/>ServiceMonitor, TLS"]
        Webhook["ValidatingWebhook<br/>9443/TCP TLS<br/>Validates ServingRuntime specs"]

        MainController --> PredictorReconciler
        MainController --> SRReconciler
        MainController --> ServiceReconciler
        MainController --> Webhook
    end

    subgraph RuntimePod["Runtime Pod (dynamically created)"]
        direction LR
        MM["ModelMesh (mm)<br/>8033/TCP gRPC<br/>Model placement & routing"]
        RESTProxy["REST Proxy<br/>8008/TCP HTTP<br/>KServe V2 REST-to-gRPC"]
        OAuthProxy["oauth-proxy<br/>8443/TCP HTTPS<br/>OpenShift OAuth"]
        Puller["Storage Helper/Puller<br/>Model artifact retrieval"]
        ModelServer["Model Server Container<br/>(Triton/MLServer/OVMS/TorchServe)"]

        OAuthProxy -->|localhost| RESTProxy
        RESTProxy -->|localhost gRPC| MM
        MM -->|localhost gRPC| ModelServer
        Puller -->|localhost| ModelServer
    end

    %% CRDs
    User["Data Scientist / Client"] -->|creates| PredictorCR["Predictor CR<br/>serving.kserve.io/v1alpha1"]
    User -->|creates| SVCR["ServingRuntime CR<br/>serving.kserve.io/v1alpha1"]
    User -->|creates| CSVCR["ClusterServingRuntime CR<br/>serving.kserve.io/v1alpha1"]
    User -->|creates| ISVC["InferenceService CR<br/>serving.kserve.io/v1beta1<br/>(deploymentMode: ModelMesh)"]

    PredictorCR -->|watched by| PredictorReconciler
    SVCR -->|watched by| SRReconciler
    CSVCR -->|watched by| SRReconciler
    ISVC -->|watched by| PredictorReconciler

    %% Controller creates runtime pods
    SRReconciler -->|creates/manages| RuntimePod
    ServiceReconciler -->|creates| SvcResource["K8s Service<br/>modelmesh-serving<br/>(headless ClusterIP)"]

    %% Controller to ModelMesh gRPC
    PredictorReconciler -->|SetVModel/DeleteVModel<br/>gRPC 8033| MM

    %% External dependencies
    SRReconciler -->|watches/CRUD| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    MM -->|model registry| etcd["etcd Cluster<br/>2379/TCP gRPC"]
    Puller -->|download models| S3["S3/GCS Storage<br/>443/TCP HTTPS"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style RuntimePod fill:#50c878,stroke:#333,stroke-width:2px
    style MainController fill:#3a7bd5,stroke:#333,color:#fff
    style PredictorReconciler fill:#3a7bd5,stroke:#333,color:#fff
    style SRReconciler fill:#3a7bd5,stroke:#333,color:#fff
    style ServiceReconciler fill:#3a7bd5,stroke:#333,color:#fff
    style Webhook fill:#3a7bd5,stroke:#333,color:#fff
    style MM fill:#2ecc71,stroke:#333,color:#fff
    style RESTProxy fill:#2ecc71,stroke:#333,color:#fff
    style OAuthProxy fill:#2ecc71,stroke:#333,color:#fff
    style Puller fill:#2ecc71,stroke:#333,color:#fff
    style ModelServer fill:#2ecc71,stroke:#333,color:#fff
    style PredictorCR fill:#f5a623,stroke:#333
    style SVCR fill:#f5a623,stroke:#333
    style CSVCR fill:#f5a623,stroke:#333
    style ISVC fill:#f5a623,stroke:#333
    style etcd fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
