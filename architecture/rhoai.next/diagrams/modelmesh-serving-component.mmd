graph TB
    subgraph ModelMeshServing["ModelMesh Serving Controller"]
        Controller["modelmesh-serving-controller<br/>(Go Operator / controller-runtime)<br/>Ports: 8080 metrics, 8081 health"]
        Webhook["ServingRuntime Webhook<br/>(Validating Admission Webhook)<br/>Port: 9443/TCP HTTPS"]
        ConfigWatch["model-serving-config<br/>ConfigMap Watcher"]
        Controller -->|validates via| Webhook
        Controller -->|reads config| ConfigWatch
    end

    subgraph RuntimePod["Runtime Pod (per ServingRuntime)"]
        ModelMesh["ModelMesh Sidecar<br/>Port: 8033/TCP gRPC<br/>Ports: 8089 ready, 8090 prestop"]
        ModelServer["Model Runtime Container<br/>(Triton/MLServer/OVMS/TorchServe)"]
        Puller["modelmesh-runtime-adapter<br/>(Puller Sidecar)<br/>Port: 8086/TCP gRPC"]
        RESTProxy["REST Proxy<br/>Port: 8008/TCP HTTP"]
        OAuthProxy["oauth-proxy Sidecar<br/>Port: 8443/TCP HTTPS"]

        OAuthProxy -->|proxies to| RESTProxy
        RESTProxy -->|translates REST→gRPC| ModelMesh
        ModelMesh -->|inference| ModelServer
        ModelMesh -->|model download| Puller
    end

    %% CRDs
    User[Data Scientist / Client] -->|creates| PredictorCR["Predictor CR<br/>(serving.kserve.io/v1alpha1)"]
    User -->|creates| InferenceServiceCR["InferenceService CR<br/>(serving.kserve.io/v1beta1)"]
    Admin[Platform Admin] -->|creates| ServingRuntimeCR["ServingRuntime CR<br/>(serving.kserve.io/v1alpha1)"]
    Admin -->|creates| ClusterServingRuntimeCR["ClusterServingRuntime CR<br/>(serving.kserve.io/v1alpha1)"]

    %% Controller watches CRDs
    PredictorCR -->|watched by| Controller
    InferenceServiceCR -->|watched by| Controller
    ServingRuntimeCR -->|watched by| Controller
    ClusterServingRuntimeCR -->|watched by| Controller

    %% Controller creates runtime resources
    Controller -->|creates/manages| RuntimePod
    Controller -->|gRPC: SetVModel,<br/>DeleteVModel| ModelMesh

    %% External dependencies
    Controller -->|watches namespaces<br/>modelmesh-enabled=true| K8sAPI["Kubernetes API Server"]
    ModelMesh -->|coordination &<br/>model placement| etcd["etcd<br/>Port: 2379/TCP"]
    Puller -->|downloads models| Storage["Object Storage<br/>(S3/GCS/PVC)"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ConfigWatch fill:#4a90e2,stroke:#333,stroke-width:1px,color:#fff
    style ModelMesh fill:#50c878,stroke:#333,stroke-width:2px,color:#fff
    style ModelServer fill:#50c878,stroke:#333,stroke-width:1px,color:#fff
    style Puller fill:#50c878,stroke:#333,stroke-width:1px,color:#fff
    style RESTProxy fill:#50c878,stroke:#333,stroke-width:1px,color:#fff
    style OAuthProxy fill:#e8833a,stroke:#333,stroke-width:1px,color:#fff
    style PredictorCR fill:#f5a623,stroke:#333,stroke-width:1px
    style InferenceServiceCR fill:#f5a623,stroke:#333,stroke-width:1px
    style ServingRuntimeCR fill:#f5a623,stroke:#333,stroke-width:1px
    style ClusterServingRuntimeCR fill:#f5a623,stroke:#333,stroke-width:1px
    style etcd fill:#999,stroke:#333,stroke-width:1px,color:#fff
    style Storage fill:#999,stroke:#333,stroke-width:1px,color:#fff
    style K8sAPI fill:#999,stroke:#333,stroke-width:1px,color:#fff
