graph TD
    subgraph Note["Note: Notebooks does NOT define its own RBAC"]
        direction TB
        Info["This component does not define<br/>RBAC resources directly.<br/>RBAC is managed by the<br/>ODH Notebook Controller."]
    end

    subgraph NotebookController["ODH Notebook Controller<br/>(Manages RBAC for Notebook Pods)"]
        direction TB

        subgraph PerNotebook["Per-Notebook Resources (Dynamic)"]
            SA["ServiceAccount<br/>{notebook-name}-sa<br/>Namespace: {user-namespace}"]
            RB["RoleBinding<br/>{notebook-name}-rb<br/>Namespace: {user-namespace}"]
        end

        subgraph Sidecar["Injected Sidecar"]
            RBAC["kube-rbac-proxy<br/>Port: 8443/TCP"]
        end
    end

    subgraph AuthFlow["Authentication & Authorization Flow"]
        direction TB

        subgraph External["External Access"]
            UserReq["User Request<br/>HTTPS/443<br/>OAuth Token"]
        end

        subgraph PodAuth["Pod-Level Auth (kube-rbac-proxy)"]
            OAuthValidation["OAuth Token<br/>Validation"]
            NamespaceCheck["Namespace Access<br/>Verification"]
            ProxiedReq["Proxied Request<br/>to Notebook Container"]
        end
    end

    subgraph Secrets["Secrets & Certificates"]
        direction TB
        CABundle["CA Cert Bundle<br/>Type: ConfigMap (ca-bundle.crt)<br/>Mount: /etc/pki/tls/custom-certs/<br/>Provisioned by: Notebook Controller<br/>Auto-Rotate: Yes"]
        DSPASecret["DSPA Connection Secret<br/>Type: Opaque<br/>Mount: /opt/app-root/runtimes/<br/>Provisioned by: Notebook Controller<br/>Auto-Rotate: No"]
    end

    %% Controller creates per-notebook resources
    NotebookController -->|"creates"| SA
    NotebookController -->|"creates"| RB
    NotebookController -->|"injects"| RBAC

    %% Auth flow
    UserReq -->|"OAuth"| OAuthValidation
    OAuthValidation -->|"validates"| NamespaceCheck
    NamespaceCheck -->|"user has access<br/>to namespace"| ProxiedReq

    %% RBAC proxy enforces
    RBAC -->|"enforces"| OAuthValidation

    %% Secrets mounted
    NotebookController -->|"mounts"| CABundle
    NotebookController -->|"mounts"| DSPASecret

    %% Binding relationships
    SA -->|"bound via"| RB
    RB -->|"grants access to"| NotebookPod["Notebook Pod<br/>in {user-namespace}"]

    %% Styling
    style Info fill:#fff3cd,stroke:#856404,stroke-width:2px,color:#856404
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#f5a623,stroke:#333,color:#fff
    style RBAC fill:#e74c3c,stroke:#333,color:#fff
    style NotebookPod fill:#7ed321,stroke:#333,color:#fff
    style CABundle fill:#dae8fc,stroke:#6c8ebf
    style DSPASecret fill:#dae8fc,stroke:#6c8ebf
    style OAuthValidation fill:#e8e8e8,stroke:#333
    style NamespaceCheck fill:#e8e8e8,stroke:#333
    style ProxiedReq fill:#e8e8e8,stroke:#333
    style UserReq fill:#f9f9f9,stroke:#999
