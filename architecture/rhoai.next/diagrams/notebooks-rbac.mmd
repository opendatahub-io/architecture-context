graph TD
    subgraph NotebooksComponent["Notebooks Component"]
        NoRBAC["This component defines<br/>NO RBAC resources"]
    end

    subgraph RuntimePod["Workbench Pod (Runtime)"]
        direction TB
        UserSA["Per-user Service Account<br/>(created by Notebook Controller)"]
        Container["Workbench Container<br/>UID: 1001 (non-root)<br/>GID: 0 (root group)"]
    end

    subgraph ManagedBy["RBAC Managed By"]
        direction TB
        NotebookCtrl["ODH Notebook Controller<br/>Creates ServiceAccounts<br/>Manages RBAC bindings"]
        OAuthProxy["OAuth Proxy Sidecar<br/>Enforces OAuth2<br/>Platform-level AuthZ"]
    end

    subgraph CISecrets["CI/Build-time Secrets (not runtime)"]
        direction TB
        PullSecret["PULL_SECRET<br/>Container registry pull"]
        GitHubToken["GITHUB_TOKEN<br/>GitHub API access"]
        GeminiKey["GEMINI_API_KEY<br/>CI summarization"]
        RenovateToken["RENOVATE_TOKEN<br/>Dependency updates"]
    end

    subgraph AuthFlow["Authentication Flow"]
        direction LR
        UserReq["User Request"] --> OAuthCheck["OAuth2 Token<br/>Validation"]
        OAuthCheck --> Workbench["Workbench Access<br/>(8888/TCP or 8787/TCP)"]
    end

    UserSA -->|"runs as"| Container
    NotebookCtrl -->|"creates & manages"| UserSA
    NotebookCtrl -->|"deploys"| OAuthProxy

    style NoRBAC fill:#fff3cd,stroke:#856404,stroke-width:2px
    style UserSA fill:#4a90e2,stroke:#333,color:#fff
    style Container fill:#d5e8d4,stroke:#82b366
    style NotebookCtrl fill:#7ed321,stroke:#333
    style OAuthProxy fill:#f5a623,stroke:#333
    style PullSecret fill:#e8e8e8,stroke:#333
    style GitHubToken fill:#e8e8e8,stroke:#333
    style GeminiKey fill:#e8e8e8,stroke:#333
    style RenovateToken fill:#e8e8e8,stroke:#333
