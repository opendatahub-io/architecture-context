graph TD
    subgraph Note["Notebooks Component RBAC"]
        direction TB
        Info["This component does not define its own<br/>RBAC resources (ClusterRoles, RoleBindings).<br/>Authentication and authorization are enforced<br/>externally by the platform."]
    end

    subgraph AuthMechanism["Authentication & Authorization Architecture"]
        direction TB

        subgraph UserAccess["User Access Path"]
            User["User / Data Scientist<br/>(OpenShift Identity)"]
        end

        subgraph ProxySidecar["kube-rbac-proxy Sidecar (per-pod)"]
            KRBP["kube-rbac-proxy<br/>Port: 8443/TCP HTTPS<br/>TLS 1.3<br/>Auth: Bearer Token"]
            Policy["Policy: Only authenticated<br/>users with namespace access"]
        end

        subgraph WorkbenchEndpoints["Workbench Endpoints (unauthed internally)"]
            JupyterEndpoint["JupyterLab :8888/TCP<br/>/lab, /api/kernels/, /api/status"]
            CodeServerEndpoint["Code-Server :80/TCP<br/>/ (nginx → code-server)"]
        end

        subgraph ControllerAccess["Controller Access"]
            Controller["ODH Notebook Controller<br/>SA: controller-manager"]
            Culler["Idle Culler<br/>Polls /api/kernels/"]
        end
    end

    subgraph SecretsManagement["Secrets (Mounted by Notebook Controller)"]
        DSPASecret["DSPA Connection Secret<br/>Type: Opaque<br/>Mount: /opt/app-root/runtimes/<br/>Provisioned by: Notebook Controller<br/>Auto-rotate: No"]
        CABundle["CA Certificate Bundle<br/>Type: Opaque<br/>Mount: /etc/pki/tls/custom-certs/ca-bundle.crt<br/>Provisioned by: Notebook Controller<br/>Auto-rotate: No"]
    end

    subgraph TenantIsolation["Tenant Isolation"]
        Boundary["Tenant Boundary: per-user<br/>(one pod per user per namespace)"]
        NSIsolation["Namespace-scoped PVCs,<br/>Secrets, ConfigMaps"]
        NetPolicy["NetworkPolicy<br/>(if configured by platform)"]
        ResourceQuota["ResourceQuota / LimitRange<br/>(namespace-level)"]
    end

    %% User access flow
    User -->|"HTTPS/8443<br/>Bearer Token<br/>(OpenShift user token)"| KRBP
    KRBP -->|validates| Policy
    Policy -->|"HTTP (pod-internal)<br/>No auth"| JupyterEndpoint
    Policy -->|"HTTP (pod-internal)<br/>No auth"| CodeServerEndpoint

    %% Controller access
    Controller -->|"injects sidecar"| KRBP
    Culler -->|"HTTPS/8443<br/>Bearer Token"| KRBP

    %% Secrets
    Controller -->|"mounts"| DSPASecret
    Controller -->|"mounts"| CABundle

    %% Isolation
    Boundary -->|"enforced by"| NSIsolation

    %% Styling
    style Info fill:#fff3e0,stroke:#f57c00,stroke-width:2px,color:#333
    style KRBP fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style Policy fill:#fff9c4,stroke:#f9a825
    style User fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#7ed321,stroke:#333,color:#fff
    style Culler fill:#7ed321,stroke:#333,color:#fff
    style JupyterEndpoint fill:#d5e8d4,stroke:#82b366
    style CodeServerEndpoint fill:#d5e8d4,stroke:#82b366
    style DSPASecret fill:#f8cecc,stroke:#b85450
    style CABundle fill:#f8cecc,stroke:#b85450
    style Boundary fill:#e1bee7,stroke:#8e24aa
    style NSIsolation fill:#e1bee7,stroke:#8e24aa
    style NetPolicy fill:#e1bee7,stroke:#8e24aa
    style ResourceQuota fill:#e1bee7,stroke:#8e24aa
