graph TB
    subgraph SDK["Kubeflow SDK (kubeflow PyPI package)"]
        direction TB

        subgraph Common["kubeflow.common"]
            SharedUtils["Shared Utilities<br/>KubernetesBackendConfig<br/>Structured Logging"]
        end

        subgraph Trainer["kubeflow.trainer"]
            TrainerClient["TrainerClient API"]
            subgraph Backends["Execution Backends"]
                K8sBackend["KubernetesBackend"]
                ContainerBackend["ContainerBackend<br/>(Docker/Podman)"]
                LocalBackend["LocalProcessBackend"]
            end
            TrainerClient --> K8sBackend
            TrainerClient --> ContainerBackend
            TrainerClient --> LocalBackend
        end

        subgraph RHAI["kubeflow.trainer.rhai"]
            TransformersTrainer["TransformersTrainer<br/>(HuggingFace/TRL)"]
            TrainingHubTrainer["TrainingHubTrainer<br/>(SFT/OSFT/LoRA)"]
            SpecDecTrainer["SpeculativeDecodingTrainer<br/>(Eagle3/DFlash/MTP/PEAGLE)"]
            Instrumentation["Auto-Instrumentation<br/>(inspect.getsource injection)"]
            TransformersTrainer --> Instrumentation
            TrainingHubTrainer --> Instrumentation
            SpecDecTrainer --> Instrumentation
        end

        subgraph Optimizer["kubeflow.optimizer"]
            OptimizerClient["OptimizerClient<br/>(Katib wrapper)"]
        end

        subgraph Spark["kubeflow.spark"]
            SparkClient["SparkClient<br/>(Spark Connect)"]
        end

        subgraph Hub["kubeflow.hub"]
            HubClient["ModelRegistryClient<br/>(TLS/custom CA)"]
        end

        subgraph Pipelines["kubeflow.pipelines"]
            PipelinesClient["KFP Client<br/>(lazy-loaded)"]
        end
    end

    %% External systems
    User["Data Scientist / ML Engineer"] -->|Python API| TrainerClient
    User -->|Python API| OptimizerClient
    User -->|Python API| SparkClient
    User -->|Python API| HubClient
    User -->|Python API| PipelinesClient

    K8sBackend -->|"HTTPS/443<br/>TrainJob CR"| K8sAPI["Kubernetes API Server"]
    OptimizerClient -->|"HTTPS/443<br/>OptimizationJob CR"| K8sAPI
    SparkClient -->|"HTTPS/443<br/>SparkConnect CR"| K8sAPI

    K8sAPI -->|reconciles| TrainerOp["Kubeflow Trainer Operator"]
    K8sAPI -->|reconciles| KatibOp["Kubeflow Katib"]
    K8sAPI -->|reconciles| SparkOp["Spark Operator"]

    HubClient -->|"HTTP/HTTPS<br/>443 or 8080"| ModelRegistry["Model Registry Server"]
    PipelinesClient -->|"HTTPS"| KFPServer["KFP Server"]

    ContainerBackend -->|Unix socket| Docker["Docker / Podman"]

    Instrumentation -.->|"injected into pods"| TrainingPod["Training Pod<br/>28080/TCP metrics"]
    SpecDecTrainer -.->|"sidecar in DATA_ONLY"| vLLMSidecar["vLLM Sidecar<br/>8234/TCP"]

    TrainingPod -->|"HTTPS/443"| S3["S3-compatible Storage"]
    TrainingPod -->|"HTTPS/443"| HFHub["HuggingFace Hub"]

