graph TB
    subgraph SDK["Kubeflow SDK (Python Library)"]
        direction TB

        subgraph Clients["Client Layer"]
            TrainerClient["TrainerClient<br/>Training job lifecycle<br/>(create, list, get, delete, wait, logs)"]
            OptimizerClient["OptimizerClient<br/>Hyperparameter optimization<br/>via Katib Experiments"]
            SparkClient["SparkClient<br/>SparkConnect session<br/>management"]
            ModelRegistryClient["ModelRegistryClient<br/>CRUD for models,<br/>versions, artifacts"]
        end

        subgraph Backends["Execution Backends (Strategy Pattern)"]
            KubernetesBackend["KubernetesBackend<br/>Creates TrainJob CRs<br/>on Kubernetes"]
            ContainerBackend["ContainerBackend<br/>Runs training in<br/>Docker/Podman locally"]
            LocalProcessBackend["LocalProcessBackend<br/>Runs training as<br/>local Python subprocesses"]
        end

        subgraph RHAI["RHAI Extensions (Midstream Only)"]
            TransformersTrainer["TransformersTrainer<br/>HuggingFace fine-tuning<br/>+ JIT checkpointing"]
            TrainingHubTrainer["TrainingHubTrainer<br/>Algorithm registry<br/>+ HTTP metrics injection"]
            AlgorithmRegistry["Algorithm Registry<br/>sft, osft, lora_sft, lora_grpo"]
        end

        TrainerClient -->|dispatches to| KubernetesBackend
        TrainerClient -->|dispatches to| ContainerBackend
        TrainerClient -->|dispatches to| LocalProcessBackend
        TransformersTrainer -->|extends| TrainerClient
        TrainingHubTrainer -->|extends| TrainerClient
        TrainingHubTrainer -->|reads| AlgorithmRegistry
    end

    %% External Systems
    User["User Python Code<br/>(Notebook / Script / Pipeline)"] -->|imports| TrainerClient
    User -->|imports| OptimizerClient
    User -->|imports| SparkClient
    User -->|imports| ModelRegistryClient

    KubernetesBackend -->|creates CRs| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    ContainerBackend -->|manages containers| Docker["Docker/Podman<br/>Unix Socket"]
    LocalProcessBackend -->|spawns processes| LocalPython["Local Python<br/>Subprocesses"]

    OptimizerClient -->|creates Experiment CRs| K8sAPI
    SparkClient -->|creates SparkApplication CRs| K8sAPI
    SparkClient -->|connects to| SparkConnect["SparkConnect Server<br/>15002/TCP gRPC"]
    ModelRegistryClient -->|REST API| ModelRegistry["Model Registry<br/>443/TCP HTTPS"]

    TransformersTrainer -->|checkpoint upload| S3["S3 Storage<br/>443/TCP HTTPS"]

    %% CRDs consumed (not owned)
    K8sAPI -->|reconciles| TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1"]
    K8sAPI -->|reconciles| ExperimentCR["Experiment CR<br/>kubeflow.org/v1beta1"]
    K8sAPI -->|reconciles| SparkAppCR["SparkApplication CR"]

