    style LocalProcessBackend fill:#f5a623,color:#fff
    style TransformersTrainer fill:#d9534f,color:#fff
    style TrainingHubTrainer fill:#d9534f,color:#fff
    style AlgorithmRegistry fill:#d9534f,color:#fff
    style User fill:#e8e8e8,stroke:#333
