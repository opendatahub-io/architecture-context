graph TB
    subgraph FeastOperator["Feast Operator (Go)"]
        direction TB
        Reconciler["FeatureStoreReconciler<br/>controller-runtime"]
        NotebookReconciler["NotebookConfigMapReconciler"]
        TLSBootstrap["TLS Bootstrap<br/>OpenShift TLS Profile"]
        Reconciler -->|"watches"| NotebookReconciler
        Reconciler -->|"configures"| TLSBootstrap
    end

    subgraph FeatureServerPython["Feature Server - Python"]
        direction TB
        FastAPI["FastAPI/Starlette<br/>Port 6566/TCP"]
        RegistryAPI["Registry API<br/>110+ endpoints"]
        GrpcServer["gRPC Server<br/>ServingService + RegistryServer"]
        MonitoringAPI["Monitoring & Lineage<br/>OpenLineage"]
        MCPAPI["MCP Server"]
        FastAPI --- RegistryAPI
        FastAPI --- MonitoringAPI
        FastAPI --- MCPAPI
        FastAPI --- GrpcServer
    end

    subgraph FeatureServerGo["Feature Server - Go"]
        direction TB
        GoHTTP["HTTP Server<br/>TLS 1.2+ / X25519MLKEM768"]
        GoGRPC["gRPC Server<br/>ServingService"]
        GoHTTP --- GoGRPC
    end

    %% CRDs
    FeatureStoreCR["FeatureStore CR<br/>feast.dev/v1"]
    FeatureStoreCRAlpha["FeatureStore CR<br/>feast.dev/v1alpha1<br/>(deprecated)"]

    %% User interaction
    User["Data Scientist / ML Engineer"] -->|"creates"| FeatureStoreCR
    FeatureStoreCR -->|"watched by"| Reconciler
    FeatureStoreCRAlpha -.->|"deprecated"| Reconciler

    %% Operator creates resources
    Reconciler -->|"creates"| FeatureServerPython
    Reconciler -->|"creates"| Deployment["Deployments"]
    Reconciler -->|"creates"| Services["Services"]
    Reconciler -->|"creates"| RBAC["Roles & RoleBindings"]
    Reconciler -->|"creates"| Routes["OpenShift Routes"]
    Reconciler -->|"creates"| CronJobs["Materialization CronJobs"]
    Reconciler -->|"creates"| HPA["HPA & PDB"]

    %% Notebook integration
    NotebookReconciler -->|"injects config into"| Notebooks["Kubeflow Notebooks"]

    %% Platform integrations
    Reconciler -->|"watches"| MLflow["MLflow CRs"]
    Reconciler -->|"creates"| ServiceMonitor["ServiceMonitor"]

    %% Backend dependencies
    FeatureServerPython -->|"reads/writes"| Redis["Redis / Valkey"]
    FeatureServerPython -->|"reads/writes"| PostgreSQL["PostgreSQL"]
    FeatureServerPython -->|"queries"| BigQuery["BigQuery"]
    FeatureServerPython -->|"queries"| Snowflake["Snowflake"]
    FeatureServerPython -->|"stores"| S3["S3-compatible Storage"]

    FeatureServerGo -->|"reads"| Redis
    FeatureServerGo -->|"reads"| PostgreSQL

    %% Styling
    style Reconciler fill:#4a90e2,color:#fff
    style NotebookReconciler fill:#4a90e2,color:#fff
    style TLSBootstrap fill:#4a90e2,color:#fff
    style FastAPI fill:#50a14f,color:#fff
    style RegistryAPI fill:#50a14f,color:#fff
    style GrpcServer fill:#50a14f,color:#fff
    style MonitoringAPI fill:#50a14f,color:#fff
    style MCPAPI fill:#50a14f,color:#fff
    style GoHTTP fill:#6c71c4,color:#fff
    style GoGRPC fill:#6c71c4,color:#fff
    style FeatureStoreCR fill:#f5a623
    style FeatureStoreCRAlpha fill:#f5a623
    style Redis fill:#e8e8e8
    style PostgreSQL fill:#e8e8e8
    style BigQuery fill:#e8e8e8
    style Snowflake fill:#e8e8e8
    style S3 fill:#e8e8e8
    style Notebooks fill:#7ed321
    style MLflow fill:#7ed321
    style ServiceMonitor fill:#7ed321
