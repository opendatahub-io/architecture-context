graph TB
    subgraph "Feast Platform"
        subgraph "feast-operator (Go)"
            Controller["Feast Controller<br/>controller-runtime<br/>Go 1.25"]
            NotebookCtrl["Notebook ConfigMap<br/>Controller"]
            TLSWatcher["TLS Profile<br/>Watcher"]
            AccessCtrl["Auto-Access<br/>RBAC Controller"]
        end

        subgraph "feast-{project} Deployment"
            FeatureServer["Feature Server<br/>FastAPI/uvicorn<br/>Python 3.12<br/>Port: 6566/TCP"]
            Registry["Registry Server<br/>REST API<br/>Port: 8080/TCP"]
            OfflineServer["Offline Server<br/>Batch Processing"]
            UI["Feast UI<br/>React/TypeScript<br/>Port: 8501/TCP"]
            Metrics["Metrics Exporter<br/>Prometheus<br/>Port: 8000/TCP"]
        end
    end

    %% CRDs
    FeatureStoreCR["FeatureStore CR<br/>feast.dev/v1<br/>(Namespaced)"]
    FeatureStoreCR -->|watched by| Controller

    %% Operator creates resources
    Controller -->|creates/manages| FeatureServer
    Controller -->|creates/manages| Registry
    Controller -->|creates/manages| OfflineServer
    Controller -->|creates/manages| UI
    Controller -->|creates/manages| Metrics
    Controller -->|creates| K8sResources["Deployments, Services,<br/>ConfigMaps, CronJobs,<br/>RBAC, ServiceMonitors"]
    Controller -->|queries permissions| Registry

    %% Notebook integration
    NotebookCR["Notebook CR<br/>kubeflow.org/v1<br/>(feast-integration label)"]
    NotebookCR -->|watched by| NotebookCtrl
    NotebookCtrl -->|creates| ClientConfigMap["feast-client<br/>ConfigMap"]

    %% TLS integration
    TLSWatcher -->|watches| APIServer["OpenShift<br/>APIServer Config"]

    %% Auto-access RBAC
    AccessCtrl -->|creates| RBAC["K8s Roles &<br/>RoleBindings"]

    %% External systems
    User["Data Scientist"] -->|creates| FeatureStoreCR
    MLApp["ML Application"] -->|get-online-features| FeatureServer
    MLApp -->|gRPC| FeatureServer

    %% Data stores
    FeatureServer -->|read/write| OnlineStore["Online Store<br/>(Redis / PostgreSQL /<br/>DynamoDB / ScyllaDB)"]
    OfflineServer -->|read| OfflineStore["Offline Store<br/>(BigQuery / Snowflake /<br/>DuckDB)"]

    %% Platform integration
    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|depends on| PrometheusOp["Prometheus Operator"]

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style NotebookCtrl fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style AccessCtrl fill:#4a90e2,color:#fff
    style FeatureServer fill:#50c878,color:#fff
    style Registry fill:#50c878,color:#fff
    style OfflineServer fill:#50c878,color:#fff
    style UI fill:#50c878,color:#fff
    style Metrics fill:#50c878,color:#fff
    style FeatureStoreCR fill:#f5a623,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style OnlineStore fill:#e8e8e8,stroke:#333
    style OfflineStore fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PrometheusOp fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style MLApp fill:#9b59b6,color:#fff
    style User fill:#9b59b6,color:#fff
