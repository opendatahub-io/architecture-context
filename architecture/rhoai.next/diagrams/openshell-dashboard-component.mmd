graph TB
    subgraph External["External Clients"]
        Browser["Browser Client"]
    end

    subgraph AuthLayer["Authentication Layer"]
        AuthProxy["Auth Proxy<br/>(oauth2-proxy / kube-auth-proxy)<br/>OIDC Session Management"]
    end

    subgraph Dashboard["OpenShell Dashboard"]
        subgraph BFF["Go BFF Server (8080/TCP)"]
            AuthMiddleware["Auth Middleware<br/>(Token Relay)"]
            Router["chi Router<br/>(/api/v1/*)"]
            Handlers["Resource Handlers"]
            RawExec["Raw Exec Client<br/>(Binary-safe file upload)"]
            ConfigEndpoint["Config Endpoint<br/>(/api/v1/auth/config)"]
            HealthEndpoints["Health Endpoints<br/>(/api/v1/healthz, /readyz)"]
            WSRelay["WebSocket Relay<br/>(Terminal)"]
        end

        subgraph Frontend["React Frontend (PatternFly 6)"]
            Pages["Page Components<br/>(Workspaces, Sandboxes,<br/>Providers, Policies)"]
            Terminal["Terminal Emulator<br/>(xterm.js)"]
            PolicyEditor["Policy Editor<br/>(Monaco Editor)"]
            SlotProvider["Slot Injection System"]
            APIClient["API Client Hooks<br/>(@tanstack/react-query)"]
            I18n["i18n Support<br/>(i18next)"]
        end
    end

    subgraph GatewayLayer["OpenShell Platform"]
        Gateway["OpenShell Gateway<br/>gRPC (50051/TCP)"]
    end

    subgraph Identity["Identity Provider"]
        OIDC["OIDC IdP<br/>(Keycloak / Dex)"]
    end

    %% Browser to Auth Proxy
    Browser -->|"HTTPS/443<br/>OIDC Cookie"| AuthProxy

    %% Auth Proxy to BFF
    AuthProxy -->|"HTTP(S)/8080<br/>x-forwarded-access-token"| AuthMiddleware

    %% Internal BFF flow
    AuthMiddleware --> Router
    Router --> ConfigEndpoint
    Router --> HealthEndpoints
    Router --> Handlers
    Router --> WSRelay
    Handlers --> RawExec

    %% Frontend interactions
    Pages --> APIClient
    Terminal --> WSRelay
    PolicyEditor --> APIClient
    APIClient -->|"REST /api/v1/*"| Router

    %% BFF to Gateway
    Handlers -->|"gRPC<br/>Bearer Relay"| Gateway
    WSRelay -->|"gRPC Stream<br/>(ExecSandboxInteractive)"| Gateway
    RawExec -->|"Raw gRPC<br/>(Binary stdin)"| Gateway

    %% Auth flows
    AuthProxy -.->|"OIDC/OAuth2"| OIDC
    Gateway -.->|"JWKS Validation"| OIDC

    %% Styling
    style Browser fill:#f9f9f9,stroke:#999,stroke-width:2px
    style AuthProxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style AuthMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style Router fill:#4a90e2,stroke:#333,color:#fff
    style Handlers fill:#4a90e2,stroke:#333,color:#fff
    style RawExec fill:#4a90e2,stroke:#333,color:#fff
    style ConfigEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style HealthEndpoints fill:#4a90e2,stroke:#333,color:#fff
    style WSRelay fill:#4a90e2,stroke:#333,color:#fff
    style Pages fill:#61affe,stroke:#333,color:#fff
    style Terminal fill:#61affe,stroke:#333,color:#fff
    style PolicyEditor fill:#61affe,stroke:#333,color:#fff
    style SlotProvider fill:#61affe,stroke:#333,color:#fff
    style APIClient fill:#61affe,stroke:#333,color:#fff
    style I18n fill:#61affe,stroke:#333,color:#fff
    style Gateway fill:#7ed321,stroke:#333
    style OIDC fill:#e8e8e8,stroke:#999
