graph TD
    subgraph Note["RBAC Overview"]
        direction TB
        Info["vllm-gaudi defines NO RBAC resources<br/>All RBAC is managed by KServe and<br/>the RHOAI platform operator"]
    end

    subgraph PlatformRBAC["Platform-Managed Auth (RHOAI 3.x)"]
        direction TB

        subgraph AuthFlow["Authentication Flow"]
            Client["External Client"]
            Gateway["Gateway API (Envoy)<br/>TLS 1.3 termination"]
            KRBAC["kube-rbac-proxy Sidecar<br/>8443/TCP"]
            SAR["SubjectAccessReview<br/>Kubernetes API Server"]
            VLLMContainer["vllm-gaudi Container<br/>8000/TCP (no auth)"]
        end

        subgraph KServeRBAC["KServe-Managed RBAC"]
            KServeSA["ServiceAccount<br/>{serving-runtime}-sa"]
            KServeCR["ClusterRole<br/>(managed by KServe)"]
            KServeCRB["ClusterRoleBinding<br/>(managed by KServe)"]
        end

        subgraph OperatorRBAC["Operator-Managed RBAC"]
            RHODSOp["rhods-operator<br/>ServiceAccount"]
            OpCR["ClusterRole<br/>(managed by rhods-operator)"]
            OpCRB["ClusterRoleBinding<br/>(managed by rhods-operator)"]
        end
    end

    subgraph Endpoints["Endpoint Auth Matrix"]
        direction TB
        V1Endpoints["/v1/* endpoints<br/>Methods: GET, POST<br/>Auth: Bearer Token<br/>Enforced by: kube-rbac-proxy"]
        HealthEndpoint["/health endpoint<br/>Methods: GET<br/>Auth: None<br/>Direct access (unauthenticated)"]
    end

    %% Auth flow
    Client -->|"Bearer Token"| Gateway
    Gateway -->|"TLS"| KRBAC
    KRBAC -->|"validates token"| SAR
    SAR -->|"approved"| KRBAC
    KRBAC -->|"HTTP (localhost)"| VLLMContainer

    %% KServe RBAC
    KServeSA -->|"bound via"| KServeCRB
    KServeCRB -->|"grants"| KServeCR

    %% Operator RBAC
    RHODSOp -->|"bound via"| OpCRB
    OpCRB -->|"grants"| OpCR

    %% Styling
    style Info fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style Client fill:#f9f9f9,stroke:#999
    style Gateway fill:#ffe6cc,stroke:#d79b00
    style KRBAC fill:#fff2cc,stroke:#d6b656
    style SAR fill:#dae8fc,stroke:#6c8ebf
    style VLLMContainer fill:#d5e8d4,stroke:#82b366
    style KServeSA fill:#4a90e2,stroke:#333,color:#fff
    style KServeCR fill:#f5a623,stroke:#333,color:#fff
    style KServeCRB fill:#f5a623,stroke:#333,color:#fff
    style RHODSOp fill:#4a90e2,stroke:#333,color:#fff
    style OpCR fill:#f5a623,stroke:#333,color:#fff
    style OpCRB fill:#f5a623,stroke:#333,color:#fff
    style V1Endpoints fill:#d5e8d4,stroke:#82b366
    style HealthEndpoint fill:#f8cecc,stroke:#b85450
