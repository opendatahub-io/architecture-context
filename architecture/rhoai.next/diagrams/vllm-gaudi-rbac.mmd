graph TD
    subgraph "Container Security Context"
        Container["vllm-gaudi Container<br/>odh-vllm-gaudi-rhel9"]
        User["Run As: UID 2000 / GID 0<br/>(non-root, OpenShift compatible)"]
        Container --> User
    end

    subgraph "Kubernetes RBAC"
        NoRBAC["No ClusterRoles Defined<br/>No RoleBindings Defined<br/>No ServiceAccount RBAC"]
    end

    subgraph "Authentication (Platform-Delegated)"
        AuthN["AuthN: KServe / Istio<br/>OIDC + Bearer Token"]
        AuthZ["AuthZ: Istio AuthorizationPolicy<br/>Platform-enforced"]
    end

    subgraph "API Endpoint Access"
        Inference["/v1/completions<br/>/v1/chat/completions<br/>/v1/embeddings<br/>/v1/models"]
        Health["/health"]
    end

    subgraph "Secrets"
        HFToken["HF_TOKEN<br/>Type: Environment Variable<br/>Purpose: HuggingFace Hub Auth<br/>Optional, Manual Provisioning<br/>No Auto-Rotation"]
    end

    AuthN -->|"validates requests"| Inference
    Health -->|"unauthenticated"| Container
    AuthZ -->|"enforces policy"| Inference

    Container -->|"no K8s API access"| NoRBAC
    Container -->|"uses at startup"| HFToken

    style Container fill:#4a90e2,color:#fff
    style User fill:#dae8fc,stroke:#6c8ebf
    style NoRBAC fill:#e8e8e8,stroke:#999
    style AuthN fill:#7ed321,color:#fff
    style AuthZ fill:#7ed321,color:#fff
    style Inference fill:#ffe6cc,stroke:#d79b00
    style Health fill:#d5e8d4,stroke:#82b366
    style HFToken fill:#f8cecc,stroke:#b85450
