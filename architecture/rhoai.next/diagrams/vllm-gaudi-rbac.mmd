graph TD
    subgraph "Container Security Context"
        User["Container User<br/>UID: 2000 (non-root)"]
    end

    subgraph "RBAC Status"
        NoRBAC["No Kubernetes RBAC Defined<br/>Container does not interact<br/>with the Kubernetes API"]
    end

    subgraph "Authentication & Authorization"
        direction TB
        Endpoints["/v1/completions<br/>/v1/chat/completions<br/>/v1/embeddings<br/>/v1/models<br/>/health, /version"]
        ContainerAuth["Container-Level Auth: None"]
        PlatformAuth["Platform Enforcement<br/>KServe kube-rbac-proxy sidecar<br/>or Gateway API auth proxy"]
    end

    subgraph "Credential Injection (Platform-Managed)"
        HFToken["HuggingFace Token<br/>(for gated models)<br/>Injected by platform"]
        S3Creds["S3 Credentials<br/>(AWS IAM)<br/>Injected by platform"]
    end

    subgraph "Security Findings"
        direction TB
        FIPS["⚠ FIPS Provider Removed<br/>openssl-fips-provider-so<br/>explicitly deleted in Dockerfile"]
        Hermetic["⚠ Non-Hermetic Builds<br/>hermetic: false<br/>No lock files present"]
        NoAIPCC["⚠ No AIPCC Base Image<br/>Gaudi variant disabled<br/>(AIPCC-3471)"]
    end

    User --> NoRBAC
    Endpoints --> ContainerAuth
    ContainerAuth -->|"auth delegated"| PlatformAuth
    PlatformAuth -->|"injects at runtime"| HFToken
    PlatformAuth -->|"injects at runtime"| S3Creds

    style User fill:#4a90e2,color:#fff
    style NoRBAC fill:#d5e8d4,stroke:#82b366,color:#333
    style Endpoints fill:#dae8fc,stroke:#6c8ebf,color:#333
    style ContainerAuth fill:#fff2cc,stroke:#d6b656,color:#333
    style PlatformAuth fill:#7ed321,color:#fff
    style HFToken fill:#e8e8e8,stroke:#999,color:#333
    style S3Creds fill:#e8e8e8,stroke:#999,color:#333
    style FIPS fill:#f8cecc,stroke:#b85450,color:#333
    style Hermetic fill:#f8cecc,stroke:#b85450,color:#333
    style NoAIPCC fill:#f8cecc,stroke:#b85450,color:#333
