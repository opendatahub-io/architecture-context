graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser<br/>Data Scientist"]
    end

    subgraph Ingress["INGRESS (Gateway-terminated TLS)"]
        Gateway["Gateway / Istio Gateway<br/>443/TCP HTTPS<br/>TLS termination<br/>SIMPLE mode"]
    end

    subgraph InternalServices["INTERNAL SERVICES (Cluster)"]
        direction TB

        subgraph NS_Workbenches["Namespace: redhat-ods-applications"]
            Frontend["workspaces-frontend<br/>8080/TCP HTTP<br/>nginx"]
            Backend["workspaces-backend<br/>4000/TCP HTTP<br/>TokenReview + SubjectAccessReview"]
            Controller["workspaces-controller<br/>8081/TCP health<br/>8080/TCP metrics HTTPS"]
            WebhookSvc["workspaces-webhook-service<br/>443/TCP → 9443/TCP HTTPS<br/>TLS 1.2+ (OpenShift profile)"]
            MetricsSvc["controller-metrics-service<br/>8443/TCP → 8080/TCP HTTPS<br/>TLS 1.2+ authn/authz"]
        end

        subgraph NS_User["Namespace: user-namespace"]
            WorkspacePod["Workspace Pod<br/>(StatefulSet)<br/>+ kube-rbac-proxy sidecar"]
            HTTPRoute["HTTPRoute<br/>→ data-science-gateway"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        GatewayResource["data-science-gateway<br/>openshift-ingress<br/>443/TCP"]
        MetricsAPI["Kubernetes Metrics API<br/>6443/TCP HTTPS"]
        OpenShiftCR["OpenShift APIServer CR<br/>TLS profile source"]
    end

    %% External flows
    Browser -->|"HTTPS/443<br/>TLS (Gateway-terminated)"| Gateway
    Gateway -->|"HTTP/8080<br/>internal"| Frontend
    Gateway -->|"per-workspace HTTPRoute<br/>→ workspace pod"| WorkspacePod

    %% Frontend to Backend
    Frontend -.->|"user browser calls<br/>HTTP/4000<br/>Bearer token / headers"| Backend

    %% Backend to K8s
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>TokenReview"| K8sAPI
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>SubjectAccessReview"| K8sAPI

    %% Controller to K8s
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>CRUD resources"| K8sAPI
    Controller -->|"reads TLS profile"| OpenShiftCR

    %% Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS 1.2+<br/>Admission webhook"| WebhookSvc

    %% Controller creates ingress
    Controller -.->|"creates HTTPRoute"| HTTPRoute
    HTTPRoute -.->|"references"| GatewayResource

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef user fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Browser external
    class Gateway ingress
    class Frontend,Backend,Controller,WebhookSvc,MetricsSvc internal
    class WorkspacePod,HTTPRoute user
    class K8sAPI,GatewayResource,MetricsAPI,OpenShiftCR platform
