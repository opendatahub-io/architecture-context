graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        IstioGW["Istio Ingress Gateway<br/>443/TCP → internal<br/>TLS 1.2+ termination<br/>VirtualService routing"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS via Istio Sidecar)"]
        direction TB

        subgraph NS_Workspaces["Namespace: kubeflow-workspaces"]
            direction TB

            Frontend["workspaces-frontend<br/>SA: workspaces-frontend<br/>Port: 8080/TCP HTTP<br/>Image: nginx:alpine<br/>NetworkPolicy: allow istio-ingress only"]

            Backend["workspaces-backend<br/>SA: workspaces-backend<br/>Port: 4000/TCP HTTP<br/>Image: distroless<br/>Auth: Header + SAR<br/>NetworkPolicy: allow istio-ingress only"]

            Controller["workspaces-controller<br/>SA: workspaces-controller<br/>Ports: 8081/TCP (health), 9443/TCP (webhook)<br/>Image: distroless<br/>NetworkPolicy: default-deny + allow istio"]

            WebhookSvc["workspaces-webhook-service<br/>Port: 443/TCP → 9443/TCP<br/>TLS: cert-manager provisioned"]

            MetricsSvc["metrics-service<br/>Port: 8080/TCP HTTP"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            WsPod["Workspace Pod (StatefulSet)<br/>SA: default<br/>Port: dynamic/TCP HTTP<br/>Image: JupyterLab/RStudio/VS Code"]

            WsSvc["ws-{name}-{hash} Service<br/>Port: dynamic/TCP"]

            WsVS["ws-{name} VirtualService<br/>Path: /workspace/connect/{ns}/{name}/"]

            PVC["PersistentVolumeClaim<br/>(home + data volumes)"]
        end
    end

    subgraph KubeControl["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token auth"]

        K8sAuthZ["Authorization API<br/>(SubjectAccessReview)<br/>6443/TCP HTTPS"]
    end

    subgraph Supporting["SUPPORTING SERVICES"]
        CertManager["cert-manager<br/>Certificate CR provisioning"]
        Prometheus["Prometheus<br/>Metrics scraping<br/>8080/TCP HTTP"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth (external)"| IstioGW

    %% Ingress → Services
    IstioGW -->|"HTTP/8080<br/>mTLS (Istio)<br/>AuthorizationPolicy:<br/>allow istio-ingressgateway SA"| Frontend
    IstioGW -->|"HTTP/4000<br/>mTLS (Istio)<br/>AuthorizationPolicy:<br/>allow istio-ingressgateway SA"| Backend
    IstioGW -->|"HTTP/dynamic<br/>mTLS (Istio)<br/>VirtualService routing"| WsSvc

    %% Backend → K8s
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SubjectAccessReview"| K8sAuthZ

    %% Controller → K8s
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>CRUD: StatefulSets, Services,<br/>VirtualServices, Pods, Events"| K8sAPI

    %% K8s → Webhook
    K8sAPI -->|"HTTPS/443<br/>TLS (cert-manager)<br/>Admission Review"| WebhookSvc

    %% Supporting
    CertManager -.->|"Certificate CR"| WebhookSvc
    Prometheus -.->|"HTTP/8080<br/>Metrics scrape"| MetricsSvc

    %% Workspace
    WsSvc --> WsPod
    WsPod --> PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef kubecontrol fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef supporting fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class IstioGW ingress
    class Frontend,Backend,Controller,WebhookSvc,MetricsSvc,WsPod,WsSvc,WsVS,PVC servicemesh
    class K8sAPI,K8sAuthZ kubecontrol
    class CertManager,Prometheus supporting
