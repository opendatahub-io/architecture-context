graph TB
    subgraph EvalHub["EvalHub Service"]
        direction TB
        API["eval-hub API Server<br/>Go Service<br/>Port 8080/TCP"]
        AuthMiddleware["Auth Middleware<br/>TokenReview + SAR"]
        Routes["Route Handler<br/>ExecutionContext pattern"]
        Storage["Storage Layer<br/>SQLite / PostgreSQL"]
        K8sRuntime["Kubernetes Runtime<br/>Job Orchestration"]
        MLflowClient["MLflow Client<br/>Experiment Tracking"]

        API --> AuthMiddleware
        AuthMiddleware --> Routes
        Routes --> Storage
        Routes --> K8sRuntime
        Routes --> MLflowClient
    end

    subgraph JobPod["Evaluation Job Pod (tenant namespace)"]
        direction TB
        InitContainer["eval_runtime_init<br/>S3 Data Download"]
        Sidecar["eval_runtime_sidecar<br/>Reverse Proxy<br/>Port 8080/TCP"]
        EvalAdapter["lighteval Adapter<br/>Python Container"]

        InitContainer -.->|"shared volume<br/>/test_data"| EvalAdapter
        EvalAdapter -->|"HTTP localhost:8080"| Sidecar
    end

    Client["Client<br/>(Dashboard / SDK)"] -->|"HTTPS/443<br/>Bearer Token"| KubeRBACProxy["kube-rbac-proxy<br/>mTLS Termination"]
    KubeRBACProxy -->|"HTTP/8080"| API

    K8sRuntime -->|"creates"| JobPod
    Sidecar -->|"HTTPS<br/>Bearer Token"| API
    Sidecar -->|"HTTPS<br/>Bearer Token"| MLflow["MLflow Server"]
    MLflowClient -->|"HTTPS<br/>Bearer Token"| MLflow
    K8sRuntime -->|"HTTPS/6443<br/>SA Token"| K8sAPI["Kubernetes API"]
    InitContainer -->|"HTTPS<br/>AWS Credentials"| S3["S3-Compatible Storage"]

    Prometheus["Prometheus"] -->|"HTTP/8080<br/>/metrics"| API
    API -.->|"OTLP/gRPC"| OTELCollector["OpenTelemetry Collector"]

    TrustyAIOp["TrustyAI Operator"] -->|"manages lifecycle"| EvalHub

    style API fill:#4a90e2,stroke:#333,color:#fff
    style AuthMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style Routes fill:#4a90e2,stroke:#333,color:#fff
    style Storage fill:#4a90e2,stroke:#333,color:#fff
    style K8sRuntime fill:#4a90e2,stroke:#333,color:#fff
    style MLflowClient fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#50c878,stroke:#333,color:#fff
    style Sidecar fill:#50c878,stroke:#333,color:#fff
    style EvalAdapter fill:#50c878,stroke:#333,color:#fff
    style KubeRBACProxy fill:#f5a623,stroke:#333,color:#fff
    style MLflow fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style OTELCollector fill:#999,stroke:#333,color:#fff
    style TrustyAIOp fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
