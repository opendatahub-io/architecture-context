graph TB
    subgraph External["EXTERNAL (No External Ingress)"]
        direction TB
        NoIngress["No external ingress<br/>Internal-only controller"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes RBAC)"]
        direction TB

        subgraph NS_WVA["Namespace: wva-system"]
            WVA["WVA Controller Manager<br/>SA: controller-manager<br/>Image: distroless"]
            MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS, TLS (self-signed / service-ca)<br/>Auth: Bearer + TokenReview + SAR"]
            HealthSvc["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth"]
        end

        subgraph NS_Monitoring["Namespace: openshift-monitoring / monitoring"]
            Prometheus["Prometheus / Thanos Querier<br/>9090/TCP HTTPS<br/>TLS 1.2+"]
        end

        subgraph NS_User["Managed Namespaces (user workloads)"]
            vLLM["vLLM Inference Pods<br/>Metrics: kv_cache, queue,<br/>throughput, latency"]
            SGLang["SGLang Inference Pods<br/>Metrics: sglang:* prefix"]
            EPP["EPP (Endpoint Picker)<br/>Metrics: scheduler_attempts,<br/>flow_control_queue_size"]
            HPA["HPA / KEDA<br/>Reads wva_desired_replicas"]
            Deployments["Deployments / LWS<br/>Scale subresource"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS mTLS"]
    end

    subgraph NodeInfra["NODE INFRASTRUCTURE"]
        Nodes["GPU Nodes<br/>Labels: nvidia.com/gpu.*<br/>amd.com/gpu, habana.ai/gaudi<br/>gpu.intel.com/i915"]
    end

    %% WVA egress flows
    WVA -->|"HTTPS/9090<br/>TLS 1.2+<br/>Bearer Token (SA)"| Prometheus
    WVA -->|"HTTPS/443<br/>mTLS (in-cluster)<br/>SA Token"| K8sAPI
    WVA -.->|"HTTP/HTTPS<br/>Configurable port<br/>Bearer Token (optional)<br/>Direct pod scraping"| vLLM

    %% Metrics emission
    WVA -->|"Expose /metrics<br/>HTTPS/8443"| MetricsSvc
    Prometheus -->|"Scrape /metrics<br/>HTTPS/8443<br/>Bearer Token (SA)"| MetricsSvc

    %% Inference metrics flow
    vLLM -->|"HTTP (scraped)"| Prometheus
    SGLang -->|"HTTP (scraped)"| Prometheus
    EPP -->|"HTTP (scraped)"| Prometheus

    %% HPA/KEDA flow
    HPA -->|"Query wva_desired_replicas<br/>HTTPS/9090"| Prometheus
    HPA -->|"PATCH scale subresource<br/>HTTPS/443 mTLS"| K8sAPI

    %% Scale-from-zero direct path
    WVA -->|"PATCH scale subresource<br/>(scale-from-zero only)<br/>HTTPS/443 mTLS"| K8sAPI

    %% GPU discovery
    WVA -->|"Read node labels<br/>HTTPS/443 mTLS"| K8sAPI
    K8sAPI -.->|"Node label data"| Nodes

    %% K8s API watches
    K8sAPI -.->|"Watch: HPA, ScaledObject,<br/>ConfigMap, InferencePool,<br/>Deployment, LWS, Pod, Node"| WVA

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef wva fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef monitoring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef userworkload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8sapi fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef infra fill:#f5f5f5,stroke:#666,stroke-width:1px
    classDef service fill:#e1f5fe,stroke:#0288d1,stroke-width:1px

    class NoIngress external
    class WVA wva
    class Prometheus monitoring
    class vLLM,SGLang,EPP,HPA,Deployments userworkload
    class K8sAPI k8sapi
    class Nodes infra
    class MetricsSvc,HealthSvc service
