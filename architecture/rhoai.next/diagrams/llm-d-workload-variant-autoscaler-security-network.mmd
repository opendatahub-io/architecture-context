graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        direction TB
        Inference["Inference Clients<br/>(no direct WVA interaction)"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (mTLS In-Cluster)"]
        direction TB

        subgraph WVANamespace["Namespace: wva-system"]
            WVA["WVA Controller Manager<br/>SA: controller-manager<br/>Ports: 8443/TCP (metrics, HTTPS/TLS)<br/>8081/TCP (probes, HTTP)"]
        end

        subgraph MonitoringNS["Namespace: monitoring / openshift-monitoring"]
            Prometheus["Prometheus / Thanos Querier<br/>9090/TCP<br/>TLS 1.2+"]
            ServiceMonitor["ServiceMonitor<br/>(scrape config)"]
        end

        subgraph UserNamespaces["Namespace: user workloads"]
            vLLMPods["vLLM / SGLang Pods<br/>Metrics port (scraped)"]
            Deployments["Deployments / LWS<br/>(scale targets)"]
            HPA["HPA / KEDA ScaledObject<br/>(llm-d.ai/managed: true)"]
        end

        subgraph InfraNamespace["Namespace: gateway-system"]
            EPP["EPP (Endpoint Picker)<br/>SA: epp-metrics-reader"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS mTLS"]
        Nodes["Kubernetes Nodes<br/>(GPU labels: NVIDIA, AMD, Intel)"]
    end

    subgraph Secrets["SECRETS & CERTIFICATES"]
        EPPToken["epp-metrics-token<br/>kubernetes.io/service-account-token<br/>Manual provisioning"]
        CMToken["controller-manager-token<br/>(OpenShift only)<br/>Manual provisioning"]
        MetricsCert["metrics-server-cert<br/>kubernetes.io/tls<br/>Auto: service-ca (OpenShift)"]
    end

    %% WVA Egress
    WVA -->|"HTTPS/9090<br/>TLS 1.2+<br/>Bearer Token (SA)"| Prometheus
    WVA -->|"HTTPS/443<br/>mTLS (in-cluster)<br/>SA Token"| K8sAPI
    WVA -.->|"HTTP(S)/configurable<br/>Bearer Token (optional)<br/>Direct pod scraping"| vLLMPods

    %% Prometheus scraping WVA
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer Token + TokenReview"| WVA

    %% Prometheus scraping workloads
    vLLMPods -.->|"HTTP/metrics<br/>(Prometheus scrape)"| Prometheus
    EPP -.->|"HTTP/metrics<br/>(Prometheus scrape)"| Prometheus

    %% HPA/KEDA consuming WVA metrics
    HPA -->|"HTTPS/9090<br/>Query wva_desired_replicas<br/>Bearer Token"| Prometheus
    HPA -->|"HTTPS/443<br/>PATCH scale subresource<br/>SA Token"| K8sAPI

    %% K8s API interactions
    K8sAPI -->|"Watch events"| WVA

    %% Node label reads
    WVA -.->|"GET node labels<br/>(GPU discovery)"| Nodes

    %% Secret usage
    EPPToken -.->|"auth for EPP metrics"| Prometheus
    CMToken -.->|"ServiceMonitor auth"| Prometheus
    MetricsCert -.->|"TLS serving cert"| WVA

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef wva fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef monitoring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef infra fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secret fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Inference external
    class WVA wva
    class Prometheus,ServiceMonitor monitoring
    class vLLMPods,Deployments,HPA workload
    class EPP infra
    class K8sAPI,Nodes k8s
    class EPPToken,CMToken,MetricsCert secret
