graph TB
    subgraph JobPod["KUBERNETES JOB POD (Trusted)"]
        direction TB

        subgraph PodInternal["Pod-Local (Loopback)"]
            Adapter["GarakAdapter<br/>SA: eval-hub provisioned<br/>Image: aipcc/cpu:3.5.0"]
            Sidecar["eval-hub Sidecar<br/>8080/TCP HTTP<br/>Plaintext (loopback)"]
        end

        ConfigMap["ConfigMap Mount<br/>/etc/eval-job/spec.json"]
        ModelAuth["model-auth Secret<br/>/mnt/model-auth/<br/>API keys (volume)"]
        DataConn["Data Connection Secret<br/>AWS_* env vars"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token"]
        KFPAPI["KFP API Server<br/>443/TCP or 8080/TCP<br/>HTTPS or HTTP (sidecar)<br/>SA Token / sidecar proxy"]
    end

    subgraph ExternalLLMs["EXTERNAL LLM ENDPOINTS"]
        TargetLLM["Target LLM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (api-key)"]
        JudgeLLM["Judge LLM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (JUDGE_API_KEY)"]
        AttackerLLM["Attacker LLM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (ATTACKER_API_KEY)"]
        EvaluatorLLM["Evaluator LLM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (EVALUATOR_API_KEY)"]
        SDGLLM["SDG LLM<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (SDG_API_KEY)"]
    end

    subgraph ExternalStorage["EXTERNAL STORAGE & REGISTRIES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM (AK+SK)"]
        OCI["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        MLflow["MLflow Tracking<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / mTLS"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
    end

    %% Pod-internal flows
    Adapter -->|"HTTP/8080<br/>Plaintext (loopback)<br/>No auth"| Sidecar
    ConfigMap -.->|"file mount"| Adapter
    ModelAuth -.->|"volume mount"| Adapter
    DataConn -.->|"env vars"| Adapter

    %% Cluster internal flows
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Adapter -->|"HTTPS/443 or HTTP/8080<br/>TLS 1.2+ or sidecar<br/>SA Token"| KFPAPI

    %% External LLM flows
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| TargetLLM
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| JudgeLLM
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| AttackerLLM
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| EvaluatorLLM
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| SDGLLM

    %% External storage flows
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| OCI
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| MLflow
    Adapter -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HFHub

    %% Styling
    classDef podinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef clusterint fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalllm fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Adapter,Sidecar podinternal
    class ConfigMap,ModelAuth,DataConn secret
    class K8sAPI,KFPAPI clusterint
    class TargetLLM,JudgeLLM,AttackerLLM,EvaluatorLLM,SDGLLM externalllm
    class S3,OCI,MLflow,HFHub externalsvc
