graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph JobPod["Adapter Pod (K8s Job)"]
            direction TB
            Adapter["garak-adapter<br/>FrameworkAdapter"]
            GarakProc["Garak Subprocess<br/>(simple mode)"]
            Sidecar["eval-hub Sidecar<br/>localhost HTTP<br/>No encryption"]
            VolMounts["Volume Mounts:<br/>- /etc/eval-job/spec.json<br/>- model-auth secret<br/>- SA token"]
        end

        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>SA Token"]

        subgraph KFPOnly["KFP Mode Only"]
            KFPServer["KFP API Server<br/>KFP_ENDPOINT HTTPS<br/>TLS (verify_ssl fallback)<br/>SA token / sidecar / KFP_AUTH_TOKEN"]
            KFPPods["KFP Pipeline Pods<br/>(validate, taxonomy, SDG,<br/>prompts, scan, outputs)"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>AWS_S3_ENDPOINT HTTPS<br/>TLS<br/>AWS SigV4"]
        TargetLLM["Target LLM Endpoint<br/>Configured URL HTTPS<br/>TLS<br/>API Key (Bearer)"]
        SDGModel["SDG Model Endpoint<br/>sdg_api_base HTTPS<br/>TLS<br/>API Key (Bearer)"]
    end

    %% Internal flows
    Adapter -->|"reads spec<br/>volume mount"| VolMounts
    Adapter -->|"status callbacks<br/>localhost HTTP<br/>no auth"| Sidecar
    Adapter -->|"reads secrets/configmaps<br/>HTTPS/443<br/>TLS, SA token"| K8sAPI

    %% Simple mode flow
    GarakProc -->|"adversarial probes<br/>HTTPS<br/>TLS, API key"| TargetLLM

    %% KFP mode flows
    Adapter -->|"submit pipeline<br/>HTTPS<br/>TLS, SA token"| KFPServer
    KFPServer -->|"orchestrates"| KFPPods
    KFPPods -->|"fetch/store artifacts<br/>HTTPS<br/>TLS, AWS SigV4"| S3
    KFPPods -->|"generate prompts<br/>HTTPS<br/>TLS, API key"| SDGModel
    KFPPods -->|"send probes<br/>HTTPS<br/>TLS, API key"| TargetLLM
    Adapter -->|"download results<br/>HTTPS<br/>TLS, AWS SigV4"| S3

    %% Styling
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef jobpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef kfp fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef externalSvc fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Adapter,GarakProc,Sidecar,VolMounts jobpod
    class K8sAPI cluster
    class KFPServer,KFPPods kfp
    class TargetLLM,S3,SDGModel externalSvc
