graph TB
    subgraph JobPod["K8s JOB POD (No Inbound Exposure)"]
        direction TB

        subgraph AdapterContainer["Adapter Container"]
            Adapter["Garak Adapter<br/>Image: aipcc/cpu:3.5.0<br/>SA: inherited from eval-hub"]
        end

        subgraph SidecarContainer["eval-hub Sidecar Container"]
            Sidecar["eval-hub Sidecar<br/>Port: 8080/TCP<br/>loopback only"]
        end

        Adapter -->|HTTP/8080<br/>plaintext loopback<br/>Bearer Token| Sidecar
    end

    subgraph ExternalLLMs["EXTERNAL LLM ENDPOINTS"]
        TargetLLM["Target LLM Model<br/>(user-specified)"]
        AttackerLLM["Attacker LLM<br/>(TAPIntent attacks)"]
        JudgeLLM["Judge LLM<br/>(MulticlassJudge)"]
        EvaluatorLLM["Evaluator LLM<br/>(TAPIntent evaluator)"]
        SDGLLM["SDG LLM<br/>(adversarial prompt gen)"]
        TransLLM["Translation LLM<br/>(optional)"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        KFP["Kubeflow Pipelines API"]
        K8sAPI["Kubernetes API Server"]
        MLflow["MLflow Tracking Server"]
    end

    subgraph StorageServices["STORAGE SERVICES"]
        S3["S3-Compatible Store"]
        OCI["OCI Registry"]
    end

    subgraph ConditionalExternal["CONDITIONAL EXTERNAL"]
        HFHub["Hugging Face Hub"]
    end

    %% Adapter egress flows
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token API key| TargetLLM
    Adapter -->|HTTPS/443 or HTTP/8080<br/>TLS 1.2+<br/>SA Token| KFP
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>AWS IAM creds| S3
    Adapter -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token SA| K8sAPI

    %% Sidecar egress flows
    Sidecar -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| MLflow
    Sidecar -->|HTTPS/443<br/>TLS 1.2+<br/>Registry creds| OCI

    %% KFP pipeline pod egress (intents benchmark)
    KFP -.->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| AttackerLLM
    KFP -.->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| JudgeLLM
    KFP -.->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| EvaluatorLLM
    KFP -.->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| SDGLLM
    KFP -.->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| TransLLM

    %% Conditional
    Adapter -.->|HTTPS/443<br/>TLS 1.2+<br/>Optional Token| HFHub

    %% Styling - Trust zones
    classDef jobpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef llm fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef conditional fill:#f5f5f5,stroke:#999,stroke-width:1px,stroke-dasharray: 5

    class Adapter,Sidecar jobpod
    class TargetLLM,AttackerLLM,JudgeLLM,EvaluatorLLM,SDGLLM,TransLLM llm
    class KFP,K8sAPI,MLflow platform
    class S3,OCI storage
    class HFHub conditional
