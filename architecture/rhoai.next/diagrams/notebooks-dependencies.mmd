graph LR
    Notebooks["Notebooks<br/>Image Factory"]

    %% ── External Runtime Dependencies ──
    subgraph ExtRuntime["External Runtime Dependencies"]
        Python["Python 3.12"]
        JupyterLab["JupyterLab 4.5-4.6"]
        CodeServerDep["code-server v4.112.0"]
        NodeJS["Node.js 22.22.0"]
        NginxDep["nginx 1.24"]
        HttpdDep["httpd (Apache) 2.4"]
    end

    Notebooks -->|"primary runtime"| Python
    Notebooks -->|"notebook IDE"| JupyterLab
    Notebooks -->|"VS Code IDE"| CodeServerDep
    Notebooks -->|"code-server runtime"| NodeJS
    Notebooks -->|"reverse proxy"| NginxDep
    Notebooks -->|"CGI gateway"| HttpdDep

    %% ── Conditional ML Framework Dependencies ──
    subgraph MLFrameworks["ML Frameworks (Conditional)"]
        PyTorchDep["PyTorch 2.11<br/>(CUDA variants)"]
        TensorFlowDep["TensorFlow 2.x<br/>(CUDA/ROCm variants)"]
        CUDA["CUDA Toolkit<br/>12.9 / 13.0"]
        ROCm["ROCm 7.14<br/>(AMD GPU)"]
        Java17["Java 17 OpenJDK<br/>(TrustyAI only)"]
        Elyra["Elyra 5.0<br/>(ODH fork)"]
    end

    Notebooks -->|"deep learning"| PyTorchDep
    Notebooks -->|"deep learning"| TensorFlowDep
    Notebooks -->|"NVIDIA accel"| CUDA
    Notebooks -->|"AMD accel"| ROCm
    Notebooks -.->|"TrustyAI only"| Java17
    Notebooks -->|"pipeline editor"| Elyra

    %% ── Build-Time Dependencies ──
    subgraph BuildDeps["Build-Time Dependencies"]
        UV["uv >=0.10,<0.12<br/>(pkg installer)"]
        Cachi2["Cachi2 / Hermeto<br/>(hermetic prefetch)"]
        MongoCLI["mongocli<br/>(FIPS Go binary)"]
    end

    Notebooks -->|"pkg install"| UV
    Notebooks -->|"hermetic build"| Cachi2
    Notebooks -.->|"datascience variants"| MongoCLI

    %% ── Internal Platform Dependencies ──
    subgraph InternalODH["Internal Platform Dependencies"]
        NotebookCtrl["ODH Notebook Controller<br/>(creates pods from Notebook CR)"]
        Dashboard["ODH Dashboard<br/>(discovers via ImageStream)"]
        Operator["ODH/RHOAI Operator<br/>(deploys manifests)"]
        DSPA["Data Science Pipelines<br/>(pipeline execution)"]
        ElyraEngine["Elyra Pipeline Engine<br/>(runtime image consumer)"]
        AIPCCImages["AIPCC Base Images<br/>(RHEL 9.6 EUS)"]
        CheckPayload["check-payload<br/>(FIPS validation)"]
    end

    NotebookCtrl -->|"instantiates images"| Notebooks
    Dashboard -->|"discovers images"| Notebooks
    Operator -->|"deploys manifests"| Notebooks
    DSPA -->|"mounts secret"| Notebooks
    ElyraEngine -->|"pulls runtime images"| Notebooks
    Notebooks -->|"FROM base image"| AIPCCImages
    CheckPayload -->|"validates"| Notebooks

    %% ── External Service Dependencies (Egress) ──
    subgraph ExternalServices["External Services (Runtime Egress)"]
        S3["S3 Object Storage<br/>443/TCP HTTPS"]
        KFP["Kubeflow Pipelines<br/>443/TCP HTTPS"]
        Git["Git Repositories<br/>443/TCP HTTPS"]
        MongoDB["MongoDB<br/>27017/TCP"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        MySQL["MySQL<br/>3306/TCP"]
        MLflowSvc["MLflow Tracking<br/>5000/TCP"]
    end

    Notebooks -->|"data access"| S3
    Notebooks -->|"pipeline submission"| KFP
    Notebooks -->|"git operations"| Git
    Notebooks -->|"database"| MongoDB
    Notebooks -->|"database"| PostgreSQL
    Notebooks -->|"database"| MySQL
    Notebooks -->|"experiment tracking"| MLflowSvc

    %% ── CI/CD Dependencies ──
    subgraph CICD["CI/CD Integration"]
        Konflux["Konflux / Tekton<br/>(build pipeline)"]
        SecuritySync["security-config-sync[bot]<br/>(config sync)"]
        Renovate["Renovate / MintMaker<br/>(dependency updates)"]
    end

    Konflux -->|"builds images"| Notebooks
    SecuritySync -.->|"syncs config"| Notebooks
    Renovate -.->|"updates deps"| Notebooks

