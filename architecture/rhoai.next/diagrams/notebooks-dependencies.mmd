graph LR
    Notebooks["Notebooks<br/>(Container Image<br/>Build Repository)"]

    %% External Dependencies (Build-time)
    Notebooks -->|"base layer<br/>SHA256 pinned"| AIPCC["AIPCC Base Images<br/>CPU / CUDA / ROCm"]
    Notebooks -->|"GPU compute<br/>v13.0.2 / v12.9.1"| CUDA["NVIDIA CUDA Toolkit"]
    Notebooks -->|"GPU compute<br/>v7.14"| ROCm["AMD ROCm Runtime"]
    Notebooks -->|"IDE<br/>v4.5+"| JupyterLab["JupyterLab"]
    Notebooks -->|"IDE<br/>v4.106+"| CodeServer["Code-Server"]
    Notebooks -->|"pipeline editor<br/>v5.0 ODH fork"| Elyra["Elyra"]
    Notebooks -->|"reverse proxy"| NginxDep["nginx 1.x"]
    Notebooks -->|"CGI gateway"| HTTPD["httpd 2.4"]
    Notebooks -->|"build-time<br/>v22"| NodeJS["Node.js"]
    Notebooks -->|"DB CLI"| Mongocli["mongocli"]
    Notebooks -->|"hermetic prefetch"| Cachi2["Cachi2 / Hermeto"]
    Notebooks -->|"Python wheels"| RHAI["RHEL AI Python<br/>Package Index"]

    %% Internal Platform Dependencies (Runtime)
    NotebookCtrl["ODH Notebook Controller"] -->|"mutating webhook<br/>injects sidecars<br/>mounts secrets"| Notebooks
    Operator["ODH/RHOAI Operator"] -->|"deploys ImageStreams<br/>from manifests/"| Notebooks
    Dashboard["ODH Dashboard"] -->|"discovers images<br/>via annotations"| Notebooks
    DSPA["Data Science Pipelines<br/>Application"] -.->|"mounted secret<br/>pipeline connection"| Notebooks
    ElyraConfig["Elyra Runtime ConfigMap"] -.->|"mounted ConfigMap<br/>runtime metadata"| Notebooks

    %% Integration Points (Consumers)
    Notebooks -->|"kustomize manifests<br/>HTTPS/6443"| OperatorInt["ODH/RHOAI Operator"]
    Notebooks -->|"ImageStream annotations<br/>HTTPS/6443"| DashboardInt["ODH Dashboard"]
    Notebooks -->|"Notebook CR pods<br/>HTTPS/6443"| NotebookCtrlInt["Notebook Controller"]
    Notebooks -->|"/api/kernels/ polling<br/>HTTP/8888 or 8080"| CullerInt["Controller Culler"]
    Notebooks -->|"runtime-image label<br/>Elyra config"| ElyraInt["Elyra"]
    Notebooks -->|"pipeline submission<br/>HTTPS/443"| DSPAInt["DSPA"]
    Notebooks -->|"base container layer<br/>HTTPS/443"| AIPCCInt["AIPCC Base Images"]
    Notebooks -->|"package resolution<br/>HTTPS/443"| RHAIInt["RHEL AI Index"]
    Notebooks -->|"CI/CD builds"| KonfluxInt["Konflux / Tekton"]
    Notebooks -->|"config sync"| SecurityConfig["security-config bot"]

    %% Styling
    style Notebooks fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

