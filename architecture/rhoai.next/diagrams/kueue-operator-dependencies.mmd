graph LR
    KueueOp["kueue-operator<br/>(openshift-kueue-operator +<br/>kueue-controller-manager)"]

    %% Hard External Dependencies
    KueueOp -->|"gates on availability<br/>TLS cert lifecycle"| CertManager["cert-manager v1<br/>(required)"]
    KueueOp -->|"ServiceMonitor CRD<br/>mTLS metrics scraping"| PromOperator["prometheus-operator"]
    KueueOp -->|"REST + Watch<br/>6443/TCP"| K8sAPI["Kubernetes API"]

    %% Build Dependencies
    KueueOp -.-|"OpenShift fork"| KueueUpstream["sigs.k8s.io/kueue v0.10.2<br/>(openshift/kubernetes-sigs-kueue)"]
    KueueOp -.-|"operator framework"| LibraryGo["openshift/library-go"]
    KueueOp -.-|"controller framework"| ControllerRuntime["controller-runtime v0.20.4"]

    %% Workload Framework Integrations (webhook interception)
    subgraph WorkloadFrameworks["Managed Workload Frameworks (webhook interception)"]
        Kubeflow["Kubeflow Training Operator<br/>(kubeflow.org)<br/>MPIJob, PyTorchJob, TFJob,<br/>PaddleJob, XGBoostJob"]
        Ray["Ray Operator<br/>(ray.io)<br/>RayCluster, RayJob"]
        CodeFlare["CodeFlare Operator<br/>(workload.codeflare.dev)<br/>AppWrapper"]
        JobSetCtrl["JobSet Controller<br/>(jobset.x-k8s.io)<br/>JobSet"]
        LWSCtrl["LeaderWorkerSet Controller<br/>(leaderworkerset.x-k8s.io)<br/>LeaderWorkerSet"]
    end

    KueueOp -->|"admission control<br/>9443/TCP"| Kubeflow
    KueueOp -->|"admission control<br/>9443/TCP"| Ray
    KueueOp -->|"admission control<br/>9443/TCP"| CodeFlare
    KueueOp -->|"admission control<br/>9443/TCP"| JobSetCtrl
    KueueOp -->|"admission control<br/>9443/TCP"| LWSCtrl

    %% Styling
    style KueueOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style CertManager fill:#ff6b6b,stroke:#333,stroke-width:2px
    style PromOperator fill:#999,stroke:#333
    style K8sAPI fill:#999,stroke:#333
    style KueueUpstream fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style LibraryGo fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style ControllerRuntime fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style Kubeflow fill:#7ed321,stroke:#333
    style Ray fill:#7ed321,stroke:#333
    style CodeFlare fill:#7ed321,stroke:#333
    style JobSetCtrl fill:#7ed321,stroke:#333
    style LWSCtrl fill:#7ed321,stroke:#333
