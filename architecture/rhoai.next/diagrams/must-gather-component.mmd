graph TB
    subgraph "must-gather Container Image"
        direction TB
        subgraph "Entrypoint"
            GatherSH["gather.sh<br/>(Main Orchestrator)"]
        end

        subgraph "Shared Libraries"
            CommonSH["common.sh<br/>run_mustgather, get_all_namespace,<br/>rhoai_version, collect_helm_releases"]
            XksUtilSH["xks_util.sh<br/>kubectl_inspect, detect_k8s_distro,<br/>auto_discover_resources"]
        end

        subgraph "Per-Component Gather Scripts (15)"
            GatherServing["gather_serving.sh<br/>KServe, Authorino, NIM, MaaS"]
            GatherDSP["gather_data_science_pipelines.sh<br/>DSP, Argo Workflows"]
            GatherDashboard["gather_dashboard.sh<br/>Dashboard, AcceleratorProfiles"]
            GatherNotebooks["gather_notebooks.sh<br/>Workbenches"]
            GatherKubeRay["gather_kuberay.sh<br/>RayCluster, RayJob"]
            GatherKueue["gather_kueue.sh<br/>ClusterQueue, Workload"]
            GatherKFTO["gather_kfto.sh<br/>PyTorchJob, TrainJob"]
            GatherMR["gather_mr.sh<br/>ModelRegistry"]
            GatherTrustyAI["gather_trustyai.sh<br/>TrustyAI, LMEvalJob"]
            GatherFeast["gather_feastoperator.sh<br/>FeatureStore"]
            GatherLLS["gather_lls.sh<br/>LlamaStackDistribution"]
            GatherMLflow["gather_mlflow.sh<br/>MLflow"]
            GatherSpark["gather_sparkoperator.sh<br/>SparkApplication"]
            GatherAIGW["gather_aigateway.sh<br/>AITenant, ExternalModel"]
            GatherMCP["gather_mcp_lifecycle_operator.sh<br/>MCPServer"]
        end

        subgraph "LLM-D Scripts"
            GatherLLMD["gather_llmd.sh<br/>LLM-D Inference"]
            GatherBatchGW["gather_batch_gateway.sh<br/>Batch Gateway"]
            GatherWVA["gather_wva.sh<br/>WVA, KEDA"]
            GatherCluster["gather_cluster.sh<br/>Cluster Resources"]
            GatherO11y["gather_o11y.sh<br/>Prometheus, Metrics"]
            subgraph "Dependency Collectors"
                DepCertMgr["cert-manager.sh"]
                DepSail["sail.sh<br/>Istio/Sail Operator"]
                DepLWS["lws.sh<br/>LeaderWorkerSet"]
            end
        end

        subgraph "CLI Tools"
            OC["oc CLI"]
            Kubectl["kubectl CLI"]
            Helm["helm CLI"]
        end
    end

    User["User / SRE"] -->|"oc adm must-gather<br/>or kubectl apply Job"| GatherSH

    GatherSH -->|"detects distro,<br/>dispatches parallel"| GatherServing
    GatherSH -->|parallel| GatherDSP
    GatherSH -->|parallel| GatherDashboard
    GatherSH -->|parallel| GatherNotebooks
    GatherSH -->|parallel| GatherKubeRay
    GatherSH -->|parallel| GatherKueue
    GatherSH -->|parallel| GatherKFTO
    GatherSH -->|parallel| GatherMR
    GatherSH -->|parallel| GatherTrustyAI
    GatherSH -->|parallel| GatherFeast
    GatherSH -->|parallel| GatherLLS
    GatherSH -->|parallel| GatherMLflow
    GatherSH -->|parallel| GatherSpark
    GatherSH -->|parallel| GatherAIGW
    GatherSH -->|parallel| GatherMCP
    GatherSH -->|parallel| GatherLLMD

    GatherServing -->|uses| CommonSH
    GatherDSP -->|uses| CommonSH
    GatherLLMD -->|uses| XksUtilSH
    GatherLLMD -->|dispatches| GatherBatchGW
    GatherLLMD -->|dispatches| GatherWVA
    GatherLLMD -->|dispatches| GatherO11y
    GatherLLMD -->|dispatches| DepCertMgr
    GatherLLMD -->|dispatches| DepSail
    GatherLLMD -->|dispatches| DepLWS

    CommonSH -->|delegates| OC
    CommonSH -->|delegates| Helm
    XksUtilSH -->|delegates| Kubectl

    OC -->|"443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]
    Kubectl -->|"443/TCP HTTPS"| K8sAPI
    Helm -->|"443/TCP HTTPS"| K8sAPI

    GatherSH -->|writes| Output["/must-gather/<br/>diagnostic tarball"]

    style GatherSH fill:#4a90e2,color:#fff
    style CommonSH fill:#4a90e2,color:#fff
    style XksUtilSH fill:#4a90e2,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Output fill:#7ed321,stroke:#333
    style User fill:#f5a623,stroke:#333
