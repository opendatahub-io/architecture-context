graph TB
    subgraph MustGather["must-gather Container Image"]
        direction TB
        Gather["gather.sh<br/>(Entrypoint / Orchestrator)"]
        Common["common.sh<br/>(Shared Library)"]
        XksUtil["xks_util.sh<br/>(xKS Distribution Detection)"]

        Gather -->|sources| Common
        Gather -->|sources| XksUtil

        subgraph ComponentGatherers["Component Gatherer Scripts"]
            direction LR
            GatherServing["gather_serving.sh"]
            GatherDSP["gather_data_science_pipelines.sh"]
            GatherDashboard["gather_dashboard.sh"]
            GatherKubeRay["gather_kuberay.sh"]
            GatherKueue["gather_kueue.sh"]
            GatherKFTO["gather_kfto.sh"]
            GatherMR["gather_mr.sh"]
            GatherTrustyAI["gather_trustyai.sh"]
            GatherFeast["gather_feastoperator.sh"]
            GatherLLS["gather_lls.sh"]
            GatherMLflow["gather_mlflow.sh"]
            GatherSpark["gather_sparkoperator.sh"]
            GatherAIGW["gather_aigateway.sh"]
            GatherMCP["gather_mcp_lifecycle_operator.sh"]
        end

        subgraph LLMDGatherers["LLM-D Collection Scripts"]
            direction LR
            GatherLLMD["gather_llmd.sh"]
            GatherCluster["gather_cluster.sh"]
            GatherO11y["gather_o11y.sh"]
            GatherWVA["gather_wva.sh"]
            GatherBatch["gather_batch_gateway.sh"]
            DepCertMgr["dependency/cert-manager.sh"]
            DepSail["dependency/sail.sh"]
            DepLWS["dependency/lws.sh"]
        end

        Gather -->|dispatches in parallel| ComponentGatherers
        Gather -->|dispatches| LLMDGatherers
    end

    Admin[Cluster Admin] -->|"oc adm must-gather<br/>or kubectl apply"| MustGather

    subgraph CLITools["Bundled CLI Tools"]
        OC["oc CLI<br/>(from base image)"]
        Kubectl["kubectl v1.33.3<br/>(from ose-cli-rhel9)"]
        Helm["helm v4.1.4<br/>(Git LFS artifact)"]
    end

    MustGather -->|uses| CLITools

    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
    CLITools -->|"GET, LIST resources<br/>TLS 1.2+ / SA token"| K8sAPI

    Output["/must-gather/<br/>Collected Diagnostics"]
    MustGather -->|writes| Output

    style MustGather fill:#4a90e2,stroke:#333,color:#fff
    style Gather fill:#3a7bd5,stroke:#333,color:#fff
    style Common fill:#3a7bd5,stroke:#333,color:#fff
    style XksUtil fill:#3a7bd5,stroke:#333,color:#fff
    style Admin fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Output fill:#7ed321,stroke:#333
    style CLITools fill:#ddd,stroke:#333
    style OC fill:#ccc,stroke:#333
    style Kubectl fill:#ccc,stroke:#333
    style Helm fill:#ccc,stroke:#333
