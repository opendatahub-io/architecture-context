graph TB
    subgraph MustGather["must-gather Diagnostic Tool"]
        direction TB

        subgraph Entrypoint["Entry Point"]
            GatherSH["gather.sh<br/>(Container Entrypoint)<br/>Dispatcher"]
        end

        subgraph Libraries["Shared Libraries"]
            CommonSH["common.sh<br/>OpenShift Library<br/>run_mustgather, get_all_namespace"]
            XksUtilSH["xks_util.sh<br/>xKS Library<br/>kubectl_inspect, detect_k8s_distro"]
        end

        subgraph Collectors["Component Collectors (14 parallel)"]
            direction LR
            GatherKServe["gather_kserve.sh<br/>KServe"]
            GatherLLMD["gather_llmd.sh<br/>LLM-D"]
            GatherAIGW["gather_aigateway.sh<br/>AI Gateway"]
            GatherDSP["gather_data_science_pipelines.sh<br/>DSP"]
            GatherNotebooks["gather_notebooks.sh<br/>Workbench"]
            GatherKubeRay["gather_kuberay.sh<br/>KubeRay"]
            GatherKueue["gather_kueue.sh<br/>Kueue"]
            GatherKFTO["gather_kfto.sh<br/>Training Operator"]
            GatherMR["gather_mr.sh<br/>Model Registry"]
            GatherTrustyAI["gather_trustyai.sh<br/>TrustyAI"]
            GatherFeast["gather_feastoperator.sh<br/>Feast"]
            GatherMLflow["gather_mlflow.sh<br/>MLflow"]
            GatherSpark["gather_sparkoperator.sh<br/>Spark"]
            GatherDashboard["gather_dashboard.sh<br/>Dashboard"]
        end

        subgraph SpecialCollectors["Specialized Collectors"]
            GatherModelExpress["gather_modelexpress.sh<br/>ModelExpress"]
            GatherMCPLifecycle["gather_mcp_lifecycle_operator.sh<br/>MCP"]
            GatherOGX["gather_ogx.sh<br/>OGX"]
            GatherXKS["gather_xks.sh<br/>xKS Default"]
            GatherCluster["gather_cluster.sh<br/>Cluster Info"]
            GatherO11y["gather_o11y.sh<br/>Observability"]
        end

        subgraph LLMDDeps["LLM-D Dependency Collectors"]
            CertManager["cert-manager.sh"]
            Sail["sail.sh<br/>Istio/Sail"]
            LWS["lws.sh<br/>LeaderWorkerSet"]
        end
    end

    Admin["Cluster Admin"] -->|"oc adm must-gather<br/>or kubectl apply"| GatherSH
    GatherSH -->|detects distro| CommonSH
    GatherSH -->|detects distro| XksUtilSH
    GatherSH -->|dispatches| Collectors
    GatherSH -->|dispatches| SpecialCollectors
    GatherLLMD -->|calls| LLMDDeps

    CommonSH -->|"oc adm inspect"| K8sAPI["Kubernetes API<br/>443/TCP"]
    XksUtilSH -->|"kubectl API calls"| K8sAPI

    GatherSH -->|writes| Output["/must-gather/<br/>Local Filesystem"]

    style GatherSH fill:#4a90e2,color:#fff
    style CommonSH fill:#50c878,color:#fff
    style XksUtilSH fill:#50c878,color:#fff
    style K8sAPI fill:#f5a623,color:#fff
    style Output fill:#e8e8e8,stroke:#999
    style Admin fill:#ddd,stroke:#999
