graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_EvalHub["eval-hub-sa<br/>(eval-hub namespace)"]
        SA_Tenant["test-sa<br/>(tenant namespace)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Full["eval-hub-service-full-access<br/>(RoleBinding in tenant namespace)"]
    end

    subgraph Roles["Cluster Roles / Roles"]
        CR_Full["eval-hub-service-full-access<br/>(Role)"]
    end

    subgraph APIResources["API Resources (trustyai.opendatahub.io)"]
        Evaluations["trustyai.opendatahub.io<br/>evaluations"]
        Collections["trustyai.opendatahub.io<br/>collections"]
        Providers["trustyai.opendatahub.io<br/>providers"]
        StatusEvents["trustyai.opendatahub.io<br/>status-events"]
    end

    subgraph AuthMiddleware["Authentication & Authorization Middleware"]
        TokenReview["TokenReview<br/>DelegatingAuthenticator<br/>Anonymous auth: disabled"]
        SAR["SubjectAccessReview<br/>DelegatingAuthorizer<br/>Allow cache: 5min<br/>Deny cache: 30s"]
    end

    subgraph PublicEndpoints["Public Endpoints (No Auth)"]
        Health["/api/v1/health"]
        Metrics["/metrics"]
        Docs["/docs"]
        OpenAPI["/openapi.yaml"]
    end

    SA_Tenant -->|"bound via"| RB_Full
    RB_Full -->|"grants"| CR_Full
    CR_Full -->|"get, list, create,<br/>update, patch, delete"| Evaluations
    CR_Full -->|"get, list, create,<br/>update, patch, delete"| Collections
    CR_Full -->|"get, list, create,<br/>update, patch, delete"| Providers
    CR_Full -->|"create"| StatusEvents

    SA_EvalHub -->|"in-cluster auth"| TokenReview
    TokenReview -->|"validates token"| SAR
    SAR -->|"checks permissions in<br/>X-Tenant namespace"| APIResources

    style SA_EvalHub fill:#4a90e2,stroke:#333,color:#fff
    style SA_Tenant fill:#4a90e2,stroke:#333,color:#fff
    style CR_Full fill:#f5a623,stroke:#333,color:#fff
    style RB_Full fill:#f5a623,stroke:#333,color:#fff
    style Evaluations fill:#7ed321,stroke:#333,color:#fff
    style Collections fill:#7ed321,stroke:#333,color:#fff
    style Providers fill:#7ed321,stroke:#333,color:#fff
    style StatusEvents fill:#7ed321,stroke:#333,color:#fff
    style TokenReview fill:#d5e8d4,stroke:#82b366
    style SAR fill:#d5e8d4,stroke:#82b366
    style Health fill:#e8e8e8,stroke:#333
    style Metrics fill:#e8e8e8,stroke:#333
    style Docs fill:#e8e8e8,stroke:#333
    style OpenAPI fill:#e8e8e8,stroke:#333
