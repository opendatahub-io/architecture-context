graph TD
    subgraph "Subjects"
        AuthUsers["Group: system:authenticated<br/>⚠ ALL authenticated cluster users"]
    end

    subgraph "RoleBinding"
        RB["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "Role (namespace-scoped)"
        Role["${PROJECT_NAME}-exec-role<br/>(Role, not ClusterRole)"]
    end

    subgraph "API Resources"
        PodsExec["Core API<br/>pods/exec"]
    end

    subgraph "Runtime Auth Requirements"
        K8sAuth["Kubernetes API Access<br/>kubeconfig / Bearer token<br/>cluster-admin or namespace-admin"]
        HFAuth["HuggingFace Access<br/>HF_TOKEN / LLMDBENCH_HF_TOKEN /<br/>HUGGING_FACE_HUB_TOKEN"]
        GCSAuth["GCS Access<br/>google-auth ADC"]
        AWSAuth["AWS S3 Access<br/>AWS IAM credentials"]
    end

    AuthUsers -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -->|"create"| PodsExec

    %% Notes on scope
    Note["⚠ Security Note:<br/>pods/exec to system:authenticated<br/>means any cluster user can exec<br/>into benchmark pods in namespace"]

    style AuthUsers fill:#f8cecc,stroke:#b85450
    style RB fill:#dae8fc,stroke:#6c8ebf
    style Role fill:#f5a623,stroke:#333
    style PodsExec fill:#7ed321,stroke:#333
    style K8sAuth fill:#e8e8e8,stroke:#333
    style HFAuth fill:#e8e8e8,stroke:#333
    style GCSAuth fill:#e8e8e8,stroke:#333
    style AWSAuth fill:#e8e8e8,stroke:#333
    style Note fill:#fff2cc,stroke:#d6b656
