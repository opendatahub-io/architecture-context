graph TD
    subgraph Note["PPE Authorization Model (No Kubernetes RBAC)"]
        direction TB
        NoteText["PPE is an embeddable library, not a Kubernetes workload.<br/>Authorization is enforced internally via policy decision points<br/>operating on verified identity attributes."]
    end

    subgraph IdentityResolution["Phase 1: Identity Resolution"]
        direction TB
        BearerToken["Bearer Token<br/>(from host request)"]
        APIKeyHeader["API Key<br/>(from host request)"]

        JWTVerify["JWT Plugin<br/>Signature verification<br/>RS256/ES256/EdDSA"]
        APIKeyVerify["API-Key Plugin<br/>SHA-256 digest match"]

        IdentityAttrs["Verified Identity Attributes<br/>subject, roles, permissions,<br/>claims, client_id"]
    end

    subgraph PolicyEval["Phase 2: Policy Decision"]
        direction TB

        subgraph APLRoutes["APL Route Table"]
            Route1["Route: tools/*<br/>Predicate: role == 'developer'"]
            Route2["Route: prompts/*<br/>Predicate: scope contains 'ai:read'"]
            Route3["Route: inference/*<br/>Predicate: client_id in allowlist"]
        end

        subgraph PDPEngines["PDP Engines (operator selects dialect)"]
            CedarEval["Cedar PDP<br/>cedar-policy 4<br/>Typed entities + actions"]
            CELEval["CEL PDP<br/>cel 0.14.5<br/>Expression evaluation"]
            OPAEval["OPA PDP<br/>regorus 0.12<br/>Rego policies"]
        end

        Decision["Decision<br/>Allow / Deny"]
    end

    subgraph Effects["Phase 3: Effects"]
        direction TB
        Delegate["Delegate<br/>Mint audience-scoped<br/>downstream credential<br/>(RFC 8693)"]
        Taint["Taint<br/>Apply session labels<br/>(persisted in Valkey)"]
        Redact["Redact<br/>Transform inputs/outputs<br/>(PII removal, field masking)"]
        Audit["Audit<br/>Emit structured event<br/>(decision + context)"]
    end

    %% Identity flow
    BearerToken -->|"verified by"| JWTVerify
    APIKeyHeader -->|"verified by"| APIKeyVerify
    JWTVerify -->|"extracts"| IdentityAttrs
    APIKeyVerify -->|"extracts"| IdentityAttrs

    %% Policy evaluation
    IdentityAttrs -->|"evaluated against"| APLRoutes
    Route1 -->|"dispatched to"| CedarEval
    Route2 -->|"dispatched to"| CELEval
    Route3 -->|"dispatched to"| OPAEval
    CedarEval --> Decision
    CELEval --> Decision
    OPAEval --> Decision

    %% Effects
    Decision -->|"if Allow"| Delegate
    Decision -->|"if Allow"| Taint
    Decision -->|"if Allow"| Redact
    Decision -->|"always"| Audit

    %% Styling
    style NoteText fill:#fff3cd,stroke:#856404,color:#856404
    style BearerToken fill:#d5e8d4,stroke:#82b366
    style APIKeyHeader fill:#d5e8d4,stroke:#82b366
    style JWTVerify fill:#e1d5e7,stroke:#9673a6
    style APIKeyVerify fill:#e1d5e7,stroke:#9673a6
    style IdentityAttrs fill:#dae8fc,stroke:#6c8ebf
    style Route1 fill:#fff2cc,stroke:#d6b656
    style Route2 fill:#fff2cc,stroke:#d6b656
    style Route3 fill:#fff2cc,stroke:#d6b656
    style CedarEval fill:#ffe6cc,stroke:#d79b00
    style CELEval fill:#ffe6cc,stroke:#d79b00
    style OPAEval fill:#ffe6cc,stroke:#d79b00
    style Decision fill:#f8cecc,stroke:#b85450
    style Delegate fill:#d5e8d4,stroke:#82b366
    style Taint fill:#d5e8d4,stroke:#82b366
    style Redact fill:#d5e8d4,stroke:#82b366
    style Audit fill:#d5e8d4,stroke:#82b366
