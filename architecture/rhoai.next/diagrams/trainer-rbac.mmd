graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kubeflow-trainer-controller-manager<br/>Namespace: opendatahub"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["kubeflow-trainer-controller-manager<br/>(ClusterRoleBinding)"]
    end

    subgraph ControllerRole["ClusterRole: kubeflow-trainer-controller-manager"]
        direction TB

        subgraph CoreAPI["API Group: core (\"\")"]
            ConfigSecrets["configmaps, secrets<br/><i>create, get, list, patch, update, watch</i>"]
            Events["events<br/><i>create, patch, update, watch</i>"]
            LimitRanges["limitranges<br/><i>get, list, watch</i>"]
            Pods["pods<br/><i>get, list</i> (RHAI)"]
        end

        subgraph AdmissionAPI["API Group: admissionregistration.k8s.io"]
            VWC["validatingwebhookconfigurations<br/><i>get, list, update, watch</i>"]
        end

        subgraph OpenShiftAPI["API Group: config.openshift.io"]
            APIServers["apiservers<br/><i>get</i>"]
        end

        subgraph CoordAPI["API Group: coordination.k8s.io"]
            Leases["leases<br/><i>create, get, list, update</i>"]
        end

        subgraph JobSetAPI["API Group: jobset.x-k8s.io"]
            JobSets["jobsets<br/><i>create, get, list, patch, update, watch</i>"]
        end

        subgraph NetworkAPI["API Group: networking.k8s.io"]
            NetPolicies["networkpolicies<br/><i>get, list, watch, create, update, patch</i> (RHAI)"]
        end

        subgraph NodeAPI["API Group: node.k8s.io"]
            RuntimeClasses["runtimeclasses<br/><i>get, list, watch</i>"]
        end

        subgraph SchedulingAPI["API Groups: scheduling.volcano.sh,<br/>scheduling.x-k8s.io"]
            PodGroups["podgroups<br/><i>create, get, list, patch, update, watch</i>"]
        end

        subgraph TrainerAPI["API Group: trainer.kubeflow.org"]
            TrainerResources["clustertrainingruntimes,<br/>trainingruntimes, trainjobs<br/><i>get, list, patch, update, watch</i>"]
            TrainerFinalizers["*/finalizers, trainjobs/status<br/><i>get, patch, update</i>"]
        end
    end

    subgraph UserRoles["User-Facing Aggregated ClusterRoles"]
        direction TB

        subgraph AdminRole["ClusterRole: training-admin"]
            AdminPerms["trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/><i>create, delete, get, list,<br/>patch, update, watch</i>"]
        end

        subgraph EditRole["ClusterRole: training-edit"]
            EditTrainJobs["trainjobs<br/><i>create, delete, get, list,<br/>patch, update, watch</i>"]
            EditRuntimes["trainingruntimes,<br/>clustertrainingruntimes<br/><i>get, list, watch</i>"]
        end

        subgraph ViewRole["ClusterRole: training-view"]
            ViewPerms["trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/><i>get, list, watch</i>"]
        end
    end

    %% Bindings
    SA -->|bound via| CRB
    CRB -->|grants| ControllerRole

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333

    style ConfigSecrets fill:#d5e8d4,stroke:#82b366
    style Events fill:#d5e8d4,stroke:#82b366
    style LimitRanges fill:#d5e8d4,stroke:#82b366
    style Pods fill:#d5e8d4,stroke:#82b366
    style VWC fill:#d5e8d4,stroke:#82b366
    style APIServers fill:#d5e8d4,stroke:#82b366
    style Leases fill:#d5e8d4,stroke:#82b366
    style JobSets fill:#d5e8d4,stroke:#82b366
    style NetPolicies fill:#d5e8d4,stroke:#82b366
    style RuntimeClasses fill:#d5e8d4,stroke:#82b366
    style PodGroups fill:#d5e8d4,stroke:#82b366
    style TrainerResources fill:#d5e8d4,stroke:#82b366
    style TrainerFinalizers fill:#d5e8d4,stroke:#82b366

    style AdminPerms fill:#fff2cc,stroke:#d6b656
    style EditTrainJobs fill:#fff2cc,stroke:#d6b656
    style EditRuntimes fill:#fff2cc,stroke:#d6b656
    style ViewPerms fill:#fff2cc,stroke:#d6b656
