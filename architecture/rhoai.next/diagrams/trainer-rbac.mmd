graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kubeflow-trainer-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["kubeflow-trainer-controller-manager<br/>(cluster-scoped)"]
    end

    subgraph ControllerRole["ClusterRole: kubeflow-trainer-controller-manager"]
        direction TB

        subgraph TrainerAPIs["trainer.kubeflow.org"]
            TrainJobs["trainjobs<br/>get, list, watch, update, patch"]
            TrainJobStatus["trainjobs/status<br/>get, update, patch"]
            TrainJobFinalizers["trainjobs/finalizers<br/>get, update, patch"]
            TrainingRuntimes["trainingruntimes<br/>get, list, watch, update, patch"]
            RuntimeFinalizers["*runtimes/finalizers<br/>get, update, patch"]
            ClusterRuntimes["clustertrainingruntimes<br/>get, list, watch, update, patch"]
        end

        subgraph JobSetAPIs["jobset.x-k8s.io"]
            JobSets["jobsets<br/>create, get, list, watch, update, patch"]
        end

        subgraph SchedulingAPIs["scheduling.volcano.sh / scheduling.x-k8s.io"]
            PodGroups["podgroups<br/>create, get, list, watch, update, patch"]
        end

        subgraph CoreAPIs["Core API ('')"]
            ConfigMaps["configmaps<br/>create, get, list, watch, update, patch"]
            Secrets["secrets<br/>create, get, list, watch, update, patch"]
            Events["events<br/>create, watch, update, patch"]
            LimitRanges["limitranges<br/>get, list, watch"]
            Pods["pods (RHOAI only)<br/>get, list"]
        end

        subgraph NetworkAPIs["networking.k8s.io (RHOAI only)"]
            NetPolicies["networkpolicies<br/>get, list, watch, create, update, patch"]
        end

        subgraph AdminAPIs["admissionregistration.k8s.io"]
            WebhookConfigs["validatingwebhookconfigurations<br/>get, list, update, watch"]
        end

        subgraph OpenShiftAPIs["config.openshift.io"]
            APIServers["apiservers<br/>get"]
        end

        subgraph NodeAPIs["node.k8s.io"]
            RuntimeClasses["runtimeclasses<br/>get, list, watch"]
        end

        subgraph CoordAPIs["coordination.k8s.io"]
            Leases["leases<br/>create, get, list, update"]
        end
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles"]
        Admin["training-admin<br/>Full CRUD on all trainer resources"]
        Edit["training-edit<br/>CRUD trainjobs, read runtimes"]
        View["training-view<br/>Read-only all trainer resources"]
    end

    SA -->|bound via| CRB
    CRB -->|grants| ControllerRole

    %% Aggregated role targets
    Admin -->|"create, delete, get, list,<br/>patch, update, watch"| TrainJobs
    Admin -->|"create, delete, get, list,<br/>patch, update, watch"| TrainingRuntimes
    Admin -->|"create, delete, get, list,<br/>patch, update, watch"| ClusterRuntimes
    Edit -->|"create, delete, get, list,<br/>patch, update, watch"| TrainJobs
    Edit -->|"get, list, watch"| TrainingRuntimes
    View -->|"get, list, watch"| TrainJobs

    %% Styles
    style SA fill:#4a90e2,color:#fff
    style CRB fill:#6cb4ee,color:#fff
    style TrainJobs fill:#7ed321
    style TrainJobStatus fill:#7ed321
    style TrainJobFinalizers fill:#7ed321
    style TrainingRuntimes fill:#7ed321
    style RuntimeFinalizers fill:#7ed321
    style ClusterRuntimes fill:#7ed321
    style JobSets fill:#f5a623
    style PodGroups fill:#f5a623
    style ConfigMaps fill:#ddd
    style Secrets fill:#ddd
    style Events fill:#ddd
    style LimitRanges fill:#ddd
    style Pods fill:#e88b3a
    style NetPolicies fill:#e88b3a
    style WebhookConfigs fill:#ddd
    style APIServers fill:#6c8ebf,color:#fff
    style RuntimeClasses fill:#ddd
    style Leases fill:#ddd
    style Admin fill:#d5e8d4,stroke:#82b366
    style Edit fill:#d5e8d4,stroke:#82b366
    style View fill:#d5e8d4,stroke:#82b366
