graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["kubeflow-trainer-controller-manager<br/>(opendatahub)"]
        SA_Prometheus["prometheus-k8s<br/>(openshift-monitoring)"]
        SA_Users["system:authenticated<br/>(all authenticated users)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Controller["kubeflow-trainer-controller-manager"]
        CRB_TLS["trainer-tls-profile"]
        CRB_Metrics["trainer-metrics-reader"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Public["kubeflow-trainer-public<br/>(opendatahub namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Controller["kubeflow-trainer-controller-manager"]
        CR_TLS["trainer-tls-profile"]
        CR_MetricsReader["trainer-metrics-reader"]
        CR_View["training-view<br/>(aggregated)"]
        CR_Edit["training-edit<br/>(aggregated)"]
        CR_Admin["training-admin<br/>(aggregated)"]
    end

    subgraph Roles["Roles"]
        R_Public["kubeflow-trainer-public"]
    end

    subgraph ControllerResources["Controller Resources"]
        Res_TrainerCRDs["trainer.kubeflow.org/*<br/>TrainJob, TrainingRuntime,<br/>ClusterTrainingRuntime,<br/>OptimizationJob"]
        Res_JobSet["jobset.x-k8s.io<br/>JobSets"]
        Res_PodGroups["scheduling.volcano.sh +<br/>scheduling.x-k8s.io<br/>PodGroups"]
        Res_Core["core: configmaps, secrets,<br/>services, events, pods"]
        Res_Apps["apps: deployments"]
        Res_Auth["authentication + authorization<br/>tokenreviews, subjectaccessreviews"]
        Res_Webhooks["admissionregistration.k8s.io<br/>webhook configurations"]
        Res_Network["networking.k8s.io<br/>networkpolicies"]
    end

    subgraph TLSResources["TLS Resources"]
        Res_APIServers["config.openshift.io<br/>apiservers"]
    end

    subgraph MetricsResources["Metrics Resources"]
        Res_Metrics["/metrics<br/>(non-resource URL)"]
    end

    subgraph UserResources["User-Facing Resources"]
        Res_UserTrainer["trainer.kubeflow.org<br/>TrainJob, TrainingRuntime,<br/>ClusterTrainingRuntime"]
    end

    subgraph PublicResources["Public Resources"]
        Res_ConfigMap["configmaps<br/>(opendatahub namespace)"]
    end

    %% Controller SA bindings
    SA_Controller -->|bound via| CRB_Controller
    CRB_Controller -->|grants| CR_Controller
    CR_Controller -->|"full CRUD"| Res_TrainerCRDs
    CR_Controller -->|"full CRUD"| Res_JobSet
    CR_Controller -->|"full CRUD"| Res_PodGroups
    CR_Controller -->|"create,get,list,patch,update,watch"| Res_Core
    CR_Controller -->|"full CRUD"| Res_Apps
    CR_Controller -->|"create"| Res_Auth
    CR_Controller -->|"get,list,update,watch"| Res_Webhooks
    CR_Controller -->|"full CRUD"| Res_Network

    SA_Controller -->|bound via| CRB_TLS
    CRB_TLS -->|grants| CR_TLS
    CR_TLS -->|"get,list,watch"| Res_APIServers

    %% Prometheus SA bindings
    SA_Prometheus -->|bound via| CRB_Metrics
    CRB_Metrics -->|grants| CR_MetricsReader
    CR_MetricsReader -->|"get"| Res_Metrics

    %% User-facing roles
    CR_View -->|"get,list,watch"| Res_UserTrainer
    CR_Edit -->|"CRUD TrainJob; read runtimes"| Res_UserTrainer
    CR_Admin -->|"full CRUD"| Res_UserTrainer

    %% Public role
    SA_Users -->|bound via| RB_Public
    RB_Public -->|grants| R_Public
    R_Public -->|"get,list,watch"| Res_ConfigMap

    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Prometheus fill:#9673a6,stroke:#333,color:#fff
    style SA_Users fill:#82b366,stroke:#333
    style CR_Controller fill:#f5a623,stroke:#333
    style CR_TLS fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style CR_View fill:#82b366,stroke:#333
    style CR_Edit fill:#82b366,stroke:#333
    style CR_Admin fill:#82b366,stroke:#333
    style Res_TrainerCRDs fill:#d5e8d4,stroke:#333
    style Res_JobSet fill:#d5e8d4,stroke:#333
    style Res_PodGroups fill:#d5e8d4,stroke:#333
