graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["odh-observability<br/>controller-manager"]
        SA_ClusterProxy["data-science-prometheus<br/>-cluster-proxy"]
        SA_NSProxy["data-science-prometheus<br/>-namespace-proxy"]
        SA_Korrel8r["korrel8r"]
        SA_Collector["data-science-collector<br/>-collector"]
        SA_TA["data-science-collector<br/>-targetallocator"]
        SA_Alertmanager["data-science-monitoringstack<br/>-alertmanager"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Op["operator-clusterrolebinding"]
        CRB_CPAuth["cluster-proxy<br/>auth-delegator"]
        CRB_NSAuth["namespace-proxy<br/>auth-delegator"]
        CRB_KAuth["korrel8r<br/>auth-delegator"]
        CRB_CPView["cluster-proxy<br/>monitoring-view"]
        CRB_NSView["namespace-proxy<br/>monitoring-view"]
        CRB_KQuery["korrel8r-query"]
        CRB_GenProc["generate-processors<br/>collector-rolebinding"]
        CRB_MLFlow["collector-mlflow<br/>trace-export"]
        CRB_Tempo["collector-tempo<br/>trace-export"]
        CRB_AM["alertmanager<br/>metrics-reader"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Op["operator ClusterRole"]
        CR_AuthDel["system:auth-delegator"]
        CR_MonView["cluster-monitoring-view"]
        CR_KQuery["korrel8r-query"]
        CR_GenProc["generate-processors-role"]
        CR_MLFlow["data-science-collector<br/>-mlflow-trace-export"]
        CR_Tempo["data-science-collector<br/>-tempo-trace-export"]
        CR_Metrics["data-science-metrics-view"]
    end

    subgraph Resources["API Resources"]
        R_Monitoring["services.platform.opendatahub.io<br/>monitorings, status, finalizers"]
        R_MonRhobs["monitoring.rhobs<br/>monitoringstacks, thanosqueriers<br/>servicemonitors, prometheusrules"]
        R_Tempo["tempo.grafana.com<br/>tempomonolithics, tempostacks"]
        R_OTel["opentelemetry.io<br/>opentelemetrycollectors<br/>instrumentations"]
        R_Perses["perses.dev<br/>perses, persesdatasources<br/>persesdashboards"]
        R_Loki["loki.grafana.com<br/>lokistacks"]
        R_Config["config.openshift.io<br/>apiservers"]
        R_Core["core<br/>pods, namespaces, services<br/>endpoints, configmaps, events"]
        R_Apps["apps<br/>deployments, replicasets<br/>statefulsets, daemonsets"]
    end

    %% Operator bindings
    SA_Controller -->|bound via| CRB_Op
    CRB_Op -->|grants| CR_Op
    CR_Op -->|"full CRUD"| R_Monitoring
    CR_Op -->|"full CRUD"| R_MonRhobs
    CR_Op -->|"full CRUD"| R_Tempo
    CR_Op -->|"full CRUD"| R_OTel
    CR_Op -->|"full CRUD"| R_Perses
    CR_Op -->|"full CRUD"| R_Loki
    CR_Op -->|"get, list, watch"| R_Config

    %% Cluster Proxy bindings
    SA_ClusterProxy -->|bound via| CRB_CPAuth
    SA_ClusterProxy -->|bound via| CRB_CPView
    CRB_CPAuth -->|grants| CR_AuthDel
    CRB_CPView -->|grants| CR_MonView

    %% Namespace Proxy bindings
    SA_NSProxy -->|bound via| CRB_NSAuth
    SA_NSProxy -->|bound via| CRB_NSView
    CRB_NSAuth -->|grants| CR_AuthDel
    CRB_NSView -->|grants| CR_MonView

    %% Korrel8r bindings
    SA_Korrel8r -->|bound via| CRB_KAuth
    SA_Korrel8r -->|bound via| CRB_KQuery
    CRB_KAuth -->|grants| CR_AuthDel
    CRB_KQuery -->|grants| CR_KQuery
    CR_KQuery -->|"get, list, watch"| R_Core
    CR_KQuery -->|"get, list, watch"| R_Apps

    %% Collector bindings
    SA_Collector -->|bound via| CRB_GenProc
    SA_Collector -->|bound via| CRB_MLFlow
    SA_Collector -->|bound via| CRB_Tempo
    CRB_GenProc -->|grants| CR_GenProc
    CRB_MLFlow -->|grants| CR_MLFlow
    CRB_Tempo -->|grants| CR_Tempo
    CR_GenProc -->|"get, list, watch"| R_Core

    %% Alertmanager binding
    SA_Alertmanager -->|bound via| CRB_AM
    CRB_AM -->|grants| CR_MonView

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_ClusterProxy fill:#4a90e2,color:#fff
    style SA_NSProxy fill:#4a90e2,color:#fff
    style SA_Korrel8r fill:#4a90e2,color:#fff
    style SA_Collector fill:#4a90e2,color:#fff
    style SA_TA fill:#4a90e2,color:#fff
    style SA_Alertmanager fill:#4a90e2,color:#fff
    style CR_Op fill:#f5a623,color:#fff
    style CR_AuthDel fill:#f5a623,color:#fff
    style CR_MonView fill:#f5a623,color:#fff
    style CR_KQuery fill:#f5a623,color:#fff
    style CR_GenProc fill:#f5a623,color:#fff
    style CR_MLFlow fill:#f5a623,color:#fff
    style CR_Tempo fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style R_Monitoring fill:#7ed321,color:#fff
    style R_MonRhobs fill:#7ed321,color:#fff
    style R_Tempo fill:#7ed321,color:#fff
    style R_OTel fill:#7ed321,color:#fff
    style R_Perses fill:#7ed321,color:#fff
    style R_Loki fill:#7ed321,color:#fff
    style R_Config fill:#7ed321,color:#fff
    style R_Core fill:#7ed321,color:#fff
    style R_Apps fill:#7ed321,color:#fff
