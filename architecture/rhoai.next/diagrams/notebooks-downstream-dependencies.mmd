graph LR
    Notebooks["Notebooks<br/>(Workbench & Runtime Images)<br/>~32 image variants"]

    %% Internal RHOAI Dependencies
    subgraph InternalRHOAI["Internal RHOAI Platform"]
        NotebookController["ODH Notebook Controller<br/>(image consumer)"]
        Dashboard["odh-dashboard<br/>(metadata consumer)"]
        KubeRBAC["kube-rbac-proxy<br/>(auth sidecar)"]
        Elyra["Elyra<br/>(pipeline editor)"]
        ImageStream["OpenShift ImageStream<br/>(version tracking)"]
        KubeflowCRD["Kubeflow Notebook CRD<br/>(CR consumer)"]
        PodCulling["Pod Culling System<br/>(idle detection)"]
    end

    %% Build Infrastructure
    subgraph BuildInfra["Build Infrastructure"]
        GitHubActions["GitHub Actions<br/>(CI/CD)"]
        Konflux["Konflux / AppStudio<br/>(multi-arch builds)"]
    end

    %% Base Images
    subgraph BaseImages["Base Images"]
        UBI9Py312["UBI9 Python 3.12<br/>registry.access.redhat.com"]
        UBI9Py311["UBI9 Python 3.11<br/>registry.access.redhat.com"]
        C9SPy311["CentOS Stream 9 Python 3.11<br/>quay.io/sclorg"]
        RHEL9Py311["RHEL9 Python 3.11<br/>registry.redhat.io"]
    end

    %% GPU Acceleration
    subgraph GPUAcceleration["GPU Acceleration"]
        CUDA["NVIDIA CUDA 12.6.3<br/>+ cuDNN 9.5.1.17<br/>+ NCCL 2.23.4"]
        ROCm["AMD ROCm 6.2.4"]
    end

    %% External Tools
    subgraph ExternalTools["External Tools (bundled)"]
        CodeServerPkg["code-server v4.98.0"]
        RStudioPkg["RStudio Server 2024.12.1-563"]
        RPkg["R 4.4.3"]
        NGINXPkg["NGINX 1.24"]
        MongoCLI["MongoDB CLI 2.0.3<br/>(FIPS-compiled)"]
        MSSQLTools["MSSQL Tools 18"]
        JavaJDK["Java JDK 17"]
        Micropipenv["micropipenv"]
        OC["OpenShift CLI (oc)"]
        Skopeo["skopeo"]
    end

    %% External Services
    subgraph ExternalServices["External Services"]
        QuayIO["quay.io/modh/*<br/>(image registry)"]
        PyPI["pypi.org<br/>(Python packages)"]
        K8sAPI["Kubernetes API"]
    end

    %% Internal platform uses these images
    NotebookController -->|"launches pods<br/>from ImageStreams"| Notebooks
    Dashboard -->|"reads annotations<br/>for workbench UI"| Notebooks
    KubeRBAC -->|"injected as<br/>auth sidecar"| Notebooks
    PodCulling -->|"polls /api/kernels/<br/>HTTP"| Notebooks

    %% Notebooks depend on
    Notebooks -->|"bundled in<br/>DS/ML images"| Elyra
    Notebooks -->|"referenced by"| ImageStream
    Notebooks -->|"spec.containers"| KubeflowCRD

    %% Base image dependencies
    Notebooks -->|"FROM"| UBI9Py312
    Notebooks -->|"FROM"| UBI9Py311
    Notebooks -->|"FROM (RStudio C9S)"| C9SPy311
    Notebooks -->|"FROM (RStudio RHEL9)"| RHEL9Py311

    %% GPU dependencies
    Notebooks -.->|"CUDA variants"| CUDA
    Notebooks -.->|"ROCm variants"| ROCm

    %% Bundled tools
    Notebooks -->|"all images"| Micropipenv
    Notebooks -->|"all images"| OC
    Notebooks -->|"all images"| Skopeo
    Notebooks -.->|"CodeServer only"| CodeServerPkg
    Notebooks -.->|"CodeServer/RStudio"| NGINXPkg
    Notebooks -.->|"RStudio only"| RStudioPkg
    Notebooks -.->|"RStudio only"| RPkg
    Notebooks -.->|"Data Science only"| MongoCLI
    Notebooks -.->|"Data Science only"| MSSQLTools
    Notebooks -.->|"TrustyAI only"| JavaJDK

    %% Build infra
    GitHubActions -->|"builds images"| Notebooks
    Konflux -->|"multi-arch builds"| Notebooks

    %% External services
    Notebooks -->|"publishes to<br/>HTTPS/443"| QuayIO
    Notebooks -->|"installs from<br/>HTTPS/443"| PyPI
    Notebooks -->|"cluster access<br/>HTTPS/443"| K8sAPI

