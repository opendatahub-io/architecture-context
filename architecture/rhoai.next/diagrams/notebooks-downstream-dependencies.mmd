graph LR
    Notebooks["Notebooks Downstream<br/>(Container Image Factory)"]

    %% External Dependencies - Accelerators
    Notebooks -->|"GPU compute"| CUDA["NVIDIA CUDA 12.6.3"]
    Notebooks -->|"GPU compute"| cuDNN["NVIDIA cuDNN 9.5.1.17"]
    Notebooks -->|"GPU compute"| ROCm["AMD ROCm 6.2.4"]

    %% External Dependencies - IDE/Runtime
    Notebooks -->|"VS Code IDE"| CodeServerBin["code-server 4.98.0"]
    Notebooks -->|"R IDE"| RStudioBin["RStudio Server 2024.12.1"]
    Notebooks -->|"reverse proxy"| NGINX["NGINX 1.24"]
    Notebooks -->|"process mgmt"| Supervisord["supervisord"]
    Notebooks -->|"R runtime"| RLang["R 4.4.3"]
    Notebooks -->|"Java runtime"| Java17["Java 17 OpenJDK"]
    Notebooks -->|"pip install"| Micropipenv["micropipenv"]
    Notebooks -->|"MongoDB admin"| MongoCLI["MongoDB CLI 2.0.3"]
    Notebooks -->|"cluster CLI"| OC["OpenShift CLI"]
    Notebooks -->|"image inspect"| Skopeo["skopeo"]

    %% Internal Platform Dependencies
    NotebookController["odh-notebook-controller"] -->|"creates Pods"| Notebooks
    RhodsOperator["rhods-operator"] -->|"deploys ImageStreams"| Notebooks
    KubeRBACProxy["kube-rbac-proxy"] -.->|"auth sidecar"| Notebooks
    KFP["Kubeflow Pipelines"] -->|"runtime execution"| Notebooks
    Elyra["Elyra"] -->|"runtime execution"| Notebooks
    OIDC["OpenShift OAuth / OIDC"] -.->|"authentication"| Notebooks

    %% Integration Points (downstream consumers)
    ODHDashboard["ODH Dashboard"] -->|"reads ImageStream annotations"| Notebooks
    Konflux["Konflux (Tekton)"] -->|"builds images"| Notebooks

    %% External Services
    Notebooks -->|"Python packages"| PyPI["PyPI"]
    Notebooks -->|"PyTorch wheels"| PTOrg["download.pytorch.org"]
    Notebooks -->|"image publish"| QuayIO["quay.io/opendatahub"]

