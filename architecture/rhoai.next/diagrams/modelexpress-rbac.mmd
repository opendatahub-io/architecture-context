graph TD
    subgraph ServiceAccounts["Service Accounts"]
        OpSA["modelexpress-operator<br/>(NS: modelexpress-operator-system)"]
        ServerSA["Per-CR Server SA<br/>(NS: {cr-namespace})"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        OpCRB["modelexpress-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Per-CR Role Bindings"]
        ServerRB["Per-CR RoleBinding<br/>(NS: {cr-namespace})"]
    end

    subgraph CR_Main["ClusterRole: modelexpress-operator"]
        direction TB
        MXServerRes["modelexpress.opendatahub.io<br/>modelexpressservers<br/>get, list, watch, patch"]
        MXServerStatus["modelexpress.opendatahub.io<br/>modelexpressservers/status, /finalizers<br/>update, patch"]
        DeployRes["apps<br/>deployments<br/>get, list, watch, create,<br/>update, patch, delete"]
        CoreRes["core<br/>services, pvcs, serviceaccounts,<br/>configmaps<br/>get, list, watch, create,<br/>update, patch, delete"]
        NetPolRes["networking.k8s.io<br/>networkpolicies<br/>get, list, watch, create,<br/>update, patch, delete"]
        RBACRes["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterrolebindings<br/>get, list, watch, create,<br/>update, patch, delete"]
        AuthnRes["authentication.k8s.io<br/>tokenreviews<br/>create"]
        AuthzRes["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        NvidiaRes["modelexpress.nvidia.com<br/>modelmetadatas, modelcacheentries<br/>get, list, watch, create,<br/>update, patch, delete"]
        NvidiaStatus["modelexpress.nvidia.com<br/>modelmetadatas/status,<br/>modelcacheentries/status,<br/>modelmetadatas/finalizers,<br/>modelcacheentries/finalizers<br/>get, update, patch"]
    end

    subgraph CR_OCP["ClusterRole: modelexpress-operator-openshift"]
        OCPApiRes["config.openshift.io<br/>apiservers<br/>get, list, watch"]
        MonitorRes["monitoring.coreos.com<br/>servicemonitors<br/>get, create, patch, update"]
    end

    subgraph PerCRRole["Per-CR Role (operator-created)"]
        ServerPerms["Namespace-scoped least-privilege<br/>for server pod operations"]
    end

    %% Bindings
    OpSA -->|bound via| OpCRB
    OpCRB -->|grants| CR_Main
    OpCRB -->|grants| CR_OCP

    ServerSA -->|bound via| ServerRB
    ServerRB -->|grants| PerCRRole

