    style User fill:#4a90e2,color:#fff
    style Info fill:#fffde7,stroke:#f9a825,stroke-width:2px

    style TrainJobRes fill:#c8e6c9,stroke:#2e7d32
    style RuntimeRes fill:#c8e6c9,stroke:#2e7d32
    style ClusterRuntimeRes fill:#c8e6c9,stroke:#2e7d32
    style ExperimentRes fill:#bbdefb,stroke:#1565c0
    style TrialRes fill:#bbdefb,stroke:#1565c0
    style SparkConnectRes fill:#ffe0b2,stroke:#e65100
    style PodRes fill:#f5f5f5,stroke:#616161
    style PodLogRes fill:#f5f5f5,stroke:#616161
    style EventRes fill:#f5f5f5,stroke:#616161
    style ConfigMapRes fill:#f5f5f5,stroke:#616161
    style SecretRes fill:#ffcdd2,stroke:#c62828

    style TrainMethod fill:#e8f5e9,stroke:#2e7d32
    style RuntimeMethod fill:#e8f5e9,stroke:#2e7d32
    style OptimizeMethod fill:#e3f2fd,stroke:#1565c0
    style TrialMethod fill:#e3f2fd,stroke:#1565c0
