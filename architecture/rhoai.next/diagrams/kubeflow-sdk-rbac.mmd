graph TD
    subgraph Identity["User Identity"]
        User["User kubeconfig<br/>or ServiceAccount"]
    end

    subgraph Note["Note: SDK is a Client Library"]
        Info["The Kubeflow SDK does not define<br/>its own ClusterRoles or RoleBindings.<br/>It inherits RBAC from the user's identity.<br/>Below are the REQUIRED permissions."]
    end

    subgraph TrainerPerms["Trainer Permissions"]
        direction TB
        TrainJobRes["trainer.kubeflow.org<br/>trainjobs"]
        RuntimeRes["trainer.kubeflow.org<br/>trainingruntimes"]
        ClusterRuntimeRes["trainer.kubeflow.org<br/>clustertrainingruntimes"]
    end

    subgraph OptimizerPerms["Optimizer Permissions"]
        direction TB
        ExperimentRes["kubeflow.org<br/>experiments"]
        TrialRes["kubeflow.org<br/>trials"]
    end

    subgraph SparkPerms["Spark Permissions"]
        SparkConnectRes["sparkoperator.k8s.io<br/>sparkconnects"]
    end

    subgraph CorePerms["Core API Permissions"]
        direction TB
        PodRes["core<br/>pods"]
        PodLogRes["core<br/>pods/log"]
        EventRes["core<br/>events"]
        ConfigMapRes["core<br/>configmaps"]
        SecretRes["core<br/>secrets"]
    end

    subgraph SDKMethods["SDK Methods"]
        direction TB
        TrainMethod["TrainerClient.train()<br/>get_job() / list_jobs()<br/>delete_job()"]
        RuntimeMethod["TrainerClient.list_runtimes()<br/>get_runtime()"]
        OptimizeMethod["OptimizerClient.optimize()<br/>get_job() / list_jobs()<br/>delete_job()"]
        TrialMethod["OptimizerClient<br/>(internal trial listing)"]
        SparkMethod["SparkClient.connect()<br/>get_session() / list_sessions()<br/>delete_session()"]
        LogMethod["get_job_logs()<br/>get_session_logs()"]
        EventMethod["get_job_events()"]
        ConfigMethod["Backend version check"]
        SecretMethod["RHAI storage credential<br/>injection"]
    end

    %% Identity to Resources
    User -->|"create, get, list, delete"| TrainJobRes
    User -->|"get, list"| RuntimeRes
    User -->|"get, list"| ClusterRuntimeRes
    User -->|"create, get, list, delete"| ExperimentRes
    User -->|"get, list"| TrialRes
    User -->|"create, get, list, delete"| SparkConnectRes
    User -->|"get, list"| PodRes
    User -->|"get"| PodLogRes
    User -->|"list"| EventRes
    User -->|"get"| ConfigMapRes
    User -->|"get"| SecretRes

    %% Resources to SDK Methods
    TrainJobRes --- TrainMethod
    RuntimeRes --- RuntimeMethod
    ClusterRuntimeRes --- RuntimeMethod
    ExperimentRes --- OptimizeMethod
    TrialRes --- TrialMethod
    SparkConnectRes --- SparkMethod
    PodRes --- LogMethod
    PodLogRes --- LogMethod
    EventRes --- EventMethod
    ConfigMapRes --- ConfigMethod
    SecretRes --- SecretMethod

