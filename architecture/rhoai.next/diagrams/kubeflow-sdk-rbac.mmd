graph TD
    subgraph "Authentication Methods"
        Kubeconfig["kubeconfig<br/>(external client)"]
        SAToken["In-cluster SA Token<br/>(notebook / pod)"]
    end

    subgraph "Kubernetes RBAC (SDK does not define — expects these permissions)"
        direction TB

        subgraph "Expected ClusterRole Permissions"
            CR_Trainer["TrainJob Permissions"]
            CR_Katib["OptimizationJob Permissions"]
            CR_Spark["SparkConnect Permissions"]
            CR_Core["Core Resource Permissions"]
        end
    end

    subgraph "trainer.kubeflow.org API Group"
        TrainJob["TrainJob<br/>(Namespaced)"]
        TrainingRuntime["TrainingRuntime<br/>(Namespaced)"]
        ClusterTrainingRuntime["ClusterTrainingRuntime<br/>(Cluster)"]
    end

    subgraph "sparkoperator.k8s.io API Group"
        SparkConnect["SparkConnect<br/>(Namespaced)"]
    end

    subgraph "Core API Group"
        Pods["Pods"]
        PodLogs["Pods/log"]
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
    end

    subgraph "Additional Auth Contexts (non-RBAC)"
        HFToken["HF_TOKEN<br/>(env var)<br/>HuggingFace gated models"]
        AWSCreds["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>(env vars)<br/>S3 checkpoint storage"]
        UserToken["user_token<br/>(constructor param)<br/>Model Registry auth"]
        CustomCA["custom_ca<br/>(constructor param)<br/>Model Registry TLS CA"]
    end

    %% Auth flows
    Kubeconfig -->|authenticates| CR_Trainer
    Kubeconfig -->|authenticates| CR_Katib
    Kubeconfig -->|authenticates| CR_Spark
    Kubeconfig -->|authenticates| CR_Core
    SAToken -->|authenticates| CR_Trainer
    SAToken -->|authenticates| CR_Katib
    SAToken -->|authenticates| CR_Spark
    SAToken -->|authenticates| CR_Core

    %% Permission mappings
    CR_Trainer -->|"get, list, watch,<br/>create, update, patch, delete"| TrainJob
    CR_Trainer -->|"get, list, watch"| TrainingRuntime
    CR_Trainer -->|"get, list, watch"| ClusterTrainingRuntime

    CR_Spark -->|"get, list, watch,<br/>create, update, patch, delete"| SparkConnect

    CR_Core -->|"get, list, watch"| Pods
    CR_Core -->|"get"| PodLogs
    CR_Core -->|"get, list"| ConfigMaps
    CR_Core -->|"get, list"| Secrets

    style Kubeconfig fill:#4a90e2,color:#fff
    style SAToken fill:#4a90e2,color:#fff

    style CR_Trainer fill:#f5a623,color:#fff
    style CR_Katib fill:#f5a623,color:#fff
    style CR_Spark fill:#f5a623,color:#fff
    style CR_Core fill:#f5a623,color:#fff

    style TrainJob fill:#7ed321,color:#fff
    style TrainingRuntime fill:#7ed321,color:#fff
    style ClusterTrainingRuntime fill:#7ed321,color:#fff
    style SparkConnect fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
