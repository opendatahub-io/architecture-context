graph TD
    subgraph UserIdentity["User Identity (SDK Consumer)"]
        User["User / ServiceAccount<br/>(must be configured by platform admin)"]
    end

    subgraph RoleBindings["Role Bindings (User-Provided)"]
        RB["RoleBinding / ClusterRoleBinding<br/>(user-provided, not defined by SDK)"]
    end

    subgraph RequiredPermissions["Required Kubernetes Permissions"]
        direction TB

        subgraph TrainerPerms["trainer.kubeflow.org API Group"]
            TrainJobs["trainjobs<br/>get, list, create, delete, watch"]
            ClusterRuntimes["clustertrainingruntimes<br/>get, list"]
            Runtimes["trainingruntimes<br/>get, list"]
        end

        subgraph CorePerms["Core API Group ('')"]
            Pods["pods<br/>get, list"]
            PodLogs["pods/log<br/>get"]
            Events["events<br/>get, list"]
            ConfigMaps["configmaps<br/>get"]
        end
    end

    subgraph ConsumedSecrets["Consumed Secrets (Not Provisioned by SDK)"]
        Kubeconfig["kubeconfig<br/>Type: kubeconfig<br/>Purpose: K8s API auth<br/>Provisioned: User/Platform"]
        HFToken["HuggingFace Token<br/>Type: Opaque<br/>Purpose: Private model downloads<br/>Provisioned: User"]
        S3Creds["S3 Credentials<br/>Type: Opaque<br/>Purpose: Checkpoint upload<br/>Provisioned: User/IAM"]
    end

    subgraph CRDsConsumed["CRDs Consumed (Not Owned)"]
        TrainJob["TrainJob<br/>trainer.kubeflow.org/v1alpha1<br/>Namespaced"]
        ClusterTrainingRuntime["ClusterTrainingRuntime<br/>trainer.kubeflow.org/v1alpha1<br/>Cluster"]
        TrainingRuntime["TrainingRuntime<br/>trainer.kubeflow.org/v1alpha1<br/>Namespaced"]
    end

    %% Relationships
    User -->|"bound via"| RB
    RB -->|"grants"| TrainJobs
    RB -->|"grants"| ClusterRuntimes
    RB -->|"grants"| Runtimes
    RB -->|"grants"| Pods
    RB -->|"grants"| PodLogs
    RB -->|"grants"| Events
    RB -->|"grants"| ConfigMaps

    User -->|"uses"| Kubeconfig
    User -->|"uses"| HFToken
    User -->|"uses"| S3Creds

    TrainJobs -->|"operates on"| TrainJob
    ClusterRuntimes -->|"reads"| ClusterTrainingRuntime
    Runtimes -->|"reads"| TrainingRuntime

    %% Styling
    style User fill:#4a90e2,color:#fff
    style RB fill:#f5a623,color:#fff

    style TrainJobs fill:#d5e8d4,stroke:#82b366
    style ClusterRuntimes fill:#d5e8d4,stroke:#82b366
    style Runtimes fill:#d5e8d4,stroke:#82b366
    style Pods fill:#d5e8d4,stroke:#82b366
    style PodLogs fill:#d5e8d4,stroke:#82b366
    style Events fill:#d5e8d4,stroke:#82b366
    style ConfigMaps fill:#d5e8d4,stroke:#82b366

    style Kubeconfig fill:#f8cecc,stroke:#b85450
    style HFToken fill:#f8cecc,stroke:#b85450
    style S3Creds fill:#f8cecc,stroke:#b85450

    style TrainJob fill:#fff2cc,stroke:#d6b656
    style ClusterTrainingRuntime fill:#fff2cc,stroke:#d6b656
    style TrainingRuntime fill:#fff2cc,stroke:#d6b656
