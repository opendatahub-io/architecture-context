graph TD
    subgraph ServiceAccounts["Service Account"]
        SA["controller-manager<br/>(workbenches-operator-system)"]
    end

    subgraph Bindings["Role Bindings"]
        CRB1["manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB2["manager-rbac-escalate-rolebinding<br/>(ClusterRoleBinding)"]
        RB1["leader-election-rolebinding<br/>(RoleBinding - workbenches-operator-system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR1["manager-role<br/>(ClusterRole)"]
        CR2["manager-rbac-escalate-role<br/>(ClusterRole)"]
        R1["leader-election-role<br/>(Role)"]
    end

    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| RB1
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2
    RB1 -->|grants| R1

    subgraph Resources_Platform["Platform Resources"]
        Workbenches["components.platform.opendatahub.io<br/>Workbenches<br/>[get,list,watch,create,<br/>update,patch,delete]"]
        WorkbenchesStatus["components.platform.opendatahub.io<br/>Workbenches/status<br/>[get,update,patch]"]
        WorkbenchesFinalizers["components.platform.opendatahub.io<br/>Workbenches/finalizers<br/>[update]"]
    end

    subgraph Resources_Core["Core Resources"]
        Namespaces["core<br/>Namespaces<br/>[get,list,watch,<br/>create,update,patch]"]
        CoreResources["core<br/>ConfigMaps, Secrets,<br/>Services, ServiceAccounts<br/>[get,list,watch,create,<br/>update,patch,delete]"]
        Events["core<br/>Events<br/>[create,patch]"]
    end

    subgraph Resources_Apps["Apps Resources"]
        Deployments["apps<br/>Deployments<br/>[get,list,watch,create,<br/>update,patch,delete]"]
    end

    subgraph Resources_RBAC["RBAC Resources"]
        RBACResources["rbac.authorization.k8s.io<br/>Roles, RoleBindings,<br/>ClusterRoles, ClusterRoleBindings<br/>[get,list,watch,create,<br/>update,patch,delete]"]
    end

    subgraph Resources_Admission["Admission & API Extensions"]
        CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions<br/>[get,list,watch,create,<br/>update,patch,delete]"]
        Webhooks["admissionregistration.k8s.io<br/>MutatingWebhookConfigurations,<br/>ValidatingWebhookConfigurations<br/>[get,list,watch,create,<br/>update,patch,delete]"]
    end

    subgraph Resources_Domain["Domain Resources"]
        Notebooks["kubeflow.org<br/>Notebooks<br/>[get,list,watch,create,<br/>update,patch,delete]"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews<br/>[create]"]
        ImageStreams["image.openshift.io<br/>ImageStreams<br/>[get,list,watch,create,<br/>update,patch,delete]"]
        APIServers["config.openshift.io<br/>APIServers<br/>[get,list,watch]"]
        HWProfiles["infrastructure.opendatahub.io<br/>HardwareProfiles<br/>[get]"]
    end

    subgraph Resources_Escalate["Escalate Permissions"]
        EscalateRoles["rbac.authorization.k8s.io<br/>ClusterRoles<br/>[bind,escalate]<br/>(scoped to 9 named<br/>upstream ClusterRoles)"]
    end

    %% manager-role grants
    CR1 --> Workbenches
    CR1 --> WorkbenchesStatus
    CR1 --> WorkbenchesFinalizers
    CR1 --> Namespaces
    CR1 --> CoreResources
    CR1 --> Events
    CR1 --> Deployments
    CR1 --> RBACResources
    CR1 --> CRDs
    CR1 --> Webhooks
    CR1 --> Notebooks
    CR1 --> SAR
    CR1 --> ImageStreams
    CR1 --> APIServers
    CR1 --> HWProfiles

    %% escalate role grants
    CR2 --> EscalateRoles

