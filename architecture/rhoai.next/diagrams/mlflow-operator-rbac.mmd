graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["mlflow-operator-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["mlflow-operator-manager-rolebinding"]
        CRB2["mlflow-operator-metrics-auth-rolebinding"]
        CRB3["mlflow-operator-openshift-tls-profile-reader-binding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["mlflow-operator-manager-role"]
        CR_MetricsAuth["mlflow-operator-metrics-auth-role"]
        CR_MetricsReader["mlflow-operator-metrics-reader"]
        CR_TLS["mlflow-operator-openshift-tls-profile-reader"]
        CR_View["mlflow-operator-mlflow-view<br/>(aggregated to admin/edit/view)"]
        CR_Edit["mlflow-operator-mlflow-edit<br/>(aggregated to admin/edit)"]
        CR_Integration["mlflow-operator-mlflow-integration"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        NR_Manager["mlflow-operator-manager-role<br/>(Role)"]
        NR_LeaderElection["mlflow-operator-leader-election-role<br/>(Role)"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        direction TB
        MLflowCRD["mlflow.opendatahub.io<br/>mlflows, mlflows/finalizers,<br/>mlflows/status<br/>→ CRUD + watch"]
        MLflowOpCRD["components.platform.opendatahub.io<br/>mlflowoperators<br/>→ get, list, patch, update, watch"]
        HTTPRouteRes["gateway.networking.k8s.io<br/>httproutes<br/>→ CRUD + watch"]
        ConsoleLinkRes["console.openshift.io<br/>consolelinks<br/>→ CRUD + watch"]
        ServiceMonRes["monitoring.coreos.com<br/>servicemonitors<br/>→ CRUD + watch"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings<br/>→ CRUD (named: mlflow, mlflow-gc)"]
        NamespaceRes["core<br/>namespaces<br/>→ get, list, watch"]
        SecretRes["core<br/>secrets (mlflow-artifact-connection)<br/>→ get, list, watch"]
        KubeflowRes["mlflow.kubeflow.org<br/>experiments, mlflowconfigs<br/>→ get, list, watch"]
        AuthRes["services.platform.opendatahub.io<br/>auths (auth)<br/>→ get, list, watch"]
    end

    subgraph MetricsAuthResources["Metrics Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews → create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews → create"]
    end

    subgraph TLSResources["TLS Resources"]
        APIServers["config.openshift.io<br/>apiservers<br/>→ get, list, watch"]
    end

    subgraph NamespaceResources["Namespace Role Resources"]
        CoreRes["core: configmaps, pvcs,<br/>secrets, serviceaccounts,<br/>services → CRUD + watch"]
        PodRes["core: pods<br/>→ get, list, watch"]
        DeployRes["apps: deployments<br/>→ CRUD + watch"]
        BatchRes["batch: jobs, cronjobs<br/>→ CRUD + watch"]
        NetPolRes["networking.k8s.io<br/>networkpolicies → CRUD + watch"]
        NSMonRes["monitoring.coreos.com<br/>servicemonitors → CRUD + watch"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    SA -->|"bound via"| CRB3

    CRB1 -->|"grants"| CR_Manager
    CRB2 -->|"grants"| CR_MetricsAuth
    CRB3 -->|"grants"| CR_TLS

    %% ClusterRole → Resources
    CR_Manager --> MLflowCRD
    CR_Manager --> MLflowOpCRD
    CR_Manager --> HTTPRouteRes
    CR_Manager --> ConsoleLinkRes
    CR_Manager --> ServiceMonRes
    CR_Manager --> RBACRes
    CR_Manager --> NamespaceRes
    CR_Manager --> SecretRes
    CR_Manager --> KubeflowRes
    CR_Manager --> AuthRes

    CR_MetricsAuth --> TokenReview
    CR_MetricsAuth --> SAR

    CR_TLS --> APIServers

    %% Namespace Role
    SA -.->|"namespace binding"| NR_Manager
    SA -.->|"namespace binding"| NR_LeaderElection
    NR_Manager --> CoreRes
    NR_Manager --> PodRes
    NR_Manager --> DeployRes
    NR_Manager --> BatchRes
    NR_Manager --> NetPolRes
    NR_Manager --> NSMonRes

