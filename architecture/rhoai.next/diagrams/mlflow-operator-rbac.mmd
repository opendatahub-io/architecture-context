graph TD
    subgraph "Service Accounts"
        SA_Controller["controller-manager<br/>(operator SA)"]
        SA_MLflow["mlflow-sa<br/>(MLflow server SA)"]
        SA_GC["mlflow-gc-sa<br/>(GC CronJob SA, conditional)"]
    end

    subgraph "Cluster Role Bindings"
        CRB_Manager["manager-rolebinding<br/>(cluster-scoped)"]
        CRB_MLflow["mlflow<br/>(cluster-scoped)"]
        CRB_GC["mlflow-gc<br/>(cluster-scoped, conditional)"]
    end

    subgraph "Namespace Role Bindings"
        RB_Manager["manager-rolebinding<br/>(namespace-scoped)"]
    end

    subgraph "Workspace Role Bindings (dynamic, per labeled namespace)"
        RB_View["odh-group-mlflow-view<br/>Subjects: Auth CR allowedGroups + adminGroups"]
        RB_Edit["odh-group-mlflow-edit<br/>Subjects: Auth CR adminGroups"]
    end

    subgraph "ClusterRoles"
        CR_Manager["manager-role<br/>(ClusterRole)"]
        CR_MLflow["mlflow<br/>(ClusterRole)"]
        CR_GC["mlflow-gc<br/>(ClusterRole, conditional)"]
        CR_View["mlflow-operator-mlflow-view<br/>(aggregate ClusterRole)"]
        CR_Edit["mlflow-operator-mlflow-edit<br/>(aggregate ClusterRole)"]
        CR_Integration["mlflow-integration<br/>(ClusterRole)"]
    end

    subgraph "Namespace Roles"
        R_Manager["manager-role<br/>(Role, ns-scoped)"]
    end

    %% SA → Binding → Role chains
    SA_Controller -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager

    SA_Controller -->|bound via| RB_Manager
    RB_Manager -->|grants| R_Manager

    SA_MLflow -->|bound via| CRB_MLflow
    CRB_MLflow -->|grants| CR_MLflow

    SA_GC -->|bound via| CRB_GC
    CRB_GC -->|grants| CR_GC

    RB_View -->|grants| CR_View
    RB_Edit -->|grants| CR_Edit

    subgraph "Operator ClusterRole Resources"
        direction LR
        OP_MLflow["mlflow.opendatahub.io<br/>mlflows, mlflows/status,<br/>mlflows/finalizers<br/>→ full CRUD"]
        OP_Module["components.platform.opendatahub.io<br/>mlflowoperators,<br/>mlflowoperators/status<br/>→ get, list, watch, update, patch"]
        OP_HTTPRoute["gateway.networking.k8s.io<br/>httproutes<br/>→ full CRUD"]
        OP_Console["console.openshift.io<br/>consolelinks<br/>→ full CRUD"]
        OP_NS["core<br/>namespaces<br/>→ get, list, watch"]
        OP_Secrets["core<br/>secrets (mlflow-artifact-connection)<br/>→ get, list, watch"]
        OP_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings<br/>→ manage"]
        OP_Auth["services.platform.opendatahub.io<br/>auths<br/>→ get, list, watch"]
    end

    subgraph "Namespace Role Resources"
        direction LR
        NS_Core["core<br/>configmaps, pvcs, secrets,<br/>serviceaccounts, services<br/>→ full CRUD"]
        NS_Apps["apps<br/>deployments<br/>→ full CRUD"]
        NS_Batch["batch<br/>jobs, cronjobs<br/>→ full CRUD"]
        NS_Net["networking.k8s.io<br/>networkpolicies<br/>→ full CRUD"]
        NS_Mon["monitoring.coreos.com<br/>servicemonitors<br/>→ full CRUD"]
    end

    subgraph "MLflow Server ClusterRole Resources"
        ML_NS["core: namespaces<br/>→ get, list, watch"]
        ML_Secrets["core: secrets<br/>(mlflow-artifact-connection)<br/>→ get, list, watch"]
        ML_Config["mlflow.kubeflow.org<br/>mlflowconfigs<br/>→ get, list, watch"]
    end

    subgraph "View Aggregate Resources"
        V_MLflow["mlflow.opendatahub.io<br/>mlflows, mlflows/status<br/>→ get, list, watch"]
        V_KF["mlflow.kubeflow.org<br/>mlflowconfigs, datasets,<br/>experiments, registeredmodels,<br/>gatewayendpoints, mcpservers<br/>→ get, list"]
    end

    subgraph "Edit Aggregate Resources"
        E_MLflow["mlflow.opendatahub.io<br/>mlflows, mlflows/finalizers<br/>→ full CRUD"]
        E_KF["mlflow.kubeflow.org<br/>mlflowconfigs, datasets,<br/>experiments, registeredmodels,<br/>gatewayendpoints, mcpservers<br/>→ full CRUD"]
    end

    CR_Manager -->|permissions| OP_MLflow
    CR_Manager -->|permissions| OP_Module
    CR_Manager -->|permissions| OP_HTTPRoute
    CR_Manager -->|permissions| OP_Console
    CR_Manager -->|permissions| OP_NS
    CR_Manager -->|permissions| OP_Secrets
    CR_Manager -->|permissions| OP_RBAC
    CR_Manager -->|permissions| OP_Auth

    R_Manager -->|permissions| NS_Core
    R_Manager -->|permissions| NS_Apps
    R_Manager -->|permissions| NS_Batch
    R_Manager -->|permissions| NS_Net
    R_Manager -->|permissions| NS_Mon

    CR_MLflow -->|permissions| ML_NS
    CR_MLflow -->|permissions| ML_Secrets
    CR_MLflow -->|permissions| ML_Config

    CR_View -->|permissions| V_MLflow
    CR_View -->|permissions| V_KF

    CR_Edit -->|permissions| E_MLflow
    CR_Edit -->|permissions| E_KF

