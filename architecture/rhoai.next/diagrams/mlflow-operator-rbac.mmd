graph TD
    subgraph ServiceAccounts["Service Accounts"]
        OperatorSA["mlflow-operator-<br/>controller-manager<br/>(Operator SA)"]
        MLflowSA["mlflow-sa<br/>(Server SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        ManagerCRB["manager-rolebinding<br/>(cluster-scoped)"]
        MLflowCRB["mlflow<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        ManagerRB["manager-rolebinding<br/>(target namespace)"]
        ViewRB["odh-group-mlflow-view<br/>(workspace namespaces)"]
        EditRB["odh-group-mlflow-edit<br/>(workspace namespaces)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        ManagerCR["manager-role<br/>(ClusterRole)"]
        MLflowCR["mlflow<br/>(ClusterRole)"]
        MLflowGC["mlflow-gc<br/>(ClusterRole)"]
        ViewCR["mlflow-view<br/>(aggregate)"]
        EditCR["mlflow-edit<br/>(aggregate)"]
        IntegrationCR["mlflow-integration<br/>(ClusterRole)"]
    end

    subgraph NamespaceRole["Role (namespace-scoped)"]
        ManagerRole["manager-role<br/>(Role)"]
    end

    subgraph OperatorResources["Operator-Managed Resources (ClusterRole)"]
        MLflowCRD["mlflow.opendatahub.io<br/>mlflows, mlflows/status,<br/>mlflows/finalizers"]
        MLflowOpCRD["components.platform.opendatahub.io<br/>mlflowoperators, mlflowoperators/status,<br/>mlflowoperators/finalizers"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        ConsoleLinks["console.openshift.io<br/>consolelinks"]
        APIServers["config.openshift.io<br/>apiservers"]
        Namespaces["core<br/>namespaces"]
        Secrets["core<br/>secrets (mlflow-artifact-connection)"]
        RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings"]
        AuthsRes["services.platform.opendatahub.io<br/>auths (auth)"]
    end

    subgraph NamespaceResources["Namespace-Scoped Resources (Role)"]
        CoreRes["core<br/>configmaps, secrets,<br/>serviceaccounts, services, pvcs"]
        AppsRes["apps<br/>deployments"]
        BatchRes["batch<br/>jobs, cronjobs"]
        NetRes["networking.k8s.io<br/>networkpolicies"]
        MonRes["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph ServerResources["Server Resources (ClusterRole)"]
        ServerNS["core<br/>namespaces"]
        ServerSecrets["core<br/>secrets (mlflow-artifact-connection)"]
        MLflowConfigs["mlflow.kubeflow.org<br/>mlflowconfigs"]
    end

    subgraph AggregateResources["Aggregate Role Resources"]
        ViewRes["mlflow.opendatahub.io<br/>mlflows, mlflows/status<br/>(get, list, watch)"]
        EditRes["mlflow.opendatahub.io<br/>mlflows, mlflows/finalizers<br/>(full CRUD)"]
    end

    subgraph WorkspaceGroups["Workspace Group Subjects"]
        AllowedGroups["Auth CR allowedGroups<br/>+ adminGroups"]
        AdminGroups["Auth CR adminGroups"]
    end

    %% Operator SA bindings
    OperatorSA -->|"bound via"| ManagerCRB
    ManagerCRB -->|"grants"| ManagerCR

    OperatorSA -->|"bound via"| ManagerRB
    ManagerRB -->|"grants"| ManagerRole

    %% Server SA bindings
    MLflowSA -->|"bound via"| MLflowCRB
    MLflowCRB -->|"grants"| MLflowCR

    %% Workspace group bindings
    AllowedGroups -->|"bound via"| ViewRB
    ViewRB -->|"grants"| ViewCR

    AdminGroups -->|"bound via"| EditRB
    EditRB -->|"grants"| EditCR

    %% ClusterRole to resources
    ManagerCR -->|"full CRUD"| MLflowCRD
    ManagerCR -->|"get, list, watch, update, patch"| MLflowOpCRD
    ManagerCR -->|"full CRUD"| HTTPRoutes
    ManagerCR -->|"full CRUD"| ConsoleLinks
    ManagerCR -->|"get, list, watch"| APIServers
    ManagerCR -->|"get, list, watch"| Namespaces
    ManagerCR -->|"get, list, watch"| Secrets
    ManagerCR -->|"create + scoped"| RBAC
    ManagerCR -->|"get, list, watch"| AuthsRes

    %% Role to namespace resources
    ManagerRole -->|"full CRUD"| CoreRes
    ManagerRole -->|"full CRUD"| AppsRes
    ManagerRole -->|"full CRUD"| BatchRes
    ManagerRole -->|"full CRUD"| NetRes
    ManagerRole -->|"full CRUD"| MonRes

    %% Server ClusterRole to resources
    MLflowCR -->|"get, list, watch"| ServerNS
    MLflowCR -->|"get, list, watch"| ServerSecrets
    MLflowCR -->|"get, list, watch"| MLflowConfigs

    %% Aggregate roles to resources
    ViewCR -->|"get, list, watch"| ViewRes
    EditCR -->|"full CRUD"| EditRes

    %% Styling
    style OperatorSA fill:#4a90e2,stroke:#333,color:#fff
    style MLflowSA fill:#4a90e2,stroke:#333,color:#fff
    style ManagerCR fill:#f5a623,stroke:#333
    style MLflowCR fill:#f5a623,stroke:#333
    style MLflowGC fill:#f5a623,stroke:#333
    style ViewCR fill:#f5a623,stroke:#333
    style EditCR fill:#f5a623,stroke:#333
    style IntegrationCR fill:#f5a623,stroke:#333
    style ManagerRole fill:#e8a040,stroke:#333
    style ManagerCRB fill:#c8c8c8,stroke:#333
    style MLflowCRB fill:#c8c8c8,stroke:#333
    style ManagerRB fill:#c8c8c8,stroke:#333
    style ViewRB fill:#c8c8c8,stroke:#333
    style EditRB fill:#c8c8c8,stroke:#333
    style MLflowCRD fill:#7ed321,stroke:#333
    style MLflowOpCRD fill:#7ed321,stroke:#333
    style HTTPRoutes fill:#7ed321,stroke:#333
    style ConsoleLinks fill:#7ed321,stroke:#333
    style AllowedGroups fill:#9b59b6,stroke:#333,color:#fff
    style AdminGroups fill:#9b59b6,stroke:#333,color:#fff
