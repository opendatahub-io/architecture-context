graph TD
    subgraph "Service Accounts"
        SA["opendatahub-feast-operator<br/>(ServiceAccount)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["opendatahub-feast-<br/>manager-rolebinding<br/>(cluster-wide)"]
        CRB_Leader["opendatahub-feast-<br/>leader-election-rolebinding<br/>(NS: opendatahub-feast-system)"]
        CRB_Metrics["opendatahub-feast-<br/>metrics-auth-rolebinding<br/>(cluster-wide)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["opendatahub-feast-<br/>manager-role"]
        CR_Leader["opendatahub-feast-<br/>leader-election-role"]
        CR_Metrics["opendatahub-feast-<br/>metrics-auth-role"]
    end

    subgraph "Platform CRD Resources"
        FeastOp["components.platform.opendatahub.io<br/>feastoperators<br/>feastoperators/status<br/>feastoperators/finalizers"]
    end

    subgraph "Core Resources"
        Deployments["apps<br/>Deployments"]
        Services["core<br/>Services, ServiceAccounts,<br/>ConfigMaps"]
        Secrets["core<br/>Secrets, Namespaces"]
        Pods["core<br/>Pods, Pods/exec"]
        PVCs["core<br/>PersistentVolumeClaims"]
        Events["core<br/>Events"]
    end

    subgraph "RBAC Resources"
        RBACRes["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings,<br/>Roles, RoleBindings"]
        SAR["rbac.authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph "Feast & Extension Resources"
        CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        FeatureStores["feast.dev<br/>FeatureStores + status/finalizers"]
        Notebooks["kubeflow.org<br/>Notebooks"]
        Jobs["batch<br/>Jobs, CronJobs"]
    end

    subgraph "Infrastructure Resources"
        SvcMon["monitoring.coreos.com<br/>ServiceMonitors"]
        Routes["route.openshift.io<br/>Routes"]
        HPAs["autoscaling<br/>HorizontalPodAutoscalers"]
        PDBs["policy<br/>PodDisruptionBudgets"]
        Leases["coordination.k8s.io<br/>Leases"]
    end

    subgraph "Auth Resources"
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        AuthSAR["authorization.k8s.io<br/>SubjectAccessReviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% Bindings
    SA -->|"bound via"| CRB_Manager
    SA -->|"bound via"| CRB_Leader
    SA -->|"bound via"| CRB_Metrics

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Leader -->|"grants"| CR_Leader
    CRB_Metrics -->|"grants"| CR_Metrics

    %% Manager Role Permissions
    CR_Manager -->|"full CRUD"| FeastOp
    CR_Manager -->|"full CRUD"| Deployments
    CR_Manager -->|"full CRUD"| Services
    CR_Manager -->|"get,list,watch,patch,update"| Secrets
    CR_Manager -->|"get,list,watch,create"| Pods
    CR_Manager -->|"get,list,watch,create,delete,update"| PVCs
    CR_Manager -->|"create,patch"| Events
    CR_Manager -->|"full CRUD"| RBACRes
    CR_Manager -->|"get,list,watch,create,update,delete"| SAR
    CR_Manager -->|"full CRUD"| CRDs
    CR_Manager -->|"full CRUD"| FeatureStores
    CR_Manager -->|"get,list,watch"| Notebooks
    CR_Manager -->|"full CRUD"| Jobs
    CR_Manager -->|"full CRUD"| SvcMon
    CR_Manager -->|"get,list,watch,create,delete,update"| Routes
    CR_Manager -->|"full CRUD"| HPAs
    CR_Manager -->|"full CRUD"| PDBs
    CR_Manager -->|"full CRUD"| Leases
    CR_Manager -->|"create"| TokenReviews
    CR_Manager -->|"create"| AuthSAR
    CR_Manager -->|"get"| MetricsURL

