    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB_Manager fill:#b3d9ff,stroke:#333
    style CRB_Leader fill:#b3d9ff,stroke:#333
    style CRB_Metrics fill:#b3d9ff,stroke:#333
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Leader fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style FeastOp fill:#7ed321,stroke:#333
    style Deployments fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style PVCs fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
    style RBACRes fill:#ff9999,stroke:#333
    style SAR fill:#ff9999,stroke:#333
    style CRDs fill:#ff9999,stroke:#333
    style FeatureStores fill:#7ed321,stroke:#333
    style Notebooks fill:#7ed321,stroke:#333
    style Jobs fill:#7ed321,stroke:#333
    style SvcMon fill:#7ed321,stroke:#333
    style Routes fill:#7ed321,stroke:#333
