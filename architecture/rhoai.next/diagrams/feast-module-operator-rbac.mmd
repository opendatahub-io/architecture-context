graph TD
    subgraph "Service Accounts"
        SA["opendatahub-feast-operator<br/>(ServiceAccount)"]
    end

    subgraph "Role Bindings"
        CRB["manager-rolebinding<br/>(ClusterRoleBinding)"]
        RB["leader-election-rolebinding<br/>(RoleBinding, namespace-scoped)"]
    end

    subgraph "Roles"
        CR["manager-role<br/>(ClusterRole)"]
        LER["leader-election-role<br/>(Role)"]
    end

    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| CR
    RB -->|"grants"| LER

    subgraph "Core ODH Resources"
        FeastOp["components.platform.opendatahub.io<br/>feastoperators<br/>+ /status, /finalizers"]
    end

    subgraph "Kubernetes Core Resources"
        Deployments["apps<br/>Deployments"]
        CoreRW["core<br/>Services, ServiceAccounts,<br/>ConfigMaps"]
        CoreRO["core<br/>Secrets, Namespaces<br/>(no create/delete)"]
        Pods["core<br/>Pods, Pods/exec<br/>(no update/delete)"]
        PVCs["core<br/>PersistentVolumeClaims"]
        Events["core<br/>Events (create, patch)"]
    end

    subgraph "RBAC Resources"
        RBACRes["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings,<br/>Roles, RoleBindings"]
    end

    subgraph "CRD & Extension Resources"
        CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        FeastCRDs["feast.dev<br/>FeatureStores<br/>+ /status, /finalizers"]
    end

    subgraph "Workload Resources"
        BatchRes["batch<br/>Jobs, CronJobs"]
        Autoscaling["autoscaling<br/>HorizontalPodAutoscalers"]
        PolicyRes["policy<br/>PodDisruptionBudgets"]
    end

    subgraph "Platform & Monitoring"
        ServiceMon["monitoring.coreos.com<br/>ServiceMonitors"]
        RoutesRes["route.openshift.io<br/>Routes"]
        Leases["coordination.k8s.io<br/>Leases"]
    end

    subgraph "Auth Resources"
        TokenReview["authentication.k8s.io<br/>TokenReviews (create)"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews (create)"]
    end

    subgraph "Read-Only Access"
        NotebooksRes["kubeflow.org<br/>Notebooks<br/>(get, list, watch only)"]
        MetricsNR["/metrics<br/>(non-resource, get)"]
    end

    CR -->|"full CRUD"| FeastOp
    CR -->|"full CRUD"| Deployments
    CR -->|"full CRUD"| CoreRW
    CR -->|"get,list,watch,<br/>patch,update"| CoreRO
    CR -->|"get,list,watch,<br/>create"| Pods
    CR -->|"get,list,watch,<br/>create,delete,update"| PVCs
    CR -->|"create,patch"| Events
    CR -->|"full CRUD"| RBACRes
    CR -->|"full CRUD"| CRDs
    CR -->|"full CRUD"| FeastCRDs
    CR -->|"full CRUD"| BatchRes
    CR -->|"full CRUD"| Autoscaling
    CR -->|"full CRUD"| PolicyRes
    CR -->|"full CRUD"| ServiceMon
    CR -->|"full CRUD"| RoutesRes
    CR -->|"full CRUD"| Leases
    CR -->|"create"| TokenReview
    CR -->|"create"| SAR
    CR -->|"get,list,watch"| NotebooksRes
    CR -->|"get"| MetricsNR

    LER -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Leases

