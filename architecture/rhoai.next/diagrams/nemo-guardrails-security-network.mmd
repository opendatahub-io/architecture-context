graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformIngress["PLATFORM INGRESS (TLS Termination)"]
        Route["OpenShift Route / Istio Gateway<br/>443/TCP → 8000/TCP<br/>TLS 1.2+ termination"]
    end

    subgraph Application["APPLICATION (NeMo Guardrails)"]
        direction TB
        Server["NeMo Guardrails FastAPI Server<br/>Container: odh-nemo-guardrails-rhel9<br/>Port: 8000/TCP HTTP (ClusterIP)<br/>Base: AIPCC CPU el9.8 (FIPS OpenSSL)"]

        subgraph HeaderLogic["Header Forwarding"]
            HdrFwd["X-Authorization → Authorization<br/>X-* headers forwarded<br/>Inbound Authorization NEVER forwarded"]
        end

        subgraph LocalModels["Baked-In ML Models (air-gapped)"]
            Models["MiniLM | Snowflake Arctic<br/>spaCy | NLTK punkt<br/>DeBERTa | Granite Guardian HAP"]
        end

        Server --- HdrFwd
        Server -->|local inference| Models
    end

    subgraph UpstreamServices["UPSTREAM SERVICES"]
        LLM["LLM Inference Server<br/>(OpenAI-compatible)<br/>Configurable port<br/>HTTPS / TLS<br/>Bearer token"]
        Azure["Azure OpenAI<br/>443/TCP<br/>HTTPS / TLS<br/>API key"]
        SafetyAPIs["Third-Party Safety APIs<br/>(ActiveFence, Pangea,<br/>CrowdStrike, etc.)<br/>443/TCP HTTPS<br/>Provider-specific API keys"]
        OTel["OpenTelemetry Collector<br/>Configurable port<br/>gRPC/HTTP"]
    end

    subgraph Disabled["DISABLED IN PRODUCTION"]
        HFHub["HuggingFace Hub<br/>HF_HUB_OFFLINE=1<br/>TRANSFORMERS_OFFLINE=1"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>X-Authorization header"| Route
    Route -->|"HTTP/8000<br/>Plaintext (in-cluster)<br/>Headers forwarded"| Server
    Server -->|"HTTPS/configurable<br/>TLS<br/>Bearer token (forwarded)"| LLM
    Server -->|"HTTPS/443<br/>TLS<br/>API key"| Azure
    Server -->|"HTTPS/443<br/>TLS<br/>API keys"| SafetyAPIs
    Server -.->|"gRPC or HTTP<br/>When OTEL endpoint set"| OTel
    Server -.->|"BLOCKED at runtime"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef upstream fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef disabled fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5

    class Client external
    class Route ingress
    class Server,HdrFwd,Models application
    class LLM,Azure,SafetyAPIs,OTel upstream
    class HFHub disabled
