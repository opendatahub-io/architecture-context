graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed TLS)"]
        PlatformIngress["Platform Ingress<br/>(RHOAI Operator HTTPRoute/Route)<br/>443/TCP → 8000/TCP<br/>TLS 1.2+ Termination<br/>kube-rbac-proxy"]
    end

    subgraph Application["APPLICATION (Internal Cluster)"]
        direction TB

        NemoServer["NeMo Guardrails Server<br/>Service: nemo-guardrails (ClusterIP)<br/>Port: 8000/TCP HTTP<br/>FastAPI + Uvicorn<br/>Image: AIPCC CPU base<br/>No built-in auth"]

        subgraph LocalServices["LOCAL SERVICES (Sidecar/Co-located)"]
            JailbreakSvc["Jailbreak Detection<br/>1337/TCP HTTP<br/>No encryption<br/>No auth"]
            AlignScoreSvc["AlignScore Service<br/>5000/TCP HTTP<br/>No encryption<br/>No auth"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LLM["Upstream LLM Provider<br/>(OpenAI / NIM / vLLM / Azure)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token"]
        Redis["Redis (Optional)<br/>6379/TCP<br/>Optional TLS<br/>Username/Password"]
        OTel["OpenTelemetry Collector<br/>(Optional)<br/>OTLP gRPC/HTTP<br/>TLS configurable"]
        NVTelemetry["NVIDIA Telemetry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Client ID<br/>(disabled via DO_NOT_TRACK)"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Optional Token<br/>(pre-fetched at build)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (passthrough)"| PlatformIngress
    PlatformIngress -->|"HTTP/8000<br/>Plaintext (post-TLS)<br/>Header passthrough"| NemoServer
    NemoServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (API key)"| LLM
    NemoServer -->|"HTTP/1337<br/>Plaintext<br/>No auth"| JailbreakSvc
    NemoServer -->|"HTTP/5000<br/>Plaintext<br/>No auth"| AlignScoreSvc
    NemoServer -.->|"TCP/6379<br/>Optional TLS<br/>Username/Password"| Redis
    NemoServer -.->|"OTLP<br/>TLS configurable"| OTel
    NemoServer -.->|"HTTPS/443<br/>TLS 1.2+<br/>Client ID"| NVTelemetry
    NemoServer -.->|"HTTPS/443<br/>TLS 1.2+<br/>Optional Token"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef localservice fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class PlatformIngress ingress
    class NemoServer application
    class JailbreakSvc,AlignScoreSvc localservice
    class LLM,Redis,OTel,NVTelemetry,HFHub externalservice
