graph TB
    subgraph CaikitTGISBackend["caikit-tgis-backend Library"]
        direction TB
        Backend[TGISBackend<br/><i>BackendBase implementation</i><br/>Model-to-connection mapping]
        Connection[TGISConnection<br/><i>Dataclass</i><br/>gRPC channel + TLS config]
        Subprocess[ManagedTGISSubprocess<br/><i>Subprocess manager</i><br/>Health check + auto-recovery]
        LoadBalancer[GRPCLoadBalancerProxy<br/><i>DNS-based LB</i><br/>Periodic endpoint discovery]
        Proto[generation.proto<br/><i>Protobuf definition</i><br/>fmaas.GenerationService]

        Backend -->|"creates/manages"| Connection
        Backend -->|"launches (local mode)"| Subprocess
        Connection -->|"uses for remote"| LoadBalancer
        Connection -->|"implements"| Proto
        Subprocess -->|"monitored via"| Connection
    end

    ServingRuntime[Caikit Serving Runtime<br/><i>e.g. caikit-tgis-serving</i>] -->|"imports as backend module"| Backend

    Connection -->|"gRPC client<br/>TLS/mTLS"| TGISRemote[TGIS Server<br/><i>Remote</i><br/>configurable port/gRPC]
    Subprocess -->|"spawns process"| TGISLocal[TGIS Subprocess<br/><i>Local</i><br/>50055/TCP gRPC]
    Subprocess -->|"health check<br/>3000/TCP HTTP"| TGISLocal
    LoadBalancer -->|"DNS polling<br/>53/UDP"| DNS[DNS Resolver]

    Backend -->|"file I/O<br/>prompt artifacts"| SharedFS[Shared Filesystem<br/><i>prompt_dir</i>]

    style Backend fill:#4a90e2,stroke:#333,color:#fff
    style Connection fill:#4a90e2,stroke:#333,color:#fff
    style Subprocess fill:#4a90e2,stroke:#333,color:#fff
    style LoadBalancer fill:#4a90e2,stroke:#333,color:#fff
    style Proto fill:#4a90e2,stroke:#333,color:#fff
    style ServingRuntime fill:#7ed321,stroke:#333,color:#fff
    style TGISRemote fill:#f5a623,stroke:#333,color:#fff
    style TGISLocal fill:#f5a623,stroke:#333,color:#fff
    style DNS fill:#e8e8e8,stroke:#333
    style SharedFS fill:#e8e8e8,stroke:#333
