graph TB
    subgraph CaikitTGISBackend["caikit-tgis-backend Library"]
        Backend["TGISBackend<br/>(BackendBase)"]
        Connection["TGISConnection<br/>(gRPC Channel + TLS)"]
        Subprocess["ManagedTGISSubprocess<br/>(Health Monitor + Auto-Recovery)"]
        LoadBalancer["GRPCLoadBalancerProxy<br/>(DNS Polling)"]
        Proto["generation.proto<br/>(fmaas.GenerationService)"]

        Backend -->|"creates connections"| Connection
        Backend -->|"manages (local mode)"| Subprocess
        Connection -->|"uses"| LoadBalancer
        Connection -->|"uses stubs from"| Proto
    end

    ServingRuntime["Caikit Serving Runtime<br/>(caikit-tgis-serving)"] -->|"imports as backend"| Backend

    Connection -->|"gRPC client"| TGISRemote["TGIS Server (Remote)<br/>gRPC / TLS or mTLS"]
    Subprocess -->|"launches"| TGISLocal["TGIS Subprocess (Local)<br/>50055/TCP gRPC + 3000/TCP HTTP"]
    LoadBalancer -->|"resolves endpoints"| DNS["DNS Resolver<br/>53/UDP"]

    Backend -->|"copies prompt artifacts"| SharedFS["Shared Filesystem<br/>(prompt_dir)"]

    Backend -->|"depends on"| Caikit["Caikit Framework<br/>(BackendBase API)"]

    style Backend fill:#4a90e2,color:#fff
    style Connection fill:#4a90e2,color:#fff
    style Subprocess fill:#4a90e2,color:#fff
    style LoadBalancer fill:#4a90e2,color:#fff
    style Proto fill:#4a90e2,color:#fff
    style ServingRuntime fill:#7ed321,color:#fff
    style TGISRemote fill:#f5a623,color:#fff
    style TGISLocal fill:#f5a623,color:#fff
    style DNS fill:#e8e8e8
    style SharedFS fill:#e8e8e8
    style Caikit fill:#e8e8e8
