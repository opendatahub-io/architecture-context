graph TB
    subgraph CaikitTGISBackend["caikit-tgis-backend (Python Library)"]
        direction TB

        TGISBackend["TGISBackend<br/><i>Backend Plugin</i><br/>Implements BackendBase<br/>Registers 'TGIS' backend type"]

        subgraph ConnectionLayer["Connection Layer"]
            TGISConnection["TGISConnection<br/><i>Connection Manager</i><br/>gRPC + TLS/mTLS support"]
            LoadBalancer["GRPCLoadBalancerProxy<br/><i>Load Balancer</i><br/>DNS polling + channel reconnection"]
        end

        subgraph LocalMode["Local Mode"]
            ManagedSubprocess["ManagedTGISSubprocess<br/><i>Process Manager</i><br/>Health monitoring + auto-recovery"]
            AutoRecoveryStub["AutoRecoveringGenerationServiceStub<br/><i>Error Interceptor</i><br/>Catches failures, triggers restart"]
        end

        subgraph ProtoLayer["Protocol Layer"]
            GenerationProto["generation.proto<br/><i>FMaaS gRPC Interface</i><br/>Generate, GenerateStream,<br/>Tokenize, ModelInfo"]
        end

        TGISBackend -->|"manages connections"| TGISConnection
        TGISBackend -->|"manages subprocess<br/>(local mode)"| ManagedSubprocess
        TGISConnection -->|"uses for remote mode"| LoadBalancer
        TGISConnection -->|"uses gRPC stubs"| GenerationProto
        ManagedSubprocess -->|"wraps RPC calls"| AutoRecoveryStub
        AutoRecoveryStub -->|"uses gRPC stubs"| GenerationProto
    end

    CaikitRuntime["Caikit Runtime<br/>(caikit-tgis-serving)"] -->|"imports & configures<br/>BackendBase plugin"| TGISBackend

    subgraph RemoteTGIS["Remote TGIS Server"]
        TGISRemote["TGIS (Remote)<br/>gRPC/HTTP2<br/>TLS / mTLS"]
    end

    subgraph LocalTGIS["Local TGIS Subprocess"]
        TGISLocal["text-generation-launcher<br/>gRPC: 50055/TCP<br/>HTTP: 3000/TCP"]
    end

    LoadBalancer -->|"gRPC calls<br/>TLS/mTLS"| TGISRemote
    ManagedSubprocess -->|"spawns & monitors"| TGISLocal
    AutoRecoveryStub -->|"gRPC calls<br/>plaintext"| TGISLocal

    DNS["DNS Resolver<br/>53/UDP"] -.->|"endpoint discovery"| LoadBalancer

    PromptDir["Filesystem<br/>(prompt_dir)"] -.->|"prompt artifact<br/>copy/load"| TGISConnection

    TLSCerts["TLS Certificates<br/>(CA cert, client cert/key)"] -.->|"file read<br/>at connection time"| TGISConnection

    style TGISBackend fill:#4a90e2,stroke:#333,color:#fff
    style TGISConnection fill:#4a90e2,stroke:#333,color:#fff
    style LoadBalancer fill:#4a90e2,stroke:#333,color:#fff
    style ManagedSubprocess fill:#4a90e2,stroke:#333,color:#fff
    style AutoRecoveryStub fill:#4a90e2,stroke:#333,color:#fff
    style GenerationProto fill:#f5a623,stroke:#333,color:#fff
    style CaikitRuntime fill:#7ed321,stroke:#333,color:#fff
    style TGISRemote fill:#e8e8e8,stroke:#333
    style TGISLocal fill:#e8e8e8,stroke:#333
    style DNS fill:#e8e8e8,stroke:#333
    style PromptDir fill:#e8e8e8,stroke:#333
    style TLSCerts fill:#d94f4f,stroke:#333,color:#fff
