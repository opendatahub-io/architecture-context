graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Clients["External Clients<br/>Data Scientists, Applications"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        direction TB
        GW_Dashboard["Dashboard Gateway<br/>443/TCP HTTPS → 8080/TCP<br/>TLS 1.3, OAuth2/OIDC via kube-auth-proxy"]
        GW_KServe["KServe Inference Gateway<br/>443/TCP HTTPS → EPP<br/>TLS 1.3, Kuadrant AuthPolicy"]
        GW_Notebooks["Notebook Gateway<br/>443/TCP HTTPS → kube-rbac-proxy<br/>TLS 1.3, SubjectAccessReview"]
        GW_ModelReg["Model Registry Gateway<br/>443/TCP HTTPS → 8080/TCP<br/>TLS 1.3, kube-rbac-proxy"]
    end

    subgraph NS_Operator["Namespace: redhat-ods-operator"]
        RhodsOp["rhods-operator<br/>SA: rhods-operator<br/>Leader election + webhooks"]
    end

    subgraph NS_Apps["Namespace: redhat-ods-applications"]
        direction TB
        Dashboard["odh-dashboard<br/>SA: odh-dashboard<br/>8080/TCP + kube-rbac-proxy 8443/TCP"]
        ODHModelCtrl["odh-model-controller<br/>SA: odh-model-controller<br/>8080/TCP + kube-rbac-proxy 8443/TCP"]
        KServeCtrl["KServe Controller<br/>SA: kserve-controller-manager<br/>Webhooks: 9443/TCP"]
        LLMISVCCtrl["llmisvc-controller-manager<br/>SA: llmisvc-controller<br/>Metrics: 8443/TCP"]
        KubeflowCtrl2["Kubeflow Notebook Controller<br/>SA: notebook-controller<br/>kube-rbac-proxy 8443/TCP"]
        ModelRegOp2["Model Registry Operator<br/>SA: model-registry-operator<br/>kube-rbac-proxy 8443/TCP"]
        DSPO2["DS Pipelines Operator<br/>SA: data-science-pipelines-operator<br/>kube-rbac-proxy 8443/TCP"]
        TrustyAIOp["TrustyAI Operator<br/>SA: trustyai-service-operator<br/>kube-rbac-proxy 8443/TCP"]
        KuequeCtrl["Kueue Controller<br/>SA: kueue-controller-manager<br/>Webhooks: 9443/TCP"]
        KubeRayOp["KubeRay Operator<br/>SA: kuberay-operator<br/>kube-rbac-proxy 8443/TCP"]
        AIGatewayOp["AI Gateway Operator<br/>SA: ai-gateway-operator"]
        KubeAuthProxy2["kube-auth-proxy<br/>SA: kube-auth-proxy<br/>OAuth2/OIDC enforcement"]
        WorkbenchesOp2["workbenches-operator<br/>SA: workbenches-operator"]
        SparkOp2["Spark Operator<br/>SA: spark-operator"]
        TrainingOp2["Training Operator<br/>SA: training-operator"]
        MLflowOp2["MLflow Operator<br/>SA: mlflow-operator"]
        FeastModOp2["Feast Module Operator<br/>SA: feast-module-operator"]
        MCPOps["MCP Lifecycle Operator<br/>SA: mcp-lifecycle-operator"]
        AgentsOp2["agents-operator<br/>SA: agents-operator<br/>SPIFFE AuthBridge"]
    end

    subgraph NS_AIGateway["Namespace: redhat-ai-gateway-infra"]
        MaaSCtrl["MaaS Controller<br/>SA: maas-controller"]
        BatchGWOp["Batch Gateway Operator<br/>SA: batch-gateway-operator"]
        PayloadProc["Payload Processing<br/>ext_proc filter"]
    end

    subgraph NS_Mesh["Namespace: istio-system / knative-serving"]
        IstioCP["Istio Control Plane<br/>mTLS: STRICT/PERMISSIVE"]
        KnativeServing["KNative Serving<br/>Serverless autoscaling"]
    end

    subgraph NS_Monitoring["Namespace: redhat-ods-monitoring"]
        PromStack["MonitoringStack (Prometheus)<br/>Metrics scraping"]
        Tempo["Tempo<br/>Distributed tracing"]
        OTELCollector["OpenTelemetry Collector<br/>Telemetry aggregation"]
        Perses["Perses<br/>Dashboards"]
        PromLabelProxy["prom-label-proxy<br/>Multi-tenant metrics isolation"]
    end

    subgraph NS_User["User Namespaces (per-team)"]
        NotebookPods["Notebook Pods<br/>Jupyter, VS Code, RStudio<br/>kube-rbac-proxy sidecar"]
        InferSvc["InferenceService Pods<br/>vLLM, MLServer, OpenVINO<br/>llm-d EPP routing"]
        PipelineRuns["Pipeline Runs<br/>Argo Workflow pods"]
        TrainingJobs["Training Jobs<br/>PyTorchJob, RayCluster"]
        ModelRegSvc["Model Registry<br/>gRPC 9090 + REST 8080<br/>PostgreSQL backend"]
        FeastSvc["Feast FeatureStore<br/>Online + Offline serving"]
    end

    subgraph Egress["EGRESS (External Services)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>SA token auth"]
        ContainerReg["Container Registry (quay.io)<br/>443/TCP HTTPS<br/>Pull secrets"]
        ModelStorage["Model Storage (S3/PVC)<br/>443/TCP HTTPS<br/>AWS IAM / static credentials"]
        ExternalLLM["External LLM Providers<br/>443/TCP HTTPS<br/>API keys (MaaS)"]
    end

    %% ─── External → Ingress ───
    Clients -->|"HTTPS/443"| GW_Dashboard
    Clients -->|"HTTPS/443"| GW_KServe
    Clients -->|"HTTPS/443"| GW_Notebooks
    Clients -->|"HTTPS/443"| GW_ModelReg

    %% ─── Ingress → Platform Services ───
    GW_Dashboard -->|"HTTP/8080<br/>kube-auth-proxy OAuth2"| Dashboard
    GW_KServe -->|"ext_proc<br/>Kuadrant AuthPolicy"| InferSvc
    GW_Notebooks -->|"kube-rbac-proxy<br/>SubjectAccessReview"| NotebookPods
    GW_ModelReg -->|"HTTP/8080<br/>kube-rbac-proxy"| ModelRegSvc

    %% ─── Operator Namespace → Apps Namespace ───
    RhodsOp -->|"HTTPS/443<br/>SA token"| K8sAPI
    RhodsOp -->|"deploys via DAG"| KServeCtrl
    RhodsOp -->|"deploys via DAG"| Dashboard
    RhodsOp -->|"deploys via DAG"| DSPO2

    %% ─── Apps Internal Communication ───
    Dashboard -->|"HTTPS/443<br/>SA token"| K8sAPI
    ODHModelCtrl -->|"watches CRs<br/>SA token"| K8sAPI
    ODHModelCtrl -->|"creates HTTPRoutes"| GW_KServe
    KServeCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    KServeCtrl -->|"serverless config"| KnativeServing
    KServeCtrl -->|"mesh config"| IstioCP
    DSPO2 -->|"HTTPS/443<br/>SA token"| K8sAPI
    KubeflowCtrl2 -->|"creates StatefulSets"| NotebookPods
    AIGatewayOp -->|"manages"| MaaSCtrl
    AIGatewayOp -->|"manages"| BatchGWOp

    %% ─── User Namespace Internal ───
    InferSvc -->|"HTTPS/443<br/>AWS IAM"| ModelStorage
    InferSvc -->|"HTTPS/443<br/>Pull secret"| ContainerReg
    PipelineRuns -->|"gRPC/9090<br/>mTLS"| ModelRegSvc
    NotebookPods -->|"HTTPS/443<br/>SA token"| K8sAPI
    MaaSCtrl -->|"HTTPS/443<br/>API keys"| ExternalLLM

    %% ─── Monitoring ───
    PromStack -->|"scrapes metrics<br/>8443/TCP via kube-rbac-proxy"| KServeCtrl
    PromStack -->|"scrapes metrics"| Dashboard
    PromStack -->|"scrapes metrics"| DSPO2
    PromStack -->|"scrapes metrics"| InferSvc
    OTELCollector -->|"receives traces<br/>OTLP/gRPC"| InferSvc
    OTELCollector -->|"exports"| Tempo

    %% ─── Service Mesh ───
    IstioCP -.->|"mTLS STRICT"| ModelRegSvc
    IstioCP -.->|"mTLS STRICT"| MaaSCtrl
    IstioCP -.->|"mTLS PERMISSIVE"| InferSvc

    %% ─── Agent / SPIFFE ───
    AgentsOp2 -.->|"SPIFFE X.509-SVIDs<br/>AuthBridge mTLS"| NS_User

    %% ─── Styling ───
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef apps fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef aigateway fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef mesh fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef user fill:#d5e8d4,stroke:#82b366,stroke-width:1px,stroke-dasharray: 5 5
    classDef egress fill:#f5f5f5,stroke:#666,stroke-width:2px

    class Clients external
    class GW_Dashboard,GW_KServe,GW_Notebooks,GW_ModelReg ingress
    class RhodsOp operator
    class Dashboard,ODHModelCtrl,KServeCtrl,LLMISVCCtrl,KubeflowCtrl2,ModelRegOp2,DSPO2,TrustyAIOp,KuequeCtrl,KubeRayOp,AIGatewayOp,KubeAuthProxy2,WorkbenchesOp2,SparkOp2,TrainingOp2,MLflowOp2,FeastModOp2,MCPOps,AgentsOp2 apps
    class MaaSCtrl,BatchGWOp,PayloadProc aigateway
    class IstioCP,KnativeServing mesh
    class PromStack,Tempo,OTELCollector,Perses,PromLabelProxy monitoring
