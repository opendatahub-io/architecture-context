graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Clients["External Clients<br/>(Data Scientists, API Consumers)"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        direction TB
        DashGW["ODH Dashboard Gateway<br/>443/TCP to 8080/TCP<br/>HTTPS, TLS (cluster profile)<br/>OAuth2/OIDC via kube-auth-proxy"]
        KServeGW["KServe LLMISvc Gateway<br/>443/TCP to 8012/TCP<br/>HTTPS, TLS<br/>Kuadrant AuthPolicy"]
        MaaSGW["MaaS Gateway<br/>443/TCP<br/>HTTPS, TLS<br/>API Key (SHA-256) + Kuadrant"]
        RouteGW["OpenShift Routes<br/>443/TCP<br/>26 route instances<br/>edge/reencrypt TLS"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-operator)"]
        direction TB
        RhodsOp["rhods-operator<br/>SA: rhods-operator"]
        AIGWOp["AI Gateway Operator<br/>SA: ai-gateway-operator"]
        MLflowOp["MLflow Operator<br/>SA: mlflow-operator"]
        MCPOp["MCP Lifecycle Operator<br/>SA: mcp-lifecycle-operator"]
    end

    subgraph PlatformNS["PLATFORM NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph DashPod["Dashboard Pod (up to 10 containers)"]
            DashShell["odh-dashboard shell<br/>SA: odh-dashboard"]
            DashKRBAC["kube-rbac-proxy sidecar"]
            DashBFFs["BFF Modules (x8)<br/>SA: odh-dashboard-modules"]
        end

        KServeCtrl["KServe Controller<br/>SA: kserve-controller-manager"]
        LLMISvcCtrl["llmisvc-controller<br/>SA: kserve-controller-manager"]
        ODHModelCtrl["odh-model-controller<br/>SA: odh-model-controller"]
        KubeAuthProxy["kube-auth-proxy<br/>(Platform Gateway Auth)"]

        subgraph MonStack["Monitoring Stack"]
            Prometheus["Prometheus<br/>(MonitoringStack CR)"]
            Tempo["Tempo<br/>(Distributed Tracing)"]
            OTelCollector["OpenTelemetry Collector"]
            Perses["Perses<br/>(Dashboards)"]
        end
    end

    subgraph MaaSNS["MaaS INFRASTRUCTURE (odh-ai-gateway-infra)"]
        direction TB
        MaaSAPI["maas-api Deployments<br/>SA: maas-controller"]
        PayloadProc["ai-gateway-payload-processing<br/>(ext_proc pre/post-auth)"]
        Authorino["Authorino<br/>(API key validation)"]
    end

    subgraph UserNS["USER PROJECT NAMESPACES"]
        direction TB
        Notebooks["Jupyter Workbenches<br/>Per-user SA"]
        InfSvc["InferenceServices<br/>(vLLM, OVMS, Caikit)"]
        LLMInfSvc["LLMInferenceServices<br/>(vLLM + EPP)"]
        TrainJobs["Training Jobs<br/>(PyTorch, Ray, Spark)"]
        PipelineRuns["Pipeline Runs<br/>(Argo Workflows)"]
        FeatureStores["Feast Feature Stores"]
    end

    subgraph MeshControl["SERVICE MESH (istio-system / openshift-gateway)"]
        IstioCP["Istio Control Plane"]
        EnvoyGW["Envoy Gateway<br/>(data-science-gateway)"]
    end

    subgraph EgressSvc["EGRESS (External Services)"]
        S3["S3/Object Storage<br/>443/TCP HTTPS<br/>AWS IAM / static creds"]
        ContainerReg["Container Registry<br/>(quay.io / registry.redhat.io)<br/>443/TCP HTTPS<br/>Pull secrets"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS<br/>API Token"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>SA tokens"]
        ExtLLM["External LLM Providers<br/>443/TCP HTTPS<br/>API keys (injected)"]
    end

    %% External to Ingress
    Clients -->|"HTTPS/443"| DashGW
    Clients -->|"HTTPS/443"| KServeGW
    Clients -->|"HTTPS/443"| MaaSGW
    Clients -->|"HTTPS/443"| RouteGW

    %% Ingress to Platform
    DashGW -->|"HTTP/8080<br/>OAuth2 validated"| KubeAuthProxy
    KubeAuthProxy -->|"HTTP/8080"| DashShell
    KServeGW -->|"HTTPRoute<br/>via EnvoyGW"| EnvoyGW
    MaaSGW -->|"HTTPRoute<br/>via EnvoyGW"| EnvoyGW
    RouteGW -->|"Various ports"| PlatformNS

    %% Envoy to backends
    EnvoyGW -->|"ext_proc"| PayloadProc
    PayloadProc -->|"HTTP callback"| Authorino
    Authorino -->|"key validation"| MaaSAPI
    EnvoyGW -->|"InferencePool routing"| LLMInfSvc
    EnvoyGW -->|"HTTPRoute"| InfSvc

    %% Dashboard internal
    DashShell -->|"HTTP<br/>inter-BFF"| DashBFFs
    DashKRBAC -->|"SubjectAccessReview"| K8sAPI
    DashBFFs -->|"HTTPS/443<br/>SA token"| K8sAPI

    %% Platform controllers to K8s API
    RhodsOp -->|"HTTPS/443<br/>SA token"| K8sAPI
    KServeCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    LLMISvcCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    AIGWOp -->|"HTTPS/443<br/>SA token"| K8sAPI

    %% User namespace workloads to egress
    InfSvc -->|"HTTPS/443<br/>model artifacts"| S3
    LLMInfSvc -->|"HTTPS/443<br/>model artifacts"| S3
    Notebooks -->|"HTTPS/443<br/>training data"| S3
    PipelineRuns -->|"HTTPS/443<br/>artifacts"| S3
    InfSvc -->|"HTTPS/443<br/>runtime images"| ContainerReg
    LLMInfSvc -->|"HTTPS/443<br/>runtime images"| ContainerReg
    LLMInfSvc -->|"HTTPS/443<br/>model download"| HuggingFace

    %% MaaS to external
    PayloadProc -->|"HTTPS/443<br/>credential injection"| ExtLLM

    %% Monitoring
    Prometheus -.->|"scrape /metrics<br/>via kube-rbac-proxy"| KServeCtrl
    Prometheus -.->|"scrape /metrics"| InfSvc
    Prometheus -.->|"scrape /metrics"| LLMInfSvc
    OTelCollector -.->|"OTLP/gRPC"| Tempo

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operatorns fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platformns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef maasns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef userns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef meshctl fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Clients external
    class DashGW,KServeGW,MaaSGW,RouteGW ingress
    class RhodsOp,AIGWOp,MLflowOp,MCPOp operatorns
    class DashShell,DashKRBAC,DashBFFs,KServeCtrl,LLMISvcCtrl,ODHModelCtrl,KubeAuthProxy,Prometheus,Tempo,OTelCollector,Perses platformns
    class MaaSAPI,PayloadProc,Authorino maasns
    class Notebooks,InfSvc,LLMInfSvc,TrainJobs,PipelineRuns,FeatureStores userns
    class IstioCP,EnvoyGW meshctl
    class S3,ContainerReg,HuggingFace,K8sAPI,ExtLLM egress
