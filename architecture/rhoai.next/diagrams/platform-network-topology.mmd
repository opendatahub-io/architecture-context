graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Clients["External Clients<br/>Data Scientists, API Consumers, Tenant Users"]
    end

    subgraph Ingress["INGRESS TIER (openshift-ingress)"]
        direction TB
        DSGW["data-science-gateway<br/>443/TCP HTTPS<br/>GatewayClass: opendatahub-gateway<br/>Envoy data plane"]
        MaaSGW["maas-default-gateway<br/>443/TCP HTTPS<br/>Multi-Tenant Model Gateway<br/>Envoy data plane"]
        KAP["kube-auth-proxy<br/>8443/TCP<br/>OIDC + OAuth provider<br/>HPA autoscaled"]
        LegacyRoutes["Legacy OpenShift Routes<br/>443/TCP TLS edge<br/>HAProxy, OAuth redirect"]
    end

    subgraph OperatorTier["OPERATOR TIER (redhat-ods-operator)"]
        RhodsOp["rhods-operator<br/>SA: controller-manager<br/>1 replica, leader election"]
    end

    subgraph AppTier["APPLICATION TIER (redhat-ods-applications)"]
        direction TB
        Dashboard["odh-dashboard<br/>2 core + 12+ module pods<br/>Go BFF sidecars"]
        KServeCtrl["KServe + odh-model-controller<br/>SA: kserve-controller-manager<br/>1 replica, leader election"]
        EPP["gateway-api-inference-extension<br/>EPP Envoy ext-proc<br/>KV-cache-aware routing"]
        KueueCtrl["Kueue<br/>SA: kueue-controller-manager<br/>1 replica, leader election"]
        DSPOp["Data Science Pipelines Operator"]
        CodeflareOp["codeflare-operator"]
        RegistryOp["model-registry-operator<br/>kube-rbac-proxy sidecar"]
        OtherOps["15+ additional operators<br/>mlflow, feast, kuberay, trainer,<br/>spark, agents, mcp, ai-gateway,<br/>workbenches, trustyai, observability"]
    end

    subgraph MaaSTier["MAAS TIER"]
        MaaSCtrl["maas-controller<br/>Namespace: models-as-a-service<br/>1 replica, leader election"]
        AITenants["AITenant CRs<br/>Namespace: ai-tenants"]
        TenantInfra["Per-tenant maas-api<br/>+ maas-discovery x2<br/>Namespace: tenant-infra"]
    end

    subgraph UserTier["USER TIER (user namespaces)"]
        direction TB
        ModelPods["Model Serving Pods<br/>vLLM, OVMS, MLServer, caikit<br/>kube-rbac-proxy sidecar"]
        LlmdPods["llm-d Workers<br/>Prefill + Decode pods<br/>LeaderWorkerSet, NIXL"]
        Notebooks["Notebook / Workspace Pods<br/>Jupyter, Code Server, RStudio<br/>kube-rbac-proxy sidecar"]
        PipelineRuns["Pipeline Runs<br/>Argo Workflows pods"]
        TrainingJobs["Training Jobs<br/>TrainJob, RayJob, SparkApp"]
    end

    subgraph LegacyMesh["LEGACY MESH TIER (istio-system)"]
        IstioCP["Istio Control Plane<br/>STRICT mTLS"]
        KnativeGW["knative-ingress-gateway<br/>+ knative-local-gateway<br/>+ kserve-local-gateway<br/>Status: TRANSITIONAL"]
    end

    subgraph EgressSvc["EGRESS (External Services)"]
        S3["S3 Object Storage<br/>443/TCP HTTPS<br/>AWS IAM"]
        ContainerReg["Container Registry<br/>quay.io, registry.redhat.io<br/>443/TCP HTTPS, Pull secrets"]
        ExtProviders["External AI Providers<br/>API key, SigV4, OAuth2<br/>via ExternalProvider CRD"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>SA tokens"]
    end

    %% External → Ingress
    Clients -->|"HTTPS/443<br/>OAuth session, OIDC token"| DSGW
    Clients -->|"HTTPS/443<br/>API key or bearer token"| MaaSGW
    Clients -->|"HTTPS/443<br/>OAuth redirect"| LegacyRoutes

    %% Ingress auth chain
    DSGW -->|"ext_authz<br/>HTTP service mode"| KAP
    KAP -->|"validated identity<br/>x-forwarded-access-token"| DSGW

    %% Ingress → Application Tier
    DSGW -->|"HTTPRoute<br/>token forwarding"| Dashboard
    DSGW -->|"HTTPRoute<br/>token forwarding"| RegistryOp
    DSGW -->|"HTTPRoute"| Notebooks

    %% Ingress → User Tier (per-service routes)
    DSGW -->|"Per-IS HTTPRoute"| ModelPods
    MaaSGW -->|"Kuadrant AuthPolicy<br/>Authorino identity injection"| TenantInfra
    MaaSGW -->|"Per-tenant HTTPRoute"| ModelPods

    %% Operator → everything
    RhodsOp -->|"lifecycle mgmt"| AppTier
    RhodsOp -->|"provisions"| DSGW
    RhodsOp -->|"deploys"| KAP

    %% Application Tier internal
    Dashboard -->|"SA token"| KServeCtrl
    Dashboard -->|"SA token"| RegistryOp
    Dashboard -->|"SA token"| Notebooks
    KServeCtrl -->|"InferencePool<br/>ext-proc"| EPP
    KServeCtrl -->|"creates workloads"| ModelPods
    KServeCtrl -->|"creates workloads"| LlmdPods
    CodeflareOp -->|"manages"| TrainingJobs
    KueueCtrl -->|"scheduling gates"| TrainingJobs
    DSPOp -->|"reconciles DSPA"| PipelineRuns

    %% MaaS Tier
    MaaSCtrl -->|"watches"| AITenants
    MaaSCtrl -->|"bootstraps"| TenantInfra
    MaaSCtrl -->|"creates HTTPRoutes"| MaaSGW
    TenantInfra -->|"routes to"| ModelPods

    %% Egress
    ModelPods -->|"HTTPS/443<br/>AWS IAM"| S3
    PipelineRuns -->|"HTTPS/443<br/>AWS IAM"| S3
    Notebooks -->|"HTTPS/443<br/>AWS IAM"| S3
    KServeCtrl -->|"HTTPS/443<br/>Pull secret"| ContainerReg
    TenantInfra -->|"HTTPS/443<br/>Provider auth"| ExtProviders
    RhodsOp -->|"HTTPS/443<br/>SA token"| K8sAPI
    KServeCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI
    KueueCtrl -->|"HTTPS/443<br/>SA token"| K8sAPI

    %% Legacy path
    KnativeGW -->|"Istio mTLS<br/>legacy path"| ModelPods

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#e6ccff,stroke:#9673a6,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef maas fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef user fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef legacy fill:#f0f0f0,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Clients external
    class DSGW,MaaSGW,KAP,LegacyRoutes ingress
    class RhodsOp operator
    class Dashboard,KServeCtrl,EPP,KueueCtrl,DSPOp,CodeflareOp,RegistryOp,OtherOps app
    class MaaSCtrl,AITenants,TenantInfra maas
    class ModelPods,LlmdPods,Notebooks,PipelineRuns,TrainingJobs user
    class IstioCP,KnativeGW legacy
    class S3,ContainerReg,ExtProviders,K8sAPI egress
