graph TB
    subgraph WVA["Workload Variant Autoscaler (WVA)"]
        direction TB
        Manager["WVA Controller Manager<br/>(controller-runtime)"]

        subgraph Reconcilers["Reconcilers"]
            HPARec["HPA Reconciler<br/>watches llm-d.ai/managed=true"]
            SORec["ScaledObject Reconciler<br/>watches llm-d.ai/managed=true"]
            IPRec["InferencePool Reconciler<br/>watches InferencePool CRs"]
            CMRec["ConfigMap Reconciler<br/>watches labeled ConfigMaps"]
        end

        subgraph Engines["Engine Loops"]
            SatEngine["Saturation Engine<br/>(main optimization loop)"]
            SFZEngine["Scale-from-Zero Engine<br/>(100ms polling)"]
            Coordinator["Coordinator (experimental)<br/>(leader-elected, 15s tick)"]
        end

        subgraph Analyzers["Pluggable Analyzers"]
            SatV2["Saturation V2 Analyzer<br/>token-based capacity<br/>(k1 memory, k2 compute)"]
            QMAnalyzer["Queueing Model Analyzer<br/>SLO-driven Kalman filter"]
            ThrAnalyzer["Throughput Analyzer<br/>ITL(k) OLS regression"]
        end

        subgraph Optimizers["Optimizer Pipeline"]
            CostAware["CostAware Optimizer<br/>cheapest capacity first"]
            GreedyScore["GreedyByScore Optimizer<br/>GPU-constrained fair-sharing"]
        end

        subgraph Limiters["GPU Limiters"]
            InvLimiter["Inventory Limiter<br/>physical GPU discovery"]
            QuotaLimiter["Quota Limiter<br/>per-GPU-type quotas"]
        end

        GPUPlugin["GPU Rebalance Plugin"]
    end

    Manager --> HPARec
    Manager --> SORec
    Manager --> IPRec
    Manager --> CMRec
    Manager --> SatEngine
    Manager --> SFZEngine
    Manager --> Coordinator

    SatEngine --> SatV2
    SatEngine --> QMAnalyzer
    SatEngine --> ThrAnalyzer
    SatEngine --> CostAware
    SatEngine --> GreedyScore
    GreedyScore --> InvLimiter
    GreedyScore --> QuotaLimiter
    Coordinator --> GPUPlugin

    %% External interactions
    User["Platform Admin"] -->|"creates annotated<br/>HPA/ScaledObject"| HPARec
    VAICR["VariantAutoscaling<br/>(in-memory, synthesized)"] -.->|"synthesized from"| HPARec
    VAICR -.->|"synthesized from"| SORec

    SatEngine -->|"queries metrics"| Prometheus["Prometheus /<br/>Thanos Querier"]
    SFZEngine -->|"scrapes queue metrics"| EPP["Gateway API EPP"]
    SatEngine -->|"emits wva_desired_replicas"| Metrics["/metrics :8443"]
    HPA["HPA / KEDA"] -->|"reads external metric"| Metrics

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style SatEngine fill:#4a90e2,stroke:#333,color:#fff
    style SFZEngine fill:#4a90e2,stroke:#333,color:#fff
    style Coordinator fill:#4a90e2,stroke:#333,color:#fff
    style SatV2 fill:#7ed321,stroke:#333,color:#fff
    style QMAnalyzer fill:#7ed321,stroke:#333,color:#fff
    style ThrAnalyzer fill:#7ed321,stroke:#333,color:#fff
    style CostAware fill:#f5a623,stroke:#333,color:#fff
    style GreedyScore fill:#f5a623,stroke:#333,color:#fff
    style InvLimiter fill:#bd10e0,stroke:#333,color:#fff
    style QuotaLimiter fill:#bd10e0,stroke:#333,color:#fff
    style GPUPlugin fill:#bd10e0,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style EPP fill:#e8e8e8,stroke:#333
    style HPA fill:#e8e8e8,stroke:#333
    style VAICR fill:#f5a623,stroke:#333
