graph TB
    subgraph WVA["Workload Variant Autoscaler"]
        direction TB

        subgraph ControlPlane["Controller Manager"]
            Controller["WVA Controller Manager<br/>(controller-runtime)"]
            HPAReconciler["HPA Reconciler"]
            SOReconciler["ScaledObject Reconciler"]
            CMReconciler["ConfigMap Reconciler"]
            IPReconciler["InferencePool Reconciler"]
            Controller --> HPAReconciler
            Controller --> SOReconciler
            Controller --> CMReconciler
            Controller --> IPReconciler
        end

        subgraph Engines["Optimization Engines"]
            SatV1["Saturation Engine V1<br/>(Percentage-based)"]
            SatV2["Saturation Engine V2<br/>(Token-capacity)"]
            QueueModel["Queueing Model Engine<br/>(M/M/1/K Theory)"]
            ScaleZero["Scale-from-Zero Engine"]
            Throughput["Throughput Analyzer"]
        end

        subgraph Pipeline["Analysis Pipeline"]
            Analyzer["Analyzers"] --> Optimizer["Optimizer<br/>(Greedy / Cost-aware)"]
            Optimizer --> Limiter["Limiter<br/>(GPU Inventory / Quota)"]
            Limiter --> Enforcer["Enforcer<br/>(Safety Policies)"]
        end

        subgraph DataCollection["Metrics Collection"]
            Collector["Metrics Collector"]
            PromSource["Prometheus Source"]
            PodScraper["Pod Scraping Source"]
            LRUCache["LRU Cache<br/>(4096 entries)"]
            Collector --> PromSource
            Collector --> PodScraper
            Collector --> LRUCache
        end

        subgraph Experimental["Experimental"]
            Coordinator["Coordinator<br/>(Leader-elected)"]
            GPURebalance["GPU Rebalance Plugin"]
            Coordinator --> GPURebalance
        end

        Controller --> Engines
        Engines --> Pipeline
        Collector --> Engines
    end

    %% External CRDs watched
    HPA["HorizontalPodAutoscaler<br/>(autoscaling/v2)<br/>annotation: llm-d.ai/managed"]
    ScaledObject["KEDA ScaledObject<br/>(keda.sh/v1alpha1)<br/>annotation: llm-d.ai/managed"]
    InferencePool["InferencePool CR<br/>(inference.networking.k8s.io)"]
    ConfigMap["ConfigMap<br/>(saturation thresholds,<br/>scale-to-zero settings)"]
    VariantAutoscaling["VariantAutoscaling CR<br/>(llmd.ai/v1alpha1)"]

    HPA -->|watched by| HPAReconciler
    ScaledObject -->|watched by| SOReconciler
    InferencePool -->|watched by| IPReconciler
    ConfigMap -->|watched by| CMReconciler

    %% Outputs
    Enforcer -->|emit| DesiredReplicas["wva_desired_replicas<br/>(Prometheus gauge)"]
    ScaleZero -->|direct patch| DeploymentScale["Deployment/LWS<br/>Scale Subresource"]

    %% External dependencies
    Prometheus["Prometheus / Thanos Querier"]
    K8sAPI["Kubernetes API Server"]

    PromSource -->|PromQL queries| Prometheus
    PodScraper -->|HTTP scrape| InferencePods["vLLM / SGLang Pods"]
    Controller -->|watch/list/update| K8sAPI

    %% Styling
    style WVA fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style ControlPlane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Engines fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Pipeline fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style DataCollection fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Experimental fill:#e1d5e7,stroke:#9673a6,stroke-width:2px,stroke-dasharray: 5 5
    style Controller fill:#4a90e2,color:#fff
    style DesiredReplicas fill:#f5a623,stroke:#333
    style HPA fill:#f5a623,stroke:#333
    style ScaledObject fill:#f5a623,stroke:#333
    style InferencePool fill:#f5a623,stroke:#333
    style VariantAutoscaling fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style K8sAPI fill:#999,stroke:#333
    style InferencePods fill:#999,stroke:#333
