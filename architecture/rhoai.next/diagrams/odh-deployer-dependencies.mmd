graph LR
    ODHDeployer["odh-deployer<br/>Init Container"]

    %% External Dependencies
    ODHDeployer -->|"CLI operations<br/>6443/TCP HTTPS"| OC["oc CLI<br/>(embedded)"]
    ODHDeployer -->|"random/hash generation"| OpenSSL["openssl<br/>(embedded)"]
    ODHDeployer -->|"component manifests"| Manifests["odh-manifests.tar.gz<br/>(bundled)"]
    ODHDeployer -->|"target cluster<br/>6443/TCP HTTPS"| OpenShift["OpenShift 4.x Cluster"]

    %% Internal RHOAI Dependencies
    ODHDeployer -->|"creates KfDef CRs<br/>triggers reconciliation"| RHODSOp["rhods-operator"]
    ODHDeployer -->|"creates Route/Service<br/>probe target"| Dashboard["odh-dashboard"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| NBC["odh-notebook-controller"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| ModelCtrl["odh-model-controller"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| MMesh["modelmesh-controller"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| DSPO["data-science-pipelines-operator"]

    %% Deployment mode detection
    ODHDeployer -.->|"checks existence for<br/>managed vs self-managed"| AddonCatalog["addon-managed-odh-catalog<br/>(CatalogSource)"]

    %% Monitoring integrations
    ODHDeployer -->|"metrics federation<br/>9091/TCP HTTPS"| ClusterProm["Cluster Prometheus<br/>(openshift-monitoring)"]
    ODHDeployer -->|"operator metrics<br/>8383/TCP HTTP"| RHODSMetrics["rhods-operator-metrics"]

    %% External services (managed mode)
    ODHDeployer -.->|"critical alerts<br/>443/TCP HTTPS"| PD["PagerDuty API"]
    ODHDeployer -.->|"heartbeat<br/>443/TCP HTTPS"| DMS["Dead Man's Snitch"]
    ODHDeployer -.->|"notifications<br/>SMTP/STARTTLS"| SMTP["SMTP Server"]

    %% Reverse dependencies (what depends on odh-deployer)
    Console["OpenShift Console"] -->|"ConsoleLink CR<br/>App Launcher"| ODHDeployer

