graph LR
    ODHDeployer["odh-deployer<br/>(Deployment Container)"]

    %% External Dependencies
    ODHDeployer -->|"oc CLI operations<br/>6443/TCP HTTPS"| OAPI["OpenShift API<br/>Server"]
    ODHDeployer -->|"base image"| UBI["UBI 8 Minimal<br/>registry.access.redhat.com"]
    ODHDeployer -->|"monitoring stack"| PromImg["ose-prometheus<br/>registry.redhat.io"]
    ODHDeployer -->|"alert routing"| AMImg["ose-prometheus-alertmanager<br/>registry.redhat.io"]
    ODHDeployer -->|"auth sidecar"| OAuthImg["ose-oauth-proxy<br/>registry.redhat.io"]
    ODHDeployer -->|"endpoint probing"| BBImg["prometheus-blackbox-exporter<br/>quay.io/integreatly"]

    %% Internal Platform Dependencies
    ODHDeployer -->|"KfDef CR creation<br/>triggers deployment"| ODHOperator["opendatahub Operator"]
    ODHDeployer -->|"Route + health probe<br/>8443/TCP HTTPS"| Dashboard["rhods-dashboard"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| NBC["odh-notebook-controller"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| ModelCtrl["odh-model-controller"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| ModelMesh["modelmesh-controller"]
    ODHDeployer -->|"metrics scraping<br/>8080/TCP HTTP"| DSPO["data-science-pipelines-operator"]
    ODHDeployer -->|"operator metrics<br/>8383/TCP HTTP"| RhodsOp["rhods-operator"]
    ODHDeployer -->|"federation<br/>9091/TCP HTTPS"| ClusterProm["prometheus-k8s<br/>(openshift-monitoring)"]
    ODHDeployer -.->|"mode detection<br/>CatalogSource check"| AddonCatalog["addon-managed-odh-catalog"]

    %% Integration Points (components that integrate with odh-deployer)
    OpenShiftConsole["OpenShift Console"] -->|"ConsoleLink CR"| ODHDeployer

    %% External SaaS (managed service only)
    ODHDeployer -->|"critical alerts<br/>443/TCP HTTPS"| PD["PagerDuty API"]
    ODHDeployer -->|"liveness heartbeat<br/>443/TCP HTTPS"| DMS["Dead Man's Snitch"]
    ODHDeployer -->|"email notifications<br/>SMTP STARTTLS"| SMTP["SMTP Server"]

    style ODHDeployer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

