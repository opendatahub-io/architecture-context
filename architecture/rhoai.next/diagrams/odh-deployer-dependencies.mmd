graph LR
    ODHDeployer["odh-deployer<br/>(Init Container)"]

    %% External Dependencies
    ODHDeployer -->|"cluster operations"| OC["oc CLI<br/>(latest)"]
    ODHDeployer -->|"target cluster"| OpenShift["OpenShift 4.x"]
    ODHDeployer -->|"component manifests"| Manifests["odh-manifests.tar.gz<br/>(bundled)"]
    ODHDeployer -->|"secret generation"| OpenSSL["openssl"]

    %% Internal Platform Dependencies
    ODHDeployer -->|"KfDef CRs watched"| Operator["rhods-operator"]
    ODHDeployer -->|"route + health probe"| Dashboard["odh-dashboard"]
    ODHDeployer -->|"metrics scraping"| NBC["odh-notebook-controller"]
    ODHDeployer -->|"metrics scraping"| ModelCtrl["odh-model-controller"]
    ODHDeployer -->|"metrics scraping"| ModelMesh["modelmesh-controller"]
    ODHDeployer -->|"metrics scraping"| DSPO["data-science-pipelines-operator"]

    %% Mode detection
    ODHDeployer -.->|"mode detection"| AddonCatalog["addon-managed-odh<br/>CatalogSource"]

    %% Integration Points (consumers)
    Console["OpenShift Console"] -->|"ConsoleLink CR"| ODHDeployer
    ClusterProm["Cluster Prometheus<br/>(openshift-monitoring)"] -->|"federation source"| ODHDeployer

    %% External Services (managed mode)
    ODHDeployer -.->|"critical alerts"| PagerDuty["PagerDuty API"]
    ODHDeployer -.->|"heartbeat"| DMS["Dead Man's Snitch"]
    ODHDeployer -.->|"email alerts"| SMTPSvc["SMTP Server"]

    style ODHDeployer fill:#4a90e2,stroke:#333,stroke-width:4px

    %% External dependencies styling
    style OC fill:#999,stroke:#333
    style OpenShift fill:#999,stroke:#333
    style Manifests fill:#999,stroke:#333
    style OpenSSL fill:#999,stroke:#333

    %% Internal platform styling
    style Operator fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style NBC fill:#7ed321,stroke:#333
    style ModelCtrl fill:#7ed321,stroke:#333
    style ModelMesh fill:#7ed321,stroke:#333
    style DSPO fill:#7ed321,stroke:#333
    style AddonCatalog fill:#7ed321,stroke:#333

    %% Consumer styling
    style Console fill:#7ed321,stroke:#333
    style ClusterProm fill:#7ed321,stroke:#333

    %% External services styling
    style PagerDuty fill:#f5a623,stroke:#333
    style DMS fill:#f5a623,stroke:#333
    style SMTPSvc fill:#f5a623,stroke:#333
