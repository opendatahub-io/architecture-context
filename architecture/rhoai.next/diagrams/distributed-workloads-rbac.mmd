graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["jupyter-nb-kube-3aadmin<br/>(dynamic, per-test namespace)"]
    end

    subgraph RoleBindings["Role Bindings (Dynamic, per-test)"]
        RB["(dynamic) RoleBinding<br/>Namespace: test-ns-*"]
    end

    subgraph Roles["Roles (Dynamic, per-test)"]
        Role["(dynamic) Role<br/>Created by test framework"]
    end

    subgraph APIResources["API Resources"]
        subgraph TrainerAPI["trainer.kubeflow.org"]
            CTR["ClusterTrainingRuntime"]
        end

        subgraph CoreAPI["core (v1)"]
            Pods["Pods"]
            PodsLog["Pods/log"]
            ConfigMaps["ConfigMaps"]
            Secrets["Secrets"]
            ServiceAccounts["ServiceAccounts"]
            PVCs["PersistentVolumeClaims"]
        end

        subgraph BatchAPI["batch"]
            Jobs["Jobs"]
        end

        subgraph KubeflowAPI["kubeflow.org"]
            PyTorchJobs["PyTorchJobs"]
        end

        subgraph RayAPI["ray.io"]
            RayJobs["RayJobs"]
            RayClusters["RayClusters"]
        end

        subgraph KueueAPI["kueue.x-k8s.io"]
            ResourceFlavors["ResourceFlavors"]
            ClusterQueues["ClusterQueues"]
            LocalQueues["LocalQueues"]
            Workloads["Workloads"]
        end
    end

    %% Bindings
    SA -->|"bound via"| RB
    RB -->|"grants"| Role

    %% Permissions
    Role -->|"get, list, watch"| CTR
    Role -->|"get, list, create, delete"| Pods
    Role -->|"get, list, create, delete"| PodsLog
    Role -->|"get, list, create, delete"| ConfigMaps
    Role -->|"get, list, create, delete"| Secrets
    Role -->|"get, list, create, delete"| ServiceAccounts
    Role -->|"get, list, create, delete"| PVCs
    Role -->|"get, create, delete"| Jobs
    Role -->|"get, list, create, watch"| PyTorchJobs
    Role -->|"get, list, create"| RayJobs
    Role -->|"get, list, create"| RayClusters
    Role -->|"get, list, create"| ResourceFlavors
    Role -->|"get, list, create"| ClusterQueues
    Role -->|"get, list, create"| LocalQueues
    Role -->|"get, list, create"| Workloads

    %% Note about dynamic nature
    Note["⚠️ All RBAC is dynamic:<br/>Created per-test, cleaned up after.<br/>No static ClusterRoles in manifests."]

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#9b59b6,stroke:#333,color:#fff
    style Role fill:#f5a623,stroke:#333,color:#fff
    style CTR fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style PodsLog fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style ServiceAccounts fill:#7ed321,stroke:#333
    style PVCs fill:#7ed321,stroke:#333
    style Jobs fill:#7ed321,stroke:#333
    style PyTorchJobs fill:#7ed321,stroke:#333
    style RayJobs fill:#7ed321,stroke:#333
    style RayClusters fill:#7ed321,stroke:#333
    style ResourceFlavors fill:#7ed321,stroke:#333
    style ClusterQueues fill:#7ed321,stroke:#333
    style LocalQueues fill:#7ed321,stroke:#333
    style Workloads fill:#7ed321,stroke:#333
    style Note fill:#fff3cd,stroke:#856404,color:#856404
