graph TD
    subgraph "Example/Workshop RBAC Only"
        direction TB

        subgraph "Stable Diffusion Example"
            SA1["ServiceAccount<br/>stable-diffusion-nb"]
            RB1["RoleBinding<br/>edit"]
            CR1["ClusterRole<br/>edit"]

            SA1 -->|"bound via"| RB1
            RB1 -->|"grants"| CR1
        end

        subgraph "NFS Server Example"
            SA2["ServiceAccount<br/>nfs-server-sa"]
            RB2["RoleBinding<br/>nfs-server-sa-anyuid"]
            RB3["RoleBinding<br/>nfs-server-sa-privileged"]
            CR2["ClusterRole<br/>system:openshift:scc:anyuid"]
            CR3["ClusterRole<br/>system:openshift:scc:privileged"]

            SA2 -->|"bound via"| RB2
            SA2 -->|"bound via"| RB3
            RB2 -->|"grants"| CR2
            RB3 -->|"grants"| CR3
        end

        subgraph "SCC Capabilities"
            Anyuid["SCC: anyuid<br/>Run as any UID"]
            Privileged["SCC: privileged<br/>Full host access"]
        end

        CR2 -->|"enables"| Anyuid
        CR3 -->|"enables"| Privileged
    end

    subgraph "Test Suite Runtime RBAC"
        direction TB

        TestSA["Test ServiceAccount<br/>(auto-created per namespace)"]
        TestPerms["Permissions<br/>(inherited from test framework)"]

        TestSA -->|"uses"| TestPerms

        subgraph "Consumed CRD Access"
            PyTorchJob["kubeflow.org<br/>PyTorchJob<br/>get, list, watch,<br/>create, delete"]
            TrainJob["kubeflow.org<br/>TrainJob<br/>get, list, watch,<br/>create, delete"]
            RayCluster["ray.io<br/>RayCluster<br/>get, list, watch,<br/>create, delete"]
            RayJob["ray.io<br/>RayJob<br/>get, list, watch,<br/>create, delete"]
            KueueRes["kueue.x-k8s.io<br/>ClusterQueue, LocalQueue,<br/>ResourceFlavor<br/>get, list, watch,<br/>create, delete"]
        end

        TestPerms -->|"CRD operations"| PyTorchJob
        TestPerms -->|"CRD operations"| TrainJob
        TestPerms -->|"CRD operations"| RayCluster
        TestPerms -->|"CRD operations"| RayJob
        TestPerms -->|"CRD operations"| KueueRes
    end

    Note["Note: This repository defines NO custom<br/>ClusterRoles. All RBAC shown is from<br/>example/workshop resources or test runtime."]

    style SA1 fill:#4a90e2,color:#fff
    style SA2 fill:#4a90e2,color:#fff
    style TestSA fill:#4a90e2,color:#fff
    style CR1 fill:#f5a623,color:#fff
    style CR2 fill:#f5a623,color:#fff
    style CR3 fill:#f5a623,color:#fff
    style PyTorchJob fill:#7ed321,color:#fff
    style TrainJob fill:#7ed321,color:#fff
    style RayCluster fill:#7ed321,color:#fff
    style RayJob fill:#7ed321,color:#fff
    style KueueRes fill:#7ed321,color:#fff
    style Anyuid fill:#e74c3c,color:#fff
    style Privileged fill:#e74c3c,color:#fff
    style Note fill:#fff3cd,stroke:#856404
