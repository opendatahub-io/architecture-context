graph TD
    subgraph DynamicRBAC["Dynamic RBAC (Per-Test Ephemeral)"]
        direction TB

        subgraph TestExecution["Test Execution Context"]
            TestFramework["E2E Test Framework<br/>(Go test suite)"]
            HelperFuncs["support/rbac.go<br/>Helper Functions"]
            TestFramework -->|"calls"| HelperFuncs
        end

        subgraph CreatedPerTest["Created Per Test (Ephemeral)"]
            direction TB

            subgraph ServiceAccounts["Service Accounts"]
                TestSA["test-{name}-sa<br/>Namespace: test-{uuid}"]
            end

            subgraph Roles["Roles / ClusterRoles"]
                PodLogRole["Role: pod-log-access<br/>Verbs: get, list, watch"]
                SecretRole["Role: secret-access<br/>Verbs: get, list"]
                CRDRole["ClusterRole: crd-{test}-role<br/>Verbs: get, list, watch,<br/>create, update, patch, delete"]
            end

            subgraph Bindings["RoleBindings / ClusterRoleBindings"]
                PodLogBinding["RoleBinding:<br/>pod-log-access-binding"]
                SecretBinding["RoleBinding:<br/>secret-access-binding"]
                CRDBinding["ClusterRoleBinding:<br/>crd-{test}-binding"]
            end
        end

        HelperFuncs -->|"creates"| TestSA
        HelperFuncs -->|"creates"| PodLogRole
        HelperFuncs -->|"creates"| SecretRole
        HelperFuncs -->|"creates"| CRDRole
        HelperFuncs -->|"creates"| PodLogBinding
        HelperFuncs -->|"creates"| SecretBinding
        HelperFuncs -->|"creates"| CRDBinding

        TestSA -->|"bound via"| PodLogBinding
        TestSA -->|"bound via"| SecretBinding
        TestSA -->|"bound via"| CRDBinding

        PodLogBinding -->|"grants"| PodLogRole
        SecretBinding -->|"grants"| SecretRole
        CRDBinding -->|"grants"| CRDRole
    end

    subgraph APIResources["API Resources Accessed"]
        direction TB
        PyTorchJob["kubeflow.org/v1<br/>PyTorchJob"]
        TrainJob["trainer.kubeflow.org/v1alpha1<br/>TrainJob"]
        RayJob["ray.io/v1<br/>RayJob, RayCluster"]
        ClusterQueue["kueue.x-k8s.io/v1beta2<br/>ClusterQueue, LocalQueue"]
        JobSetRes["jobset.x-k8s.io/v1alpha2<br/>JobSet"]
        Pods["core<br/>Pods, Pods/log"]
        Secrets["core<br/>Secrets"]
        Services["core<br/>Services"]
        Routes["route.openshift.io/v1<br/>Routes"]
        Notebooks["kubeflow.org/v1<br/>Notebooks"]
    end

    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| PyTorchJob
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| TrainJob
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| RayJob
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| ClusterQueue
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| JobSetRes
    PodLogRole -->|"get,list,watch"| Pods
    SecretRole -->|"get,list"| Secrets
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| Services
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| Routes
    CRDRole -->|"get,list,watch,create,<br/>update,patch,delete"| Notebooks

    subgraph Lifecycle["Lifecycle"]
        Create["Test Start:<br/>Create RBAC"]
        Cleanup["Test End:<br/>Delete namespace<br/>(cascading cleanup)"]
        Create --> Cleanup
    end

    %% Styling
    style DynamicRBAC fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style TestExecution fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style CreatedPerTest fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style APIResources fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Lifecycle fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    style TestSA fill:#4a90e2,color:#fff
    style PodLogRole fill:#f5a623,color:#fff
    style SecretRole fill:#f5a623,color:#fff
    style CRDRole fill:#f5a623,color:#fff
    style PyTorchJob fill:#7ed321,color:#fff
    style TrainJob fill:#7ed321,color:#fff
    style RayJob fill:#7ed321,color:#fff
    style ClusterQueue fill:#7ed321,color:#fff
    style JobSetRes fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style Secrets fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style Routes fill:#7ed321,color:#fff
    style Notebooks fill:#7ed321,color:#fff
