graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / kubectl"]
    end

    subgraph K8sControl["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph ControllerPod["Controller Manager Pod"]
            Controller["ogx-k8s-operator<br/>SA: ogx-k8s-operator-controller-manager"]
            WebhookServer["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (OpenShift profile)"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No auth"]
            KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS (service-ca)<br/>TokenReview + SAR"]
        end

        WebhookSvc["webhook-service<br/>ClusterIP 443 to 9443"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACE (user namespace)"]
        OGXPod["OGX Server Pod<br/>8080/TCP HTTP"]
        NetPol["NetworkPolicy<br/>(operator-managed)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>ServiceMonitor-driven"]
    end

    subgraph PlatformTier["PLATFORM TIER"]
        Module["ogx-module controller<br/>SA: operator"]
    end

    subgraph CertProviders["CERTIFICATE PROVIDERS"]
        ServiceCA["OpenShift service-ca<br/>Auto-provision TLS certs"]
        CertManager["cert-manager<br/>(non-OpenShift)"]
        TLSProfile["OpenShift TLS Profile<br/>config.openshift.io/apiserver"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| APIServer

    %% API Server to Webhook
    APIServer -->|"HTTPS/9443<br/>TLS (OpenShift profile)<br/>Admission validation<br/>failurePolicy: Fail"| WebhookSvc
    WebhookSvc --> WebhookServer

    %% Controller to API Server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>Server-side apply"| APIServer

    %% Controller to workload
    Controller -->|"HTTP/8080<br/>Version check"| OGXPod

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer token"| MetricsSvc
    MetricsSvc --> KubeRBACProxy
    KubeRBACProxy -->|"TokenReview + SAR"| APIServer

    %% Platform tier
    Module -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>Deploy operator"| APIServer

    %% Certificate flows
    ServiceCA -.->|"Auto-provision"| MetricsSvc
    ServiceCA -.->|"Auto-provision"| WebhookSvc
    CertManager -.->|"Provision (non-OCP)"| WebhookSvc
    TLSProfile -.->|"TLS config"| Controller

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#dce6f0,stroke:#4a6fa5,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef certprovider fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5

    class User external
    class APIServer apiserver
    class Controller,WebhookServer,HealthProbes,KubeRBACProxy,WebhookSvc,MetricsSvc operator
    class OGXPod,NetPol workload
    class Prometheus monitoring
    class Module platform
    class ServiceCA,CertManager,TLSProfile certprovider
