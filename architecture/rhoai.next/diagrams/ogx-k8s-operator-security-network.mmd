graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
        OCIReg["OCI Container Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Anonymous/Token"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        OSAPI["OpenShift API Server<br/>(config.openshift.io)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(redhat-ods-applications)"]
        direction TB

        subgraph ModulePod["ogx-module Pod"]
            Module["ogx-module<br/>SA: controller-manager<br/>8081/TCP health (HTTP)<br/>8080/TCP metrics (HTTP)"]
        end

        subgraph OperatorPod["ogx-k8s-operator Pod"]
            Operator["OGX Controller<br/>SA: controller-manager<br/>8081/TCP health (HTTP)"]
            Webhook["Validating Webhook<br/>9443/TCP HTTPS<br/>TLS (service-ca)<br/>mTLS"]
            MetricsSrc["Metrics Server<br/>8080/TCP HTTP<br/>bound to 127.0.0.1"]
            RBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS<br/>TokenReview + SAR"]
            MetricsSrc -.->|localhost| RBACProxy
        end

        WebhookSvc["webhook-service<br/>ClusterIP 443→9443"]
        MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8443→8443"]
    end

    subgraph UserNS["USER NAMESPACE (per-tenant)"]
        direction TB

        subgraph OGXPod["OGX Server Pod"]
            OGXServer["OGX Distribution Server<br/>SA: {instance}-sa<br/>8321/TCP API (HTTP)<br/>9464/TCP metrics (HTTP, optional)"]
        end

        InstanceSvc["{instance}-service<br/>ClusterIP 8321, 9464"]
        NetPol["NetworkPolicy<br/>Ingress: same-ns + operator-ns<br/>Egress: all (default)"]
        OptIngress["{instance}-ingress<br/>80/TCP HTTP (optional)"]
    end

    subgraph OptBackends["OPTIONAL EXTERNAL BACKENDS"]
        Redis["Redis<br/>6379/TCP<br/>Password Auth<br/>Configurable TLS"]
        Postgres["PostgreSQL<br/>5432/TCP<br/>Connection String<br/>Configurable TLS"]
    end

    %% External → Control Plane
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig"| K8sAPI

    %% Control Plane → Operator (Webhook)
    K8sAPI -->|"HTTPS/9443<br/>TLS (service-ca)<br/>mTLS"| Webhook

    %% Module → Control Plane
    Module -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Operator → Control Plane
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| OSAPI

    %% Operator → External
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>Anonymous/Token"| OCIReg

    %% Operator → User Namespace
    Operator -->|"HTTP/8321<br/>No Encryption<br/>No Auth"| OGXServer

    %% OGX Server → Optional Backends
    OGXServer -.->|"TCP/6379<br/>Password"| Redis
    OGXServer -.->|"TCP/5432<br/>Conn String"| Postgres

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef backends fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class User,OCIReg external
    class K8sAPI,OSAPI controlplane
    class Module,Operator,Webhook,MetricsSrc,RBACProxy operatorns
    class OGXServer userns
    class Redis,Postgres backends
    class WebhookSvc,MetricsSvc,InstanceSvc,NetPol,OptIngress service
