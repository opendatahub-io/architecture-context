graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM LAYER (KServe-managed)"]
        KServeRouter["KServe Router / Gateway<br/>Platform Auth Enforcement"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT)"]
        direction TB

        subgraph IstioLayer["Istio Sidecar"]
            Sidecar["Envoy Proxy<br/>mTLS / AuthorizationPolicy<br/>kube-rbac-proxy"]
        end

        subgraph PodBoundary["vllm-spyre Pod (UID 2000)"]
            TGIS["vllm_tgis_adapter<br/>gRPC :8033/TCP<br/>No native auth"]
            VLLM["vLLM HTTP API<br/>HTTP :8000/TCP<br/>No native auth"]
            SpyreSDK["IBM Spyre SDK<br/>Device plugin access"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelStore["Model Storage<br/>S3: HTTPS/443, TLS 1.2+, IAM<br/>PVC: NFS, no encryption"]
        SpyreDevice["IBM Spyre Accelerator<br/>Kernel/driver interface<br/>Device plugin"]
    end

    %% Flows
    Client -->|"Protocol: varies<br/>Auth: platform-managed"| KServeRouter
    KServeRouter -->|"gRPC/8033 or HTTP/8000<br/>mTLS STRICT<br/>Platform auth enforced"| Sidecar
    Sidecar -->|"gRPC/8033<br/>localhost<br/>No encryption"| TGIS
    Sidecar -->|"HTTP/8000<br/>localhost<br/>No encryption"| VLLM
    VLLM -->|"HTTPS/443 or NFS<br/>TLS 1.2+<br/>IAM / None"| ModelStore
    SpyreSDK -->|"Kernel/driver<br/>Device plugin<br/>N/A"| SpyreDevice

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef pod fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class KServeRouter platform
    class Sidecar servicemesh
    class TGIS,VLLM,SpyreSDK pod
    class ModelStore,SpyreDevice externalservice
