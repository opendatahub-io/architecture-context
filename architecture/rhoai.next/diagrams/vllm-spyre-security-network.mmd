graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Application"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        KServeRouter["KServe Router /<br/>Istio Gateway<br/>443/TCP<br/>TLS 1.2+"]
    end

    subgraph Pod["KServe ServingRuntime Pod<br/>Namespace: {user-namespace}"]
        subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
            KRBP["kube-rbac-proxy<br/>8443/TCP (HTTPS)<br/>TLS 1.2+<br/>Bearer Token validation"]
        end

        subgraph InferenceContainer["INFERENCE CONTAINER<br/>UID: 2000 (non-root)<br/>HF_HUB_OFFLINE=1"]
            HTTPEndpoint["HTTP API<br/>8000/TCP<br/>Plaintext (localhost)<br/>/v1/completions<br/>/v1/chat/completions<br/>/v1/models<br/>/health"]
            GRPCEndpoint["gRPC API<br/>8033/TCP<br/>Plaintext (localhost)<br/>TGIS GenerationService"]
            Engine["vLLM Engine<br/>+ vllm_tgis_adapter"]
        end

        subgraph HWAccess["HARDWARE"]
            Spyre["IBM Spyre<br/>Accelerator<br/>(device plugin)"]
        end
    end

    subgraph ModelStore["MODEL STORAGE"]
        PVC["PVC / Local Storage<br/>Model Weights<br/>(filesystem mount)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| KServeRouter
    KServeRouter -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token"| KRBP
    KRBP -->|"HTTP/8000<br/>Plaintext (localhost)<br/>Pre-authenticated"| HTTPEndpoint
    KRBP -->|"gRPC/8033<br/>Plaintext (localhost)<br/>Pre-authenticated"| GRPCEndpoint
    HTTPEndpoint --> Engine
    GRPCEndpoint --> Engine
    Engine --> Spyre
    PVC -.->|"Volume Mount<br/>Filesystem"| Engine

    %% Egress note
    NoEgress["No Egress<br/>(HF_HUB_OFFLINE=1)"]
    style NoEgress fill:#ffcccc,stroke:#cc0000,stroke-width:1px,stroke-dasharray: 5 5

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authboundary fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef inference fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hardware fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class KServeRouter ingress
    class KRBP authboundary
    class HTTPEndpoint,GRPCEndpoint,Engine inference
    class Spyre hardware
    class PVC storage
