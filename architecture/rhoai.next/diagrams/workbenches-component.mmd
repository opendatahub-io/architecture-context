graph TB
    subgraph Workbenches["Workbenches Component"]
        direction TB

        subgraph ControllerTier["Controller Tier"]
            Controller["workspaces-controller<br/>Go Controller<br/>controller-runtime"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS"]
            Controller -->|validates via| Webhook
        end

        subgraph BackendTier["Backend Tier"]
            Backend["workspaces-backend<br/>Go API Server<br/>httprouter<br/>4000/TCP"]
        end

        subgraph FrontendTier["Frontend Tier"]
            Frontend["workspaces-frontend<br/>React SPA<br/>nginx<br/>8080/TCP"]
        end
    end

    User[Data Scientist] -->|browser| Frontend
    Frontend -->|REST API calls| Backend

    Backend -->|TokenReview| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Backend -->|SubjectAccessReview| K8sAPI
    Backend -->|CRUD Workspace CR| K8sAPI

    K8sAPI -->|admission webhook| Webhook

    WorkspaceCR["Workspace CR<br/>kubeflow.org/v1beta1<br/>Namespaced"]
    WorkspaceKindCR["WorkspaceKind CR<br/>kubeflow.org/v1beta1<br/>Cluster-scoped"]

    WorkspaceCR -->|watched by| Controller
    WorkspaceKindCR -->|referenced by| Controller

    Controller -->|creates| StatefulSet["StatefulSet"]
    Controller -->|creates| Service["Service"]
    Controller -->|creates| SA["ServiceAccount"]
    Controller -->|creates| RoleBinding["RoleBinding"]
    Controller -->|creates| IngressResource["HTTPRoute / VirtualService"]

    Controller -->|depends on| GatewayAPI["Gateway API<br/>data-science-gateway"]
    Controller -->|alternative| Istio["Istio<br/>VirtualServices"]
    Controller -->|injects sidecar| KubeRBACProxy["kube-rbac-proxy"]
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer CR"]

    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style Backend fill:#4a90e2,color:#fff
    style Frontend fill:#4a90e2,color:#fff
    style WorkspaceCR fill:#f5a623,color:#fff
    style WorkspaceKindCR fill:#f5a623,color:#fff
