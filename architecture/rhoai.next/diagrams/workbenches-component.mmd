graph TB
    subgraph "Workbenches Component (Kubeflow Notebooks v2)"
        direction TB

        subgraph Controller["workspaces-controller<br/>(Go Operator)"]
            ReconcileLoop["Reconcile Loop<br/>(controller-runtime)"]
            WebhookServer["Webhook Server<br/>9443/TCP TLS"]
            MetricsEndpoint["Metrics Endpoint<br/>8080/TCP"]
            HealthProbe["Health Probes<br/>8081/TCP"]
        end

        subgraph Backend["workspaces-backend<br/>(Go REST API)"]
            APIServer["REST API Server<br/>4000/TCP HTTP"]
            AuthMiddleware["Auth Middleware<br/>(SAR + Header-based)"]
            RepoLayer["Repository Layer<br/>(Workspaces, WorkspaceKinds,<br/>PVCs, Secrets, Namespaces)"]
        end

        subgraph Frontend["workspaces-frontend<br/>(React + PatternFly 6)"]
            NginxProxy["nginx<br/>8080/TCP HTTP"]
            ReactSPA["React SPA<br/>(TypeScript 5.8)"]
        end
    end

    %% CRDs
    WorkspaceCR["Workspace CR<br/>(kubeflow.org/v1beta1)<br/>Namespaced"]
    WorkspaceKindCR["WorkspaceKind CR<br/>(kubeflow.org/v1beta1)<br/>Cluster-scoped"]

    %% Created Resources
    StatefulSet["StatefulSet<br/>(per workspace)"]
    WorkspaceSvc["Service<br/>ws-{name}-{hash}"]
    VirtualSvc["VirtualService<br/>(per workspace, Istio)"]

    %% External Dependencies
    K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    IstioGW["Istio Ingress Gateway<br/>443/TCP HTTPS"]
    CertManager["cert-manager"]
    Prometheus["Prometheus"]

    %% User
    User["User Browser"]

    %% User flows
    User -->|HTTPS/443| IstioGW
    IstioGW -->|"/workspaces/"| NginxProxy
    IstioGW -->|"/workspaces/api/"| APIServer
    ReactSPA -->|API calls| APIServer

    %% Backend flows
    AuthMiddleware -->|SubjectAccessReview| K8sAPI
    APIServer --> AuthMiddleware
    AuthMiddleware --> RepoLayer
    RepoLayer -->|CRUD| K8sAPI

    %% Controller flows
    WorkspaceCR -->|watched by| ReconcileLoop
    WorkspaceKindCR -->|watched by| ReconcileLoop
    ReconcileLoop -->|creates| StatefulSet
    ReconcileLoop -->|creates| WorkspaceSvc
    ReconcileLoop -->|creates| VirtualSvc
    ReconcileLoop -->|CRUD| K8sAPI

    %% Webhook flows
    K8sAPI -->|admission review| WebhookServer
    WebhookServer -->|validates| WorkspaceCR
    WebhookServer -->|validates| WorkspaceKindCR

    %% Supporting integrations
    CertManager -->|provisions TLS cert| WebhookServer
    Prometheus -->|scrapes| MetricsEndpoint

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style Backend fill:#4a90e2,color:#fff
    style Frontend fill:#4a90e2,color:#fff
    style WorkspaceCR fill:#f5a623,color:#000
    style WorkspaceKindCR fill:#f5a623,color:#000
    style StatefulSet fill:#7ed321,color:#000
    style WorkspaceSvc fill:#7ed321,color:#000
    style VirtualSvc fill:#7ed321,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style IstioGW fill:#e8e8e8,color:#000
    style CertManager fill:#e8e8e8,color:#000
    style Prometheus fill:#e8e8e8,color:#000
