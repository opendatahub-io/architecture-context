graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph RuntimePod["RUNTIME POD (Pod Trust Boundary)"]
        direction TB

        OAuthProxy["oauth-proxy Sidecar<br/>8443/TCP HTTPS<br/>TLS: serving cert<br/>Auth: OpenShift SAR"]
        RESTProxy["REST Proxy<br/>8008/TCP HTTP<br/>No encryption<br/>⚠ No auth"]
        ModelMesh["ModelMesh Container<br/>8033/TCP gRPC<br/>Optional TLS/mTLS<br/>2112/TCP metrics"]
        ModelRuntime["Model Runtime<br/>(Triton/MLServer/OVMS)<br/>UDS/gRPC pod-local"]
        PullerSidecar["Puller Sidecar<br/>8086/TCP gRPC<br/>pod-local"]

        OAuthProxy -->|HTTP/8008<br/>localhost<br/>No encryption| RESTProxy
        RESTProxy -->|gRPC/8033<br/>REST→gRPC<br/>Optional TLS| ModelMesh
        ModelMesh -->|UDS/gRPC<br/>pod-local<br/>No encryption| ModelRuntime
        ModelMesh -->|gRPC/8086<br/>pod-local<br/>No encryption| PullerSidecar
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (RBAC Boundary)"]
        direction TB

        Controller["modelmesh-serving-controller<br/>SA: modelmesh-serving-sa<br/>8080/TCP metrics<br/>8081/TCP health"]
        WebhookServer["Webhook Server<br/>9443/TCP HTTPS<br/>TLS: cert-manager<br/>Auth: K8s API CA"]
        MetricsService["Controller Metrics<br/>8443/TCP HTTPS<br/>kube-rbac-proxy<br/>Auth: mTLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        etcd["etcd<br/>2379/TCP gRPC<br/>TLS (configurable)<br/>Auth: Client cert"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Bearer Token"]
        ObjectStorage["Object Storage<br/>(S3/GCS/PVC)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: storage-config Secret"]
    end

    %% External flows
    Client -->|HTTPS/8443<br/>TLS serving cert<br/>OpenShift SAR| OAuthProxy

    %% Controller flows
    Controller -->|gRPC/8033<br/>Optional TLS/mTLS<br/>SetVModel, DeleteVModel| ModelMesh
    Controller -->|HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token| K8sAPI

    %% ModelMesh to etcd
    ModelMesh -->|gRPC/2379<br/>TLS<br/>Client cert| etcd

    %% Puller to storage
    PullerSidecar -->|HTTPS/443<br/>TLS 1.2+<br/>Storage credentials| ObjectStorage

    %% Webhook
    K8sAPI -->|HTTPS/9443<br/>TLS cert-manager<br/>Admission Review| WebhookServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef runtimepod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controller fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class OAuthProxy,ModelMesh,ModelRuntime,PullerSidecar runtimepod
    class RESTProxy warning
    class Controller,WebhookServer,MetricsService controller
    class etcd,K8sAPI,ObjectStorage externalservice
