graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Inference Client"]
    end

    subgraph ControlPlane["CONTROL PLANE (Controller Namespace)"]
        direction TB
        Controller["modelmesh-controller<br/>SA: modelmesh-controller<br/>Ports: 8081, 9443, 9999"]
        WebhookSvc["modelmesh-webhook-server-service<br/>ClusterIP 9443/TCP<br/>TLS (cert-manager)<br/>Kubernetes Admission"]
    end

    subgraph InferencePlane["INFERENCE PLANE (Per-Namespace)"]
        direction TB

        subgraph RuntimePod["ModelMesh Runtime Pod"]
            MMSidecar["ModelMesh Sidecar<br/>gRPC (dynamic port)<br/>TLS configurable"]
            Adapter["modelmesh-runtime-adapter<br/>localhost gRPC"]
            RestProxy["REST Proxy<br/>8008/TCP HTTP<br/>KServe V2 REST-to-gRPC"]
            InferenceRT["Inference Runtime<br/>Triton / MLServer /<br/>OVMS / TorchServe"]
        end

        HeadlessSvc["Headless Service<br/>(dynamically created)"]
    end

    subgraph K8s["KUBERNETES API"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token + RBAC"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        etcd["etcd Cluster<br/>2379/TCP gRPC<br/>TLS (from Secret)<br/>Client cert / password"]
        ObjectStorage["Object Storage<br/>443/TCP HTTPS<br/>TLS<br/>Storage credentials"]
        CertManager["cert-manager<br/>Certificate provisioning"]
        Prometheus["prometheus-operator<br/>ServiceMonitor<br/>InsecureSkipVerify: true"]
    end

    %% External access
    Client -->|"gRPC (dynamic port)<br/>TLS optional<br/>Client cert optional"| HeadlessSvc
    HeadlessSvc --> MMSidecar

    %% Intra-pod communication (loopback)
    MMSidecar -->|"gRPC localhost<br/>No encryption"| Adapter
    MMSidecar -->|"gRPC localhost<br/>No encryption"| InferenceRT
    RestProxy -->|"gRPC localhost<br/>REST-to-gRPC translation"| MMSidecar

    %% Controller to K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    %% Controller to etcd
    Controller -->|"gRPC/2379<br/>TLS (from Secret)<br/>Client cert"| etcd

    %% Controller gRPC to ModelMesh
    Controller -->|"gRPC (dynamic)<br/>TLS (from Secret)<br/>Client cert"| MMSidecar

    %% ModelMesh to etcd
    MMSidecar -->|"gRPC/2379<br/>TLS (from Secret)<br/>Client cert"| etcd

    %% Runtime adapter to storage
    Adapter -->|"HTTPS/443<br/>TLS<br/>Storage credentials"| ObjectStorage

    %% Webhook
    APIServer -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>Admission"| WebhookSvc

    %% cert-manager
    CertManager -.->|"Provisions TLS cert"| WebhookSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inferenceplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Controller,WebhookSvc controlplane
    class MMSidecar,Adapter,RestProxy,InferenceRT,HeadlessSvc inferenceplane
    class APIServer k8s
    class etcd,ObjectStorage,CertManager,Prometheus externalservice
