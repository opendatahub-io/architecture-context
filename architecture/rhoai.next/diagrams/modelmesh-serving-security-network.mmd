graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph RuntimePod["RUNTIME POD (Multi-Container)"]
        direction TB

        subgraph AuthLayer["Authentication Layer"]
            OAuthProxy["oauth-proxy<br/>8443/TCP HTTPS<br/>TLS (model-serving-proxy-tls)<br/>OpenShift OAuth + SAR"]
        end

        subgraph DataPlane["Data Plane (localhost)"]
            RESTProxy["REST Proxy<br/>8008/TCP HTTP<br/>No encryption (loopback)<br/>KServe V2 translation"]
            MM["ModelMesh (mm)<br/>8033/TCP gRPC<br/>TLS (configurable)<br/>mTLS (configurable)"]
            ModelServer["Model Server<br/>8001/TCP or 7070/TCP gRPC<br/>No encryption (localhost)<br/>(Triton/MLServer/OVMS/TorchServe)"]
            Puller["Storage Helper/Puller<br/>Model artifact download"]
        end

        OAuthProxy -->|HTTP/8008<br/>localhost<br/>No auth| RESTProxy
        RESTProxy -->|gRPC/8033<br/>localhost/Unix socket<br/>No auth| MM
        MM -->|gRPC/8001 or 7070<br/>localhost<br/>No auth| ModelServer
        Puller -->|HTTP/8086<br/>localhost| ModelServer
    end

    subgraph ControlPlane["CONTROL PLANE (Controller Namespace)"]
        direction TB
        Controller["modelmesh-controller<br/>SA: modelmesh-controller<br/>Metrics: 8080/TCP HTTP<br/>Health: 8081/TCP HTTP"]
        WebhookServer["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cert-manager self-signed)<br/>Auth: K8s API server<br/>Failure Policy: Fail"]
        MetricsProxy["controller-manager-metrics<br/>8443/TCP HTTPS<br/>kube-rbac-proxy"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (SA)"]
        etcd["etcd Cluster<br/>2379/TCP gRPC<br/>TLS (configurable)<br/>Username/password or mTLS"]
        S3["S3/GCS/Azure Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / access key"]
    end

    %% External client flow
    Client -->|HTTPS/8443<br/>TLS<br/>OpenShift OAuth| OAuthProxy

    %% Controller to runtime
    Controller -->|gRPC/8033<br/>TLS + mTLS<br/>SetVModel/DeleteVModel| MM

    %% Controller to external
    Controller -->|HTTPS/443<br/>TLS 1.2+<br/>Bearer Token| K8sAPI

    %% ModelMesh to etcd
    MM -->|gRPC/2379<br/>TLS<br/>user/pass or mTLS| etcd

    %% Puller to storage
    Puller -->|HTTPS/443<br/>TLS 1.2+<br/>AWS IAM| S3

    %% Webhook
    K8sAPI -->|HTTPS/9443<br/>TLS cert-manager<br/>Admission requests| WebhookServer

    %% Runtime metrics
    MM -.->|HTTPS/2112<br/>TLS<br/>Prometheus metrics| MetricsProxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ff9999,stroke:#cc0000,stroke-width:2px
    classDef dataplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class OAuthProxy auth
    class RESTProxy,MM,ModelServer,Puller dataplane
    class Controller,WebhookServer,MetricsProxy controlplane
    class K8sAPI,etcd,S3 externalservice
