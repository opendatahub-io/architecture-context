graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["controller-manager"]
        SA_KubeRay["kuberay-operator"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_KubeRay["kuberay-operator<br/>(Cluster-scoped)"]
        CRB_KubeRayCM["kuberay-operator-configmap<br/>(NS: redhat-ods-applications)"]
        CRB_KubeRayGW["kuberay-operator-gateway-api<br/>(NS: redhat-ods-applications)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_KubeRay["kuberay-operator"]
        CR_Edit["kuberay-edit-role<br/>(aggregated to admin/edit)"]
        CR_View["kuberay-view-role<br/>(aggregated to view)"]
        CR_RayAdmin["ray-admin-role"]
        CR_RayEditor["ray-editor-role"]
        CR_RayViewer["ray-viewer-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
    end

    subgraph Resources_Manager["manager-role Resources"]
        Rays["components.platform.opendatahub.io<br/>rays, rays/status, rays/finalizers"]
        Deployments["apps<br/>deployments"]
        CoreResources["core<br/>services, configmaps, serviceaccounts,<br/>events, namespaces, pods, secrets"]
        RayIO["ray.io<br/>rayclusters, rayjobs,<br/>rayservices, raycronjobs"]
        RBAC_Res["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
        Webhooks["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigs"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        SCCs["security.openshift.io<br/>securitycontextconstraints"]
        CertMgr["cert-manager.io<br/>certificates, issuers"]
        GatewayRes["gateway.networking.k8s.io<br/>gateways, httproutes, referencegrants"]
        NetworkRes["networking.k8s.io<br/>ingresses, networkpolicies"]
        RouteRes["route.openshift.io<br/>routes"]
    end

    subgraph Resources_KubeRay["kuberay-operator Resources"]
        KR_RayIO["ray.io<br/>(broad operand permissions)"]
        KR_Core["core, apps, batch"]
        KR_CertGW["cert-manager.io, gateway, networking, routes"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    %% Bindings
    SA_Controller -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager

    SA_KubeRay -->|bound via| CRB_KubeRay
    CRB_KubeRay -->|grants| CR_KubeRay

    SA_KubeRay -->|bound via| CRB_KubeRayCM
    SA_KubeRay -->|bound via| CRB_KubeRayGW

    %% Manager role permissions
    CR_Manager -->|CRUD + watch| Rays
    CR_Manager -->|CRUD + watch| Deployments
    CR_Manager -->|CRUD + watch<br/>namespaces: read-only| CoreResources
    CR_Manager -->|CRUD + watch + deletecollection| RayIO
    CR_Manager -->|CRUD + watch| RBAC_Res
    CR_Manager -->|CRUD + watch| Webhooks
    CR_Manager -->|create, get, list, patch, update, watch| CRDs
    CR_Manager -->|CRUD + watch| SCCs
    CR_Manager -->|CRUD + watch| CertMgr
    CR_Manager -->|CRUD + watch| GatewayRes
    CR_Manager -->|CRUD + watch| NetworkRes
    CR_Manager -->|CRUD + watch| RouteRes

    %% KubeRay operator permissions
    CR_KubeRay -->|CRUD + watch| KR_RayIO
    CR_KubeRay -->|CRUD + watch| KR_Core
    CR_KubeRay -->|CRUD + watch| KR_CertGW

    %% Aggregated roles
    CR_Edit -->|CRUD| RayIO
    CR_View -->|get, list, watch| RayIO

    %% Metrics
    CR_MetricsAuth -->|create| TokenReviews["authentication.k8s.io<br/>tokenreviews, subjectaccessreviews"]
    CR_MetricsReader -->|get| MetricsURL

    style SA_Controller fill:#4a90e2,color:#fff
    style SA_KubeRay fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623
    style CR_KubeRay fill:#f5a623
    style CR_Edit fill:#f5a623
    style CR_View fill:#f5a623
    style CR_RayAdmin fill:#f5a623
    style CR_RayEditor fill:#f5a623
    style CR_RayViewer fill:#f5a623
    style CR_MetricsAuth fill:#f5a623
    style CR_MetricsReader fill:#f5a623
    style Rays fill:#7ed321
    style RayIO fill:#7ed321
    style KR_RayIO fill:#7ed321
