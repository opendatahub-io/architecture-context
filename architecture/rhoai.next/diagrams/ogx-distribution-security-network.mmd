graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ) — Managed by Operator"]
        Gateway["Ingress / Service Mesh<br/>TLS Termination<br/>Managed by rhods-operator"]
    end

    subgraph Application["APPLICATION (OGX Server Container)"]
        OGX["OGX Server (ogx-core)<br/>8321/TCP HTTP (plaintext)<br/>OAuth2 JWT (conditional)<br/>Base: AIPCC cpu:3.5.0"]
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        direction TB
        vLLM_Inf["vLLM Inference<br/>Configurable port<br/>TLS configurable<br/>Bearer Token"]
        vLLM_Emb["vLLM Embedding<br/>Configurable port<br/>TLS configurable<br/>Bearer Token"]
        PG["PostgreSQL<br/>5432/TCP<br/>Plaintext<br/>Username/Password"]
    end

    subgraph VectorStores["VECTOR STORAGE"]
        direction TB
        pgvector["pgvector<br/>5432/TCP PostgreSQL<br/>Plaintext<br/>Username/Password"]
        Milvus["Milvus<br/>Configurable HTTP/gRPC<br/>mTLS (configurable)<br/>Token"]
        Qdrant["Qdrant<br/>6333/TCP REST, 6334/TCP gRPC<br/>TLS configurable<br/>API Key"]
    end

    subgraph CloudInference["EXTERNAL SERVICES — Cloud Inference (443/TCP HTTPS TLS 1.2+)"]
        direction TB
        Bedrock["AWS Bedrock<br/>AWS IAM (STS/IRSA)"]
        WatsonX["IBM WatsonX<br/>API Key"]
        AzureOAI["Azure OpenAI<br/>API Key"]
        VertexAI["Google Vertex AI<br/>Google ADC/OAuth2"]
        OpenAI["OpenAI API<br/>API Key"]
        Gemini["Google Gemini<br/>API Key"]
        AnthropicAPI["Anthropic API<br/>API Key"]
    end

    subgraph ToolServices["EXTERNAL SERVICES — Tools & Storage"]
        direction TB
        BraveSearch["Brave Search<br/>443/TCP HTTPS<br/>API Key"]
        TavilySearch["Tavily Search<br/>443/TCP HTTPS<br/>API Key"]
        S3["S3 / Object Storage<br/>443/TCP HTTPS<br/>AWS IAM"]
        DoclingServe["Docling Serve<br/>Configurable<br/>API Key"]
        MCP["MCP Servers<br/>Configurable<br/>Configurable Auth"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTEL["OTEL Collector<br/>OTLP HTTP/gRPC<br/>Configurable"]
        JWKS["JWKS Endpoint<br/>443/TCP HTTPS<br/>No Auth"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS (ingress-managed)<br/>OAuth2 JWT"| Gateway
    Gateway -->|"HTTP/8321<br/>Plaintext<br/>JWT forwarded"| OGX

    OGX -->|"HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token"| vLLM_Inf
    OGX -->|"HTTP/HTTPS<br/>TLS configurable<br/>Bearer Token"| vLLM_Emb
    OGX -->|"PostgreSQL/5432<br/>Plaintext<br/>Password"| PG

    OGX -->|"PostgreSQL/5432<br/>Plaintext<br/>Password"| pgvector
    OGX -->|"HTTP-gRPC<br/>mTLS<br/>Token"| Milvus
    OGX -->|"HTTP-gRPC/6333-6334<br/>TLS<br/>API Key"| Qdrant

    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM"| Bedrock
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| WatsonX
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| AzureOAI
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>ADC"| VertexAI
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| OpenAI
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| Gemini
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| AnthropicAPI

    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| BraveSearch
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| TavilySearch
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM"| S3
    OGX -->|"HTTP/HTTPS<br/>Configurable<br/>API Key"| DoclingServe
    OGX -->|"HTTP/HTTPS<br/>Configurable"| MCP

    OGX -->|"OTLP<br/>Configurable"| OTEL
    OGX -->|"HTTPS/443<br/>TLS<br/>No Auth"| JWKS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef vectorstore fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef cloudservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef toolservice fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef observability fill:#e8e8e8,stroke:#666,stroke-width:2px

    class Client external
    class Gateway ingress
    class OGX application
    class vLLM_Inf,vLLM_Emb,PG internal
    class pgvector,Milvus,Qdrant vectorstore
    class Bedrock,WatsonX,AzureOAI,VertexAI,OpenAI,Gemini,AnthropicAPI cloudservice
    class BraveSearch,TavilySearch,S3,DoclingServe,MCP toolservice
    class OTEL,JWKS observability
