graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform-Managed TLS)"]
        Route["OpenShift Route / Istio Gateway<br/>443/TCP HTTPS<br/>TLS Termination"]
    end

    subgraph Application["APPLICATION"]
        direction TB
        OGX["OGX Server (ogx-core)<br/>8321/TCP HTTP (plaintext)<br/>OAuth2 JWT (when AUTH_ISSUER set)<br/>Owner-based access policy"]
    end

    subgraph InferenceEgress["INFERENCE PROVIDERS (HTTPS/443)"]
        direction LR
        vLLM_S["vLLM<br/>HTTP/HTTPS configurable<br/>Bearer token"]
        OpenAI_S["OpenAI API<br/>HTTPS TLS 1.2+<br/>API key"]
        Anthropic_S["Anthropic API<br/>HTTPS TLS 1.2+<br/>API key"]
        Azure_S["Azure OpenAI<br/>HTTPS TLS 1.2+<br/>API key"]
        Bedrock_S["AWS Bedrock<br/>HTTPS TLS 1.2+<br/>IAM/Bearer"]
        WatsonX_S["IBM WatsonX<br/>HTTPS TLS 1.2+<br/>API key"]
        VertexAI_S["Google Vertex AI<br/>HTTPS TLS 1.2+<br/>GCP creds"]
        Gemini_S["Google Gemini<br/>HTTPS TLS 1.2+<br/>API key"]
    end

    subgraph DataEgress["DATA STORAGE"]
        direction LR
        PG_S["PostgreSQL<br/>5432/TCP<br/>No encryption<br/>username/password"]
        Milvus_S["Milvus<br/>HTTP/gRPC<br/>TLS configurable<br/>Token"]
        PGVec_S["pgvector<br/>5432/TCP<br/>No encryption<br/>username/password"]
        Qdrant_S["Qdrant<br/>6333-6334/TCP<br/>TLS configurable<br/>API key"]
        S3_S["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
    end

    subgraph ToolEgress["TOOL & SERVICE EGRESS"]
        direction LR
        Brave_S["Brave Search<br/>443/TCP HTTPS<br/>API key"]
        Tavily_S["Tavily Search<br/>443/TCP HTTPS<br/>API key"]
        Docling_S["Docling Serve<br/>HTTP configurable<br/>API key"]
        JWKS_S["OAuth2/OIDC JWKS<br/>443/TCP HTTPS<br/>Public endpoint"]
    end

    subgraph Observability["OBSERVABILITY"]
        direction LR
        Prom_S["Prometheus<br/>Scrapes /metrics 8321/TCP<br/>HTTP, no auth"]
        OTEL_S["OpenTelemetry Collector<br/>OTLP HTTP/gRPC<br/>Optional"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (platform)<br/>OAuth2 JWT"| Route
    Route -->|"HTTP/8321<br/>plaintext<br/>JWT forwarded"| OGX

    OGX -->|"HTTP/HTTPS<br/>TLS configurable<br/>Bearer token"| vLLM_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| OpenAI_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Anthropic_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Azure_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM/Bearer"| Bedrock_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| WatsonX_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP creds"| VertexAI_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>API key"| Gemini_S

    OGX -->|"TCP/5432<br/>No encryption<br/>username/password"| PG_S
    OGX -->|"HTTP/gRPC<br/>TLS configurable<br/>Token"| Milvus_S
    OGX -->|"TCP/5432<br/>No encryption<br/>username/password"| PGVec_S
    OGX -->|"HTTP/gRPC 6333-6334<br/>TLS configurable<br/>API key"| Qdrant_S
    OGX -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3_S

    OGX -->|"HTTPS/443<br/>API key"| Brave_S
    OGX -->|"HTTPS/443<br/>API key"| Tavily_S
    OGX -->|"HTTP configurable<br/>API key"| Docling_S
    OGX -->|"HTTPS/443<br/>Public JWKS"| JWKS_S

    Prom_S -->|"HTTP/8321<br/>ServiceMonitor"| OGX
    OTEL_S -.->|"OTLP<br/>when configured"| OGX

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef datastorage fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tools fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef observability fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class OGX application
    class vLLM_S,OpenAI_S,Anthropic_S,Azure_S,Bedrock_S,WatsonX_S,VertexAI_S,Gemini_S inference
    class PG_S,Milvus_S,PGVec_S,Qdrant_S,S3_S datastorage
    class Brave_S,Tavily_S,Docling_S,JWKS_S tools
    class Prom_S,OTEL_S observability
