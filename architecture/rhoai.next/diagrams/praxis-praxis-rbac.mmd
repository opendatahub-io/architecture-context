graph TD
    subgraph "Authentication Mechanisms"
        mTLS["mTLS Client Certificates<br/>(None / Request / Require /<br/>RequireNamed with SPIFFE)"]
        BasicAuth["Basic Auth<br/>(htpasswd)"]
        IPAccess["IP ACL<br/>(allow/deny lists)"]
        PolicyEng["Policy Engine<br/>(PPE evaluation)"]
        Bearer["Bearer Token<br/>(credential injection)"]
    end

    subgraph "Security Enforcement Filters"
        CORSFilter["CORS Filter<br/>Cross-origin policy"]
        CSRFFilter["CSRF Filter<br/>Anti-forgery tokens"]
        IPACLFilter["IP ACL Filter<br/>IP-based access control"]
        BasicAuthFilter["Basic Auth Filter<br/>HTTP Basic Authentication"]
        GuardrailsFilter["Guardrails Filter<br/>AI content enforcement"]
        PolicyFilter["Policy Filter<br/>PPE rule evaluation"]
        PeerIdentityFilter["Peer Identity Trust<br/>mTLS identity validation"]
        CredInjectionFilter["Credential Injection<br/>Upstream auth injection"]
    end

    subgraph "Protected Resources"
        ProxyListener["Proxy Listener<br/>8080/TCP<br/>(client-facing)"]
        AdminEndpoint["Admin Endpoint<br/>9902/TCP<br/>(loopback only)"]
        UpstreamCluster["Upstream Clusters<br/>(backend servers)"]
    end

    subgraph "Header Security"
        ReservedHeaders["Reserved Header Prefixes<br/>x-praxis-*<br/>x-ext-protocol-*<br/>x-ext-agent-*"]
    end

    %% Auth to filters
    mTLS -->|"validates"| PeerIdentityFilter
    BasicAuth -->|"authenticates"| BasicAuthFilter
    IPAccess -->|"enforces"| IPACLFilter
    PolicyEng -->|"evaluates"| PolicyFilter
    Bearer -->|"injects"| CredInjectionFilter

    %% Filters to resources
    CORSFilter -->|"protects"| ProxyListener
    CSRFFilter -->|"protects"| ProxyListener
    IPACLFilter -->|"protects"| ProxyListener
    BasicAuthFilter -->|"protects"| ProxyListener
    GuardrailsFilter -->|"protects"| ProxyListener
    PolicyFilter -->|"protects"| ProxyListener
    PeerIdentityFilter -->|"protects"| ProxyListener

    CredInjectionFilter -->|"auth to"| UpstreamCluster

    %% Admin protection
    AdminEndpoint ---|"protected by<br/>loopback bind only"| AdminEndpoint

    %% Header security
    ReservedHeaders -->|"client sends → 400 reject"| ProxyListener
    ReservedHeaders -->|"stripped from responses"| UpstreamCluster

    %% Styling
    style mTLS fill:#e74c3c,color:#fff
    style BasicAuth fill:#e74c3c,color:#fff
    style IPAccess fill:#e74c3c,color:#fff
    style PolicyEng fill:#e74c3c,color:#fff
    style Bearer fill:#e74c3c,color:#fff
    style ProxyListener fill:#4a90e2,color:#fff
    style AdminEndpoint fill:#9b59b6,color:#fff
    style UpstreamCluster fill:#f5a623,color:#fff
    style ReservedHeaders fill:#2c3e50,color:#fff
    style CORSFilter fill:#f5a623,color:#fff
    style CSRFFilter fill:#f5a623,color:#fff
    style IPACLFilter fill:#f5a623,color:#fff
    style BasicAuthFilter fill:#f5a623,color:#fff
    style GuardrailsFilter fill:#f5a623,color:#fff
    style PolicyFilter fill:#f5a623,color:#fff
