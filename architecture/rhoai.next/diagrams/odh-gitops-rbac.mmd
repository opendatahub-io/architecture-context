graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["rhai-operator-controller-manager"]
        SA_Hook["rhai-post-install-hook"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Op["rhai-operator-rolebinding<br/>(cluster-wide)"]
        CRB_Hook["rhai-post-install-hook<br/>(cluster-wide)"]
        RB_HookCert["rhai-post-install-hook-cert<br/>(namespace: applicationsNs)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Op["rhai-operator-role"]
        CR_Hook["rhai-post-install-hook"]
        CR_HookCert["rhai-post-install-hook-cert"]
    end

    subgraph ODHResources["ODH/RHAI Platform Resources"]
        ComponentCRs["components.platform.opendatahub.io<br/>aigateways, dashboards, datasciencepipelines,<br/>feastoperators, kserves, kueues, mlflowoperators,<br/>modelcontrollers, modelregistries, rays,<br/>sparkoperators, trainers, trainingoperators,<br/>trustyais, workbenches"]
        DSC["datasciencecluster.opendatahub.io<br/>datascienceclusters"]
        DSCI["dscinitialization.opendatahub.io<br/>dscinitializations"]
        Platforms["config.opendatahub.io<br/>platforms"]
        KE["infrastructure.opendatahub.io<br/>{provider}kubernetesengines"]
    end

    subgraph NetworkResources["Gateway & Network Resources"]
        GatewayRes["gateway.networking.k8s.io<br/>gatewayclasses, gateways, httproutes"]
        IstioRes["networking.istio.io<br/>destinationrules, envoyfilters"]
    end

    subgraph SecurityResources["Security & Infrastructure Resources"]
        CertRes["cert-manager.io<br/>certificates"]
        KServeRes["serving.kserve.io<br/>clusterservingruntimes, inferenceservices,<br/>servingruntimes, llminferenceserviceconfigs"]
        KuadrantRes["kuadrant.io<br/>authpolicies, ratelimitpolicies,<br/>tokenratelimitpolicies"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterrolebindings, clusterroles,<br/>rolebindings, roles"]
        AdmissionRes["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations"]
        CRDRes["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    %% Operator SA bindings and permissions
    SA_Operator -->|bound via| CRB_Op
    CRB_Op -->|grants| CR_Op

    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| ComponentCRs
    CR_Op -->|"create, delete, deletecollection,<br/>get, list, patch, update, watch"| DSC
    CR_Op -->|"create, delete, deletecollection,<br/>get, list, patch, update, watch"| DSCI
    CR_Op -->|"get, list, watch"| Platforms
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| GatewayRes
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| IstioRes
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| CertRes
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| KServeRes
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| KuadrantRes
    CR_Op -->|"* (all verbs)"| RBACRes
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| AdmissionRes
    CR_Op -->|"create, delete, get, list,<br/>patch, update, watch"| CRDRes

    %% Hook SA bindings and permissions
    SA_Hook -->|bound via| CRB_Hook
    SA_Hook -->|bound via| RB_HookCert
    CRB_Hook -->|grants| CR_Hook
    RB_HookCert -->|grants| CR_HookCert

    CR_Hook -->|"get, create,<br/>patch, update"| ComponentCRs
    CR_Hook -->|"get, create,<br/>patch, update"| KE
    CR_Hook -->|"get, create,<br/>patch, update"| Platforms
    CR_Hook -->|"get, create,<br/>patch, update"| GatewayRes

