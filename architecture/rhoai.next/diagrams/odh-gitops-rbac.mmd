graph TD
    subgraph "Service Accounts"
        SA_Operator["rhai-operator-controller-manager<br/>(NS: redhat-ods-operator)"]
        SA_PostInstall["rhai-post-install-hook<br/>(NS: redhat-ods-operator)"]
        SA_PreDelete["rhai-pre-delete-hook<br/>(NS: redhat-ods-operator)"]
        SA_MetricsReader["metrics-reader"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Operator["rhods-operator-rolebinding<br/>(cluster-scoped)"]
        CRB_PostInstall["rhai-post-install-hook<br/>(cluster-scoped)"]
        CRB_PreDelete["rhai-pre-delete-hook<br/>(cluster-scoped)"]
        RB_PostInstallCert["rhai-post-install-hook-cert<br/>(ns: applicationsNamespace)"]
    end

    subgraph "ClusterRoles"
        CR_Operator["rhods-operator-role"]
        CR_PostInstall["rhai-post-install-hook"]
        CR_PreDelete["rhai-pre-delete-hook"]
        CR_MetricsReader["redhat-ods-operator-metrics-reader"]
    end

    subgraph "Operator Role Permissions (rhods-operator-role)"
        direction TB
        Core["core (v1)<br/>configmaps, deployments, events,<br/>namespaces, pods, secrets,<br/>serviceaccounts, services<br/>Verbs: *"]
        Components["components.platform.opendatahub.io<br/>aigateways, kserves, dashboards,<br/>datasciencepipelines, kueues,<br/>modelregistries, rays, trainers,<br/>workbenches (+10 more)<br/>Verbs: *"]
        Config["config.opendatahub.io<br/>platforms, platforms/finalizers,<br/>platforms/status<br/>Verbs: *"]
        Infra["infrastructure.opendatahub.io<br/>hardwareprofiles (+finalizers/status)<br/>Verbs: *"]
        GatewayRes["gateway.networking.k8s.io<br/>gateways, gatewayclasses, httproutes<br/>Verbs: *"]
        IstioRes["networking.istio.io<br/>destinationrules, envoyfilters<br/>Verbs: *"]
        ServingRes["serving.kserve.io<br/>clusterservingruntimes, inferenceservices,<br/>llminferenceservices, servingruntimes<br/>(+8 more)<br/>Verbs: *"]
        RBACRes["rbac.authorization.k8s.io<br/>clusterrolebindings, clusterroles,<br/>rolebindings, roles<br/>Verbs: *"]
        AdmissionRes["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations,<br/>validatingwebhookconfigurations<br/>Verbs: *"]
        MonitorRes["monitoring.coreos.com<br/>alertmanagers, prometheuses,<br/>servicemonitors, podmonitors,<br/>prometheusrules<br/>Verbs: *"]
        KuadrantRes["kuadrant.io<br/>authpolicies, ratelimitpolicies,<br/>kuadrants<br/>Verbs: *"]
        MaaSRes["maas.opendatahub.io<br/>configs, maastenantconfigs<br/>Verbs: *"]
    end

    subgraph "Post-Install Hook Permissions"
        direction TB
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions<br/>Verbs: get, list, watch"]
        CompCRs["components.platform.opendatahub.io<br/>aigateways, kserves<br/>Verbs: get, create, patch, update"]
        PlatformCR["config.opendatahub.io<br/>platforms<br/>Verbs: get, create, patch, update"]
        InfraCRs["infrastructure.opendatahub.io<br/>awskubernetesengines,<br/>azurekubernetesengines,<br/>coreweavekubernetesengines<br/>Verbs: get, create, patch, update"]
        GatewayCRs["gateway.networking.k8s.io<br/>gateways, gatewayclasses<br/>Verbs: get, create, patch, update"]
        CertCRs["cert-manager.io<br/>certificates, clusterissuers<br/>Verbs: get, create, patch, update"]
    end

    subgraph "Pre-Delete Hook Permissions"
        direction TB
        DeletePlatform["config.opendatahub.io<br/>platforms<br/>Verbs: get, delete"]
        DeleteComponents["components.platform.opendatahub.io<br/>component CRs<br/>Verbs: get, list, watch, delete"]
    end

    subgraph "Metrics Reader Permissions"
        MetricsURL["/metrics (non-resource URL)<br/>Verbs: get"]
    end

    %% SA → Binding → Role
    SA_Operator -->|"bound via"| CRB_Operator
    CRB_Operator -->|"grants"| CR_Operator

    SA_PostInstall -->|"bound via"| CRB_PostInstall
    CRB_PostInstall -->|"grants"| CR_PostInstall
    SA_PostInstall -->|"bound via"| RB_PostInstallCert

    SA_PreDelete -->|"bound via"| CRB_PreDelete
    CRB_PreDelete -->|"grants"| CR_PreDelete

    SA_MetricsReader -->|"grants"| CR_MetricsReader

    %% Role → Permissions
    CR_Operator -->|"allows"| Core
    CR_Operator -->|"allows"| Components
    CR_Operator -->|"allows"| Config
    CR_Operator -->|"allows"| Infra
    CR_Operator -->|"allows"| GatewayRes
    CR_Operator -->|"allows"| IstioRes
    CR_Operator -->|"allows"| ServingRes
    CR_Operator -->|"allows"| RBACRes
    CR_Operator -->|"allows"| AdmissionRes
    CR_Operator -->|"allows"| MonitorRes
    CR_Operator -->|"allows"| KuadrantRes
    CR_Operator -->|"allows"| MaaSRes

    CR_PostInstall -->|"allows"| CRDs
    CR_PostInstall -->|"allows"| CompCRs
    CR_PostInstall -->|"allows"| PlatformCR
    CR_PostInstall -->|"allows"| InfraCRs
    CR_PostInstall -->|"allows"| GatewayCRs
    CR_PostInstall -->|"allows"| CertCRs

    CR_PreDelete -->|"allows"| DeletePlatform
    CR_PreDelete -->|"allows"| DeleteComponents

    CR_MetricsReader -->|"allows"| MetricsURL

