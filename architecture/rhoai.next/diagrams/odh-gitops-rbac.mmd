graph TD
    subgraph "Service Accounts"
        SA_RHAI["rhai-operator-controller-manager"]
        SA_AWS["aws-cloud-manager-operator"]
        SA_Azure["azure-cloud-manager-operator"]
        SA_CW["coreweave-cloud-manager-operator"]
    end

    subgraph "ClusterRole Bindings"
        CRB_RHAI["rhai-operator-rolebinding<br/>(Cluster-scoped)"]
        CRB_AWS["rhai-aws-cloud-manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Azure["rhai-azure-cloud-manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_CW["rhai-coreweave-cloud-manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Metrics["rhai-operator-metrics-reader<br/>(Cluster-scoped)"]
    end

    subgraph "ClusterRoles"
        CR_RHAI["rhai-operator-role<br/>(50+ API groups)"]
        CR_Metrics["rhai-operator-metrics-reader"]
        CR_AWS["rhai-aws-cloud-manager-role"]
        CR_Azure["rhai-azure-cloud-manager-role"]
        CR_CW["rhai-coreweave-cloud-manager-role"]
    end

    subgraph "RHAI Operator Resources"
        CRDs["CRDs<br/>(all platform groups)"]
        Deployments["apps<br/>Deployments"]
        Services["core<br/>Services"]
        Secrets["core<br/>Secrets"]
        Namespaces["core<br/>Namespaces"]
        Gateways["gateway.networking.k8s.io<br/>Gateways"]
        ComponentCRs["components.platform.opendatahub.io<br/>Component CRs"]
        Monitoring["monitoring.coreos.com<br/>Monitoring"]
    end

    subgraph "Metrics Resources"
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    subgraph "Cloud Manager Resources"
        K8sEngine["infrastructure.opendatahub.io<br/>KubernetesEngine CRs"]
        CMCerts["cert-manager.io<br/>Certificates"]
        CMDeploys["apps<br/>Deployments"]
        CMRBAC["rbac.authorization.k8s.io<br/>RBAC Resources"]
        CMIstio["networking.istio.io<br/>Istio Resources"]
    end

    %% RHAI Operator bindings
    SA_RHAI -->|"bound via"| CRB_RHAI
    CRB_RHAI -->|"grants"| CR_RHAI
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| CRDs
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| Deployments
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| Services
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| Secrets
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| Namespaces
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| Gateways
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| ComponentCRs
    CR_RHAI -->|"create,delete,get,list,<br/>patch,update,watch"| Monitoring

    %% Metrics reader
    CRB_Metrics -->|"grants"| CR_Metrics
    CR_Metrics -->|"get"| MetricsURL

    %% Cloud Manager bindings
    SA_AWS -->|"bound via"| CRB_AWS
    CRB_AWS -->|"grants"| CR_AWS
    SA_Azure -->|"bound via"| CRB_Azure
    CRB_Azure -->|"grants"| CR_Azure
    SA_CW -->|"bound via"| CRB_CW
    CRB_CW -->|"grants"| CR_CW

    CR_AWS -->|"create,delete,get,list,<br/>patch,update,watch"| K8sEngine
    CR_AWS -->|"create,delete,get,list,<br/>patch,update,watch"| CMCerts
    CR_AWS -->|"create,delete,get,list,<br/>patch,update,watch"| CMDeploys
    CR_AWS -->|"create,delete,get,list,<br/>patch,update,watch"| CMRBAC
    CR_AWS -->|"create,delete,get,list,<br/>patch,update,watch"| CMIstio

    CR_Azure -->|"create,delete,get,list,<br/>patch,update,watch"| K8sEngine
    CR_CW -->|"create,delete,get,list,<br/>patch,update,watch"| K8sEngine

    style SA_RHAI fill:#4a90e2,color:#fff
    style SA_AWS fill:#4a90e2,color:#fff
    style SA_Azure fill:#4a90e2,color:#fff
    style SA_CW fill:#4a90e2,color:#fff
    style CR_RHAI fill:#f5a623
    style CR_Metrics fill:#f5a623
    style CR_AWS fill:#f5a623
    style CR_Azure fill:#f5a623
    style CR_CW fill:#f5a623
    style CRDs fill:#7ed321
    style Deployments fill:#7ed321
    style Services fill:#7ed321
    style Secrets fill:#7ed321
    style Namespaces fill:#7ed321
    style Gateways fill:#7ed321
    style ComponentCRs fill:#7ed321
    style Monitoring fill:#7ed321
    style K8sEngine fill:#7ed321
    style CMCerts fill:#7ed321
    style CMDeploys fill:#7ed321
    style CMRBAC fill:#7ed321
    style CMIstio fill:#7ed321
    style MetricsURL fill:#7ed321
