    style CRB_Hook fill:#bd10e0,stroke:#333,color:#fff
    style RB_HookCert fill:#bd10e0,stroke:#333,color:#fff
    style CR_Op fill:#f5a623,stroke:#333
    style CR_Hook fill:#f5a623,stroke:#333
    style CR_HookCert fill:#f5a623,stroke:#333
    style ComponentCRs fill:#7ed321,stroke:#333
    style DSC fill:#7ed321,stroke:#333
    style DSCI fill:#7ed321,stroke:#333
    style Platforms fill:#7ed321,stroke:#333
    style KE fill:#7ed321,stroke:#333
