graph TD
    subgraph "Service Accounts"
        SA_Default["default<br/>(default ServiceAccount)"]
    end

    subgraph "RBAC Status"
        NoRBAC["No ClusterRoles Defined<br/>No RoleBindings Defined<br/>No Custom RBAC"]
    end

    subgraph "Pod Deployments"
        PreflightPod["Preflight Check Pod<br/>SA: default"]
        NIXLServer["NIXL Server Pod<br/>SA: default<br/>GPU: nvidia.com/gpu: 1"]
        NIXLClient["NIXL Client Pod<br/>SA: default<br/>GPU: nvidia.com/gpu: 1"]
        RoCEServer["RoCE Server Pod<br/>SA: default<br/>Capability: IPC_LOCK<br/>GPU: nvidia.com/roce_gdr: 2"]
        RoCEClient["RoCE Client Pod<br/>SA: default<br/>Capability: IPC_LOCK<br/>GPU: nvidia.com/roce_gdr: 2"]
    end

    subgraph "Network Exposure"
        NodePort["nixl-server<br/>NodePort 30002 → 5555/TCP<br/>No Auth"]
    end

    subgraph "Security Observations"
        Obs1["All pods use default SA<br/>(no least-privilege RBAC)"]
        Obs2["RoCE pods require IPC_LOCK<br/>(elevated capability)"]
        Obs3["NodePort exposes benchmark<br/>to all cluster nodes"]
        Obs4["No network policies defined"]
    end

    SA_Default -->|"used by"| PreflightPod
    SA_Default -->|"used by"| NIXLServer
    SA_Default -->|"used by"| NIXLClient
    SA_Default -->|"used by"| RoCEServer
    SA_Default -->|"used by"| RoCEClient

    NIXLServer -->|"exposed via"| NodePort

