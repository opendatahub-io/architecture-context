graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_KF["notebook-controller-<br/>service-account"]
        SA_ODH["odh-notebook-controller-<br/>manager"]
        SA_NB["{notebook-name}<br/>(per-notebook, user namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_KF["notebook-controller-<br/>role-binding"]
        CRB_ODH["odh-notebook-controller-<br/>manager-rolebinding"]
        CRB_AUTH["{notebook-name}-rbac-<br/>{namespace}-auth-delegator"]
    end

    subgraph RoleBindings["Namespace-Scoped Role Bindings"]
        RB_LEADER["odh-notebook-controller-<br/>leader-election-rolebinding"]
        RB_PIPELINE["elyra-pipelines-{notebook-name}<br/>(user namespace)"]
        RB_MLFLOW["{notebook-name}-mlflow<br/>(user namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_KF["notebook-controller-role"]
        CR_ODH["odh-notebook-controller-<br/>manager-role"]
        CR_AUTH["system:auth-delegator"]
        CR_PIPELINE["ds-pipeline-user-access-dspa"]
        CR_MLFLOW["mlflow-operator-<br/>mlflow-integration"]
    end

    subgraph AggregatedRoles["Aggregated User Roles"]
        CR_ADMIN["notebooks-admin<br/>(aggregated to admin)"]
        CR_EDIT["notebooks-edit"]
        CR_VIEW["notebooks-view"]
    end

    subgraph KFResources["notebook-controller-role Resources"]
        R_Pods["core<br/>pods<br/>get, list, watch, delete"]
        R_Events_KF["core<br/>events<br/>get, list, watch, create, patch"]
        R_Services_KF["core<br/>services<br/>*"]
        R_StatefulSets["apps<br/>statefulsets<br/>*"]
        R_Notebooks_KF["kubeflow.org<br/>notebooks, notebooks/status,<br/>notebooks/finalizers<br/>*"]
        R_VirtualServices["networking.istio.io<br/>virtualservices<br/>*"]
    end

    subgraph ODHResources["odh-notebook-controller-manager-role Resources (selected)"]
        R_ConfigMaps["core<br/>configmaps, secrets,<br/>serviceaccounts, services<br/>create, get, list, patch,<br/>update, watch"]
        R_TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        R_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        R_Gateway["gateway.networking.k8s.io<br/>gateways<br/>get, list, watch"]
        R_HTTPRoutes["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/>create, delete, get, list,<br/>patch, update, watch"]
        R_ImageStreams["image.openshift.io<br/>imagestreams<br/>get, list, watch"]
        R_NetworkPolicies["networking.k8s.io<br/>networkpolicies<br/>create, get, list, patch,<br/>update, watch"]
        R_DSPA["datasciencepipelines...<br/>datasciencepipelines-<br/>applications<br/>get, list, watch"]
        R_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>rolebindings, roles<br/>create, delete, get, list,<br/>patch, update, watch"]
    end

    subgraph UserResources["User Role Resources"]
        R_NB_RW["kubeflow.org<br/>notebooks, notebooks/status<br/>get, list, watch, create,<br/>delete, patch, update"]
        R_NB_RO["kubeflow.org<br/>notebooks, notebooks/status<br/>get, list, watch"]
    end

    %% SA → CRB → CR connections
    SA_KF -->|bound via| CRB_KF
    CRB_KF -->|grants| CR_KF

    SA_ODH -->|bound via| CRB_ODH
    CRB_ODH -->|grants| CR_ODH

    SA_NB -->|bound via| CRB_AUTH
    CRB_AUTH -->|grants| CR_AUTH

    SA_ODH -->|bound via| RB_LEADER

    SA_NB -->|bound via| RB_PIPELINE
    RB_PIPELINE -->|grants| CR_PIPELINE

    SA_NB -->|bound via| RB_MLFLOW
    RB_MLFLOW -->|grants| CR_MLFLOW

    %% CR → Resources
    CR_KF -->|manages| R_Pods
    CR_KF -->|manages| R_Events_KF
    CR_KF -->|manages| R_Services_KF
    CR_KF -->|manages| R_StatefulSets
    CR_KF -->|manages| R_Notebooks_KF
    CR_KF -->|manages| R_VirtualServices

    CR_ODH -->|manages| R_ConfigMaps
    CR_ODH -->|manages| R_TokenReviews
    CR_ODH -->|manages| R_SAR
    CR_ODH -->|manages| R_Gateway
    CR_ODH -->|manages| R_HTTPRoutes
    CR_ODH -->|manages| R_ImageStreams
    CR_ODH -->|manages| R_NetworkPolicies
    CR_ODH -->|manages| R_DSPA
    CR_ODH -->|manages| R_RBAC

    %% User roles → Resources
    CR_EDIT -->|grants| R_NB_RW
    CR_VIEW -->|grants| R_NB_RO
    CR_ADMIN -->|aggregates| CR_EDIT

    %% Styling
    style SA_KF fill:#4a90e2,stroke:#333,color:#fff
    style SA_ODH fill:#4a90e2,stroke:#333,color:#fff
    style SA_NB fill:#4a90e2,stroke:#333,color:#fff

