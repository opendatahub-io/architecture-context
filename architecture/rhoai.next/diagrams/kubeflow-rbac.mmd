    style CR_EDIT fill:#e8547e,stroke:#333,color:#fff
    style CR_VIEW fill:#e8547e,stroke:#333,color:#fff

    style R_Pods fill:#7ed321,stroke:#333
    style R_Events_KF fill:#7ed321,stroke:#333
    style R_Services_KF fill:#7ed321,stroke:#333
    style R_StatefulSets fill:#7ed321,stroke:#333
    style R_Notebooks_KF fill:#7ed321,stroke:#333
    style R_VirtualServices fill:#7ed321,stroke:#333

    style R_ConfigMaps fill:#7ed321,stroke:#333
    style R_TokenReviews fill:#7ed321,stroke:#333
    style R_SAR fill:#7ed321,stroke:#333
    style R_Gateway fill:#7ed321,stroke:#333
    style R_HTTPRoutes fill:#7ed321,stroke:#333
    style R_ImageStreams fill:#7ed321,stroke:#333
    style R_NetworkPolicies fill:#7ed321,stroke:#333
    style R_DSPA fill:#7ed321,stroke:#333
