graph TB
    subgraph "Guardrails Regex Detector Service"
        direction TB
        subgraph "Rust Binary (axum + tokio)"
            Router["axum Router<br/>HTTP Request Handler"]
            HealthEndpoint["/health<br/>GET - Health Check"]
            DetectEndpoint["/api/v1/text/contents<br/>POST - Detection"]
            Router --> HealthEndpoint
            Router --> DetectEndpoint
        end

        subgraph "Detection Engine"
            BuiltIn["Built-in PII Detectors"]
            EmailDetector["Email Detector<br/>(regex pattern)"]
            SSNDetector["SSN Detector<br/>(regex pattern)"]
            CreditCardDetector["Credit Card Detector<br/>(regex pattern)"]
            CustomDetector["Custom Regex Detector<br/>(compiled per-request)"]
            BuiltIn --> EmailDetector
            BuiltIn --> SSNDetector
            BuiltIn --> CreditCardDetector
        end

        DetectEndpoint -->|applies patterns| BuiltIn
        DetectEndpoint -->|compiles & applies| CustomDetector
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|POST /api/v1/text/contents<br/>8080/TCP HTTP| DetectEndpoint
    DetectEndpoint -->|JSON response<br/>detections array| Orchestrator

    Monitor["Health Monitor"] -->|GET /health<br/>8080/TCP HTTP| HealthEndpoint

    style Router fill:#4a90e2,stroke:#333
    style HealthEndpoint fill:#7ed321,stroke:#333
    style DetectEndpoint fill:#4a90e2,stroke:#333
    style BuiltIn fill:#f5a623,stroke:#333
    style EmailDetector fill:#f5a623,stroke:#333
    style SSNDetector fill:#f5a623,stroke:#333
    style CreditCardDetector fill:#f5a623,stroke:#333
    style CustomDetector fill:#f5a623,stroke:#333
    style Orchestrator fill:#e8e8e8,stroke:#333,stroke-width:2px
    style Monitor fill:#e8e8e8,stroke:#333
