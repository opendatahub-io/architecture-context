graph TB
    subgraph "Guardrails Regex Detector"
        direction TB
        Server["Axum HTTP Server<br/>8080/TCP"]
        Handler["Detection Handler<br/>/api/v1/text/contents"]
        Health["Health Check<br/>/health"]
        Dispatcher["Pattern Dispatcher<br/>HashMap&lt;name, detector_fn&gt;"]

        subgraph "Built-in Detectors"
            Email["Email Detector<br/>RFC 5322 regex"]
            SSN["SSN Detector<br/>US Social Security regex"]
            CreditCard["Credit Card Detector<br/>Major card formats regex"]
        end

        CustomRegex["Custom Regex<br/>User-supplied patterns"]

        Server --> Handler
        Server --> Health
        Handler --> Dispatcher
        Dispatcher --> Email
        Dispatcher --> SSN
        Dispatcher --> CreditCard
        Dispatcher --> CustomRegex
    end

    Orchestrator["FMS Guardrails Orchestrator"] -->|"POST /api/v1/text/contents<br/>8080/TCP HTTP"| Server
    Server -->|"JSON Response<br/>Detection Results"| Orchestrator

    subgraph "Runtime"
        Tokio["Tokio Async Runtime<br/>Multi-threaded"]
        Tracing["Tracing / Logging<br/>Structured logs"]
    end

    Server -.->|runs on| Tokio
    Server -.->|logs via| Tracing

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style Handler fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style Dispatcher fill:#4a90e2,stroke:#333,color:#fff
    style Email fill:#7ed321,stroke:#333
    style SSN fill:#7ed321,stroke:#333
    style CreditCard fill:#7ed321,stroke:#333
    style CustomRegex fill:#f5a623,stroke:#333
    style Orchestrator fill:#e8e8e8,stroke:#333
    style Tokio fill:#d5e8d4,stroke:#82b366
    style Tracing fill:#d5e8d4,stroke:#82b366
