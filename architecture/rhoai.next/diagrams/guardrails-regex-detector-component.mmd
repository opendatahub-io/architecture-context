graph TB
    subgraph "Guardrails Regex Detector"
        direction TB
        Router["Axum Router<br/>HTTP Request Routing"]
        DetectionEndpoint["Detection Endpoint<br/>/api/v1/text/contents"]
        HealthEndpoint["Health Endpoint<br/>/health"]
        DetectorEngine["Detector Engine<br/>Pattern Matching"]

        subgraph "Built-in Detectors"
            EmailDetector["Email Detector<br/>RFC 5322 Pattern"]
            SSNDetector["SSN Detector<br/>XXX-XX-XXXX Pattern"]
            CCDetector["Credit Card Detector<br/>Luhn-format Pattern"]
        end

        CustomRegex["Custom Regex Handler<br/>User-supplied Patterns"]

        Router --> DetectionEndpoint
        Router --> HealthEndpoint
        DetectionEndpoint --> DetectorEngine
        DetectorEngine --> EmailDetector
        DetectorEngine --> SSNDetector
        DetectorEngine --> CCDetector
        DetectorEngine --> CustomRegex
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>8080/TCP HTTP"| Router

    style Router fill:#4a90e2,color:#fff
    style DetectionEndpoint fill:#4a90e2,color:#fff
    style HealthEndpoint fill:#4a90e2,color:#fff
    style DetectorEngine fill:#4a90e2,color:#fff
    style EmailDetector fill:#7ed321,color:#fff
    style SSNDetector fill:#7ed321,color:#fff
    style CCDetector fill:#7ed321,color:#fff
    style CustomRegex fill:#f5a623,color:#fff
    style Orchestrator fill:#e8e8e8,stroke:#333
