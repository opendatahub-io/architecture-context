graph LR
    KAP["kube-auth-proxy"]

    %% Platform Dependencies
    KAP -->|"TokenReview API<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]
    KAP -->|"OAuth2 flow<br/>443/TCP HTTPS"| OAuthServer["OpenShift OAuth Server"]

    %% External Service Dependencies
    KAP -->|"OIDC flow<br/>443/TCP HTTPS"| ExtOIDC["External OIDC Provider"]
    KAP -.->|"session storage<br/>TCP TLS optional"| Redis["Redis / Valkey"]

    %% Key Library Dependencies
    KAP -->|router| Mux["gorilla/mux v1.8.1"]
    KAP -->|middleware| Alice["justinas/alice v1.2.0"]
    KAP -->|OIDC verify| GoOIDC["coreos/go-oidc v3.18.0"]
    KAP -->|JWT parse| JWT["golang-jwt v5.3.0"]
    KAP -->|metrics| PromClient["prometheus/client_golang v1.23.2"]
    KAP -->|config| Viper["spf13/viper v1.21.0"]
    KAP -->|K8s client| ClientGo["k8s.io/client-go v0.35.3"]
    KAP -->|OAuth2 client| OAuth2["golang.org/x/oauth2 v0.36.0"]

    %% Integration Points (things that depend on kube-auth-proxy)
    Envoy["Envoy Proxy"] -->|"ext_authz<br/>/oauth2/auth"| KAP
    Upstream["Upstream Application"] ---|"proxied requests<br/>HTTP"| KAP
    Prometheus["Prometheus"] -->|"scrape /metrics"| KAP

    style KAP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OAuthServer fill:#999,stroke:#333,color:#fff
