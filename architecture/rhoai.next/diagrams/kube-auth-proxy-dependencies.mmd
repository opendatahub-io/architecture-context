graph LR
    KAP["kube-auth-proxy<br/>(FIPS-compliant Auth Proxy)"]

    %% External Identity Dependencies
    KAP -->|"OIDC discovery +<br/>token exchange<br/>HTTPS/443"| OIDCProvider["OIDC Provider<br/>(Keycloak, Dex, etc.)"]
    KAP -->|"OAuth authz +<br/>token exchange<br/>HTTPS/443"| OSAuth["OpenShift OAuth<br/>Server"]
    KAP -->|"User identity<br/>validation<br/>HTTPS/443"| OSUserAPI["OpenShift<br/>User API"]
    KAP -->|"Token deletion<br/>on logout<br/>HTTPS/443"| OSOAuthTokenAPI["OpenShift OAuth<br/>Access Token API"]

    %% Cluster Dependencies
    KAP -->|"TokenReview API<br/>HTTPS/443"| K8sAPI["Kubernetes API<br/>Server"]

    %% Optional Infrastructure
    KAP -.->|"session storage<br/>TCP/TLS 6379"| Redis["Redis<br/>(Standalone/Sentinel/Cluster)"]

    %% Upstream
    KAP -->|"proxied requests +<br/>identity headers"| Upstream["Upstream<br/>Application"]

    %% Integration Points (inbound)
    EnvoyProxy["Envoy Proxy<br/>(RHOAI 3.x Gateway)"] -->|"ext_authz<br/>HTTP(S)/4180,8443"| KAP
    Prometheus["Prometheus"] -->|"metrics scrape<br/>HTTP(S)"| KAP

    %% Deployment (injected by operators)
    RhodsOp["rhods-operator"] -.->|"sidecar injection"| KAP
    NotebookCtrl["odh-notebook-controller"] -.->|"sidecar injection"| KAP

    %% Key Go Library Dependencies
    subgraph GoLibraries["Key Go Libraries"]
        direction TB
        GoOIDC["coreos/go-oidc/v3<br/>v3.18.0"]
        GoJWT["golang-jwt/jwt/v5<br/>v5.3.0"]
        GoRedis["redis/go-redis/v9<br/>v9.17.0"]
        K8sClient["k8s.io/client-go<br/>v0.35.3"]
        GorillaMux["gorilla/mux<br/>v1.8.1"]
        PromClient["prometheus/client_golang<br/>v1.23.2"]
        GoOAuth2["golang.org/x/oauth2<br/>v0.36.0"]
        GoCrypto["golang.org/x/crypto<br/>v0.51.0"]
    end

    KAP -.->|"libraries"| GoLibraries

