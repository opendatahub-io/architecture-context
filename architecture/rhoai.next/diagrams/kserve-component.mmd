graph TB
    subgraph KServeModule["KServe Module Controller"]
        direction TB
        ModuleCtrl["kserve-module-controller<br/>Go Operator"]
        ODHModelCtrl["odh-model-controller<br/>Networking / RBAC / NIM"]
        Webhooks["Webhook Server<br/>9443/TCP TLS"]
        ModuleCtrl --> ODHModelCtrl
        ModuleCtrl --> Webhooks
    end

    subgraph CoreControllers["Core Reconciliation Controllers"]
        direction TB
        ISVCCtrl["InferenceService Controller<br/>v1beta1 Lifecycle"]
        LLMISVCCtrl["LLMInferenceService Controller<br/>v1alpha2 LLM Workloads"]
        IGCtrl["InferenceGraph Controller<br/>DAG Traffic Routing"]
    end

    subgraph LocalModelSystem["Local Model Caching"]
        direction TB
        LMCCtrl["LocalModelCache Controller<br/>PV / Job Coordination"]
        LMNAgent["LocalModelNode Agent<br/>DaemonSet Per-Node"]
    end

    subgraph DataPlane["Data Plane"]
        direction TB
        Router["Router<br/>InferenceGraph Traffic"]
        QPExt["qpext<br/>Prometheus Metrics Proxy"]
        ServingAPI["model-serving-api<br/>8443/TCP HTTPS"]
    end

    subgraph PythonSDK["Python SDK & Model Servers"]
        direction TB
        SDK["kserve SDK<br/>Predict Protocol v2"]
        Storage["kserve-storage<br/>S3 / GCS / Azure / OCI"]
        HF["huggingfaceserver"]
        OVMS["OpenVINO Model Server"]
        VLLMRuntime["vLLM Runtimes<br/>CUDA / ROCm / Gaudi / Spyre / CPU"]
        MLServer["MLServer<br/>sklearn / LightGBM / XGBoost"]
    end

    %% CRDs
    User[User / Data Scientist] -->|creates| ISVCCR["InferenceService CR"]
    User -->|creates| LLMISVCCR["LLMInferenceService CR"]
    ISVCCR -->|watched by| ISVCCtrl
    LLMISVCCR -->|watched by| LLMISVCCtrl
    KserveCR["Kserve CR<br/>components.platform.opendatahub.io"] -->|watched by| ModuleCtrl

    ModuleCtrl --> CoreControllers
    ModuleCtrl --> LocalModelSystem

    %% What controllers create
    ISVCCtrl -->|creates| Deployment["Deployment / ReplicaSet"]
    ISVCCtrl -->|creates| HTTPRoute["HTTPRoute<br/>Gateway API"]
    ISVCCtrl -->|creates| HPA["HPA / ScaledObject"]
    LLMISVCCtrl -->|creates| LWS["LeaderWorkerSet"]
    LLMISVCCtrl -->|creates| InferencePool["InferencePool"]

    %% External dependencies
    ModuleCtrl -->|depends on| CertManager["cert-manager"]
    ISVCCtrl -->|depends on| GatewayAPI["Gateway API"]
    ISVCCtrl -.->|optional| Knative["Knative Serving"]
    ISVCCtrl -->|depends on| KEDA["KEDA"]
    ODHModelCtrl -->|integrates| Kuadrant["Kuadrant AuthPolicy"]
    ODHModelCtrl -->|manages| Istio["Istio DestinationRules"]
    LMCCtrl -->|reads| StorageBackend["S3 / GCS / Azure Storage"]

    %% Styling
    style ModuleCtrl fill:#4a90e2,color:#fff
    style ODHModelCtrl fill:#4a90e2,color:#fff
    style Webhooks fill:#4a90e2,color:#fff
    style ISVCCtrl fill:#5ba3d9,color:#fff
    style LLMISVCCtrl fill:#5ba3d9,color:#fff
    style IGCtrl fill:#5ba3d9,color:#fff
    style LMCCtrl fill:#6db8a0,color:#fff
    style LMNAgent fill:#6db8a0,color:#fff
    style Router fill:#9b59b6,color:#fff
    style QPExt fill:#9b59b6,color:#fff
    style ServingAPI fill:#9b59b6,color:#fff
    style SDK fill:#e67e22,color:#fff
    style Storage fill:#e67e22,color:#fff
    style HF fill:#e67e22,color:#fff
    style OVMS fill:#e67e22,color:#fff
    style VLLMRuntime fill:#e67e22,color:#fff
    style MLServer fill:#e67e22,color:#fff
    style ISVCCR fill:#f5a623
    style LLMISVCCR fill:#f5a623
    style KserveCR fill:#f5a623
    style CertManager fill:#e8e8e8
    style GatewayAPI fill:#e8e8e8
    style Knative fill:#e8e8e8
    style KEDA fill:#e8e8e8
    style Kuadrant fill:#e8e8e8
    style Istio fill:#e8e8e8
    style StorageBackend fill:#e8e8e8
