graph TB
    subgraph PlatformLayer["RHOAI Platform Layer"]
        ModuleCtrl["kserve-module-controller<br/>(Go Operator)<br/>Watches Kserve CR<br/>Deploys KServe via kustomize"]
    end

    subgraph CoreControllers["Core Controllers"]
        KServeCtrl["kserve-controller-manager<br/>(Go Operator)<br/>8080/TCP metrics, 9443/TCP webhooks"]
        LLMISVCCtrl["llmisvc-controller-manager<br/>(Go Operator)<br/>8080/TCP metrics, 9443/TCP webhooks"]
        LocalModelCtrl["localmodel-controller<br/>(Go Operator)<br/>9443/TCP webhooks"]
        LocalModelAgent["localmodelnode-agent<br/>(Go DaemonSet)<br/>Per-node model downloads"]
    end

    subgraph InferencePodComponents["Inference Pod Components"]
        Agent["kserve-agent<br/>(Go Sidecar)<br/>9081/TCP proxy, 9083/TCP logger"]
        StorageInit["kserve-storage-initializer<br/>(Python Init Container)<br/>S3/GCS/Azure/HF/OCI"]
        AuthProxy["kube-rbac-proxy<br/>(Auth Sidecar)<br/>8443/TCP HTTPS"]
    end

    subgraph InferenceRouting["Inference Routing"]
        Router["kserve-router<br/>(Go Service)<br/>8080/TCP HTTP/HTTPS"]
        EPP["llm-d Scheduler/EPP<br/>(Endpoint Picker)<br/>gRPC + metrics"]
    end

    subgraph ModelServers["Model Servers"]
        AutoGluon["kserve-autogluon-server<br/>(Python)<br/>8080/TCP inference"]
        vLLM["vLLM Engine<br/>(CUDA/ROCm/Gaudi/Spyre)<br/>8000/TCP"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        ISVC["InferenceService<br/>v1beta1"]
        LLMISVC["LLMInferenceService<br/>v1alpha2"]
        IG["InferenceGraph<br/>v1alpha1"]
        SR["ServingRuntime /<br/>ClusterServingRuntime"]
        TM["TrainedModel<br/>v1alpha1"]
        LMC["LocalModelCache /<br/>LocalModelNamespaceCache"]
        LLMISVCConfig["LLMInferenceServiceConfig<br/>v1alpha2"]
        KserveCR["Kserve CR<br/>(platform.opendatahub.io)"]
    end

    %% Platform operator flow
    KserveCR -->|watched by| ModuleCtrl
    ModuleCtrl -->|deploys| KServeCtrl
    ModuleCtrl -->|deploys| LLMISVCCtrl
    ModuleCtrl -->|deploys| LocalModelCtrl

    %% Core controller watches
    ISVC -->|watched by| KServeCtrl
    IG -->|watched by| KServeCtrl
    TM -->|watched by| KServeCtrl
    SR -->|watched by| KServeCtrl

    LLMISVC -->|watched by| LLMISVCCtrl
    LLMISVCConfig -->|watched by| LLMISVCCtrl

    LMC -->|watched by| LocalModelCtrl
    LocalModelCtrl -->|creates| LocalModelAgent

    %% Controller creates resources
    KServeCtrl -->|creates| ISVC_Resources["Deployments<br/>Services<br/>HTTPRoutes<br/>VirtualServices"]
    KServeCtrl -->|validates| Webhooks["Admission Webhooks<br/>(24 total)"]
    KServeCtrl -->|injects| Agent
    KServeCtrl -->|injects| StorageInit
    KServeCtrl -->|injects| AuthProxy

    LLMISVCCtrl -->|creates| LLMISVC_Resources["Deployments / LWS<br/>InferencePools<br/>HTTPRoutes<br/>HPA / KEDA / WVA"]
    LLMISVCCtrl -->|deploys| EPP

    %% Routing
    IG -->|routed by| Router
    EPP -->|selects| vLLM

    %% Local model flow
    LocalModelAgent -->|creates download Jobs| LocalModelAgent
    LocalModelCtrl -->|creates PV/PVC| StorageInit

