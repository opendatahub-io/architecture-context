    style LocalModelCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LocalModelAgent fill:#4a90e2,stroke:#333,color:#fff
    style Agent fill:#e67e22,stroke:#333,color:#fff
    style StorageInit fill:#e67e22,stroke:#333,color:#fff
    style AuthProxy fill:#e67e22,stroke:#333,color:#fff
    style Router fill:#27ae60,stroke:#333,color:#fff
    style EPP fill:#27ae60,stroke:#333,color:#fff
    style AutoGluon fill:#f39c12,stroke:#333,color:#fff
    style vLLM fill:#f39c12,stroke:#333,color:#fff
    style ISVC fill:#f5a623,stroke:#333
    style LLMISVC fill:#f5a623,stroke:#333
    style IG fill:#f5a623,stroke:#333
    style SR fill:#f5a623,stroke:#333
    style TM fill:#f5a623,stroke:#333
