graph TB
    subgraph KServe["KServe Platform (Multi-Controller)"]
        direction TB

        subgraph Controllers["Controllers"]
            KServeCtrl["kserve-controller<br/>(cmd/manager)<br/>Go Operator<br/>9443/TCP webhook<br/>8080/TCP metrics"]
            LLMISvcCtrl["llmisvc-controller<br/>(cmd/llmisvc)<br/>Go Operator<br/>9443/TCP webhook<br/>8080/TCP metrics"]
            LocalModelCtrl["localmodel-controller<br/>(cmd/localmodel)<br/>Go Operator<br/>8081/TCP health"]
            LocalModelNodeAgent["localmodelnode-agent<br/>(cmd/localmodelnode)<br/>Go Operator (DaemonSet)<br/>8081/TCP health"]
            ModuleCtrl["kserve-module-controller<br/>(kserve-module/)<br/>Go Operator<br/>8081/TCP health"]
        end

        subgraph DataPlane["Data Plane Components"]
            Agent["inference-agent<br/>Sidecar<br/>Go Service<br/>8080/TCP"]
            Router["inference-router<br/>Graph Router<br/>Go Service<br/>8080/8443 TCP"]
            StorageInit["storage-initializer<br/>Init Container<br/>Python 3.11"]
        end

        subgraph Runtimes["Serving Runtimes"]
            AutoGluon["autogluon-server<br/>Python 3.12<br/>8080/TCP"]
            OtherRuntimes["Other ServingRuntimes<br/>(vLLM, TorchServe, etc.)"]
        end
    end

    subgraph CRDs["Custom Resource Definitions"]
        ISVC["InferenceService<br/>v1beta1"]
        LLMISVC["LLMInferenceService<br/>v1alpha2"]
        LLMISVCConfig["LLMInferenceServiceConfig<br/>v1alpha2"]
        IG["InferenceGraph<br/>v1alpha1"]
        TM["TrainedModel<br/>v1alpha1"]
        SR["ServingRuntime<br/>v1alpha1"]
        CSR["ClusterServingRuntime<br/>v1alpha1"]
        LMC["LocalModelCache<br/>v1alpha1"]
        LMNC["LocalModelNamespaceCache<br/>v1alpha1"]
        KserveCR["Kserve CR<br/>platform v1alpha1"]
    end

    User["Data Scientist / Client"] -->|creates| ISVC
    User -->|creates| LLMISVC
    User -->|creates| IG

    ISVC -->|watched by| KServeCtrl
    LLMISVC -->|watched by| LLMISvcCtrl
    LMC -->|watched by| LocalModelCtrl
    LMNC -->|watched by| LocalModelCtrl
    KserveCR -->|watched by| ModuleCtrl
    IG -->|watched by| KServeCtrl
    TM -->|watched by| KServeCtrl

    KServeCtrl -->|creates| PredictorDeploy["Predictor Deployment"]
    KServeCtrl -->|creates| KnativeSvc["Knative Service"]
    KServeCtrl -->|creates| HTTPRoute1["HTTPRoute / VirtualService"]
    KServeCtrl -->|injects| Agent
    KServeCtrl -->|injects| StorageInit

    LLMISvcCtrl -->|creates| WorkloadDeploy["Workload Deployment (vLLM)"]
    LLMISvcCtrl -->|creates| SchedulerDeploy["Scheduler (EPP) Deployment"]
    LLMISvcCtrl -->|creates| InferencePool["InferencePool"]
    LLMISvcCtrl -->|creates| HTTPRoute2["HTTPRoute"]
    LLMISvcCtrl -->|creates| LWS["LeaderWorkerSet (multi-node)"]

    LocalModelNodeAgent -->|creates| DownloadJob["Download Jobs"]

    ModuleCtrl -->|deploys| KServeCtrl
    ModuleCtrl -->|deploys| LLMISvcCtrl
    ModuleCtrl -->|deploys| LocalModelCtrl

    %% Styling
    style KServeCtrl fill:#4a90e2,color:#fff
    style LLMISvcCtrl fill:#4a90e2,color:#fff
    style LocalModelCtrl fill:#4a90e2,color:#fff
    style LocalModelNodeAgent fill:#4a90e2,color:#fff
    style ModuleCtrl fill:#4a90e2,color:#fff
    style Agent fill:#50c878,color:#fff
    style Router fill:#50c878,color:#fff
    style StorageInit fill:#50c878,color:#fff
    style AutoGluon fill:#9b59b6,color:#fff
    style OtherRuntimes fill:#9b59b6,color:#fff
    style ISVC fill:#f5a623
    style LLMISVC fill:#f5a623
    style LLMISVCConfig fill:#f5a623
    style IG fill:#f5a623
    style TM fill:#f5a623
    style SR fill:#f5a623
    style CSR fill:#f5a623
    style LMC fill:#f5a623
    style LMNC fill:#f5a623
    style KserveCR fill:#f5a623
    style User fill:#e8e8e8,stroke:#333
