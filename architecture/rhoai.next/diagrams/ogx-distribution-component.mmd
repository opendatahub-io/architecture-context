graph TB
    subgraph OGX["OGX Distribution Container"]
        direction TB
        Server["OGX Server<br/>(ogx-core)<br/>Port 8321/TCP"]
        BuildPipeline["Build Pipeline<br/>(gen_config.py, gen_containerfile.py,<br/>gen_lockfile.py, gen_distro_docs.py)"]
        ArtifactFetcher["Artifact Fetcher<br/>(fetch_artifacts.py)<br/>SHA-256 Validation"]
        Entrypoint["entrypoint.sh<br/>Secret _FILE Resolution<br/>Provider Activation"]

        Entrypoint -->|"exec"| Server
    end

    subgraph APIs["HTTP API Surface (8321/TCP)"]
        direction TB
        Responses["/v1/responses<br/>Agentic Workflows"]
        Messages["/v1/messages<br/>Anthropic Messages API"]
        Inference["/v1/inference/*<br/>Chat Completion, Embeddings"]
        VectorIO["/v1/vector-io/*<br/>Vector DB Operations"]
        Files["/v1/files/*<br/>File Management"]
        FileProc["/v1/file-processors/*<br/>Document Processing"]
        ToolRuntime["/v1/tool-runtime/*<br/>Tool Execution"]
        Batches["/v1/batches/*<br/>Batch Inference"]
    end

    subgraph InferenceProviders["Inference Providers (env-var activated)"]
        direction TB
        vLLM["vLLM"]
        OpenAI["OpenAI API"]
        Anthropic["Anthropic API"]
        Bedrock["AWS Bedrock"]
        Azure["Azure OpenAI"]
        VertexAI["Google Vertex AI"]
        Gemini["Google Gemini"]
        WatsonX["IBM WatsonX"]
    end

    subgraph VectorStores["Vector Storage Backends"]
        direction TB
        Milvus["Milvus"]
        pgvector["pgvector"]
        Qdrant["Qdrant"]
        FAISS["FAISS (local)"]
    end

    subgraph ToolProviders["Tool Providers"]
        direction TB
        BraveSearch["Brave Search"]
        TavilySearch["Tavily Search"]
        FileSearch["File Search (inline)"]
        MCPServers["MCP Servers"]
    end

    Client[Client] -->|"HTTP 8321/TCP<br/>OAuth2 JWT (conditional)"| Server
    Server --> APIs

    Server -->|"HTTP/HTTPS<br/>Bearer Token"| InferenceProviders
    Server -->|"HTTP/gRPC/SQL<br/>Token/Password"| VectorStores
    Server -->|"HTTPS<br/>API Key"| ToolProviders
    Server -->|"PostgreSQL 5432/TCP<br/>Username/Password"| PostgreSQL["PostgreSQL<br/>State Storage"]
    Server -->|"HTTPS 443/TCP<br/>AWS IAM"| S3["S3 / Object Storage"]
    Server -->|"OTLP<br/>HTTP/gRPC"| OTEL["OTEL Collector"]
    Server -->|"HTTPS 443/TCP"| JWKS["JWKS Endpoint<br/>Token Validation"]

    Operator["rhods-operator /<br/>opendatahub-operator"] -->|"deploys"| OGX
    BaseImage["AIPCC Base Image<br/>quay.io/aipcc/base-images/cpu:3.5.0"] -.->|"base layer"| OGX

    style Server fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Entrypoint fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style BuildPipeline fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    style ArtifactFetcher fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333,stroke-width:2px
    style S3 fill:#f5a623,stroke:#333,stroke-width:2px
    style OTEL fill:#f5a623,stroke:#333,stroke-width:2px
    style JWKS fill:#f5a623,stroke:#333,stroke-width:2px
    style Operator fill:#7ed321,stroke:#333,stroke-width:2px
    style BaseImage fill:#e8e8e8,stroke:#333,stroke-width:2px
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
