graph TB
    subgraph OGX["OGX Distribution (ogx-core)"]
        direction TB
        Entrypoint["entrypoint.sh<br/>Secret resolution, OTEL config"]
        Server["OGX Server<br/>v1.4.0+rhaiv.1<br/>Port 8321/TCP"]
        AuthMiddleware["Auth Middleware<br/>OAuth2 JWT validation"]
        AccessPolicy["Access Policy Engine<br/>Owner-based filtering"]

        Entrypoint --> Server
        Server --> AuthMiddleware
        AuthMiddleware --> AccessPolicy
    end

    subgraph InferenceProviders["Inference Providers"]
        direction LR
        vLLM["vLLM<br/>(primary)"]
        OpenAI["OpenAI API"]
        Anthropic["Anthropic API"]
        Azure["Azure OpenAI"]
        Bedrock["AWS Bedrock"]
        WatsonX["IBM WatsonX"]
        VertexAI["Google Vertex AI"]
        Gemini["Google Gemini"]
        SentenceTransformers["sentence-transformers<br/>(dependency-only)"]
    end

    subgraph VectorStores["Vector Store Providers"]
        direction LR
        Milvus["Milvus"]
        pgvector["pgvector"]
        Qdrant["Qdrant"]
        FAISS["FAISS<br/>(dependency-only)"]
        MilvusLite["milvus-lite<br/>(dependency-only)"]
    end

    subgraph ToolRuntimes["Tool Runtimes"]
        direction LR
        BraveSearch["Brave Search"]
        Tavily["Tavily Search"]
        MCP["MCP Runtime"]
        FileSearch["File Search"]
    end

    subgraph Storage["Persistent Storage"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        LocalFS["Local Filesystem"]
        S3["S3 Storage"]
    end

    Client["Client"] -->|"HTTP 8321/TCP<br/>OAuth2 JWT"| Server

    Server -->|"HTTP/HTTPS"| vLLM
    Server -->|"HTTPS/443"| OpenAI
    Server -->|"HTTPS/443"| Anthropic
    Server -->|"HTTPS/443"| Azure
    Server -->|"HTTPS/443"| Bedrock
    Server -->|"HTTPS/443"| WatsonX
    Server -->|"HTTPS/443"| VertexAI
    Server -->|"HTTPS/443"| Gemini
    Server -.->|"local"| SentenceTransformers

    Server -->|"HTTP/gRPC"| Milvus
    Server -->|"TCP/5432"| pgvector
    Server -->|"HTTP/gRPC 6333-6334"| Qdrant
    Server -.->|"local"| FAISS
    Server -.->|"local"| MilvusLite

    Server -->|"HTTPS/443"| BraveSearch
    Server -->|"HTTPS/443"| Tavily

    Server -->|"TCP/5432"| PostgreSQL
    Server -->|"local"| LocalFS
    Server -->|"HTTPS/443"| S3

    OGXOperator["ogx-operator"] -->|"Manages lifecycle"| OGX
    Prometheus["Prometheus"] -->|"Scrapes /metrics"| Server

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style Entrypoint fill:#4a90e2,stroke:#333,color:#fff
    style AuthMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style AccessPolicy fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style OGXOperator fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style vLLM fill:#e8e8e8,stroke:#333
