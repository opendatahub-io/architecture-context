graph LR
    Garak["Llama Stack Provider<br/>TrustyAI Garak"]

    %% Core External Dependencies
    Garak -->|"red-teaming framework<br/>probes, detectors, generators"| GarakFW["garak<br/>0.15.0+rhaiv.5"]
    Garak -->|"adapter interface<br/>JobSpec, OCI, MLflow"| EvalHubSDK["eval-hub-sdk<br/>0.4.2"]
    Garak -->|"pipeline SDK<br/>definition & submission"| KFP["kfp<br/>2.17.0"]
    Garak -->|"K8s extensions<br/>secret injection"| KFPKubernetes["kfp-kubernetes<br/>2.17.0"]
    Garak -->|"S3 client<br/>artifact storage"| Boto3["boto3<br/>1.43.46"]
    Garak -->|"adversarial prompt<br/>generation"| SDGHub["sdg-hub<br/>0.9.4"]

    %% Transitive Dependencies (via garak)
    GarakFW -->|"multi-provider LLM client"| LiteLLM["litellm<br/>1.84.0"]
    GarakFW -->|"probe models"| Torch["torch<br/>2.11.0"]
    GarakFW -->|"model interaction"| Transformers["transformers<br/>5.13.0"]

    %% Direct Utility Dependencies
    Garak -->|"DataFrame processing"| Pandas["pandas<br/>3.0.3"]
    Garak -->|"HTML report templating"| Jinja2["Jinja2<br/>3.1.6+"]

    %% Transitive Security Dependencies
    Garak -.->|"HTTP client (TLS-aware)"| HTTPX["httpx<br/>0.28.1"]
    Garak -.->|"TLS/crypto support"| Cryptography["cryptography<br/>49.0.0"]

    %% Internal Platform Dependencies
    Garak -->|"sidecar callback<br/>HTTP/8080"| EvalHubSvc["eval-hub Service"]
    Garak -->|"pipeline runs<br/>HTTPS/443"| KFPServer["Kubeflow Pipelines"]
    Garak -->|"artifact storage<br/>HTTPS/443"| S3["S3-compatible Storage"]
    Garak -->|"artifact persistence<br/>HTTPS/443"| OCI["OCI Registry"]
    Garak -->|"experiment tracking<br/>HTTPS/443"| MLflow["MLflow"]
    Garak -->|"Secrets, ConfigMaps<br/>HTTPS/443"| K8sAPI["Kubernetes API"]
    Garak -->|"base image config"| TrustyAIConfig["trustyai-service-operator-config<br/>ConfigMap"]

    %% Integration Points (consumers)
    OpenDataHubOp["opendatahub-operator"] -->|"creates ConfigMap"| TrustyAIConfig
    EvalHubSvc -->|"creates Job"| Garak

    %% External Services
    Garak -->|"probe prompts<br/>HTTPS/443"| TargetLLM["Target LLM"]
    Garak -->|"intents: judge,<br/>attack, evaluate"| AuxLLMs["Judge/Attacker/<br/>Evaluator LLMs"]
    Garak -->|"SDG prompts<br/>HTTPS/443"| SDGLLM["SDG LLM"]
    Garak -->|"model weights<br/>HTTPS/443"| HFHub["HuggingFace Hub"]

