graph LR
    KRP["kube-rbac-proxy<br/>(Sidecar Proxy)"]

    %% Kubernetes API Dependencies (Critical)
    KRP -->|"TokenReview<br/>HTTPS/443"| K8sAPI["Kubernetes API Server<br/>(authentication.k8s.io)"]
    KRP -->|"SubjectAccessReview<br/>HTTPS/443"| K8sAPI

    %% Internal Platform Dependencies
    KRP -->|"proxies to localhost<br/>HTTP/8080"| Upstream["Upstream Application<br/>(same pod)"]
    KRP -.->|"OIDC Discovery + JWKS<br/>HTTPS/443"| OIDC["OIDC Identity Provider<br/>(optional)"]

    %% Platform Integration (inbound)
    RhodsOp["rhods-operator<br/>(Gateway Controller)"] -->|"injects as sidecar"| KRP
    Gateway["Gateway API<br/>(HTTPRoute)"] -->|"routes traffic<br/>HTTPS/8443"| KRP
    Prom["Prometheus<br/>(openshift-monitoring)"] -->|"scrapes /metrics<br/>HTTPS/8443"| KRP
    CertMgr["cert-manager /<br/>Platform Operator"] -.->|"provisions TLS certs<br/>hot-reload"| KRP

    %% Go Module Dependencies
    subgraph GoModules["Go Module Dependencies"]
        direction TB
        K8sApi["k8s.io/api<br/>v0.35.2"]
        K8sApiServer["k8s.io/apiserver<br/>v0.35.2"]
        K8sClientGo["k8s.io/client-go<br/>v0.35.2"]
        K8sCompBase["k8s.io/component-base<br/>v0.35.2"]
        OklogRun["github.com/oklog/run<br/>v1.2.0"]
        Cobra["github.com/spf13/cobra<br/>v1.10.2"]
        XNet["golang.org/x/net<br/>v0.52.0"]
        GoOIDC["github.com/coreos/go-oidc<br/>v2.3.0"]
    end

    KRP -.->|"uses"| GoModules

    %% Styling
    style KRP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style Upstream fill:#4caf50,stroke:#333,color:#fff
    style OIDC fill:#999,stroke:#333,color:#fff
    style RhodsOp fill:#7ed321,stroke:#333,color:#fff
    style Gateway fill:#7ed321,stroke:#333,color:#fff
    style Prom fill:#7ed321,stroke:#333,color:#fff
    style CertMgr fill:#7ed321,stroke:#333,color:#fff
    style K8sApi fill:#e8e8e8,stroke:#666
    style K8sApiServer fill:#e8e8e8,stroke:#666
    style K8sClientGo fill:#e8e8e8,stroke:#666
    style K8sCompBase fill:#e8e8e8,stroke:#666
    style OklogRun fill:#e8e8e8,stroke:#666
    style Cobra fill:#e8e8e8,stroke:#666
    style XNet fill:#e8e8e8,stroke:#666
    style GoOIDC fill:#e8e8e8,stroke:#666
