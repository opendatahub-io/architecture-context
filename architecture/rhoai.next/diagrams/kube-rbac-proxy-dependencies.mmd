graph LR
    KRP["kube-rbac-proxy<br/>(Sidecar Proxy)"]

    %% External Dependencies (required)
    KRP -->|"TokenReview +<br/>SubjectAccessReview<br/>HTTPS/443"| K8sAPI["Kubernetes API Server<br/>v1.35+ (k8s.io/api v0.35.2)"]
    KRP -->|"Auth framework<br/>(delegating authenticator)"| K8sAPIServer["k8s.io/apiserver<br/>v0.35.2"]
    KRP -->|"In-cluster client<br/>(kubeconfig)"| K8sClientGo["k8s.io/client-go<br/>v0.35.2"]
    KRP -->|"CLI + TLS config"| K8sComponentBase["k8s.io/component-base<br/>v0.35.2"]
    KRP -->|"HTTP/2 + h2c"| GoNet["golang.org/x/net<br/>v0.52.0"]

    %% External Dependencies (conditional)
    KRP -.->|"OIDC token<br/>verification"| GoOIDC["github.com/coreos/go-oidc<br/>v2.3.0"]
    KRP -.->|"OIDC Discovery +<br/>JWKS keys<br/>HTTPS/443"| OIDCProvider["OIDC Identity Provider<br/>(optional)"]

    %% Internal Platform Dependencies
    RhodsOperator["rhods-operator<br/>(gateway controller)"] -->|"sidecar injection<br/>(pod spec)"| KRP
    KRP -->|"proxied requests<br/>HTTP/8080 (localhost)"| AppContainer["Component Application<br/>(upstream service)"]
    Prometheus["OpenShift Monitoring<br/>Prometheus"] -->|"metrics scraping<br/>HTTPS/8443<br/>(hardcoded allow)"| KRP
    CertManager["cert-manager /<br/>platform cert infra"] -->|"TLS cert provisioning<br/>(Secret mount)"| KRP

    %% Platform Gateway
    PlatformGW["Platform Gateway<br/>(Envoy)"] -->|"HTTPS/8443<br/>via HTTPRoute"| KRP

