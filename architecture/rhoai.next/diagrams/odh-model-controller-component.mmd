graph TB
    subgraph ODH["odh-model-controller Component"]
        direction TB

        subgraph Manager["odh-model-controller (manager)"]
            direction TB
            ISVCCtrl["InferenceService<br/>Controller"]
            LLMISVCCtrl["LLMInferenceService<br/>Controller"]
            SRCtrl["ServingRuntime<br/>Controller"]
            IGCtrl["InferenceGraph<br/>Controller"]
            GWCtrl["Gateway<br/>Controller"]
            NIMCtrl["NIM Account<br/>Controller"]
            SecretCtrl["Secret Controller<br/>(storage-config)"]
            CMCtrl["ConfigMap Controller<br/>(CA certs)"]
            PodCtrl["Pod Controller<br/>(Ray TLS)"]

            subgraph Webhooks["Admission Webhooks (9443/TCP)"]
                MutISVC["Mutating:<br/>InferenceService"]
                MutLLMISVC["Mutating:<br/>LLMInferenceService"]
                MutIG["Mutating:<br/>InferenceGraph"]
                MutPod["Mutating:<br/>Pod (Ray TLS)"]
                ValISVC["Validating:<br/>InferenceService"]
                ValIG["Validating:<br/>InferenceGraph"]
                ValNIM["Validating:<br/>NIM Account"]
            end

            subgraph SubReconcilers["ISVC Sub-Reconcilers"]
                RouteRec["Route Reconciler"]
                RBACRec["RBAC Reconciler"]
                MetricsSvcRec["Metrics Service<br/>Reconciler"]
                SMRec["ServiceMonitor<br/>Reconciler"]
                DashRec["Dashboard ConfigMap<br/>Reconciler"]
                KEDARec["KEDA Reconciler"]
                MRRec["Model Registry<br/>Reconciler"]
            end

            ISVCCtrl --> SubReconcilers
        end

        subgraph Server["model-serving-api (server)"]
            GWHandler["/api/v1/gateways<br/>Gateway Discovery"]
            SamplesHandler["/api/v1/samples/llm-d<br/>Sample Templates"]
            AuthMW["Auth Middleware<br/>Bearer Token + RBAC"]
            TLSReloader["TLS Cert Reloader<br/>(fsnotify)"]
        end
    end

    %% CRDs Watched
    ISVC_CR["InferenceService CR"]
    LLMISVC_CR["LLMInferenceService CR"]
    SR_CR["ServingRuntime CR"]
    IG_CR["InferenceGraph CR"]
    GW_CR["Gateway CR"]
    NIM_CR["NIM Account CR"]

    ISVC_CR -->|watched by| ISVCCtrl
    LLMISVC_CR -->|watched by| LLMISVCCtrl
    SR_CR -->|watched by| SRCtrl
    IG_CR -->|watched by| IGCtrl
    GW_CR -->|watched by| GWCtrl
    NIM_CR -->|watched by| NIMCtrl

    %% Resources Created
    ISVCCtrl -->|creates| Route["OpenShift Route"]
    ISVCCtrl -->|creates| SvcMon["ServiceMonitor"]
    ISVCCtrl -->|creates| MetricsSvc["Metrics Service"]
    LLMISVCCtrl -->|creates| AuthPolicy["Kuadrant AuthPolicy"]
    GWCtrl -->|creates| EnvoyFilter["Istio EnvoyFilter"]
    GWCtrl -->|creates| PodMon["PodMonitor"]
    NIMCtrl -->|creates| Template["OpenShift Template"]
    NIMCtrl -->|creates| PullSecret["Pull Secret"]
    SecretCtrl -->|creates| StorageConfig["storage-config Secret"]
    PodCtrl -->|injects| RayTLS["Ray TLS Certs"]

    %% External Dependencies
    ISVCCtrl -->|depends on| KServe["KServe"]
    LLMISVCCtrl -->|depends on| Kuadrant["Kuadrant"]
    GWCtrl -->|depends on| Istio["Istio"]
    KEDARec -->|depends on| KEDA["KEDA"]
    NIMCtrl -->|calls| NGC["NVIDIA NGC API"]

    %% Dashboard Integration
    Dashboard["RHOAI Dashboard"] -->|REST API| GWHandler

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style Server fill:#2196F3,color:#fff
    style Webhooks fill:#e8f0fe,color:#333
    style SubReconcilers fill:#e8f0fe,color:#333
    style ISVC_CR fill:#f5a623
    style LLMISVC_CR fill:#f5a623
    style SR_CR fill:#f5a623
    style IG_CR fill:#f5a623
    style GW_CR fill:#f5a623
    style NIM_CR fill:#f5a623
    style Route fill:#7ed321
    style SvcMon fill:#7ed321
    style MetricsSvc fill:#7ed321
    style AuthPolicy fill:#7ed321
    style EnvoyFilter fill:#7ed321
    style PodMon fill:#7ed321
    style Template fill:#7ed321
    style PullSecret fill:#7ed321
    style StorageConfig fill:#7ed321
    style RayTLS fill:#7ed321
    style KServe fill:#e8e8e8
    style Kuadrant fill:#e8e8e8
    style Istio fill:#e8e8e8
    style KEDA fill:#e8e8e8
    style NGC fill:#e8e8e8
    style Dashboard fill:#9c27b0,color:#fff
