graph TB
    subgraph ODH_MC["odh-model-controller Deployment"]
        direction TB
        ControllerMgr["Controller Manager<br/>cmd/main.go"]

        subgraph Reconcilers["Reconcilers (10)"]
            direction LR
            ISCtrl["InferenceService<br/>Controller"]
            LLMISCtrl["LLMInferenceService<br/>Controller"]
            GWCtrl["Gateway<br/>Controller"]
            SRCtrl["ServingRuntime<br/>Controller"]
            AcctCtrl["Account<br/>Controller"]
            CMCtrl["ConfigMap<br/>Controller"]
            SecCtrl["Secret<br/>Controller"]
            PodCtrl["Pod<br/>Controller"]
            IGCtrl["InferenceGraph<br/>Controller"]
            PWCtrl["ProfileWatcher<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks"]
            direction LR
            MutPod["Mutating<br/>Pod"]
            MutIS["Mutating<br/>InferenceService"]
            MutIG["Mutating<br/>InferenceGraph"]
            MutLLMIS["Mutating<br/>LLMInferenceService"]
            ValNIM["Validating<br/>NIM Account"]
            ValIG["Validating<br/>InferenceGraph"]
            ValIS["Validating<br/>InferenceService"]
        end

        ControllerMgr --> Reconcilers
        ControllerMgr --> Webhooks
    end

    subgraph MSA["model-serving-api Deployment"]
        direction TB
        APIServer["HTTP Server<br/>server/main.go"]
        GWDiscovery["Gateway Discovery<br/>/api/v1/gateways"]
        LLMDSamples["LLM-D Samples<br/>/api/v1/samples/llm-d"]
        APIServer --> GWDiscovery
        APIServer --> LLMDSamples
    end

    subgraph CRDs_Watched["CRDs Watched"]
        direction LR
        ISCR["InferenceService"]
        LLMISCR["LLMInferenceService"]
        IGCR["InferenceGraph"]
        SRCR["ServingRuntime"]
        NIMCR["NIM Account"]
        DSCR["DataScienceCluster"]
    end

    subgraph Resources_Created["Resources Created"]
        direction LR
        Routes["OpenShift Routes"]
        NetPol["NetworkPolicies"]
        SvcAcct["ServiceAccounts"]
        RoleBind["RoleBindings"]
        SvcMon["ServiceMonitors"]
        PodMon["PodMonitors"]
        AuthPol["Kuadrant AuthPolicies"]
        TrigAuth["KEDA TriggerAuths"]
        EnvFilt["EnvoyFilters"]
    end

    ISCR -->|watched by| ISCtrl
    LLMISCR -->|watched by| LLMISCtrl
    IGCR -->|watched by| IGCtrl
    SRCR -->|watched by| SRCtrl
    NIMCR -->|watched by| AcctCtrl
    DSCR -->|watched by| ControllerMgr

    ISCtrl -->|creates| Routes
    ISCtrl -->|creates| NetPol
    ISCtrl -->|creates| SvcAcct
    ISCtrl -->|creates| RoleBind
    ISCtrl -->|creates| SvcMon
    LLMISCtrl -->|creates| AuthPol
    LLMISCtrl -->|creates| TrigAuth
    GWCtrl -->|creates| EnvFilt
    GWCtrl -->|creates| PodMon

    KubeAPI["Kubernetes API<br/>6443/TCP"] -->|watches| ControllerMgr
    GWDiscovery -->|SelfSubjectAccessReview| KubeAPI

    style ControllerMgr fill:#4a90e2,color:#fff
    style APIServer fill:#4a90e2,color:#fff
    style ISCR fill:#f5a623
    style LLMISCR fill:#f5a623
    style IGCR fill:#f5a623
    style SRCR fill:#f5a623
    style NIMCR fill:#f5a623
    style DSCR fill:#f5a623
