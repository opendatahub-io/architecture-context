graph TB
    subgraph ODH["odh-model-controller Component"]
        direction TB

        subgraph Operator["Controller (Go Operator)"]
            ISVCReconciler["InferenceService<br/>Reconciler"]
            LLMReconciler["LLMInferenceService<br/>Reconciler"]
            GatewayReconciler["Gateway<br/>Reconciler"]
            NIMController["NIM Account<br/>Controller"]
            SecretController["Secret<br/>Controller"]
            ConfigMapController["ConfigMap<br/>Controller"]
            PodController["Pod<br/>Controller"]
            SRController["ServingRuntime<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks"]
            ISVCWebhook["InferenceService<br/>Defaulter/Validator"]
            LLMWebhook["LLMInferenceService<br/>Defaulter (v1alpha1/v1alpha2)"]
            PodWebhook["Pod Mutator<br/>(Ray TLS Injection)"]
            IGWebhook["InferenceGraph<br/>Validator"]
            NIMWebhook["NIM Account<br/>Validator (Singleton)"]
        end

        subgraph SubReconcilers["Sub-Reconcilers"]
            RouteReconciler["Route<br/>Reconciler"]
            CRBReconciler["ClusterRoleBinding<br/>Reconciler"]
            MetricsSvc["Metrics Service<br/>Reconciler"]
            MetricsSM["ServiceMonitor<br/>Reconciler"]
            KEDAReconciler["KEDA<br/>Reconciler"]
            AuthPolicyReconciler["AuthPolicy<br/>Reconciler"]
        end

        subgraph APIServer["model-serving-api (REST)"]
            GatewayAPI["/api/v1/gateways<br/>8443/TCP HTTPS"]
            SamplesAPI["/api/v1/samples/llm-d<br/>8443/TCP HTTPS"]
        end

        ISVCReconciler --> RouteReconciler
        ISVCReconciler --> CRBReconciler
        ISVCReconciler --> MetricsSvc
        ISVCReconciler --> MetricsSM
        ISVCReconciler --> KEDAReconciler
        LLMReconciler --> AuthPolicyReconciler
        GatewayReconciler --> AuthPolicyReconciler
    end

    %% CRDs Watched
    ISVC_CR["InferenceService CR"] -->|watched by| ISVCReconciler
    LLMISVC_CR["LLMInferenceService CR"] -->|watched by| LLMReconciler
    Gateway_CR["Gateway CR"] -->|watched by| GatewayReconciler
    NIM_CR["NIM Account CR"] -->|watched by| NIMController
    SR_CR["ServingRuntime CR"] -->|watched by| SRController
    Secret_R["Secrets"] -->|watched by| SecretController
    CM_R["ConfigMaps"] -->|watched by| ConfigMapController

    %% Webhook Intercepts
    ISVC_CR -.->|admission| ISVCWebhook
    LLMISVC_CR -.->|admission| LLMWebhook
    Pod_R["Pods (Ray TLS)"] -.->|admission| PodWebhook
    IG_CR["InferenceGraph CR"] -.->|admission| IGWebhook
    NIM_CR -.->|admission| NIMWebhook

    %% Webhook Dependencies
    ISVCWebhook -->|resolves| HWProfile["HardwareProfile CR"]
    ISVCWebhook -->|reads| ConnSecret["Connection Secrets"]
    LLMWebhook -->|resolves| HWProfile
    LLMWebhook -->|reads| ConnSecret

    %% Resources Created
    RouteReconciler -->|creates| Route["OpenShift Route"]
    CRBReconciler -->|creates| CRB["ClusterRoleBinding"]
    MetricsSvc -->|creates| MetricsSvcR["Metrics Service"]
    MetricsSM -->|creates| SM["ServiceMonitor"]
    KEDAReconciler -->|creates| TrigAuth["TriggerAuthentication"]
    AuthPolicyReconciler -->|creates| AuthPolicy["Kuadrant AuthPolicy"]
    GatewayReconciler -->|creates| EnvoyFilter["Istio EnvoyFilter"]
    GatewayReconciler -->|creates| PodMonitor["PodMonitor"]
    NIMController -->|creates| PullSecret["Pull Secret"]
    NIMController -->|creates| NIMConfig["NIM ConfigMap"]
    NIMController -->|creates| NIMTemplate["NIM ServingRuntime Template"]

    %% External Dependencies
    NIMController -->|calls| NIMAPI["NVIDIA NIM API<br/>443/TCP HTTPS"]
    ISVCReconciler -->|calls| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style Webhooks fill:#e8744f,stroke:#333,color:#fff
    style SubReconcilers fill:#50a3a2,stroke:#333,color:#fff
    style APIServer fill:#7b68ee,stroke:#333,color:#fff
    style ISVC_CR fill:#f5a623,stroke:#333
    style LLMISVC_CR fill:#f5a623,stroke:#333
    style Gateway_CR fill:#f5a623,stroke:#333
    style NIM_CR fill:#f5a623,stroke:#333
    style SR_CR fill:#f5a623,stroke:#333
    style IG_CR fill:#f5a623,stroke:#333
    style Route fill:#7ed321,stroke:#333
    style AuthPolicy fill:#7ed321,stroke:#333
    style EnvoyFilter fill:#7ed321,stroke:#333
    style NIMAPI fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
