graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (KServe Data Plane)"]
        Gateway["Istio Gateway /<br/>Knative / Gateway API<br/>TLS Termination<br/>AuthN/AuthZ enforcement"]
    end

    subgraph Pod["POD (InferenceService)"]
        direction TB

        subgraph InitPhase["Init Phase"]
            StorageInit["KServe Storage Initializer<br/>(Init Container)"]
        end

        subgraph Runtime["Runtime"]
            AutoGluon["autogluonserver<br/>UID 1001 (non-root)<br/>Ports: 8080/TCP HTTP, 8081/TCP gRPC<br/>No app-layer auth"]
            SharedVol["/mnt/models<br/>(Shared Volume)"]
        end

        StorageInit -->|"Write model artifacts"| SharedVol
        SharedVol -->|"Read models"| AutoGluon
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        Prometheus["Prometheus<br/>Metrics scrape"]
        KServeOp["KServe Operator<br/>CRD management"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelStorage["Model Storage<br/>(S3 / GCS / Azure / PVC)<br/>TLS 1.2+<br/>Cloud IAM"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (terminated at ingress)<br/>Bearer Token / OIDC"| Gateway
    Gateway -->|"HTTP/8080<br/>No encryption (pod-internal)<br/>No app-layer auth"| AutoGluon
    StorageInit -->|"HTTPS/443<br/>TLS 1.2+<br/>Cloud IAM / SA token"| ModelStorage
    Prometheus -->|"HTTP/8080<br/>GET /metrics<br/>Cluster-internal"| AutoGluon
    KServeOp -.->|"Kubernetes API<br/>CRD lifecycle"| Pod

    %% Service
    SVC["ClusterIP Service<br/>80/TCP → 8080/TCP"] -.->|"internal routing"| AutoGluon

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef clusterservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef volume fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Client external
    class Gateway ingress
    class AutoGluon,StorageInit pod
    class Prometheus,KServeOp clusterservice
    class ModelStorage externalservice
    class SharedVol volume
    class SVC clusterservice
