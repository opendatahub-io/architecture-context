graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph PodBoundary["INFERENCESERVICE POD"]
        direction TB

        subgraph AuthLayer["Auth Layer (Sidecar)"]
            KRBP["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS 1.3<br/>Bearer Token AuthN/AuthZ"]
        end

        subgraph AppLayer["Application Container"]
            Server["autogluonserver<br/>8080/TCP REST (HTTP)<br/>8081/TCP gRPC<br/>Non-root, arbitrary UID<br/>AIPCC CPU base (RHEL 9.6)"]
        end
    end

    subgraph ExternalStorage["EXTERNAL SERVICES (Egress)"]
        S3["S3 Object Storage<br/>s3.amazonaws.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
        GCS["Google Cloud Storage<br/>storage.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP Service Account"]
        Azure["Azure Blob Storage<br/>*.blob.core.windows.net<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Azure Identity"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF Token (optional)"]
    end

    subgraph Monitoring["MONITORING (Internal)"]
        Prometheus["Prometheus<br/>Scrapes 8080/TCP<br/>HTTP (cluster-internal)"]
    end

    subgraph Platform["PLATFORM CONTROL PLANE"]
        KServeOp["KServe Operator<br/>Creates InferenceService Pod<br/>Injects kube-rbac-proxy sidecar<br/>Mounts storage credentials"]
    end

    %% Flows
    Client -->|"HTTPS/8443<br/>TLS 1.3<br/>Bearer Token"| KRBP
    KRBP -->|"HTTP/8080<br/>plaintext (localhost)<br/>No auth (proxied)"| Server
    Server -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Server -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP SA"| GCS
    Server -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure Identity"| Azure
    Server -->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token"| HFHub
    Prometheus -->|"HTTP/8080<br/>scrape"| Server
    KServeOp -.->|"manages"| PodBoundary

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class KRBP auth
    class Server app
    class S3,GCS,Azure,HFHub externalservice
    class Prometheus monitoring
    class KServeOp platform
