graph LR
    TAI["TrustyAI<br/>Explainability Service"]

    %% Internal RHOAI Dependencies
    TAI -->|"gRPC V2 Predict<br/>(outbound)"| KServe["KServe<br/>Inference Server"]
    TAI -->|"gRPC V2 Predict<br/>(outbound)"| ModelMeshServing["ModelMesh<br/>Inference Server"]
    TAI -.->|"managed by<br/>(CRD lifecycle)"| Operator["TrustyAI Service<br/>Operator"]

    %% Inbound integrations
    ModelMeshPP["ModelMesh<br/>Payload Processor"] -->|"HTTP POST<br/>/consumer/kserve/v2"| TAI
    KServeLogger["KServe Inference<br/>Logger"] -->|"CloudEvents<br/>(Knative)"| TAI
    Prometheus["Prometheus"] -->|"scrape /q/metrics<br/>(ServiceMonitor)"| TAI
    Dashboard["RHOAI Dashboard"] -->|"REST API<br/>(fairness/drift)"| TAI

    %% External Dependencies (frameworks)
    TAI -->|"application framework"| Quarkus["Quarkus 3.8.5"]
    TAI -->|"gRPC client"| gRPC["io.grpc 1.75.0"]
    TAI -->|"CloudEvents"| Knative["Quarkus Funqy<br/>Knative Events"]
    TAI -->|"metrics export"| Micrometer["Micrometer<br/>Prometheus Registry"]
    TAI -->|"solver (CF)"| OptaPlanner["OptaPlanner 8.30.0"]

    %% External Services (optional storage)
    TAI -->|"JDBC/3306<br/>user/pass"| MariaDB["MariaDB/MySQL"]
    TAI -->|"HTTP(S)<br/>access key"| MinIO["MinIO"]
    TAI -->|"HTTPS/443<br/>SA token"| K8sAPI["Kubernetes API"]

