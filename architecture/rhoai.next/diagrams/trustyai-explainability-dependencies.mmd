graph LR
    TrustyAI["TrustyAI<br/>Explainability Service"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"operator mgmt<br/>CRD lifecycle"| Operator["trustyai-service-operator"]
    TrustyAI -->|"gRPC client + REST consumer<br/>inference payloads"| KServe["KServe / ModelMesh"]
    TrustyAI -->|"ConfigMap create/update<br/>registers as payload processor"| ModelServingCM["model-serving-config<br/>ConfigMap"]
    TrustyAI -->|"ConfigMap read<br/>storage, batch, schedule config"| TrustyAICM["trustyai-config<br/>ConfigMap"]
    TrustyAI -->|"metrics scrape<br/>/q/metrics"| Prometheus["Prometheus<br/>ServiceMonitor"]

    %% External Dependencies (Frameworks)
    TrustyAI -->|"application framework"| Quarkus["Quarkus 3.8.5"]
    TrustyAI -->|"KServe V2 protocol"| GRPC["gRPC 1.75.0"]
    TrustyAI -->|"message serialization"| Protobuf["Protobuf 3.25.5"]
    TrustyAI -->|"counterfactual solver"| OptaPlanner["OptaPlanner 8.30.0"]
    TrustyAI -->|"Python data interop"| Arrow["Apache Arrow 15.0.2"]
    TrustyAI -->|"network transport"| Netty["Netty 4.1.125.Final"]
    TrustyAI -->|"database ORM"| Hibernate["Hibernate ORM<br/>(via Quarkus)"]
    TrustyAI -->|"metrics publishing"| Micrometer["Micrometer +<br/>Prometheus Registry"]

    %% Storage backends
    TrustyAI -->|"object storage<br/>443/9000 HTTP(S)"| MinIO["MinIO / S3"]
    TrustyAI -->|"relational DB<br/>3306/TCP JDBC"| MariaDB["MariaDB / MySQL"]
    TrustyAI -->|"filesystem<br/>/inputs mount"| PVC["PersistentVolumeClaim"]

    %% Integration points (inbound)
    KnativeEventing["Knative Eventing"] -->|"CloudEvents<br/>inference req/res"| TrustyAI
    Dashboard["RHOAI Dashboard"] -->|"REST client<br/>fairness metrics UI"| TrustyAI

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI (green)
    style Operator fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelServingCM fill:#7ed321,stroke:#333,color:#fff
    style TrustyAICM fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style KnativeEventing fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff

    %% External frameworks (gray)
    style Quarkus fill:#999,stroke:#333,color:#fff
    style GRPC fill:#999,stroke:#333,color:#fff
    style Protobuf fill:#999,stroke:#333,color:#fff
    style OptaPlanner fill:#999,stroke:#333,color:#fff
    style Arrow fill:#999,stroke:#333,color:#fff
    style Netty fill:#999,stroke:#333,color:#fff
    style Hibernate fill:#999,stroke:#333,color:#fff
    style Micrometer fill:#999,stroke:#333,color:#fff

    %% External services (orange)
    style MinIO fill:#f5a623,stroke:#333,color:#fff
    style MariaDB fill:#f5a623,stroke:#333,color:#fff
    style PVC fill:#f5a623,stroke:#333,color:#fff
