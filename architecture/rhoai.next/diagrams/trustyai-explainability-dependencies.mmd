graph LR
    TrustyAI["TrustyAI<br/>Explainability"]

    %% External Framework Dependencies
    TrustyAI -->|"app framework"| Quarkus["Quarkus 3.20.6.2"]
    TrustyAI -->|"HTTP runtime"| Vertx["Vert.x 4.5.32"]
    TrustyAI -->|"network I/O"| Netty["Netty 4.1.125.Final"]
    TrustyAI -->|"metrics registry"| Micrometer["Micrometer<br/>(via Quarkus BOM)"]
    TrustyAI -->|"gRPC protocol"| Protobuf["Protobuf 3.25.5"]
    TrustyAI -->|"JSON serialization"| Jackson["Jackson 2.15.0"]
    TrustyAI -->|"constraint solver<br/>(counterfactual)"| OptaPlanner["OptaPlanner 8.30.0.Final"]
    TrustyAI -->|"CSV parsing"| CommonsCSV["Apache Commons CSV 1.9.0"]

    %% Optional External Dependencies
    TrustyAI -.->|"DB storage (optional)"| HibernateORM["Hibernate ORM<br/>(via Quarkus BOM)"]
    TrustyAI -.->|"S3 storage (optional)"| MinIOClient["MinIO Client 3.8.6<br/>(Quarkiverse)"]
    TrustyAI -.->|"Arrow IPC (optional)"| ApacheArrow["Apache Arrow"]

    %% Internal Platform Dependencies
    TrustyAI -->|"inbound metrics scrape<br/>GET /q/metrics"| Prometheus["Prometheus"]
    TrustyAI -->|"inbound inference payloads<br/>POST /consumer/kserve/v2"| ModelMesh["ModelMesh"]
    TrustyAI -->|"inbound CloudEvents<br/>(Knative Eventing)"| KServe["KServe"]
    TrustyAI -->|"outbound gRPC<br/>model predictions"| InferenceServers["KServe/ModelMesh<br/>Inference Servers"]

    %% Lifecycle
    Operator["TrustyAI Service<br/>Operator"] -->|"deploys & manages<br/>per namespace"| TrustyAI

    %% External Services
    TrustyAI -->|"storage (PVC mode)"| PVC["PVC Storage"]
    TrustyAI -.->|"storage (MINIO mode)"| MinIOServer["MinIO Server"]
    TrustyAI -.->|"storage (DATABASE mode)"| MariaDB["MariaDB/MySQL<br/>3306/TCP"]
    TrustyAI -->|"init container: oc apply<br/>model-serving-config"| K8sAPI["Kubernetes API"]

