graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        subgraph JobNS["Job Namespace"]
            Operator["Training Operator<br/>(codeflare/kubeflow)<br/>Kubernetes RBAC"]
            Container["fms-hf-tuning Container<br/>Image: UBI9 + CUDA 12.1<br/>Entrypoint: accelerate_launch.py<br/>No inbound ports"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS<br/>Auth: HF Token (optional)"]
        S3["S3-Compatible Storage<br/>Configured by runtime<br/>HTTPS TLS<br/>Auth: AWS credentials<br/>(S3_ACCESS_KEY_ID,<br/>S3_SECRET_ACCESS_KEY)"]
    end

    subgraph OptionalTrackers["OPTIONAL TRACKING SERVICES"]
        Aim["Aim Server<br/>Configured port<br/>TCP<br/>Encryption: Unknown<br/>Auth: None"]
        MLflow["MLflow Tracking Server<br/>Configured port<br/>HTTP/HTTPS<br/>Encryption: Configurable<br/>Auth: Unknown"]
    end

    %% Flows
    Operator -->|"Container Launch<br/>Kubernetes API<br/>RBAC"| Container
    Container -->|"HTTPS/443<br/>TLS<br/>HF Token (optional)<br/>Model + Dataset download"| HFHub
    Container -->|"HTTPS<br/>TLS<br/>AWS credentials<br/>Dataset download"| S3
    Container -.->|"TCP<br/>Encryption unknown<br/>Experiment metrics"| Aim
    Container -.->|"HTTP/HTTPS<br/>Configurable TLS<br/>Experiment metrics"| MLflow

    %% Styling
    classDef cluster fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef job fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5 5

    class Operator job
    class Container job
    class HFHub,S3 external
    class Aim,MLflow optional
