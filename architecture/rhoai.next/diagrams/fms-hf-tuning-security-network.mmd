graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE (mTLS)"]
        KFTO["Kubeflow Training Operator<br/>NS: kubeflow<br/>SA: training-operator"]
        Kueue["Kueue Controller<br/>(optional queue mgmt)"]
    end

    subgraph TrainingNS["TRAINING NAMESPACE (User namespace)"]
        direction TB

        subgraph Master["PyTorchJob Pod: Worker 0 (Master)"]
            FMSContainer["fms-hf-tuning container<br/>Image: quay.io/modh/fms-hf-tuning<br/>Base: UBI 9 + CUDA 12.1<br/>Entry: accelerate_launch.py<br/>No listening ports"]
        end

        subgraph Workers["PyTorchJob Pods: Worker 1..N"]
            WorkerContainers["fms-hf-tuning container<br/>(FSDP all-reduce peers)"]
        end

        PVC["PVC / Output Directory<br/>Model checkpoints<br/>LoRA adapters"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF Token (optional)"]

        subgraph OptionalTrackers["Optional Experiment Trackers"]
            AimStack["AimStack Server<br/>configurable port<br/>HTTP<br/>No auth"]
            MLflow["MLflow Server<br/>configurable port<br/>HTTP/HTTPS<br/>configurable auth"]
            ClearML["ClearML Server<br/>configurable port<br/>HTTPS TLS 1.2+<br/>API key auth"]
        end
    end

    %% Control plane flows
    Kueue -.->|"queue-name label"| KFTO
    KFTO -->|"K8s API<br/>mTLS<br/>ServiceAccount"| FMSContainer

    %% Inter-pod distributed training
    FMSContainer <-->|"TCP/29500<br/>NCCL/Gloo<br/>⚠️ plaintext<br/>⚠️ no auth"| WorkerContainers

    %% Egress flows
    FMSContainer -->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token"| HFHub
    FMSContainer -.->|"HTTP/HTTPS<br/>configurable"| AimStack
    FMSContainer -.->|"HTTP/HTTPS<br/>configurable"| MLflow
    FMSContainer -.->|"HTTPS<br/>TLS 1.2+<br/>API key"| ClearML

    %% Storage
    FMSContainer -->|"local filesystem<br/>safetensors"| PVC

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef training fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef worker fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef tracker fill:#ffe6cc,stroke:#d79b00,stroke-width:1px

    class KFTO,Kueue controlplane
    class FMSContainer training
    class WorkerContainers worker
    class HFHub external
    class PVC storage
    class AimStack,MLflow,ClearML tracker
