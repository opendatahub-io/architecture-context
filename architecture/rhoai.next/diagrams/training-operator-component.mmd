graph TB
    subgraph TrainingOperator["Training Operator (opendatahub namespace)"]
        direction TB
        Main["training-operator.v1<br/>Go controller-runtime operator"]
        WebhookServer["Webhook Server<br/>9443/TCP HTTPS"]
        MetricsServer["Metrics Server<br/>8080/TCP TLS"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP"]

        subgraph Controllers["Framework Controllers"]
            PyTorchCtrl["PyTorchJobReconciler"]
            TFCtrl["TFJobReconciler"]
            MPICtrl["MPIJobReconciler"]
            XGBoostCtrl["XGBoostJobReconciler"]
            PaddleCtrl["PaddleJobReconciler"]
            JAXCtrl["JAXJobReconciler"]
        end

        subgraph SharedBase["Shared Infrastructure"]
            JobController["JobController Base<br/>Pod/Service lifecycle,<br/>status aggregation,<br/>gang-scheduling"]
            CertController["OPA cert-controller<br/>Webhook TLS rotation"]
            TLSConfig["TLS Profile Reader<br/>OpenShift APIServer"]
        end

        Main --> Controllers
        Main --> WebhookServer
        Main --> MetricsServer
        Main --> HealthProbes
        PyTorchCtrl --> JobController
        TFCtrl --> JobController
        MPICtrl --> JobController
        XGBoostCtrl --> JobController
        PaddleCtrl --> JobController
        JAXCtrl --> JobController
        CertController --> WebhookServer
        TLSConfig --> WebhookServer
        TLSConfig --> MetricsServer
    end

    subgraph CRDs["Custom Resource Definitions (kubeflow.org/v1)"]
        PyTorchJob["PyTorchJob"]
        TFJob["TFJob"]
        MPIJob["MPIJob"]
        XGBoostJob["XGBoostJob"]
        PaddleJob["PaddleJob"]
        JAXJob["JAXJob"]
    end

    subgraph CreatedResources["Created Resources"]
        WorkerPods["Worker/Master Pods"]
        HeadlessSvc["Headless Services"]
        NetworkPol["NetworkPolicies<br/>(PyTorch only)"]
        PodGroups["PodGroups<br/>(gang-scheduling)"]
        KubectlInit["kubectl-delivery<br/>Init Container<br/>(MPI only)"]
    end

    User["User / SDK"] -->|creates| CRDs
    CRDs -->|watched by| Controllers
    WebhookServer -->|validates CREATE/UPDATE| CRDs

    PyTorchCtrl -->|creates| WorkerPods
    PyTorchCtrl -->|creates| HeadlessSvc
    PyTorchCtrl -->|creates| NetworkPol
    MPICtrl -->|injects| KubectlInit
    JobController -->|creates| PodGroups

    Controllers -->|CRUD via| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    TLSConfig -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]
    Prometheus["Prometheus"] -->|scrapes| MetricsServer

