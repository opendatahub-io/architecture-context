graph TB
    subgraph TrainingOperator["Training Operator (Go Operator)"]
        direction TB
        Controller["Training Operator Controller<br/>(controller-runtime)"]
        Webhook["Webhook Server<br/>9443/TCP HTTPS"]

        subgraph FrameworkControllers["Framework Controllers"]
            PyTorchCtrl["PyTorch Controller<br/>(elastic scaling, HPA,<br/>NetworkPolicy)"]
            TFCtrl["TensorFlow Controller<br/>(PS + worker topology)"]
            XGBoostCtrl["XGBoost Controller<br/>(master-worker)"]
            MPICtrl["MPI Controller<br/>(launcher-worker,<br/>per-job RBAC)"]
            PaddleCtrl["PaddlePaddle Controller<br/>(elastic scaling)"]
            JAXCtrl["JAX Controller<br/>(coordinator-worker)"]
        end

        subgraph SharedBase["Shared Base (pkg/controller.v1/common)"]
            JobController["JobController Base<br/>(pod lifecycle, service mgmt,<br/>status tracking, cleanup)"]
            PodControl["Pod Control"]
            ServiceControl["Service Control"]
            PodGroupControl["PodGroup Control"]
            Scheduling["Gang Scheduling"]
        end

        subgraph CertMgmt["Certificate Management"]
            CertController["OPA cert-controller<br/>(webhook cert rotation)"]
        end

        Controller --> FrameworkControllers
        PyTorchCtrl --> JobController
        TFCtrl --> JobController
        XGBoostCtrl --> JobController
        MPICtrl --> JobController
        PaddleCtrl --> JobController
        JAXCtrl --> JobController
        JobController --> PodControl
        JobController --> ServiceControl
        JobController --> PodGroupControl
        JobController --> Scheduling
        Controller --> Webhook
        CertController -->|rotates certs| Webhook
    end

    %% CRDs
    User["User / Data Scientist"] -->|creates| PyTorchJobCR["PyTorchJob CR"]
    User -->|creates| TFJobCR["TFJob CR"]
    User -->|creates| XGBoostJobCR["XGBoostJob CR"]
    User -->|creates| MPIJobCR["MPIJob CR"]
    User -->|creates| PaddleJobCR["PaddleJob CR"]
    User -->|creates| JAXJobCR["JAXJob CR"]

    %% CRD watches
    PyTorchJobCR -->|watched by| PyTorchCtrl
    TFJobCR -->|watched by| TFCtrl
    XGBoostJobCR -->|watched by| XGBoostCtrl
    MPIJobCR -->|watched by| MPICtrl
    PaddleJobCR -->|watched by| PaddleCtrl
    JAXJobCR -->|watched by| JAXCtrl

    %% Created resources
    PodControl -->|creates| TrainingPods["Training Pods<br/>(replicas)"]
    ServiceControl -->|creates| HeadlessSvc["Headless Services<br/>(per-pod DNS)"]
    PodGroupControl -->|creates| PodGroups["PodGroups<br/>(gang scheduling)"]

    %% Webhook validation
    K8sAPI["Kubernetes API Server"] -->|validates via| Webhook

    %% External dependencies
    Controller -->|reads TLS config| OpenShiftAPI["OpenShift APIServer"]
    PodGroups -->|scheduled by| Volcano["Volcano / scheduler-plugins"]
    Controller -->|CRUD via| K8sAPI

