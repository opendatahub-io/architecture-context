    style PaddleCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style JAXCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style JobController fill:#6baed6,stroke:#333,color:#fff
    style CertController fill:#6baed6,stroke:#333,color:#fff
    style TLSConfig fill:#6baed6,stroke:#333,color:#fff
