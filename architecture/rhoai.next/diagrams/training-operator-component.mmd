graph TB
    subgraph TrainingOperator["Training Operator (KFTO)"]
        direction TB
        Controller["Training Operator Controller<br/>(controller-runtime)"]

        subgraph Webhooks["Validating Webhooks (9443/TCP)"]
            WH_PT["PyTorchJob Webhook"]
            WH_TF["TFJob Webhook"]
            WH_XGB["XGBoostJob Webhook"]
            WH_Paddle["PaddleJob Webhook"]
            WH_JAX["JAXJob Webhook"]
        end

        CertRotator["Certificate Rotator<br/>(cert-controller)"]

        subgraph FrameworkControllers["Framework Controllers"]
            PyTorchCtrl["PyTorch Controller"]
            TFCtrl["TensorFlow Controller"]
            XGBoostCtrl["XGBoost Controller"]
            MPICtrl["MPI Controller"]
            PaddleCtrl["Paddle Controller"]
            JAXCtrl["JAX Controller"]
        end

        BaseJobCtrl["Base JobController<br/>(shared reconciliation)"]

        CertRotator -->|manages TLS certs| Webhooks
        PyTorchCtrl --> BaseJobCtrl
        TFCtrl --> BaseJobCtrl
        XGBoostCtrl --> BaseJobCtrl
        MPICtrl --> BaseJobCtrl
        PaddleCtrl --> BaseJobCtrl
        JAXCtrl --> BaseJobCtrl
    end

    %% CRDs
    subgraph CRDs["Custom Resource Definitions (kubeflow.org/v1)"]
        PyTorchJobCR["PyTorchJob"]
        TFJobCR["TFJob"]
        XGBoostJobCR["XGBoostJob"]
        MPIJobCR["MPIJob"]
        PaddleJobCR["PaddleJob"]
        JAXJobCR["JAXJob"]
    end

    %% User interaction
    User["User / SDK"] -->|creates| CRDs
    CRDs -->|admission| Webhooks
    CRDs -->|watched by| Controller

    %% Resources created
    Controller -->|creates| Pods["Training Pods<br/>(replicas)"]
    Controller -->|creates| HeadlessSvc["Headless Services<br/>(inter-replica DNS)"]
    PyTorchCtrl -->|creates| NetworkPolicy["NetworkPolicy<br/>(PyTorch only)"]
    PyTorchCtrl -->|creates| HPA["HorizontalPodAutoscaler<br/>(elastic training)"]
    MPICtrl -->|creates| ConfigMaps["ConfigMaps<br/>(hostfile, kubexec.sh)"]
    MPICtrl -->|creates| RBAC_Resources["SA + Role + RoleBinding<br/>(per MPI job)"]

    %% External dependencies
    Controller -->|API calls| K8sAPI["Kubernetes API Server"]
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer"]
    Controller -->|optional gang scheduling| Volcano["Volcano Scheduler"]
    Controller -->|optional gang scheduling| SchedPlugins["scheduler-plugins"]

    %% Monitoring
    Monitoring["OpenShift Monitoring<br/>(PodMonitor)"] -->|scrapes 8080/TCP| Controller

