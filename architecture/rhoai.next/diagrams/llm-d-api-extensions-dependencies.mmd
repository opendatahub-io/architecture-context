graph LR
    LLMDExt["llm-d-api-extensions<br/>(Python Library)"]

    %% Required Runtime Dependencies
    LLMDExt -->|"in-process plugin host<br/>(required)"| VLLM["vLLM<br/>(latest)"]
    LLMDExt -->|"HTTP route registration<br/>(required)"| FastAPI["FastAPI<br/>(latest)"]
    LLMDExt -->|"response models<br/>(required)"| Pydantic["Pydantic<br/>(>=2)"]

    %% Build Dependencies
    LLMDExt -.->|"build backend<br/>(build-time)"| Setuptools["setuptools<br/>(>=68.0)"]

    %% Test Dependencies
    LLMDExt -.->|"test runner<br/>(test-only)"| Pytest["pytest"]
    LLMDExt -.->|"async tests<br/>(test-only)"| PytestAsyncio["pytest-asyncio"]
    LLMDExt -.->|"HTTP test client<br/>(test-only)"| HTTPX["httpx"]

    %% Internal Platform Dependencies (consumers)
    LLMDRouter["llm-d Router/Scheduler"] -->|"HTTP consumer<br/>GET 8000/TCP"| LLMDExt

    %% vLLM internals accessed
    VLLM -->|provides| VllmConfig["VllmConfig<br/>ModelConfig<br/>SchedulerConfig<br/>CacheConfig"]
    VLLM -->|provides| EngineClient["EngineClient<br/>collective_rpc<br/>get_kv_cache_spec"]
    VLLM -->|provides| PluginFramework["vllm.endpoint_plugins<br/>entry point mechanism"]
    VLLM -->|provides| WorkerExt["Worker Extension<br/>--worker-extension-cls"]

    %% Styling
    style LLMDExt fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style VLLM fill:#e74c3c,stroke:#333,color:#fff
    style FastAPI fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style Setuptools fill:#ccc,stroke:#333
    style Pytest fill:#ccc,stroke:#333
    style PytestAsyncio fill:#ccc,stroke:#333
    style HTTPX fill:#ccc,stroke:#333
    style LLMDRouter fill:#9b59b6,stroke:#333,color:#fff
    style VllmConfig fill:#f5a623,stroke:#333
    style EngineClient fill:#f5a623,stroke:#333
    style PluginFramework fill:#f5a623,stroke:#333
    style WorkerExt fill:#f5a623,stroke:#333
