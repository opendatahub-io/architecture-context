graph LR
    MustGather["must-gather<br/>Diagnostic Collection Tool"]

    %% External Dependencies (required tools)
    MustGather -->|"namespace inspect<br/>(OCP only)"| OC["oc CLI v4.20+"]
    MustGather -->|"resource get/logs<br/>(xKS only)"| Kubectl["kubectl v1.33-1.34"]
    MustGather -->|"release values<br/>& manifests"| Helm["helm v4.1.4"]
    MustGather -->|"base image"| MustGatherBase["ose-must-gather-rhel9<br/>v4.20"]

    %% All access goes through kube-apiserver
    OC -->|"443/TCP HTTPS"| K8sAPI["kube-apiserver"]
    Kubectl -->|"443/TCP HTTPS"| K8sAPI
    Helm -->|"443/TCP HTTPS"| K8sAPI

    %% Internal Platform Dependencies (CRD reads via API server)
    K8sAPI -.->|"CRD read"| RhodsOp["rhods-operator<br/>DSCInitialization,<br/>DataScienceCluster"]
    K8sAPI -.->|"CRD read"| KServe["KServe<br/>InferenceService,<br/>ServingRuntime"]
    K8sAPI -.->|"CRD read"| DSP["Data Science Pipelines<br/>DSPApplication, Workflow"]
    K8sAPI -.->|"CRD read"| Dashboard["Dashboard<br/>OdhDashboardConfig"]
    K8sAPI -.->|"CRD read"| KubeRay["KubeRay<br/>RayCluster, RayJob"]
    K8sAPI -.->|"CRD read"| Kueue["Kueue<br/>ClusterQueue, Workload"]
    K8sAPI -.->|"CRD read"| TrainingOp["Training Operator<br/>PyTorchJob, TrainJob"]
    K8sAPI -.->|"CRD read"| ModelReg["Model Registry"]
    K8sAPI -.->|"CRD read"| TrustyAI["TrustyAI<br/>LMEvalJob, GuardrailsOrch"]
    K8sAPI -.->|"CRD read"| Feast["Feast Operator<br/>FeatureStore"]
    K8sAPI -.->|"CRD read"| LlamaStack["Llama-stack<br/>LlamaStackDistribution"]
    K8sAPI -.->|"CRD read"| MLflow["MLflow Operator"]
    K8sAPI -.->|"CRD read"| Spark["Spark Operator<br/>SparkApplication"]
    K8sAPI -.->|"CRD read"| AIGW["AI Gateway / MaaS<br/>AITenant, ExternalModel"]
    K8sAPI -.->|"CRD read"| MCP["MCP Lifecycle Operator<br/>MCPServer"]

    %% Networking / Infrastructure Dependencies
    K8sAPI -.->|"CRD read"| GatewayAPI["Gateway API<br/>Gateway, HTTPRoute,<br/>GRPCRoute"]
    K8sAPI -.->|"CRD read"| Istio["Istio / Sail Operator<br/>VirtualService,<br/>AuthorizationPolicy"]
    K8sAPI -.->|"CRD read"| CertManager["cert-manager<br/>Certificate, Issuer"]
    K8sAPI -.->|"CRD read"| LWS["LeaderWorkerSet"]
    K8sAPI -.->|"CRD read"| PrometheusOp["Prometheus Operator<br/>ServiceMonitor,<br/>PrometheusRule"]
    K8sAPI -.->|"CRD read"| Kuadrant["Kuadrant<br/>AuthPolicy,<br/>RateLimitPolicy"]
    K8sAPI -.->|"CRD read"| KEDA["KEDA<br/>ScaledObject, ScaledJob"]
    K8sAPI -.->|"CRD read"| NIM["NIM Account Operator"]

