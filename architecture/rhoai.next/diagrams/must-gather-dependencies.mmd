graph LR
    MustGather["must-gather<br/>(Diagnostic Utility)"]

    %% External Dependencies (build-time / runtime tools)
    MustGather -->|"base image"| MustGatherBase["ose-must-gather-rhel9<br/>v4.20"]
    MustGather -->|"kubectl binary"| OSECLI["ose-cli-rhel9<br/>v4.20"]
    MustGather -->|"helm binary"| Helm["Helm CLI<br/>v4.1.4 (Git LFS)"]
    MustGather -->|"resource inspection"| OC["oc CLI<br/>(from base image)"]
    MustGather -->|"xKS resource collection"| Kubectl["kubectl<br/>v1.33.3"]

    %% Kubernetes API (runtime)
    MustGather -->|"all API calls<br/>443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]

    %% Internal RHOAI Components (CRD reads)
    MustGather -->|"DSCInitialization,<br/>DataScienceCluster"| RHODSOp["rhods-operator"]
    MustGather -->|"InferenceService,<br/>ServingRuntime"| KServe["KServe"]
    MustGather -->|"DSPA, Argo Workflows"| DSP["Data Science Pipelines"]
    MustGather -->|"RayCluster,<br/>RayJob"| KubeRay["KubeRay"]
    MustGather -->|"ClusterQueue,<br/>Workload"| Kueue["Kueue"]
    MustGather -->|"PyTorchJob,<br/>TrainJob"| TrainingOp["Training Operator"]
    MustGather -->|"ModelRegistry CRs"| ModelReg["Model Registry"]
    MustGather -->|"LMEvalJob,<br/>TrustyAIService"| TrustyAI["TrustyAI"]
    MustGather -->|"ODHDashboardConfig,<br/>AcceleratorProfile"| Dashboard["Dashboard"]
    MustGather -->|"FeatureStore CRs"| Feast["Feast Operator"]
    MustGather -->|"LlamaStackDistribution"| LlamaStack["LlamaStack"]
    MustGather -->|"MLflow CRs"| MLflow["MLflow"]
    MustGather -->|"SparkApplication"| Spark["Spark Operator"]
    MustGather -->|"AITenant,<br/>MaaSSubscription"| AIGateway["AI Gateway"]
    MustGather -->|"MCPServer CRs"| MCPLifecycle["MCP Lifecycle Operator"]

    %% External Platform Dependencies (CRD reads)
    MustGather -->|"Gateway, HTTPRoute,<br/>GRPCRoute"| GatewayAPI["Gateway API"]
    MustGather -->|"VirtualService,<br/>AuthorizationPolicy"| Istio["Istio / Sail Operator"]
    MustGather -->|"Certificate, Issuer"| CertManager["cert-manager"]
    MustGather -->|"LeaderWorkerSet"| LWS["LWS Operator"]
    MustGather -->|"ServiceMonitor,<br/>PrometheusRule"| Prometheus["Prometheus Operator"]
    MustGather -->|"ScaledObject,<br/>TriggerAuth"| KEDA["KEDA"]
    MustGather -->|"AuthConfig"| Authorino["Authorino"]
    MustGather -->|"RateLimitPolicy"| Kuadrant["Kuadrant"]

