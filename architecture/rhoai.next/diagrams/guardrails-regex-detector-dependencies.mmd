graph LR
    RegexDetector["Guardrails<br/>Regex Detector"]

    %% Internal RHOAI Dependencies (called BY)
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>8080/TCP HTTP"| RegexDetector

    %% Rust Crate Dependencies
    subgraph "Rust Crate Dependencies"
        Axum["axum 0.7.9<br/>HTTP framework"]
        Tokio["tokio 1.41.1<br/>Async runtime"]
        Regex["regex 1.11.1<br/>Pattern matching"]
        Serde["serde 1.0.215<br/>JSON serialization"]
        TowerHTTP["tower-http 0.6.2<br/>HTTP middleware"]
        Tracing["tracing 0.1.41<br/>Structured logging"]
    end

    RegexDetector -->|"web framework"| Axum
    RegexDetector -->|"async runtime"| Tokio
    RegexDetector -->|"regex engine"| Regex
    RegexDetector -->|"serialization"| Serde
    RegexDetector -->|"request tracing"| TowerHTTP
    RegexDetector -->|"logging"| Tracing

    %% Build Dependencies
    subgraph "Build & Runtime"
        RustToolchain["Rust 1.84.0<br/>Toolchain"]
        UBI9["UBI9-minimal<br/>Runtime image"]
        OpenSSL["compat-openssl11<br/>(installed, unused)"]
    end

    RegexDetector -.->|"built with"| RustToolchain
    RegexDetector -.->|"runs on"| UBI9
    UBI9 -.->|"includes"| OpenSSL

    %% No External Services
    NoExternal["No External Services<br/>Pure in-memory processing"]
    RegexDetector -.->|"(no egress)"| NoExternal

    style RegexDetector fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Axum fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style Regex fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style TowerHTTP fill:#999,stroke:#333
    style Tracing fill:#999,stroke:#333
    style RustToolchain fill:#e8e8e8,stroke:#333
    style UBI9 fill:#e8e8e8,stroke:#333
    style OpenSSL fill:#e8e8e8,stroke:#333
    style NoExternal fill:#f9f9f9,stroke:#ccc,stroke-dasharray: 5 5
