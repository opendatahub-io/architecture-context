graph LR
    RegexDetector["Guardrails Regex<br/>Detector"]

    %% Internal Platform Dependencies (callers)
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>8080/TCP HTTP"| RegexDetector

    %% Rust Crate Dependencies
    RegexDetector -->|web framework| Axum["axum 0.7.9"]
    RegexDetector -->|pattern matching| Regex["regex 1.11.1"]
    RegexDetector -->|JSON serde| Serde["serde 1.0.215"]
    RegexDetector -->|async runtime| Tokio["tokio 1.41.1"]
    RegexDetector -->|HTTP middleware| TowerHTTP["tower-http 0.6.2"]
    RegexDetector -->|diagnostics| Tracing["tracing 0.1.41"]

    %% Platform Dependencies (not in code, but required)
    RegexDetector -.->|transport security| ServiceMesh["Service Mesh<br/>(mTLS)"]
    RegexDetector -.->|network isolation| NetworkPolicy["Network Policy"]

    style RegexDetector fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style Axum fill:#999,stroke:#333,color:#fff
    style Regex fill:#999,stroke:#333,color:#fff
    style Serde fill:#999,stroke:#333,color:#fff
    style Tokio fill:#999,stroke:#333,color:#fff
    style TowerHTTP fill:#999,stroke:#333,color:#fff
    style Tracing fill:#999,stroke:#333,color:#fff
    style ServiceMesh fill:#f5a623,stroke:#333,color:#fff
    style NetworkPolicy fill:#f5a623,stroke:#333,color:#fff
