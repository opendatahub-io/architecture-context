graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Edge TLS Termination)"]
        Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>TLS Edge Termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        Service["ClusterIP Service<br/>8080/TCP"]

        subgraph SidecarPod["Sidecar Pod (Namespace: hc4ai-operator)"]
            direction TB
            Sidecar["llm-d-routing-sidecar<br/>8000/TCP HTTPS<br/>TLS 1.2+ (6 AEAD ciphers)<br/>SA: operator-controller-manager"]
            AllowlistV["AllowlistValidator<br/>SSRF Protection (optional)"]
        end

        subgraph DecoderPod["Decoder Pod"]
            Decoder["Local vLLM Decoder<br/>8001/TCP"]
        end
    end

    subgraph RemoteWorkers["REMOTE WORKERS"]
        Prefiller["Remote vLLM Prefill Worker<br/>Host from x-prefiller-host-port<br/>SSRF allowlist validated"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS Edge"| Route
    Route -->|"TCP/8080<br/>TLS 1.2+ (app-level)"| Service
    Service -->|"HTTPS/8000<br/>TLS 1.2+"| Sidecar

    Sidecar -->|"HTTP(S)/header port<br/>Optional TLS 1.2+<br/>InsecureSkipVerify configurable"| Prefiller
    Sidecar -->|"HTTP(S)/8001<br/>Optional TLS 1.2+<br/>InsecureSkipVerify configurable"| Decoder

    AllowlistV -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    K8sAPI ---|"Watch events"| InferencePool

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef remote fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef sidecar fill:#4a90e2,color:#fff,stroke:#333,stroke-width:2px
    classDef ssrf fill:#f5a623,color:#fff,stroke:#333,stroke-width:2px

    class Client external
    class Route ingress
    class Service internal
    class Sidecar sidecar
    class AllowlistV ssrf
    class Decoder internal
    class Prefiller remote
    class K8sAPI,InferencePool controlplane
