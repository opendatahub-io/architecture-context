graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Gateway EPP"]
    end

    subgraph SidecarZone["SIDECAR (Pod-local Proxy)"]
        direction TB

        subgraph SidecarInternal["llm-d-routing-sidecar"]
            Proxy["Reverse Proxy<br/>8000/TCP HTTPS<br/>TLS 1.2+ (AEAD ciphers)<br/>Self-signed RSA 4096 or external cert"]
            Allowlist["AllowlistValidator<br/>(in-process)<br/>SSRF Protection<br/>Resync: 30s"]
        end
    end

    subgraph InferenceTargets["EGRESS - INFERENCE TARGETS"]
        direction LR
        Prefiller["Remote Prefiller Pod<br/>dynamic/TCP<br/>HTTP or HTTPS (optional TLS 1.2+)<br/>No Auth"]
        Decoder["Local vLLM Decoder<br/>(co-located in pod)<br/>8001/TCP (default)<br/>HTTP or HTTPS (optional TLS 1.2+)<br/>No Auth"]
    end

    subgraph ControlPlane["EGRESS - CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Bearer Token"]
    end

    subgraph StandaloneOnly["INGRESS (Standalone Testing Only)"]
        Route["OpenShift Route<br/>443/TCP → 8080/TCP<br/>TLS Edge Termination"]
        Service["ClusterIP Service<br/>8080/TCP HTTP<br/>Internal Only"]
    end

    %% External to Sidecar
    Client -->|"HTTPS/8000<br/>TLS 1.2+<br/>No Auth<br/>Header: x-prefiller-host-port"| Proxy

    %% Internal sidecar flow
    Proxy -->|"Validate target IP"| Allowlist
    Allowlist -.->|"403 if not allowed"| Proxy

    %% Sidecar to inference targets
    Proxy -->|"HTTP(S)/dynamic<br/>Optional TLS 1.2+<br/>SSRF-validated<br/>Modified body: do_remote_decode=true"| Prefiller
    Prefiller -->|"kv_transfer_params<br/>KV cache metadata"| Proxy
    Proxy -->|"HTTP(S)/8001<br/>Optional TLS 1.2+<br/>No Auth<br/>Injects kv_transfer_params"| Decoder

    %% Control plane
    Allowlist -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>Watch: InferencePool, Pods"| K8sAPI

    %% Standalone ingress
    Route -.->|"testing only"| Service
    Service -.->|"testing only"| Proxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sidecar fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef inference fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef standalone fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Proxy,Allowlist sidecar
    class Prefiller,Decoder inference
    class K8sAPI controlplane
    class Route,Service standalone
