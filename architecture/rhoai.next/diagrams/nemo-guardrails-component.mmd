graph TB
    subgraph NemoGuardrails["NeMo Guardrails Server"]
        direction TB

        subgraph API["API Layer (FastAPI/Uvicorn — Port 8000)"]
            ChatEndpoint["/v1/chat/completions<br/>POST"]
            ChecksEndpoint["/v1/guardrail/checks<br/>POST"]
            BasicChecks["/v1/checks<br/>POST (v1.0 only)"]
            ConfigsEndpoint["/v1/rails/configs<br/>GET"]
            ModelsEndpoint["/v1/models<br/>GET"]
            HealthEndpoint["/v1/health · /healthz<br/>GET"]
        end

        subgraph Pipeline["Guardrail Pipeline"]
            LLMRails["LLMRails / Guardrails<br/>Pipeline Orchestrator"]
            InputRails["Input Rails<br/>(jailbreak, content safety,<br/>topic safety)"]
            DialogRails["Dialog Rails<br/>(Colang flow control)"]
            OutputRails["Output Rails<br/>(hallucination, sensitive data,<br/>output validation)"]
            ToolRails["Tool Rails<br/>(tool-call & tool-result<br/>validation)"]
        end

        subgraph Runtime["Colang Runtimes"]
            ColangV1["Colang v1.0<br/>State-machine engine"]
            ColangV2["Colang v2.x<br/>Event-driven engine"]
        end

        subgraph Providers["Provider Layers"]
            LLMClient["LLM Client Layer<br/>(OpenAI, NIM, Anthropic,<br/>Azure, Cohere, TRT-LLM)"]
            EmbedProvider["Embedding Provider Layer<br/>(FastEmbed, SentenceTransformers,<br/>OpenAI, Cohere, NIM, Google, Azure)"]
        end

        subgraph Local["Local Models"]
            MiniLM["all-MiniLM-L6-v2<br/>(ONNX / FastEmbed)"]
            KnowledgeBase["Knowledge Base<br/>(Semantic Search)"]
        end

        HeaderFwd["Header Forwarding<br/>(X-Authorization → Authorization)"]
    end

    %% Internal flows
    ChatEndpoint --> LLMRails
    ChecksEndpoint --> LLMRails
    BasicChecks --> LLMRails

    LLMRails --> InputRails
    LLMRails --> DialogRails
    LLMRails --> OutputRails
    LLMRails --> ToolRails

    InputRails --> ColangV1
    InputRails --> ColangV2
    DialogRails --> ColangV1
    DialogRails --> ColangV2
    OutputRails --> ColangV1
    OutputRails --> ColangV2

    InputRails --> EmbedProvider
    OutputRails --> LLMClient
    InputRails --> LLMClient
    EmbedProvider --> MiniLM
    EmbedProvider --> KnowledgeBase

    LLMClient --> HeaderFwd

    %% External systems
    Client["Client<br/>(API Consumer)"]
    OpenAI["OpenAI API<br/>443/TCP HTTPS"]
    NIM["NVIDIA NIM<br/>443/TCP HTTPS"]
    Anthropic["Anthropic API<br/>443/TCP HTTPS"]
    AzureOAI["Azure OpenAI<br/>443/TCP HTTPS"]
    Cohere["Cohere API<br/>443/TCP HTTPS"]
    Triton["Triton Inference Server<br/>gRPC"]
    Redis["Redis (optional)<br/>6379/TCP"]
    OTELCollector["OpenTelemetry Collector<br/>4317/TCP gRPC"]

    Client -->|HTTP 8000/TCP<br/>X-Authorization| ChatEndpoint
    Client -->|HTTP 8000/TCP| ChecksEndpoint

    HeaderFwd -->|HTTPS 443| OpenAI
    HeaderFwd -->|HTTPS 443| NIM
    HeaderFwd -->|HTTPS 443| Anthropic
    HeaderFwd -->|HTTPS 443| AzureOAI
    HeaderFwd -->|HTTPS 443| Cohere
    LLMClient -->|gRPC| Triton

    LLMRails -.->|Redis protocol| Redis
    NemoGuardrails -.->|OTLP gRPC 4317| OTELCollector

    %% Styling
    style NemoGuardrails fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style API fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Pipeline fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Runtime fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Providers fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Local fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style OpenAI fill:#e8e8e8,stroke:#666
    style NIM fill:#76b900,stroke:#333,color:#fff
    style Anthropic fill:#e8e8e8,stroke:#666
    style AzureOAI fill:#e8e8e8,stroke:#666
    style Cohere fill:#e8e8e8,stroke:#666
    style Triton fill:#e8e8e8,stroke:#666
    style Redis fill:#d63029,stroke:#333,color:#fff
    style OTELCollector fill:#e8e8e8,stroke:#666

    style HeaderFwd fill:#ffcccc,stroke:#cc0000,stroke-width:2px
