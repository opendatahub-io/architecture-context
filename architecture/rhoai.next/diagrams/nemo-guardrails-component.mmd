graph TB
    subgraph NemoGuardrails["NeMo Guardrails Service"]
        direction TB
        Server["FastAPI Server<br/>(uvicorn :8000)"]
        Entrypoint["entrypoint.sh<br/>(config validation, OTel wrapping)"]

        subgraph Engines["Guardrail Engines"]
            GuardrailsClass["Guardrails Class<br/>(dispatcher)"]
            IORails["IORails Engine<br/>(modern — input/output pipelines)"]
            LLMRails["LLMRails Engine<br/>(legacy — Colang event-driven)"]
            GuardrailsClass -->|dispatches| IORails
            GuardrailsClass -->|dispatches| LLMRails
        end

        subgraph Colang["Colang DSL Runtimes"]
            ColangV1["Colang v1.0<br/>(simple flow model)"]
            ColangV2["Colang v2.x<br/>(concurrent flows, rich state)"]
        end

        subgraph GuardrailLib["Guardrail Library (30+ modules)"]
            ContentSafety["Content Safety"]
            Jailbreak["Jailbreak Detection"]
            PII["PII / Sensitive Data"]
            FactCheck["Fact-Checking"]
            Hallucination["Hallucination Detection"]
            ThirdParty["Third-Party Providers<br/>(ActiveFence, Pangea, CrowdStrike, ...)"]
        end

        subgraph ForkFeatures["Fork-Specific Features"]
            HeaderFwd["Header Forwarding<br/>(X-Authorization mapping)"]
            ChecksEndpoint["/v1/checks Endpoint<br/>(stateless guardrail eval)"]
            FilterScript["filter_guardrails.py<br/>(profile-based selection)"]
        end

        ActionDispatcher["ActionDispatcher<br/>(action resolution)"]

        Entrypoint -->|starts| Server
        Server -->|creates| GuardrailsClass
        IORails -->|uses| ColangV1
        LLMRails -->|uses| ColangV1
        LLMRails -->|uses| ColangV2
        GuardrailsClass -->|loads| GuardrailLib
        GuardrailsClass -->|resolves actions| ActionDispatcher
        Server -->|exposes| ChecksEndpoint
        Server -->|uses| HeaderFwd
    end

    Client[Client] -->|POST /v1/chat/completions<br/>POST /v1/checks| Server

    subgraph ExternalDeps["External Services"]
        LLM["LLM Inference Server<br/>(OpenAI-compatible)"]
        AzureOpenAI["Azure OpenAI"]
        SafetyAPIs["Third-Party Safety APIs"]
    end

    Server -->|inference requests<br/>HTTPS + Bearer token| LLM
    Server -->|alternative provider<br/>HTTPS + API key| AzureOpenAI
    GuardrailLib -->|safety evaluation<br/>HTTPS + API key| SafetyAPIs

    subgraph BakedModels["Baked-In ML Models (modelcars)"]
        MiniLM["MiniLM"]
        SnowflakeArctic["Snowflake Arctic Embed"]
        SpaCy["spaCy en_core_web_lg"]
        NLTK["NLTK punkt"]
        DeBERTa["DeBERTa Prompt Injection"]
        GraniteHAP["Granite Guardian HAP"]
    end

    GuardrailLib -->|local inference| BakedModels

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style GuardrailsClass fill:#4a90e2,stroke:#333,color:#fff
    style IORails fill:#4a90e2,stroke:#333,color:#fff
    style LLMRails fill:#4a90e2,stroke:#333,color:#fff
    style HeaderFwd fill:#e87d3e,stroke:#333,color:#fff
    style ChecksEndpoint fill:#e87d3e,stroke:#333,color:#fff
    style FilterScript fill:#e87d3e,stroke:#333,color:#fff
    style LLM fill:#999,stroke:#333
    style AzureOpenAI fill:#999,stroke:#333
    style SafetyAPIs fill:#999,stroke:#333
    style Client fill:#f5f5f5,stroke:#333
