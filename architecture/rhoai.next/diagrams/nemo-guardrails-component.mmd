graph TB
    subgraph NemoGuardrails["NeMo Guardrails Service"]
        direction TB

        subgraph Server["FastAPI Server (port 8000)"]
            API["API Router<br/>/v1/chat/completions<br/>/v1/checks<br/>/v1/models"]
            Health["Health Endpoints<br/>/v1/health, /healthz"]
        end

        subgraph Runtime["Colang Runtime"]
            ColangV1["Colang v1.0<br/>Transcript-based Flows"]
            ColangV2["Colang v2.x<br/>State-machine Flows"]
        end

        subgraph RailSystem["Rail Action System"]
            InputRails["Input Rails"]
            OutputRails["Output Rails"]
            RetrievalRails["Retrieval Rails"]
            DialogRails["Dialog Rails"]

            subgraph RailActions["Rail Actions (Open-Source)"]
                SelfCheck["Self-Check<br/>(facts, input, output)"]
                ContentSafety["Content Safety<br/>(multilingual)"]
                Hallucination["Hallucination<br/>Detection"]
                SDD["Sensitive Data<br/>Detection (Presidio)"]
                JailbreakDet["Jailbreak<br/>Detection"]
                TopicSafety["Topic Safety"]
                InjectionDet["Injection Detection<br/>(YARA rules)"]
                LlamaGuard["Llama Guard"]
                FactCheck["Fact Checking<br/>(AlignScore)"]
                HFClassifier["HuggingFace<br/>Classifier"]
            end
        end

        subgraph KBEngine["Knowledge Base Engine"]
            EmbeddingIndex["Embedding Index<br/>(FastEmbed / all-MiniLM-L6-v2)"]
        end

        subgraph LLMFramework["LLM Provider Framework"]
            OpenAIProvider["OpenAI"]
            NIMProvider["NVIDIA NIM"]
            AzureProvider["Azure OpenAI"]
            HFProvider["HuggingFace"]
            VLLMProvider["vLLM"]
        end

        Entrypoint["Entrypoint Script<br/>(config validation,<br/>OTel wrapping)"]
    end

    %% Internal flows
    API -->|"routes request"| Runtime
    Runtime -->|"executes"| InputRails
    Runtime -->|"executes"| OutputRails
    Runtime -->|"executes"| RetrievalRails
    Runtime -->|"executes"| DialogRails
    InputRails --> RailActions
    OutputRails --> RailActions
    RetrievalRails -->|"vector search"| EmbeddingIndex
    RailActions -->|"LLM calls"| LLMFramework

    %% External connections
    Client["Client"] -->|"HTTP POST<br/>port 8000"| API
    LLMFramework -->|"HTTPS/443"| UpstreamLLM["Upstream LLM<br/>(OpenAI / NIM / vLLM)"]
    JailbreakDet -->|"HTTP/1337"| JailbreakSvc["Jailbreak Detection<br/>Service"]
    FactCheck -->|"HTTP/5000"| AlignScoreSvc["AlignScore<br/>Service"]
    SDD -->|"in-process"| Presidio["Presidio<br/>(spaCy + en_core_web_lg)"]

    %% Styling
    style NemoGuardrails fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style Runtime fill:#9b59b6,stroke:#333,color:#fff
    style RailSystem fill:#f5f5f5,stroke:#666
    style RailActions fill:#fff3e0,stroke:#f5a623
    style KBEngine fill:#e8f5e9,stroke:#4caf50
    style LLMFramework fill:#fce4ec,stroke:#e91e63
    style API fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style UpstreamLLM fill:#999,stroke:#333,color:#fff
    style JailbreakSvc fill:#999,stroke:#333,color:#fff
    style AlignScoreSvc fill:#999,stroke:#333,color:#fff
    style Presidio fill:#999,stroke:#333,color:#fff
