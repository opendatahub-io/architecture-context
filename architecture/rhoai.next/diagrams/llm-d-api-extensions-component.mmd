graph TB
    subgraph LLMDApiExt["llm-d-api-extensions (Python Library)"]
        direction TB

        subgraph Plugins["vLLM Endpoint Plugins"]
            ConfigPlugin["ServerConfigPlugin<br/>GET /config<br/>Launch config, model info,<br/>scheduler, KV transfer"]
            DevicesPlugin["ServerDevicesPlugin<br/>GET /devices<br/>Per-rank GPU properties"]
            KVCachePlugin["ServerKVCachePlugin<br/>GET /kv-cache<br/>KV cache capacity,<br/>attention groups"]
        end

        subgraph WorkerExt["vLLM Worker Extension"]
            DeviceWorkerExt["DeviceInfoWorkerExtension<br/>--worker-extension-cls<br/>Collects device name, memory,<br/>compute capability per rank"]
        end

        subgraph Shared["Shared Infrastructure"]
            Common["common.py<br/>cached_response helper<br/>500/503 error handling"]
            Schemas["schemas.py<br/>Pydantic v2 models<br/>Discriminated unions"]
        end

        ConfigPlugin --> Common
        DevicesPlugin --> Common
        KVCachePlugin --> Common
        ConfigPlugin --> Schemas
        DevicesPlugin --> Schemas
        KVCachePlugin --> Schemas
        DevicesPlugin -->|collective_rpc| DeviceWorkerExt
    end

    subgraph VLLMHost["vLLM Inference Server (Host Process)"]
        FastAPIApp["FastAPI Application<br/>Port 8000/TCP"]
        VllmConfig["VllmConfig<br/>CacheConfig, SchedulerConfig,<br/>ModelConfig, ParallelConfig"]
        EngineClient["EngineClient<br/>collective_rpc"]
        Workers["Worker Processes<br/>Per-rank GPU execution"]
    end

    Router["llm-d Router/Scheduler<br/>(HTTP Consumer)"]

    %% Plugin registration
    ConfigPlugin -.->|entry point:<br/>vllm.endpoint_plugins| FastAPIApp
    DevicesPlugin -.->|entry point:<br/>vllm.endpoint_plugins| FastAPIApp
    KVCachePlugin -.->|entry point:<br/>vllm.endpoint_plugins| FastAPIApp

    %% Data access
    ConfigPlugin -->|reads| VllmConfig
    KVCachePlugin -->|reads| EngineClient
    DevicesPlugin -->|collective_rpc| EngineClient
    EngineClient -->|dispatches to| Workers
    DeviceWorkerExt -.->|mixed into| Workers

    %% External interaction
    Router -->|GET /plugins/llm-d-server-introspection/*<br/>HTTP 8000/TCP| FastAPIApp

    %% Styling
    style ConfigPlugin fill:#4a90e2,color:#fff
    style DevicesPlugin fill:#4a90e2,color:#fff
    style KVCachePlugin fill:#4a90e2,color:#fff
    style DeviceWorkerExt fill:#4a90e2,color:#fff
    style Common fill:#7ed321,color:#fff
    style Schemas fill:#7ed321,color:#fff
    style FastAPIApp fill:#f5a623,color:#fff
    style VllmConfig fill:#e8e8e8
    style EngineClient fill:#e8e8e8
    style Workers fill:#e8e8e8
    style Router fill:#9b59b6,color:#fff
