graph LR
    CaikitNLP["caikit-nlp<br/>(NLP Module Library)"]

    %% Internal Platform Dependencies
    CaikitNLP -->|"loaded by<br/>RUNTIME_LIBRARY=caikit_nlp"| CaikitRuntime["Caikit Runtime<br/>caikit >=0.26.34"]
    CaikitNLP -->|"TGIS abstraction"| CaikitTGISBackend["caikit-tgis-backend<br/>>=0.1.36"]
    CaikitNLP -->|"gRPC client"| TGIS["TGIS Server<br/>(gRPC, configurable TLS)"]

    %% Core ML Dependencies
    CaikitNLP -->|"model inference<br/>& training"| PyTorch["torch<br/>>=2.3.1,<2.5.0"]
    CaikitNLP -->|"model architectures<br/>& tokenizers"| Transformers["transformers<br/>>=4.38.0,<4.44.0"]
    CaikitNLP -->|"prompt tuning<br/>LoRA"| PEFT["peft<br/>==0.6.0"]
    CaikitNLP -->|"embeddings<br/>reranking"| SentenceTransformers["sentence-transformers<br/>>=3.0.0,<3.1.0"]
    CaikitNLP -->|"distributed training"| Accelerate["accelerate<br/>>=0.22.0"]

    %% Data & Compute Dependencies
    CaikitNLP -->|"training data"| Datasets["datasets<br/>>=2.4.0"]
    CaikitNLP -->|"model download"| HFHub["huggingface-hub"]
    CaikitNLP -->|"gRPC transport"| GRPC["grpcio<br/>>=1.62.2"]

    %% External Services
    CaikitNLP -.->|"optional download<br/>ALLOW_DOWNLOADS=1"| HFHubService["HuggingFace Hub<br/>huggingface.co :443"]

