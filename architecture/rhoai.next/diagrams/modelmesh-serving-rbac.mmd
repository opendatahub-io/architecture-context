graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["modelmesh-controller"]
        SA_ModelMesh["modelmesh"]
        SA_Serving["modelmesh-serving-sa"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["modelmesh-controller-rolebinding<br/>(Cluster-wide)"]
        CRB_SCC["modelmesh-controller-restricted-scc-rolebinding<br/>(Controller namespace)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["modelmesh-controller-leader-election-rolebinding<br/>(Controller namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Main["modelmesh-controller-role"]
        CR_Proxy["proxy-role"]
        CR_SCC["modelmesh-controller-restricted-scc-role"]
    end

    subgraph NamespacedRoles["Roles (Namespace-scoped)"]
        R_Leader["modelmesh-controller-leader-election-role"]
    end

    subgraph UserFacingRoles["User-Facing ClusterRoles"]
        CR_PredEditor["predictor-editor-role"]
        CR_PredViewer["predictor-viewer-role"]
        CR_SREditor["servingruntime-editor-role"]
        CR_SRViewer["servingruntime-viewer-role"]
        CR_ISVCEditor["inferenceservice-editor-role"]
        CR_ISVCViewer["inferenceservice-viewer-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps"]
        Endpoints["core<br/>endpoints"]
        PVCs["core<br/>persistentvolumeclaims"]
        Namespaces["core<br/>namespaces, namespaces/finalizers"]
        Secrets["core<br/>secrets"]
        Services["core<br/>services, services/finalizers"]
        Events["core<br/>events"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps<br/>deployments, deployments/finalizers"]
    end

    subgraph KServeResources["serving.kserve.io Resources"]
        ISVCs["serving.kserve.io<br/>inferenceservices<br/>+ finalizers, status"]
        Predictors["serving.kserve.io<br/>predictors<br/>+ finalizers, status"]
        SRuntimes["serving.kserve.io<br/>servingruntimes<br/>+ finalizers, status"]
        CSRuntimes["serving.kserve.io<br/>clusterservingruntimes<br/>+ finalizers, status"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPAs["autoscaling<br/>horizontalpodautoscalers<br/>+ status"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph SecurityResources["Security Resources"]
        SCC["security.openshift.io<br/>securitycontextconstraints<br/>(restricted)"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    %% Service Account to Binding
    SA_Controller -->|bound via| CRB_Main
    SA_Controller -->|bound via| CRB_SCC
    SA_Controller -->|bound via| RB_Leader
    SA_ModelMesh -->|bound via| CRB_SCC
    SA_Serving -->|bound via| CRB_SCC

    %% Binding to Role
    CRB_Main -->|grants| CR_Main
    CRB_SCC -->|grants| CR_SCC
    RB_Leader -->|grants| R_Leader

    %% ClusterRole to Resources
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ConfigMaps
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Secrets
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Services
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Deployments
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ISVCs
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Predictors
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| SRuntimes
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| CSRuntimes
    CR_Main -->|"get,list,watch,<br/>create,update,delete"| HPAs
    CR_Main -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ServiceMonitors

    CR_Proxy -->|create| TokenReviews
    CR_Proxy -->|create| SAR

    CR_SCC -->|use| SCC

    R_Leader -->|"create,get,list,<br/>update,watch,<br/>patch,delete"| Leases
    R_Leader -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| ConfigMaps
    R_Leader -->|create| Events

    %% User-facing roles
    CR_PredEditor -->|"full CRUD"| Predictors
    CR_PredViewer -->|"get,list,watch"| Predictors
    CR_SREditor -->|"full CRUD"| SRuntimes
    CR_SRViewer -->|"get,list,watch"| SRuntimes
    CR_ISVCEditor -->|"full CRUD"| ISVCs
    CR_ISVCViewer -->|"get,list,watch"| ISVCs

    %% Styling
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_ModelMesh fill:#4a90e2,stroke:#333,color:#fff
    style SA_Serving fill:#4a90e2,stroke:#333,color:#fff
    style CR_Main fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style CR_SCC fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style CR_PredEditor fill:#9b59b6,stroke:#333,color:#fff
    style CR_PredViewer fill:#9b59b6,stroke:#333,color:#fff
    style CR_SREditor fill:#9b59b6,stroke:#333,color:#fff
    style CR_SRViewer fill:#9b59b6,stroke:#333,color:#fff
    style CR_ISVCEditor fill:#9b59b6,stroke:#333,color:#fff
    style CR_ISVCViewer fill:#9b59b6,stroke:#333,color:#fff
    style ISVCs fill:#7ed321,stroke:#333
    style Predictors fill:#7ed321,stroke:#333
    style SRuntimes fill:#7ed321,stroke:#333
    style CSRuntimes fill:#7ed321,stroke:#333
