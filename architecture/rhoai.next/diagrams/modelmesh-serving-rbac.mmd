graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["modelmesh-serving-sa"]
    end

    subgraph Bindings["Role Bindings"]
        CRB["modelmesh-controller-rolebinding"]
        LEB["leader-election-rolebinding"]
    end

    subgraph Roles["Cluster Roles"]
        CR["modelmesh-controller-role<br/>(ClusterRole)"]
        LER["leader-election-role"]
    end

    subgraph CoreAPI["API Group: core ('')"]
        ConfigMaps["configmaps"]
        Secrets["secrets"]
        Services["services<br/>services/finalizers"]
        Endpoints["endpoints"]
        PVCs["persistentvolumeclaims"]
        Namespaces["namespaces<br/>namespaces/finalizers"]
    end

    subgraph AppsAPI["API Group: apps"]
        Deployments["deployments<br/>deployments/finalizers"]
    end

    subgraph KServeAPI["API Group: serving.kserve.io"]
        InferenceServices["inferenceservices<br/>+ /finalizers, /status"]
        Predictors["predictors<br/>+ /finalizers, /status"]
        ServingRuntimes["servingruntimes<br/>+ /finalizers, /status"]
        ClusterServingRuntimes["clusterservingruntimes<br/>+ /finalizers, /status"]
    end

    subgraph MonitoringAPI["API Group: monitoring.coreos.com"]
        ServiceMonitors["servicemonitors"]
    end

    subgraph AutoscalingAPI["API Group: autoscaling"]
        HPAs["horizontalpodautoscalers<br/>+ /status"]
    end

    %% Bindings
    SA -->|bound via| CRB
    SA -->|bound via| LEB
    CRB -->|grants| CR
    LEB -->|grants| LER

    %% Core API permissions
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| ConfigMaps
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| Secrets
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| Services
    CR -->|"get, list, watch"| Endpoints
    CR -->|"get, list, watch"| PVCs
    CR -->|"get, list, watch,<br/>update, patch"| Namespaces

    %% Apps API permissions
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| Deployments

    %% KServe API permissions
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| InferenceServices
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| Predictors
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| ServingRuntimes
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| ClusterServingRuntimes

    %% Monitoring API permissions
    CR -->|"get, list, watch,<br/>create, update, patch, delete"| ServiceMonitors

    %% Autoscaling API permissions
    CR -->|"get, list, watch,<br/>create, delete, update"| HPAs

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e8833a,stroke:#333,color:#fff
    style LEB fill:#e8833a,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style LER fill:#f5a623,stroke:#333
    style InferenceServices fill:#7ed321,stroke:#333
    style Predictors fill:#7ed321,stroke:#333
    style ServingRuntimes fill:#7ed321,stroke:#333
    style ClusterServingRuntimes fill:#7ed321,stroke:#333
    style ConfigMaps fill:#85bbf0,stroke:#333
    style Secrets fill:#85bbf0,stroke:#333
    style Services fill:#85bbf0,stroke:#333
    style Endpoints fill:#85bbf0,stroke:#333
    style PVCs fill:#85bbf0,stroke:#333
    style Namespaces fill:#85bbf0,stroke:#333
    style Deployments fill:#85bbf0,stroke:#333
    style ServiceMonitors fill:#c9a0dc,stroke:#333
    style HPAs fill:#c9a0dc,stroke:#333
