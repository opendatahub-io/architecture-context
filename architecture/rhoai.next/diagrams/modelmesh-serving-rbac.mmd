graph TD
    subgraph "Service Accounts"
        SA["modelmesh-controller<br/>(controller namespace)"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["modelmesh-controller-rolebinding<br/>(ClusterRoleBinding)"]
        CRB2["proxy-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph "Namespace Role Bindings"
        NRB1["modelmesh-controller-leader-election-rolebinding"]
        NRB2["modelmesh-controller-restricted-scc-rolebinding"]
        NRB3["modelmesh-controller-rolebinding<br/>(namespace-scoped)"]
    end

    subgraph "ClusterRoles"
        CR1["modelmesh-controller-role"]
        CR2["metrics-reader"]
        CR3["proxy-role"]
    end

    subgraph "Namespace Roles"
        NR1["modelmesh-controller-leader-election-role"]
        NR2["modelmesh-controller-restricted-scc-role"]
    end

    subgraph "Core API Resources"
        ConfigMaps["core<br/>configmaps"]
        Secrets["core<br/>secrets"]
        Services["core<br/>services, services/finalizers"]
        Endpoints["core<br/>endpoints"]
        PVCs["core<br/>persistentvolumeclaims"]
        Namespaces["core<br/>namespaces, namespaces/finalizers"]
    end

    subgraph "Apps API Resources"
        Deployments["apps<br/>deployments, deployments/finalizers"]
    end

    subgraph "Serving API Resources"
        CSR["serving.kserve.io<br/>ClusterServingRuntime<br/>+ finalizers"]
        SR["serving.kserve.io<br/>ServingRuntime<br/>+ finalizers"]
        Predictors["serving.kserve.io<br/>Predictor<br/>+ finalizers"]
        ISvc["serving.kserve.io<br/>InferenceService<br/>+ finalizers"]
        StatusRes["serving.kserve.io<br/>status subresources"]
    end

    subgraph "Monitoring Resources"
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph "Autoscaling Resources"
        HPAs["autoscaling<br/>horizontalpodautoscalers"]
    end

    subgraph "Auth Resources"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| NRB1
    SA -->|bound via| NRB2
    SA -->|bound via| NRB3
    CRB2 -->|grants| CR3

    CRB1 -->|grants| CR1
    NRB1 -->|grants| NR1
    NRB2 -->|grants| NR2

    %% ClusterRole permissions
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| ConfigMaps
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| Secrets
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| Services
    CR1 -->|"get, list, watch"| Endpoints
    CR1 -->|"get, list, watch"| PVCs
    CR1 -->|"get, list, patch,<br/>update, watch"| Namespaces
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| Deployments
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| CSR
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| SR
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| Predictors
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| ISvc
    CR1 -->|"get, patch, update"| StatusRes
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| ServiceMonitors
    CR1 -->|"create, delete, get,<br/>list, update, watch"| HPAs

    CR2 -->|"get"| MetricsURL
    CR3 -->|"create"| TokenReviews
    CR3 -->|"create"| SAR

