graph TB
    subgraph "ilab-on-ocp Pipeline Application"
        direction TB
        Compiler["Pipeline Compiler<br/>(KFP SDK)"]
        SDG["SDG Components<br/>(sdg/components.py)"]
        Training["Training Components<br/>(training/components.py)"]
        Eval["Evaluation Components<br/>(eval/)"]
        Utils["Utility Components<br/>(utils/components.py)"]

        Compiler -->|defines| SDG
        Compiler -->|defines| Training
        Compiler -->|defines| Eval
        Compiler -->|defines| Utils
    end

    subgraph "Runtime Image"
        RuntimeGeneric["odh-ml-pipelines-runtime-generic<br/>(UBI9 Python 3.12)"]
        MixtralTokenizer["Mixtral Tokenizer<br/>(/models)"]
        Skopeo["skopeo<br/>(OCI image tool)"]

        RuntimeGeneric --- MixtralTokenizer
        RuntimeGeneric --- Skopeo
    end

    subgraph "Pipeline Tasks at Runtime"
        direction TB
        PrereqTask["Prerequisite<br/>Validation"]
        SDGTask["SDG Task<br/>(RHELAI Image)"]
        TrainingTask["Training Task<br/>(PyTorchJob / FSDP)"]
        EvalTask["Evaluation Task<br/>(MT-Bench / MMLU)"]
        UploadTask["Model Upload<br/>(OCI + Registry)"]

        PrereqTask --> SDGTask
        SDGTask --> TrainingTask
        TrainingTask --> EvalTask
        EvalTask --> UploadTask
    end

    User["Data Scientist"] -->|compiles & submits| Compiler
    Compiler -->|produces| PipelineYAML["pipeline.yaml"]
    PipelineYAML -->|uploaded to| DSPA["Data Science Pipelines<br/>Application"]
    DSPA -->|executes tasks using| RuntimeGeneric

    %% External dependencies
    SDGTask -->|calls| TeacherModel["KServe Teacher Model<br/>(InferenceService)"]
    SDGTask -->|clones| TaxonomyRepo["Taxonomy Git Repo"]
    TrainingTask -->|creates| PyTorchJob["PyTorchJob<br/>(Training Operator)"]
    EvalTask -->|calls| JudgeModel["KServe Judge Model<br/>(InferenceService)"]
    UploadTask -->|pushes to| OCIRegistry["OCI Registry"]
    UploadTask -->|registers in| ModelRegistry["Model Registry"]
    PrereqTask -->|validates| K8sAPI["Kubernetes API"]

    %% PVC data flow
    SDGTask -->|writes| PVC["PVC<br/>(ReadWriteMany)"]
    TrainingTask -->|reads/writes| PVC
    EvalTask -->|reads| PVC

    style Compiler fill:#4a90e2,color:#fff
    style SDG fill:#4a90e2,color:#fff
    style Training fill:#4a90e2,color:#fff
    style Eval fill:#4a90e2,color:#fff
    style Utils fill:#4a90e2,color:#fff
    style RuntimeGeneric fill:#6c5ce7,color:#fff
    style DSPA fill:#7ed321
    style TeacherModel fill:#f5a623
    style JudgeModel fill:#f5a623
    style PyTorchJob fill:#f5a623
    style OCIRegistry fill:#e8e8e8
    style ModelRegistry fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style TaxonomyRepo fill:#e8e8e8
    style PVC fill:#dfe6e9
    style PipelineYAML fill:#dfe6e9
