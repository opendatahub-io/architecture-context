graph TD
    subgraph "Tenant Identity Model (Application-Level)"
        StateOwner["StateOwner<br/>(tenant_id + issuer + subject)<br/>Max 1024 bytes/component<br/>No control characters"]
    end

    subgraph "Identity Extraction (Security-Class Filters)"
        StateOwnerFilter["state_owner Filter<br/>(extracts tenant from request)"]
        PeerIdentity["peer_identity_trust Filter<br/>(mTLS certificate identity)"]
        BasicAuthFilter["basic_auth Filter<br/>(htpasswd validation)"]
    end

    subgraph "Credential Injection (Security-Class Filters)"
        CredInject["credential_inject Filter<br/>(per-route upstream auth)"]
        AWSSigV4["aws_sigv4_sign Filter<br/>(AWS SigV4 signing)"]
        AzureAD["azure_ad Filter<br/>(Azure AD token acquisition)"]
        GCPADC["gcp_adc Filter<br/>(GCP Application Default Credentials)"]
    end

    subgraph "Data Store Isolation"
        ResponseStore["ResponseStore Trait<br/>Every query owner-scoped"]
        ConversationStore["ConversationItemStore Trait<br/>Every query owner-scoped"]
        ApprovalStore["MCP Approval Store<br/>Atomic consumption prevents replay"]
    end

    subgraph "Storage Backends"
        PostgreSQL["PostgreSQL<br/>Row-level by<br/>(tenant_id, issuer, subject)"]
        SQLite["SQLite<br/>Row-level by<br/>(tenant_id, issuer, subject)"]
        Valkey["Redis / Valkey<br/>Key-prefixed per identity"]
    end

    %% Identity flow
    StateOwnerFilter -->|"constructs via<br/>from_trusted_parts"| StateOwner
    PeerIdentity -->|"extracts from<br/>mTLS cert"| StateOwner
    BasicAuthFilter -->|"validates<br/>credentials"| StateOwner

    %% Credential flow
    CredInject -->|"injects per-route<br/>Bearer / API key"| UpstreamAuth["Upstream Backend<br/>Authentication"]
    AWSSigV4 -->|"signs request"| UpstreamAuth
    AzureAD -->|"acquires token"| UpstreamAuth
    GCPADC -->|"acquires credentials"| UpstreamAuth

    %% Store isolation
    StateOwner -->|"scopes all queries"| ResponseStore
    StateOwner -->|"scopes all queries"| ConversationStore
    StateOwner -->|"scopes approvals"| ApprovalStore

    ResponseStore -->|"owner in WHERE clause"| PostgreSQL
    ResponseStore -->|"owner in WHERE clause"| SQLite
    ConversationStore -->|"owner in WHERE clause"| PostgreSQL
    ConversationStore -->|"owner in WHERE clause"| SQLite
    ApprovalStore -->|"owner-scoped"| PostgreSQL

    %% Wrong owner behavior
    ResponseStore -.->|"returns None<br/>for wrong owner"| WrongOwner["Cross-Tenant<br/>Access Denied"]

    style StateOwner fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style StateOwnerFilter fill:#ffe6cc,stroke:#d79b00
    style PeerIdentity fill:#ffe6cc,stroke:#d79b00
    style BasicAuthFilter fill:#ffe6cc,stroke:#d79b00
    style CredInject fill:#ffe6cc,stroke:#d79b00
    style AWSSigV4 fill:#ffe6cc,stroke:#d79b00
    style AzureAD fill:#ffe6cc,stroke:#d79b00
    style GCPADC fill:#ffe6cc,stroke:#d79b00
    style ResponseStore fill:#7ed321,stroke:#333
    style ConversationStore fill:#7ed321,stroke:#333
    style ApprovalStore fill:#7ed321,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style Valkey fill:#f5a623,stroke:#333
    style WrongOwner fill:#ff6b6b,stroke:#333,color:#fff
    style UpstreamAuth fill:#e8e8e8,stroke:#333
