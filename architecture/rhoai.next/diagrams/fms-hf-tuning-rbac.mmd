graph TD
    subgraph "fms-hf-tuning RBAC Model"
        direction TB
        Note["NOTE: fms-hf-tuning defines no RBAC resources.<br/>RBAC is managed by the Training Operator<br/>that launches fms-hf-tuning containers."]
    end

    subgraph "Training Operator (External RBAC)"
        direction TB
        OperatorSA["Training Operator<br/>ServiceAccount"]
        OperatorCRB["Operator ClusterRoleBinding"]
        OperatorCR["Operator ClusterRole"]
    end

    subgraph "Job-Level RBAC (Managed by Operator)"
        direction TB
        JobSA["Job ServiceAccount<br/>(assigned by operator)"]
        JobRole["Job Role/RoleBinding<br/>(namespace-scoped)"]
    end

    subgraph "Container Secrets (Environment Variables)"
        direction TB
        S3Key["S3_ACCESS_KEY_ID<br/>(Env Var)"]
        S3Secret["S3_SECRET_ACCESS_KEY<br/>(Env Var)"]
        ConfigEnv["SFT_TRAINER_CONFIG_JSON_ENV_VAR<br/>(Base64-encoded config)"]
    end

    OperatorSA -->|"bound via"| OperatorCRB
    OperatorCRB -->|"grants"| OperatorCR
    OperatorCR -->|"creates Jobs with"| JobSA
    JobSA -->|"bound via"| JobRole

    JobSA -->|"container runs as"| Container["fms-hf-tuning Container"]
    Container -->|"reads"| S3Key
    Container -->|"reads"| S3Secret
    Container -->|"reads"| ConfigEnv

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style OperatorSA fill:#4a90e2,stroke:#333,color:#fff
    style OperatorCRB fill:#f5a623,stroke:#333
    style OperatorCR fill:#f5a623,stroke:#333
    style JobSA fill:#4a90e2,stroke:#333,color:#fff
    style JobRole fill:#f5a623,stroke:#333
    style Container fill:#7ed321,stroke:#333
    style S3Key fill:#f8cecc,stroke:#b85450
    style S3Secret fill:#f8cecc,stroke:#b85450
    style ConfigEnv fill:#f8cecc,stroke:#b85450
