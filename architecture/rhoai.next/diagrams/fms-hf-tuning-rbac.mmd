graph TD
    subgraph "fms-hf-tuning RBAC Model"
        direction TB

        Note["NOTE: fms-hf-tuning does NOT define<br/>any RBAC resources directly.<br/>All RBAC is delegated to the<br/>Kubeflow Training Operator (KFTO)."]

        subgraph "KFTO-Managed RBAC"
            KFTO_SA["ServiceAccount<br/>kfto-controller-manager<br/>(Namespace: kubeflow)"]
            KFTO_CRB["ClusterRoleBinding<br/>kfto-manager-rolebinding"]
            KFTO_CR["ClusterRole<br/>kfto-manager-role"]
        end

        subgraph "KFTO Permissions (manages training jobs)"
            PyTorchJob["kubeflow.org<br/>PyTorchJob<br/>get, list, watch,<br/>create, update, delete"]
            Pods["core<br/>Pods<br/>get, list, watch,<br/>create, delete"]
            Services["core<br/>Services<br/>get, list, watch,<br/>create, delete"]
            ConfigMaps["core<br/>ConfigMaps<br/>get, list, watch"]
        end

        subgraph "Training Job Pod RBAC"
            Job_SA["ServiceAccount<br/>{configured in PyTorchJob spec}<br/>(Namespace: {user-namespace})"]
            Job_Role["Role/ClusterRole<br/>{user-configured}<br/>(depends on use case)"]
        end

        subgraph "Training Pod Permissions (varies)"
            PVCAccess["core<br/>PersistentVolumeClaims<br/>read (training data),<br/>write (output)"]
            SecretAccess["core<br/>Secrets<br/>read (HF_TOKEN,<br/>tracker credentials)"]
        end

        subgraph "External Auth (not RBAC)"
            HFToken["HuggingFace Hub<br/>Auth: Bearer Token (HF_TOKEN)<br/>Mounted as env var from Secret"]
            TrackerAuth["Experiment Trackers<br/>Auth: API Key (ClearML)<br/>or None (Aim, MLflow)"]
        end
    end

    KFTO_SA -->|bound via| KFTO_CRB
    KFTO_CRB -->|grants| KFTO_CR
    KFTO_CR -->|manages| PyTorchJob
    KFTO_CR -->|manages| Pods
    KFTO_CR -->|manages| Services
    KFTO_CR -->|reads| ConfigMaps

    Job_SA -->|bound via| Job_Role
    Job_Role -->|accesses| PVCAccess
    Job_Role -->|reads| SecretAccess

    SecretAccess -->|provides| HFToken
    SecretAccess -->|provides| TrackerAuth

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style KFTO_SA fill:#4a90e2,stroke:#333,color:#fff
    style KFTO_CR fill:#f5a623,stroke:#333
    style KFTO_CRB fill:#b8d4f0,stroke:#333
    style Job_SA fill:#4a90e2,stroke:#333,color:#fff
    style Job_Role fill:#f5a623,stroke:#333
    style PyTorchJob fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style PVCAccess fill:#7ed321,stroke:#333
    style SecretAccess fill:#7ed321,stroke:#333
    style HFToken fill:#e8e8e8,stroke:#333
    style TrackerAuth fill:#e8e8e8,stroke:#333
