graph TD
    subgraph Note["RBAC Note"]
        direction TB
        Info["fms-hf-tuning does NOT define its own RBAC.<br/>It is a batch training container, not an operator.<br/>RBAC is managed externally by the Kubeflow Training Operator<br/>and the PyTorchJob spec."]
    end

    subgraph KFTOManaged["Kubeflow Training Operator RBAC (manages this component)"]
        direction TB

        subgraph ServiceAccounts["Service Accounts"]
            KFTOSA["training-operator<br/>NS: kubeflow<br/>(operator SA)"]
            JobSA["user-configured SA<br/>NS: training namespace<br/>(PyTorchJob pod SA)"]
        end

        subgraph KFTORoles["Operator ClusterRole"]
            KFTORole["training-operator-role<br/>(manages PyTorchJob lifecycle)"]
        end

        subgraph KFTOResources["API Resources Managed"]
            PyTorchJob["kubeflow.org<br/>PyTorchJob"]
            Pods["core<br/>Pods"]
            Services["core<br/>Services"]
            ConfigMaps["core<br/>ConfigMaps"]
            Events["core<br/>Events"]
        end
    end

    subgraph PodPermissions["PyTorchJob Pod Permissions (fms-hf-tuning container)"]
        direction TB

        subgraph PodNeeds["Runtime Needs"]
            GPUAccess["GPU Device Access<br/>(nvidia.com/gpu resource)"]
            PVCAccess["PVC Read/Write<br/>(model checkpoints)"]
            ConfigMapRead["ConfigMap Read<br/>(training config)"]
            SecretRead["Secret Read (optional)<br/>(HF Token, tracker keys)"]
        end

        subgraph NoK8sAPI["No K8s API Access Needed"]
            NoAPINote["fms-hf-tuning does not<br/>interact with K8s API.<br/>Minimal SA recommended."]
        end
    end

    %% Flows
    KFTOSA -->|"bound via<br/>ClusterRoleBinding"| KFTORole
    KFTORole -->|"get, list, watch<br/>create, update, delete"| PyTorchJob
    KFTORole -->|"get, list, watch<br/>create, update, delete"| Pods
    KFTORole -->|"get, list, watch<br/>create, delete"| Services
    KFTORole -->|"get, list, create"| ConfigMaps
    KFTORole -->|"create, patch"| Events

    JobSA -->|"runs as"| GPUAccess
    JobSA -->|"mounts"| PVCAccess
    JobSA -->|"reads"| ConfigMapRead
    JobSA -.->|"optionally reads"| SecretRead

    %% Styling
    style Info fill:#fff3cd,stroke:#ffc107,stroke-width:2px,color:#856404
    style KFTOSA fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style JobSA fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style KFTORole fill:#f5a623,stroke:#333,stroke-width:2px
    style PyTorchJob fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
    style GPUAccess fill:#e1d5e7,stroke:#9673a6
    style PVCAccess fill:#e1d5e7,stroke:#9673a6
    style ConfigMapRead fill:#e1d5e7,stroke:#9673a6
    style SecretRead fill:#e1d5e7,stroke:#9673a6
    style NoAPINote fill:#f8cecc,stroke:#b85450,color:#b85450
