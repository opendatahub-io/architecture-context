graph TD
    subgraph ServiceAccounts["Service Accounts"]
        OperatorSA["model-registry-operator-<br/>controller-manager<br/>(Operator SA)"]
        RegistrySA["{name}<br/>(Per-Registry SA)"]
        CatalogSA["model-catalog<br/>(Catalog SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        ManagerCRB["manager-rolebinding"]
        AuthDelegatorCRB["{name}-auth-delegator<br/>(per registry)"]
        CatalogAuthCRB["model-catalog-<br/>auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        ManagerRole["manager-role"]
        AuthDelegator["system:auth-delegator"]
    end

    subgraph PerRegistryRBAC["Per-Registry RBAC (Namespaced)"]
        RegistryRole["registry-user-{name}<br/>(Role)"]
        RegistryRB["{name}-users<br/>(RoleBinding)"]
        RegistryGroup["{name}-users<br/>(OpenShift Group)"]
    end

    subgraph ManagerRoleResources["manager-role API Resources"]
        direction TB

        subgraph ModelRegistryCRDs["modelregistry.opendatahub.io"]
            MR_CRD["modelregistries<br/>get, list, watch,<br/>create, update, patch, delete"]
            MR_Status["modelregistries/status<br/>get, update, patch"]
            MR_Finalizers["modelregistries/finalizers<br/>update"]
        end

        subgraph CoreAPIs["Core APIs"]
            Pods["pods, pods/log<br/>get, list, watch"]
            Services["services, serviceaccounts<br/>get, list, watch,<br/>create, update, patch, delete"]
            ConfigSecrets["configmaps, secrets<br/>create, get, list, watch,<br/>update, patch, delete"]
            PVCs["persistentvolumeclaims<br/>get, list, watch,<br/>create, update, patch, delete"]
        end

        subgraph AppsAPIs["apps"]
            Deployments["deployments<br/>get, list, watch,<br/>create, update, patch, delete"]
        end

        subgraph OpenShiftAPIs["OpenShift APIs"]
            Routes["route.openshift.io<br/>routes, routes/custom-host<br/>get, list, watch, create,<br/>update, patch, delete"]
            Groups["user.openshift.io<br/>groups<br/>get, list, watch,<br/>create, update, delete"]
            OSIngress["config.openshift.io<br/>ingresses, apiservers<br/>get, list, watch"]
        end

        subgraph RBACAPIs["rbac.authorization.k8s.io"]
            Roles["roles, rolebindings,<br/>clusterrolebindings<br/>get, list, watch,<br/>create, update, patch, delete"]
        end

        subgraph AuthAPIs["Authentication / Authorization"]
            TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
            SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        end

        subgraph NetworkAPIs["Networking"]
            NetPolicies["networking.k8s.io<br/>networkpolicies<br/>get, list, watch,<br/>create, update, patch, delete"]
            HTTPRoutes["gateway.networking.k8s.io<br/>httproutes<br/>get, list, watch,<br/>create, update, patch, delete"]
            RefGrants["gateway.networking.k8s.io<br/>referencegrants<br/>get, list, watch, create"]
        end

        subgraph PlatformAPIs["Platform APIs"]
            PlatformMR["components.platform.<br/>opendatahub.io<br/>modelregistries<br/>get, list, watch"]
            PlatformAuth["services.platform.<br/>opendatahub.io<br/>auths<br/>get, list, watch"]
        end

        subgraph MigrationAPIs["Migration"]
            SVM["migration.k8s.io<br/>storageversionmigrations<br/>get, list, watch,<br/>create, update, patch, delete"]
            CRDs["apiextensions.k8s.io<br/>customresourcedefinitions<br/>get, list, watch"]
        end
    end

    %% Operator SA bindings
    OperatorSA -->|"bound via"| ManagerCRB
    ManagerCRB -->|"grants"| ManagerRole

    %% Manager role to resources
    ManagerRole -->|"permits"| MR_CRD
    ManagerRole -->|"permits"| MR_Status
    ManagerRole -->|"permits"| MR_Finalizers
    ManagerRole -->|"permits"| Pods
    ManagerRole -->|"permits"| Services
    ManagerRole -->|"permits"| ConfigSecrets
    ManagerRole -->|"permits"| PVCs
    ManagerRole -->|"permits"| Deployments
    ManagerRole -->|"permits"| Routes
    ManagerRole -->|"permits"| Groups
    ManagerRole -->|"permits"| OSIngress
    ManagerRole -->|"permits"| Roles
    ManagerRole -->|"permits"| TokenReviews
    ManagerRole -->|"permits"| SAR
    ManagerRole -->|"permits"| NetPolicies
    ManagerRole -->|"permits"| HTTPRoutes
    ManagerRole -->|"permits"| RefGrants
    ManagerRole -->|"permits"| PlatformMR
    ManagerRole -->|"permits"| PlatformAuth
    ManagerRole -->|"permits"| SVM
    ManagerRole -->|"permits"| CRDs

    %% Per-registry auth delegation
    RegistrySA -->|"bound via"| AuthDelegatorCRB
    AuthDelegatorCRB -->|"grants"| AuthDelegator
    CatalogSA -->|"bound via"| CatalogAuthCRB
    CatalogAuthCRB -->|"grants"| AuthDelegator

    %% Per-registry user access
    RegistryGroup -->|"bound via"| RegistryRB
    RegistryRB -->|"grants"| RegistryRole
    RegistryRole -->|"services/{name} get<br/>(access control)"| Services

    %% Styling
    style OperatorSA fill:#4a90e2,stroke:#333,color:#fff
    style RegistrySA fill:#4a90e2,stroke:#333,color:#fff
    style CatalogSA fill:#4a90e2,stroke:#333,color:#fff
    style ManagerRole fill:#f5a623,stroke:#333
    style AuthDelegator fill:#f5a623,stroke:#333
    style RegistryRole fill:#f5a623,stroke:#333
    style ManagerCRB fill:#50c8ff,stroke:#333
    style AuthDelegatorCRB fill:#50c8ff,stroke:#333
    style CatalogAuthCRB fill:#50c8ff,stroke:#333
    style RegistryRB fill:#50c8ff,stroke:#333
    style RegistryGroup fill:#9b59b6,stroke:#333,color:#fff
    style MR_CRD fill:#7ed321,stroke:#333
    style MR_Status fill:#7ed321,stroke:#333
    style MR_Finalizers fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style ConfigSecrets fill:#7ed321,stroke:#333
    style PVCs fill:#7ed321,stroke:#333
    style Deployments fill:#7ed321,stroke:#333
    style Routes fill:#7ed321,stroke:#333
    style Groups fill:#7ed321,stroke:#333
    style OSIngress fill:#7ed321,stroke:#333
    style Roles fill:#7ed321,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style NetPolicies fill:#7ed321,stroke:#333
    style HTTPRoutes fill:#7ed321,stroke:#333
    style RefGrants fill:#7ed321,stroke:#333
    style PlatformMR fill:#7ed321,stroke:#333
    style PlatformAuth fill:#7ed321,stroke:#333
    style SVM fill:#7ed321,stroke:#333
    style CRDs fill:#7ed321,stroke:#333
