graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_REG["{registry-name}<br/>(per-registry SA)"]
        SA_CAT["model-catalog<br/>(catalog SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_MGR["manager-rolebinding"]
        CRB_PROXY["auth-proxy-rolebinding"]
        CRB_REG_AUTH["{registry-name}-auth-delegator"]
        CRB_CAT_AUTH["model-catalog-auth-delegator"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_LEADER["leader-election-rolebinding<br/>(operator namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_MGR["manager-role"]
        CR_PROXY["proxy-role"]
        CR_AUTH_DEL["system:auth-delegator"]
        CR_VIEWER["modelregistry-viewer-role<br/>(user-facing)"]
        CR_EDITOR["modelregistry-editor-role<br/>(user-facing)"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_LEADER["leader-election-role"]
    end

    subgraph ManagerResources["manager-role Resources"]
        direction TB
        RES_CORE["Core API ('')<br/>configmaps, persistentvolumeclaims,<br/>secrets, serviceaccounts, services<br/>endpoints, pods, pods/log, events<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_APPS["apps<br/>deployments<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_MR["modelregistry.opendatahub.io<br/>modelregistries<br/>modelregistries/finalizers<br/>modelregistries/status<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_ROUTE["route.openshift.io<br/>routes, routes/custom-host<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_GW["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_NET["networking.k8s.io<br/>networkpolicies<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>rolebindings, roles<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_USER["user.openshift.io<br/>groups<br/><em>create,delete,get,<br/>list,update,watch</em>"]
        RES_MIGRATION["migration.k8s.io<br/>storageversionmigrations<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
        RES_PLATFORM["components.platform.opendatahub.io<br/>modelregistries<br/>services.platform.opendatahub.io<br/>auths<br/><em>get,list,watch</em>"]
        RES_OS_CONFIG["config.openshift.io<br/>apiservers, ingresses<br/>apiextensions.k8s.io<br/>customresourcedefinitions<br/><em>get,list,watch</em>"]
    end

    subgraph ProxyResources["proxy-role Resources"]
        RES_AUTH["authentication.k8s.io<br/>tokenreviews<br/>authorization.k8s.io<br/>subjectaccessreviews<br/><em>create</em>"]
    end

    subgraph LeaderResources["leader-election-role Resources"]
        RES_LEADER["Core: configmaps, events<br/>coordination.k8s.io: leases<br/><em>get,list,watch,create,<br/>update,patch,delete</em>"]
    end

    subgraph ViewerResources["viewer-role Resources"]
        RES_VIEW["modelregistry.opendatahub.io<br/>modelregistries<br/>modelregistries/status<br/><em>get,list,watch</em>"]
    end

    subgraph EditorResources["editor-role Resources"]
        RES_EDIT["modelregistry.opendatahub.io<br/>modelregistries<br/>modelregistries/status<br/><em>create,delete,get,list,<br/>patch,update,watch</em>"]
    end

    %% SA → Binding → Role → Resources
    SA_CM -->|"bound via"| CRB_MGR
    SA_CM -->|"bound via"| CRB_PROXY
    SA_CM -->|"bound via"| RB_LEADER

    SA_REG -->|"bound via"| CRB_REG_AUTH
    SA_CAT -->|"bound via"| CRB_CAT_AUTH

    CRB_MGR -->|"grants"| CR_MGR
    CRB_PROXY -->|"grants"| CR_PROXY
    CRB_REG_AUTH -->|"grants"| CR_AUTH_DEL
    CRB_CAT_AUTH -->|"grants"| CR_AUTH_DEL
    RB_LEADER -->|"grants"| R_LEADER

    CR_MGR -->|"permits"| ManagerResources
    CR_PROXY -->|"permits"| ProxyResources
    R_LEADER -->|"permits"| LeaderResources
    CR_VIEWER -->|"permits"| ViewerResources
    CR_EDITOR -->|"permits"| EditorResources

    %% Styling
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style SA_REG fill:#4a90e2,stroke:#333,color:#fff
    style SA_CAT fill:#4a90e2,stroke:#333,color:#fff

    style CRB_MGR fill:#9b59b6,stroke:#333,color:#fff
    style CRB_PROXY fill:#9b59b6,stroke:#333,color:#fff
    style CRB_REG_AUTH fill:#9b59b6,stroke:#333,color:#fff
    style CRB_CAT_AUTH fill:#9b59b6,stroke:#333,color:#fff
    style RB_LEADER fill:#8e44ad,stroke:#333,color:#fff

    style CR_MGR fill:#f5a623,stroke:#333
    style CR_PROXY fill:#f5a623,stroke:#333
    style CR_AUTH_DEL fill:#f5a623,stroke:#333
    style CR_VIEWER fill:#f5a623,stroke:#333
    style CR_EDITOR fill:#f5a623,stroke:#333
    style R_LEADER fill:#e67e22,stroke:#333,color:#fff

    style RES_CORE fill:#7ed321,stroke:#333
    style RES_APPS fill:#7ed321,stroke:#333
    style RES_MR fill:#7ed321,stroke:#333
    style RES_ROUTE fill:#7ed321,stroke:#333
    style RES_GW fill:#7ed321,stroke:#333
    style RES_NET fill:#7ed321,stroke:#333
    style RES_RBAC fill:#7ed321,stroke:#333
    style RES_USER fill:#7ed321,stroke:#333
    style RES_MIGRATION fill:#7ed321,stroke:#333
    style RES_PLATFORM fill:#7ed321,stroke:#333
    style RES_OS_CONFIG fill:#7ed321,stroke:#333
    style RES_AUTH fill:#7ed321,stroke:#333
    style RES_LEADER fill:#7ed321,stroke:#333
    style RES_VIEW fill:#7ed321,stroke:#333
    style RES_EDIT fill:#7ed321,stroke:#333
