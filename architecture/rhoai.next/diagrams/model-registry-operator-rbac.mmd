graph TD
    subgraph ServiceAccounts["Service Accounts"]
        OperatorSA["model-registry-operator<br/>-controller-manager"]
        CatalogSA["model-catalog"]
        RegistrySA["{registry-name}"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator<br/>-manager-rolebinding"]
        CRB_Metrics["model-registry-operator<br/>-metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (namespaced)"]
        RB_Leader["leader-election-rolebinding<br/>operator namespace"]
        RB_CatalogAuth["model-catalog-auth-delegator<br/>catalog namespace"]
        RB_CatalogUsers["model-catalog-authenticated<br/>catalog namespace"]
        RB_CatalogAdmin["model-catalog-admin-binding<br/>catalog namespace"]
        RB_RegistryAuth["{registry-name}-auth-delegator<br/>registry namespace"]
        RB_RegistryUsers["{registry-name}-users<br/>registry namespace"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-manager-role"]
        CR_Metrics["model-registry-operator-metrics-auth-role"]
        CR_MetricsReader["model-registry-operator-metrics-reader"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
    end

    subgraph Roles["Roles (namespaced)"]
        R_Leader["leader-election-role"]
        R_Catalog["model-catalog"]
        R_CatalogAdmin["model-catalog-admin"]
        R_RegistryUser["registry-user-{registry-name}"]
    end

    subgraph Groups["OpenShift Groups"]
        AuthGroup["system:authenticated"]
        AdminGroup["{admin-group}"]
        RegistryGroup["{registry-name}-users"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        CoreResources["Core API<br/>configmaps, PVCs, secrets<br/>serviceaccounts, services<br/>endpoints, pods, events"]
        AppsResources["apps<br/>deployments"]
        MRResources["modelregistry.opendatahub.io<br/>modelregistries<br/>+ finalizers + status"]
        GatewayResources["gateway.networking.k8s.io<br/>httproutes, referencegrants"]
        RouteResources["route.openshift.io<br/>routes, routes/custom-host"]
        RBACResources["rbac.authorization.k8s.io<br/>clusterrolebindings<br/>rolebindings, roles"]
        NetpolResources["networking.k8s.io<br/>networkpolicies"]
        UserResources["user.openshift.io<br/>groups"]
        PlatformResources["services.platform.opendatahub.io<br/>auths"]
        MigrationResources["migration.k8s.io<br/>storageversionmigrations"]
        AuthResources["authentication/authorization<br/>tokenreviews<br/>subjectaccessreviews"]
    end

    %% Operator SA bindings
    OperatorSA -->|bound via| CRB_Manager
    OperatorSA -->|bound via| CRB_Metrics
    OperatorSA -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader -->|grants| R_Leader

    %% Manager role permissions
    CR_Manager -->|"full CRUD"| CoreResources
    CR_Manager -->|"full CRUD"| AppsResources
    CR_Manager -->|"full CRUD"| MRResources
    CR_Manager -->|"full CRUD"| GatewayResources
    CR_Manager -->|"full CRUD"| RouteResources
    CR_Manager -->|"full CRUD"| RBACResources
    CR_Manager -->|"full CRUD"| NetpolResources
    CR_Manager -->|"full CRUD"| UserResources
    CR_Manager -->|"read only"| PlatformResources
    CR_Manager -->|"full CRUD"| MigrationResources
    CR_Manager -->|"create"| AuthResources

    %% Catalog SA bindings
    CatalogSA -->|bound via| RB_CatalogAuth
    RB_CatalogAuth -->|grants| CR_AuthDelegator
    AuthGroup -->|bound via| RB_CatalogUsers
    RB_CatalogUsers -->|grants| R_Catalog
    AdminGroup -->|bound via| RB_CatalogAdmin
    RB_CatalogAdmin -->|grants| R_CatalogAdmin

    %% Registry SA bindings
    RegistrySA -->|bound via| RB_RegistryAuth
    RB_RegistryAuth -->|grants| CR_AuthDelegator
    RegistryGroup -->|bound via| RB_RegistryUsers
    RB_RegistryUsers -->|grants| R_RegistryUser

    %% Styling
    style OperatorSA fill:#4a90e2,stroke:#333,color:#fff
    style CatalogSA fill:#4a90e2,stroke:#333,color:#fff
    style RegistrySA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_Admin fill:#f5a623,stroke:#333
    style CR_Editor fill:#f5a623,stroke:#333
    style CR_Viewer fill:#f5a623,stroke:#333
    style R_Leader fill:#e8c84a,stroke:#333
    style R_Catalog fill:#e8c84a,stroke:#333
    style R_CatalogAdmin fill:#e8c84a,stroke:#333
    style R_RegistryUser fill:#e8c84a,stroke:#333
    style CoreResources fill:#7ed321,stroke:#333
    style AppsResources fill:#7ed321,stroke:#333
    style MRResources fill:#7ed321,stroke:#333
    style GatewayResources fill:#7ed321,stroke:#333
    style RouteResources fill:#7ed321,stroke:#333
    style RBACResources fill:#7ed321,stroke:#333
    style NetpolResources fill:#7ed321,stroke:#333
    style UserResources fill:#7ed321,stroke:#333
    style PlatformResources fill:#7ed321,stroke:#333
    style MigrationResources fill:#7ed321,stroke:#333
    style AuthResources fill:#7ed321,stroke:#333
    style AuthGroup fill:#e1d5e7,stroke:#333
    style AdminGroup fill:#e1d5e7,stroke:#333
    style RegistryGroup fill:#e1d5e7,stroke:#333
