graph TB
    subgraph Platform["PLATFORM (Service Mesh / Network Policy Managed)"]
        Orchestrator["FMS Guardrails Orchestrator<br/>Upstream Caller"]
    end

    subgraph Application["APPLICATION (Stateless Service)"]
        Detector["Guardrails Regex Detector<br/>8080/TCP HTTP<br/>Axum 0.7.9 / Tokio<br/>UBI 9 Minimal"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        None["None<br/>No outbound connections"]
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>No App-Level TLS<br/>(platform-managed mTLS)<br/>No App-Level Auth<br/>(platform-managed)"| Detector

    %% No egress from detector
    Detector -.-|"No outbound<br/>connections"| None

    %% Styling
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px,stroke-dasharray: 5 5

    class Orchestrator platform
    class Detector application
    class None external
