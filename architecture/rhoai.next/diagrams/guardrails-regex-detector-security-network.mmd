graph TB
    subgraph InternalCluster["INTERNAL CLUSTER (Trusted Zone)"]
        direction TB

        subgraph CallerZone["Caller Service"]
            Orchestrator["FMS Guardrails Orchestrator<br/>Namespace: platform-managed"]
        end

        subgraph TargetZone["Target Service"]
            Detector["guardrails-regex-detector<br/>Rust (axum + tokio)<br/>Listen: 0.0.0.0:8080<br/>Base: ubi9/ubi-minimal<br/>User: root ⚠️"]

            subgraph Endpoints["Exposed Endpoints"]
                Health["GET /health<br/>→ 'healthy'"]
                Detect["POST /api/v1/text/contents<br/>→ detection results JSON"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        None["None<br/>No outbound connections"]
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>Plaintext (no TLS)<br/>No Auth<br/>POST /api/v1/text/contents"| Detector

    %% Security annotations
    Note1["⚠️ No TLS — plaintext HTTP<br/>⚠️ No authentication<br/>⚠️ Container runs as root<br/>⚠️ No NetworkPolicy in repo<br/>Relies on external network isolation"]

    %% Styling
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef caller fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef target fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef endpoint fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Orchestrator caller
    class Detector target
    class Health,Detect endpoint
    class None external
    class Note1 warning
