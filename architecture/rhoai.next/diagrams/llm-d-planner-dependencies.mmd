graph LR
    Planner["llm-d Planner<br/>(FastAPI + Streamlit)"]

    %% Required External Dependencies
    Planner -->|"database<br/>5432/TCP"| PostgreSQL["PostgreSQL 16<br/>(required)"]
    Planner -->|"LLM inference<br/>11434/TCP HTTP"| Ollama["Ollama<br/>(required, default LLM)"]
    Planner -->|"model metadata<br/>443/TCP HTTPS"| HFHub["HuggingFace Hub<br/>(required)"]
    Planner -->|"roofline model<br/>in-process"| BentoML["BentoML<br/>llm-optimizer<br/>(required)"]

    %% Optional External Dependencies
    Planner -.->|"LLM inference<br/>443/TCP HTTPS"| VertexAI["Vertex AI<br/>(optional LLM)"]
    Planner -.->|"LLM inference<br/>443/TCP HTTPS"| OpenAI["OpenAI-compatible<br/>(optional LLM)"]

    %% Internal RHOAI Dependencies
    Planner -->|"benchmark data<br/>8443/TCP HTTPS"| ModelCatalog["RHOAI Model Catalog<br/>(optional, RHOAI mode)"]
    Planner -->|"cluster mgmt<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API<br/>(required for deploy)"]

    %% Deployment Targets
    Planner -->|"generates CRD YAML"| KServe["KServe v0.14.0<br/>(target cluster)"]
    Planner -->|"generates manifests"| LLMDStack["llm-d Stack<br/>(kustomize + Helm)"]
    KServe -->|"runs"| vLLM["vLLM Runtime<br/>(target cluster)"]

    %% Platform Infrastructure
    Planner -.->|"CA bundle mount"| ServiceCA["OpenShift<br/>service-CA"]

    %% Key Python Libraries
    subgraph PythonDeps["Key Python Libraries"]
        FastAPI["FastAPI >=0.139.2"]
        Streamlit["Streamlit 1.60.0"]
        Pydantic["Pydantic 2.13.4"]
        Jinja2["Jinja2 3.1.6"]
        Transformers["transformers >=5.14.1"]
    end

    Planner -->|"web framework"| FastAPI
    Planner -->|"UI framework"| Streamlit
    Planner -->|"data validation"| Pydantic
    Planner -->|"YAML templates"| Jinja2
    Planner -->|"model config parsing"| Transformers

    %% Consumers (what depends on Planner)
    %% None detected — Planner is a leaf service

    %% Styling
    style Planner fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Ollama fill:#f5a623,stroke:#333,color:#fff
    style HFHub fill:#999,stroke:#333,color:#fff
    style BentoML fill:#999,stroke:#333,color:#fff
    style VertexAI fill:#ccc,stroke:#999
    style OpenAI fill:#ccc,stroke:#999
    style ModelCatalog fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style LLMDStack fill:#7ed321,stroke:#333,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style ServiceCA fill:#7ed321,stroke:#333,color:#fff
    style FastAPI fill:#e8e8e8,stroke:#aaa
    style Streamlit fill:#e8e8e8,stroke:#aaa
