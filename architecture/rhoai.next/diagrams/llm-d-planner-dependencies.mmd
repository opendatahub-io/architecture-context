graph LR
    Planner["llm-d-planner<br/>Backend API"]

    %% Internal RHOAI Dependencies
    Planner -->|"benchmark sync<br/>HTTPS/8443"| ModelCatalog["RHOAI Model Catalog"]
    Planner -->|"generates CRs<br/>serving.kserve.io/v1beta1"| KServe["KServe"]
    Planner -->|"generates overlays<br/>kustomize + Helm"| LLMDScheduler["llm-d Scheduler"]
    Planner -->|"generates<br/>ServiceMonitor CR"| Prometheus["Prometheus / Grafana"]

    %% Internal Platform Dependencies
    Planner -->|"external access<br/>TLS edge Routes"| OpenShiftRoutes["OpenShift Routes"]
    Planner -->|"CA injection<br/>annotation-based"| ServiceCA["OpenShift service-ca"]

    %% In-Cluster Dependencies
    Planner -->|"benchmark data<br/>PostgreSQL/5432"| PostgreSQL["PostgreSQL"]
    Planner -->|"LLM intent<br/>HTTP/11434"| Ollama["Ollama"]

    %% External API Dependencies
    Planner -->|"model metadata<br/>HTTPS/443"| HuggingFace["HuggingFace Hub<br/>huggingface.co"]
    Planner -->|"LLM provider<br/>HTTPS/443"| OpenAI["OpenAI API<br/>api.openai.com"]
    Planner -->|"LLM provider<br/>HTTPS/443"| VertexAI["Vertex AI<br/>googleapis.com"]
    Planner -->|"GPU detection<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]

    %% Library Dependencies (in-process)
    Planner -->|"roofline estimation<br/>in-process"| BentoML["BentoML llm-optimizer"]

    %% Reverse integration (who integrates with planner)
    ODHDashboard["ODH Dashboard"] -.->|"potential UI integration"| Planner
    DSPipelines["Data Science Pipelines"] -.->|"potential auto-deploy"| Planner

    %% Styling
    classDef primary fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    classDef rhoai fill:#7ed321,stroke:#333,color:#fff
    classDef platform fill:#e17055,stroke:#333,color:#fff
    classDef incluster fill:#fdcb6e,stroke:#333,color:#000
    classDef external fill:#dfe6e9,stroke:#636e72,color:#333
    classDef library fill:#a29bfe,stroke:#333,color:#fff
    classDef consumer fill:#fab1a0,stroke:#333,color:#000

    class Planner primary
    class ModelCatalog,KServe,LLMDScheduler rhoai
    class OpenShiftRoutes,ServiceCA,Prometheus platform
    class PostgreSQL,Ollama incluster
    class HuggingFace,OpenAI,VertexAI,K8sAPI external
    class BentoML library
    class ODHDashboard,DSPipelines consumer
