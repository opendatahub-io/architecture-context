graph LR
    GD["Guardrails Detectors"]

    %% Internal Platform Dependencies
    GD -->|"REST consumer<br/>:8080/:8000/TCP"| Orchestrator["FMS Guardrails<br/>Orchestrator"]
    GD -->|"CRD: InferenceService<br/>ServingRuntime"| KServe["KServe"]
    GD -->|"init container<br/>model download"| StorageInit["KServe Storage<br/>Initializer"]
    GD -->|"sidecar injection<br/>mTLS + auth"| Istio["Istio Service Mesh"]
    GD -->|"REST upstream<br/>Judge.from_url()"| vLLMServing["vLLM Serving"]

    %% External Services
    GD -->|"model storage<br/>:9000/TCP"| S3["S3 / MinIO"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>:8080/:8000"| GD

    %% UI Integration
    Dashboard["RHOAI Dashboard"] -.->|"opendatahub.io/dashboard<br/>annotation"| GD

    %% Key Python Dependencies
    subgraph PythonDeps["Key Python Dependencies"]
        direction TB
        FastAPI["fastapi 0.141.1"]
        Uvicorn["uvicorn 0.34.0"]
        Pydantic["pydantic 2.13.4"]
        Transformers["transformers >=5.3.0"]
        Torch["torch >=2.11.0"]
        VllmJudge["vllm-judge 0.1.8"]
        PromClient["prometheus-client >=0.18.0"]
        Regex["regex >=2024.0.0"]
    end

    GD -->|"all detectors"| FastAPI
    GD -->|"all detectors"| Uvicorn
    GD -->|"all detectors"| Pydantic
    GD -->|"HF detector"| Transformers
    GD -->|"HF detector (GPU)"| Torch
    GD -->|"Judge detector"| VllmJudge
    GD -->|"instrumentation"| PromClient
    GD -->|"built-in PII"| Regex

    style GD fill:#4a90e2,stroke:#333,stroke-width:4px
    style Orchestrator fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style StorageInit fill:#7ed321,stroke:#333
    style Istio fill:#7ed321,stroke:#333
    style vLLMServing fill:#7ed321,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style FastAPI fill:#e8e8e8,stroke:#333
    style Uvicorn fill:#e8e8e8,stroke:#333
    style Pydantic fill:#e8e8e8,stroke:#333
    style Transformers fill:#e8e8e8,stroke:#333
    style Torch fill:#e8e8e8,stroke:#333
    style VllmJudge fill:#e8e8e8,stroke:#333
    style PromClient fill:#e8e8e8,stroke:#333
    style Regex fill:#e8e8e8,stroke:#333
