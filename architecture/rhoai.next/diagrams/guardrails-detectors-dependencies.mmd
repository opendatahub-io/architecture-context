graph LR
    GD["Guardrails<br/>Detectors"]

    %% Internal RHOAI Platform Dependencies
    GD -->|"deployed as InferenceService"| KServe["KServe"]
    GD -->|"mTLS sidecar injection"| Istio["Istio Service Mesh"]
    GD -->|"auth sidecar (3.x)"| KRBAC["kube-rbac-proxy"]

    %% Consumer (calls detectors)
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>HTTP/8080, 8000"| GD

    %% Upstream Dependencies (detectors call these)
    GD -->|"model download (init)<br/>HTTP/9000"| S3["S3/Minio<br/>Model Storage"]
    GD -->|"LLM evaluation<br/>HTTP/8080"| vLLM["vLLM Server"]

    %% Observability
    Prometheus["Prometheus"] -.->|"scrape /metrics"| GD

    %% UI Integration
    Dashboard["RHOAI Dashboard"] -.->|"InferenceService visibility<br/>opendatahub.io/dashboard: true"| GD

    %% Build Dependencies (AIPCC)
    GD -.->|"base images"| AIPCC["AIPCC Base Images<br/>CPU + CUDA 13.0"]
    GD -.->|"package index"| RHAI["RHAI PyPI Index"]

    %% Key Python Libraries
    subgraph "External Libraries"
        FastAPI["FastAPI 0.136.3"]
        Transformers["transformers 4.57.3<br/>(HF only)"]
        PyTorch["torch 2.11.0<br/>(HF only)"]
        VllmJudge["vllm-judge 0.1.8<br/>(Judge only)"]
        PromClient["prometheus-client"]
    end

    GD -->|"HTTP framework"| FastAPI
    GD -->|"model loading"| Transformers
    GD -->|"inference runtime"| PyTorch
    GD -->|"judge evaluation"| VllmJudge
    GD -->|"metrics"| PromClient

    style GD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style KRBAC fill:#7ed321,stroke:#333,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style AIPCC fill:#e8e8e8,stroke:#333
    style RHAI fill:#e8e8e8,stroke:#333
    style FastAPI fill:#999,stroke:#333,color:#fff
    style Transformers fill:#999,stroke:#333,color:#fff
    style PyTorch fill:#999,stroke:#333,color:#fff
    style VllmJudge fill:#999,stroke:#333,color:#fff
    style PromClient fill:#999,stroke:#333,color:#fff
