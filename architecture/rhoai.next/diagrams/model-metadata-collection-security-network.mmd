graph TB
    subgraph BuildEnv["BUILD ENVIRONMENT (CI/CD Only)"]
        direction TB

        subgraph Pipeline["Tekton Pipeline (Konflux)"]
            Extractor["model-extractor<br/>Go CLI<br/>CGO_ENABLED=0"]
        end
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (Build-Time Egress)"]
        HF["HuggingFace API<br/>huggingface.co<br/>TLS (Go default)"]
        Registry["Container Registry<br/>registry.redhat.io<br/>TLS (Go default)"]
        GitHub["GitHub API<br/>raw.githubusercontent.com<br/>TLS (Go default)"]
    end

    subgraph RuntimeEnv["RUNTIME ENVIRONMENT (Cluster)"]
        direction TB

        subgraph DataPod["Data Container Pod"]
            Container["Data Container<br/>Image: ubi9/ubi-minimal-pqc<br/>UID: 1001 (non-root)<br/>CMD: sleep infinity<br/>No network listeners<br/>No RBAC required"]
            DataVol["/app/data/<br/>Read-only YAML catalogs"]
        end
    end

    subgraph PlatformConsumers["PLATFORM CONSUMERS"]
        Dashboard["RHOAI Dashboard<br/>Volume mount access"]
        ModelCtrl["odh-model-controller<br/>Volume mount access"]
    end

    %% Build-time flows
    Extractor -->|"HTTPS/443<br/>TLS (Go default)<br/>Bearer HF_TOKEN (optional)"| HF
    Extractor -->|"HTTPS/443<br/>TLS (Go default)<br/>Docker auth"| Registry
    Extractor -->|"HTTPS/443<br/>TLS (Go default)<br/>Bearer GITHUB_TOKEN (optional)"| GitHub

    %% Runtime flows (no network)
    DataVol -.->|"Volume mount<br/>No network<br/>K8s RBAC"| Dashboard
    DataVol -.->|"Volume mount<br/>No network<br/>K8s RBAC"| ModelCtrl

    %% Styling
    classDef buildtime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef consumer fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef data fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Extractor buildtime
    class HF,Registry,GitHub external
    class Container runtime
    class DataVol data
    class Dashboard,ModelCtrl consumer
