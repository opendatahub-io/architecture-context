graph TB
    subgraph CICD["CI/CD ENVIRONMENT (Build-time only)"]
        direction TB
        Extractor["model-extractor CLI<br/>(Go, CGO_ENABLED=0)<br/>max 5 concurrent workers"]
        DataFiles["data/*.yaml<br/>models-catalog.yaml<br/>mcp-servers-catalog.yaml<br/>agents-catalog.yaml"]
        Extractor -->|"File I/O<br/>(local write)"| DataFiles
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (Build-time egress)"]
        direction TB
        RegistryRH["registry.redhat.io<br/>OCI Registry<br/>TLS 1.2+"]
        RegistryQ["quay.io<br/>OCI Registry<br/>TLS 1.2+"]
        HuggingFace["huggingface.co<br/>REST API<br/>TLS 1.2+"]
        GitHub["api.github.com<br/>REST API<br/>TLS 1.2+"]
        GitHubRaw["raw.githubusercontent.com<br/>Static content<br/>TLS 1.2+"]
    end

    subgraph BuildPipeline["BUILD PIPELINE (Konflux)"]
        direction TB
        Konflux["Konflux Tekton Pipeline<br/>hermetic: true<br/>prefetch: gomod<br/>Arch: x86_64, ppc64le, s390x, arm64"]
    end

    subgraph Runtime["RUNTIME (Kubernetes - No Network)"]
        direction TB

        subgraph Pod["Consumer Pod"]
            InitContainer["Init Container<br/>odh-model-metadata-collection<br/>Image: UBI9-minimal<br/>No binaries, YAML only<br/>No RBAC, No network"]
            Volume["Volume Mount<br/>/app/data/*.yaml"]
            Dashboard["RHOAI Dashboard<br/>(catalog consumer)"]
            InitContainer -->|"Filesystem<br/>copy data"| Volume
            Dashboard -->|"Filesystem<br/>read catalogs"| Volume
        end
    end

    %% Build-time egress flows
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry credentials<br/>OCI manifests & modelcards"| RegistryRH
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry credentials<br/>Image architectures"| RegistryQ
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN (optional)<br/>Model details & collections"| HuggingFace
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer GITHUB_TOKEN (optional)<br/>Branch validation"| GitHub
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer GITHUB_TOKEN (optional)<br/>agent.yaml & READMEs"| GitHubRaw

    %% Build pipeline flows
    Konflux -->|"HTTPS/443<br/>TLS 1.2+<br/>git_auth_secret<br/>Clone repo + data"| DataFiles
    Konflux -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry push credentials<br/>Push multi-arch image"| RegistryQ

    %% Styling
    classDef cicd fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef build fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef nonetwork fill:#e8f5e9,stroke:#4caf50,stroke-width:3px

    class Extractor,DataFiles cicd
    class RegistryRH,RegistryQ,HuggingFace,GitHub,GitHubRaw external
    class Konflux build
    class InitContainer,Volume,Dashboard runtime
