graph TB
    subgraph BuildTime["BUILD-TIME PIPELINE (CI/CD Only)"]
        direction TB
        Extractor["model-extractor CLI<br/>Go Binary (CGO_ENABLED=0)<br/>No network listeners<br/>Not shipped in image"]
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (Egress Only)"]
        direction TB
        HF["HuggingFace API<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        GitHub["GitHub API<br/>api.github.com<br/>raw.githubusercontent.com<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        OCI["OCI Registry<br/>registry.redhat.io<br/>443/TCP HTTPS<br/>Docker Registry v2<br/>TLS 1.2+"]
    end

    subgraph Artifacts["BUILD ARTIFACTS (Static Files)"]
        DataFiles["data/*.yaml<br/>models-catalog.yaml<br/>validated-models-catalog.yaml<br/>*-mcp-servers-catalog.yaml<br/>redhat-agents-catalog.yaml"]
    end

    subgraph Runtime["CONTAINER IMAGE (Runtime - No Network)"]
        DataContainer["Data Container<br/>UBI9-minimal (multi-arch)<br/>Entrypoint: sleep infinity<br/>Volume: /app/data<br/>No listeners · No egress<br/>No Go binaries · Data only"]
    end

    subgraph Consumer["CONSUMER"]
        Dashboard["RHOAI Dashboard<br/>Reads catalog YAML files"]
    end

    %% Build-time egress flows
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer HF_TOKEN (optional)"| HF
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer GITHUB_TOKEN (optional)"| GitHub
    Extractor -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth (public)"| OCI

    %% Build output
    Extractor -->|"File I/O<br/>Generates catalog YAML"| DataFiles

    %% Container packaging
    DataFiles -->|"COPY into image<br/>Dockerfile.konflux"| DataContainer

    %% Runtime consumption
    DataContainer -->|"Volume Mount<br/>/app/data<br/>No network"| Dashboard

    %% Styling
    classDef buildtime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef artifacts fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef consumer fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Extractor buildtime
    class HF,GitHub,OCI external
    class DataFiles artifacts
    class DataContainer runtime
    class Dashboard consumer
