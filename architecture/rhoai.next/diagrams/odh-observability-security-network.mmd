graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["End User / Dashboard Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS reencrypt)"]
        ClusterRoute["Cluster Proxy Route<br/>443/TCP HTTPS<br/>TLS reencrypt"]
        PrometheusRoute["Prometheus Route<br/>443/TCP HTTPS<br/>TLS reencrypt"]
        ThanosRoute["Thanos Querier Route<br/>443/TCP HTTPS<br/>TLS reencrypt"]
    end

    subgraph MonitoringNS["MONITORING NAMESPACE (NetworkPolicy enforced)"]
        direction TB

        subgraph ProxyLayer["Proxy Layer"]
            ClusterProxy["Cluster Proxy<br/>:8443 HTTPS<br/>kube-rbac-proxy<br/>SA: data-science-prometheus-cluster-proxy<br/>Grants: cluster-wide metrics"]
            NSProxy["Namespace Proxy<br/>:8443/:9090 HTTPS<br/>kube-rbac-proxy + prom-label-proxy<br/>SA: data-science-prometheus-namespace-proxy<br/>Grants: namespace-scoped metrics"]
        end

        subgraph MetricsLayer["Metrics Collection"]
            Prometheus["MonitoringStack Prometheus<br/>:9090 HTTPS<br/>TLS (service-CA)"]
            Thanos["ThanosQuerier<br/>Federated query"]
        end

        subgraph TelemetryLayer["Telemetry Pipeline"]
            Collector["OpenTelemetry Collector<br/>:4317 gRPC, :4318 HTTP (OTLP)<br/>:8889/:8890 HTTPS (export)<br/>TLS, NetworkPolicy restricted<br/>SA: data-science-collector-collector"]
        end

        subgraph TracingLayer["Tracing & Correlation"]
            Tempo["Tempo<br/>:4317 OTLP/gRPC<br/>RBAC (trace export role)"]
            Korrel8r2["Korrel8r<br/>:8443 HTTPS<br/>kube-rbac-proxy<br/>SA: korrel8r"]
        end

        subgraph DashLog["Dashboarding & Logging"]
            Perses2["Perses<br/>Shared dashboards"]
            LogForwarder["ClusterLogForwarder<br/>→ LokiStack"]
        end

        subgraph WebhookZone["Webhook"]
            WebhookSvc["webhook-service<br/>:9443 HTTPS<br/>TLS (cert-manager)<br/>Failure Policy: Fail"]
        end
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        Operator["odh-observability operator<br/>:8081 HTTP (probes)<br/>:8080 HTTP (metrics)<br/>SA: controller-manager"]
    end

    subgraph K8sAPI["KUBERNETES / OPENSHIFT API"]
        KubeAPI["kube-apiserver<br/>:6443 HTTPS<br/>TLS 1.2+"]
        OSConfig["OpenShift APIServer<br/>TLS Profile Config"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>Bearer Token"| ClusterRoute
    Client -->|"HTTPS/443<br/>Bearer Token"| PrometheusRoute
    Client -->|"HTTPS/443<br/>Bearer Token"| ThanosRoute

    %% Route to proxy
    ClusterRoute -->|"HTTPS/8443<br/>TLS reencrypt"| ClusterProxy
    PrometheusRoute -->|"HTTPS/9090<br/>TLS reencrypt"| Prometheus
    ThanosRoute -->|"HTTPS/8443<br/>TLS reencrypt"| Thanos

    %% Proxy to Prometheus
    ClusterProxy -->|"HTTPS/9090<br/>TLS (service-CA)"| Prometheus
    NSProxy -->|"HTTPS/9090<br/>TLS (service-CA), mTLS"| Prometheus

    %% Collector flows
    Collector -->|"HTTPS/8889<br/>TLS (service-CA)"| Prometheus
    Collector -->|"OTLP/4317 gRPC<br/>TLS, RBAC"| Tempo

    %% Operator flows
    Operator -->|"HTTPS/6443<br/>SA token<br/>SSA, CRD discovery"| KubeAPI
    Operator -->|"reads TLS profile"| OSConfig

    %% Webhook flows
    KubeAPI -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>admission"| WebhookSvc
    WebhookSvc -->|"HTTPS/6443<br/>SA token<br/>NS + CR lookup"| KubeAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class ClusterRoute,PrometheusRoute,ThanosRoute ingress
    class ClusterProxy,NSProxy,Prometheus,Thanos,Collector,Tempo,Korrel8r2,Perses2,LogForwarder,WebhookSvc monitoring
    class Operator operator
    class KubeAPI,OSConfig k8s
