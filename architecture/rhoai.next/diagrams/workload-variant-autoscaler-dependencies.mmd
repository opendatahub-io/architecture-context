graph LR
    WVA["WVA Controller<br/>(Workload Variant Autoscaler)"]

    %% External Dependencies (Required)
    WVA -->|"PromQL queries<br/>HTTPS/9090-9091"| Prometheus["Prometheus /<br/>Thanos Querier<br/>(Required)"]

    %% External Dependencies (Optional)
    WVA -.->|"ScaledObject discovery<br/>(runtime CRD check)"| KEDA["KEDA v2.18+<br/>(Optional)"]
    WVA -.->|"Multi-pod model serving<br/>(runtime CRD check)"| LWS["LeaderWorkerSet<br/>v0.8+<br/>(Optional)"]
    WVA -.->|"InferencePool endpoint<br/>discovery"| GAIE["Gateway API<br/>Inference Extension<br/>v1.2+ (Optional)"]
    WVA -.->|"ServiceMonitor &<br/>PrometheusRule CRDs"| PromOp["Prometheus Operator<br/>(Optional)"]

    %% Kubernetes
    WVA -->|"Watch/List/Update<br/>HTTPS/443"| K8sAPI["Kubernetes<br/>API Server"]

    %% Internal Platform Dependencies
    WVA -->|"CI manifest sync<br/>sync-manifests-to-kserve.yml"| KServe["KServe<br/>(RHOAI)"]
    WVA -->|"KV cache, queue,<br/>token metrics"| InferencePods["vLLM / SGLang<br/>Inference Pods"]
    WVA -->|"Scheduler dispatch rate,<br/>flow control metrics"| EPP["EPP<br/>(Endpoint Picker)"]

    %% Downstream consumers
    KEDA -->|"reads wva_desired_replicas<br/>from Prometheus"| Prometheus
    PromAdapter["prometheus-adapter<br/>(HPA custom metrics)"] -->|"reads wva_desired_replicas<br/>from Prometheus"| Prometheus

    %% Integration Points (incoming)
    HPA["HPA<br/>(autoscaling/v2)"] -->|"annotation: llm-d.ai/managed"| WVA
    ScaledObject["KEDA ScaledObject"] -.->|"annotation: llm-d.ai/managed"| WVA
    ConfigMaps["ConfigMaps<br/>(saturation thresholds)"] -->|"dynamic config"| WVA
    InferencePoolCR["InferencePool CR"] -.->|"endpoint topology"| WVA

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style Prometheus fill:#e8daef,stroke:#8e44ad,stroke-width:2px
    style K8sAPI fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    %% Optional external
    style KEDA fill:#999,stroke:#333
    style LWS fill:#999,stroke:#333
    style GAIE fill:#999,stroke:#333
    style PromOp fill:#999,stroke:#333

    %% Internal
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style InferencePods fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff

    %% Downstream
    style PromAdapter fill:#fff2cc,stroke:#d6b656
    style HPA fill:#f5a623,stroke:#333
    style ScaledObject fill:#f5a623,stroke:#333
    style ConfigMaps fill:#f5a623,stroke:#333
    style InferencePoolCR fill:#f5a623,stroke:#333
