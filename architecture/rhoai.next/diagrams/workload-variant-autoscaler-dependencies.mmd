graph LR
    WVA["WVA Controller<br/>Workload Variant Autoscaler"]

    %% External Dependencies (Required)
    WVA -->|"PromQL queries<br/>KV cache, queue, latency"| Prometheus["Prometheus / Thanos Querier<br/>(required)"]
    WVA -->|"watch InferencePool CRs"| GatewayAPI["Gateway API<br/>Inference Extension v1.2+<br/>(required)"]

    %% External Dependencies (Optional)
    WVA -.->|"ScaledObject scaling"| KEDA["KEDA v2.18+<br/>(optional)"]
    WVA -.->|"distributed inference"| LWS["LeaderWorkerSet v0.8+<br/>(optional)"]
    WVA -.->|"GPU node labels"| GPUOp["GPU Operator<br/>NVIDIA / AMD / Intel<br/>(optional)"]

    %% Internal Platform Dependencies
    WVA -->|"metrics source<br/>(via Prometheus)"| vLLM["vLLM / SGLang<br/>Inference Servers"]
    WVA -->|"flow-control queue<br/>scraping"| EPP["Gateway API EPP<br/>Endpoint Picker"]
    WVA -->|"manifest sync<br/>(CI workflow)"| KServe["KServe<br/>(red-hat-data-services)"]

    %% K8s Resources
    WVA -->|"watch + patch"| HPA["HorizontalPodAutoscaler"]
    WVA -->|"watch + patch"| ScaledObj["KEDA ScaledObject"]
    WVA -->|"get, scale"| Deployments["Deployments /<br/>LeaderWorkerSets"]
    WVA -->|"watch config"| ConfigMaps["ConfigMaps<br/>(saturation, queueing-model,<br/>scale-to-zero, system)"]
    WVA -->|"read GPU capacity"| Nodes["Kubernetes Nodes"]
    WVA -->|"read quotas"| RQ["ResourceQuotas"]

    %% Monitoring
    WVA -->|"ServiceMonitor CRD"| PromOp["Prometheus Operator"]
    WVA -->|"emit events"| Events["Kubernetes Events<br/>ScaledUp, ScaledDown,<br/>ResourceConstrained"]

    %% Consumers
    HPA -->|"reads wva_desired_replicas"| WVA
    Prometheus -->|"scrapes /metrics"| WVA

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style KEDA fill:#ccc,stroke:#999,color:#333
    style LWS fill:#ccc,stroke:#999,color:#333
    style GPUOp fill:#ccc,stroke:#999,color:#333
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style HPA fill:#f5a623,stroke:#333,color:#fff
    style ScaledObj fill:#f5a623,stroke:#333,color:#fff
    style Deployments fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#f5a623,stroke:#333,color:#fff
    style Nodes fill:#f5a623,stroke:#333,color:#fff
    style RQ fill:#f5a623,stroke:#333,color:#fff
    style PromOp fill:#999,stroke:#333,color:#fff
    style Events fill:#f5a623,stroke:#333,color:#fff
