graph LR
    WVA["WVA Controller<br/>Manager"]

    %% External Dependencies (Required)
    WVA -->|"metrics source<br/>(required)"| Prometheus["Prometheus /<br/>Thanos Querier"]
    WVA -->|"InferencePool CRDs<br/>(required)"| GatewayAPI["Gateway API<br/>Inference Extension v1.2+"]

    %% External Dependencies (Optional)
    WVA -.->|"ScaledObject scaling<br/>(optional)"| KEDA["KEDA v2.18+"]
    WVA -.->|"distributed inference<br/>(optional)"| LWS["LeaderWorkerSet v0.8+"]
    WVA -.->|"GPU node labels<br/>(optional)"| GPUOp["GPU Operator<br/>(NVIDIA/AMD/Intel)"]

    %% Internal Platform Dependencies
    WVA -->|"KV cache, queue,<br/>latency metrics"| vLLM["vLLM / SGLang<br/>Inference Servers"]
    WVA -->|"flow-control queue<br/>metrics"| EPP["Gateway API EPP<br/>(Endpoint Picker)"]
    WVA -->|"manifest sync<br/>(CI)"| kserve["kserve<br/>(red-hat-data-services)"]
    WVA -->|"watch + patch"| HPA["HorizontalPodAutoscaler"]
    WVA -.->|"watch + patch<br/>(if KEDA present)"| ScaledObject["KEDA ScaledObject"]
    WVA -->|"ServiceMonitor CRD"| PromOp["Prometheus Operator"]

    %% Consumers of WVA
    HPA -->|"reads wva_desired_replicas<br/>external metric"| WVA
    ScaledObject -.->|"reads wva_desired_replicas<br/>external metric"| WVA

    %% K8s API resources
    WVA -->|"watch/patch scale"| Deployments["Deployments /<br/>LeaderWorkerSets"]
    WVA -->|"GPU discovery"| Nodes["Nodes"]
    WVA -->|"dynamic config"| ConfigMaps["ConfigMaps<br/>(saturation, QM,<br/>scale-to-zero, system)"]
    WVA -->|"GPU quotas"| ResourceQuota["ResourceQuotas"]

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style KEDA fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style LWS fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style GPUOp fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#fff
    style kserve fill:#7ed321,stroke:#333,color:#fff
    style HPA fill:#7ed321,stroke:#333,color:#fff
    style ScaledObject fill:#7ed321,stroke:#333,color:#fff
    style PromOp fill:#7ed321,stroke:#333,color:#fff
    style Deployments fill:#f5a623,stroke:#333,color:#fff
    style Nodes fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#f5a623,stroke:#333,color:#fff
    style ResourceQuota fill:#f5a623,stroke:#333,color:#fff
