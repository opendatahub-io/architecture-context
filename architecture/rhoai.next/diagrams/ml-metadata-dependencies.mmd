graph LR
    MLMD["ML Metadata<br/>(gRPC Server)"]

    %% External Build Dependencies
    MLMD -->|"build system"| Bazel["Bazel 5.3.0+"]
    MLMD -->|"gRPC framework"| gRPC["gRPC (C++)"]
    MLMD -->|"TLS transport"| BoringSSL["BoringSSL<br/>(bundled via gRPC)"]
    MLMD -->|"C++ utilities"| Abseil["Abseil C++<br/>20230802.0"]
    MLMD -->|"serialization"| Protobuf["protobuf >=3.13,<4"]
    MLMD -->|"SQL parsing"| ZetaSQL["ZetaSQL"]

    %% Storage backends
    MLMD -->|"3306/TCP<br/>metadata storage"| MySQL["MySQL / MariaDB"]
    MLMD -->|"5432/TCP<br/>metadata storage"| PostgreSQL["PostgreSQL"]
    MLMD -->|"embedded storage"| SQLite["SQLite 3.47.2"]

    %% Internal Platform Dependencies
    DSPOperator["Data Science Pipelines<br/>Operator"] -->|"deploys &<br/>configures"| MLMD
    KFPipelinesSDK["Kubeflow Pipelines<br/>SDK"] -->|"gRPC/8080<br/>records metadata"| MLMD
    PipelineUI["Pipeline UI"] -->|"gRPC/8080<br/>retrieves metadata"| MLMD

