graph LR
    MLMD["ML Metadata<br/>(MLMD gRPC Server)"]

    %% External Build/Runtime Dependencies
    MLMD -->|"RPC framework"| gRPC["gRPC 1.46.3"]
    MLMD -->|"serialization"| Protobuf["Protocol Buffers 3.21.12"]
    MLMD -->|"C++ stdlib extensions"| Abseil["Abseil 20230802.0"]
    MLMD -->|"SQL query parsing"| ZetaSQL["ZetaSQL"]
    MLMD -->|"TLS/SSL crypto"| BoringSSL["BoringSSL"]
    MLMD -->|"embedded DB option"| SQLite["SQLite 3.39.2"]

    %% Database Backend Dependencies
    MLMD -->|"MySQL protocol<br/>3306/TCP<br/>Optional TLS"| MySQL["MySQL / MariaDB"]
    MLMD -->|"PostgreSQL protocol<br/>5432/TCP<br/>Optional TLS"| PostgreSQL["PostgreSQL"]

    %% Internal Platform Dependencies (consumers)
    DSP["Data Science Pipelines<br/>(DSP Controller)"] -->|"gRPC client<br/>8080/TCP"| MLMD
    KFP["Kubeflow Pipelines SDK"] -->|"gRPC client<br/>8080/TCP"| MLMD
    PipelineUI["Pipeline UI<br/>(Dashboard)"] -->|"gRPC client<br/>8080/TCP"| MLMD

    %% Build Dependencies
    MLMD -.->|"build system"| Bazel["Bazel 5.3.0+"]
    MLMD -.->|"flag parsing"| gflags["gflags"]
    MLMD -.->|"logging"| glog["glog"]

    %% Styling
    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External runtime deps
    style gRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style Abseil fill:#999,stroke:#333
    style ZetaSQL fill:#999,stroke:#333
    style BoringSSL fill:#999,stroke:#333
    style SQLite fill:#999,stroke:#333

    %% Database backends
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333

    %% Internal platform components
    style DSP fill:#7ed321,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style PipelineUI fill:#7ed321,stroke:#333

    %% Build deps
    style Bazel fill:#ccc,stroke:#333
    style gflags fill:#ccc,stroke:#333
    style glog fill:#ccc,stroke:#333
