graph LR
    MLMD["ML Metadata<br/>(MLMD gRPC Server)"]

    %% Core Build Dependencies
    MLMD -->|"server framework"| gRPC["gRPC C++ 1.46.3"]
    MLMD -->|"serialization"| Protobuf["Protocol Buffers 3.21.12"]
    MLMD -->|"SQL query parsing"| ZetaSQL["ZetaSQL"]
    MLMD -->|"C++ utilities"| Abseil["Abseil C++ 20230802.0"]
    MLMD -->|"TLS (gRPC layer)"| BoringSSL["BoringSSL<br/>⚠️ Not FIPS OpenSSL"]
    MLMD -->|"CLI flags"| gflags["gflags"]
    MLMD -->|"logging"| glog["glog"]

    %% Database Backends
    MLMD -->|"default backend"| SQLite["SQLite 3.39.2"]
    MLMD -->|"production backend<br/>5432/TCP"| PostgreSQL["PostgreSQL (libpq) 12.17"]
    MLMD -->|"alternative backend<br/>3306/TCP"| MariaDB["MariaDB Connector/C"]

    %% Internal Platform Dependencies (consumers)
    KFP["Kubeflow Pipelines"] -->|"gRPC client<br/>8080/TCP"| MLMD
    DSP["Data Science Pipelines"] -->|"gRPC client<br/>8080/TCP"| MLMD
    KFPUI["Kubeflow Pipelines UI"] -->|"gRPC client<br/>8080/TCP"| MLMD
    TFX["TFX (TensorFlow Extended)"] -->|"gRPC client<br/>8080/TCP"| MLMD

    %% Operator
    DSPOp["Data Science Pipelines Operator"] -.->|"deploys & manages"| MLMD

    %% Python Client Dependencies
    subgraph "Python Client (ml_metadata)"
        PythonClient["ml_metadata<br/>Python SDK"]
        PythonClient -->|"client lib"| grpcio["grpcio >=1.8.6"]
        PythonClient -->|"serialization"| protobuf_py["protobuf >=3.13"]
        PythonClient -->|"utilities"| absl_py["absl-py >=0.9"]
        PythonClient -->|"compatibility"| six_py["six >=1.10"]
        PythonClient -->|"attributes"| attrs_py["attrs >=20.3"]
    end

    %% Build System
    MLMD -.->|"build system"| Bazel["Bazel 5.3.0+"]

    %% Styling
    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style gRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style ZetaSQL fill:#999,stroke:#333
    style Abseil fill:#999,stroke:#333
    style BoringSSL fill:#e74c3c,stroke:#333,color:#fff
    style gflags fill:#999,stroke:#333
    style glog fill:#999,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style MariaDB fill:#f5a623,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style KFPUI fill:#7ed321,stroke:#333
    style TFX fill:#7ed321,stroke:#333
    style DSPOp fill:#dae8fc,stroke:#6c8ebf
    style PythonClient fill:#6c5ce7,stroke:#333,color:#fff
    style Bazel fill:#e8e8e8,stroke:#333
