graph TD
    subgraph "Authentication Sources"
        CIToken["CI ServiceAccount Token<br/>(RHOAI_TOKEN from oc whoami -t)"]
        JWTDecode["JWT Sub Claim Decode<br/>⚠ No signature verification<br/>(identity detection only)"]
    end

    subgraph "Temporary RoleBindings (per test session)"
        RB1["RoleBinding:<br/>rhoai-root-tests-admin"]
        RB2["RoleBinding:<br/>kserve-s3-ISVC_NAME-sa"]
    end

    subgraph "Roles"
        AdminCR["ClusterRole: admin<br/>(built-in)"]
        S3Role["Role: kserve-s3-ISVC_NAME-sa<br/>(namespace-scoped)"]
    end

    subgraph "ServiceAccounts"
        CISA["CI ServiceAccount<br/>(from Bearer token JWT)"]
        KServeSA["ServiceAccount:<br/>kserve-s3-ISVC_NAME-sa<br/>(created per InferenceService)"]
    end

    subgraph "Namespace Resources (test namespace)"
        NS["Namespace<br/>(RHOAI_PROJECT_NAME)"]
        Secrets["Secrets<br/>(S3 connections, MaaS, VectorDB)"]
        DSPACR["DataSciencePipelinesApplication CR"]
        ISVCCR["InferenceService CR"]
        SRTCR["ServingRuntime CR"]
        Pods["Pipeline Pods"]
    end

    subgraph "External API Access"
        OCPAPI["OpenShift API<br/>Bearer Token auth"]
        KFPAPI["KFP Pipeline Server<br/>Bearer Token auth"]
        S3API["S3 Storage<br/>AWS Signature V4"]
        KServeAPI["KServe InferenceService<br/>Bearer Token auth"]
    end

    %% Auth flow
    CIToken -->|"authenticates"| CISA
    CIToken -->|"decoded for SA name"| JWTDecode

    %% RoleBindings
    CISA -->|"bound via"| RB1
    RB1 -->|"grants"| AdminCR
    AdminCR -->|"full admin on"| NS

    KServeSA -->|"bound via"| RB2
    RB2 -->|"grants"| S3Role
    S3Role -->|"get secrets"| Secrets

    %% What admin role enables
    CISA -->|"creates/manages"| NS
    CISA -->|"creates/manages"| Secrets
    CISA -->|"creates/manages"| DSPACR
    CISA -->|"creates/manages"| ISVCCR
    CISA -->|"creates/manages"| SRTCR

    %% External access
    CIToken -->|"Bearer auth"| OCPAPI
    CIToken -->|"Bearer auth"| KFPAPI
    CIToken -->|"Bearer auth"| KServeAPI

    %% Lifecycle note
    NS -.->|"⏳ Torn down<br/>after test session"| RB1
    NS -.->|"⏳ Torn down<br/>after test session"| RB2
    NS -.->|"⏳ Torn down<br/>after test session"| KServeSA

    %% Styling
    style CIToken fill:#4a90e2,color:#fff
    style JWTDecode fill:#f5a623,color:#fff
    style AdminCR fill:#f5a623,color:#fff
    style S3Role fill:#f5a623,color:#fff
    style RB1 fill:#ffe6cc,stroke:#d79b00
    style RB2 fill:#ffe6cc,stroke:#d79b00
    style CISA fill:#7ed321,color:#fff
    style KServeSA fill:#7ed321,color:#fff
    style NS fill:#d5e8d4,stroke:#82b366
    style Secrets fill:#d5e8d4,stroke:#82b366
    style DSPACR fill:#d5e8d4,stroke:#82b366
    style ISVCCR fill:#d5e8d4,stroke:#82b366
    style SRTCR fill:#d5e8d4,stroke:#82b366
    style Pods fill:#d5e8d4,stroke:#82b366
    style OCPAPI fill:#f9f9f9,stroke:#999
    style KFPAPI fill:#f9f9f9,stroke:#999
    style S3API fill:#f9f9f9,stroke:#999
    style KServeAPI fill:#f9f9f9,stroke:#999
