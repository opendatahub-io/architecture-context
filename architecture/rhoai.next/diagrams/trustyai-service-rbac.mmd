graph TD
    subgraph Note["RBAC Managed Externally"]
        direction TB
        NoteText["No RBAC resources defined in trustyai-service repository.<br/>All RBAC is managed by the TrustyAI Operator."]
    end

    subgraph OperatorManaged["TrustyAI Operator (manages RBAC)"]
        Operator["TrustyAI Operator<br/>Reconciles TrustyAIService CRs"]
    end

    subgraph ServiceAccounts["Service Accounts (Operator-Created)"]
        TrustyAISA["trustyai-service SA<br/>(per namespace)"]
        KRBPProxy["kube-rbac-proxy SA<br/>(sidecar)"]
    end

    subgraph AuthFlow["Authentication Flow"]
        direction TB
        Client["API Client<br/>(Dashboard, KServe, Prometheus)"]
        BearerToken["Bearer Token<br/>(K8s ServiceAccount Token)"]
        KRBP["kube-rbac-proxy<br/>8443/TCP"]
        SAR["SubjectAccessReview<br/>(Kubernetes API)"]
        TrustyAI["TrustyAI Service<br/>127.0.0.1:8080"]
    end

    subgraph HealthProbes["Unauthenticated Endpoints"]
        Readiness["/q/health/ready<br/>No auth required"]
        Liveness["/q/health/live<br/>No auth required"]
    end

    subgraph SecretsMgmt["Secrets (Operator-Provisioned)"]
        TLSCert["TLS Certificates<br/>kubernetes.io/tls<br/>HTTPS listener (4443/TCP)<br/>Provisioned by: Operator/cert-manager"]
        MariaDBCreds["MariaDB Credentials<br/>Opaque<br/>DATABASE_USERNAME,<br/>DATABASE_PASSWORD<br/>Provisioned by: Operator"]
        MariaDBTLS["MariaDB TLS CA Cert<br/>Opaque<br/>DATABASE_TLS_CA_CERT<br/>Provisioned by: Operator"]
    end

    %% Operator creates RBAC
    Operator -->|"creates"| TrustyAISA
    Operator -->|"configures"| KRBPProxy
    Operator -->|"provisions"| TLSCert
    Operator -->|"provisions"| MariaDBCreds
    Operator -->|"provisions"| MariaDBTLS

    %% Auth flow
    Client -->|"presents"| BearerToken
    BearerToken -->|"HTTPS/8443"| KRBP
    KRBP -->|"validates via"| SAR
    SAR -->|"authorized"| KRBP
    KRBP -->|"forwards<br/>HTTP/8080<br/>loopback"| TrustyAI

    %% Direct access (no auth)
    TrustyAI --- Readiness
    TrustyAI --- Liveness

    %% Styling
    style NoteText fill:#fff3cd,stroke:#856404,color:#856404
    style Operator fill:#7ed321,stroke:#333,color:#fff
    style TrustyAISA fill:#4a90e2,stroke:#333,color:#fff
    style KRBPProxy fill:#4a90e2,stroke:#333,color:#fff
    style KRBP fill:#d79b00,stroke:#333,color:#fff
    style SAR fill:#326ce5,stroke:#333,color:#fff
    style TrustyAI fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style BearerToken fill:#fff2cc,stroke:#d6b656
    style Readiness fill:#d5e8d4,stroke:#82b366
    style Liveness fill:#d5e8d4,stroke:#82b366
    style TLSCert fill:#f8cecc,stroke:#b85450
    style MariaDBCreds fill:#f8cecc,stroke:#b85450
    style MariaDBTLS fill:#f8cecc,stroke:#b85450
