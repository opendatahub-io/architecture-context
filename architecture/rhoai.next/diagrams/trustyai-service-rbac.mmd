graph TD
    subgraph OperatorManaged["RBAC (Managed by trustyai-service-operator)"]
        direction TB
        Note["No RBAC resources defined in the<br/>trustyai-service repository.<br/>All RBAC is managed by the<br/>trustyai-service-operator."]
    end

    subgraph AuthModel["Authentication & Authorization Model"]
        direction TB

        subgraph Port8081["Port 8081 - API Endpoints"]
            KRBP["kube-rbac-proxy (sidecar)<br/>OAuth Bearer validation"]
            APIEndpoints["API Server (loopback only)<br/>Drift, Fairness, Explainability,<br/>Info, Data, Metrics"]
        end

        subgraph Port4443["Port 4443 - Direct HTTPS"]
            TLSAuth["Application TLS<br/>PolicyAwareConfig<br/>System crypto policy"]
            DirectAccess["Direct API Access<br/>mTLS / Bearer (configurable)"]
        end

        subgraph Port8080["Port 8080 - Health & Consumer"]
            NoAuth["No Authentication"]
            HealthEndpoints["Health Probes<br/>/q/health/ready<br/>/q/health/live"]
            ConsumerEndpoints["Consumer Endpoints<br/>POST / (CloudEvents)<br/>POST /consumer/kserve/v2"]
        end
    end

    subgraph Actors["Service Actors"]
        User["User / Dashboard<br/>(OAuth Bearer)"]
        Prometheus["Prometheus<br/>(kube-rbac-proxy)"]
        KServe["KServe Logger<br/>(No auth)"]
        ModelMesh["ModelMesh Agent<br/>(No auth)"]
        Kubelet["Kubelet<br/>(No auth)"]
    end

    %% Auth flows
    User -->|"OAuth Bearer"| KRBP
    Prometheus -->|"Service account"| KRBP
    KRBP -->|"Forwarded identity<br/>HTTP loopback"| APIEndpoints

    User -.->|"mTLS / Bearer"| TLSAuth
    TLSAuth --> DirectAccess

    KServe -->|"HTTP/8080"| NoAuth
    ModelMesh -->|"HTTP/8080"| NoAuth
    Kubelet -->|"HTTP/8080"| NoAuth
    NoAuth --> HealthEndpoints
    NoAuth --> ConsumerEndpoints

    subgraph Secrets["Secrets & Credentials"]
        DBPass["DATABASE_PASSWORD<br/>(env var, operator-provisioned)"]
        LegacyDBPass["QUARKUS_DATASOURCE_PASSWORD<br/>(env var, legacy compat)"]
        TLSCert["TLS cert + key<br/>(file mount, cert-manager)"]
        DBCA["DATABASE_TLS_CA_CERT<br/>(file mount, /etc/tls/db/ca.crt)"]
    end

    %% Styling
    style OperatorManaged fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style Note fill:#fff3cd,stroke:#ffc107
    style Port8081 fill:#d4edda,stroke:#28a745,stroke-width:1px
    style Port4443 fill:#cce5ff,stroke:#004085,stroke-width:1px
    style Port8080 fill:#f8d7da,stroke:#721c24,stroke-width:1px
    style Secrets fill:#e2e3e5,stroke:#6c757d,stroke-width:1px
    style KRBP fill:#28a745,color:#fff
    style NoAuth fill:#dc3545,color:#fff
    style TLSAuth fill:#007bff,color:#fff
