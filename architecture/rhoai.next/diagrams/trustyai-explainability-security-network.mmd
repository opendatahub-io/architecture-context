graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Dashboard"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route: trustyai<br/>80/TCP → 8080/TCP<br/>TLS: None"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Namespace-scoped)"]
        direction TB

        subgraph SvcBlock["Service: trustyai-service (ClusterIP)"]
            Svc["80/TCP → 8080/TCP<br/>Protocol: HTTP"]
        end

        subgraph Pod["TrustyAI Service Pod"]
            direction TB
            PodInfo["SA: trustyai-serviceaccount<br/>Ports: 8080/TCP (HTTP), 4443/TCP (HTTPS)<br/>TLS Certs: /etc/tls/internal/*"]
            FairnessEndpoints["Fairness/Drift Endpoints<br/>POST, No Auth"]
            ConsumerEndpoint["Consumer Endpoint<br/>POST /consumer/kserve/v2, No Auth"]
            MetricsEndpoint["/q/metrics<br/>GET, Bearer SA Token"]
            HealthEndpoints["/q/health/live,ready<br/>GET, No Auth"]
        end

        subgraph InboundSources["INBOUND SOURCES"]
            ModelMesh["ModelMesh<br/>HTTP 8080/TCP<br/>No Encryption, No Auth"]
            KServeEventing["KServe via Knative Eventing<br/>HTTP CloudEvents 8080/TCP<br/>No Encryption, No Auth"]
            Prometheus["Prometheus (ServiceMonitor)<br/>HTTP 8080/TCP<br/>Bearer SA Token"]
        end
    end

    subgraph EgressTargets["EGRESS TARGETS"]
        InferenceServers["KServe/ModelMesh<br/>Inference Servers<br/>gRPC/HTTP, varies<br/>No Encryption (plaintext)<br/>No Auth"]
        MariaDB["MariaDB/MySQL<br/>(DATABASE mode)<br/>3306/TCP JDBC<br/>No Encryption<br/>Username/Password"]
        MinIO["MinIO<br/>(MINIO mode)<br/>HTTP, varies<br/>Access/Secret Key"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>SA Token<br/>(init container: oc apply)"]
    end

    %% External flow
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth (relies on proxy)"| Route
    Route -->|"HTTP/8080"| Svc

    %% Inbound flows
    ModelMesh -->|"HTTP/8080<br/>No Encryption<br/>POST /consumer/kserve/v2"| ConsumerEndpoint
    KServeEventing -->|"HTTP/8080<br/>CloudEvents<br/>inference.request/response"| ConsumerEndpoint
    Prometheus -->|"HTTP/8080<br/>GET /q/metrics<br/>Bearer SA Token"| MetricsEndpoint

    %% Egress flows
    Pod -->|"gRPC/HTTP<br/>usePlaintext()<br/>No Auth"| InferenceServers
    Pod -->|"JDBC/3306<br/>No Encryption<br/>Username/Password"| MariaDB
    Pod -->|"HTTP<br/>Access/Secret Key"| MinIO
    Pod -->|"HTTPS/6443<br/>SA Token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Svc,PodInfo,FairnessEndpoints,ConsumerEndpoint,MetricsEndpoint,HealthEndpoints internal
    class ModelMesh,KServeEventing,Prometheus internal
    class InferenceServers,MariaDB,MinIO,K8sAPI egress
