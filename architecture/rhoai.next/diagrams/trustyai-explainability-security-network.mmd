graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / RHOAI Dashboard"]
    end

    subgraph Ingress["INGRESS (Platform Layer)"]
        Route["OpenShift Route / HTTPRoute<br/>443/TCP → 80/TCP<br/>TLS terminated at Route<br/>kube-rbac-proxy sidecar auth"]
    end

    subgraph Application["APPLICATION (TrustyAI Service)"]
        direction TB

        subgraph NS_DSP["Namespace: {data-science-project}"]
            TrustyAIPod["TrustyAI Service Pod<br/>SA: trustyai-serviceaccount<br/>Ports: 8080/TCP (HTTP), 4443/TCP (HTTPS)<br/>TLS certs: /etc/tls/internal/<br/>⚠ No in-app auth"]

            subgraph InboundPorts["Inbound Endpoints (8080/TCP)"]
                FairnessAPI["/metrics/group/fairness/*<br/>SPD, DIR"]
                DriftAPI["/metrics/drift/*<br/>Meanshift, KS, FourierMMD"]
                ConsumerAPI["/consumer/kserve/v2<br/>Inference payload ingestion"]
                DataAPI["/data/upload, /info<br/>Data management"]
                HealthAPI["/q/health/*, /q/metrics<br/>Health & Prometheus"]
            end

            PVC["PVC Mount: /inputs<br/>Per-namespace isolation"]
        end
    end

    subgraph InboundServices["INBOUND SERVICES"]
        ModelMesh["ModelMesh Serving<br/>HTTP 8080/TCP<br/>plaintext, no auth"]
        KnativeEvents["Knative Eventing<br/>CloudEvents HTTP<br/>8080/TCP, no auth"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape<br/>8080/TCP, Bearer SA token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelServer["KServe/ModelMesh<br/>Model Servers<br/>gRPC (plaintext)<br/>⚠ usePlaintext()<br/>Disabled in RHOAI"]
        MinIO["MinIO / S3 Storage<br/>443/TCP or 9000/TCP<br/>HTTP/HTTPS configurable<br/>Access Key / Secret Key"]
        MariaDB["MariaDB / MySQL<br/>3306/TCP JDBC<br/>Encryption configurable<br/>Username / Password"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS TLS<br/>SA token auth<br/>ConfigMap CRUD"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS terminated<br/>Bearer Token"| Route

    %% Ingress → Application
    Route -->|"HTTP/80 → 8080<br/>plaintext (or 4443 TLS)<br/>kube-rbac-proxy"| TrustyAIPod

    %% Inbound services → Application
    ModelMesh -->|"HTTP/8080<br/>plaintext<br/>no auth"| ConsumerAPI
    KnativeEvents -->|"HTTP/8080<br/>CloudEvent<br/>no auth"| ConsumerAPI
    Prometheus -->|"HTTP/8080<br/>Bearer SA token"| HealthAPI

    %% Application → External services
    TrustyAIPod -->|"gRPC/variable<br/>⚠ plaintext<br/>no auth<br/>(disabled in RHOAI)"| ModelServer
    TrustyAIPod -->|"HTTP(S)/443,9000<br/>configurable TLS<br/>Access Key auth"| MinIO
    TrustyAIPod -->|"JDBC/3306<br/>configurable TLS<br/>user/password"| MariaDB
    TrustyAIPod -->|"HTTPS/6443<br/>TLS<br/>SA token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef inbound fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class TrustyAIPod,FairnessAPI,DriftAPI,ConsumerAPI,DataAPI,HealthAPI,PVC application
    class ModelMesh,KnativeEvents,Prometheus inbound
    class MinIO,MariaDB,K8sAPI externalservice
    class ModelServer warning
