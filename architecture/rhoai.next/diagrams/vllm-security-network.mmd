graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AuthLayer["AUTH ENFORCEMENT LAYER"]
        KubeRBACProxy["kube-rbac-proxy Sidecar<br/>8443/TCP HTTPS<br/>SubjectAccessReview AuthN<br/>(Injected by platform operator)"]
    end

    subgraph AppContainer["APPLICATION CONTAINER (odh-vllm-cuda-rhel9)"]
        direction TB

        subgraph APIs["Listening Ports"]
            HTTPApi["vLLM OpenAI-Compatible API<br/>8000/TCP HTTP<br/>/v1/completions, /v1/chat/completions<br/>/v1/models, /v1/embeddings, /health<br/>/metrics (Prometheus)"]
            GRPCApi["TGIS GenerationService<br/>8033/TCP gRPC<br/>TGIS-compatible inference"]
        end

        TGISAdapter["vllm_tgis_adapter<br/>(Entrypoint, UID 1001)"]
        VLLMEngine["vLLM Engine + CUDA Runtime"]
    end

    subgraph GPULayer["GPU HARDWARE"]
        GPU["NVIDIA GPU<br/>CUDA API<br/>Device Plugin Allocation"]
    end

    subgraph EgressTargets["EXTERNAL SERVICES (Egress)"]
        HuggingFace["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: Bearer Token (HF_TOKEN)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: AWS IAM / S3 Keys"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrape Target"]
    end

    %% External → Auth Layer
    Client -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KubeRBACProxy

    %% Auth Layer → Application
    KubeRBACProxy -->|"HTTP/8000<br/>No encryption (pod-internal)<br/>Auth: validated"| HTTPApi
    KubeRBACProxy -->|"gRPC/8033<br/>No encryption (pod-internal)<br/>Auth: validated"| GRPCApi

    %% Internal application flow
    HTTPApi --- TGISAdapter
    GRPCApi --- TGISAdapter
    TGISAdapter --- VLLMEngine

    %% GPU access
    VLLMEngine -->|"CUDA API<br/>No network port"| GPU

    %% Egress
    VLLMEngine -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (HF_TOKEN)"| HuggingFace
    VLLMEngine -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / S3 Keys"| S3

    %% Monitoring
    Prometheus -->|"HTTP/8000<br/>No encryption<br/>GET /metrics"| HTTPApi

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef gpu fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class KubeRBACProxy auth
    class HTTPApi,GRPCApi,TGISAdapter,VLLMEngine app
    class GPU gpu
    class HuggingFace,S3 egress
    class Prometheus monitoring
