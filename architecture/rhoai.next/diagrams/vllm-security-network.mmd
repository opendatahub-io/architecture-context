graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Application"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Gateway API (Envoy)<br/>443/TCP → 8443/TCP<br/>TLS 1.2+<br/>HTTPRoute / OpenShift Route"]
    end

    subgraph AuthBoundary["AUTH BOUNDARY (Pod-level)"]
        KubeRBAC["kube-rbac-proxy Sidecar<br/>8443/TCP TLS<br/>SubjectAccessReview<br/>Injected by RHOAI Platform"]
    end

    subgraph VLLMPod["APPLICATION (vLLM Pod - UID 2000)"]
        direction TB

        HTTPServer["vLLM HTTP Server<br/>Port 8000/TCP plaintext<br/>/v1/completions<br/>/v1/chat/completions<br/>/v1/models, /v1/embeddings<br/>/health"]

        TGISServer["TGIS gRPC Adapter<br/>Port 8033/TCP plaintext<br/>GenerationService<br/>(vllm_tgis_adapter)"]

        Engine["vLLM Inference Engine<br/>(in-process)"]
    end

    subgraph Compute["COMPUTE"]
        GPU["NVIDIA GPU<br/>CUDA Runtime<br/>cuDNN, cuBLAS, NCCL<br/>Device Plugin Allocated"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / HMAC"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token (optional)"]
        PVC["PVC Mount<br/>Filesystem<br/>No network egress"]
    end

    %% Ingress flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (OAuth/OIDC)"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>SubjectAccessReview"| KubeRBAC
    KubeRBAC -->|"HTTP/8000<br/>plaintext (pod-internal)<br/>pre-authorized"| HTTPServer
    KubeRBAC -->|"gRPC/8033<br/>plaintext (pod-internal)<br/>pre-authorized"| TGISServer

    %% Internal flows
    HTTPServer -->|in-process| Engine
    TGISServer -->|in-process| Engine
    Engine -->|CUDA runtime| GPU

    %% Egress flows
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM / HMAC"| S3
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| HFHub
    Engine -->|"Filesystem mount"| PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef compute fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class KubeRBAC auth
    class HTTPServer,TGISServer,Engine application
    class GPU compute
    class S3,HFHub,PVC externalservice
