graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / API Gateway"]
    end

    subgraph Mesh["SERVICE MESH (Platform-managed mTLS)"]
        IstioProxy["Istio Sidecar Proxy<br/>mTLS STRICT<br/>RequestAuthentication"]
    end

    subgraph Container["CONTAINER: vllm-cuda<br/>Non-root UID 2000<br/>Base: rhaiis/vllm-cuda-rhel9:3.2.2"]
        direction TB
        subgraph APIs["Exposed APIs"]
            HTTPAPI["HTTP API :8000/TCP<br/>/v1/completions POST<br/>/v1/chat/completions POST<br/>/v1/models GET<br/>/v1/embeddings POST<br/>/health GET"]
            GRPCAPI["gRPC API :8033/TCP<br/>GenerationService"]
        end

        subgraph Runtime["Inference Runtime"]
            Engine["vLLM Engine"]
            GPU["NVIDIA GPU<br/>CUDA Runtime"]
        end

        HTTPAPI --> Engine
        GRPCAPI --> Engine
        Engine --> GPU
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["Model Storage<br/>S3 / PVC<br/>TLS 1.2+ / None<br/>AWS IAM / SA token"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API token (optional)"]
    end

    %% Flows
    Client -->|"HTTP :8000 / gRPC :8033<br/>Platform-managed auth<br/>OAuth proxy / Bearer"| IstioProxy
    IstioProxy -->|"mTLS STRICT<br/>Service identity"| HTTPAPI
    IstioProxy -->|"mTLS STRICT<br/>Service identity"| GRPCAPI
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM / SA token"| S3
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>API token"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef mesh fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class IstioProxy mesh
    class HTTPAPI,GRPCAPI,Engine,GPU container
    class S3,HFHub externalservice
