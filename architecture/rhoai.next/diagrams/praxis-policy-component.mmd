graph TB
    subgraph Host["Host Process (e.g., Praxis Proxy)"]
        HostApp["Host Application<br/>Injects HttpTransport"]
    end

    subgraph PPE["Praxis Policy Engine"]
        direction TB

        subgraph Facade["Facade Layer"]
            PPEFacade["praxis-policy<br/>(facade crate)"]
        end

        subgraph CoreRuntime["Core Runtime"]
            Engine["PolicyEngine<br/>Five-Phase Executor"]
            Orch["praxis-policy-orchestration<br/>Async Concurrency"]
        end

        subgraph APL["APL Layer"]
            APLCore["apl-core<br/>Compiler + Evaluator"]
            APLCMF["apl-cmf<br/>AttributeBag Bridge"]
            APLRuntime["apl-runtime<br/>Route Handler + Sessions"]
        end

        subgraph BuiltinPlugins["Builtin Extensions (feature-gated)"]
            direction TB
            subgraph Identity["Identity Plugins"]
                JWT["identity/jwt<br/>RS256/384/512, ES256/384, EdDSA"]
                APIKey["identity/api-key<br/>SHA-256 digest verification"]
            end

            subgraph PDP["Policy Decision Points"]
                Cedar["pdp/cedar<br/>Cedar 4"]
                CEL["pdp/cel<br/>CEL 0.14"]
                OPA["pdp/opa<br/>Rego via regorus 0.12"]
            end

            subgraph Delegation["Delegation + Elicitation"]
                OAuth["delegator/oauth<br/>RFC 8693 Token Exchange"]
                CIBA["elicitation/ciba<br/>Backchannel Auth"]
            end

            subgraph StateSecrets["State + Secrets"]
                ValkeyPlugin["session/valkey<br/>Taint Label Store"]
                VaultPlugin["secrets/vault<br/>KV v2"]
            end
        end

        subgraph TestBench["Test + Bench (not published)"]
            PDPDiff["pdp-diff<br/>Differential Tests"]
            Benches["ppe-benches<br/>Criterion Benchmarks"]
        end
    end

    subgraph RefPlugins["Reference Plugins (not bundled)"]
        AuditLogger["audit-logger<br/>Structured Logging"]
        PIIScanner["pii-scanner<br/>SSN/CC/Email Redaction"]
    end

    HostApp -->|"embeds + configures"| PPEFacade
    PPEFacade -->|"re-exports runtime"| Engine
    PPEFacade -->|"registers factories"| BuiltinPlugins
    Engine -->|"dispatches hooks"| APLRuntime
    Engine -->|"branch execution"| Orch
    APLRuntime -->|"evaluates predicates"| APLCore
    APLRuntime -->|"maps to CMF"| APLCMF
    APLRuntime -->|"invokes"| BuiltinPlugins

    PDPDiff -.->|"tests equivalence"| Cedar
    PDPDiff -.->|"tests equivalence"| CEL
    PDPDiff -.->|"tests equivalence"| OPA

    style PPEFacade fill:#4a90e2,stroke:#333,color:#fff
    style Engine fill:#4a90e2,stroke:#333,color:#fff
    style Orch fill:#4a90e2,stroke:#333,color:#fff
    style APLCore fill:#9b59b6,stroke:#333,color:#fff
    style APLCMF fill:#9b59b6,stroke:#333,color:#fff
    style APLRuntime fill:#9b59b6,stroke:#333,color:#fff
    style JWT fill:#27ae60,stroke:#333,color:#fff
    style APIKey fill:#27ae60,stroke:#333,color:#fff
    style Cedar fill:#e67e22,stroke:#333,color:#fff
    style CEL fill:#e67e22,stroke:#333,color:#fff
    style OPA fill:#e67e22,stroke:#333,color:#fff
    style OAuth fill:#27ae60,stroke:#333,color:#fff
    style CIBA fill:#27ae60,stroke:#333,color:#fff
    style ValkeyPlugin fill:#27ae60,stroke:#333,color:#fff
    style VaultPlugin fill:#27ae60,stroke:#333,color:#fff
    style PDPDiff fill:#95a5a6,stroke:#333,color:#fff
    style Benches fill:#95a5a6,stroke:#333,color:#fff
    style AuditLogger fill:#bdc3c7,stroke:#333
    style PIIScanner fill:#bdc3c7,stroke:#333
    style HostApp fill:#3498db,stroke:#333,color:#fff
