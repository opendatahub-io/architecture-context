graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph Platform["PLATFORM LAYER (Auth Enforcement)"]
        PlatformProxy["KServe / ModelMesh / Istio Gateway<br/>kube-rbac-proxy / OAuth Proxy<br/>TLS termination + AuthN/AuthZ"]
    end

    subgraph CaikitPod["CAIKIT POD (No Built-in Auth)"]
        direction TB

        subgraph Servers["Caikit Runtime Servers"]
            GRPCServer["gRPC Server<br/>8085/TCP<br/>gRPC/HTTP2<br/>TLS 1.2+ / mTLS / plaintext<br/>(configurable)"]
            HTTPServer["HTTP Server<br/>8080/TCP<br/>HTTP/1.1<br/>TLS / mTLS / plaintext<br/>(configurable)"]
            MetricsServer["Prometheus Metrics<br/>8086/TCP<br/>HTTP plaintext"]
        end

        subgraph PodLocal["Pod-Local Communication"]
            MMeshSocket["ModelMesh Sidecar<br/>unix:/tmp/mmesh/grpc.sock<br/>gRPC plaintext<br/>mmesh.ModelRuntime"]
        end
    end

    subgraph Egress["EGRESS (Outbound)"]
        OTLPCollector["OTLP Collector<br/>4317/TCP gRPC or 4318/TCP HTTP<br/>TLS / mTLS configurable"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM credentials"]
        RemoteCaikit["Remote Caikit Instances<br/>Configurable port<br/>gRPC or HTTP<br/>TLS / mTLS configurable"]
    end

    %% External → Platform
    Client -->|"HTTPS / gRPC<br/>TLS 1.2+<br/>Bearer Token / OAuth<br/>(platform-enforced)"| PlatformProxy

    %% Platform → Caikit
    PlatformProxy -->|"gRPC/8085<br/>TLS/mTLS/plaintext<br/>Auth: None (delegated)"| GRPCServer
    PlatformProxy -->|"HTTP/8080<br/>TLS/mTLS/plaintext<br/>Auth: None (delegated)"| HTTPServer

    %% Pod-local
    MMeshSocket -->|"unix socket<br/>gRPC plaintext<br/>loadModel/unloadModel"| GRPCServer

    %% Egress
    GRPCServer -->|"OTLP/4317 or 4318<br/>TLS/mTLS<br/>Trace export"| OTLPCollector
    GRPCServer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM<br/>Training data I/O"| S3
    GRPCServer -->|"gRPC or HTTP<br/>TLS/mTLS<br/>Model discovery"| RemoteCaikit

    %% Prometheus scrape
    MetricsServer -.->|"HTTP/8086<br/>plaintext<br/>Prometheus scrape"| MetricsServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef caikit fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef podlocal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class PlatformProxy platform
    class GRPCServer,HTTPServer,MetricsServer caikit
    class MMeshSocket podlocal
    class OTLPCollector,S3,RemoteCaikit egress
