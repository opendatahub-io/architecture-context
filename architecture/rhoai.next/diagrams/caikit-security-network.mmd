graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph Platform["PLATFORM LAYER (KServe / Service Mesh)"]
        PlatformNote["Auth & ingress delegated<br/>to platform layer"]
    end

    subgraph CaikitRuntime["CAIKIT RUNTIME (In-process)"]
        direction TB

        HTTPServer["HTTP Server (FastAPI)<br/>8080/TCP<br/>Configurable TLS 1.2+/mTLS<br/>No built-in auth"]
        GRPCServer["gRPC Server<br/>8085/TCP<br/>Configurable TLS 1.2+/mTLS<br/>No built-in auth"]
        PrometheusMetrics["Prometheus Metrics<br/>8086/TCP<br/>plaintext<br/>No auth"]

        subgraph Servicers["Shared Servicer Logic"]
            GlobalPredict["GlobalPredictServicer"]
            GlobalTrain["GlobalTrainServicer"]
            ModelMgr["ModelManager"]
        end

        HTTPServer --> GlobalPredict
        GRPCServer --> GlobalPredict
        HTTPServer --> GlobalTrain
        GRPCServer --> GlobalTrain
        GlobalPredict --> ModelMgr
        GlobalTrain --> ModelMgr
    end

    subgraph LocalIPC["LOCAL IPC (Same Pod)"]
        ModelRuntime["ModelRuntime Service<br/>Unix socket: /tmp/mmesh/grpc.sock<br/>gRPC plaintext<br/>No auth"]
        ModelMeshCtrl["ModelMesh Controller<br/>(co-located sidecar)"]
    end

    subgraph HealthMon["HEALTH MONITORING (Separate Process)"]
        HealthProbe["caikit_health_probe<br/>Readiness: gRPC + HTTP<br/>Liveness: psutil<br/>TLS-aware"]
    end

    subgraph EgressServices["EGRESS (Outbound)"]
        OTel["OpenTelemetry Collector<br/>4317/TCP (gRPC) or 4318/TCP (HTTP)<br/>Configurable TLS/mTLS"]
        RemoteCaikit["Remote Caikit Runtime<br/>Configurable port<br/>gRPC TLS/mTLS"]
    end

    %% External flows
    Client -->|"HTTP/8080 or gRPC/8085<br/>TLS 1.2+/mTLS<br/>Auth: platform-delegated"| Platform
    Platform -->|"Forwarded request"| HTTPServer
    Platform -->|"Forwarded request"| GRPCServer

    %% Health monitoring
    HealthProbe -->|"gRPC Health.Check<br/>8085/TCP TLS"| GRPCServer
    HealthProbe -->|"GET /api/v1/health<br/>8080/TCP TLS"| HTTPServer

    %% ModelMesh IPC
    ModelMeshCtrl -->|"gRPC/Unix socket<br/>plaintext<br/>loadModel/unloadModel"| ModelRuntime
    ModelRuntime --> ModelMgr

    %% Prometheus
    PromScraper["Prometheus Scraper"] -->|"HTTP/8086<br/>plaintext"| PrometheusMetrics

    %% Egress
    CaikitRuntime -->|"OTLP traces<br/>gRPC/4317 or HTTP/4318<br/>TLS/mTLS"| OTel
    CaikitRuntime -->|"Remote inference<br/>gRPC/configurable<br/>TLS/mTLS"| RemoteCaikit

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#dce4f0,stroke:#6b7fa3,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef ipc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef egress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef health fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class PlatformNote platform
    class HTTPServer,GRPCServer,PrometheusMetrics,GlobalPredict,GlobalTrain,ModelMgr runtime
    class ModelRuntime,ModelMeshCtrl ipc
    class OTel,RemoteCaikit egress
    class HealthProbe health
    class PromScraper external
