graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Application"]
    end

    subgraph Platform["PLATFORM LAYER (Auth Enforcement)"]
        KServeGW["KServe / Istio Gateway<br/>TLS termination<br/>AuthN/AuthZ enforcement"]
    end

    subgraph CaikitRuntime["CAIKIT RUNTIME (Library in serving container)"]
        direction TB

        subgraph HTTPZone["HTTP Server"]
            HTTPSrv["FastAPI HTTP Server<br/>0.0.0.0:8080/TCP<br/>HTTP/HTTPS<br/>Configurable TLS 1.2+/mTLS<br/>No built-in auth"]
        end

        subgraph GRPCZone["gRPC Server"]
            GRPCSrv["gRPC Server<br/>0.0.0.0:8085/TCP<br/>gRPC (HTTP/2)<br/>Configurable TLS 1.2+/mTLS<br/>No built-in auth"]
        end

        subgraph MetricsZone["Metrics"]
            MetricsSrv["Prometheus Metrics<br/>0.0.0.0:8086/TCP<br/>HTTP plaintext<br/>No auth"]
        end

        subgraph MMeshZone["ModelMesh IPC"]
            MMeshSrv["ModelRuntime Service<br/>/tmp/mmesh/grpc.sock<br/>Unix socket gRPC<br/>plaintext<br/>No auth"]
        end

        subgraph ProbeZone["Health Probe"]
            Probe["caikit_health_probe<br/>Separate process<br/>gRPC + HTTP checks<br/>psutil liveness"]
        end
    end

    subgraph EgressServices["EGRESS DESTINATIONS"]
        OTel["OpenTelemetry Collector<br/>4317/TCP (gRPC) or 4318/TCP (HTTP)<br/>Configurable TLS/mTLS"]
        RemoteCaikit["Remote Caikit Runtime<br/>Configurable port<br/>gRPC TLS/mTLS"]
        LocalFS["Local Filesystem<br/>Model artifacts<br/>Training output"]
    end

    subgraph PodLocal["SAME-POD SERVICES"]
        MMeshCtrl["ModelMesh Controller<br/>Model orchestration"]
        PromScraper["Prometheus Scraper"]
    end

    %% External → Platform → Caikit
    Client -->|"HTTPS/8080 or gRPC/8085<br/>TLS 1.2+<br/>Auth: platform-enforced"| KServeGW
    KServeGW -->|"HTTP/8080<br/>Configurable TLS"| HTTPSrv
    KServeGW -->|"gRPC/8085<br/>Configurable TLS/mTLS"| GRPCSrv

    %% Same-pod connections
    MMeshCtrl -->|"Unix socket gRPC<br/>plaintext<br/>No auth"| MMeshSrv
    PromScraper -->|"HTTP/8086<br/>plaintext<br/>No auth"| MetricsSrv

    %% Health probe
    Probe -.->|"gRPC Health.Check<br/>TLS matching runtime"| GRPCSrv
    Probe -.->|"HTTP /health<br/>TLS matching runtime"| HTTPSrv

    %% Egress
    CaikitRuntime -->|"gRPC/4317 or HTTP/4318<br/>Configurable TLS/mTLS"| OTel
    CaikitRuntime -->|"gRPC<br/>Configurable TLS/mTLS"| RemoteCaikit
    CaikitRuntime -->|"File I/O<br/>Local only"| LocalFS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef podlocal fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef probe fill:#fce4ec,stroke:#c62828

    class Client external
    class KServeGW platform
    class HTTPSrv,GRPCSrv,MetricsSrv,MMeshSrv runtime
    class Probe probe
    class OTel,RemoteCaikit,LocalFS egress
    class MMeshCtrl,PromScraper podlocal
