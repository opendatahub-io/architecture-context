graph TB
    subgraph PlatformOperator["ODH / RHOAI Platform Operator"]
        PlatformCtrl["Platform Controller"]
    end

    subgraph ModuleOperator["MCP Lifecycle Module Operator"]
        direction TB
        Reconciler["Reconciler<br/>(controller-runtime)"]
        TLSReader["TLS Profile Reader<br/>(reads APIServer CR)"]
        ManifestProvider["Manifest Provider<br/>(manifestival)"]
        GC["Garbage Collector<br/>(odh-platform-utilities)"]
        EmbeddedManifests["Embedded Operand Manifests<br/>(go:embed, 2167 lines)"]

        Reconciler -->|reads TLS config| TLSReader
        Reconciler -->|renders manifests| ManifestProvider
        Reconciler -->|triggers cleanup| GC
        ManifestProvider -->|loads| EmbeddedManifests
    end

    subgraph Operand["MCP Lifecycle Operator (Operand)"]
        OperandCtrl["Operand Controller Manager<br/>mcp-lifecycle-operator-controller-manager"]
        MetricsService["Metrics Service<br/>8443/TCP HTTPS"]
        OperandCtrl --- MetricsService
    end

    %% CRDs
    MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]
    MCPServerCRD["MCPServer CRD<br/>(Namespaced)<br/>mcp.x-k8s.io"]

    %% External
    K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
    OSAPIServer["OpenShift APIServer CR<br/>config.openshift.io"]
    ConfigMap["ConfigMap<br/>odh-mcplifecycleoperator-config"]
    Prometheus["Prometheus"]

    %% Flows
    PlatformCtrl -->|creates / updates| MCPLifecycleOpCR
    MCPLifecycleOpCR -->|watched by| Reconciler
    TLSReader -->|reads TLS profile| OSAPIServer
    Reconciler -->|reads platformVersion| ConfigMap
    Reconciler -->|SSA apply:<br/>Deployment, RBAC,<br/>CRD, Service,<br/>NetworkPolicy,<br/>ServiceMonitor| K8sAPI
    K8sAPI -->|deploys| Operand
    Reconciler -->|patches status| MCPLifecycleOpCR
    GC -->|discovers & deletes<br/>stale resources| K8sAPI
    OperandCtrl -->|manages| MCPServerCRD
    Prometheus -->|scrapes /metrics| MetricsService

    %% Styles
    style Reconciler fill:#4a90e2,color:#fff
    style TLSReader fill:#4a90e2,color:#fff
    style ManifestProvider fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style EmbeddedManifests fill:#4a90e2,color:#fff
    style MCPLifecycleOpCR fill:#f5a623,color:#fff
    style MCPServerCRD fill:#f5a623,color:#fff
    style OperandCtrl fill:#7ed321,color:#fff
    style MetricsService fill:#7ed321,color:#fff
    style PlatformCtrl fill:#9b59b6,color:#fff
    style K8sAPI fill:#e8e8e8
    style OSAPIServer fill:#e8e8e8
    style ConfigMap fill:#e8e8e8
    style Prometheus fill:#e8e8e8
