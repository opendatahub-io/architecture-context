graph TB
    subgraph ModuleOperator["MCP Lifecycle Module Operator"]
        direction TB
        Controller["Module Operator Controller<br/>(controller-runtime)<br/>8081/TCP health"]
        ManifestRenderer["Manifest Renderer<br/>(manifestival + kustomize)"]
        SSADeployer["SSA Deployer<br/>(odh-platform-utilities)"]
        GarbageCollector["Garbage Collector<br/>(odh-platform-utilities)"]
        ConversionChecker["Conversion Health Checker<br/>(dynamic client)"]
        MigrationDriver["Storage Migration Driver<br/>(bounded retry: 5 attempts)"]
        TLSResolver["TLS Config Resolver<br/>(OpenShift APIServer profile)"]

        Controller --> ManifestRenderer
        Controller --> TLSResolver
        ManifestRenderer --> SSADeployer
        Controller --> GarbageCollector
        Controller --> ConversionChecker
        Controller --> MigrationDriver
    end

    subgraph Operand["MCP Lifecycle Operator (Operand)"]
        direction TB
        OperandController["MCPLO Controller<br/>8081/TCP health"]
        OperandWebhook["Webhook Server<br/>9443/TCP TLS"]
        OperandMetrics["Metrics<br/>8443/TCP HTTPS"]
        OperandController --> OperandWebhook
    end

    PlatformOperator["ODH Platform Operator"] -->|creates| MCPLOCR["MCPLifecycleOperator CR<br/>(cluster-scoped, name=default)"]
    MCPLOCR -->|watched by| Controller

    TLSResolver -->|reads TLS profile| APIServer["OpenShift APIServer CR"]

    SSADeployer -->|deploys| Operand
    GarbageCollector -->|cleans stale resources| Operand

    ConversionChecker -->|lists MCPServers at v1beta1| K8sAPI["Kubernetes API<br/>6443/TCP"]
    MigrationDriver -->|creates| SVM["StorageVersionMigration CR"]
    SVM -->|processed by| KSVM["kube-storage-version-migrator"]

    OperandController -->|manages| MCPServerCR["MCPServer CR<br/>(namespaced)"]
    OperandController -->|manages| MCPGatewayBindingCR["MCPGatewayBinding CR<br/>(namespaced)"]
    OperandController -->|manages| HTTPRoute["HTTPRoute<br/>(Gateway API)"]

    Controller -->|updates status.releases| MCPLOCR
    PlatformOperator -->|reads status.releases| MCPLOCR

    style Controller fill:#4a90e2,color:#fff
    style ManifestRenderer fill:#4a90e2,color:#fff
    style SSADeployer fill:#4a90e2,color:#fff
    style GarbageCollector fill:#4a90e2,color:#fff
    style ConversionChecker fill:#4a90e2,color:#fff
    style MigrationDriver fill:#4a90e2,color:#fff
    style TLSResolver fill:#4a90e2,color:#fff
    style OperandController fill:#7ed321,color:#fff
    style OperandWebhook fill:#7ed321,color:#fff
    style OperandMetrics fill:#7ed321,color:#fff
    style MCPLOCR fill:#f5a623,color:#fff
    style MCPServerCR fill:#f5a623,color:#fff
    style MCPGatewayBindingCR fill:#f5a623,color:#fff
    style PlatformOperator fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style APIServer fill:#e8e8e8
    style KSVM fill:#e8e8e8
    style SVM fill:#f5a623,color:#fff
    style HTTPRoute fill:#f5a623,color:#fff
