graph LR
    PC["Pipelines Components<br/>(KFP Library + Container Images)"]

    %% Internal RHOAI Dependencies
    PC -->|"init container<br/>shared volume"| KFPAPI["KFP API Server"]
    PC -->|"CRD CRUD<br/>InferenceService<br/>ServingRuntime"| KServe["KServe"]
    PC -->|"TrainerClient API<br/>TrainJob CR"| Trainer["Kubeflow Trainer"]
    PC -->|"REST API<br/>8080/TCP HTTP"| ModelReg["Model Registry"]
    PC -->|"REST API<br/>443/TCP HTTPS"| EvalHub["Eval Hub"]
    PC -->|"CRD (RayJob)"| Ray["Ray / CodeFlare"]
    PC -.->|"CRD (WorkloadPriority)"| Kueue["Kueue (optional)"]
    PC -->|"REST API<br/>443/TCP HTTPS"| OGX["OGX"]
    PC -->|"gRPC client<br/>19530/TCP"| Milvus["Milvus"]
    PC -.->|"annotation conventions"| Dashboard["RHOAI Dashboard"]
    PC -.->|"REST API (optional)"| MLflow["MLflow (optional)"]

    %% External Dependencies
    PC -->|"AWS SDK<br/>443/9000 TCP"| S3["S3/MinIO"]
    PC -->|"REST API<br/>443/TCP HTTPS"| HF["HuggingFace Hub"]
    PC -->|"REST API<br/>443/TCP HTTPS"| LiteLLM["LiteLLM"]
    PC -->|"OCI pull<br/>443/TCP HTTPS"| OCI["OCI Registry"]
    PC -->|"HTTPS<br/>443/TCP"| K8sAPI["Kubernetes API"]

    %% Key Python Dependencies
    subgraph PythonDeps["Key Python Dependencies"]
        KFP["kfp >=2.16.1"]
        KFPKube["kfp-kubernetes >=2.16.1"]
        AutoGluon["AutoGluon (tabular, timeseries)"]
        AI4RAG["ai4rag ~=0.10.1"]
        DoclingLib["Docling >=1.0.0"]
        SDGHub["SDG Hub >=0.7.0"]
        LMEvalLib["lm-eval >=0.4.0"]
        Unsloth["Unsloth >=2024.11.0"]
        CodeFlareSdk["codeflare-sdk ==0.35.0"]
        ModelRegClient["model-registry ==0.3.4"]
        Boto3["boto3 >=1.28.0"]
        K8sClient["kubernetes >=28.1.0"]
        PyMilvus["pymilvus >=2.4.0"]
    end

    PC -->|"core SDK"| KFP
    PC -->|"K8s extensions"| KFPKube

    %% Consumers (who uses pipelines-components)
    Dashboard -->|"UI management<br/>one-click pipelines"| PC
    KFPAPI -->|"executes tasks"| PC

    %% Styling
    style PC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI
    style KFPAPI fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style Trainer fill:#7ed321,stroke:#333,color:#fff
    style ModelReg fill:#f8cecc,stroke:#b85450,color:#333
    style EvalHub fill:#7ed321,stroke:#333,color:#fff
    style Ray fill:#7ed321,stroke:#333,color:#fff
    style Kueue fill:#c8e6c9,stroke:#333,color:#333
    style OGX fill:#7ed321,stroke:#333,color:#fff
    style Milvus fill:#f8cecc,stroke:#b85450,color:#333
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style MLflow fill:#c8e6c9,stroke:#333,color:#333

    %% External
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style HF fill:#f5a623,stroke:#333,color:#fff
    style LiteLLM fill:#f5a623,stroke:#333,color:#fff
    style OCI fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff

    %% Python deps
    style PythonDeps fill:#f5f5f5,stroke:#999
    style KFP fill:#dae8fc,stroke:#6c8ebf
    style KFPKube fill:#dae8fc,stroke:#6c8ebf
    style AutoGluon fill:#dae8fc,stroke:#6c8ebf
    style AI4RAG fill:#dae8fc,stroke:#6c8ebf
    style DoclingLib fill:#dae8fc,stroke:#6c8ebf
    style SDGHub fill:#dae8fc,stroke:#6c8ebf
    style LMEvalLib fill:#dae8fc,stroke:#6c8ebf
    style Unsloth fill:#dae8fc,stroke:#6c8ebf
    style CodeFlareSdk fill:#dae8fc,stroke:#6c8ebf
    style ModelRegClient fill:#dae8fc,stroke:#6c8ebf
    style Boto3 fill:#dae8fc,stroke:#6c8ebf
    style K8sClient fill:#dae8fc,stroke:#6c8ebf
    style PyMilvus fill:#dae8fc,stroke:#6c8ebf
