graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-manager<br/>(operator namespace)"]
    end

    subgraph ClusterBindings["Cluster Role Bindings"]
        CRB["manager-rolebinding<br/>(Cluster-scoped)"]
        LeaderRB["leader-election-rolebinding<br/>(Namespace-scoped)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        ManagerRole["manager-role"]
        AdminRole["mcpserver-admin-role<br/>(aggregate)"]
        EditorRole["mcpserver-editor-role<br/>(aggregate)"]
        ViewerRole["mcpserver-viewer-role<br/>(aggregate)"]
        MetricsAuth["metrics-auth-role"]
        MetricsReader["metrics-reader"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        LeaderRole["leader-election-role"]
    end

    subgraph PlatformResources["Platform API Resources"]
        MCPLifecycleOpCR["components.platform.opendatahub.io<br/>MCPLifecycleOperator<br/>+ status, finalizers"]
    end

    subgraph K8sResources["Kubernetes Core Resources"]
        CRDs["apiextensions.k8s.io<br/>CustomResourceDefinitions"]
        Deployments["apps<br/>Deployments"]
        CoreRes["core<br/>ConfigMaps, Namespaces,<br/>ServiceAccounts, Services"]
        Secrets["core<br/>Secrets"]
        Pods["core<br/>Pods"]
        Events["events.k8s.io<br/>Events"]
        RBAC["rbac.authorization.k8s.io<br/>Roles, RoleBindings,<br/>ClusterRoles, ClusterRoleBindings"]
        Leases["coordination.k8s.io<br/>Leases"]
        NetPolicies["networking.k8s.io<br/>NetworkPolicies"]
        ServiceMonitors["monitoring.coreos.com<br/>ServiceMonitors"]
    end

    subgraph MCPResources["MCP API Resources"]
        MCPServers["mcp.x-k8s.io<br/>MCPServers<br/>+ status, finalizers"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph NonResource["Non-Resource URLs"]
        Metrics["/metrics"]
    end

    %% Bindings
    SA -->|bound via| CRB
    SA -->|bound via| LeaderRB
    CRB -->|grants| ManagerRole
    LeaderRB -->|grants| LeaderRole

    %% Manager Role permissions
    ManagerRole -->|"full CRUD"| MCPLifecycleOpCR
    ManagerRole -->|"full CRUD"| CRDs
    ManagerRole -->|"full CRUD"| Deployments
    ManagerRole -->|"full CRUD"| CoreRes
    ManagerRole -->|"get, list, watch"| Secrets
    ManagerRole -->|"get, list"| Pods
    ManagerRole -->|"create, patch"| Events
    ManagerRole -->|"full CRUD"| RBAC
    ManagerRole -->|"full CRUD"| Leases
    ManagerRole -->|"full CRUD + deletecollection"| MCPServers
    ManagerRole -->|"create"| TokenReviews
    ManagerRole -->|"create"| SAR
    ManagerRole -->|"get, list, watch"| APIServers["config.openshift.io<br/>APIServers"]
    ManagerRole -->|"full CRUD"| NetPolicies
    ManagerRole -->|"full CRUD"| ServiceMonitors
    ManagerRole -->|"get"| Metrics

    %% Aggregate roles
    AdminRole -->|"full CRUD + deletecollection"| MCPServers
    EditorRole -->|"create, delete, get, list,<br/>patch, update, watch"| MCPServers
    ViewerRole -->|"get, list, watch"| MCPServers
    MetricsAuth -->|"create"| TokenReviews
    MetricsAuth -->|"create"| SAR
    MetricsReader -->|"get"| Metrics

