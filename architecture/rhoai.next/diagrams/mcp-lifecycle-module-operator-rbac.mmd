graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Module["controller-manager<br/>(module operator namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["mcp-lifecycle-module-operator-<br/>manager-rolebinding"]
    end

    subgraph ClusterRole["ClusterRole: mcp-lifecycle-module-operator-manager-role"]
        CR["manager-role"]
    end

    SA_Module -->|"bound via"| CRB
    CRB -->|"grants"| CR

    subgraph ODH_Resources["ODH Platform Resources"]
        MCPLifecycleOps["components.platform.opendatahub.io<br/>mcplifecycleoperators<br/>+ /status + /finalizers"]
    end

    subgraph K8s_Core["Kubernetes Core Resources"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        Deployments["apps<br/>deployments"]
        CoreResources["core<br/>services, serviceaccounts,<br/>namespaces, configmaps"]
        Secrets["core<br/>secrets<br/>(get, list, watch only)"]
        Pods["core<br/>pods<br/>(get, list only)"]
        Events["core, events.k8s.io<br/>events<br/>(create, patch only)"]
    end

    subgraph RBAC_Resources["RBAC Resources"]
        RBACAll["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    subgraph MCP_Resources["MCP Resources"]
        MCPServers["mcp.x-k8s.io<br/>mcpservers<br/>+ /status + /finalizers<br/>(includes deletecollection)"]
    end

    subgraph Auth_Resources["Auth & Security Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>(create only)"]
        SubjectAccess["authorization.k8s.io<br/>subjectaccessreviews<br/>(create only)"]
        APIServers["config.openshift.io<br/>apiservers<br/>(get, list, watch only)"]
    end

    subgraph Network_Monitoring["Network & Monitoring Resources"]
        NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
        MetricsNonRes["/metrics<br/>(non-resource URL)<br/>(get only)"]
    end

    %% Full CRUD permissions
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| MCPLifecycleOps
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| CRDs
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| Deployments
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| CoreResources
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| RBACAll
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| Leases
    CR -->|"full CRUD +<br/>deletecollection"| MCPServers
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| NetworkPolicies
    CR -->|"get, list, watch,<br/>create, update,<br/>patch, delete"| ServiceMonitors

    %% Limited permissions
    CR -->|"get, list, watch"| Secrets
    CR -->|"get, list"| Pods
    CR -->|"create, patch"| Events
    CR -->|"create"| TokenReviews
    CR -->|"create"| SubjectAccess
    CR -->|"get, list, watch"| APIServers
    CR -->|"get"| MetricsNonRes

    %% Operand RBAC (deployed by module operator)
    subgraph OperandRBAC["Operand RBAC (Deployed via SSA)"]
        OperandManager["ClusterRole:<br/>mcp-lifecycle-operator-<br/>manager-role"]
        OperandAdmin["ClusterRole:<br/>mcpserver-admin-role<br/>(aggregate)"]
        OperandEditor["ClusterRole:<br/>mcpserver-editor-role<br/>(aggregate)"]
        OperandViewer["ClusterRole:<br/>mcpserver-viewer-role<br/>(aggregate)"]
        OperandMetricsAuth["ClusterRole:<br/>metrics-auth-role"]
        OperandLeaderElection["Role:<br/>leader-election-role"]
    end

    %% Styles
    style SA_Module fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#e8e8e8
    style MCPLifecycleOps fill:#7ed321,color:#fff
    style MCPServers fill:#7ed321,color:#fff
    style Secrets fill:#e74c3c,color:#fff
    style TokenReviews fill:#e74c3c,color:#fff
    style SubjectAccess fill:#e74c3c,color:#fff
    style OperandManager fill:#9b59b6,color:#fff
    style OperandAdmin fill:#9b59b6,color:#fff
    style OperandEditor fill:#9b59b6,color:#fff
    style OperandViewer fill:#9b59b6,color:#fff
    style OperandMetricsAuth fill:#9b59b6,color:#fff
    style OperandLeaderElection fill:#9b59b6,color:#fff
