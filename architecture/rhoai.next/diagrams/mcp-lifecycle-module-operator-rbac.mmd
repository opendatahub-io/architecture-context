graph TD
    subgraph ServiceAccounts["Service Accounts"]
        ModuleSA["mcp-lifecycle-module-operator-<br/>controller-manager"]
        OperandSA["mcp-lifecycle-operator-<br/>controller-manager"]
    end

    subgraph ModuleBindings["Module Operator Bindings"]
        ModuleCRB["mcp-lifecycle-module-operator-<br/>manager-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph OperandBindings["Operand Bindings"]
        OperandCRB["mcp-lifecycle-operator-<br/>manager-rolebinding<br/>(ClusterRoleBinding)"]
        MetricsCRB["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        LeaderRB["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>(RoleBinding)"]
    end

    subgraph ModuleRole["Module Operator ClusterRole"]
        ModuleCR["mcp-lifecycle-module-operator-<br/>manager-role"]
    end

    subgraph OperandRoles["Operand Roles"]
        OperandCR["mcp-lifecycle-operator-<br/>manager-role<br/>(ClusterRole)"]
        MetricsCR["mcp-lifecycle-operator-<br/>metrics-auth-role<br/>(ClusterRole)"]
        LeaderRole["mcp-lifecycle-operator-<br/>leader-election-role<br/>(Role)"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles (User-Facing)"]
        AdminCR["mcpserver-admin-role<br/>(aggregate-to-admin)<br/>MCPServer CRUD"]
        EditorCR["mcpserver-editor-role<br/>(aggregate-to-edit)<br/>MCPServer CRUD"]
        ViewerCR["mcpserver-viewer-role<br/>(aggregate-to-view)<br/>MCPServer get/list/watch"]
    end

    subgraph ModuleResources["Module Operator API Resources"]
        MCPLOCR["components.platform.opendatahub.io<br/>MCPLifecycleOperator<br/>(CRUD + watch)"]
        CRDs["apiextensions.k8s.io<br/>CRDs<br/>(CRUD + watch)"]
        Deployments["apps<br/>Deployments<br/>(CRUD + watch)"]
        CoreRW["core<br/>Services, SAs, Namespaces, ConfigMaps<br/>(CRUD + watch)"]
        CoreRO["core<br/>Pods, Secrets<br/>(get, list, watch)"]
        RBAC["rbac.authorization.k8s.io<br/>Roles, Bindings, ClusterRoles<br/>(CRUD + watch)"]
        MCPResources["mcp.x-k8s.io<br/>MCPServers, MCPGatewayBindings<br/>(CRUD + deletecollection + watch)"]
        GatewayResources["gateway.networking.k8s.io<br/>Gateways (read) / HTTPRoutes (CRUD)"]
        KuadrantResources["mcp.kuadrant.io<br/>MCPGatewayExtensions (read)<br/>MCPServerRegistrations (CRUD)"]
        CertManagerRes["cert-manager.io<br/>Certificates, Issuers<br/>(CRUD + watch)"]
        AdmissionRes["admissionregistration.k8s.io<br/>ValidatingWebhookConfigs<br/>(CRUD + watch)"]
        AuthRes["authentication/authorization<br/>TokenReviews, SubjectAccessReviews<br/>(create)"]
        OSConfig["config.openshift.io<br/>APIServers<br/>(get, list, watch)"]
        MonitoringRes["monitoring.coreos.com<br/>ServiceMonitors<br/>(CRUD + watch)"]
        NetworkRes["networking.k8s.io<br/>NetworkPolicies<br/>(CRUD + watch)"]
        MigrationRes["migration.k8s.io<br/>StorageVersionMigrations<br/>(create, delete, get)"]
        LeaseRes["coordination.k8s.io<br/>Leases<br/>(CRUD + watch)"]
        MetricsURL["/metrics<br/>(get)"]
    end

    %% Module operator chain
    ModuleSA -->|bound via| ModuleCRB
    ModuleCRB -->|grants| ModuleCR

    ModuleCR -->|permissions| MCPLOCR
    ModuleCR -->|permissions| CRDs
    ModuleCR -->|permissions| Deployments
    ModuleCR -->|permissions| CoreRW
    ModuleCR -->|permissions| CoreRO
    ModuleCR -->|permissions| RBAC
    ModuleCR -->|permissions| MCPResources
    ModuleCR -->|permissions| GatewayResources
    ModuleCR -->|permissions| KuadrantResources
    ModuleCR -->|permissions| CertManagerRes
    ModuleCR -->|permissions| AdmissionRes
    ModuleCR -->|permissions| AuthRes
    ModuleCR -->|permissions| OSConfig
    ModuleCR -->|permissions| MonitoringRes
    ModuleCR -->|permissions| NetworkRes
    ModuleCR -->|permissions| MigrationRes
    ModuleCR -->|permissions| LeaseRes
    ModuleCR -->|permissions| MetricsURL

    %% Operand chain
    OperandSA -->|bound via| OperandCRB
    OperandSA -->|bound via| MetricsCRB
    OperandSA -->|bound via| LeaderRB
    OperandCRB -->|grants| OperandCR
    MetricsCRB -->|grants| MetricsCR
    LeaderRB -->|grants| LeaderRole

    style ModuleSA fill:#4a90e2,color:#fff
    style OperandSA fill:#7ed321,color:#fff
    style ModuleCR fill:#f5a623,color:#fff
    style OperandCR fill:#f5a623,color:#fff
    style MetricsCR fill:#f5a623,color:#fff
    style LeaderRole fill:#f5a623,color:#fff
    style AdminCR fill:#e8c8ff,stroke:#9b59b6
    style EditorCR fill:#e8c8ff,stroke:#9b59b6
    style ViewerCR fill:#e8c8ff,stroke:#9b59b6
    style MCPLOCR fill:#d5e8d4
    style MCPResources fill:#d5e8d4
