graph TB
    subgraph "llm-d-model-service Operator"
        Controller["ModelService Controller<br/>(controller-runtime v0.20.4)"]
        GenerateCLI["generate CLI subcommand<br/>(offline manifest generation)"]
        TemplateEngine["Template Engine<br/>(Sprig + Go templates)"]
        MergeLayer["Merge Layer<br/>(Mergo with custom transformers)"]

        Controller -->|uses| TemplateEngine
        Controller -->|uses| MergeLayer
    end

    subgraph "Configuration"
        BaseConfig["BaseConfig ConfigMap<br/>(platform-managed presets)"]
        ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
    end

    subgraph "Managed Resources"
        PrefillDeploy["Prefill Deployment"]
        DecodeDeploy["Decode Deployment"]
        EPPDeploy["EPP Deployment<br/>(Endpoint Picker)"]
        EPPService["EPP Service"]
        HTTPRoute["HTTPRoute"]
        InferencePool["InferencePool CR"]
        InferenceModel["InferenceModel CR"]
        ManagedSA["ServiceAccounts"]
        ManagedRB["RoleBindings"]
        ManagedCM["ConfigMaps"]
    end

    User["User / Platform Admin"] -->|creates| ModelServiceCR
    ModelServiceCR -->|watched by| Controller
    BaseConfig -->|read by| Controller

    TemplateEngine -->|interpolates| BaseConfig
    MergeLayer -->|merges BaseConfig +<br/>ModelService spec| Controller

    Controller -->|creates/manages| PrefillDeploy
    Controller -->|creates/manages| DecodeDeploy
    Controller -->|creates/manages| EPPDeploy
    Controller -->|creates/manages| EPPService
    Controller -->|creates/manages| HTTPRoute
    Controller -->|creates/manages| InferencePool
    Controller -->|creates/manages| InferenceModel
    Controller -->|creates/manages| ManagedSA
    Controller -->|creates/manages| ManagedRB
    Controller -->|creates/manages| ManagedCM

    Controller -->|CRUD| K8sAPI["Kubernetes API Server"]

    subgraph "Model Sources"
        HF["HuggingFace Hub<br/>(hf://)"]
        PVC["PVC Storage<br/>(pvc://)"]
        OCI["OCI Images<br/>(oci://)"]
    end

    PrefillDeploy -.->|loads model| HF
    PrefillDeploy -.->|loads model| PVC
    DecodeDeploy -.->|loads model| HF
    DecodeDeploy -.->|loads model| PVC

    Prometheus["Prometheus"] -->|scrapes /metrics<br/>8443/TCP HTTPS| Controller

    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px
    style GenerateCLI fill:#4a90e2,stroke:#333
    style TemplateEngine fill:#6baed6,stroke:#333
    style MergeLayer fill:#6baed6,stroke:#333
    style ModelServiceCR fill:#f5a623,stroke:#333
    style BaseConfig fill:#f5a623,stroke:#333
    style PrefillDeploy fill:#7ed321,stroke:#333
    style DecodeDeploy fill:#7ed321,stroke:#333
    style EPPDeploy fill:#7ed321,stroke:#333
    style EPPService fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style InferencePool fill:#7ed321,stroke:#333
    style InferenceModel fill:#7ed321,stroke:#333
    style ManagedSA fill:#7ed321,stroke:#333
    style ManagedRB fill:#7ed321,stroke:#333
    style ManagedCM fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style HF fill:#fff2cc,stroke:#d6b656
    style PVC fill:#fff2cc,stroke:#d6b656
    style OCI fill:#fff2cc,stroke:#d6b656
