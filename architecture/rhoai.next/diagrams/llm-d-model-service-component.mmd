graph TB
    subgraph ModelServiceOperator["llm-d-model-service Operator"]
        Controller["modelservice-controller-manager<br/>Go Operator"]
        GenerateCLI["generate CLI<br/>Offline Manifest Generation"]
    end

    User["Model Owner"] -->|creates| ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
    Operator["Platform Operator"] -->|creates| BaseConfigCM["BaseConfig ConfigMap<br/>Platform Defaults"]

    ModelServiceCR -->|watched by| Controller
    BaseConfigCM -->|read by| Controller

    Controller -->|"template interpolation<br/>+ semantic merge"| MergedSpec["Merged Spec"]

    MergedSpec -->|creates| PrefillDeploy["Prefill Deployment"]
    MergedSpec -->|creates| DecodeDeploy["Decode Deployment"]
    MergedSpec -->|creates| EPPDeploy["EPP Deployment<br/>Endpoint Picker"]
    MergedSpec -->|creates| EPPService["EPP Service"]
    MergedSpec -->|creates| InferencePool["InferencePool CR"]
    MergedSpec -->|creates| InferenceModel["InferenceModel CR"]
    MergedSpec -->|creates| HTTPRoute["HTTPRoute CR"]
    MergedSpec -->|creates| RBAC["ServiceAccounts<br/>& RoleBindings"]

    Controller -->|CRUD via| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]

    Controller -->|depends on| GatewayAPI["Gateway API<br/>v1.3.0"]
    Controller -->|depends on| GatewayInfExt["Gateway API<br/>Inference Extension v0.3.0"]
    Controller -->|depends on| ControllerRuntime["controller-runtime<br/>v0.20.4"]

    style Controller fill:#4a90e2,color:#fff
    style GenerateCLI fill:#4a90e2,color:#fff
    style ModelServiceCR fill:#f5a623,color:#fff
    style BaseConfigCM fill:#f5a623,color:#fff
    style PrefillDeploy fill:#7ed321,color:#fff
    style DecodeDeploy fill:#7ed321,color:#fff
    style EPPDeploy fill:#7ed321,color:#fff
    style EPPService fill:#7ed321,color:#fff
    style InferencePool fill:#7ed321,color:#fff
    style InferenceModel fill:#7ed321,color:#fff
    style HTTPRoute fill:#7ed321,color:#fff
    style RBAC fill:#7ed321,color:#fff
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style GatewayInfExt fill:#e8e8e8,stroke:#333
    style ControllerRuntime fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
