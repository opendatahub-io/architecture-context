graph TB
    subgraph "Praxis AI Gateway"
        direction TB
        Proxy["praxis-ai-proxy<br/>(Binary / Entry Point)"]

        subgraph "Filter Pipeline"
            direction LR
            Classifier["Classifier Filters<br/>(provider, model, operation)"]
            Routing["Routing Filters<br/>(intelligent_route, provider_route)"]
            Security["Security Filters<br/>(credential_inject, aws_sigv4_sign,<br/>azure_ad, gcp_adc, state_owner)"]
            Translation["Translation Filters<br/>(anthropic→chat, responses→chat)"]
            Guardrails["Guardrails Filter<br/>(NeMo callout)"]
            Metering["Metering Filter<br/>(token_usage, external metering)"]
            MCP["MCP Filters<br/>(tool_resolve, tool_dispatch)"]
        end

        subgraph "Core Libraries"
            direction LR
            APIs["praxis-ai-apis<br/>(Provider Types, SSE,<br/>Protocol Translation)"]
            Filters["praxis-ai-filters<br/>(Filter Registration,<br/>Cross-Cutting Concerns)"]
            Store["praxis-ai-store<br/>(ResponseStore Traits,<br/>Tenant Ownership)"]
            StoreBackends["praxis-ai-store-backends<br/>(PostgreSQL, SQLite)"]
            StoreLifecycle["praxis-ai-store-lifecycle<br/>(Hot-Reload Lifecycle)"]
            ExtProc["praxis-ai-llmd-ext-proc<br/>(llm-d gRPC Client)"]
        end
    end

    Client["AI Client<br/>(OpenAI SDK / Anthropic SDK /<br/>MCP Client / A2A Agent)"]
    PraxisCore["Praxis Core<br/>(Pingora-based Proxy Runtime)"]
    Inference["Inference Backends<br/>(vLLM, etc.)"]
    PostgreSQL["PostgreSQL<br/>(Response Store)"]
    NeMo["NeMo Guardrails<br/>(Content Safety)"]
    MCPServer["MCP Servers<br/>(Tool Dispatch)"]

    Client -->|"HTTP/HTTPS 8080/TCP"| Proxy
    Proxy -->|"delegates to"| PraxisCore
    Proxy --> Classifier
    Classifier --> Security
    Security --> Translation
    Translation --> Routing
    Routing --> Guardrails
    Guardrails --> Metering

    Filters --> APIs
    APIs --> Store
    Store --> StoreBackends
    StoreBackends --> StoreLifecycle

    Routing -->|"HTTP/HTTPS"| Inference
    StoreBackends -->|"SQL 5432/TCP"| PostgreSQL
    Guardrails -->|"HTTP callout"| NeMo
    MCP -->|"HTTP Streamable"| MCPServer
    ExtProc -.->|"gRPC (optional)"| ExtProcServer["llm-d ext_proc Server"]

    style Proxy fill:#4a90e2,stroke:#333,stroke-width:3px
    style Client fill:#f9f9f9,stroke:#999
    style PraxisCore fill:#e8e8e8,stroke:#333
    style Inference fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style NeMo fill:#f5a623,stroke:#333
    style MCPServer fill:#f5a623,stroke:#333
    style ExtProcServer fill:#f5a623,stroke:#333
    style APIs fill:#7ed321,stroke:#333
    style Filters fill:#7ed321,stroke:#333
    style Store fill:#7ed321,stroke:#333
    style StoreBackends fill:#7ed321,stroke:#333
    style StoreLifecycle fill:#7ed321,stroke:#333
    style ExtProc fill:#7ed321,stroke:#333
    style Classifier fill:#d5e8d4,stroke:#82b366
    style Routing fill:#d5e8d4,stroke:#82b366
    style Security fill:#ffe6cc,stroke:#d79b00
    style Translation fill:#d5e8d4,stroke:#82b366
    style Guardrails fill:#d5e8d4,stroke:#82b366
