graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["CLI User<br/>kubectl odh / rhai-cli"]
        Agent["MCP-Capable Agent<br/>Claude, GPT, Cursor"]
    end

    subgraph LocalHost["LOCAL HOST (User Workstation / Pod)"]
        direction TB
        CLI["odh-cli / rhai-cli<br/>Go CLI Binary<br/>FIPS: strictfipsruntime<br/>CGO_ENABLED=1<br/>PQ Crypto: DEFAULT:PQ"]

        subgraph MCPEndpoint["MCP Server (localhost only)"]
            MCPSSE["SSE Endpoint<br/>127.0.0.1:8080/TCP<br/>HTTP (plaintext)<br/>No Auth"]
            MCPStdio["stdio Transport<br/>stdin/stdout<br/>No Auth"]
        end
    end

    subgraph ClusterBoundary["KUBERNETES CLUSTER (Trusted - RBAC Enforced)"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>Auth: kubeconfig credentials<br/>(bearer token / client cert / OIDC)"]

        subgraph OLMNamespace["Namespace: openshift-operator-lifecycle-manager"]
            OLM["OLM<br/>CSV & Subscription API"]
        end

        subgraph AppNamespace["Namespace: application workloads"]
            TrustYAI["TrustYAI Service Route<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>InsecureSkipVerify=true<br/>Auth: Bearer token"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        GitHub["raw.githubusercontent.com<br/>443/TCP<br/>HTTPS TLS 1.2+<br/>No Auth"]
    end

    %% User flows
    User -->|"stdin/flags<br/>Local process"| CLI
    Agent -->|"JSON-RPC stdio<br/>No encryption<br/>No auth"| MCPStdio
    Agent -->|"HTTP/8080<br/>localhost only<br/>No encryption<br/>No auth"| MCPSSE

    %% CLI to cluster
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig credentials<br/>(token/cert/OIDC)"| K8sAPI
    K8sAPI -->|"RBAC enforced"| OLM
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>InsecureSkipVerify<br/>Bearer token"| TrustYAI

    %% CLI to external
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth"| GitHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef localhost fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    class User,Agent external
    class CLI,MCPSSE,MCPStdio localhost
    class K8sAPI,OLM cluster
    class TrustYAI warning
    class GitHub externalservice
