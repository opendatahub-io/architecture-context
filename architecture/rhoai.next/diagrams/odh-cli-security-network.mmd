graph TB
    subgraph ClientSide["CLIENT-SIDE (User Workstation / Container)"]
        direction TB
        CLI["rhai-cli Binary<br/>FIPS: strictfipsruntime + CGO_ENABLED=1<br/>Base: ose-cli-rhel9 (OpenSSL)"]
        AIAgent["AI Agent (e.g. Claude)"]
    end

    subgraph Cluster["KUBERNETES / OPENSHIFT CLUSTER"]
        direction TB

        subgraph APIServer["API Server"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>Bearer Token / Client Cert"]
        end

        subgraph PlatformCRDs["Platform CRDs (via API Server)"]
            DSC["DSC / DSCI"]
            OLM["OLM<br/>Subscription, CSV"]
            ClusterVersion["ClusterVersion"]
        end

        subgraph WorkloadCRDs["Workload CRDs (via API Server)"]
            ISVC["InferenceService<br/>ServingRuntime"]
            Notebook["Notebook"]
            Kueue["ClusterQueue<br/>LocalQueue"]
            DSPA["DSPA"]
            Ray["RayCluster<br/>RayJob"]
            Training["PyTorchJob<br/>TFJob, MPIJob"]
            LlamaStack["LlamaStackDistribution"]
        end

        subgraph InClusterServices["In-Cluster Services"]
            TrustyAI["TrustyAI REST API<br/>443/TCP HTTPS<br/>TLS 1.2 (InsecureSkipVerify)<br/>Bearer Token"]
        end

        subgraph ServiceMeshCRDs["Service Mesh / Networking CRDs"]
            OSSM["ServiceMeshControlPlane<br/>SMMR"]
            Knative["KnativeServing<br/>KnativeEventing"]
            Kuadrant["Kuadrant / Authorino"]
            CertManager["cert-manager<br/>Certificate"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        GitHub["raw.githubusercontent.com<br/>(odh-gitops)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>No Auth"]
        DlK8s["dl.k8s.io<br/>443/TCP HTTPS<br/>(build-time only)"]
        MirrorOCP["mirror.openshift.com<br/>443/TCP HTTPS<br/>(build-time only)"]
    end

    %% MCP local connection
    AIAgent -->|"stdio / SSE<br/>8080/TCP localhost ONLY<br/>No encryption<br/>No auth"| CLI

    %% Main cluster connection
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token / Client Cert<br/>Read/Write CRDs, Pod Exec,<br/>Log Streaming, Events"| K8sAPI

    %% TrustyAI connection (semi-trusted)
    CLI -->|"HTTPS/443<br/>TLS 1.2<br/>InsecureSkipVerify: true<br/>Bearer Token<br/>Metrics backup/restore"| TrustyAI

    %% External connections
    CLI -->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth<br/>Dependency manifest"| GitHub

    %% Styling
    classDef clientside fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platformcrd fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef workloadcrd fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef incluster fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef external fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef meshcrd fill:#fff2cc,stroke:#d6b656,stroke-width:1px

    class CLI,AIAgent clientside
    class K8sAPI apiserver
    class DSC,OLM,ClusterVersion platformcrd
    class ISVC,Notebook,Kueue,DSPA,Ray,Training,LlamaStack workloadcrd
    class TrustyAI incluster
    class GitHub,DlK8s,MirrorOCP external
    class OSSM,Knative,Kuadrant,CertManager meshcrd
