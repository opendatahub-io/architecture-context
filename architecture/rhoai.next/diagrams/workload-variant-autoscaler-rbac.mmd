graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-manager<br/>Namespace: wva-system"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["manager-rolebinding<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB["leader-election-rolebinding<br/>Namespace: wva-system"]
    end

    subgraph ClusterRoles["ClusterRole: manager-role"]
        direction LR

        subgraph CoreResources["Core API Group"]
            Pods["pods<br/>get, list, watch"]
            NodesR["nodes, nodes/status<br/>get, list, watch"]
            CM["configmaps<br/>get, list, watch"]
            CMStatus["configmaps/status<br/>get"]
            NS["namespaces<br/>get, list, watch"]
            RQ["resourcequotas<br/>get, list, watch"]
            Svc["services<br/>get, list, watch"]
            Events["events<br/>create, patch"]
        end

        subgraph AppsResources["Apps API Group"]
            Deploys["deployments<br/>get, list, patch, update, watch"]
            DeployScale["deployments/scale<br/>get, update"]
            RS["replicasets<br/>get, list, watch"]
            SS["statefulsets<br/>get, list, watch"]
        end

        subgraph AutoscalingResources["Autoscaling API Group"]
            HPA["horizontalpodautoscalers<br/>get, list, patch, update, watch"]
        end

        subgraph InferenceResources["inference.networking.k8s.io"]
            IP["inferencepools<br/>get, list, watch"]
        end

        subgraph KEDAResources["keda.sh"]
            SO["scaledobjects<br/>get, list, patch, update, watch"]
        end

        subgraph LWSResources["leaderworkerset.x-k8s.io"]
            LWS["leaderworkersets<br/>get, list, patch, update, watch"]
            LWSScale["leaderworkersets/scale<br/>get, update"]
        end

        subgraph MonitoringResources["monitoring.coreos.com"]
            SM["servicemonitors<br/>get, list, watch"]
        end
    end

    subgraph Roles["Role: leader-election-role"]
        LE["configmaps, leases<br/>get, list, watch, create, update, patch, delete"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| ClusterRoles
    RB -->|"grants"| Roles

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CRB fill:#f5a623,color:#fff
    style RB fill:#f5a623,color:#fff
    style ClusterRoles fill:#e8f4fd,stroke:#4a90e2
    style Roles fill:#e8f4fd,stroke:#4a90e2
    style Pods fill:#7ed321,color:#fff
    style NodesR fill:#7ed321,color:#fff
