    style RSandSS fill:#7ed321,stroke:#333,color:#fff
    style HPAs fill:#7ed321,stroke:#333,color:#fff
    style InfPools fill:#7ed321,stroke:#333,color:#fff
    style ScaledObjs fill:#7ed321,stroke:#333,color:#fff
    style LWSRes fill:#7ed321,stroke:#333,color:#fff
    style LWSScale fill:#7ed321,stroke:#333,color:#fff
