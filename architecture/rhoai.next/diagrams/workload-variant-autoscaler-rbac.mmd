graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["manager-clusterrolebinding"]
        CRB_Leader["leader-election-rolebinding<br/>(namespaced)"]
        CRB_Auth["metrics-auth-clusterrolebinding"]
        CRB_Reader["metrics-reader-rolebinding"]
        CRB_EPP["epp-metrics-reader-<br/>clusterrolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role"]
        CR_Leader["leader-election-role<br/>(Role, namespaced)"]
        CR_Auth["metrics-auth-role"]
        CR_Reader["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core/v1<br/>configmaps, namespaces,<br/>nodes, nodes/status,<br/>pods, resourcequotas,<br/>services"]
        CMStatus["core/v1<br/>configmaps/status"]
        Events["core/v1<br/>events"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps/v1<br/>deployments"]
        DeployScale["apps/v1<br/>deployments/scale"]
        ReplicaSets["apps/v1<br/>replicasets,<br/>statefulsets"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPAs["autoscaling/v2<br/>horizontalpodautoscalers"]
    end

    subgraph ExtResources["Extension API Resources"]
        InferencePools["inference.networking.k8s.io<br/>inference.networking.x-k8s.io<br/>inferencepools"]
        ScaledObjects["keda.sh<br/>scaledobjects"]
        LWSets["leaderworkerset.x-k8s.io<br/>leaderworkersets"]
        LWSScale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph NonResource["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    %% SA → Binding → Role
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Leader
    SA_CM -->|bound via| CRB_Auth
    SA_CM -->|bound via| CRB_Reader
    SA_EPP -->|bound via| CRB_EPP

    CRB_Manager -->|grants| CR_Manager
    CRB_Leader -->|grants| CR_Leader
    CRB_Auth -->|grants| CR_Auth
    CRB_Reader -->|grants| CR_Reader
    CRB_EPP -->|grants| CR_EPP

    %% manager-role permissions
    CR_Manager -->|"get, list, watch"| ConfigMaps
    CR_Manager -->|"get"| CMStatus
    CR_Manager -->|"create, patch"| Events
    CR_Manager -->|"get, list, patch,<br/>update, watch"| Deployments
    CR_Manager -->|"get, update"| DeployScale
    CR_Manager -->|"get, list, watch"| ReplicaSets
    CR_Manager -->|"get, list, patch,<br/>update, watch"| HPAs
    CR_Manager -->|"get, list, watch"| InferencePools
    CR_Manager -->|"get, list, patch,<br/>update, watch"| ScaledObjects
    CR_Manager -->|"get, list, patch,<br/>update, watch"| LWSets
    CR_Manager -->|"get, update"| LWSScale
    CR_Manager -->|"get, list, watch"| ServiceMonitors

    %% metrics-auth-role permissions
    CR_Auth -->|"create"| TokenReviews
    CR_Auth -->|"create"| SAR

    %% metrics-reader permissions
    CR_Reader -->|"get"| MetricsURL
    CR_EPP -->|"get"| MetricsURL

