graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-manager<br/>(wva-system)"]
    end

    subgraph ClusterBindings["Cluster-Wide Bindings"]
        CRB["manager-rolebinding<br/>(ClusterRoleBinding)"]
    end

    subgraph NamespaceBindings["Namespace Bindings (wva-system)"]
        RB["leader-election-rolebinding<br/>(RoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRole: manager-role"]
        direction TB

        subgraph CoreAPI["Core API ('')"]
            Pods["pods, nodes,<br/>nodes/status,<br/>configmaps,<br/>namespaces,<br/>resourcequotas,<br/>services"]
            CMStatus["configmaps/status"]
            Events["events"]
        end

        subgraph AppsAPI["Apps API"]
            Deployments["deployments"]
            DeployScale["deployments/scale"]
            RSandSS["replicasets,<br/>statefulsets"]
        end

        subgraph AutoscalingAPI["Autoscaling API"]
            HPAs["horizontalpodautoscalers"]
        end

        subgraph InferenceAPI["inference.networking.k8s.io"]
            InfPools["inferencepools"]
        end

        subgraph KedaAPI["keda.sh"]
            ScaledObjs["scaledobjects"]
        end

        subgraph LWSAPI["leaderworkerset.x-k8s.io"]
            LWSRes["leaderworkersets"]
            LWSScale["leaderworkersets/scale"]
        end

        subgraph MonitoringAPI["monitoring.coreos.com"]
            SvcMon["servicemonitors"]
        end
    end

    subgraph LeaderRole["Role: leader-election-role<br/>(wva-system)"]
        LeaderRes["configmaps, leases<br/>→ get, list, watch,<br/>create, update, patch,<br/>delete"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
    SA -->|"bound via"| RB
    CRB -->|"grants"| ClusterRoles
    RB -->|"grants"| LeaderRole

    %% Verbs
    Pods --- VerbsRead["get, list, watch"]
    CMStatus --- VerbsGet["get"]
    Events --- VerbsEvent["create, patch"]
    Deployments --- VerbsDeploy["get, list, patch,<br/>update, watch"]
    DeployScale --- VerbsScale["get, update"]
    RSandSS --- VerbsRead2["get, list, watch"]
    HPAs --- VerbsHPA["get, list, patch,<br/>update, watch"]
    InfPools --- VerbsPool["get, list, watch"]
    ScaledObjs --- VerbsSO["get, list, patch,<br/>update, watch"]
    LWSRes --- VerbsLWS["get, list, patch,<br/>update, watch"]
    LWSScale --- VerbsLScale["get, update"]
    SvcMon --- VerbsMon["get, list, watch"]

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333,color:#fff
    style RB fill:#f5a623,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style CMStatus fill:#7ed321,stroke:#333,color:#fff
    style Events fill:#7ed321,stroke:#333,color:#fff
    style Deployments fill:#7ed321,stroke:#333,color:#fff
