graph LR
    VllmCPU["vllm-cpu<br/>Inference Server"]

    %% Runtime Dependencies
    VllmCPU -->|"tensor computation"| Torch["torch 2.11.0+cpu"]
    VllmCPU -->|"model loading"| Transformers["transformers >=5.6.0"]
    VllmCPU -->|"HTTP framework"| FastAPI["fastapi >=0.133.0"]
    VllmCPU -->|"ASGI server"| Uvicorn["uvicorn"]
    VllmCPU -->|"ASGI toolkit"| Starlette["starlette >=1.0.1<br/>(CVE-2026-48710 fix)"]
    VllmCPU -->|"gRPC transport"| GRPC["grpcio >=1.76.0"]
    VllmCPU -->|"serialization"| Protobuf["protobuf >=5.29.6"]

    %% API Compatibility
    VllmCPU -->|"Responses API"| OpenAILib["openai >=2.0.0"]
    VllmCPU -->|"Messages API"| AnthropicLib["anthropic >=0.71.0"]
    VllmCPU -->|"structured output"| XGrammar["xgrammar >=0.2.1"]
    VllmCPU -->|"quantized models"| CompTensors["compressed-tensors ==0.17.1"]
    VllmCPU -->|"tool support"| MCP["mcp"]

    %% Observability
    VllmCPU -->|"metrics"| PromClient["prometheus_client >=0.18.0"]

    %% Red Hat Standards
    VllmCPU -->|"hosting standards"| MHCS["model-hosting-container-standards<br/>>=0.1.14"]

    %% Internal Platform Dependencies
    KServe["KServe / ModelMesh"] -->|"deployment context"| VllmCPU
    VllmCPU -->|"model weights"| ModelStorage["Model Storage<br/>(PVC / S3)"]

    %% External Services
    VllmCPU -->|"model download"| HFHub["Hugging Face Hub"]
    VllmCPU -->|"model loading"| S3["S3-compatible Storage"]

    %% Observability Integration
    Prometheus["Prometheus"] -->|"scrape metrics"| VllmCPU
    VllmCPU -->|"trace export"| OTel["OpenTelemetry Collector"]

