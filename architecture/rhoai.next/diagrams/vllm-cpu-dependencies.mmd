graph LR
    vllmCpu["vllm-cpu<br/>CPU LLM Inference Server"]

    %% Core Framework Dependencies
    vllmCpu -->|"tensor computation<br/>2.11.0+cpu"| PyTorch["PyTorch"]
    vllmCpu -->|"model loading<br/>>= 5.6.0"| Transformers["Transformers"]
    vllmCpu -->|"HTTP API<br/>>= 0.133.0"| FastAPI["FastAPI"]
    vllmCpu -->|"ASGI server"| Uvicorn["Uvicorn"]
    vllmCpu -->|"gRPC server<br/>>= 1.76.0"| gRPC["gRPC"]

    %% Model Format Dependencies
    vllmCpu -->|"safe weight loading<br/>>= 0.6.2"| Safetensors["Safetensors"]
    vllmCpu -->|"quantization<br/>0.17.1"| CompressedTensors["compressed-tensors"]

    %% Structured Output Dependencies
    vllmCpu -->|"structured output<br/>0.2.14"| OutlinesCore["outlines_core"]
    vllmCpu -.->|"grammar generation<br/>optional"| XGrammar["xgrammar"]
    vllmCpu -.->|"grammar guidance<br/>optional"| LLGuidance["llguidance"]

    %% Tokenizer Dependencies
    vllmCpu -->|"LLaMA tokenizer"| SentencePiece["sentencepiece"]
    vllmCpu -->|"DBRX tokenizer<br/>>= 0.12.0"| TikToken["tiktoken"]

    %% CPU Optimization Dependencies
    vllmCpu -.->|"Intel CPU optimizations<br/>2.7.0, x86_64 only"| IPEX["Intel Extension<br/>for PyTorch"]
    vllmCpu -.->|"speculative decoding<br/>0.65.0, not s390x"| Numba["numba"]

    %% SDK Dependencies
    vllmCpu -->|"Anthropic support<br/>>= 0.71.0"| AnthropicSDK["Anthropic SDK"]
    vllmCpu -->|"Responses API<br/>>= 2.0.0"| OpenAISDK["OpenAI SDK"]

    %% Observability Dependencies
    vllmCpu -->|"metrics<br/>>= 0.18.0"| PromClient["Prometheus Client"]
    vllmCpu -.->|"tracing<br/>>= 1.27.0, optional"| OpenTelemetry["OpenTelemetry SDK"]

    %% Infrastructure Dependencies
    vllmCpu -->|"IPC<br/>>= 25.0.0"| PyZMQ["pyzmq (ZeroMQ)"]
    vllmCpu -->|"event loop"| UVLoop["uvloop"]
    vllmCpu -->|"validation<br/>>= 2.12.0"| Pydantic["Pydantic"]

    %% Red Hat / Platform Dependencies
    vllmCpu -->|"container standards<br/>>= 0.1.14"| MHCS["model-hosting-<br/>container-standards"]
    vllmCpu -->|"GPT-OSS compat<br/>>= 0.0.3"| OpenAIHarmony["openai-harmony"]
    vllmCpu -.->|"tool calling<br/>optional"| MCP["mcp (MCP SDK)"]
    vllmCpu -.->|"gRPC servicer<br/>optional"| SmgGRPC["smg-grpc-servicer"]

    %% Internal RHOAI Platform Dependencies
    vllmCpu ===|"deployed as container"| KServe["KServe ServingRuntime"]
    vllmCpu -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    vllmCpu -->|"usage stats<br/>HTTPS/443"| RHTelemetry["Red Hat Telemetry"]

    %% Integration Points (inbound)
    Prometheus["Prometheus"] -->|"metrics scrape<br/>/metrics"| vllmCpu
    OTel["OpenTelemetry Collector"] -.->|"trace export"| vllmCpu

    %% Styling
    style vllmCpu fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core frameworks
    style PyTorch fill:#ee4c2c,stroke:#333,color:#fff
    style Transformers fill:#ee4c2c,stroke:#333,color:#fff
    style FastAPI fill:#009688,stroke:#333,color:#fff
    style Uvicorn fill:#009688,stroke:#333,color:#fff
    style gRPC fill:#009688,stroke:#333,color:#fff

    %% Model format
    style Safetensors fill:#f5a623,stroke:#333,color:#fff
    style CompressedTensors fill:#f5a623,stroke:#333,color:#fff

    %% Optional / platform-specific
    style IPEX fill:#ccc,stroke:#333
    style Numba fill:#ccc,stroke:#333
    style XGrammar fill:#ccc,stroke:#333
    style LLGuidance fill:#ccc,stroke:#333
    style MCP fill:#ccc,stroke:#333
    style SmgGRPC fill:#ccc,stroke:#333
    style OpenTelemetry fill:#ccc,stroke:#333

    %% Internal RHOAI
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style RHTelemetry fill:#7ed321,stroke:#333,color:#fff

    %% External services
    style HFHub fill:#ffd700,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333

    %% SDKs
    style AnthropicSDK fill:#d4a574,stroke:#333,color:#fff
    style OpenAISDK fill:#74aa9c,stroke:#333,color:#fff

    %% Red Hat
    style MHCS fill:#cc0000,stroke:#333,color:#fff
    style OpenAIHarmony fill:#cc0000,stroke:#333,color:#fff
