graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Platform Admin"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-operator)"]
        direction TB
        subgraph OperatorPod["Controller Manager Pod"]
            Controller["redhat-ods-operator-controller-manager<br/>SA: redhat-ods-operator-controller-manager"]
            WebhookSrv["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (service-ca cert)"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
            Metrics["Metrics<br/>8080/TCP HTTP"]
        end
        RBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>metrics-reader ClusterRole"]
    end

    subgraph PlatformDeps["MANAGED SERVICES (Internal)"]
        CertMgr["cert-manager<br/>CRD CRUD"]
        ServiceMesh["OpenShift Service Mesh<br/>istio-system/data-science-smcp<br/>CRD CRUD"]
        Knative["Knative Serving<br/>CRD CRUD"]
        Authorino["Authorino<br/>CRD CRUD"]
        Prometheus["prometheus-operator<br/>CRD CRUD"]
        Tekton["OpenShift Pipelines<br/>CRD CRUD"]
        ModelRegOp["Model Registry Operator<br/>CRD CRUD"]
    end

    subgraph IngressZone["INGRESS (KServe Traffic)"]
        ExtGW["knative-ingress-gateway<br/>443/TCP HTTPS<br/>TLS SIMPLE<br/>External"]
        LocalGW["kserve-local-gateway<br/>443/TCP → 8445/TCP HTTPS<br/>Internal"]
        KnativeGW["knative-local-gateway<br/>80/TCP → 8081/TCP HTTP<br/>Internal"]
    end

    %% External flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% API server to webhook
    K8sAPI -->|"HTTPS/443 → 9443<br/>TLS (service-ca)<br/>Admission"| WebhookSrv

    %% Controller to API server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Metrics access
    RBACProxy -->|"HTTP/8080<br/>Internal"| Metrics

    %% Controller manages platform dependencies (all via K8s API)
    Controller -.->|"CRD CRUD via K8s API"| CertMgr
    Controller -.->|"CRD CRUD via K8s API"| ServiceMesh
    Controller -.->|"CRD CRUD via K8s API"| Knative
    Controller -.->|"CRD CRUD via K8s API"| Authorino
    Controller -.->|"CRD CRUD via K8s API"| Prometheus
    Controller -.->|"CRD CRUD via K8s API"| Tekton
    Controller -.->|"CRD CRUD via K8s API"| ModelRegOp

    %% Operator creates gateways
    Controller -.->|"Creates"| ExtGW
    Controller -.->|"Creates"| LocalGW
    Controller -.->|"Creates"| KnativeGW

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Admin external
    class K8sAPI controlplane
    class Controller,WebhookSrv,HealthProbe,Metrics,RBACProxy operator
    class CertMgr,ServiceMesh,Knative,Authorino,Prometheus,Tekton,ModelRegOp platform
    class ExtGW,LocalGW,KnativeGW ingress
