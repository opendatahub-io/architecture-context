graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / DSP API Client"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount / Bearer Token"]
    end

    subgraph ControllerPlane["CONTROLLER PLANE (Internal)"]
        direction TB

        subgraph NS_Controller["Namespace: argo"]
            Controller["workflow-controller<br/>SA: argo<br/>Metrics: 9090/TCP HTTP<br/>Health: 6060/TCP HTTP<br/>Leader Election: Lease"]
        end

        subgraph NS_Server["Namespace: argo (optional)"]
            ArgoServer["argo-server<br/>SA: argo-server<br/>2746/TCP HTTP/HTTPS<br/>TLS: Self-signed ECDSA P-256<br/>Auth: SSO/Token/Webhook<br/>gRPC interceptor chain"]
        end
    end

    subgraph DataPlane["WORKFLOW PODS (Data Plane)"]
        subgraph NS_Workflow["Namespace: {workflow-namespace}"]
            WorkflowPod["Workflow Step Pod<br/>+ argoexec sidecar<br/>SA: {workflow-sa}"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ArtifactStore["Artifact Store<br/>S3/MinIO/GCS/Azure<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Storage Credentials"]
        SQLDatabase["SQL Database<br/>MySQL: 3306/TCP<br/>PostgreSQL: 5432/TCP<br/>Encryption: Configurable<br/>Auth: Username/Password"]
        OIDCProvider["OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth2 Client Credentials"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Watch: Workflow CRs<br/>ServiceAccount"| Controller
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>Create Pods, Update Status<br/>ServiceAccount"| K8sAPI
    Controller -->|"TCP/3306 or 5432<br/>Configurable encryption<br/>Username/Password"| SQLDatabase
    WorkflowPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>WorkflowTaskResult CR<br/>ServiceAccount"| K8sAPI
    WorkflowPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Artifact Upload/Download<br/>Storage Credentials"| ArtifactStore
    User -->|"HTTP or HTTPS/2746<br/>Configurable TLS<br/>SSO/Bearer Token"| ArgoServer
    ArgoServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    ArgoServer -->|"TCP/3306 or 5432<br/>Configurable<br/>Username/Password"| SQLDatabase
    ArgoServer -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2"| OIDCProvider

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef dataplane fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Controller,ArgoServer controller
    class WorkflowPod dataplane
    class ArtifactStore,SQLDatabase,OIDCProvider externalservice
