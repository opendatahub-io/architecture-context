graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / DSP API Client"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes)"]
        direction TB

        subgraph NS_Argo["Namespace: argo (or managed namespace)"]
            direction TB
            Controller["workflow-controller<br/>SA: argo<br/>Ports: 9090/TCP (metrics), 6060/TCP (health)<br/>Image: odh-data-science-pipelines-argo-workflowcontroller"]
            ControllerCM["workflow-controller-configmap<br/>(ConfigMap)"]
            Controller -.->|reads config| ControllerCM
        end

        subgraph NS_Workflow["Namespace: {user-namespace}"]
            direction TB
            WorkflowPod["Workflow Execution Pod<br/>SA: {workflow-sa}<br/>Container: argoexec (emissary)<br/>Image: odh-data-science-pipelines-argo-argoexec"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP<br/>TLS 1.2+<br/>ServiceAccount Token"]

        Prometheus["Prometheus<br/>(Metrics Scraper)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>(MinIO / AWS S3)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / SecretKeySelector"]

        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA JSON Key"]

        AzureBlob["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Azure AD / SecretKeySelector"]

        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>SSL configurable<br/>Username/Password"]

        MySQL["MySQL<br/>3306/TCP<br/>Configurable encryption<br/>Username/Password"]
    end

    %% User flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Controller flows
    K8sAPI -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Informer watches"| Controller
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Pod CRUD, CRD updates"| K8sAPI
    Controller -->|"TCP/5432<br/>SSL configurable<br/>Username/Password"| PostgreSQL
    Controller -->|"TCP/3306<br/>Configurable<br/>Username/Password"| MySQL

    %% Pod creation
    Controller -->|"creates via K8s API"| WorkflowPod

    %% Executor flows
    WorkflowPod -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>Status updates"| K8sAPI
    WorkflowPod -->|"HTTPS/443<br/>TLS 1.2+<br/>SecretKeySelector"| S3
    WorkflowPod -->|"HTTPS/443<br/>TLS 1.2+<br/>SA JSON Key"| GCS
    WorkflowPod -->|"HTTPS/443<br/>TLS 1.2+<br/>Azure AD"| AzureBlob

    %% Monitoring
    Prometheus -->|"HTTP/9090<br/>TLS optional<br/>No auth"| Controller

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef executor fill:#4a90e2,stroke:#333,stroke-width:1px,color:#fff
    classDef k8s fill:#326ce5,stroke:#333,stroke-width:2px,color:#fff
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef database fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:1px

    class User external
    class Controller controller
    class WorkflowPod executor
    class K8sAPI k8s
    class S3,GCS,AzureBlob storage
    class PostgreSQL,MySQL database
    class Prometheus monitoring
