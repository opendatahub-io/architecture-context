graph TB
    subgraph Platform["Platform Layer"]
        PlatformOp["rhods-operator /<br/>opendatahub-operator"]
        OGXCR["OGX CR<br/>(Cluster-scoped singleton)"]
        PlatformOp -->|creates| OGXCR
    end

    subgraph ModuleLayer["OGX Module Controller"]
        ModuleCtrl["ogx-module<br/>8080/TCP metrics<br/>8081/TCP health"]
        ModuleCtrl -->|watches| OGXCR
        ModuleCtrl -->|deploys via kustomize| OperatorDeploy["Root Operator<br/>Deployment"]
        ModuleCtrl -->|aggregates health| HealthStatus["Component Health<br/>Status"]
    end

    subgraph OperatorLayer["OGX Operator (Root)"]
        Controller["OGX Operator Controller<br/>controller-runtime"]
        Webhook["Validating Webhook<br/>9443/TCP HTTPS"]
        ConfigGen["Config Generator<br/>pkg/config"]
        KustomizeRenderer["Kustomize Renderer<br/>pkg/deploy"]

        Controller -->|validates via| Webhook
        Controller -->|generates config| ConfigGen
        Controller -->|renders manifests| KustomizeRenderer
    end

    subgraph ManagedResources["Managed Per-Instance Resources"]
        Deploy["Deployment"]
        Svc["Service<br/>8000/TCP"]
        PVC["PersistentVolumeClaim"]
        NetPol["NetworkPolicy"]
        PDB["PodDisruptionBudget"]
        HPA["HorizontalPodAutoscaler"]
        SA["ServiceAccount"]
        RB["RoleBinding (anyuid SCC)"]
        CM["ConfigMap<br/>(content-addressable)"]
        SM["ServiceMonitor"]
        PR["PrometheusRule"]
    end

    User["User / Data Scientist"] -->|creates| OGXServerCR["OGXServer CR<br/>ogx.io/v1beta1"]
    OGXServerCR -->|watched by| Controller
    Controller -->|reconciles| ManagedResources

    Controller -->|polls /v1/providers<br/>/v1/version| OGXServerPod["OGX Server Pod<br/>8000/TCP"]
    Deploy -.->|runs| OGXServerPod

    LegacyCR["LlamaStackDistribution CR<br/>(legacy v1alpha1)"] -.->|adoption flow| Controller

    Controller -->|fetches image labels| OCIRegistry["OCI Registry<br/>443/TCP HTTPS"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style ConfigGen fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeRenderer fill:#4a90e2,stroke:#333,color:#fff
    style ModuleCtrl fill:#50a0d2,stroke:#333,color:#fff
    style OGXServerCR fill:#f5a623,stroke:#333,color:#fff
    style OGXCR fill:#f5a623,stroke:#333,color:#fff
    style LegacyCR fill:#d4a017,stroke:#333,color:#fff
    style OGXServerPod fill:#7ed321,stroke:#333,color:#fff
    style PlatformOp fill:#e8e8e8,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style User fill:#fff,stroke:#333
