graph TB
    subgraph PlatformTier["Platform Tier (ODH/RHOAI)"]
        PlatformOp["rhods-operator /<br/>opendatahub-operator"]
        OGXCR["OGX CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
        PlatformOp -->|creates| OGXCR
    end

    subgraph ModuleTier["OGX Module Controller"]
        OGXModule["ogx-module<br/>(controller-runtime)<br/>8081/TCP health, 8080/TCP metrics"]
        KustomizeRenderer["Kustomize Manifest<br/>Renderer"]
        OGXModule -->|renders manifests via| KustomizeRenderer
    end

    OGXCR -->|watched by| OGXModule
    OGXModule -->|deploys root operator| OperatorTier

    subgraph OperatorTier["OGX K8s Operator"]
        Controller["OGX Controller<br/>(controller-runtime)<br/>8081/TCP health, 8080/TCP metrics"]
        Webhook["Validating Webhook<br/>9443/TCP HTTPS"]
        ConfigGen["Config Generator<br/>(OCI label fetch + provider merge)"]
        SecretResolver["Secret Resolver<br/>(provider-aware env injection)"]
        LegacyAdoption["Legacy Adoption<br/>(LlamaStackDistribution migration)"]
        Controller -->|validates via| Webhook
        Controller -->|generates config via| ConfigGen
        Controller -->|resolves secrets via| SecretResolver
        Controller -->|migrates via| LegacyAdoption
    end

    User["User / Data Scientist"] -->|creates| OGXServerCR
    OGXServerCR["OGXServer CR<br/>(ogx.io/v1beta1)<br/>Namespaced"]
    OGXServerCR -->|watched by| Controller

    subgraph ManagedResources["Per-OGXServer Managed Resources"]
        Deploy["Deployment"]
        Svc["Service<br/>8321/TCP"]
        PVC["PersistentVolumeClaim"]
        NP["NetworkPolicy"]
        HPA["HorizontalPodAutoscaler"]
        PDB["PodDisruptionBudget"]
        SA["ServiceAccount"]
        RB["RoleBinding"]
        SM["ServiceMonitor"]
        PR["PrometheusRule"]
        CM["ConfigMap<br/>(immutable, content-hashed)"]
    end

    Controller -->|creates/manages| Deploy
    Controller -->|creates/manages| Svc
    Controller -->|creates/manages| PVC
    Controller -->|creates/manages| NP
    Controller -->|creates/manages| HPA
    Controller -->|creates/manages| PDB
    Controller -->|creates/manages| SA
    Controller -->|creates/manages| RB
    Controller -->|creates/manages| SM
    Controller -->|creates/manages| PR
    Controller -->|creates/manages| CM

    ConfigGen -->|fetches base config| OCIRegistry["OCI Container Registry<br/>443/TCP HTTPS"]
    Controller -->|health checks| OGXServer["OGX Server Pod<br/>8321/TCP HTTP"]
    Deploy -->|runs| OGXServer

    style PlatformOp fill:#e8e8e8,stroke:#333
    style OGXModule fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style ConfigGen fill:#4a90e2,stroke:#333,color:#fff
    style SecretResolver fill:#4a90e2,stroke:#333,color:#fff
    style LegacyAdoption fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeRenderer fill:#4a90e2,stroke:#333,color:#fff
    style OGXServerCR fill:#f5a623,stroke:#333
    style OGXCR fill:#f5a623,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style OGXServer fill:#7ed321,stroke:#333
