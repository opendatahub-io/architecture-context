graph TB
    subgraph OGXOperator["ogx-k8s-operator"]
        direction TB
        Controller["OGXServer Controller<br/>Go Operator (controller-runtime)<br/>Reconciles OGXServer CRs"]
        Webhook["OGXServerValidator<br/>Admission Webhook<br/>9443/TCP HTTPS"]
        KustomizePipeline["Kustomize Pipeline<br/>Runtime manifest rendering<br/>with Go transformer plugins"]
        SecurityWatcher["SecurityProfileWatcher<br/>Watches cluster TLS profile<br/>Triggers graceful restart"]

        Controller -->|validates on create/update| Webhook
        Controller -->|renders manifests via| KustomizePipeline
        Controller -->|configures TLS from| SecurityWatcher
    end

    subgraph OGXModule["ogx-module"]
        ModuleController["OGX Module Controller<br/>Platform component controller<br/>Deploys root operator"]
    end

    subgraph ManagedResources["Managed Workload Resources"]
        direction LR
        Deploy["Deployment"]
        Svc["Service"]
        PVC["PersistentVolumeClaim"]
        NetPol["NetworkPolicy"]
        PDB["PodDisruptionBudget"]
        HPA["HorizontalPodAutoscaler"]
        SM["ServiceMonitor"]
        PR["PrometheusRule"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        OGXServerCR["OGXServer<br/>ogx.io/v1beta1<br/>Namespaced"]
        OGXCR["OGX<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster-scoped"]
        LegacyCR["LlamaStackDistribution<br/>llamastack.io/v1alpha1<br/>Legacy / Migration"]
    end

    User["Data Scientist / User"] -->|creates| OGXServerCR
    PlatformOperator["ODH/RHOAI Platform Operator"] -->|creates| OGXCR

    OGXServerCR -->|watched by| Controller
    OGXCR -->|watched by| ModuleController
    LegacyCR -.->|migration adoption| Controller

    Controller -->|creates/manages| Deploy
    Controller -->|creates/manages| Svc
    Controller -->|creates/manages| PVC
    Controller -->|creates/manages| NetPol
    Controller -->|creates/manages| PDB
    Controller -->|creates/manages| HPA
    Controller -->|creates/manages| SM
    Controller -->|creates/manages| PR

    ModuleController -->|deploys| OGXOperator

    subgraph Sidecar["Metrics Sidecar"]
        KubeRBACProxy["kube-rbac-proxy<br/>TLS termination<br/>RBAC auth for /metrics"]
    end

    Controller -->|metrics via| KubeRBACProxy

    Controller -->|API calls| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    SecurityWatcher -->|watches| OpenShiftTLS["OpenShift TLS Profile<br/>config.openshift.io/apiserver"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style KustomizePipeline fill:#4a90e2,stroke:#333,color:#fff
    style SecurityWatcher fill:#4a90e2,stroke:#333,color:#fff
    style ModuleController fill:#50c878,stroke:#333,color:#fff
    style KubeRBACProxy fill:#f5a623,stroke:#333,color:#fff
    style OGXServerCR fill:#f5a623,stroke:#333,color:#fff
    style OGXCR fill:#f5a623,stroke:#333,color:#fff
    style LegacyCR fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftTLS fill:#e8e8e8,stroke:#333
