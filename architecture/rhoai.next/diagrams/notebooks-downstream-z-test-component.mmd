graph TB
    subgraph BuildRepo["notebooks-downstream-z-test<br/>(Container Image Build Repository)"]
        direction TB

        subgraph JupyterImages["Jupyter Workbench Images"]
            direction LR
            JMinCPU["jupyter-minimal<br/>(CPU)"]
            JMinCUDA["jupyter-minimal<br/>(CUDA)"]
            JMinROCm["jupyter-minimal<br/>(ROCm)"]
            JDS["jupyter-datascience<br/>(CPU)"]
            JPT["jupyter-pytorch<br/>(CUDA)"]
            JPTLLM["jupyter-pytorch+<br/>llmcompressor (CUDA)"]
            JTF["jupyter-tensorflow<br/>(CUDA)"]
            JTAI["jupyter-trustyai<br/>(CPU)"]
            JROCmPT["jupyter-rocm-pytorch"]
            JROCmTF["jupyter-rocm-tensorflow"]
        end

        subgraph CodeServerImages["Code Server Images"]
            CSDS["codeserver-datascience<br/>(CPU)<br/>Port: 8080/TCP"]
        end

        subgraph RuntimeImages["Pipeline Runtime Images"]
            direction LR
            RTMin["runtime-minimal<br/>(CPU)"]
            RTDS["runtime-datascience<br/>(CPU)"]
            RTPT["runtime-pytorch<br/>(CUDA)"]
            RTPTLLM["runtime-pytorch+<br/>llmcompressor (CUDA)"]
            RTTF["runtime-tensorflow<br/>(CUDA)"]
            RTROCmPT["runtime-rocm-pytorch"]
            RTROCmTF["runtime-rocm-tensorflow"]
        end

        subgraph BuildTools["Build Tooling"]
            BI["buildinputs<br/>(Go CLI)"]
            CP["check-payload<br/>(FIPS validation)"]
        end

        subgraph Manifests["Kustomize Manifests"]
            ManBase["manifests/base<br/>(py3.11 legacy)"]
            ManOverlay["manifests/overlays/additional<br/>(py3.12)"]
        end
    end

    %% Image layering
    JMinCPU -->|"builds on"| JDS
    JDS -->|"builds on"| JPT
    JDS -->|"builds on"| JTAI
    JPT -->|"builds on"| JPTLLM

    %% Consumers
    NotebookController["ODH Notebook Controller"] -->|"pulls & deploys"| JupyterImages
    NotebookController -->|"pulls & deploys"| CodeServerImages
    KFP["Kubeflow Pipelines"] -->|"executes"| RuntimeImages
    Dashboard["ODH Dashboard"] -->|"reads ImageStreams"| Manifests

    %% Base images
    UBI9["UBI 9 Python 3.12<br/>(Base Image)"] -->|"CPU base"| JMinCPU
    CUDA["ODH CUDA Base<br/>(v12.6)"] -->|"CUDA base"| JMinCUDA
    ROCm["ODH ROCm Base<br/>(v6.2)"] -->|"ROCm base"| JMinROCm

    style BuildRepo fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style JupyterImages fill:#d5e8d4,stroke:#82b366
    style CodeServerImages fill:#d5e8d4,stroke:#82b366
    style RuntimeImages fill:#dae8fc,stroke:#6c8ebf
    style BuildTools fill:#fff2cc,stroke:#d6b656
    style Manifests fill:#f8cecc,stroke:#b85450
    style NotebookController fill:#4a90e2,color:#fff
    style KFP fill:#4a90e2,color:#fff
    style Dashboard fill:#4a90e2,color:#fff
    style UBI9 fill:#e8e8e8,stroke:#999
    style CUDA fill:#e8e8e8,stroke:#999
    style ROCm fill:#e8e8e8,stroke:#999
