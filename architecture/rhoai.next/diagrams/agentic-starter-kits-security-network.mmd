graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Router)"]
        Route["OpenShift Route<br/>443/TCP → 8080/TCP | 18789/TCP<br/>TLS edge termination<br/>Insecure: Redirect"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Pod Network)"]
        direction TB

        subgraph StandardAgent["Standard Agent Pod"]
            AgentApp["FastAPI Agent<br/>Port: 8080/TCP<br/>UBI9 Python 3.12<br/>UID: 1001 (non-root)<br/>Caps: drop ALL"]
            AuthMW["SATokenAuthMiddleware<br/>(opt-in: AUTH_ENABLED)"]
        end

        subgraph OpenClawPod["OpenClaw Pod"]
            OClaw["OpenClaw Gateway<br/>Port: 18789/TCP<br/>Image: digest-pinned<br/>non-root, drop ALL caps"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>In-cluster SA token"]
    end

    subgraph InferenceLayer["INFERENCE LAYER"]
        LLM["OGX / vLLM / Ollama<br/>Configurable port<br/>HTTP/HTTPS<br/>API_KEY (Bearer)"]
    end

    subgraph OptionalServices["OPTIONAL SERVICES"]
        MLflow["MLflow Tracking<br/>Configurable port<br/>HTTP/HTTPS<br/>Bearer/SA token"]
        Milvus["Milvus Vector DB<br/>Configurable port<br/>HTTP"]
        Postgres["PostgreSQL<br/>5432/TCP<br/>TCP (no encryption)<br/>Password auth"]
        Slack["Slack API<br/>443/TCP HTTPS<br/>TLS<br/>Token auth"]
        NeMo["NeMo Guardrails<br/>Configurable port<br/>HTTP/HTTPS"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS (edge)<br/>No auth at Route"| Route

    %% Ingress → Agents
    Route -->|"HTTP/8080<br/>No encryption<br/>(cluster internal)"| AgentApp
    Route -->|"HTTP/18789<br/>No encryption<br/>OPENCLAW_GATEWAY_TOKEN"| OClaw

    %% Auth flow
    AuthMW -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI

    %% Agent → LLM
    AgentApp -->|"HTTP/HTTPS<br/>API_KEY (Bearer)"| LLM
    OClaw -->|"HTTP/HTTPS<br/>VLLM_API_KEY"| LLM

    %% Agent → Optional Services
    AgentApp -.->|"HTTP/HTTPS<br/>Bearer/SA token<br/>TLS configurable"| MLflow
    AgentApp -.->|"HTTP<br/>Configurable auth"| Milvus
    AgentApp -.->|"TCP/5432<br/>No encryption<br/>Password"| Postgres
    AgentApp -.->|"HTTPS/443<br/>TLS<br/>Token"| Slack
    AgentApp -.->|"HTTP/HTTPS<br/>Configurable"| NeMo

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Route ingress
    class AgentApp,AuthMW,OClaw cluster
    class K8sAPI platform
    class LLM inference
    class MLflow,Milvus,Postgres,Slack,NeMo optional
