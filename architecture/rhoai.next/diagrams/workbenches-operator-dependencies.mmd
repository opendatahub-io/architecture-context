graph LR
    WO["Workbenches Operator"]

    %% External Dependencies (Go libraries)
    WO -->|"controller framework<br/>reconcile, webhooks,<br/>leader election"| CR["controller-runtime<br/>v0.23.3"]
    WO -->|"OpenShift API types<br/>APIServer TLS profile"| OSAPI["openshift/api<br/>v0.0.0-20260317"]
    WO -->|"TLS profile fetching<br/>SecurityProfileWatcher"| OSCR["openshift/controller-<br/>runtime-common<br/>v0.0.0-20260428"]
    WO -->|"in-process manifest<br/>rendering"| Kustomize["kustomize/api<br/>v0.21.1"]

    %% Internal Platform Dependencies
    WO -->|"creates Workbenches CR<br/>with platform config"| Orchestrator["rhods-operator /<br/>opendatahub-operator"]
    WO -->|"reads distribution<br/>name, version,<br/>platformVersion"| ConfigMap["odh-workbenches-config<br/>ConfigMap"]
    WO -->|"deploys via SSA"| KFNotebook["kf-notebook-controller<br/>(upstream Kubeflow)"]
    WO -->|"deploys via SSA"| ODHNotebook["odh-notebook-controller<br/>(upstream ODH)"]
    WO -->|"webhook reads specs<br/>for resource injection"| HP["HardwareProfile CR<br/>(infrastructure.opendatahub.io/v1)"]
    WO -->|"webhook intercepts<br/>CREATE/UPDATE"| Notebook["Notebook CR<br/>(kubeflow.org/v1)"]
    WO -->|"deploys platform-specific<br/>image references"| ImageStreams["Notebook ImageStreams<br/>(image.openshift.io/v1)"]

    %% Components that depend on workbenches-operator
    Orchestrator -->|"CRD lifecycle"| WO

    %% Downstream of deployed controllers
    ODHNotebook -->|"creates per-Notebook"| HTTPRoutes["Gateway API<br/>HTTPRoutes"]
    ODHNotebook -->|"creates per-Notebook"| NetworkPolicies["NetworkPolicies"]
    ODHNotebook -->|"injects sidecars"| KubeRBACProxy["kube-rbac-proxy"]
    ODHNotebook -.->|"reads status"| DSPA["DSPA<br/>(Data Science<br/>Pipelines)"]
    ODHNotebook -.->|"manages"| OAuthClient["OAuthClient<br/>(legacy OAuth proxy)"]

    %% External services
    WO -->|"CRUD operations"| K8sAPI["Kubernetes API<br/>Server"]
    WO -->|"reads TLS profile"| APIServer["OpenShift APIServer<br/>(config.openshift.io/v1)"]
    WO -->|"verify user permissions"| SAR["SubjectAccessReview<br/>API"]

