    style OSApi fill:#999,stroke:#333,color:#fff
    style OSCommon fill:#999,stroke:#333,color:#fff

    %% Internal ODH
    style KubeflowNotebooks fill:#7ed321,stroke:#333,color:#fff
    style HardwareProfile fill:#7ed321,stroke:#333,color:#fff
    style PlatformConfig fill:#7ed321,stroke:#333,color:#fff

    %% Platform services
    style CertManager fill:#f5a623,stroke:#333,color:#fff
    style PrometheusOp fill:#f5a623,stroke:#333,color:#fff
    style ImageStreams fill:#f5a623,stroke:#333,color:#fff
    style APIServer fill:#f5a623,stroke:#333,color:#fff
    style Kueue fill:#f5a623,stroke:#333,color:#fff

