graph LR
    WBO["Workbenches Operator"]

    %% External Dependencies (build/runtime)
    WBO -->|"operator framework"| ControllerRuntime["controller-runtime v0.23.3"]
    WBO -->|"K8s client"| ClientGo["client-go v0.35.3"]
    WBO -->|"manifest rendering"| Kustomize["kustomize/api v0.21.1"]
    WBO -->|"OpenShift types"| OSApi["openshift/api"]
    WBO -->|"TLS profile"| OSCommon["openshift/controller-runtime-common"]

    %% Internal Platform Dependencies
    WBO -->|"CRD CRUD + webhooks"| KubeflowNotebooks["Kubeflow Notebooks<br/>kubeflow.org"]
    WBO -->|"CRD read"| HardwareProfile["HardwareProfile<br/>infrastructure.opendatahub.io"]
    WBO -->|"ConfigMap watch"| PlatformConfig["Platform ConfigMap<br/>odh-workbenches-config"]

    %% Platform Services
    WBO -->|"TLS certs"| CertManager["cert-manager"]
    WBO -->|"ServiceMonitor"| PrometheusOp["prometheus-operator"]
    WBO -->|"ImageStream mgmt"| ImageStreams["OpenShift Image Streams"]
    WBO -->|"TLS profile config"| APIServer["OpenShift APIServer Config"]

    %% Indirect Integration
    WBO -.->|"queue label injection"| Kueue["Kueue"]

    %% Core Infrastructure
    WBO -->|"API server"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Reverse integrations (things that depend on this operator)
    PlatformOperator["Platform Operator<br/>opendatahub-operator"] -->|"creates Workbenches CR"| WBO

