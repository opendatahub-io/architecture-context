graph LR
    MLServer["MLServer<br/>Inference Server"]

    %% Internal RHOAI Platform Dependencies
    MLServer -->|"runs inside pods"| KServe["KServe<br/>(InferenceService controller)"]
    MLServer -->|"model artifacts at /mnt/models"| StorageInit["KServe Storage<br/>Initializer"]
    MLServer -->|"auth sidecar 8443→8080/8081"| KubeRBACProxy["kube-rbac-proxy<br/>(RHOAI 3.x sidecar)"]

    %% Core Framework Dependencies
    MLServer -->|"REST API"| FastAPI["FastAPI<br/>>=0.134.0,<0.137.0"]
    MLServer -->|"HTTP server"| Uvicorn["Uvicorn"]
    MLServer -->|"gRPC server"| GRPCio["gRPCio<br/>>=1.67.1"]
    MLServer -->|"serialization"| Protobuf["Protobuf<br/>>=5.27.2,<7.0.0"]
    MLServer -->|"settings/models"| Pydantic["Pydantic<br/>^2.7.1"]

    %% ML Runtime Dependencies (CPU Image)
    MLServer -->|"sklearn models"| ScikitLearn["scikit-learn<br/>1.9.0"]
    MLServer -->|"XGBoost models"| XGBoost["XGBoost<br/>3.3.0"]
    MLServer -->|"LightGBM models"| LightGBM["LightGBM<br/>4.6.0"]
    MLServer -->|"ONNX models (CPU)"| ONNXRuntime["ONNX Runtime<br/>1.25.0"]
    MLServer -->|"ONNX models (CUDA)"| ONNXRuntimeGPU["ONNX Runtime GPU<br/>1.25.0"]

    %% Observability Dependencies
    MLServer -->|"traces"| OTelSDK["OpenTelemetry SDK<br/>^1.22.0"]
    MLServer -->|"REST tracing"| OTelFastAPI["otel-fastapi<br/>>=0.43b0"]
    MLServer -->|"gRPC tracing"| OTelGRPC["otel-grpc<br/>>=0.43b0"]
    MLServer -->|"REST metrics"| StarletteExporter["starlette-exporter"]
    MLServer -->|"gRPC metrics"| GRPCPrometheus["py-grpc-prometheus"]
    MLServer -->|"metrics client"| PrometheusClient["prometheus-client"]

    %% Data Processing Dependencies
    MLServer -->|"tensor data"| NumPy["NumPy"]
    MLServer -->|"DataFrame codec"| Pandas["Pandas"]
    MLServer -->|"JSON serialization"| OrJSON["orjson"]

    %% Optional Integration Dependencies
    MLServer -.->|"async inference"| AIOKafka["aiokafka"]
    MLServer -.->|"batch processing"| TritonClient["tritonclient[http]<br/>>=2.42"]

    %% External Runtime Services
    MLServer -.->|"trace export"| OTelCollector["OpenTelemetry<br/>Collector"]
    MLServer -.->|"async messaging"| KafkaCluster["Apache Kafka<br/>Cluster"]
    MLServer -->|"model storage"| ModelStorage["Model Storage<br/>(PVC / S3)"]

    %% Platform Integration Points
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>8082/TCP"| MLServer
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe
    DSPipelines["Data Science<br/>Pipelines"] -.->|"auto deploy"| KServe

    %% Styling
    style MLServer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI (green)
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style StorageInit fill:#7ed321,stroke:#333,color:#fff
    style KubeRBACProxy fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style DSPipelines fill:#7ed321,stroke:#333,color:#fff

    %% Core Frameworks (blue)
    style FastAPI fill:#64b5f6,stroke:#333
    style Uvicorn fill:#64b5f6,stroke:#333
    style GRPCio fill:#64b5f6,stroke:#333
    style Protobuf fill:#64b5f6,stroke:#333
    style Pydantic fill:#64b5f6,stroke:#333

    %% ML Runtimes (yellow)
    style ScikitLearn fill:#fff176,stroke:#333
    style XGBoost fill:#fff176,stroke:#333
    style LightGBM fill:#fff176,stroke:#333
    style ONNXRuntime fill:#fff176,stroke:#333
    style ONNXRuntimeGPU fill:#fff176,stroke:#333

    %% Observability (orange)
    style OTelSDK fill:#ffb74d,stroke:#333
    style OTelFastAPI fill:#ffb74d,stroke:#333
    style OTelGRPC fill:#ffb74d,stroke:#333
    style StarletteExporter fill:#ffb74d,stroke:#333
    style GRPCPrometheus fill:#ffb74d,stroke:#333
    style PrometheusClient fill:#ffb74d,stroke:#333

    %% Data processing (light blue)
    style NumPy fill:#b3e5fc,stroke:#333
    style Pandas fill:#b3e5fc,stroke:#333
    style OrJSON fill:#b3e5fc,stroke:#333

    %% Optional (gray dashed border)
