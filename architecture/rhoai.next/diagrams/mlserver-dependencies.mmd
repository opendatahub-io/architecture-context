    style TritonClient fill:#e0e0e0,stroke:#666,stroke-dasharray: 5 5

    %% External services (amber)
    style OTelCollector fill:#f5a623,stroke:#333,color:#fff
    style KafkaCluster fill:#f5a623,stroke:#333,color:#fff
    style ModelStorage fill:#f5a623,stroke:#333,color:#fff
