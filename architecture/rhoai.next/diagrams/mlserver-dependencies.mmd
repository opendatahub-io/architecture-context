graph LR
    MLServer["MLServer<br/>v1.7.1+rhaiv.10"]

    %% Internal Platform Dependencies
    MLServer -->|"container runtime<br/>(runs inside InferenceService pod)"| KServe["KServe"]
    MLServer -->|"CPU + CUDA base images"| AIPCC["AIPCC Base Images<br/>cpu:3.5, cuda-12.9:3.5"]
    MLServer -->|"hermetic Python packages"| RHELAI["RHEL AI PyPI<br/>Package Index"]

    %% Core Framework Dependencies
    MLServer -->|"REST framework"| FastAPI["FastAPI<br/>0.134-0.136"]
    MLServer -->|"ASGI server"| Uvicorn["uvicorn"]
    MLServer -->|"gRPC framework"| GRPCIO["grpcio<br/>>=1.67.1"]
    MLServer -->|"protobuf serialization"| Protobuf["protobuf<br/>5.27-6.x"]
    MLServer -->|"data validation"| Pydantic["pydantic<br/>^2.7.1"]
    MLServer -->|"tensor handling"| NumPy["numpy"]
    MLServer -->|"DataFrame codecs"| Pandas["pandas"]

    %% Observability Dependencies
    MLServer -->|"trace SDK"| OTelSDK["OpenTelemetry SDK<br/>^1.22.0"]
    MLServer -->|"FastAPI tracing"| OTelFastAPI["OTel FastAPI<br/>Instrumentation"]
    MLServer -->|"gRPC tracing"| OTelGRPC["OTel gRPC<br/>Instrumentation"]
    MLServer -->|"OTLP export"| OTelExporter["OTel OTLP<br/>gRPC Exporter"]
    MLServer -->|"REST metrics"| StarletteExp["starlette-exporter"]
    MLServer -->|"gRPC metrics"| GRPCProm["py-grpc-prometheus"]

    %% ML Runtime Dependencies (CPU image)
    MLServer -.->|"sklearn runtime"| ScikitLearn["scikit-learn"]
    MLServer -.->|"xgboost runtime"| XGBoost["xgboost"]
    MLServer -.->|"lightgbm runtime"| LightGBM["lightgbm"]
    MLServer -.->|"onnx runtime (CPU)"| ONNXRuntime["onnxruntime<br/>>=1.20.0"]

    %% ML Runtime Dependencies (CUDA image)
    MLServer -.->|"onnx runtime (GPU)"| ONNXRuntimeGPU["onnxruntime-gpu<br/>>=1.20.0"]

    %% Transport Dependencies
    MLServer -->|"Kafka transport"| AioKafka["aiokafka"]
    MLServer -->|"async HTTP"| AioHTTP["aiohttp<br/>3.14-3.x"]
    MLServer -->|"V2 protocol client"| TritonClient["tritonclient[http]<br/>>=2.42"]

    %% Performance Dependencies
    MLServer -->|"fast JSON"| Orjson["orjson"]
    MLServer -->|"async event loop"| Uvloop["uvloop"]

    %% Integration Points (consumers)
    KServeDP["KServe Data Plane"] -->|"routes inference<br/>8080/TCP, 8081/TCP"| MLServer
    PromScraper["Prometheus"] -->|"scrapes metrics<br/>8082/TCP"| MLServer
    OTelCollector["OpenTelemetry<br/>Collector"] -.->|"receives traces<br/>gRPC OTLP"| MLServer
    KafkaBroker["Apache Kafka<br/>Broker"] <-.->|"message transport<br/>9092/TCP"| MLServer

