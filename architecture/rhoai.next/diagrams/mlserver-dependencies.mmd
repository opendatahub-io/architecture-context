graph LR
    MLServer["MLServer<br/>Multi-Model Inference Server"]

    %% Internal Platform Dependencies
    MLServer -->|"container runtime<br/>pod lifecycle"| KServe["KServe<br/>(Platform)"]
    MLServer -->|"TLS + auth<br/>sidecar proxy"| KRBAC["kube-rbac-proxy<br/>(Sidecar)"]

    %% Core Framework Dependencies
    MLServer -->|"REST API<br/>framework"| FastAPI["FastAPI ≥0.134"]
    MLServer -->|"ASGI server<br/>REST + metrics"| Uvicorn["uvicorn"]
    MLServer -->|"gRPC server<br/>framework"| gRPC["grpcio ≥1.67"]
    MLServer -->|"protobuf<br/>serialization"| Protobuf["protobuf ≥5.27"]
    MLServer -->|"data validation<br/>settings"| Pydantic["pydantic ^2.7"]

    %% Compute Dependencies
    MLServer -->|"tensor<br/>operations"| NumPy["numpy"]
    MLServer -->|"DataFrame<br/>I/O"| Pandas["pandas"]

    %% Runtime Plugin Dependencies
    MLServer -.->|"sklearn<br/>runtime"| ScikitLearn["scikit-learn"]
    MLServer -.->|"xgboost<br/>runtime"| XGBoost["xgboost"]
    MLServer -.->|"lightgbm<br/>runtime"| LightGBM["lightgbm"]
    MLServer -.->|"onnx runtime<br/>(CPU)"| ONNXRuntime["onnxruntime ≥1.20"]
    MLServer -.->|"onnx runtime<br/>(CUDA)"| ONNXRuntimeGPU["onnxruntime-gpu ≥1.20"]
    MLServer -.->|"mlflow<br/>runtime"| MLflow["mlflow"]
    MLServer -.->|"huggingface<br/>runtime"| HuggingFace["HuggingFace<br/>Transformers"]

    %% Observability Dependencies
    MLServer -.->|"metrics export"| StarlettExp["starlette-exporter"]
    MLServer -.->|"gRPC metrics"| GRPCProm["py-grpc-prometheus"]
    MLServer -.->|"trace export<br/>(optional)"| OTEL["opentelemetry-sdk ^1.22"]

    %% Optional Dependencies
    MLServer -.->|"async inference<br/>(optional)"| AIOKafka["aiokafka"]

    %% Integration Points (who connects to MLServer)
    Prometheus["Prometheus"] -->|"scrape /metrics<br/>8082/TCP"| MLServer
    OTLPCollector["OTLP Collector"] -.->|"receives traces"| MLServer
    ModelStorage["/mnt/models<br/>Volume Mount"] -->|"model artifacts"| MLServer

