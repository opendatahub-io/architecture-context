graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        PrometheusExt["Prometheus<br/>(Monitoring Stack)"]
        K8sAPIServer["Kubernetes API Server"]
        OCPAuth["OpenShift API<br/>(config.openshift.io)"]
    end

    subgraph ApplicationsNS["APPLICATIONS NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["ai-gateway-operator Pod"]
            Controller["ai-gateway-operator<br/>SA: ai-gateway-operator"]
            HealthEP["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
            MetricsEP["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TLS + Bearer Token"]
        end

        subgraph BatchGWPod["batch-gateway-operator Pod"]
            BGWOp["batch-gateway-operator<br/>SA: llm-d-batch-gateway-operator"]
            BGWMetrics["Metrics<br/>:8443/TCP HTTPS"]
        end

        subgraph MaaSPod["maas-controller Pod"]
            MaaSCtrl["maas-controller<br/>SA: maas-controller"]
            MaaSWebhook["Webhook Service<br/>:443/TCP → :9443/TCP<br/>TLS (service-serving cert)"]
        end
    end

    subgraph InfraNS["INFRASTRUCTURE NAMESPACE (redhat-ai-gateway-infra)"]
        MaaSDBConfig["maas-db-config Secret<br/>(Opaque)"]
    end

    %% Flows from Operator to K8s API
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>CRD Watch, SSA, CRUD"| K8sAPIServer
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>Read auth config"| OCPAuth

    %% K8s API to Webhook
    K8sAPIServer -->|"HTTPS/443<br/>TLS (service-serving cert)<br/>API Server Client Cert<br/>Admission Review"| MaaSWebhook

    %% Monitoring
    PrometheusExt -->|"HTTPS/8443<br/>TLS<br/>Bearer Token (SA)<br/>Scrape /metrics"| MetricsEP
    PrometheusExt -->|"HTTPS/8443<br/>TLS<br/>Scrape /metrics"| BGWMetrics

    %% Sub-component API access
    BGWOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token"| K8sAPIServer
    MaaSCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token"| K8sAPIServer

    %% Cross-namespace secret migration
    MaaSCtrl -->|"Secret migration<br/>RBAC: maas-controller-secret-migrate"| MaaSDBConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef subcomponent fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef infra fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class PrometheusExt,K8sAPIServer,OCPAuth external
    class Controller,HealthEP,MetricsEP operator
    class BGWOp,BGWMetrics,MaaSCtrl,MaaSWebhook subcomponent
    class MaaSDBConfig secret
