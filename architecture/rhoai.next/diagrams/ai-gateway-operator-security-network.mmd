graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - Kubernetes Network)"]
        direction TB

        subgraph NS_Apps["Namespace: redhat-ods-applications"]
            direction TB
            Operator["ai-gateway-operator<br/>SA: ai-gateway-operator<br/>UID: 65532, SCC: nonroot-v2<br/>FIPS: strictfipsruntime + ubi9-pqc"]
            MetricsSvc["ai-gateway-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS, TLS (service-ca)"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No auth"]

            subgraph SubComps["Sub-Components (conditionally deployed)"]
                BatchGW["batch-gateway-operator<br/>(when batchGateway: Managed)"]
                MaaSCtrl["maas-controller<br/>(when MaaS: Managed)"]
                AIGWCtrl["ai-gateway-controller<br/>(with MaaS toggle)"]
            end
        end

        subgraph NS_Infra["Namespace: redhat-ai-gateway-infra"]
            DBSecret["maas-db-config Secret<br/>Type: Opaque<br/>DB connection config"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        APIServerCR["OpenShift APIServer CR<br/>TLS profile source<br/>(Intermediate/Modern)"]

        subgraph Monitoring["Monitoring Stack"]
            Prometheus["Prometheus<br/>Scrapes metrics"]
        end
    end

    %% Flows within cluster
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -->|"SSA deploy<br/>manifests"| SubComps
    Operator -->|"TLS profile<br/>fetch"| APIServerCR

    MaaSCtrl -.->|"cross-namespace<br/>secret access"| DBSecret

    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>TokenReview + SAR"| MetricsSvc

    K8sAPI -->|"Watch events<br/>AIGateway CR"| Operator

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef subcomp fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    classDef k8s fill:#326ce5,stroke:#333,stroke-width:2px,color:#fff
    classDef secret fill:#e74c3c,stroke:#333,stroke-width:2px,color:#fff
    classDef monitoring fill:#f39c12,stroke:#333,stroke-width:2px,color:#fff
    classDef service fill:#3498db,stroke:#333,stroke-width:2px,color:#fff
    classDef health fill:#27ae60,stroke:#333,stroke-width:2px,color:#fff

    class Operator operator
    class BatchGW,MaaSCtrl,AIGWCtrl subcomp
    class K8sAPI,APIServerCR k8s
    class DBSecret secret
    class Prometheus monitoring
    class MetricsSvc service
    class HealthProbe health
