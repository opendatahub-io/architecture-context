graph TD
    subgraph "vLLM CUDA - Authentication & Authorization Model"
        direction TB

        subgraph "Note"
            Note["This is a container image, not an operator.<br/>No ClusterRoles or RoleBindings are defined.<br/>All auth is delegated to the serving infrastructure."]
        end

        subgraph "External Request Flow"
            Client["External Client<br/>(Bearer Token - OAuth/OIDC)"]
        end

        subgraph "Gateway Layer"
            Gateway["Gateway API (Envoy)<br/>TLS Termination<br/>Port 443/TCP"]
        end

        subgraph "Pod-Level Auth Enforcement"
            KubeRBAC["kube-rbac-proxy Sidecar<br/>(Injected by RHOAI Platform Operator)"]

            subgraph "Auth Mechanism"
                SAR["SubjectAccessReview<br/>against Kubernetes API Server"]
            end

            KubeRBAC -->|"validates each request"| SAR
        end

        subgraph "Application (No Auth)"
            HTTPEndpoints["/v1/completions<br/>/v1/chat/completions<br/>/v1/models<br/>/v1/embeddings<br/>/health<br/>Port 8000/TCP - No Auth"]
            GRPCEndpoint["TGIS GenerationService<br/>Port 8033/TCP - No Auth"]
        end

        subgraph "Namespace-Level Isolation"
            NSPolicy["Namespace Boundary<br/>- NetworkPolicy per namespace<br/>- ResourceQuota / LimitRange<br/>- Per-namespace Secrets for model storage"]
        end
    end

    Client -->|"HTTPS/443"| Gateway
    Gateway -->|"HTTPS/8443"| KubeRBAC
    KubeRBAC -->|"HTTP/8000<br/>(pre-authorized)"| HTTPEndpoints
    KubeRBAC -->|"gRPC/8033<br/>(pre-authorized)"| GRPCEndpoint

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style KubeRBAC fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style SAR fill:#f8cecc,stroke:#b85450
    style HTTPEndpoints fill:#d5e8d4,stroke:#82b366
    style GRPCEndpoint fill:#d5e8d4,stroke:#82b366
    style Gateway fill:#ffe6cc,stroke:#d79b00
    style Client fill:#f9f9f9,stroke:#999
    style NSPolicy fill:#dae8fc,stroke:#6c8ebf
