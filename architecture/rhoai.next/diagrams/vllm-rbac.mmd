graph TD
    subgraph "vllm-cuda Container"
        Container["vllm-cuda<br/>UID 2000 (non-root)"]
    end

    subgraph "Platform-Delegated RBAC"
        direction TB
        KServeSA["KServe-managed<br/>Service Account"]
        KServeRBAC["KServe RBAC<br/>(ClusterRole / RoleBinding)"]
    end

    subgraph "Auth Delegation"
        direction TB
        OAuthProxy["OAuth Proxy Sidecar<br/>HTTP :8000 auth"]
        IstioAuth["Istio AuthorizationPolicy<br/>gRPC :8033 auth"]
    end

    subgraph "API Endpoints (No Built-in Auth)"
        HTTPAPI["HTTP API :8000/TCP<br/>/v1/completions<br/>/v1/chat/completions<br/>/v1/models<br/>/v1/embeddings<br/>/health"]
        GRPCAPI["gRPC API :8033/TCP<br/>GenerationService"]
    end

    subgraph "Build Secrets"
        GitSecret["git_auth_secret<br/>Type: Opaque<br/>Purpose: Tekton pipeline git clone<br/>Provisioned by: Konflux"]
    end

    KServeSA -->|"runs container as"| Container
    KServeRBAC -->|"grants permissions to"| KServeSA
    OAuthProxy -->|"enforces auth for"| HTTPAPI
    IstioAuth -->|"enforces auth for"| GRPCAPI

    Note["Note: This repository defines no<br/>RBAC resources. All auth and<br/>authorization is delegated to<br/>KServe, Istio, and OAuth proxy."]

    style Container fill:#4a90e2,stroke:#333,color:#fff
    style KServeSA fill:#7ed321,stroke:#333,color:#fff
    style KServeRBAC fill:#7ed321,stroke:#333,color:#fff
    style OAuthProxy fill:#ffe6cc,stroke:#d79b00
    style IstioAuth fill:#ffe6cc,stroke:#d79b00
    style HTTPAPI fill:#d5e8d4,stroke:#82b366
    style GRPCAPI fill:#d5e8d4,stroke:#82b366
    style GitSecret fill:#fff2cc,stroke:#d6b656
    style Note fill:#f9f9f9,stroke:#ccc,stroke-dasharray: 5 5
