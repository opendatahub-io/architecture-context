graph TD
    subgraph "vLLM Container Security Context"
        Container["odh-vllm-cuda-rhel9<br/>UID: 1001 (non-root)"]
    end

    subgraph "No RBAC Resources Defined"
        direction TB
        Note["This component is a container image,<br/>not a controller or operator.<br/><br/>No ClusterRoles, Roles,<br/>or RoleBindings are defined<br/>in this repository."]
    end

    subgraph "Runtime Auth Enforcement (External)"
        KubeRBACProxy["kube-rbac-proxy Sidecar<br/>(Injected by platform operator)"]
        SAR["SubjectAccessReview<br/>(Kubernetes API)"]
        KubeRBACProxy -->|"validates requests via"| SAR
    end

    subgraph "Runtime Service Account (External)"
        SA["{inferenceservice-name}-sa<br/>(Created by KServe)"]
    end

    subgraph "API Access (No Container-Level Auth)"
        HTTPApi["HTTP API 8000/TCP<br/>Auth: None<br/>Delegated to kube-rbac-proxy"]
        GRPCApi["gRPC API 8033/TCP<br/>Auth: None<br/>Delegated to kube-rbac-proxy"]
    end

    subgraph "Runtime Secrets (Injected at Deploy Time)"
        HFToken["HF_TOKEN<br/>(env var)<br/>HuggingFace API token"]
        AWSCreds["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>(env vars)<br/>S3 storage credentials"]
    end

    Container --- Note
    SA -->|"runs as"| Container
    KubeRBACProxy -->|"proxies to"| HTTPApi
    KubeRBACProxy -->|"proxies to"| GRPCApi
    HFToken -.->|"injected via<br/>ServingRuntime spec"| Container
    AWSCreds -.->|"injected via<br/>ServingRuntime spec"| Container

    style Container fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style KubeRBACProxy fill:#f5a623,stroke:#333,color:#fff
    style SAR fill:#f5a623,stroke:#333,color:#fff
    style SA fill:#7ed321,stroke:#333,color:#fff
    style HTTPApi fill:#d5e8d4,stroke:#82b366
    style GRPCApi fill:#d5e8d4,stroke:#82b366
    style HFToken fill:#fff2cc,stroke:#d6b656
    style AWSCreds fill:#fff2cc,stroke:#d6b656
