        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_Proxy["{tas-name}-proxy<br/>(instance namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_TAS["tas-manager-rolebinding"]
        CRB_Proxy["{tas-name}-{ns}-proxy-rolebinding"]
        CRB_TLS["tls-profile-reader-binding"]
        CRB_Module["module-manager-rolebinding"]
        CRB_EvalHub["evalhub-manager-rolebinding"]
        CRB_LMES["lmes-manager-rolebinding"]
        CRB_GORCH["gorch-manager-rolebinding"]
        CRB_Nemo["nemo-manager-rolebinding"]
        CRB_EvalHubAuth["evalhub-auth-reviewer-binding"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>(operator namespace)"]
        RB_Tenant["evalhub-tenant-admin-binding<br/>(instance namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_TAS["tas-manager-role"]
        CR_Proxy["proxy-role"]
        CR_TLS["tls-profile-reader"]
        CR_Module["module-manager-role"]
        CR_EvalHub["evalhub-manager-role"]
        CR_LMES["lmes-manager-role"]
        CR_GORCH["gorch-manager-role"]
        CR_Nemo["nemo-manager-role"]
    end

    subgraph TASResources["TAS Resources"]
        TAS_CRD["trustyai.opendatahub.io<br/>TrustyAIService<br/>get,list,watch,create,<br/>update,patch,delete"]
        TAS_Apps["apps<br/>Deployments<br/>list,watch,get,create,<br/>update,patch,delete"]
