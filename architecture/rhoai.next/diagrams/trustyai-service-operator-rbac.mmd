graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(system namespace)"]
        SA_Proxy["{instance}-proxy<br/>(per-instance)"]
        SA_Auth["system:authenticated<br/>(Group — all users)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_TAS["tas-manager-rolebinding"]
        CRB_LMES["lmes-manager-rolebinding"]
        CRB_EH["evalhub-manager-rolebinding"]
        CRB_GORCH["gorch-manager-rolebinding"]
        CRB_NEMO["nemo-guardrails-manager-rolebinding"]
        CRB_JM["job-mgr-manager-rolebinding"]
        CRB_MOD["module-manager-rolebinding"]
        CRB_PROXY["proxy-rolebinding"]
        CRB_PROXY_INST["{instance}-{ns}-proxy-rolebinding"]
        CRB_USER["default-lmeval-user-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_TAS["tas-manager-role"]
        CR_LMES["lmes-manager-role"]
        CR_EH["evalhub-manager-role"]
        CR_GORCH["gorch-manager-role"]
        CR_NEMO["nemo-guardrails-manager-role"]
        CR_JM["job-mgr-manager-role"]
        CR_MOD["manager-role (module)"]
        CR_PROXY["proxy-role"]
        CR_METRICS["metrics-reader"]
        CR_USER["lmeval-user-role"]
    end

    subgraph TAS_Resources["TAS Resources"]
        TAS_CRD["trustyai.opendatahub.io<br/>trustyaiservices/*"]
        TAS_Core["core<br/>deployments, pods, configmaps,<br/>services, secrets, sa, pvc"]
        TAS_Route["route.openshift.io<br/>routes"]
        TAS_KServe["serving.kserve.io<br/>inferenceservices/*"]
        TAS_Istio["networking.istio.io<br/>destinationrules, virtualservices"]
        TAS_Mon["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph LMES_Resources["LMES Resources"]
        LMES_CRD["trustyai.opendatahub.io<br/>lmevaljobs/*"]
        LMES_Core["core<br/>pods, pods/exec, configmaps,<br/>secrets, pv, pvc"]
    end

    subgraph EH_Resources["EvalHub Resources"]
        EH_CRD["trustyai.opendatahub.io<br/>evalhubs, evaluations,<br/>collections, providers"]
        EH_Apps["apps<br/>deployments/*"]
        EH_Core["core<br/>services, configmaps, sa,<br/>namespaces, events"]
        EH_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings, roles,<br/>rolebindings, clusterroles"]
        EH_Kueue["kueue.x-k8s.io<br/>workloads"]
        EH_MLflow["mlflow.kubeflow.org<br/>experiments"]
        EH_HW["infrastructure.opendatahub.io<br/>hardwareprofiles"]
    end

    subgraph GORCH_Resources["GORCH Resources"]
        GORCH_CRD["trustyai.opendatahub.io<br/>guardrailsorchestrators/*"]
        GORCH_KServe["serving.kserve.io<br/>servingruntimes,<br/>inferenceservices"]
    end

    subgraph Nemo_Resources["NeMo Resources"]
        NEMO_CRD["trustyai.opendatahub.io<br/>nemoguardrails/*"]
        NEMO_Istio["networking.istio.io<br/>envoyfilters"]
        NEMO_MCP["mcp.kuadrant.io<br/>mcpgatewayextensions"]
        NEMO_GW["gateway.networking.k8s.io<br/>gateways"]
    end

    subgraph JM_Resources["Job Manager Resources"]
        JM_Kueue["kueue.x-k8s.io<br/>workloads/*, resourceflavors,<br/>workloadpriorityclasses"]
        JM_Sched["scheduling.k8s.io<br/>priorityclasses"]
    end

    subgraph Module_Resources["Module Resources"]
        MOD_CRD["components.platform.opendatahub.io<br/>trustyais/*"]
    end

    subgraph Proxy_Resources["Proxy Resources"]
        PROXY_Auth["authentication.k8s.io<br/>tokenreviews"]
        PROXY_Authz["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph User_Resources["User Resources"]
        USER_CRD["trustyai.opendatahub.io<br/>lmevaljobs, lmevaljobs/status"]
    end

    %% SA → Bindings
    SA_CM -->|bound via| CRB_TAS
    SA_CM -->|bound via| CRB_LMES
    SA_CM -->|bound via| CRB_EH
    SA_CM -->|bound via| CRB_GORCH
    SA_CM -->|bound via| CRB_NEMO
    SA_CM -->|bound via| CRB_JM
    SA_CM -->|bound via| CRB_MOD
    SA_CM -->|bound via| CRB_PROXY
    SA_Proxy -->|bound via| CRB_PROXY_INST
    SA_Auth -->|bound via| CRB_USER

    %% Bindings → Roles
    CRB_TAS -->|grants| CR_TAS
    CRB_LMES -->|grants| CR_LMES
    CRB_EH -->|grants| CR_EH
    CRB_GORCH -->|grants| CR_GORCH
    CRB_NEMO -->|grants| CR_NEMO
    CRB_JM -->|grants| CR_JM
    CRB_MOD -->|grants| CR_MOD
    CRB_PROXY -->|grants| CR_PROXY
    CRB_PROXY_INST -->|grants| CR_PROXY
    CRB_USER -->|grants| CR_USER

    %% Roles → Resources
    CR_TAS -->|CRUD| TAS_CRD
    CR_TAS -->|CRUD| TAS_Core
    CR_TAS -->|CRUD| TAS_Route
    CR_TAS -->|get,list,watch,<br/>update,patch,delete| TAS_KServe
    CR_TAS -->|CRUD| TAS_Istio
    CR_TAS -->|list,watch,create| TAS_Mon

    CR_LMES -->|CRUD| LMES_CRD
    CR_LMES -->|get,list,watch,<br/>create,delete| LMES_Core

    CR_EH -->|CRUD| EH_CRD
    CR_EH -->|CRUD| EH_Apps
    CR_EH -->|CRUD| EH_Core
    CR_EH -->|CRUD| EH_RBAC
    CR_EH -->|CRUD| EH_Kueue
    CR_EH -->|get,list,create| EH_MLflow
    CR_EH -->|get,list| EH_HW

    CR_GORCH -->|CRUD| GORCH_CRD
    CR_GORCH -->|get,list,watch| GORCH_KServe

    CR_NEMO -->|CRUD| NEMO_CRD
    CR_NEMO -->|CRUD| NEMO_Istio
    CR_NEMO -->|get,list,watch| NEMO_MCP
    CR_NEMO -->|get,list,watch| NEMO_GW

    CR_JM -->|CRUD| JM_Kueue
    CR_JM -->|list,get,watch| JM_Sched

    CR_MOD -->|get,list,watch,<br/>update,patch| MOD_CRD

    CR_PROXY -->|create| PROXY_Auth
    CR_PROXY -->|create| PROXY_Authz

    CR_USER -->|CRUD| USER_CRD

