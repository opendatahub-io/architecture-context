        TAS_Istio["networking.istio.io<br/>DestinationRules,<br/>VirtualServices<br/>create,list,watch,get,<br/>update,patch,delete"]
    end

    subgraph ModuleResources["Module Resources"]
        MOD_CRD["components.platform.opendatahub.io<br/>TrustyAIs<br/>get,list,watch,update,patch"]
    end

    subgraph EvalHubResources["EvalHub Resources"]
        EH_CRD["trustyai.opendatahub.io<br/>EvalHubs<br/>get,list,watch,create,<br/>update,patch,delete"]
