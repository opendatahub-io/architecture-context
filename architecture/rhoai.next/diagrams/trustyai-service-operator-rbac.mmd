graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["trustyai-service-operator-<br/>controller-manager"]
        AuthUsers["system:authenticated<br/>(all authenticated users)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        TAS_CRB["tas-manager-rolebinding"]
        EH_CRB["evalhub-manager-rolebinding"]
        LMES_CRB["lmes-manager-rolebinding"]
        NEMO_CRB["nemo-guardrails-manager-rolebinding"]
        LMEVAL_CRB["default-lmeval-user-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        TAS_CR["tas-manager-role"]
        EH_CR["evalhub-manager-role"]
        LMES_CR["lmes-manager-role"]
        NEMO_CR["nemo-guardrails-manager-role"]
        LMEVAL_CR["lmeval-user-role"]
        PROXY_CR["proxy-role"]
        TLS_CR["tls-profile-reader"]
        METRICS_CR["metrics-reader"]
    end

    subgraph TAS_Resources["TAS Resources"]
        TASRes["trustyai.opendatahub.io<br/>TrustyAIService"]
        TASApps["apps: Deployments<br/>core: Services, Pods,<br/>ConfigMaps, Secrets"]
        TASRoutes["route.openshift.io<br/>Routes"]
        TASKServe["serving.kserve.io<br/>InferenceServices"]
        TASIstio["networking.istio.io<br/>VirtualServices,<br/>DestinationRules"]
    end

    subgraph EH_Resources["EvalHub Resources"]
        EHRes["trustyai.opendatahub.io<br/>EvalHubs, Evaluations,<br/>Collections, Providers"]
        EHBatch["batch: Jobs<br/>apps: Deployments"]
        EHRBAC["rbac: ClusterRoleBindings"]
        EHKueue["kueue.x-k8s.io<br/>Workloads"]
        EHMLflow["mlflow.kubeflow.org<br/>Experiments"]
    end

    subgraph LMES_Resources["LMES Resources"]
        LMESRes["trustyai.opendatahub.io<br/>LMEvalJobs"]
        LMESCore["core: Pods, Pods/exec,<br/>ConfigMaps, Secrets, PVCs"]
    end

    subgraph NEMO_Resources["NemoGuardrails Resources"]
        NEMORes["trustyai.opendatahub.io<br/>NemoGuardrails"]
        NEMOApps["apps: Deployments<br/>core: Services, ConfigMaps,<br/>Secrets, ServiceAccounts"]
        NEMORoutes["route.openshift.io<br/>Routes"]
    end

    subgraph Auth_Resources["Auth Resources"]
        TokenReview["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    subgraph Platform_Resources["Platform Resources"]
        APIServers["config.openshift.io<br/>APIServers"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    subgraph Aggregated["Aggregated Roles (User-Facing)"]
        EditorRole["trustyaiservice-editor-role<br/>(→ admin, edit)"]
        ViewerRole["trustyaiservice-viewer-role<br/>(→ admin, view)"]
        NemoEditor["nemoguardrail-editor-role<br/>(→ edit)"]
        NemoViewer["nemoguardrail-viewer-role<br/>(→ view)"]
    end

    %% SA bindings
    SA -->|bound via| TAS_CRB
    SA -->|bound via| EH_CRB
    SA -->|bound via| LMES_CRB
    SA -->|bound via| NEMO_CRB
    AuthUsers -->|bound via| LMEVAL_CRB

    %% CRB to CR
    TAS_CRB -->|grants| TAS_CR
    EH_CRB -->|grants| EH_CR
    LMES_CRB -->|grants| LMES_CR
    NEMO_CRB -->|grants| NEMO_CR
    LMEVAL_CRB -->|grants| LMEVAL_CR

    %% CR to Resources
    TAS_CR -->|CRUD + watch| TASRes
    TAS_CR -->|CRUD + watch| TASApps
    TAS_CR -->|CRUD + watch| TASRoutes
    TAS_CR -->|CRUD + watch| TASKServe
    TAS_CR -->|CRUD + watch| TASIstio

    EH_CR -->|CRUD + watch| EHRes
    EH_CR -->|CRUD + watch| EHBatch
    EH_CR -->|CRUD + watch| EHRBAC
    EH_CR -->|CRUD + watch| EHKueue
    EH_CR -->|CRUD + watch| EHMLflow

    LMES_CR -->|CRUD + watch| LMESRes
    LMES_CR -->|CRUD + watch| LMESCore

    NEMO_CR -->|CRUD + watch| NEMORes
    NEMO_CR -->|CRUD + watch| NEMOApps
    NEMO_CR -->|CRUD + watch| NEMORoutes

    LMEVAL_CR -->|CRUD| LMESRes

    PROXY_CR -->|create| TokenReview
    PROXY_CR -->|create| SAR

    TLS_CR -->|get, list, watch| APIServers
    METRICS_CR -->|get| MetricsURL

    %% Aggregated
    EditorRole -->|CRUD| TASRes
    ViewerRole -->|get, list, watch| TASRes
    NemoEditor -->|CRUD| NEMORes
    NemoViewer -->|get, list, watch| NEMORes

