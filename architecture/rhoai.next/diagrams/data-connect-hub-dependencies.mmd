graph LR
    DCH["Data Connect Hub"]

    %% External Dependencies (build/runtime)
    DCH -->|"operator framework"| ControllerRuntime["controller-runtime 0.25.1"]
    DCH -->|"REST framework"| Actix["actix-web 4.14"]
    DCH -->|"gRPC framework"| Tonic["tonic 0.14"]
    DCH -->|"columnar data"| Arrow["Arrow / Arrow-Flight 59.1"]
    DCH -->|"async SQL"| SQLx["sqlx 0.8"]
    DCH -->|"TLS library"| Rustls["rustls 0.23<br/>(aws_lc_rs FIPS)"]
    DCH -->|"data access layer"| OpenDAL["opendal 0.58"]
    DCH -->|"async runtime"| Tokio["tokio 1.52"]
    DCH -->|"K8s client (Rust)"| Kube["kube 3.1"]
    DCH -->|"Gateway API types"| GatewayAPI["gateway-api 1.3"]
    DCH -->|"OpenShift types"| OSAPI["openshift/api"]
    DCH -->|"TLS profile utils"| OSLibGo["openshift/library-go"]

    %% Internal Platform Dependencies
    DCH -->|"traffic routing"| OdhGateway["odh-gateway<br/>(HTTPRoute)"]
    DCH -->|"TLS profile"| APIServer["OpenShift APIServer"]
    DCH -->|"ingress domain"| OSIngress["OpenShift Ingress"]
    DCH -->|"TLS certs"| ServiceCA["service-serving<br/>certificates"]
    DCH -->|"metrics"| PromOp["prometheus-operator<br/>(ServiceMonitor)"]
    DCH -->|"REST auth"| KubeRBAC["kube-rbac-proxy"]
    DCH -->|"auth + authz"| K8sAPI["Kubernetes API"]

    %% Runtime Dependencies
    DCH -->|"metadata store"| PostgreSQL["PostgreSQL 17+"]

    %% Data Source Connectors
    DCH -.->|"postgres connector"| PGBackend["PostgreSQL Backends"]
    DCH -.->|"sqlite connector"| SQLiteBackend["SQLite"]
    DCH -.->|"s3 connector"| S3["S3 Storage"]
    DCH -.->|"milvus connector"| Milvus["Milvus"]
    DCH -.->|"elasticsearch connector"| ES["Elasticsearch"]
    DCH -.->|"neo4j connector"| Neo4j["Neo4j"]
    DCH -.->|"uri connector"| URIEndpoints["URI Endpoints"]

    %% Integration Points (inbound)
    Dashboard["ODH Dashboard"] -.->|"UI management"| DCH
    Pipelines["Data Science Pipelines"] -.->|"data access"| DCH

