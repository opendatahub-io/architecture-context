graph TB
    subgraph External["NO EXTERNAL EXPOSURE"]
        direction TB
        NoIngress["No Ingress / No Routes<br/>No external traffic paths"]
    end

    subgraph OperatorNS["Namespace: mcp-lifecycle-operator-system"]
        direction TB

        Operator["mcp-lifecycle-operator<br/>SA: controller-manager<br/>FIPS: strictfipsruntime<br/>HTTP/2: Disabled"]

        subgraph OperatorPorts["Operator Endpoints"]
            MetricsPort["8443/TCP Metrics<br/>HTTPS, TLS (self-signed)<br/>Auth: Bearer Token<br/>(TokenReview + SAR)"]
            HealthPort["8081/TCP Health Probes<br/>HTTP, No TLS<br/>Auth: None<br/>/healthz, /readyz"]
        end

        MetricsNetPol["NetworkPolicy:<br/>allow-metrics-traffic<br/>Restricts 8443 ingress to<br/>labeled namespaces"]
    end

    subgraph UserNS["Namespace: {user-namespace} (per MCPServer CR)"]
        direction TB

        MCPDeploy["MCP Server Deployment<br/>Image: user-provided<br/>ownerRef: MCPServer CR<br/>Annotation: config-hash (SHA-256)"]
        MCPService["ClusterIP Service<br/>{mcpserver-name}<br/>{spec.config.port}/TCP<br/>HTTP, No TLS, No Auth"]
        MCPNetPol["NetworkPolicy:<br/>{mcpserver-name}<br/>Allows ingress on MCP port<br/>Source: any"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Token"]
        Prometheus["Prometheus<br/>Scrapes 8443/TCP<br/>HTTPS, TLS<br/>Auth: Bearer Token"]
    end

    %% Operator → K8s API (CRUD)
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>CRUD: Deploy, Svc,<br/>NetPol, CM, Secret, Pod"| K8sAPI

    %% Operator → MCP Server (Handshake)
    Operator -->|"HTTP/{port}<br/>No TLS, No Auth<br/>MCP initialize handshake<br/>Backoff: 10s-2min"| MCPService

    %% Prometheus → Operator Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>Bearer Token"| MetricsPort

    %% K8s API → Operator (Watch)
    K8sAPI -->|"Watch events<br/>HTTP/2 long-poll<br/>TLS 1.2+, SA Token"| Operator

    %% Operator creates resources in user namespace
    Operator -.->|"creates & owns"| MCPDeploy
    Operator -.->|"creates & owns"| MCPService
    Operator -.->|"creates & owns"| MCPNetPol

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef operatorport fill:#3a7bd5,stroke:#333,stroke-width:1px,color:#fff
    classDef mcpserver fill:#7ed321,stroke:#333,stroke-width:2px,color:#333
    classDef clusterservice fill:#f5a623,stroke:#333,stroke-width:2px,color:#333
    classDef netpol fill:#e8e8e8,stroke:#999,stroke-width:1px,color:#333
    classDef noexposure fill:#ffcccc,stroke:#cc0000,stroke-width:2px,color:#333

    class Operator operator
    class MetricsPort,HealthPort operatorport
    class MCPDeploy,MCPService mcpserver
    class K8sAPI,Prometheus clusterservice
    class MetricsNetPol,MCPNetPol netpol
    class NoIngress noexposure
