graph TB
    subgraph OperatorNS["Namespace: mcp-lifecycle-operator-system"]
        direction TB
        Controller["mcp-lifecycle-operator<br/>controller-manager<br/>SA: controller-manager<br/>FIPS: strictfipsruntime"]

        subgraph OperatorPorts["Exposed Ports"]
            MetricsPort["8443/TCP HTTPS<br/>TLS (self-signed)<br/>Bearer Token Auth<br/>/metrics"]
            HealthPort["8081/TCP HTTP<br/>Plaintext<br/>No Auth<br/>/healthz /readyz"]
        end

        MetricsService["controller-manager-<br/>metrics-service<br/>ClusterIP 8443/TCP"]
    end

    subgraph UserNS["Namespace: {user-namespace}"]
        direction TB
        MCPPod["MCP Server Pod<br/>Image: {user-specified}<br/>{spec.config.port}/TCP"]
        MCPService["{mcpserver-name}<br/>ClusterIP<br/>{spec.config.port}/TCP"]
        MCPNetPol["NetworkPolicy<br/>Ingress: ANY pod → MCP port ONLY"]
    end

    subgraph Monitoring["Prometheus / OpenShift Monitoring"]
        Prometheus["Prometheus<br/>ServiceMonitor scrape"]
    end

    subgraph ControlPlane["Kubernetes Control Plane"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Metrics scrape flow
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>Bearer Token<br/>NS label: metrics=enabled"| MetricsService
    MetricsService --> MetricsPort

    %% Controller to MCP server handshake
    Controller -->|"HTTP/{port}<br/>Plaintext<br/>No Auth<br/>MCP Streamable HTTP<br/>Backoff: 10s→2min"| MCPService
    MCPService --> MCPPod

    %% Controller to Kubernetes API
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (SA)<br/>Watch: MCPServer, CM, Secret<br/>CRUD: Deploy, Svc, NetPol<br/>Update: MCPServer/status"| K8sAPI

    %% Kubelet health probes
    Kubelet["kubelet"] -->|"HTTP/8081<br/>Plaintext"| HealthPort

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    classDef mcpserver fill:#7ed321,stroke:#333,stroke-width:2px
    classDef monitoring fill:#f5a623,stroke:#333,stroke-width:2px
    classDef controlplane fill:#e8e8e8,stroke:#333,stroke-width:2px
    classDef netpol fill:#ff6b6b,stroke:#333,color:#fff,stroke-width:1px
    classDef service fill:#ddd,stroke:#666,stroke-width:1px

    class Controller operator
    class MetricsPort,HealthPort operator
    class MCPPod mcpserver
    class Prometheus monitoring
    class K8sAPI controlplane
    class Kubelet controlplane
    class MCPNetPol netpol
    class MetricsService,MCPService service
