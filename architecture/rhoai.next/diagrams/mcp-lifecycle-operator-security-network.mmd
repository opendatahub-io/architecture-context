graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(mcp-lifecycle-operator-system)"]
        direction TB
        Manager["mcp-lifecycle-operator<br/>controller-manager<br/>SA: mcp-lifecycle-operator-controller-manager<br/>FIPS: strictfipsruntime<br/>Crypto: DEFAULT:PQ"]

        subgraph Endpoints["Listening Endpoints"]
            WebhookEP["Webhook Service<br/>443→9443/TCP HTTPS<br/>TLS (cert-manager)<br/>K8s Admission Auth"]
            MetricsEP["Metrics Service<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
            HealthEP["Health/Ready<br/>8081/TCP HTTP<br/>Unauthenticated"]
        end
    end

    subgraph UserNS["USER NAMESPACE (per-tenant)"]
        direction TB
        MCPPod["Managed MCP Server Pod<br/>spec.config.port/TCP<br/>HTTP or HTTPS (configurable)"]
        MCPSvc["MCP Server Service<br/>ClusterIP"]
        NetPol["NetworkPolicy<br/>(open or restricted posture)"]
    end

    subgraph GatewayZone["GATEWAY INTEGRATION (optional)"]
        GW["Gateway"]
        HTTPRoute["HTTPRoute<br/>(created by operator)"]
        KuadrantReg["MCPServerRegistration<br/>(Kuadrant provider)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>openshift-monitoring<br/>openshift-user-workload-monitoring"]
    end

    subgraph CertMgmt["CERTIFICATE MANAGEMENT"]
        CertManager["cert-manager<br/>CA injection + cert provisioning"]
    end

    %% External → K8s
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% K8s → Operator (admission)
    K8sAPI -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>K8s Admission"| WebhookEP

    %% Operator → K8s (reconciliation)
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Operator → Managed MCP Server (handshake)
    Manager -->|"HTTP(S)/config.port<br/>Configurable TLS<br/>MCP Handshake"| MCPPod

    %% Gateway flows
    HTTPRoute -->|"routes to"| MCPSvc
    GW -->|"via HTTPRoute"| HTTPRoute
    User -.->|"HTTPS<br/>Gateway TLS<br/>Gateway Auth"| GW

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview + SAR"| MetricsEP

    %% cert-manager
    CertManager -->|"provisions certs"| WebhookEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8scontrol fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gateway fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef certmgmt fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class K8sAPI k8scontrol
    class Manager,WebhookEP,MetricsEP,HealthEP operator
    class MCPPod,MCPSvc,NetPol userns
    class GW,HTTPRoute,KuadrantReg gateway
    class Prometheus monitoring
    class CertManager certmgmt
