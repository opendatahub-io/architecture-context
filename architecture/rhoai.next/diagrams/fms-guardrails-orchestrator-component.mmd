graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator (Rust/axum+tonic)"]
        direction TB
        GuardrailsServer["Guardrails Server<br/>8033/TCP HTTP/HTTPS<br/>TLS 1.2+ (rustls+ring)"]
        HealthServer["Health Server<br/>8034/TCP HTTP<br/>No TLS"]

        subgraph APIRoutes["API Routes"]
            V1API["V1 API<br/>/api/v1/task/*<br/>Classification + Generation"]
            V2Detection["V2 Detection API<br/>/api/v2/text/detection/*<br/>Content, Chat, Context, Generated"]
            V2GenDet["V2 Generation-Detection<br/>/api/v2/text/generation-detection"]
            OpenAICompat["OpenAI-Compatible API<br/>/api/v2/chat/completions-detection<br/>/api/v2/text/completions-detection<br/>(conditional)"]
        end

        subgraph Core["Orchestrator Core"]
            TaskDispatch["Task Dispatch<br/>ClassificationWithGenTask<br/>ChatCompletionsDetectionTask<br/>ContentDetectionTask"]
            HeaderPassthrough["Header Passthrough<br/>+ X-Forwarded-Access-Token Rewrite"]
            TLSConfig["Named TLS Config System<br/>Per-service cert bundles"]
        end

        GuardrailsServer --> APIRoutes
        APIRoutes --> Core
    end

    Client["Client"] -->|"POST HTTP/HTTPS<br/>Passthrough Headers"| GuardrailsServer
    Kubelet["Kubelet"] -->|"GET /health, /info<br/>HTTP (no TLS)"| HealthServer

    TaskDispatch -->|"gRPC<br/>8033/TCP"| TGIS["TGIS Generation Service"]
    TaskDispatch -->|"gRPC<br/>8085/TCP"| Chunker["Chunker Services"]
    TaskDispatch -->|"REST HTTP/HTTPS<br/>8080/TCP"| Detector["Detector Services<br/>(HAP, toxicity, etc.)"]
    TaskDispatch -->|"REST HTTP/HTTPS<br/>Configurable"| OpenAISvc["OpenAI-Compatible<br/>Generation Service"]
    TaskDispatch -->|"gRPC/HTTP<br/>Configurable"| OTLP["OTLP Collector"]

    style GuardrailsServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style V1API fill:#6baed6,stroke:#333
    style V2Detection fill:#6baed6,stroke:#333
    style V2GenDet fill:#6baed6,stroke:#333
    style OpenAICompat fill:#6baed6,stroke:#333
    style TaskDispatch fill:#9ecae1,stroke:#333
    style HeaderPassthrough fill:#9ecae1,stroke:#333
    style TLSConfig fill:#9ecae1,stroke:#333
    style TGIS fill:#e8e8e8,stroke:#333
    style Chunker fill:#e8e8e8,stroke:#333
    style Detector fill:#e8e8e8,stroke:#333
    style OpenAISvc fill:#e8e8e8,stroke:#333
    style OTLP fill:#e8e8e8,stroke:#333
    style Client fill:#f5a623,stroke:#333
    style Kubelet fill:#f5a623,stroke:#333
