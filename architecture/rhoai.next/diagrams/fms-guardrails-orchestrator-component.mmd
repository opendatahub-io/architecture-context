graph TB
    subgraph Orchestrator["FMS Guardrails Orchestrator (Rust/axum)"]
        direction TB
        Server["REST API Server<br/>axum/hyper<br/>Port 8033/TCP"]
        HealthServer["Health Server<br/>Port 8034/TCP"]

        subgraph Clients["Internal Clients"]
            GenClient["GenerationClient<br/>gRPC (tonic)"]
            OpenAiClient["OpenAiClient<br/>HTTP (reqwest)"]
            DetClient["DetectorClient<br/>HTTP (reqwest)"]
            ChunkClient["ChunkerClient<br/>gRPC (tonic)"]
        end

        subgraph StreamPipeline["Streaming Pipeline"]
            BatchStream["DetectionBatchStream<br/>tokio::select_all()"]
            Batcher["DetectionBatcher<br/>MaxProcessedIndex / Completion"]
        end

        Server --> GenClient
        Server --> OpenAiClient
        Server --> DetClient
        Server --> ChunkClient
        Server --> BatchStream
        BatchStream --> Batcher
    end

    %% External Clients
    Client[Client] -->|"POST /api/v1/* /api/v2/*<br/>HTTP/HTTPS 8033/TCP<br/>TLS + mTLS (optional)"| Server
    Monitor[Monitoring] -->|"GET /health /info<br/>HTTP 8034/TCP"| HealthServer

    %% Backend Services
    GenClient -->|"gRPC 8033/TCP<br/>TLS/mTLS"| TGIS["TGIS<br/>GenerationService"]
    GenClient -->|"gRPC 8085/TCP<br/>TLS/mTLS"| CaikitNLP["Caikit NLP<br/>NlpService"]
    OpenAiClient -->|"HTTP/HTTPS 8080/TCP<br/>TLS + Bearer"| vLLM["OpenAI-compatible LLM<br/>(e.g., vLLM)"]
    DetClient -->|"HTTP/HTTPS 8080/TCP<br/>TLS + Bearer"| Detectors["Detector Service(s)<br/>/api/v1/text/*"]
    ChunkClient -->|"gRPC 8085/TCP<br/>TLS/mTLS"| Chunker["Caikit Chunker<br/>ChunkersService"]

    %% Observability
    Server -.->|"OTLP gRPC 4317/TCP<br/>or HTTP 4318/TCP"| OTel["OpenTelemetry<br/>Collector"]

    %% Styling
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style GenClient fill:#6baed6,stroke:#333
    style OpenAiClient fill:#6baed6,stroke:#333
    style DetClient fill:#6baed6,stroke:#333
    style ChunkClient fill:#6baed6,stroke:#333
    style BatchStream fill:#9ecae1,stroke:#333
    style Batcher fill:#9ecae1,stroke:#333
    style TGIS fill:#e8e8e8,stroke:#333
    style CaikitNLP fill:#e8e8e8,stroke:#333
    style vLLM fill:#e8e8e8,stroke:#333
    style Detectors fill:#f5a623,stroke:#333
    style Chunker fill:#e8e8e8,stroke:#333
    style OTel fill:#c7c7c7,stroke:#333
    style Client fill:#7ed321,stroke:#333
    style Monitor fill:#7ed321,stroke:#333
