graph TD
    subgraph "vllm-orchestrator-gateway RBAC"
        Note["No RBAC resources defined<br/>in this repository"]
    end

    subgraph "Authentication Model"
        direction TB
        Client["API Client"]
        Gateway["vllm-orchestrator-gateway<br/>(no auth enforcement)"]
        Orchestrator["FMS Guardrails Orchestrator<br/>(auth enforcement point)"]

        Client -->|"Authorization header<br/>(Bearer Token)"| Gateway
        Gateway -->|"Forwarded Authorization<br/>+ X-Forwarded-* headers"| Orchestrator
    end

    subgraph "TLS Identity"
        direction TB
        ClientCert["/etc/tls/private/tls.crt<br/>Client certificate"]
        ClientKey["/etc/tls/private/tls.key<br/>Private key"]
        CACert["/etc/tls/ca/service-ca.crt<br/>CA bundle"]
        PKCS12["PKCS#12 Identity<br/>(constructed at runtime)"]

        ClientCert -->|"input to"| PKCS12
        ClientKey -->|"input to"| PKCS12
        CACert -->|"validates orchestrator"| Orchestrator
        PKCS12 -->|"mTLS client identity"| Orchestrator
    end

    subgraph "Deployment RBAC (External)"
        Operator["Deploying Operator<br/>(trustyai-service-operator<br/>or RHOAI operator)"]
        SA["ServiceAccount<br/>(managed by operator)"]
        Operator -->|"creates & manages"| SA
        SA -->|"runs"| Gateway
    end

    style Note fill:#fff2cc,stroke:#d6b656
    style Gateway fill:#4a90e2,color:#fff
    style Orchestrator fill:#7ed321,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style ClientCert fill:#f5a623,color:#fff
    style ClientKey fill:#f5a623,color:#fff
    style CACert fill:#f5a623,color:#fff
    style PKCS12 fill:#f5a623,color:#fff
    style Operator fill:#dae8fc,stroke:#6c8ebf
    style SA fill:#dae8fc,stroke:#6c8ebf
