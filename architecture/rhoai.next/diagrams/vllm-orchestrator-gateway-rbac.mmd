graph TD
    subgraph "vllm-orchestrator-gateway RBAC"
        direction TB
        Note["This component has NO Kubernetes RBAC resources.<br/>It is a standalone HTTP service with no<br/>Kubernetes API interactions."]
    end

    subgraph "Authentication Model"
        direction TB
        AuthNote["Authentication is NOT enforced by the gateway.<br/>The gateway forwards headers as-is:"]
        AuthHeader["Authorization header<br/>(pass-through to orchestrator)"]
        XForwarded["x-forwarded-* headers<br/>(pass-through to orchestrator)"]
        AuthNote --> AuthHeader
        AuthNote --> XForwarded
    end

    subgraph "TLS Identity (Optional)"
        direction TB
        TLSNote["mTLS client identity for orchestrator communication"]
        ClientCert["/etc/tls/private/tls.crt<br/>Client certificate<br/>Provisioned by: cert-manager"]
        ClientKey["/etc/tls/private/tls.key<br/>Private key<br/>Provisioned by: cert-manager"]
        CACert["/etc/tls/ca/service-ca.crt<br/>CA certificate<br/>Provisioned by: OpenShift service-ca"]
        TLSNote --> ClientCert
        TLSNote --> ClientKey
        TLSNote --> CACert
    end

    subgraph "Security Gaps"
        direction TB
        Gap1["⚠ Container runs as root<br/>(no USER directive in Dockerfile)"]
        Gap2["⚠ No health/readiness endpoints"]
        Gap3["⚠ No Prometheus metrics"]
        Gap4["⚠ danger_accept_invalid_hostnames<br/>for localhost connections"]
    end

    style Note fill:#d5e8d4,stroke:#82b366
    style AuthNote fill:#dae8fc,stroke:#6c8ebf
    style AuthHeader fill:#dae8fc,stroke:#6c8ebf
    style XForwarded fill:#dae8fc,stroke:#6c8ebf
    style TLSNote fill:#fff2cc,stroke:#d6b656
    style ClientCert fill:#fff2cc,stroke:#d6b656
    style ClientKey fill:#fff2cc,stroke:#d6b656
    style CACert fill:#fff2cc,stroke:#d6b656
    style Gap1 fill:#f8cecc,stroke:#b85450
    style Gap2 fill:#f8cecc,stroke:#b85450
    style Gap3 fill:#f8cecc,stroke:#b85450
    style Gap4 fill:#f8cecc,stroke:#b85450
