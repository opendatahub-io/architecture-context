graph TD
    subgraph GatewayRBAC["vllm-orchestrator-gateway RBAC"]
        direction TB

        Note["NOTE: No RBAC Manifests Present"]

        subgraph NoRBAC["Security Posture"]
            NoClusterRole["No ClusterRoles defined"]
            NoRole["No Roles defined"]
            NoRoleBinding["No RoleBindings defined"]
            NoSA["No ServiceAccount definitions"]
            NoK8sAPI["No Kubernetes API access"]
        end

        subgraph AuthModel["Authentication & Authorization Model"]
            direction TB
            GatewayAuth["Gateway Level<br/>Authentication: NONE<br/>Authorization: NONE"]
            PassThrough["Pass-Through Headers<br/>Authorization: forwarded<br/>X-Forwarded-*: forwarded"]
            OrchestratorAuth["Orchestrator Level<br/>Receives forwarded auth headers<br/>Enforces own auth policy"]

            GatewayAuth -->|"forwards headers"| PassThrough
            PassThrough -->|"delegated to"| OrchestratorAuth
        end

        subgraph Secrets["Secrets & Certificates"]
            TLSSecret["TLS Client Cert<br/>Path: /etc/tls/private/tls.crt + tls.key<br/>Type: kubernetes.io/tls<br/>Provisioned: service-serving-cert-signer<br/>Auto-Rotate: Yes"]
            CACert["CA Certificate<br/>Path: /etc/tls/ca/service-ca.crt<br/>Type: ConfigMap (projected)<br/>Provisioned: service-ca-operator<br/>Auto-Rotate: Yes"]
        end

        subgraph SecurityGaps["Security Gaps"]
            Gap1["No NetworkPolicy shipped"]
            Gap2["No auth at gateway level"]
            Gap3["No resource limits defined"]
            Gap4["Streaming: partial content<br/>delivered before detection"]
        end
    end

    style Note fill:#ff6b6b,stroke:#333,color:#fff,font-weight:bold
    style NoClusterRole fill:#ffe0e0,stroke:#cc0000
    style NoRole fill:#ffe0e0,stroke:#cc0000
    style NoRoleBinding fill:#ffe0e0,stroke:#cc0000
    style NoSA fill:#ffe0e0,stroke:#cc0000
    style NoK8sAPI fill:#ffe0e0,stroke:#cc0000
    style GatewayAuth fill:#ffcc80,stroke:#e65100
    style PassThrough fill:#fff9c4,stroke:#f57f17
    style OrchestratorAuth fill:#c8e6c9,stroke:#2e7d32
    style TLSSecret fill:#bbdefb,stroke:#1565c0
    style CACert fill:#bbdefb,stroke:#1565c0
    style Gap1 fill:#ffcdd2,stroke:#c62828
    style Gap2 fill:#ffcdd2,stroke:#c62828
    style Gap3 fill:#ffcdd2,stroke:#c62828
    style Gap4 fill:#ffcdd2,stroke:#c62828
