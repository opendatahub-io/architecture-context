graph LR
    TrainingHub["Training Hub<br/>Python Library + CLI"]

    %% Core Dependencies (Required)
    TrainingHub -->|"SFT backend"| ILabTraining["InstructLab Training<br/>>=0.16.2"]
    TrainingHub -->|"OSFT backend"| MiniTrainer["Mini-Trainer<br/>>=0.8.3"]
    TrainingHub -->|"deep learning"| PyTorch["torch<br/>>=2.6.0"]
    TrainingHub -->|"model loading"| Transformers["transformers<br/>>=4.57.6"]
    TrainingHub -->|"datasets"| HFDatasets["datasets<br/>>=4.0.0"]
    TrainingHub -->|"LoRA adapters"| PEFT["peft<br/>>=0.15"]
    TrainingHub -->|"distributed training"| Accelerate["accelerate<br/>>=0.34.2"]
    TrainingHub -->|"validation"| Pydantic["pydantic<br/>>=2.7.0"]

    %% Optional Dependencies
    TrainingHub -.->|"LoRA backend [lora]"| Unsloth["Unsloth<br/>>=2026.1.1"]
    TrainingHub -.->|"RL training [lora]"| TRL["trl<br/>>=0.18.0"]
    TrainingHub -.->|"single-GPU GRPO [grpo]"| ART["OpenPipe ART<br/>>=0.5.17"]
    TrainingHub -.->|"multi-GPU GRPO [grpo-verl]"| Verl["verl<br/>>=0.7"]
    TrainingHub -.->|"LLM API [grpo,gepa]"| LiteLLM["litellm<br/>>=1.71.1<br/>!=1.82.7-1.82.8"]
    TrainingHub -.->|"prompt optimization [gepa]"| GEPALib["gepa<br/>>=0.1.1"]
    TrainingHub -.->|"experiment tracking [gepa]"| MLflowLib["mlflow<br/>>=3.5.0"]
    TrainingHub -.->|"embedding training [embedding]"| SentTrans["sentence-transformers<br/>>=5.0"]
    TrainingHub -.->|"flash attention [cuda]"| FlashAttn["flash-attn<br/>>=2.8"]
    TrainingHub -.->|"quantization [cuda]"| BitsAndBytes["bitsandbytes<br/>>=0.47.0"]

    %% Platform Integration
    KubeflowSDK["Kubeflow Training SDK"] -->|"progress tracking"| TrainingHub
    ITSHub["ITS Hub"] -.->|"rollout strategies"| TrainingHub

    %% External Services
    TrainingHub -->|"model downloads"| HFHub["HuggingFace Hub"]
    TrainingHub -.->|"GEPA LLM calls"| LLMAPI["OpenAI-compatible API"]
    TrainingHub -.->|"experiment tracking"| WandBSvc["Weights & Biases"]
    TrainingHub -.->|"experiment tracking"| MLflowSvc["MLflow Server"]

    %% Runtime Dependencies
    TrainingHub -->|"inference engine"| vLLM["vLLM<br/>Subprocess"]

