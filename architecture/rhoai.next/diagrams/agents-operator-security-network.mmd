graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AgentPod["AGENT POD (AuthBridge Sidecar Mesh)"]
        direction TB
        AuthProxy["authbridge-proxy<br/>8080/TCP reverse proxy<br/>8081/TCP forward proxy<br/>TLS 1.3, mTLS via SPIFFE"]
        AgentContainer["Agent Container<br/>localhost only"]
        ProxyInit["proxy-init<br/>iptables setup"]

        AuthProxy -->|"localhost<br/>HTTP<br/>validated token"| AgentContainer
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (kagenti-operator-system)"]
        direction TB
        Manager["kagenti-operator<br/>8081/TCP health (HTTP, no auth)<br/>8443/TCP metrics (HTTPS, SAR)<br/>9443/TCP webhooks (HTTPS, cert-mgr)"]
        BundleSvc["bundle-service<br/>8080/TCP HTTP<br/>OPA policy bundles"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount tokens"]
        AdmissionWH["Admission Webhooks<br/>inject.kagenti.io (Mutating)<br/>vagentcard.kb.io (Validating)<br/>vagentruntime.kb.io (Validating)<br/>FailurePolicy: Fail"]
    end

    subgraph PlatformSvcs["PLATFORM SERVICES (Internal)"]
        direction TB
        KeycloakSvc["Keycloak<br/>8080/TCP HTTP/HTTPS<br/>Admin credentials"]
        SPIRESvc["SPIRE / SPIFFE<br/>In-process X509Source<br/>Workload identity"]
        CertMgr["cert-manager<br/>via K8s API<br/>TLS lifecycle"]
        MLflowSvc["MLflow<br/>HTTP/HTTPS<br/>TLS optional CA"]
        TokenBrokerSvc["Token Broker<br/>8080/TCP HTTP<br/>Bearer JWT<br/>In-memory sessions"]
        TektonSvc["Tekton<br/>via K8s API"]
        KuadrantSvc["Kuadrant<br/>via K8s API"]
    end

    %% External to Agent Pod
    Client -->|"HTTP/HTTPS 8080<br/>TLS 1.3 / mTLS<br/>Bearer JWT"| AuthProxy

    %% Agent Pod outbound
    AuthProxy -->|"HTTP/HTTPS<br/>RFC 8693 token exchange<br/>Client credentials"| KeycloakSvc
    AuthProxy -->|"HTTP<br/>per-SPIFFE-ID"| BundleSvc

    %% Operator to K8s API
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% K8s API to Webhooks
    K8sAPI -->|"HTTPS/9443<br/>TLS cert-manager<br/>API server mTLS"| AdmissionWH

    %% Operator to Platform Services
    Manager -->|"HTTP/HTTPS 8080<br/>Admin creds"| KeycloakSvc
    Manager -->|"In-process<br/>X.509 SVID"| SPIRESvc
    Manager -->|"HTTPS/6443<br/>CRD CRUD"| CertMgr
    Manager -->|"HTTP/HTTPS<br/>TLS optional CA"| MLflowSvc
    Manager -->|"HTTPS/6443<br/>CRD Watch+Patch"| TektonSvc
    Manager -->|"HTTPS/6443<br/>CRD Watch+CRUD"| KuadrantSvc

    %% Token Broker flows
    TokenBrokerSvc -->|"HTTP/HTTPS<br/>OAuth2 PKCE"| KeycloakSvc
    AuthProxy -->|"HTTP 8080<br/>Bearer JWT"| TokenBrokerSvc

    %% Manager to Agent Pod (card fetch)
    Manager -->|"HTTP/HTTPS varies<br/>None/mTLS<br/>A2A agent-card.json"| AgentPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef agentpod fill:#e8d5f5,stroke:#8e44ad,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class AuthProxy,AgentContainer,ProxyInit agentpod
    class Manager,BundleSvc operator
    class K8sAPI,AdmissionWH controlplane
    class KeycloakSvc,SPIRESvc,CertMgr,MLflowSvc,TokenBrokerSvc,TektonSvc,KuadrantSvc platform
