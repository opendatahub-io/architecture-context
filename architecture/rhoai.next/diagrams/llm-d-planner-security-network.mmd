graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes — TLS Edge)"]
        RouteUI["Route: planner<br/>443/TCP → 8501/TCP<br/>TLS Edge Termination<br/>No Auth"]
        RouteBackend["Route: planner-backend<br/>443/TCP → 8000/TCP<br/>TLS Edge Termination<br/>No Auth"]
    end

    subgraph AppTier["APPLICATION TIER (Namespace: planner)"]
        direction TB

        subgraph UILayer["Frontend"]
            StreamlitUI["Streamlit UI<br/>ClusterIP: 8501/TCP<br/>HTTP / No Auth<br/>SA: default"]
        end

        subgraph BackendLayer["Backend"]
            BackendAPI["Backend API (FastAPI)<br/>ClusterIP: 8000/TCP<br/>HTTP / No Auth*<br/>SA: planner-backend<br/>CORS: allow_origins=[*] ⚠️"]
        end

        subgraph DataLayer["Data"]
            Postgres["PostgreSQL 16<br/>ClusterIP: 5432/TCP<br/>Password Auth<br/>PVC-backed"]
            Ollama["Ollama<br/>ClusterIP: 11434/TCP<br/>HTTP / No Auth"]
        end

        subgraph DevLayer["Dev/Test Only"]
            Simulator["vLLM Simulator<br/>8080/TCP<br/>HTTP / No Auth"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HF["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer (optional)"]
        ModelCat["RHOAI Model Catalog<br/>model-catalog.svc<br/>8443/TCP HTTPS<br/>TLS 1.2+ (custom CA)<br/>Bearer / SA Token"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>kubeconfig / SA Token"]
        VertexAI["Vertex AI<br/>googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP OAuth2"]
        OpenAI["OpenAI-compatible<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key Bearer"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS Edge<br/>No Auth"| RouteUI
    User -->|"HTTPS/443<br/>TLS Edge<br/>No Auth"| RouteBackend

    %% Ingress → Application
    RouteUI -->|"HTTP/8501<br/>Plaintext (post-TLS)<br/>No Auth"| StreamlitUI
    RouteBackend -->|"HTTP/8000<br/>Plaintext (post-TLS)<br/>No Auth"| BackendAPI

    %% Internal Application flows
    StreamlitUI -->|"HTTP/8000<br/>Plaintext<br/>No Auth"| BackendAPI
    BackendAPI -->|"PostgreSQL/5432<br/>Plaintext<br/>Password"| Postgres
    BackendAPI -->|"HTTP/11434<br/>Plaintext<br/>No Auth"| Ollama

    %% Egress to external services
    BackendAPI -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer (HF_TOKEN)"| HF
    BackendAPI -->|"HTTPS/8443<br/>TLS 1.2+ (custom CA)<br/>Bearer / SA Token"| ModelCat
    BackendAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig / SA"| K8sAPI
    BackendAPI -.->|"HTTPS/443<br/>TLS 1.2+<br/>GCP OAuth2"| VertexAI
    BackendAPI -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Key"| OpenAI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef dev fill:#f0f0f0,stroke:#aaa,stroke-width:1px,stroke-dasharray: 5

    class User external
    class RouteUI,RouteBackend ingress
    class StreamlitUI,BackendAPI app
    class Postgres,Ollama data
    class Simulator dev
    class HF,ModelCat,K8sAPI,VertexAI,OpenAI extservice
