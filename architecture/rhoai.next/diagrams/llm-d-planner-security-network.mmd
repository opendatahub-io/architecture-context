graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - Edge TLS)"]
        RouteUI["Route: planner<br/>443/TCP → 8501/TCP<br/>TLS Edge + Redirect"]
        RouteBackend["Route: planner-backend<br/>443/TCP → 8000/TCP<br/>TLS Edge + Redirect"]
    end

    subgraph Namespace["NAMESPACE: planner"]
        direction TB

        UIService["Streamlit UI<br/>Service: ui (ClusterIP)<br/>8501/TCP HTTP<br/>No Auth"]

        BackendService["FastAPI Backend<br/>Service: backend (ClusterIP)<br/>8000/TCP HTTP<br/>SA: planner-backend<br/>runAsNonRoot, drop ALL caps"]

        OllamaService["Ollama LLM<br/>Service: ollama (ClusterIP)<br/>11434/TCP HTTP<br/>No Auth"]

        SQLiteDB["SQLite DB<br/>PVC: /app/db/planner.db"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS<br/>SA Token Auth"]
        ModelCatalog["RHOAI Model Catalog<br/>8443/TCP HTTPS<br/>TLS (Service CA)<br/>Bearer Token"]
        OpenAIAPI["OpenAI API<br/>443/TCP HTTPS<br/>TLS<br/>API Key"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS<br/>Token (optional)"]
        ArenaAPI["Arena API<br/>443/TCP HTTPS<br/>TLS<br/>No Auth"]
        AAAPI["Artificial Analysis<br/>443/TCP HTTPS<br/>TLS<br/>API Key"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS Edge"| RouteUI
    User -->|"HTTPS/443<br/>TLS Edge"| RouteBackend

    %% Ingress → Services
    RouteUI -->|"HTTP/8501<br/>No Encryption"| UIService
    RouteBackend -->|"HTTP/8000<br/>No Encryption"| BackendService

    %% Internal flows
    UIService -->|"HTTP/8000<br/>No Encryption<br/>No Auth"| BackendService
    BackendService -->|"HTTP/11434<br/>No Encryption<br/>No Auth"| OllamaService
    BackendService -->|"File I/O"| SQLiteDB

    %% Egress
    BackendService -->|"HTTPS/6443<br/>TLS<br/>SA Token"| K8sAPI
    BackendService -->|"HTTPS/8443<br/>TLS Service CA<br/>Bearer Token"| ModelCatalog
    BackendService -->|"HTTPS/443<br/>TLS<br/>API Key"| OpenAIAPI
    BackendService -->|"HTTPS/443<br/>TLS<br/>HF Token"| HFHub
    BackendService -->|"HTTPS/443<br/>TLS"| ArenaAPI
    BackendService -->|"HTTPS/443<br/>TLS<br/>API Key"| AAAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef namespace fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class RouteUI,RouteBackend ingress
    class UIService,BackendService,OllamaService namespace
    class SQLiteDB storage
    class K8sAPI,ModelCatalog,OpenAIAPI,HFHub,ArenaAPI,AAAPI externalservice
