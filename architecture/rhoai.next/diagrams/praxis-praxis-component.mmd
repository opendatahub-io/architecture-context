graph TB
    subgraph Praxis["Praxis Proxy Server"]
        direction TB

        subgraph Server["praxis-proxy (server binary)"]
            Main["main.rs<br/>Entry Point"]
            CLI["CLI Parser<br/>(clap)"]
            ConfigLoader["Config Loader<br/>(YAML)"]
            HotReload["Hot-Reload Watcher<br/>(filesystem)"]
            ServerBootstrap["Server Bootstrap<br/>(Pingora)"]
        end

        subgraph Core["praxis-proxy-core"]
            Config["Configuration<br/>(serde_yaml)"]
            Validation["Config Validation"]
            HealthState["Health State"]
            KVStore["KV Store Registry"]
            ErrorTypes["Error Types"]
        end

        subgraph Filter["praxis-proxy-filter"]
            FilterRegistry["FilterRegistry"]
            FilterPipeline["FilterPipeline<br/>(ArcSwap)"]
            HttpFilters["HTTP Filters"]
            TcpFilters["TCP Filters"]
            ConditionEval["Condition Evaluator"]

            subgraph HTTPFilterCategories["HTTP Filter Categories"]
                Security["Security<br/>(CORS, CSRF, IP ACL,<br/>Basic Auth, Guardrails,<br/>Policy, mTLS Identity)"]
                Traffic["Traffic Mgmt<br/>(Router, Load Balancer,<br/>Rate Limit, Circuit Breaker,<br/>Sticky Sessions)"]
                Transform["Transformation<br/>(Header, Path Rewrite,<br/>URL Rewrite, gRPC Status)"]
                Observability["Observability<br/>(Access Log, Request ID,<br/>Trace Context)"]
                Payload["Payload Processing<br/>(Compression, JSON Body,<br/>gRPC-Web)"]
            end

            subgraph TCPFilterCategories["TCP Filter Categories"]
                TCPObs["TCP Observability<br/>(TCP Access Log)"]
                TCPTraffic["TCP Traffic Mgmt<br/>(SNI Router,<br/>TCP Load Balancer)"]
            end
        end

        subgraph Protocol["praxis-proxy-protocol"]
            HTTPAdapter["HTTP Adapter<br/>(Pingora)"]
            TCPAdapter["TCP Adapter<br/>(Pingora)"]
            HealthProbe["Health Check Probes"]
            AdminAPI["Admin API<br/>(9902/TCP)"]
            MetricsEndpoint["Prometheus Metrics"]
        end

        subgraph TLS["praxis-proxy-tls"]
            CryptoProvider["OpenSSL Crypto Provider<br/>(sole provider)"]
            SNIResolver["SNI Resolution<br/>(wildcard support)"]
            CertLoader["Certificate Loader<br/>(PEM, hot-reload)"]
            FIPSCheck["FIPS Status Checker"]
            TLSConfig["TLS Configuration<br/>(TLS 1.2+ / 1.3)"]
        end
    end

    %% Internal dependency flow
    Main --> CLI
    Main --> ConfigLoader
    Main --> CryptoProvider
    ConfigLoader --> Config
    Config --> Validation
    ServerBootstrap --> FilterRegistry
    FilterRegistry --> FilterPipeline
    FilterPipeline --> HttpFilters
    FilterPipeline --> TcpFilters
    HttpFilters --> Security
    HttpFilters --> Traffic
    HttpFilters --> Transform
    HttpFilters --> Observability
    HttpFilters --> Payload
    TcpFilters --> TCPObs
    TcpFilters --> TCPTraffic
    HotReload -->|atomic swap| FilterPipeline
    HotReload -->|reload certs| CertLoader

    %% External connections
    Client[External Client] -->|8080/TCP<br/>HTTP/HTTPS| HTTPAdapter
    HTTPAdapter --> FilterPipeline
    Monitoring[Monitoring System] -->|9902/TCP<br/>HTTP| AdminAPI
    AdminAPI --> HealthProbe
    AdminAPI --> MetricsEndpoint

    FilterPipeline -->|proxied traffic| Upstream[Upstream Clusters]
    MetricsEndpoint -.->|scrape| Prometheus[Prometheus]

    %% Crate dependency flow annotation
    ServerBootstrap --> HTTPAdapter
    ServerBootstrap --> TCPAdapter
    CryptoProvider --> SNIResolver

    %% Styling
    style Main fill:#4a90e2,color:#fff
    style CryptoProvider fill:#e74c3c,color:#fff
    style FIPSCheck fill:#e74c3c,color:#fff
    style FilterPipeline fill:#f5a623,color:#fff
    style FilterRegistry fill:#f5a623,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style Upstream fill:#e8e8e8,stroke:#333
    style Monitoring fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style Security fill:#e74c3c,color:#fff
    style Traffic fill:#3498db,color:#fff
    style Transform fill:#2ecc71,color:#fff
    style Observability fill:#9b59b6,color:#fff
    style Payload fill:#1abc9c,color:#fff
