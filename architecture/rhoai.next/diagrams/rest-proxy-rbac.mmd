graph TD
    subgraph "rest-proxy RBAC Model"
        direction TB
        Note["rest-proxy defines no RBAC resources.<br/>It runs as a sidecar container and inherits<br/>the ServiceAccount of its parent pod<br/>(ModelMesh Serving)."]
    end

    subgraph "Inherited from Parent Pod"
        SA["ServiceAccount<br/>(ModelMesh Serving SA)"]
    end

    subgraph "Authentication"
        NoAuth["No Authentication<br/>on /v2/models/* endpoints"]
    end

    subgraph "Network Isolation"
        PodLocal["Pod-local communication only<br/>gRPC to localhost:8033"]
        NetworkPolicy["No NetworkPolicy defined<br/>(relies on parent deployment)"]
    end

    SA -.->|"inherited by<br/>sidecar container"| Note
    Note -->|"exposes"| NoAuth
    Note -->|"relies on"| PodLocal
    PodLocal -->|"complemented by"| NetworkPolicy

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style SA fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style NoAuth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style PodLocal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style NetworkPolicy fill:#f8cecc,stroke:#b85450,stroke-width:2px
