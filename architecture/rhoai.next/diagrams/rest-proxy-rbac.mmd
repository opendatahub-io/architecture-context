graph TD
    subgraph RestProxyRBAC["rest-proxy RBAC"]
        direction TB
        NoRBAC["No RBAC Roles or Bindings<br/><br/>rest-proxy does not interact<br/>with the Kubernetes API.<br/><br/>It runs as a sidecar container<br/>within a ModelMesh Serving pod<br/>and inherits the pod's<br/>ServiceAccount context."]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB
        ProxyAuth["rest-proxy Auth: NONE<br/>(transparent proxy)"]
        PlatformAuth["Platform Auth Enforcement"]

        subgraph RHOAI3x["RHOAI 3.x"]
            KubeRBAC["kube-rbac-proxy sidecar<br/>Enforces AuthN/AuthZ"]
        end

        subgraph RHOAI2x["RHOAI 2.x"]
            OAuthProxy["oauth-proxy<br/>Enforces AuthN"]
        end

        subgraph MeshAuth["Service Mesh"]
            mTLS["mTLS enforcement<br/>(if deployed with mesh)"]
        end

        PlatformAuth --> KubeRBAC
        PlatformAuth --> OAuthProxy
        PlatformAuth --> mTLS
    end

    subgraph SecretAccess["Secret Access"]
        TLSSecret["TLS cert/key<br/>MM_TLS_KEY_CERT_PATH<br/>MM_TLS_PRIVATE_KEY_PATH<br/>(mounted volume, shared in pod)"]
    end

    ProxyAuth -->|"no auth enforced"| RestProxyRBAC
    TLSSecret -.->|"read by rest-proxy<br/>for HTTPS listener"| RestProxyRBAC

    style NoRBAC fill:#f0f0f0,stroke:#999,stroke-width:2px
    style ProxyAuth fill:#ffcccc,stroke:#cc0000
    style KubeRBAC fill:#7ed321,stroke:#333,color:#fff
    style OAuthProxy fill:#7ed321,stroke:#333,color:#fff
    style mTLS fill:#7ed321,stroke:#333,color:#fff
    style TLSSecret fill:#fff2cc,stroke:#d6b656
