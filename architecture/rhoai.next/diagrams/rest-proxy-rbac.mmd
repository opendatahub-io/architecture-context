graph TD
    subgraph Component["rest-proxy"]
        Proxy["rest-proxy Sidecar<br/>(No ServiceAccount of its own)"]
    end

    subgraph PodIdentity["Pod-Level Identity"]
        PodSA["ModelMesh Pod<br/>ServiceAccount<br/>(inherited)"]
    end

    subgraph NoRBAC["RBAC Status"]
        Note["No ClusterRoles<br/>No RoleBindings<br/>No API Server Access"]
    end

    subgraph AuthDelegation["Authentication & Authorization<br/>(Delegated - Not Implemented by rest-proxy)"]
        direction TB
        Istio["Istio Service Mesh<br/>PeerAuthentication: mTLS<br/>AuthorizationPolicy: service identity"]
        KubeRBAC["kube-rbac-proxy<br/>(optional sidecar)<br/>Bearer Token validation"]
        Gateway["Platform Gateway / Route<br/>External ingress AuthN"]
    end

    subgraph EnvConfig["Security-Relevant Configuration"]
        TLSServer["Server TLS<br/>MM_TLS_KEY_CERT_PATH<br/>MM_TLS_PRIVATE_KEY_PATH"]
        TLSClient["Upstream gRPC TLS<br/>REST_PROXY_USE_TLS"]
        SkipVerify["Certificate Verification<br/>REST_PROXY_SKIP_VERIFY<br/>⚠ default: false (verify enabled)"]
    end

    Proxy -->|"runs within"| PodSA
    PodSA -->|"no K8s API calls"| NoRBAC
    Istio -->|"enforces mTLS"| Proxy
    KubeRBAC -->|"enforces AuthZ"| Proxy
    Gateway -->|"enforces AuthN"| Proxy
    TLSServer -.->|"configures"| Proxy
    TLSClient -.->|"configures"| Proxy
    SkipVerify -.->|"configures"| Proxy

    style Proxy fill:#4a90e2,stroke:#333,color:#fff
    style PodSA fill:#e8e8e8,stroke:#333
    style Note fill:#f9f9f9,stroke:#999,stroke-dasharray: 5 5
    style Istio fill:#7ed321,stroke:#333,color:#fff
    style KubeRBAC fill:#7ed321,stroke:#333,color:#fff
    style Gateway fill:#7ed321,stroke:#333,color:#fff
    style TLSServer fill:#fff2cc,stroke:#d6b656
    style TLSClient fill:#fff2cc,stroke:#d6b656
    style SkipVerify fill:#ffcccc,stroke:#cc0000
