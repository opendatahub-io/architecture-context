graph LR
    DW["Distributed Workloads<br/>Test Suite + Images"]

    %% Internal RHOAI Dependencies (tested by this repo)
    DW -->|"creates PyTorchJob CRs"| KFTO["KFTO v1<br/>kubeflow.org/v1"]
    DW -->|"creates TrainJob CRs"| TrainerV2["Trainer v2<br/>trainer.kubeflow.org/v1alpha1"]
    DW -->|"creates RayJob CRs"| KubeRay["KubeRay<br/>ray.io/v1"]
    DW -->|"configures queues"| Kueue["Kueue<br/>kueue.x-k8s.io/v1beta2"]
    DW -->|"validates multi-job"| JobSet["JobSet<br/>jobset.x-k8s.io/v1alpha2"]
    DW -->|"verifies deployment"| RHKueueOp["Red Hat Kueue<br/>Operator"]
    DW -->|"reads RELATED_IMAGE"| RHOAIOp["RHOAI Operator"]
    DW -->|"creates notebooks"| Notebooks["Notebooks<br/>kubeflow.org/v1"]
    DW -->|"reads DSC status"| DSC["DataScienceCluster"]
    DW -->|"reads DSCI status"| DSCI["DSCInitialization"]
    DW -->|"queries GPU metrics"| Prometheus["Prometheus<br/>9090/TCP"]

    %% External Build Dependencies
    DW -.->|"base images"| AIPCC["AIPCC Ecosystems<br/>Base Images + PyPI"]
    DW -.->|"build-time pkgs"| PyPI["PyPI (public)"]
    DW -.->|"CUDA wheels"| NVPyPI["NVIDIA PyPI"]
    DW -.->|"IB drivers"| OFED["Mellanox OFED"]

    %% External Runtime Dependencies
    DW -->|"training data/models"| S3["S3 Storage<br/>443/TCP HTTPS"]
    DW -->|"model downloads"| HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]

    %% Platform Dependencies
    DW -->|"cluster operations"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    DW -->|"service exposure"| Routes["OpenShift Routes"]
    DW -->|"GPU node detection"| MachineAPI["Machine API"]
    DW -->|"operator status"| OLM["OLM<br/>operators.coreos.com"]

    %% Framework Dependencies
    DW -.->|"Go 1.25"| Go["Go Runtime"]
    DW -.->|"PyTorch 2.4-2.10"| PyTorch["PyTorch"]
    DW -.->|"CUDA 12.1-13.0"| CUDA["NVIDIA CUDA"]
    DW -.->|"ROCm 6.2-6.4"| ROCm["AMD ROCm"]
    DW -.->|"MPI 4.1.6"| OpenMPI["OpenMPI"]

    %% Components that integrate with DW
    Dashboard["ODH Dashboard"] -.->|"UI for workbenches"| DW
    DSPipelines["Data Science Pipelines"] -.->|"auto deploy"| DW

