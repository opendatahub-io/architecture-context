graph TB
    subgraph CaikitFramework["Caikit Framework"]
        direction TB

        subgraph Core["caikit.core"]
            ModuleSystem["Module System<br/>(task decorators, module registry)"]
            DataModel["Data Model<br/>(dataobject, py_to_proto)"]
            TaskDefs["Task Definitions<br/>(NLP, TS, Vision tasks)"]
            ModelMgmt["Model Management<br/>(loader, saver, backends)"]
            Factory["Factory System<br/>(pluggable backends)"]

            ModuleSystem --> DataModel
            ModuleSystem --> TaskDefs
            ModuleSystem --> ModelMgmt
            ModelMgmt --> Factory
        end

        subgraph Interfaces["caikit.interfaces"]
            NLP["NLP Tasks<br/>(TextGeneration, Classification,<br/>Embedding, Reranking)"]
            TS["Time Series Tasks<br/>(Forecasting)"]
            Vision["Vision Tasks<br/>(Image processing)"]
            CommonDM["Common Data Models<br/>(vectors, streams, remote)"]

            NLP --> CommonDM
            TS --> CommonDM
            Vision --> CommonDM
        end

        subgraph Runtime["caikit.runtime"]
            direction TB
            GRPCServer["gRPC Server<br/>8085/TCP"]
            HTTPServer["HTTP Server (FastAPI)<br/>8080/TCP"]
            Metrics["Prometheus Metrics<br/>8086/TCP"]

            GlobalPredict["GlobalPredictServicer"]
            GlobalTrain["GlobalTrainServicer"]
            InfoServicer["InfoServicer"]
            ModelMgmtSvc["ModelManagementServicer"]
            TrainMgmtSvc["TrainingManagementServicer"]
            ModelRuntimeSvc["ModelRuntimeServicer<br/>(ModelMesh IPC)"]

            RuntimeModelMgr["ModelManager<br/>(model cache, lifecycle)"]
            ServiceGen["Service Generation<br/>(dynamic proto, routes)"]
            Tracing["OpenTelemetry Tracing"]

            GRPCServer --> GlobalPredict
            GRPCServer --> GlobalTrain
            GRPCServer --> InfoServicer
            GRPCServer --> ModelMgmtSvc
            GRPCServer --> TrainMgmtSvc
            HTTPServer --> GlobalPredict
            HTTPServer --> GlobalTrain
            HTTPServer --> InfoServicer
            HTTPServer --> ModelMgmtSvc
            HTTPServer --> TrainMgmtSvc
            GlobalPredict --> RuntimeModelMgr
            GlobalTrain --> RuntimeModelMgr
            ModelRuntimeSvc --> RuntimeModelMgr
            ServiceGen --> GRPCServer
            ServiceGen --> HTTPServer
        end

        subgraph HealthProbe["caikit_health_probe"]
            Probe["Health Probe CLI<br/>(separate process)"]
        end

        Interfaces --> Core
        Runtime --> Core
        Runtime --> Interfaces
        ServiceGen --> ModuleSystem
        ServiceGen --> TaskDefs
    end

    %% External integrations
    Client["Client Application"] -->|"POST /api/v1/task/{task}<br/>HTTP/8080"| HTTPServer
    Client -->|"gRPC Predict/Train<br/>gRPC/8085"| GRPCServer
    Probe -->|"Health.Check<br/>gRPC/8085"| GRPCServer
    Probe -->|"GET /api/v1/health<br/>HTTP/8080"| HTTPServer
    ModelMesh["ModelMesh Controller"] -->|"loadModel/unloadModel<br/>Unix socket"| ModelRuntimeSvc
    OTel["OpenTelemetry Collector"] -.->|"OTLP/4317"| Tracing
    PromScraper["Prometheus Scraper"] -->|"GET /metrics<br/>HTTP/8086"| Metrics
    KServe["KServe<br/>(ServingRuntime)"] -->|"container runtime"| Runtime
    CaikitNLP["caikit-nlp"] -->|"Python import"| Core
    CaikitTGIS["caikit-tgis-serving"] -->|"Python import"| Core

    %% Styling
    style Core fill:#4a90e2,stroke:#333,color:#fff
    style Interfaces fill:#7ed321,stroke:#333,color:#fff
    style Runtime fill:#f5a623,stroke:#333,color:#fff
    style HealthProbe fill:#9b59b6,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style ModelMesh fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style PromScraper fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style CaikitNLP fill:#d5e8d4,stroke:#333
    style CaikitTGIS fill:#d5e8d4,stroke:#333
