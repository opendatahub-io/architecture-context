graph TB
    subgraph External["External Callers"]
        ModelMeshSidecar["ModelMesh Sidecar"]
        KServeProxy["KServe / Platform Proxy"]
        DirectClient["Direct Client"]
    end

    subgraph CaikitRuntime["Caikit Runtime Framework"]
        direction TB

        subgraph ServerLayer["Server Layer"]
            GRPCServer["gRPC Server<br/>8085/TCP<br/>grpcio + HTTP/2"]
            HTTPServer["HTTP Server<br/>8080/TCP<br/>FastAPI + uvicorn"]
            MetricsServer["Prometheus Metrics<br/>8086/TCP"]
        end

        subgraph InterceptionLayer["Request Dispatch"]
            ServerWrapper["CaikitRuntimeServerWrapper<br/>(gRPC interception — reroutes all<br/>dynamic RPCs through single handler)"]
            FastAPIRoutes["FastAPI Route Handlers<br/>(dynamic route registration<br/>per task/module)"]
        end

        subgraph Servicers["Servicers"]
            GlobalPredict["GlobalPredictServicer<br/>Predict / predict_model"]
            GlobalTrain["GlobalTrainServicer<br/>Train / train_model"]
            ModelMgmtSvc["ModelManagementServicer<br/>Deploy / Undeploy"]
            TrainingMgmtSvc["TrainingManagementServicer<br/>GetStatus / Cancel"]
            InfoSvc["InfoServicer<br/>RuntimeInfo / ModelsInfo"]
            ModelRuntimeSvc["ModelRuntimeServicer<br/>(mmesh.ModelRuntime)"]
        end

        subgraph CoreFramework["caikit.core"]
            TaskRegistry["Task Registry<br/>(@task decorator)"]
            ModuleRegistry["Module Registry<br/>(@module decorator)"]
            ModelManager["ModelManager<br/>(load / unload / cache)"]
            DataObjectSystem["DataObject System<br/>(@dataobject → proto)"]
            BackendSystem["Backend System<br/>(LOCAL, TGIS, vLLM)"]
        end

        subgraph ServiceGeneration["Dynamic Service Generation"]
            ServicePackageFactory["ServicePackageFactory<br/>(introspects tasks/modules<br/>→ generates gRPC descriptors<br/>+ HTTP routes at startup)"]
        end

        subgraph Interfaces["caikit.interfaces"]
            NLPTasks["NLP Tasks (11)<br/>TextGeneration, Embedding,<br/>Reranking, Classification, ..."]
            TSTasks["TimeSeries Tasks (4)<br/>Forecasting, Detection, ..."]
            VisionTasks["Vision Tasks"]
        end
    end

    subgraph HealthProbe["caikit_health_probe"]
        Probe["Health Probe CLI<br/>(gRPC + HTTP checks<br/>with TLS/mTLS support)"]
    end

    %% External connections
    ModelMeshSidecar -->|"gRPC / unix socket<br/>mmesh.ModelRuntime"| ModelRuntimeSvc
    KServeProxy -->|"gRPC/8085 or HTTP/8080<br/>TLS/mTLS configurable"| GRPCServer
    KServeProxy -->|"HTTP/8080"| HTTPServer
    DirectClient -->|"gRPC/8085 or HTTP/8080"| GRPCServer
    DirectClient -->|"HTTP/8080"| HTTPServer

    %% Server to dispatch
    GRPCServer --> ServerWrapper
    HTTPServer --> FastAPIRoutes

    %% Dispatch to servicers
    ServerWrapper --> GlobalPredict
    ServerWrapper --> GlobalTrain
    ServerWrapper --> ModelMgmtSvc
    ServerWrapper --> TrainingMgmtSvc
    ServerWrapper --> InfoSvc
    FastAPIRoutes --> GlobalPredict
    FastAPIRoutes --> GlobalTrain
    FastAPIRoutes --> ModelMgmtSvc
    FastAPIRoutes --> TrainingMgmtSvc
    FastAPIRoutes --> InfoSvc

    %% Servicers to core
    GlobalPredict -->|"retrieve + run"| ModelManager
    GlobalTrain -->|"train (async)"| ModelManager
    ModelMgmtSvc -->|"load / unload"| ModelManager
    ModelRuntimeSvc -->|"loadModel / unloadModel"| ModelManager

    %% Core internals
    ModelManager -->|"find model"| BackendSystem
    ServicePackageFactory -->|"introspects"| TaskRegistry
    ServicePackageFactory -->|"introspects"| ModuleRegistry
    ServicePackageFactory -->|"generates"| GRPCServer
    ServicePackageFactory -->|"generates"| HTTPServer
    TaskRegistry -->|"defines"| NLPTasks
    TaskRegistry -->|"defines"| TSTasks
    TaskRegistry -->|"defines"| VisionTasks
    ModuleRegistry -->|"serializes via"| DataObjectSystem

    %% Health probe
    Probe -->|"health check"| GRPCServer
    Probe -->|"health check"| HTTPServer

    %% Metrics
    GlobalPredict -->|"predict_rpc_count"| MetricsServer

    %% Styles
    style GRPCServer fill:#4a90e2,color:#fff
    style HTTPServer fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style GlobalPredict fill:#5bb8a9,color:#fff
    style GlobalTrain fill:#5bb8a9,color:#fff
    style ModelRuntimeSvc fill:#5bb8a9,color:#fff
    style ModelManager fill:#f5a623,color:#fff
    style TaskRegistry fill:#f5a623,color:#fff
    style ModuleRegistry fill:#f5a623,color:#fff
    style ServicePackageFactory fill:#9b59b6,color:#fff
    style ModelMeshSidecar fill:#e8e8e8,stroke:#999
    style KServeProxy fill:#e8e8e8,stroke:#999
    style DirectClient fill:#e8e8e8,stroke:#999
    style Probe fill:#7ed321,color:#fff
