graph TB
    subgraph CaikitFramework["Caikit AI Runtime Framework"]
        direction TB

        subgraph Core["caikit.core"]
            ModuleSystem["Module System<br/>@module decorator<br/>Task registration"]
            DataModel["Data Model<br/>@dataobject decorator<br/>Auto protobuf gen"]
            TaskDefs["Task Definitions<br/>@task decorator<br/>NLP, TS, Vision"]
            ModelMgmt["Model Management<br/>Loader / Saver<br/>Model lifecycle"]
            Backends["Pluggable Backends<br/>LocalBackend<br/>Custom backends"]
            Factory["Factory System<br/>Extensible components"]
        end

        subgraph Interfaces["caikit.interfaces"]
            NLP["NLP Tasks<br/>TextGeneration<br/>Classification<br/>Embeddings<br/>Reranking"]
            TimeSeries["TimeSeries Tasks<br/>Forecasting<br/>DataFrame support"]
            Vision["Vision Tasks<br/>Image processing"]
            RuntimeIF["Runtime Data Models<br/>Info, Management<br/>Training"]
        end

        subgraph Runtime["caikit.runtime"]
            direction TB

            subgraph Servers["Dual-Protocol Servers"]
                GRPCServer["gRPC Server<br/>8085/TCP<br/>TLS/mTLS"]
                HTTPServer["HTTP Server (FastAPI)<br/>8080/TCP<br/>TLS/mTLS<br/>JSON + SSE"]
            end

            subgraph Servicers["Shared Servicers"]
                PredictServicer["GlobalPredictServicer<br/>Inference routing"]
                TrainServicer["GlobalTrainServicer<br/>Training orchestration"]
                InfoServicer["InfoServicer<br/>Models & version info"]
                MgmtServicer["ModelManagementServicer<br/>Deploy/Undeploy"]
                TrainMgmtServicer["TrainingManagementServicer<br/>Status/Cancel"]
            end

            ModelManager["ModelManager<br/>Model loading/caching<br/>Thread-safe registry"]
            ServiceGen["Service Generation<br/>Dynamic proto/route<br/>generation at startup"]
            Metrics["Prometheus Metrics<br/>8086/TCP<br/>RPC meter"]
            Tracing["OpenTelemetry Tracing<br/>OTLP export"]
            Batcher["Request Batcher<br/>Per-model batching"]

            subgraph ModelMeshIPC["ModelMesh Integration"]
                ModelRuntimeSvc["ModelRuntimeServicer<br/>Unix socket gRPC<br/>loadModel/unloadModel"]
            end
        end

        subgraph HealthProbe["caikit_health_probe"]
            Probe["Health Probe CLI<br/>Separate process<br/>gRPC + HTTP checks<br/>psutil liveness"]
        end
    end

    %% Internal relationships
    GRPCServer -->|delegates| PredictServicer
    GRPCServer -->|delegates| TrainServicer
    HTTPServer -->|delegates| PredictServicer
    HTTPServer -->|delegates| TrainServicer
    PredictServicer -->|lookups| ModelManager
    TrainServicer -->|submits| ModelManager
    ModelManager -->|loads| ModuleSystem
    ServiceGen -->|introspects| TaskDefs
    ServiceGen -->|generates| GRPCServer
    ServiceGen -->|generates| HTTPServer
    ModuleSystem -->|uses| DataModel
    ModuleSystem -->|registers| TaskDefs
    ModelRuntimeSvc -->|manages| ModelManager

    %% External connections
    Client[Client Application] -->|gRPC :8085| GRPCServer
    Client -->|HTTP :8080| HTTPServer
    ModelMesh[ModelMesh Controller] -->|Unix socket| ModelRuntimeSvc
    Probe -->|health check| GRPCServer
    Probe -->|health check| HTTPServer
    PromScraper[Prometheus] -->|scrape :8086| Metrics
    OTelCollector[OTel Collector] <-->|traces| Tracing

    %% Downstream consumers
    CaikitNLP[caikit-nlp] -->|imports| ModuleSystem
    CaikitTGIS[caikit-tgis-serving] -->|imports| ModuleSystem
    KServe[KServe ServingRuntime] -->|runs| Runtime

    %% Styling
    style CaikitFramework fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Core fill:#dcedc8,stroke:#689f38,stroke-width:2px
    style Interfaces fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    style Runtime fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    style HealthProbe fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style Servers fill:#e8eaf6,stroke:#3f51b5
    style Servicers fill:#e8eaf6,stroke:#3f51b5
    style ModelMeshIPC fill:#f3e5f5,stroke:#7b1fa2

    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style ModelMesh fill:#f9f9f9,stroke:#999,stroke-width:2px
    style PromScraper fill:#f9f9f9,stroke:#999,stroke-width:2px
    style OTelCollector fill:#f9f9f9,stroke:#999,stroke-width:2px
    style CaikitNLP fill:#c8e6c9,stroke:#388e3c,stroke-width:2px
    style CaikitTGIS fill:#c8e6c9,stroke:#388e3c,stroke-width:2px
    style KServe fill:#c8e6c9,stroke:#388e3c,stroke-width:2px
