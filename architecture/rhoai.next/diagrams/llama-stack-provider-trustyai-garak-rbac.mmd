graph TD
    subgraph "Service Account (provided by eval-hub)"
        SA["eval-hub Job SA<br/>(name configured by operator)"]
    end

    subgraph "RBAC Configuration (by trustyai-service-operator)"
        CR["ClusterRole / Role<br/>(defined externally)"]
        CRB["RoleBinding<br/>(defined externally)"]
    end

    subgraph "Required API Permissions"
        Secrets["core/v1<br/>Secrets"]
        ConfigMaps["core/v1<br/>ConfigMaps"]
    end

    subgraph "Secrets Accessed"
        ModelAuth["model-auth<br/>(Opaque, volume mount)<br/>API keys for: target, SDG,<br/>judge, attacker, evaluator"]
        DataConn["Data Connection<br/>(Opaque, envFrom)<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>AWS_S3_ENDPOINT<br/>AWS_S3_BUCKET"]
    end

    subgraph "Environment Variable Credentials"
        APIKey["API_KEY<br/>Generic API key fallback"]
        KFPAuth["KFP_AUTH_TOKEN<br/>KFP authentication"]
        OAIKey["OPENAICOMPATIBLE_API_KEY<br/>OpenAI-compatible endpoint"]
    end

    subgraph "ConfigMaps Accessed"
        JobSpec["eval-job spec<br/>/etc/eval-job/spec.json<br/>(volume mount)"]
        TrustyAIConfig["trustyai-service-operator-config<br/>(K8s API read)<br/>KFP base image resolution"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"get"| Secrets
    CR -->|"get"| ConfigMaps

    Secrets ---|"provides"| ModelAuth
    Secrets ---|"provides"| DataConn
    ConfigMaps ---|"provides"| TrustyAIConfig
    ConfigMaps ---|"provides"| JobSpec

    SA -.->|"env injection"| APIKey
    SA -.->|"env injection"| KFPAuth
    SA -.->|"env injection"| OAIKey

    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#f5a623,color:#fff
    style Secrets fill:#7ed321,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style ModelAuth fill:#e74c3c,color:#fff
    style DataConn fill:#e74c3c,color:#fff
    style APIKey fill:#9b59b6,color:#fff
    style KFPAuth fill:#9b59b6,color:#fff
    style OAIKey fill:#9b59b6,color:#fff
    style JobSpec fill:#3498db,color:#fff
    style TrustyAIConfig fill:#3498db,color:#fff
