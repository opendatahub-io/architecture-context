graph TD
    subgraph JobTemplate["eval-hub Job Template (Inherited RBAC)"]
        SA["ServiceAccount<br/>(inherited from eval-hub<br/>Job template)"]
    end

    subgraph InheritedPermissions["Expected Inherited Permissions"]
        direction TB
        SecretRead["GET Secrets"]
        ConfigMapRead["GET ConfigMaps"]
    end

    subgraph SecretsAccessed["Secrets Accessed"]
        ModelAuth["model-auth<br/>(Opaque)<br/>api-key, SDG_API_KEY,<br/>JUDGE_API_KEY,<br/>ATTACKER_API_KEY,<br/>EVALUATOR_API_KEY"]
        DataConn["Data Connection Secret<br/>(Opaque)<br/>AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY,<br/>AWS_S3_ENDPOINT,<br/>AWS_S3_BUCKET,<br/>AWS_DEFAULT_REGION"]
        SAToken["SA Token<br/>(kubernetes.io/<br/>service-account-token)<br/>Auto-mounted, Auto-rotated"]
    end

    subgraph ConfigMapsAccessed["ConfigMaps Accessed"]
        TrustyAICM["trustyai-service-<br/>operator-config<br/>Key: garak-provider-image"]
        ODHCM["opendatahub ConfigMap<br/>Key: garak-provider-image"]
        JobSpecCM["JobSpec ConfigMap<br/>/etc/eval-job/spec.json<br/>(mounted by eval-hub)"]
    end

    subgraph Namespaces["Candidate Namespaces"]
        NS1["redhat-ods-applications"]
        NS2["opendatahub"]
    end

    subgraph KFPSecretInjection["KFP Pipeline Secret Injection"]
        KFPEnv["kubernetes.use_secret_as_env<br/>(Data Connection → S3 creds)"]
        KFPVol["kubernetes.use_secret_as_volume<br/>(model-auth, optional=True)"]
    end

    SA -->|expected permission| SecretRead
    SA -->|expected permission| ConfigMapRead
    SecretRead -->|reads| ModelAuth
    SecretRead -->|reads| DataConn
    ConfigMapRead -->|reads| TrustyAICM
    ConfigMapRead -->|reads| ODHCM

    SA -->|auto-mounted| SAToken

    TrustyAICM -->|searched in| NS1
    TrustyAICM -->|searched in| NS2
    ODHCM -->|searched in| NS1
    ODHCM -->|searched in| NS2

    SA -->|KFP pods use| KFPEnv
    SA -->|KFP pods use| KFPVol

    %% Note: No RBAC defined in this repo
    Note["NOTE: No RBAC roles or bindings<br/>are defined in this repository.<br/>All permissions are inherited from<br/>the eval-hub service's Job template."]

