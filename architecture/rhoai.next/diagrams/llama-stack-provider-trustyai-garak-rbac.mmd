graph TD
    subgraph "Service Account (provisioned by eval-hub)"
        SA["SA: eval-hub provisioned<br/>(per-job service account)"]
    end

    subgraph "Required Permissions (not defined by component)"
        direction TB
        Note["⚠ No RBAC roles defined by this component.<br/>Permissions below are REQUIRED and must be<br/>provisioned by the eval-hub service."]
    end

    subgraph "Secret Access Required"
        DataConnSecret["Secret: Data Connection<br/>Type: Opaque<br/>Keys: AWS_ACCESS_KEY_ID,<br/>AWS_SECRET_ACCESS_KEY,<br/>AWS_S3_ENDPOINT,<br/>AWS_S3_BUCKET,<br/>AWS_DEFAULT_REGION"]
        ModelAuthSecret["Secret: model-auth<br/>Type: Opaque<br/>Keys: api-key, SDG_API_KEY,<br/>JUDGE_API_KEY, ATTACKER_API_KEY,<br/>EVALUATOR_API_KEY"]
    end

    subgraph "ConfigMap Access Required"
        JobSpecCM["ConfigMap: JobSpec<br/>Mount: /etc/eval-job/spec.json<br/>Purpose: Evaluation job configuration"]
        OperatorCM["ConfigMap: trustyai-service-<br/>operator-config<br/>Key: garak-provider-image<br/>Purpose: KFP component base image"]
    end

    subgraph "API Access Required"
        K8sSecrets["Kubernetes API<br/>Resource: secrets<br/>Verbs: get"]
        K8sConfigMaps["Kubernetes API<br/>Resource: configmaps<br/>Verbs: get"]
        K8sSAToken["Kubernetes API<br/>Resource: serviceaccounts/token<br/>Verbs: create<br/>(legacy mode only)"]
    end

    %% Relationships
    SA -->|"env vars injection"| DataConnSecret
    SA -->|"volume mount<br/>/mnt/model-auth/"| ModelAuthSecret
    SA -->|"file mount"| JobSpecCM
    SA -->|"API read"| OperatorCM

    SA -->|"requires"| K8sSecrets
    SA -->|"requires"| K8sConfigMaps
    SA -->|"requires (legacy)"| K8sSAToken

    %% Auth model note
    subgraph "Auth Model"
        LegacyMode["Legacy Mode<br/>AutomountServiceAccountToken: true<br/>SA token used for KFP API auth"]
        SidecarMode["Sidecar Mode (evalhub ≥ 0.4.4)<br/>AutomountServiceAccountToken: false<br/>eval-hub sidecar proxies auth<br/>k8s_sa_token:ref placeholder"]
    end

    SA -.->|"either"| LegacyMode
    SA -.->|"or"| SidecarMode

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style DataConnSecret fill:#f8cecc,stroke:#b85450
    style ModelAuthSecret fill:#f8cecc,stroke:#b85450
    style JobSpecCM fill:#d5e8d4,stroke:#82b366
    style OperatorCM fill:#d5e8d4,stroke:#82b366
    style K8sSecrets fill:#dae8fc,stroke:#6c8ebf
    style K8sConfigMaps fill:#dae8fc,stroke:#6c8ebf
    style K8sSAToken fill:#dae8fc,stroke:#6c8ebf
    style LegacyMode fill:#e1d5e7,stroke:#9673a6
    style SidecarMode fill:#e1d5e7,stroke:#9673a6
