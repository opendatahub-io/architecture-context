graph TB
    subgraph MLMDComponent["ML Metadata (MLMD)"]
        direction TB
        Server["metadata_store_server<br/>(C++ gRPC Server)<br/>Port 8080/TCP"]
        Protos["Protobuf Schemas<br/>(API Definition)<br/>metadata_store_service.proto"]
        Protos -.->|defines service interface| Server
    end

    subgraph Clients["Client Libraries"]
        PythonLib["ml_metadata Python Library<br/>(PyPI: ml-metadata)<br/>gRPC client + direct DB mode"]
    end

    subgraph PipelineConsumers["Pipeline Consumers"]
        DSP["Data Science Pipelines<br/>(DSP Controller)"]
        KFP["Kubeflow Pipelines SDK"]
        PipelineUI["Pipeline UI / Dashboard"]
    end

    subgraph DatabaseBackends["Database Backends"]
        MySQL["MySQL / MariaDB<br/>3306/TCP"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        SQLite["SQLite<br/>(Embedded)"]
    end

    %% Client connections
    DSP -->|"gRPC/8080<br/>Optional TLS/mTLS"| Server
    KFP -->|"gRPC/8080<br/>Optional TLS/mTLS"| Server
    PipelineUI -->|"gRPC/8080<br/>Optional TLS/mTLS"| Server
    PythonLib -->|"gRPC/8080<br/>Optional TLS/mTLS"| Server

    %% Database connections
    Server -->|"MySQL protocol<br/>Optional TLS"| MySQL
    Server -->|"PostgreSQL protocol<br/>Optional TLS"| PostgreSQL
    Server -->|"Direct file access"| SQLite

    %% Core data model
    subgraph DataModel["Core Data Model"]
        direction LR
        Artifacts["Artifacts<br/>(datasets, models, metrics)"]
        Executions["Executions<br/>(pipeline steps)"]
        Contexts["Contexts<br/>(groupings)"]
        Events["Events<br/>(Artifact-Execution links)"]
        Artifacts ---|Attribution| Contexts
        Executions ---|Association| Contexts
        Artifacts ---|Events| Executions
    end

    Server -->|"manages"| DataModel

    %% Styling
    style Server fill:#4a90e2,stroke:#333,color:#fff
    style Protos fill:#4a90e2,stroke:#333,color:#fff
    style PythonLib fill:#6cb4ee,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style KFP fill:#7ed321,stroke:#333
    style PipelineUI fill:#7ed321,stroke:#333
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style Artifacts fill:#e8e8e8,stroke:#333
    style Executions fill:#e8e8e8,stroke:#333
    style Contexts fill:#e8e8e8,stroke:#333
    style Events fill:#e8e8e8,stroke:#333
