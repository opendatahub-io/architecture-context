graph TB
    subgraph "ML Metadata Component"
        direction TB
        Server["metadata_store_server<br/>(C++ gRPC Service)<br/>Port 8080/TCP"]
        PythonLib["ml_metadata Python Library<br/>(Client Library)"]
    end

    subgraph "Clients"
        KFPipelines["Kubeflow Pipelines SDK"]
        PipelineUI["Pipeline UI<br/>(Data Science Pipelines)"]
    end

    subgraph "Storage Backends"
        MySQL["MySQL / MariaDB<br/>3306/TCP"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        SQLite["SQLite<br/>(Embedded, dev/test)"]
    end

    subgraph "Deployer"
        DSPOperator["Data Science Pipelines<br/>Operator"]
    end

    %% Client connections
    KFPipelines -->|"gRPC/8080<br/>Optional TLS"| Server
    PipelineUI -->|"gRPC/8080<br/>Optional TLS"| Server
    KFPipelines -.->|"uses library"| PythonLib

    %% Server to storage
    Server -->|"MySQL protocol<br/>Optional SSL"| MySQL
    Server -->|"PostgreSQL protocol<br/>Optional SSL"| PostgreSQL
    Server -->|"File-based"| SQLite

    %% Operator manages server
    DSPOperator -->|"deploys &<br/>configures"| Server

    %% Styling
    style Server fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style PythonLib fill:#4a90e2,stroke:#333,color:#fff
    style KFPipelines fill:#7ed321,stroke:#333,color:#fff
    style PipelineUI fill:#7ed321,stroke:#333,color:#fff
    style MySQL fill:#f5a623,stroke:#333,color:#fff
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style SQLite fill:#f5a623,stroke:#333,color:#fff
    style DSPOperator fill:#9b59b6,stroke:#333,color:#fff
