graph TB
    subgraph "ML Metadata (MLMD) Component"
        direction TB
        Server["metadata_store_server<br/>(C++ gRPC Service)<br/>Port 8080/TCP"]
        ProtoDefinitions["Proto Definitions<br/>(Protocol Buffers)<br/>Artifact, Execution, Context, Event"]
        ProtoDefinitions -->|defines API| Server
    end

    subgraph "Python Client Library"
        direction TB
        PythonClient["ml_metadata<br/>(Python SDK)<br/>MetadataStore class"]
        PywrapExt["pywrap Extension<br/>(pybind11 C++ Extension)<br/>Direct DB access"]
        PythonClient -->|direct DB mode| PywrapExt
        PythonClient -->|gRPC mode| Server
    end

    subgraph "Consumers"
        KFP["Kubeflow Pipelines SDK"]
        DSP["Data Science Pipelines"]
        KFPUI["Kubeflow Pipelines UI"]
        TFX["TFX (TensorFlow Extended)"]
    end

    KFP -->|"gRPC/8080<br/>records metadata"| Server
    DSP -->|"gRPC/8080<br/>records metadata"| Server
    KFPUI -->|"gRPC/8080<br/>queries lineage"| Server
    TFX -->|"gRPC/8080<br/>records metadata"| Server

    subgraph "Storage Backends"
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        MySQL["MySQL/MariaDB<br/>3306/TCP"]
        SQLite["SQLite<br/>(Embedded)"]
    end

    Server -->|"PostgreSQL wire protocol<br/>Optional TLS"| PostgreSQL
    Server -->|"MySQL wire protocol<br/>Optional TLS"| MySQL
    Server -->|"Direct file access"| SQLite
    PywrapExt -->|"Direct DB connection"| PostgreSQL
    PywrapExt -->|"Direct DB connection"| MySQL
    PywrapExt -->|"Direct file access"| SQLite

    DSPOperator["Data Science Pipelines Operator"] -.->|"deploys & manages"| Server

    style Server fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ProtoDefinitions fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style PythonClient fill:#6c5ce7,stroke:#333,stroke-width:2px,color:#fff
    style PywrapExt fill:#6c5ce7,stroke:#333,stroke-width:2px,color:#fff
    style KFP fill:#7ed321,stroke:#333
    style DSP fill:#7ed321,stroke:#333
    style KFPUI fill:#7ed321,stroke:#333
    style TFX fill:#7ed321,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style MySQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style DSPOperator fill:#e8e8e8,stroke:#333
