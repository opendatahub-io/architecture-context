graph TB
    subgraph TrainingHub["Training Hub Library"]
        direction TB
        Registry["AlgorithmRegistry<br/>Strategy + Registry Pattern"]
        CLI["thub CLI<br/>YAML Config Support"]
        Callbacks["TrainingHubCallback<br/>Cross-backend Lifecycle Hooks"]

        CLI -->|selects algorithm| Registry
        Registry -->|lifecycle events| Callbacks
    end

    subgraph Algorithms["Algorithms"]
        direction TB
        SFT["SFT<br/>sft()"]
        OSFT["OSFT<br/>osft()"]
        LoRASFT["LoRA SFT<br/>lora_sft()"]
        LoRAGRPO["LoRA GRPO<br/>lora_grpo()"]
        GRPO["GRPO<br/>grpo()"]
        GEPA["GEPA<br/>gepa()"]
        EmbSFT["Embedding SFT<br/>embedding_sft()"]
    end

    subgraph Backends["Backends"]
        direction TB
        ILabTraining["InstructLab Training"]
        MiniTrainer["Mini-Trainer"]
        Unsloth["Unsloth"]
        ART["OpenPipe ART<br/>Single-GPU"]
        Verl["verl<br/>Multi-GPU FSDP"]
        GEPALib["GEPA Library"]
        MLflow["MLflow Backend"]
        SentTrans["SentenceTransformers"]
    end

    Registry -->|dispatches| Algorithms

    SFT -->|backend| ILabTraining
    OSFT -->|backend| MiniTrainer
    LoRASFT -->|backend| Unsloth
    LoRAGRPO -->|backend| ART
    LoRAGRPO -->|backend| Verl
    GRPO -->|backend| Verl
    GEPA -->|backend| GEPALib
    GEPA -->|backend| MLflow
    EmbSFT -->|backend| SentTrans

    User["User / Kubeflow Pipeline"] -->|Python API / CLI| TrainingHub
    Plugin["Claude Code / Codex Plugin"] -->|guided setup| TrainingHub

    subgraph External["External Services"]
        HFHub["HuggingFace Hub"]
        LLMAPI["OpenAI-compatible API"]
        WandB["Weights & Biases"]
        MLflowSvc["MLflow Server"]
    end

    Backends -->|model downloads| HFHub
    GEPALib -->|LLM calls| LLMAPI
    Backends -.->|experiment tracking| WandB
    Backends -.->|experiment tracking| MLflowSvc

    style Registry fill:#4a90e2,color:#fff
    style CLI fill:#4a90e2,color:#fff
    style Callbacks fill:#4a90e2,color:#fff
    style SFT fill:#7ed321,color:#fff
