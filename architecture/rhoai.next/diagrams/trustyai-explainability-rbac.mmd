graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["trustyai-serviceaccount<br/>(per-namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["trustyai-clusterrolebinding<br/>⚠ cluster-wide scope"]
    end

    subgraph ClusterRoles["ClusterRole"]
        CR["trustyai-role"]
    end

    subgraph APIResources["API Resources"]
        ConfigMaps["core (v1)<br/>ConfigMaps"]
    end

    subgraph Verbs["Permitted Verbs"]
        Create["create"]
        Delete["delete"]
        Get["get"]
        List["list"]
        Patch["patch"]
        Update["update"]
        Watch["watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"allows"| ConfigMaps

    ConfigMaps --- Create
    ConfigMaps --- Delete
    ConfigMaps --- Get
    ConfigMaps --- List
    ConfigMaps --- Patch
    ConfigMaps --- Update
    ConfigMaps --- Watch

    subgraph AuthDelegation["Authentication Delegation"]
        direction LR
        NoAppAuth["⚠ No in-app authentication<br/>No @RolesAllowed, no JWT,<br/>no API keys in application code"]
        KubeRBAC["kube-rbac-proxy sidecar<br/>(deployed by operator)"]
        ServiceMesh["Service Mesh policies<br/>(alternative enforcement)"]
    end

    subgraph SecretsAccess["Secrets (mounted, not via RBAC)"]
        TLSSecret["TLS Certificate<br/>kubernetes.io/tls<br/>/etc/tls/internal/<br/>Provisioned by operator"]
        DBSecret["Database Credentials<br/>Opaque<br/>QUARKUS_DATASOURCE_USERNAME<br/>QUARKUS_DATASOURCE_PASSWORD"]
        MinIOSecret["MinIO Credentials<br/>Opaque<br/>storage.minio.access-key<br/>storage.minio.secret-key"]
    end

    SA -.->|"mounts"| TLSSecret
    SA -.->|"env vars from"| DBSecret
    SA -.->|"env vars from"| MinIOSecret

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff

    style Create fill:#dae8fc,stroke:#6c8ebf
    style Delete fill:#f8cecc,stroke:#b85450
    style Get fill:#dae8fc,stroke:#6c8ebf
    style List fill:#dae8fc,stroke:#6c8ebf
    style Patch fill:#ffe6cc,stroke:#d79b00
    style Update fill:#ffe6cc,stroke:#d79b00
    style Watch fill:#dae8fc,stroke:#6c8ebf

    style NoAppAuth fill:#f8cecc,stroke:#b85450,color:#333
    style KubeRBAC fill:#d5e8d4,stroke:#82b366,color:#333
    style ServiceMesh fill:#d5e8d4,stroke:#82b366,color:#333

    style TLSSecret fill:#e1d5e7,stroke:#9673a6,color:#333
    style DBSecret fill:#e1d5e7,stroke:#9673a6,color:#333
    style MinIOSecret fill:#e1d5e7,stroke:#9673a6,color:#333
