graph TD
    subgraph "Service Account"
        SA["trustyai-serviceaccount<br/>(per namespace)"]
    end

    subgraph "ClusterRole Binding"
        CRB["trustyai-clusterrolebinding<br/>Scope: cluster-wide"]
    end

    subgraph "ClusterRole"
        CR["trustyai-role"]
    end

    subgraph "API Resources"
        ConfigMaps["Core API Group (\"\")<br/>configmaps"]
    end

    subgraph "Permitted Verbs"
        direction LR
        Create["create"]
        Delete["delete"]
        Get["get"]
        List["list"]
        Patch["patch"]
        Update["update"]
        Watch["watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"on resource"| ConfigMaps
    ConfigMaps --- Create
    ConfigMaps --- Delete
    ConfigMaps --- Get
    ConfigMaps --- List
    ConfigMaps --- Patch
    ConfigMaps --- Update
    ConfigMaps --- Watch

    subgraph "Authentication & Authorization"
        direction TB
        NoAuth["Service Endpoints (8080/TCP)<br/>No built-in auth"]
        ExternalAuth["Production Auth Enforcement<br/>kube-rbac-proxy or oauth-proxy sidecar<br/>(injected by TrustyAI Operator)"]
        TLSPort["TLS Port (4443/TCP)<br/>TLS termination only<br/>(when certs mounted)"]
        SSRFGuard["SSRF Prevention<br/>LocalServiceURLValidator<br/>Restricts explainability targets<br/>to local K8s service names only"]
    end

    subgraph "Secrets"
        direction TB
        TLSSecret["TLS cert/key<br/>/etc/tls/internal/<br/>Type: kubernetes.io/tls<br/>Provisioned by: Operator / cert-manager"]
        DBSecret["Database credentials<br/>QUARKUS_DATASOURCE_USERNAME<br/>QUARKUS_DATASOURCE_PASSWORD<br/>Type: Opaque<br/>Provisioned by: Operator"]
    end

    style SA fill:#4a90e2,color:#fff
    style CRB fill:#9b59b6,color:#fff
    style CR fill:#f5a623,color:#fff
    style ConfigMaps fill:#7ed321
    style Create fill:#e8f5e9,stroke:#82b366
    style Delete fill:#fce4ec,stroke:#e57373
    style Get fill:#e8f5e9,stroke:#82b366
    style List fill:#e8f5e9,stroke:#82b366
    style Patch fill:#fff3e0,stroke:#ffb74d
    style Update fill:#fff3e0,stroke:#ffb74d
    style Watch fill:#e8f5e9,stroke:#82b366
    style NoAuth fill:#fce4ec,stroke:#e57373
    style ExternalAuth fill:#e8f5e9,stroke:#82b366
    style TLSPort fill:#e3f2fd,stroke:#64b5f6
    style SSRFGuard fill:#e8f5e9,stroke:#82b366
    style TLSSecret fill:#fff3e0,stroke:#ffb74d
    style DBSecret fill:#fff3e0,stroke:#ffb74d
