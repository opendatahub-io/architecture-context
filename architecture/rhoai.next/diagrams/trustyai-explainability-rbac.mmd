graph TD
    subgraph ServiceAccount["Service Account"]
        SA["trustyai-serviceaccount"]
    end

    subgraph ClusterRoleBinding["Cluster Role Binding"]
        CRB["trustyai-clusterrolebinding<br/>(Cluster-scoped)"]
    end

    subgraph ClusterRoleBlock["Cluster Role"]
        CR["trustyai-role<br/>(ClusterRole)"]
    end

    subgraph Permissions["Granted Permissions"]
        ConfigMaps["API Group: core<br/>Resource: configmaps"]
    end

    subgraph Verbs["Allowed Verbs"]
        Create["create"]
        Delete["delete"]
        Get["get"]
        List["list"]
        Patch["patch"]
        Update["update"]
        Watch["watch"]
    end

    subgraph Warning["⚠ Security Note"]
        Note["ClusterRole grants ConfigMap access<br/>across ALL namespaces.<br/>Broader than needed for<br/>namespace-scoped operation."]
    end

    subgraph AuthEndpoints["Endpoint Authentication"]
        NoAuth["All REST endpoints<br/>No application-level auth<br/>Relies on external proxy<br/>(kube-rbac-proxy / OAuth)"]
        MetricsAuth["/q/metrics<br/>Bearer token<br/>(ServiceAccount token via ServiceMonitor)"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"applies to"| ConfigMaps
    ConfigMaps --> Create
    ConfigMaps --> Delete
    ConfigMaps --> Get
    ConfigMaps --> List
    ConfigMaps --> Patch
    ConfigMaps --> Update
    ConfigMaps --> Watch

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#9b59b6,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Note fill:#f8cecc,stroke:#b85450
    style NoAuth fill:#ffe6cc,stroke:#d79b00
    style MetricsAuth fill:#d5e8d4,stroke:#82b366
