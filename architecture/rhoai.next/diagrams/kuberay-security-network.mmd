graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway — DMZ)"]
        Gateway["Platform Gateway<br/>(data-science-gateway)<br/>443/TCP → 8443/TCP<br/>TLS 1.2+ (terminated)<br/>HTTPRoute: /ray/{ns}/{cluster}/"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (NetworkPolicy enforced)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            direction TB
            KRBP["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS TLS<br/>Auth: OIDC SubjectAccessReview<br/>Policy: GET on head-svc"]
            Dashboard["Ray Dashboard<br/>8265/TCP HTTP<br/>(loopback, no auth)"]
            HeadPod["Ray Head Pod<br/>SA: {cluster}-autoscaler-sa<br/>Ports: 10001, 6379, 8265, 8080, 8000"]
            ServeSvc["{cluster}-serve-svc<br/>8000/TCP HTTP"]
            WorkerPods["Ray Worker Pods<br/>{cluster}-headless-workers<br/>NetworkPolicy: cluster-only ingress"]
        end

        subgraph NS_Operator["Namespace: opendatahub (APPLICATION_NAMESPACE)"]
            Operator["KubeRay Operator<br/>SA: kuberay-operator"]
            MetricsSvc["kuberay-operator Service<br/>8080/TCP Metrics<br/>TLS (OpenShift profile)"]
            WebhookSvc["kuberay-webhook-service<br/>443→9443/TCP HTTPS<br/>TLS (serving-cert)"]
            HealthProbe["Health Probes<br/>8082/TCP HTTP"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: ServiceAccount token"]
        CertManager["cert-manager API<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: ServiceAccount token"]
        OpenShiftAPI["OpenShift API<br/>(config.openshift.io)<br/>443/TCP HTTPS TLS 1.2+<br/>Auth: ServiceAccount token"]
        Prometheus["Prometheus<br/>Scrapes 8080/TCP<br/>TLS (OpenShift profile)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        Redis["Redis (GCS FT)<br/>6379/TCP<br/>Encryption: Configurable<br/>Auth: Password (optional)"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>No auth at GW"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>OIDC token (SAR)"| KRBP
    KRBP -->|"HTTP/8265<br/>Loopback<br/>No auth"| Dashboard

    %% Operator flows
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| CertManager
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| OpenShiftAPI
    Operator -->|"HTTP/8265<br/>No encryption<br/>No auth"| Dashboard

    %% Intra-cluster flows
    HeadPod -->|"gRPC (Ray RPC)<br/>mTLS or plaintext<br/>Client cert (if mTLS)"| WorkerPods
    HeadPod -->|"TCP/6379<br/>Configurable"| Redis

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>TLS (OpenShift profile)"| MetricsSvc

    %% Webhook
    K8sAPI -->|"HTTPS/443→9443<br/>Mutual TLS<br/>Admission control"| WebhookSvc

    %% Serve traffic
    Client -->|"HTTPS/443<br/>TLS (GW-terminated)"| ServeSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authproxy fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class KRBP authproxy
    class Dashboard,HeadPod,WorkerPods,ServeSvc,Operator,MetricsSvc,WebhookSvc,HealthProbe internal
    class K8sAPI,CertManager,OpenShiftAPI,Prometheus platform
    class Redis externalservice
