graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Platform Gateway<br/>443/TCP<br/>TLS 1.2+ (OpenShift profile)<br/>HTTPRoute routing"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER"]
        RBACProxy["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>TLS 1.2+<br/>TokenReview + SubjectAccessReview"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB
        Operator["kuberay-operator<br/>SA: kuberay-operator<br/>SCC: run-as-ray-user (UID 1000)"]
        MetricsSvc["kuberay-operator Service<br/>8080/TCP ClusterIP<br/>TLS 1.2+ (OpenShift profile)"]
        WebhookSvc["kuberay-webhook-service<br/>443/TCP → 9443/TCP<br/>TLS (serving cert)"]
        HealthProbe["Health Probes<br/>8082/TCP plaintext<br/>healthz / readyz"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACE ({user-namespace})"]
        direction TB

        subgraph HeadPodGroup["Ray Head Pod"]
            HeadPod["Ray Head<br/>SA: {cluster}-head-sa"]
            DashboardPort["Dashboard: 8265/TCP<br/>plaintext or mTLS"]
            GCSPort["GCS: 10001/TCP<br/>plaintext or mTLS"]
            RedisPort["Redis/GCS: 6379/TCP<br/>plaintext or mTLS"]
            ServePort["Serve: 8000/TCP<br/>plaintext"]
        end

        WorkerPods["Ray Worker Pods<br/>10001/TCP, 8080/TCP<br/>plaintext or mTLS"]
        HeadSvc["{cluster}-head-svc<br/>ClusterIP<br/>10001, 8265, 6379, 8080, 8000"]
        ServeSvc["{cluster}-serve-svc<br/>ClusterIP 8000/TCP<br/>plaintext"]
        HeadlessService["{cluster}-headless<br/>Headless (ClusterIP=None)<br/>Worker DNS discovery"]

        NetPolHead["NetworkPolicy: head<br/>Restricts head pod ingress"]
        NetPolWorker["NetworkPolicy: worker<br/>Restricts worker pod ingress"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token auth"]
        CertManager["cert-manager<br/>CRD: Issuer, Certificate<br/>90-day cert, 15-day renewal"]
        OSAPIServer["OpenShift APIServer CR<br/>HTTPS TLS 1.2+<br/>TLS security profile"]
        OSOAuth["OpenShift OAuth/Auth CR<br/>HTTPS TLS 1.2+<br/>Auth mode detection"]
        Prometheus["Prometheus<br/>8080/TCP scrape<br/>TLS 1.2+"]
    end

    subgraph BatchSchedulers["BATCH SCHEDULERS (Optional)"]
        Volcano["Volcano<br/>CRD: PodGroup"]
        Yunikorn["Yunikorn<br/>Annotations"]
        Kai["Kai-scheduler<br/>CRD"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer/Session"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS 1.2+<br/>Forwarded token"| RBACProxy
    RBACProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>TokenReview"| K8sAPI
    RBACProxy -->|"HTTP/8265<br/>plaintext<br/>(post-auth)"| DashboardPort

    %% Operator flows
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Operator -->|"HTTP/8265<br/>plaintext or mTLS<br/>Bearer (x-ray-authorization)"| DashboardPort
    Operator -->|"HTTP/8000<br/>plaintext<br/>Health: /-/healthz"| ServePort
    Operator -->|"CRD create<br/>SA Token"| CertManager
    Operator -->|"HTTPS read<br/>TLS 1.2+"| OSAPIServer
    Operator -->|"HTTPS read<br/>TLS 1.2+"| OSOAuth

    %% Webhook flow
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (serving cert)<br/>API server client cert"| WebhookSvc

    %% Internal Ray cluster flows
    HeadPod -->|"TCP/10001, 6379<br/>plaintext or mTLS<br/>(cert-manager certs)"| WorkerPods
    WorkerPods -->|"TCP/10001, 6379<br/>plaintext or mTLS"| HeadPod

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>TLS 1.2+<br/>Scrape"| MetricsSvc

    %% Batch scheduling
    Operator -.->|"CRD/Annotations"| Volcano
    Operator -.->|"CRD/Annotations"| Yunikorn
    Operator -.->|"CRD"| Kai

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authLayer fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operatorNS fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workloadNS fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterSvc fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef netpol fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class Gateway ingress
    class RBACProxy authLayer
    class Operator,MetricsSvc,WebhookSvc,HealthProbe operatorNS
    class HeadPod,DashboardPort,GCSPort,RedisPort,ServePort,WorkerPods,HeadSvc,ServeSvc,HeadlessService workloadNS
    class K8sAPI,CertManager,OSAPIServer,OSOAuth,Prometheus clusterSvc
    class NetPolHead,NetPolWorker netpol
