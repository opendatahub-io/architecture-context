graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph IngressZone["INGRESS (DMZ)"]
        Route["OpenShift Route / Gateway HTTPRoute<br/>443/TCP<br/>TLS edge termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph NS_Operator["Namespace: redhat-ods-applications"]
            OperatorDeploy["kuberay-operator Deployment<br/>SA: kuberay-operator<br/>Image: odh-kuberay-operator-controller"]
            WebhookSvc["kuberay-webhook-service<br/>443/TCP -> 9443/TCP<br/>TLS (cert-manager)"]
            MetricsSvc["kuberay-operator Service<br/>8080/TCP HTTP<br/>Metrics"]
        end

        subgraph NS_User["Namespace: user-namespace"]
            HeadPod["Ray Head Pod<br/>8265/TCP Dashboard<br/>+ mTLS certs"]
            RBACProxy["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS<br/>OIDC Auth"]
            WorkerPods["Ray Worker Pods<br/>mTLS certs"]
            NetPolicy["NetworkPolicy<br/>(per-cluster isolation)"]
        end

        KubeAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRDs<br/>TLS 1.2+"]
        Prometheus["Prometheus<br/>Metrics scrape<br/>8080/TCP HTTP"]
        OSConfig["OpenShift APIServer Config<br/>TLS Profile<br/>6443/TCP HTTPS"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>Bearer token / kubeconfig"| KubeAPI
    User -->|"HTTPS/443<br/>TLS edge termination"| Route

    %% Dashboard auth flow
    Route -->|"HTTPS/8443<br/>TLS<br/>OIDC Bearer token"| RBACProxy
    RBACProxy -->|"HTTPS/6443<br/>TokenReview + SAR<br/>SA token"| KubeAPI
    RBACProxy -->|"HTTP/8265<br/>localhost<br/>No auth"| HeadPod

    %% Operator flows
    OperatorDeploy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>All resource CRUD"| KubeAPI
    OperatorDeploy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Cert/Issuer CRUD"| CertManager
    OperatorDeploy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>TLS profile read"| OSConfig

    %% Webhook flow
    KubeAPI -->|"HTTPS/443->9443<br/>TLS (cert-manager cert)<br/>Admission review"| WebhookSvc

    %% Prometheus scrape
    Prometheus -->|"HTTP/8080<br/>No encryption<br/>No auth"| MetricsSvc

    %% mTLS between Ray nodes
    HeadPod <-->|"mTLS<br/>cert-manager certs<br/>(ca-secret hierarchy)"| WorkerPods

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef clusterinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef security fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class Route ingress
    class OperatorDeploy,WebhookSvc,MetricsSvc,HeadPod,WorkerPods,KubeAPI clusterinternal
    class RBACProxy,NetPolicy security
    class CertManager,Prometheus,OSConfig platform
