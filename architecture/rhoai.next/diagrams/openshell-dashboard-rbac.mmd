graph TD
    subgraph "Authentication Flow"
        Browser["Browser Client"]
        AuthProxy["Auth Proxy<br/>(oauth2-proxy / kube-auth-proxy)"]
        OIDC["OIDC IdP<br/>(Keycloak / Dex)"]
    end

    subgraph "BFF Token Relay (No K8s RBAC)"
        BFF["Go BFF Server"]
        AuthMW["Auth Middleware"]
        TokenRelay["Token Relay Logic<br/>1. x-forwarded-access-token header<br/>2. Authorization: Bearer header<br/>3. 401 Unauthorized"]
    end

    subgraph "Gateway Authorization (All RBAC Decisions)"
        Gateway["OpenShell Gateway"]
        JWTValidation["JWT Validation<br/>(OIDC JWKS)"]
        WorkspaceRBAC["Workspace RBAC<br/>(per-workspace membership)"]
    end

    subgraph "Feature Flags (BFF-side gating)"
        FeatureFlags["Feature Flags<br/>(env vars → /api/v1/auth/config)"]
        FF1["FEATURE_TERMINAL"]
        FF2["FEATURE_FILE_TRANSFER"]
        FF3["FEATURE_SETTINGS"]
        FF4["FEATURE_GLOBAL_POLICY"]
        FF5["FEATURE_CREDENTIAL_REFRESH"]
        FF6["FEATURE_SERVICES"]
        FF7["FEATURE_DRAFT_POLICY"]
    end

    subgraph "Protected Resources (Gateway-enforced)"
        Workspaces["Workspaces"]
        Sandboxes["Sandboxes"]
        Providers["Inference Providers"]
        Policies["Security Policies"]
        Templates["Sandbox Templates"]
    end

    %% Auth flow
    Browser -->|"OIDC session cookie"| AuthProxy
    AuthProxy -->|"OIDC/OAuth2 flows"| OIDC
    AuthProxy -->|"Injects x-forwarded-access-token"| BFF

    %% BFF relay
    BFF --> AuthMW
    AuthMW --> TokenRelay
    TokenRelay -->|"Bearer token forwarded"| Gateway

    %% Gateway auth
    Gateway --> JWTValidation
    JWTValidation -->|"Validates against"| OIDC
    Gateway --> WorkspaceRBAC

    %% Resource access
    WorkspaceRBAC -->|"enforces access"| Workspaces
    WorkspaceRBAC -->|"enforces access"| Sandboxes
    WorkspaceRBAC -->|"enforces access"| Providers
    WorkspaceRBAC -->|"enforces access"| Policies
    WorkspaceRBAC -->|"enforces access"| Templates

    %% Feature flags
    FeatureFlags --> FF1
    FeatureFlags --> FF2
    FeatureFlags --> FF3
    FeatureFlags --> FF4
    FeatureFlags --> FF5
    FeatureFlags --> FF6
    FeatureFlags --> FF7

    %% Styling
    style Browser fill:#f9f9f9,stroke:#999
    style AuthProxy fill:#ffe6cc,stroke:#d79b00
    style OIDC fill:#e1d5e7,stroke:#9673a6
    style BFF fill:#4a90e2,stroke:#333,color:#fff
    style AuthMW fill:#4a90e2,stroke:#333,color:#fff
    style TokenRelay fill:#4a90e2,stroke:#333,color:#fff
    style Gateway fill:#7ed321,stroke:#333
    style JWTValidation fill:#7ed321,stroke:#333
    style WorkspaceRBAC fill:#7ed321,stroke:#333
    style FeatureFlags fill:#f5a623,stroke:#333
    style Workspaces fill:#dae8fc,stroke:#6c8ebf
    style Sandboxes fill:#dae8fc,stroke:#6c8ebf
    style Providers fill:#dae8fc,stroke:#6c8ebf
    style Policies fill:#dae8fc,stroke:#6c8ebf
    style Templates fill:#dae8fc,stroke:#6c8ebf
