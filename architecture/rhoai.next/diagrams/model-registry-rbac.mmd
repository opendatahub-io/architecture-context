graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["controller-manager<br/>(system namespace)"]
        SA_UI["model-registry-ui<br/>(model-registry namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["model-registry-manager-rolebinding<br/>(cluster-scoped)"]
        CRB_Metrics_Auth["metrics-auth-rolebinding<br/>(cluster-scoped)"]
        CRB_UI_Services["model-registry-ui-services-reader-binding<br/>(cluster-scoped)"]
        CRB_UI_CRB["model-registry-retrieve-clusterrolebindings-binding<br/>(cluster-scoped)"]
        CRB_UI_SAR["model-registry-create-sars-binding<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(system namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["model-registry-manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_UIServices["model-registry-ui-services-reader"]
        CR_UICRB["model-registry-retrieve-clusterrolebindings"]
        CR_UISAR["model-registry-create-sars"]
    end

    subgraph Roles["Namespace Roles"]
        R_Leader["leader-election-role<br/>(system namespace)"]
    end

    subgraph APIResources_Controller["Controller API Resources"]
        Res_Services["core / services<br/>get, list, watch"]
        Res_InferenceServices["serving.kserve.io<br/>inferenceservices<br/>get, list, patch, update, watch"]
        Res_ISFinalizers["serving.kserve.io<br/>inferenceservices/finalizers<br/>create, delete, get, list,<br/>patch, update, watch"]
        Res_TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        Res_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        Res_Metrics["/metrics<br/>(non-resource URL)<br/>get"]
    end

    subgraph APIResources_Leader["Leader Election Resources"]
        Res_ConfigMaps["core / configmaps<br/>get, list, watch, create,<br/>update, patch, delete"]
        Res_Leases["coordination.k8s.io / leases<br/>get, list, watch, create,<br/>update, patch, delete"]
        Res_Events["core / events<br/>create, patch"]
    end

    subgraph APIResources_UI["UI API Resources"]
        Res_UIServices["core / services<br/>get, list, watch"]
        Res_UICRB["rbac.authorization.k8s.io<br/>clusterrolebindings<br/>get, list, watch"]
        Res_UISAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    %% Controller bindings
    SA_Controller -->|bound via| CRB_Manager
    SA_Controller -->|bound via| CRB_Metrics_Auth
    SA_Controller -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics_Auth -->|grants| CR_MetricsAuth

    RB_Leader -->|grants| R_Leader

    %% Controller permissions
    CR_Manager -->|"get, list, watch"| Res_Services
    CR_Manager -->|"get, list, patch, update, watch"| Res_InferenceServices
    CR_Manager -->|"create, delete, get, list, patch, update, watch"| Res_ISFinalizers
    CR_MetricsAuth -->|create| Res_TokenReviews
    CR_MetricsAuth -->|create| Res_SAR
    CR_MetricsReader -.->|get| Res_Metrics

    %% Leader election permissions
    R_Leader -->|"get, list, watch, create, update, patch, delete"| Res_ConfigMaps
    R_Leader -->|"get, list, watch, create, update, patch, delete"| Res_Leases
    R_Leader -->|"create, patch"| Res_Events

    %% UI bindings
    SA_UI -->|bound via| CRB_UI_Services
    SA_UI -->|bound via| CRB_UI_CRB
    SA_UI -->|bound via| CRB_UI_SAR

    CRB_UI_Services -->|grants| CR_UIServices
    CRB_UI_CRB -->|grants| CR_UICRB
    CRB_UI_SAR -->|grants| CR_UISAR

    %% UI permissions
    CR_UIServices -->|"get, list, watch"| Res_UIServices
    CR_UICRB -->|"get, list, watch"| Res_UICRB
    CR_UISAR -->|create| Res_UISAR

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style SA_UI fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style CR_MetricsReader fill:#f5a623,color:#fff
    style CR_UIServices fill:#f5a623,color:#fff
    style CR_UICRB fill:#f5a623,color:#fff
    style CR_UISAR fill:#f5a623,color:#fff
    style R_Leader fill:#e67e22,color:#fff
    style CRB_Manager fill:#ddd,stroke:#333
    style CRB_Metrics_Auth fill:#ddd,stroke:#333
    style CRB_UI_Services fill:#ddd,stroke:#333
    style CRB_UI_CRB fill:#ddd,stroke:#333
    style CRB_UI_SAR fill:#ddd,stroke:#333
    style RB_Leader fill:#ddd,stroke:#333
    style Res_Services fill:#7ed321,color:#fff
    style Res_InferenceServices fill:#7ed321,color:#fff
    style Res_ISFinalizers fill:#7ed321,color:#fff
    style Res_TokenReviews fill:#7ed321,color:#fff
    style Res_SAR fill:#7ed321,color:#fff
    style Res_Metrics fill:#7ed321,color:#fff
    style Res_ConfigMaps fill:#7ed321,color:#fff
    style Res_Leases fill:#7ed321,color:#fff
    style Res_Events fill:#7ed321,color:#fff
    style Res_UIServices fill:#7ed321,color:#fff
    style Res_UICRB fill:#7ed321,color:#fff
    style Res_UISAR fill:#7ed321,color:#fff
