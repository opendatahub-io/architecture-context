graph TD
    subgraph ServiceAccounts["Service Accounts"]
        ControllerSA["controller-manager<br/>(system namespace)"]
        BFFSA["model-registry-ui<br/>(component namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        ManagerCRB["model-registry-manager-rolebinding<br/>(cluster-scoped)"]
        MetricsAuthCRB["metrics-auth-rolebinding<br/>(cluster-scoped)"]
        MetricsReaderCRB["metrics-reader-binding<br/>(cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings (namespaced)"]
        LeaderElectionRB["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        ManagerCR["model-registry-manager-role"]
        MetricsAuthCR["metrics-auth-role"]
        MetricsReaderCR["metrics-reader"]
    end

    subgraph Roles["Roles (namespaced)"]
        LeaderElectionRole["leader-election-role"]
    end

    subgraph APIResources["API Resources"]
        CoreServices["core/v1<br/>Services"]
        InferenceServices["serving.kserve.io<br/>InferenceService"]
        ISFinalizers["serving.kserve.io<br/>InferenceService/finalizers"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SubjectAccessReviews["authorization.k8s.io<br/>SubjectAccessReviews"]
        ConfigMaps["core/v1<br/>ConfigMaps"]
        Leases["coordination.k8s.io<br/>Leases"]
        Events["core/v1<br/>Events"]
    end

    subgraph NonResourceURLs["Non-Resource URLs"]
        MetricsURL["/metrics"]
    end

    %% SA to Binding
    ControllerSA -->|"bound via"| ManagerCRB
    ControllerSA -->|"bound via"| MetricsAuthCRB
    ControllerSA -->|"bound via"| MetricsReaderCRB
    ControllerSA -->|"bound via"| LeaderElectionRB

    %% Binding to Role
    ManagerCRB -->|"grants"| ManagerCR
    MetricsAuthCRB -->|"grants"| MetricsAuthCR
    MetricsReaderCRB -->|"grants"| MetricsReaderCR
    LeaderElectionRB -->|"grants"| LeaderElectionRole

    %% Role to Resources
    ManagerCR -->|"get, list, watch"| CoreServices
    ManagerCR -->|"get, list, patch,<br/>update, watch"| InferenceServices
    ManagerCR -->|"get, list, watch, create,<br/>update, patch, delete"| ISFinalizers
    MetricsAuthCR -->|"create"| TokenReviews
    MetricsAuthCR -->|"create"| SubjectAccessReviews
    MetricsReaderCR -->|"get"| MetricsURL
    LeaderElectionRole -->|"get, list, watch, create,<br/>update, patch, delete"| ConfigMaps
    LeaderElectionRole -->|"get, list, watch, create,<br/>update, patch, delete"| Leases
    LeaderElectionRole -->|"create, patch"| Events

    %% BFF RBAC (delegated)
    BFFSA -->|"SelfSubjectAccessReview<br/>(per-request K8s RBAC)"| SubjectAccessReviews

    %% Styling
    style ControllerSA fill:#4a90e2,color:#fff
    style BFFSA fill:#4a90e2,color:#fff
    style ManagerCR fill:#f5a623,color:#fff
    style MetricsAuthCR fill:#f5a623,color:#fff
    style MetricsReaderCR fill:#f5a623,color:#fff
    style LeaderElectionRole fill:#e67e22,color:#fff
    style ManagerCRB fill:#95a5a6,color:#fff
    style MetricsAuthCRB fill:#95a5a6,color:#fff
    style MetricsReaderCRB fill:#95a5a6,color:#fff
    style LeaderElectionRB fill:#95a5a6,color:#fff
    style CoreServices fill:#7ed321,color:#fff
    style InferenceServices fill:#7ed321,color:#fff
    style ISFinalizers fill:#7ed321,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SubjectAccessReviews fill:#7ed321,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style Leases fill:#7ed321,color:#fff
    style Events fill:#7ed321,color:#fff
    style MetricsURL fill:#7ed321,color:#fff
