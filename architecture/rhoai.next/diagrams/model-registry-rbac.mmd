graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_MR["model-registry<br/>(core API server)"]
        SA_UI["model-registry-ui<br/>(BFF)"]
        SA_Ctrl["controller-manager<br/>(ISVC controller)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_UIReader["model-registry-ui-<br/>services-reader-binding"]
        CRB_UIRetrieve["model-registry-retrieve-<br/>clusterrolebindings-binding"]
        CRB_UISars["model-registry-<br/>create-sars-binding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace)"]
        RB_LeaderElection["leader-election-<br/>rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-<br/>manager-role"]
        CR_UIReader["model-registry-ui-<br/>services-reader"]
        CR_Retrieve["model-registry-retrieve-<br/>clusterrolebindings"]
        CR_Sars["model-registry-<br/>create-sars"]
    end

    subgraph Roles["Roles (Namespace)"]
        R_LeaderElection["leader-election-role"]
    end

    subgraph APIResources["API Resources"]
        subgraph CoreAPI["Core API ('')"]
            Res_Services["services"]
            Res_ConfigMaps["configmaps"]
            Res_Events["events"]
        end

        subgraph KServeAPI["serving.kserve.io"]
            Res_ISVC["inferenceservices"]
            Res_ISVCFin["inferenceservices/<br/>finalizers"]
        end

        subgraph RBACAPI["rbac.authorization.k8s.io"]
            Res_CRB["clusterrolebindings"]
        end

        subgraph AuthzAPI["authorization.k8s.io"]
            Res_SAR["subjectaccessreviews"]
        end

        subgraph CoordAPI["coordination.k8s.io"]
            Res_Leases["leases"]
        end
    end

    %% Controller manager bindings
    SA_Ctrl -->|"bound via"| CRB_Manager
    CRB_Manager -->|"grants"| CR_Manager
    CR_Manager -->|"get, list, watch"| Res_Services
    CR_Manager -->|"get, list, patch,<br/>update, watch"| Res_ISVC
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| Res_ISVCFin

    %% Controller leader election
    SA_Ctrl -->|"bound via"| RB_LeaderElection
    RB_LeaderElection -->|"grants"| R_LeaderElection
    R_LeaderElection -->|"get, list, watch, create,<br/>update, patch, delete"| Res_ConfigMaps
    R_LeaderElection -->|"get, list, watch, create,<br/>update, patch, delete"| Res_Leases
    R_LeaderElection -->|"create, patch"| Res_Events

    %% UI BFF bindings
    SA_UI -->|"bound via"| CRB_UIReader
    CRB_UIReader -->|"grants"| CR_UIReader
    CR_UIReader -->|"get, list, watch"| Res_Services

    SA_UI -->|"bound via"| CRB_UIRetrieve
    CRB_UIRetrieve -->|"grants"| CR_Retrieve
    CR_Retrieve -->|"get, list, watch"| Res_CRB

    SA_UI -->|"bound via"| CRB_UISars
    CRB_UISars -->|"grants"| CR_Sars
    CR_Sars -->|"create"| Res_SAR

    %% Styling
    style SA_MR fill:#4a90e2,stroke:#333,color:#fff
    style SA_UI fill:#4a90e2,stroke:#333,color:#fff
    style SA_Ctrl fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#333
    style CR_UIReader fill:#f5a623,stroke:#333,color:#333
    style CR_Retrieve fill:#f5a623,stroke:#333,color:#333
    style CR_Sars fill:#f5a623,stroke:#333,color:#333
    style R_LeaderElection fill:#f5a623,stroke:#333,color:#333
    style CRB_Manager fill:#e8e8e8,stroke:#333
    style CRB_UIReader fill:#e8e8e8,stroke:#333
    style CRB_UIRetrieve fill:#e8e8e8,stroke:#333
    style CRB_UISars fill:#e8e8e8,stroke:#333
    style RB_LeaderElection fill:#e8e8e8,stroke:#333
    style Res_Services fill:#7ed321,stroke:#333
    style Res_ConfigMaps fill:#7ed321,stroke:#333
    style Res_Events fill:#7ed321,stroke:#333
    style Res_ISVC fill:#7ed321,stroke:#333
    style Res_ISVCFin fill:#7ed321,stroke:#333
    style Res_CRB fill:#7ed321,stroke:#333
    style Res_SAR fill:#7ed321,stroke:#333
    style Res_Leases fill:#7ed321,stroke:#333
