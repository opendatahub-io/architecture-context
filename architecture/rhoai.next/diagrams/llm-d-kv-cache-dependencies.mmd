graph LR
    KVCache["llm-d-kv-cache<br/>Go Library / Service"]

    %% Internal Platform Dependencies
    KVCache -->|"library consumer<br/>(embeds kvcache)"| Router["llm-d-router"]
    KVCache -->|"ZMQ PUB/SUB<br/>5557/TCP"| vLLM["vLLM / SGLang<br/>Model Servers"]

    %% External Service Dependencies
    KVCache -->|"block index backend<br/>TCP 6379"| Redis["Redis / Valkey"]
    KVCache -->|"Pod discovery<br/>HTTPS 6443"| K8sAPI["Kubernetes API"]
    KVCache -->|"trace export<br/>gRPC 4317"| OTel["OpenTelemetry<br/>Collector"]
    KVCache -->|"tokenizer models<br/>HTTPS 443"| HFHub["HuggingFace Hub"]

    %% Build / Language Dependencies
    KVCache -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.21.0"]
    KVCache -->|"Redis client"| GoRedis["go-redis/v9<br/>v9.20.0"]
    KVCache -->|"ZMQ bindings"| ZMQ4["go-zeromq/zmq4<br/>v0.17.0"]
    KVCache -->|"gRPC framework"| GRPC["google.golang.org/grpc<br/>v1.81.1"]
    KVCache -->|"tracing SDK"| OTelSDK["OpenTelemetry SDK<br/>v1.44.0"]
    KVCache -->|"metrics client"| Prometheus["prometheus/client_golang<br/>v1.23.2"]
    KVCache -->|"CBOR encoding"| CBOR["fxamacker/cbor/v2<br/>v2.9.2"]
    KVCache -->|"msgpack decoding"| MsgPack["vmihailenco/msgpack/v5<br/>v5.4.1"]
    KVCache -->|"LRU cache"| LRU["hashicorp/golang-lru/v2<br/>v2.0.7"]
    KVCache -->|"concurrent cache"| Ristretto["dgraph-io/ristretto/v2<br/>v2.4.0"]
    KVCache -.->|"Python tokenization<br/>CPU wheel"| vLLMPython["vLLM 0.19.1<br/>UDS Tokenizer dep"]

    %% Reverse dependencies (consumers)
    Dashboard["ODH Dashboard"] -.->|"potential UI"| KVCache
    Pipelines["Data Science Pipelines"] -.->|"potential integration"| KVCache

