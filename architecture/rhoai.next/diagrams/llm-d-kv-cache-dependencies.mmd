graph LR
    KVCache["llm-d-kv-cache<br/>KV-Cache Indexer &<br/>Management System"]

    %% External Dependencies
    KVCache -->|"ZMQ PUB/SUB<br/>event streaming"| ZeroMQ["ZeroMQ (libzmq) 4.x"]
    KVCache -->|"persistent index<br/>Redis protocol 6379/TCP"| Redis["Redis / Valkey 6.x+"]
    KVCache -->|"tokenization engine<br/>OpenAIServingRender"| vLLMLib["vLLM 0.18.0+rhaiv.4"]
    KVCache -->|"AutoTokenizer<br/>model loading"| HFTransformers["HuggingFace<br/>transformers >=4.57.0"]
    KVCache -->|"distributed tracing<br/>OTLP exporter 4317/TCP"| OTel["OpenTelemetry 1.44.0"]
    KVCache -->|"metrics exposure<br/>8080/TCP"| PromClient["Prometheus client 1.23.2"]
    KVCache -->|"service communication<br/>50051/TCP + UDS"| gRPC["gRPC<br/>Go 1.81.1 / Python 1.78.0+"]
    KVCache -.->|"object store backend<br/>(optional)"| NIXL["NIXL (latest)"]

    %% Internal Platform Dependencies
    vLLMPods["vLLM Inference Pods"] -->|"ZMQ PUB/SUB 5557/TCP<br/>KVEvents source"| KVCache
    Router["llm-d-router<br/>(Scheduler)"] -->|"Go library import<br/>kvcache.Indexer"| KVCache
