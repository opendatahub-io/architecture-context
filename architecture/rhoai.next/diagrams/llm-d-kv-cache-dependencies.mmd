    KvCache -.->|"GPU→S3 transfers<br/>NIXL"| NIXL["NIXL<br/>Optional"]
    KvCache -.->|"trace export<br/>4317/TCP gRPC"| OTel["OpenTelemetry Collector<br/>Optional"]
    KvCache -.->|"metrics scrape<br/>HTTP"| Prometheus["Prometheus<br/>Optional"]

    %% Internal Platform Dependencies
    EPP["llm-d-router (EPP)"] -->|"embeds Indexer<br/>library call"| KvCache
    vLLMPods["vLLM Model Server Pods"] -->|"ZMQ PUB/SUB<br/>5557/TCP msgpack"| KvCache
    SGLangPods["SGLang Model Server Pods"] -->|"ZMQ PUB/SUB<br/>5557/TCP msgpack"| KvCache

    %% Integration Points (consumers)
    KvCache -->|"pod discovery<br/>443/TCP HTTPS mTLS"| K8sAPI["Kubernetes API Server"]
    KvCache -->|"block offloading<br/>443/TCP HTTPS"| S3["S3 / Object Store"]
    KvCache -->|"block storage<br/>POSIX I/O"| SharedFS["Shared Filesystem<br/>NFS / PVC"]

