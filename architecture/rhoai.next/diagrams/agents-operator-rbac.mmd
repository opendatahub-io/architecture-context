graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(kagenti-system)"]
        SA_Agent["agent workload SA<br/>({agent-namespace})"]
        SA_OTEL["otel-collector SA<br/>({agent-namespace})"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(cluster-wide)"]
        CRB_LeaderElect["leader-election-rolebinding<br/>(kagenti-system)"]
    end

    subgraph RoleBindings["Per-Namespace Role Bindings"]
        RB_MLflow["kagenti-mlflow-{name}<br/>({agent-namespace})"]
        RB_SCC["system:openshift:scc:kagenti-authbridge<br/>({agent-namespace})"]
        RB_OTEL["kagenti-otel-{ns}<br/>({agent-namespace})"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_LeaderElect["leader-election-role"]
    end

    subgraph PerNSRoles["Per-Namespace Roles"]
        Role_MLflow["kagenti-mlflow-{name} Role<br/>(scoped to single experiment)"]
        Role_SCC["SCC: kagenti-authbridge<br/>(NET_ADMIN for proxy-init)"]
        CR_MLflowInt["mlflow-operator-mlflow-integration<br/>(ClusterRole, bind only)"]
    end

    %% Bindings
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_LeaderElect
    SA_Agent -->|bound via| RB_MLflow
    SA_Agent -->|bound via| RB_SCC
    SA_OTEL -->|bound via| RB_OTEL

    CRB_Manager -->|grants| CR_Manager
    CRB_LeaderElect -->|grants| CR_LeaderElect
    RB_MLflow -->|grants| Role_MLflow
    RB_SCC -->|grants| Role_SCC
    RB_OTEL -->|grants| CR_MLflowInt

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>ConfigMaps, Secrets<br/>CRUD+W"]
        Namespaces["core<br/>Namespaces<br/>create,get,list,patch,watch"]
        Pods["core<br/>Pods<br/>get,list,patch,update,watch"]
        SvcAccounts["core<br/>ServiceAccounts, Services<br/>create,get,list,update,watch"]
        Events["core, events.k8s.io<br/>Events<br/>create,patch"]
    end

    subgraph KagentiResources["agent.kagenti.dev Resources"]
        AgentCards["AgentCards<br/>full CRUD+W + finalizers + status"]
        AgentRuntimes["AgentRuntimes<br/>full CRUD+W + finalizers + status"]
        AuthPolicies["AuthorizationPolicies<br/>(via bundle-service watch)"]
    end

    subgraph K8sSIGResources["agents.x-k8s.io Resources"]
        Sandboxes["Sandboxes<br/>get,list,patch,update,watch<br/>+ finalizers + scale"]
    end

    subgraph AppsResources["apps API Resources"]
        Deployments["Deployments, DaemonSets<br/>get,list,patch,update,watch"]
        StatefulSets["StatefulSets<br/>create,get,list,patch,update,watch<br/>+ finalizers"]
    end

    subgraph CertManagerResources["cert-manager.io Resources"]
        Certs["Certificates, Issuers<br/>full CRUD+W"]
        ClusterIssuers["ClusterIssuers<br/>get,list,watch"]
    end

    subgraph PlatformResources["Platform API Resources"]
        DSClusters["DataScienceClusters<br/>get,list,watch"]
        KeycloakCRDs["Keycloaks, KeycloakRealmImports<br/>create,get,list,patch,update"]
        KuadrantCRDs["Kuadrants<br/>create,get,list,patch,update,watch"]
        MLflowCRDs["MLflows, Experiments<br/>various"]
        TektonCRDs["TektonConfigs<br/>get,list,patch,watch"]
        SPIRECRDs["SPIRE CRDs<br/>(5 types)<br/>create,get,list,update,watch"]
    end

    subgraph NetworkResources["Network Resources"]
        NetworkPolicies["NetworkPolicies<br/>full CRUD+W"]
        Ingresses["Ingresses<br/>get,list"]
        Routes["Routes<br/>create,get,list,update"]
        Networks["Networks (OVN)<br/>get"]
    end

    subgraph RBACResources["RBAC Resources"]
        CRoles["ClusterRoles<br/>get, bind (mlflow-operator-*)"]
        RBindings["RoleBindings<br/>CRUD+W"]
        Roles["Roles<br/>create,get,list,update,watch"]
    end

    %% ClusterRole to resources
    CR_Manager -->|manages| ConfigMaps
    CR_Manager -->|manages| Namespaces
    CR_Manager -->|manages| Pods
    CR_Manager -->|manages| SvcAccounts
    CR_Manager -->|manages| Events
    CR_Manager -->|manages| AgentCards
    CR_Manager -->|manages| AgentRuntimes
    CR_Manager -->|manages| Sandboxes
    CR_Manager -->|manages| Deployments
    CR_Manager -->|manages| StatefulSets
    CR_Manager -->|manages| Certs
    CR_Manager -->|manages| ClusterIssuers
    CR_Manager -->|manages| DSClusters
    CR_Manager -->|manages| KeycloakCRDs
    CR_Manager -->|manages| KuadrantCRDs
    CR_Manager -->|manages| MLflowCRDs
    CR_Manager -->|manages| TektonCRDs
    CR_Manager -->|manages| SPIRECRDs
    CR_Manager -->|manages| NetworkPolicies
    CR_Manager -->|manages| Ingresses
    CR_Manager -->|manages| Routes
    CR_Manager -->|manages| Networks
    CR_Manager -->|manages| CRoles
    CR_Manager -->|manages| RBindings
    CR_Manager -->|manages| Roles

