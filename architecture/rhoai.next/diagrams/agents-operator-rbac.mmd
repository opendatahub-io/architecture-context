    CR_Manager -->|"create,get,list,update,watch"| SvcAccounts
    CR_Manager -->|"create,get,list,update,watch"| Services
    CR_Manager -->|"get"| Endpoints
    CR_Manager -->|"create,patch"| Events
    CR_Manager -->|"full CRUD"| AgentCards
    CR_Manager -->|"full CRUD"| AgentRuntimes
    CR_Manager -->|"get,list,patch,update,watch"| Sandboxes
    CR_Manager -->|"CRUD"| Certificates
    CR_Manager -->|"get,list,watch"| ClusterIssuers
    CR_Manager -->|"create,get,list,patch,update"| KeycloakRes
    CR_Manager -->|"CRUD + watch"| KuadrantRes
    CR_Manager -->|"get,list,update,watch"| MLflowExp
    CR_Manager -->|"create,get,list,update,watch"| MLflowRes
    CR_Manager -->|"get,list,watch"| DSCRes
    CR_Manager -->|"get,list,patch,update,watch"| Deployments
    CR_Manager -->|"CRUD + watch"| StatefulSets
    CR_Manager -->|"full CRUD"| NetworkPolicies
    CR_Manager -->|"get,list"| Ingresses
    CR_Manager -->|"create,get,list,update,watch"| SPIRERes
    CR_Manager -->|"get,list,patch,watch"| TektonRes
    CR_Manager -->|"create,get,list,update"| RoutesRes
    CR_Manager -->|"CRUD"| RBACRes

    %% Metrics roles
    CR_MetricsAuth -->|"create"| TokenReviews
    CR_MetricsAuth -->|"create"| SAR
    CR_MetricsReader -->|"get"| MetricsURL

