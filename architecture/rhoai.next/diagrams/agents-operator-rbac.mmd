    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["kagenti-operator-<br/>manager-rolebinding"]
        CRB2["kagenti-operator-<br/>mlflow-integration-binding"]
        CRB3["kagenti-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (kagenti-operator-system)"]
        RB1["kagenti-operator-<br/>leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["kagenti-operator-manager-role"]
