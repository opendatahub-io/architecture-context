    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style SA_Agent fill:#4a90e2,stroke:#333,color:#fff
    style SA_OTEL fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_LeaderElect fill:#f5a623,stroke:#333,color:#fff
    style Role_MLflow fill:#f5a623,stroke:#333,color:#fff
    style Role_SCC fill:#f5a623,stroke:#333,color:#fff
    style CR_MLflowInt fill:#f5a623,stroke:#333,color:#fff
