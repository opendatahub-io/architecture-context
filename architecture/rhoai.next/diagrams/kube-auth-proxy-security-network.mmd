graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
        APIClient["API Client / MLflow SDK"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>443/TCP external<br/>TLS edge/reencrypt"]
    end

    subgraph Application["APPLICATION (kube-auth-proxy Pod)"]
        direction TB
        Proxy["kube-auth-proxy<br/>4180/TCP<br/>TLS 1.2+ configurable<br/>Auth: OIDC, OAuth, TokenReview,<br/>JWT, htpasswd"]
        Metrics["Metrics Server<br/>Prometheus /metrics"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        OAuthServer["OpenShift OAuth Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth2 client credentials"]
        Redis["Redis / Valkey<br/>configured/TCP<br/>TLS optional<br/>Password optional"]
    end

    subgraph UpstreamZone["UPSTREAM (Same Pod)"]
        Upstream["Upstream Application<br/>configured/TCP HTTP<br/>No encryption<br/>GAP-Auth headers"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ExtOIDC["External OIDC Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>OAuth2 client credentials"]
    end

    subgraph EnvoyZone["ENVOY (Gateway API Ingress)"]
        Envoy["Envoy Proxy<br/>ext_authz subrequest"]
    end

    %% External flows
    Browser -->|"HTTPS/443<br/>TLS edge<br/>Cookie / None"| Route
    APIClient -->|"HTTPS/443<br/>TLS edge<br/>Bearer token"| Route
    Route -->|"HTTP(S)/4180<br/>Session cookie / Bearer"| Proxy

    %% Envoy ext_authz
    Envoy -->|"HTTP/4180<br/>/oauth2/auth<br/>Forwarded cookie/Bearer"| Proxy

    %% Cluster service flows
    Proxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Proxy -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2 credentials"| OAuthServer
    Proxy -.->|"TCP/configured<br/>TLS optional<br/>Password"| Redis
    Proxy -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth2 credentials"| ExtOIDC

    %% Upstream
    Proxy -->|"HTTP/configured<br/>No encryption<br/>GAP-Auth headers"| Upstream

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef clusterservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef upstream fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef envoy fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Browser,APIClient external
    class Route ingress
    class Proxy,Metrics application
    class K8sAPI,OAuthServer,Redis clusterservice
    class Upstream upstream
    class ExtOIDC externalservice
    class Envoy envoy
