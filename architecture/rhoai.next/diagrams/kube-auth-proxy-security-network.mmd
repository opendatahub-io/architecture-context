graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / External Client"]
    end

    subgraph ProxyLayer["PROXY LAYER (Authentication Boundary)"]
        direction TB
        KAP["kube-auth-proxy<br/>HTTP: 4180/TCP | HTTPS: 8443/TCP<br/>TLS 1.2+ (configurable ciphers)<br/>FIPS: strictfipsruntime"]

        subgraph AuthMethods["Authentication Methods"]
            OIDC_Auth["OIDC Flow"]
            OS_Auth["OpenShift OAuth"]
            K8s_Auth["K8s TokenReview"]
            Basic_Auth["htpasswd Basic"]
            Bearer_Auth["Bearer Token (JWT/OAuth)"]
        end

        subgraph SessionBackends["Session Storage"]
            CookieSess["Cookie<br/>(CFB/GCM encrypted,<br/>LZ4 compressed)"]
            RedisSess["Redis<br/>(Standalone/Sentinel/Cluster)"]
        end
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Pod-to-Pod)"]
        Envoy["Envoy Proxy<br/>(RHOAI 3.x Gateway)<br/>ext_authz integration"]
        K8sPod["K8s Pod<br/>(ServiceAccount token)"]
        Upstream["Upstream Application<br/>Configurable port<br/>HTTP/HTTPS (optional TLS)"]
        Prometheus["Prometheus<br/>Metrics scrape"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        OIDCProvider["OIDC Provider<br/>(Keycloak, Dex)<br/>443/TCP HTTPS TLS 1.2+<br/>Client creds + Bearer"]
        OSAuthServer["OpenShift OAuth Server<br/>443/TCP HTTPS TLS 1.2+<br/>Client creds + auth code"]
        OSUserAPI["OpenShift User API<br/>443/TCP HTTPS TLS 1.2+<br/>Bearer access token"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS TLS 1.2+<br/>SA Bearer token<br/>(TokenReview)"]
        Redis["Redis (optional)<br/>6379/TCP or 26379/TCP<br/>Optional TLS<br/>Password / ACL"]
    end

    %% Ingress flows
    Browser -->|"HTTP/HTTPS<br/>4180 or 8443/TCP<br/>TLS 1.2+<br/>Cookie / Bearer / None"| KAP
    Envoy -->|"ext_authz<br/>4180 or 8443/TCP<br/>HTTP/HTTPS<br/>Forwarded cookie/Bearer<br/>Response: 202 or 401"| KAP
    K8sPod -->|"HTTP/HTTPS<br/>4180 or 8443/TCP<br/>Bearer SA token"| KAP
    Prometheus -->|"HTTP/HTTPS<br/>Configurable port<br/>No auth"| KAP

    %% Internal auth flows
    KAP --- AuthMethods
    KAP --- SessionBackends

    %% Egress flows
    OIDC_Auth -->|"HTTPS/443<br/>TLS 1.2+<br/>Client creds"| OIDCProvider
    OS_Auth -->|"HTTPS/443<br/>TLS 1.2+<br/>Client creds"| OSAuthServer
    OS_Auth -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token"| OSUserAPI
    K8s_Auth -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer"| K8sAPI
    RedisSess -->|"TCP/TLS<br/>6379/TCP<br/>Password/ACL"| Redis

    %% Upstream flow
    KAP -->|"HTTP/HTTPS<br/>Configurable<br/>Optional TLS<br/>+ X-Forwarded-User<br/>+ X-Forwarded-Email<br/>+ X-Forwarded-Groups<br/>+ X-Forwarded-Access-Token"| Upstream

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:3px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authmethods fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef sessions fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Browser external
    class KAP proxy
    class Envoy,K8sPod,Upstream,Prometheus internal
    class OIDCProvider,OSAuthServer,OSUserAPI,K8sAPI,Redis externalservice
    class OIDC_Auth,OS_Auth,K8s_Auth,Basic_Auth,Bearer_Auth authmethods
    class CookieSess,RedisSess sessions
