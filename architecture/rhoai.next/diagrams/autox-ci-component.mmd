graph TB
    subgraph AutoxCI["autox-ci — Test Suite / CI Tooling"]
        direction TB

        subgraph TestPackage["autox_tests (Python Test Package)"]
            direction TB
            AutoRAGTests["AutoRAG Tests<br/>(conftest.py, test_autorag.py)"]
            AutoMLTests["AutoML Tests<br/>(test_tabular.py, test_timeseries.py)"]
            IndexTests["Indexing Pipeline Tests"]

            subgraph TestLib["Shared Test Libraries"]
                Settings["settings.py<br/>Environment Config"]
                Clients["clients.py<br/>KFP + S3 Factories"]
                K8sUtils["k8s_utils.py<br/>Kubernetes Client"]
                DSPASupport["dspa_support.py<br/>DSPA CR Lifecycle"]
                RHOAISupport["rhoai_support.py<br/>SA Identity Detection"]
                AutoMLUtils["automl/utils.py<br/>KServe Deploy + Score"]
            end

            AutoRAGTests --> Settings
            AutoRAGTests --> Clients
            AutoMLTests --> Settings
            AutoMLTests --> Clients
            AutoMLTests --> AutoMLUtils
            IndexTests --> Settings
            IndexTests --> Clients
            Settings --> K8sUtils
            AutoMLUtils --> K8sUtils
            DSPASupport --> K8sUtils
            DSPASupport --> Clients
            RHOAISupport --> K8sUtils
        end

        subgraph BenchPackage["autox_benchmarks (Benchmark Orchestration)"]
            direction TB
            DatasetGen["Dataset Generator<br/>(HuggingFace sources)"]
            S3Upload["S3 Dataset Upload"]
            BenchRunner["Benchmark Runner"]
            Scoring["Pattern Scoring"]

            subgraph BenchLib["Benchmark Libraries"]
                BenchKFP["kfp_client.py<br/>Token Resolution"]
                BenchK8s["kubernetes_config.py<br/>ConfigMap Overlay"]
            end

            DatasetGen --> S3Upload
            S3Upload --> BenchRunner
            BenchRunner --> Scoring
            BenchRunner --> BenchKFP
            BenchRunner --> BenchK8s
        end

        RunTests["run_tests.sh<br/>Test Runner Wrapper"]
        RunTests -->|"uv sync, .env, suite select"| TestPackage
    end

    %% External Systems
    OpenShiftAPI["OpenShift API<br/>6443/TCP"]
    KFPServer["KFP Pipeline Server<br/>443/TCP via Route"]
    S3Storage["S3-Compatible Storage<br/>HTTPS"]
    KServeISVC["KServe InferenceService<br/>443/TCP via Route"]
    HuggingFace["HuggingFace Hub<br/>443/TCP"]

    %% Test Package connections
    K8sUtils -->|"Bearer token"| OpenShiftAPI
    Clients -->|"Bearer token"| KFPServer
    Clients -->|"AWS creds"| S3Storage
    AutoMLUtils -->|"Bearer token<br/>TLS no-verify"| KServeISVC
    DSPASupport -->|"creates DSPA CR"| OpenShiftAPI

    %% Benchmark connections
    DatasetGen -->|"download datasets"| HuggingFace
    S3Upload -->|"AWS creds"| S3Storage
    BenchKFP -->|"Bearer token"| KFPServer

    %% CRD interactions
    K8sUtils -.->|"creates"| DSPACR["DataSciencePipelinesApplication CR"]
    AutoMLUtils -.->|"creates"| ISVC["InferenceService CR"]
    AutoMLUtils -.->|"creates"| ServingRT["ServingRuntime CR"]

    %% Styling
    style AutoxCI fill:#f0f4ff,stroke:#4a90e2,stroke-width:2px
    style TestPackage fill:#e8f0fe,stroke:#4a90e2,stroke-width:1px
    style BenchPackage fill:#e8f0fe,stroke:#4a90e2,stroke-width:1px
    style TestLib fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style BenchLib fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style OpenShiftAPI fill:#f5a623,stroke:#333
    style KFPServer fill:#f5a623,stroke:#333
    style S3Storage fill:#f5a623,stroke:#333
    style KServeISVC fill:#f5a623,stroke:#333
    style HuggingFace fill:#f5a623,stroke:#333
    style DSPACR fill:#fff2cc,stroke:#d6b656
    style ISVC fill:#fff2cc,stroke:#d6b656
    style ServingRT fill:#fff2cc,stroke:#d6b656
    style RunTests fill:#4a90e2,color:#fff
