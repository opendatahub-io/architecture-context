graph LR
    MCPMO["MCP Lifecycle<br/>Module Operator"]

    %% External Dependencies (build/runtime libraries)
    MCPMO -->|"operator framework"| CR["controller-runtime<br/>v0.24.1"]
    MCPMO -->|"manifest loading"| Manifestival["manifestival<br/>v0.7.2"]
    MCPMO -->|"SSA deploy, GC,<br/>conditions, labels"| PlatUtils["odh-platform-utilities<br/>v0.2.0"]
    MCPMO -->|"TLS profile types"| OSApi["openshift/api"]
    MCPMO -->|"TLS profile fetch"| OSCRC["openshift/controller-<br/>runtime-common"]
    MCPMO -->|"cipher translation"| LibGo["openshift/library-go"]

    %% Internal Platform Dependencies
    PlatformOp["ODH Platform<br/>Operator"] -->|"creates CR,<br/>reads status"| MCPMO
    MCPMO -->|"deploys operand"| MCPLO["MCP Lifecycle<br/>Operator (operand)"]
    MCPMO -->|"applies CRs"| CertManager["cert-manager"]
    MCPMO -->|"applies<br/>ServiceMonitor"| PromOp["prometheus-operator"]
    MCPMO -->|"creates<br/>StorageVersionMigration"| KSVM["kube-storage-<br/>version-migrator"]
    MCPMO -->|"reads TLS profile<br/>(OpenShift only)"| OSAPIServer["OpenShift<br/>APIServer"]

    %% Operand dependencies (RBAC superset held by module operator)
    MCPLO -->|"manages HTTPRoutes"| GatewayAPI["Gateway API"]
    MCPLO -->|"watches/manages"| Kuadrant["Kuadrant MCP<br/>extensions"]

    %% Kubernetes
    MCPMO -->|"API server"| K8sAPI["Kubernetes API<br/>6443/TCP"]

