graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client (SDK / UI / Dashboard)"]
    end

    subgraph APILayer["API LAYER (ml-pipeline Service)"]
        APIServer["ml-pipeline API Server<br/>8888/TCP HTTP · 8887/TCP gRPC · 8443/TCP HTTPS<br/>SA: ml-pipeline<br/>FIPS: CGO_ENABLED=1, GOFIPS140=v1.0.0"]
    end

    subgraph DataStores["DATA STORES"]
        DB["MySQL / PostgreSQL<br/>3306/5432/TCP<br/>Optional TLS<br/>DB credentials"]
        ObjStore["MinIO / S3 / GCS<br/>443/TCP<br/>TLS 1.2+<br/>Static/IAM/Secret credentials"]
    end

    subgraph InternalServices["INTERNAL SERVICES (ClusterIP)"]
        direction TB

        MLMD["ML Metadata (MLMD)<br/>8080/TCP gRPC<br/>Optional TLS"]
        CacheSrv["Cache Server<br/>443/TCP HTTPS<br/>TLS Certificate"]
        VizSrv["Visualization Server<br/>8888/TCP HTTP<br/>No encryption"]
        PipelineUI["ML Pipeline UI<br/>80/TCP → 3000<br/>HTTP"]
    end

    subgraph TaskPod["ARGO WORKFLOW TASK POD"]
        direction LR
        DriverPod["Driver (init container)<br/>SA: pipeline-runner<br/>FIPS: CGO_ENABLED=0"]
        LauncherPod["Launcher v2 (main container)<br/>SA: pipeline-runner<br/>FIPS: CGO_ENABLED=0"]
    end

    subgraph Controllers["CONTROLLERS & AGENTS"]
        PA["Persistence Agent<br/>No listener (outbound only)<br/>SA: ml-pipeline-persistenceagent"]
        SWFCtrl["Scheduled Workflow Controller<br/>9090/TCP metrics<br/>SA: ml-pipeline-scheduledworkflow"]
    end

    subgraph ExternalEgress["EXTERNAL EGRESS"]
        ArgoWF["Argo Workflows<br/>Kubernetes API<br/>TLS 1.2+<br/>ServiceAccount"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        PipelineURLs["User Pipeline URLs<br/>443/TCP HTTPS<br/>SSRF-validated"]
        MLflow["MLflow Tracking<br/>Configurable port<br/>Optional TLS"]
    end

    %% Client to API
    Client -->|"HTTP/8888 or gRPC/8887<br/>Optional TLS<br/>TokenReview + SAR"| APIServer

    %% API Server to data stores
    APIServer -->|"TCP/3306 or 5432<br/>Optional TLS<br/>DB credentials"| DB
    APIServer -->|"S3/443<br/>TLS 1.2+<br/>Static/IAM"| ObjStore

    %% API Server to external
    APIServer -->|"REST/K8s API<br/>TLS 1.2+<br/>ServiceAccount"| ArgoWF
    APIServer -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    APIServer -->|"HTTP/8888<br/>No encryption"| VizSrv
    APIServer -->|"gRPC/8080<br/>Optional TLS"| MLMD
    APIServer -->|"HTTPS/443<br/>SSRF-validated"| PipelineURLs
    APIServer -.->|"HTTP(S)<br/>Optional TLS<br/>caBundlePath"| MLflow

    %% Task pod to services
    DriverPod -->|"gRPC/8080<br/>Optional TLS"| MLMD
    DriverPod -->|"HTTPS/443<br/>TLS"| CacheSrv
    LauncherPod -->|"gRPC/8080<br/>Optional TLS"| MLMD
    LauncherPod -->|"S3/443<br/>TLS 1.2+<br/>Cloud credentials"| ObjStore

    %% Controllers
    PA -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    PA -->|"gRPC/8887<br/>Optional TLS<br/>Bearer token (1h refresh)"| APIServer
    SWFCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    SWFCtrl -->|"gRPC/8887<br/>Optional TLS<br/>Bearer token"| APIServer

    %% K8s webhook callbacks
    K8sAPI -->|"HTTPS/8443<br/>TLS<br/>TLS Certificate"| APIServer
    K8sAPI -->|"HTTPS/443<br/>TLS<br/>TLS Certificate"| CacheSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#4a90e2,stroke:#2a6ab5,stroke-width:2px,color:#fff
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef taskpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class APIServer api
    class DB,ObjStore datastore
    class MLMD,CacheSrv,VizSrv,PipelineUI internal
    class DriverPod,LauncherPod taskpod
    class PA,SWFCtrl controller
    class ArgoWF,K8sAPI,PipelineURLs,MLflow egress
