graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(SDK / UI / CLI)"]
    end

    subgraph ClusterServices["CLUSTER SERVICES (Internal - ClusterIP)"]
        direction TB

        subgraph NS_Kubeflow["Namespace: kubeflow"]
            APIServer["ml-pipeline (API Server)<br/>REST: 8888/TCP<br/>gRPC: 8887/TCP<br/>Webhook: 8443/TCP<br/>Optional TLS<br/>SA: ml-pipeline"]
            PersistenceAgent["Persistence Agent<br/>SA: ml-pipeline-persistenceagent<br/>No listener"]
            SWFController["Scheduled Workflow Controller<br/>SA: ml-pipeline-scheduledworkflow<br/>No listener"]
            CacheServer["cache-server (Webhook)<br/>443/TCP → 8443/TCP<br/>TLS (CSR-based cert)<br/>SA: kubeflow-pipelines-cache"]
            MLPUI["ml-pipeline-ui<br/>80/TCP → 3000/TCP<br/>HTTP, No Auth"]
            VizServer["ml-pipeline-visualizationserver<br/>8888/TCP HTTP<br/>No Auth"]
        end

        subgraph NS_Pipeline["Namespace: {user-namespace}"]
            ArgoWorkflow["Argo Workflow Pods"]
            DriverContainer["Driver (init container)<br/>No listener"]
            LauncherContainer["Launcher (step container)<br/>No listener"]
        end
    end

    subgraph BackingServices["BACKING SERVICES (Deployed by DSPO)"]
        Database["MySQL / PostgreSQL<br/>3306/5432/TCP<br/>Optional TLS<br/>Auth: Username/Password"]
        ObjectStorage["S3 / MinIO<br/>443/TCP S3 API<br/>Optional TLS<br/>Auth: Access Key"]
        MLMD["ML Metadata (MLMD)<br/>8080/TCP gRPC<br/>Optional TLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MLflow["MLflow Server<br/>Custom port<br/>HTTP/HTTPS<br/>Required caBundlePath"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>Auth: SA Token"]
        Prometheus["Prometheus<br/>(scrapes /metrics)"]
    end

    %% Client flows
    Client -->|"REST 8888/TCP<br/>Optional TLS<br/>Bearer Token / HTTP Header"| APIServer
    Client -->|"gRPC 8887/TCP<br/>Optional TLS<br/>Bearer Token"| APIServer

    %% API Server egress
    APIServer -->|"3306/5432/TCP<br/>Optional TLS<br/>Username/Password"| Database
    APIServer -->|"443/TCP S3 API<br/>Optional TLS<br/>Access Key"| ObjectStorage
    APIServer -->|"gRPC 8080/TCP<br/>Optional TLS"| MLMD
    APIServer -.->|"HTTP/HTTPS<br/>Optional TLS<br/>Required CA bundle"| MLflow
    APIServer -->|"HTTPS 443/TCP<br/>TLS, SA token<br/>TokenReview + SAR"| K8sAPI
    APIServer -->|"HTTP 8080/TCP<br/>No auth"| VizServer

    %% Persistence Agent flows
    PersistenceAgent -->|"HTTP/HTTPS 8888/TCP<br/>Projected token (3600s)"| APIServer
    PersistenceAgent -->|"HTTPS 443/TCP<br/>Projected token"| K8sAPI

    %% SWF Controller flows
    SWFController -->|"HTTPS 443/TCP<br/>TLS, SA token"| K8sAPI

    %% Cache Server flows
    K8sAPI -->|"HTTPS 443/TCP<br/>Webhook call<br/>TLS mutual auth"| CacheServer

    %% Driver flows
    DriverContainer -->|"gRPC 8080/TCP<br/>Optional TLS"| MLMD
    DriverContainer -->|"HTTPS 443/TCP<br/>SA token"| K8sAPI
    DriverContainer -->|"S3 API 443/TCP<br/>Access Key"| ObjectStorage
    DriverContainer -->|"gRPC 8887/TCP<br/>Bearer Token"| APIServer

    %% Launcher flows
    LauncherContainer -->|"gRPC 8080/TCP<br/>Optional TLS"| MLMD
    LauncherContainer -->|"S3 API 443/TCP<br/>Access Key"| ObjectStorage

    %% Prometheus scrape
    Prometheus -->|"HTTP 8888/TCP<br/>No auth<br/>/metrics"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef service fill:#5b9bd5,stroke:#333,stroke-width:2px,color:#fff
    classDef webhook fill:#e06666,stroke:#333,stroke-width:2px,color:#fff
    classDef backing fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef workflow fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class APIServer apiserver
    class PersistenceAgent,SWFController,MLPUI,VizServer service
    class CacheServer webhook
    class Database,ObjectStorage,MLMD backing
    class MLflow,K8sAPI,Prometheus externalservice
    class ArgoWorkflow,DriverContainer,LauncherContainer workflow
