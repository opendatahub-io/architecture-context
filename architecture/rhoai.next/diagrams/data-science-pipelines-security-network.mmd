graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["KFP SDK / Data Scientist"]
    end

    subgraph APILayer["API LAYER"]
        direction TB

        APIServer["ml-pipeline API Server<br/>8888/TCP HTTP | 8887/TCP gRPC | 8443/TCP Webhook<br/>SA: ml-pipeline<br/>FIPS: GOFIPS140=v1.0.0, CGO_ENABLED=1"]
        CacheServer["cache-server<br/>443/TCP HTTPS<br/>SA: kubeflow-pipelines-cache<br/>TLS: webhook-server-tls"]
        PipelineUI["ml-pipeline-ui<br/>80/TCP HTTP<br/>SA: ml-pipeline-ui"]
    end

    subgraph ControllerLayer["CONTROLLERS"]
        direction TB

        PersistenceAgent["ml-pipeline-persistenceagent<br/>SA: ml-pipeline-persistenceagent<br/>FIPS: CGO_ENABLED=0, static"]
        ScheduledWF["ml-pipeline-scheduledworkflow<br/>9090/TCP metrics<br/>SA: ml-pipeline-scheduledworkflow<br/>FIPS: CGO_ENABLED=0, static"]
    end

    subgraph TaskPods["TASK EXECUTION (Pipeline Pods)"]
        direction TB

        DriverContainer["driver<br/>Init/Sidecar<br/>FIPS: CGO_ENABLED=0, static"]
        LauncherContainer["launcher-v2<br/>Sidecar<br/>FIPS: CGO_ENABLED=0, static"]
    end

    subgraph MetadataLayer["METADATA SERVICES"]
        direction TB

        MetadataGRPC["metadata-grpc-deployment<br/>8080/TCP gRPC"]
        MetadataEnvoy["metadata-envoy-deployment<br/>9090/TCP HTTP-to-gRPC"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MySQL["MySQL / MariaDB<br/>3306/TCP<br/>Istio mTLS + AuthorizationPolicy"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>AWS credentials"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% External to API
    Client -->|"REST 8888/TCP or gRPC 8887/TCP<br/>TLS configurable<br/>TokenReview (multi-user) / None"| APIServer

    %% API Server to external services
    APIServer -->|"TCP/3306<br/>Istio mTLS<br/>mysql-secret"| MySQL
    APIServer -->|"HTTP/HTTPS<br/>Configurable<br/>AWS credentials"| S3
    APIServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    APIServer -->|"gRPC/8080<br/>Configurable<br/>None"| MetadataGRPC

    %% Cache server
    CacheServer -->|"Admission webhook<br/>HTTPS/8443<br/>TLS"| K8sAPI

    %% UI
    PipelineUI -->|"API calls"| APIServer

    %% Controllers
    PersistenceAgent -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Watch Workflows"| K8sAPI
    PersistenceAgent -->|"gRPC/8887<br/>Configurable TLS<br/>SA token<br/>Report status"| APIServer
    ScheduledWF -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Watch/Create"| K8sAPI

    %% Task execution
    DriverContainer -->|"gRPC/8080<br/>Configurable<br/>None"| MetadataGRPC
    LauncherContainer -->|"HTTP/HTTPS<br/>Configurable<br/>AWS credentials"| S3

    %% Metadata
    MetadataEnvoy -->|"gRPC/8080<br/>Proxy"| MetadataGRPC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#4a90e2,stroke:#2c6fbb,stroke-width:2px,color:#fff
    classDef controller fill:#50c878,stroke:#3a9a5c,stroke-width:2px
    classDef task fill:#9b59b6,stroke:#7d3c98,stroke-width:2px,color:#fff
    classDef metadata fill:#95a5a6,stroke:#7f8c8d,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class APIServer,CacheServer,PipelineUI api
    class PersistenceAgent,ScheduledWF controller
    class DriverContainer,LauncherContainer task
    class MetadataGRPC,MetadataEnvoy metadata
    class MySQL,S3,K8sAPI extsvc
