graph TB
    subgraph HelmChart["llm-d Helm Chart"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            Controller["ModelService Controller<br/>Go, port 8081<br/>ghcr.io/llm-d/llm-d-model-service:v0.0.15"]
            Presets["Preset ConfigMaps<br/>basic-gpu / gpu-with-nixl /<br/>gpu-with-nixl-and-redis-lookup / sim"]
        end

        subgraph InferencePlane["Inference Plane (per ModelService)"]
            direction TB
            EPP["Endpoint Picker<br/>gRPC 9002/9003, Metrics 9090<br/>ghcr.io/llm-d/llm-d-inference-scheduler:v0.1.0"]

            subgraph PrefillGroup["Prefill Nodes"]
                PrefillVLLM["vLLM Prefill<br/>HTTP 8000, NIXL 5557<br/>ghcr.io/llm-d/llm-d:0.0.8"]
            end

            subgraph DecodeGroup["Decode Nodes"]
                RoutingProxy["Routing Proxy Sidecar<br/>port 8000 -> 8001<br/>ghcr.io/llm-d/llm-d-routing-sidecar:0.0.7"]
                DecodeVLLM["vLLM Decode<br/>HTTP 8001, NIXL 5557<br/>ghcr.io/llm-d/llm-d:0.0.8"]
                RoutingProxy -->|"forwards to 8001"| DecodeVLLM
            end
        end

        subgraph DataLayer["Data Layer"]
            RedisStore["Redis<br/>TCP 8100<br/>Bitnami 20.13.4<br/>KV-cache lookup index"]
        end

        subgraph Observability["Observability (Optional)"]
            Grafana["Grafana + Prometheus DS"]
        end
    end

    %% External Resources
    User["Data Scientist / Client"] -->|"creates"| ModelServiceCR["ModelService CR<br/>llm-d.ai/v1alpha1"]
    ModelServiceCR -->|"watched by"| Controller

    Controller -->|"reads templates"| Presets
    Controller -->|"creates"| PrefillVLLM
    Controller -->|"creates"| DecodeVLLM
    Controller -->|"creates"| EPP
    Controller -->|"creates InferencePool<br/>InferenceModel<br/>HTTPRoute"| GatewayResources["Gateway API Resources"]

    InferenceGW["Inference Gateway<br/>HTTP 80"] -->|"routes via GIE"| EPP
    EPP -->|"selects backend"| PrefillVLLM
    EPP -->|"selects backend"| RoutingProxy

    PrefillVLLM -->|"NIXL KV-cache transfer<br/>TCP 5557"| DecodeVLLM
    PrefillVLLM -->|"LMCache lookup"| RedisStore
    DecodeVLLM -->|"LMCache lookup"| RedisStore

    Grafana -->|"scrapes metrics"| EPP
    Grafana -->|"scrapes metrics"| PrefillVLLM

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style EPP fill:#4a90e2,stroke:#333,color:#fff
    style PrefillVLLM fill:#50c878,stroke:#333,color:#fff
    style DecodeVLLM fill:#50c878,stroke:#333,color:#fff
    style RoutingProxy fill:#9b59b6,stroke:#333,color:#fff
    style RedisStore fill:#e74c3c,stroke:#333,color:#fff
    style ModelServiceCR fill:#f5a623,stroke:#333,color:#000
    style InferenceGW fill:#f5a623,stroke:#333,color:#000
    style Presets fill:#95a5a6,stroke:#333,color:#fff
    style Grafana fill:#95a5a6,stroke:#333,color:#fff
    style GatewayResources fill:#f5a623,stroke:#333,color:#000
    style User fill:#e8e8e8,stroke:#333
