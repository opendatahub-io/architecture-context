graph TB
    subgraph ControlPlane["CONTROL PLANE (Namespace: opendatahub)"]
        direction TB

        TrainerOp["trainer-operator<br/>SA: controller-manager<br/>FIPS: strictfipsruntime<br/>Base: ubi9-minimal-pqc"]

        subgraph KFCtrl["kubeflow-trainer-controller-manager"]
            Metrics["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS (cluster profile)<br/>Bearer + authn/authz"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS<br/>TLS<br/>API server client cert"]
            StatusSrv["Status Server<br/>10443/TCP HTTPS<br/>TLS"]
            Probes["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
        end
    end

    subgraph Monitoring["MONITORING (Namespace: openshift-monitoring)"]
        Prometheus["Prometheus<br/>SA: prometheus-k8s"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph NetworkPolicies["NETWORK POLICIES"]
        direction LR
        IngressNP["Ingress: webhook(9443),<br/>status(10443), metrics(8443)"]
        EgressNP["Egress: Unrestricted"]
    end

    %% Operator to API Server
    TrainerOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>Watch + SSA"| APIServer

    %% API Server to Webhook
    APIServer -->|"HTTPS/9443<br/>TLS<br/>Client cert<br/>Admission requests"| Webhook

    %% Prometheus to Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS (cluster profile)<br/>Bearer token<br/>ServiceMonitor"| Metrics

    %% Operator deploys controller
    TrainerOp -.->|"SSA deploy<br/>(kustomize)"| KFCtrl

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef deployed fill:#5ba5e8,stroke:#333,stroke-width:1px,color:#fff
    classDef monitoring fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef k8s fill:#e8e8e8,stroke:#333,stroke-width:2px
    classDef netpol fill:#fff2cc,stroke:#d6b656,stroke-width:1px

    class TrainerOp operator
    class Metrics,Webhook,StatusSrv,Probes deployed
    class Prometheus monitoring
    class APIServer k8s
    class IngressNP,EgressNP netpol
