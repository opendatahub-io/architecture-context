graph TB
    subgraph External["EXTERNAL (No External Ingress)"]
        User["Data Scientist / User"]
    end

    subgraph K8sAPI["KUBERNETES API SERVER"]
        APIServer["Kubernetes / OpenShift API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / x509"]
    end

    subgraph ClusterInternal["CLUSTER-INTERNAL SERVICES"]
        direction TB

        subgraph NS_Operator["Namespace: trainer-operator-system"]
            TrainerOp["trainer-operator-controller-manager<br/>SA: trainer-operator-controller-manager<br/>Image: odh-trainer-operator:odh-stable<br/>FIPS: CGO_ENABLED=1 strictfipsruntime"]
            OpMetricsSvc["Metrics Service<br/>ClusterIP 8080/TCP HTTP<br/>No encryption<br/>NetworkPolicy: metrics=enabled"]
            OpProbes["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz"]
        end

        subgraph NS_ODH["Namespace: opendatahub"]
            TrainerCtrl["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>Image: trainer:odh-3.5-ea1"]
            WebhookSvc["Webhook Service<br/>ClusterIP 443/TCP → 9443/TCP<br/>HTTPS TLS (self-signed cert)"]
            CtrlMetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP HTTPS<br/>TLS (self-signed cert)"]
            CtrlProbes["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus / OpenShift Monitoring"]
    end

    %% User → API Server
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| APIServer

    %% API Server ↔ Operator
    APIServer <-->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>CRUD: CRDs, Deployments,<br/>RBAC, ConfigMaps"| TrainerOp

    %% API Server ↔ Operand Controller
    APIServer <-->|"HTTPS/443<br/>TLS 1.2+<br/>SA Bearer Token<br/>Watch TrainJobs,<br/>create JobSets"| TrainerCtrl

    %% API Server → Webhook
    APIServer -->|"HTTPS/443→9443<br/>TLS (self-signed)<br/>API server client cert"| WebhookSvc

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>No encryption<br/>NetworkPolicy restricted"| OpMetricsSvc
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>insecureSkipVerify: true"| CtrlMetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#dce6f1,stroke:#4472c4,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operand fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class User external
    class APIServer apiserver
    class TrainerOp operator
    class OpMetricsSvc,OpProbes service
    class TrainerCtrl operand
    class WebhookSvc,CtrlMetricsSvc,CtrlProbes service
    class Prometheus monitoring
