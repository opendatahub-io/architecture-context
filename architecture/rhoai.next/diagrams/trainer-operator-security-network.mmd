graph TB
    subgraph External["EXTERNAL (User Access)"]
        User["Data Scientist / User"]
    end

    subgraph K8sAPIZone["KUBERNETES API SERVER"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA tokens / User tokens"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (trainer-operator-system)"]
        direction TB
        TrainerOp["trainer-operator<br/>SA: controller-manager<br/>CR: manager-role<br/>FIPS: strictfipsruntime"]
        MetricsSvc["controller-manager-metrics-service<br/>ClusterIP 8080/TCP HTTP<br/>No encryption<br/>NetworkPolicy: metrics=enabled"]
        HealthProbes["Health Probes<br/>/healthz /readyz<br/>8081/TCP HTTP"]
    end

    subgraph DeployedNS["DEPLOYED COMPONENTS (managed)"]
        direction TB
        TrainerCtrl["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>CR: kubeflow-trainer-controller-manager"]
        WebhookSvc["Webhook Service<br/>ClusterIP 443/TCP -> 9443<br/>TLS (self-signed cert)<br/>API server mTLS<br/>failurePolicy: Fail"]
    end

    subgraph ClusterResources["CLUSTER-SCOPED RESOURCES (shared)"]
        direction TB
        Runtimes["ClusterTrainingRuntimes<br/>torch-distributed, training-hub,<br/>deepspeed, CUDA/ROCm/CPU<br/>RBAC: training-edit/admin/view"]
        Webhooks["ValidatingWebhookConfigurations<br/>TrainJob, ClusterTrainingRuntime,<br/>TrainingRuntime<br/>failurePolicy: Fail"]
        ImgStreams["OpenShift ImageStreams<br/>training-hub-universal<br/>Tags: 3.4, 3.5"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        direction TB
        PlatformOp["rhods-operator /<br/>opendatahub-operator<br/>Creates Trainer CR"]
        JobSetOp["JobSet Operator (OLM)<br/>Dependency: subscription +<br/>CR health + CRD check"]
        ConfigMap["odh-trainer-config<br/>ConfigMap<br/>platformVersion"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus / OpenShift Monitoring<br/>PodMonitor (monitoring.coreos.com)<br/>Trainer: 8443/TCP HTTPS<br/>Operator: 8080/TCP HTTP<br/>insecureSkipVerify: true"]
    end

    %% User flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>User token<br/>(training-edit RBAC)"| K8sAPI

    %% API server to webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS (webhook cert)<br/>API server mTLS<br/>failurePolicy: Fail"| WebhookSvc

    %% Operator to API server
    TrainerOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>Server-side apply"| K8sAPI

    %% Trainer controller to API server
    TrainerCtrl -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>CRUD TrainJobs/JobSets"| K8sAPI

    %% Platform dependencies
    PlatformOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    TrainerOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>Dependency check"| JobSetOp
    TrainerOp -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token<br/>APIReader"| ConfigMap

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>No encryption<br/>NetworkPolicy"| MetricsSvc
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>insecureSkipVerify"| TrainerCtrl

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef deployed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class K8sAPI apiserver
    class TrainerOp,MetricsSvc,HealthProbes operator
    class TrainerCtrl,WebhookSvc deployed
    class Runtimes,Webhooks,ImgStreams cluster
    class PlatformOp,JobSetOp,ConfigMap platform
    class Prometheus monitoring
