    EvalHub -->|"orchestrates"| Garak["Garak"]
    EvalHub -->|"orchestrates"| GuideLLM["GuideLLM"]

    %% Metrics
    Prometheus["Prometheus"] -->|"scrapes 8081/TCP"| EvalHub

