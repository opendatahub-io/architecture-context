graph LR
    EvalHub[EvalHub<br/>Evaluation Orchestration]

    %% External Dependencies
    EvalHub -->|"persistent storage<br/>5432/TCP"| PostgreSQL["PostgreSQL 12+<br/>(optional, SQLite default)"]
    EvalHub -->|"experiment tracking<br/>HTTP/HTTPS"| MLflow["MLflow Server 2.x<br/>(optional)"]
    EvalHub -->|"test data download<br/>443/TCP"| S3["S3-compatible Storage<br/>(K8s runtime only)"]
    EvalHub -->|"eval card publish<br/>443/TCP"| OCI["OCI Registry v2<br/>(optional)"]
    EvalHub -->|"tracing & metrics<br/>4317/TCP"| OTEL["OpenTelemetry Collector 0.80+<br/>(optional)"]
    EvalHub -->|"metrics scraping<br/>8081/TCP"| Prometheus["Prometheus 2.x<br/>(optional)"]

    %% Internal Platform Dependencies
    TrustyOp["TrustyAI Service Operator"] -->|"manages lifecycle<br/>EvalHub CR"| EvalHub
    KRP["kube-rbac-proxy"] -->|"auth proxy<br/>X-Tenant, X-User"| EvalHub
    Adapters["Evaluation Adapters<br/>lm-eval / Garak / RAGAS /<br/>GuideLLM / LightEval / MTEB"] -->|"sidecar pattern<br/>K8s Job pods"| EvalHub

    %% Integration Points (other components consuming EvalHub)
    MCP["evalhub-mcp<br/>MCP Server"] -->|"REST API client<br/>Bearer Token"| EvalHub

    %% Kubernetes
    EvalHub -->|"Job CRUD, logs<br/>443/TCP SA Token"| K8sAPI["Kubernetes API"]
    EvalHub -->|"model inference<br/>HTTP/HTTPS"| ModelEP["Model Endpoints<br/>(vLLM, TGI, etc.)"]

    %% Styling
    style EvalHub fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style MLflow fill:#999,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style OCI fill:#999,stroke:#333,color:#fff
    style OTEL fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style ModelEP fill:#f5a623,stroke:#333,color:#fff

    %% Internal platform deps
    style TrustyOp fill:#7ed321,stroke:#333,color:#fff
    style KRP fill:#7ed321,stroke:#333,color:#fff
    style Adapters fill:#7ed321,stroke:#333,color:#fff
    style MCP fill:#7ed321,stroke:#333,color:#fff
