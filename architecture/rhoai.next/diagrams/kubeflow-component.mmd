graph TB
    subgraph KubeflowControllers["Kubeflow Notebook Controllers (Combined Deployment)"]
        direction TB

        subgraph UpstreamCtrl["odh-kf-notebook-controller"]
            NotebookCtrl["Notebook Controller<br/>Go controller-runtime"]
            CullingCtrl["Culling Reconciler<br/>Idle detection via Jupyter API"]
            NotebookCtrl -->|"scales to 0 via<br/>stop annotation"| CullingCtrl
        end

        subgraph ODHCtrl["odh-notebook-controller"]
            ODHReconciler["ODH Notebook Reconciler<br/>Go controller-runtime"]
            MutatingWH["Mutating Webhook<br/>:8443/TCP"]
            ValidatingWH["Validating Webhook<br/>:8443/TCP"]
            ConversionWH["Conversion Webhook<br/>v1/v1alpha1 → v1beta1"]
            ODHReconciler -->|"validates"| ValidatingWH
            ODHReconciler -->|"mutates"| MutatingWH
        end
    end

    %% CRD
    User["Data Scientist / User"] -->|"creates"| NotebookCR["Notebook CR<br/>(kubeflow.org/v1beta1)"]
    NotebookCR -->|"admission"| MutatingWH
    NotebookCR -->|"admission"| ValidatingWH
    NotebookCR -->|"watched by"| NotebookCtrl
    NotebookCR -->|"watched by"| ODHReconciler

    %% Upstream controller creates
    NotebookCtrl -->|"creates/manages"| StatefulSet["StatefulSet<br/>(per notebook)"]
    NotebookCtrl -->|"creates/manages"| NBService["Service<br/>{name}:80/TCP"]

    %% ODH controller creates
    ODHReconciler -->|"creates"| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    ODHReconciler -->|"creates"| RefGrant["ReferenceGrant<br/>(cross-namespace)"]
    ODHReconciler -->|"creates"| NetPolicy["NetworkPolicy<br/>(per notebook)"]
    ODHReconciler -->|"injects"| RBACProxy["kube-rbac-proxy<br/>sidecar :8443"]
    ODHReconciler -->|"creates"| PipelineSecret["ds-pipeline-config<br/>Secret (Elyra)"]
    ODHReconciler -->|"creates"| RBAC["ServiceAccount +<br/>RoleBindings"]

    %% Culling
    CullingCtrl -->|"polls /api/kernels<br/>/api/terminals"| NBService

    %% External dependencies
    HTTPRoute -->|"parent ref"| Gateway["data-science-gateway<br/>(openshift-ingress)"]
    RBACProxy -->|"SubjectAccessReview"| K8sAPI["Kubernetes API<br/>Server :6443"]
    ODHReconciler -->|"reads DSPA CR"| DSPA["DSPA<br/>(Data Science Pipelines)"]
    ODHReconciler -->|"reads ClusterRole"| MLflow["MLflow Operator"]
    ODHReconciler -->|"reads ImageStreams"| ImageStreams["OpenShift<br/>ImageStreams"]
    MutatingWH -->|"TLS cert"| ServiceCA["OpenShift<br/>Service CA Operator"]

    %% Styling
    style NotebookCtrl fill:#4a90e2,color:#fff
    style CullingCtrl fill:#4a90e2,color:#fff
    style ODHReconciler fill:#4a90e2,color:#fff
    style MutatingWH fill:#5b6abf,color:#fff
    style ValidatingWH fill:#5b6abf,color:#fff
    style ConversionWH fill:#5b6abf,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style StatefulSet fill:#7ed321
    style NBService fill:#7ed321
    style HTTPRoute fill:#7ed321
    style RefGrant fill:#7ed321
    style NetPolicy fill:#7ed321
    style RBACProxy fill:#7ed321
    style PipelineSecret fill:#7ed321
    style RBAC fill:#7ed321
    style Gateway fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style DSPA fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style ImageStreams fill:#e8e8e8,stroke:#333
    style ServiceCA fill:#e8e8e8,stroke:#333
    style User fill:#fff,stroke:#333,stroke-width:2px
