graph TB
    subgraph KubeflowControllers["Kubeflow Notebook Controllers"]
        direction TB

        subgraph Upstream["Upstream Controller"]
            KFController["kf-notebook-controller<br/>Go controller-runtime"]
            CullingReconciler["CullingReconciler<br/>Idle notebook culling"]
        end

        subgraph Downstream["ODH Notebook Controller"]
            ODHController["odh-notebook-controller<br/>Go controller-runtime"]
            MutatingWebhook["NotebookWebhook<br/>Mutating Admission<br/>:8443/TCP"]
            ValidatingWebhook["NotebookValidatingWebhook<br/>Validating Admission<br/>:8443/TCP"]
        end

        ODHController -->|"reconciliation lock<br/>(stoppedByController annotation)"| KFController
    end

    User["User / Dashboard"] -->|"kubectl create"| NotebookCR["Notebook CR<br/>kubeflow.org/v1"]

    NotebookCR -->|"CREATE/UPDATE"| MutatingWebhook
    MutatingWebhook -->|"injects kube-rbac-proxy<br/>resolves ImageStream<br/>sets proxy env vars"| NotebookCR
    NotebookCR -->|"CREATE/UPDATE"| ValidatingWebhook
    ValidatingWebhook -->|"validates pod security<br/>guards MLflow annotations"| NotebookCR

    NotebookCR -->|"watched by"| KFController
    NotebookCR -->|"watched by"| ODHController

    KFController -->|"creates"| StatefulSet["StatefulSet"]
    KFController -->|"creates"| Service["Service"]
    CullingReconciler -->|"stops idle notebooks"| NotebookCR

    ODHController -->|"creates"| SA["ServiceAccount"]
    ODHController -->|"creates"| NetworkPolicy["NetworkPolicy"]
    ODHController -->|"creates"| HTTPRoute["HTTPRoute<br/>Gateway API"]
    ODHController -->|"creates"| RoleBinding["RoleBinding"]
    ODHController -->|"creates"| ReferenceGrant["ReferenceGrant"]
    ODHController -->|"provisions"| DSPASecret["DSPA Secrets"]
    ODHController -->|"assembles"| CABundle["Trusted CA Bundle"]

    ODHController -->|"watches"| GatewayAPI["Gateway API"]
    ODHController -->|"watches"| DSPA["DataSciencePipelinesApplication"]
    ODHController -->|"reads"| ImageStreams["OpenShift Image Streams"]
    ODHController -->|"reads"| OSConfig["OpenShift Config<br/>TLS Profile / Proxy"]
    ODHController -->|"manages"| OAuthClient["OAuthClient<br/>(legacy)"]

    style KFController fill:#4a90e2,color:#fff
    style ODHController fill:#4a90e2,color:#fff
    style CullingReconciler fill:#4a90e2,color:#fff
    style MutatingWebhook fill:#e87040,color:#fff
    style ValidatingWebhook fill:#e87040,color:#fff
    style NotebookCR fill:#f5a623,color:#000
    style StatefulSet fill:#7ed321,color:#000
    style Service fill:#7ed321,color:#000
    style SA fill:#7ed321,color:#000
    style NetworkPolicy fill:#7ed321,color:#000
    style HTTPRoute fill:#7ed321,color:#000
    style RoleBinding fill:#7ed321,color:#000
    style ReferenceGrant fill:#7ed321,color:#000
    style DSPASecret fill:#7ed321,color:#000
    style CABundle fill:#7ed321,color:#000
    style GatewayAPI fill:#e8e8e8,color:#000
    style DSPA fill:#e8e8e8,color:#000
    style ImageStreams fill:#e8e8e8,color:#000
    style OSConfig fill:#e8e8e8,color:#000
    style OAuthClient fill:#e8e8e8,color:#000
