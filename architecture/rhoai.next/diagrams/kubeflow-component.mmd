graph TB
    subgraph KubeflowControllers["Kubeflow Notebook Controllers"]
        direction TB

        subgraph Upstream["odh-kf-notebook-controller"]
            Controller["Notebook Controller<br/>8080/TCP metrics<br/>8081/TCP health"]
            CullingController["Culling Controller<br/>(idle notebook detection)"]
        end

        subgraph Downstream["odh-notebook-controller"]
            ODHController["ODH Notebook Controller<br/>8080/TCP metrics<br/>8081/TCP health"]
            WebhookServer["Webhook Server<br/>8443/TCP HTTPS"]
            ODHController -->|runs| WebhookServer
        end

        subgraph SharedLib["reconcilehelper"]
            ReconcileUtil["Shared reconcile utilities<br/>(Deployments, Services,<br/>StatefulSets, VirtualServices)"]
        end
    end

    %% CRD
    NotebookCR["Notebook CR<br/>kubeflow.org/v1<br/>(Namespaced)"]

    %% User interaction
    User["User<br/>(kubectl / Dashboard)"] -->|creates/updates| NotebookCR

    %% CR watched by both controllers
    NotebookCR -->|watched by| Controller
    NotebookCR -->|watched by| ODHController

    %% Upstream controller creates
    Controller -->|creates| StatefulSet["StatefulSet<br/>(1 pod per notebook)"]
    Controller -->|creates| NotebookSvc["ClusterIP Service<br/>80 → 8888/TCP"]
    Controller -->|creates (optional)| VirtualService["Istio VirtualService"]

    %% Culling
    CullingController -->|queries /api/kernels<br/>/api/terminals| NotebookPod["Notebook Pod<br/>8888/TCP"]
    CullingController -->|scales to zero| StatefulSet

    %% ODH controller creates
    ODHController -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    ODHController -->|creates| NetworkPolicy["NetworkPolicy<br/>(per-notebook)"]
    ODHController -->|creates| ReferenceGrant["ReferenceGrant<br/>(cross-namespace)"]
    ODHController -->|injects| KubeRBACProxy["kube-rbac-proxy<br/>sidecar (8443/TCP)"]
    ODHController -->|creates| ElyraSecret["Elyra Pipeline Secret<br/>(ds-pipeline-config)"]

    %% Webhook
    KubeAPI["Kubernetes API Server"] -->|admission requests| WebhookServer
    WebhookServer -->|mutates/validates| NotebookCR

    %% Gateway integration
    HTTPRoute -->|references| Gateway["Gateway<br/>(data-science-gateway)"]
    Gateway -->|routes to| KubeRBACProxy
    KubeRBACProxy -->|proxies to| NotebookPod

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style CullingController fill:#4a90e2,stroke:#333,color:#fff
    style ODHController fill:#2d6cb4,stroke:#333,color:#fff
    style WebhookServer fill:#2d6cb4,stroke:#333,color:#fff
    style ReconcileUtil fill:#6baed6,stroke:#333,color:#fff
    style NotebookCR fill:#f5a623,stroke:#333,color:#fff
    style StatefulSet fill:#7ed321,stroke:#333
    style NotebookSvc fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style ReferenceGrant fill:#7ed321,stroke:#333
    style KubeRBACProxy fill:#e8547e,stroke:#333,color:#fff
    style Gateway fill:#999,stroke:#333,color:#fff
    style VirtualService fill:#999,stroke:#333
    style ElyraSecret fill:#7ed321,stroke:#333
    style KubeAPI fill:#999,stroke:#333,color:#fff
