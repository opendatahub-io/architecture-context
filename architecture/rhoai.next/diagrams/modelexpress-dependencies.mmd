graph LR
    MX["ModelExpress<br/>(Operator + Server)"]

    %% Internal Platform Dependencies
    MX -->|"CRD CRUD, RBAC,<br/>Watch streams"| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    MX -->|"TLS security profile<br/>(OpenShift only)"| OCPConfig["OpenShift APIServer<br/>Config"]
    MX -->|"ServiceMonitor<br/>(OpenShift only)"| Prometheus["Prometheus<br/>(monitoring.coreos.com)"]

    %% External Dependencies
    MX -->|"metadata storage<br/>6379/TCP"| Redis["Redis"]
    MX -->|"model downloads<br/>443/TCP HTTPS"| HFHub["Hugging Face Hub"]
    MX -->|"model downloads<br/>443/TCP HTTPS"| NGC["NGC Catalog"]

    %% Runtime Integrations (consumers of ModelExpress)
    vLLM["vLLM<br/>(--load-format modelexpress)"] -->|"gRPC P2pService<br/>8001/TCP"| MX
    SGLang["SGLang<br/>(modelexpress backend)"] -->|"gRPC P2pService<br/>8001/TCP"| MX
    TensorRTLLM["TensorRT-LLM<br/>(checkpoint_format MX)"] -->|"gRPC P2pService<br/>8001/TCP"| MX
    Dynamo["NVIDIA Dynamo"] -->|"gRPC P2pService<br/>8001/TCP"| MX
    llmd["llm-d"] -->|"gRPC<br/>8001/TCP"| MX

    %% Build Dependencies
    MX -.->|"build: tonic 0.13"| Tonic["tonic<br/>(gRPC framework)"]
    MX -.->|"build: kube-rs 0.98"| KubeRS["kube-rs<br/>(K8s controller)"]
    MX -.->|"FIPS: openssl 0.10"| OpenSSL["openssl<br/>(system OpenSSL)"]
    MX -.->|"upstream: rustls 0.23"| Rustls["rustls"]

    %% Styling
    style MX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style K8sAPI fill:#6366f1,stroke:#333,color:#fff
    style OCPConfig fill:#6366f1,stroke:#333,color:#fff
    style Prometheus fill:#8b5cf6,stroke:#333,color:#fff

    style Redis fill:#999,stroke:#333,color:#fff
    style HFHub fill:#f59e0b,stroke:#333
    style NGC fill:#f59e0b,stroke:#333

    style vLLM fill:#10b981,stroke:#333,color:#fff
    style SGLang fill:#10b981,stroke:#333,color:#fff
    style TensorRTLLM fill:#10b981,stroke:#333,color:#fff
    style Dynamo fill:#10b981,stroke:#333,color:#fff
    style llmd fill:#10b981,stroke:#333,color:#fff

    style Tonic fill:#e5e7eb,stroke:#999
    style KubeRS fill:#e5e7eb,stroke:#999
    style OpenSSL fill:#e5e7eb,stroke:#999
    style Rustls fill:#e5e7eb,stroke:#999
