graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM INGRESS (KServe-managed)"]
        KServe["KServe InferenceService<br/>Gateway API / Envoy<br/>TLS Termination"]
    end

    subgraph Pod["POD: vllm-cpu inference server"]
        direction TB

        subgraph HTTPLayer["HTTP Layer"]
            FastAPI["FastAPI/Uvicorn<br/>8000/TCP<br/>Optional TLS (ssl.SSLContext)<br/>Auth: Bearer (VLLM_API_KEY)"]
            HealthEndpoints["/health, /ready, /readyz<br/>NO Auth<br/>K8s probes"]
        end

        subgraph GRPCLayer["gRPC Layer"]
            GRPC["gRPC Server<br/>50051/TCP<br/>⚠️ insecure_port (NO TLS)<br/>⚠️ NO Auth"]
        end

        subgraph InternalIPC["Internal IPC (not network-exposed)"]
            Engine["V1 EngineCore<br/>ZMQ PUSH/PUB<br/>msgspec serialization"]
            Executor["Model Executor<br/>CPU Backend<br/>NUMA-aware"]
        end
    end

    subgraph Egress["EXTERNAL SERVICES (Egress)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: HF_TOKEN Bearer"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM"]
        OTel["OpenTelemetry Collector<br/>configurable/TCP<br/>gRPC/HTTP OTLP<br/>TLS<br/>(not on s390x)"]
        Prometheus["Prometheus<br/>Scrapes 8000/TCP<br/>HTTP<br/>No Auth"]
    end

    %% Inbound flows
    Client -->|"HTTPS<br/>TLS terminated at gateway"| KServe
    KServe -->|"HTTP/8000<br/>Optional TLS<br/>Bearer Token"| FastAPI
    KServe -.->|"health probes"| HealthEndpoints
    Client -.->|"gRPC/50051<br/>⚠️ NO TLS<br/>⚠️ NO Auth<br/>Pod isolation only"| GRPC

    %% Internal flows
    FastAPI --> Engine
    GRPC --> Engine
    Engine --> Executor

    %% Egress flows
    Executor -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    Executor -.->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    FastAPI -.->|"OTLP<br/>TLS"| OTel
    Prometheus -.->|"HTTP/8000<br/>scrape"| FastAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef insecure fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef health fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Client external
    class KServe platform
    class FastAPI,Engine,Executor pod
    class GRPC insecure
    class HFHub,S3,OTel,Prometheus egress
    class HealthEndpoints health
