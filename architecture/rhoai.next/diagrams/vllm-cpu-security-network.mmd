graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / KServe Router"]
    end

    subgraph Platform["PLATFORM INGRESS (DMZ)"]
        Ingress["Istio Gateway / OCP Route<br/>TLS termination<br/>mTLS to mesh"]
    end

    subgraph Application["APPLICATION (vllm-cpu container, UID 2000)"]
        direction TB

        subgraph HTTPServer["HTTP Server (FastAPI/Uvicorn)"]
            AuthGuarded["Auth-Guarded Endpoints<br/>/v1/*, /v2/*, /inference/*<br/>Bearer token required"]
            Unauthenticated["Unauthenticated Endpoints<br/>/health, /ready, /load,<br/>/version, /ping, /tokenize"]
            AuthMW["AuthenticationMiddleware<br/>SHA-256 constant-time comparison"]
        end

        subgraph GRPCBlock["gRPC Server (grpc.aio)"]
            GRPC["VllmEngine + Health<br/>8000/TCP<br/>⚠ Insecure port only"]
        end

        subgraph EngineBlock["AsyncLLM Engine"]
            Engine["PagedAttention + Continuous Batching<br/>LoRA Adapter Manager"]
        end

        SSLRefresh["SSLCertRefresher<br/>File-watching cert hot-reload"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS 1.2+"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS TLS 1.2+"]
        Stats["stats.vllm.ai<br/>443/TCP HTTPS<br/>Disabled by default"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes 8000/TCP HTTP"]
        OTel["OpenTelemetry Collector<br/>OTLP HTTP/gRPC"]
    end

    %% External flows
    Client -->|"HTTPS via ingress<br/>or HTTP/8000 direct<br/>Bearer token"| Ingress
    Ingress -->|"HTTP/8000<br/>mTLS via mesh sidecar"| AuthGuarded
    Ingress -->|"HTTP/8000<br/>mTLS via mesh sidecar"| Unauthenticated
    Client -->|"gRPC/8000<br/>⚠ No TLS<br/>No auth"| GRPC

    %% Internal flows
    AuthGuarded --> AuthMW
    AuthMW --> Engine
    Unauthenticated --> Engine
    GRPC --> Engine
    SSLRefresh -.->|"Reloads TLS certs"| HTTPServer

    %% Egress
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub
    Engine -->|"HTTPS/443<br/>TLS 1.2+<br/>S3 credentials"| S3
    Engine -.->|"HTTPS/443<br/>VLLM_NO_USAGE_STATS=1"| Stats

    %% Observability
    Prometheus -->|"HTTP/8000<br/>No auth"| Unauthenticated
    Engine -->|"OTLP export"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Ingress platform
    class AuthGuarded,Unauthenticated,AuthMW,Engine,SSLRefresh application
    class GRPC warning
    class HFHub,S3,Stats extservice
    class Prometheus,OTel observability
