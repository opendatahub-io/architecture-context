graph TD
    subgraph OrchestratorSecurity["FMS Guardrails Orchestrator — Security Model"]
        direction TB

        subgraph ContainerIdentity["Container Identity"]
            User["Non-root User<br/>orchestr8 (UID 1001, GID 0)"]
            BaseImage["Base Image<br/>registry.redhat.io/ubi9/ubi-minimal-pqc<br/>(digest-pinned)"]
        end

        subgraph TLSAuth["TLS / Authentication"]
            ServerTLS["Server TLS (Optional)<br/>TLS_CERT_PATH<br/>TLS_KEY_PATH<br/>rustls + ring (NOT FIPS)"]
            ClientMTLS["Client mTLS (Optional)<br/>TLS_CLIENT_CA_CERT_PATH<br/>WebPkiClientVerifier"]
            NamedTLS["Named TLS Configs<br/>Per-downstream cert bundles<br/>Supports insecure mode"]
        end

        subgraph HeaderAuth["Header-Based Auth"]
            Passthrough["Passthrough Headers<br/>Configured headers forwarded<br/>to downstream services"]
            TokenRewrite["Token Rewrite<br/>X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
            APIToken["API Token (env var)<br/>Bearer token for<br/>detector services"]
        end
    end

    subgraph NoRBAC["Kubernetes RBAC"]
        Note["No RBAC roles defined<br/>No Kubernetes API interaction<br/>Pure user-space service"]
    end

    subgraph Secrets["Managed Secrets"]
        TLSCert["TLS Server Cert/Key<br/>kubernetes.io/tls"]
        ClientCA["TLS Client CA Cert<br/>Opaque"]
        APITokenSecret["API Tokens<br/>Opaque (env var)"]
        DownstreamCerts["Downstream TLS Certs<br/>Opaque"]
    end

    ServerTLS -->|"loaded from"| TLSCert
    ClientMTLS -->|"loaded from"| ClientCA
    APIToken -->|"loaded from"| APITokenSecret
    NamedTLS -->|"loaded from"| DownstreamCerts

    style User fill:#4a90e2,stroke:#333,color:#fff
    style BaseImage fill:#4a90e2,stroke:#333,color:#fff
    style ServerTLS fill:#f5a623,stroke:#333
    style ClientMTLS fill:#f5a623,stroke:#333
    style NamedTLS fill:#f5a623,stroke:#333
    style Passthrough fill:#7ed321,stroke:#333
    style TokenRewrite fill:#7ed321,stroke:#333
    style APIToken fill:#7ed321,stroke:#333
    style Note fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style TLSCert fill:#fff2cc,stroke:#d6b656
    style ClientCA fill:#fff2cc,stroke:#d6b656
    style APITokenSecret fill:#fff2cc,stroke:#d6b656
    style DownstreamCerts fill:#fff2cc,stroke:#d6b656
