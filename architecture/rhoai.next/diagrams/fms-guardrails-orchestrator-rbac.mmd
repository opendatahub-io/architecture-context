graph TD
    subgraph ServiceIdentity["Service Identity"]
        Container["fms-guardrails-orchestr8<br/>(Rust binary on UBI9)"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB

        subgraph InboundAuth["Inbound Authentication"]
            mTLS_In["mTLS (optional)<br/>WebPkiClientVerifier<br/>via TLS_CLIENT_CA_CERT_PATH"]
            TLS_In["TLS (optional)<br/>rustls ServerConfig<br/>via TLS_CERT_PATH + TLS_KEY_PATH"]
            NoAuth["No Auth<br/>Health endpoints<br/>Port 8034 (open access)"]
        end

        subgraph OutboundAuth["Outbound Authentication"]
            ClientCert["Client Certificate<br/>Per-service TLS config<br/>via config.yaml tls section"]
            BearerToken["Bearer Token<br/>api_token from env var<br/>Authorization header"]
            HeaderFwd["Header Passthrough<br/>X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
        end
    end

    subgraph Secrets["Secrets & Credentials"]
        TLSServerCert["TLS Server Cert/Key<br/>kubernetes.io/tls<br/>Manual provisioning<br/>No auto-rotate"]
        TLSClientCA["TLS Client CA Cert<br/>Opaque<br/>Manual provisioning<br/>No auto-rotate"]
        PerServiceTLS["Per-Service TLS Certs<br/>kubernetes.io/tls<br/>Manual provisioning<br/>No auto-rotate"]
        APITokens["API Token(s)<br/>Opaque<br/>Manual provisioning<br/>No auto-rotate"]
    end

    subgraph Endpoints["Protected Endpoints"]
        GuardrailsAPI["/api/v1/* and /api/v2/*<br/>Port 8033/TCP<br/>mTLS optional"]
        HealthAPI["/health and /info<br/>Port 8034/TCP<br/>Open access"]
        OutGRPC["Outbound gRPC<br/>TGIS, Caikit NLP, Chunker<br/>mTLS optional"]
        OutHTTP["Outbound HTTP<br/>Detectors, OpenAI LLM<br/>Bearer token optional"]
    end

    %% Service to auth
    Container -->|"serves"| GuardrailsAPI
    Container -->|"serves"| HealthAPI
    Container -->|"calls"| OutGRPC
    Container -->|"calls"| OutHTTP

    %% Auth mechanisms to endpoints
    mTLS_In -.->|"protects"| GuardrailsAPI
    TLS_In -.->|"encrypts"| GuardrailsAPI
    NoAuth -.->|"open"| HealthAPI
    ClientCert -.->|"authenticates"| OutGRPC
    BearerToken -.->|"authenticates"| OutHTTP
    HeaderFwd -.->|"forwards"| OutHTTP

    %% Secrets to auth
    TLSServerCert -->|"provides"| TLS_In
    TLSClientCA -->|"provides"| mTLS_In
    PerServiceTLS -->|"provides"| ClientCert
    APITokens -->|"provides"| BearerToken

    %% Styling
    style Container fill:#4a90e2,stroke:#333,color:#fff
    style mTLS_In fill:#d5e8d4,stroke:#82b366
    style TLS_In fill:#d5e8d4,stroke:#82b366
    style NoAuth fill:#fff2cc,stroke:#d6b656
    style ClientCert fill:#dae8fc,stroke:#6c8ebf
    style BearerToken fill:#dae8fc,stroke:#6c8ebf
    style HeaderFwd fill:#dae8fc,stroke:#6c8ebf
    style TLSServerCert fill:#f5a623,stroke:#333
    style TLSClientCA fill:#f5a623,stroke:#333
    style PerServiceTLS fill:#f5a623,stroke:#333
    style APITokens fill:#f5a623,stroke:#333
    style GuardrailsAPI fill:#e8e8e8,stroke:#333
    style HealthAPI fill:#e8e8e8,stroke:#333
    style OutGRPC fill:#e8e8e8,stroke:#333
    style OutHTTP fill:#e8e8e8,stroke:#333
