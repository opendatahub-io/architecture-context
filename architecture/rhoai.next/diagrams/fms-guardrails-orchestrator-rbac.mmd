graph TD
    subgraph ServiceInfo["FMS Guardrails Orchestrator - Auth & Access Model"]
        direction TB
        Note["This is a standalone service, not a Kubernetes operator.<br/>No ClusterRoles, Roles, or RoleBindings defined.<br/>RBAC is managed by the deploying operator."]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB

        subgraph ClientAuth["Client → Orchestrator"]
            HeaderPass["Header Passthrough<br/>(configurable via passthrough_headers)"]
            TokenRewrite["X-Forwarded-Access-Token<br/>→ Authorization: Bearer rewrite"]
        end

        subgraph BackendAuth["Orchestrator → Backend Services"]
            DetectorAuth["Detector Services<br/>Bearer token (api_token config)<br/>+ detector-id header<br/>+ x-model-name header"]
            ChunkerAuth["Chunker Services<br/>mTLS client certificates<br/>+ mm-model-id header"]
            TGISAuth["TGIS Generation<br/>mTLS client certificates<br/>+ header passthrough"]
            NLPAuth["Caikit NLP<br/>mTLS client certificates<br/>+ mm-model-id header"]
            OpenAIAuth["OpenAI-compatible LLM<br/>Bearer token (api_token env var)"]
        end

        subgraph NoAuth["Unauthenticated Endpoints"]
            HealthEndpoint["/health (8034/TCP)<br/>No auth required"]
            InfoEndpoint["/info (8034/TCP)<br/>No auth required"]
        end
    end

    subgraph Secrets["Secrets Used"]
        direction TB
        TLSServerCert["TLS server cert/key<br/>(kubernetes.io/tls)<br/>Provisioned: cert-manager or manual"]
        TLSClientCA["TLS client CA cert<br/>(Opaque)<br/>Provisioned: manual"]
        NamedTLS["Named TLS configs<br/>(Opaque, per-service)<br/>Provisioned: manual"]
        APITokens["API tokens<br/>(Opaque, via env vars)<br/>Provisioned: manual"]
    end

    HeaderPass -->|"forwarded to"| DetectorAuth
    HeaderPass -->|"forwarded to"| TGISAuth
    TokenRewrite -->|"rewritten for"| DetectorAuth
    TokenRewrite -->|"rewritten for"| OpenAIAuth

    TLSServerCert -->|"used by"| ClientAuth
    TLSClientCA -->|"used by"| ClientAuth
    NamedTLS -->|"used by"| BackendAuth
    APITokens -->|"used by"| DetectorAuth
    APITokens -->|"used by"| OpenAIAuth

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style HeaderPass fill:#4a90e2,stroke:#333,color:#fff
    style TokenRewrite fill:#4a90e2,stroke:#333,color:#fff
    style DetectorAuth fill:#7ed321,stroke:#333
    style ChunkerAuth fill:#7ed321,stroke:#333
    style TGISAuth fill:#7ed321,stroke:#333
    style NLPAuth fill:#7ed321,stroke:#333
    style OpenAIAuth fill:#f5a623,stroke:#333
    style HealthEndpoint fill:#e8e8e8,stroke:#333
    style InfoEndpoint fill:#e8e8e8,stroke:#333
    style TLSServerCert fill:#f8d7da,stroke:#721c24
    style TLSClientCA fill:#f8d7da,stroke:#721c24
    style NamedTLS fill:#f8d7da,stroke:#721c24
    style APITokens fill:#f8d7da,stroke:#721c24
