graph TB
    subgraph RhodsOperator["rhods-operator"]
        direction TB

        subgraph Manager["manager (Go Operator)"]
            DSCIController["DSCInitialization<br/>Controller"]
            DSCController["DataScienceCluster<br/>Controller"]
            ModuleController["Module Controller"]

            subgraph ServiceControllers["Service Controllers"]
                GatewayCtrl["Gateway Controller"]
                AuthCtrl["Auth Controller"]
                MonitoringCtrl["Monitoring Controller"]
                CertConfigCtrl["Cert ConfigMap<br/>Generator"]
                SetupCtrl["Setup Controller"]
            end

            WebhookServer["Webhook Server<br/>9443/TCP"]
            MetricsEndpoint["Metrics Endpoint<br/>8443/TCP"]
            HealthProbe["Health Probes<br/>8081/TCP"]

            TLSProfileWatcher["SecurityProfile<br/>Watcher"]
            ManifestRenderer["Kustomize/Helm<br/>Manifest Renderer"]
        end

        subgraph CloudMgr["cloudmanager (CLI)"]
            EKSCtrl["AWS EKS Controller"]
            AKECtrl["Azure AKE Controller"]
            CWCtrl["CoreWeave Controller"]
        end

        subgraph RuntimeDeployed["Runtime-Created"]
            KubeAuthProxy["kube-auth-proxy<br/>OIDC/OAuth Proxy"]
        end
    end

    %% CRDs watched
    DSCI_CR["DSCInitialization CR"] -->|watched by| DSCIController
    DSC_CR["DataScienceCluster CR"] -->|watched by| DSCController
    GWConfig_CR["GatewayConfig CR"] -->|watched by| GatewayCtrl
    Auth_CR["Auth CR"] -->|watched by| AuthCtrl
    Platform_CR["Platform CR"] -->|conversion webhook| WebhookServer
    HWProfile_CR["HardwareProfile CR"] -->|validated by| WebhookServer

    %% Cloud CRDs
    AWSEKE_CR["AWSKubernetesEngine CR"] -->|watched by| EKSCtrl
    AzureAKE_CR["AzureKubernetesEngine CR"] -->|watched by| AKECtrl
    CWKE_CR["CoreWeaveKubernetesEngine CR"] -->|watched by| CWCtrl

    %% Gateway controller creates resources
    GatewayCtrl -->|creates| GatewayRes["Gateway + GatewayClass"]
    GatewayCtrl -->|creates| HTTPRoutes["HTTPRoute CRs"]
    GatewayCtrl -->|creates| EnvoyFilters["EnvoyFilter CRs"]
    GatewayCtrl -->|creates| DestRules["DestinationRule CRs"]
    GatewayCtrl -->|deploys| KubeAuthProxy

    %% Auth controller creates RBAC
    AuthCtrl -->|creates| AdminRBAC["Admin Group RBAC"]
    AuthCtrl -->|creates| AllowedRBAC["Allowed Group RBAC"]

    %% Manifest renderer deploys components
    DSCController --> ManifestRenderer
    ManifestRenderer -->|deploys| Components["Platform Components<br/>Dashboard, KServe, Ray,<br/>Kueue, TrustyAI, etc."]

    %% External dependencies
    Manager -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Manager -->|reads| OSConfig["OpenShift Cluster Config<br/>TLS Profile, Ingress Domain"]
    TLSProfileWatcher -->|monitors| OSConfig
    KubeAuthProxy -->|authenticates via| OIDC["OIDC Provider<br/>443/TCP"]
    KubeAuthProxy -->|validates tokens| K8sAPI

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style CloudMgr fill:#4a90e2,stroke:#333,color:#fff
    style RuntimeDeployed fill:#7ed321,stroke:#333,color:#fff
    style KubeAuthProxy fill:#7ed321,stroke:#333
    style DSCI_CR fill:#f5a623,stroke:#333
    style DSC_CR fill:#f5a623,stroke:#333
    style GWConfig_CR fill:#f5a623,stroke:#333
    style Auth_CR fill:#f5a623,stroke:#333
    style Platform_CR fill:#f5a623,stroke:#333
    style HWProfile_CR fill:#f5a623,stroke:#333
    style AWSEKE_CR fill:#f5a623,stroke:#333
    style AzureAKE_CR fill:#f5a623,stroke:#333
    style CWKE_CR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSConfig fill:#e8e8e8,stroke:#333
    style OIDC fill:#e8e8e8,stroke:#333
    style Components fill:#d5e8d4,stroke:#82b366
