graph TB
    subgraph "rhods-operator (Platform Operator)"
        direction TB

        subgraph "Top-Level Controllers"
            DSCController["DataScienceCluster Controller<br/>Provisions 16 components + 3 modules"]
            DSCIController["DSCInitialization Controller<br/>Cluster-level initialization"]
        end

        subgraph "Service Controllers"
            GatewayCtrl["Gateway Service Controller<br/>Ingress stack: Gateway API, Envoy,<br/>kube-auth-proxy, redirects"]
            AuthCtrl["Auth Service Controller<br/>Platform RBAC: admin groups,<br/>allowed groups, roles"]
            MonitoringCtrl["Monitoring Service Controller<br/>Prometheus, Tempo, Perses,<br/>OpenTelemetry, Thanos"]
        end

        subgraph "Component Controllers (14)"
            DashboardCtrl["Dashboard"]
            KServeCtrl["KServe"]
            KueueCtrl["Kueue"]
            RayCtrl["Ray"]
            ModelRegCtrl["Model Registry"]
            ModelCtrlCtrl["ModelController"]
            WorkbenchCtrl["Workbenches"]
            DSPCtrl["DataSciencePipelines"]
            TrustyAICtrl["TrustyAI"]
            TrainerCtrl["Trainer"]
            TrainingOpCtrl["TrainingOperator"]
            FeastCtrl["FeastOperator"]
            OGXCtrl["OGX"]
            SparkCtrl["SparkOperator"]
        end

        subgraph "Module Handlers (3)"
            AIGatewayMod["AIGateway Module"]
            MLflowMod["MLflowOperator Module"]
            MCPMod["MCPLifecycleOperator Module"]
        end

        subgraph "Support Controllers"
            CertCtrl["CertConfigmapGenerator<br/>Trust CA propagation"]
            SetupCtrl["Setup Controller<br/>Operator deletion monitoring"]
            WebhookSrv["Webhook Server<br/>DSC v2 validation"]
        end

        subgraph "CloudManager"
            CloudMgr["cloudmanager binary<br/>KubernetesEngine CRs"]
        end
    end

    %% Top-Level CR inputs
    DSCCR["DataScienceCluster CR<br/>(v1/v2)"]
    DSCICR["DSCInitialization CR<br/>(v1/v2)"]

    %% Service CRs
    AuthCR["Auth CR"]
    GatewayCfgCR["GatewayConfig CR"]
    MonitoringCR["Monitoring CR"]

    %% External Systems
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftAPI["OpenShift API<br/>(OAuth, Routes, Config)"]
    OLM["OLM<br/>(Operator Framework)"]

    %% Flow: DSCI creates services
    DSCICR -->|watched by| DSCIController
    DSCIController -->|creates| AuthCR
    DSCIController -->|creates| GatewayCfgCR
    DSCIController -->|creates| MonitoringCR

    %% Flow: DSC creates components
    DSCCR -->|watched by| DSCController
    DSCController -->|creates component CRs| DashboardCtrl
    DSCController -->|creates component CRs| KServeCtrl
    DSCController -->|creates component CRs| KueueCtrl
    DSCController -->|creates module CRs| AIGatewayMod

    %% Service controllers watch service CRs
    AuthCR -->|watched by| AuthCtrl
    GatewayCfgCR -->|watched by| GatewayCtrl
    MonitoringCR -->|watched by| MonitoringCtrl

    %% External interactions
    DSCController -->|reconciles via| K8sAPI
    GatewayCtrl -->|manages routes, OAuth| OpenShiftAPI
    OLM -->|deploys| DSCController

    %% CloudManager
    CloudMgr -->|manages| K8sAPI

    %% Styling
    style DSCController fill:#4a90e2,color:#fff
    style DSCIController fill:#4a90e2,color:#fff
    style GatewayCtrl fill:#7ed321,color:#fff
    style AuthCtrl fill:#7ed321,color:#fff
    style MonitoringCtrl fill:#7ed321,color:#fff
    style DSCCR fill:#f5a623,color:#fff
    style DSCICR fill:#f5a623,color:#fff
    style AuthCR fill:#f5a623,color:#fff
    style GatewayCfgCR fill:#f5a623,color:#fff
    style MonitoringCR fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style OLM fill:#e8e8e8,stroke:#333
    style WebhookSrv fill:#d0021b,color:#fff
    style CloudMgr fill:#9013fe,color:#fff
