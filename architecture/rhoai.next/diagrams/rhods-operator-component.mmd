graph TB
    subgraph RhodsOperator["rhods-operator (Platform Operator)"]
        direction TB

        subgraph CoreControllers["Core Controllers"]
            Manager["manager<br/>(controller-runtime)<br/>9443/TCP webhook<br/>8080/TCP metrics<br/>8081/TCP health"]
            DSCICtrl["DSCInitialization<br/>Controller"]
            DSCCtrl["DataScienceCluster<br/>Controller"]
            WebhookSrv["Webhook Server<br/>(15 webhooks)"]
        end

        subgraph ServiceControllers["Service Controllers"]
            GatewayCtrl["Gateway Service<br/>Controller"]
            AuthCtrl["Auth Service<br/>Controller"]
            MonitoringCtrl["Monitoring Service<br/>Controller"]
            CertCtrl["CertConfigMap<br/>Generator"]
            SetupCtrl["Setup Service<br/>Controller"]
        end

        subgraph ModuleSystem["Module System"]
            ModuleCtrl["Module Controller<br/>(Helm/Kustomize)"]
        end

        CloudMgr["cloudmanager<br/>(Cloud CLI)"]
    end

    %% Primary CRDs
    DSCI["DSCInitialization CR<br/>(Cluster Singleton)"]
    DSC["DataScienceCluster CR<br/>(Cluster Singleton)"]

    %% Service CRs
    GatewayConfig["GatewayConfig CR"]
    AuthCR["Auth CR"]
    MonitoringCR["Monitoring CR"]

    %% Component CRs (managed by DSC Controller)
    subgraph ComponentCRs["Component CRs (15+ components)"]
        DashboardCR["Dashboard"]
        KServeCR["KServe"]
        WorkbenchesCR["Workbenches"]
        DSPCR["DataScience<br/>Pipelines"]
        ModelRegCR["Model<br/>Registry"]
        ModelCtrlCR["Model<br/>Controller"]
        TrustyAICR["TrustyAI"]
        KueueCR["Kueue"]
        RayCR["Ray"]
        TrainingCR["Training<br/>Operator"]
        TrainerCR["Trainer"]
        FeastCR["Feast<br/>Operator"]
        OGXCR["OGX"]
        SparkCR["Spark<br/>Operator"]
    end

    %% Module CRs
    subgraph ModuleCRs["Module CRs (out-of-tree)"]
        AIGatewayCR["AIGateway"]
        MLflowCR["MLflow<br/>Operator"]
        MCPCR["MCP Lifecycle<br/>Operator"]
        MonModCR["Monitoring<br/>Module"]
    end

    %% Gateway Infrastructure
    subgraph GatewayInfra["Gateway Infrastructure"]
        Gateway["data-science-gateway<br/>(Gateway API)"]
        EnvoyFilter["EnvoyFilter<br/>(ext_authz + Lua)"]
        KubeAuthProxy["kube-auth-proxy<br/>(OAuth2/OIDC)<br/>8443/TCP"]
        DashRedirect["dashboard-redirect<br/>(nginx 301)"]
    end

    %% Flow: DSCI watched by controller
    DSCI -->|watched by| DSCICtrl
    DSCICtrl -->|creates| GatewayConfig
    DSCICtrl -->|creates| AuthCR
    DSCICtrl -->|creates| MonitoringCR

    %% Flow: DSC watched by controller
    DSC -->|watched by| DSCCtrl
    DSCCtrl -->|"creates via DAG<br/>(runlevel ordering)"| ComponentCRs
    DSCCtrl -->|creates| ModuleCRs

    %% Service controllers watch service CRs
    GatewayConfig -->|watched by| GatewayCtrl
    AuthCR -->|watched by| AuthCtrl
    MonitoringCR -->|watched by| MonitoringCtrl

    %% Gateway controller deploys infrastructure
    GatewayCtrl -->|deploys| GatewayInfra

    %% Module controller deploys modules
    ModuleCRs -->|processed by| ModuleCtrl

    %% Webhook validates CRs
    WebhookSrv -->|validates/defaults| DSC
    WebhookSrv -->|validates/defaults| DSCI

    %% Cloud manager
    CloudMgr -->|manages| CloudClusters["Cloud Clusters<br/>(AWS, Azure, CoreWeave)"]

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    Manager -->|"watches CRDs"| K8sAPI

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style DSCICtrl fill:#4a90e2,stroke:#333,color:#fff
    style DSCCtrl fill:#4a90e2,stroke:#333,color:#fff
    style WebhookSrv fill:#4a90e2,stroke:#333,color:#fff
    style GatewayCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style AuthCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style MonitoringCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style CertCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style SetupCtrl fill:#5b9bd5,stroke:#333,color:#fff
    style ModuleCtrl fill:#9b59b6,stroke:#333,color:#fff
    style CloudMgr fill:#e67e22,stroke:#333,color:#fff
    style DSCI fill:#f5a623,stroke:#333
    style DSC fill:#f5a623,stroke:#333
    style GatewayConfig fill:#f5a623,stroke:#333
    style AuthCR fill:#f5a623,stroke:#333
    style MonitoringCR fill:#f5a623,stroke:#333
    style Gateway fill:#27ae60,stroke:#333,color:#fff
    style EnvoyFilter fill:#27ae60,stroke:#333,color:#fff
    style KubeAuthProxy fill:#27ae60,stroke:#333,color:#fff
    style DashRedirect fill:#27ae60,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
