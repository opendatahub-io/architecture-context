graph TB
    subgraph CallerProcess["CALLER PROCESS (User / KFP Pipeline)"]
        direction TB

        subgraph Library["ai4rag Library (Python import)"]
            direction TB

            subgraph InProcess["IN-PROCESS (No Network)"]
                Unitxt["Unitxt Evaluator<br/>RAG metrics"]
                Docling["Docling<br/>PDF/DOCX parser"]
                PyGAM["pyGAM<br/>HPO optimizer"]
                ChromaDB["ChromaDB<br/>In-memory vector store"]
            end

            subgraph EgressClients["EGRESS CLIENTS"]
                OGXClient["ogx-client SDK<br/>(httpx)"]
                BotoClient["boto3 SDK"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OGXServer["OGX Server<br/>Port: 443/TCP<br/>Auth: API Key (Bearer)"]
        S3["S3-Compatible Storage<br/>Port: 443/TCP<br/>Auth: AWS IAM"]
    end

    %% Network flows
    OGXClient -->|"HTTPS/443<br/>TLS 1.2+<br/>API Key (Bearer)<br/>⚠ verify=False fallback"| OGXServer
    BotoClient -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM credentials<br/>⚠ verify=False fallback"| S3

    %% Credentials
    subgraph Credentials["CREDENTIALS (Environment Variables)"]
        direction LR
        APIKEY["API_KEY<br/>OGX auth"]
        OGXURL["OGX_CLIENT_BASE_URL<br/>OGX endpoint"]
        AWSKEY["AWS_ACCESS_KEY_ID<br/>S3 auth"]
        AWSSECRET["AWS_SECRET_ACCESS_KEY<br/>S3 auth"]
        S3EP["AWS_S3_ENDPOINT<br/>S3 endpoint"]
    end

    Credentials -.->|"injected via env vars<br/>no auto-rotation"| Library

    %% Styling
    classDef caller fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef inprocess fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef egress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef creds fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef warning fill:#ff6b6b,stroke:#c92a2a,stroke-width:2px

    class CallerProcess caller
    class Unitxt,Docling,PyGAM,ChromaDB inprocess
    class OGXClient,BotoClient egress
    class OGXServer,S3 external
    class APIKEY,OGXURL,AWSKEY,AWSSECRET,S3EP creds
