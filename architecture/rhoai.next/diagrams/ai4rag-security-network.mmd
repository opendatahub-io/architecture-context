graph TB
    subgraph LocalProcess["LOCAL PROCESS (Trusted - Library Context)"]
        direction TB

        subgraph AI4RAG["ai4rag Library<br/>(Python in-process, no listening ports)"]
            direction TB

            subgraph InternalModules["Internal Modules (no network traffic)"]
                Experiment["AI4RAGExperiment<br/>Orchestrator"]
                HPO["HPO Engine<br/>(GAM Bayesian / Random)"]
                Chunker["Chunkers<br/>(Docling / LangChain)"]
                Unitxt["UnitxtEvaluator<br/>(in-process metrics)"]
                ChromaDB["ChromaDB<br/>(in-memory vector store<br/>NO network egress)"]
                EventHandler["EventHandler<br/>(Local: JSON to disk<br/>KFP: component output)"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB

        OGX["OGX Server<br/>Port: Configurable<br/>Protocol: HTTPS<br/>TLS (default)<br/>⚠ verify=False fallback"]
        S3["S3-compatible Storage<br/>Port: 443/TCP<br/>Protocol: HTTPS<br/>TLS (configurable)"]
    end

    subgraph Secrets["SECRETS"]
        direction LR
        OGXKey["OGX API Key<br/>(Bearer Token)<br/>User-provided"]
        AWSCreds["AWS Credentials<br/>(Access Key + Secret Key)<br/>Env var / K8s Secret"]
        S3Endpoint["AWS_S3_ENDPOINT<br/>(Endpoint URL)<br/>Env var / K8s Secret"]
    end

    %% Network flows
    Experiment -->|"HTTPS / Configurable Port<br/>TLS (⚠ verify=False fallback)<br/>Auth: API Key (Bearer)<br/><br/>• chat.completions.create<br/>• embeddings.create<br/>• vector_io.insert/query/delete<br/>• models.list"| OGX

    Experiment -->|"HTTPS / 443/TCP<br/>TLS (configurable)<br/>Auth: AWS IAM<br/>(Access Key + Secret Key)<br/><br/>• Document persistence<br/>• Artifact storage"| S3

    %% Secret bindings
    OGXKey -.->|"authenticates"| OGX
    AWSCreds -.->|"authenticates"| S3
    S3Endpoint -.->|"configures"| S3

    %% Styling
    classDef localprocess fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#e8f5e9,stroke:#4caf50,stroke-width:1px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secrets fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef warning fill:#fff3e0,stroke:#ff9800,stroke-width:2px

    class Experiment,HPO,Chunker,Unitxt,ChromaDB,EventHandler internal
    class OGX,S3 external
    class OGXKey,AWSCreds,S3Endpoint secrets
