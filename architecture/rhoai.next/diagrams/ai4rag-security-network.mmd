graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Application["APPLICATION (Starter Kit — Port 8080)"]
        direction TB
        AuthMiddleware["auth_wrapper<br/>ASGI Middleware<br/>K8s TokenReview Validation"]
        FastAPI["FastAPI Service<br/>/v1/responses (POST)<br/>/health (GET — unprotected)<br/>Non-root user 1001"]
        AuthMiddleware --> FastAPI
    end

    subgraph SafetyLayer["NETWORK SAFETY (ensure_safe_url)"]
        URLPolicy["URL Trust Policy<br/>HTTPS required for all non-local endpoints<br/>Allowlist: localhost, *.cluster.local<br/>No unverified TLS fallback"]
    end

    subgraph Backends["EGRESS (Backend Services — All TLS Verified)"]
        direction TB
        MaaS["MaaS Endpoint<br/>(OpenAI-Compatible)<br/>HTTPS · Bearer API Key<br/>Custom CA: MAAS_CA_BUNDLE"]
        Milvus["Milvus Server<br/>19530/TCP gRPC<br/>TLS · Token Auth<br/>Custom CA: MILVUS_CA_CERT"]
        PGVector["PostgreSQL / pgvector<br/>5432/TCP<br/>TLS verify-full (non-local)<br/>Custom CA: PGVECTOR_CA_CERT"]
        Neo4j["Neo4j<br/>7687/TCP Bolt<br/>TLS via neo4j+s://<br/>Username/Password"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS · AWS IAM<br/>Custom CA: AWS_CA_BUNDLE"]
    end

    subgraph K8sServices["KUBERNETES SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS (K8s CA verified)<br/>Bearer: K8S_REVIEWER_TOKEN"]
    end

    %% Flows
    Client -->|"HTTP/8080<br/>Bearer K8s SA Token"| AuthMiddleware
    AuthMiddleware -->|"HTTPS/443<br/>TokenReview<br/>Bearer Reviewer Token"| K8sAPI
    FastAPI --> URLPolicy
    URLPolicy -->|"HTTPS<br/>Bearer API Key"| MaaS
    URLPolicy -->|"gRPC+TLS/19530<br/>Token"| Milvus
    URLPolicy -->|"TLS/5432<br/>Password"| PGVector
    URLPolicy -->|"Bolt+TLS/7687<br/>Password"| Neo4j
    URLPolicy -->|"HTTPS/443<br/>AWS IAM"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef safety fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class AuthMiddleware,FastAPI application
    class URLPolicy safety
    class MaaS,Milvus,PGVector,Neo4j,S3 backend
    class K8sAPI k8s
