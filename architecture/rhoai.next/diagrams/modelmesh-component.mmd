graph TB
    subgraph External["External Clients"]
        Client["Client / modelmesh-serving"]
    end

    subgraph MMPod["ModelMesh Pod"]
        direction TB

        subgraph MMContainer["mm Container (Java 21 Sidecar)"]
            direction TB
            SidecarMM["SidecarModelMesh<br/>Core bridge to runtime"]
            API["ModelMeshApi<br/>gRPC server :8033"]
            VModel["VModelManager<br/>Virtual model aliases"]
            PreStop["RuntimeContainersPreStopServer<br/>Graceful shutdown"]
            SidecarMM --> API
            SidecarMM --> VModel
            SidecarMM --> PreStop
        end

        subgraph RuntimeContainer["Model Runtime Container"]
            Runtime["Model Runtime<br/>(Triton / MLServer / OVMS)"]
        end

        MMContainer -->|"gRPC :8085/TCP or UDS<br/>/tmp/mmesh/grpc.sock<br/>loadModel, unloadModel,<br/>inference forwarding"| RuntimeContainer
    end

    Client -->|"gRPC :8033/TCP<br/>TLS (optional)<br/>mTLS (optional)"| API

    subgraph Coordination["Distributed Coordination"]
        etcd["etcd v3.5+<br/>:2379/TCP"]
    end

    subgraph PeerPods["Peer ModelMesh Pods"]
        Peer["Peer mm Container<br/>:8080/TCP"]
    end

    SidecarMM -->|"gRPC :2379/TCP<br/>Model registry,<br/>leader election,<br/>instance table"| etcd
    SidecarMM -->|"Thrift (litelinks) :8080/TCP<br/>Model forwarding,<br/>cluster coordination"| Peer

    subgraph Observability["Observability"]
        Prometheus["Prometheus<br/>Scrapes :2112/TCP"]
    end

    MMContainer -->|"HTTPS :2112/TCP<br/>Self-signed TLS<br/>Metrics endpoint"| Prometheus

    subgraph Health["Health Probes"]
        Kubelet["Kubelet"]
    end

    Kubelet -->|"HTTP :8089/TCP<br/>/ready, /live"| MMContainer

    style API fill:#4a90e2,stroke:#333,color:#fff
    style SidecarMM fill:#4a90e2,stroke:#333,color:#fff
    style VModel fill:#4a90e2,stroke:#333,color:#fff
    style PreStop fill:#4a90e2,stroke:#333,color:#fff
    style Runtime fill:#7ed321,stroke:#333,color:#fff
    style etcd fill:#f5a623,stroke:#333,color:#fff
    style Peer fill:#9b59b6,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style Kubelet fill:#e8e8e8,stroke:#333
    style Client fill:#e8e8e8,stroke:#333
