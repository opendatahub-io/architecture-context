graph TB
    subgraph "ModelMesh Sidecar (per ServingRuntime Pod)"
        direction TB
        ModelMeshApi["ModelMeshApi<br/>gRPC API Layer<br/>8033/TCP"]
        Core["ModelMesh Core<br/>Distributed LRU Cache<br/>& Routing Engine"]
        VModel["VModel Manager<br/>Zero-Downtime<br/>Version Transitions"]
        PayloadProc["Payload Processor<br/>Pipeline"]
        MetricsServer["Prometheus Metrics<br/>Server<br/>2112/TCP HTTPS"]
        HealthServer["Health Probes<br/>/ready /live<br/>8089/TCP HTTP"]
        ThriftRPC["LiteLinks Thrift<br/>Inter-Instance RPC<br/>8080/TCP"]
        RuntimeClient["ModelRuntime<br/>gRPC Client"]
        ConfigWatcher["ConfigMap File<br/>Watcher"]

        ModelMeshApi -->|routes requests| Core
        Core -->|manages| VModel
        Core -->|dispatches| RuntimeClient
        Core -->|forwards to peers| ThriftRPC
        ModelMeshApi -->|intercepts| PayloadProc
        Core -->|reports| MetricsServer
        ConfigWatcher -->|dynamic config| Core
    end

    subgraph "Co-Located Runtime Container"
        ModelRuntime["Model Runtime<br/>(Triton / MLServer / Custom)<br/>ModelRuntime gRPC Service"]
    end

    Client["External Client<br/>(Inference / Management)"] -->|gRPC/8033<br/>TLS optional| ModelMeshApi
    RuntimeClient -->|gRPC/8085 or UDS<br/>plaintext| ModelRuntime

    subgraph "Distributed State"
        etcd["etcd Cluster<br/>Model Registry<br/>Instance Registry<br/>Leader Election"]
    end

    Core -->|gRPC/2379<br/>TLS optional| etcd

    subgraph "Peer ModelMesh Instances"
        PeerA["ModelMesh Instance B<br/>8080/TCP"]
        PeerB["ModelMesh Instance C<br/>8080/TCP"]
    end

    ThriftRPC -->|Thrift/8080<br/>TLS/mTLS optional| PeerA
    ThriftRPC -->|Thrift/8080<br/>TLS/mTLS optional| PeerB

    Prometheus["Prometheus<br/>Scraper"] -->|HTTPS/2112<br/>TLS self-signed| MetricsServer
    K8s["Kubernetes<br/>Kubelet"] -->|HTTP/8089| HealthServer

    PayloadProc -.->|HTTP/HTTPS<br/>configurable| RemoteLogger["Remote Payload<br/>Processor"]

    modelmeshController["modelmesh-controller<br/>(Deployment Orchestrator)"] -.->|deploys as sidecar| Core

    style ModelMeshApi fill:#4a90e2,stroke:#333
    style Core fill:#4a90e2,stroke:#333
    style VModel fill:#4a90e2,stroke:#333
    style PayloadProc fill:#4a90e2,stroke:#333
    style MetricsServer fill:#4a90e2,stroke:#333
    style HealthServer fill:#4a90e2,stroke:#333
    style ThriftRPC fill:#4a90e2,stroke:#333
    style RuntimeClient fill:#4a90e2,stroke:#333
    style ConfigWatcher fill:#4a90e2,stroke:#333
    style ModelRuntime fill:#7ed321,stroke:#333
    style etcd fill:#e8e8e8,stroke:#333
    style PeerA fill:#b8d4f0,stroke:#333
    style PeerB fill:#b8d4f0,stroke:#333
    style Client fill:#f5a623,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
    style RemoteLogger fill:#e8e8e8,stroke:#333
    style modelmeshController fill:#7ed321,stroke:#333
