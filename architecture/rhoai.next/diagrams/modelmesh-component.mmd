graph TB
    subgraph ModelMeshPod["ModelMesh Pod"]
        direction TB

        subgraph SidecarModelMesh["ModelMesh Sidecar (Java 21)"]
            direction TB
            API["ModelMeshApi<br/>gRPC Server<br/>Port 8033/TCP"]
            Cache["SidecarModelMesh<br/>Distributed LRU Cache<br/>(ConcurrentLinkedHashMap)"]
            VModel["VModelManager<br/>Virtual Model Aliases<br/>Zero-Downtime Transitions"]
            PrometheusServer["Prometheus NettyServer<br/>HTTPS Metrics<br/>Port 2112/TCP"]
            PreStop["PreStop Server<br/>HTTP Lifecycle Hook<br/>Port 8090/TCP"]
            HealthProbe["Health Probes<br/>HTTP /ready /live<br/>Port 8089/TCP"]
            Litelinks["Litelinks (Thrift RPC)<br/>Inter-Instance Comm<br/>Port 8080/TCP"]

            API -->|"method call"| Cache
            Cache -->|"manages"| VModel
            Cache -->|"publishes"| PrometheusServer
        end

        Runtime["Model Runtime Container<br/>(mlserver / Triton / custom)<br/>Port 8085/TCP or UDS"]
    end

    Client[External Client] -->|"gRPC/8033<br/>Optional TLS + mTLS"| API
    Cache -->|"gRPC/8085 (plaintext)<br/>load/unload/predict"| Runtime
    Litelinks -->|"Thrift/8080<br/>Optional TLS"| PeerPod["Peer ModelMesh Pod"]
    Cache -->|"gRPC/2379<br/>model registry, leader election"| etcd["etcd Cluster"]
    Kubelet["Kubernetes Kubelet"] -->|"HTTP/8089"| HealthProbe
    Prometheus["Prometheus Scraper"] -->|"HTTPS/2112<br/>self-signed TLS"| PrometheusServer
    Controller["modelmesh-serving<br/>Controller"] -.->|"ConfigMap<br/>model-serving-config"| SidecarModelMesh

    style API fill:#4a90e2,stroke:#333,color:#fff
    style Cache fill:#4a90e2,stroke:#333,color:#fff
    style VModel fill:#4a90e2,stroke:#333,color:#fff
    style PrometheusServer fill:#4a90e2,stroke:#333,color:#fff
    style PreStop fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbe fill:#4a90e2,stroke:#333,color:#fff
    style Litelinks fill:#4a90e2,stroke:#333,color:#fff
    style Runtime fill:#7ed321,stroke:#333,color:#fff
    style etcd fill:#f5a623,stroke:#333,color:#fff
    style PeerPod fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style Controller fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style Kubelet fill:#e8e8e8,stroke:#333
