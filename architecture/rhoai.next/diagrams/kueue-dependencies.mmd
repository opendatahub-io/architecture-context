graph LR
    Kueue["Kueue Controller Manager<br/>(kueue.x-k8s.io)"]

    %% Required External Dependencies
    subgraph Required["Required Dependencies"]
        CtrlRuntime["controller-runtime<br/>v0.19.4"]
        K8sAPI["Kubernetes API Server"]
    end

    Kueue -->|"controller framework"| CtrlRuntime
    Kueue -->|"CRD watch, CRUD<br/>443/TCP HTTPS"| K8sAPI

    %% Optional External Dependencies
    subgraph Optional["Optional External Dependencies"]
        CertManager["cert-manager<br/>v1.17.1"]
        CA["Cluster Autoscaler<br/>ProvisioningRequest API"]
        GatewayAPI["gateway-api<br/>v1.1.0"]
    end

    Kueue -.->|"webhook TLS certs<br/>(alternative to internal)"| CertManager
    Kueue -.->|"capacity provisioning<br/>ProvisioningRequest CRs"| CA
    Kueue -.->|"indirect dependency"| GatewayAPI

    %% Job Framework Integrations (Optional — CRD types only)
    subgraph JobFrameworks["Job Framework Integrations"]
        KubeflowTraining["Kubeflow Training Operator<br/>v1.9.0<br/>(PyTorchJob, TFJob,<br/>PaddleJob, XGBoostJob)"]
        KubeflowMPI["Kubeflow MPI Operator<br/>v0.6.0<br/>(MPIJob)"]
        Ray["Ray Operator<br/>v1.3.1<br/>(RayJob, RayCluster)"]
        CodeFlare["CodeFlare AppWrapper<br/>v1.1.0"]
        JobSet["JobSet Controller<br/>v0.8.0"]
        LWS["LeaderWorkerSet<br/>v0.5.1"]
    end

    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| KubeflowTraining
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| KubeflowMPI
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| Ray
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| CodeFlare
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| JobSet
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| LWS

    %% Native K8s Integrations
    subgraph K8sNative["Native Kubernetes Workloads"]
        BatchJob["batch/Job"]
        Pod["core/Pod"]
        Deployment["apps/Deployment"]
        StatefulSet["apps/StatefulSet"]
    end

    Kueue -->|"webhook + watch<br/>9443/TCP HTTPS"| BatchJob
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| Pod
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| Deployment
    Kueue -.->|"webhook + watch<br/>9443/TCP HTTPS"| StatefulSet

    %% Internal Platform Dependencies
    subgraph Internal["Internal Platform (RHOAI)"]
        Prometheus["Prometheus<br/>ServiceMonitor + Alerts<br/>8443/TCP HTTPS"]
    end

    Prometheus -->|"scrapes /metrics<br/>Bearer Token"| Kueue

    %% MultiKueue (Disabled in RHOAI)
    subgraph MultiKueue["MultiKueue (Disabled)"]
        RemoteCluster["Remote Kueue Clusters<br/>443/TCP HTTPS"]
    end

    Kueue -.->|"federation<br/>kubeconfig creds<br/>(MultiKueue=false)"| RemoteCluster

    %% Styling
    style Kueue fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style CtrlRuntime fill:#999,stroke:#333
    style K8sAPI fill:#999,stroke:#333
    style CertManager fill:#bbb,stroke:#333
    style CA fill:#bbb,stroke:#333
    style GatewayAPI fill:#ddd,stroke:#333

    style KubeflowTraining fill:#7ed321,stroke:#333
    style KubeflowMPI fill:#7ed321,stroke:#333
    style Ray fill:#7ed321,stroke:#333
    style CodeFlare fill:#7ed321,stroke:#333
    style JobSet fill:#7ed321,stroke:#333
    style LWS fill:#7ed321,stroke:#333

    style BatchJob fill:#f5a623,stroke:#333
    style Pod fill:#f5a623,stroke:#333
    style Deployment fill:#f5a623,stroke:#333
    style StatefulSet fill:#f5a623,stroke:#333

    style Prometheus fill:#e91e63,stroke:#333,color:#fff
    style RemoteCluster fill:#ddd,stroke:#999,stroke-dasharray:5 5
