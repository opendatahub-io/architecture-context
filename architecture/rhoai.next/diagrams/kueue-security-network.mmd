graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CI Pipeline"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / Client Certs"]
    end

    subgraph KueueNS["KUEUE (Namespace: opendatahub)"]
        direction TB

        subgraph WebhookSvc["kueue-webhook-service (ClusterIP)"]
            Webhook["Admission Webhooks<br/>443→9443/TCP HTTPS<br/>TLS (self-signed)<br/>API server TLS client auth<br/>failurePolicy: Fail<br/>20 mutating + 21 validating"]
        end

        subgraph MetricsSvc["kueue-metrics-service (ClusterIP)"]
            Metrics["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS<br/>Bearer Token<br/>(TokenReview + SAR)"]
        end

        subgraph VisibilitySvc["kueue-visibility-server (ClusterIP)"]
            Visibility["Visibility API<br/>443→8082/TCP HTTPS<br/>TLS<br/>Delegated auth<br/>VisibilityOnDemand=false"]
        end

        subgraph HealthEndpoints["Health (not exposed as Service)"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>No auth"]
        end

        Controller["kueue-controller-manager<br/>SA: system:controller-manager<br/>Leader election enabled"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>ServiceMonitor<br/>Alerts: KueuePodDown,<br/>LowClusterQueueResourceUsage,<br/>ResourceReservationExceedsQuota,<br/>PendingWorkloadPods"]
    end

    subgraph RemoteClusters["REMOTE CLUSTERS (MultiKueue - disabled)"]
        RemoteKueue["Remote Kueue Cluster<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>kubeconfig credentials"]
    end

    subgraph AutoscalerZone["CLUSTER AUTOSCALER"]
        CA["Cluster Autoscaler<br/>ProvisioningRequest API<br/>443/TCP HTTPS"]
    end

    %% Inbound flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"HTTPS/9443<br/>TLS (self-signed)<br/>API server TLS client auth<br/>NetworkPolicy: allow 9443 only"| Webhook
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>(metrics-reader SA)"| Metrics
    K8sAPI -->|"HTTPS/8082<br/>TLS<br/>Delegated auth"| Visibility

    %% Outbound flows
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount token<br/>Watch CRDs, Jobs, Pods,<br/>Nodes, Secrets, ConfigMaps"| K8sAPI
    Controller -.->|"HTTPS/443<br/>TLS 1.2+<br/>kubeconfig Secret<br/>(MultiKueue=false)"| RemoteKueue
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>ServiceAccount token<br/>ProvisioningRequests"| CA

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef kueue fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef remote fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray:5 5
    classDef autoscaler fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Webhook,Metrics,Visibility,Health,Controller kueue
    class Prometheus monitoring
    class RemoteKueue remote
    class CA autoscaler
