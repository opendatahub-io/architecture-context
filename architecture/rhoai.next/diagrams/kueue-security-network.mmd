graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
    end

    subgraph KueueNS["KUEUE NAMESPACE (opendatahub)"]
        direction TB

        subgraph ControllerPod["kueue-controller-manager<br/>SA: kueue-controller-manager<br/>User: 65532 (non-root)<br/>FIPS: strictfipsruntime"]
            WebhookPort["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cert-controller)"]
            MetricsPort["Metrics Server<br/>8443/TCP HTTPS<br/>TLS"]
            HealthPort["Health Probes<br/>8081/TCP HTTP"]
        end

        WebhookSvc["kueue-webhook-service<br/>ClusterIP 443→9443"]
        MetricsSvc["kueue-metrics-service<br/>ClusterIP 8443"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>ServiceMonitor + PrometheusRule"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACES"]
        direction TB
        BatchJobs["batch/v1 Jobs<br/>Pods, Deployments,<br/>StatefulSets"]
        MLJobs["Kubeflow Jobs<br/>PyTorchJob, TFJob,<br/>MPIJob, PaddleJob,<br/>XGBoostJob"]
        RayWorkloads["Ray Workloads<br/>RayJob, RayCluster"]
        OtherWorkloads["JobSet, AppWrapper,<br/>LeaderWorkerSet"]
    end

    %% Admission webhook flow
    APIServer -->|"Admission webhook call<br/>443→9443/TCP HTTPS<br/>TLS (CA bundle)"| WebhookSvc
    WebhookSvc --> WebhookPort

    %% Controller to API server
    ControllerPod -->|"Watch + CRUD<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"| APIServer

    %% Metrics flow
    Prometheus -->|"GET /metrics<br/>8443/TCP HTTPS<br/>TLS<br/>Bearer token"| MetricsSvc
    MetricsSvc --> MetricsPort
    MetricsPort -->|"TokenReview +<br/>SubjectAccessReview<br/>6443/TCP"| APIServer

    %% Workload interception
    BatchJobs -.->|"intercepted by<br/>webhooks"| APIServer
    MLJobs -.->|"intercepted by<br/>webhooks"| APIServer
    RayWorkloads -.->|"intercepted by<br/>webhooks"| APIServer
    OtherWorkloads -.->|"intercepted by<br/>webhooks"| APIServer

    %% Styling
    classDef controlplane fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef kueuens fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef workloads fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef port fill:#4a90e2,color:#fff
    classDef svc fill:#7ed321,color:#fff

    class APIServer controlplane
    class WebhookPort,MetricsPort,HealthPort port
    class WebhookSvc,MetricsSvc svc
    class Prometheus monitoring
    class BatchJobs,MLJobs,RayWorkloads,OtherWorkloads workloads
