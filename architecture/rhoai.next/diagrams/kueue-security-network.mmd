graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP<br/>TLS 1.2+<br/>OIDC / Client Certs / SA Tokens"]
    end

    subgraph KueueNamespace["KUEUE SERVICES (Namespace: opendatahub)<br/>NetworkPolicy: ingress restricted to 9443/TCP"]
        direction TB

        subgraph WebhookSvc["kueue-webhook-service (ClusterIP)"]
            Webhook["Webhook Server<br/>443→9443/TCP<br/>TLS (self-signed/cert-manager)<br/>API Server Client Cert"]
        end

        subgraph MetricsSvc["kueue-metrics-service (ClusterIP)"]
            Metrics["Metrics Endpoint<br/>8443/TCP HTTPS<br/>TLS<br/>Bearer Token + SubjectAccessReview"]
        end

        subgraph HealthProbes["Health Probes"]
            Health["8081/TCP HTTP<br/>/healthz (liveness)<br/>/readyz (readiness)<br/>No auth"]
        end

        ControllerManager["kueue-controller-manager<br/>SA: kueue-controller-manager<br/>FIPS: strictfipsruntime<br/>1 replica"]

        ControllerManager --- Webhook
        ControllerManager --- Metrics
        ControllerManager --- Health
    end

    subgraph Monitoring["MONITORING (Internal)"]
        Prometheus["Prometheus / OCP Monitoring<br/>ServiceMonitor + PrometheusRule"]
    end

    subgraph ManagedResources["MANAGED JOB FRAMEWORKS (Namespaced)"]
        Jobs["batch/Job<br/>PyTorchJob, TFJob, MPIJob<br/>RayJob, RayCluster<br/>JobSet, AppWrapper<br/>LeaderWorkerSet<br/>Deployment, StatefulSet"]
    end

    %% External to API Server
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC/cert"| K8sAPI

    %% API Server to Webhook (admission reviews)
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>API server client cert<br/>42 webhooks"| Webhook

    %% Controller to API Server (watches + CRUD)
    ControllerManager -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>kueue-manager-role"| K8sAPI

    %% Prometheus to Metrics
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>Bearer Token<br/>SubjectAccessReview"| Metrics

    %% Controller manages jobs via API server
    K8sAPI -.->|"Watch events<br/>Job/Workload/CRDs"| ControllerManager
    ControllerManager -.->|"Patch suspend<br/>Create Workloads"| Jobs

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef kueueservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class ControllerManager,Webhook,Metrics,Health kueueservice
    class Prometheus monitoring
    class Jobs managed
