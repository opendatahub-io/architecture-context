graph TD
    subgraph Container["Container Security Context"]
        User["Non-privileged User<br/>UID: 2000, GID: 0"]
    end

    subgraph AppAuth["Application-Level Authentication"]
        AuthMW["AuthenticationMiddleware<br/>(ASGI Middleware)"]
        APIKey["VLLM_API_KEY<br/>(env var or --api-key flag)"]
        HashCompare["SHA-256 Hash Comparison<br/>(secrets.compare_digest)"]
    end

    subgraph GuardedPrefixes["Auth-Guarded API Prefixes"]
        V1["Prefix: /v1/*<br/>OpenAI + Anthropic APIs"]
        V2["Prefix: /v2/*<br/>V2 Embed + Rerank"]
        Inference["Prefix: /inference/*<br/>Disaggregated Serving"]
    end

    subgraph UnguardedEndpoints["Unauthenticated Endpoints (by design)"]
        Health["/health, /ready, /readyz<br/>Kubernetes Probes"]
        Load["/load, /version<br/>Operational Metadata"]
        Tokenize["/tokenize, /detokenize<br/>Tokenization Utilities"]
        Legacy["/generate, /score, /rerank<br/>Legacy / Non-prefixed"]
        Profiling["/start_profile, /stop_profile<br/>Profiling Controls"]
        Scaling["/scale_elastic_ep<br/>Elastic EP Scaling"]
    end

    subgraph Secrets["Runtime Secrets (env vars)"]
        VllmKey["VLLM_API_KEY<br/>API auth token"]
        S3Key["S3_ACCESS_KEY_ID<br/>S3 access key"]
        S3Secret["S3_SECRET_ACCESS_KEY<br/>S3 secret key"]
        HFToken["HF_TOKEN<br/>Hugging Face auth"]
        MSToken["MODELSCOPE_API_TOKEN<br/>ModelScope auth"]
    end

    subgraph K8sRBAC["Kubernetes RBAC"]
        NoRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>(no K8s API interaction)"]
    end

    User -->|"runs as"| AuthMW
    APIKey -->|"configured via"| AuthMW
    AuthMW -->|"validates with"| HashCompare
    AuthMW -->|"guards"| V1
    AuthMW -->|"guards"| V2
    AuthMW -->|"guards"| Inference
    AuthMW -.->|"bypasses"| UnguardedEndpoints

    VllmKey -->|"used by"| AuthMW
    S3Key -->|"used by egress"| V1
    HFToken -->|"used by egress"| V1

    style User fill:#4a90e2,color:#fff
    style AuthMW fill:#f5a623,color:#fff
    style HashCompare fill:#f5a623,color:#fff
    style APIKey fill:#f5a623,color:#fff
    style V1 fill:#7ed321,color:#fff
    style V2 fill:#7ed321,color:#fff
    style Inference fill:#7ed321,color:#fff
    style Health fill:#e8e8e8,stroke:#999
    style Load fill:#e8e8e8,stroke:#999
    style Tokenize fill:#e8e8e8,stroke:#999
    style Legacy fill:#e8e8e8,stroke:#999
    style Profiling fill:#e8e8e8,stroke:#999
    style Scaling fill:#e8e8e8,stroke:#999
    style NoRBAC fill:#f9f9f9,stroke:#ccc
    style VllmKey fill:#fff2cc,stroke:#d6b656
    style S3Key fill:#fff2cc,stroke:#d6b656
    style S3Secret fill:#fff2cc,stroke:#d6b656
