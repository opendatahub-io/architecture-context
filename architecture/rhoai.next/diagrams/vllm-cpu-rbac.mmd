graph TD
    subgraph note["Note: No Kubernetes RBAC"]
        direction TB
        Info["vllm-cpu is a container image, not an operator.<br/>Kubernetes RBAC (ClusterRoles, RoleBindings) is<br/>managed by KServe and rhods-operator at the<br/>platform level."]
    end

    subgraph authz["Application-Level Authentication & Authorization"]
        direction TB

        subgraph api_key_auth["API Key Authentication (Optional)"]
            VLLM_API_KEY["VLLM_API_KEY<br/>(Environment Variable)"]
            FastAPIMiddleware["FastAPI Middleware<br/>(Enforcement Point)"]
            VLLM_API_KEY -->|"if set, enforces<br/>Bearer Token matching"| FastAPIMiddleware
        end

        subgraph protected["Protected Endpoints (Auth Required if API Key Set)"]
            ChatCompletions["/v1/chat/completions<br/>POST"]
            Completions["/v1/completions<br/>POST"]
            Responses["/v1/responses<br/>POST"]
            Models["/v1/models<br/>GET"]
            Tokenize["/tokenize<br/>POST"]
            Detokenize["/detokenize<br/>POST"]
            GenScoring["/generative_scoring<br/>POST"]
        end

        subgraph public["Public Endpoints (No Auth)"]
            Health["/health<br/>GET"]
            Ping["/ping<br/>GET/POST"]
            Render["/v1/*/render<br/>POST"]
            Derender["/v1/*/derender<br/>POST"]
        end

        subgraph grpc_no_auth["gRPC Endpoints (⚠ No Auth)"]
            VllmEngine["VllmEngine RPC<br/>50051/TCP"]
            HealthCheck["grpc.health.v1.Health<br/>50051/TCP"]
            Reflection["grpc.reflection<br/>50051/TCP"]
        end

        FastAPIMiddleware -->|"validates Bearer Token<br/>Authorization header"| protected
        FastAPIMiddleware -.->|"bypasses (always public)"| public
    end

    subgraph secrets["Secrets & Credentials"]
        direction TB
        HF_TOKEN["HF_TOKEN<br/>env var<br/>HuggingFace Hub Auth<br/>User-provisioned"]
        API_KEY["VLLM_API_KEY<br/>env var<br/>HTTP Endpoint Auth<br/>User/Platform-provisioned"]
        EXA_KEY["EXA_API_KEY<br/>env var<br/>Exa Web Search Auth<br/>User-provisioned (demo)"]
        SSL_CERT["ssl_certfile / ssl_keyfile<br/>File mount<br/>TLS Certificate & Key<br/>cert-manager / Manual<br/>Auto-refresh: enable_ssl_refresh"]
        SSL_CA["ssl_ca_certs<br/>File mount<br/>CA Certificate Chain<br/>Manual"]
    end

    %% Styling
    style Info fill:#fff3cd,stroke:#856404,color:#856404
    style VLLM_API_KEY fill:#4a90e2,stroke:#333,color:#fff
    style FastAPIMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style ChatCompletions fill:#d5e8d4,stroke:#82b366
    style Completions fill:#d5e8d4,stroke:#82b366
    style Responses fill:#d5e8d4,stroke:#82b366
    style Models fill:#d5e8d4,stroke:#82b366
    style Tokenize fill:#d5e8d4,stroke:#82b366
    style Detokenize fill:#d5e8d4,stroke:#82b366
    style GenScoring fill:#d5e8d4,stroke:#82b366
    style Health fill:#e8e8e8,stroke:#999
    style Ping fill:#e8e8e8,stroke:#999
    style Render fill:#e8e8e8,stroke:#999
    style Derender fill:#e8e8e8,stroke:#999
    style VllmEngine fill:#ffe6e6,stroke:#cc0000
    style HealthCheck fill:#ffe6e6,stroke:#cc0000
    style Reflection fill:#ffe6e6,stroke:#cc0000
    style HF_TOKEN fill:#f5a623,stroke:#333,color:#fff
    style API_KEY fill:#f5a623,stroke:#333,color:#fff
    style EXA_KEY fill:#f5a623,stroke:#333,color:#fff
