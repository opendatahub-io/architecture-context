graph TD
    subgraph "vllm-cpu Authentication & Authorization Model"
        direction TB

        subgraph "Note: No Kubernetes RBAC"
            NoRBAC["vllm-cpu is a containerized service,<br/>NOT an operator.<br/>No ClusterRoles, Roles, or RoleBindings."]
        end

        subgraph "Application-Level Auth"
            direction TB

            subgraph "HTTP API (8000/TCP)"
                APIKey["VLLM_API_KEY / --api-key<br/>(Optional Bearer Token)"]
                AuthMiddleware["AuthenticationMiddleware<br/>(FastAPI)"]

                subgraph "Protected Endpoints"
                    ChatCompletions["/v1/chat/completions<br/>POST"]
                    Completions["/v1/completions<br/>POST"]
                    Models["/v1/models<br/>GET"]
                    Tokenize["/tokenize<br/>POST"]
                    Detokenize["/detokenize<br/>POST"]
                    ServerInfo["/server_info<br/>GET (dev)"]
                end

                subgraph "Unprotected Endpoints (K8s Probes)"
                    Health["/health<br/>GET"]
                    Ready["/ready<br/>GET"]
                    Readyz["/readyz<br/>GET"]
                end
            end

            subgraph "gRPC (50051/TCP)"
                GRPCNote["⚠️ NO Authentication<br/>⚠️ NO TLS<br/>insecure_port binding"]
                Generate["vllm.Generate"]
                GenerateStream["vllm.Generate.GenerateStream"]
                GRPCHealth["grpc.health.v1.Health"]
                Reflection["grpc.reflection.v1alpha"]
            end
        end

        subgraph "Secrets & Credentials"
            HFToken["HF_TOKEN<br/>env var<br/>HuggingFace auth"]
            VLLMKey["VLLM_API_KEY<br/>env var<br/>API auth"]
            S3Key["S3_ACCESS_KEY_ID<br/>env var<br/>Storage auth"]
            S3Secret["S3_SECRET_ACCESS_KEY<br/>env var<br/>Storage auth"]
            SSLCert["SSL cert/key files<br/>filesystem<br/>TLS encryption<br/>Auto-refresh enabled"]
        end
    end

    %% Auth flow
    APIKey -->|"configures"| AuthMiddleware
    AuthMiddleware -->|"enforces on"| ChatCompletions
    AuthMiddleware -->|"enforces on"| Completions
    AuthMiddleware -->|"enforces on"| Models
    AuthMiddleware -->|"enforces on"| Tokenize
    AuthMiddleware -->|"enforces on"| Detokenize
    AuthMiddleware -->|"enforces on"| ServerInfo
    AuthMiddleware -.->|"bypasses"| Health
    AuthMiddleware -.->|"bypasses"| Ready
    AuthMiddleware -.->|"bypasses"| Readyz

    GRPCNote -->|"no enforcement"| Generate
    GRPCNote -->|"no enforcement"| GenerateStream
    GRPCNote -->|"no enforcement"| GRPCHealth
    GRPCNote -->|"no enforcement"| Reflection

    %% Styling
    style NoRBAC fill:#f0f0f0,stroke:#999,stroke-width:1px
    style APIKey fill:#4a90e2,stroke:#333,color:#fff
    style AuthMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style GRPCNote fill:#f8cecc,stroke:#b85450,stroke-width:2px

    style ChatCompletions fill:#d5e8d4,stroke:#82b366
    style Completions fill:#d5e8d4,stroke:#82b366
    style Models fill:#d5e8d4,stroke:#82b366
    style Tokenize fill:#d5e8d4,stroke:#82b366
    style Detokenize fill:#d5e8d4,stroke:#82b366
    style ServerInfo fill:#d5e8d4,stroke:#82b366

    style Health fill:#e1d5e7,stroke:#9673a6
    style Ready fill:#e1d5e7,stroke:#9673a6
    style Readyz fill:#e1d5e7,stroke:#9673a6

    style Generate fill:#f8cecc,stroke:#b85450
    style GenerateStream fill:#f8cecc,stroke:#b85450
    style GRPCHealth fill:#f8cecc,stroke:#b85450
    style Reflection fill:#f8cecc,stroke:#b85450

    style HFToken fill:#fff2cc,stroke:#d6b656
    style VLLMKey fill:#fff2cc,stroke:#d6b656
    style S3Key fill:#fff2cc,stroke:#d6b656
    style S3Secret fill:#fff2cc,stroke:#d6b656
    style SSLCert fill:#fff2cc,stroke:#d6b656
