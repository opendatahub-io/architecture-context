graph LR
    subgraph Metrics["Platform Metrics — RHOAI rhoai.next"]
        direction TB

        subgraph Stats["Component Statistics"]
            A["Total Components: 130"]
            B["Kubernetes Operators: 25+<br/>controller-runtime based"]
            C["Container Images: 120+<br/>across all components"]
            D["CRD Definitions: 236<br/>across all components"]
            E["ClusterServingRuntimes: 27<br/>vLLM x5 accel x3 chan + OVMS + MLServer"]
        end

        subgraph Security["Security Posture"]
            F["Gateway API Ingress: Primary path<br/>all new components use HTTPRoute"]
            G["mTLS Enforcement: MIXED<br/>Istio STRICT (legacy) + service-ca (Gateway API)"]
            H["Admission Webhooks: 304<br/>across 25 components"]
            I["FIPS Builds: Go operators<br/>strictfipsruntime + UBI 9 PQC"]
            J["Container Non-Root: Enforced<br/>UBI 9 + capability drops + SCCs"]
        end

        subgraph APIs["API Maturity"]
            K["CRD Versions: v1alpha1 (majority)<br/>v1beta1 (IS, Workspace)<br/>v1 (HardwareProfile, NIM)"]
            L["Gateway CRs: 2 primary<br/>data-science-gateway + maas-default-gateway"]
            M["Legacy Istio Gateways: 3<br/>transitional, migrating to Gateway API"]
            N["Serving Paths: 8 distinct<br/>KServe, llm-d, ModelMesh, MaaS,<br/>AI Gateway, Guardrails, legacy"]
        end

        subgraph Deploy["Deployment Readiness"]
            O["High Availability: Leader election<br/>for all operators; HPA for kube-auth-proxy"]
            P["Disconnected: Operator-level<br/>RELATED_IMAGE + OLM relatedImages<br/>per-component: unresolved"]
            Q["Multi-Architecture:<br/>amd64 full, arm64 partial,<br/>ppc64le partial, s390x partial"]
            R["Namespace Tiers: 4<br/>operator, application, ingress, user"]
        end

        subgraph Complexity["Architectural Complexity"]
            S["Operator Tiers: 3-deep<br/>platform → module → upstream"]
            T["Auth Mechanisms: 9 distinct<br/>ext_authz, Kuadrant, kube-rbac-proxy,<br/>TokenReview, Istio, provider-auth, ..."]
            U["Ingress Generations: 2 parallel<br/>Gateway API (current) + Istio (legacy)"]
            V["Webhook Cross-Cutting: 3 types<br/>Pod mutation, monitoring injection,<br/>workload scheduling"]
        end
    end

