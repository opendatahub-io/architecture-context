graph TB
    subgraph BatchGateway["llm-d-batch-gateway"]
        direction TB

        subgraph APIServer["API Server (8000/TCP + 8081/TCP)"]
            BatchHandler[Batch Handler<br/>/v1/batches/*]
            FileHandler[File Handler<br/>/v1/files/*]
            TenantMiddleware[Tenant Middleware<br/>X-MaaS-Username extraction]
            SecurityMiddleware[Security Headers<br/>Middleware]
            RecoveryMiddleware[Recovery<br/>Middleware]
            HealthAPI[Health/Ready/Metrics<br/>8081/TCP]
        end

        subgraph Processor["Processor (9090/TCP obs only)"]
            WorkerPool[Worker Pool<br/>configurable workers]
            JobRunner[Job Runner<br/>ingestion → execution → finalization]
            AIMDController[AIMD Controller<br/>Adaptive Concurrency]
            SyncDispatcher[Sync Dispatcher<br/>Direct HTTP]
            AsyncDispatcher[Async Dispatcher<br/>llm-d-async queues]
            PipelineExecutor[Pipeline Executor<br/>source → dispatch → collect]
            HealthProc[Health/Ready/Metrics<br/>9090/TCP]
        end

        subgraph GC["Garbage Collector (9091/TCP obs only)"]
            Collector[Expired Job/File<br/>Collector]
            Reconciler[Orphan Job<br/>Reconciler]
            HealthGC[Health/Metrics<br/>9091/TCP]
        end
    end

    %% Client interaction
    Client[External Client] -->|POST /v1/batches<br/>POST /v1/files| TenantMiddleware
    TenantMiddleware --> SecurityMiddleware
    SecurityMiddleware --> RecoveryMiddleware
    RecoveryMiddleware --> BatchHandler
    RecoveryMiddleware --> FileHandler

    %% API Server to backends
    BatchHandler -->|metadata CRUD| PostgreSQL[(PostgreSQL<br/>5432/TCP)]
    BatchHandler -->|job enqueue<br/>events, status| Redis[(Redis/Valkey<br/>6379/TCP)]
    FileHandler -->|file upload/download| S3[(S3 Storage<br/>443/TCP)]
    FileHandler -->|file metadata| PostgreSQL

    %% Processor flows
    WorkerPool --> JobRunner
    JobRunner --> PipelineExecutor
    PipelineExecutor --> AIMDController
    AIMDController --> SyncDispatcher
    AIMDController --> AsyncDispatcher
    WorkerPool -->|dequeue jobs| Redis
    SyncDispatcher -->|inference requests| LLMDRouter[llm-d Router]
    AsyncDispatcher -->|async dispatch| LLMDAsync[llm-d-async<br/>Redis Queues]
    JobRunner -->|read input files| S3
    JobRunner -->|upload results| S3
    JobRunner -->|update status| PostgreSQL

    %% GC flows
    Collector -->|query expired| PostgreSQL
    Collector -->|cleanup keys| Redis
    Collector -->|delete files| S3
    Reconciler -->|check in-flight| Redis
    Reconciler -->|re-enqueue orphans| Redis

    %% Auth delegation
    Gateway[Kuadrant/Authorino<br/>Gateway] -->|authenticated requests<br/>+ tenant header| Client

    %% Styling
    style APIServer fill:#4a90e2,color:#fff
    style Processor fill:#7ed321,color:#fff
    style GC fill:#f5a623,color:#fff
    style BatchHandler fill:#3a7bd5
    style FileHandler fill:#3a7bd5
    style WorkerPool fill:#6bc418
    style AIMDController fill:#6bc418
    style Collector fill:#e09620
    style Reconciler fill:#e09620
    style PostgreSQL fill:#336791,color:#fff
    style Redis fill:#dc382d,color:#fff
    style S3 fill:#569a31,color:#fff
    style LLMDRouter fill:#999,color:#fff
    style LLMDAsync fill:#999,color:#fff
    style Gateway fill:#e8e8e8
    style Client fill:#f9f9f9
