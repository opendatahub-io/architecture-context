graph TB
    subgraph BatchGateway["llm-d-batch-gateway"]
        subgraph APIServer["batch-gateway-apiserver<br/>(Deployment)"]
            APIMux["API Mux<br/>:8000/TCP"]
            ObsMux["Observability Mux<br/>:8081/TCP"]
            TenantMW["Tenant Middleware<br/>X-MaaS-Username"]
            SecHeaders["Security Headers MW"]
            APIMux --> TenantMW
            TenantMW --> SecHeaders
        end

        subgraph Processor["batch-gateway-processor<br/>(StatefulSet)"]
            Workers["Worker Pool<br/>num_workers=5"]
            Dispatcher["Dispatch Engine<br/>sync / async"]
            AIMD["AIMD Concurrency<br/>Controller"]
            Workers --> Dispatcher
            Dispatcher --> AIMD
        end

        subgraph GC["batch-gateway-gc<br/>(Deployment, 1 replica)"]
            Collector["Garbage Collector<br/>interval=30m"]
            Reconciler["Orphan Reconciler<br/>interval=60m"]
            PodWatcher["Pod Watcher"]
            Reconciler --> PodWatcher
        end
    end

    Client["External Client"] -->|"POST/GET /v1/batches<br/>POST/GET /v1/files<br/>8000/TCP"| APIMux

    APIMux -->|"metadata queries"| PostgreSQL["PostgreSQL"]
    APIMux -->|"file storage"| S3["S3-compatible Storage"]
    APIMux -->|"enqueue job"| Redis["Redis / Valkey"]

    Workers -->|"dequeue job"| Redis
    Workers -->|"read metadata"| PostgreSQL
    Dispatcher -->|"inference requests<br/>HTTP/HTTPS"| InferenceGW["llm-d Inference Gateway"]
    Dispatcher -->|"read input / write output"| S3
    Workers -->|"update status"| PostgreSQL

    Collector -->|"query expired"| PostgreSQL
    Collector -->|"delete files"| S3
    PodWatcher -->|"watch pods<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    Reconciler -->|"re-enqueue orphans"| Redis

    ObsMux -->|"metrics"| Prometheus["Prometheus"]
    APIMux -.->|"traces"| OTel["OpenTelemetry Collector"]

    style APIMux fill:#4a90e2
    style Workers fill:#4a90e2
    style Collector fill:#4a90e2
    style TenantMW fill:#50c878
    style AIMD fill:#50c878
    style Reconciler fill:#50c878
    style PostgreSQL fill:#f5a623
    style Redis fill:#f5a623
    style S3 fill:#f5a623
    style InferenceGW fill:#7ed321
    style K8sAPI fill:#e8e8e8
    style Prometheus fill:#e8e8e8
    style OTel fill:#e8e8e8
