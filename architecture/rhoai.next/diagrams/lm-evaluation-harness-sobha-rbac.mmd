graph TD
    subgraph "lm-evaluation-harness-sobha RBAC"
        direction TB

        Note["No RBAC resources defined in this repository.<br/>RBAC is managed by the launching operator<br/>(trustyai-service-operator)."]

        subgraph "Runtime Identity"
            Container["lmes-job Container<br/>UID: 65532 (non-root)"]
        end

        subgraph "Credential Sources (Environment Variables)"
            OPENAI["OPENAI_API_KEY<br/>Model endpoint auth"]
            HF["HF_TOKEN<br/>HuggingFace Hub auth"]
            ANTHROPIC["ANTHROPIC_API_KEY<br/>Anthropic API (optional)"]
            WATSONX["WATSONX_API_KEY<br/>WatsonX AI (optional)"]
            AWS_KEY["AWS_ACCESS_KEY_ID<br/>S3 storage auth"]
            AWS_SECRET["AWS_SECRET_ACCESS_KEY<br/>S3 storage auth"]
            REG_USER["REGISTRY_USERNAME<br/>OCI registry auth"]
            REG_PASS["REGISTRY_PASSWORD<br/>OCI registry auth"]
        end

        subgraph "Security Controls"
            PathProtection["Path Traversal Protection<br/>CWE-22 mitigation<br/>(restricts to /meta)"]
            SecretRedaction["Secret Redaction<br/>_sanitize_error_message<br/>(redacts tokens, keys, passwords)"]
            SymlinkReject["Symlink Rejection<br/>verify_certificate path validation"]
        end

        Container -->|"reads"| OPENAI
        Container -->|"reads"| HF
        Container -->|"reads"| ANTHROPIC
        Container -->|"reads"| WATSONX
        Container -->|"reads"| AWS_KEY
        Container -->|"reads"| AWS_SECRET
        Container -->|"reads"| REG_USER
        Container -->|"reads"| REG_PASS

        Container -->|"enforces"| PathProtection
        Container -->|"enforces"| SecretRedaction
        Container -->|"enforces"| SymlinkReject
    end

    subgraph "External RBAC (trustyai-service-operator)"
        OperatorSA["SA: controller-manager"]
        OperatorRole["ClusterRole:<br/>manages LMEvalJob CRDs"]
        JobCreation["Creates K8s Jobs<br/>with ServiceAccount"]

        OperatorSA -->|"bound to"| OperatorRole
        OperatorRole -->|"permits"| JobCreation
        JobCreation -->|"launches"| Container
    end

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style Container fill:#4a90e2,color:#fff
    style OPENAI fill:#f5a623,color:#000
    style HF fill:#f5a623,color:#000
    style ANTHROPIC fill:#f5a623,color:#000
    style WATSONX fill:#f5a623,color:#000
    style AWS_KEY fill:#f5a623,color:#000
    style AWS_SECRET fill:#f5a623,color:#000
    style REG_USER fill:#f5a623,color:#000
    style REG_PASS fill:#f5a623,color:#000
    style PathProtection fill:#7ed321,color:#000
    style SecretRedaction fill:#7ed321,color:#000
    style SymlinkReject fill:#7ed321,color:#000
    style OperatorSA fill:#e8e8e8,color:#000
    style OperatorRole fill:#e8e8e8,color:#000
    style JobCreation fill:#e8e8e8,color:#000
