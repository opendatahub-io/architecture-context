graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Argo["argo<br/>(workflow-controller)"]
        SA_ArgoServer["argo-server<br/>(argo server)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Argo["argo-binding<br/>(ClusterRoleBinding)"]
        CRB_Server["argo-server-binding<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Argo["argo-cluster-role"]
        CR_Server["argo-server-cluster-role"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        CR_View["argo-aggregate-to-view"]
        CR_Edit["argo-aggregate-to-edit"]
        CR_Admin["argo-aggregate-to-admin"]
    end

    subgraph ArgoResources["argoproj.io Resources"]
        Workflows["argoproj.io<br/>Workflow<br/>+ finalizers"]
        CronWorkflows["argoproj.io<br/>CronWorkflow<br/>+ finalizers"]
        WFTemplates["argoproj.io<br/>WorkflowTemplate"]
        ClusterWFT["argoproj.io<br/>ClusterWorkflowTemplate"]
        WFTaskSets["argoproj.io<br/>WorkflowTaskSet<br/>+ finalizers"]
        WFTaskResults["argoproj.io<br/>WorkflowTaskResult"]
        WFArtifactGC["argoproj.io<br/>WorkflowArtifactGCTask"]
        WFEventBindings["argoproj.io<br/>WorkflowEventBinding"]
        EventSources["argoproj.io<br/>EventSource"]
        Sensors["argoproj.io<br/>Sensor"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["core<br/>Pods, Pods/exec"]
        ConfigMaps["core<br/>ConfigMaps"]
        Secrets["core<br/>Secrets"]
        PVCs["core<br/>PersistentVolumeClaims<br/>+ finalizers"]
        SvcAccounts["core<br/>ServiceAccounts"]
        Events["core<br/>Events"]
        PDBs["policy<br/>PodDisruptionBudgets"]
    end

    %% Controller bindings
    SA_Argo -->|"bound via"| CRB_Argo
    CRB_Argo -->|"grants"| CR_Argo

    %% Controller permissions - argoproj.io
    CR_Argo -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| Workflows
    CR_Argo -->|"get,list,watch,<br/>update,patch,delete"| CronWorkflows
    CR_Argo -->|"get,list,watch"| WFTemplates
    CR_Argo -->|"get,list,watch"| ClusterWFT
    CR_Argo -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| WFTaskSets
    CR_Argo -->|"list,watch,<br/>deletecollection"| WFTaskResults
    CR_Argo -->|"get,list,watch,<br/>create,update,<br/>patch,delete"| WFArtifactGC

    %% Controller permissions - core
    CR_Argo -->|"create,get,list,<br/>watch,update,<br/>patch,delete"| Pods
    CR_Argo -->|"get,watch,list"| ConfigMaps
    CR_Argo -->|"create,update,<br/>delete,get"| PVCs
    CR_Argo -->|"get,list"| SvcAccounts
    CR_Argo -->|"create,patch"| Events
    CR_Argo -->|"create,get,delete"| PDBs

    %% Server bindings
    SA_ArgoServer -->|"bound via"| CRB_Server
    CRB_Server -->|"grants"| CR_Server

    %% Server permissions
    CR_Server -->|"get,list,watch,<br/>create,delete,patch"| ConfigMaps
    CR_Server -->|"get,list,watch,<br/>create,delete,patch"| Secrets
    CR_Server -->|"get,list,watch,<br/>create,delete,patch"| Pods
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| Workflows
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| WFTemplates
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| CronWorkflows
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| ClusterWFT
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| EventSources
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| Sensors
    CR_Server -->|"create,get,list,watch,<br/>update,patch,delete"| WFEventBindings

    %% Aggregate roles
    CR_View -->|"get,list,watch"| Workflows
    CR_View -->|"get,list,watch"| WFEventBindings
    CR_View -->|"get,list,watch"| WFTemplates
    CR_View -->|"get,list,watch"| CronWorkflows
    CR_View -->|"get,list,watch"| ClusterWFT

    CR_Edit -->|"full CRUD"| Workflows
    CR_Edit -->|"full CRUD"| WFTemplates
    CR_Edit -->|"full CRUD"| CronWorkflows

    CR_Admin -->|"full CRUD<br/>+ workflowtasksets"| Workflows
    CR_Admin -->|"full CRUD"| WFTaskSets

    %% Styling
    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style SA_ArgoServer fill:#4a90e2,stroke:#333,color:#fff
    style CR_Argo fill:#f5a623,stroke:#333
    style CR_Server fill:#f5a623,stroke:#333
    style CR_View fill:#b8d4e3,stroke:#333
    style CR_Edit fill:#b8d4e3,stroke:#333
    style CR_Admin fill:#b8d4e3,stroke:#333
    style Workflows fill:#7ed321,stroke:#333
    style CronWorkflows fill:#7ed321,stroke:#333
    style WFTemplates fill:#7ed321,stroke:#333
    style ClusterWFT fill:#7ed321,stroke:#333
    style WFTaskSets fill:#7ed321,stroke:#333
    style WFTaskResults fill:#7ed321,stroke:#333
    style WFArtifactGC fill:#7ed321,stroke:#333
    style WFEventBindings fill:#7ed321,stroke:#333
    style EventSources fill:#7ed321,stroke:#333
    style Sensors fill:#7ed321,stroke:#333
    style Pods fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets fill:#e8e8e8,stroke:#333
    style PVCs fill:#e8e8e8,stroke:#333
    style SvcAccounts fill:#e8e8e8,stroke:#333
    style Events fill:#e8e8e8,stroke:#333
    style PDBs fill:#e8e8e8,stroke:#333
