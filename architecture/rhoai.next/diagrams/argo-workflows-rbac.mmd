graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Argo["argo<br/>(workflow-controller)"]
        SA_Server["argo-server"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Argo["argo-binding<br/>(ClusterRoleBinding)"]
        RB_Argo["argo-binding<br/>(RoleBinding, ns: argo)"]
        CRB_Server["argo-server-binding<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Argo["argo-cluster-role"]
        CR_Server["argo-server-cluster-role"]
    end

    subgraph ArgoCRResources["argo-cluster-role Resources"]
        direction TB
        Pods_CR["core / pods, pods/exec<br/>create, get, list, watch,<br/>update, patch, delete"]
        ConfigMaps_CR["core / configmaps<br/>get, watch, list"]
        PVCs_CR["core / persistentvolumeclaims<br/>+ finalizers<br/>create, update, delete, get"]
        Workflows_CR["argoproj.io / workflows,<br/>workflowtasksets + finalizers,<br/>workflowartifactgctasks<br/>get, list, watch, update,<br/>patch, delete, create"]
        Templates_CR["argoproj.io / workflowtemplates,<br/>clusterworkflowtemplates<br/>+ finalizers<br/>get, list, watch"]
        TaskResults_CR["argoproj.io / workflowtaskresults<br/>list, watch, deletecollection"]
        CronWFs_CR["argoproj.io / cronworkflows<br/>+ finalizers<br/>get, list, watch, update,<br/>patch, delete"]
        Events_CR["core / events<br/>create, patch"]
        PDBs_CR["policy / poddisruptionbudgets<br/>create, get, delete"]
        Secrets_CR["core / secrets<br/>get<br/>(argo-workflows-agent-ca-certificates)"]
    end

    subgraph ServerResources["argo-server-cluster-role Resources"]
        direction TB
        ConfigMaps_SR["core / configmaps<br/>get, watch, list"]
        Secrets_SR["core / secrets<br/>get, create"]
        Pods_SR["core / pods, pods/exec,<br/>pods/log<br/>get, list, watch, delete"]
        Events_SR["core / events<br/>watch, create, patch"]
        ServiceAccounts_SR["core / serviceaccounts<br/>get, list, watch"]
        AllArgoCRDs_SR["argoproj.io / eventsources,<br/>sensors, workflows,<br/>workfloweventbindings,<br/>workflowtemplates,<br/>cronworkflows,<br/>clusterworkflowtemplates<br/>create, get, list, watch,<br/>update, patch, delete"]
    end

    %% Bindings
    SA_Argo -->|"bound via"| CRB_Argo
    SA_Argo -->|"bound via"| RB_Argo
    CRB_Argo -->|"grants"| CR_Argo
    RB_Argo -->|"grants"| CR_Argo

    SA_Server -->|"bound via"| CRB_Server
    CRB_Server -->|"grants"| CR_Server

    %% Permissions
    CR_Argo -->|"permits"| Pods_CR
    CR_Argo -->|"permits"| ConfigMaps_CR
    CR_Argo -->|"permits"| PVCs_CR
    CR_Argo -->|"permits"| Workflows_CR
    CR_Argo -->|"permits"| Templates_CR
    CR_Argo -->|"permits"| TaskResults_CR
    CR_Argo -->|"permits"| CronWFs_CR
    CR_Argo -->|"permits"| Events_CR
    CR_Argo -->|"permits"| PDBs_CR
    CR_Argo -->|"permits"| Secrets_CR

    CR_Server -->|"permits"| ConfigMaps_SR
    CR_Server -->|"permits"| Secrets_SR
    CR_Server -->|"permits"| Pods_SR
    CR_Server -->|"permits"| Events_SR
    CR_Server -->|"permits"| ServiceAccounts_SR
    CR_Server -->|"permits"| AllArgoCRDs_SR

    %% Styling
    style SA_Argo fill:#4a90e2,color:#fff
    style SA_Server fill:#4a90e2,color:#fff
    style CR_Argo fill:#f5a623,color:#fff
    style CR_Server fill:#f5a623,color:#fff
    style CRB_Argo fill:#e8e8e8
    style RB_Argo fill:#e8e8e8
    style CRB_Server fill:#e8e8e8
    style Workflows_CR fill:#7ed321,color:#fff
    style AllArgoCRDs_SR fill:#7ed321,color:#fff
