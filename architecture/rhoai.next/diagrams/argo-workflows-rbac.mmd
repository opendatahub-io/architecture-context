graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Argo["SA: argo<br/>(workflow-controller)"]
        SA_ArgoServer["SA: argo-server<br/>(not shipped in RHOAI)"]
    end

    subgraph ClusterRoleBindings["ClusterRoleBindings"]
        CRB_Argo["argo-binding<br/>(ClusterRoleBinding)"]
        CRB_ArgoServer["argo-server-binding<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["RoleBindings (ns: argo)"]
        RB_Argo["argo-binding<br/>(RoleBinding, ns: argo)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Argo["argo-cluster-role"]
        CR_ArgoServer["argo-server-cluster-role<br/>(not shipped in RHOAI)"]
    end

    subgraph Roles["Roles (ns: argo)"]
        R_Argo["argo-role"]
    end

    subgraph AggregateRoles["Aggregate ClusterRoles"]
        CR_View["argo-aggregate-to-view"]
        CR_Edit["argo-aggregate-to-edit"]
        CR_Admin["argo-aggregate-to-admin"]
    end

    %% Bindings
    SA_Argo -->|bound via| CRB_Argo
    SA_Argo -->|bound via| RB_Argo
    SA_ArgoServer -->|bound via| CRB_ArgoServer

    CRB_Argo -->|grants| CR_Argo
    RB_Argo -->|grants| R_Argo
    CRB_ArgoServer -->|grants| CR_ArgoServer

    %% argo-cluster-role resources
    subgraph ArgoResources["argo-cluster-role Resources"]
        Pods["core: pods, pods/exec<br/>create, get, list, watch,<br/>update, patch, delete"]
        ConfigMaps["core: configmaps<br/>get, watch, list"]
        PVCs["core: persistentvolumeclaims<br/>create, update, delete, get"]
        Workflows["argoproj.io: workflows,<br/>workflows/finalizers<br/>full CRUD"]
        TaskSets["argoproj.io: workflowtasksets,<br/>workflowartifactgctasks<br/>full CRUD"]
        Templates["argoproj.io: workflowtemplates,<br/>clusterworkflowtemplates<br/>get, list, watch"]
        TaskResults["argoproj.io: workflowtaskresults<br/>list, watch, deletecollection"]
        CronWFs["argoproj.io: cronworkflows<br/>full CRUD"]
        Events["core: events<br/>create, patch"]
        PDBs["policy: poddisruptionbudgets<br/>create, get, delete"]
        AgentSecret["core: secrets<br/>(only: argo-workflows-agent-ca-certificates)<br/>get"]
    end

    CR_Argo -->|manages| Pods
    CR_Argo -->|manages| ConfigMaps
    CR_Argo -->|manages| PVCs
    CR_Argo -->|manages| Workflows
    CR_Argo -->|manages| TaskSets
    CR_Argo -->|manages| Templates
    CR_Argo -->|manages| TaskResults
    CR_Argo -->|manages| CronWFs
    CR_Argo -->|manages| Events
    CR_Argo -->|manages| PDBs
    CR_Argo -->|manages| AgentSecret

    %% argo-role resources
    subgraph ArgoRoleResources["argo-role Resources (ns: argo)"]
        Leases["coordination.k8s.io: leases<br/>create, get, update"]
        Secrets["core: secrets<br/>get"]
    end

    R_Argo -->|manages| Leases
    R_Argo -->|manages| Secrets

    %% Styling
    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style SA_ArgoServer fill:#999,stroke:#333,color:#fff
    style CR_Argo fill:#f5a623,stroke:#333
    style CR_ArgoServer fill:#999,stroke:#333,color:#fff
    style R_Argo fill:#f5a623,stroke:#333
    style CR_View fill:#7ed321,stroke:#333
    style CR_Edit fill:#7ed321,stroke:#333
    style CR_Admin fill:#7ed321,stroke:#333
    style CRB_Argo fill:#d5e8d4,stroke:#82b366
    style CRB_ArgoServer fill:#ccc,stroke:#333
    style RB_Argo fill:#d5e8d4,stroke:#82b366
    style Workflows fill:#fff2cc,stroke:#d6b656
    style TaskSets fill:#fff2cc,stroke:#d6b656
    style CronWFs fill:#fff2cc,stroke:#d6b656
    style Pods fill:#ffe6cc,stroke:#d79b00
    style AgentSecret fill:#f8cecc,stroke:#b85450
    style Secrets fill:#f8cecc,stroke:#b85450
