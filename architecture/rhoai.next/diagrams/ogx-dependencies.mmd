graph LR
    OGX["OGX<br/>(Llama Stack Server)"]

    %% Core Runtime Dependencies
    subgraph CoreRuntime["Core Runtime"]
        Python["Python 3.10+"]
        FastAPI["FastAPI >=0.115.0"]
        Uvicorn["Uvicorn (ASGI)"]
        Pydantic["Pydantic >=2"]
    end

    OGX -->|runtime| Python
    OGX -->|HTTP framework| FastAPI
    OGX -->|ASGI server| Uvicorn
    OGX -->|validation| Pydantic

    %% Auth & Security Dependencies
    subgraph AuthDeps["Auth & Security"]
        PythonJose["python-jose 3.4.0<br/>(NOT FIPS-validated)"]
        HTTPX["httpx (async)"]
    end

    OGX -->|JWT validation| PythonJose
    OGX -->|auth introspection| HTTPX

    %% AI/ML Dependencies
    subgraph AIDeps["AI/ML Libraries"]
        OpenAISDK["openai SDK >=1.66"]
        Tiktoken["tiktoken 0.9.0"]
        HFHub["huggingface-hub"]
        Jinja2["Jinja2 >=3.1.6"]
    end

    OGX -->|OpenAI-compat providers| OpenAISDK
    OGX -->|token counting| Tiktoken
    OGX -->|model download| HFHub
    OGX -->|prompt templates| Jinja2

    %% Inference Provider Integrations
    subgraph InferenceProviders["Inference Providers (Remote)"]
        Ollama["Ollama<br/>11434/TCP"]
        vLLM["vLLM<br/>8000/TCP"]
        TGI["TGI<br/>8080/TCP"]
        OpenAI["OpenAI API<br/>443/TCP"]
        Anthropic["Anthropic API<br/>443/TCP"]
        Bedrock["AWS Bedrock<br/>443/TCP"]
        NVIDIA["NVIDIA NIM<br/>443/TCP"]
    end

    OGX -->|local inference| Ollama
    OGX -->|remote inference| vLLM
    OGX -->|HF inference| TGI
    OGX -->|cloud inference| OpenAI
    OGX -->|cloud inference| Anthropic
    OGX -->|cloud inference| Bedrock
    OGX -->|inference + safety| NVIDIA

    %% Vector DB Integrations
    subgraph VectorDBs["Vector Databases"]
        FAISS["FAISS (inline)"]
        SQLiteVec["SQLite-vec (inline)"]
        ChromaDB["ChromaDB<br/>8000/TCP"]
        Qdrant["Qdrant<br/>6333/TCP"]
        Milvus["Milvus<br/>19530/TCP"]
        Weaviate["Weaviate<br/>8080/TCP"]
    end

    OGX -->|in-process vector| FAISS
    OGX -->|in-process vector| SQLiteVec
    OGX -->|remote vector| ChromaDB
    OGX -->|remote vector| Qdrant
    OGX -->|remote vector| Milvus
    OGX -->|remote vector| Weaviate

    %% Data Store Integrations
    subgraph DataStores["Data Stores"]
        SQLite["SQLite (default)"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        Redis["Redis<br/>6379/TCP"]
        MongoDB["MongoDB<br/>27017/TCP"]
    end

    OGX -->|default KV/SQL store| SQLite
    OGX -->|production KV/SQL/pgvector| PostgreSQL
    OGX -->|KV cache| Redis
    OGX -->|KV document store| MongoDB

    %% Tool & Observability Integrations
    subgraph ToolIntegrations["Tools & Observability"]
        BraveSearch["Brave Search<br/>443/TCP"]
        BingSearch["Bing Search<br/>443/TCP"]
        Tavily["Tavily Search<br/>443/TCP"]
        Wolfram["Wolfram Alpha<br/>443/TCP"]
        MCPServers["MCP Servers<br/>HTTP/stdio"]
        OTelSDK["OpenTelemetry SDK"]
        OTelCollector["OTel Collector<br/>4318/TCP"]
    end

    OGX -->|web search| BraveSearch
    OGX -->|web search| BingSearch
    OGX -->|AI search| Tavily
    OGX -->|computation| Wolfram
    OGX -->|tool protocol| MCPServers
    OGX -.->|tracing (optional)| OTelSDK
    OTelSDK -->|OTLP export| OTelCollector

    %% Auth Services
    subgraph AuthServices["Auth Services"]
        OIDC["OIDC/OAuth2 Provider<br/>443/TCP"]
    end

    OGX -->|JWT validation| OIDC

    %% Client SDK
    subgraph ClientSide["Client"]
        ClientSDK["llama-stack-client<br/>>=0.2.10"]
    end

    ClientSDK -->|API calls| OGX

