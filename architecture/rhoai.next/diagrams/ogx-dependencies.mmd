graph LR
    OGX["OGX Server<br/>(Llama Stack)"]

    %% Core Framework Dependencies
    OGX -->|"HTTP framework"| FastAPI["FastAPI >=0.115.0"]
    OGX -->|"ASGI server"| Uvicorn["Uvicorn"]
    OGX -->|"data validation"| Pydantic["Pydantic >=2"]
    OGX -->|"async HTTP"| HTTPX["httpx ==0.28.1"]

    %% Auth & Security Dependencies
    OGX -->|"JWT validation"| PythonJose["python-jose ==3.4.0"]
    PythonJose -.->|"pure-Python crypto<br/>(FIPS risk)"| ECDSA["ecdsa ==0.19.1"]
    PythonJose -.->|"pure-Python crypto<br/>(FIPS risk)"| RSA["rsa ==4.9"]

    %% AI/ML Dependencies
    OGX -->|"OpenAI SDK"| OpenAISDK["openai >=1.66"]
    OGX -->|"tokenization"| Tiktoken["tiktoken ==0.9.0"]
    OGX -->|"model hub"| HFHub["huggingface-hub ==0.29.0"]
    OGX -->|"numerical"| NumPy["numpy ==2.2.3"]
    OGX -->|"image processing"| Pillow["pillow ==11.1.0"]

    %% Config & Templating
    OGX -->|"YAML config"| PyYAML["pyyaml ==6.0.2"]
    OGX -->|"prompt templates"| Jinja2["jinja2 >=3.1.6"]
    OGX -->|"schema validation"| JSONSchema["jsonschema ==4.23.0"]

    %% Internal Platform Dependencies
    OGX ==>|"container image"| OGXDist["ogx-distribution"]
    OGX ==>|"K8s lifecycle"| OGXOp["ogx-k8s-operator"]

    %% Remote Provider Backends
    OGX -->|"inference delegation"| VLLM["vLLM"]
    OGX -->|"inference delegation"| TGI["TGI"]
    OGX -->|"inference delegation"| OpenAIAPI["OpenAI API"]
    OGX -->|"inference delegation"| CloudProviders["Fireworks / Together /<br/>Cerebras / SambaNova /<br/>NVIDIA / WatsonX"]

    %% External Services
    OGX -->|"web search tool"| Tavily["Tavily API"]
    OGX -->|"tool integration"| MCP["MCP Servers"]

    %% Data Store Dependencies
    OGX -->|"vector storage"| VectorStores["Chroma / Milvus /<br/>PgVector / Qdrant /<br/>Weaviate / SQLite-vec"]
    OGX -->|"KV storage"| KVStores["PostgreSQL / Redis /<br/>MongoDB / SQLite"]

    %% Optional
    OGX -.->|"optional UI"| Streamlit["Streamlit"]

