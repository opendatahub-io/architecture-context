graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>API key / SA token / OpenShift token"]
    end

    subgraph GatewayZone["GATEWAY (Auth Enforcement)"]
        AuthGW["Kuadrant / Authorino<br/>AuthN + AuthZ<br/>Extracts X-MaaS-Username"]
    end

    subgraph IngressZone["INGRESS (Gateway API)"]
        HTTPRoute["HTTPRoute<br/>{release}-apiserver<br/>8000/TCP"]
    end

    subgraph InternalServices["INTERNAL SERVICES (Cluster Network)"]
        direction TB

        subgraph APISrv["API Server"]
            APIServer["batch-gateway-apiserver<br/>8000/TCP (API) + 8081/TCP (obs)<br/>UID 65532, RO rootfs<br/>Caps: ALL dropped<br/>Seccomp: RuntimeDefault"]
        end

        subgraph ProcSrv["Processor"]
            Processor["batch-gateway-processor<br/>9090/TCP (obs only)<br/>UID 65532, RO rootfs<br/>Caps: ALL dropped<br/>AIMD concurrency control"]
        end

        subgraph GCSrv["Garbage Collector"]
            GarbageCollector["batch-gateway-gc<br/>9091/TCP (obs only)<br/>UID 65532, RO rootfs<br/>Caps: ALL dropped<br/>Singleton replica"]
        end
    end

    subgraph DataStores["DATA STORES"]
        PG["PostgreSQL<br/>5432/TCP<br/>TLS configurable<br/>Conn string auth"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>TLS + mTLS optional<br/>Conn string auth"]
        S3["S3 Storage<br/>443/TCP<br/>TLS 1.2+<br/>AWS IAM / access key"]
    end

    subgraph InferenceLayer["INFERENCE LAYER"]
        Router["llm-d Router<br/>configurable port<br/>TLS 1.2+ + mTLS optional<br/>Bearer token optional"]
        AsyncRedis["llm-d-async Redis<br/>6379/TCP<br/>TLS optional<br/>Conn string auth"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OTel Collector<br/>4317/TCP gRPC<br/>Configurable encryption"]
        Prom["Prometheus<br/>HTTP scrape<br/>8081, 9090, 9091/TCP"]
    end

    %% External → Gateway
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>API key / SA token"| AuthGW

    %% Gateway → Ingress
    AuthGW -->|"HTTP(S)/8000<br/>TLS 1.2+ optional<br/>+ X-MaaS-Username"| HTTPRoute

    %% Ingress → API Server
    HTTPRoute -->|"HTTP(S)/8000<br/>ClusterIP"| APIServer

    %% API Server → Data Stores
    APIServer -->|"TCP/5432<br/>TLS configurable<br/>Conn string"| PG
    APIServer -->|"TCP/6379<br/>TLS optional<br/>Conn string"| Redis
    APIServer -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3

    %% Processor → Data Stores
    Processor -->|"TCP/5432<br/>TLS configurable"| PG
    Processor -->|"TCP/6379<br/>TLS optional"| Redis
    Processor -->|"HTTPS/443<br/>TLS 1.2+"| S3

    %% Processor → Inference
    Processor -->|"HTTP(S)<br/>TLS 1.2+ + mTLS<br/>Bearer token"| Router
    Processor -->|"TCP/6379<br/>TLS optional<br/>Async dispatch"| AsyncRedis

    %% Processor → Observability
    Processor -->|"gRPC/4317<br/>OTLP traces"| OTel

    %% GC → Data Stores
    GarbageCollector -->|"TCP/5432<br/>TLS configurable"| PG
    GarbageCollector -->|"TCP/6379<br/>TLS optional"| Redis
    GarbageCollector -->|"HTTPS/443<br/>TLS 1.2+"| S3

    %% Prometheus scrape
    Prom -.->|"HTTP/8081<br/>metrics scrape"| APIServer
    Prom -.->|"HTTP/9090<br/>metrics scrape"| Processor
    Prom -.->|"HTTP/9091<br/>metrics scrape"| GarbageCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#e6ccff,stroke:#7c3aed,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#f0f0f0,stroke:#666,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class AuthGW gateway
    class HTTPRoute ingress
    class APIServer,Processor,GarbageCollector internal
    class PG,Redis,S3 datastore
    class Router,AsyncRedis inference
    class OTel,Prom observability
