graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph GatewayZone["INGRESS (Gateway Layer)"]
        ExtGW["External Gateway<br/>(Kuadrant/Authorino)<br/>Auth: Bearer Token / API Key<br/>TLS Termination"]
    end

    subgraph AppLayer["APPLICATION LAYER (Cluster Internal)"]
        direction TB

        subgraph APIServerNS["API Server (Deployment)"]
            APISvc["apiserver Service<br/>ClusterIP<br/>8000/TCP (API) + 8081/TCP (obs)<br/>Optional TLS 1.2+<br/>Auth: None (delegated)"]
        end

        subgraph ProcessorNS["Processor (StatefulSet)"]
            ProcPod["processor Pods<br/>Headless Service<br/>9090/TCP (metrics)<br/>Stable pod identity"]
        end

        subgraph GCNS["GC (Deployment, 1 replica)"]
            GCPod["gc Pod<br/>9091/TCP (metrics)<br/>SA: gc-sa"]
        end
    end

    subgraph DataStores["DATA STORES"]
        PG["PostgreSQL<br/>TCP<br/>Connection URL auth<br/>Row-level tenant isolation"]
        RedisStore["Redis / Valkey<br/>TCP<br/>Connection URL auth<br/>Shared queue namespace"]
        S3Store["S3-compatible Storage<br/>HTTP/HTTPS<br/>AWS credentials"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        InferGW["llm-d Inference Gateway<br/>HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>Optional API key"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        OTelCol["OpenTelemetry Collector<br/>OTLP/gRPC"]
        Prom["Prometheus<br/>HTTP scrape"]
    end

    %% External flows
    Client -->|"HTTPS<br/>TLS<br/>Auth: Bearer Token"| ExtGW
    ExtGW -->|"HTTP/HTTPS<br/>8000/TCP<br/>X-MaaS-Username header<br/>No auth at app layer"| APISvc

    %% API Server flows
    APISvc -->|"TCP<br/>Connection URL auth"| PG
    APISvc -->|"TCP<br/>Connection URL auth"| RedisStore
    APISvc -->|"HTTP/HTTPS<br/>AWS credentials"| S3Store
    APISvc -.->|"OTLP/gRPC"| OTelCol

    %% Processor flows
    ProcPod -->|"TCP<br/>Connection URL auth"| PG
    ProcPod -->|"TCP<br/>Connection URL auth"| RedisStore
    ProcPod -->|"HTTP/HTTPS<br/>AWS credentials"| S3Store
    ProcPod -->|"HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>Optional API key"| InferGW
    ProcPod -.->|"OTLP/gRPC"| OTelCol

    %% GC flows
    GCPod -->|"TCP<br/>Connection URL auth"| PG
    GCPod -->|"TCP<br/>Connection URL auth"| RedisStore
    GCPod -->|"HTTP/HTTPS<br/>AWS credentials"| S3Store
    GCPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Monitoring
    Prom -.->|"HTTP scrape<br/>8081/TCP"| APISvc
    Prom -.->|"HTTP scrape<br/>9090/TCP"| ProcPod
    Prom -.->|"HTTP scrape<br/>9091/TCP"| GCPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class ExtGW gateway
    class APISvc,ProcPod,GCPod app
    class PG,RedisStore,S3Store datastore
    class InferGW,K8sAPI,OTelCol,Prom platform
