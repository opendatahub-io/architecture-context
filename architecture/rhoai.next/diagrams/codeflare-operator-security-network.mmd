graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
        ExtUser["External User<br/>(Dashboard Access)"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        DashRoute["ray-dashboard Route<br/>443/TCP → 8443/TCP<br/>TLS Reencrypt"]
        ClientRoute["rayclient Route<br/>443/TCP → 10001/TCP<br/>TLS Passthrough"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB
        Operator["codeflare-operator<br/>SA: controller-manager"]
        WebhookSvc["Webhook Service<br/>443→9443/TCP<br/>TLS (cert-controller)"]
        MetricsSvc["Metrics Service<br/>8080/TCP<br/>HTTP, No Auth"]
    end

    subgraph UserNS["USER NAMESPACE (per RayCluster)"]
        direction TB
        OAuthSvc["{raycluster}-oauth Service<br/>443→8443/TCP<br/>TLS (service-serving-cert)"]

        subgraph HeadPod["Ray Head Pod"]
            OAuthProxy["oauth-proxy sidecar<br/>8443/TCP HTTPS"]
            Dashboard["Ray Dashboard<br/>8265/TCP HTTP<br/>(localhost only)"]
            RayClient["Ray Client<br/>10001/TCP gRPC mTLS"]
            InitCont["mTLS Init Container<br/>(cert generation)"]
        end

        subgraph WorkerPods["Ray Worker Pods"]
            Worker["Ray Worker<br/>mTLS Init Container"]
        end

        NWP["NetworkPolicy<br/>Head: intra-cluster + operator NS + monitoring<br/>Worker: same-cluster only"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+, SA Token"]
        OSAuth["OpenShift OAuth<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        RouteAPI["OpenShift Route API<br/>443/TCP HTTPS<br/>TLS 1.2+, SA Token"]
        Monitoring["Prometheus<br/>(openshift-monitoring)<br/>8080/TCP HTTP"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    ExtUser -->|"HTTPS/443<br/>TLS Reencrypt<br/>OAuth"| DashRoute
    ExtUser -->|"HTTPS/443<br/>TLS Passthrough"| ClientRoute

    %% Ingress flows
    DashRoute -->|"HTTPS/8443<br/>TLS<br/>OAuth"| OAuthSvc
    ClientRoute -->|"gRPC/10001<br/>mTLS"| RayClient
    OAuthSvc --> OAuthProxy

    %% OAuth flow
    OAuthProxy -->|"HTTP/8265<br/>localhost<br/>No Auth"| Dashboard
    OAuthProxy -->|"HTTPS/443<br/>OAuth"| OSAuth

    %% Operator flows
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>API server mTLS"| WebhookSvc
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token"| RouteAPI
    Monitoring -->|"HTTP/8080<br/>No Auth"| MetricsSvc

    %% mTLS internal
    RayClient -->|"gRPC/10001<br/>mTLS<br/>Client Cert"| Worker

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operatorns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef userns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User,ExtUser external
    class DashRoute,ClientRoute ingress
    class Operator,WebhookSvc,MetricsSvc operatorns
    class OAuthSvc,OAuthProxy,Dashboard,RayClient,InitCont,Worker,NWP userns
    class K8sAPI,OSAuth,RouteAPI,Monitoring externalservice
