graph TB
    subgraph "llm-d-kv-cache"
        subgraph "Go Core Libraries"
            Indexer["kvcache.Indexer<br/>Orchestrator"]
            TokenProcessor["kvblock.TokenProcessor<br/>FNV-64a / CBOR"]
            Index["kvblock.Index<br/>Pluggable Backend"]
            Pool["kvevents.Pool<br/>Sharded Workers"]
            Reconciler["PodReconciler<br/>controller-runtime"]
        end

        subgraph "Service Layer"
            KVCacheManager["kv-cache-manager<br/>8080/TCP HTTP"]
            IndexerGRPC["IndexerService<br/>50051/TCP gRPC"]
        end

        subgraph "Sidecar / Utilities"
            UDSTokenizer["UDS Tokenizer<br/>Python gRPC Sidecar<br/>UDS + 8082/TCP health"]
            PVCEvictor["PVC Evictor<br/>N+2 Multi-Process"]
            FSBackend["llmd-fs-backend<br/>CUDA Extension<br/>deprecated"]
        end

        subgraph "Index Backends"
            InMemLRU["In-Memory LRU"]
            CostAware["Cost-Aware Memory<br/>Ristretto"]
            RedisBackend["Redis Backend"]
            ValkeyBackend["Valkey Backend"]
        end
    end

    %% Internal flows
    KVCacheManager -->|"delegates"| Indexer
    IndexerGRPC -->|"wraps"| Indexer
    Indexer -->|"computes block keys"| TokenProcessor
    Indexer -->|"lookup & score"| Index
    Pool -->|"updates"| Index
    Reconciler -->|"manages subscribers"| Pool

    Index -->|"backend"| InMemLRU
    Index -->|"backend"| CostAware
    Index -->|"backend"| RedisBackend
    Index -->|"backend"| ValkeyBackend

    KVCacheManager -->|"gRPC/UDS"| UDSTokenizer

    %% External interactions
    Client["llm-d-router<br/>Primary Consumer"] -->|"embeds library"| Indexer
    HTTPClient["HTTP Client"] -->|"POST /score_*"| KVCacheManager
    vLLMPods["vLLM/SGLang Pods"] -->|"ZMQ PUB 5557/TCP"| Pool
    Redis["Redis / Valkey<br/>6379/TCP"] --- RedisBackend
    Redis --- ValkeyBackend
    K8sAPI["Kubernetes API<br/>6443/TCP"] -->|"Pod watch"| Reconciler
    OTel["OpenTelemetry Collector<br/>4317/TCP"] ---|"OTLP traces"| KVCacheManager

    %% Styling
    style Indexer fill:#4a90e2,stroke:#333,color:#fff
    style Pool fill:#4a90e2,stroke:#333,color:#fff
