graph TB
    subgraph KVCacheSystem["llm-d-kv-cache System"]
        direction TB

        subgraph GoCore["Go Core Libraries"]
            Indexer["KV-Cache Indexer<br/>(kvcache.Indexer)<br/>Longest-prefix-match scoring"]
            EventsPool["KV Events Pool<br/>(kvevents.Pool)<br/>Sharded FNV-1a worker queue"]
            BlockIndex["kvblock.Index<br/>Multi-backend block store"]
            IndexerGRPC["IndexerService gRPC<br/>50051/TCP"]
        end

        subgraph Backends["Index Backends (priority order)"]
            CostAware["CostAwareMemory<br/>(Ristretto-based)"]
            Valkey["Valkey Backend"]
            RedisBackend["Redis Backend<br/>(Lua scripts)"]
            InMemory["InMemory (LRU)"]
        end

        subgraph PythonServices["Python Services"]
            UDSTokenizer["UDS Tokenizer Service<br/>gRPC over UDS<br/>/tmp/tokenizer/tokenizer-uds.socket<br/>Health: 8082/TCP"]
            TokenGRPC["TokenizationService gRPC<br/>Tokenize, Render, Preprocess"]
        end

        subgraph StorageUtils["Storage Utilities"]
            FSBackend["llmd-fs-backend<br/>(deprecated → vLLM v0.23)<br/>GPU ↔ Shared Storage"]
            PVCEvictor["PVC Evictor<br/>N+2 process architecture<br/>Threshold-based hysteresis"]
        end
    end

    %% Internal connections
    EventsPool -->|"ZMQ SUB<br/>msgpack decode"| Indexer
    Indexer -->|"score lookup"| BlockIndex
    BlockIndex --> CostAware
    BlockIndex --> Valkey
    BlockIndex --> RedisBackend
    BlockIndex --> InMemory
    IndexerGRPC -->|"GetPodScores RPC"| Indexer
    Indexer -->|"tokenize request<br/>UDS gRPC"| UDSTokenizer
    UDSTokenizer --> TokenGRPC
    FSBackend -->|"ZMQ PUB<br/>storage events"| EventsPool

    %% External sources
    vLLMPods["vLLM Inference Pods"]
    vLLMPods -->|"ZMQ PUB<br/>5557/TCP<br/>KVEvents"| EventsPool

    Router["llm-d-router<br/>(Scheduler)"]
    Router -->|"Go library import<br/>in-process"| Indexer

    K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    EventsPool -->|"Pod discovery<br/>label: llm-d.ai/inference-serving=true"| K8sAPI

    HFHub["HuggingFace Hub<br/>443/TCP HTTPS"]
    UDSTokenizer -->|"Download tokenizer models"| HFHub

    SharedPVC["Shared PVC<br/>POSIX filesystem"]
    FSBackend -->|"POSIX I/O<br/>KV-cache blocks"| SharedPVC
    PVCEvictor -->|"Manage disk space<br/>85%→70% hysteresis"| SharedPVC

    RedisServer["Redis / Valkey Server<br/>6379/TCP"]
    RedisBackend -->|"Redis protocol"| RedisServer

    %% Styling
    style Indexer fill:#4a90e2,stroke:#333,color:#fff
    style EventsPool fill:#4a90e2,stroke:#333,color:#fff
    style BlockIndex fill:#4a90e2,stroke:#333,color:#fff
    style IndexerGRPC fill:#4a90e2,stroke:#333,color:#fff
    style UDSTokenizer fill:#9b59b6,stroke:#333,color:#fff
    style TokenGRPC fill:#9b59b6,stroke:#333,color:#fff
    style FSBackend fill:#95a5a6,stroke:#333,color:#fff
    style PVCEvictor fill:#e67e22,stroke:#333,color:#fff
    style CostAware fill:#2ecc71,stroke:#333,color:#fff
    style Valkey fill:#2ecc71,stroke:#333,color:#fff
    style RedisBackend fill:#2ecc71,stroke:#333,color:#fff
    style InMemory fill:#2ecc71,stroke:#333,color:#fff
    style vLLMPods fill:#f5a623,stroke:#333,color:#fff
    style Router fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style SharedPVC fill:#e8e8e8,stroke:#333
    style RedisServer fill:#e8e8e8,stroke:#333
