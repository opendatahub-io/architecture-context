graph TB
    subgraph "llm-d-kv-cache"
        direction TB

        subgraph GoLibrary["Go Library Core (pkg/)"]
            direction TB
            Indexer["kvcache.Indexer<br/>KV-cache indexer orchestrator"]
            EventPool["kvevents.Pool<br/>Sharded ZMQ event processing"]
            EngineAdapter["engineadapter<br/>vLLM / SGLang parsers"]
            BlockIndex["kvblock.Index<br/>Pluggable backends:<br/>In-Memory LRU | Ristretto | Redis"]
            TokenProcessor["kvblock.TokenProcessor<br/>Token-to-block-key hashing<br/>(FNV-64a + CBOR)"]
            Scorer["kvblock.Scorer<br/>Longest-prefix matching"]
            TokenClient["tokenization.Client<br/>gRPC client (UDS)"]
            Telemetry["telemetry<br/>OpenTelemetry tracing"]

            EventPool -->|msgpack events| EngineAdapter
            EngineAdapter -->|parsed events| BlockIndex
            Indexer -->|score tokens| TokenProcessor
            TokenProcessor -->|block keys| BlockIndex
            Indexer -->|compute scores| Scorer
            Indexer -->|tokenize prompts| TokenClient
        end

        subgraph PythonServices["Python Services"]
            direction TB
            UDSTokenizer["UDS Tokenizer<br/>gRPC sidecar<br/>vLLM tokenization engine<br/>Port: 8082/TCP (health)"]
            FSBackend["llmd-fs-backend<br/>vLLM OffloadingConnector<br/>(POSIX / GDS / S3 via NIXL)<br/>Final release v0.23"]
            PVCEvictor["PVC Evictor<br/>Multi-process disk manager<br/>N+2 architecture"]
        end
    end

    %% External event sources
    vLLM["vLLM Model Server<br/>ZMQ PUB 5557/TCP"]
    SGLang["SGLang Model Server<br/>ZMQ PUB 5557/TCP"]

    %% Primary consumer
    EPP["llm-d-router (EPP)<br/>Primary consumer<br/>Embeds Indexer"]

    %% External services
    Redis["Redis / Valkey<br/>6379/TCP"]
    HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS"]
    S3["S3 / Object Store<br/>443/TCP HTTPS"]
    SharedFS["Shared Filesystem<br/>NFS / PVC"]
    K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    OTLPCollector["OTLP Collector<br/>4317/TCP gRPC"]

    %% Connections
    vLLM -->|ZMQ PUB/SUB<br/>msgpack events| EventPool
    SGLang -->|ZMQ PUB/SUB<br/>msgpack events| EventPool
    EPP -->|embeds library<br/>in-process| Indexer
    TokenClient -->|gRPC over UDS| UDSTokenizer
    UDSTokenizer -->|HTTPS| HuggingFace
    BlockIndex -.->|optional| Redis
    FSBackend -->|POSIX I/O / HTTPS| S3
    FSBackend -->|POSIX I/O| SharedFS
    PVCEvictor -->|file ops| SharedFS
    Telemetry -->|gRPC| OTLPCollector
    EventPool -->|pod discovery| K8sAPI

    %% Styling
    style Indexer fill:#4a90e2,stroke:#333,color:#fff
    style EventPool fill:#4a90e2,stroke:#333,color:#fff
    style BlockIndex fill:#4a90e2,stroke:#333,color:#fff
