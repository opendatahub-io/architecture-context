graph TB
    subgraph Operator["mcp-lifecycle-operator-controller-manager"]
        direction TB
        MCPServerCtrl["MCPServer Controller<br/>(Lifecycle Reconciler)"]
        HTTPRouteCtrl["MCPGatewayBinding<br/>HTTPRoute Controller"]
        KuadrantCtrl["MCPGatewayBinding<br/>Kuadrant Controller"]
        ConfigMapCtrl["ConfigMap Controller<br/>(Log Level)"]
        ValidatingWH["Validating Admission<br/>Webhook :9443"]
        ConversionWH["CRD Conversion<br/>Webhook :9443"]
        MetricsEP["Metrics Endpoint<br/>:8443 HTTPS"]
        HealthEP["Health/Ready<br/>:8081"]
    end

    User["User / kubectl"] -->|"creates"| MCPServerCR["MCPServer CR<br/>(v1beta1 / v1alpha1)"]
    MCPServerCR -->|"admission"| ValidatingWH
    ValidatingWH -->|"validates image allowlist,<br/>digest enforcement,<br/>storage limits, labels"| MCPServerCR
    MCPServerCR -->|"watched by"| MCPServerCtrl

    MCPServerCtrl -->|"creates/manages"| Deployment["Deployment<br/>(MCP Server Pod)"]
    MCPServerCtrl -->|"creates/manages"| Service["Service<br/>(MCP Server)"]
    MCPServerCtrl -->|"creates/manages"| NetworkPolicy["NetworkPolicy<br/>(open or restricted)"]
    MCPServerCtrl -->|"MCP handshake<br/>verification"| Deployment
    MCPServerCtrl -->|"creates"| MCPGatewayBindingCR["MCPGatewayBinding CR"]

    MCPGatewayBindingCR -->|"watched by<br/>(httproute provider)"| HTTPRouteCtrl
    MCPGatewayBindingCR -->|"watched by<br/>(kuadrant provider)"| KuadrantCtrl

    HTTPRouteCtrl -->|"creates"| HTTPRoute["HTTPRoute"]
    HTTPRouteCtrl -->|"reads"| Gateway["Gateway"]

    KuadrantCtrl -->|"creates"| MCPServerReg["MCPServerRegistration"]
    KuadrantCtrl -->|"reads"| MCPGatewayExt["MCPGatewayExtension"]

    ConversionWH -->|"v1alpha1 <-> v1beta1"| MCPServerCR

    CertManager["cert-manager"] -->|"provisions TLS certs"| ValidatingWH
    CertManager -->|"provisions TLS certs"| ConversionWH
    Prometheus["Prometheus"] -->|"scrapes"| MetricsEP

    style MCPServerCtrl fill:#4a90e2,color:#fff
    style HTTPRouteCtrl fill:#4a90e2,color:#fff
    style KuadrantCtrl fill:#4a90e2,color:#fff
    style ConfigMapCtrl fill:#4a90e2,color:#fff
    style ValidatingWH fill:#e87040,color:#fff
    style ConversionWH fill:#e87040,color:#fff
    style MCPServerCR fill:#f5a623,color:#000
    style MCPGatewayBindingCR fill:#f5a623,color:#000
    style Deployment fill:#7ed321,color:#000
    style Service fill:#7ed321,color:#000
    style NetworkPolicy fill:#7ed321,color:#000
    style HTTPRoute fill:#7ed321,color:#000
    style MCPServerReg fill:#7ed321,color:#000
    style CertManager fill:#e8e8e8,color:#333
    style Prometheus fill:#e8e8e8,color:#333
    style Gateway fill:#e8e8e8,color:#333
    style MCPGatewayExt fill:#e8e8e8,color:#333
