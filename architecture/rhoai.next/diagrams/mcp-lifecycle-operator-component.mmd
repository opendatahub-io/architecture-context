graph TB
    subgraph "MCP Lifecycle Operator"
        Controller["MCPServer Controller<br/>(controller-runtime)"]
        Validator["Validation Phase"]
        DeployMgr["Deployment Manager"]
        ServiceMgr["Service Manager"]
        NetPolMgr["NetworkPolicy Manager"]
        Handshake["MCP Handshake Verifier<br/>(go-sdk)"]
        ConfigHash["Config Hash Computer<br/>(SHA-256)"]
        Ownership["Ownership Manager"]
        Metrics["Prometheus Metrics<br/>8443/TCP HTTPS"]
        HealthProbe["Health Probes<br/>/healthz, /readyz<br/>8081/TCP"]

        Controller --> Validator
        Controller --> DeployMgr
        Controller --> ServiceMgr
        Controller --> NetPolMgr
        Controller --> Handshake
        Controller --> ConfigHash
        Controller --> Ownership
    end

    User["Platform User"] -->|"creates/updates"| MCPServerCR["MCPServer CR<br/>(mcp.x-k8s.io/v1alpha1)"]
    MCPServerCR -->|"watched by"| Controller

    %% Resources created by controller
    DeployMgr -->|"creates/updates"| Deployment["Deployment<br/>(MCP Server Pod)"]
    ServiceMgr -->|"creates/updates"| Service["ClusterIP Service<br/>(MCP port)"]
    NetPolMgr -->|"creates/updates"| NetworkPolicy["NetworkPolicy<br/>(ingress restriction)"]

    %% Handshake verification
    Handshake -->|"MCP initialize<br/>(Streamable HTTP)"| Deployment

    %% Config hash triggers
    ConfigHash -->|"reads"| ConfigMaps["ConfigMaps"]
    ConfigHash -->|"reads"| Secrets["Secrets"]
    ConfigHash -->|"hash annotation"| Deployment

    %% External dependencies
    Controller -->|"CRUD via HTTPS/443"| K8sAPI["Kubernetes API Server"]
    Metrics -->|"scraped by"| Prometheus["Prometheus"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Validator fill:#4a90e2,stroke:#333,color:#fff
    style DeployMgr fill:#4a90e2,stroke:#333,color:#fff
    style ServiceMgr fill:#4a90e2,stroke:#333,color:#fff
    style NetPolMgr fill:#4a90e2,stroke:#333,color:#fff
    style Handshake fill:#4a90e2,stroke:#333,color:#fff
    style ConfigHash fill:#4a90e2,stroke:#333,color:#fff
    style Ownership fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbe fill:#4a90e2,stroke:#333,color:#fff
    style MCPServerCR fill:#f5a623,stroke:#333,color:#333
    style Deployment fill:#7ed321,stroke:#333,color:#333
    style Service fill:#7ed321,stroke:#333,color:#333
    style NetworkPolicy fill:#7ed321,stroke:#333,color:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#333
