graph TB
    subgraph GarakProvider["Llama Stack Provider TrustyAI Garak"]
        direction TB

        subgraph EvalHubLayer["EvalHub Layer"]
            GarakAdapter["GarakAdapter<br/><i>FrameworkAdapter</i><br/>Job lifecycle, config, results"]
            GarakKFPAdapter["GarakKFPAdapter<br/><i>FrameworkAdapter subclass</i><br/>Forces KFP execution mode"]
            KFPPipeline["KFP Pipeline<br/><i>evalhub-garak-scan</i><br/>6-step distributed pipeline"]
            S3Utils["S3 Utilities<br/>Artifact upload/download"]
        end

        subgraph CoreLayer["Core Layer"]
            ConfigResolution["Config Resolution<br/>JobSpec → garak config"]
            CommandBuilder["Command Builder<br/>garak CLI args"]
            GarakRunner["Garak Runner<br/>Subprocess execution"]
            APIKeyMgmt["API Key Management<br/>Multi-layer resolution chain"]
        end

        subgraph DataLayer["Data Processing Layer"]
            SDGModule["SDG Module<br/>Synthetic Data Generation<br/>via sdg-hub"]
            IntentsModule["Intents Module<br/>Taxonomy loading,<br/>CAS topology generation"]
            ResultUtils["Result Utilities<br/>JSONL parsing, AVID aggregation,<br/>TBSA, Vega charts, ART HTML"]
        end
    end

    %% Internal connections
    GarakAdapter -->|"simple mode"| CoreLayer
    GarakKFPAdapter -->|"extends"| GarakAdapter
    GarakKFPAdapter -->|"KFP mode"| KFPPipeline
    KFPPipeline -->|"uses"| S3Utils

    GarakAdapter -->|"intents mode"| SDGModule
    GarakAdapter -->|"intents mode"| IntentsModule
    GarakAdapter -->|"parses results"| ResultUtils

    ConfigResolution -->|"builds"| CommandBuilder
    CommandBuilder -->|"executes"| GarakRunner
    GarakRunner -->|"output"| ResultUtils

    %% External inputs
    JobSpec["/etc/eval-job/spec.json<br/>ConfigMap Mount"] -->|"reads"| GarakAdapter
    ModelAuthSecret["model-auth Secret<br/>API keys (volume mount)"] -->|"injects keys"| APIKeyMgmt
    DataConnSecret["Data Connection Secret<br/>S3 credentials (env vars)"] -->|"injects creds"| S3Utils

    %% External outputs
    GarakAdapter -->|"callbacks"| EvalHubSidecar["eval-hub Sidecar<br/>8080/TCP loopback"]
    GarakAdapter -->|"persists"| OCIRegistry["OCI Registry"]
    GarakAdapter -->|"logs"| MLflow["MLflow"]
    KFPPipeline -->|"submits"| KFPAPI["KFP API Server"]
    GarakRunner -->|"probes"| TargetLLM["Target LLM Endpoint"]

    %% Styling
    style GarakAdapter fill:#4a90e2,stroke:#333,color:#fff
    style GarakKFPAdapter fill:#4a90e2,stroke:#333,color:#fff
    style KFPPipeline fill:#4a90e2,stroke:#333,color:#fff
    style ConfigResolution fill:#5b9bd5,stroke:#333,color:#fff
    style CommandBuilder fill:#5b9bd5,stroke:#333,color:#fff
    style GarakRunner fill:#5b9bd5,stroke:#333,color:#fff
    style APIKeyMgmt fill:#5b9bd5,stroke:#333,color:#fff
    style SDGModule fill:#7ed321,stroke:#333,color:#fff
    style IntentsModule fill:#7ed321,stroke:#333,color:#fff
    style ResultUtils fill:#7ed321,stroke:#333,color:#fff
    style S3Utils fill:#4a90e2,stroke:#333,color:#fff

    style JobSpec fill:#f5a623,stroke:#333,color:#fff
    style ModelAuthSecret fill:#e74c3c,stroke:#333,color:#fff
    style DataConnSecret fill:#e74c3c,stroke:#333,color:#fff
    style EvalHubSidecar fill:#e8e8e8,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style KFPAPI fill:#e8e8e8,stroke:#333
    style TargetLLM fill:#e8e8e8,stroke:#333
