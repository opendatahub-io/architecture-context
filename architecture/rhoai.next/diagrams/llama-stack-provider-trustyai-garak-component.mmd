graph TB
    subgraph AdapterPod["Garak Adapter K8s Job Pod"]
        direction TB

        subgraph EvalHub["evalhub/ - Eval-Hub Integration Layer"]
            GarakAdapter["garak_adapter.py<br/>FrameworkAdapter<br/>(Main Adapter)"]
            KFPAdapter["kfp_adapter.py<br/>KFP Adapter<br/>(Forces KFP mode)"]
            KFPPipeline["kfp_pipeline.py<br/>KFP Pipeline Definition<br/>(6-step pipeline)"]
            S3Utils["s3_utils.py<br/>S3 Client Factory"]
        end

        subgraph Core["core/ - Framework-Agnostic Logic"]
            ConfigResolution["config_resolution.py<br/>Config Resolution<br/>(Deep merge profiles)"]
            CommandBuilder["command_builder.py<br/>CLI Builder<br/>(Garak CLI args)"]
            GarakRunner["garak_runner.py<br/>Subprocess Runner<br/>(Timeout, process groups)"]
            PipelineSteps["pipeline_steps.py<br/>Pipeline Steps<br/>(validate, taxonomy, SDG,<br/>prompts, scan, outputs)"]
        end

        subgraph Support["Support Modules"]
            Config["config.py<br/>Scan Profiles<br/>(OWASP, AVID, CWE, intents)"]
            Intents["intents.py<br/>Taxonomy/Intent Loader"]
            SDG["sdg.py<br/>SDG Integration"]
            ResultUtils["result_utils.py<br/>Result Parser<br/>(JSONL, AVID, TBSA, ART HTML)"]
            GarakCmdConfig["garak_command_config.py<br/>Pydantic Config Models"]
        end
    end

    %% Internal relationships
    GarakAdapter -->|dispatches to| GarakRunner
    GarakAdapter -->|dispatches to| KFPPipeline
    KFPAdapter -->|extends| GarakAdapter
    GarakAdapter -->|reads| Config
    GarakAdapter -->|uses| ConfigResolution
    GarakAdapter -->|uses| ResultUtils
    ConfigResolution -->|produces| GarakCmdConfig
    CommandBuilder -->|reads| GarakCmdConfig
    GarakRunner -->|runs| CommandBuilder
    KFPPipeline -->|delegates to| PipelineSteps
    PipelineSteps -->|uses| Intents
    PipelineSteps -->|uses| SDG
    KFPPipeline -->|uses| S3Utils

    %% External inputs
    JobSpec["JobSpec<br/>(ConfigMap mount<br/>/etc/eval-job/spec.json)"]
    JobSpec -->|read by| GarakAdapter

    %% External integrations
    TargetLLM["Target LLM Model<br/>443/TCP HTTPS"]
    S3Store["S3-Compatible Store<br/>443/TCP HTTPS"]
    EvalHubSidecar["eval-hub Sidecar<br/>8080/TCP HTTP (loopback)"]
    KFPService["Kubeflow Pipelines API<br/>443/TCP HTTPS"]
    MLflowService["MLflow<br/>443/TCP HTTPS"]
    OCIRegistry["OCI Registry<br/>443/TCP HTTPS"]
    K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]

    GarakRunner -->|scans| TargetLLM
    KFPPipeline -->|submits pipeline| KFPService
    S3Utils -->|uploads/downloads| S3Store
    GarakAdapter -->|reports results| EvalHubSidecar
    GarakAdapter -->|logs metrics| MLflowService
    GarakAdapter -->|persists artifacts| OCIRegistry
    KFPPipeline -->|reads Secrets/ConfigMaps| K8sAPI

    %% Styling
    style GarakAdapter fill:#4a90e2,stroke:#333,color:#fff
    style KFPAdapter fill:#4a90e2,stroke:#333,color:#fff
    style KFPPipeline fill:#4a90e2,stroke:#333,color:#fff
    style S3Utils fill:#4a90e2,stroke:#333,color:#fff
    style ConfigResolution fill:#50c878,stroke:#333,color:#fff
    style CommandBuilder fill:#50c878,stroke:#333,color:#fff
    style GarakRunner fill:#50c878,stroke:#333,color:#fff
    style PipelineSteps fill:#50c878,stroke:#333,color:#fff
    style Config fill:#f5a623,stroke:#333,color:#fff
    style Intents fill:#f5a623,stroke:#333,color:#fff
    style SDG fill:#f5a623,stroke:#333,color:#fff
    style ResultUtils fill:#f5a623,stroke:#333,color:#fff
    style GarakCmdConfig fill:#f5a623,stroke:#333,color:#fff
    style JobSpec fill:#e8e8e8,stroke:#333
    style TargetLLM fill:#e74c3c,stroke:#333,color:#fff
    style S3Store fill:#999,stroke:#333,color:#fff
    style EvalHubSidecar fill:#7ed321,stroke:#333,color:#fff
    style KFPService fill:#999,stroke:#333,color:#fff
    style MLflowService fill:#999,stroke:#333,color:#fff
    style OCIRegistry fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
