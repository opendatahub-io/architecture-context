graph TB
    subgraph EvalHub["eval-hub (K8s Job)"]
        direction TB
        JobSpec["JobSpec<br/>/etc/eval-job/spec.json"]
        Sidecar["eval-hub Sidecar<br/>Status Callbacks"]
    end

    subgraph GarakAdapter["Garak Adapter (FrameworkAdapter)"]
        direction TB
        Adapter["garak-adapter<br/>Orchestrator"]
        Config["config.py<br/>Benchmark Profiles<br/>(OWASP, AVID, CWE, Intents)"]
        CredResolver["Credential Resolver<br/>5-step auth chain"]

        subgraph SimpleMode["Simple Mode"]
            GarakRunner["garak_runner<br/>Subprocess Executor"]
        end

        subgraph KFPMode["KFP Mode"]
            KFPPipeline["kfp_pipeline<br/>6-step Pipeline Definition"]
            S3Utils["s3_utils<br/>S3 Client Factory"]
        end

        subgraph CoreModules["Core Pipeline Steps"]
            PipelineSteps["pipeline_steps<br/>Validation, Config, Scan"]
            SDG["sdg<br/>Synthetic Data Generation"]
            Intents["intents<br/>Taxonomy Loading"]
            ResultUtils["result_utils<br/>JSONL/AVID Parser, TBSA Scoring"]
        end
    end

    JobSpec -->|"reads spec"| Adapter
    Adapter -->|"resolves credentials"| CredResolver
    Adapter -->|"selects mode"| SimpleMode
    Adapter -->|"selects mode"| KFPMode
    Adapter -->|"uses profiles"| Config
    Adapter -->|"reports results"| Sidecar

    GarakRunner -->|"uses"| PipelineSteps
    GarakRunner -->|"parses output"| ResultUtils

    KFPPipeline -->|"uses"| PipelineSteps
    KFPPipeline -->|"uses"| SDG
    KFPPipeline -->|"uses"| Intents
    KFPPipeline -->|"transfers artifacts"| S3Utils
    KFPPipeline -->|"parses output"| ResultUtils

    Adapter -->|"probes"| TargetLLM["Target LLM Endpoint"]
    KFPPipeline -->|"submits pipeline"| KFPServer["KFP API Server"]
    KFPPipeline -->|"stores artifacts"| S3["S3 Storage"]
    SDG -->|"generates prompts"| SDGEndpoint["SDG Model Endpoint"]
    CredResolver -->|"reads secrets"| K8sAPI["Kubernetes API"]

    style Adapter fill:#4a90e2,color:#fff
    style Config fill:#4a90e2,color:#fff
    style CredResolver fill:#4a90e2,color:#fff
    style GarakRunner fill:#7ed321,color:#fff
    style KFPPipeline fill:#7ed321,color:#fff
    style S3Utils fill:#7ed321,color:#fff
    style PipelineSteps fill:#9b59b6,color:#fff
    style SDG fill:#9b59b6,color:#fff
    style Intents fill:#9b59b6,color:#fff
    style ResultUtils fill:#9b59b6,color:#fff
    style TargetLLM fill:#f5a623
    style KFPServer fill:#f5a623
    style S3 fill:#f5a623
    style SDGEndpoint fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style JobSpec fill:#e8e8e8
    style Sidecar fill:#e8e8e8
