graph TB
    subgraph Operator["codeflare-operator-manager"]
        direction TB
        Manager["Manager<br/>(controller-runtime)"]

        subgraph Controllers["Controllers"]
            RayClusterCtrl["RayClusterReconciler<br/>(Go Controller)"]
            AppWrapperCtrl["AppWrapper Controller<br/>(embedded library, optional)"]
        end

        subgraph Webhooks["Admission Webhooks"]
            RCMutate["RayCluster Mutating<br/>9443/TCP"]
            RCValidate["RayCluster Validating<br/>9443/TCP"]
            AWMutate["AppWrapper Mutating<br/>9443/TCP"]
            AWValidate["AppWrapper Validating<br/>9443/TCP"]
        end

        subgraph Probes["Health"]
            Healthz["/healthz<br/>8081/TCP"]
            Readyz["/readyz<br/>8081/TCP"]
            Metrics["/metrics<br/>8080/TCP"]
        end

        Manager --> RayClusterCtrl
        Manager --> AppWrapperCtrl
        Manager --> Webhooks
    end

    %% CRDs watched
    RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    AppWrapperCR["AppWrapper CR<br/>(workload.codeflare.dev/v1beta2)"]
    DSCI["DSCInitialization CR"]

    %% Resources created by RayCluster controller
    subgraph CreatedResources["Resources Created per RayCluster"]
        OAuthProxy["OAuth Proxy Sidecar"]
        Route["OpenShift Route"]
        CASec["CA Secret<br/>(RSA-2048)"]
        OAuthSec["OAuth Cookie Secret"]
        NetPol["NetworkPolicy"]
        CRB["ClusterRoleBinding"]
        mTLSInit["mTLS Init Container"]
    end

    %% User interaction
    User["User / Data Scientist"] -->|"kubectl create"| RayClusterCR
    User -->|"kubectl create"| AppWrapperCR

    %% Controller watches
    RayClusterCR -->|"watched by"| RayClusterCtrl
    AppWrapperCR -->|"watched by"| AppWrapperCtrl
    DSCI -->|"watched by"| RayClusterCtrl

    %% Controller creates
    RayClusterCtrl -->|"creates"| OAuthProxy
    RayClusterCtrl -->|"creates"| Route
    RayClusterCtrl -->|"creates"| CASec
    RayClusterCtrl -->|"creates"| OAuthSec
    RayClusterCtrl -->|"creates"| NetPol
    RayClusterCtrl -->|"creates"| CRB
    RayClusterCtrl -->|"creates"| mTLSInit

    %% Webhook mutations
    RCMutate -->|"injects sidecar +<br/>init containers"| RayClusterCR
    RCValidate -->|"enforces immutability"| RayClusterCR

    %% External dependencies
    KubeRay["KubeRay Operator"]
    Kueue["Kueue"]
    OSRoute["OpenShift Route API"]
    OSOAuth["OpenShift OAuth Server"]
    CertCtrl["cert-controller<br/>(OPA)"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]

    RayClusterCtrl -->|"discovers namespace"| KubeRay
    AppWrapperCtrl -->|"integrates"| Kueue
    RayClusterCtrl -->|"creates routes"| OSRoute
    OAuthProxy -->|"delegates auth"| OSOAuth
    CertCtrl -->|"rotates webhook certs"| Webhooks
    Operator -->|"all operations"| K8sAPI

    %% Styles
    style Operator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style RayClusterCtrl fill:#4a90e2,color:#fff
    style AppWrapperCtrl fill:#4a90e2,color:#fff
    style RCMutate fill:#7986cb,color:#fff
    style RCValidate fill:#7986cb,color:#fff
    style AWMutate fill:#7986cb,color:#fff
    style AWValidate fill:#7986cb,color:#fff
    style RayClusterCR fill:#f5a623,color:#fff
    style AppWrapperCR fill:#f5a623,color:#fff
    style DSCI fill:#f5a623,color:#fff
    style KubeRay fill:#999,color:#fff
    style Kueue fill:#999,color:#fff
    style OSRoute fill:#999,color:#fff
    style OSOAuth fill:#999,color:#fff
    style CertCtrl fill:#999,color:#fff
    style K8sAPI fill:#999,color:#fff
    style OAuthProxy fill:#7ed321,color:#fff
    style Route fill:#7ed321,color:#fff
    style CASec fill:#7ed321,color:#fff
    style OAuthSec fill:#7ed321,color:#fff
    style NetPol fill:#7ed321,color:#fff
    style CRB fill:#7ed321,color:#fff
    style mTLSInit fill:#7ed321,color:#fff
