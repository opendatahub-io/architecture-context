graph TB
    subgraph CodeFlareOperator["CodeFlare Operator (controller-runtime)"]
        direction TB
        Manager["Manager Process<br/>main.go"]

        subgraph RayClusterSecurity["RayCluster Security Layer (always active)"]
            RCController["RayCluster Controller<br/>Reconciles OAuth/mTLS/NetworkPolicy"]
            RCMutatingWH["RayCluster Mutating Webhook<br/>/mutate-ray-io-v1-raycluster<br/>9443/TCP"]
            RCValidatingWH["RayCluster Validating Webhook<br/>/validate-ray-io-v1-raycluster<br/>9443/TCP"]
        end

        subgraph AppWrapperLayer["AppWrapper Layer (conditionally enabled)"]
            AWController["AppWrapper Controller<br/>Kueue-integrated job queuing"]
            AWMutatingWH["AppWrapper Mutating Webhook<br/>/mutate-workload-codeflare-dev<br/>9443/TCP"]
            AWValidatingWH["AppWrapper Validating Webhook<br/>/validate-workload-codeflare-dev<br/>9443/TCP"]
        end

        Manager --> RCController
        Manager --> AWController
        Manager --> RCMutatingWH
        Manager --> RCValidatingWH
        Manager --> AWMutatingWH
        Manager --> AWValidatingWH
    end

    %% CRDs
    RayClusterCR["RayCluster CR<br/>ray.io/v1"]
    AppWrapperCR["AppWrapper CR<br/>workload.codeflare.dev/v1beta2"]

    %% Created Resources
    OAuthProxy["OAuth Proxy Sidecar<br/>port 8443"]
    mTLSInit["mTLS Init Containers<br/>openssl cert gen"]
    Route["OpenShift Route<br/>ray-dashboard-{cluster}"]
    OAuthService["OAuth Service<br/>{cluster}-oauth"]
    CASecret["CA Secret<br/>{cluster}-ca-secret<br/>RSA 2048-bit"]
    NetworkPolicy["NetworkPolicy<br/>Worker isolation + Head ingress"]
    OAuthSA["ServiceAccount<br/>{cluster}-oauth-proxy"]
    CRB["ClusterRoleBinding<br/>system:auth-delegator"]

    %% Watches
    RayClusterCR -->|watched by| RCController
    RayClusterCR -->|intercepted by| RCMutatingWH
    RayClusterCR -->|intercepted by| RCValidatingWH
    AppWrapperCR -->|watched by| AWController
    AppWrapperCR -->|intercepted by| AWMutatingWH
    AppWrapperCR -->|intercepted by| AWValidatingWH

    %% Creates
    RCController -->|creates| Route
    RCController -->|creates| OAuthService
    RCController -->|creates| CASecret
    RCController -->|creates| NetworkPolicy
    RCController -->|creates| OAuthSA
    RCController -->|creates| CRB
    RCMutatingWH -->|injects| OAuthProxy
    RCMutatingWH -->|injects| mTLSInit

    %% External Dependencies
    KubeRay["KubeRay Operator"]
    DSCI["opendatahub-operator<br/>DSCInitialization CR"]
    OSAuth["OpenShift OAuth"]
    OSIngress["OpenShift Ingress Config"]
    K8sAPI["Kubernetes API Server"]
    Kueue["Kueue<br/>(when AppWrapper enabled)"]

    RCController -->|discovers namespace| KubeRay
    RCController -->|reads apps namespace| DSCI
    RCController -->|OAuth redirect| OSAuth
    RCController -->|reads ingress domain| OSIngress
    RCController -->|CRUD resources| K8sAPI
    AWController -->|quota integration| Kueue

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style RCController fill:#4a90e2,stroke:#333,color:#fff
    style RCMutatingWH fill:#4a90e2,stroke:#333,color:#fff
    style RCValidatingWH fill:#4a90e2,stroke:#333,color:#fff
    style AWController fill:#4a90e2,stroke:#333,color:#fff
    style AWMutatingWH fill:#4a90e2,stroke:#333,color:#fff
    style AWValidatingWH fill:#4a90e2,stroke:#333,color:#fff
    style RayClusterCR fill:#f5a623,stroke:#333,color:#333
    style AppWrapperCR fill:#f5a623,stroke:#333,color:#333
    style OAuthProxy fill:#7ed321,stroke:#333,color:#333
    style mTLSInit fill:#7ed321,stroke:#333,color:#333
    style Route fill:#7ed321,stroke:#333,color:#333
    style OAuthService fill:#7ed321,stroke:#333,color:#333
    style CASecret fill:#7ed321,stroke:#333,color:#333
    style NetworkPolicy fill:#7ed321,stroke:#333,color:#333
    style OAuthSA fill:#7ed321,stroke:#333,color:#333
    style CRB fill:#7ed321,stroke:#333,color:#333
    style KubeRay fill:#999,stroke:#333,color:#fff
    style DSCI fill:#999,stroke:#333,color:#fff
    style OSAuth fill:#999,stroke:#333,color:#fff
    style OSIngress fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Kueue fill:#999,stroke:#333,color:#fff
