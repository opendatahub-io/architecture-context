graph TB
    subgraph CFOperator["CodeFlare Operator"]
        direction TB
        Controller["RayCluster Controller<br/><i>Reconciles RayCluster CRs</i>"]
        MutWebhook["RayCluster Mutating Webhook<br/><i>Injects OAuth proxy + mTLS</i>"]
        ValWebhook["RayCluster Validating Webhook<br/><i>Enforces injected resource immutability</i>"]
        CertCtrl["cert-controller<br/><i>Webhook TLS cert rotation</i>"]

        subgraph AppWrapperEmbed["AppWrapper (Embedded, Optional)"]
            AWController["AppWrapper Controller<br/><i>Workload queuing + gang scheduling</i>"]
            AWWebhook["AppWrapper Webhook<br/><i>Validation + defaulting</i>"]
        end

        Controller --> MutWebhook
        CertCtrl -->|manages TLS certs| MutWebhook
        CertCtrl -->|manages TLS certs| ValWebhook
    end

    %% External CRDs
    User["User / Data Scientist"] -->|creates| RayClusterCR["RayCluster CR<br/><i>ray.io/v1</i>"]
    User -->|creates| AppWrapperCR["AppWrapper CR<br/><i>workload.codeflare.dev/v1beta2</i>"]

    RayClusterCR -->|watched by| Controller
    AppWrapperCR -->|watched by| AWController

    %% Resources created by Controller
    Controller -->|creates| OAuthService["OAuth Service<br/><i>ClusterIP 443→8443</i>"]
    Controller -->|creates| Route["OpenShift Route<br/><i>Dashboard + Client</i>"]
    Controller -->|creates| NetworkPolicy["NetworkPolicy<br/><i>Head + Worker isolation</i>"]
    Controller -->|creates| CASecret["CA Secret<br/><i>mTLS certificates</i>"]
    Controller -->|creates| ServiceAccount["OAuth ServiceAccount<br/><i>+ ClusterRoleBinding</i>"]

    %% Injected by webhook
    MutWebhook -->|injects| OAuthProxy["oauth-proxy sidecar<br/><i>port 8443</i>"]
    MutWebhook -->|injects| TLSInit["mTLS init container<br/><i>cert generation</i>"]

    %% External dependencies
    Controller -->|reads CRD| KubeRay["KubeRay Operator"]
    Controller -->|reads| DSCI["DSCInitialization CR<br/><i>opendatahub-operator</i>"]
    Controller -->|reads| IngressConfig["OpenShift Ingress Config<br/><i>cluster domain</i>"]
    OAuthProxy -->|delegates auth| OSAuth["OpenShift OAuth"]
    AWController -->|integrates| Kueue["Kueue<br/><i>Quota + scheduling</i>"]

    %% ConfigMap
    ConfigMap["codeflare-operator-config<br/><i>ConfigMap</i>"] -.->|configures| Controller
    ConfigMap -.->|enables/disables| AWController

    %% Styling
    style CFOperator fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style AppWrapperEmbed fill:#f0f8e8,stroke:#82b366,stroke-width:1px,stroke-dasharray: 5 5
    style Controller fill:#4a90e2,color:#fff
    style MutWebhook fill:#4a90e2,color:#fff
    style ValWebhook fill:#4a90e2,color:#fff
    style CertCtrl fill:#4a90e2,color:#fff
    style AWController fill:#7ed321,color:#fff
    style AWWebhook fill:#7ed321,color:#fff
    style RayClusterCR fill:#f5a623,color:#fff
    style AppWrapperCR fill:#f5a623,color:#fff
    style KubeRay fill:#e8e8e8,stroke:#999
    style DSCI fill:#e8e8e8,stroke:#999
    style IngressConfig fill:#e8e8e8,stroke:#999
    style OSAuth fill:#e8e8e8,stroke:#999
    style Kueue fill:#e8e8e8,stroke:#999
    style ConfigMap fill:#fff2cc,stroke:#d6b656
