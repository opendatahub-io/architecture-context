graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["ogx-k8s-operator-controller-manager<br/>(root operator)"]
        SA_Module["operator<br/>(ogx-module)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["ogx-k8s-operator-manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-proxy-rolebinding"]
        CRB_TLS["ogx-k8s-operator-tls-profile"]
        CRB_MetricsAuth["ogx-k8s-operator-metrics-auth"]
        CRB_Module["manager-cluster-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Leader["ogx-k8s-operator-leader-election-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ogx-k8s-operator-manager-role"]
        CR_Proxy["ogx-k8s-operator-proxy-role"]
        CR_Metrics["ogx-k8s-operator-metrics-reader"]
        CR_TLS["ogx-k8s-operator-tls-profile"]
        CR_MetricsAuth["ogx-k8s-operator-metrics-auth"]
        CR_ModuleMgr["manager-cluster-role<br/>(ogx-module)"]
        CR_Editor["ogxserver-editor-role<br/>(aggregated to admin/edit)"]
        CR_Viewer["ogxserver-viewer-role<br/>(aggregated to view)"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_Leader["ogx-k8s-operator-leader-election-role"]
    end

    subgraph ManagerResources["ogx-k8s-operator-manager-role Resources"]
        OGXServers["ogx.io<br/>ogxservers, /finalizers, /status<br/>CRUD + watch"]
        Deployments["apps<br/>deployments<br/>CRUD + watch"]
        CoreResources["core<br/>configmaps, pvcs, serviceaccounts,<br/>services, secrets, events, pods<br/>Various"]
        NetworkResources["networking.k8s.io<br/>ingresses, networkpolicies<br/>CRUD + watch"]
        AutoscaleRes["autoscaling<br/>horizontalpodautoscalers<br/>CRUD + watch"]
        BatchRes["batch<br/>jobs, jobs/status<br/>CRUD + get"]
        PolicyRes["policy<br/>poddisruptionbudgets<br/>CRUD + watch"]
        MonitoringRes["monitoring.coreos.com<br/>prometheusrules, servicemonitors<br/>CRUD + watch"]
        SCCRes["security.openshift.io<br/>securitycontextconstraints<br/>(nonroot-v2) use"]
    end

    subgraph ModuleResources["manager-cluster-role Resources (ogx-module)"]
        OGXComponent["components.platform.opendatahub.io<br/>ogxs, /finalizers, /status<br/>CRUD + watch"]
        OGXServersMod["ogx.io<br/>ogxservers, /status, /finalizers<br/>CRUD + watch"]
        WebhookConfigs["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>CRUD + watch"]
        CRDResources["apiextensions.k8s.io<br/>customresourcedefinitions<br/>CRUD + watch"]
        RBACResources["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>rolebindings, roles<br/>CRUD + watch"]
    end

    subgraph ProxyResources["Proxy / Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        MetricsURL["/metrics<br/>(non-resource URL)<br/>get"]
        TLSConfigRes["config.openshift.io<br/>apiservers<br/>get, list, watch"]
    end

    %% Service Account → Binding → Role chains
    SA_Controller -->|bound via| CRB_Manager
    SA_Controller -->|bound via| CRB_Proxy
    SA_Controller -->|bound via| CRB_TLS
    SA_Controller -->|bound via| CRB_MetricsAuth
    SA_Controller -->|bound via| RB_Leader

    SA_Module -->|bound via| CRB_Module

    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_TLS -->|grants| CR_TLS
    CRB_MetricsAuth -->|grants| CR_MetricsAuth
    CRB_Module -->|grants| CR_ModuleMgr
    RB_Leader -->|grants| R_Leader

    %% Manager role permissions
    CR_Manager -->|permits| OGXServers
    CR_Manager -->|permits| Deployments
    CR_Manager -->|permits| CoreResources
    CR_Manager -->|permits| NetworkResources
    CR_Manager -->|permits| AutoscaleRes
    CR_Manager -->|permits| BatchRes
    CR_Manager -->|permits| PolicyRes
    CR_Manager -->|permits| MonitoringRes
    CR_Manager -->|permits| SCCRes

    %% Module role permissions
    CR_ModuleMgr -->|permits| OGXComponent
    CR_ModuleMgr -->|permits| OGXServersMod
    CR_ModuleMgr -->|permits| WebhookConfigs
    CR_ModuleMgr -->|permits| CRDResources
    CR_ModuleMgr -->|permits| RBACResources

    %% Proxy/Auth permissions
    CR_Proxy -->|permits| TokenReviews
    CR_Proxy -->|permits| SAR
    CR_Metrics -->|permits| MetricsURL
    CR_TLS -->|permits| TLSConfigRes
    CR_MetricsAuth -->|permits| TokenReviews
    CR_MetricsAuth -->|permits| SAR

