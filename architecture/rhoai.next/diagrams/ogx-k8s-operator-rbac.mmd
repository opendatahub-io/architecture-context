graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_Instance["{instance}-sa<br/>(user namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_Instance["{instance}-rb"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/>(operator namespace)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_Proxy["proxy-role"]
        CR_Editor["ogxserver-editor-role<br/>(aggregated)"]
        CR_Viewer["ogxserver-viewer-role<br/>(aggregated)"]
        CR_Metrics["metrics-reader"]
        CR_SCC["system:openshift:scc:anyuid"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_Leader["leader-election-role"]
    end

    %% Bindings
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Proxy
    SA_CM -->|bound via| RB_Leader
    SA_Instance -->|bound via| CRB_Instance

    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_Instance -->|grants| CR_SCC
    RB_Leader -->|grants| R_Leader

    subgraph ManagerResources["manager-role Resources"]
        direction TB

        subgraph OGX_API["ogx.io"]
            OGXServers["ogxservers<br/>ogxservers/status<br/>ogxservers/finalizers<br/><i>get, list, watch, create,<br/>update, patch, delete</i>"]
        end

        subgraph Core_API["core (v1)"]
            ConfigMaps["configmaps<br/><i>create, get, list,<br/>patch, update, watch</i>"]
            PVCs["persistentvolumeclaims<br/><i>create, get, list,<br/>patch, update, watch</i>"]
            Secrets["secrets<br/><i>get, list, watch</i>"]
            SvcAccts["serviceaccounts<br/>services<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
            Pods["pods<br/><i>list</i>"]
        end

        subgraph Apps_API["apps"]
            Deployments["deployments<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
            ReplicaSets["replicasets<br/><i>get, list, watch</i>"]
        end

        subgraph Scaling_API["autoscaling"]
            HPAs["horizontalpodautoscalers<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
        end

        subgraph Net_API["networking.k8s.io"]
            Ingresses["ingresses<br/>networkpolicies<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
        end

        subgraph Policy_API["policy"]
            PDBs["poddisruptionbudgets<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
        end

        subgraph RBAC_API["rbac.authorization.k8s.io"]
            RoleBindingsRes["rolebindings<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
            CRBRes["clusterrolebindings<br/><i>delete, get, list</i>"]
            CRRes["clusterroles<br/><i>get, list, watch</i>"]
        end

        subgraph Monitoring_API["monitoring.coreos.com"]
            Monitors["prometheusrules<br/>servicemonitors<br/><i>create, delete, get,<br/>list, patch, update, watch</i>"]
        end

        subgraph APIExt["apiextensions.k8s.io"]
            CRDs["customresourcedefinitions<br/><i>get, list, watch</i>"]
        end

        subgraph OpenShift_API["config.openshift.io /<br/>security.openshift.io"]
            APIServers["apiservers<br/><i>get, list, watch</i>"]
            SCCs["securitycontextconstraints<br/><i>use</i>"]
        end
    end

    CR_Manager -->|manages| OGXServers
    CR_Manager -->|manages| ConfigMaps
    CR_Manager -->|manages| PVCs
    CR_Manager -->|reads| Secrets
    CR_Manager -->|manages| SvcAccts
    CR_Manager -->|reads| Pods
    CR_Manager -->|manages| Deployments
    CR_Manager -->|reads| ReplicaSets
    CR_Manager -->|manages| HPAs
    CR_Manager -->|manages| Ingresses
    CR_Manager -->|manages| PDBs
    CR_Manager -->|manages| RoleBindingsRes
    CR_Manager -->|reads| CRBRes
    CR_Manager -->|reads| CRRes
    CR_Manager -->|manages| Monitors
    CR_Manager -->|reads| CRDs
    CR_Manager -->|reads| APIServers
    CR_Manager -->|uses| SCCs

    subgraph ProxyResources["proxy-role Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/><i>create</i>"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/><i>create</i>"]
    end

    CR_Proxy -->|creates| TokenReviews
    CR_Proxy -->|creates| SAR

    subgraph LeaderResources["leader-election-role Resources"]
        LeaderCM["core: configmaps<br/><i>get, list, watch, create,<br/>update, patch, delete</i>"]
        Leases["coordination.k8s.io: leases<br/><i>get, list, watch, create,<br/>update, patch, delete</i>"]
        Events["core: events<br/><i>create, patch</i>"]
    end

    R_Leader -->|manages| LeaderCM
    R_Leader -->|manages| Leases
    R_Leader -->|manages| Events

    subgraph MetricsResources["metrics-reader Resources"]
        MetricsEndpoint["/metrics (non-resource)<br/><i>get</i>"]
    end

    CR_Metrics -->|reads| MetricsEndpoint

