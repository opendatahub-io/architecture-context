graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_Instance["{instance}-sa<br/>(per OGXServer namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster/Role Bindings"]
        CRB_Manager["manager-rolebinding<br/>(ClusterRoleBinding)"]
        RB_Leader["leader-election-rolebinding<br/>(RoleBinding, operator NS)"]
        RB_Instance["{instance}-rb<br/>(RoleBinding, per instance NS)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role<br/>(ClusterRole)"]
        CR_SCC["system:openshift:scc:anyuid<br/>(ClusterRole)"]
    end

    subgraph NamespacedRoles["Namespace-Scoped Roles"]
        R_Leader["leader-election-role<br/>(Role, operator NS)"]
    end

    %% Bindings
    SA_CM -->|"bound via"| CRB_Manager
    SA_CM -->|"bound via"| RB_Leader
    SA_Instance -->|"bound via"| RB_Instance

    CRB_Manager -->|"grants"| CR_Manager
    RB_Leader -->|"grants"| R_Leader
    RB_Instance -->|"grants"| CR_SCC

    %% manager-role resources
    subgraph OGXResources["ogx.io Resources"]
        OGXServers["ogxservers<br/>get, list, watch,<br/>create, update, patch, delete"]
        OGXServersStatus["ogxservers/status<br/>get, patch, update"]
        OGXServersFinalizers["ogxservers/finalizers<br/>update"]
    end

    subgraph CoreResources["Core API Resources"]
        Deployments["apps: deployments<br/>get, list, watch,<br/>create, update, patch, delete"]
        ReplicaSets["apps: replicasets<br/>get, list, watch"]
        Services["core: services<br/>get, list, watch,<br/>create, update, patch, delete"]
        ServiceAccounts_R["core: serviceaccounts<br/>get, list, watch,<br/>create, update, patch, delete"]
        ConfigMaps["core: configmaps<br/>get, list, watch,<br/>create, update, patch"]
        PVCs["core: persistentvolumeclaims<br/>get, list, watch,<br/>create, update, patch"]
        Secrets["core: secrets<br/>get, list, watch"]
        Pods["core: pods<br/>list"]
    end

    subgraph NetworkResources["Networking Resources"]
        Ingresses["networking.k8s.io: ingresses<br/>get, list, watch,<br/>create, update, patch, delete"]
        NetworkPolicies["networking.k8s.io: networkpolicies<br/>get, list, watch,<br/>create, update, patch, delete"]
    end

    subgraph ScalingResources["Scaling & Reliability"]
        HPAs["autoscaling: horizontalpodautoscalers<br/>get, list, watch,<br/>create, update, patch, delete"]
        PDBs["policy: poddisruptionbudgets<br/>get, list, watch,<br/>create, update, patch, delete"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["monitoring.coreos.com:<br/>servicemonitors<br/>get, list, watch,<br/>create, update, patch, delete"]
        PrometheusRules["monitoring.coreos.com:<br/>prometheusrules<br/>get, list, watch,<br/>create, update, patch, delete"]
    end

    subgraph RBACResources["RBAC Resources"]
        ClusterRoleBindings_R["rbac: clusterrolebindings<br/>get, list, delete"]
        ClusterRoles_R["rbac: clusterroles<br/>get, list, watch"]
        RoleBindings_R["rbac: rolebindings<br/>get, list, watch,<br/>create, update, patch, delete"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        SCCs["security.openshift.io: scc<br/>use"]
        SCCAnyuid["security.openshift.io:<br/>scc (anyuid)<br/>use"]
        APIServers["config.openshift.io:<br/>apiservers<br/>get, list, watch"]
        CRDs["apiextensions.k8s.io:<br/>customresourcedefinitions<br/>get, list, watch"]
    end

    %% manager-role grants
    CR_Manager -->|"manages"| OGXResources
    CR_Manager -->|"manages"| CoreResources
    CR_Manager -->|"manages"| NetworkResources
    CR_Manager -->|"manages"| ScalingResources
    CR_Manager -->|"manages"| MonitoringResources
    CR_Manager -->|"manages"| RBACResources
    CR_Manager -->|"reads"| OpenShiftResources

    %% leader-election-role resources
    subgraph LeaderElection["Leader Election Resources"]
        LE_ConfigMaps["core: configmaps<br/>get, list, watch,<br/>create, update, patch, delete"]
        LE_Leases["coordination.k8s.io: leases<br/>get, list, watch,<br/>create, update, patch, delete"]
        LE_Events["core: events<br/>create, patch"]
    end

    R_Leader -->|"manages"| LeaderElection

    %% SCC grant
    CR_SCC -->|"grants"| SCCAnyuid

    %% Styling
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style SA_Instance fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_SCC fill:#f5a623,stroke:#333,color:#fff
    style R_Leader fill:#f5a623,stroke:#333,color:#fff
    style CRB_Manager fill:#e8e8e8,stroke:#333
    style RB_Leader fill:#e8e8e8,stroke:#333
    style RB_Instance fill:#e8e8e8,stroke:#333
    style OGXServers fill:#7ed321,stroke:#333,color:#fff
    style OGXServersStatus fill:#7ed321,stroke:#333,color:#fff
    style OGXServersFinalizers fill:#7ed321,stroke:#333,color:#fff
