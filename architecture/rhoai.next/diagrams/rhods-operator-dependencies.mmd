graph LR
    RhodsOp["rhods-operator<br/>(Platform Operator)"]

    %% External Dependencies (Required)
    RhodsOp -->|"operator framework<br/>v0.24.1"| CtrlRuntime["controller-runtime"]
    RhodsOp -->|"ingress CRDs<br/>v1.3.0"| GatewayAPI["Gateway API"]
    RhodsOp -->|"Route, OAuth, Config<br/>v0.0.0-20260317"| OpenShiftAPI["OpenShift API"]
    RhodsOp -->|"operator lifecycle<br/>v0.42.0"| OLM["OLM"]
    RhodsOp -->|"monitoring CRDs<br/>v0.74.0"| PromOperator["prometheus-operator"]
    RhodsOp -->|"EnvoyFilter, DestinationRule<br/>auth integration"| Istio["Istio<br/>(openshift-gateway)"]

    %% External Dependencies (Optional)
    RhodsOp -.->|"certificates<br/>(CloudManager)"| CertManager["cert-manager"]
    RhodsOp -.->|"distributed training<br/>(KServe, Trainer)"| LWS["LeaderWorkerSet"]
    RhodsOp -.->|"MonitoringStack, Tempo,<br/>Perses CRDs"| COO["Cluster Observability<br/>Operator"]
    RhodsOp -.->|"job scheduling<br/>stable-v1.4"| KueueOp["Kueue OCP Operator"]

    %% Internal Platform Components (managed)
    Dashboard["Dashboard"] -->|"Component CR"| RhodsOp
    KServe["KServe"] -->|"Component CR"| RhodsOp
    Kueue["Kueue"] -->|"Component CR<br/>+ CRD Watch"| RhodsOp
    Ray["Ray"] -->|"Component CR"| RhodsOp
    ModelReg["Model Registry"] -->|"Component CR"| RhodsOp
    ModelCtrl["ModelController"] -->|"Component CR"| RhodsOp
    Workbenches["Workbenches"] -->|"Component CR"| RhodsOp
    DSPipelines["DataSciencePipelines"] -->|"Component CR"| RhodsOp
    TrustyAI["TrustyAI"] -->|"Component CR"| RhodsOp
    Trainer["Trainer"] -->|"Component CR"| RhodsOp
    TrainingOp["TrainingOperator"] -->|"Component CR"| RhodsOp
    Feast["FeastOperator"] -->|"Component CR"| RhodsOp
    OGX["OGX"] -->|"Component CR"| RhodsOp
    Spark["SparkOperator"] -->|"Component CR"| RhodsOp

    %% Modules (deployed as separate pods)
    AIGw["AIGateway"] -->|"Module CR"| RhodsOp
    MLflow["MLflowOperator"] -->|"Module CR"| RhodsOp
    MCPLc["MCPLifecycleOperator"] -->|"Module CR"| RhodsOp

    %% Integration Points (external watchers)
    RhodsOp -.->|"Subscription watch"| RHCL["Red Hat Connectivity Link"]
    RhodsOp -.->|"CRD Watch"| CustomMetrics["Custom Metrics Autoscaler"]
    RhodsOp -.->|"Namespace watch"| Kuadrant["Kuadrant"]

    %% External Services
    RhodsOp -->|"CRD reconciliation<br/>6443/TCP"| K8sAPI["Kubernetes API"]
    RhodsOp -->|"OAuth client reg<br/>443/TCP"| OAuthSrv["OpenShift OAuth"]

    %% Styling
    style RhodsOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

