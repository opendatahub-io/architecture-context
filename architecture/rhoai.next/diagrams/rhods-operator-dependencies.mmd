graph LR
    RhodsOp["rhods-operator<br/>(Platform Operator)"]

    %% External Dependencies (Required)
    RhodsOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]
    RhodsOp -->|"ingress CRDs"| GatewayAPI["Gateway API<br/>v1.3.0"]
    RhodsOp -->|"OpenShift types"| OSAPI["openshift/api<br/>v0.0.0-20260317"]
    RhodsOp -->|"OLM types"| OFW["operator-framework<br/>v0.42.0"]
    RhodsOp -->|"monitoring CRDs"| PromOp["prometheus-operator<br/>v0.74.0"]
    RhodsOp -->|"auth + traffic"| Istio["Istio / Sail<br/>(Required on OCP)"]

    %% External Dependencies (Conditional)
    RhodsOp -.->|"TLS certs (xKS)"| CertManager["cert-manager"]
    RhodsOp -.->|"job queues"| KueueOp["Kueue Operator"]
    RhodsOp -.->|"wide endpoints"| LWS["LeaderWorkerSet<br/>Operator"]
    RhodsOp -.->|"autoscaler"| CMA["Custom Metrics<br/>Autoscaler"]
    RhodsOp -.->|"MonitoringStack"| COO["Cluster Observability<br/>Operator"]
    RhodsOp -.->|"trace storage"| TempoOp["Tempo Operator"]
    RhodsOp -.->|"telemetry"| OTelOp["OpenTelemetry<br/>Operator"]
    RhodsOp -.->|"dashboarding"| PersesOp["Perses Operator"]

    %% Internal RHOAI Components (in-tree, via Component CRs)
    RhodsOp -->|"Component CR"| Dashboard["Dashboard"]
    RhodsOp -->|"Component CR"| KServe["KServe"]
    RhodsOp -->|"Component CR"| ModelCtrl["Model Controller"]
    RhodsOp -->|"Component CR"| ModelReg["Model Registry"]
    RhodsOp -->|"Component CR"| DSP["Data Science<br/>Pipelines"]
    RhodsOp -->|"Component CR"| Workbenches["Workbenches"]
    RhodsOp -->|"Component CR"| TrustyAI["TrustyAI"]
    RhodsOp -->|"Component CR"| Kueue["Kueue"]
    RhodsOp -->|"Component CR"| Ray["Ray"]
    RhodsOp -->|"Component CR"| TrainingOp["Training Operator"]
    RhodsOp -->|"Component CR"| Trainer["Trainer"]
    RhodsOp -->|"Component CR"| Feast["Feast Operator"]
    RhodsOp -->|"Component CR"| OGX["OGX"]
    RhodsOp -->|"Component CR"| Spark["Spark Operator"]

    %% Internal RHOAI Modules (out-of-tree, via Module CRs)
    RhodsOp -->|"Module CR (Helm)"| AIGateway["AIGateway"]
    RhodsOp -->|"Module CR (Kustomize)"| MLflow["MLflow Operator"]
    RhodsOp -->|"Module CR"| MCPLifecycle["MCP Lifecycle<br/>Operator"]
    RhodsOp -->|"Module CR"| MonModule["Monitoring Module"]

    %% Cluster Services
    RhodsOp -->|"CRD watches"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    RhodsOp -->|"OAuth client"| OAuthSrv["OpenShift OAuth"]
    RhodsOp -->|"ingress cert"| IngressOp["OpenShift Ingress"]
    RhodsOp -->|"operator detection"| OLM["OLM"]

    %% Cloud Providers (via cloudmanager)
    RhodsOp -.->|"cloud mgmt"| AWS["AWS (EKS)"]
    RhodsOp -.->|"cloud mgmt"| Azure["Azure (AKS)"]
    RhodsOp -.->|"cloud mgmt"| CoreWeave["CoreWeave"]

    %% Styling
    style RhodsOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External required
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style OSAPI fill:#999,stroke:#333,color:#fff
    style OFW fill:#999,stroke:#333,color:#fff
    style PromOp fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff

    %% External conditional
    style CertManager fill:#bbb,stroke:#333,color:#fff
    style KueueOp fill:#bbb,stroke:#333,color:#fff
    style LWS fill:#bbb,stroke:#333,color:#fff
    style CMA fill:#bbb,stroke:#333,color:#fff
    style COO fill:#bbb,stroke:#333,color:#fff
    style TempoOp fill:#bbb,stroke:#333,color:#fff
    style OTelOp fill:#bbb,stroke:#333,color:#fff
    style PersesOp fill:#bbb,stroke:#333,color:#fff

    %% Internal components
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelCtrl fill:#7ed321,stroke:#333,color:#fff
    style ModelReg fill:#7ed321,stroke:#333,color:#fff
    style DSP fill:#7ed321,stroke:#333,color:#fff
    style Workbenches fill:#7ed321,stroke:#333,color:#fff
    style TrustyAI fill:#7ed321,stroke:#333,color:#fff
    style Kueue fill:#7ed321,stroke:#333,color:#fff
    style Ray fill:#7ed321,stroke:#333,color:#fff
    style TrainingOp fill:#7ed321,stroke:#333,color:#fff
    style Trainer fill:#7ed321,stroke:#333,color:#fff
    style Feast fill:#7ed321,stroke:#333,color:#fff
    style OGX fill:#7ed321,stroke:#333,color:#fff
    style Spark fill:#7ed321,stroke:#333,color:#fff

    %% Modules
    style AIGateway fill:#50a000,stroke:#333,color:#fff
    style MLflow fill:#50a000,stroke:#333,color:#fff
    style MCPLifecycle fill:#50a000,stroke:#333,color:#fff
    style MonModule fill:#50a000,stroke:#333,color:#fff

    %% Cluster services
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style OAuthSrv fill:#f5a623,stroke:#333,color:#fff
    style IngressOp fill:#f5a623,stroke:#333,color:#fff
    style OLM fill:#f5a623,stroke:#333,color:#fff

