graph TB
    subgraph UserCode["User Python Environment"]
        Notebook["Jupyter Notebook /<br/>Python Application"]
    end

    subgraph TrustyAIPython["trustyai-explainability-python SDK"]
        direction TB

        subgraph CoreModules["Core Modules"]
            ModelWrapper["trustyai.model<br/>Model / PredictionProvider /<br/>PredictionProviderArrow"]
            Explainers["trustyai.explainers<br/>LIME, SHAP, Counterfactual, PDP"]
            Metrics["trustyai.metrics<br/>Fairness, Saliency, Language"]
            Visualizations["trustyai.visualizations<br/>Matplotlib & Bokeh plots"]
        end

        subgraph OptionalModules["Optional Modules"]
            TMaRCo["trustyai.language.detoxify<br/>TMaRCo Detoxification"]
            APIClient["trustyai.utils.api<br/>Kubernetes API Client"]
            MetricsService["trustyai.utils.extras<br/>TrustyAIMetricsService"]
            Tyrus["trustyai.utils.tyrus<br/>Bokeh Dashboard"]
        end

        subgraph JavaBridge["Java Bridge Layer"]
            JPype["JPype1 JVM Bridge"]
            ArrowIPC["Apache Arrow IPC<br/>Zero-copy data transfer"]
            JAR["explainability-arrow JAR<br/>TrustyAI Java Core"]
        end
    end

    subgraph ExternalServices["External Services (Optional)"]
        TrustyAIService["TrustyAI Service<br/>HTTPS/443"]
        Thanos["Thanos Querier<br/>HTTPS/443"]
        HFHub["Hugging Face Hub<br/>HTTPS/443"]
        OSRoutes["OpenShift Route API<br/>HTTPS/443"]
    end

    subgraph UserModels["User ML Models"]
        SKLearn["scikit-learn"]
        XGBoost["XGBoost"]
        CustomModel["Custom Python Model"]
    end

    %% User interactions
    Notebook -->|"import trustyai"| ModelWrapper
    Notebook -->|"explain model"| Explainers
    Notebook -->|"compute fairness"| Metrics
    Notebook -->|"visualize results"| Visualizations
    Notebook -->|"interactive dashboard"| Tyrus

    %% Internal flows
    ModelWrapper -->|"wraps user model"| JPype
    Explainers -->|"calls Java algorithms"| JPype
    Metrics -->|"calls Java metrics"| JPype
    JPype -->|"JNI calls"| JAR
    ModelWrapper -->|"high-perf transfer"| ArrowIPC
    ArrowIPC -->|"Arrow IPC bytes"| JAR

    %% User model wrapping
    SKLearn -->|"predict function"| ModelWrapper
    XGBoost -->|"predict function"| ModelWrapper
    CustomModel -->|"predict function"| ModelWrapper

    %% Optional external connections
    APIClient -->|"route discovery"| OSRoutes
    MetricsService -->|"upload/query metrics"| TrustyAIService
    MetricsService -->|"PromQL queries"| Thanos
    TMaRCo -->|"download models"| HFHub

    %% Styling
    style TrustyAIPython fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style CoreModules fill:#bbdefb,stroke:#1565c0
    style OptionalModules fill:#c8e6c9,stroke:#388e3c
    style JavaBridge fill:#fff3e0,stroke:#e65100
    style ModelWrapper fill:#42a5f5,stroke:#1565c0,color:#fff
    style Explainers fill:#42a5f5,stroke:#1565c0,color:#fff
    style Metrics fill:#42a5f5,stroke:#1565c0,color:#fff
    style JPype fill:#ff9800,stroke:#e65100,color:#fff
    style JAR fill:#ff9800,stroke:#e65100,color:#fff
    style ArrowIPC fill:#ff9800,stroke:#e65100,color:#fff
    style TMaRCo fill:#66bb6a,stroke:#388e3c,color:#fff
    style APIClient fill:#66bb6a,stroke:#388e3c,color:#fff
    style MetricsService fill:#66bb6a,stroke:#388e3c,color:#fff
    style TrustyAIService fill:#e0e0e0,stroke:#616161
    style Thanos fill:#e0e0e0,stroke:#616161
    style HFHub fill:#e0e0e0,stroke:#616161
    style OSRoutes fill:#e0e0e0,stroke:#616161
    style Notebook fill:#f3e5f5,stroke:#7b1fa2
