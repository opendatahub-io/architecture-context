graph TB
    subgraph TrustyAI["trustyai-explainability-python"]
        direction TB

        subgraph Core["Core Library"]
            ModelModule["trustyai.model<br/>Model Wrappers<br/>(Model, PredictionProvider,<br/>PredictionProviderArrow)"]
            Explainers["trustyai.explainers<br/>LIME, SHAP,<br/>Counterfactual, PDP"]
            Metrics["trustyai.metrics<br/>Fairness, Explainability,<br/>Language Distance"]
        end

        subgraph Visualization["Visualization"]
            Viz["trustyai.visualizations<br/>Matplotlib / Bokeh"]
            Tyrus["trustyai.utils.tyrus<br/>Bokeh Interactive Dashboard"]
        end

        subgraph Optional["Optional Modules"]
            Detoxify["trustyai.language.detoxify<br/>TMaRCo Text Detoxification"]
            APIClient["trustyai.utils.api<br/>Kubernetes API Client"]
        end
    end

    subgraph JVMBridge["JVM Bridge Layer"]
        JPype["JPype1<br/>Python-to-Java Bridge"]
        Arrow["Apache Arrow IPC<br/>High-Performance Data Transfer"]
        JAR["explainability-arrow JAR<br/>TrustyAI Java Core"]
    end

    %% Internal connections
    ModelModule -->|wraps user models| Explainers
    Explainers -->|produces results| Metrics
    Explainers -->|produces results| Viz
    Viz -->|powers| Tyrus
    Explainers -->|calls via JPype| JPype
    ModelModule -->|Arrow IPC transfer| Arrow
    JPype -->|loads| JAR
    Arrow -->|data path| JAR

    %% External systems
    UserCode["Data Scientist<br/>Python Code / Notebook"] -->|import trustyai| ModelModule
    UserCode -->|optional| APIClient
    UserCode -->|optional| Detoxify

    APIClient -->|REST API<br/>HTTPS/443| TrustyAIService["TrustyAI Service"]
    APIClient -->|REST API<br/>HTTPS/443| Thanos["Thanos Querier"]
    APIClient -->|Route Discovery<br/>HTTPS/443| OpenShift["OpenShift API"]

    Detoxify -->|Downloads models<br/>HTTPS/443| HFHub["Hugging Face Hub"]

    JDK["JDK 17 Runtime"] -->|required by| JPype

    %% Styling
    style TrustyAI fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Core fill:#dbeafe,stroke:#4a90e2,stroke-width:1px
    style Visualization fill:#dbeafe,stroke:#4a90e2,stroke-width:1px
    style Optional fill:#fef3c7,stroke:#d97706,stroke-width:1px
    style JVMBridge fill:#f3e8ff,stroke:#7c3aed,stroke-width:2px
    style ModelModule fill:#4a90e2,color:#fff
    style Explainers fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style Viz fill:#4a90e2,color:#fff
    style Tyrus fill:#4a90e2,color:#fff
    style Detoxify fill:#f59e0b,color:#fff
    style APIClient fill:#f59e0b,color:#fff
    style JPype fill:#7c3aed,color:#fff
    style Arrow fill:#7c3aed,color:#fff
    style JAR fill:#7c3aed,color:#fff
    style UserCode fill:#e8e8e8,stroke:#666
    style TrustyAIService fill:#7ed321,stroke:#333
    style Thanos fill:#7ed321,stroke:#333
    style OpenShift fill:#7ed321,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style JDK fill:#999,stroke:#333
