graph TB
    subgraph Workers["INFERENCE WORKERS (Data Plane)"]
        SrcWorker["Source Inference Worker<br/>(vLLM / SGLang / TensorRT-LLM / Dynamo)<br/>GPU Pod"]
        TgtWorker["Target Inference Worker<br/>GPU Pod"]
    end

    subgraph ControlPlane["METADATA CONTROL PLANE"]
        MXServer["modelexpress-server<br/>8001/TCP gRPC<br/>Optional TLS<br/>Optional SA token auth<br/>100MB max message"]
    end

    subgraph MetaBackends["METADATA BACKENDS"]
        Redis["Redis<br/>6379/TCP<br/>Optional TLS<br/>URL-embedded creds<br/>⚠ No tenant isolation"]
        K8sAPIMeta["Kubernetes API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA token<br/>ModelMetadata / ModelCacheEntry CRDs"]
    end

    subgraph P2PPlane["P2P DATA PLANE (bypasses CNI)"]
        RDMA["NIXL/RDMA<br/>Direct GPU-to-GPU Memory<br/>No encryption<br/>⚠ Bypasses NetworkPolicy"]
    end

    subgraph OperatorPlane["OPERATOR CONTROL PLANE"]
        direction TB
        Operator["modelexpress-operator<br/>SA: modelexpress-operator<br/>NS: modelexpress-operator-system"]
        OpMetrics["Metrics: 8080/TCP HTTP<br/>or 8443/TCP HTTPS + Bearer"]
        OpHealth["Health: 8081/TCP HTTP<br/>Unauthenticated"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA token"]
        OCPConfig["OpenShift APIServer Config<br/>apiservers.config.openshift.io<br/>TLS profiles: Old/Intermediate/Modern/Custom"]
    end

    subgraph ExtServices["EXTERNAL MODEL SOURCES"]
        HF["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN Bearer"]
        NGC["NGC Catalog<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>NGC_API_KEY"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>ServiceMonitor<br/>8080 or 8443/TCP"]
    end

    %% Worker → Server flows
    SrcWorker -->|"gRPC/8001<br/>Optional TLS<br/>SA token auth"| MXServer
    TgtWorker -->|"gRPC/8001<br/>Optional TLS<br/>SA token auth"| MXServer

    %% Server → Metadata backends
    MXServer -->|"TCP/6379<br/>Optional TLS<br/>URL creds"| Redis
    MXServer -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPIMeta

    %% P2P transfer (bypasses everything)
    SrcWorker -.->|"NIXL/RDMA<br/>Direct GPU memory<br/>Bypasses CNI"| RDMA
    RDMA -.->|"Weight bytes<br/>GPU-to-GPU"| TgtWorker

    %% Server → External
    MXServer -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HF
    MXServer -->|"HTTPS/443<br/>TLS 1.2+<br/>NGC_API_KEY"| NGC

    %% Operator flows
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -->|"HTTPS/443<br/>TLS 1.2+<br/>SA token"| OCPConfig
    K8sAPI -->|"Watch CRs<br/>HTTPS"| Operator

    %% Observability
    Prometheus -->|"HTTP/8080 or<br/>HTTPS/8443 + Bearer"| OpMetrics

    %% Styling
    classDef worker fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef control fill:#d1fae5,stroke:#10b981,stroke-width:2px
    classDef meta fill:#fef3c7,stroke:#f59e0b,stroke-width:2px
    classDef p2p fill:#fee2e2,stroke:#ef4444,stroke-width:2px
    classDef operator fill:#e0e7ff,stroke:#6366f1,stroke-width:2px
    classDef k8s fill:#e5e7eb,stroke:#6b7280,stroke-width:2px
    classDef external fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    classDef observability fill:#f3e8ff,stroke:#8b5cf6,stroke-width:2px

    class SrcWorker,TgtWorker worker
    class MXServer control
    class Redis,K8sAPIMeta meta
    class RDMA p2p
    class Operator,OpMetrics,OpHealth operator
    class K8sAPI,OCPConfig k8s
    class HF,NGC external
    class Prometheus observability
