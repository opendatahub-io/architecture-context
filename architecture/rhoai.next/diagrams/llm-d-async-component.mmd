graph TB
    subgraph AP["Async Processor (llm-d-async)"]
        direction TB

        subgraph Core["Core Processing"]
            Runner["Runner<br/>(pkg/server/runner.go)"]
            Worker["Async Worker<br/>(pkg/asyncworker/worker.go)"]
            Transform["Request Transform Chain<br/>(pkg/asyncworker/transform/)"]
            Cancel["Cancellation Handler<br/>(pkg/asyncworker/cancellation.go)"]
            Runner --> Worker
            Worker --> Transform
            Worker --> Cancel
        end

        subgraph FlowControl["Flow Control Gates (11 types)"]
            GateFactory["Gate Factory"]
            Composite["composite"]
            PromSat["prometheus-saturation"]
            PromBudget["prometheus-budget"]
            PromQuery["prometheus-query"]
            RedisGate["redis"]
            RedisQuota["redis-quota"]
            LocalConc["local-concurrency"]
            EndpointScrape["endpoint-scrape"]
            TierPriority["tier-priority-admission"]
            WaitOnRefuse["wait-on-refuse"]
            GateFactory --> Composite
            GateFactory --> PromSat
            GateFactory --> PromBudget
            GateFactory --> PromQuery
            GateFactory --> RedisGate
            GateFactory --> RedisQuota
            GateFactory --> LocalConc
            GateFactory --> EndpointScrape
            GateFactory --> TierPriority
            GateFactory --> WaitOnRefuse
        end

        subgraph QueueBackends["Queue Backends"]
            RedisSS["Redis Sorted Set<br/>(pkg/redis/sortedset_impl.go)"]
            RedisPubSub["Redis Pub/Sub<br/>(pkg/redis/redisimpl.go)"]
            GCPPubSub["GCP Pub/Sub<br/>(pkg/pubsub/pubsubimpl.go)"]
        end

        subgraph MergePolicy["Request Merge Policies"]
            RandomRobin["random-robin"]
            TierPriorityPolicy["tier-priority"]
        end

        subgraph Observability["Observability"]
            Metrics["Prometheus Metrics<br/>9090/TCP"]
            Health["Health Probes<br/>8081/TCP"]
            Tracing["OTLP Tracing"]
        end

        Worker -->|consumes from| QueueBackends
        Worker -->|checks| GateFactory
        Worker -->|applies| MergePolicy
    end

    subgraph Libraries["Client Libraries"]
        APIModule["api/ module<br/>(zero external deps)"]
        ProducerModule["producer/ module<br/>(depends: api + go-redis)"]
        PipelineModule["pipeline/ module<br/>(depends: api)"]
    end

    ProducerClient["Producer Client"] -->|submits requests| ProducerModule
    ProducerModule -->|enqueues| RedisSS

    Worker -->|dispatches| IGW["llm-d-router /<br/>Inference Gateway"]
    Worker -->|writes results| QueueBackends

    PodMonitor["PodMonitor"] -->|scrapes| Metrics

    style AP fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Core fill:#d5e8d4,stroke:#82b366
    style FlowControl fill:#fff2cc,stroke:#d6b656
    style QueueBackends fill:#dae8fc,stroke:#6c8ebf
    style MergePolicy fill:#e1d5e7,stroke:#9673a6
    style Observability fill:#f8cecc,stroke:#b85450
    style Libraries fill:#f5f5f5,stroke:#666
    style ProducerClient fill:#f9f9f9,stroke:#999
    style IGW fill:#d5e8d4,stroke:#82b366
    style PodMonitor fill:#f9f9f9,stroke:#999
