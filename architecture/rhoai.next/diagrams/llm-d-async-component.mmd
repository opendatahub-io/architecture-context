graph TB
    subgraph AP["Async Processor (llm-d-async)"]
        direction TB
        Runner["Runner<br/>Service Entry Point"]
        Health["Health Server<br/>8081/TCP"]
        Metrics["Metrics Server<br/>9090/TCP"]

        subgraph GateSystem["Dispatch Gate Pipeline"]
            QueueGate["Queue Gate<br/>(per-queue admission)"]
            PoolGate["Pool Gate<br/>(shared capacity)"]
            BudgetGate["Budget Gate<br/>(Prometheus metrics)"]
            QuotaGate["Redis Quota Gate<br/>(rate/concurrency)"]
            WaitOnRefuse["Wait-on-Refuse<br/>(jittered backoff)"]
            CompositeGate["Composite Gate<br/>(combinator)"]
            TierPriority["Tier-Priority Merge<br/>(6 strict lanes)"]
        end

        subgraph Transports["Transport Layer"]
            RedisSS["Redis Sorted-Set<br/>Transport"]
            RedisPubSub["Redis Pub/Sub<br/>Transport"]
            GCPPubSub["GCP Pub/Sub<br/>Transport"]
        end

        subgraph Workers["Worker Pool"]
            WorkerPool["Worker Pool<br/>(concurrency: 64)"]
            RetryHandler["Retry Handler<br/>(exponential backoff)"]
        end

        Runner --> Health
        Runner --> Metrics
        Runner --> Transports
        Transports --> TierPriority
        TierPriority --> QueueGate
        QueueGate --> PoolGate
        PoolGate --> CompositeGate
        CompositeGate --> BudgetGate
        CompositeGate --> QuotaGate
        CompositeGate --> WaitOnRefuse
        PoolGate --> WorkerPool
        WorkerPool --> RetryHandler
    end

    subgraph Libraries["Go Library Modules"]
        APIModule["api/<br/>Wire Formats &amp; Interfaces"]
        PipelineModule["pipeline/<br/>Flow &amp; Gate Abstractions"]
        ProducerModule["producer/<br/>Redis Message Producer"]
    end

    Producer["Producer<br/>(external client)"] -->|enqueue requests| Redis["Redis / Valkey<br/>6379/TCP"]
    Redis -->|poll messages| Transports
    GCPPubSubSvc["GCP Pub/Sub<br/>443/TCP"] -->|subscribe| GCPPubSub
    WorkerPool -->|dispatch inference| Router["llm-d-router<br/>HTTP/HTTPS"]
    BudgetGate -->|query capacity| Prometheus["Prometheus<br/>9090/TCP"]
    QuotaGate -->|quota state| Redis
    WorkerPool -->|publish results| Redis
    Metrics -->|scrape| PromOperator["Prometheus Operator<br/>(PodMonitor)"]
    Runner -->|traces| OTLP["OTLP Collector<br/>4317/TCP"]

    APIModule -.->|types| AP
    PipelineModule -.->|interfaces| AP
    ProducerModule -.->|client lib| Producer

    style AP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Runner fill:#4a90e2,stroke:#333
    style Health fill:#4a90e2,stroke:#333
    style Metrics fill:#4a90e2,stroke:#333
    style GateSystem fill:#fff3e0,stroke:#e65100
    style Transports fill:#e8f5e9,stroke:#2e7d32
    style Workers fill:#fce4ec,stroke:#c62828
    style Libraries fill:#f3e5f5,stroke:#6a1b9a
    style Router fill:#7ed321,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style GCPPubSubSvc fill:#999,stroke:#333
    style OTLP fill:#999,stroke:#333
    style PromOperator fill:#999,stroke:#333
    style Producer fill:#e8e8e8,stroke:#333
