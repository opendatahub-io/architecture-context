graph TB
    subgraph Operator["OPERATOR (Trusted)"]
        OpWorkstation["Operator Workstation<br/>kubectl + uv"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>443/TCP HTTPS<br/>kubeconfig auth"]
    end

    subgraph ClusterPods["CLUSTER PODS (No Service Mesh)"]
        direction TB

        subgraph PreflightPod["Preflight Pod (llm-d vLLM container)"]
            PreflightHTTP["Preflight HTTP Server<br/>8000/TCP HTTP<br/>No TLS, No Auth"]
            vLLMProc["vLLM Process<br/>(starts after preflight exits)"]
        end

        subgraph NIXLServer["NIXL Server Pod"]
            PeerAgent["NIXL Peer Agent<br/>5555/TCP ZMQ PAIR<br/>No Encryption, No Auth<br/>SA: default<br/>GPU: nvidia.com/gpu: 1"]
        end

        subgraph NIXLClient["NIXL Client Pod"]
            CreatorAgent["NIXL Creator Agent<br/>SA: default<br/>GPU: nvidia.com/gpu: 1"]
        end

        subgraph RoCEPods["RoCE Variant Pods"]
            RoCENote["IPC_LOCK capability<br/>multi-nic-network<br/>nvidia.com/roce_gdr: 2"]
        end

        subgraph TestPods["Networking Test Pods"]
            PodA["Pod A - Server<br/>perftest: 18515/TCP"]
            PodB["Pod B - Client"]
        end
    end

    subgraph NodePort["NODE PORT EXPOSURE"]
        NP["NodePort 30002<br/>→ 5555/TCP<br/>No Auth"]
    end

    subgraph Egress["EGRESS (Build-Time)"]
        GitHub["GitHub<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        NVIDIAContent["content.mellanox.com<br/>443/TCP HTTPS"]
        NVIDIADev["developer.nvidia.com<br/>443/TCP HTTPS"]
        NVCR["nvcr.io<br/>443/TCP HTTPS"]
        PyPI["pypi.org<br/>443/TCP HTTPS"]
    end

    %% Flows
    OpWorkstation -->|"HTTPS/443<br/>TLS<br/>kubeconfig"| APIServer
    APIServer -->|"kubectl exec<br/>websocket"| PreflightHTTP
    APIServer -->|"kubectl exec<br/>websocket"| PodA
    APIServer -->|"kubectl exec<br/>websocket"| PodB

    OpWorkstation -->|"GET /info, /exit<br/>HTTP/8000<br/>No Auth"| PreflightHTTP
    PreflightHTTP -->|"&& chain"| vLLMProc

    CreatorAgent -->|"ZMQ PAIR/5555<br/>TCP<br/>No Encryption"| PeerAgent
    CreatorAgent -->|"NIXL Transfer<br/>UCX RDMA/TCP<br/>Dynamic Port<br/>No Auth"| PeerAgent
    PeerAgent -->|"exposed via"| NP

    PodB -->|"RDMA/18515<br/>No Encryption<br/>No Auth"| PodA

    %% Styling
    classDef operator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
    classDef k8s fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef pod fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000
    classDef nodeport fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#000
    classDef egress fill:#fff9c4,stroke:#f9a825,stroke-width:2px,color:#000
    classDef warning fill:#ffcdd2,stroke:#c62828,stroke-width:2px,color:#000

    class OpWorkstation operator
    class APIServer k8s
    class PreflightHTTP,vLLMProc,PeerAgent,CreatorAgent,PodA,PodB pod
    class NP nodeport
    class GitHub,NVIDIAContent,NVIDIADev,NVCR,PyPI egress
    class RoCENote warning
