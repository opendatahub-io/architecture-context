graph TB
    subgraph OGX["OGX (Llama Stack) Platform"]
        direction TB

        subgraph Server["Llama Stack Server (FastAPI + Uvicorn)<br/>Port 8321/TCP"]
            direction TB
            AuthMW["Authentication Middleware<br/>(ASGI)<br/>OAuth2 JWT / Custom Bearer"]
            QuotaMW["Quota Middleware<br/>(ASGI)<br/>Rate Limiting"]
            ABAC["Access Control Engine<br/>Cedar-inspired ABAC"]
            RoutingEngine["Routing Engine<br/>Resource → Provider mapping"]
            ProviderFW["Provider Framework<br/>Protocol-based plugin system"]

            AuthMW --> QuotaMW
            QuotaMW --> ABAC
            ABAC --> RoutingEngine
            RoutingEngine --> ProviderFW
        end

        subgraph APIs["API Surface"]
            direction LR
            InferenceAPI["/v1/inference/*<br/>Completion, Chat, Embeddings"]
            OpenAICompat["/v1/openai/v1/*<br/>OpenAI-compatible endpoints"]
            AgentsAPI["/v1/agents/*<br/>Agent lifecycle & turns"]
            SafetyAPI["/v1/safety/*<br/>Shield-based filtering"]
            VectorAPI["/v1/vector-io/*<br/>Insert & query vectors"]
            ToolsAPI["/v1/tools/*<br/>Tool groups & runtime"]
            EvalAPI["/v1/eval/*<br/>Benchmarks & evaluation"]
            TrainingAPI["/v1/post-training/*<br/>Fine-tuning & optimization"]
            DatasetAPI["/v1/datasets/*<br/>Dataset management"]
            TelemetryAPI["/v1/telemetry/*<br/>Spans & metrics"]
        end

        subgraph Providers["Provider Implementations"]
            direction LR
            InlineProviders["Inline Providers<br/>(in-process)<br/>meta-reference, FAISS,<br/>vLLM, sqlite-vec"]
            RemoteProviders["Remote Providers<br/>(external API)<br/>OpenAI, Anthropic, Bedrock,<br/>Gemini, NVIDIA, 20+ others"]
        end

        CLI["CLI (llama)<br/>Stack management,<br/>model download, server startup"]
        TelemetryAdapter["Telemetry Adapter<br/>OpenTelemetry W3C propagation"]
    end

    subgraph UI["Streamlit UI<br/>Port 8501/TCP"]
        Playground["Browser-based Playground"]
    end

    Client[External Client] -->|"HTTP/HTTPS<br/>Bearer Token"| Server
    Playground -->|"HTTP<br/>API calls"| Server

    APIs --> RoutingEngine
    ProviderFW --> InlineProviders
    ProviderFW --> RemoteProviders

    subgraph ExternalLLMs["External LLM Providers"]
        OpenAI_Ext["OpenAI API"]
        Anthropic_Ext["Anthropic API"]
        Bedrock_Ext["AWS Bedrock"]
        NVIDIA_Ext["NVIDIA NIM"]
        Gemini_Ext["Google Gemini"]
        Others_Ext["Groq, Together,<br/>Fireworks, etc."]
    end

    subgraph InfraBackends["Infrastructure Backends"]
        vLLM_Ext["vLLM"]
        Ollama_Ext["Ollama"]
        PG["PostgreSQL<br/>(pgvector)"]
        Redis_Ext["Redis"]
        SQLite_Ext["SQLite"]
        VectorDBs["Chroma / Milvus /<br/>Qdrant / Weaviate"]
    end

    RemoteProviders -->|"HTTPS/443"| ExternalLLMs
    InlineProviders --> InfraBackends
    RemoteProviders --> InfraBackends
    TelemetryAdapter -->|"OTLP"| OTELCollector["OTEL Collector"]

    %% Styling
    style OGX fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Server fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style APIs fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    style Providers fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style UI fill:#f8cecc,stroke:#b85450,stroke-width:1px
    style ExternalLLMs fill:#f9f9f9,stroke:#999,stroke-width:2px
    style InfraBackends fill:#f9f9f9,stroke:#999,stroke-width:2px

    style AuthMW fill:#f5a623,stroke:#333
    style QuotaMW fill:#f5a623,stroke:#333
    style ABAC fill:#f5a623,stroke:#333
    style RoutingEngine fill:#4a90e2,stroke:#333,color:#fff
    style ProviderFW fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333,stroke-width:2px
