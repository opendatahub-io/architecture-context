graph TB
    subgraph OGX["OGX (Llama Stack) Framework"]
        direction TB

        subgraph Server["FastAPI/Uvicorn Server :8321"]
            direction TB
            AuthMW["AuthenticationMiddleware<br/>OAuth2 JWT / Introspection / Custom"]
            QuotaMW["QuotaMiddleware<br/>Per-client rate limiting"]
            ABAC["ABAC Engine<br/>Permit/Forbid rules"]
            RouteReg["Dynamic Route Registration<br/>@webmethod → FastAPI routes"]
        end

        subgraph RoutingLayer["Routing Table Layer"]
            direction TB
            InferenceRouter["Inference Router"]
            SafetyRouter["Safety Router"]
            AgentRouter["Agent Router"]
            VectorRouter["Vector IO Router"]
            ToolRouter["Tool Runtime Router"]
            EvalRouter["Eval/Scoring Router"]
            DatasetRouter["Dataset Router"]
            TelemetryRouter["Telemetry Router"]
        end

        subgraph InlineProviders["Inline Providers (in-process)"]
            MetaRef["meta-reference<br/>Inference"]
            SQLiteVec["SQLite-vec<br/>Vector Store"]
            Faiss["Faiss<br/>Vector Store"]
            SQLiteKV["SQLite<br/>KV Store"]
            AgentRuntime["Agent Runtime<br/>Meta-reference"]
        end

        subgraph RemoteProviders["Remote Providers (API clients)"]
            VLLMProvider["vLLM Provider"]
            TGIProvider["TGI Provider"]
            OpenAIProvider["OpenAI Provider"]
            OtherProviders["Fireworks / Together /<br/>Cerebras / SambaNova /<br/>NVIDIA / WatsonX"]
        end

        CLI["llama CLI<br/>Build, configure, run distributions"]
        StreamlitUI["Streamlit UI<br/>Optional web interface"]
    end

    Client["External Client"] -->|"POST /v1/...<br/>8321/TCP HTTP"| AuthMW
    AuthMW --> QuotaMW
    QuotaMW --> RouteReg
    RouteReg --> InferenceRouter
    RouteReg --> SafetyRouter
    RouteReg --> AgentRouter
    RouteReg --> VectorRouter
    RouteReg --> ToolRouter
    RouteReg --> EvalRouter
    InferenceRouter -->|ABAC check| ABAC
    InferenceRouter --> MetaRef
    InferenceRouter --> VLLMProvider
    InferenceRouter --> TGIProvider
    InferenceRouter --> OpenAIProvider
    VectorRouter --> SQLiteVec
    VectorRouter --> Faiss
    AgentRouter --> AgentRuntime
    AgentRuntime --> InferenceRouter
    AgentRuntime --> ToolRouter
    StreamlitUI -->|"HTTP/8321"| Server

    VLLMProvider -->|HTTPS| VLLMBackend["vLLM Backend"]
    TGIProvider -->|HTTPS| TGIBackend["TGI Backend"]
    OpenAIProvider -->|HTTPS| OpenAIBackend["OpenAI API"]
    OtherProviders -->|HTTPS| CloudBackends["Cloud AI Backends"]

    AuthMW -->|"HTTPS/443"| JWKSEndpoint["JWKS / Introspection<br/>Endpoint"]

    style Server fill:#4a90e2,color:#fff
    style RoutingLayer fill:#5ba3cf,color:#fff
    style InlineProviders fill:#7ed321,color:#fff
    style RemoteProviders fill:#f5a623,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style CLI fill:#b8e6ff
    style StreamlitUI fill:#b8e6ff
    style VLLMBackend fill:#e8e8e8,stroke:#999
    style TGIBackend fill:#e8e8e8,stroke:#999
    style OpenAIBackend fill:#e8e8e8,stroke:#999
    style CloudBackends fill:#e8e8e8,stroke:#999
    style JWKSEndpoint fill:#e8e8e8,stroke:#999
