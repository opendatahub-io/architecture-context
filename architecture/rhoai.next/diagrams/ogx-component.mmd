graph TB
    subgraph External["External Clients"]
        Client[Client Application]
        SDK[llama-stack-client SDK]
    end

    subgraph OGX["OGX (Llama Stack) Server — Port 8321/TCP"]
        direction TB

        subgraph APILayer["API Layer (FastAPI/Uvicorn)"]
            direction LR
            InferenceAPI["/v1/inference/*<br/>Chat Completion, Embeddings"]
            OpenAIAPI["/v1/openai/v1/*<br/>OpenAI-Compatible API"]
            AgentsAPI["/v1/agents/*<br/>Agentic Workflows"]
            SafetyAPI["/v1/safety/*<br/>Content Safety Shields"]
            VectorAPI["/v1/vector-io/*<br/>Vector DB Operations"]
            RAGToolAPI["/v1/tool-runtime/rag-tool/*<br/>RAG Knowledge Base"]
            EvalAPI["/v1/eval/*<br/>Benchmarks & Evaluation"]
            ScoringAPI["/v1/scoring/*<br/>Scoring Functions"]
            TrainingAPI["/v1/post-training/*<br/>Fine-Tuning Jobs"]
            TelemetryAPI["/v1/telemetry/*<br/>Traces & Metrics"]
            ModelsAPI["/v1/models, /v1/shields,<br/>/v1/datasets, /v1/vector-dbs<br/>Resource Registry"]
            HealthAPI["/v1/health, /v1/version<br/>/v1/inspect/routes<br/>(Unauthenticated)"]
        end

        subgraph Middleware["Middleware Stack"]
            AuthMW["Auth Middleware<br/>(JWT / OAuth2 / Custom)"]
            AccessControl["Cedar-like Access Control<br/>(Permit/Forbid Rules)"]
            QuotaMW["Quota Middleware<br/>(Rate Limiting:<br/>100/day anon, 1000/day auth)"]
        end

        subgraph Routing["Routing Layer"]
            InferenceRouter["Inference Router<br/>(model dispatch, token counting)"]
            SafetyRouter["Safety Router"]
            VectorRouter["Vector IO Router"]
            ToolRouter["Tool Runtime Router"]
            AgentOrch["Agent Orchestrator<br/>(multi-turn, tool use, safety)"]
        end

        subgraph ProviderSystem["Provider Plugin System (70+ providers)"]
            direction LR
            InlineProviders["Inline Providers<br/>(in-process)"]
            RemoteProviders["Remote Providers<br/>(external services)"]
        end

        subgraph Storage["Storage Layer"]
            KVStore["KV Store<br/>(SQLite / Redis /<br/>PostgreSQL / MongoDB)"]
            SQLStore["SQL Store<br/>(SQLite / PostgreSQL)"]
        end
    end

    subgraph PlaygroundSubgraph["Playground UI — Port 8501/TCP"]
        Playground["Streamlit Web App<br/>Interactive Testing"]
    end

    subgraph CLI_Subgraph["CLI"]
        CLI["llama CLI<br/>(build, configure, run)"]
    end

    subgraph LibClient["Library Mode"]
        LibraryClient["Library Client<br/>(in-process, no network)"]
    end

    %% Client flows
    Client -->|"HTTP/HTTPS<br/>Bearer Token"| APILayer
    SDK -->|"HTTP/HTTPS<br/>Bearer Token"| APILayer
    Playground -->|"HTTP"| APILayer
    CLI -->|"manages"| OGX
    LibraryClient -->|"in-process"| ProviderSystem

    %% Internal flows
    APILayer --> Middleware
    Middleware --> Routing
    Routing --> ProviderSystem
    AgentOrch --> InferenceRouter
    AgentOrch --> SafetyRouter
    AgentOrch --> ToolRouter
    Routing --> Storage

    %% Styling
    style OGX fill:#e8f4fd,stroke:#2196F3,stroke-width:2px
    style APILayer fill:#bbdefb,stroke:#1976D2
    style Middleware fill:#fff3e0,stroke:#f57c00
    style Routing fill:#e8f5e9,stroke:#388E3C
    style ProviderSystem fill:#f3e5f5,stroke:#7B1FA2
    style Storage fill:#fce4ec,stroke:#C62828
    style Client fill:#f5f5f5,stroke:#616161
    style SDK fill:#f5f5f5,stroke:#616161
    style Playground fill:#fff9c4,stroke:#F9A825
    style CLI fill:#e0f2f1,stroke:#00695C
    style LibraryClient fill:#e0f2f1,stroke:#00695C
    style AuthMW fill:#ffcc80,stroke:#ef6c00
    style AccessControl fill:#ffcc80,stroke:#ef6c00
    style QuotaMW fill:#ffcc80,stroke:#ef6c00
