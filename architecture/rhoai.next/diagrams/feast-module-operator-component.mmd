graph TB
    subgraph FMO["feast-module-operator"]
        direction TB
        Reconciler["Reconciler<br/>controller-runtime"]
        ActionPipeline["Action Pipeline<br/>deploy / render / status"]
        KustomizeRenderer["Kustomize Renderer<br/>ODH / RHOAI overlays"]
        UpgradeHandler["Upgrade Handler<br/>semver + platform version"]
        Reconciler --> ActionPipeline
        ActionPipeline --> KustomizeRenderer
        ActionPipeline --> UpgradeHandler
    end

    subgraph ChartGen["chartgen CLI"]
        HelmGen["Helm Chart Generator"]
    end

    ODHOperator["ODH Operator"] -->|"creates via Helm chart"| FMO
    ODHOperator -->|"creates"| FeastOperatorCR["FeastOperator CR<br/>(Cluster-scoped singleton)"]
    FeastOperatorCR -->|"watched by"| Reconciler

    ODHOperator -->|"creates/updates"| ConfigMap["odh-feastoperator-config<br/>ConfigMap"]
    ConfigMap -->|"watched by<br/>(named predicate)"| UpgradeHandler

    KustomizeRenderer -->|"renders &amp; applies"| FeastOperatorDeploy["feast-operator<br/>Deployment"]
    KustomizeRenderer -->|"deploys"| FeatureStoreCRD["FeatureStore CRD<br/>(feast.dev/v1)"]

    FeastOperatorDeploy -->|"manages"| FeatureStoreCR["FeatureStore CRs<br/>(Namespaced)"]

    Reconciler -->|"creates"| ServiceMonitor["ServiceMonitor<br/>prometheus-operator"]
    Reconciler -->|"calls"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]

    FeastOperatorDeploy -->|"creates"| OnlineServer["Online Server"]
    FeastOperatorDeploy -->|"creates"| OfflineServer["Offline Server"]
    FeastOperatorDeploy -->|"creates"| Registry["Registry Service"]
    FeastOperatorDeploy -->|"creates"| CronJobs["Materialization<br/>CronJobs"]

    style FMO fill:#4a90e2,stroke:#333,color:#fff
    style Reconciler fill:#5b9bd5,stroke:#333,color:#fff
    style ActionPipeline fill:#5b9bd5,stroke:#333,color:#fff
    style KustomizeRenderer fill:#5b9bd5,stroke:#333,color:#fff
    style UpgradeHandler fill:#5b9bd5,stroke:#333,color:#fff
    style ChartGen fill:#4a90e2,stroke:#333,color:#fff
    style HelmGen fill:#5b9bd5,stroke:#333,color:#fff
    style ODHOperator fill:#7ed321,stroke:#333,color:#fff
    style FeastOperatorCR fill:#f5a623,stroke:#333,color:#fff
    style FeatureStoreCRD fill:#f5a623,stroke:#333,color:#fff
    style FeatureStoreCR fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style FeastOperatorDeploy fill:#9b59b6,stroke:#333,color:#fff
    style ServiceMonitor fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OnlineServer fill:#ddd,stroke:#333
    style OfflineServer fill:#ddd,stroke:#333
    style Registry fill:#ddd,stroke:#333
    style CronJobs fill:#ddd,stroke:#333
