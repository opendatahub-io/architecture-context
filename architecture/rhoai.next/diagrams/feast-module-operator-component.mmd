graph TB
    subgraph "Feast Module Operator"
        direction TB
        Controller["feast-module-operator<br/>(Go Operator / controller-runtime)"]
        InitContainer["copy-manifests<br/>(Init Container)"]
        ChartGen["chartgen<br/>(CLI Subcommand)"]

        InitContainer -->|"copies kustomize manifests<br/>to shared emptyDir"| Controller
    end

    subgraph "Kustomize Manifests (Bundled)"
        direction TB
        ODHOverlay["ODH Overlay<br/>ns: opendatahub"]
        RHOAIOverlay["RHOAI Overlay<br/>ns: redhat-ods-applications"]
    end

    PlatformOperator["rhods-operator /<br/>opendatahub-operator"] -->|"creates"| FeastOperatorCR["FeastOperator CR<br/>(Cluster-scoped, singleton)"]
    PlatformOperator -->|"creates"| ConfigMap["odh-feastoperator-config<br/>ConfigMap"]

    FeastOperatorCR -->|"watched by"| Controller
    ConfigMap -->|"read by<br/>(platform version)"| Controller

    Controller -->|"selects overlay<br/>based on platform"| ODHOverlay
    Controller -->|"selects overlay<br/>based on platform"| RHOAIOverlay

    Controller -->|"renders & deploys"| UpstreamOperator["Upstream Feast Operator<br/>(Deployment)"]
    Controller -->|"installs"| FeatureStoreCRD["FeatureStore CRD<br/>(feast.dev/v1)"]
    Controller -->|"creates"| UpstreamRBAC["Upstream RBAC<br/>(ClusterRoles, Bindings)"]
    Controller -->|"creates"| ServiceMonitor["ServiceMonitor<br/>(Prometheus)"]

    UpstreamOperator -->|"watches"| FeatureStoreCR["FeatureStore CR<br/>(user-created)"]

    Prometheus["Prometheus /<br/>OpenShift Monitoring"] -->|"scrapes metrics<br/>8443/TCP HTTPS"| Controller

    K8sAPI["Kubernetes API Server"] ---|"443/TCP HTTPS"| Controller

    ChartGen -.->|"generates Helm chart<br/>from kustomize output"| HelmChart["Helm Chart<br/>(config/chart/)"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style ChartGen fill:#4a90e2,stroke:#333,color:#fff
    style FeastOperatorCR fill:#f5a623,stroke:#333,color:#fff
    style FeatureStoreCRD fill:#f5a623,stroke:#333,color:#fff
    style FeatureStoreCR fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style PlatformOperator fill:#7ed321,stroke:#333
    style UpstreamOperator fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style ODHOverlay fill:#e8e8e8,stroke:#333
    style RHOAIOverlay fill:#e8e8e8,stroke:#333
    style UpstreamRBAC fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#e8e8e8,stroke:#333
    style HelmChart fill:#e8e8e8,stroke:#333
