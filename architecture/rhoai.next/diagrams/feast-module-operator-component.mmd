graph TB
    subgraph "Feast Module Operator"
        direction TB
        InitContainer["copy-manifests<br/>(Init Container)<br/>Copies kustomize manifests<br/>to /opt/manifests"]
        Controller["feast-module-operator<br/>(Go Operator)<br/>controller-runtime"]
        Chartgen["chartgen<br/>(Go CLI Tool)<br/>Generates Helm chart<br/>from kustomize output"]

        InitContainer -.->|"populates<br/>emptyDir volume"| Controller
    end

    %% CRDs Watched
    PlatformOp["ODH Platform Operator<br/>(opendatahub-operator)"] -->|"creates"| FeastOpCR["FeastOperator CR<br/>components.platform.opendatahub.io/v1<br/>(Cluster-scoped, singleton)"]
    FeastOpCR -->|"watched by"| Controller

    %% ConfigMap Handshake
    PlatformOp -->|"writes platformVersion"| ConfigMap["odh-feastoperator-config<br/>ConfigMap"]
    ConfigMap -->|"watched by"| Controller

    %% Deployed Resources
    Controller -->|"renders kustomize &<br/>deploys"| FeastOp["feast-operator<br/>controller-manager<br/>(Deployment)"]
    Controller -->|"deploys"| FeatureStoreCRD["FeatureStore CRD<br/>feast.dev/v1"]
    Controller -->|"deploys"| RBAC["ClusterRoles &<br/>RoleBindings"]
    Controller -->|"deploys"| SA["ServiceAccounts"]
    Controller -->|"deploys"| SvcMon["ServiceMonitor"]

    %% Downstream Resources
    FeastOp -->|"manages"| FeatureStoreCR["FeatureStore CR<br/>feast.dev/v1"]

    %% External Dependencies
    Controller -->|"API calls"| K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>8443/TCP HTTPS"| MetricsSvc["opendatahub-feast-<br/>metrics-service"]

    %% Helm Chart Path
    Chartgen -.->|"build-time<br/>generates"| HelmChart["Helm Chart<br/>(config/chart)"]
    PlatformOp -->|"deploys via"| HelmChart

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style Chartgen fill:#4a90e2,stroke:#333,color:#fff
    style FeastOpCR fill:#f5a623,stroke:#333
    style FeatureStoreCRD fill:#f5a623,stroke:#333
    style FeatureStoreCR fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style PlatformOp fill:#7ed321,stroke:#333
    style FeastOp fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style RBAC fill:#ddd,stroke:#333
    style SA fill:#ddd,stroke:#333
    style SvcMon fill:#ddd,stroke:#333
    style MetricsSvc fill:#ddd,stroke:#333
    style HelmChart fill:#ddd,stroke:#333
