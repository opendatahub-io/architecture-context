graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["OpenShift Gateway (Envoy)<br/>443/TCP external<br/>TLS 1.2+<br/>OIDC Authentication"]
    end

    subgraph AuthSidecar["AUTH SIDECAR (Per-Pod Boundary)"]
        KubeRBAC["kube-rbac-proxy<br/>8443/TCP TLS<br/>Bearer Token / OIDC<br/>Injected by notebook-controller"]
    end

    subgraph Workbenches["WORKBENCH CONTAINERS"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            Jupyter["JupyterLab<br/>8888/TCP HTTP<br/>Variants: Minimal, DS,<br/>PyTorch, TF, TrustyAI<br/>CPU / CUDA 12.6 / ROCm 6.2"]
            CodeServer["Code Server v4.98.0<br/>8787/TCP HTTP<br/>NGINX + supervisord"]
            RStudio["RStudio Server 2024.12.1<br/>8787/TCP HTTP<br/>NGINX + supervisord<br/>R 4.4.3"]
        end
    end

    subgraph Runtimes["PIPELINE RUNTIMES (Batch)"]
        subgraph NS_Pipeline["Namespace: {pipeline-namespace}"]
            RuntimePod["Runtime Container<br/>No exposed ports<br/>SA: pipeline runner<br/>Variants: Minimal, DS,<br/>PyTorch, TF, ROCm"]
        end
    end

    subgraph BuildPipeline["CI/CD (Build Pipeline)"]
        GitHub["GitHub<br/>PR Events"]
        Konflux["Konflux / PipelinesAsCode<br/>(Tekton)<br/>CEL-based triggers"]
        Quay["quay.io/opendatahub<br/>443/TCP HTTPS<br/>Registry credentials"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PyPI["PyPI (pypi.org)<br/>443/TCP HTTPS<br/>No auth"]
        CUDA["NVIDIA CUDA repo<br/>443/TCP HTTPS<br/>GPG signature"]
        ROCm["AMD ROCm repo<br/>443/TCP HTTPS<br/>No auth"]
        PyTorch["download.pytorch.org<br/>443/TCP HTTPS<br/>No auth"]
        S3["S3 / Data Sources<br/>443/TCP HTTPS<br/>AWS IAM / Credentials"]
    end

    %% User access flow
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KubeRBAC
    KubeRBAC -->|"HTTP/8888<br/>No encryption<br/>Pre-authenticated"| Jupyter
    KubeRBAC -->|"HTTP/8787<br/>No encryption<br/>Pre-authenticated"| CodeServer
    KubeRBAC -->|"HTTP/8787<br/>No encryption<br/>Pre-authenticated"| RStudio

    %% Pipeline runtime flow
    RuntimePod -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3

    %% Build pipeline flow
    GitHub -->|"HTTPS/443<br/>Webhook secret"| Konflux
    Konflux -->|"HTTPS/443<br/>Registry creds"| Quay

    %% Build-time egress (dashed = build-time only)
    Konflux -.->|"build-time"| PyPI
    Konflux -.->|"build-time"| CUDA
    Konflux -.->|"build-time"| ROCm
    Konflux -.->|"build-time"| PyTorch

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef runtime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef build fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Gateway ingress
    class KubeRBAC auth
    class Jupyter,CodeServer,RStudio workbench
    class RuntimePod runtime
    class GitHub,Konflux,Quay build
    class PyPI,CUDA,ROCm,PyTorch,S3 externalservice
