graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Router["OpenShift Router / Gateway API<br/>HTTPRoute CR (RHOAI 3.x)<br/>Route (RHOAI 2.x)<br/>TLS 1.3 Edge Termination"]
    end

    subgraph Pod["WORKBENCH POD"]
        direction TB

        subgraph AuthSidecar["Auth Sidecar"]
            KubeRBAC["kube-rbac-proxy<br/>Port: 8443/TCP<br/>TLS<br/>SubjectAccessReview"]
        end

        subgraph JupyterContainer["Jupyter Container (Option A)"]
            Jupyter["JupyterLab<br/>Port: 8888/TCP<br/>HTTP (plaintext)<br/>WebSocket support"]
        end

        subgraph ProxiedContainer["CodeServer/RStudio Container (Option B)"]
            NGINX["NGINX 1.24<br/>Port: 8787/TCP<br/>Reverse Proxy"]
            CodeServerApp["code-server v4.98.0<br/>or RStudio Server"]
            FastCGI["FastCGI<br/>access.cgi / probe.cgi<br/>Culling API"]
            Supervisord["supervisord<br/>Process Manager"]
            Supervisord ---|manages| NGINX
            Supervisord ---|manages| CodeServerApp
            NGINX -->|proxy_pass<br/>localhost| CodeServerApp
            NGINX -->|FastCGI| FastCGI
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP<br/>HTTPS TLS 1.3<br/>ServiceAccount Token"]
        NotebookController["ODH Notebook Controller<br/>Creates Pod + Sidecar"]
    end

    subgraph BuildTimeEgress["BUILD-TIME EGRESS (not runtime)"]
        RedHatReg["registry.access.redhat.com<br/>443/TCP HTTPS<br/>Pull Secret"]
        PyPI["pypi.org<br/>443/TCP HTTPS<br/>No Auth"]
        NVIDIARepo["NVIDIA CUDA Repos<br/>443/TCP HTTPS<br/>No Auth"]
        ROCmRepo["AMD ROCm Repos<br/>443/TCP HTTPS<br/>No Auth"]
        QuayRegistry["quay.io/modh/*<br/>443/TCP HTTPS<br/>Quay Token"]
    end

    %% Runtime flows
    User -->|"HTTPS/443<br/>TLS 1.3<br/>OAuth (OpenShift)"| Router
    Router -->|"HTTPS/8443<br/>TLS<br/>OAuth token"| KubeRBAC
    KubeRBAC -->|"HTTP/8888<br/>No TLS (pod-local)<br/>Trusted after RBAC"| Jupyter
    KubeRBAC -->|"HTTP/8787<br/>No TLS (pod-local)<br/>Trusted after RBAC"| NGINX
    Jupyter -->|"HTTPS/443<br/>TLS 1.3<br/>SA Token"| K8sAPI
    NGINX -->|"HTTPS/443<br/>TLS 1.3<br/>SA Token"| K8sAPI
    NotebookController -.->|"injects sidecar<br/>creates HTTPRoute"| Pod

    %% Build-time flows (dashed)
    BuildTimeEgress -.->|"build-time only"| Pod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#ff6b6b,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef buildtime fill:#fff2cc,stroke:#d6b656,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class Router ingress
    class KubeRBAC auth
    class Jupyter,CodeServerApp,FastCGI,Supervisord workbench
    class NGINX proxy
    class K8sAPI,NotebookController cluster
    class RedHatReg,PyPI,NVIDIARepo,ROCmRepo,QuayRegistry buildtime
