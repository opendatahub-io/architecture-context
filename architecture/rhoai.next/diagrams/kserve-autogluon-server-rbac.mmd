graph TD
    subgraph "AutoGluon Server — No Direct RBAC"
        Note["This component defines no RBAC resources.<br/>It runs as a non-privileged container (UID 1001)<br/>and does not interact with the Kubernetes API."]
    end

    subgraph "Authentication Flow (Platform-Enforced)"
        Client["External Client"]
        KRBP["kube-rbac-proxy Sidecar<br/>(injected by KServe Controller)"]
        AG["AutoGluon Server<br/>Port 8080/TCP"]

        Client -->|"HTTPS/8443<br/>Bearer Token"| KRBP
        KRBP -->|"Token Validation<br/>Platform RBAC Policy"| AuthCheck{"Auth Check"}
        AuthCheck -->|"Authorized"| AG
        AuthCheck -->|"Unauthorized"| Reject["403 Forbidden"]
    end

    subgraph "Endpoint Auth Matrix"
        direction LR
        V1Predict["/v1/models/*:predict<br/>POST"]
        V2Infer["/v2/models/*/infer<br/>POST"]
        V2Meta["/v2/models/*<br/>GET"]
        V1Meta["/v1/models/*<br/>GET"]
        HealthReady["/v2/health/ready<br/>GET"]
        HealthLive["/v2/health/live<br/>GET"]

        V1Predict -->|"Bearer Token<br/>via kube-rbac-proxy"| Protected["Protected"]
        V2Infer -->|"Bearer Token<br/>via kube-rbac-proxy"| Protected
        V2Meta -->|"Bearer Token<br/>via kube-rbac-proxy"| Protected
        V1Meta -->|"Bearer Token<br/>via kube-rbac-proxy"| Protected
        HealthReady -->|"No auth"| Unprotected["Unauthenticated"]
        HealthLive -->|"No auth"| Unprotected
    end

    subgraph "Pod Security Context"
        PodSec["Container runs as:<br/>UID: 1001 (non-root)<br/>No privileged capabilities<br/>No K8s API access<br/>No secrets defined in component"]
    end

    style Note fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style Protected fill:#c8e6c9,stroke:#2e7d32
    style Unprotected fill:#fff9c4,stroke:#f9a825
    style Reject fill:#ffcdd2,stroke:#c62828
    style KRBP fill:#ffcdd2,stroke:#c62828
    style AG fill:#c8e6c9,stroke:#2e7d32
    style PodSec fill:#e3f2fd,stroke:#1565c0
