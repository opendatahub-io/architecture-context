graph TD
    subgraph "AutoGluon Server — RBAC Model"
        direction TB

        Note["NOTE: The autogluon server is a passive<br/>inference container. It does NOT interact<br/>with the Kubernetes API directly.<br/><br/>RBAC is managed by the KServe Operator<br/>for the pod's service account."]
    end

    subgraph "KServe Operator RBAC (manages this pod)"
        SA["ServiceAccount<br/>(set by InferenceService)"]

        subgraph "Platform-Managed Roles"
            CR["ClusterRole<br/>kserve-manager-role<br/>(defined by KServe Operator)"]
        end

        subgraph "API Resources Accessed by Operator"
            IS["serving.kserve.io<br/>InferenceService"]
            CSR["serving.kserve.io<br/>ClusterServingRuntime"]
            TM["serving.kserve.io<br/>TrainedModel"]
            Pods["core<br/>Pods"]
            Services["core<br/>Services"]
            Deployments["apps<br/>Deployments"]
        end

        SA -.->|"pod runs with<br/>this identity"| CR
        CR -->|"get,list,watch,create,<br/>update,patch,delete"| IS
        CR -->|"get,list,watch"| CSR
        CR -->|"get,list,watch,create,<br/>update,patch,delete"| TM
        CR -->|"get,list,watch,create,<br/>update,patch,delete"| Pods
        CR -->|"get,list,watch,create,<br/>update,patch,delete"| Services
        CR -->|"get,list,watch,create,<br/>update,patch,delete"| Deployments
    end

    subgraph "Authentication (Sidecar)"
        ClientAuth["Client Request<br/>Bearer Token"]
        KRBP["kube-rbac-proxy<br/>8443/TCP"]
        ServerPort["autogluonserver<br/>8080/TCP (no auth)"]

        ClientAuth -->|"HTTPS + Bearer Token"| KRBP
        KRBP -->|"validates token<br/>against platform RBAC"| KRBP
        KRBP -->|"HTTP plaintext<br/>(localhost proxy)"| ServerPort
    end

    subgraph "Secrets Access"
        StorageCreds["storage-credentials<br/>(Opaque)<br/>S3/GCS/Azure credentials"]
        Mount["Volume Mount<br/>(by KServe Operator)"]

        StorageCreds -->|"mounted into pod"| Mount
        Mount -->|"accessed via SDK<br/>credential chains"| ServerPort
    end

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style IS fill:#7ed321
    style CSR fill:#7ed321
    style TM fill:#7ed321
    style Pods fill:#7ed321
    style Services fill:#7ed321
    style Deployments fill:#7ed321
    style KRBP fill:#f5a623,color:#fff
    style StorageCreds fill:#e74c3c,color:#fff
