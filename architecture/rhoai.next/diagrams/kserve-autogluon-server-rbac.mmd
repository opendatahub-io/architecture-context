graph TD
    subgraph PodSecurity["Pod Security Context"]
        UID["UID 1001<br/>(non-root, unprivileged)"]
        NoPriv["No privileged capabilities"]
        ReadOnlyRoot["Read-only root filesystem<br/>(except /tmp, /mnt/models)"]
    end

    subgraph ServingRuntime["ClusterServingRuntime Registration"]
        CSR["kserve-autogluonserver<br/>(ClusterServingRuntime)"]
        ModelFormat["Model Format: autogluon v1<br/>autoSelect: true"]
        Protocols["Protocols: v1, v2"]
        Resources["Default Resources:<br/>1 CPU, 2Gi Memory"]
    end

    subgraph AuthBoundaries["Authentication Boundaries"]
        direction TB
        AppLayer["Application Layer<br/>(autogluonserver)<br/>NO AUTH"]
        DataPlane["KServe Data Plane<br/>(Istio/Knative/Gateway)<br/>AUTH ENFORCED HERE"]
        K8sAPI["Kubernetes API<br/>RBAC via KServe Operator"]
    end

    subgraph DelegatedRBAC["Delegated RBAC (KServe Operator)"]
        InfSvcSA["InferenceService<br/>ServiceAccount"]
        OpRole["KServe Operator Roles<br/>(manages InferenceService lifecycle)"]
        StorageCreds["Storage Credentials<br/>(per-namespace secrets)"]
    end

    CSR -->|"registers format"| ModelFormat
    CSR -->|"exposes"| Protocols
    CSR -->|"limits"| Resources

    DataPlane -->|"forwards authenticated<br/>requests to"| AppLayer
    K8sAPI -->|"managed by"| OpRole

    InfSvcSA -->|"bound to"| OpRole
    InfSvcSA -->|"accesses"| StorageCreds

    UID -->|"runs"| AppLayer

    style PodSecurity fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ServingRuntime fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style AuthBoundaries fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style DelegatedRBAC fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style AppLayer fill:#f8cecc,stroke:#b85450
    style DataPlane fill:#d5e8d4,stroke:#82b366
    style UID fill:#d5e8d4,stroke:#82b366
