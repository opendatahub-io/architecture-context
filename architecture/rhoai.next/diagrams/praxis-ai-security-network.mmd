graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["AI Client<br/>(OpenAI SDK / Anthropic SDK /<br/>MCP Client / A2A Agent)"]
    end

    subgraph Gateway["PRAXIS AI GATEWAY"]
        direction TB

        subgraph Listener["Proxy Listener — 8080/TCP"]
            ProxyEntry["Request Entry<br/>HTTP/HTTPS<br/>TLS: rustls + OpenSSL provider"]
        end

        subgraph SecurityFilters["Security Filter Pipeline (security-class enforced)"]
            direction LR
            StateOwner["state_owner<br/>Tenant Identity"]
            CredInject["credential_inject<br/>Upstream Auth"]
            ProviderRoute["provider_route<br/>Provider Routing"]
            AWSSigV4["aws_sigv4_sign<br/>AWS SigV4"]
            AzureAD["azure_ad<br/>Azure AD Token"]
            GCPADC["gcp_adc<br/>GCP ADC"]
            BasicAuth["Basic Auth<br/>(htpasswd)"]
        end

        subgraph Admin["Admin API — 9901/TCP"]
            AdminEndpoint["Health Check: /healthy<br/>Localhost-only (default)<br/>No Auth"]
        end
    end

    subgraph Backends["BACKEND SERVICES"]
        direction TB
        Inference["Inference Backends<br/>(vLLM, etc.)<br/>HTTP/HTTPS<br/>Bearer / SigV4 / Azure AD / GCP ADC"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS / mTLS<br/>SCRAM-SHA-256"]
        NeMo["NeMo Guardrails<br/>HTTP/HTTPS<br/>Content Safety"]
        MCPServers["MCP Servers<br/>HTTP Streamable<br/>Tool Dispatch"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB
        Metering["External Metering<br/>HTTP/HTTPS<br/>Token Usage"]
        ExtProc["llm-d ext_proc<br/>gRPC (optional)<br/>No Auth"]
        CloudIDP["AWS STS / Azure AD / GCP<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8080/TCP<br/>TLS optional (OpenSSL)<br/>Bearer / API Key / mTLS"| ProxyEntry
    ProxyEntry --> StateOwner
    StateOwner --> CredInject
    CredInject --> ProviderRoute

    ProviderRoute -->|"HTTP/HTTPS<br/>TLS configurable<br/>Injected credentials"| Inference
    ProxyEntry -->|"PostgreSQL 5432/TCP<br/>TLS / mTLS<br/>SCRAM-SHA-256"| PostgreSQL
    ProxyEntry -->|"HTTP/HTTPS<br/>TLS configurable"| NeMo
    ProxyEntry -->|"HTTP Streamable<br/>TLS configurable"| MCPServers
    ProxyEntry -->|"HTTP/HTTPS<br/>TLS configurable"| Metering
    ProxyEntry -.->|"gRPC<br/>Configurable<br/>No Auth"| ExtProc
    AWSSigV4 -->|"HTTPS 443/TCP<br/>TLS 1.2+"| CloudIDP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef security fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef admin fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class ProxyEntry gateway
    class StateOwner,CredInject,ProviderRoute,AWSSigV4,AzureAD,GCPADC,BasicAuth security
    class AdminEndpoint admin
    class Inference,PostgreSQL,NeMo,MCPServers backend
    class Metering,ExtProc,CloudIDP externalservice
