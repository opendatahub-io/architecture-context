graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["ML Training Client<br/>(mlflow SDK)"]
        DashboardUI["RHOAI Dashboard<br/>(Module Federation)"]
    end

    subgraph Ingress["INGRESS (Optional)"]
        K8sIngress["Kubernetes Ingress<br/>5000/TCP<br/>TLS: SIMPLE (configurable)<br/>Host: mlflow.local (default)"]
    end

    subgraph Application["APPLICATION (ClusterIP)"]
        direction TB

        subgraph SecurityStack["Security Middleware"]
            CORS["CORSBlockingMiddleware"]
            HostVal["HostValidationMiddleware"]
            SecHeaders["SecurityHeadersMiddleware<br/>X-Content-Type-Options: nosniff<br/>X-Frame-Options: SAMEORIGIN"]
            Auth["Auth Plugin<br/>kubernetes-auth: TokenReview<br/>basic-auth: PBKDF2"]
        end

        subgraph Server["MLflow Server"]
            FastAPI["FastAPI + Flask WSGI<br/>Port: 5000/TCP<br/>SA: configurable<br/>Image: UBI9-minimal:9.7"]
            KEK["Gateway Secrets<br/>AES-GCM + KEK<br/>Versioned rotation"]
        end

        CORS --> HostVal --> SecHeaders --> Auth --> FastAPI
    end

    subgraph DataStore["DATA STORE"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL wire protocol<br/>Configurable TLS<br/>Username/password"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>(MinIO / AWS S3 / Ceph)<br/>443/TCP or 9000/TCP<br/>TLS 1.2+<br/>AWS IAM / Access Key"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>ServiceAccount token"]
        LLM["External LLM Providers<br/>(OpenAI, Anthropic)<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key (KEK-encrypted)"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Optional Bearer token"]
        DNS["CoreDNS<br/>53/TCP+UDP, 5353/TCP+UDP<br/>No encryption"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS :5000<br/>Configurable TLS<br/>kubernetes-auth token"| K8sIngress
    DashboardUI -->|"Module Federation<br/>JS import (build-time)"| FastAPI
    K8sIngress -->|"HTTP :5000<br/>Internal"| CORS

    FastAPI -->|"PostgreSQL :5432<br/>Configurable TLS<br/>Username/password"| PostgreSQL
    FastAPI -->|"HTTPS :443/9000<br/>TLS 1.2+<br/>AWS IAM / Access Key"| S3
    FastAPI -->|"HTTPS :6443<br/>TLS 1.2+<br/>SA token (TokenReview)"| K8sAPI
    FastAPI -->|"HTTPS :443<br/>TLS 1.2+<br/>API Key (encrypted)"| LLM
    FastAPI -->|"HTTPS :443<br/>TLS 1.2+<br/>Bearer token"| HF
    FastAPI -->|"DNS :53<br/>No encryption"| DNS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client,DashboardUI external
    class K8sIngress ingress
    class FastAPI,KEK application
    class CORS,HostVal,SecHeaders,Auth security
    class PostgreSQL datastore
    class S3,K8sAPI,LLM,HF,DNS externalservice
