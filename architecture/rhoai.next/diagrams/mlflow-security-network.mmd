graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User Browser / MLflow SDK<br/>Kubernetes Bearer Token"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        Gateway["ODH Data Science Gateway<br/>HTTPRoute: /mlflow<br/>443/TCP → 5000/TCP<br/>TLS 1.2+ SIMPLE"]
    end

    subgraph AppTier["APPLICATION TIER"]
        direction TB

        subgraph MLflowPod["MLflow Pod (restrictive securityContext)"]
            Server["MLflow Server<br/>SA: mlflow<br/>Image: rhoai/odh-mlflow-rhel9<br/>Port: 5000/TCP ClusterIP"]
            AuthPlugin["kubernetes-auth plugin<br/>SelfSubjectAccessReview<br/>mlflow.kubeflow.org"]
            WorkspaceProv["kubernetes workspace provider<br/>Namespace mapping"]
        end
    end

    subgraph Backend["BACKEND SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>SA Token Auth"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Connection String Auth"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP or 9000/TCP<br/>TLS, AWS credentials/IRSA"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>GCP credentials"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>Azure credentials"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token / OAuth"| Gateway
    Gateway -->|"HTTP or HTTPS/5000<br/>Configurable TLS<br/>Forwarded Bearer Token"| Server
    Server --- AuthPlugin
    Server --- WorkspaceProv
    AuthPlugin -->|"HTTPS/6443<br/>TLS<br/>SA Token"| K8sAPI
    WorkspaceProv -->|"HTTPS/6443<br/>TLS<br/>SA Token"| K8sAPI
    Server -->|"PostgreSQL/5432<br/>Configurable encryption<br/>Connection string"| PostgreSQL
    Server -->|"HTTPS/443 or 9000<br/>TLS<br/>AWS creds/IRSA"| S3
    Server -.->|"HTTPS/443<br/>TLS<br/>GCP creds"| GCS
    Server -.->|"HTTPS/443<br/>TLS<br/>Azure creds"| Azure

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef apptier fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class Server,AuthPlugin,WorkspaceProv apptier
    class K8sAPI,PostgreSQL backend
    class S3,GCS,Azure externalservice
