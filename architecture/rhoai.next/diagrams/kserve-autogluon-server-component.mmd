graph TB
    subgraph AutoGluonPod["KServe InferenceService Pod"]
        direction TB

        subgraph AuthProxy["Auth Proxy"]
            KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP HTTPS"]
        end

        subgraph ServerContainer["autogluonserver Container"]
            direction TB
            MainModule["__main__.py<br/>Entry Point"]
            ModelServer["KServe ModelServer<br/>(FastAPI + gRPC)"]
            PredictorFactory["predictor_factory.py<br/>Auto-detect model type"]
            VersionCompat["version_compat.py<br/>Patch-tolerant loading"]
            RuntimePaths["runtime_paths.py<br/>OpenShift path handling"]

            subgraph Predictors["Model Predictors"]
                TabularModel["TabularModel<br/>predict / predict_proba"]
                TimeSeriesModel["TimeSeriesModel<br/>forecast with covariates"]
            end

            MainModule --> ModelServer
            MainModule --> PredictorFactory
            PredictorFactory --> VersionCompat
            PredictorFactory --> TabularModel
            PredictorFactory --> TimeSeriesModel
            MainModule --> RuntimePaths
        end

        subgraph BundledLibs["Bundled Libraries"]
            KServeSDK["kserve SDK 0.19.0<br/>REST v1/v2 + gRPC protocols"]
            KServeStorage["kserve-storage 0.19.0<br/>S3/GCS/Azure/HF download"]
        end

        KubeRBACProxy -->|"proxy 8080/TCP<br/>localhost"| ModelServer
        ModelServer --> KServeSDK
        PredictorFactory --> KServeStorage
    end

    subgraph RESTEndpoints["REST API (8080/TCP)"]
        V1Predict["/v1/models/{name}:predict<br/>POST - JSON dict"]
        V2Infer["/v2/models/{name}/infer<br/>POST - Tensor"]
        V2Meta["/v2/models/{name}<br/>GET - Metadata"]
        V2Health["/v2/health/live | /ready<br/>GET - Health checks"]
    end

    subgraph GRPCEndpoint["gRPC API (8081/TCP)"]
        GRPCInfer["GRPCInferenceService<br/>ModelInfer, ModelReady<br/>ServerReady, ServerLive"]
    end

    ModelServer --> V1Predict
    ModelServer --> V2Infer
    ModelServer --> V2Meta
    ModelServer --> V2Health
    ModelServer --> GRPCInfer

    Client["External Client"] -->|"HTTPS/8443<br/>Bearer Token"| KubeRBACProxy

    KServeOp["KServe Operator"] -->|"creates pod via<br/>InferenceService CR"| AutoGluonPod
    CSR["ClusterServingRuntime"] -->|"defines runtime spec<br/>image, ports, format"| KServeOp

    KServeStorage -->|"HTTPS/443"| S3["S3 Storage"]
    KServeStorage -->|"HTTPS/443"| GCS["Google Cloud Storage"]
    KServeStorage -->|"HTTPS/443"| Azure["Azure Blob Storage"]
    KServeStorage -->|"HTTPS/443"| HFHub["Hugging Face Hub"]

    Prometheus["Prometheus"] -->|"scrape 8080/TCP"| ModelServer

    style AutoGluonPod fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style AuthProxy fill:#ffe6cc,stroke:#d79b00
    style ServerContainer fill:#d5e8d4,stroke:#82b366
    style BundledLibs fill:#fff2cc,stroke:#d6b656
    style TabularModel fill:#4a90e2,color:#fff
    style TimeSeriesModel fill:#4a90e2,color:#fff
    style KubeRBACProxy fill:#f5a623,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style KServeOp fill:#7ed321,color:#fff
    style CSR fill:#7ed321,color:#fff
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style Azure fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
