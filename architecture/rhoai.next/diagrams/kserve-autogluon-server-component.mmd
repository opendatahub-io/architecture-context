graph TB
    subgraph AutoGluonServer["AutoGluon Server (autogluonserver)"]
        direction TB
        Main["__main__.py<br/>Entrypoint"]
        Factory["predictor_factory.py<br/>AutoGluonDetectedModel"]
        TabularModel["AutoGluonTabularModel<br/>v1 JSON + v2 Tensor"]
        TimeSeriesModel["AutoGluonTimeSeriesModel<br/>v1 JSON only"]
        ModelRepo["AutoGluonModelRepository<br/>Multi-model scanner"]
        VersionCompat["version_compat.py<br/>Patch-version tolerance"]
        RuntimePaths["runtime_paths.py<br/>Writable cwd/MPLCONFIGDIR"]

        Main -->|creates| Factory
        Factory -->|auto-detects type| TabularModel
        Factory -->|auto-detects type| TimeSeriesModel
        Factory -->|uses| VersionCompat
        Main -->|ensures paths| RuntimePaths
        ModelRepo -->|loads models via| Factory
    end

    subgraph KServeSDK["KServe Python SDK"]
        ModelServer["ModelServer<br/>FastAPI + uvicorn"]
        GRPCServer["gRPC Server<br/>grpcio"]
        KServeModel["kserve.Model<br/>Base Interface"]
    end

    Main -->|starts| ModelServer
    Main -->|starts| GRPCServer
    TabularModel -->|implements| KServeModel
    TimeSeriesModel -->|implements| KServeModel

    Client["Client<br/>(via KServe Data Plane)"] -->|"POST /v1/models/:predict<br/>POST /v2/models/infer"| ModelServer
    Client -->|"gRPC ModelInfer"| GRPCServer

    StorageInit["KServe Storage Initializer<br/>(Init Container)"] -->|downloads to| MntModels["/mnt/models<br/>(Shared Volume)"]
    MntModels -->|loaded by| Factory

    Prometheus["Prometheus"] -->|"GET /metrics<br/>8080/TCP"| ModelServer

    CSR["ClusterServingRuntime<br/>kserve-autogluonserver"] -.->|registers format| KServeOp["KServe Operator"]
    KServeOp -->|provisions pod with| AutoGluonServer

    style AutoGluonServer fill:#4a90e2,stroke:#333,color:#fff
    style KServeSDK fill:#e8e8e8,stroke:#333
    style TabularModel fill:#7ed321,stroke:#333
    style TimeSeriesModel fill:#7ed321,stroke:#333
    style Factory fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style StorageInit fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style KServeOp fill:#f5a623,stroke:#333
    style CSR fill:#ffe6cc,stroke:#d79b00
