graph LR
    MLflow["MLflow<br/>Tracking Server"]

    %% External Dependencies (Required)
    MLflow -->|"metadata store<br/>:5432 PostgreSQL"| PostgreSQL["PostgreSQL 13+"]
    MLflow -->|"runtime"| Python312["Python 3.12"]

    %% External Dependencies (Optional)
    MLflow -.->|"artifact storage<br/>:443/:9000 HTTPS/HTTP"| S3["S3-Compatible Storage<br/>(MinIO / AWS S3 / Ceph)"]
    MLflow -.->|"trace export<br/>OTLP HTTP"| OTELCollector["OpenTelemetry<br/>Collector"]
    MLflow -.->|"model downloads<br/>:443 HTTPS"| HuggingFace["HuggingFace Hub"]

    %% Build-only Dependencies
    MLflow -.->|"UI build<br/>(build-only)"| NodeJS["Node.js 24"]
    MLflow -.->|"dev/test<br/>(development only)"| SQLite["SQLite 3.34+"]

    %% Internal RHOAI Dependencies
    MLflow -->|"workspace provider<br/>auth (TokenReview)<br/>:6443 HTTPS"| K8sAPI["Kubernetes<br/>API Server"]
    MLflow -->|"UI embedding<br/>Module Federation"| RHOAIDashboard["RHOAI Dashboard"]

    %% AI Gateway Egress
    MLflow -.->|"LLM proxy<br/>:443 HTTPS"| LLMProviders["External LLM Providers<br/>(OpenAI, Anthropic, etc.)"]

    %% Integration Points (other components → MLflow)
    RHOAIDashboard -->|"embeds UI modules<br/>Module Federation"| MLflow
    Operator["rhods-operator"] -->|"manages deployment<br/>K8s resources"| MLflow
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>:5000 HTTP"| MLflow
    WebhookRx["Webhook Receivers"] <-.->|"event webhooks<br/>HTTPS"| MLflow

