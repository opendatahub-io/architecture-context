graph LR
    MLflow["MLflow Server"]

    %% External Dependencies
    MLflow -->|"ASGI framework"| FastAPI["FastAPI &lt;1"]
    MLflow -->|"ASGI server"| Uvicorn["uvicorn &lt;1"]
    MLflow -->|"database ORM"| SQLAlchemy["SQLAlchemy &lt;3"]
    MLflow -->|"DB migrations"| Alembic["alembic &lt;2"]
    MLflow -->|"TLS/crypto"| Cryptography["cryptography &ge;43"]
    MLflow -->|"serialization"| Protobuf["protobuf &ge;3.12"]
    MLflow -->|"tracing"| OTel["OpenTelemetry &ge;1.9"]

    %% Internal RHOAI Dependencies
    MLflow -->|"RBAC enforcement"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    MLflow -->|"deployment lifecycle"| MLflowOp["MLflow Operator"]
    MLflow -->|"traffic routing"| ODHGateway["ODH Gateway<br/>HTTPRoute /mlflow"]

    %% Integration Points
    ODHDashboard["ODH Dashboard"] -->|"embedded UI"| MLflow
    MLflow -->|"auth plugin"| K8sPlugins["mlflow-kubernetes-plugins &ge;1.6"]

    %% External Services
    MLflow -->|"metadata store<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    MLflow -->|"artifact storage<br/>443/TCP"| S3["S3-compatible Storage"]
    MLflow -.->|"artifact storage<br/>443/TCP"| GCS["Google Cloud Storage"]
    MLflow -.->|"artifact storage<br/>443/TCP"| Azure["Azure Blob Storage"]

    %% Optional Dependencies
    MLflow -.->|"S3 client"| Boto3["boto3"]
    MLflow -.->|"PG driver"| Psycopg2["psycopg2"]

