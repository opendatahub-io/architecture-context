    MLflow -.->|"dev backend<br/>local file"| SQLite["SQLite 3.34+<br/>(default)"]

    %% External Dependencies (Optional - Storage)
    MLflow -->|"artifact storage<br/>443/TCP HTTPS"| S3["S3-compatible<br/>(AWS S3 / MinIO)"]

    %% Build-only Dependencies
    MLflow -.->|"UI build only"| NodeJS["Node.js 24"]

    %% Internal Platform Dependencies
    RHOAIOp["RHOAI Operator"] -->|"deploys &<br/>manages lifecycle"| MLflow
    MLflow -->|"SA token auth<br/>namespace discovery<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    Dashboard["RHOAI Dashboard"] -->|"embeds UI via<br/>module federation"| MLflow

    %% AI Gateway - LLM Provider Dependencies
    MLflow -->|"AI Gateway proxy<br/>443/TCP HTTPS"| OpenAI["OpenAI API"]
    MLflow -->|"AI Gateway proxy<br/>443/TCP HTTPS"| Anthropic["Anthropic API"]
    MLflow -->|"AI Gateway proxy<br/>443/TCP HTTPS"| Gemini["Google Gemini API"]

    %% Integration Points (inbound)
    Prometheus["Prometheus"] -->|"metrics scrape<br/>5000/TCP"| MLflow
    OTelCollectors["OTel Collectors"] -->|"OTLP/HTTP spans<br/>5000/TCP"| MLflow

