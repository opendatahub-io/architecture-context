graph LR
    AGC["ai-gateway-controller"]

    %% Deployment Owner
    AGCOperator["ai-gateway-operator"] -->|deploys| AGC

    %% Internal RHOAI Dependencies
    AGC -->|"watches CRDs<br/>(MaasTenantConfig, AITenant)"| MaaSController["maas-controller"]
    AGC -->|"vendors manifests<br/>(kustomize build)"| PraxisExtProc["praxis-extproc"]

    %% Infrastructure Dependencies
    AGC -->|"CRD watches + SSA apply<br/>6443/TCP HTTPS"| KubeAPI["Kubernetes API"]
    AGC -->|"creates HTTPRoutes<br/>(per-model routing)"| GatewayAPI["Gateway API"]
    AGC -->|"creates EnvoyFilter<br/>DestinationRule<br/>ServiceEntry"| Istio["Istio"]

    %% Build Dependencies
    AGC -.->|"runtime"| Go["Go 1.26.7"]
    AGC -.->|"operator framework"| ControllerRuntime["controller-runtime v0.23.3"]
    AGC -.->|"manifest rendering"| Kustomize["sigs.k8s.io/kustomize v0.21.1"]
    AGC -.->|"content-addressed digest"| JCS["gowebpki/jcs v1.0.1"]

    %% Reverse Dependencies (consumers)
    MaaSController -->|"annotation CAS<br/>backend swap handshake"| AGC

    %% Dataplane Flow (not controller)
    PraxisExtProc -->|"proxies inference<br/>(Envoy ExtProc)"| ExternalLLM["External LLM<br/>Providers"]

    %% Styling
    style AGC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style AGCOperator fill:#7ed321,stroke:#333,color:#fff
    style MaaSController fill:#7ed321,stroke:#333,color:#fff
    style PraxisExtProc fill:#7ed321,stroke:#333,color:#fff
    style KubeAPI fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style Go fill:#e8e8e8,stroke:#333
    style ControllerRuntime fill:#e8e8e8,stroke:#333
    style Kustomize fill:#e8e8e8,stroke:#333
    style JCS fill:#e8e8e8,stroke:#333
    style ExternalLLM fill:#f5a623,stroke:#333,color:#fff
