graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>HTTPS"]
    end

    subgraph DataPlane["DATA PLANE (mTLS Mesh)"]
        direction TB
        LocalGateway["Provider Gateway (Local)<br/>configurable/TCP HTTPS<br/>mTLS peer auth"]
        RemoteGateway["Provider Gateway (Remote)<br/>configurable/TCP HTTPS<br/>mTLS peer auth"]
        Backend["Inference Backend<br/>HTTPS/HTTP"]
    end

    subgraph ControlPlane["CONTROL PLANE (grid-system namespace)"]
        direction TB

        subgraph OperatorPod["Operator Pod<br/>SA: grid-operator<br/>Replicas: 1 (Recreate)<br/>runAsNonRoot, readOnlyRootFS, drop ALL"]
            MetricsHealth["Metrics/Health<br/>9090/TCP HTTP<br/>No auth"]
            SWIMPort["SWIM Runtime<br/>7946/UDP<br/>AES-256-GCM<br/>Shared key"]
            SignalsPort["Signals Endpoint<br/>9091/TCP HTTPS<br/>mTLS site cert"]
        end

        OverlaySync["overlay-sync sidecar<br/>ConfigMap watcher"]
    end

    subgraph EnrollmentPlane["ENROLLMENT PLANE"]
        Enrollment["Enrollment Service<br/>8443/TCP HTTPS TLS<br/>TokenReview + SAR auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (optional)<br/>Connection string"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS TLS<br/>ServiceAccount token"]
        MCPServers["MCP Tool Servers<br/>configurable HTTPS<br/>TLS"]
    end

    subgraph PeerSites["PEER SITES"]
        PeerOps["Peer Operators<br/>7946/UDP + 9091/TCP"]
        PeerGws["Peer Gateways<br/>mTLS"]
    end

    %% External client flow
    Client -->|"HTTPS / TLS<br/>Bearer token"| LocalGateway
    LocalGateway -->|"HTTPS / mTLS<br/>Site certificate"| RemoteGateway
    RemoteGateway -->|"HTTPS/HTTP<br/>Backend credential (injected)"| Backend

    %% Control plane flows
    SWIMPort -->|"UDP/7946<br/>AES-256-GCM<br/>Shared SWIM key"| PeerOps
    SignalsPort -->|"HTTPS/9091<br/>mTLS<br/>Site certificate"| PeerOps

    %% Overlay flow
    OperatorPod -->|"Write ConfigMap<br/>K8s API"| OverlaySync
    OverlaySync -->|"File write<br/>overlay config"| LocalGateway

    %% Enrollment flow
    Enrollment -->|"TCP/5432<br/>TLS (optional)<br/>Connection string"| PostgreSQL

    %% K8s API access
    OperatorPod -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    OverlaySync -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    Enrollment -->|"HTTPS/443<br/>TLS (TokenReview+SAR)"| K8sAPI

    %% MCP probing
    OperatorPod -->|"HTTPS<br/>TLS"| MCPServers

    %% Gateway to peers
    LocalGateway -->|"HTTPS<br/>mTLS"| PeerGws

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef dataplane fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef enrollment fill:#e8daef,stroke:#8e44ad,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef peer fill:#fde8e8,stroke:#e74c3c,stroke-width:2px

    class Client external
    class LocalGateway,RemoteGateway,Backend dataplane
    class MetricsHealth,SWIMPort,SignalsPort,OverlaySync controlplane
    class Enrollment enrollment
    class PostgreSQL,K8sAPI,MCPServers externalservice
    class PeerOps,PeerGws peer
