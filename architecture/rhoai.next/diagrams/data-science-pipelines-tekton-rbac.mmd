graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CacheDeployer["kubeflow-pipelines-<br/>cache-deployer-sa"]
        SA_Pipeline["ml-pipeline"]
        SA_UI["ml-pipeline-ui"]
        SA_Persist["ml-pipeline-<br/>persistenceagent"]
        SA_Sched["ml-pipeline-<br/>scheduledworkflow"]
        SA_Viewer["ml-pipeline-viewer-<br/>crd-service-account"]
        SA_Cache["kubeflow-<br/>pipelines-cache"]
        SA_MLMD["metadata-grpc-server"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB["kubeflow-pipelines-cache-<br/>deployer-clusterrolebinding<br/>(Cluster-scoped)"]
    end

    subgraph ClusterRoles["ClusterRole Permissions"]
        CR["kubeflow-pipelines-cache-<br/>deployer-clusterrole"]
    end

    subgraph APIResources["API Resources"]
        CSR["certificates.k8s.io<br/>certificatesigningrequests"]
        CSRApproval["certificates.k8s.io<br/>certificatesigningrequests/approval"]
        MWC["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations"]
        Signers["certificates.k8s.io<br/>signers"]
    end

    %% RBAC chain for cache deployer
    SA_CacheDeployer -->|bound via| CRB
    CRB -->|grants| CR
    CR -->|"create, delete,<br/>get, update"| CSR
    CR -->|"create, delete,<br/>get, update"| CSRApproval
    CR -->|"create, delete,<br/>get, list, patch"| MWC
    CR -->|approve| Signers

    subgraph IstioAuthZ["Istio AuthorizationPolicies (multi-user mode)"]
        MySQLPolicy["MySQL AuthzPolicy<br/>ALLOW"]
        MinIOPolicy["MinIO AuthzPolicy<br/>ALLOW"]
    end

    subgraph DataServices["Protected Data Services"]
        MySQLSvc["MySQL<br/>3306/TCP"]
        MinIOSvc["MinIO<br/>9000/TCP"]
    end

    %% MySQL access
    SA_Pipeline -->|allowed| MySQLPolicy
    SA_UI -->|allowed| MySQLPolicy
    SA_Persist -->|allowed| MySQLPolicy
    SA_Sched -->|allowed| MySQLPolicy
    SA_Viewer -->|allowed| MySQLPolicy
    SA_Cache -->|allowed| MySQLPolicy
    SA_MLMD -->|allowed| MySQLPolicy
    MySQLPolicy -->|protects| MySQLSvc

    %% MinIO access
    SA_Pipeline -->|allowed| MinIOPolicy
    SA_UI -->|allowed| MinIOPolicy
    MinIOPolicy -->|protects| MinIOSvc

    subgraph AuthN["Authentication (multi-user mode)"]
        TokenReview["Kubernetes TokenReview<br/>Validates Bearer Token"]
        SAR["SubjectAccessReview<br/>Checks User Authorization"]
    end

    SA_Pipeline -->|"API server calls"| TokenReview
    TokenReview -->|"on success"| SAR

    %% Styling
    style SA_CacheDeployer fill:#4a90e2,stroke:#333,color:#fff
    style SA_Pipeline fill:#4a90e2,stroke:#333,color:#fff
    style SA_UI fill:#4a90e2,stroke:#333,color:#fff
    style SA_Persist fill:#4a90e2,stroke:#333,color:#fff
    style SA_Sched fill:#4a90e2,stroke:#333,color:#fff
    style SA_Viewer fill:#4a90e2,stroke:#333,color:#fff
    style SA_Cache fill:#4a90e2,stroke:#333,color:#fff
    style SA_MLMD fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style CSR fill:#7ed321,stroke:#333
    style CSRApproval fill:#7ed321,stroke:#333
    style MWC fill:#7ed321,stroke:#333
    style Signers fill:#7ed321,stroke:#333
    style MySQLPolicy fill:#e8744f,stroke:#333,color:#fff
    style MinIOPolicy fill:#e8744f,stroke:#333,color:#fff
    style MySQLSvc fill:#e8e8e8,stroke:#333
    style MinIOSvc fill:#e8e8e8,stroke:#333
    style TokenReview fill:#9b59b6,stroke:#333,color:#fff
    style SAR fill:#9b59b6,stroke:#333,color:#fff
