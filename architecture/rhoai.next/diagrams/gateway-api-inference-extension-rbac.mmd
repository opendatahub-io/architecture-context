graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_EPP["{release} ServiceAccount<br/>(EPP)"]
        SA_BBR["{release} ServiceAccount<br/>(BBR)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_NS["{release}-sa RoleBinding<br/>Namespace: {release-namespace}"]
        CRB_Metrics["ClusterRoleBinding<br/>(conditional: --metrics-endpoint-auth)"]
    end

    subgraph Roles["Namespace Roles"]
        Role_SA["{release}-sa Role<br/>(namespace-scoped)"]
    end

    subgraph ClusterRoles["Cluster Roles (Conditional)"]
        CR_TokenReview["EPP Metrics Auth<br/>ClusterRole"]
    end

    subgraph NamespacedResources["Namespaced API Resources"]
        Pods["core<br/>pods"]
    end

    subgraph ClusterResources["Cluster API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        MetricsNonResource["/metrics<br/>(non-resource URL)"]
    end

    subgraph CRDResources["CRD Resources Watched"]
        InferencePool["inference.networking.k8s.io/v1<br/>InferencePool"]
        InferenceObjective["inference.networking.x-k8s.io/v1alpha2<br/>InferenceObjective"]
        InferenceModelRewrite["inference.networking.x-k8s.io/v1alpha2<br/>InferenceModelRewrite"]
        ConfigMaps["core<br/>ConfigMaps<br/>(bbr-managed=true)"]
        Leases["coordination.k8s.io<br/>Leases<br/>(leader election)"]
    end

    subgraph SecretResources["Secrets"]
        MetricsSecret["inference-gateway-sa-metrics-reader-secret<br/>Type: kubernetes.io/service-account-token<br/>Purpose: ServiceMonitor auth"]
        TLSCerts["TLS Certificates<br/>Type: tls.crt/tls.key<br/>RSA 4096-bit (self-signed)<br/>Hot reload via fsnotify"]
    end

    %% Namespace Role bindings
    SA_EPP -->|"bound via"| RB_NS
    SA_BBR -->|"bound via"| RB_NS
    RB_NS -->|"grants"| Role_SA
    Role_SA -->|"get, watch, list"| Pods

    %% Cluster Role bindings (conditional)
    SA_EPP -->|"bound via (conditional)"| CRB_Metrics
    CRB_Metrics -->|"grants"| CR_TokenReview
    CR_TokenReview -->|"create"| TokenReviews
    CR_TokenReview -->|"create"| SAR
    CR_TokenReview -->|"get"| MetricsNonResource

    %% CRD watches (via controller-runtime, SA token auth)
    SA_EPP -.->|"watches via<br/>controller-runtime"| InferencePool
    SA_EPP -.->|"watches via<br/>controller-runtime"| InferenceObjective
    SA_EPP -.->|"watches via<br/>controller-runtime"| InferenceModelRewrite
    SA_EPP -.->|"watches via<br/>controller-runtime"| Leases
    SA_BBR -.->|"watches via<br/>controller-runtime"| ConfigMaps

    %% Secrets associations
    SA_EPP -.->|"uses"| MetricsSecret
    SA_EPP -.->|"mounts"| TLSCerts
    SA_BBR -.->|"mounts"| TLSCerts

    %% Styles
    style SA_EPP fill:#4a90e2,stroke:#333,color:#fff
    style SA_BBR fill:#4a90e2,stroke:#333,color:#fff
    style Role_SA fill:#f5a623,stroke:#333
    style CR_TokenReview fill:#f5a623,stroke:#333,stroke-dasharray:5
    style RB_NS fill:#7ed321,stroke:#333
    style CRB_Metrics fill:#7ed321,stroke:#333,stroke-dasharray:5
    style Pods fill:#d5e8d4,stroke:#82b366
    style TokenReviews fill:#ffe6cc,stroke:#d79b00
    style SAR fill:#ffe6cc,stroke:#d79b00
    style MetricsNonResource fill:#ffe6cc,stroke:#d79b00
    style InferencePool fill:#dae8fc,stroke:#6c8ebf
    style InferenceObjective fill:#dae8fc,stroke:#6c8ebf
    style InferenceModelRewrite fill:#dae8fc,stroke:#6c8ebf
    style ConfigMaps fill:#dae8fc,stroke:#6c8ebf
    style Leases fill:#dae8fc,stroke:#6c8ebf
    style MetricsSecret fill:#e1d5e7,stroke:#9673a6
    style TLSCerts fill:#e1d5e7,stroke:#9673a6
