graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_EPP["{release}<br/>ServiceAccount<br/>Namespace: {release-namespace}"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_NS["{release}-sa<br/>RoleBinding<br/>Namespace: {release-namespace}"]
        CRB["{release}<br/>ClusterRoleBinding"]
    end

    subgraph Roles["Roles"]
        Role_NS["{release}-sa<br/>Role (Namespaced)"]
        CR_Metrics["EPP Metrics Auth<br/>ClusterRole (Conditional)"]
    end

    subgraph InferenceAPIResources["inference.networking.k8s.io Resources"]
        InferencePool["InferencePool<br/>inference.networking.k8s.io/v1"]
        InferenceObjective["InferenceObjective<br/>inference.networking.x-k8s.io/v1alpha2"]
        InferenceModelRewrite["InferenceModelRewrite<br/>inference.networking.x-k8s.io/v1alpha2"]
        InferencePoolImport["InferencePoolImport<br/>inference.networking.x-k8s.io/v1alpha1"]
    end

    subgraph CoreResources["Core Kubernetes Resources"]
        Pods["core<br/>Pods"]
        Services["core<br/>Services"]
        ConfigMaps["core<br/>ConfigMaps"]
        Leases["coordination.k8s.io<br/>Leases"]
        Events["core / events.k8s.io<br/>Events"]
    end

    subgraph AuthResources["Authentication & Authorization Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SubjectAccessReviews["authorization.k8s.io<br/>SubjectAccessReviews"]
        MetricsURL["/metrics<br/>(non-resource URL)"]
    end

    %% Bindings
    SA_EPP -->|"bound via"| RB_NS
    SA_EPP -->|"bound via"| CRB
    RB_NS -->|"grants"| Role_NS
    CRB -->|"grants"| CR_Metrics

    %% Namespaced Role permissions
    Role_NS -->|"get, list, watch"| InferencePool
    Role_NS -->|"get, list, watch"| InferenceObjective
    Role_NS -->|"get, list, watch"| InferenceModelRewrite
    Role_NS -->|"get, list, watch"| InferencePoolImport
    Role_NS -->|"get, list, watch"| Pods
    Role_NS -->|"get, list, watch"| Services
    Role_NS -->|"get, list, watch"| ConfigMaps
    Role_NS -->|"get, create, update"| Leases
    Role_NS -->|"create, patch"| Events

    %% ClusterRole permissions (metrics auth)
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SubjectAccessReviews
    CR_Metrics -->|"get"| MetricsURL

    %% Styling
    style SA_EPP fill:#4a90e2,stroke:#2c5f8a,color:#fff
    style RB_NS fill:#8bc4f6,stroke:#5a9cd6,color:#333
    style CRB fill:#8bc4f6,stroke:#5a9cd6,color:#333
    style Role_NS fill:#f5a623,stroke:#c07d10,color:#fff
    style CR_Metrics fill:#f5a623,stroke:#c07d10,color:#fff
    style InferencePool fill:#7ed321,stroke:#5a9e15
    style InferenceObjective fill:#7ed321,stroke:#5a9e15
    style InferenceModelRewrite fill:#7ed321,stroke:#5a9e15
    style InferencePoolImport fill:#7ed321,stroke:#5a9e15
    style Pods fill:#d5e8d4,stroke:#82b366
    style Services fill:#d5e8d4,stroke:#82b366
    style ConfigMaps fill:#d5e8d4,stroke:#82b366
    style Leases fill:#d5e8d4,stroke:#82b366
    style Events fill:#d5e8d4,stroke:#82b366
    style TokenReviews fill:#e6b8af,stroke:#cc7a6f
    style SubjectAccessReviews fill:#e6b8af,stroke:#cc7a6f
    style MetricsURL fill:#e6b8af,stroke:#cc7a6f
