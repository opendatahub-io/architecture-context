graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_MS["{release}-modelservice"]
        SA_EPP["{release}-endpoint-picker"]
        SA_Grafana["grafana-sa"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["{release}-manager-rolebinding<br/>cluster-wide"]
        CRB_Metrics["{release}-metrics-auth-rolebinding<br/>cluster-wide"]
        CRB_GrafanaView["view-grafana<br/>llm-d-observability"]
        CRB_GrafanaCMV["cluster-monitoring-view-grafana<br/>llm-d-observability"]
        CRB_GrafanaPR["grafana-prometheus-reader-binding<br/>llm-d-observability"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["{release}-manager"]
        CR_EPP["{release}-endpoint-picker"]
        CR_Admin["{release}-modelservice-admin"]
        CR_Editor["{release}-modelservice-editor"]
        CR_Viewer["{release}-modelservice-viewer"]
        CR_Metrics["{release}-metrics-auth"]
        CR_PromReader["grafana-prometheus-reader"]
    end

    subgraph Resources_Manager["Manager Resources"]
        R_ConfigMaps["configmaps"]
        R_ServiceAccounts["serviceaccounts"]
        R_Pods["pods"]
        R_Services["services"]
        R_Deployments["apps/deployments<br/>deployments/scale"]
        R_EndpointSlices["discovery.k8s.io<br/>endpointslices"]
        R_HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        R_InferenceModels["inference.networking.x-k8s.io<br/>inferencemodels"]
        R_InferencePools["inference.networking.x-k8s.io<br/>inferencepools"]
        R_ModelServices["llm-d.ai<br/>modelservices<br/>modelservices/finalizers<br/>modelservices/status"]
        R_RoleBindings["rbac.authorization.k8s.io<br/>rolebindings"]
    end

    subgraph Resources_EPP["EPP Resources"]
        R_EPP_Pools["inference.networking.x-k8s.io<br/>inferencepools"]
        R_EPP_Models["inference.networking.x-k8s.io<br/>inferencemodels"]
        R_EPP_Pods["pods"]
        R_EPP_Slices["discovery.k8s.io<br/>endpointslices"]
        R_EPP_TokenReview["authentication.k8s.io<br/>tokenreviews"]
        R_EPP_SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph Resources_Prom["Prometheus Resources"]
        R_Prom["monitoring.coreos.com<br/>prometheuses<br/>prometheuses/*"]
    end

    %% Service Account → Binding → Role
    SA_MS -->|"bound via"| CRB_Manager
    SA_MS -->|"bound via"| CRB_Metrics
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_Metrics

    SA_Grafana -->|"bound via"| CRB_GrafanaView
    SA_Grafana -->|"bound via"| CRB_GrafanaCMV
    SA_Grafana -->|"bound via"| CRB_GrafanaPR
    CRB_GrafanaPR -->|"grants"| CR_PromReader

    %% Role → Resources
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_ConfigMaps
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_ServiceAccounts
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_Pods
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_Services
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_Deployments
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_EndpointSlices
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_HTTPRoutes
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_InferenceModels
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_InferencePools
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_ModelServices
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| R_RoleBindings

    CR_EPP -->|"get, watch, list"| R_EPP_Pools
    CR_EPP -->|"get, watch, list"| R_EPP_Models
    CR_EPP -->|"get, watch, list"| R_EPP_Pods
    CR_EPP -->|"get, watch, list"| R_EPP_Slices
    CR_EPP -->|"create"| R_EPP_TokenReview
    CR_EPP -->|"create"| R_EPP_SAR

    CR_Metrics -->|"create"| R_EPP_TokenReview
    CR_Metrics -->|"create"| R_EPP_SAR

    CR_PromReader -->|"get, list, watch"| R_Prom

    %% User-facing roles (not bound by default)
    CR_Admin -.->|"full CRUD"| R_ModelServices
    CR_Editor -.->|"full CRUD"| R_ModelServices
    CR_Viewer -.->|"read-only"| R_ModelServices

