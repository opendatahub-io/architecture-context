graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["grid-operator<br/>(grid-system namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_CRD["grid-operator-crd<br/>(cluster-wide)"]
        CRB_Res["grid-operator-resources<br/>(namespace: grid-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_CRD["grid-operator-crd"]
        CR_Res["grid-operator-resources"]
    end

    subgraph CRDResources["CRD Resources (grid.praxis.fast)"]
        AGP["AgentToolProviders<br/>get, list, watch, patch"]
        GN["GridNetworks<br/>get, list, watch, patch"]
        IP["InferenceProviders<br/>get, list, watch, patch"]
        GS["GridSites<br/>get, list, watch, patch,<br/>create, update, delete"]
        StatusAll["*/status<br/>(all four CRDs)<br/>get, patch"]
    end

    subgraph CoreResources["Core Resources"]
        Secrets["Secrets<br/>get, create, patch"]
        Services["Services<br/>(provider-gateway,<br/>grid-operator-swim,<br/>grid-operator-signals)<br/>get"]
        ConfigMaps["ConfigMaps<br/>get, create, patch, update"]
    end

    subgraph EventResources["Event Resources (events.k8s.io)"]
        Events["Events<br/>create, patch"]
    end

    %% Bindings
    SA -->|bound via| CRB_CRD
    SA -->|bound via| CRB_Res

    CRB_CRD -->|grants| CR_CRD
    CRB_Res -->|grants| CR_Res

    %% CRD role permissions
    CR_CRD -->|read + patch| AGP
    CR_CRD -->|read + patch| GN
    CR_CRD -->|read + patch| IP
    CR_CRD -->|full CRUD| GS
    CR_CRD -->|status updates| StatusAll

    %% Resources role permissions
    CR_Res -->|manage| Secrets
    CR_Res -->|read| Services
    CR_Res -->|manage| ConfigMaps
    CR_Res -->|emit| Events

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB_CRD fill:#b8d4e3,stroke:#333
    style CRB_Res fill:#b8d4e3,stroke:#333
    style CR_CRD fill:#f5a623,stroke:#333
    style CR_Res fill:#f5a623,stroke:#333
    style AGP fill:#7ed321,stroke:#333
    style GN fill:#7ed321,stroke:#333
    style IP fill:#7ed321,stroke:#333
    style GS fill:#7ed321,stroke:#333
    style StatusAll fill:#7ed321,stroke:#333
    style Secrets fill:#e87d4a,stroke:#333,color:#fff
    style Services fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#e87d4a,stroke:#333,color:#fff
    style Events fill:#e8e8e8,stroke:#333
