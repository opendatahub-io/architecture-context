graph TB
    subgraph EPP["Endpoint Picker (EPP)"]
        direction TB
        ExtProc["ext-proc gRPC Server<br/>9002/TCP TLS 1.2+"]
        HealthSvc["gRPC Health Service<br/>9003/TCP"]
        MetricsSvc["Metrics Endpoint<br/>9090/TCP HTTP"]
        ZMQ["ZMQ KV-Events<br/>5557/TCP"]

        subgraph Scheduling["Scheduling Pipeline"]
            direction LR
            Filter["Filter Plugins"]
            Score["Score Plugins"]
            Pick["Pick Plugins"]
            Filter --> Score --> Pick
        end

        subgraph FlowControl["Flow Control"]
            direction LR
            Processor["Processor<br/>(Actor Model)"]
            FlowRegistry["Flow Registry<br/>(sync.Map + Atomics)"]
            EvictionQueue["Eviction Queue<br/>(Min-Heap)"]
        end

        subgraph DataLayer["Data Layer"]
            DataGraph["Data Graph<br/>(Topo Sort)"]
            Producers["Data Producers"]
        end

        ExtProc --> Scheduling
        Scheduling --> FlowControl
        DataLayer --> Scheduling
    end

    subgraph Sidecar["Disaggregation Sidecar (pd-sidecar)"]
        direction TB
        ProxyListener["HTTP Proxy<br/>8000/TCP"]

        subgraph Connectors["KV Connectors"]
            NIXLv2["NIXLv2<br/>(RDMA)"]
            SGLang["SGLang<br/>(Room Pool)"]
            Mooncake["Mooncake<br/>(Engine ID)"]
            SharedStorage["Shared Storage<br/>(Cache-First)"]
        end

        subgraph ECConnectors["Encoder Connectors"]
            ECNIXL["ec-nixl"]
            ECExample["ec-example"]
        end

        ProxyListener --> Connectors
        ProxyListener --> ECConnectors
    end

    %% External interactions
    Client[Client] -->|HTTP 8081| EnvoyProxy[Envoy Proxy]
    EnvoyProxy -->|gRPC ext-proc| ExtProc
    EnvoyProxy -->|HTTP/gRPC| ModelServer["Model Server Pods<br/>(vLLM / SGLang)"]
    EnvoyProxy -->|HTTP/HTTPS| ProxyListener

    %% CRDs
    InferencePool["InferencePool CRD<br/>(GIE)"] -.->|watched by| EPP
    InferenceObjective["InferenceObjective CRD<br/>(llm-d.ai)"] -.->|watched by| EPP
    InferenceModelRewrite["InferenceModelRewrite CRD<br/>(llm-d.ai)"] -.->|watched by| EPP

    %% Sidecar targets
    Sidecar -->|HTTP 8001| LocalDecoder["Local vLLM Decoder"]
    Sidecar -->|HTTP 8000| RemotePrefiller["Remote Prefill Workers"]
    Sidecar -->|HTTP 8000| RemoteEncoder["Remote Encoder Workers"]

    %% Metrics scraping
    EPP -->|HTTP /metrics| ModelServer

    %% Styling
    style EPP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Sidecar fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style Scheduling fill:#e8f5e9,stroke:#2e7d32
    style FlowControl fill:#fff3e0,stroke:#ef6c00
    style DataLayer fill:#f3e5f5,stroke:#7b1fa2
    style Connectors fill:#fff8e1,stroke:#f9a825
    style ECConnectors fill:#e0f2f1,stroke:#00695c
    style EnvoyProxy fill:#e8e8e8,stroke:#333
    style InferencePool fill:#f5a623,stroke:#333
    style InferenceObjective fill:#f5a623,stroke:#333
    style InferenceModelRewrite fill:#f5a623,stroke:#333
    style ModelServer fill:#7ed321,stroke:#333
    style LocalDecoder fill:#7ed321,stroke:#333
    style RemotePrefiller fill:#7ed321,stroke:#333
    style RemoteEncoder fill:#7ed321,stroke:#333
