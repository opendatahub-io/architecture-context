graph TB
    subgraph LLMDRouter["llm-d Router (Inference Scheduler)"]
        direction TB

        subgraph EPP["Endpoint Picker (EPP)"]
            ExtProc["ext-proc gRPC Server<br/>9002/TCP TLS"]
            HealthGRPC["gRPC Health Check<br/>9003/TCP"]
            Metrics["Prometheus Metrics<br/>9090/TCP HTTP"]
            ZMQ["ZMQ KV-Events SUB<br/>5557/TCP"]

            subgraph PluginFramework["Plugin Framework"]
                RequestHandling["Request Handling<br/>(OpenAI, Anthropic, VertexAI,<br/>vLLM HTTP/gRPC, Passthrough)"]
                RequestControl["Request Control<br/>(Admission, Data Production,<br/>Pre-Request Hooks)"]
                Scheduling["Scheduling<br/>(Filters, Scorers, Pickers)"]
                FlowControl["Flow Control<br/>(Queuing, Eviction, Fairness)"]
            end

            RequestHandling --> RequestControl
            RequestControl --> Scheduling
            Scheduling --> FlowControl
        end

        subgraph Sidecar["Disaggregation Sidecar (pd-sidecar)"]
            SidecarProxy["HTTP/HTTPS Proxy<br/>8000/TCP"]
            SidecarHealth["Health Check<br/>/health"]

            subgraph Connectors["KV Transfer Connectors"]
                NIXLV2["NIXL V2"]
                Mooncake["Mooncake"]
                SGLang["SGLang"]
                SharedStorage["Shared Storage"]
            end
        end
    end

    %% CRDs
    InferencePoolCR["InferencePool CR<br/>(GIE)"]
    InferenceObjCR["InferenceObjective CR<br/>(llm-d.ai/v1alpha2)"]
    InferenceRewriteCR["InferenceModelRewrite CR<br/>(llm-d.ai/v1alpha2)"]

    %% External components
    Client["External Client"]
    EnvoyProxy["Envoy Proxy<br/>(Gateway)"]
    ModelServers["Model Server Pods<br/>(vLLM/SGLang/Triton)"]
    PrefillWorkers["Prefill Workers"]
    EncodeWorkers["Encode Workers"]
    DecodeWorker["Local Decode Worker<br/>8001/TCP"]
    K8sAPI["Kubernetes API<br/>443/TCP"]

    %% Client flow
    Client -->|"HTTP/80"| EnvoyProxy
    EnvoyProxy -->|"ext-proc gRPC/9002<br/>TLS"| ExtProc
    ExtProc -->|"routing decision"| EnvoyProxy
    EnvoyProxy -->|"HTTP/8000"| ModelServers

    %% CRD watches
    InferencePoolCR -->|"watched by"| EPP
    InferenceObjCR -->|"watched by"| EPP
    InferenceRewriteCR -->|"watched by"| EPP

    %% EPP dependencies
    EPP -->|"HTTPS/443<br/>SA token"| K8sAPI
    EPP -->|"HTTP scraping"| ModelServers
    ZMQ -->|"ZMQ SUB/5557"| ModelServers

    %% Sidecar flows
    EnvoyProxy -->|"HTTP(S)/8000"| SidecarProxy
    SidecarProxy -->|"HTTP(S)"| PrefillWorkers
    SidecarProxy -->|"HTTP(S)"| EncodeWorkers
    SidecarProxy -->|"HTTP(S)/8001"| DecodeWorker

    %% Styles
    style EPP fill:#4a90e2,stroke:#333,color:#fff
    style Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style PluginFramework fill:#5ba3f5,stroke:#333,color:#fff
    style Connectors fill:#5ba3f5,stroke:#333,color:#fff
    style LLMDRouter fill:#e8f0fe,stroke:#4a90e2,stroke-width:3px
    style InferencePoolCR fill:#f5a623,stroke:#333,color:#fff
    style InferenceObjCR fill:#f5a623,stroke:#333,color:#fff
    style InferenceRewriteCR fill:#f5a623,stroke:#333,color:#fff
    style EnvoyProxy fill:#e8e8e8,stroke:#333
    style ModelServers fill:#7ed321,stroke:#333,color:#fff
    style PrefillWorkers fill:#7ed321,stroke:#333,color:#fff
    style EncodeWorkers fill:#7ed321,stroke:#333,color:#fff
    style DecodeWorker fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
