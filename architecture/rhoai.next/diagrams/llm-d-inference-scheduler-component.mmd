graph TB
    subgraph EPP["Endpoint Picker (EPP)"]
        direction TB
        ExtProc["ExternalProcessor gRPC Server<br/>9002/TCP"]
        HealthSvc["Health gRPC Server<br/>9003/TCP"]
        Metrics["Prometheus Metrics<br/>9090/TCP HTTP"]
        PluginFramework["Plugin Framework"]

        subgraph Plugins["Pluggable Pipeline"]
            Filters["Filters"]
            Scorers["Scorers"]
            DataLayer["Data-Layer Sources"]
            FlowControl["Flow Control"]
            Parsers["Protocol Parsers"]
        end

        subgraph Controllers["Controllers"]
            PoolCtrl["InferencePool Controller"]
            ObjCtrl["InferenceObjective Controller"]
            RewriteCtrl["InferenceModelRewrite Controller"]
            PodCtrl["Pod Controller"]
        end

        ExtProc --> PluginFramework
        PluginFramework --> Filters
        PluginFramework --> Scorers
        PluginFramework --> DataLayer
        PluginFramework --> FlowControl
        PluginFramework --> Parsers
        Controllers --> DataLayer
    end

    subgraph Sidecar["Disaggregation Sidecar (pd-sidecar)"]
        direction TB
        ProxyServer["HTTP Reverse Proxy<br/>8000/TCP"]
        KVConnector["KV Connector<br/>(NIXL v2 / shared-storage /<br/>SGLang / Mooncake)"]
        ECConnector["Encoder Connector<br/>(NIXL / example)"]
        ProxyServer --> KVConnector
        ProxyServer --> ECConnector
    end

    %% CRDs
    EPCConfig["EndpointPickerConfig CR<br/>llm-d.ai/v1alpha1"]
    ObjCR["InferenceObjective CR<br/>llm-d.ai/v1alpha2"]
    RewriteCR["InferenceModelRewrite CR<br/>llm-d.ai/v1alpha2"]
    PoolCR["InferencePool CR<br/>(GIE)"]

    EPCConfig -->|configures| PluginFramework
    ObjCR -->|watched by| ObjCtrl
    RewriteCR -->|watched by| RewriteCtrl
    PoolCR -->|watched by| PoolCtrl

    %% External interactions
    Client["Client"] -->|HTTPS/443| EnvoyGW["Envoy Gateway"]
    EnvoyGW -->|gRPC ext-proc<br/>9002/TCP| ExtProc
    EnvoyGW -->|HTTP| ModelPod["Model-Serving Pod"]

    EnvoyGW -->|HTTP/8000| ProxyServer
    ProxyServer -->|HTTP/8001| LocalVLLM["Local vLLM Decoder"]
    ProxyServer -->|HTTP/HTTPS| PrefillWorker["Remote Prefill Workers"]
    ProxyServer -->|HTTP/HTTPS| EncodeWorker["Remote Encode Workers"]

    PodCtrl -->|watches| ModelPod
    DataLayer -->|scrapes metrics| ModelPod
    Controllers -->|watches| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Styling
    style EPP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Sidecar fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style ExtProc fill:#4a90e2,color:#fff
    style HealthSvc fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style ProxyServer fill:#e57373,color:#fff
    style EPCConfig fill:#f5a623
    style ObjCR fill:#f5a623
    style RewriteCR fill:#f5a623
    style PoolCR fill:#f5a623
    style EnvoyGW fill:#999,color:#fff
    style K8sAPI fill:#999,color:#fff
    style ModelPod fill:#7ed321
    style LocalVLLM fill:#7ed321
    style PrefillWorker fill:#7ed321
    style EncodeWorker fill:#7ed321
    style Client fill:#f9f9f9,stroke:#999
