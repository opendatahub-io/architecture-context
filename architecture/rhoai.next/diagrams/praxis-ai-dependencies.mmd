graph LR
    PraxisAI["Praxis AI<br/>(AI Gateway Proxy)"]

    %% Core Runtime Dependency
    PraxisAI -->|"in-process runtime"| PraxisCore["Praxis Core 0.7.3<br/>(Pingora-based Proxy)"]
    PraxisCore -->|"HTTP engine"| Pingora["Pingora 0.10.0<br/>(Connection Pooling,<br/>H2 Backpressure)"]

    %% TLS and Crypto
    PraxisAI -->|"TLS protocol"| Rustls["rustls 0.23.45<br/>(OpenSSL crypto provider)"]
    PraxisAI -->|"SHA-256, HMAC, TLS crypto"| OpenSSL["openssl 0.10.81<br/>(FFI to system OpenSSL)"]

    %% Async Runtime
    PraxisAI -->|"async runtime"| Tokio["tokio 1.53.1"]

    %% Backend Services
    PraxisAI -->|"inference upstream"| vLLM["vLLM / Inference<br/>Backends"]
    PraxisAI -->|"response store"| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    PraxisAI -->|"local store"| SQLite["SQLite<br/>(embedded)"]

    %% Optional Services
    PraxisAI -.->|"content safety"| NeMo["NeMo Guardrails"]
    PraxisAI -.->|"tool dispatch"| MCPServers["MCP Servers<br/>(rmcp 3.4.0)"]
    PraxisAI -.->|"rate limiting"| Redis["Redis / Valkey<br/>(experimental)"]
    PraxisAI -.->|"ext_proc gRPC"| LlmD["llm-d ext_proc<br/>(tonic 0.14.6)"]
    PraxisAI -.->|"metering"| Metering["External Metering<br/>Service"]

    %% Cloud Identity
    PraxisAI -.->|"AWS SigV4"| AWS["AWS STS<br/>443/TCP"]
    PraxisAI -.->|"Azure AD tokens"| Azure["Azure AD<br/>443/TCP"]
    PraxisAI -.->|"GCP ADC"| GCP["GCP<br/>443/TCP"]

    %% Key Libraries
    PraxisAI -->|"SQL driver"| SQLx["sqlx 0.9.0<br/>(feature-gated)"]
    PraxisAI -->|"token counting"| Tiktoken["tiktoken-rs 0.12.0"]
    PraxisAI -->|"serialization"| Serde["serde / serde_json /<br/>serde_yaml"]
    PraxisAI -->|"allocator"| Jemalloc["tikv-jemallocator 0.7.0"]
    PraxisAI -->|"secret handling"| Secrecy["secrecy 0.10.3 /<br/>zeroize 1.9.0"]
    PraxisAI -->|"observability"| Tracing["tracing 0.1.44 /<br/>metrics 0.24.6"]

    %% Integration consumers (who integrates with Praxis AI)
    A2A["A2A Agents"] -.->|"agent tasks"| PraxisAI

    style PraxisAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
