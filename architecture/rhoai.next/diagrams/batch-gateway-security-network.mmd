graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Optional — Gateway API)"]
        Gateway["Gateway API HTTPRoute<br/>Routes: /v1/batches, /v1/files<br/>Parent: llm-d-inference-gateway<br/>Disabled by default"]
    end

    subgraph AppTier["APPLICATION TIER (Batch Gateway)"]
        direction TB

        subgraph NS_App["Namespace: {release-namespace}"]
            Apiserver["batch-gateway-apiserver<br/>Ports: 8000/TCP (API), 8081/TCP (obs)<br/>Service: ClusterIP<br/>TLS 1.2+ (optional)<br/>FIPS: strictfipsruntime + UBI 9<br/>Auth: Tenant header middleware"]

            Processor["batch-gateway-processor<br/>Port: 9090/TCP (obs only)<br/>No K8s Service (headless)<br/>Workers: 20, Concurrency: 100 global<br/>AIMD adaptive per-endpoint<br/>FIPS: strictfipsruntime + UBI 9"]

            GC_Pod["batch-gateway-gc<br/>Port: 9091/TCP (obs only)<br/>No K8s Service (singleton)<br/>GC interval: 30m, Reconcile: 60m<br/>FIPS: strictfipsruntime + UBI 9"]
        end
    end

    subgraph DataTier["DATA TIER"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>Encryption: URL-dependent<br/>Auth: username/password in URL"]
        Redis["Redis / Valkey<br/>6379/TCP<br/>TLS 1.2+ (optional)<br/>Auth: Connection URL"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Store<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM credentials"]
        InferenceGW["LLM Inference Gateway<br/>(vLLM / GIE/EPP)<br/>HTTP/HTTPS (configurable)<br/>TLS 1.2+ (optional, mTLS)<br/>Auth: API key + inference headers"]
        OTLP["OTLP Collector<br/>4317/TCP gRPC<br/>Plaintext or TLS"]
        Prometheus["Prometheus<br/>HTTP scrape<br/>No encryption"]
    end

    %% External → Ingress
    Client -->|"HTTP(S)/8000<br/>TLS 1.2+ (optional)<br/>X-MaaS-Username header<br/>No API key validation"| Gateway

    %% Ingress → App
    Gateway -->|"HTTP(S)/8000<br/>Pass-through tenant header"| Apiserver

    %% Direct access (without Gateway)
    Client -.->|"Direct (internal)<br/>HTTP(S)/8000"| Apiserver

    %% App → Data Tier
    Apiserver -->|"TCP/5432<br/>URL-dependent encryption<br/>Connection URL auth"| PostgreSQL
    Apiserver -->|"TCP/6379<br/>TLS optional<br/>Connection URL auth"| Redis
    Processor -->|"TCP/5432<br/>URL-dependent encryption"| PostgreSQL
    Processor -->|"TCP/6379<br/>TLS optional"| Redis
    GC_Pod -->|"TCP/5432<br/>URL-dependent encryption"| PostgreSQL
    GC_Pod -->|"TCP/6379<br/>TLS optional"| Redis

    %% App → External Services
    Apiserver -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Processor -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Processor -->|"HTTP(S)/configurable<br/>TLS 1.2+ (mTLS supported)<br/>API key + x-gateway-inference-objective"| InferenceGW
    GC_Pod -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3

    %% Observability
    Apiserver -.->|"gRPC/4317<br/>OTLP traces"| OTLP
    Processor -.->|"gRPC/4317<br/>OTLP traces"| OTLP
    Prometheus -.->|"HTTP/8081 scrape"| Apiserver
    Prometheus -.->|"HTTP/9090 scrape"| Processor
    Prometheus -.->|"HTTP/9091 scrape"| GC_Pod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef apptier fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datatier fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class Apiserver,Processor,GC_Pod apptier
    class PostgreSQL,Redis datatier
    class S3,InferenceGW,OTLP,Prometheus externalservice
