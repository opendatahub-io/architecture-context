graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Auth Enforcement)"]
        Gateway["Upstream Gateway<br/>(Kuadrant/Authorino)<br/>Auth: API Key / SA Token / OpenShift Token<br/>Injects X-MaaS-Username"]
    end

    subgraph Internal["INTERNAL (Cluster Network)"]
        direction TB

        subgraph NS["Namespace: batch-gateway"]
            APIServer["API Server (Deployment)<br/>Port: 8000/TCP (API)<br/>Port: 8081/TCP (observability)<br/>SA: batch-gateway-apiserver<br/>Optional TLS 1.2+<br/>seccomp: RuntimeDefault<br/>readOnlyRootFilesystem"]
            Processor["Processor (StatefulSet)<br/>Port: 9090/TCP (observability)<br/>SA: batch-gateway-processor<br/>seccomp: RuntimeDefault<br/>readOnlyRootFilesystem"]
            GCPod["GC (Deployment, 1 replica)<br/>Port: 9091/TCP (observability)<br/>SA: batch-gateway-gc<br/>Role: gc-pod-watcher<br/>seccomp: RuntimeDefault<br/>readOnlyRootFilesystem"]
        end
    end

    subgraph DataLayer["DATA LAYER"]
        PostgreSQL["PostgreSQL<br/>Protocol: TCP<br/>Auth: Connection URL from Secret<br/>Encryption: Configured by runtime"]
        Redis["Redis/Valkey<br/>Protocol: TCP<br/>Auth: Connection URL from Secret<br/>Encryption: Configured by runtime"]
        S3["S3-Compatible Storage<br/>Protocol: HTTP/HTTPS<br/>Auth: AWS Credentials from Secret<br/>Encryption: Configured by runtime"]
    end

    subgraph InferenceLayer["INFERENCE LAYER"]
        LLMd["llm-d Inference Gateway<br/>Protocol: HTTP/HTTPS<br/>Encryption: Optional TLS 1.2+ / mTLS<br/>Auth: Optional API Key"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>Port: 6443/TCP<br/>Protocol: HTTPS<br/>Encryption: TLS 1.2+<br/>Auth: ServiceAccount Token"]
        OTel["OpenTelemetry Collector<br/>Protocol: OTLP/gRPC<br/>Auth: None"]
    end

    %% Flows
    Client -->|"HTTPS<br/>Auth: API Key / Token"| Gateway
    Gateway -->|"HTTP/HTTPS 8000/TCP<br/>X-MaaS-Username header<br/>Optional TLS 1.2+"| APIServer

    APIServer -->|"TCP<br/>Connection URL"| PostgreSQL
    APIServer -->|"HTTP/HTTPS<br/>AWS Credentials"| S3
    APIServer -->|"OTLP/gRPC"| OTel

    Processor -->|"TCP<br/>Connection URL"| Redis
    Processor -->|"TCP<br/>Connection URL"| PostgreSQL
    Processor -->|"HTTP/HTTPS<br/>AWS Credentials"| S3
    Processor -->|"HTTP/HTTPS<br/>Optional TLS / mTLS<br/>Optional API Key"| LLMd
    Processor -->|"OTLP/gRPC"| OTel

    GCPod -->|"TCP<br/>Connection URL"| PostgreSQL
    GCPod -->|"TCP<br/>Connection URL"| Redis
    GCPod -->|"HTTP/HTTPS<br/>AWS Credentials"| S3
    GCPod -->|"HTTPS 6443/TCP<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datalayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class APIServer,Processor,GCPod internal
    class PostgreSQL,Redis,S3 datalayer
    class LLMd inference
    class K8sAPI,OTel platform
