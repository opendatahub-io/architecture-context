graph TB
    subgraph SimCore["llm-d-inference-sim"]
        direction TB

        subgraph Communication["Communication Layer"]
            CMux["cmux Multiplexer<br/>8000/TCP"]
            HTTPServer["fasthttp Server<br/>fasthttprouter"]
            GRPCServer["gRPC Server"]
            TLS["TLS Handler<br/>Optional TLS 1.2+<br/>Hot-reload / Self-signed"]
        end

        subgraph Engines["Engine Backends"]
            EngineRegistry["Engine Registry"]
            VLLMEngine["vLLM Engine<br/>HTTP + gRPC + KV Events"]
            SGLangEngine["SGLang Engine<br/>HTTP + KV Events"]
        end

        subgraph SimulatorCore["Simulator Core"]
            WorkerQueue["Worker Queue"]
            LatencySim["Latency Simulation<br/>TTFT / ITL / Jitter / Load Scaling"]
            ResponseGen["Response Generator<br/>Echo / Random / Dataset"]
        end

        subgraph KVCache["KV Cache Simulation"]
            BlockCache["Block Cache"]
            KVEventSender["KV Event Sender<br/>Batching + Encoding"]
            ZMQPublisher["ZMQ Publisher<br/>PUB Socket"]
        end

        subgraph APIs["API Surface"]
            OpenAIAPI["/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/responses<br/>/v1/messages"]
            ModelsAPI["/v1/models"]
            RenderAPI["/v1/.../render<br/>/v1/.../derender"]
            LoRAAPI["/v1/load_lora_adapter<br/>/v1/unload_lora_adapter"]
            LifecycleAPI["/sleep /wake_up<br/>/is_sleeping /query"]
            AdminAPI["/admin/config<br/>/metrics /health"]
            VLLMgRPC["VllmEngine gRPC<br/>Generate / Embed<br/>HealthCheck / Abort"]
        end
    end

    Client[External Client] -->|HTTP/gRPC<br/>8000/TCP| CMux
    CMux --> HTTPServer
    CMux --> GRPCServer
    TLS -.->|Optional| CMux

    HTTPServer --> OpenAIAPI
    HTTPServer --> ModelsAPI
    HTTPServer --> RenderAPI
    HTTPServer --> LoRAAPI
    HTTPServer --> LifecycleAPI
    HTTPServer --> AdminAPI
    GRPCServer --> VLLMgRPC

    EngineRegistry -->|selects| VLLMEngine
    EngineRegistry -->|selects| SGLangEngine

    OpenAIAPI --> WorkerQueue
    VLLMgRPC --> WorkerQueue
    WorkerQueue --> LatencySim
    LatencySim --> ResponseGen

    BlockCache --> KVEventSender
    KVEventSender --> ZMQPublisher

    ZMQPublisher -->|ZMQ PUB/SUB<br/>5557/TCP| ZMQSub[ZMQ Subscriber]
    RenderAPI -->|HTTP 8082/TCP| RenderSidecar[vLLM Render Sidecar]
    Prometheus[Prometheus] -->|scrape /metrics<br/>8000/TCP| AdminAPI

    subgraph Tools["Companion Tools"]
        DatasetTool["dataset-tool<br/>Go CLI"]
        ZMQListener["zmq-listener<br/>Python Service"]
    end

    DatasetTool -->|creates| SQLiteDB[(SQLite Dataset)]
    SQLiteDB -.->|read-only| ResponseGen
    ZMQListener -->|subscribes| ZMQPublisher

    style SimCore fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Communication fill:#dbeafe,stroke:#3b82f6
    style Engines fill:#dbeafe,stroke:#3b82f6
    style SimulatorCore fill:#dbeafe,stroke:#3b82f6
    style KVCache fill:#dbeafe,stroke:#3b82f6
    style APIs fill:#dbeafe,stroke:#3b82f6
    style Tools fill:#f0fdf4,stroke:#22c55e
    style Client fill:#f9f9f9,stroke:#999
    style ZMQSub fill:#f9f9f9,stroke:#999
    style RenderSidecar fill:#fff7ed,stroke:#f97316
    style Prometheus fill:#f9f9f9,stroke:#999
    style SQLiteDB fill:#fef3c7,stroke:#d97706
