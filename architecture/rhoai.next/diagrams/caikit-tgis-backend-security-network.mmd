graph TB
    subgraph HostPod["HOSTING POD (Caikit Serving Runtime)"]
        direction TB

        subgraph Library["caikit-tgis-backend (in-process library)"]
            Backend["TGISBackend<br/>(BackendBase)"]
            Connection["TGISConnection<br/>(gRPC channel + TLS)"]
            Subprocess["ManagedTGISSubprocess<br/>(auto-recovery)"]
            LB["GRPCLoadBalancerProxy<br/>(DNS polling)"]

            Backend --> Connection
            Backend --> Subprocess
            Connection --> LB
        end

        SharedFS["Shared Filesystem<br/>(prompt_dir)<br/>Local I/O<br/>No access control"]
        Backend -->|"prompt artifacts<br/>filesystem I/O"| SharedFS
    end

    subgraph RemoteServices["REMOTE SERVICES"]
        TGISRemote["TGIS Server (Remote)<br/>configurable port<br/>TLS 1.2+ / mTLS<br/>CA cert + client cert"]
    end

    subgraph LocalServices["LOCAL SERVICES (same pod)"]
        TGISLocal["TGIS Subprocess<br/>50055/TCP gRPC plaintext<br/>3000/TCP HTTP plaintext<br/>No auth"]
    end

    subgraph Infrastructure["INFRASTRUCTURE"]
        DNS["DNS Resolver<br/>53/UDP<br/>plaintext<br/>No auth"]
    end

    %% Remote gRPC connection
    Connection -->|"gRPC / configurable port<br/>TLS 1.2+ / mTLS<br/>CA cert + client cert/key<br/>Generate, GenerateStream,<br/>Tokenize, ModelInfo"| TGISRemote

    %% Local connections
    Subprocess -->|"gRPC / 50055/TCP<br/>plaintext<br/>No auth"| TGISLocal
    Subprocess -->|"HTTP / 3000/TCP<br/>plaintext<br/>Health check"| TGISLocal

    %% DNS lookup
    LB -->|"DNS / 53/UDP<br/>plaintext<br/>Endpoint discovery"| DNS

    %% Styling
    classDef hostpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef remote fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef local fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef infra fill:#f9f9f9,stroke:#999,stroke-width:2px

    class Backend,Connection,Subprocess,LB library
    class SharedFS hostpod
    class TGISRemote remote
    class TGISLocal local
    class DNS infra
