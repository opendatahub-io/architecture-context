graph TB
    subgraph PodBoundary["POD BOUNDARY (caikit-tgis-serving container)"]
        direction TB

        subgraph Library["caikit-tgis-backend (Python Library)"]
            direction TB
            Backend["TGISBackend<br/>Backend Plugin"]
            Connection["TGISConnection<br/>gRPC + TLS/mTLS"]
            LB["GRPCLoadBalancerProxy<br/>DNS polling + round_robin"]
            SubprocessMgr["ManagedTGISSubprocess<br/>Process Manager"]
            HealthMon["Health Monitor<br/>Thread"]
            AutoRecovery["AutoRecoveringGenerationServiceStub<br/>Error interceptor"]
        end

        subgraph LocalProcess["Local TGIS Subprocess (local mode only)"]
            TGISLocal["text-generation-launcher<br/>gRPC: 50055/TCP<br/>HTTP: 3000/TCP"]
        end

        subgraph CertFiles["Mounted TLS Files"]
            CACert["ca_cert_file<br/><i>TLS CA certificate</i>"]
            ClientCert["client_cert_file<br/><i>TLS client certificate</i>"]
            ClientKey["client_key_file<br/><i>TLS private key</i>"]
        end

        subgraph PromptStore["Filesystem"]
            PromptDir["prompt_dir<br/><i>Prompt tuning vectors</i>"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        TGISRemote["Remote TGIS Server<br/>configurable/TCP<br/>gRPC/HTTP2"]
        DNSResolver["DNS Resolver<br/>53/UDP"]
    end

    %% Remote mode flows
    LB -->|"gRPC/HTTP2<br/>configurable/TCP<br/>TLS 1.2+ / mTLS<br/>grpc.ssl_channel_credentials<br/>Generate, GenerateStream,<br/>Tokenize, ModelInfo"| TGISRemote
    LB -->|"DNS lookup<br/>53/UDP<br/>No encryption<br/>socket.getaddrinfo"| DNSResolver

    %% Local mode flows
    SubprocessMgr -->|"subprocess.Popen"| TGISLocal
    HealthMon -->|"HTTP GET /health<br/>3000/TCP<br/>plaintext<br/>No auth"| TGISLocal
    AutoRecovery -->|"gRPC<br/>50055/TCP<br/>plaintext<br/>insecure_channel"| TGISLocal

    %% Internal library flows
    Backend --> Connection
    Backend --> SubprocessMgr
    Connection --> LB
    SubprocessMgr --> HealthMon
    SubprocessMgr --> AutoRecovery

    %% Certificate loading
    Connection -.->|"file read<br/>(at connect time)"| CACert
    Connection -.->|"file read<br/>(at connect time)"| ClientCert
    Connection -.->|"file read<br/>(at connect time)"| ClientKey

    %% Prompt artifacts
    Connection -.->|"shutil.copyfile"| PromptDir

    %% Styling
    classDef library fill:#4a90e2,stroke:#333,color:#fff
    classDef localProcess fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef certs fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef filesystem fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Backend,Connection,LB,SubprocessMgr,HealthMon,AutoRecovery library
    class TGISLocal localProcess
    class TGISRemote,DNSResolver external
    class CACert,ClientCert,ClientKey certs
    class PromptDir filesystem
