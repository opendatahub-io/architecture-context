graph LR
    ODHObs["odh-observability<br/>Operator"]

    %% External Operator Dependencies (CRD providers)
    ODHObs -->|"MonitoringStack<br/>ThanosQuerier<br/>ServiceMonitor<br/>PrometheusRule"| COO["Cluster Observability<br/>Operator"]
    ODHObs -->|"TempoMonolithic<br/>TempoStack"| TempoOp["Tempo Operator"]
    ODHObs -->|"OpenTelemetryCollector<br/>Instrumentation"| OTelOp["OpenTelemetry<br/>Operator"]
    ODHObs -->|"Perses<br/>PersesDatasource<br/>PersesDashboard"| PersesOp["Perses Operator"]
    ODHObs -->|"LokiStack"| LokiOp["Loki Operator"]
    ODHObs -->|"ClusterLogForwarder"| LoggingOp["Cluster Logging<br/>Operator"]

    %% Infrastructure Dependencies
    ODHObs -->|"webhook TLS"| CertManager["cert-manager"]
    ODHObs -->|"watches, SSA apply<br/>CRD discovery"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    ODHObs -->|"TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>config"]

    %% Go Library Dependencies
    ODHObs -->|"SSA, templates<br/>GC, conditions"| PlatformUtils["odh-platform-utilities<br/>v0.4.0"]
    ODHObs -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    ODHObs -->|"TLS profile<br/>resolution"| LibraryGo["openshift/library-go"]
    ODHObs -->|"OTel config<br/>generation"| GoJQ["gojq v0.12.19"]

    %% Managed operand dependencies
    ODHObs -.->|"manages"| ClusterProxy["Cluster Proxy<br/>(kube-rbac-proxy)"]
    ODHObs -.->|"manages"| NSProxy["Namespace Proxy<br/>(kube-rbac-proxy +<br/>prom-label-proxy)"]
    ODHObs -.->|"manages"| Korrel8r["Korrel8r"]

