graph TB
    subgraph CallerEnv["CALLER ENVIRONMENT (User Process / Kubeflow Pod)"]
        direction TB

        THub["Training Hub Library<br/>Python package<br/>No listening ports"]

        subgraph ART_Boundary["SUBPROCESS BOUNDARY (ART Backend)"]
            direction TB
            SpawnedProc["Spawned Process<br/>mp.spawn isolation<br/>Disk-based IPC"]
            EphemeralVLLM["Ephemeral vLLM Server<br/>localhost only<br/>HTTP, No TLS, No Auth"]
            SpawnedProc -->|"HTTP/localhost<br/>No encryption<br/>No auth"| EphemeralVLLM
        end

        subgraph Verl_Boundary["SUBPROCESS BOUNDARY (verl Backend)"]
            direction TB
            Torchrun["torchrun Subprocess<br/>Hydra CLI overrides"]
            FSDPWorkers["FSDP Workers<br/>NCCL/GPU Direct"]
            ColocatedVLLM["Co-located vLLM<br/>In-process"]
            Torchrun -->|"NCCL<br/>GPU Direct"| FSDPWorkers
            FSDPWorkers -->|"In-process<br/>No network"| ColocatedVLLM
        end

        THub -->|"mp.spawn<br/>os._exit() cleanup"| SpawnedProc
        THub -->|"subprocess.Popen"| Torchrun
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress Only)"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        LLMAPI["OpenAI-compatible API<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        MLflowSvc["MLflow Tracking<br/>Configurable port<br/>HTTP/HTTPS"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS<br/>TLS 1.2+"]
        PyPI["PyPI<br/>pypi.org<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph TrustBoundaries["TRUST BOUNDARIES"]
        YAMLConfig["YAML Config Files<br/>importlib.import_module()<br/>Can trigger arbitrary code"]
        LiteLLM["litellm dependency<br/>v1.82.7-1.82.8 excluded<br/>TeamPCP supply chain attack"]
    end

    %% Egress flows
    THub -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token (optional)"| HFHub
    THub -->|"HTTPS/443<br/>TLS 1.2+<br/>OPENAI_API_KEY"| LLMAPI
    THub -.->|"HTTP/HTTPS<br/>Configurable auth"| MLflowSvc
    THub -.->|"HTTPS/443<br/>TLS 1.2+<br/>WANDB_API_KEY"| WandB
    THub -.->|"HTTPS/443<br/>TLS 1.2+<br/>API token (CI)"| PyPI

    %% Trust boundary connections
    YAMLConfig -.->|"_resolve_dotted_path()"| THub
    LiteLLM -.->|"version exclusion"| LLMAPI

    %% Styling
    classDef caller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef subprocess fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef trust fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class THub caller
    class SpawnedProc,EphemeralVLLM,Torchrun,FSDPWorkers,ColocatedVLLM subprocess
    class HFHub,LLMAPI,MLflowSvc,WandB,PyPI external
    class YAMLConfig,LiteLLM trust
