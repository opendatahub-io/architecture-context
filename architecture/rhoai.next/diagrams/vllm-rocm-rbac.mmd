graph TD
    subgraph Note["RBAC for vllm-rocm"]
        direction TB
        Info["No RBAC resources defined in this repository.<br/>All RBAC is delegated to the platform."]
    end

    subgraph PlatformRBAC["Platform-Managed RBAC (not in this repo)"]
        direction TB

        subgraph KServeManaged["Managed by KServe"]
            SA["Service Account<br/>(per InferenceService)"]
            KServeSA["kserve-controller-manager<br/>Service Account"]
        end

        subgraph AuthEnforcement["Auth Enforcement Layer"]
            KubeRBACProxy["kube-rbac-proxy Sidecar<br/>(RHOAI 3.x)"]
            SAR["SubjectAccessReview<br/>Validates Bearer Tokens"]
        end

        subgraph ProtectedEndpoints["Protected Endpoints"]
            HTTP["HTTP API<br/>8000/TCP<br/>OpenAI-Compatible"]
            GRPC["gRPC API<br/>8033/TCP<br/>TGIS Protocol"]
        end
    end

    %% Flow
    SA -->|"bound to inference pod"| HTTP
    SA -->|"bound to inference pod"| GRPC
    KServeSA -->|"creates/manages"| SA
    KubeRBACProxy -->|"validates via"| SAR
    SAR -->|"authorizes access to"| HTTP
    SAR -->|"authorizes access to"| GRPC

    %% Styling
    style Info fill:#fff3cd,stroke:#ffc107,stroke-width:2px,color:#856404
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style KServeSA fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style SAR fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style HTTP fill:#7ed321,stroke:#333,color:#fff
    style GRPC fill:#7ed321,stroke:#333,color:#fff
