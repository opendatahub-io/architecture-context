graph TD
    subgraph "vLLM ROCm RBAC Model"
        direction TB
        Note["No RBAC definitions in this repository.<br/>Security is fully delegated to the platform."]
    end

    subgraph "Platform-Managed Security"
        SA["KServe-Managed<br/>ServiceAccount"]
        KRBAC["kube-rbac-proxy<br/>(Sidecar)"]
        IstioAuth["Istio mTLS<br/>(PeerAuthentication STRICT)"]
        GatewayAuth["Gateway API<br/>(AuthorizationPolicy)"]
    end

    subgraph "Pod Security"
        NonRoot["Non-Root User<br/>UID 2000"]
        NoPriv["No Privileged<br/>Capabilities"]
        GPUAccess["AMD ROCm GPU<br/>Device Plugin Access"]
    end

    subgraph "Authentication Mechanisms"
        APIKey["VLLM_API_KEY<br/>(Optional Bearer Token)"]
        MTLS["mTLS Certificates<br/>(Istio-managed)"]
        StorageCreds["Storage Credentials<br/>(InferenceService config)"]
    end

    SA -->|"runs pod as"| NonRoot
    KRBAC -->|"enforces auth on"| APIKey
    IstioAuth -->|"enforces"| MTLS
    GatewayAuth -->|"external access<br/>control"| KRBAC

