graph TD
    subgraph ContainerSecurity["Container Security Profile"]
        direction TB
        Container["vllm-rocm Container<br/>UID: 2000 (non-root)"]
        BaseImage["Base Image: UBI9<br/>registry.redhat.io/rhaiis/vllm-rocm-rhel9:3.2.1"]
    end

    subgraph NoDirectRBAC["No Direct RBAC"]
        direction TB
        Note1["This container does not interact<br/>with the Kubernetes API directly"]
        Note2["No ClusterRoles, Roles,<br/>or RoleBindings defined"]
    end

    subgraph PlatformEnforced["Platform-Enforced Access Control"]
        direction TB

        subgraph HTTPAuth["HTTP Endpoint Auth (/v1/*)"]
            KubeRBAC["kube-rbac-proxy sidecar<br/>8443/TCP HTTPS"]
            KubeRBAC -->|validates| BearerToken["Bearer Token / JWT"]
            KubeRBAC -->|checks| K8sSubjectReview["SubjectAccessReview<br/>(Kubernetes RBAC)"]
        end

        subgraph GRPCAuth["gRPC Endpoint Auth (TGIS/8033)"]
            IstioMTLS["Istio mTLS<br/>Service Identity"]
            IstioMTLS -->|validates| ServiceCert["SPIFFE/x509 Certificate"]
            IstioMTLS -->|enforces| PeerAuth["PeerAuthentication: STRICT"]
        end
    end

    subgraph SecretsManagement["Secrets (Platform-Managed)"]
        direction TB
        ModelCreds["Model Registry Credentials<br/>Mounted by KServe"]
        StorageCreds["S3/Storage Credentials<br/>Mounted by KServe"]
        TLSCerts["TLS Certificates<br/>Managed by Istio/cert-manager"]
    end

    Container -->|"no app-level auth"| PlatformEnforced
    Container -->|"secrets injected by"| SecretsManagement
    BaseImage -->|"provides runtime to"| Container

    style Container fill:#4a90e2,stroke:#333,color:#fff
    style BaseImage fill:#e8e8e8,stroke:#333
    style KubeRBAC fill:#f5a623,stroke:#333
    style IstioMTLS fill:#f5a623,stroke:#333
    style Note1 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style Note2 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style ModelCreds fill:#d5e8d4,stroke:#82b366
    style StorageCreds fill:#d5e8d4,stroke:#82b366
    style TLSCerts fill:#d5e8d4,stroke:#82b366
    style BearerToken fill:#fff2cc,stroke:#d6b656
    style K8sSubjectReview fill:#fff2cc,stroke:#d6b656
    style ServiceCert fill:#fff2cc,stroke:#d6b656
    style PeerAuth fill:#fff2cc,stroke:#d6b656
