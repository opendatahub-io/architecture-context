graph LR
    MMC["model-metadata-collection<br/>(Batch ETL Pipeline)"]

    %% External Dependencies (Required)
    MMC -->|"pulls modelcar images<br/>Docker Registry v2"| OCIRedHat["OCI Registry<br/>registry.redhat.io<br/>(Required)"]
    MMC -->|"Go module<br/>OCI image parsing"| ContainersImage["containers/image<br/>v5.36.1<br/>(Required)"]

    %% External Dependencies (Optional Enrichment)
    MMC -.->|"model collections,<br/>details, tags, READMEs"| HF["HuggingFace API<br/>v1<br/>(Optional)"]
    MMC -.->|"agent.yaml,<br/>README.md"| GitHub["GitHub API<br/>v3<br/>(Optional)"]
    MMC -.->|"MCP image architectures,<br/>timestamps"| OCIOther["OCI Registries<br/>(various)<br/>(Optional)"]

    %% Internal Platform Dependencies
    Dashboard["RHOAI Dashboard"] -->|"volume mount<br/>/app/data"| MMC

    %% Data Sources (File I/O)
    MMC -->|reads| SupplementalCatalog["supplemental-catalog.yaml<br/>(curated entries)"]
    MMC -->|reads| VLLMConfigs["vLLM config files<br/>(recommended configs)"]
    MMC -->|reads| MCPInput["input/mcp_servers/*.yaml<br/>(curated entries)"]

    %% Source Data
    ModelcarImages["modelcar images<br/>rhai/rhelai1<br/>(OCI Registry)"] -->|"source images"| MMC
    AgentKitsRepo["agentic-starter-kits<br/>(GitHub repo)"] -->|"agent metadata"| MMC

    %% CI/CD
    KonfluxCI["Konflux CI/CD"] -->|"builds multi-arch<br/>container image"| MMC
    GitHubActions["GitHub Actions"] -->|"runs pipeline,<br/>commits outputs"| MMC

