graph LR
    Workbenches["Workbenches<br/>(Kubeflow Notebooks v2)"]

    %% External Dependencies (Required)
    Workbenches -->|"API server<br/>6443/TCP HTTPS"| K8s["Kubernetes 1.31+"]
    Workbenches -->|"operator framework"| ControllerRuntime["controller-runtime 0.19.1"]
    Workbenches -->|"static file serving"| Nginx["nginx (alpine)"]
    Workbenches -->|"build toolchain"| NodeJS["Node.js 20 (build-time)"]

    %% External Dependencies (Optional)
    Workbenches -.->|"VirtualService routing<br/>mTLS enforcement"| Istio["Istio 1.22+"]
    Workbenches -.->|"webhook TLS certs"| CertManager["cert-manager v1"]

    %% Internal Platform Dependencies
    Workbenches -->|"ingress routing<br/>443/TCP HTTPS"| IstioGW["Istio Ingress Gateway"]
    Workbenches -->|"shared gateway CR"| KubeflowGW["Kubeflow Gateway"]
    Workbenches -->|"delegated authz<br/>SubjectAccessReview"| K8sRBAC["Kubernetes RBAC"]
    Workbenches -->|"icon/logo assets"| ConfigMaps["ConfigMaps<br/>(image-source labeled)"]

    %% Integration Points (consumed by others)
    Dashboard["ODH Dashboard"] -.->|"external webhooks<br/>vworkspace.kb.io<br/>vworkspacekind.kb.io"| Workbenches
    KubeflowRBAC["Kubeflow RBAC System"] -.->|"aggregated ClusterRoles<br/>admin/edit/view"| Workbenches
    Prometheus["Prometheus"] -.->|"metrics scrape<br/>8080/TCP HTTP"| Workbenches

