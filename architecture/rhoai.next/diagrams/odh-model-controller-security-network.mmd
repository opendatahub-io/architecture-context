graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
        Dashboard["RHOAI Dashboard"]
        Client["Inference Client"]
    end

    subgraph Ingress["INGRESS (External → Cluster)"]
        Route["OpenShift Route<br/>(per InferenceService)<br/>443/TCP<br/>TLS Edge/Reencrypt<br/>Auth: Optional (enable-auth-odh)"]
        HTTPRoute["Gateway API HTTPRoute<br/>(per LLMInferenceService)<br/>Gateway listener port<br/>TLS (Gateway-defined)<br/>Auth: Kuadrant AuthPolicy"]
    end

    subgraph ClusterServices["CLUSTER SERVICES (Platform Namespace)"]
        direction TB

        subgraph ControllerPod["odh-model-controller (manager)"]
            WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP<br/>TLS (OpenShift serving certs)<br/>Auth: K8s API server client cert"]
            Metrics["Metrics<br/>8080/TCP HTTP"]
            Health["Health Probes<br/>8081/TCP HTTP"]
        end

        subgraph ServerPod["model-serving-api (server)"]
            GWAPI["Gateway Discovery API<br/>8443/TCP HTTPS<br/>TLS 1.2+ FIPS<br/>Ciphers: ECDHE-RSA/ECDSA AES-GCM<br/>Auth: Bearer + SelfSubjectAccessReview"]
            ServerMetrics["Metrics<br/>8080/TCP HTTPS TLS 1.2+"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: ServiceAccount Token"]

        ISVCMetrics["{isvc-name}-metrics<br/>(per ISVC) ClusterIP<br/>HTTP / No Auth"]
    end

    subgraph EgressServices["EXTERNAL SERVICES (Egress)"]
        NGC["NVIDIA NGC API<br/>api.ngc.nvidia.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer (NGC API Key)"]
        ModelReg["Model Registry<br/>(configurable)/TCP HTTPS<br/>TLS 1.2+ (skip optional)<br/>Auth: Bearer Token"]
        Thanos["Prometheus / Thanos Querier<br/>9091/TCP HTTPS<br/>TLS<br/>Auth: ServiceAccount Token"]
        OTLP["OTLP Collector<br/>(configurable)/TCP gRPC<br/>TLS (configurable)<br/>Auth: None"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS Edge/Reencrypt<br/>Optional Auth"| Route
    Client -->|"HTTPS<br/>TLS<br/>Kuadrant AuthPolicy"| HTTPRoute

    %% External → Cluster
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    Dashboard -->|"HTTPS/8443<br/>TLS 1.2+ FIPS<br/>Bearer Token + RBAC"| GWAPI

    %% K8s API → Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>API server client cert"| WebhookSvc

    %% Controller → K8s API
    WebhookSvc -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Server → K8s API
    GWAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Token passthrough"| K8sAPI

    %% Controller → External
    ControllerPod -->|"HTTPS/443<br/>TLS 1.2+<br/>NGC API Key"| NGC
    ControllerPod -->|"HTTPS<br/>TLS 1.2+<br/>Bearer Token"| ModelReg
    ControllerPod -->|"HTTPS/9091<br/>TLS<br/>SA Token"| Thanos
    ServerPod -->|"gRPC<br/>TLS (configurable)<br/>None"| OTLP

    %% Prometheus scrape
    Thanos -.->|"HTTP<br/>No Encryption<br/>No Auth"| Metrics
    Thanos -.->|"HTTP<br/>No Encryption<br/>No Auth"| ISVCMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef apiserver fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class User,Dashboard,Client external
    class Route,HTTPRoute ingress
    class WebhookSvc,Metrics,Health,GWAPI,ServerMetrics,ISVCMetrics cluster
    class K8sAPI apiserver
    class NGC,ModelReg,Thanos,OTLP egress
