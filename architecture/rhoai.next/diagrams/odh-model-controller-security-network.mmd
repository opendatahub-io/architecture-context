graph TB
    subgraph External["EXTERNAL CLIENTS"]
        Client["Dashboard / CLI Client"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (opendatahub)"]
        direction TB

        subgraph MSA_Box["model-serving-api"]
            MSA["model-serving-api<br/>SA: model-serving-api<br/>TLS: model-serving-api-tls"]
            MSA_API["443/TCP → 8443/TCP HTTPS<br/>Bearer token + SAR"]
            MSA_Metrics["8080/TCP HTTP<br/>Metrics"]
        end

        subgraph Controller_Box["odh-model-controller"]
            Controller["odh-model-controller<br/>SA: odh-model-controller<br/>TLS: webhook-cert + metrics-tls"]
            Webhook_Svc["443/TCP → 9443/TCP HTTPS<br/>Kubernetes Admission"]
            Metrics_Svc["8443/TCP HTTPS<br/>TokenReview + SAR"]
            Health["8081/TCP HTTP<br/>Health Probes (no auth)"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        KubeAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>SA tokens / Bearer tokens"]
        OSConfig["OpenShift APIServer Config<br/>TLS Profile Resolution"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        OTEL["OpenTelemetry Collector<br/>gRPC OTLP<br/>Trace Export"]
    end

    %% Client flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token"| MSA_API

    %% model-serving-api to Kubernetes API
    MSA -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token + User token"| KubeAPI

    %% model-serving-api to OTEL
    MSA -->|"gRPC/OTLP<br/>Trace export"| OTEL

    %% Kubernetes API to webhook
    KubeAPI -->|"HTTPS/443→9443<br/>TLS 1.2+ service-CA<br/>Admission control"| Webhook_Svc

    %% Controller to Kubernetes API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>CRUD + Watches"| KubeAPI

    %% Controller reads OpenShift config
    Controller -->|"HTTPS/6443<br/>TLS profile watch"| OSConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class MSA,MSA_API,MSA_Metrics,Controller,Webhook_Svc,Metrics_Svc,Health controller
    class KubeAPI,OSConfig controlplane
    class OTEL externalsvc
