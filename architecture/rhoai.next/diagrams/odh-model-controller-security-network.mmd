graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>Bearer / Client Cert"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph WebhookSvc["Webhook Server"]
            Webhook["Admission Webhooks<br/>Service: 443/TCP → 9443/TCP<br/>TLS (service-cert)<br/>Secret: webhook-server-cert<br/>5 mutating + 3 validating"]
        end

        subgraph ControllerPod["Controller"]
            Controller["odh-model-controller<br/>SA: odh-model-controller<br/>8080/TCP metrics (HTTP)<br/>8081/TCP health (HTTP)<br/>9443/TCP webhooks (HTTPS)<br/>Leader election: 1 replica"]
        end

        subgraph APISrv["API Server"]
            APIServer["model-serving-api<br/>SA: model-serving-api<br/>Service: 443/TCP → 8443/TCP<br/>TLS 1.2+ FIPS<br/>ECDHE+AES-GCM only<br/>NIST P-256/P-384<br/>Secret: model-serving-api-tls<br/>fsnotify cert hot-reload"]
        end
    end

    subgraph UserNS["USER NAMESPACES (per-tenant)"]
        direction TB
        ISVCRoute["InferenceService Route<br/>{isvc}.apps.cluster<br/>443/TCP HTTPS<br/>TLS Edge/Re-encrypt"]
        LLMISVCRoute["LLMInferenceService HTTPRoute<br/>via Gateway API<br/>Auth: Kuadrant AuthPolicy<br/>Enforcement: Authorino + EnvoyFilter"]
        DynSecrets["Dynamic Secrets<br/>storage-config, ray-ca-tls,<br/>ray-tls, {account}-pull,<br/>inference-prometheus-auth"]
        DynResources["Dynamic Resources<br/>NetworkPolicy, ServiceMonitor,<br/>ClusterRoleBinding, TriggerAuth"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES (Trusted)"]
        direction TB
        Kuadrant["Kuadrant / Authorino<br/>AuthPolicy CRUD<br/>TLS 1.2+"]
        Istio["Istio Control Plane<br/>EnvoyFilter CRUD<br/>TLS 1.2+"]
        KEDA["KEDA<br/>TriggerAuth CRUD<br/>TLS 1.2+"]
        PromOp["Prometheus Operator<br/>ServiceMonitor/PodMonitor<br/>TLS 1.2+"]
        OSRouter["OpenShift Router<br/>Route CRUD<br/>443/TCP TLS"]
        OSMonitoring["OpenShift Monitoring<br/>Prometheus federation<br/>HTTPS TLS 1.2+<br/>SA token auth"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        NIMAPI["NVIDIA NGC API<br/>api.ngc.nvidia.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>NGC API Key<br/>⚠ No FIPS cipher restriction"]
        ModelReg["Model Registry<br/>443/TCP HTTPS<br/>TLS 1.2+ (skip configurable)<br/>Bearer token"]
    end

    %% External to Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubectl credentials"| K8sAPI

    %% Control Plane to Webhooks
    K8sAPI -->|"HTTPS/9443<br/>TLS service-cert<br/>mTLS (webhook config)<br/>failurePolicy: Fail"| Webhook

    %% Controller to K8s API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% API Server to K8s API
    APIServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SelfSubjectAccessReview"| K8sAPI

    %% Controller to Platform Services
    Controller -.->|"K8s API<br/>TLS 1.2+<br/>CRD CRUD"| Kuadrant
    Controller -.->|"K8s API<br/>TLS 1.2+<br/>CRD CRUD"| Istio
    Controller -.->|"K8s API<br/>TLS 1.2+<br/>CRD CRUD"| KEDA
    Controller -.->|"K8s API<br/>TLS 1.2+<br/>CRD CRUD"| PromOp
    Controller -.->|"K8s API<br/>TLS 1.2+<br/>CRD CRUD"| OSRouter

    %% Controller to User Namespaces
    Controller -.->|creates| ISVCRoute
    Controller -.->|creates| LLMISVCRoute
    Controller -.->|creates| DynSecrets
    Controller -.->|creates| DynResources

    %% Controller to External Services
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>NGC API Key"| NIMAPI
    Controller -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer token"| ModelReg

    %% Dashboard to API Server
    User -->|"HTTPS/8443<br/>TLS 1.2+ FIPS<br/>Bearer token"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Webhook,Controller,APIServer operator
    class ISVCRoute,LLMISVCRoute,DynSecrets,DynResources userns
    class Kuadrant,Istio,KEDA,PromOp,OSRouter,OSMonitoring platform
    class NIMAPI,ModelReg externalsvc
