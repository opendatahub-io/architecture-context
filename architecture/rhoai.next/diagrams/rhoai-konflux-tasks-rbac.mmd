graph TD
    subgraph "Service Accounts"
        SA["build-pipeline-rhoai-konflux-tasks<br/>(PipelineRun SA)"]
    end

    subgraph "Secret Access"
        S1["rhoai-konflux-secret<br/>(Opaque)"]
        S2["odh-github-secret<br/>(Opaque)"]
        S3["konflux-test-infra<br/>(Opaque)"]
        S4["slack-config<br/>(ConfigMap)"]
    end

    subgraph "Secret Keys"
        S1_K1["webhook-url"]
        S1_K2["component-failure-template"]
        S2_K1["bundle-ci-token"]
        S2_K2["operator-ci-token"]
        S2_K3["commenter-token"]
        S2_K4["build-metadata-token"]
        S3_K1["bot-commenter-token"]
        S4_K1["component-failure-template"]
        S4_K2["component-slack-handle"]
        S4_K3["release-slack-handle"]
    end

    subgraph "Tasks Using Secrets"
        T_Init["rhoai-init"]
        T_TrigOp["trigger-operator-build"]
        T_TrigBundle["trigger-bundle-build"]
        T_TrigGroup["trigger-group-testing"]
        T_PRComment["pull-request-comment"]
        T_Mirror["container-image-mirror"]
        T_Sealights["rhoai-inject-sealights-oci-ta"]
    end

    %% SA has access to secrets
    SA -->|mounts| S1
    SA -->|mounts| S2
    SA -->|mounts| S3
    SA -->|mounts| S4

    %% Secret to key mappings
    S1 --- S1_K1
    S1 --- S1_K2
    S2 --- S2_K1
    S2 --- S2_K2
    S2 --- S2_K3
    S2 --- S2_K4
    S3 --- S3_K1
    S4 --- S4_K1
    S4 --- S4_K2
    S4 --- S4_K3

    %% Task to secret usage
    T_Init -->|reads| S1_K1
    T_Init -->|reads| S4_K1
    T_Init -->|reads| S4_K2
    T_Init -->|reads| S4_K3
    T_TrigOp -->|reads| S2_K2
    T_TrigBundle -->|reads| S2_K1
    T_TrigGroup -->|reads| S2_K3
    T_PRComment -->|reads| S3_K1
    T_Mirror -->|reads registry auth| S2_K4

    %% Note about RBAC
    NoRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>in this repository.<br/>Tasks inherit SA<br/>permissions from<br/>PipelineRun context."]

    style SA fill:#4a90e2,color:#fff
    style S1 fill:#f5a623
    style S2 fill:#f5a623
    style S3 fill:#f5a623
    style S4 fill:#fff2cc,stroke:#d6b656
    style NoRBAC fill:#fce4ec,stroke:#e74c3c,stroke-width:2px
    style T_Init fill:#7ed321
    style T_TrigOp fill:#7ed321
    style T_TrigBundle fill:#7ed321
    style T_TrigGroup fill:#7ed321
    style T_PRComment fill:#7ed321
    style T_Mirror fill:#7ed321
    style T_Sealights fill:#7ed321
