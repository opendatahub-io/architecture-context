graph TB
    subgraph ExtProc["AI Gateway Payload Processing Service"]
        direction TB

        subgraph Controllers["Control Plane (controller-runtime)"]
            EPCtrl["ExternalProvider<br/>Controller"]
            EMCtrl["ExternalModel<br/>Controller"]
            LegacyCtrl["Legacy Migration<br/>Controller"]
        end

        subgraph PluginPipeline["Data Plane (IPP Plugin Pipeline)"]
            direction LR
            HeadersGuard["maas-headers-guard"]
            ModelResolver["model-provider-resolver"]
            StreamUsage["stream-usage-enforcer"]
            APITranslation["api-translation"]
            APIKeyInject["apikey-injection"]
        end

        subgraph OptionalPlugins["Optional Plugins"]
            direction LR
            ExtMetering["external-metering"]
            NemoReqGuard["nemo-request-guard"]
            NemoRespGuard["nemo-response-guard"]
        end

        subgraph SharedState["Shared In-Memory State"]
            InfoStore["infoStore<br/>(model/provider cache)"]
            SecretStore["secretStore<br/>(credential cache)"]
        end

        Controllers -->|populate| SharedState
        PluginPipeline -->|read| SharedState
    end

    %% External Inputs
    Client["Client"] -->|HTTPS/443| Gateway["AI Gateway<br/>(Envoy)"]
    Gateway -->|gRPC/9004<br/>ext_proc| HeadersGuard
    HeadersGuard --> ModelResolver
    ModelResolver --> StreamUsage
    StreamUsage --> APITranslation
    APITranslation --> APIKeyInject
    APIKeyInject -->|response| Gateway

    %% CRDs
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io)"] -->|watched by| EMCtrl
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io)"] -->|watched by| EPCtrl
    LegacyCR["ExternalModel CR<br/>(maas.opendatahub.io)"] -.->|watched by| LegacyCtrl

    %% Controller outputs
    EPCtrl -->|creates| SvcEntry["ServiceEntry +<br/>DestinationRule +<br/>ExternalName Service"]
    EMCtrl -->|creates| HTTPRoute["Gateway API<br/>HTTPRoute"]
    LegacyCtrl -->|creates| ExternalModelCR
    LegacyCtrl -->|creates| ExternalProviderCR

    %% Egress
    Gateway -->|HTTPS/443| Providers["External LLM Providers<br/>(OpenAI, Anthropic, Bedrock,<br/>Vertex AI, Azure)"]

    %% Optional plugin targets
    ExtMetering -.->|HTTP| MeteringSvc["Metering Service"]
    NemoReqGuard -.->|HTTP| NemoSvc["NeMo Guardrails"]
    NemoRespGuard -.->|HTTP| NemoSvc

    %% Styling
    style ExtProc fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Controllers fill:#d5e8d4,stroke:#82b366
    style PluginPipeline fill:#fff2cc,stroke:#d6b656
    style OptionalPlugins fill:#f8cecc,stroke:#b85450
    style SharedState fill:#e1d5e7,stroke:#9673a6
    style Gateway fill:#ffe6cc,stroke:#d79b00
    style ExternalModelCR fill:#f5a623,stroke:#333
    style ExternalProviderCR fill:#f5a623,stroke:#333
    style LegacyCR fill:#ccc,stroke:#999
    style Providers fill:#f9f9f9,stroke:#999
    style MeteringSvc fill:#f9f9f9,stroke:#999
    style NemoSvc fill:#f9f9f9,stroke:#999
