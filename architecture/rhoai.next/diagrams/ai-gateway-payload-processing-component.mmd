graph TB
    subgraph ExtClient["External"]
        Client[Client / Application]
    end

    subgraph IstioGW["Istio Gateway (Envoy)"]
        Envoy[Envoy Proxy<br/>443/TCP HTTPS]
        EnvoyFilter[EnvoyFilter<br/>ext_proc attachment]
        Envoy --- EnvoyFilter
    end

    subgraph AGPP["AI Gateway Payload Processing"]
        direction TB

        subgraph ControlPlane["Control Plane (Kubernetes Controllers)"]
            EMCtrl[ExternalModel<br/>Controller]
            EPCtrl[ExternalProvider<br/>Controller]
            LegacyCtrl[Legacy Migration<br/>Controller]
        end

        subgraph DataPlane["Data Plane (ext_proc Plugin Pipeline)"]
            direction LR
            HeadersGuard[maas-headers<br/>-guard]
            ModelResolver[model-provider<br/>-resolver]
            StreamUsage[stream-usage<br/>-enforcer]
            APITranslation[api-translation]
            APIKeyInject[apikey-injection]
            NemoReqGuard[nemo-request<br/>-guard]
            NemoRespGuard[nemo-response<br/>-guard]
            ExternalMetering[external-metering]

            HeadersGuard --> ModelResolver
            ModelResolver --> StreamUsage
            StreamUsage --> APITranslation
            APITranslation --> APIKeyInject
        end

        ExtProcServer[ext_proc gRPC Server<br/>9004/TCP]
        HealthCheck[Health Check<br/>9005/TCP]
    end

    subgraph CRDs["Custom Resources"]
        ExternalModelCR[ExternalModel CR<br/>inference.opendatahub.io/v1alpha1]
        ExternalProviderCR[ExternalProvider CR<br/>inference.opendatahub.io/v1alpha1]
    end

    subgraph K8sResources["Generated Kubernetes Resources"]
        HTTPRoute[HTTPRoute<br/>Gateway API]
        ExtNameSvc[ExternalName<br/>Service]
        ServiceEntry[Istio<br/>ServiceEntry]
        DestRule[Istio<br/>DestinationRule]
    end

    subgraph ExternalProviders["External LLM Providers"]
        OpenAI[OpenAI API<br/>api.openai.com]
        Anthropic[Anthropic API<br/>api.anthropic.com]
        Azure[Azure OpenAI<br/>*.openai.azure.com]
        Vertex[Vertex AI<br/>*-aiplatform.googleapis.com]
        Bedrock[AWS Bedrock<br/>bedrock-runtime.*.amazonaws.com]
    end

    subgraph SupportServices["Support Services"]
        MeteringSvc[External Metering<br/>Service]
        NemoSvc[NeMo Guardrails<br/>Service]
    end

    subgraph SecretStore["Kubernetes Secrets"]
        ProviderCreds[Provider Credentials<br/>label: inference.llm-d.ai/ipp-managed]
    end

    %% Client flow
    Client -->|HTTPS/443| Envoy
    EnvoyFilter -->|gRPC/9004| ExtProcServer
    ExtProcServer --> HeadersGuard

    %% Controller reconciliation
    ExternalModelCR -->|watched by| EMCtrl
    ExternalProviderCR -->|watched by| EPCtrl
    EMCtrl -->|creates| HTTPRoute
    EPCtrl -->|creates| ExtNameSvc
    EPCtrl -->|creates| ServiceEntry
    EPCtrl -->|creates| DestRule

    %% Plugin dependencies
    ModelResolver -.->|caches| ExternalModelCR
    APIKeyInject -.->|reads| ProviderCreds
    ExternalMetering -.->|REST| MeteringSvc
    NemoReqGuard -.->|REST| NemoSvc
    NemoRespGuard -.->|REST| NemoSvc

    %% Egress to providers
    Envoy -->|HTTPS/443<br/>via HTTPRoute| OpenAI
    Envoy -->|HTTPS/443<br/>via HTTPRoute| Anthropic
    Envoy -->|HTTPS/443<br/>via HTTPRoute| Azure
    Envoy -->|HTTPS/443<br/>via HTTPRoute| Vertex
    Envoy -->|HTTPS/443<br/>via HTTPRoute| Bedrock

    %% Styling
    style ExtProcServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthCheck fill:#4a90e2,stroke:#333,color:#fff
    style EMCtrl fill:#4a90e2,stroke:#333,color:#fff
    style EPCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LegacyCtrl fill:#4a90e2,stroke:#333,color:#fff
    style HeadersGuard fill:#50c878,stroke:#333,color:#fff
    style ModelResolver fill:#50c878,stroke:#333,color:#fff
    style StreamUsage fill:#50c878,stroke:#333,color:#fff
    style APITranslation fill:#50c878,stroke:#333,color:#fff
    style APIKeyInject fill:#50c878,stroke:#333,color:#fff
    style NemoReqGuard fill:#50c878,stroke:#333,color:#fff
    style NemoRespGuard fill:#50c878,stroke:#333,color:#fff
    style ExternalMetering fill:#50c878,stroke:#333,color:#fff
    style ExternalModelCR fill:#f5a623,stroke:#333,color:#fff
    style ExternalProviderCR fill:#f5a623,stroke:#333,color:#fff
    style HTTPRoute fill:#ddd,stroke:#333
    style ExtNameSvc fill:#ddd,stroke:#333
    style ServiceEntry fill:#ddd,stroke:#333
    style DestRule fill:#ddd,stroke:#333
    style OpenAI fill:#999,stroke:#333,color:#fff
    style Anthropic fill:#999,stroke:#333,color:#fff
    style Azure fill:#999,stroke:#333,color:#fff
    style Vertex fill:#999,stroke:#333,color:#fff
    style Bedrock fill:#999,stroke:#333,color:#fff
    style ProviderCreds fill:#e8e8e8,stroke:#333
