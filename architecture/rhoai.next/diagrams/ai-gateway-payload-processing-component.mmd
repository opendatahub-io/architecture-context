graph TB
    subgraph AGPP["AI Gateway Payload Processing"]
        direction TB

        subgraph ExtProc["ext_proc gRPC Server (9004/TCP)"]
            PluginPipeline["Plugin Pipeline"]
            DynMeta["dynamicmetadata wrapper"]
            PluginPipeline --> DynMeta
        end

        subgraph Controllers["Kubernetes Controllers"]
            EPCtrl["ExternalProvider Controller"]
            EMCtrl["ExternalModel Controller"]
            LegacyCtrl["Legacy Migration Controller"]
        end

        HealthSrv["Health gRPC Server<br/>(9005/TCP)"]
    end

    %% CRDs
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io/v1alpha1)"]
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io/v1alpha1)"]
    LegacyCR["ExternalModel CR<br/>(maas.opendatahub.io/v1alpha1)"]

    %% Created Resources
    HTTPRoute["HTTPRoute<br/>(gateway.networking.k8s.io)"]
    ServiceEntry["Istio ServiceEntry"]
    DestRule["Istio DestinationRule"]
    ExtNameSvc["ExternalName Service"]

    %% External Systems
    Envoy["Envoy Proxy<br/>(AI Gateway)"]
    K8sAPI["Kubernetes API"]
    Gateway["Platform Gateway"]
    LLMProviders["External LLM Providers<br/>(OpenAI, Anthropic, Azure,<br/>Bedrock, Vertex)"]
    NeMo["NeMo Guardrails"]

    %% Flows
    Envoy -->|"gRPC ext_proc<br/>callout"| PluginPipeline
    PluginPipeline -->|"credential<br/>injection"| LLMProviders
    PluginPipeline -->|"guardrail<br/>checks"| NeMo

    ExternalProviderCR -->|"watched by"| EPCtrl
    EPCtrl -->|"creates"| ExtNameSvc
    EPCtrl -->|"creates"| ServiceEntry
    EPCtrl -->|"creates"| DestRule

    ExternalModelCR -->|"watched by"| EMCtrl
    EMCtrl -->|"creates"| HTTPRoute
    HTTPRoute -->|"attached to"| Gateway

    LegacyCR -->|"watched by"| LegacyCtrl
    LegacyCtrl -->|"creates equivalent"| ExternalModelCR
    LegacyCtrl -->|"creates equivalent"| ExternalProviderCR

    Controllers -->|"HTTPS/6443"| K8sAPI

    %% Styling
    style PluginPipeline fill:#4a90e2,stroke:#333,color:#fff
    style DynMeta fill:#4a90e2,stroke:#333,color:#fff
    style EPCtrl fill:#4a90e2,stroke:#333,color:#fff
    style EMCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LegacyCtrl fill:#4a90e2,stroke:#333,color:#fff
    style HealthSrv fill:#4a90e2,stroke:#333,color:#fff
    style ExternalModelCR fill:#f5a623,stroke:#333
    style ExternalProviderCR fill:#f5a623,stroke:#333
    style LegacyCR fill:#f5a623,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style ServiceEntry fill:#7ed321,stroke:#333
    style DestRule fill:#7ed321,stroke:#333
    style ExtNameSvc fill:#7ed321,stroke:#333
    style Envoy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style LLMProviders fill:#e8e8e8,stroke:#333
    style NeMo fill:#e8e8e8,stroke:#333
