graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Knative Ingress Gateway<br/>443/TCP → 8085/8080<br/>TLS 1.2+ SIMPLE<br/>Credential: wildcard-certs"]
        LocalGW["Knative Local Gateway<br/>8081/TCP HTTP<br/>Cluster-local only"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT)"]
        direction TB

        subgraph Pod["Caikit-TGIS-Serving Pod<br/>Namespace: user-namespace"]
            direction TB
            subgraph Transformer["transformer-container"]
                Caikit["Caikit Runtime<br/>UID: 1001 (non-root)<br/>UBI9 PQC base image"]
                GRPC["gRPC API :8085"]
                HTTP["HTTP API :8080"]
                MetricsPort["Metrics :8086<br/>PERMISSIVE mTLS"]
            end

            subgraph KServeC["kserve-container"]
                TGIS["TGIS<br/>gRPC :8033"]
            end

            Caikit -->|"gRPC localhost:8033<br/>No encryption<br/>No auth"| TGIS
        end
    end

    subgraph Monitoring["MONITORING (Internal)"]
        Prometheus["Prometheus<br/>openshift-user-workload-monitoring<br/>NetworkPolicy allowed"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>9000/TCP or 443/TCP<br/>HTTP/HTTPS<br/>AWS IAM credentials"]
    end

    %% Flows
    Client -->|"HTTPS 443/TCP<br/>TLS 1.2+ SIMPLE"| Gateway
    Gateway -->|"gRPC :8085 / HTTP :8080<br/>mTLS STRICT<br/>Service Identity"| Caikit
    LocalGW -->|"HTTP :8081<br/>cluster-local"| Caikit
    TGIS -->|"S3 API<br/>9000/443 TCP<br/>AWS IAM Auth"| S3
    Prometheus -->|"HTTP :8086<br/>PERMISSIVE mTLS<br/>No auth"| MetricsPort

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway,LocalGW ingress
    class Caikit,GRPC,HTTP,MetricsPort,TGIS servicemesh
    class Prometheus monitoring
    class S3 externalservice
