graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["knative-ingress-gateway<br/>Istio Gateway<br/>443/TCP → 8012/TCP<br/>TLS 1.2+ (SIMPLE)<br/>RequestAuthentication"]
        LocalGW["knative-local-gateway<br/>Istio Gateway<br/>80/TCP (cluster-local)<br/>No TLS"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS STRICT)"]
        direction TB

        QueueProxy["Knative Queue-Proxy<br/>Namespace: user-ns<br/>Concurrency enforcement"]

        subgraph SRPod["KServe ServingRuntime Pod"]
            direction TB

            subgraph Transformer["transformer-container"]
                CaikitRuntime["Caikit Runtime<br/>caikit-tgis-serving<br/>Python 3.11 / UBI 9<br/>Ports: 8080, 8085, 8086"]
            end

            subgraph KServeContainer["kserve-container"]
                TGIS["TGIS Server<br/>Port: 8033/TCP gRPC<br/>Model weights: /mnt/models"]
            end

            subgraph Init["init-container"]
                StorageInit["KServe Storage Initializer<br/>Downloads model artifacts"]
            end
        end

        Prometheus["Prometheus<br/>User Workload Monitoring"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelStorage["Model Storage<br/>S3 / MinIO / PVC<br/>TLS (S3) or local (PVC)<br/>Auth: S3 credentials"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>Auth: API token (optional)<br/>(dev only)"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (optional)"| Gateway

    %% Ingress → Service Mesh
    Gateway -->|"HTTP/8012<br/>mTLS STRICT<br/>PeerAuthentication"| QueueProxy
    LocalGW -->|"HTTP/80<br/>cluster-local"| QueueProxy

    %% Queue-Proxy → Caikit
    QueueProxy -->|"HTTP/8080<br/>mTLS STRICT<br/>PeerAuthentication"| CaikitRuntime

    %% Intra-pod communication
    CaikitRuntime -->|"gRPC/8033<br/>plaintext (localhost)<br/>No auth"| TGIS

    %% Metrics scraping
    Prometheus -->|"HTTP/8086<br/>No TLS<br/>PeerAuth PERMISSIVE"| CaikitRuntime

    %% Storage
    StorageInit -->|"Model download<br/>S3 creds (Opaque secret)"| ModelStorage

    %% HuggingFace (dev only)
    CaikitRuntime -.->|"HTTPS/443<br/>TLS 1.2+<br/>(convert.py only)"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway,LocalGW ingress
    class QueueProxy servicemesh
    class CaikitRuntime,TGIS,StorageInit pod
    class ModelStorage,HFHub externalservice
    class Prometheus monitoring
