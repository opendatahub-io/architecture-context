graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Istio IngressGateway<br/>443/TCP → 8012/TCP<br/>TLS 1.2+ SIMPLE<br/>Hosts: *.apps.cluster"]
        KnativeRoute["Knative Route<br/>80/TCP, 443/TCP<br/>TLS via Istio"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS STRICT)"]
        direction TB

        subgraph NS_Knative["Namespace: knative-serving"]
            Activator["Knative Activator /<br/>Queue-Proxy<br/>SA: activator"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            subgraph ServingPod["KServe Serving Pod"]
                direction TB
                CaikitRuntime["transformer-container:<br/>Caikit Runtime<br/>Ports: 8080 HTTP, 8085 gRPC, 8086 metrics<br/>Image: caikit-tgis-serving (UBI 9)"]
                TGISBackend["kserve-container:<br/>TGIS Backend<br/>Port: 8033 gRPC<br/>Actual LLM Inference"]
            end
            ModelPVC["PVC: /mnt/models/<br/>Model Artifacts<br/>(Caikit format)"]
        end
    end

    subgraph Monitoring["MONITORING (Internal)"]
        Prometheus["Prometheus<br/>openshift-user-workload-monitoring<br/>ServiceMonitor: caikit-metrics"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 / MinIO Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: S3 credentials<br/>(minio-secret)"]
        HuggingFace["HuggingFace Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: API Token (optional)<br/>(dev/setup only)"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>TLS passthrough"| Gateway

    %% Ingress → Service Mesh
    Gateway -->|"HTTP+gRPC/8012<br/>mTLS STRICT<br/>PeerAuthentication"| KnativeRoute
    KnativeRoute -->|"HTTP+gRPC/8012<br/>mTLS STRICT<br/>PeerAuthentication"| Activator

    %% Service Mesh internal
    Activator -->|"HTTP/8080 or gRPC/8085<br/>mTLS STRICT<br/>PeerAuthentication"| CaikitRuntime

    %% Intra-pod (localhost)
    CaikitRuntime -->|"gRPC/8033<br/>plaintext (localhost)<br/>no auth"| TGISBackend

    %% Model access
    ModelPVC -.->|"filesystem mount"| CaikitRuntime
    ModelPVC -.->|"filesystem mount"| TGISBackend

    %% Monitoring
    Prometheus -->|"HTTP/8086<br/>PERMISSIVE mTLS<br/>no auth<br/>NetworkPolicy allowed"| CaikitRuntime

    %% Egress
    CaikitRuntime -.->|"HTTPS/443<br/>TLS 1.2+<br/>API Token (optional)<br/>ALLOW_DOWNLOADS=1"| HuggingFace
    S3 -.->|"S3 API/443<br/>TLS 1.2+<br/>S3 credentials"| ModelPVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef pod fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway,KnativeRoute ingress
    class Activator,CaikitRuntime,TGISBackend,ModelPVC servicemesh
    class Prometheus monitoring
    class S3,HuggingFace externalservice
