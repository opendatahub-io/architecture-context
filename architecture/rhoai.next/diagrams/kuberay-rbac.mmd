graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["kuberay-operator<br/>(operator namespace)"]
        SA_Head["{cluster}-head-sa<br/>(workload namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["kuberay-operator<br/>(cluster-wide)"]
        CRB_GW["kuberay-operator-gateway-api<br/>(cluster-wide)"]
        CRB_CM["kuberay-operator-configmap<br/>(cluster-wide)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_LE["kuberay-operator-leader-election<br/>(operator namespace)"]
        RB_AS["{cluster}-autoscaler<br/>(workload namespace)"]
    end

    subgraph ClusterRole_Main["ClusterRole: kuberay-operator"]
        direction LR
        subgraph RayCRDs["ray.io CRDs"]
            RayClusters["rayclusters<br/>rayjobs<br/>rayservices<br/>raycronjobs<br/><i>get,list,watch,create,<br/>update,patch,delete</i>"]
            RayFinalizers["*/finalizers<br/><i>update</i>"]
            RayStatus["*/status<br/><i>get,patch,update</i>"]
        end

        subgraph CoreResources["Core Resources"]
            Pods["pods<br/><i>create,delete,deletecollection,<br/>get,list,patch,update,watch</i>"]
            Services["services, configmaps,<br/>events, serviceaccounts<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
            Secrets["secrets<br/><i>create,delete,<br/>get,list,watch</i>"]
            PodsProxy["pods/proxy,<br/>services/status<br/><i>get,patch,update</i>"]
        end

        subgraph NetworkResources["Network Resources"]
            Ingresses["ingresses,<br/>networkpolicies<br/><i>full CRUD</i>"]
            Routes["routes<br/>(route.openshift.io)<br/><i>full CRUD</i>"]
        end

        subgraph CertManagerRes["cert-manager.io"]
            Certs["certificates,<br/>issuers<br/><i>full CRUD</i>"]
            CertStatus["certificates/status<br/><i>get,patch,update</i>"]
        end

        subgraph AuthResources["Auth Resources"]
            TokenReview["tokenreviews<br/>(authentication.k8s.io)<br/><i>create</i>"]
            SAR["subjectaccessreviews<br/>(authorization.k8s.io)<br/><i>create</i>"]
        end

        subgraph OpenShiftResources["OpenShift Resources"]
            APIServers["apiservers<br/>(config.openshift.io)<br/><i>get</i>"]
            AuthConfig["authentications,<br/>oauths<br/><i>get,list,watch</i>"]
            KubeAPIServers["kubeapiservers<br/>(operator.openshift.io)<br/><i>get,list,watch</i>"]
        end

        subgraph BatchResources["Batch Resources"]
            Jobs["jobs (batch)<br/><i>full CRUD</i>"]
            Leases["leases<br/>(coordination.k8s.io)<br/><i>create,get,list,update</i>"]
        end

        subgraph RBACResources["RBAC Resources"]
            ClusterRoles["clusterroles,<br/>clusterrolebindings<br/><i>get,list,watch</i>"]
            Roles["roles<br/><i>create,delete,get,<br/>list,update,watch</i>"]
            RoleBindingsRes["rolebindings<br/><i>full CRUD</i>"]
        end
    end

    subgraph ClusterRole_GW["ClusterRole: kuberay-operator-gateway-api"]
        GWGateways["gateways<br/><i>get,list,watch</i>"]
        GWHTTPRoutes["httproutes,<br/>referencegrants<br/><i>full CRUD</i>"]
    end

    subgraph ClusterRole_CM["ClusterRole: kuberay-operator-configmap"]
        CMConfigmaps["configmaps<br/><i>full CRUD</i>"]
    end

    subgraph AggregatedRoles["Aggregated Roles"]
        EditRole["kuberay-edit-role<br/>rayjobs, rayclusters,<br/>rayservices<br/><i>full CRUD</i>"]
        ViewRole["kuberay-view-role<br/>rayjobs, rayclusters,<br/>rayservices<br/><i>get,list,watch</i>"]
    end

    %% Service Account → Binding connections
    SA_Operator -->|bound via| CRB_Main
    SA_Operator -->|bound via| CRB_GW
    SA_Operator -->|bound via| CRB_CM
    SA_Operator -->|bound via| RB_LE
    SA_Head -->|bound via| RB_AS

    %% Binding → Role connections
    CRB_Main -->|grants| ClusterRole_Main
    CRB_GW -->|grants| ClusterRole_GW
    CRB_CM -->|grants| ClusterRole_CM

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style SA_Head fill:#4a90e2,color:#fff
    style CRB_Main fill:#f5a623,color:#fff
    style CRB_GW fill:#f5a623,color:#fff
    style CRB_CM fill:#f5a623,color:#fff
    style RB_LE fill:#f5a623,color:#fff
    style RB_AS fill:#f5a623,color:#fff
    style EditRole fill:#7ed321,color:#fff
    style ViewRole fill:#7ed321,color:#fff

    style RayClusters fill:#e8f5e9
    style RayFinalizers fill:#e8f5e9
    style RayStatus fill:#e8f5e9
    style Pods fill:#e3f2fd
    style Services fill:#e3f2fd
    style Secrets fill:#e3f2fd
    style PodsProxy fill:#e3f2fd
    style Ingresses fill:#fff3e0
    style Routes fill:#fff3e0
    style Certs fill:#fce4ec
    style CertStatus fill:#fce4ec
    style TokenReview fill:#f3e5f5
    style SAR fill:#f3e5f5
    style APIServers fill:#efebe9
    style AuthConfig fill:#efebe9
    style KubeAPIServers fill:#efebe9
    style Jobs fill:#e0f2f1
    style Leases fill:#e0f2f1
    style ClusterRoles fill:#fafafa
    style Roles fill:#fafafa
    style RoleBindingsRes fill:#fafafa
    style GWGateways fill:#fff3e0
    style GWHTTPRoutes fill:#fff3e0
    style CMConfigmaps fill:#e3f2fd
