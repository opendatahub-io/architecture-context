graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kuberay-operator<br/>SA: kuberay-operator"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["kuberay-operator<br/>(Cluster-scoped)"]
        CRB2["kuberay-operator-configmap<br/>(redhat-ods-applications)"]
        CRB3["kuberay-operator-gateway-api<br/>(redhat-ods-applications)"]
        CRB4["kuberay-operator-leader-election<br/>(operator namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Main["kuberay-operator<br/>(ClusterRole)"]
        CR_CM["kuberay-operator-configmap<br/>(ClusterRole)"]
        CR_GW["kuberay-operator-gateway-api<br/>(ClusterRole)"]
        CR_LE["kuberay-operator-leader-election<br/>(Role)"]
        CR_Edit["kuberay-edit-role<br/>(aggregates to admin/edit)"]
        CR_View["kuberay-view-role<br/>(aggregates to view)"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["(core)<br/>pods, pods/status,<br/>pods/proxy, pods/resize"]
        Services["(core)<br/>services, services/proxy"]
        ConfigMaps["(core)<br/>configmaps"]
        Secrets["(core)<br/>secrets"]
        SvcAccounts["(core)<br/>serviceaccounts"]
        Events["(core)<br/>events"]
    end

    subgraph RayResources["Ray API Resources (ray.io)"]
        RayClusters["ray.io<br/>rayclusters<br/>+ /finalizers + /status"]
        RayJobs["ray.io<br/>rayjobs<br/>+ /finalizers + /status"]
        RayServices["ray.io<br/>rayservices<br/>+ /finalizers + /status"]
        RayCronJobs["ray.io<br/>raycronjobs<br/>+ /finalizers + /status"]
    end

    subgraph NetworkResources["Network & Gateway Resources"]
        Ingresses["networking.k8s.io<br/>ingresses, networkpolicies,<br/>ingressclasses"]
        GatewayRes["gateway.networking.k8s.io<br/>gateways, httproutes,<br/>referencegrants"]
        Routes["route.openshift.io<br/>routes"]
    end

    subgraph SecurityResources["Security & Auth Resources"]
        RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        CertRes["cert-manager.io<br/>certificates, issuers,<br/>certificates/status"]
        Deployments["apps<br/>deployments"]
        Jobs["batch<br/>jobs"]
    end

    subgraph OSResources["OpenShift Resources"]
        KubeAPIServer["operator.openshift.io<br/>kubeapiservers<br/>+ /status"]
    end

    %% SA to Bindings
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    SA -->|bound via| CRB3
    SA -->|bound via| CRB4

    %% Bindings to Roles
    CRB1 -->|grants| CR_Main
    CRB2 -->|grants| CR_CM
    CRB3 -->|grants| CR_GW
    CRB4 -->|grants| CR_LE

    %% Main ClusterRole permissions
    CR_Main -->|"Full CRUD"| Pods
    CR_Main -->|"Full CRUD"| Services
    CR_Main -->|"Full CRUD"| Secrets
    CR_Main -->|"Full CRUD"| SvcAccounts
    CR_Main -->|"Full CRUD"| Events
    CR_Main -->|"get,list,patch,update,watch"| Deployments
    CR_Main -->|"Full CRUD"| RayClusters
    CR_Main -->|"Full CRUD"| RayJobs
    CR_Main -->|"Full CRUD"| RayServices
    CR_Main -->|"Full CRUD"| RayCronJobs
    CR_Main -->|"Full CRUD"| Jobs
    CR_Main -->|"Full CRUD"| CertRes
    CR_Main -->|"Full CRUD"| Ingresses
    CR_Main -->|"Full CRUD"| Routes
    CR_Main -->|"CRUD roles/bindings;<br/>read-only cluster-level"| RBAC
    CR_Main -->|"create"| TokenReview
    CR_Main -->|"create"| SAR
    CR_Main -->|"get,list,watch"| KubeAPIServer

    %% ConfigMap role
    CR_CM -->|"Full CRUD"| ConfigMaps

    %% Gateway API role
    CR_GW -->|"Full CRUD"| GatewayRes

    %% Aggregated roles
    CR_Edit -->|"Full CRUD"| RayClusters
    CR_Edit -->|"Full CRUD"| RayJobs
    CR_Edit -->|"Full CRUD"| RayServices
    CR_View -->|"get,list,watch"| RayClusters
    CR_View -->|"get,list,watch"| RayJobs
    CR_View -->|"get,list,watch"| RayServices

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR_Main fill:#f5a623
    style CR_CM fill:#f5a623
    style CR_GW fill:#f5a623
    style CR_LE fill:#f5a623
    style CR_Edit fill:#e67e22,color:#fff
    style CR_View fill:#e67e22,color:#fff
    style RayClusters fill:#7ed321
    style RayJobs fill:#7ed321
    style RayServices fill:#7ed321
    style RayCronJobs fill:#7ed321
