graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["kuberay-operator<br/>(operator SA)"]
        SA_Autoscaler["{cluster}-autoscaler-sa<br/>(head group SA)"]
        SA_OIDC["{cluster}-oidc-proxy-sa<br/>(auth proxy SA)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Operator["kuberay-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (per-cluster namespace)"]
        RB_Autoscaler["{cluster-name}<br/>RoleBinding (autoscaler)"]
        RB_OIDC["{cluster-name}<br/>RoleBinding (oidc-proxy)"]
    end

    subgraph ClusterRole["ClusterRole: kuberay-operator"]
        direction TB

        subgraph CoreAPI["Core API ('')"]
            Pods["pods<br/>get,list,watch,create,<br/>update,patch,delete,<br/>deletecollection"]
            PodsResize["pods/resize<br/>patch"]
            PodsProxy["pods/proxy<br/>get,patch,update"]
            PodsStatus["pods/status<br/>get,list,watch,create,<br/>update,patch,delete"]
            ConfigMaps["configmaps<br/>get,list,watch,create,<br/>update,patch,delete"]
            Events["events<br/>get,list,watch,create,<br/>update,patch,delete"]
            ServiceAccounts["serviceaccounts<br/>get,list,watch,create,<br/>update,patch,delete"]
            Services["services<br/>get,list,watch,create,<br/>update,patch,delete"]
            ServicesProxy["services/proxy<br/>get,create,patch,update"]
            Secrets["secrets<br/>get,list,watch,<br/>create,delete"]
        end

        subgraph RayAPI["ray.io"]
            RayClusters["rayclusters (+status,+finalizers)<br/>get,list,watch,create,<br/>update,patch,delete"]
            RayJobs["rayjobs (+status,+finalizers)<br/>get,list,watch,create,<br/>update,patch,delete"]
            RayServices["rayservices (+status,+finalizers)<br/>get,list,watch,create,<br/>update,patch,delete"]
            RayCronJobs["raycronjobs (+status,+finalizers)<br/>get,list,watch,create,<br/>update,patch,delete"]
        end

        subgraph GatewayNetworkAPI["gateway.networking.k8s.io"]
            Gateways["gateways<br/>get,list,watch,<br/>create,update"]
            HTTPRoutes["httproutes<br/>get,list,watch,create,<br/>update,patch,delete"]
            RefGrants["referencegrants<br/>get,list,watch,create,<br/>update,patch,delete"]
        end

        subgraph NetworkingAPI["networking.k8s.io"]
            Ingresses["ingresses<br/>get,list,watch,create,<br/>update,patch,delete"]
            NetworkPolicies["networkpolicies<br/>get,list,watch,create,<br/>update,patch,delete"]
        end

        subgraph RBACAPI["rbac.authorization.k8s.io"]
            Roles["roles<br/>get,list,watch,create,<br/>update,delete"]
            RoleBindingsRes["rolebindings<br/>get,list,watch,create,<br/>update,patch,delete"]
            ClusterRoles["clusterroles<br/>get,list,watch"]
        end

        subgraph CertManagerAPI["cert-manager.io"]
            Certificates["certificates (+status)<br/>get,list,watch,create,<br/>update,patch,delete"]
            Issuers["issuers<br/>get,list,watch,create,<br/>update,patch,delete"]
        end

        subgraph AuthAPI["Auth APIs"]
            TokenReviews["tokenreviews<br/>(authentication.k8s.io)<br/>create"]
            SubjectAccessReviews["subjectaccessreviews<br/>(authorization.k8s.io)<br/>create"]
        end

        subgraph OpenShiftConfigAPI["config.openshift.io"]
            APIServers["apiservers<br/>get"]
            Authentications["authentications (+status)<br/>get,list,watch"]
            OAuths["oauths (+status)<br/>get,list,watch"]
        end
    end

    %% Bindings
    SA_Operator -->|bound via| CRB_Operator
    CRB_Operator -->|grants| ClusterRole

    SA_Autoscaler -->|bound via| RB_Autoscaler
    SA_OIDC -->|bound via| RB_OIDC
    RB_Autoscaler -->|grants| PerClusterRole["{cluster-name} Role<br/>(namespace-scoped)"]
    RB_OIDC -->|grants| PerClusterRole

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Autoscaler fill:#4a90e2,stroke:#333,color:#fff
    style SA_OIDC fill:#4a90e2,stroke:#333,color:#fff
    style CRB_Operator fill:#e8e8e8,stroke:#333
    style ClusterRole fill:#fff3e0,stroke:#f5a623,stroke-width:2px
    style RayClusters fill:#7ed321,stroke:#333
    style RayJobs fill:#7ed321,stroke:#333
    style RayServices fill:#7ed321,stroke:#333
    style RayCronJobs fill:#7ed321,stroke:#333
    style HTTPRoutes fill:#7ed321,stroke:#333
    style RefGrants fill:#7ed321,stroke:#333
    style NetworkPolicies fill:#7ed321,stroke:#333
    style Certificates fill:#7ed321,stroke:#333
    style TokenReviews fill:#e1d5e7,stroke:#9673a6
    style SubjectAccessReviews fill:#e1d5e7,stroke:#9673a6
    style PerClusterRole fill:#fff3e0,stroke:#f5a623
