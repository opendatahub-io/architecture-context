graph TB
    subgraph BatchGateway["Batch Gateway"]
        direction TB

        subgraph APIServer["API Server (Deployment)"]
            APIMux["API Mux<br/>Port 8000/TCP"]
            ObsMux["Observability Mux<br/>Port 8081/TCP"]
            ReqMiddleware["Request Middleware<br/>(tenant extraction, logging, tracing)"]
            SecHeaders["Security Headers Middleware"]
            BatchHandler["Batch Handler<br/>/v1/batches"]
            FileHandler["File Handler<br/>/v1/files"]

            APIMux --> ReqMiddleware
            ReqMiddleware --> SecHeaders
            SecHeaders --> BatchHandler
            SecHeaders --> FileHandler
            ObsMux -->|"/health, /ready, /metrics"| HealthChecks["Health & Metrics"]
        end

        subgraph Processor["Processor (StatefulSet)"]
            JobWorkers["Job Workers<br/>(numWorkers=5)"]
            QueuePoller["Queue Poller<br/>(pollInterval=5s)"]
            Dispatcher["Inference Dispatcher"]
            AIMDController["AIMD Concurrency Controller"]

            QueuePoller --> JobWorkers
            JobWorkers --> Dispatcher
            Dispatcher --> AIMDController
        end

        subgraph GC["Garbage Collector (Deployment)"]
            ExpiredCollector["Expired Job/File Collector"]
            OrphanReconciler["Orphan Reconciler<br/>(pod watcher)"]
        end
    end

    Client["Client"] -->|"POST/GET /v1/batches<br/>POST/GET /v1/files"| UpstreamGateway
    UpstreamGateway["Upstream Gateway<br/>(Kuadrant/Authorino)<br/>Auth Enforcement"] -->|"X-MaaS-Username header"| APIMux

    BatchHandler -->|"create/query jobs"| PostgreSQL["PostgreSQL"]
    BatchHandler -->|"enqueue job"| Redis["Redis/Valkey"]
    FileHandler -->|"store/retrieve files"| S3["S3-Compatible Storage"]
    FileHandler -->|"file metadata"| PostgreSQL

    QueuePoller -->|"dequeue jobs"| Redis
    JobWorkers -->|"read input, write output"| S3
    JobWorkers -->|"update status"| PostgreSQL
    Dispatcher -->|"inference requests"| LLMd["llm-d Inference Gateway"]

    ExpiredCollector -->|"scan expired"| PostgreSQL
    ExpiredCollector -->|"delete files"| S3
    ExpiredCollector -->|"GC events"| Redis
    OrphanReconciler -->|"watch pods"| K8sAPI["Kubernetes API"]

    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Processor fill:#7ed321,stroke:#333,color:#fff
    style GC fill:#f5a623,stroke:#333,color:#fff
    style UpstreamGateway fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff
    style LLMd fill:#9b59b6,stroke:#333,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
