graph TB
    subgraph BatchGateway["Batch Gateway System"]
        direction TB

        subgraph APIServer["batch-gateway-apiserver<br/>Port: 8000/TCP (API), 8081/TCP (observability)"]
            BatchAPI["/v1/batches<br/>POST, GET, CANCEL"]
            FileAPI["/v1/files<br/>POST, GET, DELETE, Content"]
            HealthAPI["/health, /ready, /metrics"]
            BatchAPI --- FileAPI
        end

        subgraph Processor["batch-gateway-processor<br/>Port: 9090/TCP (metrics/health only)"]
            Workers["Worker Pool<br/>(20 goroutines)"]
            Pipeline["Dispatch Pipeline<br/>PreDispatch → Dispatch → Collect"]
            AIMD["AIMD Controller<br/>Adaptive Concurrency"]
            Workers --> Pipeline
            Pipeline --> AIMD
        end

        subgraph GC["batch-gateway-gc<br/>Port: 9091/TCP (metrics/health only)"]
            Collector["Garbage Collector<br/>(30m interval)"]
            Reconciler["Orphan Reconciler<br/>(60m interval)"]
        end
    end

    %% External clients
    Client[External Client] -->|"HTTPS/443<br/>API key / token"| AuthGateway["Kuadrant/Authorino<br/>Auth Gateway"]
    AuthGateway -->|"HTTP(S)/8000<br/>Tenant header injected"| BatchAPI
    AuthGateway -->|"HTTP(S)/8000<br/>Tenant header injected"| FileAPI

    %% Shared data layer
    subgraph DataLayer["Shared Data Layer"]
        PostgreSQL[("PostgreSQL<br/>5432/TCP<br/>Metadata Storage")]
        Redis[("Redis / Valkey<br/>6379/TCP<br/>Queue, Events, Cache")]
        S3[("S3 Storage<br/>443/TCP<br/>File Storage")]
    end

    %% API Server → Data Layer
    APIServer -->|"pgx/5432"| PostgreSQL
    APIServer -->|"go-redis/6379"| Redis
    APIServer -->|"AWS SDK/443"| S3

    %% Processor → Data Layer
    Processor -->|"pgx/5432"| PostgreSQL
    Processor -->|"go-redis/6379<br/>Priority Queue"| Redis
    Processor -->|"AWS SDK/443"| S3

    %% GC → Data Layer
    GC -->|"pgx/5432"| PostgreSQL
    GC -->|"go-redis/6379"| Redis
    GC -->|"AWS SDK/443"| S3

    %% Processor → Inference
    AIMD -->|"HTTP(S)<br/>API key (Bearer)"| LLMDRouter["llm-d Router<br/>Inference Gateway"]

    %% Monitoring
    Prometheus["Prometheus"] -.->|"scrape /metrics"| HealthAPI
    Prometheus -.->|"scrape /metrics"| Processor
    Prometheus -.->|"scrape /metrics"| GC

    %% Styling
    style APIServer fill:#4a90e2,stroke:#2c5f8a,color:#fff
    style Processor fill:#4a90e2,stroke:#2c5f8a,color:#fff
    style GC fill:#4a90e2,stroke:#2c5f8a,color:#fff
    style BatchGateway fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style DataLayer fill:#fff3e0,stroke:#f5a623,stroke-width:2px
    style PostgreSQL fill:#f5a623,stroke:#c17d00
    style Redis fill:#f5a623,stroke:#c17d00
    style S3 fill:#f5a623,stroke:#c17d00
    style AuthGateway fill:#e8e8e8,stroke:#999
    style LLMDRouter fill:#7ed321,stroke:#5a9e18
    style Client fill:#f9f9f9,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#999
