graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User Browser"]
    end

    subgraph Ingress["INGRESS (Google Cloud Run - TLS Termination)"]
        CloudRun["Cloud Run Service: prism<br/>Host: prism.llm-d.ai<br/>443/TCP → 8080/TCP<br/>TLS 1.2+ (Google-managed)<br/>Max 100 instances, concurrency 80"]
    end

    subgraph Application["APPLICATION (Express Backend - BFF)"]
        direction TB

        subgraph AuthLayer["Authorization Layer"]
            RateLimit["Rate Limiter<br/>50,000 req/min per IP"]
            OAuthModule["GitHub OAuth<br/>(read:user scope)"]
            IAMModule["IAM Resolver<br/>(org + GCS allowlists)<br/>Roles: admin / user / none"]
        end

        subgraph APIRoutes["API Surface"]
            GCSProxy["GCS Proxy<br/>/api/gcs/*<br/>Bucket-boundary enforcement"]
            GIQProxy["GIQ Proxy<br/>/api/giq/*<br/>Credential injection"]
            ResultsAPI["Results Store<br/>/api/results<br/>Submission lifecycle"]
            BenchmarkAPIs["Benchmark APIs<br/>/api/prefix-cache<br/>/api/pd-disaggregation<br/>/api/regressions"]
            LocalAPI["Local Files<br/>/api/local/*<br/>Path traversal protection"]
        end
    end

    subgraph GoogleCloud["GOOGLE CLOUD SERVICES"]
        GCS["Google Cloud Storage<br/>storage.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ADC Bearer token"]
        GIQ["GKE Recommender API<br/>gkerecommender.googleapis.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>ADC Bearer token"]
    end

    subgraph AuthServices["AUTHENTICATION SERVICES"]
        GitHubOAuth["GitHub OAuth<br/>github.com<br/>443/TCP HTTPS<br/>Client ID + Secret"]
        GitHubAPI["GitHub API<br/>api.github.com<br/>443/TCP HTTPS<br/>User Bearer token"]
    end

    subgraph ExternalData["EXTERNAL DATA (Client-Side)"]
        S3["AWS S3<br/>*.s3.amazonaws.com<br/>443/TCP HTTPS<br/>Public (no auth)"]
        GDrive["Google Drive/Sheets<br/>googleapis.com<br/>443/TCP HTTPS<br/>Google API Key"]
    end

    %% Ingress flow
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth token (optional)"| CloudRun
    CloudRun -->|"HTTP/8080<br/>Internal (no TLS)"| RateLimit

    %% Auth flows
    RateLimit --> OAuthModule
    OAuthModule --> IAMModule
    IAMModule --> APIRoutes

    %% Backend to Google Cloud
    GCSProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>ADC Bearer"| GCS
    GIQProxy -->|"HTTPS/443<br/>TLS 1.2+<br/>ADC Bearer"| GIQ
    ResultsAPI -->|"HTTPS/443<br/>TLS 1.2+<br/>ADC Bearer"| GCS
    IAMModule -->|"HTTPS/443<br/>reads allowlists"| GCS

    %% Auth service connections
    OAuthModule -->|"HTTPS/443<br/>TLS 1.2+<br/>Client ID + Secret"| GitHubOAuth
    OAuthModule -->|"HTTPS/443<br/>TLS 1.2+<br/>User Bearer"| GitHubAPI

    %% Client-side data (bypasses backend)
    User -.->|"HTTPS/443<br/>Public access"| S3
    User -.->|"HTTPS/443<br/>API Key"| GDrive

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef googlecloud fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef authservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externaldata fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class CloudRun ingress
    class RateLimit,OAuthModule,IAMModule,GCSProxy,GIQProxy,ResultsAPI,BenchmarkAPIs,LocalAPI application
    class GCS,GIQ googlecloud
    class GitHubOAuth,GitHubAPI authservice
    class S3,GDrive externaldata
