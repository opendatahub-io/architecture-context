graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Cluster Admin"]
        User["Batch User /<br/>Data Scientist"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: openshift-kueue-operator<br/>NetworkPolicy: deny-all + selective allow"]
        direction TB

        subgraph OperatorPod["Operator Pod (2 replicas, leader election)"]
            OperatorDeploy["openshift-kueue-operator<br/>SA: openshift-kueue-operator<br/>Priority: system-cluster-critical<br/>FIPS: strictfipsruntime"]
        end

        subgraph OperandPod["Operand Pod (1 replica)"]
            ControllerMgr["kueue-controller-manager<br/>SA: kueue-controller-manager"]
        end

        subgraph Services["Services"]
            WebhookSvc["kueue-webhook-service<br/>ClusterIP 443→9443/TCP<br/>HTTPS TLS (cert-manager)<br/>Fail policy<br/>Scope: opt-in namespaces"]
            MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS mTLS (cert-manager)<br/>Bearer + client cert"]
            VisibilitySvc["visibility-server<br/>ClusterIP 443→8082/TCP<br/>HTTPS TLS"]
            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz"]
        end

        ControllerMgr --- WebhookSvc
        ControllerMgr --- MetricsSvc
        ControllerMgr --- VisibilitySvc
        ControllerMgr --- HealthProbe
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>TLS cert lifecycle<br/>Operator gates on availability"]
        PromOperator["prometheus-operator<br/>ServiceMonitor with mTLS"]
    end

    subgraph EgressTargets["EGRESS TARGETS"]
        DNS["Cluster DNS<br/>53/UDP, 53/TCP<br/>No encryption"]
    end

    %% External flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User credentials"| K8sAPI

    %% API to webhook
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (cert-manager)<br/>K8s admission"| WebhookSvc

    %% Operator flows
    OperatorDeploy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    OperatorDeploy -->|"CRD CRUD<br/>Issuer + Certificate"| CertManager
    OperatorDeploy -->|"deploys"| ControllerMgr

    %% Controller flows
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ControllerMgr -->|"53/UDP,TCP"| DNS

    %% Monitoring
    PromOperator -->|"HTTPS/8443<br/>mTLS (cert-manager)<br/>Bearer + client cert"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Admin,User external
    class K8sAPI controlplane
    class OperatorDeploy,ControllerMgr operator
    class WebhookSvc,MetricsSvc,VisibilitySvc,HealthProbe service
    class CertManager,PromOperator platform
    class DNS egress
