graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph ProxyIngress["PROXY LISTENER (TLS Termination)"]
        Listener["Praxis Proxy Listener<br/>8080/TCP<br/>TLS 1.2+ / 1.3 (configurable)<br/>rustls + OpenSSL Provider"]
        ClientCert["Client Cert Modes:<br/>None / Request / Require /<br/>RequireNamed (SPIFFE)"]
    end

    subgraph FilterPipeline["FILTER PIPELINE (In-Process)"]
        direction TB

        subgraph SecurityFilters["Security Filters"]
            CORS["CORS"]
            CSRF["CSRF"]
            IPACL["IP ACL"]
            BasicAuth["Basic Auth<br/>(htpasswd)"]
            Guardrails["AI Guardrails"]
            Policy["Policy Engine<br/>(PPE)"]
            PeerIdentity["Peer Identity<br/>Trust (mTLS)"]
            CredInjection["Credential<br/>Injection"]
        end

        subgraph TrafficFilters["Traffic Management"]
            Router["Router"]
            LB["Load Balancer"]
            RateLimit["Rate Limit"]
            CircuitBreaker["Circuit Breaker"]
        end

        subgraph TransformFilters["Transformation"]
            HeaderMod["Header Mod"]
            PathRewrite["Path Rewrite"]
            JsonBody["JSON Body<br/>Field Promotion"]
        end
    end

    subgraph UpstreamZone["UPSTREAM (Backend Servers)"]
        Upstream["Upstream Clusters<br/>Configurable Port<br/>HTTP/HTTPS/gRPC<br/>Optional TLS + mTLS"]
    end

    subgraph AdminZone["ADMIN (Internal Only)"]
        Admin["Admin Endpoint<br/>9902/TCP HTTP<br/>Loopback bind<br/>No TLS, No Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Optional)"]
        OTLP["OTLP Collector<br/>gRPC/HTTP<br/>Configurable TLS"]
        Prometheus["Prometheus<br/>Scrapes 9902/TCP<br/>HTTP, No TLS"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8080/TCP<br/>TLS 1.2+/1.3 (configurable)<br/>Auth: mTLS / filter-based"| Listener
    Listener --> ClientCert
    ClientCert --> SecurityFilters
    SecurityFilters --> TrafficFilters
    TrafficFilters --> TransformFilters
    TransformFilters -->|"HTTP/HTTPS<br/>Configurable TLS + mTLS<br/>Bearer / mTLS / None"| Upstream

    Admin -.->|"HTTP 9902/TCP<br/>No encryption<br/>Loopback only"| Prometheus

    Listener -.->|"gRPC/HTTP<br/>Configurable"| OTLP

    %% Reserved header annotation
    Client -.-x|"x-praxis-* headers<br/>REJECTED (400)"| Listener

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef traffic fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef transform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef upstream fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef admin fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extservice fill:#f5f5f5,stroke:#666,stroke-width:1px

    class Client external
    class Listener,ClientCert ingress
    class CORS,CSRF,IPACL,BasicAuth,Guardrails,Policy,PeerIdentity,CredInjection security
    class Router,LB,RateLimit,CircuitBreaker traffic
    class HeaderMod,PathRewrite,JsonBody transform
    class Upstream upstream
    class Admin admin
    class OTLP,Prometheus extservice
