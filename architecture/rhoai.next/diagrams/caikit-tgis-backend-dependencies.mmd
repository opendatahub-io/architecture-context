    %% Infrastructure Dependencies
    CaikitTGIS -->|"endpoint discovery<br/>DNS polling"| DNS["DNS Resolver<br/>53/UDP"]

    %% External Services (TLS)
    CaikitTGIS -.->|"TLS certs<br/>(file paths)"| CertManager["cert-manager<br/><i>or manual provisioning</i>"]

