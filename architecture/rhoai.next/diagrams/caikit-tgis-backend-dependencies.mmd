graph LR
    CaikitTGIS["caikit-tgis-backend<br/><i>Python Library</i>"]

    %% External Dependencies
    CaikitTGIS -->|"BackendBase interface<br/>>=0.16.0,<0.24.0"| Caikit["caikit<br/>Core AI Framework"]
    CaikitTGIS -->|"gRPC channels + TLS<br/>>=1.35.0,<2.0"| gRPCio["grpcio<br/>gRPC Library"]
    CaikitTGIS -->|"HTTP health checks<br/>>=2.28.2,<3"| Requests["requests<br/>HTTP Client"]
    CaikitTGIS -.->|"transitive via caikit"| Alog["alog<br/>Structured Logging"]

    %% Internal Platform Dependencies
    CaikitTGIS -->|"gRPC client<br/>fmaas.GenerationService"| TGIS["TGIS<br/>Text Generation<br/>Inference Service"]
    CaikitTGIS -->|"file I/O<br/>prompt artifacts"| SharedFS["Shared Filesystem<br/>(prompt_dir)"]

    %% Consumers (reverse dependency)
