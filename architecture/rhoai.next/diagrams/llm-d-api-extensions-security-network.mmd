graph TB
    subgraph External["EXTERNAL (llm-d Routing Layer)"]
        Router["llm-d Router/Scheduler<br/>Consumes introspection data<br/>for routing decisions"]
    end

    subgraph VLLMProcess["vLLM INFERENCE SERVER PROCESS"]
        direction TB

        subgraph HTTPLayer["HTTP Layer (Port 8000/TCP)"]
            FastAPI["FastAPI Application<br/>Port: 8000/TCP<br/>TLS/Auth: Inherited from vLLM"]
        end

        subgraph PluginEndpoints["Plugin Endpoints (GET only, read-only)"]
            ConfigEP["/config<br/>Model info, scheduler,<br/>parallelism, KV transfer<br/>Redacts kv_connector_extra_config"]
            DevicesEP["/devices<br/>Per-rank GPU properties<br/>503 without worker extension"]
            KVCacheEP["/kv-cache<br/>Cache capacity, groups<br/>Degrades on older vLLM"]
        end

        subgraph InternalState["Internal State (In-Process)"]
            VllmConfig["VllmConfig<br/>ModelConfig, SchedulerConfig,<br/>CacheConfig, ParallelConfig"]
            EngineClient["EngineClient<br/>collective_rpc"]
            AppState["FastAPI app.state<br/>Cached responses<br/>Compute-once, cache-forever"]
        end

        subgraph WorkerLayer["Worker Processes"]
            Workers["vLLM Workers<br/>DeviceInfoWorkerExtension<br/>current_platform API"]
        end
    end

    %% External flow
    Router -->|"HTTP GET /plugins/llm-d-server-introspection/*<br/>Port 8000/TCP<br/>Auth: Inherited from vLLM"| FastAPI

    %% Internal routing
    FastAPI --> ConfigEP
    FastAPI --> DevicesEP
    FastAPI --> KVCacheEP

    %% Data access (in-process)
    ConfigEP -->|"In-process read"| VllmConfig
    ConfigEP -->|"Read/write cached"| AppState
    DevicesEP -->|"Read cached"| AppState
    KVCacheEP -->|"Read cached"| AppState
    DevicesEP -.->|"Startup only:<br/>collective_rpc"| EngineClient
    KVCacheEP -.->|"Startup only:<br/>get_kv_cache_spec"| EngineClient
    EngineClient -.->|"vLLM internal RPC"| Workers

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef http fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef plugin fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef worker fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Router external
    class FastAPI http
    class ConfigEP,DevicesEP,KVCacheEP plugin
    class VllmConfig,EngineClient,AppState internal
    class Workers worker
