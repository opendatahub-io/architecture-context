graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        KServeGW["KServe Gateway / Route<br/>443/TCP → 8080/8081<br/>TLS 1.2+ termination<br/>Auth: kube-rbac-proxy / platform"]
    end

    subgraph KServePod["KSERVE POD (Trust Boundary)"]
        direction TB

        subgraph Container["MLServer Container (UID 1000, non-root)"]
            direction TB
            RESTServer["REST Server<br/>FastAPI/uvicorn<br/>8080/TCP HTTP<br/>No TLS, No Auth<br/>CORS: restricted (prod)"]
            GRPCServer["gRPC Server<br/>grpc.aio<br/>8081/TCP gRPC/HTTP2<br/>No TLS, No Auth"]
            MetricsServer["Metrics Server<br/>8082/TCP HTTP<br/>GET /metrics<br/>No Auth"]
            DataPlane["DataPlane<br/>Middleware → Cache → Batcher"]
            RuntimeSec["Runtime Security<br/>/etc/mlserver/trusted-runtimes.json<br/>Blocks: custom envs, wildcard CORS"]
        end

        ModelVol["/mnt/models<br/>Model Artifacts<br/>(read-only volume)"]
    end

    subgraph EgressTargets["EGRESS TARGETS"]
        OTel["OpenTelemetry Collector<br/>configurable port<br/>gRPC (OTLP)<br/>No encryption"]
        KafkaBroker["Apache Kafka<br/>9092/TCP<br/>TCP plaintext<br/>No Auth"]
        RemotePredictor["Remote Predictor<br/>(alibi-explain)<br/>HTTP/HTTPS<br/>configurable ssl_verify"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes 8082/TCP"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer / mTLS"| KServeGW
    KServeGW -->|"HTTP/8080<br/>plaintext<br/>auth enforced upstream"| RESTServer
    KServeGW -->|"gRPC/8081<br/>plaintext<br/>auth enforced upstream"| GRPCServer

    %% Internal
    RESTServer --> DataPlane
    GRPCServer --> DataPlane
    DataPlane --> RuntimeSec
    ModelVol -.->|"filesystem read"| DataPlane

    %% Egress
    DataPlane -->|"gRPC OTLP<br/>insecure"| OTel
    DataPlane -->|"TCP/9092<br/>plaintext<br/>(if enabled)"| KafkaBroker
    DataPlane -.->|"HTTP/HTTPS<br/>ssl_verify_path"| RemotePredictor

    %% Observability
    Prometheus -->|"HTTP/8082<br/>scrape"| MetricsServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class KServeGW ingress
    class RESTServer,GRPCServer,MetricsServer,DataPlane container
    class RuntimeSec security
    class ModelVol pod
    class OTel,KafkaBroker,RemotePredictor egress
    class Prometheus observability
