graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph AuthBoundary["SIDECAR PROXY (Auth Boundary)"]
        KRBAC["kube-rbac-proxy<br/>Injected by KServe<br/>443/TCP TLS termination<br/>OAuth/SA token validation"]
    end

    subgraph AppPod["APPLICATION (MLServer Pod)"]
        direction TB

        REST["REST Server<br/>FastAPI + uvicorn<br/>8080/TCP HTTP<br/>No app-level TLS<br/>CORS restricted in prod"]

        GRPC["gRPC Server<br/>grpc.aio<br/>8081/TCP H2C<br/>add_insecure_port<br/>No app-level TLS"]

        MetricsSrv["Metrics Server<br/>uvicorn<br/>8082/TCP HTTP<br/>No auth<br/>Prometheus format"]

        TrustedRT["Trusted Runtimes Allowlist<br/>/etc/mlserver/trusted-runtimes.json<br/>Build-time baked (immutable)<br/>Blocks arbitrary code loading"]

        Models["/mnt/models<br/>KServe volume mount<br/>Read-only artifacts"]
    end

    subgraph Egress["EGRESS (Outbound)"]
        OTLP["OTLP Collector<br/>configurable port<br/>gRPC insecure=True<br/>No auth"]

        Kafka["Kafka Brokers<br/>configurable port<br/>TCP plaintext<br/>No auth"]
    end

    subgraph Observability["OBSERVABILITY (Inbound)"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
    end

    %% External to Auth Boundary
    Client -->|"HTTPS/443<br/>TLS (platform)<br/>Bearer Token<br/>(OAuth/SA)"| KRBAC

    %% Auth Boundary to Application
    KRBAC -->|"HTTP/8080<br/>plaintext (localhost)<br/>token validated"| REST
    KRBAC -->|"gRPC H2C/8081<br/>plaintext (localhost)<br/>token validated"| GRPC

    %% Security controls
    TrustedRT -.->|"validates<br/>model loading"| REST
    TrustedRT -.->|"validates<br/>model loading"| GRPC

    %% Egress flows
    REST -.->|"gRPC<br/>insecure=True<br/>no auth"| OTLP
    GRPC -.->|"gRPC<br/>insecure=True<br/>no auth"| OTLP
    REST -.->|"TCP<br/>plaintext<br/>no auth"| Kafka

    %% Observability
    Prometheus -->|"HTTP/8082<br/>no encryption<br/>no auth"| MetricsSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class KRBAC authboundary
    class REST,GRPC,MetricsSrv,Models app
    class TrustedRT security
    class OTLP,Kafka egress
    class Prometheus observability
