graph LR
    AGN["AGN Operator<br/>(praxis-ai-grid-operator)"]

    %% Internal Platform Dependencies
    AGN -->|"writes routing overlay<br/>ConfigMaps"| PraxisGateway["Praxis AI Gateway"]
    AGN -.->|"optional CA provisioning"| CertManager["cert-manager"]

    %% Core Infrastructure
    AGN -->|"CRD watches, Secrets,<br/>ConfigMaps, Events"| K8sAPI["Kubernetes API<br/>v1.32"]
    AGN -->|"enrollment state"| PostgreSQL["PostgreSQL<br/>(enrollment only)"]

    %% Key Rust Dependencies
    AGN -->|"K8s controller runtime"| Kube["kube 4.2.0"]
    AGN -->|"SWIM membership"| Foca["foca 1.0.0"]
    AGN -->|"gateway framework"| Praxis["praxis-proxy 0.7.3<br/>(Pingora-based)"]
    AGN -->|"MCP client"| RMCP["rmcp 3.1.4"]
    AGN -->|"async runtime"| Tokio["tokio 1.53.1"]
    AGN -->|"HTTP framework"| Axum["axum 0.8.9"]

    %% TLS Dependencies
    AGN -->|"TLS (default)"| Rustls["rustls 0.23<br/>+ ring 0.17"]
    AGN -->|"TLS (FIPS)"| OpenSSL["openssl 0.10"]
    AGN -->|"gossip encryption"| AESGCM["aes-gcm 0.11.1"]
    AGN -->|"cert generation"| Rcgen["rcgen 0.14.9"]

    %% Crypto
    AGN -->|"secret wiping"| Zeroize["zeroize 1.9"]

    %% Integration Points (things that integrate WITH AGN)
    MCPServers["MCP Tool Servers"] -.->|"probed by AGN"| AGN
    PeerOps["Peer Site Operators"] -->|"SWIM gossip +<br/>signal exchange"| AGN
    InferenceBackends["Inference Backends<br/>(llm-d, Bedrock, Vertex,<br/>Anthropic, OpenAI)"] -.->|"routed via gateway"| AGN

    %% Styling
    style AGN fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style PraxisGateway fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333

    style K8sAPI fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333

    style Kube fill:#999,stroke:#333,color:#fff
    style Foca fill:#999,stroke:#333,color:#fff
    style Praxis fill:#999,stroke:#333,color:#fff
    style RMCP fill:#999,stroke:#333,color:#fff
    style Tokio fill:#999,stroke:#333,color:#fff
    style Axum fill:#999,stroke:#333,color:#fff
    style Rustls fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
    style AESGCM fill:#999,stroke:#333,color:#fff
    style Rcgen fill:#999,stroke:#333,color:#fff
    style Zeroize fill:#999,stroke:#333,color:#fff

    style MCPServers fill:#e8e8e8,stroke:#333
    style PeerOps fill:#e87d4a,stroke:#333,color:#fff
    style InferenceBackends fill:#e8e8e8,stroke:#333
