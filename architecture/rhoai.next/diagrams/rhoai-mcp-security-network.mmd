graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Agent["AI Agent<br/>(Claude Code / Codex / OpenCode / Pi)"]
    end

    subgraph Ingress["INGRESS (Edge TLS)"]
        Route["OpenShift Route<br/>443/TCP → 8000/TCP<br/>TLS edge termination"]
    end

    subgraph Application["APPLICATION (rhoai-mcp Pod)<br/>NS: redhat-ods-applications<br/>SA: rhoai-mcp<br/>runAsNonRoot, readOnlyRootFilesystem, drop ALL, seccomp RuntimeDefault"]
        direction TB

        Uvicorn["uvicorn ASGI Server<br/>8000/TCP HTTP"]

        subgraph AuthLayer["Authentication & Authorization"]
            OIDCAuth["OIDCAuthMiddleware<br/>TokenReview or JWT (RS256/ES256)<br/>Fail-closed"]
            RBACFilter["RBAC Checker<br/>SubjectAccessReview<br/>Per-tool visibility filtering"]
        end

        subgraph AppLayer["MCP Application"]
            MCPServer["FastMCP Server<br/>~30 tools, 18 prompts, resources"]
            WorkflowTokens["Workflow Tokens<br/>HMAC-SHA256, TTL-bounded<br/>constant-time comparison"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        ModelRegistry["Model Registry Service<br/>8080/TCP HTTP (direct)<br/>8443/TCP HTTPS (kube-rbac-proxy)"]
        LlmdPlanner["llm-d Planner<br/>8000/TCP HTTP<br/>No auth"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        ModelCatalog["Model Catalog<br/>8443/TCP HTTPS<br/>service-serving CA<br/>SA token auth"]
    end

    %% Network flows
    Agent -->|"HTTPS/443<br/>TLS edge<br/>Bearer (OCP OAuth)"| Route
    Route -->|"HTTP/8000<br/>cluster-internal<br/>Bearer forwarded"| Uvicorn
    Uvicorn --> OIDCAuth
    OIDCAuth --> RBACFilter
    RBACFilter --> MCPServer

    %% Auth flows to K8s API
    OIDCAuth -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>TokenReview"| K8sAPI
    RBACFilter -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>SubjectAccessReview"| K8sAPI

    %% Application flows
    MCPServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Bearer token"| K8sAPI
    MCPServer -->|"HTTP/8080 or HTTPS/8443<br/>None or OAuth"| ModelRegistry
    MCPServer -->|"HTTP/8000<br/>No auth<br/>remote mode only"| LlmdPlanner
    MCPServer -->|"HTTPS/8443<br/>service-serving CA<br/>SA token"| ModelCatalog

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Agent external
    class Route ingress
    class Uvicorn,MCPServer,WorkflowTokens application
    class OIDCAuth,RBACFilter auth
    class K8sAPI,ModelRegistry,LlmdPlanner cluster
    class ModelCatalog externalsvc
