graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Agent["AI Agent<br/>(Claude Desktop / Code / MCP Client)"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP → 8000/TCP<br/>TLS Edge Termination<br/>HAProxy 300s timeout"]
    end

    subgraph Application["APPLICATION (rhoai-mcp namespace)"]
        direction TB

        subgraph MCPPod["rhoai-mcp Pod"]
            OIDCMw["OIDC Auth Middleware<br/>(JWT/TokenReview validation)"]
            MCPServer["rhoai-mcp Server<br/>SA: rhoai-mcp<br/>Transport: SSE / streamable-http<br/>Endpoints: /health, /sse, /mcp"]
            OIDCMw --> MCPServer
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>CRDs: InferenceService,<br/>Notebook, TrainJob, DSPA,<br/>DSC, AcceleratorProfile"]

        ModelReg["Model Registry /<br/>Model Catalog<br/>8080/TCP HTTP (in-cluster)<br/>443/TCP HTTPS (route)<br/>NetworkPolicy: model-catalog"]

        PlannerSvc["Planner Service<br/>8000/TCP HTTP<br/>No Auth (stateless)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OIDCProvider["OIDC Provider<br/>(OpenShift OAuth / Keycloak)<br/>443/TCP HTTPS<br/>TLS 1.2+"]
    end

    %% Flows
    Agent -->|"HTTPS/443<br/>TLS Edge<br/>Bearer Token (OIDC)"| Route
    Agent -.->|"HTTP/8000 (direct)<br/>or stdio<br/>No TLS"| MCPServer

    Route -->|"HTTP/8000<br/>No encryption (in-cluster)<br/>Auth passthrough"| OIDCMw

    MCPServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token +<br/>Impersonate-User/Group"| K8sAPI

    MCPServer -->|"HTTP/8080 (in-cluster)<br/>or HTTPS/443 (route)<br/>OAuth / Bearer"| ModelReg

    MCPServer -->|"HTTP/8000<br/>No encryption<br/>No auth"| PlannerSvc

    OIDCMw -->|"HTTPS/443<br/>TLS 1.2+<br/>JWKS Discovery"| OIDCProvider
    OIDCMw -->|"HTTPS/6443<br/>TokenReview +<br/>SubjectAccessReview"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef clusterservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Agent external
    class Route ingress
    class OIDCMw,MCPServer application
    class K8sAPI,ModelReg,PlannerSvc clusterservice
    class OIDCProvider externalservice
