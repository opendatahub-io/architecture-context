graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / modelmesh-serving<br/>controller"]
    end

    subgraph Pod["MODELMESH POD (Trust boundary: pod-local)"]
        direction TB

        subgraph MMSidecar["mm Container (Java 21)"]
            API["ModelMeshApi<br/>:8033/TCP gRPC<br/>TLS optional<br/>mTLS optional"]
            Probes["Health Probes<br/>:8089/TCP HTTP<br/>No encryption<br/>No auth"]
            Metrics["Metrics Endpoint<br/>:2112/TCP HTTPS<br/>Self-signed TLS<br/>No auth"]
        end

        subgraph RuntimeSidecar["Model Runtime Container"]
            Runtime["Model Runtime<br/>(Triton / MLServer / OVMS)<br/>:8085/TCP or UDS<br/>No encryption, No auth"]
        end
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Pod-to-Pod)"]
        Peer["Peer ModelMesh Pods<br/>:8080/TCP Thrift<br/>TLS optional<br/>mTLS optional"]
    end

    subgraph Infrastructure["INFRASTRUCTURE SERVICES"]
        etcd["etcd<br/>model-mesh-etcd:2379<br/>gRPC, TLS optional<br/>Cert-based auth optional"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus"]
        Kubelet["Kubelet"]
    end

    %% External flows
    Client -->|"gRPC/8033<br/>TLS optional<br/>mTLS optional<br/>(MM_TLS_CLIENT_AUTH)"| API

    %% Internal sidecar flow
    API -->|"gRPC/8085 or UDS<br/>No encryption<br/>Trust by co-location"| Runtime

    %% Cluster coordination
    API -->|"Thrift/8080<br/>litelinks TLS optional<br/>Model forwarding"| Peer

    %% Infrastructure
    API -->|"gRPC/2379<br/>TLS optional<br/>Cert-based auth<br/>Model registry,<br/>leader election"| etcd

    %% Observability
    Prometheus -->|"HTTPS/2112<br/>Self-signed TLS<br/>Scrape /metrics"| Metrics
    Kubelet -->|"HTTP/8089<br/>No encryption<br/>/ready, /live"| Probes

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef runtime fill:#d1fae5,stroke:#10b981,stroke-width:2px
    classDef cluster fill:#fce7f3,stroke:#ec4899,stroke-width:2px
    classDef infra fill:#fff7ed,stroke:#f97316,stroke-width:2px
    classDef observability fill:#f3f4f6,stroke:#6b7280,stroke-width:2px

    class Client external
    class API,Probes,Metrics pod
    class Runtime runtime
    class Peer cluster
    class etcd infra
    class Prometheus,Kubelet observability
