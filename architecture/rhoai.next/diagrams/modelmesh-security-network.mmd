graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(Inference / Management)"]
    end

    subgraph K8sService["KUBERNETES SERVICE (Internal)"]
        HeadlessSvc["model-mesh Service<br/>ClusterIP: None (Headless)<br/>8033/TCP"]
    end

    subgraph Pod["MODELMESH POD (ServingRuntime)"]
        direction TB

        subgraph MMSidecar["ModelMesh Sidecar Container"]
            GrpcAPI["ModelMesh gRPC API<br/>8033/TCP gRPC<br/>TLS (optional)<br/>No app-level auth"]
            ThriftRPC["LiteLinks Thrift<br/>8080/TCP Thrift<br/>TLS (configurable)<br/>mTLS (optional)"]
            MetricsSrv["Prometheus Metrics<br/>2112/TCP HTTPS<br/>TLS (self-signed, BouncyCastle)<br/>No auth (NetworkPolicy)"]
            HealthSrv["Health Probes<br/>8089/TCP HTTP<br/>No encryption<br/>/ready /live"]
            RuntimeCli["ModelRuntime Client<br/>8085/TCP or UDS<br/>gRPC plaintext"]
        end

        subgraph RuntimeContainer["Co-Located Runtime Container"]
            ModelRT["Model Runtime<br/>(Triton/MLServer/Custom)<br/>8085/TCP or UDS<br/>gRPC plaintext"]
        end
    end

    subgraph PeerPods["PEER MODELMESH INSTANCES"]
        PeerA["Peer ModelMesh A<br/>8080/TCP Thrift<br/>TLS/mTLS (optional)"]
        PeerB["Peer ModelMesh B<br/>8080/TCP Thrift<br/>TLS/mTLS (optional)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        etcd["etcd Cluster<br/>2379/TCP gRPC<br/>TLS (optional)<br/>Client cert (optional)<br/>Secret: model-mesh-icd-etcd"]
        ZK["ZooKeeper (legacy)<br/>2181/TCP Custom<br/>TLS (optional)"]
        PayloadProc["Remote Payload Processor<br/>configurable/TCP<br/>HTTP/HTTPS TLS (optional)"]
        StatsD["StatsD Server<br/>8126/UDP<br/>No encryption"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus Scraper"]
        Kubelet["Kubernetes Kubelet"]
    end

    %% External flows
    Client -->|"gRPC/8033<br/>TLS (optional)<br/>No app auth"| HeadlessSvc
    HeadlessSvc -->|"8033/TCP"| GrpcAPI

    %% Sidecar to runtime
    RuntimeCli -->|"gRPC/8085 or UDS<br/>plaintext<br/>localhost"| ModelRT

    %% Inter-instance
    ThriftRPC -->|"Thrift/8080<br/>TLS (configurable)<br/>mTLS (optional)"| PeerA
    ThriftRPC -->|"Thrift/8080<br/>TLS (configurable)<br/>mTLS (optional)"| PeerB

    %% External service connections
    GrpcAPI -->|"gRPC/2379<br/>TLS (optional)<br/>Client cert (optional)"| etcd
    GrpcAPI -.->|"Custom/2181<br/>TLS (optional)"| ZK
    GrpcAPI -.->|"HTTP(S)<br/>TLS (optional)"| PayloadProc
    GrpcAPI -.->|"UDP/8126<br/>No encryption"| StatsD

    %% Monitoring
    Prometheus -->|"HTTPS/2112<br/>TLS (self-signed)"| MetricsSrv
    Kubelet -->|"HTTP/8089<br/>No encryption"| HealthSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8ssvc fill:#e6f2ff,stroke:#4a90e2,stroke-width:2px
    classDef sidecar fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#56a34a,stroke-width:2px
    classDef peer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class HeadlessSvc k8ssvc
    class GrpcAPI,ThriftRPC,MetricsSrv,HealthSrv,RuntimeCli sidecar
    class ModelRT runtime
    class PeerA,PeerB peer
    class etcd,ZK,PayloadProc,StatsD extsvc
    class Prometheus,Kubelet monitoring
