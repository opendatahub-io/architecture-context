graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PodBoundary["MODELMESH POD (Trust Boundary)"]
        direction TB

        subgraph ModelMeshSidecar["ModelMesh Sidecar (Java 21)"]
            direction TB
            API["ModelMeshApi<br/>gRPC Server<br/>8033/TCP<br/>Optional TLS/mTLS<br/>FIPS: DISABLED"]
            Cache["SidecarModelMesh<br/>LRU Cache Engine<br/>ProtoSplicer zero-copy"]
            VModel["VModelManager<br/>etcd-backed state"]
            HealthProbe["Health Probes<br/>8089/TCP HTTP<br/>No Auth"]
            MetricsServer["Prometheus NettyServer<br/>2112/TCP HTTPS<br/>Self-signed TLS<br/>BouncyCastle"]
            PreStopServer["PreStop Server<br/>8090/TCP HTTP<br/>No Auth"]
            LitelinksRPC["Litelinks Thrift RPC<br/>8080/TCP<br/>Optional TLS/mTLS"]
        end

        Runtime["Model Runtime Container<br/>(mlserver / Triton / custom)<br/>8085/TCP or UDS<br/>gRPC Plaintext"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        Kubelet["Kubernetes Kubelet"]
        Prometheus["Prometheus Scraper"]
        Controller["modelmesh-serving Controller<br/>(ConfigMap interaction only)"]
    end

    subgraph PeerPods["PEER MODELMESH PODS"]
        PeerMM["Peer ModelMesh Pod<br/>8080/TCP Thrift"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        etcd["etcd Cluster<br/>2379/TCP<br/>gRPC (etcd v3)<br/>Optional TLS<br/>Optional client cert"]
    end

    %% External → Pod flows
    Client -->|"gRPC/8033<br/>Optional TLS<br/>Optional mTLS<br/>(MM_TLS_CLIENT_AUTH)"| API

    %% Internal pod flows
    API --> Cache
    Cache --> VModel
    Cache -->|"gRPC/8085 Plaintext<br/>or UDS (localhost)<br/>No Auth"| Runtime

    %% Inter-pod flows
    LitelinksRPC -->|"Thrift/8080<br/>Optional TLS<br/>Optional mTLS<br/>(MM_INTRACLUSTER_CLIENTAUTH)"| PeerMM

    %% Cluster service flows
    Kubelet -->|"HTTP/8089<br/>No Encryption<br/>No Auth"| HealthProbe
    Prometheus -->|"HTTPS/2112<br/>Self-signed TLS<br/>No Client Auth"| MetricsServer

    %% External service flows
    Cache -->|"gRPC/2379<br/>Optional TLS<br/>Optional client cert"| etcd

    %% Controller (no network, ConfigMap only)
    Controller -.->|"ConfigMap<br/>model-serving-config<br/>(no direct network)"| PodBoundary

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef sidecar fill:#4a90e2,stroke:#333,stroke-width:1px,color:#fff
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef peer fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef warning fill:#f8d7da,stroke:#dc3545,stroke-width:2px

    class Client external
    class API,Cache,VModel,HealthProbe,MetricsServer,PreStopServer,LitelinksRPC sidecar
    class Runtime runtime
    class Kubelet,Prometheus,Controller cluster
    class etcd extsvc
    class PeerMM peer
