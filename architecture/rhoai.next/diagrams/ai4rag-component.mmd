graph TB
    subgraph "ai4rag Core Library"
        direction TB
        subgraph "Optimization Engine (ai4rag.core)"
            Experiment["Experiment Orchestrator<br/>(GAM Optimizer + Warm-Start)"]
            Fingerprint["Collection Reuse<br/>(Indexing Parameter Fingerprint)"]
            Evaluator["Evaluators<br/>(unitxt / RAGAS / LLM-as-Judge)"]
            Experiment --> Fingerprint
            Experiment --> Evaluator
        end

        subgraph "RAG Backend (ai4rag.rag)"
            AgenticRAG["AgenticRAG Template<br/>(Multi-turn + Query Rewriting)"]
            SimpleRAG["SimpleRAG Template<br/>(Single-pass Retrieve-Generate)"]
            Chunking["Chunking Strategies<br/>(Docling / RecursiveCharacter)"]
        end

        subgraph "Vector Store Backends"
            MilvusStore["MilvusVectorStore<br/>(Server-side BM25 Fusion)"]
            MilvusLite["Milvus Lite<br/>(Embedded, Local File)"]
            PGVectorStore["PGVectorStore<br/>(asyncpg + In-Memory RRF)"]
            Neo4jStore["Neo4jGraphStore<br/>(KG Extraction + VectorCypher)"]
        end

        subgraph "Network Safety"
            SafeURL["ensure_safe_url<br/>(HTTPS Enforcement)"]
        end

        subgraph "Artifact Generation (ai4rag.assets_generator)"
            StarterKit["Starter Kit Generator<br/>(ZIP Archive)"]
            Notebook["Jupyter Notebook Generator"]
            Leaderboard["Pattern Leaderboard"]
        end

        Experiment --> AgenticRAG
        Experiment --> SimpleRAG
        AgenticRAG --> MilvusStore
        AgenticRAG --> PGVectorStore
        AgenticRAG --> Neo4jStore
        SimpleRAG --> MilvusStore
        SimpleRAG --> PGVectorStore
        SimpleRAG --> Neo4jStore
        MilvusStore --> SafeURL
        PGVectorStore --> SafeURL
        Neo4jStore --> SafeURL
    end

    subgraph "Generated Starter Kit"
        FastAPI["FastAPI Service<br/>(OpenAI Responses API)"]
        AuthWrapper["auth_wrapper<br/>(K8s TokenReview Middleware)"]
        FastAPI --> AuthWrapper
    end

    StarterKit -->|generates| FastAPI

    User["Data Scientist"] -->|runs optimization| Experiment
    User -->|deploys| FastAPI

    MaaS["MaaS<br/>(OpenAI-Compatible Endpoint)"]
    S3["S3-Compatible Storage"]
    K8sAPI["Kubernetes API"]

    Experiment -->|inference + embeddings| MaaS
    Evaluator -->|LLM-as-Judge| MaaS
    Chunking -->|document extraction| S3
    FastAPI -->|inference| MaaS
    AuthWrapper -->|TokenReview| K8sAPI

    style Experiment fill:#4a90e2,color:#fff
    style SafeURL fill:#e74c3c,color:#fff
    style FastAPI fill:#4a90e2,color:#fff
    style AuthWrapper fill:#f5a623,color:#000
    style MaaS fill:#e8e8e8,stroke:#999
    style S3 fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#e8e8e8,stroke:#999
    style MilvusStore fill:#7ed321,color:#000
    style PGVectorStore fill:#7ed321,color:#000
    style Neo4jStore fill:#7ed321,color:#000
    style MilvusLite fill:#b8e986,color:#000
