graph TB
    subgraph AI4RAG["ai4rag Library"]
        direction TB

        subgraph Core["core/"]
            Experiment["AI4RAGExperiment<br/>Experiment Orchestrator"]
            HPO["HPO Engine<br/>(GAM Bayesian / Random)"]
            MPS["Model Pre-Selection<br/>(efficient model narrowing)"]
            Results["ExperimentResults<br/>(caching & aggregation)"]
            Experiment -->|"optimization loop"| HPO
            Experiment -->|"pre-selection phase"| MPS
            Experiment -->|"stores results"| Results
        end

        subgraph RAG["rag/"]
            direction TB
            Chunking["Chunking<br/>DoclingChunker / LangChainChunker"]
            Embedding["Embedding<br/>OGXEmbeddingModel"]
            VectorStore["Vector Store<br/>OGXVectorStore / ChromaVectorStore"]
            Retriever["Retriever<br/>(similarity / hybrid search)"]
            SimpleRAG["SimpleRAG Template<br/>(context + generation)"]
            Chunking -->|"chunks"| Embedding
            Embedding -->|"vectors"| VectorStore
            VectorStore -->|"search results"| Retriever
            Retriever -->|"context"| SimpleRAG
        end

        subgraph Eval["evaluator/"]
            UnitxtEval["UnitxtEvaluator<br/>(answer_correctness,<br/>faithfulness,<br/>context_correctness)"]
            LLMaJEval["LLMaJEvaluator<br/>(LLM-as-a-Judge<br/>rubric scoring)"]
        end

        subgraph SearchSpace["search_space/"]
            SSConfig["AI4RAGSearchSpace<br/>(constraints & rules)"]
            LangDetect["Language Detection<br/>(structured LLM output)"]
            SSConfig -->|"detects language"| LangDetect
        end

        subgraph Utils["utils/"]
            EventHandler["EventHandler<br/>(Local / KFP)"]
            Constants["Constants & Validators"]
        end

        Experiment -->|"builds pipeline"| RAG
        Experiment -->|"evaluates"| Eval
        Experiment -->|"samples params"| SSConfig
        Experiment -->|"emits events"| EventHandler
        SimpleRAG -->|"answers"| UnitxtEval
        SimpleRAG -->|"answers"| LLMaJEval
    end

    User["User / KFP Component"] -->|"documents +<br/>benchmark data"| Experiment
    EventHandler -->|"results"| KFP["Kubeflow Pipelines"]

    Experiment -->|"inference & embeddings"| OGX["OGX Server<br/>(REST API)"]
    Embedding -->|"embeddings.create"| OGX
    VectorStore -->|"vector_io CRUD"| OGX
    SimpleRAG -->|"chat.completions"| OGX
    LLMaJEval -->|"judge scoring"| OGX

    Experiment -->|"document persistence"| S3["S3-compatible Storage"]

    style AI4RAG fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Core fill:#dceefb,stroke:#4a90e2
    style RAG fill:#dceefb,stroke:#4a90e2
    style Eval fill:#dceefb,stroke:#4a90e2
    style SearchSpace fill:#dceefb,stroke:#4a90e2
    style Utils fill:#dceefb,stroke:#4a90e2
    style Experiment fill:#4a90e2,color:#fff
    style HPO fill:#4a90e2,color:#fff
    style MPS fill:#4a90e2,color:#fff
    style SimpleRAG fill:#4a90e2,color:#fff
    style OGX fill:#f5a623,color:#fff
    style S3 fill:#f5a623,color:#fff
    style KFP fill:#7ed321,color:#fff
    style User fill:#e8e8e8,stroke:#333
