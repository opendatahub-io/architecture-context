graph TB
    subgraph AI4RAG["ai4rag Library"]
        direction TB

        subgraph Core["ai4rag.core"]
            Experiment["Experiment Engine<br/>(AI4RAGExperiment)"]
            Results["Results Collector"]
            subgraph HPO["ai4rag.core.hpo"]
                GAMOpt["GAM Optimizer<br/>(LinearGAM)"]
                RandomOpt["Random Optimizer"]
            end
            Experiment -->|selects configs via| GAMOpt
            Experiment -->|fallback| RandomOpt
            Experiment -->|collects| Results
        end

        subgraph RAG["ai4rag.rag"]
            subgraph Chunking["Chunking"]
                LangChainChunker["LangChain<br/>RecursiveCharacterTextSplitter"]
                DoclingChunker["Docling<br/>HybridChunker"]
            end
            subgraph Embedding["Embedding"]
                OGXEmbed["OGX Embedding Model"]
            end
            subgraph VectorStore["Vector Stores"]
                OGXVectorStore["OGX Vector Store<br/>(Milvus/Qdrant)"]
                ChromaVS["ChromaDB<br/>(in-memory)"]
            end
            subgraph FM["Foundation Models"]
                OGXFM["OGX Foundation Model"]
            end
            subgraph Templates["RAG Templates"]
                SimpleRAG["SimpleRAGTemplate"]
            end
            Retriever["Retriever"]
        end

        subgraph Evaluator["ai4rag.evaluator"]
            UnitxtEval["Unitxt Evaluator<br/>(correctness, faithfulness)"]
            LLMaJEval["LLM-as-a-Judge<br/>(answer relevance)"]
            JudgeSelect["Judge Model Selector"]
            LLMaJEval -->|selects judge via| JudgeSelect
        end

        subgraph SearchSpace["ai4rag.search_space"]
            SSDefinition["Search Space Definition"]
            SSPrepare["Search Space Preparation<br/>(OGX model discovery)"]
            Constraints["Constraint Validation"]
            SSPrepare -->|validates| Constraints
        end

        subgraph Components["ai4rag.components (KFP)"]
            DocDiscovery["Document Discovery<br/>(S3 listing)"]
            TextExtract["Text Extraction<br/>(Docling)"]
            DocIndexing["Document Indexing"]
            RAGOptComp["RAG Optimization"]
            AssetGen["Asset Generation<br/>(pattern JSON, notebooks)"]
        end

        %% Core orchestration flows
        Experiment -->|chunks docs via| Chunking
        Experiment -->|embeds via| Embedding
        Experiment -->|stores in| VectorStore
        Experiment -->|retrieves via| Retriever
        Experiment -->|generates via| FM
        Experiment -->|applies| SimpleRAG
        Experiment -->|evaluates via| UnitxtEval
        Experiment -->|evaluates via| LLMaJEval
        Experiment -->|explores| SSDefinition
    end

    %% External systems
    User["User / KFP Pipeline"] -->|configures & runs| Experiment
    User -->|triggers| Components

    OGXEmbed -->|HTTPS/443| OGXServer["OGX Server"]
    OGXVectorStore -->|HTTPS/443| OGXServer
    OGXFM -->|HTTPS/443| OGXServer
    SSPrepare -->|discovers models via| OGXServer
    JudgeSelect -->|evaluates judges via| OGXServer

    DocDiscovery -->|HTTPS/443| S3["S3 Storage"]

    %% Styling
    style AI4RAG fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Core fill:#d5e8d4,stroke:#82b366
    style RAG fill:#fff2cc,stroke:#d6b656
    style Evaluator fill:#f8cecc,stroke:#b85450
    style SearchSpace fill:#e1d5e7,stroke:#9673a6
    style Components fill:#dae8fc,stroke:#6c8ebf
    style OGXServer fill:#999,stroke:#333,stroke-width:2px
    style S3 fill:#999,stroke:#333,stroke-width:2px
    style User fill:#f5f5f5,stroke:#666
    style Experiment fill:#4a90e2,color:#fff
