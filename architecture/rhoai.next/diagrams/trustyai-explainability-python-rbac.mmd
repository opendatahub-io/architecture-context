graph TD
    subgraph "Client Identity"
        User["Data Scientist / ML Engineer<br/>(Notebook User)"]
    end

    subgraph "Authentication"
        BearerToken["Bearer Token<br/>(OpenShift OAuth)"]
        Kubeconfig["kubeconfig / In-Cluster<br/>ServiceAccount Token"]
    end

    subgraph "Required Permissions (Optional API Client)"
        RouteRead["route.openshift.io/v1<br/>Routes<br/>Verbs: get, list"]
    end

    subgraph "External Service Authorization"
        TrustyAIAuth["TrustyAI Service<br/>Authorization: Bearer header<br/>Methods: GET, POST"]
        ThanosAuth["Thanos Querier<br/>Authorization: Bearer header<br/>Methods: GET"]
        ModelAuth["Model Endpoints<br/>Authorization: Bearer header<br/>Methods: POST"]
    end

    subgraph "Notes"
        Note1["Library defines NO RBAC resources<br/>(no ClusterRoles, no RoleBindings)"]
        Note2["All auth is caller responsibility<br/>Token passed as constructor param"]
    end

    User -->|"provides"| BearerToken
    User -->|"provides"| Kubeconfig

    Kubeconfig -->|"used for route discovery"| RouteRead
    BearerToken -->|"passed to"| TrustyAIAuth
    BearerToken -->|"passed to"| ThanosAuth
    BearerToken -->|"passed to"| ModelAuth

    style User fill:#4a90e2,color:#fff
    style BearerToken fill:#f5a623
    style Kubeconfig fill:#f5a623
    style RouteRead fill:#7ed321
    style TrustyAIAuth fill:#e8e8e8,stroke:#666
    style ThanosAuth fill:#e8e8e8,stroke:#666
    style ModelAuth fill:#e8e8e8,stroke:#666
    style Note1 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style Note2 fill:#fff,stroke:#999,stroke-dasharray: 5 5
