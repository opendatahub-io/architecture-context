graph TD
    subgraph LibraryContext["trustyai-explainability-python (Client Library)"]
        Note["This library does NOT define RBAC resources.<br/>It operates under the caller's identity and permissions."]
    end

    subgraph CallerIdentity["Caller Identity"]
        User["Data Scientist / ML Engineer"]
        SA["Service Account<br/>(if running in-cluster)"]
        Kubeconfig["kubeconfig<br/>(if running locally)"]
    end

    subgraph RequiredPermissions["Required Permissions (when using [api] extra)"]
        direction TB

        subgraph RouteAccess["Route Read Access"]
            RouteAPI["API Group: route.openshift.io/v1<br/>Resources: routes<br/>Verbs: get, list"]
        end

        subgraph TokenAuth["Bearer Token Auth (External to K8s RBAC)"]
            TrustyAIAuth["TrustyAI Service Access<br/>Method: Authorization: Bearer header<br/>Scope: Data upload, metric queries"]
            ThanosAuth["Thanos Querier Access<br/>Method: Authorization: Bearer header<br/>Scope: PromQL queries"]
            ModelAuth["Model Endpoint Access<br/>Method: Authorization: Bearer header<br/>Scope: Inference requests"]
        end
    end

    subgraph NoRBACNeeded["No RBAC Required (Core Library)"]
        LocalOps["Local Explainability Operations<br/>(LIME, SHAP, Counterfactual, PDP)<br/>No Kubernetes API access needed"]
        FairnessOps["Local Fairness Metrics<br/>(SPD, DIR, AOD, APVD)<br/>No Kubernetes API access needed"]
        VizOps["Visualization & Dashboard<br/>(Matplotlib, Bokeh, Tyrus)<br/>No Kubernetes API access needed"]
    end

    %% Flows
    User -->|"provides"| Kubeconfig
    SA -->|"provides"| Kubeconfig
    Kubeconfig -->|"authenticates to"| RouteAPI

    User -->|"provides Bearer token"| TrustyAIAuth
    User -->|"provides Bearer token"| ThanosAuth
    User -->|"provides Bearer token"| ModelAuth

    User -->|"uses directly<br/>(no auth needed)"| LocalOps
    User -->|"uses directly<br/>(no auth needed)"| FairnessOps
    User -->|"uses directly<br/>(no auth needed)"| VizOps

    %% Styling
    style Note fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style User fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Kubeconfig fill:#4a90e2,stroke:#333,color:#fff
    style RouteAPI fill:#f5a623,stroke:#333,color:#fff
    style TrustyAIAuth fill:#f5a623,stroke:#333,color:#fff
    style ThanosAuth fill:#f5a623,stroke:#333,color:#fff
    style ModelAuth fill:#f5a623,stroke:#333,color:#fff
    style LocalOps fill:#7ed321,stroke:#333,color:#fff
    style FairnessOps fill:#7ed321,stroke:#333,color:#fff
    style VizOps fill:#7ed321,stroke:#333,color:#fff
