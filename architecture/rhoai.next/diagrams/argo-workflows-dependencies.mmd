graph LR
    ArgoWF["Argo Workflows<br/>(workflow-controller + argoexec)"]

    %% External Dependencies (Required)
    ArgoWF -->|"CRD watches, Pod CRUD<br/>443/TCP HTTPS"| K8s["Kubernetes 1.32+"]

    %% External Dependencies (Optional)
    ArgoWF -.->|"artifact storage<br/>443/TCP HTTPS"| S3["S3-compatible Storage<br/>(MinIO / AWS S3)"]
    ArgoWF -.->|"artifact storage<br/>443/TCP HTTPS"| GCS["Google Cloud Storage"]
    ArgoWF -.->|"artifact storage<br/>443/TCP HTTPS"| AzureBlob["Azure Blob Storage"]
    ArgoWF -.->|"workflow archiving<br/>5432/TCP SSL"| PostgreSQL["PostgreSQL"]
    ArgoWF -.->|"workflow archiving<br/>3306/TCP"| MySQL["MySQL"]
    ArgoWF -.->|"SSO auth (argo-server)<br/>443/TCP HTTPS"| OIDC["OIDC Provider"]

    %% Internal RHOAI Dependencies
    DSPOperator["Data Science Pipelines<br/>Operator"] -->|"deploys & configures"| ArgoWF
    KFPApiServer["Kubeflow Pipeline<br/>API Server"] -->|"creates Workflow CRDs"| ArgoWF

    %% Integration Points (inbound)
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>9090/TCP HTTP"| ArgoWF

    %% Integration Points (optional, not in RHOAI)
    ArgoEvents["Argo Events<br/>(EventSource, Sensor)"] -.->|"event-driven triggers<br/>443/TCP HTTPS"| ArgoWF
    Webhooks["GitHub / GitLab /<br/>Bitbucket"] -.->|"webhook events<br/>2746/TCP HTTPS"| ArgoWF
    HDFS["HDFS"] -.->|"artifact storage<br/>8020/TCP RPC"| ArgoWF

    %% Styling
    style ArgoWF fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style K8s fill:#326ce5,stroke:#333,color:#fff

    %% Optional external
    style S3 fill:#999,stroke:#333,color:#fff
    style GCS fill:#999,stroke:#333,color:#fff
    style AzureBlob fill:#999,stroke:#333,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style MySQL fill:#999,stroke:#333,color:#fff
    style OIDC fill:#999,stroke:#333,color:#fff
    style HDFS fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI
    style DSPOperator fill:#7ed321,stroke:#333,color:#fff
    style KFPApiServer fill:#7ed321,stroke:#333,color:#fff

    %% Monitoring
    style Prometheus fill:#e6522c,stroke:#333,color:#fff

    %% Optional integrations
    style ArgoEvents fill:#ccc,stroke:#333,color:#333
    style Webhooks fill:#ccc,stroke:#333,color:#333
