graph LR
    ArgoWF["Argo Workflows<br/>Workflow Engine"]

    %% External Dependencies (Required)
    ArgoWF -->|"CRD hosting, Pod execution<br/>RBAC, leader election"| K8s["Kubernetes 1.32+"]

    %% External Dependencies (Optional)
    ArgoWF -.->|"workflow archival<br/>node status offloading"| PostgreSQL["PostgreSQL<br/>(optional)"]
    ArgoWF -.->|"alternative persistence"| MySQL["MySQL<br/>(optional)"]
    ArgoWF -.->|"artifact repository"| S3["S3-compatible Storage<br/>MinIO / AWS S3 / GCS / Azure"]
    ArgoWF -.->|"SSO authentication"| OIDC["OIDC Provider<br/>Dex / Keycloak<br/>(optional)"]

    %% Internal RHOAI Dependencies
    DSPOperator["Data Science Pipelines<br/>Operator"] -->|"deploys &<br/>configures"| ArgoWF
    DSPAPI["Data Science Pipelines<br/>API Server"] -->|"submits Workflow CRDs"| ArgoWF

    %% Infrastructure Dependencies
    ArgoWF -->|"image entrypoint lookup"| ContainerReg["Container Registry"]
    ArgoWF -->|"artifact upload/download"| ArtifactStore["Artifact Storage<br/>(S3/GCS/Azure/HDFS/OSS)"]

    %% External Integration Points
    GitProviders["Git Providers<br/>GitHub / GitLab / Bitbucket"] -->|"webhook events<br/>HMAC-SHA256"| ArgoWF

    %% Styling
    style ArgoWF fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style MySQL fill:#999,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style OIDC fill:#999,stroke:#333,color:#fff
    style DSPOperator fill:#7ed321,stroke:#333,color:#fff
    style DSPAPI fill:#7ed321,stroke:#333,color:#fff
    style ContainerReg fill:#f5a623,stroke:#333
    style ArtifactStore fill:#f5a623,stroke:#333
    style GitProviders fill:#f5a623,stroke:#333
