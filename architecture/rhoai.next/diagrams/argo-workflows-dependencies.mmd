graph LR
    ArgoWorkflows["Argo Workflows<br/>(workflow-controller + argoexec)"]

    %% Internal RHOAI Dependencies
    ArgoWorkflows -->|"deployed by"| DSPOperator["Data Science Pipelines<br/>Operator"]

    %% Core Infrastructure Dependencies
    ArgoWorkflows -->|"CR reconciliation<br/>pod management<br/>leader election"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    ArgoWorkflows -->|"artifact storage"| S3["S3/MinIO<br/>443/TCP HTTPS"]
    ArgoWorkflows -->|"artifact storage"| GCS["Google Cloud Storage<br/>443/TCP HTTPS"]
    ArgoWorkflows -->|"artifact storage"| AzureBlob["Azure Blob Storage<br/>443/TCP HTTPS"]
    ArgoWorkflows -->|"artifact storage"| AliOSS["Alibaba OSS<br/>443/TCP HTTPS"]
    ArgoWorkflows -->|"artifact storage"| HDFS["HDFS"]

    %% Optional Dependencies
    ArgoWorkflows -.->|"workflow archival<br/>(optional)"| MySQL["MySQL<br/>3306/TCP"]
    ArgoWorkflows -.->|"workflow archival<br/>(optional)"| PostgreSQL["PostgreSQL<br/>5432/TCP"]

    %% Argo Server Dependencies
    ArgoServer["argo-server<br/>(optional)"]
    ArgoServer -.->|"SSO auth"| OIDC["OIDC Provider<br/>443/TCP HTTPS"]
    ArgoServer -.->|"event proxy"| ArgoEvents["Argo Events"]

    %% Build Dependencies
    ArgoWorkflows -->|"Go 1.26<br/>GOFIPS140=v1.0.0"| GoToolchain["Go 1.26 Toolchain"]
    ArgoWorkflows -->|"base image"| UBI["UBI 9 Minimal PQC<br/>Post-Quantum Crypto"]

    %% Key Library Dependencies
    subgraph KeyLibraries["Key Go Libraries"]
        ClientGo["k8s.io/client-go v0.32.2"]
        GRPC["google.golang.org/grpc v1.71.1"]
        GRPCGateway["grpc-gateway v1.16.0"]
        MinioSDK["minio-go/v7 v7.0.89"]
        UpperDB["upper/db v4.7.0"]
        Prometheus["prometheus/client_golang v1.21.1"]
        OTel["opentelemetry v1.34.0"]
        GoOIDC["go-oidc/v3 v3.9.0"]
    end

    ArgoWorkflows -->|"uses"| KeyLibraries

    %% Styling
    style ArgoWorkflows fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ArgoServer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style DSPOperator fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style S3 fill:#999,stroke:#333,color:#fff
    style GCS fill:#999,stroke:#333,color:#fff
    style AzureBlob fill:#999,stroke:#333,color:#fff
    style AliOSS fill:#999,stroke:#333,color:#fff
    style HDFS fill:#999,stroke:#333,color:#fff
    style MySQL fill:#999,stroke:#333,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style OIDC fill:#999,stroke:#333,color:#fff
    style ArgoEvents fill:#999,stroke:#333,color:#fff
