graph TD
    subgraph PodSecurity["Pod-Level Security (No K8s RBAC)"]
        direction TB

        Note["This component is a sidecar container<br/>with NO Kubernetes API access.<br/>It has no ClusterRoles, Roles, or RoleBindings.<br/>Security is enforced at the pod boundary."]

        subgraph AuthMechanisms["Authentication Mechanisms"]
            direction LR
            InternalAuth["Internal (Pod-Local)<br/>No authentication<br/>Relies on pod network isolation<br/>Plaintext gRPC/HTTP on localhost"]
            ExternalAuth["External (Cloud Storage)<br/>Per-provider authentication<br/>Credentials from storage-config Secret"]
        end

        subgraph StorageCredentials["Storage Credential Types"]
            direction TB
            S3Creds["S3 / IBM COS<br/>access_key_id<br/>secret_access_key<br/>endpoint_url, region, bucket"]
            GCSCreds["Google Cloud Storage<br/>private_key<br/>client_email<br/>project_id, bucket"]
            AzureCreds["Azure Blob Storage<br/>connection_string<br/>OR client_id + client_secret<br/>+ tenant_id"]
            HTTPCreds["HTTP(S) Repositories<br/>Custom HTTP headers<br/>Optional: certificate (CA)<br/>Optional: client_certificate + client_key (mTLS)"]
        end

        subgraph SecretMount["Kubernetes Secret"]
            StorageConfig["storage-config (Opaque)<br/>Mounted at: /storage-config/<br/>Provisioned by: User / ModelMesh controller<br/>Auto-Rotation: No"]
        end

        subgraph EndpointSecurity["Endpoint Security Matrix"]
            direction TB
            PullerEndpoint["puller gRPC (8084/TCP)<br/>Auth: None<br/>Enforcement: Pod network isolation<br/>Methods: LoadModel, UnloadModel, RuntimeStatus"]
            AdapterEndpoint["adapter gRPC (8085/TCP)<br/>Auth: None<br/>Enforcement: Pod network isolation<br/>Methods: LoadModel, UnloadModel, RuntimeStatus,<br/>PredictModelSize, ModelSize"]
        end

        subgraph FIPSCompliance["FIPS Compliance"]
            FIPS["Build: GOEXPERIMENT=strictfipsruntime<br/>CGO_ENABLED=1<br/>Go crypto: crypto/tls, crypto/x509<br/>Python: System OpenSSL (UBI 9)<br/>No non-FIPS crypto detected"]
        end
    end

    StorageConfig -->|"provides credentials"| S3Creds
    StorageConfig -->|"provides credentials"| GCSCreds
    StorageConfig -->|"provides credentials"| AzureCreds
    StorageConfig -->|"provides credentials"| HTTPCreds

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style InternalAuth fill:#d4edda,stroke:#28a745
    style ExternalAuth fill:#cce5ff,stroke:#004085
    style S3Creds fill:#f8d7da,stroke:#721c24
    style GCSCreds fill:#f8d7da,stroke:#721c24
    style AzureCreds fill:#f8d7da,stroke:#721c24
    style HTTPCreds fill:#f8d7da,stroke:#721c24
    style StorageConfig fill:#e74c3c,stroke:#333,color:#fff
    style PullerEndpoint fill:#d4edda,stroke:#28a745
    style AdapterEndpoint fill:#d4edda,stroke:#28a745
    style FIPS fill:#d1ecf1,stroke:#0c5460
