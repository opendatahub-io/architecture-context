graph TD
    subgraph "modelmesh-runtime-adapter RBAC"
        Note["No RBAC manifests defined<br/>by this component"]
    end

    subgraph "RBAC Delegation"
        MMS["modelmesh-serving Operator"]
        SA["Pod ServiceAccount<br/>(configured by ModelMesh)"]
        PodBoundary["Pod Boundary Isolation<br/>(localhost-only listeners)"]
    end

    subgraph "Security Model"
        direction TB
        NoAuthInterceptors["No gRPC Auth Interceptors<br/>grpc.NewServer() — bare"]
        LocalhostBinding["Localhost-Only Binding<br/>127.0.0.1:8084/8085"]
        InsecureCreds["insecure.NewCredentials()<br/>for outbound gRPC"]
    end

    subgraph "Storage Authentication (External)"
        S3Auth["S3 / IBM COS<br/>Access Key + Secret Key<br/>(env vars from ModelMesh)"]
        AzureAuth["Azure Blob<br/>Connection String / Azure Identity<br/>(env vars from ModelMesh)"]
        GCSAuth["Google Cloud Storage<br/>Service Account JSON<br/>(env vars from ModelMesh)"]
        HTTPAuth["HTTP Provider<br/>Optional client certs + headers<br/>(pullman config)"]
    end

    MMS -->|"configures"| SA
    MMS -->|"supplies credentials via"| S3Auth
    MMS -->|"supplies credentials via"| AzureAuth
    MMS -->|"supplies credentials via"| GCSAuth
    SA -->|"identity for"| PodBoundary
    PodBoundary -->|"enforces"| NoAuthInterceptors
    PodBoundary -->|"enforces"| LocalhostBinding
    PodBoundary -->|"enforces"| InsecureCreds

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style MMS fill:#7ed321,color:#fff,stroke:#333
    style SA fill:#4a90e2,color:#fff,stroke:#333
    style PodBoundary fill:#4a90e2,color:#fff,stroke:#333
    style NoAuthInterceptors fill:#e74c3c,color:#fff,stroke:#333
    style LocalhostBinding fill:#f39c12,color:#fff,stroke:#333
    style InsecureCreds fill:#e74c3c,color:#fff,stroke:#333
    style S3Auth fill:#f5a623,color:#fff,stroke:#333
    style AzureAuth fill:#f5a623,color:#fff,stroke:#333
    style GCSAuth fill:#f5a623,color:#fff,stroke:#333
    style HTTPAuth fill:#f5a623,color:#fff,stroke:#333
