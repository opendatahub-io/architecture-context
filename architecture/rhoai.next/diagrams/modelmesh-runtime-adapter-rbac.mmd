graph TD
    subgraph "ModelMesh Runtime Adapter — Security Model"
        direction TB

        subgraph PodIsolation["Pod-Level Isolation (Primary Security Boundary)"]
            direction TB

            SA["Pod ServiceAccount<br/>(inherited from ServingRuntime pod)"]

            subgraph InternalComms["Pod-Internal Communication (No Auth)"]
                Puller["model-serving-puller<br/>gRPC 8084/TCP<br/>plaintext loopback"]
                Adapter["Runtime Adapter<br/>gRPC 8085/TCP<br/>plaintext loopback"]
                Runtime["Target Runtime<br/>8001/TCP or 7071/TCP<br/>plaintext loopback"]

                Puller -->|"No auth<br/>loopback only"| Adapter
                Adapter -->|"No auth<br/>loopback only"| Runtime
            end
        end

        subgraph SecretAccess["Secret-Based Credential Access"]
            direction TB

            StorageSecret["Storage Config Secrets<br/>(Opaque, mounted at /storage-config)"]

            subgraph CredentialTypes["Credential Types"]
                S3Creds["S3 Credentials<br/>access_key_id<br/>secret_access_key<br/>endpoint_url, region"]
                GCSCreds["GCS Credentials<br/>service_account JSON<br/>(private_key + client_email)"]
                AzureCreds["Azure Credentials<br/>connection_string or<br/>client_id + client_secret<br/>+ tenant_id"]
                HTTPCreds["HTTP Credentials<br/>custom_headers<br/>CA cert, client cert + key"]
            end

            StorageSecret --- S3Creds
            StorageSecret --- GCSCreds
            StorageSecret --- AzureCreds
            StorageSecret --- HTTPCreds
        end

        subgraph FIPSCompliance["FIPS 140-2 Compliance"]
            BuildFlags["Build Flags:<br/>GOEXPERIMENT=strictfipsruntime<br/>CGO_ENABLED=1<br/>-tags strictfipsruntime"]
            CryptoLib["Crypto: stdlib crypto/tls<br/>via OpenSSL (FIPS-validated)<br/>No MD5, RC4, or DES usage"]
            BaseImage["Base: UBI 9 minimal<br/>OpenSSL included"]
        end

        subgraph NetworkSecurity["Network Security"]
            LoopbackOnly["Internal: Loopback only<br/>(8084, 8085, 8001, 7071, 7070)<br/>No Kubernetes Services defined"]
            EgressTLS["External Egress: TLS 1.2+<br/>to cloud storage (443/TCP)<br/>SDK-managed TLS"]
            OptionalMTLS["HTTP Provider: Optional mTLS<br/>CA cert + client cert/key<br/>for private model repos"]
        end
    end

    subgraph Notes["Security Notes"]
        Note1["No ClusterRoles or RoleBindings<br/>(sidecar does not interact with K8s API)"]
        Note2["No Ingress defined<br/>(never exposed outside pod)"]
        Note3["Tenant isolation: per-pod<br/>(ModelMesh handles multi-tenant routing)"]
    end

    SA -.->|"provides identity for"| PodIsolation
    SA -.->|"mounts"| StorageSecret

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Puller fill:#7ed321,stroke:#333
    style Adapter fill:#7ed321,stroke:#333
    style Runtime fill:#7ed321,stroke:#333
    style StorageSecret fill:#f5a623,stroke:#333
    style S3Creds fill:#fff2cc,stroke:#d6b656
    style GCSCreds fill:#fff2cc,stroke:#d6b656
    style AzureCreds fill:#fff2cc,stroke:#d6b656
    style HTTPCreds fill:#fff2cc,stroke:#d6b656
    style BuildFlags fill:#d5e8d4,stroke:#82b366
    style CryptoLib fill:#d5e8d4,stroke:#82b366
    style BaseImage fill:#d5e8d4,stroke:#82b366
    style LoopbackOnly fill:#dae8fc,stroke:#6c8ebf
    style EgressTLS fill:#dae8fc,stroke:#6c8ebf
    style OptionalMTLS fill:#dae8fc,stroke:#6c8ebf
    style Note1 fill:#f9f9f9,stroke:#999
    style Note2 fill:#f9f9f9,stroke:#999
    style Note3 fill:#f9f9f9,stroke:#999
