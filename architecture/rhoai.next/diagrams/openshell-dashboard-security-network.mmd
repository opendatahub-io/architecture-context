graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser Client"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
        AuthProxy["Auth Proxy<br/>(oauth2-proxy / kube-auth-proxy)<br/>OIDC session mgmt, CSRF<br/>Token extraction & injection"]
    end

    subgraph BFFZone["BFF SERVICE (Stateless Token Relay)"]
        direction TB

        subgraph Unauthenticated["Unauthenticated Endpoints"]
            Config["/api/v1/auth/config<br/>GET — Frontend bootstrap"]
            Healthz["/api/v1/healthz<br/>GET — Liveness"]
            Readyz["/api/v1/readyz<br/>GET — Readiness"]
        end

        subgraph Authenticated["Authenticated Endpoints (65 routes)"]
            API["/api/v1/**<br/>GET/POST/PUT/DELETE<br/>Resource APIs"]
            Terminal["/api/v1/.../terminal<br/>WebSocket Upgrade<br/>Interactive Terminal"]
            Files["/api/v1/.../files<br/>POST — File Upload<br/>(rawexec.go bypass)"]
        end

        AuthMW["Auth Middleware<br/>proxy header -> Bearer -> 401<br/>NO token validation"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Trusted)"]
        Gateway["OpenShell Gateway<br/>gRPC 50051/TCP<br/>JWT validation (JWKS)<br/>Workspace RBAC"]
    end

    subgraph Identity["IDENTITY PROVIDER"]
        OIDC["OIDC IdP<br/>(Keycloak / Dex)"]
    end

    %% External to Auth
    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC session cookie"| AuthProxy

    %% Auth to BFF
    AuthProxy -->|"HTTP(S)/8080<br/>TLS 1.3 when configured<br/>x-forwarded-access-token"| AuthMW

    %% BFF internal
    AuthMW --> API
    AuthMW --> Terminal
    AuthMW --> Files

    %% BFF to Gateway
    API -->|"gRPC/50051<br/>TLS 1.2+<br/>Bearer relay + optional mTLS"| Gateway
    Terminal -->|"gRPC Stream/50051<br/>TLS 1.2+<br/>ExecSandboxInteractive"| Gateway
    Files -->|"Raw gRPC/50051<br/>TLS 1.2+<br/>Binary stdin (non-TTY)"| Gateway

    %% Identity flows
    AuthProxy -.->|"OIDC/OAuth2<br/>HTTPS"| OIDC
    Gateway -.->|"JWKS validation<br/>HTTPS"| OIDC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef bff fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef unauth fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef authed fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef identity fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Browser external
    class AuthProxy authboundary
    class Config,Healthz,Readyz unauth
    class API,Terminal,Files,AuthMW authed
    class Gateway platform
    class OIDC identity
