graph TB
    subgraph External["External Traffic"]
        Client["External Client"]
    end

    subgraph IstioGateway["Istio Gateway (Envoy)"]
        Envoy["Envoy Proxy<br/>443/TCP HTTPS"]
    end

    subgraph PraxisSystem["praxis-extproc (openshift-ingress)"]
        direction TB
        subgraph PreAuth["Pre-Auth Stage"]
            PreProcessor["payload-pre-processing<br/>9004/TCP gRPC"]
            ModelToHeader["model_to_header filter"]
            ModelProviderResolver["llmisvc_model_provider_resolver filter"]
            PreProcessor --> ModelToHeader
            PreProcessor --> ModelProviderResolver
        end

        subgraph PostAuth["Post-Auth Stage"]
            PostProcessor["payload-processing<br/>9004/TCP gRPC"]
            RequestIdFilter["request_id filter"]
            PostProcessor --> RequestIdFilter
        end

        subgraph Support["Support Services"]
            Health["Health Check<br/>50052/TCP gRPC"]
            Metrics["Metrics Endpoint<br/>9090/TCP HTTP"]
        end

        subgraph FIPSLayer["FIPS Compliance Layer"]
            CryptoProvider["OpenSSL Crypto Provider"]
            FIPSCheck["FIPS Enforcement<br/>(provider + kernel + filter check)"]
            CryptoProvider --> FIPSCheck
        end
    end

    subgraph AuthLayer["Auth Layer"]
        Kuadrant["Kuadrant Auth<br/>(WasmPlugin)"]
    end

    subgraph Backend["Backend Services"]
        InferencePool["KServe InferencePool"]
        InferenceBackend["Inference Backend"]
    end

    subgraph Platform["Platform Services"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS"]
        Prometheus["Prometheus<br/>(openshift-monitoring)"]
    end

    Client -->|HTTPS/443| Envoy
    Envoy -->|gRPC ExtProc/9004<br/>TLS| PreProcessor
    Envoy -->|token validation| Kuadrant
    Envoy -->|gRPC ExtProc/9004<br/>TLS| PostProcessor
    PreProcessor -->|X-Gateway-Model-Name| Envoy
    Envoy -->|header routing| InferencePool
    InferencePool --> InferenceBackend

    PostProcessor -->|HTTPS/443<br/>SA token| K8sAPI
    Prometheus -->|HTTP scrape/9090| Metrics

    style PreProcessor fill:#4a90e2,color:#fff
    style PostProcessor fill:#4a90e2,color:#fff
    style Health fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style CryptoProvider fill:#d35400,color:#fff
    style FIPSCheck fill:#d35400,color:#fff
    style Kuadrant fill:#9b59b6,color:#fff
    style InferencePool fill:#7ed321,color:#000
    style K8sAPI fill:#f5a623,color:#000
    style Prometheus fill:#f5a623,color:#000
    style Envoy fill:#e8e8e8,color:#000
