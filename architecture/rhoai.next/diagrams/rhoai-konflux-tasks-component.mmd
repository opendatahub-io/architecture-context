graph TB
    subgraph KonfluxTasks["rhoai-konflux-tasks (CI/CD Task Library)"]
        direction TB

        subgraph Tasks["Tekton Tasks"]
            Init["rhoai-init<br/>CPE ID, image metadata,<br/>Slack setup, RHEL targeting"]
            Mirror["container-image-mirror<br/>Registry image mirroring"]
            Prefetch["prefetch-operand-manifests-oci-ta<br/>Operand manifest fetching"]
            PRComment["pull-request-comment<br/>PR status, JUnit results"]
            TriggerBundle["trigger-bundle-build<br/>GitHub Actions dispatch"]
            TriggerOperator["trigger-operator-build<br/>Commit comment trigger"]
            TriggerGroup["trigger-group-testing<br/>Check run monitoring"]
            GenSnapshot["generate-snapshot-for-group-testing<br/>Image digest resolution"]
            Sealights["rhoai-inject-sealights-oci-ta<br/>Sealights instrumentation"]
            EvalScan["evaluate-scan-results<br/>Scan policy enforcement<br/>(report-only)"]
        end

        subgraph StepActions["Tekton StepActions"]
            GitClone["git-clone<br/>Sparse checkout, partial fetch"]
            SecureGitPush["secure-git-push<br/>leaktk scan + git push"]
            SecurePushOCI["secure-push-oci<br/>leaktk scan + OCI push"]
            Cleanup["cleanup-git-repo<br/>Remote artifact cleanup"]
            PRCommentStep["pull-request-comment<br/>PR comment posting"]
        end

        subgraph Pipelines["Tekton Pipelines"]
            ContainerBuild["container-build<br/>Single-arch build pipeline<br/>17 tasks, security scans, SBOM"]
            ContainerBuildRemote["container-build-remote<br/>Multi-arch build pipeline<br/>Matrix-based platform builds"]
        end
    end

    %% Pipeline composition
    ContainerBuild -->|composes| Init
    ContainerBuild -->|composes| Prefetch
    ContainerBuild -->|composes| EvalScan
    ContainerBuildRemote -->|composes| Init

    %% StepAction usage
    Prefetch -->|uses| GitClone
    TriggerBundle -->|uses| SecureGitPush
    Prefetch -->|uses| SecurePushOCI

    %% External interactions
    Init -->|queries| KonfluxCluster["Konflux Cluster"]
    Prefetch -->|clones| ComponentRepos["Component Repos<br/>(GitHub)"]
    Prefetch -->|clones| RKAutomation["RHOAI-Konflux-Automation"]
    Prefetch -->|clones| ODHBuildConfig["ODH-Build-Config"]
    TriggerOperator -->|commit comment| OperatorRepo["opendatahub-operator"]
    TriggerBundle -->|workflow dispatch| ODHBuildConfig
    TriggerGroup -->|check runs API| GitHubAPI["GitHub API"]
    GenSnapshot -->|tag/manifest API| QuayIO["Quay.io"]
    Mirror -->|push/pull| QuayIO
    Sealights -->|attestation download| QuayIO
    PRComment -->|PR comment API| GitHubAPI

    %% Styling
    style Init fill:#4a90e2,color:#fff
    style EvalScan fill:#e74c3c,color:#fff
    style Prefetch fill:#4a90e2,color:#fff
    style ContainerBuild fill:#8e44ad,color:#fff
    style ContainerBuildRemote fill:#8e44ad,color:#fff
    style SecureGitPush fill:#27ae60,color:#fff
    style SecurePushOCI fill:#27ae60,color:#fff
    style GitHubAPI fill:#e8e8e8,stroke:#333
    style QuayIO fill:#e8e8e8,stroke:#333
    style OperatorRepo fill:#f5a623,stroke:#333
    style ODHBuildConfig fill:#f5a623,stroke:#333
    style RKAutomation fill:#f5a623,stroke:#333
    style ComponentRepos fill:#f5a623,stroke:#333
    style KonfluxCluster fill:#e8e8e8,stroke:#333
