graph TB
    subgraph ClusterInternal["CLUSTER-INTERNAL (No External Ingress)"]
        direction TB

        subgraph ControllerNS["Namespace: wva-system"]
            WVA["WVA Controller Manager<br/>SA: controller-manager<br/>Leader-elected single replica"]
            HealthProbe["Health Probes<br/>:8081/TCP HTTP<br/>No Auth"]
            MetricsSvc["controller-manager-metrics-service<br/>ClusterIP :8443/TCP<br/>HTTPS (TLS self-signed / service-ca)<br/>Auth: TokenReview + SubjectAccessReview"]
            WVA --- HealthProbe
            WVA --- MetricsSvc
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        Prometheus["Prometheus / Thanos Querier<br/>9090/TCP HTTPS<br/>TLS 1.2+ (MinVersion enforced)<br/>Bearer token / mTLS"]
    end

    subgraph KEDAFlow["KEDA-NATIVE FLOW (Active)"]
        KEDAOp["KEDA Operator"]
        HPA["HorizontalPodAutoscaler"]
        Deployment["Target Deployment"]
        KEDAOp -->|"HTTPS/9090<br/>TLS 1.2+<br/>Configured auth"| Prometheus
        KEDAOp -->|"HTTPS/6443<br/>SA token"| K8sAPI
        K8sAPI -.->|"scaling decision"| HPA
        HPA -.->|"scale subresource"| Deployment
    end

    %% WVA Egress
    WVA -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token (in-cluster)"| K8sAPI
    WVA -->|"HTTPS/9090<br/>TLS 1.2+<br/>Bearer token / mTLS"| Prometheus

    %% Metrics scraping (inbound)
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Bearer token (ServiceMonitor)"| MetricsSvc

    %% Styling
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef probe fill:#e8e8e8,stroke:#999
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef keda fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef target fill:#f8cecc,stroke:#b85450

    class WVA controller
    class HealthProbe probe
    class MetricsSvc service
    class K8sAPI,Prometheus platform
    class KEDAOp keda
    class HPA,Deployment target
