graph TB
    subgraph Operator["Model Registry Operator<br/>(controller-runtime)"]
        direction TB
        MRReconciler["ModelRegistryReconciler<br/>(Controller)"]
        MCReconciler["ModelCatalogReconciler<br/>(Controller)"]
        MigrationMgr["StorageMigrationManager<br/>(Migration Controller)"]
        Webhooks["Admission Webhooks<br/>(Defaulting + Validation)"]
        TemplateEngine["Template Engine<br/>(30+ Go templates)"]
        CapDetect["Cluster Capability<br/>Detection"]
    end

    subgraph CRDs["Custom Resources"]
        MR_CR["ModelRegistry CR<br/>(v1beta1 storage)"]
        MR_CR_Legacy["ModelRegistry CR<br/>(v1alpha1 deprecated)"]
    end

    subgraph ManagedResources["Managed Resources (per registry)"]
        Deploy["Deployment<br/>(REST + kube-rbac-proxy)"]
        Svc["Service<br/>(8080 REST, 8443 proxy)"]
        Route["OpenShift Route<br/>(HTTPS re-encrypt)"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        NetPol["NetworkPolicy"]
        SA["ServiceAccount"]
        RBAC_Res["Roles & RoleBindings"]
        PG_Deploy["PostgreSQL Deployment<br/>(auto-provisioned)"]
        PG_PVC["PersistentVolumeClaim"]
        PG_Secret["DB Credential Secret"]
    end

    subgraph CatalogResources["Managed Resources (catalog)"]
        Cat_Deploy["Catalog Deployment<br/>(REST + kube-rbac-proxy)"]
        Cat_PG["Catalog PostgreSQL"]
        Cat_Route["Catalog Route/HTTPRoute"]
        Cat_CM["ConfigMaps<br/>(catalog, user, MCP, agent)"]
    end

    %% User creates CRs
    User[User / Platform Operator] -->|creates| MR_CR
    MR_CR_Legacy -->|conversion webhook| MR_CR

    %% CRs trigger controllers
    MR_CR -->|watched by| MRReconciler
    MRReconciler -->|uses| TemplateEngine
    MRReconciler -->|uses| CapDetect
    MCReconciler -->|uses| TemplateEngine
    MCReconciler -->|uses| CapDetect

    %% Webhooks
    MR_CR -->|admission| Webhooks
    Webhooks -->|defaults & validates| MR_CR

    %% Migration
    MigrationMgr -->|migrates v1alpha1 → v1beta1| MR_CR

    %% Registry reconciler creates resources
    MRReconciler -->|creates| Deploy
    MRReconciler -->|creates| Svc
    MRReconciler -->|creates| Route
    MRReconciler -->|creates| HTTPRoute
    MRReconciler -->|creates| NetPol
    MRReconciler -->|creates| SA
    MRReconciler -->|creates| RBAC_Res
    MRReconciler -->|creates| PG_Deploy
    MRReconciler -->|creates| PG_PVC
    MRReconciler -->|creates| PG_Secret

    %% Catalog reconciler creates resources
    MCReconciler -->|creates| Cat_Deploy
    MCReconciler -->|creates| Cat_PG
    MCReconciler -->|creates| Cat_Route
    MCReconciler -->|creates| Cat_CM

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OSRoute["OpenShift Route API"]
    OSServiceCA["OpenShift service-ca"]
    DSGateway["Data Science Gateway"]
    PlatformCR["Platform ModelRegistry CR<br/>(components.platform.opendatahub.io)"]
    AuthCR["Platform Auth CR<br/>(services.platform.opendatahub.io)"]

    MRReconciler -->|CRUD| K8sAPI
    MRReconciler -->|creates routes| OSRoute
    MCReconciler -->|reads admin groups| AuthCR
    MRReconciler -->|reads default config| PlatformCR
    HTTPRoute -->|references| DSGateway
    OSServiceCA -->|generates certs| Operator

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style MRReconciler fill:#2d6cb4,stroke:#333,color:#fff
    style MCReconciler fill:#2d6cb4,stroke:#333,color:#fff
    style MigrationMgr fill:#2d6cb4,stroke:#333,color:#fff
    style Webhooks fill:#2d6cb4,stroke:#333,color:#fff
    style TemplateEngine fill:#2d6cb4,stroke:#333,color:#fff
    style CapDetect fill:#2d6cb4,stroke:#333,color:#fff
    style MR_CR fill:#f5a623,stroke:#333
    style MR_CR_Legacy fill:#f5a623,stroke:#333
    style Deploy fill:#7ed321,stroke:#333
    style Svc fill:#7ed321,stroke:#333
    style Route fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style NetPol fill:#7ed321,stroke:#333
    style SA fill:#7ed321,stroke:#333
    style RBAC_Res fill:#7ed321,stroke:#333
    style PG_Deploy fill:#7ed321,stroke:#333
    style PG_PVC fill:#7ed321,stroke:#333
    style PG_Secret fill:#7ed321,stroke:#333
    style Cat_Deploy fill:#50c878,stroke:#333
    style Cat_PG fill:#50c878,stroke:#333
    style Cat_Route fill:#50c878,stroke:#333
    style Cat_CM fill:#50c878,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSRoute fill:#e8e8e8,stroke:#333
    style OSServiceCA fill:#e8e8e8,stroke:#333
    style DSGateway fill:#e8e8e8,stroke:#333
