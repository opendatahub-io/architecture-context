graph TB
    subgraph Operator["Model Registry Operator"]
        direction TB
        MRReconciler["ModelRegistryReconciler<br/>(Controller)"]
        MCReconciler["ModelCatalogReconciler<br/>(Controller - Singleton)"]
        SVM["StorageMigrationManager<br/>(Background Process)"]
        Webhooks["Admission Webhooks<br/>(Mutating + Validating + Conversion)"]
    end

    %% Primary CRD
    ModelRegistryCR["ModelRegistry CR<br/>(modelregistry.opendatahub.io/v1beta1)"]
    ModelRegistryCRAlpha["ModelRegistry CR<br/>(v1alpha1 - deprecated)"]

    %% Resources created per ModelRegistry
    subgraph PerRegistry["Per-Registry Resources"]
        direction TB
        RestDeploy["REST API Deployment<br/>(model-registry + kube-rbac-proxy)"]
        RegistrySvc["ClusterIP Service<br/>(8443/TCP HTTPS)"]
        RegistrySA["ServiceAccount"]
        RegistryRBAC["Role + RoleBinding<br/>(registry-user-{name})"]
        RegistryNetPol["NetworkPolicy"]
        RegistryGroup["OpenShift Group<br/>({name}-users)"]
    end

    %% Ingress resources
    subgraph Ingress["Ingress (Dual Mode)"]
        direction TB
        OSRoute["OpenShift Route<br/>(reencrypt TLS)"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        RefGrant["ReferenceGrant"]
    end

    %% Database
    subgraph Database["Database Backend"]
        direction TB
        AutoPG["Auto-Provisioned PostgreSQL<br/>(Deployment + PVC + Secret)"]
        ExternalDB["External PostgreSQL/MySQL<br/>(User-Provided)"]
    end

    %% Model Catalog (Singleton)
    subgraph Catalog["Model Catalog (Singleton)"]
        direction TB
        CatalogDeploy["Catalog Deployment<br/>(model-registry + kube-rbac-proxy)"]
        CatalogPG["Catalog PostgreSQL"]
        CatalogRoute["Catalog Route/HTTPRoute"]
        CatalogRBAC["Catalog RBAC<br/>(Admin Groups from Auth CR)"]
    end

    %% Flows
    ModelRegistryCR -->|"watched by"| MRReconciler
    ModelRegistryCRAlpha -->|"converted to v1beta1"| Webhooks
    Webhooks -->|"validates & defaults"| ModelRegistryCR

    MRReconciler -->|creates| RestDeploy
    MRReconciler -->|creates| RegistrySvc
    MRReconciler -->|creates| RegistrySA
    MRReconciler -->|creates| RegistryRBAC
    MRReconciler -->|creates| RegistryNetPol
    MRReconciler -->|creates| RegistryGroup
    MRReconciler -->|creates| OSRoute
    MRReconciler -->|creates| HTTPRoute
    MRReconciler -->|creates| RefGrant
    MRReconciler -->|provisions| AutoPG

    RestDeploy -->|connects to| AutoPG
    RestDeploy -->|connects to| ExternalDB

    MCReconciler -->|manages| CatalogDeploy
    MCReconciler -->|provisions| CatalogPG
    MCReconciler -->|creates| CatalogRoute
    MCReconciler -->|manages| CatalogRBAC

    SVM -->|migrates| ModelRegistryCRAlpha

    %% External dependencies
    DSGateway["Data Science Gateway"]
    HTTPRoute -->|"parentRef"| DSGateway
    CatalogRoute -->|"parentRef"| DSGateway

    AuthCR["Auth CR<br/>(services.platform.opendatahub.io)"]
    AuthCR -->|"admin groups"| MCReconciler

    CatalogSources["ConfigMaps<br/>(opendatahub.io/catalog-source=true)"]
    CatalogSources -->|"mounted as volumes"| CatalogDeploy

    K8sAPI["Kubernetes API Server"]
    MRReconciler -->|"CRUD resources"| K8sAPI
    MCReconciler -->|"CRUD resources"| K8sAPI

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style MRReconciler fill:#3a7bd5,stroke:#333,color:#fff
    style MCReconciler fill:#3a7bd5,stroke:#333,color:#fff
    style SVM fill:#3a7bd5,stroke:#333,color:#fff
    style Webhooks fill:#3a7bd5,stroke:#333,color:#fff
    style ModelRegistryCR fill:#f5a623,stroke:#333,stroke-width:2px
    style ModelRegistryCRAlpha fill:#f5a623,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5
    style RestDeploy fill:#7ed321,stroke:#333
    style RegistrySvc fill:#7ed321,stroke:#333
    style RegistrySA fill:#7ed321,stroke:#333
    style RegistryRBAC fill:#7ed321,stroke:#333
    style RegistryNetPol fill:#7ed321,stroke:#333
    style RegistryGroup fill:#7ed321,stroke:#333
    style OSRoute fill:#50c8ff,stroke:#333
    style HTTPRoute fill:#50c8ff,stroke:#333
    style RefGrant fill:#50c8ff,stroke:#333
    style AutoPG fill:#b8e986,stroke:#333
    style ExternalDB fill:#e8e8e8,stroke:#333
    style CatalogDeploy fill:#9b59b6,stroke:#333,color:#fff
    style CatalogPG fill:#9b59b6,stroke:#333,color:#fff
    style CatalogRoute fill:#9b59b6,stroke:#333,color:#fff
    style CatalogRBAC fill:#9b59b6,stroke:#333,color:#fff
    style DSGateway fill:#e8e8e8,stroke:#333
    style AuthCR fill:#e8e8e8,stroke:#333
    style CatalogSources fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
