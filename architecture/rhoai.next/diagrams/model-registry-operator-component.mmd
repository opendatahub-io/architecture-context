graph TB
    subgraph Operator["model-registry-operator"]
        Manager["controller-manager<br/>8443/TCP metrics<br/>8081/TCP health"]

        subgraph Controllers["Controllers"]
            AIHub["AIHubReconciler<br/>cluster-scoped"]
            CatalogCtrl["CatalogReconciler<br/>namespace-scoped"]
            MRCtrl["ModelRegistryReconciler<br/>namespace-scoped"]
        end

        subgraph Webhooks["Admission Webhooks 9443/TCP"]
            Mutating["Mutating Webhook<br/>ModelRegistry defaults"]
            Validating["Validating Webhook<br/>ModelRegistry validation"]
            Conversion["Conversion Webhook<br/>v1alpha1 to v1beta1"]
        end

        Manager --> AIHub
        Manager --> CatalogCtrl
        Manager --> MRCtrl
        Manager --> Mutating
        Manager --> Validating
        Manager --> Conversion
    end

    %% CRDs
    AIHubCR["AIHub CR<br/>components.platform.opendatahub.io/v1alpha1<br/>cluster-scoped"]
    CatalogCR["Catalog CR<br/>aihub.opendatahub.io/v1alpha1<br/>namespaced"]
    MRCR["ModelRegistry CR<br/>modelregistry.opendatahub.io<br/>v1alpha1 / v1beta1"]

    AIHubCR -->|watched by| AIHub
    AIHub -->|creates| CatalogCR
    CatalogCR -->|watched by| CatalogCtrl
    MRCR -->|watched by| MRCtrl

    %% Catalog deployment stack
    subgraph CatalogStack["Catalog Deployment Stack"]
        CatalogDeploy["model-catalog<br/>REST API + kube-rbac-proxy<br/>8080/8443 TCP"]
        CatalogDB["model-catalog-postgres<br/>PostgreSQL 16<br/>5432/TCP"]
    end
    CatalogCtrl -->|deploys| CatalogDeploy
    CatalogCtrl -->|deploys| CatalogDB
    CatalogDeploy -->|5432/TCP| CatalogDB

    %% Per-registry deployment stack
    subgraph RegistryStack["Per-Registry Deployment Stack"]
        RegistryDeploy["registry-name<br/>REST API + kube-rbac-proxy<br/>8080/8443 TCP"]
        RegistryDB["registry-name-postgres<br/>PostgreSQL 16<br/>5432/TCP"]
    end
    MRCtrl -->|deploys per CR| RegistryDeploy
    MRCtrl -->|deploys per CR| RegistryDB
    RegistryDeploy -->|5432/TCP| RegistryDB

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftAPI["OpenShift API<br/>config.openshift.io"]
    GatewayAPI["Platform Gateway<br/>data-science-gateway"]

    Manager -->|reconciliation<br/>RBAC, discovery| K8sAPI
    Manager -->|TLS profile<br/>ingress domain| OpenShiftAPI
    MRCtrl -->|HTTPRoute / Route| GatewayAPI
    CatalogCtrl -->|HTTPRoute / Route| GatewayAPI

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style AIHub fill:#4a90e2,stroke:#333,color:#fff
    style CatalogCtrl fill:#4a90e2,stroke:#333,color:#fff
    style MRCtrl fill:#4a90e2,stroke:#333,color:#fff
    style Mutating fill:#9b59b6,stroke:#333,color:#fff
    style Validating fill:#9b59b6,stroke:#333,color:#fff
    style Conversion fill:#9b59b6,stroke:#333,color:#fff
    style AIHubCR fill:#f5a623,stroke:#333
    style CatalogCR fill:#f5a623,stroke:#333
    style MRCR fill:#f5a623,stroke:#333
    style CatalogDeploy fill:#7ed321,stroke:#333
    style CatalogDB fill:#7ed321,stroke:#333
    style RegistryDeploy fill:#7ed321,stroke:#333
    style RegistryDB fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
