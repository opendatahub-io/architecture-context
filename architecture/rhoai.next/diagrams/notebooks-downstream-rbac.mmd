graph TD
    subgraph "notebooks-downstream RBAC Model"
        direction TB

        Note["NOTE: notebooks-downstream produces container images,<br/>not operators. It defines NO RBAC roles or bindings.<br/>All RBAC is managed by the deploying components."]
    end

    subgraph "Authentication (Delegated)"
        direction TB

        UserBrowser["User Browser"] -->|"OIDC / Bearer Token"| KubeRBAC["kube-rbac-proxy sidecar<br/>(injected by odh-notebook-controller)"]
        KubeRBAC -->|"Pre-authenticated<br/>HTTP (localhost)"| WorkbenchPod["Workbench Pod<br/>(Jupyter / Code Server / RStudio)"]
    end

    subgraph "RBAC Managed By Other Components"
        direction TB

        subgraph "odh-notebook-controller"
            NotebookCtrlSA["SA: notebook-controller-manager"]
            NotebookCtrlRole["ClusterRole: notebook-controller-role<br/>Resources: notebooks, pods, services,<br/>httproutes, events<br/>Verbs: get, list, watch, create,<br/>update, patch, delete"]
            NotebookCtrlSA -->|"bound via"| NotebookCtrlRole
        end

        subgraph "Per-User Workbench Pod"
            WorkbenchSA["SA: {notebook-name}<br/>(auto-created per Notebook CR)"]
            MountedToken["Mounted ServiceAccount Token<br/>(provides cluster API access)"]
            WorkbenchSA -->|"token mounted in"| MountedToken
        end
    end

    subgraph "Access Control Enforcement"
        direction TB

        Policy1["Per-user Notebook CR access<br/>Enforced by kube-rbac-proxy"]
        Policy2["Per-namespace isolation<br/>Enforced by Kubernetes RBAC"]
        Policy3["No NetworkPolicy in this repo<br/>(relies on platform-level policy)"]
    end

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style KubeRBAC fill:#f5a623,color:#fff
    style WorkbenchPod fill:#4a90e2,color:#fff
    style UserBrowser fill:#e8e8e8,stroke:#333
    style NotebookCtrlSA fill:#7ed321,color:#fff
    style NotebookCtrlRole fill:#7ed321,color:#fff
    style WorkbenchSA fill:#dae8fc,stroke:#6c8ebf
    style MountedToken fill:#dae8fc,stroke:#6c8ebf
    style Policy1 fill:#f8cecc,stroke:#b85450
    style Policy2 fill:#f8cecc,stroke:#b85450
    style Policy3 fill:#f8cecc,stroke:#b85450
