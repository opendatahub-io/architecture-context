graph TD
    subgraph ExternalAuth["External Authentication (not in this component)"]
        OIDC["OpenShift OAuth / OIDC<br/>Provider"]
    end

    subgraph SidecarAuth["Auth Sidecar (injected by odh-notebook-controller)"]
        KubeRBACProxy["kube-rbac-proxy<br/>Port: 8443/TCP"]
    end

    subgraph NotebookCRAccess["Per-User Access Control"]
        NotebookCR["Notebook CR<br/>(one per user)"]
        UserSA["User ServiceAccount<br/>(per Notebook CR)"]
    end

    subgraph WorkbenchPods["Workbench Pods (no built-in RBAC)"]
        direction LR
        Jupyter["JupyterLab<br/>8888/TCP<br/>No auth"]
        CS["Code Server<br/>8787/TCP<br/>No auth"]
        RS["RStudio<br/>8787/TCP<br/>No auth"]
    end

    subgraph RuntimePods["Runtime Pods (ServiceAccount auth)"]
        direction LR
        RuntimeSA["Pipeline ServiceAccount<br/>(mounted token)"]
        RuntimeContainer["Runtime Container<br/>(batch execution)"]
    end

    subgraph PlatformRBAC["Platform RBAC (defined elsewhere)"]
        NCRole["odh-notebook-controller<br/>ClusterRole"]
        OperatorRole["rhods-operator<br/>ClusterRole"]
    end

    %% Auth flow
    OIDC -->|"issues tokens"| KubeRBACProxy
    KubeRBACProxy -->|"validates Bearer Token<br/>checks Notebook CR ownership"| NotebookCR
    NotebookCR -->|"owns"| UserSA
    KubeRBACProxy -->|"proxies if authorized"| Jupyter
    KubeRBACProxy -->|"proxies if authorized"| CS
    KubeRBACProxy -->|"proxies if authorized"| RS

    %% Runtime auth
    RuntimeSA -->|"mounted into"| RuntimeContainer

    %% Platform management
    NCRole -->|"manages Pods, Services,<br/>Routes for Notebooks"| WorkbenchPods
    OperatorRole -->|"manages ImageStreams"| WorkbenchPods

    %% Notes
    Note1["NOTE: This component defines NO RBAC roles.<br/>All RBAC is managed by odh-notebook-controller<br/>and rhods-operator."]

    %% Styling
    style OIDC fill:#f5a623
    style KubeRBACProxy fill:#e8524a,color:#fff
    style NotebookCR fill:#4a90e2,color:#fff
    style UserSA fill:#4a90e2,color:#fff
    style Jupyter fill:#7ed321
    style CS fill:#7ed321
    style RS fill:#7ed321
    style RuntimeSA fill:#4a90e2,color:#fff
    style RuntimeContainer fill:#7ed321
    style NCRole fill:#999
    style OperatorRole fill:#999
    style Note1 fill:#fffacd,stroke:#d4c100
