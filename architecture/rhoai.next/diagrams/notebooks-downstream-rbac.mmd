graph TD
    subgraph ExternalAuth["External Authentication (OpenShift)"]
        User["User (Browser)"]
        OAuthProvider["OpenShift OAuth Provider<br/>Identity Provider"]
    end

    subgraph IngressLayer["Ingress Layer"]
        Router["OpenShift Router<br/>TLS 1.3 Termination"]
    end

    subgraph AuthProxy["Auth Proxy (Pod Sidecar)"]
        KubeRBAC["kube-rbac-proxy<br/>Port: 8443/TCP<br/>Injected by ODH Notebook Controller"]
        SAR["SubjectAccessReview<br/>(Kubernetes API call)"]
        KubeRBAC -->|"validates user"| SAR
    end

    subgraph K8sRBAC["Kubernetes RBAC"]
        direction TB
        SAR -->|"checks"| NSAccess["Namespace Access<br/>User must have access to<br/>Notebook CR namespace"]
    end

    subgraph WorkbenchEndpoints["Protected Workbench Endpoints"]
        direction TB
        JupyterUI["JupyterLab UI<br/>Port: 8888/TCP<br/>Methods: GET, POST, WS"]
        CodeServerUI["CodeServer UI<br/>Port: 8787/TCP<br/>Methods: GET, POST, WS"]
        RStudioUI["RStudio UI<br/>Port: 8787/TCP<br/>Methods: GET, POST, WS"]
    end

    subgraph UnprotectedEndpoints["Unprotected Endpoints (Pod-Internal)"]
        direction TB
        CullingAPI["/api/kernels/<br/>Port: 8787/TCP<br/>FastCGI (access.cgi)<br/>Pod culling activity check"]
        HealthProbe["/api/<br/>Port: 8787/TCP<br/>FastCGI (probe.cgi)<br/>Health check"]
    end

    subgraph BuildTimeSecrets["Build-Time Secrets"]
        direction TB
        RHSM["RHSM Credentials<br/>Type: Opaque<br/>Purpose: RHEL subscription<br/>for RHEL9 RStudio builds<br/>Manual provisioning<br/>No auto-rotation"]
        PKICerts["PKI Certificates<br/>Type: Opaque<br/>Purpose: Container registry auth<br/>Manual provisioning<br/>No auto-rotation"]
    end

    subgraph FIPSCompliance["FIPS Compliance"]
        direction TB
        MongoCLI["mongocli Binary<br/>CGO_ENABLED=1<br/>-tags strictfipsruntime<br/>(Data Science images only)"]
        SystemOpenSSL["System OpenSSL<br/>(UBI9 base image)<br/>All images inherit"]
    end

    %% Auth flow
    User -->|"OAuth login"| OAuthProvider
    OAuthProvider -->|"OAuth token"| Router
    Router -->|"HTTPS/443<br/>OAuth token forwarded"| KubeRBAC

    %% Access decisions
    NSAccess -->|"allowed"| WorkbenchEndpoints
    NSAccess -->|"denied → 403"| User

    %% Unprotected (pod-local only)
    KubeRBAC -.->|"not routed through<br/>auth proxy"| UnprotectedEndpoints

    %% Notes
    Note1["NOTE: This component defines NO<br/>ClusterRoles, Roles, or RoleBindings.<br/>All RBAC is managed externally by<br/>ODH Notebook Controller and<br/>OpenShift platform."]

    %% Styling
    style User fill:#f9f9f9,stroke:#999,stroke-width:2px
    style OAuthProvider fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style Router fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style KubeRBAC fill:#ff6b6b,stroke:#c0392b,stroke-width:2px,color:#fff
    style SAR fill:#ff6b6b,stroke:#c0392b,stroke-width:2px,color:#fff
    style NSAccess fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    style JupyterUI fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style CodeServerUI fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style RStudioUI fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    style CullingAPI fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style HealthProbe fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    style RHSM fill:#f8d7da,stroke:#c0392b,stroke-width:1px
    style PKICerts fill:#f8d7da,stroke:#c0392b,stroke-width:1px

    style MongoCLI fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style SystemOpenSSL fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px

    style Note1 fill:#ffffcc,stroke:#999,stroke-width:1px
