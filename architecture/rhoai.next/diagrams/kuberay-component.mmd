graph TB
    subgraph KubeRayOperator["KubeRay Operator"]
        direction TB
        subgraph Controllers["Controllers"]
            RayClusterCtrl["RayCluster Controller"]
            RayJobCtrl["RayJob Controller"]
            RayServiceCtrl["RayService Controller"]
            RayCronJobCtrl["RayCronJob Controller"]
        end

        subgraph SecurityControllers["Security Controllers (RHOAI)"]
            AuthCtrl["Authentication Controller<br/>kube-rbac-proxy injection<br/>HTTPRoute creation"]
            NetPolCtrl["NetworkPolicy Controller<br/>Head/worker isolation"]
            mTLSCtrl["mTLS Controller<br/>cert-manager Issuers/Certs"]
        end

        subgraph Infrastructure["Infrastructure"]
            WebhookServer["Webhook Server<br/>9443/TCP HTTPS"]
            BatchSchedulerMgr["Batch Scheduler Manager<br/>Volcano / Yunikorn / Kai"]
            DashboardCache["Dashboard Cache Client<br/>LRU 10K entries, 10m TTL"]
        end
    end

    %% CRDs
    User[User / Data Scientist] -->|creates| RayClusterCR["RayCluster CR<br/>ray.io/v1"]
    User -->|creates| RayJobCR["RayJob CR<br/>ray.io/v1"]
    User -->|creates| RayServiceCR["RayService CR<br/>ray.io/v1"]
    User -->|creates| RayCronJobCR["RayCronJob CR<br/>ray.io/v1"]

    %% CRD to Controller mapping
    RayClusterCR -->|watched by| RayClusterCtrl
    RayJobCR -->|watched by| RayJobCtrl
    RayServiceCR -->|watched by| RayServiceCtrl
    RayCronJobCR -->|watched by| RayCronJobCtrl

    %% Security controllers watch RayCluster
    RayClusterCR -->|watched by| AuthCtrl
    RayClusterCR -->|watched by| NetPolCtrl
    RayClusterCR -->|watched by| mTLSCtrl

    %% Webhook intercepts CRDs
    RayClusterCR -.->|mutate/validate| WebhookServer
    RayJobCR -.->|validate| WebhookServer
    RayServiceCR -.->|validate| WebhookServer

    %% Controllers create K8s resources
    RayClusterCtrl -->|creates| HeadPod["Head Pod"]
    RayClusterCtrl -->|creates| WorkerPods["Worker Pods"]
    RayClusterCtrl -->|creates| HeadSvc["Head Service<br/>10001, 8265, 6379, 8080, 8000"]
    RayJobCtrl -->|creates| SubmitterJob["Submitter Job"]
    RayJobCtrl -->|creates| RayClusterCR
    RayServiceCtrl -->|creates| ServeSvc["Serve Service<br/>8000/TCP"]
    RayCronJobCtrl -->|creates| RayJobCR

    %% Security controller outputs
    AuthCtrl -->|injects| RBACProxy["kube-rbac-proxy<br/>sidecar 8443/TCP"]
    AuthCtrl -->|creates| HTTPRoute["HTTPRoute<br/>Gateway API"]
    NetPolCtrl -->|creates| NetworkPolicy["NetworkPolicy<br/>head + worker"]
    mTLSCtrl -->|creates| CertIssuer["cert-manager<br/>Issuer + Certificate"]

    %% Batch scheduling
    RayClusterCtrl -->|integrates| BatchSchedulerMgr

    %% External dependencies
    RayClusterCtrl -->|depends on| K8sAPI["Kubernetes API<br/>443/TCP"]
    RayJobCtrl -->|queries via| DashboardCache
    DashboardCache -->|polls| RayDashboard["Ray Dashboard<br/>8265/TCP"]

    %% Styling
    style KubeRayOperator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Controllers fill:#bbdefb,stroke:#1565c0
    style SecurityControllers fill:#c8e6c9,stroke:#2e7d32
    style Infrastructure fill:#fff3e0,stroke:#e65100

    style RayClusterCtrl fill:#4a90e2,color:#fff
    style RayJobCtrl fill:#4a90e2,color:#fff
    style RayServiceCtrl fill:#4a90e2,color:#fff
    style RayCronJobCtrl fill:#4a90e2,color:#fff
    style AuthCtrl fill:#66bb6a,color:#fff
    style NetPolCtrl fill:#66bb6a,color:#fff
    style mTLSCtrl fill:#66bb6a,color:#fff
    style WebhookServer fill:#ffa726,color:#fff
    style BatchSchedulerMgr fill:#ffa726,color:#fff
    style DashboardCache fill:#ffa726,color:#fff

    style RayClusterCR fill:#f5a623,stroke:#333
    style RayJobCR fill:#f5a623,stroke:#333
    style RayServiceCR fill:#f5a623,stroke:#333
    style RayCronJobCR fill:#f5a623,stroke:#333

    style HeadPod fill:#e8e8e8,stroke:#333
    style WorkerPods fill:#e8e8e8,stroke:#333
    style HeadSvc fill:#e8e8e8,stroke:#333
    style ServeSvc fill:#e8e8e8,stroke:#333
    style SubmitterJob fill:#e8e8e8,stroke:#333
    style RBACProxy fill:#c8e6c9,stroke:#333
    style HTTPRoute fill:#c8e6c9,stroke:#333
    style NetworkPolicy fill:#c8e6c9,stroke:#333
    style CertIssuer fill:#c8e6c9,stroke:#333

    style K8sAPI fill:#999,stroke:#333
    style RayDashboard fill:#999,stroke:#333
    style User fill:#fff,stroke:#333,stroke-width:2px
