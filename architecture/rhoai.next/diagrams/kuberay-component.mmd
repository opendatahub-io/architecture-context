graph TB
    subgraph KubeRay["KubeRay Operator"]
        direction TB
        Manager["ray-operator<br/>(manager binary)"]

        subgraph CoreControllers["Core Controllers"]
            RayClusterReconciler["RayCluster<br/>Reconciler"]
            RayJobReconciler["RayJob<br/>Reconciler"]
            RayServiceReconciler["RayService<br/>Reconciler"]
            RayCronJobReconciler["RayCronJob<br/>Reconciler<br/>(alpha)"]
        end

        subgraph SecurityControllers["OpenShift Security Controllers"]
            AuthController["Authentication<br/>Controller"]
            NetPolController["NetworkPolicy<br/>Controller"]
            MTLSController["RayCluster mTLS<br/>Controller"]
            TLSWatcher["tls-profile-watcher<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks (9443/TCP)"]
            MutatingWH["Mutating Webhook<br/>RayCluster defaults"]
            ValidatingWH["Validating Webhooks<br/>RayCluster / RayJob / RayService"]
        end

        Manager --> CoreControllers
        Manager --> SecurityControllers
        Manager --> Webhooks
    end

    %% CRDs
    RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    RayServiceCR["RayService CR<br/>(ray.io/v1)"]
    RayCronJobCR["RayCronJob CR<br/>(ray.io/v1)"]

    RayClusterCR -->|watched by| RayClusterReconciler
    RayJobCR -->|watched by| RayJobReconciler
    RayServiceCR -->|watched by| RayServiceReconciler
    RayCronJobCR -->|watched by| RayCronJobReconciler

    RayClusterCR -->|watched by| AuthController
    RayClusterCR -->|watched by| NetPolController
    RayClusterCR -->|watched by| MTLSController

    %% Created resources
    RayClusterReconciler -->|creates| HeadPod["Ray Head Pod"]
    RayClusterReconciler -->|creates| WorkerPods["Ray Worker Pods"]
    RayClusterReconciler -->|creates| HeadSvc["Head Service"]
    RayJobReconciler -->|creates| RayClusterCR

    AuthController -->|injects| RBACProxy["kube-rbac-proxy<br/>sidecar"]
    AuthController -->|creates| Route["OpenShift Route /<br/>Gateway HTTPRoute"]
    NetPolController -->|creates| NetPol["NetworkPolicy"]
    MTLSController -->|creates| Certs["cert-manager<br/>Certificates + Issuers"]

    %% External dependencies
    TLSWatcher -->|reads profile| OSAPIServer["OpenShift APIServer<br/>Config"]
    Manager -->|all resource ops| KubeAPI["Kubernetes API<br/>6443/TCP"]
    MTLSController -->|provisions certs| CertManager["cert-manager"]
    Manager -->|gang scheduling| BatchScheduler["Volcano / YuniKorn /<br/>Kai"]

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style RayClusterReconciler fill:#4a90e2,color:#fff
    style RayJobReconciler fill:#4a90e2,color:#fff
    style RayServiceReconciler fill:#4a90e2,color:#fff
    style RayCronJobReconciler fill:#4a90e2,color:#fff
    style AuthController fill:#9b59b6,color:#fff
    style NetPolController fill:#9b59b6,color:#fff
    style MTLSController fill:#9b59b6,color:#fff
    style TLSWatcher fill:#9b59b6,color:#fff
    style MutatingWH fill:#e67e22,color:#fff
    style ValidatingWH fill:#e67e22,color:#fff
    style RayClusterCR fill:#f5a623
    style RayJobCR fill:#f5a623
    style RayServiceCR fill:#f5a623
    style RayCronJobCR fill:#f5a623
    style KubeAPI fill:#e8e8e8
    style CertManager fill:#e8e8e8
    style OSAPIServer fill:#e8e8e8
    style BatchScheduler fill:#e8e8e8
