graph TB
    subgraph KubeRayOperator["KubeRay Operator"]
        direction TB

        subgraph Controllers["Controllers"]
            RayClusterCtrl["RayCluster Controller"]
            RayJobCtrl["RayJob Controller"]
            RayServiceCtrl["RayService Controller"]
            RayCronJobCtrl["RayCronJob Controller"]
            mTLSCtrl["mTLS Controller"]
            AuthCtrl["Authentication Controller"]
            NetPolCtrl["NetworkPolicy Controller"]
        end

        subgraph Webhooks["Webhooks (9443/TCP)"]
            MutatingWH["RayCluster Mutating Webhook"]
            ValidatingWH_Cluster["RayCluster Validating Webhook"]
            ValidatingWH_Job["RayJob Validating Webhook"]
            ValidatingWH_Service["RayService Validating Webhook"]
        end

        MetricsEP["Metrics Endpoint\n8080/TCP"]
        HealthEP["Health Probes\n8082/TCP"]
    end

    %% CRDs
    RayClusterCR["RayCluster CR\nray.io/v1"]
    RayJobCR["RayJob CR\nray.io/v1"]
    RayServiceCR["RayService CR\nray.io/v1"]
    RayCronJobCR["RayCronJob CR\nray.io/v1"]
    ConfigCR["Configuration CR\nconfig.ray.io/v1alpha1"]

    %% User
    User["User / Data Scientist"]

    %% CRD → Controller watches
    RayClusterCR -->|watched by| RayClusterCtrl
    RayJobCR -->|watched by| RayJobCtrl
    RayServiceCR -->|watched by| RayServiceCtrl
    RayCronJobCR -->|watched by| RayCronJobCtrl
    RayClusterCR -->|watched by| mTLSCtrl
    RayClusterCR -->|watched by| AuthCtrl
    RayClusterCR -->|watched by| NetPolCtrl

    %% User creates CRDs
    User -->|creates| RayClusterCR
    User -->|creates| RayJobCR
    User -->|creates| RayServiceCR
    User -->|creates| RayCronJobCR

    %% Webhook validation
    RayClusterCR -.->|validated/mutated| MutatingWH
    RayClusterCR -.->|validated| ValidatingWH_Cluster
    RayJobCR -.->|validated| ValidatingWH_Job
    RayServiceCR -.->|validated| ValidatingWH_Service

    %% Controller creates resources
    RayClusterCtrl -->|creates| HeadPod["Head Pod\n+ kube-rbac-proxy sidecar"]
    RayClusterCtrl -->|creates| WorkerPods["Worker Pods"]
    RayClusterCtrl -->|creates| HeadSvc["{cluster}-head-svc\nClusterIP"]
    RayClusterCtrl -->|creates| ServeSvc["{cluster}-serve-svc\nClusterIP"]

    RayJobCtrl -->|creates| RayClusterCR
    RayJobCtrl -->|creates| SubmitterJob["Submitter Job"]
    RayServiceCtrl -->|manages| RayClusterCR
    RayCronJobCtrl -->|creates| RayJobCR

    AuthCtrl -->|creates| HTTPRoute["HTTPRoute\n(platform namespace)"]
    AuthCtrl -->|creates| RefGrant["ReferenceGrant"]
    AuthCtrl -->|creates| ProxySA["OIDC Proxy SA"]

    mTLSCtrl -->|creates| Issuer["cert-manager Issuer"]
    mTLSCtrl -->|creates| Certificate["cert-manager Certificate"]

    NetPolCtrl -->|creates| NetPol["NetworkPolicies\n(head + worker)"]

    %% External dependencies
    RayClusterCtrl -->|depends on| K8sAPI["Kubernetes API"]
    AuthCtrl -->|depends on| Gateway["Platform Gateway\n(data-science-gateway)"]
    mTLSCtrl -->|depends on| CertManager["cert-manager"]

    %% Monitoring
    Prometheus["Prometheus"] -->|scrapes| MetricsEP

    %% Styling
    style KubeRayOperator fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    style Controllers fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style Webhooks fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style RayClusterCR fill:#f5a623,stroke:#333
    style RayJobCR fill:#f5a623,stroke:#333
    style RayServiceCR fill:#f5a623,stroke:#333
    style RayCronJobCR fill:#f5a623,stroke:#333
    style ConfigCR fill:#f5a623,stroke:#333
    style HeadPod fill:#7ed321,stroke:#333
    style WorkerPods fill:#7ed321,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
