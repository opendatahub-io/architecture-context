graph TB
    subgraph OVMS["OpenVINO Model Server (OVMS)"]
        direction TB

        subgraph Frontends["API Frontends"]
            HTTPModule["HTTPServerModule<br/>(Drogon)<br/>rest_port/TCP"]
            GRPCModule["GRPCServerModule<br/>port/TCP"]
        end

        subgraph APILayers["API Protocol Layers"]
            V1["v1 API<br/>TF Serving Protocol"]
            V2["v2 API<br/>KServe Inference Protocol"]
            V3["v3 API<br/>OpenAI-compatible"]
        end

        subgraph Core["Core Engine"]
            ServableManager["ServableManagerModule<br/>Model lifecycle, versioning,<br/>hot-reload"]
            DAGEngine["DAG Pipeline Engine<br/>Multi-model pipelines"]
            MediaPipe["MediaPipe Integration<br/>Streaming graph execution"]
        end

        subgraph Runtime["Inference Runtime"]
            OpenVINORT["OpenVINO Runtime 2026.2<br/>Core inference engine"]
            OpenVINOGenAI["OpenVINO GenAI 2026.2<br/>LLM continuous batching"]
            OpenVINOTokenizers["OpenVINO Tokenizers 2026.2<br/>Tokenizer support"]
        end

        subgraph Extensions["Extension Modules"]
            PythonModule["PythonInterpreterModule<br/>(pybind11 / Python 3.12)"]
            CustomNodes["Custom Node Libraries<br/>(dlopen C/C++)"]
            HfPullModule["HfPullModelModule<br/>(libgit2 / curl)"]
        end

        subgraph Storage["Storage Backends"]
            FSAbstraction["Filesystem Abstraction"]
            LocalFS["Local FS"]
            S3FS["AWS S3"]
            GCSFS["GCS"]
            AzureFS["Azure Blob"]
        end

        subgraph Observability["Observability"]
            MetricModule["MetricModule<br/>Prometheus metrics"]
        end

        subgraph Library["Embeddable Library"]
            CAPI["libovms_shared.so<br/>C API"]
        end

        HTTPModule --> V1
        HTTPModule --> V2
        HTTPModule --> V3
        GRPCModule --> V1
        GRPCModule --> V2

        V1 --> ServableManager
        V2 --> ServableManager
        V3 --> MediaPipe

        ServableManager --> OpenVINORT
        DAGEngine --> OpenVINORT
        MediaPipe --> OpenVINOGenAI
        MediaPipe --> OpenVINOTokenizers
        MediaPipe --> OpenVINORT

        DAGEngine --> PythonModule
        DAGEngine --> CustomNodes
        MediaPipe --> PythonModule

        ServableManager --> FSAbstraction
        HfPullModule --> FSAbstraction
        FSAbstraction --> LocalFS
        FSAbstraction --> S3FS
        FSAbstraction --> GCSFS
        FSAbstraction --> AzureFS
    end

    %% External actors
    Client["Client<br/>(via Platform Ingress)"]
    KServe["KServe<br/>InferenceService Pod"]
    Prometheus["Prometheus<br/>Metrics Scraper"]
    HFHub["HuggingFace Hub"]

    Client -->|"HTTP REST"| HTTPModule
    Client -->|"gRPC"| GRPCModule
    KServe -->|"Container Runtime"| OVMS
    Prometheus -->|"GET /metrics"| MetricModule
    HfPullModule -->|"HTTPS/443"| HFHub

    %% Styling
    style OVMS fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style HTTPModule fill:#4a90e2,color:#fff
    style GRPCModule fill:#4a90e2,color:#fff
    style ServableManager fill:#4a90e2,color:#fff
    style DAGEngine fill:#4a90e2,color:#fff
    style MediaPipe fill:#4a90e2,color:#fff
    style OpenVINORT fill:#7b1fa2,color:#fff
    style OpenVINOGenAI fill:#7b1fa2,color:#fff
    style OpenVINOTokenizers fill:#7b1fa2,color:#fff
    style PythonModule fill:#f5a623
    style CustomNodes fill:#f5a623
    style HfPullModule fill:#f5a623
    style MetricModule fill:#4caf50,color:#fff
    style CAPI fill:#78909c,color:#fff
    style FSAbstraction fill:#26a69a,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style KServe fill:#7ed321,stroke:#333
    style Prometheus fill:#e65100,color:#fff
    style HFHub fill:#ffd54f,stroke:#333
