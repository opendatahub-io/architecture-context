graph TB
    subgraph OVMS["OpenVINO Model Server (C++ Binary)"]
        direction TB

        subgraph Frontends["API Frontends"]
            HTTPServer["HTTP/REST Frontend<br/>(Drogon)<br/>Port 8888/TCP"]
            GRPCServer["gRPC Frontend<br/>(GRPCServerModule)<br/>Port 8001/TCP"]
        end

        subgraph APIRoutes["API Families"]
            TFSv1["/v1/* TFS API<br/>predict, classify, regress"]
            KServev2["/v2/* KServe v2 API<br/>infer, ready, metadata"]
            OpenAIv3["/v3/* OpenAI API<br/>chat, completions, embeddings"]
            Metrics["/metrics<br/>Prometheus"]
        end

        subgraph GenAI["GenAI Modules (MediaPipe Calculators)"]
            LLM["LLM Module<br/>HttpLLMCalculator<br/>Continuous Batching"]
            Embeddings["Embeddings Module<br/>EmbeddingsCalculatorOv"]
            Rerank["Rerank Module<br/>RerankCalculatorOv"]
            ImageGen["Image Generation<br/>ImageGenCalculator"]
            STT["Speech-to-Text<br/>S2TCalculator"]
            TTS["Text-to-Speech<br/>T2SCalculator"]
        end

        subgraph Core["Core Engine"]
            ServableManager["Servable Manager<br/>Model Loading & Lifecycle"]
            DAGScheduler["DAG Scheduler<br/>Pipeline Engine"]
            MediaPipe["MediaPipe Integration<br/>Graph Orchestration"]
            PythonInterp["Python Interpreter<br/>(pybind11, optional)"]
            MetricModule["Metrics Module<br/>Prometheus Client"]
        end

        subgraph Storage["Storage Backends"]
            LocalFS["Local Filesystem"]
            S3Client["S3 Client<br/>(AWS SDK)"]
            GCSClient["GCS Client<br/>(GCS SDK)"]
            AzureClient["Azure Blob Client<br/>(Azure SDK 7.5)"]
            HFPull["HuggingFace Pull<br/>(libgit2)"]
        end

        subgraph Runtime["Inference Runtime"]
            OpenVINORT["OpenVINO Runtime 2026.2"]
            OpenVINOGenAI["OpenVINO GenAI 2026.2"]
            OpenVINOTok["OpenVINO Tokenizers 2026.2"]
        end
    end

    %% External connections
    HTTPServer --> TFSv1
    HTTPServer --> KServev2
    HTTPServer --> OpenAIv3
    HTTPServer --> Metrics

    GRPCServer --> KServev2
    GRPCServer --> TFSv1

    OpenAIv3 --> LLM
    OpenAIv3 --> Embeddings
    OpenAIv3 --> Rerank
    OpenAIv3 --> ImageGen
    OpenAIv3 --> STT
    OpenAIv3 --> TTS

    LLM --> MediaPipe
    Embeddings --> MediaPipe
    Rerank --> MediaPipe
    ImageGen --> MediaPipe
    STT --> MediaPipe
    TTS --> MediaPipe

    TFSv1 --> ServableManager
    KServev2 --> ServableManager

    ServableManager --> DAGScheduler
    ServableManager --> OpenVINORT
    MediaPipe --> OpenVINOGenAI
    OpenVINOGenAI --> OpenVINOTok
    OpenVINOGenAI --> OpenVINORT

    ServableManager --> LocalFS
    ServableManager --> S3Client
    ServableManager --> GCSClient
    ServableManager --> AzureClient
    ServableManager --> HFPull

    %% External systems
    KServe["KServe Controller"] -->|"deploys as<br/>ServingRuntime"| OVMS
    KubeRBACProxy["kube-rbac-proxy<br/>Sidecar (8443/TCP)"] -->|"proxies to"| HTTPServer
    Prometheus["Prometheus"] -->|"scrapes"| Metrics

    %% Styling
    style OVMS fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style HTTPServer fill:#4a90e2,color:#fff
    style GRPCServer fill:#4a90e2,color:#fff
    style LLM fill:#7ed321,color:#fff
    style Embeddings fill:#7ed321,color:#fff
    style Rerank fill:#7ed321,color:#fff
    style ImageGen fill:#7ed321,color:#fff
    style STT fill:#7ed321,color:#fff
    style TTS fill:#7ed321,color:#fff
    style OpenVINORT fill:#f5a623,color:#fff
    style OpenVINOGenAI fill:#f5a623,color:#fff
    style OpenVINOTok fill:#f5a623,color:#fff
    style KServe fill:#e8e8e8,stroke:#333
    style KubeRBACProxy fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
