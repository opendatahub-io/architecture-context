graph TB
    subgraph OVMS["OpenVINO Model Server"]
        direction TB

        subgraph ServerCore["Server Core"]
            Server["Server Singleton<br/>Orchestrates module lifecycle"]
            GRPCModule["GRPCServerModule<br/>grpc_port/TCP"]
            HTTPModule["HTTPServerModule<br/>Drogon Framework<br/>rest_port/TCP"]
            ServableManager["ServableManagerModule<br/>Model loading, versioning,<br/>hot-reload, DAG pipelines"]
            MetricModule["MetricModule<br/>Prometheus /metrics"]
            HfPullModule["HfPullModelModule<br/>HuggingFace downloads<br/>libgit2 + curl"]
        end

        subgraph APILayers["API Layers"]
            TFSAPI["TFS v1 API<br/>/v1/models/..."]
            KServeAPI["KServe v2 API<br/>/v2/models/... + gRPC"]
            OpenAIAPI["OpenAI v3 API<br/>/v3/v1/chat/completions<br/>/v3/v1/embeddings<br/>/v3/v1/images/generations"]
        end

        subgraph Servables["Servable Modules"]
            LLM["LLM Servable<br/>Continuous batching"]
            VLM["VLM Servable<br/>Vision+Text"]
            Embeddings["Embeddings Servable"]
            Rerank["Rerank Servable"]
            ImageGen["Image Generation Servable"]
            Audio["Audio Servable<br/>STT + TTS"]
        end

        Server --> GRPCModule
        Server --> HTTPModule
        Server --> ServableManager
        Server --> MetricModule
        Server --> HfPullModule

        HTTPModule --> TFSAPI
        HTTPModule --> KServeAPI
        HTTPModule --> OpenAIAPI
        GRPCModule --> KServeAPI

        OpenAIAPI --> LLM
        OpenAIAPI --> VLM
        OpenAIAPI --> Embeddings
        OpenAIAPI --> Rerank
        OpenAIAPI --> ImageGen
        OpenAIAPI --> Audio

        ServableManager --> LLM
        ServableManager --> VLM
        ServableManager --> Embeddings
        ServableManager --> Rerank
        ServableManager --> ImageGen
        ServableManager --> Audio
    end

    subgraph External["External Systems"]
        Client["Client / Application"]
        IstioGW["Istio Gateway<br/>TLS Termination"]
    end

    subgraph Platform["Platform Components"]
        KServe["KServe<br/>ServingRuntime CRD"]
        Prometheus["Prometheus<br/>Metrics Scraping"]
    end

    subgraph Storage["Model Storage"]
        S3["S3-compatible Storage"]
        GCS["Google Cloud Storage"]
        Azure["Azure Blob Storage"]
        HFHub["HuggingFace Hub"]
        LocalFS["Local Filesystem"]
    end

    subgraph Runtime["Inference Runtime"]
        OpenVINO["OpenVINO Runtime<br/>CPU / GPU / NPU"]
        GenAI["OpenVINO GenAI<br/>Continuous Batching"]
        MediaPipe["MediaPipe Graphs<br/>v3 API Routing"]
    end

    Client -->|"HTTPS/443"| IstioGW
    IstioGW -->|"HTTP/rest_port"| HTTPModule
    IstioGW -->|"gRPC/grpc_port"| GRPCModule
    KServe -->|"deploys as"| OVMS
    Prometheus -->|"scrapes"| MetricModule

    HfPullModule -->|"HTTPS/443"| HFHub
    ServableManager -->|"loads models"| S3
    ServableManager -->|"loads models"| GCS
    ServableManager -->|"loads models"| Azure
    ServableManager -->|"loads models"| LocalFS

    LLM --> GenAI
    VLM --> GenAI
    Embeddings --> OpenVINO
    Rerank --> OpenVINO
    ImageGen --> OpenVINO
    Audio --> OpenVINO
    OpenAIAPI --> MediaPipe

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style GRPCModule fill:#4a90e2,stroke:#333,color:#fff
    style HTTPModule fill:#4a90e2,stroke:#333,color:#fff
    style ServableManager fill:#4a90e2,stroke:#333,color:#fff
    style MetricModule fill:#4a90e2,stroke:#333,color:#fff
    style HfPullModule fill:#4a90e2,stroke:#333,color:#fff
    style LLM fill:#7ed321,stroke:#333
    style VLM fill:#7ed321,stroke:#333
    style Embeddings fill:#7ed321,stroke:#333
    style Rerank fill:#7ed321,stroke:#333
    style ImageGen fill:#7ed321,stroke:#333
    style Audio fill:#7ed321,stroke:#333
    style OpenVINO fill:#f5a623,stroke:#333
    style GenAI fill:#f5a623,stroke:#333
    style MediaPipe fill:#f5a623,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style IstioGW fill:#e8e8e8,stroke:#333
