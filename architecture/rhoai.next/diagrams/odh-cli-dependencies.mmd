graph LR
    ODHCLI["odh-cli<br/>(rhai-cli / kubectl-odh)"]

    %% External Dependencies (Required)
    ODHCLI -->|"HTTPS/6443<br/>ALL operations"| K8sAPI["Kubernetes API Server<br/>1.28+"]
    ODHCLI -->|"OpenShift APIs<br/>ClusterVersion, Routes"| OpenShift["OpenShift 4.x"]

    %% External Dependencies (Optional)
    ODHCLI -.->|"CSV/Subscription<br/>version detection"| OLM["OLM 0.39+"]
    ODHCLI -.->|"HTTPS/443<br/>deps --refresh"| ODHGitops["odh-gitops<br/>(GitHub)"]

    %% Internal RHOAI Dependencies (Read)
    ODHCLI -->|"CRD Read<br/>version, health, config"| RHOAIOp["RHOAI Operator<br/>(DSC, DSCI)"]
    ODHCLI -->|"Go library import"| ClusterHealth["clusterhealth pkg<br/>(in-process)"]

    %% Internal RHOAI Dependencies (Read/Write - Migration)
    ODHCLI -->|"CRD Read/Write<br/>v1alpha1→v1 migration"| DSP["Data Science Pipelines<br/>(DSPA)"]
    ODHCLI -->|"CRD Read/Write<br/>auth model, labels"| Notebooks["Notebooks"]
    ODHCLI -->|"CRD Read/Write<br/>RHBOK install, labeling"| Kueue["Kueue / RHBOK"]

    %% Internal RHOAI Dependencies (Read-only)
    ODHCLI -->|"CRD Read<br/>lint, migration"| KServe["KServe<br/>(InferenceService)"]
    ODHCLI -->|"CRD Read<br/>lint, backup"| Ray["Ray<br/>(RayCluster)"]
    ODHCLI -->|"HTTP REST<br/>metrics backup"| TrustyAI["TrustyAI"]
    ODHCLI -.->|"CRD Read<br/>lint checks"| GuardrailsOrch["Guardrails<br/>Orchestrator"]
    ODHCLI -.->|"CRD Read<br/>lint, migration"| LlamaStack["LlamaStack"]
    ODHCLI -.->|"CRD Read<br/>lint (removal)"| ModelMesh["ModelMesh"]
    ODHCLI -.->|"CRD Read<br/>lint (deprecation)"| TrainingOp["Training Operator<br/>(PyTorchJob, TFJob)"]

    %% Dashboard / Profiles
    ODHCLI -.->|"CRD Read<br/>profile migration"| Dashboard["ODH Dashboard<br/>(AcceleratorProfile,<br/>HardwareProfile)"]

    %% Security Dependencies
    ODHCLI -.->|"CRD Read<br/>cert validation"| CertManager["cert-manager"]
    ODHCLI -.->|"CRD Read<br/>mesh checks"| OSSM["OpenShift Service Mesh"]

    %% Consumers of odh-cli
    Operator["Platform Operator"] -->|"kubectl plugin"| ODHCLI
    AIAgent["AI Agent"] -->|"MCP Protocol"| ODHCLI

    %% Styling
    style ODHCLI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required external
    style K8sAPI fill:#e74c3c,stroke:#333,color:#fff
    style OpenShift fill:#e74c3c,stroke:#333,color:#fff

    %% Optional external
    style OLM fill:#999,stroke:#333,color:#fff
    style ODHGitops fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI - Read/Write
    style RHOAIOp fill:#7ed321,stroke:#333,color:#fff
    style DSP fill:#7ed321,stroke:#333,color:#fff
    style Notebooks fill:#7ed321,stroke:#333,color:#fff
    style Kueue fill:#7ed321,stroke:#333,color:#fff
    style ClusterHealth fill:#7ed321,stroke:#333,color:#fff

    %% Internal RHOAI - Read-only
    style KServe fill:#a8e6cf,stroke:#333,color:#333
    style Ray fill:#a8e6cf,stroke:#333,color:#333
    style TrustyAI fill:#a8e6cf,stroke:#333,color:#333
    style GuardrailsOrch fill:#a8e6cf,stroke:#333,color:#333
    style LlamaStack fill:#a8e6cf,stroke:#333,color:#333
    style ModelMesh fill:#a8e6cf,stroke:#333,color:#333
    style TrainingOp fill:#a8e6cf,stroke:#333,color:#333
    style Dashboard fill:#a8e6cf,stroke:#333,color:#333
    style CertManager fill:#a8e6cf,stroke:#333,color:#333
    style OSSM fill:#a8e6cf,stroke:#333,color:#333

    %% Consumers
    style Operator fill:#3498db,stroke:#333,color:#fff
    style AIAgent fill:#9b59b6,stroke:#333,color:#fff
