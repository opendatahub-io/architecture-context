graph LR
    ODHCLI["odh-cli / rhai-cli<br/>CLI Tool & kubectl Plugin"]

    %% Internal ODH Dependencies (Go library imports)
    ODHCLI -->|"Go import<br/>clusterhealth, failureclassifier, mcptools"| ODHOperator["opendatahub-operator"]
    ODHCLI -->|"Go import<br/>platform detection, OLM helpers"| PlatUtils["odh-platform-utilities"]

    %% Runtime Platform Dependencies
    ODHCLI -->|"API client<br/>CSV, Subscription lifecycle"| OLM["Operator Lifecycle Manager"]
    ODHCLI -->|"HTTPS fetch<br/>values.yaml at pinned commit"| ODHGitops["odh-gitops"]

    %% Kubernetes Dependencies
    ODHCLI -->|"HTTPS 6443/TCP<br/>All cluster operations"| K8sAPI["Kubernetes API Server"]
    ODHCLI -->|"HTTPS 443/TCP<br/>Metrics migration"| TrustYAI["TrustYAI Service"]

    %% Key Go Dependencies
    ODHCLI -->|"CLI framework"| Cobra["spf13/cobra v1.10.2"]
    ODHCLI -->|"MCP protocol"| MCPGo["mark3labs/mcp-go v0.55.1"]
    ODHCLI -->|"K8s client"| ClientGo["k8s.io/client-go v0.35.3"]
    ODHCLI -->|"Controller runtime"| CtrlRuntime["controller-runtime v0.23.3"]
    ODHCLI -->|"OLM API types"| OFApi["operator-framework/api v0.39.0"]
    ODHCLI -->|"JQ filtering"| GoJQ["itchyny/gojq v0.12.18"]
    ODHCLI -->|"Version parsing"| Semver["blang/semver v4.0.0"]

    %% Integration Points (inbound)
    MCPAgents["MCP-Capable Agents<br/>Claude, GPT, Cursor"] -->|"JSON-RPC<br/>stdio / SSE"| ODHCLI

