graph LR
    ODHCLI["rhai-cli<br/>(odh-cli)"]

    %% External Dependencies (Required)
    ODHCLI -->|"API client<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes /<br/>OpenShift 4.x"]
    ODHCLI -->|"operator mgmt"| OLM["OLM"]
    ODHCLI -->|"CLI framework"| Cobra["cobra v1.10.2"]
    ODHCLI -->|"K8s API client"| ClientGo["client-go v0.35.2"]
    ODHCLI -->|"typed API access"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    ODHCLI -->|"OLM types"| OpFramework["operator-framework<br/>/api v0.39.0"]
    ODHCLI -->|"JQ queries"| GoJQ["gojq v0.12.18"]
    ODHCLI -->|"table output"| TableWriter["tablewriter v1.1.3"]

    %% External Dependencies (Optional)
    ODHCLI -.->|"dep manifest<br/>443/TCP HTTPS"| OdhGitops["odh-gitops<br/>(GitHub)"]
    ODHCLI -.->|"MCP server lib"| McpGo["mcp-go v0.55.1"]

    %% Internal RHOAI Platform Dependencies (CRD Read)
    ODHCLI -->|"CRD Read<br/>DSC, DSCI"| RhodsOp["rhods-operator /<br/>odh-operator"]
    ODHCLI -->|"CRD R/W<br/>InferenceService"| KServe["KServe"]
    ODHCLI -->|"CRD R/W<br/>Notebook"| Notebooks["Kubeflow<br/>Notebooks"]
    ODHCLI -->|"CRD R/W<br/>ClusterQueue"| KueueComp["Kueue"]
    ODHCLI -->|"CRD R/W<br/>DSPA"| DSPipelines["Data Science<br/>Pipelines"]
    ODHCLI -->|"CRD R/W +<br/>REST API"| TrustyAI["TrustyAI"]
    ODHCLI -->|"CRD Read"| Training["Training<br/>Operator"]
    ODHCLI -->|"CRD R/W"| Ray["Ray"]
    ODHCLI -->|"CRD Read +<br/>Pod Exec"| LlamaStack["LlamaStack"]

    %% Infrastructure Dependencies (CRD Read)
    ODHCLI -.->|"CRD Read"| CertMgr["cert-manager"]
    ODHCLI -.->|"CRD Read"| OSSM["OpenShift<br/>Service Mesh"]
    ODHCLI -.->|"CRD Read"| Knative["Knative Serving"]
    ODHCLI -.->|"CRD Read"| Kuadrant["Kuadrant /<br/>Authorino"]

