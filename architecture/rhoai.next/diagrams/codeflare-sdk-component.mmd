graph TB
    subgraph UserEnv["User Environment (Notebook Pod / Local)"]
        direction TB
        subgraph SDK["CodeFlare SDK"]
            direction TB
            Cluster["Cluster<br/>(Python Class)<br/>Core lifecycle manager"]
            Config["ClusterConfiguration<br/>(Dataclass)<br/>CPU/Memory/GPU specs"]
            AWManager["AWManager<br/>(Python Class)<br/>AppWrapper submit/remove"]
            RayJobClient["RayJobClient<br/>(Python Class)<br/>Job submission wrapper"]
            GenerateCert["generate_cert<br/>(Module)<br/>TLS cert generation"]
            KueueInteg["Kueue Integration<br/>(Module)<br/>Queue discovery"]
            Widgets["Jupyter Widgets<br/>(Module)<br/>Interactive UI"]
            GenYAML["generate_yaml<br/>(Module)<br/>Template-based YAML gen"]
        end

        Config -->|configures| Cluster
        Cluster -->|uses| GenYAML
        Cluster -->|wraps with| AWManager
        Cluster -->|creates| RayJobClient
        Cluster -->|calls| GenerateCert
        Cluster -->|queries| KueueInteg
        Widgets -->|manages| Cluster
    end

    %% CRDs Created/Managed
    Cluster -->|creates/deletes| RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    AWManager -->|creates/deletes| AppWrapperCR["AppWrapper CR<br/>(workload.codeflare.dev/v1beta2)"]
    KueueInteg -->|queries| LocalQueueCR["LocalQueue CR<br/>(kueue.x-k8s.io/v1beta1)"]

    %% External Interactions
    Cluster -->|HTTPS/6443| K8sAPI["Kubernetes API Server"]
    RayJobClient -->|HTTPS/8265<br/>via Route| RayDashboard["Ray Head Dashboard"]
    GenerateCert -->|reads CA secret| K8sAPI

    %% Platform Components (indirect)
    RayClusterCR -->|watched by| KubeRay["KubeRay Operator"]
    AppWrapperCR -->|watched by| CFOperator["CodeFlare Operator"]
    LocalQueueCR -->|managed by| Kueue["Kueue Controller"]

    KubeRay -->|provisions| RayPods["Ray Head + Worker Pods"]
    CFOperator -->|schedules via| Kueue

    %% Styling
    style SDK fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Cluster fill:#2c6fbb,stroke:#333,color:#fff
    style Config fill:#2c6fbb,stroke:#333,color:#fff
    style AWManager fill:#2c6fbb,stroke:#333,color:#fff
    style RayJobClient fill:#2c6fbb,stroke:#333,color:#fff
    style GenerateCert fill:#2c6fbb,stroke:#333,color:#fff
    style KueueInteg fill:#2c6fbb,stroke:#333,color:#fff
    style Widgets fill:#2c6fbb,stroke:#333,color:#fff
    style GenYAML fill:#2c6fbb,stroke:#333,color:#fff
    style RayClusterCR fill:#f5a623,stroke:#333
    style AppWrapperCR fill:#f5a623,stroke:#333
    style LocalQueueCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style RayDashboard fill:#e8e8e8,stroke:#333
    style KubeRay fill:#7ed321,stroke:#333
    style CFOperator fill:#7ed321,stroke:#333
    style Kueue fill:#7ed321,stroke:#333
    style RayPods fill:#d5e8d4,stroke:#333
