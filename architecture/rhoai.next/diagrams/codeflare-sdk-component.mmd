graph TB
    subgraph "CodeFlare SDK"
        direction TB
        Codeflare["Codeflare<br/>(Entrypoint Facade)"]

        subgraph "Feature Layer"
            ClusterHandler["ClusterHandler<br/>(ray/cluster/)"]
            JobHandler["JobHandler<br/>(ray/rayjobs/)"]
        end

        subgraph "Foundation Layer (common/)"
            Auth["kube-authkit<br/>Auth Provider"]
            KueueInteg["Kueue Integration"]
            TLSGen["TLS Certificate<br/>Generator"]
            IngressDiscovery["Ingress Discovery<br/>(Routes/Gateway/GatewayConfig)"]
        end

        subgraph "Vendored"
            KubeRayClient["KubeRay Python Client<br/>(python-client)"]
        end

        Codeflare -->|"cf.clusters"| ClusterHandler
        Codeflare -->|"cf.jobs"| JobHandler
        Codeflare -->|"authenticates via"| Auth

        ClusterHandler -->|"lifecycle mgmt"| KueueInteg
        ClusterHandler -->|"dashboard URL"| IngressDiscovery
        ClusterHandler -->|"secure connections"| TLSGen

        JobHandler -->|"CR operations"| KubeRayClient
        JobHandler -->|"queue validation"| KueueInteg
    end

    User["Data Scientist / ML Engineer"] -->|"Python API"| Codeflare

    subgraph "Kubernetes Platform"
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
        KubeRayOp["KubeRay Operator"]
        KueueCtrl["Kueue Controller"]
    end

    subgraph "Consumed CRs"
        RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
        RayJobCR["RayJob CR<br/>(ray.io/v1)"]
        LocalQueueCR["LocalQueue CR<br/>(kueue.x-k8s.io)"]
    end

    subgraph "Ingress Resources"
        OSRoute["OpenShift Route"]
        HTTPRoute["Gateway API HTTPRoute"]
        GWConfig["RHOAI GatewayConfig"]
    end

    Auth -->|"Bearer/OIDC/SA"| K8sAPI
    ClusterHandler -->|"creates"| RayClusterCR
    JobHandler -->|"creates"| RayJobCR
    KueueInteg -->|"reads"| LocalQueueCR

    RayClusterCR -->|"watched by"| KubeRayOp
    RayJobCR -->|"watched by"| KubeRayOp
    LocalQueueCR -->|"managed by"| KueueCtrl

    IngressDiscovery -->|"checks"| OSRoute
    IngressDiscovery -->|"fallback"| HTTPRoute
    IngressDiscovery -->|"fallback"| GWConfig

    KubeRayOp -->|"creates"| RayHead["Ray Head Pod<br/>8265/TCP"]

