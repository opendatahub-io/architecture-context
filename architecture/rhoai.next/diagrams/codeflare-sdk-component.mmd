graph TB
    subgraph SDK["CodeFlare SDK (Python Client Library)"]
        direction TB

        subgraph Foundation["Foundation Layer"]
            Auth["kubernetes_cluster<br/>Kubernetes Auth<br/>(kube-authkit, OIDC, OAuth, token)"]
            Kueue["common.kueue<br/>Queue Discovery &<br/>Priority Validation"]
            GenCert["common.utils.generate_cert<br/>TLS Certificate Generation<br/>(RSA-3072, SHA-256)"]
        end

        subgraph Features["Feature Layer"]
            RayCluster["ray.cluster<br/>RayCluster CR Lifecycle<br/>(apply, down, status, wait_ready)"]
            RayJobs["ray.rayjobs<br/>RayJob CR Lifecycle<br/>(submit, stop, resubmit, delete)"]
            RayClient["ray.client<br/>Direct Job Submission<br/>(JobSubmissionClient wrapper)"]
        end

        subgraph UI["User Interface"]
            Widgets["common.widgets<br/>ipywidgets Jupyter UI<br/>Cluster Management"]
        end

        subgraph Vendored["Vendored"]
            KubeRayClient["vendored.python_client<br/>KubeRay Python Client<br/>(RayClusterApi, RayjobApi)"]
        end
    end

    %% Internal relationships
    RayCluster -->|uses| Auth
    RayCluster -->|uses| Kueue
    RayCluster -->|uses| GenCert
    RayJobs -->|uses| Auth
    RayJobs -->|uses| Kueue
    RayJobs -->|imports| KubeRayClient
    RayClient -->|uses| Auth
    Widgets -->|manages| RayCluster

    %% External CRDs
    User[Data Scientist<br/>Jupyter Notebook / Python Script] -->|creates| RayCluster
    User -->|submits| RayJobs
    User -->|connects| RayClient

    RayCluster -->|creates/deletes| RayClusterCR[RayCluster CR<br/>ray.io/v1]
    RayJobs -->|creates/manages| RayJobCR[RayJob CR<br/>ray.io/v1]

    %% External systems
    RayClusterCR -->|reconciled by| KubeRayOp[KubeRay Operator]
    RayJobCR -->|reconciled by| KubeRayOp
    Kueue -->|discovers| KueueCtrl[Kueue Controller<br/>LocalQueue / WorkloadPriorityClass]
    Auth -->|authenticates via| K8sAPI[Kubernetes API Server<br/>6443/TCP]
    GenCert -->|reads CA from| CASecret[KubeRay CA Secret]
    RayCluster -->|connects to| RayHead[Ray Head Node<br/>10001/TCP mTLS]
    RayCluster -->|checks| Dashboard[Ray Dashboard<br/>8265/TCP HTTPS]

    %% Styling
    style SDK fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Foundation fill:#e8f5e9,stroke:#2e7d32
    style Features fill:#fff3e0,stroke:#e65100
    style UI fill:#f3e5f5,stroke:#6a1b9a
    style Vendored fill:#fce4ec,stroke:#b71c1c
    style User fill:#fff9c4,stroke:#f57f17
    style RayClusterCR fill:#f5a623,stroke:#333
    style RayJobCR fill:#f5a623,stroke:#333
    style KubeRayOp fill:#999,stroke:#333
    style KueueCtrl fill:#999,stroke:#333
    style K8sAPI fill:#999,stroke:#333
    style CASecret fill:#999,stroke:#333
    style RayHead fill:#999,stroke:#333
    style Dashboard fill:#999,stroke:#333
