graph LR
    ai4rag["ai4rag<br/>RAG Optimization Engine"]

    %% Runtime Dependencies
    ai4rag -->|"text extraction + chunking"| Docling["docling-slim ~=2.121.0"]
    ai4rag -->|"agent framework"| LangChain["langchain >=1.4"]
    ai4rag -->|"LLM wrappers"| LCOpenAI["langchain-openai >=1.6"]
    ai4rag -->|"API client"| OpenAI["openai ~=2.53.0"]
    ai4rag -->|"optimizer"| PyGAM["pygam ~=0.12.0"]
    ai4rag -->|"evaluation"| RAGAS["ragas >=0.3"]
    ai4rag -->|"evaluation"| Unitxt["unitxt ~=1.26.1"]
    ai4rag -->|"data handling"| Pandas["pandas 2.2.*"]
    ai4rag -->|"validation"| Pydantic["pydantic 2.11.*"]

    %% Vector Store Clients
    ai4rag -->|"Milvus client"| PyMilvus["pymilvus ~=3.0.1"]
    ai4rag -->|"PostgreSQL async"| Asyncpg["asyncpg >=0.29"]
    ai4rag -->|"pgvector ext"| PGVector["pgvector ~=0.5.0"]
    ai4rag -->|"Neo4j driver"| Neo4jDriver["neo4j ~=6.3.0"]
    ai4rag -->|"graph RAG"| Neo4jGraphRAG["neo4j-graphrag >=1.0"]

    %% Storage
    ai4rag -->|"S3 client"| Boto3["boto3 >=1.28"]

    %% External Services
    ai4rag -->|"inference + embeddings"| MaaS["MaaS<br/>(OpenAI-Compatible)"]
    ai4rag -->|"vector search"| MilvusSvc["Milvus Server"]
    ai4rag -->|"vector search"| PGVectorSvc["PostgreSQL / pgvector"]
    ai4rag -->|"graph RAG"| Neo4jSvc["Neo4j"]
    ai4rag -->|"documents"| S3Svc["S3-Compatible Storage"]

    %% Starter Kit Dependencies
    StarterKit["Agentic RAG<br/>Starter Kit"] -->|"TokenReview auth"| K8sAPI["Kubernetes API"]
    ai4rag -->|"generates"| StarterKit

    %% Styling
    style ai4rag fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style Docling fill:#999,stroke:#333
    style LangChain fill:#999,stroke:#333
    style LCOpenAI fill:#999,stroke:#333
    style OpenAI fill:#999,stroke:#333
    style PyGAM fill:#999,stroke:#333
    style RAGAS fill:#999,stroke:#333
    style Unitxt fill:#999,stroke:#333
    style Pandas fill:#999,stroke:#333
    style Pydantic fill:#999,stroke:#333

    style PyMilvus fill:#999,stroke:#333
    style Asyncpg fill:#999,stroke:#333
    style PGVector fill:#999,stroke:#333
    style Neo4jDriver fill:#999,stroke:#333
    style Neo4jGraphRAG fill:#999,stroke:#333
    style Boto3 fill:#999,stroke:#333

    style MaaS fill:#f5a623,stroke:#333
    style MilvusSvc fill:#f5a623,stroke:#333
    style PGVectorSvc fill:#f5a623,stroke:#333
    style Neo4jSvc fill:#f5a623,stroke:#333
    style S3Svc fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333

    style StarterKit fill:#7ed321,stroke:#333
