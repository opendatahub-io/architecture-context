graph LR
    AI4RAG["ai4rag<br/>RAG Optimization Library"]

    %% External Dependencies (Python packages)
    AI4RAG -->|"embeddings, vector stores,<br/>chat completions"| OGXClient["ogx-client ~1.1.0"]
    AI4RAG -->|"PDF/DOCX/PPTX parsing"| Docling["docling ~2.107.0"]
    AI4RAG -->|"structure-aware chunking"| DoclingCore["docling-core ~2.84.0"]
    AI4RAG -->|"token-based chunking"| LangChainSplitters["langchain-text-splitters ~1.1.0"]
    AI4RAG -->|"in-memory vector store"| LangChainChroma["langchain_chroma ~1.1.0"]
    AI4RAG -->|"RAG evaluation metrics"| Unitxt["unitxt ~1.26.1"]
    AI4RAG -->|"GAM optimization"| PyGAM["pygam ~0.12.0"]
    AI4RAG -->|"categorical encoding"| ScikitLearn["scikit-learn 1.8.*"]
    AI4RAG -->|"data manipulation"| Pandas["pandas 2.2.*"]
    AI4RAG -->|"validation"| Pydantic["pydantic 2.11.*"]
    AI4RAG -->|"S3 storage access"| Boto3["boto3 >=1.28"]
    AI4RAG -->|"parallel processing"| Multiprocess["multiprocess >=0.70"]

    %% Internal Platform Dependencies (runtime services)
    AI4RAG ==>|"REST API<br/>HTTPS/443<br/>API Key auth"| OGXServer["OGX Server<br/>(inference, embeddings,<br/>vector store CRUD)"]
    AI4RAG ==>|"REST API<br/>HTTPS/443<br/>AWS IAM auth"| S3["S3-Compatible Storage<br/>(document discovery,<br/>benchmark data)"]

    %% In-process dependencies (no network)
    AI4RAG -.->|"in-memory"| ChromaDB["ChromaDB<br/>(local pre-selection)"]

    %% Consumers (who depends on ai4rag)
    KFP["KFP Pipelines<br/>(RHOAI)"] -->|"imports as<br/>Python package"| AI4RAG

    %% Styling
    style AI4RAG fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

