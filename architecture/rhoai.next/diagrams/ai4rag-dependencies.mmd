graph LR
    AI4RAG["ai4rag<br/>RAG Optimization Engine"]

    %% Internal Platform Dependencies
    AI4RAG -->|"inference, embeddings,<br/>vector store CRUD<br/>(HTTPS, API Key)"| OGX["OGX Server"]
    AI4RAG -->|"document & artifact<br/>persistence<br/>(HTTPS/443, AWS IAM)"| S3["S3-compatible Storage"]

    %% Core Python Dependencies
    AI4RAG -->|"OGX API client<br/>~1.1.0"| OGXClient["ogx-client"]
    AI4RAG -->|"document parsing<br/>~2.107.0"| Docling["docling"]
    AI4RAG -->|"DoclingDocument +<br/>HybridChunker ~2.84.0"| DoclingCore["docling-core"]
    AI4RAG -->|"text chunking<br/>~1.1.0"| LCTextSplitters["langchain-text-splitters"]
    AI4RAG -->|"ChromaDB wrapper<br/>~1.1.0"| LCChroma["langchain-chroma"]

    %% ML / Optimization Dependencies
    AI4RAG -->|"GAM optimizer<br/>~0.12.0"| PyGAM["pygam"]
    AI4RAG -->|"LabelEncoder<br/>1.8.*"| SKLearn["scikit-learn"]
    AI4RAG -->|"RAG eval metrics<br/>~1.26.1"| Unitxt["unitxt"]

    %% Data / Infrastructure Dependencies
    AI4RAG -->|"S3 client<br/>>=1.28"| Boto3["boto3"]
    AI4RAG -->|"DataFrames<br/>2.2.*"| Pandas["pandas"]
    AI4RAG -->|"validation<br/>2.11.*"| Pydantic["pydantic"]
    AI4RAG -->|"parallel ops<br/>>=0.70"| Multiprocess["multiprocess"]

    %% Transitive Dependencies
    OGXClient -.->|"HTTP client"| HTTPX["httpx"]
    PyGAM -.->|"numerics"| NumPy["numpy"]

    %% Integration Points (consumers)
    KFP["Kubeflow Pipelines"] -.->|"KFPEventHandler<br/>(in-process callback)"| AI4RAG
    ChromaDB["ChromaDB<br/>(in-memory)"] -.->|"local dev<br/>vector store"| LCChroma

    %% Styling
    style AI4RAG fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal platform
    style OGX fill:#7ed321,stroke:#333,color:#fff
    style S3 fill:#7ed321,stroke:#333,color:#fff

    %% Core dependencies
    style OGXClient fill:#f5a623,stroke:#333,color:#fff
    style Docling fill:#f5a623,stroke:#333,color:#fff
    style DoclingCore fill:#f5a623,stroke:#333,color:#fff
    style LCTextSplitters fill:#f5a623,stroke:#333,color:#fff
    style LCChroma fill:#f5a623,stroke:#333,color:#fff

    %% ML dependencies
    style PyGAM fill:#9b59b6,stroke:#333,color:#fff
    style SKLearn fill:#9b59b6,stroke:#333,color:#fff
    style Unitxt fill:#9b59b6,stroke:#333,color:#fff

    %% Data/infra dependencies
    style Boto3 fill:#999,stroke:#333,color:#fff
    style Pandas fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style Multiprocess fill:#999,stroke:#333,color:#fff

    %% Transitive
    style HTTPX fill:#ccc,stroke:#333
    style NumPy fill:#ccc,stroke:#333

    %% Consumers
    style KFP fill:#2ecc71,stroke:#333,color:#fff
    style ChromaDB fill:#ccc,stroke:#333
