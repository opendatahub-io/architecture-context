    style OGXClient fill:#f5a623,stroke:#333
    style Docling fill:#f5a623,stroke:#333
    style DoclingCore fill:#f5a623,stroke:#333
    style LangChainSplitters fill:#f5a623,stroke:#333
    style LangChainChroma fill:#f5a623,stroke:#333
    style Unitxt fill:#f5a623,stroke:#333
    style PyGAM fill:#f5a623,stroke:#333
    style ScikitLearn fill:#f5a623,stroke:#333
    style Pandas fill:#f5a623,stroke:#333
    style Pydantic fill:#f5a623,stroke:#333
    style Boto3 fill:#f5a623,stroke:#333
    style Multiprocess fill:#f5a623,stroke:#333

