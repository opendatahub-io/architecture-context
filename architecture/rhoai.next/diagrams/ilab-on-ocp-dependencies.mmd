graph LR
    IlabOnOcp["ilab-on-ocp<br/>(Pipeline Application)"]

    %% Internal RHOAI Dependencies
    IlabOnOcp -->|pipeline hosting| DSPA["Data Science Pipelines<br/>Application"]
    IlabOnOcp -->|model serving<br/>teacher + judge| KServe["KServe<br/>InferenceService"]
    IlabOnOcp -->|distributed training<br/>PyTorchJob| TrainingOp["Kubeflow Training<br/>Operator"]
    IlabOnOcp -->|model registration| ModelReg["Model Registry"]

    %% Platform Dependencies
    IlabOnOcp -->|secrets, resources| K8sAPI["Kubernetes API"]

    %% External Service Dependencies
    IlabOnOcp -->|Modelcar images| OCIReg["OCI Registry"]
    IlabOnOcp -->|taxonomy data| GitRepo["Git Repository"]

    %% Python Library Dependencies
    IlabOnOcp -->|pipeline SDK| KFP["kfp 2.13.0"]
    IlabOnOcp -->|K8s extensions| KFPKube["kfp-kubernetes 1.5.0"]
    IlabOnOcp -->|cluster client| K8sClient["kubernetes 30.1.0"]
    IlabOnOcp -->|HTTP client| HTTPX["httpx 0.28.1"]
    IlabOnOcp -->|training SDK| KFTrain["kubeflow-training 1.8.1"]
    IlabOnOcp -->|registry SDK| MRClient["model-registry 0.2.17"]
    IlabOnOcp -->|OCI layers| OLOT["olot 0.1.2"]

    %% Runtime Image Dependencies
    IlabOnOcp -.->|SDG runtime| InstructLabSDG["instructlab.sdg<br/>(RHELAI image)"]
    IlabOnOcp -.->|training runtime| InstructLabTrain["instructlab.training<br/>(RHELAI image)"]
    IlabOnOcp -.->|eval runtime| InstructLabEval["instructlab.eval<br/>(RHELAI image)"]
    IlabOnOcp -.->|image tool| Skopeo["skopeo<br/>(dnf)"]

    %% Integration consumers
    Dashboard["ODH Dashboard"] -.->|pipeline UI| DSPA

