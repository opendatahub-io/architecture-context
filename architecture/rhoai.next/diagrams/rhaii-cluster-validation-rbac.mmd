graph TD
    subgraph UserContext["Controller Context (User Workstation)"]
        AdminKubeconfig["Admin kubeconfig<br/>(invoking user's credentials)"]
    end

    subgraph ControllerPerms["Controller Permissions (via admin kubeconfig)"]
        direction TB

        subgraph CoreAPI["API Group: core ('')"]
            Nodes["nodes<br/>list, get"]
            Namespaces["namespaces<br/>create, get"]
            ConfigMaps["configmaps<br/>create, get, update"]
            PodsLogs["pods, pods/log<br/>list, get"]
            Secrets["secrets<br/>get"]
            ServiceAccounts["serviceaccounts<br/>create, get, update, delete"]
            Events["events<br/>list"]
        end

        subgraph BatchAPI["API Group: batch"]
            Jobs["jobs<br/>create, get, list, delete"]
        end

        subgraph RBACAPI["API Group: rbac.authorization.k8s.io"]
            ClusterRoles["clusterroles<br/>create, delete"]
            ClusterRoleBindings["clusterrolebindings<br/>create, delete"]
        end

        subgraph ApiExtAPI["API Group: apiextensions.k8s.io"]
            CRDs["customresourcedefinitions<br/>list, get"]
        end
    end

    AdminKubeconfig -->|"authenticates as"| ControllerPerms

    subgraph WorkloadContext["Workload Pod Context (in-cluster)"]
        SA["ServiceAccount<br/>rhaii-validator<br/>(namespace: rhaii-validation)"]
    end

    subgraph ClusterRoleBindingsSection["ClusterRole Bindings"]
        CRB1["rhaii-validator<br/>(ClusterRoleBinding)"]
        CRB2["rhaii-validator-scc<br/>(ClusterRoleBinding)<br/>OpenShift only"]
    end

    subgraph ClusterRolesSection["ClusterRoles"]
        CR_Empty["rhaii-validator<br/>(ClusterRole)<br/>RULES: EMPTY"]
        CR_SCC["system:openshift:scc:privileged<br/>(ClusterRole)<br/>Grants privileged SCC"]
    end

    subgraph PodSecurity["Pod Security Context"]
        PrivContainer["privileged: true<br/>readOnlyRootFilesystem: true<br/>automountServiceAccountToken: false"]
    end

    SA -->|"bound via"| CRB1
    CRB1 -->|"grants"| CR_Empty
    SA -->|"bound via (OCP)"| CRB2
    CRB2 -->|"grants"| CR_SCC
    SA -->|"runs pods with"| PodSecurity

    subgraph SecurityNote["Security Design"]
        Note1["Workload pods have ZERO K8s API access"]
        Note2["Empty ClusterRole exists solely for SCC binding"]
        Note3["All API calls via controller's admin kubeconfig"]
        Note4["SA token not mounted in pods"]
    end

    CR_Empty -.->|"design rationale"| SecurityNote

    %% Styling
    style AdminKubeconfig fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Empty fill:#f5a623,stroke:#333
    style CR_SCC fill:#f5a623,stroke:#333
    style CRB1 fill:#e8e8e8,stroke:#333
    style CRB2 fill:#e8e8e8,stroke:#333
    style PrivContainer fill:#e1d5e7,stroke:#9673a6
    style Nodes fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style PodsLogs fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style ServiceAccounts fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
    style Jobs fill:#7ed321,stroke:#333
    style ClusterRoles fill:#7ed321,stroke:#333
    style ClusterRoleBindings fill:#7ed321,stroke:#333
    style CRDs fill:#7ed321,stroke:#333
    style Note1 fill:#fff3cd,stroke:#856404
    style Note2 fill:#fff3cd,stroke:#856404
    style Note3 fill:#fff3cd,stroke:#856404
    style Note4 fill:#fff3cd,stroke:#856404
