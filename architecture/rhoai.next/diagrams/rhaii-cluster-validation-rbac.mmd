graph TD
    subgraph UserAuth["USER AUTHENTICATION"]
        Admin["Cluster Admin<br/>(kubeconfig)"]
    end

    subgraph ServiceAccounts["Service Account"]
        SA["rhaii-validator<br/>Namespace: rhaii-validation"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["rhaii-validator<br/>(cluster-scoped)"]
        CRB2["rhaii-validator-scc-{namespace}<br/>(cluster-scoped, OCP only)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["rhaii-validator<br/>(intentionally empty)"]
        CR2["system:openshift:scc:privileged<br/>(OpenShift built-in)"]
    end

    subgraph SecurityContextConstraints["Security Context (OCP)"]
        SCC["privileged SCC<br/>Allows: privileged containers,<br/>host filesystem access,<br/>GPU/RDMA device access"]
    end

    subgraph PodSecurity["Pod Security Settings"]
        CheckPods["Check Job Pods<br/>privileged: true<br/>automountServiceAccountToken: false"]
        BWPods["Bandwidth Job Pods<br/>automountServiceAccountToken: false"]
    end

    subgraph K8sAPIAccess["Kubernetes API Access"]
        direction LR
        Nodes["Nodes<br/>list"]
        Jobs["Jobs<br/>create, get, list,<br/>watch, delete"]
        Pods["Pods<br/>get, list, logs"]
        CMs["ConfigMaps<br/>create, get, update"]
        NS["Namespaces<br/>create, get, delete"]
        SAs["ServiceAccounts<br/>create, get, delete"]
        CRDs["CRDs<br/>get (apiextensions)"]
        RBAC["ClusterRoles/Bindings<br/>create, get, delete"]
    end

    %% SA bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via<br/>(OCP only)"| CRB2
    CRB1 -->|"grants"| CR1
    CRB2 -->|"grants"| CR2

    %% CR effects
    CR1 -.->|"empty rules<br/>(SCC subject only)"| SA
    CR2 -->|"enables"| SCC
    SCC -->|"allows"| CheckPods
    SCC -->|"allows"| BWPods

    %% Admin access (actual API calls)
    Admin -->|"kubeconfig Bearer Token<br/>(all K8s API calls use<br/>admin credentials,<br/>NOT ServiceAccount)"| Nodes
    Admin --> Jobs
    Admin --> Pods
    Admin --> CMs
    Admin --> NS
    Admin --> SAs
    Admin --> CRDs
    Admin --> RBAC

    %% Styling
    style Admin fill:#08427B,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB1 fill:#f5a623,stroke:#333
    style CRB2 fill:#f5a623,stroke:#333
    style CR1 fill:#e8e8e8,stroke:#333
    style CR2 fill:#e8e8e8,stroke:#333
    style SCC fill:#f8cecc,stroke:#b85450
    style CheckPods fill:#f8cecc,stroke:#b85450
    style BWPods fill:#fff2cc,stroke:#d6b656
    style Nodes fill:#d5e8d4,stroke:#82b366
    style Jobs fill:#d5e8d4,stroke:#82b366
    style Pods fill:#d5e8d4,stroke:#82b366
    style CMs fill:#d5e8d4,stroke:#82b366
    style NS fill:#d5e8d4,stroke:#82b366
    style SAs fill:#d5e8d4,stroke:#82b366
    style CRDs fill:#d5e8d4,stroke:#82b366
    style RBAC fill:#d5e8d4,stroke:#82b366
