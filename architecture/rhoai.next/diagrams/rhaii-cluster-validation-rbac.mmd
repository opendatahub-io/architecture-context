graph TD
    subgraph "Service Account"
        SA["rhaii-validator<br/>Namespace: rhaii-validation"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["rhaii-validator<br/>(cluster-scoped)"]
        CRB2["rhaii-validator-scc-namespace<br/>(cluster-scoped, OCP only)"]
    end

    subgraph "ClusterRoles"
        CR1["rhaii-validator<br/>(INTENTIONALLY EMPTY)"]
        CR2["system:openshift:scc:privileged<br/>(OCP built-in)"]
    end

    subgraph "Effective Permissions"
        direction TB
        SCC["Privileged SCC<br/>(OpenShift only)"]
        NoK8sAPI["No Kubernetes API Access<br/>(SA tokens disabled on pods)"]
    end

    subgraph "Actual API Access"
        direction TB
        AdminCreds["Invoking User's<br/>kubeconfig Credentials"]
    end

    subgraph "Kubernetes API Operations"
        Nodes["core<br/>Nodes<br/>list"]
        Jobs["batch<br/>Jobs<br/>create, get, list, delete"]
        Pods["core<br/>Pods<br/>get, list, logs"]
        ConfigMaps["core<br/>ConfigMaps<br/>create, get, update"]
        CRDs["apiextensions<br/>CRDs<br/>get"]
        RBAC["rbac.authorization.k8s.io<br/>ClusterRole, ClusterRoleBinding<br/>create, delete"]
        Namespaces["core<br/>Namespaces<br/>create, get, delete"]
    end

    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    CRB1 -->|"grants"| CR1
    CRB2 -->|"grants"| CR2

    CR1 -->|"empty rules"| NoK8sAPI
    CR2 -->|"grants"| SCC

    AdminCreds -->|"Bearer Token"| Nodes
    AdminCreds -->|"Bearer Token"| Jobs
    AdminCreds -->|"Bearer Token"| Pods
    AdminCreds -->|"Bearer Token"| ConfigMaps
    AdminCreds -->|"Bearer Token"| CRDs
    AdminCreds -->|"Bearer Token"| RBAC
    AdminCreds -->|"Bearer Token"| Namespaces

    style SA fill:#4a90e2,color:#fff
    style CR1 fill:#f5a623,color:#fff
    style CR2 fill:#e74c3c,color:#fff
    style SCC fill:#e74c3c,color:#fff
    style NoK8sAPI fill:#95a5a6,color:#fff
    style AdminCreds fill:#27ae60,color:#fff
    style Nodes fill:#7ed321,color:#fff
    style Jobs fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style CRDs fill:#7ed321,color:#fff
    style RBAC fill:#7ed321,color:#fff
    style Namespaces fill:#7ed321,color:#fff
