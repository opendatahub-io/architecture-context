graph LR
    TGIS["Text Generation<br/>Inference Server<br/>(TGIS)"]

    %% Internal RHOAI Dependencies
    TGIS -->|"deployed as<br/>ServingRuntime"| KServe["KServe / ModelMesh"]

    %% Integration Points (consumers)
    Caikit["Caikit Runtime"] -->|"gRPC client<br/>:8033"| TGIS
    KServe -->|"routes inference<br/>requests"| TGIS

    %% Rust Dependencies
    subgraph RustDeps["Rust Dependencies"]
        axum["axum 0.6.20<br/>(HTTP framework)"]
        tonic["tonic 0.11.0<br/>(gRPC framework)"]
        tokio["tokio 1.37.0<br/>(async runtime)"]
        rustls["rustls 0.22.4<br/>(TLS provider)"]
        tokenizers["tokenizers 0.19.1<br/>(HF tokenizer)"]
        prost["prost 0.12.4<br/>(protobuf)"]
        promExporter["metrics-exporter-prometheus<br/>0.14.0"]
    end

    %% Python Dependencies
    subgraph PythonDeps["Python Dependencies"]
        transformers["transformers 4.40.2<br/>(model loading)"]
        torch["torch 2.2.1+cu121<br/>(deep learning)"]
        grpcio["grpcio 1.62.2<br/>(gRPC server)"]
        safetensors["safetensors 0.4.3+<br/>(tensor format)"]
        flashAttn["flash-attn 2.5.6<br/>(optional)"]
        autoGPTQ["auto-gptq 0.7.1<br/>(optional)"]
        accelerate["accelerate 0.27.2<br/>(optional)"]
        ibmFMS["ibm-fms<br/>(optional engine)"]
    end

    %% System Dependencies
    subgraph SystemDeps["System / Hardware"]
        cuda["CUDA 12.1.0"]
        nccl["NCCL 2.18.3<br/>(multi-GPU)"]
        openssl["OpenSSL<br/>(via UBI 9)"]
    end

    TGIS -->|"HTTP server"| axum
    TGIS -->|"gRPC server + client"| tonic
    TGIS -->|"async runtime"| tokio
    TGIS -->|"TLS (non-FIPS)"| rustls
    TGIS -->|"input validation"| tokenizers
    TGIS -->|"protobuf serialization"| prost
    TGIS -->|"metrics export"| promExporter
    TGIS -->|"model loading"| transformers
    TGIS -->|"GPU inference"| torch
    TGIS -->|"shard gRPC"| grpcio
    TGIS -->|"tensor I/O"| safetensors
    TGIS -.->|"optimized attention"| flashAttn
    TGIS -.->|"quantization"| autoGPTQ
    TGIS -.->|"multi-GPU loading"| accelerate
    TGIS -.->|"IBM engine"| ibmFMS
    TGIS -->|"GPU compute"| cuda
    TGIS -->|"tensor parallel"| nccl
    TGIS -->|"system TLS"| openssl

    %% External Services
    Prometheus["Prometheus /<br/>OpenShift Monitoring"] -->|"HTTP scrape<br/>:3000/metrics"| TGIS
    TGIS -.->|"OTLP traces"| OTLPCollector["OpenTelemetry<br/>Collector"]
    TGIS -.->|"model downloads<br/>(disabled at runtime)"| HFHub["HuggingFace Hub"]
    TGIS -->|"model cache"| PVC["PVC Storage"]

