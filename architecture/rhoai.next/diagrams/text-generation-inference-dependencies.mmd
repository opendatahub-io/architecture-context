graph LR
    TGIS["Text Generation<br/>Inference Server<br/>(TGIS)"]

    %% Internal RHOAI Dependencies (upstream consumers)
    KServe["KServe<br/>InferenceService"] -->|"gRPC/8033<br/>inference runtime"| TGIS
    Caikit["Caikit Runtime"] -->|"gRPC/8033<br/>wraps TGIS"| TGIS

    %% Core Runtime Dependencies
    TGIS -->|"GPU compute"| CUDA["NVIDIA CUDA<br/>12.1.0"]
    TGIS -->|"tensor parallelism<br/>shared memory / NVLink"| NCCL["NCCL<br/>2.18.3"]
    TGIS -->|"deep learning framework"| PyTorch["PyTorch<br/>2.2.1+cu121"]
    TGIS -->|"model loading &<br/>tokenization"| HFTransformers["HuggingFace<br/>Transformers 4.40.2"]
    TGIS -->|"gRPC protocol"| Protobuf["Protobuf<br/>4.25.3+"]

    %% Optional Performance Dependencies
    TGIS -.->|"optimized attention<br/>(optional)"| FlashAttn["Flash Attention v2<br/>2.5.6"]
    TGIS -.->|"GPTQ quantization<br/>(optional)"| AutoGPTQ["Auto-GPTQ<br/>0.7.1"]
    TGIS -.->|"gpt_megatron models<br/>(optional)"| IBMFMS["IBM FMS<br/>^0.0"]
    TGIS -.->|"paged attention<br/>(optional)"| FMSExtras["fms-extras<br/>git:d41f8a3"]
    TGIS -.->|"distributed tracing<br/>(optional)"| OTel["OpenTelemetry<br/>0.22.0"]

    %% Platform Integration
    Prometheus["Prometheus /<br/>OpenShift Monitoring"] -->|"HTTP/3000<br/>/metrics scrape"| TGIS
    OTelCollector["OpenTelemetry<br/>Collector"] <-.->|"gRPC trace export<br/>(optional)"| TGIS

    %% External Services
    TGIS -.->|"model download<br/>HTTPS/443<br/>(offline in prod)"| HFHub["HuggingFace Hub"]
    TGIS -->|"model weights<br/>read-only PVC"| ModelStorage["Model Storage<br/>(PVC)"]

