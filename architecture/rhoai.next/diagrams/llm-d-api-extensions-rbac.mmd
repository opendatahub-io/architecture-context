graph TD
    subgraph NoRBAC["llm-d-api-extensions: No RBAC"]
        direction TB

        Note["This component is a Python library,<br/>not a Kubernetes workload.<br/><br/>No ServiceAccounts, ClusterRoles,<br/>or RoleBindings are defined.<br/><br/>Access control is entirely delegated<br/>to the host vLLM deployment."]
    end

    subgraph InheritedSecurity["Inherited Security Model"]
        direction TB

        VLLMServer["vLLM Server Deployment<br/>(Kubernetes Pod)"]
        VLLMServiceAccount["vLLM ServiceAccount<br/>(deployment-defined)"]
        NetworkPolicy["Network Policy<br/>(deployment-defined)"]
        AuthConfig["vLLM Auth Config<br/>(server-level)"]

        VLLMServer -->|runs as| VLLMServiceAccount
        VLLMServer -->|protected by| NetworkPolicy
        VLLMServer -->|authenticates via| AuthConfig
    end

    subgraph DataProtection["Data Protection"]
        direction TB

        ConfigEndpoint["/config endpoint"]
        RedactionDefault["kv_connector_extra_config<br/>values REDACTED by default"]
        RedactionOverride["Override via env var:<br/>LLM_D_INTROSPECTION_EXPOSE_KV_EXTRA_CONFIG=1"]

        ConfigEndpoint -->|applies| RedactionDefault
        RedactionDefault -.->|operator override| RedactionOverride
    end

    %% Styling
    style Note fill:#fff3cd,stroke:#856404
    style VLLMServer fill:#d5e8d4,stroke:#82b366
    style VLLMServiceAccount fill:#d5e8d4,stroke:#82b366
    style NetworkPolicy fill:#d5e8d4,stroke:#82b366
    style AuthConfig fill:#d5e8d4,stroke:#82b366
    style ConfigEndpoint fill:#dae8fc,stroke:#6c8ebf
    style RedactionDefault fill:#d4edda,stroke:#155724
    style RedactionOverride fill:#f8d7da,stroke:#721c24
