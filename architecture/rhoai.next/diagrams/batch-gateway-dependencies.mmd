graph LR
    BatchGateway["Batch Gateway<br/>(API Server + Processor + GC)"]

    %% External Dependencies - Data Layer
    BatchGateway -->|"metadata storage<br/>TCP"| PostgreSQL["PostgreSQL<br/>(pgx v5.11.0)"]
    BatchGateway -->|"priority queue<br/>events<br/>TCP"| Redis["Redis/Valkey<br/>(go-redis v9.22.0)"]
    BatchGateway -->|"file storage<br/>HTTP/HTTPS"| S3["S3-Compatible Storage<br/>(AWS SDK v1.47.1)"]

    %% Internal Platform Dependencies
    BatchGateway -->|"inference dispatch<br/>(sync mode)<br/>HTTP/HTTPS"| LLMd["llm-d Inference Gateway"]
    BatchGateway -->|"inference dispatch<br/>(async mode)<br/>Redis queues"| LLMdAsync["llm-d-async<br/>(v0.9.1)"]

    %% Platform Dependencies
    BatchGateway -->|"pod watching<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>(client-go v0.36.4)"]
    BatchGateway -->|"tracing<br/>OTLP/gRPC"| OTel["OpenTelemetry Collector<br/>(otel v1.47.0)"]

    %% Upstream Integration
    UpstreamGW["Upstream Gateway<br/>(Kuadrant/Authorino)"] -->|"auth + tenant ID<br/>HTTP/HTTPS"| BatchGateway

    %% Build Dependencies
    BatchGateway -.->|"HTTP client"| Resty["go-resty v2.17.2"]
    BatchGateway -.->|"metrics"| Prometheus["prometheus/client_golang<br/>v1.24.1"]
    BatchGateway -.->|"retry logic"| Backoff["cenkalti/backoff v5.0.3"]

