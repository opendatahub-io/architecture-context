graph LR
    BG["Batch Gateway<br/>(apiserver + processor + gc)"]

    %% Required External Dependencies
    BG -->|"metadata CRUD<br/>TCP/5432"| PostgreSQL["PostgreSQL<br/>(any version)<br/>Required"]
    BG -->|"queue, events, status<br/>TCP/6379"| Redis["Redis / Valkey<br/>(any version)<br/>Required"]
    BG -->|"inference dispatch<br/>HTTP(S)/configurable"| InferenceGW["LLM Inference Gateway<br/>(vLLM, GIE/EPP)<br/>Required"]

    %% Optional External Dependencies
    BG -.->|"file storage<br/>HTTPS/443"| S3["S3-compatible Store<br/>(any version)<br/>Optional (alt: fs PVC)"]
    BG -.->|"TLS certs<br/>Certificate CR"| CertManager["cert-manager<br/>v1<br/>Optional"]
    BG -.->|"metrics scrape<br/>ServiceMonitor/PodMonitor"| PromOperator["Prometheus Operator<br/>(any version)<br/>Optional"]
    BG -.->|"distributed tracing<br/>gRPC/4317"| OTel["OpenTelemetry Collector<br/>(any version)<br/>Optional"]

    %% Internal Platform Dependencies
    BG -->|"inference routing<br/>x-gateway-inference-objective"| GIE["llm-d Gateway<br/>Inference Extension<br/>(GIE/EPP)"]
    BG -.->|"async dispatch<br/>Go library v0.7.4"| LlmdAsync["llm-d-async<br/>Producer Library<br/>Optional (async mode)"]

    %% Integration Points (consumers of batch-gateway)
    Prometheus["Prometheus"] -.->|"scrape /metrics<br/>HTTP/8081,9090,9091"| BG
    Grafana["Grafana"] -.->|"dashboard ConfigMap<br/>sidecar auto-load"| BG
    GatewayAPI["Gateway API<br/>Gateway"] -.->|"HTTPRoute<br/>/v1/batches, /v1/files"| BG

    %% Styling
    style BG fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required (solid borders)
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style InferenceGW fill:#7ed321,stroke:#333

    %% Optional (dashed borders)
    style S3 fill:#f5a623,stroke:#333,stroke-dasharray: 5 5
    style CertManager fill:#999,stroke:#333,stroke-dasharray: 5 5
    style PromOperator fill:#999,stroke:#333,stroke-dasharray: 5 5
    style OTel fill:#999,stroke:#333,stroke-dasharray: 5 5

    %% Internal Platform
    style GIE fill:#7ed321,stroke:#333
    style LlmdAsync fill:#7ed321,stroke:#333,stroke-dasharray: 5 5

    %% Consumers
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style Grafana fill:#f46800,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333
