graph LR
    BatchGW["Batch Gateway<br/>(apiserver + processor + gc)"]

    %% Required External Dependencies
    BatchGW -->|"pgx/5432<br/>metadata storage"| PostgreSQL["PostgreSQL 12+"]
    BatchGW -->|"go-redis/6379<br/>queue, events, cache"| Redis["Redis / Valkey 6+/8+"]
    BatchGW -->|"AWS SDK/443<br/>file storage"| S3["S3-compatible Storage"]

    %% Required Internal Dependencies
    BatchGW -->|"HTTP(S)<br/>inference dispatch"| LLMDRouter["llm-d Router"]

    %% Recommended Dependencies
    BatchGW -.->|"upstream auth gateway<br/>tenant identity"| Kuadrant["Kuadrant / Authorino"]

    %% Optional External Dependencies
    BatchGW -.->|"TLS cert provisioning"| CertManager["cert-manager"]
    BatchGW -.->|"HTTP scrape<br/>ServiceMonitor/PodMonitor"| Prometheus["Prometheus Operator"]
    BatchGW -.->|"gRPC/4317<br/>trace export"| OTEL["OpenTelemetry Collector"]
    BatchGW -.->|"ConfigMap sidecar<br/>dashboard auto-load"| Grafana["Grafana"]

    %% Optional Internal Dependencies
    BatchGW -.->|"async dispatch queue"| LLMDAsync["llm-d-async v0.7.4"]
    BatchGW -.->|"HTTPRoute CRD<br/>ingress routing"| GatewayAPI["Gateway API"]

    %% Integration consumers
    K8sProbes["Kubernetes<br/>Probes"] -->|"/health, /ready"| BatchGW

    %% Styling
    style BatchGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required (solid lines)
    style PostgreSQL fill:#f5a623,stroke:#333,color:#fff
    style Redis fill:#f5a623,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff

    %% Internal platform (green)
    style LLMDRouter fill:#7ed321,stroke:#333,color:#fff
    style LLMDAsync fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff

    %% Optional external (gray)
    style Kuadrant fill:#e8e8e8,stroke:#333
    style CertManager fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style OTEL fill:#999,stroke:#333,color:#fff
    style Grafana fill:#999,stroke:#333,color:#fff
    style K8sProbes fill:#e8e8e8,stroke:#333
