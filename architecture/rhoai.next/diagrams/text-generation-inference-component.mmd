graph TB
    subgraph TGIS["Text Generation Inference Server (TGIS)"]
        direction TB

        subgraph LauncherProcess["Launcher Process"]
            Launcher["text-generation-launcher<br/>(Rust Binary, clap CLI)<br/>Supervisor + Lifecycle Manager"]
        end

        subgraph RouterProcess["Router Process"]
            Router["text-generation-router<br/>(Rust: axum + tonic)<br/>Port 3000/TCP HTTP, 8033/TCP gRPC"]
            HTTPServer["HTTP Server<br/>/health, /metrics<br/>Port 3000/TCP"]
            GRPCServer["gRPC Server<br/>fmaas.GenerationService<br/>Port 8033/TCP"]
            BatchEngine["Continuous Batching Engine<br/>PaddedBatch / FlashBatch"]
            Tokenizer["HuggingFace Tokenizer<br/>Input Validation"]
            Router --- HTTPServer
            Router --- GRPCServer
            GRPCServer --> BatchEngine
            GRPCServer --> Tokenizer
        end

        subgraph ShardProcesses["Python Model Shards"]
            Shard0["text-generation-server<br/>Shard 0<br/>(Python: grpc.aio + PyTorch)"]
            Shard1["text-generation-server<br/>Shard 1..N<br/>(Tensor Parallel)"]
            CustomKernels["custom_kernels<br/>(CUDA C++ Extension)<br/>Fused Attention"]
            Shard0 --- CustomKernels
            Shard1 --- CustomKernels
        end

        subgraph ClientLib["Client Library"]
            Client["text-generation-client<br/>(Rust tonic gRPC client)"]
        end

        Launcher -->|"spawns + monitors"| Shard0
        Launcher -->|"spawns + monitors"| Shard1
        Launcher -->|"spawns after shards ready"| Router
        Router -->|"uses"| Client
        Client -->|"Unix domain socket<br/>gRPC: Prefill, NextToken,<br/>PruneBatch, PrefixLookup"| Shard0
        Shard0 <-->|"NCCL<br/>TCP/SHM/NVLink"| Shard1
    end

    %% External Interactions
    KServeClient["KServe / Caikit Client"] -->|"gRPC :8033<br/>Generate, GenerateStream,<br/>Tokenize, ModelInfo"| GRPCServer
    Kubelet["Kubelet"] -->|"HTTP GET :3000<br/>/health"| HTTPServer
    Prometheus["Prometheus"] -->|"HTTP GET :3000<br/>/metrics"| HTTPServer

    GPU0["GPU 0<br/>NVIDIA A100/A10"] ---|"PCIe/NVLink<br/>CUDA 12.1"| Shard0
    GPU1["GPU 1..N"] ---|"PCIe/NVLink<br/>CUDA 12.1"| Shard1

    ModelStorage["PVC<br/>Model Cache<br/>/shared_model_storage"] ---|"Read-only mount"| Shard0

    %% Styling
    style Launcher fill:#4a90e2,stroke:#333,color:#fff
    style Router fill:#4a90e2,stroke:#333,color:#fff
    style Shard0 fill:#7ed321,stroke:#333,color:#fff
    style Shard1 fill:#7ed321,stroke:#333,color:#fff
    style Client fill:#4a90e2,stroke:#333,color:#fff
    style CustomKernels fill:#f5a623,stroke:#333,color:#fff
    style HTTPServer fill:#50c8e8,stroke:#333,color:#fff
    style GRPCServer fill:#50c8e8,stroke:#333,color:#fff
    style BatchEngine fill:#50c8e8,stroke:#333,color:#fff
    style Tokenizer fill:#50c8e8,stroke:#333,color:#fff
    style KServeClient fill:#e8e8e8,stroke:#333
    style Kubelet fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style GPU0 fill:#9b59b6,stroke:#333,color:#fff
    style GPU1 fill:#9b59b6,stroke:#333,color:#fff
    style ModelStorage fill:#f5a623,stroke:#333,color:#fff
