graph TB
    subgraph "pipelines-components"
        direction TB

        subgraph "Init Container"
            InitManagedPipelines["init-managed-pipelines<br/>(Python Entrypoint)"]
            GenerateManagedPipelines["generate-managed-pipelines<br/>(Python Script)"]
            InitManagedPipelines -->|"recompiles if<br/>RELATED_IMAGE_* set"| GenerateManagedPipelines
        end

        subgraph "KFP Components Library"
            direction LR
            DataProcessing["Data Processing<br/>Components"]
            Training["Training<br/>Components"]
            Evaluation["Evaluation<br/>Components"]
            Deployment["Deployment<br/>Components"]
        end

        subgraph "Container Images"
            direction LR
            MainImage["odh-pipelines-components<br/>(UBI9/python-312)"]
            AutoMLImage["odh-automl<br/>(AIPCC CPU base)"]
            AutoRAGImage["odh-autorag<br/>(AIPCC CPU base)"]
            AutoRAGInfImage["odh-autorag-inference<br/>(AIPCC CPU base)"]
        end
    end

    %% External Systems
    DSPO["Data Science Pipelines<br/>Operator"] -->|"injects RELATED_IMAGE_*<br/>env vars"| InitManagedPipelines
    InitManagedPipelines -->|"copies compiled<br/>pipeline YAMLs"| SharedVolume["Shared Volume<br/>/config/managed-pipelines"]
    SharedVolume -->|"mounted by"| KFPServer["KFP API Server"]

    %% Component interactions
    DataProcessing -->|"datasets"| HuggingFace["HuggingFace Hub"]
    DataProcessing -->|"documents"| S3["S3 Storage"]
    Training -->|"fine-tuned models"| WorkspacePVC["Workspace PVC"]
    Evaluation -->|"benchmark jobs"| EvalHub["EvalHub API"]
    Deployment -->|"creates CRs"| KServe["KServe<br/>ServingRuntime /<br/>InferenceService"]
    Deployment -->|"reads profiles"| HardwareProfiles["ODH<br/>HardwareProfiles"]

    %% Styling
    style InitManagedPipelines fill:#4a90e2,color:#fff
    style GenerateManagedPipelines fill:#4a90e2,color:#fff
    style DataProcessing fill:#7ed321,color:#fff
    style Training fill:#7ed321,color:#fff
    style Evaluation fill:#7ed321,color:#fff
    style Deployment fill:#7ed321,color:#fff
    style MainImage fill:#f5a623,color:#fff
    style AutoMLImage fill:#f5a623,color:#fff
    style AutoRAGImage fill:#f5a623,color:#fff
    style AutoRAGInfImage fill:#f5a623,color:#fff
    style DSPO fill:#e8e8e8
    style KFPServer fill:#e8e8e8
    style KServe fill:#e8e8e8
    style HuggingFace fill:#e8e8e8
    style S3 fill:#e8e8e8
    style EvalHub fill:#e8e8e8
    style HardwareProfiles fill:#e8e8e8
    style SharedVolume fill:#d5e8d4
    style WorkspacePVC fill:#d5e8d4
