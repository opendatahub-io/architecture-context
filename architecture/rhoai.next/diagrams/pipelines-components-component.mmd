graph TB
    subgraph PipelinesComponents["Pipelines Components"]
        direction TB

        subgraph InitContainer["Init Container"]
            InitManagedPipelines["init-managed-pipelines<br/>Stages YAML to shared volume"]
            GenerateManagedPipelines["generate_managed_pipelines.py<br/>Discovers & compiles pipelines"]
            GenerateManagedPipelines -->|compiles| InitManagedPipelines
        end

        subgraph KFPLibrary["KFP Components Library (Python)"]
            direction TB

            subgraph DataProcessing["Data Processing"]
                DatasetDownload["dataset_download"]
                DownloadModel["download_model"]
                SDG["sdg (Synthetic Data)"]
                ParseAndChunk["parse_and_chunk"]
                IngestMilvus["ingest_to_milvus"]
                YodaProcessor["yoda_data_processor"]
            end

            subgraph Training["Training"]
                LoRA["LoRA (Unsloth)"]
                OSFT["OSFT (mini-trainer)"]
                SFT["SFT (instructlab)"]
                AutoMLTabular["AutoGluon Tabular"]
                AutoMLTimeSeries["AutoGluon TimeSeries"]
                RAGTemplateOpt["RAG Templates Optimization"]
                SearchSpacePrep["Search Space Preparation"]
            end

            subgraph Evaluation["Evaluation"]
                LMEval["lm-eval"]
                EvalHubKServe["Eval Hub KServe"]
            end

            subgraph Deployment["Deployment"]
                ModelDeployment["model_deployment<br/>(vLLM/KServe)"]
                DeployEmbedding["deploy_embedding_model"]
                ModelRegistration["kubeflow_model_registry"]
            end
        end
    end

    %% Shared utilities
    subgraph SharedUtils["Shared Fine-Tuning Utilities"]
        DataUtil["data.py"]
        TrainingUtil["training.py"]
        SetupUtil["setup.py"]
        OutputUtil["output.py"]
    end

    LoRA --> SharedUtils
    OSFT --> SharedUtils
    SFT --> SharedUtils

    %% External inputs
    User["Data Scientist / ML Engineer"] -->|creates pipeline run| KFPAPIServer
    KFPAPIServer["KFP API Server"] -->|reads YAML| InitManagedPipelines
    KFPAPIServer -->|executes| KFPLibrary

    %% Pipelines compose components
    DatasetDownload -->|feeds| LoRA
    DatasetDownload -->|feeds| OSFT
    DatasetDownload -->|feeds| SFT
    LoRA -->|produces model| ModelRegistration
    OSFT -->|produces model| ModelRegistration
    SFT -->|produces model| ModelRegistration
    ModelRegistration -->|triggers| ModelDeployment
    LMEval -->|evaluates| ModelDeployment
    EvalHubKServe -->|evaluates| ModelDeployment

    %% RAG flow
    ParseAndChunk -->|chunks| IngestMilvus
    DownloadModel -->|model| DeployEmbedding

    %% External dependencies
    KServe["KServe"] -.->|creates InferenceService| ModelDeployment
    KServe -.->|creates ServingRuntime| DeployEmbedding
    KubeflowTrainer["Kubeflow Trainer"] -.->|orchestrates training| SharedUtils
    Ray["Ray / CodeFlare"] -.->|distributed processing| ParseAndChunk

    %% Styling
    style PipelinesComponents fill:#e8f4f8,stroke:#4a90e2,stroke-width:2px
    style InitContainer fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style KFPLibrary fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style DataProcessing fill:#f8cecc,stroke:#b85450
    style Training fill:#dae8fc,stroke:#6c8ebf
    style Evaluation fill:#e1d5e7,stroke:#9673a6
    style Deployment fill:#d5e8d4,stroke:#82b366
    style SharedUtils fill:#f5f5f5,stroke:#666
    style KFPAPIServer fill:#4a90e2,color:#fff
    style KServe fill:#999,stroke:#333
    style KubeflowTrainer fill:#999,stroke:#333
    style Ray fill:#999,stroke:#333
