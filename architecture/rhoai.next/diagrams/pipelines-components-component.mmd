graph TB
    subgraph PC["pipelines-components"]
        direction TB

        subgraph InitContainer["odh-pipelines-components (Init Container)"]
            GenScript["generate_managed_pipelines.py<br/>Discovers metadata.yaml files"]
            KFPCompiler["KFP Compiler<br/>Compiles pipelines to YAML"]
            InitScript["init_managed_pipelines.py<br/>Copies to shared volume"]
            GenScript -->|"discovers managed: true"| KFPCompiler
            KFPCompiler -->|"compiled YAML"| InitScript
        end

        subgraph Library["kfp-components (Python Library)"]
            direction TB
            TrainingComps["Training Components<br/>LoRA, SFT, OSFT, AutoML, AutoRAG"]
            EvalComps["Evaluation Components<br/>lm-eval, Eval Hub"]
            DataComps["Data Processing Components<br/>dataset_download, SDG,<br/>parse_and_chunk, ingest_to_milvus"]
            DeployComps["Deployment Components<br/>model_deployment,<br/>kubeflow_model_registry,<br/>deploy_embedding_model"]
        end

        subgraph RuntimeImages["Runtime Container Images"]
            AutoMLImage["odh-automl<br/>AutoGluon + kfp-components<br/>AIPCC CPU Base"]
            AutoRAGImage["odh-autorag<br/>ai4rag + Docling + kfp-components<br/>AIPCC CPU Base"]
        end
    end

    %% External Inputs
    User["Data Scientist / Pipeline Author"] -->|"triggers pipeline"| Library
    DSPO["DSPO<br/>Data Science Pipelines Operator"] -->|"deploys as sidecar"| InitContainer
    RELATED["RELATED_IMAGE_* env vars<br/>(air-gapped overrides)"] -.->|"triggers recompilation"| GenScript

    %% Init Container Flow
    InitScript -->|"writes to /config/managed-pipelines/"| SharedVol["Shared PVC Volume"]
    SharedVol -->|"reads compiled YAMLs"| KFPAPI["KFP API Server"]

    %% Runtime Image Usage
    TrainingComps -->|"base_image=AUTOML_IMAGE"| AutoMLImage
    TrainingComps -->|"base_image=RAY_RAG_BASE_IMAGE"| AutoRAGImage
    DataComps -->|"base_image=RAY_RAG_BASE_IMAGE"| AutoRAGImage

    %% External Dependencies
    Library -->|"creates CRDs"| KServe["KServe<br/>InferenceService"]
    Library -->|"submits jobs"| TrainingHub["Training Hub<br/>ClusterTrainingRuntime"]
    Library -->|"registers models"| ModelReg["Model Registry"]
    Library -->|"vector ingestion"| Milvus["Milvus<br/>19530/TCP"]
    Library -->|"submits RayJobs"| Ray["Ray / CodeFlare"]
    Library -->|"downloads"| HFHub["HuggingFace Hub"]
    Library -->|"data access"| S3["S3 / MinIO"]

    %% Styling
    style PC fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style InitContainer fill:#fff3cd,stroke:#d79b00,stroke-width:2px
    style Library fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style RuntimeImages fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style GenScript fill:#fff,stroke:#333
    style KFPCompiler fill:#fff,stroke:#333
    style InitScript fill:#fff,stroke:#333
    style AutoMLImage fill:#e1d5e7,stroke:#9673a6
    style AutoRAGImage fill:#e1d5e7,stroke:#9673a6
    style DSPO fill:#f5a623,stroke:#333
    style KFPAPI fill:#f5a623,stroke:#333
    style KServe fill:#999,stroke:#333
    style TrainingHub fill:#999,stroke:#333
    style ModelReg fill:#7ed321,stroke:#333
    style Milvus fill:#999,stroke:#333
    style Ray fill:#999,stroke:#333
    style HFHub fill:#999,stroke:#333
    style S3 fill:#999,stroke:#333
    style SharedVol fill:#fff2cc,stroke:#d6b656
    style User fill:#dae8fc,stroke:#6c8ebf
