graph TB
    subgraph Platform["OpenDataHub / RHOAI Platform"]
        ODHOperator["opendatahub-operator<br/>(Platform Operator)"]
        DSCI["DSCInitialization CR"]
        ConfigMap["odh-aigateway-config<br/>ConfigMap"]
    end

    subgraph AIGatewayModule["AI Gateway Operator Module"]
        direction TB

        AIGatewayCR["AIGateway CR<br/>(Cluster-scoped)<br/>default-aigateway"]

        subgraph Operator["ai-gateway-operator"]
            Controller["AIGateway Controller<br/>(controller-runtime)"]
            HealthProbe["Health Probes<br/>:8081/healthz, /readyz"]
            MetricsEndpoint["Metrics<br/>:8443/metrics (HTTPS)"]
        end

        subgraph SubComponents["Sub-Components (Vendored Manifests)"]
            direction LR

            subgraph BatchGW["batch-gateway-operator"]
                BGWController["BGW Controller"]
                BGWApiServer["BGW API Server"]
                BGWProcessor["BGW Processor"]
                BGWGC["BGW GC"]
                AsyncProc["Async Processor"]
            end

            subgraph MaaS["maas-controller"]
                MaaSCtrl["MaaS Controller"]
                MaaSAPI["MaaS API Server"]
                PayloadProc["Payload Processing"]
                MaaSWebhook["Validating Webhook<br/>:9443/TCP (TLS)"]
            end
        end
    end

    %% Platform creates AIGateway CR
    ODHOperator -->|"creates CR"| AIGatewayCR
    ODHOperator -->|"writes platformVersion"| ConfigMap
    Controller -->|"reads monitoring NS"| DSCI
    Controller -->|"reads platformVersion"| ConfigMap

    %% Controller watches and deploys
    AIGatewayCR -->|"watched by"| Controller
    Controller -->|"deploys when<br/>batchGateway: Managed"| BatchGW
    Controller -->|"deploys when<br/>modelsAsAService: Managed"| MaaS

    %% CRDs managed
    Controller -->|"installs CRDs via SSA"| LLMBatchGatewayCRD["LLMBatchGateway CRD"]
    Controller -->|"installs CRDs via SSA"| MaaSCRDs["MaaS CRDs<br/>(AITenant, Config,<br/>MaaSSubscription, etc.)"]

    LLMBatchGatewayCRD -->|"watched by"| BGWController
    MaaSCRDs -->|"watched by"| MaaSCtrl

    %% External integrations
    MaaSCtrl -->|"manages"| GatewayAPI["Gateway API<br/>(HTTPRoute)"]
    MaaSCtrl -->|"manages"| Kuadrant["Kuadrant<br/>(AuthPolicy, TRL)"]
    MaaSCtrl -->|"manages"| Istio["Istio<br/>(DestinationRule,<br/>EnvoyFilter)"]
    MaaSCtrl -->|"watches"| KServe["KServe<br/>(LLMInferenceService)"]
    MaaSCtrl -->|"manages"| OTel["OpenTelemetry"]
    MaaSCtrl -->|"manages"| Perses["Perses Dashboards"]

    BGWController -->|"manages"| CertManager["cert-manager<br/>(Certificate)"]
    BGWController -->|"manages"| GatewayAPI

    %% Monitoring
    Controller -->|"creates"| Prometheus["Prometheus<br/>(ServiceMonitor,<br/>PodMonitor)"]

    %% Teardown handshake
    Controller -.->|"teardown-requested<br/>annotation"| MaaSCtrl
    MaaSCtrl -.->|"teardown-completed<br/>annotation"| Controller

    %% Styling
    style AIGatewayCR fill:#f5a623,stroke:#333,stroke-width:2px
    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style BGWController fill:#4a90e2,stroke:#333
    style MaaSCtrl fill:#4a90e2,stroke:#333
    style MaaSAPI fill:#4a90e2,stroke:#333
    style BGWApiServer fill:#4a90e2,stroke:#333
    style BGWProcessor fill:#4a90e2,stroke:#333
    style BGWGC fill:#4a90e2,stroke:#333
    style AsyncProc fill:#4a90e2,stroke:#333
    style PayloadProc fill:#4a90e2,stroke:#333
    style MaaSWebhook fill:#4a90e2,stroke:#333
    style HealthProbe fill:#4a90e2,stroke:#333
    style MetricsEndpoint fill:#4a90e2,stroke:#333
    style ODHOperator fill:#7ed321,stroke:#333
    style DSCI fill:#7ed321,stroke:#333
    style ConfigMap fill:#7ed321,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Kuadrant fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style Perses fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style LLMBatchGatewayCRD fill:#f5a623,stroke:#333
    style MaaSCRDs fill:#f5a623,stroke:#333
