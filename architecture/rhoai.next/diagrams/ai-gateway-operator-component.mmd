graph TB
    subgraph AIGatewayOperator["ai-gateway-operator (Module Operator)"]
        Controller["AIGateway Controller<br/>Go controller-runtime"]
        TLSWatcher["SecurityProfileWatcher<br/>TLS profile monitor"]
        Config["Configuration Manager<br/>Viper-based config"]
        Controller --> TLSWatcher
        Controller --> Config
    end

    ODHOperator["opendatahub-operator"] -->|creates & manages| AIGatewayCR["AIGateway CR<br/>(Cluster-scoped singleton)"]
    AIGatewayCR -->|watched by| Controller

    subgraph SubComponents["Vendored Sub-Components"]
        direction TB
        BatchGW["batch-gateway-operator<br/>(LLMBatchGateway CRs)"]
        MaaSCtrl["maas-controller<br/>(AITenant, MaaSSubscription CRs)"]
        AIGWCtrl["ai-gateway-controller<br/>(Praxis extproc routing)"]
    end

    Controller -->|"SSA deploy when<br/>batchGateway: Managed"| BatchGW
    Controller -->|"SSA deploy when<br/>modelsAsAService: Managed"| MaaSCtrl
    Controller -->|"SSA deploy with<br/>MaaS toggle"| AIGWCtrl

    Controller -->|reads| DSCI["DSCInitialization CR"]
    Controller -->|reads| ConfigMap["odh-aigateway-config<br/>(version handshake)"]
    Controller -->|updates status| AIGatewayCR

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    Controller -->|TLS profile fetch| APIServer["OpenShift APIServer CR"]

    subgraph PlatformDeps["Platform Dependencies"]
        CertManager["cert-manager"]
        GatewayAPI["Gateway API"]
        Kuadrant["Kuadrant"]
        PromOperator["prometheus-operator"]
        KServe["KServe"]
        Istio["Istio"]
        Authorino["Authorino"]
    end

    SubComponents -.->|certificates| CertManager
    SubComponents -.->|HTTPRoute| GatewayAPI
    SubComponents -.->|auth/rate-limit| Kuadrant
    SubComponents -.->|monitoring| PromOperator
    SubComponents -.->|model serving| KServe
    SubComponents -.->|network policies| Istio
    SubComponents -.->|auth readiness| Authorino

    style Controller fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style Config fill:#4a90e2,color:#fff
    style AIGatewayCR fill:#f5a623,color:#fff
    style ODHOperator fill:#7ed321,color:#fff
    style BatchGW fill:#9b59b6,color:#fff
    style MaaSCtrl fill:#9b59b6,color:#fff
    style AIGWCtrl fill:#9b59b6,color:#fff
    style K8sAPI fill:#e8e8e8,color:#333
    style APIServer fill:#e8e8e8,color:#333
    style DSCI fill:#f5a623,color:#fff
    style ConfigMap fill:#f5a623,color:#fff
    style CertManager fill:#e8e8e8,color:#333
    style GatewayAPI fill:#e8e8e8,color:#333
    style Kuadrant fill:#e8e8e8,color:#333
    style PromOperator fill:#e8e8e8,color:#333
    style KServe fill:#7ed321,color:#fff
    style Istio fill:#e8e8e8,color:#333
    style Authorino fill:#e8e8e8,color:#333
