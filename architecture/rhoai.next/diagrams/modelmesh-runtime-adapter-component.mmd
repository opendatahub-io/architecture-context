graph TB
    subgraph Pod["Model Serving Pod"]
        direction TB

        subgraph Puller["model-serving-puller"]
            PullerServer["Puller gRPC Server<br/>mmesh.ModelRuntime<br/>8084/TCP localhost"]
            PullerClient["Puller gRPC Client"]
            PullmanLib["pullman Library"]
        end

        subgraph Adapters["Runtime Adapters (one active per Pod)"]
            TritonAdapter["model-mesh-triton-adapter<br/>8085/TCP localhost"]
            MLServerAdapter["model-mesh-mlserver-adapter<br/>8085/TCP localhost"]
            OVMSAdapter["model-mesh-ovms-adapter<br/>8085/TCP localhost"]
            TorchServeAdapter["model-mesh-torchserve-adapter<br/>8085/TCP localhost"]
        end

        subgraph Runtimes["Inference Runtimes (separate container)"]
            Triton["Triton Inference Server<br/>GRPCInferenceService"]
            MLServer["MLServer<br/>GRPCInferenceService"]
            OVMS["OpenVINO Model Server<br/>GRPCInferenceService"]
            TorchServe["TorchServe<br/>Management + Inference gRPC"]
        end

        TfPb["tf_pb.py<br/>Keras → SavedModel<br/>Python 3.11 + TensorFlow"]
    end

    ModelMesh["ModelMesh Orchestrator"] -->|"gRPC<br/>localhost:8084"| PullerServer
    PullerServer --> PullerClient
    PullerServer --> PullmanLib

    PullerClient -->|"gRPC<br/>localhost:8085"| TritonAdapter
    PullerClient -->|"gRPC<br/>localhost:8085"| MLServerAdapter
    PullerClient -->|"gRPC<br/>localhost:8085"| OVMSAdapter
    PullerClient -->|"gRPC<br/>localhost:8085"| TorchServeAdapter

    TritonAdapter -->|gRPC| Triton
    TritonAdapter -.->|invokes| TfPb
    MLServerAdapter -->|gRPC| MLServer
    OVMSAdapter -->|gRPC| OVMS
    TorchServeAdapter -->|gRPC| TorchServe

    subgraph Storage["Cloud Storage Backends"]
        S3["S3 / IBM COS"]
        Azure["Azure Blob Storage"]
        GCS["Google Cloud Storage"]
        HTTP["HTTP/HTTPS Endpoints"]
    end

    PullmanLib -->|"HTTPS/443<br/>TLS"| S3
    PullmanLib -->|"HTTPS/443<br/>TLS"| Azure
    PullmanLib -->|"HTTPS/443<br/>TLS"| GCS
    PullmanLib -->|"HTTP(S)<br/>Optional TLS + mTLS"| HTTP

    style PullerServer fill:#4a90e2,color:#fff
    style PullerClient fill:#4a90e2,color:#fff
    style PullmanLib fill:#4a90e2,color:#fff
    style TritonAdapter fill:#7ed321,color:#fff
    style MLServerAdapter fill:#7ed321,color:#fff
    style OVMSAdapter fill:#7ed321,color:#fff
    style TorchServeAdapter fill:#7ed321,color:#fff
    style Triton fill:#e8e8e8,stroke:#333
    style MLServer fill:#e8e8e8,stroke:#333
    style OVMS fill:#e8e8e8,stroke:#333
    style TorchServe fill:#e8e8e8,stroke:#333
    style TfPb fill:#f5a623,color:#fff
    style ModelMesh fill:#9b59b6,color:#fff
    style S3 fill:#f5a623,stroke:#333
    style Azure fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style HTTP fill:#f5a623,stroke:#333
