graph TB
    subgraph Pod["ModelMesh Serving Pod"]
        direction TB

        subgraph Puller["model-serving-puller"]
            PullerGRPC["ModelRuntime gRPC Server<br/>8084/TCP"]
            PullMan["PullMan Storage Library"]
            PullerGRPC -->|delegates| PullMan
        end

        subgraph Adapters["Runtime Adapters (one per pod)"]
            direction LR
            AdapterGRPC["ModelRuntime gRPC Server<br/>8085/TCP"]
        end

        subgraph AdapterVariants["Adapter Implementations"]
            direction LR
            TritonAdapter["Triton Adapter"]
            MLServerAdapter["MLServer Adapter"]
            OVMSAdapter["OVMS Adapter"]
            TorchServeAdapter["TorchServe Adapter"]
        end

        subgraph RuntimeServers["Target Runtime (one per pod)"]
            direction LR
            Triton["Triton Inference Server<br/>gRPC 8001/TCP"]
            MLServer["Seldon MLServer<br/>gRPC 8001/TCP"]
            OVMS["OpenVINO Model Server<br/>HTTP 8001/TCP"]
            TorchServe["TorchServe<br/>gRPC 7071/TCP mgmt<br/>gRPC 7070/TCP inference"]
        end

        PullerGRPC -->|"gRPC plaintext<br/>loopback"| AdapterGRPC

        AdapterGRPC --- TritonAdapter
        AdapterGRPC --- MLServerAdapter
        AdapterGRPC --- OVMSAdapter
        AdapterGRPC --- TorchServeAdapter

        TritonAdapter -->|"gRPC<br/>loopback"| Triton
        MLServerAdapter -->|"gRPC<br/>loopback"| MLServer
        OVMSAdapter -->|"REST HTTP<br/>loopback"| OVMS
        TorchServeAdapter -->|"gRPC<br/>loopback"| TorchServe
    end

    subgraph Storage["Cloud Storage Backends"]
        S3["S3 / MinIO / IBM COS<br/>443/TCP HTTPS"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS"]
        HTTP["HTTP/HTTPS Sources<br/>configurable"]
        PVC["Kubernetes PVC<br/>local mount"]
    end

    ModelMesh["ModelMesh Controller"] -->|"gRPC LoadModel/UnloadModel<br/>8084/TCP"| PullerGRPC

    PullMan -->|"TLS 1.2+"| S3
    PullMan -->|"TLS 1.2+"| GCS
    PullMan -->|"TLS 1.2+"| Azure
    PullMan -->|"Optional TLS/mTLS"| HTTP
    PullMan -->|"symlink"| PVC

    K8sSecrets["Kubernetes Secrets<br/>/storage-config"] -.->|"volume mount"| PullMan
    ConfigMap["model-serving-config<br/>ConfigMap"] -.->|"image selection"| Pod

    style PullerGRPC fill:#4a90e2,stroke:#333,color:#fff
    style AdapterGRPC fill:#4a90e2,stroke:#333,color:#fff
    style TritonAdapter fill:#7ed321,stroke:#333
    style MLServerAdapter fill:#7ed321,stroke:#333
    style OVMSAdapter fill:#7ed321,stroke:#333
    style TorchServeAdapter fill:#7ed321,stroke:#333
    style Triton fill:#f5a623,stroke:#333
    style MLServer fill:#f5a623,stroke:#333
    style OVMS fill:#f5a623,stroke:#333
    style TorchServe fill:#f5a623,stroke:#333
    style ModelMesh fill:#9b59b6,stroke:#333,color:#fff
    style S3 fill:#e8e8e8,stroke:#333
    style GCS fill:#e8e8e8,stroke:#333
    style Azure fill:#e8e8e8,stroke:#333
    style HTTP fill:#e8e8e8,stroke:#333
    style PVC fill:#e8e8e8,stroke:#333
    style K8sSecrets fill:#fff2cc,stroke:#d6b656
    style ConfigMap fill:#fff2cc,stroke:#d6b656
