graph TB
    subgraph ModelMeshPod["ModelMesh Serving Pod"]
        direction TB

        subgraph PullerLayer["Model Storage Layer"]
            Puller["model-serving-puller<br/>Go gRPC Service<br/>Port 8084/TCP"]
            Pullman["pullman Library<br/>Pluggable Storage Framework"]
            Puller --> Pullman
        end

        subgraph AdapterLayer["Runtime Adapter Layer (one per pod)"]
            TritonAdapter["triton-adapter<br/>Go gRPC Service<br/>Port 8085/TCP"]
            MLServerAdapter["mlserver-adapter<br/>Go gRPC Service<br/>Port 8085/TCP"]
            OVMSAdapter["ovms-adapter<br/>Go gRPC Service<br/>Port 8085/TCP"]
            TorchServeAdapter["torchserve-adapter<br/>Go gRPC Service<br/>Port 8085/TCP"]
        end

        subgraph RuntimeLayer["Inference Runtime (one per pod)"]
            Triton["NVIDIA Triton<br/>gRPC 8001/TCP"]
            MLServer["Seldon MLServer<br/>gRPC 8001/TCP"]
            OVMS["OpenVINO Model Server<br/>HTTP 8001/TCP"]
            TorchServe["TorchServe<br/>gRPC 7071/TCP mgmt<br/>gRPC 7070/TCP infer"]
        end

        KerasConv["tf_pb.py<br/>Keras → TF Conversion<br/>Python 3.11 + TensorFlow"]
    end

    subgraph StorageProviders["Cloud Storage Providers"]
        S3["AWS S3 / IBM COS<br/>HTTPS 443/TCP"]
        GCS["Google Cloud Storage<br/>HTTPS 443/TCP"]
        Azure["Azure Blob Storage<br/>HTTPS 443/TCP"]
        HTTP["HTTP(S) Repositories<br/>80/443/TCP"]
        PVC["Kubernetes PVC<br/>Volume Mount"]
    end

    ModelMesh["ModelMesh Controller<br/>(modelmesh-serving)"]

    %% ModelMesh to Puller/Adapters
    ModelMesh -->|"gRPC LoadModel/<br/>UnloadModel"| Puller
    Puller -->|"gRPC forward"| TritonAdapter
    Puller -->|"gRPC forward"| MLServerAdapter
    Puller -->|"gRPC forward"| OVMSAdapter
    Puller -->|"gRPC forward"| TorchServeAdapter

    %% Storage connections
    Pullman -->|"HTTPS TLS 1.2+<br/>Static credentials"| S3
    Pullman -->|"HTTPS TLS 1.2+<br/>Service account JWT"| GCS
    Pullman -->|"HTTPS TLS 1.2+<br/>Connection string"| Azure
    Pullman -->|"HTTP/HTTPS<br/>Custom headers"| HTTP
    Pullman -->|"Symlink access"| PVC

    %% Adapter to Runtime
    TritonAdapter -->|"gRPC plaintext<br/>RepositoryModelLoad"| Triton
    TritonAdapter -->|"subprocess"| KerasConv
    MLServerAdapter -->|"gRPC plaintext<br/>RepositoryModelLoad"| MLServer
    OVMSAdapter -->|"HTTP plaintext<br/>/v1/config/reload"| OVMS
    TorchServeAdapter -->|"gRPC plaintext<br/>RegisterModel"| TorchServe

    %% Secrets
    StorageConfig["storage-config Secret<br/>(Volume Mount)"]
    StorageConfig -.->|"credentials"| Pullman

    %% Styling
    style Puller fill:#4a90e2,stroke:#333,color:#fff
    style TritonAdapter fill:#4a90e2,stroke:#333,color:#fff
    style MLServerAdapter fill:#4a90e2,stroke:#333,color:#fff
    style OVMSAdapter fill:#4a90e2,stroke:#333,color:#fff
    style TorchServeAdapter fill:#4a90e2,stroke:#333,color:#fff
    style Pullman fill:#5ba3f5,stroke:#333,color:#fff
    style KerasConv fill:#9b59b6,stroke:#333,color:#fff
    style ModelMesh fill:#2ecc71,stroke:#333,color:#fff
    style Triton fill:#e8e8e8,stroke:#333
    style MLServer fill:#e8e8e8,stroke:#333
    style OVMS fill:#e8e8e8,stroke:#333
    style TorchServe fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style Azure fill:#f5a623,stroke:#333
    style HTTP fill:#f5a623,stroke:#333
    style PVC fill:#f5a623,stroke:#333
    style StorageConfig fill:#e74c3c,stroke:#333,color:#fff
