graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>(HTTPRoute)<br/>443/TCP → 8443 or 8943<br/>TLS Mode: SIMPLE"]
    end

    subgraph CorePod["CORE POD (3 containers)"]
        direction TB

        subgraph ProxyContainer["kube-rbac-proxy"]
            Proxy["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS: service-ca cert<br/>Auth: OpenShift project list"]
        end

        subgraph NodeContainer["Node.js Backend"]
            NodeJS["odh-dashboard<br/>8080/TCP HTTP (loopback)<br/>Crypto: DEFAULT:PQ<br/>Auth: x-forwarded-access-token"]
        end

        subgraph BFFContainer["Core BFF"]
            CoreBFF["core-bff<br/>8943/TCP HTTPS<br/>TLS: service-ca + cluster profile<br/>FIPS: strictfipsruntime<br/>Auth: Bearer Token"]
        end
    end

    subgraph ModulePods["FEDERATED MODULES (per-module SA + NetworkPolicy)"]
        direction TB
        GenAI["gen-ai BFF<br/>8080/TCP HTTPS<br/>SA: own<br/>FIPS: strictfipsruntime"]
        ModelRegBFF["model-registry BFF<br/>8080/TCP HTTPS"]
        MaaSBFF["maas BFF<br/>8080/TCP HTTPS"]
        OtherModules["eval-hub, mlflow, notebooks,<br/>agent-ops, automl, autorag,<br/>data-connect-hub, data-registry<br/>8080/TCP HTTPS each"]
    end

    subgraph OperatorZone["OPERATOR POD"]
        Operator["dashboard-operator<br/>8081/TCP HTTP (probes)<br/>443/TCP HTTPS (webhooks)<br/>SA: dashboard-operator<br/>FIPS: strictfipsruntime"]
    end

    subgraph K8sZone["KUBERNETES API"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA + Impersonation"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        DSPipelines["DS Pipelines API<br/>8443/TCP HTTPS<br/>Bearer Token"]
        ModelRegAPI["Model Registry API<br/>8443/TCP HTTPS<br/>Bearer Token"]
        KServe["KServe<br/>varies HTTPS<br/>Bearer Token"]
        LlamaStack["Llama Stack<br/>varies HTTPS<br/>Bearer/API Key"]
        MaaSAPI["MaaS API<br/>varies HTTPS<br/>Bearer Token"]
        MLflowSvc["MLflow Tracking<br/>varies HTTPS<br/>Session"]
        MCPServers["MCP Servers<br/>SSE/HTTP<br/>varies"]
        NeMo["NeMo Guardrails<br/>varies HTTPS<br/>API Key"]
        TrustyAI["TrustyAI<br/>443/TCP HTTPS<br/>Bearer Token"]
        Prometheus["Prometheus/Thanos<br/>9092/TCP HTTPS<br/>Bearer Token"]
    end

    %% External → Ingress
    Browser -->|"HTTPS/443<br/>TLS 1.2+<br/>Session cookie / Bearer"| Gateway

    %% Ingress → Core Pod
    Gateway -->|"HTTPS/8443<br/>TLS (service-ca)<br/>Passthrough"| Proxy
    Gateway -->|"HTTPS/8943<br/>TLS (service-ca)<br/>Passthrough"| CoreBFF

    %% Within Core Pod
    Proxy -->|"HTTP/8080<br/>None (loopback)<br/>x-forwarded-access-token"| NodeJS

    %% Core → K8s API
    NodeJS -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Impersonation"| K8sAPI
    CoreBFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Module Federation
    NodeJS -->|"HTTPS/8080<br/>TLS (service-ca)<br/>Internal auth"| GenAI

    %% Modules → K8s API
    GenAI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    ModelRegBFF -->|"HTTPS/6443"| K8sAPI
    MaaSBFF -->|"HTTPS/6443"| K8sAPI

    %% Modules → External Services
    GenAI -->|"HTTPS<br/>TLS<br/>Bearer/API Key"| LlamaStack
    GenAI -->|"SSE/HTTP<br/>varies"| MCPServers
    GenAI -->|"HTTPS<br/>API Key"| NeMo
    MaaSBFF -->|"HTTPS<br/>Bearer Token"| MaaSAPI

    %% Operator → K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Core → External Services
    NodeJS -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| DSPipelines
    NodeJS -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| ModelRegAPI
    NodeJS -->|"HTTPS<br/>TLS<br/>Bearer Token"| KServe
    NodeJS -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| TrustyAI
    NodeJS -->|"HTTPS/9092<br/>TLS<br/>Bearer Token"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef corepod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef module fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Browser external
    class Gateway ingress
    class Proxy,NodeJS,CoreBFF corepod
    class GenAI,ModelRegBFF,MaaSBFF,OtherModules module
    class Operator operator
    class K8sAPI k8s
    class DSPipelines,ModelRegAPI,KServe,LlamaStack,MaaSAPI,MLflowSvc,MCPServers,NeMo,TrustyAI,Prometheus extsvc
