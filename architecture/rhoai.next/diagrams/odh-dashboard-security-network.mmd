graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["User Browser"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Platform Gateway (Envoy)<br/>443/TCP → 8443/TCP<br/>TLS 1.2+ (SIMPLE)<br/>HTTPRoute PathPrefix '/'"]
    end

    subgraph AuthLayer["AUTH ENFORCEMENT"]
        KRBP["kube-rbac-proxy<br/>8443/TCP → 8080/TCP<br/>TLS (dashboard-proxy-tls)<br/>OAuth Token Validation<br/>Injects: X-Auth-Request-User,<br/>X-Auth-Request-Groups"]
    end

    subgraph DashPod["DASHBOARD POD (Sidecar Mode)"]
        direction TB

        Backend["Dashboard Backend<br/>Node.js/Fastify<br/>8080/TCP HTTP (localhost)<br/>SA: odh-dashboard"]

        subgraph BFFs["BFF MODULES (SA: odh-dashboard-modules)"]
            GenAI["gen-ai BFF<br/>8143/TCP HTTPS/TLS"]
            MaaS["maas BFF<br/>8243/TCP HTTPS/TLS"]
            MR["model-registry BFF<br/>8043/TCP HTTPS/TLS"]
            MLflow["mlflow BFF<br/>8343/TCP HTTPS/TLS"]
            EvalHub["eval-hub BFF<br/>8543/TCP HTTPS/TLS"]
            AutoML["automl BFF<br/>8643/TCP HTTPS/TLS"]
            AutoRAG["autorag BFF<br/>8743/TCP HTTPS/TLS"]
            AgentOps["agent-ops BFF<br/>8843/TCP HTTPS/TLS"]
        end

        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| GenAI
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| MaaS
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| MR
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| MLflow
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| EvalHub
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| AutoML
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| AutoRAG
        Backend -->|"HTTPS/TLS<br/>x-forwarded-access-token"| AgentOps
    end

    subgraph InterBFF["INTER-BFF (TLS, forwarded token)"]
        direction LR
        GenAI2["gen-ai"] -->|"8243/TCP"| MaaS2["maas"]
        GenAI2 -->|"8343/TCP"| MLflow2["mlflow"]
        EvalHub2["eval-hub"] -->|"8043/TCP"| MR2["model-registry"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES (Internal)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>Bearer Token (SA/user)"]
        Thanos["Thanos Querier<br/>9092/TCP HTTPS<br/>Bearer Token"]
        ModelRegAPI["Model Registry API<br/>8080/TCP HTTP/gRPC<br/>Bearer Token"]
        TrustyAI["TrustyAI<br/>8080/TCP HTTP/HTTPS<br/>Bearer Token"]
        PGVector["pgvector PostgreSQL<br/>5432/TCP<br/>TLS (optional)<br/>Credentials"]
    end

    subgraph ExtSvc["EXTERNAL SERVICES"]
        LlamaStack["Llama Stack<br/>443/TCP HTTPS TLS 1.3<br/>Bearer Token"]
        NeMo["NeMo Guardrails<br/>443/TCP HTTPS TLS 1.2+<br/>Bearer Token"]
        S3["S3 Storage<br/>443/TCP HTTPS TLS 1.2+<br/>AWS IAM"]
        OpenAI["OpenAI API<br/>443/TCP HTTPS TLS 1.2+<br/>Bearer Token"]
        OGX["OGX (Open GenAI Stack)<br/>443/TCP HTTPS<br/>Bearer Token"]
        KFPipelines["Kubeflow Pipelines<br/>various/TCP HTTPS<br/>Bearer Token"]
    end

    %% Main flow
    Browser -->|"HTTPS/443<br/>OAuth Token"| Gateway
    Gateway -->|"HTTPS/8443<br/>Token passthrough"| KRBP
    KRBP -->|"HTTP/8080<br/>localhost<br/>x-forwarded-access-token"| Backend

    %% Platform egress
    Backend -->|"HTTPS/6443<br/>Bearer Token"| K8sAPI
    Backend -->|"HTTPS/9092<br/>Bearer Token"| Thanos

    %% BFF to external
    GenAI -->|"HTTPS/443<br/>Bearer Token"| LlamaStack
    GenAI -->|"HTTPS/443<br/>Bearer Token"| NeMo
    GenAI -->|"TCP/5432<br/>Credentials"| PGVector
    MaaS -->|"HTTPS/6443<br/>Bearer Token"| K8sAPI
    MR -->|"HTTP/8080<br/>Bearer Token"| ModelRegAPI
    AutoML -->|"HTTPS/443<br/>AWS IAM"| S3
    AutoML -->|"HTTPS/443<br/>Bearer Token"| KFPipelines
    AutoRAG -->|"HTTPS/443<br/>Bearer Token"| OGX
    AutoRAG -->|"HTTPS/443<br/>AWS IAM"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef dashpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef interbff fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Browser external
    class Gateway ingress
    class KRBP auth
    class Backend,GenAI,MaaS,MR,MLflow,EvalHub,AutoML,AutoRAG,AgentOps dashpod
    class K8sAPI,Thanos,ModelRegAPI,TrustyAI,PGVector platform
    class LlamaStack,NeMo,S3,OpenAI,OGX,KFPipelines extsvc
    class GenAI2,MaaS2,MLflow2,EvalHub2,MR2 interbff
