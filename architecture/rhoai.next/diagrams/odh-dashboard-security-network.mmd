graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser["Browser / Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>HTTPRoute PathPrefix /<br/>443/TCP → 8443/TCP<br/>TLS terminated (SIMPLE)"]
    end

    subgraph AuthLayer["AUTH LAYER (kube-rbac-proxy)"]
        KRBAC["kube-rbac-proxy<br/>8443/TCP HTTPS<br/>TLS: service-ca cert (dashboard-proxy-tls)<br/>AuthN: TokenReview<br/>AuthZ: SAR (list projects)"]
    end

    subgraph CoreServices["CORE SERVICES (Pod-internal)"]
        direction TB
        Dashboard["odh-dashboard (Node.js BFF)<br/>SA: odh-dashboard<br/>8080/TCP HTTP (localhost)"]
        CoreBFF["core-bff (Go BFF)<br/>SA: odh-dashboard<br/>8080/TCP"]
    end

    subgraph ModuleLayer["MODULE BFF LAYER (SA: odh-dashboard-modules)"]
        direction LR

        subgraph ModuleGroup1[" "]
            ModelReg["model-registry<br/>8043/TCP HTTPS"]
            GenAI["gen-ai<br/>8143/TCP HTTPS"]
            MaaS["maas<br/>8243/TCP HTTPS"]
            MLflow["mlflow<br/>8343/TCP HTTPS"]
        end

        subgraph ModuleGroup2[" "]
            EvalHub["eval-hub<br/>8543/TCP HTTPS"]
            AutoML["automl<br/>8643/TCP HTTPS"]
            AutoRAG["autorag<br/>8743/TCP HTTPS"]
            AgentOps["agent-ops<br/>8843/TCP HTTPS"]
        end
    end

    subgraph K8sCluster["KUBERNETES API"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token + impersonation"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        ExtHTTPS["External HTTPS Services<br/>(MaaS, MLflow, LlamaStack)<br/>443/TCP TLS 1.2+"]
        Prometheus["Prometheus<br/>9090/TCP HTTP<br/>Bearer token"]
        Perses["data-science-perses<br/>8080/TCP HTTP<br/>user_token"]
    end

    %% External → Auth
    Browser -->|"HTTPS/443<br/>TLS 1.2+"| Gateway
    Gateway -->|"HTTPS/8443<br/>TLS (service-ca)"| KRBAC

    %% Auth → Core
    KRBAC -->|"HTTP/8080<br/>No encryption (localhost)<br/>X-Auth-Request-User<br/>X-Auth-Request-Groups"| Dashboard

    %% Core → Modules
    Dashboard -->|"HTTPS/8043-8843<br/>TLS (shared serving cert)<br/>x-forwarded-access-token"| GenAI
    Dashboard -->|"HTTPS/8043<br/>TLS (shared serving cert)<br/>x-forwarded-access-token"| ModelReg

    %% Inter-module
    GenAI -.->|"HTTPS/8243<br/>TLS (service-ca)<br/>user token passthrough"| MaaS
    GenAI -.->|"HTTPS/8343<br/>TLS (service-ca)<br/>user token passthrough"| MLflow

    %% → K8s API
    Dashboard -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token / user token"| K8sAPI
    KRBAC -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview + SAR"| K8sAPI
    GenAI -->|"HTTPS/6443<br/>TLS 1.2+<br/>User impersonation"| K8sAPI
    MaaS -->|"HTTPS/6443<br/>TLS 1.2+<br/>User impersonation"| K8sAPI
    AgentOps -->|"HTTPS/6443<br/>TLS 1.2+<br/>User impersonation"| K8sAPI

    %% → External
    Dashboard -->|"HTTPS/443<br/>TLS 1.2+"| ExtHTTPS
    CoreBFF -->|"HTTP/9090<br/>Bearer token"| Prometheus
    Dashboard -->|"HTTP/8080<br/>user_token"| Perses

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef core fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef module fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Browser external
    class Gateway ingress
    class KRBAC auth
    class Dashboard,CoreBFF core
    class ModelReg,GenAI,MaaS,MLflow,EvalHub,AutoML,AutoRAG,AgentOps module
    class K8sAPI k8s
    class ExtHTTPS,Prometheus,Perses extsvc
