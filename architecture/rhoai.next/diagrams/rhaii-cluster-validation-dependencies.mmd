    style NVDriver fill:#999,stroke:#333,color:#fff
    style AMDDriver fill:#999,stroke:#333,color:#fff
    style iperf3 fill:#999,stroke:#333,color:#fff
    style perftest fill:#999,stroke:#333,color:#fff
    style libcudart fill:#999,stroke:#333,color:#fff
    style K8s fill:#999,stroke:#333,color:#fff

    %% Internal platform deps (green)
    style GatewayAPI fill:#7ed321,stroke:#333
    style InferencePool fill:#7ed321,stroke:#333
    style LWS fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333
    style Istio fill:#7ed321,stroke:#333
    style LWSOperator fill:#7ed321,stroke:#333

