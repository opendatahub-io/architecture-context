graph LR
    RHAII["RHAII Cluster<br/>Validation"]

    %% External Dependencies
    RHAII -->|"GPU checks"| NVIDIADriver["NVIDIA GPU Driver<br/>≥535.0"]
    RHAII -->|"GPU checks"| AMDDriver["AMD ROCm Driver<br/>≥6.0.0"]
    RHAII -->|"TCP bandwidth"| Iperf3["iperf3"]
    RHAII -->|"RDMA tests"| Perftest["perftest<br/>25.10.0"]
    RHAII -->|"GPUDirect RDMA"| Libcudart["libcudart<br/>CUDA 13.0"]
    RHAII -->|"orchestration"| K8s["Kubernetes<br/>v1.35+"]

    %% Internal Platform Dependencies (CRD checks)
    RHAII -.->|"CRD existence check"| GatewayAPI["Gateway API CRDs<br/>(gateways, httproutes)"]
    RHAII -.->|"CRD existence check"| InferencePool["InferencePool CRD<br/>(inference.networking)"]
    RHAII -.->|"CRD existence check"| LWSCrd["LeaderWorkerSet CRD"]

    %% Internal Platform Dependencies (operator checks)
    RHAII -.->|"operator health"| CertMgr["cert-manager"]
    RHAII -.->|"operator health"| Istio["Istio"]
    RHAII -.->|"operator health"| LWSOp["LeaderWorkerSet<br/>Operator"]

    %% Device Plugins
    RHAII -->|"GPU resources"| GPUPlugin["GPU Device Plugin<br/>(nvidia.com/gpu,<br/>amd.com/gpu)"]
    RHAII -->|"RDMA resources"| RDMAPlugin["RDMA Device Plugin<br/>(nvidia.com/roce,<br/>rdma/*)"]

    %% Platform Integration
    RHAII -.->|"privileged SCC<br/>(OCP only)"| SCC["OpenShift SCC"]

