graph LR
    RHAII["rhaii-cluster-validation<br/>(kubectl plugin)"]

    %% External Dependencies
    RHAII -->|"GPU checks<br/>nvidia-smi"| NVDriver["NVIDIA GPU Driver<br/>≥535.0"]
    RHAII -->|"GPU checks<br/>rocm-smi"| AMDDriver["AMD ROCm Driver<br/>≥6.0.0"]
    RHAII -->|"TCP bandwidth"| iperf3["iperf3"]
    RHAII -->|"RDMA tests"| perftest["perftest<br/>(ib_write_bw,<br/>ibv_rc_pingpong)<br/>25.10.0"]
    RHAII -->|"GPUDirect RDMA"| libcudart["libcudart<br/>CUDA 13.0"]
    RHAII -->|"Job orchestration<br/>node discovery"| K8s["Kubernetes<br/>v1.35+"]

    %% Internal Platform Dependencies (CRD checks)
    RHAII -->|"CRD existence check"| GatewayAPI["Gateway API CRDs<br/>(gateways, httproutes)"]
    RHAII -->|"CRD existence check"| InferencePool["Inference Extension CRDs<br/>(inferencepools)"]
    RHAII -->|"CRD existence check"| LWS["LeaderWorkerSet CRDs<br/>(leaderworkersets)"]

    %% Internal Platform Dependencies (operator checks)
    RHAII -->|"operator health"| CertManager["cert-manager<br/>(cert-manager ns)"]
    RHAII -->|"operator health"| Istio["Istio<br/>(istio-system ns)"]
    RHAII -->|"operator health"| LWSOperator["LWS Operator<br/>(openshift-lws-operator ns)"]

    %% Resource providers
    RHAII -.->|"GPU resources"| GPUPlugin["GPU Device Plugin<br/>(nvidia.com/gpu,<br/>amd.com/gpu)"]
    RHAII -.->|"RDMA resources"| RDMAPlugin["RDMA Device Plugin<br/>(nvidia.com/roce,<br/>rdma/*)"]

    %% Platform integration
    RHAII -.->|"privileged SCC"| SCC["OpenShift SCC<br/>(OCP only)"]

    %% Styling
    style RHAII fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

