graph LR
    RHAII["RHAII Cluster<br/>Validation"]

    %% External Dependencies
    subgraph ExternalDeps["External Dependencies"]
        K8s["Kubernetes 1.30+"]
        NVIDIADriver["NVIDIA GPU Driver<br/>>=535.0"]
        AMDDriver["AMD ROCm Driver"]
        CUDA["CUDA Runtime<br/>(libcudart 13.0)"]
        RDMACore["rdma-core<br/>(libibverbs, librdmacm)"]
        IBDiags["infiniband-diags<br/>(ibstat)"]
        Iperf3["iperf3"]
        Perftest["perftest 25.10.0<br/>(ib_write_bw,<br/>ibv_rc_pingpong)"]
    end

    RHAII -->|"Job scheduling,<br/>RBAC, ConfigMap<br/>6443/TCP HTTPS"| K8s
    RHAII -->|"GPU validation<br/>(conditional)"| NVIDIADriver
    RHAII -->|"GPU validation<br/>(conditional)"| AMDDriver
    RHAII -->|"GPUDirect RDMA<br/>(conditional)"| CUDA
    RHAII -->|"RDMA device enum<br/>(conditional)"| RDMACore
    RHAII -->|"NIC status<br/>(conditional)"| IBDiags
    RHAII -->|"TCP bandwidth<br/>5201/TCP"| Iperf3
    RHAII -->|"RDMA bandwidth<br/>18515+/TCP"| Perftest

    %% Internal Platform Dependencies (CRD/Operator checks)
    subgraph InternalPlatform["Internal Platform Dependencies (Validated)"]
        GatewayAPI["Gateway API CRDs<br/>(gateways, httproutes)"]
        InferencePool["InferencePool CRD<br/>(inference.networking.x-k8s.io)"]
        LWS["LeaderWorkerSet<br/>CRD + Operator"]
        CertManager["cert-manager<br/>CRD + Operator"]
        Istio["Istio Control Plane<br/>(istio-system)"]
    end

    RHAII -.->|"CRD presence check"| GatewayAPI
    RHAII -.->|"CRD presence check"| InferencePool
    RHAII -.->|"CRD + pod health"| LWS
    RHAII -.->|"CRD + pod health"| CertManager
    RHAII -.->|"pod health check"| Istio

    %% External Services
    subgraph ExternalServices["External Services"]
        Registry["Container Registry<br/>(quay.io / registry.redhat.io)<br/>443/TCP HTTPS"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    end

    RHAII -->|"image pulls<br/>443/TCP HTTPS"| Registry
    RHAII -->|"all orchestration<br/>6443/TCP HTTPS"| K8sAPI

    %% Platform Configurations
    subgraph Platforms["Platform Auto-Detection"]
        OCP["OpenShift (OCP)"]
        AKS["Azure (AKS)"]
        EKS["AWS (EKS)"]
        CoreWeave["CoreWeave"]
    end

    RHAII -.->|"auto-detect via<br/>node labels"| OCP
    RHAII -.->|"auto-detect"| AKS
    RHAII -.->|"auto-detect"| EKS
    RHAII -.->|"auto-detect"| CoreWeave

    %% Styling
    style RHAII fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8s fill:#999,stroke:#333
    style NVIDIADriver fill:#76b900,stroke:#333,color:#fff
    style AMDDriver fill:#ed1c24,stroke:#333,color:#fff
    style CUDA fill:#76b900,stroke:#333,color:#fff
    style RDMACore fill:#999,stroke:#333
    style IBDiags fill:#999,stroke:#333
    style Iperf3 fill:#999,stroke:#333
    style Perftest fill:#999,stroke:#333
    style GatewayAPI fill:#7ed321,stroke:#333
    style InferencePool fill:#7ed321,stroke:#333
    style LWS fill:#7ed321,stroke:#333
    style CertManager fill:#7ed321,stroke:#333
    style Istio fill:#7ed321,stroke:#333
    style Registry fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style OCP fill:#ee0000,stroke:#333,color:#fff
    style AKS fill:#0078d4,stroke:#333,color:#fff
    style EKS fill:#ff9900,stroke:#333
    style CoreWeave fill:#6366f1,stroke:#333,color:#fff
