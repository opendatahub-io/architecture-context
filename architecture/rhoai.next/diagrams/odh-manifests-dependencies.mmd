graph LR
    ODH["odh-manifests<br/>Manifest Repository"]

    %% External Dependencies
    ODH -->|"manifest rendering"| Kustomize["Kustomize"]
    ODH -->|"deployment orchestration"| KfDef["kfctl / KfDef Operator<br/>v1"]
    ODH -->|"platform target"| OpenShift["OpenShift 4.x<br/>Routes, OAuth, Templates, SCCs"]
    ODH -.->|"service mesh (optional)"| Istio["Istio /<br/>OpenShift Service Mesh"]
    ODH -.->|"webhook certs (optional)"| CertManager["cert-manager"]

    %% Internal Platform Dependencies - Bundled Components
    ODH -->|"CRD bundle"| KServe["KServe Controller<br/>4 CRDs, 19K-line manifest"]
    ODH -->|"controller + runtimes"| ModelMeshCtrl["ModelMesh Controller<br/>ClusterServingRuntimes"]
    ODH -->|"controller manifest"| OdhModelCtrl["odh-model-controller<br/>3 replicas, HA"]
    ODH -->|"dashboard + overlay"| Dashboard["ODH Dashboard<br/>RHOAI overlay"]
    ODH -->|"CRDs + controller"| DSPO["Data Science Pipelines<br/>Operator"]
    ODH -->|"CRDs + controllers"| NotebookCtrl["Notebook Controller<br/>Kubeflow + ODH"]
    ODH -->|"CRDs + operator"| TrustYAI["TrustYAI Service<br/>Operator"]
    ODH -->|"CRDs + operator"| RayOp["Ray Operator"]
    ODH -->|"monitoring stack"| PromGrafana["Prometheus + Grafana"]
    ODH -->|"distributed computing"| CodeFlare["CodeFlare Stack"]

    %% Runtime Integration (odh-model-controller watches/creates)
    OdhModelCtrl -->|"CRD Watch"| KServe
    OdhModelCtrl -->|"CRD CRUD"| PromOp["prometheus-operator<br/>ServiceMonitor / PodMonitor"]
    OdhModelCtrl -.->|"VirtualService, PeerAuth"| Istio
    OdhModelCtrl -->|"Route Watch"| OpenShift

    %% Consumers
    DashboardUI["ODH Dashboard UI"] -->|"serves templates"| ODH
    Pipelines["Data Science Pipelines"] -->|"deploys models"| KServe

    style ODH fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Kustomize fill:#999,stroke:#333
    style KfDef fill:#999,stroke:#333
    style OpenShift fill:#999,stroke:#333
    style Istio fill:#999,stroke:#333
    style CertManager fill:#999,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ModelMeshCtrl fill:#7ed321,stroke:#333
    style OdhModelCtrl fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style DSPO fill:#7ed321,stroke:#333
    style NotebookCtrl fill:#7ed321,stroke:#333
    style TrustYAI fill:#7ed321,stroke:#333
    style RayOp fill:#7ed321,stroke:#333
    style PromGrafana fill:#7ed321,stroke:#333
    style CodeFlare fill:#7ed321,stroke:#333
    style PromOp fill:#f5a623,stroke:#333
    style DashboardUI fill:#f5a623,stroke:#333
    style Pipelines fill:#f5a623,stroke:#333
