graph LR
    LMES["lm-evaluation-harness-sobha<br/>(lmes-job)"]

    %% Internal Platform Dependencies
    LMES -.->|"job launcher<br/>(creates K8s Job)"| TrustyAI["trustyai-service-operator"]

    %% Core Runtime Dependencies
    LMES -->|"evaluation framework"| LMEvalPkg["lm_eval v0.4.8<br/>(EleutherAI)"]
    LMES -->|"job lifecycle"| EvalHubSDK["eval-hub-sdk v0.1.7"]

    %% ML/AI Dependencies
    LMES -->|"tensor ops"| PyTorch["torch v2.6.0"]
    LMES -->|"tokenization"| Transformers["transformers v4.48.0"]
    LMES -->|"distributed inference"| Accelerate["accelerate v1.0.1"]
    LMES -->|"datasets"| Datasets["datasets v3.1.0"]
    LMES -->|"metrics"| Evaluate["evaluate v0.4.3"]
    LMES -->|"LoRA adapters"| PEFT["peft v0.13.2"]
    LMES -->|"eval framework"| Unitxt["unitxt v1.17.2"]

    %% External Services
    LMES -->|"POST /v1/completions<br/>Bearer token"| ModelEndpoint["Model Inference<br/>Endpoint"]
    LMES -->|"status callbacks<br/>Bearer token"| EvalHub["EvalHub Service"]
    LMES -->|"tokenizers & data<br/>HF_TOKEN"| HFHub["HuggingFace Hub"]
    LMES -->|"model assets<br/>AWS IAM"| S3["S3-Compatible<br/>Storage"]
    LMES -->|"result artifacts<br/>Registry creds"| OCIRegistry["OCI Registry"]
    LMES -->|"metrics logging<br/>Bearer token"| MLflow["MLflow"]

    %% Utility Dependencies
    LMES -->|"S3 access"| Boto3["boto3 v1.42.12"]
    LMES -->|"HTTP client"| Requests["requests v2.32.5"]
    LMES -->|"async HTTP"| Aiohttp["aiohttp v3.13.3"]
    LMES -->|"OCI artifacts"| Olot["olot v0.1.15"]

