graph TB
    subgraph External["CLUSTER-INTERNAL CLIENTS"]
        Client["Client<br/>(e.g., Prometheus)<br/>Bearer Token / OIDC / Client Cert"]
    end

    subgraph Pod["POD BOUNDARY"]
        direction TB

        subgraph Sidecar["kube-rbac-proxy Sidecar"]
            TLS["TLS Termination<br/>8443/TCP<br/>TLS 1.2+<br/>CertReloader (hot-reload)"]
            Authn["Authentication<br/>TokenReview / OIDC / X509"]
            Authz["Authorization<br/>Hardcoded → Static → SAR<br/>Cache: 5m allow / 30s deny"]
            Audit["Audit Logger<br/>JSON structured"]
            Proxy["Reverse Proxy"]
        end

        subgraph UpstreamContainer["Upstream Container"]
            Upstream["Upstream Service<br/>(e.g., metrics endpoint)"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph Monitoring["OPENSHIFT MONITORING"]
        Prometheus["prometheus-k8s SA<br/>(hardcoded allow for GET /metrics)"]
    end

    %% Flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token / OIDC / Client Cert"| TLS
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>Hardcoded Allow (bypass SAR)"| TLS
    TLS --> Authn
    Authn --> Authz
    Authz --> Audit
    Audit --> Proxy
    Authn -->|"TokenReview (create)<br/>HTTPS/6443<br/>SA Token"| K8sAPI
    Authz -->|"SubjectAccessReview (create)<br/>HTTPS/6443<br/>SA Token"| K8sAPI
    Proxy -->|"HTTP localhost<br/>configurable port<br/>No encryption"| Upstream

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sidecar fill:#4a90e2,stroke:#2171b5,stroke-width:2px,color:#fff
    classDef upstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class TLS,Authn,Authz,Audit,Proxy sidecar
    class Upstream upstream
    class K8sAPI controlplane
    class Prometheus monitoring
