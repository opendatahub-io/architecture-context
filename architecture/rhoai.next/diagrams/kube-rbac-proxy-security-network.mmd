graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(via Gateway/Service)"]
        Prometheus["Prometheus<br/>openshift-monitoring<br/>prometheus-k8s SA"]
    end

    subgraph PodBoundary["POD BOUNDARY (Trust Zone)"]
        subgraph Sidecar["kube-rbac-proxy Sidecar"]
            TLS["TLS Listener<br/>8443/TCP HTTPS<br/>TLS 1.2+ (configurable ciphers)<br/>HTTP/2 ALPN enabled<br/>FIPS: strictfipsruntime"]
            AuthN["AuthN Layer<br/>1. Delegating (TokenReview, 2m cache)<br/>2. OIDC JWT (dynamic CA reload)<br/>3. X.509 Client Cert"]
            AuthZ["AuthZ Chain (union.New)<br/>1. Hardcoded: prometheus-k8s → /metrics<br/>2. Static allow-list<br/>3. SAR (5m allow / 30s deny cache)"]
            Proxy["Reverse Proxy"]

            TLS --> AuthN
            AuthN --> AuthZ
            AuthZ -->|"authorized"| Proxy
        end

        subgraph UpstreamZone["UPSTREAM (Trusted - localhost only)"]
            Upstream["Upstream Application<br/>8080/TCP HTTP<br/>No auth required<br/>Loopback interface only"]
        end

        Proxy -->|"HTTP/8080<br/>localhost<br/>No encryption<br/>Pre-authorized"| Upstream
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+ enforced<br/>ALPN: h2, http/1.1"]
    end

    subgraph ExternalIDP["EXTERNAL IDENTITY (Optional)"]
        OIDC["OIDC Identity Provider<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Public endpoint"]
    end

    subgraph CertMgmt["CERTIFICATE MANAGEMENT"]
        CertManager["cert-manager /<br/>Platform Operator"]
    end

    %% Inbound flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token / OIDC JWT / mTLS cert"| TLS
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>SA Token (hardcoded allow)"| TLS

    %% Outbound flows
    AuthN -->|"TokenReview<br/>HTTPS/443<br/>TLS 1.2+<br/>SA Token (in-cluster)"| APIServer
    AuthZ -->|"SubjectAccessReview<br/>HTTPS/443<br/>TLS 1.2+<br/>SA Token (in-cluster)"| APIServer
    AuthN -.->|"OIDC Discovery + JWKS<br/>HTTPS/443<br/>TLS 1.2+"| OIDC

    %% Cert provisioning
    CertManager -.->|"TLS cert/key<br/>hot-reload via CertReloader"| Sidecar

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sidecar fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef upstream fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef certmgmt fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client,Prometheus external
    class TLS,AuthN,AuthZ,Proxy sidecar
    class Upstream upstream
    class APIServer controlplane
    class OIDC externalservice
    class CertManager certmgmt
