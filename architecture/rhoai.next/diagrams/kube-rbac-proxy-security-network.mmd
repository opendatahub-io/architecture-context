graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>(via Platform Gateway/HTTPRoute)"]
    end

    subgraph SidecarProxy["SIDECAR PROXY (kube-rbac-proxy)"]
        direction TB
        KRP["kube-rbac-proxy<br/>Listen: 0.0.0.0:8443<br/>TLS 1.2+ (configurable)<br/>ALPN: h2, http/1.1<br/>Client Auth: RequestClientCert"]

        subgraph AuthChain["Authentication + Authorization"]
            direction LR
            TokenReview["TokenReview<br/>(Bearer Token)"]
            X509["X.509<br/>(Client Cert CN)"]
            OIDC["OIDC JWT<br/>(--oidc-issuer)"]
            SAR["SubjectAccessReview<br/>(Format1 / Format2)"]
            HardcodedMetrics["Hardcoded Metrics<br/>(prometheus-k8s SA)"]
        end
    end

    subgraph AppPod["APPLICATION CONTAINER (Same Pod)"]
        App["Component Application<br/>127.0.0.1:8080<br/>HTTP (plaintext)"]
    end

    subgraph ClusterServices["CLUSTER SERVICES (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph Monitoring["OPENSHIFT MONITORING"]
        Prometheus["Prometheus<br/>SA: prometheus-k8s<br/>Namespace: openshift-monitoring"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Optional)"]
        OIDCProvider["OIDC Identity Provider<br/>443/TCP HTTPS<br/>Configurable CA"]
    end

    %% Inbound flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token /<br/>Client TLS Cert /<br/>OIDC JWT"| KRP
    Prometheus -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token (SA)<br/>GET /metrics → hardcoded ALLOW"| KRP

    %% Internal auth flows
    KRP --> AuthChain

    %% Outbound to upstream
    KRP -->|"HTTP/8080<br/>localhost (no encryption)<br/>Headers: x-remote-user,<br/>x-remote-groups"| App

    %% Outbound to cluster services
    TokenReview -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>TokenReview API"| K8sAPI
    SAR -->|"HTTPS/443<br/>TLS 1.2+<br/>SA Token<br/>SubjectAccessReview API"| K8sAPI

    %% Outbound to external services
    OIDC -->|"HTTPS/443<br/>TLS (custom CA)<br/>OIDC Discovery + JWKS"| OIDCProvider

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#dbeafe,stroke:#3b82f6,stroke-width:3px
    classDef auth fill:#e0f2fe,stroke:#0284c7,stroke-width:1px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#fce4ec,stroke:#e57373,stroke-width:2px
    classDef externalservice fill:#f3e5f5,stroke:#ab47bc,stroke-width:2px

    class Client external
    class KRP proxy
    class TokenReview,X509,OIDC,SAR,HardcodedMetrics auth
    class App app
    class K8sAPI cluster
    class Prometheus monitoring
    class OIDCProvider externalservice
