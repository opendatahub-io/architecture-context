graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Dashboard"]
    end

    subgraph AuthProxy["AUTH PROXY (Sidecar)"]
        KRBP["kube-rbac-proxy<br/>TLS termination<br/>OAuth Bearer validation"]
    end

    subgraph Application["APPLICATION (Pod-internal)"]
        direction TB

        subgraph MainServer["Main App - API Server"]
            APIPort["127.0.0.1:8081/TCP HTTP<br/>(loopback only)"]
            HTTPSPort["0.0.0.0:4443/TCP HTTPS<br/>TLS (system crypto policy)<br/>PolicyAwareConfig"]
        end

        subgraph HealthServer["Health App - Consumer Server"]
            HealthPort["0.0.0.0:8080/TCP HTTP<br/>No Authentication"]
        end

        subgraph StorageBackends["Storage Backends"]
            PVC["PVC / HDF5<br/>Local file I/O"]
            MariaDBConn["MariaDB Connector<br/>TLS optional"]
        end
    end

    subgraph Platform["PLATFORM SERVICES (Cluster-internal)"]
        KServeLogger["KServe Inference Logger"]
        MMAgent["ModelMesh Agent"]
        Prometheus["Prometheus Server"]
        Kubelet["Kubelet"]
        Operator["trustyai-service-operator<br/>Kubernetes API"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        MariaDB["MariaDB<br/>3306/TCP<br/>MySQL wire protocol<br/>TLS optional<br/>User/Pass auth"]
    end

    %% External to Auth Proxy
    User -->|"HTTPS<br/>OAuth Bearer Token"| KRBP

    %% Auth Proxy to Application
    KRBP -->|"HTTP/8081<br/>Loopback (127.0.0.1)<br/>Forwarded identity"| APIPort

    %% Direct HTTPS access
    User -.->|"HTTPS/4443<br/>TLS (system crypto)<br/>mTLS/Bearer"| HTTPSPort

    %% Platform to Health App
    Kubelet -->|"HTTP/8080<br/>No Auth<br/>GET /q/health/*"| HealthPort
    KServeLogger -->|"HTTP/8080<br/>CloudEvents<br/>No Auth"| HealthPort
    MMAgent -->|"HTTP/8080<br/>JSON (gzip)<br/>No Auth"| HealthPort

    %% Prometheus scrape
    Prometheus -->|"HTTP/8081<br/>via kube-rbac-proxy"| KRBP

    %% Storage connections
    HealthPort --> PVC
    HealthPort --> MariaDBConn
    APIPort --> PVC
    APIPort --> MariaDBConn

    %% Egress
    MariaDBConn -->|"MySQL/3306<br/>TLS optional<br/>User/Pass"| MariaDB

    %% Operator management
    Operator -.->|"Kubernetes API<br/>CRD watch<br/>Deployment mgmt"| Application

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authproxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class KRBP authproxy
    class APIPort,HTTPSPort,HealthPort,PVC,MariaDBConn application
    class KServeLogger,MMAgent,Prometheus,Kubelet,Operator platform
    class MariaDB externalservice
