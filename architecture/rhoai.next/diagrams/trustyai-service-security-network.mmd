graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        KServeAgent["KServe Agent<br/>Inference payloads"]
        ModelMeshAgent["ModelMesh Agent<br/>Protobuf payloads"]
        DashboardClient["RHOAI Dashboard<br/>API client"]
        PromScraper["Prometheus Scraper<br/>Metrics collection"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
        KRBP["kube-rbac-proxy<br/>8443/TCP<br/>TLS Termination<br/>Bearer Token → K8s RBAC<br/>(SubjectAccessReview)"]
    end

    subgraph AppBoundary["APPLICATION (Pod-Local)"]
        direction TB

        subgraph HTTPListener["HTTP Listener (Loopback Only)"]
            HTTP["127.0.0.1:8080<br/>HTTP (no encryption)<br/>CORS: allow_origins=[*]<br/>Gzip middleware"]
        end

        subgraph HTTPSListener["HTTPS Listener (Optional)"]
            HTTPS["0.0.0.0:4443<br/>HTTPS TLS 1.2+<br/>Certs: /etc/tls/internal/<br/>Direct access (no proxy)"]
        end

        subgraph AppCore["TrustyAI Service Core"]
            Consumers["Payload Consumers<br/>KServe V2 + ModelMesh"]
            Metrics["Metric Engines<br/>SPD, DIR, KS, t-test"]
            Scheduler["Prometheus Scheduler<br/>Periodic computation"]
            Publisher["Prometheus Publisher<br/>Gauge registry"]
            LMEval["LM Eval Harness<br/>Subprocess sandboxed<br/>Blocked: LD_PRELOAD,<br/>PYTHONPATH, PATH"]
        end
    end

    subgraph Storage["STORAGE (Egress)"]
        PVC["PVC Storage<br/>HDF5 Files<br/>Local I/O<br/>No encryption"]
        MariaDB["MariaDB<br/>3306/TCP<br/>MariaDB protocol<br/>TLS (optional)<br/>ssl_verify_cert=True<br/>Auth: user/pass"]
    end

    subgraph ExtServices["EXTERNAL SERVICES (Egress)"]
        LMEvalAPIs["LM Eval API Providers<br/>(OpenAI, Anthropic, etc.)<br/>443/TCP HTTPS<br/>TLS<br/>Auth: API key"]
    end

    subgraph K8s["KUBERNETES PLATFORM"]
        Probes["Kubelet<br/>Health Probes"]
    end

    %% Ingress flows
    KServeAgent -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KRBP
    ModelMeshAgent -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KRBP
    DashboardClient -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KRBP
    PromScraper -->|"HTTPS/8443<br/>TLS<br/>Bearer Token"| KRBP

    %% Auth to App
    KRBP -->|"HTTP/8080<br/>Loopback<br/>No encryption<br/>Trusted (authenticated)"| HTTP

    %% K8s probes (direct)
    Probes -->|"HTTP/8080<br/>Direct<br/>No auth"| HTTP

    %% Internal flows
    HTTP --> Consumers
    HTTP --> Metrics
    HTTP --> LMEval
    Scheduler --> Publisher

    %% Egress flows
    Consumers -->|"Local I/O"| PVC
    Consumers -->|"3306/TCP<br/>MariaDB<br/>TLS optional"| MariaDB
    Scheduler -->|"Local I/O"| PVC
    Scheduler -->|"3306/TCP<br/>MariaDB"| MariaDB
    LMEval -->|"HTTPS/443<br/>TLS<br/>API key"| LMEvalAPIs

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:3px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class KServeAgent,ModelMeshAgent,DashboardClient,PromScraper external
    class KRBP auth
    class HTTP,HTTPS,Consumers,Metrics,Scheduler,Publisher,LMEval app
    class PVC,MariaDB storage
    class LMEvalAPIs extservice
    class Probes k8s
