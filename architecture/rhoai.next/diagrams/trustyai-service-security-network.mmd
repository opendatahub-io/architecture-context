graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        KServeAgent["KServe/ModelMesh Agent"]
        Dashboard["OpenShift Dashboard"]
        PromServer["Prometheus Server"]
    end

    subgraph AuthProxy["AUTH PROXY (Trust Boundary)"]
        KubeRBACProxy["kube-rbac-proxy<br/>8443/TCP → 127.0.0.1:8080/TCP<br/>TLS termination<br/>Kubernetes RBAC (SubjectAccessReview)"]
    end

    subgraph Application["APPLICATION POD (TrustyAI Service)"]
        direction TB

        subgraph HTTPListener["HTTP Listener (loopback only)"]
            HTTP["127.0.0.1:8080/TCP<br/>HTTP, No encryption<br/>No auth (proxy-validated)"]
        end

        subgraph HTTPSListener["HTTPS Listener (optional)"]
            HTTPS["0.0.0.0:4443/TCP<br/>HTTPS, TLS 1.2+<br/>TLS client certificate auth<br/>Cert: /etc/tls/internal/tls.crt"]
        end

        subgraph SecurityControls["Security Controls"]
            NoPickle["JSON+gzip serialization<br/>(CWE-502 mitigation)"]
            EnvSecurity["Env var allowlist<br/>(CWE-426/427 mitigation)"]
            FIPS["FIPS crypto policy<br/>(update-crypto-policies)"]
        end
    end

    subgraph Storage["STORAGE (Egress)"]
        PVC["PersistentVolumeClaim<br/>Filesystem (HDF5)<br/>File locking per dataset"]
        MariaDB["MariaDB (optional)<br/>3306/TCP MySQL<br/>TLS optional (CA cert)<br/>Username/Password auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        LLMEndpoint["LLM Inference Endpoint<br/>(optional, for lm-eval)<br/>HTTP/HTTPS, TLS 1.2+<br/>API key auth"]
    end

    %% Inbound flows
    KServeAgent -->|"HTTPS/8443<br/>TLS 1.2+<br/>Kubernetes RBAC"| KubeRBACProxy
    Dashboard -->|"HTTPS/8443<br/>TLS 1.2+<br/>Kubernetes RBAC"| KubeRBACProxy
    PromServer -->|"HTTPS/8443<br/>GET /q/metrics<br/>Kubernetes RBAC"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8080<br/>Loopback only<br/>No auth (validated)"| HTTP

    %% Direct HTTPS access
    Dashboard -.->|"HTTPS/4443<br/>TLS 1.2+<br/>Client cert"| HTTPS

    %% Egress flows
    HTTP -->|"Filesystem<br/>Per-model HDF5 files"| PVC
    HTTP -->|"MySQL/3306<br/>TLS optional<br/>Password auth"| MariaDB
    HTTP -->|"HTTP(S)<br/>TLS 1.2+<br/>API key"| LLMEndpoint

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authproxy fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef security fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class KServeAgent,Dashboard,PromServer external
    class KubeRBACProxy authproxy
    class HTTP,HTTPS application
    class PVC,MariaDB storage
    class LLMEndpoint externalservice
    class NoPickle,EnvSecurity,FIPS security
