    PraxisExtproc -->|"filter pipeline"| PraxisCore["praxis-core<br/>0.7.1"]
    PraxisExtproc -->|"filter execution"| PraxisFilter["praxis-filter<br/>0.7.1"]
    PraxisExtproc -->|"FIPS TLS provider"| PraxisTLS["praxis-tls<br/>0.7.1"]
    PraxisExtproc -->|"AI filters"| PraxisAI["praxis-ai-filters<br/>v0.4.1"]
    PraxisExtproc -->|"ExtProc proto"| PraxisProto["praxis-proto<br/>(local)"]

    %% Runtime Dependencies
    PraxisExtproc -->|"async runtime"| Tokio["tokio 1.52.2"]
    PraxisExtproc -->|"gRPC server"| Tonic["tonic 0.14.6"]
    PraxisExtproc -->|"TLS/crypto"| OpenSSL["openssl 0.10.81"]

