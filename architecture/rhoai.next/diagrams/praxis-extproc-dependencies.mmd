graph LR
    PraxisExtproc["praxis-extproc<br/>(Envoy ExtProc Server)"]

    %% Internal RHOAI Dependencies
    PraxisExtproc -->|"gRPC ExtProc<br/>9004/TCP"| IstioGateway["Istio Gateway<br/>(Envoy)"]
    PraxisExtproc -->|"filter chain<br/>ordering"| Kuadrant["Kuadrant<br/>(Auth WasmPlugin)"]
    PraxisExtproc -->|"X-Gateway-Model-Name<br/>header routing"| InferencePool["KServe<br/>InferencePool"]

