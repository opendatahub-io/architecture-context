graph TB
    subgraph "llm-d Inference Stack"
        direction TB

        subgraph "Container Images"
            CudaImage["Dockerfile.cuda<br/>NVIDIA GPU Image<br/>vLLM + CUDA 13.0.2"]
            CudaGB200["Dockerfile.cuda (GB200)<br/>Blackwell Variant<br/>ARM64"]
            RocmImage["Dockerfile.rocm<br/>AMD GPU Image<br/>vLLM + ROCm"]
            XpuImage["Dockerfile.xpu<br/>Intel XPU Image<br/>vLLM + SYCL"]
            CpuImage["Dockerfile.cpu<br/>CPU-Only Image<br/>x86_64 + ARM64"]
            RdmaTools["Dockerfile.rdma-tools<br/>Diagnostic Image<br/>iperf3, perftest, NCCL"]
        end

        subgraph "Runtime Components (in-container)"
            vLLM["vLLM v0.23.0<br/>Inference Engine<br/>Port 8000/TCP"]
            FlashInfer["FlashInfer v0.6.12<br/>Attention Kernels"]
            DeepEP["DeepEP<br/>Expert Routing<br/>(MoE models)"]
            DeepGEMM["DeepGEMM<br/>Matrix Multiply"]
            LMCache["LMCache v0.4.6<br/>KV Cache Mgmt"]
            NIXL["NIXL v1.2.0<br/>KV Transfer"]
            UCX["UCX v1.20.0<br/>Communication"]
            NVSHMEM["NVSHMEM v3.4.5<br/>GPU Shared Memory"]
        end

        subgraph "Deployment Guides"
            OptBaseline["Optimized Baseline<br/>Single-phase serving"]
            PDDisagg["P/D Disaggregation<br/>Prefill/Decode split"]
            WideEP["Wide EP<br/>MoE Expert Parallelism"]
            FlowCtrl["Flow Control<br/>Multi-tenant fairness"]
            TieredCache["Tiered Prefix Cache<br/>CPU/disk offloading"]
            PredLatency["Predicted Latency<br/>SLO-aware routing"]
        end

        subgraph "Kustomize Recipes"
            GatewayRecipe["Gateway Recipes<br/>Istio / kGateway / Envoy AI"]
            ModelServerRecipe["Model Server Recipes<br/>Bases + Overlays"]
            MonitoringRecipe["Monitoring<br/>PodMonitor"]
        end
    end

    %% Container image composition
    CudaImage --> vLLM
    CudaImage --> FlashInfer
    CudaImage --> DeepEP
    CudaImage --> DeepGEMM
    CudaImage --> LMCache
    CudaImage --> NIXL
    CudaImage --> UCX
    CudaImage --> NVSHMEM
    CudaGB200 -.->|GB200 DeepEP variant| CudaImage

    %% Guide composition
    OptBaseline -->|uses| ModelServerRecipe
    OptBaseline -->|uses| GatewayRecipe
    PDDisagg -->|uses| ModelServerRecipe
    PDDisagg -->|uses| GatewayRecipe
    WideEP -->|uses| ModelServerRecipe

    %% External components (sibling repos)
    EPP["llm-d-router<br/>(EPP)<br/>Endpoint Picker"]
    Sidecar["llm-d-routing-sidecar<br/>KV Cache Routing"]
    KVCache["llm-d-kv-cache<br/>Offloading Connector"]

    EPP -->|selects endpoint| vLLM
    Sidecar -->|routes KV| NIXL
    KVCache -->|offloads KV| LMCache

    %% External infrastructure
    Envoy["Envoy Proxy<br/>Port 8081/TCP"]
    GatewayAPI["Gateway API<br/>InferencePool CRD"]

    Envoy -->|ext_proc gRPC 9002| EPP
    Envoy -->|forwards to| vLLM
    GatewayAPI -->|watched by| EPP

    Client["Client"] -->|HTTP 8081| Envoy

    %% Styling
    style CudaImage fill:#76b900,stroke:#333,color:#000
    style CudaGB200 fill:#76b900,stroke:#333,color:#000
    style RocmImage fill:#ed1c24,stroke:#333,color:#fff
    style XpuImage fill:#0071c5,stroke:#333,color:#fff
    style CpuImage fill:#666,stroke:#333,color:#fff
    style RdmaTools fill:#999,stroke:#333,color:#000
    style vLLM fill:#4a90e2,stroke:#333,color:#fff
    style EPP fill:#7ed321,stroke:#333,color:#000
    style Sidecar fill:#7ed321,stroke:#333,color:#000
    style KVCache fill:#7ed321,stroke:#333,color:#000
    style Envoy fill:#f5a623,stroke:#333,color:#000
    style GatewayAPI fill:#f5a623,stroke:#333,color:#000
    style Client fill:#e8e8e8,stroke:#333,color:#000
