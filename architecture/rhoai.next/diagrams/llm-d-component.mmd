graph TB
    subgraph "llm-d Integration Platform"
        direction TB

        subgraph ContainerImages["Container Images"]
            CPUImage["vLLM CPU Image<br/>ghcr.io/llm-d/llm-d-cpu<br/>Python / Ubuntu 22.04"]
            XPUImage["vLLM XPU Image<br/>ghcr.io/llm-d/llm-d-xpu<br/>Intel DC GPU Max"]
            ROCmImage["vLLM ROCm Image<br/>ghcr.io/llm-d/llm-d-rocm<br/>AMD Instinct"]
            RDMATools["RDMA Tools Image<br/>ghcr.io/llm-d/llm-d-rdma-tools<br/>Diagnostics / UBI9"]
        end

        subgraph DeploymentRecipes["Deployment Recipes"]
            Guides["Well-Lit-Path Guides<br/>15+ patterns across<br/>10+ accelerators"]
            Recipes["Reusable Recipes<br/>Kustomize Bases +<br/>Components"]
        end
    end

    subgraph SiblingComponents["Sibling Components"]
        Router["llm-d-router<br/>EPP + L7 Proxy<br/>Helm Chart"]
        KVCache["llm-d-kv-cache<br/>Distributed Cache"]
        RoutingSidecar["llm-d-routing-sidecar<br/>P/D Disaggregation"]
        Async["llm-d-async<br/>Batch/Queue Workloads"]
        BatchGW["llm-d-batch-gateway<br/>OpenAI Batch API"]
        LatencyPredictor["llm-d-latency-predictor<br/>XGBoost Scoring"]
    end

    subgraph ExternalDeps["External Dependencies"]
        vLLM["vLLM v0.30.0<br/>Inference Engine"]
        GatewayAPI["Gateway API<br/>Inference Extension"]
        K8s["Kubernetes 1.29+"]
        LWS["LeaderWorkerSet<br/>v0.11.1"]
    end

    subgraph Accelerators["Supported Accelerators"]
        NVIDIA["NVIDIA GPU<br/>H100/B200"]
        AMD["AMD GPU<br/>MI355X"]
        IntelXPU["Intel XPU<br/>DC GPU Max 1550+"]
        TPU["Google TPU<br/>v6e / v7"]
        CPU["CPU<br/>AMX/AVX512"]
        Others["Rebellions NPU<br/>Iluvatar / MetaX"]
    end

    %% Relationships
    CPUImage -->|embeds| vLLM
    XPUImage -->|layers on| vLLM
    ROCmImage -->|layers on| vLLM

    Guides -->|references| CPUImage
    Guides -->|references| XPUImage
    Guides -->|references| ROCmImage
    Guides -->|composes| Recipes

    Guides -->|deploys via Helm| Router
    Guides -->|configures| KVCache
    Guides -->|includes| RoutingSidecar

    Recipes -->|targets| K8s
    Recipes -->|uses| GatewayAPI
    Recipes -->|uses| LWS

    CPUImage -.->|runs on| CPU
    XPUImage -.->|runs on| IntelXPU
    ROCmImage -.->|runs on| AMD
    Guides -.->|covers| NVIDIA
    Guides -.->|covers| TPU
    Guides -.->|covers| Others

    %% Styling
    style CPUImage fill:#4a90e2,stroke:#333,color:#fff
    style XPUImage fill:#4a90e2,stroke:#333,color:#fff
    style ROCmImage fill:#4a90e2,stroke:#333,color:#fff
    style RDMATools fill:#6c757d,stroke:#333,color:#fff
    style Guides fill:#f5a623,stroke:#333,color:#fff
    style Recipes fill:#f5a623,stroke:#333,color:#fff
    style Router fill:#7ed321,stroke:#333
    style KVCache fill:#7ed321,stroke:#333
    style RoutingSidecar fill:#7ed321,stroke:#333
    style Async fill:#7ed321,stroke:#333
    style BatchGW fill:#7ed321,stroke:#333
    style LatencyPredictor fill:#7ed321,stroke:#333
    style vLLM fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
    style LWS fill:#e8e8e8,stroke:#333
