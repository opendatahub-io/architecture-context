graph TB
    subgraph "llm-d Router"
        direction TB

        subgraph EPP["Endpoint Picker (EPP)"]
            direction TB
            ExtProc["gRPC ext-proc Server<br/>9002/TCP TLS"]
            HealthSrv["gRPC Health Server<br/>9003/TCP"]
            MetricsSrv["Metrics Server<br/>9090/TCP HTTP"]
            PluginEngine["Plugin Engine"]
            DataStore["Endpoint Datastore"]

            subgraph Plugins["Plugin Architecture"]
                direction LR
                Filters["Filters<br/>(label, prefix-cache,<br/>session, SLO-tiers)"]
                Scorers["Scorers<br/>(KV-cache, queue-depth,<br/>load, LoRA, latency)"]
                Pickers["Pickers<br/>(max-score, random,<br/>weighted-random)"]
            end

            subgraph DataLayer["Data Layer"]
                direction LR
                MetricsSource["Prometheus Metrics<br/>Polling (50ms)"]
                DCGMSource["DCGM GPU<br/>Metrics"]
                ZMQSource["ZMQ KV-Events<br/>5557/TCP"]
                TopoExtractor["Topology<br/>Extractor"]
            end

            PluginEngine --> Filters
            PluginEngine --> Scorers
            PluginEngine --> Pickers
            DataLayer --> DataStore
            PluginEngine --> DataStore
        end

        subgraph Sidecar["Disaggregation Sidecar (pd-sidecar)"]
            direction TB
            ProxyListener["HTTP Proxy<br/>8000/TCP"]
            KVConnector["KV Connector<br/>(NIXLv2/SharedStorage/<br/>SGLang/Mooncake)"]
            ECConnector["Encoder Connector<br/>(EC-NIXL/EC-Example)"]
        end

        subgraph CoordBlock["Coordinator (upstream-only)"]
            direction TB
            CoordServer["HTTP Server<br/>8080/TCP"]
            PipelineOrch["Pipeline Orchestrator<br/>(Render→Encode→Prefill→Decode)"]
        end
    end

    %% CRDs
    InferencePool["InferencePool CR<br/>(GIE v1)"]
    InferenceObj["InferenceObjective CR<br/>(llm-d.ai v1alpha2)"]
    InferenceRewrite["InferenceModelRewrite CR<br/>(llm-d.ai v1alpha2)"]

    %% External systems
    Envoy["Envoy Proxy<br/>(L7)"]
    K8sAPI["Kubernetes API<br/>443/TCP"]
    ModelServers["vLLM / SGLang<br/>Model Servers"]
    OTEL["OTEL Collector<br/>4317/TCP"]
    Prometheus["Prometheus"]
    Redis["Redis<br/>(Optional)"]

    %% EPP flows
    Envoy -->|"gRPC ext-proc<br/>bidirectional stream"| ExtProc
    ExtProc -->|"routing decision"| Envoy
    ExtProc --> PluginEngine
    K8sAPI -->|"CRD watches"| DataStore
    InferencePool -->|"watched by"| DataStore
    InferenceObj -->|"watched by"| DataStore
    InferenceRewrite -->|"watched by"| DataStore
    MetricsSource -->|"scrape"| ModelServers
    DCGMSource -->|"scrape"| DCGM["DCGM Exporter"]
    MetricsSrv -->|"scraped by"| Prometheus
    EPP -->|"traces"| OTEL
    ZMQSource -.->|"optional"| Redis

    %% Sidecar flows
    ProxyListener -->|"prefill requests"| PrefillPods["Remote Prefill Pods"]
    ProxyListener -->|"decode requests<br/>8200/TCP"| LocalVLLM["Local vLLM Decoder"]
    KVConnector -->|"KV-cache transfer"| PrefillPods

    %% Coordinator flows
    CoordServer -->|"dispatch stages"| InfGateway["Inference Gateway<br/>80/TCP"]
    CoordServer -->|"tokenize"| RenderSvc["Rendering Service<br/>8080/TCP"]

    %% Envoy to model servers
    Envoy -->|"routed request<br/>8000/TCP"| ModelServers

