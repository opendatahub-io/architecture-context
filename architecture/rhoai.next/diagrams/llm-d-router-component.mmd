graph TB
    subgraph LLMDRouter["llm-d Router"]
        subgraph EPP["Endpoint Picker (EPP)"]
            ExtProc["ExternalProcessor<br/>gRPC Service<br/>9002/TCP"]
            HealthSvc["Health Service<br/>gRPC<br/>9003/TCP"]
            Metrics1["Metrics Server<br/>HTTP<br/>9090/TCP"]
            PluginPipeline["Plugin Pipeline<br/>(Filters + Scorers)"]
            Datastore["In-Memory Datastore<br/>(Pool State)"]
            DataLayer["Data-Layer Plugins<br/>(Metrics, DCGM, Models)"]
            ZMQSub["ZMQ Subscriber<br/>5557/TCP"]
            ExtProc -->|evaluates| PluginPipeline
            PluginPipeline -->|reads| Datastore
            DataLayer -->|populates| Datastore
            ZMQSub -->|KV-cache events| Datastore
        end

        subgraph Controllers["Controllers"]
            PoolCtrl["InferencePool<br/>Controller"]
            ObjCtrl["InferenceObjective<br/>Controller"]
            RewriteCtrl["InferenceModelRewrite<br/>Controller"]
            PodCtrl["Pod Controller"]
            PoolCtrl -->|updates| Datastore
            ObjCtrl -->|updates| Datastore
            RewriteCtrl -->|updates| Datastore
            PodCtrl -->|updates| Datastore
        end

        subgraph CoordinatorSvc["Coordinator"]
            CoordHTTP["HTTP Server<br/>8080/TCP"]
            CoordMetrics["Metrics Server<br/>9090/TCP"]
            Pipeline["Pipeline Steps<br/>(render, encode,<br/>prefill, decode,<br/>async-broker)"]
            CoordHTTP -->|executes| Pipeline
        end

        subgraph Sidecar["PD-Sidecar"]
            ProxyListener["Reverse Proxy<br/>8000/TCP"]
            ProxyListener -->|orchestrates| PrefillFwd["Prefill Forward"]
            ProxyListener -->|orchestrates| EncodeFwd["Encode Forward"]
            ProxyListener -->|proxies| DecodeFwd["Decode Forward"]
        end
    end

    %% External actors
    Client["External Client"]
    Envoy["Envoy Proxy"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    ModelPods["Model Server Pods"]
    InfGateway["Inference Gateway<br/>80/TCP"]
    RenderSvc["Rendering Service<br/>8080/TCP"]
    Redis["Redis<br/>6379/TCP"]
    OTel["OpenTelemetry<br/>Collector"]

    %% CRDs
    EPConfig["EndpointPickerConfig CR"]
    InfPool["InferencePool CR"]
    InfObj["InferenceObjective CR"]
    InfRewrite["InferenceModelRewrite CR"]

    %% Flows
    Client -->|HTTPS| Envoy
    Envoy -->|gRPC ext-proc| ExtProc
    ExtProc -->|routing headers| Envoy
    Envoy -->|forwards to| ModelPods

    Controllers -->|watch/list| K8sAPI
    DataLayer -->|scrapes| ModelPods

    EPConfig -->|configures| PluginPipeline
    InfPool -->|watched by| PoolCtrl
    InfObj -->|watched by| ObjCtrl
    InfRewrite -->|watched by| RewriteCtrl

    Client -->|HTTPS| CoordHTTP
    Pipeline -->|HTTP| InfGateway
    Pipeline -->|HTTP| RenderSvc
    Pipeline -->|TCP| Redis

    ProxyListener -->|HTTP/HTTPS| ModelPods

    EPP -.->|OTLP/gRPC| OTel
    CoordinatorSvc -.->|OTLP/gRPC| OTel

    %% Styling
    style ExtProc fill:#4a90e2,stroke:#333,color:#fff
    style HealthSvc fill:#4a90e2,stroke:#333,color:#fff
    style PluginPipeline fill:#4a90e2,stroke:#333,color:#fff
    style Datastore fill:#4a90e2,stroke:#333,color:#fff
    style CoordHTTP fill:#50b5a9,stroke:#333,color:#fff
    style Pipeline fill:#50b5a9,stroke:#333,color:#fff
    style ProxyListener fill:#9b59b6,stroke:#333,color:#fff
    style EPConfig fill:#f5a623,stroke:#333
    style InfPool fill:#f5a623,stroke:#333
    style InfObj fill:#f5a623,stroke:#333
    style InfRewrite fill:#f5a623,stroke:#333
    style Envoy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ModelPods fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
