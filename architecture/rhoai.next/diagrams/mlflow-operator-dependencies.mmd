graph LR
    MLflowOp["MLflow Operator<br/>(mlflow-operator)"]

    %% External Go Dependencies
    MLflowOp -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    MLflowOp -->|"chart rendering"| Helm["helm.sh/helm/v3<br/>v3.19.2"]
    MLflowOp -->|"HTTPRoute CRD<br/>(conditional)"| GatewayAPI["gateway-api<br/>v1.4.1"]
    MLflowOp -->|"ConsoleLink, TLS profile"| OpenshiftAPI["openshift/api<br/>v0.0.0-20260317"]
    MLflowOp -->|"TLS profile watching"| OpenshiftCRCommon["openshift/controller-<br/>runtime-common"]
    MLflowOp -->|"ServiceMonitor CRD<br/>(conditional)"| PromOperator["prometheus-operator<br/>v0.89.0"]
    MLflowOp -->|"env-based config"| Viper["spf13/viper<br/>v1.21.0"]
    MLflowOp -->|"version comparison"| Semver["Masterminds/semver<br/>v3.4.0"]

    %% Internal Platform Dependencies
    MLflowOp -->|"module handoff CR"| PlatformOp["opendatahub-operator /<br/>rhods-operator"]
    MLflowOp -->|"HTTPRoute parent ref"| Gateway["data-science-gateway"]
    MLflowOp -->|"app menu entry"| Console["OpenShift Console"]
    MLflowOp -->|"workspace groups"| AuthCR["Auth CR<br/>(services.platform.opendatahub.io)"]
    MLflowOp -->|"CA bundle"| CABundle["odh-trusted-ca-bundle<br/>ConfigMap"]
    MLflowOp -->|"metrics scraping"| Prometheus["Prometheus<br/>(ServiceMonitor)"]
    MLflowOp -->|"deploys"| MLflowImage["MLflow Server Image"]

    %% Consumers (what depends on MLflow Operator)
    PlatformOp -->|"creates MLflowOperator CR"| MLflowOp
    Dashboard["ODH Dashboard"] -.->|"UI management"| MLflowOp

    %% External Services (Operand dependencies)
    MLflowImage -->|"metadata store"| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    MLflowImage -->|"artifact store"| S3["S3-Compatible Storage<br/>443/9000/TCP"]
    MLflowOp -->|"API server"| K8sAPI["Kubernetes API<br/>6443/TCP"]

