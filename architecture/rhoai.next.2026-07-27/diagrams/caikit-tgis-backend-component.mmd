graph TB
    subgraph ModelMeshPod["ModelMesh Serving Pod"]
        direction TB

        subgraph ModelMeshContainer["ModelMesh Container"]
            ModelMesh["ModelMesh<br/>TLS/Auth Boundary"]
        end

        subgraph CaikitContainer["caikit-tgis-backend Container"]
            CaikitModule["Caikit Module Backend<br/>(Python gRPC Service)"]
            LBProxy["GRPCLoadBalancerProxy<br/>(DNS-based Load Balancer)"]
            CaikitModule -->|delegates inference| LBProxy
        end

        ModelMesh -->|pod-local gRPC| CaikitModule
    end

    Client[External Client] -->|gRPC<br/>TLS + Auth| ModelMesh

    subgraph gRPCServices["fmaas.GenerationService"]
        Generate["Generate"]
        GenerateStream["GenerateStream"]
        ModelInfo["ModelInfo"]
        Tokenize["Tokenize"]
    end

    CaikitModule -.->|implements| gRPCServices

    subgraph TGISCluster["TGIS (Text Generation Inference Server)"]
        TGIS1["TGIS Instance 1"]
        TGIS2["TGIS Instance 2"]
        TGIS_N["TGIS Instance N"]
    end

    LBProxy -->|gRPC<br/>configurable TLS| TGIS1
    LBProxy -->|gRPC<br/>round_robin| TGIS2
    LBProxy -->|gRPC| TGIS_N
    LBProxy -.->|HTTP health checks| TGISCluster

    DNS["DNS Service"] -.->|endpoint discovery<br/>poll interval: 10s| LBProxy

    CaikitRuntime["Caikit Runtime<br/>(Python Library)"] -.->|framework| CaikitModule

    style ModelMesh fill:#e8a838,stroke:#333,stroke-width:2px
    style CaikitModule fill:#4a90e2,stroke:#333,stroke-width:2px
    style LBProxy fill:#4a90e2,stroke:#333,stroke-width:2px
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style TGIS1 fill:#7ed321,stroke:#333
    style TGIS2 fill:#7ed321,stroke:#333
    style TGIS_N fill:#7ed321,stroke:#333
    style CaikitRuntime fill:#d5e8d4,stroke:#82b366
    style DNS fill:#fff2cc,stroke:#d6b656
