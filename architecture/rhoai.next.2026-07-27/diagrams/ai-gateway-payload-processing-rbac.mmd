graph TD
    subgraph "Service Account"
        SA["ai-gateway-payload-processing<br/>ServiceAccount<br/><i>(defined in deploy/payload-processing/templates/rbac.yaml)</i>"]
    end

    subgraph "Inferred RBAC Permissions"
        direction TB
        Note["Note: RBAC defined in Helm templates<br/>(deploy/payload-processing/templates/rbac.yaml)<br/>Not fully parseable by analyzer"]
    end

    subgraph "Watched Resources (For)"
        ExternalModel["inference.opendatahub.io/v1alpha1<br/>ExternalModel<br/><b>watch, get, list, create, update</b>"]
        ExternalProvider["inference.opendatahub.io/v1alpha1<br/>ExternalProvider<br/><b>watch, get, create, update</b>"]
    end

    subgraph "Owned Resources (Owns)"
        HTTPRoute["gateway.networking.k8s.io/v1<br/>HTTPRoute<br/><b>watch, get, create, update</b>"]
        Service["v1/Service<br/><b>watch, get, create, update</b>"]
    end

    subgraph "Read-Only Resources"
        Secret["v1/Secret<br/><b>get</b>"]
    end

    subgraph "Created Resources"
        ServiceEntry["networking.istio.io<br/>ServiceEntry<br/><b>create, update</b>"]
        DestinationRule["networking.istio.io<br/>DestinationRule<br/><b>create, update</b>"]
    end

    subgraph "Legacy Resources (conditional)"
        LegacyModel["maas.opendatahub.io<br/>ExternalModel<br/><b>watch, get, list</b>"]
    end

    SA -->|"manages"| ExternalModel
    SA -->|"manages"| ExternalProvider
    SA -->|"owns"| HTTPRoute
    SA -->|"owns"| Service
    SA -->|"reads"| Secret
    SA -->|"creates"| ServiceEntry
    SA -->|"creates"| DestinationRule
    SA -.->|"watches (legacy)"| LegacyModel

    %% Credential Secrets
    subgraph "Credential Secrets Referenced"
        OpenAICreds["openai-credentials<br/><i>Opaque · api-key</i>"]
        AnthropicCreds["anthropic-credentials<br/><i>Opaque · api-key</i>"]
        AzureCreds["azure-credentials<br/><i>Opaque · api-key</i>"]
        VertexCreds["vertex-credentials<br/><i>Opaque · api-key</i>"]
    end

    Secret -->|"references"| OpenAICreds
    Secret -->|"references"| AnthropicCreds
    Secret -->|"references"| AzureCreds
    Secret -->|"references"| VertexCreds

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style ExternalModel fill:#7ed321,stroke:#333
    style ExternalProvider fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
    style Secret fill:#f5a623,stroke:#333
    style ServiceEntry fill:#7ed321,stroke:#333
    style DestinationRule fill:#7ed321,stroke:#333
    style LegacyModel fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
    style OpenAICreds fill:#f8cecc,stroke:#b85450
    style AnthropicCreds fill:#f8cecc,stroke:#b85450
    style AzureCreds fill:#f8cecc,stroke:#b85450
    style VertexCreds fill:#f8cecc,stroke:#b85450
