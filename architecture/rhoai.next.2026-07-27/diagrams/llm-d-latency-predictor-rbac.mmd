graph TD
    subgraph "Application Authentication"
        NoAuth["No Auth Middleware<br/>FastAPI/Starlette<br/>All endpoints unauthenticated"]
    end

    subgraph "Kubernetes RBAC"
        NoRBAC["No ClusterRoles Defined<br/>No RoleBindings Defined<br/>No explicit ServiceAccounts"]
    end

    subgraph "Exposed Endpoints (No Auth)"
        direction TB
        PredEndpoints["Prediction Server :8001"]
        TrainEndpoints["Training Server :8000"]
    end

    subgraph "Prediction API (Unauthenticated)"
        Predict["POST /predict"]
        PredictBulk["POST /predict/bulk"]
        PredictStrict["POST /predict/bulk/strict"]
        Reload["POST /reload"]
        Status["GET /status"]
        PredHealth["GET /healthz, /readyz"]
    end

    subgraph "Training API (Unauthenticated)"
        AddData["POST /add_training_data_bulk"]
        Flush["POST /flush"]
        DataStatus["GET /data/status"]
        Metrics["GET /metrics"]
        ModelList["GET /models/list"]
        ModelInfo["GET /model/{name}/info"]
        ModelDL["GET /model/{name}/download"]
        Debug["GET /debug/prefix_distribution"]
        TrainHealth["GET /healthz, /readyz"]
    end

    subgraph "Environment Variable Secrets"
        EnvVar1["LATENCY_ENABLE_TOKEN_IN_FLIGHT_FEATURES<br/>Feature flag"]
        EnvVar2["LATENCY_TPOT_ZERO_TOKEN_COUNT<br/>Feature flag"]
    end

    NoAuth -->|"applies to"| PredEndpoints
    NoAuth -->|"applies to"| TrainEndpoints
    PredEndpoints --> Predict
    PredEndpoints --> PredictBulk
    PredEndpoints --> PredictStrict
    PredEndpoints --> Reload
    PredEndpoints --> Status
    PredEndpoints --> PredHealth
    TrainEndpoints --> AddData
    TrainEndpoints --> Flush
    TrainEndpoints --> DataStatus
    TrainEndpoints --> Metrics
    TrainEndpoints --> ModelList
    TrainEndpoints --> ModelInfo
    TrainEndpoints --> ModelDL
    TrainEndpoints --> Debug
    TrainEndpoints --> TrainHealth

    style NoAuth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style NoRBAC fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style PredEndpoints fill:#ffe6cc,stroke:#d79b00
    style TrainEndpoints fill:#ffe6cc,stroke:#d79b00
    style EnvVar1 fill:#fff2cc,stroke:#d6b656
    style EnvVar2 fill:#fff2cc,stroke:#d6b656
