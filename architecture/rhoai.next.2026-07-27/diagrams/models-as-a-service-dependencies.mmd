graph LR
    MaaS["Models-as-a-Service<br/>Operator"]

    %% Internal RHOAI Dependencies
    MaaS -->|"watches LLMInferenceService<br/>(conditional)"| KServe["KServe"]

    %% Platform Dependencies
    MaaS -->|"HTTPRoute/Gateway CRUD"| GatewayAPI["Gateway API 1.5+"]
    MaaS -->|"AuthPolicy &<br/>TokenRateLimitPolicy"| Kuadrant["Kuadrant"]
    MaaS -->|"TokenReview &<br/>SubjectAccessReview"| K8sAPI["Kubernetes API<br/>:6443"]
    MaaS -->|"Authentication config<br/>discovery"| OSAuth["OpenShift<br/>Authentication"]

    %% External Service Dependencies
    MaaS -->|"tenant/subscription data<br/>maas-db-config secret"| PostgreSQL["PostgreSQL"]
    MaaS -->|"OTLP/gRPC traces"| OTEL["OpenTelemetry<br/>Collector"]

    %% Build/Runtime Dependencies
    MaaS -.->|"operator framework"| ControllerRuntime["controller-runtime<br/>0.23.3"]
    MaaS -.->|"HTTP framework"| Gin["gin-gonic/gin<br/>1.10.1"]
    MaaS -.->|"JWT handling"| JWT["golang-jwt/jwt<br/>5.3.0"]
    MaaS -.->|"DB driver"| PGX["jackc/pgx<br/>5.9.2"]
    MaaS -.->|"DB migrations"| Migrate["golang-migrate<br/>4.19.1"]
    MaaS -.->|"OpenAI compat"| OpenAI["openai-go<br/>2.3.1"]

    %% Consumers / Integration Points
    Prometheus["Prometheus"] -->|"scrapes :9090/metrics"| MaaS
    IngressGW["maas-default-gateway<br/>(openshift-ingress)"] -->|"routes to :8443"| MaaS

