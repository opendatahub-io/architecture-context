graph TB
    subgraph MaaS["Models-as-a-Service Operator"]
        direction TB

        subgraph Manager["manager (Go binary)"]
            AITenantCtrl["AITenant Controller"]
            DeploymentCtrl["Deployment Controller"]
            ExternalModelCtrl["ExternalModel Controller"]
            MaaSAuthPolicyCtrl["MaaSAuthPolicy Controller"]
            MaaSModelRefCtrl["MaaSModelRef Controller"]
            MaaSSubscriptionCtrl["MaaSSubscription Controller"]
            MaasTenantConfigCtrl["MaasTenantConfig Controller"]
        end

        subgraph API["maas-api (Go binary)"]
            RESTServer["REST Server<br/>:8080 HTTP / :8443 HTTPS"]
            MetricsServer["Metrics Server<br/>:9090"]
        end

        subgraph Webhooks["Admission Webhooks"]
            WH1["AITenant Validator"]
            WH2["MaaSAuthPolicy Validator"]
            WH3["MaaSSubscription Validator"]
        end
    end

    %% CRDs
    AITenantCR["AITenant CR"]
    ConfigCR["Config CR<br/>(Cluster-scoped)"]
    ExternalModelCR["ExternalModel CR"]
    MaaSAuthPolicyCR["MaaSAuthPolicy CR"]
    MaaSModelRefCR["MaaSModelRef CR"]
    MaaSSubscriptionCR["MaaSSubscription CR"]
    MaasTenantConfigCR["MaasTenantConfig CR"]
    TenantCR["Tenant CR"]

    %% Controller watches
    AITenantCR -->|watched by| AITenantCtrl
    ExternalModelCR -->|watched by| ExternalModelCtrl
    MaaSAuthPolicyCR -->|watched by| MaaSAuthPolicyCtrl
    MaaSModelRefCR -->|watched by| MaaSModelRefCtrl
    MaaSSubscriptionCR -->|watched by| MaaSSubscriptionCtrl
    MaasTenantConfigCR -->|watched by| MaasTenantConfigCtrl
    ConfigCR -->|watched by| MaasTenantConfigCtrl

    %% Cross-controller watches
    AITenantCR -.->|watches| MaaSAuthPolicyCtrl
    AITenantCR -.->|watches| MaaSSubscriptionCtrl
    MaaSModelRefCR -.->|watches| MaaSAuthPolicyCtrl
    MaaSModelRefCR -.->|watches| MaaSSubscriptionCtrl
    MaaSSubscriptionCR -.->|watches| MaaSModelRefCtrl

    %% Webhook validations
    AITenantCR -->|validated by| WH1
    MaaSAuthPolicyCR -->|validated by| WH2
    MaaSSubscriptionCR -->|validated by| WH3

    %% External dependencies
    GatewayAPI["Gateway API<br/>(HTTPRoute / Gateway)"]
    Kuadrant["Kuadrant<br/>(AuthPolicy / TokenRateLimitPolicy)"]
    KServe["KServe<br/>(LLMInferenceService)"]
    K8sAPI["Kubernetes API<br/>:6443"]

    %% Controller → external resource management
    MaaSAuthPolicyCtrl -->|creates/deletes| Kuadrant
    MaaSSubscriptionCtrl -->|creates| Kuadrant
    MaaSSubscriptionCtrl -->|creates/manages| GatewayAPI
    ExternalModelCtrl -->|creates/manages| GatewayAPI
    MaaSModelRefCtrl -.->|watches| KServe

    %% API server interactions
    RESTServer -->|TokenReview| K8sAPI
    RESTServer -->|SubjectAccessReview| K8sAPI

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style API fill:#4a90e2,stroke:#333,color:#fff
    style Webhooks fill:#e87d3e,stroke:#333,color:#fff
    style AITenantCR fill:#f5a623,stroke:#333
    style ConfigCR fill:#f5a623,stroke:#333
    style ExternalModelCR fill:#f5a623,stroke:#333
    style MaaSAuthPolicyCR fill:#f5a623,stroke:#333
    style MaaSModelRefCR fill:#f5a623,stroke:#333
    style MaaSSubscriptionCR fill:#f5a623,stroke:#333
    style MaasTenantConfigCR fill:#f5a623,stroke:#333
    style TenantCR fill:#f5a623,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Kuadrant fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
