graph TD
    subgraph ProviderContext["Provider Security Context"]
        Note["llama-stack-provider-ragas<br/>runs inside Llama Stack server process.<br/>No own RBAC definitions.<br/>Inherits host process security context."]
    end

    subgraph LlamaStackHost["Llama Stack Server"]
        HostSA["Host Service Account<br/>(Llama Stack server SA)"]
    end

    subgraph KFPExecution["KFP Pipeline Execution"]
        KFPSA["KFP Pipeline Runner<br/>Service Account"]
    end

    subgraph SecretsAccess["Secrets Access"]
        AWSSecret["Kubernetes Secret<br/>(AWS Credentials)<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
        BearerToken["KFP Bearer Token<br/>(Provider Config)"]
    end

    subgraph Resources["Accessed Resources"]
        KFPAPI["Kubeflow Pipelines API<br/>Pipeline submission<br/>Run status polling"]
        S3["S3 Storage<br/>Results read/write"]
        LlamaStackAPI["Llama Stack APIs<br/>Inference, DatasetIO<br/>Files, Benchmarks"]
    end

    %% Provider inherits host SA
    HostSA -->|"provider runs in<br/>host process"| Note

    %% Remote mode - KFP interactions
    Note -->|"Bearer Token auth"| KFPAPI
    BearerToken -->|"authenticates to"| KFPAPI

    %% KFP pods - Secret access
    KFPSA -->|"kfp.kubernetes<br/>.use_secret_as_env"| AWSSecret
    AWSSecret -->|"mounted as env vars<br/>into pipeline pods"| KFPSA
    KFPSA -->|"AWS IAM auth"| S3

    %% Inline mode - in-process
    Note -->|"in-process calls<br/>(no RBAC needed)"| LlamaStackAPI

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style HostSA fill:#4a90e2,stroke:#333,color:#fff
    style KFPSA fill:#4a90e2,stroke:#333,color:#fff
    style AWSSecret fill:#f5a623,stroke:#333
    style BearerToken fill:#f5a623,stroke:#333
    style KFPAPI fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style LlamaStackAPI fill:#e8e8e8,stroke:#333
