graph TB
    subgraph "vLLM Inference Container"
        subgraph "Container Image: odh-vllm-cuda-rhel9"
            direction TB
            VLLMEngine["vLLM Engine<br/>GPU-Accelerated Inference<br/>PagedAttention"]
            UvicornServer["Uvicorn Server<br/>Port 8000/TCP"]
            TGISAdapter["vllm-tgis-adapter<br/>Port 8033/TCP"]

            VLLMEngine -->|serves| UvicornServer
            VLLMEngine -->|serves| TGISAdapter
        end
    end

    subgraph "Base Image"
        BaseImage["rhaiis/vllm-cuda-rhel9:3.2.2<br/>registry.redhat.io"]
    end

    subgraph "Build System"
        Konflux["Konflux Pipelines<br/>Tekton PipelineRuns"]
        KonfluxCentral["konflux-central<br/>Build Definitions"]
        Konflux -->|references| KonfluxCentral
    end

    subgraph "Clients"
        HTTPClient["HTTP Client"]
        GRPCClient["gRPC Client"]
    end

    subgraph "Platform Layer"
        KServe["KServe / Model Serving Stack<br/>Deployment Management"]
        ServiceMesh["Service Mesh<br/>mTLS, Auth, TLS Termination"]
    end

    HTTPClient -->|"OpenAI-compatible API<br/>POST /v1/..."| UvicornServer
    GRPCClient -->|"TGIS Protocol"| TGISAdapter

    BaseImage -.->|"inherited runtime"| VLLMEngine
    Konflux -->|"builds"| BaseImage

    KServe -->|"deploys & manages"| VLLMEngine
    ServiceMesh -->|"secures traffic"| UvicornServer
    ServiceMesh -->|"secures traffic"| TGISAdapter

    %% Styling
    style VLLMEngine fill:#4a90e2,stroke:#333,color:#fff
    style UvicornServer fill:#4a90e2,stroke:#333,color:#fff
    style TGISAdapter fill:#4a90e2,stroke:#333,color:#fff
    style BaseImage fill:#f5a623,stroke:#333,color:#fff
    style Konflux fill:#999,stroke:#333,color:#fff
    style KonfluxCentral fill:#999,stroke:#333,color:#fff
    style HTTPClient fill:#e8e8e8,stroke:#333
    style GRPCClient fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ServiceMesh fill:#7ed321,stroke:#333,color:#fff
