graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Application["APPLICATION (OGX Server Container)"]
        direction TB
        Entrypoint["entrypoint.sh<br/>Resolves 18 _FILE secrets<br/>from K8s mounts"]
        subgraph OGXServer["OGX Server :8321/TCP"]
            direction LR
            APIs["8 API Families:<br/>responses, messages, batches,<br/>inference, tool_runtime,<br/>vector_io, files, file_processors"]
            AuthModule["OAuth2/JWKS Auth<br/>(optional, disabled by default)<br/>Owner-based access policy"]
        end
        Entrypoint -->|launches| OGXServer
    end

    subgraph InferenceProviders["INFERENCE PROVIDERS (env-var activated)"]
        direction LR
        vLLM["vLLM<br/>HTTP/HTTPS"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>AWS IAM"]
        WatsonX["IBM WatsonX<br/>443/TCP HTTPS<br/>API Key/IAM"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>API Key/Azure AD"]
        VertexAI["Vertex AI / Gemini<br/>443/TCP HTTPS<br/>Service Account"]
        OpenAI["OpenAI<br/>443/TCP HTTPS<br/>API Key Bearer"]
        AnthropicAPI["Anthropic<br/>443/TCP HTTPS<br/>x-api-key"]
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>kv_postgres + sql_postgres<br/>Username/Password<br/>HARD DEPENDENCY"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>AWS IAM / Access Key<br/>(optional)"]
    end

    subgraph VectorStores["VECTOR STORES (env-var activated)"]
        direction LR
        MilvusDB["Milvus<br/>19530/TCP gRPC<br/>Token auth"]
        QdrantDB["Qdrant<br/>6333/TCP HTTP<br/>API Key"]
        PGVectorDB["pgvector<br/>5432/TCP<br/>via PostgreSQL"]
    end

    subgraph ToolServices["TOOL SERVICES (env-var activated)"]
        direction LR
        Brave["Brave Search<br/>443/TCP HTTPS<br/>API Key"]
        Tavily["Tavily Search<br/>443/TCP HTTPS<br/>API Key"]
        MCP["MCP Server<br/>Configurable"]
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        OTEL["OpenTelemetry Collector<br/>OTLP gRPC/HTTP<br/>when OTEL_SERVICE_NAME set"]
    end

    %% Client to OGX
    Client -->|"HTTP :8321<br/>Bearer Token (optional)"| OGXServer

    %% OGX to Inference Providers
    OGXServer -->|"HTTPS/443<br/>API Key/IAM"| vLLM
    OGXServer -->|"HTTPS/443<br/>AWS IAM"| Bedrock
    OGXServer -->|"HTTPS/443<br/>API Key"| WatsonX
    OGXServer -->|"HTTPS/443<br/>API Key"| AzureOAI
    OGXServer -->|"HTTPS/443<br/>Service Account"| VertexAI
    OGXServer -->|"HTTPS/443<br/>API Key"| OpenAI
    OGXServer -->|"HTTPS/443<br/>x-api-key"| AnthropicAPI

    %% OGX to Data Stores
    OGXServer -->|"PostgreSQL/5432<br/>Password auth<br/>REQUIRED"| PostgreSQL
    OGXServer -->|"HTTPS/443<br/>IAM/Access Key"| S3

    %% OGX to Vector Stores
    OGXServer -->|"gRPC/19530"| MilvusDB
    OGXServer -->|"HTTP/6333"| QdrantDB
    OGXServer -->|"PostgreSQL/5432"| PGVectorDB

    %% OGX to Tool Services
    OGXServer -->|"HTTPS/443<br/>API Key"| Brave
    OGXServer -->|"HTTPS/443<br/>API Key"| Tavily
    OGXServer -->|"MCP Protocol"| MCP

    %% Telemetry
    OGXServer -.->|"OTLP<br/>(when enabled)"| OTEL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef provider fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef vectorstore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef toolservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef observability fill:#f5f5f5,stroke:#666,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Entrypoint,APIs,AuthModule application
    class vLLM,Bedrock,WatsonX,AzureOAI,VertexAI,OpenAI,AnthropicAPI provider
    class PostgreSQL,S3 datastore
    class MilvusDB,QdrantDB,PGVectorDB vectorstore
    class Brave,Tavily,MCP toolservice
    class OTEL observability
