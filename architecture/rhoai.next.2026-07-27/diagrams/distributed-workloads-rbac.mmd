graph TD
    subgraph "Service Accounts"
        SA_SD["stable-diffusion-nb<br/>Namespace: distributed"]
        SA_NFS["nfs-server-sa<br/>Namespace: nfs"]
    end

    subgraph "Role Bindings"
        RB_Edit["edit<br/>Namespace: distributed"]
        RB_Anyuid["nfs-server-sa-anyuid<br/>Namespace: nfs"]
        RB_Privileged["nfs-server-sa-privileged<br/>Namespace: nfs"]
    end

    subgraph "ClusterRoles"
        CR_Edit["edit<br/>(built-in ClusterRole)"]
        CR_Anyuid["system:openshift:scc:anyuid<br/>(SCC ClusterRole)"]
        CR_Privileged["system:openshift:scc:privileged<br/>(SCC ClusterRole)"]
    end

    subgraph "Permissions Granted"
        direction TB
        Perm_Edit["Standard Edit Access<br/>create, delete, get, list,<br/>patch, update, watch<br/>on most namespaced resources"]
        Perm_Anyuid["Run as Any UID<br/>Allows containers to run<br/>with arbitrary user IDs"]
        Perm_Privileged["Privileged SCC<br/>Full host access,<br/>privileged containers,<br/>host networking"]
    end

    subgraph "Secrets Access"
        Secret_MinIO["minio<br/>Type: Opaque<br/>MinIO credentials<br/>Provisioned: manifest"]
        Secret_MinIOSecret["minio-secret<br/>Type: Opaque<br/>MinIO credentials<br/>Provisioned: manifest"]
    end

    %% Bindings
    SA_SD -->|"bound via"| RB_Edit
    RB_Edit -->|"grants"| CR_Edit
    CR_Edit -->|"provides"| Perm_Edit

    SA_NFS -->|"bound via"| RB_Anyuid
    RB_Anyuid -->|"grants"| CR_Anyuid
    CR_Anyuid -->|"provides"| Perm_Anyuid

    SA_NFS -->|"bound via"| RB_Privileged
    RB_Privileged -->|"grants"| CR_Privileged
    CR_Privileged -->|"provides"| Perm_Privileged

    %% Secret access
    SA_SD -.->|"uses"| Secret_MinIO
    SA_SD -.->|"uses"| Secret_MinIOSecret

    %% Styling
    style SA_SD fill:#4a90e2,stroke:#333,color:#fff
    style SA_NFS fill:#4a90e2,stroke:#333,color:#fff
    style RB_Edit fill:#5b9bd5,stroke:#333,color:#fff
    style RB_Anyuid fill:#5b9bd5,stroke:#333,color:#fff
    style RB_Privileged fill:#5b9bd5,stroke:#333,color:#fff
    style CR_Edit fill:#f5a623,stroke:#333,color:#fff
    style CR_Anyuid fill:#f5a623,stroke:#333,color:#fff
    style CR_Privileged fill:#e74c3c,stroke:#333,color:#fff
    style Perm_Edit fill:#7ed321,stroke:#333,color:#fff
    style Perm_Anyuid fill:#f39c12,stroke:#333,color:#fff
    style Perm_Privileged fill:#e74c3c,stroke:#333,color:#fff
    style Secret_MinIO fill:#9b59b6,stroke:#333,color:#fff
    style Secret_MinIOSecret fill:#9b59b6,stroke:#333,color:#fff
