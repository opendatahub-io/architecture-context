graph LR
    OGXOperator["ogx-k8s-operator<br/>(Kubernetes Operator)"]

    %% Internal RHOAI Dependencies
    OGXOperator -->|"Go library<br/>platform detection,<br/>manifest rendering"| ODHPlatformUtils["odh-platform-utilities"]
    OGXOperator -->|"CRD CRUD<br/>ServiceMonitors,<br/>PrometheusRules"| PrometheusOp["prometheus-operator"]

    %% Kubernetes Dependencies
    OGXOperator -->|"HTTPS/6443<br/>resource operations"| K8sAPI["Kubernetes API<br/>v0.35.2"]
    OGXOperator -->|"operator framework<br/>v0.23.3"| ControllerRuntime["controller-runtime"]
    OGXOperator -->|"CRD management"| APIExtensions["apiextensions-apiserver"]

    %% OpenShift Dependencies
    OGXOperator -->|"API server config,<br/>SCCs"| OpenShiftAPI["OpenShift API<br/>(openshift/api)"]
    OGXOperator -->|"controller helpers"| OSControllerRuntime["openshift/controller-<br/>runtime-common"]

    %% OCI / Registry
    OGXOperator -->|"OCI label resolution<br/>HTTPS/443"| GoContainerReg["go-containerregistry"]

    %% Config / Manifest Tools
    OGXOperator -->|"manifest rendering"| Kustomize["kustomize<br/>(api + kyaml)"]
    OGXOperator -->|"configuration mgmt"| Viper["spf13/viper"]

    %% CRDs Managed
    OGXOperator -->|"watches/manages"| OGXCRD["OGX CRD<br/>components.platform.<br/>opendatahub.io/v1alpha1"]
    OGXOperator -->|"watches/manages"| OGXServerCRD["OGXServer CRD<br/>ogx.io/v1beta1"]
    OGXOperator -->|"manages"| LlamaStackCRD["LlamaStackDistribution CRD<br/>llamastack.io/v1alpha1"]

    %% Observability
    OGXOperator -.->|"structured logging"| Zap["go.uber.org/zap"]

