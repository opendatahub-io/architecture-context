graph TB
    subgraph LlamaStackServer["Llama Stack Server Process"]
        subgraph ProviderPlugin["llama-stack-provider-ragas (trustyai_ragas)"]
            ProviderSpec["Provider Spec Registry<br/>get_provider_spec()"]
            Config["Provider Config<br/>RagasProviderConfig"]

            subgraph InlineProvider["inline::trustyai_ragas"]
                InlineEval["RagasEvaluatorInline<br/>Eval + BenchmarksProtocolPrivate"]
                InlineLLM["LlamaStackInlineLLM<br/>Ragas-compatible LLM wrapper"]
                InlineEmbed["LlamaStackInlineEmbeddings<br/>Ragas-compatible embedding wrapper"]
                InlineEval -->|wraps| InlineLLM
                InlineEval -->|wraps| InlineEmbed
            end

            subgraph RemoteProvider["remote::trustyai_ragas"]
                RemoteEval["RagasEvaluatorRemote<br/>Eval + BenchmarksProtocolPrivate"]
                KFPPipeline["KFP Pipeline Definition<br/>retrieve_data + run_ragas"]
                RemoteEval -->|defines & submits| KFPPipeline
            end

            ProviderSpec -->|registers| InlineProvider
            ProviderSpec -->|registers| RemoteProvider
            Config -->|configures| InlineProvider
            Config -->|configures| RemoteProvider
        end

        subgraph LlamaStackAPIs["Llama Stack Platform APIs"]
            InferenceAPI["Inference API"]
            DatasetIOAPI["DatasetIO API"]
            FilesAPI["Files API"]
            BenchmarksAPI["Benchmarks API"]
        end

        InlineEval -->|calls iterrows| DatasetIOAPI
        InlineLLM -->|calls| InferenceAPI
        InlineEmbed -->|calls| InferenceAPI
    end

    subgraph ExternalServices["External Services"]
        KFP["Kubeflow Pipelines<br/>API Server"]
        S3["S3 Storage<br/>Results & Datasets"]
        K8sAPI["Kubernetes API"]
    end

    RemoteEval -->|submits pipeline & polls status| KFP
    RemoteEval -->|fetches results| S3
    KFPPipeline -->|retrieves data from| LlamaStackAPIs
    KFPPipeline -->|writes results to| S3
    KFPPipeline -->|mounts secrets via| K8sAPI

    style ProviderPlugin fill:#4a90e2,stroke:#333,color:#fff
    style InlineProvider fill:#5ba3f5,stroke:#333,color:#fff
    style RemoteProvider fill:#5ba3f5,stroke:#333,color:#fff
    style InlineEval fill:#7ed321,stroke:#333,color:#fff
    style RemoteEval fill:#7ed321,stroke:#333,color:#fff
    style InlineLLM fill:#7ed321,stroke:#333,color:#fff
    style InlineEmbed fill:#7ed321,stroke:#333,color:#fff
    style KFPPipeline fill:#7ed321,stroke:#333,color:#fff
    style LlamaStackAPIs fill:#e8e8e8,stroke:#333
    style InferenceAPI fill:#f5a623,stroke:#333
    style DatasetIOAPI fill:#f5a623,stroke:#333
    style FilesAPI fill:#f5a623,stroke:#333
    style BenchmarksAPI fill:#f5a623,stroke:#333
    style KFP fill:#999,stroke:#333
    style S3 fill:#999,stroke:#333
    style K8sAPI fill:#999,stroke:#333
