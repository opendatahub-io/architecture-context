graph TB
    subgraph "rest-proxy Sidecar Container"
        direction TB
        Main["main.go<br/>Entry Point"]
        GRPCGateway["grpc-gateway Runtime<br/>REST-to-gRPC Router"]
        Marshaler["CustomJSONPb Marshaler<br/>Tensor JSON Encoding"]
        Unmarshaler["CustomJSONPb Unmarshaler<br/>Tensor JSON Decoding"]
        RequestHandler["Request Handler<br/>Multi-dim Array &<br/>Base64 Bytes Transform"]
        BytesHandler["Bytes Handler<br/>Binary Tensor Processing"]

        Main -->|configures| GRPCGateway
        GRPCGateway -->|uses| Marshaler
        GRPCGateway -->|uses| Unmarshaler
        Unmarshaler -->|delegates| RequestHandler
        Marshaler -->|delegates| BytesHandler
    end

    RESTClient[REST Client] -->|"HTTP/JSON<br/>Port 8008<br/>KServe V2 Protocol"| Main
    GRPCGateway -->|"gRPC<br/>localhost:8033<br/>ModelInferRequest"| ModelMesh["ModelMesh<br/>Inference Service"]
    ModelMesh -->|"gRPC Response<br/>ModelInferResponse"| GRPCGateway

    subgraph "Configuration (Environment Variables)"
        direction LR
        ListenPort["REST_PROXY_LISTEN_PORT<br/>default: 8008"]
        GRPCPort["REST_PROXY_GRPC_PORT<br/>default: 8033"]
        MaxMsg["REST_PROXY_GRPC_MAX_MSG_SIZE_BYTES<br/>default: 16 MiB"]
        UseTLS["REST_PROXY_USE_TLS"]
        SkipVerify["REST_PROXY_SKIP_VERIFY"]
    end

    ListenPort -.->|configures| Main
    GRPCPort -.->|configures| GRPCGateway

    subgraph "Proto Definition"
        Proto["grpc_predict_v2.proto<br/>GRPCInferenceService"]
    end

    Proto -.->|generates| GRPCGateway

    style Main fill:#4a90e2,stroke:#333
    style GRPCGateway fill:#4a90e2,stroke:#333
    style Marshaler fill:#4a90e2,stroke:#333
    style Unmarshaler fill:#4a90e2,stroke:#333
    style RequestHandler fill:#4a90e2,stroke:#333
    style BytesHandler fill:#4a90e2,stroke:#333
    style RESTClient fill:#f9f9f9,stroke:#999
    style ModelMesh fill:#7ed321,stroke:#333
    style Proto fill:#f5a623,stroke:#333
    style ListenPort fill:#e8e8e8,stroke:#999
    style GRPCPort fill:#e8e8e8,stroke:#999
    style MaxMsg fill:#e8e8e8,stroke:#999
    style UseTLS fill:#e8e8e8,stroke:#999
    style SkipVerify fill:#e8e8e8,stroke:#999
