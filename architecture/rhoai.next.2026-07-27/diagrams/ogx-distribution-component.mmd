graph TB
    subgraph "ogx-distribution Container"
        subgraph "Entrypoint"
            Entrypoint["entrypoint.sh<br/>Secret Resolution<br/>+ OGX Launch"]
        end

        subgraph "OGX Server (port 8321)"
            direction TB
            ResponsesAPI["Responses API"]
            MessagesAPI["Messages API"]
            BatchesAPI["Batches API"]
            InferenceAPI["Inference API"]
            ToolRuntimeAPI["Tool Runtime API"]
            VectorIOAPI["Vector IO API"]
            FilesAPI["Files API"]
            FileProcessorsAPI["File Processors API"]
        end

        subgraph "Inference Providers (pluggable)"
            vLLM["vLLM"]
            Bedrock["AWS Bedrock"]
            WatsonX["IBM WatsonX"]
            Azure["Azure OpenAI"]
            VertexAI["Google Vertex AI"]
            OpenAI["OpenAI"]
            Gemini["Google Gemini"]
            Anthropic["Anthropic"]
            SentenceTransformers["sentence-transformers"]
        end

        subgraph "Vector Store Backends"
            Milvus["Milvus"]
            PGVector["pgvector"]
            Qdrant["Qdrant"]
        end

        subgraph "Tool Runtimes"
            BraveSearch["Brave Search"]
            TavilySearch["Tavily Search"]
            FileSearch["File Search"]
            MCPServer["MCP Server"]
        end

        subgraph "File Processors"
            Docling["docling"]
            Markitdown["markitdown"]
            PyPDF["pypdf"]
        end

        subgraph "Built-in Artifacts"
            GraniteEmbed["IBM Granite<br/>Embedding Model"]
            OTELInstr["OpenTelemetry<br/>Instrumentation"]
        end
    end

    Client[Client] -->|HTTP :8321| ResponsesAPI
    Client -->|HTTP :8321| MessagesAPI
    Client -->|HTTP :8321| InferenceAPI

    InferenceAPI --> vLLM
    InferenceAPI --> Bedrock
    InferenceAPI --> WatsonX
    InferenceAPI --> Azure
    InferenceAPI --> VertexAI
    InferenceAPI --> OpenAI
    InferenceAPI --> Gemini
    InferenceAPI --> Anthropic
    InferenceAPI --> SentenceTransformers

    VectorIOAPI --> Milvus
    VectorIOAPI --> PGVector
    VectorIOAPI --> Qdrant

    ToolRuntimeAPI --> BraveSearch
    ToolRuntimeAPI --> TavilySearch
    ToolRuntimeAPI --> FileSearch
    ToolRuntimeAPI --> MCPServer

    FilesAPI --> FileProcessorsAPI
    FileProcessorsAPI --> Docling
    FileProcessorsAPI --> Markitdown
    FileProcessorsAPI --> PyPDF

    Entrypoint -->|resolves _FILE secrets<br/>launches OGX| ResponsesAPI

    subgraph "External State"
        PostgreSQL["PostgreSQL<br/>(kv_postgres + sql_postgres)"]
        S3["S3 Storage"]
        LocalFS["Local Filesystem"]
    end

    ResponsesAPI --> PostgreSQL
    BatchesAPI --> PostgreSQL
    VectorIOAPI --> PostgreSQL
    FilesAPI --> S3
    FilesAPI --> LocalFS

    OTELInstr -->|OTLP| OTELCollector["OpenTelemetry<br/>Collector"]

    subgraph "Auth (Optional)"
        OAuth2["OAuth2/JWKS<br/>Token Validation"]
    end

    Client -.->|Bearer Token| OAuth2
    OAuth2 -.->|owner-based policy| ResponsesAPI

    style Entrypoint fill:#4a90e2,color:#fff
    style ResponsesAPI fill:#4a90e2,color:#fff
    style MessagesAPI fill:#4a90e2,color:#fff
    style BatchesAPI fill:#4a90e2,color:#fff
    style InferenceAPI fill:#4a90e2,color:#fff
    style ToolRuntimeAPI fill:#4a90e2,color:#fff
    style VectorIOAPI fill:#4a90e2,color:#fff
    style FilesAPI fill:#4a90e2,color:#fff
    style FileProcessorsAPI fill:#4a90e2,color:#fff
    style PostgreSQL fill:#f5a623,color:#fff
    style S3 fill:#f5a623,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style OAuth2 fill:#e74c3c,color:#fff
    style OTELCollector fill:#999,color:#fff
    style GraniteEmbed fill:#7ed321,color:#fff
    style OTELInstr fill:#7ed321,color:#fff
