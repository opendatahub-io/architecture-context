graph TD
    subgraph SecurityPosture["modelmesh-runtime-adapter Security Posture"]
        direction TB

        subgraph NoRBAC["RBAC Configuration"]
            NoCR["No ClusterRoles Defined<br/>(Sidecar component)"]
            NoRB["No RoleBindings Defined<br/>(Managed by ModelMesh)"]
            NoSA["No ServiceAccounts Defined<br/>(Inherits from parent pod)"]
        end

        subgraph AuthN["Authentication Status (All gRPC Services)"]
            direction TB
            NoAuth["No Application-Level Auth<br/>11 authentication rules confirm<br/>no interceptors configured"]
        end

        subgraph GRPCServices["gRPC Services (42 methods, 6 services, 0 auth)"]
            direction TB
            S1["mmesh.ModelRuntime<br/>loadModel, unloadModel,<br/>runtimeStatus, modelSize,<br/>predictModelSize"]
            S2["mmesh.ModelMesh<br/>registerModel, unregisterModel,<br/>ensureLoaded, getModelStatus,<br/>setVModel, getVModelStatus,<br/>deleteVModel"]
            S3["inference.GRPCInferenceService<br/>ModelInfer, ModelReady,<br/>ServerReady, ServerLive,<br/>+ 14 more methods"]
            S4["GRPCInferenceService<br/>(MLServer/KFServing V2)<br/>ModelInfer, ModelReady,<br/>ServerReady, ServerLive"]
            S5["InferenceAPIsService<br/>(TorchServe)<br/>Ping, Predictions"]
            S6["ManagementAPIsService<br/>(TorchServe)<br/>RegisterModel, UnregisterModel,<br/>DescribeModel, ListModels,<br/>ScaleWorker, SetDefault"]
        end

        subgraph PlatformEnforcement["Platform-Level Security (External)"]
            Istio["Istio Service Mesh<br/>mTLS enforcement"]
            NetPol["Kubernetes NetworkPolicy<br/>Pod-level isolation"]
            PodSecurity["Pod Security<br/>Sidecar runs in ModelMesh pod"]
        end
    end

    NoAuth -->|"applies to"| S1
    NoAuth -->|"applies to"| S2
    NoAuth -->|"applies to"| S3
    NoAuth -->|"applies to"| S4
    NoAuth -->|"applies to"| S5
    NoAuth -->|"applies to"| S6

    Istio -.->|"enforces mTLS on<br/>external traffic"| GRPCServices
    NetPol -.->|"restricts pod<br/>network access"| GRPCServices
    PodSecurity -.->|"pod-local traffic<br/>not intercepted"| GRPCServices

    NoCR -.->|"sidecar inherits<br/>parent RBAC"| NoSA

    %% Styling
    style NoCR fill:#fff2cc,stroke:#d6b656
    style NoRB fill:#fff2cc,stroke:#d6b656
    style NoSA fill:#fff2cc,stroke:#d6b656
    style NoAuth fill:#f8cecc,stroke:#b85450
    style S1 fill:#dae8fc,stroke:#6c8ebf
    style S2 fill:#dae8fc,stroke:#6c8ebf
    style S3 fill:#dae8fc,stroke:#6c8ebf
    style S4 fill:#dae8fc,stroke:#6c8ebf
    style S5 fill:#dae8fc,stroke:#6c8ebf
    style S6 fill:#dae8fc,stroke:#6c8ebf
    style Istio fill:#d5e8d4,stroke:#82b366
    style NetPol fill:#d5e8d4,stroke:#82b366
    style PodSecurity fill:#d5e8d4,stroke:#82b366
