graph TB
    subgraph "llm-d-kv-cache System"
        direction TB

        subgraph GoCore["Go Core Services"]
            Indexer["KV Cache Indexer<br/>Prefix-aware pod scoring"]
            IndexerSvc["IndexerService<br/>gRPC :50051"]
            MetricsSrv["Metrics Server<br/>HTTP /metrics"]
            PodRecon["PodReconciler<br/>K8s Pod Controller"]
            SubMgr["SubscriberManager<br/>ZMQ Subscriptions"]
            TokenDB["ChunkedTokenDatabase<br/>Token Processing"]
        end

        subgraph PythonComponents["Python Components"]
            FSBackend["llmd_fs_backend<br/>vLLM FS Connector"]
            UDSTokenizer["UDS Tokenizer Service<br/>TokenizationService gRPC"]
        end

        subgraph HTTPEndpoints["HTTP API :8080"]
            ScoreComp["/score_completions<br/>POST"]
            ScoreChat["/score_chat_completions<br/>POST"]
            Metrics["/metrics<br/>Prometheus"]
        end
    end

    %% Internal relationships
    IndexerSvc -->|wraps| Indexer
    ScoreComp -->|delegates| Indexer
    ScoreChat -->|delegates| Indexer
    Metrics -->|exposes| MetricsSrv
    Indexer -->|queries| TokenDB
    PodRecon -->|manages| SubMgr

    %% External dependencies
    Client[External Client] -->|HTTP POST| ScoreComp
    Client -->|HTTP POST| ScoreChat
    Client -->|gRPC| IndexerSvc

    vLLMPods["vLLM Engine Pods"] -->|ZMQ pub/sub<br/>topic: kv@| SubMgr
    SubMgr -->|KV cache events| Indexer

    PodRecon -->|watches Pods| K8sAPI["Kubernetes API<br/>:6443"]
    Indexer -->|stores KV blocks| Redis["Redis / Valkey"]

    IndexerSvc -->|exports traces| OTel["OpenTelemetry<br/>Collector"]

    FSBackend -->|integrates| vLLMRuntime["vLLM Serving Runtime"]

    %% Styling
    style Indexer fill:#4a90e2,stroke:#333,color:#fff
    style IndexerSvc fill:#4a90e2,stroke:#333,color:#fff
    style MetricsSrv fill:#4a90e2,stroke:#333,color:#fff
    style PodRecon fill:#4a90e2,stroke:#333,color:#fff
    style SubMgr fill:#4a90e2,stroke:#333,color:#fff
    style TokenDB fill:#4a90e2,stroke:#333,color:#fff
    style FSBackend fill:#50c878,stroke:#333,color:#fff
    style UDSTokenizer fill:#50c878,stroke:#333,color:#fff
    style ScoreComp fill:#f5a623,stroke:#333
    style ScoreChat fill:#f5a623,stroke:#333
    style Metrics fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style vLLMPods fill:#e8e8e8,stroke:#333
    style vLLMRuntime fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
