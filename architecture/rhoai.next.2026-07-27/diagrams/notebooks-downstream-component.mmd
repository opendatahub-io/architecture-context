graph TB
    subgraph BuildProject["notebooks-downstream (Container Image Build Project)"]
        direction TB

        subgraph BuildTooling["Build Tooling"]
            BuildInputs["scripts/buildinputs/<br/>Go Module<br/>BuildKit + OCI image-spec"]
            CheckPayload["scripts/check-payload/<br/>Go Module<br/>openshift/check-payload"]
            CITest["ci/cached-builds/<br/>make_test.py<br/>CI Test Harness"]
        end

        subgraph JupyterImages["Jupyter Notebook Images"]
            JupyterMinimal["jupyter-minimal<br/>UBI9 + Python 3.11/3.12"]
            JupyterDS["jupyter-datascience<br/>UBI9 + Python 3.11/3.12"]
            JupyterPyTorch["jupyter-pytorch<br/>UBI9 + CUDA 12.6"]
            JupyterTF["jupyter-tensorflow<br/>UBI9 + Python 3.11"]
        end

        subgraph IDEImages["IDE Images"]
            CodeServer["code-server<br/>UBI9 + nginx proxy"]
            RStudio["rstudio<br/>UBI9"]
            RStudioCUDA["rstudio-cuda<br/>UBI9 + CUDA"]
        end

        subgraph RuntimeImages["ML Runtime Images"]
            RTDatascience["runtime-datascience<br/>Lightweight"]
            RTPyTorch["runtime-pytorch<br/>CUDA 12.6"]
            RTTF["runtime-tensorflow<br/>Python 3.11"]
            RTROCmPT["runtime-rocm-pytorch<br/>AMD ROCm"]
            RTROCmTF["runtime-rocm-tensorflow<br/>AMD ROCm"]
        end
    end

    subgraph GPUAcceleration["GPU Acceleration"]
        CUDA["NVIDIA CUDA 12.6<br/>torch==2.6.0+cu126"]
        ROCm["AMD ROCm<br/>tensorflow-rocm==2.14.0.600<br/>pytorch-triton-rocm==3.2.0"]
    end

    subgraph Consumer["Deployment Consumer"]
        NotebookController["RHOAI Notebook Controller"]
        StatefulSet["StatefulSet-backed<br/>Workbench Pods"]
    end

    BuildInputs -->|analyzes| JupyterImages
    BuildInputs -->|analyzes| IDEImages
    BuildInputs -->|analyzes| RuntimeImages
    CheckPayload -->|verifies| JupyterImages
    CheckPayload -->|verifies| IDEImages
    CheckPayload -->|verifies| RuntimeImages
    CITest -->|tests| JupyterImages
    CITest -->|tests| IDEImages
    CITest -->|tests| RuntimeImages

    JupyterPyTorch -->|uses| CUDA
    RStudioCUDA -->|uses| CUDA
    RTPyTorch -->|uses| CUDA
    RTROCmPT -->|uses| ROCm
    RTROCmTF -->|uses| ROCm

    NotebookController -->|deploys| StatefulSet
    JupyterImages -->|consumed by| NotebookController
    IDEImages -->|consumed by| NotebookController
    RuntimeImages -->|consumed by| NotebookController

    style BuildProject fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style BuildTooling fill:#fff3e0,stroke:#f5a623,stroke-width:1px
    style JupyterImages fill:#e8f5e9,stroke:#82b366,stroke-width:1px
    style IDEImages fill:#e8f5e9,stroke:#82b366,stroke-width:1px
    style RuntimeImages fill:#e8f5e9,stroke:#82b366,stroke-width:1px
    style GPUAcceleration fill:#fff9c4,stroke:#d6b656,stroke-width:1px
    style Consumer fill:#f3e5f5,stroke:#9c27b0,stroke-width:1px
    style NotebookController fill:#ce93d8
    style StatefulSet fill:#ce93d8
    style CUDA fill:#76ff03,stroke:#333
    style ROCm fill:#ff6d00,stroke:#333
