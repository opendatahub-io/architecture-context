graph LR
    KAP["kube-auth-proxy<br/>OAuth2/OIDC Reverse Proxy"]

    %% External Infrastructure Dependencies
    KAP -->|"TokenReview API<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>Server"]
    KAP -->|"OAuth2 flow<br/>HTTPS"| OAuthServer["OpenShift OAuth<br/>Server"]
    KAP -->|"OIDC auth<br/>HTTPS"| OIDCProvider["OIDC Provider"]
    KAP -->|"Session store<br/>TCP (optional TLS)"| Redis["Redis / Valkey<br/>(Standalone / Sentinel /<br/>Cluster)"]

    %% Upstream Service
    KAP -->|"Forward authenticated<br/>requests HTTP/8080"| Upstream["Upstream Service<br/>(configurable)"]

    %% Ingress
    Route["OpenShift Route<br/>TLS Edge"] -->|"HTTP/80 -> 4180"| KAP

    %% Key Go Module Dependencies
    subgraph "Core Libraries"
        direction TB
        OIDC["coreos/go-oidc/v3"]
        GoRedis["redis/go-redis/v9"]
        K8sClient["k8s.io/client-go"]
        OAuth2["golang.org/x/oauth2"]
        JWT["golang-jwt/jwt/v5"]
        Gorilla["gorilla/mux"]
        Prometheus["prometheus/client_golang"]
    end

    KAP -.->|"OIDC discovery"| OIDC
    KAP -.->|"Redis client"| GoRedis
    KAP -.->|"K8s API client"| K8sClient
    KAP -.->|"OAuth2 token mgmt"| OAuth2
    KAP -.->|"JWT handling"| JWT
    KAP -.->|"HTTP routing"| Gorilla
    KAP -.->|"Metrics"| Prometheus

    style KAP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OAuthServer fill:#999,stroke:#333,color:#fff
    style OIDCProvider fill:#999,stroke:#333,color:#fff
    style Redis fill:#999,stroke:#333,color:#fff
    style Upstream fill:#7ed321,stroke:#333,color:#fff
    style Route fill:#f5a623,stroke:#333,color:#fff
    style OIDC fill:#e8e8e8,stroke:#333
    style GoRedis fill:#e8e8e8,stroke:#333
    style K8sClient fill:#e8e8e8,stroke:#333
    style OAuth2 fill:#e8e8e8,stroke:#333
    style JWT fill:#e8e8e8,stroke:#333
    style Gorilla fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
