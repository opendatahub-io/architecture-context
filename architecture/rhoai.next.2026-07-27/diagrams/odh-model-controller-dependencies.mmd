graph LR
    ODH["odh-model-controller<br/><i>Kubernetes Operator</i>"]

    %% Core Platform Dependencies
    ODH -->|"watches CRDs<br/>HTTPS/6443"| KServe["KServe<br/><i>v0.17.0-rc1</i><br/>InferenceService, InferenceGraph,<br/>LLMInferenceService, ServingRuntime"]
    ODH -->|"manages routing<br/>HTTPS/6443"| GatewayAPI["Gateway API<br/><i>v1.4.2</i><br/>Gateways, HTTPRoutes"]
    ODH -->|"manages auth<br/>HTTPS/6443"| Kuadrant["Kuadrant<br/><i>v1.4.2</i><br/>AuthPolicies"]
    ODH -->|"manages filters<br/>HTTPS/6443"| Istio["Istio<br/><i>v1.27.8</i><br/>EnvoyFilters"]

    %% Monitoring & Observability
    ODH -->|"creates monitors<br/>HTTPS/6443"| Prometheus["Prometheus Operator<br/><i>v0.89.0</i><br/>ServiceMonitors, PodMonitors"]
    ODH -->|"exports traces<br/>OTLP/gRPC"| OTel["OpenTelemetry Collector<br/><i>v1.43.0 SDK</i>"]
    ODH -->|"creates triggers<br/>HTTPS/6443"| KEDA["KEDA<br/><i>v2.18.3</i><br/>TriggerAuthentications"]

    %% Platform CRDs
    ODH -->|"watches state<br/>HTTPS/6443"| DSC["DataScienceCluster CR<br/><i>opendatahub.io</i>"]
    ODH -->|"watches init<br/>HTTPS/6443"| DSCI["DSCInitialization CR<br/><i>opendatahub.io</i>"]

    %% OpenShift Dependencies
    ODH -->|"manages routes<br/>HTTPS/6443"| OpenShiftRoutes["OpenShift Routes<br/><i>route.openshift.io</i>"]
    ODH -->|"manages templates<br/>HTTPS/6443"| OpenShiftTemplates["OpenShift Templates<br/><i>template.openshift.io</i>"]
    ODH -->|"reads config<br/>HTTPS/6443"| OpenShiftAuth["OpenShift Authentication<br/><i>config.openshift.io</i>"]

    %% Infrastructure
    ODH -->|"CRUD + watches<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/><i>v0.35.1</i>"]
    ODH -->|"operator framework<br/>in-process"| CtrlRuntime["controller-runtime<br/><i>v0.22.5</i>"]

    %% Certificate Provisioning
    ServiceCA["OpenShift service-ca"] -.->|"provisions TLS certs"| ODH

    %% Conditional Dependencies
    ODH -.->|"conditional:<br/>NIM_STATE=managed"| NIM["NIM Account CR<br/><i>nim.opendatahub.io/v1</i>"]
    ODH -.->|"conditional:<br/>MODELREGISTRY_STATE"| ModelReg["Model Registry<br/><i>ModelRegistry reconciliation</i>"]

    %% Integration consumers
    Authorino["Authorino<br/><i>v0.22.0</i>"] -.->|"watched by<br/>LLMISvc controller"| ODH
    HWProfile["HardwareProfile CR<br/><i>infrastructure.opendatahub.io</i>"] -.->|"watched by<br/>controllers"| ODH

    %% Styling
    style ODH fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPI fill:#7ed321,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style KEDA fill:#999,stroke:#333,color:#fff
    style DSC fill:#7ed321,stroke:#333,color:#fff
    style DSCI fill:#7ed321,stroke:#333,color:#fff
    style OpenShiftRoutes fill:#e74c3c,stroke:#333,color:#fff
    style OpenShiftTemplates fill:#e74c3c,stroke:#333,color:#fff
    style OpenShiftAuth fill:#e74c3c,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style CtrlRuntime fill:#f5a623,stroke:#333
    style ServiceCA fill:#e74c3c,stroke:#333,color:#fff
    style NIM fill:#f5a623,stroke:#333,stroke-dasharray: 5 5
    style ModelReg fill:#f5a623,stroke:#333,stroke-dasharray: 5 5
    style Authorino fill:#999,stroke:#333,color:#fff,stroke-dasharray: 5 5
    style HWProfile fill:#7ed321,stroke:#333,color:#fff,stroke-dasharray: 5 5
