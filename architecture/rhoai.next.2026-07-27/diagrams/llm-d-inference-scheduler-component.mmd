graph TB
    subgraph EPP["Endpoint Picker (EPP) - Go gRPC Service"]
        direction TB
        ExtProc["ExternalProcessor<br/>gRPC Service<br/>Optional TLS"]
        HealthSvc["Health<br/>gRPC Service<br/>Optional TLS"]
        MetricsHTTP["/metrics<br/>HTTP Endpoint"]
        RootHTTP["/<br/>HTTP Endpoint"]

        subgraph Pipeline["Request Processing Pipeline"]
            direction LR
            Parser["Protocol Parsers<br/>OpenAI | Anthropic<br/>vLLM | Vertex AI<br/>Passthrough"]
            ReqCtrl["Request Control<br/>Data Producers<br/>Pre-Admission<br/>Admission"]
            Scheduler["Scheduling<br/>Filters | Scorers<br/>Pickers | Profiles"]
            FlowCtrl["Flow Control<br/>Priority Bands<br/>Fairness | Ordering"]
            Parser --> ReqCtrl --> Scheduler --> FlowCtrl
        end

        ExtProc --> Pipeline
    end

    subgraph Controllers["Kubernetes Controllers"]
        direction TB
        IMRCtrl["InferenceModelRewrite<br/>Controller"]
        IOCtrl["InferenceObjective<br/>Controller"]
        IPCtrl["InferencePool<br/>Controller"]
        PodCtrl["Pod<br/>Controller"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        direction TB
        EPCConfig["EndpointPickerConfig<br/>llm-d.ai/v1alpha1"]
        IMR["InferenceModelRewrite<br/>llm-d.ai/v1alpha2"]
        IO["InferenceObjective<br/>llm-d.ai/v1alpha2"]
        IP["InferencePool<br/>inference.networking.k8s.io/v1"]
    end

    Envoy["Envoy Proxy"] -->|gRPC ExtProc<br/>callout| ExtProc
    EPCConfig -->|configures| EPP

    IMR -->|watched by| IMRCtrl
    IO -->|watched by| IOCtrl
    IP -->|watched by| IPCtrl
    Pods["Pod Resources"] -->|watched by| PodCtrl

    Controllers -->|maintains| Datastore["Routing Datastore"]
    Pipeline -->|queries| Datastore
    FlowCtrl -->|routing decision| Envoy

    EPP -->|depends on| GatewayAPIExt["gateway-api-inference-extension<br/>(Go library)"]
    EPP -->|depends on| KVCache["llm-d-kv-cache<br/>(Go library)"]
    EPP -->|metrics scrape| ModelEndpoints["Model-Serving<br/>Endpoints"]
    EPP -->|traces| OTELCollector["OpenTelemetry<br/>Collector"]
    Controllers -->|REST/WSS 6443| K8sAPI["Kubernetes API"]

    style ExtProc fill:#4a90e2,stroke:#333,color:#fff
    style HealthSvc fill:#4a90e2,stroke:#333,color:#fff
    style MetricsHTTP fill:#4a90e2,stroke:#333,color:#fff
    style RootHTTP fill:#4a90e2,stroke:#333,color:#fff
    style IMRCtrl fill:#50c878,stroke:#333,color:#fff
    style IOCtrl fill:#50c878,stroke:#333,color:#fff
    style IPCtrl fill:#50c878,stroke:#333,color:#fff
    style PodCtrl fill:#50c878,stroke:#333,color:#fff
    style EPCConfig fill:#f5a623,stroke:#333,color:#fff
    style IMR fill:#f5a623,stroke:#333,color:#fff
    style IO fill:#f5a623,stroke:#333,color:#fff
    style IP fill:#f5a623,stroke:#333,color:#fff
    style Envoy fill:#e8e8e8,stroke:#333
    style GatewayAPIExt fill:#e8e8e8,stroke:#333
    style KVCache fill:#e8e8e8,stroke:#333
    style ModelEndpoints fill:#e8e8e8,stroke:#333
