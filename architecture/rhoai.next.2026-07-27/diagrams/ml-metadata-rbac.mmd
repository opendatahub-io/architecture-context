graph TD
    subgraph "Container Identity"
        Container["odh-mlmd-grpc-server<br/>UID: 65534 / GID: 65534<br/>(non-root)"]
    end

    subgraph "Security Model"
        direction TB
        Note1["No Kubernetes RBAC Roles<br/>(standalone gRPC server,<br/>not a K8s operator)"]
        Note2["No Application-Level AuthN/AuthZ<br/>(access control delegated<br/>to network policies)"]
    end

    subgraph "Transport Security (Optional)"
        direction TB
        Insecure["Insecure Mode<br/>(no TLS)"]
        TLS["TLS Mode<br/>--ssl_cert<br/>--ssl_key"]
        MTLS["mTLS Mode<br/>--ssl_cert<br/>--ssl_key<br/>--ssl_ca"]
    end

    subgraph "Recommended Network Controls"
        direction TB
        NP["NetworkPolicy<br/>Restrict ingress to<br/>authorized namespaces"]
        PeerAuth["PeerAuthentication<br/>(if Service Mesh enabled)"]
        AuthzPolicy["AuthorizationPolicy<br/>(if Service Mesh enabled)"]
    end

    Container -->|runs as| Note1
    Container -->|secured by| Note2
    Container -->|transport| Insecure
    Container -->|transport| TLS
    Container -->|transport| MTLS
    Note2 -->|should use| NP
    Note2 -->|should use| PeerAuth
    Note2 -->|should use| AuthzPolicy

    style Container fill:#4a90e2,stroke:#333,color:#fff
    style Note1 fill:#fff2cc,stroke:#d6b656
    style Note2 fill:#fff2cc,stroke:#d6b656
    style Insecure fill:#f8cecc,stroke:#b85450
    style TLS fill:#d5e8d4,stroke:#82b366
    style MTLS fill:#d5e8d4,stroke:#82b366
    style NP fill:#dae8fc,stroke:#6c8ebf
    style PeerAuth fill:#dae8fc,stroke:#6c8ebf
    style AuthzPolicy fill:#dae8fc,stroke:#6c8ebf
