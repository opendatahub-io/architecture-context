graph TB
    subgraph LibraryBoundary["LIBRARY BOUNDARY (ai4rag Python Package)"]
        direction TB

        subgraph Pipeline["Processing Pipeline"]
            direction TB
            S3Downloader["S3 Downloader<br/>ThreadPoolExecutor (8 threads)<br/>Path-traversal validation"]
            DoclingExtractor["Docling Text Extractor<br/>multiprocess pool (8 workers)<br/>PDF, DOCX, PPTX, HTML, MD, TXT"]
            TextSplitter["LangChain Text Splitter<br/>Deterministic SHA-256 chunk IDs"]
            VectorStorage["Vector Storage<br/>OGX + Chroma backends"]
            Optimizer["RAG Optimizer<br/>scikit-learn + pyGAM"]

            S3Downloader --> DoclingExtractor
            DoclingExtractor --> TextSplitter
            TextSplitter --> VectorStorage
            VectorStorage --> Optimizer
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Outbound Only)"]
        S3["AWS S3-Compatible Storage<br/>Port: 443/TCP (typical)<br/>HTTPS / TLS<br/>Auth: AWS IAM Credentials"]
        OGX["OGX Service<br/>Protocol: API Client<br/>Details: Not fully characterized"]
        Chroma["Chroma Vector Store<br/>Protocol: API Client<br/>Details: Not fully characterized"]
    end

    subgraph Credentials["CREDENTIALS"]
        AWSCreds["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>AWS_SESSION_TOKEN (optional)<br/>Source: params or env vars"]
        DoclingPath["DOCLING_ARTIFACTS_PATH<br/>Source: env var"]
    end

    %% No inbound connections
    NoIngress["No Inbound Service Surfaces<br/>(Library — not a deployed service)"]

    %% Outbound flows
    S3Downloader -->|"HTTPS/443<br/>TLS<br/>AWS IAM Auth<br/>⚠️ SSL retry: verify=False"| S3
    VectorStorage -->|"API calls<br/>ogx-client"| OGX
    VectorStorage -->|"API calls<br/>langchain-chroma"| Chroma

    %% Credential flows
    AWSCreds -.->|"runtime config"| S3Downloader
    DoclingPath -.->|"runtime config"| DoclingExtractor

    %% Styling
    classDef library fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef credential fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef warning fill:#f9f9f9,stroke:#999,stroke-width:2px,stroke-dasharray: 5 5

    class S3Downloader,DoclingExtractor,TextSplitter,VectorStorage,Optimizer library
    class S3,OGX,Chroma external
    class AWSCreds,DoclingPath credential
    class NoIngress warning
