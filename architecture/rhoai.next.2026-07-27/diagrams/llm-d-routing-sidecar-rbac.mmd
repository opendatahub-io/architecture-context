graph TD
    subgraph "Subject"
        Group["Group<br/>system:authenticated<br/>(all authenticated users)"]
    end

    subgraph "Role Binding"
        RB["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}<br/>Type: RoleBinding"]
    end

    subgraph "Role"
        Role["${PROJECT_NAME}-exec-role<br/>Type: Role (namespace-scoped)"]
    end

    subgraph "API Resources"
        PodsExec["Core API Group<br/>pods/exec"]
    end

    subgraph "Effective Access"
        Access["Any authenticated user can<br/>kubectl exec into<br/>${PROJECT_NAME}-0 pod"]
    end

    Group -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -->|"create"| PodsExec
    PodsExec -->|"enables"| Access

    style Group fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#b8d4e3,stroke:#333
    style Role fill:#f5a623,stroke:#333,color:#fff
    style PodsExec fill:#7ed321,stroke:#333
    style Access fill:#f8cecc,stroke:#b85450

    %% Security Note
    Note["Security Note:<br/>system:authenticated is a broad group.<br/>Any authenticated user can exec into the pod.<br/>Consider restricting to specific ServiceAccounts."]
    style Note fill:#fff2cc,stroke:#d6b656
