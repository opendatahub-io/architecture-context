graph LR
    Kubeflow["Kubeflow Notebook Controller"]

    %% External Dependencies
    Kubeflow -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    Kubeflow -->|"Go runtime"| GoRuntime["Go 1.26.5"]
    Kubeflow -->|"testing"| Ginkgo["ginkgo/gomega"]
    Kubeflow -->|"metrics"| Prometheus["prometheus/client_golang"]
    Kubeflow -->|"tracing"| OTel["OpenTelemetry 1.44.0"]
    Kubeflow -->|"logging"| Zap["go.uber.org/zap"]

    %% Kubernetes API Dependencies
    Kubeflow -->|"REST + WebSocket<br/>6443/TCP TLS 1.2+"| K8sAPI["Kubernetes API"]

    %% Internal ODH Dependencies
    Kubeflow -->|"Go library import"| DSPOperator["data-science-pipelines-operator"]
    Kubeflow -->|"chaos testing"| OperatorChaos["operator-chaos"]

    %% Platform Dependencies
    Kubeflow -->|"CRD CRUD +<br/>HTTPRoute CRUD"| GatewayAPI["Gateway API 1.2.1"]
    Kubeflow -->|"CRD CRUD"| KubeflowNotebooks["Kubeflow Notebooks<br/>(kubeflow.org CRD)"]
    Kubeflow -->|"VirtualService CRUD"| Istio["Istio<br/>(networking.istio.io)"]

    %% OpenShift Dependencies
    Kubeflow -->|"REST read"| ImageStreams["OpenShift Image Streams"]
    Kubeflow -->|"CRD watch"| Routes["OpenShift Routes"]
    Kubeflow -->|"CRUD"| OAuthClients["OpenShift OAuthClients"]
    Kubeflow -->|"read"| OSConfig["OpenShift Config API<br/>(apiservers, proxies)"]

    %% OpenShift Libraries
    Kubeflow -->|"Go types"| OSApi["openshift/api"]
    Kubeflow -->|"controller utils"| OSControllerCommon["openshift/controller-runtime-common"]

    %% Integration Points (consumers)
    Dashboard["ODH Dashboard"] -.->|"Notebook mgmt UI"| Kubeflow
    DSPApps["DataSciencePipelinesApplications"] -.->|"reads DSPA resources"| Kubeflow

