graph TD
    subgraph "odh-gitops RBAC Model"
        direction TB

        Note["Note: odh-gitops is a configuration-only repository.<br/>It does not define explicit RBAC roles itself.<br/>RBAC is delegated to the operators and<br/>subscriptions it deploys."]
    end

    subgraph "Post-Install Hook Requirements"
        direction TB
        HookSA["Post-Install Hook<br/>Service Account<br/>(Job-based execution)"]
    end

    subgraph "Required Cluster Permissions (Hooks)"
        direction TB
        GatewayPerms["Gateway Resources<br/>istio/gateway-api"]
        HTTPRoutePerms["HTTPRoute Resources<br/>gateway.networking.k8s.io"]
        ConfigMapPerms["ConfigMap Resources<br/>core/v1"]
        PatchPerms["Deployment Patch<br/>apps/v1"]
    end

    subgraph "Delegated RBAC (Deployed Operators)"
        direction TB

        subgraph OLMOperators["OLM-Managed Operators (OpenShift)"]
            RHOAIOp["RHOAI Operator<br/>(ClusterRole)"]
            CertMgrOp["cert-manager Operator<br/>(ClusterRole)"]
            IstioOp["Service Mesh Operator<br/>(ClusterRole)"]
            AuthorinoOp["Authorino Operator<br/>(ClusterRole)"]
        end

        subgraph XKSOperators["Bundled Operators (xKS)"]
            CloudMgrOp["CloudManager Operator<br/>(ClusterRole)"]
            SailOp["sail-operator<br/>(ClusterRole)"]
        end
    end

    subgraph "Managed Resources"
        DSC["DataScienceCluster CR"]
        DSCInit["DSCInitialization CR"]
        InferGW["inference-gateway"]
        MaaSGW["maas-default-gateway"]
        Certs["Certificate CRs"]
        Subs["OLM Subscriptions"]
    end

    %% Hook permissions
    HookSA -->|"create, update"| GatewayPerms
    HookSA -->|"create, update"| HTTPRoutePerms
    HookSA -->|"create, get"| ConfigMapPerms
    HookSA -->|"patch (Authorino)"| PatchPerms

    %% Operator RBAC delegation
    RHOAIOp -->|"reconciles"| DSC
    RHOAIOp -->|"reconciles"| DSCInit
    CertMgrOp -->|"manages"| Certs
    IstioOp -->|"manages"| InferGW
    IstioOp -->|"manages"| MaaSGW
    AuthorinoOp -->|"enforces auth"| MaaSGW

    CloudMgrOp -->|"manages"| InferGW
    CloudMgrOp -->|"manages"| MaaSGW
    SailOp -->|"manages"| InferGW

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style HookSA fill:#4a90e2,stroke:#333,color:#fff
    style GatewayPerms fill:#f5a623,stroke:#333
    style HTTPRoutePerms fill:#f5a623,stroke:#333
    style ConfigMapPerms fill:#f5a623,stroke:#333
    style PatchPerms fill:#f5a623,stroke:#333
    style RHOAIOp fill:#7ed321,stroke:#333,color:#fff
    style CertMgrOp fill:#7ed321,stroke:#333,color:#fff
    style IstioOp fill:#7ed321,stroke:#333,color:#fff
    style AuthorinoOp fill:#7ed321,stroke:#333,color:#fff
    style CloudMgrOp fill:#7ed321,stroke:#333,color:#fff
    style SailOp fill:#7ed321,stroke:#333,color:#fff
    style DSC fill:#e8e8e8,stroke:#333
    style DSCInit fill:#e8e8e8,stroke:#333
    style InferGW fill:#e8e8e8,stroke:#333
    style MaaSGW fill:#e8e8e8,stroke:#333
    style Certs fill:#e8e8e8,stroke:#333
    style Subs fill:#e8e8e8,stroke:#333
