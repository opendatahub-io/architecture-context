graph TB
    subgraph FeastOperator["Feast Operator"]
        Controller["feast-operator-controller-manager<br/>(Deployment: manager)"]
        ManagerBin["manager<br/>(Go executable)"]
        Controller --- ManagerBin
    end

    subgraph FeastRuntime["Feast Runtime (Dual-Runtime)"]
        GoServer["Go Feature Server<br/>(HTTP :8080 + gRPC)"]
        PythonAPI["Python FastAPI Service<br/>(REST :6566)"]
        CGoBridge["CGo / Arrow C Data Interface<br/>(zero-copy transfer)"]
        PythonAPI -->|embeds via CGo| CGoBridge
        CGoBridge -->|calls| GoServer
    end

    subgraph CRDs["Custom Resources"]
        FeatureStoreCR["FeatureStore CR<br/>(feast.dev/v1, v1alpha1)"]
    end

    subgraph OnlineStores["Online Store Backends"]
        PostgreSQL["PostgreSQL<br/>(pgx/v5, sslmode=require)"]
        Redis["Redis / Valkey<br/>(go-redis/v9, optional TLS)"]
        MySQL["MySQL"]
        SQLite["SQLite"]
        DynamoDB["DynamoDB<br/>(aws-sdk-go-v2)"]
    end

    subgraph RegistryStores["Registry Store Backends"]
        GCS["Google Cloud Storage"]
        S3["S3-compatible Storage"]
        LocalFile["Local File Registry"]
    end

    subgraph K8sResources["Managed Kubernetes Resources"]
        Deployments["Deployments"]
        Services["Services"]
        ConfigMaps["ConfigMaps"]
        CronJobs["CronJobs"]
        HPAs["HorizontalPodAutoscalers"]
        PDBs["PodDisruptionBudgets"]
        RBAC["Roles / RoleBindings"]
        Routes["OpenShift Routes"]
        ServiceMonitors["ServiceMonitors"]
    end

    User["Data Scientist / User"] -->|creates| FeatureStoreCR
    FeatureStoreCR -->|watched by| Controller
    Controller -->|reconciles| Deployments
    Controller -->|reconciles| Services
    Controller -->|reconciles| ConfigMaps
    Controller -->|reconciles| CronJobs
    Controller -->|reconciles| HPAs
    Controller -->|reconciles| PDBs
    Controller -->|reconciles| RBAC
    Controller -->|reconciles| Routes
    Controller -->|reconciles| ServiceMonitors

    Client["API Client"] -->|POST /get-online-features| GoServer
    Client -->|REST API :6566| PythonAPI

    GoServer -->|reads features| PostgreSQL
    GoServer -->|reads features| Redis
    GoServer -->|reads features| MySQL
    GoServer -->|reads features| SQLite
    GoServer -->|reads features| DynamoDB

    GoServer -->|loads registry| GCS
    GoServer -->|loads registry| S3
    GoServer -->|loads registry| LocalFile

    Controller -->|watches| KubeflowNotebooks["Kubeflow Notebooks"]
    Controller -->|manages| PrometheusOp["prometheus-operator"]

    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px
    style ManagerBin fill:#4a90e2,stroke:#333
    style GoServer fill:#50c878,stroke:#333,stroke-width:2px
    style PythonAPI fill:#50c878,stroke:#333,stroke-width:2px
    style CGoBridge fill:#87ceeb,stroke:#333
    style FeatureStoreCR fill:#f5a623,stroke:#333,stroke-width:2px
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#333
    style DynamoDB fill:#e8e8e8,stroke:#333
    style GCS fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style LocalFile fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#999
    style Client fill:#f9f9f9,stroke:#999
    style KubeflowNotebooks fill:#7ed321,stroke:#333
    style PrometheusOp fill:#7ed321,stroke:#333
