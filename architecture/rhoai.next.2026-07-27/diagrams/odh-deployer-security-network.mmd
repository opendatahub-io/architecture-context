graph TB
    subgraph Admin["CLUSTER ADMIN (Trusted)"]
        ClusterAdmin["Cluster Administrator<br/>cluster-admin privileges"]
    end

    subgraph Orchestrator["DEPLOYMENT ORCHESTRATOR (One-Shot)"]
        DeployScript["deploy.sh<br/>Bash Script<br/>Inherits oc session credentials"]
    end

    subgraph K8sAPI["KUBERNETES API"]
        APIServer["OpenShift API Server<br/>6443/TCP<br/>TLS"]
    end

    subgraph Monitoring["MONITORING (redhat-ods-monitoring)"]
        direction TB
        Prometheus["Prometheus<br/>Init: health-check x 230<br/>Scrapes /metrics"]
        Alertmanager["Alertmanager<br/>Alert routing"]
        OAuthProxy["OAuth Proxy<br/>Sidecars"]
    end

    subgraph Applications["RHOAI SERVICES (redhat-ods-applications)"]
        direction TB
        Dashboard["Dashboard<br/>8443/TCP HTTPS"]
        NBC["notebook-controller<br/>8080/TCP HTTP"]
        ModelCtrl["model-controller<br/>8080/TCP HTTP"]
        ModelMesh["modelmesh<br/>8080/TCP HTTP"]
        DSPO["dspo<br/>8080/TCP HTTP"]
    end

    subgraph ExternalAlerts["EXTERNAL ALERTING (OSD Only)"]
        PagerDuty["PagerDuty<br/>HTTPS/443<br/>Service Key Auth"]
        DMS["Dead Man's Snitch<br/>HTTPS/443<br/>URL Key Auth"]
        SMTPServer["SMTP Server<br/>TLS<br/>SMTP Credentials"]
    end

    subgraph KfDefLayer["KFDEF ORCHESTRATION"]
        KfOp["KubeFlow Operator<br/>Reconciles KfDef CRs"]
    end

    %% Admin to deploy script
    ClusterAdmin -->|"Executes"| DeployScript

    %% Deploy script to API
    DeployScript -->|"HTTPS/6443<br/>TLS<br/>Bearer Token"| APIServer

    %% API to KfDef operator
    APIServer -->|"KfDef events"| KfOp
    KfOp -->|"Creates workloads"| Applications

    %% Prometheus scraping
    Prometheus -->|"HTTPS/8443<br/>/metrics"| Dashboard
    Prometheus -->|"HTTP/8080<br/>/metrics"| NBC
    Prometheus -->|"HTTP/8080<br/>/metrics"| ModelCtrl
    Prometheus -->|"HTTP/8080<br/>/metrics"| ModelMesh
    Prometheus -->|"HTTP/8080<br/>/metrics"| DSPO

    %% Alertmanager to external
    Alertmanager -->|"HTTPS/443<br/>TLS<br/>PagerDuty Key"| PagerDuty
    Alertmanager -->|"HTTPS/443<br/>TLS<br/>DMS Key"| DMS
    Alertmanager -->|"TLS<br/>SMTP Auth"| SMTPServer

    %% Styling
    classDef admin fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef orchestrator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef apiserver fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef monitoring fill:#e6522c,stroke:#333,stroke-width:2px,color:#fff
    classDef services fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef kfdef fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class ClusterAdmin admin
    class DeployScript orchestrator
    class APIServer apiserver
    class Prometheus,Alertmanager,OAuthProxy monitoring
    class Dashboard,NBC,ModelCtrl,ModelMesh,DSPO services
    class PagerDuty,DMS,SMTPServer external
    class KfOp kfdef
