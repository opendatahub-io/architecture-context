graph TB
    subgraph "Batch Gateway System"
        subgraph "API Server Binary"
            APIServer["batch-gateway-apiserver<br/>(Go HTTP Service)"]
            RouteMiddleware["Route Middleware Chain"]
            NotFoundHandler["404 Handler"]
            APIServer -->|configures| RouteMiddleware
            APIServer -->|registers| NotFoundHandler
        end

        subgraph "Processor Binary"
            Processor["batch-gateway-processor<br/>(Go Background Worker)"]
            AsyncDispatch["Async Dispatch<br/>(llm-d-async/Redis)"]
            GlobalDispatch["Global Dispatch<br/>(Single HTTP Gateway)"]
            PerModelDispatch["Per-Model Dispatch<br/>(Dedicated Endpoints)"]
            Processor -->|mode 1| AsyncDispatch
            Processor -->|mode 2| GlobalDispatch
            Processor -->|mode 3| PerModelDispatch
        end

        subgraph "GC Binary"
            GC["batch-gateway-gc<br/>(Go Background Worker)"]
            Reconciler["Orphan Reconciler<br/>(Optional)"]
            GC -->|optional| Reconciler
        end

        subgraph "Observability"
            MetricsServer["Metrics Server<br/>/metrics, /health, /ready"]
        end
    end

    Client[External Client] -->|batch inference request| APIServer
    EnvoyProxy["Envoy ext_authz Sidecar<br/>(Identity Injection)"] -->|auth headers| APIServer

    APIServer -->|stores job state| PostgreSQL[(PostgreSQL)]
    APIServer -->|uploads input files| S3[(S3-Compatible Storage)]
    APIServer -->|enqueues jobs| Redis[(Redis/Valkey)]

    Processor -->|dequeues jobs| Redis
    Processor -->|updates state| PostgreSQL
    Processor -->|dispatches inference| LLMd["llm-d Inference Gateway"]
    Processor -->|stores results| S3

    GC -->|scans expired jobs| PostgreSQL
    GC -->|removes files| S3
    Reconciler -->|detects orphans| Redis

    MetricsServer -->|exports traces| OTel["OpenTelemetry Collector"]

    style APIServer fill:#4a90e2,color:#fff
    style Processor fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style EnvoyProxy fill:#f5a623,color:#fff
    style PostgreSQL fill:#336791,color:#fff
    style Redis fill:#dc382d,color:#fff
    style S3 fill:#569a31,color:#fff
    style LLMd fill:#7ed321
    style OTel fill:#7ed321
    style Client fill:#e8e8e8
