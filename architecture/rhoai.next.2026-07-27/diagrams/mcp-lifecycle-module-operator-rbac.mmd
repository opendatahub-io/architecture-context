graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA1["mcp-lifecycle-module-operator<br/>-controller-manager"]
        SA2["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["mcp-lifecycle-module-operator-<br/>mcp-lifecycle-module-operator-<br/>manager-rolebinding<br/>(ns: system)"]
        CRB2["mcp-lifecycle-module-operator-<br/>manager-rolebinding<br/>(ns: system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["mcp-lifecycle-module-operator<br/>-manager-role"]
        CR2["manager-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["(core)<br/>configmaps"]
        Namespaces["(core)<br/>namespaces"]
        ServiceAccts["(core)<br/>serviceaccounts"]
        Services["(core)<br/>services"]
        Pods["(core)<br/>pods"]
        Secrets["(core)<br/>secrets"]
    end

    subgraph PlatformResources["Platform API Resources"]
        MCPLifecycleOps["components.platform.opendatahub.io<br/>mcplifecycleoperators<br/>+ /finalizers, /status"]
        MCPServers["mcp.x-k8s.io<br/>mcpservers<br/>+ /finalizers, /status"]
    end

    subgraph InfraResources["Infrastructure API Resources"]
        Deployments["apps<br/>deployments"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
        NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    subgraph RBACResources["RBAC API Resources"]
        ClusterRolesRes["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings"]
        RolesRes["rbac.authorization.k8s.io<br/>roles, rolebindings"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        Events["events.k8s.io<br/>events"]
        APIServers["config.openshift.io<br/>apiservers"]
    end

    %% Bindings
    SA1 -->|bound via| CRB1
    SA2 -->|bound via| CRB2
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2

    %% Core permissions
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| ConfigMaps
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| Namespaces
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| ServiceAccts
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| Services
    CR1 -->|"get,list"| Pods
    CR1 -->|"get,list,watch"| Secrets

    %% Platform permissions
    CR1 -->|"full CRUD + finalizers"| MCPLifecycleOps
    CR1 -->|"full CRUD + deletecollection<br/>+ finalizers"| MCPServers

    %% Infra permissions
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| Deployments
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| CRDs
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| ServiceMonitors
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| NetworkPolicies
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| Leases

    %% RBAC permissions
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| ClusterRolesRes
    CR1 -->|"create,delete,get,list,<br/>patch,update,watch"| RolesRes

    %% Auth permissions
    CR1 -->|"create"| TokenReviews
    CR1 -->|"create"| SAR
    CR1 -->|"create,patch"| Events
    CR1 -->|"get,list,watch"| APIServers

    %% Styling
    style SA1 fill:#4a90e2,stroke:#333,color:#fff
    style SA2 fill:#4a90e2,stroke:#333,color:#fff
    style CR1 fill:#f5a623,stroke:#333,color:#fff
    style CR2 fill:#f5a623,stroke:#333,color:#fff
    style MCPLifecycleOps fill:#7ed321,stroke:#333,color:#fff
    style MCPServers fill:#7ed321,stroke:#333,color:#fff
