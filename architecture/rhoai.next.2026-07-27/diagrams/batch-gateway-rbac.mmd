graph TD
    subgraph "Batch Gateway RBAC"
        Note["No RBAC resources defined<br/>in analyzed manifests"]
    end

    subgraph "Runtime Security Context"
        direction TB
        APIServer["batch-gateway-apiserver<br/>UID: 65532 (non-root)<br/>Distroless base"]
        Processor["batch-gateway-processor<br/>UID: 65532 (non-root)<br/>Distroless base"]
        GC["batch-gateway-gc<br/>UID: 65532 (non-root)<br/>Distroless base"]
    end

    subgraph "Authentication Architecture"
        direction TB
        ExtAuth["Envoy ext_authz Sidecar<br/>(External Authentication)"]
        Headers["Identity Headers<br/>TenantID, RequestID"]
        ExtAuth -->|injects| Headers
        Headers -->|trusted by| APIServer
    end

    subgraph "Endpoint Security Matrix"
        direction TB
        BusinessRoutes["Business Routes<br/>POST, GET, DELETE<br/>Auth: None (delegated to ext_authz)"]
        ObsRoutes["Observability Routes<br/>/health, /ready, /metrics<br/>Auth: None"]
        DebugRoutes["Debug Routes<br/>/debug/pprof/*<br/>Auth: None"]
    end

    APIServer --- BusinessRoutes
    APIServer --- ObsRoutes
    APIServer --- DebugRoutes
    Processor --- ObsRoutes
    GC --- ObsRoutes

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style APIServer fill:#4a90e2,color:#fff
    style Processor fill:#4a90e2,color:#fff
    style GC fill:#4a90e2,color:#fff
    style ExtAuth fill:#f5a623,color:#fff
    style Headers fill:#ffe6cc,stroke:#d79b00
    style BusinessRoutes fill:#dae8fc,stroke:#6c8ebf
    style ObsRoutes fill:#d5e8d4,stroke:#82b366
    style DebugRoutes fill:#f8cecc,stroke:#b85450
