graph TB
    subgraph "Kubeflow Trainer Operator"
        ControllerMgr["kubeflow-trainer-controller-manager<br/>(Deployment)"]

        subgraph "Runtime Plugins"
            JobSetPlugin[JobSet Plugin]
            MPIPlugin[MPI Plugin]
            CoSchedPlugin[CoScheduling Plugin]
            VolcanoPlugin[Volcano Plugin]
        end

        subgraph "Webhooks (TLS :9443)"
            WHTrainJob["Validating Webhook<br/>TrainJob"]
            WHTrainingRuntime["Validating Webhook<br/>TrainingRuntime"]
            WHClusterTrainingRuntime["Validating Webhook<br/>ClusterTrainingRuntime"]
        end

        subgraph "Health & Metrics"
            Health["/healthz :8081"]
            Ready["/readyz :8081"]
            Metrics["Metrics :8080"]
        end

        ControllerMgr --> JobSetPlugin
        ControllerMgr --> MPIPlugin
        ControllerMgr --> CoSchedPlugin
        ControllerMgr --> VolcanoPlugin
        ControllerMgr --> WHTrainJob
        ControllerMgr --> WHTrainingRuntime
        ControllerMgr --> WHClusterTrainingRuntime
    end

    %% CRDs
    User[Data Scientist] -->|creates| TrainJobCR[TrainJob CR]
    User -->|creates| TrainingRuntimeCR[TrainingRuntime CR]
    Admin[Platform Admin] -->|creates| ClusterTrainingRuntimeCR[ClusterTrainingRuntime CR]
    Admin -->|creates| ConfigurationCR[Configuration CR]

    TrainJobCR -->|watched by| ControllerMgr
    TrainingRuntimeCR -->|resolved by| ControllerMgr
    ClusterTrainingRuntimeCR -->|resolved by| ControllerMgr
    ConfigurationCR -->|configures| ControllerMgr

    %% Downstream resources
    JobSetPlugin -->|creates| JobSet[JobSet]
    CoSchedPlugin -->|creates| PodGroupSP["PodGroup<br/>(scheduler-plugins)"]
    VolcanoPlugin -->|creates| PodGroupVolc["PodGroup<br/>(Volcano)"]
    MPIPlugin -->|manages| ConfigMaps[ConfigMaps]
    MPIPlugin -->|manages| Secrets[Secrets]

    %% External dependencies
    ControllerMgr -->|resolves TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]
    ControllerMgr -->|cert management| OPACert["OPA cert-controller"]
    ControllerMgr -->|HTTPS/6443| K8sAPI[Kubernetes API]

    %% Styling
    style ControllerMgr fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style TrainJobCR fill:#f5a623,stroke:#333,color:#fff
    style TrainingRuntimeCR fill:#f5a623,stroke:#333,color:#fff
    style ClusterTrainingRuntimeCR fill:#f5a623,stroke:#333,color:#fff
    style ConfigurationCR fill:#f5a623,stroke:#333,color:#fff
    style JobSet fill:#7ed321,stroke:#333
    style PodGroupSP fill:#7ed321,stroke:#333
    style PodGroupVolc fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style OPACert fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style WHTrainJob fill:#d0e0f0,stroke:#333
    style WHTrainingRuntime fill:#d0e0f0,stroke:#333
    style WHClusterTrainingRuntime fill:#d0e0f0,stroke:#333
