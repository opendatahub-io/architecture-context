graph TD
    subgraph "training_hub RBAC / Security Context"
        direction TB

        Note["training_hub is a Python library.<br/>No Kubernetes RBAC resources defined.<br/>No ClusterRoles, RoleBindings, or ServiceAccounts."]

        subgraph "Runtime Identity"
            CallerID["Runs under calling process identity<br/>(Pod ServiceAccount / User context)"]
        end

        subgraph "Credential References (User-Provisioned)"
            direction LR
            OPENAI_KEY["OPENAI_API_KEY<br/>(env var)<br/>LLM API auth"]
            OPENAI_BASE["OPENAI_API_BASE<br/>(env var)<br/>LLM endpoint URL"]
            MLFLOW_URI["MLFLOW_TRACKING_URI<br/>(env var)<br/>MLflow server"]
            WANDB_KEY["WANDB_API_KEY<br/>(env var)<br/>W&B auth"]
            WANDB_ENTITY_VAR["WANDB_ENTITY<br/>(env var)<br/>W&B org"]
        end

        subgraph "Credential Lifecycle"
            Provision["User provisions env vars<br/>at runtime"]
            GEPA_Save["GEPA backend: save/restore<br/>env var semantics"]
            NoRotate["No auto-rotation<br/>No cert-manager integration"]
        end

        subgraph "Egress Targets"
            LLM["LLM API<br/>(OPENAI_API_BASE)"]
            MLflow["MLflow Server<br/>(MLFLOW_TRACKING_URI)"]
            WandB["W&B API<br/>(api.wandb.ai)"]
        end
    end

    CallerID -->|"inherits permissions of"| Note

    Provision --> OPENAI_KEY
    Provision --> OPENAI_BASE
    Provision --> MLFLOW_URI
    Provision --> WANDB_KEY
    Provision --> WANDB_ENTITY_VAR

    OPENAI_KEY -->|"authenticates to"| LLM
    OPENAI_BASE -->|"resolves endpoint"| LLM
    MLFLOW_URI -->|"connects to"| MLflow
    WANDB_KEY -->|"authenticates to"| WandB
    WANDB_ENTITY_VAR -->|"identifies org in"| WandB

    GEPA_Save -.->|"manages lifecycle of"| OPENAI_KEY
    GEPA_Save -.->|"manages lifecycle of"| OPENAI_BASE

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style CallerID fill:#4a90e2,color:#fff
    style OPENAI_KEY fill:#f5a623,color:#fff
    style OPENAI_BASE fill:#f5a623,color:#fff
    style MLFLOW_URI fill:#f5a623,color:#fff
    style WANDB_KEY fill:#f5a623,color:#fff
    style WANDB_ENTITY_VAR fill:#f5a623,color:#fff
    style Provision fill:#7ed321,color:#fff
    style GEPA_Save fill:#7ed321,color:#fff
    style NoRotate fill:#e8e8e8
    style LLM fill:#e74c3c,color:#fff
    style MLflow fill:#e74c3c,color:#fff
    style WandB fill:#e74c3c,color:#fff
