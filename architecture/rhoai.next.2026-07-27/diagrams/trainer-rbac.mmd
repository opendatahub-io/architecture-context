graph TD
    subgraph "Service Accounts"
        SA["kubeflow-trainer-controller-manager<br/>(ServiceAccount)"]
    end

    subgraph "ClusterRoleBindings"
        CRB["kubeflow-trainer-controller-manager<br/>(ClusterRoleBinding, Cluster-scoped)"]
    end

    subgraph "Controller ClusterRole"
        CR["kubeflow-trainer-controller-manager<br/>(ClusterRole)"]
    end

    subgraph "User-Facing ClusterRoles (Aggregated)"
        TrainingAdmin["training-admin<br/>(aggregates to admin)"]
        TrainingEdit["training-edit<br/>(aggregates to edit)"]
        TrainingView["training-view<br/>(aggregates to view)"]
    end

    subgraph "trainer.kubeflow.org Resources"
        TrainJobs["TrainJobs"]
        TrainingRuntimes["TrainingRuntimes"]
        ClusterTrainingRuntimes["ClusterTrainingRuntimes"]
        TrainJobStatus["TrainJobs/status"]
        RuntimeStatuses["*Runtimes/status<br/>*Runtimes/finalizers<br/>TrainJobs/finalizers"]
    end

    subgraph "jobset.x-k8s.io Resources"
        JobSets["JobSets"]
    end

    subgraph "Scheduling Resources"
        PodGroupsSP["PodGroups<br/>(scheduling.x-k8s.io)"]
        PodGroupsVolc["PodGroups<br/>(scheduling.volcano.sh)"]
    end

    subgraph "Core Resources"
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
        Events["Events"]
        Pods["Pods"]
        LimitRanges["LimitRanges"]
    end

    subgraph "Other Resources"
        NetworkPolicies["NetworkPolicies<br/>(networking.k8s.io)"]
        Leases["Leases<br/>(coordination.k8s.io)"]
        WebhookConfigs["ValidatingWebhookConfigurations<br/>(admissionregistration.k8s.io)"]
        APIServers["APIServers<br/>(config.openshift.io)"]
        RuntimeClasses["RuntimeClasses<br/>(node.k8s.io)"]
    end

    %% Controller bindings
    SA -->|bound via| CRB
    CRB -->|grants| CR

    %% Controller permissions
    CR -->|"get, list, watch, patch, update"| TrainJobs
    CR -->|"get, list, watch, patch, update"| TrainingRuntimes
    CR -->|"get, list, watch, patch, update"| ClusterTrainingRuntimes
    CR -->|"get, patch, update"| RuntimeStatuses
    CR -->|"create, get, list, patch, update, watch"| JobSets
    CR -->|"create, get, list, patch, update, watch"| PodGroupsSP
    CR -->|"create, get, list, patch, update, watch"| PodGroupsVolc
    CR -->|"create, get, list, patch, update, watch"| ConfigMaps
    CR -->|"create, get, list, patch, update, watch"| Secrets
    CR -->|"create, patch, update, watch"| Events
    CR -->|"get, list"| Pods
    CR -->|"get, list, watch"| LimitRanges
    CR -->|"create, get, list, patch, update, watch"| NetworkPolicies
    CR -->|"create, get, list, update"| Leases
    CR -->|"get, list, update, watch"| WebhookConfigs
    CR -->|"get"| APIServers
    CR -->|"get, list, watch"| RuntimeClasses

    %% User-facing role permissions
    TrainingAdmin -->|"full CRUD"| TrainJobs
    TrainingAdmin -->|"full CRUD"| TrainingRuntimes
    TrainingAdmin -->|"full CRUD"| ClusterTrainingRuntimes
    TrainingAdmin -->|"get"| TrainJobStatus

    TrainingEdit -->|"full CRUD"| TrainJobs
    TrainingEdit -->|"get, list, watch"| TrainingRuntimes
    TrainingEdit -->|"get, list, watch"| ClusterTrainingRuntimes
    TrainingEdit -->|"get"| TrainJobStatus

    TrainingView -->|"get, list, watch"| TrainJobs
    TrainingView -->|"get, list, watch"| TrainingRuntimes
    TrainingView -->|"get, list, watch"| ClusterTrainingRuntimes
    TrainingView -->|"get"| TrainJobStatus

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style CRB fill:#d0e0f0,stroke:#333
    style TrainingAdmin fill:#e74c3c,stroke:#333,color:#fff
    style TrainingEdit fill:#f39c12,stroke:#333,color:#fff
    style TrainingView fill:#27ae60,stroke:#333,color:#fff
    style TrainJobs fill:#7ed321,stroke:#333
    style TrainingRuntimes fill:#7ed321,stroke:#333
    style ClusterTrainingRuntimes fill:#7ed321,stroke:#333
    style TrainJobStatus fill:#7ed321,stroke:#333
    style RuntimeStatuses fill:#7ed321,stroke:#333
    style JobSets fill:#dae8fc,stroke:#333
    style PodGroupsSP fill:#dae8fc,stroke:#333
    style PodGroupsVolc fill:#dae8fc,stroke:#333
