graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - Kubernetes Network)"]
        direction TB

        subgraph NS_Operator["Namespace: opendatahub / redhat-ods-applications"]
            DSPO["DSPO Controller Manager<br/>SA: dspo-controller-manager<br/>Ports: 8080 (metrics), 8081 (health),<br/>9443 (webhook TLS)"]
            SVC["Service: dspo-service<br/>ClusterIP 8080/TCP<br/>Exposure: Internal"]
        end

        subgraph NS_K8s["Kubernetes Control Plane"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        end

        subgraph NS_Argo["Namespace: argo"]
            ArgoEngine["Argo Workflow Engine<br/>SA: argo<br/>Secret access: argo-workflows-<br/>agent-ca-certificates ONLY"]
        end

        subgraph NS_Target["Target Namespaces (Dynamically Provisioned)"]
            ProvisionedCRDs["14 CRDs<br/>(argoproj.io, kubeflow.org,<br/>pipelines.kubeflow.org)"]
            ProvisionedRBAC["4 ClusterRoles<br/>1 ClusterRoleBinding<br/>2 Roles + 2 RoleBindings"]
        end

        subgraph PlatformDeps["Internal Platform Dependencies"]
            KServe["KServe InferenceService<br/>CRD Watch (read-only)<br/>TLS 1.2+"]
            MLflow["MLflow CR<br/>(mlflow.opendatahub.io)<br/>CRD Watch (read-only)<br/>TLS 1.2+"]
            KubeflowNB["Kubeflow Notebooks<br/>(kubeflow.org)<br/>CRD CRUD<br/>TLS 1.2+"]
            PromOp["prometheus-operator<br/>ServiceMonitor CRUD<br/>TLS 1.2+"]
            OSImages["OpenShift Image Streams<br/>REST read<br/>TLS 1.2+"]
        end
    end

    %% Flows with security details
    DSPO -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    DSPO -->|"ClusterIP/8080<br/>TCP"| SVC
    K8sAPI -->|"Watch events<br/>TLS"| DSPO
    DSPO -->|"manifestival provisioning<br/>via K8s API"| NS_Target
    DSPO -->|"CRD Watch<br/>via K8s API<br/>TLS 1.2+"| KServe
    DSPO -->|"CRD Watch<br/>via K8s API<br/>TLS 1.2+"| MLflow
    DSPO -->|"CRD CRUD<br/>via K8s API<br/>TLS 1.2+"| KubeflowNB
    DSPO -->|"CRD CRUD<br/>via K8s API<br/>TLS 1.2+"| PromOp
    DSPO -->|"REST/6443<br/>HTTPS TLS 1.2+"| OSImages
    K8sAPI -->|"Watch events"| ArgoEngine

    %% Health probes (no auth)
    K8sAPI -.->|"GET /healthz<br/>8081/HTTP<br/>No Auth"| DSPO
    K8sAPI -.->|"GET /readyz<br/>8081/HTTP<br/>No Auth"| DSPO

    %% Webhook
    K8sAPI -->|"Admission webhook<br/>9443/TCP TLS"| DSPO

    %% No external ingress
    NoIngress["No External Ingress<br/>(Internal only)"]

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef k8s fill:#326ce5,stroke:#333,stroke-width:2px,color:#fff
    classDef argo fill:#e96d3f,stroke:#333,stroke-width:2px,color:#fff
    classDef provisioned fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#7ed321,stroke:#333,stroke-width:1px
    classDef noingress fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class DSPO,SVC operator
    class K8sAPI k8s
    class ArgoEngine argo
    class ProvisionedCRDs,ProvisionedRBAC provisioned
    class KServe,MLflow,KubeflowNB,PromOp,OSImages platform
    class NoIngress noingress
