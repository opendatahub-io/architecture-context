graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Browser"]
    end

    subgraph Ingress["INGRESS (TLS Edge Termination)"]
        Route["OpenShift Route<br/>your-app.apps.cluster.example.com<br/>443/TCP -> 80/TCP<br/>TLS Edge, Insecure=Redirect"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        ProxySvc["kube-auth-proxy Service<br/>ClusterIP :80 -> :4180"]

        subgraph ProxyPod["kube-auth-proxy Pod"]
            direction TB
            Proxy["kube-auth-proxy<br/>Port: 4180/TCP<br/>Health: GET /ping<br/>runAsNonRoot: true<br/>allowPrivilegeEscalation: false<br/>Capabilities: DROP ALL"]
        end

        subgraph UpstreamNS["Upstream Namespace"]
            UpstreamSvc["Upstream Service<br/>(e.g. example-app)<br/>ClusterIP :8080"]
        end
    end

    subgraph ExternalAuth["EXTERNAL SERVICES (Auth)"]
        OAuth["OpenShift OAuth Server<br/>/ OIDC Provider<br/>HTTPS<br/>OAuth2 Client Credentials"]
    end

    subgraph ExternalData["EXTERNAL SERVICES (Data)"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS TLS 1.2+<br/>ServiceAccount Token"]
        Redis["Redis / Valkey<br/>Standalone / Sentinel / Cluster<br/>TCP (optional TLS + custom CA)<br/>Username/Password Auth"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Cookie or Bearer Token"| Route

    %% Ingress to Proxy
    Route -->|"HTTP/80 -> 4180<br/>Post-TLS termination<br/>Passthrough"| ProxySvc
    ProxySvc --> Proxy

    %% Proxy to OAuth (bidirectional OAuth2 flow)
    Proxy -->|"HTTPS<br/>OAuth2 Authorization +<br/>Token Exchange"| OAuth

    %% Proxy to Kubernetes API
    Proxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>TokenReview API"| K8sAPI

    %% Proxy to Redis
    Proxy -->|"TCP (optional TLS)<br/>Custom CA supported<br/>Session persistence +<br/>Distributed locking"| Redis

    %% Proxy to Upstream
    Proxy -->|"HTTP/8080<br/>No encryption (internal)<br/>X-Auth-Request-User<br/>X-Auth-Request-Email<br/>Authorization: Bearer"| UpstreamSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef proxy fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class ProxySvc,UpstreamSvc internal
    class Proxy proxy
    class K8sAPI,Redis externalservice
    class OAuth authservice
