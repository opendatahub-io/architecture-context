graph LR
    ODHGitops["odh-gitops<br/>(Configuration Repository)"]

    %% Infrastructure Dependencies (bundled/managed)
    ODHGitops -->|"bundles chart<br/>(xKS)"| CertManager["cert-manager<br/>(rhai-ca-issuer)"]
    ODHGitops -->|"bundles chart<br/>(xKS)"| SailOperator["sail-operator<br/>(Istio)"]
    ODHGitops -->|"bundles chart<br/>(xKS)"| GatewayAPI["gateway-api"]
    ODHGitops -->|"bundles chart<br/>(xKS)"| LWS["lws<br/>(LeaderWorkerSet)"]
    ODHGitops -->|"creates gateways"| Istio["Istio / Gateway API"]
    ODHGitops -->|"patches auth"| Authorino["Kuadrant / Authorino"]

    %% Operator Lifecycle (OpenShift)
    ODHGitops -->|"OLM Subscriptions<br/>(12 operators)"| OLM["OLM<br/>(OpenShift)"]
    ODHGitops -->|"DataScienceCluster CR"| RHOAIOp["RHOAI Operator"]

    %% RHOAI Components (configured via managementState)
    ODHGitops -.->|"managementState"| KServe[KServe]
    ODHGitops -.->|"managementState"| Dashboard[Dashboard]
    ODHGitops -.->|"managementState"| Ray[Ray]
    ODHGitops -.->|"managementState"| Trainer[Trainer]
    ODHGitops -.->|"managementState"| Kueue[Kueue]
    ODHGitops -.->|"managementState"| TrustyAI[TrustyAI]
    ODHGitops -.->|"managementState"| Workbenches[Workbenches]
    ODHGitops -.->|"managementState"| ModelReg["Model Registry"]
    ODHGitops -.->|"managementState"| Pipelines["AI Pipelines"]
    ODHGitops -.->|"managementState"| Feast["Feast Operator"]
    ODHGitops -.->|"managementState"| OGX[OGX]
    ODHGitops -.->|"managementState"| MLflow[MLflow]
    ODHGitops -.->|"managementState"| Spark[Spark]
    ODHGitops -.->|"managementState"| TrainingOp["Training Operator"]

    %% GitOps Tools
    ArgoCD[ArgoCD] -->|"syncs"| ODHGitops
    Flux[Flux] -->|"syncs"| ODHGitops

    %% Cloud Platforms
    ODHGitops -->|"xKS chart"| AWS["AWS (EKS)"]
    ODHGitops -->|"xKS chart"| Azure["Azure (AKS)"]
    ODHGitops -->|"xKS chart"| CoreWeave["CoreWeave"]
    ODHGitops -->|"OpenShift chart"| OpenShift["OpenShift"]

