graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["trustyai Route<br/>TLS: null (not configured)<br/>Auth: None declared"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Deploy["Namespace: {deployment-namespace}"]
            ClusterIPSvc["trustyai-service<br/>ClusterIP Service<br/>80/TCP → 8080/TCP"]
            TrustyAI["trustyai-service<br/>Deployment (1 replica)<br/>SA: trustyai-serviceaccount<br/>Runtime: Quarkus"]
            InitContainer["config-map-overrider<br/>(Init Container)"]
            PVC["trustyai-service-pvc<br/>PVC at /inputs<br/>Inference data storage"]
        end

        subgraph NS_KServe["KServe / ModelMesh Namespace"]
            KServe["KServe Model Serving<br/>Infrastructure"]
            ModelServingCM["model-serving-config<br/>ConfigMap"]
        end

        subgraph NS_Monitoring["Monitoring"]
            Prometheus["Prometheus<br/>Metrics Scraping"]
        end
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["OpenShift API Server<br/>443/TCP<br/>TLS<br/>SA Token Auth"]
    end

    %% Flows
    Client -->|"HTTP<br/>No TLS (tls: null)<br/>No Auth declared"| Route
    Route -->|"HTTP/80<br/>No Encryption declared"| ClusterIPSvc
    ClusterIPSvc -->|"HTTP/8080"| TrustyAI

    KServe -->|"POST /consumer/kserve/v2<br/>HTTP/8080<br/>No Auth declared<br/>Inference payloads"| TrustyAI

    Prometheus -->|"GET /q/metrics<br/>HTTP/8080<br/>Scrape via annotations"| TrustyAI

    TrustyAI -->|"Read/Write<br/>Inference data"| PVC

    InitContainer -->|"HTTPS/443<br/>TLS<br/>SA bearer token<br/>oc apply ConfigMap"| K8sAPI
    InitContainer -.->|"creates"| ModelServingCM
    ModelServingCM -.->|"registers processor URL"| KServe

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route warning
    class ClusterIPSvc,TrustyAI,InitContainer,KServe,ModelServingCM,Prometheus internal
    class K8sAPI controlplane
    class PVC storage
