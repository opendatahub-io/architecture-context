graph TD
    subgraph "Authentication Mechanisms"
        direction TB
        OAuthAuth["OpenShift OAuth /<br/>OIDC Authentication<br/>(Human Users)"]
        TokenReview["Kubernetes TokenReview<br/>API Validation<br/>(Service Accounts)"]
        CookieSession["Encrypted Cookie<br/>Session Management"]
    end

    subgraph "Service Identity"
        SA["kube-auth-proxy<br/>ServiceAccount<br/>(in-cluster)"]
    end

    subgraph "Kubernetes API Access"
        K8sAPI["Kubernetes API Server<br/>:6443"]
    end

    subgraph "API Resources Accessed"
        TokenReviewAPI["authentication/v1<br/>TokenReview<br/>(POST/create)"]
    end

    subgraph "Secrets"
        ProxySecret["kube-auth-proxy-secret<br/>Type: Opaque<br/>Provisioned: manifest"]
    end

    subgraph "Network Exposure"
        RouteAccess["OpenShift Route<br/>TLS Edge Termination<br/>External Access"]
    end

    %% Authentication flows
    OAuthAuth -->|"OAuth2 flow<br/>Authorization + Token Exchange"| CookieSession
    TokenReview -->|"Bearer token<br/>Direct validation"| K8sAPI

    %% Service account access
    SA -->|"In-cluster token<br/>auto-mounted"| K8sAPI
    K8sAPI -->|"validates"| TokenReviewAPI

    %% Secret usage
    ProxySecret -->|"Configuration<br/>secrets"| SA

    %% External exposure
    RouteAccess -->|"Ingress to proxy"| SA

    %% Notes
    Note["Note: No ClusterRoles or<br/>RoleBindings defined in<br/>analyzed manifests.<br/>Authentication relies on<br/>in-cluster ServiceAccount<br/>token and OAuth client."]

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style OAuthAuth fill:#f5a623,stroke:#333,color:#fff
    style TokenReview fill:#f5a623,stroke:#333,color:#fff
    style CookieSession fill:#f5a623,stroke:#333,color:#fff
    style TokenReviewAPI fill:#7ed321,stroke:#333,color:#fff
    style ProxySecret fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style RouteAccess fill:#ffe6cc,stroke:#d79b00
    style Note fill:#fff,stroke:#ccc,stroke-dasharray: 5 5
