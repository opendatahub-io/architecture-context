graph TB
    subgraph "Data Science Pipelines"
        direction TB

        subgraph "API Layer"
            APIServer["ml-pipeline<br/>(API Server)<br/>HTTP:8888 / gRPC:8887 / Webhook:8443"]
            UI["ml-pipeline-ui<br/>(Frontend)<br/>HTTP:3000"]
            VizServer["ml-pipeline-visualizationserver<br/>HTTP:8888"]
        end

        subgraph "Controllers"
            ScheduledWF["ml-pipeline-scheduledworkflow<br/>Scheduled Workflow Controller"]
            PersistAgent["ml-pipeline-persistenceagent<br/>Persistence Agent"]
            ViewerCRD["ml-pipeline-viewer-crd<br/>Viewer CRD Controller"]
            CacheDeployer["cache-deployer-deployment<br/>Cache Deployer"]
        end

        subgraph "Caching"
            CacheServer["cache-server<br/>Mutating Webhook<br/>HTTPS:443"]
        end

        subgraph "Metadata Pipeline"
            MetadataEnvoy["metadata-envoy-deployment<br/>Envoy Proxy<br/>gRPC:9090"]
            MetadataGRPC["metadata-grpc-deployment<br/>ML Metadata Store<br/>gRPC:8080"]
            MetadataWriter["metadata-writer<br/>Workflow Metadata Writer"]
        end

        subgraph "Storage"
            MySQL["mysql<br/>MySQL 8.4<br/>TCP:3306"]
            SeaweedFS["seaweedfs<br/>S3-compatible Storage<br/>S3:8333 / Filer:8888"]
        end
    end

    %% External
    User[Data Scientist / Client] -->|"REST API"| APIServer
    User -->|"Web UI"| UI

    %% CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]

    User -->|creates| PipelineCR
    User -->|creates| PipelineVersionCR
    PipelineCR -->|watched by| APIServer
    PipelineVersionCR -->|validated/mutated| CacheServer

    %% Internal flows
    APIServer -->|"queries"| MySQL
    CacheServer -->|"queries"| MySQL
    MetadataGRPC -->|"queries"| MySQL

    APIServer -->|"stores artifacts"| SeaweedFS
    UI -->|"reads artifacts"| SeaweedFS

    MetadataEnvoy -->|"proxies gRPC"| MetadataGRPC
    MetadataWriter -->|"writes metadata"| MetadataEnvoy

    PersistAgent -->|"reports runs"| APIServer
    ScheduledWF -->|"creates workflows"| ArgoWF

    UI -->|"API calls"| APIServer

    %% External dependencies
    ArgoWF["Argo Workflow Controller<br/>quay.io/argoproj/workflow-controller:v3.7.14"]
    K8sAPI["Kubernetes API<br/>6443/HTTPS"]
    Prometheus["Prometheus<br/>Metrics Scraping"]

    APIServer -->|"manages workflows"| ArgoWF
    MetadataWriter -->|"watches workflows"| ArgoWF
    APIServer -->|"RBAC, resources"| K8sAPI
    Prometheus -->|"scrapes /metrics"| APIServer

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style UI fill:#4a90e2,stroke:#333,color:#fff
    style VizServer fill:#4a90e2,stroke:#333,color:#fff
    style ScheduledWF fill:#7b68ee,stroke:#333,color:#fff
    style PersistAgent fill:#7b68ee,stroke:#333,color:#fff
    style ViewerCRD fill:#7b68ee,stroke:#333,color:#fff
    style CacheDeployer fill:#7b68ee,stroke:#333,color:#fff
    style CacheServer fill:#e67e22,stroke:#333,color:#fff
    style MetadataEnvoy fill:#2ecc71,stroke:#333,color:#fff
    style MetadataGRPC fill:#2ecc71,stroke:#333,color:#fff
    style MetadataWriter fill:#2ecc71,stroke:#333,color:#fff
    style MySQL fill:#e74c3c,stroke:#333,color:#fff
    style SeaweedFS fill:#e74c3c,stroke:#333,color:#fff
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style ArgoWF fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style User fill:#f9f9f9,stroke:#333
