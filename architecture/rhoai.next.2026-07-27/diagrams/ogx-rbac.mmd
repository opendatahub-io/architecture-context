graph TD
    subgraph AuthFlow["Authentication Flow"]
        BearerToken["Bearer Token<br/>(from client request)"]
        AuthMW["AuthenticationMiddleware"]
        BearerToken -->|"extracted from<br/>Authorization header"| AuthMW
    end

    subgraph Providers["Auth Providers (runtime-selectable)"]
        OAuth2["OAuth2TokenAuthProvider"]
        Custom["CustomAuthProvider"]
        AuthMW -->|"provider_type=oauth2"| OAuth2
        AuthMW -->|"provider_type=custom"| Custom
    end

    subgraph ClaimsMapping["Claims-to-Attributes Mapping"]
        direction TB
        Sub["sub / username"]
        Groups["groups / team"]
        Project["project"]
        Tenant["tenant / namespace"]
        Roles["roles (attribute)"]
        Teams["teams (attribute)"]
        Projects["projects (attribute)"]
        Namespaces["namespaces (attribute)"]
        Sub -->|maps to| Roles
        Groups -->|maps to| Teams
        Project -->|maps to| Projects
        Tenant -->|maps to| Namespaces
    end

    OAuth2 -->|"validates JWT<br/>extracts claims"| ClaimsMapping

    subgraph ABAC["ABAC Enforcement Layer"]
        direction TB

        subgraph RoutingTableABAC["CommonRoutingTableImpl"]
            RT_Create["create resource"]
            RT_Read["read resource"]
            RT_Delete["delete resource"]
            RT_List["list resources"]
        end

        subgraph AgentABAC["AgentPersistence"]
            AP_Create["create session<br/>(records ownership)"]
            AP_Read["read session<br/>(verifies ownership)"]
        end

        IsAllowed["is_action_allowed<br/>Policy Engine"]
        RT_Create --> IsAllowed
        RT_Read --> IsAllowed
        RT_Delete --> IsAllowed
        RT_List --> IsAllowed
        AP_Create --> IsAllowed
        AP_Read --> IsAllowed
    end

    ClaimsMapping -->|"user attributes"| ABAC

    subgraph APIResources["Protected API Resources"]
        InferenceModels["Inference Models<br/>(provider routing)"]
        AgentSessions["Agent Sessions<br/>(KV store)"]
        SafetyShields["Safety Shields"]
        VectorDBs["Vector I/O Stores"]
        Datasets["Dataset I/O"]
        ToolRuntimes["Tool Runtimes"]
    end

    IsAllowed -->|"allow/deny"| APIResources

    subgraph Secrets["API Key Secrets (env vars)"]
        direction TB
        S1["OPENAI_API_KEY"]
        S2["CEREBRAS_API_KEY"]
        S3["NVIDIA_API_KEY"]
        S4["TAVILY_SEARCH_API_KEY"]
        S5["FIREWORKS_API_KEY"]
        S6["TOGETHER_API_KEY"]
        S7["SAMBANOVA_API_KEY"]
        S8["WATSONX_API_KEY"]
        S9["GITHUB_TOKEN"]
    end

    APIResources -->|"uses credentials"| Secrets

    %% Styling
    style AuthMW fill:#e74c3c,stroke:#333,color:#fff
    style OAuth2 fill:#f39c12,stroke:#333,color:#fff
    style Custom fill:#f39c12,stroke:#333,color:#fff
    style IsAllowed fill:#e74c3c,stroke:#333,color:#fff
    style BearerToken fill:#3498db,stroke:#333,color:#fff

    style RT_Create fill:#f8cecc,stroke:#b85450
    style RT_Read fill:#f8cecc,stroke:#b85450
    style RT_Delete fill:#f8cecc,stroke:#b85450
    style RT_List fill:#f8cecc,stroke:#b85450
    style AP_Create fill:#f8cecc,stroke:#b85450
    style AP_Read fill:#f8cecc,stroke:#b85450

    style InferenceModels fill:#7ed321,stroke:#333
    style AgentSessions fill:#7ed321,stroke:#333
    style SafetyShields fill:#7ed321,stroke:#333
    style VectorDBs fill:#7ed321,stroke:#333
    style Datasets fill:#7ed321,stroke:#333
    style ToolRuntimes fill:#7ed321,stroke:#333

    style S1 fill:#dae8fc,stroke:#6c8ebf
    style S2 fill:#dae8fc,stroke:#6c8ebf
    style S3 fill:#dae8fc,stroke:#6c8ebf
    style S4 fill:#dae8fc,stroke:#6c8ebf
    style S5 fill:#dae8fc,stroke:#6c8ebf
    style S6 fill:#dae8fc,stroke:#6c8ebf
    style S7 fill:#dae8fc,stroke:#6c8ebf
    style S8 fill:#dae8fc,stroke:#6c8ebf
    style S9 fill:#dae8fc,stroke:#6c8ebf
