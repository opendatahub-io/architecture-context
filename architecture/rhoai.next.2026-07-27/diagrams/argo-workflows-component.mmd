graph TB
    subgraph ArgoWorkflows["Argo Workflows Platform"]
        subgraph ArgoServer["argo-server (Deployment)"]
            API["REST API Server<br/>HTTPS/2746"]
            GRPC["gRPC Services<br/>(grpc-gateway transcoding)"]
            UI["Argo UI"]
            SSOHandler["OAuth2/OIDC SSO<br/>(go-oidc/v3)"]
            AuthGatekeeper["Auth Gatekeeper<br/>(per-request K8s RBAC)"]
            API --> AuthGatekeeper
            GRPC --> AuthGatekeeper
            SSOHandler --> AuthGatekeeper
        end

        subgraph Controller["workflow-controller (Deployment)"]
            WFController["Workflow Controller<br/>Leader Election (Lease)"]
            HealthEndpoint["Health /healthz<br/>HTTP/6060"]
            MetricsEndpoint["Prometheus /metrics<br/>HTTP/9090"]
        end

        ArgoExec["argoexec (Sidecar)<br/>Step/DAG Executor<br/>User: 2000"]
    end

    %% CRDs
    subgraph CRDs["Custom Resource Definitions (argoproj.io/v1alpha1)"]
        WF["Workflow"]
        CronWF["CronWorkflow"]
        WFTemplate["WorkflowTemplate"]
        ClusterWFTemplate["ClusterWorkflowTemplate<br/>(Cluster-scoped)"]
        WFTaskSet["WorkflowTaskSet"]
        WFTaskResult["WorkflowTaskResult"]
        WFEventBinding["WorkflowEventBinding"]
        WFArtifactGC["WorkflowArtifactGCTask"]
    end

    %% External clients
    User["Data Scientist / User"] -->|"kubectl / UI"| API
    User -->|"OAuth2 SSO"| SSOHandler

    %% CRD interactions
    User -->|creates| WF
    User -->|creates| CronWF
    User -->|creates| WFTemplate
    User -->|creates| ClusterWFTemplate

    WF -->|watched by| WFController
    CronWF -->|watched by| WFController
    WFTemplate -->|referenced by| WFController
    ClusterWFTemplate -->|referenced by| WFController
    WFController -->|creates| WFTaskSet
    WFController -->|reads| WFTaskResult
    WFController -->|manages| WFArtifactGC

    %% Controller creates pods with argoexec sidecar
    WFController -->|"creates Pods with sidecar"| ArgoExec

    %% External dependencies
    K8sAPI["Kubernetes API<br/>HTTPS/6443"]
    IdP["Identity Provider<br/>(OAuth2/OIDC)"]

    WFController -->|"ConfigMap, Pod, Secret,<br/>PDB, SSAR CRUD"| K8sAPI
    AuthGatekeeper -->|"RBAC check"| K8sAPI
    SSOHandler -->|"token validation"| IdP

    %% Styling
    style API fill:#4a90e2,color:#fff
    style GRPC fill:#4a90e2,color:#fff
    style WFController fill:#4a90e2,color:#fff
    style ArgoExec fill:#4a90e2,color:#fff
    style AuthGatekeeper fill:#e8744f,color:#fff
    style SSOHandler fill:#e8744f,color:#fff
    style WF fill:#f5a623
    style CronWF fill:#f5a623
    style WFTemplate fill:#f5a623
    style ClusterWFTemplate fill:#f5a623
    style WFTaskSet fill:#f5a623
    style WFTaskResult fill:#f5a623
    style WFEventBinding fill:#f5a623
    style WFArtifactGC fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style IdP fill:#e8e8e8
