graph TD
    subgraph "Service Account"
        SA["payload-processor<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole Bindings"
        CRB["payload-processor-auth-reviewer-binding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole"
        CR["payload-processor-auth-reviewer"]
    end

    subgraph "API Resources"
        ConfigMaps["core (v1)<br/>configmaps"]
    end

    subgraph "Permitted Operations"
        GetOp["get"]
        ListOp["list"]
        WatchOp["watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"permits"| ConfigMaps
    ConfigMaps --> GetOp
    ConfigMaps --> ListOp
    ConfigMaps --> WatchOp

    subgraph "ConfigMap Filter"
        LabelFilter["Label selector:<br/>inference.llm-d.ai/ipp-managed: true"]
    end

    WatchOp -.->|"runtime filter"| LabelFilter

    subgraph "Authentication Surface"
        ExtProc["ExternalProcessor gRPC<br/>Auth: None<br/>TLS: Optional (config-dependent)"]
        HealthGRPC["Health gRPC<br/>Auth: None<br/>Plaintext"]
        HealthHTTP["Health HTTP<br/>GET /health :8000<br/>Auth: Unknown"]
        Metrics["Metrics<br/>:9090/TCP<br/>Auth: Optional K8s-native"]
    end

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#9b59b6,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style GetOp fill:#ddd,stroke:#333
    style ListOp fill:#ddd,stroke:#333
    style WatchOp fill:#ddd,stroke:#333
    style LabelFilter fill:#fff2cc,stroke:#d6b656
    style ExtProc fill:#ffcccc,stroke:#cc0000
    style HealthGRPC fill:#ffcccc,stroke:#cc0000
    style HealthHTTP fill:#ffe6cc,stroke:#d79b00
    style Metrics fill:#ffe6cc,stroke:#d79b00
