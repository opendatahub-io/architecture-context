graph LR
    TrustyAI["TrustyAI Service<br/>(FastAPI / Python)"]

    %% Runtime Dependencies (key libraries)
    TrustyAI -->|"web framework"| FastAPI["FastAPI >=0.116"]
    TrustyAI -->|"ASGI server"| Uvicorn["Uvicorn >=0.38"]
    TrustyAI -->|"ASGI server (alt)"| Hypercorn["Hypercorn >=0.18"]
    TrustyAI -->|"metrics exposition"| PrometheusClient["prometheus-client >=0.22"]

    %% ML/Data Dependencies
    TrustyAI -->|"ML algorithms"| ScikitLearn["scikit-learn >=1.7"]
    TrustyAI -->|"statistics"| SciPy["SciPy >=1.15"]
    TrustyAI -->|"data processing"| NumPy["NumPy >=2.0"]
    TrustyAI -->|"data frames"| Pandas["Pandas >=3.0"]
    TrustyAI -->|"data frames (alt)"| Polars["Polars >=1.2"]

    %% Storage Dependencies
    TrustyAI -->|"HDF5 storage"| H5py["h5py >=3.13"]
    TrustyAI -->|"MariaDB storage"| MariaDB["mariadb >=1.1"]
    TrustyAI -->|"SQLite dict"| SQLiteDict["sqlitedict >=2.1"]

    %% External Systems
    TrustyAI -->|"inference payloads"| KServe["KServe v2<br/>Inference Source"]
    TrustyAI -->|"partial payloads"| ModelMesh["ModelMesh<br/>Inference Source"]

    %% Outbound
    Prometheus["Prometheus"] -->|"scrapes /q/metrics"| TrustyAI

    %% Storage Backends
    TrustyAI -->|"PVC filesystem"| PVC["PVC Storage<br/>(HDF5 files)"]
    TrustyAI -->|"database"| MariaDBServer["MariaDB Server<br/>(Optional)"]

    %% Evaluation
    TrustyAI -->|"LM evaluation"| LMEval["lm-eval >=0.4"]

    %% Crypto
    TrustyAI -->|"TLS/crypto"| Cryptography["cryptography >=48.0.1"]

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Key libraries
    style FastAPI fill:#7ed321,stroke:#333,color:#fff
