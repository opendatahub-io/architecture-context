graph TB
    subgraph Orchestrator["fms-guardrails-orchestrator"]
        direction TB
        subgraph GuardrailsServer["Guardrails API Server (port 8033)"]
            direction LR
            V1Routes["v1 API Routes"]
            V2Routes["v2 API Routes"]
            HeaderFilter["Header Passthrough Filter"]
            TokenRewrite["X-Forwarded-Access-Token<br/>→ Bearer Rewrite"]
            TLSAcceptor["TLS/mTLS Acceptor<br/>(rustls + ring)"]
        end

        subgraph HealthServer["Health Server (port 8034)"]
            HealthEndpoint["/health"]
            InfoEndpoint["/info"]
        end

        OrchestratorHandler["Orchestrator Handler<br/>(Task Coordination)"]
        GRPCClient["gRPC Client (tonic)"]
        RESTClient["REST Client (reqwest)"]
        TLSConfig["Named TLS Configurations"]
    end

    Client[API Consumer] -->|POST /api/v1/*, /api/v2/*<br/>8033/TCP| TLSAcceptor
    TLSAcceptor --> HeaderFilter
    HeaderFilter --> TokenRewrite
    TokenRewrite --> V1Routes
    TokenRewrite --> V2Routes
    V1Routes --> OrchestratorHandler
    V2Routes --> OrchestratorHandler

    Monitor[Health Monitor] -->|GET /health, /info<br/>8034/TCP| HealthEndpoint

    OrchestratorHandler --> GRPCClient
    OrchestratorHandler --> RESTClient
    GRPCClient --> TLSConfig
    RESTClient --> TLSConfig

    GRPCClient -->|gRPC/8033| TGIS["TGIS Generation Service"]
    GRPCClient -->|gRPC/8085| Chunker["Chunker Services"]
    RESTClient -->|HTTP(S)/8080| Detector["Detector Services"]
    RESTClient -->|HTTP(S)/8081| DetectorHealth["Detector Health Services"]

    style Orchestrator fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style GuardrailsServer fill:#bbdefb,stroke:#1565c0
    style HealthServer fill:#c8e6c9,stroke:#2e7d32
    style OrchestratorHandler fill:#4a90e2,color:#fff
    style GRPCClient fill:#4a90e2,color:#fff
    style RESTClient fill:#4a90e2,color:#fff
    style TLSConfig fill:#4a90e2,color:#fff
    style Client fill:#f5f5f5,stroke:#333
    style Monitor fill:#f5f5f5,stroke:#333
    style TGIS fill:#e8e8e8,stroke:#333
    style Chunker fill:#e8e8e8,stroke:#333
    style Detector fill:#e8e8e8,stroke:#333
    style DetectorHealth fill:#e8e8e8,stroke:#333
