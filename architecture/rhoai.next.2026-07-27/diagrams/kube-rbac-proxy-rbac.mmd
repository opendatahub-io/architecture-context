graph TD
    subgraph "Service Accounts"
        SA_KRP["SA: kube-rbac-proxy<br/>(default namespace)"]
        SA_KRP_VO["SA: kube-rbac-proxy-verb-override<br/>(default namespace)"]
        SA_Default["SA: default<br/>(default namespace)"]
        SA_KRP_Curl["SA: krp-curl-verb-override<br/>(monitoring namespace)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_KRP["kube-rbac-proxy"]
        CRB_Client["kube-rbac-proxy-client"]
        CRB_VO["kube-rbac-proxy-verb-override"]
        RB_NS_Metrics["namespace-metrics<br/>(Role)"]
        RB_VO_Client["kube-rbac-proxy-verb-override-client<br/>(Role, monitoring ns)"]
    end

    subgraph "ClusterRoles"
        CR_KRP["ClusterRole:<br/>kube-rbac-proxy"]
        CR_Client["ClusterRole:<br/>kube-rbac-proxy-client"]
        CR_VO["ClusterRole:<br/>kube-rbac-proxy-verb-override"]
        R_NS_Metrics["Role:<br/>namespace-metrics"]
        R_VO_Client["Role:<br/>kube-rbac-proxy-verb-override-client"]
    end

    subgraph "API Resources & Permissions"
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
        SvcProxy["core<br/>services/proxy<br/>Verbs: get"]
        NSMetrics["core<br/>namespace/metrics<br/>Verbs: get"]
        Pods["core<br/>pods<br/>Verbs: list"]
    end

    %% Service Account → Binding
    SA_KRP -->|"bound via"| CRB_KRP
    SA_Default -->|"bound via"| CRB_Client
    SA_KRP_VO -->|"bound via"| CRB_VO
    SA_Default -->|"bound via"| RB_NS_Metrics
    SA_KRP_Curl -->|"bound via"| RB_VO_Client

    %% Binding → Role
    CRB_KRP -->|"grants"| CR_KRP
    CRB_Client -->|"grants"| CR_Client
    CRB_VO -->|"grants"| CR_VO
    RB_NS_Metrics -->|"grants"| R_NS_Metrics
    RB_VO_Client -->|"grants"| R_VO_Client

    %% Role → Resources
    CR_KRP -->|"create"| TokenReviews
    CR_KRP -->|"create"| SAR
    CR_VO -->|"create"| TokenReviews
    CR_VO -->|"create"| SAR
    CR_Client -->|"get"| SvcProxy
    R_NS_Metrics -->|"get"| NSMetrics
    R_VO_Client -->|"list"| Pods

    %% Styling
    style SA_KRP fill:#4a90e2,color:#fff
    style SA_KRP_VO fill:#4a90e2,color:#fff
    style SA_Default fill:#4a90e2,color:#fff
    style SA_KRP_Curl fill:#4a90e2,color:#fff
    style CR_KRP fill:#f5a623,color:#fff
    style CR_Client fill:#f5a623,color:#fff
    style CR_VO fill:#f5a623,color:#fff
    style R_NS_Metrics fill:#f5a623,color:#fff
    style R_VO_Client fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style SvcProxy fill:#7ed321,color:#fff
    style NSMetrics fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style CRB_KRP fill:#e8e8e8,stroke:#333
    style CRB_Client fill:#e8e8e8,stroke:#333
    style CRB_VO fill:#e8e8e8,stroke:#333
    style RB_NS_Metrics fill:#e8e8e8,stroke:#333
    style RB_VO_Client fill:#e8e8e8,stroke:#333
