graph LR
    Gateway["vllm-orchestrator-gateway<br/>Rust Service"]

    %% Runtime Dependencies (Internal RHOAI)
    Gateway -->|"POST /api/v2/chat/completions-detection<br/>HTTP(S) + mTLS"| Orchestrator["TrustAI Guardrails<br/>Orchestrator"]
    Orchestrator -->|"inference"| vLLM["vLLM Inference<br/>Endpoint"]

    %% Core Framework Dependencies
    subgraph "Core Framework (Rust Crates)"
        Axum["axum 0.7.9<br/>HTTP framework"]
        Tokio["tokio 1.41.1<br/>Async runtime"]
        TowerHTTP["tower-http 0.6.2<br/>HTTP middleware"]
    end
    Gateway -->|"HTTP server"| Axum
    Gateway -->|"async runtime"| Tokio
    Gateway -->|"middleware"| TowerHTTP

    %% HTTP Client Dependencies
    subgraph "HTTP Client"
        Reqwest["reqwest 0.12.12<br/>HTTP client"]
        Futures["futures 0.3.30<br/>Async streams"]
    end
    Gateway -->|"outbound HTTP"| Reqwest
    Gateway -->|"SSE streaming"| Futures

    %% TLS Dependencies
    subgraph "TLS / Security"
        OpenSSL["openssl 0.10.73<br/>TLS implementation"]
        NativeTLS["native-tls 0.2.12<br/>TLS abstraction"]
    end
    Gateway -->|"mTLS certs"| OpenSSL
    Gateway -->|"TLS transport"| NativeTLS

    %% Serialization Dependencies
    subgraph "Serialization"
        Serde["serde 1.0.215<br/>Serialization"]
        SerdeJSON["serde_json 1.0.133<br/>JSON codec"]
        SerdeYML["serde_yml 0.0.12<br/>YAML config"]
    end
    Gateway -->|"data types"| Serde
    Gateway -->|"request/response"| SerdeJSON
    Gateway -->|"config loading"| SerdeYML

    %% Observability
    subgraph "Observability"
        Tracing["tracing 0.1.41<br/>Instrumentation"]
        TracingSub["tracing-subscriber 0.3.19<br/>Log output"]
    end
    Gateway -->|"logging"| Tracing
    Gateway -->|"log format"| TracingSub

    %% Utility
    Anyhow["anyhow 1.0.94<br/>Error handling"]
    Regex["regex 1.11.1<br/>Pattern matching"]
    Gateway -->|"errors"| Anyhow
    Gateway -->|"route matching"| Regex

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style Axum fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style TowerHTTP fill:#999,stroke:#333
    style Reqwest fill:#999,stroke:#333
    style Futures fill:#999,stroke:#333
    style OpenSSL fill:#999,stroke:#333
    style NativeTLS fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style SerdeJSON fill:#999,stroke:#333
    style SerdeYML fill:#999,stroke:#333
    style Tracing fill:#999,stroke:#333
    style TracingSub fill:#999,stroke:#333
    style Anyhow fill:#999,stroke:#333
    style Regex fill:#999,stroke:#333
