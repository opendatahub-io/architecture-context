graph TB
    subgraph Internal["INTERNAL (Cluster Network)"]
        Kubelet["Kubelet / Probes"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (feast-operator-system)"]
        direction TB
        Controller["feast-operator-controller-manager<br/>SA: feast-operator-controller-manager<br/>Container: manager (controller:latest)<br/>Ports: 8081, 8443"]
        MetricsSvc["feast-operator-controller-manager<br/>-metrics-service<br/>ClusterIP :8443/TCP"]
    end

    subgraph ClusterAPI["CLUSTER-WIDE"]
        KubeAPI["Kubernetes API Server<br/>:6443/TCP<br/>HTTPS + WebSocket<br/>TLS 1.2+"]
    end

    subgraph WatchedResources["WATCHED RESOURCES"]
        direction TB
        FeastOperatorCR["FeastOperator CR<br/>components.platform.opendatahub.io/v1<br/>Cluster-scoped singleton"]
        FeatureStoreCR["FeatureStore CR<br/>feast.dev/v1<br/>Namespaced"]
        KubeflowNB["Kubeflow Notebooks<br/>kubeflow.org<br/>Read-only"]
        OSRoutes["OpenShift Routes<br/>route.openshift.io<br/>CRUD"]
        PromSM["Prometheus ServiceMonitors<br/>monitoring.coreos.com<br/>CRUD"]
    end

    %% Flows
    Kubelet -->|"HTTP/8081<br/>Plaintext<br/>No Auth<br/>/healthz, /readyz"| Controller
    Controller -->|"HTTPS/8443<br/>TLS<br/>RBAC (TokenReview)"| MetricsSvc
    Controller -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| KubeAPI
    KubeAPI -.->|"Watch streams"| FeastOperatorCR
    KubeAPI -.->|"Watch streams"| FeatureStoreCR
    KubeAPI -.->|"Watch streams"| KubeflowNB
    KubeAPI -.->|"CRUD"| OSRoutes
    KubeAPI -.->|"CRUD"| PromSM

    %% Styling
    classDef internal fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterapi fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef watched fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Kubelet internal
    class Controller,MetricsSvc controller
    class KubeAPI clusterapi
    class FeastOperatorCR,FeatureStoreCR,KubeflowNB,OSRoutes,PromSM watched
