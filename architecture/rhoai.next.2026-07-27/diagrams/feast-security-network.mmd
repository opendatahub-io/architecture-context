graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["API Client / Data Scientist"]
    end

    subgraph AppLayer["APPLICATION LAYER"]
        direction TB

        subgraph PythonService["Python FastAPI Service"]
            PyAPI["feast (Python)<br/>Port: 6566/TCP<br/>Protocol: HTTP/HTTPS (configurable)<br/>Auth: None detected<br/>CRD-configurable: K8s RBAC or OIDC<br/>104 HTTP + 1 WebSocket endpoints"]
        end

        subgraph GoService["Go Feature Server"]
            GoHTTP["Go HTTP Server<br/>Port: 8080/TCP<br/>TLS 1.2+ (P256, X25519MLKEM768)<br/>when ServeTLS configured<br/>Auth: None (metrics+recover middleware)"]
            GoGRPC["Go gRPC Server<br/>Port: dynamic<br/>Encryption: None configured<br/>Auth: None (observability interceptors)"]
        end
    end

    subgraph ControlPlane["OPERATOR CONTROL PLANE"]
        Operator["feast-operator-controller-manager<br/>SA: feast-operator-controller-manager<br/>NS: feast-operator-system"]
        Metrics["Metrics Endpoint<br/>Port: 8443/TCP ClusterIP<br/>Self-signed TLS<br/>Auth: TokenReview + SubjectAccessReview"]
        Health["Health Probes<br/>Port: 8081/TCP<br/>/healthz + /readyz<br/>Auth: None (by design)"]
    end

    subgraph K8sAPI["KUBERNETES API"]
        APIServer["kube-apiserver<br/>Port: 6443/TCP<br/>HTTPS/WSS, TLS 1.2+<br/>Auth: ServiceAccount token<br/>RBAC: feast-operator-manager-role"]
    end

    subgraph OnlineStores["ONLINE STORE BACKENDS"]
        PostgreSQL["PostgreSQL<br/>TCP, sslmode=require<br/>pgx/v5 connection pool"]
        Redis["Redis / Valkey<br/>TCP, optional TLS<br/>go-redis/v9 (pipelined)"]
        DynamoDB["DynamoDB<br/>443/TCP HTTPS<br/>AWS IAM auth"]
    end

    subgraph RegistryStores["REGISTRY STORES"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>Platform credentials<br/>5s timeout"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM credentials<br/>5s timeout"]
    end

    subgraph PlatformIntegrations["PLATFORM INTEGRATIONS"]
        Ray["Ray<br/>Distributed compute<br/>Auth: RAY_AUTH_TOKEN"]
        KubeflowNB["Kubeflow Notebooks<br/>CRD CRUD via K8s API"]
        PrometheusOp["prometheus-operator<br/>CRD CRUD via K8s API"]
        OpenLineage["OpenLineage<br/>Data lineage<br/>Auth: API Key"]
    end

    %% External flows
    Client -->|"HTTP/HTTPS :6566<br/>Configurable encryption<br/>No auth middleware"| PyAPI
    Client -->|"HTTP :8080<br/>TLS configurable<br/>No auth"| GoHTTP
    Client -->|"gRPC<br/>No TLS / No auth"| GoGRPC

    %% Internal flows
    PyAPI -->|"CGo / Arrow C ABI<br/>In-process zero-copy"| GoHTTP

    %% Operator flows
    Operator -->|"HTTPS/WSS :6443<br/>TLS 1.2+<br/>SA token"| APIServer

    %% Online store flows
    GoHTTP -->|"TCP<br/>sslmode=require"| PostgreSQL
    GoHTTP -->|"TCP<br/>Optional TLS"| Redis
    GoHTTP -->|"HTTPS :443<br/>AWS IAM"| DynamoDB

    %% Registry flows
    GoHTTP -->|"HTTPS :443<br/>Platform creds"| GCS
    GoHTTP -->|"HTTPS :443<br/>AWS IAM"| S3

    %% Platform integration flows
    PyAPI -->|"SDK<br/>RAY_AUTH_TOKEN"| Ray
    PyAPI -->|"HTTP<br/>API Key"| OpenLineage
    Operator -->|"K8s API<br/>TLS 1.2+"| KubeflowNB
    Operator -->|"K8s API<br/>TLS 1.2+"| PrometheusOp

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8sapi fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef integration fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class PyAPI,GoHTTP,GoGRPC appservice
    class Operator,Metrics,Health controlplane
    class APIServer k8sapi
    class PostgreSQL,Redis,DynamoDB,GCS,S3 datastore
    class Ray,KubeflowNB,PrometheusOp,OpenLineage integration
