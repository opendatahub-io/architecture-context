graph TB
    subgraph "codeflare-sdk (Python Client Library)"
        direction TB
        AuthModule["Authentication Module<br/>(auth.py)"]
        RayJobClient["RayJobClient<br/>(ray_jobs.py)"]
        ConfigCheck["config_check()<br/>Auto-detection"]

        subgraph "Auth Methods"
            TokenAuth["TokenAuthentication<br/>Bearer Token + Server URL"]
            KubeConfigAuth["KubeConfigFileAuthentication<br/>kubeconfig file path"]
            InClusterAuth["In-Cluster Auto-Detection<br/>~/.kube/config fallback"]
        end

        AuthModule --> TokenAuth
        AuthModule --> KubeConfigAuth
        AuthModule --> InClusterAuth
        ConfigCheck --> KubeConfigAuth
        ConfigCheck --> InClusterAuth
    end

    subgraph "TLS Certificate Resolution"
        ExplicitCA["Explicit CA Path"]
        EnvCA["CF_SDK_CA_CERT_PATH<br/>env variable"]
        DefaultCA["OpenShift Workbench Default<br/>/etc/pki/tls/custom-certs/ca-bundle.crt"]
    end

    AuthModule --> ExplicitCA
    AuthModule --> EnvCA
    AuthModule --> DefaultCA

    User["Data Scientist / ML Engineer<br/>(Notebook / Script)"] -->|"imports & configures"| AuthModule
    User -->|"submits jobs"| RayJobClient

    RayJobClient -->|"submit / stop / delete<br/>status / logs"| RayDashboard["Ray Cluster Dashboard<br/>HTTP :8265"]
    AuthModule -->|"authenticates to"| K8sAPI["Kubernetes API Server<br/>HTTPS :6443"]

    subgraph "Test-Only Infrastructure (not shipped)"
        Minio["MinIO<br/>quay.io/minio/minio<br/>:9000 API / :9090 Console"]
    end

    style AuthModule fill:#4a90e2,stroke:#333
    style RayJobClient fill:#4a90e2,stroke:#333
    style ConfigCheck fill:#4a90e2,stroke:#333
    style TokenAuth fill:#6bb5f0,stroke:#333
    style KubeConfigAuth fill:#6bb5f0,stroke:#333
    style InClusterAuth fill:#6bb5f0,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style RayDashboard fill:#f5a623,stroke:#333
    style Minio fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style User fill:#7ed321,stroke:#333
    style ExplicitCA fill:#d5e8d4,stroke:#82b366
    style EnvCA fill:#d5e8d4,stroke:#82b366
    style DefaultCA fill:#d5e8d4,stroke:#82b366
