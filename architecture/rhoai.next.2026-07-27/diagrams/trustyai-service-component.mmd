graph TB
    subgraph TrustyAI["TrustyAI Service (FastAPI)"]
        direction TB
        Main["main.py<br/>Uvicorn/Hypercorn ASGI"]

        subgraph Routers["API Router Modules"]
            Consumer["Consumer Endpoint<br/>/consumer/kserve/v2"]
            DataUpload["Data Upload<br/>/data/upload"]
            Metadata["Metadata Endpoint<br/>/info/*"]
            Health["Health & Metrics<br/>/q/health/*, /q/metrics"]
        end

        subgraph MetricsRouters["Metrics Routers"]
            Fairness["Fairness Metrics<br/>SPD, DIR"]
            Drift["Drift Detection<br/>KS, Jensen-Shannon,<br/>Fourier MMD, Compare Means,<br/>Mean Shift"]
            BatchMean["Batch Mean<br/>Statistics"]
            Identity["Identity Metrics"]
        end

        subgraph ExplainerRouters["Explainer Routers (Stubbed)"]
            GlobalExplainer["Global Explainers<br/>LIME, PDP<br/>NOT_IMPLEMENTED"]
            LocalExplainer["Local Explainers<br/>LIME, SHAP, CF,<br/>TSSaliency<br/>NOT_IMPLEMENTED"]
        end

        subgraph Storage["Storage Layer"]
            StorageInterface["StorageInterface<br/>Abstraction"]
            PVC["PVC Storage<br/>h5py / HDF5"]
            MariaDBStorage["MariaDB Storage<br/>Optional"]
        end

        Main --> Consumer
        Main --> DataUpload
        Main --> Metadata
        Main --> Health
        Main --> Fairness
        Main --> Drift
        Main --> BatchMean
        Main --> Identity
        Main --> GlobalExplainer
        Main --> LocalExplainer

        Consumer --> StorageInterface
        DataUpload --> StorageInterface
        Fairness --> StorageInterface
        Drift --> StorageInterface
        BatchMean --> StorageInterface
        Identity --> StorageInterface
        Metadata --> StorageInterface

        StorageInterface --> PVC
        StorageInterface --> MariaDBStorage
    end

    subgraph External["External Systems"]
        KServe["KServe v2<br/>Inference Payloads"]
        ModelMesh["ModelMesh<br/>Partial Payloads"]
        Prometheus["Prometheus<br/>Metrics Scraping"]
    end

    KServe -->|"POST / (cloud events)<br/>POST /consumer/kserve/v2"| Consumer
    ModelMesh -->|"POST /consumer/kserve/v2<br/>Partial Payloads"| Consumer
    Prometheus -->|"GET /q/metrics<br/>Scrape"| Health

    PrometheusScheduler["PrometheusScheduler<br/>Scheduled Metric Publishing"]
    Fairness --> PrometheusScheduler
    Drift --> PrometheusScheduler
    BatchMean --> PrometheusScheduler
    Identity --> PrometheusScheduler

