graph TB
    subgraph "Guardrails Detectors System"
        subgraph "Built-in Detector (FastAPI)"
            BuiltInApp["Built-in Detector App<br/>detectors/built_in/app.py"]
            RegexRegistry["RegexDetectorRegistry"]
            FileTypeRegistry["FileTypeDetectorRegistry"]
            CustomRegistry["CustomDetectorRegistry"]
            BuiltInApp --> RegexRegistry
            BuiltInApp --> FileTypeRegistry
            BuiltInApp --> CustomRegistry
        end

        subgraph "LLM Judge Detector (FastAPI)"
            LLMJudgeApp["LLM Judge Detector App<br/>detectors/llm_judge/app.py"]
            LLMJudge["LLMJudgeDetector<br/>Safety, Toxicity, Accuracy,<br/>Helpfulness metrics"]
            PrometheusInstr["Prometheus<br/>Instrumentator"]
            LLMJudgeApp --> LLMJudge
            LLMJudgeApp --> PrometheusInstr
        end

        subgraph "Model Storage"
            MinIO["MinIO Server<br/>quay.io/trustyai/modelmesh-minio-examples<br/>Port: 9000/TCP"]
            InitContainer["Init Container<br/>quay.io/rgeada/llm_downloader<br/>Downloads from HuggingFace Hub"]
            PVC["PVC: guardrails-models-claim-guardian<br/>100Gi"]
            InitContainer -->|"downloads models"| PVC
            MinIO -->|"serves models"| PVC
        end
    end

    Client["Client / Guardrails Orchestrator"] -->|"POST /api/v1/text/contents"| BuiltInApp
    Client -->|"GET /registry"| BuiltInApp
    Client -->|"GET /metrics"| BuiltInApp
    Client -->|"POST /api/v1/text/contents"| LLMJudgeApp
    Client -->|"POST /api/v1/text/generation"| LLMJudgeApp
    Client -->|"GET /api/v1/metrics"| LLMJudgeApp

    LLMJudge -->|"S3 API / Port 9000"| MinIO

    HuggingFace["HuggingFace Hub<br/>ibm-granite/granite-guardian-3.0-2b"] -->|"model download"| InitContainer

    Secret["Secret:<br/>aws-connection-minio-data-connection<br/>-guardrails-guardian"]
    Secret -.->|"S3 credentials"| MinIO

    style BuiltInApp fill:#4a90e2,color:#fff
    style LLMJudgeApp fill:#4a90e2,color:#fff
    style MinIO fill:#f5a623,color:#fff
    style InitContainer fill:#f5a623,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style HuggingFace fill:#e8e8e8,stroke:#333
    style PVC fill:#d5e8d4,stroke:#82b366
    style Secret fill:#fff2cc,stroke:#d6b656
    style RegexRegistry fill:#7ed321,color:#fff
    style FileTypeRegistry fill:#7ed321,color:#fff
    style CustomRegistry fill:#7ed321,color:#fff
    style LLMJudge fill:#7ed321,color:#fff
