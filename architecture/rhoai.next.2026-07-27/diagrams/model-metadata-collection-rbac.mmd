graph TD
    subgraph "model-metadata-collection RBAC"
        Note["This component is a CLI tool,<br/>not a Kubernetes workload.<br/><br/>No Kubernetes RBAC is configured:<br/>- No ServiceAccounts<br/>- No ClusterRoles<br/>- No RoleBindings<br/>- No CRDs"]
    end

    subgraph "Authentication (Environment-Based)"
        direction TB

        EnvFile[".env File<br/>(loaded at startup)"]
        ShellEnv["Shell Environment<br/>(takes precedence)"]

        HFToken["HF_TOKEN<br/>HuggingFace API Bearer Token<br/>Optional - rate-limited without"]
        GHToken["GITHUB_TOKEN<br/>GitHub API Bearer Token<br/>Optional - rate-limited without"]
        DockerConfig["Docker config.json<br/>OCI Registry Credentials<br/>Via containers/image defaults"]

        ShellEnv -->|overrides| EnvFile
        EnvFile -->|provides| HFToken
        EnvFile -->|provides| GHToken
    end

    subgraph "Access Scope"
        HFToken -->|"read-only access"| HFScope["HuggingFace API<br/>GET /api/collections<br/>GET /api/models/{id}"]
        GHToken -->|"read-only access"| GHScope["GitHub API<br/>GET repos/.../contents"]
        DockerConfig -->|"pull access"| OCIScope["OCI Registry<br/>GET manifests<br/>GET blobs"]
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style HFToken fill:#f5a623,stroke:#333
    style GHToken fill:#f5a623,stroke:#333
    style DockerConfig fill:#f5a623,stroke:#333
    style HFScope fill:#d5e8d4,stroke:#82b366
    style GHScope fill:#d5e8d4,stroke:#82b366
    style OCIScope fill:#d5e8d4,stroke:#82b366
