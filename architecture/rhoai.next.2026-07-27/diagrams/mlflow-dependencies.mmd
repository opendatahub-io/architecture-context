    MLflow -->|"ASGI server"| Uvicorn["uvicorn <1"]
    MLflow -->|"ORM"| SQLAlchemy["SQLAlchemy <3"]
    MLflow -->|"migrations"| Alembic["Alembic <2"]
    MLflow -->|"validation"| Pydantic["Pydantic <3"]
    MLflow -->|"rate limiting"| Slowapi["slowapi <1"]
    MLflow -->|"serialization"| Protobuf["protobuf <8"]
    MLflow -->|"tracing"| OTelSDK["OpenTelemetry SDK <3"]

    %% ML/Data Dependencies
    MLflow -->|"ML framework"| ScikitLearn["scikit-learn <2"]
    MLflow -->|"data format"| PyArrow["PyArrow <25"]
    MLflow -->|"data analysis"| Pandas["Pandas <3"]

    %% Platform Integrations
    MLflow -.->|"auth chain"| Databricks["Databricks"]
    MLflow -.->|"LLM orchestration"| LangChain["LangChain"]
    MLflow -.->|"MCP protocol"| FastMCP["fastmcp <4"]

    %% Companion Distributions
    MLflowSkinny["mlflow-skinny<br/>(Lightweight)"] -.->|"subset of"| MLflow
    MLflowTracing["mlflow-tracing<br/>(SDK)"] -.->|"instruments"| MLflow

