graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["codeflare-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["codeflare-operator-<br/>manager-rolebinding"]
        CRB_Leader["codeflare-operator-<br/>leader-election-rolebinding<br/>(NS: opendatahub)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["codeflare-operator-<br/>manager-role"]
        CR_Editor["codeflare-operator-<br/>appwrapper-editor-role"]
        CR_Viewer["codeflare-operator-<br/>viewer-role"]
    end

    subgraph LeaderElection["Leader Election Role (NS: opendatahub)"]
        R_Leader["codeflare-operator-<br/>leader-election-role"]
    end

    %% Bindings
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Leader
    CRB_Manager -->|grants| CR_Manager
    CRB_Leader -->|grants| R_Leader

    %% Manager Role Resources
    subgraph CoreResources["Core API Resources"]
        Events["events<br/>create, patch, update, watch"]
        Nodes["nodes<br/>get, list, watch"]
        Pods["pods<br/>full CRUD"]
        SVCs["services<br/>full CRUD"]
        SAs["serviceaccounts<br/>full CRUD"]
        Secrets["secrets<br/>get, list, update, watch, create, patch"]
        ConfigMaps["configmaps<br/>(leader election)"]
    end

    subgraph WorkloadAPIs["Workload API Resources"]
        AppWrappers["workload.codeflare.dev<br/>appwrappers<br/>full CRUD + finalizers + status"]
        RayClusters["ray.io<br/>rayclusters, rayjobs<br/>full CRUD + finalizers + status"]
        PyTorchJobs["kubeflow.org<br/>pytorchjobs<br/>full CRUD"]
        JobSets["jobset.x-k8s.io<br/>jobsets<br/>full CRUD"]
        PodGroups["scheduling.*.k8s.io<br/>podgroups<br/>full CRUD"]
    end

    subgraph InfraAPIs["Infrastructure API Resources"]
        Deployments["apps<br/>deployments, statefulsets<br/>full CRUD"]
        Jobs["batch<br/>jobs<br/>full CRUD"]
        Ingresses["networking.k8s.io<br/>ingresses, networkpolicies<br/>full CRUD"]
        Routes["route.openshift.io<br/>routes, routes/custom-host<br/>full CRUD"]
        CRBs["rbac.authorization.k8s.io<br/>clusterrolebindings<br/>full CRUD"]
    end

    subgraph AuthAPIs["Auth Delegation"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph WebhookAPIs["Webhook Management"]
        MutatingWH["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations<br/>get, list, update, watch"]
        ValidatingWH["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>get, list, update, watch"]
        CRDs["apiextensions.k8s.io<br/>customresourcedefinitions<br/>get, list, watch"]
    end

    subgraph PlatformAPIs["Platform APIs"]
        DSCIRes["dscinitialization.opendatahub.io<br/>dscinitializations<br/>get, list, watch"]
        OSIngress["config.openshift.io<br/>ingresses<br/>get"]
    end

    CR_Manager -->|manages| Events
    CR_Manager -->|reads| Nodes
    CR_Manager -->|manages| Pods
    CR_Manager -->|manages| SVCs
    CR_Manager -->|manages| SAs
    CR_Manager -->|manages| Secrets
    CR_Manager -->|manages| AppWrappers
    CR_Manager -->|manages| RayClusters
    CR_Manager -->|manages| PyTorchJobs
    CR_Manager -->|manages| JobSets
    CR_Manager -->|manages| PodGroups
    CR_Manager -->|manages| Deployments
    CR_Manager -->|manages| Jobs
    CR_Manager -->|manages| Ingresses
    CR_Manager -->|manages| Routes
    CR_Manager -->|manages| CRBs
    CR_Manager -->|delegates| TokenReviews
    CR_Manager -->|delegates| SAR
    CR_Manager -->|configures| MutatingWH
    CR_Manager -->|configures| ValidatingWH
    CR_Manager -->|reads| CRDs
    CR_Manager -->|reads| DSCIRes
    CR_Manager -->|reads| OSIngress

    %% Editor/Viewer Roles
    subgraph SelfService["Self-Service Access"]
        AW_CRUD["AppWrappers<br/>full CRUD + status(get)"]
        AW_Read["AppWrappers<br/>get, list, watch + status(get)"]
    end

    CR_Editor -->|grants| AW_CRUD
    CR_Viewer -->|grants| AW_Read

    %% Leader Election
    subgraph LeaderRes["Leader Election Resources"]
        LE_ConfigMaps["configmaps<br/>full CRUD"]
        LE_Leases["coordination.k8s.io<br/>leases<br/>full CRUD"]
        LE_Events["events<br/>create, patch"]
    end

    R_Leader -->|manages| LE_ConfigMaps
    R_Leader -->|manages| LE_Leases
    R_Leader -->|manages| LE_Events

