graph LR
    AGO["AI Gateway Operator<br/><i>Module Operator</i>"]

    %% Managed Sub-Components
    AGO -->|"deploys (managementState)"| BatchGW["Batch Gateway<br/><i>batch.llm-d.ai</i>"]
    AGO -->|"deploys (managementState)"| MaaS["Models-as-a-Service<br/><i>maas.opendatahub.io</i><br/><i>inference.opendatahub.io</i>"]

    %% API Governance Dependencies
    AGO -->|"AuthPolicies<br/>RateLimitPolicies"| Kuadrant["Kuadrant"]
    AGO -->|"read-only"| Authorino["Authorino"]

    %% Service Mesh Dependencies
    AGO -->|"DestinationRules<br/>EnvoyFilters<br/>ServiceEntries"| Istio["Istio"]

    %% TLS Dependencies
    AGO -->|"Certificate CRs"| CertManager["cert-manager"]

    %% Routing Dependencies
    AGO -->|"HTTPRoutes"| GatewayAPI["Gateway API"]

    %% Observability Dependencies
    AGO -->|"ServiceMonitors<br/>PrometheusRules"| PromOp["prometheus-operator"]
    AGO -->|"OTel Collectors"| OTel["OpenTelemetry"]
    AGO -->|"Dashboards"| Perses["Perses"]
    AGO -->|"Telemetries"| IstioTelemetry["Istio Telemetry"]

    %% ODH Platform Dependencies
    AGO -->|"watches init state"| DSCI["DSCInitialization"]
    AGO -->|"watches model state"| KServe["KServe<br/><i>InferenceService</i><br/><i>LLMInferenceService</i>"]
    AGO -->|"Go library"| ODHOp["opendatahub-operator<br/><i>Module framework</i>"]

    %% Core Dependencies
    AGO -->|"REST + WebSocket<br/>6443/TCP"| K8sAPI["Kubernetes API"]

    %% Styling
    style AGO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Managed sub-components (blue)
    style BatchGW fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style MaaS fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    %% API governance (orange)
    style Kuadrant fill:#ffe6cc,stroke:#d79b00
    style Authorino fill:#ffe6cc,stroke:#d79b00

    %% Service mesh (purple)
    style Istio fill:#e1d5e7,stroke:#9673a6
    style IstioTelemetry fill:#e1d5e7,stroke:#9673a6

    %% TLS (yellow)
    style CertManager fill:#fff2cc,stroke:#d6b656

    %% Routing (yellow)
    style GatewayAPI fill:#fff2cc,stroke:#d6b656

    %% Observability (green)
    style PromOp fill:#d5e8d4,stroke:#82b366
    style OTel fill:#d5e8d4,stroke:#82b366
    style Perses fill:#d5e8d4,stroke:#82b366

    %% ODH platform (green)
    style DSCI fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ODHOp fill:#7ed321,stroke:#333

    %% External
    style K8sAPI fill:#f5a623,stroke:#333
