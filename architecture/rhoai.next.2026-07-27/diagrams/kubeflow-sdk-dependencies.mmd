graph LR
    KubeflowSDK["kubeflow SDK<br/>(Python client library)"]

    %% Core Runtime Dependency
    KubeflowSDK -->|"CRD operations<br/>HTTPS/6443"| K8sAPI["Kubernetes API Server"]

    %% Kubeflow API Packages (required)
    KubeflowSDK -->|"TrainJob types<br/>protobuf"| TrainerAPI["kubeflow-trainer-api<br/>>=2.0.0"]
    KubeflowSDK -->|"Experiment types<br/>protobuf"| KatibAPI["kubeflow-katib-api<br/>>=0.19.0"]
    KubeflowSDK -->|"SparkConnect types<br/>protobuf"| SparkAPI["kubeflow-spark-api<br/>>=2.4.0"]

    %% Core Python Dependencies
    KubeflowSDK -->|"K8s client"| K8sClient["kubernetes<br/>>=27.2.0"]
    KubeflowSDK -->|"data validation"| Pydantic["pydantic<br/>>=2.10.0"]

    %% Optional: Hub extra
    KubeflowSDK -.->|"model artifacts<br/>(hub extra)"| ModelRegistry["model-registry<br/>>=0.3.6"]

    %% Optional: RHAI extra
    KubeflowSDK -.->|"S3 storage<br/>(rhai extra)"| Fsspec["fsspec<br/>>=2025.3.0"]
    KubeflowSDK -.->|"S3 access<br/>(rhai extra)"| S3fs["s3fs<br/>>=2025.3.0"]

    %% Optional: Spark extra
    KubeflowSDK -.->|"Spark sessions<br/>(spark extra)"| PySpark["pyspark-connect<br/>==4.0.1"]

    %% Optional: Container extras
    KubeflowSDK -.->|"local training<br/>(docker extra)"| Docker["docker<br/>>=6.1.3"]
    KubeflowSDK -.->|"local training<br/>(podman extra)"| Podman["podman<br/>>=5.6.0"]

    %% Internal RHOAI Components (runtime targets)
    TrainerOp["Kubeflow Trainer<br/>Operator"] ---|"watches TrainJob CRs"| K8sAPI
    KatibOp["Kubeflow Katib<br/>Operator"] ---|"watches Experiment CRs"| K8sAPI
    SparkOp["Spark Operator"] ---|"watches SparkConnect CRs"| K8sAPI

    %% Styling
    style KubeflowSDK fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core dependencies
    style K8sAPI fill:#e8e8e8,stroke:#333
    style K8sClient fill:#e8e8e8,stroke:#333
    style Pydantic fill:#e8e8e8,stroke:#333

    %% API packages
    style TrainerAPI fill:#b8d4f0,stroke:#333
    style KatibAPI fill:#b8d4f0,stroke:#333
    style SparkAPI fill:#b8d4f0,stroke:#333

    %% Internal RHOAI operators
    style TrainerOp fill:#7ed321,stroke:#333,color:#fff
    style KatibOp fill:#7ed321,stroke:#333,color:#fff
    style SparkOp fill:#7ed321,stroke:#333,color:#fff

    %% Optional dependencies
    style ModelRegistry fill:#7ed321,stroke:#333,color:#fff
    style Fsspec fill:#f5a623,stroke:#333,color:#fff
    style S3fs fill:#f5a623,stroke:#333,color:#fff
    style PySpark fill:#f5a623,stroke:#333,color:#fff
    style Docker fill:#999,stroke:#333,color:#fff
    style Podman fill:#999,stroke:#333,color:#fff
