graph LR
    AgentsOp["agents-operator<br/>(kagenti-operator)"]

    %% External Dependencies (Required)
    AgentsOp -->|"TLS certs<br/>Certificate + Issuer CRDs"| CertManager["cert-manager 1.21+"]
    AgentsOp -->|"workload identity<br/>X.509-SVID mTLS"| SPIRE["SPIRE / SPIFFE"]
    AgentsOp -->|"identity provider<br/>KeycloakRealmImport CRD"| Keycloak["Keycloak"]
    AgentsOp -->|"gRPC ExtProc<br/>per-request processing"| Envoy["Envoy Proxy"]

    %% External Dependencies (Platform)
    AgentsOp -->|"API gateway<br/>policy config"| Kuadrant["Kuadrant"]
    AgentsOp -->|"pipeline integration<br/>TektonConfig patch"| Tekton["Tekton"]
    AgentsOp -->|"external exposure<br/>Route CRUD"| Routes["OpenShift Routes"]

    %% Internal RHOAI Dependencies
    AgentsOp -->|"feature gating<br/>CRD Watch"| DSC["DataScienceCluster CR"]
    AgentsOp -->|"experiment tracking<br/>CRD Watch"| MLflow["MLflow<br/>(mlflow.opendatahub.io)"]

    %% Core Dependencies
    AgentsOp -->|"resource management<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]
    AgentsOp -->|"operator framework"| CtrlRuntime["controller-runtime 0.24.1"]

    %% Key Library Dependencies
    AgentsOp -->|"JWT validation"| JWX["lestrrat-go/jwx"]
    AgentsOp -->|"OPA policy eval"| OPA["open-policy-agent/opa 1.4"]
    AgentsOp -->|"card signing"| Sigstore["sigstore-go 1.2"]

    %% Internal Components
    AgentsOp -->|"token exchange<br/>OAuth2 sessions"| TokenBroker["token-broker<br/>(internal)"]
    AgentsOp -->|"card signing"| AgentCardSigner["agentcard-signer<br/>(internal)"]
    AgentsOp -->|"agent bundles"| BundleService["bundle-service<br/>(internal)"]

    %% AuthBridge subsystem
    subgraph AuthBridgeVariants["AuthBridge Sidecar Variants"]
        direction TB
        ABEnvoy["authbridge-envoy"]
        ABProxy["authbridge-proxy"]
        ABLite["authbridge-lite"]
    end
    AgentsOp -->|"sidecar injection<br/>mutating webhook"| AuthBridgeVariants

    %% Reverse dependencies (who depends on agents-operator)
    DSC -.->|"component status"| AgentsOp

    %% Styling
    style AgentsOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style SPIRE fill:#999,stroke:#333,color:#fff
    style Keycloak fill:#999,stroke:#333,color:#fff
    style Envoy fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style Tekton fill:#999,stroke:#333,color:#fff
    style Routes fill:#999,stroke:#333,color:#fff
    style DSC fill:#7ed321,stroke:#333,color:#fff
    style MLflow fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style CtrlRuntime fill:#f5a623,stroke:#333
    style JWX fill:#ddd,stroke:#333
    style OPA fill:#ddd,stroke:#333
    style Sigstore fill:#ddd,stroke:#333
    style TokenBroker fill:#27ae60,stroke:#333,color:#fff
    style AgentCardSigner fill:#27ae60,stroke:#333,color:#fff
    style BundleService fill:#27ae60,stroke:#333,color:#fff
    style ABEnvoy fill:#9b59b6,stroke:#333,color:#fff
    style ABProxy fill:#9b59b6,stroke:#333,color:#fff
    style ABLite fill:#9b59b6,stroke:#333,color:#fff
