graph LR
    TrainerOp["Trainer Operator<br/>(meta-operator)"]

    %% Managed Component
    TrainerOp ==>|"deploys &<br/>manages"| KubeflowTrainer["Kubeflow Trainer<br/>Controller Manager<br/>(v2.2.0)"]

    %% Core Runtime Dependencies
    TrainerOp -->|"operator framework"| ControllerRuntime["controller-runtime<br/>0.23.3"]
    TrainerOp -->|"platform helpers"| PlatformUtils["odh-platform-utilities<br/>0.1.0"]

    %% Kubernetes API Dependencies
    TrainerOp -->|"resource CRUD"| K8sAPI["Kubernetes API<br/>:6443 HTTPS"]
    TrainerOp -->|"CRD management"| K8sAPIExt["apiextensions-apiserver<br/>0.35.2"]

    %% Platform Service Dependencies
    TrainerOp -->|"PodMonitor CRUD"| PrometheusOp["prometheus-operator<br/>(monitoring.coreos.com)"]
    TrainerOp -->|"subscription status"| OLM["OLM<br/>(operators.coreos.com)"]
    TrainerOp -->|"image management"| ImageStreams["OpenShift<br/>Image Streams"]

    %% Managed Controller Dependencies
    KubeflowTrainer -->|"training workloads"| JobSet["JobSet Operator<br/>(jobset.x-k8s.io)"]
    KubeflowTrainer -.->|"batch scheduling"| Volcano["Volcano Scheduler<br/>(scheduling.volcano.sh)"]
    KubeflowTrainer -.->|"batch scheduling"| Kueue["Kueue<br/>(scheduling.x-k8s.io)"]

    %% Build Dependencies
    TrainerOp -->|"Go runtime"| GoLang["Go 1.25.7"]

    %% CRD Dependencies
    TrainerOp -->|"watches"| TrainerCRD["Trainer CRD<br/>components.platform.opendatahub.io"]
    KubeflowTrainer -->|"reconciles"| TrainJobCRD["TrainJob CRD<br/>trainer.kubeflow.org"]
    KubeflowTrainer -->|"reconciles"| RuntimeCRDs["TrainingRuntime &<br/>ClusterTrainingRuntime CRDs<br/>trainer.kubeflow.org"]

    %% Styling
    style TrainerOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KubeflowTrainer fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333
    style PlatformUtils fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style K8sAPIExt fill:#999,stroke:#333
    style PrometheusOp fill:#7ed321,stroke:#333,color:#fff
    style OLM fill:#f5a623,stroke:#333,color:#fff
    style ImageStreams fill:#f5a623,stroke:#333,color:#fff
    style JobSet fill:#f5a623,stroke:#333,color:#fff
    style Volcano fill:#999,stroke:#333,stroke-dasharray: 5 5
    style Kueue fill:#999,stroke:#333,stroke-dasharray: 5 5
    style GoLang fill:#999,stroke:#333
