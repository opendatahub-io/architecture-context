graph TD
    subgraph "ai4rag RBAC"
        direction TB
        NoRBAC["No Kubernetes RBAC Defined"]
        Note["ai4rag is a Python library<br/>with no Kubernetes API interactions.<br/>No ClusterRoles, Roles, or<br/>RoleBindings are defined."]
    end

    subgraph "Runtime Credentials"
        direction TB
        AWSKeyID["AWS_ACCESS_KEY_ID<br/>(environment variable)<br/>S3 access credential"]
        AWSSecretKey["AWS_SECRET_ACCESS_KEY<br/>(environment variable)<br/>S3 secret credential"]
        AWSSessionToken["AWS_SESSION_TOKEN<br/>(environment variable, optional)<br/>Temporary session token"]
        DoclingPath["DOCLING_ARTIFACTS_PATH<br/>(environment variable)<br/>Model artifacts location"]
    end

    subgraph "Credential Resolution"
        direction TB
        ExplicitParams["Explicit Parameters<br/>(constructor / method args)"]
        EnvFallback["Environment Variable Fallback"]
        Validation["Validation<br/>Missing required → ValueError"]

        ExplicitParams -->|"primary"| Validation
        EnvFallback -->|"fallback"| Validation
    end

    subgraph "Protected Resources"
        S3Bucket["S3 Bucket Objects<br/>(document corpora)"]
    end

    AWSKeyID -->|"authenticates"| S3Bucket
    AWSSecretKey -->|"authenticates"| S3Bucket
    AWSSessionToken -.->|"session auth"| S3Bucket

    %% Styling
    style NoRBAC fill:#f9f9f9,stroke:#999,stroke-dasharray: 5 5
    style Note fill:#f9f9f9,stroke:#999,stroke-dasharray: 5 5
    style AWSKeyID fill:#f8cecc,stroke:#b85450
    style AWSSecretKey fill:#f8cecc,stroke:#b85450
    style AWSSessionToken fill:#f8cecc,stroke:#b85450
    style DoclingPath fill:#fff2cc,stroke:#d6b656
    style ExplicitParams fill:#d5e8d4,stroke:#82b366
    style EnvFallback fill:#d5e8d4,stroke:#82b366
    style Validation fill:#d5e8d4,stroke:#82b366
    style S3Bucket fill:#dae8fc,stroke:#6c8ebf
