graph TB
    subgraph "lm-evaluation-harness"
        direction TB
        CLI["lm-eval CLI<br/>Entry Point"]
        TaskMgr["TaskManager<br/>Task Loading & Config"]
        Evaluator["Evaluator<br/>simple_evaluate()"]

        subgraph "Model Backends (Plugin Registry)"
            direction LR
            HF["HuggingFace<br/>Transformers<br/>(default)"]
            Anthropic["Anthropic<br/>Completions & Chat"]
            OpenAI["OpenAI<br/>Completions & Chat"]
            Watsonx["IBM Watsonx AI"]
            LocalModel["Local<br/>Completions & Chat"]
        end

        S3Downloader["S3 Downloader<br/>Asset Pre-fetch Utility"]
        EvalHub["eval-hub-sdk<br/>Adapter (v0.4.4)"]
    end

    User[User / CI Pipeline] -->|"lm-eval --model &lt;backend&gt;<br/>--tasks &lt;tasks&gt;"| CLI
    CLI -->|parses args| TaskMgr
    CLI -->|"--model selects backend"| Evaluator
    TaskMgr -->|loads tasks| Evaluator
    Evaluator -->|instantiates| HF
    Evaluator -->|instantiates| Anthropic
    Evaluator -->|instantiates| OpenAI
    Evaluator -->|instantiates| Watsonx
    Evaluator -->|instantiates| LocalModel
    CLI -->|orchestration adapter| EvalHub

    HF -->|loads models| HFHub["HuggingFace Hub"]
    Anthropic -->|API calls| AnthropicAPI["Anthropic API"]
    OpenAI -->|API calls| OpenAIAPI["OpenAI API"]
    Watsonx -->|API calls| WatsonxAPI["IBM Watsonx API"]
    S3Downloader -->|downloads assets| S3["S3-Compatible Storage"]

    Evaluator -->|outputs| Results["JSON Results"]
    Results -.->|optional push| HFHub
    Results -.->|optional push| WandB["Weights & Biases"]

    style CLI fill:#4a90e2,color:#fff
    style TaskMgr fill:#4a90e2,color:#fff
    style Evaluator fill:#4a90e2,color:#fff
