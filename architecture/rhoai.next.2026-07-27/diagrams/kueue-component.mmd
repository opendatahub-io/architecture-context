graph TB
    subgraph KueueSystem["Kueue Controller Manager"]
        direction TB
        subgraph Controllers["Controllers"]
            WC[Workload Controller]
            PC[Pod Controller]
            SS[StatefulSet Controller]
            LWS[LeaderWorkerSet Controller]
            AC[AdmissionCheck Controller]
            MKC[MultiKueueCluster Controller]
        end

        subgraph Webhooks["Admission Webhooks"]
            MW["17 Mutating Webhooks<br/>9443/TCP TLS"]
            VW["18 Validating Webhooks<br/>9443/TCP TLS"]
            CW["CRD Conversion<br/>/convert"]
        end

        subgraph Services["Internal Services"]
            WS["kueue-webhook-service<br/>443/TCP → 9443"]
            MS["kueue-metrics-service<br/>8443/TCP"]
        end
    end

    subgraph CRDs["Kueue CRDs"]
        CQ[ClusterQueue]
        LQ[LocalQueue]
        WL[Workload]
        RF[ResourceFlavor]
        ACR[AdmissionCheck]
        WPC[WorkloadPriorityClass]
        Cohort[Cohort]
        Topology[Topology]
        MKCluster[MultiKueueCluster]
        MKConfig[MultiKueueConfig]
        PRC[ProvisioningRequestConfig]
    end

    subgraph WorkloadTypes["Managed Workload Types"]
        Job["batch/Job"]
        JobSet["JobSet"]
        PyTorch["PyTorchJob"]
        TFJob["TFJob"]
        MPI["MPIJob"]
        XGBoost["XGBoostJob"]
        Paddle["PaddleJob"]
        RayJob["RayJob"]
        RayCluster["RayCluster"]
        AppWrapper["AppWrapper"]
        Pod["Pod"]
        Deploy["Deployment"]
        StatefulSet["StatefulSet"]
        LeaderWorkerSet["LeaderWorkerSet"]
    end

    User[Platform Admin / Data Scientist] -->|creates| CQ
    User -->|creates| LQ
    User -->|submits| WorkloadTypes

    WorkloadTypes -->|intercepted by| MW
    MW -->|validates via| VW
    VW -->|creates| WL

    WC -->|watches| WL
    WC -->|evaluates against| CQ
    WC -->|checks| RF
    WC -->|checks| ACR
    WC -->|admits/suspends| WorkloadTypes

    PC -->|reconciles| Pod
    SS -->|reconciles| StatefulSet
    LWS -->|reconciles| LeaderWorkerSet
    AC -->|reconciles| ACR
    MKC -->|reconciles| MKCluster

    WS -->|routes to| MW
    WS -->|routes to| VW
    MS -->|exposes| Prometheus[Prometheus Metrics]

    WC -->|calls| K8sAPI[Kubernetes API<br/>6443/TCP TLS]

    style KueueSystem fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Controllers fill:#d5e8d4,stroke:#82b366
    style Webhooks fill:#fff2cc,stroke:#d6b656
    style Services fill:#f8cecc,stroke:#b85450
    style CRDs fill:#dae8fc,stroke:#6c8ebf
    style WorkloadTypes fill:#e1d5e7,stroke:#9673a6

    style WC fill:#4a90e2,color:#fff
    style PC fill:#4a90e2,color:#fff
    style SS fill:#4a90e2,color:#fff
    style LWS fill:#4a90e2,color:#fff
    style AC fill:#4a90e2,color:#fff
    style MKC fill:#4a90e2,color:#fff
    style MW fill:#f5a623
    style VW fill:#f5a623
    style CW fill:#f5a623
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
