graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["ogx-k8s-operator-<br/>controller-manager<br/>(NS: ogx-k8s-operator-system)"]
        SA_ControllerMgr["controller-manager<br/>(NS: system)"]
        SA_Operator["operator<br/>(NS: system)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["ogx-k8s-operator-<br/>manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-<br/>proxy-rolebinding"]
        CRB_ProxyLegacy["proxy-rolebinding"]
        CRB_ManagerLegacy["manager-rolebinding"]
        CRB_ManagerCluster["manager-cluster-<br/>rolebinding"]
        CRB_MetricsAuth["metrics-auth-<br/>rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ogx-k8s-operator-<br/>manager-role"]
        CR_Proxy["ogx-k8s-operator-<br/>proxy-role"]
        CR_ManagerLegacy["manager-role"]
        CR_ManagerCluster["manager-cluster-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_Viewer["ogx-k8s-operator-<br/>ogxserver-viewer-role"]
        CR_Editor["ogx-k8s-operator-<br/>ogxserver-editor-role"]
        CR_OGXAdmin["components-ogx-<br/>admin-role"]
        CR_OGXEditor["components-ogx-<br/>editor-role"]
        CR_OGXViewer["components-ogx-<br/>viewer-role"]
    end

    subgraph APIResources_Core["Core API Resources"]
        ConfigMaps["ConfigMaps"]
        PVCs["PVCs"]
        Pods["Pods"]
        Secrets["Secrets"]
        ServiceAccts["ServiceAccounts"]
        SVCs["Services"]
        Events["Events"]
    end

    subgraph APIResources_Apps["apps API Resources"]
        Deployments["Deployments"]
        ReplicaSets["ReplicaSets"]
    end

    subgraph APIResources_OGX["ogx.io API Resources"]
        OGXServers["ogxservers"]
        OGXServersFinalizers["ogxservers/finalizers"]
        OGXServersStatus["ogxservers/status"]
    end

    subgraph APIResources_Components["components.platform.opendatahub.io"]
        OGXs["ogxs"]
        OGXsFinalizers["ogxs/finalizers"]
        OGXsStatus["ogxs/status"]
    end

    subgraph APIResources_Net["networking.k8s.io"]
        Ingresses["Ingresses"]
        NetPolicies["NetworkPolicies"]
    end

    subgraph APIResources_Auth["Auth API Resources"]
        TokenReviews["TokenReviews<br/>(authentication.k8s.io)"]
        SAR["SubjectAccessReviews<br/>(authorization.k8s.io)"]
    end

    %% SA → CRB → CR bindings
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Proxy
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy

    SA_ControllerMgr -->|bound via| CRB_ProxyLegacy
    SA_ControllerMgr -->|bound via| CRB_ManagerLegacy
    CRB_ProxyLegacy -->|grants| CR_Proxy
    CRB_ManagerLegacy -->|grants| CR_ManagerLegacy

    SA_Operator -->|bound via| CRB_ManagerCluster
    SA_Operator -->|bound via| CRB_MetricsAuth
    CRB_ManagerCluster -->|grants| CR_ManagerCluster
    CRB_MetricsAuth -->|grants| CR_MetricsAuth

    %% CR → Resources
    CR_Manager -->|"CRUD"| ConfigMaps
    CR_Manager -->|"CRUD"| PVCs
    CR_Manager -->|"list"| Pods
    CR_Manager -->|"read"| Secrets
    CR_Manager -->|"CRUD"| ServiceAccts
    CR_Manager -->|"CRUD"| SVCs
    CR_Manager -->|"CRUD"| Deployments
    CR_Manager -->|"read"| ReplicaSets
    CR_Manager -->|"CRUD"| OGXServers
    CR_Manager -->|"update"| OGXServersFinalizers
    CR_Manager -->|"read/update"| OGXServersStatus
    CR_Manager -->|"CRUD"| Ingresses
    CR_Manager -->|"CRUD"| NetPolicies

    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR

    CR_ManagerCluster -->|"CRUD"| OGXs
    CR_ManagerCluster -->|"update"| OGXsFinalizers
    CR_ManagerCluster -->|"read/update"| OGXsStatus
    CR_ManagerCluster -->|"create/patch"| Events

    CR_Viewer -->|"read"| OGXServers
    CR_Viewer -->|"read"| OGXServersStatus

    CR_Editor -->|"CRUD"| OGXServers
    CR_Editor -->|"read"| OGXServersStatus

    CR_OGXAdmin -->|"*"| OGXs
    CR_OGXEditor -->|"CRUD"| OGXs
    CR_OGXViewer -->|"read"| OGXs

