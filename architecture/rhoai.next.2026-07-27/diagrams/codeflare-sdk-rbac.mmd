graph TD
    subgraph "codeflare-sdk RBAC Model"
        direction TB

        Note["codeflare-sdk is a client library<br/>that runs with the calling user's permissions.<br/>It defines NO ClusterRoles, Roles, or RoleBindings."]

        subgraph "Runtime Identity"
            UserSA["Calling User / ServiceAccount<br/>(inherited from notebook/workbench)"]
        end

        subgraph "Required Permissions (caller must have)"
            K8sPerms["Kubernetes API Access<br/>- Authenticate to cluster<br/>- Read cluster resources"]
            RoutePerms["OpenShift Route Access<br/>- route.openshift.io: get, list<br/>- Discover Ray dashboard URLs"]
            RayPerms["Ray Dashboard Access<br/>- HTTP(S) to :8265<br/>- Job submit/stop/delete/status/logs"]
        end

        UserSA -->|"must possess"| K8sPerms
        UserSA -->|"must possess"| RoutePerms
        UserSA -->|"network access to"| RayPerms
    end

    subgraph "Test-Only (not shipped)"
        MinioSecret["minio-secret (Opaque)<br/>MinIO credentials<br/>e2e test only"]
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style UserSA fill:#4a90e2,stroke:#333,color:#fff
    style K8sPerms fill:#d5e8d4,stroke:#82b366
    style RoutePerms fill:#d5e8d4,stroke:#82b366
    style RayPerms fill:#d5e8d4,stroke:#82b366
    style MinioSecret fill:#f5f5f5,stroke:#999,stroke-dasharray: 5 5
