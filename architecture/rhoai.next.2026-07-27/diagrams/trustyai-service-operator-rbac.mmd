graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["trustyai-service-operator-<br/>controller-manager"]
        SA_Proxy["{name}-proxy"]
        SA_Service["{name}-service"]
        SA_AuthGroup["Group: system:authenticated"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_AuthDeleg["manager-auth-delegator"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_TLS["tls-profile-reader-binding"]
        CRB_TAS["tas-manager-rolebinding"]
        CRB_EH["evalhub-manager-rolebinding"]
        CRB_LMES["lmes-manager-rolebinding"]
        CRB_GORCH["gorch-manager-rolebinding"]
        CRB_NEMO["nemo-guardrails-manager-rolebinding"]
        CRB_EHColls["evalhub-collections-access-binding"]
        CRB_EHJobs["evalhub-jobs-writer-binding"]
        CRB_EHMLflow["evalhub-mlflow-access-binding"]
        CRB_LMUser["default-lmeval-user-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_Proxy["proxy-role<br/>tokenreviews: create<br/>subjectaccessreviews: create"]
        CR_TLS["tls-profile-reader<br/>apiservers: get"]
        CR_TAS["tas-manager-role"]
        CR_EH["evalhub-manager-role"]
        CR_LMES["lmes-manager-role"]
        CR_GORCH["gorch-manager-role"]
        CR_NEMO["nemo-guardrails-manager-role"]
        CR_EHColls["evalhub-collections-access<br/>collections: CRUD"]
        CR_EHJobs["evalhub-jobs-writer<br/>jobs: create,delete,list"]
        CR_EHMLflow["evalhub-mlflow-access<br/>experiments: CRUD"]
        CR_LMUser["lmeval-user-role<br/>lmevaljobs: full CRUD"]
        CR_EHAuthReviewer["evalhub-auth-reviewer-role<br/>tokenreviews: create<br/>subjectaccessreviews: create"]
    end

    subgraph TAS_Resources["TAS Manager Resources"]
        TAS_R1["trustyai.opendatahub.io<br/>TrustyAIService<br/>full CRUD + status + finalizers"]
        TAS_R2["apps/Deployments<br/>full CRUD + status + finalizers"]
        TAS_R3["core: ConfigMaps, PVCs,<br/>Pods, Secrets, Services<br/>full CRUD"]
        TAS_R4["serving.kserve.io<br/>InferenceService<br/>get, list, patch, update, watch"]
        TAS_R5["networking.istio.io<br/>DestinationRules, VirtualServices<br/>full CRUD"]
        TAS_R6["route.openshift.io/Routes<br/>full CRUD"]
    end

    subgraph EH_Resources["EvalHub Manager Resources"]
        EH_R1["trustyai.opendatahub.io<br/>EvalHubs, Evaluations,<br/>Providers, Collections<br/>full CRUD"]
        EH_R2["batch/Jobs<br/>delete, get, list, patch, watch"]
        EH_R3["kueue.x-k8s.io/Workloads<br/>get, list, patch, watch"]
        EH_R4["mlflow.kubeflow.org/Experiments<br/>create, get, list"]
        EH_R5["infrastructure.opendatahub.io<br/>HardwareProfiles<br/>get, list"]
    end

    subgraph LMES_Resources["LMEval Manager Resources"]
        LMES_R1["trustyai.opendatahub.io<br/>LMEvalJobs<br/>full CRUD + status + finalizers"]
        LMES_R2["core: Pods, Pods/exec<br/>create, delete, get, list, watch"]
        LMES_R3["core: PVs, Secrets<br/>get, list, watch"]
    end

    subgraph GORCH_Resources["GORCH Manager Resources"]
        GORCH_R1["trustyai.opendatahub.io<br/>GuardrailsOrchestrators<br/>full CRUD + status + finalizers"]
        GORCH_R2["serving.kserve.io<br/>ServingRuntimes<br/>get, list, watch"]
        GORCH_R3["serving.kserve.io<br/>InferenceServices<br/>get, list"]
    end

    subgraph NEMO_Resources["NemoGuardrails Manager Resources"]
        NEMO_R1["trustyai.opendatahub.io<br/>NemoGuardrails<br/>full CRUD + status + finalizers"]
        NEMO_R2["networking.istio.io<br/>EnvoyFilters<br/>full CRUD"]
        NEMO_R3["gateway.networking.k8s.io<br/>Gateways: get, list, watch"]
        NEMO_R4["mcp.kuadrant.io<br/>MCPGatewayExtensions<br/>get, list, watch"]
    end

    %% SA to CRB
    SA_CM -->|bound via| CRB_AuthDeleg
    SA_CM -->|bound via| CRB_Proxy
    SA_CM -->|bound via| CRB_TLS
    SA_CM -->|bound via| CRB_TAS
    SA_CM -->|bound via| CRB_EH
    SA_CM -->|bound via| CRB_LMES
    SA_CM -->|bound via| CRB_GORCH
