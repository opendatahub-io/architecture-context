graph LR
    vllmRocm["vllm-rocm<br/>Container Image"]

    %% Base Image Dependency
    vllmRocm -->|"FROM (build-time)"| BaseImage["RHAIIS Base Image<br/>vllm-rocm-rhel9:3.2.1"]

    %% Runtime Dependencies
    BaseImage -->|"bundles"| vLLM["vLLM Engine<br/>PagedAttention"]
    BaseImage -->|"bundles"| TGISAdapter["vllm_tgis_adapter<br/>Python module"]

    %% Hardware Dependency
    vllmRocm -->|"requires (runtime)"| ROCm["AMD ROCm GPU<br/>GPU acceleration"]

    %% Build Dependencies
    vllmRocm -->|"built by"| Konflux["Konflux CI/CD<br/>Tekton Pipelines"]
    Konflux -->|"synced from"| KonfluxCentral["konflux-central<br/>Pipeline definitions"]

    %% Deploying Platform Dependencies (runtime)
    KServe["KServe<br/>Serverless serving"] -.->|"deploys"| vllmRocm
    ModelMesh["ModelMesh<br/>Multi-model serving"] -.->|"deploys"| vllmRocm

    %% Runtime Resource Dependencies
    vllmRocm -->|"loads (runtime)"| ModelWeights["Model Weights<br/>Configured path"]

    style vllmRocm fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style BaseImage fill:#f5a623,stroke:#333,color:#fff
    style vLLM fill:#f5a623,stroke:#333,color:#fff
    style TGISAdapter fill:#f5a623,stroke:#333,color:#fff
    style ROCm fill:#9b59b6,stroke:#333,color:#fff
    style Konflux fill:#e67e22,stroke:#333,color:#fff
    style KonfluxCentral fill:#e67e22,stroke:#333,color:#fff
    style KServe fill:#999,stroke:#333,color:#fff
    style ModelMesh fill:#999,stroke:#333,color:#fff
    style ModelWeights fill:#e8e8e8,stroke:#333
