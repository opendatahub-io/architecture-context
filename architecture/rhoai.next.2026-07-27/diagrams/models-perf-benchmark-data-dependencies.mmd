graph LR
    MPBD["models-perf-benchmark-data<br/>(Data Init Container)"]

    %% Build-time dependencies
    MPBD -->|"build-time<br/>data ingestion"| ExtAPI["External Benchmark<br/>REST API<br/>(API_BASE_URL)"]

    %% Runtime dependencies (deployment context)
    ModelRegistryOp["model-registry-operator<br/>(opendatahub namespace)"] -->|"manages<br/>deployment"| ModelCatalog["model-catalog<br/>(odh-model-registries namespace)"]

    MPBD -->|"init container in"| ModelCatalog

    %% Build tooling
    MPBD -->|"packaged via"| ContainerBuild["Container Image<br/>Build Pipeline"]

    %% Data flow direction
    ExtAPI -.->|"benchmark data<br/>HTTPS"| MPBD

    %% Consumers
    ModelCatalog -->|"serves data to"| Dashboard["ODH Dashboard<br/>(model catalog UI)"]

    style MPBD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ExtAPI fill:#f5a623,stroke:#333,color:#fff
    style ModelRegistryOp fill:#7ed321,stroke:#333,color:#fff
    style ModelCatalog fill:#7ed321,stroke:#333,color:#fff
    style ContainerBuild fill:#999,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
