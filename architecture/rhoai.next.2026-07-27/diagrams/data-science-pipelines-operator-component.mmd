graph TB
    subgraph DSPO["Data Science Pipelines Operator"]
        Controller["DSPO Controller Manager<br/>(Deployment)<br/>Image: IMAGES_DSPO"]
        Webhook["Webhook Server<br/>Port: 9443"]
        Metrics["Metrics Endpoint<br/>Port: 8080"]
        Health["Health/Ready Probes<br/>Port: 8081"]
        Controller -->|registers| Webhook
        Controller -->|exposes| Metrics
        Controller -->|exposes| Health
    end

    User[Data Scientist / Admin] -->|creates| DSPACR["DataSciencePipelinesApplication CR<br/>(datasciencepipelinesapplications.opendatahub.io/v1)"]
    DSPACR -->|watched by| Controller

    subgraph ProvisionedResources["Dynamically Provisioned (via manifestival)"]
        ArgoCRDs["Argo Workflow CRDs<br/>(14 CRDs)"]
        ArgoRBAC["Argo RBAC<br/>(ClusterRoles, Bindings)"]
        ArgoSA["Argo ServiceAccount"]
    end

    Controller -->|provisions| ProvisionedResources

    subgraph OwnedResources["Owned Kubernetes Resources"]
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
        Deployments["Deployments"]
        Services["Services"]
        ServiceAccounts["ServiceAccounts"]
        PVCs["PersistentVolumeClaims"]
        NetworkPolicies["NetworkPolicies"]
        Routes["OpenShift Routes"]
        Roles["Roles / RoleBindings"]
    end

    Controller -->|creates/manages| OwnedResources

    subgraph PipelineCRDs["Pipeline CRDs"]
        PipelineCR["Pipeline<br/>(pipelines.kubeflow.org/v2beta1)"]
        PipelineVersionCR["PipelineVersion<br/>(pipelines.kubeflow.org/v2beta1)"]
        ScheduledWorkflowCR["ScheduledWorkflow<br/>(kubeflow.org/v1beta1)"]
        WorkflowCR["Workflow<br/>(argoproj.io/v1alpha1)"]
    end

    Controller -->|manages| PipelineCRDs

    Controller -->|depends on| K8sAPI["Kubernetes API<br/>6443/HTTPS"]
    Controller -->|watches| KServe["KServe InferenceService"]
    Controller -->|watches| MLflow["MLflow CR<br/>(mlflow.opendatahub.io)"]
    Controller -->|manages| KubeflowNB["Kubeflow Notebooks"]
    Controller -->|manages| Prometheus["prometheus-operator<br/>ServiceMonitors"]
    Controller -->|reads| OSImageStreams["OpenShift Image Streams"]

    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style DSPACR fill:#f5a623,stroke:#333
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style ScheduledWorkflowCR fill:#f5a623,stroke:#333
    style WorkflowCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style KubeflowNB fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style OSImageStreams fill:#e8e8e8,stroke:#333
