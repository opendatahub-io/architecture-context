graph TB
    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS / WebSocket<br/>TLS 1.2+<br/>ServiceAccount Token Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (ClusterIP services only)"]
        direction TB

        subgraph OperatorPod["rhods-operator Deployment"]
            direction LR
            WebhookSvr["Webhook Server<br/>9443/TCP<br/>HTTPS/TLS<br/>service-ca cert"]
            MetricsSvr["Metrics<br/>8443/TCP"]
            HealthSvr["Health Probes<br/>8081/TCP<br/>HTTP (plaintext)<br/>Unauthenticated"]
        end

        subgraph Services["Kubernetes Services"]
            WebhookSvc["rhods-operator-webhook-service<br/>ClusterIP 443/TCP → 9443/TCP"]
            MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP"]
        end
    end

    subgraph AdmissionWebhooks["ADMISSION WEBHOOKS (12 endpoints, TLS)"]
        direction LR
        Mutating["Mutating Webhooks<br/>/mutate-datasciencecluster-v1<br/>/mutate-datasciencecluster-v2<br/>/mutate-hardware-profile<br/>/mutate-prometheus-monitors<br/>/platform-connection-notebook"]
        Validating["Validating Webhooks<br/>/validate-datasciencecluster-v1<br/>/validate-datasciencecluster-v2<br/>/validate-dscinitialization-v1<br/>/validate-dscinitialization-v2<br/>/validate-dashboard-acceleratorprofile<br/>/validate-dashboard-hardwareprofile"]
        Conversion["Conversion Webhook<br/>/convert"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (cluster-scoped)"]
        ComponentCRDs["16 Component CRDs<br/>components.platform.opendatahub.io"]
        ServiceCRDs["3 Service CRDs<br/>services.platform.opendatahub.io"]
        CloudCRDs["3 Cloud Manager CRDs<br/>infrastructure.opendatahub.io"]
        TopCRDs["DSC, DSCI, Platform<br/>FeatureTracker, HardwareProfile"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        GatewayAPI["Gateway API<br/>Gateways, HTTPRoutes"]
        PromOp["prometheus-operator<br/>ServiceMonitors<br/>PodMonitors"]
        OSConfig["OpenShift Config<br/>APIServer, Auth<br/>ClusterVersion"]
        OAuth["OpenShift OAuth<br/>OAuthClient"]
    end

    subgraph Secret["TLS SECRET"]
        WebhookCert["redhat-ods-operator-<br/>controller-webhook-cert<br/>Type: kubernetes.io/tls<br/>Provisioner: service-ca"]
    end

    %% Flows
    K8sAPI -->|"Admission calls<br/>HTTPS/443 → 9443<br/>TLS (service-ca)<br/>API server identity"| WebhookSvc
    WebhookSvc -->|"forward"| WebhookSvr
    WebhookSvr --- Mutating
    WebhookSvr --- Validating
    WebhookSvr --- Conversion

    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    OperatorPod -->|"Controller watch<br/>TLS"| ManagedResources
    OperatorPod -->|"Controller watch<br/>TLS"| GatewayAPI
    OperatorPod -->|"Controller watch<br/>TLS"| PromOp
    OperatorPod -->|"API read"| OSConfig
    OperatorPod -->|"CRUD"| OAuth

    WebhookCert -.->|"mounted"| WebhookSvr

    K8sAPI -->|"probe<br/>HTTP/8081<br/>plaintext<br/>unauthenticated"| HealthSvr

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorms fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class K8sAPI controlplane
    class WebhookSvr,MetricsSvr,HealthSvr,WebhookSvc,MetricsSvc operatorms
    class Mutating,Validating,Conversion webhook
    class ComponentCRDs,ServiceCRDs,CloudCRDs,TopCRDs managed
    class GatewayAPI,PromOp,OSConfig,OAuth platform
    class WebhookCert secret
