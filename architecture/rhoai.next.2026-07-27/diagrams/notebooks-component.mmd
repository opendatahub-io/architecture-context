graph TB
    subgraph "Notebooks Component"
        direction TB

        subgraph "Notebook Image Variants"
            Minimal["minimal-notebook<br/>(Python, JupyterLab base)"]
            DataScience["datascience-notebook<br/>(scikit-learn, pandas, matplotlib)"]
            PyTorch["pytorch-notebook<br/>(PyTorch, CUDA)"]
            PyTorchLLM["pytorch-llmcompressor-notebook<br/>(PyTorch + LLMCompressor)"]
            TensorFlow["tensorflow-ubi9-python-3.12<br/>(TensorFlow, CUDA)"]
            ROCmPyTorch["rocm-pytorch-notebook<br/>(PyTorch, AMD ROCm)"]
            ROCmTF["rocm-tensorflow-ubi9-python-3.12<br/>(TensorFlow, AMD ROCm)"]
        end

        subgraph "Build Utilities (Konflux CI)"
            BuildInputs["buildinputs<br/>(Go executable)"]
            CheckPayload["check-payload<br/>(Go executable)"]
        end
    end

    subgraph "Image Layering Hierarchy"
        direction TB
        Minimal -->|extends| DataScience
        DataScience -->|extends| PyTorch
        DataScience -->|extends| TensorFlow
        DataScience -->|extends| ROCmPyTorch
        DataScience -->|extends| ROCmTF
        PyTorch -->|extends| PyTorchLLM
    end

    subgraph "Bundled Platform SDKs"
        KFP["Kubeflow Pipelines SDK<br/>(kfp 2.17.0)"]
        CodeFlare["CodeFlare SDK<br/>(codeflare-sdk 0.38.1)"]
        MLflow["MLflow SDK<br/>(mlflow 3.14.0)"]
        TrustyAI["TrustyAI SDK<br/>(trustyai 0.6.3)"]
        Elyra["ODH Elyra<br/>(odh-elyra 5.0.1)"]
        K8sClient["Kubernetes Client<br/>(kubernetes 35.0.0)"]
        OSClient["OpenShift Client<br/>(openshift-client 1.0.18)"]
    end

    DataScience ---|bundles| KFP
    DataScience ---|bundles| CodeFlare
    DataScience ---|bundles| MLflow
    DataScience ---|bundles| K8sClient
    DataScience ---|bundles| OSClient
    DataScience ---|bundles| Elyra

    subgraph "Runtime Platform (External)"
        NotebookController["RHOAI Notebook Controller"]
        OAuthProxy["OAuth Proxy Sidecar"]
        Dashboard["RHOAI Dashboard"]
    end

    NotebookController -->|manages lifecycle| Minimal
    NotebookController -->|injects| OAuthProxy
    Dashboard -->|creates/manages| NotebookController
    User[Data Scientist] -->|accesses via| Dashboard

