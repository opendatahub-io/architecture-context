graph TB
    subgraph Local["LOCAL WORKSTATION (User Environment)"]
        CLI["odh-cli (kubectl-odh)<br/>Local process<br/>No listening ports<br/>No inbound connections"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS + WSS<br/>TLS 1.2+<br/>RBAC enforcement"]

        subgraph OLMResources["OLM Resources"]
            Subscriptions["Subscriptions"]
            CSVs["ClusterServiceVersions"]
            OperatorGroups["OperatorGroups"]
        end

        subgraph CoreResources["Core Kubernetes Resources"]
            Namespaces["Namespaces (v1)"]
            Events["Events (v1)"]
            SSAR["SelfSubjectAccessReview<br/>(authorization/v1)"]
        end
    end

    %% Flows
    CLI -->|"HTTPS + WSS / 6443<br/>TLS 1.2+<br/>kubeconfig credential chain<br/>(bearer token / client cert / OIDC)"| K8sAPI

    K8sAPI --> Subscriptions
    K8sAPI --> CSVs
    K8sAPI --> OperatorGroups
    K8sAPI --> Namespaces
    K8sAPI --> Events
    K8sAPI --> SSAR

    %% Styling
    classDef local fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef resource fill:#f5f5f5,stroke:#999,stroke-width:1px

    class CLI local
    class K8sAPI apiserver
    class Subscriptions,CSVs,OperatorGroups,Namespaces,Events,SSAR resource
