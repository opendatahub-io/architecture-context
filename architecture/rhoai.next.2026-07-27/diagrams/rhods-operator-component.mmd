graph TB
    subgraph RhodsOperator["rhods-operator (Platform Operator)"]
        direction TB
        Controller["rhods-operator Controller<br/>Deployment"]
        Webhook["Webhook Server<br/>Port 9443/TLS"]
        Metrics["Metrics Service<br/>Port 8443"]
        HealthProbe["Health/Readiness<br/>Port 8081"]
        CloudMgrCLI["v2 CLI Tool<br/>Cloud Manager"]
    end

    subgraph TopLevelCRDs["Top-Level Orchestration CRDs"]
        DSC["DataScienceCluster<br/>v1 / v2"]
        DSCI["DSCInitialization<br/>v1 / v2"]
        Platform["Platform"]
    end

    subgraph ComponentCRDs["Component CRDs (components.platform.opendatahub.io/v1alpha1)"]
        direction LR
        Dashboard["Dashboard"]
        DSP["DataScience<br/>Pipelines"]
        Feast["FeastOperator"]
        Kserve["Kserve"]
        Kueue["Kueue"]
        MLflow["MLflowOperator"]
        ModelCtrl["ModelController"]
        ModelReg["ModelRegistry"]
        MaaS["ModelsAsService"]
        OGX["OGX"]
        Ray["Ray"]
        Spark["SparkOperator"]
        Trainer["Trainer"]
        TrainOp["TrainingOperator"]
        TrustyAI["TrustyAI"]
        Workbenches["Workbenches"]
    end

    subgraph ServiceCRDs["Service CRDs (services.platform.opendatahub.io/v1alpha1)"]
        Auth["Auth"]
        GatewayConfig["GatewayConfig"]
        Monitoring["Monitoring"]
    end

    subgraph CloudMgrCRDs["Cloud Manager CRDs (infrastructure.opendatahub.io/v1alpha1)"]
        AWS["AWSKubernetes<br/>Engine"]
        Azure["AzureKubernetes<br/>Engine"]
        CoreWeave["CoreWeave<br/>KubernetesEngine"]
    end

    subgraph AdmissionWebhooks["Admission Webhooks (12 total)"]
        ValidatingWH["Validating Webhooks<br/>DSC v1/v2, DSCI v1/v2<br/>AcceleratorProfile<br/>HardwareProfile"]
        MutatingWH["Mutating Webhooks<br/>DSC v1/v2, HardwareProfile<br/>PrometheusMonitors<br/>Notebook Connection"]
        ConversionWH["Conversion Webhook<br/>DataScienceCluster"]
    end

    %% Top-level orchestration
    DSC -->|"drives creation of"| ComponentCRDs
    DSCI -->|"initializes"| ServiceCRDs
    DSCI -->|"initializes"| ComponentCRDs

    %% Controller watches
    Controller -->|"reconciles"| TopLevelCRDs
    Controller -->|"manages lifecycle"| ComponentCRDs
    Controller -->|"manages lifecycle"| ServiceCRDs
    Controller -->|"manages lifecycle"| CloudMgrCRDs
    Controller -->|"serves"| Webhook
    Controller -->|"exposes"| Metrics

    %% Gateway chain
    GatewayConfig -->|"GatewaySpec"| Dashboard
    GatewayConfig -->|"GatewayOIDCSpec"| Feast
    Kserve -->|"OAuthProxy sidecar"| MaaS

    %% Cloud manager
    CloudMgrCLI -->|"manages"| CloudMgrCRDs

    %% External dependencies
    Controller -->|"watches"| K8sAPI["Kubernetes API<br/>6443/HTTPS"]
    Controller -->|"watches"| GatewayAPI["Gateway API"]
    Controller -->|"watches"| PromOp["prometheus-operator"]
    Controller -->|"reads"| OSConfig["OpenShift Cluster<br/>Configuration"]

