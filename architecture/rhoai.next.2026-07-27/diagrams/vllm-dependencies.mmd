graph LR
    vLLM["vLLM Inference Server<br/>(odh-vllm-cuda-rhel9)"]

    %% Base Image Dependency
    vLLM -->|"inherits runtime from"| BaseImage["rhaiis/vllm-cuda-rhel9:3.2.2<br/>registry.redhat.io"]

    %% Platform Dependencies (RHOAI)
    KServe["KServe / Model Serving Stack"] -->|"deploys & manages"| vLLM
    ServiceMesh["Service Mesh<br/>(Istio / OSSM)"] -->|"mTLS, AuthN/AuthZ,<br/>TLS termination"| vLLM

    %% Build Dependencies
    vLLM -.->|"built by"| Konflux["Konflux CI/CD<br/>Tekton Pipelines"]
    Konflux -->|"pipeline definitions"| KonfluxCentral["konflux-central<br/>red-hat-data-services"]

    %% Runtime Dependencies
    vLLM -->|"GPU inference"| GPU["NVIDIA GPU<br/>CUDA Runtime"]
    vLLM -->|"model loading<br/>(runtime config)"| ModelStorage["Model Storage<br/>(S3 / PVC / NFS)"]

    %% Platform Integration Points
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe
    DSPipelines["Data Science Pipelines"] -.->|"auto deploy"| KServe

    %% Styling
    style vLLM fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style BaseImage fill:#f5a623,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ServiceMesh fill:#7ed321,stroke:#333,color:#fff
    style Konflux fill:#999,stroke:#333,color:#fff
    style KonfluxCentral fill:#999,stroke:#333,color:#fff
    style GPU fill:#e8e8e8,stroke:#333
    style ModelStorage fill:#f5a623,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style DSPipelines fill:#7ed321,stroke:#333,color:#fff
