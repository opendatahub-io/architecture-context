graph TD
    subgraph ServiceAccounts["Service Accounts"]
        ArgoServerSA["argo-server<br/>ServiceAccount"]
        WFControllerSA["workflow-controller<br/>ServiceAccount"]
        ArgoExecSA["argoexec<br/>ServiceAccount"]
    end

    subgraph AuthEnforcement["Authentication & Authorization Enforcement"]
        Gatekeeper["Auth Gatekeeper<br/>(server/auth/gatekeeper.go)<br/>Per-request K8s client construction"]
        SSAR["SelfSubjectAccessReview<br/>(authorization.k8s.io/v1)"]
        OIDCAuth["OAuth2/OIDC SSO<br/>(go-oidc/v3, go-jose/v3)"]
    end

    subgraph K8sResources["Kubernetes API Resources Accessed"]
        subgraph ArgoprojCRDs["argoproj.io/v1alpha1"]
            Workflow["Workflow"]
            CronWorkflow["CronWorkflow"]
            WFTemplate["WorkflowTemplate"]
            ClusterWFTemplate["ClusterWorkflowTemplate<br/>(Cluster-scoped)"]
            WFTaskSet["WorkflowTaskSet"]
            WFTaskResult["WorkflowTaskResult"]
            WFEventBinding["WorkflowEventBinding"]
            WFArtifactGC["WorkflowArtifactGCTask"]
        end

        subgraph CoreResources["core/v1"]
            ConfigMap["ConfigMap<br/>create, update"]
            Pod["Pod<br/>create"]
            Secret["Secret<br/>create"]
        end

        subgraph PolicyResources["policy/v1"]
            PDB["PodDisruptionBudget<br/>create"]
        end

        subgraph CoordinationResources["coordination.k8s.io/v1"]
            Lease["Lease<br/>(leader election)"]
        end
    end

    subgraph ContainerSecurity["Container Security Context"]
        ArgoServerCtx["argo-server<br/>runAsNonRoot: true<br/>readOnlyRootFilesystem: true<br/>allowPrivilegeEscalation: false<br/>capabilities: drop ALL"]
        WFControllerCtx["workflow-controller<br/>runAsUser: 8737"]
        ArgoExecCtx["argoexec<br/>runAsUser: 2000"]
    end

    %% Auth flow
    ArgoServerSA --> Gatekeeper
    OIDCAuth --> Gatekeeper
    Gatekeeper -->|"validates permissions"| SSAR

    %% Resource access
    ArgoServerSA -->|"API/UI requests"| Workflow
    ArgoServerSA -->|"API/UI requests"| CronWorkflow
    ArgoServerSA -->|"API/UI requests"| WFTemplate
    ArgoServerSA -->|"API/UI requests"| ClusterWFTemplate

    WFControllerSA -->|"lifecycle mgmt"| Workflow
    WFControllerSA -->|"schedule"| CronWorkflow
    WFControllerSA -->|"create, update"| ConfigMap
    WFControllerSA -->|"create"| Pod
    WFControllerSA -->|"create"| Secret
    WFControllerSA -->|"create"| PDB
    WFControllerSA -->|"leader election"| Lease
    WFControllerSA -->|"manages"| WFTaskSet
    WFControllerSA -->|"reads"| WFTaskResult
    WFControllerSA -->|"manages"| WFArtifactGC

    ArgoExecSA -->|"reports results"| WFTaskResult

    %% Security context associations
    ArgoServerSA -.-> ArgoServerCtx
    WFControllerSA -.-> WFControllerCtx
    ArgoExecSA -.-> ArgoExecCtx

    %% Styling
    style ArgoServerSA fill:#4a90e2,color:#fff
    style WFControllerSA fill:#4a90e2,color:#fff
    style ArgoExecSA fill:#4a90e2,color:#fff
    style Gatekeeper fill:#e8744f,color:#fff
    style SSAR fill:#e8744f,color:#fff
    style OIDCAuth fill:#e8744f,color:#fff
    style Workflow fill:#f5a623
    style CronWorkflow fill:#f5a623
    style WFTemplate fill:#f5a623
    style ClusterWFTemplate fill:#f5a623
    style WFTaskSet fill:#f5a623
    style WFTaskResult fill:#f5a623
    style WFEventBinding fill:#f5a623
    style WFArtifactGC fill:#f5a623
    style ConfigMap fill:#7ed321
    style Pod fill:#7ed321
    style Secret fill:#7ed321
    style PDB fill:#7ed321
    style Lease fill:#7ed321
    style ArgoServerCtx fill:#ddd,stroke:#666
    style WFControllerCtx fill:#ddd,stroke:#666
    style ArgoExecCtx fill:#ddd,stroke:#666
