graph LR
    TGIS["Text Generation<br/>Inference Server<br/>(TGIS)"]

    %% Internal Platform Dependencies
    TGIS -->|"deployed as<br/>serving runtime"| KServe["KServe /<br/>ModelMesh"]
    TGIS -->|"model weights<br/>volume mount"| ModelStorage[("Model Storage<br/>(PVC)")]

    %% Core Runtime Dependencies
    TGIS -->|"deep learning<br/>framework"| PyTorch["PyTorch<br/>2.2.1+cu121"]
    TGIS -->|"model loading<br/>tokenization"| Transformers["transformers<br/>4.40.2"]
    TGIS -->|"GPU compute"| CUDA["CUDA Toolkit<br/>12.1.0"]
    TGIS -->|"tensor parallel<br/>multi-GPU"| NCCL["NCCL<br/>2.18.3"]

    %% Rust Dependencies
    TGIS -->|"gRPC framework<br/>(Rust router)"| Tonic["tonic<br/>0.11.0"]
    TGIS -->|"HTTP framework<br/>(Rust router)"| Axum["axum<br/>0.6.20"]
    TGIS -->|"fast tokenization<br/>(Rust)"| Tokenizers["tokenizers<br/>0.19.1"]

    %% Python Dependencies
    TGIS -->|"gRPC framework<br/>(Python server)"| gRPCio["grpcio<br/>1.62.2"]
    TGIS -->|"model weight<br/>serialization"| Safetensors["safetensors<br/>0.4.3"]

    %% Optional Dependencies
    TGIS -.->|"optimized attention<br/>(optional)"| FlashAttn["Flash Attention v2<br/>2.5.6"]
    TGIS -.->|"GPTQ 4-bit<br/>quantization"| AutoGPTQ["AutoGPTQ<br/>0.7.1"]

    %% Integration Points
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>3000/TCP /metrics"| TGIS
    OTel["OpenTelemetry<br/>Collector"] -.->|"gRPC OTLP<br/>tracing"| TGIS
    K8s["Kubernetes<br/>API"] -->|"health probes<br/>3000/TCP"| TGIS
    HFHub["HuggingFace Hub"] -.->|"model downloads<br/>HTTPS/443<br/>pre-deploy only"| TGIS

