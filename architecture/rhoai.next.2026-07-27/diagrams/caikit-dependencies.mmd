graph LR
    Caikit["Caikit Runtime<br/>(Application Service)"]

    %% Internal RHOAI Dependencies
    Caikit <-->|"unix socket<br/>mmesh.ModelRuntime/*<br/>mmesh.ModelMesh/*"| ModelMesh["ModelMesh<br/>(Sidecar)"]

    %% Core Framework Dependencies
    Caikit -->|"gRPC transport"| gRPC["grpcio >=1.35.0"]
    Caikit -->|"health checks"| gRPCHealth["grpcio-health-checking"]
    Caikit -->|"service reflection"| gRPCReflect["grpcio-reflection"]
    Caikit -->|"HTTP server"| FastAPI["FastAPI >=0.100"]
    Caikit -->|"SSE streaming"| SSE["sse-starlette"]
    Caikit -->|"protobuf serialization"| Protobuf["protobuf >=3.19.0"]
    Caikit -->|"proto generation"| PyToProto["py-to-proto >=0.5.0"]

    %% Observability Dependencies
    Caikit -->|"gRPC metrics"| PromClient["prometheus-client"]
    Caikit -->|"gRPC interceptor"| PyGRPCProm["py-grpc-prometheus"]
    Caikit -->|"tracing export"| OTelExporter["opentelemetry-exporter-otlp"]
    Caikit -->|"tracing SDK"| OTelSDK["opentelemetry-sdk"]

    %% Data Processing Dependencies
    Caikit -->|"data frames"| Pandas["pandas >=1.4.3"]
    Caikit -->|"numerics"| NumPy["numpy >=1.22.2"]
    Caikit -->|"columnar data"| PyArrow["pyarrow >=8.0.0"]
    Caikit -->|"images"| Pillow["pillow >=6.2.1"]
    Caikit -->|"Spark integration"| PySpark["pyspark >=3.3"]

    %% Configuration Dependencies
    Caikit -->|"config management"| AlchemyConfig["alchemy-config >=1.1.1"]
    Caikit -->|"structured logging"| AlchemyLogging["alchemy-logging >=1.3.2"]
    Caikit -->|"YAML parsing"| PyYAML["pyyaml >=6.0"]
    Caikit -->|"validation"| Pydantic["pydantic >=2.8.0"]

    %% Platform Integration
    KServe["KServe"] -->|"routes inference"| Caikit
    Istio["Istio"] -->|"TLS/mTLS<br/>traffic mgmt"| Caikit

    %% Runtime
    Caikit -->|"runtime"| Python["Python >=3.8"]

