graph TB
    subgraph CaikitPod["Serving Pod"]
        subgraph CaikitContainer["Caikit Runtime Container"]
            GRPCServer["RuntimeGRPCServer<br/>TCP Port (configurable)<br/>+ Unix Domain Socket"]
            HTTPServer["HTTP Server (FastAPI)<br/>(optional)"]

            subgraph Servicers["gRPC Servicers"]
                GlobalPredict["GlobalPredictServicer<br/>(Inference)"]
                GlobalTrain["GlobalTrainServicer<br/>(Training)"]
                ModelRuntimeImpl["ModelRuntimeServicerImpl<br/>(ModelMesh Sidecar)"]
                ModelTrainImpl["ModelTrainServicerImpl<br/>(Training Workflow)"]
                ModelMgmtImpl["ModelManagementServicerImpl"]
                TrainingMgmtImpl["TrainingManagementServicerImpl"]
                InfoSvc["InfoServicer"]
                HealthSvc["HealthServicer"]
            end

            subgraph ModelMgmt["Model Management"]
                ModelManager["ModelManager<br/>(Singleton Cache + Thread-Safe Locking)"]
                ModelFinder["ModelFinderBase<br/>(Pluggable)"]
                ModelInitializer["ModelInitializerBase<br/>(Pluggable)"]
                ModelTrainer["ModelTrainerBase<br/>(Pluggable)"]
            end

            Wrapper["CaikitRuntimeServerWrapper<br/>(Request Interception)"]
            Metrics["PromServerInterceptor<br/>(Prometheus Metrics)"]
        end

        subgraph MMeshContainer["ModelMesh Container"]
            ModelMesh["ModelMesh Sidecar"]
        end
    end

    %% Internal connections
    GRPCServer -->|registers| Servicers
    GRPCServer -->|intercepts via| Wrapper
    GRPCServer -->|metrics via| Metrics
    GlobalPredict -->|uses| ModelManager
    GlobalTrain -->|uses| ModelManager
    ModelRuntimeImpl -->|uses| ModelManager
    ModelManager -->|discovers via| ModelFinder
    ModelManager -->|loads via| ModelInitializer
    ModelManager -->|trains via| ModelTrainer

    %% ModelMesh communication
    ModelMesh -->|"unix socket<br/>mmesh.ModelRuntime/*"| GRPCServer
    GRPCServer -->|"unix socket<br/>mmesh.ModelMesh/*"| ModelMesh

    %% External
    Client["External Client"] -->|"gRPC (TLS/mTLS)"| GRPCServer
    Client -->|"HTTP (optional)"| HTTPServer
    ModelManager -->|"loads models from"| Storage["Model Storage<br/>(Directory / ZIP / Byte Stream)"]

    %% Styling
    style GRPCServer fill:#4a90e2,stroke:#333,color:#fff
    style HTTPServer fill:#4a90e2,stroke:#333,color:#fff
    style ModelManager fill:#4a90e2,stroke:#333,color:#fff
    style ModelMesh fill:#7ed321,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Storage fill:#f5a623,stroke:#333,color:#fff
    style Wrapper fill:#9b59b6,stroke:#333,color:#fff
    style Metrics fill:#9b59b6,stroke:#333,color:#fff
