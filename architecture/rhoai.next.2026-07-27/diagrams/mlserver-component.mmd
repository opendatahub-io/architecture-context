graph TB
    subgraph MLServer["MLServer Core"]
        direction TB
        CoreServer["mlserver<br/>(FastAPI + gRPC Server)"]
        GRPCServer["gRPC Server<br/>GRPCInferenceService<br/>ModelRepositoryService"]
        RESTServer["REST API<br/>FastAPI/uvicorn"]
        CoreServer --> GRPCServer
        CoreServer --> RESTServer

        subgraph Interceptors["gRPC Interceptor Chain"]
            LoggingInt["LoggingInterceptor<br/>(access logging)"]
            PromInt["PromServerInterceptor<br/>(Prometheus metrics)"]
            OTelInt["OpenTelemetry<br/>(distributed tracing)"]
        end
        GRPCServer --> LoggingInt
        GRPCServer --> PromInt
        GRPCServer --> OTelInt
    end

    subgraph Runtimes["Pluggable ML Runtime Backends"]
        direction TB
        sklearn["mlserver-sklearn<br/>(Scikit-Learn)"]
        xgboost["mlserver-xgboost<br/>(XGBoost)"]
        lightgbm["mlserver-lightgbm<br/>(LightGBM)"]
        onnx["mlserver-onnx<br/>(ONNX Runtime)"]
        mlflow["mlserver-mlflow<br/>(MLflow)"]
        huggingface["mlserver-huggingface<br/>(HuggingFace)"]
        alibidetect["mlserver-alibi-detect<br/>(Alibi-Detect)"]
        alibiexplain["mlserver-alibi-explain<br/>(Alibi-Explain)"]
        catboost["mlserver-catboost<br/>(CatBoost)"]
        mllib["mlserver-mllib<br/>(Spark MLlib)"]
    end

    CoreServer -->|loads| Runtimes

    %% Cross-dependencies
    alibiexplain -.->|depends on| sklearn
    alibiexplain -.->|depends on| xgboost
    alibiexplain -.->|depends on| lightgbm

    %% External interactions
    Client["Inference Client"] -->|gRPC / REST| CoreServer
    KubeRBACProxy["kube-rbac-proxy<br/>(sidecar)"] -->|auth proxy| GRPCServer

    CoreServer -->|export metrics| Prometheus["Prometheus"]
    CoreServer -->|export traces| OTLPCollector["OTLP Collector<br/>(gRPC)"]
    CoreServer -->|async messaging| Kafka["Kafka<br/>(aiokafka)"]

    %% Styling
    style CoreServer fill:#4a90e2,stroke:#333,color:#fff
    style GRPCServer fill:#4a90e2,stroke:#333,color:#fff
    style RESTServer fill:#4a90e2,stroke:#333,color:#fff
    style LoggingInt fill:#6bb5e0,stroke:#333
    style PromInt fill:#6bb5e0,stroke:#333
    style OTelInt fill:#6bb5e0,stroke:#333
    style KubeRBACProxy fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style OTLPCollector fill:#e8e8e8,stroke:#333
    style Kafka fill:#e8e8e8,stroke:#333
    style sklearn fill:#7ed321,stroke:#333
    style xgboost fill:#7ed321,stroke:#333
    style lightgbm fill:#7ed321,stroke:#333
    style onnx fill:#7ed321,stroke:#333
    style mlflow fill:#7ed321,stroke:#333
    style huggingface fill:#7ed321,stroke:#333
    style alibidetect fill:#7ed321,stroke:#333
    style alibiexplain fill:#7ed321,stroke:#333
    style catboost fill:#7ed321,stroke:#333
    style mllib fill:#7ed321,stroke:#333
    style Client fill:#f5a623,stroke:#333
