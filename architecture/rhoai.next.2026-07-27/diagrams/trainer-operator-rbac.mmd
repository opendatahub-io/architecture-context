graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(system namespace)"]
        SA_KF["kubeflow-trainer-controller-manager<br/>(cluster-scoped)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_KF["kubeflow-trainer-controller-manager"]
    end

    subgraph OperatorRoles["Operator ClusterRoles"]
        CR_Manager["manager-role<br/>(52+ rules, 16+ API groups)"]
        CR_KF["kubeflow-trainer-controller-manager"]
    end

    subgraph AggregatedRoles["Aggregated User-Facing ClusterRoles"]
        CR_Admin["training-admin<br/>(aggregated to admin)"]
        CR_Edit["training-edit<br/>(aggregated to edit)"]
        CR_View["training-view<br/>(aggregated to view)"]
    end

    subgraph PlatformRoles["Platform Component Roles"]
        CR_TrainerAdmin["trainer-admin-role"]
        CR_TrainerEditor["trainer-editor-role"]
        CR_TrainerViewer["trainer-viewer-role"]
    end

    subgraph TrainerResources["trainer.kubeflow.org Resources"]
        TrainJobs["TrainJobs"]
        TrainingRuntimes["TrainingRuntimes"]
        ClusterTrainingRuntimes["ClusterTrainingRuntimes"]
        StatusSubresources["*/status, */finalizers"]
    end

    subgraph PlatformResources["components.platform.opendatahub.io Resources"]
        Trainers["Trainers"]
        TrainersStatus["Trainers/status"]
    end

    subgraph K8sResources["Core Kubernetes Resources"]
        Deployments["apps/Deployments"]
        Services["core/Services"]
        ConfigMaps["core/ConfigMaps"]
        Secrets["core/Secrets"]
        RBAC_Res["rbac/ClusterRoles,<br/>ClusterRoleBindings,<br/>RoleBindings"]
        CRDs["apiextensions/CRDs"]
        Webhooks["admissionregistration/<br/>ValidatingWebhookConfigurations"]
        PodMonitors["monitoring.coreos.com/<br/>PodMonitors"]
        ImageStreamsRes["image.openshift.io/<br/>ImageStreams"]
    end

    subgraph WorkloadResources["Workload Resources"]
        JobSets["jobset.x-k8s.io/JobSets"]
        PodGroups["scheduling.volcano.sh &<br/>scheduling.x-k8s.io/PodGroups"]
        NetworkPolicies["networking.k8s.io/<br/>NetworkPolicies"]
    end

    %% Bindings
    SA_CM -->|bound via| CRB_Manager
    SA_KF -->|bound via| CRB_KF

    CRB_Manager -->|grants| CR_Manager
    CRB_KF -->|grants| CR_KF

    %% manager-role permissions
    CR_Manager -->|"full CRUD"| Deployments
    CR_Manager -->|"full CRUD"| Services
    CR_Manager -->|"full CRUD"| ConfigMaps
    CR_Manager -->|"full CRUD"| Secrets
    CR_Manager -->|"full CRUD"| RBAC_Res
    CR_Manager -->|"full CRUD"| CRDs
    CR_Manager -->|"full CRUD"| Webhooks
    CR_Manager -->|"full CRUD"| PodMonitors
    CR_Manager -->|"full CRUD"| ImageStreamsRes
    CR_Manager -->|"full CRUD"| TrainJobs
    CR_Manager -->|"full CRUD"| TrainingRuntimes
    CR_Manager -->|"full CRUD"| ClusterTrainingRuntimes
    CR_Manager -->|"get,list,patch,watch"| Trainers
    CR_Manager -->|"get,patch,update"| TrainersStatus

    %% kubeflow-trainer-controller-manager permissions
    CR_KF -->|"get,list,patch,update,watch"| TrainJobs
    CR_KF -->|"get,list,patch,update,watch"| TrainingRuntimes
    CR_KF -->|"get,list,patch,update,watch"| ClusterTrainingRuntimes
    CR_KF -->|"full CRUD"| JobSets
    CR_KF -->|"full CRUD"| PodGroups
    CR_KF -->|"full CRUD"| NetworkPolicies

    %% Aggregated roles
    CR_Admin -->|"full CRUD"| TrainJobs
    CR_Admin -->|"full CRUD"| TrainingRuntimes
    CR_Admin -->|"full CRUD"| ClusterTrainingRuntimes
    CR_Admin -->|"get"| StatusSubresources

    CR_Edit -->|"full CRUD"| TrainJobs
    CR_Edit -->|"get,list,watch"| TrainingRuntimes
    CR_Edit -->|"get,list,watch"| ClusterTrainingRuntimes
    CR_Edit -->|"get"| StatusSubresources

    CR_View -->|"get,list,watch"| TrainJobs
    CR_View -->|"get,list,watch"| TrainingRuntimes
    CR_View -->|"get,list,watch"| ClusterTrainingRuntimes
    CR_View -->|"get"| StatusSubresources

    %% Platform component roles
    CR_TrainerAdmin -->|"*"| Trainers
    CR_TrainerAdmin -->|"get"| TrainersStatus
    CR_TrainerEditor -->|"full CRUD"| Trainers
    CR_TrainerEditor -->|"get"| TrainersStatus
    CR_TrainerViewer -->|"get,list,watch"| Trainers
    CR_TrainerViewer -->|"get"| TrainersStatus

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_KF fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_KF fill:#f5a623,color:#fff
    style CR_Admin fill:#9b59b6,color:#fff
    style CR_Edit fill:#9b59b6,color:#fff
    style CR_View fill:#9b59b6,color:#fff
    style CR_TrainerAdmin fill:#e67e22,color:#fff
    style CR_TrainerEditor fill:#e67e22,color:#fff
    style CR_TrainerViewer fill:#e67e22,color:#fff
    style TrainJobs fill:#7ed321,color:#fff
    style TrainingRuntimes fill:#7ed321,color:#fff
    style ClusterTrainingRuntimes fill:#7ed321,color:#fff
    style Trainers fill:#7ed321,color:#fff
