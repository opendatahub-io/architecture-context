graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager<br/>(Namespace: kserve)"]
        SA_LLMISVC["$(llmisvc-serviceAccountName)<br/>(Namespace: kserve)"]
        SA_LocalModel["kserve-localmodel-controller-manager<br/>(Cluster-scoped)"]
        SA_LocalModelNode["kserve-localmodelnode-agent<br/>(Namespace: kserve)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Manager["kserve-manager-rolebinding<br/>(ClusterRoleBinding)"]
        RB_Proxy["kserve-proxy-rolebinding<br/>(ClusterRoleBinding)"]
        RB_LLMISVC["llmisvc-manager-rolebinding<br/>(Namespace: kserve)"]
        RB_LocalModel["kserve-localmodel-manager-rolebinding<br/>(ClusterRoleBinding)"]
        RB_LocalModelNode["kserve-localmodelnode-agent-rolebinding<br/>(Namespace: kserve)"]
        RB_LeaderElection["kserve-leader-election-rolebinding<br/>(Namespace: kserve)"]
        RB_LLMLeaderElection["llmisvc-leader-election-rolebinding<br/>(Namespace: kserve)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLMISVC["kserve-llmisvc-manager-role"]
        CR_LocalModel["kserve-localmodel-manager-role"]
        CR_LocalModelNode["kserve-localmodelnode-agent-role"]
        R_LeaderElection["kserve-leader-election-role<br/>(Role)"]
        R_LLMLeaderElection["llmisvc-leader-election-role<br/>(Role)"]
    end

    subgraph ManagerResources["kserve-manager-role Resources"]
        MR_Core["core<br/>configmaps, events, services,<br/>namespaces, pods, secrets,<br/>serviceaccounts"]
        MR_Admission["admissionregistration.k8s.io<br/>mutatingwebhookconfigurations,<br/>validatingwebhookconfigurations"]
        MR_Apps["apps<br/>deployments"]
        MR_Autoscaling["autoscaling<br/>horizontalpodautoscalers"]
        MR_Gateway["gateway.networking.k8s.io<br/>httproutes"]
        MR_Keda["keda.sh<br/>scaledobjects"]
        MR_Istio["networking.istio.io<br/>virtualservices"]
        MR_Ingress["networking.k8s.io<br/>ingresses"]
        MR_OTel["opentelemetry.io<br/>opentelemetrycollectors"]
        MR_Knative["serving.knative.dev<br/>services"]
        MR_KServe["serving.kserve.io<br/>inferenceservices, inferencegraphs,<br/>trainedmodels, servingruntimes,<br/>clusterservingruntimes, etc."]
    end

    subgraph LLMISVCResources["kserve-llmisvc-manager-role Resources"]
        LR_Core["core<br/>configmaps, pods, events,<br/>secrets, serviceaccounts, services"]
        LR_APIExt["apiextensions.k8s.io<br/>customresourcedefinitions"]
        LR_Gateway["gateway.networking.k8s.io<br/>gatewayclasses, gateways, httproutes"]
        LR_Inference["inference.networking.k8s.io<br/>inferencemodels, inferenceobjectives,<br/>inferencepools"]
        LR_InferenceX["inference.networking.x-k8s.io<br/>inferencepoolimports, inferencepools,<br/>inferencemodels"]
        LR_LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets"]
        LR_LLMD["llmd.ai<br/>variantautoscalings"]
        LR_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings, rolebindings, roles"]
        LR_KServe["serving.kserve.io<br/>llminferenceservices,<br/>llminferenceserviceconfigs"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        LMR_Core["core<br/>configmaps, nodes,<br/>persistentvolumeclaims,<br/>persistentvolumes"]
        LMR_KServe["serving.kserve.io<br/>localmodelcaches,<br/>localmodelnamespacecaches,<br/>localmodelnodes,<br/>localmodelnodegroups"]
    end

    subgraph LocalModelNodeResources["kserve-localmodelnode-agent-role Resources"]
        LMNR_Core["core<br/>configmaps, nodes,<br/>secrets, serviceaccounts"]
        LMNR_Batch["batch<br/>jobs"]
        LMNR_KServe["serving.kserve.io<br/>localmodelnodes,<br/>localmodelnodegroups,<br/>clusterstoragecontainers"]
    end

    %% SA → RoleBinding connections
    SA_Manager -->|bound via| RB_Manager
    SA_Manager -->|bound via| RB_Proxy
    SA_Manager -->|bound via| RB_LeaderElection
    SA_LLMISVC -->|bound via| RB_LLMISVC
    SA_LLMISVC -->|bound via| RB_LLMLeaderElection
    SA_LocalModel -->|bound via| RB_LocalModel
    SA_LocalModelNode -->|bound via| RB_LocalModelNode

    %% RoleBinding → Role connections
    RB_Manager -->|grants| CR_Manager
    RB_Proxy -->|grants| CR_Proxy
    RB_LLMISVC -->|grants| CR_LLMISVC
    RB_LocalModel -->|grants| CR_LocalModel
    RB_LocalModelNode -->|grants| CR_LocalModelNode
    RB_LeaderElection -->|grants| R_LeaderElection
    RB_LLMLeaderElection -->|grants| R_LLMLeaderElection

    %% Role → Resource connections
    CR_Manager -->|full CRUD| MR_Core
    CR_Manager -->|full CRUD| MR_Admission
    CR_Manager -->|full CRUD| MR_Apps
    CR_Manager -->|full CRUD| MR_Autoscaling
    CR_Manager -->|full CRUD| MR_Gateway
    CR_Manager -->|full CRUD| MR_Keda
    CR_Manager -->|full CRUD| MR_Istio
    CR_Manager -->|full CRUD| MR_Ingress
    CR_Manager -->|full CRUD| MR_OTel
    CR_Manager -->|full CRUD| MR_Knative
    CR_Manager -->|full CRUD| MR_KServe

    CR_LLMISVC -->|full CRUD| LR_Core
    CR_LLMISVC -->|read| LR_APIExt
    CR_LLMISVC -->|full CRUD| LR_Gateway
    CR_LLMISVC -->|full CRUD| LR_Inference
    CR_LLMISVC -->|full CRUD| LR_InferenceX
    CR_LLMISVC -->|full CRUD| LR_LWS
    CR_LLMISVC -->|full CRUD| LR_LLMD
    CR_LLMISVC -->|full CRUD| LR_RBAC
    CR_LLMISVC -->|full CRUD| LR_KServe

    CR_LocalModel -->|CRUD + watch| LMR_Core
    CR_LocalModel -->|CRUD + watch| LMR_KServe

    CR_LocalModelNode -->|CRUD + watch| LMNR_Core
    CR_LocalModelNode -->|full CRUD| LMNR_Batch
    CR_LocalModelNode -->|CRUD + watch| LMNR_KServe

    %% Styling
    style SA_Manager fill:#4a90e2,color:#fff
    style SA_LLMISVC fill:#4a90e2,color:#fff
    style SA_LocalModel fill:#4a90e2,color:#fff
    style SA_LocalModelNode fill:#4a90e2,color:#fff

    style CR_Manager fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_LLMISVC fill:#f5a623,color:#fff
    style CR_LocalModel fill:#f5a623,color:#fff
    style CR_LocalModelNode fill:#f5a623,color:#fff
    style R_LeaderElection fill:#f5a623,color:#fff
    style R_LLMLeaderElection fill:#f5a623,color:#fff

    style MR_KServe fill:#7ed321,color:#fff
    style LR_KServe fill:#7ed321,color:#fff
    style LMR_KServe fill:#7ed321,color:#fff
    style LMNR_KServe fill:#7ed321,color:#fff
