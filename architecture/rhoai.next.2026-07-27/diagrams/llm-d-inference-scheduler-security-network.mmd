graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Envoy["Envoy Proxy<br/>(ExtProc Client)"]
    end

    subgraph EPPService["EPP SERVICE (llm-d-inference-scheduler)"]
        direction TB

        subgraph InboundGRPC["gRPC Services"]
            ExtProc["ExternalProcessor<br/>gRPC<br/>Optional TLS<br/>Auth: None"]
            Health["Health<br/>gRPC<br/>Optional TLS<br/>Auth: None"]
        end

        subgraph InboundHTTP["HTTP Services"]
            Metrics["/metrics<br/>HTTP<br/>Auth: Optional<br/>K8s Token Review"]
            Root["/<br/>HTTP<br/>Auth: Unknown"]
        end

        subgraph ControllerLayer["Kubernetes Controllers"]
            IMRCtrl["InferenceModelRewrite<br/>Controller"]
            IOCtrl["InferenceObjective<br/>Controller"]
            IPCtrl["InferencePool<br/>Controller"]
            PodCtrl["Pod Controller"]
        end

        subgraph CRDLayer["CRDs (llm-d.ai)"]
            EPC["EndpointPickerConfig<br/>v1alpha1"]
            IMR["InferenceModelRewrite<br/>v1alpha2"]
            IObjCRD["InferenceObjective<br/>v1alpha2"]
        end
    end

    subgraph Outbound["OUTBOUND SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>Auth: ServiceAccount"]
        OTELCol["OpenTelemetry Collector<br/>4317/TCP (default)<br/>OTLP/gRPC<br/>Default: Insecure<br/>Auth: None"]
        ModelEPs["Model-Serving Endpoints<br/>HTTP Metrics Scrape<br/>Encryption: Unknown<br/>Auth: Unknown"]
    end

    subgraph Libraries["IN-PROCESS LIBRARIES"]
        GatewayExt["gateway-api-inference-<br/>extension<br/>(Go library)"]
        KVCache["llm-d-kv-cache<br/>(Go library)"]
    end

    %% Inbound flows
    Envoy -->|"gRPC ExtProc<br/>Optional TLS<br/>No App Auth"| ExtProc

    %% Outbound flows
    ControllerLayer -->|"REST+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    EPPService -->|"OTLP/gRPC<br/>Default Insecure<br/>No Auth"| OTELCol
    EPPService -->|"HTTP Scrape<br/>Unknown Encryption"| ModelEPs

    %% Library dependencies
    EPPService -.->|"in-process"| GatewayExt
    EPPService -.->|"in-process"| KVCache

    %% Internal CRD watches
    IMRCtrl -.->|watches| IMR
    IOCtrl -.->|watches| IObjCRD
    IPCtrl -.->|watches K8s API| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef eppservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef grpcservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef httpservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef crd fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef outbound fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef library fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Envoy external
    class ExtProc,Health grpcservice
    class Metrics,Root httpservice
    class IMRCtrl,IOCtrl,IPCtrl,PodCtrl controller
    class EPC,IMR,IObjCRD crd
    class K8sAPI,OTELCol,ModelEPs outbound
    class GatewayExt,KVCache library
