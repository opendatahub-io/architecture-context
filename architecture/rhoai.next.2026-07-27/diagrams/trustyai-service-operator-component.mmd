graph TB
    subgraph Operator["trustyai-service-operator"]
        direction TB
        Manager["manager<br/>(Go executable)"]
        Driver["driver<br/>(FIPS-enabled Go executable)"]

        subgraph Controllers["Controllers (flag-driven: --enable-services)"]
            direction LR
            subgraph TAS_Controllers["TAS Service Controllers"]
                TrustyAICtrl["TrustyAI Controller"]
                TrustyAISvcCtrl["TrustyAIService Controller"]
            end

            subgraph EVALHUB_Controllers["EvalHub Service Controllers"]
                EvalHubCtrl["EvalHub Controller"]
                JobCtrl["Job Controller"]
                WorkloadCtrl["Workload Controller"]
            end

            subgraph LMEval_Controllers["LMEval Controllers"]
                LMEvalJobCtrl["LMEvalJob Controller"]
            end

            subgraph Guardrails_Controllers["Guardrails Controllers"]
                GorchCtrl["GuardrailsOrchestrator Controller"]
                NemoCtrl["NemoGuardrails Controller"]
            end
        end

        WebhookServer["Webhook Server<br/>:9443/TCP<br/>(conditional)"]
    end

    Manager -->|starts| Controllers
    Manager -->|starts conditionally| WebhookServer

    %% CRDs
    TrustyAICR["TrustyAI CR<br/>(Cluster-scoped)"]
    TrustyAISvcCR["TrustyAIService CR<br/>(Namespaced)"]
    EvalHubCR["EvalHub CR<br/>(Namespaced)"]
    LMEvalJobCR["LMEvalJob CR<br/>(Namespaced)"]
    GorchCR["GuardrailsOrchestrator CR<br/>(Namespaced)"]
    NemoCR["NemoGuardrails CR<br/>(Namespaced)"]

    %% CR to Controller mappings
    TrustyAICR -->|watched by| TrustyAICtrl
    TrustyAISvcCR -->|watched by| TrustyAISvcCtrl
    EvalHubCR -->|watched by| EvalHubCtrl
    LMEvalJobCR -->|watched by| LMEvalJobCtrl
    GorchCR -->|watched by| GorchCtrl
    NemoCR -->|watched by| NemoCtrl

    %% Created resources
    TrustyAISvcCtrl -->|creates| TASDeployment["TrustyAI Service<br/>Deployment + kube-rbac-proxy"]
    TrustyAISvcCtrl -->|creates| TASRoute["OpenShift Route"]
    EvalHubCtrl -->|creates| EHDeployment["EvalHub Deployment"]
    EvalHubCtrl -->|creates| EHService["EvalHub Service"]
    GorchCtrl -->|creates| GorchDeployment["Guardrails Deployment"]
    NemoCtrl -->|creates| NemoDeployment["NemoGuardrails Deployment"]
    LMEvalJobCtrl -->|creates| LMEvalPod["LMEval Pods"]
    LMEvalPod -->|runs| Driver

    %% External dependencies
    TrustyAISvcCtrl -->|watches| KServeIS["KServe InferenceService"]
    GorchCtrl -->|watches| KServeIS
    GorchCtrl -->|reads| ServingRT["ServingRuntime"]
    NemoCtrl -->|reads| GatewayAPI["Gateway API"]
    EvalHubCtrl -->|integrates| Kueue["Kueue Workloads"]
    EvalHubCtrl -->|integrates| MLflow["MLflow Experiments"]
    EvalHubCtrl -->|reads| HWProfile["HardwareProfile CR"]

    %% Monitoring
    EvalHubCtrl -->|creates| ServiceMonitor["ServiceMonitor"]
    TrustyAISvcCtrl -->|creates| ServiceMonitor

    %% Styling
    style Operator fill:#e8f4f8,stroke:#2980b9,stroke-width:2px
    style Manager fill:#4a90e2,color:#fff
    style Driver fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style TrustyAICR fill:#f5a623
    style TrustyAISvcCR fill:#f5a623
    style EvalHubCR fill:#f5a623
    style LMEvalJobCR fill:#f5a623
    style GorchCR fill:#f5a623
    style NemoCR fill:#f5a623
    style KServeIS fill:#7ed321
    style ServingRT fill:#7ed321
    style GatewayAPI fill:#7ed321
    style Kueue fill:#7ed321
    style MLflow fill:#7ed321
    style HWProfile fill:#7ed321
    style ServiceMonitor fill:#999
