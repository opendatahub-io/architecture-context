graph TB
    subgraph "vllm-rocm Container Image"
        subgraph "Runtime Stack (inherited from RHAIIS base)"
            vLLM["vLLM Engine<br/>PagedAttention<br/>ROCm GPU Backend"]
            Adapter["vllm_tgis_adapter<br/>Python Module"]
            Adapter -->|wraps| vLLM
        end

        subgraph "Network Interfaces"
            HTTP["HTTP API<br/>Port 8000<br/>OpenAI-compatible"]
            gRPC["gRPC API<br/>Port 8033<br/>TGIS-compatible"]
        end

        Adapter -->|serves| HTTP
        Adapter -->|serves| gRPC
    end

    subgraph "Build Pipeline"
        Dockerfile["Dockerfile.konflux.rocm<br/>Single-stage build"]
        BaseImage["RHAIIS Base Image<br/>vllm-rocm-rhel9:3.2.1"]
        Konflux["Konflux CI/CD"]
        Dockerfile -->|FROM| BaseImage
        Konflux -->|builds| Dockerfile
    end

    subgraph "Deploying Platform (external)"
        KServe["KServe"]
        ModelMesh["ModelMesh"]
    end

    Client["Inference Client"] -->|POST /v1/...<br/>HTTP| HTTP
    Client -->|gRPC call| gRPC
    vLLM -->|loads| ModelWeights["Model Weights<br/>(configured at deploy time)"]
    GPU["AMD ROCm GPU"] -.->|acceleration| vLLM
    KServe -.->|deploys & manages| vLLM
    ModelMesh -.->|deploys & manages| vLLM

    style vLLM fill:#4a90e2,stroke:#333
    style Adapter fill:#4a90e2,stroke:#333
    style HTTP fill:#7ed321,stroke:#333
    style gRPC fill:#7ed321,stroke:#333
    style Dockerfile fill:#f5a623,stroke:#333
    style BaseImage fill:#f5a623,stroke:#333
    style Konflux fill:#f5a623,stroke:#333
    style GPU fill:#9b59b6,stroke:#333
    style ModelWeights fill:#e8e8e8,stroke:#333
    style KServe fill:#999,stroke:#333
    style ModelMesh fill:#999,stroke:#333
    style Client fill:#f9f9f9,stroke:#333
