graph TD
    subgraph "Authentication Model"
        direction TB
        OAuthProxy["OAuth Proxy Sidecar<br/>(injected by Notebook Controller)"]
        OAuthProvider["OpenShift OAuth Server"]
        OAuthProxy -->|"validates tokens with"| OAuthProvider
    end

    subgraph "Notebook Pod Identity"
        direction TB
        SA["ServiceAccount<br/>{notebook-name}<br/>(per-notebook, created by controller)"]
        SAToken["Mounted SA Token<br/>/var/run/secrets/kubernetes.io/serviceaccount"]
        SA -->|"auto-mounts"| SAToken
    end

    subgraph "RBAC Note"
        direction TB
        Note["No RBAC roles defined<br/>in this repository"]
        NoteDetail["RBAC is managed by:<br/>- RHOAI Notebook Controller<br/>- RHOAI Dashboard<br/>- Cluster Admin policies"]
    end

    subgraph "Outbound Credential Types"
        direction TB
        SAAuth["ServiceAccount Token<br/>(auto-mounted)"]
        UserCreds["User-Provided Credentials<br/>(configured in notebook)"]
    end

    subgraph "Platform Service Access"
        K8sAPI["Kubernetes API<br/>Auth: SA Token"]
        KFP["Kubeflow Pipelines<br/>Auth: SA Token"]
        CodeFlare["CodeFlare / Ray<br/>Auth: SA Token"]
    end

    subgraph "External Service Access"
        S3["S3-Compatible Storage<br/>Auth: User Credentials (boto3)"]
        MLflow["MLflow Tracking<br/>Auth: User Credentials"]
    end

    subgraph "CI-Only Secrets (not in runtime images)"
        RENOVATE["RENOVATE_TOKEN<br/>(env var, CI scripts)"]
        JIRA_API["JIRA_API_TOKEN<br/>(env var, CI scripts)"]
        JIRA["JIRA_TOKEN<br/>(env var, CI scripts)"]
        JIRA_OAUTH["JIRA_OAUTH_CLIENT_SECRET<br/>(env var, CI scripts)"]
    end

    SAAuth -->|"used for"| K8sAPI
    SAAuth -->|"used for"| KFP
    SAAuth -->|"used for"| CodeFlare
    UserCreds -->|"used for"| S3
    UserCreds -->|"used for"| MLflow

    style OAuthProxy fill:#f8cecc,stroke:#b85450
    style OAuthProvider fill:#f8cecc,stroke:#b85450
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style SAToken fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff2cc,stroke:#d6b656
    style NoteDetail fill:#fff2cc,stroke:#d6b656
    style SAAuth fill:#d5e8d4,stroke:#82b366
    style UserCreds fill:#ffe6cc,stroke:#d79b00
    style K8sAPI fill:#d5e8d4,stroke:#82b366
    style KFP fill:#d5e8d4,stroke:#82b366
    style CodeFlare fill:#d5e8d4,stroke:#82b366
    style S3 fill:#ffe6cc,stroke:#d79b00
    style MLflow fill:#ffe6cc,stroke:#d79b00
    style RENOVATE fill:#e8e8e8,stroke:#999
    style JIRA_API fill:#e8e8e8,stroke:#999
    style JIRA fill:#e8e8e8,stroke:#999
    style JIRA_OAUTH fill:#e8e8e8,stroke:#999
