graph TD
    subgraph "ogx-distribution RBAC Model"
        direction TB

        Note["Note: ogx-distribution defines NO Kubernetes<br/>RBAC resources (no CRDs, ClusterRoles, or RoleBindings).<br/>It is a container image, not an operator.<br/>Deployment managed by RHOAI platform operator."]

        subgraph "Application-Level Access Control (Optional)"
            direction TB

            OAuth2["OAuth2/JWKS<br/>Token Validation<br/>(disabled by default)"]

            subgraph "Owner-Based Access Policy"
                direction LR
                Unauthenticated["Unauthenticated Users"]
                Authenticated["Authenticated Users"]
                Owner["Resource Owner"]
            end

            subgraph "Allowed Operations"
                direction LR
                ReadUnowned["READ<br/>unowned resources"]
                Create["CREATE<br/>new resources<br/>(become owner)"]
                UpdateDelete["UPDATE / DELETE<br/>owned resources"]
            end

            Unauthenticated -->|allowed| ReadUnowned
            Authenticated -->|allowed| ReadUnowned
            Authenticated -->|allowed| Create
            Owner -->|allowed| ReadUnowned
            Owner -->|allowed| Create
            Owner -->|allowed| UpdateDelete

            OAuth2 -->|validates token| Authenticated
            OAuth2 -->|validates token| Owner
        end

        subgraph "Secret Management"
            direction TB
            EntrypointSH["entrypoint.sh"]
            K8sMounts["Kubernetes<br/>Secret Mounts"]
            EnvVars["Environment Variables<br/>(18 _FILE variants)"]

            K8sMounts -->|"file contents"| EntrypointSH
            EntrypointSH -->|"resolves + exports"| EnvVars
        end
    end

    subgraph "External RBAC (Platform Operator)"
        RHOAIOp["RHOAI Platform Operator<br/>(manages deployment,<br/>service accounts, RBAC)"]
    end

    RHOAIOp -.->|"provides K8s RBAC<br/>for ogx-distribution pod"| Note

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style OAuth2 fill:#e74c3c,color:#fff
    style Unauthenticated fill:#f9f9f9,stroke:#999
    style Authenticated fill:#4a90e2,color:#fff
    style Owner fill:#7ed321,color:#fff
    style ReadUnowned fill:#d5e8d4,stroke:#82b366
    style Create fill:#dae8fc,stroke:#6c8ebf
    style UpdateDelete fill:#ffe6cc,stroke:#d79b00
    style EntrypointSH fill:#4a90e2,color:#fff
    style K8sMounts fill:#f5a623,color:#fff
    style EnvVars fill:#f5a623,color:#fff
    style RHOAIOp fill:#7ed321,color:#fff
