graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        KServe["KServe v2<br/>Inference Source<br/>CloudEvent payloads"]
        ModelMesh["ModelMesh<br/>Partial input/output<br/>payloads"]
        PrometheusExt["Prometheus<br/>Metrics Scraper"]
    end

    subgraph IngressZone["INGRESS (Expected External Enforcement)"]
        direction TB
        IngressNote["⚠ No ingress defined in manifests<br/>Auth expected via OpenShift Route,<br/>Istio sidecar, or API gateway<br/><br/>⚠ NO AUTH MIDDLEWARE<br/>at application level"]
    end

    subgraph Application["APPLICATION (TrustyAI Service)"]
        direction TB

        subgraph FastAPI["FastAPI Application<br/>Uvicorn / Hypercorn ASGI<br/>87 HTTP Endpoints — ALL UNPROTECTED"]
            direction TB

            Ingestion["Ingestion Endpoints (3)<br/>POST /<br/>POST /consumer/kserve/v2<br/>POST /data/upload"]

            Metrics["Metrics Endpoints (67)<br/>Fairness: SPD, DIR (24)<br/>Drift: KS, JS, MMD, etc. (30)<br/>Batch Mean (7)<br/>Identity (6)"]

            Explainers["Explainer Endpoints (6)<br/>LIME, SHAP, CF, PDP,<br/>TSSaliency<br/>ALL return 501"]

            MetadataEP["Metadata Endpoints (8)<br/>GET /info<br/>/info/names, /info/tags"]

            HealthEP["Health & Metrics (3)<br/>GET /q/health/live<br/>GET /q/health/ready<br/>GET /q/metrics"]
        end

        StorageLayer["StorageInterface<br/>Abstraction Layer"]
    end

    subgraph StorageBackends["STORAGE BACKENDS"]
        PVC["PVC Storage (Default)<br/>h5py / HDF5 files<br/>Filesystem permissions<br/>Encryption: StorageClass dependent"]
        MariaDB["MariaDB (Optional)<br/>Wire protocol<br/>Auth: DATABASE_PASSWORD<br/>Encryption: Server config dependent"]
    end

    subgraph SecretsBox["SECRETS"]
        DBPass["DATABASE_PASSWORD<br/>(env var, runtime)"]
        QuarkusPass["QUARKUS_DATASOURCE_PASSWORD<br/>(env var, runtime)"]
    end

    %% External flows
    KServe -->|"HTTP/HTTPS<br/>Configurable encryption<br/>No app-level auth<br/>CloudEvent + ce-id header"| IngressNote
    ModelMesh -->|"HTTP/HTTPS<br/>Configurable encryption<br/>No app-level auth<br/>Partial payloads"| IngressNote
    PrometheusExt -->|"HTTP/HTTPS<br/>GET /q/metrics<br/>No app-level auth"| IngressNote

    %% Ingress to application
    IngressNote -->|"No TLS termination<br/>defined in manifests"| Ingestion
    IngressNote --> Metrics
    IngressNote --> MetadataEP
    IngressNote --> HealthEP
    IngressNote --> Explainers

    %% Internal flows
    Ingestion --> StorageLayer
    Metrics --> StorageLayer
    MetadataEP --> StorageLayer

    StorageLayer --> PVC
    StorageLayer --> MariaDB

    %% Secrets
    DBPass -.->|"credential"| MariaDB
    QuarkusPass -.->|"credential"| MariaDB

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef secret fill:#e6ccff,stroke:#9966cc,stroke-width:2px

    class KServe,ModelMesh,PrometheusExt external
    class IngressNote warning
    class Ingestion,Metrics,Explainers,MetadataEP,HealthEP,StorageLayer application
    class PVC,MariaDB storage
    class DBPass,QuarkusPass secret
