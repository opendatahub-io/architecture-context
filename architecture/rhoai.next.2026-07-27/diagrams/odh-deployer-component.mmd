graph TB
    subgraph "odh-deployer (Deployment Orchestrator)"
        DeployScript["deploy.sh<br/>Bash Orchestrator"]

        subgraph "Namespace Provisioning"
            NS_Apps["redhat-ods-applications"]
            NS_Mon["redhat-ods-monitoring"]
            NS_NB["rhods-notebooks"]
        end

        subgraph "KfDef Deployment"
            KfDef_Dashboard["KfDef: Dashboard"]
            KfDef_NBC["KfDef: Notebook Controller"]
            KfDef_MM["KfDef: Model Mesh"]
            KfDef_DSPO["KfDef: Data Science Pipelines Operator"]
            KfDef_NB["KfDef: Notebooks"]
            KfDef_Mon["KfDef: Monitoring"]
            KfDef_Anaconda["KfDef: Anaconda"]
        end

        subgraph "Monitoring Stack"
            Prometheus["Prometheus<br/>(with init container)"]
            Alertmanager["Alertmanager"]
            OAuthProxy["OAuth Proxy Sidecars"]
        end

        subgraph "Configuration Resources"
            ConsoleLink["ConsoleLink"]
            DashboardConfig["OdhDashboardConfig"]
            NetworkPolicies["Network Policies"]
            PodSecurityRBAC["Pod Security RBAC"]
        end
    end

    subgraph "Deployment Topology Detection"
        OSD_Check{"addon-managed-odh-catalog<br/>CatalogSource exists?"}
        OSD_Path["OSD Managed Path"]
        SelfManaged_Path["Self-Managed Path"]
    end

    DeployScript -->|"1. creates"| NS_Apps
    DeployScript -->|"1. creates"| NS_Mon
    DeployScript -->|"1. creates"| NS_NB
    DeployScript -->|"2. applies"| PodSecurityRBAC
    DeployScript -->|"3. applies"| KfDef_Dashboard
    DeployScript -->|"3. applies"| KfDef_NBC
    DeployScript -->|"3. applies"| KfDef_MM
    DeployScript -->|"3. applies"| KfDef_DSPO
    DeployScript -->|"3. applies"| KfDef_NB
    DeployScript -->|"3. applies"| KfDef_Mon
    DeployScript -->|"3. applies"| KfDef_Anaconda
    DeployScript -->|"4. deploys"| Prometheus
    DeployScript -->|"4. deploys"| Alertmanager
    DeployScript -->|"5. applies"| ConsoleLink
    DeployScript -->|"5. applies"| DashboardConfig
    DeployScript -->|"5. applies"| NetworkPolicies
    DeployScript -->|"detects"| OSD_Check
    OSD_Check -->|"yes"| OSD_Path
    OSD_Check -->|"no"| SelfManaged_Path

    OSD_Path -->|configures| PagerDuty["PagerDuty"]
    OSD_Path -->|configures| DMS["Dead Man's Snitch"]
    OSD_Path -->|configures| SMTP["SMTP Alerting"]
    SelfManaged_Path -->|creates| RhodsAdmins["rhods-admins Group"]

    Prometheus -->|scrapes| OAuthProxy
    Alertmanager -->|routes to| PagerDuty
    Alertmanager -->|routes to| DMS
    Alertmanager -->|routes to| SMTP

    KubeflowOp["KubeFlow Operator"] -->|reconciles| KfDef_Dashboard
    KubeflowOp -->|reconciles| KfDef_NBC
    KubeflowOp -->|reconciles| KfDef_MM
    KubeflowOp -->|reconciles| KfDef_DSPO

    style DeployScript fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style Alertmanager fill:#e6522c,stroke:#333,color:#fff
    style OSD_Check fill:#f5a623,stroke:#333
    style OSD_Path fill:#ffe6cc,stroke:#d79b00
    style SelfManaged_Path fill:#d5e8d4,stroke:#82b366
    style KubeflowOp fill:#999,stroke:#333,color:#fff
    style PagerDuty fill:#06ac38,stroke:#333,color:#fff
    style DMS fill:#06ac38,stroke:#333,color:#fff
    style SMTP fill:#06ac38,stroke:#333,color:#fff
