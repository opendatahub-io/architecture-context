graph LR
    VLLMSpyre["vllm-spyre<br/>Container Image"]

    %% Base Image Dependency
    VLLMSpyre -->|"base image"| BaseImage["rhaiis/vllm-spyre-rhel9:3.2.2<br/>RHEL 9 / x86_64"]

    %% Upstream Source Dependencies
    VLLMSpyre -->|"upstream fork"| VLLMUpstream["vLLM<br/>nm/midstream-cuda-v0.9.1.0"]
    VLLMSpyre -->|"adapter module"| TGISAdapter["vllm-tgis-adapter"]

    %% Hardware Dependency
    VLLMSpyre -->|"accelerator"| SpyreHW["IBM Spyre<br/>Accelerator Hardware"]

    %% Runtime Dependencies (external)
    VLLMSpyre -->|"model download<br/>HTTPS/443"| HFHub["Hugging Face Hub"]
    VLLMSpyre -.->|"alternative model source"| Volume["Pre-mounted Volume<br/>(PVC)"]

    %% Platform Dependencies (managed externally)
    KServe["KServe /<br/>ServingRuntime"] -->|"deploys & manages"| VLLMSpyre
    ServiceMesh["Service Mesh /<br/>Istio"] -.->|"sidecar, mTLS"| VLLMSpyre

    %% Build Pipeline
    Konflux["Konflux Pipeline"] -->|"builds image via<br/>Dockerfile.konflux.spyre"| VLLMSpyre

    %% Integration Points (consumers)
    VLLMSpyre -.->|"HTTP :8000"| ODHDashboard["ODH Dashboard /<br/>RHOAI Workbench"]
    VLLMSpyre -.->|"gRPC :8033"| DSPipelines["Data Science<br/>Pipelines"]

