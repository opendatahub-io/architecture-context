graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / kubectl"]
    end

    subgraph K8sControl["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforcement"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (Trusted)"]
        direction TB

        subgraph ControllerPod["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>non-root | no-priv-esc | seccomp:RuntimeDefault | drop:ALL"]
            WebhookServer["Webhook Server<br/>:9443/TCP<br/>TLS (cluster profile)<br/>K8s admission auth"]
            HealthProbes["Health Probes<br/>:8081/TCP<br/>Unauthenticated"]
            MetricsPort["Metrics<br/>:8080/TCP"]
            RuntimePlugins["Runtime Plugins<br/>JobSet | MPI | CoScheduling | Volcano"]
        end

        subgraph Services["ClusterIP Services"]
            SvcWebhook["443/TCP → 9443<br/>(webhook-server)"]
            SvcMetrics["8080/TCP → 8080<br/>(monitoring-port)"]
        end
    end

    subgraph WatchedResources["KUBERNETES RESOURCES (Watch/CRUD)"]
        direction TB
        CRDs["TrainJob | TrainingRuntime<br/>ClusterTrainingRuntime<br/>trainer.kubeflow.org/v1alpha1"]
        JobSets["JobSet<br/>jobset.x-k8s.io/v1alpha2"]
        PodGroups["PodGroup<br/>scheduling.x-k8s.io/v1alpha1<br/>scheduling.volcano.sh/v1beta1"]
        CoreResources["ConfigMap | Secret | Pod<br/>NetworkPolicy | Lease"]
    end

    subgraph ReadOnly["READ-ONLY RESOURCES"]
        OpenShiftAPI["config.openshift.io/v1/APIServer<br/>TLS profile resolution"]
        RuntimeClasses["node.k8s.io/RuntimeClasses"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token / kubeconfig"| APIServer
    APIServer -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>Admission webhook call"| SvcWebhook
    SvcWebhook --> WebhookServer

    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token (in-cluster)"| APIServer

    APIServer -.->|"Watch events"| CRDs
    APIServer -.->|"Watch events"| JobSets
    APIServer -.->|"Watch events"| PodGroups
    RuntimePlugins -->|"CRUD"| CoreResources
    ControllerPod -->|"GET"| OpenShiftAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef resources fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef readonly fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class APIServer apiserver
    class WebhookServer,HealthProbes,MetricsPort,RuntimePlugins,SvcWebhook,SvcMetrics operator
    class CRDs,JobSets,PodGroups,CoreResources resources
    class OpenShiftAPI,RuntimeClasses readonly
