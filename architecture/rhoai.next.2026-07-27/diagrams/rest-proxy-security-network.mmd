graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["REST Client<br/>Inference Consumer"]
    end

    subgraph Pod["POD BOUNDARY (Same Pod - localhost)"]
        direction TB

        subgraph ProxyContainer["rest-proxy Container"]
            Proxy["rest-proxy<br/>Image: ubi9/ubi-micro:9.5<br/>User: non-root (UID 2000)<br/>Binary: /go/bin/server<br/>CGO_ENABLED=0"]
        end

        subgraph InferenceContainer["ModelMesh Inference Container"]
            ModelMesh["GRPCInferenceService<br/>Methods: ModelInfer,<br/>ServerLive, ServerReady,<br/>ModelMetadata"]
        end
    end

    %% Flows
    Client -->|"HTTP/JSON / 8008/TCP<br/>KServe Predict V2<br/>TLS: Optional (REST_PROXY_USE_TLS)<br/>Auth: None"| Proxy

    Proxy -->|"gRPC / localhost:8033/TCP<br/>GRPCInferenceService<br/>TLS: Optional<br/>Max msg: 16 MiB<br/>Auth: None (localhost trust)"| ModelMesh

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef inference fill:#7ed321,stroke:#333,stroke-width:2px

    class Client external
    class Proxy proxy
    class ModelMesh inference

    style External fill:#fff5f5,stroke:#cc0000,stroke-width:2px,stroke-dasharray: 5 5
    style Pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ProxyContainer fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    style InferenceContainer fill:#d5e8d4,stroke:#82b366,stroke-width:1px
