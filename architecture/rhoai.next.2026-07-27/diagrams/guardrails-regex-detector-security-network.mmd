graph TB
    subgraph External["EXTERNAL / UPSTREAM"]
        Client["Client / Upstream<br/>Guardrails Service"]
    end

    subgraph Infra["INFRASTRUCTURE LAYER<br/>(Expected - not in application source)"]
        Mesh["Service Mesh / Sidecar<br/>TLS Termination: TLS 1.2+<br/>mTLS between services<br/>Auth: Header passthrough"]
    end

    subgraph App["APPLICATION (guardrails-regex-detector)"]
        direction TB

        subgraph Listener["Single HTTP Listener — 0.0.0.0:8080"]
            TraceMiddleware["TraceLayer Middleware<br/>(tower-http, INFO logging)"]

            subgraph Endpoints["Endpoints"]
                ContentAPI["POST /api/v1/text/contents<br/>Auth: None (passthrough headers)<br/>Regex-based content detection"]
                HealthAPI["GET /health<br/>Auth: None<br/>Returns: 'healthy'"]
            end

            TraceMiddleware --> ContentAPI
            TraceMiddleware --> HealthAPI
        end
    end

    subgraph Egress["EGRESS"]
        NoEgress["None<br/>No outbound connections<br/>All processing in-process"]
    end

    %% Flows
    Client -->|"HTTP/8080<br/>Encryption: Infrastructure-dependent<br/>Auth: Infrastructure-dependent"| Mesh
    Mesh -->|"HTTP/8080<br/>Plaintext (within mesh)<br/>mTLS (if sidecar present)"| TraceMiddleware

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef infra fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef endpoint fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef notraffic fill:#f5f5f5,stroke:#ccc,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Mesh infra
    class TraceMiddleware app
    class ContentAPI,HealthAPI endpoint
    class NoEgress notraffic
