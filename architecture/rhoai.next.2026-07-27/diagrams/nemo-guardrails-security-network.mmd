graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AppTier["APPLICATION TIER (NeMo Guardrails)"]
        direction TB

        subgraph MainServer["Main Guardrails Server"]
            Server["NeMo Guardrails Server<br/>(FastAPI)<br/>HTTP/HTTPS Configurable<br/>Auth: Bearer Token / API Key"]
        end

        subgraph ActionsBlock["Actions Server"]
            ActServer["Actions Server<br/>(FastAPI)<br/>HTTP/HTTPS Configurable<br/>Auth: NONE OBSERVED"]
        end

        subgraph JailbreakBlock["Jailbreak Detection Server"]
            JBServer["Jailbreak Detection<br/>(FastAPI)<br/>HTTP/HTTPS Configurable<br/>Auth: Unknown"]
        end

        subgraph AlignBlock["AlignScore Server"]
            ASServer["AlignScore Server<br/>(FastAPI)<br/>HTTP/HTTPS Configurable<br/>Auth: Unknown"]
        end

        subgraph LibraryBlock["Guardrails Library"]
            Library["Action Framework<br/>HTTP Clients: aiohttp, httpx<br/>Fail-open/closed configurable"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Outbound)"]
        OpenAI["OpenAI API<br/>HTTPS<br/>TLS<br/>API Key (SDK)"]
        AzureOpenAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS<br/>API Key (AZURE_OPENAI_API_KEY)"]
        ActiveFence["ActiveFence API<br/>apis.activefence.com<br/>443/TCP HTTPS<br/>TLS<br/>API Key (ACTIVEFENCE_API_KEY)"]
        AIDef["Cisco AI Defense<br/>Runtime-configured<br/>HTTPS TLS<br/>API Key (AI_DEFENSE_API_KEY)<br/>fail_open configurable"]
        AutoAlign["AutoAlign API<br/>Config-specified<br/>HTTPS TLS<br/>API Key (AUTOALIGN_API_KEY)"]
        Clavata["Clavata API<br/>Config-specified /v1/jobs<br/>HTTPS TLS<br/>API Key (CLAVATA_API_KEY)<br/>Retry: exp backoff on 429"]
    end

    %% Inbound flows
    Client -->|"HTTP/HTTPS<br/>Configurable Encryption<br/>Bearer Token / API Key"| Server
    Client -->|"HTTP/HTTPS<br/>Configurable Encryption<br/>NO AUTH OBSERVED"| ActServer

    %% Internal flows
    Server -->|"Internal"| Library
    Server -->|"Internal"| JBServer
    Server -->|"Internal"| ASServer

    %% Outbound flows
    Server -->|"HTTPS<br/>TLS<br/>API Key (SDK)"| OpenAI
    Server -->|"HTTPS/443<br/>TLS<br/>API Key"| AzureOpenAI
    Library -->|"HTTPS/443<br/>TLS<br/>API Key (aiohttp)"| ActiveFence
    Library -->|"HTTPS<br/>TLS<br/>API Key (httpx)"| AIDef
    Library -->|"HTTPS<br/>TLS<br/>API Key (aiohttp)"| AutoAlign
    Library -->|"HTTPS<br/>TLS<br/>API Key (aiohttp)"| Clavata

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apptier fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Server apptier
    class ActServer warning
    class JBServer,ASServer,Library apptier
    class OpenAI,AzureOpenAI,ActiveFence,AIDef,AutoAlign,Clavata externalservice
