graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>⚠ No Auth Required"]
    end

    subgraph AppLayer["APPLICATION LAYER (MLflow v3.14.0)<br/>⚠ No inbound authentication middleware"]
        direction TB

        subgraph GatewayZone["AI Gateway Subsystem"]
            Gateway["AI Gateway<br/>FastAPI GatewayAPI<br/>Rate Limit: slowapi<br/>Endpoints: /v1/*, /gateway/*"]
        end

        subgraph AgentZone["Agent Server Subsystem"]
            AgentSrv["Agent Server<br/>Port 8000/TCP<br/>SSRF Protection: path allowlist<br/>Endpoints: /invocations, /responses"]
        end

        subgraph TrackingZone["Tracking Server Subsystem"]
            TrackingSrv["Tracking Server<br/>Flask/FastAPI<br/>Endpoints: /ajax-api/3.0/*"]
        end

        subgraph MCPZone["MCP Registry Subsystem"]
            MCPSrv["MCP Registry<br/>FastAPI<br/>Endpoints: /{name}/* CRUD"]
        end
    end

    subgraph Providers["LLM PROVIDERS (Outbound Auth Only)"]
        OpenAI["OpenAI<br/>api.openai.com:443<br/>TLS, Bearer Token"]
        AzureOAI["Azure OpenAI<br/>443/TCP<br/>TLS, API Key / Azure AD"]
        Bedrock["AWS Bedrock<br/>443/TCP<br/>TLS, IAM / STS / Bearer"]
        AnthropicAPI["Anthropic<br/>443/TCP<br/>TLS, API Key"]
        CohereSvc["Cohere<br/>443/TCP<br/>TLS, API Key"]
    end

    subgraph Storage["STORAGE SERVICES"]
        S3["AWS S3<br/>HTTPS/TLS<br/>AWS IAM (boto3)"]
        GCS["Google Cloud Storage<br/>HTTPS/TLS<br/>GCS SDK Credentials"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>HTTPS<br/>ServiceAccount"]
        Databricks["Databricks<br/>443/TCP, TLS<br/>Token / OAuth / CLI Chain"]
    end

    %% Inbound flows - NO AUTH
    Client -->|"HTTP/HTTPS<br/>Configurable Encryption<br/>⚠ No Auth"| Gateway
    Client -->|"HTTP/HTTPS<br/>Port 8000<br/>⚠ No Auth"| AgentSrv
    Client -->|"HTTP/HTTPS<br/>Configurable<br/>⚠ No Auth"| TrackingSrv
    Client -->|"HTTP/HTTPS<br/>Configurable<br/>⚠ No Auth"| MCPSrv

    %% Outbound flows - WITH AUTH
    Gateway -->|"HTTPS/443<br/>Bearer Token"| OpenAI
    Gateway -->|"HTTPS/443<br/>API Key / AD"| AzureOAI
    Gateway -->|"HTTPS/443<br/>IAM / STS"| Bedrock
    Gateway -->|"HTTPS/443<br/>API Key"| AnthropicAPI
    Gateway -->|"HTTPS/443<br/>API Key"| CohereSvc

    TrackingSrv -->|"HTTPS<br/>AWS IAM"| S3
    TrackingSrv -->|"HTTPS<br/>GCS Creds"| GCS

    AppLayer -->|"HTTPS<br/>ServiceAccount"| K8sAPI
    AppLayer -->|"HTTPS/443<br/>Auth Chain"| Databricks

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef warning fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    classDef appserver fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef provider fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class Gateway,AgentSrv,TrackingSrv,MCPSrv appserver
    class OpenAI,AzureOAI,Bedrock,AnthropicAPI,CohereSvc provider
    class S3,GCS storage
    class K8sAPI,Databricks platform
