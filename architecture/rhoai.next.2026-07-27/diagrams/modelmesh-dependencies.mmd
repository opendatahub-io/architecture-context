graph LR
    ModelMesh["ModelMesh<br/>(kserve/modelmesh)"]

    %% Infrastructure Dependencies (from architectural analysis)
    ModelMesh -->|"model registry<br/>leader election<br/>dynamic config"| etcd["etcd<br/>(KVTable, 128 buckets)"]

    %% Sidecar Dependencies
    ModelMesh -->|"model load/unload/predict<br/>UDS or TCP/8085"| ModelRuntime["Model Runtime<br/>(collocated sidecar)"]

    %% Inter-Instance Dependencies
    ModelMesh -->|"request forwarding<br/>service discovery"| litelinks["litelinks<br/>(Thrift mesh)"]

    %% Parent Operator
    ModelMeshServing["ModelMesh Serving<br/>Operator"] -->|"deploys & configures"| ModelMesh

    %% Platform Dependencies
    ModelMesh -->|"container orchestration"| K8sAPI["Kubernetes API"]

    %% Configuration Dependencies
    ModelMesh -.->|"MM_DATAPLANE_CONFIG<br/>env var or ConfigMap"| DataplaneConfig["Dataplane Config<br/>(ConfigMap)"]

    %% Potential Storage (from data flows)
    ModelRuntime -.->|"model artifacts"| ModelStorage["Model Storage<br/>(S3/PVC)"]

    style ModelMesh fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style etcd fill:#999,stroke:#333,color:#fff
    style ModelRuntime fill:#7ed321,stroke:#333,color:#fff
    style litelinks fill:#999,stroke:#333,color:#fff
    style ModelMeshServing fill:#4a90e2,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style DataplaneConfig fill:#e8e8e8,stroke:#333
    style ModelStorage fill:#f5a623,stroke:#333,color:#fff
