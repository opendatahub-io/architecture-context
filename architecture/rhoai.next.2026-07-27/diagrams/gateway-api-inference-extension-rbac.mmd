graph TD
    subgraph Note["RBAC Configuration"]
        direction TB
        Info["No RBAC rules included in<br/>component manifests.<br/>RBAC is expected to be<br/>provisioned by the deployment<br/>mechanism."]
    end

    subgraph ExpectedPermissions["Expected Permissions (Inferred from Controllers)"]
        direction TB

        subgraph SA["Service Account"]
            EPPServiceAccount["gateway-api-inference-extension<br/>controller-manager"]
        end

        subgraph WatchResources["Watched Resources (Controllers)"]
            InferencePool["inference.networking.k8s.io/v1<br/>InferencePool<br/>get, list, watch"]
            InferenceObjective["inference.networking.x-k8s.io/v1alpha2<br/>InferenceObjective<br/>get, list, watch"]
            InferenceModelRewrite["inference.networking.x-k8s.io/v1alpha2<br/>InferenceModelRewrite<br/>get, list, watch"]
            Pods["core/v1<br/>Pod<br/>get, list, watch"]
            ConfigMaps["core/v1<br/>ConfigMap<br/>get, list, watch"]
        end

        subgraph CRUDResources["CRUD Resources"]
            Services["core/v1<br/>Service<br/>get, update"]
            EndpointSlices["discovery/v1<br/>EndpointSlice<br/>list"]
        end
    end

    subgraph CRDValidation["CRD Validation"]
        CEL["CEL Expressions<br/>(e.g., port uniqueness in<br/>InferencePool.Spec.TargetPorts)"]
    end

    EPPServiceAccount -->|"needs access to"| InferencePool
    EPPServiceAccount -->|"needs access to"| InferenceObjective
    EPPServiceAccount -->|"needs access to"| InferenceModelRewrite
    EPPServiceAccount -->|"needs access to"| Pods
    EPPServiceAccount -->|"needs access to"| ConfigMaps
    EPPServiceAccount -->|"needs access to"| Services
    EPPServiceAccount -->|"needs access to"| EndpointSlices

