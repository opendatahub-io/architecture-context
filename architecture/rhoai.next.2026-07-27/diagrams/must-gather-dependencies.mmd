graph LR
    MustGather["must-gather<br/>(Ephemeral Pod)"]

    %% Core Runtime Dependencies
    MustGather -->|"oc adm inspect<br/>oc get"| OpenShiftCLI["OpenShift CLI<br/>(oc)"]
    MustGather -->|"kubectl get<br/>(xKS fallback)"| Kubectl["kubectl"]
    MustGather -->|"HTTPS/6443<br/>SA Token"| K8sAPI["Kubernetes<br/>API Server"]

    %% Distribution Detection
    MustGather -->|detects| OpenShift["OpenShift"]
    MustGather -->|detects| AKS["Azure AKS"]
    MustGather -->|detects| CKS["Cloud CKS"]
    MustGather -->|detects| EKS["AWS EKS"]

    %% RHOAI Components Collected (OpenShift)
    MustGather -->|"collects CRs & logs"| KServe["KServe /<br/>Serving"]
    MustGather -->|"collects CRs & logs"| Authorino["Authorino"]
    MustGather -->|"collects CRs & logs"| NIM["NIM"]
    MustGather -->|"collects CRs & logs"| LLMd["llm-d"]
    MustGather -->|"collects CRs & logs"| Kuadrant["Kuadrant"]
    MustGather -->|"collects CRs & logs"| DSP["Data Science<br/>Pipelines"]
    MustGather -->|"collects CRs & logs"| Dashboard["Dashboard"]
    MustGather -->|"collects CRs & logs"| ModelRegistry["Model Registry"]
    MustGather -->|"collects CRs & logs"| AIGateway["AI Gateway /<br/>MaaS"]
    MustGather -->|"collects CRs & logs"| MCPLifecycle["MCP Lifecycle<br/>Operator"]
    MustGather -->|"collects CRs & logs"| Notebooks["Notebooks"]
    MustGather -->|"collects CRs & logs"| Monitoring["Monitoring"]

    %% Operator Resources
    MustGather -->|"collects"| DSCI["DSCI CR"]
    MustGather -->|"collects"| DSC["DSC CR"]
    MustGather -->|"collects"| Webhooks["Webhook<br/>Configurations"]
    MustGather -->|"collects"| GatewayClasses["Gateway Classes"]
    MustGather -->|"collects"| IstioResources["Istio /<br/>Gateway API<br/>Resources"]
    MustGather -->|"collects"| HelmReleases["Helm Release<br/>Values"]

    %% xKS-only dependencies
    LLMd -.->|"xKS default<br/>collection"| MustGather

