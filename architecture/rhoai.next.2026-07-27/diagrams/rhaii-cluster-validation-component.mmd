graph TB
    subgraph "rhaii-cluster-validation CLI"
        CLI["kubectl-rhaii_validate<br/>(Cobra CLI)"]
        DepsCmd["deps subcommand<br/>Prerequisite Validation"]
        RunCmd["run subcommand<br/>Per-Node Check Execution"]
        Controller["Controller<br/>Orchestrates validation"]
    end

    subgraph "Ephemeral Resources"
        NS["Namespace<br/>rhaii-validation"]
        SA["ServiceAccount<br/>rhaii-validator"]
        CR["ClusterRole<br/>rhaii-validator"]
        CRB["ClusterRoleBinding<br/>rhaii-validator"]
        Jobs["Per-Node Jobs<br/>Validation Checks"]
        ReportCM["ConfigMap<br/>rhaii-validate-report"]
        PingmeshCM["ConfigMap<br/>rhaii-validate-pingmesh-failures"]
    end

    subgraph "Check Modes"
        GPU["GPU Hardware<br/>Driver, ECC (NVIDIA/AMD)"]
        TCP["TCP Bandwidth/Latency<br/>iperf3"]
        RDMANode["RDMA Node Checks<br/>Device, NIC, NUMA, PCIe"]
        RDMAMesh["RDMA Connectivity<br/>ibv_rc_pingpong"]
        RDMABw["RDMA Bandwidth<br/>ib_write_bw"]
    end

    User[Operator/Admin] -->|"kubectl rhaii_validate"| CLI
    CLI --> Controller
    CLI --> DepsCmd
    Controller -->|creates| NS
    Controller -->|creates| SA
    Controller -->|creates| CR
    Controller -->|creates| CRB
    Controller -->|deploys| Jobs
    Jobs -->|writes results| ReportCM
    Jobs -->|writes failures| PingmeshCM
    Jobs -->|executes| RunCmd

    RunCmd --> GPU
    RunCmd --> TCP
    RunCmd --> RDMANode
    RunCmd --> RDMAMesh
    RunCmd --> RDMABw

    Controller -->|reads| ReportCM
    Controller -->|cleanup on exit| NS

    Controller -->|connects via kubeconfig| K8sAPI[Kubernetes API<br/>6443/TCP]

    style CLI fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style DepsCmd fill:#4a90e2,color:#fff
    style RunCmd fill:#4a90e2,color:#fff
    style NS fill:#f5a623,color:#fff
    style SA fill:#f5a623,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#f5a623,color:#fff
    style Jobs fill:#f5a623,color:#fff
    style ReportCM fill:#f5a623,color:#fff
    style PingmeshCM fill:#f5a623,color:#fff
    style GPU fill:#7ed321,color:#fff
    style TCP fill:#7ed321,color:#fff
    style RDMANode fill:#7ed321,color:#fff
    style RDMAMesh fill:#7ed321,color:#fff
    style RDMABw fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
