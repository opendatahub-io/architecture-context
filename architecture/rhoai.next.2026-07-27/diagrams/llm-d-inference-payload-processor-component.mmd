graph TB
    subgraph External["External Clients"]
        Client[HTTP Client]
    end

    subgraph PayloadProcessorSystem["llm-d-inference-payload-processor"]
        subgraph EnvoyProxy["Envoy Proxy"]
            Envoy["envoy<br/>envoyproxy/envoy:distroless-v1.33.2<br/>Port: 8081/TCP"]
            ExtProcFilter["ext_proc Filter"]
            Envoy --- ExtProcFilter
        end

        subgraph PPCore["Payload Processor"]
            PP["payload-processor<br/>Ports: 9004/TCP (gRPC), 9090/TCP (metrics)"]

            subgraph PluginPipeline["Plugin Pipeline (15 plugins)"]
                PreProc["Pre-Processing<br/>body-field-to-header<br/>base-model-extractor"]
                ProfilePicker["Profile Picker<br/>single profile picker"]
                ReqPlugins["Per-Profile Request Plugins<br/>model-selector orchestrator<br/>model-group filter<br/>random/max-score/weighted-random pickers<br/>inflight-requests/session-affinity/cost-guard scorers"]
                RespPlugins["Response Plugins<br/>model-name-to-header"]
                PostProc["Post-Processing<br/>request-metadata extractor<br/>request-cost-metadata extractor<br/>model-config-collector datasource"]
            end

            PP --- PluginPipeline
            PreProc --> ProfilePicker
            ProfilePicker --> ReqPlugins
            ReqPlugins --> RespPlugins
            RespPlugins --> PostProc
        end

        subgraph ModelServers["Model Servers (dev/e2e)"]
            Llama["vllm-llama3-8b-instruct<br/>Port: 8000/TCP"]
            DeepSeek["vllm-deepseek-r1<br/>Port: 8000/TCP"]
        end
    end

    subgraph ControlPlane["Control Plane"]
        CRManager["controller-runtime Manager"]
        ConfigMaps["ConfigMaps<br/>label: inference.llm-d.ai/ipp-managed"]
    end

    PayloadProcessorConfigCR["PayloadProcessorConfig<br/>(YAML config, not live CRD)<br/>llm-d.ai/v1alpha1"]

    Client -->|"HTTP Request<br/>8081/TCP"| Envoy
    ExtProcFilter -->|"gRPC ExtProc<br/>9004/TCP"| PP
    PP -->|"Sets X-Gateway-Base-Model-Name"| Envoy
    Envoy -->|"Route to llama_cluster<br/>8000/TCP"| Llama
    Envoy -->|"Route to deepseek_cluster<br/>8000/TCP"| DeepSeek
    CRManager -->|"watches"| ConfigMaps
    CRManager -->|"updates base-model mappings"| PP
    PayloadProcessorConfigCR -.->|"configures"| PP

    PP -->|"Kubernetes API<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]

    style Envoy fill:#4a90e2,stroke:#333
    style PP fill:#4a90e2,stroke:#333
    style PreProc fill:#7ed321,stroke:#333
    style ProfilePicker fill:#7ed321,stroke:#333
    style ReqPlugins fill:#7ed321,stroke:#333
    style RespPlugins fill:#7ed321,stroke:#333
    style PostProc fill:#7ed321,stroke:#333
    style Llama fill:#f5a623,stroke:#333
    style DeepSeek fill:#f5a623,stroke:#333
    style CRManager fill:#9b59b6,stroke:#333
    style ConfigMaps fill:#f5a623,stroke:#333
    style PayloadProcessorConfigCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Client fill:#e8e8e8,stroke:#333
