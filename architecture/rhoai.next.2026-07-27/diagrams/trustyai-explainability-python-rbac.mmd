graph TD
    subgraph Library["trustyai-explainability-python (Client Library)"]
        Note["No RBAC resources defined.<br/>This is a pip-installable library,<br/>not a deployed operator or service."]
    end

    subgraph RequiredPermissions["Required Permissions<br/>(on hosting workload's ServiceAccount)"]
        direction TB
        SA["Hosting Workload SA<br/>(e.g., notebook SA)"]
    end

    subgraph APIResources["API Resources Accessed"]
        direction TB
        Routes["route.openshift.io<br/>Routes"]
    end

    subgraph RuntimeAuth["Runtime Authentication"]
        direction TB
        BearerToken["OpenShift OAuth<br/>Bearer Token<br/>(caller-provided)"]
        SAToken["ServiceAccount Token<br/>(in-cluster) or<br/>kubeconfig credentials"]
    end

    subgraph TargetServices["Target Services"]
        TrustyAISvc["TrustyAI Service<br/>(HTTPS, Bearer auth)"]
        Thanos["Thanos Querier<br/>(HTTPS, Bearer auth)"]
        ModelEP["Model Endpoints<br/>(HTTPS, Bearer auth)"]
        K8sAPI["Kubernetes API<br/>(HTTPS, SA/kubeconfig auth)"]
    end

    SA -->|"needs: get, list"| Routes
    Routes -->|"discovers"| TrustyAISvc
    Routes -->|"discovers"| Thanos
    Routes -->|"discovers"| ModelEP

    SAToken -->|"authenticates to"| K8sAPI
    BearerToken -->|"authenticates to"| TrustyAISvc
    BearerToken -->|"authenticates to"| Thanos
    BearerToken -->|"authenticates to"| ModelEP

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style SA fill:#4a90e2,stroke:#333,color:#fff
