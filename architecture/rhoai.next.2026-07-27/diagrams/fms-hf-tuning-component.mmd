graph TB
    subgraph Orchestration["External Orchestration"]
        Job[Kubernetes Job / Launcher]
    end

    subgraph FMSTuning["fms-hf-tuning (Python Package)"]
        direction TB
        CLI["sft_trainer.py<br/>CLI Entrypoint"]
        SFT["SFT Trainer<br/>Supervised Fine-Tuning"]
        DataFormatter["Data Formatter<br/>Dataset Preprocessing"]
        ConfigRecommender["tuning-config-recommender<br/>Config Optimization"]

        CLI --> SFT
        CLI --> DataFormatter
        CLI --> ConfigRecommender
        SFT --> DataFormatter
    end

    subgraph MLFrameworks["ML Frameworks"]
        direction TB
        Transformers["transformers<br/>>=4.55.0"]
        PEFT["peft<br/>>=0.18.0"]
        TRL["trl<br/>>=0.19.1"]
        Accelerate["accelerate<br/>>=1.9.0"]
        Torch["torch<br/>>2.7.0"]
    end

    subgraph GPUAccel["GPU Acceleration (Optional)"]
        FlashAttn["flash-attn<br/>>=2.8.3"]
        FMSAccel["fms-acceleration<br/>>=0.6.2"]
        AutoGPTQ["auto-gptq<br/>>0.4.2"]
    end

    subgraph ExperimentTracking["Experiment Tracking (Optional)"]
        Aim["Aim<br/>>=3.19.0"]
        MLflow["MLflow"]
        ClearML["ClearML<br/>==2.0.0"]
    end

    subgraph Storage["External Storage"]
        S3["S3-Compatible Storage<br/>via boto3"]
    end

    Job -->|invokes| CLI
    SFT -->|uses| Transformers
    SFT -->|uses| PEFT
    SFT -->|uses| TRL
    SFT -->|uses| Accelerate
    SFT -->|uses| Torch
    SFT -.->|optional| FlashAttn
    SFT -.->|optional| FMSAccel
    SFT -.->|optional| AutoGPTQ
    SFT -.->|logs to| Aim
    SFT -.->|logs to| MLflow
    SFT -.->|logs to| ClearML
    DataFormatter -->|retrieves datasets| S3

