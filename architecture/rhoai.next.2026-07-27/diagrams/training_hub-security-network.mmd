graph TB
    subgraph UserEnv["USER ENVIRONMENT (Notebook / Training Job Pod)"]
        direction TB

        UserCode["User Code<br/>imports training_hub"]

        subgraph Library["Training Hub Library (No Inbound Surfaces)"]
            direction TB
            API["Convenience Functions<br/>sft() / osft() / lora_sft()<br/>lora_grpo() / gepa()"]
            Registry["AlgorithmRegistry"]
            API --> Registry

            subgraph Backends["Backend Execution"]
                InProcess["In-Process Backends<br/>instructlab-training<br/>unsloth, gepa"]
                Subprocess["Subprocess Backend<br/>verl → Ray/torchrun<br/>Multi-GPU/Multi-Node"]
                CoLocated["Co-located Engine<br/>ART → vLLM AsyncLLM"]
            end

            Registry --> InProcess
            Registry --> Subprocess
            Registry --> CoLocated
        end

        UserCode -->|"In-process call<br/>(no network boundary)"| API
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Outbound Only)"]
        direction TB

        LLM["LLM API (via litellm)<br/>HTTPS/443<br/>TLS 1.2+<br/>Auth: OPENAI_API_KEY"]

        MLflow["MLflow Tracking Server<br/>HTTPS<br/>TLS (server-dependent)<br/>Auth: MLFLOW_TRACKING_URI"]

        WandB["Weights & Biases API<br/>HTTPS/443<br/>TLS 1.2+<br/>Auth: WANDB_API_KEY"]
    end

    %% Outbound flows
    Subprocess -->|"HTTPS/443<br/>TLS 1.2+<br/>OPENAI_API_KEY<br/>(GRPO reward scoring)"| LLM
    CoLocated -->|"HTTPS/443<br/>TLS 1.2+<br/>OPENAI_API_KEY<br/>(GRPO reward scoring)"| LLM
    Backends -->|"HTTPS<br/>MLFLOW_TRACKING_URI<br/>(metrics logging)"| MLflow
    Backends -->|"HTTPS/443<br/>TLS 1.2+<br/>WANDB_API_KEY<br/>(metrics logging)"| WandB

    %% Credential annotations
    subgraph Credentials["CREDENTIALS (All User-Provisioned Env Vars)"]
        C1["OPENAI_API_KEY"]
        C2["OPENAI_API_BASE"]
        C3["MLFLOW_TRACKING_URI"]
        C4["WANDB_API_KEY"]
        C5["WANDB_ENTITY"]
    end

    %% Styling
    classDef userenv fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef backend fill:#e8f4fd,stroke:#4a90e2
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef creds fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class UserCode userenv
    class API,Registry library
    class InProcess,Subprocess,CoLocated backend
    class LLM,MLflow,WandB external
    class C1,C2,C3,C4,C5 creds
