graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA1["feast-operator-controller-manager<br/>(feast-operator-system)"]
        SA2["operator<br/>(system)"]
    end

    subgraph PrimaryBindings["Primary Role Bindings"]
        CRB1["feast-operator-manager-rolebinding"]
        CRB2["feast-operator-metrics-auth-rolebinding"]
        CRB3["manager-rolebinding"]
        CRB4["metrics-auth-rolebinding"]
    end

    subgraph LeaderElection["Leader Election Bindings"]
        RB1["feast-operator-leader-election-rolebinding<br/>(feast-operator-system)"]
        RB2["leader-election-rolebinding<br/>(system)"]
    end

    subgraph PrimaryRoles["Primary ClusterRoles"]
        CR1["feast-operator-manager-role"]
        CR2["feast-operator-metrics-auth-role"]
        CR3["manager-role"]
        CR4["metrics-auth-role"]
    end

    subgraph LeaderElectionRoles["Leader Election Roles"]
        LR1["feast-operator-leader-election-role<br/>(Role)"]
        LR2["leader-election-role<br/>(Role)"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles"]
        AR1["feast-operator-featurestore-editor-role"]
        AR2["feast-operator-featurestore-viewer-role"]
        AR3["components-feastoperator-admin-role"]
        AR4["components-feastoperator-editor-role"]
        AR5["components-feastoperator-viewer-role"]
    end

    subgraph FeastResources["feast.dev Resources"]
        FS["featurestores"]
        FSF["featurestores/finalizers"]
        FSS["featurestores/status"]
    end

    subgraph PlatformResources["Platform Resources"]
        FO["feastoperators"]
        FOF["feastoperators/finalizers"]
        FOS["feastoperators/status"]
    end

    subgraph CoreResources["Core API Resources"]
        CM["configmaps"]
        SVC["services"]
        SA["serviceaccounts"]
        PVC["persistentvolumeclaims"]
        POD["pods / pods/exec"]
        SEC["secrets"]
        NS["namespaces"]
        EVT["events"]
    end

    subgraph ExtResources["Extended API Resources"]
        DEP["apps/deployments"]
        CRD["apiextensions/crds"]
        HPA["autoscaling/hpas"]
        CJ["batch/cronjobs, jobs"]
        SM["monitoring/servicemonitors"]
        PDB["policy/poddisruptionbudgets"]
        RBAC_R["rbac/roles, bindings"]
        RT["route.openshift.io/routes"]
        NB["kubeflow.org/notebooks"]
        LS["coordination/leases"]
    end

    subgraph AuthResources["Auth Resources"]
        TR["authentication/tokenreviews"]
        SAR["authorization/subjectaccessreviews"]
    end

    %% SA1 bindings
    SA1 -->|bound via| CRB1
    SA1 -->|bound via| CRB2
    SA1 -->|bound via| RB1
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2
    RB1 -->|grants| LR1

    %% SA2 bindings
    SA2 -->|bound via| CRB3
    SA2 -->|bound via| CRB4
    SA2 -->|bound via| RB2
    CRB3 -->|grants| CR3
    CRB4 -->|grants| CR4
    RB2 -->|grants| LR2

    %% CR1 permissions
    CR1 -->|"CRUD"| FS
    CR1 -->|"update"| FSF
    CR1 -->|"get,patch,update"| FSS
    CR1 -->|"CRUD"| CM
    CR1 -->|"CRUD"| SVC
    CR1 -->|"CRUD"| DEP
    CR1 -->|"read"| POD
    CR1 -->|"read"| SEC
    CR1 -->|"CRUD"| RT
    CR1 -->|"CRUD"| SM
    CR1 -->|"read"| NB
    CR1 -->|"create"| TR

    %% CR3 permissions (superset)
    CR3 -->|"CRUD"| FO
    CR3 -->|"update"| FOF
    CR3 -->|"get,patch,update"| FOS
    CR3 -->|"CRUD"| FS
    CR3 -->|"CRUD"| CRD
    CR3 -->|"CRUD"| HPA
    CR3 -->|"CRUD"| CJ
    CR3 -->|"CRUD"| PDB
    CR3 -->|"CRUD"| RBAC_R
    CR3 -->|"CRUD"| LS

    %% Auth roles
    CR2 -->|"create"| TR
    CR2 -->|"create"| SAR
    CR4 -->|"create"| TR
    CR4 -->|"create"| SAR

    %% Leader election
    LR1 -->|"CRUD"| CM
    LR1 -->|"CRUD"| LS
    LR2 -->|"CRUD"| CM
    LR2 -->|"CRUD"| LS

    %% Aggregated roles
    AR1 -->|"CRUD"| FS
    AR2 -->|"read"| FS
    AR3 -->|"CRUD"| FO
    AR4 -->|"CRUD"| FO
    AR5 -->|"read"| FO

