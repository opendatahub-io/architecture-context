graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        HTTPClient["HTTP Inference Client"]
        GRPCClient["gRPC Inference Client"]
    end

    subgraph Container["CONTAINER RUNTIME (vllm-spyre, UID 2000)<br/>Base: rhaiis/vllm-spyre-rhel9:3.2.2 | x86_64 RHEL 9"]
        direction TB

        subgraph HTTPSurface["HTTP API Surface"]
            Uvicorn["uvicorn HTTP Server<br/>0.0.0.0:8000/TCP<br/>OpenAI-compatible REST"]
        end

        subgraph GRPCSurface["gRPC API Surface"]
            TGISAdapter["vllm_tgis_adapter<br/>0.0.0.0:8033/TCP<br/>TGIS-compatible gRPC"]
        end

        subgraph Engine["Inference Engine"]
            VLLMEngine["vLLM Engine<br/>IBM Spyre Accelerator"]
        end

        Uvicorn --> VLLMEngine
        TGISAdapter --> VLLMEngine
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["Hugging Face Hub<br/>huggingface.co<br/>HTTPS/443<br/>HF Token (if private)"]
        Volume["Pre-mounted Volume<br/>Local Filesystem<br/>PVC / hostPath"]
    end

    subgraph PlatformManagement["PLATFORM MANAGEMENT (not in this repo)"]
        KServe["KServe / ServingRuntime<br/>(deploys & manages pod)"]
        ServiceMesh["Service Mesh / Istio<br/>(mTLS, AuthZ - if configured)"]
    end

    %% Inbound flows
    HTTPClient -->|"HTTP/8000<br/>Encryption: not-extracted<br/>Auth: not-extracted"| Uvicorn
    GRPCClient -->|"gRPC/8033<br/>Encryption: not-extracted<br/>Auth: not-extracted"| TGISAdapter

    %% Outbound flows
    VLLMEngine -->|"HTTPS/443<br/>TLS<br/>HF Token"| HFHub
    VLLMEngine -->|"Filesystem<br/>Volume mount"| Volume

    %% Platform management (dashed - external)
    KServe -.->|"manages lifecycle"| Container
    ServiceMesh -.->|"sidecar injection<br/>mTLS policy"| Container

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef notextracted fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5 5

    class HTTPClient,GRPCClient external
    class Uvicorn,TGISAdapter,VLLMEngine container
    class HFHub,Volume externalservice
    class KServe,ServiceMesh platform
