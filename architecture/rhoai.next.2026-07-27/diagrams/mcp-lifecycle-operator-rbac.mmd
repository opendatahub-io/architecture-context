graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Main["mcp-lifecycle-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["mcp-lifecycle-operator-<br/>manager-rolebinding"]
        CRB_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-Scoped)"]
        RB_Leader["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["mcp-lifecycle-operator-<br/>manager-role"]
        CR_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-role"]
    end

    subgraph Roles["Roles (Namespace-Scoped)"]
        R_Leader["mcp-lifecycle-operator-<br/>leader-election-role"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles<br/>(integrate into built-in K8s roles)"]
        CR_Admin["mcpserver-admin-role<br/>→ aggregate-to-admin"]
        CR_Editor["mcpserver-editor-role<br/>→ aggregate-to-edit"]
        CR_Viewer["mcpserver-viewer-role<br/>→ aggregate-to-view"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        MCPServer["mcp.x-k8s.io<br/>MCPServer<br/>get,list,patch,update,watch"]
        MCPServerFinalizers["mcp.x-k8s.io<br/>MCPServer/finalizers<br/>update"]
        MCPServerStatus["mcp.x-k8s.io<br/>MCPServer/status<br/>get,patch,update"]
        Deployments["apps<br/>Deployments<br/>create,get,list,update,watch"]
        Services["core<br/>Services<br/>create,get,list,update,watch"]
        NetworkPolicies["networking.k8s.io<br/>NetworkPolicies<br/>create,get,list,update,watch"]
        ConfigMaps["core<br/>ConfigMaps<br/>get,list,watch"]
        Secrets["core<br/>Secrets<br/>get,list,watch"]
        Pods["core<br/>Pods<br/>get,list"]
        Events["events.k8s.io<br/>Events<br/>create,patch"]
    end

    subgraph MetricsResources["Metrics Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews<br/>create"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews<br/>create"]
    end

    subgraph LeaderResources["Leader Election Resources"]
        LE_ConfigMaps["core<br/>ConfigMaps<br/>create,delete,get,list,<br/>patch,update,watch"]
        LE_Leases["coordination.k8s.io<br/>Leases<br/>create,delete,get,list,<br/>patch,update,watch"]
        LE_Events["core<br/>Events<br/>create,patch"]
    end

    %% Bindings
    SA_Main -->|bound via| CRB_Manager
    SA_Main -->|bound via| CRB_Metrics
    SA_Main -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader -->|grants| R_Leader

    %% Manager Role Permissions
    CR_Manager --> MCPServer
    CR_Manager --> MCPServerFinalizers
    CR_Manager --> MCPServerStatus
    CR_Manager --> Deployments
    CR_Manager --> Services
    CR_Manager --> NetworkPolicies
    CR_Manager --> ConfigMaps
    CR_Manager --> Secrets
    CR_Manager --> Pods
    CR_Manager --> Events

    %% Metrics Permissions
    CR_Metrics --> TokenReviews
    CR_Metrics --> SAR

    %% Leader Election Permissions
    R_Leader --> LE_ConfigMaps
    R_Leader --> LE_Leases
    R_Leader --> LE_Events

    %% Aggregated Role Permissions
    CR_Admin -->|"MCPServer: full CRUD +<br/>deletecollection"| MCPServer
    CR_Editor -->|"MCPServer: CRUD<br/>(no deletecollection)"| MCPServer
    CR_Viewer -->|"MCPServer: read-only<br/>get,list,watch"| MCPServer

    %% Styling
    style SA_Main fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff
    style CR_Admin fill:#e8744f,color:#fff
    style CR_Editor fill:#e8744f,color:#fff
    style CR_Viewer fill:#e8744f,color:#fff
    style MCPServer fill:#7ed321,color:#fff
    style MCPServerFinalizers fill:#7ed321,color:#fff
    style MCPServerStatus fill:#7ed321,color:#fff
    style Deployments fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style NetworkPolicies fill:#7ed321,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style Secrets fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style Events fill:#7ed321,color:#fff
    style TokenReviews fill:#9b59b6,color:#fff
    style SAR fill:#9b59b6,color:#fff
    style LE_ConfigMaps fill:#3498db,color:#fff
    style LE_Leases fill:#3498db,color:#fff
    style LE_Events fill:#3498db,color:#fff
