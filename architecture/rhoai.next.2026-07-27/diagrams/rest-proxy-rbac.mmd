graph TD
    subgraph "rest-proxy RBAC"
        direction TB
        Note["No Kubernetes RBAC roles,<br/>role bindings, or service accounts<br/>are defined by this component.<br/><br/>rest-proxy operates as a pure<br/>network proxy sidecar with no<br/>Kubernetes API interactions.<br/><br/>Access control relies on:<br/>- Pod-level network policies<br/>- Service mesh configuration<br/>- Optional transport-level TLS"]
    end

    subgraph "Container Security"
        direction TB
        NonRoot["Non-root execution<br/>UID 2000"]
        Static["Static binary<br/>CGO_ENABLED=0"]
        Minimal["Minimal base image<br/>ubi9/ubi-micro:9.5<br/>No shell, no package manager"]
    end

    Note --- NonRoot
    NonRoot --- Static
    Static --- Minimal

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style NonRoot fill:#d5e8d4,stroke:#82b366
    style Static fill:#d5e8d4,stroke:#82b366
    style Minimal fill:#d5e8d4,stroke:#82b366
