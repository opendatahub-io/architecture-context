graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["maas-api<br/>Namespace: opendatahub"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["maas-api"]
        CRB2["maas-api-supplemental"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR1["maas-api"]
        CR2["maas-api-supplemental"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["core<br/>secrets<br/>(resourceNames: maas-db-config)"]
        Namespaces["core<br/>namespaces"]
        ServiceAccountsRes["core<br/>serviceaccounts"]
        SATokens["core<br/>serviceaccounts/token"]
        Endpoints["core<br/>endpoints, pods, services"]
    end

    subgraph AuthResources["Authentication & Authorization"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph MaaSResources["MaaS CRD Resources"]
        MaaSCRDs["maas.opendatahub.io<br/>maasauthpolicies<br/>maasmodelrefs<br/>maassubscriptions"]
    end

    subgraph GatewayResources["Gateway API Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        Gateways["gateway.networking.k8s.io<br/>gateways"]
    end

    subgraph WebhookPerms["Admission Webhooks"]
        WH_AITenant["vaitenant.kb.io<br/>Resources: aitenants<br/>Ops: CREATE, UPDATE<br/>FailurePolicy: fail"]
        WH_AuthPolicy["vmaasauthpolicy.kb.io<br/>Resources: maasauthpolicies<br/>Ops: CREATE<br/>FailurePolicy: fail"]
        WH_Subscription["vmaassubscription.kb.io<br/>Resources: maassubscriptions<br/>Ops: CREATE<br/>FailurePolicy: fail"]
    end

    %% SA → CRB → CR
    SA -->|bound via| CRB1
    SA -->|bound via| CRB2
    CRB1 -->|grants| CR1
    CRB2 -->|grants| CR2

    %% CR1 permissions
    CR1 -->|"get"| Secrets
    CR1 -->|"create, get,<br/>list, watch"| Namespaces
    CR1 -->|"create, delete, get,<br/>list, watch"| ServiceAccountsRes
    CR1 -->|"create"| SATokens
    CR1 -->|"create"| TokenReviews
    CR1 -->|"create"| SAR
    CR1 -->|"get, list, watch"| MaaSCRDs
    CR1 -->|"get, list, watch"| HTTPRoutes
    CR1 -->|"get"| Gateways
    CR1 -->|"get, list, watch"| Endpoints

    %% CR2 permissions (supplemental)
    CR2 -->|"get"| Secrets
    CR2 -->|"create"| SAR
    CR2 -->|"get, list, watch"| MaaSCRDs
    CR2 -->|"get"| Gateways

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB1 fill:#b8d4f0,stroke:#333
    style CRB2 fill:#b8d4f0,stroke:#333
    style CR1 fill:#f5a623,stroke:#333
    style CR2 fill:#f5a623,stroke:#333
    style Secrets fill:#ff6b6b,stroke:#333,color:#fff
    style Namespaces fill:#7ed321,stroke:#333
    style ServiceAccountsRes fill:#7ed321,stroke:#333
    style SATokens fill:#7ed321,stroke:#333
    style Endpoints fill:#7ed321,stroke:#333
    style TokenReviews fill:#e87d3e,stroke:#333,color:#fff
    style SAR fill:#e87d3e,stroke:#333,color:#fff
    style MaaSCRDs fill:#9b59b6,stroke:#333,color:#fff
    style HTTPRoutes fill:#3498db,stroke:#333,color:#fff
    style Gateways fill:#3498db,stroke:#333,color:#fff
    style WH_AITenant fill:#e74c3c,stroke:#333,color:#fff
    style WH_AuthPolicy fill:#e74c3c,stroke:#333,color:#fff
    style WH_Subscription fill:#e74c3c,stroke:#333,color:#fff
