graph TD
    subgraph "Deployment Executor"
        Admin["Cluster Administrator<br/>(cluster-admin)"]
    end

    subgraph "Pod Security RBAC (redhat-ods-applications)"
        direction TB
        PSBinding["applications-ns-rolebinding<br/>(RoleBinding)"]
        PSRole["Pod Security Role"]
    end

    subgraph "OSD Managed RBAC"
        direction TB
        OSDConfigs["rhods-osd-configs<br/>(RoleBinding)"]
        DedicatedAdmins["dedicated-admins<br/>(Group)"]
    end

    subgraph "Self-Managed RBAC"
        direction TB
        RhodsAdmins["rhods-admins<br/>(Group)"]
    end

    subgraph "Monitoring RBAC (from prometheus.yaml)"
        direction TB
        PromSA["prometheus-k8s<br/>(ServiceAccount)"]
        PromRole["Prometheus ClusterRole"]
    end

    subgraph "Namespaces Managed"
        NS_Apps["redhat-ods-applications"]
        NS_Mon["redhat-ods-monitoring"]
        NS_NB["rhods-notebooks"]
    end

    subgraph "Topology Detection"
        OSD_Check{"addon-managed-odh-catalog<br/>CatalogSource?"}
    end

    %% Admin creates all RBAC
    Admin -->|"applies via deploy.sh"| PSBinding
    Admin -->|"detects topology"| OSD_Check

    OSD_Check -->|"yes"| OSDConfigs
    OSD_Check -->|"no"| RhodsAdmins

    %% Pod Security bindings
    PSBinding -->|"grants in"| NS_Apps
    PSBinding -->|"references"| PSRole

    %% OSD RBAC
    OSDConfigs -->|"grants"| DedicatedAdmins
    DedicatedAdmins -->|"access to"| NS_Apps
    DedicatedAdmins -->|"access to"| NS_Mon

    %% Self-managed RBAC
    RhodsAdmins -->|"admin access to"| NS_Apps

    %% Prometheus RBAC
    PromSA -->|"bound via"| PromRole
    PromRole -->|"scrapes metrics in"| NS_Apps
    PromSA -->|"runs in"| NS_Mon

    %% Styling
    style Admin fill:#4a90e2,stroke:#333,color:#fff
    style PSBinding fill:#f5a623,stroke:#333
    style PSRole fill:#f5a623,stroke:#333
    style OSDConfigs fill:#ffe6cc,stroke:#d79b00
    style DedicatedAdmins fill:#ffe6cc,stroke:#d79b00
    style RhodsAdmins fill:#d5e8d4,stroke:#82b366
    style PromSA fill:#e6522c,stroke:#333,color:#fff
    style PromRole fill:#e6522c,stroke:#333,color:#fff
    style OSD_Check fill:#fff2cc,stroke:#d6b656
    style NS_Apps fill:#dae8fc,stroke:#6c8ebf
    style NS_Mon fill:#dae8fc,stroke:#6c8ebf
    style NS_NB fill:#dae8fc,stroke:#6c8ebf
