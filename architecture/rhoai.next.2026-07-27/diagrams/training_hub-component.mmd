graph TB
    subgraph TrainingHub["Training Hub (Python Library)"]
        direction TB

        subgraph ConvenienceFunctions["Convenience Functions (User API)"]
            sft["sft()"]
            osft["osft()"]
            lora_sft["lora_sft()"]
            lora_grpo["lora_grpo()"]
            gepa_fn["gepa()"]
        end

        subgraph AlgorithmLayer["Algorithm Layer"]
            Registry["AlgorithmRegistry<br/>Runtime discovery & selection"]
            SFTAlgo["SFT Algorithm"]
            OSFTAlgo["OSFT Algorithm"]
            LoRASFTAlgo["LoRA SFT Algorithm"]
            LoRAGRPOAlgo["LoRA GRPO Algorithm"]
            GEPAAlgo["GEPA Algorithm"]
        end

        subgraph BackendLayer["Backend Layer (Pluggable)"]
            InstructLab["instructlab-training<br/>Backend"]
            MiniTrainer["rhai-innovation-mini-trainer<br/>Backend"]
            Unsloth["unsloth<br/>Backend"]
            ART["openpipe-art<br/>Backend"]
            Verl["verl<br/>Backend"]
            GEPABackend["gepa<br/>Backend"]
        end

        subgraph Utilities["Auxiliary Modules"]
            GPUProfiler["GPU Memory<br/>Profiler/Estimator"]
            ITSRollout["ITS Hub Rollout<br/>Integration"]
            RewardFns["Reward Functions<br/>(Tool-Call Verification)"]
            LossViz["Loss Visualization"]
        end
    end

    %% User API to Algorithm routing
    sft -->|delegates| SFTAlgo
    osft -->|delegates| OSFTAlgo
    lora_sft -->|delegates| LoRASFTAlgo
    lora_grpo -->|delegates| LoRAGRPOAlgo
    gepa_fn -->|delegates| GEPAAlgo

    %% Registry manages algorithms
    Registry -.->|registers| SFTAlgo
    Registry -.->|registers| OSFTAlgo
    Registry -.->|registers| LoRASFTAlgo
    Registry -.->|registers| LoRAGRPOAlgo
    Registry -.->|registers| GEPAAlgo

    %% Algorithms to Backends
    SFTAlgo -->|dispatches| InstructLab
    SFTAlgo -->|dispatches| MiniTrainer
    OSFTAlgo -->|dispatches| InstructLab
    LoRASFTAlgo -->|dispatches| Unsloth
    LoRAGRPOAlgo -->|dispatches| ART
    LoRAGRPOAlgo -->|dispatches| Verl
    GEPAAlgo -->|dispatches| GEPABackend

    %% External frameworks
    User[User Code] -->|imports| sft
    User -->|imports| osft
    User -->|imports| lora_sft
    User -->|imports| lora_grpo
    User -->|imports| gepa_fn

    %% Backend execution models
    Verl -->|subprocess<br/>Ray/torchrun| Workers["Distributed Workers"]
    ART -->|co-located<br/>vLLM AsyncLLM| Engine["vLLM Engine"]

    %% Styling
    style TrainingHub fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style ConvenienceFunctions fill:#d5e8d4,stroke:#82b366
    style AlgorithmLayer fill:#fff2cc,stroke:#d6b656
    style BackendLayer fill:#dae8fc,stroke:#6c8ebf
    style Utilities fill:#f8cecc,stroke:#b85450
    style User fill:#f5f5f5,stroke:#666,stroke-width:2px
    style Registry fill:#f5a623,stroke:#333
    style Workers fill:#e8e8e8,stroke:#999
    style Engine fill:#e8e8e8,stroke:#999
