graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / External Client<br/>Bearer Token"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>{registry-name}-https<br/>443/TCP → 8443/TCP<br/>TLS re-encrypt"]
        HTTPRoute["Gateway API HTTPRoute<br/>data-science-gateway<br/>→ 8443/TCP"]
        CatalogRoute["Route: model-catalog-https<br/>443/TCP → 8443/TCP<br/>TLS"]
        CatalogHTTPRoute["HTTPRoute: model-catalog<br/>data-science-gateway"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph OperatorPlane["Operator Control Plane"]
            OperatorMgr["controller-manager<br/>SA: model-registry-operator-controller-manager"]
            WebhookSrv["Webhook Server :9443/TCP<br/>HTTPS TLS<br/>/convert, /mutate, /validate<br/>Failure: fail"]
            MetricsSrv["Metrics :8443/TCP<br/>HTTPS TLS<br/>TokenReview + SAR"]
            HealthSrv["Health :8081/TCP<br/>HTTP (unauthenticated)"]
        end

        subgraph PerRegistry["Per-Registry ({registry-name})"]
            RegProxy["kube-rbac-proxy<br/>:8443/TCP HTTPS TLS<br/>TokenReview + SAR"]
            RegRest["rest-container<br/>:8080/TCP HTTP<br/>(localhost only)"]
            RegPostgres["PostgreSQL<br/>:5432/TCP<br/>Secret: {name}-postgres-credentials"]
            RegNP["NetworkPolicy<br/>(pod isolation)"]
        end

        subgraph CatalogZone["Model Catalog (singleton)"]
            CatProxy["kube-rbac-proxy<br/>:8443/TCP HTTPS TLS<br/>TokenReview + SAR"]
            CatRest["catalog container<br/>:8080/TCP HTTP<br/>(localhost only)"]
            CatPostgres["PostgreSQL<br/>:5432/TCP<br/>Secret: model-catalog-postgres"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        KubeAPI["Kubernetes API Server<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        OpenShiftAPI["OpenShift API<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>Routes, Users, Groups, TLS Profiles"]
    end

    %% External → Ingress flows
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Route
    Client -->|"HTTPS<br/>Bearer Token"| HTTPRoute
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| CatalogRoute
    Client -->|"HTTPS<br/>Bearer Token"| CatalogHTTPRoute

    %% Ingress → Internal flows
    Route -->|"HTTPS/8443<br/>TLS"| RegProxy
    HTTPRoute -->|"HTTPS/8443<br/>TLS"| RegProxy
    CatalogRoute -->|"HTTPS/8443<br/>TLS"| CatProxy
    CatalogHTTPRoute -->|"HTTPS/8443<br/>TLS"| CatProxy

    %% Internal proxy → backend flows
    RegProxy -->|"HTTP/8080<br/>localhost<br/>authenticated"| RegRest
    RegRest -->|"PostgreSQL/5432"| RegPostgres
    CatProxy -->|"HTTP/8080<br/>localhost<br/>authenticated"| CatRest
    CatRest -->|"PostgreSQL/5432"| CatPostgres

    %% kube-rbac-proxy → API Server (auth delegation)
    RegProxy -->|"TokenReview<br/>+ SAR"| KubeAPI
    CatProxy -->|"TokenReview<br/>+ SAR"| KubeAPI

    %% Operator → API Server
    OperatorMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>CRUD resources"| KubeAPI
    OperatorMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>Routes, Groups"| OpenShiftAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef proxy fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef extsvc fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Route,HTTPRoute,CatalogRoute,CatalogHTTPRoute ingress
    class OperatorMgr,WebhookSrv,MetricsSrv,HealthSrv operator
    class RegProxy,CatProxy proxy
    class RegRest,CatRest internal
    class RegPostgres,CatPostgres database
    class RegNP internal
    class KubeAPI,OpenShiftAPI extsvc
