graph TB
    subgraph "kube-rbac-proxy Sidecar"
        CLI["Cobra CLI<br/>cmd/kube-rbac-proxy/main.go"]
        TLS["TLS Listener<br/>Port 8443<br/>TLS 1.2+ / HTTP/2"]
        AuthN["Authentication Filter<br/>pkg/authn"]
        AuthZ["Authorization Filter<br/>pkg/authz"]
        Proxy["Reverse Proxy<br/>pkg/proxy"]
        CertReloader["Certificate Reloader<br/>pkg/tls.CertReloader"]
        HealthEndpoint["/healthz Endpoint<br/>Unauthenticated"]

        CLI -->|initializes| TLS
        CLI -->|initializes| HealthEndpoint
        TLS -->|incoming requests| AuthN
        AuthN -->|authenticated| AuthZ
        AuthZ -->|authorized| Proxy
        CertReloader -.->|hot-reload certs| TLS
    end

    subgraph "Authorization Chain"
        UnionAuth["Union Authorizer"]
        HardcodedAuth["Hardcoded Metrics<br/>Authorizer"]
        StaticAuth["Static Authorizer<br/>Config File Rules"]
        SARAuth["SAR Authorizer<br/>SubjectAccessReview"]

        AuthZ -->|delegates to| UnionAuth
        UnionAuth -->|1| HardcodedAuth
        UnionAuth -->|2| StaticAuth
        UnionAuth -->|3| SARAuth
    end

    subgraph "Authentication Methods"
        OIDCAuth["OIDC Authenticator<br/>--oidc-issuer"]
        TokenReview["Delegating TokenReview<br/>authentication.k8s.io/v1"]

        AuthN -->|OIDC mode| OIDCAuth
        AuthN -->|delegating mode| TokenReview
    end

    Client[External Client] -->|HTTPS/8443| TLS
    Client -.->|health check| HealthEndpoint

    Proxy -->|HTTP/localhost| UpstreamSvc["Upstream Service<br/>e.g. Metrics Endpoint<br/>Port 8080"]

    TokenReview -->|TokenReview API| K8sAPI["Kubernetes API<br/>Port 6443"]
    SARAuth -->|SubjectAccessReview| K8sAPI

    style CLI fill:#4a90e2,color:#fff
    style TLS fill:#4a90e2,color:#fff
    style AuthN fill:#e8744f,color:#fff
    style AuthZ fill:#e8744f,color:#fff
    style Proxy fill:#4a90e2,color:#fff
    style CertReloader fill:#4a90e2,color:#fff
    style HealthEndpoint fill:#7ed321,color:#fff
    style UnionAuth fill:#f5a623,color:#fff
    style HardcodedAuth fill:#f5a623,color:#fff
    style StaticAuth fill:#f5a623,color:#fff
    style SARAuth fill:#f5a623,color:#fff
    style OIDCAuth fill:#9b59b6,color:#fff
    style TokenReview fill:#9b59b6,color:#fff
    style K8sAPI fill:#999,color:#fff
    style UpstreamSvc fill:#999,color:#fff
    style Client fill:#f9f9f9,stroke:#333
