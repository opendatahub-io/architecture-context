graph TD
    subgraph SecurityPosture["TrustyAI Service Security Posture"]
        direction TB

        subgraph AuthN["Authentication"]
            NoAuth["⚠ NO AUTHENTICATION<br/>MIDDLEWARE REGISTERED<br/><br/>No auth decorators<br/>No dependency injection guards<br/>No middleware registrations<br/><br/>All 87 endpoints unprotected<br/>at application level"]
        end

        subgraph ExternalEnforcement["Expected External Enforcement"]
            Route["OpenShift Route<br/>(expected)"]
            Istio["Istio Sidecar<br/>(expected)"]
            APIGateway["API Gateway<br/>(expected)"]
        end

        subgraph RBAC["RBAC Configuration"]
            NoRBAC["No ClusterRoles defined<br/>No RoleBindings defined<br/>No ServiceAccounts referenced<br/>in analyzed manifests"]
        end

        subgraph Secrets["Secret References"]
            DBPass["DATABASE_PASSWORD<br/>Type: environment variable<br/>Provisioned: runtime<br/>Rotation: Unknown"]
            QuarkusPass["QUARKUS_DATASOURCE_PASSWORD<br/>Type: environment variable<br/>Provisioned: runtime<br/>Rotation: Unknown"]
        end

        subgraph EndpointExposure["Endpoint Exposure (87 total)"]
            Ingestion["Ingestion (3)<br/>POST /, POST /consumer/kserve/v2,<br/>POST /data/upload"]
            Metadata["Metadata (8)<br/>/info/*"]
            FairnessEP["Fairness (24)<br/>/spd/*, /dir/*,<br/>/metrics/group/fairness/*"]
            DriftEP["Drift (30)<br/>/metrics/drift/*"]
            BatchIdentity["Batch & Identity (13)<br/>/metrics/batchmean/*,<br/>/metrics/identity/*"]
            ExplainerEP["Explainers (6)<br/>ALL return 501<br/>⚠ Still routable"]
            HealthEP["Health & Metrics (3)<br/>/q/health/*, /q/metrics"]
        end
    end

    Route -.->|"TLS termination<br/>+ auth"| Ingestion
    Istio -.->|"mTLS + policy"| Ingestion
    APIGateway -.->|"token validation"| Ingestion

    DBPass -.->|"credential for"| MariaDB["MariaDB Backend<br/>(optional)"]
    QuarkusPass -.->|"credential for"| MariaDB

