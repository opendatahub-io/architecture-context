graph TB
    subgraph "ML Metadata Component"
        direction TB
        Server["metadata_store_server<br/>C++ gRPC Binary<br/>Port 8080"]
        ServiceImpl["MetadataStoreService<br/>~45 RPCs"]
        Server -->|hosts| ServiceImpl
    end

    subgraph "API Surface"
        direction TB
        TypeMgmt["Type Management<br/>Put/Get ArtifactType<br/>Put/Get ExecutionType<br/>Put/Get ContextType"]
        EntityCRUD["Entity CRUD<br/>Put/Get Artifacts<br/>Put/Get Executions<br/>Put/Get Contexts"]
        EventTracking["Event Tracking<br/>Put/Get Events"]
        Relationships["Relationship Mgmt<br/>Attributions<br/>Associations<br/>ParentContexts"]
        Lineage["Lineage Queries<br/>GetLineageSubgraph"]
    end

    ServiceImpl -->|provides| TypeMgmt
    ServiceImpl -->|provides| EntityCRUD
    ServiceImpl -->|provides| EventTracking
    ServiceImpl -->|provides| Relationships
    ServiceImpl -->|provides| Lineage

    subgraph "Python Client"
        MetadataStore["MetadataStore Class<br/>Python Client Bindings"]
    end

    subgraph "Database Backends"
        MySQL["MySQL<br/>via libmysqlclient"]
        PostgreSQL["PostgreSQL"]
        SQLite["SQLite / In-Memory<br/>(testing only)"]
    end

    MetadataStore -->|gRPC/8080| Server
    Pipelines["ML Pipelines<br/>(DSP)"] -->|gRPC/8080| Server
    Server -->|persists to| MySQL
    Server -->|persists to| PostgreSQL
    Server -->|persists to| SQLite

    subgraph "Container Runtime"
        Container["odh-mlmd-grpc-server<br/>UBI9 Base Image<br/>User: 65534:65534<br/>Built via Bazel + Konflux"]
    end

    Container -->|runs| Server

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style ServiceImpl fill:#4a90e2,stroke:#333,color:#fff
    style MetadataStore fill:#7ed321,stroke:#333
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#f5a623,stroke:#333
    style Container fill:#e8e8e8,stroke:#333
    style Pipelines fill:#7ed321,stroke:#333
    style TypeMgmt fill:#dae8fc,stroke:#6c8ebf
    style EntityCRUD fill:#dae8fc,stroke:#6c8ebf
    style EventTracking fill:#dae8fc,stroke:#6c8ebf
    style Relationships fill:#dae8fc,stroke:#6c8ebf
    style Lineage fill:#dae8fc,stroke:#6c8ebf
