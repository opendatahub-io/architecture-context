graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
        MCPClient["MCP Client"]
    end

    subgraph Ingress["INGRESS (Identity Enforcement)"]
        Proxy["kube-rbac-proxy<br/>(cluster mode)<br/>Enforces X-User + X-Tenant<br/>403 on missing headers"]
    end

    subgraph Application["APPLICATION SERVICES"]
        direction TB

        APIServer["EvalHub API Server<br/>Configurable Port<br/>Optional TLS 1.2-1.3<br/>FIPS: InsecureSkipVerify=false"]
        MCPServer["EvalHub MCP Server<br/>Configurable Port<br/>stdio / HTTP / SSE<br/>Optional TLS"]
        Metrics["Metrics Server<br/>Dedicated Port<br/>HTTP (plaintext)<br/>/metrics endpoint"]
    end

    subgraph Egress["EGRESS (Outbound)"]
        direction TB

        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        PostgreSQL["PostgreSQL<br/>pgx/v5 + otelsql<br/>Primary Storage"]
        SQLite["SQLite<br/>modernc.org/sqlite<br/>Embedded Storage"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>AWS SDK v2 Credentials"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC or OTLP/HTTP<br/>Configurable TLS + gzip"]
        MLflowSvc["MLflow<br/>Results Export"]
    end

    %% External to Ingress
    Client -->|"HTTP/HTTPS<br/>Optional TLS 1.2-1.3<br/>X-User + X-Tenant"| Proxy
    MCPClient -->|"stdio / HTTP / SSE<br/>Optional TLS"| Proxy

    %% Ingress to Application
    Proxy -->|"HTTP<br/>Identity headers forwarded"| APIServer
    Proxy -->|"HTTP<br/>Identity headers forwarded"| MCPServer

    %% Application to Egress
    APIServer -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    APIServer -->|"PostgreSQL protocol<br/>otelsql instrumented"| PostgreSQL
    APIServer -->|"Embedded driver"| SQLite
    APIServer -->|"HTTP/HTTPS<br/>AWS SDK v2"| S3
    APIServer -->|"OTLP gRPC/HTTP<br/>Configurable TLS"| OTel
    APIServer -->|"HTTP<br/>mlflowclient"| MLflowSvc
    MCPServer -->|"Delegates to API"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,MCPClient external
    class Proxy ingress
    class APIServer,MCPServer,Metrics application
    class K8sAPI,PostgreSQL,SQLite,S3,OTel,MLflowSvc egress
