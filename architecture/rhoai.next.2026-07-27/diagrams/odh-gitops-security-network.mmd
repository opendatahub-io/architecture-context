graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph GatewayLayer["INGRESS (Gateway Layer)"]
        direction TB
        InferGW["inference-gateway<br/>80/443 TCP<br/>TLS termination<br/>(Istio Gateway / Gateway API)"]
        MaaSGW["maas-default-gateway<br/>80/443 TCP<br/>TLS termination<br/>(Istio Gateway / Gateway API)"]
    end

    subgraph AuthLayer["AUTHENTICATION (Policy Enforcement)"]
        Authorino["Authorino (Kuadrant)<br/>Auth policy enforcement<br/>SSL_CERT_FILE=<br/>/etc/pki/tls/custom/ca.crt"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio)"]
        direction TB

        subgraph InferenceNS["Inference Namespace"]
            KServe["KServe InferenceService<br/>Istio proxy sidecar<br/>rhai-ca-bundle mounted"]
        end

        subgraph MaaSNS["MaaS Namespace"]
            MaaSAPI["MaaS API Services"]
        end
    end

    subgraph CertMgmt["CERTIFICATE MANAGEMENT"]
        CertMgr["cert-manager<br/>Issuer: rhai-ca-issuer"]
        CABundle["rhai-ca-bundle<br/>ConfigMap"]
        CertMgr -->|issues certs| TLSSecrets["TLS Secrets"]
        CertMgr -->|populates| CABundle
    end

    subgraph GitOpsDelivery["GITOPS DELIVERY (Configuration Source)"]
        Repo["odh-gitops Repository"]
        ArgoCD["ArgoCD / Flux"]
        Repo -->|sync| ArgoCD
    end

    subgraph TargetCluster["TARGET CLUSTER"]
        direction TB
        subgraph OpenShift["OpenShift (OLM)"]
            OLM["OLM Subscriptions<br/>(12 operators, tri-state)"]
            DSC["DataScienceCluster CR<br/>(14 RHOAI components)"]
            OLM -->|InstallPlans| DSC
        end

        subgraph XKS["xKS (AWS / Azure / CoreWeave)"]
            CloudMgr["CloudManager Operator"]
            KubeEngine["KubernetesEngine CR<br/>Dependency policies:<br/>Managed/Unmanaged"]
            CloudMgr -->|reconciles| KubeEngine
        end
    end

    %% Traffic Flows
    Client -->|"HTTPS/443<br/>TLS terminated<br/>at gateway"| InferGW
    Client -->|"HTTPS/443<br/>TLS terminated<br/>at gateway"| MaaSGW

    InferGW -->|"HTTPRoute<br/>mTLS (Istio sidecar)"| KServe
    MaaSGW -->|"Auth callback<br/>TLS (rhai-ca-bundle)"| Authorino
    Authorino -->|"Auth result"| MaaSGW
    MaaSGW -->|"Forward<br/>mTLS (Istio sidecar)"| MaaSAPI

    %% Certificate flows
    TLSSecrets -->|"TLS listeners"| InferGW
    TLSSecrets -->|"TLS listeners"| MaaSGW
    CABundle -->|"mounted into<br/>istio-proxy"| KServe
    CABundle -->|"SSL_CERT_FILE<br/>patch"| Authorino

    %% GitOps delivery
    ArgoCD -->|"kubectl apply -k /<br/>helm install"| OpenShift
    ArgoCD -->|"kubectl apply -k /<br/>helm install"| XKS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#e6d5f7,stroke:#9673a6,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef certmgmt fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gitops fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class InferGW,MaaSGW ingress
    class Authorino auth
    class KServe,MaaSAPI servicemesh
    class CertMgr,CABundle,TLSSecrets certmgmt
    class Repo,ArgoCD gitops
    class OLM,DSC,CloudMgr,KubeEngine cluster
