graph TB
    subgraph "vllm-cpu Inference Server"
        direction TB

        subgraph "API Layer (FastAPI)"
            direction LR
            OpenAIRouter["OpenAI-Compatible Router<br/>/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models<br/>/v1/responses"]
            AnthropicRouter["Anthropic-Compatible Router<br/>/v1/messages"]
            SageMakerRouter["SageMaker Router<br/>/invocations<br/>/ping"]
            NativeRouter["Native vLLM Router<br/>/generate<br/>/generative_scoring<br/>/tokenize"]
            PoolingRouter["Pooling Router<br/>/pooling<br/>/classify<br/>/score<br/>/rerank"]
            OpsRouter["Operational Router<br/>/health<br/>/ready<br/>/load<br/>/version"]
            MgmtRouter["Management Router<br/>/v1/load_lora_adapter<br/>/v1/unload_lora_adapter<br/>/start_profile<br/>/stop_profile"]
        end

        AuthMiddleware["ASGI AuthenticationMiddleware<br/>Bearer Token (VLLM_API_KEY)"]

        subgraph "Core Engine"
            AsyncLLMEngine["AsyncLLMEngine<br/>CPU-optimized inference"]
            ModelBackend["Model Backend<br/>CPU execution"]
        end

        subgraph "Extensions"
            LoRAPlugin["LoRA Plugin System<br/>Adapter load/unload"]
            MCPTools["MCP Tool Integrations<br/>(optional)"]
        end

        RealTimeWS["WebSocket<br/>/v1/realtime"]
    end

    Client["External Client"] -->|"HTTP/HTTPS :8000<br/>Bearer Token"| AuthMiddleware
    WSClient["WebSocket Client"] -->|"WS/WSS :8000"| RealTimeWS

    AuthMiddleware --> OpenAIRouter
    AuthMiddleware --> AnthropicRouter
    AuthMiddleware --> SageMakerRouter
    AuthMiddleware --> NativeRouter
    AuthMiddleware --> PoolingRouter
    AuthMiddleware --> OpsRouter
    AuthMiddleware --> MgmtRouter

    OpenAIRouter --> AsyncLLMEngine
    AnthropicRouter --> AsyncLLMEngine
    SageMakerRouter --> AsyncLLMEngine
    NativeRouter --> AsyncLLMEngine
    PoolingRouter --> AsyncLLMEngine
    MgmtRouter --> LoRAPlugin
    AsyncLLMEngine --> ModelBackend
    LoRAPlugin --> AsyncLLMEngine

    MCPTools -->|"HTTPS (Exa API)"| ExaSearch["Exa Search API"]
    MCPTools -->|"Docker socket"| DockerDaemon["Docker Daemon<br/>Code Sandbox"]

    subgraph "External Services"
        ExaSearch
        DockerDaemon
        S3["S3 Storage"]
        ModelScope["ModelScope Hub"]
    end

    AsyncLLMEngine -.->|"Model download<br/>HTTPS"| S3
    AsyncLLMEngine -.->|"Model download<br/>HTTPS"| ModelScope

