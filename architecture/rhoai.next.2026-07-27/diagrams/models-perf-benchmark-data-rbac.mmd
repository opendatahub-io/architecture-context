graph TD
    subgraph "models-perf-benchmark-data RBAC"
        direction TB

        Note["This component defines no RBAC resources.<br/><br/>It is a data-only init container that:<br/>- Has no controllers or operators<br/>- Defines no ClusterRoles or Roles<br/>- Defines no RoleBindings<br/>- Defines no ServiceAccounts<br/><br/>RBAC for the model-catalog deployment<br/>is managed by model-registry-operator<br/>in the opendatahub namespace."]
    end

    subgraph "Deployment Context RBAC (managed by model-registry-operator)"
        direction TB

        SA["ServiceAccount<br/>(managed by operator)"]
        Pod["model-catalog Pod<br/>(includes init container)"]

        SA -->|"runs as"| Pod
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Pod fill:#7ed321,stroke:#333,color:#fff
