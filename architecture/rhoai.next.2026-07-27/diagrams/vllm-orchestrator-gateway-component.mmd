graph TB
    subgraph "vllm-orchestrator-gateway"
        direction TB
        Main["Axum HTTP Server<br/>Port 8090"]
        Router["Route Handler<br/>POST /{route}/v1/chat/completions"]
        DetectorInjector["Detector Injector<br/>Injects input/output detector params"]
        OrchestratorProxy["Orchestrator Proxy<br/>Forwards to /api/v2/chat/completions-detection"]
        DetectionChecker["Detection Checker<br/>Evaluates detections, applies fallback"]
        StreamHandler["SSE Stream Handler<br/>Streaming response support"]
        JSONHandler["JSON Response Handler<br/>Non-streaming responses"]
        TLSConfig["mTLS Configuration<br/>OpenSSL / native-tls"]
        ConfigLoader["Config Loader<br/>YAML route & detector config"]
    end

    Client[Client] -->|"POST /{route}/v1/chat/completions<br/>Port 8090"| Main
    Main --> Router
    Router --> DetectorInjector
    DetectorInjector --> OrchestratorProxy

    ConfigLoader -->|"GATEWAY_CONFIG env<br/>config/config.yaml"| Router
    ConfigLoader -->|"detector_params"| DetectorInjector

    OrchestratorProxy -->|"HTTP(S) POST<br/>Authorization + x-forwarded-*"| Orchestrator["Guardrails Orchestrator<br/>/api/v2/chat/completions-detection"]
    TLSConfig -->|"mTLS certs<br/>/etc/tls/private/"| OrchestratorProxy

    Orchestrator -->|"Response with detections"| DetectionChecker
    DetectionChecker -->|"stream=true"| StreamHandler
    DetectionChecker -->|"stream=false"| JSONHandler
    StreamHandler -->|"SSE KeepAlive"| Client
    JSONHandler -->|"JSON Response"| Client

    Orchestrator -->|"proxies to"| vLLM["vLLM Inference Endpoint"]

    style Main fill:#4a90e2,stroke:#333
    style Router fill:#4a90e2,stroke:#333
    style DetectorInjector fill:#4a90e2,stroke:#333
    style OrchestratorProxy fill:#4a90e2,stroke:#333
    style DetectionChecker fill:#4a90e2,stroke:#333
    style StreamHandler fill:#4a90e2,stroke:#333
    style JSONHandler fill:#4a90e2,stroke:#333
    style TLSConfig fill:#4a90e2,stroke:#333
    style ConfigLoader fill:#4a90e2,stroke:#333
    style Client fill:#e8e8e8,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style vLLM fill:#7ed321,stroke:#333
