graph TB
    subgraph KubeflowComponent["Kubeflow Notebook Controller"]
        direction TB
        Controller["notebook-controller-deployment<br/>(Deployment)<br/>manager container<br/>ghcr.io/kubeflow/kubeflow/notebook-controller"]

        subgraph Reconcilers["Reconcilers"]
            NotebookReconciler["NotebookReconciler"]
            OpenshiftReconciler["OpenshiftNotebookReconciler"]
            CullingReconciler["CullingReconciler"]
        end

        subgraph Webhooks["Admission Webhooks"]
            ConvertWH["/convert<br/>Conversion Webhook"]
            MutateWH["/mutate-notebook-v1<br/>Mutating Webhook"]
            ValidateWH["/validate-notebook-v1<br/>Validating Webhook"]
        end

        subgraph Config["Configuration"]
            ConfigMap1["ConfigMap: config<br/>USE_ISTIO, ISTIO_GATEWAY, ISTIO_HOST"]
            ConfigMap2["ConfigMap: notebook-controller-culler-config<br/>ENABLE_CULLING, CULL_IDLE_TIME,<br/>IDLENESS_CHECK_PERIOD"]
        end

        Controller --> NotebookReconciler
        Controller --> OpenshiftReconciler
        Controller --> CullingReconciler
        Controller --> ConvertWH
        Controller --> MutateWH
        Controller --> ValidateWH
        ConfigMap1 -.->|env vars| Controller
        ConfigMap2 -.->|env vars| Controller
    end

    %% CRDs
    NotebookCR["Notebook CR<br/>kubeflow.org<br/>v1, v1alpha1, v1beta1"]
    User["Data Scientist / User"] -->|creates| NotebookCR
    NotebookCR -->|watched by| NotebookReconciler
    NotebookCR -->|watched by| OpenshiftReconciler
    NotebookCR -->|watched by| CullingReconciler
    MutateWH -->|mutates| NotebookCR
    ValidateWH -->|validates| NotebookCR

    %% Created Resources
    subgraph ManagedResources["Managed Resources"]
        StatefulSet["StatefulSet<br/>(Notebook Pod)"]
        Service["Service"]
        NetworkPolicy["NetworkPolicy"]
        HTTPRoute["HTTPRoute"]
        RoleBinding["RoleBinding"]
        OAuthClient["OAuthClient"]
    end

    NotebookReconciler -->|creates| StatefulSet
    NotebookReconciler -->|creates| Service
    OpenshiftReconciler -->|creates| NetworkPolicy
    OpenshiftReconciler -->|creates| HTTPRoute
    OpenshiftReconciler -->|creates| RoleBinding
    OpenshiftReconciler -->|manages| OAuthClient

    %% External Dependencies
    GatewayAPI["Gateway API"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    DSPipelines["data-science-pipelines-operator"]
    ImageStreams["OpenShift Image Streams"]

    OpenshiftReconciler -->|manages routes| GatewayAPI
    Controller -->|REST + WebSocket| K8sAPI
    OpenshiftReconciler -.->|library| DSPipelines
    OpenshiftReconciler -->|reads| ImageStreams

    %% Service
    SvcEndpoint["notebook-controller-service<br/>ClusterIP 443/TCP"]
    SvcEndpoint -->|routes to| Controller

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style NotebookCR fill:#f5a623,stroke:#333,color:#fff
    style NotebookReconciler fill:#4a90e2,stroke:#333,color:#fff
    style OpenshiftReconciler fill:#4a90e2,stroke:#333,color:#fff
    style CullingReconciler fill:#4a90e2,stroke:#333,color:#fff
    style ConvertWH fill:#9b59b6,stroke:#333,color:#fff
    style MutateWH fill:#9b59b6,stroke:#333,color:#fff
    style ValidateWH fill:#9b59b6,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style DSPipelines fill:#7ed321,stroke:#333,color:#fff
    style ImageStreams fill:#999,stroke:#333,color:#fff
    style User fill:#e8e8e8,stroke:#333
    style SvcEndpoint fill:#3498db,stroke:#333,color:#fff
