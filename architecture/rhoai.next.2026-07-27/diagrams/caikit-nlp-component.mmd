graph TB
    subgraph "caikit-nlp Library"
        direction TB
        Init["caikit_nlp<br/>Module Registration"]

        subgraph "Text Generation"
            TextGenLocal["TextGeneration<br/>(Local Inference)"]
            TextGenTGIS["TextGenerationTGIS<br/>(Remote TGIS Inference)"]
        end

        subgraph "Token Classification"
            FilteredSpan["FilteredSpanClassification<br/>(Token Classification)"]
        end

        subgraph "Tokenization"
            RegexSplitter["RegexSentenceSplitter<br/>(Sentence Splitting)"]
        end

        subgraph "Resources"
            PretrainedBase["PretrainedModelBase<br/>(Model Abstraction)"]
        end

        subgraph "Toolkit"
            TGISClient["TGISGenerationClient<br/>(gRPC Client Wrapper)"]
        end
    end

    subgraph "Caikit Runtime"
        gRPCServer["gRPC Server<br/>:8085"]
        RESTGateway["REST Gateway<br/>:8080"]
    end

    Client[Client] -->|gRPC| gRPCServer
    Client -->|HTTP/REST| RESTGateway
    gRPCServer -->|dispatches| Init
    RESTGateway -->|dispatches| Init
    Init -->|TextGenerationTask| TextGenLocal
    Init -->|TextGenerationTask| TextGenTGIS
    Init -->|TokenClassificationTask| FilteredSpan
    Init -->|TokenizationTask| RegexSplitter

    TextGenLocal -->|loads| PretrainedBase
    TextGenTGIS -->|delegates| TGISClient
    PretrainedBase -->|downloads| HFHub["HuggingFace Hub"]
    TGISClient -->|gRPC| TGISServer["TGIS Server<br/>(Remote)"]

    style Init fill:#4a90e2,color:#fff
    style TextGenLocal fill:#4a90e2,color:#fff
    style TextGenTGIS fill:#4a90e2,color:#fff
    style FilteredSpan fill:#4a90e2,color:#fff
    style RegexSplitter fill:#4a90e2,color:#fff
    style PretrainedBase fill:#4a90e2,color:#fff
    style TGISClient fill:#4a90e2,color:#fff
    style gRPCServer fill:#7ed321,color:#fff
    style RESTGateway fill:#7ed321,color:#fff
    style HFHub fill:#f5a623,color:#fff
    style TGISServer fill:#f5a623,color:#fff
    style Client fill:#e8e8e8,stroke:#333
