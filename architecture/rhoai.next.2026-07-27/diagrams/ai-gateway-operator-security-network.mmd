graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (ServiceAccount Auth)"]
        direction TB

        subgraph OperatorPod["ai-gateway-operator Deployment<br/>NS: redhat-ods-applications<br/>SA: ai-gateway-operator"]
            Controller["AIGateway Controller<br/>Image: controller:latest"]
            Health["/healthz, /readyz<br/>8081/HTTP<br/>Unauthenticated"]
            Metrics["Metrics<br/>8443/TCP TLS<br/>TokenReview + RBAC"]
        end

        subgraph MetricsSvc["ai-gateway-metrics-service (ClusterIP)"]
            SvcPort["8443/TCP → 8443"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>RBAC: ai-gateway-manager-role"]
    end

    subgraph PlatformCRDs["PLATFORM INTEGRATIONS (CRD CRUD via K8s API)"]
        direction TB

        subgraph APIGovernance["API Governance"]
            Kuadrant["Kuadrant<br/>AuthPolicies<br/>RateLimitPolicies<br/>TokenRateLimitPolicies"]
            Authorino["Authorino<br/>(Read-only)"]
        end

        subgraph ServiceMesh["Service Mesh"]
            Istio["Istio<br/>DestinationRules<br/>EnvoyFilters<br/>ServiceEntries<br/>Telemetries"]
        end

        subgraph TLS["TLS Management"]
            CertMgr["cert-manager<br/>Certificates"]
        end

        subgraph Routing["Routing"]
            GatewayAPI["Gateway API<br/>HTTPRoutes<br/>Gateways (R/O)<br/>ReferenceGrants (R/O)"]
        end

        subgraph Observability["Observability"]
            PromOp["prometheus-operator<br/>ServiceMonitors<br/>PodMonitors<br/>PrometheusRules"]
            OTel["OpenTelemetry<br/>Collectors"]
            Perses["Perses<br/>Dashboards<br/>DataSources"]
        end
    end

    subgraph ManagedCRDs["MANAGED CRD FAMILIES"]
        direction LR
        BatchCRDs["batch.llm-d.ai<br/>LLMBatchGateways"]
        MaaSCRDs["maas.opendatahub.io<br/>AITenants, Configs<br/>ExternalModels, etc."]
        InferenceCRDs["inference.opendatahub.io<br/>ExternalModels<br/>ExternalProviders"]
    end

    subgraph ODHPlatform["ODH/RHOAI PLATFORM"]
        DSCI["DSCInitialization<br/>(Watch/Read)"]
        KServe["KServe<br/>InferenceService<br/>LLMInferenceService<br/>(Watch/Read)"]
    end

    %% Flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Metrics --> SvcPort

    K8sAPI -->|"Watch/CRUD"| Kuadrant
    K8sAPI -->|"Watch"| Authorino
    K8sAPI -->|"Watch/CRUD"| Istio
    K8sAPI -->|"CRUD"| CertMgr
    K8sAPI -->|"CRUD"| GatewayAPI
    K8sAPI -->|"CRUD"| PromOp
    K8sAPI -->|"CRUD"| OTel
    K8sAPI -->|"CRUD"| Perses
    K8sAPI -->|"Full lifecycle"| BatchCRDs
    K8sAPI -->|"Full lifecycle"| MaaSCRDs
    K8sAPI -->|"Full lifecycle"| InferenceCRDs
    K8sAPI -->|"Watch"| DSCI
    K8sAPI -->|"Watch"| KServe

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef healthendpoint fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef metricsendpoint fill:#ffe6cc,stroke:#d79b00,stroke-width:1px
    classDef k8sapi fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platformcrd fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef managedcrd fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef odhplatform fill:#d5e8d4,stroke:#82b366,stroke-width:1px

    class Controller operator
    class Health healthendpoint
    class Metrics metricsendpoint
    class K8sAPI k8sapi
    class Kuadrant,Authorino,Istio,CertMgr,GatewayAPI,PromOp,OTel,Perses platformcrd
    class BatchCRDs,MaaSCRDs,InferenceCRDs managedcrd
    class DSCI,KServe odhplatform
