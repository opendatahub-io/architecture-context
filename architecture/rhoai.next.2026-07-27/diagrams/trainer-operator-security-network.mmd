graph TB
    subgraph ClusterInternal["CLUSTER-INTERNAL (No External Ingress)"]
        direction TB

        subgraph AdmissionZone["ADMISSION WEBHOOK ZONE"]
            APIServer["kube-apiserver"]
            WebhookSvc["kubeflow-trainer-controller-manager<br/>Service (ClusterIP)<br/>443/TCP → 9443/TCP<br/>TLS (webhook-cert)"]
        end

        subgraph OperatorPod["OPERATOR POD"]
            Controller["TrainerReconciler<br/>SA: controller-manager"]
            WebhookServer["Webhook Server<br/>:9443/TCP TLS"]
            MetricsEndpoint["Metrics Endpoint<br/>:8080/TCP HTTP<br/>⚠ PLAINTEXT (SecureServing: false)"]
            HealthEndpoint["Health Probes<br/>:8081/TCP HTTP<br/>/healthz, /readyz"]
        end

        subgraph MonitoringZone["MONITORING"]
            Prometheus["Prometheus<br/>(via PodMonitor)"]
        end

        subgraph ManagedController["MANAGED CONTROLLER"]
            KubeflowCtrl["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>Deployment"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES (Kubernetes API)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
        PrometheusOp["prometheus-operator<br/>(CRD management)"]
        OLM["OLM<br/>(operators.coreos.com)"]
        ImageStreams["OpenShift Image Streams<br/>(image.openshift.io)"]
    end

    %% Admission webhook flow
    APIServer -->|"HTTPS/443<br/>TLS<br/>Kubernetes Admission"| WebhookSvc
    WebhookSvc -->|"9443/TCP<br/>TLS (webhook-cert)"| WebhookServer

    %% Monitoring flow
    Prometheus -->|"HTTP/8080<br/>⚠ No TLS<br/>No Auth"| MetricsEndpoint

    %% Health probes
    Kubelet["kubelet"] -->|"HTTP/8081<br/>No Auth"| HealthEndpoint

    %% Operator → Kubernetes API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token Auth"| K8sAPI

    %% Managed controller → Kubernetes API
    KubeflowCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token Auth"| K8sAPI

    %% Operator → Platform services (via K8s API)
    Controller -.->|"CRD CRUD<br/>HTTPS"| PrometheusOp
    Controller -.->|"CRD Watch<br/>HTTPS"| OLM
    Controller -.->|"REST<br/>HTTPS"| ImageStreams

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef warning fill:#e74c3c,stroke:#333,stroke-width:2px,color:#fff
    classDef webhook fill:#9b59b6,stroke:#333,stroke-width:2px,color:#fff
    classDef platform fill:#95a5a6,stroke:#333,stroke-width:2px,color:#fff
    classDef managed fill:#27ae60,stroke:#333,stroke-width:2px,color:#fff
    classDef monitoring fill:#f39c12,stroke:#333,stroke-width:2px,color:#fff

    class Controller operator
    class WebhookServer webhook
    class MetricsEndpoint warning
    class HealthEndpoint operator
    class K8sAPI,PrometheusOp,OLM,ImageStreams platform
    class KubeflowCtrl managed
    class Prometheus monitoring
    class APIServer,WebhookSvc webhook
