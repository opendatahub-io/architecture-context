graph TD
    subgraph AppAuth["Application-Level Authentication"]
        direction TB

        subgraph InboundAuth["Inbound Authentication (Port 8033)"]
            TLS["TLS/mTLS Acceptor<br/>(rustls + ring)<br/>TLS 1.2+ optional"]
            HeaderPass["Header Passthrough Filter<br/>Configured allowlist"]
            TokenRewrite["Token Rewrite<br/>X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
        end

        subgraph HealthAuth["Health Server (Port 8034)"]
            NoAuth["Unauthenticated<br/>GET /health<br/>GET /info"]
        end
    end

    subgraph Secrets["Secrets & Credentials"]
        TLSCert["TLS Server Cert/Key<br/>Type: kubernetes.io/tls<br/>Provisioned by: Platform operator / cert-manager"]
        ClientCA["TLS Client CA Cert<br/>Type: Opaque<br/>Provisioned by: Platform operator<br/>Purpose: mTLS client verification"]
        APITokens["API Tokens<br/>Type: Opaque (env var)<br/>Provisioned by: Platform operator<br/>Purpose: Downstream Bearer tokens"]
        DownstreamTLS["Downstream TLS Certs<br/>Type: Opaque<br/>Provisioned by: Platform operator<br/>Purpose: Named TLS configs"]
    end

    subgraph RBAC["Kubernetes RBAC"]
        NoRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>(Application service -<br/>no K8s API access required)"]
    end

    TLS -->|"uses"| TLSCert
    TLS -->|"uses for client verify"| ClientCA
    HeaderPass --> TokenRewrite

    subgraph DownstreamAuth["Downstream Authentication"]
        TGISAuth["TGIS: No Auth"]
        ChunkerAuth["Chunker: No Auth<br/>TLS optional"]
        DetectorAuth["Detector: Bearer optional<br/>TLS optional"]
        DetHealthAuth["Detector Health: No Auth"]
    end

    APITokens -->|"loaded at config time"| DetectorAuth
    DownstreamTLS -->|"named TLS config"| ChunkerAuth
    DownstreamTLS -->|"named TLS config"| DetectorAuth

    style InboundAuth fill:#bbdefb,stroke:#1565c0
    style HealthAuth fill:#c8e6c9,stroke:#2e7d32
    style Secrets fill:#fff2cc,stroke:#d6b656
    style RBAC fill:#f5f5f5,stroke:#999
    style DownstreamAuth fill:#e8e8e8,stroke:#333
    style NoRBAC fill:#f5f5f5,stroke:#999,stroke-dasharray: 5 5
