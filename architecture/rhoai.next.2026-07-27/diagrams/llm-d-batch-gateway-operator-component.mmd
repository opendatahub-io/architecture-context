graph TB
    subgraph Operator["llm-d-batch-gateway-operator"]
        direction TB
        Manager["Controller Manager<br/>(manager container)"]
        LLMBatchGatewayReconciler["LLMBatchGateway<br/>Reconciler"]
        MetricsController["Metrics<br/>Controller"]
        HelmRenderer["Helm Chart<br/>Renderer"]

        Manager --> LLMBatchGatewayReconciler
        Manager --> MetricsController
        LLMBatchGatewayReconciler --> HelmRenderer
    end

    subgraph HelmCharts["Embedded Helm Charts"]
        BatchGatewayChart["/charts/batch-gateway"]
        AsyncProcessorChart["/charts/async-processor"]
    end

    subgraph ManagedWorkloads["Managed Workloads (per LLMBatchGateway CR)"]
        APIServer["API Server<br/>(batch job HTTP API)"]
        Processor["Request Processor<br/>(inference dispatch)"]
        GC["Garbage Collector<br/>(job/file cleanup)"]
        AsyncProcessor["Async Processor<br/>(Redis queue dispatch)<br/>optional: dispatchMode=async"]
    end

    User[User / Admin] -->|creates| LLMBatchGatewayCR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1"]
    LLMBatchGatewayCR -->|watched by| LLMBatchGatewayReconciler

    HelmRenderer -->|renders| BatchGatewayChart
    HelmRenderer -->|renders| AsyncProcessorChart
    BatchGatewayChart -->|produces| APIServer
    BatchGatewayChart -->|produces| Processor
    BatchGatewayChart -->|produces| GC
    AsyncProcessorChart -->|produces| AsyncProcessor

    LLMBatchGatewayReconciler -->|creates/manages| Deployments["Deployments"]
    LLMBatchGatewayReconciler -->|creates/manages| Services["Services"]
    LLMBatchGatewayReconciler -->|creates/manages| ConfigMaps["ConfigMaps"]
    LLMBatchGatewayReconciler -->|creates/manages| ServiceAccounts["ServiceAccounts"]
    LLMBatchGatewayReconciler -->|creates/manages| HTTPRoutes["HTTPRoutes"]
    LLMBatchGatewayReconciler -->|creates/manages| Certificates["cert-manager Certificates"]
    LLMBatchGatewayReconciler -->|syncs cross-ns| Secrets["Secrets"]

    MetricsController -->|manages| ServiceMonitors["ServiceMonitors"]
    MetricsController -->|manages| PodMonitors["PodMonitors"]
    MetricsController -->|manages| PrometheusRules["PrometheusRules"]

    LLMBatchGatewayReconciler -->|checks| ReferenceGrant["ReferenceGrant<br/>(cross-ns authz)"]

    %% Environment variable image injection
    EnvVars["Environment Variables<br/>LLM_D_BATCH_GATEWAY_APISERVER_IMAGE<br/>LLM_D_BATCH_GATEWAY_PROCESSOR_IMAGE<br/>LLM_D_BATCH_GATEWAY_GC_IMAGE<br/>LLM_D_ASYNC_IMAGE"] -.->|pins images| HelmRenderer

    style Manager fill:#4a90e2,color:#fff
    style LLMBatchGatewayReconciler fill:#4a90e2,color:#fff
    style MetricsController fill:#4a90e2,color:#fff
    style HelmRenderer fill:#4a90e2,color:#fff
    style LLMBatchGatewayCR fill:#f5a623,color:#fff
    style APIServer fill:#7ed321,color:#fff
    style Processor fill:#7ed321,color:#fff
    style GC fill:#7ed321,color:#fff
    style AsyncProcessor fill:#7ed321,color:#fff
    style ReferenceGrant fill:#e8e8e8
    style EnvVars fill:#fff2cc,stroke:#d6b656
