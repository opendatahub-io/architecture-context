graph TB
    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS, TLS 1.2+<br/>ServiceAccount Token Auth"]
    end

    subgraph KueueNS["KUEUE NAMESPACE"]
        direction TB

        subgraph ControllerPod["kueue-controller-manager Pod<br/>SA: kueue-controller-manager"]
            direction TB
            WebhookServer["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (kueue-webhook-server-cert)<br/>K8s Admission Auth"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>No Encryption<br/>No Auth"]
            MetricsServer["Metrics Server<br/>8443/TCP HTTPS<br/>TLS<br/>TokenReview+SubjectAccessReview"]
        end

        subgraph InternalServices["ClusterIP Services"]
            WebhookSvc["kueue-webhook-service<br/>443/TCP → 9443/TCP"]
            MetricsSvc["kueue-metrics-service<br/>8443/TCP"]
        end
    end

    subgraph WatchedResources["WATCHED NAMESPACES (Cluster-Scoped)"]
        direction TB

        subgraph KueueCRDs["Kueue CRDs (kueue.x-k8s.io)"]
            CQ["ClusterQueue<br/>LocalQueue<br/>Workload"]
            RF["ResourceFlavor<br/>AdmissionCheck<br/>Cohort"]
            MK["MultiKueueCluster<br/>Topology<br/>WorkloadPriorityClass"]
        end

        subgraph FrameworkCRDs["Framework CRDs"]
            Batch["batch/Job"]
            KF["kubeflow.org<br/>PyTorchJob, TFJob<br/>MPIJob, XGBoostJob, PaddleJob"]
            Ray["ray.io<br/>RayJob, RayCluster"]
            Other["JobSet, AppWrapper<br/>LeaderWorkerSet<br/>Pod, Deployment, StatefulSet"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes :8443"]
    end

    %% Flows
    K8sAPI -->|"Admission Webhook<br/>443/TCP → 9443/TCP<br/>HTTPS, TLS<br/>K8s Admission Auth"| WebhookSvc
    WebhookSvc --> WebhookServer

    ControllerPod -->|"Watch/CRUD Resources<br/>6443/TCP<br/>HTTPS, TLS 1.2+<br/>SA Token (in-cluster)"| K8sAPI

    K8sAPI -->|"Health Check<br/>8081/TCP HTTP<br/>No Auth"| HealthProbes

    Prometheus -->|"Scrape Metrics<br/>8443/TCP HTTPS<br/>TLS, RBAC-gated"| MetricsSvc
    MetricsSvc --> MetricsServer

    ControllerPod -.->|"Reconciles"| KueueCRDs
    ControllerPod -.->|"Manages"| FrameworkCRDs

    %% Styling
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef kueuens fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef webhook fill:#f5a623,stroke:#333,stroke-width:1px
    classDef health fill:#7ed321,stroke:#333,stroke-width:1px
    classDef metrics fill:#9673a6,stroke:#333,stroke-width:1px,color:#fff
    classDef resources fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class K8sAPI controlplane
    class WebhookServer webhook
    class HealthProbes health
    class MetricsServer metrics
    class WebhookSvc,MetricsSvc service
    class CQ,RF,MK,Batch,KF,Ray,Other resources
    class Prometheus monitoring
