    style D_RBAC fill:#7ed321,stroke:#333
    style D_Nodes fill:#7ed321,stroke:#333
    style D_Feast fill:#7ed321,stroke:#333
    style D_MLflow fill:#7ed321,stroke:#333
    style D_SR fill:#7ed321,stroke:#333

    style M_MLflow fill:#9b59b6,stroke:#333,color:#fff
    style M_SSAR fill:#9b59b6,stroke:#333,color:#fff
    style M_Impersonate fill:#9b59b6,stroke:#333,color:#fff
    style M_Sandboxes fill:#9b59b6,stroke:#333,color:#fff
    style M_MCP fill:#9b59b6,stroke:#333,color:#fff
    style M_OTel fill:#9b59b6,stroke:#333,color:#fff

    style O_Dashboard fill:#e74c3c,stroke:#333,color:#fff
    style O_Deploy fill:#e74c3c,stroke:#333,color:#fff
    style O_Network fill:#e74c3c,stroke:#333,color:#fff
    style O_Gateway fill:#e74c3c,stroke:#333,color:#fff
    style O_RBAC fill:#e74c3c,stroke:#333,color:#fff
    style O_CRD fill:#e74c3c,stroke:#333,color:#fff
    style O_OAuth fill:#e74c3c,stroke:#333,color:#fff
    style O_Routes fill:#e74c3c,stroke:#333,color:#fff
    style O_Impersonate fill:#e74c3c,stroke:#333,color:#fff

    style AU_HW fill:#ddd,stroke:#333
    style AU_NIM fill:#ddd,stroke:#333
    style AU_LLMI fill:#ddd,stroke:#333
    style AU_EvalHub fill:#ddd,stroke:#333
    style AU_MR fill:#ddd,stroke:#333
    style AU_Sandbox fill:#ddd,stroke:#333
