graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Dashboard["odh-dashboard<br/>(redhat-ods-applications)"]
        SA_Modules["odh-dashboard-modules<br/>(redhat-ods-applications)"]
        SA_Operator["dashboard-operator<br/>(system)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Dashboard["odh-dashboard"]
        CRB_AuthDelegator["odh-dashboard-auth-delegator"]
        CRB_Monitoring["odh-dashboard-cluster-monitoring"]
        CRB_Modules["odh-dashboard-modules"]
        CRB_Operator["dashboard-operator-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Dashboard["odh-dashboard"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Monitoring["cluster-monitoring-view"]
        CR_Modules["odh-dashboard-modules"]
        CR_Operator["dashboard-operator-role"]
    end

    subgraph DashboardPerms["odh-dashboard Permissions"]
        direction LR
        D_Core["core/v1<br/>configmaps, secrets, PVCs<br/>CRUD"]
        D_Notebooks["kubeflow.org<br/>notebooks<br/>CRUD"]
        D_IS["serving.kserve.io<br/>inferenceservices<br/>read"]
        D_MR["modelregistry.opendatahub.io<br/>modelregistries<br/>CRUD"]
        D_DSC["datasciencecluster.opendatahub.io<br/>datascienceclusters<br/>read"]
        D_DSCI["dscinitialization.opendatahub.io<br/>dscinitializations<br/>read"]
        D_Auth["authentication/authorization<br/>tokenreviews, SSAR<br/>create"]
        D_RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings, CRBs<br/>CRUD"]
        D_Nodes["core/v1<br/>nodes<br/>read"]
        D_Feast["feast.dev<br/>featurestores<br/>read"]
        D_MLflow["mlflow.opendatahub.io<br/>mlflows<br/>read"]
        D_SR["serving.kserve.io<br/>servingruntimes<br/>CRUD"]
    end

    subgraph ModulesPerms["odh-dashboard-modules Permissions"]
        direction LR
        M_MLflow["mlflow.opendatahub.io<br/>mlflows<br/>read"]
        M_SSAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
        M_Impersonate["core/v1<br/>groups, SA, users<br/>impersonate"]
        M_Sandboxes["agents.x-k8s.io<br/>sandboxes<br/>read"]
        M_MCP["mcp.kagenti.com<br/>mcpserverregistrations<br/>read"]
        M_OTel["opentelemetry.io<br/>otelcollectors<br/>CRUD"]
    end

    subgraph OperatorPerms["dashboard-operator-role Permissions"]
        direction LR
        O_Dashboard["components.platform.opendatahub.io<br/>dashboards + status + finalizers<br/>CRUD"]
        O_Deploy["apps/v1<br/>deployments, replicasets<br/>CRUD"]
        O_Network["networking.k8s.io<br/>networkpolicies, ingresses<br/>CRUD"]
        O_Gateway["gateway.networking.k8s.io<br/>httproutes<br/>CRUD"]
        O_RBAC["rbac.authorization.k8s.io<br/>roles, CRs, CRBs<br/>CRUD"]
        O_CRD["apiextensions.k8s.io<br/>CRDs<br/>CRUD"]
        O_OAuth["oauth.openshift.io<br/>oauthclients<br/>CRUD"]
        O_Routes["route.openshift.io<br/>routes<br/>CRUD"]
        O_Impersonate["core/v1<br/>groups, SA, users<br/>impersonate"]
    end

    subgraph AllUsersRoles["Aggregated Roles (system:authenticated)"]
        AU_HW["fetch-hardware-profiles-role<br/>hardwareprofiles (read)"]
        AU_NIM["nim-account-access<br/>accounts (read)"]
        AU_LLMI["model-serving-llmisvcconfig-role<br/>llminferenceserviceconfigs (read)"]
        AU_EvalHub["trustyai-evalhubs-role<br/>evalhubs (read)"]
        AU_MR["fetch-model-registry-ui-config-role<br/>configmaps (get)"]
        AU_Sandbox["aggregate-agent-sandbox-permissions<br/>sandboxes (read + patch)"]
    end

    %% SA → CRB connections
    SA_Dashboard -->|bound via| CRB_Dashboard
    SA_Dashboard -->|bound via| CRB_AuthDelegator
    SA_Dashboard -->|bound via| CRB_Monitoring
    SA_Modules -->|bound via| CRB_Modules
    SA_Operator -->|bound via| CRB_Operator

    %% CRB → CR connections
    CRB_Dashboard -->|grants| CR_Dashboard
    CRB_AuthDelegator -->|grants| CR_AuthDelegator
    CRB_Monitoring -->|grants| CR_Monitoring
    CRB_Modules -->|grants| CR_Modules
    CRB_Operator -->|grants| CR_Operator

    %% CR → Permissions
    CR_Dashboard -->|includes| DashboardPerms
    CR_Modules -->|includes| ModulesPerms
    CR_Operator -->|includes| OperatorPerms

    %% Styling
    style SA_Dashboard fill:#4a90e2,stroke:#333,color:#fff
    style SA_Modules fill:#4a90e2,stroke:#333,color:#fff
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff

    style CR_Dashboard fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_Monitoring fill:#f5a623,stroke:#333
    style CR_Modules fill:#f5a623,stroke:#333
    style CR_Operator fill:#f5a623,stroke:#333

    style CRB_Dashboard fill:#e8e8e8,stroke:#333
    style CRB_AuthDelegator fill:#e8e8e8,stroke:#333
    style CRB_Monitoring fill:#e8e8e8,stroke:#333
    style CRB_Modules fill:#e8e8e8,stroke:#333
    style CRB_Operator fill:#e8e8e8,stroke:#333

