graph TB
    subgraph WVA["Workload Variant Autoscaler"]
        direction TB

        subgraph Controllers["Controllers"]
            ConfigMapCtrl["ConfigMap Controller<br/>Watches ConfigMaps for<br/>runtime configuration"]
            HPACtrl["HPA Controller<br/>Watches HorizontalPodAutoscalers"]
            InferencePoolCtrl["InferencePool Controller<br/>Watches InferencePool v1 &amp; v1alpha2"]
            ScaledObjectCtrl["ScaledObject Controller<br/>Watches KEDA ScaledObjects<br/>(conditional)"]
        end

        subgraph Engines["Engine Loops"]
            SaturationEngine["Saturation Engine<br/>Queries Prometheus metrics<br/>Computes optimal replicas"]
            ScaleFromZeroEngine["Scale-from-Zero Engine<br/>Handles cold-start scaling<br/>via dynamic client"]
        end

        subgraph Shared["Shared Components"]
            Datastore["Datastore<br/>Shared state between<br/>controllers and engines"]
            Coordinator["Coordinator (Experimental)<br/>GPU rebalancing via<br/>plugin architecture"]
        end

        ConfigMapCtrl --> Datastore
        HPACtrl --> Datastore
        InferencePoolCtrl --> Datastore
        ScaledObjectCtrl --> Datastore
        SaturationEngine --> Datastore
        ScaleFromZeroEngine --> Datastore
        Coordinator -.->|experimental| Datastore
    end

    subgraph Manager["controller-manager Deployment"]
        HealthProbe[":8081/healthz, /readyz<br/>HTTP, Unauthenticated"]
        MetricsEndpoint[":8443/metrics<br/>HTTPS, TokenReview+SAR"]
        LeaderElection["Leader Election<br/>60s lease, 50s renew"]
    end

    %% External Resources Watched
    ConfigMapCR["ConfigMap Resources"] -->|watched by| ConfigMapCtrl
    HPACR["HPA Resources"] -->|watched by| HPACtrl
    InferencePoolCR["InferencePool CRs<br/>v1 &amp; v1alpha2"] -->|watched by| InferencePoolCtrl
    ScaledObjectCR["ScaledObject CRs<br/>(KEDA)"] -.->|conditionally watched| ScaledObjectCtrl

    %% External Dependencies
    SaturationEngine -->|queries metrics| Prometheus["Prometheus API"]
    SaturationEngine -->|reads EPP metrics| EPP["EPP Metrics Endpoint"]
    ScaleFromZeroEngine -->|scales| K8sAPI["Kubernetes API<br/>6443/HTTPS"]

    %% Conditional Features
    LWS["LeaderWorkerSet CRD"] -.->|conditional at startup| WVA

    style WVA fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Controllers fill:#dbeafe,stroke:#4a90e2
    style Engines fill:#dcfce7,stroke:#22c55e
    style Shared fill:#fef3c7,stroke:#f59e0b
    style Manager fill:#f3e8ff,stroke:#a855f7

    style ConfigMapCtrl fill:#4a90e2,color:#fff
    style HPACtrl fill:#4a90e2,color:#fff
    style InferencePoolCtrl fill:#4a90e2,color:#fff
    style ScaledObjectCtrl fill:#4a90e2,color:#fff,stroke-dasharray: 5 5

    style SaturationEngine fill:#22c55e,color:#fff
    style ScaleFromZeroEngine fill:#22c55e,color:#fff

    style Datastore fill:#f59e0b,color:#fff
    style Coordinator fill:#f59e0b,color:#fff,stroke-dasharray: 5 5

    style Prometheus fill:#e8e8e8,stroke:#333
    style EPP fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style LWS fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5

    style ConfigMapCR fill:#f5a623
    style HPACR fill:#f5a623
    style InferencePoolCR fill:#f5a623
    style ScaledObjectCR fill:#f5a623,stroke-dasharray: 5 5
