graph TD
    subgraph Note["RBAC Summary"]
        direction TB
        Info["No Kubernetes RBAC roles defined.<br/>This component does not interact<br/>with the Kubernetes API."]
    end

    subgraph AppAuth["Application-Level Authorization"]
        direction TB

        subgraph TenantExtraction["Tenant Extraction"]
            Header["HTTP Header<br/>X-MaaS-Username<br/>(configurable)"]
            Middleware["request_middleware.go<br/>Extracts tenant ID<br/>from request header"]
        end

        subgraph TenantEnforcement["Tenant Enforcement"]
            BatchHandler["batch_handler.go<br/>Validates TenantID<br/>on all batch CRUD"]
            FileHandler["file_handler.go<br/>Validates TenantID<br/>on all file CRUD"]
        end

        subgraph DataIsolation["Data Isolation"]
            PGFilter["PostgreSQL<br/>Row-level filtering<br/>by tenant_id column"]
            RedisFilter["Redis/Valkey<br/>Key-level filtering<br/>tenant ID in tags"]
            S3Prefix["S3/Filesystem<br/>Prefix isolation<br/>SHA256(tenant_id)"]
        end
    end

    subgraph Secrets["Kubernetes Secrets"]
        BGSecrets["batch-gateway-secrets<br/>(Opaque)<br/>Manual provisioning<br/>No auto-rotation"]
        TLSSecret["{release}-batch-gateway-<br/>apiserver-tls<br/>(kubernetes.io/tls)<br/>cert-manager or manual"]
    end

    subgraph SecretContents["Secret Keys"]
        RedisURL["redis-url"]
        PGURL["postgresql-url"]
        APIKey["inference-api-key"]
        S3Key["s3-secret-access-key"]
    end

    %% Flows
    Header -->|"extracted by"| Middleware
    Middleware -->|"tenant context"| BatchHandler
    Middleware -->|"tenant context"| FileHandler
    BatchHandler -->|"filtered queries"| PGFilter
    BatchHandler -->|"filtered queries"| RedisFilter
    FileHandler -->|"filtered queries"| PGFilter
    FileHandler -->|"path prefix"| S3Prefix

    BGSecrets --- RedisURL
    BGSecrets --- PGURL
    BGSecrets --- APIKey
    BGSecrets --- S3Key

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style Info fill:#fff3cd,stroke:#856404
    style Header fill:#4a90e2,stroke:#333,color:#fff
    style Middleware fill:#4a90e2,stroke:#333,color:#fff
    style BatchHandler fill:#7ed321,stroke:#333,color:#fff
    style FileHandler fill:#7ed321,stroke:#333,color:#fff
    style PGFilter fill:#336791,stroke:#333,color:#fff
    style RedisFilter fill:#dc382d,stroke:#333,color:#fff
    style S3Prefix fill:#569a31,stroke:#333,color:#fff
    style BGSecrets fill:#f5a623,stroke:#333,color:#fff
    style TLSSecret fill:#f5a623,stroke:#333,color:#fff
    style RedisURL fill:#ffeaa7,stroke:#333
    style PGURL fill:#ffeaa7,stroke:#333
    style APIKey fill:#ffeaa7,stroke:#333
    style S3Key fill:#ffeaa7,stroke:#333
