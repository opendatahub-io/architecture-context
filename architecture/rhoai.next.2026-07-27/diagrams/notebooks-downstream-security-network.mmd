graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist<br/>End User"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route / HAProxy<br/>443/TCP → 8443/TCP<br/>TLS Re-encrypt<br/>Managed by Notebook Controller"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (StatefulSet)"]
        direction TB

        subgraph OAuthContainer["OAuth Proxy Sidecar"]
            OAuthProxy["OAuth Proxy<br/>8443/TCP HTTPS<br/>OpenShift OAuth<br/>Injected at deploy time"]
        end

        subgraph IDEContainer["IDE Server Container (notebooks-downstream image)"]
            Jupyter["Jupyter Server<br/>8888/TCP HTTP<br/>localhost only"]
            CodeServerNginx["code-server + nginx<br/>8080/TCP HTTP<br/>localhost only"]
            RStudioServer["RStudio Server<br/>8787/TCP HTTP<br/>localhost only"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (User-configured at runtime)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM / Access Keys<br/>Client: boto3, minio"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS configurable<br/>Client: psycopg"]
        MongoDB["MongoDB<br/>27017/TCP<br/>TLS configurable<br/>Client: pymongo"]
        MySQL["MySQL<br/>3306/TCP<br/>TLS configurable<br/>Client: mysql-connector-python"]
        Kafka["Apache Kafka<br/>9092/TCP<br/>TLS + SASL configurable<br/>Client: kafka-python-ng"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS<br/>OAuth redirect"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth token"| OAuthProxy
    OAuthProxy -->|"HTTP/8888 or 8080 or 8787<br/>No encryption (localhost)<br/>Trusted proxy"| Jupyter
    OAuthProxy -->|"HTTP/8080<br/>localhost"| CodeServerNginx
    OAuthProxy -->|"HTTP/8787<br/>localhost"| RStudioServer

    Jupyter -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM/Keys"| S3
    Jupyter -->|"5432/TCP<br/>TLS optional<br/>Credentials"| PostgreSQL
    Jupyter -->|"27017/TCP<br/>TLS optional<br/>SCRAM/X.509"| MongoDB
    Jupyter -->|"3306/TCP<br/>TLS optional<br/>Credentials"| MySQL
    Jupyter -->|"9092/TCP<br/>TLS+SASL<br/>Configurable"| Kafka

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef oauth fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef ide fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy oauth
    class Jupyter,CodeServerNginx,RStudioServer ide
    class S3,PostgreSQL,MongoDB,MySQL,Kafka externalservice
