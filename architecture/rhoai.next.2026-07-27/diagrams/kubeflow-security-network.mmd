graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / User"]
    end

    subgraph K8sControl["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>ServiceAccount / OIDC"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (Trusted)"]
        direction TB

        Service["notebook-controller-service<br/>ClusterIP 443/TCP"]

        subgraph Controller["notebook-controller-deployment"]
            Manager["manager container<br/>ghcr.io/kubeflow/kubeflow/notebook-controller<br/>SA: notebook-controller-service-account"]

            subgraph WebhookEndpoints["Webhook Endpoints (HTTPS TLS)"]
                Convert["/convert<br/>POST"]
                Mutate["/mutate-notebook-v1<br/>POST"]
                Validate["/validate-notebook-v1<br/>POST"]
            end

            subgraph HealthEndpoints["Health Endpoints (HTTP :8081)"]
                Healthz["/healthz GET<br/>No Auth"]
                Readyz["/readyz GET<br/>No Auth"]
            end
        end

        subgraph ConfigSources["Configuration"]
            CM1["ConfigMap: config<br/>USE_ISTIO, ISTIO_GATEWAY"]
            CM2["ConfigMap: culler-config<br/>ENABLE_CULLING, CULL_IDLE_TIME"]
        end
    end

    subgraph UserNS["MANAGED RESOURCES (User Namespaces)"]
        direction TB
        StatefulSet["StatefulSet<br/>(Notebook Pod)"]
        SvcManaged["Service"]
        NetPol["NetworkPolicy"]
        HTTPRoute["HTTPRoute"]
        RB["RoleBinding"]
        OAuth["OAuthClient<br/>(Cluster-scoped)"]
    end

    subgraph PlatformInteg["PLATFORM INTEGRATIONS"]
        GatewayAPI["Gateway API<br/>HTTPS TLS 1.2+"]
        ImageStreams["OpenShift Image Streams<br/>6443/TCP HTTPS"]
        Routes["OpenShift Routes<br/>HTTPS TLS 1.2+"]
        DSP["data-science-pipelines-operator<br/>(Go library)"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| APIServer
    APIServer -->|"HTTPS/443<br/>TLS<br/>K8s Admission Cert"| Service
    Service --> Manager
    CM1 -.->|env vars| Manager
    CM2 -.->|env vars| Manager

    Manager -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| APIServer

    Manager -->|creates| StatefulSet
    Manager -->|creates| SvcManaged
    Manager -->|creates| NetPol
    Manager -->|creates| HTTPRoute
    Manager -->|creates| RB
    Manager -->|manages| OAuth

    Manager -->|"HTTPRoute CRUD<br/>TLS 1.2+"| GatewayAPI
    Manager -->|"REST/6443<br/>TLS 1.2+"| ImageStreams
    Manager -->|"Watch<br/>TLS 1.2+"| Routes
    Manager -.->|"library import"| DSP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sapi fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef webhook fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef health fill:#d5e8d4,stroke:#82b366,stroke-width:1px

    class User external
    class APIServer k8sapi
    class Service,Manager,CM1,CM2 controller
    class Convert,Mutate,Validate webhook
    class Healthz,Readyz health
    class StatefulSet,SvcManaged,NetPol,HTTPRoute,RB,OAuth managed
    class GatewayAPI,ImageStreams,Routes,DSP platform
