graph TB
    subgraph "caikit-tgis-serving Runtime"
        CaikitTGIS["caikit-tgis-serving<br/>Python Package"]
        Convert["convert.py<br/>Model Conversion Utility"]
    end

    subgraph "Python Dependencies"
        Caikit["caikit 0.28.1"]
        CaikitNLP["caikit-nlp 0.5.14"]
        CaikitTGISBackend["caikit-tgis-backend 0.1.39"]
    end

    subgraph "Inference Infrastructure"
        KServeISVC["InferenceService CR<br/>(owned by KServe)"]
        ServingRuntime["ServingRuntime CR<br/>(owned by KServe)"]
        MetricsSvc["caikit-metrics-service<br/>Port 8086/TCP"]
    end

    subgraph "Ingress & Routing"
        ExternalGW["knative-ingress-gateway<br/>Istio Gateway<br/>443/TCP TLS SIMPLE"]
        InternalGW["knative-local-gateway<br/>ClusterIP 80 -> 8081/TCP"]
    end

    subgraph "Storage"
        MinIO["MinIO / S3-Compatible<br/>Port 9000/TCP"]
        StorageSecret["storage-config Secret<br/>(S3 credentials)"]
    end

    %% Internal dependencies
    CaikitTGIS -->|imports| Caikit
    CaikitTGIS -->|imports| CaikitNLP
    CaikitTGIS -->|imports| CaikitTGISBackend
    Convert -->|uses| Caikit

    %% Deployment via KServe
    KServeISVC -->|deploys| CaikitTGIS
    ServingRuntime -->|defines| CaikitTGIS

    %% Traffic flow
    ExternalGW -->|routes to| CaikitTGIS
    InternalGW -->|routes to| CaikitTGIS

    %% Model storage
    CaikitTGIS -->|loads models| MinIO
    StorageSecret -->|credentials| MinIO

    %% Metrics
    CaikitTGIS -->|exposes metrics| MetricsSvc

    %% Styling
    style CaikitTGIS fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Convert fill:#4a90e2,stroke:#333,color:#fff
    style Caikit fill:#b8d4f0,stroke:#333
    style CaikitNLP fill:#b8d4f0,stroke:#333
    style CaikitTGISBackend fill:#b8d4f0,stroke:#333
    style KServeISVC fill:#f5a623,stroke:#333
    style ServingRuntime fill:#f5a623,stroke:#333
    style MetricsSvc fill:#7ed321,stroke:#333
    style ExternalGW fill:#ffe6cc,stroke:#d79b00
    style InternalGW fill:#ffe6cc,stroke:#d79b00
    style MinIO fill:#fff2cc,stroke:#d6b656
    style StorageSecret fill:#f8cecc,stroke:#b85450
