graph TD
    subgraph Legend["RBAC Status"]
        Note["TGIS defines NO RBAC resources.<br/>It runs as an inference workload, not a controller.<br/>No ClusterRoles, Roles, or RoleBindings in manifests."]
    end

    subgraph PodSecurity["Pod Security Context"]
        Pod["TGIS Pod"]
        SA["ServiceAccount<br/>(default / platform-assigned)"]
    end

    subgraph OptionalSecurity["Optional Security Configuration"]
        TLSCert["TLS cert/key<br/>(Opaque/TLS Secret)<br/>Manual / cert-manager"]
        ClientCA["Client CA cert<br/>(Opaque Secret)<br/>Manual provisioning"]
    end

    subgraph ContainerSecurity["Container Security Measures"]
        ReadOnly["readOnlyRootFilesystem<br/>(optional patch)"]
        EmptyDirHome["emptyDir: /home/tgis"]
        EmptyDirTmp["emptyDir: /tmp"]
        EmptyDirShm["emptyDir: /dev/shm (1Gi)<br/>NCCL shared memory"]
        GPULimits["nvidia.com/gpu<br/>resource limits"]
    end

    subgraph AuthMechanisms["Authentication & Authorization"]
        gRPCAuth["gRPC (8033/TCP)<br/>Auth: Optional mTLS<br/>Policy: Client cert validation<br/>Enforcement: tonic gRPC server"]
        HTTPAuth["HTTP (3000/TCP)<br/>/health, /metrics<br/>Auth: None<br/>No authentication"]
    end

    Pod --> SA
    SA -.->|"No RBAC bindings<br/>defined"| Note

    TLSCert -->|"mounted to pod"| gRPCAuth
    ClientCA -->|"mTLS validation"| gRPCAuth

    ReadOnly --> EmptyDirHome
    ReadOnly --> EmptyDirTmp
    ReadOnly --> EmptyDirShm

    Pod --> GPULimits
    Pod --> gRPCAuth
    Pod --> HTTPAuth

