graph TB
    subgraph "rhoai-mcp Server"
        direction TB
        FastMCP["FastMCP Server<br/>Python / uvicorn"]
        PluginMgr["PluginManager<br/>(pluggy)"]
        OIDCMiddleware["OIDCAuthMiddleware<br/>ASGI Middleware"]
        ToolRBAC["Tool-Level RBAC<br/>SubjectAccessReview"]

        FastMCP -->|loads plugins| PluginMgr
        OIDCMiddleware -->|wraps| FastMCP
        FastMCP -->|enforces| ToolRBAC
    end

    subgraph "Plugin System"
        CorePlugins["Core Domain Plugins<br/>(workbenches, serving,<br/>pipelines, training,<br/>data connections)"]
        ExtPlugins["External Plugins<br/>(entrypoints)"]

        PluginMgr -->|loads| CorePlugins
        PluginMgr -->|discovers| ExtPlugins
    end

    subgraph "Auth Validators"
        OIDCValidator["OIDCValidator<br/>JWT + JWKS"]
        TokenReview["TokenReviewValidator<br/>OCP OAuth"]
    end

    Client["AI Agent / Client"] -->|MCP Protocol<br/>Bearer Token| OIDCMiddleware
    OIDCMiddleware -->|validates token| OIDCValidator
    OIDCMiddleware -->|validates token| TokenReview

    subgraph "Kubernetes Resources"
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
        Notebooks["Kubeflow Notebooks<br/>kubeflow.org"]
        InferenceService["KServe InferenceService<br/>serving.kserve.io"]
        TrainJobs["Kubeflow TrainJobs<br/>trainer.kubeflow.org"]
        DSPipelines["Data Science Pipelines<br/>opendatahub.io"]
        ServingRuntime["ServingRuntime CR<br/>serving.kserve.io"]
    end

    CorePlugins -->|CRUD| Notebooks
    CorePlugins -->|Watch| InferenceService
    CorePlugins -->|CRUD| TrainJobs
    CorePlugins -->|CRUD| DSPipelines
    CorePlugins -->|CRUD| ServingRuntime
    FastMCP -->|impersonation| K8sAPI
    ToolRBAC -->|SubjectAccessReview| K8sAPI

    HealthProbe["Health Probe"] -->|GET /health| FastMCP

    style FastMCP fill:#4a90e2,stroke:#333,color:#fff
    style PluginMgr fill:#4a90e2,stroke:#333,color:#fff
    style OIDCMiddleware fill:#e74c3c,stroke:#333,color:#fff
    style ToolRBAC fill:#e74c3c,stroke:#333,color:#fff
    style OIDCValidator fill:#f39c12,stroke:#333,color:#fff
    style TokenReview fill:#f39c12,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Notebooks fill:#7ed321,stroke:#333
    style InferenceService fill:#7ed321,stroke:#333
    style TrainJobs fill:#7ed321,stroke:#333
    style DSPipelines fill:#7ed321,stroke:#333
    style ServingRuntime fill:#7ed321,stroke:#333
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style HealthProbe fill:#f9f9f9,stroke:#999,stroke-width:2px
