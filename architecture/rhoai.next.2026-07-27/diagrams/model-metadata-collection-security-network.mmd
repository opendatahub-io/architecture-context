graph TB
    subgraph ExecutionEnv["CLI EXECUTION ENVIRONMENT<br/>(CI/CD Pipeline or Developer Workstation)"]
        direction TB

        subgraph CLITools["CLI Tools (No Listening Ports)"]
            ModelExtractor["model-extractor<br/>Batch extraction pipeline<br/>Concurrency: 5 goroutines"]
            MetadataReport["metadata-report<br/>Reporting (local files only)<br/>No network activity"]
        end

        subgraph Credentials["Credentials (.env file)"]
            HFToken["HF_TOKEN<br/>(optional)"]
            GHToken["GITHUB_TOKEN<br/>(optional)"]
            DockerAuth["Docker config.json<br/>(OCI registry auth)"]
        end

        ModelExtractor -.->|reads| HFToken
        ModelExtractor -.->|reads| GHToken
        ModelExtractor -.->|reads| DockerAuth
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Outbound Only)"]
        direction TB

        OCIRegistry["OCI Registry<br/>registry.redhat.io<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Docker config"]

        HuggingFace["HuggingFace API<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer HF_TOKEN"]

        GitHub["GitHub API<br/>api.github.com<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: Bearer GITHUB_TOKEN"]
    end

    subgraph LocalFS["LOCAL FILESYSTEM"]
        InputFiles["Input Files<br/>models-index.yaml<br/>mcp-servers-index.yaml<br/>agents-index.yaml"]
        OutputFiles["Output Files<br/>metadata.yaml (per model)<br/>models-catalog.yaml<br/>reports (MD + YAML)"]
    end

    %% Outbound flows
    ModelExtractor -->|"HTTPS/443<br/>TLS 1.2+<br/>GET manifests, blobs<br/>Docker config auth"| OCIRegistry
    ModelExtractor -->|"HTTPS/443<br/>TLS 1.2+<br/>GET /api/collections, /api/models<br/>Bearer HF_TOKEN (optional)"| HuggingFace
    ModelExtractor -->|"HTTPS/443<br/>TLS 1.2+<br/>GET repos/.../contents<br/>Bearer GITHUB_TOKEN (optional)"| GitHub

    %% Local I/O
    InputFiles -->|reads| ModelExtractor
    ModelExtractor -->|writes| OutputFiles
    OutputFiles -->|reads| MetadataReport

    %% Styling
    classDef cli fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef creds fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef filesystem fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class ModelExtractor,MetadataReport cli
    class HFToken,GHToken,DockerAuth creds
    class OCIRegistry,HuggingFace,GitHub external
    class InputFiles,OutputFiles filesystem
