graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph APILayer["API LAYER (ClusterIP Services)"]
        direction TB

        UI["ml-pipeline-ui<br/>80/TCP → 3000/TCP<br/>SA: ml-pipeline-ui"]
        API["ml-pipeline API Server<br/>8888/TCP (HTTP) · 8887/TCP (gRPC) · 8443/TCP (HTTPS)<br/>SA: ml-pipeline<br/>Auth: tokenreviews, subjectaccessreviews"]
        VizServer["ml-pipeline-visualizationserver<br/>8888/TCP<br/>HTTP"]
    end

    subgraph WebhookLayer["WEBHOOK LAYER (TLS)"]
        CacheServer["cache-server<br/>443/TCP → webhook-api<br/>HTTPS/TLS<br/>SA: kubeflow-pipelines-cache<br/>Cert: webhook-server-tls"]
    end

    subgraph MetadataPipeline["METADATA PIPELINE"]
        direction TB
        Envoy["metadata-envoy<br/>9090/TCP gRPC<br/>Envoy Proxy"]
        MLMD["metadata-grpc (MLMD Store)<br/>8080/TCP gRPC<br/>ml_metadata_store_server:1.14.0<br/>max_metadata_size=16384"]
        Writer["metadata-writer<br/>SA: kubeflow-pipelines-metadata-writer<br/>Watches Argo Workflows"]
    end

    subgraph Storage["STORAGE LAYER"]
        MySQL["MySQL 8.4<br/>3306/TCP<br/>Secret: mysql-secret"]
        SeaweedFS["SeaweedFS 4.30<br/>8333/TCP (S3) · 8888/TCP (Filer)<br/>9333/TCP (Master)<br/>Secret: mlpipeline-minio-artifact"]
    end

    subgraph Controllers["CONTROLLERS"]
        PersistAgent["persistence-agent<br/>SA: ml-pipeline-persistenceagent"]
        SchedWF["scheduled-workflow<br/>SA: ml-pipeline-scheduledworkflow"]
        ViewerCRD["viewer-crd<br/>SA: ml-pipeline-viewer-crd-service-account"]
        CacheDeployer["cache-deployer<br/>SA: kubeflow-pipelines-cache-deployer-sa"]
        ArgoWF["Argo Workflow Controller<br/>v3.7.14"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        Prometheus["Prometheus<br/>Inbound Scrape<br/>8888/TCP HTTP"]
        S3External["S3-compatible Storage<br/>Runtime configured<br/>HTTP/HTTPS"]
    end

    %% External → API Layer
    Client -->|"HTTP/80<br/>Web UI"| UI
    Client -->|"HTTP/8888<br/>REST API"| API
    Client -->|"gRPC/8887<br/>Pipeline Services"| API

    %% API Layer internal
    UI -->|"HTTP/8888"| API

    %% Webhook flow (Kubernetes admission)
    K8sAPI -->|"HTTPS/8443<br/>TLS<br/>Admission Webhook"| CacheServer

    %% Database connections (mysql-secret)
    API -->|"MySQL/3306<br/>mysql-secret"| MySQL
    CacheServer -->|"MySQL/3306<br/>mysql-secret"| MySQL
    MLMD -->|"MySQL/3306<br/>mysql-secret"| MySQL

    %% Object storage
    API -->|"S3/8333<br/>mlpipeline-minio-artifact"| SeaweedFS
    UI -->|"S3/8333<br/>mlpipeline-minio-artifact"| SeaweedFS

    %% Metadata pipeline
    Writer -->|"gRPC/9090"| Envoy
    Envoy -->|"gRPC/8080"| MLMD
    Writer -->|"Watch Workflows"| K8sAPI

    %% Controllers → K8s API
    API -->|"HTTPS/6443<br/>SA token<br/>RBAC"| K8sAPI
    PersistAgent -->|"HTTPS/6443<br/>SA token"| K8sAPI
    SchedWF -->|"HTTPS/6443<br/>SA token"| K8sAPI
    ViewerCRD -->|"HTTPS/6443<br/>SA token"| K8sAPI
    CacheDeployer -->|"HTTPS/6443<br/>SA token"| K8sAPI

    %% Argo
    SchedWF -->|"Creates Workflows"| ArgoWF
    PersistAgent -->|"Watches Workflows"| ArgoWF

    %% External services
    Prometheus -->|"HTTP/8888<br/>scrape /metrics"| API
    API -->|"HTTP/HTTPS<br/>Runtime config"| S3External

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#4a90e2,stroke:#2c5f8a,stroke-width:2px,color:#fff
    classDef webhook fill:#e67e22,stroke:#bf6516,stroke-width:2px,color:#fff
    classDef metadata fill:#2ecc71,stroke:#27ae60,stroke-width:2px,color:#fff
    classDef storage fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef controller fill:#7b68ee,stroke:#5b4ac7,stroke-width:2px,color:#fff
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class UI,API,VizServer api
    class CacheServer webhook
    class Envoy,MLMD,Writer metadata
    class MySQL,SeaweedFS storage
    class PersistAgent,SchedWF,ViewerCRD,CacheDeployer,ArgoWF controller
    class K8sAPI,Prometheus,S3External externalservice
