graph TB
    subgraph "guardrails-regex-detector Service"
        direction TB
        Main["main.rs<br/>Tokio Runtime"]
        Router["Axum Router"]
        TraceLayer["TraceLayer Middleware<br/>(tower-http)"]
        HealthHandler["Health Handler<br/>GET /health"]
        DetectorsHandler["Detectors Handler<br/>POST /api/v1/text/contents"]
        RegexEngine["Regex Engine<br/>(regex crate)"]

        Main -->|starts| Router
        Router -->|middleware| TraceLayer
        TraceLayer -->|routes| HealthHandler
        TraceLayer -->|routes| DetectorsHandler
        DetectorsHandler -->|uses| RegexEngine
    end

    Client[Client / Upstream Service] -->|"HTTP POST /api/v1/text/contents<br/>Port 8080"| Router
    HealthProbe[Health Probe] -->|"HTTP GET /health<br/>Port 8080"| Router

    HealthHandler -->|returns| HealthResp["'healthy' (string)"]
    DetectorsHandler -->|returns| DetectionResp["Detection Results (JSON)"]

    subgraph "Configuration"
        EnvPort["HTTP_PORT<br/>default: 8080"]
        EnvHost["HOST<br/>default: 0.0.0.0"]
    end

    EnvPort -.->|configures| Main
    EnvHost -.->|configures| Main

    style Main fill:#4a90e2,stroke:#333,color:#fff
    style Router fill:#4a90e2,stroke:#333,color:#fff
    style TraceLayer fill:#4a90e2,stroke:#333,color:#fff
    style HealthHandler fill:#4a90e2,stroke:#333,color:#fff
    style DetectorsHandler fill:#4a90e2,stroke:#333,color:#fff
    style RegexEngine fill:#4a90e2,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style HealthProbe fill:#e8e8e8,stroke:#333
    style HealthResp fill:#d5e8d4,stroke:#82b366
    style DetectionResp fill:#d5e8d4,stroke:#82b366
    style EnvPort fill:#fff2cc,stroke:#d6b656
    style EnvHost fill:#fff2cc,stroke:#d6b656
