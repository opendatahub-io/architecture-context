graph TB
    subgraph ModelMeshServing["ModelMesh Serving Controller"]
        direction TB
        SRController["ServingRuntime Controller<br/>Reconciles ServingRuntime &<br/>ClusterServingRuntime"]
        PredController["Predictor Controller<br/>Reconciles Predictor &<br/>InferenceService"]
        SvcController["Service Controller<br/>Manages headless Services<br/>& ServiceMonitors"]
        DeployController["Deployment Controller<br/>Reconciles Deployments"]
        EndpointsController["Endpoints Controller<br/>Reconciles Endpoints"]
        NSController["Namespace Controller<br/>Reconciles Namespaces"]
        HPAReconciler["HPA Reconciler<br/>Manages HorizontalPodAutoscaler"]
        Webhook["Validating Webhook<br/>Port 9443/TLS<br/>ServingRuntime validation"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        CSRCR["ClusterServingRuntime CR<br/>serving.kserve.io/v1alpha1<br/>Cluster-scoped"]
        SRCR["ServingRuntime CR<br/>serving.kserve.io/v1alpha1<br/>Namespaced"]
        PredCR["Predictor CR<br/>serving.kserve.io/v1alpha1<br/>Namespaced"]
        ISCR["InferenceService CR<br/>serving.kserve.io/v1beta1<br/>Namespaced"]
    end

    subgraph RuntimePods["Serving Runtime Pods"]
        ModelMeshSidecar["ModelMesh Sidecar<br/>gRPC"]
        ModelServer["Model Server Container"]
    end

    User["User / Data Scientist"] -->|"creates/updates"| SRCR
    User -->|"creates/updates"| PredCR
    User -->|"creates/updates"| ISCR

    CSRCR -->|"watched by"| SRController
    SRCR -->|"watched by"| SRController
    PredCR -->|"watched by"| PredController
    ISCR -->|"watched by"| PredController

    SRController -->|"creates/manages"| RuntimeDeploy["Runtime Deployments"]
    SRController -->|"validates via"| Webhook
    HPAReconciler -->|"manages"| HPA["HorizontalPodAutoscaler"]

    SvcController -->|"creates"| HeadlessSvc["Headless Services"]
    SvcController -->|"creates"| ServiceMonitor["ServiceMonitor"]

    DeployController -->|"reconciles"| RuntimeDeploy
    EndpointsController -->|"resolves"| Endpoints["Endpoints"]

    SRController -->|"gRPC"| ModelMeshSidecar
    ModelMeshSidecar --> ModelServer

    SRController -->|"coordinates"| etcd["etcd<br/>Model placement"]
    SRController -->|"HTTPS/6443"| K8sAPI["Kubernetes API"]

    ServiceMonitor -->|"scraped by"| Prometheus["Prometheus<br/>prometheus-operator"]

    style SRController fill:#4a90e2,color:#fff
    style PredController fill:#4a90e2,color:#fff
    style SvcController fill:#4a90e2,color:#fff
    style DeployController fill:#4a90e2,color:#fff
    style EndpointsController fill:#4a90e2,color:#fff
    style NSController fill:#4a90e2,color:#fff
    style HPAReconciler fill:#4a90e2,color:#fff
    style Webhook fill:#e74c3c,color:#fff
    style CSRCR fill:#f5a623,color:#fff
    style SRCR fill:#f5a623,color:#fff
    style PredCR fill:#f5a623,color:#fff
    style ISCR fill:#f5a623,color:#fff
    style ModelMeshSidecar fill:#9b59b6,color:#fff
    style ModelServer fill:#9b59b6,color:#fff
    style etcd fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#7ed321,color:#fff
