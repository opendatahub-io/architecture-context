graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AuthBoundary["AUTHENTICATION BOUNDARY (Envoy ext_authz)"]
        Envoy["Envoy ext_authz Sidecar<br/>Auth Validation<br/>Identity Header Injection<br/>(TenantID, RequestID)"]
    end

    subgraph Internal["INTERNAL SERVICES (No In-Service Auth)"]
        direction TB

        subgraph APIServerNS["API Server"]
            APIServer["batch-gateway-apiserver<br/>User: 65532 (non-root)<br/>Distroless base image<br/>CGO_ENABLED=0"]
            APIPprof["pprof endpoints<br/>/debug/pprof/*<br/>No Auth"]
            APIHealth["Observability<br/>/health, /ready, /metrics<br/>No Auth"]
        end

        subgraph ProcessorNS["Processor"]
            Processor["batch-gateway-processor<br/>User: 65532 (non-root)<br/>Distroless base image<br/>CGO_ENABLED=0"]
            ProcHealth["Observability<br/>/health, /ready, /metrics<br/>No Auth"]
        end

        subgraph GCNS["Garbage Collector"]
            GCWorker["batch-gateway-gc<br/>User: 65532 (non-root)<br/>Distroless base image<br/>CGO_ENABLED=0"]
            GCHealth["Observability<br/>/health, /ready, /metrics<br/>No Auth"]
        end
    end

    subgraph DataStores["DATA STORES (Runtime Configured)"]
        PostgreSQL["PostgreSQL<br/>TCP<br/>Encryption: Runtime configured<br/>Auth: Runtime configured"]
        Redis["Redis/Valkey<br/>TCP<br/>Encryption: Runtime configured<br/>Auth: Runtime configured"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>Encryption: Runtime configured<br/>Auth: AWS SDK v2 credentials"]
    end

    subgraph Inference["INFERENCE LAYER"]
        LLMd["llm-d Inference Gateway<br/>HTTP/HTTPS<br/>Encryption: Runtime configured<br/>Auth: Runtime configured"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Encryption: Runtime configured"]
    end

    %% External → Auth boundary
    Client -->|"HTTP/HTTPS<br/>Auth: Delegated to ext_authz"| Envoy

    %% Auth boundary → API Server
    Envoy -->|"HTTP<br/>Identity headers injected<br/>No further auth check"| APIServer

    %% API Server → Data stores
    APIServer -->|"TCP<br/>pgx driver<br/>Runtime configured"| PostgreSQL
    APIServer -->|"TCP<br/>go-redis<br/>Runtime configured"| Redis
    APIServer -->|"HTTP/HTTPS<br/>AWS SDK v2<br/>Runtime configured"| S3

    %% Processor → Data stores + Inference
    Processor -->|"TCP<br/>go-redis<br/>Runtime configured"| Redis
    Processor -->|"TCP<br/>pgx driver<br/>Runtime configured"| PostgreSQL
    Processor -->|"HTTP/HTTPS<br/>Runtime configured"| S3
    Processor -->|"HTTP/HTTPS<br/>go-resty<br/>Runtime configured"| LLMd

    %% GC → Data stores
    GCWorker -->|"TCP<br/>pgx driver<br/>Runtime configured"| PostgreSQL
    GCWorker -->|"HTTP/HTTPS<br/>AWS SDK v2<br/>Runtime configured"| S3
    GCWorker -.->|"TCP (optional)<br/>go-redis<br/>Orphan reconciliation"| Redis

    %% Observability
    APIServer -->|"OTLP/gRPC<br/>Runtime configured"| OTel
    Processor -->|"OTLP/gRPC<br/>Runtime configured"| OTel
    GCWorker -->|"OTLP/gRPC<br/>Runtime configured"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy authboundary
    class APIServer,Processor,GCWorker,APIPprof,APIHealth,ProcHealth,GCHealth internal
    class PostgreSQL,Redis,S3 datastore
    class LLMd inference
    class OTel observability
