graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph GatewayZone["GATEWAY (Content Safety Interposition)"]
        Gateway["vllm-orchestrator-gateway<br/>Rust / Axum / Tokio<br/>Listen: 8090/TCP<br/>Config: GATEWAY_CONFIG"]
    end

    subgraph Internal["INTERNAL SERVICES (Guardrails)"]
        Orchestrator["TrustAI Guardrails Orchestrator<br/>/api/v2/chat/completions-detection"]
    end

    subgraph Backend["INFERENCE BACKEND"]
        vLLM["vLLM Inference Endpoint"]
    end

    subgraph TLSMounts["TLS Certificate Mounts"]
        direction LR
        Cert["/etc/tls/private/tls.crt"]
        Key["/etc/tls/private/tls.key"]
        CA["/etc/tls/ca/service-ca.crt"]
    end

    %% Flows
    Client -->|"HTTP/8090<br/>POST /{route}/v1/chat/completions<br/>Auth: Bearer Token (passthrough)"| Gateway
    Gateway -->|"HTTP(S)<br/>mTLS (when certs mounted)<br/>POST /api/v2/chat/completions-detection<br/>Headers: Authorization, x-forwarded-*"| Orchestrator
    Orchestrator -->|"Inference request"| vLLM
    vLLM -->|"Inference response"| Orchestrator
    Orchestrator -->|"Response + detections"| Gateway
    Gateway -->|"JSON or SSE stream<br/>Fallback message on detection"| Client

    TLSMounts -.->|"OpenSSL mTLS config"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef tls fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gateway gateway
    class Orchestrator internal
    class vLLM backend
    class Cert,Key,CA tls
