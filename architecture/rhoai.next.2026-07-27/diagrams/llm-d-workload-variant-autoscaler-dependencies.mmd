graph LR
    WVA["WVA Controller<br/>(Workload Variant Autoscaler)"]

    %% External Dependencies (required runtime)
    WVA -->|"watches resources<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    WVA -->|"queries metrics<br/>9090/TCP HTTPS"| Prometheus["Prometheus<br/>9090/TCP"]
    WVA -->|"watches InferencePools"| GatewayAPIExt["gateway-api-inference-extension<br/>v1.2.1"]
    WVA -->|"watches ScaledObjects<br/>(conditional)"| KEDA["KEDA<br/>v2.18.0"]
    WVA -->|"watches LeaderWorkerSets<br/>(conditional)"| LWS["LeaderWorkerSet<br/>v0.8.0"]

    %% Observability
    WVA -->|"ServiceMonitor +<br/>PrometheusRule CRDs"| PromOperator["prometheus-operator<br/>v0.89.0"]

    %% Build/Runtime Dependencies
    WVA -.->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    WVA -.->|"Kalman filter<br/>for queueing model"| KalmanFilter["llm-inferno/kalman-filter<br/>v0.1.2"]
    WVA -.->|"numerical computation"| Gonum["gonum<br/>v0.17.0"]
    WVA -.->|"metrics caching"| LRUCache["golang-lru/v2<br/>v2.0.7"]
    WVA -.->|"configuration mgmt"| Viper["spf13/viper<br/>v1.21.0"]

    %% Integration Points (consume WVA output)
    HPAAdapter["HPA / Prometheus Adapter"] -->|"reads wva_desired_replicas<br/>from Prometheus"| WVA
    KEDAScaler["KEDA Scaler"] -->|"reads external metric"| WVA

    %% EPP Pods
    WVA -->|"scrapes /metrics<br/>HTTP(S)"| EPPPods["EPP / Inference Pods"]

    %% Scaling targets
    HPAAdapter -->|"scales via<br/>K8s API"| TargetDeploy["Target Deployment<br/>/ LWS"]
    KEDAScaler -->|"scales via<br/>K8s API"| TargetDeploy

    %% Styles
    style WVA fill:#1565c0,stroke:#0d47a1,stroke-width:4px,color:#fff

    %% External dependencies
    style K8sAPI fill:#9e9e9e,stroke:#616161,color:#fff
    style Prometheus fill:#9e9e9e,stroke:#616161,color:#fff
    style GatewayAPIExt fill:#7ed321,stroke:#5cb00d,color:#fff
    style KEDA fill:#9e9e9e,stroke:#616161,color:#fff
    style LWS fill:#9e9e9e,stroke:#616161,color:#fff
    style PromOperator fill:#9e9e9e,stroke:#616161,color:#fff

    %% Build deps (dashed)
    style ControllerRuntime fill:#e3f2fd,stroke:#90caf9
    style KalmanFilter fill:#e3f2fd,stroke:#90caf9
    style Gonum fill:#e3f2fd,stroke:#90caf9
    style LRUCache fill:#e3f2fd,stroke:#90caf9
    style Viper fill:#e3f2fd,stroke:#90caf9

    %% Consumers
    style HPAAdapter fill:#c8e6c9,stroke:#66bb6a
    style KEDAScaler fill:#c8e6c9,stroke:#66bb6a
    style TargetDeploy fill:#c8e6c9,stroke:#66bb6a
    style EPPPods fill:#ffe0b2,stroke:#ff9800
