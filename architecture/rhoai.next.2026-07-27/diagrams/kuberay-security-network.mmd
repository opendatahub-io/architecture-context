graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / Admin"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph OperatorPod["kuberay-operator Deployment"]
            Operator["KubeRay Operator<br/>SA: kuberay-operator"]
            Webhooks["Admission Webhooks<br/>TLS<br/>failurePolicy: Fail"]
            Metrics["Metrics Endpoint<br/>:8080/HTTP<br/>Auth: None"]
        end

        subgraph APIServerPod["kuberay-apiserver"]
            gRPC["gRPC Server<br/>:8887<br/>APIServerInterceptor"]
            HTTPGw["HTTP Gateway<br/>:8888<br/>→ localhost gRPC"]
        end

        subgraph ProxyPod["security_proxy"]
            SecProxy["Security Proxy<br/>Token Auth<br/>HTTP + gRPC"]
        end
    end

    subgraph UserNS["USER NAMESPACES (Ray workloads)"]
        direction TB
        RayHead["Ray Head Pod<br/>:8265 Dashboard<br/>:10001 Client<br/>:6379 GCS"]
        RayWorkers["Ray Worker Pods"]
        NetPol["NetworkPolicy<br/>Per-RayCluster isolation"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Internal)"]
        direction TB
        Prom["Prometheus"]
        CertMgr["cert-manager<br/>Certificate + Issuer CRDs"]
        GwAPI["Gateway API<br/>HTTPRoute + Gateway"]
        OSConfig["OpenShift Config<br/>APIServer, Auth, OAuth"]
        OSRoutes["OpenShift Routes<br/>Dashboard access"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Control Plane → Webhooks
    K8sAPI -->|"TLS<br/>Kubernetes Admission<br/>mutate + validate"| Webhooks

    %% Operator → K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% API Server → K8s API
    gRPC -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token (reverse proxy)"| K8sAPI

    %% User → API Server
    User -->|"gRPC/8887<br/>or REST/8888"| HTTPGw

    %% User → Security Proxy → Ray
    User -->|"HTTP/gRPC<br/>Bearer Token"| SecProxy
    SecProxy -->|"Proxied request<br/>to Ray head"| RayHead

    %% Operator → User Namespace
    Operator -->|"Creates/manages<br/>via K8s API"| RayHead
    Operator -->|"Creates/manages<br/>via K8s API"| RayWorkers
    Operator -->|"Creates/manages"| NetPol

    %% Platform integrations
    Prom -->|"HTTP/8080<br/>GET /metrics<br/>No Auth"| Metrics
    Operator -->|"CRD CRUD<br/>via K8s API"| CertMgr
    Operator -->|"HTTPRoute CRUD<br/>HTTPS/TLS 1.2+"| GwAPI
    Operator -->|"Read<br/>SA Token"| OSConfig
    Operator -->|"Route CRUD<br/>HTTPS/TLS 1.2+"| OSRoutes

    %% Ray internal
    RayHead ---|"Cluster comms"| RayWorkers

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userworkload fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Operator,Webhooks,Metrics,gRPC,HTTPGw,SecProxy operator
    class RayHead,RayWorkers,NetPol userworkload
    class Prom,CertMgr,GwAPI,OSConfig,OSRoutes platform
