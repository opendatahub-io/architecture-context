graph TB
    subgraph SparkOperatorSystem["Spark Operator System"]
        direction TB

        subgraph Controllers["Controllers"]
            SparkAppCtrl["SparkApplication<br/>Controller"]
            SchedCtrl["ScheduledSparkApplication<br/>Controller"]
            ConnectCtrl["SparkConnect<br/>Controller"]
            ModuleCtrl["SparkOperator<br/>Module Controller"]
        end

        subgraph WebhookServer["Webhook Server"]
            MutatingWH["Mutating Webhooks<br/>/mutate-*"]
            ValidatingWH["Validating Webhooks<br/>/validate-*"]
            ConversionWH["Conversion Webhook<br/>/convert"]
        end

        subgraph Deployments["Deployments"]
            ControllerDeploy["spark-operator-controller<br/>ghcr.io/kubeflow/spark-operator/controller"]
            WebhookDeploy["spark-operator-webhook<br/>ghcr.io/kubeflow/spark-operator/controller"]
        end
    end

    %% CRDs
    SparkAppCR["SparkApplication CR<br/>sparkoperator.k8s.io/v1beta2"]
    SchedSparkAppCR["ScheduledSparkApplication CR<br/>sparkoperator.k8s.io/v1beta2"]
    SparkConnectCR["SparkConnect CR<br/>sparkoperator.k8s.io/v1alpha1"]
    SparkOperatorCR["SparkOperator CR<br/>components.platform.opendatahub.io/v1alpha1"]

    %% User interaction
    User["Data Scientist / Admin"]
    User -->|creates| SparkAppCR
    User -->|creates| SchedSparkAppCR
    User -->|creates| SparkConnectCR

    %% CRD to Controller relationships
    SparkAppCR -->|watched by| SparkAppCtrl
    SchedSparkAppCR -->|watched by| SchedCtrl
    SparkConnectCR -->|watched by| ConnectCtrl
    SparkOperatorCR -->|watched by| ModuleCtrl

    %% Controller creates resources
    SparkAppCtrl -->|creates| DriverPod["Driver Pod"]
    SparkAppCtrl -->|creates| ExecutorPods["Executor Pods"]
    SparkAppCtrl -->|creates| DriverSvc["Driver Service"]
    SparkAppCtrl -->|creates| IngressRes["Ingress Resources"]
    SparkAppCtrl -->|creates| PDB["PodDisruptionBudget"]
    SchedCtrl -->|creates| SparkAppCR

    %% Webhook validation
    SparkAppCR -->|validated by| ValidatingWH
    SparkAppCR -->|mutated by| MutatingWH
    SchedSparkAppCR -->|validated by| ValidatingWH
    SchedSparkAppCR -->|mutated by| MutatingWH
    SparkConnectCR -->|validated by| ValidatingWH
    SparkConnectCR -->|mutated by| MutatingWH

    %% Module controller manages operator lifecycle
    ModuleCtrl -->|manages| ControllerDeploy
    ModuleCtrl -->|manages| WebhookDeploy

    %% External dependencies
    SparkAppCtrl -->|depends on| K8sAPI["Kubernetes API<br/>6443/TCP"]
    ModuleCtrl -->|depends on| CertManager["cert-manager"]
    ModuleCtrl -->|depends on| PrometheusOp["prometheus-operator"]
    ModuleCtrl -->|uses| ODHPlatformUtils["odh-platform-utilities"]

    %% Styling
    style SparkAppCtrl fill:#4a90e2,color:#fff
    style SchedCtrl fill:#4a90e2,color:#fff
    style ConnectCtrl fill:#4a90e2,color:#fff
    style ModuleCtrl fill:#4a90e2,color:#fff
    style MutatingWH fill:#9b59b6,color:#fff
    style ValidatingWH fill:#9b59b6,color:#fff
    style ConversionWH fill:#9b59b6,color:#fff
    style ControllerDeploy fill:#2ecc71,color:#fff
    style WebhookDeploy fill:#2ecc71,color:#fff
    style SparkAppCR fill:#f5a623,color:#fff
    style SchedSparkAppCR fill:#f5a623,color:#fff
    style SparkConnectCR fill:#f5a623,color:#fff
    style SparkOperatorCR fill:#f5a623,color:#fff
    style CertManager fill:#e8e8e8
    style PrometheusOp fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style ODHPlatformUtils fill:#7ed321,color:#fff
