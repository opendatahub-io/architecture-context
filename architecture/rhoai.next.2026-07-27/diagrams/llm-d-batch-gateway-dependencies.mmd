graph LR
    BGW["llm-d Batch Gateway<br/>(apiserver + processor + gc)"]

    %% External Infrastructure Dependencies
    BGW -->|"metadata persistence<br/>CAS status updates"| PostgreSQL["PostgreSQL<br/>(pgx v5.10.0)"]
    BGW -->|"priority queue<br/>events, in-flight<br/>status cache"| Redis["Redis / Valkey<br/>(go-redis v9.21.0)"]
    BGW -->|"file storage<br/>input/output"| S3["S3-Compatible Storage<br/>(AWS SDK v2)"]

    %% Internal Platform Dependencies
    BGW -->|"inference dispatch<br/>POST /v1/chat/completions<br/>AIMD concurrency"| InferenceGW["llm-d Inference Gateway<br/>(HTTP/HTTPS)"]
    BGW -.->|"async dispatch<br/>(optional)"| LLMDAsync["llm-d-async<br/>(v0.7.4, Redis queues)"]

    %% Observability Dependencies
    BGW -.->|"trace export<br/>OTLP/gRPC"| OTel["OpenTelemetry Collector<br/>(otel v1.44.0)"]
    BGW -.->|"/metrics scrape"| Prometheus["Prometheus<br/>(client_golang v1.24.0)"]

    %% Optional Infrastructure
    BGW -.->|"TLS certs<br/>(optional)"| CertManager["cert-manager"]
    BGW -.->|"ingress routing<br/>(optional)"| GatewayAPI["Gateway API<br/>(HTTPRoute)"]

    %% Build / Runtime Dependencies
    subgraph Runtime["Runtime Dependencies"]
        Go["Go 1.26"]
        Resty["go-resty v2.17.2<br/>(HTTP client)"]
        Backoff["cenkalti/backoff v5<br/>(retry logic)"]
        UUID["google/uuid v1.6.0"]
        YAML["gopkg.in/yaml.v3"]
        Sync["golang.org/x/sync<br/>(errgroup)"]
    end

    BGW -->|"built with"| Runtime

    %% Styling
    style BGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style Redis fill:#dc382d,stroke:#333,color:#fff
    style S3 fill:#569a31,stroke:#333,color:#fff
    style InferenceGW fill:#9b59b6,stroke:#333,color:#fff
    style LLMDAsync fill:#9b59b6,stroke:#333,color:#fff
    style OTel fill:#425cc7,stroke:#333,color:#fff
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Runtime fill:#f5f5f5,stroke:#ccc
    style Go fill:#00add8,stroke:#333,color:#fff
    style Resty fill:#ddd,stroke:#333
    style Backoff fill:#ddd,stroke:#333
    style UUID fill:#ddd,stroke:#333
    style YAML fill:#ddd,stroke:#333
    style Sync fill:#ddd,stroke:#333
