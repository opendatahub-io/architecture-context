graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph OperatorNS["Namespace: opendatahub"]
            Manager["mlflow-operator-controller-manager<br/>SA: mlflow-operator-controller-manager<br/>Ports: 8081/TCP, 8443/TCP"]
            MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>TLS: service-ca cert"]
            Manager --- MetricsSvc
        end

        subgraph ManagedNS["Managed Namespaces"]
            MLflowServer["MLflow Server<br/>(Helm-rendered)<br/>Deployment + Service"]
            OwnedRes["Owned Resources<br/>SA, PVC, Secrets<br/>CronJobs, Jobs<br/>NetworkPolicies"]
            ConditionalRes["Conditional Resources<br/>HTTPRoute, ConsoleLink<br/>ServiceMonitor"]
        end

        subgraph ControlPlane["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
            ServiceCA["OpenShift service-ca<br/>Provisions TLS certs"]
            APIServerConfig["OpenShift APIServer Config<br/>TLS Profile Provider"]
        end

        Kubelet["Kubelet<br/>(Health Probes)"]
        Prometheus["Prometheus<br/>(Metrics)"]
    end

    %% Health probe flows
    Kubelet -->|"HTTP/8081<br/>No encryption<br/>No auth<br/>/healthz, /readyz"| Manager

    %% Metrics flows
    Prometheus -->|"HTTPS/8443<br/>TLS (service-ca)<br/>TokenReview+SAR<br/>/metrics"| MetricsSvc

    %% Operator to K8s API
    Manager -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>Resource CRUD + watches"| K8sAPI

    %% service-ca provisions certs
    ServiceCA -.->|"provisions cert"| MetricsSvc

    %% TLS profile monitoring
    Manager -->|"watches TLS profile"| APIServerConfig

    %% Operator manages resources
    Manager -->|"creates/manages<br/>via Helm rendering"| MLflowServer
    Manager -->|"creates/manages"| OwnedRes
    Manager -.->|"conditional<br/>CRD discovery"| ConditionalRes

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef service fill:#2c5f8a,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px,color:#000
    classDef managed fill:#7ed321,stroke:#333,stroke-width:1px,color:#000
    classDef conditional fill:#fff2cc,stroke:#d6b656,stroke-width:1px,color:#000
    classDef monitor fill:#f5a623,stroke:#333,stroke-width:1px,color:#000

    class Manager operator
    class MetricsSvc service
    class K8sAPI,ServiceCA,APIServerConfig controlplane
    class MLflowServer,OwnedRes managed
    class ConditionalRes conditional
    class Kubelet,Prometheus monitor
