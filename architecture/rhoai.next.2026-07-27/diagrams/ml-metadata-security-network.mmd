graph TB
    subgraph Clients["ML PIPELINE CLIENTS (Internal)"]
        DSP["Data Science Pipelines<br/>Python MetadataStore Client"]
    end

    subgraph MetadataService["METADATA STORE SERVICE"]
        direction TB

        subgraph Container["Container: odh-mlmd-grpc-server"]
            Server["metadata_store_server<br/>Port: 8080/TCP gRPC<br/>User: 65534:65534 (non-root)<br/>Transport: Insecure or TLS/mTLS<br/>UBI9 Base Image"]
        end
    end

    subgraph DatabaseBackend["DATABASE BACKEND"]
        MySQL["MySQL<br/>Port: 3306/TCP<br/>libmysqlclient/MariaDB"]
        PostgreSQL["PostgreSQL<br/>Port: 5432/TCP"]
        SQLite["SQLite / In-Memory<br/>(testing only)"]
    end

    %% Flows
    DSP -->|"gRPC/8080<br/>Optional TLS/mTLS<br/>No app-level auth<br/>Network policy enforced"| Server
    Server -->|"MySQL Protocol/3306<br/>DB credentials<br/>Encryption: config-dependent"| MySQL
    Server -->|"PostgreSQL Protocol/5432<br/>DB credentials<br/>Encryption: config-dependent"| PostgreSQL
    Server -.->|"In-memory<br/>(testing only)"| SQLite

    %% Styling
    classDef client fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef testing fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class DSP client
    class Server service
    class MySQL,PostgreSQL database
    class SQLite testing
