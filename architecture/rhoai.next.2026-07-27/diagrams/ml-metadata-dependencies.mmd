graph LR
    MLMD["ML Metadata<br/>(metadata_store_server)"]

    %% Database Dependencies
    MLMD -->|"persistence<br/>3306/TCP"| MySQL["MySQL<br/>(libmysqlclient/<br/>MariaDB Connector)"]
    MLMD -->|"persistence<br/>5432/TCP"| PostgreSQL["PostgreSQL"]
    MLMD -.->|"testing only"| SQLite["SQLite / In-Memory"]

    %% Build Dependencies
    MLMD -->|"base image"| UBI9["UBI9<br/>(registry.access.redhat.com)"]
    MLMD -->|"build system"| Bazel["Bazel 5<br/>(C++17 / ZetaSQL)"]
    MLMD -->|"CI/CD"| Konflux["Konflux Pipelines"]

    %% Internal RHOAI Integrations
    DSP["Data Science Pipelines"] -->|"gRPC/8080<br/>metadata recording"| MLMD

    %% Optional Security Dependencies
    MLMD -.->|"optional TLS<br/>certificates"| TLS["TLS Certificates<br/>(--ssl_cert/key/ca)"]

    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MySQL fill:#f5a623,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style UBI9 fill:#999,stroke:#333,color:#fff
    style Bazel fill:#999,stroke:#333,color:#fff
    style Konflux fill:#999,stroke:#333,color:#fff
    style DSP fill:#7ed321,stroke:#333
    style TLS fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
