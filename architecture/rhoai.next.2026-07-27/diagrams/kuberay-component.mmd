graph TB
    subgraph KubeRay["KubeRay Operator"]
        direction TB

        subgraph Controllers["Controllers"]
            RayClusterCtrl["RayCluster Controller"]
            RayJobCtrl["RayJob Controller"]
            RayServiceCtrl["RayService Controller"]
            RayCronJobCtrl["RayCronJob Controller"]
            AuthCtrl["Authentication Controller"]
            NetworkPolicyCtrl["NetworkPolicy Controller"]
            MTLSCtrl["RayCluster MTLS Controller"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutatingWH["Mutating Webhook<br/>/mutate-ray-io-v1-raycluster"]
            ValidatingWH1["Validating Webhook<br/>/validate-ray-io-v1-raycluster"]
            ValidatingWH2["Validating Webhook<br/>/validate-ray-io-v1-rayjob"]
            ValidatingWH3["Validating Webhook<br/>/validate-ray-io-v1-rayservice"]
        end

        MetricsServer["Metrics Server<br/>:8080/metrics"]
    end

    subgraph APIServer["KubeRay API Server"]
        gRPCServer["gRPC Server<br/>:8887"]
        HTTPGateway["HTTP Gateway Proxy<br/>:8888"]
        HTTPGateway -->|"localhost proxy"| gRPCServer
    end

    SecurityProxy["Security Proxy<br/>Token Auth"]

    %% CRDs
    RayClusterCR["RayCluster CR<br/>ray.io/v1"]
    RayJobCR["RayJob CR<br/>ray.io/v1"]
    RayServiceCR["RayService CR<br/>ray.io/v1"]
    RayCronJobCR["RayCronJob CR<br/>ray.io/v1"]
    ConfigCR["Configuration CR<br/>config.ray.io/v1alpha1"]

    %% External dependencies
    K8sAPI["Kubernetes API<br/>:6443"]
    CertManager["cert-manager"]
    GatewayAPI["Gateway API"]
    Prometheus["Prometheus"]
    OpenShiftConfig["OpenShift<br/>Cluster Config"]

    %% User
    User["Data Scientist / Admin"]

    %% User interactions
    User -->|"creates"| RayClusterCR
    User -->|"creates"| RayJobCR
    User -->|"creates"| RayServiceCR
    User -->|"creates"| RayCronJobCR

    %% Controller watches
    RayClusterCR -->|"watched by"| RayClusterCtrl
    RayClusterCR -->|"watched by"| AuthCtrl
    RayClusterCR -->|"watched by"| NetworkPolicyCtrl
    RayClusterCR -->|"watched by"| MTLSCtrl
    RayJobCR -->|"watched by"| RayJobCtrl
    RayServiceCR -->|"watched by"| RayServiceCtrl
    RayCronJobCR -->|"watched by"| RayCronJobCtrl

    %% Controller creates resources
    RayClusterCtrl -->|"creates"| Pods["Pods<br/>Head + Workers"]
    RayClusterCtrl -->|"creates"| Services["Services"]
    RayClusterCtrl -->|"creates"| Secrets["Secrets"]
    RayJobCtrl -->|"creates"| Jobs["batch/v1 Jobs"]
    RayJobCtrl -->|"owns"| RayClusterCR
    RayServiceCtrl -->|"owns"| RayClusterCR
    RayCronJobCtrl -->|"owns"| RayJobCR

    %% External integrations
    RayClusterCtrl -->|"HTTPS/6443"| K8sAPI
    MTLSCtrl -->|"manages certs"| CertManager
    RayServiceCtrl -->|"manages routes"| GatewayAPI
    AuthCtrl -->|"manages routes"| GatewayAPI
    MetricsServer -->|"scraped by"| Prometheus
    RayClusterCtrl -->|"reads config"| OpenShiftConfig

    %% Security proxy
    SecurityProxy -->|"proxies to"| Pods

    %% Webhook validation
    K8sAPI -->|"admission"| MutatingWH
    K8sAPI -->|"admission"| ValidatingWH1
    K8sAPI -->|"admission"| ValidatingWH2
    K8sAPI -->|"admission"| ValidatingWH3

    %% Styles
    style RayClusterCtrl fill:#4a90e2,color:#fff
    style RayJobCtrl fill:#4a90e2,color:#fff
    style RayServiceCtrl fill:#4a90e2,color:#fff
    style RayCronJobCtrl fill:#4a90e2,color:#fff
    style AuthCtrl fill:#4a90e2,color:#fff
    style NetworkPolicyCtrl fill:#4a90e2,color:#fff
    style MTLSCtrl fill:#4a90e2,color:#fff
    style MutatingWH fill:#9b59b6,color:#fff
    style ValidatingWH1 fill:#9b59b6,color:#fff
    style ValidatingWH2 fill:#9b59b6,color:#fff
    style ValidatingWH3 fill:#9b59b6,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style gRPCServer fill:#e67e22,color:#fff
    style HTTPGateway fill:#e67e22,color:#fff
    style SecurityProxy fill:#e74c3c,color:#fff
    style RayClusterCR fill:#f5a623,color:#000
    style RayJobCR fill:#f5a623,color:#000
    style RayServiceCR fill:#f5a623,color:#000
    style RayCronJobCR fill:#f5a623,color:#000
    style ConfigCR fill:#f5a623,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style CertManager fill:#e8e8e8,color:#000
    style GatewayAPI fill:#e8e8e8,color:#000
    style Prometheus fill:#e8e8e8,color:#000
    style OpenShiftConfig fill:#e8e8e8,color:#000
