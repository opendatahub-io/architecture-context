graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["User / kubectl Client"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC Enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph OperatorPod["codeflare-operator-manager"]
            Manager["Manager Process<br/>SA: codeflare-operator-controller-manager"]
        end

        subgraph WebhookSvc["codeflare-operator-webhook-service (ClusterIP)"]
            WHEndpoint["Webhook Endpoints<br/>443/TCP → 9443/TCP<br/>TLS (webhook-server-cert)<br/>failurePolicy: Fail"]
        end

        subgraph MetricsSvc["codeflare-operator-manager-metrics (ClusterIP)"]
            MetricsEP["Metrics<br/>8080/TCP"]
        end

        HealthEP["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
    end

    subgraph ManagedNS["MANAGED NAMESPACES (user workloads)"]
        direction TB

        subgraph OwnedRes["Per-RayCluster Owned Resources"]
            Svc["Service"]
            SA["ServiceAccount"]
            Ingress["Ingress"]
            NetPol["NetworkPolicy"]
            Route["Route (OpenShift)"]
        end

        subgraph Workloads["Multi-Framework Workloads"]
            AppWrapper["AppWrapper<br/>workload.codeflare.dev/v1beta2"]
            RayCluster["RayCluster / RayJob<br/>ray.io"]
            PyTorch["PyTorchJob<br/>kubeflow.org"]
            JobSetRes["JobSet<br/>jobset.x-k8s.io"]
            PodGroupRes["PodGroup<br/>scheduling.*.k8s.io"]
        end
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        DSCI["DSCInitialization CR<br/>opendatahub.io"]
        KueueDep["Kueue<br/>Quota Management"]
        OSIngress["OpenShift Ingress Config<br/>config.openshift.io"]
    end

    %% Flows
    Client -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| APIServer
    APIServer -->|"HTTPS/9443 (via 443)<br/>TLS (webhook-server-cert)<br/>Admission Auth"| WHEndpoint
    WHEndpoint --- Manager
    MetricsEP --- Manager
    HealthEP --- Manager

    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| APIServer

    Manager -->|"Kubernetes API<br/>TLS<br/>CRUD"| Svc
    Manager -->|"Kubernetes API<br/>TLS<br/>CRUD"| SA
    Manager -->|"Kubernetes API<br/>TLS<br/>CRUD"| Ingress
    Manager -->|"Kubernetes API<br/>TLS<br/>CRUD"| NetPol
    Manager -->|"Kubernetes API<br/>TLS<br/>CRUD"| Route

    Manager -->|"Watch/CRUD<br/>TLS"| AppWrapper
    Manager -->|"Watch/CRUD<br/>TLS"| RayCluster
    Manager -->|"CRUD<br/>TLS"| PyTorch
    Manager -->|"CRUD<br/>TLS"| JobSetRes
    Manager -->|"CRUD<br/>TLS"| PodGroupRes

    Manager -->|"GET<br/>TLS 1.2+"| DSCI
    Manager -->|"PodSetInfos<br/>Quota Integration"| KueueDep
    Manager -->|"GET<br/>TLS 1.2+"| OSIngress

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef webhook fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class APIServer controlplane
    class Manager,MetricsEP,HealthEP operator
    class WHEndpoint webhook
    class Svc,SA,Ingress,NetPol,Route,AppWrapper,RayCluster,PyTorch,JobSetRes,PodGroupRes managed
    class DSCI,KueueDep,OSIngress platform
