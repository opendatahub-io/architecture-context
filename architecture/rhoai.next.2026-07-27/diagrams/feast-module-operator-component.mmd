graph TB
    subgraph FeastModuleOperator["Feast Module Operator"]
        CLI["feast-module-operator<br/>(Cobra CLI)"]
        OperatorCmd["operator subcommand"]
        ChartgenCmd["chartgen subcommand"]
        CLI --> OperatorCmd
        CLI --> ChartgenCmd
    end

    subgraph ControllerManager["feast-operator-controller-manager (Deployment)"]
        Manager["Manager Container<br/>(controller:latest)"]
        HealthProbe["/healthz :8081"]
        ReadyProbe["/readyz :8081"]
        MetricsEP["/metrics :8443<br/>RBAC-protected"]
        Manager --- HealthProbe
        Manager --- ReadyProbe
        Manager --- MetricsEP
    end

    OperatorCmd -->|starts| Manager

    %% CRDs
    FeastOperatorCR["FeastOperator CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1"]
    FeatureStoreCR["FeatureStore CR<br/>(Namespaced)<br/>feast.dev/v1"]

    FeastOperatorCR -->|watched by| Manager
    Manager -->|deploys upstream operator<br/>that manages| FeatureStoreCR

    %% Owned Resources
    subgraph OwnedResources["Owned Kubernetes Resources"]
        Deployments["Deployments"]
        Services["Services"]
        ConfigMaps["ConfigMaps"]
        ServiceAccounts["ServiceAccounts"]
        RBAC["ClusterRoles / Roles<br/>Bindings"]
        ServiceMonitors["ServiceMonitors"]
        CronJobs["CronJobs"]
        PVCs["PersistentVolumeClaims"]
        HPAs["HorizontalPodAutoscalers"]
        PDBs["PodDisruptionBudgets"]
        Routes["OpenShift Routes"]
    end

    Manager -->|creates/reconciles| OwnedResources

    %% External Integrations
    KubeAPI["Kubernetes API<br/>:6443 HTTPS"]
    KubeflowNB["Kubeflow Notebooks<br/>(kubeflow.org)"]
    PrometheusOp["prometheus-operator<br/>(monitoring.coreos.com)"]
    ODHOperator["opendatahub-operator<br/>(Go library)"]

    Manager -->|REST + WSS| KubeAPI
    Manager -->|watches| KubeflowNB
    Manager -->|manages| PrometheusOp
    Manager -.->|imports runtime pkgs| ODHOperator

    %% Styling
    style CLI fill:#4a90e2,color:#fff
    style Manager fill:#4a90e2,color:#fff
    style FeastOperatorCR fill:#f5a623,color:#fff
    style FeatureStoreCR fill:#f5a623,color:#fff
    style KubeAPI fill:#e8e8e8,stroke:#333
    style KubeflowNB fill:#7ed321,color:#fff
    style PrometheusOp fill:#7ed321,color:#fff
    style ODHOperator fill:#7ed321,color:#fff
    style MetricsEP fill:#d94f4f,color:#fff
