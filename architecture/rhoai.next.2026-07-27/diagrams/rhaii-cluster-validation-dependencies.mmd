graph LR
    RHAII["rhaii-cluster-validation<br/>(CLI Tool)"]

    %% External Dependencies (Go modules)
    RHAII -->|CLI framework| Cobra["spf13/cobra 1.10.2"]
    RHAII -->|YAML parsing| YamlV3["gopkg.in/yaml.v3"]
    RHAII -->|K8s types| K8sAPI_mod["k8s.io/api 0.35.3"]
    RHAII -->|K8s objects| K8sApimachinery["k8s.io/apimachinery 0.35.3"]
    RHAII -->|K8s client| K8sClientGo["k8s.io/client-go 0.35.3"]
    RHAII -->|YAML utils| SigsYAML["sigs.k8s.io/yaml 1.6.0"]

    %% Runtime Dependencies
    RHAII -->|runtime| GoRuntime["Go 1.25"]

    %% Kubernetes API Integration
    RHAII -->|"HTTPS/6443<br/>Resource CRUD"| K8sAPIServer["Kubernetes API Server"]

    %% Kubernetes Resource Operations
    K8sAPIServer -->|manages| Namespace["/v1/Namespace"]
    K8sAPIServer -->|manages| SA["/v1/ServiceAccount"]
    K8sAPIServer -->|manages| CM["/v1/ConfigMap"]
    K8sAPIServer -->|manages| Job["batch/v1/Job"]
    K8sAPIServer -->|manages| CRole["rbac/v1/ClusterRole"]
    K8sAPIServer -->|manages| CRB["rbac/v1/ClusterRoleBinding"]

    %% Validated Prerequisites (deps subcommand)
    RHAII -.->|validates| GatewayAPI["Gateway API CRDs"]
    RHAII -.->|validates| InferencePool["InferencePool CRD"]
    RHAII -.->|validates| LWS["LeaderWorkerSet Operator"]
    RHAII -.->|validates| CertManager["cert-manager Operator"]
    RHAII -.->|validates| Istio["Istio Operator"]

    %% Supported Platforms
    RHAII -.->|auto-detects| OCP["OpenShift (OCP)"]
    RHAII -.->|auto-detects| EKS["Amazon EKS"]
    RHAII -.->|auto-detects| AKS["Azure AKS"]
    RHAII -.->|auto-detects| CoreWeave["CoreWeave"]

