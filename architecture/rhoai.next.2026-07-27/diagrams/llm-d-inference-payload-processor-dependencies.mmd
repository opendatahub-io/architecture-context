graph LR
    IPP["llm-d-inference-payload-processor<br/>(Envoy ExtProc gRPC Server)"]

    %% Internal Platform Dependencies
    IPP -->|"gRPC ExtProc callout<br/>9004/TCP"| Envoy["Envoy Proxy<br/>envoyproxy/envoy:distroless-v1.33.2"]

    %% Infrastructure Dependencies
    IPP -->|"HTTPS/WSS 6443<br/>ConfigMap watch"| K8sAPI["Kubernetes API Server"]
    IPP -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]

    %% Key Library Dependencies
    IPP -->|"gRPC server"| GRPC["google.golang.org/grpc 1.82.1"]
    IPP -->|"ExtProc API types"| GoControlPlane["go-control-plane/envoy 1.37.0"]
    IPP -->|"OpenAI API types"| OpenAIGo["openai-go 1.12.0"]
    IPP -->|"metrics"| PromClient["prometheus/client_golang 1.23.2"]
    IPP -->|"tracing"| OTel["opentelemetry/otel 1.44.0"]
    IPP -->|"logging"| Zap["go.uber.org/zap 1.28.0"]
    IPP -->|"inference extension"| GatewayAPI["gateway-api-inference-extension 1.5.0"]

    %% Runtime
    IPP -->|"runtime"| GoRuntime["Go 1.25"]

    %% Downstream consumers
    Envoy -->|"routes to<br/>8000/TCP"| ModelServers["Model Servers<br/>(vllm-llama3, vllm-deepseek-r1)"]

    %% Observability
    Prometheus["Prometheus"] -->|"scrapes<br/>9090/TCP"| IPP
    OTelCollector["OpenTelemetry Collector"] -.->|"OTLP gRPC<br/>(when enabled)"| IPP

