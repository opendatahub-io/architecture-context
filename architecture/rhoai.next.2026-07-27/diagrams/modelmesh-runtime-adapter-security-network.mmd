graph TB
    subgraph PodBoundary["MODELMESH POD BOUNDARY (Pod-local)"]
        direction TB

        subgraph ControlPlane["ModelMesh Control Plane"]
            MMesh["mmesh.ModelMesh<br/>registerModel / unregisterModel<br/>ensureLoaded / getModelStatus"]
        end

        subgraph SidecarAdapters["Runtime Adapter Sidecars<br/>mmesh.ModelRuntime<br/>(No auth interceptors)"]
            TritonAdapter["model-mesh-triton-adapter<br/>gRPC / No encryption<br/>Auth: None"]
            MLServerAdapter["model-mesh-mlserver-adapter<br/>gRPC / No encryption<br/>Auth: None"]
            TorchServeAdapter["model-mesh-torchserve-adapter<br/>gRPC / No encryption<br/>Auth: None"]
            PullerAdapter["model-serving-puller<br/>gRPC / No encryption<br/>Auth: None"]
        end

        subgraph PullmanLib["pullman storage library"]
            Pullman["Multi-cloud downloader<br/>Azure SDK / GCS SDK / S3 SDK"]
        end

        PullerAdapter -->|uses| Pullman
    end

    subgraph BackendEngines["BACKEND ENGINES (Pod-local/Adjacent)"]
        Triton["NVIDIA Triton<br/>inference.GRPCInferenceService<br/>gRPC / Runtime-configured"]
        MLServer["Seldon MLServer<br/>GRPCInferenceService<br/>gRPC / Runtime-configured"]
        TorchServe["PyTorch TorchServe<br/>InferenceAPIs + ManagementAPIs<br/>gRPC / Runtime-configured"]
    end

    subgraph ExternalStorage["EXTERNAL SERVICES (Object Storage)"]
        Azure["Azure Blob Storage<br/>HTTP/HTTPS<br/>Azure SDK Auth"]
        GCS["Google Cloud Storage<br/>HTTP/HTTPS<br/>GCS SDK Auth"]
        IBM["IBM Cloud Object Storage<br/>HTTP/HTTPS (S3-compatible)<br/>IBM COS SDK Auth"]
    end

    %% Control plane → adapters (pod-local gRPC, no auth)
    MMesh -->|"gRPC (pod-local)<br/>No encryption<br/>No auth"| TritonAdapter
    MMesh -->|"gRPC (pod-local)<br/>No encryption<br/>No auth"| MLServerAdapter
    MMesh -->|"gRPC (pod-local)<br/>No encryption<br/>No auth"| TorchServeAdapter
    MMesh -->|"gRPC (pod-local)<br/>No encryption<br/>No auth"| PullerAdapter

    %% Adapters → backends
    TritonAdapter -->|"gRPC<br/>Runtime-configured<br/>No app auth"| Triton
    MLServerAdapter -->|"gRPC<br/>Runtime-configured<br/>No app auth"| MLServer
    TorchServeAdapter -->|"gRPC<br/>Runtime-configured<br/>No app auth"| TorchServe

    %% Puller → object storage
    Pullman -->|"HTTPS<br/>TLS (expected)<br/>Azure SDK credentials"| Azure
    Pullman -->|"HTTPS<br/>TLS (expected)<br/>GCS SDK credentials"| GCS
    Pullman -->|"HTTPS<br/>TLS (expected)<br/>IBM COS SDK credentials"| IBM

    %% Styling
    classDef podlocal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class MMesh controlplane
    class TritonAdapter,MLServerAdapter,TorchServeAdapter,PullerAdapter,Pullman podlocal
    class Triton,MLServer,TorchServe backend
    class Azure,GCS,IBM external
