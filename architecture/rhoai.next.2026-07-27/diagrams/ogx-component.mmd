graph TB
    subgraph OGX["ogx (Llama Stack) - FastAPI Application Service"]
        direction TB

        subgraph Server["Server Layer"]
            FastAPIServer["FastAPI Server<br/>server.py<br/>Port 8321 (default)<br/>uvicorn"]
            DynamicRoutes["Dynamic Route Registration<br/>Protocol-defined API routes"]
            FastAPIServer --> DynamicRoutes
        end

        subgraph AuthLayer["Authentication Layer"]
            AuthMiddleware["AuthenticationMiddleware<br/>ASGI Middleware<br/>Configuration-conditional"]
            OAuth2Provider["OAuth2TokenAuthProvider<br/>JWT/JWKS validation<br/>RFC 7662 introspection"]
            CustomAuthProvider["CustomAuthProvider<br/>External HTTP delegation"]
            QuotaMiddleware["QuotaMiddleware<br/>Rate limiting"]
            ClientVersionMW["ClientVersionMiddleware<br/>Version compatibility"]
            AuthMiddleware --> OAuth2Provider
            AuthMiddleware --> CustomAuthProvider
        end

        subgraph Routing["Routing & ABAC Layer"]
            InferenceRouter["InferenceRouter<br/>inference.py<br/>Model-based dispatch"]
            RoutingTable["CommonRoutingTableImpl<br/>common.py<br/>ABAC enforcement"]
            InferenceRouter -->|resolves provider| RoutingTable
        end

        subgraph APIs["API Protocols"]
            InferenceAPI["Inference API"]
            AgentsAPI["Agents API"]
            SafetyAPI["Safety API"]
            VectorIOAPI["Vector I/O API"]
            DatasetIOAPI["Dataset I/O API"]
            ScoringAPI["Scoring API"]
            EvalAPI["Eval API"]
            ToolRuntimeAPI["Tool Runtime API"]
        end

        subgraph Persistence["Persistence Layer"]
            AgentPersistence["AgentPersistence<br/>persistence.py<br/>KV store<br/>Per-session ABAC"]
        end

        subgraph UI["UI Module"]
            StreamlitUI["Streamlit UI<br/>ui/modules/api.py<br/>llama-stack-client SDK"]
        end
    end

    %% External flow
    Client[External Client] -->|"HTTP/HTTPS<br/>Bearer Token"| FastAPIServer
    FastAPIServer --> AuthMiddleware
    AuthMiddleware --> QuotaMiddleware
    QuotaMiddleware --> ClientVersionMW
    ClientVersionMW --> DynamicRoutes
    DynamicRoutes --> InferenceAPI
    DynamicRoutes --> AgentsAPI
    DynamicRoutes --> SafetyAPI
    DynamicRoutes --> VectorIOAPI
    DynamicRoutes --> DatasetIOAPI
    DynamicRoutes --> ToolRuntimeAPI
    InferenceAPI --> InferenceRouter
    AgentsAPI --> AgentPersistence
    StreamlitUI -->|"llama-stack-client SDK"| FastAPIServer

    %% External providers
    InferenceRouter -->|"HTTPS"| OpenAI["OpenAI API"]
    InferenceRouter -->|"HTTPS"| Cerebras["Cerebras API"]
    InferenceRouter -->|"HTTPS"| NVIDIA["NVIDIA NeMo API"]
    InferenceRouter -->|"HTTPS"| vLLM["vLLM Provider"]
    ToolRuntimeAPI -->|"HTTPS/443"| Tavily["Tavily Search API"]

    OAuth2Provider -->|"HTTPS<br/>JWKS/Introspection"| AuthEndpoint["OAuth2/OIDC Endpoint"]
    CustomAuthProvider -->|"HTTP<br/>Token forwarding"| ExternalAuth["External Auth Endpoint"]

    %% Styling
    style FastAPIServer fill:#4a90e2,stroke:#333,color:#fff
    style AuthMiddleware fill:#e74c3c,stroke:#333,color:#fff
    style OAuth2Provider fill:#e74c3c,stroke:#333,color:#fff
    style CustomAuthProvider fill:#e74c3c,stroke:#333,color:#fff
    style InferenceRouter fill:#4a90e2,stroke:#333,color:#fff
    style RoutingTable fill:#4a90e2,stroke:#333,color:#fff
    style AgentPersistence fill:#4a90e2,stroke:#333,color:#fff
    style StreamlitUI fill:#9b59b6,stroke:#333,color:#fff
    style OpenAI fill:#e8e8e8,stroke:#333
    style Cerebras fill:#e8e8e8,stroke:#333
    style NVIDIA fill:#e8e8e8,stroke:#333
    style vLLM fill:#e8e8e8,stroke:#333
    style Tavily fill:#e8e8e8,stroke:#333
    style AuthEndpoint fill:#e8e8e8,stroke:#333
    style ExternalAuth fill:#e8e8e8,stroke:#333
    style Client fill:#f5a623,stroke:#333
