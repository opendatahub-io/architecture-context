graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PodBoundary["MODELMESH POD BOUNDARY (Auth/TLS Enforcement)"]
        direction TB

        subgraph MMContainer["ModelMesh Container"]
            ModelMesh["ModelMesh<br/>TLS Termination<br/>Auth Enforcement<br/>Platform-managed"]
        end

        subgraph CaikitContainer["caikit-tgis-backend Container"]
            CaikitBackend["caikit-tgis-backend<br/>Python gRPC Service<br/>Caikit Runtime"]
            LBProxy["GRPCLoadBalancerProxy<br/>DNS poll: 10s<br/>Policy: round_robin"]
            CaikitBackend --> LBProxy
        end

        ModelMesh -->|"gRPC (pod-local)<br/>No encryption<br/>Pod trust boundary"| CaikitBackend
    end

    subgraph TGISZone["TGIS (Inference Backend)"]
        TGIS["TGIS Instance(s)<br/>gRPC + HTTP health"]
    end

    subgraph DNSZone["DNS Service"]
        DNS["DNS<br/>Endpoint Discovery"]
    end

    %% External to ModelMesh
    Client -->|"gRPC<br/>TLS (platform-managed)<br/>Platform Auth"| ModelMesh

    %% LBProxy to TGIS
    LBProxy -->|"gRPC<br/>Configurable TLS<br/>(secure or insecure channel)"| TGIS

    %% Health check
    CaikitBackend -.->|"HTTP health check<br/>(requests library)"| TGIS

    %% DNS discovery
    DNS -.->|"Endpoint resolution<br/>Poll: 10s interval"| LBProxy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef podlocal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef infra fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class ModelMesh authboundary
    class CaikitBackend,LBProxy podlocal
    class TGIS backend
    class DNS infra
