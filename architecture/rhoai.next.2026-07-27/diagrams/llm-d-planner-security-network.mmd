graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External User / Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Router - TLS Edge Termination)"]
        PlannerRoute["planner Route<br/>HTTPS → HTTP :8501<br/>TLS Edge Termination<br/>Auth: None"]
        BackendRoute["planner-backend Route<br/>HTTPS → HTTP :8000<br/>TLS Edge Termination<br/>Auth: None"]
    end

    subgraph Namespace["NAMESPACE: planner (Internal - Plaintext)"]
        direction TB

        UI["Streamlit UI<br/>:8501/TCP HTTP<br/>Probe: /_stcore/health<br/>⚠ No auth middleware"]

        Backend["FastAPI Backend<br/>:8000/TCP HTTP<br/>SA: planner-backend<br/>30 REST endpoints<br/>⚠ No auth middleware<br/>⚠ CORS: * (all origins)<br/>✓ Restricted pod security"]

        Ollama["Ollama Server<br/>:11434/TCP HTTP<br/>nvidia.com/gpu: 1<br/>Model: Granite 3.3 2b<br/>PVC: ollama-pvc 20Gi"]

        Postgres["PostgreSQL 16<br/>:5432/TCP<br/>Auth: Password (secret)<br/>PVC: postgres-pvc 5Gi"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        OpenAIAPI["OpenAI-compatible API<br/>HTTPS TLS<br/>API Key Auth"]
        VertexAI["Vertex AI<br/>HTTPS TLS<br/>GCP SA Auth"]
        HFHub["HuggingFace Hub<br/>HTTPS TLS<br/>Bearer Token Auth"]
        ModelCatalog["Model Catalog<br/>HTTPS TLS<br/>Bearer Token Auth"]
        ServiceCA["OpenShift Service CA<br/>CA Bundle Injection"]
    end

    %% External flows
    Client -->|"HTTPS<br/>TLS Edge<br/>No Auth"| PlannerRoute
    Client -->|"HTTPS<br/>TLS Edge<br/>No Auth"| BackendRoute

    %% Ingress to internal
    PlannerRoute -->|"HTTP :8501<br/>Plaintext<br/>No Auth"| UI
    BackendRoute -->|"HTTP :8000<br/>Plaintext<br/>No Auth"| Backend

    %% Internal flows
    UI -->|"HTTP :8000<br/>Plaintext<br/>No Auth"| Backend
    Backend -->|"PostgreSQL :5432<br/>Plaintext<br/>Password Auth"| Postgres
    Backend -->|"HTTP :11434<br/>Plaintext<br/>No Auth"| Ollama

    %% External service flows
    Backend -->|"HTTPS :6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Backend -->|"HTTPS<br/>TLS<br/>API Key"| OpenAIAPI
    Backend -->|"HTTPS<br/>TLS<br/>GCP SA"| VertexAI
    Backend -->|"HTTPS<br/>TLS<br/>Bearer Token"| HFHub
    Backend -->|"HTTPS<br/>TLS<br/>Bearer Token"| ModelCatalog
    ServiceCA -.->|"CA Bundle<br/>/etc/pki/service-ca"| Backend

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class PlannerRoute,BackendRoute ingress
    class UI,Ollama,Postgres internal
    class Backend warning
    class K8sAPI,OpenAIAPI,VertexAI,HFHub,ModelCatalog,ServiceCA externalservice
