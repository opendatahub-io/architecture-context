graph LR
    Orchestrator["fms-guardrails-orchestrator<br/>(Rust Service)"]

    %% Internal Platform Dependencies
    Orchestrator -->|"gRPC client<br/>port 8033"| TGIS["TGIS Generation Service"]
    Orchestrator -->|"gRPC client<br/>port 8085<br/>TLS optional"| Chunker["Chunker Services"]
    Orchestrator -->|"REST client<br/>port 8080<br/>TLS optional<br/>Bearer optional"| Detector["Detector Services"]
    Orchestrator -->|"REST health client<br/>port 8081"| DetectorHealth["Detector Health Services"]

    %% Key Runtime Dependencies
    subgraph RustFrameworks["Core Rust Frameworks"]
        Axum["axum 0.8.8<br/>(HTTP server)"]
        Tonic["tonic 0.14.2<br/>(gRPC client)"]
        Reqwest["reqwest 0.12.28<br/>(REST client)"]
        Tokio["tokio 1.49.0<br/>(async runtime)"]
        Rustls["rustls 0.23.36<br/>(TLS)"]
    end

    subgraph Observability["Observability Stack"]
        OTel["opentelemetry 0.31.0"]
        OTelOTLP["opentelemetry-otlp 0.31.0"]
        Tracing["tracing 0.1.44"]
        TracingOTel["tracing-opentelemetry 0.32.0"]
    end

    subgraph Serialization["Serialization"]
        Serde["serde 1.0.228"]
        SerdeJSON["serde_json 1.0.149"]
        SerdeYML["serde_yml 0.0.12"]
        Prost["prost 0.14.1<br/>(protobuf)"]
    end

    Orchestrator -.->|"HTTP framework"| Axum
    Orchestrator -.->|"gRPC framework"| Tonic
    Orchestrator -.->|"REST client"| Reqwest
    Orchestrator -.->|"async runtime"| Tokio
    Orchestrator -.->|"TLS provider"| Rustls
    Orchestrator -.->|"telemetry"| OTel
    Orchestrator -.->|"serialization"| Serde

