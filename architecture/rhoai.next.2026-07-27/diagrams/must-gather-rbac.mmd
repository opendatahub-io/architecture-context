graph TD
    subgraph "Service Account (Auto-Provisioned)"
        SA["must-gather SA<br/>(provisioned by oc adm must-gather)"]
    end

    subgraph "Access Pattern"
        ReadOnly["Read-Only Access<br/>(no write operations)"]
    end

    subgraph "API Resources Accessed"
        direction TB

        subgraph "Core Resources"
            Namespaces["core<br/>Namespaces"]
            Pods["core<br/>Pods"]
            PodLogs["core<br/>Pods/log"]
            ConfigMaps["core<br/>ConfigMaps"]
            Secrets["core<br/>Secrets (metadata)"]
            Services["core<br/>Services"]
        end

        subgraph "RHOAI Operator CRs"
            DSCI["dscinitialization.opendatahub.io<br/>DSCInitialization"]
            DSC["datasciencecluster.opendatahub.io<br/>DataScienceCluster"]
            ComponentCRs["*.opendatahub.io<br/>Component CRs"]
        end

        subgraph "Serving & Inference CRDs"
            InferenceService["serving.kserve.io<br/>InferenceService"]
            ServingRuntime["serving.kserve.io<br/>ServingRuntime"]
            NIMCRs["NIM / llm-d CRDs"]
        end

        subgraph "Pipeline CRDs"
            DSPipeline["datasciencepipelinesapplications<br/>DSPipeline"]
            KubeflowCRs["Kubeflow / Argo CRDs"]
        end

        subgraph "Network & Gateway Resources"
            GatewayClasses["gateway.networking.k8s.io<br/>GatewayClass"]
            Gateways["gateway.networking.k8s.io<br/>Gateway"]
            IstioResources["networking.istio.io<br/>VirtualService, Gateway,<br/>DestinationRule"]
        end

        subgraph "Cluster Config"
            WebhookConfigs["admissionregistration.k8s.io<br/>ValidatingWebhookConfiguration<br/>MutatingWebhookConfiguration"]
            HelmSecrets["core/Secrets<br/>(helm.sh/release labels)"]
        end
    end

