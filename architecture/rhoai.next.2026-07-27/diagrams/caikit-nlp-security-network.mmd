graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AppService["APPLICATION SERVICE (caikit-nlp + Caikit Runtime)"]
        direction TB

        subgraph RuntimeLayer["Caikit Runtime"]
            gRPCServer["gRPC Server<br/>8085/TCP<br/>TLS/mTLS (configurable)<br/>Auth: platform-delegated"]
            RESTGateway["REST Gateway<br/>8080/TCP<br/>TLS (configurable)<br/>Auth: platform-delegated"]
        end

        subgraph ModuleLayer["caikit-nlp Modules"]
            TextGenLocal["TextGeneration<br/>(Local HF Transformers)"]
            TextGenTGIS["TextGenerationTGIS<br/>(Remote TGIS Backend)"]
            FilteredSpan["FilteredSpanClassification"]
            RegexSplit["RegexSentenceSplitter"]
            TGISClient["TGISGenerationClient<br/>(gRPC Client)"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        TGISServer["TGIS Server<br/>gRPC (HTTP/2)<br/>TLS/mTLS (configurable)<br/>Auth: env-configured"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: API token (optional)"]
    end

    %% Inbound flows
    Client -->|"gRPC/8085<br/>TLS/mTLS (configurable)<br/>Auth: platform-delegated"| gRPCServer
    Client -->|"HTTP/8080<br/>TLS (configurable)<br/>Auth: platform-delegated"| RESTGateway

    %% Internal dispatch
    gRPCServer -->|dispatch| TextGenLocal
    gRPCServer -->|dispatch| TextGenTGIS
    gRPCServer -->|dispatch| FilteredSpan
    gRPCServer -->|dispatch| RegexSplit
    RESTGateway -->|dispatch| TextGenLocal
    RESTGateway -->|dispatch| TextGenTGIS

    %% Outbound flows
    TextGenTGIS -->|delegate| TGISClient
    TGISClient -->|"gRPC (HTTP/2)<br/>TLS/mTLS (configurable)<br/>Auth: env-configured"| TGISServer
    TextGenLocal -->|"HTTPS/443<br/>TLS 1.2+<br/>API token (optional)"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef runtime fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef module fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class gRPCServer,RESTGateway runtime
    class TextGenLocal,TextGenTGIS,FilteredSpan,RegexSplit,TGISClient module
    class TGISServer,HFHub externalservice
