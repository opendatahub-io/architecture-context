graph TD
    subgraph "vllm-orchestrator-gateway RBAC"
        direction TB
        Note["No Kubernetes RBAC roles or bindings<br/>defined in repository"]
    end

    subgraph "Deployment Context"
        direction TB
        ExtOperator["External Operator / Kustomize Overlay<br/>Manages deployment and RBAC externally"]
    end

    subgraph "Runtime Identity (Inferred)"
        direction TB
        SA["ServiceAccount<br/>(provisioned by deployer)"]
        Pod["vllm-orchestrator-gateway Pod"]
    end

    subgraph "Filesystem Access"
        direction TB
        TLSCert["Volume Mount<br/>/etc/tls/private/tls.crt<br/>/etc/tls/private/tls.key"]
        CACert["Volume Mount<br/>/etc/tls/ca/service-ca.crt"]
        ConfigFile["ConfigMap / Volume<br/>config/config.yaml<br/>(GATEWAY_CONFIG env)"]
    end

    ExtOperator -->|"creates"| SA
    ExtOperator -->|"deploys"| Pod
    SA -->|"identity for"| Pod
    Pod -->|"reads"| TLSCert
    Pod -->|"reads"| CACert
    Pod -->|"reads"| ConfigFile

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ExtOperator fill:#e8e8e8,stroke:#333
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Pod fill:#4a90e2,stroke:#333,color:#fff
    style TLSCert fill:#f8cecc,stroke:#b85450
    style CACert fill:#f8cecc,stroke:#b85450
    style ConfigFile fill:#d5e8d4,stroke:#82b366
