graph TB
    subgraph LocalProcess["LOCAL PROCESS (No Inbound Surface)"]
        direction TB
        LMEval["lm-eval CLI Process<br/>Python >=3.11, <3.13<br/>CLI batch — no listeners<br/>No ServiceAccount"]
    end

    subgraph ModelAPIs["EXTERNAL MODEL APIs (Egress)"]
        direction TB
        Anthropic["Anthropic API<br/>api.anthropic.com<br/>443/TCP HTTPS TLS<br/>Auth: ANTHROPIC_API_KEY"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS TLS<br/>Auth: OPENAI_API_KEY"]
        Watsonx["IBM Watsonx AI<br/>cloud.ibm.com<br/>443/TCP HTTPS TLS<br/>Auth: WATSONX_API_KEY"]
    end

    subgraph DataStorage["DATA & MODEL STORAGE (Egress)"]
        direction TB
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS TLS<br/>Auth: HF_TOKEN (optional)"]
        HFDatasets["HF Datasets Server<br/>datasets-server.huggingface.co<br/>443/TCP HTTPS TLS"]
        S3["S3-Compatible Storage<br/>Configurable endpoint<br/>HTTPS TLS<br/>Auth: AWS IAM (boto3)"]
    end

    subgraph Reporting["OPTIONAL REPORTING (Egress)"]
        WandB["Weights & Biases<br/>api.wandb.ai<br/>443/TCP HTTPS TLS"]
    end

    %% Flows — all outbound from CLI process
    LMEval -->|"HTTPS/443<br/>TLS<br/>API Key (Bearer)"| Anthropic
    LMEval -->|"HTTPS/443<br/>TLS<br/>API Key (Bearer)"| OpenAI
    LMEval -->|"HTTPS/443<br/>TLS<br/>API Key"| Watsonx
    LMEval -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub
    LMEval -->|"HTTPS/443<br/>TLS"| HFDatasets
    LMEval -->|"HTTPS<br/>TLS<br/>AWS IAM"| S3
    LMEval -.->|"HTTPS/443<br/>TLS<br/>Optional"| WandB

    %% Styling
    classDef localprocess fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef modelapi fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef datastorage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef reporting fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray:5

    class LMEval localprocess
    class Anthropic,OpenAI,Watsonx modelapi
    class HFHub,HFDatasets,S3 datastorage
    class WandB reporting
