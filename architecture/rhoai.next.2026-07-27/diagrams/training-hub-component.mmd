graph TB
    subgraph "training_hub Python Library"
        direction TB

        subgraph "User API Layer"
            sft["sft()"]
            osft["osft()"]
            lora_sft["lora_sft()"]
            lora_grpo["lora_grpo()"]
            gepa_fn["gepa()"]
        end

        subgraph "Algorithm Layer"
            SFT_Algo["SFT Algorithm"]
            OSFT_Algo["OSFT Algorithm"]
            LoRA_SFT_Algo["LoRA SFT Algorithm"]
            LoRA_GRPO_Algo["LoRA GRPO Algorithm"]
            GEPA_Algo["GEPA Algorithm"]
        end

        Registry["AlgorithmRegistry<br/>Runtime discovery &amp; selection"]

        subgraph "Backend Layer (Pluggable)"
            ILab["instructlab-training<br/>Backend"]
            MiniTrainer["rhai-innovation-<br/>mini-trainer Backend"]
            Unsloth["unsloth<br/>Backend"]
            ART["openpipe-art<br/>Backend"]
            Verl["verl<br/>Backend"]
            GEPA_BE["gepa<br/>Backend"]
        end

        subgraph "Auxiliary Modules"
            GPUProfile["GPU Memory<br/>Profiler/Estimator"]
            ITSRollout["ITS Hub Rollout<br/>Integration"]
            RewardFns["Reward Functions<br/>Tool-call Verification"]
            LossViz["Loss<br/>Visualization"]
        end
    end

    %% User API → Algorithm connections
    sft -->|delegates| SFT_Algo
    osft -->|delegates| OSFT_Algo
    lora_sft -->|delegates| LoRA_SFT_Algo
    lora_grpo -->|delegates| LoRA_GRPO_Algo
    gepa_fn -->|delegates| GEPA_Algo

    %% Algorithms register with registry
    SFT_Algo ---|registered in| Registry
    OSFT_Algo ---|registered in| Registry
    LoRA_SFT_Algo ---|registered in| Registry
    LoRA_GRPO_Algo ---|registered in| Registry
    GEPA_Algo ---|registered in| Registry

    %% Algorithm → Backend dispatch
    SFT_Algo -->|dispatches| ILab
    SFT_Algo -->|dispatches| MiniTrainer
    OSFT_Algo -->|dispatches| MiniTrainer
    LoRA_SFT_Algo -->|dispatches| MiniTrainer
    LoRA_SFT_Algo -->|dispatches| Unsloth
    LoRA_GRPO_Algo -->|dispatches| ART
    LoRA_GRPO_Algo -->|dispatches| Verl
    GEPA_Algo -->|dispatches| GEPA_BE

    %% External services
    LLM_API["LLM API<br/>(via litellm)"]
    MLflow["MLflow<br/>Tracking Server"]
    WandB["Weights &amp; Biases<br/>API"]

    ART -->|manages vLLM engines| LLM_API
    Verl -->|subprocess Ray/torchrun| LLM_API
    LoRA_GRPO_Algo -.->|metrics| MLflow
    LoRA_GRPO_Algo -.->|metrics| WandB

    %% User
    User["User / Notebook"] -->|import &amp; call| sft
    User -->|import &amp; call| osft
    User -->|import &amp; call| lora_sft
    User -->|import &amp; call| lora_grpo
    User -->|import &amp; call| gepa_fn

    %% Styling
    style sft fill:#4a90e2,color:#fff
    style osft fill:#4a90e2,color:#fff
    style lora_sft fill:#4a90e2,color:#fff
    style lora_grpo fill:#4a90e2,color:#fff
    style gepa_fn fill:#4a90e2,color:#fff
    style SFT_Algo fill:#7ed321,color:#fff
    style OSFT_Algo fill:#7ed321,color:#fff
    style LoRA_SFT_Algo fill:#7ed321,color:#fff
    style LoRA_GRPO_Algo fill:#7ed321,color:#fff
    style GEPA_Algo fill:#7ed321,color:#fff
    style Registry fill:#f5a623,color:#fff
    style ILab fill:#9b59b6,color:#fff
    style MiniTrainer fill:#9b59b6,color:#fff
    style Unsloth fill:#9b59b6,color:#fff
    style ART fill:#9b59b6,color:#fff
    style Verl fill:#9b59b6,color:#fff
    style GEPA_BE fill:#9b59b6,color:#fff
    style GPUProfile fill:#e8e8e8
    style ITSRollout fill:#e8e8e8
    style RewardFns fill:#e8e8e8
    style LossViz fill:#e8e8e8
    style LLM_API fill:#f39c12
    style MLflow fill:#f39c12
    style WandB fill:#f39c12
    style User fill:#2c3e50,color:#fff
