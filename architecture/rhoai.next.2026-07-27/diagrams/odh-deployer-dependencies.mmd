graph LR
    ODHDeployer["odh-deployer<br/>(deploy.sh)"]

    %% Infrastructure Dependencies
    ODHDeployer -->|"oc CLI / HTTPS 6443"| OpenShiftAPI["OpenShift API Server"]
    ODHDeployer -->|"KfDef CRs"| KubeflowOp["KubeFlow Operator"]

    %% Internal RHOAI Components (deployed via KfDef)
    ODHDeployer -->|"KfDef CR"| Dashboard["RHOAI Dashboard"]
    ODHDeployer -->|"KfDef CR"| NBC["Notebook Controller"]
    ODHDeployer -->|"KfDef CR"| ModelMesh["Model Mesh"]
    ODHDeployer -->|"KfDef CR"| DSPO["Data Science Pipelines Operator"]
    ODHDeployer -->|"KfDef CR"| Notebooks["Notebooks"]
    ODHDeployer -->|"KfDef CR"| Anaconda["Anaconda"]

    %% Monitoring Dependencies (directly deployed)
    ODHDeployer -->|"deploys directly"| Prometheus["Prometheus"]
    ODHDeployer -->|"deploys directly"| Alertmanager["Alertmanager"]

    %% Prometheus scrape targets
    Prometheus -->|"scrapes :8443"| Dashboard
    Prometheus -->|"scrapes :8080"| NBC
    Prometheus -->|"scrapes :8080"| ModelCtrl["model-controller"]
    Prometheus -->|"scrapes :8080"| ModelMesh
    Prometheus -->|"scrapes :8080"| DSPO

    %% External alerting (OSD only)
    Alertmanager -.->|"OSD only"| PagerDuty["PagerDuty"]
    Alertmanager -.->|"OSD only"| DMS["Dead Man's Snitch"]
    Alertmanager -.->|"OSD only"| SMTP["SMTP Server"]

    %% OSD Detection
    ODHDeployer -.->|"detects"| CatalogSource["addon-managed-odh-catalog<br/>CatalogSource"]

    %% Styling
    style ODHDeployer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OpenShiftAPI fill:#999,stroke:#333,color:#fff
    style KubeflowOp fill:#999,stroke:#333,color:#fff
    style CatalogSource fill:#999,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style NBC fill:#7ed321,stroke:#333,color:#fff
    style ModelMesh fill:#7ed321,stroke:#333,color:#fff
    style DSPO fill:#7ed321,stroke:#333,color:#fff
    style Notebooks fill:#7ed321,stroke:#333,color:#fff
    style Anaconda fill:#7ed321,stroke:#333,color:#fff
    style ModelCtrl fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style Alertmanager fill:#e6522c,stroke:#333,color:#fff
    style PagerDuty fill:#f5a623,stroke:#333
    style DMS fill:#f5a623,stroke:#333
    style SMTP fill:#f5a623,stroke:#333
