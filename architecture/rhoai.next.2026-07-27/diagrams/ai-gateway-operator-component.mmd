graph TB
    subgraph AIGatewayOperator["AI Gateway Operator"]
        direction TB
        Controller["AIGateway Controller<br/><i>controller-runtime 0.24.1</i>"]
        ModuleManager["ODH Module Manager<br/><i>odhmanager.New()</i>"]
        KustomizeRenderer["Kustomize Renderer<br/><i>Manifest Reconciliation</i>"]
        Controller --> ModuleManager
        ModuleManager --> KustomizeRenderer
    end

    subgraph HealthMetrics["Health & Metrics"]
        HealthProbe["/healthz, /readyz<br/>Port 8081/HTTP"]
        MetricsEndpoint["Metrics Endpoint<br/>Port 8443/TCP TLS"]
    end

    subgraph ManagedSubComponents["Managed Sub-Components"]
        direction LR
        BatchGateway["Batch Gateway<br/><i>batch.llm-d.ai/llmbatchgateways</i><br/>managementState: Managed|Removed"]
        MaaS["Models-as-a-Service<br/><i>maas.opendatahub.io</i><br/><i>inference.opendatahub.io</i><br/>managementState: Managed|Removed"]
    end

    %% CRD
    Admin[Platform Admin] -->|creates| AIGatewayCR["AIGateway CR<br/><i>components.platform.opendatahub.io/v1alpha1</i><br/>Cluster-scoped singleton<br/>(default-aigateway)"]
    AIGatewayCR -->|watched by| Controller

    %% Sub-component management
    KustomizeRenderer -->|deploys| BatchGateway
    KustomizeRenderer -->|deploys| MaaS

    %% Platform Dependencies
    Controller -->|watches| DSCI["DSCInitialization CR"]
    Controller -->|watches| KServe["KServe<br/>InferenceService"]
    Controller -->|manages| CertMgr["cert-manager<br/>Certificates"]
    Controller -->|manages| GatewayAPI["Gateway API<br/>HTTPRoutes"]
    Controller -->|manages| Kuadrant["Kuadrant<br/>AuthPolicies<br/>RateLimitPolicies"]
    Controller -->|manages| Istio["Istio<br/>DestinationRules<br/>EnvoyFilters<br/>ServiceEntries"]
    Controller -->|manages| PromOp["prometheus-operator<br/>ServiceMonitors<br/>PrometheusRules"]
    Controller -->|manages| OTel["OpenTelemetry<br/>Collectors"]
    Controller -->|manages| Perses["Perses<br/>Dashboards"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style ModuleManager fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeRenderer fill:#4a90e2,stroke:#333,color:#fff
    style AIGatewayCR fill:#f5a623,stroke:#333,color:#000
    style BatchGateway fill:#7ed321,stroke:#333,color:#000
    style MaaS fill:#7ed321,stroke:#333,color:#000
    style DSCI fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style CertMgr fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Kuadrant fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style PromOp fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style Perses fill:#e8e8e8,stroke:#333
    style HealthProbe fill:#d5e8d4,stroke:#82b366
    style MetricsEndpoint fill:#d5e8d4,stroke:#82b366
