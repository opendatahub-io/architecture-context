graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph BFFLayer["BFF GATEWAY LAYER"]
        BFF["BFF Server<br/>8080/TCP HTTP<br/>distroless (nonroot 65532)<br/>SAR Authorization Pipeline"]
    end

    subgraph Internal["INTERNAL SERVICES (Cluster-scoped)"]
        direction TB

        subgraph NS_Registry["model-registry"]
            Registry["model-registry<br/>8080/TCP HTTP<br/>UBI9-minimal (UID 1001)<br/>FIPS: strictfipsruntime"]
        end

        subgraph NS_Catalog["model-catalog"]
            CatalogServer["model-catalog-server<br/>ClusterIP 8080/TCP HTTP<br/>Plugin-based Routes<br/>Health: /healthz, /readyz"]
            CatalogDB["model-catalog-postgres<br/>ClusterIP 5432/TCP<br/>PostgreSQL 17.6<br/>StatefulSet"]
        end

        subgraph NS_Controller["Controller"]
            Manager["Manager Controller<br/>8081/TCP Health<br/>Watches: InferenceService"]
        end
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        KServe["KServe InferenceService<br/>serving.kserve.io/v1beta1<br/>Controller Watch"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM Auth"]
        OCI["OCI Registry<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Registry Credentials"]
        HF["HuggingFace Hub<br/>443/TCP HTTPS<br/>API Key Auth"]
    end

    %% User to BFF
    User -->|"HTTP/8080<br/>Bearer Token<br/>User Identity"| BFF

    %% BFF to internal services
    BFF -->|"HTTP/8080<br/>Proxy (Custom CA)<br/>ServiceAccount"| Registry
    BFF -->|"HTTP/8080<br/>Proxy (Custom CA)<br/>ServiceAccount"| CatalogServer

    %% BFF to K8s API (AuthZ)
    BFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>SAR / SSAR / SSRR<br/>ServiceAccount"| K8sAPI

    %% Catalog internals
    CatalogServer -->|"PostgreSQL/5432<br/>Credentials from Secret"| CatalogDB

    %% Controller flows
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>Watch InferenceService<br/>ServiceAccount"| K8sAPI
    K8sAPI -.->|"Watch Events"| KServe

    %% External service flows
    Registry -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    Registry -->|"HTTPS/443<br/>TLS 1.2+<br/>Registry Creds"| OCI
    CatalogServer -->|"HTTPS/443<br/>API Key"| HF

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef bff fill:#4a90e2,stroke:#2171c7,stroke-width:2px,color:#fff
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef database fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class BFF bff
    class Registry,CatalogServer,Manager internal
    class CatalogDB database
    class K8sAPI,KServe platform
    class S3,OCI,HF externalservice
