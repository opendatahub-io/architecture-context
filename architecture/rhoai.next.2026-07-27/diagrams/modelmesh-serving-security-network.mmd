graph TB
    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS, TLS 1.2+<br/>ServiceAccount Token Auth"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE"]
        direction TB

        subgraph WebhookZone["Webhook Server (TLS)"]
            WebhookSvc["modelmesh-webhook-server-service<br/>ClusterIP 9443/TCP<br/>TLS (modelmesh-webhook-server-cert)<br/>Kubernetes Admission Auth"]
        end

        subgraph ProbeZone["Health Probes (Plaintext)"]
            Probes["Health/Readiness<br/>8081/TCP HTTP<br/>No encryption, No auth<br/>/healthz, /readyz"]
        end

        subgraph DebugZone["Debug Endpoint"]
            Debug["/debug/<br/>HTTP<br/>⚠ Auth: Unknown"]
        end

        Controller["modelmesh-controller<br/>SA: modelmesh-controller<br/>SCC: restricted<br/>Leader Election: leases"]
    end

    subgraph UserNS["USER NAMESPACES (Serving Runtimes)"]
        RuntimePods["ModelMesh Runtime Pods<br/>Model Server + ModelMesh Sidecar<br/>gRPC communication"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        etcd["etcd<br/>Model Placement Coordination<br/>etcd client v3<br/>⚠ Encryption: Unknown"]
        Prometheus["Prometheus<br/>prometheus-operator<br/>ServiceMonitor CRDs<br/>HTTPS, TLS 1.2+"]
    end

    %% Control plane flows
    K8sAPI -->|"Admission Review<br/>HTTPS/9443<br/>TLS"| WebhookSvc
    Controller -->|"Watch/CRUD<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Controller to runtime pods
    Controller -->|"gRPC<br/>Model lifecycle ops<br/>Endpoints-based resolver<br/>⚠ Encryption unknown"| RuntimePods

    %% Controller to external
    Controller -->|"etcd client v3<br/>Range watch<br/>⚠ Auth unknown"| etcd
    Controller -->|"CRD CRUD<br/>ServiceMonitor mgmt<br/>HTTPS, TLS 1.2+"| Prometheus

    %% Prometheus scraping
    Prometheus -.->|"Metrics scrape<br/>via ServiceMonitor"| RuntimePods

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef probe fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef runtime fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#f5f5f5,stroke:#666,stroke-width:2px
    classDef warning fill:#fff2cc,stroke:#d6b656,stroke-width:2px,stroke-dasharray: 5 5

    class K8sAPI controlplane
    class Controller controller
    class WebhookSvc webhook
    class Probes probe
    class Debug warning
    class RuntimePods runtime
    class etcd,Prometheus external
