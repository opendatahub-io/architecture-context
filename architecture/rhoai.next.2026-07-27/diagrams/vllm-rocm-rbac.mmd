graph TD
    subgraph "vllm-rocm RBAC"
        Note["No RBAC roles, bindings, or<br/>service accounts defined in<br/>this repository"]
    end

    subgraph "Container Security"
        NonRoot["Non-root execution<br/>UID: 2000"]
        NoPriv["No privileged capabilities<br/>required by image"]
    end

    subgraph "Platform-Managed RBAC (not in this repo)"
        PlatformSA["Service Account<br/>(created by deploying platform)"]
        PlatformRole["Roles & Bindings<br/>(managed by KServe/ModelMesh)"]
        PlatformSA -->|"bound by platform"| PlatformRole
    end

    subgraph "Platform-Managed Auth (not in this repo)"
        TLS["TLS Termination<br/>(platform layer)"]
        AuthN["Authentication<br/>(platform layer)"]
        AuthZ["Authorization<br/>(platform layer)"]
    end

    Note -.->|"delegated to"| PlatformSA
    NonRoot -.->|"runtime identity"| PlatformSA

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style NonRoot fill:#d5e8d4,stroke:#82b366
    style NoPriv fill:#d5e8d4,stroke:#82b366
    style PlatformSA fill:#e8e8e8,stroke:#999
    style PlatformRole fill:#e8e8e8,stroke:#999
    style TLS fill:#e8e8e8,stroke:#999
    style AuthN fill:#e8e8e8,stroke:#999
    style AuthZ fill:#e8e8e8,stroke:#999
