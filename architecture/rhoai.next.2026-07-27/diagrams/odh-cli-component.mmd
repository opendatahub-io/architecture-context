graph TB
    subgraph "odh-cli (kubectl-odh plugin)"
        direction TB

        subgraph "Command Layer"
            CLI[Cobra CLI Entry<br/>cmd/main.go]
            API[api]
            Version[version]
            Lint[lint]
            Get[get]
            Deps[deps]
            Components[components]
            Status[status]
            Logs[logs]
            Completion[completion]
            MCP[mcp]
            Migrate[migrate]
            Events[events]
        end

        subgraph "Client Layer"
            UnifiedClient[Unified Client<br/>pkg/util/client/client.go]
            DynamicClient[Dynamic Client]
            DiscoveryClient[Discovery Client]
            ApiExtClient[API Extensions Client]
            OLMClient[OLM Client]
            MetadataClient[Metadata Client]
            TypedClient[Typed Kubernetes Client]
        end

        subgraph "Utility Layer"
            RBACCheck[RBAC Pre-flight<br/>pkg/util/kube/rbac/check.go<br/>SelfSubjectAccessReview]
            EventFilter[Event Filter<br/>pkg/events/filter.go<br/>Watch + Reconnection]
            OLMInstall[OLM Install<br/>pkg/util/kube/olm/install.go]
        end
    end

    User[User / kubectl] -->|runs| CLI
    CLI --> API
    CLI --> Version
    CLI --> Lint
    CLI --> Get
    CLI --> Deps
    CLI --> Components
    CLI --> Status
    CLI --> Logs
    CLI --> Completion
