graph TB
    subgraph Operator["model-registry-operator-controller-manager"]
        direction TB
        MRReconciler["ModelRegistryReconciler<br/>(per-registry instances)"]
        MCReconciler["ModelCatalogReconciler<br/>(singleton catalog)"]
        WebhookServer["Webhook Server<br/>:9443 TLS"]
        MetricsServer["Metrics Server<br/>:8443 TLS authn/authz"]
        HealthProbe["Health/Ready Probes<br/>:8081"]
        SVMManager["StorageMigrationManager<br/>(v1alpha1 → v1beta1)"]
        SecurityWatcher["SecurityProfileWatcher<br/>(TLS profile changes)"]
    end

    %% CRDs
    ModelRegistryCR["ModelRegistry CR<br/>modelregistry.opendatahub.io<br/>v1alpha1 (deprecated) / v1beta1"]

    %% Admission Webhooks
    ModelRegistryCR -->|CREATE/UPDATE| WebhookServer
    WebhookServer -->|mutate + validate<br/>+ convert| MRReconciler

    %% ModelRegistryReconciler creates per-registry resources
    MRReconciler -->|creates| RegistryDeployment

    subgraph PerRegistry["Per-Registry Instance ({registry-name})"]
        direction TB
        RegistryDeployment["Deployment: {registry-name}"]
        RestContainer["rest-container<br/>:8080 HTTP (localhost)"]
        KubeRBACProxy["kube-rbac-proxy<br/>:8443 HTTPS<br/>TokenReview + SAR"]
        KubeRBACProxy -->|forwards authn'd<br/>requests| RestContainer
        RegistryPostgres["Deployment: {registry-name}-postgres<br/>:5432 PostgreSQL"]
        RegistryService["Service: {registry-name}<br/>:8080/TCP, :8443/TCP"]
        RegistryRoute["Route: {registry-name}-https<br/>HTTPS TLS"]
        RegistryHTTPRoute["HTTPRoute: model-registry-{registry-name}"]
        NetworkPolicy["NetworkPolicy"]
        RegistryRBAC["Role + RoleBinding<br/>+ ClusterRoleBinding"]
        UserGroup["Group: {registry-name}-users"]
    end

    MRReconciler -->|creates| RegistryPostgres
    MRReconciler -->|creates| RegistryService
    MRReconciler -->|creates| RegistryRoute
    MRReconciler -->|creates| RegistryHTTPRoute
    MRReconciler -->|creates| NetworkPolicy
    MRReconciler -->|creates| RegistryRBAC
    MRReconciler -->|creates| UserGroup

    %% ModelCatalogReconciler creates catalog resources
    MCReconciler -->|creates| CatalogDeployment

    subgraph Catalog["Model Catalog (singleton)"]
        direction TB
        CatalogDeployment["Deployment: model-catalog"]
        CatalogRest["catalog container<br/>:8080 HTTP (localhost)"]
        CatalogProxy["kube-rbac-proxy<br/>:8443 HTTPS<br/>TokenReview + SAR"]
        CatalogProxy -->|forwards authn'd<br/>requests| CatalogRest
        CatalogPostgres["Deployment: model-catalog-postgres<br/>:5432 PostgreSQL"]
        CatalogService["Service: model-catalog<br/>:8080/TCP, :8443/TCP"]
        CatalogRoute["Route: model-catalog-https<br/>HTTPS TLS"]
        CatalogHTTPRoute["HTTPRoute: model-catalog"]
        CatalogConfigMaps["Catalog Source ConfigMaps"]
    end

    MCReconciler -->|creates| CatalogPostgres
    MCReconciler -->|creates| CatalogService
    MCReconciler -->|creates| CatalogRoute
    MCReconciler -->|creates| CatalogHTTPRoute
    MCReconciler -->|watches| CatalogConfigMaps

    %% External dependencies
    KubeAPI["Kubernetes API<br/>:6443 HTTPS"]
    GatewayAPI["Gateway API<br/>(data-science-gateway)"]
    OpenShiftRoutes["OpenShift Routes"]
    OpenShiftTLS["OpenShift TLS<br/>Security Profiles"]

    Operator -->|CRUD resources| KubeAPI
    RegistryHTTPRoute -->|routes via| GatewayAPI
    CatalogHTTPRoute -->|routes via| GatewayAPI
    RegistryRoute -->|managed by| OpenShiftRoutes
    CatalogRoute -->|managed by| OpenShiftRoutes
    SecurityWatcher -->|watches| OpenShiftTLS

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style PerRegistry fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style Catalog fill:#e8fde8,stroke:#82b366,stroke-width:2px
    style ModelRegistryCR fill:#f5a623,stroke:#333,color:#fff
    style KubeAPI fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style OpenShiftRoutes fill:#999,stroke:#333,color:#fff
    style OpenShiftTLS fill:#999,stroke:#333,color:#fff
    style KubeRBACProxy fill:#d4380d,stroke:#333,color:#fff
    style CatalogProxy fill:#d4380d,stroke:#333,color:#fff
