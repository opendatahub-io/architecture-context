graph TB
    subgraph TrainingOperator["Training Operator"]
        direction TB
        Controller["kubeflow-training-operator<br/>Deployment"]

        subgraph Reconcilers["Reconcilers"]
            PyTorchReconciler["PyTorchJob<br/>Reconciler"]
            TFReconciler["TFJob<br/>Reconciler"]
            MPIReconciler["MPIJob<br/>Reconciler"]
            XGBoostReconciler["XGBoostJob<br/>Reconciler"]
            PaddleReconciler["PaddleJob<br/>Reconciler"]
            JAXReconciler["JAXJob<br/>Reconciler"]
        end

        subgraph Webhooks["Validating Webhooks (9443/TLS)"]
            PyTorchWH["PyTorchJob<br/>Webhook"]
            TFWH["TFJob<br/>Webhook"]
            XGBoostWH["XGBoostJob<br/>Webhook"]
            PaddleWH["PaddleJob<br/>Webhook"]
            JAXWH["JAXJob<br/>Webhook"]
        end

        MetricsServer["Metrics Server<br/>8080/TLS"]
        HealthProbe["Health Probes<br/>8081/HTTP"]
        CertController["cert-controller<br/>Certificate Rotation"]

        Controller --> Reconcilers
        Controller --> Webhooks
        Controller --> MetricsServer
        Controller --> HealthProbe
        CertController -->|manages certs| Webhooks
        CertController -->|manages certs| MetricsServer
    end

    %% CRDs
    User[Data Scientist] -->|creates| PyTorchJobCR["PyTorchJob CR"]
    User -->|creates| TFJobCR["TFJob CR"]
    User -->|creates| MPIJobCR["MPIJob CR"]
    User -->|creates| XGBoostJobCR["XGBoostJob CR"]
    User -->|creates| PaddleJobCR["PaddleJob CR"]
    User -->|creates| JAXJobCR["JAXJob CR"]

    PyTorchJobCR -->|watched by| PyTorchReconciler
    TFJobCR -->|watched by| TFReconciler
    MPIJobCR -->|watched by| MPIReconciler
    XGBoostJobCR -->|watched by| XGBoostReconciler
    PaddleJobCR -->|watched by| PaddleReconciler
    JAXJobCR -->|watched by| JAXReconciler

    %% Downstream resources created
    PyTorchReconciler -->|creates| WorkerPods["Worker Pods"]
    PyTorchReconciler -->|creates| HPA["HorizontalPodAutoscaler<br/>(elastic training)"]
    TFReconciler -->|creates| WorkerPods
    MPIReconciler -->|creates| WorkerPods
    XGBoostReconciler -->|creates| WorkerPods
    PaddleReconciler -->|creates| WorkerPods
    JAXReconciler -->|creates| WorkerPods

    %% External dependencies
    Controller -->|TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io"]
    Controller -->|optional gang scheduling| Volcano["Volcano PodGroups"]
    Controller -->|optional gang scheduling| SchedulerPlugins["scheduler-plugins PodGroups"]
    Prometheus["Prometheus"] -->|scrapes| MetricsServer

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px
    style PyTorchReconciler fill:#4a90e2,stroke:#333
    style TFReconciler fill:#4a90e2,stroke:#333
    style MPIReconciler fill:#4a90e2,stroke:#333
    style XGBoostReconciler fill:#4a90e2,stroke:#333
    style PaddleReconciler fill:#4a90e2,stroke:#333
    style JAXReconciler fill:#4a90e2,stroke:#333
    style PyTorchWH fill:#4a90e2,stroke:#333
    style TFWH fill:#4a90e2,stroke:#333
    style XGBoostWH fill:#4a90e2,stroke:#333
    style PaddleWH fill:#4a90e2,stroke:#333
    style JAXWH fill:#4a90e2,stroke:#333
    style MetricsServer fill:#4a90e2,stroke:#333
    style HealthProbe fill:#4a90e2,stroke:#333
    style CertController fill:#4a90e2,stroke:#333
    style PyTorchJobCR fill:#f5a623,stroke:#333
    style TFJobCR fill:#f5a623,stroke:#333
    style MPIJobCR fill:#f5a623,stroke:#333
    style XGBoostJobCR fill:#f5a623,stroke:#333
    style PaddleJobCR fill:#f5a623,stroke:#333
    style JAXJobCR fill:#f5a623,stroke:#333
    style WorkerPods fill:#7ed321,stroke:#333
    style HPA fill:#7ed321,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style Volcano fill:#e8e8e8,stroke:#333
