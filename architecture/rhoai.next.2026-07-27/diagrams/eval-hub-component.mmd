graph TB
    subgraph EvalHub["Eval Hub Service"]
        direction TB
        APIServer["EvalHub API Server<br/>REST API<br/>net/http.ServeMux<br/>Optional TLS 1.2-1.3"]
        MCPServer["EvalHub MCP Server<br/>MCP Interface<br/>stdio / Streamable HTTP / SSE"]
        MetricsServer["Metrics Server<br/>Prometheus Metrics<br/>Dedicated HTTP Port"]
        InitContainer["Eval Runtime Init<br/>Init Container<br/>S3 Test Data Download"]

        APIServer -->|"shares observability"| MetricsServer
        MCPServer -->|"shares observability"| MetricsServer
    end

    User["User / Client"] -->|"REST API calls<br/>X-User / X-Tenant headers"| APIServer
    MCPClient["MCP Client"] -->|"tool/resource/prompt<br/>stdio or HTTP"| MCPServer
    KubeRBACProxy["kube-rbac-proxy<br/>(cluster mode)"] -->|"identity enforcement"| APIServer
    KubeRBACProxy -->|"identity enforcement"| MCPServer

    APIServer -->|"Jobs, ConfigMaps,<br/>Secrets, Pods"| K8sAPI["Kubernetes API<br/>6443/HTTPS"]
    APIServer -->|"query/store data"| PostgreSQL["PostgreSQL<br/>pgx/v5"]
    APIServer -->|"embedded storage"| SQLite["SQLite"]
    APIServer -->|"results export"| MLflow["MLflow"]
    APIServer -->|"HardwareProfile CR"| HardwareProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io"]

    MCPServer -->|"delegates to"| APIServer

    InitContainer -->|"download test data"| S3["S3-Compatible Storage"]

    APIServer -->|"OTLP traces/metrics/logs"| OTelCollector["OpenTelemetry Collector<br/>gRPC / HTTP"]

    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style MCPServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style KubeRBACProxy fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style HardwareProfile fill:#f5a623,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
