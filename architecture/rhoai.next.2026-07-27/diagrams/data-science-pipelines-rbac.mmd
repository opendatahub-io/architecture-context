graph TD
    subgraph "Service Accounts"
        SA_pipeline["ml-pipeline"]
        SA_persist["ml-pipeline-persistenceagent"]
        SA_sched["ml-pipeline-scheduledworkflow"]
        SA_ui["ml-pipeline-ui"]
        SA_viewer["ml-pipeline-viewer-crd-service-account"]
        SA_runner["pipeline-runner"]
        SA_writer["kubeflow-pipelines-metadata-writer"]
        SA_cache["kubeflow-pipelines-cache"]
        SA_deployer["kubeflow-pipelines-cache-deployer-sa"]
        SA_public["system:authenticated (Group)"]
    end

    subgraph "Role Bindings (kubeflow namespace)"
        RB_pipeline["ml-pipeline"]
        RB_persist["ml-pipeline-persistenceagent-binding"]
        RB_sched["ml-pipeline-scheduledworkflow-binding"]
        RB_ui["ml-pipeline-ui"]
        RB_viewer["ml-pipeline-viewer-crd-binding"]
        RB_runner["pipeline-runner-binding"]
        RB_writer["kubeflow-pipelines-metadata-writer-binding"]
        RB_cache["kubeflow-pipelines-cache-binding"]
        RB_deployer["kubeflow-pipelines-cache-deployer-rolebinding"]
        RB_public["kubeflow-pipelines-public"]
    end

    subgraph "Cluster Roles"
        CR_pipeline["ml-pipeline"]
        CR_persist["ml-pipeline-persistenceagent-role"]
        CR_sched["ml-pipeline-scheduledworkflow-role"]
        CR_ui["ml-pipeline-ui"]
        CR_viewer["ml-pipeline-viewer-controller-role"]
        CR_runner["pipeline-runner"]
        CR_writer["kubeflow-pipelines-metadata-writer-role"]
        CR_cache["kubeflow-pipelines-cache-role"]
        CR_deployer["kubeflow-pipelines-cache-deployer-role"]
        CR_public["kubeflow-pipelines-public"]
    end

    subgraph "API Resources"
        direction LR

        subgraph "Core API"
            Pods["core/pods<br/>pods/log, pods/exec"]
            Services["core/services"]
            ConfigMaps["core/configmaps"]
            Secrets["core/secrets"]
            PVCs["core/PVCs, PVs"]
            Events["core/events"]
        end

        subgraph "Argo"
            Workflows["argoproj.io/workflows"]
            TaskResults["argoproj.io/workflowtaskresults"]
        end

        subgraph "Kubeflow"
            ScheduledWF["kubeflow.org/scheduledworkflows"]
            Viewers["kubeflow.org/viewers"]
            KFAll["kubeflow.org/* (all)"]
        end

        subgraph "Pipelines"
            Pipelines["pipelines.kubeflow.org/pipelines"]
            PipelineVersions["pipelines.kubeflow.org/pipelineversions"]
            Runs["pipelines.kubeflow.org/runs"]
        end

        subgraph "Auth"
            TokenReviews["authentication.k8s.io/tokenreviews"]
            SAR["authorization.k8s.io/subjectaccessreviews"]
        end

        subgraph "Other"
            Deployments["apps/deployments"]
            ReplicaSets["apps/replicasets"]
            Jobs["batch/jobs"]
            Seldon["machinelearning.seldon.io/seldondeployments"]
            Experiments["mlflow.kubeflow.org/experiments"]
            VolumeSnaps["snapshot.storage.k8s.io/volumesnapshots"]
        end
    end

    %% SA → RB → CR connections
    SA_pipeline -->|bound via| RB_pipeline
    SA_persist -->|bound via| RB_persist
    SA_sched -->|bound via| RB_sched
    SA_ui -->|bound via| RB_ui
    SA_viewer -->|bound via| RB_viewer
    SA_runner -->|bound via| RB_runner
    SA_writer -->|bound via| RB_writer
    SA_cache -->|bound via| RB_cache
    SA_deployer -->|bound via| RB_deployer
    SA_public -->|bound via| RB_public

    RB_pipeline -->|grants| CR_pipeline
    RB_persist -->|grants| CR_persist
    RB_sched -->|grants| CR_sched
    RB_ui -->|grants| CR_ui
    RB_viewer -->|grants| CR_viewer
    RB_runner -->|grants| CR_runner
    RB_writer -->|grants| CR_writer
    RB_cache -->|grants| CR_cache
    RB_deployer -->|grants| CR_deployer
    RB_public -->|grants| CR_public

    %% CR → Resources (key permissions)
    CR_pipeline -->|"CRUD + watch"| Workflows
    CR_pipeline -->|"CRUD"| ScheduledWF
    CR_pipeline -->|"CRUD + watch"| Pipelines
    CR_pipeline -->|"CRUD + watch"| PipelineVersions
    CR_pipeline -->|"create"| TokenReviews
    CR_pipeline -->|"create"| SAR
    CR_pipeline -->|"delete,get,list"| Pods
    CR_pipeline -->|"get"| ConfigMaps
    CR_pipeline -->|"CRUD"| Experiments

    CR_persist -->|"get,list,watch"| Workflows
    CR_persist -->|"get,list,watch"| ScheduledWF
    CR_persist -->|"readArtifact,reportMetrics"| Runs

    CR_sched -->|"CRUD + watch"| Workflows
    CR_sched -->|"CRUD + watch"| ScheduledWF
    CR_sched -->|"create"| Runs
    CR_sched -->|"create,patch"| Events

    CR_ui -->|"get"| Pods
    CR_ui -->|"list"| Events
    CR_ui -->|"get,list"| ConfigMaps
    CR_ui -->|"get,list"| Secrets
    CR_ui -->|"CRUD + watch"| Viewers
    CR_ui -->|"get,list"| Workflows

    CR_viewer -->|"CRUD + watch"| Deployments
    CR_viewer -->|"CRUD + watch"| Services
    CR_viewer -->|"CRUD + watch"| Viewers

    CR_runner -->|"* (all verbs)"| Pods
    CR_runner -->|"* (all verbs)"| Services
    CR_runner -->|"* (all verbs)"| PVCs
    CR_runner -->|"CRUD + watch"| Workflows
    CR_runner -->|"create,patch"| TaskResults
    CR_runner -->|"* (all verbs)"| Deployments
    CR_runner -->|"* (all verbs)"| Jobs
    CR_runner -->|"* (all verbs)"| Seldon
    CR_runner -->|"* (all verbs)"| KFAll
    CR_runner -->|"get"| Secrets
    CR_runner -->|"get,list,watch"| ConfigMaps
    CR_runner -->|"create,delete,get"| VolumeSnaps
    CR_runner -->|"CRUD"| Experiments

    CR_writer -->|"get,list,patch,update,watch"| Pods
    CR_writer -->|"get"| ConfigMaps
    CR_writer -->|"get,list,patch,update,watch"| Workflows

    CR_cache -->|"get,list,patch,update,watch"| Pods
    CR_cache -->|"get"| ConfigMaps
    CR_cache -->|"get,list,patch,update,watch"| Workflows

    CR_deployer -->|"create,delete,get,list,patch"| Secrets

    CR_public -->|"get,list,watch"| ConfigMaps

