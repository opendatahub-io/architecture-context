graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["maas-default-gateway<br/>Namespace: openshift-ingress<br/>HTTPRoute: maas-api-route<br/>443/TCP → 8443/TCP"]
        AuthPolicy["Kuadrant AuthPolicy<br/>API Key + TokenReview<br/>+ OIDC JWT (optional)"]
        Gateway --> AuthPolicy
    end

    subgraph Application["APPLICATION (Restricted Pod Security)"]
        direction TB

        subgraph NS_ODH["Namespace: opendatahub"]
            MaaSAPI["maas-api Deployment<br/>SA: maas-api<br/>UID: 1001 (non-root)<br/>readOnlyRootFilesystem<br/>FIPS-compliant<br/>Ports: 8080, 8443, 9090"]

            ManagerDeploy["manager Deployment<br/>7 Controllers<br/>Admission Webhooks (HTTPS/TLS)<br/>failurePolicy: fail<br/>Port: 8081 (probes)"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]

        GatewayResources["Gateway API Resources<br/>HTTPRoute / Gateway"]
        KuadrantResources["Kuadrant Resources<br/>AuthPolicy / TokenRateLimitPolicy"]
        KServeResources["KServe LLMInferenceService<br/>(conditional watch)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        PostgreSQL["PostgreSQL Database<br/>Auth: maas-db-config secret<br/>(resourceNames restricted)"]
        OTEL["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Runtime-configured"]
        OSAuth["OpenShift Authentication<br/>config.openshift.io/v1"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>API Key + TokenReview + JWT"| Gateway

    %% Ingress → Application
    AuthPolicy -->|"HTTPS/8443<br/>TLS<br/>Policy-enforced"| MaaSAPI

    %% Application → Cluster Services
    MaaSAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview + SAR"| K8sAPI
    ManagerDeploy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ManagerDeploy -->|"CRUD"| GatewayResources
    ManagerDeploy -->|"CRUD"| KuadrantResources
    ManagerDeploy -.->|"Watch (conditional)"| KServeResources

    %% Application → External Services
    MaaSAPI -->|"DB connection<br/>maas-db-config credentials"| PostgreSQL
    MaaSAPI -->|"OTLP/gRPC<br/>traces"| OTEL
    MaaSAPI -->|"REST/read"| OSAuth

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway,AuthPolicy ingress
    class MaaSAPI,ManagerDeploy application
    class K8sAPI,GatewayResources,KuadrantResources,KServeResources clusterservice
    class PostgreSQL,OTEL,OSAuth externalservice
