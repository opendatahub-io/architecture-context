graph TD
    subgraph Note["Training Hub RBAC"]
        direction TB
        Info["training_hub is a Python library,<br/>not a deployed Kubernetes service.<br/><br/>No ClusterRoles, Roles, RoleBindings,<br/>or ServiceAccounts are defined.<br/><br/>RBAC depends entirely on the hosting<br/>environment (notebook server, training<br/>job pod, etc.)."]
    end

    subgraph Credentials["Runtime Credentials (Environment Variables)"]
        direction TB
        OPENAI["OPENAI_API_KEY<br/>LLM API authentication<br/>User-provisioned"]
        OPENAI_BASE["OPENAI_API_BASE<br/>LLM API base URL override<br/>User-provisioned"]
        MLFLOW["MLFLOW_TRACKING_URI<br/>MLflow server endpoint<br/>User-provisioned"]
        WANDB_KEY["WANDB_API_KEY<br/>W&B API authentication<br/>User-provisioned"]
        WANDB_ENT["WANDB_ENTITY<br/>W&B organization/entity<br/>User-provisioned"]
    end

    subgraph EnvSafety["Environment Variable Safety"]
        direction TB
        GEPA_Save["GEPA Backend<br/>Save/Restore Semantics<br/>Saves current env vars before<br/>training, restores on exit"]
        Verl_Inherit["verl Backend<br/>Subprocess Inheritance<br/>Child processes inherit<br/>parent environment"]
    end

    Credentials --> EnvSafety

    %% Styling
    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style Info fill:#fff2cc,stroke:#d6b656
    style Credentials fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style EnvSafety fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style OPENAI fill:#f8cecc,stroke:#b85450
    style OPENAI_BASE fill:#f8cecc,stroke:#b85450
    style MLFLOW fill:#f8cecc,stroke:#b85450
    style WANDB_KEY fill:#f8cecc,stroke:#b85450
    style WANDB_ENT fill:#f8cecc,stroke:#b85450
    style GEPA_Save fill:#d5e8d4,stroke:#82b366
    style Verl_Inherit fill:#d5e8d4,stroke:#82b366
