graph TB
    subgraph UserZone["USER WORKSTATION (Trusted)"]
        User["User / SRE<br/>oc adm must-gather"]
    end

    subgraph ControlPlane["OPENSHIFT CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph EphemeralPod["EPHEMERAL POD (No Inbound Surface)"]
        direction TB
        MustGather["must-gather Container<br/>SA: auto-provisioned<br/>Lifecycle: ephemeral<br/>No listening ports"]

        subgraph Collectors["Parallel Collectors"]
            direction LR
            C1["gather_serving.sh"]
            C2["gather_dsp.sh"]
            C3["gather_dashboard.sh"]
            C4["gather_mr.sh"]
            C5["gather_aigateway.sh"]
            C6["14+ total collectors"]
        end

        MustGather --> C1
        MustGather --> C2
        MustGather --> C3
        MustGather --> C4
        MustGather --> C5
        MustGather --> C6
    end

    subgraph LocalFS["POD-LOCAL FILESYSTEM"]
        Output["must-gather/<br/>Output Directory<br/>Logs, CRs, YAML"]
    end

    %% Flows
    User -->|"oc adm must-gather<br/>HTTPS/6443<br/>TLS 1.2+<br/>User kubeconfig"| K8sAPI
    K8sAPI -->|"Creates ephemeral pod<br/>Mounts SA token"| MustGather
    MustGather -->|"oc adm inspect / oc get<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA Token (Bearer)"| K8sAPI
    C1 -->|"HTTPS/6443<br/>SA Token"| K8sAPI
    C2 -->|"HTTPS/6443<br/>SA Token"| K8sAPI
    MustGather -->|"Write collected data"| Output
    Output -->|"oc rsync to<br/>user workstation"| User

    %% Styling
    classDef userzone fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef ephemeral fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef localfs fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef collector fill:#dae8fc,stroke:#6c8ebf

    class User userzone
    class K8sAPI controlplane
    class MustGather ephemeral
    class C1,C2,C3,C4,C5,C6 collector
    class Output localfs
