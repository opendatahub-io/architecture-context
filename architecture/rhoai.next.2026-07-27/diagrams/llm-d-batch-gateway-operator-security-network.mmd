graph TB
    subgraph OperatorPod["OPERATOR POD (redhat-ods-applications)"]
        direction TB
        Operator["llm-d-batch-gateway-operator<br/>SA: llm-d-batch-gateway-operator<br/>:8081 healthz/readyz (HTTP, no auth)"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP<br/>HTTPS/WSS, TLS 1.2+<br/>ServiceAccount RBAC"]
    end

    subgraph WatchedResources["WATCHED RESOURCES (via K8s API)"]
        direction TB
        LLMBatchGatewayCR["LLMBatchGateway CR<br/>batch.llm-d.ai/v1alpha1<br/>(primary watch)"]
        OwnedResources["Owned Resources<br/>Deployments, Services,<br/>ConfigMaps, ServiceAccounts"]
        WatchedSecrets["Secrets<br/>(credential sync watch)"]
        RefGrants["ReferenceGrants<br/>(conditional watch)"]
        MonitoringCRs["ServiceMonitors,<br/>PrometheusRules<br/>(conditional watch)"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (created by operator)"]
        direction TB
        ManagedDeploys["Deployments (up to 4)<br/>API Server, Processor,<br/>GC, Async Processor"]
        ManagedHTTPRoutes["HTTPRoutes<br/>gateway.networking.k8s.io"]
        ManagedCerts["Certificates<br/>cert-manager.io"]
        ManagedMonitoring["ServiceMonitors,<br/>PodMonitors,<br/>PrometheusRules"]
        ManagedSecrets["Secrets<br/>(cross-ns credential copy)"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>Certificate lifecycle<br/>TLS 1.2+"]
        GatewayAPI["Gateway API<br/>HTTPRoute routing<br/>TLS 1.2+"]
        PromOp["prometheus-operator<br/>Metrics scraping<br/>TLS 1.2+"]
    end

    subgraph ManagedWorkloads["MANAGED WORKLOADS (per CR)"]
        direction TB
        APIServer["API Server<br/>Batch job HTTP API"]
        Processor["Request Processor<br/>Inference dispatch"]
        GCWorker["Garbage Collector<br/>Job/file cleanup"]
        AsyncProc["Async Processor<br/>(optional)<br/>Redis queue dispatch"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (configured via CR spec)"]
        Database["PostgreSQL / Redis / Valkey<br/>Database backend"]
        Storage["S3 / PVC<br/>File storage"]
        InferenceGW["Inference Gateway<br/>Model inference"]
    end

    %% Operator to K8s API
    Operator -->|HTTPS/WSS 6443<br/>TLS 1.2+<br/>SA token RBAC| K8sAPI

    %% K8s API to watched resources
    K8sAPI -.->|watch events| LLMBatchGatewayCR
    K8sAPI -.->|watch events| OwnedResources
    K8sAPI -.->|watch events| WatchedSecrets
    K8sAPI -.->|conditional watch| RefGrants
    K8sAPI -.->|conditional watch| MonitoringCRs

    %% Operator creates managed resources
    Operator -->|create/update<br/>via K8s API| ManagedDeploys
    Operator -->|create/update| ManagedHTTPRoutes
    Operator -->|create/update| ManagedCerts
    Operator -->|create/update| ManagedMonitoring
    Operator -->|cross-ns sync<br/>ReferenceGrant authz| ManagedSecrets

    %% Platform dependency interactions
    ManagedCerts -.->|processed by| CertManager
    ManagedHTTPRoutes -.->|processed by| GatewayAPI
    ManagedMonitoring -.->|processed by| PromOp

    %% Managed workloads from deployments
    ManagedDeploys -->|runs| APIServer
    ManagedDeploys -->|runs| Processor
    ManagedDeploys -->|runs| GCWorker
    ManagedDeploys -->|runs| AsyncProc

    %% Managed workloads to external services
    APIServer -->|credentials from<br/>spec.secretRef| Database
    Processor -->|sync: HTTP<br/>async: Redis queue| InferenceGW
    GCWorker -->|cleanup| Storage
    AsyncProc -->|Redis sorted-set<br/>queue dispatch| InferenceGW

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef k8s fill:#326ce5,stroke:#333,stroke-width:2px,color:#fff
    classDef watched fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workload fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Operator operator
    class K8sAPI k8s
    class LLMBatchGatewayCR,OwnedResources,WatchedSecrets,RefGrants,MonitoringCRs watched
    class ManagedDeploys,ManagedHTTPRoutes,ManagedCerts,ManagedMonitoring,ManagedSecrets managed
    class CertManager,GatewayAPI,PromOp platform
    class APIServer,Processor,GCWorker,AsyncProc workload
    class Database,Storage,InferenceGW external
