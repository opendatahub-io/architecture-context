graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["KServe / ModelMesh Client"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph Service["inference-server Service<br/>ClusterIP: None (headless)<br/>8033/TCP"]
            direction TB

            subgraph Pod["TGIS Pod"]
                direction TB

                subgraph RouterProc["text-generation-router (Rust)"]
                    gRPC["gRPC Server<br/>8033/TCP<br/>rustls 0.22.4<br/>Optional TLS/mTLS"]
                    HTTP["HTTP Server<br/>3000/TCP<br/>/health, /metrics<br/>No Auth"]
                end

                subgraph ShardsProc["text-generation-server (Python)"]
                    Shard0["Shard 0<br/>UDS: /tmp/text-generation-0<br/>No encryption"]
                    ShardN["Shard N<br/>UDS: /tmp/text-generation-N<br/>No encryption"]
                end

                subgraph GPUs["NVIDIA GPU(s) — CUDA 12.1"]
                    GPU0["GPU 0"]
                    GPUN["GPU N"]
                end

                gRPC -->|gRPC over UDS<br/>No encryption<br/>No auth| Shard0
                Shard0 -->|NCCL AllReduce<br/>GPU Direct<br/>No encryption| ShardN
                Shard0 --> GPU0
                ShardN --> GPUN
            end
        end

        Kubelet["Kubernetes Kubelet"]
        Prom["Prometheus"]
        ModelPVC[("Model Storage PVC<br/>/shared_model_storage<br/>Read-Only")]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>TLS 1.2+<br/>HF Token"]
        OTel["OpenTelemetry Collector<br/>gRPC OTLP<br/>None/TLS"]
    end

    %% External flows
    Client -->|"gRPC/8033<br/>Optional TLS/mTLS<br/>rustls (FIPS risk)"| gRPC

    %% Internal flows
    Kubelet -->|"HTTP/3000<br/>Optional TLS<br/>No auth"| HTTP
    Prom -->|"HTTP/3000<br/>/metrics scrape<br/>No auth"| HTTP
    ModelPVC -->|"Volume mount<br/>Filesystem<br/>Read-only"| Shard0
    ModelPVC -->|"Volume mount<br/>Filesystem<br/>Read-only"| ShardN

    %% Egress flows
    Shard0 -.->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token<br/>Pre-deploy only"| HFHub
    gRPC -.->|"gRPC OTLP<br/>Optional"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:3px,stroke-dasharray: 5

    class Client external
    class Kubelet,Prom cluster
    class gRPC,HTTP,Shard0,ShardN,GPU0,GPUN pod
    class HFHub,OTel externalservice
    class ModelPVC storage
