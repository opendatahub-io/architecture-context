graph TB
    subgraph OGXOperator["ogx-k8s-operator"]
        direction TB
        subgraph Manager["ogx-k8s-operator-controller-manager<br/>(Deployment)"]
            OGXCtrl["OGX Controller<br/>(Reconciler)"]
            OGXServerCtrl["OGXServer Controller<br/>(Reconciler)"]
            Webhook["OGXServerValidator<br/>(Validating Webhook)"]
        end
        ConfigGen["configgen<br/>(CLI Tool)"]
    end

    %% CRDs
    OGXCR["OGX CR<br/>components.platform.opendatahub.io/v1alpha1"]
    OGXServerCR["OGXServer CR<br/>ogx.io/v1beta1"]
    LlamaStackCR["LlamaStackDistribution CR<br/>llamastack.io/v1alpha1"]

    %% Kubernetes Resources Created/Managed
    subgraph ManagedResources["Managed Kubernetes Resources"]
        Deployment["Deployments"]
        Services["Services"]
        ConfigMaps["ConfigMaps"]
        PVCs["PVCs"]
        HPA["HorizontalPodAutoscalers"]
        NetPol["NetworkPolicies"]
        Ingress["Ingresses"]
        PDB["PodDisruptionBudgets"]
        RBAC["Roles/RoleBindings"]
    end

    %% Monitoring
    ServiceMonitor["ServiceMonitor<br/>monitoring.coreos.com"]
    PrometheusRule["PrometheusRule<br/>monitoring.coreos.com"]

    %% Flows
    OGXCR -->|watched by| OGXCtrl
    OGXServerCR -->|watched by| OGXServerCtrl
    OGXServerCR -->|validated by| Webhook

    OGXCtrl -->|creates/manages| Deployment
    OGXCtrl -->|creates/manages| Services
    OGXCtrl -->|creates/manages| PDB

    OGXServerCtrl -->|creates/manages| Deployment
    OGXServerCtrl -->|creates/manages| Services
    OGXServerCtrl -->|creates/manages| ConfigMaps
    OGXServerCtrl -->|creates/manages| PVCs
    OGXServerCtrl -->|creates/manages| HPA
    OGXServerCtrl -->|creates/manages| NetPol
    OGXServerCtrl -->|creates/manages| Ingress
    OGXServerCtrl -->|creates/manages| PDB

    OGXCtrl -->|creates| ServiceMonitor
    OGXCtrl -->|creates| PrometheusRule

    ConfigGen -->|reads| OGXServerCR

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OGXServerCtrl -->|watches/CRUD| K8sAPI
    OGXCtrl -->|watches/CRUD| K8sAPI

    %% Styling
    style OGXCtrl fill:#4a90e2,color:#fff
    style OGXServerCtrl fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style ConfigGen fill:#50c878,color:#fff
    style OGXCR fill:#f5a623,color:#fff
    style OGXServerCR fill:#f5a623,color:#fff
    style LlamaStackCR fill:#f5a623,color:#fff
    style ServiceMonitor fill:#7ed321,color:#fff
    style PrometheusRule fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8,color:#333
