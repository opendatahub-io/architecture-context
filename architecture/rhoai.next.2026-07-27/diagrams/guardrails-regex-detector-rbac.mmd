graph TD
    subgraph "RBAC Status"
        Note["No RBAC Defined"]
    end

    subgraph "Application Security Model"
        direction TB
        NoClusterRoles["No ClusterRoles"]
        NoRoleBindings["No RoleBindings"]
        NoServiceAccount["No ServiceAccount<br/>requirements in source"]
        NoSecrets["No Secrets<br/>referenced"]
    end

    subgraph "Security Enforcement"
        direction TB
        InfraAuth["Infrastructure-Level Auth<br/>(Service Mesh / Sidecar)"]
        HeaderPassthrough["Header Passthrough<br/>Auth headers forwarded<br/>but NOT validated"]
        NoAppAuth["No Application-Level Auth<br/>All requests accepted"]
    end

    subgraph "Endpoints"
        ContentEndpoint["POST /api/v1/text/contents<br/>Auth: None (headers passed through)"]
        HealthEndpoint["GET /health<br/>Auth: None"]
    end

    Note --> NoClusterRoles
    Note --> NoRoleBindings
    Note --> NoServiceAccount
    Note --> NoSecrets

    InfraAuth -->|"expected to provide"| HeaderPassthrough
    HeaderPassthrough -->|"headers forwarded to"| ContentEndpoint
    NoAppAuth --> HealthEndpoint

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style NoClusterRoles fill:#f5f5f5,stroke:#ccc
    style NoRoleBindings fill:#f5f5f5,stroke:#ccc
    style NoServiceAccount fill:#f5f5f5,stroke:#ccc
    style NoSecrets fill:#f5f5f5,stroke:#ccc
    style InfraAuth fill:#ffe6cc,stroke:#d79b00
    style HeaderPassthrough fill:#ffe6cc,stroke:#d79b00
    style NoAppAuth fill:#f8cecc,stroke:#b85450
    style ContentEndpoint fill:#dae8fc,stroke:#6c8ebf
    style HealthEndpoint fill:#dae8fc,stroke:#6c8ebf
