graph TB
    subgraph "ai-gateway-payload-processing"
        direction TB

        subgraph Controllers["Controllers"]
            ExternalModelCtrl["ExternalModel Controller<br/><i>Reconciles ExternalModel CRs</i>"]
            ExternalProviderCtrl["ExternalProvider Controller<br/><i>Reconciles ExternalProvider CRs</i>"]
            LegacyMigrationCtrl["Legacy Migration Controller<br/><i>Migrates maas.opendatahub.io → inference.opendatahub.io</i>"]
        end

        subgraph ExtProc["Envoy ext_proc Service"]
            PluginRegistry["Plugin Registry<br/><i>plugins.RegisterPlugins()</i>"]
            PayloadProcessor["Payload Processor<br/><i>API format translation</i>"]
            CredentialInjector["Credential Injector<br/><i>Per-provider auth injection</i>"]
            PluginRegistry --> PayloadProcessor
            PluginRegistry --> CredentialInjector
        end

        subgraph BBR["llm-d BBR Runner Framework"]
            Runner["BBR Runner<br/><i>Body-Based Router</i>"]
        end

        Runner -->|hosts| PluginRegistry
    end

    %% CRDs
    ExternalModelCR["ExternalModel CR<br/><i>inference.opendatahub.io/v1alpha1</i>"]
    ExternalProviderCR["ExternalProvider CR<br/><i>inference.opendatahub.io/v1alpha1</i>"]
    LegacyModelCR["ExternalModel CR<br/><i>maas.opendatahub.io (legacy)</i>"]

    ExternalModelCR -->|watched by| ExternalModelCtrl
    ExternalProviderCR -->|watched by| ExternalProviderCtrl
    LegacyModelCR -.->|watched by| LegacyMigrationCtrl
    LegacyMigrationCtrl -.->|creates| ExternalModelCR

    %% Created Resources
    ExternalModelCtrl -->|creates| HTTPRoute["HTTPRoute<br/><i>gateway.networking.k8s.io/v1</i>"]
    ExternalProviderCtrl -->|creates| Service["Service<br/><i>v1</i>"]
    ExternalProviderCtrl -->|creates| ServiceEntry["ServiceEntry<br/><i>networking.istio.io</i>"]
    ExternalProviderCtrl -->|creates| DestinationRule["DestinationRule<br/><i>networking.istio.io</i>"]

    %% Dependencies
    HTTPRoute -->|routes to| Gateway["Gateway<br/><i>GATEWAY_NAME/GATEWAY_NAMESPACE</i>"]
    ExternalProviderCtrl -->|reads| Secrets["Secrets<br/><i>Provider credentials</i>"]

    %% External Providers
    PayloadProcessor -->|translates & routes| ExtProviders["External LLM Providers<br/><i>OpenAI, Anthropic, Azure, Vertex</i>"]

    %% Styling
    style ExternalModelCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ExternalProviderCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LegacyMigrationCtrl fill:#4a90e2,stroke:#333,color:#fff
    style PluginRegistry fill:#9b59b6,stroke:#333,color:#fff
    style PayloadProcessor fill:#9b59b6,stroke:#333,color:#fff
    style CredentialInjector fill:#9b59b6,stroke:#333,color:#fff
    style Runner fill:#8e44ad,stroke:#333,color:#fff
    style ExternalModelCR fill:#f5a623,stroke:#333
    style ExternalProviderCR fill:#f5a623,stroke:#333
    style LegacyModelCR fill:#f5a623,stroke:#333,stroke-dasharray: 5 5
    style HTTPRoute fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
    style ServiceEntry fill:#7ed321,stroke:#333
    style DestinationRule fill:#7ed321,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style Secrets fill:#e74c3c,stroke:#333,color:#fff
    style ExtProviders fill:#e8e8e8,stroke:#333
