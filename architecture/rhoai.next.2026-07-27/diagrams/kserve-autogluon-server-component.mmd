graph TB
    subgraph KServe["kserve-autogluon-server"]
        direction TB

        subgraph CmdManager["cmd/manager - Core Controllers"]
            ISController[InferenceService Controller]
            IGController[InferenceGraph Controller]
            TMController[TrainedModel Controller]
            WebhookServer[Webhook Server<br/>443/TCP TLS]
        end

        subgraph CmdLLMISVC["cmd/llmisvc - LLM Controller"]
            LLMController[LLMInferenceService Controller]
            ConversionWebhook[Conversion Webhook<br/>/convert]
            LLMMetrics[Metrics Endpoint<br/>authn/authz filters]
        end

        subgraph CmdLocalModel["cmd/localmodel - Local Model Caching"]
            LMCacheCtrl[LocalModelCache Controller]
            LMNSCacheCtrl[LocalModelNamespaceCache Controller]
            LMNodeCtrl[LocalModelNode Controller]
        end

        subgraph CmdRouter["cmd/router - InferenceGraph Routing"]
            Router[Router Engine<br/>Splitter / Switch / Ensemble / Sequence]
        end

        subgraph CmdAgent["cmd/agent - Sidecar Proxy"]
            Agent[Agent Sidecar<br/>Model pulling / Logging / Batching]
        end
    end

    subgraph Deployment["kserve-controller-manager Deployment"]
        Manager[manager container<br/>kserve/kserve-controller:latest]
        KubeRBACProxy[kube-rbac-proxy sidecar<br/>quay.io/brancz/kube-rbac-proxy:v0.18.0<br/>8443→8080 TLS termination]
        Manager --- KubeRBACProxy
    end

    %% CRDs watched
    ISVC_CR[InferenceService CR<br/>v1beta1]
    LLMISVC_CR[LLMInferenceService CR<br/>v1alpha1, v1alpha2]
    IG_CR[InferenceGraph CR<br/>v1alpha1]
    TM_CR[TrainedModel CR<br/>v1alpha1]
    LMC_CR[LocalModelCache CR<br/>v1alpha1]
    LMNSC_CR[LocalModelNamespaceCache CR<br/>v1alpha1]
    LMN_CR[LocalModelNode CR<br/>v1alpha1]
    SR_CR[ServingRuntime CR<br/>v1alpha1]
    CSR_CR[ClusterServingRuntime CR<br/>v1alpha1]
    CSC_CR[ClusterStorageContainer CR<br/>v1alpha1]
    LMNG_CR[LocalModelNodeGroup CR<br/>v1alpha1]
    LLMISVC_CFG_CR[LLMInferenceServiceConfig CR<br/>v1alpha1, v1alpha2]

    %% Controller → CRD relationships
    ISVC_CR -->|watched by| ISController
    IG_CR -->|watched by| IGController
    TM_CR -->|watched by| TMController
    LLMISVC_CR -->|watched by| LLMController
    LLMISVC_CFG_CR -->|watched by| LLMController
    LMC_CR -->|watched by| LMCacheCtrl
    LMNSC_CR -->|watched by| LMNSCacheCtrl
    LMN_CR -->|watched by| LMNodeCtrl
    SR_CR -->|watched by| ISController
    CSR_CR -->|watched by| ISController

    %% Admission webhooks
    ISVC_CR -.->|validates/mutates| WebhookServer
    TM_CR -.->|validates| WebhookServer
    IG_CR -.->|validates| WebhookServer
    SR_CR -.->|validates| WebhookServer
    CSR_CR -.->|validates| WebhookServer
    LLMISVC_CR -.->|validates/mutates| ConversionWebhook
    LMC_CR -.->|validates| WebhookServer

    %% External dependencies
    K8sAPI[Kubernetes API<br/>6443/TCP HTTPS]
    GatewayAPI[Gateway API<br/>HTTPRoute/Gateway]
    Prometheus[Prometheus<br/>8443/TCP scrape]
    Istio[Istio<br/>VirtualService]
    Knative[Knative Serving<br/>v1 Service]
    KEDA[KEDA<br/>ScaledObject]
    OTel[OpenTelemetry<br/>Collector]

    ISController -->|CRUD| K8sAPI
    LLMController -->|CRUD| K8sAPI
    LMCacheCtrl -->|PV/PVC mgmt| K8sAPI
    ISController -->|creates| Knative
    ISController -->|creates| Istio
    ISController -->|creates| KEDA
    ISController -->|creates| OTel
    LLMController -->|creates| GatewayAPI
    KubeRBACProxy -->|scrape target| Prometheus

