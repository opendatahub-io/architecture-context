graph TB
    subgraph "ODH Dashboard Platform"
        direction TB

        subgraph Operator["Dashboard Operator (Go)"]
            DashboardController["Dashboard Controller<br/>Reconciles Dashboard CR"]
            WorkspaceController["Workspace Controller<br/>Reconciles Workspace CR"]
            WorkspaceKindController["WorkspaceKind Controller<br/>Reconciles WorkspaceKind CR"]
            WebhookServer["Webhook Server<br/>Validating + Conversion"]
        end

        subgraph Backend["Node.js Backend (Fastify 4.29)"]
            StaticAssets["Static Asset Server<br/>React SPA"]
            APIProxy["API Proxy Layer<br/>/api/* routes"]
            WSProxy["WebSocket Proxy<br/>/wss/k8s/*"]
            ServiceProxy["Service Proxy<br/>CRD-based discovery"]
        end

        subgraph BFFLayer["Go BFF Sidecars"]
            CoreBFF["core-bff<br/>:8043"]
            GenAI["gen-ai BFF<br/>:8143"]
            MaaS["maas BFF<br/>:8243"]
            MLflow["mlflow BFF<br/>:8343"]
            EvalHub["eval-hub BFF<br/>:8543"]
            AutoML["automl BFF<br/>:8643"]
            AutoRAG["autorag BFF<br/>:8743"]
            AgentOps["agent-ops BFF<br/>:8843"]
        end

        subgraph Frontend["Frontend (React/TypeScript)"]
            HostApp["Host App<br/>Module Federation Host"]
            ModFed["Module Federation<br/>/_mf/:name/*"]
        end

        KubeRBACProxy["kube-rbac-proxy<br/>:8443 TLS termination"]
    end

    %% User interactions
    User[Data Scientist / Admin] -->|HTTPS :8443| KubeRBACProxy
    KubeRBACProxy -->|HTTP :8080| Backend
    KubeRBACProxy -->|serves| Frontend

    %% Frontend → Backend
    HostApp -->|API calls| APIProxy
    HostApp -->|WebSocket| WSProxy
    HostApp -->|remote entries| ModFed

    %% Backend → downstream proxies
    ServiceProxy -->|proxy| DSPipelines[DataScience Pipelines]
    ServiceProxy -->|proxy| MLMD[ML Metadata]
    ServiceProxy -->|proxy| ModelServing[Model Serving / KServe]
    ServiceProxy -->|proxy| ModelRegistryAPI[Model Registry API]
    ServiceProxy -->|proxy| TrustyAISvc[TrustyAI Service]

    %% BFF → external services
    GenAI -->|REST| LlamaStack[Llama Stack Server]
    GenAI -->|REST| NeMoGuardrails[NeMo Guardrails]
    MaaS -->|REST| MaaSAPI[MaaS API Server]
    MLflow -->|REST| MLflowTracker[MLflow Tracking Server]

    %% Operator → CRDs
    DashboardController -->|watches| DashboardCR[Dashboard CR]
    WorkspaceController -->|watches| WorkspaceCR[Workspace CR]
    WorkspaceKindController -->|watches| WorkspaceKindCR[WorkspaceKind CR]

    %% Operator → K8s
    DashboardController -->|manages| K8sResources[Deployments, Services,<br/>ConfigMaps, Routes]

    %% External dependencies
    DashboardController -->|depends on| K8sAPI[Kubernetes API :6443]
    Backend -->|5 API clients| K8sAPI

