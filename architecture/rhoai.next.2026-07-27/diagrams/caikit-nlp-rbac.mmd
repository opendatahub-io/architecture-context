graph TD
    subgraph "caikit-nlp RBAC Model"
        direction TB

        Note["caikit-nlp is a Python library, not a Kubernetes operator.<br/>No Kubernetes RBAC roles are defined directly.<br/>Security is delegated to platform infrastructure."]
    end

    subgraph "Platform-Delegated Security"
        direction TB

        subgraph "Transport Security"
            TLS["TLS/mTLS Configuration<br/>(Environment Variables)"]
        end

        subgraph "Caikit Runtime"
            RuntimeAuth["Runtime Authentication<br/>(Transport-level)"]
        end

        subgraph "Platform Infrastructure"
            ServiceMesh["Service Mesh (Istio)<br/>mTLS Enforcement"]
            NetworkPolicy["Network Policies<br/>(Namespace-scoped)"]
            PodSecurity["Pod Security Standards<br/>(Platform-enforced)"]
        end
    end

    subgraph "Credential References"
        direction TB
        TLSCerts["TLS Certificates<br/>Type: File paths via env vars<br/>Purpose: gRPC server + TGIS client TLS<br/>Provisioned By: Platform/cert-manager"]
        HFToken["HuggingFace API Token<br/>Type: Environment variable<br/>Purpose: Private model access<br/>Provisioned By: User/Secret mount"]
        TGISCreds["TGIS Connection Credentials<br/>Type: Environment variables<br/>Purpose: mTLS to TGIS backend<br/>Provisioned By: Platform/Secret mount"]
    end

    TLS -->|configures| RuntimeAuth
    RuntimeAuth -->|enforced by| ServiceMesh
    TLSCerts -->|used by| TLS
    HFToken -->|used by| Note
    TGISCreds -->|used by| TLS

    style Note fill:#e8e8e8,stroke:#333
    style TLS fill:#ffe6cc,stroke:#d79b00
    style RuntimeAuth fill:#ffe6cc,stroke:#d79b00
    style ServiceMesh fill:#d5e8d4,stroke:#82b366
    style NetworkPolicy fill:#d5e8d4,stroke:#82b366
    style PodSecurity fill:#d5e8d4,stroke:#82b366
    style TLSCerts fill:#fff2cc,stroke:#d6b656
    style HFToken fill:#fff2cc,stroke:#d6b656
    style TGISCreds fill:#fff2cc,stroke:#d6b656
