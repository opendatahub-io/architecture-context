graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Optional - Gateway API)"]
        HTTPRoute["Gateway API HTTPRoute<br/>Paths: /v1/batches, /v1/files<br/>8000/TCP<br/>Encryption: Parent Gateway"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (ClusterIP)"]
        direction TB

        subgraph NS_App["Namespace: batch-gateway"]
            APIServer["batch-gateway-apiserver<br/>8000/TCP (API) + 8081/TCP (obs)<br/>Optional TLS 1.2+<br/>Auth: Tenant Header"]
            Processor["batch-gateway-processor<br/>9090/TCP (obs only)<br/>No inbound API"]
            GarbageCollector["batch-gateway-gc<br/>9091/TCP (obs only)<br/>Singleton"]
        end
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>TCP (runtime-configured)<br/>Auth: Connection URL<br/>Purpose: Metadata + CAS"]
        Redis["Redis/Valkey<br/>TCP (runtime-configured)<br/>Optional TLS 1.2+ / mTLS<br/>Auth: Connection URL<br/>Purpose: Queue + Events"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS (runtime-configured)<br/>Auth: AWS Credentials<br/>Purpose: File Storage"]
    end

    subgraph InternalPlatform["INTERNAL PLATFORM"]
        InferenceGW["llm-d Inference Gateway<br/>HTTP/HTTPS (runtime-configured)<br/>Optional TLS 1.2+ / mTLS<br/>Auth: API Key (optional)"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Insecure by default"]
        Prometheus["Prometheus<br/>HTTP Scrape<br/>/metrics endpoints"]
    end

    %% External → Ingress → API
    Client -->|"HTTP/8000<br/>Optional TLS 1.2+<br/>Header: X-MaaS-Username<br/>⚠ No app-level AuthN"| HTTPRoute
    HTTPRoute -->|"HTTP/8000<br/>Per parent Gateway"| APIServer

    %% Direct client access (without HTTPRoute)
    Client -.->|"HTTP/8000<br/>Optional TLS 1.2+<br/>Header: X-MaaS-Username"| APIServer

    %% API Server egress
    APIServer -->|"TCP<br/>Connection URL"| PostgreSQL
    APIServer -->|"TCP<br/>Optional TLS<br/>Connection URL"| Redis
    APIServer -->|"HTTP/HTTPS<br/>AWS Credentials"| S3

    %% Processor egress
    Processor -->|"TCP<br/>Connection URL"| PostgreSQL
    Processor -->|"TCP<br/>Optional TLS<br/>Connection URL"| Redis
    Processor -->|"HTTP/HTTPS<br/>AWS Credentials"| S3
    Processor -->|"HTTP/HTTPS<br/>Optional TLS 1.2+ / mTLS<br/>API Key (optional)"| InferenceGW
    Processor -->|"OTLP/gRPC<br/>No Auth"| OTel

    %% GC egress
    GarbageCollector -->|"TCP<br/>Connection URL"| PostgreSQL
    GarbageCollector -->|"TCP<br/>Optional TLS<br/>Connection URL"| Redis
    GarbageCollector -->|"HTTP/HTTPS<br/>AWS Credentials"| S3

    %% Observability scrape
    Prometheus -.->|"HTTP Scrape<br/>/metrics:8081"| APIServer
    Prometheus -.->|"HTTP Scrape<br/>/metrics:9090"| Processor
    Prometheus -.->|"HTTP Scrape<br/>/metrics:9091"| GarbageCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class HTTPRoute ingress
    class APIServer,Processor,GarbageCollector cluster
    class PostgreSQL,Redis,S3 datastore
    class InferenceGW platform
    class OTel,Prometheus observability
