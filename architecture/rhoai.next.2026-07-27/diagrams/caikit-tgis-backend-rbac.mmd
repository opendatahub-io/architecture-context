graph TD
    subgraph "caikit-tgis-backend RBAC"
        direction TB

        Note["No RBAC resources owned<br/>by this component"]

        subgraph "Platform-Delegated Security"
            direction TB
            ModelMeshAuth["ModelMesh<br/>Authentication Boundary"]
            PodLocal["Pod-Local Trust<br/>(co-located containers)"]
        end

        subgraph "gRPC Service Endpoints"
            Generate["fmaas.GenerationService<br/>Generate"]
            GenerateStream["fmaas.GenerationService<br/>GenerateStream"]
            ModelInfo["fmaas.GenerationService<br/>ModelInfo"]
            Tokenize["fmaas.GenerationService<br/>Tokenize"]
        end

        ModelMeshAuth -->|"enforces auth<br/>platform-delegated"| PodLocal
        PodLocal -->|"pod-local gRPC<br/>no auth required"| Generate
        PodLocal -->|"pod-local gRPC<br/>no auth required"| GenerateStream
        PodLocal -->|"pod-local gRPC<br/>no auth required"| ModelInfo
        PodLocal -->|"pod-local gRPC<br/>no auth required"| Tokenize
    end

    subgraph "Security Notes"
        direction TB
        Note1["No ClusterRoles owned"]
        Note2["No RoleBindings owned"]
        Note3["No Secrets referenced in source"]
        Note4["TLS credentials externally provisioned"]
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style ModelMeshAuth fill:#e8a838,stroke:#333,stroke-width:2px
    style PodLocal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style Generate fill:#dae8fc,stroke:#6c8ebf
    style GenerateStream fill:#dae8fc,stroke:#6c8ebf
    style ModelInfo fill:#dae8fc,stroke:#6c8ebf
    style Tokenize fill:#dae8fc,stroke:#6c8ebf
    style Note1 fill:#f9f9f9,stroke:#ccc
    style Note2 fill:#f9f9f9,stroke:#ccc
    style Note3 fill:#f9f9f9,stroke:#ccc
    style Note4 fill:#f9f9f9,stroke:#ccc
