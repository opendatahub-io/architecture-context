graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Application"]
    end

    subgraph Platform["PLATFORM LAYER (Service Mesh)"]
        Gateway["Service Mesh / Istio Gateway<br/>TLS 1.3 Termination<br/>AuthN/AuthZ Enforcement<br/>PeerAuthentication: mTLS STRICT"]
    end

    subgraph Container["CONTAINER (UID 2000 - Non-root)"]
        direction TB

        subgraph Servers["Serving Interfaces"]
            Uvicorn["Uvicorn HTTP Server<br/>Port 8000/TCP<br/>OpenAI-compatible API<br/>Plaintext (no TLS)"]
            TGIS["vllm-tgis-adapter<br/>Port 8033/TCP<br/>TGIS gRPC Protocol<br/>Plaintext (no TLS)"]
        end

        subgraph InferenceEngine["Inference Engine"]
            VLLMEngine["vLLM Engine<br/>GPU-Accelerated<br/>PagedAttention"]
            GPU["NVIDIA GPU<br/>CUDA Runtime<br/>Device Plugin Allocated"]
        end

        Uvicorn --> VLLMEngine
        TGIS --> VLLMEngine
        VLLMEngine --> GPU
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Runtime-Dependent)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM / Access Keys"]
        PVC["PVC / Local Storage<br/>Mount: /mnt/models<br/>No network egress"]
    end

    %% Network flows
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Bearer Token / mTLS"| Gateway
    Gateway -->|"HTTP/8000<br/>mTLS (sidecar)<br/>Service Identity"| Uvicorn
    Gateway -->|"gRPC/8033<br/>mTLS (sidecar)<br/>Service Identity"| TGIS
    VLLMEngine -.->|"HTTPS/443<br/>TLS 1.2+<br/>IAM Credentials"| S3
    VLLMEngine -.->|"Filesystem I/O<br/>No network"| PVC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef server fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef engine fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway platform
    class Uvicorn,TGIS server
    class VLLMEngine,GPU engine
    class S3,PVC externalservice
