graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / Admin<br/>kubectl / oc"]
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Authorization"]
    end

    subgraph OperatorNS["SPARK OPERATOR NAMESPACE (Internal)"]
        direction TB

        subgraph WebhookDeployment["Webhook Deployment"]
            Webhook["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>Image: ghcr.io/kubeflow/spark-operator/controller"]
            WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443/TCP → webhook"]
            WebhookHealth["Health Probes<br/>:8081/healthz, :8081/readyz<br/>HTTP, No Auth"]
        end

        subgraph ControllerDeployment["Controller Deployment"]
            Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>Image: ghcr.io/kubeflow/spark-operator/controller"]
            ControllerHealth["Health Probes<br/>:8081/healthz, :8081/readyz<br/>HTTP, No Auth"]
        end

        subgraph ModuleManager["Module Manager"]
            ModuleCtrl["spark-operator-module-controller-manager<br/>SA: spark-operator-module-controller-manager"]
        end
    end

    subgraph UserNS["USER NAMESPACES (Spark Workloads)"]
        DriverPod["Driver Pod<br/>SA: spark-operator-spark"]
        ExecutorPods["Executor Pods<br/>Mutated by webhook"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertMgr["cert-manager<br/>Certificate CRs<br/>TLS 1.2+"]
        PromOp["prometheus-operator<br/>PodMonitor CRs<br/>TLS 1.2+"]
        OSConfig["OpenShift API Server Config<br/>TLS Profile Settings"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| APIServer

    %% API Server to Webhook (admission)
    APIServer -->|"HTTPS/443<br/>TLS (cert-manager)<br/>K8s Admission"| WebhookSvc
    WebhookSvc --> Webhook

    %% Controller to API Server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    Webhook -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    %% Controller creates workloads
    Controller -.->|"creates via K8s API"| DriverPod
    Controller -.->|"creates via K8s API"| ExecutorPods

    %% Platform dependencies
    ModuleCtrl -->|"K8s API<br/>CRD CRUD<br/>TLS 1.2+"| CertMgr
    ModuleCtrl -->|"K8s API<br/>CRD CRUD<br/>TLS 1.2+"| PromOp
    Controller -->|"K8s API<br/>GET<br/>TLS 1.2+"| OSConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dce6f1,stroke:#4472c4,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef health fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class User external
    class APIServer controlplane
    class Webhook,Controller,ModuleCtrl,WebhookSvc operator
    class DriverPod,ExecutorPods workload
    class CertMgr,PromOp,OSConfig platform
    class WebhookHealth,ControllerHealth health
