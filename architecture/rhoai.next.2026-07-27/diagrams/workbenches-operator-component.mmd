graph TB
    subgraph "workbenches-operator"
        direction TB
        Reconciler["WorkbenchesReconciler<br/>(Controller)"]
        WebhookServer["Webhook Server<br/>Port 9443/TLS"]
        TLSWatcher["TLS SecurityProfileWatcher<br/>(TLS Profile Monitor)"]

        subgraph "Admission Webhooks"
            HWProfileWebhook["/workbenches-hardware-profile<br/>Mutating Webhook"]
            ConnNotebookWebhook["/workbenches-connection-notebook<br/>Mutating Webhook"]
            ConvertWebhook["/convert<br/>Conversion Webhook"]
        end

        subgraph "Health Probes"
            Healthz["/healthz<br/>Port 8081"]
            Readyz["/readyz<br/>Port 8081"]
        end

        WebhookServer --> HWProfileWebhook
        WebhookServer --> ConnNotebookWebhook
        WebhookServer --> ConvertWebhook
        TLSWatcher -->|"restarts on<br/>profile change"| Reconciler
    end

    WorkbenchesCR["Workbenches CR<br/>components.platform.opendatahub.io/v1alpha1<br/>(Cluster-scoped)"]
    WorkbenchesCR -->|"watched by (For)"| Reconciler

    Reconciler -->|"creates/manages"| Manifests["Kubeflow Notebook Controller<br/>Manifests (/opt/manifests)"]
    Manifests -->|"deploys"| Deployments["Deployments"]
    Manifests -->|"deploys"| Services["Services"]
    Manifests -->|"deploys"| SAs["ServiceAccounts"]
    Manifests -->|"deploys"| RBAC["RBAC Resources"]
    Manifests -->|"deploys"| CRDs["CRDs"]
    Manifests -->|"deploys"| WebhookConfigs["Webhook Configurations"]
    Manifests -->|"deploys"| Namespaces["Namespaces"]
    Manifests -->|"deploys"| ImageStreams["ImageStreams"]

    HWProfileWebhook -->|"reads"| HardwareProfileCR["HardwareProfile CR<br/>infrastructure.opendatahub.io"]
    ConnNotebookWebhook -->|"mutates"| NotebookCR["Notebook CR<br/>kubeflow.org"]
    HWProfileWebhook -->|"mutates"| NotebookCR

    TLSWatcher -->|"watches"| APIServer["OpenShift APIServer<br/>config.openshift.io"]

    Reconciler -->|"interacts"| K8sAPI["Kubernetes API<br/>6443/HTTPS"]

    style Reconciler fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style TLSWatcher fill:#4a90e2,color:#fff
    style HWProfileWebhook fill:#50c878,color:#fff
    style ConnNotebookWebhook fill:#50c878,color:#fff
    style ConvertWebhook fill:#50c878,color:#fff
    style WorkbenchesCR fill:#f5a623,color:#fff
    style HardwareProfileCR fill:#f5a623,color:#fff
    style NotebookCR fill:#f5a623,color:#fff
    style APIServer fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style Healthz fill:#ccc
    style Readyz fill:#ccc
