graph LR
    ai4rag["ai4rag<br/>Python Library<br/>RAG Pattern Generator"]

    %% Core Processing Dependencies
    ai4rag -->|"document processing<br/>~=2.107.0"| Docling["docling"]
    ai4rag -->|"document models<br/>~=2.84.0"| DoclingCore["docling-core"]
    ai4rag -->|"text splitting<br/>~=1.1.0"| LangChainSplitters["langchain-text-splitters"]

    %% Vector Store Dependencies
    ai4rag -->|"vector store<br/>~=1.1.0"| LangChainChroma["langchain-chroma"]
    ai4rag -->|"vector store + embeddings<br/>~=1.1.0"| OGXClient["ogx-client"]

    %% ML / Optimization Dependencies
    ai4rag -->|"ML optimization<br/>==1.8.*"| ScikitLearn["scikit-learn"]
    ai4rag -->|"GAM models<br/>~=0.12.0"| PyGAM["pyGAM"]
    ai4rag -->|"evaluation<br/>~=1.26.1"| Unitxt["unitxt"]

    %% Data / Storage Dependencies
    ai4rag -->|"S3 storage<br/>>=1.28"| Boto3["boto3"]
    ai4rag -->|"data analysis<br/>==2.2.*"| Pandas["pandas"]

    %% Runtime Dependencies
    ai4rag -->|"parallelism<br/>>=0.70"| Multiprocess["multiprocess"]
    ai4rag -->|"validation<br/>==2.11.*"| Pydantic["pydantic"]
    ai4rag -->|"HTML parsing"| BS4["beautifulsoup4"]
    ai4rag -->|"system metrics"| Psutil["psutil"]
    ai4rag -->|"env config"| Dotenv["dotenv"]

    %% External Services (runtime)
    ai4rag -->|"model storage<br/>HTTPS/443"| S3["AWS S3<br/>(S3-compatible)"]
    ai4rag -->|"vector ops"| OGXService["OGX Service"]
    ai4rag -->|"vector ops"| ChromaService["Chroma Service"]

    %% Runtime Requirement
    ai4rag -->|"runtime<br/>>=3.12, <3.14"| Python["Python"]

