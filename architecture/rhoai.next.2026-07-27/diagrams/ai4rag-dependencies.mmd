    style ai4rag fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core processing
    style Docling fill:#4a90e2,stroke:#333,color:#fff
    style DoclingCore fill:#4a90e2,stroke:#333,color:#fff
    style LangChainSplitters fill:#4a90e2,stroke:#333,color:#fff

    %% Vector stores
    style LangChainChroma fill:#7ed321,stroke:#333
    style OGXClient fill:#7ed321,stroke:#333

    %% ML
    style ScikitLearn fill:#f5a623,stroke:#333
    style PyGAM fill:#f5a623,stroke:#333
    style Unitxt fill:#f5a623,stroke:#333

    %% Data / Storage
    style Boto3 fill:#999,stroke:#333,color:#fff
    style Pandas fill:#999,stroke:#333,color:#fff

    %% Runtime
    style Multiprocess fill:#e8e8e8,stroke:#333
    style Pydantic fill:#e8e8e8,stroke:#333
    style BS4 fill:#e8e8e8,stroke:#333
    style Psutil fill:#e8e8e8,stroke:#333
    style Dotenv fill:#e8e8e8,stroke:#333
