graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph ServiceLayer["SERVICE LAYER (ClusterIP)"]
        ArgoSvc["argo-server Service<br/>ClusterIP 2746/TCP<br/>Internal only"]
    end

    subgraph AppLayer["APPLICATION LAYER (FIPS 140 Crypto)"]
        direction TB

        subgraph ArgoServerDep["argo-server Deployment"]
            ArgoServer["argo-server<br/>quay.io/argoproj/argocli:latest<br/>HTTPS/2746 (REST + gRPC-gateway)<br/>runAsNonRoot, readOnlyRootFilesystem<br/>drop ALL caps, no privilege escalation<br/>OAuth2/OIDC SSO (go-oidc/v3)"]
        end

        subgraph WFCtrlDep["workflow-controller Deployment"]
            WFCtrl["workflow-controller<br/>quay.io/argoproj/workflow-controller:latest<br/>User: 8737<br/>Health: HTTP/6060<br/>Metrics: HTTP/9090<br/>Leader Election (Lease)"]
        end

        ArgoExec["argoexec Sidecar<br/>User: 2000<br/>Step/DAG Executor<br/>Injected into workflow Pods"]
    end

    subgraph K8sLayer["KUBERNETES API"]
        K8sAPI["Kubernetes API Server<br/>HTTPS/6443 TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        IdP["Identity Provider<br/>OAuth2/OIDC<br/>HTTPS"]
        ArtifactStorage["Artifact Storage<br/>S3/MinIO | GCS | Azure Blob<br/>Alibaba OSS | HDFS<br/>HTTPS/443"]
        ArchiveDB["Archive Database<br/>MySQL/3306 | PostgreSQL/5432<br/>SQLite (local)"]
    end

    %% Flows
    Client -->|"HTTPS/2746<br/>TLS (FIPS 140)<br/>Bearer Token (OAuth2/OIDC)"| ArgoSvc
    ArgoSvc -->|"TCP/2746"| ArgoServer

    ArgoServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount + SSAR"| K8sAPI
    ArgoServer -->|"HTTPS<br/>OAuth2 redirect/callback"| IdP

    WFCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>ConfigMap, Pod, Secret,<br/>PDB, Lease CRUD"| K8sAPI
    WFCtrl -->|"Creates Pods<br/>with sidecar"| ArgoExec

    ArgoExec -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>WorkflowTaskResult"| K8sAPI
    ArgoExec -->|"HTTPS/443<br/>Provider Auth<br/>Artifact upload/download"| ArtifactStorage

    WFCtrl -->|"TCP/3306 or 5432<br/>DB credentials<br/>Workflow archival"| ArchiveDB

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class ArgoSvc service
    class ArgoServer,WFCtrl,ArgoExec app
    class K8sAPI k8s
    class IdP,ArtifactStorage,ArchiveDB extsvc
