        CRB_Metrics["mlflow-operator-metrics-auth-rolebinding"]
        CRB_LegacyManager["manager-rolebinding"]
        CRB_LegacyMetrics["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_Leader["mlflow-operator-leader-election-rolebinding<br/>(ns: opendatahub)"]
