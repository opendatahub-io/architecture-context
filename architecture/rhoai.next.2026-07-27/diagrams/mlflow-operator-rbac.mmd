    CR_Manager -->|manages| ConsoleRes
    CR_Manager -->|manages| RBACRes
    CR_Manager -->|manages| AuthRes
    CR_Manager -->|manages| OSConfig

    subgraph MetricsResources["Metrics Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    CR_Metrics -->|manages| TokenReview
    CR_Metrics -->|manages| SAR

    subgraph LeaderResources["Leader Election Resources"]
        LeaderCM["configmaps<br/>full CRUD"]
        LeaderLease["coordination.k8s.io<br/>leases<br/>full CRUD"]
        LeaderEvents["events<br/>create, patch"]
    end

    R_Leader -->|manages| LeaderCM
    R_Leader -->|manages| LeaderLease
    R_Leader -->|manages| LeaderEvents

    subgraph AggregateRoles["Aggregate Roles (User-facing)"]
        direction LR
        ViewPerms["View Permissions<br/>mlflows, mlflowconfigs<br/>datasets, experiments<br/>get, list, watch"]
        EditPerms["Edit Permissions<br/>mlflows, mlflowconfigs<br/>datasets, experiments<br/>full CRUD"]
        IntegrationPerms["Integration Permissions<br/>datasets, experiments<br/>registeredmodels<br/>create, get, list, update"]
    end

    CR_View -->|grants| ViewPerms
    CR_Edit -->|grants| EditPerms
    CR_Integration -->|grants| IntegrationPerms

