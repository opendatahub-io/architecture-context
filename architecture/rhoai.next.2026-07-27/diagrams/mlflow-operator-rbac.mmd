        NetRes["Networking<br/>networkpolicies<br/>full CRUD"]
        MonRes["Monitoring<br/>servicemonitors<br/>full CRUD (conditional)"]
        MLflowRes["MLflow CRDs<br/>mlflows, mlflowoperators<br/>mlflowconfigs<br/>full CRUD"]
        GatewayRes["Gateway API<br/>httproutes<br/>full CRUD (conditional)"]
        ConsoleRes["OpenShift Console<br/>consolelinks<br/>full CRUD (conditional)"]
        RBACRes["RBAC Resources<br/>clusterroles, rolebindings<br/>clusterrolebindings<br/>full CRUD + bind"]
        AuthRes["Auth<br/>auths (platform)<br/>get, list, watch"]
        OSConfig["OpenShift Config<br/>apiservers<br/>get, list, watch"]
