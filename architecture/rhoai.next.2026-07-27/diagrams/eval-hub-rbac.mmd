graph TD
    subgraph "Identity Enforcement"
        KubeRBACProxy["kube-rbac-proxy<br/>(cluster mode)"]
    end

    subgraph "Authentication Flow"
        direction TB
        IdentityCheck["canContinueRequest()<br/>Identity Header Validation"]
        MCPAuth["wrapRequest()<br/>MCP Auth Dispatch"]
    end

    subgraph "Auth Types"
        RBACProxyAuth["AuthTypeRBACProxy<br/>Enforces X-User + X-Tenant<br/>403 on missing"]
        NoneAuth["AuthTypeNone<br/>No enforcement"]
    end

    subgraph "Protected API Endpoints"
        Collections["/api/v1/evaluations/collections<br/>ALL methods<br/>Conditional auth"]
        Jobs["/api/v1/evaluations/jobs<br/>ALL methods<br/>Conditional auth"]
        Providers["/api/v1/evaluations/providers<br/>ALL methods<br/>Conditional auth"]
        Health["/api/v1/health<br/>ALL methods<br/>Conditional auth"]
    end

    subgraph "Unauthenticated Endpoints"
        Docs["/docs<br/>GET only<br/>No auth"]
        OpenAPI["/openapi.yaml<br/>GET only<br/>No auth"]
    end

    subgraph "Kubernetes RBAC"
        SA["ServiceAccount<br/>(kubeconfig credential chain)"]
        K8sResources["Kubernetes Resources<br/>batch/v1/Job<br/>/v1/ConfigMap<br/>/v1/Secret<br/>/v1/Pod"]
        HWProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1<br/>get, delete"]
    end

    %% Identity flow
    KubeRBACProxy -->|"enforces headers"| IdentityCheck
    KubeRBACProxy -->|"enforces headers"| MCPAuth
    IdentityCheck -->|"RequiresIdentityHeaders()=true"| RBACProxyAuth
    IdentityCheck -->|"RequiresIdentityHeaders()=false"| NoneAuth
    MCPAuth -->|"cluster mode"| RBACProxyAuth
    MCPAuth -->|"local mode"| NoneAuth

    %% Protected routes
    RBACProxyAuth -->|"validates X-User, X-Tenant"| Collections
    RBACProxyAuth -->|"validates X-User, X-Tenant"| Jobs
    RBACProxyAuth -->|"validates X-User, X-Tenant"| Providers
    RBACProxyAuth -->|"validates X-User, X-Tenant"| Health

    %% Kubernetes RBAC
    SA -->|"kubeconfig auth"| K8sResources
    SA -->|"kubeconfig auth"| HWProfile

    style KubeRBACProxy fill:#f5a623,stroke:#333
    style RBACProxyAuth fill:#e74c3c,stroke:#333,color:#fff
    style NoneAuth fill:#95a5a6,stroke:#333,color:#fff
    style Collections fill:#4a90e2,stroke:#333,color:#fff
    style Jobs fill:#4a90e2,stroke:#333,color:#fff
    style Providers fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style Docs fill:#7ed321,stroke:#333
    style OpenAPI fill:#7ed321,stroke:#333
    style SA fill:#f5a623,stroke:#333
    style K8sResources fill:#e8e8e8,stroke:#333
    style HWProfile fill:#e8e8e8,stroke:#333
