graph TB
    subgraph "models-perf-benchmark-data"
        direction TB

        subgraph APIClient["API Client (Python CLI)"]
            Client["REST Client<br/>client.py"]
            Config["Config<br/>config.py<br/>API_BASE_URL"]
            Pipeline["Pipeline<br/>pipeline.py"]
            Serializer["Serializer<br/>serializer.py"]
            PostProcess["Post-Processor<br/>postprocess.py"]
            Writer["Writer<br/>writer.py"]
        end

        subgraph DataStore["Data Directory"]
            Manifest["manifest.json"]
            ModelDirs["Per-Model Directories"]
            NDJSON["NDJSON Files<br/>evaluations, performance,<br/>security-evaluations"]
            JSONFiles["JSON Files<br/>metadata, provider info"]
        end

        subgraph ContainerImage["Init Container Image"]
            DataPayload["Packaged Data<br/>Payload"]
        end
    end

    ExternalAPI["External Benchmark<br/>REST API"] -->|HTTPS<br/>paginated fetch| Client
    Config -->|API_BASE_URL| Client
    Client -->|raw data| Pipeline
    Pipeline -->|raw records| Serializer
    Serializer -->|normalized records| PostProcess
    PostProcess -->|enriched records| Writer
    Writer -->|NDJSON/JSON| ModelDirs
    Writer -->|generates| Manifest

    ModelDirs --> DataPayload
    JSONFiles --> DataPayload
    NDJSON --> DataPayload
    Manifest --> DataPayload

    DataPayload -->|init container| ModelCatalog["model-catalog Deployment<br/>odh-model-registries namespace"]

    ModelRegistryOp["model-registry-operator<br/>opendatahub namespace"] -->|manages lifecycle| ModelCatalog

    style Client fill:#4a90e2,stroke:#333
    style Pipeline fill:#4a90e2,stroke:#333
    style Serializer fill:#4a90e2,stroke:#333
    style PostProcess fill:#4a90e2,stroke:#333
    style Writer fill:#4a90e2,stroke:#333
    style Config fill:#4a90e2,stroke:#333
    style DataPayload fill:#7ed321,stroke:#333
    style Manifest fill:#f5a623,stroke:#333
    style ModelDirs fill:#f5a623,stroke:#333
    style NDJSON fill:#f5a623,stroke:#333
    style JSONFiles fill:#f5a623,stroke:#333
    style ExternalAPI fill:#e8e8e8,stroke:#333
    style ModelCatalog fill:#7ed321,stroke:#333
    style ModelRegistryOp fill:#7ed321,stroke:#333
