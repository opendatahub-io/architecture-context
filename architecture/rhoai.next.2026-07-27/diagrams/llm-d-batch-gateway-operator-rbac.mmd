graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["llm-d-batch-gateway-operator<br/>(ServiceAccount)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["llm-d-batch-gateway-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (namespaced)"]
        RB_LeaderElection["llm-d-batch-gateway-<br/>leader-election-rolebinding<br/>(ns: redhat-ods-applications)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Operator["llm-d-batch-gateway-operator<br/>(ClusterRole)"]
        CR_Admin["llm-d-batch-gateway-admin<br/>(ClusterRole, aggregate)"]
        CR_View["llm-d-batch-gateway-view<br/>(ClusterRole, aggregate)"]
    end

    subgraph Roles["Roles (namespaced)"]
        R_LeaderElection["llm-d-batch-gateway-<br/>leader-election-role<br/>(ns: redhat-ods-applications)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps"]
        ServiceAcctRes["core<br/>serviceaccounts"]
        Services["core<br/>services"]
        Events["core<br/>events"]
        SecretsRes["core<br/>secrets"]
    end

    subgraph AppsResources["apps API Resources"]
        Deployments["apps<br/>deployments"]
    end

    subgraph BatchResources["batch.llm-d.ai API Resources"]
        LLMBatchGateways["batch.llm-d.ai<br/>llmbatchgateways"]
        LLMBatchGatewaysFinalizers["batch.llm-d.ai<br/>llmbatchgateways/finalizers"]
        LLMBatchGatewaysStatus["batch.llm-d.ai<br/>llmbatchgateways/status"]
    end

    subgraph CertManagerResources["cert-manager.io API Resources"]
        Certificates["cert-manager.io<br/>certificates"]
    end

    subgraph GatewayResources["gateway.networking.k8s.io API Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes"]
        ReferenceGrants["gateway.networking.k8s.io<br/>referencegrants"]
    end

    subgraph MonitoringResources["monitoring.coreos.com API Resources"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
        PodMonitors["monitoring.coreos.com<br/>podmonitors"]
        PrometheusRules["monitoring.coreos.com<br/>prometheusrules"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    %% Bindings
    SA_Operator -->|bound via| CRB_Operator
    SA_Operator -->|bound via| RB_LeaderElection
    CRB_Operator -->|grants| CR_Operator
    RB_LeaderElection -->|grants| R_LeaderElection

    %% ClusterRole permissions
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| ConfigMaps
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| ServiceAcctRes
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| Services
    CR_Operator -->|create,patch| Events
    CR_Operator -->|create,get,list,<br/>patch,watch| SecretsRes
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| Deployments
    CR_Operator -->|get,list,patch,<br/>update,watch| LLMBatchGateways
    CR_Operator -->|update| LLMBatchGatewaysFinalizers
    CR_Operator -->|get,patch,update| LLMBatchGatewaysStatus
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| Certificates
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| HTTPRoutes
    CR_Operator -->|get,list,watch| ReferenceGrants
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| ServiceMonitors
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| PodMonitors
    CR_Operator -->|create,delete,get,list,<br/>patch,update,watch| PrometheusRules

    %% Leader election role permissions
    R_LeaderElection -->|create,delete,get,list,<br/>patch,update,watch| Leases
    R_LeaderElection -->|create,patch| Events

    %% Aggregate role permissions
    CR_Admin -->|create,delete,get,list,<br/>patch,update,watch| LLMBatchGateways
    CR_Admin -->|get| LLMBatchGatewaysStatus
    CR_View -->|get,list,watch| LLMBatchGateways
    CR_View -->|get| LLMBatchGatewaysStatus

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style CR_Operator fill:#f5a623,color:#fff
    style CR_Admin fill:#f5a623,color:#fff
    style CR_View fill:#f5a623,color:#fff
    style R_LeaderElection fill:#e8a623,color:#fff
    style CRB_Operator fill:#e8e8e8
    style RB_LeaderElection fill:#e8e8e8
    style LLMBatchGateways fill:#7ed321,color:#fff
    style LLMBatchGatewaysFinalizers fill:#7ed321,color:#fff
    style LLMBatchGatewaysStatus fill:#7ed321,color:#fff
