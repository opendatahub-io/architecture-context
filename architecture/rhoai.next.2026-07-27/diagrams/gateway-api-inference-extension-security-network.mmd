graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Gateway API Gateway<br/>(data-science-gateway)<br/>8443/TCP HTTPS<br/>TLS"]
    end

    subgraph EnvoyLayer["ENVOY PROXY LAYER"]
        Envoy["Envoy Proxy<br/>Routes requests to InferencePool"]
    end

    subgraph EPPService["EPP SERVICE"]
        direction TB
        EPP["Endpoint Picker (EPP)<br/>gRPC ExternalProcessor + Health<br/>Encryption: Optional TLS<br/>Auth: None"]
        Pipeline["Plugin Pipeline<br/>Parser → DataLayer →<br/>SatDetector → FlowControl →<br/>Scheduler → EndpointSelect"]
        EPP --- Pipeline
    end

    subgraph ModelServing["MODEL-SERVING LAYER"]
        ModelPods["Model-Serving Pods<br/>Matched by InferencePool<br/>label selector"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        direction TB
        Controllers["Kubernetes Controllers<br/>InferencePool, InferenceObjective,<br/>InferenceModelRewrite, Pod, ConfigMap"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS"| Gateway
    Gateway -->|"HTTP/HTTPS<br/>HTTPRoute → InferencePool"| Envoy
    Envoy -->|"gRPC ExtProc<br/>Optional TLS<br/>No App Auth"| EPP
    EPP -->|"Selected podIP:port<br/>(via Envoy)"| ModelPods
    EPP -->|"HTTP metrics scrape<br/>Prometheus metrics"| ModelPods
    Controllers -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef envoy fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef epp fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef modelserving fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef cluster fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class Envoy envoy
    class EPP,Pipeline epp
    class ModelPods modelserving
    class Controllers controlplane
    class K8sAPI cluster
