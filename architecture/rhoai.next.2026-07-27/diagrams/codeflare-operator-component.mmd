graph TB
    subgraph CodeflareOperator["CodeFlare Operator"]
        Manager["codeflare-operator-manager<br/>(Deployment)"]
        RayClusterReconciler["RayCluster Reconciler"]
        AppWrapperCtrl["AppWrapper Controller"]
        MutatingWH["Mutating Webhooks<br/>9443/TCP TLS"]
        ValidatingWH["Validating Webhooks<br/>9443/TCP TLS"]
        MetricsEP["Metrics Endpoint<br/>8080/TCP"]
        HealthEP["Health/Ready Probes<br/>8081/TCP"]

        Manager --> RayClusterReconciler
        Manager --> AppWrapperCtrl
        Manager --> MutatingWH
        Manager --> ValidatingWH
        Manager --> MetricsEP
        Manager --> HealthEP
    end

    %% CRDs
    AppWrapperCR["AppWrapper CR<br/>workload.codeflare.dev/v1beta2"]
    RayClusterCR["RayCluster CR<br/>ray.io/v1"]

    %% Owned Resources
    AppWrapperCR -->|watched by| AppWrapperCtrl
    RayClusterCR -->|watched by<br/>(For)| RayClusterReconciler

    subgraph OwnedResources["Owned Resources (per RayCluster)"]
        OwnedSvc["Service"]
        OwnedSA["ServiceAccount"]
        OwnedIngress["Ingress"]
        OwnedNetPol["NetworkPolicy"]
        OwnedRoute["Route"]
    end

    RayClusterReconciler -->|creates/owns| OwnedSvc
    RayClusterReconciler -->|creates/owns| OwnedSA
    RayClusterReconciler -->|creates/owns| OwnedIngress
    RayClusterReconciler -->|creates/owns| OwnedNetPol
    RayClusterReconciler -->|creates/owns| OwnedRoute
    RayClusterReconciler -->|watches| CRB["ClusterRoleBinding"]

    %% Webhook targets
    User["User / Client"] -->|creates| AppWrapperCR
    User -->|creates| RayClusterCR
    MutatingWH -->|mutates| AppWrapperCR
    MutatingWH -->|mutates| RayClusterCR
    ValidatingWH -->|validates| AppWrapperCR
    ValidatingWH -->|validates| RayClusterCR

    %% Multi-framework workloads
    subgraph ManagedWorkloads["Managed Workloads"]
        RayJob["RayJob<br/>ray.io"]
        PyTorchJob["PyTorchJob<br/>kubeflow.org"]
        JobSet["JobSet<br/>jobset.x-k8s.io"]
        PodGroup["PodGroup<br/>scheduling.sigs.k8s.io"]
    end

    AppWrapperCtrl -->|orchestrates| RayJob
    AppWrapperCtrl -->|orchestrates| PyTorchJob
    AppWrapperCtrl -->|orchestrates| JobSet
    AppWrapperCtrl -->|gang scheduling| PodGroup

    %% Platform dependencies
    AppWrapperCtrl -->|quota integration| Kueue["Kueue"]
    Manager -->|reads| DSCI["DSCInitialization CR"]
    Manager -->|uses| ODHOperator["opendatahub-operator<br/>(Go library)"]

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style RayClusterReconciler fill:#4a90e2,stroke:#333,color:#fff
    style AppWrapperCtrl fill:#4a90e2,stroke:#333,color:#fff
    style MutatingWH fill:#4a90e2,stroke:#333,color:#fff
    style ValidatingWH fill:#4a90e2,stroke:#333,color:#fff
    style MetricsEP fill:#4a90e2,stroke:#333,color:#fff
    style HealthEP fill:#4a90e2,stroke:#333,color:#fff
    style AppWrapperCR fill:#f5a623,stroke:#333
    style RayClusterCR fill:#f5a623,stroke:#333
    style Kueue fill:#e8e8e8,stroke:#333
    style DSCI fill:#7ed321,stroke:#333
    style ODHOperator fill:#7ed321,stroke:#333
    style OwnedSvc fill:#d5e8d4,stroke:#82b366
    style OwnedSA fill:#d5e8d4,stroke:#82b366
    style OwnedIngress fill:#d5e8d4,stroke:#82b366
    style OwnedNetPol fill:#d5e8d4,stroke:#82b366
    style OwnedRoute fill:#d5e8d4,stroke:#82b366
    style CRB fill:#d5e8d4,stroke:#82b366
    style RayJob fill:#dae8fc,stroke:#6c8ebf
    style PyTorchJob fill:#dae8fc,stroke:#6c8ebf
    style JobSet fill:#dae8fc,stroke:#6c8ebf
    style PodGroup fill:#dae8fc,stroke:#6c8ebf
