graph TB
    subgraph "llm-d Platform"
        subgraph "Inference Gateway"
            Gateway["llm-d-inference-gateway<br/>Gateway API<br/>Port: 80/HTTP"]
            HTTPRoute["HTTPRoute<br/>Header: X-Gateway-Base-Model-Name<br/>Backend: InferencePool"]
        end

        subgraph "Router"
            EPP["Endpoint Picker Plugin (EPP)<br/>Intelligent Request Routing"]
            Envoy["Envoy Sidecar Proxy<br/>Traffic Forwarding"]
            EPP -->|selects endpoints| Envoy
        end

        subgraph "Model Servers"
            Prefill["Prefill Deployment<br/>Prompt Processing<br/>Port: 8000 (HTTP/gRPC)"]
            Decode["Decode Deployment<br/>Token Generation<br/>Port: 8000 (HTTP/gRPC)"]
        end

        Gateway -->|routes via| HTTPRoute
        HTTPRoute -->|references| InferencePool["InferencePool CR<br/>inference.networking.k8s.io"]
        InferencePool -->|selects via| EPP
        Envoy -->|forwards to| Prefill
        Envoy -->|forwards to| Decode
        Prefill -->|NIXL KV-cache transfer<br/>TCP/5600| Decode
    end

    Client[External Client] -->|HTTP/80<br/>Model inference requests| Gateway

    subgraph "Observability"
        OTel["OpenTelemetry Collector<br/>localhost:4317<br/>Traces & Metrics"]
        PodMonitor["PodMonitor<br/>monitoring.coreos.com<br/>Prometheus Scraping"]
    end

    EPP -->|traces<br/>parentbased_traceidratio 10%| OTel
    Prefill -.->|metrics| PodMonitor
    Decode -.->|metrics| PodMonitor

    style Gateway fill:#4a90e2,stroke:#333,color:#fff
    style HTTPRoute fill:#f5a623,stroke:#333,color:#fff
    style InferencePool fill:#f5a623,stroke:#333,color:#fff
    style EPP fill:#9b59b6,stroke:#333,color:#fff
    style Envoy fill:#9b59b6,stroke:#333,color:#fff
    style Prefill fill:#27ae60,stroke:#333,color:#fff
    style Decode fill:#27ae60,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style OTel fill:#e67e22,stroke:#333,color:#fff
    style PodMonitor fill:#e67e22,stroke:#333,color:#fff
