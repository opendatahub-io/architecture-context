graph LR
    TrustyAI["TrustyAI Explainability<br/>Service"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"inbound inference payloads<br/>POST /consumer/kserve/v2"| KServe["KServe / ModelMesh<br/>(Model Serving)"]
    TrustyAI -->|"metrics scrape<br/>GET /q/metrics"| Prometheus["Prometheus<br/>(Monitoring)"]

    %% Control Plane Dependencies
    TrustyAI -->|"init: oc apply<br/>model-serving-config ConfigMap"| K8sAPI["OpenShift API Server"]

    %% Storage Dependencies
    TrustyAI -->|"inference data<br/>PVC /inputs"| PVC["PersistentVolumeClaim<br/>(trustyai-service-pvc)"]

    %% Ingress
    Route["OpenShift Route<br/>(trustyai)"] -->|"HTTP traffic"| TrustyAI

    %% Integration Points (inbound)
    KServe -->|"sends payloads via<br/>model-serving-config registration"| TrustyAI

    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px
    style KServe fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style K8sAPI fill:#999,stroke:#333
    style PVC fill:#f5a623,stroke:#333
    style Route fill:#ffe6cc,stroke:#d79b00
