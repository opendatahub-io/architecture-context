graph TD
    subgraph "Authentication Contexts"
        AdminAuth["Admin kubeconfig<br/>(Controller Auth)<br/>Full cluster admin"]
        WorkloadAuth["ServiceAccount Auth<br/>(Workload Pods)<br/>Token mount: DISABLED"]
    end

    subgraph "Service Accounts"
        SA["ServiceAccount<br/>rhaii-validator<br/>Namespace: rhaii-validation<br/>(ephemeral)"]
    end

    subgraph "ClusterRole Bindings (Ephemeral)"
        CRB1["ClusterRoleBinding<br/>rhaii-validator"]
        CRB2["ClusterRoleBinding<br/>rhaii-validator-scc-{namespace}<br/>(OpenShift only)"]
    end

    subgraph "ClusterRoles"
        CR["ClusterRole<br/>rhaii-validator<br/>(empty rules)"]
        SCC["ClusterRole<br/>system:openshift:scc:privileged<br/>(OpenShift built-in)"]
    end

    subgraph "Controller Permissions (via kubeconfig)"
        NS_Ops["v1/Namespace<br/>create, delete"]
        SA_Ops["v1/ServiceAccount<br/>create"]
        CM_Ops["v1/ConfigMap<br/>create, get, update"]
        Node_Ops["v1/Node<br/>list"]
        Pod_Ops["v1/Pod<br/>get, list, logs"]
        Job_Ops["batch/v1/Job<br/>create, watch"]
        CR_Ops["rbac/v1/ClusterRole<br/>create, delete"]
        CRB_Ops["rbac/v1/ClusterRoleBinding<br/>create, delete"]
    end

    subgraph "Workload Pod Permissions"
        NoPerm["No API permissions<br/>(empty ClusterRole rules)<br/>Token mount disabled"]
        HostAccess["Host-level access<br/>(via privileged SCC)<br/>GPU, sysfs, RDMA"]
    end

    %% Controller auth flow
    AdminAuth -->|"uses"| NS_Ops
    AdminAuth -->|"uses"| SA_Ops
    AdminAuth -->|"uses"| CM_Ops
    AdminAuth -->|"uses"| Node_Ops
    AdminAuth -->|"uses"| Pod_Ops
    AdminAuth -->|"uses"| Job_Ops
    AdminAuth -->|"uses"| CR_Ops
    AdminAuth -->|"uses"| CRB_Ops

    %% Workload auth flow
    WorkloadAuth -->|"bound to"| SA
    SA -->|"bound via"| CRB1
    CRB1 -->|"grants"| CR
    CR -->|"provides"| NoPerm

    SA -->|"bound via"| CRB2
    CRB2 -->|"grants"| SCC
    SCC -->|"provides"| HostAccess

    %% Lifecycle
    AdminAuth -->|"creates/deletes<br/>(deferred cleanup)"| SA
    AdminAuth -->|"creates/deletes<br/>(deferred cleanup)"| CRB1
    AdminAuth -->|"creates/deletes<br/>(deferred cleanup)"| CRB2
    AdminAuth -->|"creates/deletes<br/>(deferred cleanup)"| CR

    style AdminAuth fill:#4a90e2,color:#fff
    style WorkloadAuth fill:#4a90e2,color:#fff
    style SA fill:#f5a623,color:#fff
    style CRB1 fill:#e1d5e7,stroke:#9673a6
    style CRB2 fill:#e1d5e7,stroke:#9673a6
    style CR fill:#f5a623,color:#fff
    style SCC fill:#f5a623,color:#fff
    style NoPerm fill:#d5e8d4,stroke:#82b366
    style HostAccess fill:#fff2cc,stroke:#d6b656
    style NS_Ops fill:#7ed321,color:#fff
    style SA_Ops fill:#7ed321,color:#fff
    style CM_Ops fill:#7ed321,color:#fff
    style Node_Ops fill:#7ed321,color:#fff
    style Pod_Ops fill:#7ed321,color:#fff
    style Job_Ops fill:#7ed321,color:#fff
    style CR_Ops fill:#7ed321,color:#fff
    style CRB_Ops fill:#7ed321,color:#fff
