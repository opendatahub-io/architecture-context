graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph ProxyLayer["GATEWAY / PROXY LAYER"]
        Envoy["Envoy Proxy<br/>L7 proxy with ExtProc filter"]
    end

    subgraph Application["APPLICATION LAYER (llm-d-router)"]
        direction TB

        subgraph EPP["Endpoint Picker (EPP)"]
            ExtProc["ExternalProcessor<br/>gRPC / Optional TLS<br/>Auth: None"]
            HealthGRPC["Health gRPC<br/>Optional TLS<br/>Auth: None"]
            MetricsEP["Metrics /metrics<br/>HTTP<br/>Auth: Optional kube-apiserver<br/>delegated"]
        end

        subgraph CoordServer["Coordinator Server"]
            ChatAPI["/v1/chat/completions<br/>HTTP<br/>Auth: None<br/>(upstream gateway)"]
            CompAPI["/v1/completions<br/>HTTP<br/>Auth: None<br/>(upstream gateway)"]
            HealthHTTP["/healthz & /readyz<br/>HTTP<br/>Auth: None"]
        end

        subgraph Ctrl["Controllers"]
            IMRCtrl["InferenceModelRewrite<br/>Reconciler"]
            IOCtrl["InferenceObjective<br/>Reconciler"]
            IPCtrl["InferencePool<br/>Reconciler"]
            PodCtrl["Pod Reconciler"]
        end
    end

    subgraph EgressZone["EGRESS (Outbound Services)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>Auth: ServiceAccount"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>default: localhost:4317<br/>Encryption: runtime config"]
        Redis["Redis<br/>Runtime configured<br/>Cache/State"]
    end

    %% External to Proxy
    Client -->|"HTTP/HTTPS<br/>Auth: gateway-dependent"| Envoy

    %% Proxy to EPP
    Envoy -->|"gRPC ExtProc<br/>Optional TLS<br/>Auth: None"| ExtProc

    %% Client direct to Coordinator
    Client -.->|"HTTP<br/>Auth: upstream gateway"| ChatAPI
    Client -.->|"HTTP"| CompAPI

    %% Controllers to K8s API
    IMRCtrl -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    IOCtrl -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    IPCtrl -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    PodCtrl -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Observability
    EPP -.->|"OTLP/gRPC<br/>runtime config"| OTel
    EPP -.->|"Redis protocol<br/>runtime config"| Redis

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controller fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy proxy
    class ExtProc,HealthGRPC,MetricsEP,ChatAPI,CompAPI,HealthHTTP app
    class IMRCtrl,IOCtrl,IPCtrl,PodCtrl controller
    class K8sAPI,OTel,Redis egress
