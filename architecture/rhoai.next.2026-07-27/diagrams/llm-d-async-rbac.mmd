graph TD
    subgraph "Service Account"
        SA["llm-d-async<br/>ServiceAccount<br/>(inferred from workload)"]
    end

    subgraph "Authentication Methods"
        SAToken["ServiceAccount Token<br/>Auto-mounted"]
        Kubelet["Kubelet Probes<br/>Unauthenticated"]
    end

    subgraph "Access Patterns"
        K8sAccess["Kubernetes API Access<br/>6443/TCP, HTTPS/WSS<br/>TLS 1.2+"]
        HealthAccess["Health Probe Access<br/>/healthz, /readyz<br/>Pod-local network"]
    end

    subgraph "Note"
        NoRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>in analyzed manifests"]
    end

    SA -->|"auto-mounted"| SAToken
    SA -.->|"probed by"| Kubelet
    SAToken -->|"authenticates"| K8sAccess
    Kubelet -->|"accesses"| HealthAccess

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style SAToken fill:#f5a623,stroke:#333,color:#fff
    style Kubelet fill:#f5a623,stroke:#333,color:#fff
    style K8sAccess fill:#7ed321,stroke:#333,color:#fff
    style HealthAccess fill:#7ed321,stroke:#333,color:#fff
    style NoRBAC fill:#f8cecc,stroke:#b85450,stroke-dasharray:5
