graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kubeflow-training-operator<br/>SA: kubeflow-training-operator"]
    end

    subgraph ClusterBindings["Cluster Role Bindings"]
        CRB["kubeflow-training-operator<br/>ClusterRoleBinding<br/>(cluster-scoped)"]
    end

    subgraph NamespaceBindings["Namespace Role Bindings"]
        RB_Webhook["kubeflow-training-operator-webhook<br/>RoleBinding<br/>(ns: opendatahub)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Operator["kubeflow-training-operator<br/>ClusterRole"]
        CR_Edit["kubeflow-training-edit<br/>ClusterRole (aggregate)"]
        CR_View["kubeflow-training-view<br/>ClusterRole (aggregate)"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        R_Webhook["kubeflow-training-operator-webhook<br/>Role (ns: opendatahub)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps<br/>create,list,update,watch"]
        EventsPods["core<br/>events, pods<br/>create,delete,get,list,<br/>patch,update,watch"]
        PodsExec["core<br/>pods/exec<br/>create"]
        SvcAccounts["core<br/>serviceaccounts<br/>create,get,list,watch"]
        Svcs["core<br/>services<br/>create,delete,get,list,watch"]
        Secrets["core<br/>secrets<br/>get,list,update,watch"]
    end

    subgraph KubeflowResources["Kubeflow API Resources"]
        Jobs["kubeflow.org<br/>jaxjobs, mpijobs, paddlejobs,<br/>pytorchjobs, tfjobs, xgboostjobs<br/>create,delete,get,list,<br/>patch,update,watch"]
        JobsFinalizers["kubeflow.org<br/>*jobs/finalizers<br/>update"]
        JobsStatus["kubeflow.org<br/>*jobs/status<br/>get,patch,update"]
    end

    subgraph SchedulingResources["Scheduling Resources"]
        VolcanoPG["scheduling.volcano.sh<br/>podgroups<br/>create,delete,get,list,<br/>patch,update,watch"]
        SchedulerPG["scheduling.x-k8s.io<br/>podgroups<br/>create,delete,get,list,<br/>patch,update,watch"]
    end

    subgraph OtherResources["Other API Resources"]
        AdmissionWH["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>get,list,update,watch"]
        HPA["autoscaling<br/>horizontalpodautoscalers<br/>create,delete,get,list,<br/>patch,update,watch"]
        RolesBindings["rbac.authorization.k8s.io<br/>roles, rolebindings<br/>create,list,update,watch"]
        NetPolicies["networking.k8s.io<br/>networkpolicies<br/>create,delete,get,list,<br/>patch,update,watch"]
        APIServers["config.openshift.io<br/>apiservers<br/>get"]
    end

    %% Operator SA → ClusterRole
    SA -->|bound via| CRB
    CRB -->|grants| CR_Operator

    %% Operator SA → Namespace Role
    SA -->|bound via| RB_Webhook
    RB_Webhook -->|grants| R_Webhook

    %% ClusterRole → Resources
    CR_Operator -->|manages| ConfigMaps
    CR_Operator -->|manages| EventsPods
    CR_Operator -->|manages| PodsExec
    CR_Operator -->|manages| SvcAccounts
    CR_Operator -->|manages| Svcs
    CR_Operator -->|manages| Jobs
    CR_Operator -->|manages| JobsFinalizers
    CR_Operator -->|manages| JobsStatus
    CR_Operator -->|manages| AdmissionWH
    CR_Operator -->|manages| HPA
    CR_Operator -->|manages| RolesBindings
    CR_Operator -->|manages| VolcanoPG
    CR_Operator -->|manages| SchedulerPG
    CR_Operator -->|reads| APIServers
    CR_Operator -->|manages| NetPolicies

    %% Namespace Role → Secrets
    R_Webhook -->|manages| Secrets

    %% Aggregate roles (no direct binding shown - aggregated via labels)
    CR_Edit -.->|"aggregated access"| Jobs
    CR_View -.->|"read-only access"| Jobs

