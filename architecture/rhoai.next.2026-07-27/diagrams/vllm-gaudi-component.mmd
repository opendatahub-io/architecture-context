graph TB
    subgraph "vllm-gaudi Plugin (Python Package)"
        direction TB

        subgraph "Platform Backend"
            HpuPlatform["HpuPlatform<br/>(vllm.platform_plugins)"]
        end

        subgraph "Attention Backends"
            UnifiedAttn["HPUUnifiedAttention"]
            UnifiedMLA["HPUUnifiedMLA"]
            HPUMLA["HPUMLA"]
            AttnV1["HPUAttentionV1"]
        end

        subgraph "Custom Operators"
            FP8Ops["FP8 Ops"]
            FusedMoE["Fused MoE"]
            RotaryEmbed["Rotary Embedding"]
            OtherOps["Other HPU Ops"]
        end

        subgraph "Execution"
            HPUWorker["HPU Worker"]
            ModelRunner["HPU Model Runner"]
            ModelRegistry["HPU Model Registry"]
        end

        subgraph "Communication"
            HpuComm["HpuCommunicator<br/>(HCCL)"]
            NIXLConn["NIXL KV Connector<br/>(disaggregated prefill)"]
        end
    end

    subgraph "vLLM Core"
        PluginSystem["Plugin System<br/>(setuptools entry points)"]
        APIServer["OpenAI-compatible<br/>API Server"]
    end

    subgraph "Hardware"
        GaudiHPU["Intel Gaudi HPU<br/>(Habana Synapse AI 1.23.0)"]
    end

    %% Plugin registration
    PluginSystem -->|"register()"| HpuPlatform
    PluginSystem -->|"register_utils()"| HPUWorker
    PluginSystem -->|"register_ops()"| FP8Ops
    PluginSystem -->|"register_ops()"| FusedMoE
    PluginSystem -->|"register_ops()"| RotaryEmbed
    PluginSystem -->|"register_ops()"| OtherOps
    PluginSystem -->|"register_models()"| ModelRegistry

    %% Attention selection
    HpuPlatform -->|selects| UnifiedAttn
    HpuPlatform -->|selects| UnifiedMLA
    HpuPlatform -->|selects| HPUMLA
    HpuPlatform -->|selects| AttnV1

    %% Execution flow
    APIServer -->|inference| HpuPlatform
    HpuPlatform -->|directs| HPUWorker
    HPUWorker -->|manages| ModelRunner
    ModelRunner -->|loads from| ModelRegistry
    ModelRunner -->|uses| FP8Ops
    ModelRunner -->|uses| FusedMoE
    ModelRunner -->|uses| RotaryEmbed

    %% Hardware
    HPUWorker -->|executes on| GaudiHPU

    %% Communication
    HPUWorker -->|multi-device| HpuComm
    HPUWorker -->|KV cache transfer| NIXLConn

    %% Styling
    style HpuPlatform fill:#4a90e2,stroke:#333,color:#fff
    style APIServer fill:#e8e8e8,stroke:#333
    style PluginSystem fill:#e8e8e8,stroke:#333
    style GaudiHPU fill:#f5a623,stroke:#333,color:#fff
    style HPUWorker fill:#4a90e2,stroke:#333,color:#fff
    style ModelRunner fill:#4a90e2,stroke:#333,color:#fff
    style ModelRegistry fill:#4a90e2,stroke:#333,color:#fff
    style HpuComm fill:#7ed321,stroke:#333
    style NIXLConn fill:#7ed321,stroke:#333
    style UnifiedAttn fill:#9b59b6,stroke:#333,color:#fff
    style UnifiedMLA fill:#9b59b6,stroke:#333,color:#fff
    style HPUMLA fill:#9b59b6,stroke:#333,color:#fff
    style AttnV1 fill:#9b59b6,stroke:#333,color:#fff
    style FP8Ops fill:#e74c3c,stroke:#333,color:#fff
    style FusedMoE fill:#e74c3c,stroke:#333,color:#fff
    style RotaryEmbed fill:#e74c3c,stroke:#333,color:#fff
    style OtherOps fill:#e74c3c,stroke:#333,color:#fff
