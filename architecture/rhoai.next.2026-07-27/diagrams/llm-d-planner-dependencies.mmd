graph LR
    LLMDPlanner["llm-d-planner<br/>Backend"]

    %% External Runtime Dependencies
    LLMDPlanner -->|"LLM inference<br/>HTTPS, API Key"| OpenAI["OpenAI-compatible API"]
    LLMDPlanner -->|"LLM inference<br/>HTTPS, GCP SA"| VertexAI["Vertex AI"]
    LLMDPlanner -->|"Local LLM<br/>HTTP :11434"| Ollama["Ollama Server<br/>(Granite 3.3 2b)<br/>nvidia.com/gpu: 1"]
    LLMDPlanner -->|"Model metadata<br/>HTTPS, Bearer Token"| HFHub["HuggingFace Hub"]
    LLMDPlanner -->|"Benchmark data<br/>HTTPS, Bearer Token"| ModelCatalog["Model Catalog"]

    %% Data Dependencies
    LLMDPlanner -->|"Data persistence<br/>PostgreSQL :5432"| Postgres["PostgreSQL 16<br/>5Gi PVC"]

    %% Platform Dependencies
    LLMDPlanner -->|"GPU detection<br/>HTTPS :6443"| K8sAPI["Kubernetes API<br/>nodes list"]
    LLMDPlanner -->|"Model deployment<br/>HTTPS :6443"| KServe["KServe API<br/>serving.kserve.io"]
    LLMDPlanner -->|"CA bundle<br/>volume mount"| ServiceCA["OpenShift<br/>Service CA"]

    %% Inbound
    StreamlitUI["Streamlit UI<br/>:8501"] -->|"API calls<br/>HTTP :8000"| LLMDPlanner
    PlannerRoute["planner Route<br/>TLS Edge"] -->|"HTTP :8501"| StreamlitUI
    BackendRoute["planner-backend<br/>Route TLS Edge"] -->|"HTTP :8000"| LLMDPlanner

    %% Key Library Dependencies
    LLMDPlanner -.->|"framework"| FastAPI["FastAPI >=0.139.2"]
    LLMDPlanner -.->|"k8s client"| K8sClient["kubernetes >=36.0.2"]
    LLMDPlanner -.->|"AI SDK"| OpenAISDK["openai >=2.46.0"]
    LLMDPlanner -.->|"AI SDK"| Anthropic["anthropic >=0.116.0"]
    LLMDPlanner -.->|"ML models"| Transformers["transformers >=5.14.1"]
    LLMDPlanner -.->|"optimization"| LLMOptimizer["llm-optimizer<br/>(BentoML)"]

    %% Styles
    style LLMDPlanner fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OpenAI fill:#f5a623,stroke:#333
    style VertexAI fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style ModelCatalog fill:#f5a623,stroke:#333
    style Ollama fill:#7c3aed,stroke:#333,color:#fff
    style Postgres fill:#336791,stroke:#333,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333
    style ServiceCA fill:#7ed321,stroke:#333
    style StreamlitUI fill:#4a90e2,stroke:#333,color:#fff
    style PlannerRoute fill:#e8e8e8,stroke:#333
    style BackendRoute fill:#e8e8e8,stroke:#333
    style FastAPI fill:#ddd,stroke:#999
    style K8sClient fill:#ddd,stroke:#999
