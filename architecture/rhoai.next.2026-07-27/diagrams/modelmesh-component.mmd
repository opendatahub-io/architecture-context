graph TB
    subgraph ModelMeshPod["ModelMesh Pod (Sidecar Pattern)"]
        direction TB
        subgraph MMContainer["Container: mm"]
            ModelMeshApi["ModelMeshApi<br/>gRPC Server<br/>Port 8033"]
            ModelMesh["ModelMesh Core<br/>Model Lifecycle Manager"]
            SidecarMM["SidecarModelMesh<br/>Runtime Bridge"]
            DataplaneConfig["DataplaneApiConfig<br/>RPC Routing Config"]
            GrpcSupport["GrpcSupport<br/>gRPC Utilities"]
            HealthProbes["Health Probes<br/>Port 8089<br/>/live, /ready"]

            ModelMeshApi -->|routes requests| ModelMesh
            ModelMesh -->|delegates| SidecarMM
            ModelMeshApi -->|configures| DataplaneConfig
            ModelMeshApi -->|uses| GrpcSupport
        end

        subgraph RuntimeContainer["Collocated Model Runtime"]
            ModelRuntime["ModelRuntime<br/>gRPC Service"]
        end

        SidecarMM -->|"UDS: /tmp/mmesh/grpc.sock<br/>or TCP: 8085"| ModelRuntime
    end

    Client[External gRPC Client] -->|"gRPC/8033<br/>mm-model-id header"| ModelMeshApi

    subgraph DistributedCoordination["Distributed Coordination"]
        etcd["etcd<br/>KVTable (128 buckets)"]
        LeaderElection["Leader Election"]
    end

    ModelMesh -->|"model registry<br/>state tracking"| etcd
    ModelMesh -->|"cluster coordination"| LeaderElection

    subgraph MeshNetwork["Inter-Instance Mesh"]
        OtherInstance["Other ModelMesh<br/>Instances"]
    end

    ModelMesh -->|"litelinks (Thrift)<br/>request forwarding"| OtherInstance

    subgraph VModelLayer["VModel Aliasing"]
        VModel["VModel<br/>Zero-Downtime Updates"]
    end

    ModelMesh -->|"active/target<br/>model mappings"| VModel

    style ModelMeshApi fill:#4a90e2,stroke:#333,color:#fff
    style ModelMesh fill:#4a90e2,stroke:#333,color:#fff
    style SidecarMM fill:#4a90e2,stroke:#333,color:#fff
    style DataplaneConfig fill:#4a90e2,stroke:#333,color:#fff
    style GrpcSupport fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbes fill:#4a90e2,stroke:#333,color:#fff
    style ModelRuntime fill:#7ed321,stroke:#333,color:#fff
    style Client fill:#f5a623,stroke:#333,color:#fff
    style etcd fill:#e8e8e8,stroke:#333
    style LeaderElection fill:#e8e8e8,stroke:#333
    style OtherInstance fill:#b8d4f0,stroke:#333
    style VModel fill:#d5e8d4,stroke:#333
