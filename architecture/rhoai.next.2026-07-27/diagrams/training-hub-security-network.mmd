graph TB
    subgraph UserProcess["USER PROCESS (Notebook / Training Job Pod)"]
        direction TB

        subgraph Library["training_hub Library (In-process)"]
            direction TB
            API["Convenience API<br/>sft(), osft(), lora_sft(),<br/>lora_grpo(), gepa()"]
            Registry["AlgorithmRegistry"]
            API --> Registry
        end

        subgraph InProcess["In-process Backends"]
            ILab["instructlab-training"]
            MiniTrainer["rhai-innovation-<br/>mini-trainer"]
            Unsloth["unsloth"]
            GEPA_BE["gepa<br/>(env save/restore)"]
        end

        subgraph Subprocess["Subprocess Backends"]
            Verl["verl Backend<br/>subprocess → Ray/torchrun<br/>FSDP multi-GPU/node"]
            ART["openpipe-art Backend<br/>co-located vLLM engines"]
        end

        Registry --> ILab
        Registry --> MiniTrainer
        Registry --> Unsloth
        Registry --> GEPA_BE
        Registry --> Verl
        Registry --> ART
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress Only)"]
        LLM["LLM API Endpoint<br/>(OPENAI_API_BASE)<br/>HTTPS / TLS<br/>Auth: OPENAI_API_KEY"]
        MLflow["MLflow Tracking Server<br/>(MLFLOW_TRACKING_URI)<br/>HTTPS / TLS<br/>Auth: deployment-specific"]
        WandB["Weights &amp; Biases API<br/>(api.wandb.ai)<br/>HTTPS / TLS<br/>Auth: WANDB_API_KEY"]
    end

    subgraph GPU["GPU RESOURCES"]
        CUDA["CUDA GPUs<br/>Multi-GPU / Multi-Node"]
    end

    %% Egress flows
    ART -->|"HTTPS<br/>OPENAI_API_KEY<br/>Reward scoring"| LLM
    Verl -->|"HTTPS<br/>OPENAI_API_KEY<br/>GRPO completions"| LLM
    GEPA_BE -->|"HTTPS<br/>OPENAI_API_KEY"| LLM
    Library -.->|"HTTPS<br/>Metrics logging"| MLflow
    Library -.->|"HTTPS<br/>WANDB_API_KEY"| WandB

    %% GPU access
    InProcess -->|"CUDA"| CUDA
    Subprocess -->|"CUDA<br/>FSDP sharding"| CUDA

    %% No inbound
    NoInbound["⊘ No Inbound Network Surfaces<br/>Library, not a service<br/>0 Services, 0 Ingress, 0 CRDs"]

    %% Styling
    classDef library fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef subprocess fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef gpu fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef noinbound fill:#f9f9f9,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class API,Registry library
    class ILab,MiniTrainer,Unsloth,GEPA_BE backend
    class Verl,ART subprocess
    class LLM,MLflow,WandB external
    class CUDA gpu
    class NoInbound noinbound
