graph LR
    OVMS["OpenVINO Model Server<br/>(ServingRuntime)"]

    %% Platform Dependencies (KServe/RHOAI)
    OVMS -->|"deployed as<br/>ServingRuntime"| KServe["KServe<br/>serving.kserve.io/v1alpha1"]
    OVMS -->|"traffic routing<br/>mTLS enforcement"| Istio["Istio Service Mesh"]

    %% Runtime Dependencies
    OVMS -->|"inference execution<br/>model optimization"| OpenVINO["OpenVINO Toolkit<br/>(C++ Core)"]

    %% Go Module Dependencies (Client Libraries)
    subgraph GoModules["Go Client Library Dependencies"]
        Protobuf["google.golang.org/protobuf<br/>v1.36.10"]
        GRPC["google.golang.org/grpc<br/>v1.79.3"]
        GoCV["gocv.io/x/gocv<br/>v0.35.0"]
        Resize["github.com/nfnt/resize"]
        GolangProtobuf["github.com/golang/protobuf<br/>v1.5.4"]
    end

    OVMS -.->|"Go client libs"| Protobuf
    OVMS -.->|"Go client libs"| GRPC
    OVMS -.->|"Go client libs"| GoCV
    OVMS -.->|"Go client libs"| Resize
    OVMS -.->|"Go client libs"| GolangProtobuf

    %% External Services
    OVMS -->|"model artifacts<br/>storageUri mount"| ModelStorage["Model Storage<br/>(S3 / GCS / PVC)"]
    OVMS -->|"pod lifecycle"| K8sAPI["Kubernetes API"]

    %% Integration Points (consumers)
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>:8888"| OVMS
    InferenceService["InferenceService CR"] -->|"creates pod"| OVMS
    Dashboard["RHOAI Dashboard"] -.->|"UI management"| KServe

    %% Optional
    NGINXSidecar["NGINX mTLS Sidecar<br/>(Optional)"] -.->|"cert-based<br/>mutual auth"| OVMS

