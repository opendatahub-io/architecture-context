graph TB
    subgraph UserWorkload["USER WORKLOAD (Notebook / Script Pod)"]
        direction TB

        subgraph TrustyAIPkg["trustyai Python Package v0.6.1<br/>No inbound surfaces"]
            MetricsService["TrustyAIMetricsService<br/>(HTTP Client)<br/>Auth: Bearer Token<br/>(caller-delegated)"]
            APIClient["TrustyAIApi<br/>(Route Discovery)<br/>Auth: SA Token / kubeconfig"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES (OpenShift)"]
        direction TB

        subgraph NS_Monitoring["Namespace: openshift-monitoring"]
            Thanos["Thanos Querier<br/>Route: thanos-querier<br/>443/TCP HTTPS<br/>TLS (edge)"]
        end

        subgraph NS_Project["Namespace: {data-science-project}"]
            TrustyAISvc["TrustyAI Service<br/>Route: trustyai-service<br/>443/TCP HTTPS<br/>TLS (edge/reencrypt)"]
            ModelEP["Model Endpoint<br/>Route: {model-name}<br/>443/TCP HTTPS<br/>TLS (edge/reencrypt)"]
        end
    end

    subgraph ClusterCore["CLUSTER CORE"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>TLS<br/>SA Token / kubeconfig"]
    end

    %% Flows
    APIClient -->|"HTTPS/443<br/>TLS<br/>SA Token / kubeconfig<br/>Route discovery (v1/Route)"| K8sAPI
    MetricsService -->|"HTTPS/443<br/>TLS (Route)<br/>Bearer Token<br/>POST /data/upload<br/>GET /info<br/>POST /metrics/{metric}"| TrustyAISvc
    MetricsService -->|"HTTPS/443<br/>TLS (Route)<br/>Bearer Token<br/>GET /api/v1/query (PromQL)"| Thanos
    MetricsService -->|"HTTPS/443<br/>TLS (Route)<br/>Bearer Token<br/>POST /infer"| ModelEP

    %% Styling
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef core fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:1px

    class MetricsService,APIClient workload
    class Thanos,TrustyAISvc,ModelEP service
    class K8sAPI core
