graph LR
    LlamaStack["rhds-llama-stack-distribution<br/>Llama Stack Server"]

    %% Inference Providers (Remote)
    LlamaStack -->|"inference<br/>HTTP/gRPC"| vLLM["vLLM"]
    LlamaStack -->|"inference<br/>HTTPS/443"| Bedrock["AWS Bedrock"]
    LlamaStack -->|"inference<br/>HTTPS/443"| WatsonX["IBM WatsonX"]
    LlamaStack -->|"inference<br/>HTTPS/443"| AzureOAI["Azure OpenAI"]
    LlamaStack -->|"inference<br/>HTTPS/443"| VertexAI["Google Vertex AI"]
    LlamaStack -->|"inference<br/>HTTPS/443"| OpenAI["OpenAI"]

    %% Inline Providers
    LlamaStack -->|"embeddings<br/>in-process"| SentenceTransformers["sentence-transformers<br/>(Inline)"]
    LlamaStack -->|"vector search<br/>in-process"| FAISS["FAISS<br/>(Inline)"]

    %% Storage Dependencies
    LlamaStack -->|"state persistence<br/>TCP/5432"| PostgreSQL["PostgreSQL<br/>(kv_postgres + sql_postgres)"]
    LlamaStack -->|"vector store<br/>gRPC/HTTP"| Milvus["Milvus<br/>(Default)"]
    LlamaStack -->|"vector store<br/>TCP/5432"| PgVector["PgVector"]
    LlamaStack -->|"vector store<br/>HTTP/gRPC"| Qdrant["Qdrant"]

    %% Safety & Evaluation (Internal RHOAI)
    LlamaStack -->|"safety guardrails<br/>HTTP"| TrustyAI["TrustyAI FMS<br/>Orchestrator"]
    LlamaStack -->|"LM evaluation<br/>HTTP"| LMEval["TrustyAI LMEval"]
    LlamaStack -->|"RAG evaluation<br/>HTTP"| RAGAS["RAGAS"]
    LlamaStack -->|"security benchmark<br/>HTTP"| Garak["Garak"]

    %% Observability
    LlamaStack -.->|"telemetry<br/>OTLP (optional)"| OTELCollector["OTLP Collector"]

    %% Platform Dependencies
    Platform["RHOAI Platform"] -->|"deployment<br/>lifecycle mgmt"| LlamaStack
    Platform -->|"auth enforcement<br/>TLS termination"| LlamaStack

    %% Build Dependencies
    LlamaStack -->|"base image"| RHEL9["RHEL 9 UBI"]
    LlamaStack -->|"framework<br/>pip install"| LlamaStackFramework["llama-stack 0.5.0+rhai0<br/>(opendatahub-io/llama-stack)"]

    %% Optional Pipeline Integration
    KFPipelines["Kubeflow Pipelines"] -.->|"eval dispatch<br/>(optional)"| LlamaStack

