graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Telemetry Source"]
    end

    subgraph Services["KUBERNETES SERVICES (Network Boundary)"]
        PredSvc["prediction-service<br/>LoadBalancer<br/>80/TCP → 8001/TCP<br/>No Auth"]
        TrainSvcExt["training-service-external<br/>LoadBalancer<br/>8080/TCP → 8000/TCP<br/>No Auth"]
        TrainSvc["training-service<br/>ClusterIP<br/>8000/TCP → 8000/TCP<br/>Cluster-internal only"]
    end

    subgraph Workload["WORKLOAD (Application Pods)"]
        direction TB

        subgraph PredPods["Prediction Server (10 replicas)"]
            PredServer["prediction-server<br/>:8001/TCP HTTP<br/>FastAPI/Uvicorn<br/>No Auth Middleware<br/>Probes: /healthz, /readyz"]
        end

        subgraph TrainPods["Training Server (1 replica)"]
            TrainServer["training-server<br/>:8000/TCP HTTP<br/>FastAPI/Uvicorn<br/>No Auth Middleware<br/>Probes: /healthz, /readyz"]
        end
    end

    subgraph Storage["STORAGE"]
        PVC["training-models-pvc<br/>PersistentVolumeClaim<br/>Durable model storage"]
        EmptyDir["emptyDir volumes<br/>Ephemeral per-pod<br/>Local model cache"]
    end

    %% External flows
    Client -->|"HTTP/80<br/>No Encryption<br/>No Auth<br/>POST /predict, /predict/bulk"| PredSvc
    Client -->|"HTTP/8080<br/>No Encryption<br/>No Auth<br/>POST /add_training_data_bulk"| TrainSvcExt

    %% Service to pod flows
    PredSvc -->|"TCP/8001<br/>No Encryption"| PredServer
    TrainSvcExt -->|"TCP/8000<br/>No Encryption"| TrainServer
    TrainSvc -->|"TCP/8000<br/>No Encryption"| TrainServer

    %% Internal flows
    PredServer -->|"HTTP/8000<br/>No Encryption<br/>No Auth<br/>Model sync every 10s"| TrainSvc

    %% Storage flows
    TrainServer -->|"Read/Write<br/>Model artifacts"| PVC
    PredServer -->|"Read/Write<br/>Cached models"| EmptyDir

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class PredSvc,TrainSvcExt warning
    class TrainSvc service
    class PredServer,TrainServer workload
    class PVC,EmptyDir storage
