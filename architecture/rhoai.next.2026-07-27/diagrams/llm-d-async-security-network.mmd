graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph Workload["WORKLOAD NAMESPACE"]
            direction TB
            AsyncProc["llm-d-async<br/>Main Process<br/>/healthz, /readyz<br/>Auth: None (kubelet only)"]
            vLLM["vLLM Model Server<br/>Port 8000/TCP<br/>/health, /v1/models, /metrics<br/>Auth: Unknown"]
        end

        subgraph ClusterSvc["CLUSTER SERVICES"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+"]
        end
    end

    subgraph External["EXTERNAL SERVICES (Egress)"]
        direction TB
        Prometheus["Prometheus<br/>HTTP(S)<br/>Metric: inference_pool_<br/>average_queue_size"]
        GMP["Google Managed Prometheus<br/>HTTPS<br/>OAuth2"]
        Redis["Redis / Valkey<br/>RESP Protocol<br/>Sorted Set Queue"]
        PubSub["Google Cloud Pub/Sub<br/>gRPC, TLS<br/>OAuth2"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC"]
        GCM["Google Cloud Monitoring<br/>HTTPS, OAuth2"]
    end

    %% Kubelet probes (pod-local)
    K8sAPI -.->|"Kubelet probe<br/>HTTP (pod-local)<br/>No auth"| AsyncProc
    K8sAPI -.->|"Kubelet probe<br/>HTTP/8000<br/>Auth: Unknown"| vLLM

    %% Egress flows
    AsyncProc -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    AsyncProc -->|"HTTP(S)<br/>Metric queries"| Prometheus
    AsyncProc -->|"HTTPS<br/>OAuth2"| GMP
    AsyncProc -->|"RESP<br/>Sorted set ops<br/>redisotel traced"| Redis
    AsyncProc -->|"gRPC<br/>TLS<br/>OAuth2"| PubSub
    AsyncProc -->|"OTLP/gRPC<br/>Tracing"| OTel
    AsyncProc -->|"HTTPS<br/>OAuth2"| GCM

    %% Styling
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clustersvc fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef noservice fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray:5

    class AsyncProc,vLLM workload
    class K8sAPI clustersvc
    class Prometheus,GMP,Redis,PubSub,OTel,GCM external
