graph LR
    ArgoWF["Argo Workflows<br/>(Operator / Controller)"]

    %% Kubernetes API Dependencies
    ArgoWF -->|"HTTPS/6443<br/>CR lifecycle, RBAC"| K8sAPI["Kubernetes API<br/>k8s.io/client-go v0.32.2"]

    %% Authentication Dependencies
    ArgoWF -->|"OAuth2/OIDC SSO"| IdP["Identity Provider<br/>(go-oidc/v3, oauth2)"]

    %% Artifact Storage Dependencies
    ArgoWF -->|"HTTPS/443<br/>artifact storage"| S3["S3 / MinIO<br/>minio-go/v7"]
    ArgoWF -->|"HTTPS/443<br/>artifact storage"| GCS["Google Cloud Storage<br/>cloud.google.com/go/storage"]
    ArgoWF -->|"HTTPS/443<br/>artifact storage"| AzureBlob["Azure Blob Storage<br/>azure-sdk-for-go"]
    ArgoWF -->|"HTTPS/443<br/>artifact storage"| AliOSS["Alibaba OSS<br/>aliyun-oss-go-sdk"]
    ArgoWF -->|"custom port<br/>artifact storage"| HDFS["HDFS<br/>colinmarc/hdfs/v2"]

    %% Database Dependencies
    ArgoWF -->|"TCP/3306<br/>workflow archival"| MySQL["MySQL<br/>go-sql-driver/mysql"]
    ArgoWF -->|"TCP/5432<br/>workflow archival"| PostgreSQL["PostgreSQL<br/>upper/db/v4"]
    ArgoWF -->|"local file<br/>workflow archival"| SQLite["SQLite<br/>zombiezen.com/go/sqlite"]

    %% Observability Dependencies
    ArgoWF -->|"metrics export"| Prometheus["Prometheus<br/>client_golang v1.21.1"]
    ArgoWF -->|"telemetry"| OTel["OpenTelemetry<br/>otel v1.34.0"]

    %% Build / Runtime Dependencies
    ArgoWF -->|"gRPC multiplexing"| GRPCGateway["grpc-gateway<br/>v1.16.0"]
    ArgoWF -->|"gRPC framework"| GRPC["gRPC<br/>google.golang.org/grpc v1.71.1"]

    %% Integration: argo-events
    ArgoEvents["argo-events<br/>v1.9.6"] -.->|"event-driven<br/>workflows"| ArgoWF

