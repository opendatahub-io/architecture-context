graph TD
    subgraph Note["RBAC Status"]
        direction TB
        Info["No ClusterRoles or RoleBindings<br/>declared in extracted architecture.<br/><br/>RBAC rules are expected from<br/>deployment manifests<br/>(Helm chart, kustomize overlays)."]
    end

    subgraph Controllers["Controller Service Accounts"]
        SA["ServiceAccount<br/>(deployment-provided)"]
    end

    subgraph RequiredPermissions["Expected Kubernetes API Permissions"]
        direction TB
        IMR_R["llm-d.ai<br/>InferenceModelRewrite<br/>(get, list, watch)"]
        IO_R["llm-d.ai<br/>InferenceObjective<br/>(get, list, watch)"]
        IP_R["inference.networking.k8s.io<br/>InferencePool<br/>(get, list, watch)"]
        Pod_R["core<br/>Pods<br/>(get, list, watch)"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        EPC["EndpointPickerConfig<br/>llm-d.ai/v1alpha1<br/>Namespaced"]
        IMR["InferenceModelRewrite<br/>llm-d.ai/v1alpha2<br/>Namespaced"]
        IO["InferenceObjective<br/>llm-d.ai/v1alpha2<br/>Namespaced"]
    end

    subgraph AuthEndpoints["Endpoint Authentication"]
        ExtProc_Auth["ExternalProcessor gRPC<br/>Auth: None<br/>TLS: Optional"]
        Health_Auth["Health gRPC<br/>Auth: None<br/>TLS: Optional"]
        Metrics_Auth["Metrics HTTP<br/>Auth: Optional<br/>kube-apiserver delegated"]
        Coordinator_Auth["Coordinator HTTP<br/>Auth: None<br/>(upstream gateway)"]
        K8sAPI_Auth["Kubernetes API<br/>Auth: kubeconfig<br/>credential chain"]
    end

    SA -->|"needs"| IMR_R
    SA -->|"needs"| IO_R
    SA -->|"needs"| IP_R
    SA -->|"needs"| Pod_R

    IMR_R -.->|"watches"| IMR
    IO_R -.->|"watches"| IO

    style Info fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style SA fill:#4a90e2,color:#fff
    style EPC fill:#f5a623,color:#fff
    style IMR fill:#f5a623,color:#fff
    style IO fill:#f5a623,color:#fff
    style IMR_R fill:#7ed321,color:#fff
    style IO_R fill:#7ed321,color:#fff
    style IP_R fill:#7ed321,color:#fff
    style Pod_R fill:#7ed321,color:#fff
    style ExtProc_Auth fill:#e8e8e8,stroke:#333
    style Health_Auth fill:#e8e8e8,stroke:#333
    style Metrics_Auth fill:#e8e8e8,stroke:#333
    style Coordinator_Auth fill:#e8e8e8,stroke:#333
