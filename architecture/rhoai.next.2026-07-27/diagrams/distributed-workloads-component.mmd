graph TB
    subgraph DW["Distributed Workloads"]
        direction TB
        subgraph Training["Training Workloads"]
            SFT["SFT Benchmark<br/>MPI+DDP Fine-Tuning"]
            HPO["HPO RayTune<br/>Hyperparameter Optimization"]
            StableDiff["Stable Diffusion<br/>DreamBooth Training"]
        end

        subgraph RuntimeImages["Runtime Container Images"]
            CUDA["CUDA 13.0 Image<br/>py312-cuda130-torch210"]
            ROCm["ROCm 6.4 Image<br/>py312-rocm64-torch29"]
            Universal["Universal Image<br/>th06-cpu/cuda-torch210"]
        end

        subgraph TestHarness["Go Test Harness"]
            GoTests["Integration Tests<br/>Go 1.25"]
        end
    end

    subgraph SupportInfra["Supporting Infrastructure"]
        MinIO["MinIO<br/>S3-Compatible Storage<br/>9000/TCP, 9001/TCP"]
        NFS["NFS Server<br/>Shared Filesystem<br/>2049/TCP"]
    end

    %% Training workload interactions
    SFT -->|"submits TrainJob"| KubeflowTrainer["Kubeflow Trainer v2"]
    SFT -->|"stores artifacts"| MinIO
    HPO -->|"creates RayCluster"| KubeRay["KubeRay"]
    HPO -->|"uses storage"| MinIO
    StableDiff -->|"uses storage"| MinIO
    StableDiff -->|"uses shared fs"| NFS

    %% Runtime image dependencies
    CUDA -->|"bundles"| PyTorch["PyTorch 2.10"]
    CUDA -->|"bundles"| DeepSpeed["DeepSpeed 0.18"]
    CUDA -->|"bundles"| Transformers["Transformers 4.57"]

    %% Test harness interactions
    GoTests -->|"tests via"| KubeflowTrainer
    GoTests -->|"tests via"| KubeRay
    GoTests -->|"tests via"| Kueue["Kueue"]
    GoTests -->|"calls"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% External services
    RuntimeImages -->|"downloads models"| HFHub["HuggingFace Hub"]
    Training -->|"tracks experiments"| MLflow["MLflow"]
    Training -->|"registers models"| ModelRegistry["Model Registry"]

    %% Styling
    style DW fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style SFT fill:#5b9bd5,stroke:#333
    style HPO fill:#5b9bd5,stroke:#333
    style StableDiff fill:#5b9bd5,stroke:#333
    style CUDA fill:#6faed9,stroke:#333
    style ROCm fill:#6faed9,stroke:#333
    style Universal fill:#6faed9,stroke:#333
    style GoTests fill:#83c1e0,stroke:#333
    style MinIO fill:#f5a623,stroke:#333
    style NFS fill:#f5a623,stroke:#333
    style KubeflowTrainer fill:#7ed321,stroke:#333
    style KubeRay fill:#7ed321,stroke:#333
    style Kueue fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style MLflow fill:#7ed321,stroke:#333
    style ModelRegistry fill:#7ed321,stroke:#333
    style PyTorch fill:#e8e8e8,stroke:#333
    style DeepSpeed fill:#e8e8e8,stroke:#333
    style Transformers fill:#e8e8e8,stroke:#333
