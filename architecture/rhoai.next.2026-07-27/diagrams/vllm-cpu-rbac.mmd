graph TD
    subgraph "Application-Level Access Control"
        direction TB

        subgraph "Authentication"
            AuthMW["ASGI AuthenticationMiddleware<br/>(Production Server Only)"]
            BearerToken["Bearer Token<br/>Source: VLLM_API_KEY env var"]
        end

        subgraph "Protected Endpoints (47 HTTP + 1 WS)"
            direction LR
            OpenAI["/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models<br/>/v1/responses"]
            Anthropic["/v1/messages<br/>/v1/messages/count_tokens"]
            SageMaker["/invocations<br/>/ping"]
            Native["/generate<br/>/tokenize<br/>/detokenize<br/>/pooling"]
            Ops["/health<br/>/ready<br/>/readyz<br/>/load<br/>/version"]
            Mgmt["/v1/load_lora_adapter<br/>/v1/unload_lora_adapter<br/>/start_profile<br/>/stop_profile"]
        end

        subgraph "Unprotected (Warning)"
            DemoServer["Demo API Server<br/>(api_server.py)<br/>NO AUTH MIDDLEWARE<br/>Not for production"]
        end
    end

    subgraph "Kubernetes RBAC"
        NoRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>(Application Service,<br/>not an Operator)"]
    end

    subgraph "Environment Variables (Secrets)"
        direction LR
        RuntimeSecrets["Runtime Secrets<br/>VLLM_API_KEY<br/>S3_SECRET_ACCESS_KEY<br/>EXA_API_KEY<br/>MODELSCOPE_API_TOKEN"]
        BuildSecrets["Build-Time Secrets<br/>GH_TOKEN<br/>GITHUB_TOKEN"]
        BenchSecrets["Benchmark Secrets<br/>OPENAI_API_KEY<br/>VLLM_BENCH_MAX_TOKENS"]
        ConfigVars["Config (Not Secret)<br/>VLLM_USE_FASTOKENS<br/>VLLM_MAX_TOKENS_PER_EXPERT_FP4_MOE<br/>VLLM_SHARED_EXPERTS_STREAM_TOKEN_THRESHOLD<br/>VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD"]
    end

    BearerToken -->|"validates"| AuthMW
    AuthMW -->|"protects"| OpenAI
    AuthMW -->|"protects"| Anthropic
    AuthMW -->|"protects"| SageMaker
    AuthMW -->|"protects"| Native
    AuthMW -->|"protects"| Ops
    AuthMW -->|"protects"| Mgmt

    RuntimeSecrets -->|"provides token"| BearerToken

    style AuthMW fill:#e74c3c,color:#fff
    style BearerToken fill:#e74c3c,color:#fff
    style DemoServer fill:#f39c12,color:#fff
    style NoRBAC fill:#95a5a6,color:#fff
    style RuntimeSecrets fill:#e74c3c,color:#fff
    style BuildSecrets fill:#f39c12,color:#fff
    style BenchSecrets fill:#3498db,color:#fff
