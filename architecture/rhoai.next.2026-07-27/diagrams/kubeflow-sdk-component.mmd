graph TB
    subgraph UserEnv["User Environment (Notebook / Application)"]
        UserCode[User Code / Notebook]
    end

    subgraph KubeflowSDK["kubeflow Python SDK"]
        direction TB

        subgraph CommonMod["kubeflow.common"]
            BackendConfig["KubernetesBackendConfig<br/>(namespace, kubeconfig, context)"]
        end

        subgraph TrainerMod["kubeflow.trainer"]
            TrainerClient["Trainer Client<br/>(training orchestration)"]
            RHAIExt["trainer.rhai<br/>(RHOAI extensions,<br/>transformers integration)"]
            TrainerClient --> RHAIExt
        end

        subgraph OptimizerMod["kubeflow.optimizer"]
            OptimizerClient["Optimizer Client<br/>(Katib HPO)"]
        end

        subgraph SparkMod["kubeflow.spark"]
            SparkClient["Spark Client<br/>(SparkConnect workloads)"]
        end

        subgraph HubMod["kubeflow.hub"]
            HubClient["Hub Client<br/>(Model Registry)"]
        end

        TrainerClient --> BackendConfig
        OptimizerClient --> BackendConfig
        SparkClient --> BackendConfig
        HubClient --> BackendConfig
    end

    UserCode -->|import kubeflow| KubeflowSDK

    subgraph KubeAPIs["Kubeflow Operators (Kubernetes)"]
        TrainerOp["Kubeflow Trainer<br/>(TrainJob CRD)"]
        KatibOp["Kubeflow Katib<br/>(Experiment CRD)"]
        SparkOp["Spark Operator<br/>(SparkConnect CRD)"]
        ModelReg["Model Registry"]
    end

    subgraph K8s["Kubernetes"]
        K8sAPI["Kubernetes API Server"]
    end

    BackendConfig -->|kubernetes Python client| K8sAPI
    K8sAPI -->|CRD operations| TrainerOp
    K8sAPI -->|CRD operations| KatibOp
    K8sAPI -->|CRD operations| SparkOp
    HubClient -->|model artifacts| ModelReg

    subgraph OptionalBackends["Optional Backends"]
        Docker["Docker<br/>(local training)"]
        Podman["Podman<br/>(local training)"]
        S3["S3 Storage<br/>(checkpoints, datasets)"]
    end

    TrainerClient -.->|optional| Docker
    TrainerClient -.->|optional| Podman
    RHAIExt -.->|fsspec/s3fs| S3

    style KubeflowSDK fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style CommonMod fill:#5ba0f2,stroke:#333,color:#fff
    style TrainerMod fill:#5ba0f2,stroke:#333,color:#fff
    style OptimizerMod fill:#5ba0f2,stroke:#333,color:#fff
    style SparkMod fill:#5ba0f2,stroke:#333,color:#fff
    style HubMod fill:#5ba0f2,stroke:#333,color:#fff
    style BackendConfig fill:#6bb0ff,stroke:#333,color:#fff
    style TrainerClient fill:#6bb0ff,stroke:#333,color:#fff
    style RHAIExt fill:#6bb0ff,stroke:#333,color:#fff
    style OptimizerClient fill:#6bb0ff,stroke:#333,color:#fff
    style SparkClient fill:#6bb0ff,stroke:#333,color:#fff
    style HubClient fill:#6bb0ff,stroke:#333,color:#fff
    style UserCode fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style TrainerOp fill:#7ed321,stroke:#333,color:#fff
    style KatibOp fill:#7ed321,stroke:#333,color:#fff
    style SparkOp fill:#7ed321,stroke:#333,color:#fff
    style ModelReg fill:#7ed321,stroke:#333,color:#fff
    style Docker fill:#999,stroke:#333,color:#fff
    style Podman fill:#999,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
