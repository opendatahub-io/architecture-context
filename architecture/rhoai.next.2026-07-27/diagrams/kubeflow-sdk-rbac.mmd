graph TD
    subgraph UserIdentity["User Identity (Runtime)"]
        SA["ServiceAccount / kubeconfig User<br/>(provided by user at runtime)"]
    end

    subgraph AuthConfig["SDK Authentication Config"]
        BackendConfig["KubernetesBackendConfig<br/>- config_file (kubeconfig path)<br/>- context (kubeconfig context)<br/>- client.Configuration (explicit)<br/>- In-cluster SA token (auto)"]
    end

    subgraph RequiredPermissions["Required Kubernetes Permissions<br/>(must be granted to user's identity)"]
        direction TB

        subgraph TrainerPerms["Kubeflow Trainer CRDs"]
            TrainJob["trainer.kubeflow.org<br/>TrainJob<br/>get, list, watch,<br/>create, update, patch, delete"]
        end

        subgraph KatibPerms["Kubeflow Katib CRDs"]
            Experiment["katib.kubeflow.org<br/>Experiment<br/>get, list, watch,<br/>create, update, patch, delete"]
        end

        subgraph SparkPerms["Spark Operator CRDs"]
            SparkConnect["sparkoperator.k8s.io<br/>SparkConnect<br/>get, list, watch,<br/>create, update, patch, delete"]
        end

        subgraph CorePerms["Core Kubernetes Resources"]
            Pods["core<br/>Pods, Pods/log<br/>get, list, watch"]
            Events["core<br/>Events<br/>get, list, watch"]
        end
    end

    subgraph OptionalCredentials["Optional Credentials"]
        S3Creds["S3 / AWS Credentials<br/>- AWS_ACCESS_KEY_ID<br/>- AWS_SECRET_ACCESS_KEY<br/>(for fsspec/s3fs storage)"]
        RegistryCreds["Model Registry Credentials<br/>(depends on deployment)"]
    end

    SA -->|"authenticates via"| BackendConfig
    BackendConfig -->|"requires"| TrainJob
    BackendConfig -->|"requires"| Experiment
    BackendConfig -->|"requires"| SparkConnect
    BackendConfig -->|"requires"| Pods
    BackendConfig -->|"requires"| Events

    SA -.->|"optional"| S3Creds
    SA -.->|"optional"| RegistryCreds

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style BackendConfig fill:#5ba0f2,stroke:#333,color:#fff
    style TrainJob fill:#7ed321,stroke:#333,color:#fff
    style Experiment fill:#7ed321,stroke:#333,color:#fff
    style SparkConnect fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#f5a623,stroke:#333,color:#fff
    style Events fill:#f5a623,stroke:#333,color:#fff
    style S3Creds fill:#999,stroke:#333,color:#fff
    style RegistryCreds fill:#999,stroke:#333,color:#fff

    Note1["Note: kubeflow-sdk defines NO ClusterRoles<br/>or RoleBindings. All RBAC is delegated to<br/>the user's Kubernetes identity."]
    style Note1 fill:#fff3cd,stroke:#856404,color:#856404
