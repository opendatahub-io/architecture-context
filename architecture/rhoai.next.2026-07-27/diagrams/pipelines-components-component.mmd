graph TB
    subgraph "kfp-components Python Package"
        direction TB

        subgraph DataProcessing["Data Processing Domain"]
            AutoMLLoader["AutoML Tabular<br/>Data Loader"]
            DatasetDownload["Dataset Download<br/>(HuggingFace, S3, HTTP, PVC)"]
            ParseAndChunk["Parse & Chunk<br/>(Ray + Docling)"]
            SDG["Synthetic Data<br/>Generation (SDG Hub)"]
            AutoRAGData["AutoRAG Data<br/>Processing"]
            VectorDB["Vector DB<br/>Ingestion"]
        end

        subgraph DeploymentDomain["Deployment Domain"]
            KServeDeployment["KServe Model<br/>Serving"]
            ModelRegistryDeploy["Model Registry<br/>Deployment"]
            ServingConfig["Serving<br/>Configuration"]
        end

        subgraph EvaluationDomain["Evaluation Domain"]
            EvalHub["EvalHub / KServe<br/>Inference Evaluation"]
            LMEval["LM Eval<br/>Language Model Evaluation"]
        end

        subgraph TrainingDomain["Training Domain"]
            FineTuning["LoRA / SFT / OSFT<br/>Fine-Tuning"]
            AutoMLTrain["AutoML<br/>(AutoGluon)"]
            AutoRAGOpt["AutoRAG<br/>Optimization"]
            TrainingShared["Shared Training<br/>Utilities"]
            TrainingData["Training Data<br/>Handling"]
        end
    end

    KFP["Kubeflow Pipelines<br/>Orchestrator"] -->|orchestrates| DataProcessing
    KFP -->|orchestrates| DeploymentDomain
    KFP -->|orchestrates| EvaluationDomain
    KFP -->|orchestrates| TrainingDomain

    DatasetDownload -->|feeds data| FineTuning
    DatasetDownload -->|feeds data| AutoMLTrain
    ParseAndChunk -->|chunked docs| VectorDB
    SDG -->|synthetic data| FineTuning
    FineTuning -->|trained model| KServeDeployment
    AutoMLTrain -->|trained model| KServeDeployment
    KServeDeployment -->|registers| ModelRegistryDeploy
    EvalHub -->|evaluates| KServeDeployment

    ParseAndChunk -->|distributed via| Ray["CodeFlare / Ray<br/>Distributed Compute"]
    KServeDeployment -->|creates| KServeCR["serving.kserve.io<br/>InferenceService"]
    ParseAndChunk -->|optional quota| Kueue["Kueue<br/>Quota Management"]

    style DataProcessing fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style DeploymentDomain fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style EvaluationDomain fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style TrainingDomain fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style KFP fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Ray fill:#e0e0e0,stroke:#333
    style Kueue fill:#e0e0e0,stroke:#333
    style KServeCR fill:#f5a623,stroke:#333
