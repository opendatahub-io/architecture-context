graph TB
    subgraph Admission["ADMISSION LAYER (TLS, Fail Policy)"]
        WebhookSvc["kserve-webhook-server-service<br/>ClusterIP 443/TCP<br/>TLS (kserve-webhook-server-cert)<br/>Auth: Kubernetes Admission"]
    end

    subgraph ControllerPlane["CONTROLLER PLANE (Namespace: kserve)"]
        direction TB

        subgraph ManagerDeploy["kserve-controller-manager Deployment"]
            direction LR
            ManagerContainer["manager container<br/>kserve/kserve-controller:latest<br/>Health: 8081/TCP (unauth)<br/>Metrics: 8080/TCP (internal)"]
            RBACProxy["kube-rbac-proxy sidecar<br/>v0.18.0<br/>8443→8080 TLS termination<br/>Auth: TokenReview + SAR"]
            ManagerContainer ---|localhost| RBACProxy
        end

        MetricsSvc["kserve-controller-manager-metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS"]
        ManagerSvc["kserve-controller-manager-service<br/>ClusterIP 8443/TCP<br/>HTTPS"]

        LLMISVCCtrl["cmd/llmisvc Controller<br/>SA: $(llmisvc-serviceAccountName)<br/>Metrics: authn/authz filters<br/>HTTP/2 DISABLED<br/>(CVE-2023-44487, CVE-2023-39325)"]

        LocalModelCtrl["cmd/localmodel Controllers<br/>SA: kserve-localmodel-controller-manager<br/>PV/PVC management"]

        RouterEngine["cmd/router<br/>Routes: /splitter, /switch,<br/>/ensemble, /single<br/>HTTP"]

        AgentSidecar["cmd/agent Sidecar<br/>Reverse proxy<br/>Model pulling / Logging"]
    end

    subgraph K8sAPI["KUBERNETES API (6443/TCP HTTPS TLS 1.2+)"]
        APIServer["kube-apiserver<br/>Auth: ServiceAccount tokens<br/>Enforcement: RBAC<br/>12 CRDs managed"]
    end

    subgraph PlatformIntegrations["PLATFORM INTEGRATIONS"]
        direction TB
        Istio["Istio<br/>VirtualService CRUD"]
        Knative["Knative Serving<br/>v1 Service CRUD"]
        GatewayAPI["Gateway API<br/>HTTPRoute CRUD<br/>HTTPS TLS 1.2+"]
        KEDA["KEDA<br/>ScaledObject CRUD"]
        OTel["OpenTelemetry<br/>Collector CRUD"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Inbound scrape<br/>8443/TCP HTTPS"]
    end

    subgraph ExternalStorage["EXTERNAL SERVICES"]
        ObjStorage["Object Storage<br/>S3 / GCS / Azure Blob<br/>HTTP/HTTPS<br/>IAM / storage-config secret"]
    end

    %% Flows
    APIServer -->|"admission webhook<br/>443/TCP TLS<br/>Kubernetes admission"| WebhookSvc
    RBACProxy -->|"8443/TCP HTTPS<br/>TLS termination"| MetricsSvc
    RBACProxy -->|"8443/TCP HTTPS"| ManagerSvc

    ManagerContainer -->|"6443/TCP HTTPS<br/>TLS 1.2+<br/>SA: kserve-controller-manager"| APIServer
    LLMISVCCtrl -->|"6443/TCP HTTPS<br/>TLS 1.2+<br/>SA: llmisvc-sa"| APIServer
    LocalModelCtrl -->|"6443/TCP HTTPS<br/>TLS 1.2+<br/>SA: kserve-localmodel-controller-manager"| APIServer

    ManagerContainer -->|"via K8s API"| Istio
    ManagerContainer -->|"via K8s API"| Knative
    ManagerContainer -->|"via K8s API"| KEDA
    ManagerContainer -->|"via K8s API"| OTel
    LLMISVCCtrl -->|"via K8s API"| GatewayAPI

    Prometheus -->|"8443/TCP HTTPS<br/>kube-rbac-proxy auth"| RBACProxy
    Prometheus -.->|"authn/authz<br/>controller-runtime"| LLMISVCCtrl

    LocalModelCtrl -.->|"HTTP/HTTPS<br/>IAM credentials"| ObjStorage

    %% Styling
    classDef admission fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8sapi fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef proxy fill:#f5a623,stroke:#333,stroke-width:2px,color:#fff

    class WebhookSvc admission
    class ManagerContainer,LLMISVCCtrl,LocalModelCtrl,RouterEngine,AgentSidecar controller
    class APIServer k8sapi
    class Istio,Knative,GatewayAPI,KEDA,OTel platform
    class Prometheus monitoring
    class ObjStorage external
    class RBACProxy proxy
