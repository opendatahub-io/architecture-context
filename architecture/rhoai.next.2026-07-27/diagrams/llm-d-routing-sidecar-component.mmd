graph TB
    subgraph "llm-d-routing-sidecar (StatefulSet)"
        direction TB
        Proxy["Reverse Proxy<br/>Go HTTP Server<br/>Port 8080"]
        Allowlist["AllowlistValidator<br/>SSRF Protection"]
        PDRouter["P/D Router<br/>chatCompletionsHandler"]
        LRUCache["LRU Cached<br/>Reverse Proxy Handlers"]

        Proxy -->|intercepts requests| PDRouter
        PDRouter -->|validates targets| Allowlist
        PDRouter -->|uses| LRUCache
    end

    Client[External Client] -->|HTTPS| Route["OpenShift Route<br/>TLS Termination"]
    Route -->|HTTP/8080| Proxy

    Proxy -->|"GET /health"| HealthCheck["Health Check"]
    PDRouter -->|"POST /v1/chat/completions<br/>POST /v1/completions"| PrefillerTargets

    subgraph "Prefiller Discovery"
        InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
        PodWatcher["Pod Informers<br/>30s resync"]
        Allowlist -->|watches| InferencePool
        Allowlist -->|watches| PodWatcher
        InferencePool -->|label selectors| PodWatcher
    end

    subgraph "Downstream Targets"
        Decoder["Co-located vLLM Decoder<br/>Reverse Proxy"]
        PrefillerTargets["Prefiller Instances<br/>NIXL v2 / v1 / LMCache"]
    end

    Proxy -->|"catch-all /"| Decoder
    PDRouter -->|"P/D routing"| PrefillerTargets

    Allowlist -->|"pod IP allowlist"| PrefillerTargets

    K8sAPI["Kubernetes API<br/>6443/HTTPS"] -->|dynamic client| Allowlist

    style Proxy fill:#4a90e2,stroke:#333,color:#fff
    style Allowlist fill:#e74c3c,stroke:#333,color:#fff
    style PDRouter fill:#4a90e2,stroke:#333,color:#fff
    style LRUCache fill:#4a90e2,stroke:#333,color:#fff
    style Route fill:#ffe6cc,stroke:#d79b00
    style InferencePool fill:#f5a623,stroke:#333,color:#fff
    style PodWatcher fill:#f5a623,stroke:#333
    style Decoder fill:#7ed321,stroke:#333
    style PrefillerTargets fill:#7ed321,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style HealthCheck fill:#d5e8d4,stroke:#82b366
