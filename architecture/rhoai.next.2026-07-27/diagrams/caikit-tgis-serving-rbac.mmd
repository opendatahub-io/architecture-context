graph TD
    subgraph "Service Account"
        SA["Prometheus Service Account<br/>(prometheus-k8s)"]
    end

    subgraph "ClusterRole"
        CR["kserve-prometheus-k8s<br/>ClusterRole"]
    end

    subgraph "API Resources (core)"
        Endpoints["core<br/>endpoints"]
        Pods["core<br/>pods"]
        Services["core<br/>services"]
    end

    subgraph "Permitted Verbs"
        Verbs["get, list, watch"]
    end

    SA -->|"bound via ClusterRoleBinding<br/>(binding not extracted)"| CR
    CR -->|"get, list, watch"| Endpoints
    CR -->|"get, list, watch"| Pods
    CR -->|"get, list, watch"| Services

    subgraph "Secrets"
        StorageConfig["storage-config<br/>Type: Opaque<br/>Provisioned by: manifest<br/>Auto-Rotate: Unknown"]
    end

    subgraph "Purpose"
        MetricsDiscovery["Prometheus can discover<br/>and scrape metrics from<br/>caikit-tgis-serving pods"]
        S3Access["S3 credentials for<br/>model artifact storage"]
    end

    CR -.->|"enables"| MetricsDiscovery
    StorageConfig -.->|"provides"| S3Access

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style Endpoints fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style StorageConfig fill:#f8cecc,stroke:#b85450
    style MetricsDiscovery fill:#e8e8e8,stroke:#999
    style S3Access fill:#e8e8e8,stroke:#999

    subgraph "Security Gaps"
        direction LR
        Gap1["No role bindings extracted"]
        Gap2["No app-layer auth on<br/>inference endpoints"]
    end

    style Gap1 fill:#ffcccc,stroke:#cc0000
    style Gap2 fill:#ffcccc,stroke:#cc0000
