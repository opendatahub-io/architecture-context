graph TD
    subgraph AuthModel["MLServer Authentication Model"]
        direction TB
        Note["MLServer has no application-level RBAC.<br/>All authentication is platform-delegated<br/>to kube-rbac-proxy sidecar."]
    end

    subgraph PlatformAuth["Platform-Delegated Authentication"]
        KubeRBACProxy["kube-rbac-proxy<br/>(sidecar container)"]
    end

    subgraph AuthMechanism["Authentication Mechanism"]
        OAuth["OpenShift OAuth<br/>Token Validation"]
        SAToken["ServiceAccount<br/>Token Validation"]
    end

    subgraph ProtectedEndpoints["Protected gRPC Endpoints (16 total)"]
        direction TB

        subgraph InferenceService["GRPCInferenceService (11 RPCs)"]
            ModelInfer["ModelInfer"]
            ModelMetadata["ModelMetadata"]
            ModelReady["ModelReady"]
            ModelStreamInfer["ModelStreamInfer<br/>(streaming)"]
            RepositoryIndex1["RepositoryIndex"]
            RepoLoad1["RepositoryModelLoad"]
            RepoUnload1["RepositoryModelUnload"]
            RuntimeSecurity["RuntimeSecurity"]
            ServerLive["ServerLive"]
            ServerMetadata["ServerMetadata"]
            ServerReady["ServerReady"]
        end

        subgraph ModelRepoService["ModelRepositoryService (3 RPCs)"]
            RepositoryIndex2["RepositoryIndex"]
            RepoLoad2["RepositoryModelLoad"]
            RepoUnload2["RepositoryModelUnload"]
        end
    end

    subgraph SecurityQuery["Security Query Interface"]
        RuntimeSecRPC["RuntimeSecurity RPC<br/>dataplane.proto:26"]
        SecurityMode["Returns: PRODUCTION / DEVELOPMENT mode<br/>+ allowed model implementation paths"]
    end

    %% Flows
    KubeRBACProxy -->|"validates via"| OAuth
    KubeRBACProxy -->|"validates via"| SAToken
    KubeRBACProxy -->|"protects all"| InferenceService
    KubeRBACProxy -->|"protects all"| ModelRepoService

    RuntimeSecurity -->|"exposes"| RuntimeSecRPC
    RuntimeSecRPC -->|"returns"| SecurityMode

