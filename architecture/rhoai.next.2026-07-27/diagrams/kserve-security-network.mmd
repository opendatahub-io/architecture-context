graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph K8sAPILayer["KUBERNETES API SERVER"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforcement"]
    end

    subgraph ControlPlane["KSERVE CONTROL PLANE (ServiceAccount Auth)"]
        direction TB

        subgraph ModelServing["model-serving-api Service"]
            MSA["model-serving-api<br/>443/TCP → 8443<br/>TLS (service-ca)<br/>SA: model-serving-api"]
            MSA_Metrics["metrics: 8080/TCP"]
        end

        subgraph ODHModel["odh-model-controller"]
            ODH["odh-model-controller<br/>Webhook: 443/TCP → 9443<br/>TLS (service-ca)<br/>SA: odh-model-controller"]
            ODH_Metrics["metrics: 8080/TCP"]
        end

        subgraph KServeMgr["KServe Controller Manager"]
            KCM["kserve-controller-manager<br/>SA: kserve-controller-manager<br/>Controllers: ISVC, TM, IG"]
        end

        subgraph LLMMgr["LLMInferenceService Controller Manager"]
            LLMCM["llmisvc-controller-manager<br/>SA: llmisvc-serviceAccountName<br/>Metrics: HTTPS + authn/authz<br/>HTTP/2: disabled (CVE)"]
        end

        subgraph LocalModelMgr["LocalModel Controller Manager"]
            LMCM["localmodel-controller-manager<br/>SA: kserve-localmodel-controller-manager<br/>Controllers: LMCache, LMNSCache, LMNode"]
        end

        subgraph ModuleMgr["Kserve Module Controller"]
            KMC["kserve-module-controller-manager<br/>SA: kserve-module-controller-manager<br/>Platform integration layer"]
        end
    end

    subgraph DataPlane["KSERVE DATA PLANE (User Namespace)"]
        direction TB

        Agent["KServe Agent Sidecar<br/>Model pull + reverse proxy"]
        Router["InferenceGraph Router<br/>HTTP/HTTPS<br/>Auth: Bearer Token →<br/>TokenReview + SubjectAccessReview"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Internal)"]
        CertManager["cert-manager<br/>Certificate CRD CRUD"]
        GatewayAPI["Gateway API<br/>Gateway + HTTPRoute CRDs"]
        Prometheus["prometheus-operator<br/>ServiceMonitor CRD CRUD"]
        Istio["Istio Service Mesh<br/>VirtualService + DestinationRule"]
        KEDA["KEDA<br/>ScaledObject CRDs"]
        Knative["Knative Serving<br/>Service CRDs"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["AWS S3<br/>HTTPS/443<br/>AWS IAM"]
        GCS["Google Cloud Storage<br/>HTTPS/443<br/>GCP IAM"]
        Azure["Azure Blob<br/>HTTPS/443<br/>Azure AD"]
    end

    %% External to API
    Client -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig / Bearer"| K8sAPI

    %% API to Webhooks
    K8sAPI -->|"HTTPS/443→8443<br/>TLS (service-ca)<br/>Admission"| MSA
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (service-ca)<br/>Admission"| ODH

    %% Controllers to API
    KCM -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    LLMCM -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    LMCM -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    KMC -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Router auth
    Router -->|"HTTPS/6443<br/>TokenReview"| K8sAPI

    %% Data plane to storage
    Agent -->|"HTTPS/443<br/>AWS IAM"| S3
    Agent -->|"HTTPS/443<br/>GCP IAM"| GCS
    Agent -->|"HTTPS/443<br/>Azure AD"| Azure

    %% Control plane to platform
    KMC -->|"CRD CRUD<br/>via K8s API"| CertManager
    LLMCM -->|"CRD CRUD<br/>via K8s API"| GatewayAPI
    KCM -->|"CRD CRUD<br/>via K8s API"| Knative
    KCM -->|"CRD CRUD<br/>via K8s API"| KEDA
    KCM -->|"CRD CRUD<br/>via K8s API"| Istio
    ODH -->|"CRD CRUD<br/>via K8s API"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#dce6f1,stroke:#4472c4,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef dataplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class K8sAPI apiserver
    class MSA,MSA_Metrics,ODH,ODH_Metrics,KCM,LLMCM,LMCM,KMC controlplane
    class Agent,Router dataplane
    class CertManager,GatewayAPI,Prometheus,Istio,KEDA,Knative platform
    class S3,GCS,Azure externalservice
