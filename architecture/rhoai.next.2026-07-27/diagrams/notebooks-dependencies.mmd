graph LR
    Notebooks["RHOAI Notebooks<br/>(Container Images)"]

    %% Platform Dependencies (RHOAI Internal)
    Notebooks -->|"SDK: kfp 2.17.0<br/>pipeline submission"| KFP["Kubeflow Pipelines"]
    Notebooks -->|"SDK: codeflare-sdk 0.38.1<br/>distributed compute"| CodeFlare["CodeFlare / Ray"]
    Notebooks -->|"SDK: mlflow 3.14.0<br/>experiment tracking"| MLflow["MLflow"]
    Notebooks -->|"SDK: trustyai 0.6.3<br/>explainability"| TrustyAI["TrustyAI"]
    Notebooks -->|"SDK: kubeflow-training 1.9.3<br/>training jobs"| TrainingOp["Training Operator"]
    Notebooks -->|"extension: odh-elyra 5.0.1<br/>visual pipelines"| Elyra["ODH Elyra"]

    %% Infrastructure Dependencies
    Notebooks -->|"SDK: kubernetes 35.0.0<br/>resource management"| K8sAPI["Kubernetes API"]
    Notebooks -->|"SDK: openshift-client 1.0.18<br/>OCP resources"| OCPAPI["OpenShift API"]
    Notebooks -->|"SDK: boto3 1.43.50<br/>data/artifacts"| S3["S3-Compatible Storage"]

    %% Runtime Platform (manages notebooks externally)
    NotebookCtrl["RHOAI Notebook<br/>Controller"] -->|"manages lifecycle"| Notebooks
    Dashboard["RHOAI Dashboard"] -->|"creates/manages"| Notebooks
    OAuthProxy["OAuth Proxy"] -.->|"sidecar: AuthN"| Notebooks

    %% ML Framework Dependencies
    Notebooks -->|"ML: torch 2.11.0"| PyTorch["PyTorch"]
    Notebooks -->|"ML: tensorflow 2.21.0+redhat"| TensorFlow["TensorFlow"]
    Notebooks -->|"ML: scikit-learn 1.9.0"| SKLearn["scikit-learn"]
    Notebooks -->|"LLM: transformers 5.10.1<br/>llmcompressor 0.12.0"| HuggingFace["HuggingFace<br/>Transformers"]

    %% GPU Runtime Dependencies
    Notebooks -.->|"GPU: CUDA runtime"| CUDA["NVIDIA CUDA"]
    Notebooks -.->|"GPU: ROCm 7.14"| ROCm["AMD ROCm"]

    %% Build Dependencies (CI only)
    Notebooks -->|"build: buildinputs,<br/>check-payload (Go)"| Konflux["Konflux CI/CD"]
    Notebooks -->|"build: moby/buildkit 0.29.0"| BuildKit["BuildKit"]

    %% Core Runtime
    Notebooks -->|"runtime"| JupyterLab["JupyterLab 4.6.1"]
    Notebooks -->|"runtime"| Python["Python 3.12<br/>(UBI9)"]

