graph LR
    KRP["kube-rbac-proxy<br/>Sidecar Proxy"]

    %% Kubernetes API Dependencies (Critical)
    KRP -->|"TokenReview<br/>authn delegation"| K8sAuthN["Kubernetes API<br/>authentication.k8s.io/v1"]
    KRP -->|"SubjectAccessReview<br/>authz delegation"| K8sAuthZ["Kubernetes API<br/>authorization.k8s.io/v1"]

    %% Optional External Dependencies
    KRP -.->|"OIDC token validation<br/>(if configured)"| OIDCProvider["OIDC Provider"]

    %% Upstream Service (Same Pod)
    KRP -->|"reverse proxy<br/>localhost HTTP/h2c"| Upstream["Upstream Service<br/>(metrics endpoint)"]

    %% Go Module Dependencies (Key Libraries)
    KRP -->|"CLI framework"| Cobra["spf13/cobra<br/>v1.10.2"]
    KRP -->|"lifecycle mgmt"| OklogRun["oklog/run<br/>v1.2.0"]
    KRP -->|"K8s client"| ClientGo["k8s.io/client-go<br/>v0.35.2"]
    KRP -->|"API types"| K8sAPI["k8s.io/api<br/>v0.35.2"]
    KRP -->|"API server libs"| APIServer["k8s.io/apiserver<br/>v0.35.2"]
    KRP -->|"runtime"| GoRuntime["Go 1.26"]

    %% Internal Platform Dependencies
    KRP -.->|"sidecar for"| ODHProxy["odh-kube-auth-proxy<br/>(RHOAI platform)"]

    %% Styling
    style KRP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAuthN fill:#f5a623,stroke:#333,color:#fff
    style K8sAuthZ fill:#f5a623,stroke:#333,color:#fff
    style OIDCProvider fill:#999,stroke:#333,color:#fff
    style Upstream fill:#7ed321,stroke:#333,color:#fff
    style Cobra fill:#e8e8e8,stroke:#333
    style OklogRun fill:#e8e8e8,stroke:#333
    style ClientGo fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style GoRuntime fill:#e8e8e8,stroke:#333
