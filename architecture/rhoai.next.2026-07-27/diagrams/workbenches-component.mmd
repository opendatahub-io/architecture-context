graph TB
    subgraph "Workbenches Operator"
        subgraph "Manager Binary (manager)"
            WC[Workspace Controller]
            WKC[WorkspaceKind Controller]
            Webhook[Webhook Server<br/>Port 9443/HTTPS]
        end

        subgraph "Backend Binary (backend)"
            API[REST API Server<br/>Port 4000/HTTP]
            AuthMW[requireAuth Middleware<br/>SubjectAccessReview]
            API --> AuthMW
        end
    end

    %% CRDs
    User[User / Client] -->|creates/updates| WorkspaceCR[Workspace CR<br/>kubeflow.org/v1beta1<br/>Namespaced]
    User -->|creates/updates| WorkspaceKindCR[WorkspaceKind CR<br/>kubeflow.org/v1beta1<br/>Cluster-scoped]

    %% Controller watches
    WorkspaceCR -->|watched by| WC
    WorkspaceKindCR -->|watched by| WKC
    WorkspaceKindCR -->|watched by| WC
    WorkspaceCR -->|watched by| WKC

    %% Owned resources
    WC -->|owns| StatefulSet[StatefulSet]
    WC -->|owns| Service[Service]
    WC -->|owns| VirtualService[VirtualService]

    %% Webhook validation
    WorkspaceCR -->|validated by| Webhook
    WorkspaceKindCR -->|validated by| Webhook

    %% Backend interactions
    API -->|reads| WorkspaceCR
    API -->|reads| WorkspaceKindCR
    API -->|CRUD| PVC[PersistentVolumeClaim]
    API -->|reads| Namespace[Namespace]
    API -->|reads| StorageClass[StorageClass]

    %% External dependencies
    WC -->|traffic routing| Istio[Istio]
    Webhook -->|TLS certs| CertManager[cert-manager]

    %% Ingress
    Gateway[Istio kubeflow-gateway<br/>Port 443/HTTPS] -->|routes to| API
    Gateway -->|routes to| Webhook

    %% Styling
    style WC fill:#4a90e2,color:#fff
    style WKC fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style API fill:#4a90e2,color:#fff
    style AuthMW fill:#4a90e2,color:#fff
    style WorkspaceCR fill:#f5a623,color:#fff
    style WorkspaceKindCR fill:#f5a623,color:#fff
    style StatefulSet fill:#7ed321,color:#fff
    style Service fill:#7ed321,color:#fff
    style VirtualService fill:#7ed321,color:#fff
    style PVC fill:#7ed321,color:#fff
    style Istio fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style Namespace fill:#7ed321,color:#fff
    style StorageClass fill:#7ed321,color:#fff
