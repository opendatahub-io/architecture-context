graph LR
    DSPO["Data Science Pipelines<br/>Operator"]

    %% Core Framework Dependencies
    DSPO -->|"operator framework"| ControllerRuntime["controller-runtime<br/>0.23.3"]
    DSPO -->|"dynamic manifest<br/>provisioning"| Manifestival["manifestival<br/>0.7.2"]
    DSPO -->|"Go runtime"| GoRuntime["Go 1.26"]

    %% Internal ODH Platform Dependencies
    DSPO -->|"CRD Watch<br/>(read-only)"| KServe["KServe<br/>InferenceService"]
    DSPO -->|"CRD Watch<br/>(read-only)"| MLflow["MLflow<br/>(mlflow.opendatahub.io)"]
    DSPO -->|"CRD CRUD"| KubeflowNB["Kubeflow Notebooks<br/>(kubeflow.org)"]
    DSPO -->|"CRD CRUD<br/>ServiceMonitors"| PromOp["prometheus-operator"]
    DSPO -->|"Go library"| MLflowOperator["mlflow-operator API"]

    %% Provisioned Components
    DSPO -->|"provisions via<br/>manifestival"| ArgoWorkflows["Argo Workflow Engine<br/>(14 CRDs, RBAC)"]

    %% Kubernetes / OpenShift Platform
    DSPO -->|"resource CRUD<br/>6443/HTTPS"| K8sAPI["Kubernetes API"]
    DSPO -->|"image streams"| OSImageStreams["OpenShift<br/>Image Streams"]
    DSPO -->|"route mgmt"| OSRoutes["OpenShift Routes"]

    %% Key Go Libraries
    DSPO -.->|"S3 client"| MinIO["minio-go v7"]
    DSPO -.->|"MySQL driver"| MySQL["go-sql-driver/mysql"]
    DSPO -.->|"metrics"| PromClient["prometheus/client_golang"]
    DSPO -.->|"container registry"| GoContainerReg["go-containerregistry"]
    DSPO -.->|"port forwarding"| Forwarder["anthhub/forwarder"]

    %% CRDs managed by other operators that DSPO interacts with
    DSPO -.->|"CRD CRUD"| Seldon["Seldon Deployments<br/>(machinelearning.seldon.io)"]
    DSPO -.->|"CRD CRUD"| Ray["Ray<br/>(rayclusters, rayjobs)"]
    DSPO -.->|"CRD CRUD"| CodeFlare["CodeFlare AppWrappers<br/>(workload.codeflare.dev)"]

    %% Styling
    style DSPO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Framework (blue-grey)
    style ControllerRuntime fill:#607d8b,stroke:#333,color:#fff
    style Manifestival fill:#607d8b,stroke:#333,color:#fff
    style GoRuntime fill:#607d8b,stroke:#333,color:#fff

    %% Internal ODH (green)
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style MLflow fill:#7ed321,stroke:#333,color:#fff
    style KubeflowNB fill:#7ed321,stroke:#333,color:#fff
    style PromOp fill:#7ed321,stroke:#333,color:#fff
    style MLflowOperator fill:#7ed321,stroke:#333,color:#fff

    %% Provisioned (orange)
    style ArgoWorkflows fill:#e96d3f,stroke:#333,color:#fff

    %% External platform (light grey)
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OSImageStreams fill:#999,stroke:#333,color:#fff
    style OSRoutes fill:#999,stroke:#333,color:#fff

    %% Go libraries (light blue)
    style MinIO fill:#b3d9ff,stroke:#333
    style MySQL fill:#b3d9ff,stroke:#333
    style PromClient fill:#b3d9ff,stroke:#333
    style GoContainerReg fill:#b3d9ff,stroke:#333
    style Forwarder fill:#b3d9ff,stroke:#333

    %% External CRDs (amber)
    style Seldon fill:#f5a623,stroke:#333
    style Ray fill:#f5a623,stroke:#333
    style CodeFlare fill:#f5a623,stroke:#333
