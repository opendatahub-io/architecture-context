graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformIngress["PLATFORM INGRESS (DMZ)"]
        Gateway["KServe / Istio Gateway<br/>TLS Termination<br/>Platform AuthN/AuthZ"]
    end

    subgraph ServingPod["SERVING POD (Trust Boundary)"]
        direction TB

        subgraph CaikitContainer["Caikit Runtime Container"]
            GRPCServer["RuntimeGRPCServer<br/>TCP: configurable port<br/>TLS/mTLS (configurable)"]
            UDS["Unix Domain Socket<br/>(insecure binding)"]
            HTTPServer["HTTP Server (FastAPI)<br/>(optional)"]
            MetricsSrv["Prometheus Metrics<br/>PromServerInterceptor"]

            subgraph ExternalServices["External-Facing gRPC Services"]
                Health["Health"]
                Predict["GlobalPredictServicer<br/>(Inference)"]
                Train["GlobalTrainServicer<br/>(Training)"]
                Info["InfoServicer"]
            end

            subgraph PodLocalServices["Pod-Local gRPC Services (Unix Socket)"]
                MRLoad["mmesh.ModelRuntime/*<br/>load, unload, modelSize,<br/>predictModelSize, runtimeStatus"]
                MMesh["mmesh.ModelMesh/*<br/>register, unregister, setVModel,<br/>deleteVModel, getModelStatus,<br/>getVModelStatus, ensureLoaded"]
                ProcessRun["processproto.Process/Run"]
            end
        end

        subgraph ModelMeshContainer["ModelMesh Container (Sidecar)"]
            ModelMesh["ModelMesh<br/>Model Lifecycle Management<br/>External TLS/Auth Boundary"]
        end
    end

    subgraph ModelStorage["MODEL STORAGE (External)"]
        Storage["Model Storage<br/>Directory / ZIP / Bytes<br/>Config-dependent Auth"]
    end

    %% Flows
    Client -->|"gRPC<br/>TLS 1.3 (platform)"| Gateway
    Gateway -->|"gRPC<br/>TLS/mTLS (configurable)<br/>Client cert (when mTLS)"| GRPCServer
    GRPCServer --- ExternalServices
    UDS --- PodLocalServices

    ModelMesh <-->|"Unix Domain Socket<br/>gRPC (insecure)<br/>Pod-local auth (platform-delegated)"| UDS

    GRPCServer -->|"Model load requests"| Storage

    GRPCServer -->|"metrics"| MetricsSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef trustboundary fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef sidecar fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef podlocal fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Client external
    class Gateway ingress
    class GRPCServer,UDS,HTTPServer,MetricsSrv trustboundary
    class ModelMesh sidecar
    class Storage storage
    class Health,Predict,Train,Info service
    class MRLoad,MMesh,ProcessRun podlocal
