graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph OpenShiftChart["rhai-on-openshift-chart (v3.4.0)"]
            OLMSubs["OLM Subscriptions<br/>(12 Dependency Operators)"]
            DSC["DataScienceCluster CR<br/>(14 RHOAI Components)"]
            DSCInit["DSCInitialization CR"]
        end

        subgraph XKSChart["rhai-on-xks-chart (v3.5.0-ea.2)"]
            DepCharts["Dependency Helm Charts<br/>(cert-manager, gateway-api,<br/>lws, sail-operator)"]
            CloudMgr["CloudManager Operator<br/>Deployment"]
            KubeEngine["KubernetesEngine CR"]
        end

        subgraph KustomizeOverlays["Kustomize Overlays"]
            Grouped["Grouped Overlays"]
            Granular["Granular Overlays"]
        end

        subgraph PostInstallHooks["Post-Install Hooks (Shell)"]
            CreateGW["create-gateway.sh<br/>(Inference Gateway)"]
            CreateMaaSGW["create-maas-gateway.sh<br/>(MaaS Gateway)"]
        end
    end

    subgraph GitOpsTools["GitOps Delivery"]
        ArgoCD[ArgoCD]
        Flux[Flux]
    end

    subgraph TargetPlatforms["Target Platforms"]
        OpenShift["OpenShift<br/>(OLM-based)"]
        AWS["AWS (xKS)"]
        Azure["Azure (xKS)"]
        CoreWeave["CoreWeave (xKS)"]
    end

    subgraph RHOAIComponents["RHOAI Components (14)"]
        KServe[KServe]
        Dashboard[Dashboard]
        Ray[Ray]
        Trainer[Trainer]
        Kueue[Kueue]
        TrustyAI[TrustyAI]
        Workbenches[Workbenches]
        ModelReg[Model Registry]
        Pipelines[AI Pipelines]
        Feast[Feast Operator]
        OGX[OGX]
        MLflow[MLflow]
        Spark[Spark]
        TrainingOp[Training Operator]
    end

    subgraph InfraServices["Infrastructure Dependencies"]
        Istio["Istio / Gateway API"]
        CertMgr["cert-manager"]
        Authorino["Kuadrant / Authorino"]
    end

    %% GitOps delivery flow
    ArgoCD -->|"kubectl apply -k /<br/>helm install"| OpenShiftChart
    ArgoCD -->|"kubectl apply -k /<br/>helm install"| XKSChart
    Flux -->|"kubectl apply -k /<br/>helm install"| OpenShiftChart
    Flux -->|"kubectl apply -k /<br/>helm install"| XKSChart

    %% Platform targeting
    OpenShiftChart -->|deploys to| OpenShift
    XKSChart -->|deploys to| AWS
    XKSChart -->|deploys to| Azure
    XKSChart -->|deploys to| CoreWeave

    %% Component management
    DSC -->|"managementState control"| RHOAIComponents
    OLMSubs -->|"tri-state:<br/>auto/true/false"| InfraServices

    %% xKS dependencies
    DepCharts -->|bundles| CertMgr
    DepCharts -->|bundles| Istio
    CloudMgr -->|"Managed/Unmanaged<br/>policy"| InfraServices

    %% Post-install hooks
    XKSChart -->|runs| PostInstallHooks
    CreateGW -->|configures| Istio
    CreateMaaSGW -->|configures| Authorino

    %% Styling
    style OpenShiftChart fill:#4a90e2,stroke:#333,color:#fff
    style XKSChart fill:#4a90e2,stroke:#333,color:#fff
    style KustomizeOverlays fill:#b8d4f0,stroke:#333
    style PostInstallHooks fill:#b8d4f0,stroke:#333
    style ArgoCD fill:#e8e8e8,stroke:#333
    style Flux fill:#e8e8e8,stroke:#333
    style OpenShift fill:#ee0000,stroke:#333,color:#fff
    style AWS fill:#ff9900,stroke:#333
    style Azure fill:#0078d4,stroke:#333,color:#fff
    style CoreWeave fill:#6c63ff,stroke:#333,color:#fff
    style Istio fill:#466bb0,stroke:#333,color:#fff
    style CertMgr fill:#f5a623,stroke:#333
    style Authorino fill:#f5a623,stroke:#333
