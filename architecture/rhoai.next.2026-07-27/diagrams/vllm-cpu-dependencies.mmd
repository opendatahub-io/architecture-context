graph LR
    vllmcpu["vllm-cpu<br/>CPU Inference Server"]

    %% Runtime Dependency
    vllmcpu -->|"runtime"| Python["Python >=3.10, <3.15"]

    %% Outbound External Services
    vllmcpu -->|"model download<br/>HTTPS/443"| S3["S3 Storage"]
    vllmcpu -->|"model download<br/>HTTPS/443"| ModelScope["ModelScope Hub"]
    vllmcpu -->|"web search (MCP)<br/>HTTPS/443"| Exa["Exa Search API"]
    vllmcpu -->|"code sandbox (MCP)<br/>Unix socket"| Docker["Docker Daemon"]

    %% Potential RHOAI Platform Consumers
    KServe["KServe"] -.->|"routes inference<br/>HTTP/8000"| vllmcpu
    Dashboard["ODH Dashboard"] -.->|"deployment mgmt"| vllmcpu
    ModelMesh["ModelMesh"] -.->|"model serving"| vllmcpu

    %% API Consumers
    APIClients["API Clients<br/>(OpenAI/Anthropic SDK)"] -->|"inference<br/>HTTP(S)/8000"| vllmcpu

    style vllmcpu fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Python fill:#306998,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333
    style ModelScope fill:#f5a623,stroke:#333
    style Exa fill:#f5a623,stroke:#333
    style Docker fill:#f5a623,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style ModelMesh fill:#7ed321,stroke:#333
    style APIClients fill:#e8e8e8,stroke:#333
