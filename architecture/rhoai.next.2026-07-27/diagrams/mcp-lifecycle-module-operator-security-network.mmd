graph TB
    subgraph Probes["KUBERNETES PROBES (Unauthenticated)"]
        Kubelet["Kubelet"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (SYSTEM_NAMESPACE)"]
        direction TB
        Controller["mcp-lifecycle-module-operator<br/>controller-manager<br/>SA: mcp-lifecycle-module-operator-controller-manager<br/>Non-root | RO filesystem | RuntimeDefault seccomp"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC Enforced"]
        APIServer["OpenShift APIServer<br/>config.openshift.io<br/>TLS Config Source"]
    end

    subgraph ManagedResources["MANAGED RESOURCES"]
        direction TB
        MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>Cluster-scoped singleton<br/>components.platform.opendatahub.io"]
        MCPServer["MCPServer CR<br/>mcp.x-k8s.io"]
        Operand["Operand Resources<br/>Deployments, Services,<br/>RBAC, NetworkPolicies"]
    end

    subgraph Monitoring["MONITORING"]
        PrometheusOp["prometheus-operator<br/>ServiceMonitor<br/>monitoring.coreos.com"]
    end

    %% Probe flows
    Kubelet -->|"HTTP/8081<br/>No encryption<br/>No auth<br/>/healthz, /readyz"| Controller

    %% Control plane flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>Watch, CRUD, SSA"| K8sAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>get, list, watch"| APIServer

    %% Managed resource flows (via K8s API)
    K8sAPI -.->|"Watch events"| MCPLifecycleOpCR
    K8sAPI -.->|"SSA Apply"| MCPServer
    K8sAPI -.->|"SSA Apply / GC Delete"| Operand

    %% Monitoring
    Controller -->|"HTTPS<br/>TLS 1.2+<br/>CRD CRUD"| PrometheusOp

    %% Leader election
    Controller -->|"HTTPS/6443<br/>Lease: coordination.k8s.io"| K8sAPI

    %% Styling
    classDef probe fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Kubelet probe
    class Controller operator
    class K8sAPI,APIServer controlplane
    class MCPLifecycleOpCR,MCPServer,Operand managed
    class PrometheusOp monitoring
