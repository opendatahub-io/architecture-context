graph LR
    KServe["KServe<br/>(Kubernetes Operator)"]

    %% External Infrastructure Dependencies
    KServe -->|"traffic mgmt<br/>(conditional)"| Istio["Istio<br/>VirtualService,<br/>DestinationRule,<br/>EnvoyFilter"]
    KServe -->|"serverless<br/>autoscaling"| Knative["Knative Serving<br/>v0.48.1+"]
    KServe -->|"event-driven<br/>autoscaling"| KEDA["KEDA<br/>v2.18.0+<br/>ScaledObject"]
    KServe -->|"TLS certificates"| CertManager["cert-manager<br/>Certificate,<br/>ClusterIssuer"]
    KServe -->|"ingress routing"| GatewayAPI["Gateway API<br/>v1.5.1+<br/>Gateway, HTTPRoute"]
    KServe -->|"monitoring"| PrometheusOp["prometheus-operator<br/>ServiceMonitor,<br/>PodMonitor"]
    KServe -->|"cluster ops<br/>6443/HTTPS"| K8sAPI["Kubernetes API"]

    %% External Service Dependencies
    KServe -->|"model storage<br/>HTTPS/443"| S3["AWS S3"]
    KServe -->|"model storage<br/>HTTPS/443"| GCS["Google Cloud<br/>Storage"]
    KServe -->|"model storage<br/>HTTPS/443"| AzureBlob["Azure Blob<br/>Storage"]

