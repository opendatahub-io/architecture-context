    KServe -->|"dashboard config"| ODHDashboard["ODH Dashboard<br/>Config"]
    KServe -->|"OLM status"| OLM["OLM<br/>Subscriptions"]

    %% Go Library Dependencies
    KServe -.->|"Go library"| ODHPlatformUtils["odh-platform-<br/>utilities"]
    KServe -.->|"Go library"| GIEExtension["gateway-api-<br/>inference-extension"]
    KServe -.->|"Go library"| LLMD["llm-d-workload-<br/>variant-autoscaler"]

    %% Consumers of KServe
    subgraph Consumers["Components that integrate with KServe"]
        OpenShiftRoutes["OpenShift Routes<br/>(route.openshift.io)"]
        Kuadrant["Kuadrant<br/>AuthPolicy"]
        OTel["OpenTelemetry<br/>Collector"]
        LWS["LeaderWorkerSet<br/>(leaderworkerset.x-k8s.io)"]
        InferencePoolGIE["Inference Pool<br/>(inference.networking.k8s.io)"]
    end
    KServe -->|"route mgmt"| OpenShiftRoutes
    KServe -->|"auth policies"| Kuadrant
    KServe -->|"observability"| OTel
    KServe -->|"multi-worker<br/>serving"| LWS
    KServe -->|"inference<br/>routing"| InferencePoolGIE

