graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (KServe Gateway)"]
        Gateway["KServe Ingress Gateway<br/>443/TCP<br/>TLS 1.2+ Termination"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS)"]
        direction TB

        subgraph IstioProxy["Istio Sidecar"]
            Sidecar["Istio Sidecar Proxy<br/>mTLS enforcement<br/>Policy enforcement"]
        end

        subgraph OVMSPod["OVMS Pod (kserve-container)"]
            direction TB
            OVMS_REST["REST API Server<br/>Port 8888/TCP<br/>No built-in auth"]
            OVMS_GRPC["gRPC API Server<br/>Port 8001/TCP<br/>No built-in auth"]
            OVMS_Metrics["Metrics Endpoint<br/>/metrics :8888"]
            OVMS_Engine["OpenVINO Engine"]

            OVMS_REST --> OVMS_Engine
            OVMS_GRPC --> OVMS_Engine
        end

        subgraph PodSecurity["Container Security"]
            Security["runAsNonRoot: true<br/>runAsUser: 5000<br/>Capabilities: ALL dropped<br/>allowPrivilegeEscalation: false"]
        end
    end

    subgraph Optional["OPTIONAL: mTLS Sidecar"]
        NGINX["NGINX mTLS Sidecar<br/>Certificate-based mutual auth<br/>Client → NGINX(mTLS) → OVMS(localhost)"]
    end

    subgraph ModelStorage["MODEL STORAGE"]
        Storage["Model Storage Mount<br/>/mnt/models<br/>Source: KServe storageUri<br/>(S3, GCS, PVC)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Auth: delegated"| Gateway
    Gateway -->|"HTTP/gRPC<br/>mTLS (Istio)<br/>Service Identity"| Sidecar
    Sidecar -->|"HTTP/8888<br/>Plaintext (in-pod)<br/>No auth"| OVMS_REST
    Sidecar -->|"gRPC/8001<br/>Plaintext (in-pod)<br/>No auth"| OVMS_GRPC
    OVMS_Engine -->|"Local filesystem<br/>/mnt/models"| Storage
    Prometheus -->|"HTTP/8888<br/>mTLS (mesh)<br/>/metrics"| OVMS_Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef optional fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray:5
    classDef security fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Client external
    class Gateway ingress
    class Sidecar,OVMS_REST,OVMS_GRPC,OVMS_Metrics,OVMS_Engine servicemesh
    class Storage storage
    class Prometheus monitoring
    class NGINX optional
    class Security security
