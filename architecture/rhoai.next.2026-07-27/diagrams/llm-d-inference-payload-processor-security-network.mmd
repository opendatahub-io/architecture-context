graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Envoy Proxy)"]
        Envoy["Envoy Proxy<br/>envoyproxy/envoy:distroless-v1.33.2<br/>NodePort 8081/TCP<br/>ext_proc filter enabled"]
    end

    subgraph Core["CORE PROCESSING"]
        direction TB

        subgraph NS_PP["Namespace: ${NAMESPACE}"]
            PP["Payload Processor<br/>SA: payload-processor<br/>9004/TCP gRPC ExtProc (Optional TLS)<br/>9090/TCP Metrics (Optional K8s auth)<br/>8000/TCP Health (HTTP)"]
        end
    end

    subgraph ModelServers["MODEL SERVERS (Dev/E2E)"]
        direction LR

        Llama["vllm-llama3-8b-instruct<br/>ClusterIP 8000/TCP<br/>llama_cluster (default)"]
        DeepSeek["vllm-deepseek-r1<br/>ClusterIP 8000/TCP<br/>deepseek_cluster"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+"]
        ConfigMaps["ConfigMaps<br/>label: inference.llm-d.ai/<br/>ipp-managed: true"]
    end

    %% Flows
    Client -->|"HTTP/8081<br/>No Auth<br/>Encryption: config-dependent"| Envoy
    Envoy -->|"gRPC ExtProc/9004<br/>Optional TLS<br/>No App Auth"| PP
    PP -->|"Sets X-Gateway-Base-Model-Name"| Envoy
    Envoy -->|"HTTP/8000<br/>Route: llama_cluster"| Llama
    Envoy -->|"HTTP/8000<br/>Route: deepseek_cluster"| DeepSeek
    PP -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    K8sAPI -.->|"Watch events"| ConfigMaps
    ConfigMaps -.->|"Reconcile"| PP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef core fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef modelserver fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Envoy ingress
    class PP core
    class Llama,DeepSeek modelserver
    class K8sAPI,ConfigMaps controlplane
