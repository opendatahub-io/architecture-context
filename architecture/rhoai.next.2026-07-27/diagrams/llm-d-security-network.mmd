graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["llm-d-inference-gateway<br/>80/TCP HTTP<br/>Gateway API Listener<br/>Auth: Unknown"]
        HTTPRoute["HTTPRoute<br/>Header: X-Gateway-Base-Model-Name<br/>Backend: InferencePool"]
    end

    subgraph Routing["ROUTING (EPP + Envoy)"]
        EPP["Endpoint Picker Plugin<br/>Intelligent Routing<br/>Helm-deployed"]
        Envoy["Envoy Sidecar Proxy<br/>Traffic Forwarding"]
    end

    subgraph ModelServers["MODEL SERVERS (Kubernetes Workloads)"]
        direction TB

        subgraph NS_Prefill["Prefill Deployment"]
            Prefill["Prefill Model Server<br/>SA: modelserver-sa<br/>Ports: 8000/TCP, 5600/TCP<br/>Probes: /health, /v1/models"]
        end

        subgraph NS_Decode["Decode Deployment"]
            Decode["Decode Model Server<br/>SA: modelserver-sa<br/>Port: 8000/TCP<br/>Probes: /health, /v1/models"]
        end
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>localhost:4317<br/>gRPC OTLP"]
        PodMon["PodMonitor<br/>monitoring.coreos.com<br/>Prometheus Metrics"]
    end

    %% External to Ingress
    Client -->|"HTTP/80<br/>Encryption: None (listener)<br/>Auth: Unknown"| Gateway
    Gateway --> HTTPRoute

    %% Ingress to Router
    HTTPRoute -->|"InferencePool routing<br/>inference.networking.k8s.io"| EPP
    EPP --> Envoy

    %% Router to Model Servers
    Envoy -->|"HTTP or gRPC/8000<br/>Encryption: Unknown<br/>Auth: Unknown"| Prefill
    Envoy -->|"HTTP or gRPC/8000<br/>Encryption: Unknown<br/>Auth: Unknown"| Decode

    %% Prefill to Decode (NIXL)
    Prefill -->|"NIXL/5600<br/>KV-cache transfer<br/>Encryption: Unknown"| Decode

    %% Observability
    EPP -.->|"gRPC OTLP/4317<br/>Traces (10% sampling)"| OTel
    Prefill -.->|"metrics"| PodMon
    Decode -.->|"metrics"| PodMon

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef routing fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef modelserver fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway,HTTPRoute ingress
    class EPP,Envoy routing
    class Prefill,Decode modelserver
    class OTel,PodMon observability
