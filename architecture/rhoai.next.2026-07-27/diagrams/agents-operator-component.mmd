graph TB
    subgraph OperatorPod["kagenti-operator-controller-manager"]
        direction TB
        Manager["manager<br/>(Go executable)"]

        subgraph Controllers["Controllers"]
            direction LR
            AgentCardCtrl["AgentCard<br/>Controller"]
            AgentRuntimeCtrl["AgentRuntime<br/>Controller"]
            DSCCtrl["DataScienceCluster<br/>Controller"]
            DeployCtrl["Deployment<br/>Controller"]
            KuadrantCtrl["Kuadrant<br/>Controller"]
            NSCtrl["Namespace<br/>Controller"]
            SSCtrl["StatefulSet<br/>Controller"]
            TektonCtrl["TektonConfig<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks"]
            direction LR
            MutatingWH["inject.kagenti.io<br/>Mutating Webhook<br/>(AuthBridge Injector)"]
            ValidatingAC["AgentCard<br/>Validating Webhook"]
            ValidatingAR["AgentRuntime<br/>Validating Webhook"]
        end

        Manager --> Controllers
        Manager --> Webhooks
    end

    subgraph AuthBridgeSidecars["AuthBridge Variants (injected into agent Pods)"]
        direction LR
        ABEnvoy["authbridge-envoy<br/>(Envoy ext_proc)"]
        ABProxy["authbridge-proxy<br/>(Full Proxy Sidecar)"]
        ABLite["authbridge-lite<br/>(Lite Proxy Sidecar)"]
    end

    subgraph SupportingServices["Supporting Services"]
        direction LR
        TokenBroker["token-broker<br/>(OAuth2 Session Tokens)"]
        AgentCardSigner["agentcard-signer<br/>(Sigstore Signing)"]
        BundleService["bundle-service<br/>(Agent Bundles)"]
    end

    %% CRDs
    AgentCardCR["AgentCard CR<br/>agent.kagenti.dev/v1alpha1"]
    AgentRuntimeCR["AgentRuntime CR<br/>agent.kagenti.dev/v1alpha1"]
    AuthPolicyCR["AuthorizationPolicy CR<br/>agent.kagenti.dev/v1alpha1"]

    %% CRD relationships
    AgentCardCR -->|watched by| AgentCardCtrl
    AgentRuntimeCR -->|watched by| AgentRuntimeCtrl
    AgentCardCtrl -->|validates| ValidatingAC
    AgentRuntimeCtrl -->|validates| ValidatingAR

    %% AuthBridge injection
    MutatingWH -->|injects sidecar| AuthBridgeSidecars

    %% External dependencies
    CertManager["cert-manager"]
    DSC["DataScienceCluster CR"]
    MLflow["MLflow"]
    EnvoyProxy["Envoy Proxy"]
    SPIRE["SPIRE / SPIFFE"]
    Keycloak["Keycloak"]
    Kuadrant["Kuadrant"]
    Tekton["Tekton"]
    K8sAPI["Kubernetes API"]

    %% Dependency connections
    AgentRuntimeCtrl -->|manages certs| CertManager
    DSCCtrl -->|watches| DSC
    AgentRuntimeCtrl -->|reads| MLflow
    ABEnvoy -->|gRPC ExtProc| EnvoyProxy
    ABProxy -->|mTLS via| SPIRE
    KuadrantCtrl -->|watches| Kuadrant
    TektonCtrl -->|watches| Tekton
    Manager -->|RBAC, resources| K8sAPI

    %% Token broker integration
    AuthBridgeSidecars -->|token exchange| TokenBroker

    %% Styling
    style OperatorPod fill:#4a90e2,stroke:#333,color:#fff
    style Manager fill:#3a7bc8,stroke:#333,color:#fff
    style AgentCardCtrl fill:#3a7bc8,stroke:#333,color:#fff
    style AgentRuntimeCtrl fill:#3a7bc8,stroke:#333,color:#fff
    style DSCCtrl fill:#3a7bc8,stroke:#333,color:#fff
    style DeployCtrl fill:#3a7bc8,stroke:#333,color:#fff
    style KuadrantCtrl fill:#3a7bc8,stroke:#333,color:#fff
    style NSCtrl fill:#3a7bc8,stroke:#333,color:#fff
