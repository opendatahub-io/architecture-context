graph LR
    OGX["ogx<br/>(Llama Stack)"]

    %% Core Framework Dependencies
    OGX -->|"web framework"| FastAPI["FastAPI >=0.115"]
    OGX -->|"ASGI server"| Starlette["Starlette 0.45"]
    OGX -->|"data validation"| Pydantic["Pydantic >=2"]
    OGX -->|"runtime"| Python["Python >=3.10"]

    %% Inference Provider Dependencies
    OGX -->|"LLM inference"| OpenAI["OpenAI API<br/>(openai >=1.66)"]
    OGX -->|"LLM inference"| Cerebras["Cerebras API<br/>api.cerebras.ai"]
    OGX -->|"inference + data"| NVIDIA["NVIDIA NeMo API"]

    %% Tool Runtime Dependencies
    OGX -->|"web search"| Tavily["Tavily Search<br/>api.tavily.com<br/>443/HTTPS"]

    %% Auth Dependencies
    OGX -->|"JWT/JWKS"| OAuth2["OAuth2/OIDC Provider"]
    OGX -.->|"custom auth"| ExternalAuth["External Auth Endpoint"]

    %% SDK & Client Dependencies
    OGX -->|"client SDK"| LlamaClient["llama-stack-client<br/>>=0.2.10"]

    %% UI Dependencies
    OGX -->|"browser UI"| Streamlit["Streamlit"]

    %% HTTP/Async Dependencies
    OGX -->|"HTTP client"| HTTPX["httpx 0.28"]
    OGX -->|"async HTTP"| AIOHttp["aiohttp 3.11"]
    OGX -->|"tokenization"| Tiktoken["tiktoken 0.9"]

    %% Auth Library Dependencies
    OGX -->|"JWT handling"| PythonJose["python-jose 3.4"]

    %% Data Dependencies
    OGX -->|"templating"| Jinja2["Jinja2 >=3.1"]
    OGX -->|"model hub"| HFHub["huggingface-hub 0.29"]

