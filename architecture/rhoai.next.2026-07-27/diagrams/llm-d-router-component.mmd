graph TB
    subgraph EnvoyLayer["Envoy Proxy Layer"]
        Envoy["Envoy Proxy<br/>(Sidecar / Gateway)"]
    end

    subgraph LLMDRouter["llm-d-router"]
        subgraph EPP["Endpoint Picker (EPP)"]
            ExtProc["ExternalProcessor<br/>gRPC Service<br/>Optional TLS"]
            HealthGRPC["Health<br/>gRPC Service<br/>Optional TLS"]
            Metrics["/metrics<br/>HTTP Endpoint"]

            subgraph PluginFramework["Plugin Framework (80+ plugins)"]
                Parsers["Parsers<br/>OpenAI, Anthropic,<br/>vLLM, Vertex AI,<br/>Passthrough"]
                ReqControl["Request Control<br/>Admitters,<br/>Data Producers"]
                FlowControl["Flow Control<br/>Priority Bands,<br/>Fairness Policies"]
                Scheduler["Scheduler<br/>Filters, Scorers,<br/>Pickers, Profiles"]
            end

            subgraph DataLayer["Data Layer"]
                MetricsScraper["Metrics Scraper<br/>Prometheus, DCGM"]
                AttrExtractors["Attribute Extractors<br/>Concurrency, GPU,<br/>Latency, Prefix Cache"]
            end
        end

        subgraph Coordinator["Coordinator Server"]
            ChatEndpoint["/v1/chat/completions<br/>HTTP"]
            CompletionsEndpoint["/v1/completions<br/>HTTP"]
            HealthHTTP["/healthz & /readyz<br/>HTTP"]
        end

        subgraph Controllers["Kubernetes Controllers"]
            IMRCtrl["InferenceModelRewrite<br/>Controller"]
            IOCtrl["InferenceObjective<br/>Controller"]
            IPCtrl["InferencePool<br/>Controller"]
            PodCtrl["Pod<br/>Controller"]
        end
    end

    subgraph CRDs["Custom Resources"]
        EPCfg["EndpointPickerConfig<br/>llm-d.ai/v1alpha1"]
        IMR["InferenceModelRewrite<br/>llm-d.ai/v1alpha2"]
        IO["InferenceObjective<br/>llm-d.ai/v1alpha2"]
        IP["InferencePool<br/>inference.networking.k8s.io/v1"]
    end

    subgraph External["External Systems"]
        K8sAPI["Kubernetes API<br/>6443/HTTPS"]
        OTel["OpenTelemetry<br/>Collector"]
        Redis["Redis"]
    end

    %% Envoy to EPP flow
    Envoy -->|gRPC ExtProc<br/>callout| ExtProc

    %% Plugin pipeline
    ExtProc --> Parsers
    Parsers --> ReqControl
    ReqControl --> FlowControl
    FlowControl --> Scheduler
    Scheduler -->|selected endpoint| Envoy

    %% Data layer feeds scheduler
    MetricsScraper --> AttrExtractors
    AttrExtractors --> Scheduler

    %% CRD watches
    EPCfg -->|configures| ExtProc
    IMR -->|watched by| IMRCtrl
    IO -->|watched by| IOCtrl
    IP -->|watched by| IPCtrl

    %% Controller interactions
    IMRCtrl --> FlowControl
    IOCtrl --> FlowControl
    IPCtrl --> DataLayer
    PodCtrl -->|populates<br/>endpoint datastore| DataLayer

    %% External dependencies
    Controllers -->|watch/reconcile| K8sAPI
    EPP -.->|traces| OTel
    DataLayer -.->|cache/state| Redis

    %% Styling
    style ExtProc fill:#4a90e2,color:#fff
    style HealthGRPC fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style ChatEndpoint fill:#50c878,color:#fff
    style CompletionsEndpoint fill:#50c878,color:#fff
    style HealthHTTP fill:#50c878,color:#fff
    style EPCfg fill:#f5a623,color:#fff
    style IMR fill:#f5a623,color:#fff
    style IO fill:#f5a623,color:#fff
    style IP fill:#f5a623,color:#fff
    style Envoy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style IMRCtrl fill:#9b59b6,color:#fff
    style IOCtrl fill:#9b59b6,color:#fff
    style IPCtrl fill:#9b59b6,color:#fff
    style PodCtrl fill:#9b59b6,color:#fff
