graph TB
    subgraph Operator["MCP Lifecycle Module Operator"]
        direction TB
        Controller["mcp-lifecycle-module-operator<br/>controller-manager<br/>(Deployment)"]
        HealthProbe["/healthz :8081"]
        ReadyProbe["/readyz :8081"]
        Controller --- HealthProbe
        Controller --- ReadyProbe
    end

    subgraph ReconciliationLoop["Reconciliation Logic"]
        direction TB
        FetchTLS["fetchTLSConfig"]
        RenderManifests["KustomizeProvider<br/>Render Manifests"]
        SSADeploy["SSA Deployer<br/>Server-Side Apply"]
        GarbageCollect["Garbage Collector<br/>Label-based Ownership"]
        ReadinessCheck["Operand Readiness<br/>Verification"]
        FetchTLS --> RenderManifests
        RenderManifests --> SSADeploy
        SSADeploy --> GarbageCollect
        GarbageCollect --> ReadinessCheck
    end

    Controller -->|reconciles| ReconciliationLoop

    %% CRDs
    MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>(Cluster-scoped, singleton)<br/>components.platform.opendatahub.io/v1alpha1"]
    MCPServerCR["MCPServer CR<br/>mcp.x-k8s.io"]

    MCPLifecycleOpCR -->|watched by| Controller
    SSADeploy -->|creates/manages| MCPServerCR

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    OpenShiftAPIServer["OpenShift APIServer<br/>config.openshift.io"]
    PrometheusOp["prometheus-operator<br/>ServiceMonitor"]

    Controller -->|authenticates via SA token| K8sAPI
    FetchTLS -->|reads TLS config| OpenShiftAPIServer
    Controller -->|creates ServiceMonitors| PrometheusOp

    %% Library Dependencies
    ODHPlatformUtils["odh-platform-utilities<br/>(Go Library)"]
    ControllerRuntime["controller-runtime<br/>0.24.1"]

    Controller -.->|uses| ODHPlatformUtils
    Controller -.->|built on| ControllerRuntime

    %% Leader Election
    LeaderElection["Leader Election<br/>coordination.k8s.io/leases"]
    Controller -->|acquires lease| LeaderElection

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style MCPLifecycleOpCR fill:#f5a623,stroke:#333,color:#fff
    style MCPServerCR fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPIServer fill:#e8e8e8,stroke:#333
    style PrometheusOp fill:#7ed321,stroke:#333
    style ODHPlatformUtils fill:#7ed321,stroke:#333
    style ControllerRuntime fill:#e8e8e8,stroke:#333
    style LeaderElection fill:#e8e8e8,stroke:#333
