graph TB
    subgraph MLflowOperator["mlflow-operator"]
        direction TB

        subgraph Controllers["Controllers"]
            MLflowCtrl["MLflow Controller<br/>(MLflowReconciler)<br/>Reconciles MLflow CRs"]
            MLflowOpCtrl["MLflowOperator Controller<br/>(MLflowOperatorReconciler)<br/>Reconciles MLflowOperator CRs"]
            NSCtrl["Namespace Controller<br/>(NamespaceRBACReconciler)<br/>Manages per-namespace RBAC"]
        end

        subgraph Runtime["Runtime"]
            SecurityWatcher["SecurityProfileWatcher<br/>Monitors TLS profile changes"]
            Manager["mlflow-operator-controller-manager<br/>Deployment"]
        end

        Manager -->|runs| MLflowCtrl
        Manager -->|runs| MLflowOpCtrl
        Manager -->|runs| NSCtrl
        Manager -->|runs| SecurityWatcher
    end

    %% CRDs
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)<br/>Cluster-scoped"]
    MLflowOpCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    MLflowConfigCR["MLflowConfig CR<br/>(mlflow.kubeflow.org/v1)<br/>Namespaced"]

    MLflowCR -->|watched by| MLflowCtrl
    MLflowOpCR -->|watched by| MLflowOpCtrl
    MLflowConfigCR -->|read by| MLflowCtrl

    %% Owned Resources (Helm-rendered)
    subgraph OwnedResources["Owned Resources (Helm-rendered)"]
        Deploy["Deployments"]
        Svc["Services"]
        Secrets["Secrets"]
        SA["ServiceAccounts"]
        PVC["PersistentVolumeClaims"]
        CronJobs["CronJobs"]
        Jobs["Jobs"]
    end

    MLflowCtrl -->|creates/manages| OwnedResources

    %% Conditional Resources
    subgraph ConditionalResources["Conditional Resources (CRD discovery)"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        ConsoleLink["ConsoleLink<br/>(OpenShift Console)"]
        ServiceMonitor["ServiceMonitor<br/>(Prometheus)"]
    end

    MLflowCtrl -.->|conditional| HTTPRoute
    MLflowCtrl -.->|conditional| ConsoleLink
    MLflowCtrl -.->|conditional| ServiceMonitor

    %% RBAC Management
    NSCtrl -->|manages| RoleBindings["RoleBindings<br/>(per-namespace view/edit)"]

    %% External
    SecurityWatcher -->|reads| TLSProfile["OpenShift TLS Profile<br/>(apiservers.config.openshift.io)"]

    %% Styling
    style MLflowCtrl fill:#4a90e2,color:#fff
    style MLflowOpCtrl fill:#4a90e2,color:#fff
    style NSCtrl fill:#4a90e2,color:#fff
    style SecurityWatcher fill:#4a90e2,color:#fff
    style Manager fill:#2c5f8a,color:#fff
    style MLflowCR fill:#f5a623,color:#000
    style MLflowOpCR fill:#f5a623,color:#000
    style MLflowConfigCR fill:#f5a623,color:#000
    style HTTPRoute fill:#e8e8e8,color:#000
    style ConsoleLink fill:#e8e8e8,color:#000
    style ServiceMonitor fill:#e8e8e8,color:#000
    style TLSProfile fill:#e8e8e8,color:#000
