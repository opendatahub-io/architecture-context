    Proxy -->|"OAuth2 flow<br/>/oauth2/start"| OAuthServer["OpenShift OAuth Server<br/>/ OIDC Provider"]
    OAuthServer -->|"Authorization code<br/>/oauth2/callback"| Proxy

    Proxy -->|"TokenReview API"| K8sAPI["Kubernetes API<br/>:6443 HTTPS"]
    Proxy -->|"Session persistence"| Redis["Redis / Valkey<br/>Standalone / Sentinel / Cluster"]
    Proxy -->|"Forward authenticated<br/>requests + identity headers"| ExampleApp

    SessionMgr -->|"Store/retrieve sessions"| Redis
    Proxy --- SessionMgr

