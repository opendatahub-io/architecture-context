graph TB
    subgraph "kube-auth-proxy Component"
        Proxy["kube-auth-proxy<br/>Reverse Proxy<br/>Port 4180"]
        SessionMgr["Session Manager<br/>Encrypted Cookies"]
    end

    subgraph "Test Infrastructure"
        ExampleApp["example-app<br/>hashicorp/http-echo<br/>Port 8080"]
    end

    Client[External Client] -->|HTTPS| Route["OpenShift Route<br/>TLS Edge Termination"]
    Route -->|HTTP :80| ProxySvc["kube-auth-proxy Service<br/>ClusterIP :80 -> :4180"]
