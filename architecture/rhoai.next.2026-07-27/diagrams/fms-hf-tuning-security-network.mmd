graph TB
    subgraph External["EXTERNAL (No Inbound Surface)"]
        direction TB
        Note["No inbound APIs<br/>No HTTP/gRPC endpoints<br/>No CRDs<br/>Batch workload only"]
    end

    subgraph Workload["WORKLOAD (Kubernetes Job / Pod)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            FMSTuning["fms-hf-tuning<br/>Python ~=3.9<br/>SA: {job-service-account}<br/>GPU: Optional<br/>No inbound ports"]
        end

        subgraph Credentials["Credentials (env vars)"]
            S3Key["S3_ACCESS_KEY_ID"]
            S3Secret["S3_SECRET_ACCESS_KEY"]
            S3Endpoint["S3_ENDPOINT"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>HTTPS / TLS<br/>Auth: AWS IAM (boto3)"]
        HFHub["HuggingFace Hub<br/>HTTPS / TLS<br/>Auth: HF Token (optional)"]
    end

    subgraph OptionalTrackers["EXPERIMENT TRACKERS (Optional)"]
        Aim["Aim Server"]
        MLflow["MLflow Server"]
        ClearML["ClearML Server"]
    end

    %% Credential injection
    S3Key -.->|injected| FMSTuning
    S3Secret -.->|injected| FMSTuning
    S3Endpoint -.->|injected| FMSTuning

    %% Outbound flows
    FMSTuning -->|"HTTPS/443<br/>TLS<br/>AWS IAM (boto3)"| S3
    FMSTuning -.->|"HTTPS/443<br/>TLS<br/>HF Token"| HFHub
    FMSTuning -.->|"Metrics logging<br/>(if configured)"| Aim
    FMSTuning -.->|"Metrics logging<br/>(if configured)"| MLflow
    FMSTuning -.->|"Metrics logging<br/>(if configured)"| ClearML

    %% Styling
    classDef noSurface fill:#f9f9f9,stroke:#999,stroke-width:2px,stroke-dasharray: 5 5
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef credential fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef externalService fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef optional fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,stroke-dasharray: 5 5

    class Note noSurface
    class FMSTuning workload
    class S3Key,S3Secret,S3Endpoint credential
    class S3,HFHub externalService
    class Aim,MLflow,ClearML optional
