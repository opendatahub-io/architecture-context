graph TD
    subgraph "vllm-gaudi RBAC Overview"
        direction TB

        Note["ℹ️ No RBAC roles or bindings<br/>defined by this component"]

        subgraph "Container Security"
            UID["Non-root User<br/>UID 2000"]
            BaseImage["Base Image<br/>UBI 9.6 (RHEL 9)"]
            NoCaps["No Privileged<br/>Capabilities Required"]
        end

        subgraph "Platform-Managed RBAC"
            KServeRBAC["KServe / RHOAI Controller<br/>(manages pod RBAC)"]
            ServiceMesh["Service Mesh / Istio<br/>(manages network auth)"]
            DevicePlugin["Gaudi Device Plugin<br/>(manages HPU access)"]
        end

        subgraph "Hardware Access"
            GaudiHPU["Intel Gaudi HPU<br/>(via Kubernetes device plugin<br/>resource allocation)"]
        end
    end

    %% Relationships
    UID -->|"runs as"| BaseImage
    BaseImage -->|"no extra caps"| NoCaps
    KServeRBAC -->|"creates/manages"| UID
    ServiceMesh -->|"enforces"| NoCaps
    DevicePlugin -->|"allocates"| GaudiHPU

    %% Styling
    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style UID fill:#4a90e2,stroke:#333,color:#fff
    style BaseImage fill:#cc0000,stroke:#333,color:#fff
    style NoCaps fill:#28a745,stroke:#333,color:#fff
    style KServeRBAC fill:#e8e8e8,stroke:#333
    style ServiceMesh fill:#e8e8e8,stroke:#333
    style DevicePlugin fill:#f5a623,stroke:#333,color:#fff
    style GaudiHPU fill:#f5a623,stroke:#333,color:#fff
