graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph InboundServices["INBOUND SERVICES (⚠️ No Auth Boundary)"]
        direction TB

        subgraph HTTPLayer["HTTP API :8080"]
            ScoreComp["/score_completions<br/>POST, HTTP<br/>Auth: NONE ⚠️"]
            ScoreChat["/score_chat_completions<br/>POST, HTTP<br/>Auth: NONE ⚠️"]
            MetricsEP["/metrics<br/>HTTP<br/>Prometheus"]
        end

        subgraph gRPCLayer["gRPC Services"]
            IndexerGRPC["IndexerService<br/>:50051 gRPC<br/>Auth: NONE ⚠️<br/>OTel instrumented"]
            TokenizerGRPC["TokenizationService<br/>gRPC (UDS)<br/>Auth: NONE ⚠️"]
        end
    end

    subgraph Internal["INTERNAL PROCESSING"]
        direction TB
        Indexer["KV Cache Indexer<br/>Prefix-aware scoring"]
        TokenDB["ChunkedTokenDatabase"]
        PodRecon["PodReconciler<br/>K8s Controller"]
        SubMgr["SubscriberManager<br/>ZMQ Subscriptions"]
        FSBackend["llmd_fs_backend<br/>Python vLLM Connector"]
    end

    subgraph Egress["EGRESS (Upstream Dependencies)"]
        direction TB
        vLLMPods["vLLM Engine Pods<br/>ZMQ pub/sub<br/>Encryption: Unknown"]
        RedisValkey["Redis / Valkey<br/>TCP<br/>Encryption: Runtime config"]
        K8sAPI["Kubernetes API<br/>:6443 HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        OTelCollector["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Encryption: Runtime config"]
        vLLMRuntime["vLLM Serving Runtime<br/>(Internal Platform)"]
    end

    %% External to Inbound
    Client -->|"HTTP/8080<br/>No TLS ⚠️<br/>No Auth ⚠️"| ScoreComp
    Client -->|"HTTP/8080<br/>No TLS ⚠️<br/>No Auth ⚠️"| ScoreChat
    Client -->|"gRPC/50051<br/>No TLS ⚠️<br/>No Auth ⚠️"| IndexerGRPC

    %% Inbound to Internal
    ScoreComp --> Indexer
    ScoreChat --> Indexer
    IndexerGRPC --> Indexer
    TokenizerGRPC --> TokenDB
    Indexer --> TokenDB

    %% Internal flows
    PodRecon --> SubMgr

    %% Internal to Egress
    SubMgr -->|"ZMQ sub<br/>topic: kv@<br/>No Auth"| vLLMPods
    Indexer -->|"TCP<br/>Runtime config"| RedisValkey
    PodRecon -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    IndexerGRPC -->|"OTLP/gRPC<br/>Runtime config"| OTelCollector
    FSBackend -->|"Integration<br/>KV cache offload"| vLLMRuntime

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef noauth fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secure fill:#d4edda,stroke:#28a745,stroke-width:2px

    class Client external
    class ScoreComp,ScoreChat,MetricsEP,IndexerGRPC,TokenizerGRPC noauth
    class Indexer,TokenDB,PodRecon,SubMgr,FSBackend internal
    class vLLMPods,RedisValkey,OTelCollector,vLLMRuntime egress
    class K8sAPI secure
