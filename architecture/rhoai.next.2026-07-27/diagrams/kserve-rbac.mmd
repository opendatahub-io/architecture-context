graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_KCM["kserve-controller-manager"]
        SA_ODH["odh-model-controller"]
        SA_MSA["model-serving-api"]
        SA_LLMISVC["$(llmisvc-serviceAccountName)"]
        SA_LM["kserve-localmodel-<br/>controller-manager"]
        SA_LMNode["kserve-localmodelnode-<br/>agent"]
        SA_Module["kserve-module-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_KCM["kserve-manager-<br/>rolebinding"]
        CRB_KProxy["kserve-proxy-<br/>rolebinding"]
        CRB_ODH["odh-model-controller-<br/>rolebinding"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_MSA["model-serving-api<br/>binding"]
        CRB_LLMISVC["llmisvc-manager-<br/>rolebinding"]
        CRB_LM["kserve-localmodel-<br/>manager-rolebinding"]
        CRB_LMNode["kserve-localmodelnode-<br/>agent-rolebinding"]
        CRB_Module["kserve-module-<br/>manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_ODH["odh-model-controller-role"]
        CR_ProxyODH["proxy-role"]
        CR_MSA["model-serving-api"]
        CR_LLMISVC["kserve-llmisvc-<br/>manager-role"]
        CR_LM["kserve-localmodel-<br/>manager-role"]
        CR_LMNode["kserve-localmodelnode-<br/>agent-role"]
        CR_Module["kserve-module-<br/>manager-role"]
    end

    subgraph KServeManagerResources["kserve-manager-role Resources"]
        R_ISVC["serving.kserve.io<br/>InferenceService,<br/>TrainedModel,<br/>InferenceGraph,<br/>ServingRuntime,<br/>ClusterServingRuntime"]
        R_Knative["serving.knative.dev<br/>Services"]
        R_Istio["networking.istio.io<br/>VirtualServices"]
        R_KEDA["keda.sh<br/>ScaledObjects"]
        R_Ingress["networking.k8s.io<br/>Ingresses"]
        R_Route["route.openshift.io<br/>Routes"]
        R_Apps["apps<br/>Deployments"]
    end

    subgraph ModuleResources["kserve-module-manager-role Resources"]
        R_Kserve["components.platform<br/>Kserves"]
        R_Cert["cert-manager.io<br/>Certificates,<br/>ClusterIssuers"]
        R_Webhook["admissionregistration<br/>Webhooks"]
        R_SCC["security.openshift.io<br/>SecurityContextConstraints"]
        R_NIM["nim.opendatahub.io<br/>Accounts"]
        R_RBAC["rbac.authorization<br/>ClusterRoles, Roles,<br/>Bindings"]
    end

    subgraph LLMISVCResources["kserve-llmisvc-manager-role Resources"]
        R_LLMISVC_CR["serving.kserve.io<br/>LLMInferenceService,<br/>LLMInferenceServiceConfig"]
        R_GW["gateway.networking<br/>Gateways, HTTPRoutes"]
        R_InfPool["inference.networking<br/>InferencePools,<br/>InferenceModels"]
        R_LWS["leaderworkerset<br/>LeaderWorkerSets"]
        R_Resource["resource.k8s.io<br/>ResourceClaims"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        R_LMCache["serving.kserve.io<br/>LocalModelCaches,<br/>LocalModelNamespaceCaches,<br/>LocalModelNodes"]
        R_PV["core<br/>PersistentVolumes,<br/>PersistentVolumeClaims"]
        R_Nodes["core<br/>Nodes"]
    end

    %% Service Account → ClusterRoleBinding
    SA_KCM -->|bound via| CRB_KCM
    SA_KCM -->|bound via| CRB_KProxy
    SA_ODH -->|bound via| CRB_ODH
    SA_ODH -->|bound via| CRB_Proxy
    SA_MSA -->|bound via| CRB_MSA
    SA_LLMISVC -->|bound via| CRB_LLMISVC
    SA_LM -->|bound via| CRB_LM
    SA_LMNode -->|bound via| CRB_LMNode
    SA_Module -->|bound via| CRB_Module

    %% ClusterRoleBinding → ClusterRole
    CRB_KCM -->|grants| CR_Manager
    CRB_KProxy -->|grants| CR_Proxy
    CRB_ODH -->|grants| CR_ODH
    CRB_Proxy -->|grants| CR_ProxyODH
    CRB_MSA -->|grants| CR_MSA
    CRB_LLMISVC -->|grants| CR_LLMISVC
    CRB_LM -->|grants| CR_LM
    CRB_LMNode -->|grants| CR_LMNode
    CRB_Module -->|grants| CR_Module

    %% ClusterRole → Resources
    CR_Manager -->|"CRUD"| R_ISVC
    CR_Manager -->|"CRUD"| R_Knative
    CR_Manager -->|"CRUD"| R_Istio
    CR_Manager -->|"CRUD"| R_KEDA
    CR_Manager -->|"CRUD"| R_Ingress
    CR_Manager -->|"CRUD"| R_Route
    CR_Manager -->|"CRUD"| R_Apps

    CR_Module -->|"CRUD + escalate"| R_Kserve
    CR_Module -->|"CRUD"| R_Cert
    CR_Module -->|"CRUD"| R_Webhook
    CR_Module -->|"CRUD"| R_SCC
    CR_Module -->|"CRUD"| R_NIM
    CR_Module -->|"CRUD + bind/escalate"| R_RBAC

    CR_LLMISVC -->|"CRUD"| R_LLMISVC_CR
    CR_LLMISVC -->|"CRUD"| R_GW
    CR_LLMISVC -->|"CRUD"| R_InfPool
    CR_LLMISVC -->|"CRUD"| R_LWS
    CR_LLMISVC -->|"CRUD"| R_Resource

    CR_LM -->|"CRUD"| R_LMCache
    CR_LM -->|"CRUD"| R_PV
    CR_LM -->|"get, list, watch"| R_Nodes

    CR_Proxy -->|"create"| TokenReview["authentication.k8s.io<br/>TokenReview"]
    CR_Proxy -->|"create"| SAR["authorization.k8s.io<br/>SubjectAccessReview"]
    CR_ProxyODH -->|"create"| TokenReview
    CR_ProxyODH -->|"create"| SAR

    %% Styling
    style SA_KCM fill:#4a90e2,color:#fff
    style SA_ODH fill:#4a90e2,color:#fff
    style SA_MSA fill:#4a90e2,color:#fff
    style SA_LLMISVC fill:#4a90e2,color:#fff
    style SA_LM fill:#4a90e2,color:#fff
    style SA_LMNode fill:#4a90e2,color:#fff
    style SA_Module fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_ODH fill:#f5a623,color:#fff
    style CR_ProxyODH fill:#f5a623,color:#fff
    style CR_MSA fill:#f5a623,color:#fff
    style CR_LLMISVC fill:#f5a623,color:#fff
    style CR_LM fill:#f5a623,color:#fff
    style CR_LMNode fill:#f5a623,color:#fff
    style CR_Module fill:#f5a623,color:#fff
    style R_ISVC fill:#7ed321,color:#fff
    style R_Knative fill:#7ed321,color:#fff
    style R_Istio fill:#7ed321,color:#fff
    style R_KEDA fill:#7ed321,color:#fff
    style R_Ingress fill:#7ed321,color:#fff
    style R_Route fill:#7ed321,color:#fff
    style R_Apps fill:#7ed321,color:#fff
    style R_Kserve fill:#7ed321,color:#fff
    style R_Cert fill:#7ed321,color:#fff
    style R_Webhook fill:#7ed321,color:#fff
    style R_SCC fill:#7ed321,color:#fff
    style R_NIM fill:#7ed321,color:#fff
    style R_RBAC fill:#7ed321,color:#fff
    style R_LLMISVC_CR fill:#7ed321,color:#fff
    style R_GW fill:#7ed321,color:#fff
    style R_InfPool fill:#7ed321,color:#fff
    style R_LWS fill:#7ed321,color:#fff
    style R_Resource fill:#7ed321,color:#fff
    style R_LMCache fill:#7ed321,color:#fff
    style R_PV fill:#7ed321,color:#fff
    style R_Nodes fill:#7ed321,color:#fff
    style TokenReview fill:#e8e8e8
    style SAR fill:#e8e8e8
