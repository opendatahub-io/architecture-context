graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        ExtGW["knative-ingress-gateway<br/>Istio Gateway<br/>443/TCP<br/>TLS SIMPLE (wildcard-certs)<br/>Auth: None extracted"]
        IntGW["knative-local-gateway<br/>ClusterIP / Gateway<br/>80/TCP -> 8081/TCP<br/>No TLS (plaintext HTTP)"]
    end

    subgraph Application["APPLICATION (Internal)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            Predictor["caikit-tgis-serving<br/>Predictor Pod<br/>Python ~3.11<br/>caikit + caikit-nlp +<br/>caikit-tgis-backend"]
        end

        subgraph NS_Metrics["Metrics"]
            MetricsSvc["caikit-metrics-service<br/>ClusterIP 8086/TCP"]
        end

        Prometheus["Prometheus<br/>(kserve-prometheus-k8s<br/>ClusterRole)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MinIO["MinIO / S3 Storage<br/>9000/TCP<br/>HTTP (s3-usehttps=0)<br/>Static credentials<br/>(storage-config secret)"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS SIMPLE<br/>wildcard-certs<br/>No app-layer auth"| ExtGW
    ExtGW -->|"HTTP (internal)<br/>No TLS"| Predictor
    IntGW -->|"HTTP/8081<br/>No TLS<br/>Internal only"| Predictor
    Predictor -->|"S3 API/9000<br/>HTTP (no TLS)<br/>Static credentials"| MinIO
    Predictor -->|"TCP/8086<br/>Metrics"| MetricsSvc
    Prometheus -->|"Scrape/8086<br/>get,list,watch<br/>endpoints,pods,services"| MetricsSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class ExtGW,IntGW ingress
    class Predictor,MetricsSvc,Prometheus application
    class MinIO externalservice
