graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["modelmesh-controller"]
        SA_Default["default<br/>(system namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Main["modelmesh-controller-rolebinding<br/>(Cluster-scoped)"]
        CRB_Proxy["proxy-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_LE["modelmesh-controller-<br/>leader-election-rolebinding"]
        RB_SCC["modelmesh-controller-<br/>restricted-scc-rolebinding"]
        RB_NS["modelmesh-controller-<br/>rolebinding (namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Main["modelmesh-controller-role"]
        CR_Proxy["proxy-role"]
        CR_ISEdit["inferenceservice-editor-role"]
        CR_ISView["inferenceservice-viewer-role"]
        CR_PredEdit["predictor-editor-role"]
        CR_PredView["predictor-viewer-role"]
        CR_SREdit["servingruntime-editor-role"]
        CR_SRView["servingruntime-viewer-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_LE["modelmesh-controller-<br/>leader-election-role"]
        R_SCC["modelmesh-controller-<br/>restricted-scc-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["configmaps<br/>create,delete,get,list,<br/>patch,update,watch"]
        Secrets["secrets<br/>create,delete,get,list,<br/>patch,update,watch"]
        Services["services<br/>services/finalizers<br/>create,delete,get,list,<br/>patch,update,watch"]
        Endpoints["endpoints<br/>get,list,watch"]
        PVCs["persistentvolumeclaims<br/>get,list,watch"]
        Namespaces["namespaces<br/>namespaces/finalizers<br/>get,list,patch,<br/>update,watch"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps/deployments<br/>deployments/finalizers<br/>create,delete,get,list,<br/>patch,update,watch"]
    end

    subgraph ServingResources["serving.kserve.io Resources"]
        CSR["clusterservingruntimes<br/>+ finalizers, status"]
        SR["servingruntimes<br/>+ finalizers, status"]
        Pred["predictors<br/>+ finalizers, status"]
        IS["inferenceservices<br/>+ finalizers, status"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPA["horizontalpodautoscalers<br/>+ status<br/>create,delete,get,list,<br/>update,watch"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors<br/>create,delete,get,list,<br/>patch,update,watch"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph LeaderElection["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>leases<br/>create,get,list,update"]
        LE_ConfigMaps["configmaps<br/>create,delete,get,list,<br/>patch,update,watch"]
        Events["events<br/>create"]
    end

    subgraph SCCResources["OpenShift SCC"]
        SCC["security.openshift.io<br/>securitycontextconstraints<br/>use"]
    end

    %% Main controller bindings
    SA_Controller -->|"bound via"| CRB_Main
    CRB_Main -->|"grants"| CR_Main
    CR_Main -->|"manages"| ConfigMaps
    CR_Main -->|"manages"| Secrets
    CR_Main -->|"manages"| Services
    CR_Main -->|"reads"| Endpoints
    CR_Main -->|"reads"| PVCs
    CR_Main -->|"manages"| Namespaces
    CR_Main -->|"manages"| Deployments
    CR_Main -->|"manages"| CSR
    CR_Main -->|"manages"| SR
    CR_Main -->|"manages"| Pred
    CR_Main -->|"manages"| IS
    CR_Main -->|"manages"| HPA
    CR_Main -->|"manages"| ServiceMonitors

    %% Proxy bindings
    SA_Default -->|"bound via"| CRB_Proxy
    CRB_Proxy -->|"grants"| CR_Proxy
    CR_Proxy -->|"creates"| TokenReviews
    CR_Proxy -->|"creates"| SAR

    %% Leader election bindings
    SA_Controller -->|"bound via"| RB_LE
    RB_LE -->|"grants"| R_LE
    R_LE -->|"manages"| Leases
    R_LE -->|"manages"| LE_ConfigMaps
    R_LE -->|"creates"| Events

    %% SCC bindings
    SA_Controller -->|"bound via"| RB_SCC
    RB_SCC -->|"grants"| R_SCC
    R_SCC -->|"uses"| SCC

