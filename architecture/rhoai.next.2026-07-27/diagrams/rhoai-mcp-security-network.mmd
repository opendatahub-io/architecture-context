graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["AI Agent / MCP Client"]
    end

    subgraph Application["APPLICATION (rhoai-mcp namespace)"]
        direction TB
        subgraph PodSecurity["Pod Security: non-root UID 1000, read-only rootfs, drop ALL caps"]
            OIDCMiddleware["OIDCAuthMiddleware<br/>Validates Bearer Token<br/>(JWT or TokenReview)"]
            MCPServer["FastMCP Server<br/>ClusterIP 8000/TCP<br/>SA: rhoai-mcp"]
            ToolRBAC["Tool-Level RBAC<br/>SubjectAccessReview"]
        end
    end

    subgraph Platform["PLATFORM SERVICES (Cluster Internal)"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]

        subgraph K8sResources["Kubernetes Resources (via API Server)"]
            Notebooks["Kubeflow Notebooks<br/>kubeflow.org<br/>CRUD"]
            KServe["KServe InferenceService<br/>serving.kserve.io<br/>Watch/CRUD"]
            Training["Kubeflow Training<br/>trainer.kubeflow.org<br/>CRUD"]
            DSP["Data Science Pipelines<br/>opendatahub.io<br/>CRUD"]
            ServingRT["ServingRuntime CR<br/>serving.kserve.io<br/>CRUD"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        OIDCProvider["OIDC Provider<br/>HTTPS<br/>JWKS endpoint"]
    end

    %% Flows
    Client -->|"MCP Protocol / 8000/TCP<br/>Auth: Bearer Token<br/>(when oidc_enabled)"| OIDCMiddleware
    OIDCMiddleware -->|"Token validation<br/>(JWT mode)"| MCPServer
    OIDCMiddleware -.->|"JWKS fetch<br/>HTTPS"| OIDCProvider
    MCPServer --> ToolRBAC
    ToolRBAC -->|"SubjectAccessReview<br/>6443/TCP HTTPS"| K8sAPI
    MCPServer -->|"K8s API calls<br/>6443/TCP HTTPS TLS 1.2+<br/>Impersonate: user"| K8sAPI
    K8sAPI --- Notebooks
    K8sAPI --- KServe
    K8sAPI --- Training
    K8sAPI --- DSP
    K8sAPI --- ServingRT

    %% Health check (no auth)
    HealthProbe["Probe"] -.->|"GET /health<br/>No Auth"| MCPServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef auth fill:#fecaca,stroke:#ef4444,stroke-width:2px

    class Client external
    class OIDCMiddleware auth
    class MCPServer,ToolRBAC application
    class K8sAPI,Notebooks,KServe,Training,DSP,ServingRT platform
    class OIDCProvider externalservice
    class HealthProbe external
