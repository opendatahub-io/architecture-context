graph TD
    subgraph "Component Execution Context"
        SA["Pipeline Step Pod<br/>ServiceAccount<br/>(Inherited from KFP)"]
    end

    subgraph "Credential Injection (Kubernetes Secrets / Env Vars)"
        direction TB
        AWS["AWS_SECRET_ACCESS_KEY<br/>S3 storage access"]
        HF["HF_TOKEN<br/>HuggingFace Hub auth"]
        S3Key["S3_SECRET_KEY<br/>S3 storage access (alt)"]
        LLMKey["LLM_API_KEY<br/>LLM endpoint auth"]
        OCIPull["OCI_PULL_SECRET_MODEL_DOWNLOAD<br/>OCI registry pull"]
        K8sAuth["KUBERNETES_AUTH_TOKEN<br/>Kubernetes API auth"]
        ChunkTokens["CHUNK_MAX_TOKENS<br/>Parse config"]
        Tokenizer["TOKENIZER<br/>Tokenizer config"]
    end

    subgraph "secretKeyRef Injection"
        MinIOCreds["MinIO Credentials<br/>Injected into RayJob spec<br/>via secretKeyRef<br/>(no plaintext)"]
    end

    subgraph "Accessed Resources"
        S3Svc["AWS S3-Compatible<br/>Storage"]
        HFSvc["HuggingFace Hub"]
        LLMSvc["LLM API Endpoints"]
        OCISvc["OCI Registries"]
        K8sSvc["Kubernetes API"]
        MinIOSvc["MinIO Storage"]
        KServeSvc["KServe<br/>serving.kserve.io"]
        RaySvc["CodeFlare / Ray<br/>ray.io"]
        KueueSvc["Kueue<br/>kueue.x-k8s.io"]
    end

    %% ServiceAccount inherits KFP RBAC
    SA -->|"inherits RBAC from<br/>KFP execution environment"| K8sSvc
    SA -->|"creates CRs"| KServeSvc
    SA -->|"submits RayJobs"| RaySvc
    SA -.->|"optional quota"| KueueSvc

    %% Env var credentials
    AWS -->|authenticates| S3Svc
    HF -->|authenticates| HFSvc
    S3Key -->|authenticates| S3Svc
    LLMKey -->|authenticates| LLMSvc
    OCIPull -->|authenticates| OCISvc
    K8sAuth -->|authenticates| K8sSvc

    %% secretKeyRef
    MinIOCreds -->|authenticates| MinIOSvc

    %% Notes
    Note["Note: No ClusterRoles or RoleBindings<br/>defined by this package.<br/>All RBAC inherited from<br/>KFP orchestrator.<br/><br/>0 inbound auth rules.<br/>13 credential references."]

