graph TB
    subgraph "TrustyAI Explainability Service"
        direction TB
        InitContainer["config-map-overrider<br/>(Init Container)<br/>Creates model-serving-config"]
        Service["trustyai-service<br/>(Deployment, 1 replica)<br/>Quarkus Runtime"]
        PVC["trustyai-service-pvc<br/>(PersistentVolumeClaim)<br/>Mounted at /inputs"]
        ConfigMap["trustyai-config<br/>(ConfigMap, 6 keys)<br/>Storage, batch, metrics config"]

        InitContainer -->|"runs before"| Service
        Service -->|"reads config"| ConfigMap
        Service -->|"stores inference data"| PVC
    end

    subgraph "External Access"
        Client[External Client]
        Route["trustyai<br/>(OpenShift Route)"]
        ClusterIPSvc["trustyai-service<br/>(ClusterIP Service)<br/>80/TCP → 8080"]
    end

    Client -->|"HTTP"| Route
    Route -->|"forwards"| ClusterIPSvc
    ClusterIPSvc -->|"8080/TCP"| Service

    subgraph "KServe / ModelMesh"
        KServe["KServe Model Serving<br/>Infrastructure"]
        ModelServingCM["model-serving-config<br/>(ConfigMap)"]
    end

    InitContainer -->|"oc apply<br/>creates ConfigMap"| ModelServingCM
    ModelServingCM -->|"registers processor URL"| KServe
    KServe -->|"POST /consumer/kserve/v2<br/>inference payloads"| Service

    subgraph "Monitoring"
        Prometheus["Prometheus"]
    end

    Prometheus -->|"scrapes /q/metrics<br/>8080/TCP"| Service

    K8sAPI["OpenShift API Server"]
    InitContainer -->|"oc apply"| K8sAPI

    style Service fill:#4a90e2,stroke:#333,stroke-width:2px
    style InitContainer fill:#4a90e2,stroke:#333,stroke-width:1px
    style PVC fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style Route fill:#ffe6cc,stroke:#d79b00
    style ClusterIPSvc fill:#ffe6cc,stroke:#d79b00
    style KServe fill:#7ed321,stroke:#333
    style ModelServingCM fill:#f5a623,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style K8sAPI fill:#999,stroke:#333
