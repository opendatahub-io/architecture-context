graph LR
    Feast["Feast<br/>(Operator + Feature Server)"]

    %% Go Runtime Dependencies
    Feast -->|"controller framework"| ControllerRuntime["controller-runtime 0.23.3"]
    Feast -->|"Go runtime"| Go["Go 1.25"]

    %% Online Store Backends
    Feast -->|"online store<br/>sslmode=require"| PostgreSQL["PostgreSQL<br/>(pgx/v5)"]
    Feast -->|"online store<br/>optional TLS"| Redis["Redis / Valkey<br/>(go-redis/v9)"]
    Feast -->|"online store"| MySQL["MySQL<br/>(go-sql-driver)"]
    Feast -->|"online store"| SQLite["SQLite<br/>(go-sqlite3)"]
    Feast -->|"online store<br/>AWS IAM"| DynamoDB["DynamoDB<br/>(aws-sdk-go-v2)"]

    %% Registry Store Backends
    Feast -->|"registry store<br/>5s timeout"| GCS["Google Cloud Storage<br/>(cloud.google.com/go)"]
    Feast -->|"registry store<br/>5s timeout"| S3["S3-compatible Storage<br/>(aws-sdk-go-v2)"]

    %% Python Runtime
    Feast -->|"Python runtime"| Python["Python >=3.10"]
    Feast -->|"REST API"| FastAPI["FastAPI >=0.68"]
    Feast -->|"ASGI server"| Uvicorn["Uvicorn"]
    Feast -->|"gRPC transport"| gRPC["grpcio >=1.56.2"]

    %% Internal RHOAI Dependencies
    Feast -->|"CRD watch"| FeastCRD["Feast FeatureStore CRD<br/>(feast.dev)"]
    Feast -->|"CRD CRUD"| KubeflowNB["Kubeflow Notebooks<br/>(kubeflow.org)"]
    Feast -->|"CRD CRUD"| PrometheusOp["prometheus-operator<br/>(monitoring.coreos.com)"]
    Feast -->|"Spark jobs"| SparkOp["Spark Operator<br/>(sparkoperator.k8s.io)"]

    %% Platform Integrations
    Feast -->|"distributed compute"| Ray["Ray >=2.47"]
    Feast -->|"data lineage"| OpenLineage["OpenLineage >=1.40"]
    Feast -->|"experiment tracking"| MLflow["MLflow >=2.10"]

    %% Key Data Libraries
    Feast -->|"data processing"| Arrow["Apache Arrow<br/>(Go v17 + PyArrow)"]
    Feast -->|"serialization"| Protobuf["protobuf<br/>(Go + Python)"]

    %% Observability
    Feast -->|"metrics"| Prometheus["Prometheus client<br/>(Go + Python)"]
    Feast -->|"tracing"| OpenTelemetry["OpenTelemetry v1.44"]

    %% Kubernetes API
    Feast -->|"resource management<br/>HTTPS :6443"| K8sAPI["Kubernetes API"]

    %% OpenShift
    Feast -->|"route management"| OpenShift["OpenShift API<br/>(route.openshift.io)"]

