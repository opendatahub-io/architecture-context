graph TD
    subgraph "Security Model"
        direction TB

        subgraph "Application Layer"
            Server["Llama Stack Server<br/>Port 8321/TCP"]
            Note1["No application-level<br/>authentication or RBAC<br/>configured by this component"]
        end

        subgraph "Platform Layer (RHOAI / OpenShift)"
            PlatformAuth["Platform Authentication<br/>(OpenShift OAuth / OIDC / mTLS)"]
            PlatformAuthz["Platform Authorization<br/>(OpenShift RBAC / NetworkPolicy)"]
            TLSTermination["TLS Termination<br/>(OpenShift Route / Istio Gateway)"]
        end

        subgraph "Credential Management"
            direction LR
            InferenceCreds["Inference Provider Credentials<br/>AWS IAM, API Keys, SA Creds<br/>(injected via env vars)"]
            StorageCreds["Storage Credentials<br/>PostgreSQL user/pass<br/>Vector DB auth<br/>(injected via env vars)"]
            OTELConfig["OTEL Configuration<br/>OTEL_SERVICE_NAME<br/>(optional env var)"]
        end

        subgraph "Provider Activation"
            direction LR
            EnvVarPattern["Environment Variable Pattern<br/>${env.VAR:+provider_id}<br/>Conditional activation"]
            DefaultPattern["Default Values<br/>${env.VAR:=default}<br/>Fallback configuration"]
        end
    end

    PlatformAuth -->|"enforces AuthN"| Server
    PlatformAuthz -->|"enforces AuthZ"| Server
    TLSTermination -->|"terminates TLS"| Server
    InferenceCreds -->|"env vars"| Server
    StorageCreds -->|"env vars"| Server
    OTELConfig -.->|"optional env var"| Server
    EnvVarPattern -->|"activates providers"| Server
    DefaultPattern -->|"configures defaults"| Server

    style Server fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Note1 fill:#fff3cd,stroke:#ffc107,stroke-width:1px
    style PlatformAuth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style PlatformAuthz fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style TLSTermination fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style InferenceCreds fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style StorageCreds fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style OTELConfig fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style EnvVarPattern fill:#d5e8d4,stroke:#82b366
    style DefaultPattern fill:#d5e8d4,stroke:#82b366
