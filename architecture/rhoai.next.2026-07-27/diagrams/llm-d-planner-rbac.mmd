graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["planner-backend<br/>Namespace: planner"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)<br/>Namespace: planner"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph APIResources["API Resources"]
        Nodes["core (v1)<br/>nodes"]
    end

    subgraph EffectiveAccess["Effective Access"]
        direction LR
        ListNodes["List cluster nodes<br/>for GPU detection"]
    end

    subgraph KServeAccess["KServe API Access (via Kubernetes API)"]
        InferenceService["serving.kserve.io<br/>InferenceService"]
        Note["Note: KServe access is via<br/>Kubernetes API; additional RBAC<br/>may be required for<br/>InferenceService CRUD operations"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes
    Nodes -->|"enables"| ListNodes

    SA -.->|"uses for deployment"| InferenceService
    InferenceService --- Note

    %% Styles
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#e8e8e8,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style Nodes fill:#7ed321,stroke:#333
    style ListNodes fill:#d5e8d4,stroke:#82b366
    style InferenceService fill:#fff2cc,stroke:#d6b656
    style Note fill:#f9f9f9,stroke:#ccc,stroke-dasharray: 5 5
