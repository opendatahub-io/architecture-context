graph TD
    subgraph "Service Account"
        SA["modelservice-controller-manager<br/>(modelservice-system)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["modelservice-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_EPP["modelservice-manager-epp-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_MetricsAuth["modelservice-metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        RB_LeaderElect["modelservice-leader-election-rolebinding<br/>(RoleBinding, modelservice-system)"]
    end

    subgraph "Cluster Roles"
        CR_Manager["modelservice-manager-role<br/>(ClusterRole)"]
        CR_EPP["$EPP_CLUSTER_ROLE<br/>(ClusterRole, configurable)"]
        CR_MetricsAuth["modelservice-metrics-auth-role<br/>(ClusterRole)"]
        CR_MetricsReader["modelservice-metrics-reader<br/>(ClusterRole)"]
        R_LeaderElect["modelservice-leader-election-role<br/>(Role, modelservice-system)"]
    end

    subgraph "Aggregate Roles (for users)"
        CR_Admin["modelservice-modelservice-admin-role"]
        CR_Editor["modelservice-modelservice-editor-role"]
        CR_Viewer["modelservice-modelservice-viewer-role"]
    end

    %% Bindings
    SA -->|bound via| CRB_Manager
    SA -->|bound via| CRB_EPP
    SA -->|bound via| CRB_MetricsAuth
    SA -->|bound via| RB_LeaderElect

    CRB_Manager -->|grants| CR_Manager
    CRB_EPP -->|grants| CR_EPP
    CRB_MetricsAuth -->|grants| CR_MetricsAuth
    RB_LeaderElect -->|grants| R_LeaderElect

    subgraph "Manager Role Resources"
        direction TB
        MS_Full["llm-d.ai<br/>ModelService<br/>get,list,watch,create,<br/>update,patch,delete"]
        MS_Status["llm-d.ai<br/>ModelService/status<br/>get,update,patch"]
        MS_Finalizers["llm-d.ai<br/>ModelService/finalizers<br/>update"]
        Deployments["apps<br/>Deployments<br/>get,list,watch,create,<br/>update,patch,delete"]
        DeployScale["apps<br/>Deployments/scale<br/>update,patch"]
        HTTPRoutes["gateway.networking.k8s.io<br/>HTTPRoutes<br/>get,list,watch,create,<br/>update,patch,delete"]
        InfResources["inference.networking.x-k8s.io<br/>InferenceModels, InferencePools<br/>get,list,watch,create,<br/>update,patch,delete"]
        ConfigMapsSA["core<br/>ConfigMaps, ServiceAccounts<br/>get,list,watch,create,<br/>update,patch,delete"]
        Services["core<br/>Services<br/>list,watch,create,<br/>update,patch,delete"]
        RoleBindingsRes["rbac.authorization.k8s.io<br/>RoleBindings<br/>get,list,watch,create,<br/>update,patch,delete"]
    end

    CR_Manager -->|grants access| MS_Full
    CR_Manager -->|grants access| MS_Status
    CR_Manager -->|grants access| MS_Finalizers
    CR_Manager -->|grants access| Deployments
    CR_Manager -->|grants access| DeployScale
    CR_Manager -->|grants access| HTTPRoutes
    CR_Manager -->|grants access| InfResources
    CR_Manager -->|grants access| ConfigMapsSA
    CR_Manager -->|grants access| Services
    CR_Manager -->|grants access| RoleBindingsRes

    subgraph "Metrics Auth Resources"
        TokenReviews["authentication.k8s.io<br/>TokenReviews<br/>create"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews<br/>create"]
    end

    CR_MetricsAuth -->|grants access| TokenReviews
    CR_MetricsAuth -->|grants access| SAR

    subgraph "Metrics Reader Resources"
        MetricsURL["/metrics<br/>(nonResourceURL)<br/>get"]
    end

    CR_MetricsReader -->|grants access| MetricsURL

    subgraph "Leader Election Resources"
        LE_ConfigMaps["core<br/>ConfigMaps<br/>get,list,watch,create,<br/>update,patch,delete"]
        LE_Leases["coordination.k8s.io<br/>Leases<br/>get,list,watch,create,<br/>update,patch,delete"]
        LE_Events["core<br/>Events<br/>create,patch"]
    end

    R_LeaderElect -->|grants access| LE_ConfigMaps
    R_LeaderElect -->|grants access| LE_Leases
    R_LeaderElect -->|grants access| LE_Events

    subgraph "User-Facing Aggregate Permissions"
        Admin_MS["ModelService: *<br/>ModelService/status: get"]
        Editor_MS["ModelService: create,delete,get,<br/>list,patch,update,watch<br/>ModelService/status: get"]
        Viewer_MS["ModelService: get,list,watch<br/>ModelService/status: get"]
    end

    CR_Admin -->|grants| Admin_MS
    CR_Editor -->|grants| Editor_MS
    CR_Viewer -->|grants| Viewer_MS

