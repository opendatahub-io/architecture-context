graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External gRPC Client"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (ClusterIP)"]
        Service["model-mesh Service<br/>ClusterIP<br/>8033/TCP → grpc"]
    end

    subgraph Pod["POD (Sidecar Pattern)"]
        direction TB

        subgraph MMContainer["Container: mm (kserve/modelmesh:latest)"]
            APIServer["ModelMeshApi<br/>gRPC Server<br/>8033/TCP"]
            Health["Health Probes<br/>8089/TCP HTTP<br/>/live, /ready"]
        end

        subgraph RuntimeContainer["Collocated Model Runtime"]
            Runtime["ModelRuntime<br/>gRPC Service"]
        end

        APIServer -->|"UDS: /tmp/mmesh/grpc.sock<br/>or TCP: 8085/TCP<br/>gRPC, No encryption (local)"| Runtime
    end

    subgraph MeshInstances["INTER-INSTANCE MESH"]
        OtherInstances["Other ModelMesh Instances<br/>litelinks discovery"]
    end

    subgraph Coordination["DISTRIBUTED COORDINATION"]
        etcd["etcd<br/>KVTable (128 buckets)<br/>Model Registry + Leader Election"]
    end

    %% Flows
    Client -->|"gRPC/8033<br/>Encryption: Unknown<br/>Auth: Unknown<br/>Headers: mm-model-id"| Service
    Service -->|"TCP/8033<br/>Internal routing"| APIServer
    APIServer -->|"Thrift (litelinks)<br/>Encryption: Unknown<br/>Request forwarding"| OtherInstances
    APIServer -->|"KVTable protocol<br/>Encryption: Unknown<br/>Model state + coordination"| etcd

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef clusterip fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef mesh fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef coordination fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Service clusterip
    class APIServer,Health,Runtime pod
    class OtherInstances mesh
    class etcd coordination
