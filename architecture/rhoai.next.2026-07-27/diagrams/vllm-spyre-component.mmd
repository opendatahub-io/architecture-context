graph TB
    subgraph "vllm-spyre Container (UID 2000)"
        direction TB
        Uvicorn["uvicorn<br/>HTTP Server"]
        OpenAIAPI["OpenAI-Compatible API<br/>Port 8000/TCP"]
        TGISAdapter["vllm_tgis_adapter<br/>gRPC Adapter"]
        TGISAPI["TGIS-Compatible gRPC API<br/>Port 8033/TCP"]
        VLLMEngine["vLLM Inference Engine"]
        SpyreBackend["IBM Spyre Accelerator<br/>Backend"]

        Uvicorn --> OpenAIAPI
        TGISAdapter --> TGISAPI
        OpenAIAPI -->|routes to| VLLMEngine
        TGISAPI -->|routes to| VLLMEngine
        VLLMEngine -->|executes on| SpyreBackend
    end

    Client["Inference Client"] -->|HTTP :8000| Uvicorn
    GRPCClient["gRPC Client"] -->|gRPC :8033| TGISAdapter

    subgraph "Model Sources"
        HFHub["Hugging Face Hub"]
        Volume["Pre-mounted Volume"]
    end

    VLLMEngine -->|loads weights| HFHub
    VLLMEngine -->|loads weights| Volume

    subgraph "External Management"
        KServe["KServe / ServingRuntime<br/>(deploys container)"]
        Konflux["Konflux Pipeline<br/>(builds image)"]
    end

    KServe -.->|manages| Uvicorn
    Konflux -.->|builds| SpyreBackend

    subgraph "Base Image"
        BaseImg["rhaiis/vllm-spyre-rhel9:3.2.2<br/>RHEL 9 / x86_64"]
    end

    BaseImg -.->|provides| SpyreBackend

    style Uvicorn fill:#4a90e2,stroke:#333
    style TGISAdapter fill:#4a90e2,stroke:#333
    style VLLMEngine fill:#4a90e2,stroke:#333
    style SpyreBackend fill:#9b59b6,stroke:#333
    style OpenAIAPI fill:#3498db,stroke:#333
    style TGISAPI fill:#3498db,stroke:#333
    style Client fill:#f5a623,stroke:#333
    style GRPCClient fill:#f5a623,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style Volume fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style Konflux fill:#7ed321,stroke:#333
    style BaseImg fill:#ddd,stroke:#333
