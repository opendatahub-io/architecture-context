graph LR
    DSP["Data Science Pipelines<br/>(Kubeflow Pipelines)"]

    %% Core Runtime Dependencies
    DSP -->|"workflow execution"| ArgoWF["Argo Workflows v3.7.14"]
    DSP -->|"metadata store"| MLMD["ML Metadata Store 1.14.0"]
    DSP -->|"gRPC proxy"| Envoy["Envoy Proxy"]
    DSP -->|"database backend"| MySQL["MySQL 8.4"]
    DSP -->|"artifact storage"| SeaweedFS["SeaweedFS 4.30"]

    %% Kubernetes Infrastructure
    DSP -->|"resource mgmt<br/>RBAC, CRDs"| K8sAPI["Kubernetes API"]
    DSP -->|"webhook certs"| K8sAdmission["Admission Webhooks"]

    %% Internal ODH Dependencies
    DSP -->|"monitoring<br/>scrape /metrics"| Prometheus["Prometheus"]
    DSP -.->|"notebook workbenches"| KubeflowNotebooks["Kubeflow Notebooks"]

    %% Key Go Module Dependencies
    DSP -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    DSP -->|"gRPC framework"| GRPC["google.golang.org/grpc 1.80.0"]
    DSP -->|"S3 client"| AWSSDK["aws-sdk-go-v2"]
    DSP -->|"S3 client"| MinioGo["minio-go v7"]
    DSP -->|"ORM"| GORM["gorm.io/gorm 1.30.1"]
    DSP -->|"SQL builder"| Squirrel["Masterminds/squirrel"]
    DSP -->|"HTTP routing"| GorillaMux["gorilla/mux 1.8.1"]
    DSP -->|"cloud storage"| GoCloud["gocloud.dev 0.40.0"]

    %% Runtime
    DSP -->|"runtime"| Go["Go 1.26"]

    %% External Integration
    DSP -->|"runtime object storage"| S3External["S3-compatible Storage"]

    %% Downstream consumers (who depends on DSP)
    ODHDashboard["ODH Dashboard"] -.->|"pipeline UI"| DSP
    Workbenches["Data Science Workbenches"] -.->|"submit pipelines"| DSP

    %% Styling
    style DSP fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Core runtime - red
    style ArgoWF fill:#e74c3c,stroke:#333,color:#fff
    style MLMD fill:#e74c3c,stroke:#333,color:#fff
    style Envoy fill:#e74c3c,stroke:#333,color:#fff
    style MySQL fill:#e74c3c,stroke:#333,color:#fff
    style SeaweedFS fill:#e74c3c,stroke:#333,color:#fff

    %% Infrastructure - grey
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style K8sAdmission fill:#999,stroke:#333,color:#fff

    %% Internal ODH - green
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style KubeflowNotebooks fill:#7ed321,stroke:#333,color:#fff

    %% Go modules - light blue
    style ControllerRuntime fill:#85c1e9,stroke:#333
    style GRPC fill:#85c1e9,stroke:#333
    style AWSSDK fill:#85c1e9,stroke:#333
    style MinioGo fill:#85c1e9,stroke:#333
    style GORM fill:#85c1e9,stroke:#333
    style Squirrel fill:#85c1e9,stroke:#333
    style GorillaMux fill:#85c1e9,stroke:#333
    style GoCloud fill:#85c1e9,stroke:#333
    style Go fill:#85c1e9,stroke:#333

