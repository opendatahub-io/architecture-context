graph TD
    subgraph AuthMechanisms["Authentication Mechanisms"]
        SATokens["ServiceAccount Tokens<br/>All 39 operator/controller components<br/>In-cluster kubeconfig"]
        KubeRBACProxy["kube-rbac-proxy Sidecar<br/>Dashboard, metrics endpoints<br/>TokenReview + SubjectAccessReview"]
        OAuthProxy["OAuthProxy Sidecar Injection<br/>KServe InferenceService pods<br/>Per-service authentication"]
        KuadrantAuth["Kuadrant AuthPolicy<br/>models-as-a-service<br/>API key + TokenReview + OIDC JWT"]
        BearerTokenReview["Bearer Token via TokenReview<br/>MaaS API, InferenceGraph router<br/>Application-level validation"]
        ClusterTLSProfile["OpenShift Cluster TLS Profile<br/>training-operator, DSPO, rhods-operator<br/>Intermediate fallback: TLS 1.2, AEAD"]
        CertMgrCA["cert-manager CA Injection<br/>kserve, agents-op, kuberay, ai-gateway-op<br/>Webhook certificate management"]
        OPACert["OPA cert-controller<br/>kueue, training-operator<br/>Internal webhook TLS rotation"]
    end

    subgraph KeyServiceAccounts["Key ServiceAccounts"]
        SA_rhods["rhods-operator<br/>Namespace: redhat-ods-operator"]
        SA_kserve["kserve-controller-manager<br/>Namespace: redhat-ods-applications"]
        SA_dashboard["odh-dashboard<br/>Namespace: redhat-ods-applications"]
        SA_kueue["kueue-controller-manager<br/>Namespace: redhat-ods-applications"]
        SA_maas["models-as-a-service<br/>Namespace: redhat-ods-applications"]
        SA_training["training-operator<br/>Namespace: redhat-ods-applications"]
        SA_codeflare["codeflare-operator<br/>Namespace: redhat-ods-applications"]
    end

    subgraph ClusterRoles["ClusterRoles (Most Privileged)"]
        CR_rhods["rhods-operator<br/>27 CRD kinds, 7 API groups<br/>Full platform orchestration"]
        CR_kserve["kserve-manager-role<br/>serving.kserve.io/*<br/>InferenceService lifecycle"]
        CR_kueue["kueue-controller-role<br/>kueue.x-k8s.io/*<br/>10+ workload framework CRDs"]
        CR_dashboard["odh-dashboard-role<br/>opendatahub.io/*<br/>18 component integrations"]
        CR_maas["maas-controller-role<br/>AITenant, MaaSSubscription<br/>Multi-tenant model marketplace"]
        CR_training["training-operator-role<br/>kubeflow.org/pytorchjobs<br/>mpijobs, tfjobs + 3 more"]
    end

    subgraph AdmissionWebhooks["Admission Webhook Security (218 total)"]
        WH_kueue["Kueue: 31 webhooks<br/>14 mutating, 16 validating, 1 conversion<br/>Spans 10 workload frameworks<br/>CRITICAL: Outage blocks all workloads"]
        WH_kserve["KServe: 23 webhooks<br/>8 mutating, 14 validating, 1 conversion<br/>InferenceService + pod mutation"]
        WH_rhods["rhods-operator: 11 webhooks<br/>4 mutating, 6 validating, 1 conversion<br/>Cross-component (notebooks, dashboards)"]
        WH_spark["spark-operator: 15 webhooks<br/>8 mutating, 6 validating, 1 conversion"]
        WH_policy["ALL: failurePolicy Fail<br/>218 registrations, 24 components<br/>Strict admission — reject on unavailability"]
    end

    subgraph ContainerSecurity["Container Security Patterns"]
        CS_UBI["UBI9-minimal Base Images<br/>Most Go-based operators/controllers<br/>Reduced attack surface"]
        CS_NonRoot["Non-root Execution (UID 1001)<br/>models-as-a-service + controllers<br/>runAsNonRoot, readOnlyRootFilesystem"]
        CS_CapDrop["Capability Drop (ALL)<br/>All controllers<br/>seccompProfile: RuntimeDefault"]
        CS_FIPS["FIPS-compliant Builds<br/>models-as-a-service<br/>GOEXPERIMENT=strictfipsruntime<br/>CGO_ENABLED=1, FIPS 140-2"]
        CS_Informers["Label-selector Filtered Informers<br/>training-operator, kueue<br/>Prevents unbounded memory growth"]
    end

    subgraph TLSConfig["TLS Configuration"]
        TLS_Webhooks["Admission Webhooks<br/>9443/TCP, API server mTLS<br/>cert-manager or OPA cert-controller"]
        TLS_Metrics["Metrics Endpoints<br/>8443/TCP, HTTPS<br/>kube-rbac-proxy (transitioning<br/>to controller-runtime native)"]
        TLS_Gateway["Gateway Ingress<br/>443/TCP, TLS termination<br/>data-science-gateway"]
        TLS_NIXL["llm-d KV-cache Transfer<br/>5600/TCP, inter-pod<br/>NIXL protocol"]
    end

    subgraph CrossComponentRisks["Cross-Component Coordination Risks"]
        Risk_PodMutation["3-Way Pod Mutation<br/>KServe + odh-model-controller + Kueue<br/>Order depends on webhook timestamp"]
        Risk_RayCluster["3-Way RayCluster Admission<br/>CodeFlare + KubeRay + Kueue<br/>Mutate/validate from 3 sources"]
        Risk_Notebook["Notebook Injection (dual)<br/>rhods-operator + workbenches-operator<br/>Only one should be active"]
    end

    %% RBAC Bindings
    SA_rhods -->|bound to| CR_rhods
    SA_kserve -->|bound to| CR_kserve
    SA_dashboard -->|bound to| CR_dashboard
    SA_kueue -->|bound to| CR_kueue
    SA_maas -->|bound to| CR_maas
    SA_training -->|bound to| CR_training

    %% Auth mechanism usage
    SATokens -->|used by| SA_rhods
    SATokens -->|used by| SA_kserve
    SATokens -->|used by| SA_dashboard
    SATokens -->|used by| SA_kueue
    KubeRBACProxy -->|protects| SA_dashboard
    OAuthProxy -->|injects into| SA_kserve
    KuadrantAuth -->|enforces for| SA_maas
    BearerTokenReview -->|validates for| SA_maas
    ClusterTLSProfile -->|configures| SA_training
    CertMgrCA -->|provisions certs| SA_kserve

    %% Webhook ownership
    SA_kueue -->|owns| WH_kueue
    SA_kserve -->|owns| WH_kserve
    SA_rhods -->|owns| WH_rhods

    %% TLS bindings
    CertMgrCA -->|provisions| TLS_Webhooks
    OPACert -->|provisions| TLS_Webhooks
    KubeRBACProxy -->|secures| TLS_Metrics
    KuadrantAuth -->|terminates| TLS_Gateway

    %% Coordination risks
    WH_kserve -->|pod mutation| Risk_PodMutation
    WH_kueue -->|pod mutation| Risk_PodMutation
    SA_codeflare -->|RayCluster| Risk_RayCluster
    WH_rhods -->|notebook injection| Risk_Notebook

