graph LR
    BatchGW["Batch Gateway<br/>(3 binaries)"]

    %% External Data Store Dependencies
    BatchGW -->|"job state<br/>pgx v5"| PostgreSQL["PostgreSQL"]
    BatchGW -->|"queue coordination<br/>go-redis v9"| Redis["Redis/Valkey"]
    BatchGW -->|"file storage<br/>AWS SDK v2"| S3["S3-Compatible<br/>Storage"]

    %% Internal Platform Dependencies
    BatchGW -->|"inference dispatch<br/>HTTP/HTTPS"| LLMd["llm-d Inference<br/>Gateway"]
    BatchGW -->|"async producer<br/>Go library"| LLMdAsync["llm-d-async<br/>v0.7.4"]

    %% Observability Dependencies
    BatchGW -->|"trace export<br/>OTLP/gRPC"| OTel["OpenTelemetry<br/>Collector"]

    %% Auth/Security Dependencies
    BatchGW -.->|"auth delegation<br/>ext_authz"| Envoy["Envoy Sidecar<br/>(ext_authz)"]

    %% Key Library Dependencies
    BatchGW -->|"HTTP client"| Resty["go-resty v2"]
    BatchGW -->|"metrics"| Prometheus["Prometheus<br/>client_golang"]
    BatchGW -->|"tracing"| OTelSDK["OpenTelemetry<br/>SDK v1.44"]

    %% Runtime
    BatchGW -->|"runtime"| Go["Go 1.25"]

