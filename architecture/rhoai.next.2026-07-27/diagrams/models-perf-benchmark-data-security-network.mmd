graph TB
    subgraph BuildTime["BUILD-TIME (Data Ingestion)"]
        direction TB
        APIClient["API Client CLI<br/>(Python)<br/>Retry: 3x, exp. backoff"]
    end

    subgraph External["EXTERNAL (Untrusted)"]
        BenchmarkAPI["External Benchmark REST API<br/>API_BASE_URL (configurable)<br/>7 paginated endpoints"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (Trusted)"]
        direction TB

        subgraph NS_ODH["Namespace: opendatahub"]
            Operator["model-registry-operator<br/>Manages deployment lifecycle"]
        end

        subgraph NS_Registry["Namespace: odh-model-registries"]
            subgraph ModelCatalogPod["model-catalog Deployment"]
                InitContainer["Init Container:<br/>models-perf-benchmark-data<br/>Data-only, no listeners,<br/>no runtime network"]
                AppContainer["model-catalog<br/>Application Container"]
            end
        end
    end

    subgraph ContainerReg["CONTAINER REGISTRY"]
        Image["Init Container Image<br/>Packaged benchmark data"]
    end

    %% Build-time flow
    APIClient -->|"HTTPS/443<br/>TLS (configurable verify)<br/>Auth: not specified"| BenchmarkAPI

    %% Runtime flows
    Operator -->|"Manages"| ModelCatalogPod
    Image -->|"Image pull"| InitContainer
    InitContainer -->|"Mount data<br/>to shared volume"| AppContainer

    %% Styling
    classDef buildtime fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef initcontainer fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef registry fill:#e6e6e6,stroke:#666,stroke-width:2px

    class APIClient buildtime
    class BenchmarkAPI external
    class Operator cluster
    class InitContainer initcontainer
    class AppContainer cluster
    class Image registry
