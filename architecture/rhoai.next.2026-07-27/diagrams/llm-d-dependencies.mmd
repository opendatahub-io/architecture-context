graph LR
    LLMD["llm-d<br/>Disaggregated LLM<br/>Inference Platform"]

    %% Gateway API Dependencies
    LLMD -->|"ingress routing"| GatewayAPI["Gateway API<br/>gateway.networking.k8s.io"]
    LLMD -->|"model routing"| InferenceExt["Gateway API<br/>Inference Extension<br/>inference.networking.k8s.io"]

    %% Runtime Dependencies
    LLMD -->|"sidecar proxy"| Envoy["Envoy Proxy<br/>(sidecar)"]
    LLMD -->|"tracing"| OTel["OpenTelemetry<br/>Collector"]
    LLMD -->|"metrics"| Prometheus["Prometheus<br/>monitoring.coreos.com<br/>PodMonitor"]

    %% CRD Dependencies
    LLMD -->|"routing backend"| InferencePool["InferencePool CRD<br/>inference.networking.k8s.io"]
    LLMD -->|"request routing"| HTTPRoute["HTTPRoute CRD<br/>gateway.networking.k8s.io"]

    %% Kubernetes Dependencies
    LLMD -->|"workload mgmt"| K8sAPI["Kubernetes API<br/>Deployments, Services"]

    %% Internal Component Dependencies
    subgraph "Internal Components"
        direction TB
        Prefill["Prefill Deployment<br/>Port: 8000, 5600"]
        Decode["Decode Deployment<br/>Port: 8000"]
        RouterEPP["Router EPP<br/>Helm-deployed"]
        Gateway["Inference Gateway<br/>Port: 80"]
    end

    Gateway -->|"routes to"| RouterEPP
    RouterEPP -->|"selects"| Prefill
    RouterEPP -->|"selects"| Decode
    Prefill -->|"NIXL KV-cache<br/>TCP/5600"| Decode

    LLMD --- Gateway

    style LLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style InferenceExt fill:#999,stroke:#333,color:#fff
    style Envoy fill:#999,stroke:#333,color:#fff
    style OTel fill:#f5a623,stroke:#333,color:#fff
    style Prometheus fill:#f5a623,stroke:#333,color:#fff
    style InferencePool fill:#e67e22,stroke:#333,color:#fff
    style HTTPRoute fill:#e67e22,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Prefill fill:#27ae60,stroke:#333,color:#fff
    style Decode fill:#27ae60,stroke:#333,color:#fff
    style RouterEPP fill:#9b59b6,stroke:#333,color:#fff
    style Gateway fill:#4a90e2,stroke:#333,color:#fff
