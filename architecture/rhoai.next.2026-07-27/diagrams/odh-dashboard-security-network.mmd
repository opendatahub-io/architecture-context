graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / Admin"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Gateway API<br/>data-science-gateway<br/>HTTPRoute"]
    end

    subgraph DashboardPod["DASHBOARD POD (redhat-ods-applications)"]
        direction TB

        subgraph AuthProxy["TLS Termination Layer"]
            KRBAC["kube-rbac-proxy<br/>:8443/TCP → :8080/TCP<br/>TLS termination<br/>OpenShift project validation<br/>Secret: dashboard-proxy-tls"]
        end

        subgraph BackendLayer["Backend Layer"]
            Backend["Node.js Backend (Fastify)<br/>:8080/TCP HTTP<br/>SA: odh-dashboard<br/>5 K8s API clients<br/>CRD-based service discovery"]
        end

        subgraph BFFLayer["Go BFF Sidecars (SA: odh-dashboard-modules)"]
            CoreBFF["core-bff<br/>:8043 HTTPS"]
            GenAI["gen-ai<br/>:8143 HTTPS"]
            MaaS["maas<br/>:8243 HTTPS"]
            MLflow["mlflow<br/>:8343 HTTPS"]
            EvalHub["eval-hub<br/>:8543 HTTPS"]
            AutoML["automl<br/>:8643 HTTPS"]
            AutoRAG["autorag<br/>:8743 HTTPS"]
            AgentOps["agent-ops<br/>:8843 HTTPS"]
        end

        subgraph OperatorLayer["Operator Layer"]
            Operator["Dashboard Operator<br/>SA: dashboard-operator<br/>Webhooks: /validate-dashboard,<br/>/validate-*-workspace*,<br/>/convert (HTTPS/TLS)"]
        end
    end

    subgraph InternalPlatform["INTERNAL PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>:6443 HTTPS/WSS<br/>TLS 1.2+<br/>SA token + impersonation"]
        DSPipelines["DataScience Pipelines<br/>:8443 HTTPS<br/>Bearer Token"]
        ModelRegistry["Model Registry API<br/>:8443 HTTPS<br/>Bearer Token"]
        ModelServing["Model Serving / KServe<br/>HTTPS<br/>Bearer Token"]
        MLMD["ML Metadata<br/>:8443 gRPC-web<br/>Bearer Token"]
        TrustyAI["TrustyAI Service<br/>:443 HTTPS<br/>Bearer Token"]
        Prometheus["Prometheus / Thanos<br/>:9092 HTTPS<br/>Bearer Token"]
        Perses["Perses Service<br/>:8080 HTTP<br/>user_token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        LlamaStack["Llama Stack Server<br/>HTTPS TLS<br/>Bearer / API Key"]
        MaaSAPI["MaaS API Server<br/>HTTPS TLS<br/>Bearer Token"]
        MLflowTracker["MLflow Tracking<br/>HTTPS TLS<br/>Session"]
        NeMo["NeMo Guardrails<br/>HTTPS TLS<br/>API Key"]
    end

    %% Flows
    User -->|"HTTPS<br/>OpenShift OAuth"| Gateway
    Gateway -->|"HTTPS :8443<br/>TLS"| KRBAC
    KRBAC -->|"HTTP :8080<br/>x-forwarded-access-token"| Backend
    Backend -->|"HTTPS :8043-8843<br/>user_token"| CoreBFF
    Backend -->|"HTTPS :8043-8843<br/>user_token"| GenAI

    %% Backend egress
    Backend -->|"HTTPS/WSS :6443<br/>SA + impersonation"| K8sAPI
    Backend -->|"HTTPS :8443<br/>Bearer Token"| DSPipelines
    Backend -->|"HTTPS :8443<br/>Bearer Token"| ModelRegistry
    Backend -->|"HTTPS<br/>Bearer Token"| ModelServing
    Backend -->|"gRPC-web :8443<br/>Bearer Token"| MLMD
    Backend -->|"HTTPS :443<br/>Bearer Token"| TrustyAI
    Backend -->|"HTTPS :9092<br/>Bearer Token"| Prometheus
    Backend -->|"HTTP :8080<br/>user_token"| Perses

    %% BFF egress
    GenAI -->|"HTTPS<br/>Bearer / API Key"| LlamaStack
    GenAI -->|"HTTPS<br/>API Key"| NeMo
    MaaS -->|"HTTPS<br/>Bearer Token"| MaaSAPI
    MLflow -->|"HTTPS<br/>Session"| MLflowTracker

    %% BFF → K8s
    CoreBFF -->|"HTTPS :6443<br/>SSAR"| K8sAPI
    Operator -->|"HTTPS :6443<br/>SA token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#e8a838,stroke:#333,stroke-width:2px
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef bff fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef internalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Gateway ingress
    class KRBAC auth
    class Backend backend
    class CoreBFF,GenAI,MaaS,MLflow,EvalHub,AutoML,AutoRAG,AgentOps bff
    class Operator operator
    class K8sAPI,DSPipelines,ModelRegistry,ModelServing,MLMD,TrustyAI,Prometheus,Perses internalservice
    class LlamaStack,MaaSAPI,MLflowTracker,NeMo externalservice
