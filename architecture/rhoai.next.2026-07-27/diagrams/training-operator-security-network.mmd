graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token / kubeconfig"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph OperatorPod["kubeflow-training-operator (Deployment)"]
            direction LR
            WebhookServer["Webhook Server<br/>9443/TCP<br/>TLS (OpenShift profile)<br/>Kubernetes admission"]
            MetricsServer["Metrics Server<br/>8080/TCP<br/>TLS (OpenShift profile)<br/>prometheus.io/scrape"]
            HealthProbe["Health Probes<br/>8081/TCP<br/>HTTP (no TLS)<br/>Unauthenticated"]
        end

        WebhookCert["kubeflow-training-operator-webhook-cert<br/>Secret (TLS)<br/>cert-controller auto-rotation"]
    end

    subgraph UserNS["MANAGED RESOURCES (User Namespaces)"]
        direction TB
        WorkerPods["Worker Pods<br/>SA: per-job ServiceAccount"]
        JobServices["Job Services<br/>Inter-worker communication"]
        NetPolicies["NetworkPolicies<br/>Job isolation"]
        PodGroups["PodGroups (optional)<br/>Volcano / scheduler-plugins"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Inbound scrape"]
    end

    subgraph PlatformConfig["PLATFORM CONFIGURATION"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS profile source"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| K8sAPI

    %% Control Plane → Operator (admission webhooks)
    K8sAPI -->|"HTTPS/9443<br/>TLS (cluster profile)<br/>Kubernetes admission<br/>Failure Policy: Fail"| WebhookServer

    %% Operator → Control Plane (watches, CRUD)
    OperatorPod -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA: kubeflow-training-operator"| K8sAPI

    %% Operator → Managed Resources
    OperatorPod -->|"via K8s API<br/>Creates Pods, Services,<br/>SAs, Roles, NetworkPolicies"| UserNS

    %% Operator → Platform Config
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>GET APIServer<br/>10s timeout + fallback"| OpenShiftAPI

    %% Monitoring → Operator
    Prometheus -->|"HTTPS/8080<br/>TLS (cluster profile)<br/>prometheus.io/scrape"| MetricsServer

    %% Cert management
    WebhookCert -.->|"TLS certs"| WebhookServer
    WebhookCert -.->|"TLS certs"| MetricsServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class K8sAPI controlplane
    class WebhookServer,MetricsServer,HealthProbe operator
    class WorkerPods,JobServices,NetPolicies,PodGroups managed
    class Prometheus monitoring
    class OpenShiftAPI platform
    class WebhookCert secret
