graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Inference Client"]
    end

    subgraph ServingLayer["RHOAI SERVING LAYER (Platform-Managed)"]
        Gateway["RHOAI Model Serving Gateway<br/>TLS termination<br/>Auth: Platform-configured"]
    end

    subgraph AppPod["APPLICATION POD (Non-root UID 2000)"]
        direction TB

        subgraph VllmCore["vLLM Core"]
            APIServer["vLLM API Server<br/>OpenAI-compatible<br/>/v1/completions<br/>/v1/chat/completions"]
        end

        subgraph Plugin["vllm-gaudi Plugin"]
            HpuPlatform["HpuPlatform<br/>(platform backend)"]
            Worker["HPU Worker +<br/>Model Runner"]
            Attention["HPU Attention Backends<br/>(Unified, MLA, V1)"]
            CustomOps["HPU Custom Ops<br/>(FP8, MoE, Rotary)"]
            Quant["Quantization<br/>(fp8, inc, awq_hpu,<br/>gptq_hpu, modelopt)"]
        end
    end

    subgraph Hardware["HARDWARE LAYER"]
        direction TB

        GaudiHPU["Intel Gaudi HPU<br/>Habana Synapse AI 1.23.0<br/>PyTorch 2.9.0"]

        subgraph MultiDevice["Multi-Device (if configured)"]
            HCCL["HCCL<br/>Gaudi Interconnect<br/>Hardware-level"]
            NIXL["NIXL KV Connector<br/>Disaggregated Serving"]
        end
    end

    subgraph ContainerBase["CONTAINER BASE"]
        UBI["UBI 9.6 (RHEL 9)<br/>Python >=3.9, <3.13<br/>Non-root UID 2000"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS (platform-managed)<br/>Auth: Bearer/mTLS"| Gateway
    Gateway -->|"HTTP<br/>mTLS (if Service Mesh)<br/>Platform-assigned port"| APIServer
    APIServer -->|"Internal"| HpuPlatform
    HpuPlatform -->|"Directs execution"| Worker
    Worker -->|"Compute"| Attention
    Worker -->|"Compute"| CustomOps
    Worker -->|"Model loading"| Quant
    Worker -->|"Device access<br/>Habana driver"| GaudiHPU
    Worker -->|"Collective ops<br/>(all-reduce, all-gather)"| HCCL
    Worker -->|"KV cache transfer"| NIXL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef serving fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hardware fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef container fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Gateway serving
    class APIServer,HpuPlatform,Worker,Attention,CustomOps,Quant app
    class GaudiHPU,HCCL,NIXL hardware
    class UBI container
