graph LR
    TrainingOp["Training Operator<br/>kubeflow-training-operator"]

    %% Core Platform Dependencies
    TrainingOp -->|"HTTPS+WSS/6443<br/>SA token auth"| K8sAPI["Kubernetes API<br/>v0.31.3"]
    TrainingOp -->|"TLS profile read<br/>startup"| OpenShiftConfig["OpenShift APIServer<br/>config.openshift.io/v1"]
    TrainingOp -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.19.1"]

    %% Certificate Management
    TrainingOp -->|"cert rotation"| CertController["OPA cert-controller<br/>v0.12.0"]

    %% Optional Gang Scheduling
    TrainingOp -.->|"PodGroup CRUD<br/>(optional)"| Volcano["Volcano<br/>v1.9.0"]
    TrainingOp -.->|"PodGroup CRUD<br/>(optional)"| SchedulerPlugins["scheduler-plugins<br/>v0.28.9"]

    %% Internal RHOAI Dependencies
    TrainingOp -->|"CRD CRUD"| KubeflowNotebooks["Kubeflow Notebooks"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrape /metrics<br/>8080/TLS"| TrainingOp

    %% CRDs Managed
    TrainingOp -->|"reconciles"| PyTorchJob["PyTorchJob CRD"]
    TrainingOp -->|"reconciles"| TFJob["TFJob CRD"]
    TrainingOp -->|"reconciles"| MPIJob["MPIJob CRD"]
    TrainingOp -->|"reconciles"| XGBoostJob["XGBoostJob CRD"]
    TrainingOp -->|"reconciles"| PaddleJob["PaddleJob CRD"]
    TrainingOp -->|"reconciles"| JAXJob["JAXJob CRD"]

    %% Downstream Resources
    TrainingOp -->|"creates"| WorkerPods["Worker Pods"]
    TrainingOp -->|"creates"| Services["Services"]
    TrainingOp -->|"creates"| NetPolicies["NetworkPolicies"]
    TrainingOp -->|"creates (PyTorch)"| HPA["HorizontalPodAutoscaler"]

    %% Styling
    style TrainingOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OpenShiftConfig fill:#999,stroke:#333,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style CertController fill:#999,stroke:#333,color:#fff
    style Volcano fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style SchedulerPlugins fill:#ccc,stroke:#333,stroke-dasharray: 5 5
    style KubeflowNotebooks fill:#7ed321,stroke:#333,color:#fff
    style Prometheus fill:#7ed321,stroke:#333,color:#fff
    style PyTorchJob fill:#f5a623,stroke:#333
    style TFJob fill:#f5a623,stroke:#333
    style MPIJob fill:#f5a623,stroke:#333
    style XGBoostJob fill:#f5a623,stroke:#333
    style PaddleJob fill:#f5a623,stroke:#333
    style JAXJob fill:#f5a623,stroke:#333
    style WorkerPods fill:#fff2cc,stroke:#d6b656
    style Services fill:#fff2cc,stroke:#d6b656
    style NetPolicies fill:#fff2cc,stroke:#d6b656
    style HPA fill:#fff2cc,stroke:#d6b656
