graph TB
    subgraph KServeControllerManager["KServe Controller Manager<br/>(cmd/manager)"]
        ISController[InferenceService<br/>Controller]
        TMController[TrainedModel<br/>Controller]
        IGController[InferenceGraph<br/>Controller]
        ISWebhook[InferenceService<br/>Webhooks]
        SRWebhook[ServingRuntime<br/>Webhooks]
    end

    subgraph LLMISVCControllerManager["LLMInferenceService Controller Manager<br/>(cmd/llmisvc)"]
        LLMController[LLMInferenceService<br/>Controller]
        LLMConfigController[LLMInferenceServiceConfig<br/>Controller]
        LLMWebhook[LLMISVC<br/>Conversion Webhooks]
    end

    subgraph LocalModelControllerManager["LocalModel Controller Manager<br/>(cmd/localmodel)"]
        LMCacheController[LocalModelCache<br/>Controller]
        LMNSCacheController[LocalModelNamespaceCache<br/>Controller]
        LMNodeController[LocalModelNode<br/>Controller]
    end

    subgraph KserveModuleController["Kserve Module Controller<br/>(ODH/RHOAI Platform Integration)"]
        KserveModuleReconciler[KserveModule<br/>Reconciler]
    end

    subgraph RuntimeComponents["Runtime Components"]
        Agent[KServe Agent<br/>Sidecar<br/>(cmd/agent)]
        Router[InferenceGraph<br/>Router<br/>(cmd/router)]
    end

    subgraph ODHModelController["ODH Model Controller"]
        ModelServingAPI[model-serving-api<br/>Deployment]
        ODHController[odh-model-controller<br/>Deployment]
    end

    %% CRDs
    ISVC_CR[InferenceService CR<br/>v1beta1]
    LLMISVC_CR[LLMInferenceService CR<br/>v1alpha1/v1alpha2]
    IG_CR[InferenceGraph CR<br/>v1alpha1]
    LMC_CR[LocalModelCache CR<br/>v1alpha1]
    TM_CR[TrainedModel CR<br/>v1alpha1]
    KserveCR[Kserve CR<br/>components.platform]

    %% CR watches
    ISVC_CR -->|watched by| ISController
    LLMISVC_CR -->|watched by| LLMController
    IG_CR -->|watched by| IGController
    LMC_CR -->|watched by| LMCacheController
    TM_CR -->|watched by| TMController
    KserveCR -->|watched by| KserveModuleReconciler

    %% External dependencies
    K8sAPI[Kubernetes API<br/>6443/HTTPS]
    ISController -->|CRUD| K8sAPI
    LLMController -->|CRUD| K8sAPI
    KserveModuleReconciler -->|CRUD| K8sAPI

    %% Platform integrations
    CertManager[cert-manager]
    GatewayAPI[Gateway API]
    PrometheusOp[prometheus-operator]
    Istio[Istio Service Mesh]
    KEDA[KEDA]
    Knative[Knative Serving]

    KserveModuleReconciler -->|certificates| CertManager
    LLMController -->|routing| GatewayAPI
    ISController -->|autoscaling| Knative
    ISController -->|autoscaling| KEDA
    ODHController -->|monitoring| PrometheusOp
    Router -->|mesh detection| Istio

    %% Agent interactions
    Agent -->|model pull| ObjectStorage[Object Storage<br/>S3/GCS/Azure]
    Agent -->|reverse proxy| UserModel[User Model<br/>Container]

