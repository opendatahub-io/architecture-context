    style InferenceEngine fill:#4a90e2,stroke:#333,color:#fff
    style RESTServer fill:#4a90e2,stroke:#333,color:#fff
    style GRPCServer fill:#4a90e2,stroke:#333,color:#fff
    style ModelLoader fill:#4a90e2,stroke:#333,color:#fff
    style MetricsEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style MediaPipeGraph fill:#4a90e2,stroke:#333,color:#fff
    style ServingRuntime fill:#f5a623,stroke:#333,color:#333
    style InferenceService fill:#f5a623,stroke:#333,color:#333
    style Prometheus fill:#7ed321,stroke:#333,color:#333
    style ModelStorage fill:#e8e8e8,stroke:#333,color:#333
    style Client fill:#e8e8e8,stroke:#333,color:#333
