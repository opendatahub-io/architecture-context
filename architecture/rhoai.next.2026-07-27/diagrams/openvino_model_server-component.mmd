graph TB
    subgraph "OpenVINO Model Server (OVMS)"
        direction TB
        OVMSContainer["OVMS Container<br/>(kserve-container)<br/>Image: kserve-ovms-2026-2"]
        InferenceEngine["OpenVINO Inference Engine<br/>(C++ Core)"]
        RESTServer["REST API Server<br/>Port 8888"]
        GRPCServer["gRPC API Server<br/>Port 8001"]
        ModelLoader["Model Loader<br/>/mnt/models"]
        MetricsEndpoint["Metrics Endpoint<br/>/metrics :8888"]
        MediaPipeGraph["MediaPipe Graph<br/>Streaming Inference"]

        OVMSContainer --> RESTServer
        OVMSContainer --> GRPCServer
        OVMSContainer --> InferenceEngine
        OVMSContainer --> ModelLoader
        OVMSContainer --> MetricsEndpoint
        GRPCServer --> MediaPipeGraph
        MediaPipeGraph --> InferenceEngine
        RESTServer --> InferenceEngine
        ModelLoader -->|loads models| InferenceEngine
    end

    subgraph "KServe v2 REST APIs"
        KFSPredict["/v2/models/{model}:predict"]
        KFSInfer["/v2/models/{model}/infer"]
        KFSHealth["/v2/health/ready"]
        KFSMetadata["/v2/models/{model}"]
    end

    subgraph "OpenAI-Compatible REST APIs"
        ChatCompletion["/v3/chat/completions"]
        Completions["/v1/completions"]
        Embeddings["/v1/embeddings"]
    end

    subgraph "TensorFlow Serving APIs"
        TFSPredict["/v1/models/{model}:predict"]
        TFSClassify["/v1/models/{model}:classify"]
    end

    subgraph "gRPC Services"
        GRPCInfer["ModelInfer RPC"]
        GRPCStream["ModelStreamInfer RPC<br/>(Bidirectional Streaming)"]
        GRPCMetadata["ServerMetadata RPC"]
    end

    RESTServer --> KFSPredict
    RESTServer --> KFSInfer
    RESTServer --> KFSHealth
    RESTServer --> KFSMetadata
    RESTServer --> ChatCompletion
    RESTServer --> Completions
    RESTServer --> Embeddings
    RESTServer --> TFSPredict
    RESTServer --> TFSClassify
    GRPCServer --> GRPCInfer
    GRPCServer --> GRPCStream
    GRPCServer --> GRPCMetadata

    Client[Client Application] -->|REST :8888| RESTServer
    Client -->|gRPC :8001| GRPCServer

    ServingRuntime["KServe ServingRuntime CR<br/>serving.kserve.io/v1alpha1"] -->|defines| OVMSContainer
    InferenceService["InferenceService CR"] -->|creates pod with| OVMSContainer

    Prometheus["Prometheus"] -->|scrapes /metrics :8888| MetricsEndpoint

    ModelStorage["Model Storage<br/>(storageUri mount)"] -->|/mnt/models| ModelLoader

