graph TB
    subgraph External["External Access"]
        User[User / Client]
    end

    subgraph Routes["OpenShift Routes (TLS Edge)"]
        PlannerRoute["planner Route<br/>HTTPS"]
        BackendRoute["planner-backend Route<br/>HTTPS"]
    end

    subgraph PlannerNamespace["Namespace: planner"]
        subgraph UIComponent["UI Component"]
            UI["Streamlit UI<br/>quay.io/llm-d-planner/llm-d-planner-ui<br/>:8501/TCP"]
        end

        subgraph BackendComponent["Backend Component"]
            Backend["FastAPI Backend<br/>quay.io/llm-d-planner/llm-d-planner-backend<br/>:8000/TCP"]
            PlannerCore["Planner Core<br/>Python Service"]
            Backend --- PlannerCore
        end

        subgraph DataLayer["Data Layer"]
            Postgres["PostgreSQL 16<br/>registry.redhat.io/rhel9/postgresql-16<br/>:5432/TCP"]
            PostgresPVC["postgres-pvc<br/>5Gi RWO"]
            Postgres --- PostgresPVC
        end

        subgraph LLMLocal["Local LLM"]
            Ollama["Ollama Server<br/>ollama/ollama<br/>:11434/TCP<br/>Granite 3.3 2b"]
            OllamaPVC["ollama-pvc<br/>20Gi RWO"]
            OllamaGPU["nvidia.com/gpu: 1"]
            Ollama --- OllamaPVC
            Ollama --- OllamaGPU
        end
    end

    subgraph ExternalServices["External Services"]
        K8sAPI["Kubernetes API<br/>:6443/HTTPS"]
        OpenAIAPI["OpenAI-compatible API<br/>HTTPS"]
        VertexAI["Vertex AI<br/>HTTPS"]
        HFHub["HuggingFace Hub<br/>HTTPS"]
        ModelCatalog["Model Catalog<br/>HTTPS"]
        KServe["KServe API<br/>serving.kserve.io"]
    end

    %% User flows
    User -->|HTTPS| PlannerRoute
    User -->|HTTPS| BackendRoute
    PlannerRoute -->|HTTP :8501| UI
    BackendRoute -->|HTTP :8000| Backend

    %% Internal flows
    UI -->|HTTP :8000| Backend
    Backend -->|PostgreSQL :5432<br/>password auth| Postgres
    Backend -->|HTTP :11434| Ollama

    %% External integrations
    Backend -->|HTTPS :6443<br/>ServiceAccount| K8sAPI
    Backend -->|HTTPS<br/>API Key| OpenAIAPI
    Backend -->|HTTPS<br/>GCP SA| VertexAI
    Backend -->|HTTPS<br/>Bearer Token| HFHub
    Backend -->|HTTPS<br/>Bearer Token| ModelCatalog
    Backend -->|HTTPS<br/>RBAC| KServe

    %% Styles
    style UI fill:#4a90e2,stroke:#333,color:#fff
    style Backend fill:#4a90e2,stroke:#333,color:#fff
    style PlannerCore fill:#4a90e2,stroke:#333,color:#fff
    style Postgres fill:#336791,stroke:#333,color:#fff
    style Ollama fill:#7c3aed,stroke:#333,color:#fff
    style PlannerRoute fill:#e8e8e8,stroke:#333
    style BackendRoute fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style OpenAIAPI fill:#f5a623,stroke:#333
    style VertexAI fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style ModelCatalog fill:#f5a623,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style OllamaGPU fill:#76b900,stroke:#333,color:#fff
