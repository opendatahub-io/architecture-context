graph TB
    subgraph MetaOperator["Meta-Operator Layer"]
        rhods["rhods-operator<br/>Meta-Operator<br/>27 CRD kinds, 7 API groups"]
    end

    subgraph CorePlatform["Core Platform Services"]
        direction TB
        GatewayAPI["data-science-gateway<br/>Gateway API Ingress<br/>openshift-ingress ns"]
        PromOp["prometheus-operator<br/>Observability<br/>23 components integrate"]
        CertMgr["cert-manager<br/>TLS Certificates<br/>6 operators"]
        Kueue["Kueue<br/>Quota & Scheduling<br/>31 webhooks"]
    end

    subgraph InferenceStack["Inference Serving Stack"]
        direction TB
        KServe["KServe<br/>InferenceService<br/>11 components reference"]
        MaaS["models-as-a-service<br/>Multi-Tenant Model API<br/>Kuadrant AuthPolicy"]
        GAIE["gateway-api-inference-extension<br/>InferencePool Routing<br/>Envoy ext_proc"]
        ODHModelCtrl["odh-model-controller<br/>Platform Integration<br/>HTTPRoute, Monitoring"]
    end

    subgraph LLMdStack["llm-d Disaggregated Inference"]
        direction TB
        LLMdScheduler["llm-d-inference-scheduler<br/>Prefill-Decode Routing"]
        LLMdRouter["llm-d-router<br/>Token-Based Routing"]
        LLMdWVA["llm-d-workload-variant-autoscaler<br/>Autoscaling"]
        LLMdBatch["llm-d-batch-gateway<br/>Batch Inference"]
    end

    subgraph ServingRuntimes["Model Serving Runtimes"]
        direction TB
        vllm["vllm<br/>GPU Inference"]
        vllmCPU["vllm-cpu<br/>CPU Inference"]
        vllmGaudi["vllm-gaudi<br/>Gaudi Accelerator"]
        OpenVINO["openvino_model_server<br/>Intel Optimized"]
        ModelMesh["modelmesh<br/>Multi-Model Serving"]
        Caikit["caikit-tgis-serving<br/>NLP Runtime"]
    end

    subgraph MLWorkflow["ML Workflow Components"]
        direction TB
        Dashboard["odh-dashboard<br/>Unified UI<br/>18 outgoing deps"]
        DSPipelines["data-science-pipelines-operator<br/>Argo Workflows"]
        ModelRegistry["model-registry-operator<br/>Model Metadata"]
        Notebooks["kubeflow / workbenches<br/>Notebooks<br/>11 components reference"]
        MLMetadata["ml-metadata<br/>Lineage Tracking"]
    end

    subgraph TrainingStack["Distributed Training"]
        direction TB
        TrainingOp["training-operator<br/>PyTorchJob, MPIJob"]
        CodeFlare["codeflare-operator<br/>AppWrapper Orchestration"]
        KubeRay["kuberay<br/>RayCluster Management"]
        TrainerOp["trainer-operator<br/>Training CRDs"]
    end

    subgraph TrustSafety["Trust & Safety"]
        direction TB
        TrustyAI["trustyai-service-operator<br/>AI Explainability"]
        Guardrails["fms-guardrails-orchestrator<br/>Content Safety"]
        AgentsOp["agents-operator<br/>AI Agent Lifecycle"]
    end

    %% Meta-operator orchestration
    rhods -->|orchestrates| KServe
    rhods -->|orchestrates| Dashboard
    rhods -->|orchestrates| Kueue
    rhods -->|orchestrates| MaaS
    rhods -->|orchestrates| GAIE
    rhods -->|orchestrates| TrainingOp
    rhods -->|orchestrates| DSPipelines

    %% Core dependency tree from PLATFORM.md
    MaaS -->|routing| GAIE
    MaaS -->|serving| KServe
    KServe -->|routing| GAIE
    KServe -->|autoscaling| LLMdWVA
    LLMdWVA -->|watches InferencePool| GAIE

    %% Inference flow
    ODHModelCtrl -->|HTTPRoute creation| GatewayAPI
    ODHModelCtrl -->|platform injection| KServe
    GAIE -->|ext_proc routing| LLMdScheduler
    GAIE -->|ext_proc routing| LLMdRouter
    LLMdScheduler -->|prefill-decode| vllm
    LLMdBatch -->|batch requests| GAIE

    %% Dashboard integrations (most outgoing deps)
    Dashboard -->|model serving UI| KServe
    Dashboard -->|model catalog| ModelRegistry
    Dashboard -->|pipeline UI| DSPipelines
    Dashboard -->|workbench mgmt| Notebooks
    Dashboard -->|explainability| TrustyAI

    %% ML workflow
    DSPipelines -->|workflow execution| MLMetadata
    MLMetadata -->|model versions| ModelRegistry
    ModelRegistry -->|deploy models| KServe

    %% Training flow
    Kueue -->|quota admission| TrainingOp
    Kueue -->|quota admission| KubeRay
    Kueue -->|quota admission| CodeFlare
    CodeFlare -->|manages| KubeRay
    TrainerOp -->|training jobs| TrainingOp

    %% Cross-cutting concerns
    CertMgr -.->|TLS certs| KServe
    CertMgr -.->|TLS certs| AgentsOp
    CertMgr -.->|TLS certs| KubeRay
    PromOp -.->|metrics| KServe
    PromOp -.->|metrics| Dashboard
    PromOp -.->|metrics| Kueue
    PromOp -.->|metrics| TrainingOp

    %% Model serving runtimes
    KServe -->|serves via| vllm
    KServe -->|serves via| vllmCPU
    KServe -->|serves via| OpenVINO
    KServe -->|serves via| ModelMesh
    KServe -->|serves via| Caikit

