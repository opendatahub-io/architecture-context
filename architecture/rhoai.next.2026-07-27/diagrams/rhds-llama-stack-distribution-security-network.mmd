graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM LAYER (Auth Enforcement)"]
        direction TB
        PlatformAuth["Platform Auth Enforcement<br/>(OpenShift Route / Istio / Service Mesh)<br/>TLS Termination + AuthN/AuthZ"]
    end

    subgraph Application["APPLICATION LAYER (No App-Level Auth)"]
        direction TB
        Server["Llama Stack Server<br/>8321/TCP HTTP<br/>RHEL 9 Container<br/>x86_64 + aarch64<br/>Config: config.yaml + env vars"]
    end

    subgraph InferenceProviders["INFERENCE PROVIDERS (Egress)"]
        direction TB
        vLLM["vLLM<br/>HTTP/gRPC<br/>Provider Credentials"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        WatsonX["IBM WatsonX<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        AzureOAI["Azure OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
        VertexAI["Google Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Service Account"]
        OpenAI["OpenAI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>API Key"]
    end

    subgraph StorageBackends["STORAGE BACKENDS (Egress)"]
        direction TB
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS (configurable)<br/>Username/Password<br/>kv_postgres + sql_postgres"]
        Milvus["Milvus (Default)<br/>gRPC/HTTP<br/>Connection Credentials"]
        PgVector["PgVector<br/>5432/TCP<br/>Username/Password"]
        Qdrant["Qdrant<br/>HTTP/gRPC<br/>API Key"]
    end

    subgraph SafetyEval["SAFETY & EVALUATION (Egress)"]
        direction TB
        TrustyAI["TrustyAI FMS<br/>HTTP<br/>Safety Guardrails"]
        LMEval["TrustyAI LMEval<br/>HTTP"]
        RAGAS["RAGAS<br/>HTTP"]
        Garak["Garak<br/>HTTP<br/>Security Benchmarking"]
    end

    subgraph Observability["OBSERVABILITY (Egress - Optional)"]
        OTEL["OTLP Collector<br/>OTLP HTTP/gRPC<br/>Condition: OTEL_SERVICE_NAME set"]
    end

    %% Flows
    Client -->|"HTTP :8321<br/>Auth: Platform-enforced"| PlatformAuth
    PlatformAuth -->|"HTTP :8321<br/>No app-level auth"| Server

    Server -->|"HTTP/gRPC<br/>Provider creds (env)"| vLLM
    Server -->|"HTTPS/443<br/>TLS 1.2+ AWS IAM"| Bedrock
    Server -->|"HTTPS/443<br/>TLS 1.2+ API Key"| WatsonX
    Server -->|"HTTPS/443<br/>TLS 1.2+ API Key"| AzureOAI
    Server -->|"HTTPS/443<br/>TLS 1.2+ SA creds"| VertexAI
    Server -->|"HTTPS/443<br/>TLS 1.2+ API Key"| OpenAI

    Server -->|"TCP :5432<br/>TLS (config)<br/>user/pass"| PostgreSQL
    Server -->|"gRPC/HTTP<br/>Connection creds"| Milvus
    Server -->|"TCP :5432<br/>user/pass"| PgVector
    Server -->|"HTTP/gRPC<br/>API Key"| Qdrant

    Server -->|"HTTP<br/>Internal"| TrustyAI
    Server -->|"HTTP<br/>Internal"| LMEval
    Server -->|"HTTP<br/>Internal"| RAGAS
    Server -->|"HTTP<br/>Internal"| Garak

    Server -.->|"OTLP<br/>Traces + Metrics"| OTEL

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef safety fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#e8e8e8,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class PlatformAuth platform
    class Server application
    class vLLM,Bedrock,WatsonX,AzureOAI,VertexAI,OpenAI inference
    class PostgreSQL,Milvus,PgVector,Qdrant storage
    class TrustyAI,LMEval,RAGAS,Garak safety
    class OTEL observability
