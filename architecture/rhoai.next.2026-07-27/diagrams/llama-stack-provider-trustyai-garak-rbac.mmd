graph TD
    subgraph AdapterNote["llama-stack-provider-trustyai-garak"]
        Note["No RBAC ClusterRoles or RoleBindings<br/>defined by this component.<br/><br/>Relies on eval-hub platform RBAC<br/>for Kubernetes API access."]
    end

    subgraph CredentialModel["Credential & Authentication Model"]
        direction TB

        subgraph Roles["API Key Roles (6)"]
            TARGET["TARGET"]
            SDG_ROLE["SDG"]
            JUDGE["JUDGE"]
            ATTACKER["ATTACKER"]
            EVALUATOR["EVALUATOR"]
            TRANSLATION["TRANSLATION"]
        end

        subgraph ResolutionChain["5-Step Resolution Chain (per role)"]
            Step1["1. Role-specific env var<br/>(e.g., TARGET_API_KEY)"]
            Step2["2. Role-specific secret file"]
            Step3["3. Generic API_KEY env var"]
            Step4["4. api-key secret file"]
            Step5["5. DUMMY fallback"]
            Step1 -->|not found| Step2
            Step2 -->|not found| Step3
            Step3 -->|not found| Step4
            Step4 -->|not found| Step5
        end

        TARGET --> Step1
        SDG_ROLE --> Step1
        JUDGE --> Step1
        ATTACKER --> Step1
        EVALUATOR --> Step1
        TRANSLATION --> Step1
    end

    subgraph Secrets["Secret References"]
        APIKey["API_KEY<br/>(env var)"]
        KFPToken["KFP_AUTH_TOKEN<br/>(env var)"]
        OpenAIKey["OPENAICOMPATIBLE_API_KEY<br/>(env var)"]
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>(env var)"]
    end

    subgraph SecurityControls["Security Controls"]
        Redact["Redaction Policy<br/>All keys → *** before<br/>persistence to S3/OCI"]
        SidecarAuth["Sidecar Proxy Auth<br/>eval-hub ≥ 0.4.4<br/>Disables SA token auto-mount"]
    end

    ResolutionChain -->|resolved keys| Redact

