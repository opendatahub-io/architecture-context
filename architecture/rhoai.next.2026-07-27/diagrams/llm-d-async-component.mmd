graph TB
    subgraph "llm-d-async System"
        direction TB

        subgraph "Core Binary"
            Main["cmd/main.go<br/>Main Entry Point"]
            HealthServer["Health Server<br/>/healthz, /readyz"]
            Main -->|starts| HealthServer
        end

        subgraph "Pipeline Framework"
            Pipeline["pipeline.Gate Interface<br/>Flow Control"]
            BinaryGate["BinaryMetricDispatchGate<br/>Capacity Decisions"]
            Pipeline -->|implements| BinaryGate
        end

        subgraph "Sub-Modules"
            API["api (v0.7.4)<br/>Core API Types"]
            PipelineMod["pipeline (v0.7.4)<br/>Pipeline Processing"]
            Producer["producer (v0.7.4)<br/>Message Producers"]
        end

        subgraph "Message Queue Backends"
            RedisBackend["Redis/Valkey Backend<br/>Sorted Set Queue"]
            PubSubBackend["Google Cloud Pub/Sub<br/>Alternative Queue"]
        end

        Main -->|uses| PipelineMod
        PipelineMod -->|defines| Pipeline
        BinaryGate -->|queries metrics| PrometheusInt["Prometheus Query"]
        Producer -->|writes to| RedisBackend
        Producer -->|writes to| PubSubBackend
        API -->|types used by| PipelineMod
        API -->|types used by| Producer
    end

    subgraph "Model Server (Companion)"
        vLLM["vLLM Model Server<br/>Port 8000/TCP"]
        vLLM_Health["/health endpoint"]
        vLLM_Models["/v1/models endpoint"]
        vLLM_Metrics["/metrics endpoint"]
        vLLM -->|exposes| vLLM_Health
        vLLM -->|exposes| vLLM_Models
        vLLM -->|exposes| vLLM_Metrics
    end

    %% External Dependencies
    BinaryGate -->|queries queue depth| Prometheus["Prometheus<br/>inference_pool_average_queue_size"]
    BinaryGate -->|alternative| GMP["Google Managed Prometheus"]
    RedisBackend -->|connects to| Redis["Redis/Valkey<br/>Sorted Sets"]
    PubSubBackend -->|publishes to| PubSub["Google Cloud Pub/Sub"]
    Main -->|traces via| OTel["OpenTelemetry Collector"]
    Main -->|watches resources| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Gateway API Integration
    PipelineMod -->|uses runtime packages| GatewayExt["Gateway API<br/>Inference Extension"]

    %% Styling
    style Main fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style BinaryGate fill:#4a90e2,stroke:#333,color:#fff
    style Pipeline fill:#4a90e2,stroke:#333,color:#fff
    style API fill:#5ba3f5,stroke:#333,color:#fff
    style PipelineMod fill:#5ba3f5,stroke:#333,color:#fff
    style Producer fill:#5ba3f5,stroke:#333,color:#fff
    style RedisBackend fill:#7ed321,stroke:#333,color:#fff
    style PubSubBackend fill:#7ed321,stroke:#333,color:#fff
    style vLLM fill:#f5a623,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style GMP fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style PubSub fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style GatewayExt fill:#7ed321,stroke:#333,color:#fff
