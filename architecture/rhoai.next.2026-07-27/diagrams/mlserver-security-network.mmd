graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Inference Client"]
    end

    subgraph AuthProxy["AUTH PROXY (Platform-delegated)"]
        KubeRBACProxy["kube-rbac-proxy sidecar<br/>OpenShift OAuth validation<br/>ServiceAccount token auth"]
    end

    subgraph Application["APPLICATION (MLServer Pod)"]
        direction TB

        subgraph GRPCLayer["gRPC Server (insecure port)"]
            direction TB
            GRPCInference["GRPCInferenceService<br/>11 RPCs incl. streaming"]
            ModelRepo["ModelRepositoryService<br/>3 RPCs"]
            RuntimeSec["RuntimeSecurity RPC<br/>Security mode query"]
        end

        subgraph InterceptorChain["gRPC Interceptor Chain"]
            Logging["LoggingInterceptor<br/>access logging"]
            PromInterceptor["PromServerInterceptor<br/>Prometheus metrics"]
            OTelInterceptor["OpenTelemetry<br/>distributed tracing"]
        end

        subgraph RESTLayer["REST API"]
            FastAPI["FastAPI / uvicorn<br/>V2 Inference Protocol<br/>Auth: platform-delegated"]
        end

        subgraph RuntimeBackends["ML Runtime Backends"]
            Runtimes["10 pluggable runtimes<br/>sklearn, xgboost, lightgbm, onnx<br/>mlflow, huggingface, alibi-detect<br/>alibi-explain, catboost, mllib"]
        end
    end

    subgraph Egress["EGRESS (Outbound)"]
        OTLPCollector["OTLP Collector<br/>gRPC export<br/>Encryption: Unknown"]
        Kafka["Kafka<br/>aiokafka async<br/>Encryption: Unknown"]
        Triton["Triton Inference Server<br/>HTTP (tritonclient)<br/>Encryption: Unknown"]
        PromMetrics["Prometheus<br/>/metrics endpoint<br/>HTTP scrape"]
    end

    %% Flows
    Client -->|"gRPC / HTTPS<br/>TLS (platform-terminated)<br/>Bearer / SA Token"| KubeRBACProxy
    KubeRBACProxy -->|"gRPC (insecure)<br/>No TLS (pod-internal)<br/>Pre-validated"| GRPCInference
    KubeRBACProxy -->|"HTTP (insecure)<br/>No TLS (pod-internal)<br/>Pre-validated"| FastAPI

    GRPCInference --> InterceptorChain
    InterceptorChain --> RuntimeBackends
    FastAPI --> RuntimeBackends

    OTelInterceptor -.->|"gRPC<br/>OTLP traces"| OTLPCollector
    RuntimeBackends -.->|"Kafka protocol<br/>async events"| Kafka
    RuntimeBackends -.->|"HTTP<br/>protocol compat"| Triton
    PromInterceptor -.->|"HTTP<br/>metrics scrape"| PromMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authproxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class KubeRBACProxy authproxy
    class GRPCInference,ModelRepo,FastAPI,Runtimes,Logging,PromInterceptor,OTelInterceptor application
    class RuntimeSec security
    class OTLPCollector,Kafka,Triton,PromMetrics egress
