graph TB
    subgraph "must-gather Pod (Ephemeral)"
        direction TB
        Gather["gather.sh<br/>Orchestrator"]
        Common["common.sh<br/>Shared Library"]
        XKSUtil["xks_util.sh<br/>Distribution Detection"]

        Gather -->|sources| Common
        Gather -->|sources| XKSUtil

        subgraph "Component Collectors (Parallel)"
            direction LR
            Serving["gather_serving.sh<br/>KServe, Authorino,<br/>NIM, llm-d, Kuadrant"]
            DSP["gather_data_science_pipelines.sh<br/>DSP, Kubeflow, Argo"]
            Dashboard["gather_dashboard.sh<br/>Dashboard, Accelerator/<br/>HardwareProfiles"]
            MR["gather_mr.sh<br/>Model Registry"]
            AIGateway["gather_aigateway.sh<br/>MaaS, Inference,<br/>Batch Gateway"]
            MCP["gather_mcp_lifecycle_operator.sh<br/>MCP Lifecycle Operator"]
            Notebooks["gather_notebooks.sh<br/>Notebooks"]
            Monitoring["gather_monitoring.sh<br/>Monitoring"]
            Other["10+ other collectors"]
        end

        Gather -->|dispatches| Serving
        Gather -->|dispatches| DSP
        Gather -->|dispatches| Dashboard
        Gather -->|dispatches| MR
        Gather -->|dispatches| AIGateway
        Gather -->|dispatches| MCP
        Gather -->|dispatches| Notebooks
        Gather -->|dispatches| Monitoring
        Gather -->|dispatches| Other

        Serving -->|calls| Common
        DSP -->|calls| Common
        Dashboard -->|calls| Common
        MR -->|calls| Common
        AIGateway -->|calls| Common
        MCP -->|calls| Common
    end

    User["User / SRE"] -->|"oc adm must-gather<br/>--image=must-gather-image"| OC["OpenShift CLI"]
    OC -->|creates ephemeral pod| Gather

    Gather -->|"oc adm inspect<br/>oc get"| K8sAPI["Kubernetes API Server"]
    Common -->|"run_mustgather()<br/>collects logs & CRs"| K8sAPI

    Gather -->|writes| Output["must-gather/<br/>Output Directory"]

    style Gather fill:#4a90e2,color:#fff
    style Common fill:#4a90e2,color:#fff
    style XKSUtil fill:#4a90e2,color:#fff
    style Serving fill:#7ed321,color:#fff
    style DSP fill:#7ed321,color:#fff
    style Dashboard fill:#7ed321,color:#fff
    style MR fill:#7ed321,color:#fff
    style AIGateway fill:#7ed321,color:#fff
    style MCP fill:#7ed321,color:#fff
    style Notebooks fill:#7ed321,color:#fff
    style Monitoring fill:#7ed321,color:#fff
    style Other fill:#7ed321,color:#fff
    style K8sAPI fill:#f5a623,color:#fff
    style Output fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#333
    style OC fill:#e8e8e8,stroke:#333
