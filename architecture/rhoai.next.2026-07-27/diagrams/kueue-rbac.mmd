graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["kueue-controller-manager"]
        SA_MR["kueue-controller-manager<br/>-metrics-reader"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_MGR["kueue-manager-rolebinding"]
        CRB_METRICS["kueue-metrics-auth-rolebinding"]
        CRB_READ["kueue-controller-manager<br/>-read-metrics"]
        RB_LEADER["kueue-leader-election<br/>-rolebinding (Role)"]
    end

    subgraph PrimaryRole["ClusterRole: kueue-manager-role"]
        direction TB

        subgraph CoreResources["Core API Resources"]
            Core_Events["events<br/>create, patch, update, watch"]
            Core_Nodes["limitranges, namespaces, nodes<br/>get, list, watch"]
            Core_Pods["pods<br/>delete, get, list, patch, update, watch"]
            Core_Secrets["secrets<br/>get, list, update, watch"]
            Core_PodTemplates["podtemplates<br/>create, delete, get, list, update, watch"]
        end

        subgraph KueueResources["Kueue CRD Resources (kueue.x-k8s.io)"]
            Kueue_Full["admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads<br/>create, delete, get, list, patch, update, watch"]
            Kueue_Read["multikueueclusters, multikueueconfigs,<br/>provisioningrequestconfigs, workloadpriorityclasses<br/>get, list, watch"]
            Kueue_RF["resourceflavors, topologies<br/>delete, get, list, update, watch"]
            Kueue_Finalizers["*/finalizers<br/>update"]
            Kueue_Status["*/status<br/>get, patch, update"]
        end

        subgraph FrameworkResources["Framework Resources"]
            Batch_Jobs["batch/jobs<br/>get, list, patch, update, watch"]
            Apps_Resources["apps/deployments, replicasets, statefulsets<br/>get, list, watch"]
            KF_Jobs["kubeflow.org/mpijobs, paddlejobs,<br/>pytorchjobs, tfjobs, xgboostjobs<br/>get, list, patch, update, watch"]
            Ray_Resources["ray.io/rayclusters, rayjobs<br/>get, list, patch, update, watch"]
            JobSet_Resources["jobset.x-k8s.io/jobsets<br/>get, list, patch, update, watch"]
            AppWrapper_Resources["workload.codeflare.dev/appwrappers<br/>get, list, patch, update, watch"]
            LWS_Resources["leaderworkerset.x-k8s.io/leaderworkersets<br/>get, list, watch"]
        end

        subgraph InfraResources["Infrastructure Resources"]
            Provisioning["autoscaling.x-k8s.io/provisioningrequests<br/>create, delete, get, list, patch, update, watch"]
            Webhooks["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations<br/>get, list, update, watch"]
            FlowControl["flowcontrol.apiserver.k8s.io<br/>flowschemas, prioritylevelconfigurations<br/>list, watch"]
            Scheduling["scheduling.k8s.io/priorityclasses<br/>get, list, watch"]
            Runtime["node.k8s.io/runtimeclasses<br/>get, list, watch"]
        end
    end

    subgraph MetricsRole["ClusterRole: kueue-metrics-auth-role"]
        TokenReview["authentication.k8s.io/tokenreviews<br/>create"]
        SAR["authorization.k8s.io/subjectaccessreviews<br/>create"]
    end

    subgraph LeaderRole["Role: kueue-leader-election-role"]
        LE_CM["configmaps<br/>create, delete, get, list, patch, update, watch"]
        LE_Leases["coordination.k8s.io/leases<br/>create, delete, get, list, patch, update, watch"]
        LE_Events["events<br/>create, patch"]
    end

    subgraph EditorViewerRoles["Editor/Viewer Roles (User-Facing)"]
        CQ_Editor["clusterqueue-editor-role<br/>CRUD on clusterqueues"]
        CQ_Viewer["clusterqueue-viewer-role<br/>read-only on clusterqueues"]
        LQ_Editor["localqueue-editor-role<br/>CRUD on localqueues"]
        WL_Editor["workload-editor-role<br/>CRUD on workloads"]
        Cohort_Editor["cohort-editor-role<br/>CRUD on cohorts"]
        Pending_CQ["pending-workloads-cq-viewer<br/>read pendingworkloads"]
        Job_Editor["job/jobset/training job editors<br/>CRUD on respective resources"]
    end

    %% Bindings
    SA_CM -->|bound via| CRB_MGR
    CRB_MGR -->|grants| PrimaryRole
    SA_CM -->|bound via| CRB_METRICS
    CRB_METRICS -->|grants| MetricsRole
    SA_MR -->|bound via| CRB_READ
    SA_CM -->|bound via| RB_LEADER
    RB_LEADER -->|grants| LeaderRole

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_MR fill:#4a90e2,color:#fff
    style CRB_MGR fill:#f5a623
    style CRB_METRICS fill:#f5a623
    style CRB_READ fill:#f5a623
    style RB_LEADER fill:#f5a623

    style CoreResources fill:#d5e8d4,stroke:#82b366
    style KueueResources fill:#dae8fc,stroke:#6c8ebf
    style FrameworkResources fill:#e1d5e7,stroke:#9673a6
    style InfraResources fill:#fff2cc,stroke:#d6b656
    style MetricsRole fill:#f8cecc,stroke:#b85450
    style LeaderRole fill:#fff2cc,stroke:#d6b656
    style EditorViewerRoles fill:#e8e8e8,stroke:#999
