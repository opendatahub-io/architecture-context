graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>${PROJECT_NAME}-route<br/>443/TCP → 8080/TCP<br/>TLS Termination: Edge"]
    end

    subgraph Application["APPLICATION (StatefulSet Pod)"]
        direction TB

        subgraph Sidecar["llm-d-routing-sidecar"]
            Proxy["Reverse Proxy<br/>Port 8080/TCP<br/>Routes: /health, /v1/chat/completions,<br/>/v1/completions, / (catch-all)"]
            Allowlist["AllowlistValidator<br/>SSRF Protection<br/>InferencePool IP allowlist<br/>30s informer resync"]
        end

        subgraph CoLocated["Co-located Process"]
            Decoder["vLLM Decoder<br/>LRU-cached reverse proxy"]
        end
    end

    subgraph RemotePods["REMOTE PODS (Cluster Internal)"]
        Prefiller["Prefiller Instances<br/>Discovered via InferencePool<br/>NIXL v2 connector"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS<br/>Auth: upstream delegated"| Route
    Route -->|"HTTP/8080<br/>No encryption (post-TLS-term)<br/>No proxy-level auth"| Proxy
    Proxy -->|"catch-all reverse proxy<br/>LRU cached handlers"| Decoder
    Proxy -->|"P/D routing<br/>TLS 1.2+ ECDHE ciphers<br/>IP validated via allowlist"| Prefiller
    Allowlist -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    K8sAPI -->|"Watch events"| InferencePool

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef remote fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Proxy,Decoder application
    class Allowlist security
    class Prefiller remote
    class K8sAPI,InferencePool controlplane
