graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_DSPO["data-science-pipelines-operator-<br/>controller-manager"]
        SA_Argo["argo<br/>(namespace: argo)"]
        SA_CM["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["dspo-manager-rolebinding"]
        CRB_ManagerArgo["dspo-manager-argo-rolebinding"]
        CRB_ArgoBinding["ds-pipeline-argo-binding"]
        CRB_ManagerRole["manager-rolebinding"]
        CRB_ManagerArgoRole["manager-argo-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["dspo-leader-election-rolebinding<br/>(ns: opendatahub)"]
        RB_Argo["argo-binding<br/>(ns: argo)"]
        RB_LeaderCM["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["dspo-manager-role"]
        CR_ManagerArgo["dspo-manager-argo-role"]
        CR_ArgoCluster["argo-cluster-role"]
        CR_AggAdmin["argo-aggregate-to-admin<br/>(aggregation label)"]
        CR_AggEdit["argo-aggregate-to-edit<br/>(aggregation label)"]
        CR_AggView["argo-aggregate-to-view<br/>(aggregation label)"]
        CR_DSPAEdit["aggregate-dspa-admin-edit"]
        CR_DSPAView["aggregate-dspa-admin-view"]
        CR_ManagerRoleAlt["manager-role"]
        CR_ManagerArgoAlt["manager-argo-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["dspo-leader-election-role<br/>(ns: opendatahub)"]
        R_Argo["argo-role"]
        R_LeaderCM["leader-election-role"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        direction LR
        MR_Core["Core API<br/>configmaps, secrets,<br/>serviceaccounts, services,<br/>PVs, PVCs, pods"]
        MR_Apps["apps/extensions<br/>deployments,<br/>replicasets"]
        MR_DSPA["DSPA API<br/>datasciencepipelines-<br/>applications<br/>+ /finalizers + /status"]
        MR_Pipelines["Pipelines API<br/>pipelines,<br/>pipelineversions<br/>+ /finalizers + /status"]
        MR_Admission["Admission API<br/>mutating/validating<br/>webhookconfigurations"]
        MR_Auth["Auth APIs<br/>tokenreviews,<br/>subjectaccessreviews"]
        MR_RBAC["RBAC API<br/>clusterroles,<br/>clusterrolebindings,<br/>roles, rolebindings"]
        MR_Network["Networking<br/>networkpolicies,<br/>ingresses, routes"]
        MR_External["External CRDs<br/>KServe, Seldon, Ray,<br/>CodeFlare, MLflow"]
        MR_Monitoring["Monitoring<br/>servicemonitors"]
    end

    subgraph ArgoResources["Argo Role Resources"]
        direction LR
        AR_Workflows["Argo Workflows<br/>workflows, cronworkflows,<br/>workflowtasksets,<br/>workflowartifactgctasks"]
        AR_Core["Core Resources<br/>pods, pods/exec,<br/>PVCs, configmaps,<br/>leases"]
        AR_Secrets["Secrets<br/>(resourceNames:<br/>argo-workflows-agent-<br/>ca-certificates ONLY)"]
    end

    subgraph LeaderResources["Leader Election Resources"]
        LR_Resources["configmaps, leases, events"]
    end

    %% SA to Binding connections
    SA_DSPO -->|bound via| CRB_Manager
    SA_DSPO -->|bound via| CRB_ManagerArgo
    SA_DSPO -->|bound via| RB_Leader
    SA_Argo -->|bound via| CRB_ArgoBinding
    SA_Argo -->|bound via| RB_Argo
    SA_CM -->|bound via| CRB_ManagerRole
    SA_CM -->|bound via| CRB_ManagerArgoRole
    SA_CM -->|bound via| RB_LeaderCM

    %% Binding to Role connections
    CRB_Manager -->|grants| CR_Manager
    CRB_ManagerArgo -->|grants| CR_ManagerArgo
    CRB_ArgoBinding -->|grants| CR_ArgoCluster
    CRB_ManagerRole -->|grants| CR_ManagerRoleAlt
    CRB_ManagerArgoRole -->|grants| CR_ManagerArgoAlt
    RB_Leader -->|grants| R_Leader
    RB_Argo -->|grants| R_Argo
    RB_LeaderCM -->|grants| R_LeaderCM

    %% Role to Resources
    CR_Manager -->|"full CRUD"| ManagerResources
    CR_ManagerArgo -->|"full CRUD"| ArgoResources
    CR_ArgoCluster -->|"full CRUD +<br/>secret restriction"| ArgoResources
    R_Leader -->|"CRUD"| LeaderResources

    %% Aggregation roles
    CR_AggAdmin -.->|"aggregate-to-admin: true<br/>full CRUD all Argo CRDs"| AR_Workflows
    CR_AggEdit -.->|"aggregate-to-edit: true<br/>full CRUD excl TaskSets"| AR_Workflows
    CR_AggView -.->|"aggregate-to-view: true<br/>read-only"| AR_Workflows

    %% DSPA aggregation
    CR_DSPAEdit -.->|"CRUD DSPA + Pipelines"| MR_DSPA
    CR_DSPAView -.->|"read-only DSPA + Pipelines"| MR_DSPA

    %% Styling
    style SA_DSPO fill:#4a90e2,stroke:#333,color:#fff
    style SA_Argo fill:#e96d3f,stroke:#333,color:#fff
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff

    style CR_Manager fill:#f5a623,stroke:#333
    style CR_ManagerArgo fill:#f5a623,stroke:#333
    style CR_ArgoCluster fill:#f5a623,stroke:#333
    style CR_AggAdmin fill:#fff2cc,stroke:#d6b656
    style CR_AggEdit fill:#fff2cc,stroke:#d6b656
    style CR_AggView fill:#fff2cc,stroke:#d6b656
    style CR_DSPAEdit fill:#fff2cc,stroke:#d6b656
    style CR_DSPAView fill:#fff2cc,stroke:#d6b656
    style CR_ManagerRoleAlt fill:#f5a623,stroke:#333
    style CR_ManagerArgoAlt fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style R_Argo fill:#f5a623,stroke:#333
    style R_LeaderCM fill:#f5a623,stroke:#333

    style MR_Core fill:#7ed321,stroke:#333
    style MR_Apps fill:#7ed321,stroke:#333
    style MR_DSPA fill:#7ed321,stroke:#333
    style MR_Pipelines fill:#7ed321,stroke:#333
    style MR_Admission fill:#7ed321,stroke:#333
    style MR_Auth fill:#7ed321,stroke:#333
    style MR_RBAC fill:#7ed321,stroke:#333
    style MR_Network fill:#7ed321,stroke:#333
    style MR_External fill:#7ed321,stroke:#333
    style MR_Monitoring fill:#7ed321,stroke:#333
    style AR_Workflows fill:#7ed321,stroke:#333
    style AR_Core fill:#7ed321,stroke:#333
    style AR_Secrets fill:#ff6b6b,stroke:#333,color:#fff
    style LR_Resources fill:#7ed321,stroke:#333
