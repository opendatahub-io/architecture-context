graph TD
    subgraph Legend["Legend"]
        direction LR
        L1["No Kubernetes RBAC"]
        L2["Application Service<br/>(not an operator)"]
    end

    subgraph PodSecurity["Pod Security Context"]
        SA["Pod ServiceAccount<br/>(deployment-configured)"]
    end

    subgraph AuthModel["Authentication Model"]
        direction TB

        subgraph PlatformAuth["Platform-Delegated Authentication"]
            MMAuth["ModelMesh TLS/Auth Boundary<br/>External traffic authentication"]
        end

        subgraph PodLocalAuth["Pod-Local Authentication (16 endpoints)"]
            direction TB
            MMRuntime["mmesh.ModelRuntime/*<br/>loadModel, unloadModel,<br/>modelSize, predictModelSize,<br/>runtimeStatus"]
            MMMesh["mmesh.ModelMesh/*<br/>registerModel, unregisterModel,<br/>setVModel, deleteVModel,<br/>getModelStatus, getVModelStatus,<br/>ensureLoaded"]
            ProcessAPI["processproto.Process/Run"]
            HealthAPI["Health, ModelRuntime,<br/>Process (service-level)"]
        end

        subgraph TLSConfig["TLS/mTLS Configuration"]
            ServerTLS["Server TLS<br/>Key + Cert<br/>(file path or inline)"]
            ClientTLS["Client Cert (mTLS)<br/>require_client_auth=True"]
            HealthTLS["Health Probe TLS<br/>Combined server+client certs<br/>(no external CA needed)"]
        end
    end

    %% Relationships
    SA -->|"runs as"| PodLocalAuth
    MMAuth -->|"protects external access to"| PodLocalAuth
    ServerTLS -->|"secures"| MMRuntime
    ServerTLS -->|"secures"| MMMesh
    ClientTLS -->|"mutual auth for"| MMRuntime
    HealthTLS -->|"enables probes for"| HealthAPI

    %% Notes
    Note["Note: Caikit is an Application Service<br/>with no Kubernetes RBAC roles.<br/>All authentication is platform-delegated<br/>via ModelMesh pod-local boundaries.<br/>Dynamic auth composition for<br/>inference/training is unresolved."]

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style MMAuth fill:#f5a623,stroke:#333,color:#fff
    style MMRuntime fill:#e1d5e7,stroke:#9673a6
    style MMMesh fill:#e1d5e7,stroke:#9673a6
    style ProcessAPI fill:#e1d5e7,stroke:#9673a6
    style HealthAPI fill:#e1d5e7,stroke:#9673a6
    style ServerTLS fill:#d5e8d4,stroke:#82b366
    style ClientTLS fill:#d5e8d4,stroke:#82b366
    style HealthTLS fill:#d5e8d4,stroke:#82b366
    style Note fill:#fff2cc,stroke:#d6b656
    style L1 fill:#f9f9f9,stroke:#999
    style L2 fill:#f9f9f9,stroke:#999
