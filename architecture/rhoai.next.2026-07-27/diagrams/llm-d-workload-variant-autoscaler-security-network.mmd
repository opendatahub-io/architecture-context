graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes Network)"]
        direction TB

        subgraph NS_WVA["Namespace: wva-system"]
            WVA["WVA Controller Manager<br/>SA: controller-manager<br/>Resources: 500m CPU / 512Mi<br/>Leader election: leases"]

            subgraph WVA_Ports["Exposed Ports"]
                Health["8081/TCP - Health Probes<br/>HTTP / No Auth / No TLS<br/>/healthz, /readyz"]
                Metrics["8443/TCP - Metrics<br/>HTTPS / TLS (self-signed)<br/>TokenReview + SAR<br/>/metrics"]
            end

            MetricsSvc["Service: controller-manager-metrics-service<br/>ClusterIP 8443/TCP → 8443/TCP<br/>HTTPS / Internal only"]

            Secret["Secret: epp-metrics-token<br/>kubernetes.io/service-account-token<br/>Mount: /var/run/secrets/epp-metrics"]
        end

        subgraph NS_Monitoring["Namespace: workload-variant-autoscaler-monitoring"]
            Prometheus["Prometheus<br/>SA: kube-prometheus-stack-prometheus<br/>9090/TCP HTTPS"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            EPPPods["EPP / Inference Pods<br/>configurable/TCP<br/>HTTP/HTTPS /metrics"]
            TargetDeploy["Target Deployment / LWS<br/>(scaling target)"]
        end

        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]

        HPAAdapter["HPA / Prometheus Adapter / KEDA<br/>(reads wva_desired_replicas)"]
    end

    %% Flows from WVA
    WVA -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token (in-cluster)"| K8sAPI
    WVA -->|"HTTPS/9090<br/>TLS (InsecureSkipVerify default)<br/>Bearer token"| Prometheus
    WVA -->|"HTTP(S)/configurable<br/>Configurable TLS<br/>Optional Bearer (epp-metrics-token)"| EPPPods

    %% Prometheus scrapes WVA
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>metrics-reader RBAC"| MetricsSvc

    %% HPA reads from Prometheus, scales via API
    HPAAdapter -->|"reads metric"| Prometheus
    HPAAdapter -->|"HTTPS/6443<br/>scale subresource"| K8sAPI
    K8sAPI -->|"updates replicas"| TargetDeploy

    %% Styling
    classDef wva fill:#bbdefb,stroke:#1565c0,stroke-width:3px
    classDef health fill:#c8e6c9,stroke:#2e7d32,stroke-width:1px
    classDef metrics fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef prometheus fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px
    classDef k8sapi fill:#e0e0e0,stroke:#424242,stroke-width:2px
    classDef epp fill:#ffe0b2,stroke:#e65100,stroke-width:1px
    classDef secret fill:#ffcdd2,stroke:#b71c1c,stroke-width:1px
    classDef hpa fill:#c8e6c9,stroke:#2e7d32,stroke-width:1px

    class WVA wva
    class Health health
    class Metrics metrics
    class Prometheus prometheus
    class K8sAPI k8sapi
    class EPPPods epp
    class Secret secret
    class HPAAdapter hpa
    class MetricsSvc metrics
