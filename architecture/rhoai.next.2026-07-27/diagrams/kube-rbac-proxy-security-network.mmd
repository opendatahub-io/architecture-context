graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client /<br/>Prometheus Scraper"]
    end

    subgraph ProxyBoundary["PROXY BOUNDARY (kube-rbac-proxy Sidecar)"]
        direction TB

        subgraph TLSTermination["TLS Termination"]
            Listener["Secure Listener<br/>8443/TCP<br/>TLS 1.2+ / HTTP/2<br/>Cipher Suite Selection<br/>Cert Hot-Reload"]
        end

        subgraph AuthChain["Authentication & Authorization"]
            direction TB
            AuthN["Authentication<br/>OIDC or TokenReview"]
            UnionAuthZ["Union Authorizer"]
            HardcodedMetrics["1. Hardcoded Metrics<br/>OpenShift Users"]
            StaticRules["2. Static Authorizer<br/>Config File Rules"]
            SARCheck["3. SAR Authorizer<br/>SubjectAccessReview"]

            AuthN --> UnionAuthZ
            UnionAuthZ --> HardcodedMetrics
            UnionAuthZ --> StaticRules
            UnionAuthZ --> SARCheck
        end

        HealthPort["/healthz Endpoint<br/>Separate Port<br/>Unauthenticated"]
    end

    subgraph PodLocal["UPSTREAM (Same Pod - localhost)"]
        Upstream["Upstream Service<br/>Metrics Endpoint<br/>localhost:8080<br/>HTTP (plaintext)"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS / TLS 1.2+<br/>ServiceAccount Token"]
    end

    %% Flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token<br/>(OIDC or SA Token)"| Listener
    Client -.->|"Health Check<br/>Unauthenticated"| HealthPort
    Listener --> AuthN

    SARCheck -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>SubjectAccessReview"| K8sAPI
    AuthN -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>TokenReview"| K8sAPI

    StaticRules -->|"Authorized"| Upstream
    HardcodedMetrics -->|"Authorized"| Upstream
    SARCheck -->|"Authorized"| Upstream

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef upstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef health fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Listener proxy
    class AuthN,UnionAuthZ,HardcodedMetrics,StaticRules,SARCheck auth
    class Upstream upstream
    class K8sAPI controlplane
    class HealthPort health
