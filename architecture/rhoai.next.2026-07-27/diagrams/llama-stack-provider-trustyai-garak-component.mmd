graph TB
    subgraph EvalHubPod["eval-hub K8s Job Pod"]
        direction TB
        Adapter["GarakAdapter<br/>(FrameworkAdapter)"]
        PipelineSteps["Pipeline Steps<br/>(Core Logic)"]
        S3Utils["S3 Utilities<br/>(Upload/Download)"]
        CredResolver["Credential Resolver<br/>(6-Role Priority Chain)"]

        Adapter -->|orchestrates| PipelineSteps
        PipelineSteps -->|uses| S3Utils
        PipelineSteps -->|resolves keys via| CredResolver
    end

    subgraph ExecutionModes["Execution Modes"]
        SimpleMode["Simple Mode<br/>(Subprocess)"]
        KFPMode["KFP Mode<br/>(Pipeline Delegation)"]
    end

    Adapter -->|simple| SimpleMode
    Adapter -->|kfp| KFPMode

    subgraph GarakEngine["Garak Red-Teaming Engine"]
        GarakCLI["garak CLI<br/>v0.15.0+rhaiv.5"]
        GarakProbes["Probes & Detectors"]
        GarakReports["JSONL Reports"]
        GarakCLI --> GarakProbes
        GarakProbes --> GarakReports
    end

    SimpleMode -->|subprocess exec| GarakCLI
    KFPMode -->|submits pipeline| KFP["Kubeflow Pipelines"]

    ConfigMap["ConfigMap<br/>(Job Specification)"] -->|mounted| Adapter
    Adapter -->|callback results| EvalHubSidecar["eval-hub Sidecar Proxy"]

    PipelineSteps -->|upload/download| S3["S3-Compatible Storage"]
    PipelineSteps -->|persist artifacts| OCI["OCI Registry"]
    PipelineSteps -->|API calls| K8sAPI["Kubernetes API"]
    PipelineSteps -->|inference requests| TargetModel["Target Model Endpoint"]

    subgraph AIIntents["AI Safety (ART) Intents"]
        SDGHub["sdg-hub<br/>(Synthetic Data Gen)"]
        Translation["Translation<br/>(HuggingFace / LLM)"]
    end

    PipelineSteps -->|generates prompts| SDGHub
    PipelineSteps -->|translates| Translation

    style Adapter fill:#4a90e2,stroke:#333,color:#fff
    style PipelineSteps fill:#4a90e2,stroke:#333,color:#fff
    style S3Utils fill:#4a90e2,stroke:#333,color:#fff
    style CredResolver fill:#4a90e2,stroke:#333,color:#fff
    style GarakCLI fill:#9b59b6,stroke:#333,color:#fff
    style GarakProbes fill:#9b59b6,stroke:#333,color:#fff
    style GarakReports fill:#9b59b6,stroke:#333,color:#fff
    style SimpleMode fill:#f5a623,stroke:#333
    style KFPMode fill:#f5a623,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
    style EvalHubSidecar fill:#7ed321,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OCI fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style KFP fill:#e8e8e8,stroke:#333
    style TargetModel fill:#e8e8e8,stroke:#333
    style SDGHub fill:#7ed321,stroke:#333
    style Translation fill:#7ed321,stroke:#333
