graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        Gateway["Envoy Proxy / Gateway<br/>HTTPRoute routing<br/>Weighted traffic splitting"]
    end

    subgraph Processing["PROCESSING (Controller + ext_proc)"]
        direction TB
        subgraph ExtProc["ai-gateway-payload-processing"]
            Controllers["Controllers<br/>ExternalModel / ExternalProvider / Legacy"]
            Plugins["ext_proc Plugins<br/>Model resolver · Format translator · Credential injector"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP · HTTPS/WSS · TLS 1.2+"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (LLM Providers)"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>TLS · API Key"]
        Anthropic["Anthropic API<br/>api.anthropic.com<br/>TLS · API Key"]
        Azure["Azure OpenAI<br/>*.openai.azure.com<br/>TLS · API Key / OAuth2"]
        Vertex["Google Vertex AI<br/>*-aiplatform.googleapis.com<br/>TLS · OAuth2"]
    end

    subgraph Secrets["CREDENTIAL SECRETS"]
        OpenAICreds["openai-credentials<br/>Opaque"]
        AnthropicCreds["anthropic-credentials<br/>Opaque"]
        AzureCreds["azure-credentials<br/>Opaque"]
        VertexCreds["vertex-credentials<br/>Opaque"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS"| Gateway
    Gateway -->|"gRPC<br/>ext_proc filter"| Plugins
    Controllers -->|"HTTPS/WSS · 6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    Controllers -->|"read credentials"| OpenAICreds
    Controllers -->|"read credentials"| AnthropicCreds
    Controllers -->|"read credentials"| AzureCreds
    Controllers -->|"read credentials"| VertexCreds

    Gateway -->|"HTTPS<br/>TLS · apikey"| OpenAI
    Gateway -->|"HTTPS<br/>TLS · apikey"| Anthropic
    Gateway -->|"HTTPS<br/>TLS · apikey/oauth2"| Azure
    Gateway -->|"HTTPS<br/>TLS · oauth2"| Vertex

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef processing fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secrets fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class Controllers,Plugins processing
    class K8sAPI controlplane
    class OpenAI,Anthropic,Azure,Vertex externalservice
    class OpenAICreds,AnthropicCreds,AzureCreds,VertexCreds secrets
