graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AppService["APPLICATION SERVICE (ogx / Llama Stack)"]
        direction TB

        subgraph Middleware["Middleware Chain"]
            direction TB
            AuthMW["AuthenticationMiddleware<br/>(ASGI, config-conditional)<br/>OAuth2 JWT/JWKS | Introspection | Custom"]
            QuotaMW["QuotaMiddleware<br/>Rate limits: auth vs anon"]
            VersionMW["ClientVersionMiddleware<br/>major.minor version check"]
            AuthMW --> QuotaMW --> VersionMW
        end

        subgraph ABAC["ABAC Enforcement"]
            RoutingABAC["CommonRoutingTableImpl<br/>is_action_allowed<br/>create, read, delete, list"]
            AgentABAC["AgentPersistence<br/>is_action_allowed<br/>session create, read<br/>ownership verification"]
        end

        subgraph APIRoutes["Dynamic API Routes"]
            Inference["Inference API"]
            Agents["Agents API"]
            Safety["Safety API"]
            VectorIO["Vector I/O API"]
            DatasetIO["Dataset I/O API"]
            ToolRuntime["Tool Runtime API"]
        end

        FastAPI["FastAPI Server (uvicorn)<br/>Port 8321/TCP<br/>Bind: [::], 0.0.0.0<br/>TLS: Optional"]
        StreamlitUI["Streamlit UI<br/>llama-stack-client SDK"]
    end

    subgraph InferenceProviders["EGRESS - INFERENCE PROVIDERS"]
        OpenAI["OpenAI API<br/>HTTPS/TLS<br/>OPENAI_API_KEY"]
        Cerebras["Cerebras API<br/>api.cerebras.ai<br/>HTTPS/TLS<br/>CEREBRAS_API_KEY"]
        NVIDIA["NVIDIA NeMo API<br/>HTTPS/TLS<br/>NVIDIA_API_KEY"]
    end

    subgraph ToolProviders["EGRESS - TOOL RUNTIME"]
        Tavily["Tavily Search<br/>api.tavily.com<br/>443/TCP HTTPS/TLS<br/>TAVILY_SEARCH_API_KEY"]
    end

    subgraph AuthProviders["EGRESS - AUTHENTICATION (conditional)"]
        OAuth2EP["OAuth2/OIDC Endpoint<br/>JWKS or Introspection<br/>HTTPS"]
        ExternalAuth["External Auth Endpoint<br/>Custom delegation<br/>HTTP/HTTPS"]
    end

    %% Inbound flows
    Client -->|"HTTP(S)/8321<br/>TLS optional<br/>Bearer Token"| FastAPI
    FastAPI --> AuthMW
    VersionMW --> APIRoutes
    StreamlitUI -->|"SDK client"| FastAPI

    %% Internal enforcement
    Inference --> RoutingABAC
    Agents --> AgentABAC

    %% Egress flows
    RoutingABAC -->|"HTTPS<br/>TLS<br/>API Key"| OpenAI
    RoutingABAC -->|"HTTPS<br/>TLS<br/>API Key"| Cerebras
    RoutingABAC -->|"HTTPS<br/>TLS<br/>API Key"| NVIDIA
    ToolRuntime -->|"HTTPS/443<br/>TLS<br/>API Key"| Tavily

    %% Auth egress
    AuthMW -->|"HTTPS<br/>JWKS fetch / Introspection"| OAuth2EP
    AuthMW -->|"HTTP(S)<br/>Token forwarding"| ExternalAuth

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef middleware fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef abac fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef egress fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef authegress fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class FastAPI,StreamlitUI appservice
    class AuthMW,QuotaMW,VersionMW middleware
    class RoutingABAC,AgentABAC abac
    class OpenAI,Cerebras,NVIDIA,Tavily egress
    class OAuth2EP,ExternalAuth authegress
