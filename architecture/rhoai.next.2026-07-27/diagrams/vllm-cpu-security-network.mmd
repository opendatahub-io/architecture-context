graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(API Consumer)"]
        WSClient["WebSocket Client"]
    end

    subgraph Application["APPLICATION (vllm-cpu Inference Server)"]
        direction TB

        subgraph AuthLayer["Authentication Layer"]
            AuthMW["ASGI AuthenticationMiddleware<br/>Bearer Token (VLLM_API_KEY)<br/>Port: 8000/TCP"]
        end

        subgraph SSLConfig["SSL/TLS (Optional)"]
            SSL["TLS Configuration<br/>--ssl-keyfile / --ssl-certfile<br/>--ssl-ca-certs<br/>--enable-ssl-refresh"]
        end

        subgraph APILayer["API Surface (47 HTTP + 1 WS)"]
            direction LR
            OpenAI["OpenAI APIs<br/>/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models<br/>/v1/responses"]
            Anthropic["Anthropic API<br/>/v1/messages"]
            SageMaker["SageMaker API<br/>/invocations"]
            NativeAPI["Native vLLM<br/>/generate<br/>/tokenize"]
            OpsAPI["Operational<br/>/health /ready<br/>/load /version"]
        end

        subgraph Engine["Inference Engine"]
            AsyncEngine["AsyncLLMEngine<br/>CPU-Optimized<br/>LoRA Support"]
        end

        subgraph MCPLayer["MCP Tools (Optional)"]
            MCPBrowser["Web Browser Tool"]
            MCPCode["Code Interpreter"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: S3_SECRET_ACCESS_KEY"]
        ModelScope["ModelScope Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: MODELSCOPE_API_TOKEN"]
        Exa["Exa Search API<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: EXA_API_KEY"]
        Docker["Docker Daemon<br/>Unix Socket<br/>Auth: Socket Permissions"]
    end

    %% Inbound flows
    Client -->|"HTTP(S)/8000<br/>Configurable TLS<br/>Bearer Token"| AuthMW
    WSClient -->|"WS(S)/8000<br/>/v1/realtime"| AuthMW

    SSL -.->|"TLS config"| AuthMW
    AuthMW --> OpenAI
    AuthMW --> Anthropic
    AuthMW --> SageMaker
    AuthMW --> NativeAPI
    AuthMW --> OpsAPI

    OpenAI --> AsyncEngine
    Anthropic --> AsyncEngine
    SageMaker --> AsyncEngine
    NativeAPI --> AsyncEngine

    %% Outbound flows
    AsyncEngine -->|"HTTPS/443<br/>TLS 1.2+<br/>S3_SECRET_ACCESS_KEY"| S3
    AsyncEngine -->|"HTTPS/443<br/>TLS 1.2+<br/>MODELSCOPE_API_TOKEN"| ModelScope
    MCPBrowser -->|"HTTPS/443<br/>TLS 1.2+<br/>EXA_API_KEY"| Exa
    MCPCode -->|"Unix socket<br/>Docker API"| Docker

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef auth fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef ssl fill:#f39c12,stroke:#e67e22,stroke-width:2px
    classDef api fill:#3498db,stroke:#2980b9,stroke-width:2px,color:#fff
    classDef engine fill:#2ecc71,stroke:#27ae60,stroke-width:2px,color:#fff
    classDef mcp fill:#9b59b6,stroke:#8e44ad,stroke-width:2px,color:#fff
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client,WSClient external
    class AuthMW auth
    class SSL ssl
    class OpenAI,Anthropic,SageMaker,NativeAPI,OpsAPI api
    class AsyncEngine engine
    class MCPBrowser,MCPCode mcp
    class S3,ModelScope,Exa,Docker externalservice
