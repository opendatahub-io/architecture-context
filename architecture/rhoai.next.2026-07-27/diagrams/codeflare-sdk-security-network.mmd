graph TB
    subgraph ClientRuntime["CLIENT RUNTIME (User Workbench / Notebook)"]
        SDK["codeflare-sdk<br/>Python Client Library<br/><i>No inbound surface</i>"]

        subgraph TLS["TLS Certificate Resolution"]
            CA1["Explicit CA path"]
            CA2["CF_SDK_CA_CERT_PATH env"]
            CA3["OpenShift default<br/>/etc/pki/tls/custom-certs/ca-bundle.crt"]
        end

        subgraph AuthMethods["Authentication Methods"]
            Bearer["TokenAuthentication<br/>Bearer Token + Server URL"]
            KubeConfig["KubeConfigFileAuthentication<br/>kubeconfig file"]
            AutoDetect["config_check()<br/>~/.kube/config / in-cluster"]
        end

        SDK --> TLS
        SDK --> AuthMethods
    end

    subgraph K8sCluster["KUBERNETES CLUSTER (Trusted)"]
        direction LR
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>Bearer / x509"]
        RayDashboard["Ray Cluster Dashboard<br/>8265/TCP<br/>HTTP/HTTPS<br/>Headers / Cookies"]
    end

    subgraph TestOnly["TEST-ONLY (not shipped)"]
        Minio["MinIO<br/>ClusterIP<br/>9000/TCP (S3 API)<br/>9090/TCP (Console)<br/>minio-secret"]
    end

    %% Outbound flows
    SDK -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token /<br/>kubeconfig / SA token"| K8sAPI
    SDK -->|"HTTP(S)/8265<br/>TLS configurable<br/>Custom headers/cookies"| RayDashboard

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef testonly fill:#f5f5f5,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5
    classDef auth fill:#e1d5e7,stroke:#9673a6
    classDef tls fill:#fff2cc,stroke:#d6b656

    class SDK client
    class K8sAPI,RayDashboard k8s
    class Minio testonly
    class Bearer,KubeConfig,AutoDetect auth
    class CA1,CA2,CA3 tls
