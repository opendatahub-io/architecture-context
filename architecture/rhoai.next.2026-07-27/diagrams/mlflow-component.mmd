graph TB
    subgraph MLflow["MLflow Platform (v3.14.0)"]
        direction TB

        subgraph FullPlatform["mlflow (Full Platform)"]
            Gateway["AI Gateway<br/>FastAPI GatewayAPI<br/>Rate Limiting: slowapi"]
            AgentServer["Agent Server<br/>FastAPI AgentServer<br/>Port 8000"]
            TrackingServer["Tracking Server<br/>Flask/FastAPI<br/>Experiment & Job Mgmt"]
            MCPRegistry["MCP Registry<br/>FastAPI<br/>Model/Version/Endpoint CRUD"]
        end

        subgraph SkinnyDist["mlflow-skinny (Lightweight)"]
            CLI["CLI Entry Point"]
            AuthApp["Auth Application"]
            DeployPlugin["Deployment Plugin"]
        end

        subgraph TracingSDK["mlflow-tracing (SDK)"]
            AutoInstrument["Auto-Instrumentation<br/>15+ AI/ML Frameworks"]
        end
    end

    %% External Clients
    Client[External Client] -->|POST /v1/chat/completions<br/>POST /v1/completions<br/>POST /v1/embeddings| Gateway
    Client -->|POST /invocations<br/>POST /responses<br/>GET /agent/info| AgentServer
    Client -->|GET/POST /ajax-api/3.0/*| TrackingServer
    Client -->|CRUD /{name}/*| MCPRegistry

    %% Gateway routing to providers
    Gateway -->|Proxy LLM requests| OpenAI["OpenAI<br/>api.openai.com"]
    Gateway -->|Proxy LLM requests| AzureOpenAI["Azure OpenAI"]
    Gateway -->|Proxy LLM requests| Bedrock["AWS Bedrock"]
    Gateway -->|Proxy LLM requests| Anthropic["Anthropic"]
    Gateway -->|Proxy LLM requests| Cohere["Cohere"]

    %% Agent Server dependencies
    AgentServer -->|Optional proxy| ChatApp["Chat App<br/>localhost:3000"]

    %% Storage backends
    TrackingServer -->|Model artifacts| S3["AWS S3"]
    TrackingServer -->|Model artifacts| GCS["Google Cloud Storage"]

    %% Kubernetes integration
    FullPlatform -->|Resource operations| K8sAPI["Kubernetes API"]

    %% Tracing integration
    AutoInstrument -.->|Trace data| TrackingServer

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,color:#fff
    style AgentServer fill:#4a90e2,stroke:#333,color:#fff
    style TrackingServer fill:#4a90e2,stroke:#333,color:#fff
    style MCPRegistry fill:#4a90e2,stroke:#333,color:#fff
    style CLI fill:#6bb5e0,stroke:#333
    style AuthApp fill:#6bb5e0,stroke:#333
    style DeployPlugin fill:#6bb5e0,stroke:#333
    style AutoInstrument fill:#9b59b6,stroke:#333,color:#fff
    style Client fill:#f5f5f5,stroke:#999
    style OpenAI fill:#e8e8e8,stroke:#333
    style AzureOpenAI fill:#e8e8e8,stroke:#333
    style Bedrock fill:#e8e8e8,stroke:#333
    style Anthropic fill:#e8e8e8,stroke:#333
    style Cohere fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
