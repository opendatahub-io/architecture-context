graph TB
    subgraph EPPComponent["Endpoint Picker (EPP) - gRPC Service"]
        direction TB
        EPP["EPP gRPC Server<br/>(ExternalProcessor + Health)"]
        PluginPipeline["Plugin Pipeline"]
        DataLayer["Data Layer"]
        SatDetector["Saturation Detector"]
        FlowControl["Flow Control<br/>(Priority Bands + Fairness)"]
        Scheduler["Scheduling Profile<br/>(Scorer Plugins)"]
        Parser["Request Parser<br/>(default: openai-parser)"]

        EPP --> Parser
        Parser --> DataLayer
        DataLayer --> SatDetector
        SatDetector --> FlowControl
        FlowControl --> Scheduler
    end

    subgraph Controllers["Kubernetes Controllers"]
        direction TB
        PoolCtrl["InferencePool<br/>Controller"]
        ObjectiveCtrl["InferenceObjective<br/>Controller"]
        ModelRewriteCtrl["InferenceModelRewrite<br/>Controller"]
        PodCtrl["Pod Controller"]
        ConfigMapCtrl["ConfigMap<br/>Controller"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        direction TB
        InferencePoolCR["InferencePool<br/>(inference.networking.k8s.io/v1)"]
        EndpointPickerConfigCR["EndpointPickerConfig<br/>(x-k8s.io/v1alpha1)"]
        InferenceModelRewriteCR["InferenceModelRewrite<br/>(x-k8s.io/v1alpha2)"]
        InferenceObjectiveCR["InferenceObjective<br/>(x-k8s.io/v1alpha2)"]
        InferencePoolImportCR["InferencePoolImport<br/>(x-k8s.io/v1alpha1)"]
    end

    subgraph ExternalSystems["External Systems"]
        EnvoyProxy["Envoy Proxy"]
        GatewayAPI["Gateway API<br/>(data-science-gateway)"]
        ModelServingPods["Model-Serving Pods"]
        K8sAPI["Kubernetes API<br/>6443/TCP"]
    end

    %% Controller watches
    PoolCtrl -->|watches| InferencePoolCR
    ObjectiveCtrl -->|watches| InferenceObjectiveCR
    ModelRewriteCtrl -->|watches| InferenceModelRewriteCR
    PodCtrl -->|watches| ModelServingPods
    ConfigMapCtrl -->|watches| ConfigMapRes["ConfigMap"]

    %% EPP configuration
    EndpointPickerConfigCR -.->|configures| PluginPipeline
    InferencePoolCR -->|references EPP via<br/>EndpointPickerRef| EPP

    %% External interactions
    EnvoyProxy -->|gRPC ExtProc<br/>callout| EPP
    GatewayAPI -->|HTTPRoute<br/>backendRef| InferencePoolCR
    EPP -->|selects endpoint<br/>podIP:port| ModelServingPods
    EPP -->|HTTP metrics<br/>scrape| ModelServingPods
    Controllers -->|REST/WSS| K8sAPI

    %% CRD relationships
    InferenceModelRewriteCR -.->|poolRef| InferencePoolCR
    InferenceObjectiveCR -.->|poolRef| InferencePoolCR
    InferencePoolImportCR -.->|cross-cluster<br/>federation| InferencePoolCR

    %% Client flow
    Client["External Client"] -->|inference request| GatewayAPI

