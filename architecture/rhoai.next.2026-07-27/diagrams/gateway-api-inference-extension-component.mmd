    style EPP fill:#4a90e2,stroke:#333,color:#fff
    style PluginPipeline fill:#5b9bd5,stroke:#333,color:#fff
    style DataLayer fill:#5b9bd5,stroke:#333,color:#fff
    style SatDetector fill:#5b9bd5,stroke:#333,color:#fff
    style FlowControl fill:#5b9bd5,stroke:#333,color:#fff
    style Scheduler fill:#5b9bd5,stroke:#333,color:#fff
    style Parser fill:#5b9bd5,stroke:#333,color:#fff
    style PoolCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ObjectiveCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ModelRewriteCtrl fill:#4a90e2,stroke:#333,color:#fff
    style PodCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ConfigMapCtrl fill:#4a90e2,stroke:#333,color:#fff
    style InferencePoolCR fill:#f5a623,stroke:#333
    style EndpointPickerConfigCR fill:#f5a623,stroke:#333
    style InferenceModelRewriteCR fill:#f5a623,stroke:#333
    style InferenceObjectiveCR fill:#f5a623,stroke:#333
    style InferencePoolImportCR fill:#f5a623,stroke:#333
    style EnvoyProxy fill:#e8e8e8,stroke:#333
