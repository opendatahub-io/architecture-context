graph TB
    subgraph Orchestration["PIPELINE ORCHESTRATION"]
        KFP["Kubeflow Pipelines<br/>Orchestrator<br/>Manages component pods"]
    end

    subgraph ComponentPods["COMPONENT EXECUTION (Pipeline Step Pods)"]
        direction TB

        subgraph DP["Data Processing"]
            DatasetDL["Dataset Download"]
            ParseChunk["Parse & Chunk<br/>(Ray + Docling)"]
            SDGComp["SDG<br/>(SDG Hub)"]
            AutoMLData["AutoML Tabular<br/>Data Loader"]
        end

        subgraph TR["Training"]
            FineTune["Fine-Tuning<br/>(LoRA/SFT/OSFT)"]
            AutoMLTrain["AutoML<br/>(AutoGluon)"]
            AutoRAG["AutoRAG<br/>Optimization"]
        end

        subgraph DEP["Deployment"]
            KServeDeploy["KServe Model<br/>Serving"]
            ModelRegDeploy["Model Registry<br/>Deployment"]
        end

        subgraph EV["Evaluation"]
            EvalHub["EvalHub / KServe<br/>Evaluation"]
            LMEval["LM Eval"]
        end
    end

    subgraph PlatformServices["INTERNAL PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>HTTPS<br/>Auth: ServiceAccount"]
        KServeAPI["KServe<br/>serving.kserve.io<br/>Auth: RBAC"]
        ODHAPI["OpenDataHub Infra<br/>infrastructure.opendatahub.io<br/>Auth: RBAC"]
        RayAPI["CodeFlare / Ray<br/>ray.io RayJob<br/>Auth: RBAC"]
        KueueAPI["Kueue<br/>kueue.x-k8s.io<br/>Auth: RBAC (optional)"]
        ModelReg["Model Registry<br/>Auth: RBAC"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["AWS S3-Compatible<br/>HTTPS/TLS<br/>Auth: AWS_SECRET_ACCESS_KEY"]
        HF["HuggingFace Hub<br/>HTTPS/TLS<br/>Auth: HF_TOKEN"]
        LLMAPI["LLM API Endpoints<br/>HTTPS/TLS<br/>Auth: LLM_API_KEY"]
        OCI["OCI Registries<br/>HTTPS/TLS<br/>Auth: OCI_PULL_SECRET"]
        MinIO["MinIO<br/>HTTPS/TLS<br/>Auth: secretKeyRef"]
    end

    %% Orchestration flows
    KFP -->|orchestrates pods| ComponentPods

    %% Data Processing egress
    DatasetDL -->|HTTPS/TLS<br/>HF_TOKEN| HF
    DatasetDL -->|HTTPS/TLS<br/>AWS_SECRET_ACCESS_KEY| S3
    ParseChunk -->|RayJob CR<br/>RBAC| RayAPI
    ParseChunk -->|secretKeyRef<br/>no plaintext| MinIO
    ParseChunk -.->|optional quota<br/>RBAC| KueueAPI
    SDGComp -->|HTTPS/TLS<br/>LLM_API_KEY| LLMAPI

    %% Training egress
    FineTune -->|HTTPS/TLS<br/>S3_SECRET_KEY| S3
    AutoMLTrain -->|HTTPS/TLS<br/>credentials| S3
    AutoRAG -->|HTTPS/TLS<br/>LLM_API_KEY| LLMAPI

    %% Deployment egress
    KServeDeploy -->|InferenceService CR<br/>RBAC| KServeAPI
    ModelRegDeploy -->|registration<br/>RBAC| ModelReg

    %% Evaluation egress
    EvalHub -->|inference requests<br/>via KServe| KServeAPI

    %% Common platform access
    ComponentPods -->|HTTPS<br/>KUBERNETES_AUTH_TOKEN| K8sAPI

    %% OCI access
    FineTune -->|HTTPS/TLS<br/>OCI_PULL_SECRET| OCI

    %% Styling
    classDef orchestration fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef components fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef platform fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef external fill:#fff3e0,stroke:#e65100,stroke-width:2px

    class KFP orchestration
    class DatasetDL,ParseChunk,SDGComp,AutoMLData,FineTune,AutoMLTrain,AutoRAG,KServeDeploy,ModelRegDeploy,EvalHub,LMEval components
    class K8sAPI,KServeAPI,ODHAPI,RayAPI,KueueAPI,ModelReg platform
    class S3,HF,LLMAPI,OCI,MinIO external
