graph TB
    subgraph WVA["Workload Variant Autoscaler (controller-manager)"]
        direction TB

        subgraph Controllers["Kubernetes Reconcilers"]
            ConfigMapCtrl["ConfigMap Controller<br/>Reconciles saturation-scaling,<br/>scale-to-zero, queueing-model CMs"]
            HPACtrl["HPA Controller<br/>Watches HPAs with<br/>llm-d.ai/managed annotation"]
            InferencePoolCtrl["InferencePool Controller<br/>Watches v1 and v1alpha2<br/>InferencePool resources"]
            ScaledObjectCtrl["ScaledObject Controller<br/>Watches KEDA ScaledObjects<br/>(conditional on CRD)"]
        end

        subgraph Engines["Optimization Engines"]
            SaturationEngine["Saturation Engine<br/>Collects metrics, runs analyzers,<br/>emits scaling decisions"]
            ScaleFromZero["Scale-from-Zero Engine<br/>Handles scale-to-zero lifecycle<br/>with retention periods"]
            Coordinator["Coordinator (experimental)<br/>Leader-elected GPU quota<br/>rebalancing loop"]
        end

        subgraph Collectors["Data Collection"]
            PodScraper["Pod Scraping Source<br/>HTTP scraper for /metrics<br/>on inference pods"]
            PodLocator["Pod Locator<br/>Pod → RS → Deploy/LWS<br/>→ HPA/ScaledObject"]
            GPUDiscovery["GPU Discovery<br/>NVIDIA, AMD, Intel<br/>node capacity tracking"]
        end

        subgraph Plugins["Plugins"]
            GPURebalance["GPU Rebalance Plugin<br/>Proportional GPU quota<br/>allocation via queue depth"]
        end
    end

    %% Internal flows
    HPACtrl -->|discovers namespaces| SaturationEngine
    ScaledObjectCtrl -->|discovers namespaces| SaturationEngine
    InferencePoolCtrl -->|provides EndpointPools| SaturationEngine
    ConfigMapCtrl -->|provides config| SaturationEngine
    ConfigMapCtrl -->|provides config| ScaleFromZero

    SaturationEngine -->|uses| PodScraper
    SaturationEngine -->|uses| PodLocator
    SaturationEngine -->|uses| GPUDiscovery

    Coordinator -->|uses| GPURebalance

    %% External resources
    User["Platform Admin"] -->|creates| HPACR["HPA<br/>(llm-d.ai/managed: true)"]
    User -->|creates| ScaledObjectCR["ScaledObject<br/>(llm-d.ai/managed: true)"]
    User -->|creates| ConfigMapCR["ConfigMap<br/>(saturation-scaling)"]

    HPACR -->|watched by| HPACtrl
    ScaledObjectCR -->|watched by| ScaledObjectCtrl
    ConfigMapCR -->|watched by| ConfigMapCtrl

    InferencePoolCR["InferencePool CR<br/>(v1 / v1alpha2)"] -->|watched by| InferencePoolCtrl

    %% External dependencies
    SaturationEngine -->|queries metrics| Prometheus["Prometheus<br/>9090/TCP HTTPS"]
    SaturationEngine -->|emits wva_desired_replicas| MetricsEndpoint["/metrics<br/>8443/TCP HTTPS"]
    PodScraper -->|scrapes /metrics| EPPPods["EPP / Inference Pods"]
    GPUDiscovery -->|lists nodes| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    GPURebalance -->|patches quotas| K8sAPI

    MetricsEndpoint -->|scraped by| PrometheusAdapter["HPA / Prometheus Adapter<br/>/ KEDA"]
    PrometheusAdapter -->|scales| TargetDeploy["Target Deployment / LWS"]

    %% Styles
    style WVA fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Controllers fill:#e8f5e9,stroke:#2e7d32
    style Engines fill:#fff3e0,stroke:#e65100
    style Collectors fill:#f3e5f5,stroke:#6a1b9a
    style Plugins fill:#fce4ec,stroke:#b71c1c

    style SaturationEngine fill:#ff9800,stroke:#e65100,stroke-width:3px
    style Coordinator fill:#ff9800,stroke:#e65100,stroke-width:2px
    style Prometheus fill:#e0e0e0,stroke:#616161
    style K8sAPI fill:#e0e0e0,stroke:#616161
    style EPPPods fill:#e0e0e0,stroke:#616161
    style PrometheusAdapter fill:#c8e6c9,stroke:#2e7d32
    style TargetDeploy fill:#c8e6c9,stroke:#2e7d32
    style HPACR fill:#fff9c4,stroke:#f9a825
    style ScaledObjectCR fill:#fff9c4,stroke:#f9a825
    style ConfigMapCR fill:#fff9c4,stroke:#f9a825
    style InferencePoolCR fill:#fff9c4,stroke:#f9a825
