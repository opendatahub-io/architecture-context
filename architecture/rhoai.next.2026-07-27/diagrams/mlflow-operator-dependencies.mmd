graph LR
    MLflowOp["mlflow-operator"]

    %% Core Platform Dependencies
    MLflowOp -->|"resource CRUD<br/>watches, leader election"| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    MLflowOp -->|"chart rendering"| Helm["Helm v3<br/>(embedded library)"]
    MLflowOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>0.23.3"]

    %% Internal Platform Dependencies
    MLflowOp -->|"RBAC config"| AuthService["Auth Service<br/>(services.platform.opendatahub.io)"]

    %% Conditional Dependencies (CRD discovery)
    MLflowOp -.->|"HTTPRoute mgmt<br/>(conditional)"| GatewayAPI["Gateway API<br/>v1.4.1"]
    MLflowOp -.->|"ServiceMonitor mgmt<br/>(conditional)"| PrometheusOp["prometheus-operator<br/>v0.89.0"]
    MLflowOp -.->|"ConsoleLink mgmt<br/>(conditional)"| OpenShiftConsole["OpenShift Console"]

    %% Platform Services
    MLflowOp -->|"TLS cert provisioning"| ServiceCA["OpenShift service-ca"]
    MLflowOp -->|"TLS profile config"| APIServerConfig["OpenShift APIServer<br/>Config"]

    %% Integration Points (consumers of mlflow-operator)
    ODHDashboard["ODH Dashboard"] -.->|"UI management"| MLflowOp
    Pipelines["Data Science Pipelines"] -.->|"experiment tracking"| MLflowOp

    %% Styling
    style MLflowOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#000
    style Helm fill:#999,stroke:#333,color:#fff
    style CtrlRuntime fill:#999,stroke:#333,color:#fff
    style AuthService fill:#7ed321,stroke:#333,color:#000
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style PrometheusOp fill:#999,stroke:#333,color:#fff
    style OpenShiftConsole fill:#999,stroke:#333,color:#fff
    style ServiceCA fill:#999,stroke:#333,color:#fff
    style APIServerConfig fill:#999,stroke:#333,color:#fff
    style ODHDashboard fill:#7ed321,stroke:#333,color:#000
    style Pipelines fill:#7ed321,stroke:#333,color:#000
