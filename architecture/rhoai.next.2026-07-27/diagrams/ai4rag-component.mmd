graph TB
    subgraph "ai4rag Library"
        direction TB

        subgraph "Data Ingestion"
            S3Client["S3 Client<br/>(boto3)"]
            Downloader["S3 Downloader<br/>ThreadPoolExecutor<br/>max 8 threads"]
            S3Client --> Downloader
        end

        subgraph "Document Processing"
            TextExtraction["Text Extraction<br/>(Docling)"]
            Chunking["Text Chunking<br/>(LangChain Splitters)"]
            TextExtraction --> Chunking
        end

        subgraph "Vector Storage"
            OGXStore["OGX Vector Store<br/>(ogx-client)"]
            ChromaStore["Chroma Vector Store<br/>(langchain-chroma)"]
        end

        subgraph "Embedding & Optimization"
            OGXEmbed["OGX Embeddings"]
            Optimizer["RAG Optimizer<br/>(scikit-learn + pyGAM)"]
        end

        subgraph "Evaluation"
            Evaluator["LLM-as-a-Judge<br/>Evaluator"]
            Unitxt["Unitxt<br/>Evaluation Framework"]
            Evaluator --> Unitxt
        end

        Downloader -->|"documents"| TextExtraction
        Chunking -->|"chunks"| OGXStore
        Chunking -->|"chunks"| ChromaStore
        Chunking -->|"chunks"| OGXEmbed
        OGXEmbed -->|"embeddings"| Optimizer
    end

    %% External Services
    S3["AWS S3<br/>(S3-compatible storage)"]
    OGXService["OGX Service"]

    S3 -->|"HTTPS/TLS"| S3Client
    OGXStore -->|"API calls"| OGXService
    OGXEmbed -->|"API calls"| OGXService

    %% Consumer
    Consumer["Consumer Application"] -->|"imports"| ai4rag

    subgraph "ai4rag Library"
        ai4rag["ai4rag<br/>Python Package<br/>>=3.12, <3.14"]
    end

    %% Styling
    style S3Client fill:#4a90e2,stroke:#333
    style Downloader fill:#4a90e2,stroke:#333
    style TextExtraction fill:#4a90e2,stroke:#333
    style Chunking fill:#4a90e2,stroke:#333
    style OGXStore fill:#7ed321,stroke:#333
    style ChromaStore fill:#7ed321,stroke:#333
    style OGXEmbed fill:#7ed321,stroke:#333
    style Optimizer fill:#f5a623,stroke:#333
    style Evaluator fill:#f5a623,stroke:#333
    style Unitxt fill:#f5a623,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style OGXService fill:#e8e8e8,stroke:#333
    style Consumer fill:#d5e8d4,stroke:#333
    style ai4rag fill:#4a90e2,stroke:#333
