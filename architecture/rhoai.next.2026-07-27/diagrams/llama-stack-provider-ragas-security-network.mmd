graph TB
    subgraph HostProcess["LLAMA STACK SERVER PROCESS (Host)"]
        direction TB

        subgraph Provider["llama-stack-provider-ragas<br/>(trustyai_ragas)"]
            direction LR

            subgraph Inline["inline::trustyai_ragas"]
                InlineEval["RagasEvaluatorInline<br/>In-process execution<br/>max_workers=1"]
            end

            subgraph Remote["remote::trustyai_ragas"]
                RemoteEval["RagasEvaluatorRemote<br/>KFP pipeline submission<br/>Bearer token auth"]
            end
        end

        subgraph PlatformAPIs["Llama Stack Platform APIs<br/>(in-process, no network boundary)"]
            InferenceAPI["Inference API"]
            DatasetIOAPI["DatasetIO API"]
            FilesAPI["Files API"]
            BenchmarksAPI["Benchmarks API"]
        end

        InlineEval -->|in-process call<br/>no network| PlatformAPIs
    end

    subgraph KFPZone["KUBEFLOW PIPELINES (External)"]
        KFPAPI["KFP API Server<br/>Port: configurable<br/>Auth: Bearer Token<br/>Encryption: Unknown"]

        subgraph KFPPods["KFP Pipeline Pods"]
            Step1["Step 1: retrieve_data<br/>from Llama Stack API<br/>Auth: not evidenced"]
            Step2["Step 2: run_ragas_eval<br/>AWS creds from K8s Secret<br/>(use_secret_as_env)"]
        end
    end

    subgraph ExternalStorage["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>Port: 443/TCP<br/>Protocol: HTTPS<br/>Encryption: TLS<br/>Auth: AWS IAM credentials"]
    end

    %% Outbound flows from provider
    RemoteEval -->|Submit pipeline<br/>Bearer Token<br/>Encryption: Unknown| KFPAPI
    RemoteEval -->|GET get_run(run_id)<br/>Status polling| KFPAPI
    RemoteEval -->|pandas.read_json<br/>AWS credentials<br/>HTTPS/TLS| S3

    %% KFP Pod flows
    KFPAPI -->|orchestrates| KFPPods
    Step1 -->|HTTP/HTTPS<br/>Auth: unknown| HostProcess
    Step2 -->|HTTPS/443<br/>AWS IAM<br/>Write results.jsonl| S3

    %% Styling
    classDef hostprocess fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef provider fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platformapi fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef kfp fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class InlineEval,RemoteEval provider
    class InferenceAPI,DatasetIOAPI,FilesAPI,BenchmarksAPI platformapi
    class KFPAPI,Step1,Step2 kfp
    class S3 external
