graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(wva-system)"]
        SA_Prom["kube-prometheus-stack-prometheus<br/>(workload-variant-autoscaler-monitoring)"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_MetricsAuth["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_MetricsReader["metrics-reader-rolebinding<br/>(workload-variant-autoscaler-monitoring)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role"]
    end

    subgraph ManagerResources["manager-role Resources"]
        direction TB
        Core_RO["core (read-only)<br/>configmaps, namespaces, nodes,<br/>nodes/status, pods, resourcequotas,<br/>services<br/><i>get, list, watch</i>"]
        Core_Events["core<br/>events<br/><i>create, patch</i>"]
        Apps_Deploy["apps<br/>deployments<br/><i>get, list, patch, update, watch</i>"]
        Apps_Scale["apps<br/>deployments/scale<br/><i>get, update</i>"]
        Apps_RO["apps<br/>replicasets, statefulsets<br/><i>get, list, watch</i>"]
        Autoscaling["autoscaling<br/>horizontalpodautoscalers<br/><i>get, list, patch, update, watch</i>"]
        InferenceNet["inference.networking.k8s.io<br/>inference.networking.x-k8s.io<br/>inferencepools<br/><i>get, list, watch</i>"]
        KedaSH["keda.sh<br/>scaledobjects<br/><i>get, list, patch, update, watch</i>"]
        LWS_Res["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/><i>get, list, patch, update, watch</i>"]
        LWS_Scale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale<br/><i>get, update</i>"]
        Monitoring["monitoring.coreos.com<br/>servicemonitors<br/><i>get, list, watch</i>"]
    end

    subgraph AuthResources["metrics-auth-role Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/><i>create</i>"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/><i>create</i>"]
    end

    subgraph MetricsResource["metrics-reader Resources"]
        MetricsURL["Non-resource URL<br/>/metrics<br/><i>get</i>"]
    end

    subgraph LeaderResources["leader-election-role Resources"]
        Leases["coordination.k8s.io<br/>leases<br/><i>create, delete, get, list,<br/>patch, update, watch</i>"]
        LeaderEvents["core<br/>events<br/><i>create, patch</i>"]
    end

    %% SA → Binding → Role → Resources
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_MetricsAuth
    SA_CM -->|bound via| RB_Leader

    SA_Prom -->|bound via| CRB_MetricsReader
    SA_EPP -->|bound via| CRB_EPP

    CRB_Manager -->|grants| CR_Manager
    CRB_MetricsAuth -->|grants| CR_MetricsAuth
    CRB_MetricsReader -->|grants| CR_MetricsReader
    CRB_EPP -->|grants| CR_EPP
    RB_Leader -->|grants| R_Leader

    CR_Manager -->|permits| Core_RO
    CR_Manager -->|permits| Core_Events
    CR_Manager -->|permits| Apps_Deploy
    CR_Manager -->|permits| Apps_Scale
    CR_Manager -->|permits| Apps_RO
    CR_Manager -->|permits| Autoscaling
    CR_Manager -->|permits| InferenceNet
    CR_Manager -->|permits| KedaSH
    CR_Manager -->|permits| LWS_Res
    CR_Manager -->|permits| LWS_Scale
    CR_Manager -->|permits| Monitoring

    CR_MetricsAuth -->|permits| TokenReview
    CR_MetricsAuth -->|permits| SAR

    CR_MetricsReader -->|permits| MetricsURL
    CR_EPP -->|permits| MetricsURL

    R_Leader -->|permits| Leases
    R_Leader -->|permits| LeaderEvents

