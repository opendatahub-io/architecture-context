graph TD
    subgraph "Service Accounts"
        SA_BFF[BFF Internal Client<br/>ServiceAccount]
        SA_Controller[Controller Manager<br/>ServiceAccount]
    end

    subgraph "BFF Authorization Pipeline"
        direction TB
        Step1["1. InjectRequestIdentity<br/>Extract user identity"]
        Step2["2. AttachNamespace<br/>Resolve target namespace"]
        Step3["3. RequireAccessToMRService<br/>SAR check via SA credentials"]
        Step4["4. RequireListServiceAccessInNamespace<br/>Namespace-level access"]
        Step1 --> Step2
        Step2 --> Step3
        Step3 --> Step4
    end

    subgraph "Kubernetes AuthZ API Resources"
        SAR["authorization/v1<br/>SubjectAccessReview<br/>Verbs: create"]
        SSAR["authorization/v1<br/>SelfSubjectAccessReview<br/>Verbs: create"]
        SSRR["authorization/v1<br/>SelfSubjectRulesReview<br/>Verbs: create"]
        SSR["authentication/v1<br/>SelfSubjectReview<br/>Verbs: create"]
    end

    subgraph "Kubernetes Resource Access"
        ConfigMap["/v1 ConfigMap<br/>Verbs: create, update"]
        Secret["/v1 Secret<br/>Verbs: create"]
        ServiceRes["/v1 Service<br/>Verbs: get, list"]
        Namespace["/v1 Namespace<br/>Verbs: list"]
        Job["batch/v1 Job<br/>Verbs: create"]
        CRB["rbac/v1 ClusterRoleBinding<br/>Verbs: list"]
        InferenceService["serving.kserve.io/v1beta1<br/>InferenceService<br/>Verbs: watch, get, list"]
    end

    subgraph "Optimizations"
        AdminDetect["Cluster-admin Detection<br/>via ClusterRoleBinding inspection"]
        ParallelSAR["10-worker Parallel SAR Pool<br/>for namespace enumeration"]
    end

    %% BFF flows
    SA_BFF -->|"internal client<br/>(SA credentials)"| SAR
    SA_BFF -->|"token client<br/>(user token)"| SSAR
    SA_BFF -->|"token client"| SSRR
    SA_BFF -->|"token client"| SSR
    SA_BFF -->|"shared client"| ConfigMap
    SA_BFF -->|"shared client"| Secret
    SA_BFF -->|"shared client"| Job
    SA_BFF -->|"admin check"| CRB

    %% Controller flows
    SA_Controller -->|"controller watch"| InferenceService
    SA_Controller -->|"reconcile"| ServiceRes

    %% Optimization links
    CRB -.->|"feeds"| AdminDetect
    SAR -.->|"parallelized"| ParallelSAR

    %% Auth pipeline connection
    Step3 -->|"delegates to"| SA_BFF

    %% Styling
    style SA_BFF fill:#4a90e2,stroke:#333,color:#fff
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SAR fill:#f5a623,stroke:#333
    style SSAR fill:#f5a623,stroke:#333
    style SSRR fill:#f5a623,stroke:#333
    style SSR fill:#f5a623,stroke:#333
    style ConfigMap fill:#7ed321,stroke:#333,color:#fff
    style Secret fill:#7ed321,stroke:#333,color:#fff
    style ServiceRes fill:#7ed321,stroke:#333,color:#fff
    style Namespace fill:#7ed321,stroke:#333,color:#fff
    style Job fill:#7ed321,stroke:#333,color:#fff
    style CRB fill:#7ed321,stroke:#333,color:#fff
    style InferenceService fill:#7ed321,stroke:#333,color:#fff
    style AdminDetect fill:#e8e8e8,stroke:#333
    style ParallelSAR fill:#e8e8e8,stroke:#333
    style Step1 fill:#dae8fc,stroke:#6c8ebf
    style Step2 fill:#dae8fc,stroke:#6c8ebf
    style Step3 fill:#dae8fc,stroke:#6c8ebf
    style Step4 fill:#dae8fc,stroke:#6c8ebf
