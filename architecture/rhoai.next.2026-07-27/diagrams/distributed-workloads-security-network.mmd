graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / CI Pipeline"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS Edge)"]
        MinIOAPIRoute["minio-api Route<br/>HTTPS → HTTP<br/>TLS Edge"]
        MinIOUIRoute["minio-ui Route<br/>HTTPS → HTTP<br/>TLS Edge"]
        MinIOConsoleRoute["minio-console Route<br/>HTTPS → HTTP<br/>TLS Edge"]
        MinIORoute["minio Route<br/>HTTPS → HTTP<br/>TLS Edge"]
    end

    subgraph Internal["INTERNAL SERVICES (ClusterIP)"]
        direction TB

        subgraph NS_Default["Example Namespace"]
            MinIOSvc["minio-service<br/>9000/TCP (S3 API)<br/>9090/TCP (Metrics)<br/>Auth: Access Key"]
            MinIOSvc2["minio<br/>9000/TCP → http<br/>9001/TCP → console<br/>Auth: Access Key"]
        end

        subgraph NS_NFS["Namespace: nfs"]
            NFSSvc["nfs-server<br/>111/UDP (portmapper)<br/>2049/TCP (NFS)<br/>SCC: privileged"]
        end

        subgraph NS_Distributed["Namespace: distributed"]
            TrainingPods["Training Workers<br/>MPI+DDP Pods<br/>SA: stable-diffusion-nb<br/>Role: edit"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount"]
        HFHub["HuggingFace Hub<br/>443/TCP<br/>HTTPS<br/>TLS 1.2+<br/>HF Token"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS Edge<br/>OpenShift OAuth"| MinIOAPIRoute
    User -->|"HTTPS/443<br/>TLS Edge"| MinIOUIRoute
    User -->|"HTTPS/443<br/>TLS Edge"| MinIOConsoleRoute

    %% Ingress to Services
    MinIOAPIRoute -->|"HTTP/9000<br/>Plaintext"| MinIOSvc
    MinIOUIRoute -->|"HTTP/9001<br/>Plaintext"| MinIOSvc2
    MinIOConsoleRoute -->|"HTTP/9090<br/>Plaintext"| MinIOSvc

    %% Internal flows
    TrainingPods -->|"S3 API/9000<br/>MinIO Credentials"| MinIOSvc
    TrainingPods -->|"NFS/2049<br/>No Auth"| NFSSvc

    %% Egress
    TrainingPods -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    TrainingPods -->|"HTTPS/443<br/>TLS 1.2+<br/>HF Token"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef privileged fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class MinIOAPIRoute,MinIOUIRoute,MinIOConsoleRoute,MinIORoute ingress
    class MinIOSvc,MinIOSvc2,TrainingPods internal
    class NFSSvc privileged
    class K8sAPI,HFHub externalservice
