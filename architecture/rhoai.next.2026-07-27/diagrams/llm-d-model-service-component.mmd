graph TB
    subgraph "llm-d-model-service Operator"
        direction TB
        CLI["Cobra CLI<br/>run | generate"]
        CLI -->|run| ControllerManager["modelservice-controller-manager<br/>(Deployment)"]
        CLI -->|generate| OfflineGen["Offline Manifest Generator"]

        subgraph "Controller Manager"
            direction TB
            Reconciler["ModelServiceReconciler"]
            TemplateEngine["Sprig Template<br/>Interpolation Engine"]
            MergeEngine["Mergo Merge Engine<br/>(custom transformers)"]
            HealthProbe["Health/Readiness Probes<br/>:8081/TCP"]
            MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>TokenReview + SAR"]

            Reconciler -->|interpolates| TemplateEngine
            Reconciler -->|merges configs| MergeEngine
        end
    end

    %% External inputs
    User[Platform Operator / Model Owner] -->|creates| ModelServiceCR["ModelService CR<br/>(llm-d.ai/v1alpha1)"]
    PlatformOp[Platform Operator] -->|defines| BaseConfig["BaseConfig ConfigMap<br/>(reusable presets)"]

    ModelServiceCR -->|watched by| Reconciler
    BaseConfig -->|read by| Reconciler

    %% Child resources created by controller
    subgraph "Dynamic Child Resources (per ModelService)"
        direction TB
        PrefillDeploy["Prefill Deployment"]
        DecodeDeploy["Decode Deployment"]
        EPPDeploy["EPP Deployment<br/>(Endpoint Picker)"]
        PrefillSvc["Prefill Service"]
        DecodeSvc["Decode Service"]
        EPPSvc["EPP Service"]
        SvcAccounts["ServiceAccounts<br/>(PD + EPP)"]
        RoleBindings["RoleBindings<br/>(EPP ClusterRole)"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        InferencePool["InferencePool<br/>(Inference Extension)"]
        InferenceModel["InferenceModel<br/>(Inference Extension)"]
        ChildConfigMaps["ConfigMaps"]
    end

    Reconciler -->|creates/updates| PrefillDeploy
    Reconciler -->|creates/updates| DecodeDeploy
    Reconciler -->|creates/updates| EPPDeploy
    Reconciler -->|creates/updates| PrefillSvc
    Reconciler -->|creates/updates| DecodeSvc
    Reconciler -->|creates/updates| EPPSvc
    Reconciler -->|creates/updates| SvcAccounts
    Reconciler -->|creates/updates| RoleBindings
    Reconciler -->|creates/updates| HTTPRoute
    Reconciler -->|creates/updates| InferencePool
    Reconciler -->|creates/updates| InferenceModel
    Reconciler -->|creates/updates| ChildConfigMaps

    %% External dependencies
    Reconciler -->|CRUD via| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    HTTPRoute -->|references| Gateway["Gateway<br/>(gateway.networking.k8s.io)"]
    InferencePool -->|references| EPPDeploy
    InferenceModel -->|maps to| InferencePool

    %% Model artifacts
    subgraph "Model Artifact Backends"
        HF["HuggingFace<br/>(hf://)"]
        PVC["PVC Storage<br/>(pvc://)"]
        OCI["OCI Images<br/>(oci:// partial)"]
    end

    PrefillDeploy -.->|loads from| HF
    PrefillDeploy -.->|loads from| PVC
    DecodeDeploy -.->|loads from| HF
    DecodeDeploy -.->|loads from| PVC

    %% Styling
    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style ControllerManager fill:#4a90e2,stroke:#333,color:#fff
    style Reconciler fill:#4a90e2,stroke:#333,color:#fff
    style TemplateEngine fill:#5ba3d9,stroke:#333,color:#fff
    style MergeEngine fill:#5ba3d9,stroke:#333,color:#fff
    style HealthProbe fill:#5ba3d9,stroke:#333,color:#fff
    style MetricsEndpoint fill:#5ba3d9,stroke:#333,color:#fff
    style ModelServiceCR fill:#f5a623,stroke:#333
    style BaseConfig fill:#f5a623,stroke:#333
    style PrefillDeploy fill:#7ed321,stroke:#333
    style DecodeDeploy fill:#7ed321,stroke:#333
    style EPPDeploy fill:#7ed321,stroke:#333
    style PrefillSvc fill:#7ed321,stroke:#333
    style DecodeSvc fill:#7ed321,stroke:#333
    style EPPSvc fill:#7ed321,stroke:#333
    style SvcAccounts fill:#7ed321,stroke:#333
    style RoleBindings fill:#7ed321,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style InferencePool fill:#7ed321,stroke:#333
    style InferenceModel fill:#7ed321,stroke:#333
    style ChildConfigMaps fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style HF fill:#fff2cc,stroke:#d6b656
    style PVC fill:#fff2cc,stroke:#d6b656
    style OCI fill:#fff2cc,stroke:#d6b656,stroke-dasharray: 5 5
