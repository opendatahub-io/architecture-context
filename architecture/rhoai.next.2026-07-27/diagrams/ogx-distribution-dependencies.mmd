graph LR
    OGX["ogx-distribution<br/>(OGX Server :8321)"]

    %% Hard Runtime Dependency
    OGX ==>|"state persistence<br/>5432/TCP<br/>REQUIRED"| PostgreSQL["PostgreSQL<br/>(kv_postgres + sql_postgres)"]

    %% Inference Providers (env-var activated)
    OGX -->|"inference"| vLLM["vLLM<br/>(self-hosted)"]
    OGX -->|"inference<br/>443/TCP"| Bedrock["AWS Bedrock"]
    OGX -->|"inference<br/>443/TCP"| WatsonX["IBM WatsonX"]
    OGX -->|"inference<br/>443/TCP"| AzureOAI["Azure OpenAI"]
    OGX -->|"inference<br/>443/TCP"| VertexAI["Google Vertex AI"]
    OGX -->|"inference<br/>443/TCP"| OpenAI["OpenAI"]
    OGX -->|"inference<br/>443/TCP"| Gemini["Google Gemini"]
    OGX -->|"inference<br/>443/TCP"| Anthropic["Anthropic"]
    OGX -->|"embeddings"| SentTrans["sentence-transformers<br/>(local)"]

    %% Vector Stores (env-var activated)
    OGX -->|"vector search<br/>19530/TCP"| Milvus["Milvus"]
    OGX -->|"vector search<br/>5432/TCP"| PGVector["pgvector"]
    OGX -->|"vector search<br/>6333/TCP"| Qdrant["Qdrant"]

    %% File Storage
    OGX -->|"file storage<br/>443/TCP"| S3["S3 Storage"]

    %% Tool Services (env-var activated)
    OGX -->|"web search<br/>443/TCP"| Brave["Brave Search API"]
    OGX -->|"web search<br/>443/TCP"| Tavily["Tavily Search API"]
    OGX -->|"tool execution"| MCP["MCP Server"]

    %% Observability
    OGX -.->|"traces + metrics<br/>OTLP"| OTEL["OpenTelemetry<br/>Collector"]

    %% Platform Management
    RHOAIOp["RHOAI Platform<br/>Operator"] -->|"deploys + manages"| OGX

    %% Built-in
    OGX --- GraniteEmbed["IBM Granite<br/>Embedding Model<br/>(pre-fetched)"]

    %% Styling
    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Hard dependency
    style PostgreSQL fill:#e74c3c,stroke:#333,stroke-width:3px,color:#fff

    %% Inference providers
    style vLLM fill:#999,stroke:#333,color:#fff
    style Bedrock fill:#999,stroke:#333,color:#fff
    style WatsonX fill:#999,stroke:#333,color:#fff
    style AzureOAI fill:#999,stroke:#333,color:#fff
    style VertexAI fill:#999,stroke:#333,color:#fff
    style OpenAI fill:#999,stroke:#333,color:#fff
    style Gemini fill:#999,stroke:#333,color:#fff
    style Anthropic fill:#999,stroke:#333,color:#fff
    style SentTrans fill:#999,stroke:#333,color:#fff

    %% Vector stores
    style Milvus fill:#f5a623,stroke:#333,color:#fff
    style PGVector fill:#f5a623,stroke:#333,color:#fff
    style Qdrant fill:#f5a623,stroke:#333,color:#fff

    %% Storage + tools
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style Brave fill:#9673a6,stroke:#333,color:#fff
    style Tavily fill:#9673a6,stroke:#333,color:#fff
    style MCP fill:#9673a6,stroke:#333,color:#fff

    %% Platform
    style RHOAIOp fill:#7ed321,stroke:#333,color:#fff

    %% Built-in
    style GraniteEmbed fill:#7ed321,stroke:#333,color:#fff

    %% Observability
    style OTEL fill:#ccc,stroke:#666,color:#333
