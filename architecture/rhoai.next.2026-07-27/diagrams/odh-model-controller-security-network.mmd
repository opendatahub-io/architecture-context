graph TB
    subgraph External["CLUSTER INTERNAL ONLY (No External Ingress)"]
        direction TB
        Note["All services are ClusterIP<br/>No ingress routes defined"]
    end

    subgraph APIServer["KUBERNETES API SERVER"]
        KubeAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token auth"]
    end

    subgraph ManagerZone["DEPLOYMENT: odh-model-controller"]
        direction TB

        subgraph WebhookListener["Webhook Server"]
            WebhookPort["Port 9443/TCP<br/>HTTPS / TLS<br/>Cert: odh-model-controller-webhook-cert<br/>(OpenShift service-ca)<br/>Auth: Kubernetes admission"]
        end

        subgraph MetricsListener["Metrics (Manager)"]
            MetricsPort["Port 8080/TCP<br/>HTTP / No TLS<br/>Auth: Conditional<br/>(TokenReview/SAR — disabled)"]
        end

        subgraph HealthListener["Health Probes"]
            HealthPort["Port 8081/TCP<br/>HTTP / No TLS<br/>Auth: None (by design)<br/>/healthz, /readyz"]
        end

        ManagerSA["SA: odh-model-controller<br/>HTTP/2: DISABLED (CVE)"]
    end

    subgraph APIZone["DEPLOYMENT: model-serving-api"]
        direction TB

        subgraph APIListener["API Server"]
            APIPort["Port 8443/TCP<br/>HTTPS / TLS<br/>Cert: model-serving-api-tls<br/>(OpenShift service-ca)<br/>/api/v1/gateways<br/>/api/v1/samples/llm-d"]
        end

        subgraph APIMetrics["Metrics (API)"]
            APIMetricsPort["Port 8080/TCP<br/>HTTP / No TLS<br/>Auth: Unknown"]
        end

        APISA["SA: model-serving-api"]
    end

    subgraph Egress["EGRESS — EXTERNAL SERVICES"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Runtime-configured port<br/>Distributed trace export"]
    end

    %% Admission webhook flow
    KubeAPI -->|"Admission webhooks<br/>HTTPS/443 → 9443<br/>TLS (service-ca)<br/>K8s admission auth"| WebhookPort

    %% Controller → API server
    ManagerSA -->|"Watches + CRUD<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA token"| KubeAPI

    %% API server deployment → API server
    APISA -->|"Gateway discovery<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA token"| KubeAPI

    %% Services
    KubeAPI -.->|"ClusterIP: odh-model-controller-webhook-service<br/>443→9443"| WebhookPort
    KubeAPI -.->|"ClusterIP: odh-model-controller-metrics-service<br/>8080→8080"| MetricsPort
    KubeAPI -.->|"ClusterIP: model-serving-api<br/>443→8443, 8080→8080"| APIPort

    %% Trace export
    ManagerSA -->|"OTLP/gRPC<br/>Runtime config"| OTel

    %% Styling
    classDef apiserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef metrics fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef health fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef egress fill:#f5f5f5,stroke:#666,stroke-width:1px
    classDef note fill:#fff,stroke:#ccc,stroke-width:1px,stroke-dasharray: 5 5

    class KubeAPI apiserver
    class WebhookPort webhook
    class MetricsPort,APIMetricsPort metrics
    class HealthPort health
    class APIPort controller
    class ManagerSA,APISA controller
    class OTel egress
    class Note note
