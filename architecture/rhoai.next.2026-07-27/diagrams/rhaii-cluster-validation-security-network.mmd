graph TB
    subgraph Local["LOCAL / OPERATOR WORKSTATION"]
        CLI["kubectl-rhaii_validate<br/>Auth: kubeconfig credential chain<br/>(admin-level)"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]
    end

    subgraph WorkloadPlane["WORKLOAD PLANE (Ephemeral)<br/>Namespace: rhaii-validation"]
        direction TB

        subgraph RBAC_Ephemeral["Ephemeral RBAC"]
            SA["ServiceAccount<br/>rhaii-validator<br/>Token mount: DISABLED"]
            CR["ClusterRole<br/>rhaii-validator<br/>(empty rules)"]
            CRB["ClusterRoleBinding<br/>rhaii-validator"]
            SCC["ClusterRoleBinding<br/>SCC: privileged<br/>(OpenShift only)"]
        end

        subgraph Jobs["Per-Node Validation Jobs"]
            ValidatorPod["Validator Pod<br/>SA: rhaii-validator<br/>Privileged: true (OCP)"]
            ToolsPod["Tools Pod<br/>iperf3, RDMA tools"]
        end

        subgraph Hardware["Host Hardware Access"]
            GPUDev["GPU Devices<br/>NVIDIA / AMD"]
            Sysfs["Host sysfs<br/>Topology, NIC status"]
            RDMADev["RDMA Devices<br/>InfiniBand verbs"]
        end
    end

    %% Flows
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| K8sAPI

    K8sAPI -->|"Resource CRUD<br/>Namespace, SA, Job,<br/>ClusterRole, ConfigMap"| WorkloadPlane

    ValidatorPod -->|"GPU check<br/>Driver, ECC"| GPUDev
    ValidatorPod -->|"Device topology<br/>NUMA, PCIe"| Sysfs
    ToolsPod -->|"RDMA probes<br/>ibv_rc_pingpong,<br/>ib_write_bw"| RDMADev
    ToolsPod -->|"TCP bandwidth<br/>iperf3"| ValidatorPod

    SA ---|bound via| CRB
    CRB ---|grants| CR
    SA ---|SCC grant| SCC

    %% No ingress, no external services
    NoIngress["No Ingress<br/>No HTTP/gRPC endpoints"]
    NoEgress["No external egress<br/>(K8s API only)"]

    %% Styling
    classDef local fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hardware fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef rbac fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef note fill:#f5f5f5,stroke:#999,stroke-dasharray:5 5

    class CLI local
    class K8sAPI controlplane
    class ValidatorPod,ToolsPod workload
    class GPUDev,Sysfs,RDMADev hardware
    class SA,CR,CRB,SCC rbac
    class NoIngress,NoEgress note
