graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Platform Admin<br/>kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (ogx-k8s-operator-system)"]
        direction TB

        subgraph ManagerPod["ogx-k8s-operator-controller-manager"]
            direction LR
            OGXCtrl["OGX Controller<br/>SA: ogx-k8s-operator-controller-manager"]
            OGXServerCtrl["OGXServer Controller<br/>SA: ogx-k8s-operator-controller-manager"]
            WebhookHandler["OGXServerValidator<br/>Webhook Handler"]
        end

        subgraph Services["Cluster Services"]
            MetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP<br/>kube-rbac-proxy<br/>TokenReview + SAR"]
            WebhookSvc["Webhook Service<br/>ClusterIP 443→9443/TCP<br/>TLS (webhook-cert Secret)"]
        end

        HealthProbe["Health Probes<br/>:8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth"]
    end

    subgraph ManagedNS["MANAGED NAMESPACES (user)"]
        ManagedResources["Deployments, Services,<br/>ConfigMaps, PVCs, HPAs,<br/>NetworkPolicies, Ingresses,<br/>PDBs, RBAC"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>monitoring.coreos.com"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        OCIRegistry["OCI Container Registry<br/>443/TCP HTTPS<br/>Registry Credentials"]
    end

    %% CRDs
    subgraph CRDs["CUSTOM RESOURCES"]
        OGXCR["OGX CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster-scoped"]
        OGXServerCR["OGXServer CR<br/>ogx.io/v1beta1<br/>Namespaced"]
        LlamaStackCR["LlamaStackDistribution CR<br/>llamastack.io/v1alpha1<br/>Namespaced"]
    end

    %% Flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| APIServer

    APIServer -->|"Admission Webhook<br/>HTTPS/443→9443<br/>TLS (cert Secret)<br/>Kubernetes Admission"| WebhookSvc
    WebhookSvc --> WebhookHandler

    APIServer -->|"Watch Events<br/>HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA Token"| OGXCtrl
    APIServer -->|"Watch Events<br/>HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA Token"| OGXServerCtrl

    OGXCtrl -->|"CRUD Resources<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    OGXServerCtrl -->|"CRUD Resources<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    APIServer -->|"Resource Ops"| ManagedResources
    APIServer -->|"CRD Registration"| CRDs

    Prometheus -->|"HTTPS/8443<br/>kube-rbac-proxy<br/>TokenReview + SAR"| MetricsSvc

    OGXServerCtrl -.->|"OCI Label Resolution<br/>HTTPS/443"| OCIRegistry

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef control fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef extsvc fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef crd fill:#f5a623,stroke:#d79b00,stroke-width:2px,color:#fff

    class Admin external
    class APIServer control
    class OGXCtrl,OGXServerCtrl,WebhookHandler,MetricsSvc,WebhookSvc,HealthProbe operator
    class ManagedResources managed
    class Prometheus monitoring
    class OCIRegistry extsvc
    class OGXCR,OGXServerCR,LlamaStackCR crd
