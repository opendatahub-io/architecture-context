graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Guardrails Orchestrator"]
    end

    subgraph AppLayer["APPLICATION LAYER (No Auth Middleware ⚠)"]
        direction TB

        subgraph BuiltInNS["Service: guardrails-detectors"]
            BuiltIn["Built-in Detector (FastAPI)<br/>Endpoints: /api/v1/text/contents,<br/>/registry, /metrics<br/>Auth: None<br/>Encryption: Configurable"]
        end

        subgraph LLMJudgeNS["Service: guardrails-detectors"]
            LLMJudge["LLM Judge Detector (FastAPI)<br/>Endpoints: /api/v1/text/contents,<br/>/api/v1/text/generation,<br/>/api/v1/metrics<br/>Auth: None<br/>Encryption: Configurable"]
        end
    end

    subgraph ModelStorage["MODEL STORAGE (Internal)"]
        direction TB
        MinIO["MinIO Server<br/>minio-guardrails-guardian (ClusterIP)<br/>9000/TCP<br/>Auth: Static credentials (plaintext ⚠)<br/>Image: quay.io/trustyai/modelmesh-minio-examples"]
        InitContainer["Init Container (llm_downloader)<br/>quay.io/rgeada/llm_downloader"]
        PVC["PVC: guardrails-models-claim-guardian<br/>100Gi"]
        InitContainer -->|"writes models"| PVC
        MinIO -->|"reads models"| PVC
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HuggingFace["HuggingFace Hub<br/>huggingface.co<br/>HTTPS/443 TLS<br/>Model: ibm-granite/granite-guardian-3.0-2b"]
    end

    subgraph Secrets["SECRETS"]
        S3Secret["aws-connection-minio-data-connection<br/>-guardrails-guardian<br/>Type: Opaque<br/>Annotation: opendatahub.io/connection-type: s3"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS<br/>No Auth ⚠<br/>Encryption: Configurable"| BuiltIn
    Client -->|"HTTP/HTTPS<br/>No Auth ⚠<br/>Encryption: Configurable"| LLMJudge
    LLMJudge -->|"S3 API / 9000/TCP<br/>Static credentials ⚠<br/>Encryption: Unknown"| MinIO
    InitContainer -->|"HTTPS/443<br/>TLS<br/>HF Token (if gated)"| HuggingFace
    S3Secret -.->|"provides credentials"| MinIO

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appWarning fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef storage fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalService fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class BuiltIn,LLMJudge appWarning
    class MinIO,InitContainer,PVC storage
    class HuggingFace externalService
    class S3Secret secret
