graph TB
    subgraph UserWorkload["User Workload (Notebook / Script)"]
        direction TB
        Import["import trustyai"]
    end

    subgraph TrustyAIPkg["trustyai Python Package (v0.6.1)"]
        direction TB

        subgraph Initializer["Initializer"]
            JVMInit["JVM Bootstrap<br/>(JPype1 1.5.0)"]
            JARLoad["Load explainability-arrow<br/>-999-SNAPSHOT.jar"]
            JVMInit --> JARLoad
        end

        subgraph Explainers["Explainers Module"]
            LIME["LIME"]
            SHAP["SHAP"]
            PDP["PDP"]
            CF["Counterfactual"]
        end

        subgraph Metrics["Metrics Module"]
            Fairness["Fairness Metrics"]
            Distance["Distance Metrics"]
        end

        subgraph LocalModule["Local Module"]
            Toxicity["Language Toxicity<br/>Detection"]
            HFModels["HuggingFace /<br/>Local Model Loading"]
        end

        subgraph Utils["Utils"]
            MetricsService["TrustyAIMetricsService<br/>(HTTP Client)"]
            TrustyAIApi["TrustyAIApi<br/>(Route Discovery)"]
            Viz["Visualization<br/>Utilities"]
        end

        JARLoad -->|Java classes| Explainers
        JARLoad -->|Java classes| Metrics
        MetricsService -->|uses| TrustyAIApi
    end

    Import --> TrustyAIPkg

    subgraph ExternalServices["External Services"]
        TrustyAISvc["TrustyAI Service<br/>(HTTPS)"]
        Thanos["Thanos Querier<br/>(HTTPS)"]
        ModelEP["Model Endpoints<br/>(HTTPS)"]
        K8sAPI["Kubernetes API<br/>(HTTPS)"]
    end

    MetricsService -->|"POST /data/upload<br/>GET /info<br/>POST /metrics/{metric}"| TrustyAISvc
    MetricsService -->|"GET /api/v1/query<br/>(PromQL)"| Thanos
    MetricsService -->|"POST /infer"| ModelEP
    TrustyAIApi -->|"Route discovery<br/>(dynamic client)"| K8sAPI

