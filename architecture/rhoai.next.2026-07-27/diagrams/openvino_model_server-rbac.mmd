graph TD
    subgraph "OVMS Security Model"
        direction TB

        subgraph "Container Security Context"
            SecurityCtx["Container: kserve-container<br/>runAsNonRoot: true<br/>runAsUser: 5000<br/>capabilities: drop ALL<br/>allowPrivilegeEscalation: false"]
        end

        subgraph "Network Security (Delegated)"
            IstioMTLS["Istio Service Mesh<br/>mTLS STRICT<br/>Service Identity"]
            KServeAuth["KServe Auth<br/>Request Authentication<br/>Authorization Policies"]
        end

        subgraph "Optional mTLS Sidecar"
            NGINXAuth["NGINX Sidecar<br/>Certificate-based mTLS<br/>Client cert validation"]
        end

        subgraph "OVMS Application"
            NoAuth["OVMS Process<br/>⚠ No built-in auth<br/>No RBAC enforcement<br/>Runs as unprivileged user"]
        end

        subgraph "KServe Managed RBAC"
            KServeSA["KServe Controller SA<br/>kserve-controller-manager"]
            KServeCR["ClusterRole<br/>kserve-manager-role"]
            KServeCRB["ClusterRoleBinding<br/>kserve-manager-rolebinding"]

            KServeSA -->|"bound via"| KServeCRB
            KServeCRB -->|"grants"| KServeCR
        end

        subgraph "KServe Managed Resources"
            ISVC["serving.kserve.io<br/>InferenceService"]
            SR["serving.kserve.io<br/>ServingRuntime"]
            CSR["serving.kserve.io<br/>ClusterServingRuntime"]
        end

        KServeCR -->|"manages lifecycle"| ISVC
        KServeCR -->|"manages"| SR
        KServeCR -->|"manages"| CSR
        SR -->|"defines"| NoAuth
        IstioMTLS -->|"protects"| NoAuth
        KServeAuth -->|"enforces policy"| NoAuth
        NGINXAuth -.->|"optional protection"| NoAuth
    end

    Note["Note: OVMS has no built-in RBAC.<br/>All access control is delegated to<br/>KServe + Istio service mesh layer."]

    style SecurityCtx fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    style NoAuth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style IstioMTLS fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style KServeAuth fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style NGINXAuth fill:#fff2cc,stroke:#d6b656,stroke-width:2px,stroke-dasharray:5
    style KServeSA fill:#4a90e2,stroke:#333,color:#fff
    style KServeCR fill:#f5a623,stroke:#333
    style KServeCRB fill:#f5a623,stroke:#333
    style ISVC fill:#7ed321,stroke:#333
    style SR fill:#7ed321,stroke:#333
    style CSR fill:#7ed321,stroke:#333
    style Note fill:#fff,stroke:#999,stroke-dasharray:5
