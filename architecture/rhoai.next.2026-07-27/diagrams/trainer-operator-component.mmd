graph TB
    subgraph TrainerOperator["Trainer Operator"]
        direction TB
        Controller["TrainerReconciler<br/>(controller-manager)"]
        Webhook["Webhook Server<br/>:9443/TCP TLS"]
        HealthProbe["Health/Readiness Probes<br/>:8081/TCP"]
        Metrics["Metrics Endpoint<br/>:8080/TCP HTTP"]
    end

    subgraph ManifestPipeline["Manifest Rendering Pipeline"]
        Templates["/opt/manifests-template<br/>/opt/runtimes-template<br/>/opt/imagestreams-template"]
        WorkDir["/opt/manifests-work"]
        Templates -->|render| WorkDir
    end

    subgraph PlatformCR["Platform Custom Resource"]
        TrainerCR["Trainer CR<br/>(default-trainer)<br/>components.platform.opendatahub.io/v1alpha1"]
    end

    subgraph KubeflowCRDs["Kubeflow Trainer CRDs"]
        TrainJob["TrainJob<br/>trainer.kubeflow.org/v1alpha1<br/>(Namespaced)"]
        TrainingRuntime["TrainingRuntime<br/>trainer.kubeflow.org/v1alpha1<br/>(Namespaced)"]
        ClusterTrainingRuntime["ClusterTrainingRuntime<br/>trainer.kubeflow.org/v1alpha1<br/>(Cluster)"]
    end

    subgraph ManagedResources["Managed Resources"]
        KubeflowController["kubeflow-trainer-controller-manager<br/>Deployment"]
        ManagedWebhooks["ValidatingWebhookConfigurations"]
        ManagedRBAC["ClusterRoles & Bindings"]
        ManagedServices["Services & ConfigMaps"]
        ImageStreams["OpenShift ImageStreams"]
    end

    %% Primary watch
    TrainerCR -->|watched by (For)| Controller

    %% Secondary watches
    KubeflowController -->|watched by (Watches)| Controller
    ManagedServices -->|watched by (Watches)| Controller
    ManagedWebhooks -->|watched by (Watches)| Controller

    %% Controller creates managed resources
    Controller -->|renders & applies| WorkDir
    WorkDir -->|creates| KubeflowController
    WorkDir -->|creates| ManagedWebhooks
    WorkDir -->|creates| ManagedRBAC
    WorkDir -->|creates| ManagedServices
    WorkDir -->|creates| ImageStreams

    %% Webhook validates CRDs
    Webhook -->|validates CREATE/UPDATE| TrainJob
    Webhook -->|validates CREATE/UPDATE| TrainingRuntime
    Webhook -->|validates CREATE/UPDATE| ClusterTrainingRuntime

    %% External dependencies
    Controller -->|uses| PlatformUtils["odh-platform-utilities"]
    Controller -->|monitors| PrometheusOp["prometheus-operator"]
    Controller -->|REST/HTTPS| K8sAPI["Kubernetes API<br/>:6443"]

    %% Label-scoped cache
    Controller -.->|label filter:<br/>platform.opendatahub.io/part-of: trainer| KubeflowController

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style HealthProbe fill:#4a90e2,color:#fff
    style Metrics fill:#4a90e2,color:#fff
    style TrainerCR fill:#f5a623,color:#fff
    style TrainJob fill:#f5a623,color:#fff
    style TrainingRuntime fill:#f5a623,color:#fff
    style ClusterTrainingRuntime fill:#f5a623,color:#fff
    style KubeflowController fill:#7ed321,color:#fff
    style ManagedWebhooks fill:#7ed321,color:#fff
    style ManagedRBAC fill:#7ed321,color:#fff
    style ManagedServices fill:#7ed321,color:#fff
    style ImageStreams fill:#7ed321,color:#fff
    style PlatformUtils fill:#e8e8e8,stroke:#333
    style PrometheusOp fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
