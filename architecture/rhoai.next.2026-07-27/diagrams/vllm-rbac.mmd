graph TD
    subgraph "vLLM Container Security"
        Container["odh-vllm-cuda-rhel9<br/>Runs as UID 2000 (non-root)"]
    end

    subgraph "Security Delegation"
        direction TB
        Note1["No RBAC resources defined<br/>in this repository"]
        Note2["No in-container AuthN/AuthZ"]
        Note3["No in-container TLS termination"]
        Note4["No secrets managed in image"]
    end

    subgraph "Platform-Managed Security"
        KServe["KServe / Model Serving Stack<br/>Manages RBAC for deployed models"]
        ServiceMesh["Service Mesh (Istio/OSSM)<br/>Enforces mTLS STRICT<br/>PeerAuthentication<br/>AuthorizationPolicy"]
        K8sSA["Kubernetes Service Account<br/>Created by deploying operator"]
    end

    subgraph "Build Security"
        Konflux["Konflux CI/CD<br/>Tekton PipelineRuns"]
        BaseImage["Base Image: registry.redhat.io<br/>rhaiis/vllm-cuda-rhel9:3.2.2<br/>Red Hat signed & scanned"]
    end

    Container -->|"security delegated to"| KServe
    Container -->|"traffic secured by"| ServiceMesh
    Container -->|"identity from"| K8sSA
    Konflux -->|"builds"| Container
    BaseImage -->|"provides runtime"| Container

    %% Styling
    style Container fill:#4a90e2,stroke:#333,color:#fff
    style Note1 fill:#fff3cd,stroke:#ffc107
    style Note2 fill:#fff3cd,stroke:#ffc107
    style Note3 fill:#fff3cd,stroke:#ffc107
    style Note4 fill:#fff3cd,stroke:#ffc107
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ServiceMesh fill:#7ed321,stroke:#333,color:#fff
    style K8sSA fill:#7ed321,stroke:#333,color:#fff
    style Konflux fill:#999,stroke:#333,color:#fff
    style BaseImage fill:#f5a623,stroke:#333,color:#fff
