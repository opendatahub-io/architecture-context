            Cleanlab["Cleanlab Module"]
            Presidio["Presidio Analyzer/<br/>Anonymizer"]
        end
    end

    Client[External Client] -->|"POST /v1/chat/completions<br/>Bearer Token / API Key"| GuardrailsServer
    GuardrailsServer --> ChatEndpoint
    GuardrailsServer --> CompletionsEndpoint
    GuardrailsServer --> ChecksEndpoint
    GuardrailsServer --> ModelsEndpoint
    GuardrailsServer --> ConfigsEndpoint
    GuardrailsServer --> ChallengesEndpoint
    GuardrailsServer --> HealthEndpoint

    ActionsServer --> ActionsRun
    ActionsServer --> ActionsList

    JailbreakServer --> JailbreakHeuristic
    JailbreakServer --> HeuristicsEndpoint
    JailbreakServer --> ModelEndpoint

    AlignScoreServer --> AlignScoreBase
    AlignScoreServer --> AlignScoreLarge

    GuardrailsServer -->|"uses"| Library
    Library --> ActiveFence
    Library --> AIDDefense
    Library --> AutoAlign
    Library --> Clavata
    Library --> Cleanlab
    Library --> Presidio

    GuardrailsServer -->|"OpenAI SDK<br/>HTTPS/443"| OpenAI["OpenAI API"]
    GuardrailsServer -->|"Azure SDK<br/>HTTPS/443"| AzureOpenAI["Azure OpenAI"]
    ActiveFence -->|"HTTPS<br/>API Key"| ActiveFenceAPI["ActiveFence API"]
    AIDDefense -->|"httpx<br/>API Key"| CiscoAPI["Cisco AI Defense API"]
    AutoAlign -->|"aiohttp<br/>API Key"| AutoAlignAPI["AutoAlign API"]
    Clavata -->|"aiohttp<br/>API Key + Retry"| ClavataAPI["Clavata API"]

