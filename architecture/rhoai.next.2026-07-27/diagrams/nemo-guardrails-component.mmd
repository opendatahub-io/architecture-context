            AlignScoreServer["AlignScore Server<br/>(FastAPI)"]
            AlignScoreBase["/alignscore_base"]
            AlignScoreLarge["/alignscore_large"]
        end

        subgraph "Guardrails Library"
            Library["Pluggable Action Framework"]
            ActiveFence["ActiveFence Module"]
