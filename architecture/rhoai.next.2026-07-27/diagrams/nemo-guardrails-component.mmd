graph TB
    subgraph "NeMo Guardrails Platform"
        subgraph "Main Server"
            GuardrailsServer["NeMo Guardrails Server<br/>(FastAPI)"]
            ChatEndpoint["/v1/chat/completions"]
            CompletionsEndpoint["/v1/completions"]
            ChecksEndpoint["/v1/checks<br/>/v1/guardrail/checks"]
            ModelsEndpoint["/v1/models"]
            ConfigsEndpoint["/v1/rails/configs"]
            ChallengesEndpoint["/v1/challenges"]
            HealthEndpoint["/v1/health<br/>/health<br/>/healthz"]
        end

        subgraph "Actions Server"
            ActionsServer["Actions Server<br/>(FastAPI)"]
            ActionsRun["/v1/actions/run"]
            ActionsList["/v1/actions/list"]
        end

        subgraph "Jailbreak Detection Server"
            JailbreakServer["Jailbreak Detection<br/>(FastAPI)"]
            JailbreakHeuristic["/jailbreak_lp_heuristic<br/>/jailbreak_ps_heuristic"]
