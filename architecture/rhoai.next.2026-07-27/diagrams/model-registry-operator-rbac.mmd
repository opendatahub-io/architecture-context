graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator-<br/>controller-manager"]
        SA_Catalog["model-catalog"]
        SA_Registry["{registry-name}"]
        SA_Controller["controller-manager<br/>(legacy)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator-<br/>manager-rolebinding"]
        CRB_Proxy["model-registry-operator-<br/>proxy-rolebinding"]
        CRB_CatAuth["model-catalog-<br/>auth-delegator"]
        CRB_RegAuth["{registry-name}-<br/>auth-delegator"]
        CRB_LegacyProxy["proxy-rolebinding"]
        CRB_LegacyMgr["manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-<br/>manager-role<br/><i>61+ RBAC rules</i>"]
        CR_Proxy["model-registry-operator-<br/>proxy-role"]
        CR_AuthDelegator["system:auth-delegator"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
        CR_LegacyProxy["proxy-role"]
        CR_LegacyMgr["manager-role"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB_LeaderElection["model-registry-operator-<br/>leader-election-rolebinding"]
        RB_CatAdmin["model-catalog-admin-binding"]
        RB_CatAuth["model-catalog-authenticated"]
        RB_RegUsers["{registry-name}-users"]
        RB_LegacyLE["leader-election-rolebinding"]
    end

    subgraph Roles["Namespace Roles"]
        R_LeaderElection["model-registry-operator-<br/>leader-election-role"]
        R_CatAdmin["model-catalog-admin"]
        R_Catalog["model-catalog"]
        R_RegUser["registry-user-{registry-name}"]
        R_LegacyLE["leader-election-role"]
    end

    subgraph KeyResources["Key API Resources"]
        Res_MR["modelregistry.opendatahub.io<br/>ModelRegistry<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_Deploy["apps/Deployments<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_Secrets["core/Secrets<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_Routes["route.openshift.io/Routes<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_HTTPRoute["gateway.networking.k8s.io<br/>HTTPRoutes<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_NP["networking.k8s.io<br/>NetworkPolicies<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_Groups["user.openshift.io/Groups<br/><i>create,delete,get,list,<br/>update,watch</i>"]
        Res_TokenReview["authentication.k8s.io<br/>TokenReviews<br/><i>create</i>"]
        Res_SAR["authorization.k8s.io<br/>SubjectAccessReviews<br/><i>create</i>"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    SA_Operator -->|bound via| CRB_Proxy
    SA_Operator -->|bound via| RB_LeaderElection

    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    RB_LeaderElection -->|grants| R_LeaderElection

    %% Legacy SA bindings
    SA_Controller -->|bound via| CRB_LegacyProxy
    SA_Controller -->|bound via| CRB_LegacyMgr
    SA_Controller -->|bound via| RB_LegacyLE

    CRB_LegacyProxy -->|grants| CR_LegacyProxy
    CRB_LegacyMgr -->|grants| CR_LegacyMgr
    RB_LegacyLE -->|grants| R_LegacyLE

    %% Catalog SA bindings
    SA_Catalog -->|bound via| CRB_CatAuth
    CRB_CatAuth -->|grants| CR_AuthDelegator

    %% Registry SA bindings
    SA_Registry -->|bound via| CRB_RegAuth
    CRB_RegAuth -->|grants| CR_AuthDelegator

    %% Catalog namespace roles
    RB_CatAdmin -->|grants| R_CatAdmin
    RB_CatAuth -->|grants| R_Catalog

    %% Registry namespace roles
    RB_RegUsers -->|grants| R_RegUser

    %% Manager role → resources
    CR_Manager -->|manages| Res_MR
    CR_Manager -->|manages| Res_Deploy
    CR_Manager -->|manages| Res_Secrets
    CR_Manager -->|manages| Res_Routes
    CR_Manager -->|manages| Res_HTTPRoute
    CR_Manager -->|manages| Res_NP
    CR_Manager -->|manages| Res_Groups

    %% Proxy roles → auth resources
    CR_Proxy -->|delegates| Res_TokenReview
    CR_Proxy -->|delegates| Res_SAR

    %% User-facing roles → ModelRegistry
    CR_Admin -->|"full access (*)"| Res_MR
    CR_Editor -->|"CRUD access"| Res_MR
    CR_Viewer -->|"read-only<br/>(get,list,watch)"| Res_MR

    %% Namespace roles → resources
    R_CatAdmin -->|"configmaps, secrets<br/>(get,list,patch,update,watch)"| Res_Secrets
    R_RegUser -->|"endpoints, services<br/>(get)"| Res_Deploy

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Catalog fill:#4a90e2,stroke:#333,color:#fff
    style SA_Registry fill:#4a90e2,stroke:#333,color:#fff
    style SA_Controller fill:#8faecf,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_Proxy fill:#f5a623,stroke:#333,color:#fff
    style CR_AuthDelegator fill:#f5a623,stroke:#333,color:#fff
    style CR_Admin fill:#e8743b,stroke:#333,color:#fff
    style CR_Editor fill:#e8743b,stroke:#333,color:#fff
    style CR_Viewer fill:#e8743b,stroke:#333,color:#fff
    style CR_LegacyProxy fill:#c4a882,stroke:#333,color:#fff
    style CR_LegacyMgr fill:#c4a882,stroke:#333,color:#fff
    style Res_MR fill:#7ed321,stroke:#333
    style Res_Deploy fill:#7ed321,stroke:#333
    style Res_Secrets fill:#7ed321,stroke:#333
    style Res_Routes fill:#7ed321,stroke:#333
    style Res_HTTPRoute fill:#7ed321,stroke:#333
    style Res_NP fill:#7ed321,stroke:#333
    style Res_Groups fill:#7ed321,stroke:#333
    style Res_TokenReview fill:#d4380d,stroke:#333,color:#fff
    style Res_SAR fill:#d4380d,stroke:#333,color:#fff
