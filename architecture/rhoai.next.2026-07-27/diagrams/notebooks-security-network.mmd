graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist<br/>(Browser)"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS Termination<br/>Managed by Notebook Controller"]
    end

    subgraph NotebookPod["NOTEBOOK POD (multi-container)"]
        direction TB

        subgraph AuthContainer["Auth Sidecar"]
            OAuthProxy["OAuth Proxy<br/>8443/TCP TLS<br/>OpenShift OAuth Validation"]
        end

        subgraph AppContainer["Notebook Container"]
            Jupyter["JupyterLab Server<br/>8888/TCP HTTP<br/>No auth middleware<br/>UBI9 + Python 3.12"]
        end
    end

    subgraph ControlPlane["CONTROL PLANE"]
        NotebookController["RHOAI Notebook Controller<br/>Creates Pod + Route + OAuth Proxy"]
        Dashboard["RHOAI Dashboard<br/>Notebook lifecycle UI"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Internal)"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>ServiceAccount Token"]
        KFP["Kubeflow Pipelines<br/>HTTPS/gRPC<br/>ServiceAccount Token"]
        MLflow["MLflow Tracking<br/>HTTPS<br/>User Credentials"]
        Ray["Ray / CodeFlare<br/>HTTPS/gRPC<br/>ServiceAccount Token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>User-Provided Credentials"]
    end

    %% Inbound flow
    User -->|"HTTPS/443<br/>TLS<br/>OAuth redirect"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth token"| OAuthProxy
    OAuthProxy -->|"HTTP/8888<br/>plaintext (pod-local)<br/>pre-authenticated"| Jupyter

    %% Control plane
    Dashboard -->|"creates Notebook CR"| NotebookController
    NotebookController -->|"manages"| NotebookPod

    %% Outbound from notebook (SDK calls)
    Jupyter -->|"HTTPS/6443<br/>TLS<br/>SA token"| K8sAPI
    Jupyter -->|"HTTPS/gRPC<br/>TLS<br/>SA token"| KFP
    Jupyter -->|"HTTPS<br/>TLS<br/>user creds"| MLflow
    Jupyter -->|"HTTPS/gRPC<br/>TLS<br/>SA token"| Ray
    Jupyter -->|"HTTPS/443<br/>TLS<br/>user creds (boto3)"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy auth
    class Jupyter app
    class NotebookController,Dashboard controlplane
    class K8sAPI,KFP,MLflow,Ray platform
    class S3 externalservice
