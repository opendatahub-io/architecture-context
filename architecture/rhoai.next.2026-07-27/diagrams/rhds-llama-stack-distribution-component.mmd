graph TB
    subgraph "rhds-llama-stack-distribution"
        direction TB
        Server["Llama Stack Server<br/>llama stack run<br/>Port 8321/TCP"]
        Config["config.yaml<br/>Environment Variable<br/>Interpolation"]
        Entrypoint["entrypoint.sh<br/>Container Bootstrap"]

        subgraph "API Surfaces"
            direction LR
            Inference["Inference API"]
            Agents["Agents API"]
            Safety["Safety API"]
            Eval["Eval API"]
            VectorIO["Vector IO API"]
            Files["Files API"]
            Scoring["Scoring API"]
            Batches["Batches API"]
            DatasetIO["DatasetIO API"]
            ToolRuntime["Tool Runtime API"]
        end

        subgraph "Storage Backends"
            direction LR
            KVPostgres["kv_postgres<br/>Key-Value State"]
            SQLPostgres["sql_postgres<br/>Structured Records"]
        end

        subgraph "Provider Framework"
            direction LR
            InlineProviders["Inline Providers<br/>In-Process"]
            RemoteProviders["Remote Providers<br/>HTTP/gRPC Clients"]
        end

        Entrypoint -->|starts| Server
        Config -->|configures| Server
        Server --> Inference
        Server --> Agents
        Server --> Safety
        Server --> Eval
        Server --> VectorIO
        Server --> Files
        Server --> Scoring
        Server --> Batches
        Server --> DatasetIO
        Server --> ToolRuntime
        Server --> KVPostgres
        Server --> SQLPostgres
        Inference --> InlineProviders
        Inference --> RemoteProviders
        Safety --> InlineProviders
        Safety --> RemoteProviders
        VectorIO --> InlineProviders
        VectorIO --> RemoteProviders
        Eval --> RemoteProviders
    end

    Client[Client] -->|HTTP :8321| Server

    subgraph "Inference Providers"
        vLLM["vLLM"]
        Bedrock["AWS Bedrock"]
        WatsonX["IBM WatsonX"]
        AzureOAI["Azure OpenAI"]
        VertexAI["Google Vertex AI"]
        OpenAI["OpenAI"]
        SentenceTransformers["sentence-transformers<br/>Inline"]
    end

    subgraph "Vector Stores"
        Milvus["Milvus<br/>Default"]
        PgVector["PgVector"]
        Qdrant["Qdrant"]
        FAISS["FAISS<br/>Inline"]
    end

    subgraph "Safety & Evaluation"
        TrustyAI["TrustyAI FMS<br/>Safety Guardrails"]
        LMEval["TrustyAI LMEval"]
        RAGAS["RAGAS Evaluation"]
        Garak["Garak Security<br/>Benchmarking"]
    end

    PostgreSQL["PostgreSQL<br/>Persistent State"]
    OTELCollector["OTLP Collector<br/>Optional"]

    RemoteProviders -->|HTTP/gRPC| vLLM
    RemoteProviders -->|HTTPS| Bedrock
    RemoteProviders -->|HTTPS| WatsonX
    RemoteProviders -->|HTTPS| AzureOAI
    RemoteProviders -->|HTTPS| VertexAI
    RemoteProviders -->|HTTPS| OpenAI
    InlineProviders -->|in-process| SentenceTransformers

    InlineProviders -->|in-process| FAISS
    RemoteProviders -->|TCP| Milvus
    RemoteProviders -->|TCP| PgVector
    RemoteProviders -->|TCP| Qdrant

    RemoteProviders -->|HTTP| TrustyAI
    RemoteProviders -->|HTTP| LMEval
    RemoteProviders -->|HTTP| RAGAS
    RemoteProviders -->|HTTP| Garak

    KVPostgres -->|TCP 5432| PostgreSQL
    SQLPostgres -->|TCP 5432| PostgreSQL
    Server -.->|OTLP| OTELCollector

