graph TD
    subgraph Notice["RBAC Evidence Boundary"]
        direction TB
        Note["Note: RBAC roles and role bindings<br/>were NOT extracted by the analyzer.<br/>Runtime RBAC requirements exist but<br/>are not documented in source manifests."]
    end

    subgraph ServiceAccounts["Service Accounts (Inferred)"]
        SA["llm-d-inference-scheduler<br/>ServiceAccount<br/>(not extracted - inferred)"]
    end

    subgraph RequiredPermissions["Required Permissions (Inferred from Controller Watches)"]
        direction TB
        IMRCR["llm-d.ai<br/>InferenceModelRewrite<br/>get, list, watch"]
        IOCR["llm-d.ai<br/>InferenceObjective<br/>get, list, watch"]
        IPCR["inference.networking.k8s.io<br/>InferencePool<br/>get, list, watch"]
        PodCR["core (/v1)<br/>Pods<br/>get, list, watch"]
        EPCCR["llm-d.ai<br/>EndpointPickerConfig<br/>get, list, watch<br/>(configuration CRD)"]
    end

    subgraph Authentication["Authentication Mechanisms"]
        direction TB
        KubeAuth["Kubernetes API<br/>kubeconfig credential chain<br/>ServiceAccount token"]
        GRPCAuth["gRPC Services<br/>No application auth<br/>Optional transport TLS"]
        MetricsAuth["/metrics HTTP<br/>Optional Kubernetes<br/>token review"]
    end

    SA -->|"needs (inferred)"| IMRCR
    SA -->|"needs (inferred)"| IOCR
    SA -->|"needs (inferred)"| IPCR
    SA -->|"needs (inferred)"| PodCR
    SA -->|"needs (inferred)"| EPCCR
    SA -->|"authenticates via"| KubeAuth

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style IMRCR fill:#7ed321,stroke:#333,color:#fff
    style IOCR fill:#7ed321,stroke:#333,color:#fff
    style IPCR fill:#7ed321,stroke:#333,color:#fff
    style PodCR fill:#7ed321,stroke:#333,color:#fff
    style EPCCR fill:#7ed321,stroke:#333,color:#fff
    style KubeAuth fill:#f5a623,stroke:#333,color:#fff
    style GRPCAuth fill:#e8e8e8,stroke:#333
    style MetricsAuth fill:#e8e8e8,stroke:#333
