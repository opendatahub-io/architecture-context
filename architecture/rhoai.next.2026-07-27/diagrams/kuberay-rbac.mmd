graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["kuberay-operator<br/>SA"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["kuberay-operator<br/>(ClusterRoleBinding)"]
        CRB_ConfigMap["kuberay-operator-configmap<br/>(RoleBinding → redhat-ods-applications)"]
        CRB_GatewayAPI["kuberay-operator-gateway-api<br/>(RoleBinding → redhat-ods-applications)"]
        CRB_LeaderElection["kuberay-operator-leader-election<br/>(RoleBinding → default)"]
    end

    subgraph PrimaryRole["ClusterRole: kuberay-operator"]
        direction TB
        CoreResources["Core API<br/>pods, services, secrets,<br/>configmaps, serviceaccounts,<br/>events, pods/proxy, pods/resize,<br/>services/proxy, services/status"]
        AppsResources["apps<br/>deployments"]
        BatchResources["batch<br/>jobs"]
        RayResources["ray.io<br/>rayclusters, rayjobs,<br/>rayservices, raycronjobs<br/>+ /finalizers, /status"]
        CertMgrResources["cert-manager.io<br/>certificates, issuers<br/>+ /status"]
        GatewayResources["gateway.networking.k8s.io<br/>gateways, httproutes,<br/>referencegrants"]
        NetworkResources["networking.k8s.io<br/>ingresses, networkpolicies,<br/>ingressclasses"]
        RBACResources["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings"]
        RouteResources["route.openshift.io<br/>routes"]
        AuthResources["authentication.k8s.io<br/>tokenreviews<br/>authorization.k8s.io<br/>subjectaccessreviews"]
        ConfigResources["config.openshift.io<br/>apiservers, authentications,<br/>oauths<br/>operator.openshift.io<br/>kubeapiservers"]
        DiscoveryResources["discovery.k8s.io<br/>endpointslices"]
        LeaseResources["coordination.k8s.io<br/>leases"]
    end

    subgraph ScopedRoles["Scoped ClusterRoles"]
        ConfigMapRole["kuberay-operator-configmap<br/>configmaps: full CRUD"]
        GatewayAPIRole["kuberay-operator-gateway-api<br/>gateways: read<br/>httproutes, referencegrants: full CRUD"]
        LeaderElectionRole["kuberay-operator-leader-election<br/>configmaps: full CRUD<br/>events: create<br/>leases: create, get, list, update"]
    end

    subgraph UserFacingRoles["User-Facing ClusterRoles"]
        EditRole["kuberay-edit-role<br/>ray.io: rayclusters, rayjobs,<br/>rayservices (full CRUD)"]
        ViewRole["kuberay-view-role<br/>ray.io: rayclusters, rayjobs,<br/>rayservices (read-only)"]
        CronJobEditor["raycronjob-editor-role<br/>ray.io: raycronjobs (full CRUD)"]
        CronJobViewer["raycronjob-viewer-role<br/>ray.io: raycronjobs (read-only)"]
        JobEditor["rayjob-editor-role<br/>ray.io: rayjobs (full CRUD)"]
        JobViewer["rayjob-viewer-role<br/>ray.io: rayjobs (read-only)"]
        ServiceEditor["rayservice-editor-role<br/>ray.io: rayservices (full CRUD)"]
        ServiceViewer["rayservice-viewer-role<br/>ray.io: rayservices (read-only)"]
    end

    subgraph AdmissionWebhooks["Admission Webhooks (failurePolicy: Fail)"]
        MutateCluster["mraycluster.kb.io<br/>Mutating<br/>rayclusters: CREATE, UPDATE"]
        ValidateCluster["vraycluster.kb.io<br/>Validating<br/>rayclusters: CREATE, UPDATE"]
        ValidateJob["vrayjob.kb.io<br/>Validating<br/>rayjobs: CREATE, UPDATE"]
        ValidateService["vrayservice.kb.io<br/>Validating<br/>rayservices: CREATE, UPDATE"]
    end

    %% Bindings
    SA -->|"bound via"| CRB_Main
    SA -->|"bound via"| CRB_ConfigMap
    SA -->|"bound via"| CRB_GatewayAPI
    SA -->|"bound via"| CRB_LeaderElection

    CRB_Main -->|"grants"| PrimaryRole
    CRB_ConfigMap -->|"grants"| ConfigMapRole
    CRB_GatewayAPI -->|"grants"| GatewayAPIRole
    CRB_LeaderElection -->|"grants"| LeaderElectionRole

