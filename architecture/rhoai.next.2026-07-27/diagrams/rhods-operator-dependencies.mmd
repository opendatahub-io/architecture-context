graph LR
    RhodsOp["rhods-operator<br/>Platform Operator"]

    %% External Infrastructure Dependencies
    RhodsOp -->|"resource mgmt<br/>6443/HTTPS"| K8sAPI["Kubernetes API<br/>v0.36.0"]
    RhodsOp -->|"traffic routing"| GatewayAPI["Gateway API<br/>v1.3.0"]
    RhodsOp -->|"monitoring mgmt"| PromOp["prometheus-operator<br/>v0.74.0"]
