graph TB
    subgraph ODH["odh-model-controller"]
        direction TB

        subgraph Controllers["Reconciliation Controllers"]
            AccountCtrl["Account Controller<br/><i>nim.opendatahub.io/v1 Account</i>"]
            ConfigMapCtrl["ConfigMap Controller<br/><i>v1/ConfigMap</i>"]
            GatewayCtrl["Gateway Controller<br/><i>Gateway API resources</i>"]
            InferenceGraphCtrl["InferenceGraph Controller<br/><i>serving.kserve.io/v1alpha1</i>"]
            InferenceServiceCtrl["InferenceService Controller<br/><i>serving.kserve.io/v1beta1</i>"]
            LLMISvcCtrl["LLMInferenceService Controller<br/><i>serving.kserve.io/v1alpha2</i>"]
            PodCtrl["Pod Controller<br/><i>v1/Pod</i>"]
            SecretCtrl["Secret Controller<br/><i>v1/Secret</i>"]
            ServingRuntimeCtrl["ServingRuntime Controller<br/><i>serving.kserve.io/v1alpha1</i>"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MutPod["Mutating: Pod<br/>/mutate--v1-pod"]
            MutIG["Mutating: InferenceGraph<br/>v1alpha1"]
            MutLLMv1["Mutating: LLMInferenceService<br/>v1alpha1"]
            MutLLMv2["Mutating: LLMInferenceService<br/>v1alpha2"]
            MutISvc["Mutating: InferenceService<br/>v1beta1"]
            ValAccount["Validating: Account<br/>nim.opendatahub.io/v1"]
            ValIG["Validating: InferenceGraph<br/>v1alpha1"]
            ValISvc["Validating: InferenceService<br/>v1beta1"]
        end

        subgraph Deployments["Deployments"]
            ManagerDeploy["odh-model-controller<br/><i>manager</i><br/>Webhook: 9443/TLS<br/>Metrics: 8080"]
            APIDeploy["model-serving-api<br/><i>server</i><br/>API: 8443/TLS<br/>Metrics: 8080"]
        end

        subgraph Background["Background Runners"]
            MaaSCleanup["MaaSRBACCleanupRunner"]
            NIMCleanup["NIMCleanupRunner"]
        end
    end

    %% CRDs watched/created
    AccountCR["Account CR<br/><i>nim.opendatahub.io/v1</i>"]
    ISvcCR["InferenceService CR<br/><i>serving.kserve.io/v1beta1</i>"]
    IGCr["InferenceGraph CR<br/><i>serving.kserve.io/v1alpha1</i>"]
    LLMISvcCR["LLMInferenceService CR<br/><i>serving.kserve.io/v1alpha2</i>"]
    SRCr["ServingRuntime CR<br/><i>serving.kserve.io/v1alpha1</i>"]

    %% External dependencies
    K8sAPI["Kubernetes API Server<br/>6443/HTTPS"]
    GatewayAPI["Gateway API<br/><i>HTTPRoutes, Gateways</i>"]
    Kuadrant["Kuadrant<br/><i>AuthPolicies</i>"]
    Prometheus["Prometheus Operator<br/><i>ServiceMonitors, PodMonitors</i>"]
    Istio["Istio<br/><i>EnvoyFilters</i>"]
    KEDA["KEDA<br/><i>TriggerAuthentications</i>"]
    OTel["OpenTelemetry Collector<br/><i>OTLP/gRPC traces</i>"]

    %% Platform CRDs
    DSC["DataScienceCluster CR"]
    DSCI["DSCInitialization CR"]

    %% Connections
    AccountCR -->|watched by| AccountCtrl
    ISvcCR -->|watched by| InferenceServiceCtrl
    IGCr -->|watched by| InferenceGraphCtrl
    LLMISvcCR -->|watched by| LLMISvcCtrl
    SRCr -->|watched by| ServingRuntimeCtrl

    AccountCR -->|validated by| ValAccount
    ISvcCR -->|mutated by| MutISvc
    ISvcCR -->|validated by| ValISvc
    IGCr -->|mutated by| MutIG
    IGCr -->|validated by| ValIG
    LLMISvcCR -->|mutated by| MutLLMv1
    LLMISvcCR -->|mutated by| MutLLMv2

    ManagerDeploy --- Controllers
    ManagerDeploy --- Webhooks
    ManagerDeploy --- Background

    Controllers -->|CRUD| K8sAPI
    GatewayCtrl -->|manages| GatewayAPI
    GatewayCtrl -->|manages| Kuadrant
    InferenceServiceCtrl -->|manages| Prometheus
    GatewayCtrl -->|manages| Istio
    InferenceServiceCtrl -->|manages| KEDA
    ManagerDeploy -->|exports traces| OTel

    DSC -->|watched by| Controllers
    DSCI -->|watched by| Controllers

    APIDeploy -->|Gateway discovery| GatewayAPI

    %% Styling
    style ManagerDeploy fill:#4a90e2,stroke:#333,color:#fff
    style APIDeploy fill:#4a90e2,stroke:#333,color:#fff
    style AccountCR fill:#f5a623,stroke:#333
    style ISvcCR fill:#f5a623,stroke:#333
    style IGCr fill:#f5a623,stroke:#333
    style LLMISvcCR fill:#f5a623,stroke:#333
    style SRCr fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#7ed321,stroke:#333
    style Kuadrant fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style Istio fill:#7ed321,stroke:#333
    style KEDA fill:#7ed321,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style DSC fill:#f5a623,stroke:#333
    style DSCI fill:#f5a623,stroke:#333
