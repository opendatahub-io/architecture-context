graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client[External Client]
    end

    subgraph Ingress["INGRESS (Gateway)"]
        Gateway["Istio kubeflow-gateway<br/>443/TCP<br/>TLS SIMPLE<br/>gateway-tls-secret"]
    end

    subgraph Application["APPLICATION (Workbenches Operator)"]
        direction TB

        subgraph BackendContainer["Backend Container (distroless/nonroot)"]
            Backend["Backend REST API<br/>4000/TCP HTTP<br/>SubjectAccessReview AuthZ<br/>requireAuth middleware"]
        end

        subgraph ManagerContainer["Manager Container"]
            WebhookServer["Webhook Server<br/>9443/TCP HTTPS/TLS<br/>K8s Admission Auth"]
            HealthProbe["Health/Ready Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
            WorkspaceCtrl["Workspace Controller"]
            WorkspaceKindCtrl["WorkspaceKind Controller"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph PlatformDeps["INTERNAL PLATFORM DEPENDENCIES"]
        Istio["Istio Service Mesh<br/>VirtualService routing"]
        CertManager["cert-manager<br/>Webhook TLS certificates"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS SIMPLE<br/>Bearer Token (optional)"| Gateway

    %% Ingress to Application
    Gateway -->|"HTTP/4000<br/>Plaintext (mesh internal)<br/>SubjectAccessReview"| Backend
    Gateway -->|"HTTPS/9443<br/>TLS<br/>K8s Admission"| WebhookServer

    %% Application to Control Plane
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    WorkspaceCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    WorkspaceKindCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    WebhookServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Platform dependencies
    WorkspaceCtrl -->|"VirtualService CRs"| Istio
    CertManager -->|"TLS certs"| WebhookServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway ingress
    class Backend,WebhookServer,HealthProbe,WorkspaceCtrl,WorkspaceKindCtrl application
    class K8sAPI controlplane
    class Istio,CertManager platform
