graph TB
    subgraph ModelMeshPod["ModelMesh Pod (Sidecar Architecture)"]
        direction TB

        subgraph Adapters["Runtime Adapters"]
            TritonAdapter["model-mesh-triton-adapter<br/>mmesh.ModelRuntime impl"]
            MLServerAdapter["model-mesh-mlserver-adapter<br/>mmesh.ModelRuntime impl"]
            TorchServeAdapter["model-mesh-torchserve-adapter<br/>mmesh.ModelRuntime impl"]
        end

        subgraph Puller["Model Artifact Retrieval"]
            ServingPuller["model-serving-puller<br/>mmesh.ModelRuntime impl"]
            Pullman["pullman storage library<br/>Multi-cloud downloader"]
        end

        ServingPuller -->|uses| Pullman
    end

    subgraph ModelMeshControl["ModelMesh Control Plane"]
        MMesh["mmesh.ModelMesh<br/>registerModel / unregisterModel<br/>ensureLoaded / getModelStatus<br/>setVModel / getVModelStatus / deleteVModel"]
    end

    subgraph Backends["Backend Inference Engines"]
        Triton["NVIDIA Triton<br/>inference.GRPCInferenceService<br/>ModelInfer, ModelReady,<br/>SharedMemory, Streaming"]
        MLServer["Seldon MLServer<br/>GRPCInferenceService<br/>KFServing V2 predict"]
        TorchServe["PyTorch TorchServe<br/>InferenceAPIsService<br/>ManagementAPIsService"]
    end

    subgraph ObjectStorage["Object Storage Backends"]
        Azure["Azure Blob Storage"]
        GCS["Google Cloud Storage"]
        IBM["IBM Cloud Object Storage<br/>(S3-compatible)"]
    end

    %% ModelMesh → Adapters (sidecar gRPC)
    MMesh -->|"loadModel / unloadModel<br/>runtimeStatus<br/>(pod-local gRPC)"| TritonAdapter
    MMesh -->|"loadModel / unloadModel<br/>runtimeStatus<br/>(pod-local gRPC)"| MLServerAdapter
    MMesh -->|"loadModel / unloadModel<br/>runtimeStatus<br/>(pod-local gRPC)"| TorchServeAdapter
    MMesh -->|"loadModel / unloadModel<br/>runtimeStatus<br/>(pod-local gRPC)"| ServingPuller

    %% Adapters → Backends
    TritonAdapter -->|"gRPC<br/>inference.GRPCInferenceService"| Triton
    MLServerAdapter -->|"gRPC<br/>GRPCInferenceService"| MLServer
    TorchServeAdapter -->|"gRPC<br/>ManagementAPIsService"| TorchServe

    %% Puller → Storage
    Pullman -->|"HTTP/HTTPS<br/>Azure SDK"| Azure
    Pullman -->|"HTTP/HTTPS<br/>GCS SDK"| GCS
    Pullman -->|"HTTP/HTTPS<br/>S3 SDK"| IBM

    %% Styling
    style TritonAdapter fill:#4a90e2,stroke:#333,color:#fff
    style MLServerAdapter fill:#4a90e2,stroke:#333,color:#fff
    style TorchServeAdapter fill:#4a90e2,stroke:#333,color:#fff
    style ServingPuller fill:#4a90e2,stroke:#333,color:#fff
    style Pullman fill:#50a0d2,stroke:#333,color:#fff
    style MMesh fill:#f5a623,stroke:#333,color:#fff
    style Triton fill:#7ed321,stroke:#333,color:#fff
    style MLServer fill:#7ed321,stroke:#333,color:#fff
    style TorchServe fill:#7ed321,stroke:#333,color:#fff
    style Azure fill:#e8e8e8,stroke:#333
    style GCS fill:#e8e8e8,stroke:#333
    style IBM fill:#e8e8e8,stroke:#333
