graph TD
    subgraph "Application-Level Authentication"
        AuthMech["Authentication Mechanism<br/>Bearer Token / API Key"]
    end

    subgraph "Enforcement Points"
        MainServer["NeMo Guardrails Server<br/>(Python API middleware)"]
        ActionsServer["Actions Server<br/>⚠ NO AUTH OBSERVED"]
    end

    subgraph "Protected Endpoints (Main Server)"
        ChatCompletions["POST /v1/chat/completions"]
        Completions["POST /v1/completions"]
        Models["GET /v1/models"]
        Health["GET /v1/health<br/>GET /health<br/>GET /healthz"]
    end

    subgraph "Auth Status Unknown Endpoints"
        Checks["POST /v1/checks"]
        GuardrailChecks["POST /v1/guardrail/checks"]
        Challenges["GET /v1/challenges"]
        RailsConfigs["GET /v1/rails/configs"]
    end

    subgraph "Unprotected Endpoints (Actions Server)"
        ActionsRun["POST /v1/actions/run<br/>⚠ No inbound auth"]
        ActionsList["GET /v1/actions/list<br/>⚠ No inbound auth"]
    end

    subgraph "Outbound Credentials (Environment Variables)"
        AzureKey["AZURE_OPENAI_API_KEY"]
        ActiveFenceKey["ACTIVEFENCE_API_KEY"]
        AIDefenseKey["AI_DEFENSE_API_KEY"]
        AutoAlignKey["AUTOALIGN_API_KEY"]
        ClavataKey["CLAVATA_API_KEY"]
        CleanlabKey["CLEANLAB_API_KEY"]
        CrowdStrike["CS_AIDR_TOKEN"]
        F5Key["F5_GUARDRAILS_API_KEY"]
        FiddlerKey["FIDDLER_API_KEY"]
        PangeaKey["PANGEA_API_TOKEN"]
        PatronusKey["PATRONUS_API_KEY"]
        PolicyAIKey["POLICYAI_API_KEY"]
        PolygrafKey["POLYGRAF_API_KEY"]
        PrivateAIKey["PAI_API_KEY"]
        HFToken["HF_TOKEN"]
    end

    AuthMech -->|"enforces"| MainServer
    MainServer -->|"protects"| ChatCompletions
    MainServer -->|"protects"| Completions
    MainServer -->|"protects"| Models
    MainServer -->|"protects"| Health
    MainServer -.->|"status unknown"| Checks
    MainServer -.->|"status unknown"| GuardrailChecks
    MainServer -.->|"status unknown"| Challenges
    MainServer -.->|"status unknown"| RailsConfigs

    ActionsServer -->|"exposes (no auth)"| ActionsRun
    ActionsServer -->|"exposes (no auth)"| ActionsList

