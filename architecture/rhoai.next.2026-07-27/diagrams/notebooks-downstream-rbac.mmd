graph TD
    subgraph BuildRepo["notebooks-downstream Repository"]
        Note["This repository defines<br/>NO ClusterRoles, RoleBindings,<br/>or ServiceAccounts.<br/><br/>It is a container image<br/>build project only."]
    end

    subgraph RuntimeRBAC["Runtime RBAC (managed by RHOAI Notebook Controller)"]
        direction TB

        subgraph SA["Per-User Service Accounts"]
            UserSA["ServiceAccount:<br/>{username}-notebook<br/>Namespace: {user-project}"]
        end

        subgraph ControllerRBAC["Notebook Controller RBAC"]
            ControllerSA["ServiceAccount:<br/>notebook-controller-service-account<br/>Namespace: redhat-ods-applications"]
            ControllerCR["ClusterRole:<br/>notebook-controller-role"]
            ControllerCRB["ClusterRoleBinding:<br/>notebook-controller-rolebinding"]
        end

        subgraph OAuthRBAC["OAuth Proxy RBAC"]
            OAuthSA["ServiceAccount:<br/>(per-notebook)<br/>Namespace: {user-project}"]
            OAuthReview["SubjectAccessReview<br/>TokenReview<br/>for OAuth validation"]
        end

        subgraph Resources["Managed Resources"]
            StatefulSet["apps/StatefulSets"]
            Services["core/Services"]
            Routes["route.openshift.io/Routes"]
            Notebooks["kubeflow.org/Notebooks"]
        end
    end

    ControllerSA -->|bound via| ControllerCRB
    ControllerCRB -->|grants| ControllerCR
    ControllerCR -->|"create,update,delete"| StatefulSet
    ControllerCR -->|"create,update,delete"| Services
    ControllerCR -->|"create,update,delete"| Routes
    ControllerCR -->|"get,list,watch,update"| Notebooks

    OAuthSA -->|performs| OAuthReview

    UserSA -.->|"runs workbench pod"| StatefulSet

    style BuildRepo fill:#f5f5f5,stroke:#999,stroke-width:2px
    style Note fill:#fff3e0,stroke:#f5a623
    style RuntimeRBAC fill:#e8f5e9,stroke:#82b366,stroke-width:2px
    style ControllerSA fill:#4a90e2,color:#fff
    style ControllerCR fill:#f5a623
    style ControllerCRB fill:#f5a623
    style UserSA fill:#4a90e2,color:#fff
    style OAuthSA fill:#4a90e2,color:#fff
    style StatefulSet fill:#7ed321
    style Services fill:#7ed321
    style Routes fill:#7ed321
    style Notebooks fill:#7ed321
