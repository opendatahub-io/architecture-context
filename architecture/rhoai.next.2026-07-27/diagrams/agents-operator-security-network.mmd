graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer / x509"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (kagenti-operator-system)"]
        direction TB

        subgraph OperatorPod["kagenti-operator-controller-manager<br/>SA: kagenti-operator-controller-manager"]
            Manager["Manager Process"]
            WebhookSrv["Webhook Server<br/>9443/TCP TLS"]
            MetricsSrv["Metrics Server<br/>8443/TCP HTTPS<br/>TokenReview + SAR"]
            HealthSrv["Health Endpoints<br/>8081/TCP HTTP<br/>Unauthenticated"]
        end

        WebhookSvc["webhook-service<br/>ClusterIP 443→9443<br/>TLS (webhook-server-cert)"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443→8443<br/>HTTPS"]
    end

    subgraph AgentNS["AGENT NAMESPACE (user workload)"]
        direction TB

        subgraph AgentPodGroup["Agent Pod (sidecar injected)"]
            AgentContainer["Agent Container"]
            AuthBridge["AuthBridge Sidecar<br/>JWT + OPA + mTLS"]
        end

        subgraph AuthBridgePipeline["AuthBridge Plugin Chain"]
            direction LR
            JWTVal["JWT Validation<br/>(JWKS)"]
            OPA["OPA Policy<br/>(Rego)"]
            ProtoParse["Protocol Parser<br/>(A2A/MCP/Inference)"]
            TokenExch["Token Exchange<br/>(audience-scoped)"]
        end
    end

    subgraph PlatformSvcs["PLATFORM SERVICES (Internal)"]
        CertMgr["cert-manager<br/>Certificate + Issuer CRDs"]
        SPIRE["SPIRE Workload API<br/>X.509-SVID issuance"]
        TokenBroker["token-broker<br/>OAuth2 session tokens"]
        Keycloak["Keycloak<br/>Identity provider"]
        DSC["DataScienceCluster CR<br/>Feature gating"]
        MLflow["MLflow<br/>Experiment tracking"]
        Kuadrant["Kuadrant<br/>API gateway"]
        Tekton["Tekton<br/>Pipeline integration"]
    end

    subgraph OtherAgents["OTHER AGENT PODS"]
        RemoteAgent["Remote Agent<br/>mTLS (SPIFFE)"]
    end

    %% External → Control Plane
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| APIServer

    %% Control Plane → Webhooks
    APIServer -->|"HTTPS/443→9443<br/>TLS<br/>Admission"| WebhookSvc
    WebhookSvc --> WebhookSrv

    %% Operator → API Server
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| APIServer

    %% Metrics access
    MetricsSvc --> MetricsSrv

    %% Operator → Platform Services
    Manager -->|"CRD CRUD<br/>TLS"| CertMgr
    Manager -->|"CRD Watch<br/>TLS 1.2+"| DSC
    Manager -->|"CRD Watch"| MLflow
    Manager -->|"CRD Watch + CRUD"| Kuadrant
    Manager -->|"CRD Watch + patch"| Tekton
    Manager -->|"CRD CRUD"| Keycloak

    %% AuthBridge → SPIRE
    AuthBridge -->|"SPIFFE Workload API<br/>X.509-SVID"| SPIRE

    %% AuthBridge → Token Broker
    AuthBridge -->|"HTTP POST<br/>/sessions/token"| TokenBroker

    %% Agent-to-Agent (mTLS)
    AuthBridge -->|"HTTPS<br/>SPIFFE mTLS<br/>X.509-SVID"| RemoteAgent

    %% Inbound flow through AuthBridge
    RemoteAgent -.->|"Inbound request<br/>mTLS"| AuthBridge
    AuthBridge --> AgentContainer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef agentns fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef otheragent fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class APIServer controlplane
    class Manager,WebhookSrv,MetricsSrv,HealthSrv,WebhookSvc,MetricsSvc operatorns
    class AgentContainer,AuthBridge,JWTVal,OPA,ProtoParse,TokenExch agentns
    class CertMgr,SPIRE,TokenBroker,Keycloak,DSC,MLflow,Kuadrant,Tekton platform
    class RemoteAgent otheragent
