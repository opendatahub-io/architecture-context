graph TD
    subgraph "fms-hf-tuning RBAC"
        direction TB
        Note["No ClusterRoles or ClusterRoleBindings<br/>defined by this component"]
    end

    subgraph "Runtime Credentials (Environment Variables)"
        S3AccessKey["S3_ACCESS_KEY_ID<br/>(env var)<br/>AWS IAM Access Key"]
        S3SecretKey["S3_SECRET_ACCESS_KEY<br/>(env var)<br/>AWS IAM Secret Key"]
        S3Endpoint["S3_ENDPOINT<br/>(env var)<br/>S3-Compatible Endpoint URL"]
    end

    subgraph "External Orchestration RBAC"
        direction TB
        OrchestratorSA["Orchestrator Service Account<br/>(e.g., pipeline-runner-sa)"]
        JobRole["Job Management Role<br/>batch/v1 Jobs: create, get, watch"]
        SecretRole["Secret Access Role<br/>core/v1 Secrets: get"]
    end

    subgraph "Credential Flow"
        K8sSecret["Kubernetes Secret<br/>(contains S3 credentials)"]
    end

    OrchestratorSA -->|"bound to"| JobRole
    OrchestratorSA -->|"bound to"| SecretRole
    SecretRole -->|"reads"| K8sSecret
    K8sSecret -->|"injected as env var"| S3AccessKey
    K8sSecret -->|"injected as env var"| S3SecretKey
    K8sSecret -->|"injected as env var"| S3Endpoint

    style Note fill:#f9f9f9,stroke:#999,stroke-dasharray: 5 5
    style S3AccessKey fill:#fff2cc,stroke:#d6b656
    style S3SecretKey fill:#fff2cc,stroke:#d6b656
    style S3Endpoint fill:#fff2cc,stroke:#d6b656
    style OrchestratorSA fill:#4a90e2,stroke:#333,color:#fff
    style JobRole fill:#f5a623,stroke:#333
    style SecretRole fill:#f5a623,stroke:#333
    style K8sSecret fill:#e6b8af,stroke:#cc4125
