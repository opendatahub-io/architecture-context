graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Admin"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        Route["OpenShift Route<br/>443/TCP HTTPS<br/>TLS Re-encrypt"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        direction TB

        subgraph OperatorPod["Controller Manager Pod"]
            Manager["manager binary<br/>SA: trustyai-service-operator-controller-manager<br/>TLS: Dynamic (OpenShift cluster profile)"]
            HealthMgr["Health: :8081<br/>/healthz, /readyz<br/>(unauthenticated)"]
        end

        subgraph WebhookPod["Webhook Server (conditional)"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS<br/>Cert: webhook-server-cert<br/>(OpenShift service-ca)"]
        end

        MetricsSvc["Metrics Service<br/>ClusterIP 8443/TCP<br/>(kube-rbac-proxy)"]
        PromSvc["Prometheus Metrics<br/>ClusterIP 8080/TCP"]
        WebhookSvc["Webhook Service<br/>ClusterIP 443→9443/TCP"]
    end

    subgraph UserNS["USER NAMESPACES (Controller-Created)"]
        direction TB

        subgraph TASPod["TrustyAI Service Pod"]
            TASRBAC["kube-rbac-proxy<br/>8443/TCP TLS<br/>TokenReview + SAR"]
            TASApp["trustyai-service<br/>8080/TCP HTTP"]
        end

        subgraph EHPod["EvalHub Pod"]
            EHRBAC["kube-rbac-proxy<br/>8443/TCP TLS<br/>TokenReview + SAR"]
            EHApp["EvalHub App"]
        end

        LMPod["LMEval Driver Pod<br/>(FIPS: strictfipsruntime)<br/>PVC storage"]

        GorchPod["GuardrailsOrchestrator Pod"]
        NemoPod["NemoGuardrails Pod"]

        UserSvc["{registry-name} Service<br/>ClusterIP 443→8443/TCP"]
    end

    subgraph Platform["PLATFORM DEPENDENCIES (Cluster Services)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        KServe["KServe<br/>InferenceService, ServingRuntime"]
        PromOp["prometheus-operator<br/>ServiceMonitor"]
        GatewayAPI["Gateway API<br/>Gateway, HTTPRoute"]
        Kueue["Kueue<br/>Workload scheduling"]
        MLflow["MLflow<br/>Experiment tracking"]
        ServiceCA["OpenShift service-ca<br/>Cert provisioning"]
    end

    %% External flows
    User -->|"HTTPS/443<br/>Bearer Token"| Route
    Route -->|"HTTPS/8443<br/>TLS"| TASRBAC
    Route -->|"HTTPS/8443<br/>TLS"| EHRBAC

    %% Auth proxy flows
    TASRBAC -->|"HTTP/8080<br/>pod-local"| TASApp
    EHRBAC -->|"HTTP<br/>pod-local"| EHApp
    TASRBAC -->|"TokenReview<br/>SAR"| K8sAPI
    EHRBAC -->|"TokenReview<br/>SAR"| K8sAPI

    %% Operator to K8s API
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Operator to platform deps
    Manager -->|"Watch CRDs"| KServe
    Manager -->|"Create ServiceMonitor"| PromOp
    Manager -->|"Read Gateway"| GatewayAPI
    Manager -->|"Watch Workloads"| Kueue
    Manager -->|"CRUD Experiments"| MLflow

    %% Webhook
    K8sAPI -->|"HTTPS/443→9443<br/>service-ca cert"| Webhook

    %% Service CA
    ServiceCA -->|"Provision cert"| Webhook

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef userns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authproxy fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Route ingress
    class Manager,HealthMgr,Webhook,MetricsSvc,PromSvc,WebhookSvc operator
    class TASApp,EHApp,LMPod,GorchPod,NemoPod,UserSvc userns
    class TASRBAC,EHRBAC authproxy
    class K8sAPI,KServe,PromOp,GatewayAPI,Kueue,MLflow,ServiceCA platform
