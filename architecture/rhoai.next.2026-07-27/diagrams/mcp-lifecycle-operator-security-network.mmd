graph TB
    subgraph InternalClients["INTERNAL CLIENTS (Cluster-Scoped)"]
        Prometheus["Prometheus<br/>Metrics Scraper"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(mcp-lifecycle-operator-system)"]
        direction TB

        subgraph ControllerPod["mcp-lifecycle-operator-controller-manager"]
            direction LR
            Reconciler["MCPServerReconciler"]
            HealthEndpoint[":8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth"]
            MetricsEndpoint[":8443/TCP HTTPS<br/>/metrics<br/>TokenReview + SAR<br/>Self-signed TLS"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP :8443/TCP"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>:6443/TCP<br/>TLS 1.2+"]
    end

    subgraph ManagedNS["MANAGED RESOURCES<br/>(user namespaces, per MCPServer CR)"]
        direction TB
        ManagedDeploy["Managed Deployment<br/>MCP Server Container<br/>ownerRef → MCPServer"]
        ManagedSvc["Managed Service<br/>MCP Server Port<br/>ownerRef → MCPServer"]
        ManagedNetPol["Managed NetworkPolicy<br/>ownerRef → MCPServer"]
    end

    subgraph WatchedResources["WATCHED RESOURCES"]
        MCPServerCR["MCPServer CR<br/>mcp.x-k8s.io/v1alpha1"]
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
    end

    %% Flows
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>TokenReview + SAR"| MetricsSvc
    MetricsSvc --> MetricsEndpoint

    Reconciler -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>RBAC: manager-role"| K8sAPI

    K8sAPI -->|"Watch events"| MCPServerCR
    K8sAPI -->|"Watch events"| ConfigMaps
    K8sAPI -->|"Watch events"| Secrets

    MCPServerCR -.->|"triggers reconcile"| Reconciler
    ConfigMaps -.->|"triggers re-reconcile"| Reconciler
    Secrets -.->|"triggers re-reconcile"| Reconciler

    Reconciler -->|"CREATE/UPDATE<br/>ownerRef"| ManagedDeploy
    Reconciler -->|"CREATE/UPDATE<br/>ownerRef"| ManagedSvc
    Reconciler -->|"CREATE/UPDATE<br/>ownerRef"| ManagedNetPol

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef managed fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef watched fill:#f5a623,stroke:#333,stroke-width:2px,color:#fff
    classDef internal fill:#f9f9f9,stroke:#999,stroke-width:2px

    class Reconciler,HealthEndpoint,MetricsEndpoint operator
    class K8sAPI controlplane
    class ManagedDeploy,ManagedSvc,ManagedNetPol managed
    class MCPServerCR,ConfigMaps,Secrets watched
    class Prometheus,MetricsSvc internal
