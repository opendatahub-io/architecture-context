graph TB
    subgraph External["EXTERNAL (Clients)"]
        Client["Inference Client"]
    end

    subgraph Platform["PLATFORM LAYER (not defined in this repo)"]
        direction TB
        ServingPlatform["KServe / ModelMesh<br/>TLS termination<br/>Authentication<br/>Authorization<br/>Service mesh"]
    end

    subgraph Container["CONTAINER: vllm-rocm<br/>Image: odh-vllm-rocm-rhel9<br/>User: 2000 (non-root)"]
        direction TB

        subgraph Adapter["vllm_tgis_adapter"]
            HTTPServer["HTTP Server<br/>Port 8000/TCP<br/>OpenAI-compatible API"]
            gRPCServer["gRPC Server<br/>Port 8033/TCP<br/>TGIS-compatible API"]
        end

        Engine["vLLM Engine<br/>PagedAttention<br/>ROCm GPU backend"]
    end

    subgraph Hardware["GPU HARDWARE"]
        GPU["AMD ROCm GPU<br/>LLM inference compute<br/>PagedAttention KV cache"]
    end

    subgraph Storage["MODEL STORAGE (configured at deploy time)"]
        ModelWeights["Model Weights<br/>Path configured by platform"]
    end

    %% Flows
    Client -->|"HTTP/8000 or gRPC/8033<br/>Encryption: platform-managed<br/>Auth: platform-managed"| ServingPlatform
    ServingPlatform -->|"Routes to container ports"| HTTPServer
    ServingPlatform -->|"Routes to container ports"| gRPCServer
    HTTPServer --> Engine
    gRPCServer --> Engine
    Engine -->|"PCIe / ROCm runtime"| GPU
    Engine -->|"Load at startup"| ModelWeights

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef hardware fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class ServingPlatform platform
    class HTTPServer,gRPCServer,Engine container
    class GPU hardware
    class ModelWeights storage
