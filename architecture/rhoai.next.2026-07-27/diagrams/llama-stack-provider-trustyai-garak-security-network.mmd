graph TB
    subgraph JobPod["EVAL-HUB K8S JOB POD (Execution Boundary)"]
        direction TB

        subgraph AdapterCore["GarakAdapter (library adapter, no inbound surfaces)"]
            Adapter["GarakAdapter<br/>v0.5.1<br/>Python >=3.12"]
            CredResolver["Credential Resolver<br/>6 Roles: TARGET, SDG, JUDGE,<br/>ATTACKER, EVALUATOR, TRANSLATION<br/>5-step priority chain"]
            Adapter -->|resolves credentials| CredResolver
        end

        subgraph ExecModes["Execution Modes"]
            Simple["Simple Mode<br/>(subprocess)"]
            KFP_Mode["KFP Mode<br/>(pipeline delegation)"]
        end

        ConfigMap["ConfigMap<br/>(Job Spec - mounted)"]
        Sidecar["eval-hub Sidecar Proxy<br/>localhost<br/>HTTP (pod-internal)<br/>Proxy-injected Auth"]

        ConfigMap -->|mounted volume| Adapter
        Adapter --> Simple
        Adapter --> KFP_Mode
        Adapter -->|callback results<br/>HTTP localhost| Sidecar
    end

    subgraph EgressTargets["EGRESS DESTINATIONS"]
        direction TB

        TargetModel["Target Model Endpoint<br/>Port: Runtime-configured<br/>HTTPS<br/>Auth: API Key (role-based)"]
        S3["S3-Compatible Storage<br/>Port: Runtime-configured<br/>HTTPS/TLS<br/>Auth: AWS IAM Credentials"]
        KFPService["Kubeflow Pipelines<br/>Auth: KFP_AUTH_TOKEN<br/>(SA token / sidecar proxy)"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/TLS<br/>Auth: SA Token (5-step chain)"]
        OCIReg["OCI Registry<br/>443/TCP<br/>HTTPS/TLS<br/>Auth: Registry Credentials"]
    end

    subgraph SecurityControls["SECURITY CONTROLS"]
        Redaction["API Key Redaction<br/>Keys → *** before S3/OCI"]
        NoInbound["No Inbound Surfaces<br/>Library adapter only"]
        SidecarProxy["Sidecar Proxy Model<br/>eval-hub ≥ 0.4.4<br/>Disables SA token auto-mount"]
    end

    %% Egress flows
    Simple -->|inference probes<br/>HTTPS<br/>API Key| TargetModel
    KFP_Mode -->|submit pipeline<br/>KFP_AUTH_TOKEN| KFPService
    Adapter -->|upload/download<br/>HTTPS/TLS<br/>AWS Credentials| S3
    Adapter -->|resource operations<br/>HTTPS/TLS<br/>SA Token| K8sAPI
    Adapter -->|persist artifacts<br/>HTTPS/TLS<br/>Registry Creds| OCIReg

    %% Sidecar to platform
    Sidecar -->|forward results| EvalHubPlatform["eval-hub Platform"]

    %% Styling
    classDef adapter fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    classDef execution fill:#f5a623,stroke:#d79b00,stroke-width:2px
    classDef egress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef config fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sidecar fill:#7ed321,stroke:#333,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#666,stroke-width:2px

    class Adapter,CredResolver adapter
    class Simple,KFP_Mode execution
    class TargetModel,S3,KFPService,K8sAPI,OCIReg egress
    class Redaction,NoInbound,SidecarProxy security
    class ConfigMap config
    class Sidecar sidecar
    class EvalHubPlatform platform
