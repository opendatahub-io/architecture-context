graph TB
    subgraph "vllm-cpu Inference Server"
        direction TB
        FastAPI["FastAPI/ASGI Server<br/>(vllm.entrypoints.openai.api_server)"]
        AuthMW["AuthenticationMiddleware<br/>Bearer Token (conditional)<br/>SHA-256 + constant-time compare"]

        subgraph "API Routers"
            direction LR
            OpenAI["OpenAI-Compatible API<br/>/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models"]
            Anthropic["Anthropic-Compatible API<br/>/v1/messages"]
            Pooling["Pooling & Scoring API<br/>/pooling, /score<br/>/v1/score, /rerank"]
            Audio["Speech-to-Text API<br/>/v1/audio/transcriptions<br/>/v1/audio/translations"]
            LoRA["LoRA Management<br/>/v1/load_lora_adapter<br/>/v1/unload_lora_adapter"]
            Realtime["Realtime API<br/>/v1/realtime (WebSocket)"]
        end

        subgraph "Operational Endpoints"
            direction LR
            Health["/health, /ready, /readyz<br/>(unauthenticated)"]
            Load["/load, /version<br/>(unauthenticated)"]
            Docs["/docs<br/>(unauthenticated)"]
            Profile["/start_profile<br/>/stop_profile"]
        end

        Engine["vLLM Engine<br/>LLM Inference Core"]
    end

    Client[External Client] -->|HTTP/HTTPS| FastAPI
    FastAPI -->|guards /v1, /v2, /inference| AuthMW
    AuthMW --> OpenAI
    AuthMW --> Anthropic
    AuthMW --> Pooling
    AuthMW --> Audio
    AuthMW --> LoRA
    AuthMW --> Realtime
    FastAPI -->|unguarded| Health
    FastAPI -->|unguarded| Load
    FastAPI -->|unguarded| Docs
    FastAPI --> Profile
    OpenAI --> Engine
    Anthropic --> Engine
    Pooling --> Engine
    Audio --> Engine

    Engine -->|boto3 / HTTPS 443| S3["S3-Compatible Storage<br/>Model Weights & Artifacts"]
    Engine -->|huggingface_hub / HTTPS 443| HFHub["HuggingFace Hub<br/>Model Downloads & LoRA"]

    K8s["Kubernetes<br/>Liveness/Readiness Probes"] -->|HTTP| Health

    subgraph "Container Targets"
        direction LR
        CPU["x86_64 CPU<br/>(UBI9)"]
        PPC["ppc64le<br/>(+TGIS adapter)"]
        S390["s390x<br/>(+TGIS adapter)"]
        ROCm["ROCm GPU"]
        HPU["Habana HPU"]
        TPU["Google TPU"]
        XPU["Intel XPU"]
    end

    style FastAPI fill:#4a90e2,stroke:#333,color:#fff
    style AuthMW fill:#e74c3c,stroke:#333,color:#fff
    style Engine fill:#4a90e2,stroke:#333,color:#fff
    style OpenAI fill:#7ed321,stroke:#333
    style Anthropic fill:#7ed321,stroke:#333
    style Pooling fill:#7ed321,stroke:#333
    style Audio fill:#7ed321,stroke:#333
    style LoRA fill:#7ed321,stroke:#333
    style Realtime fill:#7ed321,stroke:#333
    style Health fill:#f5a623,stroke:#333
    style Load fill:#f5a623,stroke:#333
    style Docs fill:#f5a623,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
