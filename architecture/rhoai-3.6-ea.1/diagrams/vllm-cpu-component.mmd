graph TB
    subgraph "vllm-cpu Serving Runtime"
        subgraph "HTTP Entrypoint"
            APIServer["FastAPI/ASGI Server<br/>vllm.entrypoints.openai.api_server"]
            AuthMW["AuthenticationMiddleware<br/>Bearer Token (opt-in)<br/>SHA-256 constant-time compare"]
            APIServer --> AuthMW
        end

        subgraph "API Routers"
            ChatRouter["/v1/chat/completions<br/>Chat Completions"]
            CompletionsRouter["/v1/completions<br/>Text Completions"]
            EmbeddingsRouter["/v1/embeddings<br/>Embeddings"]
            RerankRouter["/v1/rerank<br/>Reranking"]
            ScoreRouter["/v1/score<br/>Scoring"]
            AudioRouter["/v1/audio/*<br/>Transcription/Translation"]
            LoRARouter["/v1/load_lora_adapter<br/>LoRA Management"]
            MessagesRouter["/v1/messages<br/>Anthropic-style Messages"]
            ResponsesRouter["/v1/responses<br/>Responses API"]
            RealtimeRouter["/v1/realtime<br/>WebSocket"]
        end

        subgraph "gRPC Entrypoint"
            GRPCServer["gRPC Server<br/>vllm.entrypoints.grpc_server<br/>Port 50051"]
            VllmServicer["VllmEngineServicer<br/>smg-grpc-servicer"]
            HealthService["grpc.health.v1.Health<br/>Health Checking"]
            GRPCServer --> VllmServicer
            GRPCServer --> HealthService
        end

        subgraph "Engine Core"
            AsyncLLM["AsyncLLM Engine<br/>Model Inference"]
        end

        AuthMW -->|guarded paths<br/>/v1, /v2, /inference| ChatRouter
        AuthMW -->|guarded paths| CompletionsRouter
        AuthMW -->|guarded paths| EmbeddingsRouter
        AuthMW -->|guarded paths| RerankRouter
        AuthMW -->|guarded paths| ScoreRouter
        AuthMW -->|guarded paths| AudioRouter
        AuthMW -->|guarded paths| LoRARouter
        AuthMW -->|guarded paths| MessagesRouter
        AuthMW -->|guarded paths| ResponsesRouter
        AuthMW -->|guarded paths| RealtimeRouter

        ChatRouter --> AsyncLLM
        CompletionsRouter --> AsyncLLM
        EmbeddingsRouter --> AsyncLLM
        RerankRouter --> AsyncLLM
        ScoreRouter --> AsyncLLM
        AudioRouter --> AsyncLLM
        LoRARouter --> AsyncLLM
        MessagesRouter --> AsyncLLM
        ResponsesRouter --> AsyncLLM
        VllmServicer --> AsyncLLM
    end

    subgraph "Health Endpoints (Unauthenticated)"
        HealthHTTP["/health, /ready, /readyz<br/>/load, /ping, /docs"]
    end

    APIServer --> HealthHTTP

    Client["External Client<br/>(REST)"] -->|HTTP/HTTPS| APIServer
    GRPCClient["gRPC Client"] -->|gRPC/50051<br/>Insecure| GRPCServer

    AsyncLLM -->|Downloads models| HFHub["HuggingFace Hub<br/>443/HTTPS"]
    AsyncLLM -->|Loads from| LocalStorage["Local/Pre-cached<br/>Model Storage"]

    subgraph "Platform"
        KServe["KServe / ModelMesh<br/>Lifecycle, Scaling, Routing"]
    end

    KServe -->|deploys & manages| APIServer

    style APIServer fill:#4a90e2,stroke:#333
    style GRPCServer fill:#4a90e2,stroke:#333
    style AsyncLLM fill:#e8744f,stroke:#333
    style AuthMW fill:#f5a623,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style HFHub fill:#999,stroke:#333
    style Client fill:#f9f9f9,stroke:#333
    style GRPCClient fill:#f9f9f9,stroke:#333
    style HealthHTTP fill:#d5e8d4,stroke:#82b366
