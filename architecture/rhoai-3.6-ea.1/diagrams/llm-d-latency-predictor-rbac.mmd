graph TD
    subgraph "llm-d-latency-predictor RBAC"
        Note["No RBAC Resources Defined"]
    end

    subgraph "Authentication Status"
        AuthNote["No authentication middleware<br/>registered on either server"]
    end

    subgraph "Access Control Model"
        direction TB
        AppLayer["Application Layer<br/>Auth: None<br/>All endpoints unauthenticated"]
