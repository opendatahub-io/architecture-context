        AppLayer -->|"delegates to"| PlatformLayer
    end

    subgraph "Unauthenticated Endpoints"
        direction TB
        TrainEndpoints["Training Server :8000<br/>POST /add_training_data_bulk<br/>GET /data/status<br/>GET /metrics<br/>GET /model/{name}/info<br/>GET /model/{name}/download<br/>GET /models/list<br/>POST /flush<br/>GET /model/export<br/>GET /debug/*<br/>GET /healthz /readyz"]
        PredEndpoints["Prediction Server :8001<br/>POST /predict<br/>POST /predict/bulk<br/>POST /predict/bulk/strict<br/>GET /status<br/>POST /reload<br/>GET /healthz /readyz"]
    end

    subgraph "Security Observations"
        direction TB
        Warn1["No ClusterRoles or RoleBindings"]
        Warn2["No ServiceAccount with elevated privileges"]
        Warn3["No TLS at application level"]
        Warn4["Inter-service model sync: plain HTTP"]
    end

