graph TD
    subgraph "llm-d-latency-predictor RBAC"
        direction TB

        Note["No RBAC Configured"]

        subgraph AuthStatus["Authentication & Authorization Status"]
            NoAuth["No Auth Middleware<br/>All 24 HTTP endpoints are unauthenticated"]
            NoRBAC["No ClusterRoles defined"]
            NoBindings["No RoleBindings defined"]
            NoSA["No explicit ServiceAccounts"]
        end

        subgraph NetworkAccess["Network-Level Access Control (Expected)"]
            NetPol["Kubernetes NetworkPolicy<br/>(if deployed)"]
            SMesh["Service Mesh / Sidecar<br/>(not detected in manifests)"]
        end

        subgraph Endpoints["Unauthenticated Endpoints"]
            subgraph TrainEndpoints["Training Server :8000"]
                T1["POST /add_training_data_bulk"]
                T2["POST /flush"]
                T3["GET /data/status"]
                T4["GET /metrics"]
                T5["GET /model/export"]
                T6["GET /model/{name}/download"]
                T7["GET /models/list"]
                T8["GET /healthz, /readyz"]
            end

            subgraph PredEndpoints["Prediction Server :8001"]
                P1["POST /predict"]
                P2["POST /predict/bulk"]
                P3["POST /predict/bulk/strict"]
                P4["POST /reload"]
                P5["GET /status"]
                P6["GET /healthz, /readyz"]
            end
        end

        NoAuth -->|"access control<br/>delegated to"| NetworkAccess
        NetPol -.->|"restricts access to"| Endpoints
        SMesh -.->|"restricts access to"| Endpoints
    end

    %% Styling
    style Note fill:#ff6b6b,color:#fff,stroke:#c0392b,stroke-width:3px
    style NoAuth fill:#ff9999,stroke:#c0392b
    style NoRBAC fill:#ffd699,stroke:#d79b00
    style NoBindings fill:#ffd699,stroke:#d79b00
    style NoSA fill:#ffd699,stroke:#d79b00
    style NetPol fill:#d5e8d4,stroke:#82b366
    style SMesh fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
