graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["training-operator<br/>ServiceAccount"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB["training-operator<br/>ClusterRoleBinding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB["training-operator-webhook<br/>RoleBinding"]
    end

    subgraph ClusterRolePerms["ClusterRole: training-operator"]
        direction TB

        subgraph CoreAPI["Core API ('')"]
            Pods["pods<br/>create, delete, get,<br/>list, patch, update, watch"]
            PodsExec["pods/exec<br/>create"]
            Services["services<br/>create, delete, get,<br/>list, watch"]
            ConfigMaps["configmaps<br/>create, list,<br/>update, watch"]
            ServiceAccounts2["serviceaccounts<br/>create, get, list, watch"]
            Events["events<br/>create, delete, get,<br/>list, patch, update, watch"]
        end

        subgraph KubeflowAPI["kubeflow.org"]
            TrainingJobs["jaxjobs, mpijobs,<br/>paddlejobs, pytorchjobs,<br/>tfjobs, xgboostjobs<br/>create, delete, get, list,<br/>patch, update, watch"]
            TrainingJobsStatus["*/status<br/>get, patch, update"]
            TrainingJobsFinalizers["*/finalizers<br/>update"]
        end

        subgraph AutoscalingAPI["autoscaling"]
            HPA["horizontalpodautoscalers<br/>create, delete, get,<br/>list, patch, update, watch"]
        end

        subgraph AdmissionAPI["admissionregistration.k8s.io"]
            VWC["validatingwebhookconfigurations<br/>get, list, update, watch"]
        end

        subgraph RBACAPI["rbac.authorization.k8s.io"]
            RolesRes["roles, rolebindings<br/>create, list, update, watch"]
        end

        subgraph SchedulingAPIs["Scheduling APIs"]
            VolcanoPG["scheduling.volcano.sh<br/>podgroups<br/>create, delete, get,<br/>list, patch, update, watch"]
            K8sPG["scheduling.x-k8s.io<br/>podgroups<br/>create, delete, get,<br/>list, patch, update, watch"]
        end

        subgraph OpenShiftAPI["config.openshift.io"]
            APIServers["apiservers<br/>get"]
        end

        subgraph NetworkAPI["networking.k8s.io"]
            NetworkPolicies["networkpolicies<br/>create, delete, get,<br/>list, patch, update, watch"]
        end
    end

    subgraph WebhookRolePerms["Role: training-operator-webhook"]
        Secrets["secrets<br/>get, list, update, watch"]
    end

    %% Bindings
    SA -->|"bound via"| CRB
