graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (No TLS Termination)"]
        Route["OpenShift Route: trustyai<br/>TLS: null (no termination)<br/>Auth: Platform-delegated"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_Deploy["Namespace: {deployment-namespace}"]
            SVC["Service: trustyai-service<br/>ClusterIP 80/TCP → 8080/TCP"]
            TrustyAI["TrustyAI Explainability Service<br/>SA: trustyai-serviceaccount<br/>Ports: 8080/TCP (HTTP), 4443/TCP (HTTPS)<br/>Image: trustyai-service (UBI9 OpenJDK 17)"]
            PVC["PVC Storage<br/>/inputs<br/>Inference data persistence"]
        end

        subgraph NS_Optional["Optional Storage"]
            MariaDB["MariaDB/MySQL<br/>Hibernate ORM<br/>(inactive by default)"]
        end
    end

    subgraph InboundSources["INBOUND DATA SOURCES"]
        ModelMesh["KServe/ModelMesh<br/>Model Servers<br/>HTTP POST"]
        KServeEvents["KServe Inference Servers<br/>CloudEvents via Knative<br/>gzip supported"]
        Prometheus["Prometheus<br/>Metrics Scraper<br/>HTTP GET"]
    end

    subgraph InitPhase["INIT PHASE"]
        InitContainer["ose-cli Init Container<br/>Creates model-serving-config<br/>ConfigMap"]
    end

    %% External flows
    Client -->|"HTTP<br/>No TLS (tls: null)<br/>Platform Auth"| Route
    Route -->|"HTTP 80/TCP<br/>Plaintext"| SVC
    SVC -->|"HTTP 8080/TCP<br/>Plaintext"| TrustyAI

    %% Inbound data flows
    ModelMesh -->|"HTTP POST 8080/TCP<br/>/consumer/kserve/v2<br/>No App Auth"| TrustyAI
    KServeEvents -->|"CloudEvents/HTTP<br/>Knative Funqy<br/>No App Auth"| TrustyAI
    Prometheus -->|"HTTP GET 8080/TCP<br/>/q/metrics<br/>Scrape Annotation"| TrustyAI

    %% Storage flows
    TrustyAI -->|"Filesystem I/O<br/>Inference records"| PVC
    TrustyAI -.->|"Hibernate ORM<br/>(when active)<br/>DB credentials"| MariaDB

    %% Init flow
    InitContainer -->|"oc create ConfigMap<br/>model-serving-config"| NS_Deploy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef clusterinternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef datasource fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef init fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Route ingress
    class SVC,TrustyAI clusterinternal
    class PVC,MariaDB storage
    class ModelMesh,KServeEvents,Prometheus datasource
    class InitContainer init
