graph LR
    WBO["Workbenches<br/>Operator"]

    %% Platform Infrastructure
    WBO -->|"API operations<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>Server"]
    WBO -->|"TLS security profile<br/>watch"| APIServer["OpenShift<br/>APIServer"]

    %% Certificate Management
    WBO -->|"webhook TLS certs"| CertManager["cert-manager /<br/>OpenShift service-ca"]

    %% Managed Operand
    WBO -->|"deploys &<br/>manages"| NotebookCtrl["Kubeflow Notebook<br/>Controller"]

    %% CRD Dependencies
    WBO -->|"reads resource<br/>limits"| HardwareProfile["HardwareProfile CR<br/>(infrastructure.opendatahub.io)"]
    WBO -->|"manages CRD<br/>lifecycle"| NotebookCRD["Notebooks CRD<br/>(kubeflow.org)"]

    %% Platform Dependencies (indirect)
    WBO -.->|"gatewayDomain<br/>(via orchestrator)"| GatewayConfig["GatewayConfig"]
    WBO -.->|"mlflowEnabled<br/>(via orchestrator)"| MLflow["DSC MLflowOperator"]

    %% Upstream Configuration
    Orchestrator["Platform Orchestrator<br/>(DSC/DSCI)"] -->|"CR field projection:<br/>gatewayDomain,<br/>mlflowEnabled, platform"| WBO

    %% Consumers / Dependents
    Dashboard["ODH Dashboard"] -.->|"UI management"| NotebookCtrl
    User["User / Data Scientist"] -->|"creates Notebooks"| NotebookCRD

    %% OpenShift Integration
    WBO -->|"image stream<br/>access"| ImageStreams["OpenShift<br/>Image Streams"]

    %% Build Dependencies
    WBO -->|"framework"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    WBO -->|"manifests"| Kustomize["kustomize<br/>v0.21.1"]

    %% Styling
    style WBO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style APIServer fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style NotebookCtrl fill:#7ed321,stroke:#333
    style HardwareProfile fill:#f5a623,stroke:#333
    style NotebookCRD fill:#f5a623,stroke:#333
    style GatewayConfig fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style User fill:#f9f9f9,stroke:#333
    style ImageStreams fill:#999,stroke:#333,color:#fff
    style CtrlRuntime fill:#ddd,stroke:#333
    style Kustomize fill:#ddd,stroke:#333
