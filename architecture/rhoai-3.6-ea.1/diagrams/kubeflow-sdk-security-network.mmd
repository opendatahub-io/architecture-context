graph TB
    subgraph ClientEnv["CLIENT ENVIRONMENT (Workstation or Pod)"]
        SDK["kubeflow-sdk<br/>TrainerClient<br/>Python 3.10+"]
        KubeConfig["kubeconfig<br/>or SA Token"]
        SDK -->|loads credentials| KubeConfig
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        direction TB
        APIServer["Kubernetes API Server<br/>6443/TCP<br/>TLS<br/>AuthN: Bearer/Cert/OIDC<br/>AuthZ: RBAC"]

        subgraph CustomResources["Custom Resources (Namespaced)"]
            direction LR
            TrainJob["TrainJob CR<br/>kubeflow.org"]
            KatibExp["Katib Experiment CR<br/>kubeflow.org"]
            SparkCR["SparkConnect CR<br/>sparkoperator.k8s.io/v1alpha1"]
        end

        subgraph ConfigData["Configuration"]
            ConfigMap["ConfigMap<br/>kubeflow-trainer-public<br/>ns: kubeflow-system"]
        end

        APIServer -->|CRUD| TrainJob
        APIServer -->|CRUD| KatibExp
        APIServer -->|CRUD| SparkCR
        APIServer -->|GET| ConfigMap
    end

    %% Flows
    SDK -->|"HTTPS/6443<br/>TLS<br/>Bearer Token or Client Cert<br/>via kubernetes Python client"| APIServer

    %% Notes
    NoInbound["No inbound connections<br/>(client library only)"]

    style SDK fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    style KubeConfig fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    style APIServer fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style TrainJob fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style KatibExp fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style SparkCR fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    style ConfigMap fill:#e8e8e8,stroke:#999,stroke-width:1px
    style NoInbound fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    classDef clientZone fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlPlane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class ClientEnv clientZone
    class K8sControlPlane controlPlane
