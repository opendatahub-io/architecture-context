graph TB
    subgraph ClientEnv["CLIENT ENVIRONMENT (User Workstation / Notebook Pod)"]
        SDK["Kubeflow SDK<br/>(Python Client Library)<br/>No listening ports<br/>No auth middleware"]

        subgraph AuthDelegation["Authentication Delegation"]
            K8sClient["kubernetes Python Client<br/>Auth: kubeconfig / SA token / OIDC"]
            KFPClient["kfp PipelinesClient<br/>Auth: upstream kfp auth"]
        end

        subgraph TransitiveSecurity["Transitive Security Deps (not directly configured)"]
            Crypto["cryptography 46.0.5"]
            JWT["pyjwt 2.11.0"]
            OAuth["requests-oauthlib 2.0.0"]
        end

        SDK --> K8sClient
        SDK --> KFPClient
        K8sClient -.-> Crypto
        K8sClient -.-> JWT
        K8sClient -.-> OAuth
        KFPClient -.-> JWT
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer / Client Cert / OIDC<br/>RBAC Enforcement"]
    end

    subgraph KubeflowControllers["KUBEFLOW CONTROLLERS (Watch CRs)"]
        TrainerCtrl["Trainer Controller<br/>TrainingJob CRs"]
        KatibCtrl["Katib Controller<br/>Experiment CRs"]
        SparkOp["Spark Operator<br/>SparkApplication CRs"]
    end

    subgraph PipelinesAPI["KUBEFLOW PIPELINES API"]
        KFPAPI["KF Pipelines API Server<br/>HTTPS<br/>TLS (platform-configured)<br/>Platform-delegated auth"]
    end

    %% Flows
    K8sClient -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig / SA token / OIDC"| K8sAPI
    KFPClient -->|"HTTPS<br/>TLS<br/>kfp auth"| KFPAPI
    K8sAPI -->|"CR watch events"| TrainerCtrl
    K8sAPI -->|"CR watch events"| KatibCtrl
    K8sAPI -->|"CR watch events"| SparkOp

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controller fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 3 3

    class SDK client
    class K8sClient,KFPClient client
    class K8sAPI controlplane
    class TrainerCtrl,KatibCtrl,SparkOp controller
    class KFPAPI external
    class Crypto,JWT,OAuth security
