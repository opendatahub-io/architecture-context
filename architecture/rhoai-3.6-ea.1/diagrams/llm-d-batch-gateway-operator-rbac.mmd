graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["llm-d-batch-gateway-operator<br/>(ServiceAccount)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["llm-d-batch-gateway-operator<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings (namespace-scoped)"]
        RB_Leader["llm-d-batch-gateway-<br/>leader-election-rolebinding<br/>(ns: operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Operator["llm-d-batch-gateway-operator<br/>(ClusterRole)"]
        CR_Admin["llm-d-batch-gateway-admin<br/>(ClusterRole)"]
        CR_View["llm-d-batch-gateway-view<br/>(ClusterRole)"]
    end

    subgraph Roles["Roles (namespace-scoped)"]
        R_Leader["llm-d-batch-gateway-<br/>leader-election-role<br/>(Role)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>ConfigMaps"]
        SvcAccts["core<br/>ServiceAccounts"]
        Services["core<br/>Services"]
        Events["core<br/>Events"]
        Secrets["core<br/>Secrets"]
    end

    subgraph AppsResources["apps API Resources"]
        Deployments["apps<br/>Deployments"]
    end

    subgraph BatchResources["batch.llm-d.ai Resources"]
        LLMBatchGW["batch.llm-d.ai<br/>LLMBatchGateway"]
        LLMBatchGWFin["batch.llm-d.ai<br/>LLMBatchGateway/finalizers"]
        LLMBatchGWSt["batch.llm-d.ai<br/>LLMBatchGateway/status"]
    end

    subgraph CertManagerResources["cert-manager.io Resources"]
        Certificates["cert-manager.io<br/>Certificates"]
    end

    subgraph GatewayResources["gateway.networking.k8s.io Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>HTTPRoutes"]
        RefGrants["gateway.networking.k8s.io<br/>ReferenceGrants"]
    end

    subgraph MonitoringResources["monitoring.coreos.com Resources"]
        PodMons["monitoring.coreos.com<br/>PodMonitors"]
        PromRules["monitoring.coreos.com<br/>PrometheusRules"]
        SvcMons["monitoring.coreos.com<br/>ServiceMonitors"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>Leases"]
        LEEvents["core<br/>Events"]
    end

    %% Bindings
    SA_Operator -->|bound via| CRB_Operator
    SA_Operator -->|bound via| RB_Leader

    CRB_Operator -->|grants| CR_Operator
    RB_Leader -->|grants| R_Leader

    %% Operator ClusterRole permissions
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| ConfigMaps
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| SvcAccts
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| Services
    CR_Operator -->|"create,patch"| Events
    CR_Operator -->|"create,get,list,<br/>patch,watch"| Secrets
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| Deployments
    CR_Operator -->|"get,list,patch,<br/>update,watch"| LLMBatchGW
    CR_Operator -->|"update"| LLMBatchGWFin
    CR_Operator -->|"get,patch,update"| LLMBatchGWSt
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| Certificates
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| HTTPRoutes
    CR_Operator -->|"get,list,watch"| RefGrants
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| PodMons
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| PromRules
    CR_Operator -->|"create,delete,get,<br/>list,patch,update,watch"| SvcMons

    %% Admin ClusterRole
    CR_Admin -->|"create,delete,get,<br/>list,patch,update,watch"| LLMBatchGW
    CR_Admin -->|"get"| LLMBatchGWSt

    %% View ClusterRole
    CR_View -->|"get,list,watch"| LLMBatchGW
    CR_View -->|"get"| LLMBatchGWSt

    %% Leader election Role
    R_Leader -->|"create,delete,get,<br/>list,patch,update,watch"| Leases
    R_Leader -->|"create,patch"| LEEvents

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style CR_Operator fill:#f5a623,stroke:#333,color:#000
    style CR_Admin fill:#f5a623,stroke:#333,color:#000
    style CR_View fill:#f5a623,stroke:#333,color:#000
    style R_Leader fill:#f5a623,stroke:#333,color:#000
    style LLMBatchGW fill:#7ed321,stroke:#333,color:#000
    style LLMBatchGWFin fill:#7ed321,stroke:#333,color:#000
    style LLMBatchGWSt fill:#7ed321,stroke:#333,color:#000
    style Certificates fill:#e8e8e8,stroke:#999
    style HTTPRoutes fill:#e8e8e8,stroke:#999
    style RefGrants fill:#e8e8e8,stroke:#999
    style PodMons fill:#e8e8e8,stroke:#999
    style PromRules fill:#e8e8e8,stroke:#999
    style SvcMons fill:#e8e8e8,stroke:#999
