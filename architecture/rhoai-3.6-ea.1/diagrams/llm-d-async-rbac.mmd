graph TD
    subgraph "llm-d-async RBAC Model"
        direction TB

        subgraph "Note"
            Note["No ClusterRoles or RoleBindings<br/>defined in component manifests.<br/>RBAC is enforcement-side only<br/>via controller-runtime metrics auth."]
        end

        subgraph "Runtime Auth Enforcement"
            SA["Pod ServiceAccount<br/>(deployment-specific)"]
            MetricsEndpoint["/metrics Endpoint<br/>Port 9090"]
            K8sAPIServer["Kubernetes API Server<br/>6443/TCP"]
        end

        subgraph "Endpoint Access Matrix"
            HealthEndpoints["/healthz, /readyz<br/>Port 8081<br/>Auth: None<br/>Access: Kubelet only"]
            MetricsAuth["/metrics<br/>Port 9090<br/>Auth: K8s Bearer Token<br/>Authz: K8s RBAC"]
        end

        subgraph "Metrics Scraper Access"
            Scraper["Prometheus / Metrics Scraper"]
            ScraperSA["Scraper ServiceAccount"]
            ScraperToken["K8s Bearer Token"]
        end
    end

    SA -->|"mounted token<br/>used for K8s API calls"| K8sAPIServer

    Scraper -->|"GET /metrics"| MetricsEndpoint
    Scraper -->|"authenticates as"| ScraperSA
    ScraperSA -->|"presents"| ScraperToken
    MetricsEndpoint -->|"validates token via<br/>TokenReview API"| K8sAPIServer
    MetricsEndpoint -->|"checks authz via<br/>SubjectAccessReview API"| K8sAPIServer

    Kubelet["Kubelet"] -->|"GET (unauthenticated)"| HealthEndpoints

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style SA fill:#4a90e2,color:#fff
    style MetricsEndpoint fill:#f5a623,color:#fff
    style K8sAPIServer fill:#636e72,color:#fff
    style HealthEndpoints fill:#50c878,color:#fff
    style MetricsAuth fill:#f5a623,color:#fff
    style Scraper fill:#e8e8e8,stroke:#333
    style ScraperSA fill:#4a90e2,color:#fff
    style ScraperToken fill:#9b59b6,color:#fff
    style Kubelet fill:#e8e8e8,stroke:#333
