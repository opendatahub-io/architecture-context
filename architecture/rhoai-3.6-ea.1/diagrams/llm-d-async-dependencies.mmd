graph LR
    LlmDAsync["llm-d-async<br/>Async Inference Processor"]

    %% Message Broker Dependencies
    LlmDAsync -->|"message transport<br/>:6379 TCP"| Redis["Redis<br/>(go-redis v9.22)"]
    LlmDAsync -->|"message transport<br/>:443 HTTPS"| GCPPubSub["GCP Pub/Sub<br/>(cloud.google.com/go/pubsub v2.6)"]

    %% Inference Backend
    LlmDAsync -->|"inference dispatch<br/>:8000 HTTP/HTTPS"| InferenceGW["Inference Gateway<br/>(e.g. vLLM)"]

    %% Framework Dependencies
    LlmDAsync -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    LlmDAsync -->|"K8s client"| K8sClientGo["k8s.io/client-go<br/>v0.34.10"]
    LlmDAsync -->|"runtime library"| GatewayAPIExt["gateway-api-inference-<br/>extension v1.2.1"]

    %% Observability Dependencies
    LlmDAsync -->|"distributed tracing"| OTel["OpenTelemetry<br/>(otel v1.45)"]
    LlmDAsync -->|"metrics client"| PromClient["prometheus/client_golang<br/>v1.24.1"]
    LlmDAsync -->|"structured logging"| Zap["go.uber.org/zap<br/>v1.28.0"]

    %% Runtime Dependencies
    LlmDAsync -->|"build toolchain"| Go["Go 1.26<br/>FIPS: strictfipsruntime"]
    LlmDAsync -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>v1.83.0"]

    %% External Services
    LlmDAsync -->|"resource ops<br/>:6443 HTTPS"| K8sAPI["Kubernetes API"]
    LlmDAsync -->|"metric queries<br/>:9090 HTTP"| Prometheus["Prometheus<br/>(flow-control gates)"]
    LlmDAsync -->|"trace export<br/>OTLP/gRPC"| OTelCollector["OTel Collector"]

    %% Integration Points (inbound)
    LlmDStack["llm-d Stack<br/>(orchestrator)"] -.->|"deploys & configures"| LlmDAsync

