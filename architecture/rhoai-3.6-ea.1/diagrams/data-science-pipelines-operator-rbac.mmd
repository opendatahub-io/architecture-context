        SA_CM["controller-manager<br/>(NS: datasciencepipelinesapplications-controller)"]
        SA_Argo["argo<br/>(NS: argo)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["manager-rolebinding"]
        CRB_ManagerArgo["manager-argo-rolebinding"]
        CRB_ArgoDS["ds-pipeline-argo-binding"]
    end

    subgraph "Role Bindings"
        RB_Argo["argo-binding<br/>(NS: argo)"]
        RB_Leader["leader-election-rolebinding<br/>(NS: datasciencepipelinesapplications-controller)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["manager-role<br/>(30+ resource rules)"]
        CR_ManagerArgo["manager-argo-role"]
        CR_ArgoCluster["argo-cluster-role"]
        CR_AggEdit["aggregate-dspa-admin-edit<br/>(aggregated to admin/edit)"]
        CR_AggView["aggregate-dspa-admin-view<br/>(aggregated to view)"]
