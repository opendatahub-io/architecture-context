        Core_Res["core<br/>ConfigMaps, Secrets, Services<br/>ServiceAccounts, PVCs, PVs<br/>Pods, Pods/exec, Pods/log"]
        Apps_Res["apps/extensions<br/>Deployments, ReplicaSets"]
        RBAC_Res["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings<br/>Roles, RoleBindings"]
        Route_Res["route.openshift.io<br/>Routes"]
        NetPol_Res["networking.k8s.io<br/>NetworkPolicies, Ingresses"]
        Monitor_Res["monitoring.coreos.com<br/>ServiceMonitors"]
        Ray_Res["ray.io<br/>RayClusters, RayJobs<br/>RayServices"]
        CodeFlare_Res["workload.codeflare.dev<br/>AppWrappers"]
        KServe_Res["serving.kserve.io<br/>InferenceServices"]
        MLflow_Res["mlflow.opendatahub.io<br/>MLflows"]
        Seldon_Res["machinelearning.seldon.io<br/>SeldonDeployments"]
        Kubeflow_Res["kubeflow.org<br/>* (all resources)"]
        Webhook_Res["admissionregistration.k8s.io<br/>Validating/Mutating<br/>WebhookConfigurations"]
        OpenShift_Res["config.openshift.io<br/>APIServers (read-only)"]
    end

    subgraph "aggregate-dspa-admin-edit Resources"
        AggEdit_Res["DSPA CRDs: full CRUD<br/>Pipeline CRDs: full CRUD"]
    end

    subgraph "aggregate-dspa-admin-view Resources"
        AggView_Res["DSPA CRDs: get, list, watch<br/>Pipeline CRDs: get, list, watch"]
    end

    %% Service Account bindings
    SA_CM -->|"bound via"| CRB_Manager
