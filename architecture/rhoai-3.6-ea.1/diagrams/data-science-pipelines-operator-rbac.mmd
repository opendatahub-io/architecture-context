    subgraph "Roles"
        R_Argo["argo-role<br/>(NS: argo)"]
        R_Leader["leader-election-role<br/>(NS: datasciencepipelinesapplications-controller)"]
    end

    subgraph "manager-role Resources"
        direction LR
        DSPA_Res["datasciencepipelinesapplications<br/>.opendatahub.io<br/>DSPA, DSPA/status,<br/>DSPA/finalizers, DSPA/api"]
