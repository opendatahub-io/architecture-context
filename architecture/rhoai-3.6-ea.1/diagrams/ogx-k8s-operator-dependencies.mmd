graph LR
    OGX["ogx-k8s-operator<br/>(Root Operator)"]
    OGXMod["ogx-module<br/>(Platform Controller)"]

    %% Runtime Framework
    OGX -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    OGXMod -->|"operator framework"| ControllerRuntime

    %% Internal ODH Dependencies
    OGXMod -->|"manifest rendering<br/>platform detection<br/>condition mgmt"| ODHPlatformUtils["odh-platform-utilities"]
    OGX -->|"TLS profile fetch"| ControllerRuntimeCommon["controller-runtime-common<br/>OpenShift TLS"]

    %% Kubernetes API Dependencies
    OGX -->|"resource CRUD"| K8sAPI["Kubernetes API<br/>k8s.io/api v0.35.2"]
    OGX -->|"client operations"| K8sClientGo["k8s.io/client-go<br/>v0.35.2"]
    OGX -->|"CRD operations"| K8sAPIExt["apiextensions-apiserver<br/>v0.35.2"]
    OGXMod -->|"kustomize rendering"| Kustomize["sigs.k8s.io/kustomize<br/>v0.21.0"]

    %% OpenShift Dependencies
    OGX -->|"OpenShift API types"| OpenShiftAPI["openshift/api"]
    OGX -->|"SCC usage"| SCC["security.openshift.io<br/>SecurityContextConstraints"]

    %% Monitoring Dependencies
    OGX -->|"metrics + monitoring"| PrometheusOp["prometheus-operator<br/>v0.82.0"]

    %% Container Registry
    OGX -->|"image inspection"| GoContainerReg["go-containerregistry<br/>v0.21.7"]

    %% Observability
    OGX -->|"structured logging"| Zap["go.uber.org/zap<br/>v1.27.1"]
    OGX -->|"logging interface"| Logr["go-logr<br/>v1.4.3"]

    %% Configuration
    OGX -->|"runtime config"| Viper["spf13/viper<br/>v1.21.0"]

    %% Build Dependencies
    OGX -->|"built with"| Go["Go 1.25.8"]

    %% Integration Points (consumers)
    Dashboard["RHOAI Dashboard"] -.->|"UI management"| OGX
    RHOAIOp["RHOAI Operator"] -->|"installs via OGX CR"| OGXMod

    %% Styling
    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style OGXMod fill:#5b9bd5,stroke:#333,stroke-width:3px,color:#fff

    style ODHPlatformUtils fill:#7ed321,stroke:#333,color:#fff
    style ControllerRuntimeCommon fill:#7ed321,stroke:#333,color:#fff

    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style K8sClientGo fill:#999,stroke:#333,color:#fff
    style K8sAPIExt fill:#999,stroke:#333,color:#fff
    style Kustomize fill:#999,stroke:#333,color:#fff
    style Go fill:#999,stroke:#333,color:#fff

    style OpenShiftAPI fill:#c0392b,stroke:#333,color:#fff
    style SCC fill:#c0392b,stroke:#333,color:#fff

    style PrometheusOp fill:#f5a623,stroke:#333
    style GoContainerReg fill:#f5a623,stroke:#333
    style Zap fill:#f5a623,stroke:#333
    style Logr fill:#f5a623,stroke:#333
    style Viper fill:#f5a623,stroke:#333

    style Dashboard fill:#dae8fc,stroke:#6c8ebf
    style RHOAIOp fill:#dae8fc,stroke:#6c8ebf
