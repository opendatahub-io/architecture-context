graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(kubectl / API consumer)"]
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC + ServiceAccount"]
        AdmissionCtrl["Admission Controller<br/>(built-in)"]
    end

    subgraph ODHNamespace["NAMESPACE: odh-model-controller-system"]
        direction TB

        subgraph ControllerDeploy["odh-model-controller Deployment"]
            Manager["Manager Process<br/>SA: odh-model-controller<br/>Image: controller:latest<br/>FIPS: strictfipsruntime"]
            WebhookSvc["Webhook Service<br/>443/TCP → 9443/TCP<br/>TLS (service-ca cert)<br/>FailurePolicy: Fail"]
            MetricsSvc1["Metrics Service<br/>8080/TCP<br/>HTTP (secureMetrics=false)"]
            HealthProbes1["Health Probes<br/>8081/TCP /healthz /readyz<br/>Unauthenticated"]
        end

        subgraph APIDeploy["model-serving-api Deployment"]
            APIProcess["API Server Process<br/>SA: model-serving-api<br/>Image: controller:latest<br/>FIPS: strictfipsruntime"]
            APISvc["API Service<br/>443/TCP → 8443/TCP<br/>TLS 1.2+ FIPS<br/>Bearer + SSAR"]
            MetricsSvc2["Metrics Listener<br/>8080/TCP<br/>TLS (no auth middleware)"]
            HealthProbes2["Health Probes<br/>8443/TCP /healthz /readyz<br/>Unauthenticated"]
        end

        Secret1["Secret: odh-model-controller-webhook-cert<br/>Type: kubernetes.io/tls<br/>Provisioned: OpenShift service-ca"]
        Secret2["Secret: model-serving-api-tls<br/>Type: kubernetes.io/tls<br/>Provisioned: OpenShift service-ca"]
    end

    subgraph PlatformCRDs["PLATFORM RESOURCES"]
        DSC["DataScienceCluster CR"]
        DSCI["DSCInitialization CR"]
        HP["HardwareProfile CR"]
        ISVC["InferenceService CR"]
        LLMISVC["LLMInferenceService CR"]
        GW["Gateway CR"]
        NIMAccount["NIM Account CR"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (various namespaces)"]
        OShiftRoutes["OpenShift Routes"]
        NetPol["NetworkPolicies"]
        KuadrantAuth["Kuadrant AuthPolicies"]
        IstioEF["Istio EnvoyFilters"]
        MonResources["PodMonitors / ServiceMonitors"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus<br/>Scrapes 8080/TCP"]
        OTELCollector["OpenTelemetry Collector<br/>OTLP/gRPC TLS"]
    end

    %% External flows
    Client -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer/kubeconfig"| APIServer
    Client -->|"HTTPS/443→8443<br/>TLS 1.2+ FIPS<br/>Bearer Token"| APISvc

    %% Admission flow
    APIServer -->|"HTTPS/443→9443<br/>TLS (service-ca)<br/>Admission webhook"| WebhookSvc

    %% Controller to API Server
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: odh-model-controller"| APIServer
    APIProcess -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: model-serving-api"| APIServer

    %% SSAR authorization
    APIProcess -->|"SelfSubjectAccessReview<br/>HTTPS/6443"| APIServer

    %% Platform CRD reads
    Manager -.->|"Watch/TLS"| DSC
    Manager -.->|"Watch/TLS"| DSCI
    Manager -.->|"Watch/TLS"| HP
    Manager -.->|"Watch/TLS"| ISVC
    Manager -.->|"Watch/TLS"| LLMISVC
    Manager -.->|"Watch/TLS"| GW
    Manager -.->|"Watch/TLS"| NIMAccount

    %% Managed resource creation
    Manager -->|"CRUD/TLS"| OShiftRoutes
    Manager -->|"CRUD/TLS"| NetPol
    Manager -->|"CRUD/TLS"| KuadrantAuth
    Manager -->|"CRUD/TLS"| IstioEF
    Manager -->|"CRUD/TLS"| MonResources

    %% Cert mounting
    Secret1 -.->|"volume mount"| WebhookSvc
    Secret2 -.->|"volume mount"| APISvc

    %% Observability
    Prometheus -->|"HTTP/8080<br/>Scrape"| MetricsSvc1
    Prometheus -->|"TLS/8080<br/>Scrape"| MetricsSvc2
    APIProcess -->|"OTLP/gRPC<br/>TLS (configured)"| OTELCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef namespace fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef observability fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class APIServer,AdmissionCtrl controlplane
    class Manager,WebhookSvc,MetricsSvc1,HealthProbes1,APIProcess,APISvc,MetricsSvc2,HealthProbes2,Secret1,Secret2 namespace
    class DSC,DSCI,HP,ISVC,LLMISVC,GW,NIMAccount platform
    class OShiftRoutes,NetPol,KuadrantAuth,IstioEF,MonResources managed
    class Prometheus,OTELCollector observability
