graph LR
    MaaS["Models-as-a-Service<br/>(maas-api + maas-controller)"]

    %% External Dependencies (required infrastructure)
    MaaS -->|"traffic routing<br/>HTTPRoute CRUD"| GatewayAPI["Gateway API<br/>sigs.k8s.io/gateway-api v1.5.1"]
    MaaS -->|"auth enforcement<br/>AuthPolicy + TokenRateLimitPolicy"| Kuadrant["Kuadrant/Authorino<br/>Gateway-level AuthN/AuthZ"]
    MaaS -->|"API keys, subscriptions,<br/>tenant state (pgx)"| PostgreSQL["PostgreSQL<br/>(maas-db-config secret)"]
    MaaS -->|"CRD CRUD, TokenReview,<br/>SAR, watches (6443/TCP)"| K8sAPI["Kubernetes API<br/>k8s.io v0.35.3"]

    %% Internal RHOAI Dependencies
    MaaS -.->|"conditional watch<br/>LLMInferenceService<br/>(CRD existence check)"| KServe["KServe<br/>v0.19.0-rc0"]

    %% Optional Dependencies
    MaaS -.->|"OTLP/gRPC<br/>trace export"| OTel["OpenTelemetry Collector<br/>otel v1.44.0"]

    %% Runtime Framework Dependencies
    MaaS -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    MaaS -->|"HTTP framework"| Gin["Gin<br/>v1.10.1"]
    MaaS -->|"FIPS crypto"| OpenSSL["OpenSSL<br/>(via UBI9 + strictfipsruntime)"]

    %% Integration Points (what depends on MaaS)
    Dashboard["ODH Dashboard"] -.->|"tenant/model mgmt"| MaaS
    DSPipelines["Data Science Pipelines"] -.->|"model deployment"| MaaS

    %% Platform Resources Managed
    MaaS -->|"creates/manages"| HTTPRoutes["HTTPRoute Resources"]
    MaaS -->|"creates/manages"| AuthPolicies["AuthPolicy Resources"]
    MaaS -->|"creates/manages"| RateLimits["TokenRateLimitPolicy Resources"]
    MaaS -->|"manages"| Namespaces["Tenant Namespaces"]

