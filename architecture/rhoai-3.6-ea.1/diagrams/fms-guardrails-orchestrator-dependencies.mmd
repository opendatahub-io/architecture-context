graph LR
    Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Internal Platform Dependencies
    Orchestrator -->|"gRPC/8085<br/>TLS optional"| Chunker["Chunker Services<br/>(caikit Chunkers API)"]
    Orchestrator -->|"REST/8080<br/>TLS optional"| Detectors["Detector Services"]
    Orchestrator -->|"HTTP/8081"| DetectorHealth["Detector Health<br/>Services"]
    Orchestrator -->|"gRPC/8033"| TGIS["TGIS Generation<br/>Service"]

    %% Core Framework Dependencies
    Orchestrator -->|"REST framework"| Axum["axum 0.8.8"]
    Orchestrator -->|"gRPC clients"| Tonic["tonic 0.14.2"]
    Orchestrator -->|"async runtime"| Tokio["tokio 1.49.0"]
    Orchestrator -->|"HTTP transport"| Hyper["hyper 1.8.1"]

    %% Crypto / TLS Dependencies
    Orchestrator -->|"TLS stack"| Rustls["rustls 0.23.36<br/>(ring - NOT FIPS)"]
    Orchestrator -->|"REST client"| Reqwest["reqwest 0.12.28"]

    %% Observability
    Orchestrator -->|"tracing"| OTel["OpenTelemetry 0.31.0"]

    %% Serialization
    Orchestrator -->|"protobuf"| Prost["prost 0.14.1"]
    Orchestrator -->|"JSON/YAML"| Serde["serde 1.0.228"]

    style Orchestrator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
