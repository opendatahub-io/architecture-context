    style DetectorHealth fill:#7ed321,stroke:#333,color:#fff
    style TGIS fill:#7ed321,stroke:#333,color:#fff
    style Axum fill:#999,stroke:#333,color:#fff
    style Tonic fill:#999,stroke:#333,color:#fff
    style Tokio fill:#999,stroke:#333,color:#fff
    style Hyper fill:#999,stroke:#333,color:#fff
    style Rustls fill:#e74c3c,stroke:#333,color:#fff
    style Reqwest fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
