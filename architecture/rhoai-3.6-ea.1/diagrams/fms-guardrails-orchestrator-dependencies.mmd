graph LR
    Orchestrator["FMS Guardrails<br/>Orchestrator"]

    %% Runtime Framework Dependencies
    Orchestrator -->|"HTTP routing"| Axum["axum 0.8.8"]
    Orchestrator -->|"gRPC client"| Tonic["tonic 0.14.2"]
    Orchestrator -->|"async runtime"| Tokio["tokio 1.49.0"]

    %% Transport Dependencies
    Orchestrator -->|"HTTP transport"| Hyper["hyper 1.8.1"]
    Orchestrator -->|"protobuf"| Prost["prost 0.14.1"]

    %% Security Dependencies
    Orchestrator -->|"TLS (NOT FIPS)"| Rustls["rustls 0.23.36<br/>(ring provider)"]
    Rustls -->|"crypto"| Ring["ring<br/>NOT FIPS-validated"]

    %% Observability
    Orchestrator -->|"traces & metrics"| OTel["opentelemetry 0.31.0"]
    OTel -->|"export"| OTLP["opentelemetry-otlp"]

    %% Integration Dependencies
    Orchestrator -->|"HTTP client"| Reqwest["reqwest 0.12.28<br/>(rustls-tls)"]

    %% Internal Platform Dependencies (downstream services)
    Orchestrator -->|"gRPC :8033"| TGIS["TGIS Generation<br/>Service"]
    Orchestrator -->|"gRPC :8085"| Chunker["Chunker Services"]
    Orchestrator -->|"REST :8080"| Detector["Detector Services"]
    Orchestrator -.->|"REST :8081"| DetHealth["Detector Health<br/>Services"]

    %% Observability Export
    Orchestrator -.->|"OTLP export"| OTLPCollector["OTLP Collector"]

    %% Styling
    style Orchestrator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Framework deps
    style Axum fill:#7ed321,stroke:#333,color:#fff
    style Tonic fill:#7ed321,stroke:#333,color:#fff
    style Tokio fill:#7ed321,stroke:#333,color:#fff

    %% Transport deps
    style Hyper fill:#9b59b6,stroke:#333,color:#fff
    style Prost fill:#9b59b6,stroke:#333,color:#fff

    %% Security deps
    style Rustls fill:#e8544f,stroke:#333,color:#fff
    style Ring fill:#e74c3c,stroke:#333,color:#fff

    %% Observability deps
    style OTel fill:#8e44ad,stroke:#333,color:#fff
    style OTLP fill:#8e44ad,stroke:#333,color:#fff

    %% Integration deps
    style Reqwest fill:#f5a623,stroke:#333,color:#fff

    %% Downstream services
    style TGIS fill:#999,stroke:#333,color:#fff
    style Chunker fill:#999,stroke:#333,color:#fff
    style Detector fill:#999,stroke:#333,color:#fff
    style DetHealth fill:#999,stroke:#333,color:#fff
    style OTLPCollector fill:#999,stroke:#333,color:#fff
