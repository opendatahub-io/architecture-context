graph TB
    subgraph "guardrails-regex-detector Service"
        direction TB
        AxumRouter["Axum Router<br/>(HTTP Server)"]
        TraceLayer["TraceLayer<br/>(Request/Response Logging)"]
        DetectionHandler["handle_text_contents<br/>(Detection Handler)"]
        HealthHandler["Health Check Handler"]

        subgraph "Built-in Detectors"
            EmailDetector["Email Detector<br/>(regex)"]
            SSNDetector["SSN Detector<br/>(regex)"]
            CreditCardDetector["Credit Card Detector<br/>(regex)"]
        end

        subgraph "Custom Detection"
            UserRegex["User-Supplied Regex<br/>(compiled at request time)"]
        end

        AxumRouter --> TraceLayer
        AxumRouter -->|"POST /api/v1/text/contents"| DetectionHandler
        AxumRouter -->|"GET /health"| HealthHandler
        DetectionHandler -->|"built-in patterns"| EmailDetector
        DetectionHandler -->|"built-in patterns"| SSNDetector
        DetectionHandler -->|"built-in patterns"| CreditCardDetector
        DetectionHandler -->|"user patterns"| UserRegex
    end

    subgraph "Container"
        Entrypoint["/app/bin/regex-detector<br/>UBI 9 Minimal"]
    end

    Orchestrator["Guardrails Orchestrator<br/>(upstream caller)"] -->|"POST JSON<br/>port 8080"| AxumRouter
    K8sProbe["Kubernetes Probes"] -->|"GET /health<br/>port 8080"| AxumRouter
    Entrypoint -.->|"runs"| AxumRouter

    style AxumRouter fill:#4a90e2,stroke:#333,color:#fff
    style DetectionHandler fill:#4a90e2,stroke:#333,color:#fff
    style HealthHandler fill:#4a90e2,stroke:#333,color:#fff
    style TraceLayer fill:#4a90e2,stroke:#333,color:#fff
    style EmailDetector fill:#7ed321,stroke:#333
    style SSNDetector fill:#7ed321,stroke:#333
    style CreditCardDetector fill:#7ed321,stroke:#333
    style UserRegex fill:#7ed321,stroke:#333
    style Entrypoint fill:#e8e8e8,stroke:#333
    style Orchestrator fill:#f5a623,stroke:#333
    style K8sProbe fill:#e8e8e8,stroke:#333
