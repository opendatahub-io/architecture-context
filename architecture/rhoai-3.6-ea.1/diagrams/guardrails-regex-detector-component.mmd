graph TB
    subgraph "guardrails-regex-detector"
        direction TB
        AxumRouter["Axum Router<br/>(HTTP Server)"]
        TracingMiddleware["Tracing Middleware<br/>(tower-http)"]
        DetectionHandler["Detection Handler<br/>/api/v1/text/contents"]
        HealthHandler["Health Handler<br/>/health"]
        DetectorRegistry["Detector Registry<br/>(HashMap)"]

        subgraph "Built-in Detectors"
            EmailDetector["Email Detector"]
            SSNDetector["SSN Detector"]
            CreditCardDetector["Credit Card Detector"]
        end

        CustomRegex["Custom Regex<br/>Compiler"]

        AxumRouter --> TracingMiddleware
        TracingMiddleware --> DetectionHandler
        TracingMiddleware --> HealthHandler
        DetectionHandler --> DetectorRegistry
        DetectorRegistry --> EmailDetector
        DetectorRegistry --> SSNDetector
        DetectorRegistry --> CreditCardDetector
        DetectionHandler --> CustomRegex
    end

    Orchestrator["Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>8080/TCP HTTP"| AxumRouter
    Probes["Liveness/Readiness<br/>Probes"] -->|"GET /health<br/>8080/TCP HTTP"| AxumRouter

    subgraph "Runtime Stack"
        Tokio["Tokio Async Runtime"]
        UBI9["UBI9-minimal<br/>Container Image"]
    end

    AxumRouter -.->|"runs on"| Tokio
    Tokio -.->|"runs in"| UBI9

    style AxumRouter fill:#4a90e2,color:#fff
    style DetectionHandler fill:#4a90e2,color:#fff
    style HealthHandler fill:#4a90e2,color:#fff
    style DetectorRegistry fill:#f5a623,color:#fff
    style EmailDetector fill:#7ed321,color:#fff
    style SSNDetector fill:#7ed321,color:#fff
    style CreditCardDetector fill:#7ed321,color:#fff
    style CustomRegex fill:#7ed321,color:#fff
    style Orchestrator fill:#e8e8e8,stroke:#333
    style Probes fill:#e8e8e8,stroke:#333
    style Tokio fill:#ddd,stroke:#333
    style UBI9 fill:#ddd,stroke:#333
