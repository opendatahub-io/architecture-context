graph LR
    OGX["OGX Distribution<br/>AI Inference Gateway"]

    %% Required Internal Dependencies
    OGX -->|"SQL/5432<br/>kv_postgres + sql_postgres<br/>Required"| PostgreSQL["PostgreSQL"]

    %% Conditional Inference Providers
    OGX -->|"HTTP/HTTPS<br/>API Token<br/>VLLM_URL"| vLLM["vLLM"]
    OGX -->|"HTTPS/443<br/>AWS SDK<br/>ENABLE_BEDROCK"| Bedrock["AWS Bedrock"]
    OGX -->|"HTTPS/443<br/>API Key<br/>WATSONX_API_KEY"| WatsonX["IBM WatsonX"]
    OGX -->|"HTTPS/443<br/>env-gated"| Azure["Azure"]
    OGX -->|"HTTPS/443<br/>env-gated"| OpenAI["OpenAI"]
    OGX -->|"HTTPS/443<br/>env-gated"| Gemini["Gemini"]
    OGX -->|"HTTPS/443<br/>env-gated"| AnthropicProv["Anthropic"]
    OGX -->|"HTTPS/443<br/>env-gated"| VertexAI["Vertex AI"]

    %% Conditional Vector Storage
    OGX -->|"HTTP/gRPC<br/>mTLS configurable<br/>MILVUS_ENDPOINT"| Milvus["Milvus"]
    OGX -->|"SQL/5432<br/>ENABLE_PGVECTOR"| PGVector["pgvector"]
    OGX -->|"HTTP/6333, gRPC/6334<br/>ENABLE_QDRANT"| Qdrant["Qdrant"]

    %% File Storage
    OGX -->|"HTTPS/443<br/>ENABLE_S3"| S3["S3 Storage"]

    %% Observability
    OGX -.->|"OTLP<br/>OTEL_SERVICE_NAME"| OTel["OpenTelemetry<br/>Collector"]

    %% Platform Dependencies
    OGX -.->|"TLS termination<br/>delegated"| PlatformIngress["Platform Ingress<br/>(OpenShift Route)"]

    %% Styling
    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required
    style PostgreSQL fill:#336791,stroke:#333,stroke-width:2px,color:#fff

    %% Internal / Inference
    style vLLM fill:#7ed321,stroke:#333

    %% External Inference Providers
    style Bedrock fill:#f5a623,stroke:#333
    style WatsonX fill:#f5a623,stroke:#333
    style Azure fill:#f5a623,stroke:#333
    style OpenAI fill:#f5a623,stroke:#333
    style Gemini fill:#f5a623,stroke:#333
    style AnthropicProv fill:#f5a623,stroke:#333
    style VertexAI fill:#f5a623,stroke:#333

    %% Vector Storage
    style Milvus fill:#00bcd4,stroke:#333
    style PGVector fill:#336791,stroke:#333,color:#fff
    style Qdrant fill:#00bcd4,stroke:#333

    %% External Services
    style S3 fill:#f5a623,stroke:#333
    style OTel fill:#9b59b6,stroke:#333,color:#fff
    style PlatformIngress fill:#e8e8e8,stroke:#333
