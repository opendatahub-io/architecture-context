graph TB
    subgraph PipelineRuntime["DATA SCIENCE PIPELINE (Trusted - Pipeline Runtime)"]
        direction TB

        subgraph PipelinePod["KFP Pipeline Task Pod<br/>Namespace: {pipeline-namespace}<br/>SA: pipeline-runner"]
            direction TB

            subgraph ai4ragLib["ai4rag Library (in-process)"]
                S3Client["S3 Client<br/>(boto3)"]
                MaaSClient["MaaS Client<br/>(OpenAI SDK / httpx)"]
                VectorClient["Vector Store Client<br/>(pymilvus / psycopg / chromadb)"]
                GAM["GAM Optimizer"]
                KFPHandler["KFP Event Handler"]
            end
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress Only)"]
        direction TB

        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM Keys"]

        MaaS["MaaS Endpoint<br/>(vLLM / OpenAI-compatible)<br/>HTTPS/TLS<br/>Auth: API Key (Bearer)<br/>RISK: verify=False fallback"]

        subgraph VectorStores["Vector Store Backends (one active)"]
            Milvus["Milvus<br/>gRPC + TLS<br/>PEM cert injection<br/>Auth: MILVUS_TOKEN"]
            PGVector["PGVector<br/>PostgreSQL wire protocol<br/>TLS via libpq<br/>Auth: PGVECTOR_PASSWORD"]
            Chroma["Chroma<br/>HTTP (ephemeral/persistent)<br/>or TLS (client/server)<br/>Auth: None"]
        end
    end

    %% Flows
    S3Client -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY"| S3
    MaaSClient -->|"HTTPS<br/>TLS (verify=False fallback)<br/>API Key Bearer Token"| MaaS
    VectorClient -->|"gRPC/TLS<br/>MILVUS_TOKEN"| Milvus
    VectorClient -->|"PostgreSQL/TLS<br/>PGVECTOR_PASSWORD"| PGVector
    VectorClient -->|"HTTP<br/>No auth"| Chroma

    %% Styling
    classDef pipeline fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef library fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef vectorstore fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class PipelinePod pipeline
    class S3Client,MaaSClient,VectorClient,GAM,KFPHandler library
    class S3 external
    class MaaS risk
    class Milvus,PGVector,Chroma vectorstore
