graph TB
    subgraph UserEnv["USER ENVIRONMENT (Library Consumer)"]
        direction TB
        ai4rag["ai4rag Python Library<br/>Python >=3.12,<3.14<br/>Crypto: Host OpenSSL"]

        subgraph Credentials["CREDENTIALS (Environment Variables)"]
            AWSKey["AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
            OGXKey["OGX API Key"]
            S3Endpoint["AWS_S3_ENDPOINT"]
        end

        AWSKey -.->|sourced by| ai4rag
        OGXKey -.->|sourced by| ai4rag
        S3Endpoint -.->|sourced by| ai4rag
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>(AWS S3 / MinIO)<br/>Port: Configured by runtime"]
        OGX["OGX Inference Service<br/>(Platform Internal)<br/>Port: Configured by runtime"]
    end

    %% Network flows with security details
    ai4rag -->|"HTTPS<br/>TLS (host OpenSSL)<br/>Auth: AWS Access Key<br/>Configurable verify param"| S3
    ai4rag -->|"HTTPS<br/>TLS (host OpenSSL)<br/>Auth: API Key<br/>⚠ verify=False fallback<br/>on self-signed certs"| OGX

    %% Styling
    classDef library fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef credential fill:#ff6b6b,stroke:#cc0000,stroke-width:2px,color:#fff
    classDef external fill:#f5a623,stroke:#d79b00,stroke-width:2px
    classDef warning fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class ai4rag library
    class AWSKey,OGXKey,S3Endpoint credential
    class S3,OGX external
