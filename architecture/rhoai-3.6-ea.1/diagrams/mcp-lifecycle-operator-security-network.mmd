graph TB
    subgraph External["INBOUND CLIENTS"]
        Kubelet["Kubernetes Kubelet<br/>Health Probes"]
        Prometheus["Prometheus Scraper<br/>Metrics Collection"]
    end

    subgraph OperatorPod["OPERATOR POD (mcp-lifecycle-operator-system)"]
        direction TB

        subgraph HealthEndpoint["Health Probes - Port 8081/TCP"]
            Healthz["/healthz<br/>HTTP | No Encryption | No Auth"]
            Readyz["/readyz<br/>HTTP | No Encryption | No Auth"]
        end

        subgraph MetricsEndpoint["Metrics - Port 8443/TCP"]
            Metrics["/metrics<br/>HTTPS | TLS (self-signed)<br/>TokenReview + SubjectAccessReview"]
        end

        subgraph Controller["MCPServerReconciler"]
            Reconciler["Reconciler Loop<br/>SA: mcp-lifecycle-operator-<br/>controller-manager"]
            HandshakeClient["MCP Handshake Client<br/>go-sdk v1.6.1<br/>Exponential backoff"]
        end

        subgraph TLS["TLS Configuration"]
            TLSSettings["TLS_MIN_VERSION<br/>TLS_CIPHER_SUITES<br/>GOEXPERIMENT=strictfipsruntime"]
        end
    end

    subgraph K8sCluster["KUBERNETES CLUSTER"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>ServiceAccount Token"]
    end

    subgraph ManagedWorkloads["MANAGED MCP SERVER PODS"]
        MCPPod["MCP Server Pod<br/>dynamic port/TCP<br/>HTTP (in-cluster)<br/>No Auth (graceful 401/403)"]
    end

    subgraph ManagedResources["OWNED RESOURCES"]
        Deployment["Deployment"]
        Service["Service"]
        NetPol["NetworkPolicy"]
    end

    %% Inbound flows
    Kubelet -->|"HTTP/8081<br/>No Encryption<br/>No Auth"| Healthz
    Kubelet -->|"HTTP/8081<br/>No Encryption<br/>No Auth"| Readyz
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>TokenReview + SAR"| Metrics

    %% Outbound flows
    Reconciler -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    HandshakeClient -->|"HTTP/dynamic<br/>No Encryption<br/>No Auth"| MCPPod

    %% Resource management
    K8sAPI -.->|"CRUD"| Deployment
    K8sAPI -.->|"CRUD"| Service
    K8sAPI -.->|"CRUD"| NetPol
    Deployment -.->|"runs"| MCPPod

    %% TLS propagation
    TLSSettings -.->|"PROPAGATE_TLS_ENV_VARS"| MCPPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef healthport fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef metricsport fill:#ffe6cc,stroke:#d79b00,stroke-width:1px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef resource fill:#f5f5f5,stroke:#666,stroke-width:1px

    class Kubelet,Prometheus external
    class Reconciler,HandshakeClient,TLSSettings operator
    class Healthz,Readyz healthport
    class Metrics metricsport
    class K8sAPI k8s
    class MCPPod managed
    class Deployment,Service,NetPol resource
