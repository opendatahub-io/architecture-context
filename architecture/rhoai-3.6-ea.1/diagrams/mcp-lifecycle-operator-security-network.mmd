graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Platform"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (mcp-lifecycle-operator-system)"]
        direction TB

        subgraph ControllerPod["controller-manager Pod"]
            Controller["MCPServerReconciler<br/>SA: mcp-lifecycle-operator-controller-manager<br/>FIPS: strictfipsruntime"]
            HealthEndpoint["/healthz, /readyz<br/>:8081/TCP HTTP<br/>No Auth"]
            MetricsEndpoint["/metrics<br/>:8443/TCP HTTPS<br/>TLS (self-signed)<br/>TokenReview + SAR"]
        end

        MetricsService["metrics-service<br/>ClusterIP :8443/TCP"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (user namespaces)"]
        ManagedDeployment["MCP Server Deployment"]
        ManagedService["MCP Server Service"]
        ManagedNetPol["NetworkPolicy"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>RBAC (admin/editor)"| K8sAPI

    %% Control plane to operator
    K8sAPI -->|"Watch events<br/>TLS<br/>ServiceAccount token"| Controller

    %% Operator to control plane
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>CRUD: Deployments, Services,<br/>NetworkPolicies, ConfigMaps,<br/>Secrets, MCPServer CRs"| K8sAPI

    %% Operator manages resources
    Controller -.->|"creates/updates"| ManagedDeployment
    Controller -.->|"creates/updates"| ManagedService
    Controller -.->|"creates/updates"| ManagedNetPol

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>Bearer Token<br/>TokenReview + SAR"| MetricsService
    MetricsService -->|":8443"| MetricsEndpoint

    %% Health probes
    K8sAPI -.->|"HTTP/8081<br/>No TLS<br/>No Auth<br/>kubelet probes"| HealthEndpoint

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Controller,HealthEndpoint,MetricsEndpoint,MetricsService operator
    class ManagedDeployment,ManagedService,ManagedNetPol managed
    class Prometheus monitoring
