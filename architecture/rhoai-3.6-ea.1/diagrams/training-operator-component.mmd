graph TB
    subgraph TrainingOperator["Training Operator"]
        direction TB
        Controller["training-operator.v1<br/>Controller Manager<br/>(Go controller-runtime)"]
        WebhookServer["Webhook Server<br/>Port 9443/TCP<br/>TLS (self-signed CA)"]
        MetricsServer["Metrics Server<br/>Port 8080/TCP<br/>TLS encrypted"]
        HealthProbes["Health/Readiness Probes<br/>Port 8081/TCP<br/>HTTP (unauthenticated)"]

        subgraph Reconcilers["Reconcilers"]
            PyTorchReconciler["PyTorchJob<br/>Reconciler"]
            TFReconciler["TFJob<br/>Reconciler"]
            JAXReconciler["JAXJob<br/>Reconciler"]
            MPIReconciler["MPIJob<br/>Reconciler"]
            PaddleReconciler["PaddleJob<br/>Reconciler"]
            XGBoostReconciler["XGBoostJob<br/>Reconciler"]
        end

        Controller --> PyTorchReconciler
        Controller --> TFReconciler
        Controller --> JAXReconciler
        Controller --> MPIReconciler
        Controller --> PaddleReconciler
        Controller --> XGBoostReconciler
        Controller --> WebhookServer
        Controller --> MetricsServer
        Controller --> HealthProbes
    end

    %% CRDs
    User[Data Scientist / User] -->|creates| PyTorchJobCR["PyTorchJob CR<br/>kubeflow.org/v1"]
    User -->|creates| TFJobCR["TFJob CR<br/>kubeflow.org/v1"]
    User -->|creates| JAXJobCR["JAXJob CR<br/>kubeflow.org/v1"]
    User -->|creates| MPIJobCR["MPIJob CR<br/>kubeflow.org/v1"]
    User -->|creates| PaddleJobCR["PaddleJob CR<br/>kubeflow.org/v1"]
    User -->|creates| XGBoostJobCR["XGBoostJob CR<br/>kubeflow.org/v1"]

    %% Webhook validation flow
    PyTorchJobCR -->|validated by| WebhookServer
    TFJobCR -->|validated by| WebhookServer
    JAXJobCR -->|validated by| WebhookServer
    MPIJobCR -->|validated by| WebhookServer
    PaddleJobCR -->|validated by| WebhookServer
    XGBoostJobCR -->|validated by| WebhookServer

    %% Reconciler watches
    PyTorchJobCR -->|watched by| PyTorchReconciler
    TFJobCR -->|watched by| TFReconciler
    JAXJobCR -->|watched by| JAXReconciler
    MPIJobCR -->|watched by| MPIReconciler
    PaddleJobCR -->|watched by| PaddleReconciler
    XGBoostJobCR -->|watched by| XGBoostReconciler

    %% Resources created
    PyTorchReconciler -->|creates| Pods["Pods"]
    PyTorchReconciler -->|creates| Services["Services"]
    PyTorchReconciler -->|manages| HPA["HorizontalPodAutoscaler"]
    MPIReconciler -->|creates| ConfigMaps["ConfigMaps"]
    MPIReconciler -->|creates| Roles["Roles / RoleBindings"]
    MPIReconciler -->|creates| ServiceAccounts["ServiceAccounts"]

    %% External dependencies
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1"]
    Controller -->|uses| K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    MetricsServer -->|scraped by| Prometheus["Prometheus"]

    %% Cert management
    CertController["cert-controller<br/>(OPA)"] -->|generates certs| WebhookSecret["training-operator-webhook-cert<br/>Secret"]
    WebhookSecret -->|loaded by| WebhookServer

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style WebhookServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbes fill:#4a90e2,stroke:#333,color:#fff
    style PyTorchReconciler fill:#5b9bd5,stroke:#333,color:#fff
    style TFReconciler fill:#5b9bd5,stroke:#333,color:#fff
    style JAXReconciler fill:#5b9bd5,stroke:#333,color:#fff
    style MPIReconciler fill:#5b9bd5,stroke:#333,color:#fff
    style PaddleReconciler fill:#5b9bd5,stroke:#333,color:#fff
    style XGBoostReconciler fill:#5b9bd5,stroke:#333,color:#fff
    style PyTorchJobCR fill:#f5a623,stroke:#333
    style TFJobCR fill:#f5a623,stroke:#333
    style JAXJobCR fill:#f5a623,stroke:#333
    style MPIJobCR fill:#f5a623,stroke:#333
    style PaddleJobCR fill:#f5a623,stroke:#333
    style XGBoostJobCR fill:#f5a623,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style CertController fill:#e8e8e8,stroke:#333
