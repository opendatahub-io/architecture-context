graph TB
    subgraph TrainingOperator["Training Operator"]
        direction TB
        Controller["training-operator.v1<br/>Controller Manager<br/>/manager"]
        subgraph Reconcilers["Reconcilers (one per CRD)"]
            PyTorchRec["PyTorchJobReconciler"]
            TFRec["TFJobReconciler"]
            JAXRec["JAXJobReconciler"]
            MPIRec["MPIJobReconciler"]
            XGBoostRec["XGBoostJobReconciler"]
            PaddleRec["PaddleJobReconciler"]
        end
        Webhook["Webhook Server<br/>Port 9443/TLS<br/>failurePolicy: Fail"]
        Metrics["Metrics Server<br/>Port 8080/HTTP<br/>/metrics"]
        Health["Health/Readiness<br/>Port 8081/HTTP<br/>/healthz, /readyz"]
        Controller --> Reconcilers
        Controller --> Webhook
        Controller --> Metrics
        Controller --> Health
    end

    %% CRDs
    User["User / Pipeline"] -->|creates| PyTorchJobCR["PyTorchJob CR"]
    User -->|creates| TFJobCR["TFJob CR"]
    User -->|creates| JAXJobCR["JAXJob CR"]
    User -->|creates| MPIJobCR["MPIJob CR"]
    User -->|creates| XGBoostJobCR["XGBoostJob CR"]
    User -->|creates| PaddleJobCR["PaddleJob CR"]

    %% CRD to Reconciler mapping
    PyTorchJobCR -->|watched by| PyTorchRec
    TFJobCR -->|watched by| TFRec
    JAXJobCR -->|watched by| JAXRec
    MPIJobCR -->|watched by| MPIRec
    XGBoostJobCR -->|watched by| XGBoostRec
    PaddleJobCR -->|watched by| PaddleRec

    %% Webhook validation
    PyTorchJobCR -.->|validated by| Webhook
    TFJobCR -.->|validated by| Webhook
    JAXJobCR -.->|validated by| Webhook
    MPIJobCR -.->|validated by| Webhook
    XGBoostJobCR -.->|validated by| Webhook
    PaddleJobCR -.->|validated by| Webhook

    %% Resources created by reconcilers
    subgraph ManagedResources["Managed Resources"]
        Pods["Worker Pods"]
        Services["Services"]
        SvcAccounts["ServiceAccounts"]
        PodGroups["PodGroups<br/>(gang scheduling)"]
        NetPolicies["NetworkPolicies"]
        HPA["HorizontalPodAutoscaler<br/>(PyTorch elastic only)"]
    end

    Reconcilers -->|creates/manages| Pods
    Reconcilers -->|creates/manages| Services
    Reconcilers -->|creates/manages| SvcAccounts
    Reconcilers -->|creates/manages| PodGroups
    Reconcilers -->|creates/manages| NetPolicies
    PyTorchRec -->|creates/manages| HPA

    %% MPI-specific resources
    subgraph MPIResources["MPI-Specific Resources"]
        ConfigMaps["ConfigMaps<br/>(host-file)"]
        Roles["Roles/RoleBindings<br/>(SSH access)"]
    end
    MPIRec -->|creates/manages| ConfigMaps
    MPIRec -->|creates/manages| Roles

    %% External dependencies
    Controller -->|queries| K8sAPI["Kubernetes API<br/>6443/HTTPS"]
    Controller -->|reads TLS profile| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1"]

    %% Monitoring
    Prometheus["Prometheus"] -->|scrapes| Metrics

    %% Init container
    KubectlDelivery["kubectl-delivery<br/>Init Container"] -.->|copies kubectl to| Pods

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style PyTorchRec fill:#5b9bd5,stroke:#333,color:#fff
    style TFRec fill:#5b9bd5,stroke:#333,color:#fff
    style JAXRec fill:#5b9bd5,stroke:#333,color:#fff
    style MPIRec fill:#5b9bd5,stroke:#333,color:#fff
    style XGBoostRec fill:#5b9bd5,stroke:#333,color:#fff
    style PaddleRec fill:#5b9bd5,stroke:#333,color:#fff
    style PyTorchJobCR fill:#f5a623,stroke:#333
    style TFJobCR fill:#f5a623,stroke:#333
    style JAXJobCR fill:#f5a623,stroke:#333
    style MPIJobCR fill:#f5a623,stroke:#333
    style XGBoostJobCR fill:#f5a623,stroke:#333
    style PaddleJobCR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style KubectlDelivery fill:#c9c9c9,stroke:#333
