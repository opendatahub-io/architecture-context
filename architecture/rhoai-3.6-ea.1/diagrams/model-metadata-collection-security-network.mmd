graph TB
    subgraph BuildTime["BUILD-TIME (CI/CD Only)"]
        direction TB
        Extractor["model-extractor CLI<br/>(not in production image)"]
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (Build-Time)"]
        direction TB
        HF["HuggingFace API<br/>huggingface.co<br/>443/TCP HTTPS TLS<br/>Auth: Bearer HF_TOKEN (optional)"]
        GH["GitHub API<br/>api.github.com<br/>443/TCP HTTPS TLS<br/>Auth: Bearer GITHUB_TOKEN (optional)"]
        Reg["Container Registries<br/>quay.io, etc.<br/>443/TCP HTTPS TLS<br/>Auth: System cred chain"]
    end

    subgraph Runtime["RUNTIME (Production Cluster)"]
        direction TB

        subgraph Pod["model-metadata-collection Pod"]
            Container["Data Container<br/>ubi9-minimal<br/>CMD: sleep infinity<br/>NO ports / NO listeners"]
            DataVol["/app/data<br/>YAML Catalog Files"]
            Container --- DataVol
        end

        Platform["RHOAI Platform Components<br/>(volume mount consumers)"]
    end

    %% Build-time flows (outbound only)
    Extractor -->|"HTTPS/443<br/>TLS<br/>Bearer HF_TOKEN"| HF
    Extractor -->|"HTTPS/443<br/>TLS<br/>Bearer GITHUB_TOKEN"| GH
    Extractor -->|"HTTPS/443<br/>TLS<br/>System creds"| Reg

    %% Runtime flows (filesystem only, no network)
    Platform -->|"Volume Mount<br/>/app/data<br/>Filesystem only<br/>No network traffic"| DataVol

    %% Styling by trust zone
    classDef buildtime fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef dataonly fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef consumer fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Extractor buildtime
    class HF,GH,Reg external
    class Container dataonly
    class DataVol runtime
    class Platform consumer
