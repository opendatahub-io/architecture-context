graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        RESTClient["External REST Client"]
        GRPCClient["gRPC Client"]
    end

    subgraph PlatformLayer["PLATFORM LAYER (KServe / ModelMesh)"]
        KServe["KServe / ModelMesh<br/>Lifecycle, Scaling, Routing<br/>TLS Termination"]
    end

    subgraph AppLayer["APPLICATION LAYER (vllm-cpu container)"]
        direction TB

        subgraph HTTPEntry["HTTP Entrypoint"]
            AuthMW["AuthenticationMiddleware<br/>Bearer Token (opt-in)<br/>SHA-256 constant-time compare"]

            subgraph GuardedPaths["Guarded Paths (/v1, /v2, /inference)"]
                ChatAPI["/v1/chat/completions"]
                CompletionsAPI["/v1/completions"]
                EmbeddingsAPI["/v1/embeddings"]
                RerankAPI["/v1/rerank"]
                ScoreAPI["/v1/score"]
                AudioAPI["/v1/audio/*"]
                MessagesAPI["/v1/messages"]
                LoRAAPI["/v1/load_lora_adapter"]
            end

            subgraph UnguardedPaths["Unguarded Paths (No Auth)"]
                HealthAPI["/health, /ready, /readyz<br/>/load, /ping, /docs"]
            end
        end

        subgraph GRPCEntry["gRPC Entrypoint — Port 50051"]
            GRPCServer["gRPC Server<br/>HTTP/2, Insecure Port<br/>No Built-in Auth"]
            VllmSvc["VllmEngine Service<br/>smg-grpc-servicer"]
            HealthSvc["grpc.health.v1.Health"]
        end

        Engine["AsyncLLM Engine<br/>CPU Inference"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP HTTPS<br/>HF Token (optional)"]
        RHStats["RHOAI Usage Stats<br/>console.redhat.com<br/>443/TCP HTTPS"]
    end

    %% Flows
    RESTClient -->|"HTTP/HTTPS<br/>TLS (platform)<br/>Bearer Token (optional)"| KServe
    GRPCClient -->|"gRPC/50051<br/>HTTP/2<br/>No TLS, No Auth"| GRPCServer

    KServe -->|"HTTP<br/>Platform-managed encryption"| AuthMW

    AuthMW -->|"Authenticated"| GuardedPaths
    AuthMW -->|"Pass-through"| UnguardedPaths

    ChatAPI --> Engine
    CompletionsAPI --> Engine
    EmbeddingsAPI --> Engine
    RerankAPI --> Engine
    ScoreAPI --> Engine
    AudioAPI --> Engine
    MessagesAPI --> Engine
    LoRAAPI --> Engine

    GRPCServer --> VllmSvc
    GRPCServer --> HealthSvc
    VllmSvc --> Engine

    Engine -->|"HTTPS/443<br/>TLS<br/>HF Token"| HFHub
    Engine -->|"HTTPS/443<br/>TLS"| RHStats

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef apphttp fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef appgrpc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef engine fill:#e8744f,stroke:#333,stroke-width:2px,color:#fff
    classDef auth fill:#f5a623,stroke:#333,stroke-width:2px
    classDef externalservice fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef unguarded fill:#d5e8d4,stroke:#82b366,stroke-width:1px
    classDef guarded fill:#ffe6cc,stroke:#d79b00,stroke-width:1px

    class RESTClient,GRPCClient external
    class KServe platform
    class AuthMW auth
    class Engine engine
    class GRPCServer,VllmSvc,HealthSvc appgrpc
    class HFHub,RHStats externalservice
    class HealthAPI unguarded
    class ChatAPI,CompletionsAPI,EmbeddingsAPI,RerankAPI,ScoreAPI,AudioAPI,MessagesAPI,LoRAAPI guarded
