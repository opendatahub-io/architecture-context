graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Application"]
    end

    subgraph AppLayer["APPLICATION LAYER (vllm-cpu)"]
        direction TB

        subgraph Server["FastAPI/ASGI Server<br/>UBI9 | Python 3.10+"]
            direction TB

            AuthMW["AuthenticationMiddleware<br/>Bearer Token (conditional)<br/>SHA-256 + secrets.compare_digest<br/>Guards: /v1/*, /v2/*, /inference/*"]

            subgraph Guarded["GUARDED ENDPOINTS (auth when configured)"]
                direction LR
                OpenAI["/v1/chat/completions<br/>/v1/completions<br/>/v1/embeddings<br/>/v1/models"]
                AnthropicAPI["/v1/messages"]
                PoolScore["/v1/score, /v1/rerank<br/>/v2/embed, /v2/rerank"]
                LoRAMgmt["/v1/load_lora_adapter<br/>/v1/unload_lora_adapter"]
            end

            subgraph Unguarded["UNGUARDED ENDPOINTS (always open)"]
                direction LR
                HealthProbes["/health, /ready<br/>/readyz, /load"]
                OpEndpoints["/docs, /version<br/>/ping"]
            end
        end

        Engine["vLLM Engine<br/>LLM Inference Core"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS TLS<br/>Auth: AWS IAM Credentials"]
        HFHub["HuggingFace Hub<br/>443/TCP HTTPS TLS<br/>Auth: Optional HF Token"]
    end

    subgraph K8sLayer["KUBERNETES PLATFORM"]
        K8sProbes["Kubelet<br/>Liveness/Readiness Probes"]
    end

    %% External flows
    Client -->|"HTTP/HTTPS<br/>Bearer Token (conditional)"| AuthMW
    AuthMW -->|"Authenticated"| OpenAI
    AuthMW -->|"Authenticated"| AnthropicAPI
    AuthMW -->|"Authenticated"| PoolScore
    AuthMW -->|"Authenticated"| LoRAMgmt
    Client -->|"HTTP/HTTPS<br/>No Auth Required"| HealthProbes
    Client -->|"HTTP/HTTPS<br/>No Auth Required"| OpEndpoints

    %% Internal flows
    OpenAI --> Engine
    AnthropicAPI --> Engine
    PoolScore --> Engine

    %% Egress flows
    Engine -->|"HTTPS/443<br/>TLS<br/>AWS Credentials"| S3
    Engine -->|"HTTPS/443<br/>TLS<br/>Optional HF Token"| HFHub

    %% K8s probes
    K8sProbes -->|"HTTP<br/>No Auth"| HealthProbes

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appserver fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef authmw fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef guarded fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef unguarded fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef engine fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef extsvc fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef k8s fill:#f5f5f5,stroke:#666,stroke-width:1px

    class Client external
    class AuthMW authmw
    class OpenAI,AnthropicAPI,PoolScore,LoRAMgmt guarded
    class HealthProbes,OpEndpoints unguarded
    class Engine engine
    class S3,HFHub extsvc
    class K8sProbes k8s
