graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["openshell<br/>(ServiceAccount)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_NodeReader["openshell-node-reader<br/>(ClusterRoleBinding)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Sandbox["openshell-sandbox<br/>(RoleBinding)<br/>Namespace: release-ns"]
        RB_Creds["openshell-credential-secrets<br/>(RoleBinding)<br/>Namespace: configured-ns"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_NodeReader["openshell-node-reader<br/>(ClusterRole)"]
    end

    subgraph Roles["Roles"]
        R_Sandbox["openshell-sandbox<br/>(Role)"]
        R_Creds["openshell-credential-secrets<br/>(Role)"]
    end

    subgraph APIResources_Cluster["Cluster-Scoped API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        Nodes["core ('')<br/>nodes"]
        Namespaces["core ('')<br/>namespaces"]
    end

    subgraph APIResources_NS["Namespace-Scoped API Resources"]
        SandboxResources["Sandbox Pod<br/>Resources"]
        SecretResources["Credential<br/>Secrets"]
    end

    %% Service Account bindings
    SA -->|"bound via"| CRB_NodeReader
    SA -->|"bound via"| RB_Sandbox
    SA -->|"bound via"| RB_Creds

    %% ClusterRoleBinding to ClusterRole
    CRB_NodeReader -->|"grants"| CR_NodeReader

    %% RoleBindings to Roles
    RB_Sandbox -->|"grants"| R_Sandbox
    RB_Creds -->|"grants"| R_Creds

    %% ClusterRole permissions
    CR_NodeReader -->|"create"| TokenReviews
    CR_NodeReader -->|"get, list, watch"| Nodes
    CR_NodeReader -->|"get"| Namespaces

    %% Role permissions
    R_Sandbox -->|"sandbox pod management"| SandboxResources
    R_Creds -->|"credential secret access"| SecretResources

    subgraph AppLevelAuthZ["Application-Level Authorization"]
        DescPool["Descriptor Pool<br/>(Proto Options)"]
        AuthModes["Auth Modes:<br/>OIDC JWT | mTLS | Sandbox JWT"]
        WorkspaceRoles["Workspace Roles:<br/>owner | member | viewer"]
        Scopes["Scopes:<br/>workspace | platform | sandbox"]
        RpcAuthz["#[rpc_authz] Macro<br/>Per-RPC enforcement"]

        DescPool -->|"defines"| AuthModes
        DescPool -->|"defines"| WorkspaceRoles
        DescPool -->|"defines"| Scopes
        RpcAuthz -->|"generates metadata for"| DescPool
    end

    subgraph SandboxAuth["Sandbox Egress Authorization"]
        BinaryID["Binary Identity<br/>/proc/pid/exe"]
        OPAPolicy["OPA Policy Engine<br/>Per-binary, per-host rules"]
        L7Inspect["L7 Inspection<br/>REST, GraphQL, SQL,<br/>JSON-RPC, WebSocket"]
        Z3Prover["Z3 SMT Prover<br/>Exfiltration path detection"]

        BinaryID -->|"identifies process"| OPAPolicy
        OPAPolicy -->|"optional"| L7Inspect
        Z3Prover -->|"verifies before deploy"| OPAPolicy
    end

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_NodeReader fill:#f5a623,stroke:#333
    style R_Sandbox fill:#f5a623,stroke:#333
    style R_Creds fill:#f5a623,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style Nodes fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style SandboxResources fill:#7ed321,stroke:#333
    style SecretResources fill:#7ed321,stroke:#333
    style CRB_NodeReader fill:#e8e8e8,stroke:#333
    style RB_Sandbox fill:#e8e8e8,stroke:#333
    style RB_Creds fill:#e8e8e8,stroke:#333
    style DescPool fill:#9b59b6,stroke:#333,color:#fff
    style RpcAuthz fill:#9b59b6,stroke:#333,color:#fff
    style OPAPolicy fill:#e74c3c,stroke:#333,color:#fff
    style Z3Prover fill:#e74c3c,stroke:#333,color:#fff
