graph LR
    MLflow["MLflow Tracking Server<br/>(Port 5000)"]

    %% Runtime Framework Dependencies
    MLflow -->|"ASGI/WSGI server"| Gunicorn["gunicorn <27"]
    MLflow -->|"ASGI server"| Uvicorn["uvicorn <1"]
    MLflow -->|"async framework"| FastAPI["fastapi <1"]
    MLflow -->|"web framework"| Flask["flask <4"]
    MLflow -->|"ASGI framework"| Starlette["starlette <2"]

    %% Authentication & Security
    MLflow -->|"K8s auth plugin"| KubePlugins["mlflow-kubernetes-plugins<br/>v1.5.0"]
    MLflow -->|"TLS/crypto"| Cryptography["cryptography<br/>>=43.0.0, <49"]
    MLflow -->|"rate limiting"| SlowAPI["slowapi <1"]

    %% Storage & Data Dependencies
    MLflow -->|"SQL ORM"| SQLAlchemy["sqlalchemy<br/>>=1.4.0, <3"]
    MLflow -->|"PostgreSQL driver"| Psycopg2["psycopg2-binary"]
    MLflow -->|"DB migrations"| Alembic["alembic <2"]
    MLflow -->|"S3 storage"| Boto3["boto3 >1"]
    MLflow -->|"GCS storage"| GCSClient["google-cloud-storage<br/>>=1.30.0"]

    %% Internal Platform Dependencies
    MLflow -->|"K8s API client"| K8sClient["kubernetes<br/>(Python client)"]

    %% Observability
    MLflow -->|"tracing"| OTelAPI["opentelemetry-api<br/>>=1.9.0, <3"]
    MLflow -->|"tracing SDK"| OTelSDK["opentelemetry-sdk<br/>>=1.9.0, <3"]
    MLflow -->|"metrics"| PromExporter["prometheus-flask-exporter"]

    %% ML/Data Libraries
    MLflow -->|"data processing"| NumPy["numpy <3"]
    MLflow -->|"data frames"| Pandas["pandas <3"]
    MLflow -->|"serialization"| Protobuf["protobuf<br/>>=3.12.0, <8"]
    MLflow -->|"ML models"| ScikitLearn["scikit-learn <2"]

    %% Styling - Main component
    style MLflow fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Framework deps
    style Gunicorn fill:#7ed321,stroke:#333
    style Uvicorn fill:#7ed321,stroke:#333
    style FastAPI fill:#7ed321,stroke:#333
    style Flask fill:#7ed321,stroke:#333
    style Starlette fill:#7ed321,stroke:#333

    %% Auth & Security deps
    style KubePlugins fill:#e74c3c,stroke:#333,color:#fff
    style Cryptography fill:#e74c3c,stroke:#333,color:#fff
    style SlowAPI fill:#e74c3c,stroke:#333,color:#fff

    %% Storage deps
    style SQLAlchemy fill:#f5a623,stroke:#333
    style Psycopg2 fill:#f5a623,stroke:#333
    style Alembic fill:#f5a623,stroke:#333
    style Boto3 fill:#f5a623,stroke:#333
    style GCSClient fill:#f5a623,stroke:#333

    %% Platform deps
    style K8sClient fill:#438dd5,stroke:#333,color:#fff

    %% Observability deps
    style OTelAPI fill:#9b59b6,stroke:#333,color:#fff
    style OTelSDK fill:#9b59b6,stroke:#333,color:#fff
    style PromExporter fill:#9b59b6,stroke:#333,color:#fff

    %% ML/Data deps
    style NumPy fill:#999,stroke:#333
    style Pandas fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style ScikitLearn fill:#999,stroke:#333
