graph LR
    MLflow["MLflow Tracking Server<br/>(RHOAI)"]

    %% Runtime Framework Dependencies
    MLflow -->|"WSGI server"| Gunicorn["gunicorn <27"]
    MLflow -->|"ASGI server"| Uvicorn["uvicorn <1"]
    MLflow -->|"web framework"| Flask["Flask <4"]
    MLflow -->|"async framework"| FastAPI["FastAPI <1"]
    MLflow -->|"ASGI toolkit"| Starlette["starlette <2"]

    %% Authentication & Security
    MLflow -->|"auth plugin"| K8sAuth["mlflow-kubernetes-plugins<br/>1.5.0"]
    MLflow -->|"crypto/TLS"| Cryptography["cryptography<br/>>=43.0.0,<49"]

    %% Internal Platform Dependencies
    MLflow -->|"workspace store<br/>auth delegation<br/>job execution"| K8sAPI["Kubernetes API"]
    K8sAuth -->|"validates credentials"| K8sAPI

    %% Data Storage Dependencies
    MLflow -->|"metadata store"| SQLAlchemy["SQLAlchemy <3"]
    MLflow -->|"DB migrations"| Alembic["alembic <2"]

    %% Cloud Storage Backends (Artifact Storage)
    MLflow -->|"S3 artifacts"| Boto3["boto3 >1<br/>(AWS S3)"]
    MLflow -->|"GCS artifacts"| GCS["google-cloud-storage<br/>>=1.30.0"]
    MLflow -->|"Azure artifacts"| AzureBlob["azure-storage-blob<br/>>=12"]
    MLflow -->|"Azure auth"| AzureIdentity["azure-identity<br/>>=1.6.1"]

    %% Observability
    MLflow -->|"tracing"| OTelAPI["opentelemetry-api<br/><3,>=1.9.0"]
    MLflow -->|"tracing SDK"| OTelSDK["opentelemetry-sdk<br/><3,>=1.9.0"]
    MLflow -->|"metrics"| Prometheus["prometheus-flask-exporter"]

    %% External API Integrations (conditionally active)
    MLflow -.->|"AI gateway<br/>(disabled)"| OpenAI["api.openai.com<br/>443/TCP"]

    %% ML/Data Libraries
    MLflow -->|"data processing"| Pandas["pandas <3"]
    MLflow -->|"numerical"| NumPy["numpy <3"]
    MLflow -->|"serialization"| Protobuf["protobuf <8"]
    MLflow -->|"HTTP client"| Requests["requests <3"]
    MLflow -->|"async HTTP"| Aiohttp["aiohttp <4"]

    %% Styling
    style MLflow fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style Gunicorn fill:#5dade2,stroke:#333
    style Uvicorn fill:#5dade2,stroke:#333
    style Flask fill:#5dade2,stroke:#333
    style FastAPI fill:#5dade2,stroke:#333
    style Starlette fill:#5dade2,stroke:#333

    style K8sAuth fill:#e74c3c,stroke:#333,color:#fff
    style Cryptography fill:#e74c3c,stroke:#333,color:#fff

    style K8sAPI fill:#7ed321,stroke:#333

    style SQLAlchemy fill:#9b59b6,stroke:#333,color:#fff
    style Alembic fill:#9b59b6,stroke:#333,color:#fff

    style Boto3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333
    style AzureBlob fill:#f5a623,stroke:#333
    style AzureIdentity fill:#f5a623,stroke:#333

    style OTelAPI fill:#1abc9c,stroke:#333
    style OTelSDK fill:#1abc9c,stroke:#333
    style Prometheus fill:#1abc9c,stroke:#333

    style OpenAI fill:#bdc3c7,stroke:#999,stroke-dasharray: 5 5

    style Pandas fill:#999,stroke:#333
    style NumPy fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style Requests fill:#999,stroke:#333
    style Aiohttp fill:#999,stroke:#333
