graph TB
    subgraph "distributed-workloads Repository"
        direction TB

        subgraph RuntimeImages["Runtime Training Images"]
            RT_CUDA["py312-cuda130-torch210-openmpi41<br/>(CUDA + OpenMPI)"]
            RT_ROCm["py312-rocm64-torch29-openmpi41<br/>(ROCm + OpenMPI)"]
        end

        subgraph UniversalImages["Universal Training Images"]
            UT_CPU["th-torch-cpu-py312<br/>(CPU only)"]
            UT_CUDA_New["th-torch-cuda-py312<br/>(CUDA)"]
            UT_ROCm_New["th-torch-rocm-py312<br/>(ROCm)"]
            UT_CPU_TH06["th06-cpu-torch210-py312<br/>(CPU, TH 0.6)"]
            UT_CUDA_TH06["th06-cuda130-torch210-py312<br/>(CUDA, TH 0.6)"]
            UT_ROCm_TH06["th06-rocm64-torch291-py312<br/>(ROCm, TH 0.6)"]
        end

        subgraph DualEntrypoint["Dual-Mode Entrypoint"]
            EP["entrypoint-universal.sh"]
            EP -->|NOTEBOOK_ARGS set| Jupyter["Jupyter Notebook<br/>(start-notebook.sh)"]
            EP -->|Entrypoint overridden| Headless["Headless Training<br/>(controller-provided cmd)"]
        end

        subgraph TestInfra["Go Integration Tests"]
            Tests["tests/<br/>Go test suite"]
        end

        subgraph ExampleManifests["Example Manifests"]
            SD["Stable Diffusion<br/>Dreambooth"]
            HPO["HPO with<br/>Ray Tune"]
            MinIO_Ex["MinIO Setup"]
            NFS_Ex["NFS Server"]
        end
    end

    subgraph BaseImages["Base Images"]
        AIPCC["AIPCC Base Images<br/>(CUDA, Python, UBI9)"]
        ODH_WB["ODH Workbench<br/>Jupyter Minimal"]
    end

    AIPCC -->|FROM| RT_CUDA
    AIPCC -->|FROM| RT_ROCm
    ODH_WB -->|FROM| UT_CPU
    ODH_WB -->|FROM| UT_CUDA_New
    ODH_WB -->|FROM| UT_ROCm_New
    ODH_WB -->|FROM| UT_CPU_TH06
    ODH_WB -->|FROM| UT_CUDA_TH06
    ODH_WB -->|FROM| UT_ROCm_TH06

    UT_CPU --> DualEntrypoint
    UT_CUDA_New --> DualEntrypoint
    UT_ROCm_New --> DualEntrypoint

    subgraph Consumers["Platform Operators (Consumers)"]
        KTO["Kubeflow Training<br/>Operator"]
        KTV2["Kubeflow Trainer V2"]
        KubeRay["KubeRay"]
        Kueue["Kueue"]
        WBC["Workbench Controller"]
    end

    RT_CUDA -->|consumed by| KTO
    RT_CUDA -->|consumed by| KTV2
    UT_CPU -->|consumed by| KubeRay
    UT_CPU -->|consumed by| WBC

    Tests -->|exercises| KTO
    Tests -->|exercises| KTV2
    Tests -->|exercises| KubeRay
    Tests -->|exercises| Kueue

    style RuntimeImages fill:#4a90e2,stroke:#333,color:#fff
    style UniversalImages fill:#7ed321,stroke:#333,color:#fff
    style DualEntrypoint fill:#f5a623,stroke:#333
    style TestInfra fill:#9b59b6,stroke:#333,color:#fff
    style ExampleManifests fill:#e8e8e8,stroke:#999
    style BaseImages fill:#999,stroke:#333,color:#fff
    style Consumers fill:#e74c3c,stroke:#333,color:#fff
