graph TB
    subgraph "distributed-workloads Component"
        direction TB

        subgraph RuntimeImages["Runtime Training Images (OpenMPI)"]
            CUDA_RT["py312-cuda130-torch210-openmpi41<br/>NVIDIA CUDA 13.0"]
            ROCm_RT["py312-rocm64-torch29-openmpi41<br/>AMD ROCm 6.4"]
        end

        subgraph UniversalImages["Universal Training Hub Images"]
            CUDA_UNI["th-torch-cuda-py312<br/>NVIDIA CUDA"]
            CPU_UNI["th-torch-cpu-py312<br/>CPU-only"]
            ROCm_UNI["th-torch-rocm-py312<br/>AMD ROCm"]
        end

        subgraph DualMode["Universal Image Dual-Mode"]
            EntryPoint["entrypoint-universal.sh"]
            EntryPoint -->|"NOTEBOOK_ARGS set"| WorkbenchMode["Jupyter Workbench<br/>start-notebook.sh"]
            EntryPoint -->|"No NOTEBOOK_ARGS"| TrainingMode["Headless Training<br/>Controller-provided CMD"]
        end

        subgraph ExampleWorkloads["Example Workloads"]
            StableDiff["Stable Diffusion<br/>Fine-tuning"]
            HPO["HPO with Ray Tune"]
            Benchmarks["Benchmarks"]
        end

        subgraph ExampleInfra["Example Infrastructure"]
            MinIO["MinIO<br/>S3-compatible storage"]
            NFS["NFS Server<br/>Shared volumes"]
        end

        subgraph TestSuite["E2E Test Suite (Go)"]
            TrainerTests["Trainer Tests"]
            RuntimeUtils["Runtime Utils<br/>ClusterTrainingRuntime validation"]
        end
    end

    %% Platform Integration (indirect)
    User[Data Scientist] -->|"submits"| TrainJob["TrainJob CR"]
    TrainJob -->|"references"| CTR["ClusterTrainingRuntime"]
    CTR -->|"resolves to"| RuntimeImages
    CTR -->|"resolves to"| UniversalImages

    %% Platform Components
    TrainerCtrl["Kubeflow Trainer Controller"] -->|"registers images as"| CTR
    TrainerCtrl -->|"creates pods from"| RuntimeImages
    TrainerCtrl -->|"creates pods from"| UniversalImages
    Kueue["Kueue"] -->|"admission control"| TrainJob
    KubeRay["KubeRay"] -->|"cluster mgmt"| HPO

    %% Base Images
    AIPCC["AIPCC Base Image<br/>cuda-13.0-el9.6"] -->|"base layer"| CUDA_RT
    AIPCC -->|"base layer"| CUDA_UNI
    UBI9["UBI9 Workbench Base"] -->|"base layer"| CPU_UNI

    %% Test validation
    TestSuite -->|"validates"| CTR

    style RuntimeImages fill:#4a90e2,stroke:#333
    style UniversalImages fill:#4a90e2,stroke:#333
    style DualMode fill:#d5e8d4,stroke:#82b366
    style ExampleWorkloads fill:#fff2cc,stroke:#d6b656
    style ExampleInfra fill:#fff2cc,stroke:#d6b656
    style TestSuite fill:#e8d5f5,stroke:#9673a6
    style TrainJob fill:#f5a623,stroke:#333
    style CTR fill:#f5a623,stroke:#333
    style TrainerCtrl fill:#7ed321,stroke:#333
    style Kueue fill:#7ed321,stroke:#333
    style KubeRay fill:#7ed321,stroke:#333
    style AIPCC fill:#e8e8e8,stroke:#333
    style UBI9 fill:#e8e8e8,stroke:#333
