graph TD
    subgraph "Job Pod Identity"
        SA["ServiceAccount<br/>(Job-specific SA)"]
    end

    subgraph "Credential Sources"
        direction TB
        EnvVars["Environment Variables<br/>(injected via envFrom)"]
        MountedFiles["Mounted Secret Files"]
        EvalHubSecrets["eval-hub Secret Storage"]
        DataConnection["Data Connection Secrets<br/>(OpenShift AI)"]
    end

    subgraph "Credentials Used"
        direction TB
        APIKey["API_KEY<br/>(model endpoint auth)"]
        OAIKey["OPENAICOMPATIBLE_API_KEY<br/>(fallback model auth)"]
        KFPToken["KFP_AUTH_TOKEN<br/>(Kubeflow Pipelines bearer)"]
        AWSCreds["AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY<br/>(S3 storage)"]
    end

    subgraph "Credential Resolution Chain"
        direction TB
        Step1["1. Model-specific env var"]
        Step2["2. Mounted secret file"]
        Step3["3. eval-hub secret storage"]
        Step4["4. Generic API_KEY env var"]
        Step5["5. OPENAICOMPATIBLE_API_KEY"]
        Step1 --> Step2
        Step2 --> Step3
        Step3 --> Step4
        Step4 --> Step5
    end

    subgraph "Target Services"
        ModelEndpoint["Target Model Endpoint<br/>(HTTPS)"]
        S3Storage["S3-Compatible Storage<br/>(HTTPS)"]
        KFPServer["Kubeflow Pipelines<br/>(HTTPS)"]
        K8sAPI["Kubernetes API<br/>(HTTPS)"]
    end

    subgraph "KFP Pipeline Pod Credentials"
        KFPSecretEnv["kubernetes.use_secret_as_env<br/>(Data Connection → pipeline pods)"]
    end

    SA -->|"pod identity"| EnvVars
    SA -->|"pod identity"| MountedFiles
    SA -->|"in-cluster auth"| K8sAPI

    EnvVars -->|"provides"| APIKey
    EnvVars -->|"provides"| OAIKey
    EnvVars -->|"provides"| KFPToken
    EnvVars -->|"provides (envFrom)"| AWSCreds

    APIKey -->|"Bearer token"| ModelEndpoint
    OAIKey -->|"Bearer token (fallback)"| ModelEndpoint
    KFPToken -->|"Bearer token"| KFPServer
    AWSCreds -->|"AWS SigV4"| S3Storage

    DataConnection -->|"injected via"| KFPSecretEnv
    KFPSecretEnv -->|"S3 creds in pipeline pods"| S3Storage

    Note["NOTE: No ClusterRoles or<br/>ClusterRoleBindings defined.<br/>Relies on namespace-scoped<br/>permissions for the Job SA.<br/><br/>API keys are REDACTED before<br/>persisting configs to S3."]

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style APIKey fill:#f5a623,stroke:#333
    style OAIKey fill:#f5a623,stroke:#333
    style KFPToken fill:#f5a623,stroke:#333
    style AWSCreds fill:#f5a623,stroke:#333
    style ModelEndpoint fill:#e8e8e8,stroke:#333
    style S3Storage fill:#e8e8e8,stroke:#333
    style KFPServer fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Note fill:#fff3cd,stroke:#856404,stroke-dasharray: 5 5
    style KFPSecretEnv fill:#d5e8d4,stroke:#82b366
    style DataConnection fill:#d5e8d4,stroke:#82b366
    style Step1 fill:#dae8fc,stroke:#6c8ebf
    style Step2 fill:#dae8fc,stroke:#6c8ebf
    style Step3 fill:#dae8fc,stroke:#6c8ebf
    style Step4 fill:#dae8fc,stroke:#6c8ebf
    style Step5 fill:#dae8fc,stroke:#6c8ebf
