graph TD
    subgraph "Service Account"
        SA["Job ServiceAccount<br/>(namespace-scoped)"]
    end

    subgraph "Implicit RBAC Requirements"
        direction TB
        Note["No explicit ClusterRoles or RoleBindings<br/>defined in component manifests"]
    end

    subgraph "Required Permissions (Implicit)"
        SecretRead["core/v1<br/>Secrets<br/>Verbs: get"]
    end

    subgraph "Credential Access Patterns"
        direction TB
        SATokenMount["SA Token Mount<br/>/var/run/secrets/kubernetes.io/<br/>serviceaccount/token"]
        KFPSecretMount["KFP Secret Mount<br/>/mnt/model-auth/"]
        EvalHubSecretMount["Eval-Hub Secret Mount<br/>/var/run/secrets/model/"]
        EnvVarSecrets["Environment Variable Secrets<br/>API_KEY<br/>KFP_AUTH_TOKEN<br/>OPENAICOMPATIBLE_API_KEY<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
    end

    subgraph "External Authentication Targets"
        KFPAuth["Kubeflow Pipelines API<br/>Auth: Bearer SA Token"]
        K8sAuth["Kubernetes API Server<br/>Auth: SA Token<br/>Purpose: Read AWS Secrets"]
        S3Auth["S3-Compatible Storage<br/>Auth: AWS IAM (boto3)"]
        LLMAuth["Target LLM Endpoint<br/>Auth: Model API Key"]
    end

    SA -->|"automounted or<br/>sidecar-injected"| SATokenMount
    SA -->|"volume mount"| KFPSecretMount
    SA -->|"volume mount"| EvalHubSecretMount
    SA -->|"pod spec"| EnvVarSecrets
    SA -.->|"needs"| SecretRead

    SATokenMount -->|"Bearer token"| KFPAuth
    SATokenMount -->|"SA token"| K8sAuth
    K8sAuth -->|"reads secret"| SecretRead
    SecretRead -->|"AWS creds"| S3Auth
    EnvVarSecrets -->|"AWS creds (direct)"| S3Auth
    EnvVarSecrets -->|"API key"| LLMAuth
    KFPSecretMount -->|"model key"| LLMAuth
    EvalHubSecretMount -->|"model key"| LLMAuth

    style SA fill:#4a90e2
    style SecretRead fill:#f5a623
    style Note fill:#fff,stroke:#ccc,stroke-dasharray: 5 5
    style SATokenMount fill:#ffe6cc,stroke:#d79b00
    style KFPSecretMount fill:#ffe6cc,stroke:#d79b00
    style EvalHubSecretMount fill:#ffe6cc,stroke:#d79b00
    style EnvVarSecrets fill:#ffe6cc,stroke:#d79b00
    style KFPAuth fill:#d5e8d4,stroke:#82b366
    style K8sAuth fill:#d5e8d4,stroke:#82b366
    style S3Auth fill:#f9f9f9,stroke:#999
    style LLMAuth fill:#f9f9f9,stroke:#999
