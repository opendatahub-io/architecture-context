graph TD
    subgraph "Operator Service Account"
        SA["ai-gateway-payload-processing<br/>ServiceAccount"]
    end

    subgraph "Authentication Configuration"
        direction TB
        AuthConfig["ExternalProvider CR<br/>Auth Type Selection"]
        APIKey["apikey<br/>(API Key header injection)"]
        SigV4["sigv4<br/>(AWS Signature V4)"]
        OAuth2Auth["oauth2<br/>(OAuth2 token exchange)"]
        AuthConfig --> APIKey
        AuthConfig --> SigV4
        AuthConfig --> OAuth2Auth
    end

    subgraph "Kubernetes API Resources Managed"
        direction TB

        subgraph "Core API (v1)"
            Services["Services<br/>(ExternalName)"]
            Secrets["Secrets<br/>(credential validation)"]
        end

        subgraph "inference.opendatahub.io/v1alpha1"
            ExternalProvider["ExternalProvider<br/>(watch, CRUD, status)"]
            ExternalModel["ExternalModel<br/>(watch, CRUD, status)"]
        end

        subgraph "gateway.networking.k8s.io/v1"
            HTTPRoute["HTTPRoute<br/>(watch, CRUD)"]
        end

        subgraph "networking.istio.io/v1"
            ServiceEntry["ServiceEntry<br/>(CRUD)"]
            DestinationRule["DestinationRule<br/>(CRUD)"]
        end

        subgraph "maas.opendatahub.io (Legacy)"
            LegacyEM["ExternalModel<br/>(watch - conditional)"]
        end
    end

    subgraph "Credential Secrets"
        direction TB
        OpenAICreds["openai-credentials<br/>(Opaque)"]
        AnthropicCreds["anthropic-credentials<br/>(Opaque)"]
        AzureCreds["azure-credentials<br/>(Opaque)"]
        VertexCreds["vertex-credentials<br/>(Opaque)"]
    end

    %% Operator access
    SA -->|"get, list, watch, create,<br/>update, patch, delete"| ExternalProvider
    SA -->|"get, list, watch, create,<br/>update, patch, delete"| ExternalModel
    SA -->|"get, create, update"| Services
    SA -->|"get (validate)"| Secrets
    SA -->|"get, create, update"| HTTPRoute
    SA -->|"create, update"| ServiceEntry
    SA -->|"create, update"| DestinationRule
    SA -.->|"watch (if CRD exists)"| LegacyEM

    %% Auth references secrets
    APIKey -->|references| OpenAICreds
    APIKey -->|references| AnthropicCreds
    SigV4 -->|references| AzureCreds
    OAuth2Auth -->|references| VertexCreds

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style AuthConfig fill:#9b59b6,color:#fff
    style APIKey fill:#af7ac5,color:#fff
    style SigV4 fill:#af7ac5,color:#fff
    style OAuth2Auth fill:#af7ac5,color:#fff
    style ExternalProvider fill:#f5a623,color:#fff
    style ExternalModel fill:#f5a623,color:#fff
    style Services fill:#7ed321,color:#fff
    style Secrets fill:#e74c3c,color:#fff
    style HTTPRoute fill:#7ed321,color:#fff
    style ServiceEntry fill:#7ed321,color:#fff
    style DestinationRule fill:#7ed321,color:#fff
    style LegacyEM fill:#bdc3c7,color:#333
    style OpenAICreds fill:#f8cecc,stroke:#b85450
    style AnthropicCreds fill:#f8cecc,stroke:#b85450
    style AzureCreds fill:#f8cecc,stroke:#b85450
    style VertexCreds fill:#f8cecc,stroke:#b85450
