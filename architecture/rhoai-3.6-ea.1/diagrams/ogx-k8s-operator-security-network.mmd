graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Platform Component"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>RBAC Enforced"]
    end

    subgraph AdmissionControl["ADMISSION CONTROL"]
        Webhook["Validating Webhook<br/>vogxserver.kb.io<br/>9443/TCP TLS<br/>failurePolicy: Fail<br/>CREATE, UPDATE on ogxservers"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (ogx-k8s-operator-system)"]
        direction TB

        subgraph InnerTier["Inner Tier"]
            Manager["ogx-k8s-operator-controller-manager<br/>SA: ogx-k8s-operator-controller-manager<br/>Image: controller:latest"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
            MetricsSvc["Metrics Service<br/>8443/TCP HTTPS<br/>TokenReview + SAR Auth"]
            WebhookSvc["Webhook Service<br/>443→9443/TCP HTTPS<br/>Cert: ogx-k8s-operator-webhook-cert"]
        end

        subgraph OuterTier["Outer Tier"]
            OGXModule["ogx-module Controller<br/>SA: operator<br/>Kustomize manifest rendering"]
        end

        Manager --- HealthProbes
        Manager --- MetricsSvc
        Manager --- WebhookSvc
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        PrometheusOp["prometheus-operator<br/>ServiceMonitors, PrometheusRules<br/>CRD CRUD"]
        OpenShiftAPI["OpenShift API Server<br/>config.openshift.io<br/>TLS Profile Config"]
    end

    subgraph ManagedResources["MANAGED RESOURCES"]
        ChildResources["Deployments, Services, ConfigMaps<br/>HPAs, PDBs, NetworkPolicies<br/>Ingresses, PVCs"]
        RBACResources["ClusterRoles, ClusterRoleBindings<br/>Roles, RoleBindings<br/>ValidatingWebhookConfigurations"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI

    %% Admission flow
    K8sAPI -->|"HTTPS/9443<br/>TLS (webhook cert)<br/>Admission Review"| Webhook
    Webhook -.->|"Allowed/Denied"| K8sAPI

    %% Inner tier flows
    K8sAPI -->|"Watch events<br/>TLS 1.2+"| Manager
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    Manager -->|"CRUD via K8s API"| ChildResources
    Manager -->|"CRUD via K8s API"| PrometheusOp

    %% Outer tier flows
    K8sAPI -->|"Watch OGX CR events<br/>TLS 1.2+"| OGXModule
    OGXModule -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    OGXModule -->|"CRUD via K8s API"| RBACResources

    %% Platform config
    Manager -.->|"GET apiservers<br/>TLS Profile"| OpenShiftAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef admission fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Webhook admission
    class Manager,OGXModule,HealthProbes,MetricsSvc,WebhookSvc operator
    class PrometheusOp,OpenShiftAPI platform
    class ChildResources,RBACResources managed
