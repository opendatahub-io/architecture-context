graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>OpenAI-compatible API"]
    end

    subgraph Ingress["INGRESS (Route)"]
        Route["OpenShift Route<br/>${PROJECT_NAME}-route<br/>HTTPS / TLS termination"]
    end

    subgraph ClusterNetwork["CLUSTER NETWORK (Internal)"]
        direction TB

        Service["ClusterIP Service<br/>${PROJECT_NAME}-service<br/>8080/TCP → 8080"]

        subgraph Pod["Pod (Sidecar Pattern)"]
            direction TB
            Sidecar["llm-d-routing-sidecar<br/>Listen: 8000/TCP<br/>TLS 1.2+ (ECDHE)<br/>Certs: operator or self-signed RSA-4096<br/>SSRF: InferencePool allowlist"]
            Decoder["vLLM Decoder (co-located)<br/>localhost:8001/TCP<br/>Optional TLS 1.2+"]
        end

        subgraph RemotePods["Remote Pods (Pool Members)"]
            Prefiller1["vLLM Prefiller Pod<br/>Dynamic port<br/>Optional TLS 1.2+"]
            Prefiller2["vLLM Prefiller Pod<br/>Dynamic port<br/>Optional TLS 1.2+"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>ServiceAccount auth"]
        InferencePool["InferencePool CR<br/>inference.networking<br/>.x-k8s.io/v1alpha2"]
    end

    %% External → Ingress
    Client -->|"HTTPS<br/>TLS termination<br/>No app-level auth"| Route

    %% Ingress → Service
    Route -->|"8080/TCP<br/>Internal"| Service

    %% Service → Pod
    Service -->|"8080/TCP<br/>ClusterIP"| Sidecar

    %% Sidecar → Decoder (localhost)
    Sidecar -->|"HTTP/HTTPS 8001/TCP<br/>localhost<br/>Optional TLS 1.2+<br/>No auth"| Decoder

    %% Sidecar → Remote Prefillers
    Sidecar -->|"HTTP/HTTPS Dynamic port<br/>Optional TLS 1.2+<br/>SSRF-validated<br/>NIXL v2 protocol"| Prefiller1
    Sidecar -->|"HTTP/HTTPS Dynamic port<br/>Optional TLS 1.2+<br/>SSRF-validated<br/>NIXL v2 protocol"| Prefiller2

    %% Sidecar → K8s API (allowlist maintenance)
    Sidecar -->|"HTTPS/WSS 6443/TCP<br/>TLS 1.2+<br/>ServiceAccount<br/>Watch InferencePool + Pods"| K8sAPI

    %% K8s API → InferencePool
    K8sAPI -.->|"Informer"| InferencePool

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef sidecar fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef decoder fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef prefiller fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controlplane fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class Service service
    class Sidecar sidecar
    class Decoder decoder
    class Prefiller1,Prefiller2 prefiller
    class K8sAPI,InferencePool controlplane
