graph LR
    LlmD["llm-d<br/>Reference Architecture"]

    %% Internal Platform Dependencies (Required)
    LlmD -->|"runtime engine<br/>(Required)"| vLLM["vLLM<br/>OpenAI-compatible<br/>inference engine"]
    LlmD -->|"CRD provider<br/>(Required)"| GatewayAPIInfExt["gateway-api-inference-extension<br/>InferencePool + InferenceModel CRDs"]
    LlmD -->|"Helm chart<br/>(Required)"| LlmDRouter["llm-d-router<br/>EPP + Envoy proxy"]

    %% Integration Points (Required)
    LlmDRouter -->|"ext_proc<br/>gRPC/9002"| EPP["EPP<br/>Endpoint Picker"]
    LlmDRouter -->|"reverse proxy<br/>HTTP/8081"| Envoy["Envoy Proxy"]

    %% Integration Points (Optional)
    LlmD -.->|"KV cache transfer<br/>TCP/5600<br/>(Optional, P/D mode)"| Nixl["nixl<br/>P2P Transfer"]
    LlmD -.->|"tracing export<br/>gRPC/4317<br/>(Optional)"| OTel["OpenTelemetry<br/>Collector"]

    %% Gateway Providers (one of)
    LlmD -->|"ingress + auth<br/>(delegated)"| GatewayProviders

    subgraph GatewayProviders["Gateway Providers (one of)"]
        GatewayAPI["Gateway API"]
        Istio["Istio"]
        Kgateway["kgateway"]
        AgentGateway["AgentGateway"]
    end

    %% Multi-Accelerator Support
    subgraph Accelerators["Supported Accelerators"]
        CUDA["NVIDIA CUDA"]
        ROCm["AMD ROCm"]
        XPU["Intel XPU"]
        CPU["CPU (Ubuntu)"]
    end

    LlmD -->|"container images"| Accelerators

    %% Deployment Targets
    subgraph Targets["Deployment Targets"]
        OpenShift["OpenShift"]
        GKE["GKE"]
        AWS["AWS"]
        CoreWeave["CoreWeave"]
    end

    LlmD -.->|"deployment recipes"| Targets

    style LlmD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style vLLM fill:#7ed321,stroke:#333,color:#fff
    style GatewayAPIInfExt fill:#7ed321,stroke:#333,color:#fff
    style LlmDRouter fill:#7ed321,stroke:#333,color:#fff
    style EPP fill:#f5a623,stroke:#333
    style Envoy fill:#f5a623,stroke:#333
    style Nixl fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style Kgateway fill:#999,stroke:#333,color:#fff
    style AgentGateway fill:#999,stroke:#333,color:#fff
    style CUDA fill:#76b900,stroke:#333,color:#fff
    style ROCm fill:#ed1c24,stroke:#333,color:#fff
    style XPU fill:#0071c5,stroke:#333,color:#fff
    style CPU fill:#666,stroke:#333,color:#fff
    style OpenShift fill:#ee0000,stroke:#333,color:#fff
    style GKE fill:#4285f4,stroke:#333,color:#fff
    style AWS fill:#ff9900,stroke:#333
