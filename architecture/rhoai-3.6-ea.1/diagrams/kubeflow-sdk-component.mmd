graph TB
    subgraph "Kubeflow SDK (Python Client Library)"
        direction TB

        subgraph CorePackage["kubeflow (Core Namespace)"]
            CommonTypes["kubeflow.common.types<br/>KubernetesBackendConfig"]
        end

        subgraph TrainerModule["kubeflow.trainer"]
            TrainerAPI["kubeflow-trainer-api<br/>Training Job Definitions"]
            RHAIExt["kubeflow.trainer.rhai<br/>RHAI Instrumentation"]
            RHAIExt -->|"checkpoint mgmt<br/>progression tracking"| TrainerAPI
        end

        subgraph KatibModule["kubeflow.katib"]
            KatibAPI["kubeflow-katib-api<br/>HP Tuning Experiments"]
        end

        subgraph SparkModule["kubeflow.spark (optional)"]
            SparkAPI["kubeflow-spark-api<br/>Spark Workloads"]
        end

        subgraph PipelinesModule["kubeflow.pipelines (optional)"]
            PipelinesClient["PipelinesClient<br/>(re-export from kfp)"]
            DSL["KFP DSL Modules<br/>compiler, components, dsl"]
        end

        CommonTypes -->|"configures auth"| TrainerAPI
        CommonTypes -->|"configures auth"| KatibAPI
        CommonTypes -->|"configures auth"| SparkAPI
    end

    User[Data Scientist / ML Engineer] -->|"creates training jobs"| TrainerAPI
    User -->|"defines pipelines"| PipelinesClient
    User -->|"tunes hyperparams"| KatibAPI
    User -->|"submits Spark jobs"| SparkAPI

    CommonTypes -->|"delegates auth &<br/>API calls"| K8sClient["kubernetes Python Client"]
    PipelinesClient -->|"delegates pipeline ops"| KFP["kfp Library"]
    K8sClient -->|"kubeconfig / SA token<br/>OIDC"| K8sAPI["Kubernetes API Server"]
    KFP -->|"pipeline API calls"| KFPAPI["KF Pipelines API Server"]

    style CorePackage fill:#4a90e2,stroke:#333
    style TrainerModule fill:#4a90e2,stroke:#333
    style KatibModule fill:#4a90e2,stroke:#333
    style SparkModule fill:#4a90e2,stroke:#333,stroke-dasharray: 5 5
    style PipelinesModule fill:#4a90e2,stroke:#333,stroke-dasharray: 5 5
    style RHAIExt fill:#e74c3c,stroke:#333
    style CommonTypes fill:#5dade2
    style TrainerAPI fill:#5dade2
    style KatibAPI fill:#5dade2
    style SparkAPI fill:#5dade2
    style PipelinesClient fill:#5dade2
    style DSL fill:#5dade2
    style K8sClient fill:#e8e8e8,stroke:#333
    style KFP fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style KFPAPI fill:#f5a623,stroke:#333
    style User fill:#7ed321,stroke:#333
