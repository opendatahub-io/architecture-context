graph TB
    subgraph "Kubeflow SDK"
        direction TB
        TrainerClient["TrainerClient<br/>(Public API)"]

        subgraph "Backends"
            direction LR
            KubernetesBackend["KubernetesBackend<br/>(Production)"]
            LocalProcessBackend["LocalProcessBackend<br/>(Development)"]
        end

        subgraph "API Model Packages"
            direction LR
            TrainerAPI["kubeflow-trainer-api<br/>(TrainJob models)"]
            KatibAPI["kubeflow-katib-api<br/>(Experiment models)"]
            SparkAPI["kubeflow-spark-api<br/>(SparkConnect models)"]
        end

        subgraph "RHAI Module"
            direction LR
            Transformers["transformers utils<br/>(checkpoint injection)"]
            StructuredLogging["structlog integration<br/>(structured logging)"]
        end

        TrainerClient -->|dispatches to| KubernetesBackend
        TrainerClient -->|dispatches to| LocalProcessBackend
        KubernetesBackend -->|serializes| TrainerAPI
        KubernetesBackend -->|serializes| KatibAPI
        KubernetesBackend -->|serializes| SparkAPI
        TrainerClient -.->|optional| Transformers
        TrainerClient -.->|optional| StructuredLogging
    end

    User["Data Scientist / ML Engineer"] -->|creates workloads via| TrainerClient

    subgraph "Kubernetes Cluster"
        direction TB
        K8sAPI["Kubernetes API Server"]
        TrainJobCR["TrainJob CR"]
        KatibExperiment["Katib Experiment CR"]
        SparkConnectCR["SparkConnect CR"]
        ConfigMap["kubeflow-trainer-public<br/>ConfigMap"]
    end

    KubernetesBackend -->|authenticates via<br/>kubeconfig / SA token| K8sAPI
    KubernetesBackend -->|reads| ConfigMap
    K8sAPI -->|CRUD| TrainJobCR
    K8sAPI -->|CRUD| KatibExperiment
    K8sAPI -->|CRUD| SparkConnectCR

    style TrainerClient fill:#4a90e2,stroke:#333,color:#fff
    style KubernetesBackend fill:#4a90e2,stroke:#333,color:#fff
    style LocalProcessBackend fill:#4a90e2,stroke:#333,color:#fff
    style TrainerAPI fill:#7ed321,stroke:#333
    style KatibAPI fill:#7ed321,stroke:#333
    style SparkAPI fill:#7ed321,stroke:#333
    style Transformers fill:#f5a623,stroke:#333
    style StructuredLogging fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style KatibExperiment fill:#f5a623,stroke:#333
    style SparkConnectCR fill:#f5a623,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
