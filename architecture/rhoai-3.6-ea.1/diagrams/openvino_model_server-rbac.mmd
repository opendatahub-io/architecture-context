graph TD
    subgraph "OpenVINO Model Server RBAC"
        direction TB
        Note["No explicit RBAC definitions<br/>in this component"]
    end

    subgraph "Runtime Context"
        direction TB
        SA["Pod Service Account<br/>(KServe-managed)"]
        KServeRBAC["KServe Controller RBAC<br/>(manages ServingRuntime lifecycle)"]
    end

    subgraph "ServingRuntime Registration"
        direction TB
        ClusterRT["kserve-openvino<br/>ClusterServingRuntime<br/>API: serving.kserve.io/v1alpha1<br/>Scope: Cluster-wide"]
