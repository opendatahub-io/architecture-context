graph TD
    subgraph Note["RBAC Configuration"]
        direction TB
        Info["OVMS does not define its own<br/>ClusterRoles or RoleBindings.<br/><br/>RBAC is managed externally by:<br/>- KServe (ServingRuntime lifecycle)<br/>- Platform Operator (namespace access)<br/>- Istio (optional service mesh AuthZ)"]
    end

    subgraph AuthMechanisms["Authentication Mechanisms"]
        direction TB
        Default["Default Mode<br/>No Authentication<br/>OVMS exposes all endpoints<br/>without access control"]
        APIKey["API Key Mode (Optional)<br/>Bearer API key validation<br/>HttpRestApiHandler::isAuthorized<br/>In-process enforcement"]
        MTLS["mTLS Sidecar Mode (Optional)<br/>nginx reverse proxy<br/>TLS 1.2 + client certificate<br/>Restricted cipher suites"]
    end

    subgraph ServingRuntimeRBAC["Serving Runtime Scope"]
        ClusterRT["kserve-openvino<br/>ClusterServingRuntime<br/>Scope: Cluster-wide"]
        NamespacedRT["kserve-ovms-2026-2<br/>ServingRuntime<br/>Scope: Namespaced"]
    end

    KServe["KServe Controller<br/>(manages RBAC for pods)"] -->|"creates/manages"| ClusterRT
    KServe -->|"creates/manages"| NamespacedRT
    ClusterRT -->|"deploys with<br/>pod SA"| OVMSPod["OVMS Pod"]
    NamespacedRT -->|"deploys with<br/>pod SA"| OVMSPod

    OVMSPod -->|"serves via"| Default
    OVMSPod -.->|"optional"| APIKey
    OVMSPod -.->|"optional"| MTLS

