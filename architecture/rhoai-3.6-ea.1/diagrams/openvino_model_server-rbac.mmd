    end

    subgraph "Authentication Mechanisms"
        direction TB
        NoAuth["Core Server: No Auth<br/>Delegates to platform<br/>service mesh"]
        mTLSAuth["mTLS Sidecar (Optional)<br/>TLSv1.2 client certs<br/>nginx ssl_verify_client"]
    end

    SA -->|"runs as"| ClusterRT
