graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        PlatformGW["llm-d Inference Gateway<br/>Gateway API HTTPRoute<br/>AuthN/AuthZ: Platform-delegated<br/>Passes Authorization header through"]
    end

    subgraph Workload["WORKLOAD TIER (batch-gateway namespace)"]
        direction TB

        APIServer["batch-gateway-apiserver<br/>Port 8000: REST API (TLS opt-in, min TLS 1.2)<br/>Port 8081: Observability (plain HTTP)<br/>FIPS: strictfipsruntime + OpenSSL<br/>Secret: /etc/.secrets/ (RO)"]
        Processor["batch-gateway-processor<br/>Port 8081: Observability (plain HTTP)<br/>FIPS: strictfipsruntime + OpenSSL<br/>Secret: /etc/.secrets/ (RO)"]
        GC["batch-gateway-gc<br/>Port 8081: Observability (plain HTTP)<br/>FIPS: strictfipsruntime + OpenSSL<br/>Secret: /etc/.secrets/ (RO)"]

        Secret["batch-gateway-secrets<br/>Redis URL, PostgreSQL URL,<br/>Inference API Key, S3 Creds<br/>Mount: /etc/.secrets/ (read-only)"]
    end

    subgraph DataTier["DATA TIER"]
        PostgreSQL["PostgreSQL<br/>TCP (runtime-configured)<br/>Auth: Connection URL"]
        Redis["Redis/Valkey<br/>TCP (runtime-configured)<br/>Auth: Connection URL"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS (runtime-configured)<br/>Auth: AWS SDK v2 credentials"]
        LLMd["llm-d Inference Gateway<br/>HTTP/HTTPS (runtime-configured)<br/>Auth: API Key + Authorization passthrough"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC (runtime-configured)"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS (platform-managed)<br/>Bearer Token"| PlatformGW

    %% Ingress → Workload
    PlatformGW -->|"HTTP(S)/8000<br/>TLS opt-in (min 1.2)<br/>No local auth"| APIServer

    %% API Server → Data Tier
    APIServer -->|"TCP<br/>Connection URL auth"| PostgreSQL
    APIServer -->|"TCP<br/>Connection URL auth"| Redis
    APIServer -->|"HTTP/HTTPS<br/>AWS SDK auth"| S3

    %% Processor → Data Tier + External
    Redis -->|"TCP<br/>Poll pending"| Processor
    Processor -->|"TCP<br/>Query/Update"| PostgreSQL
    Processor -->|"HTTP/HTTPS<br/>Fan-out inference"| LLMd
    Processor -->|"HTTP/HTTPS<br/>Read/Write files"| S3

    %% GC → Data Tier
    GC -->|"TCP<br/>Query expired"| PostgreSQL
    GC -->|"HTTP/HTTPS<br/>Delete files"| S3

    %% Observability
    APIServer -.->|"OTLP/gRPC<br/>Traces"| OTel
    Processor -.->|"OTLP/gRPC<br/>Traces"| OTel
    GC -.->|"OTLP/gRPC<br/>Traces"| OTel

    %% Secret mounts
    Secret -.->|"mounted RO"| APIServer
    Secret -.->|"mounted RO"| Processor
    Secret -.->|"mounted RO"| GC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datatier fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class PlatformGW ingress
    class APIServer,Processor,GC workload
    class PostgreSQL,Redis datatier
    class S3,LLMd,OTel externalservice
    class Secret secret
