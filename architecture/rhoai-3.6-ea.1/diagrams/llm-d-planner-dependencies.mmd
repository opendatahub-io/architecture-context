graph LR
    LLMDPlanner["llm-d-planner<br/>FastAPI Backend"]

    %% External LLM Provider Dependencies
    LLMDPlanner -->|"OpenAI SDK<br/>HTTPS"| OpenAIAPI["OpenAI-compatible API<br/>(configurable endpoint)"]
    LLMDPlanner -->|"HTTP/11434<br/>ClusterIP"| Ollama["Ollama<br/>ollama/ollama:latest"]
    LLMDPlanner -->|"HTTPS/443<br/>GCP creds"| VertexAI["Google Vertex AI"]

    %% Platform Dependencies
    LLMDPlanner -->|"HTTPS/6443<br/>SA token"| K8sAPI["Kubernetes API<br/>(node listing)"]
    LLMDPlanner -->|"CA bundle mount"| ServiceCA["OpenShift Service CA"]

    %% External Data Dependencies
    LLMDPlanner -->|"HTTPS/443<br/>HF_TOKEN"| HFHub["Hugging Face Hub<br/>huggingface-hub >=1.25.1"]

    %% Runtime Framework
    LLMDPlanner -->|"ASGI server"| Uvicorn["uvicorn ==0.52.0"]
    LLMDPlanner -->|"web framework"| FastAPI["fastapi >=0.141.1"]
    LLMDPlanner -->|"data validation"| Pydantic["pydantic ==2.13.4"]
    LLMDPlanner -->|"HTTP client"| HTTPX["httpx >=0.27"]

    %% Data/ML Dependencies
    LLMDPlanner -->|"data analysis"| Pandas["pandas ==3.0.5"]
    LLMDPlanner -->|"ML transforms"| Transformers["transformers >=5.14.1"]
    LLMDPlanner -->|"datasets"| Datasets["datasets >=5.0.1"]
    LLMDPlanner -->|"optimization"| LLMOptimizer["llm-optimizer<br/>(BentoML)"]

    %% UI Component
    StreamlitUI["Streamlit UI<br/>streamlit ==1.60.0"] -->|"HTTP/8000<br/>API calls"| LLMDPlanner

    %% Ingress
    RouteUI["Route: planner<br/>(HTTPS)"] -->|"8501/TCP"| StreamlitUI
    RouteAPI["Route: planner-backend<br/>(HTTPS)"] -->|"8000/TCP"| LLMDPlanner

    %% Styling
    style LLMDPlanner fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style StreamlitUI fill:#4a90e2,stroke:#333,color:#fff
    style Ollama fill:#4a90e2,stroke:#333,color:#fff
    style OpenAIAPI fill:#999,stroke:#333,color:#fff
    style VertexAI fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style ServiceCA fill:#7B68EE,stroke:#333,color:#fff
    style HFHub fill:#999,stroke:#333,color:#fff
    style RouteUI fill:#7ed321,stroke:#333
    style RouteAPI fill:#7ed321,stroke:#333
    style Uvicorn fill:#f5a623,stroke:#333
    style FastAPI fill:#f5a623,stroke:#333
