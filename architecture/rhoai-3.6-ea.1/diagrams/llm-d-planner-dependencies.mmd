graph LR
    LLMDPlanner["llm-d-planner<br/>FastAPI Backend"]

    %% Runtime Infrastructure Dependencies
    LLMDPlanner -->|"PostgreSQL/5432<br/>Benchmark storage"| PostgreSQL["PostgreSQL 16<br/>(co-deployed)"]
    LLMDPlanner -->|"HTTP/11434<br/>Local LLM inference"| Ollama["Ollama<br/>(co-deployed)"]
    LLMDPlanner -->|"HTTPS/6443<br/>Node GPU labels"| K8sAPI["Kubernetes API<br/>Server"]

    %% External LLM Providers
    LLMDPlanner -->|"HTTPS<br/>API Key auth"| OpenAIAPI["OpenAI-compatible API<br/>(configurable endpoint)"]
    LLMDPlanner -.->|"HTTPS<br/>Alternative provider"| VertexAI["Google Vertex AI"]

    %% Platform Dependencies
    LLMDPlanner -->|"CA bundle injection"| ServiceCA["OpenShift Service CA"]
    LLMDPlanner -->|"TLS termination"| Routes["OpenShift Routes"]

    %% External Data Sources
    LLMDPlanner -->|"HTTPS<br/>Model metadata"| HuggingFace["HuggingFace Hub"]

    %% Key Python Runtime Dependencies
    LLMDPlanner -->|"ASGI server"| Uvicorn["uvicorn 0.52.0"]
    LLMDPlanner -->|"HTTP framework"| FastAPI["FastAPI 0.141.1+"]
    LLMDPlanner -->|"K8s client"| K8sPython["kubernetes 36.0.3+"]
    LLMDPlanner -->|"OpenAI SDK"| OpenAIPython["openai 2.50.0+"]
    LLMDPlanner -->|"DB driver"| Psycopg2["psycopg2-binary 2.9.12"]
    LLMDPlanner -->|"LLM optimization"| LLMOptimizer["llm-optimizer<br/>(BentoML)"]

    %% UI Dependencies
    StreamlitUI["Streamlit UI"] -->|"HTTP/8000<br/>REST API"| LLMDPlanner
    StreamlitUI -->|"Web framework"| Streamlit["streamlit 1.60.0"]

