graph TB
    subgraph "odh-cli (kubectl-odh / rhai-cli)"
        direction TB
        Main[cmd/main.go<br/>Cobra Root Command]

        subgraph "Subcommands"
            Diagnose[diagnose<br/>Platform Diagnostics]
            Status[status<br/>Component Status]
            Components[components<br/>Component Inspection]
            Get[get<br/>Resource Queries]
            Migrate[migrate<br/>Operator Migration]
            Events[events<br/>Event Streaming]
            Logs[logs<br/>Log Streaming]
            Deps[deps<br/>Dependency Analysis]
            Lint[lint<br/>Manifest Linting]
            Api[api<br/>API Resource Queries]
            MCPServe[mcp serve<br/>MCP Server]
        end

        subgraph "Core Libraries"
            Client[pkg/util/client<br/>Kubernetes Client Abstraction]
            RBAC[pkg/util/kube/rbac<br/>RBAC Pre-flight Checks]
            OLM[pkg/util/kube/olm<br/>OLM Client]
        end

        subgraph "Migration Actions"
            TrustYAI[pkg/migrate/actions/trustyai<br/>TrustYAI Metrics<br/>Backup/Restore]
        end

        Main --> Diagnose
        Main --> Status
        Main --> Components
        Main --> Get
        Main --> Migrate
        Main --> Events
        Main --> Logs
        Main --> Deps
        Main --> Lint
        Main --> Api
        Main --> MCPServe

        Diagnose --> Client
        Status --> Client
        Components --> Client
        Get --> Client
        Migrate --> Client
        Migrate --> TrustYAI
        Events --> Client
        Logs --> Client
        Deps --> Client
        Api --> Client

        Client --> RBAC
        Client --> OLM

        MCPServe -->|exposes CLI ops as tools| Client
    end

    User[CLI User / kubectl] -->|invokes| Main
    Agent[AI Agent / MCP Client] -->|JSON-RPC via SSE or stdio| MCPServe

    Client -->|HTTPS/6443| K8sAPI[Kubernetes API Server]
    TrustYAI -->|HTTPS/443<br/>Bearer Token| TrustYAIService[TrustYAI Service<br/>via OpenShift Route]
    Client -->|API calls| OLMAPI[OLM API<br/>CSVs & Subscriptions]

    subgraph "Runtime Libraries (imported)"
        ClusterHealth[opendatahub-operator<br/>clusterhealth]
        FailureClassifier[opendatahub-operator<br/>failureclassifier]
        MCPTools[opendatahub-operator<br/>mcptools]
    end

    Diagnose --> ClusterHealth
    Diagnose --> FailureClassifier
    MCPServe --> MCPTools

