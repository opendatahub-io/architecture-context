graph LR
    Sidecar["llm-d-routing-sidecar<br/>Reverse Proxy Sidecar"]

    %% Internal Platform Dependencies
    Sidecar -->|"reverse proxy<br/>localhost:8001"| vLLMDecoder["vLLM Decoder<br/>(co-located)"]
    Sidecar -->|"reverse proxy<br/>dynamic port"| vLLMPrefiller["vLLM Prefiller Pods<br/>(remote)"]
    Sidecar -->|"CRD Watch<br/>informer"| InferencePool["InferencePool<br/>Gateway API<br/>v1alpha2"]

    %% Kubernetes Dependencies
    Sidecar -->|"API watch<br/>6443/TCP"| K8sAPI["Kubernetes API<br/>v0.31.3"]

    %% Go Runtime Dependencies
    Sidecar -->|"LRU caching"| LRU["golang-lru/v2<br/>v2.0.7"]
    Sidecar -->|"logging"| Logr["go-logr<br/>v1.4.2"]
    Sidecar -->|"request IDs"| UUID["google/uuid<br/>v1.6.0"]

    %% Kubernetes Client Libraries
    Sidecar -->|"API client"| ClientGo["k8s.io/client-go<br/>v0.31.3"]
    Sidecar -->|"API types"| APIMachinery["k8s.io/apimachinery<br/>v0.31.3"]

    %% Build Dependencies
    Sidecar -->|"runtime"| GoRuntime["Go 1.24.2"]

    %% Integration Points (other components → sidecar)
    OpenShiftRoute["OpenShift Route<br/>(ingress)"] -->|"HTTPS"| Sidecar

