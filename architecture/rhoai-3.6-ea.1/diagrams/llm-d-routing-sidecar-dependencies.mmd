graph LR
    Sidecar["llm-d-routing-sidecar<br/>Go Reverse Proxy Sidecar"]

    %% Internal Platform Dependencies
    Sidecar -->|"localhost reverse proxy<br/>HTTP/HTTPS port 8001"| vLLM["vLLM<br/>(co-located decoder)"]
    Sidecar -->|"HTTP/HTTPS reverse proxy<br/>dynamic ports"| Prefillers["Remote Prefiller Pods"]
    Sidecar -.->|"Watch CRs (optional)<br/>SSRF allowlist"| InferencePool["InferencePool CRD<br/>Gateway API<br/>inference.networking.x-k8s.io/v1alpha2"]

    %% Kubernetes Dependencies
    Sidecar -->|"REST + WebSocket<br/>HTTPS/6443"| K8sAPI["Kubernetes API"]

    %% Key Go Libraries
    subgraph GoLibs["Key Go Libraries"]
        direction TB
        LRU["hashicorp/golang-lru/v2<br/>v2.0.7"]
        K8sClient["k8s.io/client-go<br/>v0.31.3"]
        K8sApimachinery["k8s.io/apimachinery<br/>v0.31.3"]
        Logr["go-logr/logr<br/>v1.4.2"]
    end

    Sidecar -->|"LRU proxy cache"| LRU
    Sidecar -->|"K8s dynamic client"| K8sClient
    Sidecar -->|"K8s types"| K8sApimachinery
    Sidecar -->|"structured logging"| Logr

    %% Infrastructure
    subgraph Infra["OpenShift Infrastructure"]
        Route["OpenShift Route<br/>HTTPS ingress"]
        ClusterIPSvc["K8s Service<br/>ClusterIP 8080/TCP"]
    end

    Route -->|"HTTPS → TCP"| ClusterIPSvc
    ClusterIPSvc -->|"TCP 8000"| Sidecar

