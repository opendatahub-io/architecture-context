    style InferencePool fill:#f5a623,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style LRU fill:#e8e8e8,stroke:#333
    style K8sClient fill:#e8e8e8,stroke:#333
    style K8sApimachinery fill:#e8e8e8,stroke:#333
