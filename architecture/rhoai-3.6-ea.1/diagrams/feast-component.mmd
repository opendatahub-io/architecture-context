graph TB
    subgraph ControlPlane["Control Plane (Go Operator)"]
        direction TB
        Reconciler["FeatureStoreReconciler<br/>cmd/main.go"]
        NotebookReconciler["NotebookConfigMapReconciler<br/>ConfigMap generation for<br/>Kubeflow Notebooks"]
        Webhook["Webhook Server<br/>CRD validation"]
        LeaderElection["Leader Election<br/>coordination.k8s.io/Lease"]
        HealthProbe["Health Probes<br/>:8081/healthz, /readyz"]
        MetricsEndpoint["Metrics Endpoint<br/>:8443/metrics<br/>TokenReview + SAR auth"]

        Reconciler -->|generates| NotebookReconciler
        Reconciler -->|validates| Webhook
        Reconciler -->|acquires| LeaderElection
    end

    subgraph DataPlane["Data Plane (Operator-Managed Workloads)"]
        direction TB
        subgraph OnlineServing["Online Serving"]
            GoServer["Go Feature Server<br/>HTTP + gRPC<br/>/get-online-features"]
            PyServer["Python Feature Server<br/>FastAPI/Starlette<br/>:6566/TCP"]
        end

        subgraph RegistryServing["Registry"]
            RegistryServer["Registry Server<br/>gRPC: RegistryServer<br/>REST: /entities, /feature_views, ..."]
        end

        subgraph OfflineServing["Offline Serving"]
            OfflineServer["Python Offline Server<br/>Apache Arrow Flight<br/>FIPS cipher suite enforcement"]
        end

        subgraph UI["UI"]
            FeastUI["Feast UI<br/>React SPA<br/>/ws/chat WebSocket"]
        end
    end

    User[Data Scientist / Client] -->|creates| FeatureStoreCR["FeatureStore CR<br/>feast.dev/v1alpha1"]
    FeatureStoreCR -->|watched by| Reconciler

    Reconciler -->|creates/manages| GoServer
    Reconciler -->|creates/manages| PyServer
    Reconciler -->|creates/manages| RegistryServer
    Reconciler -->|creates/manages| OfflineServer
    Reconciler -->|creates/manages| FeastUI

    Reconciler -->|creates| Deployments[Deployments]
    Reconciler -->|creates| Services[Services]
    Reconciler -->|creates| ConfigMaps[ConfigMaps]
    Reconciler -->|creates| RBAC[Roles / RoleBindings]
    Reconciler -->|creates| HPA[HPA]
    Reconciler -->|creates| PDB[PDB]
    Reconciler -->|creates| CronJobs[CronJobs]
    Reconciler -->|creates| Routes[OpenShift Routes]
    Reconciler -->|creates| ServiceMonitors[ServiceMonitors]

    GoServer -->|reads from| OnlineStore["Online Store<br/>(PostgreSQL / Redis / Valkey)"]
    PyServer -->|reads from| OnlineStore
    RegistryServer -->|backed by| RegistryBackend["Registry Backend<br/>(S3 / GCS / Database)"]
    OfflineServer -->|reads from| OfflineBackend["Offline Source<br/>(Data Warehouse)"]

    Reconciler -->|API calls| K8sAPI["Kubernetes API<br/>:6443/HTTPS"]

    style ControlPlane fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style DataPlane fill:#f0f9e8,stroke:#82b366,stroke-width:2px
    style OnlineServing fill:#d5e8d4,stroke:#82b366
    style RegistryServing fill:#d5e8d4,stroke:#82b366
    style OfflineServing fill:#d5e8d4,stroke:#82b366
    style UI fill:#d5e8d4,stroke:#82b366
    style Reconciler fill:#4a90e2,color:#fff
    style NotebookReconciler fill:#4a90e2,color:#fff
    style GoServer fill:#7ed321
    style PyServer fill:#7ed321
    style RegistryServer fill:#7ed321
    style OfflineServer fill:#7ed321
    style FeastUI fill:#7ed321
    style FeatureStoreCR fill:#f5a623
    style OnlineStore fill:#e8e8e8
    style RegistryBackend fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
