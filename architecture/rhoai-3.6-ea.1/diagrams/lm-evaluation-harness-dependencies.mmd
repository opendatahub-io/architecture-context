graph LR
    LMEval["lm-evaluation-harness<br/>(Batch Job)"]

    %% Internal RHOAI Dependencies
    LMEval -->|"OpenAI-compatible API<br/>POST /v1/completions<br/>API Key auth"| ModelServing["Model Serving Endpoint<br/>(vLLM / KServe)"]
    LMEval -->|"EvalHub SDK<br/>JobSpec ↔ EvaluationResult"| EvalHub["EvalHub Service<br/>(Job Orchestrator)"]

    %% External Service Dependencies
    LMEval -->|"HTTPS/443<br/>HF_TOKEN"| HFHub["HuggingFace Hub<br/>(datasets, tokenizers)"]
    LMEval -->|"HTTPS/443"| HFDatasets["datasets-server<br/>.huggingface.co"]
    LMEval -->|"HTTPS<br/>AWS IAM"| S3["S3-Compatible Storage<br/>(boto3)"]

    %% Key Runtime Libraries
    LMEval -->|"evaluation engine"| EleutherAI["lm-eval Framework<br/>(EleutherAI)"]
    LMEval -->|"task integration"| Unitxt["Unitxt<br/>1.17.2"]
    LMEval -->|"ML runtime"| PyTorch["PyTorch<br/>>=2.6.0"]
    LMEval -->|"tokenization"| Transformers["Transformers<br/>>=4.48.0"]
    LMEval -->|"data loading"| Datasets["HF Datasets<br/>>=3.1.0"]
    LMEval -.->|"optional"| WatsonX["IBM WatsonX AI<br/>1.4.11"]

    %% Infrastructure Dependencies
    LMEval -->|"HTTP client"| HTTPX["httpx / aiohttp<br/>(async HTTP)"]
    LMEval -->|"base image"| UBI["UBI Base Image<br/>(CUDA / CPU variants)"]

