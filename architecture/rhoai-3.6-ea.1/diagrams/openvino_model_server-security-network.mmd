graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM (KServe/Istio Service Mesh)"]
        direction TB
        KServeCP["KServe Control Plane<br/>ServingRuntime CRD<br/>Manages pod lifecycle"]
    end

    subgraph OVMSPod["OVMS CONTAINER (No built-in auth)"]
        direction TB
        OVMS["OVMS Binary<br/>/ovms/bin/ovms<br/>UBI 9 + OpenSSL"]

        subgraph Ports_Cluster["ClusterServingRuntime Ports"]
            REST_C["REST: 8080/TCP<br/>HTTP/1.1<br/>No Encryption<br/>No Auth"]
            GRPC_C["gRPC: 9000/TCP<br/>HTTP/2<br/>No Encryption<br/>No Auth"]
        end

        subgraph Ports_NS["ServingRuntime Ports"]
            REST_N["REST: 8888/TCP<br/>HTTP/1.1<br/>No Encryption<br/>No Auth"]
            GRPC_N["gRPC: 8001/TCP<br/>HTTP/2<br/>No Encryption<br/>No Auth"]
        end

        MetricsEP["/metrics<br/>8080/TCP HTTP"]
    end

    subgraph mTLSSidecar["OPTIONAL: mTLS SIDECAR"]
        direction TB
        Nginx["nginx Reverse Proxy<br/>TLSv1.2<br/>AES256+EECDH<br/>ssl_verify_client: ON"]
        OVMSLocal["OVMS (localhost-bound)<br/>Ports reassigned by ovms_wrapper"]
    end

    subgraph Storage["MODEL STORAGE"]
        Models["/mnt/models<br/>Volume Mount<br/>KServe Storage Initializer"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Metrics Scraping"]
    end

    subgraph DashboardZone["RHOAI DASHBOARD"]
        Dashboard["ODH Dashboard<br/>Label: opendatahub.io/dashboard"]
    end

    %% Direct access flows
    Client -->|"REST 8080/TCP<br/>HTTP/1.1<br/>No Encryption<br/>Platform-delegated Auth"| REST_C
    Client -->|"gRPC 9000/TCP<br/>HTTP/2<br/>No Encryption<br/>Platform-delegated Auth"| GRPC_C

    %% mTLS sidecar flows
    Client -->|"HTTPS or gRPC<br/>TLSv1.2<br/>mTLS Client Cert"| Nginx
    Nginx -->|"HTTP/gRPC<br/>localhost<br/>Plaintext<br/>No Auth"| OVMSLocal

    %% Internal flows
    OVMS -->|"Filesystem I/O"| Models
    Prometheus -->|"GET /metrics<br/>8080/TCP HTTP"| MetricsEP
    KServeCP -->|"CRD Registration<br/>ServingRuntime"| OVMS
    Dashboard -->|"Label Discovery"| OVMS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#dce8f5,stroke:#4a90e2,stroke-width:2px
    classDef ovms fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef mtls fill:#e6d5f5,stroke:#9b59b6,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef dashboard fill:#d5f5d5,stroke:#27ae60,stroke-width:2px

    class Client external
    class KServeCP platform
    class OVMS,REST_C,GRPC_C,REST_N,GRPC_N,MetricsEP ovms
    class Nginx,OVMSLocal mtls
    class Models storage
    class Prometheus monitoring
    class Dashboard dashboard
