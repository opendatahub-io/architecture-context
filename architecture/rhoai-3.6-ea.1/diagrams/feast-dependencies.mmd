graph LR
    Feast["Feast<br/>Operator + Feature Server"]

    %% Kubernetes Platform Dependencies
    Feast -->|"resource mgmt<br/>HTTPS :6443"| K8sAPI["Kubernetes API<br/>k8s.io/client-go v0.35.2"]
    Feast -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    Feast -->|"CRD extensions"| APIExtensions["apiextensions-apiserver<br/>v0.35.1"]

    %% CRD Interactions
    Feast -->|"watches/manages"| FeatureStoreCRD["FeatureStore CRD<br/>feast.dev/v1, v1alpha1"]
    Feast -->|"watches notebooks"| KubeflowCRD["kubeflow.org<br/>Notebooks"]
    Feast -->|"creates monitors"| PromOpCRD["monitoring.coreos.com<br/>ServiceMonitors"]
    Feast -->|"creates routes"| OpenShiftRoutes["route.openshift.io<br/>Routes"]
    Feast -->|"creates spark jobs"| SparkCRD["sparkoperator.k8s.io<br/>SparkApplications"]

    %% Online Store Dependencies
    Feast -->|"feature storage<br/>pgx v5.8.0"| PostgreSQL["PostgreSQL"]
    Feast -->|"feature storage<br/>go-redis v9.20.0"| Redis["Redis / Valkey"]

    %% Registry / Storage Dependencies
    Feast -->|"registry storage<br/>aws-sdk-go-v2"| S3["S3-compatible<br/>Storage"]
    Feast -->|"registry storage<br/>cloud.google.com/go/storage"| GCS["Google Cloud<br/>Storage"]

    %% Compute Engine Dependencies
    Feast -.->|"distributed compute<br/>ray>=2.47.0"| Ray["Ray"]
    Feast -.->|"spark jobs<br/>pyspark>=4.0.0"| Spark["Apache Spark"]

    %% Auth Dependencies
    Feast -->|"OIDC auth<br/>pyjwt"| OIDCProvider["OIDC Provider"]
    Feast -->|"K8s RBAC auth<br/>TokenReview/SAR"| K8sRBAC["Kubernetes RBAC"]

    %% Monitoring / Observability
    Feast -->|"metrics<br/>prometheus/client_golang"| Prometheus["Prometheus"]
    Feast -->|"tracing<br/>opentelemetry v1.44.0"| OTLP["OpenTelemetry<br/>Collector"]
    Feast -->|"lineage events<br/>openlineage-python"| OpenLineage["OpenLineage"]

    %% Internal RHOAI Dependencies
    KubeflowNotebooks["Kubeflow Notebooks"] -.->|"config injection"| Feast
    Dashboard["ODH Dashboard"] -.->|"route status"| Feast

    %% Python Framework
    Feast -->|"HTTP serving<br/>fastapi>=0.68.0"| FastAPI["FastAPI /<br/>Starlette"]
    Feast -->|"gRPC transport<br/>grpcio>=1.56.2"| GRPC["gRPC"]
    Feast -->|"serialization<br/>protobuf>=4.24.0"| Protobuf["Protocol Buffers"]

    %% Data Libraries
    Feast -->|"data processing"| Pandas["pandas<br/>>=1.4.3"]
    Feast -->|"numerical ops"| NumPy["numpy<br/>>=2.0.0"]
    Feast -->|"arrow format"| Arrow["Apache Arrow<br/>v17.0.0"]

