graph LR
    Feast["Feast Operator<br/>+ Feature Servers"]

    %% Kubernetes / OpenShift Platform
    Feast -->|"resource mgmt<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>v1.30+"]
    Feast -->|"route mgmt"| OpenShiftRoutes["OpenShift Routes<br/>route.openshift.io"]
    Feast -->|"API server config"| OpenShiftConfig["OpenShift Config<br/>config.openshift.io"]
    Feast -->|"CRD management"| CRDApi["API Extensions<br/>apiextensions.k8s.io"]

    %% Online Store Backends
    Feast -->|"online features<br/>pgx pool"| PostgreSQL["PostgreSQL"]
    Feast -->|"online features<br/>go-redis"| Redis["Redis / Valkey"]
    Feast -->|"online features"| DynamoDB["DynamoDB<br/>(AWS SDK)"]

    %% Registry / Storage Backends
    Feast -->|"registry storage<br/>HTTPS/443"| S3["S3 Storage<br/>(AWS SDK / boto3)"]
    Feast -->|"registry storage<br/>HTTPS/443"| GCS["Google Cloud Storage"]

    %% Monitoring & Observability
    Feast -->|"ServiceMonitor mgmt"| Prometheus["Prometheus Operator<br/>monitoring.coreos.com"]
    Feast -->|"tracing"| OTel["OpenTelemetry<br/>(OTLP HTTP)"]
    Feast -->|"lineage events"| OpenLineage["OpenLineage"]

    %% Internal ODH / RHOAI Dependencies
    Feast -->|"notebook integration<br/>ConfigMap generation"| KubeflowNotebooks["Kubeflow Notebooks<br/>kubeflow.org"]
    Feast -.->|"batch materialization<br/>(conditional)"| SparkOperator["Spark Operator<br/>sparkoperator.k8s.io"]

    %% Runtime Frameworks
    Feast -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    Feast -->|"HTTP serving"| FastAPI["FastAPI / Starlette"]
    Feast -->|"offline transport"| ArrowFlight["Apache Arrow Flight"]
    Feast -->|"gRPC transport"| gRPC["gRPC<br/>google.golang.org/grpc"]

    %% Auth
    Feast -->|"OIDC validation"| PyJWT["PyJWT<br/>(OIDC auth)"]

    %% Styling
    style Feast fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External services
    style PostgreSQL fill:#f5a623,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style DynamoDB fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style GCS fill:#f5a623,stroke:#333

    %% Platform
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OpenShiftRoutes fill:#999,stroke:#333,color:#fff
    style OpenShiftConfig fill:#999,stroke:#333,color:#fff
    style CRDApi fill:#999,stroke:#333,color:#fff

    %% Internal ODH
    style KubeflowNotebooks fill:#7ed321,stroke:#333,color:#fff
    style SparkOperator fill:#7ed321,stroke:#333,color:#fff

    %% Monitoring
    style Prometheus fill:#e6522c,stroke:#333,color:#fff
    style OTel fill:#e6522c,stroke:#333,color:#fff
    style OpenLineage fill:#e6522c,stroke:#333,color:#fff

    %% Frameworks
    style ControllerRuntime fill:#ddd,stroke:#333
    style FastAPI fill:#ddd,stroke:#333
    style ArrowFlight fill:#ddd,stroke:#333
    style gRPC fill:#ddd,stroke:#333
    style PyJWT fill:#ddd,stroke:#333
