graph TD
    subgraph "Service Account"
        SA["trustyai-serviceaccount"]
    end

    subgraph "ClusterRole Binding"
        CRB["trustyai-clusterrolebinding<br/>(Cluster-scoped)"]
    end

    subgraph "ClusterRole"
        CR["trustyai-role"]
    end

    subgraph "API Resources"
        ConfigMaps["core (v1)<br/>ConfigMaps"]
    end

    subgraph "Permitted Verbs"
        Create["create"]
        Delete["delete"]
        Get["get"]
        List["list"]
        Patch["patch"]
        Update["update"]
        Watch["watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"permits on"| ConfigMaps
    ConfigMaps --- Create
    ConfigMaps --- Delete
    ConfigMaps --- Get
    ConfigMaps --- List
    ConfigMaps --- Patch
    ConfigMaps --- Update
    ConfigMaps --- Watch

    subgraph "Usage Context"
        direction LR
        InitUse["Init Container uses oc CLI<br/>to create model-serving-config<br/>ConfigMap in deployment namespace"]
    end

    SA -.->|"used by"| InitUse

    subgraph "Authentication & Authorization"
        direction LR
        NoAppAuth["No application-level auth<br/>All API endpoints rely on<br/>platform-level enforcement<br/>(OpenShift Route / Service Mesh)"]
    end

    style SA fill:#4a90e2,color:#fff
    style CRB fill:#50a0d2,color:#fff
    style CR fill:#f5a623,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style Create fill:#e8e8e8
    style Delete fill:#e8e8e8
    style Get fill:#e8e8e8
    style List fill:#e8e8e8
    style Patch fill:#e8e8e8
    style Update fill:#e8e8e8
    style Watch fill:#e8e8e8
    style InitUse fill:#f0f0f0
    style NoAppAuth fill:#ffe6cc,stroke:#d79b00
