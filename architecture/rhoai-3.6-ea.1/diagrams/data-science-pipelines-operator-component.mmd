graph TB
    subgraph "Data Science Pipelines Operator"
        direction TB
        Controller["DSPAReconciler<br/>(controller-runtime)"]
        Webhook["Webhook Server<br/>:9443/TCP TLS"]
        Metrics["Metrics Server<br/>:8080/TCP TLS"]
        Health["Health/Readiness<br/>:8081/TCP"]
        TLSWatcher["SecurityProfileWatcher<br/>(TLS profile monitor)"]
        Manifestival["Manifestival Engine<br/>(template rendering)"]

        Controller -->|"validates/mutates"| Webhook
        Controller -->|"renders templates"| Manifestival
        TLSWatcher -->|"triggers restart on<br/>TLS profile change"| Controller
    end

    User["Data Scientist / Admin"] -->|"creates/updates"| DSPACR["DataSciencePipelinesApplication CR"]
    DSPACR -->|"watched by (For)"| Controller

    subgraph "Reconciled Child Resources"
        direction LR
        Deployments["Deployments"]
        Services["Services"]
        SA["ServiceAccounts"]
        Roles["Roles & RoleBindings"]
        Routes["Routes"]
        NetPol["NetworkPolicies"]
        PVC["PVCs"]
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
    end

    Controller -->|"creates/owns<br/>(dsp-version label)"| Deployments
    Controller -->|"creates/owns"| Services
    Controller -->|"creates/owns"| SA
    Controller -->|"creates/owns"| Roles
    Controller -->|"creates/owns"| Routes
    Controller -->|"creates/owns"| NetPol
    Controller -->|"creates/owns"| PVC
    Controller -->|"creates/owns"| ConfigMaps
    Controller -->|"creates/owns"| Secrets

    subgraph "Pipeline Stack (per namespace)"
        direction TB
        APIServer["Pipeline API Server"]
        PersistenceAgent["Persistence Agent"]
        ScheduledWF["Scheduled Workflow Controller"]
        ArgoEngine["Argo Workflow Engine"]
        DB["MariaDB / External DB"]
        ObjStore["MinIO / External S3"]
    end

    Controller -->|"deploys"| APIServer
    Controller -->|"deploys"| PersistenceAgent
    Controller -->|"deploys"| ScheduledWF
    Controller -->|"deploys"| ArgoEngine
    Controller -->|"configures"| DB
    Controller -->|"configures"| ObjStore

    subgraph "Platform Integrations"
        direction LR
        MLflow["MLflow<br/>(mlflow.opendatahub.io)"]
        KServe["KServe<br/>(serving.kserve.io)"]
        Ray["Ray / CodeFlare<br/>(ray.io, workload.codeflare.dev)"]
        Seldon["Seldon<br/>(machinelearning.seldon.io)"]
        PrometheusOp["prometheus-operator"]
    end

    Controller -->|"watches CRs"| MLflow
    Controller -->|"watches InferenceServices"| KServe
    Controller -->|"manages clusters/jobs"| Ray
    Controller -->|"manages deployments"| Seldon
    Controller -->|"creates ServiceMonitors"| PrometheusOp

    Controller -->|"CRUD via HTTPS/6443"| K8sAPI["Kubernetes API Server"]
    Controller -->|"reads TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>(config.openshift.io)"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style TLSWatcher fill:#4a90e2,stroke:#333,color:#fff
    style Manifestival fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style DSPACR fill:#f5a623,stroke:#333
    style APIServer fill:#7ed321,stroke:#333
    style PersistenceAgent fill:#7ed321,stroke:#333
    style ScheduledWF fill:#7ed321,stroke:#333
    style ArgoEngine fill:#7ed321,stroke:#333
    style DB fill:#e8e8e8,stroke:#333
    style ObjStore fill:#e8e8e8,stroke:#333
    style MLflow fill:#b8d4f0,stroke:#333
    style KServe fill:#b8d4f0,stroke:#333
    style Ray fill:#b8d4f0,stroke:#333
    style Seldon fill:#b8d4f0,stroke:#333
    style PrometheusOp fill:#b8d4f0,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
