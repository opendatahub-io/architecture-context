graph TB
    subgraph External["PLATFORM OPERATOR (Trusted Internal)"]
        PlatformOp["Platform Operator<br/>(odh-operator / rhods-operator)<br/>Creates Trainer CR"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        direction TB

        Controller["trainer-operator-controller-manager<br/>SA: trainer-operator-controller-manager"]

        subgraph Endpoints["Exposed Endpoints"]
            MetricsEP["Metrics<br/>8080/TCP HTTP<br/>No TLS ⚠<br/>No Auth ⚠"]
            HealthEP["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth (by design)"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8080/TCP"]
    end

    subgraph ManagedNS["APPLICATION NAMESPACE (Managed)"]
        direction TB
        TrainerResources["Kubeflow Trainer v2<br/>TrainJobs<br/>TrainingRuntimes<br/>ClusterTrainingRuntimes"]
        ManagedK8s["Deployments, Services<br/>ConfigMaps, Webhooks<br/>NetworkPolicies"]
        ImageStreams["ImageStreams<br/>(OpenShift only)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>(via PodMonitor)"]
    end

    subgraph Dependencies["PLATFORM DEPENDENCIES"]
        JobSetOp["JobSetOperator<br/>operator.openshift.io<br/>(OpenShift only)"]
        JobSetCRD["JobSet CRD<br/>jobset.x-k8s.io<br/>(Kubernetes)"]
        PromOp["prometheus-operator<br/>monitoring.coreos.com"]
        OLM["OLM<br/>operators.coreos.com"]
    end

    %% Flows
    PlatformOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"Watch events<br/>HTTPS/WSS<br/>TLS 1.2+"| Controller
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount<br/>(CRUD operations)"| K8sAPI
    Controller --> MetricsEP
    Controller --> HealthEP
    MetricsSvc -->|"TCP/8080"| MetricsEP
    Prometheus -->|"HTTP/8080<br/>No TLS<br/>No Auth"| MetricsSvc

    Controller -.->|"manages via K8s API"| TrainerResources
    Controller -.->|"manages via K8s API"| ManagedK8s
    Controller -.->|"manages via K8s API"| ImageStreams

    Controller -.->|"checks status"| JobSetOp
    Controller -.->|"checks existence"| JobSetCRD
    Controller -.->|"creates PodMonitors"| PromOp
    Controller -.->|"lists conditions"| OLM

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef dependency fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef warning fill:#ff6666,stroke:#cc0000,stroke-width:2px,color:#fff

    class PlatformOp external
    class K8sAPI controlplane
    class Controller,MetricsSvc,HealthEP operator
    class MetricsEP warning
    class TrainerResources,ManagedK8s,ImageStreams managed
    class Prometheus monitoring
    class JobSetOp,JobSetCRD,PromOp,OLM dependency
