graph TB
    subgraph External["NO EXTERNAL INGRESS"]
        direction TB
        NoIngress["This component has no<br/>external-facing endpoints"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph ControllerPod["trainer-operator-controller-manager"]
            Manager["Manager Process<br/>FIPS: strictfipsruntime<br/>CGO_ENABLED=1"]
            MetricsPort["Metrics Endpoint<br/>:8080/TCP HTTP<br/>No TLS (SecureServing=false)<br/>No Auth"]
            ProbePort["Probes<br/>:8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8080/TCP"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token + RBAC"]
    end

    subgraph Dependencies["DEPENDENCIES"]
        JobSetOp["JobSet Operator<br/>operator.openshift.io<br/>Hard prerequisite (OpenShift)<br/>CRD + CR + Health verified"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (Target Namespace)"]
        direction TB
        TrainJobs["TrainJobs<br/>trainer.kubeflow.org"]
        Runtimes["TrainingRuntimes<br/>ClusterTrainingRuntimes<br/>trainer.kubeflow.org"]
        JobSets["JobSets<br/>jobset.x-k8s.io"]
        OtherRes["Deployments, Services,<br/>ConfigMaps, RBAC,<br/>ImageStreams, NetworkPolicies,<br/>PodMonitors"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>PodMonitor scrape"]
    end

    %% Flows
    Manager -->|HTTP/8080<br/>No TLS<br/>No Auth| MetricsPort
    MetricsPort --> MetricsSvc
    Prometheus -->|HTTP/8080<br/>Cluster-internal| MetricsSvc
    Manager --> ProbePort

    Manager -->|HTTPS/6443<br/>TLS 1.2+<br/>SA Token + RBAC| K8sAPI
    Manager -->|Dependency check<br/>via K8s API| JobSetOp

    K8sAPI -->|Watch events<br/>Trainer CR| Manager
    Manager -->|Apply manifests<br/>Field owner: trainer-module-controller| TrainJobs
    Manager -->|Apply manifests| Runtimes
    Manager -->|Apply manifests| JobSets
    Manager -->|Apply manifests| OtherRes

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px,stroke-dasharray:5 5
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef dependency fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class NoIngress external
    class Manager,MetricsPort,ProbePort,MetricsSvc operator
    class K8sAPI controlplane
    class JobSetOp dependency
    class TrainJobs,Runtimes,JobSets,OtherRes managed
    class Prometheus monitoring
