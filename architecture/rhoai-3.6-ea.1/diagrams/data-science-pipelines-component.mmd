graph TB
    subgraph DSP["Data Science Pipelines"]
        subgraph ControlPlane["Control Plane"]
            APIServer["ml-pipeline API Server<br/>gRPC :8887 / HTTP :8888<br/>Webhooks :8443"]
            PersistenceAgent["Persistence Agent<br/>Syncs workflow state"]
            ScheduledWF["Scheduled Workflow Controller<br/>Manages recurring runs"]
            CacheServer["Cache Server<br/>Admission Webhooks :443"]
            CacheDeployer["Cache Deployer<br/>Webhook cert lifecycle"]
        end

        subgraph ExecutionEngine["Execution Engine"]
            WorkflowController["Argo Workflow Controller"]
            Driver["Driver<br/>Step execution manager"]
            LauncherV2["Launcher-v2<br/>Container launcher"]
        end

        subgraph MetadataServices["Metadata & Lineage"]
            MLMD["ML Metadata (MLMD)<br/>gRPC :8080"]
            MetadataEnvoy["Metadata Envoy Proxy<br/>:9090"]
            MetadataWriter["Metadata Writer<br/>Pod metadata sync"]
        end

        subgraph Frontend["Frontend"]
            UI["ml-pipeline-ui<br/>:80 → :3000"]
            VizServer["Visualization Server<br/>:8888"]
            ViewerController["Viewer CRD Controller"]
        end

        subgraph Storage["Persistence"]
            MySQL["MySQL :3306"]
            S3Storage["S3-Compatible Storage<br/>(MinIO/SeaweedFS)"]
        end
    end

    %% User interactions
    User[Data Scientist] -->|"REST/gRPC<br/>TokenReview Auth"| APIServer
    User -->|"Browse pipelines"| UI

    %% CRD interactions
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"] -->|watched by| APIServer
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"] -->|validated/mutated| CacheServer

    %% Internal flows
    APIServer -->|creates| ArgoWF["Argo Workflow CR"]
    ArgoWF -->|orchestrated by| WorkflowController
    WorkflowController -->|launches| Driver
    Driver -->|launches| LauncherV2
    PersistenceAgent -->|watches| ArgoWF
    PersistenceAgent -->|syncs state| APIServer
    ScheduledWF -->|creates| ArgoWF

    %% Data persistence
    APIServer -->|persists metadata| MySQL
    APIServer -->|stores artifacts| S3Storage
    MetadataWriter -->|writes lineage| MLMD
    MLMD -->|proxied via| MetadataEnvoy
    UI -->|queries| APIServer
    VizServer -->|serves visualizations| UI

    %% External dependencies
    APIServer -->|TokenReview / SAR| K8sAPI[Kubernetes API]
    APIServer -->|creates/watches| K8sAPI

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style PersistenceAgent fill:#4a90e2,stroke:#333,color:#fff
    style ScheduledWF fill:#4a90e2,stroke:#333,color:#fff
    style CacheServer fill:#4a90e2,stroke:#333,color:#fff
    style WorkflowController fill:#7ed321,stroke:#333,color:#fff
    style Driver fill:#7ed321,stroke:#333,color:#fff
    style LauncherV2 fill:#7ed321,stroke:#333,color:#fff
    style MLMD fill:#9b59b6,stroke:#333,color:#fff
    style MetadataEnvoy fill:#9b59b6,stroke:#333,color:#fff
    style MetadataWriter fill:#9b59b6,stroke:#333,color:#fff
    style MySQL fill:#f5a623,stroke:#333,color:#fff
    style S3Storage fill:#f5a623,stroke:#333,color:#fff
    style UI fill:#3498db,stroke:#333,color:#fff
    style VizServer fill:#3498db,stroke:#333,color:#fff
    style PipelineCR fill:#e67e22,stroke:#333,color:#fff
    style PipelineVersionCR fill:#e67e22,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
