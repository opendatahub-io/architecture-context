graph TB
    subgraph DSP["Data Science Pipelines"]
        direction TB

        subgraph APIServer["ml-pipeline API Server"]
            GRPC["gRPC Gateway<br/>10 services"]
            REST["REST Endpoints<br/>upload, healthz, artifacts"]
            AuthN["TokenReview<br/>Authenticator"]
            AuthZ["SubjectAccessReview<br/>Authorizer"]
            GRPC --> AuthN
            REST --> AuthN
            AuthN --> AuthZ
        end

        subgraph Controllers["Controllers"]
            PersistAgent["Persistence Agent<br/>SA: ml-pipeline-persistenceagent"]
            SchedWF["Scheduled Workflow<br/>Controller<br/>SA: ml-pipeline-scheduledworkflow"]
            ViewerCtrl["Viewer CRD<br/>Controller<br/>SA: ml-pipeline-viewer-crd"]
            CacheServer["Cache Server<br/>Mutating Webhook<br/>Port 443/8443"]
        end

        subgraph Metadata["Metadata Layer"]
            MetadataEnvoy["Metadata Envoy<br/>Port 9090"]
            MetadataGRPC["Metadata gRPC Store<br/>ml_metadata_store_server<br/>Port 8080"]
            MetadataWriter["Metadata Writer"]
            MetadataEnvoy --> MetadataGRPC
        end

        subgraph Frontend["Frontend"]
            UI["ml-pipeline-ui<br/>Port 3000"]
            VizServer["Visualization Server<br/>Port 8888"]
        end
    end

    %% CRDs
    PipelineCR["Pipeline CR<br/>pipelines.kubeflow.org/v2beta1"]
    PipelineVersionCR["PipelineVersion CR<br/>pipelines.kubeflow.org/v2beta1"]
    ScheduledWFCR["ScheduledWorkflow CR<br/>kubeflow.org"]
    ViewerCR["Viewer CR<br/>kubeflow.org"]

    %% External components
    Client["Client / User"] -->|"gRPC/REST<br/>8443, 8887, 8888"| APIServer
    Client -->|"HTTP/80"| UI

    %% CRD relationships
    PipelineCR -->|"watched by"| APIServer
    PipelineVersionCR -->|"validated/mutated"| CacheServer
    ScheduledWFCR -->|"reconciled by"| SchedWF
    ViewerCR -->|"reconciled by"| ViewerCtrl

    %% Internal flows
    PersistAgent -->|"syncs state"| ArgoWF["Argo Workflows<br/>workflow-controller"]
    SchedWF -->|"creates"| ArgoWF
    MetadataWriter -->|"watches"| ArgoWF

    %% Data stores
    APIServer -->|"3306/TCP"| MySQL["MySQL<br/>Port 3306"]
    APIServer -->|"S3 API"| S3["S3-Compatible Storage<br/>SeaweedFS / MinIO"]
    UI -->|"API calls"| APIServer
    ViewerCtrl -->|"creates"| VizDeploy["Visualization<br/>Deployments"]

    %% Kubernetes API
    AuthN -->|"TokenReview"| K8sAPI["Kubernetes API<br/>6443/TCP"]
    AuthZ -->|"SubjectAccessReview"| K8sAPI

    %% Styling
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style GRPC fill:#5a9fe2,stroke:#333,color:#fff
    style REST fill:#5a9fe2,stroke:#333,color:#fff
    style AuthN fill:#e24a4a,stroke:#333,color:#fff
    style AuthZ fill:#e24a4a,stroke:#333,color:#fff
    style PersistAgent fill:#7ed321,stroke:#333
    style SchedWF fill:#7ed321,stroke:#333
    style ViewerCtrl fill:#7ed321,stroke:#333
    style CacheServer fill:#7ed321,stroke:#333
    style MetadataEnvoy fill:#9b59b6,stroke:#333,color:#fff
    style MetadataGRPC fill:#9b59b6,stroke:#333,color:#fff
    style MetadataWriter fill:#9b59b6,stroke:#333,color:#fff
    style UI fill:#3498db,stroke:#333,color:#fff
    style VizServer fill:#3498db,stroke:#333,color:#fff
    style PipelineCR fill:#f5a623,stroke:#333
    style PipelineVersionCR fill:#f5a623,stroke:#333
    style ScheduledWFCR fill:#f5a623,stroke:#333
    style ViewerCR fill:#f5a623,stroke:#333
    style MySQL fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ArgoWF fill:#e8e8e8,stroke:#333
