graph TB
    subgraph "OpenVINO Model Server (OVMS)"
        direction TB
        OVMSBinary["/ovms/bin/ovms<br/>C++ Inference Engine"]
        RESTEndpoint["REST API<br/>Port 8080/TCP"]
        gRPCEndpoint["gRPC API<br/>Port 9000/TCP"]
        Metrics["/metrics<br/>Prometheus Endpoint"]
        OVMSBinary --> RESTEndpoint
        OVMSBinary --> gRPCEndpoint
        RESTEndpoint --> Metrics
    end

    subgraph "Optional mTLS Sidecar"
        direction TB
        NginxProxy["nginx Reverse Proxy<br/>TLSv1.2 + Client Certs"]
        Wrapper["ovms_wrapper Script<br/>Port Reassignment"]
        NginxProxy --> Wrapper
    end

    subgraph "Serving Runtime Definitions"
        direction TB
        ClusterRT["kserve-openvino<br/>ClusterServingRuntime<br/>REST:8080 / gRPC:9000<br/>Formats: OpenVINO, ONNX,<br/>TensorFlow, HuggingFace"]
        NamespacedRT["kserve-ovms-2026-2<br/>ServingRuntime (Namespaced)<br/>REST:8888 / gRPC:8001<br/>+Paddle, PyTorch, vLLM<br/>GPU: latest-gpu tag"]
    end

    Client[External Client] -->|"KServe v2 REST/gRPC"| RESTEndpoint
    Client -->|"KServe v2 gRPC"| gRPCEndpoint
    Client -->|"mTLS (optional)"| NginxProxy
    NginxProxy -->|"localhost (plaintext)"| OVMSBinary

    KServe[KServe Control Plane] -->|"manages lifecycle"| ClusterRT
    KServe -->|"manages lifecycle"| NamespacedRT
    ClusterRT -->|"instantiates"| OVMSBinary
    NamespacedRT -->|"instantiates"| OVMSBinary

    ModelStorage["/mnt/models<br/>Model Storage Volume"] -->|"volume mount"| OVMSBinary
    Prometheus["Prometheus"] -->|"scrapes /metrics"| Metrics
    Dashboard["ODH Dashboard"] -->|"discovers via label"| NamespacedRT

