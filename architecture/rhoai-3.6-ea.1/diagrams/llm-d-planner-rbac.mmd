        DBAdmin["DB_ADMIN_PASSWORD<br/>Type: env var<br/>Purpose: DB admin access"]
        AAKey["AA_API_KEY<br/>Type: env var<br/>Purpose: Application API key"]
        ModelToken["MODEL_CATALOG_TOKEN<br/>Type: env var<br/>Purpose: Model catalog access"]
        OpenAIKey["OPENAI_API_KEY<br/>Type: env var<br/>Purpose: OpenAI API auth"]
    end

    SA_Backend -.->|"mounts"| PlannerSecrets
    SA_Backend -.->|"env"| HFToken
    SA_Backend -.->|"env"| DBAdmin
    SA_Backend -.->|"env"| AAKey
    SA_Backend -.->|"env"| ModelToken
    SA_Backend -.->|"env"| OpenAIKey

    subgraph AuthWarnings["Authentication Gaps"]
        NoAuth["WARNING: No app-level auth<br/>37 endpoints unauthenticated<br/>CORS: allow_origins=[*]"]
        NoOAuth["WARNING: No OAuth proxy<br/>on OpenShift Routes"]
    end

