graph LR
    OVMS["OpenVINO Model Server<br/>(OVMS)"]

    %% Internal Platform Dependencies
    OVMS -->|"ServingRuntime CR<br/>runtime-host"| KServe["KServe"]
    OVMS -->|"volume-mount<br/>/mnt/models"| ModelStorage["Model Storage<br/>(S3 / PVC)"]

    %% External Dependencies (Go client libraries)
    OVMS -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>v1.79.3"]
    OVMS -->|"protobuf serialization"| Protobuf["google.golang.org/protobuf<br/>v1.36.10"]
    OVMS -->|"proto support"| GolangProtobuf["github.com/golang/protobuf<br/>v1.5.4"]
    OVMS -->|"image resize"| Resize["github.com/nfnt/resize"]
    OVMS -->|"computer vision"| GoCV["gocv.io/x/gocv<br/>v0.35.0"]

    %% Runtime
    OVMS -->|"Go client runtime"| GoRuntime["Go 1.24"]

    %% Integration Points
    Prometheus["Prometheus"] -->|"scrapes /metrics<br/>8888/TCP"| OVMS
    KServe -->|"manages pods via<br/>ServingRuntime CRD"| OVMS

    %% Optional
    OVMS -.->|"optional mTLS<br/>sidecar"| Nginx["nginx-mtls-auth"]
    OVMS -.->|"optional traffic mgmt"| Istio["Istio Service Mesh"]

    %% Model Formats Supported
    subgraph ModelFormats["Supported Model Formats"]
        OpenVINO_IR["OpenVINO IR"]
        ONNX["ONNX"]
        TensorFlow["TensorFlow"]
        PyTorch["PyTorch"]
        PaddlePaddle["PaddlePaddle"]
        VLLM["vLLM"]
    end
    ModelStorage -->|"provides"| ModelFormats

    style OVMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333
    style ModelStorage fill:#7ed321,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style GRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style GolangProtobuf fill:#999,stroke:#333
    style Resize fill:#999,stroke:#333
    style GoCV fill:#999,stroke:#333
    style GoRuntime fill:#999,stroke:#333
    style Nginx fill:#f5a623,stroke:#333
    style Istio fill:#f5a623,stroke:#333
    style OpenVINO_IR fill:#dae8fc,stroke:#6c8ebf
    style ONNX fill:#dae8fc,stroke:#6c8ebf
    style TensorFlow fill:#dae8fc,stroke:#6c8ebf
    style PyTorch fill:#dae8fc,stroke:#6c8ebf
    style PaddlePaddle fill:#dae8fc,stroke:#6c8ebf
    style VLLM fill:#dae8fc,stroke:#6c8ebf
