graph TB
    subgraph "mlflow-operator"
        direction TB

        subgraph Manager["Controller Manager Process"]
            direction TB
            MLflowCtrl["MLflow Controller<br/>(MLflowReconciler)"]
            OperatorCtrl["MLflowOperator Controller<br/>(MLflowOperatorReconciler)"]
            NSCtrl["Namespace RBAC Controller<br/>(NamespaceRBACReconciler)"]
            HelmRenderer["Helm Chart Renderer<br/>(charts/mlflow)"]
            TLSWatcher["TLS Profile Watcher"]
            GCRBACCache["GCRBACWatchCache<br/>(garbage-collection RBAC)"]
        end

        subgraph Endpoints["Endpoints"]
            Metrics[":8443/metrics<br/>HTTPS, TokenReview+SAR"]
            Health[":8081/healthz<br/>HTTP, unauthenticated"]
            Ready[":8081/readyz<br/>HTTP, unauthenticated"]
        end
    end

    %% CRDs watched
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)<br/>Cluster-scoped"]
    MLflowOperatorCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    MLflowConfigCR["MLflowConfig CR<br/>(mlflow.kubeflow.org/v1)<br/>Namespace-scoped"]

    %% Managed resources
    subgraph ManagedResources["Managed Resources (per MLflow instance)"]
        Deploy["Deployment"]
        Svc["Service"]
        SA["ServiceAccount"]
        PVC["PersistentVolumeClaim"]
        Secret["Secret"]
        Job["Job / CronJob"]
        NetPol["NetworkPolicy"]
    end

    %% Conditional resources
    subgraph ConditionalResources["Conditional Resources (CRD discovery)"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]
        ConsoleLink["ConsoleLink<br/>(OpenShift Console)"]
    end

    %% RBAC resources
    subgraph RBACResources["RBAC Resources"]
        ClusterRole["ClusterRole"]
        ClusterRoleBinding["ClusterRoleBinding"]
        RoleBinding["RoleBinding<br/>(per namespace)"]
    end

    %% CR → Controller flows
    MLflowCR -->|"watched by (For)"| MLflowCtrl
    MLflowCR -->|"watched by (Watches)"| OperatorCtrl
    MLflowCR -->|"watched by (Watches)"| NSCtrl
    MLflowOperatorCR -->|"watched by (For)"| OperatorCtrl
    MLflowOperatorCR -->|"watched by (Watches)"| MLflowCtrl
    MLflowConfigCR -->|"read by"| MLflowCtrl

    %% Controller → resource management
    MLflowCtrl -->|"renders via"| HelmRenderer
    HelmRenderer -->|"produces"| ManagedResources
    MLflowCtrl -->|"creates (conditional)"| ConditionalResources
    MLflowCtrl -->|"manages via GCRBACCache"| GCRBACCache
    GCRBACCache -->|"manages"| ClusterRole
    GCRBACCache -->|"manages"| ClusterRoleBinding
    NSCtrl -->|"manages"| RoleBinding

    %% TLS Profile
    TLSWatcher -->|"watches"| APIServer["apiservers.config.openshift.io/cluster"]
    TLSWatcher -->|"triggers shutdown on change"| Manager

    %% External dependencies
    MLflowCtrl -->|"HTTPS/6443"| K8sAPI["Kubernetes API"]

    %% Styling
    style MLflowCtrl fill:#4a90e2,stroke:#333,color:#fff
    style OperatorCtrl fill:#4a90e2,stroke:#333,color:#fff
    style NSCtrl fill:#4a90e2,stroke:#333,color:#fff
    style HelmRenderer fill:#6c5ce7,stroke:#333,color:#fff
    style TLSWatcher fill:#6c5ce7,stroke:#333,color:#fff
    style GCRBACCache fill:#6c5ce7,stroke:#333,color:#fff
    style MLflowCR fill:#f5a623,stroke:#333,color:#000
    style MLflowOperatorCR fill:#f5a623,stroke:#333,color:#000
    style MLflowConfigCR fill:#f5a623,stroke:#333,color:#000
    style HTTPRoute fill:#7ed321,stroke:#333,color:#000
    style ServiceMonitor fill:#7ed321,stroke:#333,color:#000
    style ConsoleLink fill:#7ed321,stroke:#333,color:#000
    style Metrics fill:#e8e8e8,stroke:#333
    style Health fill:#e8e8e8,stroke:#333
    style Ready fill:#e8e8e8,stroke:#333
    style APIServer fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
