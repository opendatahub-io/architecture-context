graph TB
    subgraph External["EXTERNAL (Monitoring)"]
        Prometheus["Prometheus<br/>Scrapes Metrics"]
    end

    subgraph OperatorPod["OPERATOR POD (opendatahub-feast-system)"]
        direction TB

        subgraph MetricsEndpoint["Metrics Endpoint"]
            MetricsServer["Metrics Server<br/>8443/TCP HTTPS<br/>TLS (self-signed)<br/>Auth: RBAC<br/>(TokenReview + SAR)"]
        end

        subgraph HealthEndpoint["Health Probes"]
            HealthProbes["Health Server<br/>8081/TCP HTTP<br/>No encryption<br/>No auth<br/>/healthz, /readyz"]
        end

        subgraph ControllerCore["Controller"]
            Controller["FeastOperator Controller<br/>SA: opendatahub-feast-operator<br/>Image: UBI9-minimal (FIPS)<br/>GOEXPERIMENT=strictfipsruntime"]
        end
    end

    subgraph KubeAPI["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
    end

    subgraph WatchedResources["WATCHED RESOURCES (via K8s API)"]
        direction TB
        FeastOperatorCR["FeastOperator CR<br/>components.platform.opendatahub.io<br/>Cluster-scoped"]
        CRDWatch["CustomResourceDefinitions<br/>apiextensions.k8s.io<br/>Component label filter"]
        PlatformCM["Platform ConfigMap<br/>Version config"]
        FeastCR["Feast FeatureStore CR<br/>feast.dev"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (via K8s API)"]
        direction TB
        Deployments["Deployments<br/>Services<br/>ServiceAccounts"]
        RBACRes["ClusterRoles<br/>ClusterRoleBindings<br/>Roles, RoleBindings"]
        MonitorRes["ServiceMonitors<br/>Jobs, CronJobs"]
    end

    %% Flows
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>RBAC Auth"| MetricsServer

    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| APIServer

    APIServer -->|"Watch events"| FeastOperatorCR
    APIServer -->|"Watch events"| CRDWatch
    APIServer -->|"Watch events"| PlatformCM
    APIServer -->|"Watch events"| FeastCR

    APIServer -->|"CRUD operations"| Deployments
    APIServer -->|"CRUD operations"| RBACRes
    APIServer -->|"CRUD operations"| MonitorRes

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef kubeapi fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef watched fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Prometheus external
    class MetricsServer,HealthProbes,Controller operator
    class APIServer kubeapi
    class FeastOperatorCR,CRDWatch,PlatformCM,FeastCR watched
    class Deployments,RBACRes,MonitorRes managed
