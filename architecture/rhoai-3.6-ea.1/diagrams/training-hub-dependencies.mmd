graph LR
    TrainingHub["Training Hub<br/>(Python SDK)"]

    %% Internal RHOAI Dependencies (Backend Libraries)
    TrainingHub -->|"SFT backend<br/>library-import"| InstructLab["instructlab-training<br/>>=0.14.0"]
    TrainingHub -->|"OSFT backend<br/>library-import"| MiniTrainer["rhai-innovation-mini-trainer<br/>>=0.6.0"]

    %% Core ML Framework Dependencies
    TrainingHub -->|"training compute"| PyTorch["torch >=2.6.0"]
    TrainingHub -->|"model loading"| Transformers["transformers >=4.57.6"]
    TrainingHub -->|"distributed training"| Accelerate["accelerate >=0.34.2"]
    TrainingHub -->|"LoRA adapters"| PEFT["peft >=0.15"]
    TrainingHub -->|"RL training"| TRL["trl >=0.18.0"]

    %% Algorithm-specific Dependencies
    TrainingHub -->|"LoRA SFT backend"| Unsloth["unsloth >=2026.1.1"]
    TrainingHub -->|"GRPO backend"| ART["openpipe-art >=0.5.17"]
    TrainingHub -->|"GRPO alt backend"| VeRL["verl >=0.7"]
    TrainingHub -->|"GEPA backend"| GEPA["gepa >=0.1.1"]
    TrainingHub -->|"LLM API client"| LiteLLM["litellm >=1.71.1"]
    TrainingHub -->|"experiment tracking"| MLflow["mlflow >=3.5.0"]

    %% GPU/Accelerator Dependencies
    TrainingHub -.->|"GPU attention"| FlashAttn["flash-attn >=2.8"]
    TrainingHub -.->|"GPU memory opt"| XFormers["xformers >=0.0.33"]
    TrainingHub -.->|"quantization"| BitsAndBytes["bitsandbytes >=0.47.0"]

    %% Data Processing Dependencies
    TrainingHub -->|"datasets"| Datasets["datasets >=4.0.0"]
    TrainingHub -->|"data frames"| Pandas["pandas >=2.2"]
    TrainingHub -->|"numerics"| NumPy["numpy >=1.26.4"]

    %% Integration Points (Runtime)
    TrainingHub ==>|"outbound HTTPS<br/>API key auth"| LLMAPI["LLM Inference API<br/>(OPENAI_API_BASE)"]
    TrainingHub ==>|"HTTP/HTTPS<br/>optional"| MLflowServer["MLflow Tracking Server"]
    TrainingHub ==>|"in-process<br/>co-located"| vLLMEngine["vLLM Engine"]

