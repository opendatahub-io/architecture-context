graph LR
    MLServer["MLServer<br/>V2 Inference Protocol Server"]

    %% Internal Platform Dependencies
    MLServer -->|"container runtime"| KServe["KServe<br/>ServingRuntime Host"]
    MLServer -->|"distributed tracing"| OTel["OpenTelemetry Collector<br/>(OTLP/gRPC)"]
    MLServer -.->|"async inference"| Kafka["Kafka<br/>(Optional)"]

    %% Core Framework Dependencies
    MLServer -->|"REST framework"| FastAPI["FastAPI >=0.134.0<br/>+ Starlette >=1.0.1"]
    MLServer -->|"ASGI server"| Uvicorn["uvicorn<br/>+ uvloop"]
    MLServer -->|"gRPC transport"| gRPC["grpcio >=1.67.1<br/>+ protobuf >=5.27.2"]
    MLServer -->|"data validation"| Pydantic["Pydantic ^2.7.1<br/>+ pydantic-settings"]

    %% Observability Dependencies
    MLServer -->|"tracing SDK"| OTelSDK["opentelemetry-sdk ^1.22.0<br/>+ OTLP exporter"]
    MLServer -->|"REST metrics"| StarletteExp["starlette-exporter"]
    MLServer -->|"gRPC metrics"| GRPCProm["py-grpc-prometheus"]

    %% ML Runtime Backends
    MLServer -->|"sklearn runtime"| SKLearn["scikit-learn"]
    MLServer -->|"xgboost runtime"| XGBoost["xgboost"]
    MLServer -->|"lightgbm runtime"| LightGBM["lightgbm"]
    MLServer -->|"onnx runtime"| ONNX["onnxruntime >=1.20.0<br/>+ onnx >=1.21.0"]
    MLServer -->|"mlflow runtime"| MLflow["mlflow >=2.19.0"]
    MLServer -->|"huggingface runtime"| HuggingFace["HuggingFace<br/>optimum >=1.4"]
    MLServer -->|"catboost runtime"| CatBoost["catboost"]
    MLServer -->|"spark runtime"| PySpark["pyspark"]
    MLServer -->|"alibi detect"| AlibiDetect["alibi-detect"]
    MLServer -->|"alibi explain"| AlibiExplain["alibi"]

    %% Deep Learning
    MLServer -->|"torch backend"| PyTorch["torch"]
    MLServer -->|"tensorflow backend"| TF["tensorflow<br/>+ tf-keras >=2.16.0"]

    %% Data Libraries
    MLServer -->|"data handling"| NumPy["numpy"]
    MLServer -->|"data handling"| Pandas["pandas"]

    %% Platform Integration
    KServe -->|"manages"| KRBP["kube-rbac-proxy<br/>(Auth Sidecar)"]

    %% Styling
    style MLServer fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333
    style OTel fill:#7ed321,stroke:#333
    style Kafka fill:#999,stroke:#333,stroke-dasharray: 5 5
    style KRBP fill:#e74c3c,stroke:#333,color:#fff

