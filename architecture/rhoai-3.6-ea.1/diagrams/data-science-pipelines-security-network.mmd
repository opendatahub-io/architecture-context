graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist / Client"]
    end

    subgraph APILayer["API LAYER (Control Plane - Namespace: kubeflow)"]
        APIServer["ml-pipeline API Server<br/>SA: ml-pipeline<br/>gRPC :8887 | HTTP :8888 | Webhook :8443<br/>TLS certs from configurable paths<br/>FIPS: GOFIPS140=v1.0.0"]
    end

    subgraph AdmissionLayer["ADMISSION WEBHOOKS (TLS)"]
        CacheServer["Cache Server<br/>SA: kubeflow-pipelines-cache<br/>:443 → webhook-api<br/>TLS: webhook-server-tls"]
        CacheDeployer["Cache Deployer<br/>SA: kubeflow-pipelines-cache-deployer-sa<br/>Manages webhook certs"]
    end

    subgraph ExecutionLayer["EXECUTION LAYER (Workflow Pods)"]
        ArgoWF["Argo Workflow Controller<br/>v3.7.14"]
        Driver["Driver Pod<br/>FIPS: GOFIPS140=v1.0.0<br/>CGO_ENABLED=0 (static)"]
        LauncherV2["Launcher-v2 Pod"]
        PipelineRunner["Pipeline Runner<br/>SA: pipeline-runner<br/>(broad RBAC)"]
    end

    subgraph StateSync["STATE SYNCHRONIZATION"]
        PA["Persistence Agent<br/>SA: ml-pipeline-persistenceagent"]
        SWC["Scheduled Workflow Controller<br/>SA: ml-pipeline-scheduledworkflow"]
    end

    subgraph MetadataLayer["METADATA & LINEAGE"]
        MetadataEnvoy["Metadata Envoy Proxy<br/>:9090/TCP"]
        MLMD["ML Metadata Server<br/>:8080/TCP gRPC"]
        MetadataWriter["Metadata Writer<br/>SA: kubeflow-pipelines-metadata-writer"]
    end

    subgraph FrontendLayer["FRONTEND"]
        PipelineUI["ml-pipeline-ui<br/>SA: ml-pipeline-ui<br/>:80 → :3000"]
        VizServer["Visualization Server<br/>:8888/TCP"]
        ViewerCtrl["Viewer CRD Controller<br/>SA: ml-pipeline-viewer-crd-service-account"]
    end

    subgraph DataStores["DATA STORES (Istio-protected)"]
        MySQL["MySQL<br/>:3306/TCP<br/>Istio AuthorizationPolicy<br/>Secret: mysql-secret"]
        S3["S3-Compatible Storage<br/>Configurable endpoint<br/>AWS SDK v2<br/>Secret: mlpipeline-minio-artifact"]
    end

    subgraph K8sServices["KUBERNETES SERVICES"]
        K8sAPI["Kubernetes API<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount tokens"]
    end

    subgraph Ingress["INGRESS"]
        VS["metadata-grpc VirtualService<br/>Hosts: *"]
    end

    %% External flows
    Client -->|"REST :8888 / gRPC :8887<br/>TokenReview + SAR Auth"| APIServer

    %% API Server connections
    APIServer -->|"HTTPS :6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    APIServer -->|"MySQL :3306<br/>Istio mTLS<br/>mysql-secret"| MySQL
    APIServer -->|"HTTP/S<br/>AWS IAM / static keys"| S3

    %% Admission webhooks
    K8sAPI -->|"POST :8443 TLS<br/>Mutating + Validating<br/>pipelineversions"| CacheServer
    CacheDeployer -.->|"manages certs"| CacheServer

    %% Execution flows
    APIServer -->|"Creates Workflow CRs"| K8sAPI
    ArgoWF -->|"Launches pods"| Driver
    Driver -->|"Launches containers"| LauncherV2
    LauncherV2 -->|"Artifact I/O"| S3

    %% State sync
    PA -->|"Watches workflows<br/>via K8s API"| K8sAPI
    PA -->|"Reports status"| APIServer
    SWC -->|"Creates Workflow CRs<br/>on schedule"| K8sAPI

    %% Metadata
    MetadataWriter -->|"gRPC :9090"| MetadataEnvoy
    MetadataEnvoy -->|"gRPC :8080"| MLMD
    VS -->|"Routes to"| MetadataEnvoy

    %% Frontend
    Client -->|"HTTP :80"| PipelineUI
    PipelineUI -->|"REST :8888"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#4a90e2,stroke:#2c5282,stroke-width:2px,color:#fff
    classDef admission fill:#e67e22,stroke:#d35400,stroke-width:2px,color:#fff
    classDef execution fill:#27ae60,stroke:#1e8449,stroke-width:2px,color:#fff
    classDef state fill:#8e44ad,stroke:#6c3483,stroke-width:2px,color:#fff
    classDef metadata fill:#2980b9,stroke:#1a5276,stroke-width:2px,color:#fff
    classDef frontend fill:#3498db,stroke:#2471a3,stroke-width:2px,color:#fff
    classDef datastore fill:#f39c12,stroke:#d68910,stroke-width:2px,color:#fff
    classDef k8s fill:#999,stroke:#666,stroke-width:2px,color:#fff
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class Client external
    class APIServer api
    class CacheServer,CacheDeployer admission
    class ArgoWF,Driver,LauncherV2,PipelineRunner execution
    class PA,SWC state
    class MetadataEnvoy,MLMD,MetadataWriter metadata
    class PipelineUI,VizServer,ViewerCtrl frontend
    class MySQL,S3 datastore
    class K8sAPI k8s
    class VS ingress
