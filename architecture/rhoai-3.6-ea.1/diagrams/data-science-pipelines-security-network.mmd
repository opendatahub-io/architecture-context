graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / SDK"]
    end

    subgraph APILayer["API LAYER"]
        MLPipeline["ml-pipeline API Server<br/>8443/TCP, 8887/TCP, 8888/TCP<br/>SA: ml-pipeline<br/>FIPS: GOFIPS140=v1.0.0<br/>AuthN: TokenReview<br/>AuthZ: SubjectAccessReview"]

        subgraph Webhooks["Admission Webhooks"]
            ValidatingWH["Validating Webhook<br/>/webhooks/validate-pipelineversion<br/>8443/TCP TLS<br/>FailurePolicy: Fail"]
            MutatingWH["Mutating Webhook<br/>/webhooks/mutate-pipelineversion<br/>8443/TCP TLS<br/>FailurePolicy: Fail"]
        end
    end

    subgraph DataStores["DATA STORES"]
        MySQL["MySQL 8.4<br/>3306/TCP<br/>Istio AuthorizationPolicy<br/>Secret: mysql-secret (Opaque)"]
        SeaweedFS["SeaweedFS (S3-Compatible)<br/>8333/TCP (S3 API)<br/>Secret: mlpipeline-minio-artifact"]
    end

    subgraph MetadataLayer["METADATA LAYER"]
        MetaEnvoy["Metadata Envoy<br/>9090/TCP"]
        MetaGRPC["Metadata gRPC Store<br/>ml_metadata_store_server:1.14.0<br/>8080/TCP"]
        MetaWriter["Metadata Writer<br/>SA: kubeflow-pipelines-metadata-writer"]
    end

    subgraph ControllerLayer["CONTROLLERS"]
        PersistAgent["Persistence Agent<br/>SA: ml-pipeline-persistenceagent"]
        SchedWF["Scheduled Workflow Controller<br/>SA: ml-pipeline-scheduledworkflow"]
        ViewerCtrl["Viewer CRD Controller<br/>SA: ml-pipeline-viewer-crd-service-account"]
    end

    subgraph CacheLayer["CACHE WEBHOOK"]
        CacheServer["Cache Server<br/>443/TCP → webhook-api<br/>TLS: webhook-server-tls<br/>SA: kubeflow-pipelines-cache"]
    end

    subgraph FrontendLayer["FRONTEND"]
        MLUI["ml-pipeline-ui<br/>80/TCP → 3000/TCP<br/>SA: ml-pipeline-ui"]
        VizServer["Visualization Server<br/>8888/TCP (Python)"]
    end

    subgraph WorkflowEngine["WORKFLOW ENGINE"]
        ArgoWF["Argo Workflow Controller<br/>v3.7.14<br/>SA: pipeline-runner"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>SA Token Auth"]
        Prometheus["Prometheus<br/>8888/TCP scrape<br/>HTTP"]
    end

    subgraph Ingress["INGRESS"]
        VirtualSvc["metadata-grpc VirtualService<br/>Hosts: *<br/>HTTP"]
    end

    %% External flows
    Client -->|"gRPC/REST<br/>8443/TCP<br/>Bearer Token"| MLPipeline

    %% API Server to data stores
    MLPipeline -->|"MySQL Protocol<br/>3306/TCP<br/>mysql-secret"| MySQL
    MLPipeline -->|"S3 API (AWS SDK v2)<br/>HTTP/HTTPS<br/>Path-style addressing"| SeaweedFS

    %% API Server to Kubernetes
    MLPipeline -->|"HTTPS<br/>6443/TCP<br/>TokenReview + SAR"| K8sAPI

    %% Controllers to K8s API
    PersistAgent -->|"HTTPS<br/>6443/TCP<br/>SA Token"| K8sAPI
    SchedWF -->|"HTTPS<br/>6443/TCP<br/>SA Token"| K8sAPI
    ViewerCtrl -->|"HTTPS<br/>6443/TCP<br/>SA Token"| K8sAPI

    %% Controller flows
    PersistAgent -.->|"Watch Workflows"| ArgoWF
    SchedWF -.->|"Create Workflows"| ArgoWF
    MetaWriter -.->|"Watch Workflows"| ArgoWF

    %% Metadata flows
    MetaWriter -->|"gRPC<br/>9090/TCP"| MetaEnvoy
    MetaEnvoy -->|"gRPC<br/>8080/TCP"| MetaGRPC
    VirtualSvc -->|"HTTP<br/>9090/TCP"| MetaEnvoy

    %% Cache webhook
    ArgoWF -->|"Pod admission<br/>443/TCP TLS"| CacheServer

    %% Frontend
    Client -->|"HTTP<br/>80/TCP"| MLUI
    MLUI -->|"API calls"| MLPipeline

    %% Monitoring
    Prometheus -.->|"Scrape<br/>8888/TCP HTTP"| MLPipeline

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef metadata fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cache fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef frontend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workflow fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef extsvc fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef webhook fill:#f5a623,stroke:#333,stroke-width:1px

    class Client external
    class MLPipeline api
    class ValidatingWH,MutatingWH webhook
    class MySQL,SeaweedFS datastore
    class MetaEnvoy,MetaGRPC,MetaWriter metadata
    class PersistAgent,SchedWF,ViewerCtrl controller
    class CacheServer cache
    class MLUI,VizServer frontend
    class ArgoWF workflow
    class K8sAPI,Prometheus extsvc
    class VirtualSvc ingress
