graph TD
    subgraph "vllm-cpu Authentication Model"
        direction TB

        subgraph "HTTP API Authentication"
            APIKey["VLLM_API_KEY / --api-key<br/>Environment Variable or CLI Flag"]
            AuthMW["AuthenticationMiddleware<br/>(ASGI Middleware)"]
            SHA256["Token Validation<br/>SHA-256 constant-time compare<br/>secrets.compare_digest"]

            APIKey -->|"configures"| AuthMW
            AuthMW -->|"validates via"| SHA256
        end

        subgraph "Guarded Paths (Auth Required)"
            V1["/v1/* endpoints<br/>chat/completions, completions,<br/>embeddings, rerank, score,<br/>audio, messages, responses"]
            V2["/v2/* endpoints<br/>embed, rerank"]
            Inference["/inference/* endpoints<br/>generate"]
        end

        subgraph "Unguarded Paths (No Auth)"
            Health["/health<br/>Health check"]
            Ready["/ready, /readyz<br/>Readiness probes"]
            Load["/load<br/>Load status"]
            Docs["/docs<br/>API documentation"]
            Ping["/ping<br/>Liveness"]
        end

        subgraph "gRPC API (No Authentication)"
            GRPCPort["Port 50051<br/>Insecure binding"]
            VllmEngine["VllmEngine Service<br/>No auth enforcement"]
            GRPCHealth["grpc.health.v1.Health<br/>No auth enforcement"]

            GRPCPort --> VllmEngine
            GRPCPort --> GRPCHealth
        end

        SHA256 -->|"token valid"| V1
        SHA256 -->|"token valid"| V2
        SHA256 -->|"token valid"| Inference
        SHA256 -->|"token invalid"| Reject["401 Unauthorized"]

        AuthMW -->|"bypass (no auth needed)"| Health
        AuthMW -->|"bypass"| Ready
        AuthMW -->|"bypass"| Load
        AuthMW -->|"bypass"| Docs
        AuthMW -->|"bypass"| Ping
    end

    subgraph "Platform-Managed RBAC"
        KServeRBAC["KServe / ModelMesh RBAC<br/>(manages container permissions)"]
        Note["No ClusterRoles or RoleBindings<br/>defined by vllm-cpu itself.<br/>RBAC is delegated to the<br/>deploying platform."]
    end

    KServeRBAC -.->|"deploys with<br/>ServiceAccount"| AuthMW
    KServeRBAC -.->|"deploys with<br/>ServiceAccount"| GRPCPort

    style APIKey fill:#f5a623,stroke:#333
    style AuthMW fill:#f5a623,stroke:#333
    style SHA256 fill:#f5a623,stroke:#333
    style Reject fill:#e74c3c,stroke:#333,color:#fff
    style V1 fill:#ffe6cc,stroke:#d79b00
    style V2 fill:#ffe6cc,stroke:#d79b00
    style Inference fill:#ffe6cc,stroke:#d79b00
    style Health fill:#d5e8d4,stroke:#82b366
    style Ready fill:#d5e8d4,stroke:#82b366
    style Load fill:#d5e8d4,stroke:#82b366
    style Docs fill:#d5e8d4,stroke:#82b366
    style Ping fill:#d5e8d4,stroke:#82b366
    style GRPCPort fill:#fff2cc,stroke:#d6b656
    style VllmEngine fill:#fff2cc,stroke:#d6b656
    style GRPCHealth fill:#fff2cc,stroke:#d6b656
    style KServeRBAC fill:#dae8fc,stroke:#6c8ebf
    style Note fill:#f9f9f9,stroke:#999
