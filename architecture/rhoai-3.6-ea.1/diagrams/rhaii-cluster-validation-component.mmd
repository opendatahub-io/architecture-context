graph TB
    subgraph "rhaii-cluster-validation CLI"
        direction TB
        CLI["rhaii-validator CLI<br/>(Cobra)"]
        Controller["Controller<br/>pkg/controller"]
        GPUCheck["GPU Check<br/>pkg/checks/gpu"]
        RDMACheck["RDMA Check<br/>pkg/checks/rdma"]
        NetworkCheck["Network Check<br/>pkg/checks/network"]
        CRDCheck["CRD Check<br/>pkg/checks/crd"]
        OperatorCheck["Operator Check<br/>pkg/checks/operator"]
        Config["Platform Config<br/>pkg/config/platforms"]
    end

    subgraph "Validation Modes"
        direction LR
        Tier1["Tier 1: Dependency Check<br/>(API-only, no resources created)"]
        Tier2["Tier 2: Node Validation<br/>(per-node Jobs, privileged)"]
    end

    subgraph "Kubernetes Cluster"
        direction TB
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]

        subgraph "rhaii-validation namespace"
            SA["ServiceAccount<br/>rhaii-validator"]
            Jobs["Agent Jobs<br/>(per GPU node)"]
            CM["ConfigMap Reports"]
        end

        subgraph "Validation Targets"
            GatewayAPICRD["Gateway API CRDs"]
            InferencePoolCRD["InferencePool CRD"]
            LWSCRD["LeaderWorkerSet CRD"]
            CertManagerCRD["cert-manager CRD"]
            IstioPods["Istio Operator Pods"]
            CertManagerPods["cert-manager Pods"]
            LWSPods["LeaderWorkerSet Pods"]
        end
    end

    Admin["Administrator<br/>(kubeconfig)"] -->|invokes| CLI
    CLI -->|parses args| Controller
    Controller -->|loads| Config
    Controller -->|Tier 1| CRDCheck
    Controller -->|Tier 1| OperatorCheck
    Controller -->|Tier 2| GPUCheck
    Controller -->|Tier 2| RDMACheck
    Controller -->|Tier 2| NetworkCheck

    CRDCheck -->|queries| K8sAPI
    OperatorCheck -->|queries| K8sAPI
    Controller -->|creates namespace, RBAC, Jobs| K8sAPI
    K8sAPI -->|schedules| Jobs
    Jobs -->|write results| CM
    Controller -->|streams logs, reads| CM

    CRDCheck -.->|validates| GatewayAPICRD
    CRDCheck -.->|validates| InferencePoolCRD
    CRDCheck -.->|validates| LWSCRD
    CRDCheck -.->|validates| CertManagerCRD
    OperatorCheck -.->|validates| IstioPods
    OperatorCheck -.->|validates| CertManagerPods
    OperatorCheck -.->|validates| LWSPods

    Tier1 -.->|uses| CRDCheck
    Tier1 -.->|uses| OperatorCheck
    Tier2 -.->|uses| GPUCheck
    Tier2 -.->|uses| RDMACheck
    Tier2 -.->|uses| NetworkCheck

    style CLI fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style GPUCheck fill:#7ed321,stroke:#333
    style RDMACheck fill:#7ed321,stroke:#333
    style NetworkCheck fill:#7ed321,stroke:#333
    style CRDCheck fill:#7ed321,stroke:#333
    style OperatorCheck fill:#7ed321,stroke:#333
    style Config fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Jobs fill:#f5a623,stroke:#333
    style SA fill:#f5a623,stroke:#333
    style CM fill:#f5a623,stroke:#333
    style Tier1 fill:#d5e8d4,stroke:#82b366
    style Tier2 fill:#ffe6cc,stroke:#d79b00
