graph TB
    subgraph "rhaii-cluster-validation CLI"
        direction TB
        CLI["Cobra CLI Entrypoint<br/>(rhaii-validator / kubectl-rhaii_validate)"]
        Controller["Controller<br/>(pkg/controller)"]
        Agent["Agent Sub-commands<br/>(run, tcp-lat-server, tcp-lat-client)"]
        CRDChecker["CRD/Operator Checker<br/>(pkg/checks/crd)"]
        PlatformConfig["Platform Config<br/>(pkg/config/platforms)"]

        CLI -->|dispatches suite| Controller
        Controller -->|launches Jobs| Agent
        Controller -->|deps suite| CRDChecker
        Controller -->|loads config| PlatformConfig
    end

    Admin[Administrator] -->|"invokes<br/>gpu|network|rdma|deps|all"| CLI

    subgraph "Kubernetes Cluster"
        direction TB
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
        Namespace["Namespace<br/>(rhaii-validation)"]
        SA["ServiceAccount<br/>(rhaii-validator)"]
        Jobs["Per-Node Agent Jobs"]
        ConfigMap["Results ConfigMap"]

        Namespace --> SA
        Namespace --> Jobs
        Namespace --> ConfigMap
    end

    Controller -->|"creates NS, SA,<br/>RBAC, Jobs"| K8sAPI
    Controller -->|"stores results"| ConfigMap
    CRDChecker -->|"queries CRDs<br/>& operator NS"| K8sAPI
    K8sAPI --> Namespace

    subgraph "Worker Nodes"
        direction TB
        GPU["GPU Hardware<br/>(driver, ECC, memory)"]
        RDMA["RDMA Devices<br/>(InfiniBand)"]
        Sysfs["/sys/class/infiniband<br/>PCI Topology"]
        Network["Network Stack<br/>(iperf3, TCP latency)"]
    end

    Jobs -->|"privileged SCC<br/>host sysfs access"| GPU
    Jobs -->|"ibv_rc_pingpong<br/>ib_write_bw"| RDMA
    Jobs -->|reads| Sysfs
    Jobs -->|"port 12865<br/>echo server"| Network

    subgraph "Validation Targets (deps suite)"
        GatewayAPI["Gateway API CRDs"]
        InferencePool["InferencePool CRD"]
        LWS["LeaderWorkerSet CRD"]
        CertManager["cert-manager CRD"]
        IstioOp["Istio Operator"]
        LWSop["LWS Operator"]
        CertManagerOp["cert-manager Operator"]
    end

    CRDChecker -.->|"checks presence"| GatewayAPI
    CRDChecker -.->|"checks presence"| InferencePool
    CRDChecker -.->|"checks presence"| LWS
    CRDChecker -.->|"checks presence"| CertManager
    CRDChecker -.->|"checks presence"| IstioOp
    CRDChecker -.->|"checks presence"| LWSop
    CRDChecker -.->|"checks presence"| CertManagerOp

    style CLI fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style Agent fill:#4a90e2,color:#fff
    style CRDChecker fill:#4a90e2,color:#fff
    style PlatformConfig fill:#4a90e2,color:#fff
    style Admin fill:#f9f9f9,stroke:#999
    style K8sAPI fill:#f5a623,color:#fff
    style ConfigMap fill:#7ed321,color:#fff
    style Jobs fill:#7ed321,color:#fff
    style GPU fill:#e8e8e8,stroke:#333
    style RDMA fill:#e8e8e8,stroke:#333
    style Sysfs fill:#e8e8e8,stroke:#333
    style Network fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#fff2cc,stroke:#d6b656
    style InferencePool fill:#fff2cc,stroke:#d6b656
    style LWS fill:#fff2cc,stroke:#d6b656
    style CertManager fill:#fff2cc,stroke:#d6b656
    style IstioOp fill:#fff2cc,stroke:#d6b656
    style LWSop fill:#fff2cc,stroke:#d6b656
    style CertManagerOp fill:#fff2cc,stroke:#d6b656
