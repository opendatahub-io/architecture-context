graph LR
    WVA["Workload Variant<br/>Autoscaler"]

    %% Core Runtime Dependencies (required)
    WVA -->|"resource ops<br/>6443/HTTPS<br/>TLS 1.2+"| K8sAPI["Kubernetes API<br/>Server"]
    WVA -->|"saturation metrics<br/>HTTP/HTTPS<br/>TLS 1.2+ Bearer/mTLS"| Prometheus["Prometheus"]
    WVA -->|"operator framework<br/>v0.22.5"| ControllerRuntime["controller-runtime"]

    %% Conditional Dependencies (optional)
    WVA -.->|"ScaledObject watch<br/>(if CRDs present)"| KEDA["KEDA v2.18.3<br/>(optional)"]
    WVA -.->|"InferencePool watch<br/>(if CRDs present)"| GatewayAPIExt["Gateway API<br/>Inference Extension<br/>v1.2.1 (optional)"]

    %% Platform Dependencies
    WVA -->|"ServiceMonitor watch"| PromOperator["Prometheus Operator<br/>v0.89.0"]
    WVA -->|"LWS scaling"| LWS["LeaderWorkerSet<br/>v0.8.0"]

    %% Key Libraries
    WVA -->|"prediction engine"| KalmanFilter["Kalman Filter<br/>v0.1.2"]
    WVA -->|"numerical compute"| Gonum["gonum<br/>v0.17.0"]
    WVA -->|"LRU caching"| LRU["golang-lru<br/>v2.0.7"]

    %% Build Dependencies
    WVA -->|"Go 1.26<br/>FIPS runtime"| Go["Go Runtime<br/>1.26"]
    WVA -->|"FIPS base image"| UBI9["UBI9 Minimal<br/>(OpenSSL FIPS)"]

    %% Observability Libraries
    WVA -->|"metrics export"| PromClient["prometheus/client_golang<br/>v1.23.2"]
    WVA -->|"structured logging"| Zap["go.uber.org/zap<br/>v1.27.1"]

    %% K8s Client Libraries
    WVA -->|"API types<br/>v0.34.5"| K8sClient["k8s.io/client-go<br/>+ api + apimachinery"]

    %% Integration Points (consumers)
    PromScraper["Prometheus Scraper"] -->|"scrapes :8443<br/>TokenReview + SAR"| WVA
    EPPReader["EPP Metrics Reader"] -.->|"reads metrics<br/>SA token"| WVA

    %% Styling
    style WVA fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333
    style Prometheus fill:#f5a623,stroke:#333
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style KEDA fill:#ccc,stroke:#999,stroke-dasharray: 5 5
    style GatewayAPIExt fill:#ccc,stroke:#999,stroke-dasharray: 5 5
    style PromOperator fill:#7ed321,stroke:#333
    style LWS fill:#7ed321,stroke:#333
    style KalmanFilter fill:#999,stroke:#333,color:#fff
    style Gonum fill:#999,stroke:#333,color:#fff
    style LRU fill:#999,stroke:#333,color:#fff
    style Go fill:#e8e8e8,stroke:#333
    style UBI9 fill:#e8e8e8,stroke:#333
    style PromClient fill:#999,stroke:#333,color:#fff
    style Zap fill:#999,stroke:#333,color:#fff
    style K8sClient fill:#999,stroke:#333,color:#fff
    style PromScraper fill:#7ed321,stroke:#333
    style EPPReader fill:#7ed321,stroke:#333
