graph TD
    subgraph ServiceAccounts["Service Accounts (Namespace: kubeflow)"]
        SA_ML["ml-pipeline"]
        SA_PA["ml-pipeline-persistenceagent"]
        SA_SWC["ml-pipeline-scheduledworkflow"]
        SA_UI["ml-pipeline-ui"]
        SA_Viewer["ml-pipeline-viewer-crd-service-account"]
        SA_Runner["pipeline-runner"]
        SA_MW["kubeflow-pipelines-metadata-writer"]
        SA_Cache["kubeflow-pipelines-cache"]
        SA_CacheDeploy["kubeflow-pipelines-cache-deployer-sa"]
        SA_Public["system:authenticated<br/>(Group)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_ML["ml-pipeline"]
        RB_PA["ml-pipeline-persistenceagent-binding"]
        RB_SWC["ml-pipeline-scheduledworkflow-binding"]
        RB_UI["ml-pipeline-ui"]
        RB_Viewer["ml-pipeline-viewer-crd-binding"]
        RB_Runner["pipeline-runner-binding"]
        RB_MW["kubeflow-pipelines-metadata-writer-binding"]
        RB_Cache["kubeflow-pipelines-cache-binding"]
        RB_CacheDeploy["kubeflow-pipelines-cache-deployer-rolebinding"]
        RB_Public["kubeflow-pipelines-public"]
    end

    subgraph Roles["Roles"]
        R_ML["ml-pipeline<br/>(most privileged)"]
        R_PA["ml-pipeline-persistenceagent-role"]
        R_SWC["ml-pipeline-scheduledworkflow-role"]
        R_UI["ml-pipeline-ui"]
        R_Viewer["ml-pipeline-viewer-controller-role"]
        R_Runner["pipeline-runner<br/>(broadest scope)"]
        R_MW["kubeflow-pipelines-metadata-writer-role"]
        R_Cache["kubeflow-pipelines-cache-role"]
        R_CacheDeploy["kubeflow-pipelines-cache-deployer-role"]
        R_Public["kubeflow-pipelines-public"]
    end

    subgraph Resources_ML["ml-pipeline Resources"]
        R_ML_Pods["pods, pods/log<br/>delete, get, list"]
        R_ML_Workflows["argoproj.io/workflows<br/>create, delete, get, list,<br/>patch, update, watch"]
        R_ML_SWF["kubeflow.org/scheduledworkflows<br/>create, delete, get, list,<br/>patch, update + finalizers"]
        R_ML_Pipelines["pipelines.kubeflow.org/<br/>pipelines, pipelineversions<br/>full CRUD + finalizers + status"]
        R_ML_Auth["authentication.k8s.io/tokenreviews<br/>authorization.k8s.io/subjectaccessreviews<br/>create"]
        R_ML_Secrets["configmaps, secrets<br/>get"]
        R_ML_MLflow["mlflow.kubeflow.org/experiments<br/>create, get, list, update"]
    end

    subgraph Resources_Runner["pipeline-runner Resources"]
        R_Run_Pods["pods, pods/exec, pods/log<br/>services, PVCs, PVs<br/>*"]
        R_Run_Apps["apps/deployments, replicasets<br/>*"]
        R_Run_Batch["batch/jobs<br/>*"]
        R_Run_KF["kubeflow.org/*<br/>*"]
        R_Run_WF["argoproj.io/workflows<br/>get, list, patch, update, watch"]
        R_Run_Seldon["machinelearning.seldon.io<br/>seldondeployments: *"]
        R_Run_Secrets["secrets: get<br/>configmaps: get, list, watch"]
    end

    subgraph Resources_Other["Other Role Resources"]
        R_PA_Res["workflows, scheduledworkflows<br/>get, list, watch<br/>runs: readArtifact, reportMetrics"]
        R_SWC_Res["workflows, scheduledworkflows<br/>full CRUD + finalizers<br/>runs: create | events: create, patch"]
        R_UI_Res["pods/log: get | events: list<br/>configmaps, secrets: get, list<br/>viewers: CRUD | workflows: get, list"]
        R_Viewer_Res["deployments, services: full CRUD<br/>viewers, viewers/finalizers: full CRUD"]
        R_MW_Res["pods: get, list, patch, update, watch<br/>workflows: get, list, patch, update, watch<br/>configmaps: get"]
        R_Cache_Res["pods: get, list, patch, update, watch<br/>workflows: get, list, patch, update, watch<br/>configmaps: get"]
        R_CacheDeploy_Res["secrets: create, delete,<br/>get, list, patch"]
        R_Public_Res["configmaps: get, list, watch"]
    end

    %% SA → RB → Role chains
    SA_ML -->|bound via| RB_ML
    RB_ML -->|grants| R_ML

    SA_PA -->|bound via| RB_PA
    RB_PA -->|grants| R_PA

    SA_SWC -->|bound via| RB_SWC
    RB_SWC -->|grants| R_SWC

    SA_UI -->|bound via| RB_UI
    RB_UI -->|grants| R_UI

    SA_Viewer -->|bound via| RB_Viewer
    RB_Viewer -->|grants| R_Viewer

    SA_Runner -->|bound via| RB_Runner
    RB_Runner -->|grants| R_Runner

    SA_MW -->|bound via| RB_MW
    RB_MW -->|grants| R_MW

    SA_Cache -->|bound via| RB_Cache
    RB_Cache -->|grants| R_Cache

    SA_CacheDeploy -->|bound via| RB_CacheDeploy
    RB_CacheDeploy -->|grants| R_CacheDeploy

    SA_Public -->|bound via| RB_Public
    RB_Public -->|grants| R_Public

    %% Role → Resources
    R_ML --> R_ML_Pods
    R_ML --> R_ML_Workflows
    R_ML --> R_ML_SWF
    R_ML --> R_ML_Pipelines
    R_ML --> R_ML_Auth
    R_ML --> R_ML_Secrets
    R_ML --> R_ML_MLflow

    R_Runner --> R_Run_Pods
    R_Runner --> R_Run_Apps
    R_Runner --> R_Run_Batch
    R_Runner --> R_Run_KF
    R_Runner --> R_Run_WF
    R_Runner --> R_Run_Seldon
    R_Runner --> R_Run_Secrets

    R_PA --> R_PA_Res
    R_SWC --> R_SWC_Res
    R_UI --> R_UI_Res
    R_Viewer --> R_Viewer_Res
    R_MW --> R_MW_Res
    R_Cache --> R_Cache_Res
    R_CacheDeploy --> R_CacheDeploy_Res
    R_Public --> R_Public_Res

