graph TB
    subgraph OperatorPod["model-registry-operator-controller-manager"]
        Manager["Manager Process<br/>/manager"]
        MRReconciler["ModelRegistryReconciler"]
        MCReconciler["ModelCatalogReconciler"]
        SVMStrategy["SVMStrategy<br/>CRD Version Migration"]
        WebhookServer["Webhook Server"]
        Manager --> MRReconciler
        Manager --> MCReconciler
        Manager --> SVMStrategy
        Manager --> WebhookServer
    end

    %% CRDs
    ModelRegistryCR["ModelRegistry CR<br/>modelregistry.opendatahub.io<br/>v1alpha1 / v1beta1"]

    %% Webhooks
    WebhookServer -->|"/validate-..."| ValidateWH["Validating Webhook<br/>CREATE, UPDATE"]
    WebhookServer -->|"/mutate-..."| MutateWH["Mutating Webhook<br/>CREATE, UPDATE"]
    WebhookServer -->|"/convert"| ConvertWH["Conversion Webhook<br/>v1alpha1 ↔ v1beta1"]

    %% CR triggers reconciliation
    ModelRegistryCR -->|"watched by"| MRReconciler

    %% Registry instance resources
    subgraph RegistryInstance["Per-Registry Instance Resources"]
        direction TB
        RestDeploy["{registry-name} Deployment<br/>rest-container + kube-rbac-proxy"]
        PostgresDeploy["{registry-name}-postgres<br/>Deployment"]
        RegistrySvc["{registry-name} Service<br/>8080/TCP, 8443/TCP"]
        PostgresSvc["{registry-name}-postgres Service<br/>5432/TCP"]
        RegistrySA["{registry-name}<br/>ServiceAccount"]
        RegistryRBAC["Role + RoleBinding<br/>registry-user-{registry-name}"]
        NetPol["NetworkPolicy"]
    end

    MRReconciler -->|"creates/manages"| RestDeploy
    MRReconciler -->|"creates/manages"| PostgresDeploy
    MRReconciler -->|"creates/manages"| RegistrySvc
    MRReconciler -->|"creates/manages"| PostgresSvc
    MRReconciler -->|"creates/manages"| RegistrySA
    MRReconciler -->|"creates/manages"| RegistryRBAC
    MRReconciler -->|"creates/manages"| NetPol

    %% Model Catalog resources
    subgraph CatalogInstance["Model Catalog Resources"]
        direction TB
        CatalogDeploy["model-catalog Deployment<br/>catalog + kube-rbac-proxy"]
        CatalogPostgres["model-catalog-postgres<br/>Deployment"]
        CatalogSvc["model-catalog Service<br/>8080/TCP, 8443/TCP"]
        CatalogPostgresSvc["model-catalog-postgres Service<br/>5432/TCP"]
    end

    MCReconciler -->|"creates/manages"| CatalogDeploy
    MCReconciler -->|"creates/manages"| CatalogPostgres
    MCReconciler -->|"creates/manages"| CatalogSvc
    MCReconciler -->|"creates/manages"| CatalogPostgresSvc

    %% Ingress resources
    subgraph Ingress["Ingress Resources"]
        OSRoute["{registry-name}-https<br/>OpenShift Route"]
        HTTPRoute["model-registry-{registry-name}<br/>Gateway API HTTPRoute"]
        CatalogRoute["model-catalog-https<br/>OpenShift Route"]
        CatalogHTTPRoute["model-catalog<br/>Gateway API HTTPRoute"]
    end

    MRReconciler -->|"creates"| OSRoute
    MRReconciler -->|"creates"| HTTPRoute
    MCReconciler -->|"creates"| CatalogRoute
    MCReconciler -->|"creates"| CatalogHTTPRoute

    %% External dependencies
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    IngressConfig["config.openshift.io/v1<br/>Ingress"]
    DSGateway["data-science-gateway<br/>Gateway"]

    Manager -->|"authenticates via SA"| K8sAPI
    MRReconciler -->|"reads cluster domain"| IngressConfig
    HTTPRoute -->|"references"| DSGateway
    CatalogHTTPRoute -->|"references"| DSGateway

    %% SVM
    SVMStrategy -->|"creates"| SVMResource["StorageVersionMigration<br/>v1alpha1 → v1beta1"]

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style MRReconciler fill:#4a90e2,stroke:#333,color:#fff
    style MCReconciler fill:#4a90e2,stroke:#333,color:#fff
    style SVMStrategy fill:#4a90e2,stroke:#333,color:#fff
    style WebhookServer fill:#4a90e2,stroke:#333,color:#fff
    style ModelRegistryCR fill:#f5a623,stroke:#333
    style RestDeploy fill:#7ed321,stroke:#333
    style PostgresDeploy fill:#7ed321,stroke:#333
    style CatalogDeploy fill:#7ed321,stroke:#333
    style CatalogPostgres fill:#7ed321,stroke:#333
    style OSRoute fill:#e8e8e8,stroke:#333
    style HTTPRoute fill:#e8e8e8,stroke:#333
    style CatalogRoute fill:#e8e8e8,stroke:#333
    style CatalogHTTPRoute fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style IngressConfig fill:#999,stroke:#333,color:#fff
    style DSGateway fill:#999,stroke:#333,color:#fff
