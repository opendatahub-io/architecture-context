graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["kubeflow-trainer-controller-manager<br/>(ServiceAccount)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Controller["kubeflow-trainer-controller-manager<br/>(ClusterRoleBinding, cluster-scoped)"]
    end

    subgraph ControllerRole["ClusterRole: kubeflow-trainer-controller-manager"]
        direction TB
        CR_Controller["kubeflow-trainer-controller-manager"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles (RBAC aggregation)"]
        direction TB
        CR_Admin["training-admin<br/>(aggregates to admin)"]
        CR_Edit["training-edit<br/>(aggregates to edit)"]
        CR_View["training-view<br/>(aggregates to view)"]
    end

    subgraph ControllerResources["Controller API Resources"]
        direction TB

        subgraph TrainerAPIs["trainer.kubeflow.org"]
            TrainJobs["trainjobs<br/>get, list, patch, update, watch"]
            TrainingRuntimes["trainingruntimes<br/>get, list, patch, update, watch"]
            ClusterTrainingRuntimes["clustertrainingruntimes<br/>get, list, patch, update, watch"]
            Finalizers["trainjobs/finalizers<br/>trainingruntimes/finalizers<br/>clustertrainingruntimes/finalizers<br/>get, patch, update"]
            Status["trainjobs/status<br/>get, patch, update"]
        end

        subgraph SchedulingAPIs["Scheduling APIs"]
            JobSets["jobset.x-k8s.io<br/>jobsets<br/>create, get, list, patch, update, watch"]
            PodGroupsVolcano["scheduling.volcano.sh<br/>podgroups<br/>create, get, list, patch, update, watch"]
            PodGroupsCoSched["scheduling.x-k8s.io<br/>podgroups<br/>create, get, list, patch, update, watch"]
        end

        subgraph NetworkAPIs["Networking APIs"]
            NetworkPolicies["networking.k8s.io<br/>networkpolicies<br/>create, get, list, patch, update, watch"]
        end

        subgraph CoreAPIs["Core APIs"]
            ConfigMaps["core<br/>configmaps<br/>create, get, list, patch, update, watch"]
            Secrets["core<br/>secrets<br/>create, get, list, patch, update, watch"]
            Pods["core<br/>pods<br/>get, list"]
            Events["core<br/>events<br/>create, patch, update, watch"]
            LimitRanges["core<br/>limitranges<br/>get, list, watch"]
        end

        subgraph ClusterAPIs["Cluster APIs"]
            Webhooks["admissionregistration.k8s.io<br/>validatingwebhookconfigurations<br/>get, list, update, watch"]
            APIServers["config.openshift.io<br/>apiservers<br/>get"]
            Leases["coordination.k8s.io<br/>leases<br/>create, get, list, update"]
            RuntimeClasses["node.k8s.io<br/>runtimeclasses<br/>get, list, watch"]
        end
    end

    subgraph UserResources["User-facing API Resources"]
        direction TB
        AdminTrainJobs["trainer.kubeflow.org<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>create, delete, get, list,<br/>patch, update, watch"]
        AdminStatus["trainjobs/status,<br/>trainingruntimes/status,<br/>clustertrainingruntimes/status<br/>get"]
        EditTrainJobs["trainer.kubeflow.org<br/>trainjobs<br/>create, delete, get, list,<br/>patch, update, watch"]
        EditRuntimes["trainer.kubeflow.org<br/>clustertrainingruntimes,<br/>trainingruntimes<br/>get, list, watch"]
        ViewResources["trainer.kubeflow.org<br/>trainjobs, trainingruntimes,<br/>clustertrainingruntimes<br/>get, list, watch"]
    end

    %% Controller bindings
    SA_Controller -->|"bound via"| CRB_Controller
    CRB_Controller -->|"grants"| CR_Controller

    %% Controller role to resources
    CR_Controller -->|"manages"| TrainJobs
    CR_Controller -->|"manages"| TrainingRuntimes
    CR_Controller -->|"manages"| ClusterTrainingRuntimes
    CR_Controller -->|"manages"| Finalizers
    CR_Controller -->|"manages"| Status
    CR_Controller -->|"manages"| JobSets
    CR_Controller -->|"manages"| PodGroupsVolcano
    CR_Controller -->|"manages"| PodGroupsCoSched
    CR_Controller -->|"manages"| NetworkPolicies
    CR_Controller -->|"manages"| ConfigMaps
    CR_Controller -->|"manages"| Secrets
    CR_Controller -->|"reads"| Pods
    CR_Controller -->|"manages"| Events
    CR_Controller -->|"reads"| LimitRanges
    CR_Controller -->|"manages"| Webhooks
    CR_Controller -->|"reads"| APIServers
    CR_Controller -->|"manages"| Leases
    CR_Controller -->|"reads"| RuntimeClasses

    %% Aggregated roles to user resources
    CR_Admin -->|"full CRUD"| AdminTrainJobs
    CR_Admin -->|"read"| AdminStatus
    CR_Edit -->|"full CRUD"| EditTrainJobs
    CR_Edit -->|"read"| EditRuntimes
    CR_View -->|"read-only"| ViewResources

    %% Styling
    style SA_Controller fill:#4a90e2,color:#fff
    style CRB_Controller fill:#5b9bd5,color:#fff
    style CR_Controller fill:#f5a623,color:#fff
    style CR_Admin fill:#e74c3c,color:#fff
    style CR_Edit fill:#f39c12,color:#fff
    style CR_View fill:#27ae60,color:#fff
    style TrainJobs fill:#7ed321,color:#fff
    style TrainingRuntimes fill:#7ed321,color:#fff
    style ClusterTrainingRuntimes fill:#7ed321,color:#fff
    style JobSets fill:#7ed321,color:#fff
    style PodGroupsVolcano fill:#7ed321,color:#fff
    style PodGroupsCoSched fill:#7ed321,color:#fff
    style NetworkPolicies fill:#7ed321,color:#fff
