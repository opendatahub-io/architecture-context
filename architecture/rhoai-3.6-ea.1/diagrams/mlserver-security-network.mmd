graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph Platform["PLATFORM LAYER (TLS Termination)"]
        Route["OpenShift Route / Istio Gateway<br/>HTTPS → HTTP<br/>TLS Termination"]
    end

    subgraph KServePod["KSERVE POD (Auth Boundary)"]
        direction TB

        subgraph AuthSidecar["Auth Sidecar"]
            KRBP["kube-rbac-proxy<br/>OpenShift OAuth/SA Token Validation<br/>Auth Enforcement Point"]
        end

        subgraph MLServer["MLSERVER (No App-Level TLS)"]
            direction TB

            RESTServer["REST Server (FastAPI/uvicorn)<br/>8080/TCP HTTP (plaintext)<br/>No TLS configured"]
            GRPCServer["gRPC Server<br/>8081/TCP gRPC (insecure port)<br/>add_insecure_port"]
            MetricsServer["Metrics Server<br/>8082/TCP HTTP<br/>No Auth"]

            DataPlane["DataPlane Handler"]

            TrustedGate["Trusted Runtimes Gate<br/>/etc/mlserver/trusted-runtimes.json<br/>Blocks untrusted implementations"]

            subgraph Runtimes["Model Runtimes (Allowlisted)"]
                RT["sklearn | xgboost | lightgbm<br/>onnx | mlflow | huggingface<br/>catboost | mllib | alibi"]
            end
        end
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>gRPC (OTLP)"]
        Prom["Prometheus<br/>Scrapes /metrics"]
    end

    subgraph OptionalServices["OPTIONAL SERVICES"]
        Kafka["Kafka Broker<br/>Kafka Protocol<br/>Async Inference"]
    end

    %% External flows
    Client -->|"HTTPS<br/>TLS (platform)<br/>Bearer Token"| Route
    Route -->|"HTTP<br/>Cluster-internal"| KRBP

    %% Auth to MLServer
    KRBP -->|"HTTP/8080<br/>Plaintext (localhost)<br/>Pre-authenticated"| RESTServer
    KRBP -->|"gRPC/8081<br/>Plaintext (localhost)<br/>Pre-authenticated"| GRPCServer

    %% Internal routing
    RESTServer --> DataPlane
    GRPCServer --> DataPlane
    DataPlane --> TrustedGate
    TrustedGate -->|"Allowed"| RT

    %% Observability
    RESTServer -.->|"OTLP/gRPC<br/>Traces"| OTel
    GRPCServer -.->|"OTLP/gRPC<br/>Traces"| OTel
    Prom -.->|"HTTP/8082<br/>Scrape"| MetricsServer

    %% Optional
    Kafka -.->|"Kafka Protocol<br/>Async requests"| DataPlane

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef appserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#e6d0de,stroke:#996185,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef optional fill:#e8e8e8,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Route platform
    class KRBP auth
    class RESTServer,GRPCServer,MetricsServer appserver
    class DataPlane appserver
    class TrustedGate security
    class RT runtime
    class OTel,Prom observability
    class Kafka optional
