graph LR
    TrustyAI["TrustyAI Explainability<br/>Service"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"payload ingestion<br/>POST /consumer/kserve/v2"| KServeModelMesh["KServe / ModelMesh<br/>Model Servers"]
    TrustyAI -->|"CloudEvent consumption<br/>Knative Funqy"| KServe["KServe Inference<br/>Servers"]
    TrustyAI -->|"metrics scraping<br/>GET /q/metrics"| Prometheus["Prometheus"]

    %% Optional Dependencies
    TrustyAI -.->|"Hibernate ORM<br/>(optional, inactive by default)"| MariaDB["MariaDB / MySQL"]

    %% Platform Dependencies
    TrustyAI -->|"external exposure<br/>HTTP (no TLS)"| Route["OpenShift Route"]
    TrustyAI -->|"inference data<br/>persistence at /inputs"| PVC["PVC Storage"]
    TrustyAI -->|"TLS certs from<br/>/etc/tls/internal/"| TLSCerts["Platform TLS<br/>Certificates"]
    TrustyAI -->|"init container<br/>creates ConfigMap"| K8sAPI["Kubernetes API<br/>(oc CLI)"]

    %% Knative dependency
    TrustyAI -->|"CloudEvent delivery"| Knative["Knative Eventing"]

    %% Integration Points (inbound)
    Dashboard["ODH Dashboard"] -.->|"user access"| TrustyAI

