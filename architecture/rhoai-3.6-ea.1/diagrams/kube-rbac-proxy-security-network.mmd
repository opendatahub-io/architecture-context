graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Service Consumer"]
    end

    subgraph Pod["APPLICATION POD"]
        direction TB

        subgraph SidecarProxy["kube-rbac-proxy Sidecar<br/>Image: odh-kube-rbac-proxy-rhel9<br/>FIPS: strictfipsruntime + CGO_ENABLED=1"]
            SecureListener["Secure Listener<br/>8443/TCP<br/>TLS 1.2+ (configurable)"]
            HandlerChain["Handler Chain:<br/>AllowPaths → AuthN → AuthZ → AuthHeaders"]
            HealthEndpoint["ProxyEndpoints<br/>/healthz<br/>TLS, No Auth"]
        end

        subgraph UpstreamApp["Upstream Service"]
            Upstream["Application<br/>8080/TCP HTTP<br/>localhost only"]
        end
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+"]

        subgraph APIs["APIs Consumed"]
            TokenReview["authentication.k8s.io/v1<br/>TokenReview"]
            SAR["authorization.k8s.io/v1<br/>SubjectAccessReview"]
        end
    end

    subgraph Services["CLUSTER SERVICES (ClusterIP)"]
        SvcMain["kube-rbac-proxy<br/>8443/TCP"]
        SvcOverride["kube-rbac-proxy-verb-override<br/>8443/TCP"]
    end

    %% Flows
    Client -->|"HTTPS/8443<br/>TLS 1.2+<br/>Bearer Token<br/>(OIDC or SA token)"| SecureListener
    SecureListener --> HandlerChain
    HandlerChain -->|"HTTP/8080<br/>localhost<br/>No encryption<br/>Auth headers injected"| Upstream

    HandlerChain -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    K8sAPI --- TokenReview
    K8sAPI --- SAR

    SvcMain -.->|routes to| SecureListener
    SvcOverride -.->|routes to| SecureListener

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sidecar fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef upstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef service fill:#e8e8e8,stroke:#666,stroke-width:1px

    class Client external
    class SecureListener,HandlerChain,HealthEndpoint sidecar
    class Upstream upstream
    class K8sAPI,TokenReview,SAR controlplane
    class SvcMain,SvcOverride service
