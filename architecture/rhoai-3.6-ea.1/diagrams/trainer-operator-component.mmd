graph TB
    subgraph "trainer-operator"
        Controller["trainer-operator<br/>Controller Manager"]
        Reconciler["Trainer Reconciler<br/>(Action Pipeline)"]
        Controller --> Reconciler

        subgraph "Reconciliation Actions"
            direction TB
            DepCheck["Dependency Check<br/>(JobSetOperator / JobSet CRD)"]
            NSProvision["Namespace Provisioner"]
            ManifestRender["Manifest Renderer<br/>(/opt/manifests-template<br/>/opt/runtimes-template<br/>/opt/imagestreams-template)"]
            Deploy["Deploy Action<br/>(Server-Side Apply)"]
            HealthMon["Deployment Health Monitor"]
            GC["Garbage Collector<br/>(Stale Resources)"]
            DepCheck --> NSProvision
            NSProvision --> ManifestRender
            ManifestRender --> Deploy
            Deploy --> HealthMon
            HealthMon --> GC
        end

        Reconciler --> DepCheck
        Metrics[":8080/metrics<br/>HTTP (plaintext)"]
        Health[":8081/healthz<br/>:8081/readyz"]
    end

    PlatformOp["Platform Operator<br/>(odh-operator / rhods-operator)"] -->|creates/updates| TrainerCR["Trainer CR<br/>(default-trainer)<br/>components.platform.opendatahub.io/v1alpha1"]
    TrainerCR -->|watched by| Controller

    Controller -->|HTTPS/6443| K8sAPI["Kubernetes API Server"]
    Controller -->|checks| JobSetOp["JobSetOperator<br/>(OpenShift)"]
    Controller -->|checks| JobSetCRD["JobSet CRD<br/>(Kubernetes)"]
    Controller -->|manages| TrainerResources["Kubeflow Trainer v2<br/>TrainJobs / TrainingRuntimes<br/>ClusterTrainingRuntimes"]
    Controller -->|creates| PodMonitor["PodMonitor<br/>(monitoring.coreos.com)"]

    Prometheus["Prometheus"] -->|scrapes| Metrics

    subgraph "Managed Resources"
        TrainerResources
        ManagedDeploy["Deployments"]
        ManagedSvc["Services"]
        ManagedCM["ConfigMaps"]
        ManagedWebhook["ValidatingWebhookConfigurations"]
        ImageStreams["ImageStreams<br/>(OpenShift)"]
        NetworkPolicies["NetworkPolicies"]
    end

    style Controller fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style TrainerCR fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8
    style JobSetOp fill:#e8e8e8
    style JobSetCRD fill:#e8e8e8
    style PlatformOp fill:#7ed321,color:#fff
    style Prometheus fill:#e8e8e8
    style TrainerResources fill:#7ed321,color:#fff
