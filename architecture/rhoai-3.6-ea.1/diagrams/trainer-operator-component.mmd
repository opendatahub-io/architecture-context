graph TB
    subgraph "trainer-operator"
        Manager["/manager<br/>Go controller-runtime"]
        Controller["Trainer Controller<br/>trainer_controller.go"]
        Actions["Reconciliation Pipeline"]
        Manager --> Controller
        Controller --> Actions
    end

    subgraph "Reconciliation Actions"
        CheckDeps["checkDependencies"]
        EnsureNS["ensureNamespace"]
        UpdateRel["updateReleases"]
        RenderManifests["renderManifests"]
        Deploy["deploy (field ownership)"]
        Actions --> CheckDeps
        CheckDeps --> EnsureNS
        EnsureNS --> UpdateRel
        UpdateRel --> RenderManifests
        RenderManifests --> Deploy
    end

    subgraph "Bundled Manifests"
        TrainerManifests["/opt/manifests-template/<br/>Trainer Infrastructure"]
        RuntimesTemplate["/opt/runtimes-template/<br/>Training Runtimes"]
        ImageStreams["/opt/imagestreams-template/<br/>OpenShift Image Streams"]
    end

    PlatformOperator["Platform Operator"] -->|creates/updates| TrainerCR["Trainer CR<br/>components.platform.opendatahub.io/v1alpha1"]
    TrainerCR -->|watched by| Controller

    Controller -->|renders| TrainerManifests
    Controller -->|renders| RuntimesTemplate
    Controller -->|renders| ImageStreams

    Deploy -->|creates| TrainJobs["TrainJob CRs<br/>trainer.kubeflow.org"]
    Deploy -->|creates| TrainingRuntimes["TrainingRuntime CRs<br/>trainer.kubeflow.org"]
    Deploy -->|creates| ClusterTrainingRuntimes["ClusterTrainingRuntime CRs<br/>trainer.kubeflow.org"]
    Deploy -->|creates| JobSets["JobSet CRs<br/>jobset.x-k8s.io"]

    CheckDeps -->|verifies| JobSetOperator["JobSet Operator<br/>operator.openshift.io"]

    Controller -->|depends on| PlatformUtils["odh-platform-utilities<br/>framework"]
    Controller -->|queries| K8sAPI["Kubernetes API<br/>6443/HTTPS"]

    subgraph "Observability"
        Metrics["Metrics<br/>:8080/TCP HTTP"]
        Health["Health Probe<br/>:8081/healthz"]
        Ready["Readiness Probe<br/>:8081/readyz"]
    end

    Manager --> Metrics
    Manager --> Health
    Manager --> Ready
    Prometheus["Prometheus"] -->|scrapes| Metrics

    style Manager fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style Actions fill:#4a90e2,color:#fff
    style TrainerCR fill:#f5a623,color:#fff
    style TrainJobs fill:#f5a623,color:#fff
    style TrainingRuntimes fill:#f5a623,color:#fff
    style ClusterTrainingRuntimes fill:#f5a623,color:#fff
    style JobSets fill:#f5a623,color:#fff
    style JobSetOperator fill:#e8e8e8
    style PlatformUtils fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8
    style Prometheus fill:#e8e8e8
