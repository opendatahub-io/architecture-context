graph TB
    subgraph "llm-d-inference-payload-processor"
        direction TB

        subgraph "ExtProc Server (port 9004)"
            ExtProcServer["ExtProc gRPC Server<br/>HTTP/2 | Optional TLS"]
        end

        subgraph "Plugin Pipeline"
            PreProcessors["Pre-Processors<br/>body-field-to-header<br/>base-model-to-header<br/>request-metadata"]
            ProfilePicker["Profile Picker<br/>selects processing profile"]
            PostProcessors["Post-Processors<br/>response-headers<br/>cost-metadata<br/>model-name-to-header"]
        end

        subgraph "Model Selection Plugins"
            GroupFilter["Group Filtering"]
            Scoring["Scoring Strategies<br/>cost-guard | in-flight-request<br/>session-affinity"]
            Picking["Picking Strategies<br/>random | weighted-random<br/>max-score"]
        end

        subgraph "Controller Runtime Manager"
            ConfigMapReconciler["ConfigMap Reconciler<br/>base-model mapping"]
            MetricsServer["Metrics Server<br/>port 9090 | HTTP"]
            HealthServer["Health gRPC Server<br/>port 9005 | plaintext"]
        end

        ExtProcServer -->|incoming request| PreProcessors
        PreProcessors -->|transformed request| ProfilePicker
        ProfilePicker -->|selected profile| PostProcessors
        PreProcessors -.->|model selection| GroupFilter
        GroupFilter --> Scoring
        Scoring --> Picking

        ConfigMapReconciler -->|updates mapping| PreProcessors
    end

    EnvoyProxy["Envoy Proxy<br/>port 8081"] -->|gRPC ExtProc callout| ExtProcServer
    ExtProcServer -->|modified headers/routing| EnvoyProxy

    PayloadProcessorConfigCR["PayloadProcessorConfig CR<br/>llm-d.ai/v1alpha1"] -.->|watched by| ConfigMapReconciler
    ConfigMapCR["ConfigMap Resources"] -->|reconciled by| ConfigMapReconciler

    EnvoyProxy -->|forwards to| vLLMServers["vLLM Model Servers<br/>port 8000"]

    K8sAPI["Kubernetes API<br/>port 6443"] -->|RBAC: get,list,watch<br/>configmaps| ConfigMapReconciler
    Prometheus["Prometheus"] -->|scrapes /metrics| MetricsServer

    style ExtProcServer fill:#4a90e2,stroke:#333
    style PreProcessors fill:#4a90e2,stroke:#333
    style ProfilePicker fill:#4a90e2,stroke:#333
    style PostProcessors fill:#4a90e2,stroke:#333
    style GroupFilter fill:#4a90e2,stroke:#333
    style Scoring fill:#4a90e2,stroke:#333
    style Picking fill:#4a90e2,stroke:#333
    style ConfigMapReconciler fill:#4a90e2,stroke:#333
    style MetricsServer fill:#4a90e2,stroke:#333
    style HealthServer fill:#4a90e2,stroke:#333
    style PayloadProcessorConfigCR fill:#f5a623,stroke:#333
    style ConfigMapCR fill:#f5a623,stroke:#333
    style EnvoyProxy fill:#e8e8e8,stroke:#333
    style vLLMServers fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
