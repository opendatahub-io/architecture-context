graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph Ingress["INGRESS (Istio VirtualServices)"]
        VS_API["VirtualService: model-registry<br/>/api/model_registry/*<br/>HTTP"]
        VS_Catalog["VirtualService: model-catalog<br/>HTTP"]
        VS_UI["VirtualService: model-registry-ui<br/>/model-registry/*<br/>HTTP"]
    end

    subgraph AuthzPolicies["ISTIO AUTHORIZATION POLICIES"]
        AP_Server["AuthorizationPolicy<br/>component=model-registry-server<br/>Action: ALLOW<br/>NS: kubeflow<br/>Principal: istio-ingressgateway SA<br/>Requires: authorization header"]
        AP_UI["AuthorizationPolicy<br/>app=model-registry-ui<br/>Action: ALLOW<br/>Principal: istio-ingressgateway SA"]
    end

    subgraph AppLayer["APPLICATION LAYER (FIPS: strictfipsruntime)"]
        direction TB

        subgraph HubProxyNS["Hub Proxy"]
            Proxy["model-registry binary<br/>TLS ≥ 1.2<br/>Configurable ciphers"]
            HealthProxy["Health/Readiness<br/>:8081/TCP<br/>No Auth"]
        end

        subgraph BFFNS["BFF Server"]
            BFF["BFF :4000<br/>auth-method: internal | user_token<br/>Custom CA: --bundle-paths<br/>SubjectAccessReview"]
        end

        subgraph ControllerNS["Controller Operator"]
            ControllerMgr["Controller Manager<br/>SA: controller-controller-manager<br/>Leader Election: a7d60e25.kubeflow.org"]
            Metrics["Metrics :8443/TCP<br/>TLS (self-signed)<br/>TokenReview + SAR"]
            HealthCtrl["Health/Readiness<br/>:8081/TCP<br/>No Auth"]
        end

        subgraph AsyncNS["Async Upload Job"]
            AsyncJob["Python Batch Job<br/>boto3 + sigstore"]
        end
    end

    subgraph InternalDeps["INTERNAL DEPENDENCIES"]
        K8sAPI["Kubernetes API<br/>:6443/TCP<br/>HTTPS/WSS, TLS 1.2+<br/>SA token auth"]
        KServeIS["KServe InferenceService CRs<br/>Controller watch (conditional)<br/>TLS via K8s API"]
        DB[("PostgreSQL / MySQL<br/>TCP, TLS configurable<br/>DB credentials")]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>:443/TCP HTTPS<br/>AWS IAM (SECRET_ACCESS_KEY)"]
    end

    %% External to Ingress
    Client -->|"HTTPS<br/>Bearer JWT"| VS_API
    Client -->|"HTTPS"| VS_Catalog
    Client -->|"HTTPS"| VS_UI

    %% Ingress to AuthzPolicies
    VS_API --> AP_Server
    VS_Catalog --> AP_Server
    VS_UI --> AP_UI

    %% AuthzPolicies to Application
    AP_Server -->|"mTLS<br/>Istio mesh"| Proxy
    AP_UI -->|"mTLS<br/>Istio mesh"| BFF

    %% Application to Internal
    Proxy -->|"TCP/TLS<br/>GORM"| DB
    BFF -->|"HTTPS/6443<br/>SA token"| K8sAPI
    ControllerMgr -->|"HTTPS/6443<br/>SA token"| K8sAPI
    ControllerMgr -->|"Watch<br/>HTTPS"| KServeIS
    ControllerMgr -->|"OpenAPI HTTP<br/>Sync URLs"| Proxy

    %% Application to External
    AsyncJob -->|"HTTPS/443<br/>AWS IAM"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authz fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class VS_API,VS_Catalog,VS_UI ingress
    class AP_Server,AP_UI authz
    class Proxy,HealthProxy,BFF,ControllerMgr,Metrics,HealthCtrl,AsyncJob app
    class K8sAPI,KServeIS,DB internal
    class S3 extsvc
