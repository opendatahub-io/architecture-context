graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["External User / Data Scientist"]
    end

    subgraph Ingress["INGRESS (DMZ) - Istio"]
        IstioGW["Istio Ingress Gateway<br/>443/TCP → 8080/TCP<br/>TLS Termination<br/>VirtualService routing"]
    end

    subgraph ServiceMesh["SERVICE MESH (Istio mTLS)"]
        direction TB

        subgraph NS_App["Application Namespace"]
            BFF["BFF (model-registry-ui)<br/>:8080/TCP HTTP<br/>SA: controller-controller-manager<br/>AuthZ: Istio principal check"]
            MRProxy["Model Registry API (Proxy)<br/>:8080/TCP HTTP<br/>AuthZ: namespace + principal + JWT<br/>Health: :8081 (unauth)"]
            DB["Database<br/>(PostgreSQL / MySQL)<br/>GORM connection"]
            AsyncUpload["async-upload Job<br/>Python<br/>AWS IAM credentials"]
        end

        subgraph NS_Controller["Controller Namespace"]
            Controller["InferenceService Controller<br/>Conditional: managed mode<br/>SA: controller-controller-manager"]
            Metrics["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>Self-signed TLS<br/>TokenReview + SAR auth"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount auth"]
        MetricsSvc["Metrics Service (ClusterIP)<br/>8443/TCP"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM auth"]
    end

    %% External → Ingress
    User -->|"HTTPS/443<br/>TLS<br/>Istio principal"| IstioGW

    %% Ingress → Service Mesh
    IstioGW -->|"HTTP/8080<br/>Istio mTLS<br/>Bearer Token / SA token"| BFF
    IstioGW -->|"HTTP/8080<br/>Istio mTLS<br/>JWT required"| MRProxy

    %% Internal Service Mesh flows
    BFF -->|"HTTP/8080<br/>Configurable TLS<br/>Internal"| MRProxy
    MRProxy -->|"TCP<br/>Configurable TLS"| DB

    %% To Kubernetes API
    BFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Controller -->|"HTTP<br/>Configurable TLS"| MRProxy

    %% Metrics
    Controller -->|"HTTPS/8443<br/>Self-signed TLS"| Metrics
    Metrics --- MetricsSvc

    %% External services
    AsyncUpload -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class IstioGW ingress
    class BFF,MRProxy,DB,Controller,Metrics,AsyncUpload servicemesh
    class K8sAPI,MetricsSvc clusterservice
    class S3 externalservice
