graph TB
    subgraph Monitoring["MONITORING (Authenticated)"]
        Prometheus["Prometheus<br/>Scrapes /metrics"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (ai-gateway-system)"]
        direction TB
        Operator["ai-gateway-operator<br/>UBI9 ubi-minimal, UID 65532<br/>FIPS: strictfipsruntime + CGO<br/>SA: ai-gateway-operator"]

        subgraph Ports["Exposed Ports"]
            Health[":8081/TCP HTTP<br/>/healthz /readyz<br/>No Auth"]
            Metrics[":8443/TCP HTTPS<br/>/metrics<br/>TokenReview + SAR"]
        end

        MetricsSvc["ai-gateway-metrics-service<br/>ClusterIP :8443/TCP"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>:6443/TCP<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph WatchedResources["WATCHED RESOURCES (Read-Only)"]
        direction LR
        AIGatewayCR["AIGateway CR<br/>components.platform.opendatahub.io"]
        DSCInit["DSCInitialization CR<br/>dscinitialization.opendatahub.io"]
        KServeLLM["LLMInferenceService<br/>serving.kserve.io"]
        GW["Gateways / ReferenceGrants<br/>gateway.networking.k8s.io"]
        AuthorinoOp["Authorinos<br/>operator.authorino.kuadrant.io"]
    end

    subgraph ManagedNetworking["MANAGED - NETWORKING"]
        direction LR
        HTTPRoutes["HTTPRoutes<br/>gateway.networking.k8s.io"]
        IstioRules["DestinationRules<br/>EnvoyFilters<br/>ServiceEntries<br/>networking.istio.io"]
        NetPol["NetworkPolicies<br/>networking.k8s.io"]
    end

    subgraph ManagedSecurity["MANAGED - SECURITY"]
        direction LR
        Certs["Certificates<br/>cert-manager.io"]
        AuthPol["AuthPolicies<br/>RateLimitPolicies<br/>TokenRateLimitPolicies<br/>kuadrant.io"]
    end

    subgraph ManagedMaaS["MANAGED - MaaS (maas.opendatahub.io)"]
        direction LR
        Tenants["AITenants<br/>MaaSTenantConfigs"]
        Subs["MaaSSubscriptions<br/>MaaSAuthPolicies"]
        Models["MaaSModelRefs<br/>ExternalModels"]
    end

    subgraph ManagedBatch["MANAGED - BATCH"]
        BatchGW["LLMBatchGateways<br/>batch.llm-d.ai"]
        Jobs["CronJobs / Jobs<br/>batch"]
    end

    subgraph ManagedObservability["MANAGED - OBSERVABILITY"]
        direction LR
        SvcMon["ServiceMonitors<br/>PodMonitors<br/>PrometheusRules"]
        OTel["OpenTelemetryCollectors<br/>opentelemetry.io"]
        Telemetry["Telemetries<br/>telemetry.istio.io"]
        Perses["PersesDashboards<br/>perses.dev"]
    end

    %% Flows
    Prometheus -->|"HTTPS/8443<br/>TLS (FIPS)<br/>TokenReview + SAR"| MetricsSvc
    MetricsSvc --> Metrics

    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    APIServer -->|"Watch events"| WatchedResources
    APIServer -->|"CRUD"| ManagedNetworking
    APIServer -->|"CRUD"| ManagedSecurity
    APIServer -->|"CRUD"| ManagedMaaS
    APIServer -->|"CRUD"| ManagedBatch
    APIServer -->|"CRUD"| ManagedObservability

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px,color:#000
    classDef watched fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000
    classDef managed fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000
    classDef monitoring fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#000

    class Operator operator
    class APIServer controlplane
    class AIGatewayCR,DSCInit,KServeLLM,GW,AuthorinoOp watched
    class HTTPRoutes,IstioRules,NetPol managed
    class Certs,AuthPol security
    class Tenants,Subs,Models managed
    class BatchGW,Jobs managed
    class SvcMon,OTel,Telemetry,Perses monitoring
    class Prometheus monitoring
