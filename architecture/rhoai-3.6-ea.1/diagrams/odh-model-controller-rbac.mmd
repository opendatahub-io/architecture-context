graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_MC["odh-model-controller<br/>(controller SA)"]
        SA_API["model-serving-api<br/>(API server SA)"]
        SA_CM["controller-manager<br/>(metrics SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Main["odh-model-controller-rolebinding-opendatahub"]
        CRB_Proxy["proxy-rolebinding"]
        CRB_API["model-serving-api"]
        CRB_Metrics["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader1["leader-election-rolebinding<br/>(ns: odh-model-controller-system)"]
        RB_Leader2["leader-election-rolebinding<br/>(ns: system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Main["odh-model-controller-role"]
        CR_Proxy["proxy-role"]
        CR_API["model-serving-api"]
        CR_Metrics["metrics-auth-role"]
        CR_AccEdit["account-editor-role"]
        CR_AccView["account-viewer-role"]
        CR_Prom["kserve-prometheus-k8s"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role"]
    end

    %% Service Account to Binding connections
    SA_MC -->|bound via| CRB_Main
    SA_MC -->|bound via| CRB_Proxy
    SA_MC -->|bound via| RB_Leader1
    SA_MC -->|bound via| RB_Leader2
    SA_API -->|bound via| CRB_API
    SA_CM -->|bound via| CRB_Metrics

    %% Binding to Role connections
    CRB_Main -->|grants| CR_Main
    CRB_Proxy -->|grants| CR_Proxy
    CRB_API -->|grants| CR_API
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader1 -->|grants| R_Leader
    RB_Leader2 -->|grants| R_Leader

    subgraph Resources_Main["odh-model-controller-role Resources"]
        direction LR
        R_ISVC["serving.kserve.io<br/>InferenceServices<br/>get,list,watch,patch,update"]
        R_LLMISVC["serving.kserve.io<br/>LLMInferenceServices<br/>get,list,watch,patch,post,update"]
        R_SR["serving.kserve.io<br/>ServingRuntimes<br/>create,get,list,update,watch"]
        R_IG["serving.kserve.io<br/>InferenceGraphs<br/>get,list,watch"]
        R_NIM["nim.opendatahub.io<br/>Accounts<br/>get,list,watch,patch,update"]
        R_GW["gateway.networking.k8s.io<br/>Gateways, HTTPRoutes<br/>get,list,watch,patch,update"]
        R_AuthP["kuadrant.io<br/>AuthPolicies<br/>full CRUD"]
        R_EF["networking.istio.io<br/>EnvoyFilters<br/>full CRUD"]
        R_NetPol["networking.k8s.io<br/>NetworkPolicies<br/>full CRUD"]
        R_Route["route.openshift.io<br/>Routes<br/>full CRUD"]
        R_Mon["monitoring.coreos.com<br/>PodMonitors, ServiceMonitors<br/>full CRUD"]
        R_RBAC["rbac.authorization.k8s.io<br/>ClusterRoleBindings, Roles, RoleBindings<br/>full CRUD"]
        R_Core["core<br/>ConfigMaps, Secrets, Services,<br/>ServiceAccounts, Pods, Namespaces<br/>create,delete,get,list,patch,update,watch"]
        R_DSC["datasciencecluster.opendatahub.io<br/>DataScienceClusters<br/>get,list,watch"]
        R_DSCI["dscinitialization.opendatahub.io<br/>DSCInitializations<br/>get,list,watch"]
        R_HP["infrastructure.opendatahub.io<br/>HardwareProfiles<br/>get,list,watch"]
    end

    subgraph Resources_Proxy["proxy-role Resources"]
        R_TokenReview["authentication.k8s.io<br/>TokenReviews<br/>create"]
        R_SAR["authorization.k8s.io<br/>SubjectAccessReviews<br/>create"]
    end

    subgraph Resources_API["model-serving-api Resources"]
        R_GW_List["gateway.networking.k8s.io<br/>Gateways<br/>list"]
        R_NS["core<br/>Namespaces<br/>get"]
    end

    subgraph Resources_Leader["leader-election-role Resources"]
        R_CM["core<br/>ConfigMaps, Events<br/>full CRUD"]
        R_Leases["coordination.k8s.io<br/>Leases<br/>full CRUD"]
    end

    %% Role to Resource connections
    CR_Main --> Resources_Main
    CR_Proxy --> Resources_Proxy
    CR_API --> Resources_API
    R_Leader --> Resources_Leader

