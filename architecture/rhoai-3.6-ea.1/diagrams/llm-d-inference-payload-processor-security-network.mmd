graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph EnvoyLayer["ENVOY PROXY (Edge)"]
        Envoy["Envoy Proxy<br/>envoyproxy/envoy:distroless-v1.33.2<br/>NodePort 8081/TCP"]
    end

    subgraph PayloadProcessor["PAYLOAD PROCESSOR (Internal)"]
        direction TB

        subgraph NS_Processor["Namespace: ${NAMESPACE}"]
            ExtProc["ExtProc gRPC Server<br/>9004/TCP | HTTP/2<br/>TLS (self-signed RSA 4096)<br/>No app-level auth"]
            HealthSrv["Health gRPC Server<br/>9005/TCP | HTTP/2<br/>Plaintext<br/>No auth"]
            MetricsSrv["Metrics HTTP Server<br/>9090/TCP | HTTP/1.1<br/>No encryption<br/>SA bearer token auth"]
            ConfigReconciler["ConfigMap Reconciler<br/>SA: payload-processor"]
        end
    end

    subgraph K8sLayer["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>SA token auth"]
    end

    subgraph ModelServers["MODEL SERVERS (Internal)"]
        vLLMDeepSeek["vllm-deepseek-r1<br/>ClusterIP 8000/TCP<br/>HTTP"]
        vLLMLlama["vllm-llama3-8b-instruct<br/>ClusterIP 8000/TCP<br/>HTTP"]
    end

    subgraph Observability["OBSERVABILITY"]
        Prometheus["Prometheus"]
    end

    %% External to Envoy
    Client -->|"HTTP/8081<br/>No encryption<br/>No auth"| Envoy

    %% Envoy to ExtProc
    Envoy -->|"gRPC ExtProc/9004<br/>HTTP/2<br/>TLS (self-signed)<br/>No app auth"| ExtProc

    %% ExtProc response back to Envoy
    ExtProc -->|"Modified headers<br/>routing decisions"| Envoy

    %% Envoy to model servers
    Envoy -->|"HTTP/8000"| vLLMDeepSeek
    Envoy -->|"HTTP/8000"| vLLMLlama

    %% Health probes
    Envoy -.->|"gRPC Health/9005<br/>Plaintext<br/>No auth"| HealthSrv

    %% ConfigMap reconciliation
    ConfigReconciler -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>get,list,watch configmaps"| K8sAPI

    %% Metrics auth delegation
    MetricsSrv -.->|"Token validation<br/>HTTPS/6443"| K8sAPI

    %% Prometheus scraping
    Prometheus -->|"HTTP/9090<br/>SA bearer token<br/>AuthN+AuthZ via K8s API"| MetricsSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef envoy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef processor fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef modelserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy envoy
    class ExtProc,HealthSrv,MetricsSrv,ConfigReconciler processor
    class K8sAPI k8s
    class vLLMDeepSeek,vLLMLlama modelserver
    class Prometheus observability
