graph TD
    subgraph "batch-gateway RBAC & Security Posture"
        direction TB

        subgraph "Application-Level Auth"
            NoAuth["No Application-Level<br/>Authentication or Authorization<br/>⚠ Intentionally absent"]
            Middleware["Middleware Chain<br/>(inspected — no auth)"]
            NoAuth --- Middleware
        end

        subgraph "Platform-Delegated Security"
            PlatformAuthN["Platform AuthN<br/>(Gateway / Service Mesh)<br/>Expected to enforce auth"]
            PlatformAuthZ["Platform AuthZ<br/>(Gateway / Service Mesh)<br/>Expected to enforce access control"]
        end

        subgraph "FIPS Compliance"
            FIPSBuild["Build-Time FIPS<br/>GOEXPERIMENT=strictfipsruntime<br/>CGO_ENABLED=1<br/>UBI 9 (OpenSSL)"]
            FIPSTls["Runtime TLS<br/>crypto/tls (stdlib)<br/>Min: TLS 1.2<br/>Ciphers: tls.CipherSuites() only<br/>TLS 1.3 cipher override: REJECTED"]
        end

        subgraph "Endpoint Exposure"
            APIEndpoints["API Server Endpoints<br/>REST: POST/GET/DELETE<br/>Auth: NONE"]
            ObsEndpoints["Observability Endpoints<br/>/health, /ready, /metrics<br/>/debug/pprof/*<br/>Auth: NONE<br/>Encryption: Plain HTTP"]
        end

        subgraph "Kubernetes RBAC"
            NoClusterRole["No ClusterRoles Defined<br/>(managed by deploying operator)"]
            NoRoleBinding["No RoleBindings Defined<br/>(managed by deploying operator)"]
            NoSecrets["No Kubernetes Secrets Defined<br/>(credentials via env vars / config)"]
        end

        subgraph "Service Mesh"
            NoPeerAuth["No PeerAuthentication<br/>(managed at platform level)"]
            NoAuthPolicy["No AuthorizationPolicy<br/>(managed at platform level)"]
        end
    end

    PlatformAuthN -->|"delegates to"| APIEndpoints
    PlatformAuthZ -->|"delegates to"| APIEndpoints
    FIPSBuild -->|"enables"| FIPSTls

    style NoAuth fill:#ff6b6b,stroke:#333,color:#fff
    style Middleware fill:#ff6b6b,stroke:#333,color:#fff
    style PlatformAuthN fill:#ffe6cc,stroke:#d79b00
    style PlatformAuthZ fill:#ffe6cc,stroke:#d79b00
    style FIPSBuild fill:#d5e8d4,stroke:#82b366
    style FIPSTls fill:#d5e8d4,stroke:#82b366
    style APIEndpoints fill:#dae8fc,stroke:#6c8ebf
    style ObsEndpoints fill:#dae8fc,stroke:#6c8ebf
    style NoClusterRole fill:#e8e8e8,stroke:#999
    style NoRoleBinding fill:#e8e8e8,stroke:#999
    style NoSecrets fill:#e8e8e8,stroke:#999
    style NoPeerAuth fill:#e8e8e8,stroke:#999
    style NoAuthPolicy fill:#e8e8e8,stroke:#999
