graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist / Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["Gateway API Gateway<br/>443/TCP<br/>TLS 1.2+<br/>HTTPRoute per-cluster"]
    end

    subgraph AuthProxy["AUTHENTICATION PROXY"]
        KRBP["kube-rbac-proxy Sidecar<br/>8443/TCP TLS<br/>TokenReview + SubjectAccessReview<br/>OIDC / Integrated OAuth"]
    end

    subgraph UserNamespace["USER NAMESPACE"]
        direction TB
        HeadPod["Ray Head Pod<br/>Dashboard + Ray processes"]
        WorkerPods["Ray Worker Pods<br/>Distributed compute"]
        NetPol["NetworkPolicy<br/>(per-cluster isolation)"]
        MTLSCert["cert-manager Certificate<br/>(inter-node mTLS)"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB
        Operator["kuberay-operator<br/>SA: kuberay-operator<br/>FIPS: strictfipsruntime"]
        Metrics["Metrics Server<br/>8080/TCP HTTP"]
        Health["Health Probes<br/>8082/TCP HTTP"]
        Webhooks["Admission Webhooks<br/>HTTPS TLS<br/>failurePolicy: fail"]
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph InternalServices["INTERNAL PLATFORM SERVICES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRDs<br/>TLS 1.2+"]
        Prometheus["Prometheus<br/>Scrapes :8080/metrics<br/>HTTP"]
        OSConfig["OpenShift APIServer Config<br/>TLS Security Profile"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (OIDC/OAuth)"| Gateway

    %% Ingress → Auth Proxy
    Gateway -->|"HTTPS/8443<br/>TLS<br/>Service Identity"| KRBP

    %% Auth Proxy → Dashboard
    KRBP -->|"HTTP (pod-local)<br/>No encryption<br/>Trusted sidecar"| HeadPod

    %% Auth Proxy → K8s API (token validation)
    KRBP -->|"HTTPS/6443<br/>TokenReview<br/>SubjectAccessReview"| K8sAPI

    %% Operator → K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Operator → cert-manager
    Operator -->|"Certificate + Issuer CRUD<br/>Kubernetes API"| CertManager

    %% Operator reads OpenShift config
    Operator -->|"APIServer resource read<br/>TLS profile"| OSConfig

    %% K8s API → Webhooks
    K8sAPI -->|"HTTPS/TLS<br/>AdmissionReview<br/>CREATE, UPDATE"| Webhooks

    %% Prometheus scrape
    Prometheus -->|"HTTP/8080<br/>/metrics"| Metrics

    %% Inter-node mTLS
    HeadPod <-->|"mTLS<br/>cert-manager certs"| WorkerPods

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef userns fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class KRBP authproxy
    class Operator,Metrics,Health,Webhooks operator
    class K8sAPI k8s
    class CertManager,Prometheus,OSConfig internal
    class HeadPod,WorkerPods,NetPol,MTLSCert userns
