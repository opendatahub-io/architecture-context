graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist<br/>External Client"]
    end

    subgraph Ingress["INGRESS (Platform Gateway)"]
        Gateway["Gateway API / OpenShift Route<br/>443/TCP<br/>TLS 1.2+<br/>HTTPRoute + ReferenceGrant"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB
        Operator["kuberay-operator<br/>SA: kuberay-operator<br/>FIPS: strictfipsruntime"]
        Metrics["Metrics :8080/TCP<br/>HTTP, no auth<br/>Prometheus scrape"]
        Health["Health :8082/TCP<br/>HTTP, no auth<br/>/healthz, /readyz"]
        WebhookSrv["Webhook :9443/TCP<br/>HTTPS/TLS<br/>K8s admission"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph UserNS["USER NAMESPACE (Ray Cluster)"]
        direction TB
        subgraph HeadPod["Ray Head Pod"]
            RayHead["Ray Head Process"]
            KubeRBACProxy["kube-rbac-proxy<br/>:8443/TCP HTTPS<br/>OIDC/OAuth"]
        end
        Workers["Ray Worker Pods<br/>mTLS (cert-manager certs)"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRDs"]
        Prometheus["Prometheus<br/>:8080 inbound scrape"]
        OSConfig["OpenShift APIServer Config<br/>config.openshift.io/v1<br/>TLS profile alignment"]
        GatewayCtrl["Gateway API Controller<br/>HTTPRoute, ReferenceGrant"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>OIDC Auth"| Gateway

    %% Ingress → Ray Dashboard
    Gateway -->|"HTTPS/8443<br/>TLS<br/>OIDC delegated"| KubeRBACProxy

    %% Operator → K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Operator → Platform Services
    Operator -->|"CRD CRUD<br/>Certificate + Issuer"| CertManager
    Prometheus -->|"HTTP/8080<br/>no auth"| Metrics
    Operator -->|"GET<br/>TLS profile read"| OSConfig
    Operator -->|"CRUD<br/>HTTPRoute, ReferenceGrant"| GatewayCtrl

    %% K8s API → Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>admission review"| WebhookSrv

    %% Ray cluster mTLS
    RayHead <-->|"Ray protocol<br/>mTLS<br/>cert-manager certs"| Workers

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operatorns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef userns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platformsvc fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Gateway ingress
    class Operator,Metrics,Health,WebhookSrv operatorns
    class K8sAPI controlplane
    class RayHead,KubeRBACProxy,Workers userns
    class CertManager,Prometheus,OSConfig,GatewayCtrl platformsvc
