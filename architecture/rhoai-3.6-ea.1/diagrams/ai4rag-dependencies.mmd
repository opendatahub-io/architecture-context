graph LR
    ai4rag["ai4rag<br/>(Python Library)"]

    %% Internal RHOAI Platform Dependencies
    ai4rag -->|"KFP SDK<br/>event handler"| DSPipelines["Data Science Pipelines<br/>(Kubeflow Pipelines)"]
    ai4rag -->|"OpenAI-compatible API<br/>HTTPS/TLS"| ModelServing["Model Serving (MaaS)<br/>(vLLM-based)"]

    %% External Service Dependencies
    ai4rag -->|"HTTPS/TLS<br/>AWS credentials"| S3["S3-Compatible Storage<br/>(AWS S3 / MinIO)"]

    %% Vector Store Dependencies (pluggable backends)
    ai4rag -->|"gRPC + TLS"| Milvus["Milvus<br/>(pymilvus ~3.0.1)"]
    ai4rag -->|"PostgreSQL wire protocol"| PGVector["PGVector<br/>(pgvector ~0.5.0 / psycopg >=3.1)"]
    ai4rag -->|"HTTP"| Chroma["Chroma<br/>(chromadb >=1.5,<2)"]

    %% Key Python Library Dependencies
    ai4rag -->|"document conversion"| Docling["Docling<br/>(docling-slim ~2.107.0)"]
    ai4rag -->|"text splitting"| LangChain["LangChain Text Splitters<br/>(~1.1.0)"]
    ai4rag -->|"API client"| OpenAI["OpenAI SDK<br/>(~2.53.0)"]
    ai4rag -->|"S3 client"| Boto3["boto3<br/>(>=1.28)"]
    ai4rag -->|"HPO optimizer"| PyGAM["PyGAM<br/>(~0.12.0)"]
    ai4rag -->|"evaluation"| Unitxt["Unitxt<br/>(~1.26.1)"]
    ai4rag -->|"data processing"| Pandas["pandas<br/>(==2.2.*)"]
    ai4rag -->|"ML metrics"| Sklearn["scikit-learn<br/>(==1.8.*)"]
    ai4rag -->|"data validation"| Pydantic["Pydantic<br/>(==2.11.*)"]

    %% Runtime
    ai4rag -->|"runtime"| Python["Python<br/>(>=3.12,<3.14)"]

