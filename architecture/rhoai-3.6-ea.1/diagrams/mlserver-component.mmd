graph TB
    subgraph External["External Access"]
        Client[Client / Data Scientist]
    end

    subgraph KServePod["KServe ServingRuntime Pod"]
        subgraph AuthProxy["Auth Sidecar"]
            KRBP["kube-rbac-proxy<br/>OpenShift OAuth/SA Token Validation"]
        end

        subgraph MLServerProcess["MLServer Process"]
            subgraph RESTServer["REST Server (FastAPI/uvicorn)"]
                REST["Port 8080/TCP<br/>V2 Inference Protocol"]
            end

            subgraph GRPCServer["gRPC Server"]
                GRPC["Port 8081/TCP<br/>GRPCInferenceService<br/>ModelRepositoryService"]
            end

            subgraph MetricsServer["Metrics Server"]
                Metrics["Port 8082/TCP<br/>Prometheus /metrics"]
            end

            DataPlane["DataPlane Handler Layer<br/>(shared by REST + gRPC)"]

            subgraph RuntimePlugins["Runtime Plugins (Trusted Allowlist)"]
                SKLearn["mlserver-sklearn<br/>Scikit-Learn"]
                XGBoost["mlserver-xgboost<br/>XGBoost"]
                LightGBM["mlserver-lightgbm<br/>LightGBM"]
                ONNX["mlserver-onnx<br/>ONNX Runtime"]
                MLflow["mlserver-mlflow<br/>MLflow"]
                HuggingFace["mlserver-huggingface<br/>HuggingFace"]
                CatBoost["mlserver-catboost<br/>CatBoost"]
                SparkMLlib["mlserver-mllib<br/>Spark MLlib"]
                AlibiDetect["mlserver-alibi-detect<br/>Alibi Detect"]
                AlibiExplain["mlserver-alibi-explain<br/>Alibi Explain"]
            end

            TrustedRuntimes["/etc/mlserver/trusted-runtimes.json<br/>Trusted Runtimes Allowlist"]
        end
    end

    subgraph Observability["Observability"]
        OTelCollector["OpenTelemetry Collector"]
        Prometheus["Prometheus"]
    end

    subgraph OptionalTransport["Optional Transport"]
        Kafka["Kafka<br/>Async Inference"]
    end

    %% Client flow
    Client -->|"REST/gRPC"| KRBP
    KRBP -->|"Authenticated"| REST
    KRBP -->|"Authenticated"| GRPC

    %% Internal routing
    REST --> DataPlane
    GRPC --> DataPlane
    DataPlane -->|"routes to loaded model"| SKLearn
    DataPlane -->|"routes to loaded model"| XGBoost
    DataPlane -->|"routes to loaded model"| LightGBM
    DataPlane -->|"routes to loaded model"| ONNX
    DataPlane -->|"routes to loaded model"| MLflow
    DataPlane -->|"routes to loaded model"| HuggingFace
    DataPlane -->|"routes to loaded model"| CatBoost
    DataPlane -->|"routes to loaded model"| SparkMLlib
    DataPlane -->|"routes to loaded model"| AlibiDetect
    DataPlane -->|"routes to loaded model"| AlibiExplain

    %% Security gate
    TrustedRuntimes -.->|"gates loading"| DataPlane

    %% Observability
    REST -->|"OpenTelemetry traces"| OTelCollector
    GRPC -->|"OpenTelemetry traces"| OTelCollector
    Metrics -->|"scraped by"| Prometheus

    %% Optional Kafka
    Kafka -.->|"async inference"| DataPlane

    %% Styling
    style KRBP fill:#e74c3c,stroke:#c0392b,color:#fff
    style REST fill:#4a90e2,stroke:#357abd,color:#fff
    style GRPC fill:#4a90e2,stroke:#357abd,color:#fff
    style Metrics fill:#4a90e2,stroke:#357abd,color:#fff
    style DataPlane fill:#8e44ad,stroke:#71368a,color:#fff
    style TrustedRuntimes fill:#e67e22,stroke:#d35400,color:#fff
    style SKLearn fill:#7ed321,stroke:#5ca40e
    style XGBoost fill:#7ed321,stroke:#5ca40e
    style LightGBM fill:#7ed321,stroke:#5ca40e
    style ONNX fill:#7ed321,stroke:#5ca40e
    style MLflow fill:#7ed321,stroke:#5ca40e
    style HuggingFace fill:#7ed321,stroke:#5ca40e
    style CatBoost fill:#7ed321,stroke:#5ca40e
    style SparkMLlib fill:#7ed321,stroke:#5ca40e
    style AlibiDetect fill:#7ed321,stroke:#5ca40e
    style AlibiExplain fill:#7ed321,stroke:#5ca40e
    style OTelCollector fill:#f39c12,stroke:#e67e22
    style Prometheus fill:#f39c12,stroke:#e67e22
    style Kafka fill:#999,stroke:#666
