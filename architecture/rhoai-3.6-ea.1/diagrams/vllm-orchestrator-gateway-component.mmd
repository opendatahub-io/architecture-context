graph TB
    subgraph Gateway["vllm-orchestrator-gateway (Rust/Axum)"]
        direction TB
        ConfigLoader["Config Loader<br/>YAML Parser<br/>(serde_yml)"]
        Router["Axum Router<br/>Dynamic Route Generation"]
        RequestHandler["Request Handler<br/>Detector Injection"]
        StreamHandler["Stream Handler<br/>SSE Processing"]
        NonStreamHandler["Non-Stream Handler<br/>Response Processing"]
        FallbackEngine["Fallback Engine<br/>Detection Response Replace"]
        TLSClient["TLS Client Builder<br/>(reqwest + native-tls)"]

        ConfigLoader -->|"defines routes<br/>& detectors"| Router
        Router -->|"POST /{route}/v1/chat/completions"| RequestHandler
        RequestHandler -->|"stream=true"| StreamHandler
        RequestHandler -->|"stream=false"| NonStreamHandler
        StreamHandler -->|"detections found"| FallbackEngine
        NonStreamHandler -->|"detections found"| FallbackEngine
        RequestHandler -->|"builds HTTP client"| TLSClient
    end

    Client["External Client"] -->|"POST /{route_name}/v1/chat/completions<br/>8090/TCP HTTP<br/>Authorization header (optional)"| Router

    TLSClient -->|"POST /api/v2/chat/completions-detection<br/>HTTP or HTTPS (mTLS)<br/>Authorization forwarded"| Orchestrator["vLLM Orchestrator<br/>(Backend)"]

    ConfigFile["config.yaml<br/>(GATEWAY_CONFIG env)"] -->|"mounted at<br/>/app/config/"| ConfigLoader

    TLSCerts["TLS Certificates<br/>/etc/tls/private/tls.crt<br/>/etc/tls/private/tls.key"] -.->|"optional mTLS"| TLSClient
    CACert["CA Bundle<br/>/etc/tls/ca/service-ca.crt"] -.->|"optional CA trust"| TLSClient

    style Gateway fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style ConfigLoader fill:#4a90e2,color:#fff
    style Router fill:#4a90e2,color:#fff
    style RequestHandler fill:#4a90e2,color:#fff
    style StreamHandler fill:#4a90e2,color:#fff
    style NonStreamHandler fill:#4a90e2,color:#fff
    style FallbackEngine fill:#4a90e2,color:#fff
    style TLSClient fill:#4a90e2,color:#fff
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
    style Orchestrator fill:#7ed321,stroke:#333
    style ConfigFile fill:#f5a623,stroke:#333
    style TLSCerts fill:#fff2cc,stroke:#d6b656
    style CACert fill:#fff2cc,stroke:#d6b656
