graph LR
    LLP["llm-d-latency-predictor<br/>(Training + Prediction Servers)"]

    %% Runtime Framework
    LLP -->|"ASGI framework"| FastAPI["FastAPI 0.138+"]
    LLP -->|"ASGI server"| Uvicorn["uvicorn 0.49+"]
    FastAPI -->|"built on"| Starlette["Starlette 1.3+"]

    %% ML Libraries
    LLP -->|"regression models"| XGBoost["XGBoost 3.3+"]
    LLP -->|"regression models"| LightGBM["LightGBM 4.6+<br/>(optional)"]
    LLP -->|"Bayesian Ridge"| ScikitLearn["scikit-learn 1.9+"]
    LLP -->|"online learning"| River["River 0.25+"]

    %% Data Libraries
    LLP -->|"data processing"| NumPy["NumPy 2.5+"]
    LLP -->|"data frames"| Pandas["Pandas 3.0+"]
    LLP -->|"scientific computing"| SciPy["SciPy 1.18+"]

    %% HTTP Client Libraries
    LLP -->|"sync HTTP client"| Requests["requests 2.34+"]
    LLP -->|"async HTTP client"| HTTPX["httpx"]
    LLP -->|"async HTTP"| Aiohttp["aiohttp 3.14+"]

    %% Internal Platform Dependencies
    TrainingSvc["training-service<br/>:8000/TCP<br/>(co-deployed)"]
    LLP -->|"model sync<br/>HTTP polling<br/>every 10s"| TrainingSvc

    %% Runtime
    LLP -->|"runtime"| Python["Python >= 3.11"]
    LLP -->|"base image"| AIPCC["AIPCC UBI Base<br/>cpu:3.5.0"]

    %% Testing
    LLP -.->|"testing"| Pytest["pytest"]
    LLP -.->|"async tests"| PytestAsyncio["pytest-asyncio"]

