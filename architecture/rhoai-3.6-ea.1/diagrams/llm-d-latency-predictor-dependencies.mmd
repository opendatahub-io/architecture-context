graph LR
    LLP["llm-d-latency-predictor<br/>(Training + Prediction Servers)"]

    %% Internal Platform Dependencies
    LLP -->|"receives latency<br/>samples from"| LLMd["llm-d<br/>Inference Gateway"]

    %% Key Runtime Frameworks
    LLP -->|"web framework"| FastAPI["FastAPI 0.138+<br/>(Starlette)"]
    LLP -->|"ASGI server"| Uvicorn["uvicorn 0.49+"]

    %% ML Libraries
    LLP -->|"ML training<br/>(TTFT/TPOT)"| XGBoost["XGBoost 3.3+"]
    LLP -->|"ML training<br/>(TTFT/TPOT)"| LightGBM["LightGBM 4.6+"]
    LLP -->|"ML training<br/>(BayesianRidge)"| ScikitLearn["scikit-learn 1.9+"]

    %% Data & Serialization
    LLP -->|"model serialization"| Joblib["joblib 1.5+"]
    LLP -->|"numerical computation"| NumPy["NumPy 2.5+"]
    LLP -->|"data manipulation"| Pandas["Pandas 3.0+"]

    %% HTTP & Networking
    LLP -->|"HTTP client<br/>(model sync)"| HTTPX["httpx"]
    LLP -->|"HTTP client<br/>(alt)"| Requests["requests 2.34+"]
    LLP -->|"async HTTP"| AioHTTP["aiohttp 3.14+"]

    %% Infrastructure
    LLP -->|"runtime"| Python["Python >=3.11"]
    LLP -->|"base image"| AIPCC["AIPCC base-images<br/>cpu:3.5.0"]
    LLP -->|"container orchestration"| K8s["Kubernetes<br/>(Deployments, Services)"]

    %% Internal self-dependency
    PredServer["Prediction Server<br/>:8001"] -->|"polls for models<br/>HTTP GET every 10s"| TrainServer["Training Server<br/>:8000"]

