graph LR
    BatchGateway["batch-gateway<br/>Async Batch Inference Gateway"]

    %% Infrastructure Dependencies
    BatchGateway -->|"job state<br/>TCP (pgx)"| PostgreSQL["PostgreSQL"]
    BatchGateway -->|"async task queue<br/>TCP (go-redis)"| Redis["Redis/Valkey"]
    BatchGateway -->|"file storage<br/>HTTP/HTTPS (AWS SDK v2)"| S3["S3-Compatible<br/>Storage"]

    %% Internal Platform Dependencies
    BatchGateway -->|"inference dispatch<br/>HTTP/HTTPS"| LLMd["llm-d Inference<br/>Gateway"]
    BatchGateway -->|"async library"| LLMdAsync["llm-d-async<br/>v0.7.4"]

    %% Observability Dependencies
    BatchGateway -->|"trace export<br/>OTLP/gRPC"| OTel["OpenTelemetry<br/>Collector"]
    BatchGateway -->|"metrics"| Prometheus["Prometheus<br/>(client_golang v1.24)"]

    %% Platform Dependencies
    PlatformGW["Platform Gateway /<br/>Service Mesh"] -->|"auth delegation"| BatchGateway

    %% Build Dependencies
    BatchGateway -.->|"FIPS runtime"| UBI9["UBI 9 Base Image"]
    BatchGateway -.->|"strictfipsruntime"| GoFIPS["Go 1.26<br/>GOEXPERIMENT=strictfipsruntime"]

    %% Key Libraries
    BatchGateway -.->|"DB driver"| PGX["pgx v5.10<br/>+ otelpgx"]
    BatchGateway -.->|"Redis client"| GoRedis["go-redis v9.21<br/>+ redisotel"]
    BatchGateway -.->|"S3 client"| AWSSDK["AWS SDK v2<br/>v1.43"]
    BatchGateway -.->|"HTTP client"| Resty["go-resty v2.17"]

    style BatchGateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#dae8fc,stroke:#6c8ebf
    style Redis fill:#dae8fc,stroke:#6c8ebf
    style S3 fill:#dae8fc,stroke:#6c8ebf
    style LLMd fill:#7ed321,stroke:#333
    style LLMdAsync fill:#7ed321,stroke:#333
    style OTel fill:#999,stroke:#333
    style Prometheus fill:#999,stroke:#333
    style PlatformGW fill:#ffe6cc,stroke:#d79b00
    style UBI9 fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style GoFIPS fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style PGX fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style GoRedis fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
