graph LR
    BatchGW["batch-gateway<br/>(3-process split)"]

    %% Runtime Infrastructure Dependencies
    BatchGW -->|"metadata store<br/>TCP"| PostgreSQL["PostgreSQL"]
    BatchGW -->|"work exchange<br/>TCP"| Redis["Redis/Valkey"]
    BatchGW -->|"file storage<br/>HTTP/HTTPS"| S3["S3-Compatible Storage"]

    %% Internal Platform Dependencies
    BatchGW -->|"inference fan-out<br/>HTTP/HTTPS"| LLMd["llm-d Inference Gateway"]
    BatchGW -->|"async API library"| LLMdAsync["llm-d-async<br/>(Go library)"]

    %% Observability Dependencies
    BatchGW -->|"trace export<br/>OTLP/gRPC"| OTel["OpenTelemetry Collector"]
    BatchGW -->|"metrics scrape<br/>HTTP/8081"| Prometheus["Prometheus"]

    %% Platform Integration
    PlatformGW["Platform Gateway<br/>(Gateway API)"] -->|"routes requests<br/>HTTPRoute"| BatchGW
    PlatformGW -.->|"AuthN/AuthZ<br/>enforcement"| BatchGW

    %% Build/Runtime Dependencies
    BatchGW -->|"FIPS crypto"| OpenSSL["OpenSSL<br/>(via UBI 9)"]
    BatchGW -->|"cert management"| CertManager["cert-manager<br/>(optional)"]
    BatchGW -->|"AWS S3 SDK"| AWSSDK["AWS SDK Go v2"]

    %% Key Go module dependencies
    BatchGW -.->|"DB driver"| PGX["pgx/v5"]
    BatchGW -.->|"Redis client"| GoRedis["go-redis/v9"]
    BatchGW -.->|"HTTP client"| Resty["resty/v2"]

    style BatchGW fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
    style Redis fill:#999,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style LLMd fill:#7ed321,stroke:#333,color:#fff
    style LLMdAsync fill:#7ed321,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style PlatformGW fill:#7ed321,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style AWSSDK fill:#999,stroke:#333,color:#fff
    style PGX fill:#ccc,stroke:#999
    style GoRedis fill:#ccc,stroke:#999
    style Resty fill:#ccc,stroke:#999
