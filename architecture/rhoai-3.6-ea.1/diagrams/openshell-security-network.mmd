graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["CLI / SDK / AI Agent"]
    end

    subgraph Ingress["INGRESS (Optional - Gateway API)"]
        EnvoyGW["Envoy Gateway<br/>GRPCRoute<br/>443/TCP → 8080/TCP<br/>TLS 1.2+ SIMPLE"]
    end

    subgraph ControlPlane["CONTROL PLANE (Gateway Namespace)"]
        Gateway["OpenShell Gateway<br/>SA: openshell<br/>Image: rhoai/odh-openshell-gateway-rhel9<br/>8080/TCP gRPC | 8081/TCP health | 9090/TCP metrics<br/>TLS: rustls 0.23 (ring, NO OpenSSL)<br/>AuthZ: Descriptor-based per-RPC"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        direction LR
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>SA Token Auth"]
        OIDC["OIDC Provider<br/>443/TCP HTTPS<br/>JWKS Fetch"]
        Vault["HashiCorp Vault<br/>8200/TCP HTTPS<br/>K8s SA / Vault Token"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS optional<br/>Connection String"]
    end

    subgraph SandboxPod["DATA PLANE - Sandbox Pod (NetworkPolicy enforced)"]
        direction TB

        subgraph Sidecar["Network Sidecar (UID 1337)"]
            NetSupervisor["Supervisor Network<br/>nftables + HTTP CONNECT Proxy<br/>OPA Policy + L7 Inspection<br/>Creds: 0o400 permissions"]
        end

        subgraph Workload["Sandbox Workload (UID 1000+)"]
            SandboxProc["Sandbox Process<br/>seccomp + Landlock<br/>No credential access<br/>Egress intercepted by nftables"]
        end

        SandboxProc -->|"Unix Socket IPC<br/>Peer Credential Validation"| NetSupervisor
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        LLM["Upstream LLM Providers<br/>OpenAI / Claude / Vertex AI<br/>443/TCP HTTPS<br/>Injected API Key / OAuth"]
    end

    %% Flows
    Client -->|"gRPC/8080 or HTTPS/443<br/>TLS 1.2+ (rustls)<br/>OIDC JWT Bearer"| EnvoyGW
    EnvoyGW -->|"gRPC/8080<br/>TLS 1.2+<br/>JWT Passthrough"| Gateway
    Client -.->|"Direct: gRPC/8080<br/>TLS 1.2+ (rustls)<br/>OIDC JWT / mTLS"| Gateway
    Gateway -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Gateway -->|"HTTPS/443<br/>TLS 1.2+<br/>None (JWKS)"| OIDC
    Gateway -->|"HTTPS/8200<br/>TLS 1.2+<br/>K8s SA Token"| Vault
    Gateway -->|"SQL/5432<br/>TLS optional<br/>Conn String"| PostgreSQL
    Gateway -->|"gRPC Stream<br/>mTLS<br/>Sandbox JWT"| NetSupervisor
    SandboxProc -->|"443/TCP intercepted<br/>HTTP CONNECT<br/>Binary ID (/proc/pid/exe)"| NetSupervisor
    NetSupervisor -->|"HTTPS/443<br/>TLS 1.2+<br/>Injected Credentials"| LLM

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef dataplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef sidecar fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class EnvoyGW ingress
    class Gateway controlplane
    class K8sAPI,OIDC,Vault,PostgreSQL platform
    class NetSupervisor sidecar
    class SandboxProc workload
    class LLM externalservice
