graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph GatewayLayer["GATEWAY LAYER (Auth Delegation Point)"]
        Gateway["Gateway<br/>(Gateway API / Istio / kgateway)<br/>80/TCP HTTP<br/>Auth: Delegated to gateway/mesh"]

        subgraph RouterStack["llm-d-router"]
            EPP["Endpoint Picker Plugin<br/>9002/TCP gRPC<br/>Scoring: queue, kv-cache,<br/>prefix-cache, lru"]
            Envoy["Envoy Proxy<br/>8081/TCP HTTP<br/>ORIGINAL_DST routing<br/>Encryption: None"]
        end
    end

    subgraph ModelServer["MODEL SERVER LAYER (Internal)"]
        direction TB

        subgraph DecodeNS["Decode Deployment"]
            Decode["vLLM Decode Server<br/>8000/TCP HTTP<br/>Auth: None<br/>Encryption: None<br/>Endpoints: /v1/completions,<br/>/v1/models, /health"]
        end

        subgraph PrefillNS["Prefill Deployment (P/D mode)"]
            Prefill["vLLM Prefill Server<br/>8000/TCP HTTP<br/>Auth: None<br/>Encryption: None"]
        end
    end

    subgraph CRDLayer["KUBERNETES CRD LAYER"]
        InferencePool["InferencePool CR<br/>(gateway-api-inference-extension)"]
        InferenceModel["InferenceModel CR<br/>(gateway-api-inference-extension)"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC<br/>Encryption: None"]
        Prometheus["Prometheus<br/>(optional)"]
    end

    %% Flows
    Client -->|"HTTP/80<br/>Auth: Delegated"| Gateway
    Gateway -->|"gRPC/9002<br/>ext_proc"| EPP
    Gateway -->|"HTTP/8081"| Envoy
    Envoy -->|"HTTP/8000<br/>x-gateway-destination-endpoint<br/>No Encryption, No Auth"| Decode
    Envoy -->|"HTTP/8000<br/>No Encryption, No Auth"| Prefill
    Prefill -->|"TCP/5600 nixl<br/>KV cache transfer<br/>Encryption: Unknown"| Decode

    InferencePool -.->|watched by| EPP
    InferenceModel -.->|watched by| EPP

    EPP -->|"gRPC/4317<br/>Traces<br/>No Encryption"| OTel
    Decode -.->|metrics| Prometheus
    Prefill -.->|metrics| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef router fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef modelserver fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef crd fill:#e8e8e8,stroke:#666,stroke-width:1px
    classDef observability fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px

    class Client external
    class Gateway gateway
    class EPP,Envoy router
    class Decode,Prefill modelserver
    class InferencePool,InferenceModel crd
    class OTel,Prometheus observability
