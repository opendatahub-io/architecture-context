graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_Module["trustyai-operator-module-<br/>controller-manager"]
        SA_Service["{name}-service<br/>(per EvalHub instance)"]
        SA_Proxy["{name}-proxy<br/>(per TrustyAI instance)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_Module["trustyai-operator-module-<br/>manager-rolebinding"]
        CRB_Auth["{name}-{namespace}-<br/>auth-reviewer-crb"]
        CRB_Proxy["{name}-{namespace}-<br/>proxy-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_Module["trustyai-operator-module-<br/>manager-role"]
        CR_Auth["trustyai-service-operator-<br/>evalhub-auth-reviewer-role"]
        CR_Proxy["trustyai-service-operator-<br/>proxy-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["(core)<br/>configmaps<br/>CRUD + watch"]
        Events["(core)<br/>events<br/>create, patch, update"]
        Services["(core)<br/>services<br/>get, list, patch, watch"]
    end

    subgraph AppsResources["Apps Resources"]
        Deployments["apps<br/>deployments<br/>get, list, patch, watch"]
    end

    subgraph TrustyAIResources["TrustyAI Resources"]
        TrustyAIs["components.platform.opendatahub.io<br/>trustyais<br/>CRUD + watch"]
        TrustyAIFinalizers["components.platform.opendatahub.io<br/>trustyais/finalizers<br/>update"]
        TrustyAIStatus["components.platform.opendatahub.io<br/>trustyais/status<br/>get, patch, update"]
    end

    subgraph IntegrationResources["Integration Resources"]
        Leases["coordination.k8s.io<br/>leases<br/>CRUD + watch"]
        InferenceServices["serving.kserve.io<br/>inferenceservices<br/>get, list"]
        Prometheuses["monitoring.coreos.com<br/>prometheuses<br/>get, list"]
        RoleBindings["rbac.authorization.k8s.io<br/>rolebindings<br/>get, list, patch, watch"]
    end

    %% SA → CRB → CR bindings
    SA_CM -->|bound via| CRB_Manager
    SA_Module -->|bound via| CRB_Module
    SA_Service -->|bound via| CRB_Auth
    SA_Proxy -->|bound via| CRB_Proxy

    CRB_Manager -->|grants| CR_Manager
    CRB_Module -->|grants| CR_Module
    CRB_Auth -->|grants| CR_Auth
    CRB_Proxy -->|grants| CR_Proxy

    %% CR → Resources (manager-role and module-role have same perms)
    CR_Manager -->|CRUD + watch| ConfigMaps
    CR_Manager -->|create, patch, update| Events
    CR_Manager -->|get, list, patch, watch| Services
    CR_Manager -->|get, list, patch, watch| Deployments
    CR_Manager -->|CRUD + watch| TrustyAIs
    CR_Manager -->|update| TrustyAIFinalizers
    CR_Manager -->|get, patch, update| TrustyAIStatus
    CR_Manager -->|CRUD + watch| Leases
    CR_Manager -->|get, list| InferenceServices
    CR_Manager -->|get, list| Prometheuses
    CR_Manager -->|get, list, patch, watch| RoleBindings

    CR_Module -->|same permissions| CR_Manager

    style SA_CM fill:#4a90e2,color:#fff
    style SA_Module fill:#4a90e2,color:#fff
    style SA_Service fill:#4a90e2,color:#fff
    style SA_Proxy fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Module fill:#f5a623,stroke:#333
    style CR_Auth fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style TrustyAIs fill:#7ed321
    style TrustyAIFinalizers fill:#7ed321
    style TrustyAIStatus fill:#7ed321
    style InferenceServices fill:#d5e8d4
    style Prometheuses fill:#d5e8d4
