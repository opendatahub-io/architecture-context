graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_Svc["{name}-service<br/>(tenant namespace)"]
        SA_Proxy["{name}-proxy<br/>(tenant namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Auth["manager-auth-delegator<br/>(Cluster-scoped)"]
        CRB_Proxy["proxy-rolebinding<br/>(Namespace: system)"]
        CRB_TLS["tls-profile-reader-binding<br/>(Namespace: system)"]
        CRB_Reviewer["{name}-{ns}-auth-reviewer-crb<br/>(per tenant namespace)"]
        CRB_TenantProxy["{name}-{ns}-proxy-rolebinding<br/>(per tenant namespace)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding<br/>(Namespace: system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_AuthDelegator["system:auth-delegator<br/>(built-in)"]
        CR_Proxy["proxy-role"]
        CR_TLS["tls-profile-reader"]
        CR_Reviewer["evalhub-auth-reviewer-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role<br/>(Namespace: system)"]
    end

    subgraph ProxyRoleResources["proxy-role Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
    end

    subgraph TLSResources["tls-profile-reader Resources"]
        APIServers["config.openshift.io<br/>apiservers<br/>Verbs: get"]
    end

    subgraph LeaderElectionResources["leader-election-role Resources"]
        ConfigMaps["core<br/>configmaps<br/>Verbs: create, delete, get,<br/>list, patch, update, watch"]
        Leases["coordination.k8s.io<br/>leases<br/>Verbs: create, delete, get,<br/>list, patch, update, watch"]
        Events["core<br/>events<br/>Verbs: create, patch"]
    end

    %% Controller Manager bindings
    SA_CM -->|"bound via"| CRB_Auth
    CRB_Auth -->|"grants"| CR_AuthDelegator

    SA_CM -->|"bound via"| CRB_Proxy
    CRB_Proxy -->|"grants"| CR_Proxy

    SA_CM -->|"bound via"| CRB_TLS
    CRB_TLS -->|"grants"| CR_TLS

    SA_CM -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| R_Leader

    %% Tenant service account bindings
    SA_Svc -->|"bound via"| CRB_Reviewer
    CRB_Reviewer -->|"grants"| CR_Reviewer

    SA_Proxy -->|"bound via"| CRB_TenantProxy
    CRB_TenantProxy -->|"grants"| CR_Proxy

    %% Role → Resources
    CR_Proxy -->|"allows"| TokenReviews
    CR_Proxy -->|"allows"| SAR

    CR_TLS -->|"allows"| APIServers

    R_Leader -->|"allows"| ConfigMaps
    R_Leader -->|"allows"| Leases
    R_Leader -->|"allows"| Events

    %% Styling
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style SA_Svc fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proxy fill:#4a90e2,stroke:#333,color:#fff
    style CR_Proxy fill:#f5a623,stroke:#333
    style CR_TLS fill:#f5a623,stroke:#333
    style CR_AuthDelegator fill:#f5a623,stroke:#333
    style CR_Reviewer fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Leases fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
