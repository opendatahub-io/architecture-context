graph TD
    subgraph "Administrator Authentication"
        Admin["Administrator<br/>(kubeconfig credentials)"]
    end

    subgraph "Service Accounts"
        SA["ServiceAccount<br/>rhaii-validator<br/>ns: rhaii-validation"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["ClusterRoleBinding<br/>rhaii-validator"]
        CRB2["ClusterRoleBinding<br/>rhaii-validator-scc-{namespace}"]
    end

    subgraph "ClusterRoles"
        CR["ClusterRole<br/>rhaii-validator<br/>(dynamically created)"]
        SCC["ClusterRole<br/>system:openshift:scc:privileged<br/>(OpenShift built-in)"]
    end

    subgraph "Kubernetes API Resources Managed"
        NS["/v1/Namespace<br/>(rhaii-validation)"]
        SARes["/v1/ServiceAccount"]
        CMRes["/v1/ConfigMap<br/>(validation reports)"]
        JobRes["batch/v1/Job<br/>(agent pods)"]
        CRRes["rbac/v1/ClusterRole"]
        CRBRes["rbac/v1/ClusterRoleBinding"]
    end

    subgraph "API Resources Queried (Tier 1)"
        CRDs["apiextensions/v1<br/>CustomResourceDefinitions"]
        Pods["/v1/Pods<br/>(operator namespaces)"]
    end

    subgraph "Agent Pod Security Context"
        Privileged["securityContext:<br/>privileged: true"]
        NoToken["automountServiceAccountToken:<br/>false"]
    end

    %% Admin flow
    Admin -->|"kubeconfig auth<br/>creates RBAC dynamically"| CR
    Admin -->|"kubeconfig auth<br/>queries API"| CRDs
    Admin -->|"kubeconfig auth<br/>queries API"| Pods

    %% RBAC bindings
    SA -->|"bound via"| CRB1
    CRB1 -->|"grants"| CR
    SA -->|"bound via"| CRB2
    CRB2 -->|"grants"| SCC

    %% ClusterRole permissions
    CR -->|"create, get, list,<br/>watch, delete"| NS
    CR -->|"create, get, list,<br/>watch, delete"| SARes
    CR -->|"create, get, list,<br/>watch, delete"| CMRes
    CR -->|"create, get, list,<br/>watch, delete"| JobRes
    CR -->|"create, get, list,<br/>watch, delete"| CRRes
    CR -->|"create, get, list,<br/>watch, delete"| CRBRes

    %% SCC grants
    SCC -->|"allows"| Privileged

    %% Agent pod config
    Privileged -.->|"enables GPU/RDMA<br/>device access"| JobRes
    NoToken -.->|"prevents API access<br/>from agent pods"| JobRes

    style Admin fill:#08427b,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333
    style SCC fill:#f5a623,stroke:#333
    style Privileged fill:#f8cecc,stroke:#b85450
    style NoToken fill:#d5e8d4,stroke:#82b366
    style NS fill:#7ed321,stroke:#333
    style SARes fill:#7ed321,stroke:#333
    style CMRes fill:#7ed321,stroke:#333
    style JobRes fill:#7ed321,stroke:#333
    style CRRes fill:#7ed321,stroke:#333
    style CRBRes fill:#7ed321,stroke:#333
    style CRDs fill:#fff2cc,stroke:#d6b656
    style Pods fill:#fff2cc,stroke:#d6b656
