graph TB
    subgraph Operator["Dashboard Operator (Go)"]
        direction TB
        DashboardCtrl["Dashboard Controller<br/>controller-runtime"]
        WorkspaceCtrl["Workspace Controller"]
        WorkspaceKindCtrl["WorkspaceKind Controller"]
        Webhook["Admission Webhooks<br/>validate-dashboard<br/>validate-workspace<br/>validate-workspacekind<br/>conversion webhook"]
        DashboardCtrl --> Webhook
    end

    subgraph Frontend["Frontend / Backend (Node.js)"]
        direction TB
        ReactSPA["React/PatternFly SPA<br/>Webpack Module Federation"]
        FastifyBackend["Fastify Backend<br/>Port 8443/HTTPS"]
        ReactSPA -->|"served by"| FastifyBackend
    end

    subgraph BFFSidecars["Go BFF Sidecars"]
        direction TB
        CoreBFF["core-bff<br/>Port 8080"]
        GenAI["gen-ai BFF<br/>Port 8143/TLS"]
        ModelReg["model-registry BFF<br/>Port 8043/TLS"]
        MaaS["maas BFF<br/>Port 8243/TLS"]
        MLflow["mlflow BFF<br/>Port 8343/TLS"]
        EvalHub["eval-hub BFF<br/>Port 8543/TLS"]
        AutoML["automl BFF<br/>Port 8643/TLS"]
        AutoRAG["autorag BFF<br/>Port 8743/TLS"]
        AgentOps["agent-ops BFF<br/>Port 8843/TLS"]
    end

    %% CRDs managed
    DashboardCR["Dashboard CR<br/>components.platform.opendatahub.io"]
    WorkspaceCR["Workspace CR<br/>kubeflow.org/v1beta1"]
    WorkspaceKindCR["WorkspaceKind CR<br/>kubeflow.org/v1beta1"]

    %% External user
    User["User / Browser"]

    %% Flows
    User -->|"HTTPS/443"| KubeRBACProxy["kube-rbac-proxy<br/>OAuth Proxy"]
    KubeRBACProxy -->|"x-forwarded-access-token"| FastifyBackend
    FastifyBackend -->|"/_mf/:name/*"| BFFSidecars
    FastifyBackend -->|"/api/*"| K8sAPI["Kubernetes API<br/>Port 6443"]

    %% Operator watches
    DashboardCR -->|"watched by"| DashboardCtrl
    WorkspaceCR -->|"watched by"| WorkspaceCtrl
    WorkspaceKindCR -->|"watched by"| WorkspaceKindCtrl

    %% Operator creates resources
    DashboardCtrl -->|"creates/manages"| Deployments["Deployments<br/>Services, Routes<br/>RBAC, NetworkPolicies<br/>PDBs, ConfigMaps"]

    %% rhods-operator ownership
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates"| DashboardCR

    %% BFF -> K8s
    GenAI -->|"SubjectAccessReview"| K8sAPI
    ModelReg -->|"SubjectAccessReview"| K8sAPI
    AgentOps -->|"SubjectAccessReview"| K8sAPI
    MaaS -->|"SubjectAccessReview"| K8sAPI

    %% Platform CRDs watched
    DashboardCtrl -->|"watches"| PlatformCRDs["DataScienceCluster CR<br/>DSCInitialization CR<br/>InferenceService CR<br/>ModelRegistry CR<br/>TrustyAI CR<br/>MLflow CR<br/>Feast FeatureStore CR"]

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style Frontend fill:#7ed321,stroke:#333,color:#fff
    style BFFSidecars fill:#f5a623,stroke:#333,color:#fff
    style DashboardCR fill:#e8e8e8,stroke:#666
    style WorkspaceCR fill:#e8e8e8,stroke:#666
    style WorkspaceKindCR fill:#e8e8e8,stroke:#666
    style RhodsOp fill:#bd10e0,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style KubeRBACProxy fill:#d0021b,stroke:#333,color:#fff
    style PlatformCRDs fill:#e8e8e8,stroke:#666
