graph TB
    subgraph "llama-stack-provider-trustyai-garak"
        direction TB
        subgraph "Adapter Core"
            GarakAdapter["GarakAdapter<br/>(FrameworkAdapter impl)"]
            PipelineSteps["Pipeline Steps<br/>(credential resolution,<br/>config preparation)"]
            S3Utils["S3 Utilities<br/>(artifact upload/download)"]
        end

        subgraph "Execution Modes"
            SimpleMode["Simple Mode<br/>(in-pod subprocess)"]
            KFPMode["KFP Mode<br/>(Kubeflow Pipeline)"]
        end

        subgraph "KFP Pipeline Steps"
            Validation["1. Validation"]
            TaxonomyRes["2. Taxonomy Resolution"]
            SDGPromptGen["3. SDG Prompt Generation"]
            PromptPrep["4. Prompt Preparation"]
            GarakScan["5. Garak Scan Execution"]
            KFPOutput["6. KFP Output Writing"]
        end
    end

    ConfigMap["/etc/eval-job/spec.json<br/>(Mounted ConfigMap)"]
    EvalHub["eval-hub<br/>(Sidecar Callbacks)"]
    GarakFramework["Garak Framework<br/>(v0.15.0+rhaiv.5)"]
    OCIRegistry["OCI Registry<br/>(Artifact Persistence)"]
    TargetModel["Target Model Endpoint<br/>(OpenAI-compatible)"]
    S3Storage["S3-Compatible Storage<br/>(Data Connection)"]
    KFPServer["Kubeflow Pipelines<br/>Server"]

    ConfigMap -->|"job spec"| GarakAdapter
    GarakAdapter -->|"resolves credentials"| PipelineSteps
    GarakAdapter -->|"uploads/downloads"| S3Utils
    GarakAdapter -->|"simple exec"| SimpleMode
    GarakAdapter -->|"pipeline exec"| KFPMode

    SimpleMode -->|"runs subprocess"| GarakFramework
    KFPMode -->|"creates pipeline"| KFPServer
    KFPServer -->|"executes"| Validation
    Validation --> TaxonomyRes
    TaxonomyRes --> SDGPromptGen
    SDGPromptGen --> PromptPrep
    PromptPrep --> GarakScan
    GarakScan --> KFPOutput

    GarakFramework -->|"scans"| TargetModel
    GarakScan -->|"scans"| TargetModel
    S3Utils -->|"artifact transfer"| S3Storage
    KFPOutput -->|"results"| S3Storage
    GarakAdapter -->|"persists artifacts"| OCIRegistry
    GarakAdapter -->|"reports results"| EvalHub

    style GarakAdapter fill:#4a90e2,stroke:#333,stroke-width:2px
    style PipelineSteps fill:#4a90e2,stroke:#333
    style S3Utils fill:#4a90e2,stroke:#333
    style SimpleMode fill:#7ed321,stroke:#333
    style KFPMode fill:#7ed321,stroke:#333
    style Validation fill:#b8d4f0,stroke:#333
    style TaxonomyRes fill:#b8d4f0,stroke:#333
    style SDGPromptGen fill:#b8d4f0,stroke:#333
    style PromptPrep fill:#b8d4f0,stroke:#333
    style GarakScan fill:#b8d4f0,stroke:#333
    style KFPOutput fill:#b8d4f0,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style EvalHub fill:#f5a623,stroke:#333
    style GarakFramework fill:#e8e8e8,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style TargetModel fill:#e8e8e8,stroke:#333
    style S3Storage fill:#e8e8e8,stroke:#333
    style KFPServer fill:#e8e8e8,stroke:#333
