graph TB
    subgraph "llama-stack-provider-trustyai-garak (Kubernetes Job)"
        subgraph "Core Adapter"
            GarakAdapter["GarakAdapter<br/>(FrameworkAdapter)"]
            PipelineSteps["Pipeline Steps<br/>(Credential Resolution)"]
            S3Utils["S3 Utils<br/>(Results Upload)"]
        end

        subgraph "Operational Modes"
            SimpleMode["Simple Mode<br/>(In-Pod Execution)"]
            KFPMode["KFP Mode<br/>(Remote Pipeline)"]
        end

        GarakAdapter -->|simple| SimpleMode
        GarakAdapter -->|kfp| KFPMode
        GarakAdapter -->|resolves credentials| PipelineSteps
        GarakAdapter -->|uploads results| S3Utils
    end

    subgraph "Credential Sources"
        EnvVars["Environment Variables<br/>API_KEY, OPENAICOMPATIBLE_API_KEY"]
        KFPSecrets["KFP-Mounted Secrets<br/>/mnt/model-auth/"]
        EvalHubSecrets["Eval-Hub Secrets<br/>/var/run/secrets/model/"]
        SAToken["ServiceAccount Token<br/>/var/run/secrets/kubernetes.io/"]
        AWSCreds["AWS Credentials<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
    end

    EvalHubConfig["Eval-Hub<br/>Evaluation Configuration"] -->|triggers| GarakAdapter

    PipelineSteps -->|cascade lookup| EnvVars
    PipelineSteps -->|cascade lookup| KFPSecrets
    PipelineSteps -->|cascade lookup| EvalHubSecrets

    KFPMode -->|authenticates via| SAToken
    KFPMode -->|submits run| KFP["Kubeflow Pipelines API"]

    SimpleMode -->|executes| GarakProbes["Garak Red-Teaming Probes"]
    GarakProbes -->|calls| LLMEndpoint["Target LLM Endpoint"]

    S3Utils -->|authenticates via| AWSCreds
    S3Utils -->|uploads to| S3["S3-Compatible Storage"]

    style GarakAdapter fill:#4a90e2,stroke:#333
    style PipelineSteps fill:#4a90e2,stroke:#333
    style S3Utils fill:#4a90e2,stroke:#333
    style SimpleMode fill:#50c878,stroke:#333
    style KFPMode fill:#50c878,stroke:#333
    style KFP fill:#999,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style LLMEndpoint fill:#f5a623,stroke:#333
    style EvalHubConfig fill:#7ed321,stroke:#333
    style EnvVars fill:#ffe6cc,stroke:#d79b00
    style KFPSecrets fill:#ffe6cc,stroke:#d79b00
    style EvalHubSecrets fill:#ffe6cc,stroke:#d79b00
    style SAToken fill:#ffe6cc,stroke:#d79b00
    style AWSCreds fill:#ffe6cc,stroke:#d79b00
