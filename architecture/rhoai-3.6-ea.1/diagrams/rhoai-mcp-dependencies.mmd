graph LR
    RhoaiMcp["rhoai-mcp<br/>MCP Server"]

    %% External Dependencies (Python packages)
    RhoaiMcp -->|"MCP protocol"| MCP["mcp >=1.0.0"]
    RhoaiMcp -->|"plugin system"| Pluggy["pluggy >=1.4.0"]
    RhoaiMcp -->|"K8s client"| K8sLib["kubernetes >=28.1.0"]
    RhoaiMcp -->|"HTTP client"| HTTPX["httpx >=0.27.0"]
    RhoaiMcp -->|"JWT auth"| PyJWT["pyjwt >=2.12.0"]
    RhoaiMcp -->|"data models"| Pydantic["pydantic >=2.0.0"]
    RhoaiMcp -->|"config"| PydanticSettings["pydantic-settings >=2.0.0"]
    RhoaiMcp -->|"runtime"| Python["Python >=3.10"]

    %% Internal RHOAI Dependencies (via K8s API)
    RhoaiMcp -->|"CRD CRUD"| KubeflowNotebooks["Kubeflow Notebooks<br/>(kubeflow.org)"]
    RhoaiMcp -->|"CRD Watch/CRUD"| KServe["KServe InferenceService<br/>(serving.kserve.io)"]
    RhoaiMcp -->|"CRD CRUD"| ServingRuntime["ServingRuntime<br/>(serving.kserve.io)"]
    RhoaiMcp -->|"CRD CRUD"| TrainingOp["Kubeflow Training Operator<br/>(trainer.kubeflow.org)"]
    RhoaiMcp -->|"CRD CRUD"| DSPipelines["Data Science Pipelines<br/>(opendatahub.io)"]
    RhoaiMcp -->|"HTTP client"| ModelRegistry["Model Registry<br/>:8080"]

    %% Infrastructure Dependencies
    RhoaiMcp -->|"API server"| K8sAPI["Kubernetes API<br/>:6443"]

    %% Styling
    style RhoaiMcp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External packages
    style MCP fill:#999,stroke:#333,color:#fff
    style Pluggy fill:#999,stroke:#333,color:#fff
    style K8sLib fill:#999,stroke:#333,color:#fff
    style HTTPX fill:#999,stroke:#333,color:#fff
    style PyJWT fill:#999,stroke:#333,color:#fff
    style Pydantic fill:#999,stroke:#333,color:#fff
    style PydanticSettings fill:#999,stroke:#333,color:#fff
    style Python fill:#999,stroke:#333,color:#fff

    %% Internal RHOAI components
    style KubeflowNotebooks fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ServingRuntime fill:#7ed321,stroke:#333
