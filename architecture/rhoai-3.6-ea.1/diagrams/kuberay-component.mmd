graph TB
    subgraph KubeRayOperator["KubeRay Operator"]
        direction TB
        RayClusterCtrl["RayCluster Controller"]
        RayJobCtrl["RayJob Controller"]
        RayServiceCtrl["RayService Controller"]
        RayCronJobCtrl["RayCronJob Controller"]
        AuthCtrl["Authentication Controller<br/>(kube-rbac-proxy injection)"]
        MTLSCtrl["mTLS Controller<br/>(cert-manager integration)"]
        NetPolCtrl["NetworkPolicy Controller"]
        Webhook["Admission Webhook Server<br/>(mutating + validating)"]
        MetricsSrv["Metrics Server<br/>:8080/metrics"]
        HealthSrv["Health/Readiness<br/>:8082"]
        TLSProfile["TLS Profile Watcher<br/>(OpenShift alignment)"]
    end

    %% CRDs watched
    RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    RayServiceCR["RayService CR<br/>(ray.io/v1)"]
    RayCronJobCR["RayCronJob CR<br/>(ray.io/v1)"]

    %% User
    User["Data Scientist / User"]

    %% Created resources
    Pods["Ray Head + Worker Pods"]
    Services["K8s Services"]
    Secrets["TLS Secrets"]
    Certs["cert-manager<br/>Certificates + Issuers"]
    HTTPRoutes["Gateway API<br/>HTTPRoutes + ReferenceGrants"]
    NetPolicies["NetworkPolicies"]
    Routes["OpenShift Routes"]

    %% External dependencies
    CertManager["cert-manager"]
    GatewayAPI["Gateway API Controller"]
    K8sAPI["Kubernetes API Server"]
    Prometheus["Prometheus"]
    OpenShiftAPI["OpenShift APIServer Config"]

    %% User creates CRs
    User -->|creates| RayClusterCR
    User -->|creates| RayJobCR
    User -->|creates| RayServiceCR
    User -->|creates| RayCronJobCR

    %% Controllers watch CRs
    RayClusterCR -->|watched by| RayClusterCtrl
    RayClusterCR -->|watched by| AuthCtrl
    RayClusterCR -->|watched by| MTLSCtrl
    RayClusterCR -->|watched by| NetPolCtrl
    RayJobCR -->|watched by| RayJobCtrl
    RayServiceCR -->|watched by| RayServiceCtrl
    RayCronJobCR -->|watched by| RayCronJobCtrl

    %% Controllers create resources
    RayClusterCtrl -->|creates/manages| Pods
    RayClusterCtrl -->|creates/manages| Services
    RayClusterCtrl -->|creates/manages| Secrets
    AuthCtrl -->|injects sidecar| Pods
    AuthCtrl -->|creates| HTTPRoutes
    AuthCtrl -->|creates| Routes
    MTLSCtrl -->|creates| Certs
    NetPolCtrl -->|creates| NetPolicies
    RayJobCtrl -->|creates| RayClusterCR

    %% Webhook validates
    Webhook -->|validates/mutates| RayClusterCR
    Webhook -->|validates| RayJobCR
    Webhook -->|validates| RayServiceCR

    %% External integrations
    MTLSCtrl -->|provisions via| CertManager
    AuthCtrl -->|routes via| GatewayAPI
    KubeRayOperator -->|watches/creates resources| K8sAPI
    Prometheus -->|scrapes| MetricsSrv
    TLSProfile -->|reads config| OpenShiftAPI

    %% Styling
    style RayClusterCtrl fill:#4a90e2,color:#fff
    style RayJobCtrl fill:#4a90e2,color:#fff
    style RayServiceCtrl fill:#4a90e2,color:#fff
    style RayCronJobCtrl fill:#4a90e2,color:#fff
    style AuthCtrl fill:#4a90e2,color:#fff
    style MTLSCtrl fill:#4a90e2,color:#fff
    style NetPolCtrl fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style MetricsSrv fill:#4a90e2,color:#fff
    style HealthSrv fill:#4a90e2,color:#fff
    style TLSProfile fill:#4a90e2,color:#fff
    style RayClusterCR fill:#f5a623,color:#000
    style RayJobCR fill:#f5a623,color:#000
    style RayServiceCR fill:#f5a623,color:#000
    style RayCronJobCR fill:#f5a623,color:#000
    style CertManager fill:#e8e8e8,color:#000
    style GatewayAPI fill:#e8e8e8,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style Prometheus fill:#e8e8e8,color:#000
    style OpenShiftAPI fill:#e8e8e8,color:#000
    style Pods fill:#7ed321,color:#000
    style Services fill:#7ed321,color:#000
    style Secrets fill:#7ed321,color:#000
    style Certs fill:#7ed321,color:#000
    style HTTPRoutes fill:#7ed321,color:#000
    style NetPolicies fill:#7ed321,color:#000
    style Routes fill:#7ed321,color:#000
