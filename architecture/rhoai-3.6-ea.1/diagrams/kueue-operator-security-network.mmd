graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist /<br/>Cluster Admin"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (openshift-kueue-operator)"]
        Operator["openshift-kueue-operator<br/>SA: openshift-kueue-operator<br/>ClusterRole: openshift-kueue-operator<br/>Manages: CRDs, RBAC, Webhooks, Certs"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (kueue-system)"]
        direction TB

        Controller["kueue-controller-manager<br/>SA: kueue-controller-manager<br/>ClusterRole: kueue-manager-role (36 rules)<br/>FIPS: strictfipsruntime + UBI9 OpenSSL"]

        WebhookSvc["kueue-webhook-service<br/>ClusterIP 443→9443/TCP<br/>TLS (cert-manager)<br/>35 webhooks, failurePolicy: Fail"]

        VisibilitySvc["kueue-visibility-server<br/>ClusterIP 443→8082/TCP<br/>API aggregation<br/>visibility.kueue.x-k8s.io"]

        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP<br/>HTTPS<br/>TokenReview + SubjectAccessReview"]

        HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>No Auth<br/>/healthz, /readyz"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>SA: prometheus-k8s<br/>ServiceMonitor scrape"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRDs<br/>Webhook TLS lifecycle"]
        PromOperator["prometheus-operator<br/>ServiceMonitor CRD"]
    end

    subgraph WorkloadIntegrations["WORKLOAD INTEGRATIONS"]
        Kubeflow["Kubeflow Training<br/>kubeflow.org<br/>PyTorch/TF/MPI/Paddle/XGBoost"]
        Ray["Ray<br/>ray.io<br/>RayCluster, RayJob"]
        JobSet["JobSet<br/>jobset.x-k8s.io"]
        CodeFlare["CodeFlare<br/>workload.codeflare.dev<br/>AppWrapper"]
        LWS["LeaderWorkerSet<br/>leaderworkerset.x-k8s.io"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| APIServer

    %% API Server to webhooks
    APIServer -->|"HTTPS/443→9443<br/>TLS (cert-manager)<br/>Admission Auth<br/>failurePolicy: Fail"| WebhookSvc

    %% API Server to visibility
    APIServer -->|"HTTPS/443→8082<br/>API Aggregation<br/>Auth delegation"| VisibilitySvc

    %% Operator to API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| APIServer

    %% Controller to API
    Controller -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA token"| APIServer

    %% Prometheus scrape
    Prometheus -->|"HTTPS/8443<br/>TokenReview +<br/>SubjectAccessReview"| MetricsSvc

    %% Platform dependency interactions
    Operator -.->|"manages CRs"| CertManager
    Operator -.->|"creates"| PromOperator

    %% Workload webhook interception
    Controller -.->|"webhooks +<br/>finalizers"| Kubeflow
    Controller -.->|"webhooks +<br/>finalizers"| Ray
    Controller -.->|"webhooks"| JobSet
    Controller -.->|"webhooks +<br/>finalizers"| CodeFlare
    Controller -.->|"webhooks"| LWS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef dependency fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef workload fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class APIServer controlplane
    class Operator operator
    class Controller controller
    class WebhookSvc,VisibilitySvc,MetricsSvc,HealthProbe service
    class Prometheus,PromOperator monitoring
    class CertManager dependency
    class Kubeflow,Ray,JobSet,CodeFlare,LWS workload
