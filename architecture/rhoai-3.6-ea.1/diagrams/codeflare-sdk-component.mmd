graph TB
    subgraph "CodeFlare SDK"
        direction TB
        RayJobClient["RayJobClient<br/>(Ray Job Submission)"]
        KueueIntegration["Kueue Integration<br/>(Queue Management)"]
        AuthLayer["Authentication Layer<br/>(kube-authkit)"]
        CertGen["Certificate Generator<br/>(TLS/mTLS)"]

        AuthLayer -->|"authenticated client"| RayJobClient
        AuthLayer -->|"authenticated client"| KueueIntegration
        AuthLayer -->|"authenticated client"| CertGen
    end

    User["Data Scientist / User"] -->|"submit jobs"| RayJobClient
    User -->|"query queues"| KueueIntegration

    RayJobClient -->|"HTTP/HTTPS"| RayDashboard["Ray Cluster Dashboard"]
    KueueIntegration -->|"kueue.x-k8s.io/v1beta1"| KueueAPI["Kueue API<br/>(LocalQueues, WorkloadPriorityClasses)"]
    AuthLayer -->|"Bearer token / kubeconfig / in-cluster"| K8sAPI["Kubernetes API Server"]
    CertGen -->|"store certs as Secrets"| K8sSecrets["Kubernetes Secrets"]
    CertGen -->|"RSA-3072 / SHA-256"| RayClusters["Ray Clusters<br/>(mTLS)"]

    subgraph "Test Infrastructure (non-production)"
        direction LR
        TestRunner["Test Container<br/>(images/tests/Dockerfile)"]
        MinIO["MinIO<br/>(Object Storage)<br/>9000/TCP, 9090/TCP"]
    end

    style RayJobClient fill:#4a90e2,stroke:#333,color:#fff
    style KueueIntegration fill:#4a90e2,stroke:#333,color:#fff
    style AuthLayer fill:#4a90e2,stroke:#333,color:#fff
    style CertGen fill:#4a90e2,stroke:#333,color:#fff
    style RayDashboard fill:#7ed321,stroke:#333
    style KueueAPI fill:#7ed321,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style K8sSecrets fill:#999,stroke:#333,color:#fff
    style RayClusters fill:#7ed321,stroke:#333
    style TestRunner fill:#e8e8e8,stroke:#999
    style MinIO fill:#e8e8e8,stroke:#999
    style User fill:#f5a623,stroke:#333
