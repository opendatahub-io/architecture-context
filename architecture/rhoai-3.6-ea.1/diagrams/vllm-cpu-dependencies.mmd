graph LR
    VllmCPU["vllm-cpu<br/>LLM Inference Engine"]

    %% Internal RHOAI Dependencies
    VllmCPU -->|"deployed by<br/>lifecycle management"| KServe["KServe / ModelMesh"]

    %% External Service Dependencies
    VllmCPU -->|"model download<br/>HTTPS/443"| HFHub["HuggingFace Hub"]
    VllmCPU -->|"usage telemetry<br/>HTTPS/443"| RHStats["RHOAI Usage Stats<br/>console.redhat.com"]

    %% Runtime Dependencies
    VllmCPU -->|"runtime"| Python["Python >=3.10, <3.15"]
    VllmCPU -->|"base image"| UBI9["UBI 9<br/>System OpenSSL"]
    VllmCPU -->|"gRPC servicer"| SMG["smg-grpc-servicer<br/>VllmEngineServicer"]

    %% Build Variants
    subgraph "Build Targets"
        CPU["x86_64 CPU<br/>(Konflux)"]
        S390X["s390x CPU"]
        PPC64LE["ppc64le CPU"]
        ROCm["ROCm GPU"]
        HPU["HPU (Gaudi)"]
        TPU["TPU"]
    end

    VllmCPU -.->|"multi-arch builds"| CPU
    VllmCPU -.->|"multi-arch builds"| S390X
    VllmCPU -.->|"multi-arch builds"| PPC64LE
    VllmCPU -.->|"multi-arch builds"| ROCm
    VllmCPU -.->|"multi-arch builds"| HPU
    VllmCPU -.->|"multi-arch builds"| TPU

    %% Platform Integration (consumers)
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe
    DSPipelines["Data Science Pipelines"] -.->|"model deployment"| KServe

    style VllmCPU fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style HFHub fill:#f5a623,stroke:#333
    style RHStats fill:#f5a623,stroke:#333
    style Python fill:#999,stroke:#333
    style UBI9 fill:#999,stroke:#333
    style SMG fill:#999,stroke:#333
    style CPU fill:#dae8fc,stroke:#6c8ebf
    style S390X fill:#dae8fc,stroke:#6c8ebf
    style PPC64LE fill:#dae8fc,stroke:#6c8ebf
    style ROCm fill:#dae8fc,stroke:#6c8ebf
    style HPU fill:#dae8fc,stroke:#6c8ebf
    style TPU fill:#dae8fc,stroke:#6c8ebf
    style Dashboard fill:#d5e8d4,stroke:#82b366
    style DSPipelines fill:#d5e8d4,stroke:#82b366
