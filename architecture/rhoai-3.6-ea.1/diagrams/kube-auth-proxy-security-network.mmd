graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
        OIDCProvider["OAuth2/OIDC Provider<br/>(OpenShift OAuth)<br/>HTTPS / TLS"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["Route: your-app.apps.cluster.example.com<br/>443/TCP HTTPS<br/>TLS Termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph ProxyService["Service: kube-auth-proxy (ClusterIP)"]
            ServicePort["80/TCP → 4180/TCP"]
        end

        subgraph ProxyPod["kube-auth-proxy Pod<br/>FIPS: strictfipsruntime + CGO_ENABLED=1<br/>Base: UBI9 ubi-minimal"]
            direction TB
            PreAuth["Pre-Auth Middleware<br/>/ping, logging, metrics"]
            AuthChain["Auth Chain:<br/>1. K8s TokenReview<br/>2. JWT Bearer<br/>3. OAuth2 Session<br/>4. htpasswd Basic"]
            HeaderEnrich["Header Enrichment<br/>X-Forwarded-User<br/>X-Forwarded-Email"]
            UpstreamFwd["Upstream Proxy<br/>(HTTP + WebSocket)"]
        end

        subgraph UpstreamSvc["Upstream Services"]
            Dashboard["RHOAI Dashboard<br/>Model Serving<br/>Platform Services"]
            ExampleApp["example-app<br/>ClusterIP 8080/TCP"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        KubeAPI["Kubernetes API<br/>kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        Redis["Redis/Valkey<br/>Optional TLS + Custom CA<br/>Username/Password Auth<br/>Session Persistence"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>No Auth (pre-proxy)"| Route

    %% Ingress to Service
    Route -->|"HTTP/4180<br/>Internal"| ServicePort
    ServicePort --> PreAuth

    %% Internal proxy flow
    PreAuth --> AuthChain
    AuthChain --> HeaderEnrich
    HeaderEnrich --> UpstreamFwd

    %% Upstream
    UpstreamFwd -->|"HTTP/WebSocket<br/>Trusted (pre-authenticated)"| Dashboard
    UpstreamFwd -->|"HTTP/8080<br/>Trusted"| ExampleApp

    %% Auth chain external calls
    AuthChain -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>TokenReview API"| KubeAPI
    AuthChain -->|"TCP<br/>Optional TLS<br/>Username/Password<br/>Session R/W"| Redis
    AuthChain -->|"HTTPS<br/>TLS<br/>Client Credentials<br/>Token Exchange"| OIDCProvider

    %% Secret
    Secret["Secret: kube-auth-proxy-secret<br/>(Opaque)<br/>Cookie secret, OAuth creds"]
    Secret -.->|mounted| ProxyPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef proxy fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5

    class Client,OIDCProvider external
    class Route ingress
    class Dashboard,ExampleApp internal
    class PreAuth,AuthChain,HeaderEnrich,UpstreamFwd proxy
    class KubeAPI,Redis externalservice
    class Secret secret
