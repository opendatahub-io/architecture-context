graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>(Browser / API)"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>your-app.apps.cluster.example.com<br/>443/TCP → TLS Termination"]
    end

    subgraph Cluster["CLUSTER (Internal)"]
        direction TB

        subgraph ProxyNS["kube-auth-proxy Namespace"]
            Proxy["kube-auth-proxy Pod<br/>Service: 80/TCP → 4180/TCP<br/>FIPS: strictfipsruntime<br/>TLS: 1.2-1.3 configurable"]

            subgraph AuthChain["Auth Middleware Chain"]
                direction LR
                SA["1. K8s SA Token<br/>(TokenReview)"]
                JWT["2. JWT/OAuth<br/>Bearer"]
                Basic["3. Basic Auth<br/>(htpasswd)"]
                Cookie["4. Cookie<br/>Session"]
            end
        end

        subgraph UpstreamNS["Upstream Namespace"]
            UpstreamSvc["Upstream Backend<br/>example-app<br/>8080/TCP"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        OIDCProvider["OAuth2/OIDC Provider<br/>(OpenShift OAuth)<br/>6443/TCP HTTPS<br/>OAuth2 Client Credentials"]
        Redis["Redis/Valkey (Optional)<br/>6379/TCP<br/>TLS (configurable CA)<br/>Redis Auth"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (Route)<br/>Bearer/Cookie/None"| Route
    Route -->|"HTTP/80 → 4180<br/>Cluster-internal"| Proxy
    Proxy --> AuthChain
    Proxy -->|"HTTP/8080<br/>Injected Headers:<br/>X-Forwarded-User/Groups"| UpstreamSvc

    %% External service connections
    Proxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token (in-cluster)<br/>TokenReview + OAuthAccessToken"| K8sAPI
    Proxy -->|"HTTPS/6443<br/>TLS<br/>OAuth2 Client Creds<br/>Authorize/Token Exchange"| OIDCProvider
    Proxy -->|"TCP/6379<br/>TLS (optional)<br/>Redis Auth<br/>Session Store"| Redis

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef authstep fill:#f5a623,stroke:#333

    class Client external
    class Route ingress
    class Proxy,UpstreamSvc cluster
    class K8sAPI,OIDCProvider,Redis externalservice
    class SA,JWT,Basic,Cookie authstep
