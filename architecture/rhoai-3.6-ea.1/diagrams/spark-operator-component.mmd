graph TB
    subgraph SparkOperatorModule["Spark Operator Module (Meta-Operator)"]
        ModuleController["SparkOperator Controller<br/>SA: spark-operator-module-controller-manager"]
        ModuleController -->|manages lifecycle| ControllerDeploy
        ModuleController -->|manages lifecycle| WebhookDeploy
        ModuleController -->|creates| CRDs_Managed["CRDs, RBAC, NetworkPolicies"]
        ModuleController -->|creates| CertResources["cert-manager Certificates & Issuers"]
        ModuleController -->|creates| PodMonitors["PodMonitors"]
    end

    subgraph ControllerWorkload["Controller Deployment"]
        ControllerDeploy["spark-operator-controller<br/>SA: spark-operator-controller"]
        SparkAppCtrl["SparkApplication<br/>Reconciler"]
        ScheduledCtrl["ScheduledSparkApplication<br/>Reconciler"]
        SparkConnectCtrl["SparkConnect<br/>Reconciler"]
        ControllerDeploy --- SparkAppCtrl
        ControllerDeploy --- ScheduledCtrl
        ControllerDeploy --- SparkConnectCtrl
    end

    subgraph WebhookWorkload["Webhook Deployment"]
        WebhookDeploy["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>Port: 443/TCP TLS"]
        MutatingWH["Mutating Webhooks (4)<br/>failurePolicy: Fail"]
        ValidatingWH["Validating Webhooks (3)<br/>failurePolicy: Fail"]
        ConversionWH["Conversion Webhook"]
        WebhookDeploy --- MutatingWH
        WebhookDeploy --- ValidatingWH
        WebhookDeploy --- ConversionWH
    end

    subgraph CRDs["Custom Resource Definitions"]
        SparkAppCR["SparkApplication<br/>sparkoperator.k8s.io/v1beta2<br/>Namespaced"]
        ScheduledCR["ScheduledSparkApplication<br/>sparkoperator.k8s.io/v1beta2<br/>Namespaced"]
        SparkConnectCR["SparkConnect<br/>sparkoperator.k8s.io/v1alpha1<br/>Namespaced"]
        SparkOperatorCR["SparkOperator<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster"]
    end

    %% User interactions
    User[Data Scientist / User] -->|creates| SparkAppCR
    User -->|creates| ScheduledCR
    User -->|creates| SparkConnectCR
    ODHOperator[ODH Operator] -->|creates| SparkOperatorCR

    %% CR to controller flows
    SparkOperatorCR -->|watched by| ModuleController
    SparkAppCR -->|intercepted by| MutatingWH
    SparkAppCR -->|intercepted by| ValidatingWH
    SparkAppCR -->|reconciled by| SparkAppCtrl
    ScheduledCR -->|intercepted by| MutatingWH
    ScheduledCR -->|intercepted by| ValidatingWH
    ScheduledCR -->|reconciled by| ScheduledCtrl
    SparkConnectCR -->|intercepted by| MutatingWH
    SparkConnectCR -->|intercepted by| ValidatingWH
    SparkConnectCR -->|reconciled by| SparkConnectCtrl

    %% Controller creates workloads
    SparkAppCtrl -->|creates| DriverPod["Driver Pod"]
    SparkAppCtrl -->|creates| ExecutorPods["Executor Pods"]
    SparkAppCtrl -->|creates| Services["Services"]
    SparkAppCtrl -->|creates| Ingress["Ingress"]
    SparkAppCtrl -->|creates| PDB["PodDisruptionBudgets"]

    SparkConnectCtrl -->|creates| ConnectCM["ConfigMaps"]
    SparkConnectCtrl -->|creates| ConnectSvc["Services"]

    %% Styling
    style ModuleController fill:#4a90e2,stroke:#333,color:#fff
    style ControllerDeploy fill:#4a90e2,stroke:#333,color:#fff
    style WebhookDeploy fill:#4a90e2,stroke:#333,color:#fff
    style SparkAppCR fill:#f5a623,stroke:#333
    style ScheduledCR fill:#f5a623,stroke:#333
    style SparkConnectCR fill:#f5a623,stroke:#333
    style SparkOperatorCR fill:#f5a623,stroke:#333
    style MutatingWH fill:#e74c3c,stroke:#333,color:#fff
    style ValidatingWH fill:#e74c3c,stroke:#333,color:#fff
    style ConversionWH fill:#e74c3c,stroke:#333,color:#fff
    style User fill:#e8e8e8,stroke:#333
    style ODHOperator fill:#7ed321,stroke:#333
