graph TB
    subgraph "TrustyAI Explainability Service"
        direction TB
        subgraph "Data Ingestion"
            RESTConsumer["ConsumerEndpoint<br/>/consumer/kserve/v2<br/>POST 8080/TCP"]
            CloudEventConsumer["CloudEventConsumer<br/>Knative Funqy<br/>CloudEvents/HTTP"]
        end

        subgraph "Payload Reconciliation"
            MMReconciler["ModelMeshInference<br/>PayloadReconciler"]
            KSReconciler["KServeInference<br/>PayloadReconciler"]
        end

        subgraph "Metrics Endpoints"
            SPD["/metrics/group/fairness/spd<br/>Statistical Parity Difference"]
            DIR["/metrics/group/fairness/dir<br/>Disparate Impact Ratio"]
            Drift["/metrics/drift<br/>Drift Detection"]
            Identity["/metrics/identity<br/>Identity Metrics"]
        end

        subgraph "Service Endpoints"
            Health["/q/health/live<br/>/q/health/ready"]
            Metrics["/q/metrics<br/>Prometheus Scrape"]
            Info["/info<br/>Service Metadata"]
        end

        subgraph "Storage Layer"
            PVCStorage["PVC Storage<br/>/inputs"]
            DBStorage["Hibernate ORM<br/>MariaDB (optional)"]
        end

        RESTConsumer -->|reconciles| MMReconciler
        CloudEventConsumer -->|reconciles| KSReconciler
        MMReconciler -->|writes| PVCStorage
        MMReconciler -->|writes| DBStorage
        KSReconciler -->|writes| PVCStorage
        KSReconciler -->|writes| DBStorage
        SPD -->|reads| PVCStorage
        DIR -->|reads| PVCStorage
        Drift -->|reads| PVCStorage
        Identity -->|reads| PVCStorage
    end

    subgraph "Init Container"
        InitContainer["ose-cli Init Container<br/>Creates model-serving-config<br/>ConfigMap"]
    end

    ModelMesh["KServe/ModelMesh<br/>Model Servers"] -->|POST /consumer/kserve/v2| RESTConsumer
    KServe["KServe Inference Servers"] -->|CloudEvents<br/>inference.request/response| CloudEventConsumer
    Prometheus["Prometheus"] -->|scrapes /q/metrics| Metrics
    Client["External Client"] -->|via OpenShift Route<br/>port 80 → 8080| SPD
    Client -->|via OpenShift Route| DIR
    Client -->|via OpenShift Route| Drift
    Client -->|via OpenShift Route| Identity
    Client -->|via OpenShift Route| Info

    InitContainer -->|creates ConfigMap| ModelMesh

    style RESTConsumer fill:#4a90e2,color:#fff
    style CloudEventConsumer fill:#4a90e2,color:#fff
    style MMReconciler fill:#50a0d2,color:#fff
    style KSReconciler fill:#50a0d2,color:#fff
    style SPD fill:#7ed321,color:#fff
    style DIR fill:#7ed321,color:#fff
    style Drift fill:#7ed321,color:#fff
    style Identity fill:#7ed321,color:#fff
    style Health fill:#b8e986
    style Metrics fill:#b8e986
    style Info fill:#b8e986
    style PVCStorage fill:#f5a623,color:#fff
    style DBStorage fill:#f5a623,color:#fff
    style ModelMesh fill:#e8e8e8
    style KServe fill:#e8e8e8
    style Prometheus fill:#e8e8e8
    style Client fill:#f9f9f9
    style InitContainer fill:#d0d0d0
