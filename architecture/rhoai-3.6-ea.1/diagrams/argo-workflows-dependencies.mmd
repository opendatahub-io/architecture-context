graph LR
    ArgoWF["Argo Workflows<br/>Workflow Engine"]

    %% Internal RHOAI Dependencies
    ArgoWF -->|"deployed by"| DSPOperator["Data Science Pipelines<br/>Operator"]

    %% Kubernetes Platform Dependencies
    ArgoWF -->|"HTTPS+WSS/6443<br/>resource CRUD"| K8sAPI["Kubernetes API<br/>v0.32.2"]
    ArgoWF -->|"Pod management"| Pods["Pods<br/>(Step execution)"]
    ArgoWF -->|"memoization cache"| ConfigMaps["ConfigMaps"]
    ArgoWF -->|"SSO config"| Secrets["Secrets"]
    ArgoWF -->|"workflow protection"| PDBs["PodDisruptionBudgets"]
    ArgoWF -->|"authz verification"| SSAR["SelfSubjectAccessReview"]

    %% Authentication Dependencies
    ArgoWF -->|"SSO/OIDC"| OIDCProvider["OIDC Provider<br/>(coreos/go-oidc v3.9)"]
    ArgoWF -->|"OAuth2"| OAuth2["OAuth2<br/>(golang.org/x/oauth2)"]

    %% Runtime Dependencies
    ArgoWF -->|"gRPC transport"| gRPC["gRPC<br/>v1.71.1"]
    ArgoWF -->|"metrics"| Prometheus["Prometheus Client<br/>v1.21.1"]
    ArgoWF -->|"telemetry"| OTel["OpenTelemetry<br/>v1.34.0"]
    ArgoWF -->|"cron scheduling"| Cron["robfig/cron<br/>v3.0.1"]

    %% Storage Dependencies
    ArgoWF -.->|"artifact storage"| S3["S3 / MinIO<br/>(minio-go v7.0.89)"]
    ArgoWF -.->|"artifact storage"| GCS["Google Cloud Storage<br/>(cloud.google.com/go v1.50)"]
    ArgoWF -.->|"artifact storage"| AzBlob["Azure Blob Storage<br/>(azblob v1.3.2)"]
    ArgoWF -.->|"artifact storage"| AliOSS["Alibaba OSS<br/>(aliyun-oss-go-sdk v3.0.2)"]
    ArgoWF -.->|"artifact storage"| HDFS["HDFS<br/>(colinmarc/hdfs v2.4)"]

    %% Database (optional)
    ArgoWF -.->|"archive storage"| SQLite["SQLite<br/>(zombiezen.com/go/sqlite)"]
    ArgoWF -.->|"archive storage"| MySQL["MySQL<br/>(go-sql-driver v1.7.1)"]

    %% FIPS Crypto
    ArgoWF -->|"FIPS 140-3"| GoFIPS["Go Native FIPS<br/>GOFIPS140=v1.0.0"]

    %% Integration Points
    DSPOperator -->|"submits Workflow CRs"| ArgoWF
    ArgoEvents["Argo Events<br/>v1.9.6"] -->|"triggers workflows"| ArgoWF

