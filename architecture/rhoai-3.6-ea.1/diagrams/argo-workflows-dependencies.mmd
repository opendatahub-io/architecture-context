graph LR
    ArgoWF["Argo Workflows<br/>(workflow-controller +<br/>argo-server + argoexec)"]

    %% Core Runtime Dependencies
    ArgoWF -->|"resource ops<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>k8s.io/client-go v0.32.2"]
    ArgoWF -->|"CRD management"| K8sApimachinery["k8s.io/apimachinery<br/>v0.32.2"]
    ArgoWF -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>v1.71.1"]
    ArgoWF -->|"HTTP→gRPC proxy"| GRPCGateway["grpc-gateway<br/>v1.16.0"]

    %% Authentication/Authorization
    ArgoWF -->|"SSO/OIDC auth"| OIDC["coreos/go-oidc<br/>v3.9.0"]
    ArgoWF -->|"OAuth2 flows"| OAuth2["golang.org/x/oauth2<br/>v0.28.0"]

    %% Artifact Storage Backends
    ArgoWF -->|"S3 artifacts"| MinIO["minio-go<br/>v7.0.89"]
    ArgoWF -->|"GCS artifacts"| GCS["cloud.google.com/go/storage<br/>v1.50.0"]
    ArgoWF -->|"Azure artifacts"| AzBlob["azure-sdk/azblob<br/>v1.3.2"]
    ArgoWF -->|"Alibaba artifacts"| AliOSS["aliyun-oss-go-sdk<br/>v3.0.2"]
    ArgoWF -->|"HDFS artifacts"| HDFS["colinmarc/hdfs<br/>v2.4.0"]

    %% Observability
    ArgoWF -->|"metrics"| Prometheus["prometheus/client_golang<br/>v1.21.1"]
    ArgoWF -->|"tracing"| OTel["opentelemetry.io/otel<br/>v1.34.0"]

    %% Workflow Processing
    ArgoWF -->|"cron scheduling"| Cron["robfig/cron<br/>v3.0.1"]
    ArgoWF -->|"expression eval"| Expr["expr-lang/expr<br/>v1.17.7"]
    ArgoWF -->|"template engine"| Sprig["Masterminds/sprig<br/>v3.3.0"]
    ArgoWF -->|"JSON queries"| GoJQ["itchyny/gojq<br/>v0.12.17"]

    %% Event Integration
    ArgoWF -->|"event handling"| ArgoEvents["argoproj/argo-events<br/>v1.9.6"]

    %% Data Consumers (Internal RHOAI)
    DSP["Data Science Pipelines"] -->|"submits workflows"| ArgoWF

