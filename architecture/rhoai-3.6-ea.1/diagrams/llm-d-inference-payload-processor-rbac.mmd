graph TD
    subgraph "Service Account"
        SA["payload-processor<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole Binding"
        CRB["payload-processor-auth-reviewer-binding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole"
        CR["payload-processor-auth-reviewer"]
    end

    subgraph "API Resources"
        ConfigMaps["core (v1)<br/>ConfigMaps"]
    end

    subgraph "Permitted Operations"
        Get["get"]
        List["list"]
        Watch["watch"]
    end

    subgraph "Authentication Endpoints"
        ExtProcAuth["ExtProc gRPC (9004)<br/>Auth: None<br/>Transport: TLS (self-signed)"]
        HealthAuth["Health gRPC (9005)<br/>Auth: None<br/>Transport: Plaintext"]
        MetricsAuth["Metrics HTTP (9090)<br/>Auth: SA Bearer Token<br/>Enforcement: controller-runtime<br/>Delegates to K8s API"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"permits"| Get
    CR -->|"permits"| List
    CR -->|"permits"| Watch
    Get -->|"on"| ConfigMaps
    List -->|"on"| ConfigMaps
    Watch -->|"on"| ConfigMaps

    SA -.->|"identity for"| ExtProcAuth
    SA -.->|"identity for"| HealthAuth
    SA -.->|"authenticates"| MetricsAuth

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#b8d4f0,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Get fill:#d5e8d4,stroke:#82b366
    style List fill:#d5e8d4,stroke:#82b366
    style Watch fill:#d5e8d4,stroke:#82b366
    style ExtProcAuth fill:#fff2cc,stroke:#d6b656
    style HealthAuth fill:#fff2cc,stroke:#d6b656
    style MetricsAuth fill:#ffe6cc,stroke:#d79b00
