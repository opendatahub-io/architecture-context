graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_NotebookCtrl["notebook-controller-<br/>service-account"]
        SA_Manager["manager<br/>(system namespace)"]
        SA_CtrlMgr["controller-manager<br/>(system namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_NotebookCtrl["notebook-controller-<br/>role-binding<br/>(Cluster-scoped)"]
        CRB_Manager["manager-rolebinding<br/>(system namespace)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-<br/>rolebinding<br/>(system namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_NotebookCtrl["notebook-controller-role"]
        CR_Manager["manager-role"]
        CR_NotebooksEdit["notebooks-edit"]
        CR_NotebooksView["notebooks-view"]
    end

    subgraph Roles["Namespace Roles"]
        R_LeaderElection["leader-election-role<br/>(system namespace)"]
    end

    subgraph NotebookCtrlResources["notebook-controller-role Resources"]
        NR_Events["core/events<br/>create, get, list,<br/>patch, watch"]
        NR_Pods["core/pods<br/>delete, get,<br/>list, watch"]
        NR_Services["core/services<br/>*"]
        NR_StatefulSets["apps/statefulsets<br/>*"]
        NR_Notebooks["kubeflow.org/notebooks<br/>notebooks/finalizers<br/>notebooks/status<br/>*"]
        NR_VirtualSvc["networking.istio.io/<br/>virtualservices<br/>*"]
    end

    subgraph ManagerResources["manager-role Resources"]
        MR_Core["core/configmaps, secrets,<br/>serviceaccounts, services<br/>create, get, list,<br/>patch, update, watch"]
        MR_Auth["authentication.k8s.io/<br/>tokenreviews<br/>authorization.k8s.io/<br/>subjectaccessreviews<br/>create"]
        MR_OpenShift["config.openshift.io/<br/>apiservers, proxies<br/>get, list, watch"]
        MR_DSPA["datasciencepipelinesapplications<br/>.opendatahub.io<br/>get, list, watch<br/>+ api: full CRUD"]
        MR_Gateway["gateway.networking.k8s.io/<br/>gateways: read<br/>httproutes, referencegrants:<br/>full CRUD"]
        MR_Notebooks_Mgr["kubeflow.org/notebooks<br/>get, list, patch,<br/>update, watch<br/>finalizers: patch, update<br/>status: get"]
        MR_NetPol["networking.k8s.io/<br/>networkpolicies<br/>full CRUD + finalizers"]
        MR_OAuth["oauth.openshift.io/<br/>oauthclients<br/>delete, get, list,<br/>patch, update, watch"]
        MR_RBAC["rbac.authorization.k8s.io/<br/>clusterroles: get<br/>clusterrolebindings,<br/>rolebindings, roles:<br/>full CRUD"]
        MR_Routes["route.openshift.io/<br/>routes<br/>get, list, watch"]
        MR_ImageStreams["image.openshift.io/<br/>imagestreams<br/>get, list, watch"]
    end

    subgraph LeaderElectionResources["leader-election-role Resources"]
        LR_ConfigMaps["core/configmaps<br/>full CRUD"]
        LR_Leases["coordination.k8s.io/<br/>leases<br/>full CRUD"]
        LR_Events["core/events<br/>create, patch"]
    end

    %% Service Account to Binding connections
    SA_NotebookCtrl -->|"bound via"| CRB_NotebookCtrl
    SA_Manager -->|"bound via"| CRB_Manager
    SA_CtrlMgr -->|"bound via"| RB_Leader

    %% Binding to Role connections
    CRB_NotebookCtrl -->|"grants"| CR_NotebookCtrl
    CRB_Manager -->|"grants"| CR_Manager
    RB_Leader -->|"grants"| R_LeaderElection

    %% Role to Resource connections
    CR_NotebookCtrl -->|"permits"| NR_Events
    CR_NotebookCtrl -->|"permits"| NR_Pods
    CR_NotebookCtrl -->|"permits"| NR_Services
    CR_NotebookCtrl -->|"permits"| NR_StatefulSets
    CR_NotebookCtrl -->|"permits"| NR_Notebooks
    CR_NotebookCtrl -->|"permits"| NR_VirtualSvc

    CR_Manager -->|"permits"| MR_Core
    CR_Manager -->|"permits"| MR_Auth
    CR_Manager -->|"permits"| MR_OpenShift
    CR_Manager -->|"permits"| MR_DSPA
    CR_Manager -->|"permits"| MR_Gateway
    CR_Manager -->|"permits"| MR_Notebooks_Mgr
    CR_Manager -->|"permits"| MR_NetPol
    CR_Manager -->|"permits"| MR_OAuth
    CR_Manager -->|"permits"| MR_RBAC
    CR_Manager -->|"permits"| MR_Routes
    CR_Manager -->|"permits"| MR_ImageStreams

    R_LeaderElection -->|"permits"| LR_ConfigMaps
    R_LeaderElection -->|"permits"| LR_Leases
    R_LeaderElection -->|"permits"| LR_Events

