graph TD
    subgraph "Authentication Mechanisms (4 Patterns)"
        OAuth["OAuth2/OIDC<br/>kube-auth-proxy on port 4180<br/>Session management + TokenReview<br/>Used by: odh-dashboard"]
        KuadrantAuthN["Kuadrant/Authorino AuthPolicy<br/>API key (sk-oai-*) + TokenReview<br/>+ Optional OIDC JWT<br/>+ OPA Rego authorization<br/>Used by: MaaS, odh-model-ctrl, ai-gw-op"]
        KRBP["kube-rbac-proxy Sidecar<br/>TLS-terminating proxy<br/>TokenReview + SubjectAccessReview<br/>Used by: 6 components"]
        AppAuth["Application-level Auth<br/>Direct K8s TokenReview + SAR<br/>In-code validation<br/>Used by: dashboard BFF, MaaS, odh-model-ctrl"]
    end

    subgraph "Gateway Authentication Chains"
        DashChain["Dashboard Chain<br/>EnvoyFilter ext_authz<br/>-> kube-auth-proxy OIDC<br/>-> kube-rbac-proxy sidecar<br/>-> BFF TokenReview+SAR<br/>(3-layer deep)"]
        MaaSChain["MaaS Chain<br/>Kuadrant AuthPolicy<br/>-> API key callback to maas-api<br/>-> OPA Rego authorization<br/>-> TenantAuthMiddleware SAR<br/>(2-layer deep)"]
        RegChain["Model Registry Chain<br/>OpenShift Route TLS termination<br/>-> kube-rbac-proxy sidecar<br/>-> SubjectAccessReview<br/>(2-layer deep)"]
        MonChain["Monitoring Chain<br/>OpenShift Route TLS<br/>-> kube-rbac-proxy sidecar<br/>-> cluster-monitoring-view<br/>(2-layer deep)"]
    end

    subgraph "Key ServiceAccounts (Operators)"
        SA_Rhods["rhods-operator-controller-manager<br/>Namespace: redhat-ods-operator<br/>3 service controllers"]
        SA_KServe["kserve-controller-manager<br/>Namespace: kserve<br/>InferenceService reconciler"]
        SA_LLMISVC["kserve-llmisvc-controller<br/>Namespace: kserve<br/>13 resource types"]
        SA_ODHModel["odh-model-controller<br/>Namespace: redhat-ods-applications<br/>10 reconcilers"]
        SA_Dashboard["odh-dashboard<br/>Namespace: redhat-ods-applications<br/>BFF sidecars"]
        SA_MaaS["maas-api / maas-controller<br/>Namespace: models-as-a-service<br/>OpenAI-compatible API"]
        SA_AIGateway["ai-gateway-operator<br/>Namespace: redhat-ods-applications<br/>128 RBAC entries, 10+ API groups"]
    end

    subgraph "Admission Webhooks (210 Total, All Fail Policy)"
        WH_Kueue["kueue-operator<br/>34 mutating + 36 validating<br/>= 70 webhooks"]
        WH_KServe["kserve<br/>4 mutating + 11 validating + 1 conv<br/>= 16 webhooks"]
        WH_ODHModel["odh-model-controller<br/>10 mutating + 6 validating<br/>= 16 webhooks"]
        WH_Spark["spark-operator<br/>8 mutating + 6 validating + 1 conv<br/>= 15 webhooks"]
        WH_Rhods["rhods-operator<br/>3 mutating + 6 validating + 1 conv<br/>= 10 webhooks"]
        WH_Other["13 other components<br/>83 webhooks combined<br/>All Fail policy"]
    end

    subgraph "Cross-Component Webhook Targets"
        XWH1["rhods-operator -> prometheus-operator<br/>PodMonitor label injection (mutating)"]
        XWH2["rhods-operator -> workbenches-operator<br/>HardwareProfile validation"]
        XWH3["odh-model-controller -> kserve<br/>InferenceService platform mutations"]
        XWH4["kserve -> all serving pods<br/>Sidecar injection (storage init + agent)"]
        XWH5["workbenches-operator -> kubeflow<br/>HardwareProfile + connection injection"]
    end

    subgraph "Container Security Patterns"
        FIPS["FIPS-compliant Build<br/>CGO_ENABLED=1<br/>GOEXPERIMENT=strictfipsruntime<br/>System OpenSSL via UBI 9<br/>20+ Go components"]
        UBI["UBI 9 Base Images<br/>All shipped Go components<br/>FIPS-validated OpenSSL<br/>Security updates channel"]
        TLSProfile["Platform TLS Profile Alignment<br/>Reads OpenShift APIServer profile<br/>Fallback: TLS 1.2 + Mozilla Intermediate<br/>6 components"]
        NonRoot["Non-root Execution<br/>UID 1001 (typical)<br/>MLServer, KServe Python servers,<br/>data-science-pipelines"]
    end

    subgraph "TLS Configuration"
        TLS_Webhook["Webhook Endpoints<br/>service-CA provisioned certs<br/>11 components with webhook TLS"]
        TLS_CertMgr["cert-manager Automated Certs<br/>kserve, kuberay, kueue,<br/>spark-operator, workbenches,<br/>llm-d-batch-gateway, openshell"]
        TLS_KRBP["kube-rbac-proxy TLS<br/>TLS-terminating sidecar<br/>Server cert on proxy port<br/>6 components"]
        TLS_mTLS["mTLS STRICT<br/>llm-d ModelExpress gRPC<br/>Conditional on Istio presence"]
    end

    subgraph "Platform-wide Security Policies"
        GWPolicy["Gateway Security<br/>EnvoyFilter ext_authz (conditional)<br/>Kuadrant AuthPolicy (MaaS)<br/>TokenRateLimitPolicy"]
        RBACScope["RBAC Scoping<br/>1658 entries across all components<br/>Dedicated SA per operator<br/>Namespace-scoped where possible"]
        WebhookPolicy["Webhook Policy<br/>All 210 webhooks use Fail policy<br/>fail-closed admission control"]
    end

    %% Auth mechanism to gateway chain relationships
    OAuth -->|"powers"| DashChain
    KuadrantAuthN -->|"powers"| MaaSChain
    KRBP -->|"powers"| RegChain
    KRBP -->|"powers"| MonChain
    AppAuth -->|"in-code"| DashChain
    AppAuth -->|"in-code"| MaaSChain

    %% ServiceAccount to auth relationships
    SA_Dashboard -->|"uses"| OAuth
    SA_Dashboard -->|"uses"| KRBP
    SA_MaaS -->|"uses"| KuadrantAuthN
    SA_ODHModel -->|"uses"| KRBP
    SA_ODHModel -->|"uses"| KuadrantAuthN
    SA_KServe -->|"uses"| KRBP
    SA_AIGateway -->|"uses"| KuadrantAuthN

    %% TLS relationships
    TLS_Webhook -->|"certs for"| WH_Rhods
    TLS_Webhook -->|"certs for"| WH_KServe
    TLS_Webhook -->|"certs for"| WH_ODHModel
    TLS_CertMgr -->|"automates"| SA_KServe
    TLS_mTLS -->|"enforces"| SA_LLMISVC

    %% Container security applies to all
    FIPS -->|"build flag"| SA_Rhods
    FIPS -->|"build flag"| SA_KServe
    FIPS -->|"build flag"| SA_MaaS
    FIPS -->|"build flag"| SA_ODHModel
    FIPS -->|"build flag"| SA_Dashboard
    UBI -->|"base image"| FIPS

