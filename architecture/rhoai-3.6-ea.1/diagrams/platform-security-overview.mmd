graph TD
    subgraph AuthMechanisms["Authentication Mechanisms"]
        AuthSA[ServiceAccount Tokens<br/>TokenReview via K8s API<br/>21+ components]
        AuthOAuth[OAuth2/OIDC Reverse Proxy<br/>kube-auth-proxy<br/>Cookie session + x-forwarded-access-token]
        AuthKuadrant[Kuadrant AuthPolicy<br/>API key, TokenReview, OIDC JWT<br/>models-as-a-service, ai-gateway-operator]
        AuthKRBP[kube-rbac-proxy Sidecar<br/>SubjectAccessReview<br/>kserve, model-registry, trustyai]
        AuthBearer[OAuth2/OIDC Bearer Direct<br/>odh-cli, ai-gateway-payload-processing]
    end

    subgraph WebhookSecurity["Admission Webhook Security (30+ Webhooks)"]
        WH_KServe[kserve Webhooks<br/>6M + 16V + 1C = 23 total<br/>Fail policy]
        WH_ODMC[odh-model-controller<br/>5M + 3V = 8 total<br/>Fail policy<br/>CROSS-COMPONENT: intercepts<br/>kserve CRDs + core Pods]
        WH_Rhods[rhods-operator<br/>3M + 6V + 1C = 10 total<br/>Fail policy]
        WH_KubeRay[kuberay<br/>2M + 6V = 8 total<br/>Fail policy]
        WH_MaaS[models-as-a-service<br/>4V, Fail policy]
        WH_Other[12 other components<br/>with webhooks<br/>All Fail policy]
    end

    subgraph CrossComponentRisk["Cross-Component Webhook Risks"]
        Risk_Pod[Pod Mutation Conflict<br/>Both kserve AND odh-model-controller<br/>register pod-mutating webhooks<br/>Order: alphabetical by name]
        Risk_ISVC[InferenceService Dual Control<br/>kserve validates/defaults<br/>odh-model-controller mutates<br/>with platform concerns]
        Risk_Cascade[Cascade Failure<br/>All Fail policy means<br/>webhook server down =<br/>blocked API operations]
    end

    subgraph GatewayAuth["Gateway Authentication Layers"]
        GW_MaaS[MaaS Gateway Layer<br/>Kuadrant AuthPolicy<br/>API key + TokenReview + OIDC JWT<br/>Status: candidate]
        GW_KServe[data-science-gateway Layer<br/>Candidate: EnvoyFilter ext_authz<br/>-> kube-auth-proxy<br/>Status: unverified]
        GW_Route[OpenShift Route Layer<br/>TLS termination at router<br/>kube-rbac-proxy at pod<br/>Status: observed]
    end

    subgraph FIPS["FIPS 140 Compliance"]
        FIPS_Compliant[FIPS Compliant<br/>GOEXPERIMENT=strictfipsruntime<br/>+ CGO_ENABLED=1<br/>16 Go operators]
        FIPS_Alt[FIPS Alternative<br/>GOFIPS140=v1.0.0<br/>-tags no_openssl<br/>data-science-pipelines-operator]
        FIPS_Gap[NO FIPS Signals<br/>llm-d-router EPP<br/>vLLM images (Ubuntu/CUDA/ROCm)<br/>NeMo-Guardrails<br/>guardrails-detectors]
    end

    subgraph ContainerSec["Container Security"]
        CS_UBI[UBI Base Images<br/>16+ components<br/>Red Hat Universal Base Image]
        CS_NonRoot[Non-Root Execution<br/>Most components<br/>USER directive or SecurityContext]
        CS_TLS12[TLS 1.2+ Enforcement<br/>7 components<br/>ECDHE+AES-GCM ciphers<br/>NIST curves P-256/P-384]
        CS_TLSProfile[OpenShift TLS Profile Watch<br/>Watches APIServer TLS<br/>security profile; propagates<br/>changes via pod restarts]
    end

    subgraph KeyServiceAccounts["Key ServiceAccounts"]
        SA_Rhods[rhods-operator<br/>NS: redhat-ods-operator<br/>Cluster-wide lifecycle mgmt]
        SA_KServe[kserve-controller-manager<br/>NS: redhat-ods-applications<br/>13 CRDs + Gateway API + Istio]
        SA_AIGw[ai-gateway-operator<br/>NS: redhat-ods-applications<br/>57 RBAC rules]
        SA_ODMC[odh-model-controller<br/>NS: redhat-ods-applications<br/>Cross-component webhook intercept]
        SA_MaaS[maas-api<br/>NS: redhat-ods-applications<br/>Kuadrant + Gateway API + 8 CRDs]
        SA_Dashboard[odh-dashboard<br/>NS: redhat-ods-applications<br/>10+ BFF sidecars]
    end

    subgraph RBAC["RBAC Scope (Most Privileged)"]
        RBAC_AIGw[ai-gateway-operator<br/>57 rules: Gateway API,<br/>cert-manager, Kuadrant,<br/>Istio, MaaS, llm-d,<br/>KServe, OpenTelemetry]
        RBAC_Rhods[rhods-operator<br/>19 CRDs: DataScienceCluster,<br/>DSCInitialization, HardwareProfile,<br/>per-component lifecycle CRDs]
        RBAC_KServe[kserve-controller-manager<br/>13 CRDs: InferenceService,<br/>LLMInferenceService, InferenceGraph,<br/>LocalModelCache, ServingRuntime,<br/>+ Gateway API + Istio resources]
        RBAC_ODMC[odh-model-controller<br/>Watches: kserve InferenceService,<br/>LLMInferenceService, InferenceGraph,<br/>NIM Account, core Pods]
    end

    subgraph TLSConfig["TLS Configuration"]
        TLS_Webhook[Webhook Servers<br/>9443/TCP Server TLS<br/>cert-manager or self-signed<br/>16 components]
        TLS_Metrics[Metrics Endpoints<br/>8443/TCP Server TLS<br/>kube-rbac-proxy sidecar<br/>kserve, model-registry, trustyai]
        TLS_Internal[Internal Services<br/>8080/TCP HTTP<br/>mTLS conditional on Istio]
        TLS_Ingress[Ingress TLS<br/>443/TCP<br/>Router or Gateway termination]
        TLS_Egress[Egress TLS Origination<br/>443/TCP<br/>Istio DestinationRule<br/>ai-gateway-payload-processing<br/>to external LLM providers]
    end

    %% ServiceAccount to RBAC
    SA_Rhods -->|bound to| RBAC_Rhods
    SA_KServe -->|bound to| RBAC_KServe
    SA_AIGw -->|bound to| RBAC_AIGw
    SA_ODMC -->|bound to| RBAC_ODMC

    %% Auth mechanism usage
    AuthSA -->|used by| SA_Rhods
    AuthSA -->|used by| SA_KServe
    AuthSA -->|used by| SA_AIGw
    AuthSA -->|used by| SA_ODMC
    AuthSA -->|used by| SA_MaaS
    AuthSA -->|used by| SA_Dashboard
    AuthOAuth -->|used by| SA_Dashboard
    AuthKuadrant -->|used by| SA_MaaS
    AuthKuadrant -->|used by| SA_AIGw
    AuthKRBP -->|used by| SA_KServe

    %% Gateway auth layers
    GW_MaaS -->|enforced by| AuthKuadrant
    GW_KServe -->|candidate| AuthOAuth
    GW_Route -->|enforced by| AuthKRBP

    %% Webhook risks
    WH_KServe -->|pod mutation| Risk_Pod
    WH_ODMC -->|pod mutation| Risk_Pod
    WH_KServe -->|InferenceService| Risk_ISVC
    WH_ODMC -->|InferenceService| Risk_ISVC
    WH_KServe -->|Fail policy| Risk_Cascade
    WH_ODMC -->|Fail policy| Risk_Cascade
    WH_Rhods -->|Fail policy| Risk_Cascade

    %% FIPS boundary
    FIPS_Gap -.->|compliance boundary| FIPS_Compliant

    %% TLS to container security
    CS_TLS12 -->|cipher config| TLS_Webhook
    CS_TLS12 -->|cipher config| TLS_Metrics
    CS_TLSProfile -->|profile watch| CS_TLS12

