graph TB
    subgraph ODH_MC["odh-model-controller Deployment"]
        direction TB
        Manager["Manager (controller-runtime)<br/>Port 9443 (webhooks)<br/>Port 8080 (metrics)<br/>Port 8081 (health)"]

        subgraph Controllers["Reconcilers"]
            ISVC_C["InferenceService<br/>Controller"]
            LLMISVC_C["LLMInferenceService<br/>Controller"]
            IG_C["InferenceGraph<br/>Controller"]
            GW_C["Gateway<br/>Controller"]
            SR_C["ServingRuntime<br/>Controller"]
            Account_C["Account<br/>Controller"]
            CM_C["ConfigMap<br/>Controller"]
            Secret_C["Secret<br/>Controller"]
            Pod_C["Pod<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks"]
            MW1["Mutate Pod"]
            MW2["Mutate InferenceService"]
            MW3["Mutate InferenceGraph"]
            MW4["Mutate LLMInferenceService<br/>v1alpha1 + v1alpha2"]
            VW1["Validate Account"]
            VW2["Validate InferenceGraph"]
            VW3["Validate InferenceService"]
        end

        Manager --> Controllers
        Manager --> Webhooks
    end

    subgraph MSA["model-serving-api Deployment"]
        direction TB
        APIServer["REST API Server<br/>Port 8443 (TLS)<br/>Port 8080 (metrics)"]
        GW_Discover["Gateway Discovery<br/>/api/v1/gateways"]
        Samples["LLM-D Samples<br/>/api/v1/samples/llm-d"]
        APIServer --> GW_Discover
        APIServer --> Samples
    end

    %% CRDs watched/managed
    ISVC_CR["InferenceService CR"]
    LLMISVC_CR["LLMInferenceService CR"]
    IG_CR["InferenceGraph CR"]
    GW_CR["Gateway CR"]
    SR_CR["ServingRuntime CR"]
    Account_CR["NIM Account CR"]

    %% Owned resources
    Routes["OpenShift Routes"]
    NetworkPolicies["NetworkPolicies"]
    AuthPolicies["Kuadrant AuthPolicies"]
    EnvoyFilters["Istio EnvoyFilters"]
    PodMonitors["PodMonitors"]
    ServiceMonitors["ServiceMonitors"]

    %% Platform CRDs
    DSC["DataScienceCluster CR"]
    DSCI["DSCInitialization CR"]
    HP["HardwareProfile CR"]

    %% Connections - Controllers to CRDs
    ISVC_CR -->|"watched by"| ISVC_C
    LLMISVC_CR -->|"watched by"| LLMISVC_C
    IG_CR -->|"watched by"| IG_C
    GW_CR -->|"watched by"| GW_C
    SR_CR -->|"watched by"| SR_C
    Account_CR -->|"watched by"| Account_C

    %% Controllers to owned resources
    ISVC_C -->|creates| Routes
    ISVC_C -->|creates| NetworkPolicies
    ISVC_C -->|creates| PodMonitors
    ISVC_C -->|creates| ServiceMonitors
    GW_C -->|creates| AuthPolicies
    GW_C -->|creates| EnvoyFilters

    %% Platform integrations
    DSC -.->|"read by"| ISVC_C
    DSCI -.->|"read by"| ISVC_C
    HP -.->|"read by"| ISVC_C

    %% model-serving-api
    GW_Discover -->|"queries"| GW_CR

    %% External
    K8sAPI["Kubernetes API<br/>6443/HTTPS"]
    Manager -->|"TLS 1.2+"| K8sAPI
    APIServer -->|"TLS 1.2+"| K8sAPI

    %% Styling
    style ODH_MC fill:#4a90e2,stroke:#333,color:#fff
    style MSA fill:#4a90e2,stroke:#333,color:#fff
    style Controllers fill:#5b9bd5,stroke:#333,color:#fff
    style Webhooks fill:#5b9bd5,stroke:#333,color:#fff
    style ISVC_CR fill:#f5a623,stroke:#333
    style LLMISVC_CR fill:#f5a623,stroke:#333
    style IG_CR fill:#f5a623,stroke:#333
    style GW_CR fill:#f5a623,stroke:#333
    style SR_CR fill:#f5a623,stroke:#333
    style Account_CR fill:#f5a623,stroke:#333
    style DSC fill:#d4edda,stroke:#333
    style DSCI fill:#d4edda,stroke:#333
    style HP fill:#d4edda,stroke:#333
    style Routes fill:#7ed321,stroke:#333
    style NetworkPolicies fill:#7ed321,stroke:#333
    style AuthPolicies fill:#7ed321,stroke:#333
    style EnvoyFilters fill:#7ed321,stroke:#333
    style PodMonitors fill:#7ed321,stroke:#333
    style ServiceMonitors fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
