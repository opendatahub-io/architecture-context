graph TB
    subgraph "KServe AutoGluon Server Component"
        direction TB

        subgraph OperatorPlane["Control Plane (Go Operator)"]
            Manager["KServe Controller Manager<br/>(cmd/manager)"]
            LLMCtrl["LLMInferenceService Controller<br/>(cmd/llmisvc)"]
            LocalModelCtrl["LocalModel Controller<br/>(cmd/localmodel)"]
            LocalModelNodeCtrl["LocalModelNode Controller<br/>(cmd/localmodelnode)"]
            Webhook["Webhook Server<br/>(Mutating + Validating)"]
            RBACProxy["kube-rbac-proxy<br/>(TLS termination)"]
        end

        subgraph Controllers["Reconcilers"]
            ISReconciler["InferenceService<br/>Reconciler"]
            IGReconciler["InferenceGraph<br/>Reconciler"]
            TMReconciler["TrainedModel<br/>Reconciler"]
            LLMReconciler["LLMInferenceService<br/>Reconciler"]
            LMCReconciler["LocalModelCache<br/>Reconciler"]
            LMNReconciler["LocalModelNode<br/>Reconciler"]
        end

        subgraph ModelServers["Model Serving (Python)"]
            AutoGluon["AutoGluon Server<br/>(TabularPredictor +<br/>TimeSeriesPredictor)"]
            KServeSDK["KServe Python SDK<br/>(FastAPI/uvicorn)"]
            V2Protocol["V2 Inference Protocol<br/>(HTTP + gRPC)"]
        end
    end

    %% CRDs
    ISCR["InferenceService CR"]
    IGCR["InferenceGraph CR"]
    LLMCR["LLMInferenceService CR"]
    LMCCR["LocalModelCache CR"]
    CSRCR["ClusterServingRuntime CR"]
    TMCR["TrainedModel CR"]

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>(6443/TCP)"]
    Istio["Istio / Service Mesh"]
    Knative["Knative Serving"]
    GatewayAPI["Gateway API"]
    KEDA["KEDA"]
    ObjStorage["Object Storage<br/>(S3 / Azure / GCS)"]
    Prometheus["Prometheus"]

    %% CRD relationships
    ISCR -->|watched by| ISReconciler
    IGCR -->|watched by| IGReconciler
    LLMCR -->|watched by| LLMReconciler
    LMCCR -->|watched by| LMCReconciler
    CSRCR -->|watched by| ISReconciler
    TMCR -->|watched by| TMReconciler

    %% Manager to reconcilers
    Manager --> ISReconciler
    Manager --> IGReconciler
    Manager --> TMReconciler
    LLMCtrl --> LLMReconciler
    LocalModelCtrl --> LMCReconciler
    LocalModelNodeCtrl --> LMNReconciler

    %% Reconciler outputs
    ISReconciler -->|creates| Knative
    ISReconciler -->|creates| Istio
    ISReconciler -->|creates| GatewayAPI
    LLMReconciler -->|creates| GatewayAPI
    LLMReconciler -->|creates| KEDA
    LMNReconciler -->|creates Jobs| ObjStorage

    %% Model server flow
    AutoGluon --> KServeSDK
    KServeSDK --> V2Protocol
    AutoGluon -->|loads models| ObjStorage

    %% Webhook
    Webhook -->|validates/mutates| ISCR
    Webhook -->|validates/mutates| LLMCR
    Webhook -->|validates| IGCR
    Webhook -->|validates| CSRCR

    %% Infrastructure
    Manager -->|API calls| K8sAPI
    RBACProxy -->|proxies :8443| Prometheus

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style LLMCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LocalModelCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LocalModelNodeCtrl fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style RBACProxy fill:#e8544e,stroke:#333,color:#fff
    style AutoGluon fill:#7ed321,stroke:#333,color:#fff
    style KServeSDK fill:#7ed321,stroke:#333,color:#fff
    style V2Protocol fill:#7ed321,stroke:#333,color:#fff
    style ISCR fill:#f5a623,stroke:#333,color:#fff
    style IGCR fill:#f5a623,stroke:#333,color:#fff
    style LLMCR fill:#f5a623,stroke:#333,color:#fff
    style LMCCR fill:#f5a623,stroke:#333,color:#fff
    style CSRCR fill:#f5a623,stroke:#333,color:#fff
    style TMCR fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style Knative fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style KEDA fill:#e8e8e8,stroke:#333
    style ObjStorage fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
