graph TB
    subgraph "rhoai-mcp Server"
        direction TB
        FastMCP["FastMCP Server<br/>(Starlette/uvicorn)"]
        OIDCMiddleware["OIDC Auth Middleware<br/>(ASGI)"]
        PluginManager["Plugin Manager<br/>(pluggy)"]

        subgraph "Plugins"
            direction LR
            WorkbenchPlugin["Workbench Plugin<br/>(Kubeflow Notebooks)"]
            ServingPlugin["Model Serving Plugin<br/>(KServe InferenceServices)"]
            TrainingPlugin["Training Plugin<br/>(TrainJobs)"]
            PipelinePlugin["Pipeline Plugin<br/>(DSP Applications)"]
            ClusterPlugin["Cluster Mgmt Plugin<br/>(Nodes, PVs, Storage)"]
        end

        OIDCMiddleware -->|validates tokens| FastMCP
        FastMCP -->|delegates| PluginManager
        PluginManager -->|registers tools| WorkbenchPlugin
        PluginManager -->|registers tools| ServingPlugin
        PluginManager -->|registers tools| TrainingPlugin
        PluginManager -->|registers tools| PipelinePlugin
        PluginManager -->|registers tools| ClusterPlugin
    end

    AIAgent["AI Agent<br/>(MCP Client)"] -->|MCP Protocol<br/>stdio / SSE / streamable-http| OIDCMiddleware

    subgraph "Transports"
        direction LR
        STDIO["stdio<br/>(Claude Desktop)"]
        SSE["SSE<br/>(Port 8000)"]
        StreamableHTTP["streamable-http<br/>(Port 8000)"]
    end

    AIAgent -.->|transport| STDIO
    AIAgent -.->|transport| SSE
    AIAgent -.->|transport| StreamableHTTP

    subgraph "Kubernetes API Server"
        K8sAPI["Kubernetes API<br/>Port 6443/HTTPS"]
    end

    WorkbenchPlugin -->|CRUD| NotebookCR["Notebook CR<br/>(kubeflow.org)"]
    ServingPlugin -->|Watch/CRUD| InferenceServiceCR["InferenceService CR<br/>(serving.kserve.io)"]
    ServingPlugin -->|CRUD| ServingRuntimeCR["ServingRuntime CR<br/>(serving.kserve.io)"]
    TrainingPlugin -->|CRUD| TrainJobCR["TrainJob CR<br/>(trainer.kubeflow.org)"]
    PipelinePlugin -->|CRUD| DSPA_CR["DSPA CR<br/>(datasciencepipelinesapplications<br/>.opendatahub.io)"]
    ClusterPlugin -->|list/watch| CoreResources["Core Resources<br/>(pods, nodes, PVs,<br/>namespaces, secrets)"]

    NotebookCR -->|via| K8sAPI
    InferenceServiceCR -->|via| K8sAPI
    ServingRuntimeCR -->|via| K8sAPI
    TrainJobCR -->|via| K8sAPI
    DSPA_CR -->|via| K8sAPI
    CoreResources -->|via| K8sAPI

