graph TB
    subgraph "rhoai-mcp Server"
        direction TB
        Server["RHOAIServer<br/>(FastMCP Runtime)"]
        PluginMgr["Plugin Manager<br/>(pluggy)"]
        AuthMW["OIDCAuthMiddleware<br/>(ASGI)"]

        subgraph "Plugins"
            direction LR
            NotebooksPlugin["Notebooks Plugin"]
            ServingPlugin["Model Serving Plugin"]
            TrainingPlugin["Training Plugin"]
            PipelinesPlugin["Pipelines Plugin"]
            RegistryPlugin["Model Registry Plugin"]
        end

        Server -->|loads| PluginMgr
        PluginMgr -->|registers tools| NotebooksPlugin
        PluginMgr -->|registers tools| ServingPlugin
        PluginMgr -->|registers tools| TrainingPlugin
        PluginMgr -->|registers tools| PipelinesPlugin
        PluginMgr -->|registers tools| RegistryPlugin
        AuthMW -->|validates tokens| Server
    end

    AIAgent["AI Agent Client"] -->|MCP over SSE/HTTP<br/>port 8000| AuthMW
    K8sProbe["Kubernetes Probes"] -->|GET /health| Server

    subgraph "Kubernetes API Server"
        K8sAPI["K8s API<br/>6443/TCP"]
    end

    subgraph "RHOAI CRDs"
        direction LR
        NotebookCR["Notebook CR<br/>(kubeflow.org)"]
        InferenceServiceCR["InferenceService CR<br/>(serving.kserve.io)"]
        ServingRuntimeCR["ServingRuntime CR<br/>(serving.kserve.io)"]
        TrainJobCR["TrainJob CR<br/>(trainer.kubeflow.org)"]
        DSPACR["DSPA CR<br/>(opendatahub.io)"]
    end

    NotebooksPlugin -->|CRUD| NotebookCR
    ServingPlugin -->|Watch/CRUD| InferenceServiceCR
    ServingPlugin -->|CRUD| ServingRuntimeCR
    TrainingPlugin -->|CRUD| TrainJobCR
    PipelinesPlugin -->|CRUD| DSPACR

    Server -->|Python client| K8sAPI
    K8sAPI -->|manages| NotebookCR
    K8sAPI -->|manages| InferenceServiceCR
    K8sAPI -->|manages| TrainJobCR
    K8sAPI -->|manages| DSPACR

    ModelReg["Model Registry<br/>HTTP :8080"]
    RegistryPlugin -->|HTTP client| ModelReg

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style PluginMgr fill:#4a90e2,stroke:#333,color:#fff
    style AuthMW fill:#e74c3c,stroke:#333,color:#fff
    style NotebooksPlugin fill:#7ed321,stroke:#333
    style ServingPlugin fill:#7ed321,stroke:#333
    style TrainingPlugin fill:#7ed321,stroke:#333
    style PipelinesPlugin fill:#7ed321,stroke:#333
    style RegistryPlugin fill:#7ed321,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style InferenceServiceCR fill:#f5a623,stroke:#333
    style ServingRuntimeCR fill:#f5a623,stroke:#333
    style TrainJobCR fill:#f5a623,stroke:#333
    style DSPACR fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ModelReg fill:#e8e8e8,stroke:#333
    style AIAgent fill:#9b59b6,stroke:#333,color:#fff
    style K8sProbe fill:#9b59b6,stroke:#333,color:#fff
