graph TB
    subgraph OGXOperator["ogx-k8s-operator"]
        direction TB
        subgraph InnerTier["Inner Tier: Workload Reconciler"]
            OGXServerController["OGXServer Controller<br/>(OGXServerReconciler)"]
            ConfigMapReconciler["ConfigMap Reconciler"]
            Webhook["Validating Webhook<br/>vogxserver.kb.io<br/>failurePolicy: Fail"]
        end

        subgraph OuterTier["Outer Tier: Platform Component Manager"]
            OGXModuleController["OGX Module Controller<br/>(ogx-module)"]
        end

        subgraph Utilities["Shared Utilities"]
            ConfigGen["configgen<br/>(static config generator)"]
            TLSConfig["TLS Configuration<br/>(OpenShift TLS Profile)"]
        end
    end

    %% CRDs
    OGXServerCR["OGXServer CR<br/>ogx.io/v1beta1<br/>Namespaced"]
    LlamaStackCR["LlamaStackDistribution CR<br/>llamastack.io/v1alpha1<br/>Namespaced"]
    OGXCR["OGX CR<br/>components.platform.opendatahub.io/v1alpha1<br/>Cluster"]

    %% Managed Resources
    subgraph ManagedResources["Managed Child Resources"]
        Deployment["Deployment"]
        Service["Service"]
        HPA["HorizontalPodAutoscaler"]
        PDB["PodDisruptionBudget"]
        NetworkPolicy["NetworkPolicy"]
        Ingress["Ingress"]
        PVC["PersistentVolumeClaim"]
        ConfigMap["ConfigMap"]
    end

    subgraph PlatformResources["Platform-Managed Resources"]
        ClusterRole["ClusterRoles"]
        ClusterRoleBinding["ClusterRoleBindings"]
        WebhookConfig["ValidatingWebhookConfiguration"]
        PlatformDeployment["Operator Deployment"]
    end

    subgraph Observability["Observability"]
        ServiceMonitor["ServiceMonitor"]
        PrometheusRule["PrometheusRule"]
    end

    %% User interaction
    User["User / Platform"] -->|creates/updates| OGXServerCR
    User -->|creates/updates| LlamaStackCR
    PlatformOperator["Platform Operator"] -->|creates| OGXCR

    %% Webhook validation
    OGXServerCR -->|CREATE/UPDATE intercepted by| Webhook
    Webhook -->|validates| OGXServerCR

    %% Inner tier reconciliation
    OGXServerCR -->|watched by| OGXServerController
    LlamaStackCR -->|watched by| OGXServerController
    OGXServerController -->|creates/manages| Deployment
    OGXServerController -->|creates/manages| Service
    OGXServerController -->|creates/manages| HPA
    OGXServerController -->|creates/manages| PDB
    OGXServerController -->|creates/manages| NetworkPolicy
    OGXServerController -->|creates/manages| Ingress
    OGXServerController -->|creates/manages| PVC
    OGXServerController -->|creates/manages| ConfigMap
    OGXServerController -->|creates/manages| ServiceMonitor
    OGXServerController -->|creates/manages| PrometheusRule

    ConfigMapReconciler -->|watches| ConfigMap

    %% Outer tier reconciliation
    OGXCR -->|watched by| OGXModuleController
    OGXModuleController -->|renders kustomize manifests| PlatformDeployment
    OGXModuleController -->|manages| ClusterRole
    OGXModuleController -->|manages| ClusterRoleBinding
    OGXModuleController -->|manages| WebhookConfig

    %% External dependency
    OGXServerController -->|calls| K8sAPI["Kubernetes API<br/>6443/TCP"]
    OGXModuleController -->|calls| K8sAPI

    %% Styling
    style OGXServerController fill:#4a90e2,color:#fff
    style OGXModuleController fill:#4a90e2,color:#fff
    style Webhook fill:#e74c3c,color:#fff
    style ConfigMapReconciler fill:#4a90e2,color:#fff
    style OGXServerCR fill:#f5a623,color:#fff
    style LlamaStackCR fill:#f5a623,color:#fff
    style OGXCR fill:#f5a623,color:#fff
    style ConfigGen fill:#95a5a6,color:#fff
    style TLSConfig fill:#95a5a6,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style User fill:#7ed321,color:#fff
    style PlatformOperator fill:#7ed321,color:#fff
