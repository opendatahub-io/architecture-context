graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["ogx-k8s-operator-<br/>controller-manager<br/>(Inner Tier)"]
        SA_Operator["operator<br/>(Outer Tier / ogx-module)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["ogx-k8s-operator-<br/>manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-<br/>proxy-rolebinding"]
        CRB_ManagerCluster["manager-cluster-<br/>rolebinding"]
        CRB_MetricsAuth["metrics-auth-<br/>rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_LeaderElection["ogx-k8s-operator-<br/>leader-election-rolebinding<br/>(ns: ogx-k8s-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["ogx-k8s-operator-<br/>manager-role"]
        CR_Proxy["ogx-k8s-operator-<br/>proxy-role"]
        CR_ManagerCluster["manager-cluster-role"]
        CR_MetricsAuth["metrics-auth-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_LeaderElection["ogx-k8s-operator-<br/>leader-election-role"]
    end

    %% Inner Tier Bindings
    SA_Manager -->|"bound via"| CRB_Manager
    SA_Manager -->|"bound via"| CRB_Proxy
    SA_Manager -->|"bound via"| RB_LeaderElection

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Proxy -->|"grants"| CR_Proxy
    RB_LeaderElection -->|"grants"| R_LeaderElection

    %% Outer Tier Bindings
    SA_Operator -->|"bound via"| CRB_ManagerCluster
    SA_Operator -->|"bound via"| CRB_MetricsAuth

    CRB_ManagerCluster -->|"grants"| CR_ManagerCluster
    CRB_MetricsAuth -->|"grants"| CR_MetricsAuth

    %% Inner Tier Resources
    subgraph ManagerResources["ogx-k8s-operator-manager-role Resources"]
        R_Core["core<br/>configmaps, pvcs, pods,<br/>secrets, serviceaccounts,<br/>services"]
        R_Apps["apps<br/>deployments, replicasets"]
        R_Autoscaling["autoscaling<br/>horizontalpodautoscalers"]
        R_Networking["networking.k8s.io<br/>ingresses, networkpolicies"]
        R_OGX["ogx.io<br/>ogxservers,<br/>ogxservers/finalizers,<br/>ogxservers/status"]
        R_Policy["policy<br/>poddisruptionbudgets"]
        R_Monitoring["monitoring.coreos.com<br/>prometheusrules,<br/>servicemonitors"]
        R_RBAC_Inner["rbac.authorization.k8s.io<br/>clusterroles,<br/>clusterrolebindings,<br/>rolebindings"]
        R_OpenShift["config.openshift.io<br/>apiservers"]
        R_SCC["security.openshift.io<br/>securitycontextconstraints"]
    end

    CR_Manager -->|"CRUD"| R_Core
    CR_Manager -->|"CRUD"| R_Apps
    CR_Manager -->|"CRUD"| R_Autoscaling
    CR_Manager -->|"CRUD"| R_Networking
    CR_Manager -->|"CRUD"| R_OGX
    CR_Manager -->|"CRUD"| R_Policy
    CR_Manager -->|"CRUD"| R_Monitoring
    CR_Manager -->|"read + delete"| R_RBAC_Inner
    CR_Manager -->|"read"| R_OpenShift
    CR_Manager -->|"use"| R_SCC

    %% Outer Tier Resources
    subgraph ManagerClusterResources["manager-cluster-role Resources"]
        RC_Core["core<br/>configmaps, pvcs, pods,<br/>secrets, serviceaccounts,<br/>services, events"]
        RC_Apps["apps<br/>deployments, replicasets"]
        RC_Admission["admissionregistration.k8s.io<br/>validatingwebhookconfigurations"]
        RC_APIExt["apiextensions.k8s.io<br/>customresourcedefinitions"]
        RC_Components["components.platform.<br/>opendatahub.io<br/>ogxs, ogxs/finalizers,<br/>ogxs/status"]
        RC_OGX["ogx.io<br/>ogxservers,<br/>ogxservers/finalizers,<br/>ogxservers/status"]
        RC_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings"]
    end

    CR_ManagerCluster -->|"CRUD"| RC_Core
    CR_ManagerCluster -->|"CRUD"| RC_Apps
    CR_ManagerCluster -->|"CRUD"| RC_Admission
    CR_ManagerCluster -->|"CRUD"| RC_APIExt
    CR_ManagerCluster -->|"CRUD"| RC_Components
    CR_ManagerCluster -->|"CRUD"| RC_OGX
    CR_ManagerCluster -->|"CRUD"| RC_RBAC

    %% Auth proxy resources
    subgraph ProxyResources["Proxy/Metrics Auth Resources"]
        R_TokenReview["authentication.k8s.io<br/>tokenreviews"]
        R_SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    CR_Proxy -->|"create"| R_TokenReview
    CR_Proxy -->|"create"| R_SAR
    CR_MetricsAuth -->|"create"| R_TokenReview
    CR_MetricsAuth -->|"create"| R_SAR

    %% Leader election resources
    subgraph LeaderElectionResources["Leader Election Resources"]
        R_LE_ConfigMaps["core<br/>configmaps"]
        R_LE_Leases["coordination.k8s.io<br/>leases"]
        R_LE_Events["core<br/>events"]
    end

    R_LeaderElection -->|"CRUD"| R_LE_ConfigMaps
    R_LeaderElection -->|"CRUD"| R_LE_Leases
    R_LeaderElection -->|"create, patch"| R_LE_Events

    %% Aggregate Roles
    subgraph AggregateRoles["Aggregate / User-Facing Roles"]
        CR_Viewer["ogx-k8s-operator-<br/>ogxserver-viewer-role<br/>(get, list, watch)"]
        CR_Editor["ogx-k8s-operator-<br/>ogxserver-editor-role<br/>(full CRUD)"]
        CR_CompAdmin["components-ogx-<br/>admin-role<br/>(* on ogxs)"]
        CR_CompEditor["components-ogx-<br/>editor-role<br/>(full CRUD on ogxs)"]
        CR_CompViewer["components-ogx-<br/>viewer-role<br/>(read on ogxs)"]
    end

    CR_Viewer -->|"read"| R_OGX
    CR_Editor -->|"CRUD"| R_OGX
    CR_CompAdmin -->|"all"| RC_Components
    CR_CompEditor -->|"CRUD"| RC_Components
    CR_CompViewer -->|"read"| RC_Components

    %% Styling
    style SA_Manager fill:#4a90e2,color:#fff
    style SA_Operator fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_ManagerCluster fill:#f5a623,color:#fff
    style CR_MetricsAuth fill:#f5a623,color:#fff
    style R_LeaderElection fill:#f5a623,color:#fff
    style CR_Viewer fill:#95a5a6,color:#fff
    style CR_Editor fill:#95a5a6,color:#fff
    style CR_CompAdmin fill:#95a5a6,color:#fff
    style CR_CompEditor fill:#95a5a6,color:#fff
    style CR_CompViewer fill:#95a5a6,color:#fff
    style R_OGX fill:#7ed321,color:#fff
    style RC_Components fill:#7ed321,color:#fff
    style RC_OGX fill:#7ed321,color:#fff
