graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["ogx-k8s-operator-<br/>controller-manager"]
        SA_Module["operator<br/>(ogx-module)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["ogx-k8s-operator-<br/>manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-<br/>proxy-rolebinding"]
        CRB_ModuleManager["manager-cluster-<br/>rolebinding"]
        CRB_Metrics["metrics-auth-<br/>rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_LeaderElection["ogx-k8s-operator-<br/>leader-election-rolebinding<br/>NS: ogx-k8s-operator-system"]
        RB_ModLeader["leader-election-<br/>rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["ogx-k8s-operator-<br/>manager-role"]
        CR_Proxy["ogx-k8s-operator-<br/>proxy-role"]
        CR_ModManager["manager-cluster-role"]
        CR_Metrics["metrics-auth-role"]
        CR_Viewer["ogxserver-viewer-role"]
        CR_Editor["ogxserver-editor-role"]
        CR_CompAdmin["components-ogx-<br/>admin-role"]
        CR_CompEditor["components-ogx-<br/>editor-role"]
        CR_CompViewer["components-ogx-<br/>viewer-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_LeaderElection["ogx-k8s-operator-<br/>leader-election-role"]
        R_ModLeader["leader-election-role"]
    end

    subgraph OGXResources["OGX Resources (ogx.io)"]
        OGXServers["ogxservers<br/>ogxservers/status<br/>ogxservers/finalizers"]
    end

    subgraph PlatformResources["Platform Resources (components.platform.opendatahub.io)"]
        OGXComp["ogxs<br/>ogxs/status<br/>ogxs/finalizers"]
    end

    subgraph K8sResources["Kubernetes Core Resources"]
        Deployments["apps/deployments"]
        Services["core/services"]
        ConfigMaps["core/configmaps"]
        Secrets["core/secrets"]
        PVCs["core/persistentvolumeclaims"]
        Pods["core/pods"]
        HPAs["autoscaling/HPAs"]
        PDBs["policy/PDBs"]
        NetPols["networking/networkpolicies"]
        Ingresses["networking/ingresses"]
        ReplicaSets["apps/replicasets"]
    end

    subgraph RBACResources["RBAC Resources"]
        ClusterRolesRes["clusterroles"]
        ClusterRoleBindingsRes["clusterrolebindings"]
        RolesRes["roles"]
        RoleBindingsRes["rolebindings"]
    end

    subgraph MonitoringResources["Monitoring Resources (monitoring.coreos.com)"]
        PromRules["prometheusrules"]
        SvcMonitors["servicemonitors"]
    end

    subgraph AdminResources["Admin Resources"]
        CRDs["customresourcedefinitions"]
        VWCs["validatingwebhookconfigurations"]
        APIServers["config.openshift.io/<br/>apiservers"]
        SCCs["security.openshift.io/<br/>securitycontextconstraints"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        LEConfigMaps["configmaps"]
        LELeases["coordination.k8s.io/leases"]
        LEEvents["events"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io/<br/>tokenreviews"]
        SAR["authorization.k8s.io/<br/>subjectaccessreviews"]
    end

    %% SA → CRB → CR bindings
    SA_Operator -->|"bound via"| CRB_Manager
    SA_Operator -->|"bound via"| CRB_Proxy
    SA_Module -->|"bound via"| CRB_ModuleManager
    SA_Module -->|"bound via"| CRB_Metrics

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Proxy -->|"grants"| CR_Proxy
    CRB_ModuleManager -->|"grants"| CR_ModManager
    CRB_Metrics -->|"grants"| CR_Metrics

    %% SA → RB → R bindings
    SA_Operator -->|"bound via"| RB_LeaderElection
    SA_Module -->|"bound via"| RB_ModLeader
    RB_LeaderElection -->|"grants"| R_LeaderElection
    RB_ModLeader -->|"grants"| R_ModLeader

    %% CR_Manager permissions
    CR_Manager -->|"CRUD"| OGXServers
    CR_Manager -->|"CRUD"| Deployments
    CR_Manager -->|"CRUD"| Services
    CR_Manager -->|"CRUD"| ConfigMaps
    CR_Manager -->|"read"| Secrets
    CR_Manager -->|"CRUD"| PVCs
    CR_Manager -->|"list"| Pods
    CR_Manager -->|"CRUD"| HPAs
    CR_Manager -->|"CRUD"| PDBs
    CR_Manager -->|"CRUD"| NetPols
    CR_Manager -->|"CRUD"| Ingresses
    CR_Manager -->|"read"| ReplicaSets
    CR_Manager -->|"CRUD"| PromRules
    CR_Manager -->|"CRUD"| SvcMonitors
    CR_Manager -->|"read"| APIServers
    CR_Manager -->|"use"| SCCs

    %% CR_ModManager permissions
    CR_ModManager -->|"CRUD"| OGXComp
    CR_ModManager -->|"CRUD"| CRDs
    CR_ModManager -->|"CRUD"| VWCs
    CR_ModManager -->|"CRUD"| RBACResources
    CR_ModManager -->|"CRUD"| OGXServers
    CR_ModManager -->|"CRUD"| Deployments

    %% Auth roles
    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SAR

    %% Leader election
    R_LeaderElection -->|"CRUD"| LEConfigMaps
    R_LeaderElection -->|"CRUD"| LELeases
    R_LeaderElection -->|"create,patch"| LEEvents

    %% Viewer/Editor roles
    CR_Viewer -->|"read"| OGXServers
    CR_Editor -->|"CRUD"| OGXServers
    CR_CompAdmin -->|"*"| OGXComp
    CR_CompEditor -->|"CRUD"| OGXComp
    CR_CompViewer -->|"read"| OGXComp

