graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph IngressLayer["INGRESS / SERVICE MESH"]
        Envoy["Envoy Proxy<br/>L7 proxy with ExtProc filter"]
    end

    subgraph EPPComponent["llm-d-router EPP<br/>(CGO_ENABLED=1, NO strictfipsruntime)"]
        direction TB

        subgraph EPPPorts["Exposed Ports"]
            ExtProc["ExtProc gRPC<br/>9002/TCP<br/>Optional TLS<br/>Auth: None"]
            Health["Health gRPC<br/>9003/TCP<br/>Optional TLS<br/>Auth: None"]
            Metrics["Prometheus Metrics<br/>9090/TCP HTTP"]
            ZMQ["ZMQ Interface<br/>5557/TCP"]
        end

        subgraph EPPInternal["Internal"]
            PluginPipeline["Plugin Pipeline<br/>(Scheduler, FlowControl,<br/>DataLayer, Parser)"]
            PodRecon["PodReconciler"]
            CRDRecon["CRD Reconcilers<br/>(Pool, ModelRewrite, Objective)"]
            DataStore["Live Endpoint Datastore"]
        end
    end

    subgraph Sidecar["pd-sidecar<br/>(CGO_ENABLED=1, strictfipsruntime)"]
        SidecarProxy["Sidecar Proxy<br/>HTTP"]
    end

    subgraph CoordComponent["coordinator"]
        HealthzEndpoint["/healthz /readyz<br/>HTTP GET"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Runtime-configured"]
        Prometheus["Prometheus<br/>Scrapes :9090"]
        BackendPods["Backend Model-Server Pods<br/>Routed by Envoy"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS<br/>Platform-dependent"| Envoy
    Envoy -->|"gRPC/9002<br/>Optional TLS<br/>No App Auth"| ExtProc
    Envoy -->|"Routes to selected<br/>backend pod"| BackendPods

    EPPComponent -->|"HTTPS-WSS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    EPPComponent -->|"OTLP/gRPC<br/>Runtime config"| OTel
    Prometheus -->|"HTTP/9090<br/>Scrape"| Metrics

    PodRecon -->|"Watch Pods"| K8sAPI
    CRDRecon -->|"Watch CRDs"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef component fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef sidecar fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef fipswarn fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Envoy ingress
    class ExtProc,Health,Metrics,ZMQ,PluginPipeline,PodRecon,CRDRecon,DataStore component
    class SidecarProxy sidecar
    class HealthzEndpoint sidecar
    class K8sAPI,OTel,Prometheus,BackendPods externalservice
