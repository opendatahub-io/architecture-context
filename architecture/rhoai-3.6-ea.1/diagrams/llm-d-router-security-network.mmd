graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client[External Client]
    end

    subgraph Gateway["INGRESS / GATEWAY"]
        Envoy["Envoy Proxy<br/>L7 Proxy + ExtProc<br/>TLS Termination: Platform-configured"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph EPP_NS["EPP (Endpoint Picker)"]
            direction TB
            ExtProc["ExternalProcessor gRPC<br/>9002/TCP HTTP/2<br/>Optional TLS<br/>Auth: None<br/><i>FIPS: NOT verified</i>"]
            HealthGRPC["Health gRPC<br/>HTTP/2<br/>Optional TLS<br/>Auth: None"]
            MetricsHTTP["Metrics HTTP<br/>9090/TCP HTTP/1.1<br/>Auth: None"]
            Controllers["Controller-Runtime<br/>Reconciles: InferencePool,<br/>InferenceModelRewrite,<br/>InferenceObjective, Pod"]
        end

        subgraph Sidecar_NS["pd-sidecar"]
            SidecarProxy["HTTP Proxy<br/>HTTP/1.1<br/><i>FIPS: Enabled</i><br/><i>(strictfipsruntime)</i>"]
            SidecarMetrics["Sidecar Metrics<br/>/metrics HTTP/1.1"]
        end

        subgraph Coordinator_NS["coordinator"]
            CoordHealth["Health Endpoints<br/>GET /healthz<br/>GET /readyz<br/>HTTP/1.1"]
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: ServiceAccount"]
        BackendPod["Model-Serving Pod<br/>Selected by EPP"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Encryption: Runtime configured"]
        Prometheus["Prometheus<br/>Scrapes 9090/TCP HTTP"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS"| Envoy
    Envoy -->|"gRPC ExtProc/9002<br/>HTTP/2<br/>Optional TLS<br/>Auth: None"| ExtProc
    ExtProc -->|"Routing decision"| Envoy
    Envoy -->|"Forward request"| BackendPod
    Controllers -->|"HTTPS/WSS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    MetricsHTTP -.->|"HTTP/9090<br/>Scraped"| Prometheus
    ExtProc -.->|"OTLP/gRPC<br/>Runtime config"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Envoy gateway
    class ExtProc,HealthGRPC,MetricsHTTP,Controllers warning
    class SidecarProxy,SidecarMetrics internal
    class CoordHealth internal
    class K8sAPI k8s
    class BackendPod internal
    class OTel,Prometheus externalservice
