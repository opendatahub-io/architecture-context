graph TD
    subgraph "Subject"
        Group["Group<br/>system:authenticated"]
    end

    subgraph "RoleBinding"
        RB["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "Role"
        Role["${PROJECT_NAME}-exec-role<br/>(Role - namespace-scoped)"]
    end

    subgraph "API Resources"
        PodsExec["core<br/>pods/exec"]
    end

    subgraph "Kubernetes API Access"
        SA["ServiceAccount<br/>(kubeconfig credential chain)"]
    end

    subgraph "Watched Resources (Read-Only)"
        InferencePoolCR["inference.networking.x-k8s.io/v1alpha2<br/>InferencePool"]
        Pods["core<br/>Pods"]
    end

    Group -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -->|"create"| PodsExec

    SA -->|"watch, list"| InferencePoolCR
    SA -->|"watch, list"| Pods

    style Group fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#9b59b6,stroke:#333,color:#fff
    style Role fill:#f5a623,stroke:#333,color:#fff
    style PodsExec fill:#7ed321,stroke:#333,color:#fff
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style InferencePoolCR fill:#7ed321,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
