graph TD
    subgraph "Subjects"
        Group["Group<br/>system:authenticated"]
    end

    subgraph "Role Bindings"
        RB["${PROJECT_NAME}-exec-rolebinding<br/>Namespace: ${NAMESPACE}<br/>Type: RoleBinding"]
    end

    subgraph "Roles"
        Role["${PROJECT_NAME}-exec-role<br/>Type: Role"]
    end

    subgraph "API Resources"
        PodsExec["core<br/>pods/exec"]
    end

    subgraph "Permissions"
        Create["create"]
    end

    Group -->|"bound via"| RB
    RB -->|"grants"| Role
    Role -->|"allows"| Create
    Create -->|"on"| PodsExec

    %% Additional context
    subgraph "Authentication Endpoints"
        direction TB
        K8sAuth["Kubernetes API<br/>Auth: kubeconfig credential chain<br/>Enforcement: kube-apiserver"]
        ProxyAuth["Proxy Endpoint (/)<br/>Auth: None<br/>TLS transport encryption only"]
    end

    %% Styles
    style Group fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#9b59b6,stroke:#333,color:#fff
    style Role fill:#f5a623,stroke:#333
    style PodsExec fill:#7ed321,stroke:#333
    style Create fill:#e8e8e8,stroke:#333
    style K8sAuth fill:#27ae60,stroke:#333,color:#fff
    style ProxyAuth fill:#e74c3c,stroke:#333,color:#fff
