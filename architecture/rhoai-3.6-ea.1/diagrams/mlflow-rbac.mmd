graph TD
    subgraph "Authentication Flow"
        Client["HTTP Client"] -->|"HTTP Request<br/>Port 5000"| AuthPlugin["kubernetes-auth Plugin<br/>(mlflow-kubernetes-plugins 1.5.0)"]
        AuthPlugin -->|"Validate credentials<br/>HTTPS/443"| K8sAPI["Kubernetes API Server"]
        K8sAPI -->|"Auth result"| AuthPlugin
    end

    subgraph "RBAC Note"
        Note["No ClusterRoles or RoleBindings<br/>defined in MLflow source.<br/><br/>RBAC is managed externally by<br/>the deploying operator/platform.<br/><br/>The kubernetes-auth plugin delegates<br/>all authentication to the Kubernetes API."]
    end

    subgraph "Secrets (Environment Variables)"
        direction LR
        subgraph "Cloud Provider Credentials"
            AWS["AWS_SECRET_ACCESS_KEY<br/>AWS_SESSION_TOKEN<br/>AWS_BEARER_TOKEN_BEDROCK"]
            Azure["AZURE_STORAGE_SAS_TOKEN"]
        end

        subgraph "AI Provider API Keys"
            OPENAI["OPENAI_API_KEY"]
            ANTHROPIC["ANTHROPIC_API_KEY"]
            COHERE["COHERE_API_KEY"]
            MISTRAL["MISTRAL_API_KEY"]
            GROQ["GROQ_API_KEY"]
            DEEPSEEK["DEEPSEEK_API_KEY"]
            XAI["XAI_API_KEY"]
            TOGETHERAI["TOGETHERAI_API_KEY"]
            OPENROUTER["OPENROUTER_API_KEY"]
            OLLAMA["OLLAMA_API_KEY"]
        end

        subgraph "Platform Credentials"
            DATABRICKS["DATABRICKS_TOKEN<br/>DATABRICKS_PASSWORD<br/>DATABRICKS_REFRESH_TOKEN<br/>DATABRICKS_CLIENT_SECRET"]
            JUPYTER["JUPYTERHUB_API_TOKEN"]
        end
    end

    AuthPlugin -->|"authenticated request"| Handlers["MLflow Route Handlers<br/>(Tracking / Registry / Artifacts)"]

    style Client fill:#f9f9f9,stroke:#999
