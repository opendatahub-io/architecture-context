graph TB
    subgraph AdminZone["ADMINISTRATOR (Trusted)"]
        CLI["rhaii-validator CLI<br/>Go 1.26, FIPS (strictfipsruntime)<br/>kubectl plugin"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph ValidationNS["NAMESPACE: rhaii-validation (Temporary)"]
        direction TB
        SA["ServiceAccount<br/>rhaii-validator"]

        subgraph AgentPods["Agent Job Pods (privileged, per GPU node)"]
            direction LR
            Agent["Agent Container<br/>SCC: privileged<br/>automountServiceAccountToken: false"]
        end

        CM["ConfigMap Reports<br/>(structured results)"]
    end

    subgraph HostDevices["HOST DEVICES (privileged access)"]
        direction LR
        GPU["GPU Hardware<br/>/dev/nvidia*<br/>Driver, ECC, Memory"]
        RDMA["RDMA Devices<br/>/dev/infiniband/*<br/>NIC topology, pingmesh"]
        Network["Network Stack<br/>iperf3 TCP<br/>bandwidth, latency"]
    end

    subgraph ValidationTargets["VALIDATION TARGETS (read-only API queries)"]
        direction TB

        subgraph CRDs["Required CRDs"]
            GW["Gateway API CRDs"]
            IP["InferencePool CRD"]
            LWS["LeaderWorkerSet CRD"]
            CMgr["cert-manager CRD"]
        end

        subgraph Operators["Operator Health"]
            IstioOp["Istio<br/>ns: istio-system"]
            CMgrOp["cert-manager<br/>ns: cert-manager"]
            LWSOp["LeaderWorkerSet<br/>ns: lws-system"]
        end
    end

    %% Flows
    CLI -->|"HTTPS/6443<br/>TLS 1.2+ (FIPS)<br/>kubeconfig auth"| K8sAPI

    K8sAPI -->|"CREATE/DELETE<br/>Namespace, SA, Jobs,<br/>ClusterRole, ClusterRoleBinding"| ValidationNS

    K8sAPI -->|"GET CRDs<br/>(Tier 1 deps check)"| CRDs
    K8sAPI -->|"GET Pods<br/>(Tier 1 deps check)"| Operators

    Agent -->|"Device access<br/>(privileged)"| GPU
    Agent -->|"Device access<br/>(privileged)"| RDMA
    Agent -->|"TCP tests<br/>(iperf3)"| Network

    Agent -->|"stdout + ConfigMap"| CM
    CLI -.->|"Stream logs (WSS)<br/>Read ConfigMap"| K8sAPI

    %% Styling
    classDef admin fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef validation fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef host fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef target fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class CLI admin
    class K8sAPI controlplane
    class SA,Agent,CM validation
    class GPU,RDMA,Network host
    class GW,IP,LWS,CMgr,IstioOp,CMgrOp,LWSOp target
