graph TB
    subgraph Workstation["OPERATOR WORKSTATION (Trusted)"]
        Admin["Administrator<br/>rhaii-validator CLI<br/>kubeconfig credentials"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+"]

        subgraph Resources["Created Resources"]
            direction TB
            NS["Namespace:<br/>rhaii-validation"]
            SA["ServiceAccount:<br/>rhaii-validator"]
            CR["ClusterRole:<br/>rhaii-validator (empty)"]
            CRB["ClusterRoleBinding:<br/>rhaii-validator"]
            SCC["SCC Binding:<br/>privileged → rhaii-validator"]
            CM["ConfigMap:<br/>validation results"]
        end
    end

    subgraph WorkerNodes["WORKER NODES (Hardware Access Zone)"]
        subgraph AgentPods["Agent Job Pods<br/>SA: rhaii-validator<br/>SCC: privileged<br/>NOTE: No K8s API calls"]
            direction TB

            subgraph GPUCheck["GPU Inspection"]
                GPUSys["/sys/class PCI topology<br/>Driver version, ECC, Memory<br/>Protocol: Local sysfs"]
            end

            subgraph RDMACheck["RDMA Inspection"]
                RDMASys["/sys/class/infiniband<br/>ibv_rc_pingpong<br/>ib_write_bw<br/>Protocol: IB verbs"]
            end

            subgraph NetCheck["Network Validation"]
                TCPLat["TCP Latency Echo<br/>12865/TCP<br/>Plaintext<br/>Pod-to-pod"]
                Iperf["iperf3 Bandwidth<br/>TCP Plaintext<br/>Pod-to-pod"]
            end
        end
    end

    subgraph ValidationTargets["VALIDATION TARGETS (Read-Only Queries)"]
        GatewayAPI["Gateway API CRDs<br/>(Gateways, HTTPRoutes)"]
        InfPool["InferencePool CRD"]
        LWSCRD["LeaderWorkerSet CRD"]
        CertMgrCRD["cert-manager CRD"]
        Operators["Operator Namespaces<br/>(cert-manager, Istio, LWS)"]
    end

    %% Flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+ (FIPS)<br/>kubeconfig auth"| K8sAPI
    K8sAPI -->|"Creates"| NS
    K8sAPI -->|"Creates"| SA
    K8sAPI -->|"Creates"| CR
    K8sAPI -->|"Creates"| CRB
    K8sAPI -->|"Creates"| SCC
    K8sAPI -->|"Deploys Jobs"| AgentPods
    AgentPods -->|"Results"| CM

    K8sAPI -.->|"CRD discovery<br/>(read-only)"| GatewayAPI
    K8sAPI -.->|"CRD discovery<br/>(read-only)"| InfPool
    K8sAPI -.->|"CRD discovery<br/>(read-only)"| LWSCRD
    K8sAPI -.->|"CRD discovery<br/>(read-only)"| CertMgrCRD
    K8sAPI -.->|"NS check<br/>(read-only)"| Operators

    %% Styling
    classDef workstation fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef worker fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef target fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef resource fill:#e1d5e7,stroke:#9673a6

    class Admin workstation
    class K8sAPI controlplane
    class AgentPods,GPUSys,RDMASys,TCPLat,Iperf worker
    class GatewayAPI,InfPool,LWSCRD,CertMgrCRD,Operators target
    class NS,SA,CR,CRB,SCC,CM resource
