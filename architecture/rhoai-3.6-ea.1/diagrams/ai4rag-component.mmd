graph TB
    subgraph "ai4rag Python Library"
        direction TB

        subgraph "Data Ingestion"
            S3Client["S3 Client<br/>(boto3)"]
            TextExtractor["Text Extraction<br/>(Docling)"]
            S3Client -->|downloads documents| TextExtractor
        end

        subgraph "Chunking"
            LangchainChunker["Langchain<br/>Text Splitters"]
            DoclingChunker["Docling<br/>Chunker"]
        end

        subgraph "RAG Pipeline"
            EmbeddingClient["OGX Embedding<br/>Client"]
            VectorStore["Vector Store<br/>(OGX / Chroma)"]
            FoundationModel["OGX Foundation<br/>Model Client"]
            EmbeddingClient -->|stores embeddings| VectorStore
            VectorStore -->|retrieves context| FoundationModel
        end

        subgraph "Optimization"
            HyperparamSearch["Hyperparameter Search<br/>(GAM Bayesian / Random)"]
            Evaluator["RAG Evaluator<br/>(LLM-as-Judge / Unitxt)"]
            HyperparamSearch -->|tunes parameters| Evaluator
        end

        subgraph "Output"
            NotebookGen["Notebook Generator<br/>(nbformat)"]
        end

        TextExtractor -->|raw text| LangchainChunker
        TextExtractor -->|raw text| DoclingChunker
        LangchainChunker -->|chunks| EmbeddingClient
        DoclingChunker -->|chunks| EmbeddingClient
        FoundationModel -->|results| Evaluator
        Evaluator -->|optimized config| NotebookGen
    end

    %% External Services
    S3Storage["S3-Compatible Storage<br/>AWS / MinIO"]
    OGXService["OGX Inference Service<br/>Embeddings, Chat, Vector Store"]

    S3Storage -->|HTTPS<br/>AWS credentials| S3Client
    EmbeddingClient -->|HTTPS<br/>API Key| OGXService
    FoundationModel -->|HTTPS<br/>API Key| OGXService
    VectorStore -->|HTTPS<br/>API Key| OGXService

    %% Styling
    style S3Client fill:#4a90e2,stroke:#333
    style TextExtractor fill:#4a90e2,stroke:#333
    style LangchainChunker fill:#4a90e2,stroke:#333
    style DoclingChunker fill:#4a90e2,stroke:#333
    style EmbeddingClient fill:#4a90e2,stroke:#333
    style VectorStore fill:#4a90e2,stroke:#333
    style FoundationModel fill:#4a90e2,stroke:#333
    style HyperparamSearch fill:#4a90e2,stroke:#333
    style Evaluator fill:#4a90e2,stroke:#333
    style NotebookGen fill:#4a90e2,stroke:#333
    style S3Storage fill:#f5a623,stroke:#333
    style OGXService fill:#f5a623,stroke:#333
