graph LR
    MRO["model-registry-operator<br/>Kubernetes Operator"]

    %% Runtime Framework
    MRO -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    MRO -->|"runtime integration"| K8sClientGo["k8s.io/client-go<br/>v0.36.3"]
    MRO -->|"API types"| K8sAPI["k8s.io/api<br/>v0.36.3"]
    MRO -->|"API machinery"| K8sAPIMachinery["k8s.io/apimachinery<br/>v0.36.3"]
    MRO -->|"CRD support"| K8sApiExt["k8s.io/apiextensions-apiserver<br/>v0.36.3"]

    %% Platform Dependencies
    MRO -->|"Gateway API routing"| GatewayAPI["sigs.k8s.io/gateway-api<br/>v1.6.1"]
    MRO -->|"OpenShift API types"| OpenShiftAPI["github.com/openshift/api"]
    MRO -->|"TLS security profile"| CtrlRuntimeCommon["openshift/controller-runtime-common"]
    MRO -->|"Istio types"| IstioClient["istio.io/client-go<br/>v1.30.3"]

    %% Internal Platform Dependencies
    MRO -->|"ingress routing"| DSGateway["data-science-gateway<br/>(Gateway API)"]
    MRO -->|"auth config"| PlatformAuth["services.platform.opendatahub.io<br/>Auth CRD"]
    MRO -->|"cluster domain"| OSIngress["config.openshift.io/v1<br/>Ingress"]
    MRO -->|"CRD migration"| SVMigration["migration.k8s.io<br/>StorageVersionMigration"]

    %% Utility Libraries
    MRO -->|"object matching"| ObjectMatcher["banzaicloud/k8s-objectmatcher<br/>v1.8.0"]
    MRO -->|"JSON patching"| JSONPatch["evanphx/json-patch/v5<br/>v5.9.11"]
    MRO -->|"CLI framework"| Cobra["spf13/cobra<br/>v1.10.2"]
    MRO -->|"YAML handling"| YAML["sigs.k8s.io/yaml<br/>v1.6.0"]

    %% Test Dependencies
    MRO -.->|"test framework"| Ginkgo["onsi/ginkgo/v2<br/>v2.32.0"]
    MRO -.->|"test matchers"| Gomega["onsi/gomega<br/>v1.42.1"]
    MRO -.->|"chaos testing"| OperatorChaos["opendatahub-io/operator-chaos"]

    %% Build Dependencies
    MRO -.->|"Go runtime"| GoRuntime["Go 1.26"]

    %% Managed Resources (what the operator creates)
    MRO ==>|"creates instances"| ModelRegistry["Model Registry Instance<br/>rest-container + kube-rbac-proxy"]
    MRO ==>|"creates catalog"| ModelCatalog["Model Catalog Instance<br/>catalog + kube-rbac-proxy"]
    MRO ==>|"creates databases"| PostgreSQL["PostgreSQL<br/>per-instance"]

