graph LR
    MRO["Model Registry Operator"]

    %% Platform / Runtime Dependencies
    MRO -->|"CRD CRUD<br/>HTTPS/6443"| K8sAPI["Kubernetes API<br/>v0.36.3"]
    MRO -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]
    MRO -->|"Go runtime"| GoRuntime["Go 1.26<br/>GOEXPERIMENT=strictfipsruntime"]

    %% Internal RHOAI Dependencies
    MRO -->|"reads platform config"| ODHModelReg["components.platform.opendatahub.io<br/>ModelRegistry"]
    MRO -->|"reads auth config"| ODHAuth["services.platform.opendatahub.io<br/>Auth"]
    MRO -->|"creates HTTPRoutes"| DSGateway["data-science-gateway<br/>Gateway API v1.6.1"]
    MRO -->|"CRD version migration"| SVMigration["StorageVersionMigration<br/>migration.k8s.io"]

    %% OpenShift Dependencies
    MRO -->|"reads cluster domain"| IngressConfig["OpenShift Ingress Config<br/>config.openshift.io/v1"]
    MRO -->|"creates Routes"| OSRoutes["OpenShift Routes<br/>route.openshift.io/v1"]
    MRO -->|"user/group mgmt"| OSUsers["OpenShift Users/Groups<br/>user.openshift.io/v1"]

    %% Per-Instance Dependencies
    MRO -->|"provisions"| PostgreSQL["PostgreSQL<br/>5432/TCP"]
    MRO -->|"deploys sidecar"| KubeRBAC["kube-rbac-proxy<br/>SubjectAccessReview auth"]

    %% Istio (via client-go dependency)
    MRO -.->|"istio client"| Istio["Istio Client<br/>istio.io/client-go v1.30.3"]

    %% Key Go Libraries
    MRO -->|"CLI framework"| Cobra["spf13/cobra<br/>v1.10.2"]
    MRO -->|"object matching"| ObjMatcher["k8s-objectmatcher<br/>v1.8.0"]
    MRO -->|"JSON patching"| JSONPatch["json-patch/v5<br/>v5.9.11"]

    %% Integration Points (consumers of MRO)
    ODHDashboard["ODH Dashboard"] -.->|"UI management"| MRO
    DSPipelines["Data Science Pipelines"] -.->|"model deployment"| MRO

