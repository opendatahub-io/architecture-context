graph TB
    subgraph NemoGuardrails["NeMo-Guardrails Server (Port 8000)"]
        direction TB
        FastAPI["FastAPI Application<br/>nemoguardrails.server.api"]
        Uvicorn["Uvicorn ASGI Server"]
        Uvicorn -->|serves| FastAPI

        subgraph APIs["API Endpoints"]
            ChatAPI["/v1/chat/completions<br/>POST"]
            CompletionsAPI["/v1/completions<br/>POST"]
            GuardrailChecks["/v1/guardrail/checks<br/>POST"]
            HealthAPI["/v1/health<br/>GET"]
            ModelsAPI["/v1/models<br/>GET"]
            ConfigsAPI["/v1/rails/configs<br/>GET"]
            ActionsAPI["/v1/actions/list<br/>GET"]
        end

        FastAPI --> APIs

        subgraph RailsPipeline["Guardrail Evaluation Pipeline"]
            InputRails["Input Rails<br/>(user/system messages)"]
            OutputRails["Output Rails<br/>(assistant messages)"]
            ToolInputRails["Tool-Input Rails<br/>(tool messages)"]
        end

        FastAPI -->|routes through| RailsPipeline

        subgraph Libraries["Pluggable Safety Libraries"]
            JailbreakDetect["Jailbreak Detection<br/>(Port 1337)"]
            FactCheck["AlignScore Fact-Checking<br/>(Port 5000)"]
            PIIDetect["PII Detection<br/>(Presidio)"]
            PromptSecurity["Prompt Security<br/>(External Services)"]
        end

        RailsPipeline -->|invokes| Libraries
    end

    Client["Client Application"] -->|HTTP POST<br/>Authorization header| FastAPI
    FastAPI -->|forwards validated request<br/>+ Authorization header| LLMProvider["Upstream LLM Provider<br/>(MAIN_MODEL_BASE_URL)"]

    subgraph Config["Configuration"]
        ConfigDir["Config Directory<br/>(YAML-based rails)"]
        EnvVars["Environment Variables<br/>MAIN_MODEL_ENGINE<br/>MAIN_MODEL_BASE_URL"]
    end

    ConfigDir -->|scanned at startup| FastAPI
    EnvVars -->|configures| FastAPI

    subgraph Optional["Optional Components"]
        Redis["Redis Datastore<br/>(thread persistence)"]
        OTel["OpenTelemetry<br/>(observability)"]
    end

    FastAPI -.->|optional| Redis
    FastAPI -.->|instrumented| OTel

    style FastAPI fill:#4a90e2,stroke:#333,stroke-width:2px
    style Uvicorn fill:#4a90e2,stroke:#333
    style InputRails fill:#f5a623,stroke:#333
    style OutputRails fill:#f5a623,stroke:#333
    style ToolInputRails fill:#f5a623,stroke:#333
    style JailbreakDetect fill:#e74c3c,stroke:#333
    style FactCheck fill:#e74c3c,stroke:#333
    style PIIDetect fill:#e74c3c,stroke:#333
    style PromptSecurity fill:#e74c3c,stroke:#333
    style LLMProvider fill:#999,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style Redis fill:#7ed321,stroke:#333
    style OTel fill:#7ed321,stroke:#333
