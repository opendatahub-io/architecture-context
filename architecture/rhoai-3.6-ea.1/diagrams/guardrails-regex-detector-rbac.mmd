graph TD
    subgraph "guardrails-regex-detector RBAC"
        direction TB
        Note["No RBAC resources defined"]

        subgraph "Application Security Model"
            direction TB
            NoAuth["No Authentication<br/>at application layer"]
            NoAuthZ["No Authorization<br/>at application layer"]
            NoCR["No ClusterRoles"]
            NoRB["No RoleBindings"]
            NoSecrets["No Secrets required"]
        end

        subgraph "Security Delegation"
            direction TB
            Platform["Platform Infrastructure<br/>provides all security"]
            MeshTLS["Service Mesh → TLS/mTLS"]
            MeshAuth["Service Mesh → Auth Policy"]
            NetPol["Network Policy → Access Control"]
        end

        NoAuth -.->|"delegated to"| Platform
        NoAuthZ -.->|"delegated to"| Platform
        Platform --> MeshTLS
        Platform --> MeshAuth
        Platform --> NetPol
    end

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style NoAuth fill:#f8d7da,stroke:#721c24,color:#721c24
    style NoAuthZ fill:#f8d7da,stroke:#721c24,color:#721c24
    style NoCR fill:#f8d7da,stroke:#721c24,color:#721c24
    style NoRB fill:#f8d7da,stroke:#721c24,color:#721c24
    style NoSecrets fill:#f8d7da,stroke:#721c24,color:#721c24
    style Platform fill:#d4edda,stroke:#155724,color:#155724
    style MeshTLS fill:#d4edda,stroke:#155724,color:#155724
    style MeshAuth fill:#d4edda,stroke:#155724,color:#155724
    style NetPol fill:#d4edda,stroke:#155724,color:#155724
