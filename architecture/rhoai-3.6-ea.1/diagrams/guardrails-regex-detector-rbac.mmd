graph TD
    subgraph "guardrails-regex-detector RBAC"
        direction TB

        Note["No RBAC Resources Defined"]

        subgraph "Security Posture"
            NoClusterRoles["No ClusterRoles"]
            NoRoleBindings["No RoleBindings"]
            NoServiceAccount["No custom ServiceAccount"]
            NoK8sAPI["No Kubernetes API access"]
        end

        subgraph "Authentication"
            API_Endpoint["POST /api/v1/text/contents<br/>Auth: None"]
            Health_Endpoint["GET /health<br/>Auth: None"]
        end

        subgraph "Security Delegation"
            Platform["Platform Layer<br/>(NetworkPolicy, ServiceMesh)"]
        end

        Note --> NoClusterRoles
        Note --> NoRoleBindings
        Note --> NoServiceAccount
        Note --> NoK8sAPI

        API_Endpoint -->|"security delegated to"| Platform
        Health_Endpoint -->|"security delegated to"| Platform
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style NoClusterRoles fill:#d5e8d4,stroke:#82b366
    style NoRoleBindings fill:#d5e8d4,stroke:#82b366
    style NoServiceAccount fill:#d5e8d4,stroke:#82b366
    style NoK8sAPI fill:#d5e8d4,stroke:#82b366
    style API_Endpoint fill:#dae8fc,stroke:#6c8ebf
    style Health_Endpoint fill:#dae8fc,stroke:#6c8ebf
    style Platform fill:#e8e8e8,stroke:#333,stroke-width:2px
