graph TB
    subgraph "ai-gateway-payload-processing Operator"
        direction TB

        subgraph Controllers["Kubernetes Controllers"]
            EPController["ExternalProvider<br/>Controller"]
            EMController["ExternalModel<br/>Controller"]
            LegacyController["Legacy Migration<br/>Controller<br/>(conditional)"]
        end

        subgraph PluginChain["llm-d Payload Processor Plugin Chain"]
            ModelResolver["model-provider-resolver<br/>Plugin"]
            APITranslation["API Translation<br/>Plugin"]
            APIKeyInjection["API Key Injection<br/>Plugin"]
            ModelResolver --> APITranslation
            APITranslation --> APIKeyInjection
        end
    end

    %% CRDs
    ExternalProviderCR["ExternalProvider CR<br/>(inference.opendatahub.io/v1alpha1)"]
    ExternalModelCR["ExternalModel CR<br/>(inference.opendatahub.io/v1alpha1)"]
    LegacyModelCR["ExternalModel CR<br/>(maas.opendatahub.io)<br/>⚠️ Legacy"]

    %% Created Resources
    ExternalProviderCR -->|watched by| EPController
    ExternalModelCR -->|watched by| EMController
    LegacyModelCR -.->|watched by<br/>if CRD exists| LegacyController

    EPController -->|creates| ExtNameSvc["ExternalName<br/>Service<br/>(port 443)"]
    EPController -->|creates| ServiceEntry["Istio ServiceEntry<br/>(MESH_EXTERNAL,<br/>DNS resolution)"]
    EPController -->|creates| DestRule["Istio DestinationRule<br/>(TLS SIMPLE<br/>origination)"]
    EPController -->|validates| Secret["Kubernetes Secret<br/>(auth credentials)"]

    EMController -->|creates| HTTPRoute["Gateway API<br/>HTTPRoute<br/>(path-prefix routing)"]
    HTTPRoute -->|targets| Gateway["Gateway<br/>(maas-default-gateway<br/>openshift-ingress ns)"]

    %% Plugin chain interactions
    ModelResolver -->|resolves| ExternalModelCR
    APIKeyInjection -->|reads| Secret

    %% External LLM Providers
    ExtNameSvc -->|routes to| LLMProviders["External LLM APIs<br/>(OpenAI, Anthropic,<br/>AWS Bedrock, Azure,<br/>Vertex AI)"]

    %% Styling
    style EPController fill:#4a90e2,color:#fff
    style EMController fill:#4a90e2,color:#fff
    style LegacyController fill:#4a90e2,color:#fff,stroke-dasharray: 5 5
    style ModelResolver fill:#9b59b6,color:#fff
    style APITranslation fill:#9b59b6,color:#fff
    style APIKeyInjection fill:#9b59b6,color:#fff
    style ExternalProviderCR fill:#f5a623,color:#fff
    style ExternalModelCR fill:#f5a623,color:#fff
    style LegacyModelCR fill:#f5a623,color:#fff,stroke-dasharray: 5 5
    style ExtNameSvc fill:#7ed321,color:#fff
    style ServiceEntry fill:#7ed321,color:#fff
    style DestRule fill:#7ed321,color:#fff
    style HTTPRoute fill:#7ed321,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style Secret fill:#e74c3c,color:#fff
    style LLMProviders fill:#999,color:#fff
