graph TB
    subgraph External["External Access"]
        User[User / Browser]
    end

    subgraph Ingress["OpenShift Routes (TLS Termination)"]
        RoutePlanner["Route: planner<br/>HTTPS/443"]
        RouteBackend["Route: planner-backend<br/>HTTPS/443"]
    end

    subgraph PlannerNS["Namespace: planner"]
        direction TB

        subgraph UITier["UI Tier"]
            UI["Streamlit UI<br/>Port 8501<br/>quay.io/llm-d-planner/llm-d-planner-ui"]
        end

        subgraph BackendTier["Backend Tier"]
            Backend["FastAPI Backend<br/>Port 8000 (uvicorn)<br/>quay.io/llm-d-planner/llm-d-planner-backend"]
            GPUDetector["GPU Detector Module<br/>Cached TTL: 300s"]
            Backend --> GPUDetector
        end

        subgraph DataTier["Data Tier"]
            Postgres["PostgreSQL 16<br/>Port 5432<br/>registry.redhat.io/rhel9/postgresql-16"]
        end

        subgraph LLMTier["LLM Tier"]
            Ollama["Ollama Server<br/>Port 11434<br/>ollama/ollama"]
        end

        ServiceCA["Service CA ConfigMap<br/>/etc/pki/service-ca"]
    end

    subgraph ExternalServices["External Services"]
        OpenAIAPI["OpenAI-compatible API<br/>HTTPS"]
        VertexAI["Google Vertex AI<br/>HTTPS"]
        K8sAPI["Kubernetes API Server<br/>Port 6443"]
    end

    %% User flows
    User -->|HTTPS/443| RoutePlanner
    User -->|HTTPS/443| RouteBackend
    RoutePlanner -->|HTTP/8501| UI
    RouteBackend -->|HTTP/8000| Backend

    %% Internal flows
    UI -->|HTTP/8000| Backend
    Backend -->|PostgreSQL/5432| Postgres
    Backend -->|HTTP/11434| Ollama
    Backend -->|TLS CA bundle| ServiceCA

    %% External flows
    Backend -->|HTTPS<br/>API Key auth| OpenAIAPI
    Backend -->|HTTPS| VertexAI
    GPUDetector -->|HTTPS/6443<br/>SA token| K8sAPI

    %% Styling
    style Backend fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style UI fill:#4a90e2,stroke:#333,color:#fff
    style GPUDetector fill:#5ba3f5,stroke:#333,color:#fff
    style Postgres fill:#336791,stroke:#333,color:#fff
    style Ollama fill:#1a1a2e,stroke:#333,color:#fff
    style RoutePlanner fill:#ee0000,stroke:#333,color:#fff
    style RouteBackend fill:#ee0000,stroke:#333,color:#fff
    style OpenAIAPI fill:#999,stroke:#333
    style VertexAI fill:#999,stroke:#333
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style ServiceCA fill:#f5a623,stroke:#333
