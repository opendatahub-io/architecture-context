graph TB
    subgraph Pod["Application Pod"]
        subgraph Sidecar["kube-rbac-proxy Sidecar"]
            SecureListener["Secure Listener<br/>8443/TCP TLS"]
            HandlerChain["Handler Chain"]
            AllowPaths["WithAllowPaths<br/>(bypass filter)"]
            AuthN["WithAuthentication<br/>(OIDC / TokenReview)"]
            AuthZ["WithAuthorization<br/>(SubjectAccessReview)"]
            AuthHeaders["WithAuthHeaders<br/>(identity injection)"]
            ReverseProxy["Reverse Proxy"]
            HealthListener["ProxyEndpoints Listener<br/>/healthz (no auth)"]
            TLSConfig["TLS Config<br/>Hot-reload, min version,<br/>cipher suites"]
        end

        Upstream["Upstream Service<br/>8080/TCP HTTP<br/>(localhost)"]
    end

    Client["Client"] -->|"HTTPS 8443<br/>Bearer Token"| SecureListener
    SecureListener --> HandlerChain
    HandlerChain --> AllowPaths
    AllowPaths -->|"bypassed path"| ReverseProxy
    AllowPaths -->|"protected path"| AuthN
    AuthN --> AuthZ
    AuthZ --> AuthHeaders
    AuthHeaders --> ReverseProxy
    ReverseProxy -->|"HTTP 8080<br/>+ auth headers"| Upstream

    Probe["Liveness/Readiness<br/>Probe"] -->|"HTTPS<br/>no auth"| HealthListener

    AuthN -->|"TokenReview<br/>HTTPS 6443"| K8sAPI["Kubernetes API Server"]
    AuthZ -->|"SubjectAccessReview<br/>HTTPS 6443"| K8sAPI

    TLSConfig -.->|configures| SecureListener
    TLSConfig -.->|configures| HealthListener

    style SecureListener fill:#4a90e2,color:#fff
    style AuthN fill:#e74c3c,color:#fff
    style AuthZ fill:#e74c3c,color:#fff
    style AuthHeaders fill:#f5a623,color:#fff
    style AllowPaths fill:#f5a623,color:#fff
    style ReverseProxy fill:#4a90e2,color:#fff
    style HealthListener fill:#4a90e2,color:#fff
    style TLSConfig fill:#9b59b6,color:#fff
    style Upstream fill:#7ed321,color:#fff
    style K8sAPI fill:#999,color:#fff
    style Client fill:#f9f9f9,stroke:#333
    style Probe fill:#f9f9f9,stroke:#333
