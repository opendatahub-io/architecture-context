graph TB
    subgraph "Workbenches Operator"
        direction TB
        Reconciler["WorkbenchesReconciler<br/>(controller-runtime)"]
        HWWebhook["Hardware Profile<br/>Webhook Injector<br/>:9443/workbenches-hardware-profile"]
        ConnWebhook["Connection Notebook<br/>Webhook<br/>:9443/workbenches-connection-notebook"]
        ConvWebhook["CRD Conversion<br/>Webhook<br/>:9443/convert"]
        TLSEnsurer["TLS Ensurer<br/>(SecurityProfileWatcher)"]
        Metrics["Metrics Endpoint<br/>:8443<br/>TokenReview + SAR"]
        Health["Health Probes<br/>:8081/healthz<br/>:8081/readyz"]
    end

    %% CR input
    Orchestrator["Platform Orchestrator<br/>(DSC/DSCI Reconciler)"] -->|"creates/updates<br/>gatewayDomain, mlflowEnabled, platform"| WorkbenchesCR["Workbenches CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]

    WorkbenchesCR -->|"watched by"| Reconciler

    %% Reconciler outputs (kustomize SSA)
    Reconciler -->|"deploys via<br/>kustomize SSA"| NotebookController["Kubeflow Notebook<br/>Controller Deployment"]
    Reconciler -->|"manages"| CRDs["Notebook CRDs<br/>(kubeflow.org)"]
    Reconciler -->|"manages"| RBACResources["RBAC Resources<br/>(ClusterRoles, Bindings)"]
    Reconciler -->|"manages"| WebhookConfigs["MutatingWebhookConfigurations<br/>ValidatingWebhookConfigurations"]
    Reconciler -->|"manages"| SupportingResources["ConfigMaps, Secrets<br/>Services, ServiceAccounts"]

    %% Webhook flows
    K8sAPI["Kubernetes API Server"] -->|"admission request<br/>443 → 9443 HTTPS"| HWWebhook
    K8sAPI -->|"admission request<br/>443 → 9443 HTTPS"| ConnWebhook
    K8sAPI -->|"conversion request<br/>443 → 9443 HTTPS"| ConvWebhook

    HWWebhook -->|"reads"| HardwareProfileCR["HardwareProfile CR<br/>(infrastructure.opendatahub.io)"]
    ConnWebhook -->|"reads"| DataConnSecrets["Data Connection<br/>Secrets"]

    %% TLS
    TLSEnsurer -->|"watches"| APIServerTLS["OpenShift APIServer<br/>TLS Security Profile"]
    CertManager["cert-manager /<br/>OpenShift service-ca"] -->|"provisions"| WebhookCert["Webhook TLS Cert<br/>(workbenches-operator-<br/>controller-webhook-cert)"]

    %% Notebook resources
    User["User / Data Scientist"] -->|"creates"| NotebookCR["Notebook CR<br/>(kubeflow.org)"]
    NotebookCR -->|"triggers admission"| K8sAPI

    %% Styling
    style Reconciler fill:#4a90e2,stroke:#333,color:#fff
    style HWWebhook fill:#4a90e2,stroke:#333,color:#fff
    style ConnWebhook fill:#4a90e2,stroke:#333,color:#fff
    style ConvWebhook fill:#4a90e2,stroke:#333,color:#fff
    style TLSEnsurer fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style WorkbenchesCR fill:#f5a623,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style HardwareProfileCR fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style NotebookController fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#333
