graph TB
    subgraph "Workbenches Operator"
        direction TB
        Controller["WorkbenchesReconciler<br/>(Go controller-runtime)"]
        ConnectionWH["NotebookWebhook<br/>/workbenches-connection-notebook<br/>Mutating Admission"]
        HardwareWH["HardwareProfile Injector<br/>/workbenches-hardware-profile<br/>Mutating Admission"]
        ConversionWH["Conversion Webhook<br/>/convert"]
        TLSConfig["TLS Config Manager<br/>SecurityProfileWatcher"]
        PlatformConfig["Platform Config Reader<br/>odh-workbenches-config"]

        Controller -->|"registers"| ConnectionWH
        Controller -->|"registers"| HardwareWH
        Controller -->|"registers"| ConversionWH
        TLSConfig -->|"configures TLS for"| Controller
        PlatformConfig -->|"provides metadata to"| Controller
    end

    %% External Inputs
    Orchestrator["Platform Orchestrator<br/>(DSC)"] -->|"creates/updates"| WorkbenchesCR["Workbenches CR<br/>(Cluster-scoped)"]
    WorkbenchesCR -->|"watched by"| Controller

    %% Reconciler Outputs
    Controller -->|"applies kustomize manifests"| NBController["Notebook Controller<br/>Deployment"]
    Controller -->|"manages"| Services["Services"]
    Controller -->|"manages"| ConfigMaps["ConfigMaps"]
    Controller -->|"manages"| Secrets["Secrets"]
    Controller -->|"manages"| RBAC["RBAC Resources<br/>Roles, Bindings"]
    Controller -->|"manages"| WebhookConfigs["Webhook Configurations<br/>Mutating/Validating"]

    %% Webhook Interactions
    User["User / kubectl"] -->|"creates/updates"| NotebookCR["Notebook CR<br/>kubeflow.org/notebooks"]
    NotebookCR -->|"admission intercept"| ConnectionWH
    NotebookCR -->|"admission intercept"| HardwareWH
    ConnectionWH -->|"validates via SAR"| K8sAPI["Kubernetes API"]
    ConnectionWH -->|"reads"| ConnSecrets["Connection Secrets"]
    HardwareWH -->|"reads"| HWProfile["HardwareProfile CR"]

    %% TLS Sources
    APIServer["OpenShift APIServer<br/>TLS Profile"] -->|"drives cipher config"| TLSConfig
    ServiceCA["OpenShift service-ca /<br/>cert-manager"] -->|"provisions certs"| TLSConfig

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style ConnectionWH fill:#4a90e2,stroke:#333,color:#fff
    style HardwareWH fill:#4a90e2,stroke:#333,color:#fff
    style ConversionWH fill:#4a90e2,stroke:#333,color:#fff
    style TLSConfig fill:#4a90e2,stroke:#333,color:#fff
    style PlatformConfig fill:#4a90e2,stroke:#333,color:#fff
    style WorkbenchesCR fill:#f5a623,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style HWProfile fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style ServiceCA fill:#e8e8e8,stroke:#333
    style ConnSecrets fill:#e8e8e8,stroke:#333
    style NBController fill:#d5e8d4,stroke:#333
    style Services fill:#d5e8d4,stroke:#333
    style ConfigMaps fill:#d5e8d4,stroke:#333
    style Secrets fill:#d5e8d4,stroke:#333
    style RBAC fill:#d5e8d4,stroke:#333
    style WebhookConfigs fill:#d5e8d4,stroke:#333
