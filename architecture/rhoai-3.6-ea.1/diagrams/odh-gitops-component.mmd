graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph XKS["rhai-on-xks-chart (Helm Chart v3.5.0)"]
            direction TB
            RHAIOp[RHAI Operator Deployment]
            KServeHook[KServe Post-Install Hook]
            AIGatewayHook[AIGateway Post-Install Hook]
            CloudMgr[Cloud Manager Deployment]

            subgraph SubCharts["Bundled Sub-Charts"]
                SailOp[sail-operator<br/>Istio Service Mesh]
                GatewayAPI[gateway-api<br/>CRDs + Controller]
                CertMgrOp[cert-manager-operator<br/>Certificate Management]
                RHCLOp[rhcl-operator<br/>Authorino]
                LWSOp[lws-operator<br/>Leader-Worker Sets]
            end

            RHAIOp --> KServeHook
            RHAIOp --> AIGatewayHook
            KServeHook -->|creates| GatewayRes[Gateway + TLS Certs]
            AIGatewayHook -->|creates| MaaSGW[MaaS Gateway]
        end

        subgraph OCP["rhai-on-openshift-chart (Helm Chart v3.4.0)"]
            direction TB
            subgraph Subscriptions["operator-subscriptions (Kustomize)"]
                CertMgrSub[cert-manager]
                KueueSub[kueue-operator]
                ObsSub[cluster-observability-operator]
                OTelSub[opentelemetry-product]
                LWSSub[leader-worker-set]
                JobSetSub[job-set-operator]
                TempoSub[tempo-product]
                CMASub[custom-metrics-autoscaler]
                RHCLSub[rhcl-operator]
            end

            subgraph Configs["operator-configurations (Kustomize)"]
                KueueCfg[Kueue Config]
                JobSetCfg[JobSet Config]
                LWSCfg[LWS Config]
                RHCLCfg[RHCL TLS Config]
            end

            Subscriptions --> Configs
        end
    end

    %% Cloud targets
    Azure[Azure AKS]
    CoreWeave[CoreWeave]
    AWS[AWS EKS]
    OpenShift[OpenShift + OLM]

    XKS -->|deploys to| Azure
    XKS -->|deploys to| CoreWeave
    XKS -->|deploys to| AWS
    OCP -->|deploys to| OpenShift

    %% Styling
    style XKS fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    style OCP fill:#e8f5e9,stroke:#82b366,stroke-width:2px
    style SubCharts fill:#fff3e0,stroke:#f5a623,stroke-width:1px
    style Subscriptions fill:#f3e5f5,stroke:#9c27b0,stroke-width:1px
    style Configs fill:#fce4ec,stroke:#e91e63,stroke-width:1px
    style Azure fill:#e8e8e8,stroke:#666
    style CoreWeave fill:#e8e8e8,stroke:#666
    style AWS fill:#e8e8e8,stroke:#666
    style OpenShift fill:#e8e8e8,stroke:#666
    style RHAIOp fill:#4a90e2,color:#fff
    style KServeHook fill:#4a90e2,color:#fff
    style AIGatewayHook fill:#4a90e2,color:#fff
