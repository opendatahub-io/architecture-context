graph TD
    subgraph Note["NOTE: All RBAC below is from EXAMPLE manifests only"]
        direction TB
        style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    end

    subgraph SA_Section["Service Accounts"]
        SA1["stable-diffusion-nb<br/>(Namespace: distributed)"]
        SA2["nfs-server-sa<br/>(Namespace: nfs)"]
    end

    subgraph RB_Section["Role Bindings"]
        RB1["edit<br/>(RoleBinding)"]
        RB2["nfs-server-sa-anyuid<br/>(RoleBinding)"]
        RB3["nfs-server-sa-privileged<br/>(RoleBinding)"]
    end

    subgraph CR_Section["Cluster Roles"]
        CR1["edit<br/>(ClusterRole)"]
        CR2["system:openshift:scc:anyuid<br/>(ClusterRole)"]
        CR3["system:openshift:scc:privileged<br/>(ClusterRole)"]
    end

    subgraph Permissions["Granted Permissions"]
        P1["Standard edit access<br/>to namespace resources"]
        P2["Run as any UID<br/>(SCC: anyuid)"]
        P3["Full privileged access<br/>(SCC: privileged)"]
    end

    subgraph Secrets_Section["Secrets (Example Only)"]
        S1["minio<br/>Type: Opaque<br/>MinIO credentials"]
        S2["minio-secret<br/>Type: Opaque<br/>MinIO credentials"]
    end

    SA1 -->|"bound via"| RB1
    RB1 -->|"grants"| CR1
    CR1 -->|"provides"| P1

    SA2 -->|"bound via"| RB2
    RB2 -->|"grants"| CR2
    CR2 -->|"provides"| P2

    SA2 -->|"bound via"| RB3
    RB3 -->|"grants"| CR3
    CR3 -->|"provides"| P3

    subgraph Production["PRODUCTION: No RBAC Defined"]
        ProdNote["This component ships container images only.<br/>Production RBAC is managed by the consuming<br/>platform operators (Kubeflow Training Operator,<br/>KubeRay, Kueue, Workbench Controller)."]
    end

    style SA1 fill:#4a90e2,stroke:#333,color:#fff
    style SA2 fill:#4a90e2,stroke:#333,color:#fff
    style RB1 fill:#9b59b6,stroke:#333,color:#fff
    style RB2 fill:#9b59b6,stroke:#333,color:#fff
    style RB3 fill:#9b59b6,stroke:#333,color:#fff
    style CR1 fill:#f5a623,stroke:#333
    style CR2 fill:#f5a623,stroke:#333
    style CR3 fill:#e74c3c,stroke:#333,color:#fff
    style P1 fill:#7ed321,stroke:#333
    style P2 fill:#f5a623,stroke:#333
    style P3 fill:#e74c3c,stroke:#333,color:#fff
    style S1 fill:#e8e8e8,stroke:#999
    style S2 fill:#e8e8e8,stroke:#999
    style Production fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ProdNote fill:#d5e8d4,stroke:#82b366
