graph TD
    subgraph "Note: All RBAC is Example-Scoped"
        direction TB
        Note["This component defines NO production ClusterRoles.<br/>All RBAC below is from example workloads only."]
    end

    subgraph "Example: Stable Diffusion Workload"
        SA1["ServiceAccount<br/>stable-diffusion-nb"]
        RB1["RoleBinding<br/>edit"]
        CR1["ClusterRole<br/>edit"]

        SA1 -->|"bound via"| RB1
        RB1 -->|"grants (ns: distributed)"| CR1
    end

    subgraph "Example: NFS Server Infrastructure"
        SA2["ServiceAccount<br/>nfs-server-sa"]

        RB2["RoleBinding<br/>nfs-server-sa-anyuid"]
        CR2["ClusterRole<br/>system:openshift:scc:anyuid"]

        RB3["RoleBinding<br/>nfs-server-sa-privileged"]
        CR3["ClusterRole<br/>system:openshift:scc:privileged"]

        SA2 -->|"bound via"| RB2
        RB2 -->|"grants (ns: nfs)"| CR2

        SA2 -->|"bound via"| RB3
        RB3 -->|"grants (ns: nfs)"| CR3
    end

    subgraph "Secrets (Example-Scoped)"
        S1["Secret: minio<br/>Type: Opaque<br/>MinIO credentials"]
        S2["Secret: minio-secret<br/>Type: Opaque<br/>MinIO credentials"]
    end

    subgraph "Production Security Model"
        ProdNote["Training pods run under ServiceAccounts<br/>managed by Kubeflow Trainer controller.<br/>No component-level authentication.<br/>FIPS via AIPCC/UBI9 base image OpenSSL."]
    end

