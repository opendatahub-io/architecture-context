graph TB
    subgraph "kube-auth-proxy"
        direction TB
        subgraph "HTTP Servers"
            AppServer["Application Server<br/>:4180"]
            MetricsServer["Metrics Server<br/>Prometheus"]
        end

        subgraph "Authentication Middleware Chain"
            direction TB
            K8sTokenAuth["K8s ServiceAccount<br/>Token Validator"]
            JWTAuth["JWT/OAuth Bearer<br/>Token Validator"]
            BasicAuth["Basic Auth<br/>(htpasswd)"]
            CookieSession["Cookie Session<br/>Lookup & Refresh"]
            K8sTokenAuth --> JWTAuth
            JWTAuth --> BasicAuth
            BasicAuth --> CookieSession
        end

        subgraph "OAuth2 Endpoints"
            SignIn["/oauth2/sign_in"]
            SignOut["/oauth2/sign_out"]
            Start["/oauth2/start"]
            Callback["/oauth2/callback"]
            AuthCheck["/oauth2/auth<br/>(ext_authz)"]
            UserInfo["/oauth2/userinfo"]
        end

        UpstreamProxy["Upstream Proxy Handler<br/>Header Injection"]
    end

    Client["External Client<br/>(Browser / API)"] -->|"HTTPS via Route"| AppServer
    AppServer --> K8sTokenAuth
    CookieSession -->|"Authenticated"| UpstreamProxy
    UpstreamProxy -->|"Forward to backend"| Upstream["Upstream Backend Service"]

    AppServer --> SignIn
    AppServer --> SignOut
    AppServer --> Start
    AppServer --> Callback
    AppServer --> AuthCheck
    AppServer --> UserInfo

    K8sTokenAuth -->|"TokenReview API"| K8sAPI["Kubernetes API<br/>:6443"]
    Start -->|"OAuth2 Redirect"| OIDCProvider["OAuth2/OIDC Provider<br/>(OpenShift OAuth)"]
    Callback -->|"Token Exchange"| OIDCProvider
    SignOut -->|"Delete OAuthAccessToken"| OpenShiftOAuth["OpenShift OAuth API"]
    CookieSession -->|"Session Store"| Redis["Redis/Valkey<br/>(Optional, TLS)"]

    style AppServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style K8sTokenAuth fill:#f5a623,stroke:#333
    style JWTAuth fill:#f5a623,stroke:#333
    style BasicAuth fill:#f5a623,stroke:#333
    style CookieSession fill:#f5a623,stroke:#333
    style UpstreamProxy fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OIDCProvider fill:#e8e8e8,stroke:#333
    style OpenShiftOAuth fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style Upstream fill:#7ed321,stroke:#333
