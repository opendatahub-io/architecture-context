graph TB
    subgraph External["External Users"]
        User[Data Scientist / ML Engineer]
    end

    subgraph TrainerOperator["Trainer Controller Manager"]
        direction TB
        Controller[Trainer Controller<br/>controller-runtime operator]
        WebhookServer[Webhook Server<br/>Port 9443/TLS]
        HealthProbe[Health/Readiness Probes<br/>Port 8081]
        MetricsServer[Metrics Server<br/>Port 8080]
        TLSConfig[TLS Configuration<br/>OpenShift APIServer profile]

        subgraph Plugins["Runtime Framework Plugins"]
            JobSetPlugin[JobSet Plugin]
            CoSchedPlugin[CoScheduling Plugin]
            VolcanoPlugin[Volcano Plugin]
            MPIPlugin[MPI Plugin]
        end

        subgraph RHOAIExtensions["RHOAI Platform Extensions"]
            NetPolicyMgr[NetworkPolicy Manager<br/>per-TrainJob isolation]
            ProgressTracker[Progression Tracker<br/>HTTP metrics polling]
        end

        Controller --> Plugins
        Controller --> RHOAIExtensions
        Controller --> TLSConfig
    end

    subgraph Initializers["Initializer Containers"]
        DatasetInit[Dataset Initializer<br/>Python]
        ModelInit[Model Initializer<br/>Python]
    end

    subgraph CRDs["Custom Resource Definitions"]
        TrainJobCR[TrainJob CR<br/>trainer.kubeflow.org/v1alpha1]
        TrainingRuntimeCR[TrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1]
        ClusterTrainingRuntimeCR[ClusterTrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1]
    end

    subgraph SchedulingBackends["Scheduling Backends"]
        JobSet[JobSet<br/>jobset.x-k8s.io/v1alpha2]
        CoScheduling[Scheduler Plugins<br/>scheduling/v1alpha1 PodGroup]
        Volcano[Volcano Scheduler<br/>scheduling/v1beta1 PodGroup]
    end

    subgraph K8sResources["Kubernetes Resources"]
        NetworkPolicy[NetworkPolicy<br/>networking.k8s.io/v1]
        ConfigMap[ConfigMap<br/>MPI config]
        Secret[Secret<br/>SSH keys]
        TrainingPod[Training Pod<br/>Workload execution]
    end

    %% User interactions
    User -->|"creates"| TrainJobCR
    User -->|"defines"| TrainingRuntimeCR
    User -->|"defines"| ClusterTrainingRuntimeCR

    %% Webhook validation
    TrainJobCR -->|"validated by"| WebhookServer
    TrainingRuntimeCR -->|"validated by"| WebhookServer
    ClusterTrainingRuntimeCR -->|"validated by"| WebhookServer

    %% Controller watches CRDs
    TrainJobCR -->|"watched by"| Controller
    TrainingRuntimeCR -->|"referenced by"| Controller
    ClusterTrainingRuntimeCR -->|"referenced by"| Controller

    %% Plugin creates scheduling resources
    JobSetPlugin -->|"creates"| JobSet
    CoSchedPlugin -->|"creates"| CoScheduling
    VolcanoPlugin -->|"creates"| Volcano
    MPIPlugin -->|"creates"| ConfigMap
    MPIPlugin -->|"creates"| Secret

    %% RHOAI extensions
    NetPolicyMgr -->|"creates"| NetworkPolicy
    ProgressTracker -->|"polls HTTP"| TrainingPod

    %% Initializers
    DatasetInit -->|"prepares data for"| TrainingPod
    ModelInit -->|"prepares model for"| TrainingPod

    %% Scheduling backends create pods
    JobSet -->|"schedules"| TrainingPod

    %% Styling
    style Controller fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style HealthProbe fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style TLSConfig fill:#4a90e2,color:#fff
    style JobSetPlugin fill:#5b9bd5,color:#fff
    style CoSchedPlugin fill:#5b9bd5,color:#fff
    style VolcanoPlugin fill:#5b9bd5,color:#fff
    style MPIPlugin fill:#5b9bd5,color:#fff
    style NetPolicyMgr fill:#9b59b6,color:#fff
    style ProgressTracker fill:#9b59b6,color:#fff
    style TrainJobCR fill:#f5a623
    style TrainingRuntimeCR fill:#f5a623
    style ClusterTrainingRuntimeCR fill:#f5a623
    style JobSet fill:#e8e8e8
    style CoScheduling fill:#e8e8e8
    style Volcano fill:#e8e8e8
    style DatasetInit fill:#7ed321,color:#fff
    style ModelInit fill:#7ed321,color:#fff
    style TrainingPod fill:#e74c3c,color:#fff
