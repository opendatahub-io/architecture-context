graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["maas-api<br/>Namespace: opendatahub"]
    end

    subgraph RoleBindings["ClusterRole Bindings"]
        CRB_API["maas-api<br/>(ClusterRoleBinding)"]
        CRB_SUPP["maas-api-supplemental<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_API["maas-api<br/>(ClusterRole)"]
        CR_SUPP["maas-api-supplemental<br/>(ClusterRole)"]
    end

    subgraph CoreResources["Core API Resources"]
        Secrets["core/secrets<br/><i>get</i><br/>(resourceNames: maas-db-config)"]
        Namespaces["core/namespaces<br/><i>create, get, list, watch</i>"]
        ServiceAccounts["core/serviceaccounts<br/><i>create, delete, get, list, watch</i>"]
        SATokens["core/serviceaccounts/token<br/><i>create</i>"]
        EndpointsPodsServices["core/endpoints, pods, services<br/><i>get, list, watch</i>"]
    end

    subgraph AuthResources["Authentication / Authorization"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/><i>create</i>"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/><i>create</i>"]
    end

    subgraph MaaSResources["MaaS CRD Resources"]
        MaaSCRDs["maas.opendatahub.io<br/>maasauthpolicies,<br/>maasmodelrefs,<br/>maassubscriptions<br/><i>get, list, watch</i>"]
    end

    subgraph GatewayResources["Gateway API Resources"]
        HTTPRoutes["gateway.networking.k8s.io<br/>httproutes<br/><i>get, list, watch</i>"]
        Gateways["gateway.networking.k8s.io<br/>gateways<br/><i>get</i>"]
    end

    subgraph OpenShiftResources["OpenShift Resources"]
        APIServers["config.openshift.io<br/>apiservers<br/><i>get, list, watch</i>"]
    end

    subgraph SupplementalResources["Supplemental-Only Resources"]
        SuppSecrets["core/secrets<br/><i>get</i><br/>(resourceNames: maas-db-config)"]
        SuppMaaS["maas.opendatahub.io<br/>maasmodelrefs,<br/>maassubscriptions<br/><i>get, list, watch</i>"]
    end

    %% Bindings
    SA_API -->|"bound via"| CRB_API
    SA_API -->|"bound via"| CRB_SUPP

    CRB_API -->|"grants"| CR_API
    CRB_SUPP -->|"grants"| CR_SUPP

    %% maas-api ClusterRole permissions
    CR_API -->|"get (named)"| Secrets
    CR_API -->|"CRUD"| Namespaces
    CR_API -->|"CRUD"| ServiceAccounts
    CR_API -->|"create"| SATokens
    CR_API -->|"create"| TokenReviews
    CR_API -->|"create"| SAR
    CR_API -->|"read"| MaaSCRDs
    CR_API -->|"read"| HTTPRoutes
    CR_API -->|"get"| Gateways
    CR_API -->|"read"| EndpointsPodsServices
    CR_API -->|"read"| APIServers

    %% maas-api-supplemental ClusterRole permissions
    CR_SUPP -->|"get (named)"| SuppSecrets
    CR_SUPP -->|"create"| SAR
    CR_SUPP -->|"read"| SuppMaaS
    CR_SUPP -->|"read"| APIServers
    CR_SUPP -->|"get"| Gateways

    %% Webhook Admission
    subgraph Webhooks["Validating Admission Webhooks"]
        WH_Tenant["vaitenant.kb.io<br/>AITenant<br/>CREATE, UPDATE<br/>FailurePolicy: Fail"]
        WH_AuthPolicy["vmaasauthpolicy.kb.io<br/>MaaSAuthPolicy<br/>CREATE<br/>FailurePolicy: Fail"]
        WH_ModelRef["vmaasmodelref.kb.io<br/>MaaSModelRef<br/>CREATE, UPDATE<br/>FailurePolicy: Fail"]
        WH_Sub["vmaassubscription.kb.io<br/>MaaSSubscription<br/>CREATE<br/>FailurePolicy: Fail"]
    end

    %% Styles
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style CR_API fill:#f5a623,stroke:#333,color:#000
    style CR_SUPP fill:#f5a623,stroke:#333,color:#000
    style CRB_API fill:#e8e8e8,stroke:#333
    style CRB_SUPP fill:#e8e8e8,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style ServiceAccounts fill:#7ed321,stroke:#333
    style SATokens fill:#7ed321,stroke:#333
    style EndpointsPodsServices fill:#7ed321,stroke:#333
    style TokenReviews fill:#ff6b6b,stroke:#333,color:#fff
    style SAR fill:#ff6b6b,stroke:#333,color:#fff
    style MaaSCRDs fill:#7ed321,stroke:#333
    style HTTPRoutes fill:#7ed321,stroke:#333
    style Gateways fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
    style SuppSecrets fill:#7ed321,stroke:#333
    style SuppMaaS fill:#7ed321,stroke:#333
    style WH_Tenant fill:#dae8fc,stroke:#6c8ebf
    style WH_AuthPolicy fill:#dae8fc,stroke:#6c8ebf
    style WH_ModelRef fill:#dae8fc,stroke:#6c8ebf
    style WH_Sub fill:#dae8fc,stroke:#6c8ebf
