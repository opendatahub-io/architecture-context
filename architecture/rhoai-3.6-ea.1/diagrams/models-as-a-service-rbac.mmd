graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_MaaSAPI["maas-api<br/>Namespace: opendatahub"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB1["maas-api<br/>→ ClusterRole: maas-api"]
        CRB2["maas-api-supplemental<br/>→ ClusterRole: maas-api-supplemental"]
    end

    subgraph CR_Primary["ClusterRole: maas-api"]
        direction TB
        CR1_Core["core API<br/>secrets: get<br/>namespaces: create, get, list, watch<br/>serviceaccounts: create, delete, get, list, watch<br/>serviceaccounts/token: create<br/>endpoints, pods, services: get, list, watch"]
        CR1_Auth["authentication.k8s.io<br/>tokenreviews: create"]
        CR1_Authz["authorization.k8s.io<br/>subjectaccessreviews: create"]
        CR1_MaaS["maas.opendatahub.io<br/>maasauthpolicies: get, list, watch<br/>maasmodelrefs: get, list, watch<br/>maassubscriptions: get, list, watch"]
        CR1_Gateway["gateway.networking.k8s.io<br/>httproutes: get, list, watch<br/>gateways: get"]
        CR1_OCP["config.openshift.io<br/>apiservers: get, list, watch"]
    end

    subgraph CR_Supplemental["ClusterRole: maas-api-supplemental"]
        direction TB
        CR2_Core["core API<br/>secrets: get"]
        CR2_Authz["authorization.k8s.io<br/>subjectaccessreviews: create"]
        CR2_MaaS["maas.opendatahub.io<br/>maasmodelrefs: get, list, watch<br/>maassubscriptions: get, list, watch"]
        CR2_OCP["config.openshift.io<br/>apiservers: get, list, watch"]
        CR2_Gateway["gateway.networking.k8s.io<br/>gateways: get"]
    end

    subgraph Webhooks["Validating Webhooks (Fail Policy)"]
        WH1["vaitenant.kb.io<br/>AITenant: CREATE, UPDATE"]
        WH2["vmaasauthpolicy.kb.io<br/>MaaSAuthPolicy: CREATE"]
        WH3["vmaasmodelref.kb.io<br/>MaaSModelRef: CREATE, UPDATE"]
        WH4["vmaassubscription.kb.io<br/>MaaSSubscription: CREATE"]
    end

    %% Bindings
    SA_MaaSAPI -->|bound via| CRB1
    SA_MaaSAPI -->|bound via| CRB2
    CRB1 -->|grants| CR_Primary
    CRB2 -->|grants| CR_Supplemental

    %% Webhook connection
    SA_MaaSAPI -.->|admission control| Webhooks

    %% Styling
    style SA_MaaSAPI fill:#4a90e2,stroke:#333,color:#fff
    style CRB1 fill:#9b59b6,stroke:#333,color:#fff
    style CRB2 fill:#9b59b6,stroke:#333,color:#fff
    style CR1_Core fill:#f5a623,stroke:#333
    style CR1_Auth fill:#f5a623,stroke:#333
    style CR1_Authz fill:#f5a623,stroke:#333
    style CR1_MaaS fill:#f5a623,stroke:#333
    style CR1_Gateway fill:#f5a623,stroke:#333
    style CR1_OCP fill:#f5a623,stroke:#333
    style CR2_Core fill:#e67e22,stroke:#333
    style CR2_Authz fill:#e67e22,stroke:#333
    style CR2_MaaS fill:#e67e22,stroke:#333
    style CR2_OCP fill:#e67e22,stroke:#333
    style CR2_Gateway fill:#e67e22,stroke:#333
    style WH1 fill:#e74c3c,stroke:#333,color:#fff
    style WH2 fill:#e74c3c,stroke:#333,color:#fff
    style WH3 fill:#e74c3c,stroke:#333,color:#fff
    style WH4 fill:#e74c3c,stroke:#333,color:#fff
