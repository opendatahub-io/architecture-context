graph TD
    subgraph "NeMo-Guardrails Security Model"
        direction TB

        subgraph "Authentication"
            NoAuth["No Built-in Authentication<br/><i>Platform-delegated access control</i>"]
            HeaderFwd["Authorization Header Forwarding<br/><i>Client → Server → Upstream LLM</i>"]
        end

        subgraph "API Key Management (Environment Variables)"
            direction LR

            subgraph "LLM Provider Keys"
                AzureKey["AZURE_OPENAI_API_KEY<br/>Azure OpenAI access"]
            end

            subgraph "Guardrail Provider Keys"
                ActiveFenceKey["ACTIVEFENCE_API_KEY"]
                AIDefenseKey["AI_DEFENSE_API_KEY"]
                AutoAlignKey["AUTOALIGN_API_KEY"]
                ClavataKey["CLAVATA_API_KEY"]
                CleanlabKey["CLEANLAB_API_KEY"]
                CSAIDRKey["CS_AIDR_TOKEN"]
                F5Key["F5_GUARDRAILS_API_KEY"]
                FiddlerKey["FIDDLER_API_KEY"]
                PangeaKey["PANGEA_API_TOKEN"]
                PatronusKey["PATRONUS_API_KEY"]
                PolicyAIKey["POLICYAI_API_KEY"]
                PolygrafKey["POLYGRAF_API_KEY"]
                PAIKey["PAI_API_KEY"]
            end

            subgraph "Model Access Keys"
                HFToken["HF_TOKEN<br/>HuggingFace Hub"]
            end
        end

        subgraph "Platform-Level Controls (Expected)"
            NetworkPolicy["Kubernetes NetworkPolicy<br/><i>Restrict ingress/egress</i>"]
            ServiceMesh["Service Mesh / API Gateway<br/><i>mTLS, AuthN, rate limiting</i>"]
            RBAC_K8s["Kubernetes RBAC<br/><i>Pod security, namespace isolation</i>"]
        end

        subgraph "Crypto & TLS"
            SystemTLS["System OpenSSL<br/>via cryptography==46.0.7"]
            CABundle["CA Bundle<br/>SSL_CERT_FILE<br/>REQUESTS_CA_BUNDLE"]
            FIPS["FIPS Compliance<br/><i>Inherited from AIPCC base image</i>"]
        end
    end

    NoAuth -->|"access control required from"| NetworkPolicy
    NoAuth -->|"access control required from"| ServiceMesh
    HeaderFwd -->|"forwards to"| AzureKey

    style NoAuth fill:#e74c3c,stroke:#333,color:#fff
    style HeaderFwd fill:#f5a623,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style ServiceMesh fill:#7ed321,stroke:#333
    style RBAC_K8s fill:#7ed321,stroke:#333
