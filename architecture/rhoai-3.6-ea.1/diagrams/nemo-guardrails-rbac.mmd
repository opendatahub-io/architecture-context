    style CABundle fill:#4a90e2,stroke:#333,color:#fff
    style FIPS fill:#4a90e2,stroke:#333,color:#fff
    style AzureKey fill:#f5a623,stroke:#333
    style HFToken fill:#f5a623,stroke:#333

