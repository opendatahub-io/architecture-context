graph LR
    Notebooks["Notebooks<br/>Container Image Factory"]

    %% Internal RHOAI Dependencies
    Notebooks -->|"CRD Watch<br/>deploys pods"| NotebookController["odh-notebook-controller"]
    Notebooks -->|"ImageStream<br/>discovery"| Dashboard["RHOAI Dashboard"]

    %% Build-time Dependencies
    Notebooks -->|"hermetic builds<br/>Cachi2"| Konflux["Konflux Pipeline"]
    Notebooks -->|"FIPS validation"| CheckPayload["check-payload"]

    %% Base Image
    Notebooks -->|"base image"| UBI9["UBI9 Base<br/>Python 3.12"]

    %% User-initiated Integration Points (from notebooks)
    Notebooks -.->|"kubernetes client<br/>HTTPS/443"| K8sAPI["Kubernetes API"]
    Notebooks -.->|"kfp SDK<br/>HTTPS/443"| KFP["KubeFlow Pipelines"]
    Notebooks -.->|"boto3<br/>HTTPS/443"| S3["S3 Storage"]
    Notebooks -.->|"mlflow client<br/>HTTP/HTTPS"| MLflow["MLflow Tracking"]
    Notebooks -.->|"codeflare-sdk<br/>HTTP/HTTPS"| CodeFlare["CodeFlare"]

    %% Platform Authentication
    NotebookController -->|"injects oauth-proxy"| OAuthProxy["OpenShift OAuth"]

    %% Key ML Framework Dependencies (bundled in images)
    subgraph "Bundled ML Frameworks"
        PyTorch["PyTorch 2.11.0"]
        TF["TensorFlow 2.21.0"]
        SKLearn["scikit-learn 1.9.0"]
        Transformers["transformers 5.10.1"]
        NumPy["NumPy 2.5.1"]
        Pandas["Pandas 2.3.3"]
    end

    Notebooks -->|"includes"| PyTorch
    Notebooks -->|"includes"| TF
    Notebooks -->|"includes"| SKLearn
    Notebooks -->|"includes"| Transformers
    Notebooks -->|"includes"| NumPy
    Notebooks -->|"includes"| Pandas

    %% Bundled Platform SDKs
    subgraph "Bundled Platform SDKs"
        KFPLib["kfp 2.17.0"]
        CFLib["codeflare-sdk 0.38.1"]
        MLflowLib["mlflow 3.14.0"]
        K8sLib["kubernetes 35.0.0"]
        Boto3Lib["boto3 1.43.60"]
    end

    Notebooks -->|"includes"| KFPLib
    Notebooks -->|"includes"| CFLib
    Notebooks -->|"includes"| MLflowLib
    Notebooks -->|"includes"| K8sLib
    Notebooks -->|"includes"| Boto3Lib

    style Notebooks fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style NotebookController fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style Konflux fill:#d79b00,stroke:#333,color:#fff
