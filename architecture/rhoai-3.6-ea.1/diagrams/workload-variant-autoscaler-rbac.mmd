graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(controller SA)"]
        SA_Prom["kube-prometheus-stack-prometheus<br/>(monitoring SA)"]
        SA_EPP["epp-metrics-reader<br/>(EPP metrics SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Metrics["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding"]
        RB_MetricsReader["metrics-reader-rolebinding<br/>(ns: workload-variant-autoscaler-monitoring)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_EPPReader["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["ConfigMaps<br/>get, list, watch"]
        ConfigMapsStatus["ConfigMaps/status<br/>get"]
        Namespaces["Namespaces<br/>get, list"]
        Nodes["Nodes, Nodes/status<br/>get, list, watch"]
        Pods["Pods<br/>get, list, watch"]
        ResourceQuotas["ResourceQuotas<br/>get, list, watch"]
        Services["Services<br/>get, list, watch"]
        Events["Events<br/>create, patch"]
    end

    subgraph AppsResources["apps API Resources"]
        Deployments["Deployments<br/>get, list, patch, update, watch"]
        DeploymentsScale["Deployments/scale<br/>get, update"]
        ReplicaSets["ReplicaSets<br/>get, list, watch"]
        StatefulSets["StatefulSets<br/>get, list, watch"]
    end

    subgraph AutoscalingResources["autoscaling API Resources"]
        HPAs["HorizontalPodAutoscalers<br/>get, list, patch, update, watch"]
    end

    subgraph InferenceResources["Inference API Resources"]
        InferencePools["InferencePools<br/>(inference.networking.k8s.io &<br/>inference.networking.x-k8s.io)<br/>get, list, watch"]
    end

    subgraph KEDAResources["KEDA API Resources"]
        ScaledObjects["ScaledObjects<br/>(keda.sh)<br/>get, list, patch, update, watch"]
    end

    subgraph LWSResources["LeaderWorkerSet Resources"]
        LWS["LeaderWorkerSets<br/>get, list, patch, update, watch"]
        LWSScale["LeaderWorkerSets/scale<br/>get, update"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["ServiceMonitors<br/>(monitoring.coreos.com)<br/>get, list, watch"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["TokenReviews<br/>(authentication.k8s.io)<br/>create"]
        SAReviews["SubjectAccessReviews<br/>(authorization.k8s.io)<br/>create"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        Leases["Leases<br/>(coordination.k8s.io)<br/>create, delete, get, list,<br/>patch, update, watch"]
        LEEvents["Events<br/>create, patch"]
    end

    %% SA → Binding → Role → Resources
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Metrics
    SA_CM -->|bound via| RB_Leader

    SA_Prom -->|bound via| RB_MetricsReader
    SA_EPP -->|bound via| CRB_EPP

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    RB_MetricsReader -->|grants| CR_MetricsReader
    CRB_EPP -->|grants| CR_EPPReader
    RB_Leader -->|grants| R_Leader

    %% manager-role permissions
    CR_Manager -->|access| ConfigMaps
    CR_Manager -->|access| ConfigMapsStatus
    CR_Manager -->|access| Namespaces
    CR_Manager -->|access| Nodes
    CR_Manager -->|access| Pods
    CR_Manager -->|access| ResourceQuotas
    CR_Manager -->|access| Services
    CR_Manager -->|access| Events
    CR_Manager -->|access| Deployments
    CR_Manager -->|access| DeploymentsScale
    CR_Manager -->|access| ReplicaSets
    CR_Manager -->|access| StatefulSets
    CR_Manager -->|access| HPAs
    CR_Manager -->|access| InferencePools
    CR_Manager -->|access| ScaledObjects
    CR_Manager -->|access| LWS
    CR_Manager -->|access| LWSScale
    CR_Manager -->|access| ServiceMonitors

    %% metrics-auth-role permissions
    CR_MetricsAuth -->|access| TokenReviews
    CR_MetricsAuth -->|access| SAReviews

    %% leader-election-role permissions
    R_Leader -->|access| Leases
    R_Leader -->|access| LEEvents

    %% Styling
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style SA_Prom fill:#4a90e2,stroke:#333,color:#fff
    style SA_EPP fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333
    style CR_MetricsReader fill:#f5a623,stroke:#333
    style CR_EPPReader fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style CRB_Manager fill:#e8e8e8,stroke:#333
    style CRB_Metrics fill:#e8e8e8,stroke:#333
    style CRB_EPP fill:#e8e8e8,stroke:#333
    style RB_Leader fill:#e8e8e8,stroke:#333
    style RB_MetricsReader fill:#e8e8e8,stroke:#333
