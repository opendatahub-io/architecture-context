        SA_CM["controller-manager"]
        SA_Prom["kube-prometheus-stack-prometheus"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Metrics["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_MetricsReader["metrics-reader-rolebinding<br/>(NS: workload-variant-autoscaler-monitoring)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph ManagerResources["manager-role Resources"]
        Core_RO["core (read-only)<br/>configmaps, namespaces,<br/>nodes, nodes/status, pods,<br/>resourcequotas, services<br/>→ get, list, watch"]
        Core_Status["core<br/>configmaps/status<br/>→ get"]
        Core_Events["core<br/>events<br/>→ create, patch"]
        Apps_Deploy["apps<br/>deployments<br/>→ get, list, patch,<br/>update, watch"]
        Apps_Scale["apps<br/>deployments/scale<br/>→ get, update"]
        Apps_RO["apps (read-only)<br/>replicasets, statefulsets<br/>→ get, list, watch"]
        Autoscaling["autoscaling<br/>horizontalpodautoscalers<br/>→ get, list, patch,<br/>update, watch"]
        Inference["inference.networking.k8s.io<br/>inference.networking.x-k8s.io<br/>inferencepools<br/>→ get, list, watch"]
        Keda["keda.sh<br/>scaledobjects<br/>→ get, list, patch,<br/>update, watch"]
        LWS_Full["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>→ get, list, patch,<br/>update, watch"]
        LWS_Scale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale<br/>→ get, update"]
        Monitoring["monitoring.coreos.com<br/>servicemonitors<br/>→ get, list, watch"]
    end

    subgraph MetricsAuthResources["metrics-auth-role Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>→ create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>→ create"]
    end

    subgraph LeaderResources["leader-election-role Resources"]
        Leases["coordination.k8s.io<br/>leases<br/>→ create, delete, get,<br/>list, patch, update, watch"]
        LeaderEvents["core<br/>events<br/>→ create, patch"]
    end

