graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS Termination"]
    end

    subgraph Pod["POD (StatefulSet)"]
        direction TB

        OAuthProxy["oauth-proxy sidecar<br/>8443/TCP<br/>OpenShift OAuth<br/>Injected by odh-notebook-controller"]

        Notebook["JupyterLab / Code Server<br/>8888/TCP HTTP<br/>No built-in auth<br/>UBI9 + Python 3.12"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Internal)"]
        Controller["odh-notebook-controller<br/>Watches Notebook CRs<br/>Creates StatefulSets"]
        Dashboard["RHOAI Dashboard<br/>ImageStream discovery<br/>Creates Notebook CRs"]
    end

    subgraph UserInitiated["USER-INITIATED OUTBOUND (from notebook cells)"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>ServiceAccount"]
        KFP["KubeFlow Pipelines<br/>443/TCP HTTPS<br/>TLS<br/>Bearer Token"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM / AccessKey"]
        MLflow["MLflow Tracking<br/>HTTP/HTTPS<br/>Configurable<br/>Token Auth"]
        CodeFlareService["CodeFlare<br/>HTTP/HTTPS<br/>Configurable<br/>Token Auth"]
    end

    subgraph BuildTime["BUILD-TIME ONLY (not in runtime)"]
        Konflux["Konflux Pipeline<br/>Hermetic builds (Cachi2)"]
        CheckPayload["check-payload<br/>FIPS validation<br/>Go static binary"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS<br/>OAuth redirect"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth token"| OAuthProxy
    OAuthProxy -->|"HTTP/8888<br/>No encryption (pod-local)<br/>Trusted (validated)"| Notebook

    Controller -->|"Watches CRs<br/>Creates pods"| Pod
    Dashboard -->|"Creates<br/>Notebook CRs"| Controller

    Notebook -->|"HTTPS/443<br/>TLS<br/>ServiceAccount"| K8sAPI
    Notebook -->|"HTTPS/443<br/>TLS<br/>Bearer"| KFP
    Notebook -->|"HTTPS/443<br/>TLS<br/>IAM"| S3
    Notebook -->|"HTTP/HTTPS<br/>Configurable<br/>Token"| MLflow
    Notebook -->|"HTTP/HTTPS<br/>Configurable<br/>Token"| CodeFlareService

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef outbound fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef buildtime fill:#e8e8e8,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class Route ingress
    class OAuthProxy,Notebook pod
    class Controller,Dashboard platform
    class K8sAPI,KFP,S3,MLflow,CodeFlareService outbound
    class Konflux,CheckPayload buildtime
