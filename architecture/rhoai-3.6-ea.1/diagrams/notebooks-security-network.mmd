graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>/notebook/&lt;project&gt;/&lt;name&gt;/*<br/>443/TCP<br/>TLS edge/reencrypt"]
    end

    subgraph AuthLayer["AUTHENTICATION (oauth-proxy sidecar)"]
        OAuthProxy["oauth-proxy<br/>8443/TCP<br/>OpenShift OAuth validation<br/>Injected by odh-notebook-controller"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (StatefulSet)"]
        direction TB

        subgraph JupyterPath["JupyterLab Path"]
            JupyterLab["JupyterLab ServerApp<br/>8888/TCP HTTP<br/>Auth: DISABLED<br/>token='' password=''"]
        end

        subgraph CodeServerPath["code-server Path"]
            Nginx["nginx Reverse Proxy<br/>8787/TCP HTTP"]
            CodeServer["code-server"]
            CullingCGI["httpd + access.cgi<br/>/api/kernels/ shim"]
        end
    end

    subgraph ControlPlane["PLATFORM CONTROL PLANE"]
        Controller["odh-notebook-controller<br/>Manages StatefulSets<br/>Injects oauth-proxy<br/>Polls idle culling"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>ServiceAccount Token"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM Credentials"]
    end

    %% User access flow
    User -->|"HTTPS/443<br/>TLS<br/>OAuth Token"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth validation"| OAuthProxy
    OAuthProxy -->|"HTTP/8888<br/>No encryption (pod-internal)<br/>No auth (delegated)"| JupyterLab
    OAuthProxy -->|"HTTP/8787<br/>No encryption (pod-internal)<br/>No auth (delegated)"| Nginx

    %% code-server internals
    Nginx --> CodeServer
    Nginx --> CullingCGI

    %% Controller management
    Controller -->|"manages"| WorkbenchPod
    Controller -->|"polls /api/kernels/<br/>idle culling"| JupyterLab
    Controller -->|"polls /api/kernels/<br/>idle culling"| CullingCGI

    %% Outbound from workbench
    JupyterLab -->|"HTTPS/443<br/>TLS<br/>ServiceAccount Token"| K8sAPI
    JupyterLab -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3
    CodeServer -->|"HTTPS/443<br/>TLS<br/>ServiceAccount Token"| K8sAPI
    CodeServer -->|"HTTPS/443<br/>TLS<br/>AWS IAM"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy auth
    class JupyterLab,Nginx,CodeServer,CullingCGI workbench
    class Controller controlplane
    class K8sAPI,S3 externalservice
