graph TB
    subgraph Clients["CLIENTS (Internal Platform Services)"]
        DSP["Data Science Pipelines<br/>(Pipeline Orchestrator)"]
        PythonClient["Python Client<br/>(ml_metadata package)"]
    end

    subgraph Application["APPLICATION (ml-metadata Server)"]
        direction TB
        subgraph ServerPod["Pod: metadata_store_server"]
            Server["metadata_store_server<br/>C++ binary (Bazel-built)<br/>User: 65534 (non-root)<br/>Image: ubi9-minimal<br/>Port: 8080/TCP gRPC"]
        end

        subgraph TLSConfig["TLS Configuration (Optional)"]
            SSLConfig["MetadataStoreServerConfig.SSLConfig<br/>- Server key/cert<br/>- Custom CA<br/>- Client cert verification"]
        end
    end

    subgraph DataStore["DATA STORE"]
        MariaDB["MariaDB/MySQL<br/>3306/TCP<br/>MySQL wire protocol<br/>SSL configurable"]
    end

    %% Flows
    DSP -->|"gRPC/8080<br/>HTTP/2<br/>No encryption by default<br/>No auth (platform-delegated)"| Server
    PythonClient -->|"gRPC/8080<br/>HTTP/2<br/>No encryption by default<br/>No auth"| Server
    Server -->|"MySQL wire protocol/3306<br/>SSL configurable<br/>DB credentials"| MariaDB
    SSLConfig -.->|"Optional mTLS"| Server

    %% Styling
    classDef client fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef tlsconfig fill:#e1d5e7,stroke:#9673a6,stroke-width:1px,stroke-dasharray:5

    class DSP,PythonClient client
    class Server application
    class MariaDB datastore
    class SSLConfig tlsconfig
