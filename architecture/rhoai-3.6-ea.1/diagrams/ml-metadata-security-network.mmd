graph TB
    subgraph InternalClients["INTERNAL CLIENTS (Platform Services)"]
        PipelineComp["Pipeline Components<br/>(DSP Workers / Argo Steps)"]
        PythonClient["ml_metadata Python Client"]
    end

    subgraph MLMDService["ML METADATA SERVICE"]
        direction TB
        Server["metadata_store_server<br/>C++ gRPC Binary<br/>Port: 8080/TCP<br/>Protocol: gRPC (HTTP/2)<br/>TLS: Optional (SSLConfig)<br/>mTLS: Optional (client_verify)<br/>Auth: None (platform-delegated)"]
    end

    subgraph DatabaseBackend["DATABASE BACKEND"]
        MySQL["MySQL / MariaDB<br/>Port: 3306/TCP<br/>Protocol: MySQL wire protocol<br/>SSL: Optional (SSLOptions)<br/>Connector: mariadb-connector-c<br/>Crypto: System OpenSSL"]
    end

    subgraph DeploymentMgmt["DEPLOYMENT MANAGEMENT"]
        DSPOperator["Data Science Pipelines Operator<br/>Deploys & configures MLMD<br/>Provisions credentials & TLS certs"]
    end

    %% Client flows
    PipelineComp -->|"gRPC/8080<br/>HTTP/2<br/>No encryption by default<br/>TLS optional via SSLConfig<br/>Auth: None (platform-delegated)"| Server
    PythonClient -->|"gRPC/8080<br/>HTTP/2<br/>Same as above"| Server

    %% Database flow
    Server -->|"MySQL/3306<br/>MySQL wire protocol<br/>SSL optional (SSLOptions)<br/>Auth: MySQL credentials"| MySQL

    %% Deployment
    DSPOperator -.->|"manages deployment<br/>provisions secrets"| Server

    %% Styling
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef database fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class PipelineComp,PythonClient internal
    class Server service
    class MySQL database
    class DSPOperator operator
