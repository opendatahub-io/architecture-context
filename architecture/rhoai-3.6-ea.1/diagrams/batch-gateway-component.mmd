graph TB
    subgraph "batch-gateway Platform"
        subgraph "API Server"
            APIServer["batch-gateway-apiserver<br/>Go HTTP Service"]
            Middleware["Middleware Chain<br/>Panic Recovery · Request ID<br/>Tenant Context · Metrics · Tracing<br/>Security Headers"]
            TLS["TLS Termination<br/>TLS 1.2+ · FIPS Cipher Suites<br/>ALPN h2/HTTP1.1"]
            ObsServer["Observability Server<br/>Plain HTTP<br/>/health · /ready · /metrics"]
            APIServer --> Middleware
            APIServer -->|optional| TLS
            APIServer --> ObsServer
        end

        subgraph "Batch Processor"
            Processor["batch-gateway-processor<br/>Go Background Worker"]
            TaskConsumer["Task Consumer<br/>llm-d-async"]
            HTTPDispatcher["HTTP Dispatcher<br/>Inference Requests"]
            ProcObs["Observability Server<br/>/ready · /metrics · /health"]
            Processor --> TaskConsumer
            Processor --> HTTPDispatcher
            Processor --> ProcObs
        end

        subgraph "Garbage Collector"
            GC["batch-gateway-gc<br/>Go Background Worker"]
            Scanner["Expiry Scanner<br/>Periodic Job Cleanup"]
            GCObs["Observability Server<br/>/health · /metrics"]
            GC --> Scanner
            GC --> GCObs
        end
    end

    Client[External Client] -->|REST API<br/>POST/GET/DELETE| APIServer
    APIServer -->|job metadata| PostgreSQL[(PostgreSQL)]
    APIServer -->|input files| S3[(S3-Compatible Storage)]
    APIServer -->|async tasks| Redis[(Redis/Valkey)]

    TaskConsumer -->|poll tasks| Redis
    HTTPDispatcher -->|HTTP/HTTPS<br/>inference requests| LLMd["llm-d Inference Gateway"]
    Processor -->|results| S3
    Processor -->|job state| PostgreSQL

    Scanner -->|scan expired jobs| PostgreSQL
    Scanner -->|remove files| S3

    APIServer -->|OTLP/gRPC traces| OTel["OpenTelemetry Collector"]
    Processor -->|OTLP/gRPC traces| OTel
    GC -->|OTLP/gRPC traces| OTel

    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Processor fill:#4a90e2,stroke:#333,color:#fff
    style GC fill:#4a90e2,stroke:#333,color:#fff
