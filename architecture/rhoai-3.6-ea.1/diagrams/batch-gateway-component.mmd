    style TLS fill:#6ba3d6,stroke:#333
    style ObsServer fill:#6ba3d6,stroke:#333
    style TaskConsumer fill:#6ba3d6,stroke:#333
    style HTTPDispatcher fill:#6ba3d6,stroke:#333
    style ProcObs fill:#6ba3d6,stroke:#333
    style Scanner fill:#6ba3d6,stroke:#333
    style GCObs fill:#6ba3d6,stroke:#333
    style PostgreSQL fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style Redis fill:#f5a623,stroke:#333
