graph TD
    subgraph "Argo Workflows Authentication & Authorization"
        direction TB

        subgraph "Auth Modes (Gatekeeper)"
            GK["gRPC Gatekeeper<br/>Unary + Stream Interceptors"]

            subgraph "Client Mode"
                ClientAuth["Bearer / Basic Token<br/>Delegated to K8s API<br/>User-Impersonated Operations"]
            end

            subgraph "Server Mode"
                ServerAuth["argo-server ServiceAccount<br/>Direct SA Auth<br/>Server-Scoped Operations"]
            end

            subgraph "SSO Mode"
                SSOAuth["OIDC Token Validation<br/>Annotation-Based RBAC<br/>Maps to Namespace SA"]
            end

            GK -->|delegates| ClientAuth
            GK -->|uses| ServerAuth
            GK -->|validates| SSOAuth
        end

        subgraph "Authorization Checks"
            SSAR["SelfSubjectAccessReview<br/>authorization/v1"]
        end

        subgraph "CRD API Resources (argoproj.io/v1alpha1)"
            Workflow["Workflow<br/>(Namespaced)"]
            CronWorkflow["CronWorkflow<br/>(Namespaced)"]
            WFTemplate["WorkflowTemplate<br/>(Namespaced)"]
            ClusterWFTemplate["ClusterWorkflowTemplate<br/>(Cluster)"]
            WFEventBinding["WorkflowEventBinding<br/>(Namespaced)"]
            WFArtifactGC["WorkflowArtifactGCTask<br/>(Namespaced)"]
            WFTaskResult["WorkflowTaskResult<br/>(Namespaced)"]
            WFTaskSet["WorkflowTaskSet<br/>(Namespaced)"]
        end

        subgraph "Core API Resources"
            Pods["core/v1<br/>Pods"]
            ConfigMaps["core/v1<br/>ConfigMaps"]
            Secrets["core/v1<br/>Secrets"]
            PDBs["policy/v1<br/>PodDisruptionBudgets"]
        end

        subgraph "Unauthenticated Endpoints"
            HealthZ["/healthz<br/>Port 6060/TCP<br/>workflow-controller<br/>No Auth Required"]
        end

        GK -->|verifies access via| SSAR

        ClientAuth -->|"CRUD"| Workflow
        ClientAuth -->|"CRUD"| CronWorkflow
        ClientAuth -->|"CRUD"| WFTemplate
        ClientAuth -->|"CRUD"| ClusterWFTemplate

        ServerAuth -->|"create, manage"| Pods
        ServerAuth -->|"create, update"| ConfigMaps
        ServerAuth -->|"read"| Secrets
        ServerAuth -->|"create"| PDBs
    end

    %% Note: RBAC ClusterRoles and RoleBindings are not explicitly
    %% defined in the extracted architecture; RBAC is enforced
    %% dynamically through the Gatekeeper's token delegation
    %% and SelfSubjectAccessReview checks.

    style GK fill:#e8544e,stroke:#333,color:#fff
    style ClientAuth fill:#4a90e2,stroke:#333,color:#fff
    style ServerAuth fill:#4a90e2,stroke:#333,color:#fff
    style SSOAuth fill:#4a90e2,stroke:#333,color:#fff
    style SSAR fill:#f5a623,stroke:#333
    style HealthZ fill:#7ed321,stroke:#333
    style Workflow fill:#fff2cc,stroke:#d6b656
    style CronWorkflow fill:#fff2cc,stroke:#d6b656
    style WFTemplate fill:#fff2cc,stroke:#d6b656
    style ClusterWFTemplate fill:#fff2cc,stroke:#d6b656
    style WFEventBinding fill:#fff2cc,stroke:#d6b656
    style WFArtifactGC fill:#fff2cc,stroke:#d6b656
    style WFTaskResult fill:#fff2cc,stroke:#d6b656
    style WFTaskSet fill:#fff2cc,stroke:#d6b656
    style Pods fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets fill:#e8e8e8,stroke:#333
    style PDBs fill:#e8e8e8,stroke:#333
