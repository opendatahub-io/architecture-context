graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Agent["AI Agent Client"]
    end

    subgraph ServiceBoundary["SERVICE BOUNDARY (rhoai-mcp namespace)"]
        direction TB

        Service["rhoai-mcp Service<br/>ClusterIP 8000/TCP"]

        subgraph Deployment["rhoai-mcp Deployment"]
            direction TB
            AuthMW["OIDCAuthMiddleware<br/>(ASGI)<br/>JWT/JWKS or TokenReview<br/>Excludes: /health"]
            MCPServer["RHOAIServer<br/>(FastMCP Runtime)<br/>RBAC tool filtering<br/>User impersonation"]

            AuthMW -->|UserContext| MCPServer
        end

        subgraph ContainerSecurity["Container Security"]
            direction LR
            NonRoot["UID 1000<br/>(non-root)"]
            ReadOnly["ReadOnly<br/>rootfs"]
            NoCaps["Capabilities<br/>ALL dropped"]
            Seccomp["Seccomp<br/>RuntimeDefault"]
        end

        Service --> AuthMW
    end

    subgraph Downstream["DOWNSTREAM (Cluster Internal)"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token / Impersonation"]

        subgraph CRDs["RHOAI CRDs via K8s API"]
            direction LR
            Notebooks["Notebooks<br/>(kubeflow.org)"]
            InfSvc["InferenceServices<br/>(serving.kserve.io)"]
            TrainJobs["TrainJobs<br/>(trainer.kubeflow.org)"]
            DSPApps["DSPApplications<br/>(opendatahub.io)"]
        end

        ModelReg["Model Registry<br/>8080/TCP HTTP<br/>Internal service"]
    end

    subgraph Unauthenticated["UNAUTHENTICATED ENDPOINTS"]
        Health["/health<br/>K8s probes"]
        WellKnown["/.well-known/oauth-<br/>protected-resource<br/>RFC 9728"]
    end

    %% Flows
    Agent -->|"MCP (SSE/HTTP)<br/>8000/TCP<br/>Bearer JWT or TokenReview<br/>(OIDC configurable)"| Service

    MCPServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token or Impersonation"| K8sAPI
    K8sAPI --> Notebooks
    K8sAPI --> InfSvc
    K8sAPI --> TrainJobs
    K8sAPI --> DSPApps

    MCPServer -->|"HTTP/8080<br/>Internal"| ModelReg

    Agent -.->|"GET (no auth)"| Health
    Agent -.->|"GET (no auth)"| WellKnown

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef boundary fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef auth fill:#fee2e2,stroke:#ef4444,stroke-width:2px
    classDef server fill:#dbeafe,stroke:#2563eb,stroke-width:2px
    classDef downstream fill:#d1fae5,stroke:#10b981,stroke-width:2px
    classDef crd fill:#fef3c7,stroke:#f59e0b,stroke-width:1px
    classDef unauth fill:#f3f4f6,stroke:#9ca3af,stroke-width:1px,stroke-dasharray: 5 5
    classDef security fill:#f0fdf4,stroke:#22c55e,stroke-width:1px

    class Agent external
    class Service boundary
    class AuthMW auth
    class MCPServer server
    class K8sAPI downstream
    class Notebooks,InfSvc,TrainJobs,DSPApps crd
    class ModelReg downstream
    class Health,WellKnown unauth
    class NonRoot,ReadOnly,NoCaps,Seccomp security
