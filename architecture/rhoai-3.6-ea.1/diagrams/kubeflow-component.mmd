graph TB
    subgraph KubeflowComponent["Kubeflow Notebook Controllers"]
        direction TB

        subgraph UpstreamCtrl["Upstream notebook-controller"]
            NotebookReconciler["NotebookReconciler<br/>/manager"]
            CullingReconciler["CullingReconciler<br/>Idle workbench culling"]
            NotebookReconciler -->|manages lifecycle| CullingReconciler
        end

        subgraph ODHCtrl["ODH notebook-controller"]
            OpenshiftReconciler["OpenshiftNotebookReconciler<br/>/manager"]
            MutatingWebhook["Mutating Webhook<br/>/mutate-notebook-v1<br/>Port 8443/TLS"]
            ValidatingWebhook["Validating Webhook<br/>/validate-notebook-v1<br/>Port 8443/TLS"]
            ConversionWebhook["Conversion Webhook<br/>/convert<br/>Port 8443/TLS"]
            OpenshiftReconciler --- MutatingWebhook
            OpenshiftReconciler --- ValidatingWebhook
            OpenshiftReconciler --- ConversionWebhook
        end
    end

    User["Data Scientist / User"] -->|creates| NotebookCR["Notebook CR<br/>kubeflow.org/v1"]

    NotebookCR -->|intercepted by| MutatingWebhook
    MutatingWebhook -->|injects kube-rbac-proxy<br/>sidecar + proxy env vars| NotebookCR

    NotebookCR -->|watched by| NotebookReconciler
    NotebookReconciler -->|creates| StatefulSet["StatefulSet"]
    NotebookReconciler -->|creates| Service["Service"]

    NotebookCR -->|watched by| OpenshiftReconciler
    OpenshiftReconciler -->|creates| HTTPRoute["HTTPRoute<br/>/notebook/ns/name"]
    OpenshiftReconciler -->|creates| NetworkPolicy["NetworkPolicy"]
    OpenshiftReconciler -->|creates| ReferenceGrant["ReferenceGrant"]
    OpenshiftReconciler -->|optionally creates| ElyraSecret["Elyra Pipeline Secret"]

    CullingReconciler -->|monitors activity<br/>deletes idle pods| StatefulSet

    HTTPRoute -->|references| Gateway["data-science-gateway<br/>openshift-ingress"]

    OpenshiftReconciler -->|reads| DSPA["DataSciencePipelinesApplication CR"]
    OpenshiftReconciler -->|reads| ImageStreams["OpenShift ImageStreams"]
    OpenshiftReconciler -->|reads| ProxyConfig["OpenShift Proxy Config"]

    style NotebookReconciler fill:#4a90e2,stroke:#333
    style CullingReconciler fill:#4a90e2,stroke:#333
    style OpenshiftReconciler fill:#4a90e2,stroke:#333
    style MutatingWebhook fill:#e8544e,stroke:#333
    style ValidatingWebhook fill:#e8544e,stroke:#333
    style ConversionWebhook fill:#e8544e,stroke:#333
    style NotebookCR fill:#f5a623,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style ReferenceGrant fill:#7ed321,stroke:#333
    style ElyraSecret fill:#7ed321,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style DSPA fill:#e8e8e8,stroke:#333
    style ImageStreams fill:#e8e8e8,stroke:#333
    style ProxyConfig fill:#e8e8e8,stroke:#333
    style StatefulSet fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
