graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client[External Client]
    end

    subgraph Ingress["INGRESS (Gateway Layer)"]
        direction TB
        KServeGW["KServe Inference Gateway<br/>TLS enabled (rhai-ca-issuer)<br/>allowedRoutes: Same namespace"]
        MaaSGW["MaaS Gateway (optional)<br/>TLS configurable issuerRef<br/>allowedRoutes: Same (default)"]
    end

    subgraph AuthZ["AUTHORIZATION (Policy Enforcement)"]
        Authorino["Authorino (rhcl-operator)<br/>Cluster-wide enforcement<br/>TLS-enabled listener<br/>Cert: authorino-server-cert"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        direction TB
        RHAI["RHAI Operator<br/>opendatahub-operator"]
        KServe["KServe Inference Service<br/>TLS configurable"]
        AIGateway["AIGateway (optional)<br/>Models-as-a-Service<br/>TLS configurable"]
    end

    subgraph CertLayer["CERTIFICATE MANAGEMENT"]
        CertMgr["cert-manager<br/>rhai-ca-issuer ClusterIssuer"]
    end

    subgraph Dependencies["DEPENDENCY OPERATORS"]
        direction LR
        Kueue[kueue-operator]
        Observability[cluster-observability]
        OTel[opentelemetry]
        LWS[leader-worker-set]
        JobSet[job-set-operator]
        Tempo[tempo-product]
        CMA[custom-metrics-autoscaler]
    end

    subgraph MeshLayer["SERVICE MESH (XKS only)"]
        Sail["sail-operator<br/>Istio mTLS"]
        GatewayAPI["gateway-api<br/>CRDs + Controller"]
    end

    subgraph Cloud["CLOUD PROVIDERS (XKS Targets)"]
        direction LR
        Azure["Azure AKS"]
        CoreWeave["CoreWeave"]
        AWS["AWS EKS"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS 1.2+<br/>Bearer / Client Cert"| KServeGW
    Client -->|"HTTPS<br/>TLS 1.2+<br/>Bearer / Client Cert"| MaaSGW
    KServeGW -->|"TLS client cert<br/>Policy check"| Authorino
    MaaSGW -->|"TLS client cert<br/>Policy check"| Authorino
    KServeGW -->|"Authorized traffic"| KServe
    MaaSGW -->|"Authorized traffic"| AIGateway

    CertMgr -->|"Issue certs"| KServeGW
    CertMgr -->|"Issue certs"| MaaSGW
    CertMgr -->|"authorino-server-cert"| Authorino

    RHAI -->|"Post-install hooks"| KServe
    RHAI -->|"Post-install hooks"| AIGateway

    Sail -->|"mTLS mesh"| KServeGW
    GatewayAPI -->|"CRDs"| KServeGW

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authz fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cert fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef deps fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef mesh fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef cloud fill:#e8e8e8,stroke:#666,stroke-width:1px

    class Client external
    class KServeGW,MaaSGW ingress
    class Authorino authz
    class RHAI,KServe,AIGateway platform
    class CertMgr cert
    class Kueue,Observability,OTel,LWS,JobSet,Tempo,CMA deps
    class Sail,GatewayAPI mesh
    class Azure,CoreWeave,AWS cloud
