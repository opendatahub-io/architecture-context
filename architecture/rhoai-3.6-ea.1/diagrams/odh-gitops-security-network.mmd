graph TB
    subgraph ConfigRepo["CONFIGURATION LAYER (odh-gitops)"]
        direction TB
        OCPChart["rhai-on-openshift-chart<br/>(Helm Chart)"]
        XKSChart["rhai-on-xks-chart<br/>(Helm Chart)"]
        KustomizeSubs["Kustomize Subscriptions<br/>(OLM Operator Manifests)"]
    end

    subgraph GatewayLayer["GATEWAY LAYER (Configured Resources)"]
        direction LR
        KServeGW["KServe Inference Gateway<br/>443/TCP HTTPS<br/>GatewayClass: openshift.io/gateway-controller/v1<br/>Auth: Authorino TLS Bootstrap"]
        MaaSGW["MaaS Gateway<br/>443/TCP HTTPS<br/>GatewayClass: openshift.io/gateway-controller/v1<br/>Auth: Authorino TLS Bootstrap"]
    end

    subgraph PolicyLayer["POLICY LAYER (Configured Resources)"]
        KuadrantCR["Kuadrant CR<br/>Namespace: kuadrant-system<br/>API Policy Management<br/>Rate Limiting"]
    end

    subgraph OLMLayer["OLM SUBSCRIPTION LAYER (OpenShift)"]
        direction TB
        subgraph SecurityOps["Security & Certificates"]
            CertMgr["cert-manager-operator<br/>TLS Certificate Provisioning"]
            RHCL["rhcl-operator<br/>Kuadrant API Policy"]
        end
        subgraph WorkloadOps["Workload Management"]
            Kueue["kueue-operator<br/>Job Queuing"]
            JobSet["job-set-operator<br/>Training Workloads"]
            CMA["custom-metrics-autoscaler<br/>KServe Autoscaling"]
        end
        subgraph ObsOps["Observability"]
            ClusterObs["cluster-observability-operator<br/>Monitoring"]
            OTel["opentelemetry-product<br/>Distributed Tracing"]
            Tempo["tempo-product<br/>Trace Storage"]
        end
    end

    subgraph XKSLayer["HELM DEPENDENCY LAYER (Non-OpenShift)"]
        direction LR
        CertMgrHelm["cert-manager"]
        GatewayAPIHelm["gateway-api CRDs"]
        SailHelm["sail-operator<br/>(Istio)"]
        RHCLHelm["rhcl-operator"]
        LWSHelm["lws-operator"]
        RHAIHelm["rhai-operator"]
    end

    subgraph CatalogSources["OPERATOR CATALOG SOURCES"]
        RedHatOps["redhat-operators<br/>openshift-marketplace"]
        CommunityOps["community-operators<br/>openshift-marketplace"]
    end

    %% Configuration flows
    OCPChart -->|templates| KServeGW
    OCPChart -->|templates| MaaSGW
    OCPChart -->|templates| KuadrantCR
    KustomizeSubs -->|subscribes| CertMgr
    KustomizeSubs -->|subscribes| RHCL
    KustomizeSubs -->|subscribes| Kueue
    KustomizeSubs -->|subscribes| JobSet
    KustomizeSubs -->|subscribes| CMA
    KustomizeSubs -->|subscribes| ClusterObs
    KustomizeSubs -->|subscribes| OTel
    KustomizeSubs -->|subscribes| Tempo

    XKSChart -->|installs| CertMgrHelm
    XKSChart -->|installs| GatewayAPIHelm
    XKSChart -->|installs| SailHelm
    XKSChart -->|installs| RHCLHelm
    XKSChart -->|installs| LWSHelm
    XKSChart -->|installs| RHAIHelm

    %% Catalog sources
    CertMgr -.->|resolves from| RedHatOps
    RHCL -.->|resolves from| RedHatOps
    Kueue -.->|resolves from| RedHatOps
    JobSet -.->|resolves from| RedHatOps

    %% Auth annotation
    KServeGW -.->|"security.opendatahub.io/<br/>authorino-tls-bootstrap"| Authorino["Authorino<br/>TLS Auth Provider"]
    MaaSGW -.->|"security.opendatahub.io/<br/>authorino-tls-bootstrap"| Authorino

    %% Styling
    classDef config fill:#4a90e2,stroke:#333,color:#fff,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef policy fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef helmDep fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef catalog fill:#f9f9f9,stroke:#999,stroke-width:1px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class OCPChart,XKSChart,KustomizeSubs config
    class KServeGW,MaaSGW gateway
    class KuadrantCR policy
    class CertMgr,RHCL,Kueue,JobSet,CMA,ClusterObs,OTel,Tempo operator
    class CertMgrHelm,GatewayAPIHelm,SailHelm,RHCLHelm,LWSHelm,RHAIHelm helmDep
    class RedHatOps,CommunityOps catalog
    class Authorino auth
