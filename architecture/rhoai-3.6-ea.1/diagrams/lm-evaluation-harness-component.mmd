graph TB
    subgraph "TrustyAI Operator"
        Operator[TrustyAI Service Operator]
    end

    subgraph "lm-evaluation-harness (Kubernetes Job)"
        direction TB
        Entrypoint["/opt/app-root/bin/python<br/>Container Entrypoint"]
        CLI["lm-eval CLI<br/>lm_eval.__main__:cli_evaluate"]
        Entrypoint --> CLI

        subgraph "Model Backends (Plugin-based)"
            OpenAI["openai<br/>OpenAI Completions"]
            Anthropic["anthropic-chat-completions<br/>Anthropic LLMs"]
            WatsonX["watsonx_llm<br/>IBM watsonx AI"]
            LocalChat["local-chat-completions<br/>OpenAI-compatible Endpoint"]
        end

        subgraph "Evaluation Framework"
            LMEval["lm_eval<br/>Python Package"]
            Unitxt["Unitxt Catalog<br/>Standardized Tasks"]
        end

        CLI --> LMEval
        LMEval --> Unitxt
        LMEval --> OpenAI
        LMEval --> Anthropic
        LMEval --> WatsonX
        LMEval --> LocalChat
    end

    Operator -->|"creates Job with<br/>env vars & args"| Entrypoint

    OpenAI -->|"HTTPS/443<br/>OPENAI_API_KEY"| OpenAIAPI["OpenAI API"]
    Anthropic -->|"HTTPS/443<br/>ANTHROPIC_API_KEY"| AnthropicAPI["Anthropic API"]
    WatsonX -->|"HTTPS/443<br/>WATSONX_API_KEY"| WatsonXAPI["IBM watsonx API"]
    LocalChat -->|"HTTP(S)<br/>configured endpoint"| ServingRuntime["Model Serving Runtime<br/>(vLLM / Caikit)"]

    LMEval -->|"HTTPS/443<br/>HF_TOKEN"| HuggingFace["Hugging Face Hub<br/>Datasets & Models"]
    LMEval -->|"HTTPS/443<br/>AWS credentials"| S3["S3-Compatible Storage"]
    LMEval -->|"Filesystem"| Output["/opt/app-root/src/output<br/>Evaluation Results"]

