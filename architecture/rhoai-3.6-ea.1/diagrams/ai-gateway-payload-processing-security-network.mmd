graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS"]
        Anthropic["Anthropic API<br/>api.anthropic.com<br/>443/TCP HTTPS"]
        Bedrock["AWS Bedrock<br/>bedrock-runtime.*.amazonaws.com<br/>443/TCP HTTPS"]
        Azure["Azure OpenAI<br/>*.openai.azure.com<br/>443/TCP HTTPS"]
        VertexAI["Vertex AI<br/>*.googleapis.com<br/>443/TCP HTTPS"]
    end

    subgraph MeshEgress["SERVICE MESH EGRESS (Istio)"]
        ServiceEntry["Istio ServiceEntry<br/>MESH_EXTERNAL<br/>DNS Resolution"]
        DestRule["Istio DestinationRule<br/>TLS Mode: SIMPLE"]
        ExtSvc["ExternalName Service<br/>Port: 443/TCP"]
    end

    subgraph GatewayZone["GATEWAY (openshift-ingress)"]
        Gateway["maas-default-gateway<br/>Gateway API<br/>Timeout: 300s"]
        Route["HTTPRoute<br/>Path: /&lt;ns&gt;/&lt;model&gt;<br/>Header: Selected-Provider"]
    end

    subgraph PluginZone["PAYLOAD PROCESSING"]
        Resolver["model-provider-resolver"]
        Translator["API Translation"]
        Injector["API Key Injection"]
    end

    subgraph ControllerZone["CONTROLLER PLANE"]
        Operator["ai-gateway-payload-processing<br/>Operator<br/>FIPS: strictfipsruntime"]
        Secrets["Kubernetes Secrets<br/>anthropic-credentials<br/>azure-credentials<br/>openai-credentials<br/>vertex-credentials"]
    end

    subgraph K8sPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+"]
    end

    %% Controller flows
    Operator -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount| K8sAPI
    K8sAPI -.->|Watch events<br/>ExternalProvider/ExternalModel| Operator
    Operator -->|validates| Secrets

    %% Operator creates mesh resources
    Operator -->|creates| ExtSvc
    Operator -->|creates| ServiceEntry
    Operator -->|creates| DestRule
    Operator -->|creates| Route

    %% Request flow
    Gateway --> Route
    Route --> PluginZone
    Resolver --> Translator
    Translator --> Injector
    Injector -->|reads credentials| Secrets

    %% Egress flow
    Injector --> ExtSvc
    ExtSvc --> ServiceEntry
    ServiceEntry --> DestRule
    DestRule -->|TLS SIMPLE<br/>API Key/SigV4/OAuth2| OpenAI
    DestRule -->|TLS SIMPLE<br/>API Key| Anthropic
    DestRule -->|TLS SIMPLE<br/>SigV4| Bedrock
    DestRule -->|TLS SIMPLE<br/>API Key/OAuth2| Azure
    DestRule -->|TLS SIMPLE<br/>OAuth2| VertexAI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef meshegress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef plugin fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class OpenAI,Anthropic,Bedrock,Azure,VertexAI external
    class ServiceEntry,DestRule,ExtSvc meshegress
    class Gateway,Route gateway
    class Resolver,Translator,Injector plugin
    class Operator controller
    class K8sAPI k8s
    class Secrets secret
