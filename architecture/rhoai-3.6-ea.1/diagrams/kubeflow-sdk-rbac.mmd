graph TD
    subgraph "SDK Authentication"
        direction TB
        ExtAuth["External Access<br/>(kubeconfig)"]
        InCluster["In-Cluster Access<br/>(ServiceAccount Token)"]
    end

    subgraph "kubernetes Python Client"
        LoadKubeConfig["load_kube_config()"]
        LoadInCluster["load_incluster_config()"]
        ApiClient["ApiClient<br/>(configured)"]
    end

    subgraph "Required Cluster RBAC (Not Defined by SDK)"
        direction TB
        Note["SDK defines NO ClusterRoles<br/>Consumer must provision RBAC"]

        subgraph "Required Permissions on Kubeflow CRDs"
            TrainJobs["kubeflow.org<br/>TrainJob<br/>get, list, watch,<br/>create, update, delete"]
            KatibExps["kubeflow.org<br/>Experiment<br/>get, list, watch,<br/>create, update, delete"]
            SparkConnects["sparkoperator.k8s.io<br/>SparkConnect<br/>get, list, watch,<br/>create, update, delete"]
        end

        subgraph "Required Permissions on Core Resources"
            ConfigMaps["core<br/>ConfigMaps<br/>get (kubeflow-system ns)"]
        end
    end

    subgraph "Kubernetes API Server"
        RBAC["RBAC Authorization"]
    end

    ExtAuth -->|"client cert / token"| LoadKubeConfig
    InCluster -->|"SA token mount"| LoadInCluster
    LoadKubeConfig --> ApiClient
    LoadInCluster --> ApiClient
    ApiClient -->|"authenticated requests"| RBAC
    RBAC -->|"authorize"| TrainJobs
    RBAC -->|"authorize"| KatibExps
    RBAC -->|"authorize"| SparkConnects
    RBAC -->|"authorize"| ConfigMaps

    style ExtAuth fill:#4a90e2,stroke:#333,color:#fff
    style InCluster fill:#4a90e2,stroke:#333,color:#fff
    style LoadKubeConfig fill:#dae8fc,stroke:#6c8ebf
    style LoadInCluster fill:#dae8fc,stroke:#6c8ebf
    style ApiClient fill:#dae8fc,stroke:#6c8ebf
    style Note fill:#f8cecc,stroke:#b85450,stroke-dasharray: 5 5
    style TrainJobs fill:#d5e8d4,stroke:#82b366
    style KatibExps fill:#d5e8d4,stroke:#82b366
    style SparkConnects fill:#d5e8d4,stroke:#82b366
    style ConfigMaps fill:#e8e8e8,stroke:#999
    style RBAC fill:#f5a623,stroke:#333
