graph TD
    subgraph "Kubeflow SDK RBAC Model"
        direction TB

        subgraph SDKLayer["SDK Layer (No Own RBAC)"]
            SDK["Kubeflow SDK<br/>(Python Client Library)<br/>No ClusterRoles defined<br/>No RoleBindings defined"]
        end

        subgraph AuthDelegation["Authentication Delegation"]
            K8sClient["kubernetes Python Client<br/>Reads credentials from:<br/>- kubeconfig files<br/>- SA tokens (pod-mounted)<br/>- Environment variables"]
        end

        subgraph K8sRBAC["Kubernetes RBAC Enforcement"]
            APIServer["Kubernetes API Server<br/>Enforces RBAC on all requests"]
        end

        subgraph UserIdentity["Caller Identity (SDK inherits permissions of)"]
            direction LR
            UserAccount["User Account<br/>(via kubeconfig / OIDC)"]
            ServiceAccount["Service Account<br/>(via pod-mounted token)"]
        end

        subgraph RequiredPermissions["Required Permissions (must be granted to caller)"]
            direction TB
            TrainingPerms["Kubeflow Training Resources<br/>API: kubeflow.org<br/>Resources: trainingjobs<br/>Verbs: get, list, watch,<br/>create, update, delete"]
            KatibPerms["Katib Resources<br/>API: kubeflow.org<br/>Resources: experiments, trials<br/>Verbs: get, list, watch,<br/>create, update, delete"]
            SparkPerms["Spark Resources<br/>API: sparkoperator.k8s.io<br/>Resources: sparkapplications<br/>Verbs: get, list, watch,<br/>create, update, delete"]
            PipelinePerms["Pipeline Access<br/>Delegated to KFP API server<br/>Auth: kfp library mechanisms"]
        end
    end

    SDK -->|"delegates auth"| K8sClient
    K8sClient -->|"presents credentials"| APIServer
    UserAccount -->|"authenticates as"| APIServer
    ServiceAccount -->|"authenticates as"| APIServer
    APIServer -->|"checks RBAC for"| TrainingPerms
    APIServer -->|"checks RBAC for"| KatibPerms
    APIServer -->|"checks RBAC for"| SparkPerms
    SDK -->|"pipeline ops via kfp"| PipelinePerms

    style SDK fill:#4a90e2,stroke:#333,color:#fff
    style K8sClient fill:#5dade2,stroke:#333,color:#fff
    style APIServer fill:#f5a623,stroke:#333,color:#fff
    style UserAccount fill:#7ed321,stroke:#333,color:#fff
    style ServiceAccount fill:#7ed321,stroke:#333,color:#fff
    style TrainingPerms fill:#fff2cc,stroke:#d6b656
    style KatibPerms fill:#fff2cc,stroke:#d6b656
    style SparkPerms fill:#fff2cc,stroke:#d6b656
    style PipelinePerms fill:#fff2cc,stroke:#d6b656
