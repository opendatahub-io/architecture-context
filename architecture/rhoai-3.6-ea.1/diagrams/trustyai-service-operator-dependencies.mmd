graph LR
    TrustyAI["TrustyAI Service Operator<br/>(controller-manager)"]

    %% Runtime Framework
    TrustyAI -->|"operator framework"| ControllerRuntime["controller-runtime 0.22.5"]
    TrustyAI -->|"build/runtime"| Go["Go 1.26"]

    %% Platform Dependencies (Required)
    TrustyAI -->|"resource mgmt<br/>HTTPS/6443"| K8sAPI["Kubernetes API Server"]
    TrustyAI -->|"TLS profile"| OpenShiftAPI["OpenShift APIServer Config"]
    TrustyAI -->|"platform config"| ODHOperator["OpenDataHub Operator<br/>(DSC ConfigMap)"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"watch InferenceService"| KServe["KServe<br/>kserve v0.19.0"]

    %% Optional Dependencies
    TrustyAI -.->|"workload queuing<br/>(optional)"| Kueue["Kueue v0.16.0<br/>(graceful fallback)"]
    TrustyAI -.->|"ServiceMonitor<br/>(conditional)"| PromOp["Prometheus Operator<br/>v0.64.1"]

    %% Key Go Libraries
    TrustyAI -->|"OpenShift types"| OSApi["openshift/api"]
    TrustyAI -->|"Knative types"| KnativePkg["knative.dev/pkg"]

    %% Observability
    TrustyAI -->|"metrics"| PromClient["prometheus/client_golang"]
    TrustyAI -->|"logging"| Logr["go-logr/logr"]

    %% TrustyAI Service Pod Dependencies
    subgraph ServicePod["TrustyAI Service Pod"]
        RBACProxy["kube-rbac-proxy"]
        QuarkusSvc["TrustyAI Quarkus"]
    end
    TrustyAI -->|"creates"| ServicePod
    RBACProxy -->|"TokenReview<br/>SAR"| K8sAPI
    QuarkusSvc -->|"data I/O"| Storage["PVC / External DB"]

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style ControllerRuntime fill:#999,stroke:#333
    style Go fill:#999,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style OpenShiftAPI fill:#f5a623,stroke:#333
    style ODHOperator fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style Kueue fill:#999,stroke:#333,stroke-dasharray: 5 5
    style PromOp fill:#999,stroke:#333,stroke-dasharray: 5 5
    style OSApi fill:#999,stroke:#333
    style KnativePkg fill:#999,stroke:#333
    style PromClient fill:#999,stroke:#333
    style Logr fill:#999,stroke:#333
    style ServicePod fill:#d5e8d4,stroke:#82b366
    style RBACProxy fill:#f5a623,stroke:#333
    style QuarkusSvc fill:#7ed321,stroke:#333
    style Storage fill:#f5a623,stroke:#333
