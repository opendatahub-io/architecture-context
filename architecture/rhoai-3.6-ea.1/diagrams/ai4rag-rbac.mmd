graph TD
    subgraph "ai4rag RBAC Model"
        direction TB

        Note["ai4rag defines NO ClusterRoles,<br/>Roles, or RoleBindings.<br/><br/>It is a Python library embedded<br/>in pipeline task pods.<br/><br/>RBAC is delegated to the consuming<br/>Data Science Pipelines component."]
    end

    subgraph "Delegated RBAC (Pipeline Runtime)"
        direction TB

        SA["Pipeline ServiceAccount<br/>(pipeline-runner)"]
        PipelineRB["Pipeline RoleBinding<br/>(managed by DSP operator)"]
        PipelineRole["Pipeline Role<br/>(managed by DSP operator)"]
    end

    subgraph "Credential Access (Environment Variables)"
        direction TB

        AWSKey["AWS_ACCESS_KEY_ID<br/>+ AWS_SECRET_ACCESS_KEY<br/>(S3 access)"]
        MilvusToken["MILVUS_TOKEN<br/>(Milvus auth)"]
        PGVectorPwd["PGVECTOR_PASSWORD<br/>(PGVector auth)"]
        APIKey["MaaS API Key<br/>(OpenAI-compatible endpoint)"]
    end

    SA -->|"bound via"| PipelineRB
    PipelineRB -->|"grants"| PipelineRole

    SA -->|"env var injection"| AWSKey
    SA -->|"env var injection"| MilvusToken
    SA -->|"env var injection"| PGVectorPwd
    SA -->|"env var injection"| APIKey

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style PipelineRB fill:#f5a623,stroke:#333,color:#fff
    style PipelineRole fill:#f5a623,stroke:#333,color:#fff
    style AWSKey fill:#e74c3c,stroke:#333,color:#fff
    style MilvusToken fill:#e74c3c,stroke:#333,color:#fff
    style PGVectorPwd fill:#e74c3c,stroke:#333,color:#fff
    style APIKey fill:#e74c3c,stroke:#333,color:#fff
