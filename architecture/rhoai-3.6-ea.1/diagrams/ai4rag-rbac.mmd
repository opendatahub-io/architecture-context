graph TD
    subgraph "ai4rag Authentication Model"
        direction TB

        subgraph "Note"
            Note["ai4rag is a Python library<br/>No Kubernetes RBAC defined<br/>Authentication is credential-based"]
        end

        subgraph "Credential Sources"
            EnvVars["Environment Variables<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY<br/>AWS_S3_ENDPOINT"]
            RuntimeParams["Runtime Parameters<br/>OGX API Key<br/>(passed at client construction)"]
        end

        subgraph "Authentication Targets"
            S3Auth["S3-Compatible Storage<br/>Auth: AWS Access Key<br/>Protocol: HTTPS / TLS<br/>Verify: Configurable"]
            OGXAuth["OGX Inference Service<br/>Auth: API Key<br/>Protocol: HTTPS / TLS<br/>Verify: ⚠ Fallback to False"]
        end
    end

    EnvVars -->|"AWS credentials"| S3Auth
    RuntimeParams -->|"API key"| OGXAuth

    %% Styling
    style Note fill:#e8e8e8,stroke:#999
    style EnvVars fill:#ff6b6b,stroke:#cc0000,color:#fff
    style RuntimeParams fill:#ff6b6b,stroke:#cc0000,color:#fff
    style S3Auth fill:#f5a623,stroke:#333
    style OGXAuth fill:#f5a623,stroke:#333
