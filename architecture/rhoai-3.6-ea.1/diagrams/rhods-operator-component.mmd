graph TB
    subgraph "rhods-operator"
        direction TB

        subgraph "Platform Controllers"
            DSCInitReconciler["DSCInitialization<br/>Reconciler"]
            DSCReconciler["DataScienceCluster<br/>Reconciler"]
        end

        subgraph "Component Controllers"
            DSPCtrl["DataSciencePipelines<br/>Controller"]
            KueueCtrl["Kueue Controller"]
            MRCtrl["ModelRegistry<br/>Controller"]
            RayCtrl["Ray Controller"]
            SparkCtrl["SparkOperator<br/>Controller"]
            TrainerCtrl["Trainer Controller"]
            TrainingOpCtrl["TrainingOperator<br/>Controller"]
            TrustyCtrl["TrustyAI Controller"]
        end

        subgraph "Service Controllers"
            AuthCtrl["Auth Service<br/>Controller"]
            GatewayCtrl["Gateway Service<br/>Controller"]
            MonitoringCtrl["Monitoring Service<br/>Controller"]
        end

        subgraph "Admission Webhooks (port 9443)"
            ConversionWH["Conversion Webhooks<br/>(DSC, DSCI)"]
            MutatingWH["Mutating Webhooks<br/>(DSC v1/v2 defaulting,<br/>PodMonitor injection)"]
            ValidatingWH["Validating Webhooks<br/>(DSC v1/v2, DSCI v1/v2,<br/>AcceleratorProfile,<br/>HardwareProfile)"]
        end

        HealthProbe["Health/Ready Probes<br/>:8081 HTTP"]
        Metrics["Metrics Endpoint<br/>:8443 TLS"]
        TLSProfile["TLS Security Profile<br/>Watcher"]
    end

    %% Platform CRDs
    DSCI_CR["DSCInitialization CR<br/>(v1/v2)"]
    DSC_CR["DataScienceCluster CR<br/>(v1/v2)"]

    %% Component CRDs
    DSP_CR["DataSciencePipelines CR"]
    Kueue_CR["Kueue CR"]
    MR_CR["ModelRegistry CR"]
    Ray_CR["Ray CR"]
    Spark_CR["SparkOperator CR"]
    Trainer_CR["Trainer CR"]
    TrainingOp_CR["TrainingOperator CR"]
    Trusty_CR["TrustyAI CR"]

    %% Service CRDs
    Auth_CR["Auth CR"]
    GW_CR["GatewayConfig CR"]
    Mon_CR["Monitoring CR"]

    %% External Dependencies
    K8sAPI["Kubernetes API<br/>:6443 TLS 1.2+"]
    GatewayAPI["Gateway API"]
    Istio["Istio Service Mesh<br/>(conditional)"]
    PromOperator["prometheus-operator"]
    Kuadrant["Kuadrant<br/>(namespace watch)"]
    MaaS["models-as-a-service<br/>(namespace watch)"]
    ServiceCA["OpenShift service-ca<br/>(TLS certs)"]
    APIServer["OpenShift APIServer<br/>(TLS profile)"]

    %% CR → Controller relationships
    DSCI_CR -->|watched by| DSCInitReconciler
    DSC_CR -->|watched by| DSCReconciler

    DSCReconciler -->|cascades to| DSPCtrl
    DSCReconciler -->|cascades to| KueueCtrl
    DSCReconciler -->|cascades to| MRCtrl
    DSCReconciler -->|cascades to| RayCtrl
    DSCReconciler -->|cascades to| SparkCtrl
    DSCReconciler -->|cascades to| TrainerCtrl
    DSCReconciler -->|cascades to| TrainingOpCtrl
    DSCReconciler -->|cascades to| TrustyCtrl
    DSCReconciler -->|cascades to| AuthCtrl
    DSCReconciler -->|cascades to| GatewayCtrl
    DSCReconciler -->|cascades to| MonitoringCtrl

    DSPCtrl -->|manages| DSP_CR
    KueueCtrl -->|manages| Kueue_CR
    MRCtrl -->|manages| MR_CR
    RayCtrl -->|manages| Ray_CR
    SparkCtrl -->|manages| Spark_CR
    TrainerCtrl -->|manages| Trainer_CR
    TrainingOpCtrl -->|manages| TrainingOp_CR
    TrustyCtrl -->|manages| Trusty_CR
    AuthCtrl -->|manages| Auth_CR
    GatewayCtrl -->|manages| GW_CR
    MonitoringCtrl -->|manages| Mon_CR

    %% External dependency connections
    GatewayCtrl -->|creates| GatewayAPI
    GatewayCtrl -.->|conditional| Istio
    MonitoringCtrl -->|manages| PromOperator
    AuthCtrl -->|watches| Kuadrant
    AuthCtrl -->|watches| MaaS
    TLSProfile -->|reads| APIServer
    ConversionWH -->|cert from| ServiceCA

    %% All controllers → K8s API
    DSCInitReconciler -->|CRUD| K8sAPI
    DSCReconciler -->|CRUD| K8sAPI

    %% Styling
    style DSCInitReconciler fill:#4a90e2,color:#fff
    style DSCReconciler fill:#4a90e2,color:#fff
    style DSPCtrl fill:#5ba3f5,color:#fff
    style KueueCtrl fill:#5ba3f5,color:#fff
    style MRCtrl fill:#5ba3f5,color:#fff
    style RayCtrl fill:#5ba3f5,color:#fff
    style SparkCtrl fill:#5ba3f5,color:#fff
    style TrainerCtrl fill:#5ba3f5,color:#fff
    style TrainingOpCtrl fill:#5ba3f5,color:#fff
    style TrustyCtrl fill:#5ba3f5,color:#fff
    style AuthCtrl fill:#7ed321,color:#fff
    style GatewayCtrl fill:#7ed321,color:#fff
    style MonitoringCtrl fill:#7ed321,color:#fff
    style DSCI_CR fill:#f5a623,color:#fff
    style DSC_CR fill:#f5a623,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style GatewayAPI fill:#e8e8e8,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style PromOperator fill:#e8e8e8,stroke:#333
    style Kuadrant fill:#e8e8e8,stroke:#333
    style MaaS fill:#e8e8e8,stroke:#333
    style ServiceCA fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
