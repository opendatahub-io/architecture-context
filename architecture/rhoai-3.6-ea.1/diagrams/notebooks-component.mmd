graph TB
    subgraph "Notebooks Component (Container Image Factory)"
        direction TB

        subgraph "JupyterLab Variants"
            Minimal["Minimal Notebook<br/>UBI9 + Python 3.12"]
            DataScience["DataScience Notebook<br/>scikit-learn, pandas, numpy"]
            PyTorch["PyTorch Notebook<br/>torch, torchvision"]
            TensorFlow["TensorFlow Notebook<br/>tensorflow"]
            TrustyAI["TrustyAI Notebook<br/>trustyai"]
            LLMCompressor["LLM Compressor Notebook<br/>llmcompressor, auto-round"]
        end

        subgraph "Code Server Variants"
            CodeServer["Code Server Notebook<br/>UBI9 + Python 3.12"]
        end

        subgraph "Runtime Images"
            RTMinimal["Runtime Minimal"]
            RTDataScience["Runtime DataScience"]
            RTPyTorch["Runtime PyTorch"]
            RTTensorFlow["Runtime TensorFlow"]
        end

        subgraph "Accelerator Flavors"
            CPU["CPU"]
            CUDA["NVIDIA CUDA"]
            ROCm["AMD ROCm"]
        end

        subgraph "Build Utilities (Go)"
            BuildInputs["buildinputs<br/>Dockerfile dependency analyzer"]
            CheckPayload["check-payload<br/>FIPS compliance scanner"]
        end

        subgraph "Entrypoint"
            StartNotebook["start-notebook.sh<br/>Launches JupyterLab"]
            RunCodeServer["run-code-server.sh<br/>Launches Code Server"]
        end
    end

    subgraph "Base Image"
        UBI9["UBI9 Base Image<br/>compat-openssl11, skopeo, oc CLI"]
    end

    subgraph "Platform Integration"
        ImageStreams["ImageStream Resources<br/>component.opendatahub.io/name: notebooks"]
        Kustomize["Kustomize Manifests<br/>ConfigMap parameter substitution"]
    end

    UBI9 -->|base stage| Minimal
    UBI9 -->|base stage| CodeServer
    Minimal -->|extends| DataScience
    Minimal -->|extends| PyTorch
    Minimal -->|extends| TensorFlow
    Minimal -->|extends| TrustyAI
    PyTorch -->|extends| LLMCompressor

    Minimal -->|uses| StartNotebook
    DataScience -->|uses| StartNotebook
    PyTorch -->|uses| StartNotebook
    TensorFlow -->|uses| StartNotebook
    TrustyAI -->|uses| StartNotebook
    LLMCompressor -->|uses| StartNotebook
    CodeServer -->|uses| RunCodeServer

    CPU -.->|flavor| Minimal
    CUDA -.->|flavor| Minimal
    ROCm -.->|flavor| Minimal

    Kustomize -->|generates| ImageStreams

    CheckPayload -->|validates| Minimal
    BuildInputs -->|analyzes| Minimal

