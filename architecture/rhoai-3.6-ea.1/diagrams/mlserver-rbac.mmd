graph TD
    subgraph "Authentication Architecture"
        Note["MLServer defines NO ClusterRoles,<br/>RoleBindings, or ServiceAccounts.<br/><br/>All authentication and authorization<br/>is delegated to the platform layer."]
    end

    subgraph "Platform Auth Delegation"
        KRBP["kube-rbac-proxy Sidecar<br/>(Injected by KServe)"]
    end

    subgraph "Auth Mechanisms"
        OAuth["OpenShift OAuth<br/>Token Validation"]
        SAToken["ServiceAccount<br/>Token Validation"]
    end

    subgraph "Protected Endpoints - REST (8080/TCP)"
        RESTInfer["/v2/models/{model}/infer<br/>POST"]
        RESTStream["/v2/models/{model}/infer_stream<br/>POST"]
        RESTMeta["/v2/models/{model}<br/>GET"]
        RESTReady["/v2/models/{model}/ready<br/>GET"]
        RESTLoad["/v2/repository/models/{model}/load<br/>POST"]
        RESTUnload["/v2/repository/models/{model}/unload<br/>POST"]
        RESTIndex["/v2/repository/index<br/>POST"]
        RESTHealth["/v2/health/live, /v2/health/ready<br/>GET"]
        RESTGenerate["/v2/models/{model}/generate<br/>POST"]
        RESTRuntimes["/v2/runtimes<br/>GET"]
    end

    subgraph "Protected Endpoints - gRPC (8081/TCP)"
        GRPCInfer["GRPCInferenceService/ModelInfer"]
        GRPCStream["GRPCInferenceService/ModelStreamInfer"]
        GRPCMeta["GRPCInferenceService/ModelMetadata"]
        GRPCReady["GRPCInferenceService/ModelReady"]
        GRPCLive["GRPCInferenceService/ServerLive"]
        GRPCServerReady["GRPCInferenceService/ServerReady"]
        GRPCServerMeta["GRPCInferenceService/ServerMetadata"]
        GRPCRepoIndex["ModelRepositoryService/RepositoryIndex"]
        GRPCRepoLoad["ModelRepositoryService/RepositoryModelLoad"]
        GRPCRepoUnload["ModelRepositoryService/RepositoryModelUnload"]
        GRPCSecurity["GRPCInferenceService/RuntimeSecurity"]
    end

    subgraph "Unprotected Endpoint"
        Metrics["/metrics<br/>8082/TCP<br/>No Auth"]
    end

    subgraph "Application-Level Security"
        TrustedRT["Trusted Runtimes Allowlist<br/>/etc/mlserver/trusted-runtimes.json<br/>Controls which model implementations<br/>can be loaded"]
    end

    %% Auth flow
    KRBP -->|"validates"| OAuth
    KRBP -->|"validates"| SAToken

    %% Protection
    KRBP -->|"protects"| RESTInfer
    KRBP -->|"protects"| RESTStream
    KRBP -->|"protects"| RESTMeta
    KRBP -->|"protects"| RESTReady
    KRBP -->|"protects"| RESTLoad
    KRBP -->|"protects"| RESTUnload
    KRBP -->|"protects"| RESTIndex
    KRBP -->|"protects"| RESTHealth
    KRBP -->|"protects"| RESTGenerate
    KRBP -->|"protects"| RESTRuntimes
    KRBP -->|"protects"| GRPCInfer
    KRBP -->|"protects"| GRPCStream
    KRBP -->|"protects"| GRPCMeta
    KRBP -->|"protects"| GRPCReady
    KRBP -->|"protects"| GRPCLive
    KRBP -->|"protects"| GRPCServerReady
    KRBP -->|"protects"| GRPCServerMeta
    KRBP -->|"protects"| GRPCRepoIndex
    KRBP -->|"protects"| GRPCRepoLoad
    KRBP -->|"protects"| GRPCRepoUnload
    KRBP -->|"protects"| GRPCSecurity

    %% Trusted runtimes
    TrustedRT -.->|"gates model loading"| RESTLoad
    TrustedRT -.->|"gates model loading"| GRPCRepoLoad

