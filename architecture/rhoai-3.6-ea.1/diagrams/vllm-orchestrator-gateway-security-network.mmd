graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph AppLayer["APPLICATION LAYER"]
        Gateway["vllm-orchestrator-gateway<br/>Rust / Axum<br/>8090/TCP HTTP<br/>No local auth enforcement<br/>Injects detector configs per route"]
    end

    subgraph Backend["BACKEND SERVICES"]
        Orchestrator["vLLM Orchestrator<br/>/api/v2/chat/completions-detection<br/>configurable port (default 8032)<br/>HTTP or HTTPS (mTLS)"]
    end

    subgraph TLSMaterials["TLS MATERIALS (Optional)"]
        ClientCert["tls.crt + tls.key<br/>/etc/tls/private/<br/>Client identity (PKCS#12)"]
        CACert["service-ca.crt<br/>/etc/tls/ca/<br/>CA trust bundle"]
    end

    %% Flows
    Client -->|"POST /{route}/v1/chat/completions<br/>HTTP/8090<br/>No Encryption<br/>Authorization header (optional)"| Gateway
    Gateway -->|"POST /api/v2/chat/completions-detection<br/>HTTP or HTTPS/configurable<br/>mTLS when certs present<br/>Authorization forwarded"| Orchestrator

    %% TLS material usage
    ClientCert -.->|"PKCS#12 identity<br/>via OpenSSL"| Gateway
    CACert -.->|"CA verification"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef applayer fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef tls fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway applayer
    class Orchestrator backend
    class ClientCert,CACert tls
