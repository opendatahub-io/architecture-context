graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["API Client"]
    end

    subgraph GatewayLayer["GATEWAY LAYER"]
        Gateway["vllm-orchestrator-gateway<br/>8090/TCP HTTP<br/>Rust (axum + tokio)<br/>UBI9-minimal<br/>No auth enforcement"]
    end

    subgraph Backend["BACKEND SERVICE"]
        Orchestrator["vllm-orchestrator<br/>8032/TCP HTTP/HTTPS<br/>/api/v2/chat/completions-detection<br/>Receives forwarded auth"]
    end

    subgraph TLSCerts["TLS CERTIFICATES (Platform-Injected)"]
        direction LR
        Cert["/etc/tls/private/tls.crt"]
        Key["/etc/tls/private/tls.key"]
        CA["/etc/tls/ca/service-ca.crt"]
    end

    %% Flows
    Client -->|"HTTP/8090<br/>No encryption (platform-delegated)<br/>Authorization header (pass-through)"| Gateway
    Gateway -->|"HTTP or HTTPS/8032<br/>mTLS when certs mounted<br/>PKCS#12 identity (OpenSSL)<br/>Authorization header forwarded"| Orchestrator

    %% TLS cert usage
    TLSCerts -.->|"Volume mounts<br/>(OpenShift service-ca)"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef backend fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef certs fill:#fff2cc,stroke:#d6b656,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gateway gateway
    class Orchestrator backend
    class Cert,Key,CA certs
