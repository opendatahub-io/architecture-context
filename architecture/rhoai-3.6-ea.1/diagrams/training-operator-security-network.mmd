graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Pipeline"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        direction TB

        subgraph WebhookZone["Webhook Server"]
            Webhook["Training Operator Webhook<br/>9443/TCP TLS<br/>cert: training-operator-webhook-cert<br/>cert-controller v0.12.0<br/>failurePolicy: Fail"]
        end

        subgraph ControllerZone["Controller Manager"]
            Controller["Training Operator Controller<br/>SA: training-operator<br/>FIPS: strictfipsruntime + CGO_ENABLED=1<br/>6 reconcilers"]
        end

        subgraph MetricsZone["Observability"]
            MetricsEP["Metrics Endpoint<br/>8080/TCP HTTP<br/>No Auth<br/>/metrics"]
            HealthEP["Health Probes<br/>8081/TCP HTTP<br/>No Auth<br/>/healthz, /readyz"]
        end
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>scrape via annotation"]
    end

    subgraph OptionalIntegrations["OPTIONAL INTEGRATIONS"]
        Volcano["Volcano Scheduler<br/>scheduling.volcano.sh<br/>PodGroups"]
        SchedulerPlugins["Scheduler Plugins<br/>scheduling.x-k8s.io<br/>PodGroups"]
        OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS profile source"]
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACES"]
        Workers["Worker Pods<br/>+ Services, SAs<br/>+ NetworkPolicies"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer token"| K8sAPI

    %% API server to webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>Admission"| Webhook

    %% Controller to API server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Controller reads OpenShift config at startup
    Controller -.->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token<br/>(startup only)"| OpenShiftAPI

    %% Controller manages workloads via API
    Controller -->|"manages via<br/>K8s API"| Workers

    %% Gang scheduling
    Controller -.->|"optional<br/>PodGroup CRUD"| Volcano
    Controller -.->|"optional<br/>PodGroup CRUD"| SchedulerPlugins

    %% Monitoring
    Prometheus -->|"HTTP/8080<br/>No encryption<br/>No auth"| MetricsEP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef workload fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class K8sAPI controlplane
    class Webhook,Controller,MetricsEP,HealthEP operator
    class Prometheus monitoring
    class Volcano,SchedulerPlugins,OpenShiftAPI optional
    class Workers workload
