graph LR
    LLMDRouter["llm-d-router<br/>(EPP + coordinator + pd-sidecar)"]

    %% Internal Platform Dependencies
    LLMDRouter -->|"Go library +<br/>Controller watch"| GAIE["gateway-api-inference-extension<br/>sigs.k8s.io/gateway-api-inference-extension v1.5.0"]
    LLMDRouter -->|"Go library<br/>KV-cache scheduling"| KVCache["llm-d-kv-cache<br/>v0.9.0"]

    %% Runtime Integration
    LLMDRouter -->|"ExtProc gRPC<br/>per-request callout"| Envoy["Envoy Proxy<br/>(External Processing filter)"]

    %% Core Framework Dependencies
    LLMDRouter -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    LLMDRouter -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>v1.82.1"]
    LLMDRouter -->|"K8s client"| ClientGo["k8s.io/client-go<br/>v0.35.7"]
    LLMDRouter -->|"Gateway API"| GatewayAPI["sigs.k8s.io/gateway-api<br/>v1.5.1"]

    %% Envoy Integration
    LLMDRouter -->|"ExtProc protocol"| GoControlPlane["envoyproxy/go-control-plane<br/>v1.37.0"]

    %% Observability Dependencies
    LLMDRouter -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.23.2"]
    LLMDRouter -->|"distributed tracing"| OTel["go.opentelemetry.io/otel<br/>v1.44.0"]
    LLMDRouter -->|"structured logging"| Zap["go.uber.org/zap<br/>v1.28.0"]

    %% Data Dependencies
    LLMDRouter -->|"caching"| Redis["redis/go-redis<br/>v9.20.1"]
    LLMDRouter -->|"messaging"| ZMQ["go-zeromq/zmq4<br/>v0.17.0"]
    LLMDRouter -->|"in-memory cache"| Ristretto["dgraph-io/ristretto<br/>v2.4.2"]

    %% Configuration
    LLMDRouter -->|"runtime config"| Viper["spf13/viper<br/>v1.21.0"]

    %% External Services (runtime)
    LLMDRouter -->|"watch/reconcile<br/>6443/HTTPS"| K8sAPI["Kubernetes API Server"]
    LLMDRouter -->|"OTLP/gRPC traces"| OTelCollector["OpenTelemetry Collector"]

    %% Integration Points (consumed by)
    Prometheus["Prometheus"] -->|"scrape :9090"| LLMDRouter

