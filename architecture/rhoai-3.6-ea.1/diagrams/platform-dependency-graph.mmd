graph TB
    subgraph Orchestration["Platform Orchestration"]
        RhodsOp[rhods-operator<br/>Platform Orchestrator<br/>19 CRDs incl. DataScienceCluster]
    end

    subgraph ModelServing["Model Serving Control Plane"]
        KServe[kserve<br/>Model Serving<br/>13 CRDs, 23 webhooks]
        ODHModelCtrl[odh-model-controller<br/>Serving Integration Layer<br/>8 webhooks]
        MaaS[models-as-a-service<br/>Multi-Tenant Gateway<br/>8 CRDs]
        AIGatewayOp[ai-gateway-operator<br/>AI Gateway Infrastructure]
        AIGatewayPP[ai-gateway-payload-processing<br/>External Provider Bridge]
    end

    subgraph LLMStack["LLM Inference Stack (New in 3.6)"]
        LLMD[llm-d<br/>LLM Engine - vLLM]
        LLMDRouter[llm-d-router EPP<br/>KV-Cache-Aware Routing]
        LLMDSidecar[llm-d-routing-sidecar<br/>Pod Metrics Reporter]
        LLMDPayload[llm-d-inference-payload-processor<br/>Payload Translation]
        LLMDBatch[llm-d-batch-gateway-operator<br/>Batch Inference]
    end

    subgraph MLPipeline["ML Pipelines"]
        DSPOp[data-science-pipelines-operator<br/>Pipeline Lifecycle]
        DSP[data-science-pipelines<br/>API Server + Argo]
        MLMD[ml-metadata<br/>Pipeline Metadata]
    end

    subgraph Registry["Model Registry"]
        ModelRegOp[model-registry-operator<br/>Registry + Catalog]
    end

    subgraph Training["Distributed Training"]
        TrainerOp[trainer-operator<br/>Training Lifecycle]
        Trainer[trainer<br/>Kubeflow Trainer V2]
        TrainingOp[training-operator<br/>Job Orchestration]
        KubeRay[kuberay<br/>Ray Clusters]
    end

    subgraph Dashboard["User Interface"]
        ODHDash[odh-dashboard<br/>Web Console + BFF<br/>10+ API sidecars]
    end

    subgraph Workbenches["Development Environment"]
        WBOp[workbenches-operator<br/>Workbench Lifecycle]
        Notebooks[notebooks<br/>Jupyter Instances]
    end

    subgraph ExperimentTracking["Experiment Tracking"]
        MLflowOp[mlflow-operator<br/>MLflow Lifecycle]
        MLflow[mlflow<br/>Experiment Tracking]
    end

    subgraph AISafety["AI Safety & Trust"]
        TrustyAIOp[trustyai-service-operator<br/>AI Explainability]
        NeMo[NeMo-Guardrails<br/>LLM Guardrails]
        GuardrailsRegex[guardrails-regex-detector<br/>Pattern Detection]
    end

    subgraph MCPServices["MCP Services (New in 3.6)"]
        MCPLifecycleOp[mcp-lifecycle-operator]
        MCPModuleOp[mcp-lifecycle-module-operator]
        RHOAIMCP[rhoai-mcp<br/>Platform API Access]
    end

    subgraph NewCapabilities["New Capabilities (3.6)"]
        FeastOp[feast-module-operator<br/>Feature Store]
        EvalHub[eval-hub<br/>Model Evaluation]
        OGXOp[ogx-k8s-operator<br/>LlamaStack]
    end

    subgraph InfraServices["Infrastructure Services"]
        KubeRBACProxy[kube-rbac-proxy<br/>AuthZ Sidecar]
        KubeAuthProxy[kube-auth-proxy<br/>OAuth2/OIDC Proxy]
        WVA[workload-variant-autoscaler]
    end

    subgraph ExternalInfra["External Platform Infrastructure"]
        GatewayAPI[Gateway API<br/>HTTPRoute Data Plane]
        Istio[Istio<br/>Service Mesh]
        CertManager[cert-manager<br/>Certificate Management]
        Kuadrant[Kuadrant<br/>API Policy]
        OLM[OLM<br/>Operator Lifecycle]
    end

    %% Orchestration - rhods-operator manages all component operators
    RhodsOp -->|lifecycle mgmt| KServe
    RhodsOp -->|lifecycle mgmt| ODHModelCtrl
    RhodsOp -->|lifecycle mgmt| MaaS
    RhodsOp -->|lifecycle mgmt| AIGatewayOp
    RhodsOp -->|lifecycle mgmt| DSPOp
    RhodsOp -->|lifecycle mgmt| ModelRegOp
    RhodsOp -->|lifecycle mgmt| TrainerOp
    RhodsOp -->|lifecycle mgmt| KubeRay
    RhodsOp -->|lifecycle mgmt| ODHDash
    RhodsOp -->|lifecycle mgmt| WBOp
    RhodsOp -->|lifecycle mgmt| TrustyAIOp
    RhodsOp -->|lifecycle mgmt| MLflowOp
    RhodsOp -->|lifecycle mgmt| FeastOp
    RhodsOp -->|lifecycle mgmt| MCPLifecycleOp

    %% OLM installs rhods-operator
    OLM -->|installs| RhodsOp

    %% Model Serving chain
    ODHModelCtrl -->|mutates InferenceService,<br/>LLMInferenceService,<br/>InferenceGraph, Pods| KServe
    MaaS -->|routes to model endpoints| KServe
    AIGatewayOp -->|provisions gateway for| MaaS
    AIGatewayOp -->|cert-manager certs| CertManager
    AIGatewayOp -->|Kuadrant policies| Kuadrant
    AIGatewayOp -->|Istio config| Istio
    AIGatewayPP -->|external provider bridge| AIGatewayOp

    %% KServe dependencies
    KServe -->|HTTPRoute routing| GatewayAPI
    KServe -->|VirtualService routing| Istio
    KServe -->|AuthZ sidecar| KubeRBACProxy

    %% LLM inference integration
    KServe -->|provisions LLMInferenceService| LLMD
    KServe -->|provisions EPP| LLMDRouter
    LLMDRouter -->|Envoy ExtProc| GatewayAPI
    LLMDSidecar -->|pod metrics| LLMDRouter
    LLMDPayload -->|payload transform| LLMDRouter
    LLMDBatch -->|batch jobs| KServe

    %% Dashboard integrations
    ODHDash -->|manages models| KServe
    ODHDash -->|model catalog| ModelRegOp
    ODHDash -->|pipeline UI| DSPOp
    ODHDash -->|workbench mgmt| WBOp
    ODHDash -->|MaaS admin| MaaS
    ODHDash -->|experiment tracking| MLflow
    ODHDash -->|evaluation| EvalHub
    ODHDash -->|OAuth2 via| KubeAuthProxy

    %% ML Pipeline chain
    DSPOp -->|deploys| DSP
    DSP -->|stores metadata| MLMD
    DSP -->|deploys models| KServe
    DSP -->|VirtualService| Istio

    %% Training
    TrainerOp -->|manages| Trainer
    TrainingOp -->|job orchestration| KubeRay

    %% Model Registry
    ModelRegOp -->|HTTPRoute| GatewayAPI
    ModelRegOp -->|AuthZ sidecar| KubeRBACProxy

    %% MaaS auth
    MaaS -->|auth policy| Kuadrant
    MaaS -->|HTTPRoute| GatewayAPI

    %% Workbenches
    WBOp -->|manages| Notebooks

    %% MLflow
    MLflowOp -->|manages| MLflow

    %% TrustyAI
    TrustyAIOp -->|AuthZ sidecar| KubeRBACProxy

    %% MCP
    MCPLifecycleOp -->|manages| MCPModuleOp

