graph TD
    subgraph "ml-metadata RBAC Profile"
        direction TB

        Note["Note: ml-metadata defines no Kubernetes<br/>RBAC resources (ClusterRoles, RoleBindings,<br/>or ServiceAccounts) in its repository.<br/><br/>Access control is platform-delegated."]
    end

    subgraph "Platform-Level Access Control"
        direction TB

        NetworkIsolation["Network Isolation<br/>(Service Mesh / NetworkPolicies)<br/>Namespace-scoped"]
        PodSecurity["Pod Security<br/>Runs as UID 65534 (non-root)<br/>ubi9-minimal base"]
    end

    subgraph "Application-Level Security (Optional)"
        direction TB

        SSLConfig["MetadataStoreServerConfig.SSLConfig"]
        ServerCert["Server Key/Cert<br/>(TLS termination)"]
        ClientVerify["Client Cert Verification<br/>(mTLS)"]
        CustomCA["Custom CA Certificate"]

        SSLConfig --> ServerCert
        SSLConfig --> ClientVerify
        SSLConfig --> CustomCA
    end

    subgraph "Authentication Summary"
        AuthEndpoint["MetadataStoreService gRPC<br/>(All ~40 RPCs)"]
        AuthMech["Auth: None built-in"]
        Enforcement["Enforcement: Platform-delegated<br/>via network isolation"]

        AuthEndpoint --> AuthMech
        AuthMech --> Enforcement
    end

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style NetworkIsolation fill:#d5e8d4,stroke:#82b366
    style PodSecurity fill:#d5e8d4,stroke:#82b366
    style SSLConfig fill:#e1d5e7,stroke:#9673a6
    style ServerCert fill:#e1d5e7,stroke:#9673a6
    style ClientVerify fill:#e1d5e7,stroke:#9673a6
    style CustomCA fill:#e1d5e7,stroke:#9673a6
    style AuthEndpoint fill:#dae8fc,stroke:#6c8ebf
    style AuthMech fill:#dae8fc,stroke:#6c8ebf
    style Enforcement fill:#dae8fc,stroke:#6c8ebf
