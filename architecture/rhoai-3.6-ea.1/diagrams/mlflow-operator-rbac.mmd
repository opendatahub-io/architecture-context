graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["mlflow-operator-controller-manager<br/>(operator namespace)"]
        SA_Controller["controller-manager<br/>(system namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["mlflow-operator-manager-rolebinding"]
        CRB_Metrics["mlflow-operator-metrics-auth-rolebinding"]
        CRB_SysManager["manager-rolebinding"]
        CRB_SysMetrics["metrics-auth-rolebinding"]
    end

    subgraph OperatorRoles["Operator ClusterRoles"]
        CR_Manager["mlflow-operator-manager-role"]
        CR_Metrics["mlflow-operator-metrics-auth-role"]
        CR_Leader["mlflow-operator-leader-election-role<br/>(namespace-scoped)"]
    end

    subgraph UserFacingRoles["User-Facing ClusterRoles"]
        CR_View["mlflow-operator-mlflow-view<br/>(read-only)"]
        CR_Edit["mlflow-operator-mlflow-edit<br/>(full CRUD)"]
        CR_Integration["mlflow-operator-mlflow-integration<br/>(integration access)"]
    end

    subgraph ManagerPermissions["mlflow-operator-manager-role Permissions"]
        direction TB

        subgraph CoreResources["Core API Resources"]
            Core_RO["namespaces, pods, secrets<br/>get, list, watch"]
            Core_CRUD["configmaps, pvcs, secrets,<br/>serviceaccounts, services<br/>full CRUD"]
        end

        subgraph AppResources["App Resources"]
            Apps_CRUD["apps/deployments<br/>full CRUD"]
            Batch_CRUD["batch/cronjobs, jobs<br/>full CRUD"]
            Net_CRUD["networking.k8s.io/networkpolicies<br/>full CRUD"]
            Mon_CRUD["monitoring.coreos.com/servicemonitors<br/>full CRUD"]
        end

        subgraph MLflowResources["MLflow CRD Resources"]
            MLflow_CRUD["mlflow.opendatahub.io/mlflows<br/>full CRUD + finalizers + status"]
            MLflowOp_RW["components.platform.opendatahub.io/<br/>mlflowoperators<br/>get, list, patch, update, watch"]
            MLflowConfig_RO["mlflow.kubeflow.org/mlflowconfigs<br/>get, list, watch"]
        end

        subgraph PlatformResources["Platform Resources"]
            OS_TLS["config.openshift.io/apiservers<br/>get, list, watch"]
            OS_Console["console.openshift.io/consolelinks<br/>full CRUD"]
            GW_Routes["gateway.networking.k8s.io/httproutes<br/>full CRUD"]
            Auth_RO["services.platform.opendatahub.io/auths<br/>get, list, watch"]
        end

        subgraph RBACResources["RBAC Resources"]
            RBAC_CRUD["rbac.authorization.k8s.io/<br/>clusterroles, clusterrolebindings,<br/>rolebindings<br/>full CRUD + bind"]
        end

        subgraph SecretRestriction["Secret Access Restriction"]
            Secret_Named["mlflow-artifact-connection<br/>(resourceNames-scoped)<br/>Blast radius: single secret only"]
        end
    end

    subgraph MetricsPermissions["mlflow-operator-metrics-auth-role"]
        TokenReview["authentication.k8s.io/tokenreviews<br/>create"]
        SAR["authorization.k8s.io/subjectaccessreviews<br/>create"]
    end

    subgraph LeaderPermissions["Leader Election Permissions"]
        Leader_CM["configmaps → full CRUD"]
        Leader_Lease["coordination.k8s.io/leases → full CRUD"]
        Leader_Events["events → create, patch"]
    end

    %% SA → CRB → CR bindings
    SA_Manager -->|"bound via"| CRB_Manager
    SA_Manager -->|"bound via"| CRB_Metrics
    SA_Controller -->|"bound via"| CRB_SysManager
    SA_Controller -->|"bound via"| CRB_SysMetrics

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_Metrics
    CRB_SysManager -->|"grants"| CR_Manager
    CRB_SysMetrics -->|"grants"| CR_Metrics

    %% CR → Permissions
    CR_Manager -->|"includes"| ManagerPermissions
    CR_Metrics -->|"includes"| MetricsPermissions
    CR_Leader -->|"includes"| LeaderPermissions

    %% User-facing role details
    CR_View -->|"read-only"| MLflowResources
    CR_Edit -->|"full CRUD"| MLflowResources
    CR_Integration -->|"datasets, experiments,<br/>registeredmodels"| MLflowResources

    %% Styling
    style SA_Manager fill:#4a90e2,stroke:#333,color:#fff
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#000
    style CR_Metrics fill:#f5a623,stroke:#333,color:#000
    style CR_Leader fill:#f5a623,stroke:#333,color:#000
    style CR_View fill:#7ed321,stroke:#333,color:#000
    style CR_Edit fill:#7ed321,stroke:#333,color:#000
    style CR_Integration fill:#7ed321,stroke:#333,color:#000
    style Secret_Named fill:#e74c3c,stroke:#333,color:#fff
    style CRB_Manager fill:#ddd,stroke:#333
    style CRB_Metrics fill:#ddd,stroke:#333
    style CRB_SysManager fill:#ddd,stroke:#333
    style CRB_SysMetrics fill:#ddd,stroke:#333
