    subgraph Tracing["Distributed Tracing"]
        direction TB
        T1[ai-gateway-operator<br/>OpenTelemetry integration<br/>RBAC includes OTEL resources]
        T2[No centralized trace<br/>aggregation observed<br/>Each operator exposes<br/>metrics independently]
        TraceGap[OBSERVABILITY GAP:<br/>No platform-level trace bus<br/>No centralized metadata<br/>correlation service]
    end

    subgraph MetadataStores["Metadata Fragmentation (Cross-Domain Query Gap)"]
        direction TB
        MD1[model-registry<br/>PostgreSQL-backed<br/>Model metadata + artifacts]
        MD2[data-science-pipelines<br/>Database-backed<br/>Pipeline run metadata]
        MD3[ml-metadata MLMD<br/>Pipeline artifact lineage]
        MD4[KServe CRDs<br/>etcd-backed<br/>Serving state + endpoints]
        MD5[MLflow<br/>Experiment tracking<br/>Run metrics + parameters]
        MDGap[NO CROSS-DOMAIN QUERIES<br/>Manual correlation required:<br/>pipeline -> model -> serving]
    end

    subgraph WebhookHealth["Webhook Availability Monitoring"]
        direction TB
        WH1[16 webhook servers<br/>Must be monitored:<br/>unavailability blocks<br/>K8s API operations]
        WH2[Critical path:<br/>kserve 23 webhooks<br/>odh-model-controller 8 webhooks<br/>rhods-operator 10 webhooks]
        WH3[All Fail policy:<br/>No graceful degradation<br/>Webhook down = API blocked]
    end

    %% Connections
    T1 -.->|gap| TraceGap
    MD1 -.->|no join| MDGap
    MD2 -.->|no join| MDGap
    MD3 -.->|no join| MDGap
    MD4 -.->|no join| MDGap
    MD5 -.->|no join| MDGap

