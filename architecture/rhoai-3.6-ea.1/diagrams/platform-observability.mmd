    subgraph Probes["Health Probes (controller-runtime standard)"]
        direction TB

        subgraph ProbePattern["Standard Controller Pattern"]
            HP1[All controller-runtime operators<br/>Liveness: :8081 healthz<br/>Readiness: :8081 readyz<br/>20+ components]
        end

        subgraph ProbeCustom["Custom Probe Ports"]
            HP2[odh-dashboard<br/>Liveness: :8080 healthz<br/>Readiness: :8080 readyz]
            HP3[kube-auth-proxy<br/>Custom health endpoint]
