graph TB
    subgraph CallerProcess["CALLER PROCESS (Trusted - In-Process)"]
        direction TB

        Caller["Data Scientist Notebook<br/>or Training Job"]

        subgraph Library["Training Hub Library (pip package)"]
            direction TB

            subgraph Algorithms["Algorithm / Backend Pairs"]
                SFT["SFT<br/>(instructlab-training)<br/>Pure compute"]
                OSFT["OSFT<br/>(mini-trainer)<br/>Pure compute"]
                LoRA["LoRA SFT<br/>(Unsloth)<br/>Pure compute"]
                GRPO["GRPO<br/>(ART + co-located vLLM)<br/>In-process only"]
                GEPA["GEPA<br/>(gepa + litellm)<br/>Outbound HTTP"]
            end
        end

        Caller -->|"in-process call<br/>No network"| Library
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Outbound Only)"]
        LLMAPI["LLM Inference API<br/>(OPENAI_API_BASE)<br/>HTTPS<br/>API Key Auth"]
        MLflow["MLflow Tracking Server<br/>HTTP/HTTPS<br/>Optional"]
    end

    subgraph LocalStorage["LOCAL STORAGE"]
        Checkpoints["Filesystem<br/>ckpt_output_dir<br/>OS file permissions"]
    end

    %% Outbound flows
    GEPA -->|"HTTPS<br/>TLS (inherited)<br/>Auth: OPENAI_API_KEY"| LLMAPI
    GEPA -.->|"HTTP/HTTPS<br/>Optional<br/>Experiment tracking"| MLflow

    %% Local I/O
    SFT -->|"write checkpoints"| Checkpoints
    OSFT -->|"write checkpoints"| Checkpoints
    LoRA -->|"write checkpoints"| Checkpoints
    GRPO -->|"write checkpoints"| Checkpoints
    GEPA -->|"write optimized prompts"| Checkpoints

    %% Styling
    classDef caller fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef library fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef algorithm fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Caller caller
    class Library library
    class SFT,OSFT,LoRA,GRPO,GEPA algorithm
    class LLMAPI,MLflow external
    class Checkpoints storage
