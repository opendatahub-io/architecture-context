graph LR
    SparkOp["Spark Operator<br/>(3 workloads)"]

    %% External Runtime Dependencies
    SparkOp -->|"admission webhooks<br/>TLS, failurePolicy: Fail"| K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
    SparkOp -->|"TLS profile read<br/>(webhook startup)"| OSConfig["OpenShift APIServer<br/>config.openshift.io/v1"]
    SparkOp -->|"Certificate + Issuer CRs<br/>(module creates)"| CertMgr["cert-manager"]
    SparkOp -->|"PodMonitor CRs<br/>(module creates)"| PromOp["prometheus-operator"]

    %% Internal RHOAI Dependencies
    SparkOp -->|"PlatformObject interface<br/>lifecycle management"| ODHOp["ODH Operator"]
    SparkOp -->|"Go library<br/>platform detection, manifests"| ODHPlatUtils["odh-platform-utilities"]

    %% Integration Points (consumers)
    ODHOp -->|"creates SparkOperator CR<br/>reads status"| SparkOp

    %% Build Dependencies
    SparkOp -.->|"framework"| CtrlRuntime["controller-runtime 0.23.3"]
    SparkOp -.->|"scheduling"| SchedPlugins["scheduler-plugins"]
    SparkOp -.->|"batch scheduling"| Volcano["volcano.sh/apis"]
    SparkOp -.->|"chart management"| Helm["helm/v3"]
    SparkOp -.->|"FIPS crypto"| GoFIPS["Go 1.25.7<br/>strictfipsruntime"]

    %% Runtime: PySpark
    SparkOp -.->|"Spark workloads"| PySpark["pyspark 4.0.1"]
    PySpark -.->|"JVM bridge"| Py4J["py4j 0.10.9.9"]

    %% Styling
    style SparkOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OSConfig fill:#999,stroke:#333,color:#fff
    style CertMgr fill:#999,stroke:#333,color:#fff
    style PromOp fill:#999,stroke:#333,color:#fff
    style ODHOp fill:#7ed321,stroke:#333
    style ODHPlatUtils fill:#7ed321,stroke:#333
    style CtrlRuntime fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style SchedPlugins fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style Volcano fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style Helm fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style GoFIPS fill:#e8e8e8,stroke:#999,stroke-dasharray: 5 5
    style PySpark fill:#f5a623,stroke:#333
    style Py4J fill:#f5a623,stroke:#333
