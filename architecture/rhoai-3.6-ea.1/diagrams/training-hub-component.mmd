graph TB
    subgraph "Training Hub Library"
        direction TB
        Registry["AlgorithmRegistry<br/>(Plugin Registry)"]

        subgraph "Algorithms"
            SFT["SFT Algorithm<br/>(Supervised Fine-Tuning)"]
            OSFT["OSFT Algorithm<br/>(Orthogonal Subspace FT)"]
            LoRA["LoRA SFT Algorithm<br/>(Low-Rank Adaptation)"]
            GRPO["GRPO Algorithm<br/>(RL from Verifiable Rewards)"]
            GEPA["GEPA Algorithm<br/>(Gradient-Free Prompt Opt.)"]
        end

        subgraph "Backends"
            InstructLabBackend["InstructLab Backend<br/>(instructlab-training)"]
            MiniTrainerBackend["Mini-Trainer Backend<br/>(rhai-innovation-mini-trainer)"]
            UnslothBackend["Unsloth Backend<br/>(unsloth)"]
            ARTBackend["ART Backend<br/>(openpipe-art + vLLM)"]
            VeRLBackend["VeRL Backend<br/>(verl)"]
            GEPABackend["GEPA Backend<br/>(gepa + litellm)"]
            MLflowGEPABackend["MLflow GEPA Backend<br/>(gepa + mlflow)"]
        end

        subgraph "Utilities"
            Callback["TrainingHubCallback<br/>(Lifecycle Hooks)"]
            Profiler["Memory/Timing Profiler<br/>(Resource Estimator)"]
        end

        Registry -->|registers| SFT
        Registry -->|registers| OSFT
        Registry -->|registers| LoRA
        Registry -->|registers| GRPO
        Registry -->|registers| GEPA

        SFT -->|delegates to| InstructLabBackend
        OSFT -->|delegates to| MiniTrainerBackend
        LoRA -->|delegates to| UnslothBackend
        GRPO -->|delegates to| ARTBackend
        GRPO -->|delegates to| VeRLBackend
        GEPA -->|delegates to| GEPABackend
        GEPA -->|delegates to| MLflowGEPABackend
    end

    Caller[Data Scientist / Notebook / Training Job] -->|"sft(), osft(), lora_grpo(), gepa()"| Registry

    ARTBackend -->|co-located inference| vLLM["vLLM Engine<br/>(in-process)"]
    GEPABackend -->|outbound HTTP| LLMAPI["LLM Inference API<br/>(OPENAI_API_BASE)"]
    MLflowGEPABackend -->|outbound HTTP| LLMAPI
    MLflowGEPABackend -->|experiment tracking| MLflow["MLflow Tracking Server"]

    InstructLabBackend -->|writes| Checkpoints["Checkpoint Output<br/>(ckpt_output_dir)"]
    MiniTrainerBackend -->|writes| Checkpoints
    UnslothBackend -->|writes| Checkpoints
    ARTBackend -->|writes| Checkpoints

    style Registry fill:#4a90e2,stroke:#333
    style SFT fill:#7ed321,stroke:#333
    style OSFT fill:#7ed321,stroke:#333
    style LoRA fill:#7ed321,stroke:#333
    style GRPO fill:#7ed321,stroke:#333
    style GEPA fill:#7ed321,stroke:#333
    style InstructLabBackend fill:#f5a623,stroke:#333
    style MiniTrainerBackend fill:#f5a623,stroke:#333
    style UnslothBackend fill:#f5a623,stroke:#333
    style ARTBackend fill:#f5a623,stroke:#333
    style VeRLBackend fill:#f5a623,stroke:#333
    style GEPABackend fill:#f5a623,stroke:#333
    style MLflowGEPABackend fill:#f5a623,stroke:#333
    style Callback fill:#b8e6ff,stroke:#333
    style Profiler fill:#b8e6ff,stroke:#333
    style Caller fill:#e8e8e8,stroke:#333
    style vLLM fill:#999,stroke:#333
    style LLMAPI fill:#999,stroke:#333
    style MLflow fill:#999,stroke:#333
    style Checkpoints fill:#d5e8d4,stroke:#333
