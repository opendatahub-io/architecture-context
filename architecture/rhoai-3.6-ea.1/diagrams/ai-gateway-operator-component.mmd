graph TB
    subgraph "ai-gateway-operator"
        direction TB
        CLI["Cobra CLI Entrypoint<br/>(cmd/main.go)"]
        Operator["Operator Subcommand<br/>(cmd/operator/operator.go)"]
        Manager["controller-runtime Manager<br/>Leader Election Enabled"]
        Reconciler["AIGateway Reconciler<br/>(internal/controller/aigateway)"]
        Config["Viper Config Loader<br/>(pkg/config)<br/>ConfigMap + Env + Defaults"]
        MetricsServer["Metrics Server<br/>:8443/TCP HTTPS<br/>TokenReview Auth"]
        HealthProbes["Health Probes<br/>:8081/TCP HTTP<br/>/healthz /readyz"]

        CLI --> Operator
        Operator --> Manager
        Manager --> Reconciler
        Manager --> MetricsServer
        Manager --> HealthProbes
        Operator --> Config
    end

    %% Primary CR
    AIGatewayCR["AIGateway CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    AIGatewayCR -->|watched by| Reconciler

    %% Platform state inputs
    DSCI["DSCInitialization CR<br/>(dscinitialization.opendatahub.io)"]
    KServeIS["KServe LLMInferenceService<br/>(serving.kserve.io)"]
    DSCI -->|read by| Reconciler
    KServeIS -->|read by| Reconciler

    %% Owned sub-resources created by reconciler
    subgraph "Owned Sub-Resources"
        direction LR
        Deployments["Deployments"]
        Services["Services"]
        ConfigMaps["ConfigMaps"]
        RBAC["Roles / RoleBindings<br/>ClusterRoles / ClusterRoleBindings"]
        Webhooks["ValidatingWebhookConfigs"]
        CRDs["CustomResourceDefinitions"]
    end
    Reconciler -->|creates/manages| Deployments
    Reconciler -->|creates/manages| Services
    Reconciler -->|creates/manages| ConfigMaps
    Reconciler -->|creates/manages| RBAC
    Reconciler -->|creates/manages| Webhooks
    Reconciler -->|creates/manages| CRDs

    %% Networking & Security stack
    subgraph "Networking & Security Stack"
        direction LR
        HTTPRoutes["Gateway API<br/>HTTPRoutes"]
        CertMgr["cert-manager<br/>Certificates"]
        AuthPolicies["Kuadrant<br/>AuthPolicies<br/>RateLimitPolicies"]
        IstioRes["Istio<br/>DestinationRules<br/>EnvoyFilters<br/>ServiceEntries"]
        NetPolicies["NetworkPolicies"]
    end
    Reconciler -->|creates/manages| HTTPRoutes
    Reconciler -->|creates/manages| CertMgr
    Reconciler -->|creates/manages| AuthPolicies
    Reconciler -->|creates/manages| IstioRes
    Reconciler -->|creates/manages| NetPolicies

    %% Observability stack
    subgraph "Observability Stack"
        direction LR
        ServiceMonitors["ServiceMonitors<br/>PodMonitors"]
        PromRules["PrometheusRules"]
        OTelCollectors["OpenTelemetry<br/>Collectors"]
        Perses["Perses Dashboards<br/>& Datasources"]
    end
    Reconciler -->|creates/manages| ServiceMonitors
    Reconciler -->|creates/manages| PromRules
    Reconciler -->|creates/manages| OTelCollectors
    Reconciler -->|creates/manages| Perses

    %% MaaS sub-system
    subgraph "Multi-Tenant MaaS<br/>(maas.opendatahub.io)"
        direction LR
        AITenants["AITenants"]
        Subscriptions["MaaSSubscriptions"]
        MaaSAuth["MaaSAuthPolicies"]
        ModelRefs["MaaSModelRefs<br/>ExternalModels"]
    end
    Reconciler -->|creates/manages| AITenants
    Reconciler -->|creates/manages| Subscriptions
    Reconciler -->|creates/manages| MaaSAuth
    Reconciler -->|creates/manages| ModelRefs

    %% Batch gateway sub-component
    BatchGW["llm-d Batch Gateway<br/>(batch.llm-d.ai/llmbatchgateways)<br/>Managed via spec.batchGateway"]
    Reconciler -->|reconciles when Managed| BatchGW

    %% Styling
    style CLI fill:#4a90e2,color:#fff
    style Operator fill:#4a90e2,color:#fff
    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style Config fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style HealthProbes fill:#4a90e2,color:#fff
    style AIGatewayCR fill:#f5a623,color:#000
    style DSCI fill:#e8e8e8,color:#000
    style KServeIS fill:#e8e8e8,color:#000
    style BatchGW fill:#7ed321,color:#000
