graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Producer["Request Producer"]
    end

    subgraph BrokerTier["MESSAGE BROKER TIER"]
        direction LR
        Redis["Redis Broker<br/>:6379/TCP<br/>Configurable TLS<br/>Redis Auth"]
        GCPPubSub["GCP Pub/Sub<br/>:443/TCP<br/>TLS 1.2+<br/>GCP IAM"]
    end

    subgraph ProcessorPod["ASYNC PROCESSOR POD"]
        direction TB
        Processor["async-processor<br/>FIPS: strictfipsruntime + UBI 9<br/>TLS Client: Min 1.2, optional mTLS"]

        subgraph HealthEndpoints["Health & Metrics"]
            direction LR
            HealthServer["Health Server<br/>:8081/TCP HTTP<br/>No Auth (kubelet only)"]
            MetricsServer["Metrics Server<br/>:9090/TCP HTTP<br/>K8s Delegated Auth"]
        end
    end

    subgraph InferenceBackend["INFERENCE BACKEND (Internal)"]
        InferenceGW["Inference Gateway (vLLM)<br/>:8000/TCP<br/>HTTP/HTTPS TLS 1.2+<br/>Optional mTLS"]
    end

    subgraph Observability["OBSERVABILITY & CONTROL PLANE"]
        direction LR
        Prometheus["Prometheus<br/>:9090/TCP HTTP<br/>Flow-control queries"]
        OTelCollector["OTel Collector<br/>OTLP/gRPC<br/>Trace export"]
        K8sAPI["Kubernetes API<br/>:6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount"]
    end

    %% External to Broker
    Producer -->|"TCP/:6379 or HTTPS/:443<br/>Configurable TLS"| Redis
    Producer -->|"HTTPS/:443<br/>TLS 1.2+ / GCP IAM"| GCPPubSub

    %% Broker to Processor
    Redis -->|"RESP/:6379<br/>Configurable TLS<br/>Redis Auth"| Processor
    GCPPubSub -->|"HTTPS/:443<br/>TLS 1.2+<br/>GCP IAM"| Processor

    %% Processor to Backend
    Processor -->|"HTTP(S)/:8000<br/>TLS 1.2+ optional mTLS"| InferenceGW

    %% Processor to Observability
    Processor -->|"HTTP/:9090<br/>Metric queries"| Prometheus
    Processor -->|"OTLP/gRPC<br/>Trace spans"| OTelCollector
    Processor -->|"HTTPS/:6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Kubelet probes
    Kubelet["Kubelet"] -->|"HTTP/:8081<br/>No Auth"| HealthServer
    Kubelet -->|"HTTP/:8081<br/>No Auth"| HealthServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef broker fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef processor fill:#d5e8d4,stroke:#82b366,stroke-width:3px
    classDef backend fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef health fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Producer external
    class Redis,GCPPubSub broker
    class Processor processor
    class InferenceGW backend
    class Prometheus,OTelCollector,K8sAPI observability
    class HealthServer,MetricsServer health
    class Kubelet external
