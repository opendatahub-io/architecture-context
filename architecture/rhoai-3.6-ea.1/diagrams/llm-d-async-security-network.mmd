graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Producer["Request Producer"]
    end

    subgraph MessageBroker["MESSAGE BROKER (Infrastructure)"]
        direction LR
        Redis["Redis<br/>TCP<br/>Encryption: deployment-dependent"]
        GCPPubSub["GCP Pub/Sub<br/>gRPC<br/>TLS<br/>GCP IAM/OAuth2"]
    end

    subgraph Workload["WORKLOAD (llm-d-async Pod)<br/>UBI9 / FIPS: strictfipsruntime"]
        direction TB

        subgraph HealthSvr["Health Server"]
            Health["Port 8081/TCP<br/>HTTP/1.1<br/>No encryption<br/>No auth<br/>/healthz, /readyz"]
        end

        subgraph MetricsSvr["Metrics Server"]
            Metrics["Port 9090/TCP<br/>HTTP<br/>K8s Bearer Token + RBAC<br/>/metrics"]
        end

        subgraph InferenceClient["Inference HTTP Client"]
            HTTPClient["HTTP/HTTPS<br/>TLS 1.2+ min<br/>Optional mTLS<br/>Custom CA support"]
        end

        subgraph TransportLayer["Transport Layer"]
            Flow["pipeline.Flow<br/>(Redis PubSub | Redis SortedSet | GCP PubSub)"]
        end

        subgraph FlowControl["Flow Control"]
            Gate["Gate Factory<br/>(Prometheus-driven backpressure)"]
        end
    end

    subgraph ModelBackend["MODEL SERVING BACKEND"]
        ModelServer["Model Server<br/>HTTP/HTTPS<br/>TLS 1.2+<br/>Optional mTLS"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        PromServer["Prometheus Server<br/>HTTP/HTTPS<br/>Metrics Query"]
        OTELCollector["OTLP Collector<br/>gRPC (otlptracegrpc)<br/>Trace Export"]
    end

    Kubelet["Kubelet<br/>(pod-local network)"]

    %% Flows
    Producer -->|"Publish requests<br/>(transport-specific)"| Redis
    Producer -->|"Publish requests<br/>gRPC/TLS"| GCPPubSub

    Redis -->|"Consume/Produce<br/>TCP"| Flow
    GCPPubSub -->|"Consume/Produce<br/>gRPC/TLS"| Flow

    HTTPClient -->|"POST inference<br/>HTTP/HTTPS TLS 1.2+<br/>optional mTLS"| ModelServer

    Kubelet -->|"GET /healthz, /readyz<br/>HTTP/8081<br/>No auth"| Health

    Metrics -->|"Auth via<br/>HTTPS/6443<br/>Bearer Token"| K8sAPI

    Gate -->|"Query metrics<br/>HTTP/HTTPS"| PromServer

    HTTPClient -->|"Export traces<br/>gRPC"| OTELCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef broker fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef backend fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef extsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef probe fill:#e8e8e8,stroke:#666,stroke-width:1px

    class Producer external
    class Redis,GCPPubSub broker
    class Health,Metrics,HTTPClient,Flow,Gate workload
    class ModelServer backend
    class K8sAPI,PromServer,OTELCollector extsvc
    class Kubelet probe
