graph TB
    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(llm-d-batch-gateway-operator-system)"]
        direction TB

        Operator["llm-d-batch-gateway-operator<br/>SA: llm-d-batch-gateway-operator<br/>Image: controller:latest"]

        subgraph Probes["Health Probes (Unauthenticated)"]
            Healthz["/healthz :8081<br/>HTTP GET"]
            Readyz["/readyz :8081<br/>HTTP GET"]
        end

        subgraph MetricsEndpoint["Metrics Endpoint"]
            MetricsSvc["llm-d-batch-gateway-<br/>operator-metrics<br/>ClusterIP 8443/TCP<br/>HTTPS (self-signed TLS)<br/>Auth: None"]
        end

        Operator --- Probes
        Operator --- MetricsEndpoint
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+"]
    end

    subgraph UserNS["USER NAMESPACE (deployed workloads)"]
        direction TB
        APIServer["API Server<br/>Deployment"]
        ReqProcessor["Request Processor<br/>Deployment"]
        GarbageCollector["Garbage Collector<br/>Deployment"]
        AsyncProcessor["Async Processor<br/>Deployment (conditional)"]
    end

    subgraph ConditionalIntegrations["CONDITIONAL PLATFORM INTEGRATIONS"]
        CertManager["cert-manager<br/>Certificate CRs<br/>TLS 1.2+"]
        GatewayAPI["Gateway API<br/>HTTPRoute CRs<br/>TLS 1.2+"]
        PromOperator["prometheus-operator<br/>ServiceMonitor/PodMonitor/<br/>PrometheusRule CRs<br/>TLS 1.2+"]
    end

    subgraph CrossNS["CROSS-NAMESPACE SECRET SYNC"]
        SourceNS["Source Namespace<br/>ReferenceGrant required"]
        TargetNS["Gateway Namespace<br/>Managed Secret copy"]
    end

    %% Flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token + RBAC"| K8sAPI
    K8sAPI -->|"Watch events<br/>LLMBatchGateway CR"| Operator

    Operator -->|"Server-Side Apply<br/>via K8s API"| APIServer
    Operator -->|"Server-Side Apply<br/>via K8s API"| ReqProcessor
    Operator -->|"Server-Side Apply<br/>via K8s API"| GarbageCollector
    Operator -->|"Server-Side Apply<br/>via K8s API"| AsyncProcessor

    Operator -.->|"CRD CRUD<br/>if detected"| CertManager
    Operator -.->|"CRD CRUD<br/>if detected"| GatewayAPI
    Operator -.->|"CRD CRUD<br/>if detected"| PromOperator

    Operator -->|"Read Secret<br/>ReferenceGrant gate"| SourceNS
    SourceNS -->|"Copy Secret"| TargetNS

    MetricsSvc -.->|"Scraped by"| PromOperator

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef k8s fill:#326ce5,stroke:#333,stroke-width:2px,color:#fff
    classDef workload fill:#7ed321,stroke:#333,stroke-width:1px,color:#000
    classDef conditional fill:#e8e8e8,stroke:#999,stroke-width:1px,stroke-dasharray:5 5
    classDef probe fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef metrics fill:#ffe6cc,stroke:#d79b00,stroke-width:1px
    classDef crossns fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class Operator operator
    class K8sAPI k8s
    class APIServer,ReqProcessor,GarbageCollector,AsyncProcessor workload
    class CertManager,GatewayAPI,PromOperator conditional
    class Healthz,Readyz probe
    class MetricsSvc metrics
    class SourceNS,TargetNS crossns
