graph TB
    subgraph ControlPlane["Control Plane"]
        direction TB
        Gateway["openshell-server<br/>(Gateway)<br/>8080/TCP gRPC+HTTP<br/>8081/TCP Health<br/>9090/TCP Metrics"]
        AuthZ["Descriptor-Based AuthZ<br/>#[rpc_authz] Macros"]
        Router["openshell-router<br/>Inference Router"]
        Policy["openshell-policy<br/>Policy Engine"]
        Prover["openshell-prover<br/>Z3 SMT Verification"]
        Core["openshell-core<br/>Shared Types + Protos"]
        Providers["openshell-providers<br/>14+ LLM/Cloud Backends"]
        OCSF["openshell-ocsf<br/>OCSF v1.7.0 Events"]
        OTel["openshell-otel<br/>OTLP Tracing"]

        Gateway -->|validates RPCs| AuthZ
        Gateway -->|routes inference| Router
        Gateway -->|evaluates| Policy
        Gateway -->|verifies policies| Prover
        Gateway -->|shared types| Core
        Gateway -->|credential backends| Providers
        Gateway -->|audit events| OCSF
        Gateway -->|trace export| OTel
    end

    subgraph DataPlane["Data Plane (Sandbox)"]
        direction TB
        Supervisor["openshell-sandbox<br/>(Supervisor)<br/>Unix Sockets"]
        NetProxy["supervisor-network<br/>OPA + L7 Proxy<br/>nftables Interception"]
        ProcMgr["supervisor-process<br/>seccomp + Landlock<br/>Network NS Setup"]
        Middleware["supervisor-middleware<br/>Request Inspection"]

        Supervisor -->|network enforcement| NetProxy
        Supervisor -->|process isolation| ProcMgr
        Supervisor -->|request hooks| Middleware
    end

    subgraph ComputeDrivers["Compute Drivers"]
        K8sDriver["driver-kubernetes<br/>Pod + Sidecar Topology"]
        DockerDriver["driver-docker<br/>Bollard REST API"]
        PodmanDriver["driver-podman<br/>Rootless Support"]
        VMDriver["driver-vm<br/>KVM/QEMU + GPU Passthrough"]
    end

    subgraph CredentialDrivers["Credential Drivers"]
        VaultDriver["driver-vault<br/>KV v1/v2"]
        K8sSecrets["driver-kubernetes-secrets<br/>K8s Secret Objects"]
        DBCred["driver-db-credstore<br/>AES-256-GCM Encrypted"]
    end

    subgraph ClientTooling["Client Tooling"]
        CLI["openshell-cli<br/>OIDC Device Flow"]
        SDK["openshell-sdk<br/>Async gRPC Client"]
        TUI["openshell-tui<br/>Ratatui Dashboard"]
        PythonSDK["Python SDK<br/>maturin Bindings"]
        Bootstrap["openshell-bootstrap<br/>mTLS + JWT Persistence"]

        CLI -->|uses| SDK
        TUI -->|uses| SDK
        SDK -->|discovery| Bootstrap
    end

    %% Cross-subgraph connections
    User[User / AI Agent] -->|gRPC / OIDC JWT| CLI
    CLI -->|gRPC TLS 1.2+| Gateway
    PythonSDK -->|gRPC TLS 1.2+| Gateway
    Gateway -->|creates sandboxes| K8sDriver
    Gateway -->|creates sandboxes| DockerDriver
    Gateway -->|creates sandboxes| PodmanDriver
    Gateway -->|creates sandboxes| VMDriver
    Gateway -->|stores credentials| VaultDriver
    Gateway -->|stores credentials| K8sSecrets
    Gateway -->|stores credentials| DBCred
    Gateway -->|sandbox JWT| Supervisor
    Supervisor -->|ConnectSupervisor stream| Gateway

    SandboxCR["Sandbox CR<br/>agents.x-k8s.io/v1beta1"] -->|watched by| K8sDriver

