graph LR
    RhodsOp["rhods-operator<br/>(controller-runtime 0.24.1)"]

    %% External Platform Dependencies
    RhodsOp -->|"ingress routing<br/>(GatewayClass, Gateway, HTTPRoute)"| GatewayAPI["Gateway API 1.3"]
    RhodsOp -.->|"conditional<br/>(EnvoyFilter, DestinationRule)"| Istio["Istio Service Mesh"]
    RhodsOp -->|"TLS certificate<br/>provisioning"| ServiceCA["OpenShift service-ca"]
    RhodsOp -->|"TLS profile<br/>configuration"| APIServer["OpenShift APIServer"]
    RhodsOp -->|"monitoring resources<br/>(PodMonitor, PrometheusRule)"| PromOp["prometheus-operator 0.74"]
    RhodsOp -->|"OAuth integration<br/>(ROSA, conditional)"| OAuthServer["OpenShift OAuth"]

    %% Internal ODH Dependencies
    RhodsOp -->|"RBAC trigger<br/>(namespace watch)"| Kuadrant["Kuadrant"]
    RhodsOp -->|"RBAC trigger +<br/>Go library"| MaaS["models-as-a-service"]

    %% Managed Component CRDs
    RhodsOp -->|"manages lifecycle"| DSP["DataSciencePipelines"]
    RhodsOp -->|"manages lifecycle"| Kueue["Kueue"]
    RhodsOp -->|"manages lifecycle"| ModelReg["ModelRegistry"]
    RhodsOp -->|"manages lifecycle"| Ray["Ray"]
    RhodsOp -->|"manages lifecycle"| Spark["SparkOperator"]
    RhodsOp -->|"manages lifecycle"| Trainer["Trainer"]
    RhodsOp -->|"manages lifecycle"| TrainOp["TrainingOperator"]
    RhodsOp -->|"manages lifecycle"| TrustyAI["TrustyAI"]

    %% Core Runtime Dependencies
    RhodsOp -->|"all resource<br/>operations"| K8sAPI["Kubernetes API<br/>6443/TCP TLS 1.2+"]
    RhodsOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>0.24.1"]
    RhodsOp -->|"cluster version,<br/>infrastructure"| OCPCluster["OpenShift Cluster<br/>Config"]

