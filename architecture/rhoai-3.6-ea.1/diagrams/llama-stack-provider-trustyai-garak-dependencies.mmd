graph LR
    LSPTG["llama-stack-provider-<br/>trustyai-garak<br/>(K8s Job)"]

    %% Core Runtime Dependencies
    LSPTG -->|"red-teaming<br/>framework"| Garak["garak 0.15.0+rhaiv.5"]
    LSPTG -->|"evaluation<br/>orchestration"| EvalHub["eval-hub-sdk ~=0.4.2"]
    LSPTG -->|"S3 operations"| Boto3["boto3 >=1.35.88"]
    LSPTG -->|"K8s client"| K8sClient["kubernetes 36.0.2"]

    %% Internal Platform Dependencies
    LSPTG -->|"pipeline submission<br/>+ polling"| KFP["kfp >=2.14.6"]
    LSPTG -->|"K8s extensions"| KFPK8s["kfp-kubernetes >=2.14.6"]

    %% ML/AI Libraries
    LSPTG -->|"ML inference"| Torch["torch 2.11.0"]
    LSPTG -->|"tokenization"| Transformers["transformers 5.13.0"]
    LSPTG -->|"LLM proxy"| LiteLLM["litellm 1.84.0"]
    LSPTG -->|"OpenAI compat"| OpenAI["openai 2.45.0"]

    %% Security Dependencies
    LSPTG -.->|"TLS/crypto<br/>(transitive)"| Crypto["cryptography 49.0.0"]
    LSPTG -.->|"JWT auth<br/>(transitive)"| PyJWT["pyjwt 2.13.0"]

    %% External Services
    LSPTG -->|"results upload"| S3["S3-Compatible Storage"]
    LSPTG -->|"probe execution"| LLM["Target LLM Endpoint"]

    %% Platform Integration
    KFP -->|"submits to"| KFPService["Kubeflow Pipelines<br/>Platform Service"]

