    CRB_CollectorProc -->|grants| CR_GenProc
    SA_Alertmanager -->|bound via| CRB_Alertmanager
    CRB_Alertmanager -->|grants| CR_MonView

    %% Role to resource mappings
    CR_Manager -->|"full lifecycle mgmt"| R_DSC
    CR_Manager -->|"full lifecycle mgmt"| R_Components
    CR_Manager -->|"full lifecycle mgmt"| R_Services

    CR_AdminCluster -->|"get,list,patch,update,watch"| R_DSC
    CR_AdminCluster -->|"CRUD"| R_ModelReg
    CR_AdminCluster -->|"get,list,watch"| R_MaaS

    CR_AdminGroup -->|"get,list,patch,update,watch"| R_Services
    CR_AdminGroup -->|"CRUD"| R_Infra
    CR_AdminGroup -->|"get,list,watch"| R_OpenShift

    CR_AdminMaaS -->|"CRUD"| R_MaaS
    CR_AllowedGroup -->|"get,list,watch"| R_Services

    CR_GenProc -->|"get,list,watch"| R_Monitoring

