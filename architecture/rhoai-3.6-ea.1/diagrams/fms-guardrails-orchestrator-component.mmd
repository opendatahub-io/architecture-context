graph TB
    subgraph "FMS Guardrails Orchestrator"
        direction TB
        subgraph "Guardrails API (Port 8033)"
            V1Class["/api/v1/.../classification-with-text-generation<br/>POST"]
            V1Stream["/api/v1/.../server-streaming-classification-...<br/>POST"]
            V2ChatComp["/api/v2/chat/completions-detection<br/>POST (conditional)"]
            V2TextComp["/api/v2/text/completions-detection<br/>POST (conditional)"]
            V2DetChat["/api/v2/text/detection/chat<br/>POST"]
            V2DetContent["/api/v2/text/detection/content<br/>POST"]
            V2DetContext["/api/v2/text/detection/context<br/>POST"]
            V2DetGen["/api/v2/text/detection/generated<br/>POST"]
            V2DetStream["/api/v2/text/detection/stream-content<br/>POST"]
            V2GenDet["/api/v2/text/generation-detection<br/>POST"]
        end

        subgraph "Health API (Port 8034)"
            Health["/health - GET"]
            Info["/info - GET"]
        end

        Orchestr8["fms-guardrails-orchestr8<br/>Rust Binary (axum + tonic)<br/>Multi-arch: amd64, ppc64le, s390x"]
        TLSLayer["TLS Layer<br/>rustls + ring provider<br/>Optional server TLS & mTLS"]
        AuthLayer["Auth Layer<br/>Header passthrough<br/>X-Forwarded-Access-Token rewrite"]
        OTel["OpenTelemetry<br/>OTLP traces & metrics"]
    end

    Consumer[API Consumer] -->|"POST /api/v1/* or /api/v2/*<br/>8033/TCP, TLS optional"| TLSLayer
    TLSLayer --> AuthLayer
    AuthLayer --> Orchestr8
    Probe[Platform / Probe] -->|"GET /health, /info<br/>8034/TCP, No TLS"| Health

    Orchestr8 -->|"gRPC :8085<br/>TLS optional"| Chunker[Chunker Services]
    Orchestr8 -->|"REST :8080<br/>TLS optional, Bearer optional"| Detector[Detector Services]
    Orchestr8 -->|"gRPC :8033<br/>No encryption"| TGIS[TGIS Generation Service]
    Orchestr8 -->|"REST :8081<br/>No encryption"| DetectorHealth[Detector Health Services]
    Orchestr8 -->|"OTLP gRPC/HTTP"| OTLPCollector[OTLP Collector]

    style Orchestr8 fill:#4a90e2,color:#fff
    style TLSLayer fill:#e8544f,color:#fff
    style AuthLayer fill:#f5a623,color:#fff
    style OTel fill:#9b59b6,color:#fff
    style Consumer fill:#f9f9f9,stroke:#999
    style Probe fill:#f9f9f9,stroke:#999
    style Chunker fill:#e8e8e8,stroke:#333
    style Detector fill:#e8e8e8,stroke:#333
    style TGIS fill:#e8e8e8,stroke:#333
    style DetectorHealth fill:#e8e8e8,stroke:#333
    style OTLPCollector fill:#e8e8e8,stroke:#333
