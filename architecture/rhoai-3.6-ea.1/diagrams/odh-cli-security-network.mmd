graph TB
    subgraph UserWorkstation["USER WORKSTATION (Local)"]
        User["CLI User / kubectl<br/>kubeconfig credential chain"]
    end

    subgraph CLIProcess["CLI PROCESS (FIPS-compliant)"]
        direction TB
        CLI["odh-cli (kubectl-odh / rhai-cli)<br/>CGO_ENABLED=1<br/>GOEXPERIMENT=strictfipsruntime<br/>Base: ose-cli-rhel9"]
        RBACCheck["RBAC Pre-flight<br/>SelfSubjectAccessReview"]
        CLI --> RBACCheck
    end

    subgraph K8sControlPlane["KUBERNETES CONTROL PLANE"]
        direction TB
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforced"]
        OLMAPI["OLM API<br/>(CSVs, Subscriptions)<br/>via kube-apiserver"]
    end

    subgraph InCluster["IN-CLUSTER SERVICES"]
        TrustYAISvc["TrustYAI Service<br/>443/TCP HTTPS<br/>TLS 1.2+ (self-signed)<br/>InsecureSkipVerify=true"]
    end

    subgraph MCPMode["MCP SERVER (Optional)"]
        direction TB
        MCPEndpoint["MCP Server<br/>8080/TCP HTTP (SSE)<br/>or stdin/stdout (stdio)<br/>No TLS on SSE transport"]
    end

    subgraph AIAgent["AI AGENT"]
        Agent["MCP Client<br/>(AI Agent)"]
    end

    %% User → CLI
    User -->|"invokes CLI<br/>kubeconfig flags"| CLI

    %% CLI → Kubernetes API
    RBACCheck -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer / Client Cert / OIDC"| APIServer
    CLI -->|"HTTPS/6443<br/>TLS 1.2+<br/>Resource CRUD + Watch"| APIServer
    CLI -->|"HTTPS/6443<br/>OLM queries"| OLMAPI

    %% CLI → TrustYAI (migration only)
    CLI -->|"HTTPS/443<br/>TLS 1.2+ (InsecureSkipVerify)<br/>Bearer token from kubeconfig<br/>Migration only"| TrustYAISvc

    %% MCP flow
    Agent -->|"JSON-RPC<br/>HTTP SSE 8080/TCP (no TLS)<br/>or stdio"| MCPEndpoint
    MCPEndpoint -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig-inherited"| APIServer

    %% Styling
    classDef local fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cli fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef incluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef mcp fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef agent fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User local
    class CLI,RBACCheck cli
    class APIServer,OLMAPI controlplane
    class TrustYAISvc incluster
    class MCPEndpoint mcp
    class Agent agent
