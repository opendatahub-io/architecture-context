graph TB
    subgraph "vllm-gaudi Container Image"
        direction TB

        subgraph "Entrypoint Layer"
            Entrypoint["vllm.entrypoints.openai.api_server<br/>OpenAI-compatible HTTP API"]
        end

        subgraph "vLLM Core (upstream v0.16.0)"
            APIServer["vLLM API Server<br/>HTTP :8000"]
            Engine["Inference Engine<br/>Model execution orchestration"]
            DeviceAbstraction["Device Abstraction Layer<br/>Pluggable backend interface"]
        end

        subgraph "vllm_gaudi Plugin Package"
            HPUWorker["HPU Worker<br/>vllm_gaudi/v1/worker/"]
            ModelRunner["HPU Model Runner<br/>Gaudi-optimized execution"]
            MemoryMgr["HPU Memory Manager<br/>Gaudi memory allocation"]
            Scheduler["HPU Scheduler<br/>Scheduling optimizations"]
            SpecDecode["Speculative Decoding<br/>HPU-specific implementation"]
            DPUtils["Data Parallel Utils<br/>hpu_dp_utils.py"]
        end

        subgraph "Runtime Stack"
            SynapseAI["Intel SynapseAI Runtime<br/>HPU drivers & graph compiler"]
            PyTorchGaudi["PyTorch for Gaudi<br/>DL framework with HPU support"]
        end

        Entrypoint --> APIServer
        APIServer --> Engine
        Engine --> DeviceAbstraction
        DeviceAbstraction --> HPUWorker
        HPUWorker --> ModelRunner
        HPUWorker --> MemoryMgr
        HPUWorker --> Scheduler
        HPUWorker --> SpecDecode
        HPUWorker --> DPUtils
        ModelRunner --> PyTorchGaudi
        PyTorchGaudi --> SynapseAI
    end

    Client[Client / KServe Proxy] -->|"OpenAI-compatible<br/>HTTP requests"| Entrypoint
    ModelStorage["Model Storage<br/>(configured at startup)"] -.->|"Model weights<br/>loaded at init"| Engine

    subgraph "Base Image"
        UBI9["UBI 9 Base<br/>registry.access.redhat.com/ubi9/ubi"]
    end

    style Entrypoint fill:#4a90e2,stroke:#333,color:#fff
    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Engine fill:#4a90e2,stroke:#333,color:#fff
    style DeviceAbstraction fill:#4a90e2,stroke:#333,color:#fff
    style HPUWorker fill:#7ed321,stroke:#333,color:#fff
    style ModelRunner fill:#7ed321,stroke:#333,color:#fff
    style MemoryMgr fill:#7ed321,stroke:#333,color:#fff
    style Scheduler fill:#7ed321,stroke:#333,color:#fff
    style SpecDecode fill:#7ed321,stroke:#333,color:#fff
    style DPUtils fill:#7ed321,stroke:#333,color:#fff
    style SynapseAI fill:#f5a623,stroke:#333,color:#fff
    style PyTorchGaudi fill:#f5a623,stroke:#333,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style ModelStorage fill:#e8e8e8,stroke:#333
    style UBI9 fill:#cc0000,stroke:#333,color:#fff
