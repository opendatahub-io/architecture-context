graph TB
    subgraph "odh-observability Operator"
        Manager["Manager Process<br/>:8081 health/ready"]
        Reconciler["MonitoringReconciler<br/>controller-runtime"]
        Webhook["Webhook Server<br/>:9443/TCP TLS"]
        Deployer["deploy.Deployer<br/>(odh-platform-utilities)<br/>Server-Side Apply"]
        Manager --> Reconciler
        Manager --> Webhook
        Reconciler -->|renders templates &<br/>applies manifests| Deployer
    end

    subgraph "Data Plane - Metrics Proxies"
        ClusterProxy["kube-rbac-proxy<br/>(cluster-proxy)<br/>:8443/TCP"]
        NamespaceProxy["kube-rbac-proxy<br/>(namespace-proxy)<br/>:8443/TCP"]
        PromLabelProxy["prom-label-proxy<br/>namespace filtering<br/>:9090/TCP"]
        NamespaceProxy --> PromLabelProxy
    end

    subgraph "Data Plane - Monitoring"
        Prometheus["Prometheus<br/>(prometheus-operated)<br/>:9090/TCP"]
        Collector["OpenTelemetry Collector<br/>:8889/TCP"]
    end

    subgraph "External Access - OpenShift Routes"
        ClusterRoute["Route: data-science-prometheus-cluster-proxy<br/>HTTPS/TLS"]
        PrometheusRoute["Route: data-science-prometheus-route<br/>HTTPS/TLS"]
        ThanosRoute["Route: data-science-thanos-querier-route<br/>HTTPS/TLS"]
    end

    MonitoringCR["Monitoring CR<br/>services.platform.opendatahub.io/v1alpha1<br/>Cluster-scoped"]

    MonitoringCR -->|watched by| Reconciler
    Reconciler -->|creates & manages| ClusterProxy
    Reconciler -->|creates & manages| NamespaceProxy
    Reconciler -->|creates & manages| Prometheus
    Reconciler -->|creates & manages| Collector
    Reconciler -->|creates & manages| ClusterRoute
    Reconciler -->|creates & manages| PrometheusRoute
    Reconciler -->|creates & manages| ThanosRoute

    ClusterRoute -->|terminates TLS| ClusterProxy
    ClusterProxy -->|mTLS| Prometheus
    NamespaceProxy -->|mTLS| Prometheus
    PromLabelProxy -->|filters metrics| Prometheus

    Webhook -->|mutates| PodMonitors["PodMonitor / ServiceMonitor<br/>Label Injection"]

    DSWorkloads["Data Science Workloads"] -->|scraped by| Prometheus
    Collector -->|forwards usage logs| LokiStack["LokiStack"]

    K8sAPI["Kubernetes API<br/>:6443"] -->|admission request| Webhook
    Reconciler -->|CRUD operations| K8sAPI

    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style Deployer fill:#4a90e2,color:#fff
    style MonitoringCR fill:#f5a623,color:#fff
    style ClusterProxy fill:#9b59b6,color:#fff
    style NamespaceProxy fill:#9b59b6,color:#fff
    style PromLabelProxy fill:#9b59b6,color:#fff
    style Prometheus fill:#e74c3c,color:#fff
    style Collector fill:#e74c3c,color:#fff
    style ClusterRoute fill:#2ecc71,color:#fff
    style PrometheusRoute fill:#2ecc71,color:#fff
    style ThanosRoute fill:#2ecc71,color:#fff
    style K8sAPI fill:#e8e8e8
    style DSWorkloads fill:#e8e8e8
    style LokiStack fill:#e8e8e8
    style PodMonitors fill:#f5a623,color:#fff
