graph TB
    subgraph "pipelines-components"
        direction TB

        subgraph InitContainer["Init Container"]
            InitScript["init_managed_pipelines<br/>Python module<br/>One-shot filesystem copy"]
        end

        subgraph ComponentLibrary["KFP Component Library"]
            direction TB

            subgraph DataProcessing["Data Processing"]
                ParseChunk["parse_and_chunk<br/>@dsl.component"]
                TabularLoader["tabular_data_loader<br/>@dsl.component"]
                SDG["synthetic_data_generation<br/>@dsl.component"]
            end

            subgraph Training["Training"]
                AutoML["AutoML (AutoGluon)<br/>@dsl.component"]
                AutoRAG["AutoRAG Template Opt.<br/>@dsl.component"]
            end

            subgraph Evaluation["Evaluation"]
                LMEval["lm-eval<br/>@dsl.component"]
            end

            subgraph Deployment["Deployment"]
                ModelDeploy["model_deployment<br/>@dsl.component"]
            end

            subgraph DatasetDL["Dataset"]
                DatasetDownload["dataset_download<br/>@dsl.component"]
            end
        end

        subgraph BuildTime["Build-Time Pipeline"]
            GenPipelines["generate_managed_pipelines<br/>Compiles pipeline YAMLs"]
        end
    end

    %% Init container flow
    GenPipelines -->|"pre-compiles at build"| InitScript
    InitScript -->|"copies YAMLs to<br/>/config/managed-pipelines"| SharedVolume["Shared Volume<br/>/config/managed-pipelines"]
    SharedVolume -->|"mounted by"| KFPServer["KFP API Server"]

    %% Component runtime dependencies
    ParseChunk -->|"boto3 SDK"| S3["S3-Compatible Storage"]
    TabularLoader -->|"boto3 SDK"| S3
    DatasetDownload -->|"huggingface-hub"| HFHub["HuggingFace Hub"]
    ParseChunk -->|"CodeFlare SDK"| Ray["Ray Cluster"]
    AutoML -->|"CodeFlare SDK"| Ray
    LMEval -->|"CodeFlare SDK"| Ray
    ModelDeploy -->|"kubernetes client"| K8sAPI["Kubernetes API"]

    %% KFP orchestration
    KFPServer -->|"orchestrates execution"| ComponentLibrary

    %% Styling
    style InitContainer fill:#4a90e2,stroke:#333,color:#fff
    style ComponentLibrary fill:#f0f8ff,stroke:#4a90e2
    style DataProcessing fill:#e8f5e9,stroke:#82b366
    style Training fill:#fff3e0,stroke:#f5a623
    style Evaluation fill:#fce4ec,stroke:#e57373
    style Deployment fill:#e3f2fd,stroke:#64b5f6
    style DatasetDL fill:#f3e5f5,stroke:#ab47bc
    style BuildTime fill:#fff9c4,stroke:#fbc02d
    style S3 fill:#f5a623,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style Ray fill:#f5a623,stroke:#333
    style HFHub fill:#f5a623,stroke:#333
    style KFPServer fill:#7ed321,stroke:#333
    style SharedVolume fill:#e8e8e8,stroke:#333
