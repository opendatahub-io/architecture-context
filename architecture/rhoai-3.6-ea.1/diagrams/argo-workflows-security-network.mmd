graph TB
    subgraph Internal["INTERNAL CLIENTS (Cluster-Internal)"]
        DSP["DSP Operator<br/>Deploys & configures"]
        Client["API Client / Pipeline SDK"]
    end

    subgraph ArgoServerZone["ARGO SERVER (ClusterIP)"]
        direction TB
        ArgoSvc["argo-server Service<br/>ClusterIP 2746/TCP"]

        subgraph AuthZone["Authentication Enforcement"]
            Gatekeeper["gRPC Gatekeeper<br/>Unary + Stream Interceptors"]
            ClientMode["Client Mode<br/>Bearer token → K8s API"]
            ServerMode["Server Mode<br/>Server SA auth"]
            SSOMode["SSO Mode<br/>OIDC token validation"]
            Gatekeeper --- ClientMode
            Gatekeeper --- ServerMode
            Gatekeeper --- SSOMode
        end

        ArgoSvc --> Gatekeeper

        gRPC["9 gRPC Services<br/>WorkflowService<br/>CronWorkflowService<br/>EventService ..."]
        HTTP["18 HTTP Endpoints<br/>/api/ /artifacts/<br/>/oauth2/ /metrics"]
    end

    subgraph ControllerZone["WORKFLOW CONTROLLER"]
        WFC["workflow-controller<br/>Reconciliation Loop"]
        Health["/healthz<br/>Port 6060/TCP<br/>No Auth"]
    end

    subgraph StepPodZone["STEP PODS (Ephemeral)"]
        StepPod["Step Pod<br/>+ argoexec sidecar<br/>Artifact I/O"]
    end

    subgraph K8sZone["KUBERNETES API SERVER"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph CRDZone["CRDs (argoproj.io/v1alpha1)"]
        Workflow["Workflow<br/>(Namespaced)"]
        CronWF["CronWorkflow<br/>(Namespaced)"]
        WFTemplate["WorkflowTemplate<br/>(Namespaced)"]
        ClusterWFT["ClusterWorkflowTemplate<br/>(Cluster)"]
    end

    %% Flows
    DSP -->|"Deploys"| ArgoServerZone
    DSP -->|"Deploys"| ControllerZone
    Client -->|"gRPC+HTTP/2746<br/>Bearer/OIDC"| ArgoSvc

    ArgoSvc -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    WFC -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    StepPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    WFC -->|"Creates"| StepPod
    WFC -->|"Watches"| Workflow
    WFC -->|"Watches"| CronWF

    %% Styling
    classDef internal fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef argoserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef steppod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef crd fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class DSP,Client internal
    class ArgoSvc,gRPC,HTTP argoserver
    class Gatekeeper,ClientMode,ServerMode,SSOMode auth
    class WFC,Health controller
    class StepPod steppod
    class K8sAPI k8s
    class Workflow,CronWF,WFTemplate,ClusterWFT crd
