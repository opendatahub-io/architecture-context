graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS Edge Termination)"]
        RoutePlanner["Route: planner<br/>HTTPS/443 → HTTP/8501<br/>TLS Edge Termination<br/>No OAuth Proxy"]
        RouteBackend["Route: planner-backend<br/>HTTPS/443 → HTTP/8000<br/>TLS Edge Termination<br/>No OAuth Proxy"]
    end

    subgraph PlannerNS["NAMESPACE: planner (No Service Mesh)"]
        direction TB

        UI["Streamlit UI<br/>Service: ui (ClusterIP)<br/>Port: 8501/TCP<br/>SA: default"]

        Backend["FastAPI Backend<br/>Service: backend (ClusterIP)<br/>Port: 8000/TCP<br/>SA: planner-backend<br/>CORS: allow_origins=[*]<br/>Auth: NONE (37 endpoints)"]

        Postgres["PostgreSQL 16<br/>Service: postgres (ClusterIP)<br/>Port: 5432/TCP<br/>Auth: Password"]

        OllamaServer["Ollama Server<br/>Service: ollama (ClusterIP)<br/>Port: 11434/TCP<br/>Auth: None"]

        ServiceCA["Service CA Bundle<br/>/etc/pki/service-ca"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>Port: 6443/TCP<br/>TLS 1.2+<br/>Auth: SA Token"]
        OpenAIAPI["OpenAI-compatible API<br/>HTTPS/TLS<br/>Auth: API Key"]
        VertexAI["Google Vertex AI<br/>HTTPS/TLS"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth"| RoutePlanner
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>No Auth"| RouteBackend

    %% Ingress to Services
    RoutePlanner -->|"HTTP/8501<br/>Plaintext<br/>No Auth"| UI
    RouteBackend -->|"HTTP/8000<br/>Plaintext<br/>No Auth"| Backend

    %% Internal flows
    UI -->|"HTTP/8000<br/>Plaintext<br/>No Auth"| Backend
    Backend -->|"PostgreSQL/5432<br/>Plaintext<br/>Password Auth"| Postgres
    Backend -->|"HTTP/11434<br/>Plaintext<br/>No Auth"| OllamaServer
    Backend -.->|"CA Trust"| ServiceCA

    %% External service flows
    Backend -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token Auth"| K8sAPI
    Backend -->|"HTTPS<br/>TLS<br/>API Key Auth"| OpenAIAPI
    Backend -->|"HTTPS<br/>TLS"| VertexAI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef datastore fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class RoutePlanner,RouteBackend ingress
    class UI internal
    class Backend warning
    class Postgres,OllamaServer datastore
    class ServiceCA internal
    class K8sAPI,OpenAIAPI,VertexAI externalservice
