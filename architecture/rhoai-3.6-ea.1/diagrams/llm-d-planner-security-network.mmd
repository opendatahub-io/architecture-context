graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Platform Operator / User"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS Termination)"]
        RouteUI["Route: planner<br/>HTTPS → 8501/TCP<br/>TLS Edge Termination<br/>Auth: None"]
        RouteAPI["Route: planner-backend<br/>HTTPS → 8000/TCP<br/>TLS Edge Termination<br/>Auth: None"]
    end

    subgraph Namespace["NAMESPACE: planner (ClusterIP Isolation)"]
        direction TB

        subgraph SvcUI["Service: ui (ClusterIP)"]
            StreamlitUI["Streamlit UI<br/>SA: default<br/>Image: quay.io/llm-d-planner/<br/>llm-d-planner-ui:latest<br/>No auth middleware"]
        end

        subgraph SvcBackend["Service: backend (ClusterIP)"]
            FastAPI["FastAPI Backend<br/>SA: planner-backend<br/>Image: quay.io/llm-d-planner/<br/>llm-d-planner-backend:latest<br/>CORS: allow_origins=[*]<br/>No auth middleware"]
            SQLite["SQLite DB<br/>/app/db/planner.db<br/>PVC: planner-data-pvc (1Gi)<br/>Admin: DB_ADMIN_PASSWORD"]
        end

        subgraph SvcOllama["Service: ollama (ClusterIP)"]
            Ollama["Ollama<br/>Image: ollama/ollama:latest<br/>No auth"]
        end

        FastAPI -->|reads/writes| SQLite
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        OpenAIEndpoint["OpenAI-compatible API<br/>HTTPS<br/>TLS<br/>OPENAI_API_KEY"]
        VertexAI["Google Vertex AI<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP Credentials"]
        HFHub["Hugging Face Hub<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>HF_TOKEN"]
    end

    subgraph SecretStore["SECRETS"]
        PlannerSecrets["planner-secrets (Opaque)<br/>HF_TOKEN<br/>OPENAI_API_KEY<br/>DB_ADMIN_PASSWORD<br/>MODEL_CATALOG_TOKEN<br/>AA_API_KEY"]
        ServiceCA["OpenShift Service CA<br/>/etc/pki/service-ca"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS (Route)"| RouteUI
    User -->|"HTTPS/443<br/>TLS (Route)"| RouteAPI

    %% Ingress to Services (post-TLS termination)
    RouteUI -->|"HTTP/8501<br/>No encryption<br/>No auth"| StreamlitUI
    RouteAPI -->|"HTTP/8000<br/>No encryption<br/>No auth"| FastAPI

    %% Internal flows
    StreamlitUI -->|"HTTP/8000<br/>ClusterIP<br/>No encryption"| FastAPI
    FastAPI -->|"HTTP/11434<br/>ClusterIP<br/>No encryption<br/>No auth"| Ollama

    %% External service flows
    FastAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token (planner-backend)"| K8sAPI
    FastAPI -->|"HTTPS<br/>TLS<br/>OPENAI_API_KEY"| OpenAIEndpoint
    FastAPI -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP Credentials"| VertexAI
    FastAPI -->|"HTTPS/443<br/>TLS 1.2+<br/>HF_TOKEN"| HFHub

    %% Secret injection
    PlannerSecrets -.->|env vars| FastAPI
    ServiceCA -.->|volume mount| FastAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef namespace fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class RouteUI,RouteAPI ingress
    class StreamlitUI,FastAPI,SQLite,Ollama namespace
    class K8sAPI,OpenAIEndpoint,VertexAI,HFHub externalservice
    class PlannerSecrets,ServiceCA secret
