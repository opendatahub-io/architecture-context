graph LR
    KueueOp["Kueue Operator<br/>(kueue-operator)"]

    %% Platform Dependencies (required)
    KueueOp -->|"TLS cert lifecycle<br/>Certificate + Issuer CRDs"| CertManager["cert-manager"]
    KueueOp -->|"metrics collection<br/>ServiceMonitor CRD"| PromOperator["prometheus-operator"]
    KueueOp -->|"resource CRUD<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]

    %% Workload Integration Dependencies (intercepted via webhooks)
    KueueOp -->|"admission webhooks<br/>+ finalizers"| Kubeflow["Kubeflow Training<br/>(kubeflow.org)<br/>PyTorch/TF/MPI/Paddle/XGBoost"]
    KueueOp -->|"admission webhooks<br/>+ finalizers"| Ray["Ray Operator<br/>(ray.io)<br/>RayCluster, RayJob"]
    KueueOp -->|"admission webhooks"| JobSet["JobSet<br/>(jobset.x-k8s.io)"]
    KueueOp -->|"admission webhooks<br/>+ finalizers"| CodeFlare["CodeFlare<br/>(workload.codeflare.dev)<br/>AppWrapper"]
    KueueOp -->|"admission webhooks"| LWS["LeaderWorkerSet<br/>(leaderworkerset.x-k8s.io)"]

    %% Core Kubernetes Resources (intercepted)
    KueueOp -->|"admission webhooks"| BatchJobs["batch/Jobs"]
    KueueOp -->|"admission webhooks"| Deployments["apps/Deployments"]
    KueueOp -->|"admission webhooks"| StatefulSets["apps/StatefulSets"]
    KueueOp -->|"admission webhooks"| Pods["core/Pods"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes metrics<br/>8443/TCP HTTPS"| KueueOp

    %% Build / Runtime Dependencies
    KueueOp -.->|"operator framework"| LibraryGo["openshift/library-go"]
    KueueOp -.->|"controller framework"| ControllerRuntime["controller-runtime 0.20.4"]
    KueueOp -.->|"upstream kueue"| Kueue["sigs.k8s.io/kueue 0.10.2"]
    KueueOp -.->|"runtime"| Go["Go 1.23<br/>strictfipsruntime"]

    %% Styling
    style KueueOp fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Platform dependencies
    style CertManager fill:#999,stroke:#333,color:#fff
    style PromOperator fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff

    %% Workload integrations (RHOAI internal)
    style Kubeflow fill:#7ed321,stroke:#333,color:#fff
    style Ray fill:#7ed321,stroke:#333,color:#fff
    style JobSet fill:#7ed321,stroke:#333,color:#fff
    style CodeFlare fill:#7ed321,stroke:#333,color:#fff
    style LWS fill:#7ed321,stroke:#333,color:#fff

    %% Core K8s resources
    style BatchJobs fill:#f5a623,stroke:#333
    style Deployments fill:#f5a623,stroke:#333
    style StatefulSets fill:#f5a623,stroke:#333
    style Pods fill:#f5a623,stroke:#333

    %% Monitoring
    style Prometheus fill:#fff2cc,stroke:#d6b656

    %% Build deps (dashed)
    style LibraryGo fill:#e8e8e8,stroke:#999
    style ControllerRuntime fill:#e8e8e8,stroke:#999
    style Kueue fill:#e8e8e8,stroke:#999
    style Go fill:#e8e8e8,stroke:#999
