graph TD
    subgraph "Training Hub RBAC Model"
        direction TB

        Note["Training Hub is a Python library,<br/>not a Kubernetes operator or service.<br/>It defines NO ClusterRoles, Roles,<br/>or RoleBindings of its own."]

        subgraph "Inherited Security Context"
            CallerSA["Caller's ServiceAccount<br/>(e.g., notebook SA, job SA)"]
            CallerRBAC["Caller's RBAC Permissions<br/>(inherited by Training Hub)"]
        end

        subgraph "Secrets / Credentials"
            APIKey["OPENAI_API_KEY<br/>(environment variable)<br/>Used by: GEPA algorithm<br/>Purpose: LLM API authentication"]
            MLflowCreds["MLflow Credentials<br/>(environment/config)<br/>Used by: MLflow GEPA backend<br/>Purpose: Experiment tracking"]
        end

        CallerSA -->|"provides"| CallerRBAC
        CallerRBAC -->|"grants access to"| APIKey
        CallerRBAC -->|"grants access to"| MLflowCreds
    end

    subgraph "Authentication Flows"
        direction TB
        OutboundAuth["Outbound Authentication"]
        LLMAuth["LLM Inference API<br/>Auth: API Key (Bearer)<br/>Enforcement: litellm client<br/>Direction: Outbound only"]
        MLflowAuth["MLflow Server<br/>Auth: MLflow client config<br/>Direction: Outbound only"]

        OutboundAuth --> LLMAuth
        OutboundAuth --> MLflowAuth
    end

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px
    style CallerSA fill:#4a90e2,stroke:#333,color:#fff
    style CallerRBAC fill:#4a90e2,stroke:#333,color:#fff
    style APIKey fill:#f5a623,stroke:#333
    style MLflowCreds fill:#f5a623,stroke:#333
    style OutboundAuth fill:#e8e8e8,stroke:#333
    style LLMAuth fill:#d5e8d4,stroke:#333
    style MLflowAuth fill:#d5e8d4,stroke:#333
