graph TD
    subgraph LibraryContext["Training Hub - RBAC Context"]
        direction TB

        Note["Training Hub is a pure Python library.<br/>It defines NO Kubernetes RBAC resources.<br/>All RBAC is inherited from the host environment."]

        subgraph InheritedRBAC["Inherited from Host Pod"]
            CallerSA["Caller ServiceAccount<br/>(notebook or training job pod)"]
            CallerRB["Caller RoleBindings<br/>(defined by platform)"]
            CallerRole["Caller Role/ClusterRole<br/>(defined by platform)"]

            CallerSA -->|"bound via"| CallerRB
            CallerRB -->|"grants"| CallerRole
        end

        subgraph Secrets["Secrets / Credentials"]
            APIKey["OPENAI_API_KEY<br/>(environment variable)<br/>Type: Bearer Token<br/>Provisioned by: runtime env<br/>Auto-rotate: unknown"]
            APIBase["OPENAI_API_BASE<br/>(environment variable)<br/>Type: Endpoint URL<br/>Provisioned by: runtime env"]
        end

        subgraph SecurityNotes["Security Notes"]
            EnvNote["GEPA algorithm temporarily<br/>sets and restores env vars<br/>during optimization runs"]
            FIPSNote["No crypto imports detected.<br/>FIPS compliance delegated<br/>to host environment."]
        end
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style CallerSA fill:#4a90e2,stroke:#333,color:#fff
    style CallerRB fill:#f5a623,stroke:#333
    style CallerRole fill:#f5a623,stroke:#333
    style APIKey fill:#e74c3c,stroke:#333,color:#fff
    style APIBase fill:#e74c3c,stroke:#333,color:#fff
    style EnvNote fill:#fff3cd,stroke:#ffc107
    style FIPSNote fill:#fff3cd,stroke:#ffc107
