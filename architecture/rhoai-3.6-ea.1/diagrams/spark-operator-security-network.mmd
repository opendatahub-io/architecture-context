graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / User<br/>kubeconfig auth"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph WebhookZone["WEBHOOK DEPLOYMENT (failurePolicy: Fail)"]
        direction TB
        WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443/TCP → webhook<br/>TLS (self-signed CA or cert-manager)<br/>Min: TLS 1.2 (OpenShift-aligned)<br/>FIPS: strictfipsruntime"]
        WebhookHealth["Health Probes<br/>:8081/healthz, /readyz<br/>HTTP, unauthenticated"]
    end

    subgraph ControllerZone["CONTROLLER DEPLOYMENT"]
        direction TB
        Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>FIPS: strictfipsruntime"]
        ControllerHealth["Health Probes<br/>:8081/healthz, /readyz<br/>HTTP, unauthenticated"]
    end

    subgraph ModuleZone["MODULE DEPLOYMENT (Meta-Operator)"]
        Module["spark-operator-module<br/>SA: spark-operator-module-controller-manager<br/>PlatformObject interface"]
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRs<br/>TLS 1.2+"]
        Prometheus["prometheus-operator<br/>PodMonitor CRs<br/>TLS 1.2+"]
        OSConfig["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS profile (read-only)"]
        ODHOp["ODH Operator<br/>SparkOperator CR lifecycle"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig / SA token"| APIServer

    %% API Server to Webhook (admission)
    APIServer -->|"HTTPS/443<br/>TLS (CA cert)<br/>Kubernetes admission<br/>7 webhooks, all Fail policy"| WebhookSvc

    %% Webhook to API Server
    WebhookSvc -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: spark-operator-webhook<br/>Secret: resourceNames-scoped"| APIServer

    %% Controller to API Server
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: spark-operator-controller<br/>Pods, Services, Ingress, PDB"| APIServer

    %% Module to API Server
    Module -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: spark-operator-module-controller-manager<br/>Deployments, CRDs, RBAC, NetworkPolicies"| APIServer

    %% Platform dependency flows
    Module -->|"CRD CRUD<br/>Kubernetes API"| CertManager
    Module -->|"CRD CRUD<br/>Kubernetes API"| Prometheus
    WebhookSvc -->|"GET APIServer 'cluster'<br/>Read-only"| OSConfig
    ODHOp -->|"Creates SparkOperator CR<br/>Reads status"| APIServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef webhook fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef module fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class APIServer controlplane
    class WebhookSvc,WebhookHealth webhook
    class Controller,ControllerHealth controller
    class Module module
    class CertManager,Prometheus,OSConfig,ODHOp platform
