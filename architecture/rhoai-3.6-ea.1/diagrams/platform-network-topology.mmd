graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Clients[External Clients<br/>Data Scientists, API Consumers]
    end

    subgraph Ingress["INGRESS (Multi-Generation Architecture)"]
        direction TB
        subgraph GatewayAPIIngress["Gateway API Ingress"]
            MaaSGW["MaaS Default Gateway<br/>openshift-ingress<br/>443/TCP HTTPS<br/>Kuadrant AuthPolicy:<br/>API key, TokenReview, OIDC JWT"]
            KServeGW["data-science-gateway<br/>istio-system or serving ns<br/>443/TCP HTTPS<br/>Candidate: EnvoyFilter ext_authz<br/>-> kube-auth-proxy"]
            ModelRegGW["Model Registry Gateway<br/>443/TCP HTTPS<br/>kube-rbac-proxy sidecar"]
        end

        subgraph RouteIngress["OpenShift Route Ingress"]
            DashRoute["ODH Dashboard Route<br/>443/TCP -> 8080/TCP<br/>OAuth2/OIDC via kube-auth-proxy"]
            ModelRegRoute["Model Registry Routes<br/>443/TCP HTTPS<br/>TLS termination at router"]
            TrustyAIRoute["TrustyAI Route<br/>443/TCP HTTPS<br/>TLS termination at router"]
            KubeAuthRoute["kube-auth-proxy Route<br/>443/TCP HTTPS<br/>OAuth2/OIDC -> cookie session"]
        end
    end

    subgraph PlatformNS["PLATFORM NAMESPACE: redhat-ods-applications"]
        direction TB

        subgraph Operators["Operator Controllers"]
            RhodsOp["rhods-operator<br/>SA: rhods-operator"]
            KServeCtrl["kserve-controller-manager<br/>SA: kserve-controller-manager<br/>Metrics: 8443/TCP kube-rbac-proxy"]
            ODHModelCtrl["odh-model-controller<br/>SA: odh-model-controller"]
            MaaSAPI["models-as-a-service maas-api<br/>SA: maas-api"]
            AIGwOp["ai-gateway-operator<br/>SA: ai-gateway-operator"]
            AIGwPP["ai-gateway-payload-processing<br/>SA: ai-gateway-pp"]
            DSPOp["data-science-pipelines-operator<br/>SA: data-science-pipelines-operator"]
            ModelRegOp["model-registry-operator<br/>SA: model-registry-operator"]
            KubeRayOp["kuberay-operator<br/>SA: kuberay-operator"]
            TrainerOp["trainer-operator<br/>SA: trainer-operator"]
            TrainingOp["training-operator<br/>SA: training-operator"]
            SparkOp["spark-operator<br/>SA: spark-operator"]
            FeastOp["feast-module-operator<br/>SA: feast-operator"]
            MLflowOp["mlflow-operator<br/>SA: mlflow-operator"]
            TrustyAIOp["trustyai-service-operator<br/>SA: trustyai-operator"]
            WBOp["workbenches-operator<br/>SA: workbenches-operator"]
            LLMDBatchOp["llm-d-batch-gateway-operator<br/>SA: llm-d-batch-gw"]
            MCPOp["mcp-lifecycle-operator<br/>SA: mcp-lifecycle"]
            OGXOp["ogx-k8s-operator<br/>SA: ogx-operator"]
            WVA["workload-variant-autoscaler<br/>SA: wva"]
        end

        subgraph PlatformSvcs["Platform Services"]
            Dashboard["odh-dashboard<br/>SA: odh-dashboard<br/>8080/TCP HTTP + BFF sidecars"]
            KubeAuth["kube-auth-proxy<br/>SA: kube-auth-proxy<br/>OAuth2/OIDC reverse proxy"]
            EvalHub2["eval-hub<br/>SA: eval-hub"]
            RHOAIMCP2["rhoai-mcp<br/>SA: rhoai-mcp"]
        end
    end

    subgraph OperatorNS["OPERATOR NAMESPACE: redhat-ods-operator"]
        RhodsOpPod["rhods-operator pod<br/>OLM-managed"]
    end

    subgraph UserNS["USER DATA SCIENCE NAMESPACES"]
        direction TB
        ISvcPods["InferenceService Pods<br/>vLLM, MLServer, OVMS<br/>kube-rbac-proxy sidecar"]
        LLMDPods["llm-d Pods<br/>vLLM + routing-sidecar<br/>+ llm-d-router EPP"]
        NotebookPods["Notebook Instances<br/>Jupyter workbenches"]
        PipelineRuns["Pipeline Runs<br/>Argo workflow pods"]
        RayClusters["Ray Clusters<br/>Head + worker pods"]
        TrainingJobs["Training Jobs<br/>TrainJob pods"]
        ModelRegInst["Model Registry Instances<br/>PostgreSQL-backed<br/>kube-rbac-proxy sidecar<br/>9090/TCP gRPC"]
        TrustyAIInst["TrustyAI Instances<br/>kube-rbac-proxy sidecar"]
        MLflowInst["MLflow Instances"]
    end

    subgraph MeshInfra["INGRESS INFRASTRUCTURE: openshift-ingress / istio-system"]
        EnvoyDP["Gateway API Data Plane<br/>Envoy Proxies"]
        IstioCP["Istio Control Plane<br/>istiod"]
    end

    subgraph Egress["EGRESS (External Services)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>ServiceAccount tokens"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM or static creds"]
        ContainerReg["Container Registry<br/>quay.io, registry.redhat.io<br/>443/TCP HTTPS<br/>Pull secrets"]
        ExternalLLM["External LLM Providers<br/>OpenAI, Anthropic, Bedrock,<br/>Azure, Vertex AI<br/>443/TCP HTTPS<br/>API keys"]
    end

    %% External to Ingress
    Clients -->|HTTPS/443<br/>API key or token| MaaSGW
    Clients -->|HTTPS/443<br/>Bearer token| KServeGW
    Clients -->|HTTPS/443<br/>OAuth2| DashRoute
    Clients -->|HTTPS/443| ModelRegRoute
    Clients -->|HTTPS/443| TrustyAIRoute

    %% Gateway API Ingress to Service Mesh
    MaaSGW -->|HTTPRoute<br/>Kuadrant AuthPolicy| MaaSAPI
    MaaSGW -->|HTTPRoute| ISvcPods
    MaaSGW -->|HTTPRoute| LLMDPods
    KServeGW -->|HTTPRoute or VirtualService| ISvcPods
    KServeGW -->|HTTPRoute| LLMDPods
    ModelRegGW -->|HTTPRoute| ModelRegInst

    %% Route Ingress to Platform
    DashRoute -->|HTTP/8080| Dashboard
    KubeAuthRoute -->|HTTP| KubeAuth
    ModelRegRoute -->|HTTPS| ModelRegInst
    TrustyAIRoute -->|HTTPS| TrustyAIInst

    %% Platform to User Namespaces
    KServeCtrl -->|creates pods, services| ISvcPods
    KServeCtrl -->|creates LLMInferenceService| LLMDPods
    ODHModelCtrl -->|mutates pods, InferenceService| ISvcPods
    DSPOp -->|deploys DSPA stack| PipelineRuns
    KubeRayOp -->|manages clusters| RayClusters
    ModelRegOp -->|deploys instances| ModelRegInst
    TrainerOp -->|manages jobs| TrainingJobs
    TrainingOp -->|orchestrates jobs| TrainingJobs
    TrustyAIOp -->|deploys instances| TrustyAIInst
    WBOp -->|manages notebooks| NotebookPods
    MLflowOp -->|deploys instances| MLflowInst

    %% LLM-d routing
    LLMDPods -->|Envoy ExtProc gRPC<br/>routing decisions| EnvoyDP

    %% Dashboard integrations
    Dashboard -->|K8s API calls| K8sAPI
    Dashboard -->|OAuth2/OIDC| KubeAuth

    %% Operator to K8s API
    KServeCtrl -->|HTTPS/443<br/>SA token| K8sAPI
    RhodsOpPod -->|HTTPS/443<br/>SA token| K8sAPI
    MaaSAPI -->|HTTPS/443<br/>SA token| K8sAPI
    AIGwOp -->|HTTPS/443<br/>SA token| K8sAPI

    %% Egress: model artifact storage
    ISvcPods -->|HTTPS/443<br/>AWS IAM| S3
    LLMDPods -->|HTTPS/443<br/>AWS IAM| S3
    NotebookPods -->|HTTPS/443| S3
    PipelineRuns -->|HTTPS/443| S3

    %% Egress: container images
    ISvcPods -->|HTTPS/443<br/>pull secret| ContainerReg
    LLMDPods -->|HTTPS/443<br/>pull secret| ContainerReg
    NotebookPods -->|HTTPS/443<br/>pull secret| ContainerReg

    %% Egress: external LLM providers
    AIGwPP -->|HTTPS/443<br/>API key<br/>TLS origination| ExternalLLM

    %% Mesh infrastructure
    KServeCtrl -->|config push| IstioCP
    AIGwOp -->|Gateway provisioning| EnvoyDP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gwIngress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef routeIngress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userNs fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef meshInfra fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Clients external
    class MaaSGW,KServeGW,ModelRegGW gwIngress
    class DashRoute,ModelRegRoute,TrustyAIRoute,KubeAuthRoute routeIngress
    class RhodsOp,KServeCtrl,ODHModelCtrl,MaaSAPI,AIGwOp,AIGwPP,DSPOp,ModelRegOp,KubeRayOp,TrainerOp,TrainingOp,SparkOp,FeastOp,MLflowOp,TrustyAIOp,WBOp,LLMDBatchOp,MCPOp,OGXOp,WVA,Dashboard,KubeAuth,EvalHub2,RHOAIMCP2 platform
    class RhodsOpPod platform
    class ISvcPods,LLMDPods,NotebookPods,PipelineRuns,RayClusters,TrainingJobs,ModelRegInst,TrustyAIInst,MLflowInst userNs
    class EnvoyDP,IstioCP meshInfra
    class K8sAPI,S3,ContainerReg,ExternalLLM egress
