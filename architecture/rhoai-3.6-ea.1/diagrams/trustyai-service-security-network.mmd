graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist / API Consumer"]
        KServeInfer["KServe/ModelMesh<br/>Inference Service"]
        PromScraper["Prometheus<br/>Metrics Scraper"]
    end

    subgraph AuthBoundary["AUTH PROXY (Trust Boundary)"]
        KubeRBAC["kube-rbac-proxy<br/>Port 8443/TCP (external)<br/>→ 8080/TCP (loopback)<br/>TLS Termination<br/>K8s RBAC AuthN/AuthZ"]
    end

    subgraph Application["APPLICATION (Trusted - Loopback)"]
        direction TB

        subgraph HTTPListener["Listener 1: HTTP (kube-rbac-proxy backend)"]
            HTTP["Hypercorn HTTP<br/>Bind: 127.0.0.1:8080<br/>Protocol: HTTP<br/>Encryption: None (loopback)<br/>CORS: allow_origins=[*]<br/>FIPS Policy: Enabled"]
        end

        subgraph TLSListener["Listener 2: HTTPS (Direct TLS)"]
            HTTPS["Hypercorn HTTPS<br/>Bind: 0.0.0.0:4443<br/>Protocol: HTTPS<br/>Encryption: TLS (system OpenSSL)<br/>Certs: /etc/tls/internal/<br/>FIPS Policy: Enabled"]
        end

        subgraph APILayer["FastAPI Application (87 endpoints)"]
            Consumer["/consumer/kserve/v2<br/>Inference ingestion"]
            MetricsAPI["/metrics/*<br/>Fairness & Drift"]
            ExplainerAPI["/explainers/*<br/>LIME, SHAP, CF"]
            PromEndpoint["/q/metrics<br/>Prometheus metrics"]
            HealthAPI["/q/health/*<br/>Liveness & Readiness"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        MariaDB["MariaDB (optional)<br/>Port 3306/TCP<br/>MySQL Protocol<br/>Optional TLS<br/>CA: /etc/tls/db/ca.crt"]
        PVC["PersistentVolumeClaim<br/>HDF5 Files<br/>Filesystem I/O<br/>At-rest encryption per PV policy"]
    end

    %% External → Auth Proxy flows
    Client -->|"HTTPS/8443<br/>TLS terminated<br/>Bearer Token (SA)"| KubeRBAC
    KServeInfer -->|"HTTPS/8443<br/>TLS terminated<br/>SA Token"| KubeRBAC
    PromScraper -->|"HTTPS/8443<br/>GET /q/metrics<br/>SA Token"| KubeRBAC

    %% Auth Proxy → Application
    KubeRBAC -->|"HTTP/8080<br/>127.0.0.1 loopback<br/>No encryption (safe)"| HTTP

    %% Direct TLS access
    Client -.->|"HTTPS/4443<br/>TLS (system OpenSSL)<br/>Client cert (when configured)"| HTTPS

    %% Internal routing
    HTTP --> APILayer
    HTTPS --> APILayer

    %% Application → External Services
    APILayer -->|"Filesystem I/O<br/>HDF5 format<br/>K8s volume mount"| PVC
    APILayer -->|"MySQL/3306<br/>Optional TLS<br/>Password auth (env var)"| MariaDB

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authproxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef listener fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef endpoint fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Client,KServeInfer,PromScraper external
    class KubeRBAC authproxy
    class HTTP,HTTPS listener
    class Consumer,MetricsAPI,ExplainerAPI,PromEndpoint,HealthAPI endpoint
    class MariaDB,PVC externalservice
