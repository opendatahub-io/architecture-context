graph TD
    subgraph "Service Accounts"
        SA_EPP[EPP Service Account<br/><i>not explicitly defined</i>]
        SA_Sidecar[pd-sidecar Service Account<br/><i>kubeconfig credential chain</i>]
    end

    subgraph "Authentication Methods"
        K8sAuth[Kubernetes API Auth<br/>ServiceAccount Token<br/>kubeconfig credential chain]
        GRPCAuth[gRPC Services Auth<br/><b>None</b><br/><i>No application-level<br/>interceptor configured</i>]
    end

    subgraph "Transport Security"
        TLS_EPP["EPP TLS Config<br/>Optional (SecureServing flag)<br/>Runtime-configurable MinVersion<br/>Runtime-configurable CipherSuites<br/>Self-signed fallback: RSA-4096<br/><b>No defaults enforced</b>"]
        TLS_Sidecar["pd-sidecar TLS<br/>FIPS-capable<br/>(strictfipsruntime tag)"]
    end

    subgraph "API Resources Accessed"
        InferencePool["inference.networking.k8s.io/v1<br/>InferencePool"]
        InferenceModelRewrite["llm-d.ai/v1alpha2<br/>InferenceModelRewrite"]
        InferenceObjective["llm-d.ai/v1alpha2<br/>InferenceObjective"]
        Pods["core/v1<br/>Pods"]
    end

    subgraph "Observed Verbs"
        WatchVerbs[get, list, watch]
    end

    subgraph "gRPC Endpoints (No Auth)"
        ExtProcEP["ExternalProcessor<br/>9002/TCP gRPC<br/><b>Auth: None</b>"]
        HealthEP["Health<br/>gRPC<br/><b>Auth: None</b>"]
    end

    subgraph "HTTP Endpoints (No Auth)"
        MetricsEP["/metrics<br/>9090/TCP HTTP"]
        HealthzEP["/healthz<br/>HTTP GET"]
        ReadyzEP["/readyz<br/>HTTP GET"]
    end

    %% Auth flows
    SA_EPP -->|authenticates via| K8sAuth
    SA_Sidecar -->|authenticates via| K8sAuth
    K8sAuth -->|accesses| InferencePool
    K8sAuth -->|accesses| InferenceModelRewrite
    K8sAuth -->|accesses| InferenceObjective
    K8sAuth -->|accesses| Pods

    InferencePool --- WatchVerbs
    InferenceModelRewrite --- WatchVerbs
    InferenceObjective --- WatchVerbs
    Pods --- WatchVerbs

    %% No auth on gRPC
    GRPCAuth -->|applies to| ExtProcEP
    GRPCAuth -->|applies to| HealthEP

    %% TLS
    TLS_EPP -->|protects| ExtProcEP
    TLS_EPP -->|protects| HealthEP

    %% Styling
    style SA_EPP fill:#4a90e2,stroke:#333,color:#fff
    style SA_Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style K8sAuth fill:#7ed321,stroke:#333
    style GRPCAuth fill:#f8cecc,stroke:#b85450
    style TLS_EPP fill:#ffe6cc,stroke:#d79b00
    style TLS_Sidecar fill:#d5e8d4,stroke:#82b366
    style InferencePool fill:#f5a623,stroke:#333
    style InferenceModelRewrite fill:#f5a623,stroke:#333
    style InferenceObjective fill:#f5a623,stroke:#333
    style Pods fill:#f5a623,stroke:#333
    style ExtProcEP fill:#f8cecc,stroke:#b85450
    style HealthEP fill:#f8cecc,stroke:#b85450
    style MetricsEP fill:#ddd,stroke:#333
    style HealthzEP fill:#ddd,stroke:#333
    style ReadyzEP fill:#ddd,stroke:#333
