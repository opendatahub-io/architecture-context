graph TD
    subgraph "Service Accounts (provisioned by deploying operator)"
        SA_EPP["EPP ServiceAccount<br/>(provisioned at deploy time)"]
    end

    subgraph "Required RBAC Permissions (not shipped in repo)"
        direction TB
        Note["No ClusterRoles or RoleBindings are<br/>shipped in the llm-d-router repository.<br/>RBAC is provisioned by the deploying<br/>operator/controller at deployment time."]
    end

    subgraph "Required API Resource Access"
        direction TB

        subgraph "Core API Resources"
            Pods["core/v1<br/>Pods"]
        end

        subgraph "llm-d.ai CRDs"
            EPConfig["llm-d.ai/v1alpha1<br/>EndpointPickerConfig"]
            ModelRewrite["llm-d.ai/v1alpha2<br/>InferenceModelRewrite"]
            Objective["llm-d.ai/v1alpha2<br/>InferenceObjective"]
        end

        subgraph "Gateway API Resources"
            Pool["inference.networking.k8s.io/v1<br/>InferencePool"]
        end
    end

    subgraph "Required Verbs"
        WatchVerbs["get, list, watch"]
        ReconcileVerbs["get, list, watch,<br/>create, update, patch"]
    end

    %% EPP needs watch access
    SA_EPP -->|"PodReconciler needs"| Pods
    SA_EPP -->|"Config loading needs"| EPConfig
    SA_EPP -->|"Reconciler needs"| ModelRewrite
    SA_EPP -->|"Reconciler needs"| Objective
    SA_EPP -->|"Reconciler needs"| Pool

    %% Verb mappings
    Pods -->|"required"| WatchVerbs
    EPConfig -->|"required"| WatchVerbs
    ModelRewrite -->|"required"| ReconcileVerbs
    Objective -->|"required"| ReconcileVerbs
    Pool -->|"required"| ReconcileVerbs

    subgraph "Authentication Mechanisms"
        direction TB
        ExtProcAuth["ExtProc gRPC (9002)<br/>Auth: None<br/>Transport: Optional TLS"]
        HealthAuth["Health gRPC (9003)<br/>Auth: None<br/>Transport: Optional TLS"]
        K8sAuth["Kubernetes API<br/>Auth: kubeconfig credential chain<br/>Transport: TLS 1.2+"]
    end

    SA_EPP -->|"authenticates via"| K8sAuth

    %% Styling
    style SA_EPP fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style Pods fill:#7ed321,stroke:#333
    style EPConfig fill:#f5a623,stroke:#333
    style ModelRewrite fill:#f5a623,stroke:#333
    style Objective fill:#f5a623,stroke:#333
    style Pool fill:#f5a623,stroke:#333
    style WatchVerbs fill:#e8e8e8,stroke:#333
    style ReconcileVerbs fill:#e8e8e8,stroke:#333
    style ExtProcAuth fill:#f8cecc,stroke:#b85450
    style HealthAuth fill:#f8cecc,stroke:#b85450
    style K8sAuth fill:#d5e8d4,stroke:#82b366
