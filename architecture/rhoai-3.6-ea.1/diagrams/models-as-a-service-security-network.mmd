graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Bearer Token / API Key / OIDC JWT"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["maas-default-gateway<br/>Namespace: openshift-ingress<br/>8443/TCP<br/>TLS 1.2+ (FIPS)"]
        AuthPolicy["Kuadrant/Authorino AuthPolicy<br/>API Key + TokenReview + OIDC JWT"]
        HTTPRoute["HTTPRoute: maas-api-route<br/>/v1/models, /v1/subscriptions,<br/>/v1/api-keys, /maas-api/*<br/>URL rewrite: strip /maas-api"]

        Gateway --> AuthPolicy
        AuthPolicy --> HTTPRoute
    end

    subgraph AppTier["APPLICATION TIER (Namespace: opendatahub)"]
        direction TB

        subgraph APIServer["maas-api (Deployment)"]
            API["Gin HTTP Router<br/>8080/TCP http<br/>9090/TCP metrics<br/>SA: maas-api<br/>UBI9 + strictfipsruntime"]
            AuthMW["Auth Middleware<br/>TokenReview + SAR"]
        end

        subgraph ControllerPod["maas-controller (Deployment)"]
            Controller["Operator Manager<br/>/manager entrypoint<br/>8081/TCP health<br/>UBI9 + strictfipsruntime"]
            Webhooks["Validating Webhooks<br/>HTTPS/TLS<br/>Failure Policy: Fail<br/>AITenant, MaaSAuthPolicy,<br/>MaaSModelRef, MaaSSubscription"]
        end
    end

    subgraph DataTier["DATA TIER"]
        PostgreSQL["PostgreSQL<br/>pgx driver<br/>Credentials: maas-db-config secret<br/>Stores: API keys, subscriptions, tenants"]
    end

    subgraph Platform["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        Kuadrant["Kuadrant/Authorino<br/>AuthPolicy + TokenRateLimitPolicy<br/>Gateway-level auth enforcement"]
        KServe["KServe<br/>LLMInferenceService<br/>(Conditional watch)"]
        GatewayAPI["Gateway API Resources<br/>HTTPRoute CRUD<br/>Kubernetes API (TLS)"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC (optional)<br/>Trace export"]
    end

    %% External to Ingress
    Client -->|"HTTPS/8443<br/>TLS 1.2+ (FIPS)<br/>Bearer/API Key/JWT"| Gateway

    %% Ingress to Application
    HTTPRoute -->|"HTTP/8080<br/>In-cluster routing"| API

    %% API internal
    API --> AuthMW
    AuthMW -->|"TokenReview<br/>HTTPS/6443"| K8sAPI
    API -->|"pgx<br/>DB credentials from secret"| PostgreSQL

    %% Controller to Platform
    Controller -->|"HTTPS/WSS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    Controller -->|"Creates AuthPolicy<br/>+ TokenRateLimitPolicy"| Kuadrant
    Controller -.->|"Conditional watch<br/>(CRD existence check)"| KServe
    Controller -->|"HTTPRoute CRUD<br/>Kubernetes API"| GatewayAPI
    Controller -.->|"OTLP/gRPC<br/>(optional)"| OTel

    %% K8s API admission
    K8sAPI -->|"Admission webhook<br/>HTTPS/TLS"| Webhooks

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef data fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Gateway,AuthPolicy,HTTPRoute ingress
    class API,AuthMW,Controller,Webhooks app
    class PostgreSQL data
    class K8sAPI,Kuadrant,KServe,GatewayAPI,OTel platform
