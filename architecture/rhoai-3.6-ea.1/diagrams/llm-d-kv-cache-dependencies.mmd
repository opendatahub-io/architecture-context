graph LR
    KVCache["llm-d-kv-cache<br/>(KV Cache Index & Scoring)"]

    %% Runtime Infrastructure Dependencies
    KVCache -->|"KV block index storage<br/>6379/TCP, TLS optional"| Redis["Redis/Valkey"]
    KVCache -->|"KV cache events<br/>ZMQ pub/sub 5557/TCP"| vLLM["vLLM Engines"]
    KVCache -->|"Pod lifecycle watch<br/>HTTPS 6443"| K8sAPI["Kubernetes API"]

    %% Framework Dependencies
    KVCache -->|"operator framework"| ControllerRuntime["controller-runtime 0.21.0"]
    KVCache -->|"gRPC transport"| gRPC["google.golang.org/grpc 1.81.1"]
    KVCache -->|"serialization"| Protobuf["google.golang.org/protobuf 1.36.11"]
    KVCache -->|"ZMQ messaging"| ZMQ["go-zeromq/zmq4 0.17.0"]

    %% Observability Dependencies
    KVCache -->|"trace export<br/>OTLP/gRPC (insecure)"| OTel["OpenTelemetry Collector"]
    KVCache -->|"metrics scraping"| Prometheus["Prometheus<br/>(/metrics endpoint)"]

    %% Internal RHOAI Dependencies
    KServe["KServe"] -.->|"sidecar injection<br/>UDS tokenizer"| KVCache
    EndpointPicker["llm-d Endpoint Picker"] -->|"score queries<br/>HTTP 8080 / gRPC 50051"| KVCache

    %% Python Sidecar Dependencies
    KVCache -->|"tokenizer sidecar<br/>Python gRPC"| HFTransformers["transformers 4.57.6"]
    KVCache -->|"Python gRPC runtime"| PyGRPC["grpcio 1.80.0"]

    %% Key Library Dependencies
    KVCache -->|"Redis client"| GoRedis["go-redis/v9 9.20.0"]
    KVCache -->|"in-memory cache"| Ristretto["ristretto/v2 2.4.0"]
    KVCache -->|"K8s client"| ClientGo["client-go 0.33.11"]

