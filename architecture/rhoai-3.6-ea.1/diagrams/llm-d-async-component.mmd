graph TB
    subgraph "llm-d-async Component"
        direction TB
        Main["cmd/main.go<br/>Entrypoint"]
        Runner["Runner<br/>(pkg/server/runner.go)"]
        Options["Options<br/>(pkg/server/options.go)"]
        Worker["Async Worker<br/>(pkg/asyncworker)"]
        HealthServer["Health Server<br/>Port 8081<br/>(internal/health)"]
        MetricsServer["Metrics Server<br/>Port 9090<br/>(controller-runtime)"]

        Main -->|configures| Options
        Main -->|starts| Runner
        Runner -->|spawns| Worker
        Runner -->|starts| HealthServer
        Runner -->|starts| MetricsServer
    end

    subgraph "Transport Layer (pipeline.Flow)"
        direction LR
        RedisPubSub["Redis Pub/Sub<br/>Transport"]
        RedisSortedSet["Redis Sorted Set<br/>Transport"]
        GCPPubSub["GCP Pub/Sub<br/>Transport"]
    end

    subgraph "Flow Control"
        MergePolicy["Merge Policy Plugin<br/>(random-robin default)"]
        GateFactory["Gate Factory<br/>(Prometheus-driven)"]
        Transforms["Request Body<br/>Transform Chain"]
    end

    Runner -->|selects one| RedisPubSub
    Runner -->|selects one| RedisSortedSet
    Runner -->|selects one| GCPPubSub

    Worker -->|uses| MergePolicy
    Worker -->|checks| GateFactory
    Worker -->|applies| Transforms

    %% External dependencies
    ModelServer["Model Server<br/>(HTTP/HTTPS)"]
    Prometheus["Prometheus<br/>(Metrics Query)"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]

    Worker -->|forwards inference<br/>HTTP + optional mTLS| ModelServer
    GateFactory -->|queries metrics| Prometheus
    MetricsServer -->|authenticates via| K8sAPI

    %% Health probes
    Kubelet["Kubelet"] -->|/healthz, /readyz| HealthServer

    style Main fill:#4a90e2,color:#fff
    style Runner fill:#4a90e2,color:#fff
    style Options fill:#4a90e2,color:#fff
    style Worker fill:#4a90e2,color:#fff
    style HealthServer fill:#50c878,color:#fff
    style MetricsServer fill:#50c878,color:#fff
    style RedisPubSub fill:#f5a623,color:#fff
    style RedisSortedSet fill:#f5a623,color:#fff
    style GCPPubSub fill:#f5a623,color:#fff
    style MergePolicy fill:#9b59b6,color:#fff
    style GateFactory fill:#9b59b6,color:#fff
    style Transforms fill:#9b59b6,color:#fff
    style ModelServer fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Kubelet fill:#e8e8e8,stroke:#333
