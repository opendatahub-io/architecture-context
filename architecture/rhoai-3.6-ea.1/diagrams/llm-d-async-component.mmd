graph TB
    subgraph "llm-d-async Processor"
        direction TB
        Main["cmd/main.go<br/>Entrypoint"]
        Runner["Runner<br/>pkg/server/runner.go"]
        Options["Options Parser<br/>pkg/server/options.go"]

        Main -->|configures| Options
        Main -->|starts| Runner

        subgraph "Transport Layer"
            direction LR
            RedisPubSub["Redis Pub/Sub<br/>Transport"]
            RedisSortedSet["Redis Sorted Set<br/>Transport"]
            GCPPubSub["GCP Pub/Sub<br/>Transport"]
        end

        subgraph "Worker Pool"
            direction LR
            Pool["Worker Pool<br/>Concurrent goroutines"]
            Gate["Prometheus Gate<br/>Flow-control admission"]
            Pool -->|admission check| Gate
        end

        subgraph "HTTP Client"
            InferenceClient["Inference HTTP Client<br/>TLS 1.2+ / optional mTLS<br/>OTel instrumented"]
        end

        subgraph "Observability"
            direction LR
            HealthServer["Health Server<br/>:8081"]
            MetricsServer["Metrics Server<br/>:9090"]
            OTelExporter["OTel Trace Exporter<br/>OTLP/gRPC"]
        end

        Runner -->|selects| RedisPubSub
        Runner -->|selects| RedisSortedSet
        Runner -->|selects| GCPPubSub
        Runner -->|manages| Pool
        Pool -->|dispatches via| InferenceClient
        Runner -->|starts| HealthServer
        Runner -->|starts| MetricsServer
        Runner -->|configures| OTelExporter
    end

    %% External Systems
    Redis["Redis Broker<br/>:6379"]
    GCP["GCP Pub/Sub<br/>:443"]
    ModelServer["Inference Gateway<br/>(e.g. vLLM)<br/>:8000"]
    Prometheus["Prometheus<br/>:9090"]
    OTelCollector["OTel Collector<br/>OTLP/gRPC"]
    K8sAPI["Kubernetes API<br/>:6443"]

    %% Connections
    RedisPubSub -->|consume/publish| Redis
    RedisSortedSet -->|consume/publish| Redis
    GCPPubSub -->|consume/publish| GCP
    InferenceClient -->|POST inference| ModelServer
    Gate -->|query metrics| Prometheus
    OTelExporter -->|export traces| OTelCollector
    Runner -->|resource ops| K8sAPI

    %% Styling
    style Main fill:#4a90e2,stroke:#333,color:#fff
    style Runner fill:#4a90e2,stroke:#333,color:#fff
    style Options fill:#4a90e2,stroke:#333,color:#fff
    style RedisPubSub fill:#7ed321,stroke:#333,color:#fff
    style RedisSortedSet fill:#7ed321,stroke:#333,color:#fff
    style GCPPubSub fill:#7ed321,stroke:#333,color:#fff
    style Pool fill:#f5a623,stroke:#333,color:#fff
    style Gate fill:#f5a623,stroke:#333,color:#fff
    style InferenceClient fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#9013fe,stroke:#333,color:#fff
    style MetricsServer fill:#9013fe,stroke:#333,color:#fff
    style OTelExporter fill:#9013fe,stroke:#333,color:#fff
    style Redis fill:#e8e8e8,stroke:#333
    style GCP fill:#e8e8e8,stroke:#333
    style ModelServer fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
