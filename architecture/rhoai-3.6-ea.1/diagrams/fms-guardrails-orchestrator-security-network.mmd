graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Consumer["API Consumer"]
        Probe["Platform / Probe"]
    end

    subgraph Application["APPLICATION (fms-guardrails-orchestr8)"]
        direction TB

        subgraph GuardrailsPort["Port 8033 - Guardrails API"]
            TLS["TLS Termination<br/>rustls + ring (NOT FIPS)<br/>TLS 1.2+ (optional)<br/>mTLS (optional)"]
            AuthFilter["Auth Filter<br/>Header passthrough<br/>X-Forwarded-Access-Token<br/>→ Bearer rewrite"]
            Router["axum Router<br/>10 POST endpoints<br/>/api/v1/*, /api/v2/*"]
        end

        subgraph HealthPort["Port 8034 - Health API"]
            HealthEndpoint["Health/Info Endpoints<br/>No TLS, No Auth"]
        end

        TonicClient["tonic gRPC Client<br/>Outbound connections"]
        ReqwestClient["reqwest HTTP Client<br/>rustls-tls (ring)"]
        OTelExporter["OpenTelemetry Exporter<br/>OTLP gRPC/HTTP"]
    end

    subgraph Downstream["DOWNSTREAM SERVICES"]
        direction TB

        Chunker["Chunker Services<br/>8085/TCP gRPC<br/>TLS optional<br/>No auth"]
        Detector["Detector Services<br/>8080/TCP REST<br/>TLS optional<br/>Bearer token optional"]
        DetHealth["Detector Health<br/>8081/TCP REST<br/>No encryption<br/>No auth"]
        TGIS["TGIS Generation<br/>8033/TCP gRPC<br/>No encryption<br/>No auth"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTLPCollector["OTLP Collector<br/>gRPC or HTTP"]
    end

    %% Inbound flows
    Consumer -->|"HTTP/HTTPS :8033<br/>TLS 1.2+ (optional)<br/>Passthrough headers"| TLS
    TLS --> AuthFilter
    AuthFilter --> Router
    Probe -->|"HTTP :8034<br/>No TLS, No auth"| HealthEndpoint

    %% Internal routing
    Router --> TonicClient
    Router --> ReqwestClient
    HealthEndpoint --> ReqwestClient

    %% Outbound flows
    TonicClient -->|"gRPC :8085<br/>TLS optional"| Chunker
    ReqwestClient -->|"REST :8080<br/>TLS optional<br/>Bearer optional"| Detector
    ReqwestClient -->|"REST :8081<br/>No encryption"| DetHealth
    TonicClient -->|"gRPC :8033<br/>No encryption"| TGIS
    OTelExporter -->|"OTLP<br/>gRPC/HTTP"| OTLPCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef app fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef tls fill:#fee2e2,stroke:#ef4444,stroke-width:2px
    classDef auth fill:#fef3c7,stroke:#f59e0b,stroke-width:2px
    classDef downstream fill:#f3f4f6,stroke:#6b7280,stroke-width:2px
    classDef observability fill:#ede9fe,stroke:#8b5cf6,stroke-width:2px

    class Consumer,Probe external
    class TLS tls
    class AuthFilter auth
    class Router,TonicClient,ReqwestClient,HealthEndpoint,OTelExporter app
    class Chunker,Detector,DetHealth,TGIS downstream
    class OTLPCollector observability
