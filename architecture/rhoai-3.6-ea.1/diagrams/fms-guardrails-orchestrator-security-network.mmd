graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client<br/>REST Consumer"]
    end

    subgraph Application["APPLICATION LAYER"]
        direction TB

        subgraph Orchestrator["fms-guardrails-orchestr8<br/>UBI 9 Minimal (amd64/ppc64le/s390x)"]
            APIServer["REST API Server<br/>8033/TCP HTTP/HTTPS<br/>TLS 1.2+ optional<br/>rustls + ring (NOT FIPS)"]
            HealthSrv["Health Server<br/>8034/TCP HTTP<br/>No TLS, No Auth"]
            HeaderRewrite["Header Rewrite<br/>X-Forwarded-Access-Token<br/>→ Authorization Bearer"]
        end
    end

    subgraph Downstream["DOWNSTREAM SERVICES (Internal)"]
        direction TB

        Chunker["Chunker Services<br/>8085/TCP gRPC<br/>TLS optional<br/>Auth: None"]
        Detector["Detector Services<br/>8080/TCP REST<br/>TLS optional<br/>Auth: Bearer (optional)"]
        DetectorHealth["Detector Health<br/>8081/TCP HTTP<br/>No TLS<br/>Auth: None"]
        TGIS["TGIS Generation<br/>8033/TCP gRPC<br/>No TLS<br/>Auth: None"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS 8033/TCP<br/>TLS 1.2+ (optional)<br/>Passthrough headers"| APIServer
    Client -.->|"HTTP 8034/TCP<br/>No TLS, No Auth"| HealthSrv

    APIServer -->|"gRPC 8085/TCP<br/>TLS optional<br/>No Auth"| Chunker
    APIServer -->|"HTTP/HTTPS 8080/TCP<br/>TLS optional<br/>Bearer token (optional)"| Detector
    APIServer -->|"HTTP 8081/TCP<br/>No TLS, No Auth"| DetectorHealth
    APIServer -->|"gRPC 8033/TCP<br/>No TLS, No Auth"| TGIS
    APIServer --> HeaderRewrite

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appLayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef downstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warning fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class APIServer,HealthSrv appLayer
    class HeaderRewrite warning
    class Chunker,Detector,DetectorHealth,TGIS downstream
