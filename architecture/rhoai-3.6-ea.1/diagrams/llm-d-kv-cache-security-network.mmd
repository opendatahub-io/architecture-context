graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Router["llm-d Endpoint Picker<br/>(External Router)"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No service mesh documented)"]
        direction TB

        subgraph ScoringPod["Scoring Pod"]
            OnlineServer["Online Scoring Server<br/>8080/TCP HTTP<br/>No Auth, No TLS<br/>FIPS: Not configured"]
            IndexerGRPC["IndexerService gRPC<br/>50051/TCP HTTP/2<br/>No Auth, No TLS<br/>OTel trace propagation"]
        end

        subgraph ReconcilerPod["Reconciler Pod"]
            PodReconciler["Pod Reconciler<br/>controller-runtime<br/>Watches /v1/Pod"]
        end

        subgraph KServeInferencePod["POD BOUNDARY: KServe Inference Pod"]
            UDSTokenizer["UDS Tokenizer Sidecar<br/>UDS: /tmp/tokenizer<br/>gRPC TokenizationService<br/>Pod-scoped access"]
        end

        Redis["Redis/Valkey<br/>6379/TCP<br/>TLS: Optional (rediss:// scheme)<br/>Auth: URL-based"]
    end

    subgraph EventSources["INBOUND EVENT SOURCES"]
        vLLM["vLLM Engines<br/>ZMQ Publisher"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>SA Token Auth"]
        OTelCollector["OTel Collector<br/>OTLP/gRPC<br/>⚠️ Insecure (WithInsecure)"]
    end

    %% Flows
    Router -->|"HTTP POST /score_*<br/>8080/TCP<br/>No Encryption<br/>No Auth"| OnlineServer
    Router -->|"gRPC GetPodScores<br/>50051/TCP<br/>No TLS<br/>No Auth"| IndexerGRPC
    OnlineServer -->|"Redis protocol<br/>6379/TCP<br/>TLS via rediss://"| Redis
    IndexerGRPC -->|"Redis protocol<br/>6379/TCP<br/>TLS via rediss://"| Redis
    vLLM -->|"ZMQ pub/sub<br/>5557/TCP<br/>No Encryption<br/>No Auth<br/>topic: kv@"| OnlineServer
    PodReconciler -->|"Watch /v1/Pod<br/>6443/TCP<br/>HTTPS TLS 1.2+<br/>ServiceAccount"| K8sAPI
    PodReconciler -->|"Delete stale entries<br/>6379/TCP"| Redis
    OnlineServer -->|"OTLP/gRPC<br/>⚠️ Insecure"| OTelCollector
    IndexerGRPC -->|"OTLP/gRPC<br/>⚠️ Insecure"| OTelCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef clusterInternal fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef podboundary fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef externalService fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef datastore fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    class Router external
    class OnlineServer,IndexerGRPC,PodReconciler clusterInternal
    class UDSTokenizer podboundary
    class K8sAPI externalService
    class OTelCollector warning
    class Redis datastore
    class vLLM external
