graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Kubernetes Network)"]
        direction TB

        subgraph OperatorNS["Namespace: redhat-ods-operator"]
            direction TB

            Manager["opendatahub-operator-controller-manager<br/>SA: opendatahub-operator-controller-manager<br/>FIPS: GOEXPERIMENT=strictfipsruntime, CGO_ENABLED=1<br/>Base: UBI 9 ubi-minimal"]

            subgraph Ports["Exposed Ports"]
                WebhookPort["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster profile)<br/>Cert: service-ca operator"]
                HealthPort["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>Auth: None"]
                MetricsPort["Metrics<br/>8443→8080/TCP HTTPS<br/>TLS<br/>Auth: RBAC (metrics-reader)"]
            end
        end

        subgraph WatchedNS["Watched Namespaces"]
            MaaSNS["models-as-a-service<br/>Auth controller trigger"]
            KuadrantNS["kuadrant-system<br/>Auth controller trigger"]
        end

        subgraph ManagedResources["Managed Resources (owned by operator)"]
            GWResources["Gateway API<br/>GatewayClass, Gateway, HTTPRoute"]
            IstioResources["Istio (conditional)<br/>EnvoyFilter, DestinationRule"]
            PromResources["Prometheus<br/>PodMonitor, PrometheusRule,<br/>ServiceMonitor"]
            CoreResources["Core K8s<br/>Deployments, Services,<br/>ConfigMaps, RBAC,<br/>NetworkPolicies"]
        end
    end

    subgraph ClusterControl["CLUSTER CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        APIServer["OpenShift APIServer Config<br/>TLS Security Profile<br/>Read-only"]
        ServiceCA["service-ca Operator<br/>TLS Certificate<br/>Provisioning"]
    end

    subgraph AdmissionClients["ADMISSION CLIENTS"]
        K8sAdmission["Kubernetes API Server<br/>(admission requests)"]
    end

    subgraph MonitoringConsumers["MONITORING"]
        Prometheus["Prometheus<br/>Scrape metrics"]
    end

    %% Flows
    K8sAdmission -->|"HTTPS/443→9443<br/>TLS (cluster profile)<br/>10 webhooks (mutate/validate/convert)"| WebhookPort
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>RBAC: metrics-reader ClusterRole"| MetricsPort
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token<br/>Watch + CRUD all resources"| K8sAPI
    Manager -->|"GET<br/>Read TLS profile"| APIServer
    ServiceCA -->|"Provision TLS cert<br/>opendatahub-operator-controller-webhook-cert"| WebhookPort
    Manager -->|"Watch namespace events"| MaaSNS
    Manager -->|"Watch namespace events"| KuadrantNS
    Manager -->|"Create/Update<br/>Kubernetes API"| GWResources
    Manager -.->|"Conditional<br/>(if Istio CRDs present)"| IstioResources
    Manager -->|"Create/Update<br/>Kubernetes API"| PromResources
    Manager -->|"Create/Update<br/>Kubernetes API"| CoreResources

    %% Styling
    classDef operator fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef port fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef watched fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px

    class Manager operator
    class WebhookPort,HealthPort,MetricsPort port
    class K8sAPI,APIServer,ServiceCA controlplane
    class MaaSNS,KuadrantNS watched
    class GWResources,IstioResources,PromResources,CoreResources managed
    class K8sAdmission,Prometheus external
