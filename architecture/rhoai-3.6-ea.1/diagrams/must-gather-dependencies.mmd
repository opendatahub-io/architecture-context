graph LR
    MustGather["must-gather<br/>Diagnostic Collection Tool"]

    %% Internal Platform Dependencies (Read-only via K8s API)
    MustGather -->|"CRD read<br/>operator namespace, CSV,<br/>DSCi, DSC CRs"| RhodsOperator["rhods-operator"]
    MustGather -->|"CRD read<br/>component CRs"| PlatformCRDs["opendatahub-io<br/>Platform CRDs"]
    MustGather -->|"CRD read<br/>resource inspection"| K8sAPI["OpenShift API Server"]

    %% Integration Points - Component Collectors
    MustGather -->|"CRD read<br/>DSP resources & logs"| DSP["Data Science Pipelines"]
    MustGather -->|"CRD read<br/>InferenceService,<br/>ServingRuntime"| KServe["KServe"]
    MustGather -->|"CRD read<br/>Model Registry resources"| ModelRegistry["Model Registry"]
    MustGather -->|"CRD read<br/>LLMInferenceService,<br/>InferencePool"| LLMD["llm-d"]
    MustGather -->|"CRD read<br/>AuthConfig, AuthPolicy"| Authorino["Authorino"]
    MustGather -->|"CRD read<br/>RateLimitPolicy,<br/>TokenRateLimitPolicy"| Kuadrant["Kuadrant"]
    MustGather -->|"CRD read<br/>Gateway, HTTPRoute,<br/>GRPCRoute"| GatewayAPI["Gateway API"]
    MustGather -->|"CLI<br/>Helm release values<br/>and manifests"| Helm["Helm<br/>(rhai-gitops)"]

    %% Styling
    style MustGather fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required internal dependencies
    style RhodsOperator fill:#7ed321,stroke:#333
    style PlatformCRDs fill:#7ed321,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333

    %% Component integration points (diagnostic targets)
    style DSP fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ModelRegistry fill:#7ed321,stroke:#333
    style LLMD fill:#7ed321,stroke:#333
    style Authorino fill:#7ed321,stroke:#333
    style Kuadrant fill:#7ed321,stroke:#333
    style GatewayAPI fill:#f5a623,stroke:#333
    style Helm fill:#f5a623,stroke:#333
