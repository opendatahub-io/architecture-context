graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Browser / External Client"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS 1.2+<br/>Edge/Re-encrypt"]
        KRBP["kube-rbac-proxy / OAuth Proxy<br/>Validates OAuth token<br/>Injects x-forwarded-access-token"]
        Route --> KRBP
    end

    subgraph AppLayer["APPLICATION LAYER"]
        direction TB

        subgraph NodeJS["Node.js Backend"]
            Fastify["Fastify Backend<br/>8443/TCP HTTPS<br/>Auth: x-forwarded-access-token<br/>SPA + API Proxy"]
        end

        subgraph BFFs["Go BFF Sidecars (TLS-secured)"]
            direction LR
            GenAI["gen-ai<br/>8143/TLS"]
            ModelReg["model-registry<br/>8043/TLS"]
            MaaS["maas<br/>8243/TLS"]
            MLflow["mlflow<br/>8343/TLS"]
            EvalHub["eval-hub<br/>8543/TLS"]
            AutoML["automl<br/>8643/TLS"]
            AutoRAG["autorag<br/>8743/TLS"]
            AgentOps["agent-ops<br/>8843/TLS"]
        end

        subgraph BFFAuth["BFF Auth: InjectRequestIdentity Middleware"]
            SAR["SubjectAccessReview /<br/>SelfSubjectAccessReview<br/>per-request RBAC"]
        end

        Fastify -->|"/_mf/:name/*<br/>TLS"| BFFs
        BFFs --> SAR
    end

    subgraph OperatorLayer["OPERATOR LAYER"]
        direction TB
        Operator["Dashboard Operator<br/>SA: odh-dashboard-operator<br/>FIPS: CGO_ENABLED=1<br/>strictfipsruntime"]
        WebhookSvc["Webhook Service<br/>443/TCP -> 9443/TCP<br/>TLS<br/>K8s Admission Auth"]
        Metrics["Metrics Service<br/>8443/TCP<br/>TLS"]
        Probes["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz<br/>No Auth"]
    end

    subgraph K8s["KUBERNETES API"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token + Impersonation"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES (Internal)"]
        direction LR
        DSPipelines["DataScience Pipelines<br/>8443/HTTPS/TLS<br/>Bearer Token"]
        ModelRegAPI["Model Registry API<br/>8443/HTTPS/TLS<br/>Bearer Token"]
        KServeAPI["KServe<br/>varies/HTTPS/TLS<br/>Bearer Token"]
        MLMD["MLMD<br/>8443/gRPC-web/TLS<br/>Bearer Token"]
        TrustyAI["TrustyAI<br/>443/HTTPS/TLS<br/>Bearer Token"]
        MLflowSvc["MLflow Tracking<br/>varies/HTTPS/TLS<br/>Session"]
        Prometheus["Prometheus/Thanos<br/>9092/HTTPS/TLS<br/>Bearer Token"]
    end

    subgraph ExtSvc["EXTERNAL SERVICES"]
        direction LR
        LlamaStack["Llama Stack<br/>varies/HTTPS/TLS<br/>Bearer/API Key"]
        MaaSExt["MaaS API<br/>varies/HTTPS/TLS<br/>Bearer Token"]
        NeMo["NeMo Guardrails<br/>varies/HTTPS/TLS<br/>API Key"]
        MCP["MCP Servers<br/>SSE/HTTP<br/>X-MCP-Bearer"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth Session"| Route
    KRBP -->|"HTTPS/8443<br/>TLS<br/>x-forwarded-access-token"| Fastify
    Fastify -->|"HTTPS/6443<br/>TLS 1.2+<br/>User Token Impersonation"| K8sAPI
    SAR -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    BFFs -->|"HTTPS/TLS<br/>Bearer Token"| PlatformSvc
    GenAI -->|"SSE/HTTP<br/>X-MCP-Bearer"| MCP
    BFFs -->|"HTTPS/TLS<br/>Bearer/API Key"| ExtSvc

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route,KRBP ingress
    class Fastify,GenAI,ModelReg,MaaS,MLflow,EvalHub,AutoML,AutoRAG,AgentOps,SAR app
    class Operator,WebhookSvc,Metrics,Probes operator
    class K8sAPI k8s
    class DSPipelines,ModelRegAPI,KServeAPI,MLMD,TrustyAI,MLflowSvc,Prometheus platform
    class LlamaStack,MaaSExt,NeMo,MCP extsvc
