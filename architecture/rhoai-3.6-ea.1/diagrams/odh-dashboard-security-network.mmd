graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Browser[Browser Client]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS Termination"]
    end

    subgraph AuthProxy["AUTH PROXY"]
        KRBAC["kube-rbac-proxy<br/>8443/TCP TLS<br/>OpenShift OAuth Validation<br/>Injects: x-forwarded-access-token<br/>x-auth-request-user/groups"]
    end

    subgraph AppTier["APPLICATION TIER (Dashboard Pod)"]
        direction TB

        subgraph NodeBackend["Node.js Backend"]
            Fastify["Fastify Server<br/>8080/TCP HTTP<br/>API Proxy + SPA Server"]
        end

        subgraph BFFLayer["Go BFF Sidecars (TLS + Bearer Auth)"]
            CoreBFF["core-bff<br/>8080/TCP"]
            GenAIBFF["gen-ai BFF<br/>8143/TCP"]
            ModelRegBFF["model-registry BFF<br/>8043/TCP"]
            MaaSBFF["maas BFF<br/>8243/TCP"]
            MLflowBFF["mlflow BFF<br/>8343/TCP"]
            EvalHubBFF["eval-hub BFF<br/>8543/TCP"]
            AutoMLBFF["automl BFF<br/>8643/TCP"]
            AutoRAGBFF["autorag BFF<br/>8743/TCP"]
            AgentOpsBFF["agent-ops BFF<br/>8843/TCP<br/>+ Per-agent SSAR"]
        end
    end

    subgraph OperatorTier["OPERATOR TIER"]
        Operator["dashboard-operator<br/>SA: odh-dashboard-operator<br/>controller-runtime v0.23.3"]
        Webhook["Webhook Server<br/>9443/TCP<br/>TLS (cert-manager)<br/>K8s Admission Auth"]
        Metrics["Metrics Service<br/>8443/TCP TLS"]
    end

    subgraph ExternalServices["EGRESS - PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token + Impersonation"]
        DSPipelines["DS Pipelines API<br/>8443/TCP HTTPS<br/>Bearer Token"]
        ModelRegAPI["Model Registry API<br/>8443/TCP HTTPS<br/>Bearer Token"]
        KServe["KServe<br/>varies/TCP HTTPS<br/>Bearer Token"]
        MLMD["ML Metadata<br/>8443/TCP gRPC-web<br/>Bearer Token"]
        TrustyAI["TrustyAI Service<br/>443/TCP HTTPS<br/>Bearer Token"]
        LlamaStack["Llama Stack Server<br/>varies/TCP HTTPS<br/>Bearer/API Key"]
        MaaSAPI["MaaS API Server<br/>varies/TCP HTTPS<br/>Bearer Token"]
        MLflowServer["MLflow Tracking<br/>varies/TCP HTTPS<br/>Session Auth"]
        Prometheus["Prometheus/Thanos<br/>9092/TCP HTTPS<br/>Bearer Token"]
        MCPServers["MCP Servers<br/>SSE/HTTP<br/>X-MCP-Bearer"]
        NeMo["NeMo Guardrails<br/>varies/TCP HTTPS<br/>API Key"]
    end

    %% External → Ingress
    Browser -->|"HTTPS/443<br/>TLS<br/>OAuth Token"| Route

    %% Ingress → Auth Proxy
    Route -->|"HTTPS/8443<br/>TLS reencrypt<br/>Token passthrough"| KRBAC

    %% Auth Proxy → Backend
    KRBAC -->|"HTTP/8080<br/>Pod-internal<br/>Identity headers"| Fastify

    %% Backend → BFF Sidecars
    Fastify -->|"HTTPS/8143 TLS<br/>Bearer Token"| GenAIBFF
    Fastify -->|"HTTPS/8043 TLS<br/>Bearer Token"| ModelRegBFF
    Fastify -->|"HTTPS/8243 TLS<br/>Bearer Token"| MaaSBFF
    Fastify -->|"HTTPS/8343 TLS<br/>Bearer Token"| MLflowBFF
    Fastify -->|"HTTPS/8543 TLS<br/>Bearer Token"| EvalHubBFF
    Fastify -->|"HTTPS/8643 TLS<br/>Bearer Token"| AutoMLBFF
    Fastify -->|"HTTPS/8743 TLS<br/>Bearer Token"| AutoRAGBFF
    Fastify -->|"HTTPS/8843 TLS<br/>Bearer Token"| AgentOpsBFF

    %% Backend → K8s API (proxy)
    Fastify -->|"HTTPS/6443<br/>TLS 1.2+<br/>Impersonation"| K8sAPI

    %% BFF Sidecars → External Services
    GenAIBFF -->|"HTTPS TLS<br/>Bearer/API Key"| LlamaStack
    GenAIBFF -->|"SSE/HTTP<br/>X-MCP-Bearer"| MCPServers
    GenAIBFF -->|"HTTPS TLS<br/>API Key"| NeMo
    ModelRegBFF -->|"HTTPS/8443 TLS<br/>Bearer Token"| ModelRegAPI
    MaaSBFF -->|"HTTPS TLS<br/>Bearer Token"| MaaSAPI
    MLflowBFF -->|"HTTPS TLS<br/>Session"| MLflowServer
    EvalHubBFF -->|"HTTPS TLS<br/>Bearer Token"| TrustyAI
    EvalHubBFF -->|"HTTPS TLS<br/>Bearer Token"| KServe

    %% BFF → K8s API (SubjectAccessReview)
    GenAIBFF -->|"HTTPS/6443<br/>SA Token + SSAR"| K8sAPI
    AgentOpsBFF -->|"HTTPS/6443<br/>SA Token + SSAR"| K8sAPI

    %% Operator → K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Backend → other services
    Fastify -->|"HTTPS/8443 TLS<br/>Bearer Token"| DSPipelines
    Fastify -->|"gRPC-web/8443 TLS<br/>Bearer Token"| MLMD
    CoreBFF -->|"HTTPS/9092 TLS<br/>Bearer Token"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef extsvc fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Browser external
    class Route ingress
    class KRBAC authproxy
    class Fastify,CoreBFF,GenAIBFF,ModelRegBFF,MaaSBFF,MLflowBFF,EvalHubBFF,AutoMLBFF,AutoRAGBFF,AgentOpsBFF app
    class Operator,Webhook,Metrics operator
    class K8sAPI,DSPipelines,ModelRegAPI,KServe,MLMD,TrustyAI,LlamaStack,MaaSAPI,MLflowServer,Prometheus,MCPServers,NeMo extsvc
