    style NumPy fill:#999,stroke:#333
    style Pydantic fill:#999,stroke:#333
    style gRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style Requests fill:#999,stroke:#333
    style Aiohttp fill:#999,stroke:#333
    style Structlog fill:#999,stroke:#333
