graph LR
    SDK["kubeflow-sdk<br/>(TrainerClient)"]

    %% Core API Packages (Internal)
    SDK -->|"model definitions"| TrainerAPI["kubeflow-trainer-api<br/>>=2.0.0"]
    SDK -->|"model definitions"| KatibAPI["kubeflow-katib-api<br/>>=0.19.0"]
    SDK -.->|"optional: spark extra"| SparkAPI["kubeflow-spark-api<br/>>=2.4.0"]

    %% Runtime Integration
    SDK -->|"cluster auth & API calls"| K8sClient["kubernetes<br/>Python client >=27.2.0"]
    SDK -.->|"optional: hub extra"| ModelRegistry["model-registry<br/>>=0.3.6"]

    %% Data & ML Libraries
    SDK -->|"data processing"| Pandas["pandas ==2.3.3"]
    SDK -->|"numerical computing"| NumPy["numpy ==2.2.6"]
    SDK -->|"data serialization"| Pydantic["pydantic >=2.10.0"]

    %% Transport
    SDK -->|"gRPC transport"| gRPC["grpcio ==1.78.0"]
    SDK -->|"protobuf models"| Protobuf["protobuf ==6.33.5"]
    SDK -->|"HTTP requests"| Requests["requests ==2.32.5"]
    SDK -->|"async HTTP"| Aiohttp["aiohttp ==3.13.3"]

    %% RHAI Module
    SDK -.->|"optional: rhai extra"| Structlog["structlog >=24.1.0"]

    %% Transitive Security
    K8sClient -->|"transitive"| Cryptography["cryptography ==46.0.5"]
    K8sClient -->|"transitive"| PyJWT["pyjwt ==2.11.0"]
    K8sClient -->|"transitive"| OAuthlib["oauthlib ==3.3.1"]

    %% Optional Extras
    SDK -.->|"optional: spark extra"| PySpark["pyspark ==4.0.1"]
    SDK -.->|"optional"| S3FS["s3fs >=2025.3.0"]
    SDK -.->|"optional"| FSSpec["fsspec >=2025.3.0"]

    %% Platform Target
    K8sClient -->|"connects to"| K8sAPI["Kubernetes API Server"]

    style SDK fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style TrainerAPI fill:#7ed321,stroke:#333
    style KatibAPI fill:#7ed321,stroke:#333
    style SparkAPI fill:#7ed321,stroke:#333
    style K8sClient fill:#7ed321,stroke:#333
    style ModelRegistry fill:#7ed321,stroke:#333
