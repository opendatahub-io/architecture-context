graph TD
    subgraph "Container Security"
        Container["lm-evaluation-harness<br/>Container Pod"]
        UID["UID: 65532<br/>(non-root)"]
        Container --- UID
    end

    subgraph "RBAC (None Defined)"
        NoRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>by this component"]
        Note["RBAC managed by<br/>EvalHub orchestration layer"]
        NoRBAC --- Note
    end

    subgraph "Secrets (Environment Variables)"
        HFToken["HF_TOKEN<br/>HuggingFace Hub auth<br/>(gated datasets)"]
        AnthropicKey["ANTHROPIC_API_KEY<br/>Anthropic API auth"]
        WatsonXKey["WATSONX_API_KEY<br/>IBM WatsonX AI auth"]
        OpenAIKey["OPENAI_API_KEY<br/>OpenAI API auth"]
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>S3 storage auth"]
    end

    subgraph "Credential Security Controls"
        CredResolver["resolve_model_credentials()<br/>EvalHub SDK credential framework"]
        ErrorSanitizer["Error Sanitizer<br/>Redacts: Bearer tokens,<br/>API keys, passwords,<br/>URL credentials"]
    end

    subgraph "External Service Auth"
        ModelEndpoint["Model Serving Endpoint<br/>Auth: API Key<br/>(via CredResolver)"]
        HFHub["HuggingFace Hub<br/>Auth: HF_TOKEN"]
        S3["S3 Storage<br/>Auth: AWS IAM"]
    end

    Container -->|"uses"| CredResolver
    Container -->|"sanitizes errors via"| ErrorSanitizer
    CredResolver -->|"resolves key for"| ModelEndpoint
    HFToken -->|"authenticates"| HFHub
    AWSKey -->|"authenticates"| S3
    AnthropicKey -.->|"optional auth"| ModelEndpoint
    WatsonXKey -.->|"optional auth"| ModelEndpoint
    OpenAIKey -.->|"optional auth"| ModelEndpoint

