graph TB
    subgraph External["External Clients"]
        Client[Client<br/>OpenAI-compatible API]
    end

    subgraph Sidecar["llm-d-routing-sidecar"]
        direction TB
        Proxy["Reverse Proxy<br/>internal/proxy<br/>Port 8000/TCP"]
        TLS["TLS Handler<br/>TLS 1.2+ ECDHE<br/>Self-signed or operator certs"]
        Router["Request Router<br/>chat_completions.go"]
        SSRFCheck["SSRF Allowlist<br/>allowlist.go<br/>InferencePool watcher"]
        LRUCache["LRU Proxy Cache<br/>Caches reverse proxy handlers"]

        subgraph Connectors["P/D Connector Protocols"]
            NIXLv2["NIXL v2<br/>(default)"]
            NIXLv1["NIXL v1<br/>(deprecated)"]
            LMCache["LMCache<br/>(deprecated)"]
        end

        TLS --> Proxy
        Proxy --> Router
        Router -->|x-prefiller-host-port<br/>header present| SSRFCheck
        Router -->|no prefiller header| LRUCache
        SSRFCheck -->|validated| Connectors
        LRUCache -->|cached handler| Connectors
    end

    subgraph LocalPod["Co-located Pod"]
        vLLMDecoder["vLLM Decoder<br/>localhost:8001/TCP"]
    end

    subgraph RemotePods["Remote Pods"]
        Prefiller1["vLLM Prefiller Pod<br/>Dynamic port"]
        Prefiller2["vLLM Prefiller Pod<br/>Dynamic port"]
    end

    subgraph K8sControl["Kubernetes Control Plane"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
        InferencePool["InferencePool CR<br/>inference.networking.x-k8s.io/v1alpha2"]
    end

    Client -->|HTTP/HTTPS<br/>8000/TCP| TLS
    NIXLv2 -->|HTTP/HTTPS<br/>Dynamic port| Prefiller1
    NIXLv2 -->|HTTP/HTTPS<br/>Dynamic port| Prefiller2
    Connectors -->|HTTP/HTTPS<br/>8001/TCP| vLLMDecoder
    Router -->|direct forward<br/>8001/TCP| vLLMDecoder
    SSRFCheck -->|Watch pods/pool<br/>6443/TCP HTTPS| K8sAPI
    K8sAPI -.->|informer updates| InferencePool

    style Proxy fill:#4a90e2,stroke:#333,color:#fff
    style Router fill:#4a90e2,stroke:#333,color:#fff
    style SSRFCheck fill:#e74c3c,stroke:#333,color:#fff
    style TLS fill:#9b59b6,stroke:#333,color:#fff
    style LRUCache fill:#4a90e2,stroke:#333,color:#fff
    style NIXLv2 fill:#27ae60,stroke:#333,color:#fff
    style NIXLv1 fill:#95a5a6,stroke:#333,color:#fff
    style LMCache fill:#95a5a6,stroke:#333,color:#fff
    style vLLMDecoder fill:#f39c12,stroke:#333,color:#fff
    style Prefiller1 fill:#f39c12,stroke:#333,color:#fff
    style Prefiller2 fill:#f39c12,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style InferencePool fill:#f5a623,stroke:#333
    style Client fill:#ecf0f1,stroke:#333
