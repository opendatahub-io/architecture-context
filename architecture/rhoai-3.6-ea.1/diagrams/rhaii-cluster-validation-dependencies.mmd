graph LR
    RhaiiValidator["rhaii-cluster-validation<br/>CLI Tool"]

    %% External Dependencies (Build/Runtime)
    RhaiiValidator -->|"CLI framework"| Cobra["spf13/cobra v1.10.2"]
    RhaiiValidator -->|"K8s client"| ClientGo["k8s.io/client-go v0.35.3"]
    RhaiiValidator -->|"K8s types"| K8sAPI_lib["k8s.io/api v0.35.3"]
    RhaiiValidator -->|"K8s runtime"| Apimachinery["k8s.io/apimachinery v0.35.3"]
    RhaiiValidator -->|"YAML parsing"| YAMLv3["gopkg.in/yaml.v3 v3.0.1"]
    RhaiiValidator -->|"YAML marshal"| SigsYAML["sigs.k8s.io/yaml v1.6.0"]
    RhaiiValidator -->|"runtime"| GoRuntime["Go 1.26"]

    %% Runtime Integration
    RhaiiValidator -->|"HTTPS/6443<br/>resource CRUD"| K8sAPIServer["Kubernetes API Server"]

    %% Kubernetes Resources Created
    K8sAPIServer -->|manages| Namespace["Namespace<br/>(rhaii-validation)"]
    K8sAPIServer -->|manages| ServiceAccount["ServiceAccount<br/>(rhaii-validator)"]
    K8sAPIServer -->|manages| Jobs["batch/v1 Jobs<br/>(per-node agents)"]
    K8sAPIServer -->|manages| ConfigMap["ConfigMap<br/>(validation results)"]
    K8sAPIServer -->|manages| RBAC["ClusterRole +<br/>ClusterRoleBinding"]

    %% Hardware Dependencies (accessed by Agent pods)
    RhaiiValidator -.->|"sysfs read<br/>(privileged SCC)"| GPU["GPU Hardware<br/>(driver, ECC, memory)"]
    RhaiiValidator -.->|"IB verbs<br/>(kernel bypass)"| RDMA["RDMA / InfiniBand"]
    RhaiiValidator -.->|"TCP 12865 + iperf3"| NetworkHW["Network Stack"]

    %% Validation Targets (queried, not consumed)
    RhaiiValidator -.->|"CRD discovery"| GatewayAPICRD["Gateway API CRDs"]
    RhaiiValidator -.->|"CRD discovery"| InferencePoolCRD["InferencePool CRD"]
    RhaiiValidator -.->|"CRD discovery"| LWSCRD["LeaderWorkerSet CRD"]
    RhaiiValidator -.->|"CRD discovery"| CertMgrCRD["cert-manager CRD"]
    RhaiiValidator -.->|"NS presence"| IstioOp["Istio Operator"]
    RhaiiValidator -.->|"NS presence"| LWSOp["LWS Operator"]
    RhaiiValidator -.->|"NS presence"| CertMgrOp["cert-manager Operator"]

