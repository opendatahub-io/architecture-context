graph LR
    RV["rhaii-cluster-validation<br/>(rhaii-validator CLI)"]

    %% External Dependencies (build/runtime)
    RV -->|"CLI framework"| Cobra["spf13/cobra v1.10.2"]
    RV -->|"config parsing"| YAML["gopkg.in/yaml.v3"]
    RV -->|"K8s types"| K8sAPI_dep["k8s.io/api v0.35.3"]
    RV -->|"K8s types"| K8sApimach["k8s.io/apimachinery v0.35.3"]
    RV -->|"K8s client"| K8sClient["k8s.io/client-go v0.35.3"]
    RV -->|"YAML marshal"| SigsYAML["sigs.k8s.io/yaml v1.6.0"]
    RV -->|"runtime"| GoRuntime["Go 1.26<br/>(FIPS: strictfipsruntime)"]

    %% Kubernetes API (runtime target)
    RV -->|"6443/HTTPS<br/>TLS 1.2+<br/>kubeconfig auth"| K8sAPIServer["Kubernetes API Server"]

    %% Internal Platform Dependencies (validation targets)
    RV -.->|"CRD presence check"| GatewayAPI["Gateway API<br/>(gateways, httproutes CRDs)"]
    RV -.->|"CRD presence check"| InferencePool["Gateway API<br/>Inference Extension<br/>(inferencepools CRD)"]
    RV -.->|"CRD + operator health"| LWS["LeaderWorkerSet<br/>(CRD + operator pods)"]
    RV -.->|"CRD + operator health"| CertManager["cert-manager<br/>(CRD + operator pods)"]
    RV -.->|"operator health"| Istio["Istio<br/>(operator pods)"]

    %% Hardware (accessed by agent pods)
    RV -.->|"device access<br/>(privileged)"| GPUHw["GPU Hardware<br/>(NVIDIA drivers)"]
    RV -.->|"device access<br/>(privileged)"| RDMAHw["RDMA Devices<br/>(InfiniBand NICs)"]

    style RV fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% External deps styling
    style Cobra fill:#999,stroke:#333
    style YAML fill:#999,stroke:#333
    style K8sAPI_dep fill:#999,stroke:#333
    style K8sApimach fill:#999,stroke:#333
    style K8sClient fill:#999,stroke:#333
    style SigsYAML fill:#999,stroke:#333
    style GoRuntime fill:#999,stroke:#333
    style K8sAPIServer fill:#e8e8e8,stroke:#333

    %% Validation targets styling
    style GatewayAPI fill:#fff2cc,stroke:#d6b656
    style InferencePool fill:#fff2cc,stroke:#d6b656
    style LWS fill:#fff2cc,stroke:#d6b656
    style CertManager fill:#fff2cc,stroke:#d6b656
    style Istio fill:#fff2cc,stroke:#d6b656

    %% Hardware styling
    style GPUHw fill:#f8cecc,stroke:#b85450
    style RDMAHw fill:#f8cecc,stroke:#b85450
