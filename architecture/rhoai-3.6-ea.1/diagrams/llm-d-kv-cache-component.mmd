graph TB
    subgraph "llm-d-kv-cache System"
        direction TB

        subgraph GoComponents["Go Components"]
            Online["Online Event Processor<br/>(kv_events/online)<br/>Port 8080"]
            Offline["Offline Event Processor<br/>(kv_events/offline)"]
            PodReconciler["Pod Reconciler<br/>(controller-runtime)<br/>Watches /v1/Pod"]
            IndexerServer["IndexerService gRPC Server<br/>(kv_cache_index_service/server)<br/>Port 50051"]
            KVBlockLib["KV Block Index Library<br/>(pkg/kvcache/kvblock)"]
            KVEventsLib["KV Events Library<br/>(pkg/kvevents)"]
            TelemetryLib["Telemetry Library<br/>(pkg/telemetry)"]
        end

        subgraph PythonComponents["Python Components"]
            UDSTokenizer["UDS Tokenizer Sidecar<br/>(TokenizationService gRPC)<br/>UDS: /tmp/tokenizer"]
            PVCEvictor["PVC Evictor<br/>(evictor.py)"]
            FSBackend["FS Backend<br/>(kv_connectors)"]
        end

        subgraph MetricsLayer["Observability"]
            Metrics["/metrics Endpoint<br/>Prometheus"]
            Tracing["OTel Trace Export<br/>OTLP/gRPC"]
        end
    end

    %% Internal relationships
    Online -->|uses| KVBlockLib
    Online -->|uses| KVEventsLib
    Online -->|exposes| Metrics
    Offline -->|uses| KVBlockLib
    Offline -->|uses| KVEventsLib
    IndexerServer -->|uses| KVBlockLib
    PodReconciler -->|maintains consistency| KVBlockLib
    KVBlockLib -->|traces via| TelemetryLib
    Online -->|traces via| TelemetryLib
    IndexerServer -->|traces via| TelemetryLib
    TelemetryLib -->|exports| Tracing

    %% External interactions
    vLLM["vLLM Engines"] -->|ZMQ pub/sub<br/>tcp://5557<br/>topic: kv@| KVEventsLib
    KVBlockLib -->|read/write<br/>6379/TCP| Redis["Redis/Valkey"]
    Router["llm-d Endpoint Picker"] -->|POST /score_completions<br/>POST /score_chat_completions<br/>8080/TCP| Online
    ExternalClient["gRPC Client"] -->|GetPodScores<br/>50051/TCP| IndexerServer
    UDSTokenizer -.->|Tokenize, RenderChat*<br/>UDS /tmp/tokenizer| InferencePod["KServe Inference Pod"]
    PodReconciler -->|watches Pods<br/>6443/HTTPS| K8sAPI["Kubernetes API"]
    Tracing -->|OTLP/gRPC<br/>insecure| OTelCollector["OTel Collector"]

    %% Styling
    style Online fill:#4a90e2,stroke:#333,color:#fff
    style IndexerServer fill:#4a90e2,stroke:#333,color:#fff
    style PodReconciler fill:#4a90e2,stroke:#333,color:#fff
    style UDSTokenizer fill:#9b59b6,stroke:#333,color:#fff
    style KVBlockLib fill:#2ecc71,stroke:#333,color:#fff
    style KVEventsLib fill:#2ecc71,stroke:#333,color:#fff
    style TelemetryLib fill:#2ecc71,stroke:#333,color:#fff
    style vLLM fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style Router fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
    style InferencePod fill:#f5a623,stroke:#333
