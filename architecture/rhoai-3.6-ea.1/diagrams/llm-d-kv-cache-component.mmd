graph TB
    subgraph "llm-d-kv-cache"
        direction TB

        subgraph "Go Core Services"
            OnlineService["Online Service<br/>(kv-cache-manager)<br/>Port 8080/TCP"]
            PodReconciler["PodReconciler<br/>(controller-runtime)"]
            MetricsServer["Metrics Server<br/>/metrics"]
            IndexerService["IndexerService<br/>(gRPC)"]
        end

        subgraph "Python Services"
            Tokenizer["UDS Tokenizer<br/>(gRPC over UDS)<br/>/tmp/tokenizer/tokenizer-uds.socket"]
            TokenizerProbe["Tokenizer Health Probe<br/>Port 8082/TCP"]
            PVCEvictor["PVC Evictor<br/>(Python)"]
        end

        subgraph "Workers"
            WorkerPool["ZMQ Event Worker Pool<br/>(4 workers default)"]
        end

        OnlineService -->|processes events via| WorkerPool
        OnlineService -->|exposes| MetricsServer
    end

    %% External Interactions
    vLLM["vLLM Inference Engines"] -->|ZMQ events<br/>tcp://:5557<br/>topic: kv@| WorkerPool
    WorkerPool -->|updates| RedisValkey["Redis/Valkey<br/>KV Block Index"]

    EPP["llm-d EPP<br/>(Routing Layer)"] -->|POST /score_completions<br/>POST /score_chat_completions<br/>Port 8080| OnlineService
    OnlineService -->|queries prefix scores| RedisValkey

    PodReconciler -->|watches /v1/Pod| K8sAPI["Kubernetes API<br/>Port 6443"]
    PodReconciler -->|updates pod state| RedisValkey

    ColocatedSvc["Co-located Services"] -->|gRPC over UDS| Tokenizer
    Tokenizer -->|loads models| HFHub["HuggingFace Hub /<br/>TOKENIZERS_DIR"]

    OnlineService -->|OTLP/gRPC| OTelCollector["OpenTelemetry<br/>Collector"]
    IndexerService -->|OTLP/gRPC| OTelCollector

    %% Styling
    style OnlineService fill:#4a90e2,stroke:#333,color:#fff
    style PodReconciler fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style IndexerService fill:#4a90e2,stroke:#333,color:#fff
    style Tokenizer fill:#9b59b6,stroke:#333,color:#fff
    style TokenizerProbe fill:#9b59b6,stroke:#333,color:#fff
    style PVCEvictor fill:#9b59b6,stroke:#333,color:#fff
    style WorkerPool fill:#2ecc71,stroke:#333,color:#fff
    style vLLM fill:#f5a623,stroke:#333
    style RedisValkey fill:#e74c3c,stroke:#333,color:#fff
    style EPP fill:#f5a623,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OTelCollector fill:#999,stroke:#333,color:#fff
    style HFHub fill:#999,stroke:#333,color:#fff
    style ColocatedSvc fill:#f5a623,stroke:#333
