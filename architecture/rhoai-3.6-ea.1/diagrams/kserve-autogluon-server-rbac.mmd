graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager<br/>(namespace: kserve)"]
        SA_LLMISVC["$(llmisvc-serviceAccountName)<br/>(namespace: kserve)"]
        SA_LocalModel["kserve-localmodel-<br/>controller-manager<br/>(namespace: kserve)"]
        SA_LocalModelNode["kserve-localmodelnode-agent<br/>(namespace: kserve)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["kserve-manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Proxy["kserve-proxy-rolebinding<br/>(Cluster-scoped)"]
        CRB_LLMISVC["llmisvc-manager-rolebinding<br/>(namespace: kserve)"]
        CRB_LocalModel["kserve-localmodel-manager-<br/>rolebinding (Cluster-scoped)"]
        CRB_LocalModelNode["kserve-localmodelnode-agent-<br/>rolebinding (namespace: kserve)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLMISVC["kserve-llmisvc-manager-role"]
        CR_LocalModel["kserve-localmodel-manager-role"]
        CR_LocalModelNode["kserve-localmodelnode-agent-role"]
    end

    subgraph KServeResources["serving.kserve.io Resources"]
        IS["InferenceService<br/>(v1beta1)"]
        IG["InferenceGraph<br/>(v1alpha1)"]
        TM["TrainedModel<br/>(v1alpha1)"]
        CSR["ClusterServingRuntime<br/>(v1alpha1)"]
        SR["ServingRuntime<br/>(v1alpha1)"]
        CSC["ClusterStorageContainer<br/>(v1alpha1)"]
        LLMIS["LLMInferenceService<br/>(v1alpha1/v1alpha2)"]
        LLMISC["LLMInferenceServiceConfig<br/>(v1alpha1/v1alpha2)"]
        LMC["LocalModelCache<br/>(v1alpha1)"]
        LMNC["LocalModelNamespaceCache<br/>(v1alpha1)"]
        LMN["LocalModelNode<br/>(v1alpha1)"]
        LMNG["LocalModelNodeGroup<br/>(v1alpha1)"]
    end

    subgraph K8sResources["Kubernetes Core Resources"]
        Deploy["apps/Deployments"]
        Svc["core/Services"]
        Pods["core/Pods"]
        NS["core/Namespaces"]
        Secrets["core/Secrets"]
        SA_Res["core/ServiceAccounts"]
        CM["core/ConfigMaps"]
        Events["core/Events"]
        PV["core/PersistentVolumes"]
        PVC["core/PersistentVolumeClaims"]
        Nodes["core/Nodes"]
    end

    subgraph NetworkResources["Networking Resources"]
        VS["networking.istio.io/<br/>VirtualService"]
        HR["gateway.networking.k8s.io/<br/>HTTPRoute"]
        Ingress["networking.k8s.io/<br/>Ingress"]
        HPA["autoscaling/<br/>HorizontalPodAutoscaler"]
        SO["keda.sh/<br/>ScaledObject"]
        KnSvc["serving.knative.dev/<br/>Service"]
    end

    subgraph AuthResources["Auth Resources"]
        TR["authentication.k8s.io/<br/>TokenReview"]
        SAR["authorization.k8s.io/<br/>SubjectAccessReview"]
    end

    %% SA to CRB
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Proxy
    SA_LLMISVC -->|bound via| CRB_LLMISVC
    SA_LocalModel -->|bound via| CRB_LocalModel
    SA_LocalModelNode -->|bound via| CRB_LocalModelNode

    %% CRB to CR
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_LLMISVC -->|grants| CR_LLMISVC
    CRB_LocalModel -->|grants| CR_LocalModel
    CRB_LocalModelNode -->|grants| CR_LocalModelNode

    %% kserve-manager-role permissions
    CR_Manager -->|"CRUD + watch"| IS
    CR_Manager -->|"CRUD + watch"| IG
    CR_Manager -->|"CRUD + watch"| TM
    CR_Manager -->|"CRUD + watch"| CSR
    CR_Manager -->|"CRUD + watch"| SR
    CR_Manager -->|"get, list, watch"| LMC
    CR_Manager -->|"CRUD + watch"| Deploy
    CR_Manager -->|"CRUD + watch"| Svc
    CR_Manager -->|"CRUD + watch"| VS
    CR_Manager -->|"CRUD + watch"| HR
    CR_Manager -->|"CRUD + watch"| HPA
    CR_Manager -->|"CRUD + watch"| SO
    CR_Manager -->|"CRUD + watch"| KnSvc
    CR_Manager -->|"get, list, watch"| Pods
    CR_Manager -->|"create, get, update"| CM

    %% kserve-proxy-role permissions
    CR_Proxy -->|create| TR
    CR_Proxy -->|create| SAR

    %% kserve-llmisvc-manager-role permissions
    CR_LLMISVC -->|"CRUD + watch"| LLMIS
    CR_LLMISVC -->|"CRUD + watch"| LLMISC
    CR_LLMISVC -->|"CRUD + watch"| Deploy
    CR_LLMISVC -->|"CRUD + watch"| HR
    CR_LLMISVC -->|"CRUD + watch"| SO
    CR_LLMISVC -->|"CRUD + watch"| HPA
    CR_LLMISVC -->|"get, list, watch"| LMC
    CR_LLMISVC -->|create| TR
    CR_LLMISVC -->|create| SAR

    %% kserve-localmodel-manager-role permissions
    CR_LocalModel -->|"CRUD + watch"| LMC
    CR_LocalModel -->|"CRUD + watch"| LMNC
    CR_LocalModel -->|"CRUD + watch"| LMN
    CR_LocalModel -->|"CRUD + watch"| PV
    CR_LocalModel -->|"CRUD + watch"| PVC
    CR_LocalModel -->|"get, list, watch"| Nodes

    %% kserve-localmodelnode-agent-role permissions
    CR_LocalModelNode -->|"CRUD + watch"| LMN
    CR_LocalModelNode -->|"get, list, watch"| Nodes
    CR_LocalModelNode -->|"get, list, watch"| CSC
    CR_LocalModelNode -->|"get, list, watch"| LMNG

    %% Styling
    style SA_Manager fill:#4a90e2,stroke:#333,color:#fff
    style SA_LLMISVC fill:#4a90e2,stroke:#333,color:#fff
    style SA_LocalModel fill:#4a90e2,stroke:#333,color:#fff
    style SA_LocalModelNode fill:#4a90e2,stroke:#333,color:#fff

    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_Proxy fill:#f5a623,stroke:#333,color:#fff
    style CR_LLMISVC fill:#f5a623,stroke:#333,color:#fff
    style CR_LocalModel fill:#f5a623,stroke:#333,color:#fff
    style CR_LocalModelNode fill:#f5a623,stroke:#333,color:#fff

    style IS fill:#7ed321,stroke:#333,color:#fff
    style IG fill:#7ed321,stroke:#333,color:#fff
    style TM fill:#7ed321,stroke:#333,color:#fff
    style CSR fill:#7ed321,stroke:#333,color:#fff
    style SR fill:#7ed321,stroke:#333,color:#fff
    style CSC fill:#7ed321,stroke:#333,color:#fff
    style LLMIS fill:#7ed321,stroke:#333,color:#fff
    style LLMISC fill:#7ed321,stroke:#333,color:#fff
    style LMC fill:#7ed321,stroke:#333,color:#fff
    style LMNC fill:#7ed321,stroke:#333,color:#fff
    style LMN fill:#7ed321,stroke:#333,color:#fff
    style LMNG fill:#7ed321,stroke:#333,color:#fff

    style TR fill:#e8544e,stroke:#333,color:#fff
    style SAR fill:#e8544e,stroke:#333,color:#fff
