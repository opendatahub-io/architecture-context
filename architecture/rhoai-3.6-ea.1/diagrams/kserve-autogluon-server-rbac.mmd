graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager<br/>(kserve namespace)"]
        SA_LLMISVC["$(llmisvc-serviceAccountName)<br/>(kserve namespace)"]
        SA_LocalModel["kserve-localmodel-<br/>controller-manager<br/>(kserve namespace)"]
        SA_LocalModelNode["kserve-localmodelnode-<br/>agent<br/>(kserve namespace)"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["kserve-manager-<br/>rolebinding"]
        CRB_Proxy["kserve-proxy-<br/>rolebinding"]
        CRB_LLMISVC["llmisvc-manager-<br/>rolebinding"]
        CRB_LocalModel["kserve-localmodel-<br/>manager-rolebinding"]
        CRB_LocalModelNode["kserve-localmodelnode-<br/>agent-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLMISVC["kserve-llmisvc-<br/>manager-role"]
        CR_LocalModel["kserve-localmodel-<br/>manager-role"]
        CR_LocalModelNode["kserve-localmodelnode-<br/>agent-role"]
    end

    subgraph KServeResources["serving.kserve.io Resources"]
        ISVC["InferenceService"]
        IG["InferenceGraph"]
        TM["TrainedModel"]
        CSR["ClusterServingRuntime"]
        SR["ServingRuntime"]
        CSC["ClusterStorageContainer"]
        LLMIS["LLMInferenceService"]
        LLMISC["LLMInferenceServiceConfig"]
        LMC["LocalModelCache"]
        LMNC["LocalModelNamespaceCache"]
        LMN["LocalModelNode"]
        LMNG["LocalModelNodeGroup"]
    end

    subgraph CoreResources["Core Kubernetes Resources"]
        Deployments["apps/Deployments"]
        Services["core/Services"]
        Pods["core/Pods"]
        ConfigMaps["core/ConfigMaps"]
        Secrets["core/Secrets"]
        PVs["core/PersistentVolumes"]
        PVCs["core/PersistentVolumeClaims"]
        Nodes["core/Nodes"]
        Jobs["batch/Jobs"]
    end

    subgraph NetworkResources["Networking Resources"]
        Ingresses["networking.k8s.io/Ingress"]
        VirtualServices["networking.istio.io/<br/>VirtualService"]
        HTTPRoutes["gateway.networking.k8s.io/<br/>HTTPRoute"]
        InferencePools["inference.networking.k8s.io/<br/>InferencePool"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io/<br/>TokenReview"]
        SAR["authorization.k8s.io/<br/>SubjectAccessReview"]
        Webhooks["admissionregistration.k8s.io/<br/>Webhooks"]
    end

    %% SA → CRB → CR
    SA_Manager -->|"bound via"| CRB_Manager
    SA_Manager -->|"bound via"| CRB_Proxy
    SA_LLMISVC -->|"bound via"| CRB_LLMISVC
    SA_LocalModel -->|"bound via"| CRB_LocalModel
    SA_LocalModelNode -->|"bound via"| CRB_LocalModelNode

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Proxy -->|"grants"| CR_Proxy
    CRB_LLMISVC -->|"grants"| CR_LLMISVC
    CRB_LocalModel -->|"grants"| CR_LocalModel
    CRB_LocalModelNode -->|"grants"| CR_LocalModelNode

    %% CR_Manager permissions
    CR_Manager -->|"full CRUD"| ISVC
    CR_Manager -->|"full CRUD"| IG
    CR_Manager -->|"full CRUD"| TM
    CR_Manager -->|"full CRUD"| CSR
    CR_Manager -->|"full CRUD"| SR
    CR_Manager -->|"full CRUD"| Deployments
    CR_Manager -->|"full CRUD"| Services
    CR_Manager -->|"full CRUD"| Ingresses
    CR_Manager -->|"full CRUD"| VirtualServices
    CR_Manager -->|"full CRUD"| HTTPRoutes
    CR_Manager -->|"full CRUD"| Webhooks
    CR_Manager -->|"get,list,watch"| LMC
    CR_Manager -->|"get,list,watch"| Pods

    %% CR_Proxy permissions
    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAR

    %% CR_LLMISVC permissions
    CR_LLMISVC -->|"full CRUD"| LLMIS
    CR_LLMISVC -->|"full CRUD"| LLMISC
    CR_LLMISVC -->|"full CRUD"| HTTPRoutes
    CR_LLMISVC -->|"full CRUD"| InferencePools
    CR_LLMISVC -->|"full CRUD"| Deployments
    CR_LLMISVC -->|"get,list,watch"| LMC

    %% CR_LocalModel permissions
    CR_LocalModel -->|"full CRUD"| LMC
    CR_LocalModel -->|"full CRUD"| LMNC
    CR_LocalModel -->|"full CRUD"| LMN
    CR_LocalModel -->|"full CRUD"| PVs
    CR_LocalModel -->|"full CRUD"| PVCs
    CR_LocalModel -->|"get,list,watch"| Nodes

    %% CR_LocalModelNode permissions
    CR_LocalModelNode -->|"full CRUD"| LMN
    CR_LocalModelNode -->|"full CRUD"| Jobs
    CR_LocalModelNode -->|"get,list,watch"| Nodes
    CR_LocalModelNode -->|"get,list,watch"| CSC
    CR_LocalModelNode -->|"get,list,watch"| LMNG

    %% Styling
    style SA_Manager fill:#4a90e2,color:#fff
    style SA_LLMISVC fill:#4a90e2,color:#fff
    style SA_LocalModel fill:#4a90e2,color:#fff
    style SA_LocalModelNode fill:#4a90e2,color:#fff

    style CR_Manager fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_LLMISVC fill:#f5a623,color:#fff
    style CR_LocalModel fill:#f5a623,color:#fff
    style CR_LocalModelNode fill:#f5a623,color:#fff

    style CRB_Manager fill:#e8e8e8
    style CRB_Proxy fill:#e8e8e8
    style CRB_LLMISVC fill:#e8e8e8
    style CRB_LocalModel fill:#e8e8e8
    style CRB_LocalModelNode fill:#e8e8e8

    style ISVC fill:#7ed321,color:#fff
    style IG fill:#7ed321,color:#fff
    style TM fill:#7ed321,color:#fff
    style CSR fill:#7ed321,color:#fff
    style SR fill:#7ed321,color:#fff
    style LLMIS fill:#7ed321,color:#fff
    style LLMISC fill:#7ed321,color:#fff
    style LMC fill:#7ed321,color:#fff
    style LMNC fill:#7ed321,color:#fff
    style LMN fill:#7ed321,color:#fff
    style LMNG fill:#7ed321,color:#fff
    style CSC fill:#7ed321,color:#fff
