graph TD
    subgraph "vllm-gaudi RBAC"
        direction TB
        Note["No Kubernetes RBAC resources<br/>defined in this repository"]
    end

    subgraph "Platform-Managed RBAC (External)"
        direction TB

        subgraph "KServe ServingRuntime"
            SA["Service Account<br/>(created by KServe)"]
        end

        subgraph "Platform Roles"
            KServeRole["KServe Controller Roles<br/>(managed by kserve operator)"]
            ServingRole["Serving Runtime Roles<br/>(managed by platform)"]
        end

        subgraph "Resources Accessed"
            Pods["core/Pods<br/>(inference containers)"]
            Services["core/Services<br/>(model endpoints)"]
            ConfigMaps["core/ConfigMaps<br/>(model serving config)"]
            Secrets["core/Secrets<br/>(storage credentials)"]
        end

        SA -.->|"bound by platform"| KServeRole
        SA -.->|"bound by platform"| ServingRole
        KServeRole -.->|"manages"| Pods
        KServeRole -.->|"manages"| Services
        ServingRole -.->|"reads"| ConfigMaps
        ServingRole -.->|"reads"| Secrets
    end

    subgraph "Container Security Context"
        direction TB
        Image["Container Image<br/>UBI 9 based"]
        FIPS["FIPS: DISABLED<br/>openssl-fips-provider removed"]
        User["Run as: default<br/>(no explicit USER in Dockerfile)"]
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style KServeRole fill:#f5a623,stroke:#333,color:#fff
    style ServingRole fill:#f5a623,stroke:#333,color:#fff
    style Pods fill:#7ed321,stroke:#333,color:#fff
    style Services fill:#7ed321,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style Secrets fill:#7ed321,stroke:#333,color:#fff
    style Image fill:#e8e8e8,stroke:#333
    style FIPS fill:#ffcdd2,stroke:#e53935,stroke-width:2px
    style User fill:#e8e8e8,stroke:#333
