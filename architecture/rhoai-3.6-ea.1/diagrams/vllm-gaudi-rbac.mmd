graph TD
    subgraph "vllm-gaudi RBAC"
        Note["No RBAC roles or bindings<br/>defined in this repository"]
    end

    subgraph "Platform-Managed RBAC (KServe)"
        KServeSA["ServiceAccount<br/>(created by KServe)"]
        KServeRB["RoleBinding<br/>(managed by KServe)"]
        KServeRole["Role/ClusterRole<br/>(managed by KServe)"]
    end

    subgraph "Container Security"
        UID["Non-root execution<br/>UID: 2000"]
        NoPriv["No privileged mode<br/>Device access via<br/>device plugin"]
        NoFIPS["FIPS: NOT compliant<br/>OpenSSL FIPS provider<br/>explicitly removed"]
    end

    subgraph "Authentication"
        APIKey["Optional API Key<br/>via --api-key flag<br/>per-request validation"]
        PlatformAuth["Platform AuthN/AuthZ<br/>Managed by KServe /<br/>Service Mesh"]
    end

    KServeSA -->|"bound via"| KServeRB
    KServeRB -->|"grants"| KServeRole

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style KServeSA fill:#4a90e2,stroke:#333
    style KServeRB fill:#4a90e2,stroke:#333
    style KServeRole fill:#4a90e2,stroke:#333
    style UID fill:#d5e8d4,stroke:#82b366
    style NoPriv fill:#d5e8d4,stroke:#82b366
    style NoFIPS fill:#f8cecc,stroke:#b85450
    style APIKey fill:#ffe6cc,stroke:#d79b00
    style PlatformAuth fill:#ffe6cc,stroke:#d79b00
