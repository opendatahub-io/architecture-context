graph TB
    subgraph WVA["Workload Variant Autoscaler"]
        direction TB
        subgraph Controllers["Controllers"]
            ConfigMapCtrl["ConfigMap Controller<br/>Dynamic configuration reload"]
            HPACtrl["HPA Controller<br/>Monitors HPA state"]
            InferencePoolCtrl["InferencePool Controller<br/>Discovers inference workload pools"]
            ScaledObjectCtrl["ScaledObject Controller<br/>Optional KEDA integration"]
        end

        subgraph Core["Core Engine"]
            Coordinator["Coordinator"]
            ScalingEngine["Scaling Engine"]
            ScaleFromZero["Scale-from-Zero Engine<br/>dynamic client"]
            GPUPlugin["GPU Rebalancing Plugin<br/>ResourceQuota inspection"]
            DirectActuator["DirectActuator<br/>autoscaling/v1/Scale"]
        end

        subgraph Endpoints["Endpoints"]
            MetricsEP["Metrics Endpoint<br/>:8443/TCP TLS<br/>TokenReview + SAR"]
            HealthEP["Health Probe<br/>:8081/healthz"]
            ReadyEP["Readiness Probe<br/>:8081/readyz<br/>gates on ConfigMap bootstrap"]
        end

        Controllers --> Coordinator
        Coordinator --> ScalingEngine
        Coordinator --> ScaleFromZero
        ScalingEngine --> GPUPlugin
        ScalingEngine --> DirectActuator
    end

    %% External Resources Watched
    ConfigMapCR["ConfigMap"]
    HPACR["HorizontalPodAutoscaler"]
    InferencePoolCR["InferencePool CR<br/>inference.networking.k8s.io/v1<br/>inference.networking.x-k8s.io/v1alpha2"]
    ScaledObjectCR["ScaledObject CR<br/>keda.sh/v1alpha1"]

    ConfigMapCR -->|watched by| ConfigMapCtrl
    HPACR -->|watched by| HPACtrl
    InferencePoolCR -->|watched by| InferencePoolCtrl
    ScaledObjectCR -->|watched by| ScaledObjectCtrl

    %% External Dependencies
    Prometheus["Prometheus<br/>Metrics Source"]
    KubeAPI["Kubernetes API<br/>:6443 HTTPS"]
    Deployments["Deployments"]
    LWS["LeaderWorkerSets"]

    Coordinator -->|queries metrics| Prometheus
    DirectActuator -->|scales| Deployments
    DirectActuator -->|scales| LWS
    GPUPlugin -->|inspects| ResourceQuotas["ResourceQuotas"]
    ScaleFromZero -->|dynamic client| KubeAPI

    %% Styling
    style WVA fill:#e8f4fd,stroke:#4a90e2,stroke-width:2px
    style ConfigMapCtrl fill:#4a90e2,color:#fff
    style HPACtrl fill:#4a90e2,color:#fff
    style InferencePoolCtrl fill:#4a90e2,color:#fff
    style ScaledObjectCtrl fill:#4a90e2,color:#fff
    style Coordinator fill:#2c5282,color:#fff
    style ScalingEngine fill:#2c5282,color:#fff
    style ScaleFromZero fill:#2c5282,color:#fff
    style GPUPlugin fill:#2c5282,color:#fff
    style DirectActuator fill:#2c5282,color:#fff
    style MetricsEP fill:#7ed321,color:#fff
    style HealthEP fill:#7ed321,color:#fff
    style ReadyEP fill:#7ed321,color:#fff
    style ConfigMapCR fill:#f5a623
    style HPACR fill:#f5a623
    style InferencePoolCR fill:#f5a623
    style ScaledObjectCR fill:#f5a623
    style Prometheus fill:#e8e8e8
    style KubeAPI fill:#e8e8e8
    style Deployments fill:#e8e8e8
    style LWS fill:#e8e8e8
    style ResourceQuotas fill:#e8e8e8
