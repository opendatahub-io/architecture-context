graph TB
    subgraph "OGX Distribution Service"
        direction TB
        Entrypoint["entrypoint.sh<br/>Secret Resolution"]
        Server["OGX Server<br/>Port 8321/TCP"]
        AuthMiddleware["Auth Middleware<br/>OAuth2 Token (conditional)"]
        Entrypoint -->|resolves _FILE secrets<br/>launches ogx run| Server
        Server -->|when AUTH_ISSUER set| AuthMiddleware
    end

    subgraph "API Surfaces"
        direction LR
        Responses["/responses"]
        Messages["/v1/messages"]
        Batches["/batches"]
        Inference["/inference"]
        ToolRuntime["/tool_runtime"]
        VectorIO["/vector_io"]
        Files["/files"]
        FileProcessors["/file_processors"]
    end

    Server --> Responses
    Server --> Messages
    Server --> Batches
    Server --> Inference
    Server --> ToolRuntime
    Server --> VectorIO
    Server --> Files
    Server --> FileProcessors

    subgraph "Inference Providers (conditional)"
        direction LR
        vLLM["vLLM<br/>(VLLM_URL)"]
        Bedrock["AWS Bedrock<br/>(ENABLE_BEDROCK)"]
        WatsonX["IBM WatsonX<br/>(WATSONX_API_KEY)"]
        Azure["Azure<br/>(env-gated)"]
        OpenAI["OpenAI<br/>(env-gated)"]
        Gemini["Gemini<br/>(env-gated)"]
        Anthropic["Anthropic<br/>(env-gated)"]
        VertexAI["Vertex AI<br/>(env-gated)"]
    end

    subgraph "Storage Backends"
        direction LR
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>kv_postgres + sql_postgres"]
        Milvus["Milvus<br/>(MILVUS_ENDPOINT)"]
        PGVector["pgvector<br/>(ENABLE_PGVECTOR)"]
        Qdrant["Qdrant<br/>(ENABLE_QDRANT)"]
        S3["S3<br/>(ENABLE_S3)"]
    end

    subgraph "Observability"
        OTel["OpenTelemetry Collector<br/>(OTEL_SERVICE_NAME)"]
    end

    Client[External Client] -->|HTTP 8321| Server

    Inference -->|proxy requests| vLLM
    Inference -->|proxy requests| Bedrock
    Inference -->|proxy requests| WatsonX
    Inference -->|proxy requests| Azure
    Inference -->|proxy requests| OpenAI
    Inference -->|proxy requests| Gemini
    Inference -->|proxy requests| Anthropic
    Inference -->|proxy requests| VertexAI

    Server -->|state persistence| PostgreSQL
    VectorIO -->|vector operations| Milvus
    VectorIO -->|vector operations| PGVector
    VectorIO -->|vector operations| Qdrant
    Files -->|file storage| S3

    Server -.->|traces & metrics| OTel

    style Server fill:#4a90e2,stroke:#333,stroke-width:2px
    style Entrypoint fill:#4a90e2,stroke:#333
    style AuthMiddleware fill:#e74c3c,stroke:#333
    style Client fill:#f9f9f9,stroke:#999
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style vLLM fill:#7ed321,stroke:#333
    style Bedrock fill:#f5a623,stroke:#333
    style WatsonX fill:#f5a623,stroke:#333
    style Milvus fill:#00bcd4,stroke:#333
    style PGVector fill:#336791,stroke:#333,color:#fff
    style Qdrant fill:#00bcd4,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style OTel fill:#9b59b6,stroke:#333
