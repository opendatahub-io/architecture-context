graph TD
    subgraph "model-metadata-collection RBAC"
        direction TB

        Note["NOTE: This component defines<br/>NO ClusterRoles, NO RoleBindings,<br/>and NO ServiceAccounts with<br/>elevated permissions.<br/><br/>The data container runs<br/>sleep infinity and requires<br/>no Kubernetes API access."]
    end

    subgraph "Build-Time Authentication (CI/CD Only)"
        direction TB

        HFAuth["HuggingFace API Auth<br/>Method: Bearer Token<br/>Source: HF_TOKEN env var<br/>Required: No (optional)<br/>Purpose: Rate limit avoidance"]

        GHAuth["GitHub API Auth<br/>Method: Bearer Token<br/>Source: GITHUB_TOKEN env var<br/>Required: No (optional)<br/>Purpose: Rate limit avoidance"]

        RegAuth["Container Registry Auth<br/>Method: System credential chain<br/>Source: containers/image/v5<br/>Required: Depends on registry<br/>Purpose: OCI artifact access"]
    end

    style Note fill:#f9f9f9,stroke:#999,stroke-width:2px
    style HFAuth fill:#ffe6cc,stroke:#d79b00
    style GHAuth fill:#ffe6cc,stroke:#d79b00
    style RegAuth fill:#ffe6cc,stroke:#d79b00
