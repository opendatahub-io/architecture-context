graph TB
    subgraph External["External Clients"]
        User[Data Scientist / API Client]
        InferenceService["KServe/ModelMesh<br/>Inference Service"]
        PromScraper["Prometheus"]
    end

    subgraph AuthProxy["Auth Proxy Layer"]
        KubeRBACProxy["kube-rbac-proxy<br/>Port 8443 (external)<br/>Kubernetes RBAC Auth"]
    end

    subgraph TrustyAI["TrustyAI Service (FastAPI + Hypercorn)"]
        direction TB

        subgraph Entrypoint["Container Entrypoint"]
            CMD["python -m src.main"]
        end

        subgraph Servers["ASGI Servers"]
            Hypercorn["Hypercorn<br/>HTTP 8080 (loopback)<br/>HTTPS 4443 (all interfaces)"]
            Uvicorn["Uvicorn<br/>(alternative ASGI)"]
        end

        subgraph APIEndpoints["FastAPI Endpoints (87 routes)"]
            Consumer["/consumer/kserve/v2<br/>Inference Data Ingestion"]
            Fairness["/metrics/group/fairness/*<br/>SPD, DIR"]
            Drift["/metrics/drift/*<br/>KS, Jensen-Shannon,<br/>Fourier MMD, Mean Shift"]
            Explainers["/explainers/*<br/>LIME, SHAP, CF, PDP,<br/>TS-Saliency"]
            Health["/q/health/live<br/>/q/health/ready"]
            Metrics["/q/metrics<br/>Prometheus Metrics"]
            Info["/info/*<br/>Service Metadata"]
        end

        subgraph Background["Background Tasks"]
            MetricsCalc["Periodic Metrics Calculator<br/>(asyncio, 30s interval)"]
        end

        subgraph StorageLayer["Storage Interface"]
            StorageSwitch{"SERVICE_STORAGE_FORMAT"}
            PVCStorage["PVC/HDF5 Storage<br/>(h5py)"]
            MariaDBStorage["MariaDB Client<br/>(optional TLS)"]
        end

        CMD --> Hypercorn
        Hypercorn --> APIEndpoints
        MetricsCalc -->|calculates| Metrics
        StorageSwitch -->|pvc| PVCStorage
        StorageSwitch -->|mariadb| MariaDBStorage
        Consumer -->|stores| StorageSwitch
        Fairness -->|reads| StorageSwitch
        Drift -->|reads| StorageSwitch
        Explainers -->|reads| StorageSwitch
        MetricsCalc -->|reads| StorageSwitch
    end

    subgraph ExternalStorage["External Storage"]
        PVC["PersistentVolumeClaim<br/>HDF5 Files"]
        MariaDB["MariaDB<br/>Port 3306/TCP<br/>Optional TLS"]
    end

    %% External flows
    User -->|"HTTPS/443"| KubeRBACProxy
    InferenceService -->|"POST /consumer/kserve/v2"| KubeRBACProxy
    KubeRBACProxy -->|"HTTP/8080 (loopback)"| Hypercorn
    User -->|"HTTPS/4443 (direct TLS)"| Hypercorn
    PromScraper -->|"GET /q/metrics"| KubeRBACProxy

    %% Storage flows
    PVCStorage --> PVC
    MariaDBStorage -->|"MySQL/3306<br/>Optional TLS"| MariaDB

    %% Styling
    style TrustyAI fill:#e8f4f8,stroke:#4a90e2,stroke-width:2px
    style KubeRBACProxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style Consumer fill:#d5e8d4,stroke:#82b366
    style Fairness fill:#d5e8d4,stroke:#82b366
    style Drift fill:#d5e8d4,stroke:#82b366
    style Explainers fill:#d5e8d4,stroke:#82b366
    style Health fill:#fff2cc,stroke:#d6b656
    style Metrics fill:#fff2cc,stroke:#d6b656
    style Hypercorn fill:#4a90e2,color:#fff
    style MetricsCalc fill:#e1d5e7,stroke:#9673a6
    style PVC fill:#f5f5f5,stroke:#666
    style MariaDB fill:#f5f5f5,stroke:#666
