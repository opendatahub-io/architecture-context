graph TB
    subgraph MaaSAPI["maas-api (REST API Server)"]
        direction TB
        GinRouter["Gin HTTP Router<br/>Port 8080/TCP"]
        MetricsServer["Metrics Server<br/>Port 9090/TCP"]
        TenantAuthMW["Tenant Auth Middleware<br/>TokenReview + SAR"]
        TLSConfig["TLS Config<br/>TLS 1.2+ / FIPS"]
        DBClient["PostgreSQL Client<br/>(pgx driver)"]

        GinRouter --> TenantAuthMW
        GinRouter --> TLSConfig
        GinRouter --> DBClient
    end

    subgraph MaaSController["maas-controller (Kubernetes Operator)"]
        direction TB
        AITenantCtrl["AITenant Controller"]
        MaaSModelRefCtrl["MaaSModelRef Controller"]
        MaaSSubCtrl["MaaSSubscription Controller"]
        MaaSAuthPolicyCtrl["MaaSAuthPolicy Controller"]
        ExternalModelCtrl["ExternalModel Controller"]
        TenantConfigCtrl["MaasTenantConfig Controller"]
        DeploymentCtrl["Deployment Controller"]
        LifecycleCtrl["Lifecycle Reconciler"]
        WebhookServer["Webhook Server<br/>Validating Admission"]
    end

    subgraph CRDs["Custom Resources (maas.opendatahub.io/v1alpha1)"]
        AITenantCR["AITenant"]
        MaaSModelRefCR["MaaSModelRef"]
        MaaSSubCR["MaaSSubscription"]
        MaaSAuthPolicyCR["MaaSAuthPolicy"]
        ExternalModelCR["ExternalModel"]
        TenantConfigCR["MaasTenantConfig"]
        ConfigCR["Config"]
        TenantCR["Tenant"]
    end

    %% Controller watches
    AITenantCtrl -->|reconciles| AITenantCR
    MaaSModelRefCtrl -->|reconciles| MaaSModelRefCR
    MaaSSubCtrl -->|reconciles| MaaSSubCR
    MaaSAuthPolicyCtrl -->|reconciles| MaaSAuthPolicyCR
    ExternalModelCtrl -->|reconciles| ExternalModelCR
    TenantConfigCtrl -->|reconciles| TenantConfigCR

    %% Cross-watches
    MaaSModelRefCtrl -.->|watches| MaaSAuthPolicyCR
    MaaSModelRefCtrl -.->|watches| MaaSSubCR
    MaaSSubCtrl -.->|watches| MaaSModelRefCR
    MaaSAuthPolicyCtrl -.->|watches| MaaSModelRefCR
    MaaSAuthPolicyCtrl -.->|watches| AITenantCR

    %% Webhook validations
    WebhookServer -->|validates| AITenantCR
    WebhookServer -->|validates| MaaSAuthPolicyCR
    WebhookServer -->|validates| MaaSModelRefCR
    WebhookServer -->|validates| MaaSSubCR

    %% API reads CRDs
    GinRouter -.->|reads| MaaSModelRefCR
    GinRouter -.->|reads| MaaSSubCR
    GinRouter -.->|reads| MaaSAuthPolicyCR

    %% External integrations
    User["User / Client"] -->|HTTPS/8443| HTTPRoute
    HTTPRoute["HTTPRoute<br/>(maas-api-route)"] -->|routes to| GinRouter

    MaaSAuthPolicyCtrl -->|creates| KuadrantAuthPolicy["Kuadrant AuthPolicy"]
    MaaSSubCtrl -->|creates| TokenRateLimit["TokenRateLimitPolicy"]
    MaaSModelRefCtrl -.->|conditional watch| KServeLLM["KServe LLMInferenceService"]

    DBClient -->|pgx| PostgreSQL["PostgreSQL<br/>(maas-db-config secret)"]
    TenantAuthMW -->|TokenReview| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% External dependencies
    HTTPRoute -->|parent ref| Gateway["maas-default-gateway<br/>(openshift-ingress)"]

    %% Styles
    style MaaSAPI fill:#4a90e2,stroke:#333,color:#fff
    style MaaSController fill:#4a90e2,stroke:#333,color:#fff
    style CRDs fill:#f5a623,stroke:#333,color:#000
    style PostgreSQL fill:#336791,stroke:#333,color:#fff
    style K8sAPI fill:#326ce5,stroke:#333,color:#fff
    style Gateway fill:#e8e8e8,stroke:#333
    style KuadrantAuthPolicy fill:#7ed321,stroke:#333
    style TokenRateLimit fill:#7ed321,stroke:#333
    style KServeLLM fill:#7ed321,stroke:#333
    style HTTPRoute fill:#e8e8e8,stroke:#333
    style User fill:#f9f9f9,stroke:#999
