graph TB
    subgraph MaaS["Models-as-a-Service"]
        direction TB

        subgraph API["maas-api (Gin HTTP Server)"]
            direction LR
            ModelsEP["/v1/models<br/>GET"]
            SubsEP["/v1/subscriptions<br/>GET, POST"]
            APIKeysEP["/v1/api-keys/*<br/>POST, DELETE"]
            TenantsEP["/v1/tenants<br/>GET (internal only)"]
            HealthEP["/health<br/>GET"]
            MetricsEP["/metrics<br/>:9090"]
        end

        subgraph Controller["maas-controller (controller-runtime Operator)"]
            direction LR
            AITenantCtrl["AITenant<br/>Controller"]
            AuthPolicyCtrl["MaaSAuthPolicy<br/>Controller"]
            ModelRefCtrl["MaaSModelRef<br/>Controller"]
            SubCtrl["MaaSSubscription<br/>Controller"]
            TenantConfigCtrl["MaasTenantConfig<br/>Controller"]
            TenantCtrl["Tenant<br/>Controller"]
            LifecycleCtrl["Lifecycle<br/>Controller"]
            ExtModelCtrl["ExternalModel<br/>Controller"]
        end

        subgraph Webhooks["Validating Webhooks"]
            WHAITenant["AITenant<br/>Validator"]
            WHAuthPolicy["MaaSAuthPolicy<br/>Validator"]
            WHModelRef["MaaSModelRef<br/>Validator"]
            WHSubscription["MaaSSubscription<br/>Validator"]
        end
    end

    %% CRDs
    subgraph CRDs["maas.opendatahub.io/v1alpha1 CRDs"]
        AITenantCR["AITenant"]
        ConfigCR["Config"]
        ExternalModelCR["ExternalModel"]
        AuthPolicyCR["MaaSAuthPolicy"]
        ModelRefCR["MaaSModelRef"]
        SubscriptionCR["MaaSSubscription"]
        TenantConfigCR["MaasTenantConfig"]
        TenantCR["Tenant"]
    end

    %% Controller watches
    AITenantCtrl -->|reconciles| AITenantCR
    AuthPolicyCtrl -->|reconciles| AuthPolicyCR
    ModelRefCtrl -->|reconciles| ModelRefCR
    SubCtrl -->|reconciles| SubscriptionCR
    TenantConfigCtrl -->|reconciles| TenantConfigCR
    TenantCtrl -->|reconciles| TenantCR
    ExtModelCtrl -->|reconciles| ExternalModelCR
    LifecycleCtrl -->|watches| ConfigCR

    %% External integrations
    Gateway["Gateway API<br/>(data-science-gateway)"]
    Kuadrant["Kuadrant/Authorino<br/>AuthPolicy"]
    KServe["KServe<br/>LLMInferenceService"]
    K8sAPI["Kubernetes API<br/>:6443"]
    PostgreSQL["PostgreSQL<br/>Database"]
    OTel["OpenTelemetry<br/>Collector"]

    %% Integration flows
    Gateway -->|HTTPRoute| API
    AuthPolicyCtrl -->|creates| Kuadrant
    ModelRefCtrl -.->|conditional watch| KServe
    SubCtrl -->|creates| TokenRateLimit["TokenRateLimitPolicy"]
    Controller -->|REST/WebSocket| K8sAPI
    API -->|pgx| PostgreSQL
    API -->|OTLP/gRPC| OTel

    %% Styling
    style API fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhooks fill:#9b59b6,stroke:#333,color:#fff
    style CRDs fill:#f5a623,stroke:#333
    style Gateway fill:#e8e8e8,stroke:#333
    style Kuadrant fill:#e8e8e8,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style OTel fill:#e8e8e8,stroke:#333
    style TokenRateLimit fill:#e8e8e8,stroke:#333
