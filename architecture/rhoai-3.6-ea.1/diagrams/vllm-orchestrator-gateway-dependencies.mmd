graph LR
    Gateway["vllm-orchestrator-gateway<br/>(Rust Service)"]

    %% Internal Platform Dependencies
    Gateway -->|"REST proxy<br/>/api/v2/chat/completions-detection<br/>HTTP or HTTPS (mTLS)"| Orchestrator["vLLM Orchestrator<br/>(Backend)"]

    %% Core Runtime Frameworks
    Gateway -->|"web framework"| Axum["Axum 0.7.9"]
    Gateway -->|"async runtime"| Tokio["Tokio 1.41.1"]
    Gateway -->|"HTTP client"| Reqwest["reqwest 0.12.12"]

    %% TLS / Crypto
    Gateway -->|"TLS provider"| NativeTLS["native-tls 0.2.12"]
    Gateway -->|"crypto (PKCS#12)"| OpenSSL["openssl 0.10.73"]

    %% Serialization
    Gateway -->|"JSON serde"| SerdeJSON["serde_json 1.0.133"]
    Gateway -->|"YAML config"| SerdeYML["serde_yml 0.0.12"]
    Gateway -->|"serialization"| Serde["serde 1.0.215"]

    %% Observability
    Gateway -->|"logging/tracing"| Tracing["tracing 0.1.41"]

    %% Other
    Gateway -->|"async streams"| Futures["futures 0.3.30"]
    Gateway -->|"HTTP middleware"| TowerHTTP["tower-http 0.6.2"]
    Gateway -->|"pattern matching"| Regex["regex 1.11.1"]
    Gateway -->|"error handling"| Anyhow["anyhow 1.0.94"]

    %% Filesystem mounts (optional)
    TLSCerts["TLS Certificates<br/>/etc/tls/private/"] -.->|"optional mTLS certs"| Gateway
    ConfigFile["config.yaml<br/>/app/config/"] -.->|"route & detector config"| Gateway

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,color:#fff

    style Axum fill:#999,stroke:#333,color:#fff
    style Tokio fill:#999,stroke:#333,color:#fff
    style Reqwest fill:#999,stroke:#333,color:#fff
    style NativeTLS fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
    style SerdeJSON fill:#999,stroke:#333,color:#fff
    style SerdeYML fill:#999,stroke:#333,color:#fff
    style Serde fill:#999,stroke:#333,color:#fff
    style Tracing fill:#999,stroke:#333,color:#fff
    style Futures fill:#999,stroke:#333,color:#fff
    style TowerHTTP fill:#999,stroke:#333,color:#fff
    style Regex fill:#999,stroke:#333,color:#fff
    style Anyhow fill:#999,stroke:#333,color:#fff

    style TLSCerts fill:#fff2cc,stroke:#d6b656
    style ConfigFile fill:#f5a623,stroke:#333
