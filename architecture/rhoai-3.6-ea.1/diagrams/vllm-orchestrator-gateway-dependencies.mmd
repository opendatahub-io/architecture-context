graph LR
    Gateway["vllm-orchestrator-gateway<br/>(Rust Service)"]

    %% Internal Platform Dependencies
    Gateway -->|"REST<br/>POST /api/v2/chat/completions-detection<br/>8032/TCP HTTP/HTTPS"| Orchestrator["vllm-orchestrator"]

    %% Runtime Framework Dependencies
    Gateway -->|runtime framework| Axum["axum 0.7.9"]
    Gateway -->|runtime framework| Tokio["tokio 1.41.1"]
    Gateway -->|HTTP middleware| TowerHTTP["tower-http 0.6.2"]

    %% HTTP Client
    Gateway -->|HTTP client| Reqwest["reqwest 0.12.12"]

    %% Serialization
    Gateway -->|serialization| Serde["serde 1.0.215"]
    Gateway -->|JSON| SerdeJSON["serde_json 1.0.133"]
    Gateway -->|YAML config| SerdeYML["serde_yml 0.0.12"]

    %% TLS / Crypto
    Gateway -->|TLS/crypto| OpenSSL["openssl 0.10.73"]
    Gateway -->|TLS| NativeTLS["native-tls 0.2.12"]

    %% Observability
    Gateway -->|tracing| Tracing["tracing 0.1.41"]
    Gateway -->|log output| TracingSub["tracing-subscriber 0.3.19"]

    %% Utility
    Gateway -->|error handling| Anyhow["anyhow 1.0.94"]
    Gateway -->|async streams| Futures["futures 0.3.30"]
    Gateway -->|pattern matching| Regex["regex 1.11.1"]

    %% Platform Infrastructure
    OpenShift["OpenShift Platform"] -.->|"injects TLS certs<br/>/etc/tls/private/"| Gateway

    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style Axum fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style TowerHTTP fill:#999,stroke:#333
    style Reqwest fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style SerdeJSON fill:#999,stroke:#333
    style SerdeYML fill:#999,stroke:#333
    style OpenSSL fill:#f5a623,stroke:#333
    style NativeTLS fill:#f5a623,stroke:#333
    style Tracing fill:#999,stroke:#333
    style TracingSub fill:#999,stroke:#333
    style Anyhow fill:#999,stroke:#333
    style Futures fill:#999,stroke:#333
    style Regex fill:#999,stroke:#333
    style OpenShift fill:#e8e8e8,stroke:#333,stroke-dasharray: 5 5
