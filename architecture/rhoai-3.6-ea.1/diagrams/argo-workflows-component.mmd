graph TB
    subgraph "Argo Workflows"
        subgraph "argo-server Deployment"
            APIServer["Argo API Server<br/>Port: 2746"]
            GRPCGateway["gRPC Gateway<br/>(HTTP reverse proxy)"]
            Gatekeeper["Gatekeeper Interceptor<br/>(AuthN/AuthZ)"]
            ArtifactHandler["Artifact HTTP Handlers"]
            OAuthHandler["OAuth2 Callback/Redirect"]
            MetricsEndpoint["Metrics Endpoint<br/>/metrics"]

            Gatekeeper -->|chains into| APIServer
            APIServer -->|/api/ routes| GRPCGateway
            APIServer -->|/artifacts/| ArtifactHandler
            APIServer -->|/oauth2/| OAuthHandler
            APIServer -->|/metrics| MetricsEndpoint
        end

        subgraph "workflow-controller Deployment"
            Controller["Workflow Controller<br/>Port: 6060 (health)"]
            MemoCache["ConfigMap Memoization Cache"]
            ArtifactGC["Artifact GC Manager"]

            Controller -->|manages| MemoCache
            Controller -->|manages| ArtifactGC
        end

        subgraph "argoexec Sidecar"
            ArgoExec["argoexec<br/>(per workflow pod)"]
            ArtifactCollector["Artifact Collector"]
            ScriptRunner["Script Executor"]
            LifecycleMgr["Container Lifecycle Mgr"]

            ArgoExec --> ArtifactCollector
            ArgoExec --> ScriptRunner
            ArgoExec --> LifecycleMgr
        end
    end

    %% CRDs
    WorkflowCR["Workflow CR"]
    CronWorkflowCR["CronWorkflow CR"]
    ClusterWFTemplate["ClusterWorkflowTemplate CR"]
    WFTemplate["WorkflowTemplate CR"]
    WFEventBinding["WorkflowEventBinding CR"]
    WFTaskSet["WorkflowTaskSet CR"]
    WFTaskResult["WorkflowTaskResult CR"]
    WFArtifactGC["WorkflowArtifactGCTask CR"]

    %% External
    Client["Client<br/>(CLI / UI / DSP)"]
    K8sAPI["Kubernetes API<br/>6443/TCP"]
    ArtifactStorage["Artifact Storage<br/>(S3/GCS/Azure/HDFS)"]

    %% Flows
    Client -->|"gRPC + HTTP/REST<br/>2746/TCP"| Gatekeeper
    Controller -->|watches| WorkflowCR
    Controller -->|watches| CronWorkflowCR
    Controller -->|watches| ClusterWFTemplate
    Controller -->|watches| WFTemplate
    Controller -->|watches| WFEventBinding
    Controller -->|watches| WFTaskSet
    Controller -->|watches| WFTaskResult
    Controller -->|watches| WFArtifactGC
    Controller -->|"creates Pods,<br/>ConfigMaps, PDBs"| K8sAPI
    Controller -->|spawns| ArgoExec
    ArtifactCollector -->|"upload/download"| ArtifactStorage
    ArtifactHandler -->|"serves artifacts"| ArtifactStorage
    APIServer -->|"CRUD operations"| K8sAPI

    %% Styles
    style APIServer fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style ArgoExec fill:#4a90e2,color:#fff
    style Gatekeeper fill:#e74c3c,color:#fff
    style WorkflowCR fill:#f5a623
    style CronWorkflowCR fill:#f5a623
    style ClusterWFTemplate fill:#f5a623
    style WFTemplate fill:#f5a623
    style WFEventBinding fill:#f5a623
    style WFTaskSet fill:#f5a623
    style WFTaskResult fill:#f5a623
    style WFArtifactGC fill:#f5a623
    style K8sAPI fill:#e8e8e8
    style ArtifactStorage fill:#e8e8e8
    style Client fill:#7ed321
