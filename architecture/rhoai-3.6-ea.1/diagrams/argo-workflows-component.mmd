graph TB
    subgraph DSPOperator["Data Science Pipelines Operator"]
        DSP[DSP Operator]
    end

    subgraph ArgoWorkflows["Argo Workflows Component"]
        subgraph ArgoServer["argo-server Deployment"]
            APIServer["API Server<br/>Port 2746/TCP<br/>gRPC + HTTP Gateway"]
            Gatekeeper["Auth Gatekeeper<br/>gRPC Interceptor"]
            APIServer -->|auth enforced by| Gatekeeper
        end

        subgraph WFController["workflow-controller Deployment"]
            Controller["Workflow Controller<br/>Reconciliation Loop"]
            HealthCheck["Health Check<br/>Port 6060/TCP /healthz"]
            MetricsEndpoint["Metrics<br/>/metrics"]
        end

        subgraph ArgoExec["argoexec Sidecar"]
            Exec["argoexec<br/>Artifact I/O &<br/>Container Lifecycle"]
        end
    end

    subgraph CRDs["CRDs (argoproj.io/v1alpha1)"]
        WorkflowCR[Workflow]
        CronWorkflowCR[CronWorkflow]
        WFTemplate[WorkflowTemplate]
        ClusterWFTemplate[ClusterWorkflowTemplate]
        WFEventBinding[WorkflowEventBinding]
        WFArtifactGC[WorkflowArtifactGCTask]
        WFTaskResult[WorkflowTaskResult]
        WFTaskSet[WorkflowTaskSet]
    end

    DSP -->|deploys & configures| ArgoWorkflows

    WorkflowCR -->|watched by| Controller
    CronWorkflowCR -->|watched by| Controller
    WFTemplate -->|referenced by| Controller
    ClusterWFTemplate -->|referenced by| Controller

    Controller -->|creates step| StepPod[Step Pod]
    StepPod -->|runs| Exec
    Exec -->|reports via| WFTaskResult
    Controller -->|manages| WFTaskSet
    Controller -->|manages| WFArtifactGC

    Controller -->|CRUD| K8sAPI[Kubernetes API<br/>6443/TCP HTTPS]
    APIServer -->|CRUD| K8sAPI

    Gatekeeper -->|Client mode| BearerToken["Bearer Token<br/>→ K8s API delegation"]
    Gatekeeper -->|Server mode| ServiceAccount["Server SA Auth"]
    Gatekeeper -->|SSO mode| OIDC["OIDC Token<br/>Validation"]

    %% gRPC Services
    APIServer -->|serves| gRPCSvc["9 gRPC Services<br/>WorkflowService<br/>CronWorkflowService<br/>EventService<br/>InfoService<br/>..."]

    %% HTTP Endpoints
    APIServer -->|serves| HTTPEndpoints["18 HTTP Endpoints<br/>/api/ /artifacts/<br/>/oauth2/ /metrics"]

