graph LR
    TrustyAI["TrustyAI Service<br/>(FastAPI + Hypercorn)"]

    %% Internal RHOAI Dependencies
    TrustyAI -->|"auth delegation<br/>HTTP/8080 loopback"| KubeRBAC["kube-rbac-proxy<br/>(sidecar)"]
    TrustyAI -->|"inference data<br/>KServe v2 protocol"| KServe["KServe/ModelMesh"]

    %% Runtime Framework Dependencies
    TrustyAI -->|"ASGI server"| Hypercorn["Hypercorn >=0.18"]
    TrustyAI -->|"web framework"| FastAPI["FastAPI >=0.116"]
    TrustyAI -->|"alt ASGI server"| Uvicorn["Uvicorn >=0.38"]

    %% Core Library Dependencies
    TrustyAI -->|"data processing"| NumPy["NumPy >=2.0"]
    TrustyAI -->|"data frames"| Pandas["Pandas >=3.0"]
    TrustyAI -->|"ML algorithms"| SciKit["scikit-learn >=1.7"]
    TrustyAI -->|"statistics"| SciPy["SciPy >=1.15"]
    TrustyAI -->|"NLP evaluation"| LMEval["lm-eval >=0.4"]
    TrustyAI -->|"NLP tokenization"| NLTK["NLTK >=3.9.4"]

    %% Storage Dependencies
    TrustyAI -->|"HDF5 file I/O"| H5py["h5py >=3.13"]
    TrustyAI -->|"optional DB<br/>MySQL/3306"| MariaDBLib["mariadb >=1.1"]

    %% Security & Transport Dependencies
    TrustyAI -->|"TLS/crypto<br/>FIPS-compliant"| Cryptography["cryptography >=48.0.1"]
    TrustyAI -->|"HTTP/2 support"| H2["h2 4.3.0"]
    TrustyAI -->|"serialization"| Protobuf["protobuf >=7"]

    %% Observability Dependencies
    TrustyAI -->|"metrics export"| PromClient["prometheus-client >=0.22"]

    %% Infrastructure Dependencies (inbound)
    Prometheus["Prometheus"] -->|"scrapes /q/metrics<br/>via kube-rbac-proxy"| TrustyAI
    K8s["Kubernetes API"] -->|"RBAC validation"| KubeRBAC

    %% External Services
    TrustyAI -->|"data storage<br/>HDF5 files"| PVC["PVC<br/>(default)"]
    TrustyAI -->|"data storage<br/>MySQL/3306<br/>optional TLS"| MariaDB["MariaDB<br/>(optional)"]

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal RHOAI
    style KubeRBAC fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff

    %% Runtime frameworks
    style Hypercorn fill:#dae8fc,stroke:#6c8ebf
    style FastAPI fill:#dae8fc,stroke:#6c8ebf
    style Uvicorn fill:#dae8fc,stroke:#6c8ebf

    %% Libraries
    style NumPy fill:#e8e8e8,stroke:#666
    style Pandas fill:#e8e8e8,stroke:#666
    style SciKit fill:#e8e8e8,stroke:#666
    style SciPy fill:#e8e8e8,stroke:#666
    style LMEval fill:#e8e8e8,stroke:#666
    style NLTK fill:#e8e8e8,stroke:#666
    style H5py fill:#e8e8e8,stroke:#666
    style MariaDBLib fill:#e8e8e8,stroke:#666
    style Cryptography fill:#e8e8e8,stroke:#666
    style H2 fill:#e8e8e8,stroke:#666
    style Protobuf fill:#e8e8e8,stroke:#666
    style PromClient fill:#e8e8e8,stroke:#666

    %% External services
    style Prometheus fill:#f5a623,stroke:#333,color:#fff
    style K8s fill:#f5a623,stroke:#333,color:#fff
    style PVC fill:#f5f5f5,stroke:#666
    style MariaDB fill:#f5f5f5,stroke:#666
