graph LR
    VllmGaudi["vllm-gaudi<br/>(HPU Plugin for vLLM)"]

    %% Build-time Dependencies (Core)
    VllmGaudi -->|"build-time install<br/>v0.16.0"| VllmUpstream["vLLM<br/>(upstream inference engine)"]
    VllmGaudi -->|"build-time install<br/>HPU drivers"| SynapseAI["Intel SynapseAI<br/>(device drivers & runtime)"]
    VllmGaudi -->|"build-time install<br/>DL framework"| PyTorchGaudi["PyTorch for Gaudi<br/>(Habana fork)"]

    %% Base Image
    VllmGaudi -->|"base image"| UBI9["UBI 9<br/>(Red Hat base)"]

    %% Python Runtime Dependencies
    VllmGaudi -->|">=1.26.0"| NumPy["numpy"]
    VllmGaudi -->|">=2.2.3"| Pandas["pandas"]
    VllmGaudi -->|">=2.48.0"| Ray["ray"]
    VllmGaudi -->|">=4.56.0, <5"| Transformers["transformers"]
    VllmGaudi -->|">=0.58.0"| Numba["numba"]
    VllmGaudi -->|"required"| Regex["regex"]

    %% Platform Integration (runtime - not in this repo)
    KServe["KServe<br/>ServingRuntime"] -.->|"manages container<br/>lifecycle"| VllmGaudi
    Dashboard["ODH Dashboard"] -.->|"UI management<br/>(via KServe)"| VllmGaudi

    %% Hardware
    VllmGaudi -->|"accelerator"| GaudiHPU["Intel Gaudi<br/>Accelerator (HPU)"]

    %% External Storage (runtime)
    VllmGaudi -.->|"model weights<br/>(runtime)"| ModelStorage["Model Storage<br/>(S3 / PVC)"]

    %% Build Infrastructure
    Konflux["Konflux Pipeline"] -->|"builds image"| VllmGaudi
    HabanaRepo["Intel Habana<br/>Artifact Repos"] -->|"provides packages"| Konflux

