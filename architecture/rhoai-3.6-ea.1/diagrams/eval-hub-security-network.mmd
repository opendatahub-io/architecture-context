graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Dashboard"]
    end

    subgraph APILayer["API LAYER (eval-hub Service)"]
        direction TB
        APIServer["eval-hub API Server<br/>8080/TCP HTTP<br/>TLS optional<br/>X-User + X-Tenant (cluster mode)"]
        MetricsServer["Metrics Server<br/>/metrics endpoint<br/>Dedicated port (cluster)"]
    end

    subgraph EvalRuntime["EVALUATION RUNTIME (K8s Job Pod)"]
        direction TB

        subgraph InitPhase["Init Phase"]
            InitContainer["eval-runtime-init<br/>FIPS: strictfipsruntime"]
        end

        subgraph RuntimePhase["Runtime Phase"]
            Adapter["Evaluation Adapter<br/>(primary container)"]
            Sidecar["eval-runtime-sidecar<br/>Credential injection proxy<br/>FIPS: strictfipsruntime<br/>Per-target TLS config"]
        end
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>Configurable TLS<br/>DB credentials"]
        SQLite["SQLite (dev/test)<br/>Embedded"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount auth"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>AWS credentials"]
        ModelEndpoint["Model Endpoint<br/>Configurable TLS<br/>API key (injected by sidecar)"]
        MLflow["MLflow Tracking Server<br/>HTTP/HTTPS<br/>Configurable TLS + custom CA"]
        OCIRegistry["OCI Registry<br/>HTTP/HTTPS<br/>Evalcard publishing"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTelCollector["OpenTelemetry Collector<br/>OTLP/gRPC<br/>Traces + Metrics + Logs"]
    end

    %% Client to API
    Client -->|"HTTP/8080<br/>TLS optional<br/>X-User + X-Tenant headers"| APIServer

    %% API to K8s
    APIServer -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% API to Database
    APIServer -->|"TCP (pgx)<br/>Configurable TLS<br/>DB credentials"| PostgreSQL
    APIServer -.->|"Embedded<br/>(dev/test only)"| SQLite

    %% API to external services
    APIServer -->|"HTTP/HTTPS<br/>Configurable TLS + custom CA"| MLflow
    APIServer -->|"HTTP/HTTPS"| OCIRegistry

    %% Init container to S3
    InitContainer -->|"HTTPS/443<br/>AWS SDK v2<br/>AWS credentials"| S3

    %% Adapter to Sidecar to Model
    Adapter -->|"HTTP (pod-internal)<br/>No encryption<br/>Placeholder API key"| Sidecar
    Sidecar -->|"HTTP/HTTPS<br/>Configurable TLS<br/>Real API key injected"| ModelEndpoint

    %% Sidecar credential source
    K8sAPI -.->|"Secret mount<br/>credentials"| Sidecar

    %% Observability
    APIServer -.->|"OTLP/gRPC"| OTelCollector
    APIServer --- MetricsServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef api fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef runtime fill:#d1fae5,stroke:#10b981,stroke-width:2px
    classDef datastore fill:#fef3c7,stroke:#f59e0b,stroke-width:2px
    classDef k8s fill:#ede9fe,stroke:#8b5cf6,stroke-width:2px
    classDef extservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef observability fill:#f3e8ff,stroke:#a855f7,stroke-width:2px

    class Client external
    class APIServer,MetricsServer api
    class InitContainer,Adapter,Sidecar runtime
    class PostgreSQL,SQLite datastore
    class K8sAPI k8s
    class S3,ModelEndpoint,MLflow,OCIRegistry extservice
    class OTelCollector observability
