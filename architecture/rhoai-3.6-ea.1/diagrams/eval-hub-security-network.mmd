graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Application["APPLICATION LAYER"]
        direction TB

        subgraph EvalHubService["Eval-Hub API Server<br/>FIPS: strictfipsruntime + CGO<br/>Base: ubi9/ubi-minimal"]
            API["REST API<br/>:8080/TCP HTTP/1.1<br/>Conditional Identity Gate<br/>(X-User + X-Tenant)"]
            Metrics["Metrics Server<br/>:8081/TCP HTTP<br/>No Auth (cluster mode)"]
        end

        subgraph RuntimePods["Evaluation Job Pods"]
            Init["eval_runtime_init<br/>Init Container<br/>FIPS-compliant"]
            Sidecar["eval_runtime_sidecar<br/>Sidecar Proxy<br/>FIPS-compliant"]
        end

        MCP["evalhub_mcp<br/>MCP Server<br/>FIPS-compliant"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]

        subgraph K8sResources["Managed Resources"]
            Jobs["batch/v1 Jobs"]
            CMs["v1 ConfigMaps"]
            Secrets["v1 Secrets"]
            HWProfiles["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1"]
        end

        PostgreSQL["PostgreSQL<br/>pgx driver<br/>Production"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>HTTP/HTTPS<br/>AWS SDK Auth"]
        MLflow["MLflow Tracking Server<br/>HTTPS<br/>TLS 1.2-1.3<br/>Custom CA Support"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC<br/>gRPC Credentials"]
    end

    %% Flows
    Client -->|"HTTP/8080<br/>Conditional Auth<br/>(X-User + X-Tenant)"| API
    API -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI --- Jobs
    K8sAPI --- CMs
    K8sAPI --- Secrets
    K8sAPI --- HWProfiles
    API -->|"SQL<br/>pgx driver"| PostgreSQL
    Init -->|"HTTPS<br/>AWS SDK Auth"| S3
    API -->|"HTTPS<br/>TLS 1.2-1.3<br/>Custom CA"| MLflow
    API -->|"OTLP/gRPC<br/>Configured TLS"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef resource fill:#e8e8e8,stroke:#999,stroke-width:1px

    class Client external
    class API,Metrics,Init,Sidecar,MCP application
    class K8sAPI,PostgreSQL cluster
    class Jobs,CMs,Secrets,HWProfiles resource
    class S3,MLflow,OTel externalservice
