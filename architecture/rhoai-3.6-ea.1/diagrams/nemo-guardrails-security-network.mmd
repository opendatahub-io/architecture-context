graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application<br/><i>No auth enforced by server</i>"]
    end

    subgraph AppLayer["APPLICATION LAYER (No built-in AuthN/AuthZ)"]
        direction TB

        GRServer["NeMo-Guardrails FastAPI Server<br/>Port: 8000/TCP<br/>Base: AIPCC CPU (UBI)<br/>TLS: System OpenSSL<br/>CORS: Disabled by default<br/>FIPS: Inherited from base image"]

        subgraph SafetyServices["Pluggable Safety Services"]
            JailbreakSvc["Jailbreak Detection<br/>Port: 1337/TCP<br/>HTTP / No TLS / No Auth"]
            AlignScoreSvc["AlignScore Fact-Check<br/>Port: 5000/TCP<br/>HTTP / No TLS / No Auth"]
            PresidioLib["Presidio PII Detection<br/>(in-process library)"]
        end

        GRServer -->|HTTP/1337<br/>No encryption<br/>No auth| JailbreakSvc
        GRServer -->|HTTP/5000<br/>No encryption<br/>No auth| AlignScoreSvc
        GRServer -->|in-process| PresidioLib
    end

    subgraph ExternalLLM["UPSTREAM LLM SERVICES"]
        LLMProvider["LLM Inference Service<br/>(MAIN_MODEL_BASE_URL)<br/>HTTPS / TLS<br/>Auth: Forwarded Authorization header"]
        AzureOpenAI["Azure OpenAI<br/>*.openai.azure.com<br/>Port: 443/TCP<br/>HTTPS / TLS<br/>Auth: AZURE_OPENAI_API_KEY"]
    end

    subgraph ExternalGuardrails["EXTERNAL GUARDRAIL PROVIDERS"]
        ActiveFence["ActiveFence<br/>HTTPS / API Key"]
        AIDefense["AI Defense<br/>HTTPS / API Key"]
        PromptSec["Prompt Security<br/>+ 11 other providers<br/>HTTPS / API Keys"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTelCollector["OpenTelemetry Collector<br/>OTLP (gRPC/HTTP)"]
    end

    subgraph OptionalState["OPTIONAL STATE"]
        Redis["Redis<br/>Thread persistence"]
    end

    %% Inbound flow
    Client -->|HTTP/8000<br/>Encryption: Platform-level<br/>Auth: None enforced<br/>Authorization header captured| GRServer

    %% Outbound flows
    GRServer -->|HTTPS<br/>TLS<br/>Forwarded Auth header| LLMProvider
    GRServer -->|HTTPS/443<br/>TLS<br/>AZURE_OPENAI_API_KEY| AzureOpenAI
    GRServer -->|HTTPS<br/>TLS<br/>API Keys (env vars)| ActiveFence
    GRServer -->|HTTPS<br/>TLS<br/>API Keys (env vars)| AIDefense
    GRServer -->|HTTPS<br/>TLS<br/>API Keys (env vars)| PromptSec
    GRServer -.->|OTLP| OTelCollector
    GRServer -.->|optional| Redis

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appLayer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef safety fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externalService fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef guardrailProvider fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef observability fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class GRServer appLayer
    class JailbreakSvc,AlignScoreSvc,PresidioLib safety
    class LLMProvider,AzureOpenAI externalService
    class ActiveFence,AIDefense,PromptSec guardrailProvider
    class OTelCollector observability
    class Redis optional
