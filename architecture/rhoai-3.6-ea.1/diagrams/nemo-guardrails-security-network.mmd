graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Kubernetes Infrastructure)"]
        K8sProxy["Kubernetes Ingress / Proxy<br/>TLS Termination<br/>Authentication Enforcement"]
    end

    subgraph Application["APPLICATION (NeMo-Guardrails Pod)"]
        direction TB

        subgraph Container["Container: AIPCC CPU Base (UBI9 + OpenSSL)"]
            FastAPI["FastAPI Server<br/>Port: 8000/TCP<br/>ASGI: uvicorn<br/>Auth: NONE (infra-delegated)"]
            HeaderFwd["Header Forwarding<br/>X-Authorization → Authorization<br/>Excludes inbound Authorization"]
        end
    end

    subgraph ExternalLLM["EXTERNAL SERVICES (LLM Providers)"]
        AzureOpenAI["Azure OpenAI<br/>*.openai.azure.com<br/>443/TCP HTTPS TLS<br/>Auth: API Key or X-Auth Fwd"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS TLS<br/>Auth: API Key or X-Auth Fwd"]
    end

    subgraph ExternalGuardrails["EXTERNAL SERVICES (Guardrail Providers)"]
        ThirdParty["Third-Party APIs<br/>ActiveFence, AI Defense,<br/>Patronus, Pangea, etc.<br/>HTTPS TLS<br/>Auth: Per-provider API Keys"]
    end

    %% Flows
    Client -->|"HTTPS<br/>TLS (infra-managed)<br/>Auth: K8s/Proxy credentials"| K8sProxy
    K8sProxy -->|"HTTP/8000<br/>Pre-authenticated<br/>Headers preserved"| FastAPI
    FastAPI --> HeaderFwd
    HeaderFwd -->|"HTTPS/443<br/>TLS 1.2+<br/>Auth: AZURE_OPENAI_API_KEY<br/>or X-Authorization fwd"| AzureOpenAI
    HeaderFwd -->|"HTTPS/443<br/>TLS 1.2+<br/>Auth: API Key<br/>or X-Authorization fwd"| OpenAI
    FastAPI -->|"HTTPS<br/>TLS<br/>Auth: Provider API Keys<br/>(env vars)"| ThirdParty

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef guardrailservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class K8sProxy ingress
    class FastAPI,HeaderFwd application
    class AzureOpenAI,OpenAI externalservice
    class ThirdParty guardrailservice
