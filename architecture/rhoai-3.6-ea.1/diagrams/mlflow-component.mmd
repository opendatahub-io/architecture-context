graph TB
    subgraph "MLflow Tracking Server"
        direction TB
        Entrypoint["Container Entrypoint<br/>python3.12 -m mlflow server<br/>--host 0.0.0.0 --port 5000"]
        Gunicorn["Gunicorn / Uvicorn<br/>WSGI/ASGI Server"]
        Flask["Flask Application<br/>mlflow/server/__init__.py"]
        AuthPlugin["kubernetes-auth Plugin<br/>mlflow-kubernetes-plugins 1.5.0"]
        WorkspaceStore["Workspace Store<br/>kubernetes:// backend"]

        subgraph "Route Handlers"
            TrackingAPI["Tracking API<br/>/ajax-api/3.0/*"]
            ModelRegistry["Model Registry API<br/>/{name}/versions/*<br/>/{name}/endpoints/*"]
            ArtifactServing["Artifact Serving<br/>--serve-artifacts"]
            HealthEndpoint["Health & Version<br/>/health, /version"]
        end

        Entrypoint --> Gunicorn
        Gunicorn --> Flask
        Flask --> AuthPlugin
        AuthPlugin --> TrackingAPI
        AuthPlugin --> ModelRegistry
        AuthPlugin --> ArtifactServing
        AuthPlugin --> HealthEndpoint
        Flask --> WorkspaceStore
    end

    subgraph "Disabled Features (RHOAI)"
        AIGateway["AI Gateway<br/>MLFLOW_ENABLE_AI_GATEWAY=false"]
        Assistant["Assistant<br/>MLFLOW_ENABLE_ASSISTANT=false"]
    end

    Client["HTTP Client<br/>(Data Scientist / SDK)"] -->|"HTTP/HTTPS<br/>Port 5000"| Entrypoint

    WorkspaceStore -->|"kubernetes:// protocol"| K8sAPI["Kubernetes API"]
    ArtifactServing -->|"HTTPS"| S3["S3 / GCS / Azure<br/>Artifact Storage"]
    TrackingAPI -->|"SQL"| BackendStore["SQL Backend<br/>(Backend Store URI)"]

    style Entrypoint fill:#4a90e2,stroke:#333
    style Gunicorn fill:#4a90e2,stroke:#333
    style Flask fill:#4a90e2,stroke:#333
