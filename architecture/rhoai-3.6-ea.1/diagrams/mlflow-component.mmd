    style Assistant fill:#bdc3c7,stroke:#999,stroke-dasharray: 5 5
    style Client fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
