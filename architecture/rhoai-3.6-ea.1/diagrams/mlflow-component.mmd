    style WorkspaceStore fill:#9b59b6,stroke:#333,color:#fff
    style TrackingAPI fill:#27ae60,stroke:#333
    style ModelRegistry fill:#27ae60,stroke:#333
    style ArtifactServing fill:#27ae60,stroke:#333
    style HealthEndpoint fill:#27ae60,stroke:#333
