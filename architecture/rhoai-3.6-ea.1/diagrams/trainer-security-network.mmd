graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph TrainerNS["TRAINER OPERATOR (Namespace: opendatahub)"]
        direction TB

        subgraph ControllerPod["kubeflow-trainer-controller-manager"]
            Controller["Trainer Controller<br/>SA: kubeflow-trainer-controller-manager"]
            Webhook["Admission Webhooks<br/>443/TCP TLS<br/>FailurePolicy: Fail"]
            Metrics["Metrics Server<br/>8443/TCP"]
            Status["Status Server<br/>10443/TCP"]
            Health["Health Probes<br/>:8081/healthz, /readyz<br/>HTTP Unauthenticated"]
        end

        WebhookCert["kubeflow-trainer-webhook-cert<br/>TLS Secret<br/>cert-controller rotation"]
    end

    subgraph TrainingNS["TRAINING NAMESPACE (user namespace)"]
        direction TB
        TrainPods["Training Pods<br/>(JobSet-managed)"]
        NetPolicy["NetworkPolicy<br/>Per-TrainJob isolation"]
    end

    subgraph PlatformDeps["INTERNAL PLATFORM DEPENDENCIES"]
        direction TB
        JobSetCtrl["JobSet Controller<br/>jobset.x-k8s.io/v1alpha2"]
        CoSched["CoScheduling<br/>scheduling.x-k8s.io<br/>PodGroup v1alpha1"]
        VolcanoSched["Volcano Scheduler<br/>scheduling.volcano.sh<br/>PodGroup v1beta1"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        HFHub["HuggingFace Hub<br/>HTTPS<br/>API Token (optional)"]
        OpenDAL["OpenDAL Storage<br/>HTTPS<br/>Provider credentials"]
    end

    %% External to API Server
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig / Bearer"| APIServer

    %% API Server to Webhooks
    APIServer -->|"HTTPS/443<br/>TLS (webhook cert)<br/>K8s admission auth"| Webhook

    %% Controller to API Server (outbound)
    Controller -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| APIServer

    %% Controller creates resources via API
    Controller -.->|"creates JobSets"| JobSetCtrl
    Controller -.->|"creates PodGroups"| CoSched
    Controller -.->|"creates PodGroups"| VolcanoSched
    Controller -.->|"creates NetworkPolicies"| NetPolicy

    %% JobSet creates pods
    JobSetCtrl -.->|"creates"| TrainPods

    %% Initializer containers in training pods
    TrainPods -->|"HTTPS/443<br/>TLS<br/>HF API Token"| HFHub
    TrainPods -->|"HTTPS/443<br/>TLS<br/>Provider creds"| OpenDAL

    %% Webhook cert reference
    WebhookCert -.->|"mounted"| Webhook

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef training fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef platform fill:#e8eaf6,stroke:#3949ab,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#fce4ec,stroke:#c62828,stroke-width:1px,stroke-dasharray:5

    class User external
    class APIServer controlplane
    class Controller,Webhook,Metrics,Status,Health operator
    class TrainPods,NetPolicy training
    class JobSetCtrl,CoSched,VolcanoSched platform
    class HFHub,OpenDAL externalservice
    class WebhookCert secret
