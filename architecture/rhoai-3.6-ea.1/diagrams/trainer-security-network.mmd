graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / ML Engineer"]
    end

    subgraph K8sAPI["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC + ServiceAccount tokens"]
    end

    subgraph ControllerNS["TRAINER CONTROLLER NAMESPACE"]
        direction TB

        subgraph Service["Service: kubeflow-trainer-controller-manager (ClusterIP)"]
            direction TB
            WebhookPort["Webhook Server<br/>443→9443/TCP<br/>HTTPS/TLS<br/>Cert: kubeflow-trainer-webhook-cert<br/>Auth: Kubernetes admission<br/>Failure Policy: Fail"]
            MetricsPort["Metrics Server<br/>8080/TCP<br/>TLS (OpenShift profile)"]
        end

        HealthPort["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>No auth (by design)<br/>/healthz, /readyz"]

        ControllerMgr["kubeflow-trainer-controller-manager<br/>SA: kubeflow-trainer-controller-manager<br/>Image: /manager<br/>CGO_ENABLED=1<br/>GOEXPERIMENT=strictfipsruntime<br/>Base: ubi9/ubi-minimal (FIPS OpenSSL)"]
    end

    subgraph OpenShiftAPI["OPENSHIFT API"]
        OSAPIServer["OpenShift APIServer<br/>config.openshift.io/v1/apiservers<br/>HTTPS<br/>SA token auth<br/>Purpose: TLS profile"]
    end

    subgraph SchedulingResources["SCHEDULING RESOURCES (Kubernetes API/TLS)"]
        JobSetRes["JobSet<br/>jobset.x-k8s.io/v1alpha2<br/>Watch + CRUD"]
        CoSchedRes["PodGroup (CoScheduling)<br/>scheduling/v1alpha1<br/>Watch + CRUD"]
        VolcanoRes["PodGroup (Volcano)<br/>scheduling/v1beta1<br/>Watch + CRUD"]
    end

    subgraph UserNS["USER NAMESPACE (Training Workloads)"]
        direction TB
        TrainingPod["Training Pod<br/>Created by JobSet/PodGroup<br/>Init: dataset + model initializers"]
        NetPolicy["NetworkPolicy<br/>per-TrainJob isolation<br/>Owner ref → auto-cleanup"]
    end

    %% External to API
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubectl / Bearer Token"| APIServer

    %% API to Webhook (admission)
    APIServer -->|"HTTPS/9443<br/>TLS (cert-controller)<br/>Kubernetes admission"| WebhookPort

    %% Controller to API
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token (in-cluster)<br/>CRD CRUD, JobSets,<br/>PodGroups, NetworkPolicies"| APIServer

    %% Controller to OpenShift API
    ControllerMgr -->|"HTTPS<br/>SA token<br/>Read TLS profile"| OSAPIServer

    %% Controller to scheduling resources (via API)
    ControllerMgr -->|"Kubernetes API<br/>TLS<br/>Watch + CRUD"| JobSetRes
    ControllerMgr -->|"Kubernetes API<br/>TLS<br/>Watch + CRUD"| CoSchedRes
    ControllerMgr -->|"Kubernetes API<br/>TLS<br/>Watch + CRUD"| VolcanoRes

    %% Controller to Training Pod (progression)
    ControllerMgr -->|"HTTP (plain)<br/>No TLS<br/>No auth<br/>Progression metrics polling"| TrainingPod

    %% Controller creates NetworkPolicy
    ControllerMgr -->|"Kubernetes API<br/>CREATE NetworkPolicy"| NetPolicy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef scheduling fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef risk fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class APIServer apiserver
    class WebhookPort,MetricsPort,HealthPort,ControllerMgr controller
    class OSAPIServer apiserver
    class JobSetRes,CoSchedRes,VolcanoRes scheduling
    class TrainingPod,NetPolicy workload
