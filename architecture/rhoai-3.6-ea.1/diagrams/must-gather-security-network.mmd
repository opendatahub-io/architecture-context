graph TB
    subgraph External["EXTERNAL (User Workstation)"]
        SRE["SRE / Support Engineer<br/>oc adm must-gather"]
    end

    subgraph Cluster["KUBERNETES CLUSTER (Target)"]
        direction TB

        subgraph MustGatherPod["must-gather Pod (Ephemeral)"]
            direction TB
            Gather["gather entrypoint<br/>/usr/bin/gather<br/>Read-only access"]

            subgraph ParallelCollectors["Parallel Collectors (14+ scripts)"]
                direction LR
                C1["DSP"]
                C2["KServe"]
                C3["Model Registry"]
                C4["llm-d"]
                C5["KubeRay"]
                C6["Kueue"]
                C7["Training"]
                C8["TrustyAI"]
                C9["Feast / MLflow"]
                C10["AI Gateway"]
                C11["OGX"]
                C12["Workbenches"]
            end

            Gather --> ParallelCollectors
        end

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS TLS"]
        LocalFS["/must-gather/<br/>Ephemeral Pod Storage<br/>No encryption at rest"]
    end

    %% Flows
    SRE -->|"oc adm must-gather<br/>Injects kubeconfig<br/>credentials"| MustGatherPod
    ParallelCollectors -->|"HTTPS/6443<br/>TLS<br/>kubeconfig credentials<br/>Read-only (get, list)"| K8sAPI
    ParallelCollectors -->|"Write collected<br/>YAML, logs, events"| LocalFS
    LocalFS -->|"Copied back by<br/>oc adm framework"| SRE

    %% Resources accessed via K8s API
    subgraph AccessedResources["Resources Accessed (Read-Only)"]
        direction LR
        PlatformCRDs["Platform CRDs<br/>DSCi, DSC, Components"]
        ComponentCRDs["Component CRDs<br/>InferenceService, LLMInferenceService<br/>AuthConfig, Gateway, HTTPRoute"]
        PodLogs["Pod Logs &<br/>Events"]
        WebhookConfigs["Webhooks &<br/>VAPs"]
        HelmData["Helm Releases<br/>(rhai-gitops)"]
    end

    K8sAPI --> AccessedResources

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef collector fill:#dae8fc,stroke:#6c8ebf
    classDef api fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656
    classDef resources fill:#e1d5e7,stroke:#9673a6

    class SRE external
    class Gather pod
    class C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12 collector
    class K8sAPI api
    class LocalFS storage
    class PlatformCRDs,ComponentCRDs,PodLogs,WebhookConfigs,HelmData resources
