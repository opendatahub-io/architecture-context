    style Note fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style PipelineSA fill:#4a90e2,stroke:#333,color:#fff
    style K8sResources fill:#f5a623,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Secrets fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style Deployments fill:#7ed321,stroke:#333
    style AWSCreds fill:#e57373,stroke:#333,color:#fff
    style S3Key fill:#e57373,stroke:#333,color:#fff
    style HFToken fill:#e57373,stroke:#333,color:#fff
    style LLMKey fill:#e57373,stroke:#333,color:#fff
    style OCIPull fill:#e57373,stroke:#333,color:#fff
    style K8sToken fill:#e57373,stroke:#333,color:#fff
