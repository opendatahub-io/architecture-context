graph TD
    subgraph "pipelines-components RBAC Model"
        direction TB

        Note["NOTE: pipelines-components does NOT define<br/>its own ClusterRoles or RoleBindings.<br/><br/>Component pods inherit RBAC permissions<br/>from the KFP pipeline run ServiceAccount."]
    end

    subgraph "Inherited RBAC (from KFP Pipeline Run)"
        PipelineSA["Pipeline Run<br/>ServiceAccount<br/>(namespace-scoped)"]
    end

    subgraph "Kubernetes API Access Patterns"
        direction TB
        K8sResources["Kubernetes Resources<br/>(accessed by component pods)"]
        Pods["core/v1<br/>Pods"]
        Secrets["core/v1<br/>Secrets"]
        ConfigMaps["core/v1<br/>ConfigMaps"]
        Services["core/v1<br/>Services"]
        Deployments["apps/v1<br/>Deployments"]
    end

    subgraph "Credential Sources (Environment Variables)"
        direction TB
        AWSCreds["AWS_SECRET_ACCESS_KEY<br/>AWS_ACCESS_KEY_ID<br/>→ S3 access"]
        S3Key["S3_SECRET_KEY<br/>→ S3 access (alt)"]
        HFToken["HF_TOKEN<br/>→ HuggingFace Hub"]
        LLMKey["LLM_API_KEY<br/>→ LLM service access"]
        OCIPull["OCI_PULL_SECRET_MODEL_DOWNLOAD<br/>→ OCI registry pull"]
        K8sToken["KUBERNETES_AUTH_TOKEN<br/>→ K8s API (fallback)"]
    end

    PipelineSA -->|"in-cluster auth<br/>(ServiceAccount token)"| K8sResources
    K8sResources --- Pods
    K8sResources --- Secrets
    K8sResources --- ConfigMaps
    K8sResources --- Services
    K8sResources --- Deployments

    PipelineSA -.->|"env vars injected<br/>by pipeline definition"| AWSCreds
    PipelineSA -.->|"env vars injected<br/>by pipeline definition"| S3Key
    PipelineSA -.->|"env vars injected<br/>by pipeline definition"| HFToken
    PipelineSA -.->|"env vars injected<br/>by pipeline definition"| LLMKey
    PipelineSA -.->|"env vars injected<br/>by pipeline definition"| OCIPull
    PipelineSA -.->|"env vars injected<br/>by pipeline definition"| K8sToken

