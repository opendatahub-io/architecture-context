graph TD
    subgraph "llm-d RBAC Overview"
        direction TB

        Note["No RBAC resources (ClusterRoles,<br/>RoleBindings, ServiceAccounts) are<br/>defined in llm-d manifests.<br/><br/>RBAC is expected to be provided by:"]

        subgraph "Delegated RBAC Providers"
            RouterRBAC["llm-d-router<br/>(Helm chart manages<br/>its own RBAC)"]
            GatewayRBAC["Gateway Provider<br/>(Istio / kgateway /<br/>AgentGateway)"]
            K8sRBAC["Kubernetes Platform<br/>(namespace-level RBAC)"]
        end

        Note --> RouterRBAC
        Note --> GatewayRBAC
        Note --> K8sRBAC
    end

    subgraph "Authentication Model"
        direction TB

        AuthNote["Authentication is NOT configured<br/>at the model server level"]

        subgraph "Auth Delegation Chain"
            ClientAuth["Client Authentication<br/>Handled by Gateway"]
            ServiceAuth["Service-to-Service Auth<br/>Handled by Service Mesh"]
            ModelServerAuth["Model Server (vLLM)<br/>Port 8000/TCP<br/>Auth: None"]
        end

        AuthNote --> ClientAuth
        ClientAuth --> ServiceAuth
        ServiceAuth --> ModelServerAuth
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style AuthNote fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style RouterRBAC fill:#7ed321,stroke:#333
    style GatewayRBAC fill:#7ed321,stroke:#333
    style K8sRBAC fill:#7ed321,stroke:#333
    style ClientAuth fill:#ffe6cc,stroke:#d79b00
    style ServiceAuth fill:#ffe6cc,stroke:#d79b00
    style ModelServerAuth fill:#f8cecc,stroke:#b85450
