graph TD
    subgraph "Note"
        Notice["⚠ No ClusterRoles or RoleBindings<br/>defined in llm-d repository.<br/>RBAC is provided by the deploying<br/>platform or operator."]
    end

    subgraph "Authentication & Authorization"
        subgraph "Model Server HTTP API"
            Port8000["Port 8000/TCP<br/>HTTP"]
            Auth8000["⚠ No Auth<br/>No built-in authentication"]
            Enforcement8000["Enforcement: None<br/>Relies on platform network policy<br/>or service mesh"]
            Port8000 --> Auth8000
            Auth8000 --> Enforcement8000
        end

        subgraph "ModelExpress gRPC API"
            Port8001["Port 8001/TCP<br/>gRPC"]
            Auth8001["Istio mTLS STRICT"]
            Enforcement8001["PeerAuthentication +<br/>AuthorizationPolicy"]
            Policy8001["Restricted to decode<br/>ServiceAccount principals only"]
            Port8001 --> Auth8001
            Auth8001 --> Enforcement8001
            Enforcement8001 --> Policy8001
        end

        subgraph "P2P RDMA Ports"
            Port5555["Port 5555/TCP<br/>gRPC (metadata)"]
            Port6555["Port 6555/TCP<br/>gRPC (tensor)"]
            AuthRDMA["⚠ No Auth, No Encryption<br/>RDMA bypass - outside service mesh"]
            Port5555 --> AuthRDMA
            Port6555 --> AuthRDMA
        end
    end

    subgraph "Service Mesh Policy"
        PA["PeerAuthentication<br/>Mode: STRICT<br/>Scope: ModelExpress namespace"]
        AP["AuthorizationPolicy<br/>Source: decode ServiceAccount<br/>Action: ALLOW"]
        PA --> Port8001
        AP --> Port8001
    end

    %% Styling
    style Notice fill:#fff3cd,stroke:#856404,color:#856404
    style Auth8000 fill:#f8d7da,stroke:#721c24,color:#721c24
    style Enforcement8000 fill:#f8d7da,stroke:#721c24,color:#721c24
    style Auth8001 fill:#d4edda,stroke:#155724,color:#155724
    style Enforcement8001 fill:#d4edda,stroke:#155724,color:#155724
    style Policy8001 fill:#d4edda,stroke:#155724,color:#155724
    style AuthRDMA fill:#f8d7da,stroke:#721c24,color:#721c24
    style PA fill:#cce5ff,stroke:#004085,color:#004085
    style AP fill:#cce5ff,stroke:#004085,color:#004085
