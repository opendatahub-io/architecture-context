graph TB
    subgraph InitZone["INIT CONTAINER (No Network)"]
        direction TB
        InitContainer["Init Container<br/>init_managed_pipelines<br/>UBI9/python-312<br/>NO PORTS — filesystem copy only"]
        SharedVol["Shared Volume<br/>/config/managed-pipelines"]
        InitContainer -->|"Local filesystem<br/>copy (no network)"| SharedVol
    end

    subgraph KFPZone["KFP ORCHESTRATION"]
        KFPServer["KFP API Server<br/>Mounts shared volume"]
        SharedVol -.->|"Volume mount"| KFPServer
    end

    subgraph ComponentZone["COMPONENT PODS (Ephemeral, Outbound-Only)"]
        direction TB

        subgraph DataProc["Data Processing Pods"]
            ParseChunk["parse_and_chunk<br/>SA: pipeline-run-sa"]
            TabularLoader["tabular_data_loader<br/>SA: pipeline-run-sa"]
            SDGComp["sdg<br/>SA: pipeline-run-sa"]
            DatasetDL["dataset_download<br/>SA: pipeline-run-sa"]
        end

        subgraph TrainPods["Training Pods"]
            AutoML["AutoML (AutoGluon)<br/>SA: pipeline-run-sa"]
            AutoRAG["AutoRAG<br/>SA: pipeline-run-sa"]
        end

        subgraph EvalPods["Evaluation Pods"]
            LMEval["lm-eval<br/>SA: pipeline-run-sa"]
        end

        subgraph DeployPods["Deployment Pods"]
            ModelDeploy["model_deployment<br/>SA: pipeline-run-sa"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>HTTPS/443<br/>TLS (boto3 verify=True)<br/>Auth: AWS credentials"]
        K8sAPI["Kubernetes API Server<br/>HTTPS/443<br/>TLS (in-cluster CA)<br/>Auth: ServiceAccount token"]
        RayCluster["Ray Cluster<br/>(via CodeFlare SDK)<br/>Cluster-internal<br/>Auth: CodeFlare credentials"]
        HFHub["HuggingFace Hub<br/>HTTPS/443<br/>TLS<br/>Auth: HF_TOKEN (optional)"]
    end

    %% KFP orchestrates component pods
    KFPServer -->|"Schedules pods"| ComponentZone

    %% Outbound flows from components
    ParseChunk -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    TabularLoader -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    SDGComp -->|"HTTPS/443<br/>TLS<br/>AWS creds"| S3
    DatasetDL -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub

    ParseChunk -->|"CodeFlare SDK<br/>Distributed job"| RayCluster
    AutoML -->|"CodeFlare SDK<br/>Distributed job"| RayCluster
    LMEval -->|"CodeFlare SDK<br/>Distributed job"| RayCluster

    ModelDeploy -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    TabularLoader -->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI

    %% Styling
    classDef initzone fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef kfpzone fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef compzone fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef external fill:#fff9c4,stroke:#f9a825,stroke-width:2px
    classDef nonetwork fill:#e3f2fd,stroke:#1565c0,stroke-width:3px,stroke-dasharray: 5 5

    class InitContainer,SharedVol initzone
    class KFPServer kfpzone
    class ParseChunk,TabularLoader,SDGComp,DatasetDL,AutoML,AutoRAG,LMEval,ModelDeploy compzone
    class S3,K8sAPI,RayCluster,HFHub external
