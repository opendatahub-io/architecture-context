graph TB
    subgraph Orchestration["ORCHESTRATION (Cluster Internal)"]
        Operator["TrustyAI Service Operator<br/>Creates Kubernetes Jobs<br/>Auth: Kubernetes RBAC"]
    end

    subgraph JobPod["KUBERNETES JOB POD (Batch, Non-Root UID 65532)"]
        direction TB

        subgraph Container["lm-eval Container"]
            Python["Python 3.11 Runtime<br/>Image: odh-ta-lmes-job-rhel9<br/>User: 65532 (non-root)"]
            LMEval["lm_eval Framework<br/>Plugin-based model backends"]
        end
    end

    subgraph ExternalLLM["EXTERNAL SERVICES (LLM Providers)"]
        OpenAIAPI["OpenAI API<br/>api.openai.com<br/>TLS 1.2+"]
        AnthropicAPI["Anthropic API<br/>api.anthropic.com<br/>TLS 1.2+"]
        WatsonXAPI["IBM watsonx API<br/>TLS 1.2+"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Model Serving)"]
        ServingRuntime["Model Serving Runtime<br/>(vLLM / Caikit)<br/>OpenAI-compatible endpoint"]
    end

    subgraph ExternalData["EXTERNAL SERVICES (Data Sources)"]
        HuggingFace["Hugging Face Hub<br/>datasets-server.huggingface.co<br/>TLS 1.2+"]
        S3["S3-Compatible Storage<br/>TLS 1.2+"]
    end

    %% Flows
    Operator -->|"Kubernetes API<br/>Job creation<br/>RBAC auth"| Python

    Python -->|"HTTPS/443<br/>TLS<br/>Auth: OPENAI_API_KEY"| OpenAIAPI
    Python -->|"HTTPS/443<br/>TLS<br/>Auth: ANTHROPIC_API_KEY"| AnthropicAPI
    Python -->|"HTTPS/443<br/>TLS<br/>Auth: WATSONX_API_KEY"| WatsonXAPI
    Python -->|"HTTP(S)/configured<br/>TLS optional<br/>Auth: API key"| ServingRuntime

    Python -->|"HTTPS/443<br/>TLS<br/>Auth: HF_TOKEN"| HuggingFace
    Python -->|"HTTPS/443<br/>TLS<br/>Auth: AWS creds"| S3

    %% Styling
    classDef orchestration fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef jobpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalllm fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef clusterinternal fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef externaldata fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Operator orchestration
    class Python,LMEval jobpod
    class OpenAIAPI,AnthropicAPI,WatsonXAPI externalllm
    class ServingRuntime clusterinternal
    class HuggingFace,S3 externaldata
