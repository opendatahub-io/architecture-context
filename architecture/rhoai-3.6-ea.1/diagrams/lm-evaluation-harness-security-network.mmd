graph TB
    subgraph BatchJob["BATCH JOB POD (No Inbound Endpoints)"]
        direction TB
        Container["lm-evaluation-harness<br/>Image: odh-ta-lmes-job-rhel9<br/>UID: 65532 (non-root)<br/>Base: UBI (CUDA/CPU)<br/>No exposed ports"]
    end

    subgraph InternalPlatform["INTERNAL PLATFORM (Trusted)"]
        direction TB
        ModelEndpoint["Model Serving Endpoint<br/>(OpenAI-compatible)<br/>vLLM / KServe"]
        EvalHub["EvalHub Service<br/>(Job Orchestrator)"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>443/TCP<br/>TLS"]
        HFDatasets["datasets-server.huggingface.co<br/>443/TCP<br/>TLS"]
        S3["S3-Compatible Storage<br/>443/TCP<br/>TLS"]
    end

    %% Inbound (from platform)
    EvalHub -->|"EvalHub SDK<br/>JobSpec dispatch"| Container

    %% Outbound (to platform)
    Container -->|"HTTP/HTTPS<br/>POST /v1/completions<br/>Auth: API Key<br/>(resolve_model_credentials)"| ModelEndpoint
    Container -->|"EvalHub SDK callbacks<br/>EvaluationResult<br/>(sanitized errors)"| EvalHub

    %% Outbound (to external)
    Container -->|"HTTPS/443<br/>TLS<br/>Auth: HF_TOKEN<br/>datasets & tokenizers"| HFHub
    Container -->|"HTTPS/443<br/>TLS<br/>dataset metadata"| HFDatasets
    Container -->|"HTTPS<br/>TLS<br/>Auth: AWS IAM<br/>data retrieval (boto3)"| S3

    %% Styling
    classDef batchjob fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Container batchjob
    class ModelEndpoint,EvalHub internal
    class HFHub,HFDatasets,S3 external
