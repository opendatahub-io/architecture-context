graph TD
    subgraph GatewayAuth["vllm-orchestrator-gateway Authentication Model"]
        direction TB

        Note["No RBAC Defined<br/>This component does not define<br/>ClusterRoles, Roles, or RoleBindings"]

        subgraph AuthFlow["Authentication Flow"]
            direction LR
            ClientReq["Client Request<br/>Authorization: Bearer ..."]
            Gateway["Gateway<br/>(No local enforcement)"]
            BackendReq["Backend Request<br/>Authorization: forwarded"]

            ClientReq -->|"passthrough"| Gateway
            Gateway -->|"forward header"| BackendReq
        end

        subgraph Headers["Forwarded Headers"]
            Auth["Authorization"]
            XFwd["x-forwarded-*"]
        end
    end

    subgraph SecurityNote["Security Notes"]
        S1["No ClusterRoles defined"]
        S2["No RoleBindings defined"]
        S3["No ServiceAccount specified"]
        S4["Auth enforcement delegated<br/>to vLLM Orchestrator backend"]
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style ClientReq fill:#f9f9f9,stroke:#999
    style Gateway fill:#4a90e2,color:#fff
    style BackendReq fill:#7ed321,color:#fff
    style Auth fill:#e8e8e8,stroke:#999
    style XFwd fill:#e8e8e8,stroke:#999
    style S1 fill:#f8d7da,stroke:#f5c6cb
    style S2 fill:#f8d7da,stroke:#f5c6cb
    style S3 fill:#f8d7da,stroke:#f5c6cb
    style S4 fill:#fff3cd,stroke:#ffc107
