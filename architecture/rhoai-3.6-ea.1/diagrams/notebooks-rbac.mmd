graph TD
    subgraph "Notebooks Component - RBAC & Authentication Model"
        direction TB

        subgraph "Authentication (Platform-Delegated)"
            AuthNote["No built-in authentication<br/>in notebook containers"]
            OAuthProxy["oauth-proxy sidecar<br/>(injected by odh-notebook-controller)"]
            OpenShiftOAuth["OpenShift OAuth Provider"]

            OpenShiftOAuth -->|"validates"| OAuthProxy
            OAuthProxy -->|"gates access to"| NotebookContainer["JupyterLab / Code Server<br/>Port 8888"]
            AuthNote -.->|"design decision"| NotebookContainer
        end

        subgraph "RBAC (No Component-Defined Roles)"
            NoRBAC["No ClusterRoles or RoleBindings<br/>defined by notebooks component"]
            ExternalRBAC["RBAC managed externally by:<br/>- odh-notebook-controller<br/>- RHOAI operator"]

            NoRBAC -.->|"delegated to"| ExternalRBAC
        end

        subgraph "Secrets (Environment Variables)"
            GITHUB["GITHUB_TOKEN<br/>env var<br/>runtime provisioned"]
            GEMINI["GEMINI_API_KEY<br/>env var<br/>runtime provisioned"]
            RENOVATE["RENOVATE_TOKEN<br/>env var<br/>runtime provisioned"]
            JIRA_API["JIRA_API_TOKEN<br/>env var<br/>runtime provisioned"]
            JIRA["JIRA_TOKEN<br/>env var<br/>runtime provisioned"]
            JIRA_OAUTH["JIRA_OAUTH_CLIENT_SECRET<br/>env var<br/>runtime provisioned"]
        end

        subgraph "Security Libraries (Bundled)"
            Cryptography["cryptography==46.0.7<br/>Uses system OpenSSL<br/>FIPS-capable"]
            PyJWT["pyjwt==2.13.0<br/>JWT handling"]
            PyCryptodome["pycryptodome==3.23.0<br/>Self-contained crypto<br/>NOT FIPS-validated"]
        end
    end

    style AuthNote fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style OAuthProxy fill:#4a90e2,color:#fff
    style OpenShiftOAuth fill:#999,color:#fff
    style NotebookContainer fill:#4a90e2,color:#fff
    style NoRBAC fill:#fff2cc,stroke:#d6b656
    style ExternalRBAC fill:#d5e8d4,stroke:#82b366
    style GITHUB fill:#f5a623,color:#fff
    style GEMINI fill:#f5a623,color:#fff
    style RENOVATE fill:#f5a623,color:#fff
    style JIRA_API fill:#f5a623,color:#fff
    style JIRA fill:#f5a623,color:#fff
    style JIRA_OAUTH fill:#f5a623,color:#fff
    style Cryptography fill:#d5e8d4,stroke:#82b366
    style PyJWT fill:#d5e8d4,stroke:#82b366
    style PyCryptodome fill:#ffe6cc,stroke:#d79b00
