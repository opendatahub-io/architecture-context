graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client /<br/>Data Scientist"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Gateway["Istio Gateway / Gateway API<br/>443/TCP<br/>TLS 1.3 Termination<br/>VirtualService / HTTPRoute"]
    end

    subgraph ServiceMesh["SERVICE MESH (mTLS)"]
        direction TB

        subgraph NS_Knative["Namespace: knative-serving"]
            Activator["Knative Activator<br/>(serverless mode)"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            AutoGluon["AutoGluon Server Pod<br/>python -m autogluonserver<br/>FastAPI/uvicorn V2 Protocol<br/>HTTP:8080 gRPC:8081<br/>Auth: NONE (platform-delegated)"]
        end

        subgraph NS_KServe["Namespace: kserve"]
            direction TB
            ControllerPod["KServe Controller Manager<br/>SA: kserve-controller-manager"]
            RBACProxy["kube-rbac-proxy Sidecar<br/>8443→8080<br/>TLS termination<br/>TokenReview + SAR"]
            WebhookSvc["Webhook Server<br/>443/TCP TLS<br/>cert: kserve-webhook-server-cert<br/>FailurePolicy: Fail"]
            LLMCtrl["LLMInferenceService Controller<br/>SA: llmisvc-serviceAccountName"]
            LocalModelCtrl["LocalModel Controller<br/>SA: kserve-localmodel-controller-manager"]
            LocalModelNode["LocalModelNode Agent<br/>SA: kserve-localmodelnode-agent"]
        end
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount RBAC"]
        Prometheus["Prometheus<br/>Scrapes :8443/TCP"]
        Istio["Istio Control Plane<br/>mTLS enforcement"]
        KnativeSrv["Knative Serving<br/>Autoscaling"]
        GatewayAPICtrl["Gateway API Controller<br/>HTTPRoute routing"]
        KEDA["KEDA<br/>ScaledObject autoscaling"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Azure AD"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>GCP SA"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.3<br/>Bearer Token (optional)"| Gateway

    %% Ingress to Service Mesh
    Gateway -->|"HTTP/8080<br/>mTLS STRICT<br/>Service Identity"| Activator
    Activator -->|"HTTP/8080<br/>mTLS sidecar<br/>Service Identity"| AutoGluon

    %% Model loading
    AutoGluon -->|"HTTPS/443<br/>TLS 1.2+<br/>IAM credentials"| S3
    AutoGluon -->|"HTTPS/443<br/>TLS 1.2+<br/>AZ_CLIENT_SECRET"| Azure
    AutoGluon -->|"HTTPS/443<br/>TLS 1.2+<br/>GCP SA key"| GCS

    %% Controller to K8s API
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LLMCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LocalModelCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LocalModelNode -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Webhooks
    K8sAPI -->|"HTTPS/443<br/>TLS<br/>Admission"| WebhookSvc

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview"| RBACProxy
    RBACProxy -->|"HTTP/8080<br/>localhost"| ControllerPod

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef clusterservice fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef securitycritical fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Gateway ingress
    class Activator,AutoGluon,ControllerPod,LLMCtrl,LocalModelCtrl,LocalModelNode servicemesh
    class RBACProxy,WebhookSvc securitycritical
    class K8sAPI,Prometheus,Istio,KnativeSrv,GatewayAPICtrl,KEDA clusterservice
    class S3,Azure,GCS externalservice
