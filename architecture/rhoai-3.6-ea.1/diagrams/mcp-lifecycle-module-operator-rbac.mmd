graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Module["mcp-lifecycle-module-operator-<br/>controller-manager<br/>NS: SYSTEM_NAMESPACE"]
        SA_Operand["mcp-lifecycle-operator-<br/>controller-manager<br/>NS: mcp-lifecycle-operator-system"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Module["mcp-lifecycle-module-operator-<br/>manager-rolebinding"]
        CRB_Operand["mcp-lifecycle-operator-<br/>manager-rolebinding"]
        CRB_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_LeaderElection["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>NS: mcp-lifecycle-operator-system"]
    end

    subgraph ModuleOperatorRBAC["Module Operator ClusterRole"]
        CR_Module["mcp-lifecycle-module-operator-<br/>manager-role"]
    end

    subgraph OperandRBAC["Operand ClusterRoles"]
        CR_Operand["mcp-lifecycle-operator-<br/>manager-role"]
        CR_MetricsAuth["mcp-lifecycle-operator-<br/>metrics-auth-role"]
    end

    subgraph OperandRoles["Operand Roles (Namespaced)"]
        R_LeaderElection["mcp-lifecycle-operator-<br/>leader-election-role"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles (User-Facing)"]
        CR_Admin["mcpserver-admin-role<br/>aggregate-to-admin"]
        CR_Editor["mcpserver-editor-role<br/>aggregate-to-edit"]
        CR_Viewer["mcpserver-viewer-role<br/>aggregate-to-view"]
    end

    subgraph ModuleResources["Module Operator Resources"]
        MCPLifecycleOpCR["components.platform.opendatahub.io<br/>MCPLifecycleOperator<br/>CRUD + finalizers + status"]
        MCPServerCR_Module["mcp.x-k8s.io<br/>MCPServer<br/>full CRUD + deletecollection"]
        CoreRes_Module["core<br/>ConfigMaps, Namespaces,<br/>ServiceAccounts, Services<br/>CRUD"]
        AppsRes_Module["apps<br/>Deployments<br/>CRUD"]
        RBACRes_Module["rbac.authorization.k8s.io<br/>ClusterRoles, ClusterRoleBindings,<br/>Roles, RoleBindings<br/>CRUD"]
        MonitorRes_Module["monitoring.coreos.com<br/>ServiceMonitors<br/>CRUD"]
        NetRes_Module["networking.k8s.io<br/>NetworkPolicies<br/>CRUD"]
        CRDRes_Module["apiextensions.k8s.io<br/>CustomResourceDefinitions<br/>CRUD"]
        AuthRes_Module["authentication/authorization<br/>TokenReviews, SubjectAccessReviews<br/>create"]
        ReadOnly_Module["Read-Only<br/>Pods: get,list<br/>Secrets: get,list,watch<br/>APIServers: get,list,watch"]
    end

    subgraph OperandResources["Operand Resources"]
        MCPServerCR_Operand["mcp.x-k8s.io<br/>MCPServer<br/>get,list,patch,update,watch<br/>+ finalizers + status"]
        AppsRes_Operand["apps<br/>Deployments<br/>create,get,list,update,watch"]
        SvcRes_Operand["core<br/>Services<br/>create,get,list,update,watch"]
        NetRes_Operand["networking.k8s.io<br/>NetworkPolicies<br/>create,get,list,update,watch"]
        ReadOnly_Operand["Read-Only<br/>ConfigMaps, Secrets: get,list,watch<br/>Pods: get,list"]
    end

    subgraph UserResources["User-Facing Resources"]
        MCPServerUser["mcp.x-k8s.io<br/>MCPServer"]
    end

    %% Module Operator bindings
    SA_Module -->|"bound via"| CRB_Module
    CRB_Module -->|"grants"| CR_Module
    CR_Module -->|"CRUD"| MCPLifecycleOpCR
    CR_Module -->|"full CRUD"| MCPServerCR_Module
    CR_Module -->|"CRUD"| CoreRes_Module
    CR_Module -->|"CRUD"| AppsRes_Module
    CR_Module -->|"CRUD"| RBACRes_Module
    CR_Module -->|"CRUD"| MonitorRes_Module
    CR_Module -->|"CRUD"| NetRes_Module
    CR_Module -->|"CRUD"| CRDRes_Module
    CR_Module -->|"create"| AuthRes_Module
    CR_Module -->|"read"| ReadOnly_Module

    %% Operand bindings
    SA_Operand -->|"bound via"| CRB_Operand
    CRB_Operand -->|"grants"| CR_Operand
    CR_Operand -->|"manage"| MCPServerCR_Operand
    CR_Operand -->|"manage"| AppsRes_Operand
    CR_Operand -->|"manage"| SvcRes_Operand
    CR_Operand -->|"manage"| NetRes_Operand
    CR_Operand -->|"read"| ReadOnly_Operand

    %% Metrics auth
    SA_Operand -->|"bound via"| CRB_Metrics
    CRB_Metrics -->|"grants"| CR_MetricsAuth
    CR_MetricsAuth -->|"create TokenReviews,<br/>SubjectAccessReviews"| AuthRes_Module

    %% Leader election
    SA_Operand -->|"bound via"| RB_LeaderElection
    RB_LeaderElection -->|"grants"| R_LeaderElection

    %% Aggregated roles
    CR_Admin -->|"full CRUD +<br/>deletecollection"| MCPServerUser
    CR_Editor -->|"CRUD"| MCPServerUser
    CR_Viewer -->|"get, list, watch"| MCPServerUser

    %% Styling
    style SA_Module fill:#4a90e2,stroke:#333,color:#fff
    style SA_Operand fill:#4a90e2,stroke:#333,color:#fff
    style CR_Module fill:#f5a623,stroke:#333,color:#000
    style CR_Operand fill:#f5a623,stroke:#333,color:#000
    style CR_MetricsAuth fill:#f5a623,stroke:#333,color:#000
    style R_LeaderElection fill:#f5a623,stroke:#333,color:#000
    style CR_Admin fill:#7ed321,stroke:#333,color:#000
    style CR_Editor fill:#7ed321,stroke:#333,color:#000
    style CR_Viewer fill:#7ed321,stroke:#333,color:#000
    style CRB_Module fill:#d5e8d4,stroke:#333
    style CRB_Operand fill:#d5e8d4,stroke:#333
    style CRB_Metrics fill:#d5e8d4,stroke:#333
    style RB_LeaderElection fill:#d5e8d4,stroke:#333
