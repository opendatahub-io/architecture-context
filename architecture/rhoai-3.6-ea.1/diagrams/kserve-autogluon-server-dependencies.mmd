graph LR
    KServe["KServe AutoGluon<br/>Server"]

    %% Core Kubernetes Dependencies
    KServe -->|"API calls<br/>6443/TCP"| K8sAPI["Kubernetes API<br/>Server"]
    KServe -->|"operator framework"| ControllerRuntime["controller-runtime<br/>0.22.5"]

    %% Networking / Ingress Dependencies
    KServe -->|"traffic routing<br/>VirtualServices"| Istio["Istio<br/>(istio.io/client-go 1.27.1)"]
    KServe -->|"serverless<br/>autoscaling"| Knative["Knative Serving<br/>0.48.1"]
    KServe -->|"HTTPRoute routing<br/>(conditional)"| GatewayAPI["Gateway API<br/>1.4.2"]
    KServe -->|"event-driven<br/>autoscaling"| KEDA["KEDA<br/>2.18.0"]

    %% LLM-specific Dependencies
    KServe -->|"multi-node inference"| LWS["LeaderWorkerSet<br/>(lws 0.8.0)"]
    KServe -->|"variant autoscaling"| LLMD["llm-d variant<br/>autoscaler 0.7.0"]
    KServe -->|"inference routing"| GatewayInference["Gateway API<br/>Inference Extension<br/>1.3.1"]

    %% Cloud Storage Dependencies
    KServe -->|"model storage<br/>HTTPS/443"| S3["AWS S3<br/>(aws-sdk-go 1.55.6)"]
    KServe -->|"model storage<br/>HTTPS/443"| Azure["Azure Blob Storage<br/>(azblob 1.6.2)"]
    KServe -->|"model storage<br/>HTTPS/443"| GCS["Google Cloud Storage<br/>(cloud.google.com/go 1.52.0)"]

    %% Python ML Dependencies
    KServe -->|"ML framework"| AutoGluon["AutoGluon<br/>1.5.0+rhaiv.3"]
    KServe -->|"HTTP serving"| FastAPI["FastAPI<br/>(uvicorn)"]
    KServe -->|"gRPC serving"| gRPC["gRPC<br/>(grpcio 1.73.0)"]
    KServe -->|"V2 protocol"| Protobuf["protobuf<br/>6.33.5"]

    %% Observability Dependencies
    KServe -->|"metrics"| Prometheus["Prometheus<br/>(prometheus-client)"]
    KServe -->|"tracing"| OTel["OpenTelemetry<br/>(otel-operator 0.113.0)"]
    KServe -->|"logging"| Zap["Zap Logger<br/>1.27.1"]

    %% Security Dependencies
    KServe -->|"TLS termination<br/>auth proxy"| KubeRBACProxy["kube-rbac-proxy<br/>0.18.0"]
    KServe -.->|"JWT capability<br/>(not enforced)"| PyJWT["pyjwt<br/>(>=2.12.0)"]

    %% Internal ODH/RHOAI Integration
    Dashboard["ODH Dashboard"] -.->|"UI management"| KServe
    Pipelines["Data Science<br/>Pipelines"] -.->|"model deployment"| KServe

