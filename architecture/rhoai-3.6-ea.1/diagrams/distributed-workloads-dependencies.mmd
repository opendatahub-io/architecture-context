    %% ML Framework Dependencies (in images)
    DW -->|"includes"| PyTorch["PyTorch 2.10.0"]
    DW -->|"includes"| DeepSpeed["DeepSpeed 0.18.7"]
    DW -->|"includes"| Transformers["Transformers 4.57.6"]
    DW -->|"includes"| Accelerate["Accelerate 1.12.0"]
    DW -->|"includes"| vLLM["vLLM 0.21.0+rhaiv.8"]

    %% Runtime Infrastructure
    DW -->|"includes"| OpenMPI["OpenMPI 4.1<br/>(runtime images)"]
    DW -->|"includes"| CUDA_Libs["NVIDIA CUDA Libs<br/>cublas, cudnn, nccl"]

    %% Build System
    Konflux["Konflux"] -->|"hermetic build"| DW

    %% External Services
    DW -.->|"6443/HTTPS<br/>test only"| K8sAPI["Kubernetes API"]

    %% Observability
    DW -->|"includes"| Prometheus["prometheus-client<br/>0.25.0"]
    DW -->|"includes"| OTel["OpenTelemetry SDK<br/>1.40.0"]

