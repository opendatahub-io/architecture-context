graph LR
    MLMD["ml-metadata Server<br/>(metadata_store_server)"]

    %% Internal Platform Dependencies
    MLMD -->|"MySQL wire protocol<br/>3306/TCP<br/>SSL configurable"| MariaDB["MariaDB/MySQL<br/>(Backend Store)"]

    %% Client Integrations
    DSP["Data Science Pipelines"] -->|"gRPC/8080<br/>Metadata recording &<br/>lineage queries"| MLMD
    PythonLib["Python Client Library<br/>(ml_metadata package)"] -->|"gRPC/8080<br/>Programmatic API access"| MLMD

    %% Build Dependencies
    subgraph "Build-time Dependencies"
        Bazel["Bazel 5<br/>(Build system)"]
        Protobuf["Protobuf<br/>(Service definitions)"]
        OpenSSL["openssl-devel<br/>(TLS support)"]
        MariaDBConnector["libmysqlclient<br/>(MariaDB connector)"]
    end

    Bazel -.->|"builds"| MLMD
    Protobuf -.->|"generates gRPC stubs"| MLMD
    OpenSSL -.->|"optional TLS"| MLMD
    MariaDBConnector -.->|"bundled in image"| MLMD

    %% Runtime Base
    UBI9["UBI9-minimal<br/>(Base image)"] -.->|"runtime base<br/>system OpenSSL"| MLMD

