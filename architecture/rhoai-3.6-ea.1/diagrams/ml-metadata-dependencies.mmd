graph LR
    MLMD["ML Metadata<br/>(MLMD gRPC Server)"]

    %% Internal Platform Dependencies
    MLMD -->|"MySQL protocol :3306<br/>SSL optional<br/>persistent storage"| MySQL["MySQL / MariaDB"]

    %% Deployment Dependency
    DSPOperator["Data Science Pipelines<br/>Operator"] -->|"deploys & manages<br/>provisions credentials"| MLMD

    %% Consumers (Integration Points)
    DSPipelines["Data Science Pipelines<br/>(Argo / Tekton)"] -->|"gRPC :8080<br/>metadata ingestion"| MLMD
    PipelineUI["Pipeline UI /<br/>Dashboard"] -.->|"gRPC :8080<br/>metadata queries"| MLMD

    %% Build Dependencies
    subgraph "Build-time Dependencies"
        Bazel["Bazel Build System"]
        gRPCLib["gRPC C++ Library"]
        OpenSSL["OpenSSL<br/>(system, FIPS on RHEL 9)"]
        MariaDBConn["mariadb-connector-c"]
        UBI9["UBI9/ubi-minimal<br/>(base image)"]
    end

    MLMD -.->|"compiled with"| Bazel
    MLMD -.->|"links"| gRPCLib
    MLMD -.->|"crypto"| OpenSSL
    MLMD -.->|"DB driver"| MariaDBConn
    MLMD -.->|"runtime base"| UBI9

    %% Python Client
    PythonPkg["ml_metadata<br/>Python Package"] -->|"gRPC client"| MLMD

    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MySQL fill:#f5a623,stroke:#333,color:#fff
    style DSPOperator fill:#7ed321,stroke:#333,color:#fff
    style DSPipelines fill:#7ed321,stroke:#333,color:#fff
    style PipelineUI fill:#7ed321,stroke:#333,color:#fff
    style PythonPkg fill:#7ed321,stroke:#333,color:#fff
    style Bazel fill:#e8e8e8,stroke:#999
    style gRPCLib fill:#e8e8e8,stroke:#999
    style OpenSSL fill:#e8e8e8,stroke:#999
    style MariaDBConn fill:#e8e8e8,stroke:#999
    style UBI9 fill:#e8e8e8,stroke:#999
