graph TB
    subgraph ModelRegistry["Model Registry"]
        direction TB

        subgraph HubProxy["Hub Proxy (model-registry binary)"]
            ProxyAPI["HTTP REST API<br/>Model Metadata CRUD"]
            GORM["GORM ORM Layer"]
            Migrate["golang-migrate<br/>Schema Migrations"]
            TLSConfig["TLS Config<br/>Min TLS 1.2<br/>FIPS: strictfipsruntime"]
            ProxyAPI --> GORM
            GORM --> Migrate
            ProxyAPI --> TLSConfig
        end

        subgraph Controller["Controller Operator"]
            ControllerMgr["controller-runtime Manager<br/>Leader Election: a7d60e25.kubeflow.org"]
            ISController["InferenceService Controller<br/>Conditional: INFERENCE_SERVICE_CONTROLLER=managed"]
            OpenAPIClient["OpenAPI HTTP Client<br/>Registry Sync"]
            MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP TLS<br/>TokenReview + SAR"]
            ControllerMgr --> ISController
            ISController --> OpenAPIClient
            ControllerMgr --> MetricsEndpoint
        end

        subgraph BFF["BFF (Backend-for-Frontend)"]
            BFFServer["BFF Server<br/>localhost:4000"]
            AuthModule["Auth Module<br/>--auth-method: internal | user_token"]
            SARCheck["SubjectAccessReview<br/>Authorization"]
            UIProxy["UI Static Files +<br/>API Proxy /api/v1/*"]
            BFFServer --> AuthModule
            AuthModule --> SARCheck
            BFFServer --> UIProxy
        end

        subgraph AsyncUpload["Async Upload Job"]
            PythonJob["Python Batch Job<br/>job.entrypoint"]
            S3Upload["boto3 S3 Upload"]
            ModelSigning["rh-model-signing<br/>sigstore"]
            PythonJob --> S3Upload
            PythonJob --> ModelSigning
        end
    end

    %% External actors
    User["Data Scientist / User"]
    KubeAPI["Kubernetes API<br/>:6443/HTTPS"]

    %% Istio Ingress
    subgraph IstioIngress["Istio Ingress Layer"]
        VS_API["VirtualService<br/>model-registry"]
        VS_Catalog["VirtualService<br/>model-catalog"]
        VS_UI["VirtualService<br/>model-registry-ui"]
    end

    %% External systems
    DB[("PostgreSQL / MySQL<br/>Backing Database")]
    S3["S3-Compatible Storage<br/>Model Artifacts"]
    KServeIS["KServe<br/>InferenceService CRs"]

    %% Flows
    User -->|"HTTP"| IstioIngress
    VS_API -->|"/api/model_registry/*<br/>Istio AuthzPolicy"| ProxyAPI
    VS_Catalog --> ProxyAPI
    VS_UI -->|"/model-registry/*<br/>Istio AuthzPolicy"| BFFServer
    GORM --> DB
    ISController -->|"watches"| KServeIS
    OpenAPIClient -->|"syncs serving URLs"| ProxyAPI
    S3Upload --> S3
    SARCheck --> KubeAPI
    ControllerMgr --> KubeAPI

    %% Styling
    style ProxyAPI fill:#4a90e2,color:#fff
    style ISController fill:#4a90e2,color:#fff
    style BFFServer fill:#4a90e2,color:#fff
    style PythonJob fill:#4a90e2,color:#fff
    style DB fill:#f5a623,color:#fff
    style S3 fill:#f5a623,color:#fff
    style KServeIS fill:#7ed321,color:#fff
    style KubeAPI fill:#e8e8e8
    style VS_API fill:#ffe6cc,stroke:#d79b00
    style VS_Catalog fill:#ffe6cc,stroke:#d79b00
    style VS_UI fill:#ffe6cc,stroke:#d79b00
