graph TB
    subgraph ModelRegistry["Model Registry"]
        direction TB

        subgraph CoreService["Core Registry Service"]
            Proxy["model-registry Proxy<br/>:8080/TCP HTTP"]
            DB["Database Backend<br/>(PostgreSQL / MySQL via GORM)"]
            Proxy -->|GORM queries| DB
        end

        subgraph BFFLayer["Backend for Frontend (BFF)"]
            BFF["BFF Server<br/>:4000/TCP HTTP/HTTPS"]
            AuthModule["Auth Module<br/>internal / user_token"]
            BFF -->|auth-method flag| AuthModule
        end

        subgraph ControllerLayer["Controller (Conditional)"]
            Controller["InferenceService Controller<br/>controller-runtime"]
            MetricsEndpoint["Metrics Endpoint<br/>:8443/TCP HTTPS"]
            Controller -->|exposes| MetricsEndpoint
        end

        subgraph AsyncJobs["Async Jobs"]
            AsyncUpload["async-upload Job<br/>Python"]
        end

        BFF -->|REST calls| Proxy
    end

    %% External Users
    User[User / Data Scientist] -->|HTTPS/443| IstioGW
    IstioGW["Istio Ingress Gateway"] -->|HTTP/8080<br/>mTLS| BFF
    IstioGW -->|HTTP/8080<br/>mTLS| Proxy

    %% Ingress VirtualServices
    subgraph VirtualServices["Istio VirtualServices"]
        VS_MR["model-registry VS"]
        VS_MC["model-catalog VS"]
        VS_UI["model-registry-ui VS"]
    end
    IstioGW --> VS_MR
    IstioGW --> VS_MC
    IstioGW --> VS_UI

    %% Controller interactions
    Controller -->|watches| InferenceServiceCR["KServe InferenceService CR"]
    Controller -->|lists Services<br/>label: component=model-registry| K8sServices["Kubernetes Services"]
    Controller -->|updates metadata| Proxy

    %% Async upload
    AsyncUpload -->|uploads artifacts| S3["S3-Compatible Storage"]

    %% Kubernetes API
    BFF -->|HTTPS/6443<br/>SA token| K8sAPI["Kubernetes API"]
    Controller -->|HTTPS/6443<br/>SA token| K8sAPI

    %% Health probes
    Kubelet["Kubelet"] -->|GET :8081/healthz| Proxy
    Kubelet -->|GET :8081/readyz| Proxy

    %% Styling
    style Proxy fill:#4a90e2,stroke:#333,color:#fff
    style BFF fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style AsyncUpload fill:#4a90e2,stroke:#333,color:#fff
    style AuthModule fill:#6bb5e0,stroke:#333
    style MetricsEndpoint fill:#6bb5e0,stroke:#333
    style DB fill:#7ed321,stroke:#333
    style InferenceServiceCR fill:#f5a623,stroke:#333
    style IstioGW fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style User fill:#fff,stroke:#333
    style Kubelet fill:#e8e8e8,stroke:#333
