graph TB
    subgraph "eval-hub Service"
        direction TB
        APIServer["eval-hub API Server<br/>net/http.ServeMux<br/>Port 8080"]
        MetricsServer["Metrics Server<br/>Prometheus /metrics<br/>Separate port (cluster mode)"]
        StorageLayer["SQL Storage Layer<br/>PostgreSQL (prod) / SQLite (dev)<br/>OTel instrumented"]
        IdentityMiddleware["Identity Middleware<br/>X-User / X-Tenant headers<br/>Conditional enforcement"]

        APIServer -->|"identity check"| IdentityMiddleware
        APIServer -->|"persist state"| StorageLayer
        APIServer -->|"exposes"| MetricsServer
    end

    subgraph "Evaluation Runtime Pod"
        direction TB
        InitContainer["eval-runtime-init<br/>S3 test data download"]
        Sidecar["eval-runtime-sidecar<br/>Credential injection proxy<br/>Reverse proxy to model endpoint"]
        EvalAdapter["Evaluation Adapter<br/>(primary container)"]

        InitContainer -.->|"downloads test data"| EvalAdapter
        EvalAdapter -->|"inference via proxy"| Sidecar
    end

    subgraph "Support Binaries"
        MCPServer["evalhub-mcp<br/>Model Context Protocol server"]
        ValidateConfigs["validate-configs<br/>Offline config validation"]
    end

    Client[Client / Dashboard] -->|"POST /api/v1/evaluations/*<br/>X-User, X-Tenant headers"| APIServer

    APIServer -->|"creates K8s Job"| EvalJob[Kubernetes Job]
    EvalJob -->|"runs"| InitContainer
    EvalJob -->|"runs"| Sidecar
    EvalJob -->|"runs"| EvalAdapter

    APIServer -->|"manages"| ConfigMap[ConfigMap<br/>Eval configuration]
    APIServer -->|"manages"| Secret[Secret<br/>Credential references]
    APIServer -->|"reads"| HardwareProfile[HardwareProfile CR]

    Sidecar -->|"proxied inference"| ModelEndpoint["Model Endpoint<br/>Configurable TLS"]
    APIServer -->|"export results"| MLflow["MLflow Tracking Server<br/>Configurable TLS + custom CA"]
    APIServer -->|"publish evalcards"| OCIRegistry["OCI Registry"]

    APIServer -->|"HTTPS/WSS :6443"| K8sAPI["Kubernetes API Server"]
    InitContainer -->|"download"| S3["S3-compatible Storage"]

    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style StorageLayer fill:#4a90e2,stroke:#333,color:#fff
    style IdentityMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style InitContainer fill:#50c878,stroke:#333,color:#fff
    style Sidecar fill:#50c878,stroke:#333,color:#fff
    style EvalAdapter fill:#50c878,stroke:#333,color:#fff
    style MCPServer fill:#9b59b6,stroke:#333,color:#fff
    style ValidateConfigs fill:#9b59b6,stroke:#333,color:#fff
    style HardwareProfile fill:#f5a623,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style Secret fill:#f5a623,stroke:#333
    style EvalJob fill:#f5a623,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ModelEndpoint fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style OCIRegistry fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
