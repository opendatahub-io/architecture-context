graph TB
    subgraph EvalHub["Eval-Hub Service"]
        direction TB
        EvalHubAPI["eval_hub<br/>REST API Server<br/>:8080"]
        MetricsServer["Metrics Server<br/>Prometheus<br/>:8081"]
        IdentityGate["Identity Gate Middleware<br/>X-User / X-Tenant"]
        EvalHubAPI -->|conditional| IdentityGate
    end

    subgraph RuntimeComponents["Runtime Components"]
        InitContainer["eval_runtime_init<br/>Init Container<br/>S3 Data Download"]
        Sidecar["eval_runtime_sidecar<br/>Proxy Sidecar"]
        MCPServer["evalhub_mcp<br/>MCP Server"]
        ValidateConfigs["validate_configs<br/>Config Validator"]
    end

    subgraph KubernetesResources["Kubernetes Resources"]
        Jobs["batch/v1 Jobs"]
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
        HWProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1"]
    end

    Client[Client] -->|REST API| EvalHubAPI
    IdentityGate -->|evaluation jobs| Jobs
    IdentityGate -->|evaluation configs| ConfigMaps
    IdentityGate -->|credentials| Secrets
    IdentityGate -->|hardware scheduling| HWProfile

    EvalHubAPI -->|metrics| MetricsServer

    InitContainer -->|downloads test data| S3["S3-Compatible Storage"]
    EvalHubAPI -->|experiment tracking| MLflow["MLflow Tracking Server"]
    EvalHubAPI -->|traces/metrics/logs| OTelCollector["OpenTelemetry Collector"]

    subgraph Storage["Database"]
        PostgreSQL["PostgreSQL<br/>(production)"]
        SQLite["SQLite<br/>(development)"]
    end

    EvalHubAPI -->|persistence| PostgreSQL
    EvalHubAPI -->|persistence| SQLite

    EvalHubAPI -->|HTTPS/6443| K8sAPI["Kubernetes API"]

    style EvalHubAPI fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style IdentityGate fill:#e8744f,stroke:#333,color:#fff
    style InitContainer fill:#50a0c0,stroke:#333,color:#fff
    style Sidecar fill:#50a0c0,stroke:#333,color:#fff
    style MCPServer fill:#50a0c0,stroke:#333,color:#fff
    style ValidateConfigs fill:#50a0c0,stroke:#333,color:#fff
    style Jobs fill:#f5a623,stroke:#333
    style ConfigMaps fill:#f5a623,stroke:#333
    style Secrets fill:#f5a623,stroke:#333
    style HWProfile fill:#f5a623,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style MLflow fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#7ed321,stroke:#333
    style SQLite fill:#7ed321,stroke:#333
