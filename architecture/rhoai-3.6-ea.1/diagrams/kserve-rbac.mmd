graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager"]
        SA_LLMISvc["$(llmisvc-serviceAccountName)"]
        SA_LocalModel["kserve-localmodel-<br/>controller-manager"]
        SA_LocalModelNode["kserve-localmodelnode-<br/>agent"]
        SA_Module["kserve-module-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["kserve-manager-<br/>rolebinding"]
        CRB_Proxy["kserve-proxy-<br/>rolebinding"]
        CRB_LLMISvc["llmisvc-manager-<br/>rolebinding"]
        CRB_LocalModel["kserve-localmodel-<br/>manager-rolebinding"]
        CRB_LocalModelNode["kserve-localmodelnode-<br/>agent-rolebinding"]
        CRB_Module["kserve-module-<br/>manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLMISvc["kserve-llmisvc-<br/>manager-role"]
        CR_LocalModel["kserve-localmodel-<br/>manager-role"]
        CR_LocalModelNode["kserve-localmodelnode-<br/>agent-role"]
        CR_Module["kserve-module-<br/>manager-role"]
    end

    subgraph ManagerResources["kserve-manager-role Resources"]
        M_IS["serving.kserve.io<br/>InferenceService<br/>InferenceGraph<br/>TrainedModel<br/>ClusterServingRuntime<br/>ServingRuntime<br/><i>full CRUD + watch</i>"]
        M_Knative["serving.knative.dev<br/>Services<br/><i>full CRUD + watch</i>"]
        M_Istio["networking.istio.io<br/>VirtualServices<br/><i>full CRUD + watch</i>"]
        M_Gateway["gateway.networking.k8s.io<br/>HTTPRoutes<br/><i>full CRUD + watch</i>"]
        M_KEDA["keda.sh<br/>ScaledObjects<br/><i>full CRUD + watch</i>"]
        M_Core["core<br/>Services, Events<br/>Deployments, HPAs<br/><i>full CRUD + watch</i>"]
    end

    subgraph ProxyResources["kserve-proxy-role Resources"]
        P_Auth["authentication.k8s.io<br/>TokenReviews<br/><i>create</i>"]
        P_Authz["authorization.k8s.io<br/>SubjectAccessReviews<br/><i>create</i>"]
    end

    subgraph LLMISvcResources["kserve-llmisvc-manager-role Resources"]
        L_LLMIS["serving.kserve.io<br/>LLMInferenceService<br/>LLMInferenceServiceConfig<br/><i>full CRUD + watch</i>"]
        L_GW["gateway.networking.k8s.io<br/>Gateways, GatewayClasses<br/>HTTPRoutes<br/><i>full CRUD + watch</i>"]
        L_InfPool["inference.networking.k8s.io<br/>InferenceModels<br/>InferencePools<br/><i>full CRUD + watch</i>"]
        L_LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSets<br/><i>full CRUD + watch</i>"]
        L_Resource["resource.k8s.io<br/>ResourceClaims<br/>ResourceClaimTemplates<br/><i>full CRUD + watch</i>"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        LM_Cache["serving.kserve.io<br/>LocalModelCache<br/>LocalModelNamespaceCache<br/>LocalModelNode<br/><i>full CRUD + watch</i>"]
        LM_PV["core<br/>PersistentVolumes<br/>PersistentVolumeClaims<br/><i>full CRUD + watch</i>"]
        LM_Nodes["core<br/>Nodes<br/><i>get, list, watch</i>"]
    end

    subgraph LocalModelNodeResources["kserve-localmodelnode-agent-role Resources"]
        LMN_Jobs["batch<br/>Jobs<br/><i>full CRUD + watch</i>"]
        LMN_Nodes["core<br/>Nodes, Secrets, SAs<br/><i>get, list, watch</i>"]
        LMN_LMN["serving.kserve.io<br/>LocalModelNodes<br/><i>full CRUD + watch</i>"]
    end

    subgraph ModuleResources["kserve-module-manager-role Resources"]
        Mod_Platform["components.platform<br/>.opendatahub.io<br/>Kserves<br/><i>full CRUD + watch</i>"]
        Mod_CRD["apiextensions.k8s.io<br/>CRDs<br/><i>full CRUD + watch</i>"]
        Mod_RBAC["rbac.authorization.k8s.io<br/>ClusterRoles, Roles<br/>Bindings (+ escalate, bind)<br/><i>full CRUD + watch</i>"]
        Mod_SCC["security.openshift.io<br/>SecurityContextConstraints<br/><i>full CRUD + watch</i>"]
        Mod_NetPol["networking.k8s.io<br/>NetworkPolicies<br/><i>full CRUD + watch</i>"]
        Mod_Cert["cert-manager.io<br/>Certificates, Issuers<br/>ClusterIssuers<br/><i>full CRUD + watch</i>"]
        Mod_NIM["nim.opendatahub.io<br/>Accounts<br/><i>full CRUD + watch</i>"]
    end

    %% SA → CRB
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Proxy
    SA_LLMISvc -->|bound via| CRB_LLMISvc
    SA_LocalModel -->|bound via| CRB_LocalModel
    SA_LocalModelNode -->|bound via| CRB_LocalModelNode
    SA_Module -->|bound via| CRB_Module

    %% CRB → CR
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    CRB_LLMISvc -->|grants| CR_LLMISvc
    CRB_LocalModel -->|grants| CR_LocalModel
    CRB_LocalModelNode -->|grants| CR_LocalModelNode
    CRB_Module -->|grants| CR_Module

    %% CR → Resources
    CR_Manager --> M_IS
    CR_Manager --> M_Knative
    CR_Manager --> M_Istio
    CR_Manager --> M_Gateway
    CR_Manager --> M_KEDA
    CR_Manager --> M_Core
    CR_Proxy --> P_Auth
    CR_Proxy --> P_Authz
    CR_LLMISvc --> L_LLMIS
    CR_LLMISvc --> L_GW
    CR_LLMISvc --> L_InfPool
    CR_LLMISvc --> L_LWS
    CR_LLMISvc --> L_Resource
    CR_LocalModel --> LM_Cache
    CR_LocalModel --> LM_PV
    CR_LocalModel --> LM_Nodes
    CR_LocalModelNode --> LMN_Jobs
    CR_LocalModelNode --> LMN_Nodes
    CR_LocalModelNode --> LMN_LMN
    CR_Module --> Mod_Platform
    CR_Module --> Mod_CRD
    CR_Module --> Mod_RBAC
    CR_Module --> Mod_SCC
    CR_Module --> Mod_NetPol
    CR_Module --> Mod_Cert
    CR_Module --> Mod_NIM

    %% Styles
    style SA_Manager fill:#4a90e2,color:#fff
    style SA_LLMISvc fill:#4a90e2,color:#fff
    style SA_LocalModel fill:#4a90e2,color:#fff
    style SA_LocalModelNode fill:#4a90e2,color:#fff
    style SA_Module fill:#4a90e2,color:#fff

    style CR_Manager fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_LLMISvc fill:#f5a623,color:#fff
    style CR_LocalModel fill:#f5a623,color:#fff
    style CR_LocalModelNode fill:#f5a623,color:#fff
    style CR_Module fill:#f5a623,color:#fff

    style M_IS fill:#7ed321,color:#fff
    style M_Knative fill:#7ed321,color:#fff
    style M_Istio fill:#7ed321,color:#fff
    style M_Gateway fill:#7ed321,color:#fff
    style M_KEDA fill:#7ed321,color:#fff
    style M_Core fill:#7ed321,color:#fff
    style P_Auth fill:#e74c3c,color:#fff
    style P_Authz fill:#e74c3c,color:#fff
    style L_LLMIS fill:#7ed321,color:#fff
    style L_GW fill:#7ed321,color:#fff
    style L_InfPool fill:#7ed321,color:#fff
    style L_LWS fill:#7ed321,color:#fff
    style L_Resource fill:#7ed321,color:#fff
    style LM_Cache fill:#7ed321,color:#fff
    style LM_PV fill:#7ed321,color:#fff
    style LM_Nodes fill:#7ed321,color:#fff
    style LMN_Jobs fill:#7ed321,color:#fff
    style LMN_Nodes fill:#7ed321,color:#fff
    style LMN_LMN fill:#7ed321,color:#fff
    style Mod_Platform fill:#9b59b6,color:#fff
    style Mod_CRD fill:#9b59b6,color:#fff
    style Mod_RBAC fill:#9b59b6,color:#fff
    style Mod_SCC fill:#9b59b6,color:#fff
    style Mod_NetPol fill:#9b59b6,color:#fff
    style Mod_Cert fill:#9b59b6,color:#fff
    style Mod_NIM fill:#9b59b6,color:#fff
