    style SA_Manager fill:#4a90e2,color:#fff
    style SA_LLMISVC fill:#4a90e2,color:#fff
    style SA_LocalModel fill:#4a90e2,color:#fff
    style SA_LocalModelNode fill:#4a90e2,color:#fff
    style SA_Module fill:#4a90e2,color:#fff

