graph LR
    KAP["kube-auth-proxy<br/>(Authenticating Reverse Proxy)"]

    %% Core Runtime Dependencies
    KAP -->|"HTTP routing"| GorillaMux["gorilla/mux 1.8.1"]
    KAP -->|"middleware chains"| Alice["justinas/alice 1.2.0"]
    KAP -->|"OAuth2 flow"| OAuth2["golang.org/x/oauth2"]
    KAP -->|"OIDC discovery"| OIDC["coreos/go-oidc/v3 3.18"]
    KAP -->|"JWT verification"| JWT["golang-jwt/jwt/v5 5.3"]
    KAP -->|"JOSE/JWK"| JOSE["go-jose/go-jose/v3 3.0.5"]

    %% Infrastructure Dependencies
    KAP -->|"session store"| GoRedis["redis/go-redis/v9 9.17"]
    KAP -->|"distributed locks"| RedisLock["bsm/redislock 0.9.4"]
    KAP -->|"config mgmt"| Viper["spf13/viper 1.21"]
    KAP -->|"CLI flags"| PFlag["spf13/pflag 1.10"]
    KAP -->|"env substitution"| EnvSubst["a8m/envsubst 1.4.3"]

    %% Kubernetes Integration
    KAP -->|"TokenReview API"| K8sAPI["k8s.io/api 0.35.3"]
    KAP -->|"API machinery"| K8sAPIMach["k8s.io/apimachinery 0.35.3"]
    KAP -->|"API client"| K8sClient["k8s.io/client-go 0.35.3"]

    %% Observability
    KAP -->|"metrics"| Prometheus["prometheus/client_golang 1.23.2"]

    %% Crypto & Security
    KAP -->|"TLS/crypto"| GoCrypto["golang.org/x/crypto 0.51"]
    KAP -->|"HMAC auth"| HMACAuth["mbland/hmacauth"]

    %% Serialization
    KAP -->|"JSON parsing"| SimpleJSON["bitly/go-simplejson 0.5.1"]
    KAP -->|"msgpack"| MsgPack["vmihailenco/msgpack/v5 5.4.1"]
    KAP -->|"compression"| LZ4["pierrec/lz4/v4 4.1.22"]

    %% External Service Dependencies
    KAP ==>|"token validation<br/>6443/TCP HTTPS"| KubeAPIServer["Kubernetes API Server"]
    KAP ==>|"session persistence<br/>TCP, optional TLS"| RedisServer["Redis/Valkey Server"]
    KAP ==>|"OAuth2/OIDC flow<br/>HTTPS"| OIDCProvider["OAuth2/OIDC Provider<br/>(OpenShift OAuth)"]

    %% Build Dependencies
    KAP -.->|"FIPS build"| UBI9["UBI9 ubi-minimal<br/>OpenSSL + strictfipsruntime"]
    KAP -.->|"Go runtime"| GoRuntime["Go 1.26"]

