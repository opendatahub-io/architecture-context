graph TB
    subgraph External["CALLER (Guardrails Pipeline)"]
        Orchestrator["Guardrails Orchestrator"]
    end

    subgraph PlatformSecurity["PLATFORM SECURITY LAYER (Service Mesh / Ingress)"]
        direction TB
        MeshSidecar["Service Mesh Sidecar<br/>(e.g., Istio Envoy)<br/>mTLS enforcement<br/>Auth policy"]
    end

    subgraph Service["SERVICE (Stateless Microservice)"]
        direction TB
        subgraph Container["Container: UBI9-minimal"]
            Binary["regex-detector<br/>/app/bin/regex-detector<br/>Rust / Axum 0.7.9 / Tokio 1.41.1"]

            subgraph Endpoints["Endpoints (8080/TCP)"]
                API["POST /api/v1/text/contents<br/>HTTP · No TLS · No Auth<br/>PII + custom regex detection"]
                Health["GET /health<br/>HTTP · No TLS · No Auth<br/>Liveness/readiness probe"]
            end

            Binary --- Endpoints
        end
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>No app-layer TLS<br/>No app-layer auth<br/>(platform-delegated)"| MeshSidecar
    MeshSidecar -->|"HTTP/8080<br/>After mTLS termination<br/>After auth check"| API
    MeshSidecar -.->|"HTTP/8080<br/>Health probes"| Health

    %% No egress
    Binary -.->|"No outbound<br/>connections"| NoEgress["(None)"]

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef service fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef endpoint fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px
    classDef noconn fill:#f8f8f8,stroke:#ccc,stroke-dasharray: 5 5

    class Orchestrator external
    class MeshSidecar platform
    class Binary,Container service
    class API,Health endpoint
    class NoEgress noconn
