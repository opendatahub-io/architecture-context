graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Platform-Controlled)"]
        Orchestrator["Guardrails Orchestrator<br/>(upstream caller)"]
        K8sProbe["Kubernetes Probes<br/>(liveness/readiness)"]
    end

    subgraph ServiceBoundary["SERVICE BOUNDARY (No App-Level Auth)"]
        direction TB

        subgraph Pod["Pod: guardrails-regex-detector"]
            Server["Axum HTTP Server<br/>Port: 8080/TCP<br/>Protocol: HTTP (plain)<br/>Auth: None<br/>Image: UBI 9 Minimal"]

            subgraph Endpoints["Endpoints"]
                API["POST /api/v1/text/contents<br/>Regex detection<br/>No auth"]
                Health["GET /health<br/>Health check<br/>No auth"]
            end

            Server --> API
            Server --> Health
        end
    end

    %% Flows
    Orchestrator -->|"HTTP/8080<br/>Plain HTTP<br/>No Auth<br/>JSON payload"| Server
    K8sProbe -->|"HTTP/8080<br/>GET /health<br/>No Auth"| Server

    %% No egress
    NoEgress["No Outbound Connections<br/>No Secrets<br/>No Persistent State"]

    Pod -.->|"(none)"| NoEgress

    %% Styling
    classDef clusterInternal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef serviceBoundary fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef endpoint fill:#e1d5e7,stroke:#9673a6,stroke-width:1px
    classDef noegress fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5

    class Orchestrator,K8sProbe clusterInternal
    class Server pod
    class API,Health endpoint
    class NoEgress noegress
