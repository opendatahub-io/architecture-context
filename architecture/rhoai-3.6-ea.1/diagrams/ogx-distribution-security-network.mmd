graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM INGRESS"]
        Ingress["Platform Ingress/Route<br/>TLS Termination<br/>(platform-delegated)"]
    end

    subgraph AppLayer["APPLICATION LAYER"]
        direction TB

        subgraph OGXService["OGX Distribution Service"]
            Entrypoint["entrypoint.sh<br/>Secret Resolution<br/>18 _FILE env vars"]
            AuthMW["Auth Middleware<br/>OAuth2 JWKS validation<br/>(conditional: AUTH_ISSUER)<br/>3600s key recheck"]
            Server["OGX Server<br/>8321/TCP HTTP<br/>--insecure (no TLS)<br/>TLS delegated to platform"]
            Entrypoint --> Server
            Server --> AuthMW
        end
    end

    subgraph InferenceProviders["INFERENCE PROVIDERS (External)"]
        direction LR
        vLLM["vLLM<br/>Configurable port<br/>HTTP/HTTPS<br/>TLS verify configurable<br/>API Token"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>TLS<br/>AWS SDK Auth"]
        WatsonX["IBM WatsonX<br/>443/TCP HTTPS<br/>TLS<br/>API Key"]
    end

    subgraph StorageLayer["STORAGE LAYER"]
        direction LR
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>PostgreSQL wire protocol<br/>Encryption: configurable"]
        Milvus["Milvus<br/>Configurable port<br/>HTTP/gRPC<br/>mTLS configurable<br/>(ca_pem, client_pem, client_key)"]
        PGVector["pgvector<br/>5432/TCP<br/>PostgreSQL wire protocol"]
        Qdrant["Qdrant<br/>6333/TCP HTTP, 6334/TCP gRPC<br/>HTTPS configurable"]
        S3Store["S3 Storage<br/>443/TCP HTTPS<br/>TLS"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>OTLP protocol<br/>Configurable endpoint"]
    end

    %% Flows
    Client -->|"HTTPS (platform TLS)"| Ingress
    Ingress -->|"HTTP/8321<br/>No TLS (--insecure)<br/>Auth: OAuth2 conditional"| Server

    Server -->|"HTTP/HTTPS<br/>TLS verify configurable<br/>API Token"| vLLM
    Server -->|"HTTPS/443<br/>TLS<br/>AWS SDK"| Bedrock
    Server -->|"HTTPS/443<br/>TLS<br/>API Key"| WatsonX

    Server -->|"SQL/5432<br/>PostgreSQL protocol"| PostgreSQL
    Server -->|"HTTP or gRPC<br/>mTLS configurable"| Milvus
    Server -->|"SQL/5432<br/>PostgreSQL protocol"| PGVector
    Server -->|"HTTP/6333 or gRPC/6334<br/>HTTPS configurable"| Qdrant
    Server -->|"HTTPS/443<br/>TLS"| S3Store

    Server -.->|"OTLP<br/>traces & metrics"| OTel

    %% Auth detail
    AuthMW -.->|"JWKS endpoint fetch<br/>AUTH_TLS_CAFILE for CA"| Ingress

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef inference fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Ingress platform
    class Entrypoint,AuthMW,Server app
    class vLLM,Bedrock,WatsonX inference
    class PostgreSQL,Milvus,PGVector,Qdrant,S3Store storage
    class OTel observability
