graph LR
    MCPModuleOp["MCP Lifecycle<br/>Module Operator"]

    %% Runtime Framework Dependencies
    MCPModuleOp -->|"runtime framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    MCPModuleOp -->|"runtime integration"| K8sAPI["k8s.io/api<br/>v0.36.2"]
    MCPModuleOp -->|"runtime integration"| K8sApimachinery["k8s.io/apimachinery<br/>v0.36.2"]
