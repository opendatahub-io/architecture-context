    MCPModuleOp -.->|"testing"| Ginkgo["ginkgo/v2<br/>v2.32.0"]
    MCPModuleOp -.->|"testing"| Gomega["gomega<br/>v1.42.1"]

    %% Build Dependency
    MCPModuleOp -.->|"build toolchain"| GoLang["Go 1.26.3"]

