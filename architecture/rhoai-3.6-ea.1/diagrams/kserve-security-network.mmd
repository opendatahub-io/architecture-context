graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph Ingress["INGRESS (Platform-Managed)"]
        Route["OpenShift Route / Gateway API HTTPRoute<br/>443/TCP → internal<br/>TLS 1.2+ (platform profile)<br/>Mozilla Intermediate fallback"]
    end

    subgraph InferencePlane["INFERENCE PLANE (Cluster Internal)"]
        direction TB

        subgraph NS_KServe_Router["Namespace: kserve"]
            InfRouter["Inference Router<br/>Auth: TokenReview + SAR<br/>Probes: 8081 (unauth)"]
        end

        subgraph NS_User["Namespace: {user-namespace}"]
            ModelServer["Model Server Pod<br/>HTTP: 8080/TCP (FastAPI/uvicorn)<br/>gRPC: GRPCInferenceService<br/>V2 Inference Protocol<br/>Auth: None (no middleware)"]
        end
    end

    subgraph ControlPlane["CONTROL PLANE (Namespace: kserve)"]
        direction TB

        Manager["KServe Manager<br/>SA: kserve-controller-manager<br/>Probes: 8081 (unauth)"]
        LLMISVC["LLMISVC Controller<br/>SA: llmisvc-sa<br/>Leader election: leases"]
        LocalModel["LocalModel Controller<br/>SA: kserve-localmodel-controller-manager"]
        LocalModelNode["LocalModelNode Agent<br/>SA: kserve-localmodelnode-agent"]
        ModuleOp["KServe Module Operator<br/>SA: kserve-module-controller-manager<br/>FIPS: strictfipsruntime"]
    end

    subgraph WebhookPlane["WEBHOOK PLANE"]
        Webhook["Webhook Server<br/>Service: kserve-webhook-server-service<br/>443/TCP<br/>TLS: cert-manager Certificate<br/>Auth: Kubernetes admission"]
    end

    subgraph MetricsPlane["METRICS & OBSERVABILITY"]
        AuthProxy["odh-kube-auth-proxy<br/>8443/TCP → 8080/TCP (localhost)<br/>TLS termination<br/>Auth: Kubernetes RBAC"]
        Prom["Prometheus<br/>Scrapes 8443/TCP HTTPS<br/>+ ServiceMonitor/PodMonitor CRs"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA token auth"]
        ObjStorage["S3 / GCS / Azure Blob<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>Cloud IAM credentials"]
        CertMgr["cert-manager<br/>Certificate CRs<br/>TLS 1.2+"]
    end

    %% External → Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (optional)"| Route

    %% Ingress → Inference
    Route -->|"HTTP/8080<br/>cluster-internal"| ModelServer
    Route -->|"HTTP (InferenceGraph)<br/>cluster-internal"| InfRouter

    %% Router auth + forwarding
    InfRouter -->|"HTTPS/6443<br/>TokenReview + SAR<br/>SA token"| K8sAPI
    InfRouter -->|"HTTP<br/>fan-out per DAG"| ModelServer

    %% Model server → storage
    ModelServer -->|"HTTPS/443<br/>TLS 1.2+<br/>Cloud IAM / credentials"| ObjStorage

    %% Control plane → K8s API
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LLMISVC -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LocalModel -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    LocalModelNode -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Webhook
    K8sAPI -->|"HTTPS/443<br/>TLS (cert-manager)<br/>admission call"| Webhook

    %% Metrics
    Manager -->|"HTTP/8080<br/>localhost only"| AuthProxy
    Prom -->|"HTTPS/8443<br/>TLS<br/>RBAC auth"| AuthProxy

    %% cert-manager
    Webhook -.->|"cert lifecycle"| CertMgr

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef inference fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef metrics fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class InfRouter,ModelServer inference
    class Manager,LLMISVC,LocalModel,LocalModelNode,ModuleOp controlplane
    class Webhook webhook
    class AuthProxy,Prom metrics
    class K8sAPI,ObjStorage,CertMgr externalservice
