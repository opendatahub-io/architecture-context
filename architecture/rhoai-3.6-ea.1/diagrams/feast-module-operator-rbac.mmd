graph TD
    subgraph "Service Accounts"
        SA_Main["opendatahub-feast-operator<br/>Namespace: opendatahub-feast-system"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["opendatahub-feast-<br/>manager-rolebinding"]
        CRB_Metrics["opendatahub-feast-<br/>metrics-auth-rolebinding"]
    end

    subgraph "Role Bindings (namespace-scoped)"
        RB_Leader["opendatahub-feast-<br/>leader-election-rolebinding<br/>NS: opendatahub-feast-system"]
    end

    subgraph "ClusterRoles"
        CR_Manager["opendatahub-feast-<br/>manager-role"]
        CR_Metrics["opendatahub-feast-<br/>metrics-auth-role"]
    end

    subgraph "Roles (namespace-scoped)"
        R_Leader["opendatahub-feast-<br/>leader-election-role"]
    end

    subgraph "Manager Role - Core Resources"
        Pods["core<br/>pods, pods/exec, pods/log"]
        Services["core<br/>services, serviceaccounts"]
        ConfigMaps["core<br/>configmaps"]
        Secrets["core<br/>namespaces, secrets"]
        PVCs["core<br/>persistentvolumeclaims"]
        Events["core<br/>events"]
    end

    subgraph "Manager Role - CRDs & Operators"
        FeastOperator["components.platform.opendatahub.io<br/>feastoperators<br/>+ finalizers + status"]
        FeatureStores["feast.dev<br/>featurestores<br/>+ finalizers + status"]
        Notebooks["kubeflow.org<br/>notebooks"]
        CRDResource["apiextensions.k8s.io<br/>customresourcedefinitions"]
    end

    subgraph "Manager Role - Workload Resources"
        Deployments["apps<br/>deployments"]
        Jobs["batch<br/>jobs, cronjobs"]
        HPAs["autoscaling<br/>horizontalpodautoscalers"]
        PDBs["policy<br/>poddisruptionbudgets"]
        SparkApps["sparkoperator.k8s.io<br/>sparkapplications"]
    end

    subgraph "Manager Role - RBAC & Infra"
        RBACResources["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings<br/>roles, rolebindings"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors"]
        Routes["route.openshift.io<br/>routes"]
        Leases["coordination.k8s.io<br/>leases"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SARs["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "Leader Election Resources"
        LE_ConfigMaps["core<br/>configmaps"]
        LE_Leases["coordination.k8s.io<br/>leases"]
        LE_Events["core<br/>events"]
    end

    %% Bindings
    SA_Main -->|bound via| CRB_Manager
    SA_Main -->|bound via| CRB_Metrics
    SA_Main -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader -->|grants| R_Leader

    %% Manager Role permissions
    CR_Manager -->|"full CRUD"| Pods
    CR_Manager -->|"full CRUD"| Services
    CR_Manager -->|"full CRUD"| ConfigMaps
    CR_Manager -->|"get,list,patch,update,watch"| Secrets
    CR_Manager -->|"full CRUD"| PVCs
    CR_Manager -->|"create,patch"| Events
    CR_Manager -->|"full CRUD + finalizers + status"| FeastOperator
    CR_Manager -->|"full CRUD + finalizers + status"| FeatureStores
    CR_Manager -->|"get,list,watch"| Notebooks
    CR_Manager -->|"full CRUD"| CRDResource
    CR_Manager -->|"full CRUD"| Deployments
    CR_Manager -->|"full CRUD"| Jobs
    CR_Manager -->|"full CRUD"| HPAs
    CR_Manager -->|"full CRUD"| PDBs
    CR_Manager -->|"create,delete,get"| SparkApps
    CR_Manager -->|"full CRUD"| RBACResources
    CR_Manager -->|"full CRUD"| ServiceMonitors
    CR_Manager -->|"create,delete,get,list,update,watch"| Routes
    CR_Manager -->|"full CRUD"| Leases
    CR_Manager -->|"create"| TokenReviews
    CR_Manager -->|"create"| SARs

    %% Metrics auth role
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SARs

    %% Leader election role
    R_Leader -->|"full CRUD"| LE_ConfigMaps
    R_Leader -->|"full CRUD"| LE_Leases
    R_Leader -->|"create,patch"| LE_Events

    style SA_Main fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff
    style FeastOperator fill:#7ed321,color:#fff
    style FeatureStores fill:#7ed321,color:#fff
    style Notebooks fill:#7ed321,color:#fff
