graph TB
    subgraph KServeOperator["KServe Operator (Control Plane)"]
        direction TB

        subgraph ManagerBin["manager binary"]
            ISController["InferenceService<br/>Controller"]
            IGController["InferenceGraph<br/>Controller"]
            TMController["TrainedModel<br/>Controller"]
            WebhookServer["Webhook Server<br/>443/TCP TLS"]
        end

        subgraph LLMISVCBin["llmisvc binary"]
            LLMISVCController["LLMInferenceService<br/>Controller"]
            LLMISVCConfigCtrl["LLMInferenceServiceConfig<br/>Controller"]
        end

        subgraph LocalModelBin["localmodel binary"]
            LMCacheController["LocalModelCache<br/>Controller"]
            LMNSCacheController["LocalModelNamespaceCache<br/>Controller"]
        end

        subgraph LocalModelNodeBin["localmodelnode binary"]
            LMNodeController["LocalModelNode<br/>Controller"]
        end

        subgraph ModuleBin["kserve-module binary"]
            KserveModuleCtrl["Kserve Module<br/>Controller"]
            CaBundleReconciler["CaBundle ConfigMap<br/>Reconciler"]
        end

        KubeRBACProxy["kube-rbac-proxy<br/>Sidecar<br/>8443/TCP TLS"]
    end

    subgraph CRDs["Custom Resource Definitions"]
        ISCR["InferenceService CR<br/>v1beta1"]
        IGCR["InferenceGraph CR<br/>v1alpha1"]
        TMCR["TrainedModel CR<br/>v1alpha1"]
        LLMISCR["LLMInferenceService CR<br/>v1alpha1/v1alpha2"]
        LLMISConfigCR["LLMInferenceServiceConfig CR<br/>v1alpha1/v1alpha2"]
        LMCacheCR["LocalModelCache CR<br/>v1alpha1"]
        LMNSCacheCR["LocalModelNamespaceCache CR<br/>v1alpha1"]
        LMNodeCR["LocalModelNode CR<br/>v1alpha1"]
        KserveCR["Kserve CR<br/>components.platform.opendatahub.io"]
        CSR["ClusterServingRuntime CR"]
        CSC["ClusterStorageContainer CR"]
    end

    subgraph ServingRuntimes["Serving Runtimes (14 ClusterServingRuntimes)"]
        HF["HuggingFace Server"]
        VLLM["vLLM Server"]
        Triton["Triton Server"]
        TFServing["TensorFlow Serving"]
        TorchServe["TorchServe"]
        SKLearn["scikit-learn Server"]
        XGB["XGBoost Server"]
        OtherRT["+ 7 more runtimes"]
    end

    subgraph PythonSDK["Python SDK & Prediction Protocol"]
        KServeSDK["KServe SDK<br/>V2 Prediction Protocol"]
        HTTPServer["FastAPI/Starlette<br/>HTTP Server"]
        GRPCServer["gRPC Server<br/>GRPCInferenceService"]
        StorageHandler["Storage Handlers<br/>S3, GCS, Azure, HDFS"]
    end

    subgraph IngressLayer["Ingress Strategies"]
        GatewayAPI["Gateway API<br/>HTTPRoute"]
        IstioVS["Istio<br/>VirtualService"]
        OSRoutes["OpenShift<br/>Routes"]
    end

    %% Controller → CRD relationships
    ISCR -->|watched by| ISController
    IGCR -->|watched by| IGController
    TMCR -->|watched by| TMController
    LLMISCR -->|watched by| LLMISVCController
    LLMISConfigCR -->|watched by| LLMISVCConfigCtrl
    LMCacheCR -->|watched by| LMCacheController
    LMNSCacheCR -->|watched by| LMNSCacheController
    LMNodeCR -->|watched by| LMNodeController
    KserveCR -->|watched by| KserveModuleCtrl

    %% Controller → Ingress
    ISController -->|creates| GatewayAPI
    ISController -->|creates| IstioVS
    LLMISVCController -->|creates| GatewayAPI
    LLMISVCController -->|creates| OSRoutes
    IGController -->|creates| OSRoutes

    %% Controller → Serving
    ISController -->|provisions| ServingRuntimes
    LLMISVCController -->|provisions| ServingRuntimes

    %% SDK relationships
    KServeSDK --> HTTPServer
    KServeSDK --> GRPCServer
    KServeSDK --> StorageHandler

    %% Module controller → Platform
    KserveModuleCtrl -->|manages CRDs, RBAC,<br/>SCC, NetworkPolicies| KServeOperator

    %% Metrics
    KubeRBACProxy -->|proxies metrics<br/>8443→8080| ISController

