graph TB
    subgraph "llm-d-latency-predictor"
        subgraph TrainingServer["Training Server (port 8000)"]
            TrainApp["FastAPI App<br/>uvicorn :8000"]
            DataIngestion["Data Ingestion<br/>/add_training_data_bulk"]
            ModelTrainer["Model Trainer<br/>Background Thread"]
            ModelStore["Model Store<br/>XGBoost / LightGBM / BayesRidge"]
            ModelExport["Model Export API<br/>/model/{name}/download<br/>/model/{name}/info"]
            DebugAPI["Debug API<br/>/debug/prefix_distribution<br/>/model/*/importances"]
            TrainHealthz["Health Probes<br/>/healthz /readyz"]

            DataIngestion --> ModelTrainer
            ModelTrainer --> ModelStore
            ModelStore --> ModelExport
            ModelStore --> DebugAPI
        end

        subgraph PredictionServer["Prediction Server (port 8001)"]
            PredApp["FastAPI App<br/>uvicorn :8001<br/>$UVICORN_WORKERS workers"]
            ModelSyncer["ModelSyncer<br/>Background Thread<br/>Polls every MODEL_SYNC_INTERVAL_SEC"]
            LocalModels["Local Model Cache<br/>/local_models/"]
            PredictAPI["Prediction API<br/>/predict<br/>/predict/bulk<br/>/predict/bulk/strict"]
            PredStatus["Status API<br/>/status /healthz /readyz"]

            ModelSyncer --> LocalModels
            LocalModels --> PredictAPI
        end
    end

    TelemetryProducer["Telemetry Producer<br/>(llm-d gateway / scheduler)"] -->|"POST /add_training_data_bulk<br/>HTTP :8000"| DataIngestion
    ModelSyncer -->|"GET /model/{name}/info<br/>GET /model/{name}/download<br/>HTTP :8000<br/>Retry on 502/503/504"| ModelExport

    InferenceConsumer["Inference Consumer<br/>(llm-d routing)"] -->|"POST /predict*<br/>HTTP :8001"| PredictAPI

    K8s["Kubernetes<br/>kubelet"] -->|"GET /healthz /readyz<br/>HTTP :8000 :8001"| TrainHealthz
    K8s -->|"GET /healthz /readyz<br/>HTTP :8001"| PredStatus

    style TrainingServer fill:#4a90e2,stroke:#333,color:#fff
    style PredictionServer fill:#7ed321,stroke:#333,color:#fff
    style TelemetryProducer fill:#f5a623,stroke:#333
    style InferenceConsumer fill:#f5a623,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
    style ModelSyncer fill:#50c878,stroke:#333
    style ModelTrainer fill:#6ab0de,stroke:#333
