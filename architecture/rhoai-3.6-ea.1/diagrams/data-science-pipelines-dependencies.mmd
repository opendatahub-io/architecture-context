graph LR
    DSP["Data Science Pipelines<br/>(ml-pipeline API Server)"]

    %% Runtime Framework
    DSP -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    DSP -->|"gRPC transport"| GRPC["google.golang.org/grpc 1.82.1"]
    DSP -->|"REST routing"| GorillaMux["gorilla/mux 1.8.1"]
    DSP -->|"gRPC-REST gateway"| GRPCGateway["grpc-gateway/v2 2.28.0"]

    %% Workflow Engine
    DSP -->|"pipeline execution"| ArgoWF["Argo Workflows v3.7.14"]

    %% Data Storage
    DSP -->|"S3 artifacts"| AWSSDK["AWS SDK v2 1.41.5<br/>(S3 client)"]
    DSP -->|"metadata queries"| MySQL["go-sql-driver/mysql 1.9.3"]
    DSP -->|"ORM"| GORM["gorm.io/gorm 1.30.1"]
    DSP -->|"alt S3 client"| MinIO["minio-go/v7 7.0.100"]

    %% Kubernetes
    DSP -->|"K8s API client"| K8sClientGo["k8s.io/client-go 0.35.2"]
    DSP -->|"K8s API types"| K8sAPI["k8s.io/api 0.35.2"]
    DSP -->|"CRD extensions"| K8sApiExt["k8s.io/apiextensions-apiserver 0.35.2"]

    %% Observability
    DSP -->|"metrics"| PromClient["prometheus/client_golang 1.23.2"]
    DSP -->|"gRPC metrics"| GRPCProm["go-grpc-prometheus 1.2.0"]
    DSP -->|"logging"| Zap["go.uber.org/zap 1.27.0"]
    DSP -->|"logging"| Logrus["sirupsen/logrus 1.9.4"]

    %% Serialization
    DSP -->|"protobuf"| Protobuf["google.golang.org/protobuf 1.36.11"]
    DSP -->|"OpenAPI"| OpenAPI["go-openapi suite"]

    %% Config
    DSP -->|"config mgmt"| Viper["spf13/viper 1.20.1"]

    %% Internal Platform Dependencies
    DSP -.->|"metrics scraping"| Prometheus["Prometheus"]
    DSP -.->|"notebook mgmt"| KubeflowNB["Kubeflow Notebooks"]

    %% Python Dependencies
    DSP -->|"Python SDK"| KFP["kfp 1.8.13"]
    DSP -->|"K8s Python"| K8sPy["kubernetes 12.0.1"]
    DSP -->|"model serving"| KServe["kserve 0.12.0"]

