        CR_MetricsAlt["metrics-auth-role"]
        CR_Editor["feast-operator-featurestore-editor-role"]
        CR_Viewer["feast-operator-featurestore-viewer-role"]
    end

    subgraph Roles["Roles (Namespaced)"]
        R_Leader["feast-operator-leader-election-role<br/>(NS: feast-operator-system)"]
        R_LeaderAlt["leader-election-role<br/>(NS: system)"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["ConfigMaps<br/>create, delete, deletecollection,<br/>get, list, patch, update, watch"]
        Namespaces["Namespaces<br/>get, list, patch, update, watch"]
        PVCs["PVCs, Services<br/>create, delete, deletecollection,<br/>get, list, update, watch"]
        Pods["Pods<br/>create, delete, deletecollection,<br/>get, list, watch"]
        PodsExec["Pods/exec<br/>create"]
        PodsLog["Pods/log<br/>get"]
        Secrets["Secrets<br/>get, list, watch"]
        ServiceAccounts2["ServiceAccounts<br/>create, delete, get,<br/>list, update, watch"]
    end

    subgraph FeastResources["Feast API Resources (feast.dev)"]
        FeatureStores["FeatureStores<br/>create, delete, get, list,<br/>patch, update, watch"]
