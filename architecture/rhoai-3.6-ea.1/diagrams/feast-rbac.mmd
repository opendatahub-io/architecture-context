    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["feast-operator-manager-rolebinding"]
        CRB_Metrics["feast-operator-metrics-auth-rolebinding"]
        CRB_ManagerAlt["manager-rolebinding"]
        CRB_MetricsAlt["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespaced)"]
        RB_Leader["feast-operator-leader-election-rolebinding<br/>(NS: feast-operator-system)"]
        RB_LeaderAlt["leader-election-rolebinding<br/>(NS: system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["feast-operator-manager-role"]
