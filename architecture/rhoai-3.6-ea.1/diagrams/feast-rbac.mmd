    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews<br/>create"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews<br/>create"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        LEConfigMaps["ConfigMaps<br/>create, delete, get, list,<br/>patch, update, watch"]
        LELeases["coordination.k8s.io/Leases<br/>create, delete, get, list,<br/>patch, update, watch"]
        LEEvents["Events<br/>create, patch"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    SA_Operator -->|bound via| CRB_Metrics
    SA_Operator -->|bound via| RB_Leader

    %% Controller SA bindings
    SA_Controller -->|bound via| CRB_ManagerAlt
    SA_Controller -->|bound via| CRB_MetricsAlt
    SA_Controller -->|bound via| RB_LeaderAlt

    %% ClusterRole grants
    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    CRB_ManagerAlt -->|grants| CR_ManagerAlt
    CRB_MetricsAlt -->|grants| CR_MetricsAlt

    %% Role grants
    RB_Leader -->|grants| R_Leader
    RB_LeaderAlt -->|grants| R_LeaderAlt

    %% Manager role permissions
    CR_Manager -->|manages| ConfigMaps
    CR_Manager -->|manages| Namespaces
    CR_Manager -->|manages| PVCs
    CR_Manager -->|manages| Pods
    CR_Manager -->|manages| PodsExec
    CR_Manager -->|manages| PodsLog
    CR_Manager -->|reads| Secrets
    CR_Manager -->|manages| ServiceAccounts2
    CR_Manager -->|manages| FeatureStores
    CR_Manager -->|manages| FeatureStoresFinalizers
    CR_Manager -->|manages| FeatureStoresStatus
    CR_Manager -->|manages| Deployments
    CR_Manager -->|manages| HPA
    CR_Manager -->|manages| CronJobs2
    CR_Manager -->|manages| Routes
    CR_Manager -->|manages| ServiceMonitors2
    CR_Manager -->|manages| PDB
    CR_Manager -->|manages| RBACResources
    CR_Manager -->|manages| SparkApps
    CR_Manager -->|reads| Notebooks
    CR_Manager -->|reads| CRDs
    CR_Manager -->|reads| APIServers
    CR_Manager -->|creates| TokenReviews

    %% Metrics role permissions
    CR_Metrics -->|creates| TokenReviews
    CR_Metrics -->|creates| SAR

    %% Leader election role permissions
    R_Leader -->|manages| LEConfigMaps
    R_Leader -->|manages| LELeases
    R_Leader -->|manages| LEEvents

    %% Editor/Viewer roles (for users)
    CR_Editor -->|"full CRUD"| FeatureStores
    CR_Editor -->|reads| FeatureStoresStatus
    CR_Viewer -->|"read-only"| FeatureStores
    CR_Viewer -->|reads| FeatureStoresStatus

