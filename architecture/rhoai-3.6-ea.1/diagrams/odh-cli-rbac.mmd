graph TD
    subgraph "User Credentials"
        UserCreds["User's kubeconfig<br/>(Bearer token / Client cert / OIDC)"]
    end

    subgraph "RBAC Pre-flight (odh-cli)"
        SSAR["SelfSubjectAccessReview<br/>(authorization.k8s.io/v1)"]
    end

    subgraph "Required Cluster Permissions (user-scoped)"
        direction TB

        Note["odh-cli defines NO ClusterRoles/RoleBindings.<br/>All operations use the user's existing RBAC permissions.<br/>The CLI performs SelfSubjectAccessReview pre-flight checks<br/>before privileged operations."]
    end

    subgraph "Kubernetes API Resources Accessed"
        direction TB

        subgraph "Core Resources"
            Namespaces["core/v1<br/>Namespaces"]
            Pods["core/v1<br/>Pods"]
            Services["core/v1<br/>Services"]
            Events["core/v1<br/>Events"]
            ConfigMaps["core/v1<br/>ConfigMaps"]
        end

        subgraph "Apps Resources"
            Deployments["apps/v1<br/>Deployments"]
        end

        subgraph "API Extensions"
            CRDs["apiextensions<br/>CustomResourceDefinitions"]
        end

        subgraph "OLM Resources"
            CSVs["operators.coreos.com<br/>ClusterServiceVersions"]
            Subscriptions["operators.coreos.com<br/>Subscriptions"]
        end

        subgraph "OpenShift Resources"
            Routes["route.openshift.io<br/>Routes"]
        end

        subgraph "Authorization"
            AccessReview["authorization.k8s.io<br/>SelfSubjectAccessReview"]
        end
    end

    subgraph "CLI Operations → Required Verbs"
        Diagnose["diagnose → get, list, watch"]
        StatusCmd["status → get, list"]
        ComponentsCmd["components → get, list"]
        MigrateCmd["migrate → get, list, create, update, delete"]
        EventsCmd["events → get, list, watch"]
        LogsCmd["logs → get, list"]
    end

    UserCreds -->|"authenticates via"| SSAR
    SSAR -->|"checks permissions<br/>before privileged ops"| AccessReview

    UserCreds -->|"authorizes"| Diagnose
    UserCreds -->|"authorizes"| StatusCmd
    UserCreds -->|"authorizes"| ComponentsCmd
    UserCreds -->|"authorizes"| MigrateCmd
    UserCreds -->|"authorizes"| EventsCmd
    UserCreds -->|"authorizes"| LogsCmd

    Diagnose -->|"reads"| Namespaces
    Diagnose -->|"reads"| Pods
    Diagnose -->|"reads"| Deployments
    Diagnose -->|"reads"| CRDs
    StatusCmd -->|"reads"| CSVs
    StatusCmd -->|"reads"| Subscriptions
    MigrateCmd -->|"reads"| Routes
    MigrateCmd -->|"mutates"| ConfigMaps
    EventsCmd -->|"watches"| Events

