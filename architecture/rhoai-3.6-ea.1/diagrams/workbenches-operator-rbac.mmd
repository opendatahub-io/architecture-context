    subgraph "ClusterRoles"
        CR1["workbenches-operator-<br/>manager-role"]
        CR2["workbenches-operator-<br/>manager-rbac-escalate-role"]
    end

    subgraph "Roles (Namespace-scoped)"
        R1["workbenches-operator-<br/>leader-election-role"]
