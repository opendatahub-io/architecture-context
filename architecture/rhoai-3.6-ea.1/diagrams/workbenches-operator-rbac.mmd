    CR1 -->|"full CRUD"| Secrets
    CR1 -->|"full CRUD"| Services
    CR1 -->|"full CRUD"| ServiceAccounts
    CR1 -->|"create, patch"| Events
    CR1 -->|"create, get, list,<br/>patch, update, watch"| Namespaces
    CR1 -->|"full CRUD + finalizers<br/>+ status"| Workbenches
    CR1 -->|"full CRUD"| Notebooks
    CR1 -->|"get"| HardwareProfiles
    CR1 -->|"full CRUD"| ImageStreams
    CR1 -->|"full CRUD"| Deployments
    CR1 -->|"full CRUD"| WebhookConfigs
    CR1 -->|"create, get, list,<br/>patch, update, watch"| CRDs
    CR1 -->|"create"| SAR
    CR1 -->|"full CRUD"| RBACResources
    CR1 -->|"create, get, patch"| CertManagerCRs
    CR1 -->|"get, list, watch"| APIServers

    %% Escalate Role → Resources
    CR2 -->|"bind, escalate"| RBACResources

    %% Leader Election Role → Resources
    R1 -->|"full CRUD"| LEConfigMaps
    R1 -->|"full CRUD"| LELeases
    R1 -->|"create, patch"| LEEvents

    %% Webhook TLS Role → Resources
    R2 -->|"create, get, patch"| Certificates

