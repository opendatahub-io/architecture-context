graph TD
    subgraph "Service Accounts"
        SA_Main["mcp-lifecycle-operator-<br/>controller-manager"]
        SA_Legacy["controller-manager"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["mcp-lifecycle-operator-<br/>manager-rolebinding"]
        CRB_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding"]
        CRB_LegacyMetrics["metrics-auth-rolebinding"]
        CRB_LegacyManager["manager-rolebinding"]
    end

    subgraph "Role Bindings (Namespace-scoped)"
        RB_Leader["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
        RB_LegacyLeader["leader-election-rolebinding<br/>(ns: system)"]
    end

    subgraph "ClusterRoles - Operator Core"
        CR_Manager["mcp-lifecycle-operator-<br/>manager-role"]
        CR_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-role"]
        CR_LegacyManager["manager-role"]
        CR_LegacyMetrics["metrics-auth-role"]
    end

    subgraph "Roles (Namespace-scoped)"
        R_Leader["mcp-lifecycle-operator-<br/>leader-election-role"]
        R_LegacyLeader["leader-election-role"]
    end

    subgraph "ClusterRoles - RBAC Aggregation"
        CR_Admin["mcpserver-admin-role<br/>(aggregate-to-admin)"]
        CR_Editor["mcpserver-editor-role<br/>(aggregate-to-edit)"]
        CR_Viewer["mcpserver-viewer-role<br/>(aggregate-to-view)"]
    end

    subgraph "API Resources - Core"
        ConfigMaps["core<br/>configmaps"]
        Secrets["core<br/>secrets"]
        Pods["core<br/>pods"]
        Services["core<br/>services"]
        Events["events.k8s.io<br/>events"]
    end

    subgraph "API Resources - Apps"
        Deployments["apps<br/>deployments"]
    end

    subgraph "API Resources - MCP"
        MCPServers["mcp.x-k8s.io<br/>mcpservers"]
        MCPFinalizers["mcp.x-k8s.io<br/>mcpservers/finalizers"]
        MCPStatus["mcp.x-k8s.io<br/>mcpservers/status"]
    end

    subgraph "API Resources - Networking"
        NetworkPolicies["networking.k8s.io<br/>networkpolicies"]
    end

    subgraph "API Resources - Auth"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "API Resources - Leader Election"
        Leases["coordination.k8s.io<br/>leases"]
        LEConfigMaps["core<br/>configmaps"]
        LEEvents["core<br/>events"]
    end

    %% Main SA bindings
    SA_Main -->|bound via| CRB_Manager
    SA_Main -->|bound via| CRB_Metrics
    SA_Main -->|bound via| RB_Leader

    %% Legacy SA bindings
    SA_Legacy -->|bound via| CRB_LegacyMetrics
    SA_Legacy -->|bound via| CRB_LegacyManager
    SA_Legacy -->|bound via| RB_LegacyLeader

    %% Binding to role mappings
    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    CRB_LegacyManager -->|grants| CR_LegacyManager
    CRB_LegacyMetrics -->|grants| CR_LegacyMetrics
    RB_Leader -->|grants| R_Leader
    RB_LegacyLeader -->|grants| R_LegacyLeader

    %% Manager role permissions
    CR_Manager -->|"get, list, watch"| ConfigMaps
    CR_Manager -->|"get, list, watch"| Secrets
    CR_Manager -->|"get, list"| Pods
    CR_Manager -->|"create, get, list,<br/>update, watch"| Services
    CR_Manager -->|"create, patch"| Events
    CR_Manager -->|"create, get, list,<br/>update, watch"| Deployments
    CR_Manager -->|"get, list, patch,<br/>update, watch"| MCPServers
    CR_Manager -->|"update"| MCPFinalizers
    CR_Manager -->|"get, patch, update"| MCPStatus
    CR_Manager -->|"create, get, list,<br/>update, watch"| NetworkPolicies

    %% Metrics auth role permissions
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SAR

    %% Leader election role permissions
    R_Leader -->|"CRUD + watch"| LEConfigMaps
    R_Leader -->|"CRUD + watch"| Leases
    R_Leader -->|"create, patch"| LEEvents

    %% Aggregation roles to MCP resources
    CR_Admin -->|"full CRUD +<br/>deletecollection"| MCPServers
    CR_Admin -->|"get"| MCPStatus
    CR_Editor -->|"CRUD"| MCPServers
    CR_Editor -->|"get"| MCPStatus
    CR_Viewer -->|"get, list, watch"| MCPServers
    CR_Viewer -->|"get"| MCPStatus

    style SA_Main fill:#4a90e2,stroke:#333,color:#fff
    style SA_Legacy fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_LegacyManager fill:#f5a623,stroke:#333
    style CR_LegacyMetrics fill:#f5a623,stroke:#333
    style R_Leader fill:#e6b84d,stroke:#333
    style R_LegacyLeader fill:#e6b84d,stroke:#333
    style CR_Admin fill:#ff6b6b,stroke:#333
    style CR_Editor fill:#ffa07a,stroke:#333
    style CR_Viewer fill:#98fb98,stroke:#333
    style MCPServers fill:#7ed321,stroke:#333
    style MCPFinalizers fill:#7ed321,stroke:#333
    style MCPStatus fill:#7ed321,stroke:#333
