graph TD
    subgraph "Service Accounts"
        SA_Main["mcp-lifecycle-operator-<br/>controller-manager"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["mcp-lifecycle-operator-<br/>manager-rolebinding"]
        CRB_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph "Role Bindings (namespace-scoped)"
        RB_Leader["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph "ClusterRoles"
        CR_Manager["mcp-lifecycle-operator-<br/>manager-role"]
        CR_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-role"]
    end

    subgraph "Roles (namespace-scoped)"
        R_Leader["mcp-lifecycle-operator-<br/>leader-election-role"]
    end

    subgraph "RBAC Aggregation ClusterRoles"
        CR_Admin["mcpserver-admin-role<br/>(aggregate-to-admin)"]
        CR_Editor["mcpserver-editor-role<br/>(aggregate-to-edit)"]
        CR_Viewer["mcpserver-viewer-role<br/>(aggregate-to-view)"]
    end

    subgraph "Manager Role Resources"
        direction TB
        ConfigMaps_Secrets["core<br/>configmaps, secrets<br/>get, list, watch"]
        Pods["core<br/>pods<br/>get, list"]
        Services["core<br/>services<br/>create, get, list, update, watch"]
        Events["events.k8s.io<br/>events<br/>create, patch"]
        Deployments["apps<br/>deployments<br/>create, get, list, update, watch"]
        MCPServers["mcp.x-k8s.io<br/>mcpservers<br/>get, list, patch, update, watch"]
        MCPFinalizers["mcp.x-k8s.io<br/>mcpservers/finalizers<br/>update"]
        MCPStatus["mcp.x-k8s.io<br/>mcpservers/status<br/>get, patch, update"]
        NetPolicies["networking.k8s.io<br/>networkpolicies<br/>create, get, list, update, watch"]
    end

    subgraph "Metrics Auth Resources"
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph "Leader Election Resources"
        LE_ConfigMaps["core<br/>configmaps<br/>full CRUD"]
        LE_Leases["coordination.k8s.io<br/>leases<br/>full CRUD"]
        LE_Events["core<br/>events<br/>create, patch"]
    end

    subgraph "Aggregated MCPServer Resources"
        AggMCP_Full["mcp.x-k8s.io<br/>mcpservers<br/>full CRUD + deletecollection"]
        AggMCP_Edit["mcp.x-k8s.io<br/>mcpservers<br/>CRUD (no deletecollection)"]
        AggMCP_View["mcp.x-k8s.io<br/>mcpservers<br/>get, list, watch"]
    end

    %% Bindings
    SA_Main -->|"bound via"| CRB_Manager
    SA_Main -->|"bound via"| CRB_Metrics
    SA_Main -->|"bound via"| RB_Leader

    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_Metrics
    RB_Leader -->|"grants"| R_Leader

    %% Manager permissions
    CR_Manager -->|"permits"| ConfigMaps_Secrets
    CR_Manager -->|"permits"| Pods
    CR_Manager -->|"permits"| Services
    CR_Manager -->|"permits"| Events
    CR_Manager -->|"permits"| Deployments
    CR_Manager -->|"permits"| MCPServers
    CR_Manager -->|"permits"| MCPFinalizers
    CR_Manager -->|"permits"| MCPStatus
    CR_Manager -->|"permits"| NetPolicies

    %% Metrics permissions
    CR_Metrics -->|"permits"| TokenReviews
    CR_Metrics -->|"permits"| SAR

    %% Leader election permissions
    R_Leader -->|"permits"| LE_ConfigMaps
    R_Leader -->|"permits"| LE_Leases
    R_Leader -->|"permits"| LE_Events

    %% Aggregation
    CR_Admin -->|"permits"| AggMCP_Full
    CR_Editor -->|"permits"| AggMCP_Edit
    CR_Viewer -->|"permits"| AggMCP_View

    %% Styling
    style SA_Main fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_Metrics fill:#f5a623,stroke:#333,color:#fff
    style R_Leader fill:#f5a623,stroke:#333,color:#fff
    style CR_Admin fill:#e8e8e8,stroke:#333
    style CR_Editor fill:#e8e8e8,stroke:#333
    style CR_Viewer fill:#e8e8e8,stroke:#333
    style MCPServers fill:#7ed321,stroke:#333,color:#fff
    style MCPFinalizers fill:#7ed321,stroke:#333,color:#fff
    style MCPStatus fill:#7ed321,stroke:#333,color:#fff
