graph TD
    subgraph "Service Accounts (Inferred)"
        SA["kv-cache-manager SA<br/>(provisioned by llm-d operator)"]
    end

    subgraph "Required Permissions (Inferred from Code)"
        direction TB
        Note["No RBAC ClusterRoles or RoleBindings<br/>are defined in this component.<br/><br/>RBAC is provisioned by the parent<br/>llm-d operator at deployment time."]
    end

    subgraph "Kubernetes API Resources Used"
        Pods["/v1/Pod<br/>core API"]
    end

    subgraph "Required Verbs (from PodReconciler)"
        GetPod["get"]
        ListPod["list"]
        WatchPod["watch"]
    end

    subgraph "Authentication Endpoints"
        direction TB
        HTTP["HTTP Scoring API<br/>8080/TCP<br/>Auth: None"]
        gRPCIdx["gRPC IndexerService<br/>Auth: None"]
        gRPCTok["gRPC TokenizationService<br/>Auth: UDS filesystem perms (0700)"]
        ZMQSub["ZMQ Subscriber<br/>5557/TCP<br/>Auth: None"]
    end

    SA -->|"needs"| GetPod
    SA -->|"needs"| ListPod
    SA -->|"needs"| WatchPod
    GetPod -->|"on"| Pods
    ListPod -->|"on"| Pods
    WatchPod -->|"on"| Pods

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style Note fill:#fff2cc,stroke:#d6b656
    style Pods fill:#7ed321,stroke:#333
    style GetPod fill:#dae8fc,stroke:#6c8ebf
    style ListPod fill:#dae8fc,stroke:#6c8ebf
    style WatchPod fill:#dae8fc,stroke:#6c8ebf
    style HTTP fill:#f8cecc,stroke:#b85450
    style gRPCIdx fill:#f8cecc,stroke:#b85450
    style gRPCTok fill:#d5e8d4,stroke:#82b366
    style ZMQSub fill:#f8cecc,stroke:#b85450
