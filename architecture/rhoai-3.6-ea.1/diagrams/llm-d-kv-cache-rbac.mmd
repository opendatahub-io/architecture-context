graph TD
    subgraph "Service Accounts (Inferred)"
        SA_Reconciler["Pod Reconciler SA<br/>(not explicitly defined)"]
        SA_Tokenizer["UDS Tokenizer SA<br/>(KServe pod SA)"]
    end

    subgraph "Required Permissions (Inferred from Behavior)"
        PodWatch["Required: Pod Watch<br/>API: core/v1<br/>Resource: pods<br/>Verbs: get, list, watch"]
    end

    subgraph "Authentication Endpoints"
        direction TB

        HTTP_Score["HTTP Scoring API<br/>Port 8080<br/>/score_completions<br/>/score_chat_completions"]
        HTTP_Metrics["HTTP Metrics<br/>Port 8080<br/>/metrics"]
        GRPC_Indexer["gRPC IndexerService<br/>Port 50051<br/>GetPodScores"]
        UDS_Tokenizer["gRPC TokenizationService<br/>UDS /tmp/tokenizer"]
    end

    subgraph "Auth Status"
        NoAuth["⚠️ No Authentication"]
        PodBoundary["Pod Boundary Isolation"]
        SAToken["ServiceAccount Token"]
    end

    SA_Reconciler -->|"needs"| PodWatch
    SA_Reconciler -->|"authenticates via"| SAToken

    HTTP_Score -->|"auth mechanism"| NoAuth
    HTTP_Metrics -->|"auth mechanism"| NoAuth
    GRPC_Indexer -->|"auth mechanism"| NoAuth
    UDS_Tokenizer -->|"auth mechanism"| PodBoundary

    subgraph "Secrets"
        ENV_TokenizersDir["TOKENIZERS_DIR<br/>Type: env var<br/>Purpose: Python app config"]
        RedisURL["Redis/Valkey URL<br/>Type: connection string<br/>Contains: credentials<br/>⚠️ No K8s Secret documented"]
    end

    subgraph "Notes"
        Note1["No ClusterRoles defined<br/>in architecture doc"]
        Note2["No RoleBindings defined<br/>in architecture doc"]
        Note3["RBAC likely configured<br/>externally or via Helm/OLM"]
    end

    %% Styling
    style NoAuth fill:#ffcdd2,stroke:#c62828,color:#000
    style PodBoundary fill:#c8e6c9,stroke:#2e7d32,color:#000
    style SAToken fill:#c8e6c9,stroke:#2e7d32,color:#000
    style HTTP_Score fill:#fff3e0,stroke:#e65100
    style HTTP_Metrics fill:#fff3e0,stroke:#e65100
    style GRPC_Indexer fill:#fff3e0,stroke:#e65100
    style UDS_Tokenizer fill:#e8f5e9,stroke:#2e7d32
    style PodWatch fill:#e3f2fd,stroke:#1565c0
    style RedisURL fill:#ffcdd2,stroke:#c62828
    style Note1 fill:#f5f5f5,stroke:#999
    style Note2 fill:#f5f5f5,stroke:#999
    style Note3 fill:#f5f5f5,stroke:#999
