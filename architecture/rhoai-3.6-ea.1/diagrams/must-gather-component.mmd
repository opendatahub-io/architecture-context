graph TB
    subgraph MustGather["must-gather Container Image"]
        direction TB
        Entrypoint["/usr/bin/gather<br/>Main Entrypoint"]
        DistDetect["Distribution Detection<br/>(xks_util.sh)"]
        CommonUtils["Common Utilities<br/>(common.sh)"]

        Entrypoint -->|detects cluster type| DistDetect
        Entrypoint -->|uses| CommonUtils

        subgraph Collectors["Parallel Collection Scripts"]
            direction LR
            DSP["gather_data_science_pipelines"]
            KServe["gather_kserve"]
            ModelReg["gather_model_registry"]
            Workbenches["gather_workbenches"]
            KubeRay["gather_kuberay"]
            Kueue["gather_kueue"]
            Training["gather_training_operator"]
            TrustyAI["gather_trustyai"]
            Feast["gather_feast"]
            MLflow["gather_mlflow"]
            Spark["gather_spark"]
            AIGateway["gather_ai_gateway"]
            MCP["gather_mcp_lifecycle"]
            OGX["gather_ogx"]
            LLMD["gather_llm_d"]
        end

        Entrypoint -->|dispatches parallel| Collectors
    end

    SRE[SRE / Support Engineer] -->|"oc adm must-gather<br/>--image=must-gather-image"| OC[oc adm must-gather Framework]
    OC -->|launches pod with kubeconfig| Entrypoint

    subgraph ClusterResources["Kubernetes Cluster Resources"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS"]
        Namespaces["Component Namespaces"]
        CRDs["Platform CRDs<br/>(DSCi, DSC, Components)"]
        PodLogs["Pod Logs"]
    end

    Collectors -->|"oc adm inspect / kubectl get"| K8sAPI
    K8sAPI --> Namespaces
    K8sAPI --> CRDs
    K8sAPI --> PodLogs

    Output["/must-gather/<br/>Collected Artifacts"]
    Collectors -->|writes to| Output
    Output -->|copied back to| SRE

    style MustGather fill:#4a90e2,stroke:#333,color:#fff
    style Entrypoint fill:#2c5f8a,stroke:#333,color:#fff
    style DistDetect fill:#2c5f8a,stroke:#333,color:#fff
    style CommonUtils fill:#2c5f8a,stroke:#333,color:#fff
    style Collectors fill:#e8f0fe,stroke:#4a90e2
