graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["HTTP Client<br/>(Data Scientist / SDK)"]
    end

    subgraph Application["APPLICATION (MLflow Tracking Server)"]
        direction TB

        subgraph Server["Server Layer"]
            Gunicorn["Gunicorn / Uvicorn<br/>Port 5000/TCP<br/>UBI9 Minimal + Python 3.12"]
        end

        subgraph Auth["Authentication Layer"]
            AuthPlugin["kubernetes-auth Plugin<br/>mlflow-kubernetes-plugins 1.5.0<br/>Kubernetes-delegated AuthN"]
        end

        subgraph Handlers["API Handlers"]
            TrackingAPI["Tracking API<br/>/ajax-api/3.0/mlflow/*"]
            ModelRegistryAPI["Model Registry API<br/>/{name}/versions/*"]
            ArtifactAPI["Artifact Serving<br/>--serve-artifacts"]
        end

        Gunicorn --> AuthPlugin
        AuthPlugin --> TrackingAPI
        AuthPlugin --> ModelRegistryAPI
        AuthPlugin --> ArtifactAPI
    end

    subgraph InternalServices["INTERNAL CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>ServiceAccount Token"]
        SQLBackend["SQL Backend Store<br/>SQLAlchemy<br/>Database-specific encryption"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        S3["AWS S3<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM Credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>TLS<br/>GCP Service Account"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>TLS<br/>Azure Identity / SAS"]
        OpenAI["api.openai.com<br/>443/TCP HTTPS<br/>TLS<br/>OPENAI_API_KEY<br/>(disabled in RHOAI)"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS<br/>Port 5000<br/>kubernetes-auth"| Gunicorn
    AuthPlugin -->|"HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI
    TrackingAPI -->|"SQL Protocol<br/>Configurable"| SQLBackend
    ArtifactAPI -->|"HTTPS/443<br/>TLS<br/>boto3 SDK"| S3
    ArtifactAPI -->|"HTTPS/443<br/>TLS<br/>GCS SDK"| GCS
    ArtifactAPI -->|"HTTPS/443<br/>TLS<br/>Azure SDK"| Azure

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    classDef auth fill:#fecaca,stroke:#ef4444,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef disabled fill:#e5e7eb,stroke:#9ca3af,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Gunicorn application
    class AuthPlugin auth
    class TrackingAPI,ModelRegistryAPI,ArtifactAPI application
    class K8sAPI,SQLBackend internal
    class S3,GCS,Azure externalservice
    class OpenAI disabled
