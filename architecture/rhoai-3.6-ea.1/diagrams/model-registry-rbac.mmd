graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-controller-manager"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["controller-model-registry-<br/>manager-rolebinding<br/>(system namespace)"]
        CRB_Metrics["controller-metrics-auth-<br/>rolebinding<br/>(system namespace)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["controller-leader-election-<br/>rolebinding<br/>(kubeflow namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["controller-model-registry-<br/>manager-role"]
        CR_Metrics["controller-metrics-auth-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["controller-leader-election-role<br/>(kubeflow namespace)"]
    end

    subgraph CoreResources["Core API Resources"]
        Services["(core)<br/>services"]
        ConfigMaps["(core)<br/>configmaps"]
        Events["(core)<br/>events"]
    end

    subgraph KServeResources["serving.kserve.io Resources"]
        IS["serving.kserve.io<br/>inferenceservices"]
        ISFinalizers["serving.kserve.io<br/>inferenceservices/finalizers"]
    end

    subgraph CoordinationResources["coordination.k8s.io Resources"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    %% SA to Bindings
    SA -->|"bound via"| CRB_Manager
    SA -->|"bound via"| CRB_Metrics
    SA -->|"bound via"| RB_Leader

    %% Bindings to Roles
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_Metrics
    RB_Leader -->|"grants"| R_Leader

    %% Manager Role Permissions
    CR_Manager -->|"get, list, watch"| Services
    CR_Manager -->|"get, list, patch,<br/>update, watch"| IS
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| ISFinalizers

    %% Metrics Auth Role Permissions
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SAR

    %% Leader Election Role Permissions
    R_Leader -->|"create, delete, get,<br/>list, patch, update, watch"| ConfigMaps
    R_Leader -->|"create, delete, get,<br/>list, patch, update, watch"| Leases
    R_Leader -->|"create, patch"| Events

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff
    style CRB_Manager fill:#dae8fc,stroke:#6c8ebf
    style CRB_Metrics fill:#dae8fc,stroke:#6c8ebf
    style RB_Leader fill:#dae8fc,stroke:#6c8ebf
    style Services fill:#7ed321,color:#fff
    style ConfigMaps fill:#7ed321,color:#fff
    style Events fill:#7ed321,color:#fff
    style IS fill:#7ed321,color:#fff
    style ISFinalizers fill:#7ed321,color:#fff
    style Leases fill:#7ed321,color:#fff
    style TokenReviews fill:#e8e8e8
    style SAR fill:#e8e8e8
