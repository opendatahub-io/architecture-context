graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA["controller-controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["controller-model-registry-<br/>manager-rolebinding<br/>(ns: system)"]
        CRB_Metrics["controller-metrics-auth-<br/>rolebinding<br/>(ns: system)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["controller-leader-election-<br/>rolebinding<br/>(ns: kubeflow)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["controller-model-registry-<br/>manager-role"]
        CR_Metrics["controller-metrics-auth-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["controller-leader-election-role<br/>(ns: kubeflow)"]
    end

    subgraph CoreResources["Core API Resources"]
        Services["(core)<br/>services"]
        ConfigMaps["(core)<br/>configmaps"]
        Events["(core)<br/>events"]
    end

    subgraph KServeResources["KServe API Resources"]
        IS["serving.kserve.io<br/>inferenceservices"]
        ISFinalizers["serving.kserve.io<br/>inferenceservices/finalizers"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph CoordinationResources["Coordination Resources"]
        Leases["coordination.k8s.io<br/>leases"]
    end

    %% SA → Bindings
    SA -->|bound via| CRB_Manager
    SA -->|bound via| CRB_Metrics
    SA -->|bound via| RB_Leader

    %% Bindings → Roles
    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics
    RB_Leader -->|grants| R_Leader

    %% Manager Role → Resources
    CR_Manager -->|"get, list, watch"| Services
    CR_Manager -->|"get, list, patch,<br/>update, watch"| IS
    CR_Manager -->|"create, delete, get,<br/>list, patch, update, watch"| ISFinalizers

    %% Metrics Role → Resources
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SAR

    %% Leader Election Role → Resources
    R_Leader -->|"create, delete, get, list,<br/>patch, update, watch"| ConfigMaps
    R_Leader -->|"create, delete, get, list,<br/>patch, update, watch"| Leases
    R_Leader -->|"create, patch"| Events

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style CRB_Manager fill:#e8e8e8,stroke:#333
    style CRB_Metrics fill:#e8e8e8,stroke:#333
    style RB_Leader fill:#e8e8e8,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
    style IS fill:#7ed321,stroke:#333
    style ISFinalizers fill:#7ed321,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style Leases fill:#7ed321,stroke:#333
