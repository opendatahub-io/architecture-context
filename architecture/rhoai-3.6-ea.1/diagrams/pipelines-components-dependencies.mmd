graph LR
    PC["pipelines-components<br/>(KFP Component Library +<br/>Init Container)"]

    %% Internal RHOAI Dependencies
    PC -->|"pipeline orchestration<br/>kfp >=2.16.1"| KFP["Kubeflow Pipelines SDK"]
    PC -->|"pipeline k8s extensions<br/>kfp-kubernetes >=2.16.1"| KFPK8s["kfp-kubernetes"]
    PC -->|"distributed jobs<br/>CodeFlare SDK"| CodeFlare["CodeFlare SDK"]

    %% Platform Dependencies
    PC -->|"resource CRUD<br/>kubernetes ==36.0.3"| K8sAPI["Kubernetes API<br/>(Python client)"]

    %% External Service Dependencies
    PC -->|"object storage<br/>boto3 >=1.42.0"| S3["S3-Compatible Storage<br/>(AWS SDK)"]
    PC -->|"dataset download<br/>huggingface-hub >=0.23.0"| HFHub["HuggingFace Hub"]
    PC -->|"cloud storage<br/>google-cloud-storage ==3.13.0"| GCS["Google Cloud Storage"]

    %% ML/AI Libraries
    PC -->|"data processing"| Pandas["pandas >=2.0"]
    PC -->|"numerical compute"| NumPy["numpy"]
    PC -->|"document parsing"| Docling["docling"]
    PC -->|"text splitting"| LangChain["langchain-text-splitters"]
    PC -->|"synthetic data"| SDGHub["sdg-hub >=0.7.0"]
    PC -->|"RAG optimization"| AI4RAG["ai4rag ==0.10.3"]

    %% Security / Crypto
    PC -->|"TLS/crypto<br/>system OpenSSL"| Crypto["cryptography ==49.0.0"]

    %% Build-Time Dependencies
    PC -.->|"linting"| Ruff["ruff ==0.15.2"]
    PC -.->|"testing"| Pytest["pytest"]

    %% Supply Chain
    PC -.->|"base image"| UBI9["UBI9/python-312<br/>(digest-pinned)"]
    PC -.->|"curated index"| RHAI["RHAI PyPI Index<br/>(hash-pinned deps)"]

    %% Downstream consumers
    KFPServer["KFP API Server"] -->|"mounts managed<br/>pipeline YAMLs"| PC

    %% Styling
    style PC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KFP fill:#7ed321,stroke:#333
