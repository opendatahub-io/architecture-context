graph LR
    PC["pipelines-components<br/>(Init Container + KFP Library)"]

    %% Internal RHOAI Dependencies
    PC -->|"stages YAMLs<br/>(shared volume)"| KFPAPI["KFP API Server"]
    PC -->|"pipeline definition<br/>kfp >=2.16.1"| KFPSDK["Kubeflow Pipelines SDK"]
    PC -->|"k8s resources<br/>kubernetes ==36.0.3"| K8sSDK["Kubernetes Python SDK"]
    PC -->|"distributed jobs<br/>CodeFlare SDK"| CodeFlare["CodeFlare SDK"]
    PC -->|"model evaluation"| KServe["KServe<br/>Inference Runtime"]
    PC -->|"model registration"| ModelRegistry["Kubeflow<br/>Model Registry"]

    %% External Service Dependencies
    PC -->|"dataset/artifact storage<br/>boto3 >=1.42.0"| S3["S3-Compatible<br/>Storage"]
    PC -->|"model downloads<br/>huggingface-hub >=0.23.0"| HFHub["HuggingFace Hub"]

    %% Build/Runtime Infrastructure
    PC -->|"base image"| UBI9["UBI9<br/>python-312"]
    PC -->|"pip packages"| RHAI["RHAI PyPI<br/>(supply chain)"]
    PC -->|"k8s extensions<br/>kfp-kubernetes >=2.16.1"| KFPKube["kfp-kubernetes"]

    %% Key Library Dependencies
    PC -->|"document processing"| DocProc["docling<br/>ai4rag ==0.10.3"]
    PC -->|"data processing"| DataProc["pandas >=2.0<br/>numpy"]
    PC -->|"TLS/crypto"| Crypto["cryptography ==49.0.0<br/>(delegates to OpenSSL)"]
    PC -->|"cloud storage"| GCS["google-cloud-storage<br/>==3.13.0"]
    PC -->|"synthetic data"| SDGHub["sdg-hub >=0.7.0"]

    %% Reverse dependencies (who depends on this component)
    KFPAPI -.->|"reads managed<br/>pipeline YAMLs"| PC

    %% Styling
    style PC fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KFPAPI fill:#7ed321,stroke:#333,color:#fff
    style KFPSDK fill:#7ed321,stroke:#333,color:#fff
    style K8sSDK fill:#7ed321,stroke:#333,color:#fff
    style CodeFlare fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style ModelRegistry fill:#7ed321,stroke:#333,color:#fff
    style KFPKube fill:#7ed321,stroke:#333,color:#fff
    style S3 fill:#f5a623,stroke:#333,color:#fff
    style HFHub fill:#f5a623,stroke:#333,color:#fff
    style UBI9 fill:#999,stroke:#333,color:#fff
    style RHAI fill:#999,stroke:#333,color:#fff
    style DocProc fill:#e8e8e8,stroke:#333
    style DataProc fill:#e8e8e8,stroke:#333
    style Crypto fill:#e8e8e8,stroke:#333
    style GCS fill:#e8e8e8,stroke:#333
    style SDGHub fill:#e8e8e8,stroke:#333
