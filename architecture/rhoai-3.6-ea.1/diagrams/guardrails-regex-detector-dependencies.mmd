graph LR
    GRD["guardrails-regex-detector<br/>(Rust Service)"]

    %% Runtime Framework Dependencies
    GRD -->|"web framework"| Axum["axum 0.7.9"]
    GRD -->|"async runtime"| Tokio["tokio 1.41.1"]
    GRD -->|"HTTP middleware"| TowerHTTP["tower-http 0.6.2"]

    %% Core Functionality Dependencies
    GRD -->|"pattern matching"| Regex["regex 1.11.1"]
    GRD -->|"JSON serialization"| Serde["serde 1.0.215"]
    GRD -->|"JSON parsing"| SerdeJSON["serde_json 1.0.133"]

    %% Observability Dependencies
    GRD -->|"tracing"| Tracing["tracing 0.1.41"]
    GRD -->|"log subscriber"| TracingSub["tracing-subscriber 0.3.19"]

    %% Upstream Callers
    Orchestrator["Guardrails Orchestrator"] -->|"POST /api/v1/text/contents<br/>HTTP/8080"| GRD

    %% Platform Dependencies
    K8s["Kubernetes"] -.->|"health probes<br/>network isolation"| GRD

    style GRD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Axum fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style TowerHTTP fill:#999,stroke:#333
    style Regex fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style SerdeJSON fill:#999,stroke:#333
    style Tracing fill:#999,stroke:#333
    style TracingSub fill:#999,stroke:#333
    style Orchestrator fill:#f5a623,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
