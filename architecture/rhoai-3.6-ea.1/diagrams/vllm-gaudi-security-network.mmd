graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client Application"]
    end

    subgraph Platform["PLATFORM SERVING LAYER (KServe)"]
        KServe["KServe ServingRuntime<br/>TLS termination & auth<br/>Ingress routing & autoscaling"]
    end

    subgraph Container["CONTAINER (vllm-gaudi)"]
        direction TB

        APIServer["vLLM OpenAI API Server<br/>:8000/TCP HTTP<br/>No TLS at container level<br/>Auth delegated to platform"]

        subgraph Plugin["vllm_gaudi Plugin"]
            HPUWorker["HPU Workers"]
            SynapseAI["SynapseAI Runtime"]
        end

        APIServer --> HPUWorker
        HPUWorker --> SynapseAI
    end

    subgraph BaseImage["BASE IMAGE"]
        UBI9["UBI 9<br/>registry.access.redhat.com/ubi9/ubi<br/>FIPS provider REMOVED"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        ModelStorage["Model Storage<br/>(S3 / PVC / configured at startup)<br/>Auth: storage-dependent"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS<br/>Platform-managed TLS<br/>Platform-managed auth"| KServe
    KServe -->|"HTTP/8000<br/>mTLS (if mesh enabled)<br/>Service Identity"| APIServer
    HPUWorker -.->|"Model loading at startup<br/>Protocol: storage-dependent<br/>Auth: storage-dependent"| ModelStorage

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef container fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef plugin fill:#c8e6c9,stroke:#66bb6a,stroke-width:1px
    classDef baseimage fill:#ffcdd2,stroke:#e53935,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcdd2,stroke:#e53935,stroke-width:2px

    class Client external
    class KServe platform
    class APIServer container
    class HPUWorker,SynapseAI plugin
    class UBI9 warning
    class ModelStorage externalservice
