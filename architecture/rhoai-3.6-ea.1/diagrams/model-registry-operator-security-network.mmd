graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph IngressLayer["INGRESS LAYER"]
        Route["{registry-name}-https<br/>OpenShift Route<br/>HTTPS TLS<br/>Host: {registry-name}-rest.{domain}"]
        GWRoute["Gateway API HTTPRoute<br/>model-registry-{registry-name}<br/>via data-science-gateway"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER (Per-Instance)"]
        KubeRBAC["kube-rbac-proxy Sidecar<br/>8443/TCP HTTPS<br/>TLS cert: {registry-name}-kube-rbac-proxy<br/>Auth: SubjectAccessReview"]
    end

    subgraph AppLayer["APPLICATION LAYER"]
        direction TB

        subgraph RegistryPod["Registry Instance Pod"]
            RestContainer["rest-container<br/>8080/TCP HTTP"]
        end

        subgraph PostgresPod["PostgreSQL Pod"]
            Postgres["{registry-name}-postgres<br/>5432/TCP PostgreSQL<br/>Secret: {registry-name}-postgres-credentials"]
        end

        subgraph CatalogPod["Model Catalog Pod"]
            CatalogContainer["catalog container<br/>8080/TCP HTTP"]
            CatalogProxy["kube-rbac-proxy<br/>8443/TCP HTTPS"]
        end

        subgraph CatalogDB["Catalog PostgreSQL Pod"]
            CatalogPostgres["model-catalog-postgres<br/>5432/TCP PostgreSQL<br/>Secret: model-catalog-postgres"]
        end
    end

    subgraph ControlPlane["OPERATOR CONTROL PLANE"]
        Operator["controller-manager<br/>SA: model-registry-operator-controller-manager<br/>8081/TCP health (unauth)<br/>8443/TCP metrics (kube-rbac-proxy)<br/>9443/TCP webhooks (TLS)"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        IngressConfig["config.openshift.io/v1/Ingress<br/>Cluster domain discovery"]
        DSGateway["data-science-gateway<br/>Gateway API"]
        SVMigration["StorageVersionMigration<br/>migration.k8s.io<br/>CRD version migration"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Route
    Client -->|"HTTPS<br/>TLS<br/>Bearer Token"| GWRoute

    %% Ingress to auth
    Route -->|"HTTPS/8443<br/>TLS"| KubeRBAC
    GWRoute -->|"HTTPS/8443<br/>TLS"| KubeRBAC

    %% Auth check
    KubeRBAC -->|"SubjectAccessReview<br/>services:get check"| K8sAPI

    %% Auth to app
    KubeRBAC -->|"HTTP/8080<br/>pod-internal<br/>authorized"| RestContainer

    %% App to DB
    RestContainer -->|"PostgreSQL/5432<br/>credentials secret"| Postgres

    %% Catalog flows
    CatalogProxy -->|"HTTP/8080<br/>pod-internal"| CatalogContainer
    CatalogContainer -->|"PostgreSQL/5432<br/>credentials secret"| CatalogPostgres

    %% Operator flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Operator -->|"reads"| IngressConfig
    Operator -->|"creates HTTPRoutes"| DSGateway
    Operator -->|"creates"| SVMigration

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route,GWRoute ingress
    class KubeRBAC auth
    class RestContainer,Postgres,CatalogContainer,CatalogProxy,CatalogPostgres app
    class Operator controlplane
    class K8sAPI,IngressConfig,DSGateway,SVMigration platform
