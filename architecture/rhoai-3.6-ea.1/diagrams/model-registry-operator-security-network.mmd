graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS LAYER"]
        direction LR
        HTTPRoute["Gateway API HTTPRoute<br/>/model-registry/{name}/<br/>→ data-science-gateway"]
        OSRoute["OpenShift Route<br/>{name}-rest.{domain}<br/>TLS Terminated"]
    end

    subgraph AppLayer["APPLICATION LAYER (Namespace: {registry-namespace})"]
        direction TB

        subgraph RegistryPod["Pod: {registry-name}"]
            KubeProxy["kube-rbac-proxy<br/>:8443/TCP HTTPS<br/>SubjectAccessReview Auth<br/>TLS from Secret"]
            RestContainer["rest-container<br/>:8080/TCP HTTP<br/>SA: {registry-name}"]
        end

        subgraph RegistryDB["Pod: {registry-name}-postgres"]
            Postgres["PostgreSQL<br/>:5432/TCP<br/>Creds: Secret/{name}-postgres-credentials"]
        end

        subgraph CatalogPod["Pod: model-catalog"]
            CatalogProxy["kube-rbac-proxy<br/>:8443/TCP HTTPS<br/>SubjectAccessReview Auth"]
            CatalogSvc["catalog<br/>:8080/TCP HTTP<br/>SA: model-catalog"]
        end

        subgraph CatalogDB["Pod: model-catalog-postgres"]
            CatalogPostgres["PostgreSQL<br/>:5432/TCP<br/>Creds: Secret/model-catalog-postgres"]
        end

        NetworkPolicy["NetworkPolicy<br/>(per registry instance)"]
    end

    subgraph OperatorNS["OPERATOR CONTROL PLANE (model-registry-operator-system)"]
        Operator["controller-manager<br/>:8081 health (no auth)<br/>:8443 metrics (kube-rbac-proxy)<br/>SA: model-registry-operator-controller-manager<br/>Webhooks: /convert, /mutate, /validate"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>:6443/TCP HTTPS<br/>SA Token Auth<br/>SubjectAccessReview"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| HTTPRoute
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| OSRoute

    %% Ingress to app
    HTTPRoute -->|"HTTPS/8443<br/>TLS<br/>Path rewrite"| KubeProxy
    OSRoute -->|"HTTPS/8443<br/>TLS reencrypt"| KubeProxy

    %% Internal proxy flow
    KubeProxy -->|"HTTP/loopback<br/>127.0.0.1<br/>Pre-authorized"| RestContainer

    %% Database
    RestContainer -->|"PostgreSQL/5432<br/>TLS optional<br/>Password auth"| Postgres

    %% Catalog flows
    CatalogProxy -->|"HTTP/loopback<br/>127.0.0.1"| CatalogSvc
    CatalogSvc -->|"PostgreSQL/5432<br/>Password auth"| CatalogPostgres

    %% Auth check
    KubeProxy -->|"SubjectAccessReview<br/>HTTPS/6443"| APIServer
    CatalogProxy -->|"SubjectAccessReview<br/>HTTPS/6443"| APIServer

    %% Operator flows
    Operator -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    %% Admission webhooks
    APIServer -->|"HTTPS<br/>Admission Webhook<br/>TLS"| Operator

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef database fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class HTTPRoute,OSRoute ingress
    class RestContainer,CatalogSvc app
    class KubeProxy,CatalogProxy security
    class Postgres,CatalogPostgres database
    class Operator operator
    class APIServer k8s
