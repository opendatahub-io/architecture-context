graph LR
    GD["guardrails-detectors<br/>(3 detector microservices)"]

    %% Internal Platform Dependencies
    GD -->|"ServingRuntime CRD<br/>serving.kserve.io/v1alpha1"| KServe["KServe<br/>Model Serving Platform"]
    GD -->|"HTTP/8080<br/>vllm-judge library<br/>VLLM_BASE_URL"| vLLM["vLLM Inference Server"]
    GD -->|"S3/HTTP 9000<br/>Model loading at startup"| MinIO["MinIO Storage<br/>minio-guardrails-guardian"]

    %% Key Runtime Dependencies
    GD -->|"ASGI server"| Uvicorn["uvicorn 0.34.0"]
    GD -->|"web framework"| FastAPI["FastAPI 0.136.3"]
    GD -->|"HTTP client"| HTTPX["httpx 0.28.1"]
    GD -->|"metrics"| PromClient["prometheus-client 0.25.0"]
    GD -->|"validation"| Pydantic["pydantic 2.13.4"]

    %% Upstream Consumers
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>POST /api/v1/text/generation"| GD
    Prometheus["Prometheus"] -.->|"GET /metrics<br/>GET /api/v1/metrics"| GD

