graph LR
    GD["Guardrails Detectors<br/>(3 detector variants)"]

    %% Internal Platform Dependencies
    GD -->|"HTTP POST<br/>content evaluation<br/>VLLM_BASE_URL"| vLLM["vLLM Inference Server"]
    GD -->|"TCP 9000<br/>model artifacts"| MinIO["MinIO Storage<br/>ClusterIP 9000/TCP"]

    %% Runtime Framework Dependencies
    GD -->|"ASGI server"| Uvicorn["uvicorn 0.34.0"]
    GD -->|"web framework"| FastAPI["FastAPI 0.136.3"]
    GD -->|"validation"| Pydantic["Pydantic 2.13.4"]
    GD -->|"HTTP client"| HTTPX["httpx 0.28.1"]

    %% Observability Dependencies
    GD -->|"metrics"| PromClient["prometheus-client 0.25.0"]
    GD -->|"auto-instrumentation"| PromFastAPI["prometheus-fastapi-<br/>instrumentator 8.0.0"]

    %% Upstream Caller (Integration Point)
    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"HTTP POST 8080/TCP<br/>/api/v1/text/contents<br/>/api/v1/text/generation"| GD

    %% KServe Integration
    KServe["KServe<br/>serving.kserve.io"] -.->|"ServingRuntime<br/>management"| GD

    %% Base Image
    GD -.->|"base image"| AIPCC["AIPCC CPU Base<br/>quay.io/aipcc/<br/>base-images/cpu:3.5.0"]

    %% Styling
    style GD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style vLLM fill:#f5a623,stroke:#333
    style MinIO fill:#f5a623,stroke:#333
    style Orchestrator fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style Uvicorn fill:#999,stroke:#333
    style FastAPI fill:#999,stroke:#333
    style Pydantic fill:#999,stroke:#333
    style HTTPX fill:#999,stroke:#333
    style PromClient fill:#999,stroke:#333
    style PromFastAPI fill:#999,stroke:#333
    style AIPCC fill:#e8e8e8,stroke:#333
