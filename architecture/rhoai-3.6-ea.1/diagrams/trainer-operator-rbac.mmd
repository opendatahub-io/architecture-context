graph TD
    subgraph "Service Accounts"
        SA_Manager["trainer-operator-<br/>controller-manager"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["trainer-operator-<br/>manager-rolebinding"]
    end

    subgraph "ClusterRoles"
        CR_Manager["trainer-operator-<br/>manager-role"]
        CR_Admin["trainer-operator-<br/>trainer-admin-role"]
        CR_Viewer["trainer-operator-<br/>trainer-viewer-role"]
    end

    subgraph "Core API Resources"
        ConfigMaps["core<br/>ConfigMaps, Services"]
        Namespaces["core<br/>Namespaces, Secrets"]
        Pods["core<br/>Pods"]
        ServiceAccounts["core<br/>ServiceAccounts"]
        LimitRanges["core<br/>LimitRanges"]
    end

    subgraph "Trainer Resources"
        Trainers["components.platform.opendatahub.io<br/>Trainers"]
        TrainersStatus["components.platform.opendatahub.io<br/>Trainers/status"]
        TrainersFinalizers["components.platform.opendatahub.io<br/>Trainers/finalizers"]
    end

    subgraph "Kubeflow Trainer Resources"
        TrainJobs["trainer.kubeflow.org<br/>TrainJobs"]
        TrainingRuntimes["trainer.kubeflow.org<br/>TrainingRuntimes"]
        ClusterTrainingRuntimes["trainer.kubeflow.org<br/>ClusterTrainingRuntimes"]
    end

    subgraph "Infrastructure Resources"
        Deployments["apps<br/>Deployments"]
        CRDs["apiextensions.k8s.io<br/>CRDs"]
        Webhooks["admissionregistration.k8s.io<br/>Webhooks"]
        RBAC_Res["rbac.authorization.k8s.io<br/>Roles, Bindings"]
        NetworkPolicies["networking.k8s.io<br/>NetworkPolicies"]
        Leases["coordination.k8s.io<br/>Leases"]
    end

    subgraph "OpenShift Resources"
        ImageStreams["image.openshift.io<br/>ImageStreams"]
        JobSetOps["operator.openshift.io<br/>JobSetOperators"]
        ClusterVersions["config.openshift.io<br/>APIServers, ClusterVersions"]
    end

    subgraph "Scheduling & Monitoring"
        PodMonitors["monitoring.coreos.com<br/>PodMonitors"]
        PodGroups["scheduling.volcano.sh<br/>scheduling.x-k8s.io<br/>PodGroups"]
        Events["events.k8s.io<br/>Events"]
    end

    %% Bindings
    SA_Manager -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager

    %% Manager role permissions
    CR_Manager -->|"CRUD + watch"| ConfigMaps
    CR_Manager -->|"CRUD + watch"| Namespaces
    CR_Manager -->|"get, list"| Pods
    CR_Manager -->|"CRUD + watch"| ServiceAccounts
    CR_Manager -->|"get, list, watch"| LimitRanges
    CR_Manager -->|"get, list, patch,<br/>update, watch"| Trainers
    CR_Manager -->|"get, patch, update"| TrainersStatus
    CR_Manager -->|"update"| TrainersFinalizers
    CR_Manager -->|"CRUD + watch"| TrainJobs
    CR_Manager -->|"CRUD + watch"| TrainingRuntimes
    CR_Manager -->|"CRUD + watch"| ClusterTrainingRuntimes
    CR_Manager -->|"CRUD + watch"| Deployments
    CR_Manager -->|"CRUD + watch"| CRDs
    CR_Manager -->|"CRUD + watch"| Webhooks
    CR_Manager -->|"CRUD + watch"| RBAC_Res
    CR_Manager -->|"CRUD + watch"| NetworkPolicies
    CR_Manager -->|"create, get,<br/>list, update"| Leases
    CR_Manager -->|"CRUD + watch"| ImageStreams
    CR_Manager -->|"get, list, watch"| JobSetOps
    CR_Manager -->|"get"| ClusterVersions
    CR_Manager -->|"CRUD + watch"| PodMonitors
    CR_Manager -->|"CRUD + watch"| PodGroups
    CR_Manager -->|"create, patch,<br/>update, watch"| Events

    %% Admin role
    CR_Admin -->|"full CRUD"| Trainers
    CR_Admin -->|"get"| TrainersStatus

    %% Viewer role
    CR_Viewer -->|"get, list, watch"| Trainers
    CR_Viewer -->|"get"| TrainersStatus

    style SA_Manager fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Admin fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style CRB_Manager fill:#e8e8e8
    style Trainers fill:#7ed321,color:#fff
    style TrainersStatus fill:#7ed321,color:#fff
    style TrainersFinalizers fill:#7ed321,color:#fff
    style TrainJobs fill:#7ed321,color:#fff
    style TrainingRuntimes fill:#7ed321,color:#fff
