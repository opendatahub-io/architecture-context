graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Prometheus["Prometheus Scraper"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph ControllerPod["mlflow-operator-controller-manager"]
            direction TB
            MetricsEP[":8443/metrics<br/>HTTPS, TLS (self-signed)<br/>TokenReview + SAR"]
            HealthEP[":8081/healthz<br/>HTTP, No auth"]
            ReadyEP[":8081/readyz<br/>HTTP, No auth"]
        end

        MetricsSvc["metrics-service<br/>ClusterIP 8443/TCP"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        direction TB
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]

        subgraph WatchedCRDs["Watched CRDs"]
            MLflowCRD["MLflow<br/>(mlflow.opendatahub.io/v1)"]
            MLflowOpCRD["MLflowOperator<br/>(components.platform.opendatahub.io/v1alpha1)"]
            MLflowConfigCRD["MLflowConfig<br/>(mlflow.kubeflow.org/v1)"]
        end

        APIServer["apiservers.config.openshift.io<br/>(TLS Profile Source)"]
    end

    subgraph ConditionalCRDs["CONDITIONAL INTEGRATIONS (CRD Discovery)"]
        GatewayAPI["Gateway API<br/>HTTPRoute"]
        PromOp["prometheus-operator<br/>ServiceMonitor"]
        Console["OpenShift Console<br/>ConsoleLink"]
    end

    subgraph ManagedNS["MANAGED NAMESPACE (user namespace)"]
        MLflowDeploy["MLflow Tracking Server<br/>Deployment + Service"]
        ManagedSA["ServiceAccount"]
        PVC["PersistentVolumeClaim"]
        NetPol["NetworkPolicy"]
        MigrationJob["Migration Job/CronJob"]
        ArtifactSecret["mlflow-artifact-connection<br/>Secret (resourceNames-scoped)"]
    end

    subgraph Probes["KUBELET"]
        Kubelet["Kubelet"]
    end

    %% External flows
    Prometheus -->|"HTTPS/8443<br/>TLS (self-signed)<br/>TokenReview + SAR"| MetricsSvc
    MetricsSvc -->|"8443/TCP"| MetricsEP

    %% Probe flows
    Kubelet -->|"HTTP/8081<br/>No encryption<br/>No auth"| HealthEP
    Kubelet -->|"HTTP/8081<br/>No encryption<br/>No auth"| ReadyEP

    %% Controller → API Server
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% API Server → CRDs
    K8sAPI --- WatchedCRDs
    K8sAPI --- APIServer

    %% Conditional integrations
    ControllerPod -.->|"HTTPS/6443<br/>conditional watch"| GatewayAPI
    ControllerPod -.->|"HTTPS/6443<br/>conditional watch"| PromOp
    ControllerPod -.->|"HTTPS/6443<br/>conditional watch"| Console

    %% Managed resources
    ControllerPod -->|"HTTPS/6443<br/>Helm-rendered manifests"| MLflowDeploy
    ControllerPod -->|"RBAC resourceNames-scoped"| ArtifactSecret

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef conditional fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef probe fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Prometheus external
    class ControllerPod,MetricsSvc,MetricsEP,HealthEP,ReadyEP operator
    class K8sAPI,MLflowCRD,MLflowOpCRD,MLflowConfigCRD,APIServer controlplane
    class GatewayAPI,PromOp,Console conditional
    class MLflowDeploy,ManagedSA,PVC,NetPol,MigrationJob,ArtifactSecret managed
    class Kubelet probe
