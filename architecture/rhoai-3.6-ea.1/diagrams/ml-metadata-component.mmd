graph TB
    subgraph "ml-metadata Server"
        ServerBinary["metadata_store_server<br/>(C++ binary, Bazel-built)"]
        GRPCService["MetadataStoreService<br/>gRPC on 8080/TCP"]
        ServerBinary --- GRPCService
    end

    subgraph "gRPC API (~40 RPCs)"
        ArtifactOps["Artifact CRUD<br/>Put/Get Artifacts"]
        ExecutionOps["Execution CRUD<br/>Put/Get Executions"]
        ContextOps["Context CRUD<br/>Put/Get Contexts"]
        TypeOps["Type Management<br/>Put/Get ArtifactTypes,<br/>ExecutionTypes, ContextTypes"]
        EventOps["Event Recording<br/>Put/Get Events"]
        LineageOps["Lineage Queries<br/>GetLineageSubgraph"]
    end

    GRPCService --> ArtifactOps
    GRPCService --> ExecutionOps
    GRPCService --> ContextOps
    GRPCService --> TypeOps
    GRPCService --> EventOps
    GRPCService --> LineageOps

    subgraph "Database Backends"
        MariaDB["MariaDB/MySQL<br/>(Primary - RHOAI)<br/>3306/TCP"]
        PostgreSQL["PostgreSQL<br/>(Supported)"]
        SQLite["SQLite<br/>(Supported)"]
    end

    GRPCService -->|"MySQL wire protocol<br/>libmysqlclient"| MariaDB
    GRPCService -.->|"Supported"| PostgreSQL
    GRPCService -.->|"Supported"| SQLite

    subgraph "Clients"
        DSP["Data Science Pipelines<br/>(Pipeline Orchestrator)"]
        PythonClient["Python Client Library<br/>(ml_metadata package)"]
    end

    DSP -->|"gRPC/8080"| GRPCService
    PythonClient -->|"gRPC/8080"| GRPCService

    subgraph "Container Image"
        UBI9["ubi9-minimal base"]
        Binary["metadata_store_server binary"]
        MariaDBLib["libmysqlclient<br/>(bundled)"]
        UBI9 --- Binary
        UBI9 --- MariaDBLib
    end

    style ServerBinary fill:#4a90e2,stroke:#333,color:#fff
    style GRPCService fill:#4a90e2,stroke:#333,color:#fff
    style MariaDB fill:#7ed321,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#333
    style DSP fill:#f5a623,stroke:#333
    style PythonClient fill:#f5a623,stroke:#333
    style UBI9 fill:#d5e8d4,stroke:#82b366
    style Binary fill:#d5e8d4,stroke:#82b366
    style MariaDBLib fill:#d5e8d4,stroke:#82b366
