graph TB
    subgraph "ML Metadata Service"
        Server["metadata_store_server<br/>(C++ gRPC Binary)"]
        Proto["MetadataStoreService<br/>~35 gRPC RPCs"]
        SSLConfig["SSLConfig<br/>(Optional TLS/mTLS)"]
        Server -->|implements| Proto
        Server -->|configurable| SSLConfig
    end

    subgraph "Container Variants"
        Konflux["Konflux Build<br/>(UBI9, digest-pinned)"]
        RedHat["Red Hat Build"]
        Fedora["Fedora Build"]
        Upstream["Upstream Build"]
    end

    subgraph "Core Entity Types"
        Artifacts["Artifacts"]
        Executions["Executions"]
        Contexts["Contexts"]
    end

    subgraph "Relationship Types"
        Events["Events"]
        Attributions["Attributions"]
        Associations["Associations"]
        ParentContexts["ParentContexts"]
    end

    DSP[Data Science Pipelines] -->|deploys & manages| Server
    PipelineComponents["Pipeline Components"] -->|"gRPC :8080<br/>Put RPCs"| Server
    Consumers["Metadata Consumers"] -->|"gRPC :8080<br/>Get RPCs"| Server

    Server -->|CRUD operations| Artifacts
    Server -->|CRUD operations| Executions
    Server -->|CRUD operations| Contexts
    Server -->|manages| Events
    Server -->|manages| Attributions
    Server -->|manages| Associations
    Server -->|manages| ParentContexts

    Server -->|"MySQL protocol :3306<br/>SSL optional"| MySQL["MySQL/MariaDB<br/>Backend Database"]

    PythonClient["ml_metadata<br/>Python Package"] -->|"gRPC client"| Server

