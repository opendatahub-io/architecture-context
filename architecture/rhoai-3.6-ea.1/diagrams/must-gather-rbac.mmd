graph TD
    subgraph "Authentication"
        Caller["SRE / Support Engineer<br/>(oc adm must-gather caller)"]
        Kubeconfig["kubeconfig credentials<br/>(inherited from caller)"]
    end

    subgraph "must-gather Pod"
        SA["Service Account<br/>(framework-provided)"]
    end

    subgraph "Access Pattern"
        ReadOnly["Read-Only Access<br/>via oc adm inspect / kubectl get"]
    end

    subgraph "Kubernetes API Resources Accessed"
        direction TB

        subgraph "Cluster-Scoped Resources"
            DSCi["DSCInitialization"]
            DSC["DataScienceCluster"]
            ComponentCRDs["Component CRs<br/>(dashboards, datasciencepipelines,<br/>kueues, modelregistries, rays,<br/>trustyais, workbenches)"]
            Webhooks["Webhook Configurations"]
            VAPs["ValidatingAdmissionPolicies"]
            CRDs["Custom Resource Definitions"]
        end

        subgraph "Namespaced Resources"
            InferenceService["InferenceService<br/>(serving.kserve.io)"]
            ServingRuntime["ServingRuntime<br/>(serving.kserve.io)"]
            LLMInferenceService["LLMInferenceService<br/>(llm-d)"]
            InferencePool["InferencePool<br/>(llm-d)"]
            AuthConfig["AuthConfig<br/>(authorino)"]
            AuthPolicy["AuthPolicy<br/>(authorino)"]
            RateLimitPolicy["RateLimitPolicy<br/>(kuadrant)"]
            GatewayResources["Gateway, HTTPRoute,<br/>GRPCRoute<br/>(gateway.networking.k8s.io)"]
            Pods["Pods & Pod Logs"]
            Events["Events"]
            NamespaceResources["Namespace Resources<br/>(all API resources)"]
        end
    end

    Caller -->|"provides"| Kubeconfig
    Kubeconfig -->|"injected into"| SA
    SA -->|"authorized for"| ReadOnly
    ReadOnly -->|"get, list"| DSCi
    ReadOnly -->|"get, list"| DSC
    ReadOnly -->|"get, list"| ComponentCRDs
    ReadOnly -->|"get, list"| Webhooks
    ReadOnly -->|"get, list"| VAPs
    ReadOnly -->|"get, list"| CRDs
    ReadOnly -->|"get, list"| InferenceService
    ReadOnly -->|"get, list"| ServingRuntime
    ReadOnly -->|"get, list"| LLMInferenceService
    ReadOnly -->|"get, list"| InferencePool
    ReadOnly -->|"get, list"| AuthConfig
    ReadOnly -->|"get, list"| AuthPolicy
    ReadOnly -->|"get, list"| RateLimitPolicy
    ReadOnly -->|"get, list"| GatewayResources
    ReadOnly -->|"get, list, logs"| Pods
    ReadOnly -->|"get, list"| Events
    ReadOnly -->|"inspect"| NamespaceResources

