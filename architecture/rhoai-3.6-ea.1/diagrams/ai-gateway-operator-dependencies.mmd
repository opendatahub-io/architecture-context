graph LR
    AIGateway["AI Gateway Operator<br/>(ai-gateway-operator)"]

    %% Internal RHOAI Dependencies
    AIGateway -->|"Go SDK library<br/>(runtime primitives)"| ODHOperator["OpenDataHub Operator<br/>v2 SDK"]
    AIGateway -->|"CRD Watch<br/>(platform init state)"| DSCInit["DSCInitialization CR"]
    AIGateway -->|"CRD Watch<br/>(model serving state)"| KServeIS["KServe<br/>InferenceService /<br/>LLMInferenceService"]

    %% External Platform Dependencies
    AIGateway -->|"CRD CRUD<br/>(HTTPRoutes, Gateways)"| GatewayAPI["Gateway API"]
    AIGateway -->|"CRD CRUD<br/>(AuthPolicies,<br/>TokenRateLimitPolicies)"| Kuadrant["Kuadrant"]
    AIGateway -->|"CRD CRUD<br/>(DestinationRules,<br/>EnvoyFilters,<br/>ServiceEntries)"| Istio["Istio"]
    AIGateway -->|"CRD CRUD<br/>(Certificates)"| CertManager["cert-manager"]
    AIGateway -->|"CRD CRUD<br/>(LLMBatchGateway)"| LLMd["llm-d<br/>Batch Gateway"]
    AIGateway -->|"CRD CRUD<br/>(ServiceMonitors,<br/>PrometheusRules)"| PrometheusOp["prometheus-operator"]
    AIGateway -->|"CRD CRUD<br/>(OTel Collectors)"| OTel["OpenTelemetry"]
    AIGateway -->|"CRD CRUD<br/>(Dashboards)"| Perses["Perses"]
    AIGateway -->|"CRD Read<br/>(Authorinos)"| Authorino["Authorino<br/>(Kuadrant)"]

    %% Infrastructure Dependencies
    AIGateway -->|"HTTPS/6443<br/>SA Token"| K8sAPI["Kubernetes API"]

    %% Build Dependencies
    AIGateway -.->|"runtime framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    AIGateway -.->|"CLI framework"| Cobra["cobra / viper"]
    AIGateway -.->|"Go runtime"| GoRuntime["Go 1.26<br/>FIPS: strictfipsruntime"]

    %% Downstream Consumers (who depends on AI Gateway)
    MaaSResources["MaaS Resources<br/>(AITenants, Configs,<br/>ExternalModels,<br/>MaaSSubscriptions)"] -.->|"managed by"| AIGateway
    InferenceRes["Inference Resources<br/>(ExternalModels,<br/>ExternalProviders)"] -.->|"managed by"| AIGateway

    %% Styling
    style AIGateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style ODHOperator fill:#7ed321,stroke:#333,color:#fff
    style DSCInit fill:#7ed321,stroke:#333,color:#fff
    style KServeIS fill:#7ed321,stroke:#333,color:#fff

    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style LLMd fill:#999,stroke:#333,color:#fff
    style PrometheusOp fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Perses fill:#999,stroke:#333,color:#fff
    style Authorino fill:#999,stroke:#333,color:#fff

    style K8sAPI fill:#f5a623,stroke:#333,color:#fff

    style ControllerRuntime fill:#ddd,stroke:#999
    style Cobra fill:#ddd,stroke:#999
    style GoRuntime fill:#ddd,stroke:#999

    style MaaSResources fill:#b8d4f0,stroke:#4a90e2
    style InferenceRes fill:#b8d4f0,stroke:#4a90e2
