graph LR
    AGO["ai-gateway-operator"]

    %% External Dependencies (platform infrastructure)
    AGO -->|"HTTPRoute CRUD"| GatewayAPI["Gateway API"]
    AGO -->|"DestinationRules<br/>EnvoyFilters<br/>ServiceEntries"| Istio["Istio"]
    AGO -->|"Certificate CRs"| CertManager["cert-manager"]
    AGO -->|"AuthPolicies<br/>RateLimitPolicies<br/>TokenRateLimitPolicies"| Kuadrant["Kuadrant"]
    AGO -->|"ServiceMonitors<br/>PodMonitors<br/>PrometheusRules"| PromOperator["prometheus-operator"]
    AGO -->|"Collector CRs"| OTel["OpenTelemetry"]
    AGO -->|"Dashboards<br/>Datasources"| Perses["Perses"]

    %% Internal ODH Dependencies
    AGO -->|"runtime library"| ODHOperator["opendatahub-operator<br/>v2"]
    AGO -->|"watch CRs"| DSCInit["DSCInitialization"]
    AGO -->|"watch LLMInferenceService"| KServe["KServe"]
    AGO -->|"manage lifecycle"| LLMdBatch["llm-d Batch Gateway<br/>(batch.llm-d.ai)"]
    AGO -->|"watch Authorinos"| Authorino["Kuadrant Authorino"]

    %% Kubernetes Platform
    AGO -->|"resource CRUD<br/>:6443 TLS 1.2+"| K8sAPI["Kubernetes API"]

    %% Integration Points (components that consume AI Gateway)
    ODHDashboard["ODH Dashboard"] -.->|"UI management"| AGO
    MaaSTenants["MaaS Tenants"] -.->|"consume routes"| GatewayAPI

    %% Build Dependencies
    AGO -->|"CLI framework"| Cobra["spf13/cobra"]
    AGO -->|"runtime config"| Viper["spf13/viper"]
    AGO -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]

    %% Styling
    style AGO fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Istio fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style PromOperator fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style Perses fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#000

    style ODHOperator fill:#7ed321,stroke:#333,color:#000
    style DSCInit fill:#7ed321,stroke:#333,color:#000
    style KServe fill:#7ed321,stroke:#333,color:#000
    style LLMdBatch fill:#7ed321,stroke:#333,color:#000
    style Authorino fill:#7ed321,stroke:#333,color:#000

    style ODHDashboard fill:#7ed321,stroke:#333,stroke-dasharray: 5 5,color:#000
    style MaaSTenants fill:#ddd,stroke:#333,stroke-dasharray: 5 5,color:#000

    style Cobra fill:#e8e8e8,stroke:#333,color:#000
    style Viper fill:#e8e8e8,stroke:#333,color:#000
    style CtrlRuntime fill:#e8e8e8,stroke:#333,color:#000
