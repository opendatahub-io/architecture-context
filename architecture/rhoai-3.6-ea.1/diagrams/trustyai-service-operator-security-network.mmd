graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client[External Client]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route / VirtualService<br/>443/TCP<br/>TLS Termination"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (TLS enforced)"]
        direction TB

        subgraph TASPod["TrustyAI Service Pod ({user-namespace})"]
            RBACProxy["kube-rbac-proxy<br/>:8443/TCP TLS<br/>TokenReview + SAR<br/>Cert: {instance}-tls"]
            Quarkus["TrustyAI Quarkus<br/>localhost:8080<br/>Pre-authenticated"]
        end

        subgraph OperatorNS["Operator Namespace (system)"]
            CtrlMgr["controller-manager<br/>SA: controller-manager<br/>Health: :8081"]
            WebhookSrv["Webhook Server<br/>:9443/TCP TLS<br/>CRD Conversion"]
            MetricsSvc["metrics-service<br/>:8080/TCP"]
            ProxyMetrics["controller-manager-metrics-service<br/>:8443/TCP via kube-rbac-proxy"]
        end
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        KubeAPI["Kubernetes API Server<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
        OSConfig["OpenShift APIServer Config<br/>TLS Profile Resolution"]
        DSCConfig["DSC ConfigMap<br/>trustyai-dsc-config<br/>LMEval config"]
    end

    subgraph OptionalDeps["OPTIONAL DEPENDENCIES"]
        KServe["KServe InferenceService<br/>Model serving state"]
        Kueue["Kueue<br/>kueue.x-k8s.io/v1beta1<br/>Workload queuing"]
        PromOp["Prometheus Operator<br/>ServiceMonitor CRDs"]
    end

    subgraph Storage["DATA STORAGE"]
        PVC["PVC / External Database<br/>Data persistence"]
    end

    %% External flow
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>Forward"| RBACProxy

    %% Auth flow
    RBACProxy -->|"TokenReview +<br/>SubjectAccessReview"| KubeAPI
    RBACProxy -->|"HTTP/8080<br/>localhost<br/>Pre-authenticated"| Quarkus

    %% Storage
    Quarkus -->|"Read/Write<br/>Data"| PVC

    %% Operator flows
    CtrlMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| KubeAPI
    CtrlMgr -->|"Read"| OSConfig
    CtrlMgr -->|"Read"| DSCConfig
    CtrlMgr -.->|"Watch"| KServe
    CtrlMgr -.->|"Optional<br/>Discovery"| Kueue
    CtrlMgr -.->|"Conditional<br/>ServiceMonitor"| PromOp

    %% Webhook
    KubeAPI -->|"Conversion<br/>:9443 TLS"| WebhookSrv

    %% Metrics
    PromOp -.->|"Scrape :8080"| MetricsSvc
    PromOp -.->|"Scrape :8443"| ProxyMetrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef optional fill:#fff2cc,stroke:#d6b656,stroke-width:2px,stroke-dasharray: 5 5
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class RBACProxy,Quarkus,CtrlMgr,WebhookSrv,MetricsSvc,ProxyMetrics internal
    class KubeAPI,OSConfig,DSCConfig platform
    class KServe,Kueue,PromOp optional
    class PVC storage
