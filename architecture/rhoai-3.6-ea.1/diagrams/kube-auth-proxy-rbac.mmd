graph TD
    subgraph "Authentication & Authorization Model"
        direction TB

        subgraph "kube-auth-proxy Auth Methods (ordered by precedence)"
            M1["1. K8s ServiceAccount Token"]
            M2["2. JWT/OAuth Bearer Token"]
            M3["3. Basic Auth (htpasswd)"]
            M4["4. Cookie Session"]
        end

        subgraph "Kubernetes API Access"
            SA["Pod ServiceAccount"]
            TokenReview["authentication.k8s.io/v1<br/>TokenReview"]
            OAuthTokens["oauth.openshift.io/v1<br/>OAuthAccessToken"]
        end

        subgraph "Secrets"
            Secret["kube-auth-proxy-secret<br/>Type: Opaque<br/>Provisioned by: manifest"]
        end

        subgraph "Protected Endpoints"
            Public["Public (No Auth)<br/>/ping<br/>/robots.txt"]
            PreAuth["Pre-Auth (OAuth Flow)<br/>/oauth2/sign_in<br/>/oauth2/start<br/>/oauth2/callback"]
            Authenticated["Authenticated<br/>/oauth2/auth (ext_authz)<br/>/oauth2/userinfo<br/>/oauth2/sign_out<br/>/* (upstream proxy)"]
        end
    end

    %% Auth method validations
    M1 -->|"POST tokenreviews"| TokenReview
    M2 -->|"Validate with provider"| OIDCProvider["OAuth2/OIDC Provider"]
    M4 -->|"Lookup session"| Redis["Redis/Valkey"]

    %% ServiceAccount API access
    SA -->|"In-cluster token"| TokenReview
    SA -->|"DELETE (async, sign-out)"| OAuthTokens

    %% Secret usage
    Secret -->|"OAuth client secret<br/>Cookie encryption key"| M2
    Secret -->|"Cookie encryption key"| M4

    %% Endpoint protection
    M1 -->|"Grants access"| Authenticated
    M2 -->|"Grants access"| Authenticated
    M3 -->|"Grants access"| Authenticated
    M4 -->|"Grants access"| Authenticated

    style M1 fill:#4a90e2,color:#fff
    style M2 fill:#4a90e2,color:#fff
    style M3 fill:#4a90e2,color:#fff
    style M4 fill:#4a90e2,color:#fff
    style SA fill:#f5a623
    style TokenReview fill:#7ed321
    style OAuthTokens fill:#7ed321
    style Secret fill:#e74c3c,color:#fff
    style Public fill:#d5e8d4,stroke:#82b366
    style PreAuth fill:#ffe6cc,stroke:#d79b00
    style Authenticated fill:#f8cecc,stroke:#b85450
    style OIDCProvider fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
