graph TB
    subgraph BuildTime["BUILD-TIME (Konflux Pipeline)"]
        direction TB
        Konflux["Konflux Build System<br/>(Hermetic Build)"]
    end

    subgraph BaseImages["BASE IMAGES (Trusted Registries)"]
        AIPCC["AIPCC Base Image<br/>quay.io/aipcc/base-images<br/>CUDA + Python + UBI9<br/>TLS Registry Pull"]
        ODHWB["ODH Workbench Base<br/>quay.io/rhoai/odh-workbench-*<br/>Jupyter + UBI9<br/>TLS Registry Pull"]
    end

    subgraph Runtime["RUNTIME (Platform-Managed Pods)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            RuntimePod["Runtime Training Pod<br/>SA: operator-managed<br/>OpenMPI + SSH<br/>CUDA/ROCm"]
            UniversalPod["Universal Training Pod<br/>SA: operator-managed<br/>Dual-mode entrypoint"]
        end
    end

    subgraph Operators["PLATFORM OPERATORS (Lifecycle Managers)"]
        KTO["Kubeflow Training Operator<br/>PyTorchJob orchestration"]
        KTV2["Kubeflow Trainer V2<br/>TrainJob orchestration"]
        KubeRay_Op["KubeRay<br/>Ray cluster management"]
        Kueue_Op["Kueue<br/>Workload scheduling"]
        WBC["Workbench Controller<br/>Jupyter lifecycle"]
    end

    subgraph ExternalSvc["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+"]
    end

    subgraph ExampleOnly["EXAMPLE MANIFESTS ONLY (Non-Production)"]
        direction TB
        MinIO_Svc["MinIO<br/>9000/TCP API<br/>9001/TCP Console<br/>Routes: HTTPS/TLS"]
        NFS_Svc["NFS Server<br/>2049/TCP NFS<br/>111/UDP Portmap<br/>SCC: privileged"]
    end

    %% Build flows
    AIPCC -->|"FROM (TLS)"| Konflux
    ODHWB -->|"FROM (TLS)"| Konflux
    Konflux -->|"Push images<br/>TLS + Registry Auth"| Registry["Container Registry<br/>quay.io<br/>TLS"]

    %% Operator consumption
    KTO -->|"Pull image<br/>Create Pods"| RuntimePod
    KTV2 -->|"Pull image<br/>Create Pods"| UniversalPod
    KubeRay_Op -->|"Pull image<br/>Create Ray Cluster"| UniversalPod
    WBC -->|"Pull image<br/>Set NOTEBOOK_ARGS"| UniversalPod

    %% Egress
    RuntimePod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Styling
    classDef buildtime fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef baseimage fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef cluster fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef example fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5

    class Konflux buildtime
    class AIPCC,ODHWB baseimage
    class RuntimePod,UniversalPod runtime
    class KTO,KTV2,KubeRay_Op,Kueue_Op,WBC operator
    class K8sAPI,Registry cluster
    class MinIO_Svc,NFS_Svc example
