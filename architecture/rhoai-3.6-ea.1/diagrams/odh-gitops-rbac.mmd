graph TD
    subgraph "odh-gitops RBAC Model"
        direction TB

        Note["Note: odh-gitops is a configuration repository.<br/>It does not define RBAC roles or bindings directly.<br/>RBAC is managed by the operators it deploys."]

        subgraph "Deployment-Time RBAC"
            direction TB

            subgraph "XKS Path (Helm)"
                HelmSA[Helm Service Account<br/>tiller / helm-controller]
                HelmPerms[Permissions Required:<br/>- Create Deployments, Services<br/>- Create CRDs (Gateway API)<br/>- Create Namespaces<br/>- Create ClusterRoles/Bindings<br/>- Manage Operator CRs]
                HelmSA -->|needs| HelmPerms
            end

            subgraph "OpenShift Path (OLM)"
                OLMSA[OLM Service Account]
                OLMPerms[Permissions Required:<br/>- Create Subscriptions<br/>- Manage InstallPlans<br/>- Create CSVs]
                OLMSA -->|needs| OLMPerms
            end
        end

        subgraph "Operator-Managed RBAC (post-deploy)"
            direction TB

            RHAIRole["RHAI Operator RBAC<br/>(managed by operator)"]
            KServeRole["KServe RBAC<br/>(managed by operator)"]
            AuthorinoRole["Authorino RBAC<br/>(managed by rhcl-operator)"]
            IstioRole["Istio RBAC<br/>(managed by sail-operator)"]
            CertMgrRole["cert-manager RBAC<br/>(managed by operator)"]

            RHAIRole -.->|creates| KServeRole
            RHAIRole -.->|configures| AuthorinoRole
        end
    end

    %% Styling
    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style HelmSA fill:#4a90e2,color:#fff
    style OLMSA fill:#4a90e2,color:#fff
    style HelmPerms fill:#f5f5f5,stroke:#999
    style OLMPerms fill:#f5f5f5,stroke:#999
    style RHAIRole fill:#7ed321,stroke:#333
    style KServeRole fill:#7ed321,stroke:#333
    style AuthorinoRole fill:#f5a623,stroke:#333
    style IstioRole fill:#9b59b6,stroke:#333,color:#fff
    style CertMgrRole fill:#f5a623,stroke:#333
