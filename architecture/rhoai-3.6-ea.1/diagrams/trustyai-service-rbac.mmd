graph TD
    subgraph "Authentication & Authorization Model"
        direction TB

        subgraph "Auth Delegation (kube-rbac-proxy sidecar)"
            ExternalRequest["Inbound Request<br/>HTTPS/8443"]
            KubeRBAC["kube-rbac-proxy"]
            K8sAPI["Kubernetes API Server"]
            SAR["SubjectAccessReview"]

            ExternalRequest -->|"Bearer Token<br/>(ServiceAccount)"| KubeRBAC
            KubeRBAC -->|"validates token"| K8sAPI
            K8sAPI -->|"evaluates"| SAR
            SAR -->|"allowed/denied"| KubeRBAC
        end

        subgraph "Authenticated Traffic Path"
            Loopback["Forwarded Request<br/>HTTP/8080 → 127.0.0.1"]
            KubeRBAC -->|"if authorized"| Loopback
        end

        subgraph "Direct TLS Path (when configured)"
            DirectTLS["Inbound Request<br/>HTTPS/4443"]
            TLSAuth["TLS Client Certificate<br/>Validation"]
            DirectTLS -->|"client cert"| TLSAuth
        end

        subgraph "Application Endpoints"
            ServiceEndpoints["TrustyAI FastAPI<br/>87 endpoints"]
            Loopback --> ServiceEndpoints
            TLSAuth -->|"if valid cert"| ServiceEndpoints
        end
    end

    subgraph "Secrets & Credentials"
        direction TB
        DBPass["DATABASE_PASSWORD<br/>Type: Environment Variable<br/>Purpose: MariaDB auth<br/>Provisioned: Runtime"]
        QuarkusPass["QUARKUS_DATASOURCE_PASSWORD<br/>Type: Environment Variable<br/>Purpose: MariaDB auth (legacy)<br/>Provisioned: Runtime"]
        TLSCert["Service TLS Certificate<br/>Path: /etc/tls/internal/tls.crt<br/>Path: /etc/tls/internal/tls.key<br/>Purpose: HTTPS on port 4443"]
        DBCACert["MariaDB CA Certificate<br/>Path: /etc/tls/db/ca.crt<br/>Purpose: DB connection TLS"]
    end

    subgraph "FIPS Compliance"
        FIPSPolicy["FIPS Crypto Policy<br/>update-crypto-policies --set FIPS"]
        FIPSHost["Full FIPS Mode<br/>Requires: host kernel fips=1"]
        CryptoLib["cryptography >=48.0.1<br/>OpenSSL binding<br/>No non-FIPS crypto detected"]
        FIPSLabels["Container Labels:<br/>io.trustyai.fips.policy=true<br/>io.trustyai.fips.mode=host-dependent<br/>io.trustyai.fips.compatible=true"]

        FIPSPolicy --> CryptoLib
        FIPSPolicy --> FIPSHost
    end

    %% Note: No explicit ClusterRoles/RoleBindings defined by this component
    %% All RBAC is delegated to kube-rbac-proxy sidecar

    %% Styling
    style KubeRBAC fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style K8sAPI fill:#dae8fc,stroke:#6c8ebf
    style SAR fill:#dae8fc,stroke:#6c8ebf
    style ServiceEndpoints fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style ExternalRequest fill:#f9f9f9,stroke:#999
    style DirectTLS fill:#f9f9f9,stroke:#999
    style TLSAuth fill:#e1d5e7,stroke:#9673a6
    style Loopback fill:#d5e8d4,stroke:#82b366

    style DBPass fill:#f8cecc,stroke:#b85450
    style QuarkusPass fill:#f8cecc,stroke:#b85450
    style TLSCert fill:#fff2cc,stroke:#d6b656
    style DBCACert fill:#fff2cc,stroke:#d6b656

    style FIPSPolicy fill:#d5e8d4,stroke:#82b366
    style FIPSHost fill:#fff2cc,stroke:#d6b656
    style CryptoLib fill:#d5e8d4,stroke:#82b366
    style FIPSLabels fill:#d5e8d4,stroke:#82b366
