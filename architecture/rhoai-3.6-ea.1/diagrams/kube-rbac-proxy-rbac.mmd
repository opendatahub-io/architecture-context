graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_KRP["SA: kube-rbac-proxy<br/>(ns: default)"]
        SA_KRP_VO["SA: kube-rbac-proxy-verb-override<br/>(ns: default)"]
        SA_Default["SA: default<br/>(ns: default)"]
        SA_KRP_Curl["SA: krp-curl-verb-override<br/>(ns: monitoring)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_KRP["kube-rbac-proxy"]
        CRB_KRP_Client["kube-rbac-proxy-client"]
        CRB_KRP_VO["kube-rbac-proxy-verb-override"]
        CRB_KRP_VO_Client["kube-rbac-proxy-verb-override-client"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_KRP["kube-rbac-proxy"]
        CR_KRP_Client["kube-rbac-proxy-client"]
        CR_KRP_VO["kube-rbac-proxy-verb-override"]
        CR_NS_Metrics["namespace-metrics"]
        CR_KRP_VO_Client["kube-rbac-proxy-verb-override-client"]
    end

    subgraph Resources["API Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
        SvcProxy["core<br/>services/proxy"]
        NSMetrics["core<br/>namespace/metrics"]
        Pods["core<br/>pods"]
    end

    %% SA → Binding → Role
    SA_KRP -->|"bound via"| CRB_KRP
    CRB_KRP -->|"grants"| CR_KRP

    SA_Default -->|"bound via"| CRB_KRP_Client
    CRB_KRP_Client -->|"grants"| CR_KRP_Client

    SA_KRP_VO -->|"bound via"| CRB_KRP_VO
    CRB_KRP_VO -->|"grants"| CR_KRP_VO

    SA_KRP_Curl -->|"bound via"| CRB_KRP_VO_Client
    CRB_KRP_VO_Client -->|"grants"| CR_KRP_VO_Client

    %% Role → Resources
    CR_KRP -->|"create"| TokenReview
    CR_KRP -->|"create"| SAR

    CR_KRP_Client -->|"get"| SvcProxy

    CR_KRP_VO -->|"create"| TokenReview
    CR_KRP_VO -->|"create"| SAR

    CR_NS_Metrics -->|"get"| NSMetrics

    CR_KRP_VO_Client -->|"list"| Pods

