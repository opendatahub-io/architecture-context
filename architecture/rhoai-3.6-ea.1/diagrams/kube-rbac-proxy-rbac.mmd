graph TD
    subgraph "Service Accounts"
        SA_KRP["SA: kube-rbac-proxy<br/>(namespace: default)"]
        SA_KRP_VO["SA: kube-rbac-proxy-verb-override<br/>(namespace: default)"]
        SA_Default["SA: default<br/>(namespace: default)"]
        SA_KRP_Curl["SA: krp-curl-verb-override<br/>(namespace: monitoring)"]
    end

    subgraph "ClusterRole Bindings"
        CRB_KRP["ClusterRoleBinding<br/>kube-rbac-proxy"]
        CRB_KRP_Client["ClusterRoleBinding<br/>kube-rbac-proxy-client"]
        CRB_KRP_VO["ClusterRoleBinding<br/>kube-rbac-proxy-verb-override"]
        RB_KRP_VO_Client["RoleBinding<br/>kube-rbac-proxy-verb-override-client<br/>(namespace: monitoring)"]
    end

    subgraph "ClusterRoles"
        CR_KRP["ClusterRole<br/>kube-rbac-proxy"]
        CR_KRP_Client["ClusterRole<br/>kube-rbac-proxy-client"]
        CR_KRP_VO["ClusterRole<br/>kube-rbac-proxy-verb-override"]
        CR_KRP_VO_Client["Role<br/>kube-rbac-proxy-verb-override-client"]
        CR_NS_Metrics["Role<br/>namespace-metrics"]
    end

    subgraph "API Resources - kube-rbac-proxy"
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
    end

    subgraph "API Resources - Client Access"
        ServicesProxy["core<br/>services/proxy<br/>Verbs: get"]
        Pods["core<br/>pods<br/>Verbs: list"]
        NSMetrics["core<br/>namespace/metrics<br/>Verbs: get"]
    end

    %% kube-rbac-proxy SA bindings
    SA_KRP -->|"bound via"| CRB_KRP
    CRB_KRP -->|"grants"| CR_KRP
    CR_KRP -->|"create"| TokenReviews
    CR_KRP -->|"create"| SAR

    %% kube-rbac-proxy-client bindings
    SA_Default -->|"bound via"| CRB_KRP_Client
    CRB_KRP_Client -->|"grants"| CR_KRP_Client
    CR_KRP_Client -->|"get"| ServicesProxy

    %% kube-rbac-proxy-verb-override SA bindings
    SA_KRP_VO -->|"bound via"| CRB_KRP_VO
    CRB_KRP_VO -->|"grants"| CR_KRP_VO
    CR_KRP_VO -->|"create"| TokenReviews
    CR_KRP_VO -->|"create"| SAR

    %% verb-override client bindings
    SA_KRP_Curl -->|"bound via"| RB_KRP_VO_Client
    RB_KRP_VO_Client -->|"grants"| CR_KRP_VO_Client
    CR_KRP_VO_Client -->|"list"| Pods

    %% namespace-metrics (SA: default in default namespace)
    SA_Default -->|"bound via<br/>namespace-metrics binding"| CR_NS_Metrics
    CR_NS_Metrics -->|"get"| NSMetrics

    style SA_KRP fill:#4a90e2,color:#fff
    style SA_KRP_VO fill:#4a90e2,color:#fff
    style SA_Default fill:#4a90e2,color:#fff
    style SA_KRP_Curl fill:#4a90e2,color:#fff
    style CR_KRP fill:#f5a623,color:#fff
    style CR_KRP_Client fill:#f5a623,color:#fff
    style CR_KRP_VO fill:#f5a623,color:#fff
    style CR_KRP_VO_Client fill:#f5a623,color:#fff
    style CR_NS_Metrics fill:#f5a623,color:#fff
    style TokenReviews fill:#7ed321,color:#fff
    style SAR fill:#7ed321,color:#fff
    style ServicesProxy fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style NSMetrics fill:#7ed321,color:#fff
    style CRB_KRP fill:#e8e8e8,stroke:#333
    style CRB_KRP_Client fill:#e8e8e8,stroke:#333
    style CRB_KRP_VO fill:#e8e8e8,stroke:#333
    style RB_KRP_VO_Client fill:#e8e8e8,stroke:#333
