graph TB
    subgraph "MCP Lifecycle Operator"
        direction TB
        Controller["MCPServerReconciler<br/>(controller-runtime)"]
        HealthProbe["Health/Readiness Server<br/>:8081"]
        MetricsServer["Metrics Server<br/>:8443 HTTPS<br/>TokenReview + SAR"]

        Controller -->|"serves"| HealthProbe
        Controller -->|"exposes"| MetricsServer
    end

    User["User / Platform"] -->|"creates/updates"| MCPServerCR["MCPServer CR<br/>(mcp.x-k8s.io/v1alpha1)"]
    MCPServerCR -->|"watched by (For)"| Controller

    subgraph "Owned Resources"
        Deployment["Deployment<br/>(MCP Server Pod)"]
        Service["Service<br/>(MCP Server)"]
        NetworkPolicy["NetworkPolicy"]
    end

    Controller -->|"creates/updates"| Deployment
    Controller -->|"creates/updates"| Service
    Controller -->|"creates/updates"| NetworkPolicy

    subgraph "Watched Resources"
        ConfigMaps["ConfigMaps"]
        Secrets["Secrets"]
    end

    ConfigMaps -->|"triggers re-reconcile<br/>(config hash)"| Controller
    Secrets -->|"triggers re-reconcile<br/>(config hash)"| Controller

    Controller -->|"reads"| ConfigMaps
    Controller -->|"reads"| Secrets

    K8sAPI["Kubernetes API<br/>:6443 HTTPS"] -->|"watch events"| Controller
    Controller -->|"CRUD operations<br/>TLS 1.2+"| K8sAPI

    Prometheus["Prometheus"] -->|"scrapes<br/>HTTPS :8443<br/>TokenReview+SAR"| MetricsServer

    LeaderElection["Leader Election<br/>(Lease: bed7462b.x-k8s.io)"] -.->|"coordination"| Controller

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbe fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style MCPServerCR fill:#f5a623,stroke:#333,color:#fff
    style Deployment fill:#7ed321,stroke:#333,color:#fff
    style Service fill:#7ed321,stroke:#333,color:#fff
    style NetworkPolicy fill:#7ed321,stroke:#333,color:#fff
    style ConfigMaps fill:#e8e8e8,stroke:#333
    style Secrets fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#e8e8e8,stroke:#333
    style LeaderElection fill:#e8e8e8,stroke:#333
