graph TB
    subgraph "mcp-lifecycle-operator"
        direction TB
        Manager["Manager Process<br/>/manager"]
        Reconciler["MCPServerReconciler<br/>controller-runtime"]
        HandshakeClient["MCP Handshake Client<br/>go-sdk v1.6.1"]
        TLSConfig["TLS Configuration<br/>tlsSettings"]
        HealthProbe["Health/Readiness Probes<br/>:8081"]
        MetricsServer["Metrics Server<br/>:8443 TLS"]

        Manager --> Reconciler
        Manager --> HealthProbe
        Manager --> MetricsServer
        Reconciler --> HandshakeClient
        Manager --> TLSConfig
        TLSConfig -.->|configures| MetricsServer
    end

    User[User / Platform] -->|creates| MCPServerCR["MCPServer CR<br/>mcp.x-k8s.io/v1alpha1"]
    MCPServerCR -->|watched by| Reconciler

    Reconciler -->|creates/owns| Deployment["Deployment<br/>MCP Server Pod"]
    Reconciler -->|creates/owns| Service["Service<br/>MCP Endpoint"]
    Reconciler -->|creates/owns| NetworkPolicy["NetworkPolicy<br/>Network Access"]

    Reconciler -->|watches| ConfigMap["ConfigMap<br/>Referenced Config"]
    Reconciler -->|watches| Secret["Secret<br/>Referenced Secrets"]

    HandshakeClient -->|MCP initialize| MCPPod["MCP Server Pod<br/>HTTP endpoint"]
    Deployment -.->|runs| MCPPod

    Reconciler -->|CRUD via| K8sAPI["Kubernetes API<br/>:6443 HTTPS"]
    Prometheus["Prometheus"] -->|scrapes| MetricsServer

    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style Reconciler fill:#4a90e2,stroke:#333,color:#fff
    style HandshakeClient fill:#4a90e2,stroke:#333,color:#fff
    style TLSConfig fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbe fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style MCPServerCR fill:#f5a623,stroke:#333
    style Deployment fill:#7ed321,stroke:#333
    style Service fill:#7ed321,stroke:#333
    style NetworkPolicy fill:#7ed321,stroke:#333
    style ConfigMap fill:#f5a623,stroke:#333
    style Secret fill:#f5a623,stroke:#333
    style MCPPod fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
