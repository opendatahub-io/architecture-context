graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS)"]
        ClusterRoute["Route: data-science-prometheus-cluster-proxy<br/>HTTPS/TLS"]
        PrometheusRoute["Route: data-science-prometheus-route<br/>HTTPS/TLS"]
        ThanosRoute["Route: data-science-thanos-querier-route<br/>HTTPS/TLS"]
    end

    subgraph ProxyLayer["PROXY LAYER (AuthN/AuthZ)"]
        direction TB

        ClusterProxy["kube-rbac-proxy (cluster-proxy)<br/>:8443/TCP HTTPS<br/>SA: data-science-prometheus-cluster-proxy<br/>Auth: SubjectAccessReview<br/>(metrics.k8s.io/nodes/get)"]

        NSProxy["kube-rbac-proxy (namespace-proxy)<br/>:8443/TCP HTTPS<br/>SA: data-science-prometheus-namespace-proxy<br/>Auth: SubjectAccessReview"]

        PromLabelProxy["prom-label-proxy<br/>:9090/TCP<br/>Namespace-scoped filtering"]
    end

    subgraph DataPlane["DATA PLANE (Monitoring Stack)"]
        direction TB

        Prometheus["Prometheus (prometheus-operated)<br/>:9090/TCP<br/>TLS (service-ca)<br/>Secret: prometheus-operated-tls"]

        Collector["OpenTelemetry Collector<br/>:8889/TCP<br/>Secret: data-science-collector-tls"]
    end

    subgraph OperatorPlane["OPERATOR CONTROL PLANE"]
        Manager["odh-observability Manager<br/>:8081/TCP health (unauth)<br/>:9443/TCP webhook (TLS/cert-manager)<br/>FIPS: strictfipsruntime"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>:6443/TCP HTTPS/WSS<br/>TLS 1.2+"]
        CertManager["cert-manager<br/>Webhook TLS provisioning"]
        ServiceCA["service-ca<br/>Prometheus TLS provisioning"]
        PromOperator["prometheus-operator<br/>CRD management"]
    end

    subgraph Workloads["DATA SCIENCE WORKLOADS"]
        DSWorkloads["Data Science Pods<br/>Metrics sources"]
    end

    subgraph LogStorage["LOG STORAGE"]
        Loki["LokiStack<br/>Usage log storage"]
    end

    %% External to Ingress
    Client -->|"HTTPS<br/>TLS<br/>Bearer Token"| ClusterRoute
    Client -->|"HTTPS<br/>TLS"| PrometheusRoute
    Client -->|"HTTPS<br/>TLS"| ThanosRoute

    %% Ingress to Proxy
    ClusterRoute -->|"HTTPS/8443<br/>TLS"| ClusterProxy
    PrometheusRoute -->|"HTTPS/8443<br/>TLS"| NSProxy

    %% Proxy to Prometheus
    ClusterProxy -->|"HTTPS/9090<br/>mTLS (client cert + CA)<br/>ServiceAccount"| Prometheus
    NSProxy -->|"HTTPS/9090<br/>TLS"| PromLabelProxy
    PromLabelProxy -->|"HTTPS/9090<br/>TLS (service-ca)"| Prometheus

    %% Proxy auth delegation
    ClusterProxy -.->|"TokenReview +<br/>SubjectAccessReview"| K8sAPI
    NSProxy -.->|"TokenReview +<br/>SubjectAccessReview"| K8sAPI

    %% Operator flows
    Manager -->|"HTTPS/WSS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"HTTPS/9443<br/>TLS (cert-manager)<br/>Admission"| Manager

    %% Workload flows
    DSWorkloads -->|"Scraped by<br/>:9090/TCP"| Prometheus
    DSWorkloads -->|"Metrics/logs<br/>:8889/TCP"| Collector
    Collector -->|"Forward usage logs"| Loki

    %% Platform dependencies
    CertManager -.->|"provisions certs"| Manager
    ServiceCA -.->|"provisions certs"| Prometheus

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef proxy fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef dataplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef workload fill:#f9f9f9,stroke:#666,stroke-width:1px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class ClusterRoute,PrometheusRoute,ThanosRoute ingress
    class ClusterProxy,NSProxy,PromLabelProxy proxy
    class Prometheus,Collector dataplane
    class Manager operator
    class K8sAPI,CertManager,ServiceCA,PromOperator platform
    class DSWorkloads workload
    class Loki storage
