graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Prometheus["Prometheus<br/>Metrics Source<br/>TLS 1.2+ (configurable)<br/>Bearer Token or mTLS"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        direction TB

        subgraph Manager["controller-manager Deployment"]
            direction LR
            MetricsEP[":8443/TCP Metrics<br/>HTTPS TLS<br/>TokenReview + SAR"]
            HealthEP[":8081/TCP Probes<br/>HTTP plaintext<br/>No auth (by design)"]
        end

        MetricsSvc["controller-manager-metrics-service<br/>ClusterIP :8443/TCP"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        KubeAPI["kube-apiserver<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
    end

    subgraph ScaleTargets["SCALE TARGETS (Workload Namespaces)"]
        Deployments["Deployments<br/>autoscaling/v1/Scale"]
        LWS["LeaderWorkerSets<br/>autoscaling/v1/Scale"]
    end

    subgraph WatchedResources["WATCHED RESOURCES"]
        InferencePool["InferencePool CR<br/>inference.networking.k8s.io/v1<br/>inference.networking.x-k8s.io/v1alpha2"]
        HPA["HorizontalPodAutoscaler<br/>autoscaling/v2"]
        ScaledObject["ScaledObject<br/>keda.sh/v1alpha1<br/>(optional)"]
        ConfigMap["ConfigMap<br/>Dynamic config"]
    end

    %% Flows
    Prometheus -->|HTTPS<br/>TLS 1.2+<br/>Bearer/mTLS| Manager
    Manager -->|HTTPS/WSS :6443<br/>TLS 1.2+<br/>SA: controller-manager| KubeAPI
    MetricsSvc -->|ClusterIP :8443<br/>TLS<br/>TokenReview + SAR| MetricsEP
    KubeAPI -->|Watch events<br/>TLS| Manager
    Manager -->|Scale subresource<br/>HTTPS :6443| Deployments
    Manager -->|Scale subresource<br/>HTTPS :6443| LWS

    %% Watched resources through API
    InferencePool -.->|watched via API| Manager
    HPA -.->|watched via API| Manager
    ScaledObject -.->|watched via API| Manager
    ConfigMap -.->|watched via API| Manager

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef scaletarget fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef watched fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Prometheus external
    class Manager,MetricsEP,HealthEP operator
    class MetricsSvc service
    class KubeAPI controlplane
    class Deployments,LWS scaletarget
    class InferencePool,HPA,ScaledObject,ConfigMap watched
