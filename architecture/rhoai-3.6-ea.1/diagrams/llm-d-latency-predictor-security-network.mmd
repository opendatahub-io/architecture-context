graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        TelemetryProducer["Telemetry Producer<br/>(llm-d gateway / scheduler)"]
        InferenceConsumer["Inference Consumer<br/>(llm-d routing component)"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No Auth Enforced)"]
        direction TB

        subgraph NS_Component["Namespace: llm-d-latency-predictor"]
            TrainingServer["Training Server<br/>training-service:8000/TCP<br/>Protocol: HTTP (plain)<br/>Auth: None"]
            PredictionServer["Prediction Server<br/>prediction-service:80→8001/TCP<br/>Protocol: HTTP (plain)<br/>Auth: None"]
        end
    end

    subgraph Probes["KUBERNETES PROBES"]
        Kubelet["kubelet"]
    end

    %% Telemetry ingestion flow
    TelemetryProducer -->|"POST /add_training_data_bulk<br/>8000/TCP HTTP<br/>Encryption: None<br/>Auth: None"| TrainingServer

    %% Model sync flow (internal)
    PredictionServer -->|"GET /model/{name}/info<br/>GET /model/{name}/download<br/>8000/TCP HTTP<br/>Encryption: None<br/>Auth: None<br/>Retry: exp backoff 502/503/504"| TrainingServer

    %% Prediction serving flow
    InferenceConsumer -->|"POST /predict, /predict/bulk<br/>8001/TCP HTTP<br/>Encryption: None<br/>Auth: None"| PredictionServer

    %% Health probes
    Kubelet -->|"GET /healthz /readyz<br/>8000/TCP HTTP<br/>Auth: None"| TrainingServer
    Kubelet -->|"GET /healthz /readyz<br/>8001/TCP HTTP<br/>Auth: None"| PredictionServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef clusterinternal fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef component fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef probes fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class TelemetryProducer,InferenceConsumer external
    class TrainingServer,PredictionServer component
    class Kubelet probes
