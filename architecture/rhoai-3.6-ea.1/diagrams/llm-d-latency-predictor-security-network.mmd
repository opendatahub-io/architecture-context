graph TB
    subgraph External["EXTERNAL CALLERS"]
        LLMd["llm-d Inference Gateway<br/>Sends latency samples"]
        PredClient["Prediction Clients<br/>(llm-d Gateway / Internal Services)"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (No Service Mesh)"]
        direction TB

        subgraph TrainingZone["Training Server Zone"]
            TrainSvc["Service: training-service<br/>ClusterIP 8000:8000/TCP"]
            TrainServer["Training Server<br/>Deployment: 1 replica<br/>Image: AIPCC base cpu:3.5.0<br/>uvicorn FastAPI :8000<br/>Volume: emptyDir (ephemeral)"]
        end

        subgraph PredictionZone["Prediction Server Zone"]
            PredSvc["Service: prediction-service<br/>ClusterIP 80:8001/TCP"]
            PredServer["Prediction Server<br/>Deployment: 10 replicas<br/>Image: AIPCC base cpu:3.5.0<br/>uvicorn FastAPI :8001<br/>Volume: emptyDir (ephemeral)"]
        end
    end

    %% External → Training
    LLMd -->|"POST /add_training_data_bulk<br/>HTTP/8000 | No TLS<br/>No Auth"| TrainSvc
    TrainSvc --> TrainServer

    %% Prediction → Training (model sync)
    PredServer -->|"GET /model/export<br/>HTTP/8000 | No TLS<br/>No Auth<br/>Poll every 10s"| TrainSvc

    %% Clients → Prediction
    PredClient -->|"POST /predict{,/bulk,/bulk/strict}<br/>HTTP/80→8001 | No TLS<br/>No Auth"| PredSvc
    PredSvc --> PredServer

    %% Health probes
    K8s["Kubernetes<br/>kubelet"] -.->|"GET /healthz, /readyz<br/>HTTP :8001<br/>No Auth"| PredServer
    K8s -.->|"GET /healthz, /readyz<br/>HTTP :8000<br/>No Auth"| TrainServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef server fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:1px,stroke-dasharray: 5 5

    class LLMd,PredClient external
    class TrainSvc,PredSvc service
    class TrainServer,PredServer server
    class K8s k8s
