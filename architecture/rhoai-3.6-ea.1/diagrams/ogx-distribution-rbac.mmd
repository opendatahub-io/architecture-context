graph TD
    subgraph "OGX Distribution - Application-Level Authorization"
        direction TB

        subgraph AuthConfig["Authentication Configuration"]
            AuthIssuer["AUTH_ISSUER<br/>(OAuth2 Issuer URL)"]
            AuthAudience["AUTH_AUDIENCE<br/>(Expected audience)"]
            JWKS["JWKS Endpoint<br/>(Token validation)"]
            TLSVerify["verify_tls / tls_cafile<br/>(TLS for JWKS)"]
        end

        subgraph TokenValidation["Token Validation"]
            BearerToken["OAuth2 Bearer Token<br/>(from client request)"]
            Validator["OGX Auth Validator<br/>(built-in enforcement)"]
        end

        subgraph AccessPolicy["Access Policy: Owner-Based Resource Isolation"]
            direction TB
            AuthenticatedUser["Authenticated User"]
            Create["CREATE<br/>any resource"]
            ReadSystem["READ<br/>system resources (unowned)"]
            OwnerOps["READ / UPDATE / DELETE<br/>own resources only"]
        end
    end

    subgraph NoK8sRBAC["Kubernetes RBAC"]
        NoRoles["No ClusterRoles defined<br/>(application-level component,<br/>not a Kubernetes operator)"]
    end

    AuthIssuer -->|configures| JWKS
    AuthAudience -->|validates| Validator
    JWKS -->|provides keys| Validator
    TLSVerify -->|secures| JWKS

    BearerToken -->|presented to| Validator
    Validator -->|identifies| AuthenticatedUser

    AuthenticatedUser -->|can| Create
    AuthenticatedUser -->|can| ReadSystem
    AuthenticatedUser -->|as owner, can| OwnerOps

    %% Styling
    style AuthIssuer fill:#4a90e2,stroke:#333,color:#fff
    style AuthAudience fill:#4a90e2,stroke:#333,color:#fff
    style JWKS fill:#4a90e2,stroke:#333,color:#fff
    style TLSVerify fill:#4a90e2,stroke:#333,color:#fff
    style BearerToken fill:#f5a623,stroke:#333,color:#fff
    style Validator fill:#f5a623,stroke:#333,color:#fff
    style AuthenticatedUser fill:#7ed321,stroke:#333,color:#fff
    style Create fill:#d5e8d4,stroke:#82b366
    style ReadSystem fill:#d5e8d4,stroke:#82b366
    style OwnerOps fill:#d5e8d4,stroke:#82b366
    style NoRoles fill:#e8e8e8,stroke:#999
