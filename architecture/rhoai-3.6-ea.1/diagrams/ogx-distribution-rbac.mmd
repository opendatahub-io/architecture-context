graph TD
    subgraph "Application-Level Access Control"
        direction TB

        subgraph "OAuth2 Token Validation (conditional)"
            AuthIssuer["AUTH_ISSUER env var"]
            JWKSEndpoint["JWKS Endpoint<br/>(key recheck: 3600s)"]
            AuthIssuer -->|"when set, enables"| JWKSEndpoint
        end

        subgraph "Access Policy (Resource Ownership Model)"
            Public["Unowned System Resources<br/>Action: READ<br/>Auth: None required"]
            Authenticated["All Resources<br/>Action: CREATE<br/>Auth: Valid OAuth2 token"]
            Owner["Owned Resources<br/>Action: READ / UPDATE / DELETE<br/>Auth: Resource owner identity"]
        end

        JWKSEndpoint -->|"validates tokens for"| Authenticated
        JWKSEndpoint -->|"extracts owner identity for"| Owner
    end

    subgraph "Secret Management (entrypoint.sh)"
        direction LR
        SecretResolution["18 _FILE Secret Env Vars"]
        K8sMount["Kubernetes<br/>Mounted Files"]
        K8sMount -->|"read at startup"| SecretResolution
    end

    subgraph "Secret Categories"
        direction LR
        APIKeys["API Keys<br/>(inference providers)"]
        DBCreds["Database Credentials<br/>(PostgreSQL)"]
        Tokens["Service Tokens<br/>(vector stores, telemetry)"]
    end

    SecretResolution --> APIKeys
    SecretResolution --> DBCreds
    SecretResolution --> Tokens

    subgraph "Kubernetes RBAC"
        NoK8sRBAC["No ClusterRoles or<br/>RoleBindings defined<br/>by this component"]
    end

    style AuthIssuer fill:#e74c3c,stroke:#333,color:#fff
    style JWKSEndpoint fill:#e74c3c,stroke:#333,color:#fff
    style Public fill:#7ed321,stroke:#333
    style Authenticated fill:#f5a623,stroke:#333
    style Owner fill:#4a90e2,stroke:#333,color:#fff
    style SecretResolution fill:#9b59b6,stroke:#333,color:#fff
    style K8sMount fill:#9b59b6,stroke:#333,color:#fff
    style NoK8sRBAC fill:#e8e8e8,stroke:#999
