graph TD
    subgraph "Authentication Model"
        direction TB
        Note["FMS Guardrails Orchestrator does NOT<br/>define ClusterRoles or RoleBindings.<br/>Authentication is passthrough-based."]
    end

    subgraph "Auth Flow"
        direction TB
        Client["Client Request"]
        Orchestrator["Orchestrator<br/>(Header Passthrough)"]
        Downstream["Downstream Services<br/>(Enforce Auth)"]

        Client -->|"Configured headers<br/>forwarded as-is"| Orchestrator
        Orchestrator -->|"X-Forwarded-Access-Token<br/>→ Authorization Bearer<br/>(optional rewrite)"| Downstream
    end

    subgraph "Endpoint Security"
        direction TB
        APIEndpoints["/api/v1/*, /api/v2/*<br/>POST<br/>Auth: Header passthrough"]
        HealthEndpoints["/health, /info<br/>GET<br/>Auth: None (unauthenticated)"]
        TLSEndpoints["All endpoints<br/>TLS / mTLS<br/>Optional (CLI flags)"]
    end

    subgraph "Secrets"
        direction TB
        TLSCert["TLS server cert/key<br/>kubernetes.io/tls<br/>Platform operator / cert-manager"]
        TLSClientCA["TLS client CA cert<br/>Opaque<br/>mTLS verification"]
        APITokens["API tokens<br/>Opaque (env var)<br/>Downstream auth"]
        DownstreamTLS["Downstream TLS certs<br/>Opaque<br/>Per-service TLS clients"]
    end

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style Client fill:#f5f5f5,stroke:#999
    style Orchestrator fill:#4a90e2,stroke:#333,color:#fff
    style Downstream fill:#7ed321,stroke:#333,color:#fff
    style APIEndpoints fill:#dae8fc,stroke:#6c8ebf
    style HealthEndpoints fill:#d5e8d4,stroke:#82b366
    style TLSEndpoints fill:#fff2cc,stroke:#d6b656
    style TLSCert fill:#e8e8e8,stroke:#666
    style TLSClientCA fill:#e8e8e8,stroke:#666
    style APITokens fill:#e8e8e8,stroke:#666
    style DownstreamTLS fill:#e8e8e8,stroke:#666
