graph TD
    subgraph "Application Identity"
        Binary["fms-guardrails-orchestr8<br/>Rust Binary<br/>(No Kubernetes operator patterns)"]
    end

    subgraph "No RBAC Defined"
        Note["This component does not define<br/>ClusterRoles, Roles, or RoleBindings.<br/>It runs as an application service,<br/>not a Kubernetes operator."]
    end

    subgraph "Secrets Required"
        TLSCert["TLS Server Cert/Key<br/>Type: kubernetes.io/tls<br/>Purpose: HTTP server TLS<br/>Provisioned: Platform operator / cert-manager"]
        ClientCA["TLS Client CA Cert<br/>Type: Opaque<br/>Purpose: mTLS client verification<br/>Provisioned: Platform operator"]
        APITokens["API Tokens<br/>Type: Opaque (env var)<br/>Purpose: Downstream service auth<br/>Provisioned: Platform operator"]
        DownstreamTLS["Downstream TLS Certs<br/>Type: Opaque<br/>Purpose: Downstream TLS clients<br/>Provisioned: Platform operator"]
    end

    subgraph "Authentication Flow"
        Inbound["Inbound Auth<br/>Header passthrough<br/>+ optional mTLS"]
        Rewrite["Token Rewrite<br/>X-Forwarded-Access-Token<br/>→ Authorization Bearer"]
        NoAuth["Health Endpoints<br/>Port 8034<br/>No authentication"]
    end

    Binary --> Note
    Binary -->|"uses"| TLSCert
    Binary -->|"uses"| ClientCA
    Binary -->|"uses"| APITokens
    Binary -->|"uses"| DownstreamTLS
    Binary -->|"applies"| Inbound
    Inbound -->|"optional"| Rewrite
    Binary -->|"exposes"| NoAuth

    style Binary fill:#4a90e2,color:#fff
    style Note fill:#fff3cd,stroke:#ffc107,color:#333
    style TLSCert fill:#e8544f,color:#fff
    style ClientCA fill:#e8544f,color:#fff
    style APITokens fill:#f5a623,color:#fff
    style DownstreamTLS fill:#e8544f,color:#fff
    style Inbound fill:#7ed321,color:#fff
    style Rewrite fill:#7ed321,color:#fff
    style NoAuth fill:#999,color:#fff
