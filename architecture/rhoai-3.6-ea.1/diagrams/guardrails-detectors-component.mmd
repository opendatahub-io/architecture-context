graph TB
    subgraph "Guardrails Detectors"
        direction TB

        subgraph "Shared Base"
            BaseAPI["DetectorBaseAPI<br/>(FastAPI Base Class)<br/>Health checks, metrics,<br/>error handling"]
        end

        subgraph "Built-in Detector"
            BuiltIn["Built-in Detector<br/>/app/bin/regex-detector<br/>Port 8080"]
            RegexEngine["Regex Pattern<br/>Matching"]
            FileTypeVal["File-Type<br/>Validation"]
            BuiltIn --> RegexEngine
            BuiltIn --> FileTypeVal
        end

        subgraph "HuggingFace Detector"
            HFDetector["HuggingFace Detector<br/>uvicorn app:app<br/>Port 8000"]
            PyTorch["PyTorch Inference<br/>Sequence/Token Classification<br/>Causal LM"]
            HFDetector --> PyTorch
        end

        subgraph "LLM Judge Detector"
            JudgeDetector["LLM Judge Detector<br/>uvicorn detectors.llm_judge.app:app<br/>Port 8000, 4 workers"]
            VLLMJudge["vllm_judge.Judge Client<br/>Safety, Toxicity,<br/>Accuracy, Helpfulness"]
            JudgeDetector --> VLLMJudge
        end

        BaseAPI -.->|base class| BuiltIn
        BaseAPI -.->|base class| HFDetector
        BaseAPI -.->|base class| JudgeDetector
    end

    subgraph "KServe ServingRuntimes"
        SRHF["guardrails-detector-runtime-guardian<br/>ServingRuntime (HuggingFace)"]
        SRJudge["guardrails-detector-runtime-judge<br/>ServingRuntime (LLM Judge)"]
    end

    Orchestrator["FMS Guardrails<br/>Orchestrator"] -->|"POST /api/v1/text/contents<br/>POST /api/v1/text/generation<br/>HTTP 8080/TCP"| BuiltIn
    Orchestrator -->|"POST /api/v1/text/contents<br/>HTTP 8000/TCP"| HFDetector
    Orchestrator -->|"POST /api/v1/text/contents<br/>HTTP 8000/TCP"| JudgeDetector

    VLLMJudge -->|"HTTP/HTTPS<br/>VLLM_BASE_URL"| VLLMServer["vLLM Inference Server"]

    HFDetector -.->|"model loading"| MinIO["MinIO Storage<br/>9000/TCP"]
    SRHF -.->|defines runtime| HFDetector
    SRJudge -.->|defines runtime| JudgeDetector

    Prometheus["Prometheus"] -->|"GET /metrics<br/>GET /api/v1/metrics"| BaseAPI

    style BaseAPI fill:#4a90e2,stroke:#333,color:#fff
    style BuiltIn fill:#4a90e2,stroke:#333,color:#fff
    style HFDetector fill:#4a90e2,stroke:#333,color:#fff
    style JudgeDetector fill:#4a90e2,stroke:#333,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333
    style VLLMServer fill:#f5a623,stroke:#333
    style MinIO fill:#f5a623,stroke:#333
    style SRHF fill:#e8e8e8,stroke:#333
    style SRJudge fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
