graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["kuberay-operator<br/>(SA)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["kuberay-operator<br/>(ClusterRoleBinding)"]
        CRB_ConfigMap["kuberay-operator-configmap<br/>(RoleBinding, redhat-ods-applications)"]
        CRB_GatewayAPI["kuberay-operator-gateway-api<br/>(RoleBinding, redhat-ods-applications)"]
        CRB_LeaderElection["kuberay-operator-leader-election<br/>(RoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Operator["kuberay-operator<br/>(ClusterRole)"]
        CR_Edit["kuberay-edit-role<br/>(ClusterRole)"]
        CR_View["kuberay-view-role<br/>(ClusterRole)"]
        CR_ConfigMap["kuberay-operator-configmap<br/>(ClusterRole)"]
        CR_GatewayAPI["kuberay-operator-gateway-api<br/>(ClusterRole)"]
        CR_LeaderElection["kuberay-operator-leader-election<br/>(Role)"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["core<br/>Pods"]
        Services["core<br/>Services"]
        Secrets["core<br/>Secrets"]
        ConfigMaps["core<br/>ConfigMaps"]
        SvcAccounts["core<br/>ServiceAccounts"]
        Events["core<br/>Events"]
    end

    subgraph RayResources["ray.io API Resources"]
        RayClusters["ray.io<br/>RayClusters"]
        RayJobs["ray.io<br/>RayJobs"]
        RayServices["ray.io<br/>RayServices"]
        RayCronJobs["ray.io<br/>RayCronJobs"]
    end

    subgraph InfraResources["Infrastructure Resources"]
        Certificates["cert-manager.io<br/>Certificates"]
        Issuers["cert-manager.io<br/>Issuers"]
        HTTPRoutes["gateway.networking.k8s.io<br/>HTTPRoutes"]
        RefGrants["gateway.networking.k8s.io<br/>ReferenceGrants"]
        Gateways["gateway.networking.k8s.io<br/>Gateways"]
        NetPolicies["networking.k8s.io<br/>NetworkPolicies"]
        Ingresses["networking.k8s.io<br/>Ingresses"]
        Routes["route.openshift.io<br/>Routes"]
    end

    subgraph RBACResources["RBAC Resources"]
        Roles["rbac<br/>Roles"]
        RoleBindings["rbac<br/>RoleBindings"]
        ClusterRolesRes["rbac<br/>ClusterRoles"]
        ClusterRoleBindingsRes["rbac<br/>ClusterRoleBindings"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    %% SA → Bindings
    SA_Operator -->|bound via| CRB_Operator
    SA_Operator -->|bound via| CRB_ConfigMap
    SA_Operator -->|bound via| CRB_GatewayAPI
    SA_Operator -->|bound via| CRB_LeaderElection

    %% Bindings → Roles
    CRB_Operator -->|grants| CR_Operator
    CRB_ConfigMap -->|grants| CR_ConfigMap
    CRB_GatewayAPI -->|grants| CR_GatewayAPI
    CRB_LeaderElection -->|grants| CR_LeaderElection

    %% Operator Role → Resources
    CR_Operator -->|"CRUD + deletecollection"| Pods
    CR_Operator -->|"CRUD"| Services
    CR_Operator -->|"create,delete,get,list,watch"| Secrets
    CR_Operator -->|"CRUD"| ConfigMaps
    CR_Operator -->|"CRUD"| SvcAccounts
    CR_Operator -->|"CRUD"| Events
    CR_Operator -->|"full CRUD + finalizers + status"| RayClusters
    CR_Operator -->|"full CRUD + finalizers + status"| RayJobs
    CR_Operator -->|"full CRUD + finalizers + status"| RayServices
    CR_Operator -->|"full CRUD + finalizers + status"| RayCronJobs
    CR_Operator -->|"CRUD + status"| Certificates
    CR_Operator -->|"CRUD"| Issuers
    CR_Operator -->|"CRUD"| HTTPRoutes
    CR_Operator -->|"CRUD"| RefGrants
    CR_Operator -->|"CRUD"| Gateways
    CR_Operator -->|"CRUD"| NetPolicies
    CR_Operator -->|"CRUD"| Ingresses
    CR_Operator -->|"CRUD"| Routes
    CR_Operator -->|"CRUD"| Roles
    CR_Operator -->|"CRUD"| RoleBindings
    CR_Operator -->|"get,list,watch"| ClusterRolesRes
    CR_Operator -->|"get,list,watch"| ClusterRoleBindingsRes
    CR_Operator -->|"create"| TokenReviews
    CR_Operator -->|"create"| SAR

    %% Edit/View roles
    CR_Edit -->|"full CRUD"| RayClusters
    CR_Edit -->|"full CRUD"| RayJobs
    CR_Edit -->|"full CRUD"| RayServices
    CR_View -->|"get,list,watch"| RayClusters
    CR_View -->|"get,list,watch"| RayJobs
    CR_View -->|"get,list,watch"| RayServices

    %% Scoped roles
    CR_ConfigMap -->|"CRUD"| ConfigMaps
    CR_GatewayAPI -->|"CRUD"| HTTPRoutes
    CR_GatewayAPI -->|"CRUD"| RefGrants
    CR_GatewayAPI -->|"get,list,watch"| Gateways

