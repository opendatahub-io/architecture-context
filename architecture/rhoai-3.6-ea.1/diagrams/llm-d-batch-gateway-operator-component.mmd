graph TB
    subgraph Operator["llm-d-batch-gateway-operator"]
        direction TB
        Manager["Manager<br/>(controller-runtime)"]

        subgraph Controllers["Controllers"]
            Reconciler["LLMBatchGatewayReconciler<br/>Reconciles LLMBatchGateway CRs"]
            MetricsCtrl["MetricsController<br/>Manages operator metrics resources"]
        end

        subgraph HelmCharts["Embedded Helm Charts"]
            BGChart["batch-gateway chart"]
            APChart["async-processor chart"]
        end

        Manager --> Reconciler
        Manager --> MetricsCtrl
        Reconciler -->|renders| BGChart
        Reconciler -->|renders| APChart
    end

    %% CR input
    User[Platform Operator] -->|creates/updates| BGCR["LLMBatchGateway CR<br/>(batch.llm-d.ai/v1alpha1)"]
    BGCR -->|watched by| Reconciler

    %% Deployed components (from Helm charts)
    subgraph DeployedStack["Deployed Batch Gateway Stack"]
        APIServer["API Server<br/>Deployment"]
        Processor["Request Processor<br/>Deployment"]
        GC["Garbage Collector<br/>Deployment"]
        AsyncProc["Async Processor<br/>Deployment<br/>(conditional)"]
    end

    Reconciler -->|deploys via SSA| APIServer
    Reconciler -->|deploys via SSA| Processor
    Reconciler -->|deploys via SSA| GC
    Reconciler -->|deploys via SSA| AsyncProc

    %% Supporting resources
    Reconciler -->|creates| SvcAcct["ServiceAccounts"]
    Reconciler -->|creates| ConfigMaps["ConfigMaps"]
    Reconciler -->|creates| Services["Services"]

    %% Conditional integrations
    Reconciler -->|creates if CRD present| Certs["cert-manager<br/>Certificates"]
    Reconciler -->|creates if CRD present| HTTPRoutes["Gateway API<br/>HTTPRoutes"]
    Reconciler -->|creates if CRD present| MonResources["ServiceMonitors<br/>PodMonitors<br/>PrometheusRules"]

    %% Secret sync
    Reconciler -->|cross-namespace sync<br/>via ReferenceGrant| Secrets["Secrets"]

    %% Metrics controller outputs
    MetricsCtrl -->|manages| MetricsSvc["metrics Service<br/>8443/TCP"]
    MetricsCtrl -->|manages| SvcMon["ServiceMonitor"]
    MetricsCtrl -->|manages| PromRule["PrometheusRule"]

    %% External dependencies
    Reconciler -->|watches CRDs| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Styling
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style Reconciler fill:#2c5f8a,stroke:#333,color:#fff
    style MetricsCtrl fill:#2c5f8a,stroke:#333,color:#fff
    style BGChart fill:#6ba3d6,stroke:#333,color:#fff
    style APChart fill:#6ba3d6,stroke:#333,color:#fff
    style BGCR fill:#f5a623,stroke:#333,color:#000
    style APIServer fill:#7ed321,stroke:#333,color:#000
    style Processor fill:#7ed321,stroke:#333,color:#000
    style GC fill:#7ed321,stroke:#333,color:#000
    style AsyncProc fill:#7ed321,stroke:#333,stroke-dasharray:5 5,color:#000
    style Certs fill:#e8e8e8,stroke:#999
    style HTTPRoutes fill:#e8e8e8,stroke:#999
    style MonResources fill:#e8e8e8,stroke:#999
    style K8sAPI fill:#f5a623,stroke:#333
