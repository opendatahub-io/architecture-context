graph LR
    OpenShell["OpenShell<br/>(Gateway + Supervisor)"]

    %% Platform Dependencies (Required)
    OpenShell -->|"6443/TCP HTTPS<br/>SA Token Auth"| K8sAPI["Kubernetes API<br/>Pod lifecycle, TokenReview"]
    OpenShell -->|"443/TCP HTTPS<br/>JWKS fetch"| OIDC["OIDC Identity Provider<br/>JWT Validation"]
    OpenShell -->|"8200/TCP HTTPS<br/>K8s SA / Vault token"| Vault["HashiCorp Vault<br/>Credential Storage"]

    %% Optional Platform Dependencies
    OpenShell -.->|"5432/TCP SQL<br/>TLS optional"| PostgreSQL["PostgreSQL<br/>State Persistence"]
    OpenShell -.->|"GRPCRoute CRD<br/>443/TCP"| EnvoyGW["Envoy Gateway<br/>gRPC Ingress"]
    OpenShell -.->|"Certificate CRD"| CertManager["cert-manager<br/>TLS Lifecycle"]
    OpenShell -.->|"Unix socket<br/>gRPC"| SPIFFE["SPIFFE/SPIRE<br/>Workload Identity"]

    %% Compute Backends
    OpenShell -->|"kube client<br/>Pod + Sidecar"| K8sDriver["Kubernetes<br/>Compute Driver"]
    OpenShell -.->|"Bollard REST<br/>Unix socket"| Docker["Docker Engine<br/>Compute Driver"]
    OpenShell -.->|"REST API<br/>Unix socket"| Podman["Podman<br/>Compute Driver"]
    OpenShell -.->|"KVM/QEMU<br/>GPU Passthrough"| VMDriver["VM Driver<br/>Compute Driver"]

    %% Egress Dependencies
    OpenShell -->|"443/TCP HTTPS<br/>Injected API keys"| LLMProviders["LLM Providers<br/>OpenAI / Claude /<br/>Vertex AI / Bedrock"]

    %% Key Rust Dependencies
    subgraph RustDeps["Key Rust Dependencies"]
        direction TB
        Tokio["tokio 1.43<br/>Async Runtime"]
        Tonic["tonic 0.14<br/>gRPC Framework"]
        Rustls["rustls 0.23<br/>TLS (ring backend)"]
        Sqlx["sqlx 0.8<br/>Database Access"]
        Kube["kube 0.90<br/>K8s Client"]
        Z3["z3 0.20<br/>SMT Solver"]
        Ring["ring 0.17<br/>AES-256-GCM, SHA-256"]
        Axum["axum 0.8<br/>HTTP + WebSocket"]
    end

    OpenShell -->|"core runtime"| RustDeps

    %% CRD consumed
    SandboxCR["Sandbox CRD<br/>agents.x-k8s.io/v1beta1"] -->|"consumed by"| OpenShell

    %% Styling
    style OpenShell fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style OIDC fill:#999,stroke:#333,color:#fff
    style Vault fill:#999,stroke:#333,color:#fff
    style PostgreSQL fill:#999,stroke:#333,color:#fff
