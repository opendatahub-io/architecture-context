graph TD
    subgraph "Service Accounts"
        SA_ClusterProxy["SA: data-science-prometheus<br/>-cluster-proxy"]
        SA_NSProxy["SA: data-science-prometheus<br/>-namespace-proxy"]
        SA_Collector["SA: data-science-collector<br/>-collector"]
        SA_Alertmanager["SA: data-science-monitoringstack<br/>-alertmanager"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["data-science-prometheus<br/>-cluster-proxy"]
        CRB2["data-science-prometheus<br/>-cluster-proxy-auth-delegator"]
        CRB3["data-science-prometheus<br/>-namespace-proxy"]
        CRB4["data-science-prometheus<br/>-namespace-proxy-auth-delegator"]
        CRB5["generate-processors<br/>-collector-rolebinding"]
        CRB6["data-science-monitoringstack<br/>-alertmanager-prometheus<br/>-metrics-reader"]
    end

    subgraph "ClusterRoles"
        CR_MonView["cluster-monitoring-view"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_GenProc["generate-processors-role"]
    end

    subgraph "API Resources - generate-processors-role"
        R1["config.openshift.io<br/>endpoints, infrastructures,<br/>infrastructures/status,<br/>namespaces, pods, services"]
        R2["discovery.k8s.io<br/>endpointslices"]
        R3["monitoring.coreos.com<br/>podmonitors, probes,<br/>servicemonitors"]
        R4["apps<br/>replicasets"]
    end

    subgraph "Auth Delegation Purpose"
        AuthPurpose["TokenReview +<br/>SubjectAccessReview<br/>for proxy authentication"]
    end

    subgraph "Monitoring Purpose"
        MonPurpose["Read cluster-wide<br/>monitoring metrics"]
    end

    %% Cluster Proxy bindings
    SA_ClusterProxy -->|"bound via"| CRB1
    SA_ClusterProxy -->|"bound via"| CRB2
    CRB1 -->|"grants"| CR_MonView
    CRB2 -->|"grants"| CR_AuthDeleg

    %% Namespace Proxy bindings
    SA_NSProxy -->|"bound via"| CRB3
    SA_NSProxy -->|"bound via"| CRB4
    CRB3 -->|"grants"| CR_MonView
    CRB4 -->|"grants"| CR_AuthDeleg

    %% Collector bindings
    SA_Collector -->|"bound via"| CRB5
    CRB5 -->|"grants"| CR_GenProc

    %% Alertmanager bindings
    SA_Alertmanager -->|"bound via"| CRB6
    CRB6 -->|"grants"| CR_MonView

    %% Role to resources
    CR_GenProc -->|"get, list, watch"| R1
    CR_GenProc -->|"get, list, watch"| R2
    CR_GenProc -->|"get, list, watch"| R3
    CR_GenProc -->|"get, list, watch"| R4

    %% Purpose annotations
    CR_AuthDeleg -.-> AuthPurpose
    CR_MonView -.-> MonPurpose

    style SA_ClusterProxy fill:#4a90e2,color:#fff
    style SA_NSProxy fill:#4a90e2,color:#fff
    style SA_Collector fill:#4a90e2,color:#fff
    style SA_Alertmanager fill:#4a90e2,color:#fff
    style CR_MonView fill:#f5a623,color:#fff
    style CR_AuthDeleg fill:#f5a623,color:#fff
    style CR_GenProc fill:#f5a623,color:#fff
    style R1 fill:#7ed321,color:#fff
    style R2 fill:#7ed321,color:#fff
    style R3 fill:#7ed321,color:#fff
    style R4 fill:#7ed321,color:#fff
    style AuthPurpose fill:#e8e8e8,stroke:#999
    style MonPurpose fill:#e8e8e8,stroke:#999
