graph LR
    NemoGuardrails["NeMo-Guardrails<br/>FastAPI Service"]

    %% Runtime Framework
    NemoGuardrails -->|"ASGI server"| Uvicorn["uvicorn >=0.23"]
    NemoGuardrails -->|"web framework"| FastAPI["FastAPI >=0.103.0"]
    NemoGuardrails -->|"ASGI framework"| Starlette["Starlette >=0.49.1"]

    %% LLM Integration
    NemoGuardrails -->|"LLM inference<br/>HTTPS/443"| OpenAISDK["OpenAI SDK >=1.0.0"]
    NemoGuardrails -->|"LLM chains"| LangChainOpenAI["langchain-openai >=0.1.0"]

    %% NLP & ML Libraries
    NemoGuardrails -->|"NLP processing"| SpaCy["spaCy >=3.4.4"]
    NemoGuardrails -->|"embeddings"| SentenceTransformers["sentence-transformers >=2.2.0"]
    NemoGuardrails -->|"fast embeddings"| FastEmbed["fastembed >=0.2.2"]
    NemoGuardrails -->|"deep learning"| PyTorch["torch >=2.0.0"]
    NemoGuardrails -->|"model inference"| Transformers["transformers >=4.35.0"]
    NemoGuardrails -->|"ONNX runtime"| ONNX["onnxruntime >=1.17.0"]

    %% Security & PII
    NemoGuardrails -->|"PII detection"| PresidioAnalyzer["presidio-analyzer >=2.2"]
    NemoGuardrails -->|"PII anonymization"| PresidioAnonymizer["presidio-anonymizer >=2.2"]
    NemoGuardrails -->|"TLS/crypto"| Cryptography["cryptography ==46.0.7"]
    NemoGuardrails -->|"malware patterns"| YaraPython["yara-python >=4.5.1"]

    %% Observability
    NemoGuardrails -->|"tracing API"| OTelAPI["opentelemetry-api >=1.27.0"]
    NemoGuardrails -->|"tracing SDK"| OTelSDK["opentelemetry-sdk"]
    NemoGuardrails -->|"OTLP export"| OTelExporter["opentelemetry-exporter-otlp"]
    NemoGuardrails -->|"FastAPI instrumentation"| OTelFastAPI["opentelemetry-instrumentation-fastapi"]

    %% HTTP Clients
    NemoGuardrails -->|"async HTTP"| HTTPX["httpx >=0.24.1"]
    NemoGuardrails -->|"async HTTP"| AioHTTP["aiohttp >=3.10.11"]
    NemoGuardrails -->|"sync HTTP"| Requests["requests"]

    %% External LLM Services (Runtime)
    NemoGuardrails ==>|"LLM inference<br/>HTTPS/443 TLS"| AzureOpenAI["Azure OpenAI"]
    NemoGuardrails ==>|"LLM inference<br/>HTTPS/443 TLS"| OpenAIAPI["OpenAI API"]

    %% External Guardrail APIs (Runtime)
    NemoGuardrails ==>|"content safety<br/>HTTPS"| GuardrailAPIs["Third-Party Guardrail APIs<br/>(ActiveFence, AI Defense,<br/>Patronus, Pangea, etc.)"]

    %% Guardrail DSL
    NemoGuardrails -->|"rail parsing"| Lark["lark >=1.1.7"]
    NemoGuardrails -->|"config validation"| Pydantic["pydantic >=2.5"]

