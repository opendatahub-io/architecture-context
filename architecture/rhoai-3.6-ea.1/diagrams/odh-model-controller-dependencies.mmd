graph LR
    ODHModelCtrl["odh-model-controller<br/>Operator + API Server"]

    %% Core Platform Dependencies
    ODHModelCtrl -->|"watches CRDs<br/>InferenceService, InferenceGraph,<br/>LLMInferenceService, ServingRuntime"| KServe["KServe 0.17.0-rc1"]
    ODHModelCtrl -->|"Gateway, HTTPRoute<br/>management"| GatewayAPI["Gateway API 1.5.1"]
    ODHModelCtrl -->|"inference extension"| GWInference["Gateway API Inference<br/>Extension 1.5.0"]

    %% External Platform Dependencies
    ODHModelCtrl -->|"EnvoyFilter<br/>creation"| Istio["Istio 1.27.x"]
    ODHModelCtrl -->|"TriggerAuthentication<br/>autoscaling"| KEDA["KEDA 2.18.3"]
    ODHModelCtrl -->|"AuthPolicy<br/>authentication"| Kuadrant["Kuadrant 1.4.2"]
    ODHModelCtrl -->|"Authorino<br/>lookup"| Authorino["Authorino 0.22.0"]
    ODHModelCtrl -->|"PodMonitor<br/>ServiceMonitor"| PromOp["prometheus-operator 0.89.0"]
    ODHModelCtrl -->|"Route<br/>creation"| OCPRoutes["OpenShift Routes"]

    %% Internal RHOAI Dependencies
    ODHModelCtrl -->|"reads enabled<br/>components"| DSC["DataScienceCluster CR"]
    ODHModelCtrl -->|"reads platform<br/>init state"| DSCI["DSCInitialization CR"]
    ODHModelCtrl -->|"reads hardware<br/>profiles"| HWProfile["HardwareProfile CR"]

    %% Runtime Dependencies
    ODHModelCtrl -->|"TLS profile<br/>watch + restart"| APIServer["OpenShift APIServer<br/>config.openshift.io/v1"]
    ODHModelCtrl -->|"TLS certificates"| ServiceCA["OpenShift service-ca<br/>operator"]
    ODHModelCtrl -->|"resource CRUD<br/>+ watches"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Build / Framework Dependencies
    ODHModelCtrl -->|"operator framework"| CtrlRuntime["controller-runtime 0.23.3"]
    ODHModelCtrl -->|"build toolchain"| GoRuntime["Go 1.25.8<br/>strictfipsruntime"]

    %% Observability Dependencies
    ODHModelCtrl -.->|"trace export<br/>OTLP/gRPC"| OTel["OpenTelemetry<br/>Collector"]
    ODHModelCtrl -->|"metrics export"| PromClient["prometheus/client_golang"]

    %% Integration Points (other RHOAI components that interact)
    NIM["NIM Account CR"] -->|"managed by"| ODHModelCtrl
    Knative["Knative pkg"] -.->|"utility imports"| ODHModelCtrl

