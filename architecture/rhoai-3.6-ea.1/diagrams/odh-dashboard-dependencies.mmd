graph LR
    ODHDashboard["ODH Dashboard<br/>Web Console"]

    %% Parent Operator
    RhodsOp["rhods-operator /<br/>opendatahub-operator"] -->|"creates Dashboard CR"| ODHDashboard

    %% Internal ODH Platform Dependencies (CRD Watch/CRUD)
    ODHDashboard -->|"CRD Watch"| DSCluster["DataScienceCluster CR"]
    ODHDashboard -->|"CRD Watch"| DSCInit["DSCInitialization CR"]
    ODHDashboard -->|"CRD Watch"| KServe["KServe<br/>InferenceService"]
    ODHDashboard -->|"CRD Watch"| TrustyAI["TrustyAI<br/>trustyai.opendatahub.io"]
    ODHDashboard -->|"CRD Watch"| MLflowCR["MLflow<br/>mlflow.opendatahub.io"]
    ODHDashboard -->|"CRD Watch"| FeastCR["Feast<br/>feast.dev"]
    ODHDashboard -->|"CRD Watch"| OLM["OLM<br/>operators.coreos.com"]
    ODHDashboard -->|"CRD CRUD"| ModelRegCR["ModelRegistry<br/>modelregistry.opendatahub.io"]
    ODHDashboard -->|"CRD CRUD"| Notebooks["Kubeflow Notebooks<br/>kubeflow.org"]
    ODHDashboard -->|"CRD CRUD"| GatewayAPI["Gateway API<br/>gateway.networking.k8s.io"]
    ODHDashboard -->|"CRD CRUD"| HWProfile["HardwareProfile CR"]
    ODHDashboard -->|"CRD CRUD"| PrometheusOp["prometheus-operator<br/>monitoring.coreos.com"]

    %% Infrastructure Dependencies
    ODHDashboard -->|"HTTPS/6443<br/>SA token + impersonation"| K8sAPI["Kubernetes API"]
    ODHDashboard -->|"TLS certs"| CertManager["cert-manager"]

    %% Platform Service Dependencies (REST/gRPC)
    ODHDashboard -->|"HTTPS/8443<br/>Bearer Token"| DSPipelines["DataScience<br/>Pipelines API"]
    ODHDashboard -->|"HTTPS/8443<br/>Bearer Token"| ModelRegAPI["Model Registry API"]
    ODHDashboard -->|"HTTPS<br/>Bearer Token"| KServeSvc["Model Serving<br/>(KServe)"]
    ODHDashboard -->|"gRPC-web/8443<br/>Bearer Token"| MLMD["ML Metadata<br/>(MLMD)"]
    ODHDashboard -->|"HTTPS/443<br/>Bearer Token"| TrustyAISvc["TrustyAI Service"]
    ODHDashboard -->|"HTTPS<br/>Session"| MLflowSvc["MLflow Tracking<br/>Server"]
    ODHDashboard -->|"HTTPS/9092<br/>Bearer Token"| Prometheus["Prometheus /<br/>Thanos"]

    %% External Service Dependencies
    ODHDashboard -->|"HTTPS<br/>Bearer/API Key"| LlamaStack["Llama Stack<br/>Server"]
    ODHDashboard -->|"HTTPS<br/>Bearer Token"| MaaSSvc["MaaS API<br/>Server"]
    ODHDashboard -->|"HTTPS<br/>API Key"| NeMo["NeMo<br/>Guardrails"]
    ODHDashboard -->|"SSE/HTTP<br/>X-MCP-Bearer"| MCPServers["MCP Servers"]

    %% Integration consumers
    ODHDashboard -.->|"UI integration"| Console["OpenShift Console<br/>ConsoleLinks"]

    %% Go Libraries
    ODHDashboard -->|"Go library"| ODHPlatUtils["odh-platform-<br/>utilities"]
    ODHDashboard -->|"Go library"| MLflowGo["mlflow-go"]

    %% Styling
    style ODHDashboard fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style RhodsOp fill:#bd10e0,stroke:#333,color:#fff

    %% Internal ODH (green)
    style DSCluster fill:#7ed321,stroke:#333,color:#fff
    style DSCInit fill:#7ed321,stroke:#333,color:#fff
    style KServe fill:#7ed321,stroke:#333,color:#fff
    style TrustyAI fill:#7ed321,stroke:#333,color:#fff
    style MLflowCR fill:#7ed321,stroke:#333,color:#fff
    style FeastCR fill:#7ed321,stroke:#333,color:#fff
    style ModelRegCR fill:#7ed321,stroke:#333,color:#fff
    style Notebooks fill:#7ed321,stroke:#333,color:#fff
    style HWProfile fill:#7ed321,stroke:#333,color:#fff
    style OLM fill:#7ed321,stroke:#333,color:#fff

    %% Infrastructure (grey)
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style CertManager fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style PrometheusOp fill:#999,stroke:#333,color:#fff
    style Console fill:#999,stroke:#333,color:#fff

    %% Platform Services (yellow)
    style DSPipelines fill:#f5a623,stroke:#333,color:#fff
    style ModelRegAPI fill:#f5a623,stroke:#333,color:#fff
    style KServeSvc fill:#f5a623,stroke:#333,color:#fff
    style MLMD fill:#f5a623,stroke:#333,color:#fff
    style TrustyAISvc fill:#f5a623,stroke:#333,color:#fff
    style MLflowSvc fill:#f5a623,stroke:#333,color:#fff
    style Prometheus fill:#f5a623,stroke:#333,color:#fff

    %% External Services (red)
    style LlamaStack fill:#d0021b,stroke:#333,color:#fff
    style MaaSSvc fill:#d0021b,stroke:#333,color:#fff
    style NeMo fill:#d0021b,stroke:#333,color:#fff
    style MCPServers fill:#d0021b,stroke:#333,color:#fff

    %% Libraries (teal)
    style ODHPlatUtils fill:#50e3c2,stroke:#333,color:#333
    style MLflowGo fill:#50e3c2,stroke:#333,color:#333
