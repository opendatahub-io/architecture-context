graph LR
    ODHObs["odh-observability<br/>Operator"]

    %% Platform Dependencies
    ODHObs -->|"CRD CRUD<br/>Prometheus, PodMonitor,<br/>ServiceMonitor"| PromOperator["prometheus-operator"]
    ODHObs -->|"Go library<br/>Platform detection,<br/>SSA deployment,<br/>status management"| PlatformUtils["odh-platform-utilities<br/>v0.1.0"]
    ODHObs -->|"operator framework<br/>v0.23.3"| ControllerRuntime["controller-runtime"]

    %% Kubernetes / OpenShift Dependencies
    ODHObs -->|"resource CRUD<br/>Watch, SSA<br/>:6443/TCP"| K8sAPI["Kubernetes API<br/>k8s.io/client-go v0.35.2"]
    ODHObs -->|"webhook TLS<br/>certificates"| CertManager["cert-manager"]
    ODHObs -->|"Prometheus TLS<br/>certificates"| ServiceCA["OpenShift service-ca"]
    ODHObs -->|"OpenShift Routes<br/>for external access"| OpenShift["OpenShift API<br/>openshift/api"]

    %% Data Plane Dependencies
    ODHObs -->|"metrics proxy<br/>:8443/TCP<br/>SubjectAccessReview"| KubeRbacProxy["kube-rbac-proxy"]
    ODHObs -->|"namespace-scoped<br/>metric filtering"| PromLabelProxy["prom-label-proxy"]
    ODHObs -->|"usage log<br/>forwarding"| LokiStack["LokiStack"]

    %% Runtime Dependencies
    ODHObs -->|"Go 1.25.7<br/>FIPS: strictfipsruntime"| GoRuntime["Go Runtime"]
    ODHObs -->|"base image"| UBI["UBI 9 minimal"]

    %% Go Module Dependencies
    ODHObs -->|"template rendering"| GoJQ["gojq v0.12.19"]
    ODHObs -->|"error handling"| MultiError["go-multierror v1.1.1"]
    ODHObs -->|"YAML parsing"| YAML["gopkg.in/yaml.v3"]

    %% Consumer Integration Points
    Dashboard["ODH Dashboard"] -.->|"may consume<br/>metrics"| ODHObs
    DSWorkloads["Data Science<br/>Workloads"] -.->|"scraped for<br/>metrics"| ODHObs

