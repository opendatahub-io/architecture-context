graph TB
    subgraph "llm-d Platform"
        subgraph "Container Images"
            DockerCPU["Dockerfile.cpu<br/>Ubuntu 22.04 Base<br/>vLLM (CPU)"]
            DockerCUDA["Dockerfile.cuda<br/>NVIDIA CUDA Base<br/>vLLM (GPU)"]
            DockerROCm["Dockerfile.rocm<br/>AMD ROCm Base<br/>vLLM (AMD)"]
            DockerXPU["Dockerfile.xpu<br/>Intel XPU Base<br/>vLLM (XPU)"]
        end

        subgraph "Model Server Layer"
            DecodeDeploy["decode Deployment<br/>vLLM OpenAI API Server<br/>Port 8000/TCP"]
            PrefillDeploy["prefill Deployment<br/>(P/D disaggregation mode)<br/>Port 8000/TCP"]
        end

        subgraph "Routing Layer (llm-d-router)"
            EPP["Endpoint Picker Plugin<br/>ext_proc gRPC<br/>Port 9002/TCP"]
            Envoy["Envoy Proxy<br/>ORIGINAL_DST routing<br/>Port 8081/TCP"]
        end

        subgraph "EPP Scoring Plugins"
            QueueScorer["queue-scorer"]
            KVCacheScorer["kv-cache-utilization-scorer"]
            PrefixCacheScorer["prefix-cache-scorer"]
            LRUScorer["no-hit-lru-scorer"]
        end
    end

    subgraph "Gateway API"
        Gateway["Gateway<br/>Port 80/HTTP"]
        InferencePoolCR["InferencePool CR"]
        InferenceModelCR["InferenceModel CR"]
    end

    subgraph "Observability"
        OTelCollector["OpenTelemetry Collector<br/>Port 4317/gRPC"]
        Prometheus["Prometheus<br/>(optional)"]
    end

    Client[External Client] -->|HTTP| Gateway
    Gateway -->|ext_proc| EPP
    EPP -->|scoring| QueueScorer
    EPP -->|scoring| KVCacheScorer
    EPP -->|scoring| PrefixCacheScorer
    EPP -->|scoring| LRUScorer
    Gateway -->|HTTP/8081| Envoy
    Envoy -->|"x-gateway-destination-endpoint<br/>HTTP/8000"| DecodeDeploy
    Envoy -->|"x-gateway-destination-endpoint<br/>HTTP/8000"| PrefillDeploy

    PrefillDeploy -->|"nixl KV cache transfer<br/>Port 5600/TCP"| DecodeDeploy

    InferencePoolCR -->|watched by| EPP
    InferenceModelCR -->|watched by| EPP

    EPP -->|traces| OTelCollector
    DecodeDeploy -.->|metrics| Prometheus
    PrefillDeploy -.->|metrics| Prometheus

    DockerCPU -->|builds| DecodeDeploy
    DockerCUDA -->|builds| DecodeDeploy
    DockerROCm -->|builds| DecodeDeploy
    DockerXPU -->|builds| DecodeDeploy

    style DecodeDeploy fill:#4a90e2,stroke:#333,stroke-width:2px
    style PrefillDeploy fill:#4a90e2,stroke:#333,stroke-width:2px
    style EPP fill:#f5a623,stroke:#333,stroke-width:2px
    style Envoy fill:#f5a623,stroke:#333,stroke-width:2px
    style Gateway fill:#7ed321,stroke:#333,stroke-width:2px
    style InferencePoolCR fill:#e8e8e8,stroke:#333
    style InferenceModelCR fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#b8e6d0,stroke:#333
    style Prometheus fill:#b8e6d0,stroke:#333
    style Client fill:#f9f9f9,stroke:#999,stroke-width:2px
