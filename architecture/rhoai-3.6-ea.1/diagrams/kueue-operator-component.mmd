graph TB
    subgraph OperatorTier["Operator Tier (ns: openshift-kueue-operator)"]
        Operator["openshift-kueue-operator<br/>Deployment<br/>(library-go static resource controller)"]
        OperatorSA["SA: openshift-kueue-operator"]
    end

    subgraph ControllerTier["Managed Controller (ns: kueue-system)"]
        Controller["kueue-controller-manager<br/>Deployment (single replica)"]
        ControllerSA["SA: kueue-controller-manager"]

        subgraph NetworkSurfaces["Network Surfaces"]
            Webhook["Webhook Server<br/>Port 9443/TCP<br/>TLS (cert-manager)"]
            Visibility["Visibility API Server<br/>Port 8082/TCP<br/>API aggregation"]
            Metrics["Metrics Endpoint<br/>Port 8443/TCP<br/>RBAC-protected HTTPS"]
            Health["Health/Ready Probes<br/>Port 8081/TCP<br/>/healthz, /readyz"]
        end

        Controller --> Webhook
        Controller --> Visibility
        Controller --> Metrics
        Controller --> Health
    end

    subgraph MustGather["Diagnostics"]
        MG["must-gather<br/>Container"]
    end

    %% Operator manages controller
    Operator -->|"reconciles<br/>(Kueue CR)"| Controller
    Operator -->|"manages RBAC,<br/>webhooks, CRDs,<br/>certs"| ControllerTier

    %% CRDs
    KueueCR["Kueue CR<br/>kueue.openshift.io/v1"] -->|"watched by"| Operator
    ClusterQueue["ClusterQueue CR<br/>kueue.x-k8s.io/v1beta1"] -->|"managed by"| Controller
    LocalQueue["LocalQueue CR<br/>kueue.x-k8s.io/v1beta1"] -->|"managed by"| Controller
    Workload["Workload CR<br/>kueue.x-k8s.io/v1beta1"] -->|"managed by"| Controller
    ResourceFlavor["ResourceFlavor CR<br/>kueue.x-k8s.io/v1beta1"] -->|"managed by"| Controller

    %% Workload types intercepted
    subgraph WorkloadTypes["Intercepted Workload Types"]
        Jobs["batch/Jobs"]
        PyTorch["PyTorchJob"]
        TFJob["TFJob"]
        MPIJob["MPIJob"]
        RayCluster["RayCluster"]
        RayJob["RayJob"]
        JobSet["JobSet"]
        AppWrapper["AppWrapper"]
        LWS["LeaderWorkerSet"]
        Deploy["Deployment"]
        STS["StatefulSet"]
        Pods["Pods"]
    end

    WorkloadTypes -->|"admission webhooks<br/>(mutate + validate)"| Webhook

    %% External dependencies
    Controller -->|"depends on"| CertManager["cert-manager"]
    Operator -->|"creates"| ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]
    Controller -->|"queries"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Styles
    style Operator fill:#4a90e2,stroke:#333,color:#fff
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#e8744f,stroke:#333,color:#fff
    style Visibility fill:#e8744f,stroke:#333,color:#fff
    style Metrics fill:#e8744f,stroke:#333,color:#fff
    style Health fill:#e8744f,stroke:#333,color:#fff
    style KueueCR fill:#f5a623,stroke:#333
    style ClusterQueue fill:#f5a623,stroke:#333
    style LocalQueue fill:#f5a623,stroke:#333
    style Workload fill:#f5a623,stroke:#333
    style ResourceFlavor fill:#f5a623,stroke:#333
    style CertManager fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style ServiceMonitor fill:#7ed321,stroke:#333
    style MG fill:#b8b8b8,stroke:#333
