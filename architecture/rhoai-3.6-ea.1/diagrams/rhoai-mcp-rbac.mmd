        PVCs["core<br/>persistentvolumeclaims"]
        Namespaces["core<br/>namespaces"]
        Secrets["core<br/>secrets"]
    end

    subgraph "Kubeflow Resources"
        Notebooks["kubeflow.org<br/>notebooks"]
    end

    subgraph "Training Resources"
        TrainJobs["trainer.kubeflow.org<br/>trainjobs"]
        TrainingRuntimes["trainer.kubeflow.org<br/>trainingruntimes"]
        ClusterTrainingRuntimes["trainer.kubeflow.org<br/>clustertrainingruntimes"]
    end

    subgraph "Serving Resources"
        InferenceServices["serving.kserve.io<br/>inferenceservices"]
        ServingRuntimes["serving.kserve.io<br/>servingruntimes"]
    end

    subgraph "Pipeline Resources"
        DSPApps["opendatahub.io<br/>datasciencepipelines-<br/>applications"]
    end

    subgraph "Storage Resources"
        StorageClasses["storage.k8s.io<br/>storageclasses"]
    end

