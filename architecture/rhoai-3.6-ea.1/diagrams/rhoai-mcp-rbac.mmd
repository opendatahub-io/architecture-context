graph TD
    subgraph "Service Account"
        SA["rhoai-mcp<br/>(namespace: rhoai-mcp)"]
    end

    subgraph "ClusterRole Binding"
        CRB["rhoai-mcp<br/>(ClusterRoleBinding)"]
    end

    subgraph "ClusterRole"
        CR["rhoai-mcp<br/>(ClusterRole)"]
    end

    subgraph "Core API Resources"
        Events["core<br/>events"]
        Nodes["core<br/>nodes"]
        Pods["core<br/>pods, pods/log"]
