graph TB
    subgraph "llm-d-router"
        subgraph "Endpoint Picker (EPP)"
            EPP[EPP gRPC Server<br/>Port 9002]
            HealthSvc[Health gRPC Server]
            MetricsSvc[Metrics HTTP Server<br/>Port 9090]

            subgraph "Plugin Pipeline"
                Scheduling[Scheduling Plugins]
                FlowControl[Flow Control Plugins]
                DataLayer[Data Layer Plugins]
                Parsing[Parsing Plugins]
            end

            subgraph "Controllers"
                PoolCtrl[InferencePool<br/>Controller]
                ModelRewriteCtrl[InferenceModelRewrite<br/>Controller]
                ObjectiveCtrl[InferenceObjective<br/>Controller]
                PodCtrl[Pod<br/>Controller]
            end

            Datastore[(In-Memory<br/>Datastore)]

            EPP -->|evaluates via| Scheduling
            Scheduling --> FlowControl
            FlowControl --> DataLayer
            DataLayer --> Parsing

            PoolCtrl -->|populates| Datastore
            ModelRewriteCtrl -->|populates| Datastore
            ObjectiveCtrl -->|populates| Datastore
            PodCtrl -->|populates| Datastore

            Scheduling -->|reads| Datastore
        end

        subgraph "pd-sidecar"
            Sidecar[DNS-Aware<br/>Routing Proxy]
            SidecarMetrics[Sidecar Metrics<br/>HTTP Listener]
        end

        subgraph "coordinator"
            Coord[Coordinator<br/>Multi-Instance Orchestrator]
            CoordHealth[/healthz, /readyz/]
        end
    end

    %% External Interactions
    Envoy[Envoy Proxy] -->|gRPC ExtProc<br/>Port 9002| EPP
    EPP -->|routing decision| Envoy
    Envoy -->|forwards request| BackendPod[Model-Serving Pod]

    %% CRDs
    EPCConfig[EndpointPickerConfig CR<br/>llm-d.ai/v1alpha1] -->|configures| EPP
    InfPool[InferencePool CR] -->|watched by| PoolCtrl
    InfModelRewrite[InferenceModelRewrite CR<br/>llm-d.ai/v1alpha2] -->|watched by| ModelRewriteCtrl
    InfObjective[InferenceObjective CR<br/>llm-d.ai/v1alpha2] -->|watched by| ObjectiveCtrl
    Pods[Pod Resources] -->|watched by| PodCtrl

    %% External Dependencies
    PoolCtrl -->|watches via| K8sAPI[Kubernetes API<br/>6443/TCP TLS]
    ModelRewriteCtrl -->|watches via| K8sAPI
    ObjectiveCtrl -->|watches via| K8sAPI
    PodCtrl -->|watches via| K8sAPI

    MetricsSvc -->|scraped by| Prometheus[Prometheus]
    EPP -.->|traces via OTLP/gRPC| OTelCollector[OpenTelemetry<br/>Collector]

    %% Styling
    style EPP fill:#4a90e2,stroke:#333,color:#fff
    style HealthSvc fill:#4a90e2,stroke:#333,color:#fff
    style MetricsSvc fill:#4a90e2,stroke:#333,color:#fff
    style Sidecar fill:#4a90e2,stroke:#333,color:#fff
    style SidecarMetrics fill:#4a90e2,stroke:#333,color:#fff
    style Coord fill:#4a90e2,stroke:#333,color:#fff
    style CoordHealth fill:#4a90e2,stroke:#333,color:#fff
    style Datastore fill:#e8d44d,stroke:#333
    style Envoy fill:#999,stroke:#333,color:#fff
    style K8sAPI fill:#999,stroke:#333,color:#fff
    style Prometheus fill:#999,stroke:#333,color:#fff
    style OTelCollector fill:#999,stroke:#333,color:#fff
    style BackendPod fill:#7ed321,stroke:#333
    style EPCConfig fill:#f5a623,stroke:#333
    style InfPool fill:#f5a623,stroke:#333
    style InfModelRewrite fill:#f5a623,stroke:#333
    style InfObjective fill:#f5a623,stroke:#333
    style Pods fill:#f5a623,stroke:#333
