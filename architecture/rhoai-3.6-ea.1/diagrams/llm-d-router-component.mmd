graph TB
    subgraph "llm-d-router"
        subgraph EPP["Endpoint Picker (EPP)"]
            ExtProcServer["ExtProc gRPC Server<br/>Port 9002"]
            HealthServer["Health gRPC Server<br/>Port 9003"]
            MetricsEndpoint["Metrics Endpoint<br/>Port 9090"]
            ZMQPort["ZMQ Interface<br/>Port 5557"]

            subgraph PluginPipeline["Plugin Pipeline"]
                Scheduler["Scheduling Plugin"]
                FlowControl["Flow Control Plugin"]
                DataLayer["Data Layer Plugin"]
                RequestParser["Request Parser Plugin"]
            end

            subgraph Controllers["Controller Layer"]
                PodReconciler["Pod Reconciler"]
                PoolReconciler["InferencePool Reconciler"]
                ModelRewriteReconciler["InferenceModelRewrite Reconciler"]
                ObjectiveReconciler["InferenceObjective Reconciler"]
            end

            Datastore["Live Endpoint Datastore"]
        end

        Coordinator["coordinator<br/>Config Orchestrator"]
        PDSidecar["pd-sidecar<br/>Routing Sidecar<br/>(FIPS: strictfipsruntime)"]
    end

    %% External Inputs
    EnvoyProxy["Envoy Proxy"] -->|"ExtProc gRPC<br/>per-request callout"| ExtProcServer

    %% CRDs
    EPConfig["EndpointPickerConfig CR<br/>llm-d.ai/v1alpha1"] -.->|configures| PluginPipeline
    ModelRewriteCR["InferenceModelRewrite CR<br/>llm-d.ai/v1alpha2"] -->|"watched by"| ModelRewriteReconciler
    ObjectiveCR["InferenceObjective CR<br/>llm-d.ai/v1alpha2"] -->|"watched by"| ObjectiveReconciler
    PoolCR["InferencePool CR<br/>inference.networking.k8s.io/v1"] -->|"watched by"| PoolReconciler

    %% Pod watching
    BackendPods["Backend Model-Server Pods"] -->|"watched by"| PodReconciler
    PodReconciler -->|updates| Datastore

    %% Plugin pipeline flow
    ExtProcServer -->|"evaluates via"| PluginPipeline
    PluginPipeline -->|"reads state"| Datastore
    PluginPipeline -->|"selects endpoint"| ExtProcServer

    %% External integrations
    PoolReconciler -->|"conditional integration"| GAIE["gateway-api-inference-extension<br/>Pool Autoscaling"]
    PluginPipeline -->|"KV-cache aware"| KVCache["llm-d-kv-cache"]

    %% Observability
    EPP -->|"OTLP/gRPC traces"| OTelCollector["OpenTelemetry Collector"]
    MetricsEndpoint -->|"scraped by"| Prometheus["Prometheus"]

    %% Kubernetes API
    Controllers -->|"watch/reconcile"| K8sAPI["Kubernetes API<br/>6443/HTTPS"]

    %% Styling
    style EPP fill:#4a90e2,stroke:#333,color:#fff
    style ExtProcServer fill:#2c6fb5,stroke:#333,color:#fff
    style HealthServer fill:#2c6fb5,stroke:#333,color:#fff
    style MetricsEndpoint fill:#2c6fb5,stroke:#333,color:#fff
    style Coordinator fill:#4a90e2,stroke:#333,color:#fff
    style PDSidecar fill:#4a90e2,stroke:#333,color:#fff
    style PluginPipeline fill:#5ba3d9,stroke:#333,color:#fff
    style Controllers fill:#5ba3d9,stroke:#333,color:#fff
    style EnvoyProxy fill:#e8e8e8,stroke:#333
    style EPConfig fill:#f5a623,stroke:#333
    style ModelRewriteCR fill:#f5a623,stroke:#333
    style ObjectiveCR fill:#f5a623,stroke:#333
    style PoolCR fill:#f5a623,stroke:#333
    style BackendPods fill:#e8e8e8,stroke:#333
    style GAIE fill:#7ed321,stroke:#333
    style KVCache fill:#7ed321,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
