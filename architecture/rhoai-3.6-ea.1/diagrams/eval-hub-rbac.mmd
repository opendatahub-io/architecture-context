graph TD
    subgraph "Application-Level Identity"
        IdentityMiddleware["Identity Middleware<br/>(cluster mode only)"]
        XUser["X-User Header<br/>(injected by gateway)"]
        XTenant["X-Tenant Header<br/>(injected by gateway)"]
    end

    subgraph "Protected Endpoints"
        EvalJobs["/api/v1/evaluations/jobs<br/>ALL methods"]
        EvalCollections["/api/v1/evaluations/collections<br/>ALL methods"]
        EvalProviders["/api/v1/evaluations/providers<br/>ALL methods"]
    end

    subgraph "Exempt Endpoints (No Auth)"
        Health["/api/v1/health<br/>GET"]
        Docs["/docs<br/>GET"]
        OpenAPI["/openapi.yaml<br/>GET"]
        Metrics["/metrics<br/>GET"]
    end

    subgraph "Kubernetes API Access"
        SA["ServiceAccount<br/>(eval-hub pod)"]
        KubeAuth["kubeconfig credential chain"]
    end

    subgraph "Kubernetes Resources Managed"
        Jobs["batch/v1 Jobs<br/>create"]
        ConfigMaps["v1 ConfigMaps<br/>create"]
        Secrets["v1 Secrets<br/>create"]
        HWProfiles["HardwareProfile CRs<br/>infrastructure.opendatahub.io/v1<br/>get, delete"]
    end

    subgraph "Sidecar Credential Injection"
        SecretMount["Mounted K8s Secret<br/>(credential source)"]
        SidecarProxy["eval-runtime-sidecar<br/>(reverse proxy)"]
        PlaceholderKey["Placeholder API Key<br/>(from eval adapter)"]
        RealKey["Real API Key<br/>(injected into request)"]
    end

    %% Identity flow
    XUser -->|"required in cluster mode"| IdentityMiddleware
    XTenant -->|"required in cluster mode"| IdentityMiddleware
    IdentityMiddleware -->|"enforces on"| EvalJobs
    IdentityMiddleware -->|"enforces on"| EvalCollections
    IdentityMiddleware -->|"enforces on"| EvalProviders

    %% K8s RBAC flow
    SA -->|"authenticates via"| KubeAuth
    KubeAuth -->|"authorizes access to"| Jobs
    KubeAuth -->|"authorizes access to"| ConfigMaps
    KubeAuth -->|"authorizes access to"| Secrets
    KubeAuth -->|"authorizes access to"| HWProfiles

    %% Sidecar credential flow
    SecretMount -->|"provides credentials"| SidecarProxy
    PlaceholderKey -->|"sent by adapter"| SidecarProxy
    SidecarProxy -->|"forwards with"| RealKey

    style IdentityMiddleware fill:#4a90e2,stroke:#333,color:#fff
    style XUser fill:#f5a623,stroke:#333
    style XTenant fill:#f5a623,stroke:#333
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style KubeAuth fill:#4a90e2,stroke:#333,color:#fff
    style EvalJobs fill:#7ed321,stroke:#333
    style EvalCollections fill:#7ed321,stroke:#333
    style EvalProviders fill:#7ed321,stroke:#333
    style Health fill:#e8e8e8,stroke:#333
    style Docs fill:#e8e8e8,stroke:#333
    style OpenAPI fill:#e8e8e8,stroke:#333
    style Metrics fill:#e8e8e8,stroke:#333
    style Jobs fill:#dbeafe,stroke:#333
    style ConfigMaps fill:#dbeafe,stroke:#333
    style Secrets fill:#dbeafe,stroke:#333
    style HWProfiles fill:#dbeafe,stroke:#333
    style SecretMount fill:#f5a623,stroke:#333
    style SidecarProxy fill:#50c878,stroke:#333,color:#fff
    style PlaceholderKey fill:#ff6b6b,stroke:#333,color:#fff
    style RealKey fill:#7ed321,stroke:#333
