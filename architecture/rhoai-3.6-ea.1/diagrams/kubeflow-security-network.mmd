graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / ODH Dashboard"]
    end

    subgraph K8sAPIZone["KUBERNETES API"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Bearer Token / SA"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (Trusted)"]
        direction TB

        subgraph ODH["odh-notebook-controller<br/>SA: manager"]
            MutatingWH["Mutating Webhook<br/>/mutate-notebook-v1<br/>8443/TCP HTTPS TLS<br/>FailurePolicy: Fail"]
            ValidatingWH["Validating Webhook<br/>/validate-notebook-v1<br/>8443/TCP HTTPS TLS<br/>FailurePolicy: Fail"]
            ConversionWH["Conversion Webhook<br/>/convert<br/>HTTPS TLS"]
            ODH_Health["Health: :8081<br/>healthz/readyz<br/>HTTP, no auth"]
        end

        subgraph NC["notebook-controller<br/>SA: notebook-controller-service-account"]
            NC_Mgr["Controller Manager"]
            NC_Health["Health: :8081<br/>healthz/readyz<br/>HTTP, no auth"]
        end

        SVC["notebook-controller-service<br/>ClusterIP 443/TCP<br/>Internal only"]
    end

    subgraph UserNS["USER NAMESPACE (Per-notebook)"]
        subgraph NotebookPod["Notebook Pod"]
            Proxy["kube-rbac-proxy sidecar<br/>TLS + Token Auth<br/>X-Auth-Request-User/Groups"]
            Notebook["Notebook Container<br/>localhost"]
        end
        NP["NetworkPolicy<br/>Pod isolation"]
    end

    subgraph CentralNS["CENTRAL GATEWAY NAMESPACE"]
        HTTPRoute["HTTPRoute<br/>Labels: notebook-name/namespace<br/>Finalizers for cleanup"]
        RefGrant["ReferenceGrant<br/>Cross-namespace auth"]
        Gateway["data-science-gateway"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES"]
        APIServer["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile config"]
        DSPA["DataSciencePipelinesApplication<br/>Optional pipeline integration"]
        ImageStreams["OpenShift Image Streams<br/>6443/TCP HTTPS"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"HTTPS/8443<br/>TLS<br/>Admission"| MutatingWH
    K8sAPI -->|"HTTPS/8443<br/>TLS<br/>Admission"| ValidatingWH
    K8sAPI -->|"HTTPS<br/>TLS<br/>Conversion"| ConversionWH

    MutatingWH -->|"Injects kube-rbac-proxy<br/>+ stop annotation lock"| NotebookPod
    Proxy -->|"Authenticated<br/>localhost"| Notebook

    NC_Mgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    ODH -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ODH -->|"reads TLS profile"| APIServer
    ODH -->|"reads DSPA CR<br/>(optional)"| DSPA
    ODH -->|"creates"| HTTPRoute
    ODH -->|"creates"| RefGrant
    ODH -->|"creates"| NP

    HTTPRoute --> Gateway
    RefGrant -->|"authorizes"| UserNS

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef gateway fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class K8sAPI apiserver
    class MutatingWH,ValidatingWH,ConversionWH,ODH_Health,NC_Mgr,NC_Health,SVC controller
    class Proxy,Notebook,NP userns
    class HTTPRoute,RefGrant,Gateway gateway
    class APIServer,DSPA,ImageStreams platform
