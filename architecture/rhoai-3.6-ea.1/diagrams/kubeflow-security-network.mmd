graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / User"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        Gateway["data-science-gateway<br/>openshift-ingress<br/>443/TCP<br/>TLS 1.2+<br/>HTTPRoute: /notebook/ns/name"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (system)"]
        direction TB

        subgraph UpstreamCtrl["notebook-controller"]
            NotebookCtrl["NotebookReconciler<br/>SA: notebook-controller-service-account<br/>Webhook: 8443/TCP TLS<br/>Health: 8081/TCP HTTP"]
        end

        subgraph DownstreamCtrl["odh-notebook-controller"]
            ODHCtrl["OpenshiftNotebookReconciler<br/>SA: manager<br/>Webhook: 8443/TCP TLS<br/>Health: 8081/TCP HTTP<br/>TLS: APIServer profile / Mozilla Intermediate<br/>FIPS: strictfipsruntime"]
        end

        subgraph Webhooks["Admission Webhooks (8443/TCP TLS)"]
            MutWH["/mutate-notebook-v1<br/>MutatingWebhook<br/>failurePolicy: Fail<br/>CREATE, UPDATE"]
            ValWH["/validate-notebook-v1<br/>ValidatingWebhook<br/>failurePolicy: Fail<br/>UPDATE"]
            ConvWH["/convert<br/>ConversionWebhook<br/>v1alpha1/v1beta1/v1"]
        end
    end

    subgraph UserNS["WORKBENCH NAMESPACE (user namespace)"]
        NotebookPod["Notebook Pod<br/>Container: workbench<br/>Sidecar: kube-rbac-proxy<br/>NetworkPolicy: isolated"]
        NotebookSvc["notebook-controller-service<br/>ClusterIP 443/TCP"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
        DSPACr["DataSciencePipelinesApplication<br/>opendatahub.io"]
        ImageStreams["OpenShift ImageStreams<br/>image.openshift.io"]
        ProxyConfig["OpenShift Proxy<br/>config.openshift.io"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>OAuth / Bearer Token"| Gateway

    %% Ingress to Workbench
    Gateway -->|"HTTPS/443<br/>TLS<br/>kube-rbac-proxy auth"| NotebookSvc
    NotebookSvc --> NotebookPod

    %% K8s API Admission chain
    User -->|"kubectl create Notebook"| K8sAPI
    K8sAPI -->|"Admission/8443<br/>TLS<br/>K8s Admission"| MutWH
    K8sAPI -->|"Admission/8443<br/>TLS<br/>K8s Admission"| ValWH
    K8sAPI -->|"Conversion/8443<br/>TLS"| ConvWH

    %% Controllers to K8s API
    NotebookCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ODHCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% ODH Controller reads
    ODHCtrl -.->|"read"| DSPACr
    ODHCtrl -.->|"read"| ImageStreams
    ODHCtrl -.->|"read"| ProxyConfig

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controller fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef webhook fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class User external
    class Gateway ingress
    class NotebookCtrl,ODHCtrl controller
    class MutWH,ValWH,ConvWH webhook
    class NotebookPod,NotebookSvc workbench
    class K8sAPI,DSPACr,ImageStreams,ProxyConfig cluster
