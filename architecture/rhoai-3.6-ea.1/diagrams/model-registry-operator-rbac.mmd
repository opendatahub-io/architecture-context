graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator-<br/>controller-manager"]
        SA_Registry["{registry-name}"]
        SA_Catalog["model-catalog"]
        SA_CM["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator-<br/>manager-rolebinding"]
        CRB_Metrics["model-registry-operator-<br/>metrics-auth-rolebinding"]
        CRB_AuthDeleg_Reg["{registry-name}-<br/>auth-delegator"]
        CRB_AuthDeleg_Cat["model-catalog-<br/>auth-delegator"]
        CRB_ManagerAlt["manager-rolebinding"]
        CRB_MetricsAlt["metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_LeaderElection["leader-election-<br/>rolebinding"]
        RB_CatAdmin["model-catalog-<br/>admin-binding"]
        RB_CatAuth["model-catalog-<br/>authenticated"]
        RB_RegUsers["{registry-name}-<br/>users"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-<br/>manager-role"]
        CR_Metrics["model-registry-operator-<br/>metrics-auth-role"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_ManagerAlt["manager-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_LeaderElection["leader-election-role"]
        R_CatAdmin["model-catalog-admin"]
        R_Cat["model-catalog"]
        R_RegUser["registry-user-{name}"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        Res_Core["core: configmaps, pvcs,<br/>secrets, serviceaccounts,<br/>services, endpoints, pods"]
        Res_Apps["apps: deployments"]
        Res_MR["modelregistry.opendatahub.io:<br/>modelregistries,<br/>modelregistries/finalizers,<br/>modelregistries/status"]
        Res_Gateway["gateway.networking.k8s.io:<br/>httproutes, referencegrants"]
        Res_Routes["route.openshift.io:<br/>routes, routes/custom-host"]
        Res_RBAC["rbac.authorization.k8s.io:<br/>clusterrolebindings,<br/>rolebindings, roles"]
        Res_NetPol["networking.k8s.io:<br/>networkpolicies"]
        Res_Auth["authentication.k8s.io:<br/>tokenreviews<br/>authorization.k8s.io:<br/>subjectaccessreviews"]
        Res_Migration["migration.k8s.io:<br/>storageversionmigrations"]
        Res_Users["user.openshift.io:<br/>groups"]
        Res_Platform["components.platform:<br/>modelregistries<br/>services.platform:<br/>auths"]
    end

    subgraph UserResources["User Role Resources"]
        Res_RegAccess["core: endpoints, services<br/>Verbs: get"]
        Res_CatAccess["core: configmaps, secrets<br/>Verbs: get, list, patch,<br/>update, watch"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    SA_Operator -->|bound via| CRB_Metrics
    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics

    %% Alt SA bindings
    SA_CM -->|bound via| CRB_ManagerAlt
    SA_CM -->|bound via| CRB_MetricsAlt
    CRB_ManagerAlt -->|grants| CR_ManagerAlt

    %% Auth delegator bindings
    SA_Registry -->|bound via| CRB_AuthDeleg_Reg
    SA_Catalog -->|bound via| CRB_AuthDeleg_Cat
    CRB_AuthDeleg_Reg -->|grants| CR_AuthDeleg
    CRB_AuthDeleg_Cat -->|grants| CR_AuthDeleg

    %% Leader election
    SA_Operator -->|bound via| RB_LeaderElection
    RB_LeaderElection -->|grants| R_LeaderElection

    %% Catalog user roles
    RB_CatAdmin -->|grants| R_CatAdmin
    RB_CatAuth -->|grants| R_Cat
    RB_RegUsers -->|grants| R_RegUser

    %% Manager role → resources
    CR_Manager -->|"CRUD"| Res_Core
    CR_Manager -->|"CRUD"| Res_Apps
    CR_Manager -->|"CRUD"| Res_MR
    CR_Manager -->|"CRUD"| Res_Gateway
    CR_Manager -->|"CRUD"| Res_Routes
    CR_Manager -->|"CRUD"| Res_RBAC
    CR_Manager -->|"CRUD"| Res_NetPol
    CR_Manager -->|"create"| Res_Auth
    CR_Manager -->|"CRUD"| Res_Migration
    CR_Manager -->|"CRUD"| Res_Users
    CR_Manager -->|"read"| Res_Platform

    %% User roles → resources
    R_RegUser -->|"get"| Res_RegAccess
    R_CatAdmin -->|"read/write"| Res_CatAccess

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Registry fill:#4a90e2,stroke:#333,color:#fff
    style SA_Catalog fill:#4a90e2,stroke:#333,color:#fff
    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333,color:#fff
    style CR_Metrics fill:#f5a623,stroke:#333,color:#fff
    style CR_Admin fill:#f5a623,stroke:#333,color:#fff
    style CR_Editor fill:#f5a623,stroke:#333,color:#fff
    style CR_Viewer fill:#f5a623,stroke:#333,color:#fff
    style CR_AuthDeleg fill:#f5a623,stroke:#333,color:#fff
    style CR_ManagerAlt fill:#f5a623,stroke:#333,color:#fff
    style R_LeaderElection fill:#e8a623,stroke:#333,color:#fff
    style R_CatAdmin fill:#e8a623,stroke:#333,color:#fff
    style R_Cat fill:#e8a623,stroke:#333,color:#fff
    style R_RegUser fill:#e8a623,stroke:#333,color:#fff
    style Res_Core fill:#7ed321,stroke:#333,color:#fff
    style Res_Apps fill:#7ed321,stroke:#333,color:#fff
    style Res_MR fill:#7ed321,stroke:#333,color:#fff
    style Res_Gateway fill:#7ed321,stroke:#333,color:#fff
    style Res_Routes fill:#7ed321,stroke:#333,color:#fff
    style Res_RBAC fill:#7ed321,stroke:#333,color:#fff
    style Res_NetPol fill:#7ed321,stroke:#333,color:#fff
    style Res_Auth fill:#7ed321,stroke:#333,color:#fff
    style Res_Migration fill:#7ed321,stroke:#333,color:#fff
    style Res_Users fill:#7ed321,stroke:#333,color:#fff
    style Res_Platform fill:#7ed321,stroke:#333,color:#fff
    style Res_RegAccess fill:#7ed321,stroke:#333,color:#fff
    style Res_CatAccess fill:#7ed321,stroke:#333,color:#fff
