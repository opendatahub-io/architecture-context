graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator-<br/>controller-manager"]
        SA_Registry["{registry-name}<br/>(per-instance)"]
        SA_Catalog["model-catalog"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator-<br/>manager-rolebinding"]
        CRB_Metrics["model-registry-operator-<br/>metrics-auth-rolebinding"]
        CRB_RegAuthDeleg["{registry-name}-<br/>auth-delegator"]
        CRB_CatAuthDeleg["model-catalog-<br/>auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-<br/>manager-role"]
        CR_Metrics["model-registry-operator-<br/>metrics-auth-role"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
    end

    subgraph RoleBindings["Namespace Role Bindings (per-instance)"]
        RB_Leader["leader-election-rolebinding"]
        RB_RegUsers["{registry-name}-users"]
        RB_CatAdmin["model-catalog-admin-binding"]
        RB_CatAuth["model-catalog-authenticated"]
    end

    subgraph Roles["Namespace Roles (per-instance)"]
        R_Leader["leader-election-role"]
        R_RegUser["registry-user-{registry-name}"]
        R_CatAdmin["model-catalog-admin"]
        R_Cat["model-catalog"]
    end

    subgraph ManagerResources["Manager Role Resources"]
        direction TB
        Res_Core["Core API<br/>configmaps, PVCs, secrets,<br/>serviceaccounts, services<br/><i>create,delete,get,list,<br/>patch,update,watch</i>"]
        Res_CoreRO["Core API (read-only)<br/>endpoints, pods, pods/log<br/><i>get, list, watch</i>"]
        Res_Apps["apps<br/>deployments<br/><i>full CRUD</i>"]
        Res_MR["modelregistry.opendatahub.io<br/>modelregistries<br/><i>full CRUD + finalizers + status</i>"]
        Res_Network["networking.k8s.io<br/>networkpolicies<br/><i>full CRUD</i>"]
        Res_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>rolebindings, roles<br/><i>full CRUD</i>"]
        Res_Routes["route.openshift.io<br/>routes, routes/custom-host<br/><i>full CRUD</i>"]
        Res_Gateway["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/><i>full CRUD / create,read</i>"]
        Res_Migration["migration.k8s.io<br/>storageversionmigrations<br/><i>full CRUD</i>"]
        Res_Auth["authentication/authorization<br/>tokenreviews,<br/>subjectaccessreviews<br/><i>create</i>"]
        Res_Platform["Platform APIs (read-only)<br/>components...modelregistries<br/>services...auths<br/><i>get, list, watch</i>"]
        Res_Users["user.openshift.io<br/>groups<br/><i>create,delete,get,<br/>list,update,watch</i>"]
    end

    subgraph PerInstanceResources["Per-Instance Role Resources"]
        Res_RegUser["Core API<br/>endpoints, services<br/><i>get</i>"]
        Res_CatAdminRes["Core API<br/>configmaps, secrets<br/><i>get,list,patch,update,watch</i>"]
    end

    %% SA → CRB → CR connections
    SA_Operator -->|"bound via"| CRB_Manager
    SA_Operator -->|"bound via"| CRB_Metrics
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_Metrics

    %% Auth delegation
    SA_Registry -->|"bound via"| CRB_RegAuthDeleg
    SA_Catalog -->|"bound via"| CRB_CatAuthDeleg
    CRB_RegAuthDeleg -->|"grants"| CR_AuthDeleg
    CRB_CatAuthDeleg -->|"grants"| CR_AuthDeleg

    %% Namespace role bindings
    SA_Operator -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| R_Leader
    RB_RegUsers -->|"grants to<br/>Group/{registry-name}-users"| R_RegUser
    RB_CatAdmin -->|"grants to<br/>Group/{template-value}"| R_CatAdmin
    RB_CatAuth -->|"grants to<br/>Group/system:authenticated"| R_Cat

    %% CR → Resources
    CR_Manager -->|"manages"| Res_Core
    CR_Manager -->|"reads"| Res_CoreRO
    CR_Manager -->|"manages"| Res_Apps
    CR_Manager -->|"manages"| Res_MR
    CR_Manager -->|"manages"| Res_Network
    CR_Manager -->|"manages"| Res_RBAC
    CR_Manager -->|"manages"| Res_Routes
    CR_Manager -->|"manages"| Res_Gateway
    CR_Manager -->|"manages"| Res_Migration
    CR_Manager -->|"creates"| Res_Auth
    CR_Manager -->|"reads"| Res_Platform
    CR_Manager -->|"manages"| Res_Users

    %% Per-instance roles → resources
    R_RegUser -->|"grants"| Res_RegUser
    R_CatAdmin -->|"grants"| Res_CatAdminRes
    R_Cat -->|"grants"| Res_RegUser

    %% Styling
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Registry fill:#4a90e2,stroke:#333,color:#fff
    style SA_Catalog fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Metrics fill:#f5a623,stroke:#333
    style CR_AuthDeleg fill:#f5a623,stroke:#333
    style CR_Admin fill:#f5a623,stroke:#333
    style CR_Editor fill:#f5a623,stroke:#333
    style CR_Viewer fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style R_RegUser fill:#f5a623,stroke:#333
    style R_CatAdmin fill:#f5a623,stroke:#333
    style R_Cat fill:#f5a623,stroke:#333
    style Res_MR fill:#7ed321,stroke:#333
    style Res_Core fill:#7ed321,stroke:#333
    style Res_Apps fill:#7ed321,stroke:#333
    style Res_Network fill:#7ed321,stroke:#333
    style Res_RBAC fill:#7ed321,stroke:#333
    style Res_Routes fill:#7ed321,stroke:#333
    style Res_Gateway fill:#7ed321,stroke:#333
    style Res_Migration fill:#7ed321,stroke:#333
    style Res_Auth fill:#7ed321,stroke:#333
    style Res_Platform fill:#7ed321,stroke:#333
    style Res_Users fill:#7ed321,stroke:#333
    style Res_RegUser fill:#7ed321,stroke:#333
    style Res_CatAdminRes fill:#7ed321,stroke:#333
