graph TB
    subgraph Upstream["UPSTREAM CALLER"]
        Orchestrator["FMS Guardrails Orchestrator<br/>Upstream caller"]
    end

    subgraph DetectorPods["DETECTOR PODS (Internal - Cluster Network)"]
        direction TB

        subgraph BuiltInPod["Built-in Detector Pod"]
            BuiltIn["Built-in Detector<br/>/app/bin/regex-detector<br/>8080/TCP HTTP<br/>Auth: None<br/>TLS: Not enabled"]
        end

        subgraph HFPod["HuggingFace Detector Pod"]
            HF["HuggingFace Detector<br/>uvicorn --workers 1<br/>8000/TCP HTTP<br/>Auth: None<br/>TLS: Not enabled"]
        end

        subgraph JudgePod["LLM Judge Detector Pod"]
            Judge["LLM Judge Detector<br/>uvicorn --workers 4<br/>8000/TCP HTTP<br/>Auth: None<br/>TLS: Not enabled"]
        end

        subgraph Storage["Internal Storage"]
            MinIO["MinIO<br/>minio-guardrails-guardian<br/>ClusterIP 9000/TCP<br/>Opaque secret auth"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        vLLM["vLLM Inference Server<br/>VLLM_BASE_URL<br/>HTTP/HTTPS<br/>Auth: Unknown"]
    end

    subgraph Monitoring["MONITORING"]
        Prom["Prometheus<br/>Metrics Scraper"]
    end

    %% Upstream flows
    Orchestrator -->|"HTTP POST 8080/TCP<br/>/api/v1/text/contents<br/>No Auth, No TLS default"| BuiltIn
    Orchestrator -->|"HTTP POST 8000/TCP<br/>/api/v1/text/contents<br/>No Auth, No TLS default"| HF
    Orchestrator -->|"HTTP POST 8000/TCP<br/>/api/v1/text/contents<br/>No Auth, No TLS default"| Judge

    %% Internal flows
    HF -->|"TCP 9000<br/>Opaque secret credentials"| MinIO

    %% Egress flows
    Judge -->|"HTTP/HTTPS<br/>VLLM_BASE_URL env var<br/>Auth: Unknown"| vLLM

    %% Metrics
    Prom -->|"GET /metrics<br/>HTTP"| BuiltIn
    Prom -->|"GET /metrics<br/>HTTP"| HF
    Prom -->|"GET /metrics<br/>HTTP"| Judge

    %% Styling
    classDef upstream fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef detector fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Orchestrator upstream
    class BuiltIn,HF,Judge detector
    class MinIO storage
    class vLLM external
    class Prom monitoring
