graph TB
    subgraph Manager["TrustyAI Service Operator (controller-manager)"]
        direction TB

        subgraph Explainability["Explainability Domain"]
            TrustyAICtrl[TrustyAI Controller]
            TASCtrl[TrustyAIService Controller]
        end

        subgraph Evaluation["Evaluation Domain"]
            EvalHubCtrl[EvalHub Controller]
            LMEvalCtrl[LMEvalJob Controller]
            JobCtrl[Job Controller]
            WorkloadCtrl[Workload Controller]
        end

        subgraph Guardrails["Guardrails Domain"]
            GORCtrl[GuardrailsOrchestrator Controller]
            NemoCtrl[NemoGuardrails Controller]
        end

        WebhookSrv[Webhook Server<br/>:9443 TLS<br/>CRD Conversion]
        MetricsSrv[Metrics Server<br/>:8080]
    end

    subgraph CRDs["Custom Resource Definitions"]
        TrustyAICR[TrustyAI CR<br/>Cluster-scoped]
        TASCR[TrustyAIService CR<br/>Namespaced]
        EvalHubCR[EvalHub CR<br/>Namespaced]
        LMEvalCR[LMEvalJob CR<br/>Namespaced]
        GORCR[GuardrailsOrchestrator CR<br/>Namespaced]
        NemoCR[NemoGuardrails CR<br/>Namespaced]
    end

    subgraph TASPod["TrustyAI Service Pod (per instance)"]
        RBACProxy[kube-rbac-proxy<br/>:8443 TLS]
        QuarkusSvc[TrustyAI Quarkus<br/>localhost:8080]
        RBACProxy -->|proxy| QuarkusSvc
    end

    %% CRD watches
    TrustyAICtrl -->|reconciles| TrustyAICR
    TASCtrl -->|reconciles| TASCR
    EvalHubCtrl -->|reconciles| EvalHubCR
    LMEvalCtrl -->|reconciles| LMEvalCR
    GORCtrl -->|reconciles| GORCR
    NemoCtrl -->|reconciles| NemoCR

    %% TrustyAIService creates pods
    TASCtrl -->|creates| TASPod

    %% Webhook conversions
    EvalHubCR -.->|v1 ↔ v1alpha1| WebhookSrv
    TASCR -.->|v1 ↔ v1alpha1| WebhookSrv

    %% External interactions
    TASCtrl -->|watches| InferenceService[KServe InferenceService]
    GORCtrl -->|watches| InferenceService
    EvalHubCtrl -.->|conditional| ServiceMonitor[ServiceMonitor]
    EvalHubCtrl -.->|optional| KueueWorkload[Kueue Workload]

    %% Platform config
    Manager -->|reads| DSCConfig[DSC ConfigMap<br/>trustyai-dsc-config]
    Manager -->|reads| TLSProfile[OpenShift TLS Profile<br/>apiservers.config.openshift.io]

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style Explainability fill:#5ba3f5,stroke:#333,color:#fff
    style Evaluation fill:#5ba3f5,stroke:#333,color:#fff
    style Guardrails fill:#5ba3f5,stroke:#333,color:#fff
    style TASPod fill:#7ed321,stroke:#333
    style RBACProxy fill:#f5a623,stroke:#333
    style QuarkusSvc fill:#7ed321,stroke:#333
    style TrustyAICR fill:#f5a623,stroke:#333
    style TASCR fill:#f5a623,stroke:#333
    style EvalHubCR fill:#f5a623,stroke:#333
    style LMEvalCR fill:#f5a623,stroke:#333
    style GORCR fill:#f5a623,stroke:#333
    style NemoCR fill:#f5a623,stroke:#333
    style InferenceService fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#e8e8e8,stroke:#333
    style KueueWorkload fill:#e8e8e8,stroke:#333
    style DSCConfig fill:#e8e8e8,stroke:#333
    style TLSProfile fill:#e8e8e8,stroke:#333
