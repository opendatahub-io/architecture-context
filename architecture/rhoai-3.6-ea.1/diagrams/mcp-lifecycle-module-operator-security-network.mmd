graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - ServiceAccount Auth)"]
        direction TB

        subgraph NS_System["Namespace: SYSTEM_NAMESPACE"]
            ModuleOp["MCP Lifecycle Module Operator<br/>controller-manager<br/>SA: mcp-lifecycle-module-operator-controller-manager<br/>FIPS: strictfipsruntime + CGO_ENABLED=1"]
            HealthProbe["Health/Ready Probes<br/>8081/TCP HTTP<br/>Unauthenticated"]
            ModuleOp --- HealthProbe
        end

        subgraph NS_Operand["Namespace: mcp-lifecycle-operator-system"]
            OperandOp["MCP Lifecycle Operator<br/>controller-manager<br/>SA: mcp-lifecycle-operator-controller-manager<br/>Image: quay.io/opendatahub/<br/>odh-mcp-lifecycle-operator:odh-stable"]
            MetricsService["Metrics Service<br/>ClusterIP 8443/TCP<br/>TLS (self-signed)<br/>Auth: TokenReview + SAR"]
            OperandOp --- MetricsService
        end

        subgraph NS_User["User Namespaces"]
            MCPServerCR["MCPServer CRs<br/>mcp.x-k8s.io/v1alpha1"]
            MCPServerResources["MCPServer Resources<br/>Deployments, Services,<br/>NetworkPolicies"]
        end

        KubeAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforced"]

        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
    end

    %% Module Operator flows
    ModuleOp -->|"SSA Deploy<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"| KubeAPI
    KubeAPI -->|"Watch Events<br/>MCPLifecycleOperator CR<br/>Owned Resources"| ModuleOp

    %% Module Operator deploys Operand
    ModuleOp -.->|"Deploys via SSA<br/>Field Owner: mcp-lifecycle-operator<br/>Ordered Apply"| OperandOp

    %% Operand flows
    OperandOp -->|"CRUD<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"| KubeAPI
    KubeAPI -->|"Watch Events<br/>MCPServer CRs"| OperandOp
    OperandOp -->|"Reconciles"| MCPServerCR
    MCPServerCR --- MCPServerResources

    %% Metrics
    Prometheus -->|"Scrape /metrics<br/>8443/TCP HTTPS<br/>Requires metrics-reader<br/>ClusterRole"| MetricsService

    %% Styling
    classDef moduleop fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef operand fill:#7ed321,stroke:#333,stroke-width:2px,color:#000
    classDef kubeapi fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef monitoring fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userres fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef probe fill:#e8e8e8,stroke:#999,stroke-width:1px

    class ModuleOp moduleop
    class OperandOp operand
    class MetricsService operand
    class KubeAPI kubeapi
    class Prometheus monitoring
    class MCPServerCR,MCPServerResources userres
    class HealthProbe probe
