graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - Kubernetes Network)"]
        direction TB

        subgraph NS_System["Namespace: system"]
            Manager["mcp-lifecycle-module-operator<br/>controller-manager<br/>SA: mcp-lifecycle-module-operator-<br/>controller-manager<br/>Image: controller:latest<br/>FIPS: strictfipsruntime + UBI9"]
            HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz<br/>Auth: None (by design)"]
        end

        subgraph K8sControl["Kubernetes Control Plane"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: ServiceAccount Token + RBAC"]
        end

        subgraph OperandStack["Deployed Operand Stack (via SSA)"]
            direction TB
            MCPServerCRD["MCPServer CRD<br/>mcp.x-k8s.io"]
            OperandDeploy["mcp-lifecycle-operator<br/>Deployment<br/>Image: RELATED_IMAGE_ODH_<br/>MCP_LIFECYCLE_OPERATOR_IMAGE"]
            MetricsSvc["Metrics Service<br/>8443/TCP"]
            SvcMonitor["ServiceMonitor<br/>Prometheus scrape config"]
            OperandRBAC["RBAC Resources<br/>ClusterRoles, Bindings,<br/>ServiceAccount"]
        end
    end

    subgraph ExternalServices["PLATFORM SERVICES"]
        PrometheusOp["prometheus-operator<br/>CRD CRUD<br/>HTTPS TLS 1.2+"]
    end

    %% Flows
    Manager -->|"HTTPS/WSS 6443<br/>TLS 1.2+<br/>ServiceAccount Token<br/>RBAC: manager-role"| K8sAPI
    K8sAPI -->|"Watch: MCPLifecycleOperator CR<br/>Watch: owned resources (label-scoped)<br/>Watch: APIServer (OpenShift)"| Manager
    Manager -->|"Server-Side Apply<br/>via odh-platform-utilities"| OperandStack
    Manager --- HealthProbes
    SvcMonitor -->|"scrape config"| PrometheusOp
    MetricsSvc -->|"metrics target"| SvcMonitor

    %% Styling
    classDef operator fill:#4a90e2,stroke:#2c5282,color:#fff,stroke-width:2px
    classDef controlplane fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef operand fill:#7ed321,stroke:#4a8c1c,color:#fff,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef probe fill:#ddd,stroke:#999,stroke-width:1px

    class Manager operator
    class K8sAPI controlplane
    class MCPServerCRD,OperandDeploy,MetricsSvc,SvcMonitor,OperandRBAC operand
    class PrometheusOp external
    class HealthProbes probe
