graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        LLMEndpoint["Target LLM Endpoint<br/>Port: Configured at runtime<br/>Protocol: HTTPS<br/>Auth: Model API Key"]
        S3Storage["S3-Compatible Storage<br/>Port: 443/TCP<br/>Protocol: HTTPS<br/>TLS 1.2+<br/>Auth: AWS IAM (boto3)"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted - In-Cluster)"]
        direction TB

        subgraph JobNamespace["Namespace: {evaluation-namespace}"]
            subgraph JobPod["Kubernetes Job Pod"]
                GarakAdapter["Garak Adapter<br/>llama-stack-provider-trustyai-garak<br/>Image: BASE_IMAGE (parameterized)"]
            end
            SAToken["ServiceAccount Token<br/>/var/run/secrets/kubernetes.io/<br/>serviceaccount/token"]
            MountedSecrets["Mounted Secrets<br/>/mnt/model-auth/<br/>/var/run/secrets/model/"]
            EnvSecrets["Environment Variables<br/>API_KEY, KFP_AUTH_TOKEN<br/>OPENAICOMPATIBLE_API_KEY<br/>AWS_ACCESS_KEY_ID<br/>AWS_SECRET_ACCESS_KEY"]
        end

        subgraph KFPNamespace["Namespace: kubeflow / dspa-namespace"]
            KFPAPI["Kubeflow Pipelines API<br/>Auth: Bearer SA Token"]
        end

        K8sAPI["Kubernetes API Server<br/>Port: 6443/TCP<br/>Protocol: HTTPS<br/>TLS 1.2+<br/>Auth: SA Token"]
    end

    %% Credential Resolution (local reads)
    GarakAdapter -.->|reads| SAToken
    GarakAdapter -.->|reads| MountedSecrets
    GarakAdapter -.->|reads| EnvSecrets

    %% Outbound to KFP
    GarakAdapter -->|"HTTPS<br/>Bearer SA Token<br/>Pipeline submission + polling"| KFPAPI

    %% Outbound to K8s API
    GarakAdapter -->|"HTTPS/6443<br/>SA Token<br/>Read Secrets"| K8sAPI

    %% Outbound to External
    GarakAdapter -->|"HTTPS<br/>Model API Key<br/>Red-teaming probes"| LLMEndpoint
    GarakAdapter -->|"HTTPS/443<br/>AWS IAM (boto3)<br/>Results upload"| S3Storage

    %% NOTE: No inbound connections - this is a batch Job
    %% No Services, no Ingress, no exposed ports

    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef job fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef kfp fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class LLMEndpoint,S3Storage external
    class K8sAPI cluster
    class GarakAdapter job
    class SAToken,MountedSecrets,EnvSecrets secrets
    class KFPAPI kfp
