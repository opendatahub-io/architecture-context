graph TB
    subgraph Cluster["KUBERNETES CLUSTER"]
        direction TB

        subgraph JobPod["Job Pod: llama-stack-provider-trustyai-garak<br/>Namespace: user-namespace"]
            Adapter["Garak Adapter<br/>SA: job-service-account<br/>Mounts: /etc/eval-job/spec.json"]
            SimpleGarak["Simple Mode:<br/>Garak Subprocess"]
        end

        subgraph KFPPods["KFP Pipeline Pods (KFP mode only)<br/>Namespace: pipeline-namespace"]
            direction TB
            Step1["1. Validation"]
            Step2["2. Taxonomy Resolution"]
            Step3["3. SDG Prompt Gen"]
            Step4["4. Prompt Preparation"]
            Step5["5. Garak Scan"]
            Step6["6. KFP Output"]
        end

        subgraph PlatformServices["INTERNAL PLATFORM SERVICES"]
            KFPServer["Kubeflow Pipelines Server<br/>HTTPS<br/>Auth: KFP_AUTH_TOKEN"]
            EvalHubSidecar["eval-hub Sidecar<br/>HTTP localhost<br/>Auth: None (pod-local)"]
            K8sAPI["Kubernetes API Server<br/>HTTPS<br/>Auth: ServiceAccount Token"]
        end
    end

    subgraph External["EXTERNAL SERVICES"]
        TargetModel["Target Model Endpoint<br/>HTTPS / TLS<br/>Auth: API_KEY Bearer Token"]
        S3["S3-Compatible Storage<br/>HTTPS / TLS (boto3)<br/>Auth: AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY"]
        OCIReg["OCI Registry<br/>HTTPS / TLS<br/>Auth: Registry Credentials"]
    end

    subgraph Secrets["CREDENTIALS (Environment Variables)"]
        direction LR
        APIKey["API_KEY"]
        OAIKey["OPENAICOMPATIBLE_API_KEY"]
        KFPToken["KFP_AUTH_TOKEN"]
        AWSKey["AWS_SECRET_ACCESS_KEY<br/>(via envFrom)"]
    end

    %% Job Pod flows
    Adapter -->|"simple exec"| SimpleGarak
    SimpleGarak -->|"HTTPS<br/>API_KEY Bearer"| TargetModel
    Adapter -->|"HTTPS<br/>AWS creds"| S3
    Adapter -->|"HTTPS"| OCIReg
    Adapter -->|"HTTP localhost<br/>results callback"| EvalHubSidecar

    %% KFP mode flows
    Adapter -->|"HTTPS<br/>KFP_AUTH_TOKEN"| KFPServer
    KFPServer -->|"creates run"| Step1
    Step1 --> Step2
    Step2 --> Step3
    Step3 --> Step4
    Step4 --> Step5
    Step5 --> Step6
    Step5 -->|"HTTPS<br/>API_KEY Bearer"| TargetModel
    Step6 -->|"HTTPS<br/>AWS creds<br/>(use_secret_as_env)"| S3

    %% K8s API for secret reads
    Adapter -.->|"HTTPS<br/>SA Token<br/>read Secrets"| K8sAPI

    %% Credential injection
    Secrets -.->|"injected"| Adapter

    %% Styling
    classDef cluster fill:#f0f0f0,stroke:#666,stroke-width:2px
    classDef jobpod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef kfppod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef secret fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class Adapter,SimpleGarak jobpod
    class Step1,Step2,Step3,Step4,Step5,Step6 kfppod
    class KFPServer,EvalHubSidecar,K8sAPI platform
    class TargetModel,S3,OCIReg external
    class APIKey,OAIKey,KFPToken,AWSKey secret
