graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / Data Scientist"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (workbenches-operator-system)"]
        direction TB

        subgraph WebhookServer["Webhook Server — :9443/TCP HTTPS"]
            HWWebhook["POST /workbenches-hardware-profile<br/>Mutating | Fail Policy"]
            ConnWebhook["POST /workbenches-connection-notebook<br/>Mutating | Fail Policy"]
            ConvWebhook["POST /convert<br/>CRD Conversion"]
        end

        subgraph MetricsServer["Metrics — :8443/TCP HTTPS"]
            Metrics["GET /metrics<br/>TokenReview + SAR"]
        end

        subgraph HealthProbes["Health — :8081/TCP HTTP (plaintext)"]
            Healthz["GET /healthz"]
            Readyz["GET /readyz"]
        end

        Manager["workbenches-operator-controller-manager<br/>SA: workbenches-operator-controller-manager<br/>TLS: OpenShift cluster profile<br/>Fallback: TLS 1.2 + Mozilla Intermediate<br/>FIPS: strictfipsruntime"]
        WebhookSvc["workbenches-operator-webhook-service<br/>ClusterIP 443/TCP → 9443"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        Orchestrator["Platform Orchestrator<br/>(DSC/DSCI Reconciler)<br/>CR field projection"]
        CertManager["cert-manager /<br/>OpenShift service-ca<br/>Provisions webhook TLS cert"]
        APIServerTLS["OpenShift APIServer<br/>TLS Security Profile<br/>config.openshift.io"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (applications namespace)"]
        NotebookCtrl["Kubeflow Notebook Controller<br/>Deployment"]
        WebhookConfigs["MutatingWebhookConfigurations"]
        CRDs["Notebook CRDs (kubeflow.org)"]
        RBAC["ClusterRoles, Bindings"]
    end

    %% Flows
    User -->|"kubectl / Dashboard<br/>Create Notebook CR"| K8sAPI
    K8sAPI -->|"HTTPS/443→9443<br/>TLS (service-ca cert)<br/>Admission Request"| WebhookSvc
    WebhookSvc --> HWWebhook
    WebhookSvc --> ConnWebhook
    WebhookSvc --> ConvWebhook

    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    Orchestrator -->|"Creates/Updates<br/>Workbenches CR"| K8sAPI
    CertManager -->|"Provisions<br/>webhook-cert"| Manager
    APIServerTLS -->|"TLS profile<br/>(watched)"| Manager

    Manager -->|"Kustomize SSA"| NotebookCtrl
    Manager -->|"Manages"| WebhookConfigs
    Manager -->|"Manages"| CRDs
    Manager -->|"Manages"| RBAC

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef webhook fill:#f8cecc,stroke:#b85450,stroke-width:1px

    class User external
    class K8sAPI controlplane
    class Manager,WebhookSvc,Metrics,Healthz,Readyz operator
    class HWWebhook,ConnWebhook,ConvWebhook webhook
    class Orchestrator,CertManager,APIServerTLS platform
    class NotebookCtrl,WebhookConfigs,CRDs,RBAC managed
