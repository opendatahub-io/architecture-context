graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (workbenches-operator-system)"]
        direction TB

        subgraph WebhookService["workbenches-operator-webhook-service<br/>ClusterIP 443/TCP → 9443"]
            direction TB
            WebhookServer["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (OpenShift profile)<br/>HTTP/2 disabled"]
        end

        subgraph MetricsEndpoint["Metrics"]
            Metrics["Metrics Server<br/>8443/TCP HTTPS<br/>TokenReview + SAR auth"]
        end

        subgraph HealthEndpoint["Health"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>No auth (by design)<br/>/healthz, /readyz"]
        end

        Manager["workbenches-operator-controller-manager<br/>SA: workbenches-operator-controller-manager<br/>FIPS: CGO_ENABLED=1 strictfipsruntime"]
    end

    subgraph PlatformServices["PLATFORM SERVICES (Internal)"]
        ServiceCA["OpenShift service-ca<br/>Certificate provisioning"]
        CertManager["cert-manager<br/>Fallback cert provider"]
        APIServerConfig["OpenShift APIServer<br/>TLS profile source"]
    end

    subgraph ManagedResources["MANAGED RESOURCES (Applications Namespace)"]
        NBController["Notebook Controller<br/>Deployment"]
        ManagedRBAC["RBAC Resources"]
        ManagedWebhooks["Webhook Configurations"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| APIServer

    %% API Server to Webhook
    APIServer -->|"HTTPS/443→9443<br/>TLS (service-ca cert)<br/>Admission Request"| WebhookServer

    %% Operator to API Server
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token (in-cluster)<br/>Resource CRUD + SAR"| APIServer

    %% Operator manages resources
    Manager -->|"server-side apply"| NBController
    Manager -->|"manages"| ManagedRBAC
    Manager -->|"manages"| ManagedWebhooks

    %% TLS provisioning
    ServiceCA -->|"provisions cert<br/>workbenches-operator-controller-webhook-cert"| WebhookServer
    CertManager -.->|"fallback cert<br/>(non-OpenShift)"| WebhookServer
    APIServerConfig -->|"TLS profile watch<br/>cipher suites + min version"| Manager

    %% Internal connections
    Manager --- WebhookServer
    Manager --- Metrics
    Manager --- Health

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef webhook fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class APIServer controlplane
    class Manager,Metrics,Health operator
    class WebhookServer webhook
    class ServiceCA,CertManager,APIServerConfig platform
    class NBController,ManagedRBAC,ManagedWebhooks managed
