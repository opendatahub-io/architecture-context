graph LR
    MR["Model Registry<br/>(Hub Proxy + Controller + BFF + Async Upload)"]

    %% Runtime Framework Dependencies
    MR -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    MR -->|"ORM / DB abstraction"| GORM["GORM<br/>v1.31.2"]
    MR -->|"schema migrations"| Migrate["golang-migrate<br/>v4.19.1"]
    MR -->|"HTTP routing"| Chi["go-chi<br/>v5.3.1"]

    %% Database Dependencies
    MR -->|"PostgreSQL driver"| PGX["pgx<br/>v5.10.0"]
    MR -->|"MySQL driver"| MySQL["go-sql-driver/mysql<br/>v1.10.0"]
    MR -->|"distributed locking"| PGLock["pglock<br/>v1.16.2"]

    %% Internal RHOAI Dependencies
    MR -->|"CRD watch / sync"| KServe["KServe<br/>v0.19.0"]
    MR -->|"VirtualService +<br/>AuthorizationPolicy"| Istio["Istio<br/>Service Mesh"]

    %% Kubernetes Dependencies
    MR -->|"API operations"| K8sAPI["Kubernetes API<br/>v0.36.3"]
    MR -->|"client operations"| K8sClient["client-go<br/>v0.36.3"]

    %% Python Dependencies (Async Upload)
    MR -->|"S3 uploads"| Boto3["boto3<br/>v1.43.50"]
    MR -->|"model signing"| ModelSigning["rh-model-signing<br/>v1.0.3"]
    MR -->|"artifact registry"| ORAS["oras<br/>v0.2.42"]
    MR -->|"HF integration"| HFHub["huggingface-hub<br/>v1.23.0"]

    %% Observability
    MR -->|"structured logging"| Zap["zap<br/>v1.27.1"]
    MR -->|"API docs"| Swag["swaggo/swag<br/>v1.16.6"]

    %% External Services
    MR -->|"model artifacts"| S3["S3-Compatible<br/>Storage"]
    MR -->|"metadata persistence"| DB[("PostgreSQL /<br/>MySQL")]

    %% Integration Points (consumers of Model Registry)
    Dashboard["ODH Dashboard"] -.->|"UI integration"| MR
    DSPipelines["Data Science<br/>Pipelines"] -.->|"model lookup"| MR

