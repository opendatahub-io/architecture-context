graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Controller["kueue-controller-manager<br/>ns: kueue-system"]
        SA_Operator["openshift-kueue-operator<br/>ns: openshift-kueue-operator"]
        SA_Prometheus["prometheus-k8s<br/>ns: system"]
    end

    subgraph ControllerBindings["Controller Role Bindings"]
        CRB_Manager["kueue-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Metrics["kueue-metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Proxy["kueue-proxy-rolebinding<br/>(ClusterRoleBinding)"]
        RB_Leader["kueue-leader-election-rolebinding<br/>(RoleBinding, ns: kueue-system)"]
        RB_Visibility["kueue-visibility-server-auth-reader<br/>(RoleBinding, ns: kube-system)"]
    end

    subgraph OperatorBindings["Operator Role Bindings"]
        CRB_Operator["openshift-kueue-operator<br/>(ClusterRoleBinding)"]
        RB_OpNetwork["openshift-kueue-operator-networking<br/>(RoleBinding)"]
    end

    subgraph MonitoringBindings["Monitoring Role Bindings"]
        RB_Prom["prometheus-k8s<br/>(RoleBinding, ns: system)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["kueue-manager-role<br/>(36 rules)"]
        CR_MetricsAuth["kueue-metrics-auth-role"]
        CR_Proxy["kueue-proxy-role"]
        CR_Operator["openshift-kueue-operator"]
        R_Leader["kueue-leader-election-role<br/>(Role)"]
        R_AuthReader["extension-apiserver-authentication-reader<br/>(Role)"]
        R_Network["openshift-kueue-operator-networking<br/>(Role)"]
        R_Prom["prometheus-k8s<br/>(Role)"]
    end

    subgraph ManagerResources["kueue-manager-role Resources"]
        KueueCRDs["kueue.x-k8s.io<br/>admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads,<br/>resourceflavors, topologies,<br/>multikueueclusters, multikueueconfigs,<br/>provisioningrequestconfigs,<br/>workloadpriorityclasses"]
        BatchRes["batch<br/>jobs, jobs/finalizers, jobs/status"]
        KubeflowRes["kubeflow.org<br/>pytorchjobs, tfjobs, mpijobs,<br/>paddlejobs, xgboostjobs<br/>+ /finalizers, /status"]
        RayRes["ray.io<br/>rayclusters, rayjobs<br/>+ /finalizers, /status"]
        JobSetRes["jobset.x-k8s.io<br/>jobsets + /finalizers, /status"]
        AppWrapperRes["workload.codeflare.dev<br/>appwrappers + /finalizers, /status"]
        LWSRes["leaderworkerset.x-k8s.io<br/>leaderworkersets"]
        CoreRes["core<br/>pods, secrets, events,<br/>limitranges, namespaces, nodes,<br/>podtemplates"]
        AppsRes["apps<br/>deployments, replicasets,<br/>statefulsets"]
        AdmissionRes["admissionregistration<br/>mutating/validating<br/>webhookconfigurations"]
    end

    subgraph OperatorResources["openshift-kueue-operator Resources"]
        OpKueueCR["kueue.openshift.io<br/>kueues + /finalizers, /status"]
        OpCRDs["apiextensions<br/>customresourcedefinitions"]
        OpRBAC["rbac.authorization<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>(incl. bind, escalate)"]
        OpWebhooks["admissionregistration<br/>mutating/validating webhooks"]
        OpApps["apps<br/>deployments, replicasets"]
        OpCore["core<br/>configmaps, events, pods,<br/>secrets, serviceaccounts, services"]
        OpCertMgr["cert-manager.io<br/>certificates, issuers"]
        OpMonitor["monitoring.coreos.com<br/>servicemonitors"]
    end

    subgraph MetricsResources["Metrics Auth Resources"]
        TokenReview["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    %% Controller SA bindings
    SA_Controller -->|"bound via"| CRB_Manager
    SA_Controller -->|"bound via"| CRB_Metrics
    SA_Controller -->|"bound via"| CRB_Proxy
    SA_Controller -->|"bound via"| RB_Leader
    SA_Controller -->|"bound via"| RB_Visibility

    %% Operator SA bindings
    SA_Operator -->|"bound via"| CRB_Operator
    SA_Operator -->|"bound via"| RB_OpNetwork

    %% Prometheus SA bindings
    SA_Prometheus -->|"bound via"| RB_Prom

    %% Bindings to roles
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Metrics -->|"grants"| CR_MetricsAuth
    CRB_Proxy -->|"grants"| CR_Proxy
    RB_Leader -->|"grants"| R_Leader
    RB_Visibility -->|"grants"| R_AuthReader
    CRB_Operator -->|"grants"| CR_Operator
    RB_OpNetwork -->|"grants"| R_Network
    RB_Prom -->|"grants"| R_Prom

    %% Manager role to resources
    CR_Manager -->|"CRUD + watch"| KueueCRDs
    CR_Manager -->|"get,list,patch,update,watch"| BatchRes
    CR_Manager -->|"get,list,patch,update,watch"| KubeflowRes
    CR_Manager -->|"get,list,patch,update,watch"| RayRes
    CR_Manager -->|"get,list,patch,update,watch"| JobSetRes
    CR_Manager -->|"get,list,patch,update,watch"| AppWrapperRes
    CR_Manager -->|"get,list,watch"| LWSRes
    CR_Manager -->|"mixed verbs"| CoreRes
    CR_Manager -->|"get,list,watch"| AppsRes
    CR_Manager -->|"get,list,update,watch"| AdmissionRes

    %% Operator role to resources
    CR_Operator -->|"full CRUD"| OpKueueCR
    CR_Operator -->|"full CRUD"| OpCRDs
    CR_Operator -->|"full CRUD + bind,escalate"| OpRBAC
    CR_Operator -->|"full CRUD"| OpWebhooks
    CR_Operator -->|"full CRUD"| OpApps
    CR_Operator -->|"full CRUD"| OpCore
    CR_Operator -->|"full CRUD"| OpCertMgr
    CR_Operator -->|"CRUD"| OpMonitor

    %% Metrics auth
    CR_MetricsAuth -->|"create"| TokenReview
    CR_MetricsAuth -->|"create"| SAR
    CR_Proxy -->|"create"| TokenReview
    CR_Proxy -->|"create"| SAR

    %% Styles
    style SA_Controller fill:#4a90e2,stroke:#333,color:#fff
    style SA_Operator fill:#4a90e2,stroke:#333,color:#fff
    style SA_Prometheus fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_Operator fill:#f5a623,stroke:#333
    style CR_MetricsAuth fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style R_Leader fill:#f5a623,stroke:#333
    style R_AuthReader fill:#f5a623,stroke:#333
    style R_Network fill:#f5a623,stroke:#333
    style R_Prom fill:#f5a623,stroke:#333
    style KueueCRDs fill:#7ed321,stroke:#333
    style BatchRes fill:#7ed321,stroke:#333
    style KubeflowRes fill:#7ed321,stroke:#333
    style RayRes fill:#7ed321,stroke:#333
    style JobSetRes fill:#7ed321,stroke:#333
    style AppWrapperRes fill:#7ed321,stroke:#333
    style LWSRes fill:#7ed321,stroke:#333
    style CoreRes fill:#7ed321,stroke:#333
    style AppsRes fill:#7ed321,stroke:#333
    style AdmissionRes fill:#7ed321,stroke:#333
    style OpKueueCR fill:#7ed321,stroke:#333
    style OpCRDs fill:#7ed321,stroke:#333
    style OpRBAC fill:#7ed321,stroke:#333
    style OpWebhooks fill:#7ed321,stroke:#333
    style OpApps fill:#7ed321,stroke:#333
    style OpCore fill:#7ed321,stroke:#333
    style OpCertMgr fill:#7ed321,stroke:#333
    style OpMonitor fill:#7ed321,stroke:#333
    style TokenReview fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
