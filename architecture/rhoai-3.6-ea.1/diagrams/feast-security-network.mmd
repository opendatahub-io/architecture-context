graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist / ML Client"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS termination<br/>service-serving certs"]
    end

    subgraph FeastServices["FEAST SERVICES (Operator-Managed Data Plane)"]
        direction TB

        subgraph OnlineGo["Online Serving (Go)"]
            GoServer["Go Feature Server<br/>HTTP: /get-online-features<br/>gRPC: ServingService<br/>FIPS: strictfipsruntime"]
        end

        subgraph OnlinePy["Online Serving (Python)"]
            PyServer["Python Feature Server<br/>:6566/TCP HTTP/HTTPS<br/>FastAPI + gunicorn/uvicorn<br/>Auth: PyJWT (OIDC)"]
        end

        subgraph OfflineSvc["Offline Serving"]
            OfflineServer["Python Offline Server<br/>Arrow Flight (gRPC)<br/>FIPS cipher enforcement<br/>6 approved ciphers"]
        end

        subgraph RegistrySvc["Registry"]
            RegistryGRPC["Registry Server<br/>gRPC: 40+ RPCs<br/>REST: /entities, /feature_views"]
        end
    end

    subgraph OperatorPlane["OPERATOR CONTROL PLANE"]
        Operator["Feast Operator<br/>SA: feast-operator-controller-manager<br/>NS: feast-operator-system"]
        HealthProbe["Health: :8081<br/>/healthz, /readyz<br/>Unauthenticated"]
        Metrics["Metrics: :8443<br/>Self-signed TLS<br/>TokenReview + SAR"]
    end

    subgraph K8s["KUBERNETES"]
        K8sAPI["kube-apiserver<br/>:6443/TCP<br/>TLS 1.2+<br/>ServiceAccount token"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        PostgreSQL["PostgreSQL<br/>Online Store<br/>pgx pool<br/>TCP"]
        Redis["Redis / Valkey<br/>Online Store<br/>go-redis<br/>TCP"]
        S3["S3-compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM credentials"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>GCP service account"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS<br/>K8s RBAC or OIDC"| Route

    %% Ingress to Services
    Route -->|"HTTP/HTTPS<br/>CRD TlsConfigs"| GoServer
    Route -->|"HTTP/HTTPS<br/>:6566<br/>CRD TlsConfigs"| PyServer

    %% Direct client access (gRPC)
    Client -->|"gRPC/HTTP2<br/>CRD TlsConfigs"| GoServer
    Client -->|"Arrow Flight<br/>gRPC streaming"| OfflineServer

    %% Services to backends
    GoServer -->|"TCP<br/>pgx/go-redis<br/>Credentials"| PostgreSQL
    GoServer -->|"TCP<br/>go-redis<br/>Credentials"| Redis
    PyServer -->|"TCP<br/>Credentials"| PostgreSQL
    PyServer -->|"TCP<br/>Credentials"| Redis
    RegistryGRPC -->|"HTTPS/443<br/>AWS IAM"| S3
    RegistryGRPC -->|"HTTPS/443<br/>GCP SA"| GCS

    %% Operator to K8s API
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef services fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class Route ingress
    class GoServer,PyServer,OfflineServer,RegistryGRPC services
    class Operator,HealthProbe,Metrics operator
    class K8sAPI k8s
    class PostgreSQL,Redis,S3,GCS externalservice
