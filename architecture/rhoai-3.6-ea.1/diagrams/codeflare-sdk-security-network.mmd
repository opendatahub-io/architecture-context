graph TB
    subgraph External["EXTERNAL (User Workstation / Notebook)"]
        User["Data Scientist<br/>(Jupyter Notebook / CLI)"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (OpenShift)"]
        direction TB

        subgraph SDKLayer["SDK Layer (User Namespace)"]
            SDK["CodeFlare SDK<br/>(Python Client Library)<br/>Auth: kube-authkit"]
        end

        subgraph K8sControl["CONTROL PLANE"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>Bearer Token / ServiceAccount"]
        end

        subgraph KueueNS["Kueue (kueue-system)"]
            KueueAPI["Kueue API<br/>kueue.x-k8s.io/v1beta1<br/>via K8s API aggregation"]
        end

        subgraph RayNS["Ray Cluster Namespace"]
            RayDashboard["Ray Dashboard<br/>HTTP/HTTPS<br/>Custom Headers Auth"]
            RayNodes["Ray Worker Nodes<br/>mTLS (RSA-3072, SHA-256)<br/>Certs from K8s Secrets"]
        end

        subgraph SecretStore["Kubernetes Secrets"]
            TLSSecrets["Ray TLS Secrets<br/>label: ray.openshift.ai/cluster-name<br/>CA + Server + Client certs"]
            MinIOSecret["minio-secret<br/>Type: Opaque<br/>(test only)"]
        end
    end

    subgraph TestInfra["TEST INFRASTRUCTURE (non-production)"]
        MinIO["MinIO<br/>9000/TCP (API)<br/>9090/TCP (Console)<br/>ClusterIP"]
    end

    %% Flows
    User -->|"Python SDK calls"| SDK
    SDK -->|"6443/TCP<br/>TLS 1.2+<br/>Bearer / kubeconfig / in-cluster<br/>CA: system trust / CF_SDK_CA_CERT_PATH /<br/>/etc/pki/tls/custom-certs/ca-bundle.crt"| K8sAPI
    SDK -->|"HTTP/HTTPS<br/>Custom headers auth<br/>Configurable TLS verify"| RayDashboard
    SDK -->|"via K8s CustomObjects API<br/>TLS (inherited from K8s client)"| KueueAPI
    SDK -->|"Create/Read Secrets<br/>via K8s API"| TLSSecrets
    TLSSecrets -.->|"mTLS certs<br/>RSA-3072 / SHA-256"| RayNodes
    RayDashboard -->|"mTLS"| RayNodes

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef sdk fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef secrets fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef test fill:#e8e8e8,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5

    class User external
    class SDK sdk
    class K8sAPI controlplane
    class KueueAPI,RayDashboard,RayNodes internal
    class TLSSecrets,MinIOSecret secrets
    class MinIO test
