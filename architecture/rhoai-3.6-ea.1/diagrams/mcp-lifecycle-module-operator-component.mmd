graph TB
    subgraph ModuleOperator["mcp-lifecycle-module-operator"]
        direction TB
        Manager["Manager Process<br/>/manager entrypoint"]
        Reconciler["MCPLifecycleOperator<br/>Reconciler"]
        EmbeddedFS["Embedded Manifest<br/>Filesystem"]
        HealthProbe["/healthz + /readyz<br/>Port 8081"]
        Manager --> Reconciler
        Manager --> HealthProbe
        Reconciler -->|reads| EmbeddedFS
    end

    subgraph PlatformUtilities["odh-platform-utilities"]
        Deployer["SSA Deployer"]
        KustomizeProvider["Kustomize Provider"]
        ConditionMgr["Condition Manager"]
    end

    %% Primary CR
    MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>(Cluster-scoped)<br/>components.platform.opendatahub.io/v1alpha1"]

    %% Owned/Deployed Resources (Operand Stack)
    subgraph OperandStack["Deployed Operand Resources"]
        direction TB
        MCPServerCRD["MCPServer CRD<br/>mcp.x-k8s.io"]
        OperandDeployment["mcp-lifecycle-operator<br/>Deployment"]
        MetricsService["Metrics Service<br/>Port 8443"]
        ServiceMonitor["ServiceMonitor<br/>Prometheus"]
        OperandRBAC["RBAC Resources<br/>Roles, Bindings, SA"]
    end

    %% Watched Resources
    PlatformConfigMap["Platform ConfigMap<br/>(version detection)"]
    APIServer["APIServer<br/>config.openshift.io<br/>(TLS config)"]

    %% Flows
    MCPLifecycleOpCR -->|"watched by (For)"| Reconciler
    Reconciler -->|reads| PlatformConfigMap
    APIServer -->|"triggers reconcile<br/>(OpenShift only)"| Reconciler
    Reconciler -->|renders manifests| KustomizeProvider
    KustomizeProvider --> Deployer
    Deployer -->|"server-side apply"| OperandStack
    Reconciler -->|"updates conditions<br/>Ready, Degraded,<br/>ProvisioningSucceeded"| ConditionMgr
    ConditionMgr -->|writes status| MCPLifecycleOpCR

    %% Label-scoped watches
    OperandDeployment -->|"label watch<br/>part-of: mcp-lifecycle-operator"| Reconciler
    MetricsService -->|"label watch"| Reconciler
    OperandRBAC -->|"label watch"| Reconciler
    MCPServerCRD -->|"label watch"| Reconciler

    %% Kubernetes API
    K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    Reconciler -->|"CRUD operations<br/>ServiceAccount token"| K8sAPI

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style EmbeddedFS fill:#4a90e2,color:#fff
    style HealthProbe fill:#4a90e2,color:#fff
    style MCPLifecycleOpCR fill:#f5a623,color:#fff
    style MCPServerCRD fill:#7ed321,color:#fff
    style OperandDeployment fill:#7ed321,color:#fff
    style MetricsService fill:#7ed321,color:#fff
    style ServiceMonitor fill:#7ed321,color:#fff
    style OperandRBAC fill:#7ed321,color:#fff
    style PlatformConfigMap fill:#e8e8e8
    style APIServer fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style Deployer fill:#9b59b6,color:#fff
    style KustomizeProvider fill:#9b59b6,color:#fff
    style ConditionMgr fill:#9b59b6,color:#fff
