{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jctanner/odh.architecture-context/src/arch-analyzer/schema/component-architecture.schema.json",
  "title": "arch-analyzer component architecture",
  "type": "object",
  "required": ["component"],
  "properties": {
    "component": {"type": "string", "minLength": 1},
    "data_coverage": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "category_coverage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/categoryCoverage"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "categoryCoverage": {
      "type": "object",
      "required": [
        "status",
        "fact_count",
        "discovery_contract",
        "completed_checks",
        "limitations",
        "evidence"
      ],
      "properties": {
        "status": {"enum": ["complete", "partial", "unknown"]},
        "fact_count": {"type": "integer", "minimum": 0},
        "discovery_contract": {"type": "string", "minLength": 1},
        "completed_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
