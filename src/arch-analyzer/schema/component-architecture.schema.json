{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jctanner/odh.architecture-context/src/arch-analyzer/schema/component-architecture.schema.json",
  "title": "arch-analyzer component architecture",
  "type": "object",
  "required": ["component"],
  "properties": {
    "component": {"type": "string", "minLength": 1},
    "data_coverage": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "category_coverage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/categoryCoverage"}
    },
    "cross_references": {
      "type": "array",
      "items": {"$ref": "#/$defs/crossReference"}
    },
    "coverage_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverageFinding"}
    },
    "synthesis_evidence": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/evidenceRecord"}}
    },
    "gap_evidence_index": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/gapEvidenceCandidate"}}
    },
    "context_contract": {"$ref": "#/$defs/contextContract"},
    "entrypoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/entrypoint"}
    },
    "security_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/securityEvidence"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "categoryCoverage": {
      "type": "object",
      "required": [
        "status",
        "fact_count",
        "discovery_contract",
        "completed_checks",
        "limitations",
        "evidence"
      ],
      "properties": {
        "status": {"enum": ["complete", "partial", "unknown"]},
        "fact_count": {"type": "integer", "minimum": 0},
        "discovery_contract": {"type": "string", "minLength": 1},
        "completed_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "crossReference": {
      "type": "object",
      "required": ["kind", "from", "to", "relationship", "sources"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1},
        "details": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "coverageFinding": {
      "type": "object",
      "required": ["category", "status", "finding"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed-empty", "not-verified", "observed"]},
        "finding": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "evidenceRecord": {
      "type": "object",
      "required": ["claim", "sources"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "gapEvidenceCandidate": {
      "type": "object",
      "required": ["source", "question", "expected_signal", "status"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "line_range": {"type": "string"},
        "symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "question": {"type": "string", "minLength": 1},
        "expected_signal": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate"]},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "validationState": {
      "enum": ["confirmed", "needs-validation", "unknown", "not-extracted"],
      "examples": ["confirmed", "unknown", "not-extracted"]
    },
    "maturity": {
      "enum": ["GA", "TP", "DP", "planned", "deprecated"]
    },
    "dependencyStatus": {
      "enum": ["exists", "needed", "open", "blocked"]
    },
    "contextContract": {
      "type": "object",
      "required": ["contract_version"],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/contractProvenance"},
        "applicability": {"$ref": "#/$defs/contractApplicability"},
        "confidence": {"$ref": "#/$defs/contractConfidence"},
        "maturity": {"$ref": "#/$defs/contractMaturity"},
        "scope": {"$ref": "#/$defs/contractScope"},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/contractDependency"}
        },
        "behavioral_evidence": {"$ref": "#/$defs/contractBehavioralEvidence"},
        "component_classification": {"$ref": "#/$defs/contractComponentClassification"}
      },
      "additionalProperties": false,
      "examples": [
        {
          "contract_version": "1",
          "provenance": {
            "source": "arch-analyzer",
            "extracted_at": "2026-07-24T12:00:00Z",
            "analyzer_version": "0.1.0-dev",
            "commit_sha": "abc123def",
            "repository": "org/component-repo",
            "validation": "confirmed"
          },
          "applicability": {
            "version": "v2.15",
            "release": "rhoai-2.15",
            "applicable_from": "2026-07-01",
            "applicable_until": "2026-12-31",
            "freshness_window": "30d",
            "validation": "confirmed"
          },
          "confidence": {
            "overall_validation": "needs-validation",
            "fact_validation": {
              "crds": "confirmed",
              "authentication": "not-extracted"
            }
          },
          "maturity": {
            "lifecycle": "GA",
            "validation": "confirmed"
          }
        },
        {
          "contract_version": "1",
          "provenance": {
            "source": "arch-analyzer",
            "extracted_at": "2026-07-24T12:00:00Z",
            "analyzer_version": "0.1.0-dev",
            "validation": "unknown"
          },
          "applicability": {
            "validation": "not-extracted"
          },
          "confidence": {
            "overall_validation": "unknown"
          },
          "maturity": {
            "lifecycle": "planned",
            "validation": "needs-validation"
          },
          "scope": {
            "validation": "not-extracted"
          },
          "behavioral_evidence": {
            "validation": "not-extracted"
          }
        }
      ]
    },
    "contractProvenance": {
      "type": "object",
      "required": ["source", "extracted_at", "analyzer_version", "validation"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "extracted_at": {"type": "string", "minLength": 1},
        "analyzer_version": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string"},
        "repository": {"type": "string"},
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false
    },
    "contractApplicability": {
      "description": "When both applicable_from and applicable_until are present, applicable_from must not be after applicable_until (enforced by the Go model validator, not expressible in JSON Schema).",
      "type": "object",
      "required": ["validation"],
      "properties": {
        "version": {"type": "string"},
        "release": {"type": "string"},
        "applicable_from": {"type": "string"},
        "applicable_until": {"type": "string"},
        "freshness_window": {"type": "string"},
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false,
      "examples": [
        {
          "version": "v2.15",
          "release": "rhoai-2.15",
          "applicable_from": "2026-07-01",
          "applicable_until": "2026-12-31",
          "freshness_window": "30d",
          "validation": "confirmed"
        },
        {
          "validation": "not-extracted"
        }
      ]
    },
    "contractConfidence": {
      "type": "object",
      "required": ["overall_validation"],
      "properties": {
        "overall_validation": {"$ref": "#/$defs/validationState"},
        "fact_validation": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/validationState"}
        }
      },
      "additionalProperties": false
    },
    "contractMaturity": {
      "type": "object",
      "required": ["lifecycle", "validation"],
      "properties": {
        "lifecycle": {"$ref": "#/$defs/maturity"},
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false
    },
    "contractScope": {
      "type": "object",
      "required": ["validation"],
      "properties": {
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "deployment_topology": {"type": "string"},
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false
    },
    "contractDependency": {
      "type": "object",
      "required": ["name", "status", "validation"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/dependencyStatus"},
        "upstream": {"type": "string"},
        "provenance": {"type": "string"},
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false
    },
    "contractBehavioralEvidence": {
      "type": "object",
      "required": ["validation"],
      "properties": {
        "integration_constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "failure_modes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "test_topology": {
          "type": "array",
          "items": {"type": "string"}
        },
        "performance_baselines": {
          "type": "array",
          "items": {"type": "string"}
        },
        "configuration_rbac": {
          "type": "array",
          "items": {"type": "string"}
        },
        "arch_provider_matrices": {
          "type": "array",
          "items": {"type": "string"}
        },
        "observable_outcomes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "image_build_status": {
          "type": "array",
          "items": {"type": "string"}
        },
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false
    },
    "contractComponentClassification": {
      "type": "object",
      "required": ["validation"],
      "properties": {
        "role": {"type": "string"},
        "delivery_independence": {"type": "string"},
        "validation": {"$ref": "#/$defs/validationState"}
      },
      "additionalProperties": false
    },
    "entrypoint": {
      "type": "object",
      "required": ["name", "type", "runtime", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "command": {"type": "string"},
        "workload_ref": {"type": "string"},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "securityEvidence": {
      "type": "object",
      "required": ["kind", "target", "detail", "status", "source"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "status": {"enum": ["literal", "dependency-signal", "not-extracted"]},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
